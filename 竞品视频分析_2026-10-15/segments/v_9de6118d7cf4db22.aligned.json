{
  "video_id": "v_9de6118d7cf4db22",
  "duration_s": 371.4039,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_9de6118d7cf4db22.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_9de6118d7cf4db22.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 690,
      "text": "第五名，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 1050,
      "end_ms": 4530,
      "text": "四川都江堰战国时候修的，",
      "token_start": 3,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 4710,
      "end_ms": 8890,
      "text": "在成都平原西部的岷江上两千二百多年了。",
      "token_start": 14,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 9250,
      "end_ms": 10550,
      "text": "修他的人叫李冰，",
      "token_start": 32,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 11050,
      "end_ms": 12890,
      "text": "秦国派到四川的太守，",
      "token_start": 39,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 13430,
      "end_ms": 15730,
      "text": "这个工程最绝的地方在哪儿？",
      "token_start": 48,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 15810,
      "end_ms": 17830,
      "text": "他没有坝全世界。",
      "token_start": 60,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 17830,
      "end_ms": 18770,
      "text": "到现在为止，",
      "token_start": 67,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 19050,
      "end_ms": 20810,
      "text": "都江堰是年代最久，",
      "token_start": 72,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 21250,
      "end_ms": 26010,
      "text": "唯一留存还在一直使用的无坝引水工程。",
      "token_start": 80,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26650,
      "end_ms": 29310,
      "text": "怎么分水岷江中间修了一个鱼嘴，",
      "token_start": 97,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 29310,
      "end_ms": 33280,
      "text": "把江江分成两条外江泄洪，",
      "token_start": 111,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 33640,
      "end_ms": 36100,
      "text": "内江灌溉枯水的时候，",
      "token_start": 122,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 36360,
      "end_ms": 38140,
      "text": "六成水进内江，",
      "token_start": 131,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 38240,
      "end_ms": 40620,
      "text": "四成进外江发大水的时候，",
      "token_start": 137,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 40620,
      "end_ms": 43820,
      "text": "反过来六成水排走四成流下。",
      "token_start": 148,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 44160,
      "end_ms": 45260,
      "text": "更神的是，",
      "token_start": 160,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 45280,
      "end_ms": 48300,
      "text": "排沙内江边上有一个飞沙堰，",
      "token_start": 164,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 48660,
      "end_ms": 51120,
      "text": "比河床高两米水一大，",
      "token_start": 176,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 51540,
      "end_ms": 52920,
      "text": "多余的洪水和沙子，",
      "token_start": 185,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 52920,
      "end_ms": 55900,
      "text": "自己就甩出去了两千两百多年了。",
      "token_start": 193,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 56020,
      "end_ms": 56800,
      "text": "到今天，",
      "token_start": 207,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 57040,
      "end_ms": 62445,
      "text": "还在灌溉一千多万亩农田钱养活两千多万人。",
      "token_start": 210,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 62920,
      "end_ms": 65835,
      "text": "您说一座没有坝的水利工程，",
      "token_start": 229,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 66370,
      "end_ms": 67390,
      "text": "干了两千多年，",
      "token_start": 241,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 67390,
      "end_ms": 70435,
      "text": "活一天没歇过这事上哪儿找去？",
      "token_start": 247,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 71590,
      "end_ms": 72195,
      "text": "第四名，",
      "token_start": 260,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 72660,
      "end_ms": 78105,
      "text": "新疆坎儿井在吐鲁番跟万里长城、京杭大运河，",
      "token_start": 263,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 78400,
      "end_ms": 81185,
      "text": "并称中国古代三大工程。",
      "token_start": 282,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 82240,
      "end_ms": 86585,
      "text": "吐鲁番那个地方一年下雨也就十几毫米，",
      "token_start": 292,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 87620,
      "end_ms": 89585,
      "text": "蒸发量三千多毫米，",
      "token_start": 309,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 90130,
      "end_ms": 92125,
      "text": "地上的水根本存不住。",
      "token_start": 317,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 93120,
      "end_ms": 94425,
      "text": "古人想了个什么办法？",
      "token_start": 326,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 94990,
      "end_ms": 98085,
      "text": "把天山的雪水从地底下引过来，",
      "token_start": 335,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 98500,
      "end_ms": 100475,
      "text": "怎么引先打一溜树井，",
      "token_start": 348,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 100850,
      "end_ms": 102665,
      "text": "然后在井底下挖暗渠，",
      "token_start": 357,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 103250,
      "end_ms": 107215,
      "text": "把水从地下悄悄送到几十公里外的绿洲，",
      "token_start": 366,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 108080,
      "end_ms": 110185,
      "text": "地面上一滴水都看不见，",
      "token_start": 383,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 110680,
      "end_ms": 111200,
      "text": "庄稼，",
      "token_start": 393,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 111200,
      "end_ms": 112385,
      "text": "却喝得饱饱的。",
      "token_start": 395,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 113310,
      "end_ms": 117190,
      "text": "全江现在还有一千五百多条坎儿井，",
      "token_start": 401,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 117210,
      "end_ms": 120655,
      "text": "岸渠加起来超过三千四百公里。",
      "token_start": 416,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 121130,
      "end_ms": 123255,
      "text": "林则徐当年被发配到新疆，",
      "token_start": 429,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 123660,
      "end_ms": 126710,
      "text": "带着老百姓修了六十多条当地人，",
      "token_start": 440,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 126710,
      "end_ms": 128655,
      "text": "到现在还管他叫林公瑾，",
      "token_start": 454,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 129300,
      "end_ms": 129860,
      "text": "没有电，",
      "token_start": 464,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 130140,
      "end_ms": 130700,
      "text": "没有泵，",
      "token_start": 467,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 130980,
      "end_ms": 131880,
      "text": "没有管子，",
      "token_start": 470,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 132120,
      "end_ms": 133660,
      "text": "全靠人一敲一敲。",
      "token_start": 474,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 133660,
      "end_ms": 136475,
      "text": "在地下挖出来的第三名，",
      "token_start": 481,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 136810,
      "end_ms": 141405,
      "text": "四川乐山大佛唐朝开元元年开始修的，",
      "token_start": 491,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 141810,
      "end_ms": 144175,
      "text": "修了整整九十年才完工，",
      "token_start": 507,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 144790,
      "end_ms": 149225,
      "text": "发起的人叫海通禅师凌云寺的和尚。",
      "token_start": 517,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 150170,
      "end_ms": 151835,
      "text": "他为什么要修这尊佛？",
      "token_start": 532,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 152180,
      "end_ms": 158615,
      "text": "因为岷江、大渡河、青衣江、三江汇流的地方水流太急，",
      "token_start": 541,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 159100,
      "end_ms": 161465,
      "text": "船走到那儿经常撞得粉碎，",
      "token_start": 562,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 162210,
      "end_ms": 163905,
      "text": "海通募捐了二十年，",
      "token_start": 573,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 164270,
      "end_ms": 165245,
      "text": "攒了一笔钱。",
      "token_start": 581,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 166010,
      "end_ms": 167955,
      "text": "当地有个地方官跑来要钱。",
      "token_start": 586,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 168500,
      "end_ms": 169715,
      "text": "海通说了一句话，",
      "token_start": 597,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 170120,
      "end_ms": 172250,
      "text": "肆目可望佛才难得。",
      "token_start": 604,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 172650,
      "end_ms": 173590,
      "text": "眼睛可以挖，",
      "token_start": 612,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 173590,
      "end_ms": 175200,
      "text": "给你修佛的钱，",
      "token_start": 617,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 175200,
      "end_ms": 176445,
      "text": "你一分也别想拿。",
      "token_start": 623,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 176860,
      "end_ms": 178735,
      "text": "说完自己把眼睛挖了出来，",
      "token_start": 630,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 179020,
      "end_ms": 180415,
      "text": "端着盘子递过去。",
      "token_start": 641,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 180990,
      "end_ms": 182855,
      "text": "那个官吓得转身就跑，",
      "token_start": 648,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 183260,
      "end_ms": 184495,
      "text": "大佛修了九十年，",
      "token_start": 657,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 184910,
      "end_ms": 186065,
      "text": "通高七十一米，",
      "token_start": 664,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 186320,
      "end_ms": 187900,
      "text": "耳朵就有七米长脚，",
      "token_start": 670,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 187900,
      "end_ms": 189745,
      "text": "背上能坐一百多个人，",
      "token_start": 678,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 190650,
      "end_ms": 195365,
      "text": "更绝得是大佛身上藏着一套完整的排水系统。",
      "token_start": 687,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 196070,
      "end_ms": 197250,
      "text": "一千多年了，",
      "token_start": 706,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 197370,
      "end_ms": 198855,
      "text": "石头没怎么分化，",
      "token_start": 711,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 199570,
      "end_ms": 202375,
      "text": "一个人发了愿几代人接着干，",
      "token_start": 718,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 202640,
      "end_ms": 205025,
      "text": "把一座山凿成了一尊佛。",
      "token_start": 730,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 205920,
      "end_ms": 206545,
      "text": "第二名，",
      "token_start": 740,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 206900,
      "end_ms": 210115,
      "text": "万里长城从西周开始修，",
      "token_start": 743,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 210430,
      "end_ms": 211585,
      "text": "秦始皇连起来，",
      "token_start": 753,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 211930,
      "end_ms": 213525,
      "text": "明朝大规模重建，",
      "token_start": 759,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 213990,
      "end_ms": 216465,
      "text": "前前后后修了两千多年，",
      "token_start": 766,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 217060,
      "end_ms": 219265,
      "text": "把历代修的长城加起来，",
      "token_start": 776,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 219580,
      "end_ms": 221755,
      "text": "总长度超过两万公里。",
      "token_start": 786,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 222700,
      "end_ms": 224640,
      "text": "您知道这工程量有多大吗？",
      "token_start": 795,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 224740,
      "end_ms": 228070,
      "text": "嘉峪关的城墙如果换算成一米厚，",
      "token_start": 806,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 228370,
      "end_ms": 229455,
      "text": "五米高的墙，",
      "token_start": 820,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 229800,
      "end_ms": 231100,
      "text": "能把地球绕一圈。",
      "token_start": 825,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 232060,
      "end_ms": 234565,
      "text": "明朝修长城用了多少砖？",
      "token_start": 832,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 235410,
      "end_ms": 237395,
      "text": "传说当年工匠算出来，",
      "token_start": 842,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 238000,
      "end_ms": 243465,
      "text": "嘉峪关关城需要九十九万九千九百九十九块砖，",
      "token_start": 851,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 243950,
      "end_ms": 244915,
      "text": "多一块都不要。",
      "token_start": 871,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 245830,
      "end_ms": 247135,
      "text": "结果竣工的时候，",
      "token_start": 877,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 247450,
      "end_ms": 251735,
      "text": "偏偏多出来一块放在西瓮城的门台上，",
      "token_start": 884,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 252490,
      "end_ms": 254575,
      "text": "几百年来没人敢动他，",
      "token_start": 900,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 255530,
      "end_ms": 258630,
      "text": "老百姓管他叫定城砖一块砖，",
      "token_start": 909,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 258670,
      "end_ms": 259755,
      "text": "放了几百年，",
      "token_start": 921,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 260120,
      "end_ms": 261035,
      "text": "谁都不敢碰。",
      "token_start": 926,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 261560,
      "end_ms": 263800,
      "text": "您说这规矩严到什么份上？",
      "token_start": 931,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 263860,
      "end_ms": 264465,
      "text": "第一名，",
      "token_start": 942,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 264820,
      "end_ms": 266800,
      "text": "四川都江堰等等。",
      "token_start": 945,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 266980,
      "end_ms": 268675,
      "text": "都江堰不是第五名吗？",
      "token_start": 952,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 269550,
      "end_ms": 269925,
      "text": "对，",
      "token_start": 961,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 270370,
      "end_ms": 273015,
      "text": "第五名是都江堰水利工程。",
      "token_start": 962,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 274000,
      "end_ms": 278785,
      "text": "我说的第一名是都江堰底下的那套地下维护系统。",
      "token_start": 973,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 279360,
      "end_ms": 281520,
      "text": "您知道都江堰两千多年不坏，",
      "token_start": 994,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 281520,
      "end_ms": 282625,
      "text": "靠的是什么吗？",
      "token_start": 1006,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 283010,
      "end_ms": 283830,
      "text": "不是靠石头，",
      "token_start": 1012,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 283830,
      "end_ms": 285385,
      "text": "硬是靠制度。",
      "token_start": 1017,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 286050,
      "end_ms": 288365,
      "text": "李斌当年定了六个字的规矩，",
      "token_start": 1022,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 288760,
      "end_ms": 290535,
      "text": "深陶滩低作焰。",
      "token_start": 1034,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 291180,
      "end_ms": 292725,
      "text": "每年冬天枯水期。",
      "token_start": 1040,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 293190,
      "end_ms": 299110,
      "text": "河宫要把内江河床挖到看见埋在底下的石马为止。",
      "token_start": 1047,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 299930,
      "end_ms": 304970,
      "text": "这就是深淘滩飞沙堰的高度必须比内江河床低。",
      "token_start": 1068,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 305510,
      "end_ms": 309630,
      "text": "这就是低座堰李冰还在河床底下埋了卧铁。",
      "token_start": 1088,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 309990,
      "end_ms": 312030,
      "text": "作为青淤深度的标准，",
      "token_start": 1106,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 312770,
      "end_ms": 317590,
      "text": "这套维护制度从秦朝一直执行到今天，",
      "token_start": 1115,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 318130,
      "end_ms": 321910,
      "text": "两千两百多年没断过别的古建筑，",
      "token_start": 1131,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 322030,
      "end_ms": 323740,
      "text": "靠的是材料和手艺。",
      "token_start": 1145,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 324100,
      "end_ms": 327500,
      "text": "都江堰靠的是一代一代人守着规矩干活，",
      "token_start": 1153,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 328020,
      "end_ms": 330960,
      "text": "这才是真正坐头把交椅的东西。",
      "token_start": 1170,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 331520,
      "end_ms": 332820,
      "text": "不是死的建筑，",
      "token_start": 1183,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 333020,
      "end_ms": 334320,
      "text": "是活的制度。",
      "token_start": 1189,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 334980,
      "end_ms": 336480,
      "text": "从第五道第一名，",
      "token_start": 1194,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 336860,
      "end_ms": 341140,
      "text": "都江堰用两千两百年的规矩养活了上千万人。",
      "token_start": 1201,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 341160,
      "end_ms": 345220,
      "text": "坎儿井在地下三千多公里悄悄送水。",
      "token_start": 1220,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 345800,
      "end_ms": 347840,
      "text": "乐山大佛一个人挖了眼睛，",
      "token_start": 1235,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 347920,
      "end_ms": 349460,
      "text": "几代人凿了九十年，",
      "token_start": 1246,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 349760,
      "end_ms": 351380,
      "text": "长城一块定成砖，",
      "token_start": 1254,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 351400,
      "end_ms": 352420,
      "text": "放了几百年，",
      "token_start": 1261,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 352420,
      "end_ms": 353335,
      "text": "没人干度。",
      "token_start": 1266,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 354040,
      "end_ms": 357165,
      "text": "都江堰底下的清淤制度一天没断过，",
      "token_start": 1270,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 358100,
      "end_ms": 359075,
      "text": "可您知道吗？",
      "token_start": 1285,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 359860,
      "end_ms": 362570,
      "text": "这五座里面有三座，",
      "token_start": 1290,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 362570,
      "end_ms": 364055,
      "text": "到今天还在干活，",
      "token_start": 1298,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 364900,
      "end_ms": 366740,
      "text": "还有两座藏州的秘密，",
      "token_start": 1305,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 366820,
      "end_ms": 368065,
      "text": "到现在都没解开，",
      "token_start": 1314,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 368460,
      "end_ms": 369185,
      "text": "点个关注，",
      "token_start": 1321,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 369710,
      "end_ms": 371255,
      "text": "下一期咱们接着聊。",
      "token_start": 1325,
      "token_end_exclusive": 1333
    }
  ],
