  "segments": [
    {
      "start_ms": 210,
      "end_ms": 2310,
      "text": "今天被一篇文章狠狠的共情了，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 2450,
      "end_ms": 3030,
      "text": "值得分享。",
      "token_start": 13,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 3030,
      "end_ms": 5010,
      "text": "给孩子和屏幕前的你。",
      "token_start": 17,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5550,
      "end_ms": 8950,
      "text": "文章的题目叫做妈妈怕了你一辈子。",
      "token_start": 26,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 9530,
      "end_ms": 11710,
      "text": "怀孕时妈妈怕你畸形。",
      "token_start": 41,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 12090,
      "end_ms": 12730,
      "text": "出生时，",
      "token_start": 50,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13290,
      "end_ms": 14470,
      "text": "妈妈怕你生病，",
      "token_start": 53,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15070,
      "end_ms": 15950,
      "text": "到了幼儿园，",
      "token_start": 59,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 16250,
      "end_ms": 17690,
      "text": "妈妈怕你受欺负。",
      "token_start": 64,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 18190,
      "end_ms": 18890,
      "text": "小学时，",
      "token_start": 71,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 19330,
      "end_ms": 20630,
      "text": "妈妈怕你跟不上。",
      "token_start": 74,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21270,
      "end_ms": 22250,
      "text": "到了初中了，",
      "token_start": 81,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 22410,
      "end_ms": 23550,
      "text": "妈妈怕你叛逆。",
      "token_start": 86,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 23830,
      "end_ms": 24450,
      "text": "高中时，",
      "token_start": 92,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 24970,
      "end_ms": 26190,
      "text": "妈妈怕你早恋。",
      "token_start": 95,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 26810,
      "end_ms": 27510,
      "text": "大学时，",
      "token_start": 101,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 27790,
      "end_ms": 29010,
      "text": "妈妈怕你堕落，",
      "token_start": 104,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 29350,
      "end_ms": 30000,
      "text": "步入社会，",
      "token_start": 110,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 30220,
      "end_ms": 31060,
      "text": "会了，",
      "token_start": 114,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 31060,
      "end_ms": 33020,
      "text": "妈妈怕你受委屈。",
      "token_start": 116,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 33020,
      "end_ms": 34240,
      "text": "结婚时，",
      "token_start": 123,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 34240,
      "end_ms": 37020,
      "text": "妈妈怕你不幸福妈妈，",
      "token_start": 126,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 37820,
      "end_ms": 40260,
      "text": "老了怕给你添麻烦。",
      "token_start": 135,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 40480,
      "end_ms": 42180,
      "text": "妈妈走了，",
      "token_start": 143,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 42180,
      "end_ms": 47380,
      "text": "怕你孤单的牵妈想妈妈，",
      "token_start": 147,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 47380,
      "end_ms": 53040,
      "text": "而是你一辈子。",
      "token_start": 157,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 54360,
      "end_ms": 57360,
      "text": "最放心不下的牵挂。",
