{
  "video_id": "v_2dd2488b04507c8f",
  "duration_s": 510.965517,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_2dd2488b04507c8f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_2dd2488b04507c8f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1015,
      "text": "上级说道，",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 4140,
      "end_ms": 15645,
      "text": "一个小学毕业当过工人和赤脚医生的女人三十岁那年在一台缝纫机上开始写小说。",
      "token_start": 4,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 18460,
      "end_ms": 19520,
      "text": "您肯定想问，",
      "token_start": 39,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 19880,
      "end_ms": 21920,
      "text": "就他能写出个啥？",
      "token_start": 44,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 22160,
      "end_ms": 25560,
      "text": "可偏偏就是这台缝纫机上写出来的东西，",
      "token_start": 51,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 26300,
      "end_ms": 28440,
      "text": "后来震动了整个文坛，",
      "token_start": 68,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 29000,
      "end_ms": 31800,
      "text": "还让外国人排着队去研究它。",
      "token_start": 77,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 33020,
      "end_ms": 42200,
      "text": "今儿这段咱就讲讲一个裁缝是怎么从缝纫机台面上一路写进世界文学殿堂的。",
      "token_start": 89,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 43240,
      "end_ms": 44240,
      "text": "一九八三年，",
      "token_start": 122,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 44760,
      "end_ms": 46100,
      "text": "残雪三十岁，",
      "token_start": 127,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 46180,
      "end_ms": 48870,
      "text": "白天给人量体裁衣得了空，",
      "token_start": 132,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 49090,
      "end_ms": 50670,
      "text": "把布往边上一推，",
      "token_start": 143,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 51210,
      "end_ms": 54130,
      "text": "铺开纸就写别的作家要书房，",
      "token_start": 150,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 54330,
      "end_ms": 55010,
      "text": "要安静，",
      "token_start": 162,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 55270,
      "end_ms": 56209,
      "text": "要烟要酒。",
      "token_start": 165,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 56530,
      "end_ms": 57990,
      "text": "他只要一台缝纫机，",
      "token_start": 169,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 58650,
      "end_ms": 60175,
      "text": "他自己都觉得奇怪，",
      "token_start": 177,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 60600,
      "end_ms": 61600,
      "text": "坐下就能写，",
      "token_start": 185,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 61720,
      "end_ms": 62875,
      "text": "不用想情节，",
      "token_start": 190,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 63130,
      "end_ms": 64125,
      "text": "不用列提纲，",
      "token_start": 195,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 64530,
      "end_ms": 65825,
      "text": "一口气往下走，",
      "token_start": 200,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 66130,
      "end_ms": 69205,
      "text": "写出来的第一步叫黄泥街。",
      "token_start": 206,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 70090,
      "end_ms": 74255,
      "text": "他哥哥邓小蒙是武汉大学出了名的哲学教授，",
      "token_start": 217,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 74720,
      "end_ms": 76205,
      "text": "也是有大学问的人。",
      "token_start": 236,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 76720,
      "end_ms": 77880,
      "text": "看完他写的稿子，",
      "token_start": 244,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 77980,
      "end_ms": 79305,
      "text": "半天没说出话来，",
      "token_start": 251,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 79730,
      "end_ms": 80810,
      "text": "最后憋出一句，",
      "token_start": 258,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 80890,
      "end_ms": 84575,
      "text": "我从没见过这样的写法里头的劲儿，",
      "token_start": 264,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 85240,
      "end_ms": 86180,
      "text": "摧枯拉朽，",
      "token_start": 279,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 86560,
      "end_ms": 88904,
      "text": "可也带着股让人后怕的危险性。",
      "token_start": 283,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 89810,
      "end_ms": 91775,
      "text": "他劝残雪这东西，",
      "token_start": 296,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 92070,
      "end_ms": 93575,
      "text": "十年之内别想发表，",
      "token_start": 303,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 94120,
      "end_ms": 95725,
      "text": "弄不好要惹大祸，",
      "token_start": 311,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 96220,
      "end_ms": 97080,
      "text": "搁那个年月，",
      "token_start": 318,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 97260,
      "end_ms": 98295,
      "text": "这不是吓唬人，",
      "token_start": 323,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 98600,
      "end_ms": 100975,
      "text": "是真有人因为作品出过大事，",
      "token_start": 329,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 101460,
      "end_ms": 103415,
      "text": "黄泥街写完往哪儿发，",
      "token_start": 341,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 103790,
      "end_ms": 107055,
      "text": "有人推荐到北京的大杂志退回来了，",
      "token_start": 350,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 107290,
      "end_ms": 108490,
      "text": "托人送到上海，",
      "token_start": 365,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 108730,
      "end_ms": 112670,
      "text": "人家也不要兜兜转转好几年稿子都翻旧了。",
      "token_start": 371,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 112710,
      "end_ms": 115229,
      "text": "最后是老作家丁玲拍了板，",
      "token_start": 389,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 115370,
      "end_ms": 117695,
      "text": "把他登在自己主编的刊物上，",
      "token_start": 400,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 118380,
      "end_ms": 120055,
      "text": "那已经是一九八六年了。",
      "token_start": 412,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 120540,
      "end_ms": 121360,
      "text": "书一出来，",
      "token_start": 422,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 121600,
      "end_ms": 123595,
      "text": "长沙的文坛先炸了锅，",
      "token_start": 426,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 124220,
      "end_ms": 125045,
      "text": "这人谁呀？",
      "token_start": 435,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 125480,
      "end_ms": 128115,
      "text": "一个裁缝写的东西跟谁都不一样。",
      "token_start": 439,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 129000,
      "end_ms": 132715,
      "text": "残血就这样从一个踩缝纫机的个体户，",
      "token_start": 453,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 133210,
      "end_ms": 136165,
      "text": "一步跨成了先锋文学的代表人物，",
      "token_start": 469,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 137150,
      "end_ms": 138865,
      "text": "怎么形容他写的东西呢？",
      "token_start": 483,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 139360,
      "end_ms": 141425,
      "text": "有人说了句特到位的话，",
      "token_start": 493,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 141810,
      "end_ms": 143105,
      "text": "残血像个女巫，",
      "token_start": 503,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 143580,
      "end_ms": 145505,
      "text": "文字在他手里服服帖帖，",
      "token_start": 509,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 145850,
      "end_ms": 147030,
      "text": "可拼出来的画面，",
      "token_start": 519,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 147070,
      "end_ms": 148790,
      "text": "诡异规律，",
      "token_start": 526,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 149110,
      "end_ms": 150955,
      "text": "像一场醒不过来的梦。",
      "token_start": 530,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 151770,
      "end_ms": 153475,
      "text": "你说他写的是小说吧，",
      "token_start": 539,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 154120,
      "end_ms": 156435,
      "text": "字里行间全是诗的质地，",
      "token_start": 548,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 156880,
      "end_ms": 157915,
      "text": "哲学的骨头。",
      "token_start": 558,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 158340,
      "end_ms": 161505,
      "text": "这种东西不是技巧能磨出来的，",
      "token_start": 563,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 162080,
      "end_ms": 163940,
      "text": "是他前半辈子那些苦，",
      "token_start": 576,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 164240,
      "end_ms": 167365,
      "text": "那些荒诞从骨头缝里咽出来。",
      "token_start": 585,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 168010,
      "end_ms": 170250,
      "text": "正因为这份独一份的味道，",
      "token_start": 597,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 170710,
      "end_ms": 173995,
      "text": "残血在西方文学圈彻底杀疯了。",
      "token_start": 608,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 174470,
      "end_ms": 177605,
      "text": "他是作品被翻译的最多的中国作家之一，",
      "token_start": 621,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 178320,
      "end_ms": 184515,
      "text": "美国、哈佛、康奈尔、哥伦比亚这些顶尖大学拿他的书当文学教材。",
      "token_start": 638,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 184920,
      "end_ms": 190255,
      "text": "日本人专门办了一本以他名字命名的研究杂志。",
      "token_start": 664,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 190900,
      "end_ms": 193435,
      "text": "你品品一个中国作家，",
      "token_start": 684,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 193760,
      "end_ms": 197035,
      "text": "让外国人专门出本杂志来研究，",
      "token_start": 693,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 197660,
      "end_ms": 198695,
      "text": "这是什么待遇？",
      "token_start": 706,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 199210,
      "end_ms": 204985,
      "text": "诺奖评委大名鼎鼎的汉学家马跃然直接给他扣了顶大帽子。",
      "token_start": 712,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 205790,
      "end_ms": 210815,
      "text": "中国的卡夫卡美国作家苏珊桑塔格说的更干脆，",
      "token_start": 737,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 211270,
      "end_ms": 213855,
      "text": "残血是中国最好的作家。",
      "token_start": 757,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 214830,
      "end_ms": 215750,
      "text": "二零一二年，",
      "token_start": 767,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 215750,
      "end_ms": 217185,
      "text": "莫言拿诺奖前，",
      "token_start": 772,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 218120,
      "end_ms": 219425,
      "text": "有人问他预测谁，",
      "token_start": 778,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 220260,
      "end_ms": 221180,
      "text": "他想了想说，",
      "token_start": 785,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 221300,
      "end_ms": 222005,
      "text": "我不预测，",
      "token_start": 790,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 222400,
      "end_ms": 225475,
      "text": "但我希望是中国的女作家残雪获奖。",
      "token_start": 794,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 225900,
      "end_ms": 226845,
      "text": "二零一五年，",
      "token_start": 809,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 227240,
      "end_ms": 231525,
      "text": "残血萍最后的情人拿下美国最佳翻译图书奖。",
      "token_start": 814,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 231960,
      "end_ms": 232885,
      "text": "至今为止，",
      "token_start": 833,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 233250,
      "end_ms": 234885,
      "text": "拿过这个奖的中国作家，",
      "token_start": 837,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 235320,
      "end_ms": 236385,
      "text": "就他一个。",
      "token_start": 847,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 238060,
      "end_ms": 239395,
      "text": "二零一九年，",
      "token_start": 851,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 240280,
      "end_ms": 241500,
      "text": "二零二一年，",
      "token_start": 856,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 242240,
      "end_ms": 245820,
      "text": "他又两次闯进国际不客奖的长名单，",
      "token_start": 861,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 246340,
      "end_ms": 250260,
      "text": "那是全世界文学圈最难进的名单之一。",
      "token_start": 876,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 251700,
      "end_ms": 252660,
      "text": "可问题来了，",
      "token_start": 892,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 252980,
      "end_ms": 254760,
      "text": "墙内开花墙外香，",
      "token_start": 897,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 255400,
      "end_ms": 257300,
      "text": "残雪在国外被追着捧，",
      "token_start": 904,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 257640,
      "end_ms": 260620,
      "text": "回到国内却跟隐形人似的。",
      "token_start": 913,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 260640,
      "end_ms": 261280,
      "text": "为什么？",
      "token_start": 924,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 261420,
      "end_ms": 263500,
      "text": "除了大家心照不宣的原因，",
      "token_start": 927,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 263960,
      "end_ms": 266740,
      "text": "更大的问题出在他这个人身上，",
      "token_start": 938,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 267000,
      "end_ms": 267940,
      "text": "太值了。",
      "token_start": 951,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 268600,
      "end_ms": 270430,
      "text": "他早年公开说过一句话，",
      "token_start": 954,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 270870,
      "end_ms": 273890,
      "text": "中国文坛好多作家都在混日子，",
      "token_start": 964,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 274270,
      "end_ms": 277190,
      "text": "那些所谓的批评家抱成一团，",
      "token_start": 977,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 277290,
      "end_ms": 278209,
      "text": "糊弄读者，",
      "token_start": 989,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 278350,
      "end_ms": 279030,
      "text": "这一句话，",
      "token_start": 993,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 279230,
      "end_ms": 280290,
      "text": "得罪了多少人？",
      "token_start": 997,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 280530,
      "end_ms": 281910,
      "text": "他还不光嘴上说，",
      "token_start": 1003,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 282250,
      "end_ms": 283590,
      "text": "专门写了本书，",
      "token_start": 1010,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 284390,
      "end_ms": 286350,
      "text": "但着文坛挨个点名，",
      "token_start": 1016,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 286890,
      "end_ms": 288430,
      "text": "这也是残学。",
      "token_start": 1024,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 288450,
      "end_ms": 288910,
      "text": "这些年，",
      "token_start": 1029,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 288910,
      "end_ms": 292390,
      "text": "在公众视野里几度消失的原因之一，",
      "token_start": 1032,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 293030,
      "end_ms": 297290,
      "text": "但有意思的是人可以被消音文字消不了。",
      "token_start": 1047,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 297570,
      "end_ms": 299270,
      "text": "如今他七十多岁了，",
      "token_start": 1064,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 299490,
      "end_ms": 301915,
      "text": "缩在原云南一个安静的角落里，",
      "token_start": 1072,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 302360,
      "end_ms": 304445,
      "text": "写作的劲头比年轻人还猛，",
      "token_start": 1085,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 305210,
      "end_ms": 307925,
      "text": "他的作息几十年如一日。",
      "token_start": 1096,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 308350,
      "end_ms": 312070,
      "text": "刻板的象台中早上七点准时起，",
      "token_start": 1106,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 312430,
      "end_ms": 315070,
      "text": "九点坐下读哲学，",
      "token_start": 1119,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 315530,
      "end_ms": 318290,
      "text": "写哲学一个半小时，",
      "token_start": 1126,
      "token_end_exclusive": 1134
    },
    {
      "start_ms": 319110,
      "end_ms": 321390,
      "text": "下午两点接着读，",
      "token_start": 1134,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 322610,
      "end_ms": 327110,
      "text": "接着写又是一个半小时。",
      "token_start": 1141,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 327950,
      "end_ms": 329090,
      "text": "白天这两段，",
      "token_start": 1151,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 330890,
      "end_ms": 332990,
      "text": "他下的全是哲学的功夫，",
      "token_start": 1156,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 333130,
      "end_ms": 336150,
      "text": "然后起身锻炼跑步，",
      "token_start": 1166,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 336930,
      "end_ms": 338610,
      "text": "从年轻的时候就开始跑步，",
      "token_start": 1174,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 339390,
      "end_ms": 342730,
      "text": "就直坚持到现在在长沙跑，",
      "token_start": 1185,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 343570,
      "end_ms": 346690,
      "text": "在北京跑到云南接着跑，",
      "token_start": 1196,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 347770,
      "end_ms": 348950,
      "text": "等晚饭落了桌，",
      "token_start": 1206,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 349430,
      "end_ms": 350930,
      "text": "才轮到他一天。",
      "token_start": 1212,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 351030,
      "end_ms": 354830,
      "text": "真正的正活写小说就写一个钟头，",
      "token_start": 1218,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 355130,
      "end_ms": 356100,
      "text": "八九百百字，",
      "token_start": 1232,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 356480,
      "end_ms": 358660,
      "text": "一笔一画全是手写，",
      "token_start": 1237,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 359000,
      "end_ms": 363900,
      "text": "写完再坐下来学英语英文原版书，",
      "token_start": 1245,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 364380,
      "end_ms": 367160,
      "text": "一页一页啃七十三岁，",
      "token_start": 1259,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 367240,
      "end_ms": 368365,
      "text": "白天啃哲学，",
      "token_start": 1268,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 368900,
      "end_ms": 370220,
      "text": "晚上手写小说，",
      "token_start": 1273,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 370520,
      "end_ms": 372215,
      "text": "还学英语跑步，",
      "token_start": 1279,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 372950,
      "end_ms": 376605,
      "text": "这几样摊到咱自己身上哪一样都不容易。",
      "token_start": 1285,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 377300,
      "end_ms": 377900,
      "text": "有人说，",
      "token_start": 1302,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 377900,
      "end_ms": 383065,
      "text": "他年年上诺奖赔率榜却年年落空替他惋惜，",
      "token_start": 1305,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 383680,
      "end_ms": 385645,
      "text": "可他自己早把这事看淡了。",
      "token_start": 1323,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 386220,
      "end_ms": 390765,
      "text": "他曾经这样形容自己的写作是我活的方式，",
      "token_start": 1334,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 391410,
      "end_ms": 392625,
      "text": "写作是活的方式。",
      "token_start": 1352,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 393000,
      "end_ms": 396355,
      "text": "他自己解读为不是谋生的手段，",
      "token_start": 1359,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 396760,
      "end_ms": 398160,
      "text": "不是出名的梯子，",
      "token_start": 1372,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 398300,
      "end_ms": 399735,
      "text": "是活着的本身。",
      "token_start": 1379,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 400510,
      "end_ms": 403685,
      "text": "至于那个奖是锦上添花，",
      "token_start": 1385,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 404360,
      "end_ms": 405780,
      "text": "花开不开花，",
      "token_start": 1395,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 405860,
      "end_ms": 406875,
      "text": "都在那儿开着。",
      "token_start": 1400,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 407510,
      "end_ms": 409270,
      "text": "听到这儿肯定有朋友，",
      "token_start": 1406,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 409270,
      "end_ms": 410585,
      "text": "心里开始痒痒了。",
      "token_start": 1415,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 411670,
      "end_ms": 412805,
      "text": "这么个奇人，",
      "token_start": 1422,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 413170,
      "end_ms": 415375,
      "text": "他写的作品到底是个啥味儿？",
      "token_start": 1427,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 416020,
      "end_ms": 417125,
      "text": "我也想翻番，",
      "token_start": 1439,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 417600,
      "end_ms": 418705,
      "text": "可他那么多书，",
      "token_start": 1444,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 419080,
      "end_ms": 419865,
      "text": "头一回读，",
      "token_start": 1450,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 420200,
      "end_ms": 422325,
      "text": "从哪本下手问的好，",
      "token_start": 1454,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 422660,
      "end_ms": 423685,
      "text": "我给您交个底。",
      "token_start": 1462,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 424740,
      "end_ms": 427175,
      "text": "连给他出书的出版社都讲了一句话，",
      "token_start": 1468,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 427960,
      "end_ms": 431160,
      "text": "读残雪就从黄泥阶开始，",
      "token_start": 1483,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 432080,
      "end_ms": 433560,
      "text": "为啥偏偏是他？",
      "token_start": 1493,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 434520,
      "end_ms": 435420,
      "text": "您别忘了，",
      "token_start": 1499,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 436260,
      "end_ms": 437040,
      "text": "这就是他。",
      "token_start": 1503,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 437040,
      "end_ms": 440380,
      "text": "三十岁那年在裁缝铺的缝纫机上，",
      "token_start": 1507,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 440620,
      "end_ms": 442420,
      "text": "把布料往边上一推，",
      "token_start": 1521,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 442560,
      "end_ms": 444320,
      "text": "铺开纸一个字一个字，",
      "token_start": 1529,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 444320,
      "end_ms": 447200,
      "text": "熬出来的第一部长篇写了好几年，",
      "token_start": 1538,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 447360,
      "end_ms": 449060,
      "text": "被人退了一回又一回，",
      "token_start": 1552,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 449360,
      "end_ms": 452820,
      "text": "最后靠丁玲拍板才见着天日。",
      "token_start": 1561,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 453480,
      "end_ms": 457040,
      "text": "他后来呢将近九十本书的根全在这一本里，",
      "token_start": 1573,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 457040,
      "end_ms": 459910,
      "text": "他写一条脏的不能再脏的街，",
      "token_start": 1591,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 460430,
      "end_ms": 463630,
      "text": "人在里头像虫子一样挣扎着活着，",
      "token_start": 1603,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 464030,
      "end_ms": 465430,
      "text": "嘴上说着大道理，",
      "token_start": 1617,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 465730,
      "end_ms": 466870,
      "text": "背地里喂了一口，",
      "token_start": 1624,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 466870,
      "end_ms": 468710,
      "text": "吃的什么都肯干。",
      "token_start": 1631,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 469090,
      "end_ms": 471010,
      "text": "他哥哥邓小蒙看完说，",
      "token_start": 1638,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 471010,
      "end_ms": 473130,
      "text": "里头有股摧枯拉朽的生命力。",
      "token_start": 1647,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 474690,
      "end_ms": 475650,
      "text": "您读这本书，",
      "token_start": 1659,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 475710,
      "end_ms": 477750,
      "text": "读的不是一条街上的热闹，",
      "token_start": 1664,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 477970,
      "end_ms": 480250,
      "text": "是一个人在最苦的年月里，",
      "token_start": 1675,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 480570,
      "end_ms": 485110,
      "text": "怎么把心里那团不肯灭的火一笔一笔写成了字。",
      "token_start": 1686,
      "token_end_exclusive": 1706
    },
    {
      "start_ms": 486190,
      "end_ms": 490080,
      "text": "我把这本黄泥街给您放在视频左下角链接里了，",
      "token_start": 1706,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 490440,
      "end_ms": 492300,
      "text": "感兴趣的朋友可以拍回家，",
      "token_start": 1726,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 492300,
      "end_ms": 493245,
      "text": "细细品读，",
      "token_start": 1737,
      "token_end_exclusive": 1741
    },
    {
      "start_ms": 494080,
      "end_ms": 501625,
      "text": "最后动动手指转发给家里人发到咱相亲相爱一家人的群里，",
      "token_start": 1741,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 502660,
      "end_ms": 508690,
      "text": "让更多人知道咱中国还有这样一位了不起的女作家，",
      "token_start": 1766,
      "token_end_exclusive": 1788
    },
    {
      "start_ms": 508990,
      "end_ms": 510825,
      "text": "咱们下期继续讲。",
      "token_start": 1788,
      "token_end_exclusive": 1795
    }
  ],
