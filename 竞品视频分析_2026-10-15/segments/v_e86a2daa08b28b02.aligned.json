  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2070,
      "text": "今年这月饼怕是要卖不动了，",
      "token_start": 0,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 2070,
      "end_ms": 3150,
      "text": "中秋节还没到，",
      "token_start": 12,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 3150,
      "end_ms": 4770,
      "text": "不少商场超市在大降价。",
      "token_start": 18,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 5250,
      "end_ms": 6330,
      "text": "网上有消息说，",
      "token_start": 28,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 6530,
      "end_ms": 7950,
      "text": "其实饼饼厂很多，",
      "token_start": 34,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 7950,
      "end_ms": 9450,
      "text": "早早的就就停工了，",
      "token_start": 41,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 9650,
      "end_ms": 10750,
      "text": "订单少的可怜。",
      "token_start": 49,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 11350,
      "end_ms": 11890,
      "text": "有人说，",
      "token_start": 55,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12030,
      "end_ms": 14350,
      "text": "月饼高油高糖还不健康，",
      "token_start": 58,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 14590,
      "end_ms": 17270,
      "text": "越来越多的人也不怎么爱吃月饼了。",
      "token_start": 68,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 17770,
      "end_ms": 20270,
      "text": "网上还流传出这样一段很火的顺口溜，",
      "token_start": 83,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 20610,
      "end_ms": 22470,
      "text": "十五的月亮十六元，",
      "token_start": 99,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 22870,
      "end_ms": 23790,
      "text": "石榴的月饼，",
      "token_start": 107,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 24030,
      "end_ms": 26550,
      "text": "一块钱一样的味道一样甜。",
      "token_start": 112,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 26990,
      "end_ms": 29090,
      "text": "为啥我要多花冤枉钱？",
      "token_start": 123,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 30180,
      "end_ms": 30940,
      "text": "说实在的，",
      "token_start": 132,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 30960,
      "end_ms": 33160,
      "text": "往年我会买很多的月饼走亲戚，",
      "token_start": 136,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 33440,
      "end_ms": 34880,
      "text": "今年我也买的很少了。",
      "token_start": 149,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 35360,
      "end_ms": 37160,
      "text": "与其华而不实的月饼礼盒，",
      "token_start": 158,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 37400,
      "end_ms": 39620,
      "text": "倒不如亲自登门探望，",
      "token_start": 169,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 39860,
      "end_ms": 41940,
      "text": "常回家看看陪陪家人，",
      "token_start": 178,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 42420,
      "end_ms": 46600,
      "text": "然后带一些新鲜的水果、蔬菜和鱼肉实惠又健康。",
      "token_start": 187,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 47300,
      "end_ms": 48160,
      "text": "想问问大家，",
      "token_start": 207,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 48380,
      "end_ms": 50105,
      "text": "今年你都买月饼了吗？",
      "token_start": 212,
      "token_end_exclusive": 221
    }
