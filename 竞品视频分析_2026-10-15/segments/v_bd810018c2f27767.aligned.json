{
  "video_id": "v_bd810018c2f27767",
  "duration_s": 424.345011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_bd810018c2f27767.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_bd810018c2f27767.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 5130,
      "text": "您知道中国历史上最像世外桃源的古村落是哪一个吗？",
      "token_start": 0,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5850,
      "end_ms": 6450,
      "text": "有人说，",
      "token_start": 23,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6450,
      "end_ms": 12670,
      "text": "是红村八百多年的老村遗汪月凿映着粉墙黛瓦，",
      "token_start": 26,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 13210,
      "end_ms": 14690,
      "text": "人称画里乡村。",
      "token_start": 46,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 15110,
      "end_ms": 23850,
      "text": "有人说是西地九百多年青石板巷子一条连的一条像一座活着的明清博物馆，",
      "token_start": 52,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 24410,
      "end_ms": 26790,
      "text": "错红村和西地，",
      "token_start": 84,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 27150,
      "end_ms": 29130,
      "text": "连前寺都没排进去，",
      "token_start": 90,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 29570,
      "end_ms": 32200,
      "text": "真正并排在榜首的那座村子，",
      "token_start": 98,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 32700,
      "end_ms": 36340,
      "text": "深藏在几座六千米高的雪峰怀里，",
      "token_start": 110,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 36820,
      "end_ms": 38480,
      "text": "千百年来与世隔绝，",
      "token_start": 124,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 38980,
      "end_ms": 40700,
      "text": "它不靠老房子出名，",
      "token_start": 132,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 41140,
      "end_ms": 47460,
      "text": "却有一种让人看上一眼就想留下来安度余生的神奇魔力。",
      "token_start": 140,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 47840,
      "end_ms": 53080,
      "text": "今天咱们就来盘点中国历史上十大最像世外桃源的古村落。",
      "token_start": 164,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 53740,
      "end_ms": 54400,
      "text": "老规矩，",
      "token_start": 189,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 54940,
      "end_ms": 55780,
      "text": "开讲之前，",
      "token_start": 192,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 55880,
      "end_ms": 58240,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 196,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 58620,
      "end_ms": 59700,
      "text": "让我看看都是谁。",
      "token_start": 206,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 59700,
      "end_ms": 61545,
      "text": "在听第十名，",
      "token_start": 213,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 61870,
      "end_ms": 65400,
      "text": "红村安徽一县洪村，",
      "token_start": 218,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 65440,
      "end_ms": 68645,
      "text": "您肯定听过越找一汪清水，",
      "token_start": 226,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 69040,
      "end_ms": 70755,
      "text": "倒映着粉墙黛瓦，",
      "token_start": 237,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 71070,
      "end_ms": 72745,
      "text": "人称画里乡村。",
      "token_start": 244,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 73190,
      "end_ms": 74115,
      "text": "八百年前，",
      "token_start": 250,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 74620,
      "end_ms": 78545,
      "text": "老辈人把整座村子设计成了一头蜗牛，",
      "token_start": 254,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 79310,
      "end_ms": 80695,
      "text": "越早是牛位，",
      "token_start": 270,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 81070,
      "end_ms": 82255,
      "text": "南湖是牛肚，",
      "token_start": 275,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 82670,
      "end_ms": 84335,
      "text": "一条水镇是牛长，",
      "token_start": 280,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 84910,
      "end_ms": 85990,
      "text": "九曲十八弯，",
      "token_start": 287,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 86070,
      "end_ms": 88645,
      "text": "把活水引到家家户户门前。",
      "token_start": 292,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 89060,
      "end_ms": 91640,
      "text": "您要是清晨挑个靠水的小摊，",
      "token_start": 303,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 91720,
      "end_ms": 92175,
      "text": "坐下，",
      "token_start": 315,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 92630,
      "end_ms": 95110,
      "text": "一碗热气腾腾的黄山毛峰，",
      "token_start": 317,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 95290,
      "end_ms": 97125,
      "text": "端在手里一抬眼，",
      "token_start": 328,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 97540,
      "end_ms": 100860,
      "text": "水面平的像面镜子倒映着老房檐。",
      "token_start": 335,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 101240,
      "end_ms": 103700,
      "text": "身旁的老阿姨就蹲在石阶上，",
      "token_start": 349,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 103720,
      "end_ms": 106015,
      "text": "洗菜水声哗哗作响，",
      "token_start": 361,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 106500,
      "end_ms": 108575,
      "text": "洗完还笑着跟您打个招呼。",
      "token_start": 369,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 109010,
      "end_ms": 111535,
      "text": "在这里喝着茶看水、看鸭子，",
      "token_start": 380,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 111910,
      "end_ms": 113435,
      "text": "一坐能坐大半天。",
      "token_start": 391,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 113830,
      "end_ms": 116855,
      "text": "一个村子被人当成一头牛来养，",
      "token_start": 398,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 117280,
      "end_ms": 118315,
      "text": "养成了一幅画，",
      "token_start": 411,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 118780,
      "end_ms": 120745,
      "text": "您说这日子过得惬意不惬。",
      "token_start": 417,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 121370,
      "end_ms": 122185,
      "text": "第九名，",
      "token_start": 428,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 122720,
      "end_ms": 124695,
      "text": "西地村也在一线，",
      "token_start": 431,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 125200,
      "end_ms": 126255,
      "text": "离洪村不远。",
      "token_start": 438,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 126940,
      "end_ms": 129500,
      "text": "如果说红村是画西帝，",
      "token_start": 443,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 129660,
      "end_ms": 132435,
      "text": "就是一座活着的明清博物馆。",
      "token_start": 452,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 132870,
      "end_ms": 135710,
      "text": "九百多年里青石版巷子，",
      "token_start": 464,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 135710,
      "end_ms": 138880,
      "text": "一条连着一条高大的马头墙，",
      "token_start": 474,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 139020,
      "end_ms": 140275,
      "text": "往天上一夹，",
      "token_start": 486,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 141010,
      "end_ms": 143845,
      "text": "抬头只能瞅见一根蓝线线。",
      "token_start": 491,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 144270,
      "end_ms": 147195,
      "text": "您要是真一脚踩进这深巷里，",
      "token_start": 502,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 147560,
      "end_ms": 149455,
      "text": "外头的汽车声全没了，",
      "token_start": 514,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 150110,
      "end_ms": 155025,
      "text": "只听见自己的鞋底敲在光溜溜的石板上嘟嘟响，",
      "token_start": 523,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 155440,
      "end_ms": 160335,
      "text": "偶尔路过一扇虚掩着的后木门探头往里瞅，",
      "token_start": 543,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 161170,
      "end_ms": 162855,
      "text": "天井下养的荷花，",
      "token_start": 561,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 163390,
      "end_ms": 165685,
      "text": "老藤椅在阴凉处摆着，",
      "token_start": 568,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 166230,
      "end_ms": 169045,
      "text": "屋里飘出一股子陈年木头香。",
      "token_start": 577,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 169430,
      "end_ms": 173200,
      "text": "村口的古牌坊立了四百多年朝代，",
      "token_start": 589,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 173220,
      "end_ms": 175660,
      "text": "换了一个又一个西帝，",
      "token_start": 603,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 175720,
      "end_ms": 176915,
      "text": "还是那个西帝，",
      "token_start": 612,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 177240,
      "end_ms": 179495,
      "text": "一抬脚就跨进了老时光，",
      "token_start": 618,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 179920,
      "end_ms": 181200,
      "text": "您说迷人不迷人？",
      "token_start": 628,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 181480,
      "end_ms": 182400,
      "text": "第八名，",
      "token_start": 635,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 182760,
      "end_ms": 183480,
      "text": "诸葛村。",
      "token_start": 638,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 183840,
      "end_ms": 186600,
      "text": "浙江兰溪住在这儿的，",
      "token_start": 641,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 186800,
      "end_ms": 189040,
      "text": "大多是诸葛亮的后人，",
      "token_start": 650,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 189660,
      "end_ms": 194560,
      "text": "六百多年前从外地迁来一带代住到今天，",
      "token_start": 659,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 194940,
      "end_ms": 197240,
      "text": "他最特别的是村子的布局。",
      "token_start": 676,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 198000,
      "end_ms": 200780,
      "text": "中间一口中池向个太极图，",
      "token_start": 687,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 201360,
      "end_ms": 203880,
      "text": "八条巷子从池边向外散开，",
      "token_start": 698,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 204280,
      "end_ms": 207180,
      "text": "通向八个方向一圈圈拐出去。",
      "token_start": 709,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 207780,
      "end_ms": 210630,
      "text": "您要是第一次进来转几圈，",
      "token_start": 721,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 210810,
      "end_ms": 212470,
      "text": "估摸着就会找不着北。",
      "token_start": 732,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 213150,
      "end_ms": 217790,
      "text": "传说这是照着诸葛亮的八阵图排出来的村里，",
      "token_start": 741,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 217850,
      "end_ms": 221450,
      "text": "至今保存着两百多处明清古剑，",
      "token_start": 760,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 222230,
      "end_ms": 225170,
      "text": "还有专门供奉诸葛丞像的祠堂，",
      "token_start": 773,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 225610,
      "end_ms": 230070,
      "text": "一个村子把祖先的智慧铺进了每一条巷子里，",
      "token_start": 786,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 230490,
      "end_ms": 234670,
      "text": "让人走进去就像走进了一道没解开的题。",
      "token_start": 805,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 235270,
      "end_ms": 237810,
      "text": "您说这是不是最有悬念的？",
      "token_start": 822,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 237810,
      "end_ms": 238210,
      "text": "桃堂？",
      "token_start": 833,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 238530,
      "end_ms": 241845,
      "text": "一七名把茶祭村安徽泾县，",
      "token_start": 835,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 242290,
      "end_ms": 245050,
      "text": "他在皖南山里几条溪水，",
      "token_start": 846,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 245150,
      "end_ms": 246265,
      "text": "穿村而过，",
      "token_start": 856,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 246620,
      "end_ms": 248185,
      "text": "古桥横跨水面。",
      "token_start": 860,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 248570,
      "end_ms": 251325,
      "text": "老宅顺着水边一排排铺开，",
      "token_start": 866,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 251840,
      "end_ms": 256725,
      "text": "和李白写下桃花潭水深千尺的地方同在泾县。",
      "token_start": 877,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 257180,
      "end_ms": 257620,
      "text": "相传，",
      "token_start": 896,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 257620,
      "end_ms": 259165,
      "text": "他始建于隋代，",
      "token_start": 898,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 259550,
      "end_ms": 261175,
      "text": "距今一千四百多年，",
      "token_start": 904,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 261890,
      "end_ms": 263330,
      "text": "村里茶姓族人，",
      "token_start": 912,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 263390,
      "end_ms": 265890,
      "text": "世代聚居上百处，",
      "token_start": 918,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 266050,
      "end_ms": 269745,
      "text": "明清古宅祠堂散落在溪水两岸。",
      "token_start": 925,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 270200,
      "end_ms": 273125,
      "text": "别的古村早被人潮踩得热闹起来，",
      "token_start": 938,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 273560,
      "end_ms": 275965,
      "text": "他却一直躲在山水深处，",
      "token_start": 952,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 276290,
      "end_ms": 278395,
      "text": "安安静静走进去，",
      "token_start": 962,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 279000,
      "end_ms": 281465,
      "text": "您只听得见水声鸟叫，",
      "token_start": 969,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 281870,
      "end_ms": 283825,
      "text": "还有风吹过老屋的声音。",
      "token_start": 978,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 284220,
      "end_ms": 285445,
      "text": "一千四百年，",
      "token_start": 988,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 285790,
      "end_ms": 287375,
      "text": "他没被时间吞掉，",
      "token_start": 993,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 287750,
      "end_ms": 289165,
      "text": "也没被人群淹没。",
      "token_start": 1000,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 289720,
      "end_ms": 290115,
      "text": "您说。",
      "token_start": 1007,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 290510,
      "end_ms": 292970,
      "text": "这不就是最标准的隐居地吗？",
      "token_start": 1009,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 293270,
      "end_ms": 293930,
      "text": "第六名，",
      "token_start": 1021,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 294210,
      "end_ms": 294890,
      "text": "郭亮村，",
      "token_start": 1024,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 295270,
      "end_ms": 296210,
      "text": "河南辉县。",
      "token_start": 1027,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 296750,
      "end_ms": 299190,
      "text": "很多人以为郭亮村只有惊险，",
      "token_start": 1031,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 299790,
      "end_ms": 302670,
      "text": "可只要穿过挂壁公路进了村，",
      "token_start": 1043,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 303330,
      "end_ms": 306010,
      "text": "眼前完全是另一重田地。",
      "token_start": 1055,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 306470,
      "end_ms": 315770,
      "text": "整个村子全是就地取材的红石头、石头、房子、石头、磨盘、石头、小板凳。",
      "token_start": 1065,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 316150,
      "end_ms": 319905,
      "text": "您要是坐在村头大柳树下的石墩子上，",
      "token_start": 1092,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 320400,
      "end_ms": 321880,
      "text": "老乡端来一碗热，",
      "token_start": 1108,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 321880,
      "end_ms": 322680,
      "text": "玉米糊糊，",
      "token_start": 1115,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 323180,
      "end_ms": 325080,
      "text": "就着香喷喷的山核桃，",
      "token_start": 1119,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 325580,
      "end_ms": 326280,
      "text": "一抬头，",
      "token_start": 1128,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 326820,
      "end_ms": 328680,
      "text": "白云就贴着石房顶，",
      "token_start": 1131,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 328780,
      "end_ms": 330120,
      "text": "慢悠悠飘过去，",
      "token_start": 1139,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 330520,
      "end_ms": 333660,
      "text": "大悬崖把山外的嘈杂死死切断。",
      "token_start": 1145,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 333980,
      "end_ms": 334980,
      "text": "您里一抬头，",
      "token_start": 1158,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 335280,
      "end_ms": 337440,
      "text": "满天都是亮晶晶的星星，",
      "token_start": 1163,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 337800,
      "end_ms": 338880,
      "text": "没有催促，",
      "token_start": 1173,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 339240,
      "end_ms": 342160,
      "text": "只有山峰在这待上两天，",
      "token_start": 1177,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 342560,
      "end_ms": 344440,
      "text": "您真会舍不得下山。",
      "token_start": 1187,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 344800,
      "end_ms": 347560,
      "text": "您说这算不算真正的世外桃源？",
      "token_start": 1195,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 347980,
      "end_ms": 349660,
      "text": "从第十到第六名，",
      "token_start": 1208,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 350000,
      "end_ms": 353590,
      "text": "您同村饮水进门像幅画袭地，",
      "token_start": 1215,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 353610,
      "end_ms": 354050,
      "text": "高墙，",
      "token_start": 1227,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 354130,
      "end_ms": 355475,
      "text": "身向锁清净，",
      "token_start": 1229,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 356250,
      "end_ms": 357510,
      "text": "诸葛村八卦，",
      "token_start": 1234,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 357590,
      "end_ms": 359770,
      "text": "迷魂几百年茶记，",
      "token_start": 1239,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 359790,
      "end_ms": 361415,
      "text": "十里老桥伴流水。",
      "token_start": 1246,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 361990,
      "end_ms": 364050,
      "text": "郭亮村更是在云端上头，",
      "token_start": 1253,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 364050,
      "end_ms": 366305,
      "text": "过着最淳朴的石头日子，",
      "token_start": 1263,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 366750,
      "end_ms": 370135,
      "text": "可他们还不是最像世外桃源的。",
      "token_start": 1273,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 370710,
      "end_ms": 373015,
      "text": "接下来第五道第一名更加绝妙，",
      "token_start": 1286,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 373620,
      "end_ms": 374775,
      "text": "有一座村落。",
      "token_start": 1299,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 375150,
      "end_ms": 376050,
      "text": "一到秋天，",
      "token_start": 1304,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 376230,
      "end_ms": 382805,
      "text": "漫山红叶能让全中国顶尖的画家集体戈壁有一处古寨，",
      "token_start": 1308,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 383480,
      "end_ms": 386835,
      "text": "几百座数百年不倒的高大石头楼，",
      "token_start": 1331,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 387710,
      "end_ms": 391025,
      "text": "硬生生与雪山深谷长成了一体，",
      "token_start": 1345,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 391390,
      "end_ms": 397640,
      "text": "可排在榜首的那座融在雪峰与峡谷深处几百年里，",
      "token_start": 1358,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 397660,
      "end_ms": 399795,
      "text": "只剩下与世隔绝的安静，",
      "token_start": 1379,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 400560,
      "end_ms": 403925,
      "text": "让人看一眼就真想留下来过余生。",
      "token_start": 1389,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 404580,
      "end_ms": 405305,
      "text": "他是哪座？",
      "token_start": 1403,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 405810,
      "end_ms": 409185,
      "text": "他凭什么能排在洪村和西地的前面，",
      "token_start": 1407,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 409620,
      "end_ms": 411785,
      "text": "下一集已经同步更新，",
      "token_start": 1422,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 412390,
      "end_ms": 414150,
      "text": "现在直接点开我的头像，",
      "token_start": 1431,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 414250,
      "end_ms": 415115,
      "text": "进入主页，",
      "token_start": 1441,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 415540,
      "end_ms": 419065,
      "text": "第一条视频就是下一集点个关注，",
      "token_start": 1445,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 419370,
      "end_ms": 423995,
      "text": "看看谁才是真正让人想住上一辈子的终极桃园。",
      "token_start": 1459,
      "token_end_exclusive": 1479
    }
  ],
