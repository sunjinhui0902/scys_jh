{
  "video_id": "v_b6edef1a6d54291a",
  "duration_s": 426.166667,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b6edef1a6d54291a.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b6edef1a6d54291a.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 4590,
      "text": "他临终前最后一句话喊的是快拿产前来。",
      "token_start": 0,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 5670,
      "end_ms": 8230,
      "text": "一九八三年四月二十二号深夜，",
      "token_start": 17,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 8950,
      "end_ms": 10930,
      "text": "北京一间病房，",
      "token_start": 30,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 11330,
      "end_ms": 15890,
      "text": "一位八十二岁的老人躺在床上已经昏迷，",
      "token_start": 36,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 16309,
      "end_ms": 18530,
      "text": "忽然他嘴唇动了动，",
      "token_start": 53,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 18890,
      "end_ms": 20210,
      "text": "急促的喊了出来，",
      "token_start": 61,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 20530,
      "end_ms": 22070,
      "text": "快快拿产前来。",
      "token_start": 68,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 22430,
      "end_ms": 24810,
      "text": "产前护士吓了一跳，",
      "token_start": 74,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 24990,
      "end_ms": 27810,
      "text": "赶紧抓了样东西塞进他手里。",
      "token_start": 82,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 28590,
      "end_ms": 31860,
      "text": "老人握着那东西慢慢平息下来。",
      "token_start": 94,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 32720,
      "end_ms": 33660,
      "text": "过了一会儿，",
      "token_start": 107,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 33900,
      "end_ms": 36060,
      "text": "脸上竟然露出一丝微笑，",
      "token_start": 112,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 36600,
      "end_ms": 37920,
      "text": "说了最后一句话，",
      "token_start": 122,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 38520,
      "end_ms": 39880,
      "text": "又是一个胖娃娃，",
      "token_start": 129,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 40360,
      "end_ms": 42400,
      "text": "一晚上三个真好。",
      "token_start": 136,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 43100,
      "end_ms": 45280,
      "text": "然后他安静的走了。",
      "token_start": 143,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 45740,
      "end_ms": 49940,
      "text": "您说一个人临死前惦记的不是家人，",
      "token_start": 151,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 50180,
      "end_ms": 51140,
      "text": "不是财产，",
      "token_start": 166,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 51420,
      "end_ms": 51860,
      "text": "喊的，",
      "token_start": 170,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 51860,
      "end_ms": 53700,
      "text": "是一把接生用的钳子。",
      "token_start": 172,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 54160,
      "end_ms": 55080,
      "text": "他到底是谁？",
      "token_start": 181,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 56040,
      "end_ms": 57060,
      "text": "他叫林巧智，",
      "token_start": 186,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 58000,
      "end_ms": 60430,
      "text": "中国妇产科学的惦袭人，",
      "token_start": 191,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 60530,
      "end_ms": 62615,
      "text": "中国科学院第一位女院士。",
      "token_start": 201,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 63410,
      "end_ms": 65025,
      "text": "他一辈子没结过婚，",
      "token_start": 212,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 65420,
      "end_ms": 66775,
      "text": "没生过一个孩子，",
      "token_start": 220,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 67150,
      "end_ms": 71985,
      "text": "却亲手把五万多个新生命从死神手里拽了回来。",
      "token_start": 227,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 72990,
      "end_ms": 74855,
      "text": "孩子们管他叫万英之母，",
      "token_start": 247,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 75350,
      "end_ms": 77775,
      "text": "可就是这么一位神一样的人物。",
      "token_start": 257,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 78120,
      "end_ms": 79095,
      "text": "五岁那年，",
      "token_start": 270,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 79450,
      "end_ms": 80985,
      "text": "也曾跪在床边，",
      "token_start": 274,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 81520,
      "end_ms": 84445,
      "text": "眼睁睁看着母亲被病魔带走，",
      "token_start": 280,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 84840,
      "end_ms": 87745,
      "text": "哭的撕心裂肺却什么都做不了。",
      "token_start": 292,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 88410,
      "end_ms": 91195,
      "text": "一个五岁的孩子那时候能懂什么，",
      "token_start": 305,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 92160,
      "end_ms": 92960,
      "text": "可他懂了，",
      "token_start": 319,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 92960,
      "end_ms": 94850,
      "text": "一件事儿妈，",
      "token_start": 323,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 94870,
      "end_ms": 95330,
      "text": "没了，",
      "token_start": 328,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 95350,
      "end_ms": 96065,
      "text": "天塌了。",
      "token_start": 330,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 96490,
      "end_ms": 97415,
      "text": "从那天起，",
      "token_start": 333,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 97750,
      "end_ms": 99725,
      "text": "他心里种下一颗种子，",
      "token_start": 337,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 100160,
      "end_ms": 101095,
      "text": "我要当医生，",
      "token_start": 346,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 101460,
      "end_ms": 103655,
      "text": "我要让别人的妈不再死。",
      "token_start": 351,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 104580,
      "end_ms": 108385,
      "text": "一九二一年二十岁的他去考协和医学院，",
      "token_start": 361,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 109040,
      "end_ms": 111735,
      "text": "那学校有多难进百里挑一，",
      "token_start": 378,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 112090,
      "end_ms": 114125,
      "text": "能考进去的学生全是尖子，",
      "token_start": 389,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 114550,
      "end_ms": 116395,
      "text": "前几场考的顺风顺水。",
      "token_start": 400,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 117070,
      "end_ms": 118235,
      "text": "最后一门英语，",
      "token_start": 409,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 118490,
      "end_ms": 119775,
      "text": "他正埋头答题。",
      "token_start": 415,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 120220,
      "end_ms": 125255,
      "text": "考场里咕咚一声一个女同学中暑晕倒了。",
      "token_start": 421,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 126330,
      "end_ms": 127875,
      "text": "监考老师是个男的，",
      "token_start": 438,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 128550,
      "end_ms": 132040,
      "text": "看到是女生穿的裙子服也不是不服，",
      "token_start": 446,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 132040,
      "end_ms": 135035,
      "text": "也不是其他考生抬头瞟了一眼，",
      "token_start": 461,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 135320,
      "end_ms": 136180,
      "text": "赶紧低头，",
      "token_start": 474,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 136180,
      "end_ms": 136985,
      "text": "接着做题，",
      "token_start": 478,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 137380,
      "end_ms": 138655,
      "text": "生怕耽误一秒。",
      "token_start": 482,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 139270,
      "end_ms": 141485,
      "text": "只有林巧志把笔一扔，",
      "token_start": 488,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 141850,
      "end_ms": 142615,
      "text": "冲了过去，",
      "token_start": 497,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 143180,
      "end_ms": 144940,
      "text": "服人通风湿，",
      "token_start": 501,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 144940,
      "end_ms": 145945,
      "text": "毛巾擦脸。",
      "token_start": 506,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 146230,
      "end_ms": 148275,
      "text": "他守在旁边一步没挪，",
      "token_start": 510,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 148880,
      "end_ms": 149705,
      "text": "等他忙活完，",
      "token_start": 519,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 150020,
      "end_ms": 151615,
      "text": "英语考试早结束了。",
      "token_start": 524,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 151860,
      "end_ms": 152425,
      "text": "他心想，",
      "token_start": 532,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 152810,
      "end_ms": 153385,
      "text": "完了，",
      "token_start": 535,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 153640,
      "end_ms": 154825,
      "text": "这门成绩没了，",
      "token_start": 537,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 155130,
      "end_ms": 156905,
      "text": "录取这事儿肯定黄了。",
      "token_start": 543,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 157620,
      "end_ms": 158605,
      "text": "可一个月后，",
      "token_start": 552,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 158960,
      "end_ms": 161555,
      "text": "录取通知书直接寄到了家。",
      "token_start": 557,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 162090,
      "end_ms": 163065,
      "text": "后来他才知道，",
      "token_start": 568,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 163340,
      "end_ms": 164720,
      "text": "考官就认准了一句话，",
      "token_start": 574,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 164740,
      "end_ms": 167475,
      "text": "一个学生能在最要命的关头，",
      "token_start": 583,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 167750,
      "end_ms": 169765,
      "text": "放下自己的前程去救人。",
      "token_start": 595,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 170240,
      "end_ms": 171665,
      "text": "这就是当医生的料，",
      "token_start": 605,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 172190,
      "end_ms": 173375,
      "text": "分数可以补考，",
      "token_start": 613,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 173740,
      "end_ms": 174705,
      "text": "人品补不了。",
      "token_start": 619,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 175150,
      "end_ms": 176105,
      "text": "进了协和。",
      "token_start": 624,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 176430,
      "end_ms": 178925,
      "text": "他偏偏挑了又脏又累的妇产科。",
      "token_start": 628,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 179610,
      "end_ms": 181825,
      "text": "那时候医院有条不成文的规矩，",
      "token_start": 641,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 182480,
      "end_ms": 185615,
      "text": "女医生一旦结婚就得卷铺盖走人，",
      "token_start": 654,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 186190,
      "end_ms": 189195,
      "text": "意思明摆着要事业就别要加。",
      "token_start": 668,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 190220,
      "end_ms": 191645,
      "text": "林巧至没犹豫，",
      "token_start": 680,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 191870,
      "end_ms": 193865,
      "text": "直接把自己嫁给了医院，",
      "token_start": 686,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 194510,
      "end_ms": 196635,
      "text": "后来多少人给他介绍对象。",
      "token_start": 696,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 198010,
      "end_ms": 201930,
      "text": "银行家的儿子刘洋的博士条件一个比一个好，",
      "token_start": 707,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 202050,
      "end_ms": 202845,
      "text": "他全推了，",
      "token_start": 726,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 203150,
      "end_ms": 204145,
      "text": "别人急得跺脚，",
      "token_start": 730,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 204600,
      "end_ms": 206375,
      "text": "你真要一个人过一辈子，",
      "token_start": 736,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 206730,
      "end_ms": 208055,
      "text": "他低头写着病历，",
      "token_start": 746,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 208470,
      "end_ms": 209515,
      "text": "头也不抬的说，",
      "token_start": 753,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 209780,
      "end_ms": 212385,
      "text": "天天接受哪有空想这些。",
      "token_start": 759,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 213040,
      "end_ms": 213965,
      "text": "一九四一年，",
      "token_start": 769,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 214290,
      "end_ms": 215210,
      "text": "太平洋战争，",
      "token_start": 774,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 215210,
      "end_ms": 215715,
      "text": "爆发，",
      "token_start": 779,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 216070,
      "end_ms": 217825,
      "text": "协和医院被迫关门。",
      "token_start": 781,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 218450,
      "end_ms": 220845,
      "text": "有人劝他回鼓浪屿躲一躲，",
      "token_start": 789,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 221560,
      "end_ms": 222205,
      "text": "他摇头，",
      "token_start": 800,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 223580,
      "end_ms": 225015,
      "text": "我的病人还在这儿，",
      "token_start": 803,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 225400,
      "end_ms": 226275,
      "text": "我往哪儿躲。",
      "token_start": 811,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 227290,
      "end_ms": 230175,
      "text": "他在东塘子胡同租了几间房，",
      "token_start": 816,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 230530,
      "end_ms": 233125,
      "text": "开了间小诊所达官贵人来，",
      "token_start": 828,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 234330,
      "end_ms": 235890,
      "text": "他看拉洋车的来，",
      "token_start": 839,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 236110,
      "end_ms": 236795,
      "text": "他也看，",
      "token_start": 846,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 237760,
      "end_ms": 239095,
      "text": "碰上真穷的，",
      "token_start": 849,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 239330,
      "end_ms": 240585,
      "text": "他不但不收钱，",
      "token_start": 854,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 241000,
      "end_ms": 243915,
      "text": "还自掏腰包给产妇买鸡蛋，",
      "token_start": 860,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 244210,
      "end_ms": 244905,
      "text": "买红糖。",
      "token_start": 871,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 245410,
      "end_ms": 246935,
      "text": "兵荒马乱的年月，",
      "token_start": 874,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 247170,
      "end_ms": 248675,
      "text": "他心里只有一个念头，",
      "token_start": 881,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 249240,
      "end_ms": 250585,
      "text": "大人孩子能活下来，",
      "token_start": 890,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 250970,
      "end_ms": 251795,
      "text": "比什么都强。",
      "token_start": 898,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 252880,
      "end_ms": 253915,
      "text": "再后来那些年，",
      "token_start": 903,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 254260,
      "end_ms": 255535,
      "text": "他也受过委屈，",
      "token_start": 909,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 256260,
      "end_ms": 257725,
      "text": "被罚去打扫卫生，",
      "token_start": 915,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 258070,
      "end_ms": 258765,
      "text": "洗便盆，",
      "token_start": 922,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 259610,
      "end_ms": 262005,
      "text": "那双接生了几万个孩子的手，",
      "token_start": 925,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 262620,
      "end_ms": 263835,
      "text": "泡在冷水里，",
      "token_start": 937,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 264220,
      "end_ms": 266155,
      "text": "有人偷偷替他鸣不平。",
      "token_start": 942,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 266900,
      "end_ms": 267995,
      "text": "他只说了一句，",
      "token_start": 951,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 268510,
      "end_ms": 270495,
      "text": "只要还让我留在协和，",
      "token_start": 957,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 270920,
      "end_ms": 271985,
      "text": "干什么都行。",
      "token_start": 966,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 272220,
      "end_ms": 273045,
      "text": "您听这话，",
      "token_start": 971,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 273460,
      "end_ms": 277935,
      "text": "哪像一个受了委屈的人说的这就叫风骨。",
      "token_start": 975,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 278640,
      "end_ms": 280545,
      "text": "他给孕妇听胎心钱，",
      "token_start": 992,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 280990,
      "end_ms": 285465,
      "text": "一定先把冰凉的听诊器贴在自己手心里捂热。",
      "token_start": 1000,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 286100,
      "end_ms": 286555,
      "text": "他说，",
      "token_start": 1019,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 286860,
      "end_ms": 288365,
      "text": "母亲已经在受罪了，",
      "token_start": 1021,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 288760,
      "end_ms": 291085,
      "text": "能少一点粮就少一点量。",
      "token_start": 1029,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 292070,
      "end_ms": 293070,
      "text": "一九六二年，",
      "token_start": 1039,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 293990,
      "end_ms": 295830,
      "text": "一个刚出生的婴儿，",
      "token_start": 1044,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 296530,
      "end_ms": 297630,
      "text": "全身发黄，",
      "token_start": 1052,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 298370,
      "end_ms": 299670,
      "text": "眼看不行了，",
      "token_start": 1056,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 300550,
      "end_ms": 304210,
      "text": "这种病国内没人治过，",
      "token_start": 1061,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 304610,
      "end_ms": 306310,
      "text": "家属都快放弃了。",
      "token_start": 1070,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 307170,
      "end_ms": 308330,
      "text": "同事劝他，",
      "token_start": 1077,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 309530,
      "end_ms": 312650,
      "text": "林大夫这病咱没治过，",
      "token_start": 1081,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 313510,
      "end_ms": 314330,
      "text": "别接了，",
      "token_start": 1090,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 315470,
      "end_ms": 316130,
      "text": "他摇头，",
      "token_start": 1093,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 316330,
      "end_ms": 317490,
      "text": "只要有一线希望，",
      "token_start": 1096,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 317590,
      "end_ms": 318450,
      "text": "我就得试试。",
      "token_start": 1103,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 319350,
      "end_ms": 320910,
      "text": "他翻遍外文资料，",
      "token_start": 1108,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 321150,
      "end_ms": 321570,
      "text": "一页，",
      "token_start": 1115,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 321570,
      "end_ms": 324340,
      "text": "一夜找找到一种办法，",
      "token_start": 1117,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 325040,
      "end_ms": 329200,
      "text": "脐带换血第一次没成功，",
      "token_start": 1126,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 330020,
      "end_ms": 333400,
      "text": "第二次又复发。",
      "token_start": 1136,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 333760,
      "end_ms": 336820,
      "text": "第三次孩子终于哭出了第一生，",
      "token_start": 1142,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 337360,
      "end_ms": 341780,
      "text": "那是中国第一例被救回来的新生儿溶血症患儿。",
      "token_start": 1155,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 342200,
      "end_ms": 344660,
      "text": "他救的不是一个孩子，",
      "token_start": 1175,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 344940,
      "end_ms": 346400,
      "text": "他身后一整个家，",
      "token_start": 1184,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 346820,
      "end_ms": 348900,
      "text": "晚年他瘫在病床上，",
      "token_start": 1191,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 349280,
      "end_ms": 350820,
      "text": "手抖得握不住笔，",
      "token_start": 1199,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 351200,
      "end_ms": 352575,
      "text": "就靠在在那儿口述，",
      "token_start": 1206,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 353070,
      "end_ms": 353915,
      "text": "让学生记，",
      "token_start": 1214,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 354250,
      "end_ms": 357065,
      "text": "硬是完成了五十万字的妇科肿瘤。",
      "token_start": 1218,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 357270,
      "end_ms": 360535,
      "text": "他说我欠这个国家的还没还完。",
      "token_start": 1232,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 361050,
      "end_ms": 364335,
      "text": "他临走前立下遗嘱三万元积蓄，",
      "token_start": 1245,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 364630,
      "end_ms": 367910,
      "text": "全部捐给幼儿园托儿所遗体，",
      "token_start": 1258,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 368130,
      "end_ms": 369795,
      "text": "居然给医学院做研究。",
      "token_start": 1270,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 370470,
      "end_ms": 372895,
      "text": "骨灰洒回鼓浪屿的海面，",
      "token_start": 1279,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 373220,
      "end_ms": 375015,
      "text": "您看他这一辈子，",
      "token_start": 1289,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 375390,
      "end_ms": 380165,
      "text": "把自己整个人连最后一寸都交给了别人。",
      "token_start": 1296,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 381050,
      "end_ms": 385455,
      "text": "所以当他弥留之际喊出快拿铲钱来的时候，",
      "token_start": 1313,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 385960,
      "end_ms": 387295,
      "text": "您还觉得奇怪吗？",
      "token_start": 1331,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 387920,
      "end_ms": 388835,
      "text": "那不是糊涂，",
      "token_start": 1338,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 389300,
      "end_ms": 391065,
      "text": "那是他一生热爱的东西。",
      "token_start": 1343,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 391550,
      "end_ms": 393755,
      "text": "在生命最后一刻又回来了。",
      "token_start": 1353,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 395240,
      "end_ms": 396885,
      "text": "什么是真正的热爱？",
      "token_start": 1364,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 397830,
      "end_ms": 399825,
      "text": "不是活着的时候说说而已，",
      "token_start": 1372,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 400570,
      "end_ms": 402135,
      "text": "是到死的那一刻，",
      "token_start": 1383,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 402720,
      "end_ms": 407180,
      "text": "还惦记着点亮红心收藏。",
      "token_start": 1390,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 407260,
      "end_ms": 410985,
      "text": "这条视频转发出去，",
      "token_start": 1400,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 411480,
      "end_ms": 417880,
      "text": "让更多人知道中国曾经有这样一位万英之母。",
      "token_start": 1408,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 418720,
      "end_ms": 419380,
      "text": "关注我，",
      "token_start": 1427,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 419580,
      "end_ms": 420560,
      "text": "明天告诉您，",
      "token_start": 1430,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 420840,
      "end_ms": 423140,
      "text": "一个一辈子没结婚的女人，",
      "token_start": 1435,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 423380,
      "end_ms": 426055,
      "text": "凭什么成了五万个孩子的妈？",
      "token_start": 1446,
      "token_end_exclusive": 1458
    }
  ],
