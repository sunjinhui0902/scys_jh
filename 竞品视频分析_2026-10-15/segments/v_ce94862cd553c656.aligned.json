{
  "video_id": "v_ce94862cd553c656",
  "duration_s": 577.689002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_ce94862cd553c656.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_ce94862cd553c656.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 280,
      "end_ms": 680,
      "text": "朱军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1080,
      "end_ms": 1820,
      "text": "你相信吗？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2060,
      "end_ms": 4440,
      "text": "选择伴侣就是选择你的命运，",
      "token_start": 6,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4740,
      "end_ms": 5640,
      "text": "一个好的伴侣，",
      "token_start": 18,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5640,
      "end_ms": 7200,
      "text": "可以成为你一生的救赎。",
      "token_start": 24,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 7560,
      "end_ms": 9100,
      "text": "我的老婆比我大三岁，",
      "token_start": 34,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 9480,
      "end_ms": 12760,
      "text": "我告诉你什么叫真正的女大三抱金砖。",
      "token_start": 43,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 13140,
      "end_ms": 15280,
      "text": "我在五年前第一次遇见他的时候，",
      "token_start": 59,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 15280,
      "end_ms": 18200,
      "text": "当时正处于我人生最低谷的至难时期。",
      "token_start": 73,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 18500,
      "end_ms": 19520,
      "text": "经书店破产，",
      "token_start": 89,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 19840,
      "end_ms": 21200,
      "text": "欠了三百多万的外债。",
      "token_start": 94,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 21520,
      "end_ms": 24180,
      "text": "当时我已经把家里两套房子全卖了，",
      "token_start": 103,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 24300,
      "end_ms": 26760,
      "text": "我和父母不得不临时租房的居住。",
      "token_start": 118,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 27400,
      "end_ms": 29420,
      "text": "我记得诗人瓦尔德过海关的时候，",
      "token_start": 132,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 29420,
      "end_ms": 30690,
      "text": "问他带了什么行李，",
      "token_start": 146,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 30690,
      "end_ms": 32890,
      "text": "他说我除了才华一无所有，",
      "token_start": 154,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 33050,
      "end_ms": 35830,
      "text": "而当时我就是这种一无所有的穷困状态。",
      "token_start": 165,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 36110,
      "end_ms": 37370,
      "text": "但是我老婆鼓励我说，",
      "token_start": 182,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 37750,
      "end_ms": 40670,
      "text": "我看你的面相以后不会是一个缺钱的人。",
      "token_start": 191,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 40970,
      "end_ms": 41930,
      "text": "我们结婚的时候，",
      "token_start": 208,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 41930,
      "end_ms": 43190,
      "text": "当时我实在是太穷，",
      "token_start": 215,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 43190,
      "end_ms": 44430,
      "text": "都没有钱去办婚礼，",
      "token_start": 223,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 44710,
      "end_ms": 46790,
      "text": "但她从始至终就没有提过婚礼，",
      "token_start": 231,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 46790,
      "end_ms": 48270,
      "text": "这个事儿不让我难堪，",
      "token_start": 244,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 48750,
      "end_ms": 49950,
      "text": "只是选择了一个日子，",
      "token_start": 253,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 49950,
      "end_ms": 51510,
      "text": "去民政局领了一个结婚证，",
      "token_start": 262,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 51850,
      "end_ms": 53010,
      "text": "我们找了一家餐馆，",
      "token_start": 273,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 53190,
      "end_ms": 54070,
      "text": "吃了一顿火锅，",
      "token_start": 281,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 54330,
      "end_ms": 55270,
      "text": "就算结婚了，",
      "token_start": 287,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 55590,
      "end_ms": 56290,
      "text": "你知道吗？",
      "token_start": 292,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 56370,
      "end_ms": 59010,
      "text": "有些体谅是你明明知道我拿不出来，",
      "token_start": 296,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 59010,
      "end_ms": 60535,
      "text": "却替我保住了那一点，",
      "token_start": 311,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 60740,
      "end_ms": 62055,
      "text": "不愿说出了我的体面。",
      "token_start": 320,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 62510,
      "end_ms": 63475,
      "text": "我越来越明白，",
      "token_start": 329,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 63750,
      "end_ms": 65195,
      "text": "经济基础固然重要，",
      "token_start": 335,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 65600,
      "end_ms": 67730,
      "text": "但更重要的是你要找的那个人，",
      "token_start": 343,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 67930,
      "end_ms": 70370,
      "text": "他的教养、担当和责任心，",
      "token_start": 356,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 70490,
      "end_ms": 72765,
      "text": "以及在你的身上看到了希望。",
      "token_start": 366,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 73180,
      "end_ms": 75380,
      "text": "后来我看到有一个全国讲述人大赛，",
      "token_start": 378,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 75600,
      "end_ms": 77245,
      "text": "我就报名去上海参赛，",
      "token_start": 393,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 77510,
      "end_ms": 78845,
      "text": "结果获得了全国第一名，",
      "token_start": 402,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 79120,
      "end_ms": 83840,
      "text": "成为了那家机构的签约讲述人留在上海录制讲述的课程。",
      "token_start": 412,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 84060,
      "end_ms": 86435,
      "text": "那个时候我们租住在南京南站附近，",
      "token_start": 436,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 86660,
      "end_ms": 88640,
      "text": "我每天早上坐高铁去上海，",
      "token_start": 451,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 88740,
      "end_ms": 90235,
      "text": "傍晚再从虹桥坐回来。",
      "token_start": 462,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 90520,
      "end_ms": 91995,
      "text": "这样两座城来回跑。",
      "token_start": 471,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 92310,
      "end_ms": 93790,
      "text": "我其实并没有觉得多辛苦，",
      "token_start": 479,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 93970,
      "end_ms": 97950,
      "text": "但是真正让我心里面特别难受的是我当时录制的很多节目内容，",
      "token_start": 490,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 97950,
      "end_ms": 99755,
      "text": "必须按照编导的内容要求，",
      "token_start": 517,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 100250,
      "end_ms": 101395,
      "text": "要被他们去修改。",
      "token_start": 528,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 101690,
      "end_ms": 102870,
      "text": "跟我自己想说的话，",
      "token_start": 535,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 103030,
      "end_ms": 104135,
      "text": "常常不太一样，",
      "token_start": 543,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 104620,
      "end_ms": 106020,
      "text": "我的收入虽然是稳定的，",
      "token_start": 549,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 106020,
      "end_ms": 107745,
      "text": "但心里面却总是很拧巴。",
      "token_start": 559,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 108220,
      "end_ms": 108860,
      "text": "直到有一天，",
      "token_start": 569,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 108860,
      "end_ms": 109845,
      "text": "我老婆突然说，",
      "token_start": 574,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 110400,
      "end_ms": 112035,
      "text": "上海这份工作咱不做了，",
      "token_start": 580,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 112280,
      "end_ms": 113475,
      "text": "我们自己做自媒体吗？",
      "token_start": 590,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 113900,
      "end_ms": 117845,
      "text": "我总觉得最顶级的夫妻关系就是我们合起伙来对付这个世界，",
      "token_start": 599,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 118120,
      "end_ms": 120240,
      "text": "而不是关起门来彼此为难，",
      "token_start": 625,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 120560,
      "end_ms": 122775,
      "text": "从此就开启了我的自媒体之路。",
      "token_start": 636,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 123080,
      "end_ms": 125095,
      "text": "由于没有了上海那份稳定的工资，",
      "token_start": 649,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 125370,
      "end_ms": 127415,
      "text": "他就用工资养了我一整年。",
      "token_start": 663,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 127870,
      "end_ms": 129010,
      "text": "他在一家博物馆工作，",
      "token_start": 674,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 129070,
      "end_ms": 131275,
      "text": "我每天就去他的单位食堂蹭饭吃，",
      "token_start": 683,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 131570,
      "end_ms": 133575,
      "text": "在博物馆里面写文案拍视频。",
      "token_start": 697,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 133990,
      "end_ms": 134730,
      "text": "后来有一天，",
      "token_start": 709,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 134730,
      "end_ms": 137575,
      "text": "他的博物馆举办了一场女画家潘玉良的画展。",
      "token_start": 714,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 138000,
      "end_ms": 139560,
      "text": "我第一次知道潘云南的故事，",
      "token_start": 733,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 139680,
      "end_ms": 141100,
      "text": "就把他拍成了短视频，",
      "token_start": 745,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 141220,
      "end_ms": 142335,
      "text": "结果一下子爆火。",
      "token_start": 754,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 142810,
      "end_ms": 147065,
      "text": "而我账号早期的很多爆款内容都是在他的那家博物馆诞生的。",
      "token_start": 761,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 147640,
      "end_ms": 150295,
      "text": "大家看到的是一条视频终于被看见了。",
      "token_start": 787,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 150650,
      "end_ms": 154120,
      "text": "而我心里记得了却视频还没有人看的时候，",
      "token_start": 803,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 154260,
      "end_ms": 155545,
      "text": "他已经在陪着我了。",
      "token_start": 821,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 156220,
      "end_ms": 157400,
      "text": "所谓有人托举，",
      "token_start": 829,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 157400,
      "end_ms": 158780,
      "text": "就是你的努力还没有，",
      "token_start": 835,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 158780,
      "end_ms": 162480,
      "text": "结果他已经替你承担了一部分生活在我的账号。",
      "token_start": 844,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 162480,
      "end_ms": 163660,
      "text": "有了一些成绩之后呢，",
      "token_start": 864,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 163660,
      "end_ms": 166005,
      "text": "我老婆突然决定要从博物馆辞职，",
      "token_start": 873,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 166430,
      "end_ms": 168745,
      "text": "说我们一起离开南京去北京创业。",
      "token_start": 887,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 168980,
      "end_ms": 170885,
      "text": "他说你一定要离开南京，",
      "token_start": 901,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 171210,
      "end_ms": 174185,
      "text": "因为这里很多人见过你从前的失败和窘境。",
      "token_start": 911,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 174590,
      "end_ms": 175415,
      "text": "他观察过我，",
      "token_start": 929,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 175660,
      "end_ms": 177260,
      "text": "他说他们不会接受你，",
      "token_start": 934,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 177260,
      "end_ms": 178360,
      "text": "越来越好的事实，",
      "token_start": 943,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 178560,
      "end_ms": 180380,
      "text": "只会嫉妒你或者拖拽住。",
      "token_start": 950,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 180380,
      "end_ms": 183445,
      "text": "你我以前觉得那是他陪我重新开始，",
      "token_start": 960,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 183710,
      "end_ms": 184515,
      "text": "而现在想想，",
      "token_start": 975,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 184900,
      "end_ms": 187115,
      "text": "那是他自己人生的一次重新开始。",
      "token_start": 980,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 187540,
      "end_ms": 189340,
      "text": "他明明有了一份体面的工作，",
      "token_start": 994,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 189480,
      "end_ms": 190520,
      "text": "有熟悉的生活，",
      "token_start": 1006,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 190660,
      "end_ms": 192505,
      "text": "他更需要勇气离开这一切。",
      "token_start": 1012,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 193070,
      "end_ms": 196225,
      "text": "我们家呢其实每一个重大决定基本上都是我老婆做的。",
      "token_start": 1023,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 196650,
      "end_ms": 198070,
      "text": "在我事业有了起子之后呢，",
      "token_start": 1046,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 198070,
      "end_ms": 198770,
      "text": "存了一些钱，",
      "token_start": 1057,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 199090,
      "end_ms": 199470,
      "text": "贷款，",
      "token_start": 1062,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 199470,
      "end_ms": 201455,
      "text": "在南京郊区买了一栋小别墅。",
      "token_start": 1064,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 201810,
      "end_ms": 204735,
      "text": "结果后来我老婆突然说要把那个房子给卖掉，",
      "token_start": 1076,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 205100,
      "end_ms": 206440,
      "text": "我们不留任何房产，",
      "token_start": 1095,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 206540,
      "end_ms": 207080,
      "text": "只留钱。",
      "token_start": 1103,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 207080,
      "end_ms": 208980,
      "text": "在身上其实说实话，",
      "token_start": 1106,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 208980,
      "end_ms": 210375,
      "text": "我的心里是非常不舍的，",
      "token_start": 1114,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 210580,
      "end_ms": 213015,
      "text": "因为那是我生平第一次见过那么大的房子，",
      "token_start": 1124,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 213280,
      "end_ms": 215035,
      "text": "辛辛苦苦装修了两年多，",
      "token_start": 1142,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 215300,
      "end_ms": 216720,
      "text": "一天都还没住进去过。",
      "token_start": 1152,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 216860,
      "end_ms": 217660,
      "text": "但是我老婆说，",
      "token_start": 1161,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 217860,
      "end_ms": 218940,
      "text": "不希望这么年轻，",
      "token_start": 1167,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 218940,
      "end_ms": 220820,
      "text": "就过上太安逸的生活。",
      "token_start": 1174,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 220900,
      "end_ms": 223105,
      "text": "我们还没有到功成名就的时候，",
      "token_start": 1183,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 223500,
      "end_ms": 224355,
      "text": "一定要去北京，",
      "token_start": 1196,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 224640,
      "end_ms": 227115,
      "text": "在一个更大的环境里把自己放小，",
      "token_start": 1202,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 227390,
      "end_ms": 228345,
      "text": "逼着自己成长。",
      "token_start": 1216,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 228720,
      "end_ms": 229040,
      "text": "朱军，",
      "token_start": 1222,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 229040,
      "end_ms": 229680,
      "text": "你认同吗？",
      "token_start": 1224,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 229960,
      "end_ms": 231580,
      "text": "人生可不是靠做对，",
      "token_start": 1228,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 231640,
      "end_ms": 234785,
      "text": "很多事情是靠不犯致命的错误活下来的。",
      "token_start": 1236,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 235050,
      "end_ms": 236495,
      "text": "而如果选择了一好的伴侣，",
      "token_start": 1253,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 236750,
      "end_ms": 238645,
      "text": "他不一定直接帮助你赚钱，",
      "token_start": 1264,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 238950,
      "end_ms": 240755,
      "text": "但会减少你犯错误的机会。",
      "token_start": 1275,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 241090,
      "end_ms": 241970,
      "text": "少一次冲动，",
      "token_start": 1286,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 242110,
      "end_ms": 242910,
      "text": "少一次内耗，",
      "token_start": 1291,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 243110,
      "end_ms": 244055,
      "text": "少一次走偏。",
      "token_start": 1296,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 244510,
      "end_ms": 245890,
      "text": "三年前我们成了北漂，",
      "token_start": 1301,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 246130,
      "end_ms": 247605,
      "text": "当时在通州办公，",
      "token_start": 1310,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 248030,
      "end_ms": 249710,
      "text": "那个时候我整天都在琢磨，",
      "token_start": 1317,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 249750,
      "end_ms": 251090,
      "text": "怎么能在通州买个房？",
      "token_start": 1328,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 251330,
      "end_ms": 252010,
      "text": "我老婆说，",
      "token_start": 1337,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 252090,
      "end_ms": 253145,
      "text": "你就这点出息，",
      "token_start": 1341,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 253920,
      "end_ms": 255240,
      "text": "确实我真的是穷怕了，",
      "token_start": 1347,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 255240,
      "end_ms": 257545,
      "text": "好像只有房子才会给我带来安全感。",
      "token_start": 1356,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 257840,
      "end_ms": 258745,
      "text": "但是我老婆说，",
      "token_start": 1371,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 259190,
      "end_ms": 261775,
      "text": "我们一定不会止步于通州这个地方。",
      "token_start": 1377,
      "token_end_exclusive": 1392
    },
    {
      "start_ms": 262080,
      "end_ms": 262720,
      "text": "一年之后，",
      "token_start": 1392,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 262800,
      "end_ms": 266375,
      "text": "我们努力搬到了离市区更近的高碑店中国传媒大学。",
      "token_start": 1396,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 266740,
      "end_ms": 267340,
      "text": "两年之后，",
      "token_start": 1418,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 267340,
      "end_ms": 269645,
      "text": "又搬到了北京最市中心的国贸。",
      "token_start": 1422,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 270100,
      "end_ms": 271320,
      "text": "今年我儿子两岁半，",
      "token_start": 1435,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 271480,
      "end_ms": 273375,
      "text": "我们让他在香港读幼儿园，",
      "token_start": 1443,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 273760,
      "end_ms": 274515,
      "text": "而你知道吗？",
      "token_start": 1454,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 274790,
      "end_ms": 276530,
      "text": "从办各种证件手续，",
      "token_start": 1459,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 276550,
      "end_ms": 280250,
      "text": "到给我儿子选学校去面试、搬家定做家具等等，",
      "token_start": 1467,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 280250,
      "end_ms": 283205,
      "text": "所有琐碎的事情都是靠着他一个人去完成的。",
      "token_start": 1486,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 283730,
      "end_ms": 286775,
      "text": "我自己呢我每天下午要闭关写作三个小时，",
      "token_start": 1505,
      "token_end_exclusive": 1523
    },
    {
      "start_ms": 287220,
      "end_ms": 291200,
      "text": "我老婆就帮我准时把茶水、文具、水果等等全部都准备好，",
      "token_start": 1523,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 291360,
      "end_ms": 292795,
      "text": "再帮我亲生把门关上。",
      "token_start": 1546,
      "token_end_exclusive": 1555
    },
    {
      "start_ms": 293130,
      "end_ms": 293890,
      "text": "这个时间点，",
      "token_start": 1555,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 293910,
      "end_ms": 294985,
      "text": "谁都不能打扰我。",
      "token_start": 1560,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 295320,
      "end_ms": 299545,
      "text": "他说一定要保护好家里面最能赚钱的那个人的心神。",
      "token_start": 1567,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 299980,
      "end_ms": 302200,
      "text": "不能让他的精力损耗的太厉害，",
      "token_start": 1589,
      "token_end_exclusive": 1602
    },
    {
      "start_ms": 302360,
      "end_ms": 304180,
      "text": "不要让他忙家里的琐事，",
      "token_start": 1602,
      "token_end_exclusive": 1612
    },
    {
      "start_ms": 304300,
      "end_ms": 305100,
      "text": "不要作他，",
      "token_start": 1612,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 305100,
      "end_ms": 305800,
      "text": "不要跟他闹，",
      "token_start": 1616,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 306080,
      "end_ms": 308180,
      "text": "这个就是实实在在托举的力量。",
      "token_start": 1621,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 308460,
      "end_ms": 309400,
      "text": "结果五年以来，",
      "token_start": 1634,
      "token_end_exclusive": 1640
    },
    {
      "start_ms": 309400,
      "end_ms": 310340,
      "text": "我越发相信，",
      "token_start": 1640,
      "token_end_exclusive": 1645
    },
    {
      "start_ms": 310480,
      "end_ms": 312380,
      "text": "婚姻真的不是靠经营出来的，",
      "token_start": 1645,
      "token_end_exclusive": 1657
    },
    {
      "start_ms": 312460,
      "end_ms": 314660,
      "text": "是从一开始你就选对了人，",
      "token_start": 1657,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 314960,
      "end_ms": 317940,
      "text": "在爱人这件事上选择大于努力。",
      "token_start": 1668,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 318140,
      "end_ms": 319140,
      "text": "我心里很清楚，",
      "token_start": 1681,
      "token_end_exclusive": 1687
    },
    {
      "start_ms": 319340,
      "end_ms": 322260,
      "text": "我老婆才是这个世界上最希望我能好的人。",
      "token_start": 1687,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 322540,
      "end_ms": 324340,
      "text": "任何人说的话你都可以不信。",
      "token_start": 1705,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 324460,
      "end_ms": 325600,
      "text": "但是老婆说的话，",
      "token_start": 1717,
      "token_end_exclusive": 1724
    },
    {
      "start_ms": 325660,
      "end_ms": 328660,
      "text": "你一定要信我觉得一个男人最愚蠢的行为，",
      "token_start": 1724,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 328660,
      "end_ms": 329710,
      "text": "就是谁的话都听，",
      "token_start": 1742,
      "token_end_exclusive": 1749
    },
    {
      "start_ms": 330050,
      "end_ms": 331130,
      "text": "就是不听老婆的。",
      "token_start": 1749,
      "token_end_exclusive": 1756
    },
    {
      "start_ms": 331690,
      "end_ms": 332990,
      "text": "自从创业几年以来，",
      "token_start": 1756,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 332990,
      "end_ms": 336590,
      "text": "我们家所有的房本车本都是写着我老婆一个人的名字，",
      "token_start": 1764,
      "token_end_exclusive": 1787
    },
    {
      "start_ms": 336730,
      "end_ms": 339030,
      "text": "我们公司的法人和董事长也都是他。",
      "token_start": 1787,
      "token_end_exclusive": 1802
    },
    {
      "start_ms": 339170,
      "end_ms": 341250,
      "text": "而我呢就是他旗下的艺人，",
      "token_start": 1802,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 341430,
      "end_ms": 343710,
      "text": "每个月领一份薪水和固定的零花钱。",
      "token_start": 1813,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 343930,
      "end_ms": 346810,
      "text": "我特别享受别人喜欢这种稳定的生活节奏。",
      "token_start": 1828,
      "token_end_exclusive": 1846
    },
    {
      "start_ms": 347010,
      "end_ms": 347770,
      "text": "而你知道吗？",
      "token_start": 1846,
      "token_end_exclusive": 1851
    },
    {
      "start_ms": 347990,
      "end_ms": 349150,
      "text": "一直到今天为止，",
      "token_start": 1851,
      "token_end_exclusive": 1858
    },
    {
      "start_ms": 349290,
      "end_ms": 350050,
      "text": "四年以来，",
      "token_start": 1858,
      "token_end_exclusive": 1862
    },
    {
      "start_ms": 350070,
      "end_ms": 354230,
      "text": "我的每一条短视频都是我的老婆拿着手机对手去拍的，",
      "token_start": 1862,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 354390,
      "end_ms": 355790,
      "text": "也全程不用稳定器，",
      "token_start": 1885,
      "token_end_exclusive": 1893
    },
    {
      "start_ms": 355790,
      "end_ms": 357110,
      "text": "他的手就是稳定器。",
      "token_start": 1893,
      "token_end_exclusive": 1901
    },
    {
      "start_ms": 357670,
      "end_ms": 358550,
      "text": "我拍摄的时候，",
      "token_start": 1901,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 358550,
      "end_ms": 359720,
      "text": "那些所有的不耐烦，",
      "token_start": 1907,
      "token_end_exclusive": 1915
    },
    {
      "start_ms": 359780,
      "end_ms": 361585,
      "text": "人对伍他一个人去承受着，",
      "token_start": 1915,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 361810,
      "end_ms": 362910,
      "text": "他也从来不出镜头，",
      "token_start": 1926,
      "token_end_exclusive": 1934
    },
    {
      "start_ms": 362910,
      "end_ms": 364130,
      "text": "就这样默默的托举着。",
      "token_start": 1934,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 364130,
      "end_ms": 365305,
      "text": "我在婚姻中，",
      "token_start": 1943,
      "token_end_exclusive": 1948
    },
    {
      "start_ms": 365530,
      "end_ms": 366850,
      "text": "当你找到了那个对的人，",
      "token_start": 1948,
      "token_end_exclusive": 1958
    },
    {
      "start_ms": 366850,
      "end_ms": 369690,
      "text": "就会发现你找到了自己后半辈子里的光。",
      "token_start": 1958,
      "token_end_exclusive": 1975
    },
    {
      "start_ms": 370030,
      "end_ms": 372745,
      "text": "现在我们夫妻俩基本上每一天都是一起出行的，",
      "token_start": 1975,
      "token_end_exclusive": 1995
    },
    {
      "start_ms": 372980,
      "end_ms": 374460,
      "text": "只要有我出现的地方，",
      "token_start": 1995,
      "token_end_exclusive": 2004
    },
    {
      "start_ms": 374460,
      "end_ms": 376345,
      "text": "五步之内必定有我老婆。",
      "token_start": 2004,
      "token_end_exclusive": 2014
    },
    {
      "start_ms": 376780,
      "end_ms": 380055,
      "text": "我和他相处的时间要比陪孩子和父母还要多。",
      "token_start": 2014,
      "token_end_exclusive": 2033
    },
    {
      "start_ms": 380330,
      "end_ms": 383215,
      "text": "我是真的觉得男人最大的靠山就是自己的妻子。",
      "token_start": 2033,
      "token_end_exclusive": 2053
    },
    {
      "start_ms": 383650,
      "end_ms": 384690,
      "text": "先护妻儿，",
      "token_start": 2053,
      "token_end_exclusive": 2057
    },
    {
      "start_ms": 384730,
      "end_ms": 385690,
      "text": "再谈孝顺，",
      "token_start": 2057,
      "token_end_exclusive": 2061
    },
    {
      "start_ms": 385710,
      "end_ms": 386570,
      "text": "这才是真爱。",
      "token_start": 2061,
      "token_end_exclusive": 2066
    },
    {
      "start_ms": 386850,
      "end_ms": 388195,
      "text": "先护好枕边人，",
      "token_start": 2066,
      "token_end_exclusive": 2072
    },
    {
      "start_ms": 388440,
      "end_ms": 389580,
      "text": "再谈孝顺父母，",
      "token_start": 2072,
      "token_end_exclusive": 2078
    },
    {
      "start_ms": 389660,
      "end_ms": 391280,
      "text": "这才是男人最大的担当。",
      "token_start": 2078,
      "token_end_exclusive": 2088
    },
    {
      "start_ms": 391540,
      "end_ms": 392145,
      "text": "我相信，",
      "token_start": 2088,
      "token_end_exclusive": 2091
    },
    {
      "start_ms": 392460,
      "end_ms": 394570,
      "text": "夫妻关系是一切关系的，",
      "token_start": 2091,
      "token_end_exclusive": 2101
    },
    {
      "start_ms": 394570,
      "end_ms": 395190,
      "text": "总核心，",
      "token_start": 2101,
      "token_end_exclusive": 2104
    },
    {
      "start_ms": 395410,
      "end_ms": 397750,
      "text": "要高于你和父母、兄弟姐妹，",
      "token_start": 2104,
      "token_end_exclusive": 2115
    },
    {
      "start_ms": 397890,
      "end_ms": 399675,
      "text": "甚至高于你和孩子的关系。",
      "token_start": 2115,
      "token_end_exclusive": 2126
    },
    {
      "start_ms": 400120,
      "end_ms": 402920,
      "text": "法律上为什么要把配偶放在亲属的第一位？",
      "token_start": 2126,
      "token_end_exclusive": 2144
    },
    {
      "start_ms": 403040,
      "end_ms": 406205,
      "text": "因为自由意志在法理上是大于血缘关系的。",
      "token_start": 2144,
      "token_end_exclusive": 2162
    },
    {
      "start_ms": 406480,
      "end_ms": 410005,
      "text": "婚姻是你这辈子唯一次能够亲自挑选家人的时候，",
      "token_start": 2162,
      "token_end_exclusive": 2183
    },
    {
      "start_ms": 410440,
      "end_ms": 412420,
      "text": "你想和什么样的人牵手相伴，",
      "token_start": 2183,
      "token_end_exclusive": 2195
    },
    {
      "start_ms": 412440,
      "end_ms": 414865,
      "text": "走完这一生就应该去找什么样的人，",
      "token_start": 2195,
      "token_end_exclusive": 2210
    },
    {
      "start_ms": 415120,
      "end_ms": 415980,
      "text": "而不是将就，",
      "token_start": 2210,
      "token_end_exclusive": 2215
    },
    {
      "start_ms": 416140,
      "end_ms": 418560,
      "text": "试试就试试人生的另一半。",
      "token_start": 2215,
      "token_end_exclusive": 2226
    },
    {
      "start_ms": 418560,
      "end_ms": 419480,
      "text": "如果选错了，",
      "token_start": 2226,
      "token_end_exclusive": 2231
    },
    {
      "start_ms": 419620,
      "end_ms": 420440,
      "text": "往后余生，",
      "token_start": 2231,
      "token_end_exclusive": 2235
    },
    {
      "start_ms": 420480,
      "end_ms": 421405,
      "text": "步步皆错。",
      "token_start": 2235,
      "token_end_exclusive": 2239
    },
    {
      "start_ms": 421890,
      "end_ms": 423890,
      "text": "现在我们在香港租了一个小房子，",
      "token_start": 2239,
      "token_end_exclusive": 2253
    },
    {
      "start_ms": 423910,
      "end_ms": 426025,
      "text": "蜗居在北京也租了一间公寓，",
      "token_start": 2253,
      "token_end_exclusive": 2265
    },
    {
      "start_ms": 426240,
      "end_ms": 428765,
      "text": "夫妻俩每个月往返于北京和香港之间。",
      "token_start": 2265,
      "token_end_exclusive": 2281
    },
    {
      "start_ms": 429140,
      "end_ms": 430705,
      "text": "我们不在任何城市下注，",
      "token_start": 2281,
      "token_end_exclusive": 2291
    },
    {
      "start_ms": 430950,
      "end_ms": 432995,
      "text": "不在任何地点抱有定居思维，",
      "token_start": 2291,
      "token_end_exclusive": 2303
    },
    {
      "start_ms": 433340,
      "end_ms": 435575,
      "text": "随时随地拥有绝对的千徙权。",
      "token_start": 2303,
      "token_end_exclusive": 2315
    },
    {
      "start_ms": 435860,
      "end_ms": 436960,
      "text": "我们夫妻在哪里？",
      "token_start": 2315,
      "token_end_exclusive": 2322
    },
    {
      "start_ms": 437040,
      "end_ms": 438045,
      "text": "家就在哪里。",
      "token_start": 2322,
      "token_end_exclusive": 2327
    },
    {
      "start_ms": 438500,
      "end_ms": 442385,
      "text": "我觉得人生当中选择你的配偶、居住地以及赚钱方式，",
      "token_start": 2327,
      "token_end_exclusive": 2349
    },
    {
      "start_ms": 442660,
      "end_ms": 445435,
      "text": "这三个决定了你生活中绝大部分内容。",
      "token_start": 2349,
      "token_end_exclusive": 2365
    },
    {
      "start_ms": 445650,
      "end_ms": 446650,
      "text": "而从去年开始，",
      "token_start": 2365,
      "token_end_exclusive": 2371
    },
    {
      "start_ms": 446650,
      "end_ms": 447870,
      "text": "我老婆就一直跟我说，",
      "token_start": 2371,
      "token_end_exclusive": 2380
    },
    {
      "start_ms": 447990,
      "end_ms": 450035,
      "text": "要赶紧学习AI人工智能。",
      "token_start": 2380,
      "token_end_exclusive": 2390
    },
    {
      "start_ms": 450350,
      "end_ms": 452905,
      "text": "而我当时其实对于这种新技术没有什么概念，",
      "token_start": 2390,
      "token_end_exclusive": 2409
    },
    {
      "start_ms": 453150,
      "end_ms": 457660,
      "text": "但是他直接邀请了AI方面的老师给我和所有的员工一起去做培训，",
      "token_start": 2409,
      "token_end_exclusive": 2437
    },
    {
      "start_ms": 457780,
      "end_ms": 459835,
      "text": "说我们千万不能沉醉于过去，",
      "token_start": 2437,
      "token_end_exclusive": 2449
    },
    {
      "start_ms": 460110,
      "end_ms": 461795,
      "text": "要不断的去学习进步。",
      "token_start": 2449,
      "token_end_exclusive": 2458
    },
    {
      "start_ms": 462100,
      "end_ms": 466285,
      "text": "而他还直接给我报了哥伦比亚大学和斯坦福大学的AI新媒体课程，",
      "token_start": 2458,
      "token_end_exclusive": 2486
    },
    {
      "start_ms": 466590,
      "end_ms": 467475,
      "text": "怕我一个人学不了，",
      "token_start": 2486,
      "token_end_exclusive": 2494
    },
    {
      "start_ms": 467740,
      "end_ms": 468965,
      "text": "他也报名了课程，",
      "token_start": 2494,
      "token_end_exclusive": 2501
    },
    {
      "start_ms": 469390,
      "end_ms": 471565,
      "text": "让我们两个人一起来美国上课学习。",
      "token_start": 2501,
      "token_end_exclusive": 2516
    },
    {
      "start_ms": 472040,
      "end_ms": 476850,
      "text": "所以这几天我们就利用长假一起飞到美国来到哥伦比亚大学上课，",
      "token_start": 2516,
      "token_end_exclusive": 2544
    },
    {
      "start_ms": 477150,
      "end_ms": 479835,
      "text": "我们夫妻俩又在校园里成为同学。",
      "token_start": 2544,
      "token_end_exclusive": 2558
    },
    {
      "start_ms": 480600,
      "end_ms": 483880,
      "text": "如果你和伴侣能够一直一起学习新东西，",
      "token_start": 2558,
      "token_end_exclusive": 2575
    },
    {
      "start_ms": 484000,
      "end_ms": 485775,
      "text": "一起研究社会的新变化。",
      "token_start": 2575,
      "token_end_exclusive": 2585
    },
    {
      "start_ms": 486020,
      "end_ms": 487620,
      "text": "我相信这种智力上的共鸣，",
      "token_start": 2585,
      "token_end_exclusive": 2596
    },
    {
      "start_ms": 487620,
      "end_ms": 490165,
      "text": "会让你们的关系一直处于保鲜期，",
      "token_start": 2596,
      "token_end_exclusive": 2610
    },
    {
      "start_ms": 490460,
      "end_ms": 492935,
      "text": "而且结婚之后一定要共同进步。",
      "token_start": 2610,
      "token_end_exclusive": 2623
    },
    {
      "start_ms": 493200,
      "end_ms": 495460,
      "text": "夫妻双方都要看到彼此的进步，",
      "token_start": 2623,
      "token_end_exclusive": 2636
    },
    {
      "start_ms": 495540,
      "end_ms": 497255,
      "text": "你们的关系才会更好，",
      "token_start": 2636,
      "token_end_exclusive": 2645
    },
    {
      "start_ms": 497940,
      "end_ms": 498560,
      "text": "你知道吗？",
      "token_start": 2645,
      "token_end_exclusive": 2649
    },
    {
      "start_ms": 498740,
      "end_ms": 501460,
      "text": "其实现在女性要承受的风险，",
      "token_start": 2649,
      "token_end_exclusive": 2661
    },
    {
      "start_ms": 501640,
      "end_ms": 503205,
      "text": "代价要比男人更大。",
      "token_start": 2661,
      "token_end_exclusive": 2669
    },
    {
      "start_ms": 503760,
      "end_ms": 505100,
      "text": "所以当一个女人对你说，",
      "token_start": 2669,
      "token_end_exclusive": 2679
    },
    {
      "start_ms": 505260,
      "end_ms": 507700,
      "text": "我在你身上看不到任何希望的时候，",
      "token_start": 2679,
      "token_end_exclusive": 2694
    },
    {
      "start_ms": 507820,
      "end_ms": 510525,
      "text": "请不要轻易的给她贴上一个物质的标签。",
      "token_start": 2694,
      "token_end_exclusive": 2711
    },
    {
      "start_ms": 510860,
      "end_ms": 512185,
      "text": "这其实不是他的问题，",
      "token_start": 2711,
      "token_end_exclusive": 2720
    },
    {
      "start_ms": 512390,
      "end_ms": 513985,
      "text": "而是社会化共识的问题。",
      "token_start": 2720,
      "token_end_exclusive": 2730
    },
    {
      "start_ms": 514350,
      "end_ms": 516330,
      "text": "不要总想着怎么选那个对的人，",
      "token_start": 2730,
      "token_end_exclusive": 2743
    },
    {
      "start_ms": 516470,
      "end_ms": 519215,
      "text": "而要想着让自己做那个对的人。",
      "token_start": 2743,
      "token_end_exclusive": 2756
    },
    {
      "start_ms": 519590,
      "end_ms": 522025,
      "text": "其实对于大部分女人男人不重要，",
      "token_start": 2756,
      "token_end_exclusive": 2770
    },
    {
      "start_ms": 522270,
      "end_ms": 523185,
      "text": "婚姻很重要，",
      "token_start": 2770,
      "token_end_exclusive": 2775
    },
    {
      "start_ms": 523460,
      "end_ms": 525435,
      "text": "但是对男人婚姻不重要，",
      "token_start": 2775,
      "token_end_exclusive": 2785
    },
    {
      "start_ms": 525690,
      "end_ms": 526665,
      "text": "女人很重要。",
      "token_start": 2785,
      "token_end_exclusive": 2790
    },
    {
      "start_ms": 527010,
      "end_ms": 528815,
      "text": "所以现在婚姻制度的真相是，",
      "token_start": 2790,
      "token_end_exclusive": 2802
    },
    {
      "start_ms": 529090,
      "end_ms": 530030,
      "text": "女人为了婚姻，",
      "token_start": 2802,
      "token_end_exclusive": 2808
    },
    {
      "start_ms": 530030,
      "end_ms": 531495,
      "text": "而不得不选择一个男人。",
      "token_start": 2808,
      "token_end_exclusive": 2818
    },
    {
      "start_ms": 531810,
      "end_ms": 533790,
      "text": "而男人则因为需要这个女人，",
      "token_start": 2818,
      "token_end_exclusive": 2830
    },
    {
      "start_ms": 533870,
      "end_ms": 535265,
      "text": "则不得不接受婚姻。",
      "token_start": 2830,
      "token_end_exclusive": 2838
    },
    {
      "start_ms": 535680,
      "end_ms": 536420,
      "text": "很多人感慨，",
      "token_start": 2838,
      "token_end_exclusive": 2843
    },
    {
      "start_ms": 536420,
      "end_ms": 537860,
      "text": "年轻的时候不知道结婚，",
      "token_start": 2843,
      "token_end_exclusive": 2853
    },
    {
      "start_ms": 537860,
      "end_ms": 539895,
      "text": "内益知道了已经不年轻了。",
      "token_start": 2853,
      "token_end_exclusive": 2864
    },
    {
      "start_ms": 540200,
      "end_ms": 541300,
      "text": "结婚可不是男的，",
      "token_start": 2864,
      "token_end_exclusive": 2871
    },
    {
      "start_ms": 541300,
      "end_ms": 541940,
      "text": "找保姆，",
      "token_start": 2871,
      "token_end_exclusive": 2874
    },
    {
      "start_ms": 542020,
      "end_ms": 543205,
      "text": "女的找摇钱树，",
      "token_start": 2874,
      "token_end_exclusive": 2880
    },
    {
      "start_ms": 543540,
      "end_ms": 544755,
      "text": "你什么都可以努力，",
      "token_start": 2880,
      "token_end_exclusive": 2888
    },
    {
      "start_ms": 545100,
      "end_ms": 548285,
      "text": "只有有情有义的爱人需要你一点运气。",
      "token_start": 2888,
      "token_end_exclusive": 2904
    },
    {
      "start_ms": 548750,
      "end_ms": 551245,
      "text": "男人一生最大的财富就是选对妻子。",
      "token_start": 2904,
      "token_end_exclusive": 2919
    },
    {
      "start_ms": 551720,
      "end_ms": 553385,
      "text": "爱妻者风生水起，",
      "token_start": 2919,
      "token_end_exclusive": 2926
    },
    {
      "start_ms": 553680,
      "end_ms": 554420,
      "text": "亏七者，",
      "token_start": 2926,
      "token_end_exclusive": 2929
    },
    {
      "start_ms": 554600,
      "end_ms": 555425,
      "text": "百财不入。",
      "token_start": 2929,
      "token_end_exclusive": 2933
    },
    {
      "start_ms": 555630,
      "end_ms": 556790,
      "text": "有一个贤惠的妻子，",
      "token_start": 2933,
      "token_end_exclusive": 2941
    },
    {
      "start_ms": 556790,
      "end_ms": 558065,
      "text": "就算你穷困潦倒，",
      "token_start": 2941,
      "token_end_exclusive": 2948
    },
    {
      "start_ms": 558280,
      "end_ms": 559965,
      "text": "他也能陪你东山再起，",
      "token_start": 2948,
      "token_end_exclusive": 2957
    },
    {
      "start_ms": 560490,
      "end_ms": 562430,
      "text": "其实身材呀漂亮等等，",
      "token_start": 2957,
      "token_end_exclusive": 2966
    },
    {
      "start_ms": 562430,
      "end_ms": 563555,
      "text": "这些都不重要。",
      "token_start": 2966,
      "token_end_exclusive": 2972
    },
    {
      "start_ms": 563860,
      "end_ms": 565215,
      "text": "最重要的是一个人的人品。",
      "token_start": 2972,
      "token_end_exclusive": 2983
    },
    {
      "start_ms": 565500,
      "end_ms": 568815,
      "text": "我们归根结底还是要跟这个人的人品去过一辈子。",
      "token_start": 2983,
      "token_end_exclusive": 3004
    },
    {
      "start_ms": 569180,
      "end_ms": 569760,
      "text": "老话说，",
      "token_start": 3004,
      "token_end_exclusive": 3007
    },
    {
      "start_ms": 570080,
      "end_ms": 571545,
      "text": "纵有家财万贯，",
      "token_start": 3007,
      "token_end_exclusive": 3013
    },
    {
      "start_ms": 571850,
      "end_ms": 572670,
      "text": "不如贤妻，",
      "token_start": 3013,
      "token_end_exclusive": 3017
    },
    {
      "start_ms": 572690,
      "end_ms": 577285,
      "text": "相伴家有贤妻旺三代胜过良田千万顷。",
      "token_start": 3017,
      "token_end_exclusive": 3033
    }
  ],
