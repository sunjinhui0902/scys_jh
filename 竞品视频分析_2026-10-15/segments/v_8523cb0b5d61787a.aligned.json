{
  "video_id": "v_8523cb0b5d61787a",
  "duration_s": 618.666667,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_8523cb0b5d61787a.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_8523cb0b5d61787a.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1530,
      "text": "三十四岁殉国，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1890,
      "end_ms": 3090,
      "text": "身首异处，",
      "token_start": 6,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3150,
      "end_ms": 6090,
      "text": "六十二年一人牵制十万。",
      "token_start": 10,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 6110,
      "end_ms": 10450,
      "text": "日军致敬被低估的抗联第一硬汉。",
      "token_start": 20,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 10630,
      "end_ms": 11350,
      "text": "赵尚志，",
      "token_start": 34,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 12370,
      "end_ms": 14810,
      "text": "你见过最委屈的民族英雄吗？",
      "token_start": 37,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 15230,
      "end_ms": 16010,
      "text": "战场上，",
      "token_start": 49,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 16450,
      "end_ms": 18410,
      "text": "他是让日军瑟瑟发抖，",
      "token_start": 52,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 19010,
      "end_ms": 23850,
      "text": "悬赏一两骨头一两斤的东北骨头。",
      "token_start": 61,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 24590,
      "end_ms": 25350,
      "text": "对敌时，",
      "token_start": 75,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 26050,
      "end_ms": 27570,
      "text": "他铁血刚烈，",
      "token_start": 78,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 28290,
      "end_ms": 29635,
      "text": "百战不败，",
      "token_start": 83,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 30260,
      "end_ms": 31900,
      "text": "撑起整个北满。",
      "token_start": 87,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 31960,
      "end_ms": 35020,
      "text": "抗日江山可在自己人的阵营里，",
      "token_start": 93,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 35200,
      "end_ms": 37280,
      "text": "他却两次被开除党籍，",
      "token_start": 106,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 37640,
      "end_ms": 38900,
      "text": "常年被误解，",
      "token_start": 115,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 39120,
      "end_ms": 40580,
      "text": "被质疑被否定。",
      "token_start": 120,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 41020,
      "end_ms": 43460,
      "text": "一生为国浴血半生，",
      "token_start": 126,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 43640,
      "end_ms": 44700,
      "text": "背负冤屈，",
      "token_start": 134,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 45380,
      "end_ms": 46340,
      "text": "世人皆知，",
      "token_start": 138,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 46340,
      "end_ms": 47940,
      "text": "杨靖宇壮烈殉国，",
      "token_start": 142,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 48420,
      "end_ms": 50280,
      "text": "却极少有人独懂。",
      "token_start": 149,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 51300,
      "end_ms": 59020,
      "text": "赵尚志才是抗战史上最孤独、最隐忍、最让人心疼的孤勇英雄。",
      "token_start": 156,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 59680,
      "end_ms": 60345,
      "text": "今天，",
      "token_start": 181,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 60690,
      "end_ms": 63535,
      "text": "我们抛开所有细说与杜撰，",
      "token_start": 183,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 63980,
      "end_ms": 72395,
      "text": "用权威政史还原这位受尽委屈依旧赤诚报国的铁血将军。",
      "token_start": 194,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 73060,
      "end_ms": 74360,
      "text": "在中国十四年，",
      "token_start": 218,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 74440,
      "end_ms": 75815,
      "text": "艰苦抗战史上，",
      "token_start": 224,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 76260,
      "end_ms": 80315,
      "text": "有一句让无数国人热血沸腾，",
      "token_start": 230,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 80990,
      "end_ms": 83430,
      "text": "让日军终身忌惮的评价。",
      "token_start": 242,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 83590,
      "end_ms": 84910,
      "text": "小小的满洲国，",
      "token_start": 252,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 85170,
      "end_ms": 86565,
      "text": "大大的赵尚志。",
      "token_start": 258,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 87080,
      "end_ms": 88765,
      "text": "在侵略者眼中，",
      "token_start": 264,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 89280,
      "end_ms": 92605,
      "text": "整个伪满洲国都比不上一个赵尚志。",
      "token_start": 270,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 93470,
      "end_ms": 97174,
      "text": "日军为了除掉他开除天价悬赏，",
      "token_start": 285,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 97660,
      "end_ms": 99295,
      "text": "动用数万兵力，",
      "token_start": 298,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 99590,
      "end_ms": 102310,
      "text": "常年围剿部下天罗地网，",
      "token_start": 304,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 102490,
      "end_ms": 104155,
      "text": "派遣无数特务卧底。",
      "token_start": 314,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 105150,
      "end_ms": 106125,
      "text": "在敌人眼里，",
      "token_start": 322,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 106350,
      "end_ms": 107895,
      "text": "他是最可怕的噩梦。",
      "token_start": 327,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 108850,
      "end_ms": 110715,
      "text": "可在很长一段时间里，",
      "token_start": 335,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 111150,
      "end_ms": 112625,
      "text": "在自己人的队伍里，",
      "token_start": 344,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 113140,
      "end_ms": 118085,
      "text": "他确实争议最大、误会最深、最不被理解的人。",
      "token_start": 352,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 118600,
      "end_ms": 119715,
      "text": "一九零八年，",
      "token_start": 370,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 120120,
      "end_ms": 122820,
      "text": "赵尚志生于辽宁朝阳，",
      "token_start": 375,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 123020,
      "end_ms": 124440,
      "text": "自幼饱读诗书，",
      "token_start": 384,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 124800,
      "end_ms": 126000,
      "text": "秉性刚烈，",
      "token_start": 390,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 126400,
      "end_ms": 127500,
      "text": "心怀家国。",
      "token_start": 394,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 128099,
      "end_ms": 130720,
      "text": "十七岁正值青春年少，",
      "token_start": 398,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 131100,
      "end_ms": 132700,
      "text": "他毅然投身革命，",
      "token_start": 407,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 133060,
      "end_ms": 135620,
      "text": "成为东北最早一批共产党员。",
      "token_start": 414,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 136380,
      "end_ms": 137420,
      "text": "年少的他，",
      "token_start": 426,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 137660,
      "end_ms": 138740,
      "text": "一腔热狱，",
      "token_start": 430,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 139240,
      "end_ms": 140420,
      "text": "敢闯敢拼，",
      "token_start": 434,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 140800,
      "end_ms": 142100,
      "text": "为救国奔走，",
      "token_start": 438,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 142140,
      "end_ms": 144720,
      "text": "街头数次被捕入狱，",
      "token_start": 443,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 145420,
      "end_ms": 147120,
      "text": "军阀的牢狱没有磨灭。",
      "token_start": 451,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 147120,
      "end_ms": 149785,
      "text": "他的骨气反而让他更加坚定，",
      "token_start": 460,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 150410,
      "end_ms": 151750,
      "text": "唯有救亡图存，",
      "token_start": 472,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 152110,
      "end_ms": 153430,
      "text": "方能不负华夏。",
      "token_start": 478,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 153970,
      "end_ms": 155110,
      "text": "一九三一年，",
      "token_start": 484,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 155350,
      "end_ms": 156850,
      "text": "九一八事变爆发，",
      "token_start": 489,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 157210,
      "end_ms": 158170,
      "text": "东北千里，",
      "token_start": 496,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 158170,
      "end_ms": 158570,
      "text": "沃土，",
      "token_start": 500,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 158750,
      "end_ms": 159650,
      "text": "一夜沦陷，",
      "token_start": 502,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 160110,
      "end_ms": 162710,
      "text": "数十万东北军撤退官员南迁，",
      "token_start": 506,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 163050,
      "end_ms": 163970,
      "text": "富豪必祸。",
      "token_start": 518,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 164410,
      "end_ms": 167670,
      "text": "整个黑土地彻底陷入黑暗与绝望，",
      "token_start": 522,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 168330,
      "end_ms": 170250,
      "text": "所有人都在拼命逃离。",
      "token_start": 536,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 170270,
      "end_ms": 172210,
      "text": "东北唯独赵尚志，",
      "token_start": 545,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 172550,
      "end_ms": 173650,
      "text": "逆向而行，",
      "token_start": 552,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 174030,
      "end_ms": 177250,
      "text": "无兵、无枪、无粮、无饷，",
      "token_start": 556,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 177650,
      "end_ms": 178390,
      "text": "无支援，",
      "token_start": 564,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 178750,
      "end_ms": 179585,
      "text": "无靠山。",
      "token_start": 567,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 180120,
      "end_ms": 181280,
      "text": "他白手起家，",
      "token_start": 570,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 181620,
      "end_ms": 183020,
      "text": "深入深山密林，",
      "token_start": 575,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 183320,
      "end_ms": 185600,
      "text": "挨村动员奔走四方，",
      "token_start": 581,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 186200,
      "end_ms": 190440,
      "text": "硬生生从一片废墟里拉起一支抗日队伍。",
      "token_start": 589,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 192080,
      "end_ms": 193200,
      "text": "一九三三年，",
      "token_start": 606,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 193680,
      "end_ms": 197560,
      "text": "诸和反日游击队成立仅有十三人。",
      "token_start": 611,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 198040,
      "end_ms": 202520,
      "text": "九条破枪就是这样一支微不足道的小队，",
      "token_start": 625,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 202600,
      "end_ms": 206840,
      "text": "在赵尚志的铁血带领下创下无数奇迹。",
      "token_start": 642,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 207580,
      "end_ms": 208740,
      "text": "他治军急，",
      "token_start": 658,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 208760,
      "end_ms": 210710,
      "text": "严定了下铁律，",
      "token_start": 662,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 211410,
      "end_ms": 212090,
      "text": "不扰民，",
      "token_start": 668,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 212430,
      "end_ms": 216390,
      "text": "不劫掠不欺民别人的杂牌队伍，",
      "token_start": 671,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 216390,
      "end_ms": 218370,
      "text": "霍乱相里他的队伍，",
      "token_start": 684,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 218370,
      "end_ms": 219150,
      "text": "护佑百姓，",
      "token_start": 692,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 219670,
      "end_ms": 221370,
      "text": "别人为敌必战。",
      "token_start": 696,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 221730,
      "end_ms": 222930,
      "text": "他主动出击，",
      "token_start": 702,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 223210,
      "end_ms": 224490,
      "text": "逢敌必亮剑。",
      "token_start": 707,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 224990,
      "end_ms": 225930,
      "text": "短短数年，",
      "token_start": 712,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 226270,
      "end_ms": 229230,
      "text": "队伍从十几人发展到数千人，",
      "token_start": 716,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 229530,
      "end_ms": 229890,
      "text": "扩编，",
      "token_start": 728,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 229890,
      "end_ms": 233335,
      "text": "为东北抗联第三军威震北满。",
      "token_start": 730,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 235300,
      "end_ms": 236320,
      "text": "一九三七年，",
      "token_start": 742,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 236360,
      "end_ms": 241355,
      "text": "冰烫子大捷成为抗联最经典的伏击战。",
      "token_start": 747,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 242460,
      "end_ms": 246810,
      "text": "赵尚志利用冰雪山谷地形以少胜多，",
      "token_start": 763,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 247050,
      "end_ms": 248165,
      "text": "重创日军，",
      "token_start": 778,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 248540,
      "end_ms": 250265,
      "text": "打出了中国人的骨气，",
      "token_start": 782,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 250750,
      "end_ms": 254135,
      "text": "彻底震慑了盘踞东北的日寇。",
      "token_start": 791,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 254650,
      "end_ms": 255935,
      "text": "可谁也想不到，",
      "token_start": 803,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 256440,
      "end_ms": 262845,
      "text": "战场百战百胜的英雄却败给了乱世的误会与猜忌。",
      "token_start": 809,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 263350,
      "end_ms": 265535,
      "text": "东北抗联常年深山作战，",
      "token_start": 830,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 266040,
      "end_ms": 267125,
      "text": "隔绝闭塞，",
      "token_start": 840,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 267440,
      "end_ms": 268595,
      "text": "通讯断绝，",
      "token_start": 844,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 269050,
      "end_ms": 270105,
      "text": "山川阻隔，",
      "token_start": 848,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 270430,
      "end_ms": 271230,
      "text": "消息滞后，",
      "token_start": 852,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 271390,
      "end_ms": 272325,
      "text": "局势复杂，",
      "token_start": 856,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 272670,
      "end_ms": 273470,
      "text": "队伍打散，",
      "token_start": 860,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 273550,
      "end_ms": 274565,
      "text": "重组频繁。",
      "token_start": 864,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 274970,
      "end_ms": 276395,
      "text": "赵尚之性格刚直，",
      "token_start": 868,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 276670,
      "end_ms": 277575,
      "text": "做事果决，",
      "token_start": 875,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 278080,
      "end_ms": 279065,
      "text": "用兵激进，",
      "token_start": 879,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 279390,
      "end_ms": 280930,
      "text": "坚持主动出击，",
      "token_start": 883,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 281150,
      "end_ms": 282075,
      "text": "以战止战。",
      "token_start": 889,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 283060,
      "end_ms": 285000,
      "text": "但在艰苦的相持阶段，",
      "token_start": 893,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 285040,
      "end_ms": 287705,
      "text": "部分同志主张保存实力，",
      "token_start": 902,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 288540,
      "end_ms": 290990,
      "text": "谨慎避战路线，",
      "token_start": 912,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 291070,
      "end_ms": 294070,
      "text": "分歧、管理摩擦、信息偏差，",
      "token_start": 918,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 294310,
      "end_ms": 295455,
      "text": "层层叠加，",
      "token_start": 928,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 295990,
      "end_ms": 297865,
      "text": "最终酿成巨大冤案。",
      "token_start": 932,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 299660,
      "end_ms": 300700,
      "text": "一九三六年，",
      "token_start": 940,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 300980,
      "end_ms": 303440,
      "text": "他第一次被错误开除党籍，",
      "token_start": 945,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 304000,
      "end_ms": 310240,
      "text": "这份处分对一名视信仰如生命的革命者是毁灭性打击。",
      "token_start": 956,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 310740,
      "end_ms": 311800,
      "text": "他没有哭闹，",
      "token_start": 979,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 312140,
      "end_ms": 313060,
      "text": "没有辩解，",
      "token_start": 984,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 313320,
      "end_ms": 314200,
      "text": "没有退党，",
      "token_start": 988,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 314440,
      "end_ms": 315280,
      "text": "没有消沉，",
      "token_start": 992,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 315660,
      "end_ms": 318620,
      "text": "只留下一句震彻山河的赤骋。",
      "token_start": 996,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 319220,
      "end_ms": 319760,
      "text": "抗日，",
      "token_start": 1008,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 319980,
      "end_ms": 320960,
      "text": "不分党籍，",
      "token_start": 1010,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 321560,
      "end_ms": 322160,
      "text": "救国，",
      "token_start": 1014,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 322400,
      "end_ms": 323360,
      "text": "不问名分，",
      "token_start": 1016,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 323920,
      "end_ms": 325160,
      "text": "只要能打鬼子，",
      "token_start": 1020,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 325440,
      "end_ms": 326660,
      "text": "我无怨无悔。",
      "token_start": 1026,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 326760,
      "end_ms": 329870,
      "text": "他继续带队血战白山黑水，",
      "token_start": 1031,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 330570,
      "end_ms": 333750,
      "text": "可命运的苛责远未停止。",
      "token_start": 1042,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 334750,
      "end_ms": 337110,
      "text": "一九三八年北满，",
      "token_start": 1052,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 337130,
      "end_ms": 338470,
      "text": "抗联西征惨败，",
      "token_start": 1059,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 339130,
      "end_ms": 340510,
      "text": "队伍损失惨重，",
      "token_start": 1065,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 341450,
      "end_ms": 342250,
      "text": "为求援，",
      "token_start": 1071,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 343210,
      "end_ms": 347090,
      "text": "为申诉冤屈赵尚志远赴苏联，",
      "token_start": 1074,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 347510,
      "end_ms": 349430,
      "text": "因战乱信息错位，",
      "token_start": 1086,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 349790,
      "end_ms": 350210,
      "text": "误会。",
      "token_start": 1093,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 350330,
      "end_ms": 353670,
      "text": "再次加深他第二次被开除党籍，",
      "token_start": 1095,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 354170,
      "end_ms": 355290,
      "text": "两次除名。",
      "token_start": 1108,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 355550,
      "end_ms": 357510,
      "text": "半生蒙冤有功，",
      "token_start": 1112,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 357530,
      "end_ms": 362795,
      "text": "不赏事诚被遗浴血被冤换做任何人，",
      "token_start": 1118,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 363670,
      "end_ms": 364975,
      "text": "早已心寒，",
      "token_start": 1133,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 365720,
      "end_ms": 366815,
      "text": "早已放弃，",
      "token_start": 1137,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 367660,
      "end_ms": 369295,
      "text": "早已远走高飞。",
      "token_start": 1141,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 370340,
      "end_ms": 373085,
      "text": "但赵尚志没有世人误解我，",
      "token_start": 1147,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 373330,
      "end_ms": 375530,
      "text": "我不愿组织委屈我，",
      "token_start": 1158,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 375630,
      "end_ms": 377300,
      "text": "我不退山河。",
      "token_start": 1166,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 377400,
      "end_ms": 378365,
      "text": "待我伯梁，",
      "token_start": 1171,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 378720,
      "end_ms": 379400,
      "text": "我庇护，",
      "token_start": 1175,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 379500,
      "end_ms": 380375,
      "text": "山河无恙，",
      "token_start": 1178,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 380860,
      "end_ms": 382200,
      "text": "无职无名，",
      "token_start": 1182,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 382620,
      "end_ms": 384435,
      "text": "无身份无认可。",
      "token_start": 1186,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 385370,
      "end_ms": 386705,
      "text": "他滞留苏联三年，",
      "token_start": 1192,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 387320,
      "end_ms": 392085,
      "text": "日日钻研敌情训练战士等待归国机会。",
      "token_start": 1199,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 392750,
      "end_ms": 395425,
      "text": "所有人劝他局势凶险，",
      "token_start": 1215,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 395900,
      "end_ms": 397220,
      "text": "你已受尽委屈，",
      "token_start": 1224,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 397560,
      "end_ms": 399095,
      "text": "何必再回去送死。",
      "token_start": 1230,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 399460,
      "end_ms": 401390,
      "text": "他自制铿锵东北，",
      "token_start": 1237,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 401470,
      "end_ms": 402765,
      "text": "百姓还在受难，",
      "token_start": 1244,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 403430,
      "end_ms": 403670,
      "text": "我，",
      "token_start": 1250,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 403670,
      "end_ms": 404385,
      "text": "赵尚志，",
      "token_start": 1251,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 404690,
      "end_ms": 405415,
      "text": "绝不独安。",
      "token_start": 1254,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 406570,
      "end_ms": 407555,
      "text": "一九四一年，",
      "token_start": 1258,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 408400,
      "end_ms": 410215,
      "text": "他终于争取机会，",
      "token_start": 1263,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 411040,
      "end_ms": 416105,
      "text": "带着少数战士再度闯入虎狼遍地的东北敌战区，",
      "token_start": 1270,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 416630,
      "end_ms": 419865,
      "text": "此时的东北早已人间炼狱。",
      "token_start": 1290,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 420480,
      "end_ms": 424225,
      "text": "日军集团部落政策推行多年，",
      "token_start": 1301,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 424550,
      "end_ms": 427375,
      "text": "山林无人百姓被管控，",
      "token_start": 1313,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 427790,
      "end_ms": 430185,
      "text": "无良无缘无依无靠，",
      "token_start": 1322,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 431060,
      "end_ms": 431560,
      "text": "抗廉，",
      "token_start": 1330,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 431720,
      "end_ms": 432995,
      "text": "彻底陷入绝境。",
      "token_start": 1332,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 433450,
      "end_ms": 437040,
      "text": "一九四二年二月十二日腊月末年，",
      "token_start": 1338,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 437040,
      "end_ms": 437805,
      "text": "关将至，",
      "token_start": 1352,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 438540,
      "end_ms": 440115,
      "text": "所有人都盼团圆，",
      "token_start": 1355,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 440510,
      "end_ms": 449830,
      "text": "赵尚志却在雪原密林孤军坚守他千防万防日军千军万马却没能防住背后的汉奸。",
      "token_start": 1362,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 449910,
      "end_ms": 453510,
      "text": "卧底特务刘德山假意投诚，",
      "token_start": 1396,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 453710,
      "end_ms": 456315,
      "text": "伪装爱国骗取信任。",
      "token_start": 1407,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 456840,
      "end_ms": 460595,
      "text": "行军途中背后冷枪骤然响起，",
      "token_start": 1415,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 461110,
      "end_ms": 461870,
      "text": "子弹穿透，",
      "token_start": 1427,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 461870,
      "end_ms": 462355,
      "text": "后腰，",
      "token_start": 1431,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 462630,
      "end_ms": 463525,
      "text": "贯穿腹腔，",
      "token_start": 1433,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 463850,
      "end_ms": 465275,
      "text": "造成致命重伤，",
      "token_start": 1437,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 465970,
      "end_ms": 469745,
      "text": "生死一瞬铁骨依旧剧痛缠身。",
      "token_start": 1443,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 470430,
      "end_ms": 472025,
      "text": "他依旧反手两枪，",
      "token_start": 1455,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 472380,
      "end_ms": 473835,
      "text": "当场击毙叛徒。",
      "token_start": 1462,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 474230,
      "end_ms": 476655,
      "text": "为保全占有保全情报。",
      "token_start": 1468,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 477190,
      "end_ms": 479415,
      "text": "他强行命令所有人突围，",
      "token_start": 1477,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 479760,
      "end_ms": 480995,
      "text": "自己独自断后，",
      "token_start": 1487,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 481390,
      "end_ms": 482985,
      "text": "最终重伤被俘。",
      "token_start": 1493,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 484780,
      "end_ms": 486005,
      "text": "正是真实记载，",
      "token_start": 1499,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 486450,
      "end_ms": 489535,
      "text": "赵尚志腹腔重伤大出血，",
      "token_start": 1505,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 490170,
      "end_ms": 491685,
      "text": "生命急速衰竭，",
      "token_start": 1515,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 492060,
      "end_ms": 494955,
      "text": "并未网传数小时酷刑。",
      "token_start": 1521,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 495210,
      "end_ms": 497705,
      "text": "但他在仅存的清醒时间里，",
      "token_start": 1530,
      "token_end_exclusive": 1541
    },
    {
      "start_ms": 498080,
      "end_ms": 499615,
      "text": "依旧傲骨铮铮，",
      "token_start": 1541,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 500000,
      "end_ms": 501245,
      "text": "怒斥汉江伪军。",
      "token_start": 1547,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 501800,
      "end_ms": 503035,
      "text": "你们身为中国人，",
      "token_start": 1553,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 503370,
      "end_ms": 507395,
      "text": "替日寇为恶良心和安我虽死，",
      "token_start": 1560,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 507840,
      "end_ms": 510355,
      "text": "中国抗日火种永不灭。",
      "token_start": 1572,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 511010,
      "end_ms": 511970,
      "text": "一九四二年，",
      "token_start": 1581,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 511970,
      "end_ms": 512795,
      "text": "三十四岁，",
      "token_start": 1586,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 513410,
      "end_ms": 515835,
      "text": "一代战神壮烈殉国，",
      "token_start": 1590,
      "token_end_exclusive": 1598
    },
    {
      "start_ms": 516310,
      "end_ms": 523175,
      "text": "日军残忍割下头颅妖功遗体泣于雪地英雄身首异处。",
      "token_start": 1598,
      "token_end_exclusive": 1620
    },
    {
      "start_ms": 523770,
      "end_ms": 527495,
      "text": "他这一生最动人的从不是胜仗，",
      "token_start": 1620,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 528030,
      "end_ms": 531185,
      "text": "而是极致的赤诚与隐忍。",
      "token_start": 1633,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 531970,
      "end_ms": 535835,
      "text": "顺境是他冲锋陷阵、为国争光。",
      "token_start": 1643,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 536360,
      "end_ms": 537140,
      "text": "逆境时，",
      "token_start": 1655,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 537340,
      "end_ms": 538080,
      "text": "他背负，",
      "token_start": 1658,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 538140,
      "end_ms": 538655,
      "text": "误解，",
      "token_start": 1661,
      "token_end_exclusive": 1663
    },
    {
      "start_ms": 539080,
      "end_ms": 540165,
      "text": "忍辱负重。",
      "token_start": 1663,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 540810,
      "end_ms": 541695,
      "text": "绝境时，",
      "token_start": 1667,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 542130,
      "end_ms": 543425,
      "text": "他以身殉国，",
      "token_start": 1670,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 543870,
      "end_ms": 544735,
      "text": "无怨无悔，",
      "token_start": 1675,
      "token_end_exclusive": 1679
    },
    {
      "start_ms": 545100,
      "end_ms": 546205,
      "text": "他可以被误会，",
      "token_start": 1679,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 546670,
      "end_ms": 548845,
      "text": "但从未背叛信仰。",
      "token_start": 1685,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 549220,
      "end_ms": 550335,
      "text": "他可以被亏欠，",
      "token_start": 1692,
      "token_end_exclusive": 1698
    },
    {
      "start_ms": 550800,
      "end_ms": 552340,
      "text": "但从未亏欠。",
      "token_start": 1698,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 552360,
      "end_ms": 554265,
      "text": "祖国四十年后，",
      "token_start": 1703,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 554610,
      "end_ms": 556485,
      "text": "历史终于还他清白。",
      "token_start": 1709,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 556970,
      "end_ms": 558295,
      "text": "六十二年之后，",
      "token_start": 1717,
      "token_end_exclusive": 1723
    },
    {
      "start_ms": 558630,
      "end_ms": 560670,
      "text": "英雄终于身手合一，",
      "token_start": 1723,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 561030,
      "end_ms": 562145,
      "text": "魂归故土，",
      "token_start": 1731,
      "token_end_exclusive": 1735
    },
    {
      "start_ms": 562460,
      "end_ms": 563425,
      "text": "山河无恙，",
      "token_start": 1735,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 563840,
      "end_ms": 564755,
      "text": "岁月安宁。",
      "token_start": 1739,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 565710,
      "end_ms": 567345,
      "text": "今天的万家灯火，",
      "token_start": 1743,
      "token_end_exclusive": 1750
    },
    {
      "start_ms": 567690,
      "end_ms": 568575,
      "text": "盛世太平，",
      "token_start": 1750,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 569220,
      "end_ms": 574005,
      "text": "正是这位受尽委屈却一身滚烫的英雄，",
      "token_start": 1754,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 574490,
      "end_ms": 577620,
      "text": "用血泪换来的英雄。",
      "token_start": 1770,
      "token_end_exclusive": 1778
    },
    {
      "start_ms": 577740,
      "end_ms": 579380,
      "text": "从不是完美的神话，",
      "token_start": 1778,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 579480,
      "end_ms": 582915,
      "text": "而是在至暗时刻明知前路艰难，",
      "token_start": 1786,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 583270,
      "end_ms": 585655,
      "text": "依然选择逆行的普通人。",
      "token_start": 1799,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 586330,
      "end_ms": 589155,
      "text": "赵尚志留给这片土地的火种，",
      "token_start": 1809,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 589520,
      "end_ms": 590665,
      "text": "跨越百年，",
      "token_start": 1821,
      "token_end_exclusive": 1825
    },
    {
      "start_ms": 591030,
      "end_ms": 592065,
      "text": "依旧滚烫。",
      "token_start": 1825,
      "token_end_exclusive": 1829
    },
    {
      "start_ms": 594170,
      "end_ms": 596140,
      "text": "英雄无名山河，",
      "token_start": 1829,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 596140,
      "end_ms": 596665,
      "text": "名记，",
      "token_start": 1835,
      "token_end_exclusive": 1837
    },
    {
      "start_ms": 596950,
      "end_ms": 597985,
      "text": "风骨永存，",
      "token_start": 1837,
      "token_end_exclusive": 1841
    },
    {
      "start_ms": 598390,
      "end_ms": 599310,
      "text": "我辈不忘。",
      "token_start": 1841,
      "token_end_exclusive": 1845
    },
    {
      "start_ms": 599910,
      "end_ms": 603010,
      "text": "你是不是也被赵尚志的生平激励到了？",
      "token_start": 1845,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 603250,
      "end_ms": 606130,
      "text": "评论区留下一句致敬，",
      "token_start": 1861,
      "token_end_exclusive": 1870
    },
    {
      "start_ms": 606310,
      "end_ms": 608930,
      "text": "最孤独的铁血将军。",
      "token_start": 1870,
      "token_end_exclusive": 1878
    },
    {
      "start_ms": 609130,
      "end_ms": 612470,
      "text": "赵尚志可以点赞、收藏、关注我，",
      "token_start": 1878,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 613150,
      "end_ms": 618535,
      "text": "下期带你解锁更多藏在名气背后的真实人生。",
      "token_start": 1890,
      "token_end_exclusive": 1909
    }
  ],
