{
  "video_id": "v_067c1c1d8aa6c49d",
  "duration_s": 751.765692,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_067c1c1d8aa6c49d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_067c1c1d8aa6c49d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 890,
      "text": "捐一员，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 1230,
      "end_ms": 2010,
      "text": "造两担，",
      "token_start": 3,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2330,
      "end_ms": 3990,
      "text": "他才是真正的偶像。",
      "token_start": 6,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 5010,
      "end_ms": 11410,
      "text": "一九七八年的北京西单菜市场发生了一件让人哭笑不得的事儿。",
      "token_start": 14,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 12150,
      "end_ms": 15890,
      "text": "一位穿补丁衣服的老太太想买冬笋，",
      "token_start": 41,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 16430,
      "end_ms": 18050,
      "text": "小贩却翻着白眼，",
      "token_start": 56,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 18110,
      "end_ms": 20330,
      "text": "呵翅买不起就别碰。",
      "token_start": 63,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 21150,
      "end_ms": 22290,
      "text": "可谁能想到，",
      "token_start": 71,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 22870,
      "end_ms": 27510,
      "text": "这位被当成穷老太的老人，",
      "token_start": 76,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 27810,
      "end_ms": 30540,
      "text": "不仅是中国核物理的殿记西人，",
      "token_start": 87,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 30760,
      "end_ms": 34840,
      "text": "还把自家价值上亿的苏州往事员捐给了国家，",
      "token_start": 100,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 35540,
      "end_ms": 36920,
      "text": "他就是何泽会，",
      "token_start": 119,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 37280,
      "end_ms": 39680,
      "text": "一个让西方科学界敬畏，",
      "token_start": 125,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 39800,
      "end_ms": 44520,
      "text": "却把自己活成普通人的传奇女性。",
      "token_start": 135,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 44980,
      "end_ms": 45480,
      "text": "今天，",
      "token_start": 149,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 45880,
      "end_ms": 50040,
      "text": "咱们就来聊聊她传妇的一生。",
      "token_start": 151,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 50740,
      "end_ms": 52780,
      "text": "提起何泽慧的家世，",
      "token_start": 163,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 53360,
      "end_ms": 57520,
      "text": "那简直是天花板级别的存在。",
      "token_start": 171,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 58040,
      "end_ms": 64140,
      "text": "苏州合家素有无何不开科的说法，",
      "token_start": 183,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 64180,
      "end_ms": 67105,
      "text": "清朝一朝就出了十五个进士，",
      "token_start": 197,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 67670,
      "end_ms": 68985,
      "text": "二十九个举人。",
      "token_start": 209,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 69960,
      "end_ms": 71835,
      "text": "他的祖父是江南名士，",
      "token_start": 215,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 72440,
      "end_ms": 77145,
      "text": "父亲是同盟会早期成员追随孙中山闹革命。",
      "token_start": 224,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 77530,
      "end_ms": 79375,
      "text": "母亲是物理学翻译家，",
      "token_start": 242,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 79990,
      "end_ms": 83730,
      "text": "连外婆都是创办振华女校的教育家。",
      "token_start": 251,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 83910,
      "end_ms": 85415,
      "text": "出生在这样的家庭，",
      "token_start": 266,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 86090,
      "end_ms": 89055,
      "text": "何则惠从小就锦衣玉食，",
      "token_start": 274,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 89970,
      "end_ms": 92555,
      "text": "往师园里的亭台楼阁，",
      "token_start": 284,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 93150,
      "end_ms": 94865,
      "text": "就是他的童年乐园。",
      "token_start": 293,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 95750,
      "end_ms": 106455,
      "text": "可这位豪门千金却从小就透着一股不合时宜的质朴别的小姐穿绫罗绸缎，",
      "token_start": 301,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 106880,
      "end_ms": 109415,
      "text": "他却总穿初步校服，",
      "token_start": 332,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 110010,
      "end_ms": 112175,
      "text": "别的孩子把玩名贵玩具，",
      "token_start": 340,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 112600,
      "end_ms": 115525,
      "text": "他却着迷于拆卸钟表零件。",
      "token_start": 350,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 116500,
      "end_ms": 118955,
      "text": "外婆创办的振华女校里，",
      "token_start": 361,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 119560,
      "end_ms": 121065,
      "text": "他是最刻苦的学生。",
      "token_start": 371,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 121480,
      "end_ms": 122995,
      "text": "姨妈校长怕他骄傲，",
      "token_start": 379,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 123360,
      "end_ms": 124660,
      "text": "故意压他的成绩，",
      "token_start": 387,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 124740,
      "end_ms": 127555,
      "text": "可他每次都能轻松追上。",
      "token_start": 394,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 128540,
      "end_ms": 129505,
      "text": "有次考试，",
      "token_start": 404,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 130250,
      "end_ms": 131815,
      "text": "他数学拿了满分，",
      "token_start": 408,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 132300,
      "end_ms": 134265,
      "text": "却主动找到老师。",
      "token_start": 415,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 135050,
      "end_ms": 135815,
      "text": "这道题，",
      "token_start": 422,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 136180,
      "end_ms": 137885,
      "text": "我解法不够简便，",
      "token_start": 425,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 138620,
      "end_ms": 139655,
      "text": "不该得满分。",
      "token_start": 432,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 141480,
      "end_ms": 146575,
      "text": "这份较真为他后来的科研之路埋下了伏笔。",
      "token_start": 437,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 147460,
      "end_ms": 149095,
      "text": "十八岁考清华时，",
      "token_start": 455,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 149470,
      "end_ms": 152395,
      "text": "何泽会更是展现出惊人的天赋。",
      "token_start": 462,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 153290,
      "end_ms": 158165,
      "text": "当时清华大学物理系是神仙打架的地方。",
      "token_start": 475,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 158600,
      "end_ms": 161715,
      "text": "叶启、孙吴有训等大师坐镇，",
      "token_start": 492,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 162090,
      "end_ms": 163825,
      "text": "录取率不足百分之五，",
      "token_start": 503,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 164340,
      "end_ms": 166400,
      "text": "可何则惠不仅考上了，",
      "token_start": 512,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 166440,
      "end_ms": 169235,
      "text": "还成了当年的女状元。",
      "token_start": 521,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 170450,
      "end_ms": 171745,
      "text": "可入学第一天，",
      "token_start": 530,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 172050,
      "end_ms": 173795,
      "text": "他就遭遇了性别偏见。",
      "token_start": 536,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 174820,
      "end_ms": 180355,
      "text": "系主任叶启孙直接劝他转兮物理太烧脑，",
      "token_start": 545,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 181250,
      "end_ms": 183155,
      "text": "女生根本学不出来，",
      "token_start": 562,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 183570,
      "end_ms": 185465,
      "text": "毕业也是浪费时间。",
      "token_start": 570,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 186450,
      "end_ms": 188625,
      "text": "这话要是放在别人身上，",
      "token_start": 578,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 188930,
      "end_ms": 190825,
      "text": "可能早就打了退堂鼓。",
      "token_start": 588,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 191250,
      "end_ms": 196945,
      "text": "可何则会偏不他找到叶启孙立夏军令状，",
      "token_start": 597,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 198810,
      "end_ms": 200235,
      "text": "您给我四年时间，",
      "token_start": 614,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 200900,
      "end_ms": 202160,
      "text": "我要是考不了，",
      "token_start": 621,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 202160,
      "end_ms": 202615,
      "text": "第一，",
      "token_start": 627,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 202990,
      "end_ms": 203995,
      "text": "自愿转系。",
      "token_start": 629,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 204760,
      "end_ms": 205795,
      "text": "接下来的日子，",
      "token_start": 633,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 206140,
      "end_ms": 208835,
      "text": "他把宿舍当成了第二个实验室。",
      "token_start": 639,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 209050,
      "end_ms": 210375,
      "text": "冬天没有暖气，",
      "token_start": 652,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 210780,
      "end_ms": 212905,
      "text": "他就裹着棉袄演算公式。",
      "token_start": 658,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 213380,
      "end_ms": 215055,
      "text": "夏天蚊虫叮咬，",
      "token_start": 668,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 215720,
      "end_ms": 217800,
      "text": "他就在桌上放盆肥皂水，",
      "token_start": 674,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 217900,
      "end_ms": 220620,
      "text": "继续看书前三强。",
      "token_start": 684,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 220640,
      "end_ms": 221415,
      "text": "后来回忆，",
      "token_start": 691,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 221970,
      "end_ms": 223485,
      "text": "每次去图书馆，",
      "token_start": 695,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 224050,
      "end_ms": 225995,
      "text": "总能看到何则惠的座位，",
      "token_start": 701,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 226430,
      "end_ms": 229085,
      "text": "他的笔记本记得比教科书还详细。",
      "token_start": 711,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 229860,
      "end_ms": 230545,
      "text": "四年后，",
      "token_start": 725,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 230820,
      "end_ms": 232895,
      "text": "合资会果然兑现了承诺，",
      "token_start": 728,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 233440,
      "end_ms": 235885,
      "text": "以全班第一的成绩毕业，",
      "token_start": 738,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 236290,
      "end_ms": 239215,
      "text": "把第二名的前三强都甩在了身后。",
      "token_start": 748,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 239940,
      "end_ms": 240740,
      "text": "可毕业后，",
      "token_start": 762,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 241060,
      "end_ms": 242460,
      "text": "新的难题又来了。",
      "token_start": 766,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 242860,
      "end_ms": 244860,
      "text": "南京军工署来招生，",
      "token_start": 773,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 245160,
      "end_ms": 246780,
      "text": "看中了全班男生，",
      "token_start": 781,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 246880,
      "end_ms": 249520,
      "text": "唯独把他这个第一名拒之门外。",
      "token_start": 788,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 249720,
      "end_ms": 250960,
      "text": "我们这里不要女的，",
      "token_start": 801,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 251320,
      "end_ms": 252940,
      "text": "你还是回家嫁人吧。",
      "token_start": 809,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 253960,
      "end_ms": 254600,
      "text": "那一刻，",
      "token_start": 817,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 254900,
      "end_ms": 259220,
      "text": "何则惠第一次感受到了性别歧视的沉重。",
      "token_start": 820,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 259880,
      "end_ms": 261080,
      "text": "但她没有抱怨，",
      "token_start": 837,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 261400,
      "end_ms": 263340,
      "text": "而是立刻做了一个决定，",
      "token_start": 843,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 263760,
      "end_ms": 267300,
      "text": "去国外学最顶尖的军工技术。",
      "token_start": 853,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 267880,
      "end_ms": 273310,
      "text": "他瞄准了德国柏林高等工业大学的实验弹道学专业。",
      "token_start": 865,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 273910,
      "end_ms": 277270,
      "text": "这个专业是军工领域的天花板，",
      "token_start": 887,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 277750,
      "end_ms": 278870,
      "text": "百年以来，",
      "token_start": 900,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 279110,
      "end_ms": 281090,
      "text": "从没收过外国学生，",
      "token_start": 904,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 281450,
      "end_ms": 284890,
      "text": "更别提女性第一次登门系主任。",
      "token_start": 912,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 284890,
      "end_ms": 286410,
      "text": "克兰茨就把他拒了，",
      "token_start": 925,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 286650,
      "end_ms": 289950,
      "text": "这不是女孩子该学的东西太危险了，",
      "token_start": 933,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 290390,
      "end_ms": 295630,
      "text": "何泽会没有放弃她每天都去教授办公室外等候，",
      "token_start": 948,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 296290,
      "end_ms": 298535,
      "text": "终于在第五天等到了机会。",
      "token_start": 968,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 299120,
      "end_ms": 303280,
      "text": "他拿出报纸上中国百姓遭日军屠杀的照片，",
      "token_start": 979,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 303660,
      "end_ms": 304840,
      "text": "红着眼眶问，",
      "token_start": 997,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 305740,
      "end_ms": 306220,
      "text": "教授，",
      "token_start": 1002,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 307120,
      "end_ms": 308840,
      "text": "您曾在中国工作过，",
      "token_start": 1004,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 309080,
      "end_ms": 310460,
      "text": "见过这样的苦难，",
      "token_start": 1012,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 311020,
      "end_ms": 312860,
      "text": "如果您的国家被侵略，",
      "token_start": 1019,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 313080,
      "end_ms": 315600,
      "text": "您会让自己的女儿放弃抵抗吗？",
      "token_start": 1028,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 316420,
      "end_ms": 318720,
      "text": "我学技术不是为了名利，",
      "token_start": 1041,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 318820,
      "end_ms": 319980,
      "text": "是为了救国。",
      "token_start": 1051,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 321240,
      "end_ms": 323380,
      "text": "克兰兹教授被深深打动，",
      "token_start": 1056,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 323780,
      "end_ms": 327940,
      "text": "破例录取了他在德国的几年里，",
      "token_start": 1066,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 328280,
      "end_ms": 330770,
      "text": "何则会成了最拼命的学生。",
      "token_start": 1079,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 331730,
      "end_ms": 333050,
      "text": "别人练瞄准，",
      "token_start": 1090,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 333110,
      "end_ms": 335750,
      "text": "练到手臂发酸就休息，",
      "token_start": 1095,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 336390,
      "end_ms": 338190,
      "text": "他却坚持到握不住枪。",
      "token_start": 1104,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 338670,
      "end_ms": 341070,
      "text": "别人觉得实验数据差不多就行，",
      "token_start": 1113,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 341550,
      "end_ms": 343750,
      "text": "他却反复校验几十次。",
      "token_start": 1126,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 344410,
      "end_ms": 345550,
      "text": "一九三九年，",
      "token_start": 1135,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 345910,
      "end_ms": 347050,
      "text": "他的毕业论文，",
      "token_start": 1140,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 347170,
      "end_ms": 350210,
      "text": "一种新的测量子弹、飞行速度方法，",
      "token_start": 1146,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 350610,
      "end_ms": 352670,
      "text": "震惊了整个军工界。",
      "token_start": 1160,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 353410,
      "end_ms": 356330,
      "text": "连德国军方都想聘请他，",
      "token_start": 1168,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 356790,
      "end_ms": 359785,
      "text": "可他却一口拒绝我的技术，",
      "token_start": 1178,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 360140,
      "end_ms": 361745,
      "text": "只为中国服务。",
      "token_start": 1189,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 362520,
      "end_ms": 363415,
      "text": "就在这时，",
      "token_start": 1195,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 363830,
      "end_ms": 367645,
      "text": "远在法国的前三强向他递来了求婚信。",
      "token_start": 1199,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 368400,
      "end_ms": 372235,
      "text": "这位在侵华时就默默关注他的男生，",
      "token_start": 1215,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 372990,
      "end_ms": 377195,
      "text": "此时已是居里实验室的核心研究员。",
      "token_start": 1230,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 377870,
      "end_ms": 380165,
      "text": "他的求婚信只有二十五个字，",
      "token_start": 1245,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 380510,
      "end_ms": 381985,
      "text": "却字字真诚，",
      "token_start": 1257,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 382830,
      "end_ms": 383230,
      "text": "何则，",
      "token_start": 1262,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 383230,
      "end_ms": 384805,
      "text": "会的回复更干脆，",
      "token_start": 1264,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 385240,
      "end_ms": 387555,
      "text": "等我们见面后一同回国。",
      "token_start": 1271,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 388380,
      "end_ms": 389325,
      "text": "一九四六年，",
      "token_start": 1281,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 389740,
      "end_ms": 391115,
      "text": "两人在巴黎结婚，",
      "token_start": 1286,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 391680,
      "end_ms": 394335,
      "text": "证婚人正是居里夫人的女儿。",
      "token_start": 1293,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 394590,
      "end_ms": 397185,
      "text": "伊雷娜伊丽娜笑着说，",
      "token_start": 1305,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 398150,
      "end_ms": 400530,
      "text": "你们俩都是核物理的天才，",
      "token_start": 1314,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 400750,
      "end_ms": 402665,
      "text": "一定会创造奇迹。",
      "token_start": 1325,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 403630,
      "end_ms": 404665,
      "text": "婚后的日子，",
      "token_start": 1332,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 405110,
      "end_ms": 407305,
      "text": "他们把实验室当成了家。",
      "token_start": 1337,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 408480,
      "end_ms": 410205,
      "text": "为了研究游河裂变，",
      "token_start": 1347,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 410740,
      "end_ms": 413445,
      "text": "他们经常连续几天不睡觉，",
      "token_start": 1355,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 414300,
      "end_ms": 417545,
      "text": "用显微镜一张一张检视底片。",
      "token_start": 1366,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 418190,
      "end_ms": 424285,
      "text": "要知道油盒儿四分裂的概率比中彩票还低。",
      "token_start": 1378,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 425280,
      "end_ms": 428545,
      "text": "很多科学家研究了一辈子都没发现，",
      "token_start": 1396,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 429240,
      "end_ms": 435685,
      "text": "可何则会凭着鸡蛋里挑骨头的细致，",
      "token_start": 1411,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 436230,
      "end_ms": 441545,
      "text": "硬是在成千上万张底片中找到了那个关键的痕迹。",
      "token_start": 1426,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 442420,
      "end_ms": 443425,
      "text": "一九四七年，",
      "token_start": 1447,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 443870,
      "end_ms": 445890,
      "text": "他们的研究成果发表后，",
      "token_start": 1452,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 446050,
      "end_ms": 447665,
      "text": "西方科学界惊呼，",
      "token_start": 1462,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 448480,
      "end_ms": 452055,
      "text": "中国的居里夫妇打开了核物理的新窗口。",
      "token_start": 1469,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 452660,
      "end_ms": 455235,
      "text": "诺贝尔奖的邀请很快来了，",
      "token_start": 1486,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 456210,
      "end_ms": 459665,
      "text": "可当得知需要加入外国国籍时，",
      "token_start": 1497,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 460260,
      "end_ms": 460640,
      "text": "何则，",
      "token_start": 1510,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 460640,
      "end_ms": 462495,
      "text": "惠想都没想就拒绝了。",
      "token_start": 1512,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 463520,
      "end_ms": 464725,
      "text": "一九四八年，",
      "token_start": 1521,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 465230,
      "end_ms": 470445,
      "text": "他和前三强抱着半岁的女儿踏上了回国的轮船。",
      "token_start": 1526,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 471440,
      "end_ms": 472275,
      "text": "有人问他，",
      "token_start": 1546,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 474220,
      "end_ms": 475675,
      "text": "国外条件那么好，",
      "token_start": 1550,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 476210,
      "end_ms": 477805,
      "text": "你为什么非要回去？",
      "token_start": 1557,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 478830,
      "end_ms": 479510,
      "text": "他回答，",
      "token_start": 1565,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 480790,
      "end_ms": 482250,
      "text": "科学没有国界，",
      "token_start": 1568,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 482550,
      "end_ms": 484350,
      "text": "但科学家有祖国，",
      "token_start": 1574,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 485450,
      "end_ms": 489310,
      "text": "可回国后的困境还是超出了他的想象。",
      "token_start": 1581,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 490330,
      "end_ms": 491410,
      "text": "当时的中国，",
      "token_start": 1597,
      "token_end_exclusive": 1602
    },
    {
      "start_ms": 491870,
      "end_ms": 494810,
      "text": "连一台像样的实验仪器都没有，",
      "token_start": 1602,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 495710,
      "end_ms": 496190,
      "text": "何则，",
      "token_start": 1615,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 496190,
      "end_ms": 497210,
      "text": "会没有抱怨，",
      "token_start": 1617,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 497810,
      "end_ms": 500570,
      "text": "而是带着钱三强骑着自行车，",
      "token_start": 1622,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 500990,
      "end_ms": 503490,
      "text": "跑遍了北京的旧货市场。",
      "token_start": 1634,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 504070,
      "end_ms": 508165,
      "text": "旧五金、废电子馆生锈的零件。",
      "token_start": 1644,
      "token_end_exclusive": 1656
    },
    {
      "start_ms": 508700,
      "end_ms": 510040,
      "text": "别人眼里的破烂，",
      "token_start": 1656,
      "token_end_exclusive": 1663
    },
    {
      "start_ms": 510220,
      "end_ms": 511580,
      "text": "在他看来都是宝贝。",
      "token_start": 1663,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 512400,
      "end_ms": 514080,
      "text": "他亲手画图纸，",
      "token_start": 1671,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 514920,
      "end_ms": 515640,
      "text": "前三强，",
      "token_start": 1677,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 515740,
      "end_ms": 516640,
      "text": "动手加工，",
      "token_start": 1680,
      "token_end_exclusive": 1684
    },
    {
      "start_ms": 517080,
      "end_ms": 523720,
      "text": "硬是把这些破烂改成了实验设备，",
      "token_start": 1684,
      "token_end_exclusive": 1698
    },
    {
      "start_ms": 524800,
      "end_ms": 526120,
      "text": "没有核乳胶。",
      "token_start": 1698,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 526860,
      "end_ms": 528980,
      "text": "他就在暗室里守着红灯，",
      "token_start": 1703,
      "token_end_exclusive": 1713
    },
    {
      "start_ms": 529340,
      "end_ms": 530660,
      "text": "握着玻璃脚棍，",
      "token_start": 1713,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 530740,
      "end_ms": 532140,
      "text": "听节拍机搅拌，",
      "token_start": 1719,
      "token_end_exclusive": 1725
    },
    {
      "start_ms": 532300,
      "end_ms": 534460,
      "text": "一练就是十几个小时，",
      "token_start": 1725,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 535240,
      "end_ms": 536760,
      "text": "胳膊酸的抬不起来，",
      "token_start": 1734,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 536760,
      "end_ms": 537580,
      "text": "也不休息。",
      "token_start": 1742,
      "token_end_exclusive": 1746
    },
    {
      "start_ms": 538400,
      "end_ms": 539655,
      "text": "一、一九五九年，",
      "token_start": 1746,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 540000,
      "end_ms": 541855,
      "text": "苏联撤走所有专家，",
      "token_start": 1752,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 542280,
      "end_ms": 543725,
      "text": "带走了全部资料。",
      "token_start": 1760,
      "token_end_exclusive": 1767
    },
    {
      "start_ms": 544640,
      "end_ms": 545380,
      "text": "还断言，",
      "token_start": 1767,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 545460,
      "end_ms": 547925,
      "text": "中国二十年搞不出原子弹，",
      "token_start": 1770,
      "token_end_exclusive": 1781
    },
    {
      "start_ms": 548480,
      "end_ms": 550725,
      "text": "何则会临危受命，",
      "token_start": 1781,
      "token_end_exclusive": 1788
    },
    {
      "start_ms": 551210,
      "end_ms": 554535,
      "text": "负责暴风实验的数据采集。",
      "token_start": 1788,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 555260,
      "end_ms": 557705,
      "text": "当时的实验室漏风漏雨，",
      "token_start": 1799,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 558110,
      "end_ms": 561175,
      "text": "冬天温度低到零下十几度。",
      "token_start": 1809,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 561820,
      "end_ms": 564745,
      "text": "他带着团队吃住在实验室，",
      "token_start": 1820,
      "token_end_exclusive": 1831
    },
    {
      "start_ms": 565390,
      "end_ms": 566825,
      "text": "饿了啃口干粮，",
      "token_start": 1831,
      "token_end_exclusive": 1837
    },
    {
      "start_ms": 567080,
      "end_ms": 567555,
      "text": "困难，",
      "token_start": 1837,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 567880,
      "end_ms": 569335,
      "text": "趴在桌上眯一会儿。",
      "token_start": 1839,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 569800,
      "end_ms": 571035,
      "text": "短短几个月，",
      "token_start": 1847,
      "token_end_exclusive": 1852
    },
    {
      "start_ms": 571320,
      "end_ms": 573520,
      "text": "他们采集了十万组数据，",
      "token_start": 1852,
      "token_end_exclusive": 1862
    },
    {
      "start_ms": 573600,
      "end_ms": 574725,
      "text": "没有一个差错。",
      "token_start": 1862,
      "token_end_exclusive": 1868
    },
    {
      "start_ms": 575450,
      "end_ms": 577115,
      "text": "有人问他怎么做到的？",
      "token_start": 1868,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 577490,
      "end_ms": 578275,
      "text": "他笑着说，",
      "token_start": 1877,
      "token_end_exclusive": 1881
    },
    {
      "start_ms": 578640,
      "end_ms": 579525,
      "text": "只要认真，",
      "token_start": 1881,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 579890,
      "end_ms": 581185,
      "text": "就没有做不成的事。",
      "token_start": 1885,
      "token_end_exclusive": 1893
    },
    {
      "start_ms": 582080,
      "end_ms": 583175,
      "text": "一九六四年，",
      "token_start": 1893,
      "token_end_exclusive": 1898
    },
    {
      "start_ms": 583580,
      "end_ms": 586055,
      "text": "第一颗原子弹爆炸成功，",
      "token_start": 1898,
      "token_end_exclusive": 1908
    },
    {
      "start_ms": 586530,
      "end_ms": 589895,
      "text": "一九六七年清淡紧随其后。",
      "token_start": 1908,
      "token_end_exclusive": 1919
    },
    {
      "start_ms": 590340,
      "end_ms": 593290,
      "text": "中国用二年八个月的时间，",
      "token_start": 1919,
      "token_end_exclusive": 1930
    },
    {
      "start_ms": 593510,
      "end_ms": 597275,
      "text": "实现了从原子弹到清淡的突破，",
      "token_start": 1930,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 597760,
      "end_ms": 599555,
      "text": "创造了世界奇迹。",
      "token_start": 1943,
      "token_end_exclusive": 1950
    },
    {
      "start_ms": 600150,
      "end_ms": 601250,
      "text": "而这背后，",
      "token_start": 1950,
      "token_end_exclusive": 1954
    },
    {
      "start_ms": 601770,
      "end_ms": 609670,
      "text": "何泽会研发的点火中子源和破解的数据漏洞起到了关键作用。",
      "token_start": 1954,
      "token_end_exclusive": 1980
    },
    {
      "start_ms": 610010,
      "end_ms": 611590,
      "text": "可他却从不鞠功，",
      "token_start": 1980,
      "token_end_exclusive": 1987
    },
    {
      "start_ms": 612130,
      "end_ms": 612790,
      "text": "总是说，",
      "token_start": 1987,
      "token_end_exclusive": 1990
    },
    {
      "start_ms": 613130,
      "end_ms": 615430,
      "text": "这是大家一起努力的结果，",
      "token_start": 1990,
      "token_end_exclusive": 2001
    },
    {
      "start_ms": 615510,
      "end_ms": 617330,
      "text": "我只是做了该做的事。",
      "token_start": 2001,
      "token_end_exclusive": 2010
    },
    {
      "start_ms": 618590,
      "end_ms": 619910,
      "text": "功成名就后，",
      "token_start": 2010,
      "token_end_exclusive": 2015
    },
    {
      "start_ms": 620090,
      "end_ms": 623450,
      "text": "何则会依旧保持着质朴的生活。",
      "token_start": 2015,
      "token_end_exclusive": 2028
    },
    {
      "start_ms": 624330,
      "end_ms": 626790,
      "text": "他把祖宅往师园捐给了国家。",
      "token_start": 2028,
      "token_end_exclusive": 2040
    },
    {
      "start_ms": 627390,
      "end_ms": 629430,
      "text": "有人说这原子之上意，",
      "token_start": 2040,
      "token_end_exclusive": 2049
    },
    {
      "start_ms": 630180,
      "end_ms": 631480,
      "text": "他却淡淡一笑，",
      "token_start": 2049,
      "token_end_exclusive": 2055
    },
    {
      "start_ms": 632420,
      "end_ms": 633820,
      "text": "国家需要就好。",
      "token_start": 2055,
      "token_end_exclusive": 2061
    },
    {
      "start_ms": 634740,
      "end_ms": 641340,
      "text": "他穿的衣服补丁罗补丁用的公文包是缝补过的，",
      "token_start": 2061,
      "token_end_exclusive": 2081
    },
    {
      "start_ms": 641340,
      "end_ms": 642020,
      "text": "旧书包，",
      "token_start": 2081,
      "token_end_exclusive": 2084
    },
    {
      "start_ms": 642940,
      "end_ms": 646700,
      "text": "连鞋子都是打了三层补丁的解放鞋。",
      "token_start": 2084,
      "token_end_exclusive": 2099
    },
    {
      "start_ms": 647280,
      "end_ms": 648420,
      "text": "一九七八年，",
      "token_start": 2099,
      "token_end_exclusive": 2104
    },
    {
      "start_ms": 648480,
      "end_ms": 650820,
      "text": "在菜市场被小贩呵斥时，",
      "token_start": 2104,
      "token_end_exclusive": 2114
    },
    {
      "start_ms": 651240,
      "end_ms": 652260,
      "text": "他没有生气，",
      "token_start": 2114,
      "token_end_exclusive": 2119
    },
    {
      "start_ms": 652740,
      "end_ms": 655480,
      "text": "只是笑着放下冬笋好好，",
      "token_start": 2119,
      "token_end_exclusive": 2129
    },
    {
      "start_ms": 655940,
      "end_ms": 656620,
      "text": "我不碰。",
      "token_start": 2129,
      "token_end_exclusive": 2132
    },
    {
      "start_ms": 656780,
      "end_ms": 658780,
      "text": "直到有人说出他的身份，",
      "token_start": 2132,
      "token_end_exclusive": 2142
    },
    {
      "start_ms": 659120,
      "end_ms": 661215,
      "text": "小贩才吓了骂的连连道歉。",
      "token_start": 2142,
      "token_end_exclusive": 2153
    },
    {
      "start_ms": 662270,
      "end_ms": 663575,
      "text": "后来有人问他，",
      "token_start": 2153,
      "token_end_exclusive": 2159
    },
    {
      "start_ms": 664130,
      "end_ms": 666285,
      "text": "您为国家做了这么多贡献，",
      "token_start": 2159,
      "token_end_exclusive": 2170
    },
    {
      "start_ms": 666780,
      "end_ms": 668495,
      "text": "为什么过得这么简朴？",
      "token_start": 2170,
      "token_end_exclusive": 2179
    },
    {
      "start_ms": 669450,
      "end_ms": 670065,
      "text": "他回答，",
      "token_start": 2179,
      "token_end_exclusive": 2182
    },
    {
      "start_ms": 670560,
      "end_ms": 671735,
      "text": "居里夫人说过，",
      "token_start": 2182,
      "token_end_exclusive": 2188
    },
    {
      "start_ms": 672110,
      "end_ms": 675025,
      "text": "科学研究需要的是艰苦奋斗，",
      "token_start": 2188,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 675470,
      "end_ms": 676975,
      "text": "不是铺张浪费。",
      "token_start": 2200,
      "token_end_exclusive": 2206
    },
    {
      "start_ms": 677600,
      "end_ms": 680565,
      "text": "我的钱要用来做更有用的事。",
      "token_start": 2206,
      "token_end_exclusive": 2218
    },
    {
      "start_ms": 681350,
      "end_ms": 683320,
      "text": "他口中更有用的，",
      "token_start": 2218,
      "token_end_exclusive": 2225
    },
    {
      "start_ms": 683320,
      "end_ms": 688085,
      "text": "是就是资助贫困学生和购买科研书籍。",
      "token_start": 2225,
      "token_end_exclusive": 2241
    },
    {
      "start_ms": 688600,
      "end_ms": 692865,
      "text": "直到九十二岁摔伤前，",
      "token_start": 2241,
      "token_end_exclusive": 2250
    },
    {
      "start_ms": 693220,
      "end_ms": 697020,
      "text": "他每天都准时去研究所上班。",
      "token_start": 2250,
      "token_end_exclusive": 2262
    },
    {
      "start_ms": 697040,
      "end_ms": 698145,
      "text": "八、十六岁时，",
      "token_start": 2262,
      "token_end_exclusive": 2267
    },
    {
      "start_ms": 698440,
      "end_ms": 701195,
      "text": "还在领导建立中子物理研究室，",
      "token_start": 2267,
      "token_end_exclusive": 2280
    },
    {
      "start_ms": 701880,
      "end_ms": 702960,
      "text": "二零一一年，",
      "token_start": 2280,
      "token_end_exclusive": 2285
    },
    {
      "start_ms": 703260,
      "end_ms": 705340,
      "text": "合泽会与世长辞，",
      "token_start": 2285,
      "token_end_exclusive": 2292
    },
    {
      "start_ms": 705840,
      "end_ms": 707745,
      "text": "享年九十七岁。",
      "token_start": 2292,
      "token_end_exclusive": 2298
    },
    {
      "start_ms": 708660,
      "end_ms": 709880,
      "text": "二零一七年，",
      "token_start": 2298,
      "token_end_exclusive": 2303
    },
    {
      "start_ms": 710160,
      "end_ms": 716385,
      "text": "中国首颗空间x射线望远镜被命名为慧眼，",
      "token_start": 2303,
      "token_end_exclusive": 2321
    },
    {
      "start_ms": 716910,
      "end_ms": 721025,
      "text": "以此纪念这位一生追寻真理的科学家。",
      "token_start": 2321,
      "token_end_exclusive": 2337
    },
    {
      "start_ms": 721560,
      "end_ms": 724915,
      "text": "他用一生诠释了真正的富有，",
      "token_start": 2337,
      "token_end_exclusive": 2349
    },
    {
      "start_ms": 725490,
      "end_ms": 726795,
      "text": "不是家财万贯，",
      "token_start": 2349,
      "token_end_exclusive": 2355
    },
    {
      "start_ms": 727240,
      "end_ms": 729115,
      "text": "而是精神的充盈。",
      "token_start": 2355,
      "token_end_exclusive": 2362
    },
    {
      "start_ms": 729620,
      "end_ms": 732975,
      "text": "真正的高贵不是地位显赫，",
      "token_start": 2362,
      "token_end_exclusive": 2373
    },
    {
      "start_ms": 733620,
      "end_ms": 736005,
      "text": "而是为国为民的担当。",
      "token_start": 2373,
      "token_end_exclusive": 2382
    },
    {
      "start_ms": 736780,
      "end_ms": 737625,
      "text": "看到这里，",
      "token_start": 2382,
      "token_end_exclusive": 2386
    },
    {
      "start_ms": 737940,
      "end_ms": 740540,
      "text": "如果你也被这样的何泽会打动，",
      "token_start": 2386,
      "token_end_exclusive": 2399
    },
    {
      "start_ms": 740620,
      "end_ms": 742735,
      "text": "别忘了点赞、收藏、关注我，",
      "token_start": 2399,
      "token_end_exclusive": 2409
    },
    {
      "start_ms": 743250,
      "end_ms": 746395,
      "text": "带你拆解更多被掩盖的历史人物，",
      "token_start": 2409,
      "token_end_exclusive": 2423
    },
    {
      "start_ms": 747250,
      "end_ms": 751495,
      "text": "读懂他们藏在名气背后的真实人生。",
      "token_start": 2423,
      "token_end_exclusive": 2438
    }
  ],
