{
  "video_id": "v_a4374858226b6926",
  "duration_s": 143.708005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_a4374858226b6926.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_a4374858226b6926.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 410,
      "end_ms": 810,
      "text": "诸君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1150,
      "end_ms": 1890,
      "text": "你知道吗？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2090,
      "end_ms": 4690,
      "text": "一定要对自己的私事守口如瓶。",
      "token_start": 6,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 5170,
      "end_ms": 6970,
      "text": "你只要敢打探我的隐私，",
      "token_start": 19,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 7190,
      "end_ms": 8290,
      "text": "我就一定会骗你。",
      "token_start": 29,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8710,
      "end_ms": 9530,
      "text": "你只要敢问，",
      "token_start": 36,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 9530,
      "end_ms": 10850,
      "text": "我让我尴尬的问题，",
      "token_start": 41,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 10930,
      "end_ms": 12050,
      "text": "我就一定会说谎。",
      "token_start": 49,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 12490,
      "end_ms": 14570,
      "text": "打听本身就是一种恶意，",
      "token_start": 56,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 14930,
      "end_ms": 16070,
      "text": "这个不是冷漠哦，",
      "token_start": 66,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 16250,
      "end_ms": 17810,
      "text": "一旦发现别人摸你的底，",
      "token_start": 73,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 17890,
      "end_ms": 18990,
      "text": "你就胡说八道。",
      "token_start": 83,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 19450,
      "end_ms": 20610,
      "text": "如果在秋分这一天，",
      "token_start": 89,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 20610,
      "end_ms": 21450,
      "text": "你抬头看一看，",
      "token_start": 97,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 21450,
      "end_ms": 23110,
      "text": "天会发现一个神奇的现象。",
      "token_start": 103,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 23410,
      "end_ms": 26050,
      "text": "大树的树冠会羞涩的保持一定的距离，",
      "token_start": 114,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 26050,
      "end_ms": 27550,
      "text": "空隙彼此礼让，",
      "token_start": 130,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 27710,
      "end_ms": 28630,
      "text": "这叫树冠。",
      "token_start": 136,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 28670,
      "end_ms": 29110,
      "text": "修弊，",
      "token_start": 140,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 29310,
      "end_ms": 30860,
      "text": "是植物特边界界，",
      "token_start": 142,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 31080,
      "end_ms": 33860,
      "text": "而这种边界感也是成年人该有的体面。",
      "token_start": 149,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 34160,
      "end_ms": 36860,
      "text": "秋分这个节气最妙的就在一个分字，",
      "token_start": 165,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 37200,
      "end_ms": 40460,
      "text": "你要恰如其分的守护好自己的边界感。",
      "token_start": 180,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 40860,
      "end_ms": 43880,
      "text": "我们在九月二十三号迎来了秋分节气，",
      "token_start": 196,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 44080,
      "end_ms": 46400,
      "text": "是一年中最讲究平衡的日子。",
      "token_start": 212,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 46640,
      "end_ms": 47360,
      "text": "秋分者，",
      "token_start": 224,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 47440,
      "end_ms": 48520,
      "text": "阴阳相伴也，",
      "token_start": 227,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 48520,
      "end_ms": 50740,
      "text": "故昼夜君而寒暑平。",
      "token_start": 232,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 50740,
      "end_ms": 52180,
      "text": "一年走在这里，",
      "token_start": 240,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 52180,
      "end_ms": 53260,
      "text": "白昼与黑夜，",
      "token_start": 246,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 53260,
      "end_ms": 54160,
      "text": "刚好等长，",
      "token_start": 251,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 54160,
      "end_ms": 55840,
      "text": "请在这一天提醒自己，",
      "token_start": 255,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 55840,
      "end_ms": 57960,
      "text": "天地万物皆有分寸。",
      "token_start": 264,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 58000,
      "end_ms": 59500,
      "text": "要对你身边的人说，",
      "token_start": 272,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 59500,
      "end_ms": 61290,
      "text": "我们只是一起上班，",
      "token_start": 280,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 61330,
      "end_ms": 62230,
      "text": "并不是朋友，",
      "token_start": 288,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 62450,
      "end_ms": 63650,
      "text": "我们只是一起上学，",
      "token_start": 293,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 63770,
      "end_ms": 66000,
      "text": "我们不是朋友一起上班，",
      "token_start": 301,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 66060,
      "end_ms": 67750,
      "text": "那叫同事一起上学，",
      "token_start": 311,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 67990,
      "end_ms": 69630,
      "text": "那叫同学离开。",
      "token_start": 319,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 69630,
      "end_ms": 70550,
      "text": "这个环境之后，",
      "token_start": 325,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 70650,
      "end_ms": 71885,
      "text": "我们没有任何关系，",
      "token_start": 331,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 72240,
      "end_ms": 75135,
      "text": "我们只是在特定场合才会产生交情的人。",
      "token_start": 339,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 75380,
      "end_ms": 76360,
      "text": "离开这个环境，",
      "token_start": 356,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 76380,
      "end_ms": 77935,
      "text": "我们的话题无法延伸，",
      "token_start": 362,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 78320,
      "end_ms": 81320,
      "text": "为什么要用朋友的名义越界来刺探我的生活？",
      "token_start": 371,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 81540,
      "end_ms": 83425,
      "text": "最怕的就是交浅言深。",
      "token_start": 390,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 83880,
      "end_ms": 85160,
      "text": "人和人刚认识的时候，",
      "token_start": 399,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 85160,
      "end_ms": 86800,
      "text": "最好虚伪又热情，",
      "token_start": 408,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 87000,
      "end_ms": 88035,
      "text": "新鲜又浪漫。",
      "token_start": 415,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 88260,
      "end_ms": 90875,
      "text": "但人和事走太近都不壮观，",
      "token_start": 420,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 91310,
      "end_ms": 92975,
      "text": "尤其不要轻易好为人师，",
      "token_start": 431,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 93360,
      "end_ms": 95505,
      "text": "主动交人就是结仇的态始。",
      "token_start": 441,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 95780,
      "end_ms": 98515,
      "text": "你以为是在帮他他觉得你是在俯视他，",
      "token_start": 452,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 98890,
      "end_ms": 100130,
      "text": "认知不在一个层次，",
      "token_start": 468,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 100170,
      "end_ms": 100610,
      "text": "指导，",
      "token_start": 476,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 100610,
      "end_ms": 101305,
      "text": "就是冒犯，",
      "token_start": 478,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 101660,
      "end_ms": 102120,
      "text": "要珍惜。",
      "token_start": 482,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 102120,
      "end_ms": 104735,
      "text": "那些一开始并不很热情、很克制的朋友，",
      "token_start": 485,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 105140,
      "end_ms": 107035,
      "text": "当一个人向你树立边界时，",
      "token_start": 501,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 107380,
      "end_ms": 110235,
      "text": "其实是在想方设法把你留在他的生命里。",
      "token_start": 512,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 110540,
      "end_ms": 111480,
      "text": "边界不是墙，",
      "token_start": 529,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 111600,
      "end_ms": 112990,
      "text": "是篱笆墙，",
      "token_start": 534,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 113030,
      "end_ms": 114090,
      "text": "是用来挡住人的，",
      "token_start": 538,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 114090,
      "end_ms": 115815,
      "text": "而篱笆是用来告诉别人。",
      "token_start": 545,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 116030,
      "end_ms": 116770,
      "text": "这里面有花，",
      "token_start": 555,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 116990,
      "end_ms": 118045,
      "text": "请从门进来，",
      "token_start": 560,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 118510,
      "end_ms": 119690,
      "text": "就像你去饭店吃饭，",
      "token_start": 565,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 119790,
      "end_ms": 121810,
      "text": "说出自己的忌口是为了点菜，",
      "token_start": 573,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 121950,
      "end_ms": 123065,
      "text": "而不是离开。",
      "token_start": 585,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 123630,
      "end_ms": 123970,
      "text": "你看，",
      "token_start": 590,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 124250,
      "end_ms": 125110,
      "text": "一夜秋风，",
      "token_start": 592,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 125230,
      "end_ms": 129660,
      "text": "一夜秋风秋天的景色被白昼和黑夜平均分配，",
      "token_start": 596,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 129800,
      "end_ms": 131685,
      "text": "这就是平分秋色。",
      "token_start": 615,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 132260,
      "end_ms": 133260,
      "text": "暑热消退，",
      "token_start": 622,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 133280,
      "end_ms": 134260,
      "text": "一半寒凉，",
      "token_start": 626,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 134380,
      "end_ms": 136490,
      "text": "生长一半山色不浓。",
      "token_start": 630,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 136490,
      "end_ms": 138735,
      "text": "不淡湖光不深不浅，",
      "token_start": 638,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 139160,
      "end_ms": 140580,
      "text": "愿我们亲疏有度，",
      "token_start": 646,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 140840,
      "end_ms": 142085,
      "text": "远近相安，",
      "token_start": 653,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 142490,
      "end_ms": 143395,
      "text": "久处不厌。",
      "token_start": 657,
      "token_end_exclusive": 661
    }
  ],
