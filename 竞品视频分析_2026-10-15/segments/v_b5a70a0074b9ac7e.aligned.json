{
  "video_id": "v_b5a70a0074b9ac7e",
  "duration_s": 375.769002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b5a70a0074b9ac7e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b5a70a0074b9ac7e.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 770,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 990,
      "end_ms": 5330,
      "text": "咱们国家公路总里程已经超过五百四十万公里，",
      "token_start": 4,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5630,
      "end_ms": 7610,
      "text": "能绕地球一百多圈。",
      "token_start": 24,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 8130,
      "end_ms": 9630,
      "text": "可要说哪一条最美？",
      "token_start": 32,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 9910,
      "end_ms": 11430,
      "text": "那争议可就大了。",
      "token_start": 40,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 11910,
      "end_ms": 15750,
      "text": "有人说是川藏线中国人的景观大道。",
      "token_start": 47,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 16110,
      "end_ms": 19830,
      "text": "有人说是独库公路一日观四季，",
      "token_start": 62,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 20170,
      "end_ms": 22010,
      "text": "十里不同天错，",
      "token_start": 75,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 22490,
      "end_ms": 23790,
      "text": "真要论其美，",
      "token_start": 81,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 23910,
      "end_ms": 29010,
      "text": "这个字川藏线和独库公路连前山都进不去。",
      "token_start": 86,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 29370,
      "end_ms": 33580,
      "text": "今天咱们我们就来盘点中国十大最美公路。",
      "token_start": 104,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 34300,
      "end_ms": 38320,
      "text": "先讲第十到第六一条比一条好看。",
      "token_start": 122,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 38440,
      "end_ms": 39040,
      "text": "老规矩，",
      "token_start": 136,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 39240,
      "end_ms": 40040,
      "text": "开讲之前，",
      "token_start": 139,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 40340,
      "end_ms": 42380,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 143,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 42620,
      "end_ms": 45660,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 153,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 46060,
      "end_ms": 52020,
      "text": "河南郭亮挂壁公路在河南新乡辉县太行山的绝壁上，",
      "token_start": 165,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 52580,
      "end_ms": 59580,
      "text": "这条路最绝的是他挂在悬崖上一千二百五十米长的隧道外侧，",
      "token_start": 187,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 59580,
      "end_ms": 61545,
      "text": "找薄了三十五个天窗。",
      "token_start": 213,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 62420,
      "end_ms": 65675,
      "text": "每一个天窗都是一个天然的画框。",
      "token_start": 222,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 66090,
      "end_ms": 67795,
      "text": "您坐在车里往外看，",
      "token_start": 236,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 68630,
      "end_ms": 71085,
      "text": "太行山大峡谷就在画框里，",
      "token_start": 244,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 71780,
      "end_ms": 73785,
      "text": "一座山连着一座山，",
      "token_start": 255,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 74470,
      "end_ms": 74990,
      "text": "悬崖，",
      "token_start": 263,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 75050,
      "end_ms": 77610,
      "text": "一层叠着一层谷底的村子，",
      "token_start": 265,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 77750,
      "end_ms": 78850,
      "text": "小的像火柴盒，",
      "token_start": 276,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 79130,
      "end_ms": 81745,
      "text": "云从山谷里升起来又散开。",
      "token_start": 282,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 82280,
      "end_ms": 86170,
      "text": "隧道里的光是一段一段的天窗，",
      "token_start": 293,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 86270,
      "end_ms": 89135,
      "text": "进来一束暗一段再进来一束，",
      "token_start": 306,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 89700,
      "end_ms": 92975,
      "text": "再按一段车在光影里穿行，",
      "token_start": 318,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 93570,
      "end_ms": 95025,
      "text": "像在放幻灯片，",
      "token_start": 329,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 95600,
      "end_ms": 98605,
      "text": "红颜绝壁就在您右手边，",
      "token_start": 335,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 99000,
      "end_ms": 101905,
      "text": "伸手就能摸到这哪是开车。",
      "token_start": 345,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 102420,
      "end_ms": 104505,
      "text": "这是在山肚子里看画展。",
      "token_start": 356,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 105090,
      "end_ms": 105695,
      "text": "第九名，",
      "token_start": 366,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 106350,
      "end_ms": 110925,
      "text": "广西河那高速从合浦到那坡，",
      "token_start": 369,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 111450,
      "end_ms": 114015,
      "text": "全长五百一十六公里，",
      "token_start": 381,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 115020,
      "end_ms": 120025,
      "text": "这条路最绝的是他全程穿行在卡斯特枫林里，",
      "token_start": 390,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 120260,
      "end_ms": 122155,
      "text": "一座座圆圆的石头山，",
      "token_start": 409,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 122780,
      "end_ms": 124300,
      "text": "从地里长出来，",
      "token_start": 418,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 124460,
      "end_ms": 131915,
      "text": "绿绿的一座挨着一座像一片石头做的波浪车在路面上走，",
      "token_start": 424,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 132680,
      "end_ms": 135125,
      "text": "山峰从车窗两边涌过来，",
      "token_start": 448,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 135650,
      "end_ms": 138280,
      "text": "又退到后面去路，",
      "token_start": 458,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 138280,
      "end_ms": 140470,
      "text": "两边的甘蔗田和香蕉林，",
      "token_start": 465,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 140750,
      "end_ms": 141990,
      "text": "春天是绿的，",
      "token_start": 475,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 142070,
      "end_ms": 146775,
      "text": "秋天是黄的云雾从山谷里升起来的时候，",
      "token_start": 480,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 147060,
      "end_ms": 150755,
      "text": "整条路就像飘在云上英国的劲报，",
      "token_start": 497,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 151130,
      "end_ms": 153305,
      "text": "管他叫天堂之路。",
      "token_start": 511,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 154040,
      "end_ms": 154715,
      "text": "您想想，",
      "token_start": 518,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 155100,
      "end_ms": 158240,
      "text": "一条高速被外国人叫天堂，",
      "token_start": 521,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 158740,
      "end_ms": 160200,
      "text": "这风景得多好看。",
      "token_start": 532,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 160380,
      "end_ms": 162005,
      "text": "江西永无蚣路，",
      "token_start": 539,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 162470,
      "end_ms": 167805,
      "text": "在江西九江永修县鄱阳湖上全长五公里多，",
      "token_start": 545,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 168430,
      "end_ms": 171185,
      "text": "这条路最绝的是他会消失。",
      "token_start": 563,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 172310,
      "end_ms": 173690,
      "text": "每年六七月份，",
      "token_start": 574,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 173770,
      "end_ms": 174755,
      "text": "鄱阳湖涨水，",
      "token_start": 580,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 175250,
      "end_ms": 178140,
      "text": "湖水漫过路面最深的时候，",
      "token_start": 585,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 178140,
      "end_ms": 178845,
      "text": "一米多，",
      "token_start": 596,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 179210,
      "end_ms": 181170,
      "text": "整条公路沉到水底，",
      "token_start": 599,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 181170,
      "end_ms": 183185,
      "text": "下车开过去，",
      "token_start": 607,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 183520,
      "end_ms": 185505,
      "text": "水从车轮两边分开，",
      "token_start": 612,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 185920,
      "end_ms": 187295,
      "text": "两边全是湖面。",
      "token_start": 620,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 187570,
      "end_ms": 191715,
      "text": "天连着水水莲的天车就像在水上漂，",
      "token_start": 626,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 192150,
      "end_ms": 195705,
      "text": "所以这条路又叫最美水上公路。",
      "token_start": 641,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 196220,
      "end_ms": 197020,
      "text": "到了十月，",
      "token_start": 654,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 197260,
      "end_ms": 197875,
      "text": "水退了，",
      "token_start": 658,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 198370,
      "end_ms": 199410,
      "text": "公路露出来，",
      "token_start": 661,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 199610,
      "end_ms": 204815,
      "text": "湖底变成草州、白鹤、天鹅、大雁全飞来了。",
      "token_start": 666,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 205270,
      "end_ms": 208385,
      "text": "鄱阳湖是中国最大的淡水湖，",
      "token_start": 682,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 208920,
      "end_ms": 213205,
      "text": "全世界百分之九十八的白鹤都到这儿过冬一条路。",
      "token_start": 694,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 213520,
      "end_ms": 214505,
      "text": "夏天在水里，",
      "token_start": 715,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 214950,
      "end_ms": 217455,
      "text": "冬天在草上天上飞的是鸟，",
      "token_start": 720,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 217750,
      "end_ms": 218815,
      "text": "水里游的是鱼。",
      "token_start": 731,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 219230,
      "end_ms": 221855,
      "text": "您说这是公路还是通到天上去的路？",
      "token_start": 737,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 222160,
      "end_ms": 222800,
      "text": "第七名，",
      "token_start": 752,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 223180,
      "end_ms": 228665,
      "text": "河北草原天路在河北张家口、张北和崇礼交界，",
      "token_start": 755,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 229210,
      "end_ms": 231145,
      "text": "全长一百三十二公里。",
      "token_start": 774,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 231710,
      "end_ms": 234965,
      "text": "这条路最绝的是他修在山脊上，",
      "token_start": 783,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 235380,
      "end_ms": 237180,
      "text": "海拔一千四到一千八，",
      "token_start": 796,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 237420,
      "end_ms": 238985,
      "text": "两边全是草原，",
      "token_start": 805,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 239370,
      "end_ms": 240410,
      "text": "一边是坝上，",
      "token_start": 811,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 240610,
      "end_ms": 241685,
      "text": "一边是坝下。",
      "token_start": 816,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 242390,
      "end_ms": 243935,
      "text": "从车窗看出去，",
      "token_start": 821,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 244200,
      "end_ms": 244685,
      "text": "草坡，",
      "token_start": 827,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 245000,
      "end_ms": 246580,
      "text": "一浪一浪风车，",
      "token_start": 829,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 246720,
      "end_ms": 248410,
      "text": "一座一座梯田，",
      "token_start": 835,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 248590,
      "end_ms": 250535,
      "text": "一层一层桦树林，",
      "token_start": 841,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 250870,
      "end_ms": 251715,
      "text": "一片一片。",
      "token_start": 848,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 252180,
      "end_ms": 254190,
      "text": "夏天二十度凉风，",
      "token_start": 852,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 254190,
      "end_ms": 255655,
      "text": "从车窗灌进来，",
      "token_start": 859,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 256030,
      "end_ms": 257125,
      "text": "满眼都是绿。",
      "token_start": 865,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 257770,
      "end_ms": 261015,
      "text": "秋天麦田金黄跟火烧过一样。",
      "token_start": 870,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 261520,
      "end_ms": 263475,
      "text": "这条路本来是一条乡道，",
      "token_start": 882,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 263830,
      "end_ms": 264610,
      "text": "没人知道，",
      "token_start": 892,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 264850,
      "end_ms": 266395,
      "text": "后来自驾的人来了，",
      "token_start": 896,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 266820,
      "end_ms": 268665,
      "text": "拍了照片发到网上，",
      "token_start": 904,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 269060,
      "end_ms": 271330,
      "text": "一年之内火了一年，",
      "token_start": 912,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 271350,
      "end_ms": 272885,
      "text": "来过五十万辆车，",
      "token_start": 920,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 273320,
      "end_ms": 277360,
      "text": "一条乡道被老百姓捧成了中国六十六号公路，",
      "token_start": 927,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 277440,
      "end_ms": 280800,
      "text": "您说这是路美还是老百姓的眼睛？",
      "token_start": 946,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 280800,
      "end_ms": 281125,
      "text": "毒？",
      "token_start": 960,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 281550,
      "end_ms": 282065,
      "text": "第六名，",
      "token_start": 961,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 282700,
      "end_ms": 288020,
      "text": "新疆塔里木沙漠公路在新疆从轮台到民丰，",
      "token_start": 964,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 288360,
      "end_ms": 290164,
      "text": "全长五百六十六公里。",
      "token_start": 982,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 291670,
      "end_ms": 299375,
      "text": "这条路最绝的是他修在死亡之海里塔克拉玛干沙漠中国最大的沙漠。",
      "token_start": 991,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 299980,
      "end_ms": 303160,
      "text": "世界第二大流动沙漠维吾尔语里，",
      "token_start": 1020,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 303520,
      "end_ms": 307240,
      "text": "塔克拉玛干的意思是进得去出不来，",
      "token_start": 1034,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 307700,
      "end_ms": 310040,
      "text": "这条路就修在这片沙漠上。",
      "token_start": 1049,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 310940,
      "end_ms": 315779,
      "text": "公路两边种了将近两千万株梭梭和洪柳，",
      "token_start": 1060,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 315900,
      "end_ms": 318660,
      "text": "织成了两堵一层楼高的绿墙。",
      "token_start": 1077,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 319260,
      "end_ms": 320280,
      "text": "车在路上走，",
      "token_start": 1089,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 320640,
      "end_ms": 323260,
      "text": "就像在植物砌的滑道里滑行，",
      "token_start": 1094,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 323860,
      "end_ms": 325060,
      "text": "外面是黄沙，",
      "token_start": 1106,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 325300,
      "end_ms": 326260,
      "text": "里面是绿色，",
      "token_start": 1111,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 326660,
      "end_ms": 328240,
      "text": "外面是死亡之海，",
      "token_start": 1116,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 328480,
      "end_ms": 330130,
      "text": "里面是生命之路。",
      "token_start": 1123,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 330670,
      "end_ms": 334250,
      "text": "您说这是路还是跟沙漠打的一场仗？",
      "token_start": 1130,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 334850,
      "end_ms": 336590,
      "text": "从第十到第六，",
      "token_start": 1145,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 336950,
      "end_ms": 337430,
      "text": "郭亮，",
      "token_start": 1151,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 337550,
      "end_ms": 340470,
      "text": "挂壁公路天窗是画框河，",
      "token_start": 1153,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 340530,
      "end_ms": 343370,
      "text": "那高速穿行在枫林里永无公路。",
      "token_start": 1163,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 343370,
      "end_ms": 344370,
      "text": "夏天在水里，",
      "token_start": 1176,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 344770,
      "end_ms": 347110,
      "text": "草原天路被老百姓捧红了，",
      "token_start": 1181,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 347530,
      "end_ms": 350650,
      "text": "塔里木沙漠公路跟死亡之海打了一仗，",
      "token_start": 1192,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 351070,
      "end_ms": 353390,
      "text": "可这五条还不是最美的。",
      "token_start": 1208,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 354570,
      "end_ms": 356330,
      "text": "接下来第五道第一，",
      "token_start": 1218,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 356730,
      "end_ms": 358845,
      "text": "一条比一条震撼，",
      "token_start": 1226,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 359500,
      "end_ms": 362005,
      "text": "有一条路一天能过四个季节，",
      "token_start": 1233,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 362290,
      "end_ms": 363850,
      "text": "有一座桥架，",
      "token_start": 1245,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 363850,
      "end_ms": 366665,
      "text": "在云端上他是哪条，",
      "token_start": 1250,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 367130,
      "end_ms": 369975,
      "text": "他凭什么排第一下集马上更新，",
      "token_start": 1258,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 370970,
      "end_ms": 373250,
      "text": "您先点个关注点，",
      "token_start": 1271,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 373250,
      "end_ms": 375685,
      "text": "开头像别走丢。",
      "token_start": 1278,
      "token_end_exclusive": 1284
    }
  ],
