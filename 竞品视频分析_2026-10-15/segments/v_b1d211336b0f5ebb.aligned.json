  "segments": [
    {
      "start_ms": 70,
      "end_ms": 470,
      "text": "记住，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 770,
      "end_ms": 1610,
      "text": "不要做生意，",
      "token_start": 2,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1730,
      "end_ms": 3110,
      "text": "要做资产生意，",
      "token_start": 7,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3110,
      "end_ms": 4650,
      "text": "做的是利润越做越累，",
      "token_start": 13,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4750,
      "end_ms": 6990,
      "text": "而资产做的是现金流越做越闲。",
      "token_start": 22,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 7170,
      "end_ms": 8550,
      "text": "老板的尽头是收支，",
      "token_start": 35,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 8690,
      "end_ms": 9970,
      "text": "创业的尽头是自由，",
      "token_start": 43,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 10070,
      "end_ms": 11470,
      "text": "要想实现财富自由，",
      "token_start": 51,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 11550,
      "end_ms": 12550,
      "text": "只有三条路径，",
      "token_start": 59,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 12730,
      "end_ms": 13870,
      "text": "要么靠人力杠杆，",
      "token_start": 65,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 13890,
      "end_ms": 15070,
      "text": "让一群人帮你赚钱，",
      "token_start": 72,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 15410,
      "end_ms": 16570,
      "text": "要么靠资本杠杆，",
      "token_start": 80,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 16570,
      "end_ms": 17870,
      "text": "让你的钱自动生钱，",
      "token_start": 87,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 18150,
      "end_ms": 19310,
      "text": "要么靠资产杠杆，",
      "token_start": 95,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 19530,
      "end_ms": 22090,
      "text": "让你手里的动产和不动产收租赚钱。",
      "token_start": 102,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 22090,
      "end_ms": 23030,
      "text": "缺少了这三样，",
      "token_start": 117,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 23190,
      "end_ms": 25290,
      "text": "那你只能用体力和时间来换酬劳，",
      "token_start": 123,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 25530,
      "end_ms": 26850,
      "text": "本质就是拿命换钱。",
      "token_start": 137,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 27110,
      "end_ms": 29130,
      "text": "你以后多看看这本隐形的契约，",
      "token_start": 145,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 29430,
      "end_ms": 32080,
      "text": "很多认知知和赚钱思维都是来源于这本书。",
      "token_start": 158,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 32160,
      "end_ms": 33460,
      "text": "你看这社会多奇怪，",
      "token_start": 176,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 33700,
      "end_ms": 34780,
      "text": "好多人不上班，",
      "token_start": 184,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 34880,
      "end_ms": 36220,
      "text": "但是日子过得挺好，",
      "token_start": 190,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 36280,
      "end_ms": 37180,
      "text": "哪来的钱呢？",
      "token_start": 198,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 37320,
      "end_ms": 38580,
      "text": "有些人天天上班，",
      "token_start": 203,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 38580,
      "end_ms": 39320,
      "text": "反而没有钱。",
      "token_start": 210,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 39560,
      "end_ms": 41300,
      "text": "后来看完这本书才发现，",
      "token_start": 215,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 41540,
      "end_ms": 43280,
      "text": "原来秘密都在这本书里，",
      "token_start": 225,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 43460,
      "end_ms": 45020,
      "text": "叫做隐形的契约。",
      "token_start": 235,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 45160,
      "end_ms": 47160,
      "text": "如果你想了解更多赚钱思路，",
      "token_start": 242,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 47180,
      "end_ms": 48600,
      "text": "那你熬夜要看完这本书，",
      "token_start": 254,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 48840,
      "end_ms": 50340,
      "text": "它就是一本赚钱秘籍。",
      "token_start": 264,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 50640,
      "end_ms": 52380,
      "text": "读完后惊出一身冷汗，",
      "token_start": 273,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 52640,
      "end_ms": 55840,
      "text": "会发现自己以前的思维认知就像被带上了枷锁。",
      "token_start": 282,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 56180,
      "end_ms": 57280,
      "text": "而每翻开一页，",
      "token_start": 302,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 57420,
      "end_ms": 58960,
      "text": "都像是打开了一扇心窗，",
      "token_start": 308,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 59180,
      "end_ms": 60410,
      "text": "勤劳能致不嘛？",
      "token_start": 318,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 60430,
      "end_ms": 63945,
      "text": "外卖小哥凌晨三四点下班也赚不到一万块，",
      "token_start": 324,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 64300,
      "end_ms": 65520,
      "text": "靠打工发不了财。",
      "token_start": 342,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 65700,
      "end_ms": 68905,
      "text": "书中教的全是互利社交的方法和商业法则，",
      "token_start": 349,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 69280,
      "end_ms": 70635,
      "text": "帮你打破社交误区，",
      "token_start": 367,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 70920,
      "end_ms": 72060,
      "text": "拆解关系核心，",
      "token_start": 375,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 72220,
      "end_ms": 73425,
      "text": "掌握相处方法，",
      "token_start": 381,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 73770,
      "end_ms": 75665,
      "text": "讲透社会运行的底层逻辑，",
      "token_start": 387,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 75960,
      "end_ms": 77640,
      "text": "用反向思维思考问题。",
      "token_start": 398,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 77780,
      "end_ms": 78840,
      "text": "这本书拿到以后，",
      "token_start": 407,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 78880,
      "end_ms": 79840,
      "text": "你不管送给谁，",
      "token_start": 414,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 80000,
      "end_ms": 81225,
      "text": "都会感谢你一辈子。",
      "token_start": 420,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 81480,
      "end_ms": 83825,
      "text": "年轻人现在读少走十年冤枉路，",
      "token_start": 428,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 84110,
      "end_ms": 86605,
      "text": "四十岁以后读可能迎来人生巅峰。",
      "token_start": 441,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 86940,
      "end_ms": 89925,
      "text": "所以不管你是三十岁、四十岁还是五十岁，",
      "token_start": 455,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 90270,
      "end_ms": 91470,
      "text": "这本隐形的契约，",
      "token_start": 472,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 91630,
      "end_ms": 94480,
      "text": "你一定要带回去认真看今天这本书，",
      "token_start": 479,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 94480,
      "end_ms": 95635,
      "text": "我放在左下角了。",
      "token_start": 494,
      "token_end_exclusive": 501
    }
  ],
