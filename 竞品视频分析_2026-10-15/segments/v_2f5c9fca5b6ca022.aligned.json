{
  "video_id": "v_2f5c9fca5b6ca022",
  "duration_s": 603.392993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_2f5c9fca5b6ca022.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_2f5c9fca5b6ca022.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 370,
      "end_ms": 750,
      "text": "朱军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1110,
      "end_ms": 1810,
      "text": "你知道吗？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2090,
      "end_ms": 4810,
      "text": "全世界最大的城市就在我们中国，",
      "token_start": 6,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5230,
      "end_ms": 6730,
      "text": "它既做过中国的首都，",
      "token_start": 20,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6830,
      "end_ms": 8289,
      "text": "还做过韩国首都。",
      "token_start": 29,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8550,
      "end_ms": 10990,
      "text": "它相当于五个北京、十三个上海，",
      "token_start": 36,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 10990,
      "end_ms": 12310,
      "text": "四十一个深圳那么大，",
      "token_start": 49,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12810,
      "end_ms": 15290,
      "text": "他是全中国游客最多的旅游城市。",
      "token_start": 58,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 15430,
      "end_ms": 18630,
      "text": "但你知道为什么它的防空洞火锅不让日本人进吗？",
      "token_start": 72,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 19010,
      "end_ms": 20310,
      "text": "今天挑战一口气，",
      "token_start": 93,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 20310,
      "end_ms": 22270,
      "text": "带你走进山城重庆，",
      "token_start": 100,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 22670,
      "end_ms": 25270,
      "text": "致敬江湖儿女三峡好人，",
      "token_start": 108,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 25710,
      "end_ms": 26410,
      "text": "你知道吗？",
      "token_start": 118,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 26430,
      "end_ms": 28710,
      "text": "我在美国参观联合国总部的时候，",
      "token_start": 122,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 28710,
      "end_ms": 32000,
      "text": "发现世界地图上中国只标注了四个城市。",
      "token_start": 136,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 32240,
      "end_ms": 35060,
      "text": "除了北京、上海、香港只有重庆，",
      "token_start": 153,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 35420,
      "end_ms": 36780,
      "text": "这重庆二十多年，",
      "token_start": 165,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 36780,
      "end_ms": 38420,
      "text": "经济翻了整整十二倍，",
      "token_start": 172,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 38460,
      "end_ms": 40920,
      "text": "是地球上发展速度最快的城市之一。",
      "token_start": 181,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 41080,
      "end_ms": 43200,
      "text": "但是中国有钱的城市多了，",
      "token_start": 196,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 43380,
      "end_ms": 45240,
      "text": "深圳、杭州哪个不富啊？",
      "token_start": 207,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 45320,
      "end_ms": 47640,
      "text": "那为什么联合国偏偏这么重视重庆，",
      "token_start": 216,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 47800,
      "end_ms": 51180,
      "text": "把它单独标注出来的那是因为在抗战期间，",
      "token_start": 231,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 51180,
      "end_ms": 52960,
      "text": "日本能够占领大半个中国，",
      "token_start": 249,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 52960,
      "end_ms": 54640,
      "text": "却唯独打不到重庆。",
      "token_start": 260,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 55000,
      "end_ms": 55380,
      "text": "那时，",
      "token_start": 268,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 55380,
      "end_ms": 56920,
      "text": "重庆作为战时首都，",
      "token_start": 270,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 57020,
      "end_ms": 60110,
      "text": "承受日军长达六年十个多月的疯狂轰炸，",
      "token_start": 278,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 60660,
      "end_ms": 61820,
      "text": "九千多架飞机，",
      "token_start": 295,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 61820,
      "end_ms": 62860,
      "text": "上万枚炸弹，",
      "token_start": 301,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 62980,
      "end_ms": 65725,
      "text": "三万两千八百二十九名同胞的生命。",
      "token_start": 306,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 65990,
      "end_ms": 67650,
      "text": "日本甚至还进行了精密计算，",
      "token_start": 321,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 67790,
      "end_ms": 68470,
      "text": "一颗导弹，",
      "token_start": 333,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 68490,
      "end_ms": 70335,
      "text": "能够炸死五点五个重庆人。",
      "token_start": 337,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 70780,
      "end_ms": 73560,
      "text": "但是山城人民应是挺直腰杆。",
      "token_start": 348,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 73560,
      "end_ms": 74100,
      "text": "不投降，",
      "token_start": 360,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 74220,
      "end_ms": 76360,
      "text": "徒手挖出了一千八百多个防空洞，",
      "token_start": 363,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 76640,
      "end_ms": 78080,
      "text": "上面顶着日寇的轰炸，",
      "token_start": 377,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 78160,
      "end_ms": 80740,
      "text": "下面日夜不停的拼命生产铲出了。",
      "token_start": 386,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 80740,
      "end_ms": 81480,
      "text": "抗战时期，",
      "token_start": 400,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 81480,
      "end_ms": 86420,
      "text": "全国百分之八十以上的军工品、爱国实业家卢作福赌上全部身家，",
      "token_start": 404,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 86600,
      "end_ms": 91850,
      "text": "带领民生公司所有船只和员工从水路抢运物资只用了四十天，",
      "token_start": 431,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 91990,
      "end_ms": 94755,
      "text": "就将二十万吨的物资搬运到重庆。",
      "token_start": 457,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 95310,
      "end_ms": 96930,
      "text": "连美国总统罗斯福都说，",
      "token_start": 471,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 97130,
      "end_ms": 99710,
      "text": "重庆和华盛顿、莫斯科、伦敦一样，",
      "token_start": 481,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 99770,
      "end_ms": 102535,
      "text": "是世界反法西斯的四大指挥中枢。",
      "token_start": 494,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 103050,
      "end_ms": 104910,
      "text": "一九四五年联合国成立的时候，",
      "token_start": 508,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 104930,
      "end_ms": 108075,
      "text": "重庆就成为中国提交了四座代表城市之一。",
      "token_start": 521,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 108500,
      "end_ms": 108900,
      "text": "朱军，",
      "token_start": 539,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 108980,
      "end_ms": 110905,
      "text": "你看我身后的重庆山多吧。",
      "token_start": 541,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 111300,
      "end_ms": 112240,
      "text": "二十世纪初，",
      "token_start": 552,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 112240,
      "end_ms": 115124,
      "text": "美国学者费正清从飞机俯瞰重庆时说，",
      "token_start": 557,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 115490,
      "end_ms": 117190,
      "text": "此地并不适合人类居住，",
      "token_start": 573,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 117250,
      "end_ms": 118795,
      "text": "因为没有平坦的陆地。",
      "token_start": 583,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 119140,
      "end_ms": 122365,
      "text": "重庆的山地丘陵比例高达百分之九十三点六。",
      "token_start": 592,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 122700,
      "end_ms": 122940,
      "text": "然而，",
      "token_start": 611,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 122940,
      "end_ms": 126000,
      "text": "现在重庆却变成了世界人口最多的城市，",
      "token_start": 613,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 126140,
      "end_ms": 128735,
      "text": "据说还是全国美女最多的城市。",
      "token_start": 630,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 129060,
      "end_ms": 130640,
      "text": "重庆人口三千两百多万，",
      "token_start": 643,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 130640,
      "end_ms": 133065,
      "text": "是我国唯一超三千万的超大城市。",
      "token_start": 653,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 133500,
      "end_ms": 134240,
      "text": "一九九七年，",
      "token_start": 667,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 134240,
      "end_ms": 136635,
      "text": "重庆成为了中国中西部唯一的直辖市，",
      "token_start": 672,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 136850,
      "end_ms": 139045,
      "text": "是全中国最大、最年轻的直辖市。",
      "token_start": 688,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 139470,
      "end_ms": 140670,
      "text": "重庆到底有多强？",
      "token_start": 701,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 140790,
      "end_ms": 142155,
      "text": " Gdp全国第四，",
      "token_start": 708,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 142470,
      "end_ms": 144030,
      "text": "全国四十一个工业大类，",
      "token_start": 713,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 144130,
      "end_ms": 146720,
      "text": "重庆占了三十九个汽车产量，",
      "token_start": 723,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 146760,
      "end_ms": 148680,
      "text": "摩托车产量都是全国第一，",
      "token_start": 735,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 148900,
      "end_ms": 152055,
      "text": "重庆还是全球最大的笔记本电脑生产基地。",
      "token_start": 746,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 152450,
      "end_ms": 152830,
      "text": "如今，",
      "token_start": 764,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 152950,
      "end_ms": 154450,
      "text": "中国最反骨的城市，",
      "token_start": 766,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 154450,
      "end_ms": 155615,
      "text": "重庆赶称第二，",
      "token_start": 774,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 155860,
      "end_ms": 156900,
      "text": "没人敢称第一。",
      "token_start": 780,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 156980,
      "end_ms": 158985,
      "text": "你看这是重庆的波浪路，",
      "token_start": 786,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 159330,
      "end_ms": 160430,
      "text": "这是重庆的一楼，",
      "token_start": 796,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 160710,
      "end_ms": 165235,
      "text": "实际上你是在二十二楼重庆市国际公认的基建天花板，",
      "token_start": 803,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 165530,
      "end_ms": 168245,
      "text": "八d魔幻立交楼里跑轻轨。",
      "token_start": 826,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 168560,
      "end_ms": 172500,
      "text": "这里全国最深的地铁站红岩村站深埋一百一十六米，",
      "token_start": 837,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 172580,
      "end_ms": 174025,
      "text": "堪比四十层高楼。",
      "token_start": 859,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 174490,
      "end_ms": 176870,
      "text": "重庆是全中国桥梁最多的地方，",
      "token_start": 866,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 176950,
      "end_ms": 179130,
      "text": "有各类桥梁一点四万多座，",
      "token_start": 879,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 179310,
      "end_ms": 181090,
      "text": "跨江特大桥一百零五座，",
      "token_start": 890,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 181210,
      "end_ms": 182315,
      "text": "数量全国第一。",
      "token_start": 900,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 182560,
      "end_ms": 184200,
      "text": "重庆拥有五座机场，",
      "token_start": 906,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 184320,
      "end_ms": 186524,
      "text": "是我国民航机场数量最多的城市，",
      "token_start": 914,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 186890,
      "end_ms": 190285,
      "text": "这也是唯一一个国外比国内更火爆的城市。",
      "token_start": 928,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 190530,
      "end_ms": 191285,
      "text": "老外们都说，",
      "token_start": 946,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 191520,
      "end_ms": 195065,
      "text": "重庆是人生必须打卡的赛博朋克之城。",
      "token_start": 951,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 195410,
      "end_ms": 198795,
      "text": "我在重庆的机场发现外国人真的比中国人还要多，",
      "token_start": 967,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 199120,
      "end_ms": 199820,
      "text": "你能想象吗？",
      "token_start": 988,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 199820,
      "end_ms": 200880,
      "text": "在一九三八年，",
      "token_start": 993,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 201020,
      "end_ms": 202600,
      "text": "韩国流亡政府到重庆，",
      "token_start": 999,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 202620,
      "end_ms": 204165,
      "text": "建立了他们的临时首都，",
      "token_start": 1008,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 204460,
      "end_ms": 207555,
      "text": "连韩国光复军的成立典礼都是在重庆举行的。",
      "token_start": 1018,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 207790,
      "end_ms": 212205,
      "text": "所以每一年清明节都会有大量的韩国人到重庆的名玉真墓来祭祖。",
      "token_start": 1037,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 212490,
      "end_ms": 213350,
      "text": "因为在历史上，",
      "token_start": 1065,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 213490,
      "end_ms": 215795,
      "text": "闵玉珍在重庆建立了大夏国，",
      "token_start": 1071,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 216060,
      "end_ms": 218080,
      "text": "后来大夏国归降于朱元璋，",
      "token_start": 1083,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 218280,
      "end_ms": 220860,
      "text": "而明玉珍那些后人则被贬到了高丽国。",
      "token_start": 1094,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 221000,
      "end_ms": 221640,
      "text": "也就是说，",
      "token_start": 1110,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 221760,
      "end_ms": 224855,
      "text": "现在很多韩国人其实都是明玉珍的后代。",
      "token_start": 1114,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 225510,
      "end_ms": 228630,
      "text": "周军都知道韩国人吃不起的西瓜太贵，",
      "token_start": 1131,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 228910,
      "end_ms": 232665,
      "text": "但是我在重庆的西南大学遇见了一位九十七岁的老奶奶，",
      "token_start": 1147,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 232940,
      "end_ms": 234920,
      "text": "他让中国人实现了吃瓜自由。",
      "token_start": 1171,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 235180,
      "end_ms": 239230,
      "text": "他培育出了八四二四麒麟瓜皇后、哈密瓜、绿宝石瓜等等，",
      "token_start": 1183,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 239310,
      "end_ms": 241045,
      "text": "他就是无名著院士，",
      "token_start": 1206,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 241400,
      "end_ms": 242720,
      "text": "他是袁隆平的同学，",
      "token_start": 1214,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 242940,
      "end_ms": 244285,
      "text": "中国西瓜之母，",
      "token_start": 1222,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 244500,
      "end_ms": 245920,
      "text": "但他却因为阿尔兹海默症，",
      "token_start": 1228,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 246100,
      "end_ms": 247520,
      "text": "忘记了亲人的名字，",
      "token_start": 1239,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 247600,
      "end_ms": 249715,
      "text": "忘记了自己一生伟大的贡献。",
      "token_start": 1247,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 250110,
      "end_ms": 254445,
      "text": "这里是全中国最大的抗日空军阵亡将士实葬墓地。",
      "token_start": 1259,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 254810,
      "end_ms": 256990,
      "text": "他们是中国最壮烈的一群富二代，",
      "token_start": 1280,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 257130,
      "end_ms": 258970,
      "text": "诠是帅气的世家子弟，",
      "token_start": 1294,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 259090,
      "end_ms": 261810,
      "text": "牺牲时平均年龄仅仅二十三岁，",
      "token_start": 1303,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 261970,
      "end_ms": 263545,
      "text": "一生最灿烂的年华。",
      "token_start": 1316,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 263870,
      "end_ms": 265595,
      "text": "他们是中国第一代飞行员。",
      "token_start": 1324,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 265880,
      "end_ms": 267180,
      "text": "从毕业到牺牲，",
      "token_start": 1335,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 267420,
      "end_ms": 268145,
      "text": "只有半年，",
      "token_start": 1341,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 268580,
      "end_ms": 272375,
      "text": "这里安眠着驾机撞上敌机同归于尽的陈怀民，",
      "token_start": 1345,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 272800,
      "end_ms": 273575,
      "text": "放弃跳伞，",
      "token_start": 1364,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 273770,
      "end_ms": 276515,
      "text": "驾机直撞日寇军舰的沈崇慧，",
      "token_start": 1368,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 276850,
      "end_ms": 278870,
      "text": "连日本人都敬佩的闫海文。",
      "token_start": 1380,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 279030,
      "end_ms": 279630,
      "text": "牺牲前，",
      "token_start": 1391,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 279630,
      "end_ms": 280345,
      "text": "他嘶吼着，",
      "token_start": 1394,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 280540,
      "end_ms": 282255,
      "text": "中国没有被俘空军。",
      "token_start": 1398,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 282660,
      "end_ms": 283220,
      "text": "在重庆，",
      "token_start": 1406,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 283220,
      "end_ms": 285120,
      "text": "你可以看到一串很特殊的地名，",
      "token_start": 1409,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 285240,
      "end_ms": 289425,
      "text": "分别称之为四公里、五公里、七公里、八公里、九公里等等。",
      "token_start": 1422,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 289840,
      "end_ms": 290980,
      "text": "当年抗战时期，",
      "token_start": 1444,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 291000,
      "end_ms": 292825,
      "text": "民国政府不得不内迁重庆。",
      "token_start": 1450,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 293080,
      "end_ms": 293340,
      "text": "后来，",
      "token_start": 1461,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 293340,
      "end_ms": 295020,
      "text": "日本宣布封锁中国沿海，",
      "token_start": 1463,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 295120,
      "end_ms": 297105,
      "text": "阻止一切圆华物资进入中国。",
      "token_start": 1473,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 297430,
      "end_ms": 299350,
      "text": "就在这生死存亡的关键时刻，",
      "token_start": 1485,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 299350,
      "end_ms": 301365,
      "text": "当务之急必须修建一条。",
      "token_start": 1497,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 301630,
      "end_ms": 304830,
      "text": "通往外界的公路以够大后方的军事补给，",
      "token_start": 1507,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 304970,
      "end_ms": 307890,
      "text": "于是便开始修建滇缅公路物资。",
      "token_start": 1524,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 307890,
      "end_ms": 309450,
      "text": "从滇缅运往昆明之后，",
      "token_start": 1537,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 309450,
      "end_ms": 311470,
      "text": "过贵州二十四拐抵达贵阳，",
      "token_start": 1546,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 311570,
      "end_ms": 312970,
      "text": "再走川黔公路，",
      "token_start": 1557,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 313090,
      "end_ms": 315430,
      "text": "它的终点就是重庆的海棠新码头。",
      "token_start": 1563,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 315590,
      "end_ms": 317629,
      "text": "在源源不断的送往抗战前线，",
      "token_start": 1577,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 317970,
      "end_ms": 320930,
      "text": "九公里八公里、六公里三公里，",
      "token_start": 1589,
      "token_end_exclusive": 1601
    },
    {
      "start_ms": 321030,
      "end_ms": 321950,
      "text": "不只是地名，",
      "token_start": 1601,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 322010,
      "end_ms": 324510,
      "text": "更是物资抵达终点的倒计时。",
      "token_start": 1606,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 324890,
      "end_ms": 327630,
      "text": "朱军重庆是一座英雄的城市，",
      "token_start": 1618,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 327830,
      "end_ms": 330030,
      "text": "重庆人民是英雄的人民。",
      "token_start": 1630,
      "token_end_exclusive": 1640
    },
    {
      "start_ms": 330290,
      "end_ms": 332860,
      "text": "我的爷爷当年在抗美援朝的战友，",
      "token_start": 1640,
      "token_end_exclusive": 1654
    },
    {
      "start_ms": 332900,
      "end_ms": 334840,
      "text": "邱少云就是重庆人。",
      "token_start": 1654,
      "token_end_exclusive": 1662
    },
    {
      "start_ms": 335020,
      "end_ms": 336220,
      "text": "在抗战烽火中，",
      "token_start": 1662,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 336300,
      "end_ms": 339220,
      "text": "中国一大批的文人学者逆行奔赴重庆。",
      "token_start": 1668,
      "token_end_exclusive": 1684
    },
    {
      "start_ms": 339500,
      "end_ms": 341660,
      "text": "老舍先生在这里创作四世同堂。",
      "token_start": 1684,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 341900,
      "end_ms": 345260,
      "text": "梁实修创作雅社小品矛盾在这里写下，",
      "token_start": 1697,
      "token_end_exclusive": 1713
    },
    {
      "start_ms": 345280,
      "end_ms": 351180,
      "text": "白杨李赞还有文理大师、顾玉秀、地质学家、李四光、国歌的词作者、田汉等等，",
      "token_start": 1713,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 351340,
      "end_ms": 353560,
      "text": "都在重庆投身抗战文艺，",
      "token_start": 1743,
      "token_end_exclusive": 1753
    },
    {
      "start_ms": 353620,
      "end_ms": 355540,
      "text": "号召全民族抗日救亡。",
      "token_start": 1753,
      "token_end_exclusive": 1762
    },
    {
      "start_ms": 355900,
      "end_ms": 356260,
      "text": "当时，",
      "token_start": 1762,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 356260,
      "end_ms": 360580,
      "text": "全中国的政治、军事、经济、文化中心都搬到了重庆，",
      "token_start": 1764,
      "token_end_exclusive": 1784
    },
    {
      "start_ms": 360860,
      "end_ms": 361850,
      "text": "一座山城，",
      "token_start": 1784,
      "token_end_exclusive": 1788
    },
    {
      "start_ms": 361950,
      "end_ms": 364305,
      "text": "愣是成为了中国的诺亚方舟。",
      "token_start": 1788,
      "token_end_exclusive": 1800
    },
    {
      "start_ms": 364630,
      "end_ms": 365450,
      "text": "而今天的重庆，",
      "token_start": 1800,
      "token_end_exclusive": 1806
    },
    {
      "start_ms": 365450,
      "end_ms": 368205,
      "text": "更是一座把人文关怀做到极致的城市。",
      "token_start": 1806,
      "token_end_exclusive": 1822
    },
    {
      "start_ms": 368560,
      "end_ms": 370725,
      "text": "重庆四号线连接着城区和郊区，",
      "token_start": 1822,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 371100,
      "end_ms": 374265,
      "text": "每天清晨都有许多老人背着背篓进城卖菜。",
      "token_start": 1835,
      "token_end_exclusive": 1853
    },
    {
      "start_ms": 374620,
      "end_ms": 375540,
      "text": "曾经有网友建议，",
      "token_start": 1853,
      "token_end_exclusive": 1860
    },
    {
      "start_ms": 375540,
      "end_ms": 377940,
      "text": "高峰时段应该禁止乘客携带背篓，",
      "token_start": 1860,
      "token_end_exclusive": 1874
    },
    {
      "start_ms": 378020,
      "end_ms": 378780,
      "text": "影响市容。",
      "token_start": 1874,
      "token_end_exclusive": 1878
    },
    {
      "start_ms": 378920,
      "end_ms": 380795,
      "text": "但重庆官方霸气回应，",
      "token_start": 1878,
      "token_end_exclusive": 1887
    },
    {
      "start_ms": 381180,
      "end_ms": 383040,
      "text": "我们的地铁容得下公文包，",
      "token_start": 1887,
      "token_end_exclusive": 1898
    },
    {
      "start_ms": 383100,
      "end_ms": 384305,
      "text": "也容得下飞龙。",
      "token_start": 1898,
      "token_end_exclusive": 1904
    },
    {
      "start_ms": 384700,
      "end_ms": 386800,
      "text": "考虑到不少老人听不懂普通话这条线，",
      "token_start": 1904,
      "token_end_exclusive": 1920
    },
    {
      "start_ms": 386800,
      "end_ms": 388705,
      "text": "还特意增设了方言爆站。",
      "token_start": 1920,
      "token_end_exclusive": 1930
    },
    {
      "start_ms": 389190,
      "end_ms": 390690,
      "text": "如今在重庆的长江上，",
      "token_start": 1930,
      "token_end_exclusive": 1939
    },
    {
      "start_ms": 390690,
      "end_ms": 391770,
      "text": "还有一条亏本了，",
      "token_start": 1939,
      "token_end_exclusive": 1946
    },
    {
      "start_ms": 391770,
      "end_ms": 392985,
      "text": "十几年的船只，",
      "token_start": 1946,
      "token_end_exclusive": 1952
    },
    {
      "start_ms": 393380,
      "end_ms": 396025,
      "text": "乘客全是背着背篓的卖菜老人。",
      "token_start": 1952,
      "token_end_exclusive": 1965
    },
    {
      "start_ms": 396380,
      "end_ms": 397900,
      "text": "大多数老人不会使用微信，",
      "token_start": 1965,
      "token_end_exclusive": 1976
    },
    {
      "start_ms": 398020,
      "end_ms": 400705,
      "text": "还在保持着原始的手撕票据的方式。",
      "token_start": 1976,
      "token_end_exclusive": 1991
    },
    {
      "start_ms": 401080,
      "end_ms": 402160,
      "text": "航线在长江上，",
      "token_start": 1991,
      "token_end_exclusive": 1997
    },
    {
      "start_ms": 402160,
      "end_ms": 403105,
      "text": "经过六个站点，",
      "token_start": 1997,
      "token_end_exclusive": 2003
    },
    {
      "start_ms": 403400,
      "end_ms": 404000,
      "text": "十多年，",
      "token_start": 2003,
      "token_end_exclusive": 2006
    },
    {
      "start_ms": 404100,
      "end_ms": 404855,
      "text": "从未涨价，",
      "token_start": 2006,
      "token_end_exclusive": 2010
    },
    {
      "start_ms": 405130,
      "end_ms": 406215,
      "text": "还有免费的早餐，",
      "token_start": 2010,
      "token_end_exclusive": 2017
    },
    {
      "start_ms": 406500,
      "end_ms": 408705,
      "text": "时代的发展并没有把他们落下。",
      "token_start": 2017,
      "token_end_exclusive": 2030
    },
    {
      "start_ms": 409160,
      "end_ms": 410380,
      "text": "周军在重庆，",
      "token_start": 2030,
      "token_end_exclusive": 2035
    },
    {
      "start_ms": 410380,
      "end_ms": 414325,
      "text": "我见过一座最令人泪目的博物馆、三峡水下博物馆。",
      "token_start": 2035,
      "token_end_exclusive": 2056
    },
    {
      "start_ms": 414650,
      "end_ms": 416395,
      "text": "这里收藏的不是冰冷的器物，",
      "token_start": 2056,
      "token_end_exclusive": 2068
    },
    {
      "start_ms": 416610,
      "end_ms": 419195,
      "text": "而是三峡人民再也回不去的故乡。",
      "token_start": 2068,
      "token_end_exclusive": 2082
    },
    {
      "start_ms": 419730,
      "end_ms": 423245,
      "text": "你见过这位在背上背了一整棵桃花树的男人吗？",
      "token_start": 2082,
      "token_end_exclusive": 2102
    },
    {
      "start_ms": 423580,
      "end_ms": 424025,
      "text": "当年，",
      "token_start": 2102,
      "token_end_exclusive": 2104
    },
    {
      "start_ms": 424130,
      "end_ms": 426350,
      "text": "他被告知要立刻搬离故乡，",
      "token_start": 2104,
      "token_end_exclusive": 2115
    },
    {
      "start_ms": 426770,
      "end_ms": 428035,
      "text": "永远不可能再回来。",
      "token_start": 2115,
      "token_end_exclusive": 2123
    },
    {
      "start_ms": 428520,
      "end_ms": 429960,
      "text": "他搬走全部家当之后，",
      "token_start": 2123,
      "token_end_exclusive": 2132
    },
    {
      "start_ms": 430060,
      "end_ms": 432080,
      "text": "驮起了一棵正在盛放的桃树，",
      "token_start": 2132,
      "token_end_exclusive": 2144
    },
    {
      "start_ms": 432260,
      "end_ms": 434525,
      "text": "最后一次带走故乡的春天。",
      "token_start": 2144,
      "token_end_exclusive": 2155
    },
    {
      "start_ms": 434910,
      "end_ms": 436590,
      "text": "而他的家乡不久之后，",
      "token_start": 2155,
      "token_end_exclusive": 2164
    },
    {
      "start_ms": 436730,
      "end_ms": 438795,
      "text": "将被江水彻底吞没。",
      "token_start": 2164,
      "token_end_exclusive": 2172
    },
    {
      "start_ms": 439310,
      "end_ms": 441230,
      "text": "这就是二十世纪最伟大的工程，",
      "token_start": 2172,
      "token_end_exclusive": 2185
    },
    {
      "start_ms": 441230,
      "end_ms": 443565,
      "text": "背后一个平凡的不能再平凡的故事。",
      "token_start": 2185,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 444180,
      "end_ms": 445040,
      "text": "二零零二年，",
      "token_start": 2200,
      "token_end_exclusive": 2205
    },
    {
      "start_ms": 445040,
      "end_ms": 448060,
      "text": "感动中国人物把一座特别的奖杯颁给了，",
      "token_start": 2205,
      "token_end_exclusive": 2222
    },
    {
      "start_ms": 448060,
      "end_ms": 449040,
      "text": "一百三十多万。",
      "token_start": 2222,
      "token_end_exclusive": 2228
    },
    {
      "start_ms": 449140,
      "end_ms": 451820,
      "text": "像他一样背着桃花树离乡的人，",
      "token_start": 2228,
      "token_end_exclusive": 2241
    },
    {
      "start_ms": 451880,
      "end_ms": 455460,
      "text": "他们共同的身份叫三峡一民无数。",
      "token_start": 2241,
      "token_end_exclusive": 2255
    },
    {
      "start_ms": 455560,
      "end_ms": 458575,
      "text": "重庆、湖北儿女离开了生于丝，",
      "token_start": 2255,
      "token_end_exclusive": 2267
    },
    {
      "start_ms": 458810,
      "end_ms": 459835,
      "text": "长于司的故土。",
      "token_start": 2267,
      "token_end_exclusive": 2273
    },
    {
      "start_ms": 460260,
      "end_ms": 460820,
      "text": "而现在，",
      "token_start": 2273,
      "token_end_exclusive": 2276
    },
    {
      "start_ms": 460900,
      "end_ms": 463540,
      "text": "全中国最敢花钱消费的城市在哪里？",
      "token_start": 2276,
      "token_end_exclusive": 2291
    },
    {
      "start_ms": 463760,
      "end_ms": 465375,
      "text": "答案可能出乎你的意料，",
      "token_start": 2291,
      "token_end_exclusive": 2301
    },
    {
      "start_ms": 465660,
      "end_ms": 466560,
      "text": "不是北上广深，",
      "token_start": 2301,
      "token_end_exclusive": 2307
    },
    {
      "start_ms": 466620,
      "end_ms": 468960,
      "text": "而是重庆二零二五年。",
      "token_start": 2307,
      "token_end_exclusive": 2316
    },
    {
      "start_ms": 468960,
      "end_ms": 470360,
      "text": "社会消费品零售数据，",
      "token_start": 2316,
      "token_end_exclusive": 2325
    },
    {
      "start_ms": 470420,
      "end_ms": 471940,
      "text": "重庆直接干掉上海，",
      "token_start": 2325,
      "token_end_exclusive": 2333
    },
    {
      "start_ms": 472040,
      "end_ms": 473345,
      "text": "登顶全国第一。",
      "token_start": 2333,
      "token_end_exclusive": 2339
    },
    {
      "start_ms": 473620,
      "end_ms": 476175,
      "text": "重庆一年就要吃掉一百二十亿吨火锅，",
      "token_start": 2339,
      "token_end_exclusive": 2355
    },
    {
      "start_ms": 476490,
      "end_ms": 478815,
      "text": "每天要吃掉五百万碗小面。",
      "token_start": 2355,
      "token_end_exclusive": 2366
    },
    {
      "start_ms": 479270,
      "end_ms": 482090,
      "text": "如果说北上广深是中国经济的排头兵，",
      "token_start": 2366,
      "token_end_exclusive": 2382
    },
    {
      "start_ms": 482170,
      "end_ms": 485645,
      "text": "那么川渝地区就是中国城市的幸福样板。",
      "token_start": 2382,
      "token_end_exclusive": 2399
    },
    {
      "start_ms": 486390,
      "end_ms": 491140,
      "text": "今天的重庆五a级景区有十二个有着世界自然遗产天坑地缝，",
      "token_start": 2399,
      "token_end_exclusive": 2425
    },
    {
      "start_ms": 491300,
      "end_ms": 493155,
      "text": "世界上著名的长江三峡，",
      "token_start": 2425,
      "token_end_exclusive": 2435
    },
    {
      "start_ms": 493500,
      "end_ms": 496595,
      "text": "世界上最大规模的磨牙石刻大足石刻，",
      "token_start": 2435,
      "token_end_exclusive": 2451
    },
    {
      "start_ms": 496900,
      "end_ms": 498945,
      "text": "全球三大溶洞之一的芙蓉洞，",
      "token_start": 2451,
      "token_end_exclusive": 2463
    },
    {
      "start_ms": 499190,
      "end_ms": 501865,
      "text": "还有现实版的千与千寻、洪崖洞，",
      "token_start": 2463,
      "token_end_exclusive": 2476
    },
    {
      "start_ms": 502250,
      "end_ms": 505430,
      "text": "它又是世界温泉之都世界六大雾都之一，",
      "token_start": 2476,
      "token_end_exclusive": 2493
    },
    {
      "start_ms": 505550,
      "end_ms": 507805,
      "text": "更是世界上最宠粉的城市。",
      "token_start": 2493,
      "token_end_exclusive": 2504
    },
    {
      "start_ms": 508260,
      "end_ms": 510600,
      "text": "尽管年平均雾日多达一百零四天，",
      "token_start": 2504,
      "token_end_exclusive": 2518
    },
    {
      "start_ms": 510760,
      "end_ms": 512075,
      "text": "但无数人都坦言，",
      "token_start": 2518,
      "token_end_exclusive": 2525
    },
    {
      "start_ms": 512460,
      "end_ms": 513260,
      "text": "离开重庆，",
      "token_start": 2525,
      "token_end_exclusive": 2529
    },
    {
      "start_ms": 513340,
      "end_ms": 515380,
      "text": "就像一场猝不及防的失恋，",
      "token_start": 2529,
      "token_end_exclusive": 2540
    },
    {
      "start_ms": 515640,
      "end_ms": 516915,
      "text": "满心都是牵挂。",
      "token_start": 2540,
      "token_end_exclusive": 2546
    },
    {
      "start_ms": 517310,
      "end_ms": 519305,
      "text": "长江与嘉陵江再次交汇，",
      "token_start": 2546,
      "token_end_exclusive": 2556
    },
    {
      "start_ms": 519560,
      "end_ms": 522125,
      "text": "滋养出一座山水相依的魅力之城。",
      "token_start": 2556,
      "token_end_exclusive": 2570
    },
    {
      "start_ms": 522480,
      "end_ms": 524540,
      "text": "这里是红岩精神的孕育之地，",
      "token_start": 2570,
      "token_end_exclusive": 2582
    },
    {
      "start_ms": 524600,
      "end_ms": 526440,
      "text": "也是巴渝文化的发祥地。",
      "token_start": 2582,
      "token_end_exclusive": 2592
    },
    {
      "start_ms": 526680,
      "end_ms": 527700,
      "text": "每当夜幕降临，",
      "token_start": 2592,
      "token_end_exclusive": 2598
    },
    {
      "start_ms": 527880,
      "end_ms": 529480,
      "text": "洪崖洞亮灯的瞬间，",
      "token_start": 2598,
      "token_end_exclusive": 2606
    },
    {
      "start_ms": 529660,
      "end_ms": 530765,
      "text": "灯火璀璨。",
      "token_start": 2606,
      "token_end_exclusive": 2610
    },
    {
      "start_ms": 531150,
      "end_ms": 533730,
      "text": "凤姐与巫山交界处的瞿塘峡，",
      "token_start": 2610,
      "token_end_exclusive": 2622
    },
    {
      "start_ms": 533850,
      "end_ms": 539100,
      "text": "是三峡中最短却最雄奇的一段两岸苍山被长江劈开，",
      "token_start": 2622,
      "token_end_exclusive": 2644
    },
    {
      "start_ms": 539240,
      "end_ms": 541125,
      "text": "形成天造地设的夔门，",
      "token_start": 2644,
      "token_end_exclusive": 2653
    },
    {
      "start_ms": 541430,
      "end_ms": 543690,
      "text": "这就是十元钱人民币背面的图案。",
      "token_start": 2653,
      "token_end_exclusive": 2667
    },
    {
      "start_ms": 544050,
      "end_ms": 544830,
      "text": "三国时期，",
      "token_start": 2667,
      "token_end_exclusive": 2671
    },
    {
      "start_ms": 544930,
      "end_ms": 548250,
      "text": "刘备托孤诸葛亮的故事就发生在白帝城。",
      "token_start": 2671,
      "token_end_exclusive": 2688
    },
    {
      "start_ms": 548830,
      "end_ms": 550570,
      "text": "朝辞白帝彩云间，",
      "token_start": 2688,
      "token_end_exclusive": 2695
    },
    {
      "start_ms": 550750,
      "end_ms": 552250,
      "text": "千里江陵一日还。",
      "token_start": 2695,
      "token_end_exclusive": 2702
    },
    {
      "start_ms": 552450,
      "end_ms": 553030,
      "text": "来重庆，",
      "token_start": 2702,
      "token_end_exclusive": 2705
    },
    {
      "start_ms": 553230,
      "end_ms": 554610,
      "text": "一定要现场感受一下，",
      "token_start": 2705,
      "token_end_exclusive": 2714
    },
    {
      "start_ms": 554850,
      "end_ms": 556810,
      "text": "轻舟已过万重山，",
      "token_start": 2714,
      "token_end_exclusive": 2721
    },
    {
      "start_ms": 557130,
      "end_ms": 559370,
      "text": "感受大自然鬼斧神工的震撼。",
      "token_start": 2721,
      "token_end_exclusive": 2733
    },
    {
      "start_ms": 559730,
      "end_ms": 561290,
      "text": "而在重庆的大山深处，",
      "token_start": 2733,
      "token_end_exclusive": 2742
    },
    {
      "start_ms": 561450,
      "end_ms": 564330,
      "text": "还有一颗三千多岁的金丝楠木王。",
      "token_start": 2742,
      "token_end_exclusive": 2756
    },
    {
      "start_ms": 564670,
      "end_ms": 565510,
      "text": "更神奇的是，",
      "token_start": 2756,
      "token_end_exclusive": 2761
    },
    {
      "start_ms": 565550,
      "end_ms": 567210,
      "text": "他还是一颗雷击木，",
      "token_start": 2761,
      "token_end_exclusive": 2769
    },
    {
      "start_ms": 567310,
      "end_ms": 568430,
      "text": "被大火烧之后，",
      "token_start": 2769,
      "token_end_exclusive": 2775
    },
    {
      "start_ms": 568430,
      "end_ms": 569790,
      "text": "竟然枯木逢春，",
      "token_start": 2775,
      "token_end_exclusive": 2781
    },
    {
      "start_ms": 569930,
      "end_ms": 572340,
      "text": "被当地村民称之为长生树。",
      "token_start": 2781,
      "token_end_exclusive": 2792
    },
    {
      "start_ms": 572420,
      "end_ms": 574000,
      "text": "据说能够看上一眼，",
      "token_start": 2792,
      "token_end_exclusive": 2800
    },
    {
      "start_ms": 574080,
      "end_ms": 575560,
      "text": "都是有福之人。",
      "token_start": 2800,
      "token_end_exclusive": 2806
    },
    {
      "start_ms": 575940,
      "end_ms": 576340,
      "text": "朱君，",
      "token_start": 2806,
      "token_end_exclusive": 2808
    },
    {
      "start_ms": 576780,
      "end_ms": 577480,
      "text": "总有一天，",
      "token_start": 2808,
      "token_end_exclusive": 2812
    },
    {
      "start_ms": 577620,
      "end_ms": 580160,
      "text": "你会来到心里一直惦记的魔幻山城。",
      "token_start": 2812,
      "token_end_exclusive": 2827
    },
    {
      "start_ms": 580220,
      "end_ms": 583160,
      "text": "重庆走在高低错落的梯坎路上，",
      "token_start": 2827,
      "token_end_exclusive": 2840
    },
    {
      "start_ms": 583320,
      "end_ms": 585740,
      "text": "吹着长江与嘉陵江交织的晚风，",
      "token_start": 2840,
      "token_end_exclusive": 2853
    },
    {
      "start_ms": 586120,
      "end_ms": 586940,
      "text": "看蜀之道，",
      "token_start": 2853,
      "token_end_exclusive": 2857
    },
    {
      "start_ms": 586940,
      "end_ms": 588000,
      "text": "立于群山之上，",
      "token_start": 2857,
      "token_end_exclusive": 2863
    },
    {
      "start_ms": 588120,
      "end_ms": 590280,
      "text": "看纵横交错的大桥立交，",
      "token_start": 2863,
      "token_end_exclusive": 2873
    },
    {
      "start_ms": 590480,
      "end_ms": 592740,
      "text": "看穿梭于西峰古道的棒棒君。",
      "token_start": 2873,
      "token_end_exclusive": 2885
    },
    {
      "start_ms": 592940,
      "end_ms": 594460,
      "text": "重庆的重是重逢。",
      "token_start": 2885,
      "token_end_exclusive": 2892
    },
    {
      "start_ms": 594820,
      "end_ms": 598660,
      "text": "重庆的庆是庆幸诚邀诸君共赴山城，",
      "token_start": 2892,
      "token_end_exclusive": 2907
    },
    {
      "start_ms": 598940,
      "end_ms": 603105,
      "text": "在江枫与烟火中读懂这座成的万千风情。",
      "token_start": 2907,
      "token_end_exclusive": 2924
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
