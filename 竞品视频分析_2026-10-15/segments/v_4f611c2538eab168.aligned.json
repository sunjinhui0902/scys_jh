  "segments": [
    {
      "start_ms": 250,
      "end_ms": 6030,
      "text": "千万别以为咱退休之后还能够正常的活上几十年告诉你一个扎心的真相，",
      "token_start": 0,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 6270,
      "end_ms": 7770,
      "text": "其实也就七年，",
      "token_start": 31,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 8290,
      "end_ms": 9790,
      "text": "这可不是危言耸听啊。",
      "token_start": 37,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 10050,
      "end_ms": 10930,
      "text": "这个年龄之后，",
      "token_start": 46,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 11010,
      "end_ms": 13750,
      "text": "也就意味着你没有什么诗和远方了，",
      "token_start": 52,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 13910,
      "end_ms": 16070,
      "text": "大概率就是膝盖走不动了，",
      "token_start": 67,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 16210,
      "end_ms": 17330,
      "text": "心脏扛不动了，",
      "token_start": 78,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 17450,
      "end_ms": 18830,
      "text": "记性越来越差了。",
      "token_start": 84,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 18950,
      "end_ms": 21010,
      "text": "很多人都还想着退休之后，",
      "token_start": 91,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 21010,
      "end_ms": 22370,
      "text": "才是我人生的第二春。",
      "token_start": 102,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 22770,
      "end_ms": 24090,
      "text": "距离活到八十岁，",
      "token_start": 111,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 24330,
      "end_ms": 27210,
      "text": "还有中间二十年逍遥畅快的日子。",
      "token_start": 118,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 27810,
      "end_ms": 29905,
      "text": "但世界卫生组织给出了一份数据，",
      "token_start": 132,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 30280,
      "end_ms": 33840,
      "text": "中国男性健康预期寿命六十七点二岁，",
      "token_start": 146,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 34180,
      "end_ms": 35940,
      "text": "女性七十点一岁。",
      "token_start": 162,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 36560,
      "end_ms": 37440,
      "text": "这么一算啊，",
      "token_start": 169,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 37580,
      "end_ms": 39340,
      "text": "男性健康的年限差不多，",
      "token_start": 174,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 39340,
      "end_ms": 41140,
      "text": "也就是七年刚出头，",
      "token_start": 184,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 41480,
      "end_ms": 42820,
      "text": "女性还多一点儿。",
      "token_start": 192,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 43180,
      "end_ms": 44800,
      "text": "也就是说咱退休之后，",
      "token_start": 199,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 44980,
      "end_ms": 47920,
      "text": "真正的好时光平均也就七八年。",
      "token_start": 208,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 48500,
      "end_ms": 51800,
      "text": "这也是你人生当中既有点闲又有点闲，",
      "token_start": 221,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 52240,
      "end_ms": 53960,
      "text": "还有点经历的好时光。",
      "token_start": 237,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 54340,
      "end_ms": 55520,
      "text": "在这个年龄之前啊，",
      "token_start": 246,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 55520,
      "end_ms": 56520,
      "text": "咱们还算健康。",
      "token_start": 254,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 56740,
      "end_ms": 58020,
      "text": "等到了这个年龄之后，",
      "token_start": 260,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 58320,
      "end_ms": 61550,
      "text": "我们的生命质量就是同疾病共存了，",
      "token_start": 269,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 61730,
      "end_ms": 63935,
      "text": "或者说以病魔为友吧。",
      "token_start": 284,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 64720,
      "end_ms": 65520,
      "text": "到那个时候，",
      "token_start": 293,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 65520,
      "end_ms": 67480,
      "text": "真的不是想去哪就去哪，",
      "token_start": 298,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 67640,
      "end_ms": 69320,
      "text": "想吃啥就吃啥的问题，",
      "token_start": 308,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 69460,
      "end_ms": 71160,
      "text": "也谈不上享受生活，",
      "token_start": 317,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 71520,
      "end_ms": 73365,
      "text": "而是带病生存。",
      "token_start": 325,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 73810,
      "end_ms": 75760,
      "text": "咋所以啊你一定要明白，",
      "token_start": 331,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 76040,
      "end_ms": 77905,
      "text": "健康不是退休之后的福利，",
      "token_start": 341,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 78200,
      "end_ms": 80495,
      "text": "而是退休前的必修课，",
      "token_start": 352,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 80990,
      "end_ms": 82350,
      "text": "百分百死亡率的人生。",
      "token_start": 361,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 82570,
      "end_ms": 83345,
      "text": "莫等闲，",
      "token_start": 370,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 83660,
      "end_ms": 84180,
      "text": "该吃吃，",
      "token_start": 373,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 84420,
      "end_ms": 85125,
      "text": "该喝喝，",
      "token_start": 376,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 85560,
      "end_ms": 87440,
      "text": "有什么愿望就赶紧的去实现，",
      "token_start": 379,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 87520,
      "end_ms": 89765,
      "text": "有什么遗憾就赶紧的去弥补，",
      "token_start": 391,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 90080,
      "end_ms": 93465,
      "text": "不要等到最后躺在病床上追悔莫及，",
      "token_start": 403,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 93750,
      "end_ms": 96485,
      "text": "也不要觉得意外离我们真的很遥远。",
      "token_start": 418,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 96840,
      "end_ms": 97220,
      "text": "其实，",
      "token_start": 433,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 97380,
      "end_ms": 101415,
      "text": "所有的猝不及防都是蓄谋已久的身体透支，",
      "token_start": 435,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 101740,
      "end_ms": 106095,
      "text": "你拼到最后的不是车子、房子、票子也不是什么身份地位，",
      "token_start": 453,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 106480,
      "end_ms": 109605,
      "text": "而是你能不能从此刻善待你的身体，",
      "token_start": 476,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 110040,
      "end_ms": 110800,
      "text": "稳稳当当，",
      "token_start": 491,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 111020,
      "end_ms": 114035,
      "text": "平平安安的走完这一生，",
      "token_start": 495,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 114690,
      "end_ms": 115535,
      "text": "你认同吗？",
      "token_start": 505,
      "token_end_exclusive": 509
    }
  ],
