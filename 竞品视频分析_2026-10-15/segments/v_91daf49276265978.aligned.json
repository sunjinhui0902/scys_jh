{
  "video_id": "v_91daf49276265978",
  "duration_s": 494.098005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_91daf49276265978.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_91daf49276265978.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 710,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 850,
      "end_ms": 5850,
      "text": "咱们盘了第十到第六开封底下压着六座城，",
      "token_start": 2,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 6230,
      "end_ms": 12370,
      "text": "徐州攒齐两汉文明曲阜定义了礼乐中国，",
      "token_start": 20,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 12690,
      "end_ms": 13210,
      "text": "平遥，",
      "token_start": 37,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 13410,
      "end_ms": 15670,
      "text": "卧着丽江没城墙，",
      "token_start": 39,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 16129,
      "end_ms": 18290,
      "text": "反而活成了世界遗产。",
      "token_start": 46,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 19330,
      "end_ms": 22010,
      "text": "好多朋友看完在评论区炒翻了。",
      "token_start": 55,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 22710,
      "end_ms": 26070,
      "text": "有人说绍兴呢成都呢、洛阳呢？",
      "token_start": 68,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 26190,
      "end_ms": 26670,
      "text": "别急，",
      "token_start": 80,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 27470,
      "end_ms": 31600,
      "text": "今天这集就是第五道第一一一个比一个厚。",
      "token_start": 82,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 32160,
      "end_ms": 35560,
      "text": "最后那个中国古都学会给他立碑，",
      "token_start": 100,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 35940,
      "end_ms": 38240,
      "text": "写的是华夏第一王都。",
      "token_start": 114,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 38380,
      "end_ms": 42500,
      "text": "老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 123,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 42920,
      "end_ms": 44760,
      "text": "让我看看都是谁在听。",
      "token_start": 140,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 45480,
      "end_ms": 46139,
      "text": "第五名，",
      "token_start": 149,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 46540,
      "end_ms": 49200,
      "text": "浙江绍兴春秋越国都城。",
      "token_start": 152,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 49620,
      "end_ms": 51240,
      "text": "公元前四百九十年，",
      "token_start": 162,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 51720,
      "end_ms": 54640,
      "text": "越王勾践让大夫范蠡建城，",
      "token_start": 170,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 55080,
      "end_ms": 57400,
      "text": "到今天两千五百多年了，",
      "token_start": 181,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 57620,
      "end_ms": 63425,
      "text": "这城最绝的地方不是老是他两千五百年城旨没挪过窝，",
      "token_start": 191,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 63800,
      "end_ms": 65035,
      "text": "格局没大变过，",
      "token_start": 214,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 65460,
      "end_ms": 76815,
      "text": "全国找不出第二座这样的城跟他一样老的只有苏州范蠡当年建成暗座西朝东的周至依着山水形事，",
      "token_start": 220,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 77170,
      "end_ms": 78595,
      "text": "选了四通八达，",
      "token_start": 262,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 79170,
      "end_ms": 80315,
      "text": "地方很便利。",
      "token_start": 268,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 80730,
      "end_ms": 82215,
      "text": "两千五百年过去了，",
      "token_start": 273,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 82530,
      "end_ms": 85505,
      "text": "绍兴人还在原来的地方住着，",
      "token_start": 281,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 85760,
      "end_ms": 87055,
      "text": "还在原来的河道里，",
      "token_start": 293,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 87600,
      "end_ms": 89820,
      "text": "遥无篷船古城里，",
      "token_start": 301,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 89820,
      "end_ms": 93625,
      "text": "到现在还有八百多条河六百多座桥。",
      "token_start": 308,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 94170,
      "end_ms": 95205,
      "text": "有句老话叫，",
      "token_start": 323,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 95560,
      "end_ms": 98880,
      "text": "三山万户向盘曲柏桥，",
      "token_start": 328,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 98920,
      "end_ms": 100195,
      "text": "千阶水纵横。",
      "token_start": 337,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 100750,
      "end_ms": 101450,
      "text": "您想想，",
      "token_start": 342,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 101710,
      "end_ms": 102635,
      "text": "两千年了，",
      "token_start": 345,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 103110,
      "end_ms": 104890,
      "text": "河还是那条河桥，",
      "token_start": 349,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 105030,
      "end_ms": 105890,
      "text": "还是那座桥，",
      "token_start": 356,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 106250,
      "end_ms": 108365,
      "text": "人还是住在老地方，",
      "token_start": 361,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 108650,
      "end_ms": 110655,
      "text": "这城不是箭在地上，",
      "token_start": 369,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 110830,
      "end_ms": 112890,
      "text": "是长在地里的这地方，",
      "token_start": 377,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 112890,
      "end_ms": 114685,
      "text": "还叫名仕之乡。",
      "token_start": 386,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 115370,
      "end_ms": 117640,
      "text": "王羲之在这儿写了兰亭序，",
      "token_start": 392,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 117840,
      "end_ms": 120380,
      "text": "陆游在这儿写下死去。",
      "token_start": 403,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 120380,
      "end_ms": 121635,
      "text": "元知万事空，",
      "token_start": 412,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 122020,
      "end_ms": 122380,
      "text": "鲁迅，",
      "token_start": 417,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 122380,
      "end_ms": 123735,
      "text": "从这儿走出去，",
      "token_start": 419,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 124220,
      "end_ms": 124680,
      "text": "明清，",
      "token_start": 425,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 124760,
      "end_ms": 128405,
      "text": "两朝绍兴师爷遍布全国。",
      "token_start": 427,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 129030,
      "end_ms": 129850,
      "text": "有句话叫，",
      "token_start": 437,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 130010,
      "end_ms": 131365,
      "text": "无哨不成牙，",
      "token_start": 441,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 131850,
      "end_ms": 134655,
      "text": "全国衙门里差不多都有绍兴人，",
      "token_start": 446,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 135400,
      "end_ms": 136060,
      "text": "一座城，",
      "token_start": 459,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 136400,
      "end_ms": 139955,
      "text": "把江南的骨和魂全泡在黄酒里了。",
      "token_start": 462,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 140550,
      "end_ms": 141185,
      "text": "第四名，",
      "token_start": 476,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 141640,
      "end_ms": 144735,
      "text": "四川成都古蜀文明的发祥地，",
      "token_start": 479,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 145110,
      "end_ms": 148250,
      "text": "蜀汉都城因蜀锦得名。",
      "token_start": 491,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 148550,
      "end_ms": 152650,
      "text": "锦官城这城三千多年没改过名字，",
      "token_start": 500,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 152750,
      "end_ms": 153805,
      "text": "没挪过位置，",
      "token_start": 514,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 154860,
      "end_ms": 156515,
      "text": "您知道这意味着什么吗？",
      "token_start": 519,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 157380,
      "end_ms": 160425,
      "text": "三千年里战火也烧过，",
      "token_start": 529,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 160960,
      "end_ms": 161440,
      "text": "大水，",
      "token_start": 538,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 161440,
      "end_ms": 162265,
      "text": "也淹过，",
      "token_start": 540,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 163040,
      "end_ms": 165095,
      "text": "改朝换代多少回，",
      "token_start": 543,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 165690,
      "end_ms": 167445,
      "text": "他还在那儿名字不变，",
      "token_start": 550,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 167760,
      "end_ms": 168520,
      "text": "位置不变。",
      "token_start": 559,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 168700,
      "end_ms": 170625,
      "text": "成都这个名字怎么来的？",
      "token_start": 563,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 171110,
      "end_ms": 174020,
      "text": "古书上写着一年成聚二年，",
      "token_start": 573,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 174080,
      "end_ms": 175240,
      "text": "成义三年，",
      "token_start": 584,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 175320,
      "end_ms": 178795,
      "text": "成都意思是住一年就成了村子，",
      "token_start": 588,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 179250,
      "end_ms": 180855,
      "text": "住两年就成了镇子，",
      "token_start": 601,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 181580,
      "end_ms": 183455,
      "text": "住三年就成了都城，",
      "token_start": 609,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 183940,
      "end_ms": 184725,
      "text": "就这么简单。",
      "token_start": 617,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 185420,
      "end_ms": 188625,
      "text": "旁边的都江堰两千两百多年了，",
      "token_start": 622,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 188860,
      "end_ms": 191375,
      "text": "还在给成都平原灌水，",
      "token_start": 635,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 191690,
      "end_ms": 197545,
      "text": "到现在灌溉一千多万亩农田养活三千多万人。",
      "token_start": 644,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 198360,
      "end_ms": 201155,
      "text": "天府之国四个字就是这么来的。",
      "token_start": 663,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 202750,
      "end_ms": 207430,
      "text": "杜甫草堂武侯祠青城山一座城，",
      "token_start": 676,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 207430,
      "end_ms": 209765,
      "text": "把诗和远方全占了，",
      "token_start": 689,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 210610,
      "end_ms": 213435,
      "text": "这是您上哪说理去？",
      "token_start": 697,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 214370,
      "end_ms": 215085,
      "text": "第三名，",
      "token_start": 705,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 215460,
      "end_ms": 216360,
      "text": "江苏南京，",
      "token_start": 708,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 216640,
      "end_ms": 221995,
      "text": "六朝古都十朝都会东吴、东晋宋齐梁陈，",
      "token_start": 712,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 222560,
      "end_ms": 226365,
      "text": "加上南唐明初太平天国，",
      "token_start": 728,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 227160,
      "end_ms": 232550,
      "text": "民国先后十个朝代在这儿建都秦淮河。",
      "token_start": 738,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 232910,
      "end_ms": 235915,
      "text": "从城中间留过蒋声登营礼，",
      "token_start": 754,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 236290,
      "end_ms": 237865,
      "text": "藏着半部中国史，",
      "token_start": 765,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 238210,
      "end_ms": 239785,
      "text": "虎踞龙盘的地势，",
      "token_start": 772,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 240450,
      "end_ms": 244005,
      "text": "让每个想守住江南的王朝都往这儿跑。",
      "token_start": 779,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 244700,
      "end_ms": 248135,
      "text": "但南京也是座商城建成两千五百多年，",
      "token_start": 795,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 248690,
      "end_ms": 250005,
      "text": "他被毁过六次，",
      "token_start": 811,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 250430,
      "end_ms": 251435,
      "text": "苏郡叛乱，",
      "token_start": 817,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 251770,
      "end_ms": 252815,
      "text": "侯景叛乱，",
      "token_start": 821,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 253330,
      "end_ms": 256790,
      "text": "隋朝灭臣金兵南下太平天国，",
      "token_start": 825,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 257150,
      "end_ms": 262365,
      "text": "还有侵华日军一次一次把他推倒最惨的一次，",
      "token_start": 837,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 262710,
      "end_ms": 266255,
      "text": "全城二十八万户死了将近八成。",
      "token_start": 856,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 266730,
      "end_ms": 270765,
      "text": "可是每一次他都从废墟上又站起来了。",
      "token_start": 869,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 271950,
      "end_ms": 274735,
      "text": "您站在名城墙上看一眼长江，",
      "token_start": 885,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 275080,
      "end_ms": 278155,
      "text": "就明白什么叫厚重一座城的命运，",
      "token_start": 897,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 278390,
      "end_ms": 280765,
      "text": "跟一个民族的命运拴在一起。",
      "token_start": 911,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 281540,
      "end_ms": 282085,
      "text": "第二名，",
      "token_start": 923,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 282540,
      "end_ms": 289450,
      "text": "陕西西安十三朝古都西周琴西汉隋唐全在这儿。",
      "token_start": 926,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 289450,
      "end_ms": 292490,
      "text": "建都丝绸之路从这儿出发，",
      "token_start": 946,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 292710,
      "end_ms": 294985,
      "text": "跟罗马雅典开罗。",
      "token_start": 957,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 295870,
      "end_ms": 300290,
      "text": "并称世界四大古都这城最邪乎的不是地上，",
      "token_start": 964,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 300670,
      "end_ms": 303769,
      "text": "是地下西安人挖地铁，",
      "token_start": 982,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 304030,
      "end_ms": 307590,
      "text": "挖着挖着就挖到老祖宗家门口了。",
      "token_start": 991,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 307630,
      "end_ms": 310110,
      "text": "地铁二号线短短二十五公里，",
      "token_start": 1005,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 311010,
      "end_ms": 313450,
      "text": "挖出来一百三十多座古墓。",
      "token_start": 1017,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 313770,
      "end_ms": 315550,
      "text": "从汉代到明代，",
      "token_start": 1028,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 315870,
      "end_ms": 318130,
      "text": "一层压一层修修停停，",
      "token_start": 1034,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 318570,
      "end_ms": 320330,
      "text": "本来几年能干完的活，",
      "token_start": 1043,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 320630,
      "end_ms": 322130,
      "text": "硬是拖了十八年。",
      "token_start": 1052,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 322710,
      "end_ms": 324350,
      "text": "地铁八号线更吓人。",
      "token_start": 1059,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 324650,
      "end_ms": 325515,
      "text": "勘探发现，",
      "token_start": 1067,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 326200,
      "end_ms": 328320,
      "text": "一千三百多座古墓，",
      "token_start": 1071,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 328820,
      "end_ms": 331680,
      "text": "施工队都习惯了一铲子下去，",
      "token_start": 1079,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 332060,
      "end_ms": 334360,
      "text": "先得给文物局打电话。",
      "token_start": 1091,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 334740,
      "end_ms": 343760,
      "text": "兵马俑、大雁塔、大明宫遗址地下埋的是整个中华文明的精神故乡。",
      "token_start": 1100,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 343960,
      "end_ms": 344540,
      "text": "有人说，",
      "token_start": 1127,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 344760,
      "end_ms": 346460,
      "text": "西安的土都是文物，",
      "token_start": 1130,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 346640,
      "end_ms": 347360,
      "text": "挖地铁，",
      "token_start": 1138,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 347640,
      "end_ms": 349620,
      "text": "比考古队还忙。",
      "token_start": 1141,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 349920,
      "end_ms": 355375,
      "text": "一座城撑起了中国最强盛那些朝代的门面。",
      "token_start": 1147,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 355830,
      "end_ms": 356435,
      "text": "第一名。",
      "token_start": 1165,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 356790,
      "end_ms": 361825,
      "text": "河南洛阳十三朝古都从夏朝开始，",
      "token_start": 1168,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 362220,
      "end_ms": 364950,
      "text": "东周东汉曹魏西晋，",
      "token_start": 1182,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 365110,
      "end_ms": 366310,
      "text": "北魏隋唐，",
      "token_start": 1190,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 366550,
      "end_ms": 373320,
      "text": "一个接一个在这儿定都建都史、一千五百年中国历史上，",
      "token_start": 1194,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 373520,
      "end_ms": 377595,
      "text": "建都最早、朝代最多、历史最长的城市，",
      "token_start": 1217,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 378020,
      "end_ms": 379495,
      "text": "沿漯河一线。",
      "token_start": 1232,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 379900,
      "end_ms": 381080,
      "text": "从东到西，",
      "token_start": 1237,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 381500,
      "end_ms": 392045,
      "text": "排着五座都城遗址、夏都二里头、偃狮商城、东周王城捍卫洛阳城隋唐洛阳城，",
      "token_start": 1241,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 392450,
      "end_ms": 394165,
      "text": "这叫武都贿赂。",
      "token_start": 1272,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 394600,
      "end_ms": 397945,
      "text": "全世界找不出第二处，",
      "token_start": 1278,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 398240,
      "end_ms": 401925,
      "text": "二里头遗址被叫做华夏第一王都。",
      "token_start": 1287,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 402370,
      "end_ms": 404825,
      "text": "那里有中国最早的工程，",
      "token_start": 1301,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 405170,
      "end_ms": 407025,
      "text": "最早的城市干道网，",
      "token_start": 1311,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 407700,
      "end_ms": 409575,
      "text": "最早的中轴线布局，",
      "token_start": 1319,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 409980,
      "end_ms": 411725,
      "text": "最早的青铜礼器群。",
      "token_start": 1327,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 412190,
      "end_ms": 415445,
      "text": "中国的王朝文明就是从那儿开的头。",
      "token_start": 1335,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 415920,
      "end_ms": 418325,
      "text": "龙门石窟凿了四百多年，",
      "token_start": 1350,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 418780,
      "end_ms": 422525,
      "text": "现存两千多个枯堪十万多尊造像。",
      "token_start": 1360,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 423020,
      "end_ms": 426830,
      "text": "白马寺是中国第一座官办寺院，",
      "token_start": 1374,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 426990,
      "end_ms": 430870,
      "text": "牡丹花开了一千多年中国古都，",
      "token_start": 1387,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 430870,
      "end_ms": 433065,
      "text": "学会给他立碑，",
      "token_start": 1400,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 433960,
      "end_ms": 437135,
      "text": "写的是华夏第一王都，",
      "token_start": 1406,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 438060,
      "end_ms": 439325,
      "text": "别的城再牛，",
      "token_start": 1415,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 440270,
      "end_ms": 443125,
      "text": "论资排辈都得往后站。",
      "token_start": 1420,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 443520,
      "end_ms": 444645,
      "text": "您听出来了没有？",
      "token_start": 1429,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 445040,
      "end_ms": 451375,
      "text": "这十座城没有一座是靠楼高出名的洛阳靠的是华夏第一王都，",
      "token_start": 1436,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 451940,
      "end_ms": 454920,
      "text": "西安靠的是地底下埋着的盛堂。",
      "token_start": 1462,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 455220,
      "end_ms": 459375,
      "text": "南京靠的是六次推倒又六次站起来，",
      "token_start": 1475,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 460190,
      "end_ms": 462370,
      "text": "成都靠的是三千年，",
      "token_start": 1490,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 462370,
      "end_ms": 463965,
      "text": "不改名不挪窝。",
      "token_start": 1498,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 464620,
      "end_ms": 467310,
      "text": "绍兴靠的是两千五百年，",
      "token_start": 1504,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 467330,
      "end_ms": 468070,
      "text": "城址没变。",
      "token_start": 1514,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 468230,
      "end_ms": 470000,
      "text": "丽江靠的是水，",
      "token_start": 1518,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 470040,
      "end_ms": 471955,
      "text": "穿城过马帮铃响。",
      "token_start": 1524,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 472320,
      "end_ms": 474420,
      "text": "平遥靠的是票号，",
      "token_start": 1531,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 474480,
      "end_ms": 475455,
      "text": "汇通天下，",
      "token_start": 1538,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 475930,
      "end_ms": 478765,
      "text": "曲阜靠的是孔子立的规矩。",
      "token_start": 1542,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 479240,
      "end_ms": 482025,
      "text": "徐州靠的是两汉的魂。",
      "token_start": 1553,
      "token_end_exclusive": 1562
    },
    {
      "start_ms": 482510,
      "end_ms": 485985,
      "text": "开封靠的是地下摞着六座城，",
      "token_start": 1562,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 486560,
      "end_ms": 489825,
      "text": "每一座城的厉害之处都不在地面上。",
      "token_start": 1574,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 490510,
      "end_ms": 492365,
      "text": "在故事里点个关注，",
      "token_start": 1589,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 492670,
      "end_ms": 493965,
      "text": "咱们下期接着聊。",
      "token_start": 1597,
      "token_end_exclusive": 1604
    }
  ],
