{
  "video_id": "v_14fbacb5fb09ed50",
  "duration_s": 473.733991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_14fbacb5fb09ed50.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_14fbacb5fb09ed50.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 650,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 650,
      "end_ms": 5150,
      "text": "咱们盘的第十到第六雪鱼洞的石头是个小姑娘，",
      "token_start": 2,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5590,
      "end_ms": 8270,
      "text": "本溪水洞飘着一条地下银河，",
      "token_start": 22,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 8810,
      "end_ms": 10730,
      "text": "望华岩的瀑布会变色，",
      "token_start": 34,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 11270,
      "end_ms": 15410,
      "text": "腾龙洞吞了一整条江芙蓉洞的池子会发光。",
      "token_start": 43,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 15690,
      "end_ms": 18050,
      "text": "好多朋友看完在评论区吵翻了，",
      "token_start": 61,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 18330,
      "end_ms": 22850,
      "text": "有人说紫金洞呢黄龙洞呢双河洞呢别急，",
      "token_start": 74,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 23390,
      "end_ms": 25650,
      "text": "今天这集就是第五道第一，",
      "token_start": 91,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 26130,
      "end_ms": 27270,
      "text": "一个比一个狠。",
      "token_start": 102,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 28070,
      "end_ms": 32080,
      "text": "最后那个金洞洞到今今天都定不了它的成因。",
      "token_start": 108,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 32400,
      "end_ms": 36280,
      "text": "老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 127,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 36560,
      "end_ms": 38720,
      "text": "让我看看都是谁在听。",
      "token_start": 144,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 39400,
      "end_ms": 40100,
      "text": "第五名，",
      "token_start": 153,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 40280,
      "end_ms": 44180,
      "text": "贵州织金洞最深处立着一根石柱，",
      "token_start": 156,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 44660,
      "end_ms": 46260,
      "text": "当地人叫它银羽树，",
      "token_start": 170,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 46520,
      "end_ms": 47400,
      "text": "两米来高，",
      "token_start": 178,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 47840,
      "end_ms": 49500,
      "text": "通体晶莹剔透，",
      "token_start": 182,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 49820,
      "end_ms": 52540,
      "text": "远看像一棵挂满了霜花的树，",
      "token_start": 188,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 53100,
      "end_ms": 54460,
      "text": "走近了才发现，",
      "token_start": 200,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 54620,
      "end_ms": 55360,
      "text": "它不是树，",
      "token_start": 206,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 55840,
      "end_ms": 58180,
      "text": "它是水做的一滴水，",
      "token_start": 210,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 58300,
      "end_ms": 61155,
      "text": "十几万年一层一层往上挪，",
      "token_start": 218,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 61600,
      "end_ms": 63995,
      "text": "水里的矿物质慢慢沉下来，",
      "token_start": 229,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 64430,
      "end_ms": 67775,
      "text": "成出满身花瓣一样的卷曲纹路。",
      "token_start": 240,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 68430,
      "end_ms": 70810,
      "text": "树顶上还伸出几根枝杈，",
      "token_start": 253,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 70950,
      "end_ms": 72165,
      "text": "跟松树似的。",
      "token_start": 263,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 72520,
      "end_ms": 74580,
      "text": "导游每回走到这儿都要停下，",
      "token_start": 268,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 74580,
      "end_ms": 81330,
      "text": "来说您去全世界找找找不着第二根这模样的织金洞，",
      "token_start": 280,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 81390,
      "end_ms": 82870,
      "text": "敢叫溶洞之王，",
      "token_start": 302,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 83090,
      "end_ms": 86155,
      "text": "一多半的底气就压在这根柱子上。",
      "token_start": 308,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 86560,
      "end_ms": 89540,
      "text": "联合国的地质专家当年看完站在那儿，",
      "token_start": 322,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 89540,
      "end_ms": 90465,
      "text": "愣了好一会儿。",
      "token_start": 338,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 90880,
      "end_ms": 92195,
      "text": "最后摇着头说，",
      "token_start": 344,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 92880,
      "end_ms": 94815,
      "text": "这东西教科书里写不进去，",
      "token_start": 350,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 95190,
      "end_ms": 97955,
      "text": "一根柱子撑起一个洞的名声。",
      "token_start": 361,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 98560,
      "end_ms": 99995,
      "text": "您说这得多大分量？",
      "token_start": 373,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 101270,
      "end_ms": 101875,
      "text": "第四名，",
      "token_start": 381,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 103290,
      "end_ms": 107170,
      "text": "广西桂林卢狄言七十多则辟书，",
      "token_start": 384,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 107370,
      "end_ms": 109230,
      "text": "最早的是唐朝贞元。",
      "token_start": 397,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 109290,
      "end_ms": 111505,
      "text": "八年一千两百多年前，",
      "token_start": 405,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 111820,
      "end_ms": 113765,
      "text": "有人进去过写的字，",
      "token_start": 414,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 114140,
      "end_ms": 119410,
      "text": "可附近的村民一直不说把洞口藏起来当避难所，",
      "token_start": 422,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 119650,
      "end_ms": 120955,
      "text": "外面改朝换代，",
      "token_start": 442,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 121360,
      "end_ms": 121825,
      "text": "打仗，",
      "token_start": 448,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 122890,
      "end_ms": 124500,
      "text": "他们躲进洞里出来，",
      "token_start": 450,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 124500,
      "end_ms": 125335,
      "text": "又是一条命。",
      "token_start": 458,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 126260,
      "end_ms": 126980,
      "text": "解放以后，",
      "token_start": 463,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 127340,
      "end_ms": 128585,
      "text": "社会安定了，",
      "token_start": 467,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 129230,
      "end_ms": 131095,
      "text": "村民才把这个秘密说出来。",
      "token_start": 472,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 131590,
      "end_ms": 134445,
      "text": "您说这个洞是多少人的保命度，",
      "token_start": 483,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 134960,
      "end_ms": 140135,
      "text": "那些必书是不是每一笔都在等您去看一座洞，",
      "token_start": 496,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 140440,
      "end_ms": 141455,
      "text": "护住了一方人，",
      "token_start": 515,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 142380,
      "end_ms": 144145,
      "text": "这比什么宝贝都值钱。",
      "token_start": 521,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 144410,
      "end_ms": 145435,
      "text": "讲了这几个地方，",
      "token_start": 530,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 145800,
      "end_ms": 149195,
      "text": "评论区好多朋友说年轻时忙没空去，",
      "token_start": 537,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 149650,
      "end_ms": 150610,
      "text": "现在退休了，",
      "token_start": 552,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 150650,
      "end_ms": 152865,
      "text": "想好好看看带孙子的，",
      "token_start": 557,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 153230,
      "end_ms": 155555,
      "text": "想给孩子讲讲这些动力的秘密，",
      "token_start": 566,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 156240,
      "end_ms": 157285,
      "text": "自己也说不全。",
      "token_start": 579,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 157760,
      "end_ms": 159420,
      "text": "咱们这年纪看景，",
      "token_start": 585,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 159440,
      "end_ms": 160495,
      "text": "不光看热闹，",
      "token_start": 592,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 160820,
      "end_ms": 163345,
      "text": "是想知道这地底下到底藏着什么，",
      "token_start": 597,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 163590,
      "end_ms": 164675,
      "text": "背后有什么故事。",
      "token_start": 611,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 165180,
      "end_ms": 166655,
      "text": "可手机上刷完就忘，",
      "token_start": 618,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 167140,
      "end_ms": 168355,
      "text": "上网查太乱，",
      "token_start": 626,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 168740,
      "end_ms": 169580,
      "text": "翻大布头，",
      "token_start": 631,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 169580,
      "end_ms": 170255,
      "text": "眼睛疼。",
      "token_start": 635,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 170920,
      "end_ms": 176910,
      "text": "前阵子我翻到一本叫大美中国人一生要去的一百零一个地方的书。",
      "token_start": 638,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 177130,
      "end_ms": 181065,
      "text": "他把全中国最值得去的一百零一个地方挑出来，",
      "token_start": 666,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 181500,
      "end_ms": 182645,
      "text": "有自然风光，",
      "token_start": 686,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 182920,
      "end_ms": 183800,
      "text": "有历史文化，",
      "token_start": 691,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 184040,
      "end_ms": 189315,
      "text": "有民族风情、一个地方一个地方的讲怎么来的，",
      "token_start": 696,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 189750,
      "end_ms": 190815,
      "text": "有什么典故，",
      "token_start": 715,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 191200,
      "end_ms": 192275,
      "text": "风土人情，",
      "token_start": 720,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 192780,
      "end_ms": 194325,
      "text": "几分钟讲的明白，",
      "token_start": 724,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 194740,
      "end_ms": 196690,
      "text": "图也印的漂亮一页。",
      "token_start": 731,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 196690,
      "end_ms": 198005,
      "text": "翻开就是一幅大画，",
      "token_start": 739,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 198610,
      "end_ms": 199875,
      "text": "我自己是这么用的，",
      "token_start": 747,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 200170,
      "end_ms": 204020,
      "text": "能去的地方出门前先翻一翻到了地方，",
      "token_start": 755,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 204060,
      "end_ms": 205025,
      "text": "心里有底，",
      "token_start": 771,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 205700,
      "end_ms": 207435,
      "text": "看的就不是石头，",
      "token_start": 775,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 207890,
      "end_ms": 210395,
      "text": "是故事去不了的地方。",
      "token_start": 782,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 210660,
      "end_ms": 212450,
      "text": "翻翻书看看图，",
      "token_start": 791,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 212710,
      "end_ms": 213695,
      "text": "也算去过，",
      "token_start": 797,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 214070,
      "end_ms": 215610,
      "text": "放茶几上孙子，",
      "token_start": 801,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 215610,
      "end_ms": 216210,
      "text": "孙女来了，",
      "token_start": 807,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 216210,
      "end_ms": 217930,
      "text": "翻两页长知识。",
      "token_start": 811,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 217930,
      "end_ms": 218290,
      "text": "不说，",
      "token_start": 817,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 218610,
      "end_ms": 219835,
      "text": "写作文都用得上，",
      "token_start": 819,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 220310,
      "end_ms": 221695,
      "text": "老两口晚上翻番，",
      "token_start": 826,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 222070,
      "end_ms": 223105,
      "text": "商量明年去哪。",
      "token_start": 833,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 223380,
      "end_ms": 224835,
      "text": "比刷手机有意思多了。",
      "token_start": 839,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 225380,
      "end_ms": 226280,
      "text": "房子会旧，",
      "token_start": 848,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 226460,
      "end_ms": 227585,
      "text": "存款会花完，",
      "token_start": 852,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 227970,
      "end_ms": 230405,
      "text": "可千年文化替咱们指路。",
      "token_start": 857,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 230970,
      "end_ms": 233455,
      "text": "这个东西传多少代都有价值，",
      "token_start": 867,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 234250,
      "end_ms": 236675,
      "text": "守住咱们中国人的文化记忆。",
      "token_start": 879,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 237100,
      "end_ms": 238795,
      "text": "这份记忆一旦淡了，",
      "token_start": 891,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 239330,
      "end_ms": 241130,
      "text": "想找回来就难了，",
      "token_start": 899,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 241230,
      "end_ms": 244165,
      "text": "趁现在还能买到给自己，",
      "token_start": 906,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 244390,
      "end_ms": 245895,
      "text": "也给下一代留一份。",
      "token_start": 916,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 247330,
      "end_ms": 250715,
      "text": "感兴趣的朋友下方小黄车点进去看看，",
      "token_start": 924,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 250970,
      "end_ms": 251965,
      "text": "暂时走不出去，",
      "token_start": 940,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 252740,
      "end_ms": 254725,
      "text": "咱就把祖国装进屋里。",
      "token_start": 946,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 255690,
      "end_ms": 256395,
      "text": "第三名，",
      "token_start": 955,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 256740,
      "end_ms": 258465,
      "text": "贵州绥阳双河洞，",
      "token_start": 958,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 258780,
      "end_ms": 265645,
      "text": "五十二具大熊猫化石一万多年前的这洞探了三十多年，",
      "token_start": 965,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 266570,
      "end_ms": 268775,
      "text": "探明长度四百八十一公里，",
      "token_start": 988,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 269050,
      "end_ms": 269835,
      "text": "亚洲第一。",
      "token_start": 999,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 270770,
      "end_ms": 272865,
      "text": "可他最大的秘密不是长度，",
      "token_start": 1003,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 273160,
      "end_ms": 275155,
      "text": "是他肚子里藏着的东西，",
      "token_start": 1014,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 276070,
      "end_ms": 284085,
      "text": "还有羚牛、犀牛、剑齿象、四十四种古生物全都完整的保存在洞里，",
      "token_start": 1024,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 284510,
      "end_ms": 287880,
      "text": "一具大熊猫骨架连牙齿都没掉，",
      "token_start": 1050,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 288060,
      "end_ms": 293305,
      "text": "这是全世界保存最完整的晚耕新式羚游化石。",
      "token_start": 1063,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 293980,
      "end_ms": 295840,
      "text": "也是第一个可靠的记录。",
      "token_start": 1082,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 296420,
      "end_ms": 299920,
      "text": "一万多年前的大熊猫就这么安安静静，",
      "token_start": 1092,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 299940,
      "end_ms": 301460,
      "text": "躺在贵州的山洞里，",
      "token_start": 1108,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 301940,
      "end_ms": 303000,
      "text": "等了一万多年，",
      "token_start": 1116,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 303000,
      "end_ms": 303860,
      "text": "才被人发现，",
      "token_start": 1122,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 304300,
      "end_ms": 306900,
      "text": "一只大熊猫等了一万多年才被叫醒，",
      "token_start": 1127,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 307380,
      "end_ms": 308940,
      "text": "这事儿上哪说理去？",
      "token_start": 1142,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 309800,
      "end_ms": 310440,
      "text": "第二名，",
      "token_start": 1150,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 310680,
      "end_ms": 314700,
      "text": "浙江桐庐遥临仙境二十多米高的石瀑布，",
      "token_start": 1153,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 315220,
      "end_ms": 317680,
      "text": "从洞顶一直挂到洞底，",
      "token_start": 1170,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 317960,
      "end_ms": 318880,
      "text": "七米多宽。",
      "token_start": 1179,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 319220,
      "end_ms": 320740,
      "text": "这不是真瀑布，",
      "token_start": 1183,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 321080,
      "end_ms": 323645,
      "text": "是石头长的水滴了。",
      "token_start": 1189,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 323770,
      "end_ms": 326210,
      "text": "几十万年一层一层沉下来，",
      "token_start": 1197,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 326410,
      "end_ms": 328130,
      "text": "沉成了瀑布的样子，",
      "token_start": 1208,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 328650,
      "end_ms": 332490,
      "text": "灯光一打整片石瀑布跟银河倒挂一样，",
      "token_start": 1216,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 332810,
      "end_ms": 333690,
      "text": "可您知道吗？",
      "token_start": 1232,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 333790,
      "end_ms": 337390,
      "text": "这片瀑布每一百年才长一厘米，",
      "token_start": 1237,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 337950,
      "end_ms": 342010,
      "text": "有的石笋长了十几万年才长成。",
      "token_start": 1250,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 342050,
      "end_ms": 345590,
      "text": "现在这样可就是这么珍贵的石头。",
      "token_start": 1263,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 346450,
      "end_ms": 350030,
      "text": "以前有人偷把石笋砸下来，",
      "token_start": 1277,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 350470,
      "end_ms": 353295,
      "text": "拿去卖一块石头，",
      "token_start": 1288,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 353610,
      "end_ms": 356925,
      "text": "几万年才长成一锤子就没了。",
      "token_start": 1295,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 357300,
      "end_ms": 359015,
      "text": "后来景区装了监控，",
      "token_start": 1307,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 359330,
      "end_ms": 360245,
      "text": "派人守着，",
      "token_start": 1315,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 360530,
      "end_ms": 365000,
      "text": "才保住了这片银河几万年才长成的东西，",
      "token_start": 1319,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 365020,
      "end_ms": 366325,
      "text": "一锤子就没了，",
      "token_start": 1336,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 366730,
      "end_ms": 368435,
      "text": "这事想起来就心疼。",
      "token_start": 1342,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 368980,
      "end_ms": 369525,
      "text": "第一名。",
      "token_start": 1350,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 370020,
      "end_ms": 371655,
      "text": "湖南张家界黄龙洞，",
      "token_start": 1353,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 372040,
      "end_ms": 374095,
      "text": "一根石头值一个亿，",
      "token_start": 1361,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 374540,
      "end_ms": 378075,
      "text": "水潭正中央一根石笋拔地而起，",
      "token_start": 1369,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 378530,
      "end_ms": 379730,
      "text": "将近二十米，",
      "token_start": 1382,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 379730,
      "end_ms": 382605,
      "text": "高笔直朝上已经涨了两万年了，",
      "token_start": 1387,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 382810,
      "end_ms": 384435,
      "text": "还差几米就要顶到洞顶。",
      "token_start": 1400,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 384890,
      "end_ms": 387885,
      "text": "这根石笋有个名字叫定海神针，",
      "token_start": 1410,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 388690,
      "end_ms": 390225,
      "text": "景区怕他出什么意外，",
      "token_start": 1423,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 390580,
      "end_ms": 393465,
      "text": "专门去保险公司给他上了个一亿的保险，",
      "token_start": 1432,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 393730,
      "end_ms": 395295,
      "text": "一根石头值一个亿。",
      "token_start": 1449,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 395800,
      "end_ms": 399480,
      "text": "全中国独一份保险公司核保的时候，",
      "token_start": 1457,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 399520,
      "end_ms": 403630,
      "text": "光评估报告就写了几十页经办人。",
      "token_start": 1472,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 403630,
      "end_ms": 405580,
      "text": "后来跟人讲干了几十年，",
      "token_start": 1486,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 405620,
      "end_ms": 408575,
      "text": "保险头一回给一块石头当投保人。",
      "token_start": 1496,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 408900,
      "end_ms": 411975,
      "text": "您算算他一百年才长两毫米，",
      "token_start": 1510,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 412540,
      "end_ms": 416085,
      "text": "咱们活一辈子在他身上也就添了薄薄一层。",
      "token_start": 1522,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 416970,
      "end_ms": 421625,
      "text": "可就是这么一根石头保险公司认了他值一个亿。",
      "token_start": 1540,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 423050,
      "end_ms": 425375,
      "text": "您说这个第一名服不服？",
      "token_start": 1560,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 425830,
      "end_ms": 427115,
      "text": "您听出来了没有？",
      "token_start": 1570,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 427640,
      "end_ms": 434035,
      "text": "这十个溶洞没有一个是光靠好看出名的雪玉洞的石头是个小姑娘。",
      "token_start": 1577,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 434260,
      "end_ms": 436875,
      "text": "本溪水洞飘着一条地下银河，",
      "token_start": 1605,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 437630,
      "end_ms": 439715,
      "text": "万华岩的瀑布会变色，",
      "token_start": 1617,
      "token_end_exclusive": 1626
    },
    {
      "start_ms": 440100,
      "end_ms": 442045,
      "text": "腾龙洞吞了一整条江，",
      "token_start": 1626,
      "token_end_exclusive": 1635
    },
    {
      "start_ms": 442530,
      "end_ms": 444725,
      "text": "芙蓉洞的池子会发光。",
      "token_start": 1635,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 445680,
      "end_ms": 447810,
      "text": "银与树是水做的卢迪，",
      "token_start": 1644,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 447810,
      "end_ms": 448875,
      "text": "岩是保命洞，",
      "token_start": 1653,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 449460,
      "end_ms": 454925,
      "text": "双河洞藏着五十二具大熊猫摇林仙境是石头长的瀑布，",
      "token_start": 1658,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 455410,
      "end_ms": 457355,
      "text": "定海神针值一个亿。",
      "token_start": 1681,
      "token_end_exclusive": 1689
    },
    {
      "start_ms": 457880,
      "end_ms": 461035,
      "text": "每一个洞的厉害之处都不在他有多大，",
      "token_start": 1689,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 461830,
      "end_ms": 463295,
      "text": "在他藏着什么秘密？",
      "token_start": 1705,
      "token_end_exclusive": 1713
    },
    {
      "start_ms": 463840,
      "end_ms": 466745,
      "text": "这十个里头您觉得哪个最离谱？",
      "token_start": 1713,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 467040,
      "end_ms": 468575,
      "text": "评论区打个序号就行，",
      "token_start": 1726,
      "token_end_exclusive": 1735
    },
    {
      "start_ms": 468930,
      "end_ms": 471090,
      "text": "我看看大伙儿的眼光一不一样，",
      "token_start": 1735,
      "token_end_exclusive": 1748
    },
    {
      "start_ms": 471150,
      "end_ms": 471850,
      "text": "点个关注，",
      "token_start": 1748,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 472030,
      "end_ms": 473635,
      "text": "咱们下期接着聊。",
      "token_start": 1752,
      "token_end_exclusive": 1759
    }
  ],
