{
  "video_id": "v_c44a594675438138",
  "duration_s": 460.590998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c44a594675438138.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c44a594675438138.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 2610,
      "text": "四岁被通缉八岁去坐牢，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2970,
      "end_ms": 4290,
      "text": "十岁爬着回家。",
      "token_start": 10,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4530,
      "end_ms": 5370,
      "text": "三十年后，",
      "token_start": 16,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5570,
      "end_ms": 7350,
      "text": "他让整个西方闭嘴，",
      "token_start": 20,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7870,
      "end_ms": 9550,
      "text": "家人们你敢信吗？",
      "token_start": 28,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 10210,
      "end_ms": 14890,
      "text": "一个四岁的孩子被国民党悬赏通缉膝，",
      "token_start": 35,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 14890,
      "end_ms": 17030,
      "text": "中国年纪最小的政治犯，",
      "token_start": 51,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 17290,
      "end_ms": 19130,
      "text": "八岁被关进大牢，",
      "token_start": 61,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 19250,
      "end_ms": 21710,
      "text": "被吊起来打打的不成人形。",
      "token_start": 68,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 22190,
      "end_ms": 23390,
      "text": "十岁后出狱，",
      "token_start": 79,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 23690,
      "end_ms": 25710,
      "text": "两条腿烂的站都站不起来，",
      "token_start": 84,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 26090,
      "end_ms": 28350,
      "text": "硬是沿着铁路爬了十几公里，",
      "token_start": 95,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 28750,
      "end_ms": 30540,
      "text": "膝盖磨的血肉模模糊，",
      "token_start": 107,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 30820,
      "end_ms": 32740,
      "text": "才爬回养母家的门口。",
      "token_start": 116,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 33160,
      "end_ms": 34360,
      "text": "就这么一个孩子，",
      "token_start": 125,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 34420,
      "end_ms": 37660,
      "text": "三十年后亲手造出了核潜艇，",
      "token_start": 132,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38039,
      "end_ms": 43340,
      "text": "让那些曾经看不起中国的西方大国一个个都闭上了嘴。",
      "token_start": 144,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 43880,
      "end_ms": 45000,
      "text": "他叫彭士路，",
      "token_start": 167,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 45480,
      "end_ms": 48600,
      "text": "中国核潜艇第一任总设计师，",
      "token_start": 172,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 49340,
      "end_ms": 52620,
      "text": "人们叫他中国核潜艇之父。",
      "token_start": 184,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 53300,
      "end_ms": 55840,
      "text": "先说他那个让人揪心的童年吧。",
      "token_start": 195,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 56380,
      "end_ms": 57460,
      "text": "一九二五年，",
      "token_start": 208,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 57880,
      "end_ms": 59140,
      "text": "彭士路出生，",
      "token_start": 213,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 59140,
      "end_ms": 62670,
      "text": "在广东海风他爹叫澎湃，",
      "token_start": 218,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 62930,
      "end_ms": 65185,
      "text": "是共产党早期的大人物，",
      "token_start": 228,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 65650,
      "end_ms": 69875,
      "text": "领着农民闹革命的那就在三岁那年，",
      "token_start": 238,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 70540,
      "end_ms": 71860,
      "text": "他妈被捕入狱，",
      "token_start": 253,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 71940,
      "end_ms": 74005,
      "text": "牺牲了四岁那年，",
      "token_start": 259,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 74260,
      "end_ms": 76495,
      "text": "他爹在上海被捕入狱，",
      "token_start": 266,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 77410,
      "end_ms": 78535,
      "text": "临行行前，",
      "token_start": 275,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 79010,
      "end_ms": 80505,
      "text": "高唱着国际歌。",
      "token_start": 279,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 81250,
      "end_ms": 82385,
      "text": "三十三岁啊，",
      "token_start": 285,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 82820,
      "end_ms": 83805,
      "text": "慷慨赴死。",
      "token_start": 290,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 84310,
      "end_ms": 87800,
      "text": "四岁的孩子连死是啥意思？",
      "token_start": 294,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 87800,
      "end_ms": 88225,
      "text": "都不懂，",
      "token_start": 305,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 88790,
      "end_ms": 90765,
      "text": "就成了敌人眼里的祸根。",
      "token_start": 308,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 91290,
      "end_ms": 92625,
      "text": "敌人放出狠话，",
      "token_start": 318,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 92980,
      "end_ms": 93925,
      "text": "斩草除根，",
      "token_start": 324,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 94490,
      "end_ms": 98805,
      "text": "通缉令贴的到处都是悬赏要这个四岁娃娃的命。",
      "token_start": 328,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 99060,
      "end_ms": 100805,
      "text": "你想想四岁啊，",
      "token_start": 348,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 101030,
      "end_ms": 104745,
      "text": "和现在的孩子们还在幼儿园里抢玩具呢，",
      "token_start": 354,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 105720,
      "end_ms": 109405,
      "text": "彭氏路四岁就已经开始逃命了，",
      "token_start": 371,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 109620,
      "end_ms": 111220,
      "text": "是老百姓拿命护的。",
      "token_start": 384,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 111220,
      "end_ms": 113180,
      "text": "他海封那边，",
      "token_start": 392,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 113180,
      "end_ms": 115570,
      "text": "二十多户穷苦人家东家，",
      "token_start": 397,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 115570,
      "end_ms": 116350,
      "text": "塞一口红薯，",
      "token_start": 407,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 116350,
      "end_ms": 117880,
      "text": "给他戚家，",
      "token_start": 412,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 117880,
      "end_ms": 119205,
      "text": "给他补一件旧衣裳。",
      "token_start": 416,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 120080,
      "end_ms": 121080,
      "text": "你那藏几天，",
      "token_start": 424,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 121180,
      "end_ms": 122220,
      "text": "我这躲几个月，",
      "token_start": 429,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 122640,
      "end_ms": 126100,
      "text": "硬是把烈士的这根独苗护了下来。",
      "token_start": 435,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 126420,
      "end_ms": 127320,
      "text": "在那个年代，",
      "token_start": 449,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 127320,
      "end_ms": 130880,
      "text": "藏一个革命者的孩子抓住是要掉脑袋的，",
      "token_start": 454,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 131560,
      "end_ms": 133620,
      "text": "可没有一个人怕八岁那年，",
      "token_start": 471,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 134040,
      "end_ms": 135505,
      "text": "他还是被抓住了，",
      "token_start": 482,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 137350,
      "end_ms": 140150,
      "text": "关进了大牢牢里是个啥日子。",
      "token_start": 489,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 140530,
      "end_ms": 143450,
      "text": "饭里混着沙子泥和虫子，",
      "token_start": 501,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 143710,
      "end_ms": 145470,
      "text": "身上爬满了石子，",
      "token_start": 511,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 145490,
      "end_ms": 147330,
      "text": "盖的是发臭的破麻袋。",
      "token_start": 518,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 148170,
      "end_ms": 150970,
      "text": "敌人逼他承认自己是澎湃的儿子，",
      "token_start": 527,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 151030,
      "end_ms": 151630,
      "text": "他不说，",
      "token_start": 541,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 152390,
      "end_ms": 154490,
      "text": "敌人就把养他的姑妈抓来，",
      "token_start": 544,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 154710,
      "end_ms": 158330,
      "text": "把人倒吊起来灌辣椒水，",
      "token_start": 555,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 158770,
      "end_ms": 159590,
      "text": "逼他开口，",
      "token_start": 565,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 160790,
      "end_ms": 163250,
      "text": "那个农村妇女咬碎了牙，",
      "token_start": 569,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 163250,
      "end_ms": 165710,
      "text": "半个字儿都没往外吐。",
      "token_start": 579,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 166550,
      "end_ms": 171240,
      "text": "后来狱友们护着他他才被放出来。",
      "token_start": 588,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 172160,
      "end_ms": 172720,
      "text": "那一年，",
      "token_start": 602,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 173760,
      "end_ms": 174640,
      "text": "他十岁，",
      "token_start": 605,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 174900,
      "end_ms": 178040,
      "text": "两条腿已经被折磨的走不了路了。",
      "token_start": 608,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 178380,
      "end_ms": 179480,
      "text": "他拖着烂腿，",
      "token_start": 622,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 179720,
      "end_ms": 182305,
      "text": "顺着铁道爬爬了十几公里，",
      "token_start": 627,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 182610,
      "end_ms": 184570,
      "text": "膝盖被磨的全是血，",
      "token_start": 638,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 184750,
      "end_ms": 186110,
      "text": "才爬回养母。",
      "token_start": 646,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 186110,
      "end_ms": 187445,
      "text": "家家人们，",
      "token_start": 651,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 187970,
      "end_ms": 190685,
      "text": "你听听这是个十岁的孩子啊，",
      "token_start": 655,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 191230,
      "end_ms": 194530,
      "text": "别人家孩子十岁还在爹妈的怀里撒娇，",
      "token_start": 667,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 194830,
      "end_ms": 195785,
      "text": "他才十岁，",
      "token_start": 683,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 196210,
      "end_ms": 199255,
      "text": "是拿命顺着铁道爬着回来的。",
      "token_start": 687,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 199960,
      "end_ms": 201245,
      "text": "后来他又被抓过，",
      "token_start": 699,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 201660,
      "end_ms": 202525,
      "text": "又逃出来，",
      "token_start": 706,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 203230,
      "end_ms": 205355,
      "text": "从流浪再到乞讨，",
      "token_start": 710,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 205730,
      "end_ms": 207485,
      "text": "后来东躲西藏，",
      "token_start": 717,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 207970,
      "end_ms": 211695,
      "text": "以至于整个童年全是踩着刀尖过来。",
      "token_start": 723,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 213180,
      "end_ms": 214595,
      "text": "直到一九四零年，",
      "token_start": 738,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 215220,
      "end_ms": 217655,
      "text": "周恩来总理派人辗转找到了他。",
      "token_start": 745,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 218530,
      "end_ms": 219925,
      "text": "周总理握着他的手，",
      "token_start": 758,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 220750,
      "end_ms": 221390,
      "text": "说了一句，",
      "token_start": 766,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 221450,
      "end_ms": 225515,
      "text": "孩子终于找到你了。",
      "token_start": 770,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 227040,
      "end_ms": 230415,
      "text": "十五岁的彭氏路被送到延安，",
      "token_start": 778,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 231420,
      "end_ms": 235245,
      "text": "这才算第一次有了家的感觉。",
      "token_start": 790,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 236760,
      "end_ms": 237795,
      "text": "后来有人问他，",
      "token_start": 802,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 239520,
      "end_ms": 240385,
      "text": "吃了这么多苦，",
      "token_start": 808,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 242570,
      "end_ms": 243305,
      "text": "你恨不恨，",
      "token_start": 814,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 243690,
      "end_ms": 244105,
      "text": "他说，",
      "token_start": 818,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 244380,
      "end_ms": 244935,
      "text": "我不恨，",
      "token_start": 820,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 245460,
      "end_ms": 247315,
      "text": "我这辈子都感激老百姓，",
      "token_start": 823,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 247740,
      "end_ms": 249695,
      "text": "是他们给了我第二条生命。",
      "token_start": 833,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 250760,
      "end_ms": 251245,
      "text": "家人们，",
      "token_start": 844,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 251730,
      "end_ms": 253375,
      "text": "你品品这句话，",
      "token_start": 847,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 253740,
      "end_ms": 255685,
      "text": "换个人遭了这些罪，",
      "token_start": 853,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 256080,
      "end_ms": 257695,
      "text": "心里得有多大怨气，",
      "token_start": 861,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 258300,
      "end_ms": 263705,
      "text": "可他呢不恨他记着的全是恩情。",
      "token_start": 869,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 264710,
      "end_ms": 265665,
      "text": "一九五一年，",
      "token_start": 882,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 266610,
      "end_ms": 269350,
      "text": "彭石路考上公派留苏的名额，",
      "token_start": 887,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 269470,
      "end_ms": 271995,
      "text": "去苏联学化工机械。",
      "token_start": 899,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 272700,
      "end_ms": 275785,
      "text": "一九五六年离毕业还有几个月，",
      "token_start": 907,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 276230,
      "end_ms": 278565,
      "text": "陈赓大将突然召见他，",
      "token_start": 920,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 278830,
      "end_ms": 279705,
      "text": "就问他一句，",
      "token_start": 929,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 280320,
      "end_ms": 281965,
      "text": "国家要搞核动力，",
      "token_start": 934,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 282280,
      "end_ms": 283315,
      "text": "需要你改行，",
      "token_start": 941,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 283950,
      "end_ms": 284705,
      "text": "你愿意吗？",
      "token_start": 946,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 286060,
      "end_ms": 287270,
      "text": "他连犹豫都没有，",
      "token_start": 950,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 288170,
      "end_ms": 290265,
      "text": "只要祖国需要我，",
      "token_start": 957,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 290620,
      "end_ms": 291705,
      "text": "我愿意贡献。",
      "token_start": 964,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 291930,
      "end_ms": 294375,
      "text": "请就这一句话，",
      "token_start": 969,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 294960,
      "end_ms": 296295,
      "text": "他把自己的名字。",
      "token_start": 975,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 297330,
      "end_ms": 301030,
      "text": "从公众视野里抹掉了整整三十年。",
      "token_start": 982,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 301550,
      "end_ms": 302770,
      "text": "那时候搞核潜艇，",
      "token_start": 996,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 302950,
      "end_ms": 305170,
      "text": "咱们手里有啥没有图纸，",
      "token_start": 1003,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 305310,
      "end_ms": 306050,
      "text": "没有专家，",
      "token_start": 1013,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 306210,
      "end_ms": 306950,
      "text": "没有资料，",
      "token_start": 1017,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 307070,
      "end_ms": 312030,
      "text": "全部的家底就是几张国外报纸上的模糊照片。",
      "token_start": 1021,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 312650,
      "end_ms": 314130,
      "text": "西方大国嘲笑到，",
      "token_start": 1040,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 314510,
      "end_ms": 317790,
      "text": "中国人想搞核潜艇再等二十年嘛。",
      "token_start": 1047,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 318170,
      "end_ms": 320110,
      "text": "可彭时禄带着几百号人，",
      "token_start": 1061,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 320750,
      "end_ms": 323410,
      "text": "一头扎进四川的深山老林。",
      "token_start": 1071,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 323870,
      "end_ms": 324910,
      "text": "没有计算机，",
      "token_start": 1082,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 325250,
      "end_ms": 326170,
      "text": "就靠算盘，",
      "token_start": 1087,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 326530,
      "end_ms": 330140,
      "text": "计算齿手摇、计算器、三班倒，",
      "token_start": 1091,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 330420,
      "end_ms": 332240,
      "text": "连轴算油灯。",
      "token_start": 1102,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 332400,
      "end_ms": 333680,
      "text": "拨到凌晨三点，",
      "token_start": 1107,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 334000,
      "end_ms": 336100,
      "text": "算盘珠子噼里啪啦响个不停，",
      "token_start": 1113,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 336580,
      "end_ms": 337480,
      "text": "十几万个。",
      "token_start": 1125,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 337480,
      "end_ms": 341880,
      "text": "核心数据硬是用人手一遍遍的算出来，",
      "token_start": 1129,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 342080,
      "end_ms": 344080,
      "text": "草稿纸堆的比人还高，",
      "token_start": 1145,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 344320,
      "end_ms": 346180,
      "text": "装满三个大铁皮柜，",
      "token_start": 1154,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 346640,
      "end_ms": 347660,
      "text": "粮食不够吃，",
      "token_start": 1162,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 348100,
      "end_ms": 348740,
      "text": "挖野菜，",
      "token_start": 1167,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 348940,
      "end_ms": 349700,
      "text": "啃菜根，",
      "token_start": 1170,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 349940,
      "end_ms": 350840,
      "text": "没人喊苦。",
      "token_start": 1173,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 351340,
      "end_ms": 352580,
      "text": "数据算错了，",
      "token_start": 1177,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 352740,
      "end_ms": 353780,
      "text": "推倒重来，",
      "token_start": 1182,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 353980,
      "end_ms": 355545,
      "text": "没人抱怨。",
      "token_start": 1186,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 356580,
      "end_ms": 358535,
      "text": "一九七零年八月三十，",
      "token_start": 1190,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 359090,
      "end_ms": 362105,
      "text": "核潜艇反应堆首次达到满功率。",
      "token_start": 1199,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 362590,
      "end_ms": 364415,
      "text": "整个深山都沸腾了，",
      "token_start": 1212,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 364860,
      "end_ms": 366295,
      "text": "哭的哭喊的喊，",
      "token_start": 1220,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 366590,
      "end_ms": 367685,
      "text": "有人蹲在地上，",
      "token_start": 1226,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 368010,
      "end_ms": 369605,
      "text": "眼泪砸进泥里。",
      "token_start": 1232,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 370230,
      "end_ms": 371175,
      "text": "可没人知道，",
      "token_start": 1238,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 371520,
      "end_ms": 375925,
      "text": "总设计师彭石路已经连续五天五夜没合眼。",
      "token_start": 1243,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 376910,
      "end_ms": 378565,
      "text": "消息传来的那一刻，",
      "token_start": 1261,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 378960,
      "end_ms": 382345,
      "text": "他靠在墙角直接昏睡了过去。",
      "token_start": 1269,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 383290,
      "end_ms": 384535,
      "text": "同年十二月，",
      "token_start": 1281,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 385310,
      "end_ms": 391435,
      "text": "中国第一艘核潜艇下水四点六万个零件全部国产，",
      "token_start": 1286,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 392560,
      "end_ms": 397695,
      "text": "中国成了世界上第五个拥有核潜艇的国家。",
      "token_start": 1307,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 398190,
      "end_ms": 399965,
      "text": "那些说再等二十年的人，",
      "token_start": 1325,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 400220,
      "end_ms": 401005,
      "text": "全都闭着嘴。",
      "token_start": 1335,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 401780,
      "end_ms": 402265,
      "text": "家人们，",
      "token_start": 1340,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 402630,
      "end_ms": 404135,
      "text": "你频频这反差。",
      "token_start": 1343,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 404530,
      "end_ms": 406385,
      "text": "四岁被通缉的孤儿，",
      "token_start": 1349,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 406780,
      "end_ms": 408615,
      "text": "八岁坐牢的小政治犯，",
      "token_start": 1357,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 409060,
      "end_ms": 411295,
      "text": "十岁爬着回家的苦孩子，",
      "token_start": 1366,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 411850,
      "end_ms": 416135,
      "text": "最后亲手给新中国筑起了镇海重器。",
      "token_start": 1376,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 417110,
      "end_ms": 417790,
      "text": "小时候，",
      "token_start": 1391,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 418150,
      "end_ms": 420410,
      "text": "老百姓用命护住了他，",
      "token_start": 1394,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 420470,
      "end_ms": 421130,
      "text": "长大后，",
      "token_start": 1403,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 421410,
      "end_ms": 425490,
      "text": "他用一辈子的命护住了十四亿人的安稳。",
      "token_start": 1406,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 425950,
      "end_ms": 427050,
      "text": "彭时路常说，",
      "token_start": 1423,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 427410,
      "end_ms": 429690,
      "text": "我这条命是捡回来的，",
      "token_start": 1428,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 430050,
      "end_ms": 431430,
      "text": "可这捡回来的命，",
      "token_start": 1437,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 431690,
      "end_ms": 434830,
      "text": "他一分一毫全交给了国家，",
      "token_start": 1444,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 435330,
      "end_ms": 440270,
      "text": "觉得彭老了不起的评论区打致敬英雄四个字，",
      "token_start": 1455,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 440470,
      "end_ms": 441590,
      "text": "点亮小红心，",
      "token_start": 1474,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 441950,
      "end_ms": 444530,
      "text": "让更多人看见这份骨气，",
      "token_start": 1479,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 445190,
      "end_ms": 449220,
      "text": "把这条视频命到家庭群讲给孩子听。",
      "token_start": 1489,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 449700,
      "end_ms": 452800,
      "text": "今天的安稳日子是拿什么换来的？",
      "token_start": 1504,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 453060,
      "end_ms": 453940,
      "text": "点个收藏，",
      "token_start": 1518,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 454240,
      "end_ms": 455540,
      "text": "随时翻出来讲，",
      "token_start": 1522,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 455680,
      "end_ms": 456260,
      "text": "关注我，",
      "token_start": 1528,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 456500,
      "end_ms": 460465,
      "text": "咱们一起把先辈的故事一代代传下去。",
      "token_start": 1531,
      "token_end_exclusive": 1547
    }
  ],
