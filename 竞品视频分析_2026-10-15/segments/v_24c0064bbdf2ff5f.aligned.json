{
  "video_id": "v_24c0064bbdf2ff5f",
  "duration_s": 429.827586,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_24c0064bbdf2ff5f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_24c0064bbdf2ff5f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1470,
      "text": "上世纪五十年代，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1870,
      "end_ms": 5290,
      "text": "北京天桥派出所抓了个捡废铁的老头，",
      "token_start": 7,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5750,
      "end_ms": 6770,
      "text": "穿的破破烂烂，",
      "token_start": 23,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 7290,
      "end_ms": 9390,
      "text": "弯腰在垃圾堆里翻金属，",
      "token_start": 29,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9690,
      "end_ms": 10855,
      "text": "翻了大半天。",
      "token_start": 39,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 13250,
      "end_ms": 14070,
      "text": "民警一看，",
      "token_start": 44,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 14490,
      "end_ms": 15550,
      "text": "这不是小偷，",
      "token_start": 48,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 15550,
      "end_ms": 16570,
      "text": "就是搞破坏的，",
      "token_start": 53,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 16690,
      "end_ms": 17890,
      "text": "直接给扣了。",
      "token_start": 59,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 18690,
      "end_ms": 20230,
      "text": "老头急得直解释，",
      "token_start": 64,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 20550,
      "end_ms": 21250,
      "text": "没人信，",
      "token_start": 71,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 21610,
      "end_ms": 24050,
      "text": "一个捡破烂的能有什么来头？",
      "token_start": 74,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 24790,
      "end_ms": 26070,
      "text": "直到一个小时后，",
      "token_start": 86,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 26370,
      "end_ms": 28290,
      "text": "钱三强亲自跑来了，",
      "token_start": 93,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 28710,
      "end_ms": 29850,
      "text": "进门第一句话，",
      "token_start": 101,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 30190,
      "end_ms": 31890,
      "text": "全场民警全傻了。",
      "token_start": 107,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 32130,
      "end_ms": 33510,
      "text": "你们知道他是谁吗？",
      "token_start": 114,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 34030,
      "end_ms": 36790,
      "text": "他是我们国家最珍贵的大脑，",
      "token_start": 122,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 36830,
      "end_ms": 40570,
      "text": "这个被当成小偷抓的老头叫彭环武，",
      "token_start": 134,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 41210,
      "end_ms": 42815,
      "text": "你可能没听过这名字。",
      "token_start": 149,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 43370,
      "end_ms": 44330,
      "text": "但我告诉你，",
      "token_start": 158,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 44710,
      "end_ms": 59655,
      "text": "中国第一颗原子弹、第一颗氢弹理论设计背后掌舵的人就是他邓稼先、周光照、俞敏这些如雷贯耳的名字全是他一手带出来的，",
      "token_start": 163,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 60020,
      "end_ms": 60865,
      "text": "你敢信吗？",
      "token_start": 215,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 61860,
      "end_ms": 63885,
      "text": "这么一位国之栋梁，",
      "token_start": 219,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 64280,
      "end_ms": 66580,
      "text": "当年在天桥减肥一体，",
      "token_start": 227,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 66980,
      "end_ms": 68165,
      "text": "被人当小偷抓。",
      "token_start": 236,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 69150,
      "end_ms": 70635,
      "text": "但这还不是最狠的。",
      "token_start": 242,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 71800,
      "end_ms": 74105,
      "text": "时间倒回一九三八年，",
      "token_start": 250,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 74310,
      "end_ms": 78515,
      "text": "二十三岁的彭焕武考上了国家公派留学，",
      "token_start": 259,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 78880,
      "end_ms": 82200,
      "text": "拿着这笔钱去英国读博了拜。",
      "token_start": 276,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 82260,
      "end_ms": 87075,
      "text": "在量子力学奠基人波恩门下伯恩是谁？",
      "token_start": 288,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 88040,
      "end_ms": 92310,
      "text": "爱因斯坦三十年的老友诺贝尔物理学奖得主。",
      "token_start": 304,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 92490,
      "end_ms": 94035,
      "text": "他给爱因斯坦写信，",
      "token_start": 323,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 94420,
      "end_ms": 96295,
      "text": "专门夸这个中国学生，",
      "token_start": 331,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 96710,
      "end_ms": 99685,
      "text": "彭桓武比我其他所有学生都聪明能干，",
      "token_start": 340,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 100050,
      "end_ms": 101135,
      "text": "好像什么都懂。",
      "token_start": 356,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 101660,
      "end_ms": 105580,
      "text": "薛定谔就是搞薛定谔的猫，",
      "token_start": 362,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 105680,
      "end_ms": 108315,
      "text": "那位大神也惊叹，",
      "token_start": 373,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 108600,
      "end_ms": 111550,
      "text": "不敢相信这年轻人学了那么多，",
      "token_start": 380,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 111650,
      "end_ms": 112695,
      "text": "理解的那么快。",
      "token_start": 393,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 113200,
      "end_ms": 114820,
      "text": "二十五岁哲学博士，",
      "token_start": 399,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 115180,
      "end_ms": 122830,
      "text": "三十岁科学博士三十三岁当选爱尔兰皇家科学院院士、欧洲顶尖机构，",
      "token_start": 407,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 123030,
      "end_ms": 129235,
      "text": "抢着给终身教职天价薪资顶级实验室永久居住权。",
      "token_start": 436,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 129680,
      "end_ms": 132965,
      "text": "全世界都觉得这中国人铁定留西方了。",
      "token_start": 457,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 133920,
      "end_ms": 135545,
      "text": "可一九四七年冬天，",
      "token_start": 473,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 135930,
      "end_ms": 137030,
      "text": "彭环武干的件，",
      "token_start": 481,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 137070,
      "end_ms": 138570,
      "text": "所有人都看不懂的事，",
      "token_start": 487,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 139090,
      "end_ms": 140070,
      "text": "变卖欧洲，",
      "token_start": 496,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 140090,
      "end_ms": 141970,
      "text": "全部家产一分不留，",
      "token_start": 500,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 142210,
      "end_ms": 144255,
      "text": "只买了一张回国的船票。",
      "token_start": 508,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 145190,
      "end_ms": 146030,
      "text": "有人问他，",
      "token_start": 518,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 146230,
      "end_ms": 147470,
      "text": "国外什么都有了，",
      "token_start": 522,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 147470,
      "end_ms": 148245,
      "text": "干嘛回去？",
      "token_start": 529,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 148520,
      "end_ms": 150135,
      "text": "彭欢武当场不高兴了，",
      "token_start": 533,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 150790,
      "end_ms": 152005,
      "text": "这问题不该这么问。",
      "token_start": 542,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 152840,
      "end_ms": 155905,
      "text": "该问的是为什么不回国？",
      "token_start": 550,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 156860,
      "end_ms": 159270,
      "text": "后来这句话传了，",
      "token_start": 560,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 159270,
      "end_ms": 161650,
      "text": "半个世纪回国，",
      "token_start": 567,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 161650,
      "end_ms": 165205,
      "text": "不需要理由不回国才需要理由，",
      "token_start": 573,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 165550,
      "end_ms": 166485,
      "text": "硬不硬气。",
      "token_start": 586,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 167100,
      "end_ms": 168205,
      "text": "可回国之后呢，",
      "token_start": 590,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 168470,
      "end_ms": 169305,
      "text": "一穷二白，",
      "token_start": 596,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 169660,
      "end_ms": 172105,
      "text": "要啥没啥研究所刚成立，",
      "token_start": 600,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 172350,
      "end_ms": 174135,
      "text": "连实验仪器都买不起。",
      "token_start": 610,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 174670,
      "end_ms": 177610,
      "text": "前三强发动大家去旧货市场捡零件，",
      "token_start": 619,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 177610,
      "end_ms": 178255,
      "text": "自己做。",
      "token_start": 634,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 178810,
      "end_ms": 182070,
      "text": "彭黄武已经是爱尔兰皇家科学院院士了，",
      "token_start": 637,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 182090,
      "end_ms": 184655,
      "text": "照样跟年轻人一起跑天桥翻垃圾，",
      "token_start": 654,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 184960,
      "end_ms": 187075,
      "text": "翻着翻着就被民警抓了。",
      "token_start": 668,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 187580,
      "end_ms": 189165,
      "text": "这就是开头那一幕，",
      "token_start": 678,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 189530,
      "end_ms": 191035,
      "text": "你以为这就够难了，",
      "token_start": 686,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 191380,
      "end_ms": 192815,
      "text": "更狠的还在后面。",
      "token_start": 694,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 193290,
      "end_ms": 199180,
      "text": "一九五九年苏联专家全线撤离图纸设备数据，",
      "token_start": 701,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 199420,
      "end_ms": 200455,
      "text": "一个字没留下。",
      "token_start": 720,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 200970,
      "end_ms": 202835,
      "text": "西方媒体公开嘲讽，",
      "token_start": 726,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 203120,
      "end_ms": 207770,
      "text": "中国二十年也造不出核武器国家。",
      "token_start": 734,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 207790,
      "end_ms": 208655,
      "text": "一声号令，",
      "token_start": 748,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 209120,
      "end_ms": 211840,
      "text": "彭黄武带着一群年轻人扎进戈壁。",
      "token_start": 752,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 211840,
      "end_ms": 212295,
      "text": "荒漠，",
      "token_start": 766,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 212690,
      "end_ms": 214405,
      "text": "没有高级计算机怎么办？",
      "token_start": 768,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 214740,
      "end_ms": 216305,
      "text": "靠算盘、靠计算尺，",
      "token_start": 778,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 216630,
      "end_ms": 221305,
      "text": "靠手写亿万组精密数据一笔一笔手算出来。",
      "token_start": 785,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 221790,
      "end_ms": 222495,
      "text": "讨论会上，",
      "token_start": 803,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 222800,
      "end_ms": 223960,
      "text": "有人不敢开口，",
      "token_start": 807,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 224120,
      "end_ms": 224780,
      "text": "怕说错。",
      "token_start": 813,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 224780,
      "end_ms": 229825,
      "text": " Ip彭欢武拍桌子在原子弹面前没有老师，",
      "token_start": 816,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 230610,
      "end_ms": 233060,
      "text": "谁也不懂有想法，",
      "token_start": 833,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 233060,
      "end_ms": 238205,
      "text": "就说谁说的对听谁的就这么着。",
      "token_start": 840,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 239150,
      "end_ms": 247975,
      "text": "他带着邓稼先、周光照、黄祖恰于敏一帮人在简陋平房里，",
      "token_start": 853,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 248410,
      "end_ms": 251915,
      "text": "硬生生打通了核武器全部核心理论关卡，",
      "token_start": 876,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 252750,
      "end_ms": 254170,
      "text": "业内送他一个称号，",
      "token_start": 893,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 254250,
      "end_ms": 256710,
      "text": "培养物理学家的物理学家周光昭，",
      "token_start": 901,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 256710,
      "end_ms": 260810,
      "text": "后来说中国核物理、理论界差不多，",
      "token_start": 915,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 260830,
      "end_ms": 266495,
      "text": "所有后来的工作者都是彭桓武直接或间接的学生。",
      "token_start": 929,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 267100,
      "end_ms": 269145,
      "text": "一九六四年十月十六日，",
      "token_start": 950,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 269500,
      "end_ms": 272475,
      "text": "中国第一颗原子弹爆炸成功，",
      "token_start": 960,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 273200,
      "end_ms": 275700,
      "text": "罗布泊的蘑菇云冲上云霄，",
      "token_start": 972,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 276060,
      "end_ms": 277240,
      "text": "举国欢腾。",
      "token_start": 983,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 278160,
      "end_ms": 279160,
      "text": "庆功宴上，",
      "token_start": 987,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 279380,
      "end_ms": 283170,
      "text": "彭桓武提笔写下不是工农兵协力，",
      "token_start": 991,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 283390,
      "end_ms": 285435,
      "text": "焉得数理化成功，",
      "token_start": 1005,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 286040,
      "end_ms": 288135,
      "text": "功劳全给了集体。",
      "token_start": 1012,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 288610,
      "end_ms": 291590,
      "text": "后来国家自然科学奖一等奖的奖章送来，",
      "token_start": 1019,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 291610,
      "end_ms": 294170,
      "text": "他坚决不收奖章。",
      "token_start": 1036,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 294170,
      "end_ms": 294985,
      "text": "是我的了，",
      "token_start": 1043,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 295230,
      "end_ms": 298470,
      "text": "我把它送给九所扯过一张纸，",
      "token_start": 1047,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 298870,
      "end_ms": 300075,
      "text": "写下十四个字，",
      "token_start": 1059,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 301480,
      "end_ms": 307220,
      "text": "集体嗯集体集体日新。",
      "token_start": 1065,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 308570,
      "end_ms": 310235,
      "text": "日新日日新，",
      "token_start": 1074,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 312190,
      "end_ms": 312990,
      "text": "有人问他，",
      "token_start": 1079,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 313410,
      "end_ms": 315450,
      "text": "一辈子隐姓埋名，",
      "token_start": 1083,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 315870,
      "end_ms": 316950,
      "text": "默默奉献，",
      "token_start": 1090,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 317330,
      "end_ms": 317850,
      "text": "委屈，",
      "token_start": 1094,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 317850,
      "end_ms": 319650,
      "text": "不他淡淡一句，",
      "token_start": 1096,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 320130,
      "end_ms": 321130,
      "text": "我是中国人，",
      "token_start": 1102,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 321370,
      "end_ms": 323590,
      "text": "为国做事理所应当。",
      "token_start": 1107,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 325170,
      "end_ms": 325570,
      "text": "你看，",
      "token_start": 1115,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 326690,
      "end_ms": 329990,
      "text": "这就是彭黄武科研上的盖世天才，",
      "token_start": 1117,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 330670,
      "end_ms": 332870,
      "text": "生活里却笨得让人心疼，",
      "token_start": 1131,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 333470,
      "end_ms": 334370,
      "text": "不会做饭，",
      "token_start": 1141,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 334610,
      "end_ms": 336530,
      "text": "不会洗衣一辈子，",
      "token_start": 1145,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 336530,
      "end_ms": 338010,
      "text": "没搞懂军事旅团，",
      "token_start": 1152,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 338010,
      "end_ms": 340470,
      "text": "谁官大同事戴不戴眼镜，",
      "token_start": 1159,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 340610,
      "end_ms": 341665,
      "text": "他都记不住，",
      "token_start": 1169,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 342100,
      "end_ms": 343180,
      "text": "四十三岁了，",
      "token_start": 1174,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 343240,
      "end_ms": 344500,
      "text": "还是光棍一条。",
      "token_start": 1179,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 344980,
      "end_ms": 345880,
      "text": "直到有一天，",
      "token_start": 1185,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 346080,
      "end_ms": 347600,
      "text": "二姐叫她回家吃饭，",
      "token_start": 1190,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 348000,
      "end_ms": 350720,
      "text": "一进门看见一位陌生姑娘，",
      "token_start": 1198,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 350860,
      "end_ms": 352100,
      "text": "心里咯噔一下，",
      "token_start": 1209,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 352480,
      "end_ms": 353420,
      "text": "又是相亲，",
      "token_start": 1215,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 354060,
      "end_ms": 356160,
      "text": "可这一次他没抗拒，",
      "token_start": 1219,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 356580,
      "end_ms": 359980,
      "text": "因为看清眼前这位贤静端正的姑娘时，",
      "token_start": 1227,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 360420,
      "end_ms": 365080,
      "text": "她从心底里喜欢上了这位姑娘，",
      "token_start": 1243,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 365080,
      "end_ms": 366040,
      "text": "叫刘炳贤。",
      "token_start": 1256,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 366540,
      "end_ms": 368205,
      "text": "山东人护士。",
      "token_start": 1260,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 368890,
      "end_ms": 370025,
      "text": "谁也没想到，",
      "token_start": 1265,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 370350,
      "end_ms": 372690,
      "text": "这个生活不能自理的科学怪人，",
      "token_start": 1270,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 372790,
      "end_ms": 374230,
      "text": "写出去的表白信，",
      "token_start": 1283,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 374570,
      "end_ms": 376815,
      "text": "居然全在列自己的缺点。",
      "token_start": 1290,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 377530,
      "end_ms": 378955,
      "text": "而姑娘的回信，",
      "token_start": 1300,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 379360,
      "end_ms": 384315,
      "text": "让这个四十三岁的男人第一次感受到了家的温暖，",
      "token_start": 1306,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 385430,
      "end_ms": 387985,
      "text": "他们的故事才刚开始。",
      "token_start": 1327,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 389750,
      "end_ms": 391205,
      "text": "而这段感情，",
      "token_start": 1336,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 391740,
      "end_ms": 394315,
      "text": "后来让全中国都红了眼眶。",
      "token_start": 1341,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 394790,
      "end_ms": 395445,
      "text": "朋友们，",
      "token_start": 1352,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 395930,
      "end_ms": 397230,
      "text": "彭桓武的故事。",
      "token_start": 1355,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 397630,
      "end_ms": 398170,
      "text": "上集，",
      "token_start": 1361,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 398190,
      "end_ms": 399195,
      "text": "咱们讲到这儿，",
      "token_start": 1363,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 399790,
      "end_ms": 400485,
      "text": "下集，",
      "token_start": 1369,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 400870,
      "end_ms": 401630,
      "text": "我给你讲，",
      "token_start": 1371,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 401850,
      "end_ms": 405795,
      "text": "他和妻子刘炳贤那段跨越生死的感情，",
      "token_start": 1375,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 406420,
      "end_ms": 410765,
      "text": "还有他晚年把自己一切都捐出去的很近。",
      "token_start": 1391,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 411460,
      "end_ms": 413940,
      "text": "如果你也被这位老人打动了，",
      "token_start": 1408,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 413940,
      "end_ms": 414840,
      "text": "先点个赞，",
      "token_start": 1420,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 415040,
      "end_ms": 416035,
      "text": "再点收藏。",
      "token_start": 1424,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 416880,
      "end_ms": 418380,
      "text": "评论区留一句，",
      "token_start": 1428,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 418380,
      "end_ms": 418760,
      "text": "致敬。",
      "token_start": 1434,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 418760,
      "end_ms": 421695,
      "text": "彭老顺手转发给身边的人，",
      "token_start": 1436,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 422150,
      "end_ms": 425155,
      "text": "让更多人知道我们今天的和平日子。",
      "token_start": 1447,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 425470,
      "end_ms": 426630,
      "text": "是这样一群人。",
      "token_start": 1462,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 426650,
      "end_ms": 428785,
      "text": "拿命换来的关注我。",
      "token_start": 1468,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 429060,
      "end_ms": 429790,
      "text": "下集接着讲。",
      "token_start": 1476,
      "token_end_exclusive": 1481
    }
  ],
