{
  "video_id": "v_eb6c6f0c8993fb48",
  "duration_s": 578.013991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_eb6c6f0c8993fb48.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_eb6c6f0c8993fb48.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 3510,
      "text": "您知道中国深秋哪里的秋色最浓？",
      "token_start": 0,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 3830,
      "end_ms": 6330,
      "text": "咱们走起来又最舒坦的吗？",
      "token_start": 14,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6990,
      "end_ms": 11350,
      "text": "上回咱们盘点的中国十大最惊艳的深秋奇观。",
      "token_start": 25,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12010,
      "end_ms": 13390,
      "text": "好多朋友留言说，",
      "token_start": 44,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 13810,
      "end_ms": 15670,
      "text": "王老师啊景是真美，",
      "token_start": 51,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 16090,
      "end_ms": 17690,
      "text": "可动不动就爬大山，",
      "token_start": 59,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 17890,
      "end_ms": 19610,
      "text": "咱们这膝盖实在遭不住，",
      "token_start": 67,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 20210,
      "end_ms": 21830,
      "text": "有没有平平坦坦，",
      "token_start": 77,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 21990,
      "end_ms": 24650,
      "text": "不废腿就能看大景的地方有，",
      "token_start": 84,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 25090,
      "end_ms": 26190,
      "text": "而且不止一个。",
      "token_start": 96,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 26610,
      "end_ms": 28830,
      "text": "今天咱们盘点的这六个地方，",
      "token_start": 102,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 28990,
      "end_ms": 30300,
      "text": "一个比一个懂，",
      "token_start": 114,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 30580,
      "end_ms": 32800,
      "text": "咱们一个比一个有看头。",
      "token_start": 120,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 33060,
      "end_ms": 34000,
      "text": "有一个地方，",
      "token_start": 130,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 34180,
      "end_ms": 35920,
      "text": "咱们一步山路不用走，",
      "token_start": 135,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 36400,
      "end_ms": 38480,
      "text": "坐在平平稳稳的大画房里，",
      "token_start": 144,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 38660,
      "end_ms": 39320,
      "text": "一抬头，",
      "token_start": 155,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 39620,
      "end_ms": 40880,
      "text": "满江几百米，",
      "token_start": 158,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 40980,
      "end_ms": 42380,
      "text": "绝壁上全是红火。",
      "token_start": 163,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 42740,
      "end_ms": 44420,
      "text": "还有一个地方连着十来里，",
      "token_start": 170,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 44420,
      "end_ms": 45300,
      "text": "全是大平路，",
      "token_start": 181,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 45620,
      "end_ms": 48160,
      "text": "脚底下铺着厚厚的碎金毯子，",
      "token_start": 186,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 48540,
      "end_ms": 50140,
      "text": "踩上去软乎乎的，",
      "token_start": 198,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 50280,
      "end_ms": 51580,
      "text": "连鞋底都搁不着。",
      "token_start": 205,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 51940,
      "end_ms": 53820,
      "text": "看到这儿觉得有点意思的朋友，",
      "token_start": 212,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 54100,
      "end_ms": 55960,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 225,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 56320,
      "end_ms": 57220,
      "text": "再点个收藏，",
      "token_start": 235,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 57720,
      "end_ms": 58720,
      "text": "省得手一滑，",
      "token_start": 240,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 59020,
      "end_ms": 60010,
      "text": "咱们就错过了。",
      "token_start": 245,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 60110,
      "end_ms": 60320,
      "text": "嗯，",
      "token_start": 251,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 60550,
      "end_ms": 61185,
      "text": "第六名，",
      "token_start": 252,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 61560,
      "end_ms": 63075,
      "text": "北京房山坡峰岭，",
      "token_start": 255,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 63390,
      "end_ms": 65555,
      "text": "很多人只知道香山人挤人，",
      "token_start": 262,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 66140,
      "end_ms": 66820,
      "text": "却不知道，",
      "token_start": 273,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 66820,
      "end_ms": 73015,
      "text": "就在房山周口店的太行山脚下藏着一整座能走进去的大红山。",
      "token_start": 277,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 73860,
      "end_ms": 75415,
      "text": "这片山坡有多大。",
      "token_start": 303,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 75820,
      "end_ms": 79980,
      "text": "足足两千多亩里头扎扎实实长着二十多万株，",
      "token_start": 310,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 80000,
      "end_ms": 82690,
      "text": "黄雏树二十多万株，",
      "token_start": 329,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 82710,
      "end_ms": 84985,
      "text": "大树全在一座山上变红。",
      "token_start": 337,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 85490,
      "end_ms": 87205,
      "text": "你想那是多扎实的颜色？",
      "token_start": 347,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 87640,
      "end_ms": 89545,
      "text": "别处的红叶的翻山越岭，",
      "token_start": 357,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 89810,
      "end_ms": 90690,
      "text": "这儿是石板路，",
      "token_start": 367,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 90890,
      "end_ms": 91930,
      "text": "平平缓缓，",
      "token_start": 373,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 92170,
      "end_ms": 93465,
      "text": "两边全是黄区，",
      "token_start": 377,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 94200,
      "end_ms": 96105,
      "text": "红叶伸手就够得着。",
      "token_start": 383,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 96510,
      "end_ms": 97575,
      "text": "您想象一下，",
      "token_start": 391,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 98010,
      "end_ms": 100575,
      "text": "镜头从步道这头扫到那头，",
      "token_start": 396,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 101050,
      "end_ms": 101950,
      "text": "左边是红，",
      "token_start": 407,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 102130,
      "end_ms": 103075,
      "text": "右边是红，",
      "token_start": 411,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 103670,
      "end_ms": 104965,
      "text": "抬眼望过去，",
      "token_start": 415,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 105400,
      "end_ms": 107445,
      "text": "整面山坡都是大红色，",
      "token_start": 420,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 107930,
      "end_ms": 109145,
      "text": "您就陷在里头。",
      "token_start": 429,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 109570,
      "end_ms": 110245,
      "text": "风一过，",
      "token_start": 435,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 110550,
      "end_ms": 111445,
      "text": "叶子沙沙响，",
      "token_start": 438,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 111750,
      "end_ms": 114085,
      "text": "空气里一股清苦的树叶味。",
      "token_start": 443,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 114740,
      "end_ms": 117095,
      "text": "最佳时间是十月中下旬，",
      "token_start": 454,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 117330,
      "end_ms": 118255,
      "text": "到十一月初，",
      "token_start": 464,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 118770,
      "end_ms": 119450,
      "text": "去早了，",
      "token_start": 469,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 119450,
      "end_ms": 120405,
      "text": "叶子还泛黄，",
      "token_start": 472,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 120790,
      "end_ms": 121450,
      "text": "去晚了，",
      "token_start": 477,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 121470,
      "end_ms": 122725,
      "text": "一场风就熄了，",
      "token_start": 480,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 123070,
      "end_ms": 124455,
      "text": "不用爬险坡，",
      "token_start": 486,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 124810,
      "end_ms": 127575,
      "text": "就能把一整面红衫抱在怀里。",
      "token_start": 491,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 128220,
      "end_ms": 133075,
      "text": "您说这算不算秋天给北京人留的一扇家门口的窗？",
      "token_start": 503,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 133380,
      "end_ms": 134005,
      "text": "第五名，",
      "token_start": 524,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 134290,
      "end_ms": 141885,
      "text": "浙江长兴十里古银杏长廊湖州长兴县小浦镇八都渠从北方的红转到江南，",
      "token_start": 527,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 142250,
      "end_ms": 144205,
      "text": "换成了纯粹的金黄。",
      "token_start": 558,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 144660,
      "end_ms": 145815,
      "text": "这里有多少银杏，",
      "token_start": 566,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 146180,
      "end_ms": 148275,
      "text": "数万株连绵十来里，",
      "token_start": 573,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 148680,
      "end_ms": 149555,
      "text": "您琢磨一下，",
      "token_start": 581,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 150060,
      "end_ms": 153315,
      "text": "数万株银杏一起变黄是什么场面？",
      "token_start": 586,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 153720,
      "end_ms": 154720,
      "text": "这儿是平地，",
      "token_start": 600,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 154960,
      "end_ms": 155660,
      "text": "没有坡，",
      "token_start": 605,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 155860,
      "end_ms": 158705,
      "text": "要爬一条乡间路走下去，",
      "token_start": 608,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 159080,
      "end_ms": 161305,
      "text": "房前屋后都被金叶子遮满，",
      "token_start": 618,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 161570,
      "end_ms": 163255,
      "text": "小石桥上铺着碎金，",
      "token_start": 629,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 163620,
      "end_ms": 165195,
      "text": "脚下是厚厚的落叶，",
      "token_start": 637,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 165540,
      "end_ms": 167985,
      "text": "踩上去软软的风一吹，",
      "token_start": 645,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 168340,
      "end_ms": 170525,
      "text": "叶子打着圈儿落在肩膀上。",
      "token_start": 654,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 171060,
      "end_ms": 174400,
      "text": "最佳时间是十一月中下旬去早了，",
      "token_start": 665,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 174400,
      "end_ms": 176230,
      "text": "叶子还绿着去晚了，",
      "token_start": 679,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 176270,
      "end_ms": 179295,
      "text": "落得只剩一地黄平平的走，",
      "token_start": 687,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 179600,
      "end_ms": 181390,
      "text": "慢慢的看金子，",
      "token_start": 698,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 181590,
      "end_ms": 182765,
      "text": "就在您脚底下，",
      "token_start": 704,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 183190,
      "end_ms": 186165,
      "text": "腿脚不太利索的老人家也走的多。",
      "token_start": 710,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 186530,
      "end_ms": 187170,
      "text": "第四名，",
      "token_start": 724,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 187390,
      "end_ms": 192575,
      "text": "重庆巫山小三峡、八雾峡别处的秋天都在地面上，",
      "token_start": 727,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 192890,
      "end_ms": 196385,
      "text": "八雾峡的秋天全直挺挺立在江水两岸。",
      "token_start": 747,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 196750,
      "end_ms": 198485,
      "text": "这一回得换个看法，",
      "token_start": 763,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 198790,
      "end_ms": 199755,
      "text": "不在路上看，",
      "token_start": 771,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 200020,
      "end_ms": 204715,
      "text": "在船上看画坊稳稳的从碧绿的江水中间穿过去，",
      "token_start": 776,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 205190,
      "end_ms": 207370,
      "text": "两边是刀削一样的直立，",
      "token_start": 796,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 207390,
      "end_ms": 209155,
      "text": "崖壁近千米高，",
      "token_start": 806,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 209720,
      "end_ms": 212265,
      "text": "野蜂和黄裘就挂在崖壁上，",
      "token_start": 812,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 212560,
      "end_ms": 216865,
      "text": "红彤彤的一层一层往您头顶上压低头，",
      "token_start": 823,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 217250,
      "end_ms": 220335,
      "text": "翡翠绿的江水里又倒着一片红影，",
      "token_start": 839,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 220820,
      "end_ms": 223225,
      "text": "船桨划开水哗哗的响，",
      "token_start": 853,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 223740,
      "end_ms": 226105,
      "text": "江风带着凉气扑在脸上。",
      "token_start": 862,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 226500,
      "end_ms": 229055,
      "text": "最佳时间是十一月中旬到十二月初，",
      "token_start": 872,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 229470,
      "end_ms": 230050,
      "text": "去早了。",
      "token_start": 887,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 230050,
      "end_ms": 230715,
      "text": "红的不够，",
      "token_start": 890,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 231000,
      "end_ms": 232895,
      "text": "去晚的叶子都掉进水里，",
      "token_start": 894,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 233150,
      "end_ms": 234025,
      "text": "压上就空了。",
      "token_start": 904,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 234330,
      "end_ms": 236285,
      "text": "人在水上红在半空，",
      "token_start": 909,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 236650,
      "end_ms": 238095,
      "text": "这个角度别处给不了，",
      "token_start": 917,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 238410,
      "end_ms": 239410,
      "text": "您说这算不算？",
      "token_start": 926,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 239430,
      "end_ms": 239870,
      "text": "红叶？",
      "token_start": 932,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 239950,
      "end_ms": 240985,
      "text": "长到了天上，",
      "token_start": 934,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 241390,
      "end_ms": 242085,
      "text": "第三名，",
      "token_start": 939,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 242480,
      "end_ms": 246135,
      "text": "湖北随州千年银杏谷、随州市洛阳镇。",
      "token_start": 942,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 246710,
      "end_ms": 249105,
      "text": "这里的银杏不是一片树林，",
      "token_start": 957,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 249610,
      "end_ms": 252125,
      "text": "是三百多株上千年的老树。",
      "token_start": 968,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 252570,
      "end_ms": 256474,
      "text": "年纪最大的几颗至少从宋朝就站在这儿了。",
      "token_start": 979,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 256740,
      "end_ms": 258335,
      "text": "听过多少年的钟声，",
      "token_start": 997,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 258690,
      "end_ms": 260275,
      "text": "看过多少年的炊烟，",
      "token_start": 1005,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 260830,
      "end_ms": 262290,
      "text": "树干的好几个人，",
      "token_start": 1013,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 262510,
      "end_ms": 264165,
      "text": "手拉手才抱得过来。",
      "token_start": 1020,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 264650,
      "end_ms": 268175,
      "text": "一棵树的树冠就是一顶金色的大伞，",
      "token_start": 1028,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 268610,
      "end_ms": 270970,
      "text": "阳光从老枝杈的缝里漏下来，",
      "token_start": 1043,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 271150,
      "end_ms": 273405,
      "text": "把整个村子照成了金子，",
      "token_start": 1055,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 274010,
      "end_ms": 275870,
      "text": "落叶在地上积了几寸，",
      "token_start": 1065,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 275930,
      "end_ms": 277665,
      "text": "深一脚踩进去，",
      "token_start": 1074,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 278030,
      "end_ms": 278915,
      "text": "沙沙地响，",
      "token_start": 1080,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 279400,
      "end_ms": 281375,
      "text": "脚腕子都陷在里头。",
      "token_start": 1084,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 281810,
      "end_ms": 284405,
      "text": "最佳时间是十一月中旬前后，",
      "token_start": 1092,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 284700,
      "end_ms": 285575,
      "text": "就那么十来天，",
      "token_start": 1104,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 285940,
      "end_ms": 287725,
      "text": "长兴给您的是十里金路，",
      "token_start": 1110,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 288280,
      "end_ms": 290155,
      "text": "这儿给您的是一棵树。",
      "token_start": 1120,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 290470,
      "end_ms": 292310,
      "text": "撑起来的一整片天。",
      "token_start": 1129,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 292630,
      "end_ms": 293210,
      "text": "第二名，",
      "token_start": 1137,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 293510,
      "end_ms": 299670,
      "text": "环仁、枫林谷、辽宁本溪桓仁满族自治县长白山余脉深处，",
      "token_start": 1140,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 299990,
      "end_ms": 303750,
      "text": "森林覆盖率高达百分之九十八的红峰秘境。",
      "token_start": 1163,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 304050,
      "end_ms": 309010,
      "text": "这儿的红是关东大地上最浓、最霸道的一种。",
      "token_start": 1181,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 309350,
      "end_ms": 311290,
      "text": "九角峰是一角峰，",
      "token_start": 1199,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 311790,
      "end_ms": 313090,
      "text": "连绵好几万米，",
      "token_start": 1206,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 313570,
      "end_ms": 315650,
      "text": "您上到平缓的卧龙顶，",
      "token_start": 1212,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 315950,
      "end_ms": 316790,
      "text": "往下一看，",
      "token_start": 1221,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 317170,
      "end_ms": 319190,
      "text": "整片山岭像被人盗了。",
      "token_start": 1225,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 319190,
      "end_ms": 323880,
      "text": "一整桶红岩亮红色从脚边一直漫到天边，",
      "token_start": 1234,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 324440,
      "end_ms": 326880,
      "text": "风一吹向海浪在翻滚。",
      "token_start": 1251,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 327220,
      "end_ms": 330060,
      "text": "镜头从观景台一点点推出去，",
      "token_start": 1260,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 330240,
      "end_ms": 331300,
      "text": "不是几颗树，",
      "token_start": 1272,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 331300,
      "end_ms": 331540,
      "text": "红，",
      "token_start": 1277,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 331980,
      "end_ms": 333880,
      "text": "是整个山谷都在烧，",
      "token_start": 1278,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 334480,
      "end_ms": 336280,
      "text": "红到没有第二种颜色，",
      "token_start": 1286,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 336760,
      "end_ms": 339400,
      "text": "林子里一股凉丝丝的树叶味，",
      "token_start": 1295,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 339640,
      "end_ms": 341780,
      "text": "脚下的落叶咯吱咯吱响。",
      "token_start": 1307,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 342200,
      "end_ms": 345900,
      "text": "最佳时间是十月上旬到中旬去早了。",
      "token_start": 1317,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 345900,
      "end_ms": 346560,
      "text": "红的发浅，",
      "token_start": 1332,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 346780,
      "end_ms": 347300,
      "text": "去晚了，",
      "token_start": 1336,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 347300,
      "end_ms": 348240,
      "text": "叶子就薄了，",
      "token_start": 1339,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 348760,
      "end_ms": 351095,
      "text": "这儿把单一的红推到了尽头，",
      "token_start": 1344,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 351450,
      "end_ms": 355555,
      "text": "您说这算不算老天爷把颜料罐子打翻了？",
      "token_start": 1356,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 355900,
      "end_ms": 356515,
      "text": "聊到这儿，",
      "token_start": 1373,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 356710,
      "end_ms": 358535,
      "text": "我想跟您唠几句心里话，",
      "token_start": 1377,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 359100,
      "end_ms": 364485,
      "text": "咱们前面讲的地方说到底是同一类风景大地的秋色，",
      "token_start": 1387,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 365120,
      "end_ms": 369015,
      "text": "可我看评论区还是有人问地方是好地方，",
      "token_start": 1409,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 369450,
      "end_ms": 371385,
      "text": "可到底什么时候去最好？",
      "token_start": 1426,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 371810,
      "end_ms": 374850,
      "text": "这几处又散在天南地北一趟，",
      "token_start": 1436,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 374850,
      "end_ms": 375310,
      "text": "怎么串？",
      "token_start": 1448,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 375570,
      "end_ms": 378805,
      "text": "哪一段平哪一段得抬腿心里没底，",
      "token_start": 1451,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 379260,
      "end_ms": 380875,
      "text": "还有带孙子孙女的，",
      "token_start": 1465,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 381180,
      "end_ms": 383080,
      "text": "想给孩子讲讲这些地方，",
      "token_start": 1473,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 383220,
      "end_ms": 384865,
      "text": "可自己也说不全。",
      "token_start": 1483,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 385320,
      "end_ms": 386860,
      "text": "前阵子我翻到一本书，",
      "token_start": 1490,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 387200,
      "end_ms": 388645,
      "text": "正好解决这个问题，",
      "token_start": 1499,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 388960,
      "end_ms": 392975,
      "text": "叫大美中国人一生要去的一百零一个地方。",
      "token_start": 1507,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 393270,
      "end_ms": 397085,
      "text": "他把全中国最值得去的一百零一个地方挑出来，",
      "token_start": 1525,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 397350,
      "end_ms": 398685,
      "text": "分成好几个大类，",
      "token_start": 1545,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 399100,
      "end_ms": 401840,
      "text": "每个地方什么时候去最好看什么，",
      "token_start": 1552,
      "token_end_exclusive": 1566
    },
    {
      "start_ms": 401960,
      "end_ms": 404140,
      "text": "怎么去都讲的清清楚楚。",
      "token_start": 1566,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 404320,
      "end_ms": 406510,
      "text": "图印的透亮一页，",
      "token_start": 1576,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 406510,
      "end_ms": 409915,
      "text": "一幅大画能去的地方出门前翻一翻，",
      "token_start": 1583,
      "token_end_exclusive": 1598
    },
    {
      "start_ms": 410210,
      "end_ms": 411270,
      "text": "暂时去不了的，",
      "token_start": 1598,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 411270,
      "end_ms": 412330,
      "text": "就在家慢慢看，",
      "token_start": 1604,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 413130,
      "end_ms": 414250,
      "text": "摆在茶几上，",
      "token_start": 1610,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 414590,
      "end_ms": 415570,
      "text": "孙辈来了，",
      "token_start": 1615,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 415670,
      "end_ms": 416310,
      "text": "翻两页，",
      "token_start": 1619,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 416310,
      "end_ms": 417070,
      "text": "长见识。",
      "token_start": 1622,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 417550,
      "end_ms": 419870,
      "text": "老两口晚上翻翻商量，",
      "token_start": 1625,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 419870,
      "end_ms": 421430,
      "text": "明年去哪书，",
      "token_start": 1634,
      "token_end_exclusive": 1639
    },
    {
      "start_ms": 421510,
      "end_ms": 426030,
      "text": "就在左下角商品里感兴趣的老朋友点进去看看。",
      "token_start": 1639,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 426390,
      "end_ms": 426630,
      "text": "好，",
      "token_start": 1659,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 426870,
      "end_ms": 427690,
      "text": "咱们接着说。",
      "token_start": 1660,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 427690,
      "end_ms": 431730,
      "text": "最后一处第一名云南香格里拉千壶山，",
      "token_start": 1665,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 432150,
      "end_ms": 434890,
      "text": "迪庆香格里拉市小钟殿乡。",
      "token_start": 1681,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 435610,
      "end_ms": 438330,
      "text": "他有个来头中国国家地理，",
      "token_start": 1692,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 438330,
      "end_ms": 440440,
      "text": "评选中国十大秋色色。",
      "token_start": 1703,
      "token_end_exclusive": 1712
    },
    {
      "start_ms": 440680,
      "end_ms": 441500,
      "text": "他排第八，",
      "token_start": 1712,
      "token_end_exclusive": 1716
    },
    {
      "start_ms": 441860,
      "end_ms": 442940,
      "text": "全国排第八，",
      "token_start": 1716,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 443120,
      "end_ms": 444740,
      "text": "您想想那都美成什么样？",
      "token_start": 1721,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 445120,
      "end_ms": 446960,
      "text": "可今天他排第一，",
      "token_start": 1731,
      "token_end_exclusive": 1738
    },
    {
      "start_ms": 447060,
      "end_ms": 453480,
      "text": "为什么前面五个地方都只是把红或者把黄做到了各自的极致？",
      "token_start": 1738,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 454200,
      "end_ms": 455380,
      "text": "千壶山不一样。",
      "token_start": 1764,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 455740,
      "end_ms": 456640,
      "text": "深秋时节，",
      "token_start": 1770,
      "token_end_exclusive": 1774
    },
    {
      "start_ms": 456900,
      "end_ms": 460300,
      "text": "高山上的红叶和红冠丛被秋霜，",
      "token_start": 1774,
      "token_end_exclusive": 1787
    },
    {
      "start_ms": 460500,
      "end_ms": 461840,
      "text": "打得像烈火在烧。",
      "token_start": 1787,
      "token_end_exclusive": 1794
    },
    {
      "start_ms": 462580,
      "end_ms": 466460,
      "text": "紧挨着的另一边是成片的高山落叶松，",
      "token_start": 1794,
      "token_end_exclusive": 1810
    },
    {
      "start_ms": 467200,
      "end_ms": 468200,
      "text": "惊得耀眼，",
      "token_start": 1810,
      "token_end_exclusive": 1814
    },
    {
      "start_ms": 468560,
      "end_ms": 470970,
      "text": "像瀑布一样倾泻下来。",
      "token_start": 1814,
      "token_end_exclusive": 1823
    },
    {
      "start_ms": 471350,
      "end_ms": 473250,
      "text": "左边万顷金黄，",
      "token_start": 1823,
      "token_end_exclusive": 1829
    },
    {
      "start_ms": 473610,
      "end_ms": 476010,
      "text": "右边满山红火红，",
      "token_start": 1829,
      "token_end_exclusive": 1836
    },
    {
      "start_ms": 476050,
      "end_ms": 480430,
      "text": "与金在同一片大地上面对面撞上了您。",
      "token_start": 1836,
      "token_end_exclusive": 1852
    },
    {
      "start_ms": 480510,
      "end_ms": 483690,
      "text": "站在那高原的风冷冷烈烈吹吹，",
      "token_start": 1852,
      "token_end_exclusive": 1865
    },
    {
      "start_ms": 483690,
      "end_ms": 487750,
      "text": "脸上就脚下松松和落叶叶上去去，",
      "token_start": 1865,
      "token_end_exclusive": 1879
    },
    {
      "start_ms": 487950,
      "end_ms": 489730,
      "text": "软软又一抬眼，",
      "token_start": 1879,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 489730,
      "end_ms": 492290,
      "text": "两种颜色在天地间交风，",
      "token_start": 1885,
      "token_end_exclusive": 1895
    },
    {
      "start_ms": 492290,
      "end_ms": 493730,
      "text": "谁也压不住，",
      "token_start": 1895,
      "token_end_exclusive": 1900
    },
    {
      "start_ms": 493730,
      "end_ms": 495490,
      "text": "谁就佳时。",
      "token_start": 1900,
      "token_end_exclusive": 1904
    },
    {
      "start_ms": 495490,
      "end_ms": 497070,
      "text": "时间是十月中下旬，",
      "token_start": 1904,
      "token_end_exclusive": 1912
    },
    {
      "start_ms": 497810,
      "end_ms": 498750,
      "text": "就那十来天，",
      "token_start": 1912,
      "token_end_exclusive": 1917
    },
    {
      "start_ms": 498750,
      "end_ms": 507100,
      "text": "脚抬是了松针还绿去晚了一场霜雪鲸和红都收了千壶山排第一，",
      "token_start": 1917,
      "token_end_exclusive": 1944
    },
    {
      "start_ms": 507300,
      "end_ms": 508540,
      "text": "靠的是两个字。",
      "token_start": 1944,
      "token_end_exclusive": 1950
    },
    {
      "start_ms": 508860,
      "end_ms": 511300,
      "text": "撞色别处是一种颜色，",
      "token_start": 1950,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 511300,
      "end_ms": 512120,
      "text": "做到极致，",
      "token_start": 1959,
      "token_end_exclusive": 1963
    },
    {
      "start_ms": 512300,
      "end_ms": 513700,
      "text": "这儿是两种极致，",
      "token_start": 1963,
      "token_end_exclusive": 1970
    },
    {
      "start_ms": 513880,
      "end_ms": 515900,
      "text": "正面碰上体谅和反差，",
      "token_start": 1970,
      "token_end_exclusive": 1979
    },
    {
      "start_ms": 516160,
      "end_ms": 518180,
      "text": "把前面五个全压了下去。",
      "token_start": 1979,
      "token_end_exclusive": 1989
    },
    {
      "start_ms": 518680,
      "end_ms": 521280,
      "text": "您说这样的深秋排第一，",
      "token_start": 1989,
      "token_end_exclusive": 1999
    },
    {
      "start_ms": 521520,
      "end_ms": 522120,
      "text": "值不值？",
      "token_start": 1999,
      "token_end_exclusive": 2002
    },
    {
      "start_ms": 522480,
      "end_ms": 525140,
      "text": "这一趟咱们又走完了六处。",
      "token_start": 2002,
      "token_end_exclusive": 2013
    },
    {
      "start_ms": 525140,
      "end_ms": 525580,
      "text": "深秋，",
      "token_start": 2013,
      "token_end_exclusive": 2015
    },
    {
      "start_ms": 525980,
      "end_ms": 528460,
      "text": "坡峰岭是家门口的一整面，",
      "token_start": 2015,
      "token_end_exclusive": 2026
    },
    {
      "start_ms": 528500,
      "end_ms": 534350,
      "text": "红山长金是平地走过十里的碎金泰八雾峡，",
      "token_start": 2026,
      "token_end_exclusive": 2044
    },
    {
      "start_ms": 534510,
      "end_ms": 537110,
      "text": "是刀削绝壁上的水上火海。",
      "token_start": 2044,
      "token_end_exclusive": 2055
    },
    {
      "start_ms": 537670,
      "end_ms": 541070,
      "text": "随州是千岁老树撑起的金穹顶。",
      "token_start": 2055,
      "token_end_exclusive": 2068
    },
    {
      "start_ms": 541570,
      "end_ms": 543650,
      "text": "枫林谷是万亩红海，",
      "token_start": 2068,
      "token_end_exclusive": 2076
    },
    {
      "start_ms": 543910,
      "end_ms": 544430,
      "text": "翻滚，",
      "token_start": 2076,
      "token_end_exclusive": 2078
    },
    {
      "start_ms": 544830,
      "end_ms": 546050,
      "text": "千湖山是红，",
      "token_start": 2078,
      "token_end_exclusive": 2083
    },
    {
      "start_ms": 546050,
      "end_ms": 547710,
      "text": "与金在天地间，",
      "token_start": 2083,
      "token_end_exclusive": 2089
    },
    {
      "start_ms": 547710,
      "end_ms": 550010,
      "text": "正面相撞深秋不等人。",
      "token_start": 2089,
      "token_end_exclusive": 2098
    },
    {
      "start_ms": 550250,
      "end_ms": 551790,
      "text": "有些地方一年之美，",
      "token_start": 2098,
      "token_end_exclusive": 2106
    },
    {
      "start_ms": 551790,
      "end_ms": 552330,
      "text": "十来年，",
      "token_start": 2106,
      "token_end_exclusive": 2109
    },
    {
      "start_ms": 552750,
      "end_ms": 554610,
      "text": "有些树占了上千年，",
      "token_start": 2109,
      "token_end_exclusive": 2117
    },
    {
      "start_ms": 555170,
      "end_ms": 556770,
      "text": "就等您来看一眼，",
      "token_start": 2117,
      "token_end_exclusive": 2124
    },
    {
      "start_ms": 557130,
      "end_ms": 558470,
      "text": "趁这个天正舒服，",
      "token_start": 2124,
      "token_end_exclusive": 2131
    },
    {
      "start_ms": 558830,
      "end_ms": 559850,
      "text": "趁还走得动，",
      "token_start": 2131,
      "token_end_exclusive": 2136
    },
    {
      "start_ms": 560240,
      "end_ms": 560940,
      "text": "收拾一下，",
      "token_start": 2136,
      "token_end_exclusive": 2140
    },
    {
      "start_ms": 561180,
      "end_ms": 562380,
      "text": "出去走一趟吧。",
      "token_start": 2140,
      "token_end_exclusive": 2146
    },
    {
      "start_ms": 562920,
      "end_ms": 563820,
      "text": "这六个地方，",
      "token_start": 2146,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 564040,
      "end_ms": 565840,
      "text": "您最想去哪一个？",
      "token_start": 2151,
      "token_end_exclusive": 2158
    },
    {
      "start_ms": 565980,
      "end_ms": 567160,
      "text": "评论区告诉我，",
      "token_start": 2158,
      "token_end_exclusive": 2164
    },
    {
      "start_ms": 567460,
      "end_ms": 570800,
      "text": "觉得这期有收获的就转给身边跟您一样，",
      "token_start": 2164,
      "token_end_exclusive": 2181
    },
    {
      "start_ms": 570880,
      "end_ms": 572420,
      "text": "爱看大地奇观的人，",
      "token_start": 2181,
      "token_end_exclusive": 2189
    },
    {
      "start_ms": 572740,
      "end_ms": 574320,
      "text": "想听更多山河风光。",
      "token_start": 2189,
      "token_end_exclusive": 2197
    },
    {
      "start_ms": 574540,
      "end_ms": 575220,
      "text": "点个关注，",
      "token_start": 2197,
      "token_end_exclusive": 2201
    },
    {
      "start_ms": 575420,
      "end_ms": 577435,
      "text": "咱们下期接着看。",
      "token_start": 2201,
      "token_end_exclusive": 2208
    }
  ],
