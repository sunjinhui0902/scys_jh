{
  "video_id": "v_b199dcc6960a2707",
  "duration_s": 609.13,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b199dcc6960a2707.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b199dcc6960a2707.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 3750,
      "text": "贵阳可能是全中国最被看不起的省会，",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3990,
      "end_ms": 4770,
      "text": "没有之一。",
      "token_start": 16,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5630,
      "end_ms": 6850,
      "text": "大多数人提到，",
      "token_start": 20,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6850,
      "end_ms": 9850,
      "text": "贵州脑子里蹦出来的就是三句话，",
      "token_start": 26,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 10290,
      "end_ms": 11530,
      "text": "天无三日晴，",
      "token_start": 40,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 11750,
      "end_ms": 12670,
      "text": "地无三尺，",
      "token_start": 45,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 12730,
      "end_ms": 14770,
      "text": "平人无三分银。",
      "token_start": 49,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 15070,
      "end_ms": 18890,
      "text": "好像这块土地自古就是偏远落后，",
      "token_start": 55,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 19290,
      "end_ms": 20930,
      "text": "没文化的代名词。",
      "token_start": 69,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 21370,
      "end_ms": 22890,
      "text": "我前些年也这么觉得。",
      "token_start": 76,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 23230,
      "end_ms": 26250,
      "text": "西南f四里成都重庆光芒太盛，",
      "token_start": 85,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 26730,
      "end_ms": 27930,
      "text": "贵阳夹在中间，",
      "token_start": 98,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 28150,
      "end_ms": 31840,
      "text": "像个闷葫芦存在感低到尘埃里。",
      "token_start": 104,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 32580,
      "end_ms": 33520,
      "text": "直到去年，",
      "token_start": 117,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 33780,
      "end_ms": 38780,
      "text": "一位研究全球山地文明的德国地理学家把我点醒了，",
      "token_start": 121,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 38860,
      "end_ms": 40460,
      "text": "他叫汉斯穆勒，",
      "token_start": 143,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 41400,
      "end_ms": 43640,
      "text": "海德堡大学的地貌学教授，",
      "token_start": 149,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 43980,
      "end_ms": 48720,
      "text": "研究全球喀斯特山地城市与人类定居关系，",
      "token_start": 160,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 48720,
      "end_ms": 50220,
      "text": "研究了快三十年。",
      "token_start": 178,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 51180,
      "end_ms": 53920,
      "text": "他这趟来中国行程单上，",
      "token_start": 185,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 53960,
      "end_ms": 55840,
      "text": "原本只有桂林和昆明，",
      "token_start": 195,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 56220,
      "end_ms": 57580,
      "text": "但他自己加了一站，",
      "token_start": 204,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 57800,
      "end_ms": 58980,
      "text": "说死都要来贵阳。",
      "token_start": 212,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 58980,
      "end_ms": 60010,
      "text": "到了贵林，",
      "token_start": 219,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 60050,
      "end_ms": 60405,
      "text": "贵阳，",
      "token_start": 223,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 60710,
      "end_ms": 61885,
      "text": "他没去甲秀楼，",
      "token_start": 225,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 62160,
      "end_ms": 63565,
      "text": "也没去青岩古镇，",
      "token_start": 231,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 63920,
      "end_ms": 66685,
      "text": "直接让人把他拉到乾灵山最高处，",
      "token_start": 238,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 67250,
      "end_ms": 68705,
      "text": "俯瞰整座城市。",
      "token_start": 252,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 69100,
      "end_ms": 71315,
      "text": "他站在那看了整整一个小时，",
      "token_start": 258,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 71850,
      "end_ms": 73790,
      "text": "山风把头发吹得乱七八糟。",
      "token_start": 270,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 73810,
      "end_ms": 75570,
      "text": "他就一直盯着脚下，",
      "token_start": 281,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 75590,
      "end_ms": 77885,
      "text": "那些从山缝里长出来的娄，",
      "token_start": 289,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 78740,
      "end_ms": 80445,
      "text": "然后他突然转过头问我，",
      "token_start": 300,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 81300,
      "end_ms": 84755,
      "text": "你知道这座城市最让我震撼的是什么吗？",
      "token_start": 310,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 85760,
      "end_ms": 86835,
      "text": "我说山多呗，",
      "token_start": 327,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 87520,
      "end_ms": 88625,
      "text": "喀斯特地貌嘛，",
      "token_start": 332,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 88850,
      "end_ms": 89475,
      "text": "他摇头，",
      "token_start": 338,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 90300,
      "end_ms": 91880,
      "text": "他说全世界没有。",
      "token_start": 341,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 91880,
      "end_ms": 96315,
      "text": "第二个省会是建在百分之八十五的喀斯特地貌上。",
      "token_start": 348,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 96890,
      "end_ms": 97410,
      "text": "那一刻，",
      "token_start": 369,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 97430,
      "end_ms": 103355,
      "text": "我突然觉得自己之前对贵阳那些偏远落后的标签遣拨到家了。",
      "token_start": 372,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 104790,
      "end_ms": 105915,
      "text": "第一季闷锤，",
      "token_start": 398,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 106710,
      "end_ms": 114935,
      "text": "全世界的城市都找平地画格子只有贵阳在百分之八十五都是山河溶洞的土地上，",
      "token_start": 403,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 115240,
      "end_ms": 118685,
      "text": "硬生生扎下根来贵阳的地貌，",
      "token_start": 437,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 119130,
      "end_ms": 122625,
      "text": "山地、丘陵占百分之八十四点六一，",
      "token_start": 449,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 123210,
      "end_ms": 125915,
      "text": "平坝只有百分之十五点三九。",
      "token_start": 463,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 126510,
      "end_ms": 127475,
      "text": "这意味着什么？",
      "token_start": 475,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 127840,
      "end_ms": 129400,
      "text": "意味着你在这座城市里，",
      "token_start": 481,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 129400,
      "end_ms": 130945,
      "text": "随便找个地方往下挖，",
      "token_start": 491,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 131590,
      "end_ms": 132910,
      "text": "底下可能是空的。",
      "token_start": 500,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 132910,
      "end_ms": 137955,
      "text": "溶洞暗河裂隙平地少到可怜，",
      "token_start": 507,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 138370,
      "end_ms": 142495,
      "text": "还被纵横交错的水系切割的七零八落。",
      "token_start": 519,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 143100,
      "end_ms": 145420,
      "text": "可就是这样一块被地理学家，",
      "token_start": 535,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 145420,
      "end_ms": 148730,
      "text": "称为不适合建大城市的土地上，",
      "token_start": 547,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 148810,
      "end_ms": 151955,
      "text": "长出了一座六百四十万人口的省会。",
      "token_start": 560,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 152500,
      "end_ms": 153880,
      "text": "德国专家说了一句话，",
      "token_start": 575,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 153880,
      "end_ms": 154975,
      "text": "让我后背发凉。",
      "token_start": 584,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 155660,
      "end_ms": 158555,
      "text": "你们中国人在这种地质条件下建城，",
      "token_start": 590,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 159320,
      "end_ms": 160685,
      "text": "在欧洲人看来，",
      "token_start": 605,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 161140,
      "end_ms": 163885,
      "text": "等于在筛子上盖教堂第二，",
      "token_start": 611,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 164190,
      "end_ms": 165725,
      "text": "蓟门锤更狠。",
      "token_start": 622,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 166690,
      "end_ms": 167210,
      "text": "第二天，",
      "token_start": 627,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 167210,
      "end_ms": 169370,
      "text": "我们钻进了老城区，",
      "token_start": 630,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 169390,
      "end_ms": 171895,
      "text": "那些弯弯绕绕的巷子，",
      "token_start": 638,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 172380,
      "end_ms": 173920,
      "text": "贵阳不像重庆那样，",
      "token_start": 647,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 173920,
      "end_ms": 175955,
      "text": "把楼直接种在山崖上。",
      "token_start": 655,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 176400,
      "end_ms": 178570,
      "text": "贵阳市山中有城，",
      "token_start": 664,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 178830,
      "end_ms": 179785,
      "text": "城中有山，",
      "token_start": 671,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 180310,
      "end_ms": 182790,
      "text": "汉斯蹲在一条叫坡的巷子口，",
      "token_start": 675,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 182870,
      "end_ms": 186440,
      "text": "对贵阳的路不叫路叫破老。",
      "token_start": 687,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 186440,
      "end_ms": 192740,
      "text": "贵阳有十八坡、望城婆、大营婆和上坡陈家坡、莲花坡。",
      "token_start": 698,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 192740,
      "end_ms": 193765,
      "text": "你听这些名字，",
      "token_start": 719,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 194110,
      "end_ms": 197670,
      "text": "每一个都是一座实实在在的山望城坡，",
      "token_start": 725,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 197690,
      "end_ms": 198555,
      "text": "顾名思义，",
      "token_start": 741,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 198830,
      "end_ms": 202010,
      "text": "就是能望见贵阳城的坡大营坡。",
      "token_start": 745,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 202010,
      "end_ms": 205235,
      "text": "几乎全贵阳人都知道河上坡。",
      "token_start": 758,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 205620,
      "end_ms": 207375,
      "text": "在今天白云大道，",
      "token_start": 770,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 208010,
      "end_ms": 212435,
      "text": "他用手摸着那些被岁月磨圆的青石板。",
      "token_start": 777,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 212990,
      "end_ms": 213715,
      "text": "突然问我，",
      "token_start": 793,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 213990,
      "end_ms": 214795,
      "text": "你注意到没有？",
      "token_start": 797,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 215290,
      "end_ms": 217950,
      "text": "贵阳人从来没有试图把山铲平。",
      "token_start": 803,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 218250,
      "end_ms": 218610,
      "text": "他说，",
      "token_start": 816,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 218870,
      "end_ms": 221565,
      "text": "全世界山地城市的逻辑就两种，",
      "token_start": 818,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 222090,
      "end_ms": 224605,
      "text": "要么推山填谷造平地，",
      "token_start": 831,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 225030,
      "end_ms": 228385,
      "text": "要么像重庆那样把楼架在山壁上。",
      "token_start": 840,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 229180,
      "end_ms": 231205,
      "text": "但贵阳选了第三条路，",
      "token_start": 854,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 232210,
      "end_ms": 234555,
      "text": "他绕着山走山在这儿，",
      "token_start": 863,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 234960,
      "end_ms": 236905,
      "text": "路就拐个弯儿泼在那儿，",
      "token_start": 872,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 237100,
      "end_ms": 240035,
      "text": "房子就顺着坡盖几十年了，",
      "token_start": 882,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 240410,
      "end_ms": 244035,
      "text": "贵阳人硬是没动过那些山的基本轮廓。",
      "token_start": 893,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 244740,
      "end_ms": 246945,
      "text": "他站起来指着远处说，",
      "token_start": 909,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 247490,
      "end_ms": 249675,
      "text": "你们贵阳人不是在修城市，",
      "token_start": 918,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 250070,
      "end_ms": 252835,
      "text": "你们是在卡斯特的骨头缝里绣花，",
      "token_start": 929,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 253490,
      "end_ms": 259295,
      "text": "每一栋楼每一条路都是顺着地形的纹理长出来的。",
      "token_start": 943,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 259750,
      "end_ms": 261515,
      "text": "这种对自然的敬畏，",
      "token_start": 964,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 261870,
      "end_ms": 262745,
      "text": "不是妥协，",
      "token_start": 972,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 263110,
      "end_ms": 263825,
      "text": "是智慧。",
      "token_start": 976,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 264300,
      "end_ms": 267075,
      "text": "然后他说了一句让我头皮发麻的话，",
      "token_start": 979,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 267890,
      "end_ms": 269770,
      "text": "我们欧洲人搞了几百年。",
      "token_start": 994,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 269770,
      "end_ms": 272835,
      "text": "城市规划讲究的是改造自然，",
      "token_start": 1004,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 273130,
      "end_ms": 274515,
      "text": "征服地形哦。",
      "token_start": 1016,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 275070,
      "end_ms": 279015,
      "text": "但你们贵阳人从一开始就想明白了一件事，",
      "token_start": 1021,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 279480,
      "end_ms": 282580,
      "text": "最高级的文明不是让山河沉浮，",
      "token_start": 1039,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 282900,
      "end_ms": 285055,
      "text": "是知道什么时候该绕着走。",
      "token_start": 1052,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 285500,
      "end_ms": 286545,
      "text": "第三季闷锤，",
      "token_start": 1063,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 287360,
      "end_ms": 289560,
      "text": "我们去了一个谁也想不到的地方。",
      "token_start": 1068,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 289560,
      "end_ms": 294100,
      "text": "贵阳三县建设博物馆汉斯站在那些老照片和老物件前，",
      "token_start": 1082,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 294100,
      "end_ms": 294800,
      "text": "看了很久，",
      "token_start": 1105,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 295119,
      "end_ms": 296385,
      "text": "突然转过头问我，",
      "token_start": 1109,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 296760,
      "end_ms": 302305,
      "text": "你知道为什么贵阳能从一座边陲小城变成今天的西南枢纽吗？",
      "token_start": 1116,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 302680,
      "end_ms": 303435,
      "text": "我愣了愣。",
      "token_start": 1142,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 303810,
      "end_ms": 304170,
      "text": "他说，",
      "token_start": 1146,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 304710,
      "end_ms": 308730,
      "text": "因为你们贵阳人把被选择变成了，",
      "token_start": 1148,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 308730,
      "end_ms": 309310,
      "text": "接得住。",
      "token_start": 1162,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 310030,
      "end_ms": 326830,
      "text": "一九六四年三县建设启动国家一址调令数万名工人技术员工程师、携家带口技术、海北京、沈阳哈尔滨。",
      "token_start": 1165,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 327070,
      "end_ms": 329590,
      "text": "这些大城市挤上孟灌货车，",
      "token_start": 1207,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 329910,
      "end_ms": 331450,
      "text": "翻过重鸾叠嶂，",
      "token_start": 1218,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 331910,
      "end_ms": 334640,
      "text": "落脚在这片全然木场陌生的土地。",
      "token_start": 1224,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 335620,
      "end_ms": 336500,
      "text": "十五年间，",
      "token_start": 1238,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 336780,
      "end_ms": 340220,
      "text": "一百多个项目从沿海迁入贵州，",
      "token_start": 1242,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 340960,
      "end_ms": 341720,
      "text": "仅内迁，",
      "token_start": 1255,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 341739,
      "end_ms": 343680,
      "text": "职工就超过七万人。",
      "token_start": 1258,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 344260,
      "end_ms": 356140,
      "text": "设备一万二千余台相当于搬走了好几座中型城市上海光学仪器厂整体迁到乌当区新天寨的山窝窝里，",
      "token_start": 1266,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 356520,
      "end_ms": 359660,
      "text": "在代号八百零三的四层小楼中，",
      "token_start": 1309,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 360180,
      "end_ms": 363525,
      "text": "硬是造出了中国第一台潜艇潜望镜。",
      "token_start": 1322,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 364130,
      "end_ms": 367590,
      "text": "上海第二电表厂上海电表厂迁到贵阳，",
      "token_start": 1337,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 367650,
      "end_ms": 369945,
      "text": "组建了西南电表公司。",
      "token_start": 1353,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 370430,
      "end_ms": 373550,
      "text": "上海大中华橡胶厂整体内迁，",
      "token_start": 1362,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 373590,
      "end_ms": 376515,
      "text": "贵阳组建贵州橡胶总厂，",
      "token_start": 1374,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 376880,
      "end_ms": 379285,
      "text": "北京轴承厂一拆为二，",
      "token_start": 1384,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 380110,
      "end_ms": 382355,
      "text": "一半来贵阳小河扎根。",
      "token_start": 1393,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 382880,
      "end_ms": 383320,
      "text": "后来，",
      "token_start": 1402,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 383480,
      "end_ms": 387505,
      "text": "GY排轴承远销七十多个国家和地区，",
      "token_start": 1404,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 387870,
      "end_ms": 390115,
      "text": "拿下了全国五一劳动奖状，",
      "token_start": 1419,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 390570,
      "end_ms": 398230,
      "text": "还有永恒精密电表厂紧挨着油炸街的火焰山生产的产品参与研制。",
      "token_start": 1430,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 398270,
      "end_ms": 403905,
      "text": "北京正负电子对撞机名字被永远刻在了国家科委的铭文碑上。",
      "token_start": 1458,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 404570,
      "end_ms": 407330,
      "text": "汉斯站在博物馆里一字一句的说，",
      "token_start": 1484,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 407670,
      "end_ms": 409495,
      "text": "你知道这意味着什么吗？",
      "token_start": 1498,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 410390,
      "end_ms": 412595,
      "text": "这不是一座城市的幸运，",
      "token_start": 1508,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 413150,
      "end_ms": 415235,
      "text": "这是一座城市的品格。",
      "token_start": 1518,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 415780,
      "end_ms": 418165,
      "text": "你们贵阳人没有挑三拣四，",
      "token_start": 1527,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 418720,
      "end_ms": 420585,
      "text": "不管国家扔进来什么，",
      "token_start": 1538,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 420990,
      "end_ms": 422075,
      "text": "你们都接住了。",
      "token_start": 1547,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 423100,
      "end_ms": 424015,
      "text": "上海人来了，",
      "token_start": 1553,
      "token_end_exclusive": 1558
    },
    {
      "start_ms": 424880,
      "end_ms": 426005,
      "text": "贵阳人没排外，",
      "token_start": 1558,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 426840,
      "end_ms": 427920,
      "text": "东北人来了，",
      "token_start": 1564,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 428020,
      "end_ms": 429255,
      "text": "贵阳人没嫌弃，",
      "token_start": 1569,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 430080,
      "end_ms": 431200,
      "text": "你们把山挖开，",
      "token_start": 1575,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 431320,
      "end_ms": 432195,
      "text": "把路修通，",
      "token_start": 1581,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 432490,
      "end_ms": 433430,
      "text": "把厂建起来，",
      "token_start": 1585,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 433430,
      "end_ms": 437265,
      "text": "山沟里硬生生长出了一座现代工业城。",
      "token_start": 1590,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 437730,
      "end_ms": 439385,
      "text": "他顿了顿又说，",
      "token_start": 1606,
      "token_end_exclusive": 1612
    },
    {
      "start_ms": 440570,
      "end_ms": 441810,
      "text": "更让我震撼的是，",
      "token_start": 1612,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 441850,
      "end_ms": 443205,
      "text": "你们不但截住了，",
      "token_start": 1619,
      "token_end_exclusive": 1626
    },
    {
      "start_ms": 443510,
      "end_ms": 445325,
      "text": "还长出了新的东西。",
      "token_start": 1626,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 445940,
      "end_ms": 449200,
      "text": "六十年前三线建设打下的工业底子，",
      "token_start": 1634,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 449480,
      "end_ms": 451575,
      "text": "六十年后变成了什么？",
      "token_start": 1649,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 451860,
      "end_ms": 454320,
      "text": "变成了今天贵阳的中国树谷，",
      "token_start": 1658,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 454320,
      "end_ms": 456715,
      "text": "那些曾经的三线工厂，",
      "token_start": 1670,
      "token_end_exclusive": 1679
    },
    {
      "start_ms": 457150,
      "end_ms": 459255,
      "text": "如今变成了大数据产业园，",
      "token_start": 1679,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 459690,
      "end_ms": 460895,
      "text": "机械加工车间，",
      "token_start": 1690,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 461180,
      "end_ms": 463285,
      "text": "变成了软件测试实验室。",
      "token_start": 1696,
      "token_end_exclusive": 1706
    },
    {
      "start_ms": 464060,
      "end_ms": 465165,
      "text": "凉爽的气候，",
      "token_start": 1706,
      "token_end_exclusive": 1711
    },
    {
      "start_ms": 465470,
      "end_ms": 470975,
      "text": "稳定的地址、充足的水电当年是三县建设选址的理由，",
      "token_start": 1711,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 471540,
      "end_ms": 474665,
      "text": "今天成了大数据产业扎根的土壤。",
      "token_start": 1733,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 475580,
      "end_ms": 477780,
      "text": "从潜望镜到云计算，",
      "token_start": 1747,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 477860,
      "end_ms": 480740,
      "text": "从山洞里的机床到云端上的代码。",
      "token_start": 1755,
      "token_end_exclusive": 1769
    },
    {
      "start_ms": 480760,
      "end_ms": 484095,
      "text": "你们贵阳人用六十年证明了一件事儿，",
      "token_start": 1769,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 484450,
      "end_ms": 485755,
      "text": "你给我什么样的地，",
      "token_start": 1785,
      "token_end_exclusive": 1793
    },
    {
      "start_ms": 486110,
      "end_ms": 487485,
      "text": "我就能活出什么样的人。",
      "token_start": 1793,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 488430,
      "end_ms": 489955,
      "text": "你给我什么样的时代，",
      "token_start": 1803,
      "token_end_exclusive": 1812
    },
    {
      "start_ms": 490420,
      "end_ms": 492585,
      "text": "我就能借住什么样的未来。",
      "token_start": 1812,
      "token_end_exclusive": 1823
    },
    {
      "start_ms": 493330,
      "end_ms": 494635,
      "text": "我站在博物馆里，",
      "token_start": 1823,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 495110,
      "end_ms": 497950,
      "text": "看着墙上那些黑白照片里年轻的脸，",
      "token_start": 1830,
      "token_end_exclusive": 1845
    },
    {
      "start_ms": 497950,
      "end_ms": 499105,
      "text": "他们从上海来，",
      "token_start": 1845,
      "token_end_exclusive": 1851
    },
    {
      "start_ms": 499540,
      "end_ms": 500625,
      "text": "从北京来，",
      "token_start": 1851,
      "token_end_exclusive": 1855
    },
    {
      "start_ms": 500990,
      "end_ms": 501865,
      "text": "从东北来，",
      "token_start": 1855,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 502290,
      "end_ms": 504030,
      "text": "有的连贵州在哪都不知道，",
      "token_start": 1859,
      "token_end_exclusive": 1870
    },
    {
      "start_ms": 504030,
      "end_ms": 504675,
      "text": "就到了了。",
      "token_start": 1870,
      "token_end_exclusive": 1874
    },
    {
      "start_ms": 505320,
      "end_ms": 506615,
      "text": "他们这辈子没回去，",
      "token_start": 1874,
      "token_end_exclusive": 1882
    },
    {
      "start_ms": 506840,
      "end_ms": 511560,
      "text": "把青春和子孙都留在了这片喀斯特的山地上。",
      "token_start": 1882,
      "token_end_exclusive": 1901
    },
    {
      "start_ms": 511660,
      "end_ms": 512435,
      "text": "回来之后，",
      "token_start": 1901,
      "token_end_exclusive": 1905
    },
    {
      "start_ms": 512780,
      "end_ms": 514395,
      "text": "我怎么也放不下这件事。",
      "token_start": 1905,
      "token_end_exclusive": 1915
    },
    {
      "start_ms": 514940,
      "end_ms": 516125,
      "text": "搜了一圈资料，",
      "token_start": 1915,
      "token_end_exclusive": 1921
    },
    {
      "start_ms": 516530,
      "end_ms": 521005,
      "text": "发现大部分文章都在讲贵阳有多爽有多凉快。",
      "token_start": 1921,
      "token_end_exclusive": 1940
    },
    {
      "start_ms": 521420,
      "end_ms": 525735,
      "text": "很少有人讲贵阳背后那个文明级别的生存选择。",
      "token_start": 1940,
      "token_end_exclusive": 1960
    },
    {
      "start_ms": 526280,
      "end_ms": 528645,
      "text": "后来翻到那套中国历史名城，",
      "token_start": 1960,
      "token_end_exclusive": 1972
    },
    {
      "start_ms": 529140,
      "end_ms": 531765,
      "text": "翻到贵阳那部分一口气读完，",
      "token_start": 1972,
      "token_end_exclusive": 1984
    },
    {
      "start_ms": 532230,
      "end_ms": 535145,
      "text": "他不是把贵阳当一个避暑城市来写，",
      "token_start": 1984,
      "token_end_exclusive": 1999
    },
    {
      "start_ms": 535700,
      "end_ms": 536680,
      "text": "他掰开了讲，",
      "token_start": 1999,
      "token_end_exclusive": 2004
    },
    {
      "start_ms": 537060,
      "end_ms": 541520,
      "text": "为什么中国人敢在百分之八十五都是卡斯特的山地上见省会？",
      "token_start": 2004,
      "token_end_exclusive": 2030
    },
    {
      "start_ms": 542060,
      "end_ms": 544700,
      "text": "为什么山城不是被迫接受，",
      "token_start": 2030,
      "token_end_exclusive": 2041
    },
    {
      "start_ms": 544720,
      "end_ms": 546180,
      "text": "而是主动共生？",
      "token_start": 2041,
      "token_end_exclusive": 2047
    },
    {
      "start_ms": 546360,
      "end_ms": 552280,
      "text": "为什么中国文明能把一块地无三里坪的土地活成西南枢纽？",
      "token_start": 2047,
      "token_end_exclusive": 2072
    },
    {
      "start_ms": 552890,
      "end_ms": 554470,
      "text": "每一页翻开都是一句，",
      "token_start": 2072,
      "token_end_exclusive": 2081
    },
    {
      "start_ms": 554630,
      "end_ms": 557210,
      "text": "原来我们的祖宗在不可能，",
      "token_start": 2081,
      "token_end_exclusive": 2092
    },
    {
      "start_ms": 557210,
      "end_ms": 560495,
      "text": "这三个字面前从来没低过头。",
      "token_start": 2092,
      "token_end_exclusive": 2104
    },
    {
      "start_ms": 561210,
      "end_ms": 562730,
      "text": "下次你要是来贵阳，",
      "token_start": 2104,
      "token_end_exclusive": 2112
    },
    {
      "start_ms": 562870,
      "end_ms": 565205,
      "text": "别光在甲秀楼拍张游客照就走了。",
      "token_start": 2112,
      "token_end_exclusive": 2126
    },
    {
      "start_ms": 566020,
      "end_ms": 567325,
      "text": "翻一翻这套书，",
      "token_start": 2126,
      "token_end_exclusive": 2132
    },
    {
      "start_ms": 567970,
      "end_ms": 570275,
      "text": "带一双看得懂的眼睛走进去，",
      "token_start": 2132,
      "token_end_exclusive": 2144
    },
    {
      "start_ms": 571190,
      "end_ms": 575815,
      "text": "这座在卡斯特骨头缝里绣了六百多年花的山城。",
      "token_start": 2144,
      "token_end_exclusive": 2164
    },
    {
      "start_ms": 576490,
      "end_ms": 578690,
      "text": "等的不是一个游客说挺凉快，",
      "token_start": 2164,
      "token_end_exclusive": 2176
    },
    {
      "start_ms": 578690,
      "end_ms": 579510,
      "text": "然后走掉。",
      "token_start": 2176,
      "token_end_exclusive": 2180
