{
  "video_id": "v_c126307886cf0805",
  "duration_s": 319.416667,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c126307886cf0805.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c126307886cf0805.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 3270,
      "text": "剑桥抢着请他美国天价年薪流，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3270,
      "end_ms": 5010,
      "text": "他他写下八个字，",
      "token_start": 13,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5250,
      "end_ms": 7770,
      "text": "扭头回国家。",
      "token_start": 20,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 7770,
      "end_ms": 11530,
      "text": "人们上一篇讲了华罗庚，",
      "token_start": 25,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 11570,
      "end_ms": 12490,
      "text": "一个初中生，",
      "token_start": 35,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 12690,
      "end_ms": 14530,
      "text": "靠一篇论文进了清华，",
      "token_start": 40,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 15070,
      "end_ms": 16970,
      "text": "从打杂的助理员干起，",
      "token_start": 49,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 17270,
      "end_ms": 20250,
      "text": "硬是自学成了让清华教授都服气的人。",
      "token_start": 58,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 20730,
      "end_ms": 22050,
      "text": "今天这篇讲，",
      "token_start": 74,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 22050,
      "end_ms": 23250,
      "text": "他最扬眉吐气，",
      "token_start": 79,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 23450,
      "end_ms": 24830,
      "text": "也最让人泪目的一段。",
      "token_start": 85,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 24830,
      "end_ms": 26670,
      "text": "一九三六年，",
      "token_start": 94,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 26670,
      "end_ms": 28710,
      "text": "华罗庚去了英国剑桥大学，",
      "token_start": 99,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 28710,
      "end_ms": 33400,
      "text": "全世界的这数学家挤破头的地方到了剑桥，",
      "token_start": 110,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 33820,
      "end_ms": 36700,
      "text": "他干了一件让所有人都看不懂的事，",
      "token_start": 128,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 36740,
      "end_ms": 39380,
      "text": "别人都是奔着拿学位去的。",
      "token_start": 143,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 39560,
      "end_ms": 39980,
      "text": "他说，",
      "token_start": 154,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 40280,
      "end_ms": 41900,
      "text": "我来是学本事的，",
      "token_start": 156,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 41940,
      "end_ms": 43340,
      "text": "不是来要文凭的，",
      "token_start": 163,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 43500,
      "end_ms": 44640,
      "text": "学位我不要了。",
      "token_start": 170,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 45340,
      "end_ms": 46920,
      "text": "他同时修七八门课，",
      "token_start": 176,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 47400,
      "end_ms": 48780,
      "text": "天天泡在图书馆，",
      "token_start": 184,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 49180,
      "end_ms": 50340,
      "text": "跟时间赛跑，",
      "token_start": 191,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 50680,
      "end_ms": 53560,
      "text": "两年时间写出了二十篇论文，",
      "token_start": 196,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 53920,
      "end_ms": 55480,
      "text": "一篇比一篇硬核。",
      "token_start": 208,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 55940,
      "end_ms": 62865,
      "text": "他提出的华氏定理直接改进了当十世界顶尖数学家的结论。",
      "token_start": 215,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 63690,
      "end_ms": 69655,
      "text": "整个欧洲数学界都震动了这个中国人是谁？",
      "token_start": 240,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 70050,
      "end_ms": 70615,
      "text": "一查，",
      "token_start": 258,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 71650,
      "end_ms": 73835,
      "text": "初中毕业自学成才，",
      "token_start": 260,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 76110,
      "end_ms": 76730,
      "text": "那两年，",
      "token_start": 268,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 76850,
      "end_ms": 80685,
      "text": "华罗庚的名字成了中国数学的一张名片。",
      "token_start": 271,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 81370,
      "end_ms": 83140,
      "text": "剑桥想流淌说，",
      "token_start": 288,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 83140,
      "end_ms": 84135,
      "text": "只要他愿意，",
      "token_start": 294,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 84460,
      "end_ms": 85785,
      "text": "前程不可限量。",
      "token_start": 299,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 86550,
      "end_ms": 89265,
      "text": "可一九三八年抗战爆发，",
      "token_start": 305,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 89700,
      "end_ms": 91855,
      "text": "他收拾行李回国了，",
      "token_start": 315,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 92350,
      "end_ms": 93335,
      "text": "有人不理解，",
      "token_start": 323,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 93680,
      "end_ms": 95845,
      "text": "人家挤破头想留在剑桥，",
      "token_start": 328,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 96210,
      "end_ms": 96770,
      "text": "你倒好，",
      "token_start": 338,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 96990,
      "end_ms": 98610,
      "text": "说走就走花。",
      "token_start": 341,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 98610,
      "end_ms": 99285,
      "text": "罗庚说，",
      "token_start": 346,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 99720,
      "end_ms": 103010,
      "text": "我的根在中国回国以后，",
      "token_start": 349,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 103290,
      "end_ms": 105395,
      "text": "他在西南联大教书。",
      "token_start": 359,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 105930,
      "end_ms": 107565,
      "text": "那时候昆明物价飞涨，",
      "token_start": 367,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 108040,
      "end_ms": 109345,
      "text": "他穷的叮当响，",
      "token_start": 376,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 110380,
      "end_ms": 113000,
      "text": "一家人挤在城外的小屋子里。",
      "token_start": 382,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 113060,
      "end_ms": 114145,
      "text": "楼上是人，",
      "token_start": 394,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 114560,
      "end_ms": 115465,
      "text": "楼下是牛，",
      "token_start": 398,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 116020,
      "end_ms": 117655,
      "text": "就是在这样的环境里，",
      "token_start": 402,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 117920,
      "end_ms": 121415,
      "text": "他写出了数学巨著、堆垒素数论，",
      "token_start": 411,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 121940,
      "end_ms": 124125,
      "text": "后来成了国际数学界的经典。",
      "token_start": 424,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 124610,
      "end_ms": 127305,
      "text": "可命运又给了他一次选择。",
      "token_start": 436,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 127880,
      "end_ms": 128985,
      "text": "一九四六年，",
      "token_start": 447,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 129270,
      "end_ms": 131735,
      "text": "华罗庚应邀去美国讲学，",
      "token_start": 452,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 132600,
      "end_ms": 135205,
      "text": "美国给了他终身教授的职位，",
      "token_start": 462,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 135680,
      "end_ms": 138750,
      "text": "年薪高的惊人研究条件，",
      "token_start": 474,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 138830,
      "end_ms": 142865,
      "text": "全世界最好全家人都跟着他搬了过去，",
      "token_start": 484,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 143460,
      "end_ms": 145035,
      "text": "日子过得体体面面。",
      "token_start": 500,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 146300,
      "end_ms": 146885,
      "text": "家人们，",
      "token_start": 508,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 147270,
      "end_ms": 149105,
      "text": "那可是一九四六年，",
      "token_start": 511,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 150520,
      "end_ms": 151800,
      "text": "中国刚打完仗，",
      "token_start": 519,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 151920,
      "end_ms": 153065,
      "text": "百废待兴，",
      "token_start": 525,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 153470,
      "end_ms": 154295,
      "text": "要啥没啥。",
      "token_start": 529,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 154830,
      "end_ms": 157505,
      "text": "美国全世界最有钱的国家，",
      "token_start": 533,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 157910,
      "end_ms": 160075,
      "text": "搁一般人就在美国待着了。",
      "token_start": 544,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 160640,
      "end_ms": 162195,
      "text": "华罗庚待了四年。",
      "token_start": 555,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 162900,
      "end_ms": 163820,
      "text": "一九五零年，",
      "token_start": 562,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 164040,
      "end_ms": 166810,
      "text": "新中国刚刚成立一穷二白，",
      "token_start": 567,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 167090,
      "end_ms": 171585,
      "text": "他做了个让所有美国人没想到的决定回国。",
      "token_start": 578,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 172540,
      "end_ms": 176945,
      "text": "他在给全体留美学生的公开信里写下八个字。",
      "token_start": 596,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 177500,
      "end_ms": 178695,
      "text": "良缘虽好，",
      "token_start": 615,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 179040,
      "end_ms": 180275,
      "text": "非久居之下，",
      "token_start": 619,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 180810,
      "end_ms": 182570,
      "text": "归去来兮家人们。",
      "token_start": 624,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 182610,
      "end_ms": 183630,
      "text": "良缘虽好，",
      "token_start": 631,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 183730,
      "end_ms": 184985,
      "text": "非久居之乡。",
      "token_start": 635,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 185580,
      "end_ms": 186600,
      "text": "别人家再好，",
      "token_start": 640,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 186800,
      "end_ms": 189045,
      "text": "也不是自己家归去来兮，",
      "token_start": 645,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 189410,
      "end_ms": 190035,
      "text": "回来吧。",
      "token_start": 655,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 190260,
      "end_ms": 191465,
      "text": "回自己的国家去，",
      "token_start": 658,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 191920,
      "end_ms": 195185,
      "text": "他带着全家登上了回国的轮船。",
      "token_start": 665,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 195710,
      "end_ms": 196685,
      "text": "有人劝他，",
      "token_start": 678,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 196950,
      "end_ms": 198885,
      "text": "你再想想回去了，",
      "token_start": 682,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 199130,
      "end_ms": 200015,
      "text": "可什么都没有。",
      "token_start": 689,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 200390,
      "end_ms": 200985,
      "text": "他说，",
      "token_start": 695,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 201440,
      "end_ms": 202860,
      "text": "正因为什么都没有，",
      "token_start": 697,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 203060,
      "end_ms": 204405,
      "text": "才需要我们回去。",
      "token_start": 705,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 205310,
      "end_ms": 206115,
      "text": "回国以后，",
      "token_start": 712,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 206390,
      "end_ms": 207345,
      "text": "他白天教书，",
      "token_start": 716,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 207680,
      "end_ms": 208535,
      "text": "晚上著书，",
      "token_start": 721,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 208880,
      "end_ms": 211915,
      "text": "把堆垒素数论写成了国际经典，",
      "token_start": 725,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 212710,
      "end_ms": 217095,
      "text": "带出了一大批院士、学生、中科院数学所成立。",
      "token_start": 738,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 217350,
      "end_ms": 218705,
      "text": "他当了第一任所长。",
      "token_start": 756,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 219470,
      "end_ms": 220295,
      "text": "有人问他，",
      "token_start": 764,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 222240,
      "end_ms": 225095,
      "text": "你放弃美国那么好的条件后悔吗？",
      "token_start": 768,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 226320,
      "end_ms": 226705,
      "text": "他说，",
      "token_start": 782,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 227880,
      "end_ms": 232285,
      "text": "我这一辈子做的每一个选择都不后悔。",
      "token_start": 784,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 233060,
      "end_ms": 233605,
      "text": "家人们，",
      "token_start": 800,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 234070,
      "end_ms": 234845,
      "text": "你想想，",
      "token_start": 803,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 235240,
      "end_ms": 237945,
      "text": "一九五零年的中国什么都没有，",
      "token_start": 806,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 239150,
      "end_ms": 242760,
      "text": "可就是有华罗庚这样的人放着高薪，",
      "token_start": 819,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 242780,
      "end_ms": 244795,
      "text": "不要放着洋房不住，",
      "token_start": 834,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 245170,
      "end_ms": 250515,
      "text": "偏要回来把自己的命跟这个国家的命捆在一起。",
      "token_start": 842,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 251100,
      "end_ms": 254805,
      "text": "他还培养了一个年轻人叫陈景润。",
      "token_start": 862,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 255400,
      "end_ms": 257805,
      "text": "后来的故事大家都知道了，",
      "token_start": 876,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 258810,
      "end_ms": 263055,
      "text": "陈景润攻下了震惊世界的数学难题，",
      "token_start": 887,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 263890,
      "end_ms": 266740,
      "text": "成了名震天下的数学家。",
      "token_start": 902,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 266880,
      "end_ms": 269095,
      "text": "华罗庚不仅自己是脊梁，",
      "token_start": 912,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 269470,
      "end_ms": 272025,
      "text": "还给中国又撑起了一根脊梁。",
      "token_start": 922,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 272910,
      "end_ms": 273885,
      "text": "什么叫脊梁？",
      "token_start": 934,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 274130,
      "end_ms": 274945,
      "text": "这就是脊梁，",
      "token_start": 939,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 276120,
      "end_ms": 279330,
      "text": "觉得话痨了不起的评论区，",
      "token_start": 944,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 279350,
      "end_ms": 281125,
      "text": "打归去来兮四个字，",
      "token_start": 955,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 281590,
      "end_ms": 282090,
      "text": "致敬。",
      "token_start": 963,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 282150,
      "end_ms": 284745,
      "text": "这些义无反顾回国的人，",
      "token_start": 965,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 285020,
      "end_ms": 285935,
      "text": "转发出去，",
      "token_start": 975,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 286420,
      "end_ms": 287705,
      "text": "让年轻人看看，",
      "token_start": 979,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 288150,
      "end_ms": 290385,
      "text": "有些东西比钱值钱。",
      "token_start": 985,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 291120,
      "end_ms": 292100,
      "text": "梁园虽好，",
      "token_start": 993,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 292360,
      "end_ms": 295885,
      "text": "非久居之乡家人们。",
      "token_start": 997,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 297540,
      "end_ms": 300545,
      "text": "这八个字花落庚不是写出来的，",
      "token_start": 1005,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 300780,
      "end_ms": 305385,
      "text": "是拿一辈子活出来的这是华罗庚三部曲的第二篇。",
      "token_start": 1018,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 305600,
      "end_ms": 306850,
      "text": "最后一篇讲，",
      "token_start": 1039,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 306850,
      "end_ms": 309685,
      "text": "他的晚年功成名就，",
      "token_start": 1044,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 309990,
      "end_ms": 311255,
      "text": "本可以享清福，",
      "token_start": 1052,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 312040,
      "end_ms": 313795,
      "text": "他却拖着一条残腿，",
      "token_start": 1058,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 314230,
      "end_ms": 315330,
      "text": "跑遍全国，",
      "token_start": 1066,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 315410,
      "end_ms": 317790,
      "text": "二十多个省关注。",
      "token_start": 1070,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 317790,
      "end_ms": 319285,
      "text": "我看大结局。",
      "token_start": 1077,
      "token_end_exclusive": 1082
    }
  ],
