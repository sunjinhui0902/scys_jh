{
  "video_id": "v_3c999cc0540ce2a7",
  "duration_s": 422.161995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_3c999cc0540ce2a7.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_3c999cc0540ce2a7.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 650,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 650,
      "end_ms": 1330,
      "text": "咱们盘了。",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1330,
      "end_ms": 5190,
      "text": "第十到第六大报恩寺的琉璃塔，",
      "token_start": 6,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 5390,
      "end_ms": 9690,
      "text": "天坛龙江宝船厂武当山明长城。",
      "token_start": 19,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 10490,
      "end_ms": 13110,
      "text": "好多朋友看完在评论区炒翻了。",
      "token_start": 32,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 13270,
      "end_ms": 16410,
      "text": "有人说紫禁城呢永乐大典呢，",
      "token_start": 45,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 16450,
      "end_ms": 17730,
      "text": "郑和下西洋呢？",
      "token_start": 57,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 17890,
      "end_ms": 18390,
      "text": "别急，",
      "token_start": 63,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 18910,
      "end_ms": 21690,
      "text": "今天这集就是第五道第一，",
      "token_start": 65,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 21930,
      "end_ms": 23310,
      "text": "一个比一个震撼。",
      "token_start": 76,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 24210,
      "end_ms": 28110,
      "text": "最后那个是咱们至今都还在用的。",
      "token_start": 83,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 28590,
      "end_ms": 29310,
      "text": "老规矩，",
      "token_start": 97,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 29670,
      "end_ms": 30660,
      "text": "开讲讲之前，",
      "token_start": 100,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 31120,
      "end_ms": 34180,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 105,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 34660,
      "end_ms": 38740,
      "text": "让我看看都是谁在听第五名。",
      "token_start": 115,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 39040,
      "end_ms": 40160,
      "text": "郑和下西洋，",
      "token_start": 127,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 40400,
      "end_ms": 41300,
      "text": "永乐三年，",
      "token_start": 132,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 42200,
      "end_ms": 43880,
      "text": "公元一四零五年，",
      "token_start": 136,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 44620,
      "end_ms": 47820,
      "text": "朱棣下旨令郑和组织船队下西洋。",
      "token_start": 143,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 48600,
      "end_ms": 49620,
      "text": "船队有多大？",
      "token_start": 157,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 50580,
      "end_ms": 51600,
      "text": "两百多艘船，",
      "token_start": 162,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 51880,
      "end_ms": 53160,
      "text": "两万七千多人，",
      "token_start": 167,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 53680,
      "end_ms": 56320,
      "text": "最大的宝船长一百多米，",
      "token_start": 173,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 56620,
      "end_ms": 58900,
      "text": "比哥伦布的船大了好几倍。",
      "token_start": 183,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 59380,
      "end_ms": 62585,
      "text": "哥伦布第一次出海是一四九二年，",
      "token_start": 194,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 63600,
      "end_ms": 64980,
      "text": "郑和比他早了。",
      "token_start": 208,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 64980,
      "end_ms": 68445,
      "text": "八十七年船队从南京出发，",
      "token_start": 214,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 68910,
      "end_ms": 71025,
      "text": "经过福建穿过南海，",
      "token_start": 225,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 71660,
      "end_ms": 75280,
      "text": "到了爪哇苏门答腊西兰，",
      "token_start": 233,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 75660,
      "end_ms": 78960,
      "text": "鼓里最远到了非洲东海岸，",
      "token_start": 243,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 79200,
      "end_ms": 80375,
      "text": "前后七次，",
      "token_start": 254,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 80670,
      "end_ms": 84995,
      "text": "历时二十八年访问了三十多个国家和地区，",
      "token_start": 258,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 85490,
      "end_ms": 88455,
      "text": "带去了丝绸、瓷器、茶叶，",
      "token_start": 276,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 88810,
      "end_ms": 90685,
      "text": "带回了香料珍宝。",
      "token_start": 285,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 90990,
      "end_ms": 91655,
      "text": "长颈鹿。",
      "token_start": 292,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 92090,
      "end_ms": 96375,
      "text": "一支船队把大明的国威扬到了半个地球。",
      "token_start": 295,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 96800,
      "end_ms": 97495,
      "text": "第四名，",
      "token_start": 312,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 97880,
      "end_ms": 104155,
      "text": "明长陵在北京昌平天寿山朱棣不仅给子孙修了紫禁城，",
      "token_start": 315,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 104540,
      "end_ms": 106285,
      "text": "还给自己修了一座陵。",
      "token_start": 338,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 106790,
      "end_ms": 110210,
      "text": "明长陵永乐七年度宫地下宫殿，",
      "token_start": 347,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 110210,
      "end_ms": 112800,
      "text": "修了四年地面建筑，",
      "token_start": 360,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 113040,
      "end_ms": 115275,
      "text": "修到宣德二年才完工。",
      "token_start": 368,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 116130,
      "end_ms": 117615,
      "text": "前后将近十八年。",
      "token_start": 377,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 118270,
      "end_ms": 121010,
      "text": "陵宫占地十二万平方米，",
      "token_start": 384,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 121090,
      "end_ms": 126325,
      "text": "是十三陵里规模最大、营建最早的一座长陵的冷殿，",
      "token_start": 394,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 126730,
      "end_ms": 130035,
      "text": "全用金丝楠木建成六十根大柱。",
      "token_start": 415,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 130350,
      "end_ms": 132245,
      "text": "最粗的直径一米多，",
      "token_start": 428,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 132590,
      "end_ms": 134065,
      "text": "一个人抱都抱不过来，",
      "token_start": 436,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 134800,
      "end_ms": 139335,
      "text": "六百年了木头还带着香一座长陵，",
      "token_start": 445,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 139690,
      "end_ms": 142135,
      "text": "是朱棣留给自己的归宿。",
      "token_start": 459,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 142810,
      "end_ms": 149065,
      "text": "第三名永乐大典朱棣不光修宫殿、修陵墓还修书。",
      "token_start": 469,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 149570,
      "end_ms": 150545,
      "text": "永乐元年，",
      "token_start": 489,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 151200,
      "end_ms": 152760,
      "text": "他下令节俭，",
      "token_start": 493,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 153250,
      "end_ms": 156135,
      "text": "姚广孝主持编纂一部大书，",
      "token_start": 498,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 156880,
      "end_ms": 160640,
      "text": "要樊书弃以来经史子集百家之术。",
      "token_start": 509,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 160700,
      "end_ms": 166175,
      "text": "至于天文地质、阴阳医补升道记忆之言，",
      "token_start": 523,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 166550,
      "end_ms": 167675,
      "text": "被即为一书。",
      "token_start": 539,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 168010,
      "end_ms": 171225,
      "text": "吴厌浩凡前后动用了两千一百多人，",
      "token_start": 544,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 171850,
      "end_ms": 175855,
      "text": "历时五年全书两万两千九百三十七卷，",
      "token_start": 559,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 176340,
      "end_ms": 180930,
      "text": "装订城一万一千零九十五册总字数，",
      "token_start": 575,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 181090,
      "end_ms": 182830,
      "text": "大约三亿七千万字，",
      "token_start": 590,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 183190,
      "end_ms": 186070,
      "text": "汇集了先秦到明初的典籍。",
      "token_start": 598,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 186490,
      "end_ms": 188930,
      "text": "七八千种全都是书手，",
      "token_start": 609,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 189190,
      "end_ms": 191810,
      "text": "用楷书一笔一画抄出来的。",
      "token_start": 618,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 192210,
      "end_ms": 197790,
      "text": "不列颠百科全书称它为世界有史以来最大的百科全书，",
      "token_start": 629,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 197910,
      "end_ms": 202870,
      "text": "一部大典把中国几千年的知识全装了进去。",
      "token_start": 652,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 203790,
      "end_ms": 204670,
      "text": "讲了这么多，",
      "token_start": 670,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 204910,
      "end_ms": 211940,
      "text": "您可能也发现了这些工程背后称一个都有讲不完的故事。",
      "token_start": 675,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 212320,
      "end_ms": 213560,
      "text": "长城怎么修的？",
      "token_start": 699,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 213680,
      "end_ms": 215060,
      "text": "大运河怎么通的，",
      "token_start": 705,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 215220,
      "end_ms": 216560,
      "text": "紫禁城怎么盖的？",
      "token_start": 712,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 216860,
      "end_ms": 218460,
      "text": "视频里只能讲个大概，",
      "token_start": 719,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 218780,
      "end_ms": 220320,
      "text": "要是您想多知道一点，",
      "token_start": 728,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 220460,
      "end_ms": 223560,
      "text": "我手边有本中华文化常识一千问，",
      "token_start": 737,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 224220,
      "end_ms": 225160,
      "text": "分门别类，",
      "token_start": 751,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 225340,
      "end_ms": 226180,
      "text": "一问一答，",
      "token_start": 755,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 226720,
      "end_ms": 230980,
      "text": "把中国历史上的文化常识讲的清清楚楚。",
      "token_start": 759,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 231300,
      "end_ms": 236240,
      "text": "讲城大运河、紫禁城书里都有中老年朋友，",
      "token_start": 776,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 236280,
      "end_ms": 237380,
      "text": "看着正合适，",
      "token_start": 793,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 237620,
      "end_ms": 238820,
      "text": "每天翻两页，",
      "token_start": 798,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 239160,
      "end_ms": 240470,
      "text": "心里就有谱了。",
      "token_start": 803,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 240710,
      "end_ms": 242010,
      "text": "已经放下面了，",
      "token_start": 809,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 242110,
      "end_ms": 246330,
      "text": "点开就能看到喜欢历史的弄一本放床头，",
      "token_start": 815,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 246890,
      "end_ms": 249130,
      "text": "随手翻一页就是一段历史。",
      "token_start": 832,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 250210,
      "end_ms": 250810,
      "text": "第二名，",
      "token_start": 843,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 251050,
      "end_ms": 254630,
      "text": "京杭大运河从北京到杭州，",
      "token_start": 846,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 254810,
      "end_ms": 256550,
      "text": "朱棣迁都北京以后，",
      "token_start": 857,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 257270,
      "end_ms": 260570,
      "text": "北京粮食不够吃怎么办？",
      "token_start": 865,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 261830,
      "end_ms": 265050,
      "text": "从南方运和元朝修的运河，",
      "token_start": 875,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 265470,
      "end_ms": 267390,
      "text": "好多河段淤塞了，",
      "token_start": 886,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 267550,
      "end_ms": 268290,
      "text": "走不了船。",
      "token_start": 893,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 268650,
      "end_ms": 269430,
      "text": "永乐九年，",
      "token_start": 897,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 270000,
      "end_ms": 273840,
      "text": "朱棣下令疏郡会通河公部上书送礼，",
      "token_start": 901,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 273840,
      "end_ms": 276220,
      "text": "带队征发十六万丁夫，",
      "token_start": 916,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 276740,
      "end_ms": 281120,
      "text": "把从济宁到临清三百八十五里的河道重新打通，",
      "token_start": 925,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 281760,
      "end_ms": 284220,
      "text": "又听从汶上老人白英的建议，",
      "token_start": 945,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 284620,
      "end_ms": 286020,
      "text": "在岱村筑坝，",
      "token_start": 957,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 286480,
      "end_ms": 288000,
      "text": "引汶水入运河，",
      "token_start": 962,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 288520,
      "end_ms": 289960,
      "text": "解决了水源问题。",
      "token_start": 968,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 290920,
      "end_ms": 291880,
      "text": "永乐十三年，",
      "token_start": 975,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 292080,
      "end_ms": 293560,
      "text": "运河全线畅通。",
      "token_start": 980,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 293920,
      "end_ms": 294700,
      "text": "从此以后，",
      "token_start": 986,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 294920,
      "end_ms": 295955,
      "text": "南方的粮食。",
      "token_start": 990,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 296330,
      "end_ms": 299850,
      "text": "丝绸、茶叶一船一船往北京运，",
      "token_start": 995,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 300590,
      "end_ms": 301470,
      "text": "没有这条河，",
      "token_start": 1007,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 301770,
      "end_ms": 305010,
      "text": "朱棣的北京城就站不住一条运河，",
      "token_start": 1012,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 305430,
      "end_ms": 306990,
      "text": "是迁都的底气。",
      "token_start": 1026,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 307490,
      "end_ms": 308070,
      "text": "第一名，",
      "token_start": 1032,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 308470,
      "end_ms": 310410,
      "text": "北京紫禁城永乐四年，",
      "token_start": 1035,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 310590,
      "end_ms": 312249,
      "text": "公元一四零六年，",
      "token_start": 1044,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 312630,
      "end_ms": 313510,
      "text": "朱棣下诏，",
      "token_start": 1051,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 313810,
      "end_ms": 315190,
      "text": "营建北京宫殿，",
      "token_start": 1055,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 315630,
      "end_ms": 316690,
      "text": "这就是紫禁城。",
      "token_start": 1061,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 317310,
      "end_ms": 319510,
      "text": "这一修修了十四年，",
      "token_start": 1067,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 319850,
      "end_ms": 321490,
      "text": "征调了十万工匠，",
      "token_start": 1075,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 321650,
      "end_ms": 323350,
      "text": "上百万兵丁劳工，",
      "token_start": 1082,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 323930,
      "end_ms": 327040,
      "text": "有的石头一块就种两百多吨，",
      "token_start": 1089,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 327360,
      "end_ms": 334100,
      "text": "两万民工和一千多头骡子拖了二十八天才运到工地。",
      "token_start": 1101,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 334420,
      "end_ms": 339980,
      "text": "金丝楠木从四川湖广的深山里砍下来，",
      "token_start": 1123,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 340360,
      "end_ms": 342360,
      "text": "顺着长江飘到北京。",
      "token_start": 1139,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 342780,
      "end_ms": 344280,
      "text": "占殿修好以后，",
      "token_start": 1147,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 344520,
      "end_ms": 346500,
      "text": "占地七十二万平方米，",
      "token_start": 1153,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 346860,
      "end_ms": 348520,
      "text": "房屋九千多间。",
      "token_start": 1162,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 348820,
      "end_ms": 352780,
      "text": "太和殿、中和殿、保和殿三大殿，",
      "token_start": 1168,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 352960,
      "end_ms": 353800,
      "text": "一字排开，",
      "token_start": 1180,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 354760,
      "end_ms": 357405,
      "text": "红墙黄瓦层层叠叠。",
      "token_start": 1184,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 357980,
      "end_ms": 359235,
      "text": "六百年过去了，",
      "token_start": 1192,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 359490,
      "end_ms": 362795,
      "text": "明清两朝二十四个皇帝在这儿住过。",
      "token_start": 1198,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 363110,
      "end_ms": 363550,
      "text": "今天，",
      "token_start": 1213,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 363890,
      "end_ms": 364725,
      "text": "他叫故宫，",
      "token_start": 1215,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 365220,
      "end_ms": 372065,
      "text": "是世界上现存规模最大、保存最完整的木结构宫殿建筑群。",
      "token_start": 1219,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 372750,
      "end_ms": 378425,
      "text": "每年上千万人从全世界各地来看他一座紫禁城，",
      "token_start": 1243,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 378850,
      "end_ms": 381825,
      "text": "是朱棣留给中国最大的礼物。",
      "token_start": 1263,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 382470,
      "end_ms": 383570,
      "text": "您听出来了没有？",
      "token_start": 1275,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 383590,
      "end_ms": 384655,
      "text": "这十件大事，",
      "token_start": 1282,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 384990,
      "end_ms": 387165,
      "text": "没有一件是随便干的。",
      "token_start": 1287,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 387440,
      "end_ms": 390690,
      "text": "大报恩赐的琉璃塔是面母，",
      "token_start": 1296,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 390770,
      "end_ms": 392565,
      "text": "天坛是敬天，",
      "token_start": 1307,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 393140,
      "end_ms": 393860,
      "text": "龙江宝，",
      "token_start": 1312,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 393860,
      "end_ms": 395405,
      "text": "船厂是造箭，",
      "token_start": 1315,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 395810,
      "end_ms": 397535,
      "text": "武当山是重道，",
      "token_start": 1320,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 397980,
      "end_ms": 399705,
      "text": "明长城是守边，",
      "token_start": 1326,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 400220,
      "end_ms": 402465,
      "text": "郑和下西洋是通史，",
      "token_start": 1332,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 402980,
      "end_ms": 405035,
      "text": "明长陵是归处，",
      "token_start": 1340,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 405450,
      "end_ms": 407735,
      "text": "永乐大典是修文，",
      "token_start": 1346,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 408070,
      "end_ms": 410450,
      "text": "京杭大运河是通曹，",
      "token_start": 1353,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 410770,
      "end_ms": 412495,
      "text": "紫禁城是丽都，",
      "token_start": 1361,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 413060,
      "end_ms": 415815,
      "text": "每一件事都不只是一个工程，",
      "token_start": 1367,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 416200,
      "end_ms": 418680,
      "text": "是朱棣对这片土地的理解，",
      "token_start": 1379,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 419380,
      "end_ms": 420160,
      "text": "点个关注，",
      "token_start": 1390,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 420420,
      "end_ms": 422055,
      "text": "咱们下期接着聊。",
      "token_start": 1394,
      "token_end_exclusive": 1401
    }
  ],
