  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_72981e8ccac3d4d8.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 330,
      "end_ms": 1670,
      "text": "这鸭子是好鸭子，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2390,
      "end_ms": 3170,
      "text": "就是嘴硬，",
      "token_start": 7,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 4530,
      "end_ms": 4910,
      "text": "嘴硬，",
      "token_start": 11,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 4910,
      "end_ms": 5810,
      "text": "才守得住秘密。",
      "token_start": 13,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 9630,
      "end_ms": 10850,
      "text": "这藕是好藕啊，",
      "token_start": 19,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 11170,
      "end_ms": 12510,
      "text": "就是心眼太多了。",
      "token_start": 25,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 13070,
      "end_ms": 14770,
      "text": "领导藕虽然心眼多，",
      "token_start": 32,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 14850,
      "end_ms": 16090,
      "text": "但也是您的下酒菜啊。",
      "token_start": 40,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 19350,
      "end_ms": 20530,
      "text": "年轻就是好啊，",
      "token_start": 49,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 21330,
      "end_ms": 22570,
      "text": "年轻就是还不够沉稳，",
      "token_start": 55,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 22850,
      "end_ms": 23810,
      "text": "还要向您多学习，",
      "token_start": 64,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 23890,
      "end_ms": 24970,
      "text": "我们才能变得更优秀。",
      "token_start": 71,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 27730,
      "end_ms": 28490,
      "text": "打这么多饭，",
      "token_start": 80,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 28690,
      "end_ms": 29390,
      "text": "你喂猪呢？",
      "token_start": 85,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 29610,
      "end_ms": 29985,
      "text": "领导，",
      "token_start": 89,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 30240,
      "end_ms": 30980,
      "text": "我哪敢啊，",
      "token_start": 91,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 31100,
      "end_ms": 33180,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 95,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 33260,
      "end_ms": 34740,
      "text": "都说宰相肚里能撑船，",
      "token_start": 111,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 34900,
      "end_ms": 36280,
      "text": "更何况只是一碗饭呢。",
      "token_start": 120,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 37600,
      "end_ms": 37840,
      "text": "哎，",
      "token_start": 129,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 38400,
      "end_ms": 39280,
      "text": "你什么意思啊？",
      "token_start": 130,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 39520,
      "end_ms": 41080,
      "text": "怎么到我这儿就剩半杯了？",
      "token_start": 136,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 41180,
      "end_ms": 42640,
      "text": "领导美满美满，",
      "token_start": 147,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 42660,
      "end_ms": 43660,
      "text": "代表幸福美满，",
      "token_start": 153,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 43860,
      "end_ms": 45740,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 159,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 47000,
      "end_ms": 48140,
      "text": "怎么你这一入职，",
      "token_start": 173,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 48420,
      "end_ms": 49820,
      "text": "我刚种的花就死了，",
      "token_start": 180,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 50420,
      "end_ms": 51500,
      "text": "花开富贵嘛，",
      "token_start": 188,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 51580,
      "end_ms": 53100,
      "text": "花开过了就剩富贵了。",
      "token_start": 193,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 53280,
      "end_ms": 55140,
      "text": "看来领导您啊要发大财了，",
      "token_start": 202,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 57100,
      "end_ms": 58800,
      "text": "来就来带什么礼物啊，",
      "token_start": 213,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 58880,
      "end_ms": 59760,
      "text": "都不是外人。",
      "token_start": 222,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 60150,
      "end_ms": 60370,
      "text": "哎呀，",
      "token_start": 227,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 60370,
      "end_ms": 61010,
      "text": "您都说了，",
      "token_start": 229,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 61010,
      "end_ms": 61670,
      "text": "不是外人，",
      "token_start": 233,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 61790,
      "end_ms": 63305,
      "text": "我一直都把您当长辈看，",
      "token_start": 237,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 63570,
      "end_ms": 66305,
      "text": "哪有晚辈看长辈空手来的道理啊，",
      "token_start": 247,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 67220,
      "end_ms": 68465,
      "text": "今天让你破费了，",
      "token_start": 261,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 68960,
      "end_ms": 70455,
      "text": "领导饭钱是小事儿，",
      "token_start": 268,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 70860,
      "end_ms": 72545,
      "text": "能跟您单独请教一次。",
      "token_start": 276,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 72870,
      "end_ms": 74330,
      "text": "这顿对我来说是投资，",
      "token_start": 285,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 75930,
      "end_ms": 77330,
      "text": "真会说话来，",
      "token_start": 294,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 77330,
      "end_ms": 79145,
      "text": "这么晚只能吃剩菜了吧。",
      "token_start": 299,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 79370,
      "end_ms": 80250,
      "text": "李总饭在哪儿？",
      "token_start": 309,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 80250,
      "end_ms": 80750,
      "text": "我都能吃，",
      "token_start": 315,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 80950,
      "end_ms": 82710,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 319,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 82710,
      "end_ms": 84125,
      "text": "能赶上已经是我的运气了，",
      "token_start": 332,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 85260,
      "end_ms": 85740,
      "text": "坐吧，",
      "token_start": 343,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 85960,
      "end_ms": 87115,
      "text": "我们再点两个菜，",
      "token_start": 345,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 87460,
      "end_ms": 88900,
      "text": "你一开口就让人喜欢你，",
      "token_start": 352,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 88920,
      "end_ms": 89835,
      "text": "你是怎么做到的？",
      "token_start": 362,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 90220,
      "end_ms": 92600,
      "text": "因为我一直在看这本说的恰到好处，",
      "token_start": 369,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 92860,
      "end_ms": 94500,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 384,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 94580,
      "end_ms": 96400,
      "text": "那些会说话、会来事儿的人。",
      "token_start": 395,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 96420,
      "end_ms": 97480,
      "text": "假如你不爱说话，",
      "token_start": 406,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 97580,
      "end_ms": 98300,
      "text": "不爱争辩，",
      "token_start": 413,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 98360,
      "end_ms": 99200,
      "text": "也不爱出门，",
      "token_start": 417,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 99320,
      "end_ms": 100515,
      "text": "甚至恐惧社交，",
      "token_start": 422,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 100880,
      "end_ms": 103140,
      "text": "推荐你读完这本说的恰到好处，",
      "token_start": 428,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 103260,
      "end_ms": 105525,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 441,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 105820,
      "end_ms": 107000,
      "text": "你每天就看两页，",
      "token_start": 453,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 107180,
      "end_ms": 108540,
      "text": "每一个场景慢慢练，",
      "token_start": 460,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 108760,
      "end_ms": 111445,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 468,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 111680,
      "end_ms": 112940,
      "text": "在这本书里有一句话，",
      "token_start": 483,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 113020,
      "end_ms": 113935,
      "text": "我特别欣赏，",
      "token_start": 492,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 114230,
      "end_ms": 114370,
      "text": "他，",
      "token_start": 497,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 114370,
      "end_ms": 116370,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 498,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 116570,
      "end_ms": 117335,
      "text": "你可以回，",
      "token_start": 510,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 117810,
      "end_ms": 118770,
      "text": "那是不优秀点，",
      "token_start": 514,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 118830,
      "end_ms": 120195,
      "text": "怎么能和你做朋友呢？",
      "token_start": 520,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 120520,
      "end_ms": 122140,
      "text": "当有人说你真聪明，",
      "token_start": 529,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 122240,
      "end_ms": 123940,
      "text": "你就回近朱者赤，",
      "token_start": 537,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 124220,
      "end_ms": 125155,
      "text": "和你在一起啊，",
      "token_start": 544,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 125410,
      "end_ms": 128360,
      "text": "新都熏出来了当领导跟你说辛苦了，",
      "token_start": 550,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 128440,
      "end_ms": 129600,
      "text": "你就回领导，",
      "token_start": 565,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 129820,
      "end_ms": 131105,
      "text": "这都是我应该做的。",
      "token_start": 570,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 131400,
      "end_ms": 132785,
      "text": "强将手下吴若冰，",
      "token_start": 578,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 133070,
      "end_ms": 134455,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 585,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 134720,
      "end_ms": 136000,
      "text": "当我看到这段的时候，",
      "token_start": 594,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 136080,
      "end_ms": 137755,
      "text": "这个真是让我欲解心开呀。",
      "token_start": 603,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 138120,
      "end_ms": 139435,
      "text": "每一句都很有意思，",
      "token_start": 614,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 139760,
      "end_ms": 142240,
      "text": "就是手把手教我们在不同的场景之下，",
      "token_start": 622,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 142260,
      "end_ms": 142980,
      "text": "应该怎么说。",
      "token_start": 638,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 143220,
      "end_ms": 145885,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 643,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 146160,
      "end_ms": 147525,
      "text": "你就放心的拿回去看，",
      "token_start": 661,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 147880,
      "end_ms": 149220,
      "text": "就是一句一句的教你，",
      "token_start": 670,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 149460,
      "end_ms": 151995,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 679,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 152320,
      "end_ms": 153360,
      "text": "但凡学会三分，",
      "token_start": 691,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 153580,
      "end_ms": 155985,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 697,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 156370,
      "end_ms": 158025,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 711,
      "token_end_exclusive": 723
    }
  ],
