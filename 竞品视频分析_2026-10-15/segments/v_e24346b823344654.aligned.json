{
  "video_id": "v_e24346b823344654",
  "duration_s": 163.44381,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_e24346b823344654.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_e24346b823344654.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 1290,
      "text": "刘欢老师走了，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1590,
      "end_ms": 2790,
      "text": "享年六十三岁。",
      "token_start": 6,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 3270,
      "end_ms": 4170,
      "text": "听到这个消息，",
      "token_start": 12,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4810,
      "end_ms": 6090,
      "text": "我简直不敢相信，",
      "token_start": 18,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6650,
      "end_ms": 9190,
      "text": "怎么一个好好的人说走就走了呢？",
      "token_start": 25,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9550,
      "end_ms": 11110,
      "text": "毕竟才退休三年啊，",
      "token_start": 39,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 11490,
      "end_ms": 13030,
      "text": "正是享福的好日子，",
      "token_start": 47,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 13490,
      "end_ms": 15130,
      "text": "他唱了很多好听的歌曲，",
      "token_start": 55,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 15330,
      "end_ms": 23190,
      "text": "比如好汉歌、弯弯的月亮、少年壮志不言愁已经成为了一代又一代人心目中永恒的回忆。",
      "token_start": 65,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 24270,
      "end_ms": 27210,
      "text": "最近啊令人震惊的消息真的是太多了。",
      "token_start": 101,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 27410,
      "end_ms": 28170,
      "text": "半个月前，",
      "token_start": 117,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 28670,
      "end_ms": 30600,
      "text": "主持人金一丹老师走了，",
      "token_start": 121,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 30900,
      "end_ms": 34780,
      "text": "前几天济公的扮演者游本昌老师也走了。",
      "token_start": 131,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 35700,
      "end_ms": 38680,
      "text": "或许我们真的是到年纪了，",
      "token_start": 148,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 39440,
      "end_ms": 42320,
      "text": "到了目送那些伴随我们成长，",
      "token_start": 159,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 42560,
      "end_ms": 43580,
      "text": "带给我们欢乐，",
      "token_start": 171,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 43860,
      "end_ms": 48180,
      "text": "遇到啥事总能第一时间拨通电话的人离开的年纪，",
      "token_start": 177,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 48740,
      "end_ms": 51220,
      "text": "我同样也经历过至亲的离去，",
      "token_start": 198,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 51780,
      "end_ms": 53680,
      "text": "总觉得生命无常。",
      "token_start": 210,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 55120,
      "end_ms": 57280,
      "text": "每次目送一个人离开，",
      "token_start": 217,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 57980,
      "end_ms": 61545,
      "text": "总觉得自己好像往前走了一排似的。",
      "token_start": 226,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 62380,
      "end_ms": 64120,
      "text": "所以啊作为活着的人，",
      "token_start": 241,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 64320,
      "end_ms": 65815,
      "text": "我们到底该怎么做呢？",
      "token_start": 250,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 66340,
      "end_ms": 67675,
      "text": "其实无非就两个字，",
      "token_start": 259,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 68120,
      "end_ms": 69650,
      "text": "珍惜第一，",
      "token_start": 267,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 69830,
      "end_ms": 70710,
      "text": "珍惜身体。",
      "token_start": 271,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 71270,
      "end_ms": 72370,
      "text": "人这一辈子啊，",
      "token_start": 275,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 72550,
      "end_ms": 73545,
      "text": "除了健康，",
      "token_start": 281,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 74010,
      "end_ms": 75110,
      "text": "什么都不是你的，",
      "token_start": 285,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 75650,
      "end_ms": 76290,
      "text": "少内耗，",
      "token_start": 292,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 76650,
      "end_ms": 77410,
      "text": "少计较，",
      "token_start": 295,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 77510,
      "end_ms": 78305,
      "text": "少生气，",
      "token_start": 298,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 78640,
      "end_ms": 79745,
      "text": "百病生于器。",
      "token_start": 301,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 80340,
      "end_ms": 81335,
      "text": "只要你不生气，",
      "token_start": 306,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 81730,
      "end_ms": 82870,
      "text": "你就很难生病，",
      "token_start": 312,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 83370,
      "end_ms": 85885,
      "text": "有个好身体比什么都重要。",
      "token_start": 318,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 86250,
      "end_ms": 88845,
      "text": "第二就是珍惜眼前人。",
      "token_start": 329,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 89190,
      "end_ms": 91710,
      "text": "我们这一辈子啊和你具有亲密关系。",
      "token_start": 338,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 91710,
      "end_ms": 92615,
      "text": "很重要的人，",
      "token_start": 353,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 92990,
      "end_ms": 94370,
      "text": "无非就是爱人。",
      "token_start": 358,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 94610,
      "end_ms": 97175,
      "text": "孩子父母三两知己，",
      "token_start": 364,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 97550,
      "end_ms": 98905,
      "text": "掰着手指头数一数，",
      "token_start": 372,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 99180,
      "end_ms": 100405,
      "text": "也就是那么几个，",
      "token_start": 380,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 100770,
      "end_ms": 101435,
      "text": "真的不多。",
      "token_start": 387,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 101880,
      "end_ms": 104625,
      "text": "所以啊请你一定要远离消耗你的人，",
      "token_start": 391,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 104980,
      "end_ms": 106640,
      "text": "好好珍惜眼前人就行，",
      "token_start": 406,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 107020,
      "end_ms": 109375,
      "text": "不要等到失去了才懂得珍惜，",
      "token_start": 415,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 109690,
      "end_ms": 111130,
      "text": "也不要等到告别了，",
      "token_start": 427,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 111490,
      "end_ms": 112635,
      "text": "才懂得珍重。",
      "token_start": 435,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 113010,
      "end_ms": 115935,
      "text": "第三就是珍惜生活，",
      "token_start": 440,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 116700,
      "end_ms": 119995,
      "text": "珍惜你现在每一个能蹦能跳的好日子。",
      "token_start": 448,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 120610,
      "end_ms": 124290,
      "text": "其实这都是上天给予你的限量版好用的东西，",
      "token_start": 464,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 124290,
      "end_ms": 124930,
      "text": "你就多用，",
      "token_start": 483,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 125270,
      "end_ms": 127250,
      "text": "喜欢穿的衣服你就多穿。",
      "token_start": 487,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 127670,
      "end_ms": 130110,
      "text": "别总当个宝想去的地方，",
      "token_start": 497,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 130250,
      "end_ms": 131055,
      "text": "推门就去，",
      "token_start": 507,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 131440,
      "end_ms": 134785,
      "text": "别等以后等将来等有空等着等着，",
      "token_start": 511,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 135280,
      "end_ms": 138115,
      "text": "可能到最后你什么都不想要了。",
      "token_start": 525,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 138720,
      "end_ms": 139360,
      "text": "人生啊，",
      "token_start": 538,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 139620,
      "end_ms": 140515,
      "text": "不要总以为，",
      "token_start": 541,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 140930,
      "end_ms": 141730,
      "text": "来日方长，",
      "token_start": 546,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 142250,
      "end_ms": 143610,
      "text": "其实都是世事无常，",
      "token_start": 550,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 144110,
      "end_ms": 146030,
      "text": "好好珍惜享受。",
      "token_start": 558,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 146030,
      "end_ms": 147870,
      "text": "现在既是对自己，",
      "token_start": 564,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 148090,
      "end_ms": 149165,
      "text": "也是对家人，",
      "token_start": 571,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 149790,
      "end_ms": 155545,
      "text": "最后祝愿屏幕前的每一个人幸福、健康、平安，",
      "token_start": 576,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 155920,
      "end_ms": 160125,
      "text": "也祝愿刘欢老师一路走好。",
      "token_start": 594,
      "token_end_exclusive": 605
    }
  ],
