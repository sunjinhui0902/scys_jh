{
  "video_id": "v_ca658fdf2e49e804",
  "duration_s": 299.675011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_ca658fdf2e49e804.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_ca658fdf2e49e804.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 1620,
      "end_ms": 1960,
      "text": "儿子，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1960,
      "end_ms": 2600,
      "text": "你怎么了？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 3440,
      "end_ms": 6800,
      "text": "领导让我去后备箱拿茅台里面明明空的，",
      "token_start": 6,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 7200,
      "end_ms": 8160,
      "text": "我实话实说，",
      "token_start": 23,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 8580,
      "end_ms": 9900,
      "text": "结果被骂了一顿，",
      "token_start": 28,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 10440,
      "end_ms": 12060,
      "text": "项目也给别人做了。",
      "token_start": 35,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 12300,
      "end_ms": 13080,
      "text": "傻孩子，",
      "token_start": 43,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 13540,
      "end_ms": 15580,
      "text": "领导能不知道自己车里没酒吗？",
      "token_start": 46,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15920,
      "end_ms": 17200,
      "text": "人家要的是结果，",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 18340,
      "end_ms": 21380,
      "text": "你看看这个视频学学人家是怎么做的。",
      "token_start": 66,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 21460,
      "end_ms": 21860,
      "text": "小李，",
      "token_start": 82,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 22140,
      "end_ms": 23955,
      "text": "你把我后备箱里的茅台拿上去，",
      "token_start": 84,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 29460,
      "end_ms": 30340,
      "text": "领导的暗示，",
      "token_start": 97,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 30380,
      "end_ms": 31440,
      "text": "你能听得懂吗？",
      "token_start": 102,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 32440,
      "end_ms": 33160,
      "text": "没有啊，",
      "token_start": 108,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 33740,
      "end_ms": 38400,
      "text": "哎被偷你干什么？",
      "token_start": 111,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 39320,
      "end_ms": 39740,
      "text": "赵总，",
      "token_start": 118,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 39740,
      "end_ms": 40440,
      "text": "茅台都被偷了，",
      "token_start": 120,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 40440,
      "end_ms": 41500,
      "text": "你为什么不让我说呀？",
      "token_start": 126,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 41580,
      "end_ms": 43720,
      "text": "领导能不知道后备箱有没有酒吗？",
      "token_start": 135,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 43740,
      "end_ms": 46200,
      "text": "不不是职场场上理错错，",
      "token_start": 149,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 46220,
      "end_ms": 47560,
      "text": "领导的意思是大忌。",
      "token_start": 159,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 48060,
      "end_ms": 49000,
      "text": "车里没有酒，",
      "token_start": 167,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 49260,
      "end_ms": 50600,
      "text": "总总却让你送上去，",
      "token_start": 172,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 50720,
      "end_ms": 51980,
      "text": "说明他只在意结果，",
      "token_start": 180,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 52240,
      "end_ms": 53320,
      "text": "你又何必去在意。",
      "token_start": 188,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 53320,
      "end_ms": 56840,
      "text": "车里酒的去向和真实性呢满足领导的需求最重要。",
      "token_start": 195,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 56840,
      "end_ms": 57080,
      "text": "哦，",
      "token_start": 216,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 60280,
      "end_ms": 60755,
      "text": "赵总，",
      "token_start": 217,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 61290,
      "end_ms": 62130,
      "text": "您车里的东西呢，",
      "token_start": 219,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 62130,
      "end_ms": 62830,
      "text": "我不好乱翻，",
      "token_start": 226,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 62830,
      "end_ms": 63530,
      "text": "就自己准备了。",
      "token_start": 231,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 63530,
      "end_ms": 64600,
      "text": "四瓶两瓶，",
      "token_start": 237,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 64600,
      "end_ms": 65420,
      "text": "留在您车里了，",
      "token_start": 241,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 65420,
      "end_ms": 67035,
      "text": "这两瓶拿上来您先用，",
      "token_start": 247,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 71490,
      "end_ms": 75330,
      "text": "姑赵总，",
      "token_start": 256,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 75510,
      "end_ms": 76450,
      "text": "咱们下次见啊。",
      "token_start": 259,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 76450,
      "end_ms": 76830,
      "text": "哎好，",
      "token_start": 265,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 76850,
      "end_ms": 77225,
      "text": "哎，",
      "token_start": 267,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 77900,
      "end_ms": 78280,
      "text": "刘总，",
      "token_start": 268,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 78280,
      "end_ms": 79265,
      "text": "你怎么走了呀？",
      "token_start": 270,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 79890,
      "end_ms": 81655,
      "text": "是不是嫌报价不满意啊？",
      "token_start": 276,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 85130,
      "end_ms": 85415,
      "text": "哎，",
      "token_start": 286,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 87200,
      "end_ms": 87920,
      "text": "恭喜赵总，",
      "token_start": 287,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 87920,
      "end_ms": 90445,
      "text": "拿下合同小李，",
      "token_start": 291,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 90840,
      "end_ms": 92055,
      "text": "后续你来负责吧。",
      "token_start": 297,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 93510,
      "end_ms": 93750,
      "text": "哎，",
      "token_start": 304,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 93930,
      "end_ms": 96300,
      "text": "赵总这没有，",
      "token_start": 305,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 96450,
      "end_ms": 96690,
      "text": "哎，",
      "token_start": 310,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 96890,
      "end_ms": 98395,
      "text": "这赵总这怎么回事啊？",
      "token_start": 311,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 98780,
      "end_ms": 100240,
      "text": "这个项目一直是大刘在负责，",
      "token_start": 320,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 100540,
      "end_ms": 101955,
      "text": "赵总突然把项目给我了。",
      "token_start": 332,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 102260,
      "end_ms": 104955,
      "text": "茶汤回壶是谈判的收尾动作，",
      "token_start": 342,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 105480,
      "end_ms": 106725,
      "text": "象征着交易达成。",
      "token_start": 354,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 107280,
      "end_ms": 108660,
      "text": "大刘连这个都不懂，",
      "token_start": 361,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 108960,
      "end_ms": 110715,
      "text": "赵总怎么敢把项目交给他呀？",
      "token_start": 369,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 111170,
      "end_ms": 111965,
      "text": "不能吧，",
      "token_start": 381,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 112400,
      "end_ms": 113240,
      "text": "人情世故，",
      "token_start": 384,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 113400,
      "end_ms": 114545,
      "text": "可是门大学问，",
      "token_start": 388,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 115050,
      "end_ms": 115970,
      "text": "你要学的呀，",
      "token_start": 394,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 116130,
      "end_ms": 117035,
      "text": "还多着呢。",
      "token_start": 399,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 119810,
      "end_ms": 120230,
      "text": "老婆，",
      "token_start": 403,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 120450,
      "end_ms": 120690,
      "text": "赵，",
      "token_start": 405,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 120710,
      "end_ms": 121910,
      "text": "总把上次酒钱转过来了，",
      "token_start": 406,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 121910,
      "end_ms": 124210,
      "text": "你看哎，",
      "token_start": 416,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 124230,
      "end_ms": 125190,
      "text": "你怎么收了呀？",
      "token_start": 419,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 125250,
      "end_ms": 126030,
      "text": "赵总转多了，",
      "token_start": 425,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 126030,
      "end_ms": 127150,
      "text": "你赶紧给他退回去，",
      "token_start": 430,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 127330,
      "end_ms": 129070,
      "text": "你自以为有原则的退还，",
      "token_start": 438,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 129250,
      "end_ms": 130630,
      "text": "只会让领导觉得麻烦，",
      "token_start": 448,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 130830,
      "end_ms": 132410,
      "text": "还不如大大方方收下呢。",
      "token_start": 457,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 132930,
      "end_ms": 134390,
      "text": "那我是不是得说点啥呀，",
      "token_start": 467,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 134870,
      "end_ms": 136050,
      "text": "你就说感谢领导，",
      "token_start": 477,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 136050,
      "end_ms": 136470,
      "text": "大气，",
      "token_start": 484,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 136690,
      "end_ms": 138330,
      "text": "果然跟着领导有甜头吃，",
      "token_start": 486,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 139230,
      "end_ms": 140130,
      "text": "就这样就行了。",
      "token_start": 496,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 140270,
      "end_ms": 141415,
      "text": "当然不行啊，",
      "token_start": 502,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 143720,
      "end_ms": 144120,
      "text": "赵总，",
      "token_start": 507,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 144120,
      "end_ms": 145520,
      "text": "请大家喝奶茶了啊，",
      "token_start": 509,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 145520,
      "end_ms": 148715,
      "text": "人人都有再掌声殿下了。",
      "token_start": 517,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 152330,
      "end_ms": 153910,
      "text": "我什么时候请大家喝奶茶了？",
      "token_start": 527,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 154430,
      "end_ms": 154970,
      "text": "奶茶钱，",
      "token_start": 539,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 154970,
      "end_ms": 156770,
      "text": "您不是跟着酒钱一块儿转给我了吗？",
      "token_start": 542,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 157630,
      "end_ms": 159850,
      "text": "小李周天来家里坐坐，",
      "token_start": 557,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 160030,
      "end_ms": 161210,
      "text": "尝尝你嫂子的手艺。",
      "token_start": 566,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 165900,
      "end_ms": 166140,
      "text": "哎，",
      "token_start": 574,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 166480,
      "end_ms": 166860,
      "text": "嫂子，",
      "token_start": 575,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 166860,
      "end_ms": 167600,
      "text": "你可算出来了，",
      "token_start": 577,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 167600,
      "end_ms": 168655,
      "text": "我都快憋死了。",
      "token_start": 583,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 171840,
      "end_ms": 172240,
      "text": "李恩，",
      "token_start": 589,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 172820,
      "end_ms": 173480,
      "text": "你拉我干什么？",
      "token_start": 591,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 173480,
      "end_ms": 174160,
      "text": "我也很急呀，",
      "token_start": 597,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 174160,
      "end_ms": 174740,
      "text": "憋死了，",
      "token_start": 602,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 176960,
      "end_ms": 180520,
      "text": "不知道的还以为洗手间是什么好地方。",
      "token_start": 605,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 180760,
      "end_ms": 181205,
      "text": "哎呀，",
      "token_start": 621,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 181590,
      "end_ms": 182030,
      "text": "行了，",
      "token_start": 623,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 182230,
      "end_ms": 183170,
      "text": "你们做我去做饭，",
      "token_start": 625,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 183310,
      "end_ms": 186100,
      "text": "老赵帮我处理一下鱼啊。",
      "token_start": 632,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 186100,
      "end_ms": 186965,
      "text": "哦老婆，",
      "token_start": 642,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 187480,
      "end_ms": 188265,
      "text": "我怎么看？",
      "token_start": 645,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 188900,
      "end_ms": 190380,
      "text": "赵总和嫂子有点不高兴，",
      "token_start": 649,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 190720,
      "end_ms": 192705,
      "text": "因为异性厕所十分钟效应，",
      "token_start": 659,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 193040,
      "end_ms": 193320,
      "text": "人家。",
      "token_start": 670,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 193320,
      "end_ms": 193620,
      "text": "赵总，",
      "token_start": 672,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 193620,
      "end_ms": 195200,
      "text": "老婆刚从卫生间出来，",
      "token_start": 674,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 195260,
      "end_ms": 196220,
      "text": "你就是再着急，",
      "token_start": 683,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 196220,
      "end_ms": 199835,
      "text": "你等十分钟再怎么可能是因为这个你照做就行。",
      "token_start": 689,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 200990,
      "end_ms": 201210,
      "text": "嗯，",
      "token_start": 709,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 201210,
      "end_ms": 201960,
      "text": "好嫂子，",
      "token_start": 710,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 201960,
      "end_ms": 203550,
      "text": "我来帮你身边。",
      "token_start": 713,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 205720,
      "end_ms": 206120,
      "text": "赵总，",
      "token_start": 719,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 206180,
      "end_ms": 206640,
      "text": "嫂子，",
      "token_start": 721,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 206780,
      "end_ms": 207645,
      "text": "那我先走了，",
      "token_start": 723,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 209700,
      "end_ms": 211560,
      "text": "那我们也先走小李，",
      "token_start": 728,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 211560,
      "end_ms": 213100,
      "text": "留下接待王总的事情，",
      "token_start": 736,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 213100,
      "end_ms": 213900,
      "text": "咱们再碰一下，",
      "token_start": 745,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 213980,
      "end_ms": 215195,
      "text": "那得叫小张回来呀，",
      "token_start": 751,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 215570,
      "end_ms": 217165,
      "text": "不用你来负责就行。",
      "token_start": 759,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 217570,
      "end_ms": 217830,
      "text": "好的，",
      "token_start": 767,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 217830,
      "end_ms": 218165,
      "text": "赵总，",
      "token_start": 769,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 218430,
      "end_ms": 218650,
      "text": "哎，",
      "token_start": 771,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 218650,
      "end_ms": 219115,
      "text": "老婆，",
      "token_start": 772,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 219520,
      "end_ms": 222015,
      "text": "你这个厕所十分钟效应还真有说法，",
      "token_start": 774,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 222540,
      "end_ms": 224415,
      "text": "这都是不成文的社交规矩。",
      "token_start": 789,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 224830,
      "end_ms": 227050,
      "text": "你呀多看看这本闲谈高手，",
      "token_start": 800,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 227230,
      "end_ms": 228290,
      "text": "假如你不爱说话，",
      "token_start": 811,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 228330,
      "end_ms": 229010,
      "text": "不爱争辩，",
      "token_start": 818,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 229030,
      "end_ms": 229770,
      "text": "也不爱出门，",
      "token_start": 822,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 229850,
      "end_ms": 230850,
      "text": "甚至恐惧社交，",
      "token_start": 827,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 230990,
      "end_ms": 232090,
      "text": "你就每天看两页，",
      "token_start": 833,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 232170,
      "end_ms": 233405,
      "text": "每一个场景慢慢练，",
      "token_start": 840,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 233620,
      "end_ms": 235260,
      "text": "你也会变成一个会说话的人。",
      "token_start": 848,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 235260,
      "end_ms": 236440,
      "text": "当我听到这句话的时候，",
      "token_start": 860,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 236440,
      "end_ms": 237615,
      "text": "我的眼泪就出来了。",
      "token_start": 870,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 237840,
      "end_ms": 239180,
      "text": "他写的是别人夸你优秀，",
      "token_start": 878,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 239180,
      "end_ms": 239660,
      "text": "你就回，",
      "token_start": 888,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 239760,
      "end_ms": 240780,
      "text": "那是不优秀点，",
      "token_start": 891,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 240920,
      "end_ms": 242080,
      "text": "怎么能和你做朋友？",
      "token_start": 897,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 242240,
      "end_ms": 243185,
      "text": "你看很有味道，",
      "token_start": 905,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 243420,
      "end_ms": 244320,
      "text": "假如不爱说话，",
      "token_start": 911,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 244400,
      "end_ms": 245080,
      "text": "不爱争辩，",
      "token_start": 917,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 245080,
      "end_ms": 245860,
      "text": "也不爱出门，",
      "token_start": 921,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 245980,
      "end_ms": 246980,
      "text": "甚至恐惧社交，",
      "token_start": 926,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 247160,
      "end_ms": 248275,
      "text": "你每天就看两页，",
      "token_start": 932,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 248520,
      "end_ms": 249820,
      "text": "每一个场景慢慢练，",
      "token_start": 939,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 249940,
      "end_ms": 252320,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 947,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 252360,
      "end_ms": 252580,
      "text": "哇，",
      "token_start": 962,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 252580,
      "end_ms": 253565,
      "text": "这真是太棒了。",
      "token_start": 963,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 253860,
      "end_ms": 254620,
      "text": "在这本书里边，",
      "token_start": 969,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 254620,
      "end_ms": 255835,
      "text": "有一句话我特别欣赏。",
      "token_start": 975,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 256160,
      "end_ms": 257580,
      "text": "他说有人嘲讽你眼睛小，",
      "token_start": 984,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 257580,
      "end_ms": 258480,
      "text": "高情商回答，",
      "token_start": 994,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 258500,
      "end_ms": 259540,
      "text": "万物皆有裂痕，",
      "token_start": 999,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 259620,
      "end_ms": 261040,
      "text": "那是光进来的地方。",
      "token_start": 1005,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 261260,
      "end_ms": 261440,
      "text": "哇，",
      "token_start": 1013,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 261440,
      "end_ms": 262400,
      "text": "这真是太棒了，",
      "token_start": 1014,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 262420,
      "end_ms": 263540,
      "text": "每一句都很有意思，",
      "token_start": 1020,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 263540,
      "end_ms": 264480,
      "text": "随便翻对吧？",
      "token_start": 1028,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 264480,
      "end_ms": 264660,
      "text": "哇，",
      "token_start": 1033,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 264660,
      "end_ms": 265705,
      "text": "这句话太棒了。",
      "token_start": 1034,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 266050,
      "end_ms": 267810,
      "text": "他写的是别人问你一个月工资多少，",
      "token_start": 1040,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 267810,
      "end_ms": 269345,
      "text": "你就回比以前好多了，",
      "token_start": 1055,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 269720,
      "end_ms": 270440,
      "text": "现在吃泡面，",
      "token_start": 1064,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 270440,
      "end_ms": 271540,
      "text": "敢放两根肠了。",
      "token_start": 1069,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 271540,
      "end_ms": 272540,
      "text": "我读到这段的时候，",
      "token_start": 1075,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 272540,
      "end_ms": 274525,
      "text": "我觉得这个让我真是欲解心开啊，",
      "token_start": 1083,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 274740,
      "end_ms": 276335,
      "text": "这本书就像是个社交宝典，",
      "token_start": 1097,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 276610,
      "end_ms": 279510,
      "text": "把各种社交场景都变成了问题加答案的形式。",
      "token_start": 1108,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 279630,
      "end_ms": 282075,
      "text": "你说哪家的书架上不应该有一本这个书，",
      "token_start": 1127,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 282310,
      "end_ms": 285250,
      "text": "就手把手的教我们不同的场景之下应该怎么说？",
      "token_start": 1144,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 285570,
      "end_ms": 288235,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1164,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 288420,
      "end_ms": 289600,
      "text": "你就放心拿回去看，",
      "token_start": 1182,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 289600,
      "end_ms": 290960,
      "text": "就是一句一句的教你，",
      "token_start": 1190,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 291160,
      "end_ms": 293675,
      "text": "这是我这几年来讲过的最简单的一本书。",
      "token_start": 1199,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 294020,
      "end_ms": 295405,
      "text": "我觉得这书适合所有人，",
      "token_start": 1216,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 295660,
      "end_ms": 296160,
      "text": "让你不管，",
      "token_start": 1226,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 296160,
      "end_ms": 298275,
      "text": "在任何场合都能够轻松拿捏，",
      "token_start": 1230,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 298580,
      "end_ms": 299575,
      "text": "所以强烈推荐。",
      "token_start": 1242,
      "token_end_exclusive": 1248
    }
