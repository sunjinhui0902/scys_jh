  "segments": [
    {
      "start_ms": 170,
      "end_ms": 1470,
      "text": "你酒量挺好的呀，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1650,
      "end_ms": 3130,
      "text": "领导您可抬举我了，",
      "token_start": 7,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3210,
      "end_ms": 4450,
      "text": "我平时真不太能喝，",
      "token_start": 15,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 4770,
      "end_ms": 6290,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 23,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 6310,
      "end_ms": 6870,
      "text": "高兴啊，",
      "token_start": 34,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 7010,
      "end_ms": 8875,
      "text": "这一高兴就多贪了几杯，",
      "token_start": 37,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 11180,
      "end_ms": 12060,
      "text": "鱼是好鱼，",
      "token_start": 47,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 12300,
      "end_ms": 13420,
      "text": "可惜就是刺多。",
      "token_start": 51,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 13660,
      "end_ms": 13960,
      "text": "领导，",
      "token_start": 57,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 13960,
      "end_ms": 15760,
      "text": "您看鱼虽然刺多，",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 16000,
      "end_ms": 17980,
      "text": "但主心骨只有一根心腹，",
      "token_start": 66,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 17980,
      "end_ms": 21560,
      "text": "是没有刺的这藕是好藕啊，",
      "token_start": 76,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 21760,
      "end_ms": 23240,
      "text": "就是心眼太多了。",
      "token_start": 87,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 23440,
      "end_ms": 25100,
      "text": "领导藕虽然心眼多，",
      "token_start": 94,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 25180,
      "end_ms": 26520,
      "text": "但也是您的下酒菜啊。",
      "token_start": 102,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 28140,
      "end_ms": 29580,
      "text": "这鸭子是好鸭子，",
      "token_start": 111,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 29740,
      "end_ms": 30540,
      "text": "就是嘴硬，",
      "token_start": 118,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 30920,
      "end_ms": 31320,
      "text": "嘴硬，",
      "token_start": 122,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 31320,
      "end_ms": 32280,
      "text": "才守得住秘密，",
      "token_start": 124,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 34260,
      "end_ms": 34740,
      "text": "小李，",
      "token_start": 130,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 35180,
      "end_ms": 36460,
      "text": "今天让你破费了。",
      "token_start": 132,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 36680,
      "end_ms": 37040,
      "text": "领导，",
      "token_start": 139,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 37040,
      "end_ms": 38520,
      "text": "您说这些您能来，",
      "token_start": 141,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 38520,
      "end_ms": 39280,
      "text": "就是我的荣幸，",
      "token_start": 148,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 39500,
      "end_ms": 41410,
      "text": "以后还有很多地方要向您请教。",
      "token_start": 154,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 44230,
      "end_ms": 44690,
      "text": "小李，",
      "token_start": 167,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 44710,
      "end_ms": 45950,
      "text": "最近表现不错啊，",
      "token_start": 169,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 46190,
      "end_ms": 48330,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 176,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 48450,
      "end_ms": 49730,
      "text": "我得提前敬你一杯。",
      "token_start": 189,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 50150,
      "end_ms": 50850,
      "text": "听这意思，",
      "token_start": 197,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 50930,
      "end_ms": 52030,
      "text": "领导是要高升了呀，",
      "token_start": 201,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 52070,
      "end_ms": 53050,
      "text": "我得提前敬领导，",
      "token_start": 209,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 53050,
      "end_ms": 55870,
      "text": "一杯小李呀。",
      "token_start": 216,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 56250,
      "end_ms": 58370,
      "text": "我看你最近是越来越精神了啊，",
      "token_start": 221,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 58730,
      "end_ms": 60010,
      "text": "那是因为沾了领导，",
      "token_start": 234,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 60010,
      "end_ms": 60615,
      "text": "您的光，",
      "token_start": 242,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 60930,
      "end_ms": 61850,
      "text": "跟着您干事儿，",
      "token_start": 245,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 61870,
      "end_ms": 62885,
      "text": "气色都不敢差。",
      "token_start": 251,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 63280,
      "end_ms": 64975,
      "text": "哈哈哈小李，",
      "token_start": 257,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 65410,
      "end_ms": 67105,
      "text": "你这菜点的也太多了，",
      "token_start": 262,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 67360,
      "end_ms": 68990,
      "text": "领导菜点的再多，",
      "token_start": 271,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 69170,
      "end_ms": 70690,
      "text": "也比不上平时您对我的照顾。",
      "token_start": 278,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 70690,
      "end_ms": 71690,
      "text": "多这杯酒，",
      "token_start": 290,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 71730,
      "end_ms": 72555,
      "text": "我先敬您。",
      "token_start": 294,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 73000,
      "end_ms": 73555,
      "text": "哈哈哈，",
      "token_start": 298,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 74300,
      "end_ms": 74905,
      "text": "关注我，",
      "token_start": 301,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 75210,
      "end_ms": 76490,
      "text": "每天学点高情商，",
      "token_start": 304,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 76490,
      "end_ms": 77325,
      "text": "说话技巧，",
      "token_start": 311,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 77580,
      "end_ms": 79105,
      "text": "让你的路越走越宽。",
      "token_start": 315,
      "token_end_exclusive": 323
    }
