{
  "video_id": "v_ae8e034d880048bf",
  "duration_s": 812.007139,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_ae8e034d880048bf.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_ae8e034d880048bf.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 2850,
      "text": "二十四岁被日军压赴刑场，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3510,
      "end_ms": 7230,
      "text": "他的一抹微笑震撼中国八十年，",
      "token_start": 11,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 8029,
      "end_ms": 9910,
      "text": "每一位中国人来到这里，",
      "token_start": 24,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 10350,
      "end_ms": 13390,
      "text": "都应该给他表达最崇高的敬意。",
      "token_start": 34,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 14310,
      "end_ms": 18530,
      "text": "然位就是曾经被日寇进行了残酷的审讯，",
      "token_start": 47,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 19150,
      "end_ms": 20150,
      "text": "轮流的殿污，",
      "token_start": 64,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 20470,
      "end_ms": 22910,
      "text": "整整被折磨了六天六夜，",
      "token_start": 69,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 23510,
      "end_ms": 26310,
      "text": "然而他却只字未提我党的秘密，",
      "token_start": 79,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 26790,
      "end_ms": 30000,
      "text": "在日寇面前毫不畏惧的露出气脸，",
      "token_start": 92,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 30080,
      "end_ms": 31060,
      "text": "歼灭笑容。",
      "token_start": 106,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 31620,
      "end_ms": 34800,
      "text": "她就是我们最美的抗日女战士，",
      "token_start": 110,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 35460,
      "end_ms": 38045,
      "text": "铁骨铮铮的巾帼女英雄。",
      "token_start": 123,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 40270,
      "end_ms": 42910,
      "text": "程本华到底是什么样的底气？",
      "token_start": 133,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 43190,
      "end_ms": 49770,
      "text": "能让一个二十四岁的女孩在生死关头灭世屠刀笑对死亡？",
      "token_start": 145,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 51050,
      "end_ms": 51510,
      "text": "今天，",
      "token_start": 169,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 51810,
      "end_ms": 54210,
      "text": "我们就抛开教科书的简短介绍，",
      "token_start": 171,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 54610,
      "end_ms": 58870,
      "text": "完整读懂这位被低估的巾国英雄程。",
      "token_start": 184,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 58870,
      "end_ms": 59555,
      "text": "本华。",
      "token_start": 199,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 60080,
      "end_ms": 60480,
      "text": "如今，",
      "token_start": 201,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 60600,
      "end_ms": 62695,
      "text": "安徽和县的城市广场上，",
      "token_start": 203,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 63130,
      "end_ms": 65265,
      "text": "他的雕像静静处理，",
      "token_start": 213,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 65750,
      "end_ms": 67175,
      "text": "历经八十多年，",
      "token_start": 221,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 67460,
      "end_ms": 68405,
      "text": "风雨初刷，",
      "token_start": 227,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 69060,
      "end_ms": 70715,
      "text": "依旧身姿挺拔，",
      "token_start": 231,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 71240,
      "end_ms": 72285,
      "text": "孝意如初。",
      "token_start": 237,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 73040,
      "end_ms": 76385,
      "text": "他守着这座自己用生命守护的小城，",
      "token_start": 241,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 76810,
      "end_ms": 81005,
      "text": "看着如今车水马龙、烟火升腾的盛世人间，",
      "token_start": 256,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 81630,
      "end_ms": 83695,
      "text": "默默见证着山河无恙，",
      "token_start": 273,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 84040,
      "end_ms": 84795,
      "text": "国泰民安。",
      "token_start": 282,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 85550,
      "end_ms": 86630,
      "text": "很多人不知道，",
      "token_start": 286,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 86870,
      "end_ms": 89855,
      "text": "程本华从来不是天生的英雄，",
      "token_start": 292,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 90410,
      "end_ms": 93975,
      "text": "她只是乱世里挺身而出的普通姑娘。",
      "token_start": 304,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 94770,
      "end_ms": 95705,
      "text": "一九一四年，",
      "token_start": 319,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 96130,
      "end_ms": 101245,
      "text": "他出生在安徽和县一个再平凡不过的百姓家庭，",
      "token_start": 324,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 102020,
      "end_ms": 103375,
      "text": "没有显赫家室，",
      "token_start": 344,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 103730,
      "end_ms": 105045,
      "text": "没有过人天赋，",
      "token_start": 350,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 105500,
      "end_ms": 111710,
      "text": "从小就是一个善良、正直、有主见的女孩。",
      "token_start": 356,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 112680,
      "end_ms": 115705,
      "text": "在那个封建思想根深蒂固的年代，",
      "token_start": 372,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 116470,
      "end_ms": 121120,
      "text": "大部分女孩子都被禁锢在深宅小院，",
      "token_start": 386,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 121200,
      "end_ms": 124985,
      "text": "医生围着针线、灶台、家庭打转，",
      "token_start": 401,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 125380,
      "end_ms": 127135,
      "text": "没人关心家国大事，",
      "token_start": 413,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 128020,
      "end_ms": 129565,
      "text": "但成本化不一样。",
      "token_start": 421,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 129900,
      "end_ms": 133655,
      "text": "他从小就不愿被世俗规矩束缚，",
      "token_start": 428,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 134050,
      "end_ms": 136285,
      "text": "读书、识字、关注时局，",
      "token_start": 441,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 136850,
      "end_ms": 139675,
      "text": "心里始终装着家国天下。",
      "token_start": 449,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 140330,
      "end_ms": 141655,
      "text": "彼时的旧中国，",
      "token_start": 459,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 142000,
      "end_ms": 142995,
      "text": "积贫积弱，",
      "token_start": 465,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 143350,
      "end_ms": 144265,
      "text": "任人欺凌，",
      "token_start": 469,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 144920,
      "end_ms": 146475,
      "text": "列强轮番入侵，",
      "token_start": 473,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 146880,
      "end_ms": 148305,
      "text": "战火常年不休，",
      "token_start": 479,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 148920,
      "end_ms": 151480,
      "text": "底层老百姓挣扎在温饱，",
      "token_start": 485,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 151540,
      "end_ms": 152625,
      "text": "与生死之间，",
      "token_start": 495,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 153170,
      "end_ms": 154835,
      "text": "日子过得苦不堪言。",
      "token_start": 500,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 155350,
      "end_ms": 159705,
      "text": "看着满目疮痍的山河、流离失所的乡亲，",
      "token_start": 508,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 160310,
      "end_ms": 164270,
      "text": "年少的程本华心里悄悄埋下了一颗种子。",
      "token_start": 524,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 164430,
      "end_ms": 165535,
      "text": "如果国家需要，",
      "token_start": 541,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 165840,
      "end_ms": 167460,
      "text": "我一定挺身而出，",
      "token_start": 547,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 167580,
      "end_ms": 169505,
      "text": "守护家乡、守护同胞。",
      "token_start": 554,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 170020,
      "end_ms": 171325,
      "text": "借着求学的机会，",
      "token_start": 562,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 171630,
      "end_ms": 175335,
      "text": "程本华主动加入了当地的童子军队伍。",
      "token_start": 569,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 175740,
      "end_ms": 177675,
      "text": "不同于当下的素质教育，",
      "token_start": 585,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 178180,
      "end_ms": 183965,
      "text": "民国时期的童子军核心就是魔力意志、储备国防力量。",
      "token_start": 595,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 184550,
      "end_ms": 185945,
      "text": "别人怕苦怕累，",
      "token_start": 617,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 186260,
      "end_ms": 187115,
      "text": "逃避训练，",
      "token_start": 623,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 187480,
      "end_ms": 189385,
      "text": "他却次次全员参与，",
      "token_start": 627,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 189780,
      "end_ms": 195920,
      "text": "认真练习队列格斗、基础防卫技能，",
      "token_start": 635,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 196180,
      "end_ms": 199325,
      "text": "日复一日打磨自己的体魄和心性。",
      "token_start": 649,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 200420,
      "end_ms": 201380,
      "text": "几年下来，",
      "token_start": 663,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 201540,
      "end_ms": 206375,
      "text": "原本柔弱的小姑娘练就了一身坚韧不拔的性子，",
      "token_start": 667,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 206910,
      "end_ms": 208005,
      "text": "遇事果敢，",
      "token_start": 687,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 208350,
      "end_ms": 209235,
      "text": "临危不乱，",
      "token_start": 691,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 210010,
      "end_ms": 213575,
      "text": "骨子里藏着不输男儿的血性与担当。",
      "token_start": 695,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 214430,
      "end_ms": 216595,
      "text": "他常常奔走在街头巷尾，",
      "token_start": 710,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 217130,
      "end_ms": 220525,
      "text": "向身边的街坊邻里宣讲爱国道德，",
      "token_start": 720,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 221160,
      "end_ms": 223815,
      "text": "呼吁年轻人自立自强，",
      "token_start": 734,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 224310,
      "end_ms": 227805,
      "text": "守护家国用自己的微薄之力，",
      "token_start": 743,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 228420,
      "end_ms": 231015,
      "text": "点亮乱世里的点点星火。",
      "token_start": 755,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 233240,
      "end_ms": 234295,
      "text": "一九三七年，",
      "token_start": 765,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 234900,
      "end_ms": 236585,
      "text": "卢沟桥事变爆发，",
      "token_start": 770,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 236910,
      "end_ms": 241810,
      "text": "全面抗战的烈火席卷整个华夏大地平静的生活，",
      "token_start": 777,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 242150,
      "end_ms": 243090,
      "text": "彻底被打破。",
      "token_start": 797,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 243310,
      "end_ms": 245075,
      "text": "日军铁蹄一路南下，",
      "token_start": 802,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 245460,
      "end_ms": 246445,
      "text": "烧杀抢掠，",
      "token_start": 810,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 246740,
      "end_ms": 247585,
      "text": "无恶不作，",
      "token_start": 814,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 248070,
      "end_ms": 248910,
      "text": "所到之处，",
      "token_start": 818,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 249090,
      "end_ms": 250030,
      "text": "寸草不生，",
      "token_start": 822,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 250170,
      "end_ms": 251055,
      "text": "民不聊生。",
      "token_start": 826,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 251690,
      "end_ms": 254665,
      "text": "长江沿岸的河线地理位置特殊，",
      "token_start": 830,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 255040,
      "end_ms": 256995,
      "text": "很快就沦为抗战前线，",
      "token_start": 843,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 257650,
      "end_ms": 259745,
      "text": "战火直接烧到了家门口。",
      "token_start": 852,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 260630,
      "end_ms": 262550,
      "text": "昔日热闹安稳的小城，",
      "token_start": 862,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 262930,
      "end_ms": 265015,
      "text": "瞬间被硝烟笼罩，",
      "token_start": 871,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 265840,
      "end_ms": 267505,
      "text": "枪炮声日夜不绝，",
      "token_start": 878,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 268100,
      "end_ms": 269715,
      "text": "百姓人心惶惶，",
      "token_start": 885,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 270030,
      "end_ms": 270915,
      "text": "四处逃难。",
      "token_start": 891,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 272440,
      "end_ms": 273395,
      "text": "危难时刻，",
      "token_start": 895,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 273810,
      "end_ms": 278575,
      "text": "和县当地政府迅速组建抗日人民自卫军，",
      "token_start": 899,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 279230,
      "end_ms": 283715,
      "text": "号召全城有志之士站出来保卫家乡，",
      "token_start": 916,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 284040,
      "end_ms": 284855,
      "text": "抵御外敌。",
      "token_start": 931,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 285060,
      "end_ms": 286225,
      "text": "彼时的成本滑，",
      "token_start": 935,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 286660,
      "end_ms": 289285,
      "text": "刚刚和爱人刘志仪成婚不久，",
      "token_start": 941,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 289770,
      "end_ms": 291355,
      "text": "正是新婚燕尔，",
      "token_start": 953,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 291790,
      "end_ms": 294005,
      "text": "甜蜜安稳的幸福时刻。",
      "token_start": 959,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 294660,
      "end_ms": 296060,
      "text": "按照普通人的想法，",
      "token_start": 968,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 296360,
      "end_ms": 297475,
      "text": "乱世求存，",
      "token_start": 976,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 297890,
      "end_ms": 298845,
      "text": "安稳度日，",
      "token_start": 980,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 299150,
      "end_ms": 300385,
      "text": "就是最大的失望。",
      "token_start": 984,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 301060,
      "end_ms": 304545,
      "text": "可面对破碎的山河受难的乡亲，",
      "token_start": 991,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 304850,
      "end_ms": 306805,
      "text": "程本华没有丝毫犹豫。",
      "token_start": 1004,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 307690,
      "end_ms": 310390,
      "text": "果断放弃了安稳的小家生活，",
      "token_start": 1013,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 310630,
      "end_ms": 312550,
      "text": "和丈夫一起报名参军，",
      "token_start": 1025,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 313010,
      "end_ms": 315010,
      "text": "毅然投身抗日战场。",
      "token_start": 1034,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 315590,
      "end_ms": 316070,
      "text": "从此，",
      "token_start": 1042,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 316290,
      "end_ms": 318050,
      "text": "她脱下家常布衣，",
      "token_start": 1044,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 318430,
      "end_ms": 320030,
      "text": "换上朴素军装，",
      "token_start": 1051,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 320170,
      "end_ms": 321710,
      "text": "告别儿女情长，",
      "token_start": 1057,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 322190,
      "end_ms": 324450,
      "text": "扛起保家卫国的责任。",
      "token_start": 1063,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 324930,
      "end_ms": 328170,
      "text": "在那个人人自危、争相逃命的年代，",
      "token_start": 1072,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 328870,
      "end_ms": 334030,
      "text": "一个二十出头的小姑娘主动奔赴枪林弹雨的战场，",
      "token_start": 1086,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 334570,
      "end_ms": 338480,
      "text": "这份勇气和格局远超无数成年人。",
      "token_start": 1107,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 339080,
      "end_ms": 340280,
      "text": "进入自卫军后，",
      "token_start": 1121,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 340480,
      "end_ms": 343460,
      "text": "程本华从来没有因为自己是女性，",
      "token_start": 1127,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 343480,
      "end_ms": 345360,
      "text": "就搞特殊享优待。",
      "token_start": 1141,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 345980,
      "end_ms": 346800,
      "text": "战场上，",
      "token_start": 1148,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 347160,
      "end_ms": 349980,
      "text": "他和男战士一样冲锋在前，",
      "token_start": 1151,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 350580,
      "end_ms": 351720,
      "text": "坚守阵地。",
      "token_start": 1162,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 352260,
      "end_ms": 356200,
      "text": "面对装备精良、凶悍残暴的日军，",
      "token_start": 1166,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 356560,
      "end_ms": 357460,
      "text": "从不退缩，",
      "token_start": 1179,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 357640,
      "end_ms": 360400,
      "text": "绝不畏惧每一次敌军进攻，",
      "token_start": 1183,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 360480,
      "end_ms": 362960,
      "text": "他都手持武器坚守阵线。",
      "token_start": 1194,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 363560,
      "end_ms": 367365,
      "text": "凭借过硬的训练功底和顽强的意志，",
      "token_start": 1204,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 367910,
      "end_ms": 371895,
      "text": "一次次打退敌人的冲锋战场之外，",
      "token_start": 1219,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 372370,
      "end_ms": 375150,
      "text": "他更是队伍里的暖心之助。",
      "token_start": 1233,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 375450,
      "end_ms": 376265,
      "text": "他深知，",
      "token_start": 1244,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 376740,
      "end_ms": 379255,
      "text": "抗战不是靠少数人的热血，",
      "token_start": 1247,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 379660,
      "end_ms": 382345,
      "text": "而是靠所有人的同心协力。",
      "token_start": 1258,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 382740,
      "end_ms": 383200,
      "text": "于是，",
      "token_start": 1269,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 383320,
      "end_ms": 385385,
      "text": "他走遍县城各个村落，",
      "token_start": 1271,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 385830,
      "end_ms": 387965,
      "text": "挨家挨户动员百姓，",
      "token_start": 1280,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 388450,
      "end_ms": 390435,
      "text": "讲述日军的残暴行径，",
      "token_start": 1288,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 390860,
      "end_ms": 393075,
      "text": "普及抗日救国的意义，",
      "token_start": 1297,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 393500,
      "end_ms": 395995,
      "text": "号召大家有钱出钱，",
      "token_start": 1306,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 396390,
      "end_ms": 397550,
      "text": "有力出力。",
      "token_start": 1314,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 397670,
      "end_ms": 399455,
      "text": "在他的真诚感召下，",
      "token_start": 1318,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 399850,
      "end_ms": 402555,
      "text": "越来越多的普通百姓放下锄头，",
      "token_start": 1326,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 402910,
      "end_ms": 405625,
      "text": "拿起器械加入抗日队伍，",
      "token_start": 1339,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 406070,
      "end_ms": 408755,
      "text": "让和县的抗日力量愈发壮大。",
      "token_start": 1349,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 409510,
      "end_ms": 409990,
      "text": "同时，",
      "token_start": 1361,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 410320,
      "end_ms": 415875,
      "text": "他还主动承担后勤保障伤员、慰问物资整理的工作，",
      "token_start": 1363,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 416170,
      "end_ms": 419135,
      "text": "把队伍的后方打理的井井有条，",
      "token_start": 1384,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 419750,
      "end_ms": 422345,
      "text": "让前线战士没有后顾之忧。",
      "token_start": 1397,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 422980,
      "end_ms": 426535,
      "text": "命运从来不会因为勇敢就格外温柔。",
      "token_start": 1408,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 427090,
      "end_ms": 428310,
      "text": "战争的残酷，",
      "token_start": 1423,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 428930,
      "end_ms": 432330,
      "text": "终究还是降临在了这个年轻姑娘身上。",
      "token_start": 1428,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 433270,
      "end_ms": 436810,
      "text": "在和县多次惨烈的守城战役中，",
      "token_start": 1444,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 436910,
      "end_ms": 440230,
      "text": "无数战友接连牺牲血染疆土。",
      "token_start": 1457,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 440490,
      "end_ms": 446690,
      "text": "程本华最爱的丈夫刘志怡也不幸倒在了守护家乡的战场上。",
      "token_start": 1469,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 447370,
      "end_ms": 449430,
      "text": "新婚不久天人永隔。",
      "token_start": 1494,
      "token_end_exclusive": 1502
    },
    {
      "start_ms": 449830,
      "end_ms": 450810,
      "text": "这样的打击，",
      "token_start": 1502,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 451130,
      "end_ms": 453870,
      "text": "足以摧毁一个普通人的意志。",
      "token_start": 1507,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 454410,
      "end_ms": 455610,
      "text": "无数个深夜，",
      "token_start": 1519,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 455910,
      "end_ms": 458980,
      "text": "她强忍泪水默默悲痛，",
      "token_start": 1524,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 459480,
      "end_ms": 460540,
      "text": "可天亮之后，",
      "token_start": 1533,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 460860,
      "end_ms": 463900,
      "text": "她依旧挺直腰板站上战场。",
      "token_start": 1538,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 464740,
      "end_ms": 465820,
      "text": "她心里清楚，",
      "token_start": 1549,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 466180,
      "end_ms": 467140,
      "text": "个人的悲痛，",
      "token_start": 1554,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 467140,
      "end_ms": 469580,
      "text": "在民族危亡面前不值一提。",
      "token_start": 1559,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 470140,
      "end_ms": 472340,
      "text": "丈夫用生命守护的家国，",
      "token_start": 1570,
      "token_end_exclusive": 1580
    },
    {
      "start_ms": 472680,
      "end_ms": 474900,
      "text": "必须由自己继续坚守，",
      "token_start": 1580,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 475060,
      "end_ms": 477120,
      "text": "化悲痛为力量的成本华，",
      "token_start": 1589,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 477480,
      "end_ms": 480160,
      "text": "变得更加坚毅、更加果敢，",
      "token_start": 1599,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 480640,
      "end_ms": 483460,
      "text": "独自扛起了守城抗敌的重任，",
      "token_start": 1609,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 484080,
      "end_ms": 486635,
      "text": "带领剩余战士坚守防线，",
      "token_start": 1621,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 487010,
      "end_ms": 491390,
      "text": "成为和县抗日队伍中最亮眼的巾帼力量。",
      "token_start": 1631,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 491910,
      "end_ms": 493490,
      "text": "一九三八年五月，",
      "token_start": 1648,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 493810,
      "end_ms": 496050,
      "text": "日军集结大批量兵力，",
      "token_start": 1655,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 496390,
      "end_ms": 498030,
      "text": "配备重型武器，",
      "token_start": 1664,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 498810,
      "end_ms": 501690,
      "text": "对和县发起了毁灭性的猛攻。",
      "token_start": 1670,
      "token_end_exclusive": 1682
    },
    {
      "start_ms": 502510,
      "end_ms": 506050,
      "text": "当时守城的自卫军大多是普通百姓，",
      "token_start": 1682,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 506090,
      "end_ms": 508150,
      "text": "组建装备简陋，",
      "token_start": 1697,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 508450,
      "end_ms": 510530,
      "text": "缺乏专业作战经验，",
      "token_start": 1703,
      "token_end_exclusive": 1711
    },
    {
      "start_ms": 510830,
      "end_ms": 512630,
      "text": "加上没有外援支持，",
      "token_start": 1711,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 512730,
      "end_ms": 514910,
      "text": "敌我实力差距悬殊，",
      "token_start": 1719,
      "token_end_exclusive": 1727
    },
    {
      "start_ms": 515510,
      "end_ms": 517760,
      "text": "全体战士浴血奋战，",
      "token_start": 1727,
      "token_end_exclusive": 1735
    },
    {
      "start_ms": 518100,
      "end_ms": 519180,
      "text": "拼死抵抗，",
      "token_start": 1735,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 519820,
      "end_ms": 521160,
      "text": "坚守数日之后，",
      "token_start": 1739,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 521560,
      "end_ms": 523020,
      "text": "终究寡不敌众，",
      "token_start": 1745,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 523300,
      "end_ms": 525580,
      "text": "和县城门不幸被攻破。",
      "token_start": 1751,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 526460,
      "end_ms": 527740,
      "text": "城池沦陷后，",
      "token_start": 1760,
      "token_end_exclusive": 1765
    },
    {
      "start_ms": 528060,
      "end_ms": 530500,
      "text": "大部队紧急组织突围撤离。",
      "token_start": 1765,
      "token_end_exclusive": 1776
    },
    {
      "start_ms": 531060,
      "end_ms": 534680,
      "text": "为了掩护战友和无辜百姓安全转移，",
      "token_start": 1776,
      "token_end_exclusive": 1791
    },
    {
      "start_ms": 535100,
      "end_ms": 538040,
      "text": "程本华主动申请留守断后，",
      "token_start": 1791,
      "token_end_exclusive": 1802
    },
    {
      "start_ms": 538820,
      "end_ms": 541620,
      "text": "他带着为数不多的剩余战士，",
      "token_start": 1802,
      "token_end_exclusive": 1814
    },
    {
      "start_ms": 542060,
      "end_ms": 546595,
      "text": "在结巷之间和日军展开激烈巷战，",
      "token_start": 1814,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 547050,
      "end_ms": 551050,
      "text": "拼死阻击敌军激战数日，",
      "token_start": 1828,
      "token_end_exclusive": 1838
    },
    {
      "start_ms": 551530,
      "end_ms": 552610,
      "text": "弹尽粮绝，",
      "token_start": 1838,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 552970,
      "end_ms": 553870,
      "text": "体力透支。",
      "token_start": 1842,
      "token_end_exclusive": 1846
    },
    {
      "start_ms": 553950,
      "end_ms": 555950,
      "text": "在四面合围的绝境中，",
      "token_start": 1846,
      "token_end_exclusive": 1855
    },
    {
      "start_ms": 556370,
      "end_ms": 561770,
      "text": "这位坚守家乡的女战士不幸落入日军魔爪。",
      "token_start": 1855,
      "token_end_exclusive": 1873
    },
    {
      "start_ms": 562690,
      "end_ms": 563570,
      "text": "被俘之后，",
      "token_start": 1873,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 563930,
      "end_ms": 565710,
      "text": "日军摸清了程本华，",
      "token_start": 1877,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 566130,
      "end_ms": 568590,
      "text": "是和县抗日核心骨干，",
      "token_start": 1885,
      "token_end_exclusive": 1894
    },
    {
      "start_ms": 569110,
      "end_ms": 572890,
      "text": "妄图从她口中撬出自卫军的隐藏据点，",
      "token_start": 1894,
      "token_end_exclusive": 1910
    },
    {
      "start_ms": 573370,
      "end_ms": 575230,
      "text": "剩余兵力和作战计划，",
      "token_start": 1910,
      "token_end_exclusive": 1919
    },
    {
      "start_ms": 575650,
      "end_ms": 578380,
      "text": "彻底肃清当地抗日力量。",
      "token_start": 1919,
      "token_end_exclusive": 1929
    },
    {
      "start_ms": 578740,
      "end_ms": 580000,
      "text": "为了逼他投降，",
      "token_start": 1929,
      "token_end_exclusive": 1935
    },
    {
      "start_ms": 580500,
      "end_ms": 583240,
      "text": "日军开启了轮番的威逼利诱。",
      "token_start": 1935,
      "token_end_exclusive": 1947
    },
    {
      "start_ms": 583760,
      "end_ms": 585980,
      "text": "先是许诺高官厚禄，",
      "token_start": 1947,
      "token_end_exclusive": 1955
    },
    {
      "start_ms": 586300,
      "end_ms": 587300,
      "text": "荣华富贵，",
      "token_start": 1955,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 587840,
      "end_ms": 588440,
      "text": "告诉他，",
      "token_start": 1959,
      "token_end_exclusive": 1962
    },
    {
      "start_ms": 588800,
      "end_ms": 590300,
      "text": "只要归顺日军，",
      "token_start": 1962,
      "token_end_exclusive": 1968
    },
    {
      "start_ms": 590460,
      "end_ms": 591980,
      "text": "就能摆脱苦难，",
      "token_start": 1968,
      "token_end_exclusive": 1974
    },
    {
      "start_ms": 592320,
      "end_ms": 593420,
      "text": "安稳度日，",
      "token_start": 1974,
      "token_end_exclusive": 1978
    },
    {
      "start_ms": 593740,
      "end_ms": 597315,
      "text": "被城本华丽声痛斥断然拒绝。",
      "token_start": 1978,
      "token_end_exclusive": 1990
    },
    {
      "start_ms": 597910,
      "end_ms": 598710,
      "text": "软的不行。",
      "token_start": 1990,
      "token_end_exclusive": 1994
    },
    {
      "start_ms": 599050,
      "end_ms": 601170,
      "text": "日军立刻露出残暴本性，",
      "token_start": 1994,
      "token_end_exclusive": 2004
    },
    {
      "start_ms": 601670,
      "end_ms": 603510,
      "text": "对他施以连日酷刑，",
      "token_start": 2004,
      "token_end_exclusive": 2012
    },
    {
      "start_ms": 603930,
      "end_ms": 605610,
      "text": "鞭吃折磨，",
      "token_start": 2012,
      "token_end_exclusive": 2016
    },
    {
      "start_ms": 606030,
      "end_ms": 608890,
      "text": "囚禁身心双重摧残。",
      "token_start": 2016,
      "token_end_exclusive": 2024
    },
    {
      "start_ms": 608950,
      "end_ms": 610390,
      "text": "让他遍体鳞伤，",
      "token_start": 2024,
      "token_end_exclusive": 2030
    },
    {
      "start_ms": 610790,
      "end_ms": 611830,
      "text": "虚弱不堪，",
      "token_start": 2030,
      "token_end_exclusive": 2034
    },
    {
      "start_ms": 612370,
      "end_ms": 614270,
      "text": "可整整数日的折磨，",
      "token_start": 2034,
      "token_end_exclusive": 2042
    },
    {
      "start_ms": 614610,
      "end_ms": 617210,
      "text": "没有让他吐露半个字的情报。",
      "token_start": 2042,
      "token_end_exclusive": 2054
    },
    {
      "start_ms": 617670,
      "end_ms": 620190,
      "text": "没有让他有一丝一毫的妥协，",
      "token_start": 2054,
      "token_end_exclusive": 2066
    },
    {
      "start_ms": 620870,
      "end_ms": 622410,
      "text": "哪怕身陷绝境，",
      "token_start": 2066,
      "token_end_exclusive": 2072
    },
    {
      "start_ms": 622810,
      "end_ms": 623910,
      "text": "受尽苦难，",
      "token_start": 2072,
      "token_end_exclusive": 2076
    },
    {
      "start_ms": 624370,
      "end_ms": 626190,
      "text": "他始终坚守底线，",
      "token_start": 2076,
      "token_end_exclusive": 2083
    },
    {
      "start_ms": 626550,
      "end_ms": 629420,
      "text": "心怀家国用血肉之躯，",
      "token_start": 2083,
      "token_end_exclusive": 2092
    },
    {
      "start_ms": 629760,
      "end_ms": 633020,
      "text": "守住了抗日战士的尊严与气节。",
      "token_start": 2092,
      "token_end_exclusive": 2105
    },
    {
      "start_ms": 633220,
      "end_ms": 634760,
      "text": "无计可施的日军，",
      "token_start": 2105,
      "token_end_exclusive": 2112
    },
    {
      "start_ms": 635120,
      "end_ms": 639060,
      "text": "彻底被这个年轻姑娘的不屈意志震撼，",
      "token_start": 2112,
      "token_end_exclusive": 2128
    },
    {
      "start_ms": 639480,
      "end_ms": 641340,
      "text": "也彻底失去了耐心。",
      "token_start": 2128,
      "token_end_exclusive": 2136
    },
    {
      "start_ms": 642040,
      "end_ms": 644980,
      "text": "想终决定公开处决程本华。",
      "token_start": 2136,
      "token_end_exclusive": 2147
    },
    {
      "start_ms": 645560,
      "end_ms": 648700,
      "text": "想用他的死亡威慑全城百姓，",
      "token_start": 2147,
      "token_end_exclusive": 2159
    },
    {
      "start_ms": 649320,
      "end_ms": 651440,
      "text": "磨灭所有人的抗日斗志。",
      "token_start": 2159,
      "token_end_exclusive": 2169
    },
    {
      "start_ms": 652440,
      "end_ms": 653360,
      "text": "行刑当天，",
      "token_start": 2169,
      "token_end_exclusive": 2173
    },
    {
      "start_ms": 653780,
      "end_ms": 656900,
      "text": "日军强行驱赶大量百姓到场，",
      "token_start": 2173,
      "token_end_exclusive": 2185
    },
    {
      "start_ms": 656940,
      "end_ms": 660385,
      "text": "为官安排战地记者全程拍摄，",
      "token_start": 2185,
      "token_end_exclusive": 2197
    },
    {
      "start_ms": 660840,
      "end_ms": 664155,
      "text": "妄图记录下中国人的恐惧与卑微。",
      "token_start": 2197,
      "token_end_exclusive": 2211
    },
    {
      "start_ms": 664900,
      "end_ms": 667055,
      "text": "可让敌军万万没想到的是，",
      "token_start": 2211,
      "token_end_exclusive": 2222
    },
    {
      "start_ms": 667520,
      "end_ms": 670940,
      "text": "面对冰冷的屠刀和必死的结局。",
      "token_start": 2222,
      "token_end_exclusive": 2235
    },
    {
      "start_ms": 671020,
      "end_ms": 674435,
      "text": "二十四岁的程本华没有丝毫恐惧，",
      "token_start": 2235,
      "token_end_exclusive": 2249
    },
    {
      "start_ms": 675120,
      "end_ms": 677155,
      "text": "他缓缓站直身体，",
      "token_start": 2249,
      "token_end_exclusive": 2256
    },
    {
      "start_ms": 677620,
      "end_ms": 679525,
      "text": "整理好破旧的衣衫，",
      "token_start": 2256,
      "token_end_exclusive": 2264
    },
    {
      "start_ms": 680030,
      "end_ms": 681145,
      "text": "双手抱胸，",
      "token_start": 2264,
      "token_end_exclusive": 2268
    },
    {
      "start_ms": 681550,
      "end_ms": 682575,
      "text": "昂首挺臂，",
      "token_start": 2268,
      "token_end_exclusive": 2272
    },
    {
      "start_ms": 683210,
      "end_ms": 685395,
      "text": "迎着寒光闪闪的军刀，",
      "token_start": 2272,
      "token_end_exclusive": 2281
    },
    {
      "start_ms": 685800,
      "end_ms": 689325,
      "text": "露出了一抹淡然有坚定的微笑。",
      "token_start": 2281,
      "token_end_exclusive": 2294
    },
    {
      "start_ms": 689940,
      "end_ms": 696195,
      "text": "这一笑是对侵略者残暴行径的极致灭视，",
      "token_start": 2294,
      "token_end_exclusive": 2311
    },
    {
      "start_ms": 697030,
      "end_ms": 699345,
      "text": "是对死亡的坦然无惧，",
      "token_start": 2311,
      "token_end_exclusive": 2320
    },
    {
      "start_ms": 700190,
      "end_ms": 705215,
      "text": "更是坚信华夏必胜光明中来的绝对信仰。",
      "token_start": 2320,
      "token_end_exclusive": 2337
    },
    {
      "start_ms": 706000,
      "end_ms": 708440,
      "text": "随着刀锋落下一代，",
      "token_start": 2337,
      "token_end_exclusive": 2345
    },
    {
      "start_ms": 708480,
      "end_ms": 712240,
      "text": "巾帼英雄永远定格在了二十四岁的青春年华。",
      "token_start": 2345,
      "token_end_exclusive": 2364
    },
    {
      "start_ms": 712420,
      "end_ms": 714045,
      "text": "八十多年岁月流转，",
      "token_start": 2364,
      "token_end_exclusive": 2372
    },
    {
      "start_ms": 714360,
      "end_ms": 715355,
      "text": "硝烟散尽，",
      "token_start": 2372,
      "token_end_exclusive": 2376
    },
    {
      "start_ms": 715770,
      "end_ms": 717155,
      "text": "山河换新颜，",
      "token_start": 2376,
      "token_end_exclusive": 2381
    },
    {
      "start_ms": 718010,
      "end_ms": 720790,
      "text": "曾经满目疮痍的和县，",
      "token_start": 2381,
      "token_end_exclusive": 2390
    },
    {
      "start_ms": 721150,
      "end_ms": 724090,
      "text": "如今繁华安宁、烟火不息，",
      "token_start": 2390,
      "token_end_exclusive": 2400
    },
    {
      "start_ms": 724890,
      "end_ms": 727010,
      "text": "曾经饱受欺凌的中国，",
      "token_start": 2400,
      "token_end_exclusive": 2409
    },
    {
      "start_ms": 727330,
      "end_ms": 728690,
      "text": "如今国富民强，",
      "token_start": 2409,
      "token_end_exclusive": 2415
    },
    {
      "start_ms": 729250,
      "end_ms": 730490,
      "text": "屹立东方。",
      "token_start": 2415,
      "token_end_exclusive": 2419
    },
    {
      "start_ms": 731090,
      "end_ms": 732470,
      "text": "我们现在吹的风，",
      "token_start": 2419,
      "token_end_exclusive": 2426
    },
    {
      "start_ms": 732830,
      "end_ms": 735450,
      "text": "看的景想的岁月静好，",
      "token_start": 2426,
      "token_end_exclusive": 2435
    },
    {
      "start_ms": 735750,
      "end_ms": 736950,
      "text": "都是程本华。",
      "token_start": 2435,
      "token_end_exclusive": 2440
    },
    {
      "start_ms": 736990,
      "end_ms": 737970,
      "text": "这样的先烈，",
      "token_start": 2440,
      "token_end_exclusive": 2445
    },
    {
      "start_ms": 738290,
      "end_ms": 740670,
      "text": "用青春和热血换来的。",
      "token_start": 2445,
      "token_end_exclusive": 2454
    },
    {
      "start_ms": 741410,
      "end_ms": 744010,
      "text": "她本是花样年华的普通女孩，",
      "token_start": 2454,
      "token_end_exclusive": 2466
    },
    {
      "start_ms": 744550,
      "end_ms": 747150,
      "text": "本该拥有平淡幸福的一生，",
      "token_start": 2466,
      "token_end_exclusive": 2477
    },
    {
      "start_ms": 747150,
      "end_ms": 750620,
      "text": "却在乱世之中挺身而出，",
      "token_start": 2477,
      "token_end_exclusive": 2487
    },
    {
      "start_ms": 751140,
      "end_ms": 752660,
      "text": "舍小家为大家，",
      "token_start": 2487,
      "token_end_exclusive": 2493
    },
    {
      "start_ms": 752960,
      "end_ms": 754340,
      "text": "以柔弱之屈。",
      "token_start": 2493,
      "token_end_exclusive": 2498
    },
    {
      "start_ms": 754500,
      "end_ms": 756080,
      "text": "但民族大义，",
      "token_start": 2498,
      "token_end_exclusive": 2503
    },
    {
      "start_ms": 756880,
      "end_ms": 759660,
      "text": "他的微笑不是懦弱的妥协，",
      "token_start": 2503,
      "token_end_exclusive": 2514
    },
    {
      "start_ms": 760080,
      "end_ms": 764320,
      "text": "而是中国人刻在骨子里的骨气与忠诚。",
      "token_start": 2514,
      "token_end_exclusive": 2530
    },
    {
      "start_ms": 764960,
      "end_ms": 767740,
      "text": "他的牺牲不是无畏的落幕，",
      "token_start": 2530,
      "token_end_exclusive": 2541
    },
    {
      "start_ms": 768060,
      "end_ms": 771260,
      "text": "而是照亮民族前路的星火微光。",
      "token_start": 2541,
      "token_end_exclusive": 2554
    },
    {
      "start_ms": 772040,
      "end_ms": 772520,
      "text": "如今，",
      "token_start": 2554,
      "token_end_exclusive": 2556
    },
    {
      "start_ms": 772560,
      "end_ms": 773960,
      "text": "很多人追求名利，",
      "token_start": 2556,
      "token_end_exclusive": 2563
    },
    {
      "start_ms": 774260,
      "end_ms": 775400,
      "text": "贪图安逸，",
      "token_start": 2563,
      "token_end_exclusive": 2567
    },
    {
      "start_ms": 775760,
      "end_ms": 779095,
      "text": "却渐渐忘记了盛世是来之不易。",
      "token_start": 2567,
      "token_end_exclusive": 2580
    },
    {
      "start_ms": 779670,
      "end_ms": 783335,
      "text": "正是无数像程本华一样的无名先烈，",
      "token_start": 2580,
      "token_end_exclusive": 2595
    },
    {
      "start_ms": 783740,
      "end_ms": 784980,
      "text": "以身许国，",
      "token_start": 2595,
      "token_end_exclusive": 2599
    },
    {
      "start_ms": 785320,
      "end_ms": 786585,
      "text": "浴血奋战，",
      "token_start": 2599,
      "token_end_exclusive": 2603
    },
    {
      "start_ms": 787050,
      "end_ms": 789945,
      "text": "才换来了我们当下的国泰民安。",
      "token_start": 2603,
      "token_end_exclusive": 2616
    },
    {
      "start_ms": 790240,
      "end_ms": 791760,
      "text": "英雄不该被遗忘，",
      "token_start": 2616,
      "token_end_exclusive": 2623
    },
    {
      "start_ms": 792000,
      "end_ms": 793635,
      "text": "历史不该被尘封。",
      "token_start": 2623,
      "token_end_exclusive": 2630
    },
    {
      "start_ms": 794360,
      "end_ms": 797765,
      "text": "如果你也敬佩这位笑对屠刀的巾帼英雄，",
      "token_start": 2630,
      "token_end_exclusive": 2647
    },
    {
      "start_ms": 798170,
      "end_ms": 799070,
      "text": "记得关注我，",
      "token_start": 2647,
      "token_end_exclusive": 2652
    },
    {
      "start_ms": 799110,
      "end_ms": 805125,
      "text": "点赞、转发、收藏、评论区留下一句致敬先烈忠魂，",
      "token_start": 2652,
      "token_end_exclusive": 2671
    },
    {
      "start_ms": 805690,
      "end_ms": 807695,
      "text": "传承爱国风骨，",
      "token_start": 2671,
      "token_end_exclusive": 2677
    },
    {
      "start_ms": 808580,
      "end_ms": 811755,
      "text": "让英雄故事永远被世人铭记。",
      "token_start": 2677,
      "token_end_exclusive": 2689
    }
  ],
