{
  "video_id": "v_1043581b585fd72d",
  "duration_s": 471.157007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1043581b585fd72d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1043581b585fd72d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 4050,
      "text": "您知道中国秋天最有诗意的湖泊是哪一个吗？",
      "token_start": 0,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4570,
      "end_ms": 5190,
      "text": "上集，",
      "token_start": 19,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5210,
      "end_ms": 12250,
      "text": "咱们聊了瘦西湖、长白山天池、洱海、纳木错、洞庭湖这一集，",
      "token_start": 21,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12370,
      "end_ms": 13630,
      "text": "直接揭开谜底，",
      "token_start": 44,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 13930,
      "end_ms": 15190,
      "text": "看看前五名。",
      "token_start": 50,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 15370,
      "end_ms": 16670,
      "text": "诗意到什么当家，",
      "token_start": 55,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 17030,
      "end_ms": 20870,
      "text": "尤其是排在榜首的那个湖湖边的人家，",
      "token_start": 62,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21230,
      "end_ms": 23070,
      "text": "至今还是女人当家。",
      "token_start": 78,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 23790,
      "end_ms": 24810,
      "text": "一入深秋，",
      "token_start": 86,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 25110,
      "end_ms": 26310,
      "text": "岸边的草海，",
      "token_start": 90,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 26370,
      "end_ms": 29250,
      "text": "黄成一片像铺开的金毯子，",
      "token_start": 95,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 29630,
      "end_ms": 30540,
      "text": "画不多说，",
      "token_start": 106,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 30960,
      "end_ms": 32340,
      "text": "茶给您沏好了，",
      "token_start": 110,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 32600,
      "end_ms": 34500,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 116,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 34720,
      "end_ms": 35820,
      "text": "咱们这就开讲。",
      "token_start": 126,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 36140,
      "end_ms": 36840,
      "text": "第五名，",
      "token_start": 132,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 37440,
      "end_ms": 40920,
      "text": "杭州西湖这个名字不用多介绍，",
      "token_start": 135,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 41280,
      "end_ms": 42780,
      "text": "小学课本里就有它，",
      "token_start": 148,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 43380,
      "end_ms": 45360,
      "text": "他不过六平方公里多，",
      "token_start": 156,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 45760,
      "end_ms": 48640,
      "text": "却被叫了一千年的人间天堂。",
      "token_start": 165,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 49160,
      "end_ms": 50920,
      "text": "白居易做杭州刺史，",
      "token_start": 177,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 51380,
      "end_ms": 52120,
      "text": "修了白堤。",
      "token_start": 185,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 52980,
      "end_ms": 53980,
      "text": "两百多年后，",
      "token_start": 189,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 54080,
      "end_ms": 55060,
      "text": "苏东坡来了，",
      "token_start": 194,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 55600,
      "end_ms": 56440,
      "text": "修了苏堤，",
      "token_start": 199,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 57020,
      "end_ms": 60795,
      "text": "一个接一个把一湖水写进了无数首势。",
      "token_start": 203,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 61380,
      "end_ms": 64325,
      "text": "秋天的西湖月亮一出来，",
      "token_start": 219,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 64720,
      "end_ms": 66365,
      "text": "湖面泛着荧光，",
      "token_start": 229,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 67150,
      "end_ms": 69750,
      "text": "满爵拢的桂花被风一吹，",
      "token_start": 235,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 70030,
      "end_ms": 73235,
      "text": "落进水里香都浮在水面上，",
      "token_start": 245,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 73940,
      "end_ms": 75555,
      "text": "再到残骸的时候，",
      "token_start": 256,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 75980,
      "end_ms": 76985,
      "text": "听一场雨，",
      "token_start": 263,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 77370,
      "end_ms": 79085,
      "text": "淅淅沥沥不吵，",
      "token_start": 267,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 79570,
      "end_ms": 81905,
      "text": "却把人心洗得清清楚楚，",
      "token_start": 273,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 82330,
      "end_ms": 84085,
      "text": "浓墨重彩都过去了，",
      "token_start": 283,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 84630,
      "end_ms": 87125,
      "text": "剩下的是平淡里的真意，",
      "token_start": 291,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 87550,
      "end_ms": 88755,
      "text": "这才叫送运。",
      "token_start": 301,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 89450,
      "end_ms": 90730,
      "text": "您要是秋天去，",
      "token_start": 306,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 91050,
      "end_ms": 92055,
      "text": "别赶热闹，",
      "token_start": 312,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 92470,
      "end_ms": 93350,
      "text": "挑个下雨的，",
      "token_start": 316,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 93350,
      "end_ms": 95900,
      "text": "傍晚在湖边找个地方坐着，",
      "token_start": 321,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 95900,
      "end_ms": 96360,
      "text": "听雨，",
      "token_start": 332,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 96580,
      "end_ms": 98165,
      "text": "比什么景点都值。",
      "token_start": 334,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 98530,
      "end_ms": 99315,
      "text": "第四名，",
      "token_start": 341,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 99730,
      "end_ms": 100555,
      "text": "青海湖，",
      "token_start": 344,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 101500,
      "end_ms": 105205,
      "text": "他在青藏高原上海拔三千二百多米，",
      "token_start": 347,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 105640,
      "end_ms": 108205,
      "text": "面积四千四百多平方公里，",
      "token_start": 362,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 108800,
      "end_ms": 111515,
      "text": "是中国最大的内陆咸水湖。",
      "token_start": 373,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 112270,
      "end_ms": 113270,
      "text": "环湖一圈，",
      "token_start": 384,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 113450,
      "end_ms": 114785,
      "text": "三百六十多公里，",
      "token_start": 388,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 115250,
      "end_ms": 115710,
      "text": "夏天，",
      "token_start": 395,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 115850,
      "end_ms": 117385,
      "text": "油菜花铺天盖地，",
      "token_start": 397,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 117700,
      "end_ms": 121010,
      "text": "游客挤满了湖边的路可一入深秋，",
      "token_start": 404,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 121450,
      "end_ms": 123710,
      "text": "花谢了人散了，",
      "token_start": 418,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 124170,
      "end_ms": 127670,
      "text": "湖水难得苍茫连天的秋草，",
      "token_start": 424,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 127790,
      "end_ms": 128730,
      "text": "一片金黄。",
      "token_start": 435,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 129630,
      "end_ms": 132390,
      "text": "南迁的天鹅在水草间落脚，",
      "token_start": 439,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 132930,
      "end_ms": 133950,
      "text": "安安静静，",
      "token_start": 450,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 134330,
      "end_ms": 135910,
      "text": "连风都走得很轻。",
      "token_start": 454,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 136770,
      "end_ms": 138010,
      "text": "您站在岸边，",
      "token_start": 461,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 138510,
      "end_ms": 140050,
      "text": "想不安静都难。",
      "token_start": 466,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 140450,
      "end_ms": 147170,
      "text": "王昌龄写青海长云暗雪山写的就是这片燎原热闹，",
      "token_start": 472,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 147170,
      "end_ms": 148810,
      "text": "是别人的湖，",
      "token_start": 493,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 149170,
      "end_ms": 150200,
      "text": "还是那这个湖，",
      "token_start": 498,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 150920,
      "end_ms": 152720,
      "text": "他从来没为谁变过，",
      "token_start": 504,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 152720,
      "end_ms": 154920,
      "text": "脸色繁华褪尽，",
      "token_start": 512,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 155280,
      "end_ms": 156840,
      "text": "才见素朴的真容。",
      "token_start": 518,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 157580,
      "end_ms": 159100,
      "text": "人到了下半辈子，",
      "token_start": 525,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 159500,
      "end_ms": 160540,
      "text": "看淡名利，",
      "token_start": 532,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 160900,
      "end_ms": 162460,
      "text": "内里反而更满。",
      "token_start": 536,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 162800,
      "end_ms": 163420,
      "text": "第深处，",
      "token_start": 542,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 164020,
      "end_ms": 165220,
      "text": "新疆喀纳斯湖，",
      "token_start": 545,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 165879,
      "end_ms": 168380,
      "text": "它藏在阿尔泰山密林深处，",
      "token_start": 551,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 169040,
      "end_ms": 171680,
      "text": "离最近的县城一百多公里，",
      "token_start": 562,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 172060,
      "end_ms": 174540,
      "text": "湖面不到四十六平方公里，",
      "token_start": 573,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 174960,
      "end_ms": 177060,
      "text": "最深处一百八十多米，",
      "token_start": 584,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 177440,
      "end_ms": 180935,
      "text": "蒙古语离喀纳斯市美丽而神秘。",
      "token_start": 593,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 181420,
      "end_ms": 182425,
      "text": "深秋时节，",
      "token_start": 606,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 182790,
      "end_ms": 185965,
      "text": "满山的落叶松一夜变成金黄，",
      "token_start": 610,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 186400,
      "end_ms": 190275,
      "text": "像巨浪一层压着一层直往天上堆。",
      "token_start": 622,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 190720,
      "end_ms": 191240,
      "text": "清晨，",
      "token_start": 636,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 191540,
      "end_ms": 194540,
      "text": "月亮湾和神仙湾的水面升起，",
      "token_start": 638,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 194620,
      "end_ms": 200365,
      "text": "薄雾奶蓝色的湖水在雾里半隐半现雾一散。",
      "token_start": 650,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 200720,
      "end_ms": 203235,
      "text": "金黄的林子倒映进水里，",
      "token_start": 668,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 203720,
      "end_ms": 205865,
      "text": "像一幅泼上去的大画。",
      "token_start": 678,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 206220,
      "end_ms": 209325,
      "text": "这样的景色不用您读多少诗，",
      "token_start": 687,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 209880,
      "end_ms": 210875,
      "text": "一眼就够了。",
      "token_start": 699,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 211780,
      "end_ms": 214625,
      "text": "清早去的人裹着厚外套，",
      "token_start": 704,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 215270,
      "end_ms": 216725,
      "text": "站在观景台上，",
      "token_start": 714,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 217150,
      "end_ms": 218250,
      "text": "一边哈白气，",
      "token_start": 720,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 218570,
      "end_ms": 219885,
      "text": "一边等雾散，",
      "token_start": 725,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 220400,
      "end_ms": 221795,
      "text": "没人舍得先走，",
      "token_start": 730,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 222230,
      "end_ms": 223970,
      "text": "诗意不止在案头，",
      "token_start": 736,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 224330,
      "end_ms": 226085,
      "text": "更在万里山河。",
      "token_start": 743,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 226470,
      "end_ms": 227030,
      "text": "第二名，",
      "token_start": 749,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 227270,
      "end_ms": 231495,
      "text": "江西鄱阳湖三千多平方公里的浩瀚水域，",
      "token_start": 752,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 231840,
      "end_ms": 233585,
      "text": "是中国第一大淡水湖，",
      "token_start": 769,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 234040,
      "end_ms": 236835,
      "text": "也是滕王阁序里最鲜活的注脚。",
      "token_start": 778,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 237620,
      "end_ms": 238020,
      "text": "然而，",
      "token_start": 791,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 238020,
      "end_ms": 239445,
      "text": "他最神奇的时刻，",
      "token_start": 793,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 239810,
      "end_ms": 240930,
      "text": "偏偏是深秋。",
      "token_start": 800,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 241010,
      "end_ms": 241685,
      "text": "枯水期，",
      "token_start": 805,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 242350,
      "end_ms": 245000,
      "text": "水位缓缓退去辽阔，",
      "token_start": 808,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 245140,
      "end_ms": 247660,
      "text": "湖滩奇迹般化作万顷，",
      "token_start": 816,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 247840,
      "end_ms": 249825,
      "text": "粉紫色燎紫花海，",
      "token_start": 825,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 250230,
      "end_ms": 252950,
      "text": "与茫茫芦苇荡数十万只，",
      "token_start": 832,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 252950,
      "end_ms": 254625,
      "text": "候鸟振翅齐飞。",
      "token_start": 842,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 255330,
      "end_ms": 256730,
      "text": "千年前的落星墩，",
      "token_start": 848,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 256910,
      "end_ms": 257665,
      "text": "古石岛，",
      "token_start": 855,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 257950,
      "end_ms": 258310,
      "text": "孤傲，",
      "token_start": 858,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 258310,
      "end_ms": 259815,
      "text": "挺立于草海之中。",
      "token_start": 860,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 260170,
      "end_ms": 261670,
      "text": "落霞与孤鹜齐飞，",
      "token_start": 867,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 262050,
      "end_ms": 263995,
      "text": "秋水共长天一色，",
      "token_start": 874,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 264310,
      "end_ms": 266385,
      "text": "在这儿成了触手可及的现实。",
      "token_start": 881,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 266830,
      "end_ms": 268090,
      "text": "水掌为浩渺，",
      "token_start": 893,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 268130,
      "end_ms": 271235,
      "text": "大湖水落为万千花海，",
      "token_start": 898,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 271770,
      "end_ms": 273550,
      "text": "大自然以枯荣起落，",
      "token_start": 907,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 273710,
      "end_ms": 275145,
      "text": "书写生命韵律。",
      "token_start": 915,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 275710,
      "end_ms": 278030,
      "text": "人生起落终有常从容。",
      "token_start": 921,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 278090,
      "end_ms": 280365,
      "text": "面对及是景第一名，",
      "token_start": 930,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 280770,
      "end_ms": 284195,
      "text": "泸沽湖、川滇交界的崇山峻岭之中，",
      "token_start": 938,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 284600,
      "end_ms": 287105,
      "text": "为什么是他他不再闹事，",
      "token_start": 952,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 287530,
      "end_ms": 289095,
      "text": "也不跟群山争高。",
      "token_start": 962,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 289710,
      "end_ms": 292605,
      "text": "他藏在川边交界的高山深处，",
      "token_start": 969,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 293130,
      "end_ms": 294795,
      "text": "海拔两千六百多米，",
      "token_start": 981,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 295310,
      "end_ms": 297115,
      "text": "最深处将近一百米。",
      "token_start": 989,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 297630,
      "end_ms": 301050,
      "text": "水清的能看见很深的水下湖面，",
      "token_start": 997,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 301090,
      "end_ms": 302910,
      "text": "差不多有五十平方公里，",
      "token_start": 1010,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 303290,
      "end_ms": 305890,
      "text": "四周的山倒映进去，",
      "token_start": 1020,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 306270,
      "end_ms": 308050,
      "text": "一点杂色都没有。",
      "token_start": 1028,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 308750,
      "end_ms": 310630,
      "text": "海菜花一朵一朵，",
      "token_start": 1035,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 310650,
      "end_ms": 311590,
      "text": "浮在水面，",
      "token_start": 1042,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 312010,
      "end_ms": 313910,
      "text": "一阵风过花影，",
      "token_start": 1046,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 314010,
      "end_ms": 317810,
      "text": "跟着水纹轻轻晃晃的人心里发软。",
      "token_start": 1052,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 318250,
      "end_ms": 320430,
      "text": "它没有一首教科书里的明片，",
      "token_start": 1066,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 321210,
      "end_ms": 324090,
      "text": "也没有一座让人登高的明楼。",
      "token_start": 1078,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 324490,
      "end_ms": 326905,
      "text": "可您深秋清晨走到湖边，",
      "token_start": 1090,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 327360,
      "end_ms": 329080,
      "text": "会看见金黄的草海，",
      "token_start": 1100,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 329120,
      "end_ms": 332320,
      "text": "随风一拂一起洁白的海菜花，",
      "token_start": 1108,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 332380,
      "end_ms": 333560,
      "text": "静静浮在水面。",
      "token_start": 1120,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 334240,
      "end_ms": 336800,
      "text": "这种花水不干净到极处。",
      "token_start": 1126,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 337020,
      "end_ms": 337760,
      "text": "他不肯开，",
      "token_start": 1136,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 338280,
      "end_ms": 339380,
      "text": "乘雾没散，",
      "token_start": 1140,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 340120,
      "end_ms": 341580,
      "text": "湖心有一叶株，",
      "token_start": 1144,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 341580,
      "end_ms": 343560,
      "text": "草船慢慢划过。",
      "token_start": 1150,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 344060,
      "end_ms": 345600,
      "text": "船是整根树干，",
      "token_start": 1156,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 345620,
      "end_ms": 350500,
      "text": "掏空坐的摩梭人划了不知多少代桨入水，",
      "token_start": 1162,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 350600,
      "end_ms": 352000,
      "text": "几乎听不见响动，",
      "token_start": 1179,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 352560,
      "end_ms": 354460,
      "text": "生怕惊了这一湖的安静。",
      "token_start": 1186,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 354460,
      "end_ms": 357085,
      "text": "船上的人不急得去哪儿，",
      "token_start": 1196,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 357380,
      "end_ms": 358315,
      "text": "也不跟谁比。",
      "token_start": 1206,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 359110,
      "end_ms": 362705,
      "text": "湖边的摩梭人至今保留着母系的家，",
      "token_start": 1211,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 363110,
      "end_ms": 365215,
      "text": "女人当家一家老小，",
      "token_start": 1226,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 365580,
      "end_ms": 367905,
      "text": "围着最年长的女性过日子。",
      "token_start": 1234,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 368310,
      "end_ms": 369405,
      "text": "前九个湖，",
      "token_start": 1245,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 369890,
      "end_ms": 372065,
      "text": "有的靠千古名篇留名，",
      "token_start": 1249,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 372740,
      "end_ms": 377265,
      "text": "有的靠天地大美经验泸沽湖什么都不靠。",
      "token_start": 1258,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 377770,
      "end_ms": 381245,
      "text": "他给人的是看透世事喧嚣之后，",
      "token_start": 1275,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 381640,
      "end_ms": 383895,
      "text": "终于找回的那一口平井。",
      "token_start": 1288,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 384340,
      "end_ms": 386025,
      "text": "这不是读出来的诗，",
      "token_start": 1298,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 386510,
      "end_ms": 388290,
      "text": "是从心里长出来的，",
      "token_start": 1306,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 388290,
      "end_ms": 390695,
      "text": "氨有人在湖边一坐，",
      "token_start": 1314,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 391080,
      "end_ms": 392285,
      "text": "眼泪就下来了。",
      "token_start": 1322,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 392690,
      "end_ms": 393270,
      "text": "说不清，",
      "token_start": 1328,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 393270,
      "end_ms": 393915,
      "text": "为什么？",
      "token_start": 1331,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 394250,
      "end_ms": 397310,
      "text": "只觉得总算到家了十个虎，",
      "token_start": 1334,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 397310,
      "end_ms": 397925,
      "text": "讲完了。",
      "token_start": 1345,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 398750,
      "end_ms": 401085,
      "text": "瘦西湖瘦成一幅长卷，",
      "token_start": 1348,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 401680,
      "end_ms": 404460,
      "text": "天池在云端孤傲洱海，",
      "token_start": 1357,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 404480,
      "end_ms": 405985,
      "text": "让人敢慢下来。",
      "token_start": 1366,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 406410,
      "end_ms": 408505,
      "text": "纳木错让人放下心事。",
      "token_start": 1372,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 409060,
      "end_ms": 412525,
      "text": "洞庭湖装着杜甫的泪和范仲淹的胸襟，",
      "token_start": 1381,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 413350,
      "end_ms": 415735,
      "text": "西湖把平淡熬出了真位。",
      "token_start": 1397,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 416130,
      "end_ms": 418290,
      "text": "青海湖在繁华散尽后，",
      "token_start": 1407,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 418330,
      "end_ms": 419405,
      "text": "素朴辽远，",
      "token_start": 1416,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 419780,
      "end_ms": 425925,
      "text": "喀纳斯把整座山烧成金色的画鄱阳湖在掌落里教人从容，",
      "token_start": 1420,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 426600,
      "end_ms": 428890,
      "text": "可只有泸沽湖名篇，",
      "token_start": 1444,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 428950,
      "end_ms": 430715,
      "text": "没靠高度没争，",
      "token_start": 1452,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 431030,
      "end_ms": 433285,
      "text": "就把诗意走到了最深的地方。",
      "token_start": 1458,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 433690,
      "end_ms": 435490,
      "text": "有的湖让人赞叹，",
      "token_start": 1470,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 435710,
      "end_ms": 437575,
      "text": "有的湖让人感慨，",
      "token_start": 1477,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 438080,
      "end_ms": 441895,
      "text": "只有他让人安最有诗意的湖，",
      "token_start": 1484,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 442460,
      "end_ms": 443480,
      "text": "不是最美的。",
      "token_start": 1496,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 443480,
      "end_ms": 446305,
      "text": "那一个是您看完之后，",
      "token_start": 1501,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 446700,
      "end_ms": 449060,
      "text": "心里那口气终于顺了的。",
      "token_start": 1510,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 449060,
      "end_ms": 451275,
      "text": "那一个最后问问您，",
      "token_start": 1520,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 451790,
      "end_ms": 452745,
      "text": "这十个湖，",
      "token_start": 1528,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 453080,
      "end_ms": 456475,
      "text": "您去过几个最想去的是哪一个？",
      "token_start": 1532,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 456870,
      "end_ms": 457975,
      "text": "评论区告诉我，",
      "token_start": 1545,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 458430,
      "end_ms": 460615,
      "text": "觉得这期让您成了见识，",
      "token_start": 1551,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 461020,
      "end_ms": 464775,
      "text": "就转给身边跟您一样爱看山河湖海的人，",
      "token_start": 1561,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 465500,
      "end_ms": 468185,
      "text": "想听更多秋天里的湖光山色。",
      "token_start": 1578,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 468460,
      "end_ms": 469205,
      "text": "点个关注，",
      "token_start": 1590,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 469450,
      "end_ms": 470935,
      "text": "咱们下期接着聊。",
      "token_start": 1594,
      "token_end_exclusive": 1601
    }
  ],
