      "token_end_exclusive": 84
    },
    {
      "start_ms": 17410,
      "end_ms": 20670,
      "text": "带上他大多是对生活的一知半解。",
      "token_start": 84,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 21330,
      "end_ms": 22710,
      "text": "很多孩子为什么聪明？",
      "token_start": 98,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 22870,
      "end_ms": 23430,
      "text": "他聪明？",
      "token_start": 107,
      "token_end_exclusive": 110
    },
    {
