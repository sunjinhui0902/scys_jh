{
  "video_id": "v_c5a603255b951b19",
  "duration_s": 352.517241,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c5a603255b951b19.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c5a603255b951b19.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 3390,
      "text": "七十四岁的他倒在东京讲台上，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 4170,
      "end_ms": 7410,
      "text": "生命最后一刻还在讲课。",
      "token_start": 13,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 8470,
      "end_ms": 9090,
      "text": "家人们。",
      "token_start": 23,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 9390,
      "end_ms": 11530,
      "text": "一九八五年六月十二日，",
      "token_start": 26,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 12110,
      "end_ms": 16430,
      "text": "日本东京大学一场数学演讲刚刚结束，",
      "token_start": 36,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 16990,
      "end_ms": 18170,
      "text": "掌声雷动。",
      "token_start": 52,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 19190,
      "end_ms": 23310,
      "text": "七十四岁的华罗庚结过鲜花正要致谢，",
      "token_start": 56,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 23630,
      "end_ms": 25290,
      "text": "突然身子往后一仰，",
      "token_start": 72,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 25650,
      "end_ms": 26970,
      "text": "倒在了讲台上，",
      "token_start": 80,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 27870,
      "end_ms": 30540,
      "text": "这一倒就再也没动起来。",
      "token_start": 86,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 32000,
      "end_ms": 32620,
      "text": "家人们，",
      "token_start": 96,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 33020,
      "end_ms": 35200,
      "text": "他倒下的地方是讲台，",
      "token_start": 99,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 35560,
      "end_ms": 36680,
      "text": "他留给这个世界，",
      "token_start": 108,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 36680,
      "end_ms": 40400,
      "text": "最后的画面是站在讲台上讲课的样子。",
      "token_start": 115,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 41240,
      "end_ms": 42200,
      "text": "可你知道吗？",
      "token_start": 131,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 42560,
      "end_ms": 45840,
      "text": "这个让全世界数学家竖起大拇指的人，",
      "token_start": 136,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 46360,
      "end_ms": 51120,
      "text": "六十年前是个连高中都没考上的笨孩子，",
      "token_start": 152,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 51460,
      "end_ms": 53500,
      "text": "老师嫌他字写的潦草，",
      "token_start": 169,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 54080,
      "end_ms": 57160,
      "text": "同学叫他呆子爹妈死了心，",
      "token_start": 178,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 57480,
      "end_ms": 59855,
      "text": "让他回家站柜台卖棉花。",
      "token_start": 189,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 60560,
      "end_ms": 66365,
      "text": "谁能想到那个趴在柜台上就着油灯算题的瘸腿小伙计。",
      "token_start": 199,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 67030,
      "end_ms": 70275,
      "text": "最后成了让清华大学破规矩，",
      "token_start": 222,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 70750,
      "end_ms": 74750,
      "text": "让剑桥大学抢着请的中国数学之父，",
      "token_start": 234,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 74890,
      "end_ms": 76475,
      "text": "你频频这反差，",
      "token_start": 249,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 77010,
      "end_ms": 79115,
      "text": "一个被全世界说不行的人，",
      "token_start": 255,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 79740,
      "end_ms": 81425,
      "text": "最后让全世界都服了气。",
      "token_start": 266,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 82340,
      "end_ms": 83795,
      "text": "更让人心酸的是，",
      "token_start": 276,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 84070,
      "end_ms": 86435,
      "text": "他一辈子只有一条好腿。",
      "token_start": 283,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 87710,
      "end_ms": 88625,
      "text": "十九岁那年，",
      "token_start": 293,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 89150,
      "end_ms": 91345,
      "text": "一场伤寒差点要了他的命，",
      "token_start": 298,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 91890,
      "end_ms": 94645,
      "text": "家里人连棺材都给他备好了，",
      "token_start": 309,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 95210,
      "end_ms": 97975,
      "text": "命是保住了左腿却废了，",
      "token_start": 321,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 98430,
      "end_ms": 99870,
      "text": "走路一瘸一拐，",
      "token_start": 331,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 100130,
      "end_ms": 101175,
      "text": "再也站不直。",
      "token_start": 337,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 101850,
      "end_ms": 103495,
      "text": "可就是这么一条残腿。",
      "token_start": 342,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 104020,
      "end_ms": 105095,
      "text": "晚年的时候，",
      "token_start": 351,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 105440,
      "end_ms": 109090,
      "text": "他跑遍了全国二十多个省工厂车间，",
      "token_start": 356,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 109090,
      "end_ms": 110830,
      "text": "他去田间地头，",
      "token_start": 371,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 110830,
      "end_ms": 112550,
      "text": "他也去修铁路的工人，",
      "token_start": 377,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 112550,
      "end_ms": 114930,
      "text": "听他讲建大桥的工人，",
      "token_start": 386,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 114930,
      "end_ms": 117125,
      "text": "听他讲连麦烧饼，",
      "token_start": 395,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 117860,
      "end_ms": 121240,
      "text": "炸油条的小贩都听过他讲课。",
      "token_start": 402,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 122100,
      "end_ms": 124540,
      "text": "有人劝他话痨，",
      "token_start": 414,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 125300,
      "end_ms": 126880,
      "text": "你是世界级大师，",
      "token_start": 420,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 127360,
      "end_ms": 129620,
      "text": "干这些是不是大材小用啊？",
      "token_start": 427,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 130440,
      "end_ms": 130940,
      "text": "他说，",
      "token_start": 438,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 131820,
      "end_ms": 132920,
      "text": "数学不落地，",
      "token_start": 440,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 133020,
      "end_ms": 134300,
      "text": "就是纸上谈兵。",
      "token_start": 445,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 135160,
      "end_ms": 142080,
      "text": "工人兄弟多产一吨钢工人兄兄多打一担粮比什么都强。",
      "token_start": 451,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 142580,
      "end_ms": 143200,
      "text": "家人们，",
      "token_start": 474,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 143440,
      "end_ms": 146500,
      "text": "他这辈子本来有三次机会，",
      "token_start": 477,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 146800,
      "end_ms": 147940,
      "text": "过得舒舒服服。",
      "token_start": 488,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 148300,
      "end_ms": 153770,
      "text": "第一次在剑桥全世界数学家挤破头的地方，",
      "token_start": 494,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 153830,
      "end_ms": 155630,
      "text": "他两年写出二十篇论文，",
      "token_start": 512,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 156410,
      "end_ms": 157950,
      "text": "整个欧洲都震动。",
      "token_start": 522,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 159090,
      "end_ms": 160290,
      "text": "剑桥想流淌，",
      "token_start": 529,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 160570,
      "end_ms": 162210,
      "text": "说他前途不可限量。",
      "token_start": 534,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 162570,
      "end_ms": 164830,
      "text": "可一九三八年抗战爆发，",
      "token_start": 542,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 165670,
      "end_ms": 168730,
      "text": "他收拾行李回国了，",
      "token_start": 552,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 169150,
      "end_ms": 170050,
      "text": "有人不理解，",
      "token_start": 560,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 170170,
      "end_ms": 170590,
      "text": "他说，",
      "token_start": 565,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 170850,
      "end_ms": 172370,
      "text": "我的根在中国，",
      "token_start": 567,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 173170,
      "end_ms": 174650,
      "text": "第二次在美国。",
      "token_start": 573,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 175610,
      "end_ms": 176690,
      "text": "一九四六年，",
      "token_start": 579,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 176890,
      "end_ms": 179325,
      "text": "他应邀去美国讲学，",
      "token_start": 584,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 179900,
      "end_ms": 181825,
      "text": "美国给他终身教授待遇，",
      "token_start": 592,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 182260,
      "end_ms": 185170,
      "text": "年薪高的惊人研究条件，",
      "token_start": 602,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 185270,
      "end_ms": 189475,
      "text": "全世界最好各一般人肯定就留下了。",
      "token_start": 612,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 190460,
      "end_ms": 191715,
      "text": "可他待了四年。",
      "token_start": 627,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 192170,
      "end_ms": 193305,
      "text": "一九五零年，",
      "token_start": 633,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 193540,
      "end_ms": 194980,
      "text": "新中国百废待兴，",
      "token_start": 638,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 195180,
      "end_ms": 196005,
      "text": "一穷二白。",
      "token_start": 645,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 196810,
      "end_ms": 197870,
      "text": "他写下八个字，",
      "token_start": 649,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 197970,
      "end_ms": 199075,
      "text": "良缘虽好，",
      "token_start": 655,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 199380,
      "end_ms": 200625,
      "text": "非久居之乡，",
      "token_start": 659,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 201200,
      "end_ms": 202105,
      "text": "归去来兮，",
      "token_start": 664,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 202500,
      "end_ms": 205355,
      "text": "带着全家登上了回国的轮船。",
      "token_start": 668,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 207360,
      "end_ms": 210805,
      "text": "第三次在晚年功成名就，",
      "token_start": 680,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 211230,
      "end_ms": 213605,
      "text": "本可以躺在功劳簿上享清福，",
      "token_start": 690,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 214140,
      "end_ms": 215845,
      "text": "他却拖着那条残腿，",
      "token_start": 702,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 216190,
      "end_ms": 217565,
      "text": "一头扎进工厂。",
      "token_start": 710,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 218100,
      "end_ms": 220210,
      "text": "有人说他傻放着轻浮，",
      "token_start": 716,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 220210,
      "end_ms": 220625,
      "text": "不想。",
      "token_start": 725,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 221040,
      "end_ms": 221480,
      "text": "他说，",
      "token_start": 727,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 222000,
      "end_ms": 223345,
      "text": "人有两个肩膀，",
      "token_start": 729,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 223940,
      "end_ms": 228675,
      "text": "一个肩膀把科学送到人民群众中去，",
      "token_start": 735,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 229580,
      "end_ms": 233135,
      "text": "另一个肩膀给年轻人当梯子，",
      "token_start": 750,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 233530,
      "end_ms": 235190,
      "text": "让他们踩着往上爬。",
      "token_start": 762,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 235490,
      "end_ms": 236665,
      "text": "一九八五年，",
      "token_start": 770,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 237050,
      "end_ms": 240285,
      "text": "七十四岁的他应邀去日本演讲，",
      "token_start": 775,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 241310,
      "end_ms": 243250,
      "text": "有人劝他年纪大了，",
      "token_start": 788,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 243250,
      "end_ms": 244175,
      "text": "身体又不好，",
      "token_start": 796,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 244480,
      "end_ms": 245205,
      "text": "就别去了，",
      "token_start": 801,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 246200,
      "end_ms": 249395,
      "text": "他说能讲一天就多讲一天。",
      "token_start": 805,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 249960,
      "end_ms": 250965,
      "text": "六月十二日，",
      "token_start": 816,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 251370,
      "end_ms": 252570,
      "text": "他倒在了讲台。",
      "token_start": 821,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 252570,
      "end_ms": 253905,
      "text": "上家人们，",
      "token_start": 827,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 254340,
      "end_ms": 254975,
      "text": "你想想，",
      "token_start": 831,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 255370,
      "end_ms": 258535,
      "text": "一个穷小子被叫了半辈子呆子，",
      "token_start": 834,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 259020,
      "end_ms": 261555,
      "text": "靠一盏油灯爬到了世界之巅，",
      "token_start": 847,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 262090,
      "end_ms": 264655,
      "text": "一个残疾人瘸着一条腿，",
      "token_start": 859,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 264970,
      "end_ms": 267135,
      "text": "把数学送进了千家万户。",
      "token_start": 869,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 267830,
      "end_ms": 269545,
      "text": "一个功成名就的老人，",
      "token_start": 879,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 269840,
      "end_ms": 271160,
      "text": "放着美国的高薪，",
      "token_start": 888,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 271160,
      "end_ms": 273095,
      "text": "不要望着轻浮不响，",
      "token_start": 895,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 274020,
      "end_ms": 278825,
      "text": "把最后的一口气都留在了讲课的讲台上。",
      "token_start": 903,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 280020,
      "end_ms": 283485,
      "text": "华罗庚这一辈子从烂泥里站起来，",
      "token_start": 920,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 284440,
      "end_ms": 285675,
      "text": "爬到世界之巅，",
      "token_start": 934,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 287550,
      "end_ms": 288435,
      "text": "又弯下腰，",
      "token_start": 940,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 289030,
      "end_ms": 291095,
      "text": "把学问送还给最普通的人。",
      "token_start": 944,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 291860,
      "end_ms": 293565,
      "text": "他这一生就信一句话，",
      "token_start": 955,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 294280,
      "end_ms": 295915,
      "text": "聪明在于勤奋，",
      "token_start": 964,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 296440,
      "end_ms": 301235,
      "text": "天才在于积累他用自己的实际行动，",
      "token_start": 970,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 301840,
      "end_ms": 303820,
      "text": "把这句话活成了真的真理。",
      "token_start": 985,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 303880,
      "end_ms": 304295,
      "text": "名言，",
      "token_start": 996,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 304890,
      "end_ms": 308205,
      "text": "一个人的出身可以穷腿可以残疾，",
      "token_start": 998,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 308490,
      "end_ms": 309445,
      "text": "可人的志气，",
      "token_start": 1012,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 309780,
      "end_ms": 310785,
      "text": "谁也夺不走。",
      "token_start": 1017,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 311040,
      "end_ms": 313205,
      "text": "国家可以穷家底可以薄，",
      "token_start": 1022,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 313780,
      "end_ms": 315020,
      "text": "可一个人的脊梁，",
      "token_start": 1032,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 315260,
      "end_ms": 316465,
      "text": "谁也压不弯。",
      "token_start": 1039,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 317140,
      "end_ms": 320135,
      "text": "华罗庚就是中国科学界的脊梁，",
      "token_start": 1044,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 320510,
      "end_ms": 324625,
      "text": "觉得话痨了不起的评论区大国之脊梁四个字。",
      "token_start": 1057,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 325260,
      "end_ms": 328465,
      "text": "三部曲到这儿就讲完了，",
      "token_start": 1076,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 329410,
      "end_ms": 332795,
      "text": "把三部曲从头看完的家人点个赞，",
      "token_start": 1086,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 333110,
      "end_ms": 333990,
      "text": "收藏起来，",
      "token_start": 1100,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 334170,
      "end_ms": 335750,
      "text": "随时翻出来讲，",
      "token_start": 1104,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 335750,
      "end_ms": 338565,
      "text": "给孩子听、转发出去，",
      "token_start": 1110,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 339580,
      "end_ms": 341905,
      "text": "让更多的人认识华罗庚，",
      "token_start": 1118,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 342470,
      "end_ms": 344285,
      "text": "传承华罗庚精神，",
      "token_start": 1128,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 344730,
      "end_ms": 346065,
      "text": "做中国的脊梁。",
      "token_start": 1135,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 346830,
      "end_ms": 347415,
      "text": "关注我，",
      "token_start": 1141,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 347900,
      "end_ms": 352395,
      "text": "每天带你了解一位名人背后的励志故事。",
      "token_start": 1144,
      "token_end_exclusive": 1161
    }
  ],
