{
  "video_id": "v_98f5df8545bbe3b4",
  "duration_s": 407.185011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_98f5df8545bbe3b4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_98f5df8545bbe3b4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 2910,
      "text": "北京一位八十二岁的老人走了，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3570,
      "end_ms": 5490,
      "text": "人们在整理他的遗物时，",
      "token_start": 13,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5710,
      "end_ms": 7230,
      "text": "心里很不是滋味，",
      "token_start": 23,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7750,
      "end_ms": 9550,
      "text": "老人没有自己的房子，",
      "token_start": 30,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9970,
      "end_ms": 10930,
      "text": "没有婚姻，",
      "token_start": 39,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 11190,
      "end_ms": 12070,
      "text": "没有儿女，",
      "token_start": 43,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 12590,
      "end_ms": 14410,
      "text": "攒了一辈子的积蓄，",
      "token_start": 47,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 14690,
      "end_ms": 15950,
      "text": "只有三万块钱，",
      "token_start": 55,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 16309,
      "end_ms": 17390,
      "text": "而这点钱，",
      "token_start": 61,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 17770,
      "end_ms": 19670,
      "text": "他也早立下遗嘱，",
      "token_start": 65,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 20050,
      "end_ms": 21170,
      "text": "全捐了出去。",
      "token_start": 72,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 21730,
      "end_ms": 24290,
      "text": "您说一个人活到八十二岁，",
      "token_start": 77,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 24630,
      "end_ms": 26510,
      "text": "一辈子就攒下三万块，",
      "token_start": 88,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 27090,
      "end_ms": 28230,
      "text": "还全捐了。",
      "token_start": 97,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 28530,
      "end_ms": 31020,
      "text": "他这辈子是不是是太亏了？",
      "token_start": 101,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 31760,
      "end_ms": 34720,
      "text": "可他有个名字叫万英之母，",
      "token_start": 112,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 35140,
      "end_ms": 36760,
      "text": "她叫林巧智，",
      "token_start": 123,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 36900,
      "end_ms": 39140,
      "text": "中国妇产科学的奠基人，",
      "token_start": 128,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 39620,
      "end_ms": 41960,
      "text": "中国科学院第一位女院士。",
      "token_start": 138,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 42380,
      "end_ms": 46040,
      "text": "她这一辈子亲手接生了五万多个，",
      "token_start": 149,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 46040,
      "end_ms": 48180,
      "text": "新生儿五万多个，",
      "token_start": 163,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 48340,
      "end_ms": 51240,
      "text": "您住那小区可能都没这么多人，",
      "token_start": 170,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 52080,
      "end_ms": 53200,
      "text": "她接生过谁？",
      "token_start": 183,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 53500,
      "end_ms": 54100,
      "text": "袁隆平，",
      "token_start": 188,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 54760,
      "end_ms": 55900,
      "text": "一九三零年，",
      "token_start": 191,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 56160,
      "end_ms": 58240,
      "text": "协和医院的出生档案里，",
      "token_start": 196,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 58560,
      "end_ms": 61660,
      "text": "接生医生一男写着调机，",
      "token_start": 206,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 61720,
      "end_ms": 61960,
      "text": "令，",
      "token_start": 216,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 62240,
      "end_ms": 67245,
      "text": "钟南山院士见了他得规规矩矩喊一声姑婆。",
      "token_start": 217,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 67870,
      "end_ms": 68515,
      "text": "您想啊，",
      "token_start": 235,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 68900,
      "end_ms": 70680,
      "text": "一个一无所有的女人，",
      "token_start": 238,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 70860,
      "end_ms": 72735,
      "text": "却有五万多个孩子，",
      "token_start": 247,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 73670,
      "end_ms": 74565,
      "text": "管他叫妈，",
      "token_start": 255,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 75380,
      "end_ms": 77925,
      "text": "他不是没机会过上好日子。",
      "token_start": 259,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 78670,
      "end_ms": 84065,
      "text": "他这一辈子有三次天大的机会摆在面前，",
      "token_start": 270,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 84280,
      "end_ms": 85145,
      "text": "他全扔了。",
      "token_start": 287,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 86670,
      "end_ms": 88785,
      "text": "第一次一九三九年，",
      "token_start": 291,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 89070,
      "end_ms": 93980,
      "text": "他去美国芝加哥大学进修美国的顶级医院抢着留下，",
      "token_start": 299,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 93980,
      "end_ms": 96055,
      "text": "他条件也开的特别高。",
      "token_start": 321,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 96640,
      "end_ms": 97560,
      "text": "进修结束，",
      "token_start": 330,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 97720,
      "end_ms": 98895,
      "text": "他撂下一句话，",
      "token_start": 334,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 99260,
      "end_ms": 100885,
      "text": "科学可以没有国界，",
      "token_start": 340,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 101510,
      "end_ms": 106355,
      "text": "医生不能没有祖国收拾箱子回到祖国。",
      "token_start": 348,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 107120,
      "end_ms": 110050,
      "text": "第二次一九四九年解放前夕，",
      "token_start": 364,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 110230,
      "end_ms": 114245,
      "text": "傅作义将军的夫人给他送来一张亲笔签名的机票，",
      "token_start": 376,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 114860,
      "end_ms": 119425,
      "text": "拿着他能上任何一架飞机去任何一个城市生活，",
      "token_start": 397,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 120230,
      "end_ms": 123150,
      "text": "多少人用金条都换不来的福利待遇，",
      "token_start": 417,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 123570,
      "end_ms": 124650,
      "text": "他却谢绝了。",
      "token_start": 432,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 126090,
      "end_ms": 127590,
      "text": "我的病人还在这儿，",
      "token_start": 437,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 128590,
      "end_ms": 129550,
      "text": "我哪儿也不去。",
      "token_start": 445,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 130710,
      "end_ms": 134230,
      "text": "第三次正值开国大典，",
      "token_start": 451,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 135250,
      "end_ms": 138170,
      "text": "他收到红底金字的官礼邀请函，",
      "token_start": 460,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 139350,
      "end_ms": 141770,
      "text": "多少人挤破脑袋都去不了。",
      "token_start": 473,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 142310,
      "end_ms": 143210,
      "text": "他看了一眼，",
      "token_start": 484,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 143410,
      "end_ms": 145230,
      "text": "搁在桌上进了产房，",
      "token_start": 489,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 145830,
      "end_ms": 146850,
      "text": "有人追着问，",
      "token_start": 497,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 147170,
      "end_ms": 148410,
      "text": "这么大的喜事，",
      "token_start": 502,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 148570,
      "end_ms": 149635,
      "text": "您怎么不去，",
      "token_start": 508,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 150060,
      "end_ms": 151060,
      "text": "她头也没回。",
      "token_start": 513,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 151500,
      "end_ms": 152380,
      "text": "我是大夫，",
      "token_start": 518,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 152840,
      "end_ms": 154420,
      "text": "产房里有产妇等着，",
      "token_start": 522,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 154660,
      "end_ms": 156700,
      "text": "您说这女人是不是傻？",
      "token_start": 530,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 157420,
      "end_ms": 159500,
      "text": "别人拼命想抓住的东西，",
      "token_start": 539,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 159680,
      "end_ms": 161360,
      "text": "她一样一样往外扔，",
      "token_start": 549,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 161900,
      "end_ms": 163220,
      "text": "可她心里那杆秤，",
      "token_start": 557,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 163560,
      "end_ms": 166440,
      "text": "从来没歪过她为什么学医？",
      "token_start": 564,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 167380,
      "end_ms": 168300,
      "text": "五岁那年，",
      "token_start": 575,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 168660,
      "end_ms": 169680,
      "text": "母亲病逝，",
      "token_start": 579,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 170480,
      "end_ms": 171660,
      "text": "却跪在床边，",
      "token_start": 583,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 172280,
      "end_ms": 175240,
      "text": "眼睁睁看着妈妈闭上眼睛，",
      "token_start": 588,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 176200,
      "end_ms": 177820,
      "text": "哭得撕心裂肺，",
      "token_start": 599,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 178300,
      "end_ms": 179705,
      "text": "却什么都做不了。",
      "token_start": 605,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 180620,
      "end_ms": 181520,
      "text": "从那天起，",
      "token_start": 612,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 181520,
      "end_ms": 184440,
      "text": "他就发誓我要当医生，",
      "token_start": 616,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 185180,
      "end_ms": 189060,
      "text": "我要让别人的妈不再死。",
      "token_start": 625,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 189260,
      "end_ms": 194860,
      "text": "他这一辈子把别人的妈和别人的孩子看得比自己的命还重，",
      "token_start": 635,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 195740,
      "end_ms": 196660,
      "text": "给孕妇听。",
      "token_start": 660,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 196740,
      "end_ms": 197380,
      "text": "胎心前，",
      "token_start": 664,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 197800,
      "end_ms": 201140,
      "text": "她总先把冰凉的听诊器贴在自己手，",
      "token_start": 667,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 201140,
      "end_ms": 201920,
      "text": "心里捂热。",
      "token_start": 682,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 202600,
      "end_ms": 204200,
      "text": "孕妇已经在受罪了，",
      "token_start": 686,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 204620,
      "end_ms": 207060,
      "text": "能少一点粮就少一点粮。",
      "token_start": 694,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 207700,
      "end_ms": 209400,
      "text": "产妇疼的喊破嗓子，",
      "token_start": 704,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 209920,
      "end_ms": 211630,
      "text": "别的医生手足无措。",
      "token_start": 712,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 212450,
      "end_ms": 213250,
      "text": "她走过去，",
      "token_start": 720,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 213550,
      "end_ms": 214150,
      "text": "摸摸头，",
      "token_start": 724,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 214390,
      "end_ms": 215050,
      "text": "摸摸手，",
      "token_start": 727,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 215850,
      "end_ms": 217510,
      "text": "产妇立马就安静了，",
      "token_start": 730,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 217890,
      "end_ms": 219070,
      "text": "有人托关系，",
      "token_start": 738,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 219510,
      "end_ms": 221210,
      "text": "想让他给领导插个队。",
      "token_start": 743,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 221530,
      "end_ms": 223130,
      "text": "他一句话怼回去，",
      "token_start": 752,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 225010,
      "end_ms": 227190,
      "text": "我这里没有什么特殊的病人，",
      "token_start": 759,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 227550,
      "end_ms": 229890,
      "text": "医生面前人人平等。",
      "token_start": 771,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 230190,
      "end_ms": 231210,
      "text": "一九四一年，",
      "token_start": 779,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 231250,
      "end_ms": 232710,
      "text": "太平洋战争爆发，",
      "token_start": 784,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 233130,
      "end_ms": 234370,
      "text": "协和医院关了门。",
      "token_start": 791,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 235030,
      "end_ms": 237670,
      "text": "他就在东堂子胡同开了间小诊所，",
      "token_start": 798,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 238110,
      "end_ms": 239110,
      "text": "穷人来看病，",
      "token_start": 812,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 239290,
      "end_ms": 240645,
      "text": "他不但不收钱，",
      "token_start": 817,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 240920,
      "end_ms": 243055,
      "text": "还从自己积蓄里往外逃，",
      "token_start": 823,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 243490,
      "end_ms": 245955,
      "text": "给产妇买鸡蛋、买红糖。",
      "token_start": 833,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 246750,
      "end_ms": 248170,
      "text": "兵荒马乱的年月，",
      "token_start": 842,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 248430,
      "end_ms": 250135,
      "text": "他心里只有一个念头，",
      "token_start": 849,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 250620,
      "end_ms": 252325,
      "text": "大人孩子能活下来，",
      "token_start": 858,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 252870,
      "end_ms": 253925,
      "text": "比什么都强。",
      "token_start": 866,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 254690,
      "end_ms": 255675,
      "text": "一九六二年，",
      "token_start": 871,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 255990,
      "end_ms": 257915,
      "text": "一个新生儿全身发黄，",
      "token_start": 876,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 258290,
      "end_ms": 260070,
      "text": "国内从没治过这种病，",
      "token_start": 885,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 260090,
      "end_ms": 261605,
      "text": "家属都快放弃了。",
      "token_start": 894,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 262340,
      "end_ms": 264680,
      "text": "同事劝他别结他，",
      "token_start": 901,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 264680,
      "end_ms": 268505,
      "text": "转头去翻遍外文资料，",
      "token_start": 908,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 269100,
      "end_ms": 271485,
      "text": "找到脐带换血的办法，",
      "token_start": 917,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 272230,
      "end_ms": 273435,
      "text": "一次次失败，",
      "token_start": 926,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 273950,
      "end_ms": 275205,
      "text": "一次次重来，",
      "token_start": 931,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 276040,
      "end_ms": 277895,
      "text": "直到孩子哭出第一声。",
      "token_start": 936,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 278530,
      "end_ms": 282685,
      "text": "那是中国第一例被救回来的新生儿溶血症患儿，",
      "token_start": 945,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 283500,
      "end_ms": 286660,
      "text": "他守的从来不是名声使命。",
      "token_start": 965,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 287650,
      "end_ms": 289435,
      "text": "一九八三年他走了，",
      "token_start": 976,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 290520,
      "end_ms": 291485,
      "text": "弥留之际，",
      "token_start": 984,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 292230,
      "end_ms": 296525,
      "text": "他嘴里断断续续喊的是快快拿产钱来，",
      "token_start": 988,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 296930,
      "end_ms": 299385,
      "text": "这是他留给这个世界的最后一句话。",
      "token_start": 1004,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 299810,
      "end_ms": 302125,
      "text": "他留下遗嘱三万元积蓄，",
      "token_start": 1019,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 302640,
      "end_ms": 304175,
      "text": "全部捐给幼儿园。",
      "token_start": 1029,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 305180,
      "end_ms": 308620,
      "text": "托儿所遗体捐给医学院做研究，",
      "token_start": 1036,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 309680,
      "end_ms": 311500,
      "text": "骨灰洒回故乡。",
      "token_start": 1049,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 311540,
      "end_ms": 312640,
      "text": "鼓浪屿的海面，",
      "token_start": 1055,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 313560,
      "end_ms": 314240,
      "text": "他走了，",
      "token_start": 1061,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 315760,
      "end_ms": 317420,
      "text": "什么都没带走房，",
      "token_start": 1064,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 317700,
      "end_ms": 319620,
      "text": "没有钱，",
      "token_start": 1071,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 319720,
      "end_ms": 321440,
      "text": "没有孩子没有，",
      "token_start": 1074,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 321860,
      "end_ms": 322760,
      "text": "可您数数，",
      "token_start": 1080,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 322780,
      "end_ms": 323880,
      "text": "他留下了什么？",
      "token_start": 1084,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 324060,
      "end_ms": 325260,
      "text": "五万多个孩子，",
      "token_start": 1090,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 325420,
      "end_ms": 327000,
      "text": "五万多个家庭的圆满，",
      "token_start": 1096,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 327320,
      "end_ms": 329980,
      "text": "还有千千万万中国人欠他的一声，",
      "token_start": 1105,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 329980,
      "end_ms": 334240,
      "text": "谢谢您说他这辈子还不值，",
      "token_start": 1119,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 334540,
      "end_ms": 336650,
      "text": "有人人用钱衡量一辈子，",
      "token_start": 1130,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 336830,
      "end_ms": 338810,
      "text": "有人用房衡量一辈子。",
      "token_start": 1140,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 338870,
      "end_ms": 344670,
      "text": "而他呢他用五万多个新生儿的鲜活生命衡量了自己的一生。",
      "token_start": 1149,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 345310,
      "end_ms": 346410,
      "text": "人这一辈子，",
      "token_start": 1174,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 346650,
      "end_ms": 347670,
      "text": "到底图什么？",
      "token_start": 1179,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 347870,
      "end_ms": 349390,
      "text": "不是图有多少房，",
      "token_start": 1184,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 349670,
      "end_ms": 350350,
      "text": "多少钱，",
      "token_start": 1191,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 350770,
      "end_ms": 351730,
      "text": "多少名声，",
      "token_start": 1194,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 352270,
      "end_ms": 353710,
      "text": "是图到死那天，",
      "token_start": 1198,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 354210,
      "end_ms": 355870,
      "text": "心里还惦记着别人，",
      "token_start": 1204,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 356170,
      "end_ms": 357590,
      "text": "还放不下手里的活。",
      "token_start": 1212,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 358210,
      "end_ms": 360770,
      "text": "他临走前惦记的是产前，",
      "token_start": 1220,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 361270,
      "end_ms": 362030,
      "text": "是产妇，",
      "token_start": 1230,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 362490,
      "end_ms": 364575,
      "text": "是那些还没出生的小生命，",
      "token_start": 1233,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 365210,
      "end_ms": 369225,
      "text": "这样的人才叫真正的不虚此生。",
      "token_start": 1244,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 369500,
      "end_ms": 374540,
      "text": "林巧智是我们国之脊梁系列中的其中一位，",
      "token_start": 1257,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 374640,
      "end_ms": 377485,
      "text": "可国之脊梁却不止这一位。",
      "token_start": 1275,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 378470,
      "end_ms": 382045,
      "text": "钱学森、袁隆平、邓稼先等等，",
      "token_start": 1286,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 382350,
      "end_ms": 385015,
      "text": "下一个您想听谁？",
      "token_start": 1297,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 385350,
      "end_ms": 386375,
      "text": "评论区告诉我，",
      "token_start": 1304,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 386830,
      "end_ms": 389205,
      "text": "如果这段历史故事触动到了您，",
      "token_start": 1310,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 389760,
      "end_ms": 391005,
      "text": "点亮红心，",
      "token_start": 1323,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 391440,
      "end_ms": 392345,
      "text": "收藏起来，",
      "token_start": 1327,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 392670,
      "end_ms": 393985,
      "text": "转发给更多人，",
      "token_start": 1331,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 394710,
      "end_ms": 399165,
      "text": "让这些把医生都献给中国发展建设事业的人，",
      "token_start": 1337,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 399530,
      "end_ms": 401305,
      "text": "被更多中国人记住，",
      "token_start": 1356,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 402560,
      "end_ms": 405875,
      "text": "关注我国之脊梁的故事。",
      "token_start": 1364,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 406400,
      "end_ms": 407095,
      "text": "咱们接着讲。",
      "token_start": 1374,
      "token_end_exclusive": 1379
    }
  ],
