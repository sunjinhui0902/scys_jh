      "token_end_exclusive": 2553
    },
    {
      "start_ms": 509960,
      "end_ms": 512465,
      "text": "而是天才出现了却没有人认出他。",
      "token_start": 2553,
      "token_end_exclusive": 2567
    },
    {
      "start_ms": 512820,
      "end_ms": 514400,
      "text": "我们中国不缺千里马，",
