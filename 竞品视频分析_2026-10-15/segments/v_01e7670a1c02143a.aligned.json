{
  "video_id": "v_01e7670a1c02143a",
  "duration_s": 528.128,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_01e7670a1c02143a.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_01e7670a1c02143a.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 570,
      "end_ms": 950,
      "text": "周军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1370,
      "end_ms": 2190,
      "text": "你能想象吗？",
      "token_start": 2,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2430,
      "end_ms": 4410,
      "text": "这里只有六十万人口的小城，",
      "token_start": 7,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4590,
      "end_ms": 6450,
      "text": "却飞下了八十多座大学，",
      "token_start": 19,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6710,
      "end_ms": 10630,
      "text": "聚集了哈佛大学、麻什、理工、伯克利音乐学院等等顶尖强校，",
      "token_start": 29,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 11070,
      "end_ms": 12010,
      "text": "蓝星之上，",
      "token_start": 53,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 12070,
      "end_ms": 13270,
      "text": "谁能压他一头？",
      "token_start": 57,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 13830,
      "end_ms": 16670,
      "text": "今天带你走进美国的发源地波士顿，",
      "token_start": 63,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 17170,
      "end_ms": 20030,
      "text": "一个并不产波士顿龙虾的城市朱军，",
      "token_start": 78,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 20270,
      "end_ms": 20990,
      "text": "你相信吗？",
      "token_start": 93,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 21130,
      "end_ms": 23670,
      "text": "实际上并没有什么人才被外国给挖走。",
      "token_start": 97,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 23910,
      "end_ms": 25050,
      "text": "因为在出去之前，",
      "token_start": 113,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 25050,
      "end_ms": 26430,
      "text": "他们并不认为是人才，",
      "token_start": 120,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 26630,
      "end_ms": 31200,
      "text": "而波士顿这个小城就吸引了全世界各地的怪才奇才，",
      "token_start": 129,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 31380,
      "end_ms": 32380,
      "text": "培养成人才。",
      "token_start": 151,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 33160,
      "end_ms": 34900,
      "text": "地处美国东北部的波士顿，",
      "token_start": 156,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 34980,
      "end_ms": 36280,
      "text": "位于马萨诸塞州，",
      "token_start": 167,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 36380,
      "end_ms": 38800,
      "text": "简称麻省优良的海港，",
      "token_start": 174,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 38800,
      "end_ms": 41720,
      "text": "让它成为早期欧洲移民登陆北美的重要据点。",
      "token_start": 183,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 41920,
      "end_ms": 42800,
      "text": "一七七三年，",
      "token_start": 202,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 42880,
      "end_ms": 45840,
      "text": "当地人把英国佬的整船茶叶倒进港口，",
      "token_start": 207,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 45920,
      "end_ms": 48300,
      "text": "就是著名的波士顿清茶事件。",
      "token_start": 223,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 48620,
      "end_ms": 49120,
      "text": "可以说，",
      "token_start": 235,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 49300,
      "end_ms": 50300,
      "text": "如果没有波士顿，",
      "token_start": 238,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 50300,
      "end_ms": 51940,
      "text": "就没有后来的美国独立，",
      "token_start": 245,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 52180,
      "end_ms": 54040,
      "text": "而那些倒进海底的茶叶，",
      "token_start": 255,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 54120,
      "end_ms": 55600,
      "text": "都是中国福建人，",
      "token_start": 265,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 55700,
      "end_ms": 56980,
      "text": "闽商卖到欧洲。",
      "token_start": 272,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 56980,
      "end_ms": 58540,
      "text": "去的这一点上来说，",
      "token_start": 278,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 58660,
      "end_ms": 60715,
      "text": "美国人都应该感谢一下福建人。",
      "token_start": 286,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 61030,
      "end_ms": 62890,
      "text": "都说全世界都怕美国人，",
      "token_start": 299,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 62890,
      "end_ms": 64755,
      "text": "但美国人怕福建人。",
      "token_start": 309,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 65100,
      "end_ms": 65680,
      "text": "在美国，",
      "token_start": 317,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 65800,
      "end_ms": 68555,
      "text": "你只要会说福建话基本上横着走。",
      "token_start": 320,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 68960,
      "end_ms": 71635,
      "text": "波士顿的市长竟然也是一位华裔女性，",
      "token_start": 334,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 72030,
      "end_ms": 74050,
      "text": "当你还在纠结要不要出省时，",
      "token_start": 350,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 74270,
      "end_ms": 76050,
      "text": "福建人已经在非洲开矿，",
      "token_start": 362,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 76170,
      "end_ms": 77155,
      "text": "纽约开超市，",
      "token_start": 372,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 77400,
      "end_ms": 79405,
      "text": "把沙县小吃开到了迪拜。",
      "token_start": 377,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 80130,
      "end_ms": 80950,
      "text": "最近这几天，",
      "token_start": 387,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 80970,
      "end_ms": 83150,
      "text": "查尔斯河的两岸落叶纷飞，",
      "token_start": 392,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 83410,
      "end_ms": 85775,
      "text": "秋天的波士顿迎来了它最美的季节，",
      "token_start": 403,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 86030,
      "end_ms": 91550,
      "text": "很多游客到这里都会去摸约翰哈佛铜像的左脚传说摸了会带来好运，",
      "token_start": 418,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 91650,
      "end_ms": 92515,
      "text": "考上名校，",
      "token_start": 447,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 93120,
      "end_ms": 94660,
      "text": "再去麻省理工逛一逛，",
      "token_start": 451,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 94760,
      "end_ms": 97465,
      "text": "连围墙都没有的大学完全敞开。",
      "token_start": 460,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 97870,
      "end_ms": 100170,
      "text": "波士顿是美国治安最安全的地方。",
      "token_start": 473,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 100290,
      "end_ms": 102370,
      "text": "总给人一种老钱安静，",
      "token_start": 487,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 102590,
      "end_ms": 103210,
      "text": "有文化，",
      "token_start": 496,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 103350,
      "end_ms": 104865,
      "text": "甚至有点保守的感觉。",
      "token_start": 499,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 105370,
      "end_ms": 109550,
      "text": "而波士顿简直就是美国版的海淀区高房价卷，",
      "token_start": 508,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 109550,
      "end_ms": 110790,
      "text": "教育大学多，",
      "token_start": 527,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 110870,
      "end_ms": 111995,
      "text": "而大厂也多。",
      "token_start": 532,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 112690,
      "end_ms": 116135,
      "text": "如今现在向你招手的就是世界排名第一的大学。",
      "token_start": 537,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 116450,
      "end_ms": 120370,
      "text": "麻省理工学院我小时候呢只知道两个英文缩写，",
      "token_start": 557,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 120430,
      "end_ms": 121610,
      "text": "一个是KFC,",
      "token_start": 577,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 121710,
      "end_ms": 126535,
      "text": "一个就是MIT.你知道麻省理工本科的含金量有多高吗？",
      "token_start": 581,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 126940,
      "end_ms": 128600,
      "text": "都说你是数学界的天才，",
      "token_start": 603,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 128720,
      "end_ms": 130600,
      "text": "可这里面人人都是天才。",
      "token_start": 613,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 130840,
      "end_ms": 133305,
      "text": "这里汇聚了全世界最聪明的一群人。",
      "token_start": 623,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 133790,
      "end_ms": 138580,
      "text": "麻省理工最强的专业电子工程和计算机科学作为王牌中的王牌，",
      "token_start": 638,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 138580,
      "end_ms": 139545,
      "text": "他到底有多强？",
      "token_start": 665,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 139890,
      "end_ms": 141710,
      "text": "从芯片设计到人工智能，",
      "token_start": 671,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 141790,
      "end_ms": 143885,
      "text": "从量子计算到机器人技术，",
      "token_start": 681,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 144100,
      "end_ms": 146825,
      "text": "他的每一项研究都站在世界的最前沿。",
      "token_start": 692,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 147360,
      "end_ms": 154795,
      "text": " Mit走出过一百零四位诺贝尔奖得主、两百八十七位美国科学院院士和七百一十一名工程院院士。",
      "token_start": 708,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 155070,
      "end_ms": 156230,
      "text": "画面的磁性储存，",
      "token_start": 748,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 156290,
      "end_ms": 160095,
      "text": "使得电脑成为可能首次完成青霉素的化学合成，",
      "token_start": 755,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 160430,
      "end_ms": 162595,
      "text": "创造了全人类的基因图的方法。",
      "token_start": 775,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 162920,
      "end_ms": 163560,
      "text": "二战期间，",
      "token_start": 788,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 163560,
      "end_ms": 164840,
      "text": "主导雷达技术开发，",
      "token_start": 792,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 164840,
      "end_ms": 166385,
      "text": "直接助力盟军获胜，",
      "token_start": 800,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 166730,
      "end_ms": 169925,
      "text": "研发出了世界上第一个有人类感情的机器人，",
      "token_start": 808,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 170300,
      "end_ms": 172535,
      "text": "捕捉到第一张黑洞直接图像。",
      "token_start": 827,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 172810,
      "end_ms": 175245,
      "text": "第一次探测到直达地球的引力波，",
      "token_start": 839,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 175690,
      "end_ms": 177410,
      "text": "这里没有传统的分数思维，",
      "token_start": 853,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 177410,
      "end_ms": 180885,
      "text": "只有疯狂的实验颠覆了想法、解决问题的勇气。",
      "token_start": 864,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 181340,
      "end_ms": 185770,
      "text": "你的校友将包括理查德、费曼、杜兹峰、美国阿波罗登月计划，",
      "token_start": 883,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 185770,
      "end_ms": 188825,
      "text": "大量的宇航员和工程师都是MRT的学生，",
      "token_start": 907,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 189190,
      "end_ms": 191695,
      "text": "麻省理工的校训是知行合一，",
      "token_start": 923,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 192320,
      "end_ms": 195700,
      "text": "从这里走出了第一个获得麻省理工博士学位的中国人。",
      "token_start": 935,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 195800,
      "end_ms": 196775,
      "text": "顾玉秀先生，",
      "token_start": 958,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 197080,
      "end_ms": 199100,
      "text": "他一手创办三座顶尖大学，",
      "token_start": 963,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 199100,
      "end_ms": 200320,
      "text": "培养几百位院士，",
      "token_start": 974,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 200340,
      "end_ms": 201735,
      "text": "被誉为一代国师。",
      "token_start": 981,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 201990,
      "end_ms": 204950,
      "text": "顾玉秀的学生更是一位改变中国国运的人。",
      "token_start": 988,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 205070,
      "end_ms": 208590,
      "text": "钱学森、清华毕业之后来到美国麻省理工，",
      "token_start": 1006,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 208790,
      "end_ms": 213705,
      "text": "他在几十年前就预言了AI人工智能、新能源汽车等等新科技的普及，",
      "token_start": 1023,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 214180,
      "end_ms": 216775,
      "text": "但是钱学森在美国却遭到了软禁，",
      "token_start": 1051,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 217150,
      "end_ms": 218390,
      "text": "同样排除万难，",
      "token_start": 1065,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 218390,
      "end_ms": 226185,
      "text": "回国的还有从麻省理工毕业的女学生谢西德复旦大学校长、新中国第一位综合性大学的女性校长。",
      "token_start": 1071,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 226700,
      "end_ms": 228500,
      "text": "现在麻省理工录取的中国学生，",
      "token_start": 1112,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 228500,
      "end_ms": 234005,
      "text": "每一年大概只有十到十五人我认识的一位前辈张朝阳就是MIT毕业的。",
      "token_start": 1125,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 234260,
      "end_ms": 236005,
      "text": "当你收到录取通知的那一刻，",
      "token_start": 1154,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 236340,
      "end_ms": 238715,
      "text": "同学人类的未来就交给你。",
      "token_start": 1166,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 239570,
      "end_ms": 241815,
      "text": "麻省理工旁边就是哈佛大学，",
      "token_start": 1177,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 242090,
      "end_ms": 246350,
      "text": "走出了一百六十多位诺贝尔奖得主、富兰克林罗斯福、奥巴马等等。",
      "token_start": 1189,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 246350,
      "end_ms": 250875,
      "text": "八位美国总统比尔盖茨、扎克伯格等都在这里赚到第一桶金。",
      "token_start": 1216,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 251200,
      "end_ms": 254265,
      "text": "杨振宁、邱神童等大师都曾在哈佛任教，",
      "token_start": 1241,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 254710,
      "end_ms": 255590,
      "text": "一八七九年，",
      "token_start": 1257,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 255610,
      "end_ms": 258370,
      "text": "一位叫歌坤画的宁波学者来到波士顿，",
      "token_start": 1262,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 258550,
      "end_ms": 260805,
      "text": "成为第一位在哈佛任教的中国人。",
      "token_start": 1278,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 261110,
      "end_ms": 265625,
      "text": "他从中国带来的书成为哈佛最早的一批亚洲语言研究藏书，",
      "token_start": 1292,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 265950,
      "end_ms": 266990,
      "text": "后来不断扩充，",
      "token_start": 1317,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 267030,
      "end_ms": 267730,
      "text": "最终形成。",
      "token_start": 1323,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 267730,
      "end_ms": 268110,
      "text": "今天，",
      "token_start": 1327,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 268110,
      "end_ms": 270225,
      "text": "著名的哈佛燕京图书馆，",
      "token_start": 1329,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 270550,
      "end_ms": 272635,
      "text": "现在已经拥有约百万车的灌舱，",
      "token_start": 1339,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 272930,
      "end_ms": 273930,
      "text": "是除了中国之外，",
      "token_start": 1352,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 273930,
      "end_ms": 275170,
      "text": "全球最大的研究。",
      "token_start": 1359,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 275170,
      "end_ms": 279410,
      "text": "东亚的学术图书馆从哈佛的校园里走出了三百年，",
      "token_start": 1366,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 279410,
      "end_ms": 280510,
      "text": "才出一位的天才。",
      "token_start": 1387,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 280650,
      "end_ms": 284630,
      "text": "陈寅雀把现代气象学带回中国的人逐可珍。",
      "token_start": 1394,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 284890,
      "end_ms": 289050,
      "text": "中国现代考古学之父李记梁启超之子，",
      "token_start": 1412,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 289110,
      "end_ms": 291475,
      "text": "从哈佛带回现代考古学的梁思勇。",
      "token_start": 1428,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 291930,
      "end_ms": 300010,
      "text": "清华国学研究院的创办人吴幂、华人之光建筑大师、贝聿铭华裔物理学家、诺贝尔物理学奖得主丁兆忠，",
      "token_start": 1442,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 300230,
      "end_ms": 303230,
      "text": "中国现代学术史上最令人仰望的一些群星，",
      "token_start": 1484,
      "token_end_exclusive": 1502
    },
    {
      "start_ms": 303410,
      "end_ms": 305690,
      "text": "都曾经坐在波士顿的课堂里，",
      "token_start": 1502,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 305990,
      "end_ms": 306990,
      "text": "过去的一百多年，",
      "token_start": 1514,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 307110,
      "end_ms": 310110,
      "text": "世界各地最聪明的年轻人陆续来到这里，",
      "token_start": 1521,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 310170,
      "end_ms": 312810,
      "text": "然后又把知识带回自己的祖国。",
      "token_start": 1538,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 313230,
      "end_ms": 314650,
      "text": "有些城市输出商品，",
      "token_start": 1551,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 314810,
      "end_ms": 316270,
      "text": "有些城市输出资本，",
      "token_start": 1559,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 316330,
      "end_ms": 320770,
      "text": "而波士顿向世界输出的一代又一代改变自己国家的人。",
      "token_start": 1567,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 321150,
      "end_ms": 323900,
      "text": "现在波士顿最强的就是生命科学技术，",
      "token_start": 1590,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 323980,
      "end_ms": 325280,
      "text": "尤其是基因编辑，",
      "token_start": 1606,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 325340,
      "end_ms": 327140,
      "text": "生物技术和未来医学。",
      "token_start": 1613,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 327200,
      "end_ms": 328220,
      "text": "在肯德尔广场，",
      "token_start": 1622,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 328320,
      "end_ms": 331260,
      "text": "每平方公里聚集着超百家的生物企业，",
      "token_start": 1628,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 331540,
      "end_ms": 334680,
      "text": "全球前二十的顶尖制药公司都在这里扎堆，",
      "token_start": 1644,
      "token_end_exclusive": 1662
    },
    {
      "start_ms": 335060,
      "end_ms": 339040,
      "text": "全球十大药企巨头六家的研发中心都在波士顿。",
      "token_start": 1662,
      "token_end_exclusive": 1682
    },
    {
      "start_ms": 339220,
      "end_ms": 341920,
      "text": "而这就是进化的可怕的波士顿机器人，",
      "token_start": 1682,
      "token_end_exclusive": 1698
    },
    {
      "start_ms": 342120,
      "end_ms": 345020,
      "text": "你眼里的机器人是不是还是一个遥控的大玩具，",
      "token_start": 1698,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 345180,
      "end_ms": 347060,
      "text": "只会空翻跳舞和跑步。",
      "token_start": 1718,
      "token_end_exclusive": 1727
    },
    {
      "start_ms": 347300,
      "end_ms": 350920,
      "text": "但是波士顿动力公司的机器人是真的在和人类抢饭碗。",
      "token_start": 1727,
      "token_end_exclusive": 1750
    },
    {
      "start_ms": 350920,
      "end_ms": 352720,
      "text": "而朱军你知道吗？",
      "token_start": 1750,
      "token_end_exclusive": 1757
    },
    {
      "start_ms": 352800,
      "end_ms": 354720,
      "text": "波士顿不光理科生能打，",
      "token_start": 1757,
      "token_end_exclusive": 1767
    },
    {
      "start_ms": 354740,
      "end_ms": 356525,
      "text": "文科生更是神仙打架。",
      "token_start": 1767,
      "token_end_exclusive": 1776
    },
    {
      "start_ms": 356980,
      "end_ms": 358580,
      "text": "梭罗就是在此隐居，",
      "token_start": 1776,
      "token_end_exclusive": 1784
    },
    {
      "start_ms": 358660,
      "end_ms": 360595,
      "text": "写出了著名的瓦尔登湖。",
      "token_start": 1784,
      "token_end_exclusive": 1794
    },
    {
      "start_ms": 360890,
      "end_ms": 363175,
      "text": "而那片瓦尔登湖就在波士顿的郊区，",
      "token_start": 1794,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 363660,
      "end_ms": 367345,
      "text": "马丁路德金在波士顿大学点燃了民权运动的火种，",
      "token_start": 1809,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 367680,
      "end_ms": 370035,
      "text": "海伦凯勒的名字从这里传遍世界，",
      "token_start": 1830,
      "token_end_exclusive": 1844
    },
    {
      "start_ms": 370560,
      "end_ms": 375430,
      "text": "阿尔克特的小妇人祸上了红字艾伦坡的乌鸦都和这片土地有关。",
      "token_start": 1844,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 375570,
      "end_ms": 378570,
      "text": "美国第一条地铁一八九七年在波士顿开通。",
      "token_start": 1871,
      "token_end_exclusive": 1889
    },
    {
      "start_ms": 378810,
      "end_ms": 381695,
      "text": "美国历史上很多的第一次都发生在波士顿，",
      "token_start": 1889,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 381940,
      "end_ms": 383985,
      "text": "它更像美国的一点零版本。",
      "token_start": 1907,
      "token_end_exclusive": 1918
    },
    {
      "start_ms": 384340,
      "end_ms": 385880,
      "text": "最近来到波士顿，",
      "token_start": 1918,
      "token_end_exclusive": 1925
    },
    {
      "start_ms": 385940,
      "end_ms": 388695,
      "text": "我才体会到什么叫真正的波士顿优越感。",
      "token_start": 1925,
      "token_end_exclusive": 1942
    },
    {
      "start_ms": 389020,
      "end_ms": 390685,
      "text": "作为美国最英式的城市，",
      "token_start": 1942,
      "token_end_exclusive": 1952
    },
    {
      "start_ms": 391000,
      "end_ms": 392445,
      "text": "美国精神的发源地，",
      "token_start": 1952,
      "token_end_exclusive": 1960
    },
    {
      "start_ms": 392820,
      "end_ms": 395020,
      "text": "这里的人既有老钱贵族的骄傲，",
      "token_start": 1960,
      "token_end_exclusive": 1973
    },
    {
      "start_ms": 395040,
      "end_ms": 396620,
      "text": "又有知识新贵的自信。",
      "token_start": 1973,
      "token_end_exclusive": 1982
    },
    {
      "start_ms": 396800,
      "end_ms": 398460,
      "text": "但人家骄傲有骄傲的资本，",
      "token_start": 1982,
      "token_end_exclusive": 1993
    },
    {
      "start_ms": 398520,
      "end_ms": 401105,
      "text": "毕竟美国人当年就是从这里发家的。",
      "token_start": 1993,
      "token_end_exclusive": 2008
    },
    {
      "start_ms": 401860,
      "end_ms": 403540,
      "text": "我身后的建筑就是波士顿。",
      "token_start": 2008,
      "token_end_exclusive": 2019
    },
    {
      "start_ms": 403540,
      "end_ms": 407370,
      "text": "公共图书馆是全美第一座允许普通市民借阅书籍，",
      "token_start": 2019,
      "token_end_exclusive": 2040
    },
    {
      "start_ms": 407370,
      "end_ms": 409635,
      "text": "并且允许他们带回家阅读的图书馆，",
      "token_start": 2040,
      "token_end_exclusive": 2055
    },
    {
      "start_ms": 409950,
      "end_ms": 412885,
      "text": "充分体现波士顿市民对知识和教育的重视。",
      "token_start": 2055,
      "token_end_exclusive": 2073
    },
    {
      "start_ms": 413160,
      "end_ms": 418565,
      "text": "图书馆的建筑风格融合的意大利文艺复兴和法国古典元素本身即是一件艺术品。",
      "token_start": 2073,
      "token_end_exclusive": 2107
    },
    {
      "start_ms": 418980,
      "end_ms": 420220,
      "text": "在波士顿美术馆里，",
      "token_start": 2107,
      "token_end_exclusive": 2115
    },
    {
      "start_ms": 420240,
      "end_ms": 428505,
      "text": "还收藏着中国大量的明代瓷器、宋元书画和雕塑里面陈列的辽代木雕水月观音更是巅峰之作。",
      "token_start": 2115,
      "token_end_exclusive": 2154
    },
    {
      "start_ms": 429200,
      "end_ms": 431640,
      "text": "特展时还有阎厉本的历代帝王图，",
      "token_start": 2154,
      "token_end_exclusive": 2168
    },
    {
      "start_ms": 431860,
      "end_ms": 434015,
      "text": "以及宋徽宗的五色鹦鹉图。",
      "token_start": 2168,
      "token_end_exclusive": 2179
    },
    {
      "start_ms": 434290,
      "end_ms": 436410,
      "text": "波士顿还有个名字叫冠军之城，",
      "token_start": 2179,
      "token_end_exclusive": 2192
    },
    {
      "start_ms": 436530,
      "end_ms": 438885,
      "text": "因为人家四大球类全都是冠军。",
      "token_start": 2192,
      "token_end_exclusive": 2205
    },
    {
      "start_ms": 439270,
      "end_ms": 439810,
      "text": "打篮球，",
      "token_start": 2205,
      "token_end_exclusive": 2208
    },
    {
      "start_ms": 440010,
      "end_ms": 442350,
      "text": "凯尔特人拿了十八次NBA总冠军，",
      "token_start": 2208,
      "token_end_exclusive": 2221
    },
    {
      "start_ms": 442550,
      "end_ms": 446770,
      "text": "玩棒球红袜队拿过九次世界冠军打橄榄球，",
      "token_start": 2221,
      "token_end_exclusive": 2239
    },
    {
      "start_ms": 446850,
      "end_ms": 449880,
      "text": "爱国者队拿过六座超级碗冰球领域，",
      "token_start": 2239,
      "token_end_exclusive": 2254
    },
    {
      "start_ms": 449920,
      "end_ms": 452215,
      "text": "棕熊队暴走过六座斯坦利杯。",
      "token_start": 2254,
      "token_end_exclusive": 2266
    },
    {
      "start_ms": 452580,
      "end_ms": 456575,
      "text": "今天我在波士顿吃了一顿地道的波士顿龙虾和龙虾汉堡。",
      "token_start": 2266,
      "token_end_exclusive": 2290
    },
    {
      "start_ms": 456860,
      "end_ms": 457845,
      "text": "但值得一提的是，",
      "token_start": 2290,
      "token_end_exclusive": 2297
    },
    {
      "start_ms": 458200,
      "end_ms": 461605,
      "text": "波士顿龙虾实际上主要产地并不在波士顿，",
      "token_start": 2297,
      "token_end_exclusive": 2315
    },
    {
      "start_ms": 461810,
      "end_ms": 463345,
      "text": "而是在隔壁的缅英州。",
      "token_start": 2315,
      "token_end_exclusive": 2324
    },
    {
      "start_ms": 463680,
      "end_ms": 465095,
      "text": "之所以叫波士顿龙虾，",
      "token_start": 2324,
      "token_end_exclusive": 2333
    },
    {
      "start_ms": 465300,
      "end_ms": 468005,
      "text": "是因为波士顿是龙虾贸易的中转港口。",
      "token_start": 2333,
      "token_end_exclusive": 2349
    },
    {
      "start_ms": 468470,
      "end_ms": 472770,
      "text": "周星这几天我在美国访学接触了一批杰出的教授和学生。",
      "token_start": 2349,
      "token_end_exclusive": 2373
    },
    {
      "start_ms": 472930,
      "end_ms": 475765,
      "text": "我发现走到金字塔尖儿顶的他们，",
      "token_start": 2373,
      "token_end_exclusive": 2387
    },
    {
      "start_ms": 475970,
      "end_ms": 477230,
      "text": "拼的早已不是智商，",
      "token_start": 2387,
      "token_end_exclusive": 2395
    },
    {
      "start_ms": 477370,
      "end_ms": 478315,
      "text": "而是圈子。",
      "token_start": 2395,
      "token_end_exclusive": 2399
    },
    {
      "start_ms": 478830,
      "end_ms": 479570,
      "text": "巴菲特说，",
      "token_start": 2399,
      "token_end_exclusive": 2403
    },
    {
      "start_ms": 479830,
      "end_ms": 482475,
      "text": "你和最长交往的五个人的平均值，",
      "token_start": 2403,
      "token_end_exclusive": 2417
    },
    {
      "start_ms": 482750,
      "end_ms": 485760,
      "text": "就是你物理学有个词儿叫临界质量，",
      "token_start": 2417,
      "token_end_exclusive": 2432
    },
    {
      "start_ms": 485780,
      "end_ms": 488610,
      "text": "意思是一颗原子自己发生变化的时候，",
      "token_start": 2432,
      "token_end_exclusive": 2448
    },
    {
      "start_ms": 488610,
      "end_ms": 489695,
      "text": "闹不出多大动静，",
      "token_start": 2448,
      "token_end_exclusive": 2455
    },
    {
      "start_ms": 489990,
      "end_ms": 491885,
      "text": "可是周围挤满了同样的原子。",
      "token_start": 2455,
      "token_end_exclusive": 2467
    },
    {
      "start_ms": 492160,
      "end_ms": 493700,
      "text": "当数量多到一定程度，",
      "token_start": 2467,
      "token_end_exclusive": 2476
    },
    {
      "start_ms": 493700,
      "end_ms": 495555,
      "text": "原子们就会冲破临界点，",
      "token_start": 2476,
      "token_end_exclusive": 2486
    },
    {
      "start_ms": 495820,
      "end_ms": 498225,
      "text": "发生质变人也是一样的。",
      "token_start": 2486,
      "token_end_exclusive": 2496
    },
    {
      "start_ms": 498420,
      "end_ms": 499180,
      "text": "当天才，",
      "token_start": 2496,
      "token_end_exclusive": 2499
    },
    {
      "start_ms": 499340,
      "end_ms": 501980,
      "text": "知识和资源密度高到一定程度，",
      "token_start": 2499,
      "token_end_exclusive": 2512
    },
    {
      "start_ms": 502080,
      "end_ms": 502500,
      "text": "创新，",
      "token_start": 2512,
      "token_end_exclusive": 2514
    },
    {
      "start_ms": 502660,
      "end_ms": 504785,
      "text": "就会像链士反应一样自然的发生，",
      "token_start": 2514,
      "token_end_exclusive": 2528
    },
    {
      "start_ms": 505050,
      "end_ms": 506825,
      "text": "这就是顶尖大学的魅力。",
      "token_start": 2528,
      "token_end_exclusive": 2538
    },
    {
      "start_ms": 507300,
      "end_ms": 508680,
      "text": "一个社会最大的浪费，",
      "token_start": 2538,
      "token_end_exclusive": 2547
    },
    {
      "start_ms": 508760,
      "end_ms": 509740,
      "text": "不是没有天才，",
