{
  "video_id": "v_6333be0a867d3d45",
  "duration_s": 426.597846,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_6333be0a867d3d45.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_6333be0a867d3d45.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 4590,
      "text": "您知道中国古代最有文人气的名亭是哪一座吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4950,
      "end_ms": 11710,
      "text": "有人说是醉翁亭欧阳修坐在那儿写出了醉翁之意不在酒，",
      "token_start": 20,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12290,
      "end_ms": 16450,
      "text": "一篇记文让他名传千古。",
      "token_start": 44,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 16810,
      "end_ms": 18230,
      "text": "有人说是爱晚停，",
      "token_start": 54,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 18650,
      "end_ms": 20570,
      "text": "停车坐爱枫林晚，",
      "token_start": 61,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 20590,
      "end_ms": 23390,
      "text": "霜叶红于二月花杜牧，",
      "token_start": 68,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 23390,
      "end_ms": 23970,
      "text": "那首诗，",
      "token_start": 77,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 24090,
      "end_ms": 25530,
      "text": "让多少人记住了他。",
      "token_start": 80,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 25770,
      "end_ms": 26010,
      "text": "错。",
      "token_start": 88,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 27010,
      "end_ms": 30780,
      "text": "醉翁亭和爱晚亭都进不了榜首，",
      "token_start": 89,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 31160,
      "end_ms": 33280,
      "text": "真正排在第一的那座，",
      "token_start": 102,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 33760,
      "end_ms": 36460,
      "text": "从来没有一个帝王为他题字，",
      "token_start": 111,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 36900,
      "end_ms": 41060,
      "text": "却让天下文人心甘情愿朝他低头。",
      "token_start": 123,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 41720,
      "end_ms": 46440,
      "text": "今天咱们就来盘点中国古代十大最有文人气的名亭。",
      "token_start": 137,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 46860,
      "end_ms": 47580,
      "text": "老规矩，",
      "token_start": 159,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 48320,
      "end_ms": 49160,
      "text": "开讲之前，",
      "token_start": 162,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 49160,
      "end_ms": 51360,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 166,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 52040,
      "end_ms": 53800,
      "text": "让我看看都是谁在听。",
      "token_start": 176,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 54140,
      "end_ms": 56200,
      "text": "第十名真趣亭。",
      "token_start": 185,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 57040,
      "end_ms": 59380,
      "text": "在江苏苏州的狮子林里，",
      "token_start": 191,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 60160,
      "end_ms": 61645,
      "text": "这座亭子很有意思。",
      "token_start": 201,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 62130,
      "end_ms": 65745,
      "text": "他原先是元代读书人清修静坐的地方，",
      "token_start": 209,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 66490,
      "end_ms": 68505,
      "text": "正面三间大开间，",
      "token_start": 225,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 69310,
      "end_ms": 71125,
      "text": "四脚微微翘起，",
      "token_start": 232,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 71640,
      "end_ms": 74365,
      "text": "三面全是镂空雕花木窗。",
      "token_start": 238,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 74770,
      "end_ms": 77415,
      "text": "当年乾隆皇帝六次下江南，",
      "token_start": 248,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 77890,
      "end_ms": 81845,
      "text": "逛到狮子林坐在亭子里看假山入了迷，",
      "token_start": 259,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 82420,
      "end_ms": 85555,
      "text": "提笔就想写下真有趣三个字。",
      "token_start": 275,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 85990,
      "end_ms": 89560,
      "text": "旁边的状元心里一急赶紧凑过去，",
      "token_start": 287,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 89600,
      "end_ms": 90835,
      "text": "委婉劝了一句，",
      "token_start": 301,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 91610,
      "end_ms": 94035,
      "text": "皇上这才把有字给划掉，",
      "token_start": 307,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 94630,
      "end_ms": 96955,
      "text": "留下了一块真去匾额。",
      "token_start": 317,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 97330,
      "end_ms": 100205,
      "text": "您坐在珍瞿亭的美人靠上往外瞧。",
      "token_start": 326,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 100830,
      "end_ms": 105025,
      "text": "怪石就像一群大大小小的狮子在扑腾，",
      "token_start": 340,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 105770,
      "end_ms": 107995,
      "text": "池水清的能见底，",
      "token_start": 356,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 108490,
      "end_ms": 109795,
      "text": "皇权再大，",
      "token_start": 363,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 110370,
      "end_ms": 113300,
      "text": "架子在足到了江南。",
      "token_start": 367,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 113400,
      "end_ms": 115505,
      "text": "这片秀气山水面前，",
      "token_start": 375,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 116170,
      "end_ms": 118205,
      "text": "也得乖乖收起脾气，",
      "token_start": 383,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 118590,
      "end_ms": 120135,
      "text": "跟着学一学斯文。",
      "token_start": 391,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 120970,
      "end_ms": 124130,
      "text": "您说这算不算苏州园林骨子里的一股子？",
      "token_start": 398,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 124130,
      "end_ms": 124674,
      "text": "巧劲，",
      "token_start": 415,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 125070,
      "end_ms": 127980,
      "text": "第九名出一台当地人，",
      "token_start": 417,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 127980,
      "end_ms": 129145,
      "text": "也叫他钓鱼台，",
      "token_start": 426,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 129560,
      "end_ms": 131985,
      "text": "就在扬州瘦西湖的正中央，",
      "token_start": 432,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 132770,
      "end_ms": 135005,
      "text": "他四面全被湖水包着，",
      "token_start": 443,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 135720,
      "end_ms": 139455,
      "text": "整座亭子稳稳立在青砖砌成的高台上面。",
      "token_start": 452,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 140180,
      "end_ms": 141775,
      "text": "台基横跨水面，",
      "token_start": 469,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 141990,
      "end_ms": 143425,
      "text": "有二三十步宽。",
      "token_start": 475,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 143870,
      "end_ms": 146745,
      "text": "听说早年间文人们常在这儿聚会，",
      "token_start": 481,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 147190,
      "end_ms": 148795,
      "text": "一边喝茶吹箫，",
      "token_start": 495,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 149180,
      "end_ms": 150635,
      "text": "一边弹琴玩乐，",
      "token_start": 501,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 151280,
      "end_ms": 155785,
      "text": "连乾隆皇帝下江南也在这儿坐着甩过鱼竿。",
      "token_start": 507,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 156210,
      "end_ms": 158370,
      "text": "您要是挑个细雨蒙蒙的天气，",
      "token_start": 525,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 158390,
      "end_ms": 159425,
      "text": "走进亭子里，",
      "token_start": 537,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 159750,
      "end_ms": 161385,
      "text": "顺着大圆洞往外看，",
      "token_start": 542,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 161680,
      "end_ms": 166915,
      "text": "不远处的五亭桥和白塔正好被端端正正框在圆洞里，",
      "token_start": 550,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 167480,
      "end_ms": 170905,
      "text": "就像给山水套了个现成的原相框。",
      "token_start": 572,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 171310,
      "end_ms": 172410,
      "text": "文人造亭子，",
      "token_start": 586,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 172510,
      "end_ms": 175335,
      "text": "从不靠大红大金显摆有钱，",
      "token_start": 591,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 175960,
      "end_ms": 179405,
      "text": "而是把外面的山水借到自己眼前来。",
      "token_start": 602,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 179940,
      "end_ms": 182500,
      "text": "这种看似随手一摆的讲究，",
      "token_start": 617,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 182880,
      "end_ms": 183940,
      "text": "您说妙不妙。",
      "token_start": 628,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 184240,
      "end_ms": 184960,
      "text": "第八名。",
      "token_start": 633,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 185360,
      "end_ms": 189500,
      "text": "放鹤亭在江苏徐州的云龙山顶上，",
      "token_start": 636,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 189880,
      "end_ms": 191300,
      "text": "北宋元丰年间，",
      "token_start": 650,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 191740,
      "end_ms": 194240,
      "text": "有个不愿当官的隐士叫张天际，",
      "token_start": 656,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 194660,
      "end_ms": 197100,
      "text": "自己在山顶盖了这座小凉亭，",
      "token_start": 669,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 197440,
      "end_ms": 198240,
      "text": "地方不大，",
      "token_start": 681,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 198720,
      "end_ms": 199860,
      "text": "就十几平米，",
      "token_start": 685,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 200500,
      "end_ms": 202780,
      "text": "迎面正对着满山林海。",
      "token_start": 690,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 203200,
      "end_ms": 205540,
      "text": "苏轼当年被贬到徐州做官，",
      "token_start": 699,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 206320,
      "end_ms": 207460,
      "text": "心里苦闷，",
      "token_start": 710,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 207880,
      "end_ms": 211010,
      "text": "就老爱爬上山来来找他喝酒聊天，",
      "token_start": 714,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 211670,
      "end_ms": 214910,
      "text": "还挥笔写下了一篇放鹤亭记。",
      "token_start": 728,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 215270,
      "end_ms": 216830,
      "text": "您站在亭子前面，",
      "token_start": 740,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 216850,
      "end_ms": 218090,
      "text": "抬眼往远处看，",
      "token_start": 747,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 218650,
      "end_ms": 220470,
      "text": "大风吹的衣服呼呼响。",
      "token_start": 753,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 221010,
      "end_ms": 223590,
      "text": "整座徐州城的烟火全在脚底下，",
      "token_start": 762,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 224130,
      "end_ms": 227050,
      "text": "平日里为柴米油盐烦透了的心思，",
      "token_start": 775,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 227410,
      "end_ms": 229690,
      "text": "一下子全被吹得无影无踪。",
      "token_start": 789,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 230110,
      "end_ms": 232030,
      "text": "大文豪不巴结权贵，",
      "token_start": 800,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 232290,
      "end_ms": 234650,
      "text": "跟着白鹤一起寄托山野。",
      "token_start": 808,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 235130,
      "end_ms": 238070,
      "text": "这份天塌下来也压不垮的旷达，",
      "token_start": 818,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 238450,
      "end_ms": 241465,
      "text": "您说是不是读书人最想要的活法？",
      "token_start": 831,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 241840,
      "end_ms": 242520,
      "text": "第七名，",
      "token_start": 845,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 242840,
      "end_ms": 247525,
      "text": "丰乐亭在安徽滁州的一座山谷泉水边上。",
      "token_start": 848,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 248210,
      "end_ms": 249605,
      "text": "北宋庆历六年，",
      "token_start": 865,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 249940,
      "end_ms": 251700,
      "text": "欧阳修在滁州做官，",
      "token_start": 871,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 251920,
      "end_ms": 254565,
      "text": "带着人在泉水旁修了这座亭子，",
      "token_start": 879,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 255010,
      "end_ms": 256945,
      "text": "四周大山抱得紧紧的，",
      "token_start": 892,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 257590,
      "end_ms": 259475,
      "text": "旁边就是一口清泉。",
      "token_start": 901,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 260240,
      "end_ms": 263575,
      "text": "苏轼亲手写的丰乐亭记大石碑，",
      "token_start": 909,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 264020,
      "end_ms": 265845,
      "text": "到现在还立在那儿。",
      "token_start": 922,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 266270,
      "end_ms": 268390,
      "text": "欧阳修当年不光在这儿喝酒，",
      "token_start": 930,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 268410,
      "end_ms": 271760,
      "text": "作诗更常年跑到田间地头，",
      "token_start": 942,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 271780,
      "end_ms": 273605,
      "text": "帮老百姓琢磨收成。",
      "token_start": 953,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 274140,
      "end_ms": 275865,
      "text": "他给亭子起名封乐，",
      "token_start": 961,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 276370,
      "end_ms": 278585,
      "text": "意思就是老百姓庄稼丰收，",
      "token_start": 969,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 279000,
      "end_ms": 282505,
      "text": "大家伙儿天天乐呵被贬的滋味不好受，",
      "token_start": 980,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 283060,
      "end_ms": 285245,
      "text": "能把这滋味写成这两个字。",
      "token_start": 996,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 285750,
      "end_ms": 286515,
      "text": "这是功夫，",
      "token_start": 1007,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 286810,
      "end_ms": 288875,
      "text": "也是境界第六名，",
      "token_start": 1011,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 289330,
      "end_ms": 292285,
      "text": "沧浪亭就在苏州城南边。",
      "token_start": 1018,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 293040,
      "end_ms": 295920,
      "text": "它是苏州现存最古老的园林，",
      "token_start": 1028,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 296520,
      "end_ms": 299400,
      "text": "比拙政园、刘园都要老，",
      "token_start": 1040,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 299960,
      "end_ms": 301540,
      "text": "一直能追到北宋。",
      "token_start": 1049,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 302000,
      "end_ms": 302500,
      "text": "当年，",
      "token_start": 1056,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 302520,
      "end_ms": 305500,
      "text": "大诗人苏舜卿在朝廷受了牵连，",
      "token_start": 1058,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 305980,
      "end_ms": 311180,
      "text": "被罢官跑到苏州花了四万钱买下这片荒地，",
      "token_start": 1071,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 311660,
      "end_ms": 312640,
      "text": "依水盖了。",
      "token_start": 1089,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 312640,
      "end_ms": 316360,
      "text": "这座亭子名字取自老化水，",
      "token_start": 1093,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 316380,
      "end_ms": 317400,
      "text": "要是清亮，",
      "token_start": 1104,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 317880,
      "end_ms": 321000,
      "text": "我就洗洗帽带去当官水。",
      "token_start": 1108,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 321060,
      "end_ms": 321960,
      "text": "要是浑浊，",
      "token_start": 1118,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 322360,
      "end_ms": 325450,
      "text": "我就就洗洗脚丫子回家过日子。",
      "token_start": 1122,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 326050,
      "end_ms": 327970,
      "text": "苏舜卿选了后者，",
      "token_start": 1135,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 328670,
      "end_ms": 330070,
      "text": "在这喝酒写诗，",
      "token_start": 1142,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 330650,
      "end_ms": 333230,
      "text": "硬把落魄过成了悠闲。",
      "token_start": 1148,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 333710,
      "end_ms": 335090,
      "text": "您站在这亭子里，",
      "token_start": 1157,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 335290,
      "end_ms": 336170,
      "text": "一面是水，",
      "token_start": 1164,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 336550,
      "end_ms": 340290,
      "text": "一面是竹风过来竹叶的声音，",
      "token_start": 1168,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 340610,
      "end_ms": 342090,
      "text": "细细的风。",
      "token_start": 1180,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 342090,
      "end_ms": 345150,
      "text": "舜卿当年的那口气还留在这里，",
      "token_start": 1184,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 345510,
      "end_ms": 349810,
      "text": "沧浪亭的文人气是把诗意写成从容，",
      "token_start": 1197,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 350370,
      "end_ms": 351670,
      "text": "是世道浊了，",
      "token_start": 1212,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 351670,
      "end_ms": 354345,
      "text": "我还能笑着往钱的那种活法。",
      "token_start": 1217,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 354670,
      "end_ms": 356130,
      "text": "从第十到第六名，",
      "token_start": 1229,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 356410,
      "end_ms": 360040,
      "text": "甄趣亭让皇上收起了霸道吹台，",
      "token_start": 1236,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 360040,
      "end_ms": 360680,
      "text": "借圆窗，",
      "token_start": 1249,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 360820,
      "end_ms": 363520,
      "text": "把天地框进眼里放客亭，",
      "token_start": 1252,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 363580,
      "end_ms": 366005,
      "text": "帮苏轼吹散了心头的俗气。",
      "token_start": 1262,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 366550,
      "end_ms": 369005,
      "text": "丰乐亭写满了老百姓的温饱，",
      "token_start": 1273,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 369480,
      "end_ms": 371400,
      "text": "沧浪亭立下了受屈，",
      "token_start": 1285,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 371400,
      "end_ms": 373025,
      "text": "也不弯腰的硬骨头，",
      "token_start": 1293,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 373710,
      "end_ms": 376135,
      "text": "可他们还不是最有文人气的。",
      "token_start": 1301,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 376540,
      "end_ms": 379385,
      "text": "接下来前五名有一座亭子，",
      "token_start": 1313,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 379920,
      "end_ms": 380160,
      "text": "造，",
      "token_start": 1324,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 380200,
      "end_ms": 382205,
      "text": "他的人是个落魄书生，",
      "token_start": 1325,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 382780,
      "end_ms": 385600,
      "text": "却被历代文人奉为精神。",
      "token_start": 1334,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 385660,
      "end_ms": 387680,
      "text": "图腾有一座亭，",
      "token_start": 1344,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 387980,
      "end_ms": 389075,
      "text": "一场大雪，",
      "token_start": 1350,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 389450,
      "end_ms": 391055,
      "text": "一个人一壶酒，",
      "token_start": 1354,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 391440,
      "end_ms": 393435,
      "text": "把孤独写到了极致，",
      "token_start": 1360,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 393830,
      "end_ms": 397765,
      "text": "可排在榜首的那座聚了四十一个文件，",
      "token_start": 1368,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 398460,
      "end_ms": 399505,
      "text": "一场聚会，",
      "token_start": 1384,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 399840,
      "end_ms": 400865,
      "text": "一篇文章，",
      "token_start": 1388,
      "token_end_exclusive": 1392
    },
    {
      "start_ms": 401270,
      "end_ms": 405295,
      "text": "让他成了中国文人心理最不可替代的地方。",
      "token_start": 1392,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 406070,
      "end_ms": 407705,
      "text": "没有帝王加持，",
      "token_start": 1410,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 408280,
      "end_ms": 409775,
      "text": "没有庙堂背书，",
      "token_start": 1416,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 410220,
      "end_ms": 415705,
      "text": "他凭什么排在醉翁亭和爱婉亭前面下一集已经同步更新，",
      "token_start": 1422,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 416340,
      "end_ms": 417515,
      "text": "点开我的头像，",
      "token_start": 1446,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 417970,
      "end_ms": 421365,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1452,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 421970,
      "end_ms": 426315,
      "text": "看看谁才是中国古代最有文人气的名亭。",
      "token_start": 1464,
      "token_end_exclusive": 1481
    }
  ],
