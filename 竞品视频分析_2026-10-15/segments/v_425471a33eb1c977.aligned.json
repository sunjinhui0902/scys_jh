{
  "video_id": "v_425471a33eb1c977",
  "duration_s": 556.838005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_425471a33eb1c977.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_425471a33eb1c977.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 670,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 670,
      "end_ms": 2670,
      "text": "咱们盘的第十到第六，",
      "token_start": 2,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3170,
      "end_ms": 5610,
      "text": "从北岳衡山到南岳衡山，",
      "token_start": 11,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 6010,
      "end_ms": 8830,
      "text": "从中岳嵩山到长白山天池，",
      "token_start": 21,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 9350,
      "end_ms": 10210,
      "text": "再到庐山，",
      "token_start": 32,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 10210,
      "end_ms": 13270,
      "text": "哪一万六千首诗最多？",
      "token_start": 36,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 13270,
      "end_ms": 15110,
      "text": "朋友看完在评论区炒翻了。",
      "token_start": 45,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 15570,
      "end_ms": 17330,
      "text": "有人说华山呢？",
      "token_start": 56,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 17530,
      "end_ms": 18530,
      "text": "峨眉山呢？",
      "token_start": 62,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 18730,
      "end_ms": 19550,
      "text": "泰山呢？",
      "token_start": 66,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 19670,
      "end_ms": 20210,
      "text": "别急，",
      "token_start": 69,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 20790,
      "end_ms": 23070,
      "text": "今天这集就是第五道第一，",
      "token_start": 71,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 23330,
      "end_ms": 24450,
      "text": "一个比一个震撼。",
      "token_start": 82,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 24810,
      "end_ms": 26670,
      "text": "最后那个万山之祖，",
      "token_start": 89,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26970,
      "end_ms": 27930,
      "text": "龙脉之祖，",
      "token_start": 97,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 28450,
      "end_ms": 33640,
      "text": "中国第一神山老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 101,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 33740,
      "end_ms": 36280,
      "text": "让我看看都是谁在听第五名。",
      "token_start": 124,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 36600,
      "end_ms": 41840,
      "text": "陕西华山在陕西渭南华阴市五岳里的溪岳，",
      "token_start": 136,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 42220,
      "end_ms": 45040,
      "text": "这山最绝的就一个字显。",
      "token_start": 154,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 45820,
      "end_ms": 47460,
      "text": "自古华山一条路，",
      "token_start": 164,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 47580,
      "end_ms": 50460,
      "text": "不是说着玩的千尺状，",
      "token_start": 171,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 50820,
      "end_ms": 52840,
      "text": "百尺峡老君离沟，",
      "token_start": 180,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 53380,
      "end_ms": 54340,
      "text": "光听名字，",
      "token_start": 187,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 54520,
      "end_ms": 55480,
      "text": "腿就软了。",
      "token_start": 191,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 56060,
      "end_ms": 58120,
      "text": "光显得是长空栈道，",
      "token_start": 195,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 58420,
      "end_ms": 59945,
      "text": "海拔两千一百六，",
      "token_start": 203,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 60050,
      "end_ms": 63565,
      "text": "不是你悬在南风东侧的绝壁上，",
      "token_start": 210,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 64860,
      "end_ms": 66675,
      "text": "全长一百一十米。",
      "token_start": 223,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 67220,
      "end_ms": 68255,
      "text": "七百多年前，",
      "token_start": 230,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 68710,
      "end_ms": 78050,
      "text": "元代华山派宗师贺志贞带着弟子在万刃绝壁上凿出石孔斜进铁桩铺上木板，",
      "token_start": 235,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 78230,
      "end_ms": 79165,
      "text": "修了这条路，",
      "token_start": 267,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 80060,
      "end_ms": 82975,
      "text": "最窄的地方只有一块木板宽，",
      "token_start": 272,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 83750,
      "end_ms": 85565,
      "text": "脚下就是万丈深渊。",
      "token_start": 284,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 86100,
      "end_ms": 88565,
      "text": "您说这是路还是拿命在走？",
      "token_start": 292,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 89980,
      "end_ms": 90615,
      "text": "第四名，",
      "token_start": 303,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 90980,
      "end_ms": 93885,
      "text": "四川峨眉山在四川乐山，",
      "token_start": 306,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 94190,
      "end_ms": 98015,
      "text": "中国四大佛教名山之一普贤菩萨的道场。",
      "token_start": 316,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 98520,
      "end_ms": 103255,
      "text": "这山最绝的是金鼎海拔三千零七十九米，",
      "token_start": 333,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 103780,
      "end_ms": 105965,
      "text": "顶上有一尊十方普贤像，",
      "token_start": 350,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 106410,
      "end_ms": 107955,
      "text": "通高四十八米，",
      "token_start": 360,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 108290,
      "end_ms": 109345,
      "text": "重六百六十吨。",
      "token_start": 366,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 110260,
      "end_ms": 112670,
      "text": "铜铸活金在阳光下，",
      "token_start": 372,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 112890,
      "end_ms": 113915,
      "text": "金光闪闪。",
      "token_start": 380,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 114410,
      "end_ms": 116130,
      "text": "金顶上还有四大奇观，",
      "token_start": 384,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 116270,
      "end_ms": 118370,
      "text": "云海、日出佛光，",
      "token_start": 393,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 118670,
      "end_ms": 121670,
      "text": "圣灯佛光最邪乎。",
      "token_start": 399,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 122550,
      "end_ms": 123950,
      "text": "您站在金顶上，",
      "token_start": 406,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 124930,
      "end_ms": 126050,
      "text": "背对着太阳，",
      "token_start": 412,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 127070,
      "end_ms": 128750,
      "text": "前面有云雾的时候，",
      "token_start": 417,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 128850,
      "end_ms": 131390,
      "text": "您的影子会投射在云上影子。",
      "token_start": 425,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 131390,
      "end_ms": 133590,
      "text": "外面围着一圈彩虹，",
      "token_start": 437,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 133950,
      "end_ms": 135810,
      "text": "您动彩虹也动，",
      "token_start": 445,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 136170,
      "end_ms": 138730,
      "text": "古人不懂说是佛祖显灵，",
      "token_start": 451,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 139210,
      "end_ms": 140830,
      "text": "其实这是光学显灵，",
      "token_start": 461,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 141270,
      "end_ms": 143630,
      "text": "可在金顶上看到佛光，",
      "token_start": 469,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 144290,
      "end_ms": 147410,
      "text": "那感觉真的像佛祖在跟您说话，",
      "token_start": 478,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 147950,
      "end_ms": 150560,
      "text": "您说这是山还是仙境？",
      "token_start": 491,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 151520,
      "end_ms": 152700,
      "text": "讲了这几个地方，",
      "token_start": 500,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 152920,
      "end_ms": 155280,
      "text": "我发现评论区有个事儿特别一致。",
      "token_start": 507,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 155360,
      "end_ms": 158080,
      "text": "好多朋友说年轻时候忙没空去，",
      "token_start": 521,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 158340,
      "end_ms": 159280,
      "text": "现在退休了，",
      "token_start": 534,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 159420,
      "end_ms": 160120,
      "text": "有空了，",
      "token_start": 539,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 160240,
      "end_ms": 163000,
      "text": "可不知道该先去哪座山也不知道去了。",
      "token_start": 542,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 163000,
      "end_ms": 165500,
      "text": "看什么腿脚不好的说，",
      "token_start": 558,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 165840,
      "end_ms": 167420,
      "text": "华山这样的爬不动，",
      "token_start": 567,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 167660,
      "end_ms": 169880,
      "text": "有没有不用爬山也能看的，",
      "token_start": 575,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 170540,
      "end_ms": 171940,
      "text": "带孙子孙女的说，",
      "token_start": 586,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 172440,
      "end_ms": 175500,
      "text": "想给孩子讲讲这些名山的来历，",
      "token_start": 593,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 175700,
      "end_ms": 176940,
      "text": "可自己也说不全。",
      "token_start": 606,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 177920,
      "end_ms": 179575,
      "text": "咱们这个年纪看景，",
      "token_start": 613,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 180000,
      "end_ms": 181345,
      "text": "不光是看个热闹，",
      "token_start": 621,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 181750,
      "end_ms": 185010,
      "text": "是想知道这山这水有什么讲究，",
      "token_start": 628,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 185250,
      "end_ms": 186135,
      "text": "有什么故事。",
      "token_start": 641,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 187060,
      "end_ms": 189390,
      "text": "可手机上刷完就忘上网，",
      "token_start": 646,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 189450,
      "end_ms": 191815,
      "text": "查一堆乱七八糟的翻大布头，",
      "token_start": 656,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 192110,
      "end_ms": 193225,
      "text": "又看得眼睛疼。",
      "token_start": 668,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 193940,
      "end_ms": 199265,
      "text": "前阵子我翻到一本叫三百六十五日走遍中国的日历书，",
      "token_start": 674,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 199810,
      "end_ms": 204065,
      "text": "左边一页是实景大图加一段冷知识，",
      "token_start": 697,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 204590,
      "end_ms": 206465,
      "text": "右边是日期记时夜，",
      "token_start": 712,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 206830,
      "end_ms": 208235,
      "text": "什么季节去哪座山，",
      "token_start": 720,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 208510,
      "end_ms": 209250,
      "text": "走哪条路，",
      "token_start": 728,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 209270,
      "end_ms": 210825,
      "text": "看什么风景最合适，",
      "token_start": 732,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 211160,
      "end_ms": 212245,
      "text": "都给你安排好了。",
      "token_start": 740,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 212580,
      "end_ms": 213500,
      "text": "今天翻到庐山，",
      "token_start": 747,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 213580,
      "end_ms": 214805,
      "text": "明天翻到峨眉山，",
      "token_start": 753,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 215280,
      "end_ms": 216100,
      "text": "翻到哪页，",
      "token_start": 760,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 216100,
      "end_ms": 219410,
      "text": "就觉得那座山在喊你能去的地方，",
      "token_start": 764,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 219570,
      "end_ms": 221980,
      "text": "出门前翻一翻到了地方，",
      "token_start": 778,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 222000,
      "end_ms": 223140,
      "text": "看的就不是石头，",
      "token_start": 788,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 223200,
      "end_ms": 225095,
      "text": "是故事去不了的地方。",
      "token_start": 795,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 225490,
      "end_ms": 226130,
      "text": "翻翻书，",
      "token_start": 804,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 226130,
      "end_ms": 228275,
      "text": "看看图也算去过。",
      "token_start": 807,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 228690,
      "end_ms": 230410,
      "text": "放茶几上孙子，",
      "token_start": 814,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 230410,
      "end_ms": 231050,
      "text": "孙女来了，",
      "token_start": 820,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 231050,
      "end_ms": 232760,
      "text": "翻两页长知识，",
      "token_start": 824,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 232760,
      "end_ms": 233155,
      "text": "不说，",
      "token_start": 830,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 233520,
      "end_ms": 234765,
      "text": "写作文都用得上，",
      "token_start": 832,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 235140,
      "end_ms": 236495,
      "text": "老两口晚上翻番，",
      "token_start": 839,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 236930,
      "end_ms": 238315,
      "text": "商量明年去哪儿，",
      "token_start": 846,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 238500,
      "end_ms": 240125,
      "text": "比刷手机有意思多了。",
      "token_start": 853,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 240450,
      "end_ms": 243455,
      "text": "我已经放下面点开就能看到，",
      "token_start": 862,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 243910,
      "end_ms": 245395,
      "text": "暂时走不出去，",
      "token_start": 874,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 245850,
      "end_ms": 247465,
      "text": "咱就把祖国装进屋里。",
      "token_start": 880,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 249100,
      "end_ms": 249765,
      "text": "第三名，",
      "token_start": 889,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 250380,
      "end_ms": 255755,
      "text": "安徽黄山在安徽黄山市天下第一奇山。",
      "token_start": 892,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 256560,
      "end_ms": 259865,
      "text": "这山最绝的是四样东西，",
      "token_start": 908,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 261460,
      "end_ms": 263810,
      "text": "奇松、怪石、云海，",
      "token_start": 918,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 264030,
      "end_ms": 267225,
      "text": "温泉合在一起就叫黄山四绝。",
      "token_start": 924,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 268160,
      "end_ms": 269505,
      "text": "您听过那句话没有？",
      "token_start": 936,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 269800,
      "end_ms": 271675,
      "text": "五岳归来不看山，",
      "token_start": 944,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 272200,
      "end_ms": 275705,
      "text": "黄山归来不看月五越够牛了吧。",
      "token_start": 951,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 277210,
      "end_ms": 280905,
      "text": "泰山、华山、恒山、衡山、嵩山，",
      "token_start": 964,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 281850,
      "end_ms": 286495,
      "text": "看完黄山五月都不用看这话谁说的？",
      "token_start": 974,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 287430,
      "end_ms": 288565,
      "text": "明朝旅行家，",
      "token_start": 989,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 288850,
      "end_ms": 289675,
      "text": "徐霞客，",
      "token_start": 994,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 290580,
      "end_ms": 291755,
      "text": "他爬了一辈子山。",
      "token_start": 997,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 292770,
      "end_ms": 294850,
      "text": "走到黄山说了这句话，",
      "token_start": 1004,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 295250,
      "end_ms": 299050,
      "text": "迎客松长在悬崖上一千多年了，",
      "token_start": 1013,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 299450,
      "end_ms": 302510,
      "text": "伸着胳膊像在迎接天下客。",
      "token_start": 1026,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 303090,
      "end_ms": 307370,
      "text": "这棵树现在是全中国最有名的一棵树。",
      "token_start": 1037,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 307510,
      "end_ms": 308850,
      "text": "黄山还有温泉，",
      "token_start": 1053,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 309450,
      "end_ms": 314530,
      "text": "古人叫汤泉源出海拔八百五十米的紫云峰下，",
      "token_start": 1059,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 315030,
      "end_ms": 316210,
      "text": "水质纯净，",
      "token_start": 1078,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 316670,
      "end_ms": 317770,
      "text": "可饮可浴。",
      "token_start": 1082,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 318290,
      "end_ms": 320470,
      "text": "您爬完山泡个温泉，",
      "token_start": 1086,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 321070,
      "end_ms": 326720,
      "text": "您说这是山还是老天爷给中国人修的一个大园子？",
      "token_start": 1094,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 327680,
      "end_ms": 328340,
      "text": "第二名，",
      "token_start": 1115,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 328680,
      "end_ms": 331920,
      "text": "山东泰山在山东泰安，",
      "token_start": 1118,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 332240,
      "end_ms": 335040,
      "text": "海拔一千五百四十五米，",
      "token_start": 1127,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 336280,
      "end_ms": 337140,
      "text": "五岳之首，",
      "token_start": 1137,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 337340,
      "end_ms": 340600,
      "text": "被尊为中华国山天下第一山。",
      "token_start": 1141,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 340840,
      "end_ms": 343120,
      "text": "这山最绝的不是高，",
      "token_start": 1153,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 343520,
      "end_ms": 346100,
      "text": "是他被中国人拜了五千年。",
      "token_start": 1161,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 346620,
      "end_ms": 347840,
      "text": "从远古开始，",
      "token_start": 1172,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 348360,
      "end_ms": 353455,
      "text": "泰山就被当成太阳升起之山生命大诞生之处。",
      "token_start": 1177,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 354340,
      "end_ms": 356425,
      "text": "秦始皇统一中国以后，",
      "token_start": 1196,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 356830,
      "end_ms": 359565,
      "text": "第一件事儿就是来泰山封禅。",
      "token_start": 1205,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 360580,
      "end_ms": 361555,
      "text": "什么叫封禅？",
      "token_start": 1217,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 362020,
      "end_ms": 365950,
      "text": "在山顶上助坛祭天叫风，",
      "token_start": 1222,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 366270,
      "end_ms": 369675,
      "text": "在山脚下祭地叫禅风扇，",
      "token_start": 1232,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 370080,
      "end_ms": 373115,
      "text": "是古代帝王最高规格的典礼，",
      "token_start": 1242,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 373590,
      "end_ms": 376310,
      "text": "不是每个皇帝都能来得，",
      "token_start": 1254,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 376310,
      "end_ms": 377425,
      "text": "天下太平，",
      "token_start": 1264,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 377790,
      "end_ms": 378695,
      "text": "得有功绩。",
      "token_start": 1268,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 379490,
      "end_ms": 382030,
      "text": "秦始皇来过汉武帝来过，",
      "token_start": 1272,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 382390,
      "end_ms": 382950,
      "text": "汉武帝，",
      "token_start": 1282,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 382950,
      "end_ms": 384595,
      "text": "一生来了八次，",
      "token_start": 1285,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 385210,
      "end_ms": 387455,
      "text": "还在山顶上立了一块无字碑。",
      "token_start": 1291,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 388250,
      "end_ms": 394910,
      "text": "唐高宗来过唐玄宗来过宋真宗来过两千多年里，",
      "token_start": 1303,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 395090,
      "end_ms": 398415,
      "text": "先后有十三位皇帝亲登泰山封禅，",
      "token_start": 1323,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 398680,
      "end_ms": 402620,
      "text": "或祭祀孔子来过杜甫来过杜甫，",
      "token_start": 1337,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 402620,
      "end_ms": 406525,
      "text": "站在泰山顶上写了一句会当凌绝顶，",
      "token_start": 1350,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 406820,
      "end_ms": 408145,
      "text": "一览众山小。",
      "token_start": 1365,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 408790,
      "end_ms": 411555,
      "text": "司马迁写过人固有一死，",
      "token_start": 1370,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 411870,
      "end_ms": 413050,
      "text": "或重于泰山，",
      "token_start": 1380,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 413410,
      "end_ms": 414670,
      "text": "或轻于鸿毛。",
      "token_start": 1385,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 415130,
      "end_ms": 419930,
      "text": "一座山跟中国人的生死观荣辱关全绑在一起了，",
      "token_start": 1390,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 420250,
      "end_ms": 421430,
      "text": "别的山再牛，",
      "token_start": 1410,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 421910,
      "end_ms": 424070,
      "text": "论资排辈都得往后站，",
      "token_start": 1415,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 424610,
      "end_ms": 426690,
      "text": "可为什么泰山只排第二？",
      "token_start": 1424,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 427510,
      "end_ms": 433470,
      "text": "因为第一名是所有山的祖宗第一名。",
      "token_start": 1434,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 435250,
      "end_ms": 439390,
      "text": "青海、昆仑山昆仑山是亚洲最长的山脉之一，",
      "token_start": 1449,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 439770,
      "end_ms": 444240,
      "text": "从帕米尔高原一路向东东横跨新疆、西藏。",
      "token_start": 1467,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 444240,
      "end_ms": 447140,
      "text": "青海全长两千五百多公里，",
      "token_start": 1484,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 447700,
      "end_ms": 451140,
      "text": "平均海拔五千五百米到六千米，",
      "token_start": 1495,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 451640,
      "end_ms": 453480,
      "text": "它被叫做万山之祖，",
      "token_start": 1508,
      "token_end_exclusive": 1516
    },
    {
      "start_ms": 453740,
      "end_ms": 454680,
      "text": "龙脉之祖，",
      "token_start": 1516,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 455280,
      "end_ms": 456720,
      "text": "中国第一神山。",
      "token_start": 1520,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 457680,
      "end_ms": 459400,
      "text": "为什么昆仑山排第一？",
      "token_start": 1526,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 460040,
      "end_ms": 461260,
      "text": "不是因为它最高，",
      "token_start": 1535,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 461920,
      "end_ms": 463240,
      "text": "不是因为它最美，",
      "token_start": 1542,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 463420,
      "end_ms": 465920,
      "text": "是因为它是所有山的祖宗。",
      "token_start": 1549,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 466480,
      "end_ms": 468260,
      "text": "在中国古代神话里，",
      "token_start": 1560,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 468440,
      "end_ms": 470060,
      "text": "昆仑山是西王母，",
      "token_start": 1568,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 470060,
      "end_ms": 470840,
      "text": "住的地方，",
      "token_start": 1575,
      "token_end_exclusive": 1579
    },
    {
      "start_ms": 471040,
      "end_ms": 472010,
      "text": "是天帝，",
      "token_start": 1579,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 472010,
      "end_ms": 473430,
      "text": "在人间的都邑，",
      "token_start": 1582,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 473570,
      "end_ms": 475590,
      "text": "是皇帝在人间的夏都。",
      "token_start": 1588,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 476370,
      "end_ms": 479650,
      "text": "中国的很多神话故事都从昆仑山开始，",
      "token_start": 1597,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 480450,
      "end_ms": 486710,
      "text": "女娲补天、后羿射日、嫦娥奔月中跟昆仑山有关。",
      "token_start": 1613,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 487690,
      "end_ms": 488630,
      "text": "更绝的是，",
      "token_start": 1632,
      "token_end_exclusive": 1636
    },
    {
      "start_ms": 489030,
      "end_ms": 491810,
      "text": "昆仑山是中国龙脉的发源地，",
      "token_start": 1636,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 492530,
      "end_ms": 493910,
      "text": "中国三大龙脉。",
      "token_start": 1648,
      "token_end_exclusive": 1654
    },
    {
      "start_ms": 494210,
      "end_ms": 498210,
      "text": "北龙中龙南龙全从昆仑山发源，",
      "token_start": 1654,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 498930,
      "end_ms": 500130,
      "text": "从昆仑山出来，",
      "token_start": 1667,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 500330,
      "end_ms": 501050,
      "text": "一路向东，",
      "token_start": 1673,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 501050,
      "end_ms": 503080,
      "text": "铺遍了整个中国。",
      "token_start": 1677,
      "token_end_exclusive": 1684
    },
    {
      "start_ms": 503480,
      "end_ms": 506200,
      "text": "所有的名山都是昆仑山的子孙，",
      "token_start": 1684,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 506540,
      "end_ms": 507940,
      "text": "泰山是华山，",
      "token_start": 1697,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 508000,
      "end_ms": 508840,
      "text": "是黄山，",
      "token_start": 1702,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 508900,
      "end_ms": 510080,
      "text": "是峨眉山，",
      "token_start": 1705,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 510160,
      "end_ms": 511640,
      "text": "也是一座山，",
      "token_start": 1709,
      "token_end_exclusive": 1714
    },
    {
      "start_ms": 511860,
      "end_ms": 513920,
      "text": "生出了全中国的山。",
      "token_start": 1714,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 514580,
      "end_ms": 516920,
      "text": "您说这个第一名服不服？",
      "token_start": 1722,
      "token_end_exclusive": 1732
    },
    {
      "start_ms": 517100,
      "end_ms": 518400,
      "text": "您听出来了没有？",
      "token_start": 1732,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 518960,
      "end_ms": 520260,
      "text": "这十座名山，",
      "token_start": 1739,
      "token_end_exclusive": 1744
    },
    {
      "start_ms": 520560,
      "end_ms": 523740,
      "text": "没有一座是光靠好看出名的。",
      "token_start": 1744,
      "token_end_exclusive": 1756
    },
    {
      "start_ms": 523980,
      "end_ms": 526540,
      "text": "恒山靠的是北方的屏障，",
      "token_start": 1756,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 527020,
      "end_ms": 529300,
      "text": "恒山靠的是四季的舞台。",
      "token_start": 1766,
      "token_end_exclusive": 1776
    },
    {
      "start_ms": 529920,
      "end_ms": 532330,
      "text": "嵩山靠的是中原文脉。",
      "token_start": 1776,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 532890,
      "end_ms": 535130,
      "text": "长白山靠的是藏在天上。",
      "token_start": 1785,
      "token_end_exclusive": 1795
    },
    {
      "start_ms": 535670,
      "end_ms": 536990,
      "text": "庐山靠的是师，",
      "token_start": 1795,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 537590,
      "end_ms": 538130,
      "text": "华山，",
      "token_start": 1801,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 538230,
      "end_ms": 538970,
      "text": "靠的是险，",
      "token_start": 1803,
      "token_end_exclusive": 1807
    },
    {
      "start_ms": 539550,
      "end_ms": 541410,
      "text": "峨眉山靠的是佛光。",
      "token_start": 1807,
      "token_end_exclusive": 1815
    },
    {
      "start_ms": 542030,
      "end_ms": 543510,
      "text": "黄山靠的是四绝，",
      "token_start": 1815,
      "token_end_exclusive": 1822
    },
    {
      "start_ms": 543910,
      "end_ms": 544410,
      "text": "泰山，",
      "token_start": 1822,
      "token_end_exclusive": 1824
    },
    {
      "start_ms": 544510,
      "end_ms": 545530,
      "text": "靠的是五千年，",
      "token_start": 1824,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 545930,
      "end_ms": 548410,
      "text": "昆仑山靠的是万山之祖，",
      "token_start": 1830,
      "token_end_exclusive": 1840
    },
    {
      "start_ms": 548870,
      "end_ms": 552590,
      "text": "每一座名山的厉害之处都不在它有多高。",
      "token_start": 1840,
