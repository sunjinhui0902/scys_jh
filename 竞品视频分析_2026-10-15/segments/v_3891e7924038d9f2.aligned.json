{
  "video_id": "v_3891e7924038d9f2",
  "duration_s": 258.947007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_3891e7924038d9f2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_3891e7924038d9f2.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 1350,
      "text": "假设你的工资是一万，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 1590,
      "end_ms": 3210,
      "text": "将你的工资乘以零点二，",
      "token_start": 9,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 3330,
      "end_ms": 5730,
      "text": "就是你每个月要存下或者投资的金额。",
      "token_start": 19,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 5810,
      "end_ms": 6210,
      "text": "第二，",
      "token_start": 35,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 6550,
      "end_ms": 7750,
      "text": "用你的工资乘以三，",
      "token_start": 37,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 7990,
      "end_ms": 9550,
      "text": "就是你现在需要的备用金。",
      "token_start": 45,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 9750,
      "end_ms": 10210,
      "text": "第三，",
      "token_start": 56,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 10490,
      "end_ms": 12070,
      "text": "用你的工资乘以零点五，",
      "token_start": 58,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 12230,
      "end_ms": 14050,
      "text": "就是你每个月支出的上限，",
      "token_start": 68,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 14230,
      "end_ms": 15410,
      "text": "包括吃喝住行，",
      "token_start": 79,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 15510,
      "end_ms": 16670,
      "text": "不可以超出这个数。",
      "token_start": 85,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 16750,
      "end_ms": 17210,
      "text": "第四，",
      "token_start": 93,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 17870,
      "end_ms": 19730,
      "text": "把你的工资乘以三百，",
      "token_start": 95,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 19970,
      "end_ms": 21290,
      "text": "再把这个数放一个回报。",
      "token_start": 104,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 21290,
      "end_ms": 22830,
      "text": "有百分之四的工具里面，",
      "token_start": 114,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 22990,
      "end_ms": 24930,
      "text": "你就可以做到每个月躺平，",
      "token_start": 124,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 25210,
      "end_ms": 26070,
      "text": "什么都不用做。",
      "token_start": 135,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 26270,
      "end_ms": 29935,
      "text": "每个月依然会有你现在的工资收入实现财务自由。",
      "token_start": 141,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 30220,
      "end_ms": 30660,
      "text": "第五，",
      "token_start": 162,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 30880,
      "end_ms": 32320,
      "text": "把你的工资乘以十二，",
      "token_start": 164,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 32360,
      "end_ms": 32980,
      "text": "再乘五，",
      "token_start": 173,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 33280,
      "end_ms": 33720,
      "text": "就是你。",
      "token_start": 176,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 33720,
      "end_ms": 35620,
      "text": "如果身体有任何情况不能工作，",
      "token_start": 179,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 35680,
      "end_ms": 38119,
      "text": "而你可以支持到自己生活水平的备用金，",
      "token_start": 192,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 38260,
      "end_ms": 41300,
      "text": "真正拉开人跟人差距的不只是赚多少钱，",
      "token_start": 209,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 41680,
      "end_ms": 44520,
      "text": "而是有没有从小培养正确的财商思维。",
      "token_start": 226,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 44960,
      "end_ms": 45360,
      "text": "妈妈，",
      "token_start": 242,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 45720,
      "end_ms": 48420,
      "text": "为啥商场一楼全是化妆品、珠宝，",
      "token_start": 244,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 48660,
      "end_ms": 50580,
      "text": "吃饭看电影却都在顶楼，",
      "token_start": 257,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 50920,
      "end_ms": 52540,
      "text": "因为顶楼风景好吃饭，",
      "token_start": 267,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 52540,
      "end_ms": 54200,
      "text": "香一楼太吵了呗，",
      "token_start": 276,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 54880,
      "end_ms": 55900,
      "text": "这都讲不清楚。",
      "token_start": 283,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 55980,
      "end_ms": 57400,
      "text": "孩子以后怎么学做生意？",
      "token_start": 289,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 57880,
      "end_ms": 59560,
      "text": "妈妈我知道是为什么。",
      "token_start": 299,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 59680,
      "end_ms": 61215,
      "text": "因为对一楼人流量大，",
      "token_start": 308,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 61580,
      "end_ms": 64085,
      "text": "大家都要经过有人会冲动消费。",
      "token_start": 317,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 64440,
      "end_ms": 67265,
      "text": "这是经济学启蒙课里提到过的瀑布效应。",
      "token_start": 330,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 68990,
      "end_ms": 72170,
      "text": "妈妈商场里面停车为什么比我们小区贵啊？",
      "token_start": 347,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 72350,
      "end_ms": 73470,
      "text": "因为商场地段好，",
      "token_start": 365,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 73630,
      "end_ms": 74935,
      "text": "所以停车自然贵，",
      "token_start": 372,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 76080,
      "end_ms": 76960,
      "text": "只知道地段好。",
      "token_start": 379,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 77160,
      "end_ms": 78160,
      "text": "停车费为什么贵？",
      "token_start": 385,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 78200,
      "end_ms": 81065,
      "text": "都讲不清楚孩子以后怎么学会控制成本。",
      "token_start": 392,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 83990,
      "end_ms": 85830,
      "text": "妈妈同样是矿泉水，",
      "token_start": 409,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 85910,
      "end_ms": 87885,
      "text": "为什么高铁上卖这么贵啊？",
      "token_start": 417,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 88220,
      "end_ms": 88615,
      "text": "嗯，",
      "token_start": 428,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 88970,
      "end_ms": 90045,
      "text": "高铁上就是贵，",
      "token_start": 429,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 90390,
      "end_ms": 91855,
      "text": "咱们自己带水喝就好了。",
      "token_start": 435,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 92930,
      "end_ms": 97655,
      "text": "连那么基础的经济学原理都讲不清楚孩子以后怎么发现商机。",
      "token_start": 445,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 98060,
      "end_ms": 98640,
      "text": "你想想，",
      "token_start": 471,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 98680,
      "end_ms": 101100,
      "text": "如果高铁上允许外面的人上来卖水，",
      "token_start": 474,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 101220,
      "end_ms": 102340,
      "text": "他还卖这么贵吗？",
      "token_start": 489,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 102540,
      "end_ms": 104000,
      "text": "就是因为只有他能卖，",
      "token_start": 496,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 104160,
      "end_ms": 105080,
      "text": "你又渴的不行，",
      "token_start": 505,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 105320,
      "end_ms": 106700,
      "text": "所以再贵你也得买。",
      "token_start": 511,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 106980,
      "end_ms": 109885,
      "text": "这是经济学启蒙课里提到的独家生意。",
      "token_start": 519,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 110160,
      "end_ms": 112155,
      "text": "妈妈自助餐随便吃，",
      "token_start": 535,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 112490,
      "end_ms": 114335,
      "text": "老板为什么还能赚钱啊？",
      "token_start": 543,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 115090,
      "end_ms": 116355,
      "text": "大部分人吃不多，",
      "token_start": 553,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 116710,
      "end_ms": 117865,
      "text": "所以老板不会亏。",
      "token_start": 560,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 118700,
      "end_ms": 121300,
      "text": "连自助餐厅为什么赚钱都给孩子讲，",
      "token_start": 567,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 121300,
      "end_ms": 123515,
      "text": "不清楚孩子以后怎么赚钱？",
      "token_start": 582,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 124560,
      "end_ms": 126420,
      "text": "妈妈猪肉便宜了，",
      "token_start": 593,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 126420,
      "end_ms": 128180,
      "text": "吃的人应该更多才对啊。",
      "token_start": 600,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 128220,
      "end_ms": 130445,
      "text": "为什么说猪肉销量反而下降了？",
      "token_start": 610,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 131400,
      "end_ms": 133100,
      "text": "可能大家兜里没钱了吧，",
      "token_start": 623,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 133400,
      "end_ms": 134845,
      "text": "穷了就少吃肉呗。",
      "token_start": 633,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 135240,
      "end_ms": 139795,
      "text": "也可能跟附近工地开工少了有关工地跟猪肉有什么关系？",
      "token_start": 640,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 140100,
      "end_ms": 141160,
      "text": "比如工地食堂，",
      "token_start": 664,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 141240,
      "end_ms": 143560,
      "text": "原来每天要买不少肉开工少了，",
      "token_start": 670,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 143560,
      "end_ms": 144360,
      "text": "吃饭的人少，",
      "token_start": 683,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 144640,
      "end_ms": 145895,
      "text": "采购也可能跟着减。",
      "token_start": 688,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 146400,
      "end_ms": 147200,
      "text": "不光是肉，",
      "token_start": 696,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 147440,
      "end_ms": 149445,
      "text": "蔬菜米面也可能受影响，",
      "token_start": 700,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 149770,
      "end_ms": 152685,
      "text": "一个地方的变化会连着影响别的生意。",
      "token_start": 710,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 153230,
      "end_ms": 157985,
      "text": "这我确实没想到妈妈为什么牛奶是方盒子，",
      "token_start": 726,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 158220,
      "end_ms": 159605,
      "text": "可乐却是圆瓶子。",
      "token_start": 744,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 160960,
      "end_ms": 162755,
      "text": "厂家就是这么设计的，",
      "token_start": 751,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 163210,
      "end_ms": 165265,
      "text": "具体原因我也不太清楚。",
      "token_start": 760,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 165730,
      "end_ms": 169635,
      "text": "可乐内部有气压圆形瓶身可以均匀分散压力。",
      "token_start": 770,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 169940,
      "end_ms": 171025,
      "text": "牛奶没有气压，",
      "token_start": 789,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 171400,
      "end_ms": 174320,
      "text": "方形盒子可以省下冷柜的仓储空间，",
      "token_start": 795,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 174460,
      "end_ms": 175435,
      "text": "降低商家成本。",
      "token_start": 810,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 176760,
      "end_ms": 178425,
      "text": "你们怎么什么都知道，",
      "token_start": 816,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 178690,
      "end_ms": 179555,
      "text": "我啥都不懂，",
      "token_start": 825,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 180070,
      "end_ms": 180830,
      "text": "这多亏了我。",
      "token_start": 830,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 180830,
      "end_ms": 187810,
      "text": "妈妈从小陪我看写给孩子的漫画经济学里面把这些商业模式全化成漫画故事了。",
      "token_start": 835,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 187810,
      "end_ms": 188710,
      "text": "一看就懂了。",
      "token_start": 869,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 188870,
      "end_ms": 189490,
      "text": "我妈说，",
      "token_start": 874,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 189750,
      "end_ms": 191650,
      "text": "一个人如果没有财商思维，",
      "token_start": 877,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 191950,
      "end_ms": 193330,
      "text": "长大要吃很多亏。",
      "token_start": 888,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 193850,
      "end_ms": 195610,
      "text": "所以我从小就在学。",
      "token_start": 895,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 195949,
      "end_ms": 198230,
      "text": "如果你不教导孩子金钱方面的知识，",
      "token_start": 903,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 198410,
      "end_ms": 200750,
      "text": "将来进入社会的他就像一张白纸，",
      "token_start": 918,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 200950,
      "end_ms": 202750,
      "text": "将人骗了也不自知错。",
      "token_start": 932,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 202790,
      "end_ms": 205710,
      "text": "把别人精心设计的陷阱当做自己的运气。",
      "token_start": 941,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 206050,
      "end_ms": 206370,
      "text": "推荐。",
      "token_start": 958,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 206370,
      "end_ms": 207510,
      "text": "在孩子十岁前，",
      "token_start": 960,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 207650,
      "end_ms": 211480,
      "text": "父母陪他读这套写给孩子的漫画经济学这套书，",
      "token_start": 966,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 211480,
      "end_ms": 214960,
      "text": "用生动有趣的故事帮助孩子树立正确的金钱观。",
      "token_start": 986,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 215320,
      "end_ms": 217300,
      "text": "像我们花的钱是从哪儿来的？",
      "token_start": 1006,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 217460,
      "end_ms": 219280,
      "text": "教会孩子认识金钱的来源，",
      "token_start": 1018,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 219720,
      "end_ms": 220960,
      "text": "如何不盲目购物？",
      "token_start": 1029,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 221160,
      "end_ms": 222740,
      "text": "教会孩子理性消费，",
      "token_start": 1036,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 222880,
      "end_ms": 223640,
      "text": "不乱花钱，",
      "token_start": 1044,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 223880,
      "end_ms": 225380,
      "text": "玩具只能选一个怎么办？",
      "token_start": 1048,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 225680,
      "end_ms": 227120,
      "text": "教会孩子学会取舍，",
      "token_start": 1058,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 227340,
      "end_ms": 229140,
      "text": "把钱花在真正需要的地方。",
      "token_start": 1066,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 229400,
      "end_ms": 230220,
      "text": "什么是打折？",
      "token_start": 1077,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 230560,
      "end_ms": 232260,
      "text": "教会孩子正确看待优惠，",
      "token_start": 1082,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 232400,
      "end_ms": 235180,
      "text": "不因为便宜就盲目购买记账的日子。",
      "token_start": 1092,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 235280,
      "end_ms": 236920,
      "text": "教会孩子记录日常开销，",
      "token_start": 1107,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 237140,
      "end_ms": 238780,
      "text": "养成管理零花钱的习惯，",
      "token_start": 1117,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 238860,
      "end_ms": 239735,
      "text": "钱越多越好。",
      "token_start": 1127,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 240230,
      "end_ms": 241970,
      "text": "引导孩子正确看待财富，",
      "token_start": 1132,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 242090,
      "end_ms": 243410,
      "text": "树立健康的金钱观，",
      "token_start": 1142,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 243590,
      "end_ms": 244670,
      "text": "让孩子从小明白，",
      "token_start": 1150,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 244670,
      "end_ms": 245490,
      "text": "钱从哪里来，",
      "token_start": 1157,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 245650,
      "end_ms": 246630,
      "text": "东西为什么有贵，",
      "token_start": 1162,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 246630,
      "end_ms": 247230,
      "text": "有便宜，",
      "token_start": 1169,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 247390,
      "end_ms": 248070,
      "text": "什么该买，",
      "token_start": 1172,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 248130,
      "end_ms": 248910,
      "text": "什么不该买，",
      "token_start": 1176,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 248930,
      "end_ms": 250210,
      "text": "慢慢学会合理花钱，",
      "token_start": 1181,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 250290,
      "end_ms": 250990,
      "text": "管理金钱，",
      "token_start": 1189,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 251230,
      "end_ms": 252730,
      "text": "培养独立思考的能力。",
      "token_start": 1193,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 253030,
      "end_ms": 253950,
      "text": "家里有孩子的，",
      "token_start": 1202,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 253950,
      "end_ms": 255050,
      "text": "真的可以准备一套，",
