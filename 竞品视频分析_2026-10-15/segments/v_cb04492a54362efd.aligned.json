  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1470,
      "text": "你酒量挺好的呀，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1890,
      "end_ms": 3450,
      "text": "领导您可抬举我了，",
      "token_start": 7,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3590,
      "end_ms": 4830,
      "text": "我平时这么太能喝，",
      "token_start": 15,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5050,
      "end_ms": 6750,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 23,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 6770,
      "end_ms": 7350,
      "text": "高兴啊，",
      "token_start": 34,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 7370,
      "end_ms": 8850,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 37,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 10130,
      "end_ms": 11490,
      "text": "这藕是好藕啊，",
      "token_start": 47,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 12210,
      "end_ms": 14030,
      "text": "就是心眼儿太多了。",
      "token_start": 53,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 14030,
      "end_ms": 15750,
      "text": "领导菜虽然心眼多，",
      "token_start": 61,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 15950,
      "end_ms": 17370,
      "text": "但也是您的下酒菜啊。",
      "token_start": 69,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 19830,
      "end_ms": 19950,
      "text": "不，",
      "token_start": 78,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 19950,
      "end_ms": 20190,
      "text": "李，",
      "token_start": 79,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 20610,
      "end_ms": 22350,
      "text": "你这菜点的也太多了，",
      "token_start": 80,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 23310,
      "end_ms": 24810,
      "text": "领导菜点的再多，",
      "token_start": 89,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 24810,
      "end_ms": 26310,
      "text": "也比不上平时您对我的照顾。",
      "token_start": 96,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 26310,
      "end_ms": 27210,
      "text": "多这杯酒，",
      "token_start": 108,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 27210,
      "end_ms": 32440,
      "text": "我先敬您领喝哥就是看不起我。",
      "token_start": 112,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 32440,
      "end_ms": 33220,
      "text": "领导，",
      "token_start": 125,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 33220,
      "end_ms": 34420,
      "text": "我不是看不起您，",
      "token_start": 127,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 34920,
      "end_ms": 35920,
      "text": "我是看不起病。",
      "token_start": 134,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 39420,
      "end_ms": 40060,
      "text": "小李啊，",
      "token_start": 140,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 40360,
      "end_ms": 41980,
      "text": "你个子是真高比，",
      "token_start": 143,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 41980,
      "end_ms": 43000,
      "text": "我还高一头呢。",
      "token_start": 150,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 43300,
      "end_ms": 44900,
      "text": "个高是为了给领导探路，",
      "token_start": 156,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 45080,
      "end_ms": 47020,
      "text": "走哪儿还还得听领导指挥吗？",
      "token_start": 166,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 48520,
      "end_ms": 48700,
      "text": "来，",
      "token_start": 178,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 48700,
      "end_ms": 49180,
      "text": "这么晚，",
      "token_start": 179,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 49380,
      "end_ms": 50560,
      "text": "只能吃剩菜了吧。",
      "token_start": 182,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 50880,
      "end_ms": 52620,
      "text": "领导饭在哪我都能吃，",
      "token_start": 189,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 52800,
      "end_ms": 54760,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 198,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 54760,
      "end_ms": 56260,
      "text": "能赶上已经是我的运气了，",
      "token_start": 211,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 58500,
      "end_ms": 60010,
      "text": "个就来带什么礼物，",
      "token_start": 222,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 60030,
      "end_ms": 60205,
      "text": "哇，",
      "token_start": 230,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 60370,
      "end_ms": 61085,
      "text": "都不是外人。",
      "token_start": 231,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 61510,
      "end_ms": 61890,
      "text": "领导，",
      "token_start": 236,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 62110,
      "end_ms": 62730,
      "text": "您都说了，",
      "token_start": 238,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 62730,
      "end_ms": 63310,
      "text": "不是外人，",
      "token_start": 242,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 63450,
      "end_ms": 64730,
      "text": "我一直都把您当长辈看，",
      "token_start": 246,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 64790,
      "end_ms": 67105,
      "text": "哪有晚辈看长辈空手来的道理啊，",
      "token_start": 256,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 68830,
      "end_ms": 70135,
      "text": "年轻就是好啊，",
      "token_start": 270,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 70570,
      "end_ms": 72015,
      "text": "年轻就是还不够沉稳，",
      "token_start": 276,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 72370,
      "end_ms": 73515,
      "text": "还要向您多学习，",
      "token_start": 285,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 73740,
      "end_ms": 75095,
      "text": "我们才能变得更优秀。",
      "token_start": 292,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 76710,
      "end_ms": 77465,
      "text": "哈哈哈哈，",
      "token_start": 301,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 77810,
      "end_ms": 78935,
      "text": "我真不怎么喜欢你，",
      "token_start": 305,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 79940,
      "end_ms": 81940,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 313,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 81940,
      "end_ms": 84335,
      "text": "我领导的格局值得我们学习。",
      "token_start": 326,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 85900,
      "end_ms": 87340,
      "text": "哈哈哈啊啊，",
      "token_start": 338,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 87540,
      "end_ms": 88100,
      "text": "关注我，",
      "token_start": 343,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 88260,
      "end_ms": 89400,
      "text": "每天学点高情商，",
      "token_start": 346,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 89400,
      "end_ms": 90105,
      "text": "说话技巧，",
      "token_start": 353,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 90430,
      "end_ms": 92045,
      "text": "让你的路越走越宽。",
      "token_start": 357,
      "token_end_exclusive": 365
    }
  ],
