{
  "video_id": "v_332b3a33025e2e43",
  "duration_s": 606.830998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_332b3a33025e2e43.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_332b3a33025e2e43.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 330,
      "end_ms": 1010,
      "text": "老话说，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 1430,
      "end_ms": 3510,
      "text": "地上文物看山西，",
      "token_start": 3,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 4310,
      "end_ms": 7230,
      "text": "可您知道山西那么多国宝古剑，",
      "token_start": 10,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 7530,
      "end_ms": 10270,
      "text": "最不可思议的到底是哪一座吗？",
      "token_start": 23,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 10630,
      "end_ms": 11130,
      "text": "上集，",
      "token_start": 36,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 11130,
      "end_ms": 12430,
      "text": "咱们聊了镇国寺，",
      "token_start": 38,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12530,
      "end_ms": 18830,
      "text": "崇明寺崇福寺圣母殿、永乐宫三清殿这集直接揭开谜底，",
      "token_start": 45,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 19330,
      "end_ms": 22350,
      "text": "看看前五名不可思议到什么程度，",
      "token_start": 68,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 22750,
      "end_ms": 25050,
      "text": "尤其是排在榜首的那座，",
      "token_start": 82,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25650,
      "end_ms": 27930,
      "text": "全身上下不用一颗铁钉。",
      "token_start": 92,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 28850,
      "end_ms": 29845,
      "text": "近千年里，",
      "token_start": 102,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 30080,
      "end_ms": 31280,
      "text": "经历过几十次，",
      "token_start": 106,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 31280,
      "end_ms": 31860,
      "text": "大地震，",
      "token_start": 112,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 32280,
      "end_ms": 35700,
      "text": "靠着五十四种木笋关节化解冲击。",
      "token_start": 115,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 36080,
      "end_ms": 36840,
      "text": "话不多说，",
      "token_start": 129,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 37200,
      "end_ms": 38400,
      "text": "茶给您沏好了，",
      "token_start": 133,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 38740,
      "end_ms": 40740,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 139,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 41160,
      "end_ms": 42240,
      "text": "咱们这就开讲。",
      "token_start": 149,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 42560,
      "end_ms": 43260,
      "text": "第五名，",
      "token_start": 155,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 44000,
      "end_ms": 45840,
      "text": "大同浑源、悬空寺，",
      "token_start": 158,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 46260,
      "end_ms": 47220,
      "text": "山西大同，",
      "token_start": 165,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 47940,
      "end_ms": 50760,
      "text": "他挂在衡山金龙峡的绝壁上，",
      "token_start": 169,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 51480,
      "end_ms": 52800,
      "text": "离地几十米，",
      "token_start": 181,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 53100,
      "end_ms": 55740,
      "text": "北魏就开始修一千五百年，",
      "token_start": 186,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 56280,
      "end_ms": 57320,
      "text": "您站在谷底，",
      "token_start": 197,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 57320,
      "end_ms": 62055,
      "text": "往上望几十根细木户顶着一整座楼阁，",
      "token_start": 202,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 62670,
      "end_ms": 64025,
      "text": "腿肚子都要发软，",
      "token_start": 218,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 64550,
      "end_ms": 65505,
      "text": "可您被骗了。",
      "token_start": 225,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 65920,
      "end_ms": 70465,
      "text": "当年的工匠是把桐油浸泡过的铁杉木横梁，",
      "token_start": 230,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 70960,
      "end_ms": 75420,
      "text": "一根一根深深凿进岩石里半插飞良，",
      "token_start": 248,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 75700,
      "end_ms": 77565,
      "text": "那才是真正的承重。",
      "token_start": 263,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 78280,
      "end_ms": 81660,
      "text": "底下那些细柱子多半是给您壮胆，",
      "token_start": 271,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 81660,
      "end_ms": 85015,
      "text": "用的这座寺不是撑在悬崖上，",
      "token_start": 285,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 85460,
      "end_ms": 87435,
      "text": "是挂在岩石的骨头里。",
      "token_start": 297,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 88160,
      "end_ms": 92865,
      "text": "一千五百年的视觉骗局骗过了多少代人？",
      "token_start": 306,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 93640,
      "end_ms": 96585,
      "text": "您说古代工匠是不是太懂人心了？",
      "token_start": 323,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 96950,
      "end_ms": 97765,
      "text": "第四名，",
      "token_start": 337,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 98200,
      "end_ms": 101505,
      "text": "万荣飞云楼山西运城万荣。",
      "token_start": 340,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 102270,
      "end_ms": 105885,
      "text": "他在东岳庙里是明代的纯木楼阁，",
      "token_start": 351,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 106410,
      "end_ms": 108135,
      "text": "通高将近二十三米。",
      "token_start": 365,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 108510,
      "end_ms": 109695,
      "text": "三层四言，",
      "token_start": 373,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 110100,
      "end_ms": 111095,
      "text": "您走到楼下，",
      "token_start": 377,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 111450,
      "end_ms": 112950,
      "text": "头顶层层叠叠。",
      "token_start": 382,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 112950,
      "end_ms": 113785,
      "text": "全是斗拱，",
      "token_start": 388,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 114250,
      "end_ms": 115815,
      "text": "一共三百四十五朵，",
      "token_start": 392,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 116620,
      "end_ms": 117420,
      "text": "没有两朵，",
      "token_start": 400,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 117420,
      "end_ms": 118215,
      "text": "长得一样，",
      "token_start": 404,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 118960,
      "end_ms": 121125,
      "text": "整座楼没用一颗铁钉。",
      "token_start": 408,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 121970,
      "end_ms": 125660,
      "text": "全靠木头自己有何四角的飞檐？",
      "token_start": 417,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 125740,
      "end_ms": 127145,
      "text": "一层一层翘出去，",
      "token_start": 430,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 127640,
      "end_ms": 128725,
      "text": "远远看去，",
      "token_start": 437,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 129110,
      "end_ms": 131155,
      "text": "像一朵停在半空的云，",
      "token_start": 441,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 131800,
      "end_ms": 133385,
      "text": "所以才叫飞云楼。",
      "token_start": 450,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 134130,
      "end_ms": 135575,
      "text": "三百多个小木块，",
      "token_start": 457,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 136040,
      "end_ms": 137915,
      "text": "拼出一座空中楼阁，",
      "token_start": 464,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 138610,
      "end_ms": 141025,
      "text": "被人誉为中华第一木楼。",
      "token_start": 472,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 141450,
      "end_ms": 143055,
      "text": "他不像是盖出来的，",
      "token_start": 482,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 143540,
      "end_ms": 145020,
      "text": "倒像是木头，",
      "token_start": 490,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 145040,
      "end_ms": 146545,
      "text": "自己长成了一朵云。",
      "token_start": 495,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 147450,
      "end_ms": 148595,
      "text": "这份精巧，",
      "token_start": 503,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 149070,
      "end_ms": 150110,
      "text": "您说是不是美的，",
      "token_start": 507,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 150110,
      "end_ms": 151145,
      "text": "让人不敢眨眼。",
      "token_start": 514,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 151550,
      "end_ms": 152230,
      "text": "第三名，",
      "token_start": 520,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 152530,
      "end_ms": 155540,
      "text": "运城解州关帝庙春秋楼，",
      "token_start": 523,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 155760,
      "end_ms": 160185,
      "text": "山西运城解州界州是关羽的老家，",
      "token_start": 533,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 160710,
      "end_ms": 164125,
      "text": "春秋楼里供着关公夜读春秋的像。",
      "token_start": 547,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 164820,
      "end_ms": 167840,
      "text": "这座楼有个让行家都服气的绝活，",
      "token_start": 561,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 168100,
      "end_ms": 169615,
      "text": "叫悬梁吊柱。",
      "token_start": 575,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 170080,
      "end_ms": 173585,
      "text": "楼上一圈回廊的柱子居然不落地，",
      "token_start": 580,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 174150,
      "end_ms": 175935,
      "text": "一根根悬在半空，",
      "token_start": 594,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 176830,
      "end_ms": 178495,
      "text": "您要是在楼里走一圈，",
      "token_start": 601,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 178860,
      "end_ms": 180985,
      "text": "伸手就能从柱子底下穿过去。",
      "token_start": 610,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 181440,
      "end_ms": 183335,
      "text": "上层的重盐那么重，",
      "token_start": 622,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 184140,
      "end_ms": 189020,
      "text": "全靠垂铸和暗损一层一层吊着漂亮，",
      "token_start": 630,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 189710,
      "end_ms": 192215,
      "text": "看惯了悬空寺挂在崖上，",
      "token_start": 645,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 192860,
      "end_ms": 195845,
      "text": "谁见过大楼里的柱子挂在半空，",
      "token_start": 655,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 196330,
      "end_ms": 198415,
      "text": "柱子必须落地才能承重。",
      "token_start": 668,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 199250,
      "end_ms": 201385,
      "text": "这条咱们脑子里的老规矩，",
      "token_start": 678,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 201750,
      "end_ms": 204485,
      "text": "在这座楼里被一把推翻了。",
      "token_start": 689,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 205100,
      "end_ms": 206385,
      "text": "这不是机关，",
      "token_start": 700,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 207010,
      "end_ms": 209765,
      "text": "这是把力学玩到了神仙地步。",
      "token_start": 705,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 210170,
      "end_ms": 210750,
      "text": "第二名，",
      "token_start": 717,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 211050,
      "end_ms": 213085,
      "text": "五台山佛光寺东大殿，",
      "token_start": 720,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 213410,
      "end_ms": 214595,
      "text": "山西忻州。",
      "token_start": 729,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 215350,
      "end_ms": 218765,
      "text": "这是唐大宗十一年留下来的皇家墓构大殿，",
      "token_start": 733,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 219400,
      "end_ms": 223025,
      "text": "也是全中国现存体量最大的盛唐墓构。",
      "token_start": 751,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 223440,
      "end_ms": 228315,
      "text": "当年日本学者断言中国本土绝无唐代木构建筑。",
      "token_start": 767,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 228840,
      "end_ms": 231285,
      "text": "想看唐风只能去耐良。",
      "token_start": 787,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 231800,
      "end_ms": 232935,
      "text": "一九三七年，",
      "token_start": 796,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 233760,
      "end_ms": 236920,
      "text": "梁思成和林徽因两位先生骑着骡子，",
      "token_start": 801,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 236920,
      "end_ms": 238745,
      "text": "翻山越岭来到五台山，",
      "token_start": 816,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 239570,
      "end_ms": 242005,
      "text": "在被臭虫咬的遍体鳞伤。",
      "token_start": 825,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 242600,
      "end_ms": 248705,
      "text": "蝙蝠粪便堆积如山的漆黑梁架上借着手电筒的一点微光，",
      "token_start": 835,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 249100,
      "end_ms": 254205,
      "text": "在幕梁上摸出了女弟子宁公寓的唐代墨书题记，",
      "token_start": 859,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 255040,
      "end_ms": 258180,
      "text": "彻底粉碎了外国学者的轻蔑。",
      "token_start": 879,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 258220,
      "end_ms": 258805,
      "text": "断言，",
      "token_start": 891,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 259260,
      "end_ms": 261080,
      "text": "那单体挑出近四米，",
      "token_start": 893,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 261100,
      "end_ms": 263160,
      "text": "如同雄鹰展翅的七步，",
      "token_start": 901,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 263160,
      "end_ms": 264305,
      "text": "做巨大斗拱，",
      "token_start": 910,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 265010,
      "end_ms": 267945,
      "text": "撑起的不仅是一座唐代佛殿，",
      "token_start": 915,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 268490,
      "end_ms": 272875,
      "text": "更是属于我们中华民族刻在木头里的铮铮傲骨。",
      "token_start": 927,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 273310,
      "end_ms": 274230,
      "text": "第五到第二，",
      "token_start": 947,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 274230,
      "end_ms": 275690,
      "text": "讲完了揭晓。",
      "token_start": 952,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 275690,
      "end_ms": 276475,
      "text": "投名前，",
      "token_start": 957,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 277180,
      "end_ms": 278765,
      "text": "我先唠几句心里话，",
      "token_start": 960,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 279130,
      "end_ms": 279770,
      "text": "评论区里，",
      "token_start": 968,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 279770,
      "end_ms": 281685,
      "text": "不少朋友说的话特别一致，",
      "token_start": 972,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 282210,
      "end_ms": 283555,
      "text": "说也去过山西，",
      "token_start": 983,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 284000,
      "end_ms": 286225,
      "text": "进过佛光寺晋过晋祠，",
      "token_start": 989,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 286870,
      "end_ms": 289295,
      "text": "可站在殿前光顾着拍照了。",
      "token_start": 998,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 289730,
      "end_ms": 292010,
      "text": "头顶上的一层压一层的斗拱，",
      "token_start": 1009,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 292010,
      "end_ms": 293500,
      "text": "叫什么粮价，",
      "token_start": 1021,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 293620,
      "end_ms": 294665,
      "text": "怎么搭起来的，",
      "token_start": 1026,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 295160,
      "end_ms": 296070,
      "text": "一句也说不出来，",
      "token_start": 1032,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 296750,
      "end_ms": 297835,
      "text": "回来跟没去一样，",
      "token_start": 1039,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 298560,
      "end_ms": 300225,
      "text": "也有人说老早就想去。",
      "token_start": 1046,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 301050,
      "end_ms": 303765,
      "text": "可山西的古剑散在三晋大地上，",
      "token_start": 1055,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 304300,
      "end_ms": 306175,
      "text": "一处跟一处隔着好几百里。",
      "token_start": 1068,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 306710,
      "end_ms": 308470,
      "text": "不知道该先看哪一处，",
      "token_start": 1079,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 308890,
      "end_ms": 312310,
      "text": "还有人想给孙辈讲讲这老木头的门道，",
      "token_start": 1088,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 312750,
      "end_ms": 315110,
      "text": "可自己翻来覆去就那么几句，",
      "token_start": 1104,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 315570,
      "end_ms": 316250,
      "text": "说不深，",
      "token_start": 1116,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 317090,
      "end_ms": 320210,
      "text": "咱们看古剑早不止图个热闹。",
      "token_start": 1119,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 320610,
      "end_ms": 321830,
      "text": "想弄明白的是，",
      "token_start": 1131,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 321830,
      "end_ms": 323710,
      "text": "这木头里到底藏着什么，",
      "token_start": 1137,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 323710,
      "end_ms": 325470,
      "text": "讲究什么来头，",
      "token_start": 1147,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 325890,
      "end_ms": 328830,
      "text": "可这些东西手机上刷两条就忘。",
      "token_start": 1153,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 329110,
      "end_ms": 332290,
      "text": "网上查东一块西一块术语还绕口，",
      "token_start": 1166,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 332610,
      "end_ms": 334270,
      "text": "抱起专业书图，",
      "token_start": 1180,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 334270,
      "end_ms": 334930,
      "text": "小字秘，",
      "token_start": 1186,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 335130,
      "end_ms": 336365,
      "text": "眼睛先吃不消。",
      "token_start": 1189,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 337020,
      "end_ms": 337600,
      "text": "前阵子，",
      "token_start": 1195,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 337600,
      "end_ms": 339260,
      "text": "我翻到一本对路的书，",
      "token_start": 1198,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 339660,
      "end_ms": 341840,
      "text": "叫了不起的山西古建筑，",
      "token_start": 1207,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 342480,
      "end_ms": 345240,
      "text": "跟着仿古女神连连打卡。",
      "token_start": 1217,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 345300,
      "end_ms": 346560,
      "text": "山西国宝遗存。",
      "token_start": 1227,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 347000,
      "end_ms": 347580,
      "text": "作者，",
      "token_start": 1233,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 347620,
      "end_ms": 350760,
      "text": "王慧莲仿古走了二十多年，",
      "token_start": 1235,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 351420,
      "end_ms": 355480,
      "text": "把把山西五十多处国宝古建理的清清楚楚，",
      "token_start": 1246,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 356060,
      "end_ms": 358520,
      "text": "把一处都是高清大图打头，",
      "token_start": 1264,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 359220,
      "end_ms": 361100,
      "text": "然后是大白话讲解，",
      "token_start": 1275,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 361700,
      "end_ms": 364640,
      "text": "把这一处后面的门道掰开了，",
      "token_start": 1283,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 365100,
      "end_ms": 365860,
      "text": "揉碎了，",
      "token_start": 1295,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 365860,
      "end_ms": 369295,
      "text": "全全部讲给您听一处几百字，",
      "token_start": 1298,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 369700,
      "end_ms": 371035,
      "text": "讲的明明白白，",
      "token_start": 1310,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 371700,
      "end_ms": 376345,
      "text": "里头还收了梁思成先生当年一笔一笔手绘的建筑图，",
      "token_start": 1316,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 377040,
      "end_ms": 379015,
      "text": "还有营造学社的老照片。",
      "token_start": 1338,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 379450,
      "end_ms": 380815,
      "text": "我自己是这么用的，",
      "token_start": 1348,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 381190,
      "end_ms": 382475,
      "text": "能动身去的，",
      "token_start": 1356,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 382770,
      "end_ms": 384255,
      "text": "出门前翻两页，",
      "token_start": 1361,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 384590,
      "end_ms": 385510,
      "text": "站到殿前，",
      "token_start": 1367,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 385530,
      "end_ms": 386485,
      "text": "心里就有底，",
      "token_start": 1371,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 386820,
      "end_ms": 388875,
      "text": "看见的就不是一堆旧木头，",
      "token_start": 1376,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 389240,
      "end_ms": 392165,
      "text": "是活生生的门道去不了的。",
      "token_start": 1387,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 392490,
      "end_ms": 396585,
      "text": "沏壶热茶就着大图和文字慢慢看，",
      "token_start": 1398,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 397210,
      "end_ms": 399595,
      "text": "也算把三晋大地走了一遭，",
      "token_start": 1412,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 400360,
      "end_ms": 401365,
      "text": "搁在茶几上。",
      "token_start": 1423,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 401720,
      "end_ms": 403285,
      "text": "孙辈随手翻两眼，",
      "token_start": 1428,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 403690,
      "end_ms": 404485,
      "text": "长见识，",
      "token_start": 1435,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 404840,
      "end_ms": 406565,
      "text": "写作文都用得上，",
      "token_start": 1438,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 406930,
      "end_ms": 408545,
      "text": "老两口晚上翻翻，",
      "token_start": 1445,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 409100,
      "end_ms": 409580,
      "text": "商量，",
      "token_start": 1452,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 409600,
      "end_ms": 410580,
      "text": "明年去一趟。",
      "token_start": 1454,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 410580,
      "end_ms": 411195,
      "text": "山西。",
      "token_start": 1459,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 411950,
      "end_ms": 413895,
      "text": "比刷手机有意思多了，",
      "token_start": 1461,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 414460,
      "end_ms": 416935,
      "text": "房子会旧积蓄会花完。",
      "token_start": 1470,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 417470,
      "end_ms": 419685,
      "text": "可老祖宗留下来的文化底蕴，",
      "token_start": 1479,
      "token_end_exclusive": 1491
    },
    {
      "start_ms": 420170,
      "end_ms": 422355,
      "text": "传多少代都贬不了职，",
      "token_start": 1491,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 422750,
      "end_ms": 425735,
      "text": "这根脉一旦断了课就不好接了。",
      "token_start": 1500,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 426300,
      "end_ms": 429560,
      "text": "感兴趣的朋友下方小黄车点进去看看，",
      "token_start": 1513,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 430120,
      "end_ms": 431540,
      "text": "眼下走不到山西，",
      "token_start": 1529,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 431920,
      "end_ms": 435240,
      "text": "咱就先把这部活着的建筑史书请进屋里，",
      "token_start": 1536,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 435540,
      "end_ms": 436920,
      "text": "好说回正题。",
      "token_start": 1553,
      "token_end_exclusive": 1558
    },
    {
      "start_ms": 437280,
      "end_ms": 437880,
      "text": "第一名，",
      "token_start": 1558,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 438260,
      "end_ms": 439380,
      "text": "应县木塔，",
      "token_start": 1561,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 439880,
      "end_ms": 443080,
      "text": "山西朔州、应县为什么是它？",
      "token_start": 1565,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 443460,
      "end_ms": 448880,
      "text": "因为它是全人类建筑史上唯一把木头力学推向物理神话的奇迹。",
      "token_start": 1576,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 449300,
      "end_ms": 452000,
      "text": "整座塔高达六十七点三一米，",
      "token_start": 1603,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 452640,
      "end_ms": 458310,
      "text": "相当于二十多层摩天大楼的高度耗费了三千多立方米。",
      "token_start": 1615,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 458350,
      "end_ms": 461670,
      "text": "红松木料通体没用一根铁钉。",
      "token_start": 1638,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 462050,
      "end_ms": 463470,
      "text": "公元一零五六年，",
      "token_start": 1650,
      "token_end_exclusive": 1657
    },
    {
      "start_ms": 463530,
      "end_ms": 465250,
      "text": "辽代工匠修建他时，",
      "token_start": 1657,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 465750,
      "end_ms": 468670,
      "text": "独创了八面双层套筒结构，",
      "token_start": 1665,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 469170,
      "end_ms": 473150,
      "text": "全塔塞进的多达五十四种不同形式的斗拱。",
      "token_start": 1676,
      "token_end_exclusive": 1694
    },
    {
      "start_ms": 473490,
      "end_ms": 475670,
      "text": "这些斗拱不是简单的斗拱，",
      "token_start": 1694,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 476490,
      "end_ms": 482010,
      "text": "而是几百个能伸缩、能吸能的巨型木质弹簧。",
      "token_start": 1705,
      "token_end_exclusive": 1723
    },
    {
      "start_ms": 482510,
      "end_ms": 483510,
      "text": "近千年来，",
      "token_start": 1723,
      "token_end_exclusive": 1727
    },
    {
      "start_ms": 484170,
      "end_ms": 486060,
      "text": "塞北经历了四十多层，",
      "token_start": 1727,
      "token_end_exclusive": 1736
    },
    {
      "start_ms": 486140,
      "end_ms": 487205,
      "text": "是强烈地震。",
      "token_start": 1736,
      "token_end_exclusive": 1741
    },
    {
      "start_ms": 487850,
      "end_ms": 491400,
      "text": "方圆几十里房屋荡平木塔，",
      "token_start": 1741,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 491460,
      "end_ms": 492655,
      "text": "只是微微摇晃。",
      "token_start": 1752,
      "token_end_exclusive": 1758
    },
    {
      "start_ms": 493240,
      "end_ms": 497025,
      "text": "民国军阀混战两百多发真实的炮弹。",
      "token_start": 1758,
      "token_end_exclusive": 1773
    },
    {
      "start_ms": 497290,
      "end_ms": 498250,
      "text": "正面打穿，",
      "token_start": 1773,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 498270,
      "end_ms": 500175,
      "text": "他身炸断了大梁，",
      "token_start": 1777,
      "token_end_exclusive": 1784
    },
    {
      "start_ms": 500660,
      "end_ms": 502505,
      "text": "他吃下所有充饥，",
      "token_start": 1784,
      "token_end_exclusive": 1791
    },
    {
      "start_ms": 503020,
      "end_ms": 505660,
      "text": "依旧巍然矗立在苍茫。",
      "token_start": 1791,
      "token_end_exclusive": 1800
    },
    {
      "start_ms": 505780,
      "end_ms": 506715,
      "text": "天地之间，",
      "token_start": 1800,
      "token_end_exclusive": 1804
    },
    {
      "start_ms": 507140,
      "end_ms": 510565,
      "text": "现代建筑力学家用电脑建模反复计算，",
      "token_start": 1804,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 511080,
      "end_ms": 511955,
      "text": "不得不承认，",
      "token_start": 1820,
      "token_end_exclusive": 1825
    },
    {
      "start_ms": 512400,
      "end_ms": 514735,
      "text": "这根本不是樊间的手艺。",
      "token_start": 1825,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 515570,
      "end_ms": 521375,
      "text": "这是千年前东方工匠用木头与天地风雷完成的一场漫长较量。",
      "token_start": 1835,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 521840,
      "end_ms": 525990,
      "text": "十座三进古墓构讲完了镇国寺的大斗拱，",
      "token_start": 1861,
      "token_end_exclusive": 1878
    },
    {
      "start_ms": 526130,
      "end_ms": 530295,
      "text": "称其五代崇明寺的断粮断了一千年，",
      "token_start": 1878,
      "token_end_exclusive": 1893
    },
    {
      "start_ms": 530960,
      "end_ms": 533005,
      "text": "重福寺抽调八根柱子。",
      "token_start": 1893,
      "token_end_exclusive": 1902
    },
    {
      "start_ms": 533460,
      "end_ms": 535475,
      "text": "圣母殿的慕容千年不烂，",
      "token_start": 1902,
      "token_end_exclusive": 1912
    },
    {
      "start_ms": 536160,
      "end_ms": 538340,
      "text": "永乐宫大殿拆散搬迁，",
      "token_start": 1912,
      "token_end_exclusive": 1921
    },
    {
      "start_ms": 538520,
      "end_ms": 539400,
      "text": "异地重圆，",
      "token_start": 1921,
      "token_end_exclusive": 1925
    },
    {
      "start_ms": 539820,
      "end_ms": 541800,
      "text": "悬空寺暗藏飞梁，",
      "token_start": 1925,
      "token_end_exclusive": 1932
    },
    {
      "start_ms": 542160,
      "end_ms": 544180,
      "text": "挂在绝壁飞云楼，",
      "token_start": 1932,
      "token_end_exclusive": 1939
    },
    {
      "start_ms": 544200,
      "end_ms": 547095,
      "text": "是三百四十五朵斗拱拼出的云，",
      "token_start": 1939,
      "token_end_exclusive": 1952
    },
    {
      "start_ms": 547520,
      "end_ms": 550355,
      "text": "春秋楼悬梁吊著机巧通神。",
      "token_start": 1952,
      "token_end_exclusive": 1963
    },
    {
      "start_ms": 550770,
      "end_ms": 552150,
      "text": "佛光寺东大殿，",
      "token_start": 1963,
      "token_end_exclusive": 1969
    },
    {
      "start_ms": 552210,
      "end_ms": 554715,
      "text": "盛堂斗拱撑起民族骨气。",
      "token_start": 1969,
      "token_end_exclusive": 1979
    },
    {
      "start_ms": 555160,
      "end_ms": 559895,
      "text": "可只有应县木塔把千万块木骨化作弹簧，",
      "token_start": 1979,
      "token_end_exclusive": 1996
    },
    {
      "start_ms": 560550,
      "end_ms": 561630,
      "text": "接下了天灾，",
      "token_start": 1996,
      "token_end_exclusive": 2001
    },
    {
      "start_ms": 561670,
      "end_ms": 563385,
      "text": "战火的百般摧折，",
      "token_start": 2001,
      "token_end_exclusive": 2008
    },
    {
      "start_ms": 563840,
      "end_ms": 567415,
      "text": "至今依然傲视全人类的幕构巅峰。",
      "token_start": 2008,
      "token_end_exclusive": 2022
    },
    {
      "start_ms": 567920,
      "end_ms": 569285,
      "text": "您说什么叫不可思议？",
      "token_start": 2022,
      "token_end_exclusive": 2031
    },
    {
      "start_ms": 569770,
      "end_ms": 571190,
      "text": "最不可思议的，",
      "token_start": 2031,
      "token_end_exclusive": 2037
    },
    {
      "start_ms": 571190,
      "end_ms": 573775,
      "text": "从来不是盖的有多奢华，",
      "token_start": 2037,
      "token_end_exclusive": 2047
    },
    {
      "start_ms": 574370,
      "end_ms": 576815,
      "text": "而是在没有钢筋水泥的年代，",
      "token_start": 2047,
      "token_end_exclusive": 2059
    },
    {
      "start_ms": 577300,
      "end_ms": 581044,
      "text": "老祖宗单凭最朴素的木料与榫卯，",
      "token_start": 2059,
      "token_end_exclusive": 2073
    },
    {
      "start_ms": 581610,
      "end_ms": 585125,
      "text": "就给岁月留下了摧不垮的脊梁。",
      "token_start": 2073,
      "token_end_exclusive": 2086
    },
    {
      "start_ms": 585540,
      "end_ms": 587195,
      "text": "这十座山西木构，",
      "token_start": 2086,
      "token_end_exclusive": 2093
    },
    {
      "start_ms": 587770,
      "end_ms": 591415,
      "text": "您去过哪几座最想去哪一座？",
      "token_start": 2093,
      "token_end_exclusive": 2105
    },
    {
      "start_ms": 592080,
      "end_ms": 597895,
      "text": "刚才说的那本了不起的山西古建筑橱窗和左下角小黄车都有，",
      "token_start": 2105,
      "token_end_exclusive": 2131
    },
    {
      "start_ms": 598470,
      "end_ms": 600050,
      "text": "喜欢看老建筑的朋友，",
      "token_start": 2131,
      "token_end_exclusive": 2140
    },
    {
      "start_ms": 600050,
      "end_ms": 603800,
      "text": "别错过想听更多古代工匠的传奇神迹。",
      "token_start": 2140,
      "token_end_exclusive": 2156
    },
    {
      "start_ms": 604000,
      "end_ms": 604855,
      "text": "点个关注，",
      "token_start": 2156,
      "token_end_exclusive": 2160
    },
    {
      "start_ms": 605140,
      "end_ms": 606515,
      "text": "咱们下期接着聊。",
      "token_start": 2160,
      "token_end_exclusive": 2167
    }
  ],
