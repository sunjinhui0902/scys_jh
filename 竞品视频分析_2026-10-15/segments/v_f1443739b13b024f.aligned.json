{
  "video_id": "v_f1443739b13b024f",
  "duration_s": 513.375,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f1443739b13b024f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f1443739b13b024f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 4330,
      "text": "上集说到一九四八年，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 5090,
      "end_ms": 7570,
      "text": "钱三强放弃了法国的一切，",
      "token_start": 9,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 8390,
      "end_ms": 12950,
      "text": "抱着半岁的女儿带着十几箱器材和图书。",
      "token_start": 20,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 13930,
      "end_ms": 16490,
      "text": "在海上颠簸了一个月，",
      "token_start": 37,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 16830,
      "end_ms": 19890,
      "text": "零两天回到了一穷二白的中国。",
      "token_start": 46,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 20790,
      "end_ms": 24330,
      "text": "很多人以为末奖级的科学家回国，",
      "token_start": 59,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 24530,
      "end_ms": 25950,
      "text": "肯定是要风得风，",
      "token_start": 73,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 25950,
      "end_ms": 26710,
      "text": "要雨得雨。",
      "token_start": 80,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 28230,
      "end_ms": 28690,
      "text": "没有，",
      "token_start": 84,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 29010,
      "end_ms": 32585,
      "text": "当时中国的原子能事业是一张白纸，",
      "token_start": 86,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 33490,
      "end_ms": 36050,
      "text": "要设备、没设备、要资料、没资料，",
      "token_start": 101,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 36530,
      "end_ms": 40010,
      "text": "连螺丝刀电阻都难以寻觅。",
      "token_start": 113,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 40930,
      "end_ms": 45270,
      "text": "钱三强带着人跑遍北京的旧货市场和废品站，",
      "token_start": 124,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 45370,
      "end_ms": 48550,
      "text": "搜罗可用零件动手组装仪器，",
      "token_start": 143,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 48950,
      "end_ms": 53110,
      "text": "造出了改革计数器、静电加速器等关键设备。",
      "token_start": 155,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 53530,
      "end_ms": 55130,
      "text": "但钱三强回国后，",
      "token_start": 173,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 55170,
      "end_ms": 56930,
      "text": "做的最重要的一件事，",
      "token_start": 180,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 57290,
      "end_ms": 58430,
      "text": "不是搞科研，",
      "token_start": 189,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 59030,
      "end_ms": 59955,
      "text": "是找人。",
      "token_start": 194,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 60730,
      "end_ms": 61650,
      "text": "一九五八年，",
      "token_start": 197,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 61910,
      "end_ms": 64255,
      "text": "钱三强把邓稼先叫到办公室，",
      "token_start": 202,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 64590,
      "end_ms": 65365,
      "text": "说了一句话，",
      "token_start": 214,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 65710,
      "end_ms": 68175,
      "text": "小邓国家要放一个大炮仗，",
      "token_start": 219,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 68550,
      "end_ms": 70515,
      "text": "准备调你去做这项工作。",
      "token_start": 230,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 71060,
      "end_ms": 73740,
      "text": "邓稼先从此隐姓埋名了。",
      "token_start": 240,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 73860,
      "end_ms": 74735,
      "text": "二十八年，",
      "token_start": 250,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 75490,
      "end_ms": 76410,
      "text": "一九六一年，",
      "token_start": 254,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 76570,
      "end_ms": 77775,
      "text": "他又找到了渔民。",
      "token_start": 259,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 78210,
      "end_ms": 80310,
      "text": "俞敏当时只是个副研究员，",
      "token_start": 266,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 80490,
      "end_ms": 81430,
      "text": "没有留过洋，",
      "token_start": 277,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 81710,
      "end_ms": 82935,
      "text": "很多人不服，",
      "token_start": 282,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 83420,
      "end_ms": 85680,
      "text": "但钱三强力排众议，",
      "token_start": 287,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 85960,
      "end_ms": 87465,
      "text": "押上自己的信誉，",
      "token_start": 295,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 87750,
      "end_ms": 91645,
      "text": "把清淡理论预先研究的重担交给了他。",
      "token_start": 302,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 92210,
      "end_ms": 92690,
      "text": "后来，",
      "token_start": 318,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 92890,
      "end_ms": 96055,
      "text": "于敏被称为中国清弹之父，",
      "token_start": 320,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 96670,
      "end_ms": 98315,
      "text": "你知道这意味着什么吗？",
      "token_start": 331,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 98830,
      "end_ms": 105075,
      "text": "二十三位两弹一星元勋中有十五位是前三强动员回国的，",
      "token_start": 341,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 105880,
      "end_ms": 115915,
      "text": "其中七位是他直接推荐到核武器研制第一线的邓稼先、王淦昌、彭焕武、朱光亚、周光昭。",
      "token_start": 365,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 116400,
      "end_ms": 119700,
      "text": "这些后来撑起中国和天空的名字，",
      "token_start": 400,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 119800,
      "end_ms": 121955,
      "text": "个个都受过他的举荐与支持。",
      "token_start": 414,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 122940,
      "end_ms": 125775,
      "text": "美国情报部门摸清这一点之后才明白，",
      "token_start": 426,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 126610,
      "end_ms": 128925,
      "text": "就算你炸掉一座研究所，",
      "token_start": 442,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 129490,
      "end_ms": 130665,
      "text": "一个试验基地，",
      "token_start": 452,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 131490,
      "end_ms": 133635,
      "text": "只要这支人才队伍还在，",
      "token_start": 458,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 134080,
      "end_ms": 136525,
      "text": "中国的核计划就永远炸不了，",
      "token_start": 468,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 137400,
      "end_ms": 141235,
      "text": "这正是他们最后不敢贸然动手的关键原因。",
      "token_start": 480,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 141950,
      "end_ms": 146310,
      "text": "前三强最狠的一步棋是提前布局，",
      "token_start": 498,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 146430,
      "end_ms": 147035,
      "text": "清淡。",
      "token_start": 512,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 147440,
      "end_ms": 150065,
      "text": "原子弹还在艰难攻关的时候，",
      "token_start": 514,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 150510,
      "end_ms": 154245,
      "text": "他就判定氢弹原理与原子弹完全不同，",
      "token_start": 526,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 154750,
      "end_ms": 157570,
      "text": "绝不能等原子弹成功再启动。",
      "token_start": 542,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 157650,
      "end_ms": 159350,
      "text": "他悄悄组建团队，",
      "token_start": 554,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 159870,
      "end_ms": 161485,
      "text": "提前开展预言，",
      "token_start": 561,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 162120,
      "end_ms": 168605,
      "text": "还同步布局了放射化学、核数据、工程、物理等配套领域，",
      "token_start": 567,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 169010,
      "end_ms": 172875,
      "text": "把整个研发的全链条都提前铺好了。",
      "token_start": 589,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 173390,
      "end_ms": 178640,
      "text": "正是这部先手棋换来了中国从原子弹到氢弹，",
      "token_start": 604,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 178960,
      "end_ms": 182135,
      "text": "仅用了二年八个月的世界奇迹。",
      "token_start": 623,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 183000,
      "end_ms": 187575,
      "text": "这个速度记录至今没有其他国家能打破。",
      "token_start": 636,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 188250,
      "end_ms": 189330,
      "text": "一九六四年。",
      "token_start": 653,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 189370,
      "end_ms": 190335,
      "text": "十月十六日，",
      "token_start": 658,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 190700,
      "end_ms": 193895,
      "text": "罗布泊内上空腾起蘑菇云，",
      "token_start": 663,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 194310,
      "end_ms": 197245,
      "text": "中国第一颗原子弹爆炸成功。",
      "token_start": 674,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 197840,
      "end_ms": 199600,
      "text": "你知道这一天是什么日子吗？",
      "token_start": 686,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 199660,
      "end_ms": 200325,
      "text": "这一天，",
      "token_start": 698,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 200860,
      "end_ms": 203985,
      "text": "恰好是前三强五十一岁的生日，",
      "token_start": 701,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 204780,
      "end_ms": 206485,
      "text": "他没有去罗布泊现场，",
      "token_start": 714,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 207220,
      "end_ms": 208815,
      "text": "他守在收音机前，",
      "token_start": 723,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 209220,
      "end_ms": 211300,
      "text": "听到爆炸成功的消息后，",
      "token_start": 730,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 211540,
      "end_ms": 214225,
      "text": "没笑他哭了，",
      "token_start": 740,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 214820,
      "end_ms": 217245,
      "text": "可你知道三天后发生了什么吗？",
      "token_start": 745,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 218120,
      "end_ms": 219015,
      "text": "三天后，",
      "token_start": 758,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 219530,
      "end_ms": 227840,
      "text": "他拎着简单的行李坐上了南下河南的火车被下放到信阳农村插队。",
      "token_start": 761,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 227860,
      "end_ms": 231015,
      "text": "劳动举国欢腾的时候，",
      "token_start": 789,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 231430,
      "end_ms": 233245,
      "text": "他在南下的火车上。",
      "token_start": 798,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 233990,
      "end_ms": 234935,
      "text": "在乡下，",
      "token_start": 806,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 235680,
      "end_ms": 237815,
      "text": "他一边下地干农活，",
      "token_start": 809,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 238500,
      "end_ms": 241510,
      "text": "一边用知识帮乡亲们做事，",
      "token_start": 817,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 241690,
      "end_ms": 244810,
      "text": "牵头建起小型化肥生产装置，",
      "token_start": 828,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 245230,
      "end_ms": 248090,
      "text": "修好村里的农机和发电设备，",
      "token_start": 840,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 248510,
      "end_ms": 251270,
      "text": "还教年轻人学知识、学文化，",
      "token_start": 852,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 251770,
      "end_ms": 253430,
      "text": "身边人为他抱不平。",
      "token_start": 863,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 254150,
      "end_ms": 254870,
      "text": "他总说，",
      "token_start": 871,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 255330,
      "end_ms": 257870,
      "text": "国家的事成了个人受点，",
      "token_start": 874,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 257870,
      "end_ms": 258990,
      "text": "委屈不算什么。",
      "token_start": 884,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 259710,
      "end_ms": 261570,
      "text": "他亲手选出来的人，",
      "token_start": 890,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 261770,
      "end_ms": 263710,
      "text": "在戈壁滩创造历史。",
      "token_start": 898,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 264570,
      "end_ms": 269920,
      "text": "他自己在乡间田野里耗掉了科研生涯最黄金的时机。",
      "token_start": 906,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 269980,
      "end_ms": 271880,
      "text": "几年对自己苛刻，",
      "token_start": 928,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 272060,
      "end_ms": 273260,
      "text": "对家人更严。",
      "token_start": 935,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 273820,
      "end_ms": 276140,
      "text": "儿子下乡插队写信，",
      "token_start": 940,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 276220,
      "end_ms": 279480,
      "text": "想让家里帮忙调回城市前三强，",
      "token_start": 948,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 279540,
      "end_ms": 281460,
      "text": "前前后后回了一百多封信。",
      "token_start": 961,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 281560,
      "end_ms": 283740,
      "text": "没有一封是托关系走后门的，",
      "token_start": 972,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 284400,
      "end_ms": 286239,
      "text": "句句都是让孩子自立。",
      "token_start": 984,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 287000,
      "end_ms": 288640,
      "text": "人生的路要自己走，",
      "token_start": 993,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 289420,
      "end_ms": 290860,
      "text": "靠父母没出息。",
      "token_start": 1001,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 291660,
      "end_ms": 292500,
      "text": "句个子女，",
      "token_start": 1007,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 292500,
      "end_ms": 294080,
      "text": "后来全凭自己的努力，",
      "token_start": 1011,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 294100,
      "end_ms": 295400,
      "text": "考上顶尖大学，",
      "token_start": 1020,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 295900,
      "end_ms": 297380,
      "text": "没一个沾过他的光。",
      "token_start": 1026,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 297940,
      "end_ms": 299120,
      "text": "重回北京后，",
      "token_start": 1034,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 299300,
      "end_ms": 301470,
      "text": "他一就简朴如初，",
      "token_start": 1039,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 301950,
      "end_ms": 305545,
      "text": "组织多次提出给他换更好的住方。",
      "token_start": 1046,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 306110,
      "end_ms": 307890,
      "text": "他次次谢绝了，",
      "token_start": 1060,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 308190,
      "end_ms": 310650,
      "text": "说老房子离图书馆近，",
      "token_start": 1066,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 311330,
      "end_ms": 313350,
      "text": "家里的沙发弹簧塌了，",
      "token_start": 1075,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 313550,
      "end_ms": 315070,
      "text": "用布条缠了又缠，",
      "token_start": 1084,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 315670,
      "end_ms": 319930,
      "text": "冬天穿洗的发白的旧棉袄挤公交上下班。",
      "token_start": 1091,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 320070,
      "end_ms": 320650,
      "text": "有一回，",
      "token_start": 1108,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 320930,
      "end_ms": 323630,
      "text": "他和何泽慧去照相馆拍照，",
      "token_start": 1111,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 324330,
      "end_ms": 328070,
      "text": "摄影师看着眼前衣着朴素的两位老人，",
      "token_start": 1122,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 328310,
      "end_ms": 330990,
      "text": "还打去何泽慧大妈好福气，",
      "token_start": 1138,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 331290,
      "end_ms": 332670,
      "text": "是出国看儿女吧。",
      "token_start": 1149,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 333190,
      "end_ms": 336360,
      "text": "他哪里知道眼前这对普通老人，",
      "token_start": 1156,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 336860,
      "end_ms": 339700,
      "text": "一个是中国核科学的奠基人，",
      "token_start": 1169,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 340180,
      "end_ms": 342640,
      "text": "一个是享誉世界的物理学家。",
      "token_start": 1181,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 343300,
      "end_ms": 345380,
      "text": "一九九二年六月二十八日，",
      "token_start": 1193,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 345840,
      "end_ms": 348560,
      "text": "七十九岁的钱三强在北京离世，",
      "token_start": 1204,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 348980,
      "end_ms": 350300,
      "text": "走的前一天晚上，",
      "token_start": 1217,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 350540,
      "end_ms": 352620,
      "text": "他还在书房修改发言稿，",
      "token_start": 1224,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 352800,
      "end_ms": 353820,
      "text": "熬到了凌晨。",
      "token_start": 1234,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 354300,
      "end_ms": 355440,
      "text": "一九九九年，",
      "token_start": 1239,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 355520,
      "end_ms": 359140,
      "text": "国家隆重表彰两弹一星功勋科学家，",
      "token_start": 1244,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 359300,
      "end_ms": 361720,
      "text": "追授前三强功勋奖章。",
      "token_start": 1259,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 362640,
      "end_ms": 363220,
      "text": "这时候，",
      "token_start": 1268,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 363320,
      "end_ms": 365220,
      "text": "他已经离开整整七年了。",
      "token_start": 1271,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 366440,
      "end_ms": 369925,
      "text": "老同事彭黄武捧着沉甸甸的证书，",
      "token_start": 1281,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 370460,
      "end_ms": 373005,
      "text": "和何泽慧一起来到墓碑前，",
      "token_start": 1295,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 373720,
      "end_ms": 376615,
      "text": "把获奖词一字一句念完，",
      "token_start": 1306,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 377210,
      "end_ms": 378965,
      "text": "深深鞠了三个躬，",
      "token_start": 1316,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 379670,
      "end_ms": 381865,
      "text": "一份迟到七年的荣誉，",
      "token_start": 1323,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 382660,
      "end_ms": 385305,
      "text": "他连亲手摸一摸的机会都没有。",
      "token_start": 1332,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 385920,
      "end_ms": 387990,
      "text": "搭台子的是他出路的，",
      "token_start": 1345,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 387990,
      "end_ms": 390330,
      "text": "是他默默扛下风雨的，",
      "token_start": 1354,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 390330,
      "end_ms": 392130,
      "text": "是他不争不抢的，",
      "token_start": 1363,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 392130,
      "end_ms": 394740,
      "text": "还是他举国欢腾的时候，",
      "token_start": 1370,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 394760,
      "end_ms": 396920,
      "text": "他在南下的火车上勋章，",
      "token_start": 1380,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 397020,
      "end_ms": 398120,
      "text": "搬下来的时候，",
      "token_start": 1390,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 398260,
      "end_ms": 400165,
      "text": "他已经长眠地下，",
      "token_start": 1396,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 400740,
      "end_ms": 404740,
      "text": "他的墓碑上刻着父亲送他的那四个字。",
      "token_start": 1403,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 405020,
      "end_ms": 406355,
      "text": "从牛到爱，",
      "token_start": 1419,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 407260,
      "end_ms": 409875,
      "text": "我们今天能安安稳稳过日子，",
      "token_start": 1423,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 410360,
      "end_ms": 412145,
      "text": "靠的从来不是运气，",
      "token_start": 1435,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 412530,
      "end_ms": 413450,
      "text": "是前三强。",
      "token_start": 1443,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 413530,
      "end_ms": 420535,
      "text": "这样的老一辈拿一辈子的隐忍奉献和牺牲一点点拼出来的底气。",
      "token_start": 1447,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 421190,
      "end_ms": 423845,
      "text": "其实像钱三强这样的人，",
      "token_start": 1474,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 424530,
      "end_ms": 425450,
      "text": "还有很多，",
      "token_start": 1484,
      "token_end_exclusive": 1488
    },
    {
      "start_ms": 425810,
      "end_ms": 427995,
      "text": "他们干着惊天动地的事，",
      "token_start": 1488,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 428440,
      "end_ms": 430315,
      "text": "做着隐姓埋名的人，",
      "token_start": 1498,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 431440,
      "end_ms": 432820,
      "text": "不求名不求利，",
      "token_start": 1506,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 432840,
      "end_ms": 436815,
      "text": "就想让后世子孙能挺直腰杆做人。",
      "token_start": 1512,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 437500,
      "end_ms": 439815,
      "text": "如果你想知道更多他们的故事，",
      "token_start": 1526,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 440160,
      "end_ms": 442260,
      "text": "推荐你看看国之脊梁。",
      "token_start": 1539,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 442280,
      "end_ms": 442955,
      "text": "这本书，",
      "token_start": 1548,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 443680,
      "end_ms": 449405,
      "text": "书里记录了几十位为新中国立下汗马功劳的科学家和建设者。",
      "token_start": 1551,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 450020,
      "end_ms": 451735,
      "text": "有我们熟悉的名字，",
      "token_start": 1577,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 452170,
      "end_ms": 454670,
      "text": "也有像钱三强这样功劳不赏，",
      "token_start": 1585,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 454730,
      "end_ms": 455875,
      "text": "常常被忽略，",
      "token_start": 1597,
      "token_end_exclusive": 1602
    },
    {
      "start_ms": 456300,
      "end_ms": 458615,
      "text": "却同样不该被遗忘的人。",
      "token_start": 1602,
      "token_end_exclusive": 1612
    },
    {
      "start_ms": 459370,
      "end_ms": 464625,
      "text": "每一个名字背后都是一段拿命拼出来的传奇。",
      "token_start": 1612,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 465190,
      "end_ms": 466345,
      "text": "读完你会明白，",
      "token_start": 1631,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 466830,
      "end_ms": 470430,
      "text": "今天的安稳日子不是天上掉下来的。",
      "token_start": 1637,
      "token_end_exclusive": 1652
    },
    {
      "start_ms": 470430,
      "end_ms": 473895,
      "text": "是有人用一辈子替我们扛下来的。",
      "token_start": 1652,
      "token_end_exclusive": 1666
    },
    {
      "start_ms": 474650,
      "end_ms": 475835,
      "text": "点下方链接，",
      "token_start": 1666,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 476270,
      "end_ms": 477795,
      "text": "把这本书带回家，",
      "token_start": 1671,
      "token_end_exclusive": 1678
    },
    {
      "start_ms": 478360,
      "end_ms": 480595,
      "text": "自己读也给孩子读，",
      "token_start": 1678,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 481220,
      "end_ms": 485415,
      "text": "让我们的下一代知道谁才是真正该追的星。",
      "token_start": 1686,
      "token_end_exclusive": 1704
    },
    {
      "start_ms": 486070,
      "end_ms": 488410,
      "text": "他一辈子都在做别人的铺路石，",
      "token_start": 1704,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 489370,
      "end_ms": 490570,
      "text": "可没有这些卵石，",
      "token_start": 1717,
      "token_end_exclusive": 1724
    },
    {
      "start_ms": 490910,
      "end_ms": 496910,
      "text": "哪来的康庄大盗点赞是给前三强们迟来的掌声。",
      "token_start": 1724,
      "token_end_exclusive": 1744
    },
    {
      "start_ms": 497790,
      "end_ms": 501030,
      "text": "收藏是怕以后再也找不到这样的故事。",
      "token_start": 1744,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 501510,
      "end_ms": 507310,
      "text": "转发是让更多人知道谁才是真正的国之脊。",
      "token_start": 1760,
      "token_end_exclusive": 1778
    },
    {
      "start_ms": 507310,
      "end_ms": 507550,
      "text": "俩。",
      "token_start": 1778,
      "token_end_exclusive": 1779
    },
    {
      "start_ms": 509010,
      "end_ms": 509630,
      "text": "关注我，",
      "token_start": 1779,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 509630,
      "end_ms": 513215,
      "text": "咱们一起把该记住的人一个一个讲完。",
      "token_start": 1782,
      "token_end_exclusive": 1798
    }
  ],
