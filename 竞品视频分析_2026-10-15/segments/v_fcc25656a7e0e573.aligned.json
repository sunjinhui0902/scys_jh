{
  "video_id": "v_fcc25656a7e0e573",
  "duration_s": 464.886009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_fcc25656a7e0e573.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_fcc25656a7e0e573.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 1050,
      "text": "问你一个问题，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2030,
      "end_ms": 6450,
      "text": "中国天眼全世界最大的射电望远镜，",
      "token_start": 6,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 7330,
      "end_ms": 8950,
      "text": "它是谁建出来的，",
      "token_start": 21,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 10210,
      "end_ms": 11530,
      "text": "我给你三秒钟，",
      "token_start": 28,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 12690,
      "end_ms": 14590,
      "text": "甚能说出那人的名字吗？",
      "token_start": 34,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 15850,
      "end_ms": 18590,
      "text": "大多数人张了张嘴说不出来，",
      "token_start": 44,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 19170,
      "end_ms": 24630,
      "text": "甚至有人觉得这么牛的东西应该是外国人帮我们设计的吧。",
      "token_start": 56,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 25390,
      "end_ms": 28050,
      "text": "今天我想让你记住一个名字，",
      "token_start": 81,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 28450,
      "end_ms": 29515,
      "text": "难人多，",
      "token_start": 93,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 30450,
      "end_ms": 31610,
      "text": "先别急着划走，",
      "token_start": 96,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 32030,
      "end_ms": 34310,
      "text": "你先看看这个人值不值得，",
      "token_start": 102,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 34310,
      "end_ms": 35870,
      "text": "你用一分钟记住。",
      "token_start": 113,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 36390,
      "end_ms": 38190,
      "text": "如果你在大街上遇见他，",
      "token_start": 120,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 38290,
      "end_ms": 39690,
      "text": "你大概率认不出来，",
      "token_start": 130,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 40890,
      "end_ms": 42030,
      "text": "花白的头发，",
      "token_start": 138,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 42850,
      "end_ms": 44250,
      "text": "旧旧的夹克，",
      "token_start": 143,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 45190,
      "end_ms": 46870,
      "text": "笑路微微驼背，",
      "token_start": 148,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 47650,
      "end_ms": 50290,
      "text": "笑起来像个普通的老大爷。",
      "token_start": 154,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 51190,
      "end_ms": 55010,
      "text": "可就是这个老大爷笑了二十二年，",
      "token_start": 165,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 55530,
      "end_ms": 58010,
      "text": "把一句当年没人当真的话，",
      "token_start": 179,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 58270,
      "end_ms": 62335,
      "text": "变成了让全身世界都仰望的国之重器。",
      "token_start": 190,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 63230,
      "end_ms": 71345,
      "text": "天眼fast五百米口径球面射电望远镜中国天眼之父就是他。",
      "token_start": 206,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 71970,
      "end_ms": 77515,
      "text": "一九六三年十八岁的南仁东考进清华大学无线电气。",
      "token_start": 230,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 77920,
      "end_ms": 78395,
      "text": "那一年，",
      "token_start": 252,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 78620,
      "end_ms": 80905,
      "text": "没人知道这个瘦瘦的年轻人，",
      "token_start": 255,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 81230,
      "end_ms": 88385,
      "text": "将来会把中国的眼睛送到一百三十七亿光年之外。",
      "token_start": 267,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 89310,
      "end_ms": 91825,
      "text": "一百三十七亿光年是什么概念？",
      "token_start": 288,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 93550,
      "end_ms": 95515,
      "text": "那是宇宙大爆炸发生的地方，",
      "token_start": 301,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 96080,
      "end_ms": 99065,
      "text": "是我们能看到的最远的地方。",
      "token_start": 313,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 100060,
      "end_ms": 103285,
      "text": "时间快进到一九九三年九月，",
      "token_start": 325,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 104150,
      "end_ms": 107914,
      "text": "国际无线电科学联盟大会在日本东京召开。",
      "token_start": 337,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 108860,
      "end_ms": 115935,
      "text": "当时全世界最大的射电望远镜在美国口径三百零五米，",
      "token_start": 355,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 117210,
      "end_ms": 121520,
      "text": "我们中国呢最大的射电望远镜口径只有二十五米，",
      "token_start": 378,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 121680,
      "end_ms": 122900,
      "text": "差了十几倍。",
      "token_start": 399,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 123340,
      "end_ms": 126380,
      "text": "在会上多个国家科学家们商量说，",
      "token_start": 404,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 126620,
      "end_ms": 127860,
      "text": "这东西太难了，",
      "token_start": 418,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 128140,
      "end_ms": 132780,
      "text": "要不咱们联合起来建一台更大的注意这个词。",
      "token_start": 424,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 133160,
      "end_ms": 134900,
      "text": "联合为什么？",
      "token_start": 443,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 134900,
      "end_ms": 137260,
      "text": "联合谁为单靠一个国家，",
      "token_start": 448,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 137640,
      "end_ms": 139300,
      "text": "谁都不敢拍胸脯，",
      "token_start": 458,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 139300,
      "end_ms": 140920,
      "text": "说我能造出来。",
      "token_start": 465,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 141780,
      "end_ms": 143360,
      "text": "可就在这个节骨眼上，",
      "token_start": 471,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 143740,
      "end_ms": 147060,
      "text": "中国代表团的房间里走进来。",
      "token_start": 480,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 147060,
      "end_ms": 149740,
      "text": "一个男人他推门进去说，",
      "token_start": 492,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 149740,
      "end_ms": 152130,
      "text": "我说了一句让所有人愣住的话，",
      "token_start": 502,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 152970,
      "end_ms": 154050,
      "text": "我们也见一个。",
      "token_start": 515,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 155250,
      "end_ms": 158430,
      "text": "这句话就是南仁都说的，",
      "token_start": 521,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 158510,
      "end_ms": 159910,
      "text": "你品品这个画面，",
      "token_start": 531,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 160330,
      "end_ms": 163330,
      "text": "一个当时连科研经费都紧张的国家，",
      "token_start": 538,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 163910,
      "end_ms": 175530,
      "text": "一个国内最大望远镜口径只有二十五米的国家站出来说要造口径五百米的世界第一射电望远镜在场的人什么反应？",
      "token_start": 553,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 175810,
      "end_ms": 177330,
      "text": "有人客气的笑了笑，",
      "token_start": 602,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 177470,
      "end_ms": 178770,
      "text": "有人心里直摇头，",
      "token_start": 610,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 178970,
      "end_ms": 179815,
      "text": "说梦话吧。",
      "token_start": 617,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 180570,
      "end_ms": 183910,
      "text": "连我们自己人一开始都不太信，",
      "token_start": 621,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 184910,
      "end_ms": 186550,
      "text": "可南仁东当真哪，",
      "token_start": 634,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 187090,
      "end_ms": 189370,
      "text": "这一当真就是二十二年。",
      "token_start": 641,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 189910,
      "end_ms": 190970,
      "text": "这里有个细节，",
      "token_start": 651,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 191450,
      "end_ms": 193010,
      "text": "你先别急着说他傻。",
      "token_start": 657,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 193190,
      "end_ms": 197490,
      "text": "当时南仁东人在日本在日本国立天文台做研究，",
      "token_start": 665,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 198130,
      "end_ms": 203130,
      "text": "人家给他开出的薪资待遇比国内高出三百倍三百倍啊，",
      "token_start": 685,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 203450,
      "end_ms": 204130,
      "text": "什么概念？",
      "token_start": 708,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 204210,
      "end_ms": 205150,
      "text": "你感受一下，",
      "token_start": 712,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 205630,
      "end_ms": 206830,
      "text": "比如你月薪一万，",
      "token_start": 717,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 207110,
      "end_ms": 208630,
      "text": "人家一个月给你三百万，",
      "token_start": 724,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 209510,
      "end_ms": 211160,
      "text": "可他呢辞了职，",
      "token_start": 734,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 211420,
      "end_ms": 212240,
      "text": "直接回国，",
      "token_start": 740,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 212660,
      "end_ms": 213680,
      "text": "一点没犹豫。",
      "token_start": 744,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 213920,
      "end_ms": 214680,
      "text": "有人问他，",
      "token_start": 749,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 216300,
      "end_ms": 217260,
      "text": "你图什么呢？",
      "token_start": 753,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 218240,
      "end_ms": 219520,
      "text": "他没怎么解释。",
      "token_start": 758,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 220080,
      "end_ms": 221440,
      "text": "此后的二十二年，",
      "token_start": 764,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 221580,
      "end_ms": 223100,
      "text": "他的行动就是答案，",
      "token_start": 771,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 223820,
      "end_ms": 228650,
      "text": "他把自己埋进了贵州的深山。",
      "token_start": 779,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 228830,
      "end_ms": 229590,
      "text": "说到这儿，",
      "token_start": 791,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 229590,
      "end_ms": 232490,
      "text": "你可能还不清楚天眼到底有多牛。",
      "token_start": 795,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 233150,
      "end_ms": 234290,
      "text": "我给你讲几个数，",
      "token_start": 809,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 234290,
      "end_ms": 235470,
      "text": "你就明白了。",
      "token_start": 816,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 235470,
      "end_ms": 238090,
      "text": "天眼直径五百米，",
      "token_start": 821,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 238090,
      "end_ms": 241655,
      "text": "你绕着它走一圈儿都要半个钟头，",
      "token_start": 828,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 242150,
      "end_ms": 244935,
      "text": "他的反射面二十五万平方米，",
      "token_start": 842,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 245290,
      "end_ms": 248445,
      "text": "相当于三十个标准的足球场那么大。",
      "token_start": 854,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 248900,
      "end_ms": 249915,
      "text": "再给你一个画面，",
      "token_start": 869,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 250470,
      "end_ms": 252375,
      "text": "假如把天眼盛满水，",
      "token_start": 876,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 252790,
      "end_ms": 254045,
      "text": "全世界七十亿人，",
      "token_start": 884,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 254440,
      "end_ms": 256135,
      "text": "每个人能分到四平，",
      "token_start": 891,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 256620,
      "end_ms": 260405,
      "text": "他是世界上最大的单口径射电望远镜，",
      "token_start": 899,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 261000,
      "end_ms": 263780,
      "text": "综合性能领先全球二十年以上。",
      "token_start": 915,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 263920,
      "end_ms": 264480,
      "text": "有了它，",
      "token_start": 928,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 264800,
      "end_ms": 266945,
      "text": "哪怕有人在月球上打电话，",
      "token_start": 931,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 267290,
      "end_ms": 269485,
      "text": "我们都能听得清清楚楚。",
      "token_start": 942,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 269920,
      "end_ms": 273765,
      "text": "而且这个庞然大物从设计到建造，",
      "token_start": 952,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 274180,
      "end_ms": 276665,
      "text": "全部都是我们中国人自己完成的。",
      "token_start": 966,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 277380,
      "end_ms": 278925,
      "text": "他的出现意味着什么？",
      "token_start": 980,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 279300,
      "end_ms": 283875,
      "text": "通信、雷达、深空探测、精密仪器等等，",
      "token_start": 989,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 284220,
      "end_ms": 287455,
      "text": "一个国家的科技底盘全都被他支棱起来了。",
      "token_start": 1003,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 288740,
      "end_ms": 292895,
      "text": "所以当年有人说南仁东不是在造一台望远镜。",
      "token_start": 1021,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 293410,
      "end_ms": 297190,
      "text": "他是在给中国装一双能看宇宙的眼睛。",
      "token_start": 1040,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 297490,
      "end_ms": 299770,
      "text": "二零一六年九月二十五日，",
      "token_start": 1056,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 300250,
      "end_ms": 302330,
      "text": "天眼正式落成启用。",
      "token_start": 1067,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 302930,
      "end_ms": 303410,
      "text": "那天，",
      "token_start": 1075,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 303730,
      "end_ms": 305090,
      "text": "世界为之震动，",
      "token_start": 1077,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 305350,
      "end_ms": 306530,
      "text": "无数人欢呼，",
      "token_start": 1083,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 307150,
      "end_ms": 308790,
      "text": "而很少有人注意到，",
      "token_start": 1088,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 309090,
      "end_ms": 313650,
      "text": "人群里有一个瘦削的老人安安静静的站着，",
      "token_start": 1096,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 314190,
      "end_ms": 318010,
      "text": "他为了这一天等了足足二十二年之久，",
      "token_start": 1114,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 318570,
      "end_ms": 322925,
      "text": "而那个时候他的生命却已经进入了倒计时。",
      "token_start": 1130,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 324850,
      "end_ms": 325650,
      "text": "不到一年。",
      "token_start": 1148,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 325950,
      "end_ms": 328170,
      "text": "二零一七年九月十五日，",
      "token_start": 1152,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 328590,
      "end_ms": 329670,
      "text": "南仁东走了，",
      "token_start": 1162,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 329810,
      "end_ms": 331050,
      "text": "享年七十二岁。",
      "token_start": 1167,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 331730,
      "end_ms": 334150,
      "text": "他生前没当过院士，",
      "token_start": 1173,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 334370,
      "end_ms": 336010,
      "text": "没什么显赫的头衔。",
      "token_start": 1181,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 336270,
      "end_ms": 337270,
      "text": "可他去世后，",
      "token_start": 1189,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 337670,
      "end_ms": 343850,
      "text": "国际天文学联合会把一颗小行星命名为南仁东星。",
      "token_start": 1194,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 344770,
      "end_ms": 346710,
      "text": "你看天上那颗星，",
      "token_start": 1215,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 347050,
      "end_ms": 349530,
      "text": "就是他他说过一句话，",
      "token_start": 1222,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 349930,
      "end_ms": 351150,
      "text": "人这一辈子，",
      "token_start": 1231,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 351590,
      "end_ms": 353095,
      "text": "总要做一些事情，",
      "token_start": 1236,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 353440,
      "end_ms": 354595,
      "text": "哪怕只做一件，",
      "token_start": 1243,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 354920,
      "end_ms": 356185,
      "text": "也要做到极致。",
      "token_start": 1249,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 356650,
      "end_ms": 357445,
      "text": "他做到了，",
      "token_start": 1255,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 357840,
      "end_ms": 362615,
      "text": "他用一辈子把天言两个字刻在了中国的星空上。",
      "token_start": 1259,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 364320,
      "end_ms": 367575,
      "text": "如果你觉得这样的人值得被记住，",
      "token_start": 1279,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 367820,
      "end_ms": 369635,
      "text": "点个关注这个系列，",
      "token_start": 1293,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 369890,
      "end_ms": 372630,
      "text": "我会把他的故事一级一级讲完。",
      "token_start": 1301,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 372710,
      "end_ms": 374475,
      "text": "但我更想跟你说一句，",
      "token_start": 1314,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 374930,
      "end_ms": 376515,
      "text": "像南仁东这样的人，",
      "token_start": 1323,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 376900,
      "end_ms": 378285,
      "text": "中国不止一个，",
      "token_start": 1331,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 378800,
      "end_ms": 381270,
      "text": "你知道中国还有多少这样的脊两吗？",
      "token_start": 1337,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 382160,
      "end_ms": 388325,
      "text": "李四光逐可珍毛以生钱学森、郭永怀、陈铠甲，",
      "token_start": 1352,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 388960,
      "end_ms": 391395,
      "text": "他们一个个把命交给国家，",
      "token_start": 1370,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 391920,
      "end_ms": 393160,
      "text": "可他们的名字，",
      "token_start": 1381,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 393300,
      "end_ms": 397395,
      "text": "咱们的孩子能叫出几个这本书？",
      "token_start": 1387,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 397750,
      "end_ms": 398685,
      "text": "国之脊梁，",
      "token_start": 1400,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 399510,
      "end_ms": 401510,
      "text": "中国院士的科学人生，",
      "token_start": 1404,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 401530,
      "end_ms": 404950,
      "text": "百年中国科学院学部科学人生，",
      "token_start": 1413,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 405010,
      "end_ms": 408620,
      "text": "非百年项目组编的四十位院士，",
      "token_start": 1426,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 408780,
      "end_ms": 411935,
      "text": "三十三个学科领域四十段科学人生，",
      "token_start": 1439,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 412650,
      "end_ms": 415295,
      "text": "每一个故事都像南仁东一样，",
      "token_start": 1454,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 415560,
      "end_ms": 416685,
      "text": "让人心口发烫。",
      "token_start": 1466,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 417430,
      "end_ms": 420215,
      "text": "国家出版基金项目认准正版，",
      "token_start": 1472,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 420780,
      "end_ms": 423930,
      "text": "每一个故事都像南仁东一样，",
      "token_start": 1484,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 424090,
      "end_ms": 425565,
      "text": "让人心口发烫。",
      "token_start": 1496,
      "token_end_exclusive": 1502
    },
    {
      "start_ms": 426480,
      "end_ms": 428215,
      "text": "拍一本儿放家里，",
      "token_start": 1502,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 428430,
      "end_ms": 429725,
      "text": "让孩子翻一翻，",
      "token_start": 1509,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 430560,
      "end_ms": 433905,
      "text": "孩子心里有了偶像就知道什么值得追。",
      "token_start": 1515,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 435520,
      "end_ms": 436645,
      "text": "点下方链接，",
      "token_start": 1531,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 437170,
      "end_ms": 438130,
      "text": "给孩子带一本，",
      "token_start": 1536,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 438230,
      "end_ms": 441125,
      "text": "也请你点个赞、收藏、转发，",
      "token_start": 1542,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 441670,
      "end_ms": 444525,
      "text": "让更多人知道中国天眼之父，",
      "token_start": 1552,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 444810,
      "end_ms": 445715,
      "text": "他叫南仁东。",
      "token_start": 1564,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 446000,
      "end_ms": 446815,
      "text": "下集预告，",
      "token_start": 1569,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 449380,
      "end_ms": 450875,
      "text": "为了把天眼建起来，",
      "token_start": 1573,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 451770,
      "end_ms": 458795,
      "text": "这个老头在贵州的大山里求人求了十一年，",
      "token_start": 1581,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 460000,
      "end_ms": 461065,
      "text": "他经历了什么？",
      "token_start": 1599,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 463040,
      "end_ms": 464785,
      "text": "点关注下集见。",
      "token_start": 1605,
      "token_end_exclusive": 1611
    }
  ],
