{
  "video_id": "v_fe3918e76ed3fd8d",
  "duration_s": 410.965517,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_fe3918e76ed3fd8d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_fe3918e76ed3fd8d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 1470,
      "text": "一九六一年四月，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1730,
      "end_ms": 4890,
      "text": "北京一个五十四岁的男人回到家，",
      "token_start": 7,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5170,
      "end_ms": 6430,
      "text": "脸色特别难看。",
      "token_start": 21,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 7150,
      "end_ms": 8109,
      "text": "他跟妻子说，",
      "token_start": 27,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 9030,
      "end_ms": 10450,
      "text": "我要出趟长差，",
      "token_start": 32,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 11330,
      "end_ms": 13630,
      "text": "妻子问去哪儿，",
      "token_start": 38,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 14970,
      "end_ms": 16850,
      "text": "他摇头去多久，",
      "token_start": 44,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 17050,
      "end_ms": 19970,
      "text": "他还是摇头去干什么？",
      "token_start": 50,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 20750,
      "end_ms": 21890,
      "text": "他张了张嘴，",
      "token_start": 59,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 22670,
      "end_ms": 24210,
      "text": "半个字都吐不出来，",
      "token_start": 64,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 25010,
      "end_ms": 26370,
      "text": "沉默了好半天，",
      "token_start": 72,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 27190,
      "end_ms": 29250,
      "text": "他红着眼圈说了一句话，",
      "token_start": 78,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 30240,
      "end_ms": 34120,
      "text": "以后可能再也没人知道我是谁了。",
      "token_start": 88,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 34580,
      "end_ms": 35260,
      "text": "第二天，",
      "token_start": 102,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 36840,
      "end_ms": 41000,
      "text": "这个曾经让整个国际物理学界震动的名字，",
      "token_start": 105,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 42240,
      "end_ms": 47000,
      "text": "一夜之间从全世界所有的学术期刊上彻底消失了。",
      "token_start": 123,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 47700,
      "end_ms": 52500,
      "text": "他的妻子儿女不知道他去了哪儿，",
      "token_start": 144,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 52500,
      "end_ms": 54060,
      "text": "不知道他在干什么，",
      "token_start": 158,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 54660,
      "end_ms": 57640,
      "text": "至不不道道他死干什么。",
      "token_start": 166,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 58240,
      "end_ms": 61050,
      "text": "每隔几个月家里才能收到一封，",
      "token_start": 176,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 61070,
      "end_ms": 65655,
      "text": "从陌生信箱寄来的信上面就三个字报平安，",
      "token_start": 189,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 66560,
      "end_ms": 67435,
      "text": "没有地址，",
      "token_start": 207,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 67700,
      "end_ms": 68425,
      "text": "没有落款，",
      "token_start": 211,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 68780,
      "end_ms": 69505,
      "text": "什么都没有。",
      "token_start": 215,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 69920,
      "end_ms": 71665,
      "text": "他的女儿后来哭着回忆说，",
      "token_start": 220,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 72290,
      "end_ms": 74795,
      "text": "那十几年我就跟没有父亲一样，",
      "token_start": 231,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 75060,
      "end_ms": 77025,
      "text": "这个人叫王淦昌。",
      "token_start": 244,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 77830,
      "end_ms": 79510,
      "text": "您可能没听过这个名字，",
      "token_start": 251,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 79610,
      "end_ms": 80505,
      "text": "但我跟您说，",
      "token_start": 261,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 80840,
      "end_ms": 82005,
      "text": "只要您是中国人，",
      "token_start": 266,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 82310,
      "end_ms": 83325,
      "text": "你应该记住他。",
      "token_start": 273,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 83780,
      "end_ms": 88785,
      "text": "咱们先说说这个消失的人当年到底有多牛。",
      "token_start": 279,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 91180,
      "end_ms": 94775,
      "text": "王淦昌这个人命苦三岁没了爹，",
      "token_start": 297,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 95330,
      "end_ms": 96270,
      "text": "十四岁没了。",
      "token_start": 310,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 96270,
      "end_ms": 99565,
      "text": "娘本来想学个汽修混口饭吃，",
      "token_start": 315,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 99990,
      "end_ms": 102585,
      "text": "结果一不小心考进了清华。",
      "token_start": 327,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 103460,
      "end_ms": 104240,
      "text": "从那以后，",
      "token_start": 338,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 104540,
      "end_ms": 107155,
      "text": "人生就像开了挂二十四岁。",
      "token_start": 342,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 107560,
      "end_ms": 110865,
      "text": "他本来可以第一个发现仲子什么概念，",
      "token_start": 353,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 112710,
      "end_ms": 115145,
      "text": "那是能直接拿诺贝尔奖的成果。",
      "token_start": 369,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 116420,
      "end_ms": 117740,
      "text": "结果因为老师的失误，",
      "token_start": 382,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 117780,
      "end_ms": 121045,
      "text": "别人用了他的方法抢走了这个荣誉。",
      "token_start": 391,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 121470,
      "end_ms": 122445,
      "text": "三十五岁，",
      "token_start": 406,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 122880,
      "end_ms": 125525,
      "text": "他又提出了探测中微子的实验方案，",
      "token_start": 410,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 125990,
      "end_ms": 127530,
      "text": "还是因为咱们国家太穷，",
      "token_start": 425,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 127850,
      "end_ms": 128975,
      "text": "没条件做，",
      "token_start": 435,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 129440,
      "end_ms": 130680,
      "text": "又让外国人抢了。",
      "token_start": 439,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 130680,
      "end_ms": 132555,
      "text": "先您算算，",
      "token_start": 446,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 133020,
      "end_ms": 136495,
      "text": "这就两次跟诺讲擦肩而过了。",
      "token_start": 450,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 137320,
      "end_ms": 138460,
      "text": "到了五十二岁，",
      "token_start": 462,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 138880,
      "end_ms": 145325,
      "text": "他在苏联领导的团队在世界上第一次发现了反西格马复朝子，",
      "token_start": 468,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 145930,
      "end_ms": 148305,
      "text": "这一下整个物理学界都炸了。",
      "token_start": 494,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 149350,
      "end_ms": 154635,
      "text": "所有人都说这个人一只手已经摸到诺贝尔奖的门槛了。",
      "token_start": 506,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 154810,
      "end_ms": 156005,
      "text": "可就在这个时候，",
      "token_start": 529,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 156300,
      "end_ms": 158345,
      "text": "他接到了回国的调令。",
      "token_start": 536,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 159070,
      "end_ms": 160975,
      "text": "其实早在一九三四年，",
      "token_start": 545,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 161370,
      "end_ms": 162550,
      "text": "他就干过一件，",
      "token_start": 554,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 162890,
      "end_ms": 165385,
      "text": "让所有人都看不懂的事。",
      "token_start": 560,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 166530,
      "end_ms": 168495,
      "text": "那时候他刚从德国留学回来，",
      "token_start": 570,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 168940,
      "end_ms": 174285,
      "text": "西方多少顶尖科研机构抢着要他开出天价年薪，",
      "token_start": 582,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 174780,
      "end_ms": 176795,
      "text": "他呢眼皮都没眨一下，",
      "token_start": 602,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 177290,
      "end_ms": 181010,
      "text": "揣着一箱子笔记和实验数据辗转万里，",
      "token_start": 611,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 181190,
      "end_ms": 183630,
      "text": "回了当时战火纷飞的中国。",
      "token_start": 627,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 184150,
      "end_ms": 185550,
      "text": "有人问他图什么？",
      "token_start": 638,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 186190,
      "end_ms": 187230,
      "text": "他说了一句话，",
      "token_start": 645,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 188030,
      "end_ms": 189310,
      "text": "科学没有国界，",
      "token_start": 651,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 189730,
      "end_ms": 192490,
      "text": "但科学家身上流的是祖国的血。",
      "token_start": 657,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 192630,
      "end_ms": 193570,
      "text": "回来以后呢，",
      "token_start": 670,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 193730,
      "end_ms": 195170,
      "text": "祖国一穷二白，",
      "token_start": 675,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 195950,
      "end_ms": 198530,
      "text": "他带着学生在破庙里搭实验台，",
      "token_start": 681,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 198930,
      "end_ms": 201270,
      "text": "用废铜烂铁拼凑设备，",
      "token_start": 694,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 201610,
      "end_ms": 204270,
      "text": "啃着邦邦硬的窝头演算公式，",
      "token_start": 703,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 205630,
      "end_ms": 213760,
      "text": "就这么着硬生生在一片荒原上给中国的核物理砸出了最坚实的底子。",
      "token_start": 715,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 214400,
      "end_ms": 216460,
      "text": "时间回到一九六一年，",
      "token_start": 744,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 216580,
      "end_ms": 217400,
      "text": "四月三号，",
      "token_start": 753,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 218360,
      "end_ms": 225960,
      "text": "第二机械工业部部长刘杰和副部长钱三强找到了王淦昌谈话。",
      "token_start": 757,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 226480,
      "end_ms": 227460,
      "text": "办公室里，",
      "token_start": 783,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 227700,
      "end_ms": 230220,
      "text": "两位部长盯着他说了一句话，",
      "token_start": 787,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 232120,
      "end_ms": 236080,
      "text": "王先生想请您参加领导原子弹的研制工作，",
      "token_start": 799,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 236680,
      "end_ms": 238960,
      "text": "然后是一个残酷的要求，",
      "token_start": 817,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 239380,
      "end_ms": 241490,
      "text": "放弃了您自己的研究方向。",
      "token_start": 827,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 242090,
      "end_ms": 244490,
      "text": "从此隐姓埋名，",
      "token_start": 838,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 245390,
      "end_ms": 246110,
      "text": "您想想，",
      "token_start": 844,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 246550,
      "end_ms": 248690,
      "text": "一个五十四岁的科学家，",
      "token_start": 847,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 249210,
      "end_ms": 251790,
      "text": "站在世界物理学舞台的最中央，",
      "token_start": 857,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 252210,
      "end_ms": 254310,
      "text": "一只手已经摸到了诺奖，",
      "token_start": 870,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 254910,
      "end_ms": 258070,
      "text": "现在让他把这一切全扔掉去。",
      "token_start": 880,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 258110,
      "end_ms": 259870,
      "text": "一个谁都不知道的地方，",
      "token_start": 892,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 260130,
      "end_ms": 263210,
      "text": "干一件谁都不能说的事儿干多久，",
      "token_start": 902,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 263210,
      "end_ms": 265190,
      "text": "不知道能不能活着回来，",
      "token_start": 916,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 265230,
      "end_ms": 265970,
      "text": "更不知道。",
      "token_start": 926,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 267090,
      "end_ms": 268850,
      "text": "王淦昌沉默了几秒。",
      "token_start": 930,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 268970,
      "end_ms": 270720,
      "text": "然后他说说了六个字，",
      "token_start": 938,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 271260,
      "end_ms": 274500,
      "text": "这六个字后来被无数人提起，",
      "token_start": 947,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 274900,
      "end_ms": 277900,
      "text": "每次提起来都让人鼻子发酸。",
      "token_start": 959,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 278460,
      "end_ms": 278920,
      "text": "他说，",
      "token_start": 971,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 279340,
      "end_ms": 281080,
      "text": "我愿以身殉国，",
      "token_start": 973,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 281660,
      "end_ms": 282880,
      "text": "从这一天起，",
      "token_start": 979,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 283320,
      "end_ms": 285320,
      "text": "世上再无王，",
      "token_start": 984,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 285340,
      "end_ms": 285800,
      "text": "敢昌，",
      "token_start": 989,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 286460,
      "end_ms": 287600,
      "text": "只有一个代号，",
      "token_start": 991,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 287900,
      "end_ms": 289880,
      "text": "叫王京北京的京。",
      "token_start": 997,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 290700,
      "end_ms": 292580,
      "text": "他背上一个旧布包，",
      "token_start": 1004,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 292900,
      "end_ms": 294780,
      "text": "一头扎进了罗布泊。",
      "token_start": 1012,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 295680,
      "end_ms": 296640,
      "text": "那是什么地方？",
      "token_start": 1020,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 297380,
      "end_ms": 299575,
      "text": "夏天地表温度七十度，",
      "token_start": 1026,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 300300,
      "end_ms": 302200,
      "text": "鸡蛋埋沙子里都能焖熟，",
      "token_start": 1035,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 302800,
      "end_ms": 305100,
      "text": "冬天零下三十度哈，",
      "token_start": 1045,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 305120,
      "end_ms": 306865,
      "text": "口气都能结成冰渣。",
      "token_start": 1053,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 307710,
      "end_ms": 310630,
      "text": "住的是四面漏风的土坯房，",
      "token_start": 1061,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 310790,
      "end_ms": 312370,
      "text": "喝的是苦涩的咸水，",
      "token_start": 1072,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 312850,
      "end_ms": 316610,
      "text": "啃的是冻得像石头一样的窝窝头和咸菜。",
      "token_start": 1080,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 317550,
      "end_ms": 318770,
      "text": "最要命的是，",
      "token_start": 1097,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 319110,
      "end_ms": 321710,
      "text": "那个年代没有超级计算器，",
      "token_start": 1102,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 322250,
      "end_ms": 327090,
      "text": "上万个核心数据全靠他们用算盘和手摇计算器，",
      "token_start": 1113,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 327490,
      "end_ms": 330030,
      "text": "一个一个播出来三班倒，",
      "token_start": 1133,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 330330,
      "end_ms": 334210,
      "text": "没日没夜的干草稿纸堆满了一整间屋子，",
      "token_start": 1143,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 334550,
      "end_ms": 336570,
      "text": "从地面一直堆到房顶。",
      "token_start": 1160,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 336570,
      "end_ms": 338600,
      "text": "你你以为这就完了？",
      "token_start": 1169,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 338760,
      "end_ms": 339200,
      "text": "没有？",
      "token_start": 1177,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 339560,
      "end_ms": 344720,
      "text": "他的妻子在家里等了他整整十七年十七年了，",
      "token_start": 1179,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 344860,
      "end_ms": 346980,
      "text": "一个女人带的孩子，",
      "token_start": 1198,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 347040,
      "end_ms": 348300,
      "text": "不知道丈夫在哪，",
      "token_start": 1206,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 348540,
      "end_ms": 350280,
      "text": "不知道丈夫在干什么，",
      "token_start": 1213,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 350520,
      "end_ms": 352900,
      "text": "甚至不知道丈夫是不是还活着。",
      "token_start": 1222,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 353700,
      "end_ms": 354820,
      "text": "邻居问起来，",
      "token_start": 1235,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 355440,
      "end_ms": 356260,
      "text": "她只能说，",
      "token_start": 1240,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 357360,
      "end_ms": 360080,
      "text": "在新疆女儿长大了，",
      "token_start": 1244,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 360620,
      "end_ms": 361640,
      "text": "要结婚了。",
      "token_start": 1252,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 362100,
      "end_ms": 363500,
      "text": "父亲没有回来。",
      "token_start": 1256,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 364380,
      "end_ms": 368770,
      "text": "儿子问妈妈爸爸到底去哪儿啊妈妈？",
      "token_start": 1262,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 368770,
      "end_ms": 369545,
      "text": "只能说，",
      "token_start": 1277,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 370320,
      "end_ms": 374225,
      "text": "爸爸去很远的地方做很重要的事。",
      "token_start": 1280,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 375540,
      "end_ms": 376765,
      "text": "那十七年里，",
      "token_start": 1294,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 377130,
      "end_ms": 380745,
      "text": "王淦昌在戈壁滩上到底经历了什么？",
      "token_start": 1299,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 381260,
      "end_ms": 385430,
      "text": "妻子病危的加急电报送到他手上的时候，",
      "token_start": 1314,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 385430,
      "end_ms": 386365,
      "text": "他做了什么？",
      "token_start": 1331,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 387910,
      "end_ms": 389250,
      "text": "为什么试验成功？",
      "token_start": 1336,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 389250,
      "end_ms": 389765,
      "text": "那天，",
      "token_start": 1343,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 390100,
      "end_ms": 392940,
      "text": "他一个人默默站在角落，",
      "token_start": 1345,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 393240,
      "end_ms": 395355,
      "text": "双手抖的停不下来。",
      "token_start": 1355,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 396460,
      "end_ms": 398385,
      "text": "这些咱们下集接着说，",
      "token_start": 1363,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 400130,
      "end_ms": 401305,
      "text": "如果您听到这儿，",
      "token_start": 1372,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 401780,
      "end_ms": 403635,
      "text": "心里被狠狠的触动到了，",
      "token_start": 1379,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 404150,
      "end_ms": 406225,
      "text": "麻烦您点个关注点个赞，",
      "token_start": 1389,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 406550,
      "end_ms": 407355,
      "text": "收藏起来，",
      "token_start": 1399,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 407680,
      "end_ms": 409255,
      "text": "转发给身边的亲人。",
      "token_start": 1403,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 409650,
      "end_ms": 410110,
      "text": "下季。",
      "token_start": 1411,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 410310,
      "end_ms": 410845,
      "text": "我接着讲。",
      "token_start": 1413,
      "token_end_exclusive": 1417
    }
  ],
