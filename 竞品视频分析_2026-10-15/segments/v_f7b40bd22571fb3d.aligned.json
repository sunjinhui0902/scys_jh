  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f7b40bd22571fb3d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 1290,
      "text": "怎么你这一入职，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1530,
      "end_ms": 3090,
      "text": "我刚种的花就死了，",
      "token_start": 7,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3170,
      "end_ms": 4170,
      "text": "花开富贵嘛，",
      "token_start": 15,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4250,
      "end_ms": 5850,
      "text": "花开过了就剩富贵了。",
      "token_start": 20,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 5890,
      "end_ms": 7570,
      "text": "看来领导您啊要发大财了。",
      "token_start": 29,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 9570,
      "end_ms": 10210,
      "text": "小李啊，",
      "token_start": 40,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 10930,
      "end_ms": 12610,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 43,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13230,
      "end_ms": 15350,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 53,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 15690,
      "end_ms": 17570,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 66,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 19470,
      "end_ms": 21290,
      "text": "来就来带什么礼物啊，",
      "token_start": 79,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 21290,
      "end_ms": 22130,
      "text": "都不是外人。",
      "token_start": 88,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 22310,
      "end_ms": 22730,
      "text": "领导，",
      "token_start": 93,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 22990,
      "end_ms": 23630,
      "text": "您都说了，",
      "token_start": 95,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 23630,
      "end_ms": 24270,
      "text": "不是外人，",
      "token_start": 99,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 24330,
      "end_ms": 25890,
      "text": "我一直都把您当长辈看，",
      "token_start": 103,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 25970,
      "end_ms": 27950,
      "text": "哪有晚辈看长辈空手来的道理啊。",
      "token_start": 113,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 27950,
      "end_ms": 31020,
      "text": "年轻轻就是好啊，",
      "token_start": 127,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 31680,
      "end_ms": 33340,
      "text": "年轻就是还不够沉稳，",
      "token_start": 134,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 33760,
      "end_ms": 35020,
      "text": "还要向您多学习，",
      "token_start": 143,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 35280,
      "end_ms": 36760,
      "text": "我们才能变得更优秀。",
      "token_start": 150,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 40400,
      "end_ms": 40620,
      "text": "来，",
      "token_start": 159,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 40620,
      "end_ms": 42460,
      "text": "这么晚只能吃剩菜了吧。",
      "token_start": 160,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 43120,
      "end_ms": 45160,
      "text": "领导饭在哪儿我都能吃，",
      "token_start": 170,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 45480,
      "end_ms": 47680,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 180,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 47820,
      "end_ms": 49400,
      "text": "能赶上已经是我的运气了，",
      "token_start": 193,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 49400,
      "end_ms": 50120,
      "text": "打这么多饭，",
      "token_start": 204,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 50120,
      "end_ms": 50780,
      "text": "你喂猪呢？",
      "token_start": 209,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 50960,
      "end_ms": 51380,
      "text": "领导，",
      "token_start": 213,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 51520,
      "end_ms": 52340,
      "text": "我哪敢啊，",
      "token_start": 215,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 52420,
      "end_ms": 54520,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 219,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 54520,
      "end_ms": 55980,
      "text": "都说宰相肚里能撑船，",
      "token_start": 235,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 56180,
      "end_ms": 57480,
      "text": "更何况只是一碗饭呢。",
      "token_start": 244,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 59360,
      "end_ms": 60950,
      "text": "小李最近表现不错啊，",
      "token_start": 253,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 61050,
      "end_ms": 62925,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 262,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 63150,
      "end_ms": 64235,
      "text": "我得提前敬一杯。",
      "token_start": 275,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 64540,
      "end_ms": 65180,
      "text": "听这意思，",
      "token_start": 282,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 65180,
      "end_ms": 66220,
      "text": "领导是要高升了呀，",
      "token_start": 286,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 66220,
      "end_ms": 67625,
      "text": "我得提前敬领导一杯。",
      "token_start": 294,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 67940,
      "end_ms": 69610,
      "text": "哈哈哈哈哈哈哈哎，",
      "token_start": 303,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 69670,
      "end_ms": 70550,
      "text": "你什么意思啊？",
      "token_start": 311,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 70630,
      "end_ms": 72170,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 317,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 72170,
      "end_ms": 73370,
      "text": "领导美满美满，",
      "token_start": 328,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 73410,
      "end_ms": 74490,
      "text": "代表幸福美满，",
      "token_start": 334,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 74690,
      "end_ms": 76875,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 340,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 77350,
      "end_ms": 79605,
      "text": "哈哈哈哈哎，",
      "token_start": 354,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 80010,
      "end_ms": 81515,
      "text": "我这肚子喝茶都能胖，",
      "token_start": 359,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 82490,
      "end_ms": 83750,
      "text": "领导你那不叫胖，",
      "token_start": 368,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 83890,
      "end_ms": 85350,
      "text": "那叫宰相肚里能撑船，",
      "token_start": 375,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 85590,
      "end_ms": 86645,
      "text": "装的全是大事儿。",
      "token_start": 384,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 87530,
      "end_ms": 87985,
      "text": "哈哈哈，",
      "token_start": 391,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 89320,
      "end_ms": 90575,
      "text": "你酒量挺好的呀。",
      "token_start": 394,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 90910,
      "end_ms": 91270,
      "text": "领导，",
      "token_start": 401,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 91490,
      "end_ms": 92530,
      "text": "您可抬举我了，",
      "token_start": 403,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 92570,
      "end_ms": 93830,
      "text": "我平时真不太能喝，",
      "token_start": 409,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 94030,
      "end_ms": 95430,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 417,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 95430,
      "end_ms": 95915,
      "text": "高兴啊，",
      "token_start": 428,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 96070,
      "end_ms": 97785,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 431,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 99550,
      "end_ms": 100845,
      "text": "这藕是好藕啊，",
      "token_start": 441,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 101380,
      "end_ms": 102625,
      "text": "就是心眼儿太多了。",
      "token_start": 447,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 103170,
      "end_ms": 105050,
      "text": "领导哦虽然心眼多，",
      "token_start": 455,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 105350,
      "end_ms": 106625,
      "text": "但也是您的下酒菜啊。",
      "token_start": 463,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 107890,
      "end_ms": 109275,
      "text": "哈哈哈哈哈哈哈哈，",
      "token_start": 472,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 109570,
      "end_ms": 110915,
      "text": "这鸭子是好鸭子，",
      "token_start": 480,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 111200,
      "end_ms": 111955,
      "text": "就是嘴硬，",
      "token_start": 487,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 113420,
      "end_ms": 113900,
      "text": "嘴硬，",
      "token_start": 491,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 113900,
      "end_ms": 119115,
      "text": "才守得住秘密关注我，",
      "token_start": 493,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 119440,
      "end_ms": 120980,
      "text": "每天学点高情商，",
      "token_start": 502,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 121020,
      "end_ms": 121885,
      "text": "说话技巧，",
      "token_start": 509,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 122230,
      "end_ms": 123975,
      "text": "让你的路越走越宽。",
      "token_start": 513,
      "token_end_exclusive": 521
    }
  ],
