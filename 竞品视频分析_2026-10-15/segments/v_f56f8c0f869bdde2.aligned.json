{
  "video_id": "v_f56f8c0f869bdde2",
  "duration_s": 382.386009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f56f8c0f869bdde2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f56f8c0f869bdde2.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 390,
      "end_ms": 1030,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1170,
      "end_ms": 3410,
      "text": "这里是全中国最神秘的一个地方，",
      "token_start": 4,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 3550,
      "end_ms": 8010,
      "text": "你竟然在任何地图上都找不到他他也无法被翻译成任何外语。",
      "token_start": 18,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 8210,
      "end_ms": 9690,
      "text": "他只有短短两个字，",
      "token_start": 44,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 9750,
      "end_ms": 12270,
      "text": "却浓缩了中国最复杂的人情社会。",
      "token_start": 52,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 12750,
      "end_ms": 13910,
      "text": "今天挑战一口气，",
      "token_start": 66,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 13910,
      "end_ms": 17890,
      "text": "给你讲清楚江湖朱君莫笑，",
      "token_start": 73,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 17930,
      "end_ms": 19090,
      "text": "少年江湖梦，",
      "token_start": 84,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 19210,
      "end_ms": 20830,
      "text": "谁不年少梦江湖，",
      "token_start": 89,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 21010,
      "end_ms": 22650,
      "text": "咱中国人到底有多离不开？",
      "token_start": 96,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 22650,
      "end_ms": 24290,
      "text": "江湖刚进入一个行业，",
      "token_start": 107,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 24290,
      "end_ms": 25310,
      "text": "叫初入江湖，",
      "token_start": 116,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 25550,
      "end_ms": 26990,
      "text": "干的久了叫老江湖。",
      "token_start": 121,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 27350,
      "end_ms": 29570,
      "text": "离开以后再回来叫重出江湖，",
      "token_start": 129,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 29770,
      "end_ms": 31100,
      "text": "不回回来就要退隐。",
      "token_start": 141,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 31120,
      "end_ms": 33480,
      "text": "江湖请朋友帮忙叫江湖救急，",
      "token_start": 149,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 33680,
      "end_ms": 36600,
      "text": "很多事情搞不定叫人在江湖身不由己，",
      "token_start": 161,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 36840,
      "end_ms": 39640,
      "text": "哪怕暂时分别也要说一句江湖再见。",
      "token_start": 177,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 39980,
      "end_ms": 40420,
      "text": "诸君，",
      "token_start": 192,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 40460,
      "end_ms": 41540,
      "text": "既然江湖见面，",
      "token_start": 194,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 41540,
      "end_ms": 42460,
      "text": "先来抱个拳，",
      "token_start": 200,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 42920,
      "end_ms": 45680,
      "text": "您习惯是左手在上还是右手在上呢？",
      "token_start": 205,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 45760,
      "end_ms": 47140,
      "text": "正宗的江湖权力啊，",
      "token_start": 220,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 47140,
      "end_ms": 48860,
      "text": "应该是右手握拳。",
      "token_start": 228,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 49120,
      "end_ms": 51920,
      "text": "左掌在外拳代表武力，",
      "token_start": 235,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 52100,
      "end_ms": 53220,
      "text": "掌代表规矩，",
      "token_start": 244,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 53380,
      "end_ms": 55500,
      "text": "左手大拇指还要微微内扣，",
      "token_start": 249,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 55600,
      "end_ms": 57660,
      "text": "这是提醒自己江湖这么大，",
      "token_start": 260,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 57740,
      "end_ms": 59160,
      "text": "先别着急称老大，",
      "token_start": 271,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 59620,
      "end_ms": 60510,
      "text": "双臂环抱，",
      "token_start": 278,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 60510,
      "end_ms": 62130,
      "text": "成员代表五湖四海，",
      "token_start": 282,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 62170,
      "end_ms": 63095,
      "text": "天下一家。",
      "token_start": 290,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 63420,
      "end_ms": 66090,
      "text": "怪不得武侠剧里面一句抱拳啊，",
      "token_start": 294,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 66110,
      "end_ms": 67190,
      "text": "接下来不是承让，",
      "token_start": 307,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 67190,
      "end_ms": 68720,
      "text": "就是得罪了中国人，",
      "token_start": 314,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 68720,
      "end_ms": 71285,
      "text": "就算准备动手也得先把礼数做周全，",
      "token_start": 322,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 71700,
      "end_ms": 72300,
      "text": "你知道吗？",
      "token_start": 337,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 72360,
      "end_ms": 73240,
      "text": "最开始的时候，",
      "token_start": 341,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 73240,
      "end_ms": 74720,
      "text": "江只是江胡，",
      "token_start": 347,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 74820,
      "end_ms": 77265,
      "text": "只是胡江是流动的大水，",
      "token_start": 352,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 77580,
      "end_ms": 78600,
      "text": "不是停留的。",
      "token_start": 362,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 78600,
      "end_ms": 80805,
      "text": "广水水路通到哪里，",
      "token_start": 367,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 81040,
      "end_ms": 82585,
      "text": "商船客船就到哪里，",
      "token_start": 375,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 82900,
      "end_ms": 85545,
      "text": "生意规矩和恩怨也就走到哪里。",
      "token_start": 383,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 85960,
      "end_ms": 87000,
      "text": "眼为江口，",
      "token_start": 396,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 87000,
      "end_ms": 88360,
      "text": "为虎所忘之处，",
      "token_start": 400,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 88380,
      "end_ms": 89115,
      "text": "皆江湖。",
      "token_start": 406,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 89580,
      "end_ms": 91840,
      "text": "江湖人最大体面就是这件事，",
      "token_start": 409,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 91840,
      "end_ms": 92520,
      "text": "我答应了，",
      "token_start": 421,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 92520,
      "end_ms": 93395,
      "text": "就一定办到。",
      "token_start": 425,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 93760,
      "end_ms": 95695,
      "text": "为什么中国人如此迷恋江湖？",
      "token_start": 430,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 95980,
      "end_ms": 99115,
      "text": "因为江湖保存了一种非常中国式的人生想象。",
      "token_start": 442,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 99580,
      "end_ms": 104285,
      "text": "郭靖守襄阳李寻欢小楼听雨令狐冲笑傲江湖。",
      "token_start": 461,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 104760,
      "end_ms": 107865,
      "text": "儒家强调入室佛家道家强调出世。",
      "token_start": 480,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 108230,
      "end_ms": 110330,
      "text": "但如果一个人进也进不得，",
      "token_start": 494,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 110330,
      "end_ms": 111305,
      "text": "出也出不得。",
      "token_start": 505,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 111620,
      "end_ms": 113080,
      "text": "当庙堂容不下你，",
      "token_start": 510,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 113220,
      "end_ms": 114625,
      "text": "家族无法庇护你时，",
      "token_start": 517,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 114890,
      "end_ms": 116745,
      "text": "你仍然可以走向天地之间，",
      "token_start": 525,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 117000,
      "end_ms": 119500,
      "text": "凭借自己的道义、胆识和承诺，",
      "token_start": 536,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 119720,
      "end_ms": 121035,
      "text": "重新成为自己。",
      "token_start": 548,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 121370,
      "end_ms": 123305,
      "text": "有人的地方就有江湖。",
      "token_start": 554,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 123560,
      "end_ms": 124165,
      "text": "刘晶，",
      "token_start": 563,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 124630,
      "end_ms": 125730,
      "text": "美国有牛仔，",
      "token_start": 565,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 125950,
      "end_ms": 127010,
      "text": "欧洲有骑士，",
      "token_start": 570,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 127230,
      "end_ms": 129115,
      "text": "中国有江湖大侠。",
      "token_start": 575,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 129750,
      "end_ms": 130770,
      "text": "小时候看武侠，",
      "token_start": 582,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 130770,
      "end_ms": 133395,
      "text": "看的是武骑快马喝烈酒。",
      "token_start": 588,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 133630,
      "end_ms": 134750,
      "text": "拍拍兄弟的肩膀说，",
      "token_start": 598,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 134770,
      "end_ms": 135385,
      "text": "有我在，",
      "token_start": 606,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 135620,
      "end_ms": 136705,
      "text": "仗剑走天涯，",
      "token_start": 609,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 137020,
      "end_ms": 138260,
      "text": "路见不平一声吼，",
      "token_start": 614,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 138320,
      "end_ms": 139715,
      "text": "该出手时就出手，",
      "token_start": 621,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 140010,
      "end_ms": 141530,
      "text": "同是天涯沦落人，",
      "token_start": 628,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 141650,
      "end_ms": 143555,
      "text": "相逢何必曾相识，",
      "token_start": 635,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 143810,
      "end_ms": 147395,
      "text": "你看北少林南武当峨眉派青城派，",
      "token_start": 642,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 147750,
      "end_ms": 151970,
      "text": "你知道为什么在江湖中丐帮叫帮唐门叫门，",
      "token_start": 656,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 152130,
      "end_ms": 153935,
      "text": "而华山派却叫派吗？",
      "token_start": 674,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 154330,
      "end_ms": 159105,
      "text": "同样是江湖组织门派帮教有什么区别呢？",
      "token_start": 682,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 159400,
      "end_ms": 160480,
      "text": "最难加入的是门，",
      "token_start": 699,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 160740,
      "end_ms": 163345,
      "text": "我们常说一门手艺独门绝技，",
      "token_start": 706,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 163610,
      "end_ms": 164650,
      "text": "比如四川唐门，",
      "token_start": 718,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 164650,
      "end_ms": 165715,
      "text": "以暗器为主，",
      "token_start": 724,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 166040,
      "end_ms": 168160,
      "text": "门主要靠家族血缘去传承，",
      "token_start": 729,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 168160,
      "end_ms": 171540,
      "text": "相当于专业技校比门更大的就是派，",
      "token_start": 740,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 171880,
      "end_ms": 175095,
      "text": "相当于综合性大学有一套完整的武学体系，",
      "token_start": 755,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 175460,
      "end_ms": 179495,
      "text": "比如武当派、内功、轻功拳掌样样精通，",
      "token_start": 773,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 179990,
      "end_ms": 181510,
      "text": "派的门槛相对比较低，",
      "token_start": 788,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 181530,
      "end_ms": 183730,
      "text": "不论出身、贫贱都可以办师学艺，",
      "token_start": 797,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 183870,
      "end_ms": 185410,
      "text": "可以学的内容也非常多。",
      "token_start": 810,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 185610,
      "end_ms": 186710,
      "text": "刀枪剑戟，",
      "token_start": 820,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 186770,
      "end_ms": 187970,
      "text": "斧钺勾叉铲棍，",
      "token_start": 824,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 188050,
      "end_ms": 188450,
      "text": "射棒，",
      "token_start": 830,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 188490,
      "end_ms": 189610,
      "text": "鞭拣锤抓拐子。",
      "token_start": 832,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 189610,
      "end_ms": 192110,
      "text": "刘杏十八般兵刃样样精通。",
      "token_start": 838,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 192350,
      "end_ms": 194970,
      "text": "帮类似于现在的职业行业协会，",
      "token_start": 849,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 195130,
      "end_ms": 197190,
      "text": "比如丐帮就是一群乞丐组成的，",
      "token_start": 862,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 197310,
      "end_ms": 199290,
      "text": "盐帮就是一群盐贩子组成的，",
      "token_start": 875,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 199330,
      "end_ms": 200470,
      "text": "还有近代的青帮，",
      "token_start": 887,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 200550,
      "end_ms": 204250,
      "text": "它的起源是清朝的粮传帮都是社会底层，",
      "token_start": 894,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 204290,
      "end_ms": 207390,
      "text": "平民抱团取暖和帮相近的概念，",
      "token_start": 911,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 207390,
      "end_ms": 207850,
      "text": "叫做会。",
      "token_start": 924,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 208070,
      "end_ms": 210160,
      "text": "比如天地会和红花卉，",
      "token_start": 927,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 210220,
      "end_ms": 211340,
      "text": "目的性非常明确，",
      "token_start": 936,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 211700,
      "end_ms": 214460,
      "text": "最后是教一般有共同的信仰，",
      "token_start": 943,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 214720,
      "end_ms": 217400,
      "text": "不管是范夫走卒还是江洋大盗，",
      "token_start": 955,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 217540,
      "end_ms": 219360,
      "text": "只要信仰一致都可以加入。",
      "token_start": 968,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 219640,
      "end_ms": 221520,
      "text": "比如明教神龙教，",
      "token_start": 979,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 221840,
      "end_ms": 222300,
      "text": "诸君，",
      "token_start": 986,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 222460,
      "end_ms": 223380,
      "text": "您是哪一派？",
      "token_start": 988,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 223380,
      "end_ms": 224100,
      "text": "哪一教呢？",
      "token_start": 993,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 224120,
      "end_ms": 226360,
      "text": "我呢我是回龙教的传承人，",
      "token_start": 997,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 226640,
      "end_ms": 228760,
      "text": "大侠从来不在于武功的高低，",
      "token_start": 1008,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 228840,
      "end_ms": 230620,
      "text": "而在于有一颗怜悯的心。",
      "token_start": 1020,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 230940,
      "end_ms": 231560,
      "text": "韩非说，",
      "token_start": 1030,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 231680,
      "end_ms": 232880,
      "text": "儒以文乱法，",
      "token_start": 1033,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 232980,
      "end_ms": 234140,
      "text": "侠以武犯境。",
      "token_start": 1038,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 234400,
      "end_ms": 235100,
      "text": "司马迁说，",
      "token_start": 1043,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 235280,
      "end_ms": 236060,
      "text": "言必信，",
      "token_start": 1047,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 236080,
      "end_ms": 236720,
      "text": "行必果，",
      "token_start": 1050,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 236820,
      "end_ms": 238840,
      "text": "以诺必成中国的侠客，",
      "token_start": 1053,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 238840,
      "end_ms": 240090,
      "text": "相信一些时刻，",
      "token_start": 1062,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 240090,
      "end_ms": 242030,
      "text": "一个普通人也可以匡扶正义，",
      "token_start": 1068,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 242110,
      "end_ms": 243085,
      "text": "为民除害。",
      "token_start": 1080,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 243610,
      "end_ms": 245390,
      "text": "你知道什么叫侠之大者，",
      "token_start": 1084,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 245550,
      "end_ms": 246565,
      "text": "为国为民吗？",
      "token_start": 1094,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 247060,
      "end_ms": 247800,
      "text": "抗战期间，",
      "token_start": 1099,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 247820,
      "end_ms": 249775,
      "text": "张志忠先生主阵湖南省，",
      "token_start": 1103,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 250090,
      "end_ms": 251910,
      "text": "他为了保护西南联大的学生，",
      "token_start": 1113,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 252070,
      "end_ms": 253150,
      "text": "亲笔给湘西。",
      "token_start": 1125,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 253170,
      "end_ms": 254295,
      "text": "各路土匪写信，",
      "token_start": 1130,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 254780,
      "end_ms": 255600,
      "text": "各路陆林，",
      "token_start": 1136,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 255600,
      "end_ms": 257280,
      "text": "豪杰山寨首领为剑，",
      "token_start": 1140,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 257500,
      "end_ms": 258340,
      "text": "日寇压境，",
      "token_start": 1148,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 258380,
      "end_ms": 259235,
      "text": "国难当头。",
      "token_start": 1152,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 259530,
      "end_ms": 265365,
      "text": "今有北大清华、南开、三校学生、数百人皆国家读书种子、民族未来栋梁。",
      "token_start": 1156,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 265720,
      "end_ms": 267675,
      "text": "为保存文脉求学救国，",
      "token_start": 1184,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 267950,
      "end_ms": 269935,
      "text": "自长沙徒步西去昆明。",
      "token_start": 1193,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 270380,
      "end_ms": 270800,
      "text": "此辈，",
      "token_start": 1202,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 270800,
      "end_ms": 271680,
      "text": "身无长物，",
      "token_start": 1204,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 271780,
      "end_ms": 273525,
      "text": "仅携书本手无寸铁，",
      "token_start": 1208,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 273890,
      "end_ms": 274870,
      "text": "斯特恳切。",
      "token_start": 1216,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 274950,
      "end_ms": 279130,
      "text": "拜托凡学生队伍经过勿忘高抬贵手放行保护，",
      "token_start": 1220,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 279290,
      "end_ms": 280190,
      "text": "不加侵扰，",
      "token_start": 1239,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 280230,
      "end_ms": 281005,
      "text": "误伤一人。",
      "token_start": 1243,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 281440,
      "end_ms": 283795,
      "text": "而当时沿路的土匪是这样回信的。",
      "token_start": 1247,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 284400,
      "end_ms": 284860,
      "text": "我辈，",
      "token_start": 1261,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 285080,
      "end_ms": 286445,
      "text": "虽落草为寇，",
      "token_start": 1263,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 286740,
      "end_ms": 288040,
      "text": "亦是炎黄子孙。",
      "token_start": 1268,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 288160,
      "end_ms": 290520,
      "text": "中华儿女当知民族大义，",
      "token_start": 1274,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 290520,
      "end_ms": 291720,
      "text": "为重定将，",
      "token_start": 1284,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 291760,
      "end_ms": 295000,
      "text": "保护学生安全购进、保护此文脉，",
      "token_start": 1288,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 295060,
      "end_ms": 296580,
      "text": "及所以护我之中华，",
      "token_start": 1301,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 296860,
      "end_ms": 297995,
      "text": "留复兴之根。",
      "token_start": 1309,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 299020,
      "end_ms": 301335,
      "text": "朱军武艺再高高不过天，",
      "token_start": 1314,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 301660,
      "end_ms": 301900,
      "text": "资质，",
      "token_start": 1324,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 301900,
      "end_ms": 304780,
      "text": "再厚厚不过地刀光剑影，",
      "token_start": 1326,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 304860,
      "end_ms": 306775,
      "text": "儿女情长快意恩仇，",
      "token_start": 1336,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 307080,
      "end_ms": 308935,
      "text": "天下苍生出试入试。",
      "token_start": 1344,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 309210,
      "end_ms": 310510,
      "text": "都在江湖之中，",
      "token_start": 1352,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 311110,
      "end_ms": 315010,
      "text": "渡尽劫波兄弟在相逢一笑泯恩仇。",
      "token_start": 1358,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 315430,
      "end_ms": 316990,
      "text": "江湖从来不止属于大侠，",
      "token_start": 1372,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 317129,
      "end_ms": 322610,
      "text": "还有走镖的、行医的、说书的、唱戏的、卖艺的、跑堂的三教九流五花八门。",
      "token_start": 1382,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 322830,
      "end_ms": 324150,
      "text": "武侠以没有绝世武功，",
      "token_start": 1410,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 324310,
      "end_ms": 325409,
      "text": "只要有一门本事，",
      "token_start": 1419,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 325490,
      "end_ms": 329010,
      "text": "你就能在江湖上讨口饭吃武侠片，",
      "token_start": 1426,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 329010,
      "end_ms": 337050,
      "text": "爱拍山顶决战可真实的江湖更可能出现在山下渡口码头、驿路客栈、茶馆、庙会和市场。",
      "token_start": 1440,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 337050,
      "end_ms": 339100,
      "text": "江湖里卧虎藏龙，",
      "token_start": 1475,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 339160,
      "end_ms": 339520,
      "text": "庞龙，",
      "token_start": 1482,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 339740,
      "end_ms": 342920,
      "text": "人心里何尝不是刀剑里藏胸，",
      "token_start": 1484,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 343280,
      "end_ms": 345800,
      "text": "人情里何尝不是诸君，",
      "token_start": 1496,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 346120,
      "end_ms": 347360,
      "text": "人生有三碗面，",
      "token_start": 1505,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 347480,
      "end_ms": 348060,
      "text": "最难吃，",
      "token_start": 1511,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 348620,
      "end_ms": 350760,
      "text": "场面铁面情面。",
      "token_start": 1514,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 351260,
      "end_ms": 354180,
      "text": "江湖可不是你想来就来想走就走的。",
      "token_start": 1520,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 354420,
      "end_ms": 355060,
      "text": "庄子说，",
      "token_start": 1535,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 355320,
      "end_ms": 357760,
      "text": "相濡以沫不如相忘于江湖。",
      "token_start": 1538,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 358360,
      "end_ms": 359260,
      "text": "所谓江湖，",
      "token_start": 1549,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 359420,
      "end_ms": 363260,
      "text": "就是五千年来中国人从未断绝的情谊与担当。",
      "token_start": 1553,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 364000,
      "end_ms": 368955,
      "text": "桃李春风一杯酒江湖夜雨十年灯一人有意，",
      "token_start": 1572,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 369170,
      "end_ms": 373035,
      "text": "便能守住侠气万千人有意便能守住山河。",
      "token_start": 1590,
      "token_end_exclusive": 1607
    },
    {
      "start_ms": 373660,
      "end_ms": 378870,
      "text": "天下风云出我辈一入江湖岁月摧皇图霸业，",
      "token_start": 1607,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 378970,
      "end_ms": 382035,
      "text": "谈笑中不胜人生一场醉。",
      "token_start": 1625,
      "token_end_exclusive": 1635
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
