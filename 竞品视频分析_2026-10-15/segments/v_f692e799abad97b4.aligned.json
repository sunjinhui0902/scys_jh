  "segments": [
    {
      "start_ms": 250,
      "end_ms": 2310,
      "text": "发信息要经得起被截图，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2790,
      "end_ms": 4590,
      "text": "说话要经得起被录音，",
      "token_start": 10,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 5010,
      "end_ms": 6690,
      "text": "翻脸要经得起翻旧账，",
      "token_start": 19,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 6990,
      "end_ms": 9010,
      "text": "借钱要经得起不还，",
      "token_start": 28,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 9670,
      "end_ms": 11530,
      "text": "聚会要经得起被偷拍，",
      "token_start": 36,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 11850,
      "end_ms": 12370,
      "text": "站队，",
      "token_start": 45,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 12590,
      "end_ms": 14290,
      "text": "要经得起被清算，",
      "token_start": 47,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 14810,
      "end_ms": 16430,
      "text": "绝交要经得起被出卖，",
      "token_start": 54,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 16790,
      "end_ms": 19970,
      "text": "背后吐槽要经得起当面对峙。",
      "token_start": 63,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 20650,
      "end_ms": 21290,
      "text": "记住了，",
      "token_start": 75,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21310,
      "end_ms": 23790,
      "text": "永远不要和任何人说太多的话。",
      "token_start": 78,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 24030,
      "end_ms": 25710,
      "text": "人聊天是为了获取信息，",
      "token_start": 91,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 25950,
      "end_ms": 27150,
      "text": "不是倾诉交底，",
      "token_start": 101,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 27510,
      "end_ms": 33080,
      "text": "更不是掏心掏肺课制自己的表达欲平静、温和微笑就行，",
      "token_start": 107,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 33240,
      "end_ms": 33840,
      "text": "不自卑，",
      "token_start": 130,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 34100,
      "end_ms": 34980,
      "text": "也不炫耀，",
      "token_start": 133,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 35300,
      "end_ms": 35920,
      "text": "守住嘴，",
      "token_start": 137,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 36160,
      "end_ms": 37660,
      "text": "就守住了自己的能量场。",
      "token_start": 140,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 37720,
      "end_ms": 39320,
      "text": "事以密成言，",
      "token_start": 150,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 39700,
      "end_ms": 41580,
      "text": "以懈怠少言为贵，",
      "token_start": 155,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 41580,
      "end_ms": 42980,
      "text": "言多必失，",
      "token_start": 162,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 43020,
      "end_ms": 43920,
      "text": "你的嘴，",
      "token_start": 166,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 43920,
      "end_ms": 46620,
      "text": "就是你最好的风水。",
      "token_start": 169,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 46620,
      "end_ms": 48060,
      "text": "不知道。",
      "token_start": 177,
      "token_end_exclusive": 180
    }
  ],
