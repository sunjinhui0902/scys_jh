{
  "video_id": "v_c6b400f861b51614",
  "duration_s": 449.041667,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c6b400f861b51614.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c6b400f861b51614.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 1170,
      "text": "一九七三年，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1470,
      "end_ms": 4290,
      "text": "中科院收到一封从英国寄来的信，",
      "token_start": 5,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4990,
      "end_ms": 8590,
      "text": "写信的是英国著名数学家哈布斯坦。",
      "token_start": 19,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 9070,
      "end_ms": 10210,
      "text": "信里有一句话，",
      "token_start": 34,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 10570,
      "end_ms": 13030,
      "text": "你们中国有个叫陈景润的，",
      "token_start": 40,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 13570,
      "end_ms": 18110,
      "text": "他把古老的筛发推到了人类智力的极限。",
      "token_start": 51,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 19010,
      "end_ms": 19670,
      "text": "这一年，",
      "token_start": 68,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 20410,
      "end_ms": 22130,
      "text": "陈景润四十岁，",
      "token_start": 71,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 23030,
      "end_ms": 26610,
      "text": "他在那间六平米的厕所改的小屋里，",
      "token_start": 77,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 26990,
      "end_ms": 32020,
      "text": "用挤麻袋草稿纸证明了那一加二哥德巴赫猜想。",
      "token_start": 92,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 32080,
      "end_ms": 35800,
      "text": "研究领域全世界公认的最高峰。",
      "token_start": 112,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 36700,
      "end_ms": 41360,
      "text": "后来这项成果被命名为陈氏定理。",
      "token_start": 125,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 41460,
      "end_ms": 42800,
      "text": "五十多年过去了，",
      "token_start": 139,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 43380,
      "end_ms": 46980,
      "text": "全世界没有一个人能再往前挪一步。",
      "token_start": 146,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 47860,
      "end_ms": 48780,
      "text": "可你知道吗？",
      "token_start": 161,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 49620,
      "end_ms": 51300,
      "text": "一九七三年的时候，",
      "token_start": 166,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 52240,
      "end_ms": 55780,
      "text": "绝大多数中国人根本不知道陈景润是谁，",
      "token_start": 174,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 56300,
      "end_ms": 58060,
      "text": "他的论文全是公式，",
      "token_start": 191,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 58480,
      "end_ms": 60585,
      "text": "只有少数数学家看得懂，",
      "token_start": 199,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 61070,
      "end_ms": 62690,
      "text": "他苦熬了半辈子，",
      "token_start": 209,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 62690,
      "end_ms": 63635,
      "text": "为国争光，",
      "token_start": 216,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 64090,
      "end_ms": 65610,
      "text": "世纪就那么静静，",
      "token_start": 220,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 65610,
      "end_ms": 66445,
      "text": "躺了五年，",
      "token_start": 227,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 67020,
      "end_ms": 67960,
      "text": "没人宣传，",
      "token_start": 231,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 68220,
      "end_ms": 69145,
      "text": "没人知道。",
      "token_start": 235,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 69590,
      "end_ms": 70830,
      "text": "直到一九七八年，",
      "token_start": 239,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 71070,
      "end_ms": 75635,
      "text": "作家徐迟写了篇报告文学叫哥德巴赫猜想。",
      "token_start": 246,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 75920,
      "end_ms": 77280,
      "text": "这篇文章不写公式，",
      "token_start": 264,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 77380,
      "end_ms": 80235,
      "text": "只写人写他住六平米小屋，",
      "token_start": 272,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 80670,
      "end_ms": 82735,
      "text": "写他用废报纸打草稿，",
      "token_start": 283,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 83150,
      "end_ms": 84845,
      "text": "写他咳着写演算，",
      "token_start": 292,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 85200,
      "end_ms": 86375,
      "text": "且他不求名利。",
      "token_start": 299,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 86890,
      "end_ms": 91355,
      "text": "人民日报、光明日报破例用三个整版转载。",
      "token_start": 305,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 91840,
      "end_ms": 92705,
      "text": "一夜之间，",
      "token_start": 322,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 93080,
      "end_ms": 96395,
      "text": "陈景润的名字传遍了大江南北。",
      "token_start": 326,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 97020,
      "end_ms": 99765,
      "text": "千千万万普通人第一次知道，",
      "token_start": 339,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 100550,
      "end_ms": 107600,
      "text": "原来咱们中国有这么一位科学家、工人、农民、学生也许看不懂数学，",
      "token_start": 351,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 107900,
      "end_ms": 109840,
      "text": "但所有人都看懂了两个字。",
      "token_start": 378,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 110160,
      "end_ms": 111395,
      "text": "坚守信件，",
      "token_start": 389,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 111870,
      "end_ms": 114870,
      "text": "像雪片一样飞进中科院麻袋，",
      "token_start": 393,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 114930,
      "end_ms": 116205,
      "text": "堆满了办公室，",
      "token_start": 405,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 116900,
      "end_ms": 119105,
      "text": "邓小平同志专门接见了他。",
      "token_start": 411,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 119570,
      "end_ms": 123505,
      "text": "看着这个销售腼腆的男人说了一句，",
      "token_start": 422,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 124190,
      "end_ms": 126955,
      "text": "中国如果有一千个陈景润，",
      "token_start": 437,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 127410,
      "end_ms": 128535,
      "text": "国家就了不得。",
      "token_start": 448,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 129100,
      "end_ms": 132120,
      "text": "可这个在数学世界里无所不能的天才，",
      "token_start": 454,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 132600,
      "end_ms": 135695,
      "text": "在生活里连自己都照顾不好。",
      "token_start": 470,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 136550,
      "end_ms": 137630,
      "text": "一九七七年，",
      "token_start": 482,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 137870,
      "end_ms": 142215,
      "text": "四十五岁的陈景润因病住进三零九医院，",
      "token_start": 487,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 142730,
      "end_ms": 146955,
      "text": "照顾他的是个二十七岁的女军医叫尤坤，",
      "token_start": 504,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 147560,
      "end_ms": 149955,
      "text": "一个是梦葫芦式的数学怪才，",
      "token_start": 521,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 150330,
      "end_ms": 152290,
      "text": "一个是开朗的年轻姑娘，",
      "token_start": 533,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 152390,
      "end_ms": 153495,
      "text": "差了十八岁，",
      "token_start": 543,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 153970,
      "end_ms": 159460,
      "text": "可由鲲发现这个别人眼里不通人情的人心比谁都软，",
      "token_start": 548,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 159660,
      "end_ms": 160645,
      "text": "比谁都真。",
      "token_start": 570,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 161640,
      "end_ms": 162820,
      "text": "一九八零年，",
      "token_start": 574,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 162960,
      "end_ms": 163975,
      "text": "他们结婚了。",
      "token_start": 579,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 165180,
      "end_ms": 165905,
      "text": "第二年，",
      "token_start": 584,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 167300,
      "end_ms": 169045,
      "text": "儿子陈有伟出生，",
      "token_start": 587,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 169590,
      "end_ms": 173245,
      "text": "这个孤独了大半辈子的人终于有了个家，",
      "token_start": 594,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 173930,
      "end_ms": 177470,
      "text": "可他的身体早就被几十年的高强度，",
      "token_start": 611,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 177630,
      "end_ms": 178795,
      "text": "用脑掏空了。",
      "token_start": 626,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 179620,
      "end_ms": 180680,
      "text": "一九七九年，",
      "token_start": 631,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 180880,
      "end_ms": 184395,
      "text": "他去美国普林斯顿高等研究院做交流，",
      "token_start": 636,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 185060,
      "end_ms": 186180,
      "text": "国外给的条件，",
      "token_start": 652,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 186180,
      "end_ms": 188285,
      "text": "顶级薪资优厚，",
      "token_start": 658,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 188660,
      "end_ms": 190585,
      "text": "他照样省吃俭用。",
      "token_start": 664,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 190810,
      "end_ms": 191965,
      "text": "五个月后回国，",
      "token_start": 671,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 192490,
      "end_ms": 196415,
      "text": "他把所有酬劳七千五百美元一分没留，",
      "token_start": 677,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 196910,
      "end_ms": 198125,
      "text": "全上交了国家。",
      "token_start": 693,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 198670,
      "end_ms": 199050,
      "text": "他说，",
      "token_start": 699,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 199310,
      "end_ms": 200455,
      "text": "国家还不富裕，",
      "token_start": 701,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 200750,
      "end_ms": 203255,
      "text": "我不能私留行李箱打开，",
      "token_start": 707,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 203710,
      "end_ms": 205055,
      "text": "没有一件洋货，",
      "token_start": 717,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 205380,
      "end_ms": 206705,
      "text": "没有一样纪念品，",
      "token_start": 723,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 207030,
      "end_ms": 210585,
      "text": "满满一箱子全是他手写的演算手稿。",
      "token_start": 730,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 211470,
      "end_ms": 212455,
      "text": "一九八四年，",
      "token_start": 745,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 212690,
      "end_ms": 216835,
      "text": "一场车祸诱发了严重的帕金森综合征。",
      "token_start": 750,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 217420,
      "end_ms": 217880,
      "text": "从此，",
      "token_start": 766,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 217880,
      "end_ms": 219485,
      "text": "他双手不停发抖，",
      "token_start": 768,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 219870,
      "end_ms": 222205,
      "text": "再也握不住钢笔写不了字，",
      "token_start": 775,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 222540,
      "end_ms": 223495,
      "text": "他就口述，",
      "token_start": 786,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 223890,
      "end_ms": 226040,
      "text": "让家人记拼着。",
      "token_start": 790,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 226040,
      "end_ms": 229315,
      "text": "最后一口气也要在数学的路上多走一步。",
      "token_start": 796,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 230090,
      "end_ms": 231835,
      "text": "他这辈子有两个遗憾，",
      "token_start": 813,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 232820,
      "end_ms": 237705,
      "text": "一个是没能证明哥德巴赫猜想的最终答案，",
      "token_start": 822,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 238560,
      "end_ms": 239415,
      "text": "一加一，",
      "token_start": 840,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 240190,
      "end_ms": 243390,
      "text": "他离那最后一步就差那么一点点。",
      "token_start": 843,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 244010,
      "end_ms": 247110,
      "text": "另一个是没来得及陪儿子长大。",
      "token_start": 857,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 248129,
      "end_ms": 250150,
      "text": "一九九六年三月十九日，",
      "token_start": 870,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 250670,
      "end_ms": 252790,
      "text": "六十三岁的陈景润走了。",
      "token_start": 880,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 253030,
      "end_ms": 253630,
      "text": "临走前，",
      "token_start": 890,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 253870,
      "end_ms": 254930,
      "text": "他做了个决定，",
      "token_start": 893,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 255330,
      "end_ms": 256970,
      "text": "把遗体捐给医院，",
      "token_start": 899,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 257230,
      "end_ms": 258470,
      "text": "供医学解剖，",
      "token_start": 906,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 258930,
      "end_ms": 261290,
      "text": "为国家在做最后一点贡献。",
      "token_start": 911,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 262210,
      "end_ms": 262890,
      "text": "他走后，",
      "token_start": 922,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 263650,
      "end_ms": 264990,
      "text": "家人收拾遗物，",
      "token_start": 925,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 265110,
      "end_ms": 266850,
      "text": "翻出一张泛黄的纸。",
      "token_start": 931,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 267770,
      "end_ms": 276460,
      "text": "当年北京四中的解票信通知纸的背面密密麻麻写满了他随手推演的公式。",
      "token_start": 939,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 277000,
      "end_ms": 280640,
      "text": "这张薄纸就是他一辈子不认命的证据，",
      "token_start": 970,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 281240,
      "end_ms": 284420,
      "text": "还有件事很多人误会了几十年。",
      "token_start": 986,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 285160,
      "end_ms": 285800,
      "text": "有人说，",
      "token_start": 999,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 286079,
      "end_ms": 288660,
      "text": "陈景润的成果够拿菲尔兹奖，",
      "token_start": 1002,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 288880,
      "end_ms": 290460,
      "text": "是西方故意不给他，",
      "token_start": 1014,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 291600,
      "end_ms": 294280,
      "text": "真不是菲尔兹奖。",
      "token_start": 1022,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 294400,
      "end_ms": 303410,
      "text": "有个死规矩颁奖那年一月一日之前必须未满四十岁陈景润一九三三年五月出生，",
      "token_start": 1029,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 303510,
      "end_ms": 305390,
      "text": "一九七四年颁奖时，",
      "token_start": 1063,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 305750,
      "end_ms": 308190,
      "text": "他已经过了四十岁七个月，",
      "token_start": 1071,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 308930,
      "end_ms": 310530,
      "text": "规则上就没资格了。",
      "token_start": 1082,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 311250,
      "end_ms": 312270,
      "text": "不是偏见，",
      "token_start": 1090,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 312470,
      "end_ms": 313230,
      "text": "是遗憾。",
      "token_start": 1094,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 314090,
      "end_ms": 316210,
      "text": "一个拿命做数学的人，",
      "token_start": 1097,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 316550,
      "end_ms": 318370,
      "text": "最后输给了年龄。",
      "token_start": 1106,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 318970,
      "end_ms": 322490,
      "text": "他的儿子陈有伟小时候对数学没兴趣，",
      "token_start": 1113,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 322730,
      "end_ms": 324290,
      "text": "去国外读了商科，",
      "token_start": 1129,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 325130,
      "end_ms": 327890,
      "text": "长大以后慢慢读懂了父亲。",
      "token_start": 1136,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 328250,
      "end_ms": 329810,
      "text": "后来主动转工，",
      "token_start": 1147,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 330180,
      "end_ms": 333240,
      "text": "数学结过了父亲没跑完的接力棒，",
      "token_start": 1153,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 333720,
      "end_ms": 335040,
      "text": "陈景润的一生，",
      "token_start": 1167,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 335440,
      "end_ms": 336300,
      "text": "六十三年，",
      "token_start": 1173,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 336860,
      "end_ms": 338580,
      "text": "清贫孤独，",
      "token_start": 1177,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 338960,
      "end_ms": 340420,
      "text": "隐忍死磕。",
      "token_start": 1181,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 340920,
      "end_ms": 342040,
      "text": "他被人笑过，",
      "token_start": 1185,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 342120,
      "end_ms": 343240,
      "text": "被人辞退过，",
      "token_start": 1190,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 343400,
      "end_ms": 344500,
      "text": "被人遗忘过，",
      "token_start": 1195,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 344980,
      "end_ms": 347420,
      "text": "可他从来没放下过手里的笔，",
      "token_start": 1200,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 347880,
      "end_ms": 355620,
      "text": "他用几麻袋草稿纸告诉全世界中国人敢啃最硬的骨头敢登最高的山。",
      "token_start": 1212,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 356180,
      "end_ms": 357420,
      "text": "如今日子好了，",
      "token_start": 1241,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 357480,
      "end_ms": 359875,
      "text": "很多人只记得他古怪的样子，",
      "token_start": 1247,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 360530,
      "end_ms": 363025,
      "text": "却忘了他熬过的那些冬夜，",
      "token_start": 1259,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 363470,
      "end_ms": 366265,
      "text": "咳出的那些血守过的那些孤独，",
      "token_start": 1270,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 367120,
      "end_ms": 369240,
      "text": "但伤何忌得岁月。",
      "token_start": 1283,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 369240,
      "end_ms": 370440,
      "text": "记得祖国，",
      "token_start": 1290,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 370460,
      "end_ms": 371780,
      "text": "记得清贫，",
      "token_start": 1294,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 371940,
      "end_ms": 372775,
      "text": "筑风谷，",
      "token_start": 1298,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 373120,
      "end_ms": 374545,
      "text": "孤灯照山河，",
      "token_start": 1301,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 374960,
      "end_ms": 376325,
      "text": "致敬陈景润，",
      "token_start": 1306,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 376900,
      "end_ms": 379815,
      "text": "致敬每一个在黑暗里默默攀登的人。",
      "token_start": 1311,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 380090,
      "end_ms": 381470,
      "text": "如果你也被感动了，",
      "token_start": 1326,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 381510,
      "end_ms": 386225,
      "text": "点亮红心评论区打一句致敬先辈转发出去，",
      "token_start": 1334,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 386680,
      "end_ms": 390145,
      "text": "让更多人看到这些不该被遗忘的名字，",
      "token_start": 1352,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 390770,
      "end_ms": 391415,
      "text": "关注我，",
      "token_start": 1368,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 391690,
      "end_ms": 394555,
      "text": "持续分享真实的为人往事。",
      "token_start": 1371,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 394960,
      "end_ms": 395645,
      "text": "说实话，",
      "token_start": 1382,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 396080,
      "end_ms": 397400,
      "text": "写陈景润的时候，",
      "token_start": 1385,
      "token_end_exclusive": 1392
    },
    {
      "start_ms": 397600,
      "end_ms": 399035,
      "text": "我翻了很多资料，",
      "token_start": 1392,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 399900,
      "end_ms": 400905,
      "text": "越翻越难受。",
      "token_start": 1399,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 401720,
      "end_ms": 403235,
      "text": "他住六平米小屋，",
      "token_start": 1404,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 403640,
      "end_ms": 406615,
      "text": "用起麻袋草稿纸算出了陈氏定理。",
      "token_start": 1411,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 407240,
      "end_ms": 408295,
      "text": "可像他这样的人，",
      "token_start": 1425,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 408800,
      "end_ms": 409875,
      "text": "还有四十多位，",
      "token_start": 1432,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 410860,
      "end_ms": 413315,
      "text": "很多人连名字都没听过。",
      "token_start": 1438,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 414520,
      "end_ms": 415820,
      "text": "这套国之激烈，",
      "token_start": 1448,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 415820,
      "end_ms": 417735,
      "text": "把他们的故事全写进去了。",
      "token_start": 1454,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 418770,
      "end_ms": 422395,
      "text": "钱学森、邓稼先、郭永怀、袁隆平，",
      "token_start": 1465,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 423300,
      "end_ms": 427415,
      "text": "一个一个全是我们这个民族的顶梁柱，",
      "token_start": 1477,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 427850,
      "end_ms": 429130,
      "text": "不是干巴巴的。",
      "token_start": 1493,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 429130,
      "end_ms": 431430,
      "text": "人物简介是真写，",
      "token_start": 1499,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 431510,
      "end_ms": 432670,
      "text": "他们怎么吃苦，",
      "token_start": 1506,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 432930,
      "end_ms": 441415,
      "text": "怎么咬牙怎么把命豁出去自己看长骨气给孩子看立大志，",
      "token_start": 1512,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 442550,
      "end_ms": 446315,
      "text": "这些名字不能忘，",
      "token_start": 1536,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 448500,
      "end_ms": 448925,
      "text": "不该忘。",
      "token_start": 1543,
      "token_end_exclusive": 1546
    }
  ],
