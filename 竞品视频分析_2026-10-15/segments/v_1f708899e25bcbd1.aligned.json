{
  "video_id": "v_1f708899e25bcbd1",
  "duration_s": 388.40093,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1f708899e25bcbd1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1f708899e25bcbd1.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1830,
      "text": "咱们脚下这片土地上，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 1990,
      "end_ms": 3810,
      "text": "曾经有这么一位皇帝，",
      "token_start": 9,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4230,
      "end_ms": 7690,
      "text": "他在位的二十二年里干成了十件大事。",
      "token_start": 18,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 8109,
      "end_ms": 8510,
      "text": "其中，",
      "token_start": 34,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8510,
      "end_ms": 11590,
      "text": "有的工程动用上百万人力，",
      "token_start": 36,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 12090,
      "end_ms": 13630,
      "text": "花十几年才修完。",
      "token_start": 47,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 14170,
      "end_ms": 19610,
      "text": "有的巨著三亿七千万字全是人手一笔一画抄出来的。",
      "token_start": 54,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 20330,
      "end_ms": 21410,
      "text": "还有的船队，",
      "token_start": 76,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21950,
      "end_ms": 23030,
      "text": "两百多艘船，",
      "token_start": 81,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 23430,
      "end_ms": 24870,
      "text": "两万七千多人，",
      "token_start": 86,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25550,
      "end_ms": 26830,
      "text": "比哥伦布早了。",
      "token_start": 92,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 26830,
      "end_ms": 28110,
      "text": "八十七年出海。",
      "token_start": 98,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 28650,
      "end_ms": 31540,
      "text": "有人说他劳民人伤财，",
      "token_start": 104,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 31540,
      "end_ms": 34180,
      "text": "有人说他功盖千秋，",
      "token_start": 113,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 34180,
      "end_ms": 35660,
      "text": "可不管怎么说，",
      "token_start": 121,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 35660,
      "end_ms": 37080,
      "text": "他留下的这些东西，",
      "token_start": 127,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 37080,
      "end_ms": 41080,
      "text": "六百年后的今天咱们还在看，",
      "token_start": 135,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 41080,
      "end_ms": 44120,
      "text": "还在用还在讲。",
      "token_start": 147,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 44140,
      "end_ms": 49640,
      "text": "今天咱们就来盘点盘点朱棣在位期间影响后世的十大功程。",
      "token_start": 153,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 50620,
      "end_ms": 51260,
      "text": "老规矩，",
      "token_start": 178,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 52000,
      "end_ms": 52880,
      "text": "开讲之前，",
      "token_start": 181,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 53040,
      "end_ms": 55980,
      "text": "劳烦您顺手扣个一点颗红心，",
      "token_start": 185,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 56260,
      "end_ms": 57760,
      "text": "让我看看都是谁。",
      "token_start": 197,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 57780,
      "end_ms": 64255,
      "text": "在听老十名南京大报恩寺与琉璃宝塔在江苏南京。",
      "token_start": 204,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 65100,
      "end_ms": 66855,
      "text": "朱棣为了纪念他的生母，",
      "token_start": 225,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 67130,
      "end_ms": 69405,
      "text": "下令修建大报恩寺。",
      "token_start": 235,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 70100,
      "end_ms": 72745,
      "text": "市里的核心是一座琉璃宝塔，",
      "token_start": 243,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 73080,
      "end_ms": 74065,
      "text": "这塔有多高？",
      "token_start": 255,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 74570,
      "end_ms": 77195,
      "text": "九层八面通高将近八十米，",
      "token_start": 260,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 77460,
      "end_ms": 79155,
      "text": "相当于二十多层楼。",
      "token_start": 271,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 79950,
      "end_ms": 82545,
      "text": "全塔用五色琉璃砖砌成，",
      "token_start": 279,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 83350,
      "end_ms": 85145,
      "text": "白瓷砖上还刻着佛像，",
      "token_start": 289,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 85760,
      "end_ms": 88415,
      "text": "塔上挂着一百五十二个风铃。",
      "token_start": 298,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 89350,
      "end_ms": 90295,
      "text": "一到晚上，",
      "token_start": 310,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 90790,
      "end_ms": 93210,
      "text": "塔里点上一百四十六盏，",
      "token_start": 314,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 93230,
      "end_ms": 95145,
      "text": "油灯灯火通明，",
      "token_start": 324,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 95580,
      "end_ms": 97715,
      "text": "整座塔像一座登山，",
      "token_start": 330,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 98390,
      "end_ms": 101290,
      "text": "当时就被西方人叫做南京磁塔，",
      "token_start": 338,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 101550,
      "end_ms": 105245,
      "text": "还被列为中世纪世界七大建筑奇迹之一。",
      "token_start": 351,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 105910,
      "end_ms": 107825,
      "text": "可惜一八五六年，",
      "token_start": 368,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 108260,
      "end_ms": 110205,
      "text": "这座塔毁于战火，",
      "token_start": 375,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 110970,
      "end_ms": 112185,
      "text": "可就算塔没了，",
      "token_start": 382,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 112740,
      "end_ms": 115805,
      "text": "他的名字还在历史里晾着第九名。",
      "token_start": 388,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 116150,
      "end_ms": 122810,
      "text": "北京天坛在北京市东城区天坛始建于永乐十八年。",
      "token_start": 402,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 123030,
      "end_ms": 124790,
      "text": "公元一四二零年，",
      "token_start": 423,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 125470,
      "end_ms": 129510,
      "text": "跟紫禁城是同时期修的那时候还不叫天坛，",
      "token_start": 430,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 129970,
      "end_ms": 130670,
      "text": "叫天。",
      "token_start": 448,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 130770,
      "end_ms": 131370,
      "text": "地坛，",
      "token_start": 450,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 131810,
      "end_ms": 138010,
      "text": "何似天地是朱棣迁都北京以后专门用来祭天的场所。",
      "token_start": 452,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 138410,
      "end_ms": 142150,
      "text": "整个建筑群占地两百七十三公顷，",
      "token_start": 474,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 142830,
      "end_ms": 144470,
      "text": "是故宫的三倍多。",
      "token_start": 488,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 145090,
      "end_ms": 146870,
      "text": "祁年殿三层，",
      "token_start": 495,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 147050,
      "end_ms": 148310,
      "text": "蓝色琉璃瓦顶，",
      "token_start": 500,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 148670,
      "end_ms": 149590,
      "text": "圆形攒间，",
      "token_start": 506,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 149590,
      "end_ms": 153000,
      "text": "鼎没用一根铁钉全靠榫卯。",
      "token_start": 510,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 153340,
      "end_ms": 156240,
      "text": "凡此丘坛、三层汉白玉圆坛，",
      "token_start": 521,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 156440,
      "end_ms": 158680,
      "text": "连台阶数目都是九的倍数。",
      "token_start": 532,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 158980,
      "end_ms": 163880,
      "text": "一个天坛把中国人对天的理解全刻在了建筑里。",
      "token_start": 543,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 164640,
      "end_ms": 166940,
      "text": "皇帝每年冬至来这儿祭天，",
      "token_start": 563,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 167500,
      "end_ms": 168920,
      "text": "祈求风调雨顺。",
      "token_start": 574,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 169460,
      "end_ms": 173340,
      "text": "一座天坛是中国人敬天伐祖的物证。",
      "token_start": 580,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 174300,
      "end_ms": 175020,
      "text": "第八名。",
      "token_start": 595,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 175320,
      "end_ms": 180510,
      "text": "南京龙江宝船厂与郑和宝船建造在江苏南京，",
      "token_start": 598,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 180990,
      "end_ms": 183970,
      "text": "这是当时全世界最大的造船基地。",
      "token_start": 617,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 184570,
      "end_ms": 187370,
      "text": "厂区面积将近四千亩，",
      "token_start": 631,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 188109,
      "end_ms": 190190,
      "text": "东西宽五百多米，",
      "token_start": 640,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 190870,
      "end_ms": 192290,
      "text": "南北长两公里。",
      "token_start": 647,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 193030,
      "end_ms": 198030,
      "text": "郑和首航用的两百零八艘船全是从这儿造出来，",
      "token_start": 653,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 199110,
      "end_ms": 204850,
      "text": "里面最大的宝船长四十四丈宽十八丈，",
      "token_start": 673,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 205710,
      "end_ms": 205950,
      "text": "宽，",
      "token_start": 689,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 205990,
      "end_ms": 209110,
      "text": "算下来将近一百四十米，",
      "token_start": 690,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 209110,
      "end_ms": 211280,
      "text": "长六十米宽，",
      "token_start": 700,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 212160,
      "end_ms": 214020,
      "text": "排水量上千吨，",
      "token_start": 705,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 214560,
      "end_ms": 217680,
      "text": "是当时世界上最大的木帆船。",
      "token_start": 711,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 218300,
      "end_ms": 221620,
      "text": "这个记录一直保持到十九世纪末，",
      "token_start": 723,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 222180,
      "end_ms": 225680,
      "text": "哥伦布的船跟他比就是条小k板。",
      "token_start": 737,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 226160,
      "end_ms": 230180,
      "text": "朱棣为什么能派郑和七下西洋底气？",
      "token_start": 751,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 230260,
      "end_ms": 232620,
      "text": "就在这儿船厂里，",
      "token_start": 766,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 232620,
      "end_ms": 237060,
      "text": "上万名工匠日夜不停的造一座船厂，",
      "token_start": 773,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 237360,
      "end_ms": 239280,
      "text": "撑起了一个海上帝国。",
      "token_start": 788,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 239440,
      "end_ms": 247105,
      "text": "第七名嗯武当山古建筑群在湖北十堰朱棣从永乐十年开始，",
      "token_start": 797,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 247560,
      "end_ms": 253155,
      "text": "派了五百多名官员率领二十万军民工匠上武当山干什么？",
      "token_start": 822,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 253520,
      "end_ms": 254635,
      "text": "修道教公观，",
      "token_start": 846,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 254910,
      "end_ms": 256185,
      "text": "整整修了十二年，",
      "token_start": 851,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 256460,
      "end_ms": 261075,
      "text": "建成了九宫九关三十六安堂七十二眼庙，",
      "token_start": 858,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 261870,
      "end_ms": 263785,
      "text": "一共三十三组建筑群。",
      "token_start": 875,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 264180,
      "end_ms": 265425,
      "text": "最绝的是经典，",
      "token_start": 884,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 265730,
      "end_ms": 267145,
      "text": "在天柱峰顶上，",
      "token_start": 890,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 267800,
      "end_ms": 268525,
      "text": "朱棣下令，",
      "token_start": 896,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 268990,
      "end_ms": 271205,
      "text": "山体本身一点都不能动，",
      "token_start": 900,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 271860,
      "end_ms": 273445,
      "text": "墙要顺着山势修。",
      "token_start": 910,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 273980,
      "end_ms": 276100,
      "text": "金殿是一座铜住的建筑，",
      "token_start": 917,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 276240,
      "end_ms": 279535,
      "text": "也是中国现存最大的铜筑建筑物。",
      "token_start": 927,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 280050,
      "end_ms": 283635,
      "text": "北京修子禁城、武当修金顶，",
      "token_start": 941,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 283970,
      "end_ms": 284810,
      "text": "一南一北，",
      "token_start": 952,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 285050,
      "end_ms": 286115,
      "text": "遥相呼应。",
      "token_start": 956,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 287200,
      "end_ms": 287745,
      "text": "第六名，",
      "token_start": 960,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 288030,
      "end_ms": 290310,
      "text": "明长城朱棣，",
      "token_start": 963,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 290370,
      "end_ms": 291685,
      "text": "迁都北京以后，",
      "token_start": 968,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 292180,
      "end_ms": 293715,
      "text": "北京紧挨着边境。",
      "token_start": 974,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 294280,
      "end_ms": 297600,
      "text": "蒙古骑兵随时可能南下怎么办？",
      "token_start": 981,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 298420,
      "end_ms": 300240,
      "text": "修长城永乐年间，",
      "token_start": 994,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 300720,
      "end_ms": 303700,
      "text": "朱棣在北方大规模修筑长城，",
      "token_start": 1001,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 304120,
      "end_ms": 306340,
      "text": "把土墙改成砖石墙，",
      "token_start": 1013,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 307020,
      "end_ms": 308200,
      "text": "加高加厚，",
      "token_start": 1021,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 308560,
      "end_ms": 310820,
      "text": "从鸭绿江一直修到嘉峪关，",
      "token_start": 1025,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 311080,
      "end_ms": 314900,
      "text": "整个明长城全长八千八百多公里。",
      "token_start": 1036,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 315800,
      "end_ms": 317300,
      "text": "朱棣时期修的长城，",
      "token_start": 1050,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 317420,
      "end_ms": 320580,
      "text": "是明长城里最关键的一段后人，",
      "token_start": 1058,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 320580,
      "end_ms": 328150,
      "text": "说天子守国门就是从朱棣迁都北京大修长城开始的这五件事，",
      "token_start": 1071,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 328590,
      "end_ms": 335390,
      "text": "一庄比一庄大大报恩寺的琉璃塔是朱棣对母亲的念想，",
      "token_start": 1097,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 335430,
      "end_ms": 338030,
      "text": "天坛是对天地的敬畏，",
      "token_start": 1120,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 338810,
      "end_ms": 341430,
      "text": "龙江宝船厂是向海的雄心，",
      "token_start": 1129,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 341830,
      "end_ms": 344130,
      "text": "武当山是对道统的尊崇，",
      "token_start": 1140,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 344610,
      "end_ms": 347170,
      "text": "明长城是对北方的防线。",
      "token_start": 1150,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 347710,
      "end_ms": 350050,
      "text": "可这些还不是最震撼的。",
      "token_start": 1160,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 350710,
      "end_ms": 353585,
      "text": "接下来第五道第一有五个功程，",
      "token_start": 1170,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 354040,
      "end_ms": 355840,
      "text": "一个比一个惊天动地，",
      "token_start": 1183,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 355960,
      "end_ms": 357045,
      "text": "有一支船队，",
      "token_start": 1192,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 357400,
      "end_ms": 358395,
      "text": "两百多艘船，",
      "token_start": 1197,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 358690,
      "end_ms": 359855,
      "text": "两万七千多人，",
      "token_start": 1202,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 360180,
      "end_ms": 361120,
      "text": "比哥伦布早了。",
      "token_start": 1208,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 361120,
      "end_ms": 362315,
      "text": "八十七年出海。",
      "token_start": 1214,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 363130,
      "end_ms": 366055,
      "text": "有一座陵金丝楠木的大殿，",
      "token_start": 1220,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 366480,
      "end_ms": 367280,
      "text": "六百年了，",
      "token_start": 1231,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 367280,
      "end_ms": 368135,
      "text": "木头还香，",
      "token_start": 1235,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 368660,
      "end_ms": 373225,
      "text": "有一部书三亿七千万字全是手抄的，",
      "token_start": 1239,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 373690,
      "end_ms": 375965,
      "text": "有一条河打通了南北，",
      "token_start": 1254,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 376230,
      "end_ms": 377415,
      "text": "养活了北京城。",
      "token_start": 1263,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 377930,
      "end_ms": 379215,
      "text": "还有一座宫殿，",
      "token_start": 1269,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 379550,
      "end_ms": 381445,
      "text": "一百万人修了十四年，",
      "token_start": 1275,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 381930,
      "end_ms": 384575,
      "text": "他们是哪几个下集马上更新。",
      "token_start": 1284,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 384990,
      "end_ms": 386800,
      "text": "您先点个关注点，",
      "token_start": 1296,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 386800,
      "end_ms": 388275,
      "text": "开头像别走丢。",
      "token_start": 1303,
      "token_end_exclusive": 1309
    }
  ],
