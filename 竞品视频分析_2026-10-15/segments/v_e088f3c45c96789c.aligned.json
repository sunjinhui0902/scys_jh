{
  "video_id": "v_e088f3c45c96789c",
  "duration_s": 506.344828,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_e088f3c45c96789c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_e088f3c45c96789c.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 590,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 590,
      "end_ms": 5250,
      "text": "咱们说到一九七零年五十四岁的黄伟路，",
      "token_start": 2,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 5690,
      "end_ms": 6750,
      "text": "临危受命，",
      "token_start": 19,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 7090,
      "end_ms": 12910,
      "text": "当了中国第一枚潜地固体导弹巨浪一号的总设计师，",
      "token_start": 23,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 13530,
      "end_ms": 15070,
      "text": "可么叫潜地导弹，",
      "token_start": 45,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 15590,
      "end_ms": 21230,
      "text": "就是从潜艇水下发射的战略导弹陆地上的导弹，",
      "token_start": 52,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 21530,
      "end_ms": 23090,
      "text": "敌人卫星看得见。",
      "token_start": 72,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 23310,
      "end_ms": 26790,
      "text": "找得到可藏在深海里的导弹，",
      "token_start": 79,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 27110,
      "end_ms": 28890,
      "text": "你永远不知道它在哪。",
      "token_start": 91,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 29310,
      "end_ms": 31600,
      "text": "这就是一个一个国家最后的底牌。",
      "token_start": 100,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 31960,
      "end_ms": 33580,
      "text": "二次战略反击能力。",
      "token_start": 114,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 34420,
      "end_ms": 35140,
      "text": "说白了，",
      "token_start": 122,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 35940,
      "end_ms": 37040,
      "text": "有了这个东西，",
      "token_start": 125,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 37160,
      "end_ms": 39140,
      "text": "就算陆地全被端了，",
      "token_start": 131,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 39520,
      "end_ms": 42020,
      "text": "深海里还有一支力量能还手。",
      "token_start": 139,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 42800,
      "end_ms": 43500,
      "text": "有了它，",
      "token_start": 151,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 44100,
      "end_ms": 46020,
      "text": "谁也不敢轻易动武，",
      "token_start": 154,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 47060,
      "end_ms": 48420,
      "text": "可这东西太难了，",
      "token_start": 162,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 49320,
      "end_ms": 50580,
      "text": "海水有压力，",
      "token_start": 169,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 52160,
      "end_ms": 53440,
      "text": "潜艇在摇晃，",
      "token_start": 174,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 53920,
      "end_ms": 55840,
      "text": "水下通信是难题，",
      "token_start": 179,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 56480,
      "end_ms": 61525,
      "text": "导弹出水那一瞬间的控制更是难上加难。",
      "token_start": 186,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 62220,
      "end_ms": 63060,
      "text": "没有资料，",
      "token_start": 203,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 63280,
      "end_ms": 64185,
      "text": "没有经验，",
      "token_start": 207,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 64750,
      "end_ms": 67635,
      "text": "连个可以参考的样品都没有，",
      "token_start": 211,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 69200,
      "end_ms": 69735,
      "text": "怎么搞？",
      "token_start": 223,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 70230,
      "end_ms": 72055,
      "text": "黄伟禄说了四个字，",
      "token_start": 226,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 72480,
      "end_ms": 73425,
      "text": "自力更生。",
      "token_start": 234,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 74160,
      "end_ms": 77230,
      "text": "第一个大难题就是测导弹模型，",
      "token_start": 238,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 77250,
      "end_ms": 82085,
      "text": "从高空落水的数据没有试验场怎么办？",
      "token_start": 251,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 83290,
      "end_ms": 87145,
      "text": "黄伟禄一拍大腿去南京长江大桥。",
      "token_start": 267,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 88230,
      "end_ms": 89815,
      "text": "一九七零年七月，",
      "token_start": 281,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 90710,
      "end_ms": 96845,
      "text": "南京长江大桥上出现了一幕让路人目瞪口呆的场景，",
      "token_start": 288,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 97380,
      "end_ms": 103375,
      "text": "一台大吊车把十几吨重的模型蛋从桥上往长江里扔，",
      "token_start": 310,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 103820,
      "end_ms": 104935,
      "text": "各种角度扔，",
      "token_start": 332,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 105280,
      "end_ms": 106605,
      "text": "扔了捞捞了人。",
      "token_start": 337,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 107450,
      "end_ms": 108785,
      "text": "当时是三伏天，",
      "token_start": 343,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 109270,
      "end_ms": 111955,
      "text": "桥上的铁蛋体被太阳晒得滚烫，",
      "token_start": 349,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 112500,
      "end_ms": 114625,
      "text": "里面温度超过五十度，",
      "token_start": 362,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 115530,
      "end_ms": 117070,
      "text": "跟蒸笼一样快。",
      "token_start": 371,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 117170,
      "end_ms": 122510,
      "text": "六十岁的黄伟禄光着膀子跟年轻小伙子一样，",
      "token_start": 377,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 122830,
      "end_ms": 126650,
      "text": "每天钻进弹体里检查数据出来的时候，",
      "token_start": 396,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 126910,
      "end_ms": 129270,
      "text": "整个人像从水里捞出来的，",
      "token_start": 412,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 129450,
      "end_ms": 131130,
      "text": "浑身长满痱子。",
      "token_start": 423,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 131610,
      "end_ms": 133710,
      "text": "晚上就住简易工棚，",
      "token_start": 429,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 134230,
      "end_ms": 135190,
      "text": "蚊子成群，",
      "token_start": 437,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 135650,
      "end_ms": 136750,
      "text": "闷热难耐，",
      "token_start": 441,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 137310,
      "end_ms": 140410,
      "text": "席子上都能印出一个人形汉字。",
      "token_start": 445,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 141050,
      "end_ms": 143090,
      "text": "他们就是用这种土办法，",
      "token_start": 458,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 143390,
      "end_ms": 144890,
      "text": "拿一身的痱子，",
      "token_start": 468,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 145210,
      "end_ms": 147650,
      "text": "换来了宝贵的试验数据。",
      "token_start": 474,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 148090,
      "end_ms": 153010,
      "text": "这一干就是十二年十二年，",
      "token_start": 484,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 153430,
      "end_ms": 155530,
      "text": "四千多个日日夜夜，",
      "token_start": 495,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 156710,
      "end_ms": 161870,
      "text": "黄伟禄带着团队从一张白纸开始，",
      "token_start": 503,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 162030,
      "end_ms": 164310,
      "text": "硬生生把这条路趟出来了。",
      "token_start": 517,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 165490,
      "end_ms": 167550,
      "text": "一九八二年十月七日，",
      "token_start": 528,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 168070,
      "end_ms": 174850,
      "text": "渤海海面上万众瞩目巨浪一号首次水下发射试验，",
      "token_start": 537,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 175170,
      "end_ms": 175870,
      "text": "开始了。",
      "token_start": 558,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 177470,
      "end_ms": 181900,
      "text": "点火导弹出水，",
      "token_start": 561,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 182440,
      "end_ms": 183940,
      "text": "然后失控了。",
      "token_start": 567,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 184780,
      "end_ms": 186940,
      "text": "导弹在空中偏离方向，",
      "token_start": 572,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 187120,
      "end_ms": 188620,
      "text": "超出安全范围，",
      "token_start": 581,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 188880,
      "end_ms": 190220,
      "text": "被安全引爆。",
      "token_start": 587,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 190740,
      "end_ms": 192380,
      "text": "全场鸦雀无声，",
      "token_start": 592,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 193080,
      "end_ms": 196380,
      "text": "几千人十几年的心血就这么没了，",
      "token_start": 598,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 197900,
      "end_ms": 204340,
      "text": "所有人的目光都集中在总设计师黄伟路一个人身上，",
      "token_start": 612,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 204920,
      "end_ms": 207640,
      "text": "那几天压力像山一样压过来。",
      "token_start": 634,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 208540,
      "end_ms": 211630,
      "text": "有人说是不是设计有问题，",
      "token_start": 646,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 212610,
      "end_ms": 214850,
      "text": "有人说是不是应该推迟。",
      "token_start": 657,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 215670,
      "end_ms": 219030,
      "text": "黄伟禄一句话没说把自己关在房间里，",
      "token_start": 667,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 219890,
      "end_ms": 226690,
      "text": "把导弹的每一个数据、每一个动作、每一道流程在脑子里过了一遍又一遍，",
      "token_start": 683,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 227170,
      "end_ms": 228810,
      "text": "最后查出来了原因，",
      "token_start": 713,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 228810,
      "end_ms": 229990,
      "text": "小的让人心碎。",
      "token_start": 721,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 230990,
      "end_ms": 233630,
      "text": "一个分离插头提前脱落了，",
      "token_start": 727,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 235270,
      "end_ms": 238310,
      "text": "就这么一个小零件毁了一次发射。",
      "token_start": 738,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 238690,
      "end_ms": 241160,
      "text": "十月十二日第二次发射，",
      "token_start": 752,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 241340,
      "end_ms": 241945,
      "text": "这一次，",
      "token_start": 762,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 242300,
      "end_ms": 244385,
      "text": "黄伟路顶住了所有压力，",
      "token_start": 765,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 244770,
      "end_ms": 245625,
      "text": "坚定的说，",
      "token_start": 775,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 246140,
      "end_ms": 247280,
      "text": "设计没问题。",
      "token_start": 779,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 247540,
      "end_ms": 248640,
      "text": "结构没问题，",
      "token_start": 784,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 248940,
      "end_ms": 249785,
      "text": "可以发射。",
      "token_start": 789,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 250200,
      "end_ms": 253715,
      "text": "上午发射命令下达渤海海面。",
      "token_start": 793,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 254290,
      "end_ms": 257065,
      "text": "一条喷火的蛟龙破水而出，",
      "token_start": 805,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 257680,
      "end_ms": 258700,
      "text": "腾空而起，",
      "token_start": 816,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 258940,
      "end_ms": 261595,
      "text": "穿云破雾直刺苍穹，",
      "token_start": 820,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 261960,
      "end_ms": 263995,
      "text": "成功了圆满成功。",
      "token_start": 828,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 264810,
      "end_ms": 268625,
      "text": "现场所有人抱在一起哭的哭喊的喊，",
      "token_start": 835,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 268940,
      "end_ms": 269420,
      "text": "中国，",
      "token_start": 850,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 269780,
      "end_ms": 274275,
      "text": "成为了世界上第五个掌握水下潜射导弹技术的国家，",
      "token_start": 852,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 274670,
      "end_ms": 280150,
      "text": "茫茫大海从此有了我们中国人的钢铁长城。",
      "token_start": 874,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 280350,
      "end_ms": 282410,
      "text": "可当大家欢呼胜利的时候，",
      "token_start": 892,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 282590,
      "end_ms": 286225,
      "text": "没人注意到慌黄纬路已经受的脱了刑。",
      "token_start": 903,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 286840,
      "end_ms": 287960,
      "text": "短短几个月，",
      "token_start": 919,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 288280,
      "end_ms": 290835,
      "text": "他的体重掉了整整十一公斤。",
      "token_start": 924,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 291240,
      "end_ms": 293890,
      "text": "二十二集呢同事看着他，",
      "token_start": 936,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 294050,
      "end_ms": 294890,
      "text": "含着眼泪说，",
      "token_start": 946,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 295230,
      "end_ms": 295825,
      "text": "黄总，",
      "token_start": 951,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 296160,
      "end_ms": 300290,
      "text": "您这是把自己的血肉都补在导弹上了啊。",
      "token_start": 953,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 300530,
      "end_ms": 301630,
      "text": "黄伟路笑了笑，",
      "token_start": 970,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 301870,
      "end_ms": 302410,
      "text": "说了一句，",
      "token_start": 976,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 302410,
      "end_ms": 303925,
      "text": "让所有人都忘不了的话。",
      "token_start": 980,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 304430,
      "end_ms": 308750,
      "text": "十一公斤比起成吨重的导弹算不了什么，",
      "token_start": 990,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 309170,
      "end_ms": 314030,
      "text": "但能用这一身血肉换来民族的希望和骄傲，",
      "token_start": 1007,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 314030,
      "end_ms": 314550,
      "text": "值了。",
      "token_start": 1025,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 316230,
      "end_ms": 316710,
      "text": "后来，",
      "token_start": 1027,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 316970,
      "end_ms": 319350,
      "text": "黄伟路又提出了一个大胆的想法，",
      "token_start": 1029,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 319530,
      "end_ms": 320350,
      "text": "一旦两用，",
      "token_start": 1043,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 320770,
      "end_ms": 323290,
      "text": "把海里的巨浪一号班上岸，",
      "token_start": 1047,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 323710,
      "end_ms": 326410,
      "text": "改成陆机机动固体战略导弹，",
      "token_start": 1058,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 326750,
      "end_ms": 329390,
      "text": "这就是后来大名鼎鼎的东风。",
      "token_start": 1070,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 329410,
      "end_ms": 332690,
      "text": "二十一、他还给团队定了一条规矩，",
      "token_start": 1082,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 333070,
      "end_ms": 335740,
      "text": "叫四共同有问题。",
      "token_start": 1096,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 335740,
      "end_ms": 337740,
      "text": "共同研究有困难，",
      "token_start": 1103,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 337800,
      "end_ms": 339840,
      "text": "共同克服有余量，",
      "token_start": 1110,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 340040,
      "end_ms": 341940,
      "text": "共同掌握有风险，",
      "token_start": 1117,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 342120,
      "end_ms": 344860,
      "text": "共同承担这条规矩。",
      "token_start": 1124,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 345300,
      "end_ms": 349480,
      "text": "到今天还是中国航天的金科玉律，",
      "token_start": 1132,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 349620,
      "end_ms": 350660,
      "text": "他对自己更狠，",
      "token_start": 1146,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 350920,
      "end_ms": 355280,
      "text": "定了个三个三、在基地跟工人一起排队买饭，",
      "token_start": 1152,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 355460,
      "end_ms": 356420,
      "text": "一起搞卫生，",
      "token_start": 1170,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 356700,
      "end_ms": 357780,
      "text": "一起搞卫生，",
      "token_start": 1175,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 358020,
      "end_ms": 359580,
      "text": "出差能走就行，",
      "token_start": 1180,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 359920,
      "end_ms": 360960,
      "text": "有饭吃就行，",
      "token_start": 1186,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 361220,
      "end_ms": 362340,
      "text": "有地方睡就行。",
      "token_start": 1191,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 362900,
      "end_ms": 366090,
      "text": "公车私人外出不用接送亲友，",
      "token_start": 1197,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 366090,
      "end_ms": 368285,
      "text": "不用家人有事儿不大。",
      "token_start": 1209,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 369160,
      "end_ms": 371545,
      "text": "一个为国家立下不世之功的人，",
      "token_start": 1218,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 371890,
      "end_ms": 374565,
      "text": "对自己竟然苛刻到了这种地步。",
      "token_start": 1231,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 375600,
      "end_ms": 376745,
      "text": "一九九九年，",
      "token_start": 1244,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 377240,
      "end_ms": 382805,
      "text": "八十三岁的黄伟禄被授予两弹一星功勋奖章。",
      "token_start": 1249,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 383820,
      "end_ms": 384880,
      "text": "直到这时候，",
      "token_start": 1268,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 384900,
      "end_ms": 393035,
      "text": "很多人才第一次知道这个慈祥的老人竟然为中国的导弹事业隐姓埋名了大半辈子。",
      "token_start": 1273,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 393980,
      "end_ms": 396135,
      "text": "二零一一年十一月二十三日，",
      "token_start": 1308,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 396440,
      "end_ms": 399535,
      "text": "九十五岁的黄伟路走完了他的一生，",
      "token_start": 1320,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 400090,
      "end_ms": 400895,
      "text": "临终前，",
      "token_start": 1335,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 401360,
      "end_ms": 404465,
      "text": "他用尽最后的力气说了那句话，",
      "token_start": 1338,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 405030,
      "end_ms": 406235,
      "text": "假如有来生，",
      "token_start": 1351,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 406660,
      "end_ms": 407835,
      "text": "我还要搞导弹。",
      "token_start": 1356,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 408430,
      "end_ms": 411485,
      "text": "他这一辈子只干了一件事，",
      "token_start": 1362,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 412290,
      "end_ms": 419575,
      "text": "高导弹从伦敦废墟里的那个青年到渤海之滨的白发老人，",
      "token_start": 1373,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 420530,
      "end_ms": 425965,
      "text": "他用一生兑现了二十七岁那年在废墟前许下的诺言。",
      "token_start": 1397,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 426750,
      "end_ms": 430355,
      "text": "今天东风浩荡巨浪滔天，",
      "token_start": 1419,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 430920,
      "end_ms": 433025,
      "text": "我们能安安稳稳过日子，",
      "token_start": 1429,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 433400,
      "end_ms": 435685,
      "text": "就是因为有黄伟路这样的人，",
      "token_start": 1439,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 436280,
      "end_ms": 441735,
      "text": "用血肉之躯为我们筑起了一道看不见的钢铁长城。",
      "token_start": 1451,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 442700,
      "end_ms": 449805,
      "text": "其实啊黄纬路只是千千万万为国奉献的科学家中的一位，",
      "token_start": 1472,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 450700,
      "end_ms": 452905,
      "text": "像他这样隐姓埋名，",
      "token_start": 1496,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 453440,
      "end_ms": 455375,
      "text": "拿命换国家底气的人，",
      "token_start": 1504,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 455770,
      "end_ms": 457015,
      "text": "还有太多太多。",
      "token_start": 1513,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 457990,
      "end_ms": 462590,
      "text": "钱学森、邓稼先、郭永怀、余敏每一位的故事。",
      "token_start": 1519,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 462590,
      "end_ms": 465675,
      "text": "单拎出来都能让你看的红了眼眶。",
      "token_start": 1536,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 466370,
      "end_ms": 468155,
      "text": "我最近一直在翻一本书，",
      "token_start": 1550,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 468580,
      "end_ms": 469935,
      "text": "叫国之脊梁，",
      "token_start": 1560,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 470470,
      "end_ms": 474545,
      "text": "里面就真真实实记录了这些先辈的真实经历。",
      "token_start": 1565,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 475200,
      "end_ms": 476340,
      "text": "没有流量明星，",
      "token_start": 1584,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 476600,
      "end_ms": 477820,
      "text": "没有八卦炒作，",
      "token_start": 1590,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 478180,
      "end_ms": 482335,
      "text": "全是实打实的撑起咱们民族腰杆的人和事。",
      "token_start": 1596,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 482850,
      "end_ms": 483590,
      "text": "书的链接，",
      "token_start": 1614,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 483590,
      "end_ms": 485075,
      "text": "我放在视频左下角了，",
      "token_start": 1618,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 485340,
      "end_ms": 487345,
      "text": "感兴趣的朋友可以直接拍下，",
      "token_start": 1627,
      "token_end_exclusive": 1639
    },
    {
      "start_ms": 487740,
      "end_ms": 488320,
      "text": "拿到手，",
      "token_start": 1639,
      "token_end_exclusive": 1642
    },
    {
      "start_ms": 488320,
      "end_ms": 489255,
      "text": "细细品读。",
      "token_start": 1642,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 489610,
      "end_ms": 491565,
      "text": "如果你也被这位老人感动了，",
      "token_start": 1646,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 491890,
      "end_ms": 492770,
      "text": "麻烦点个赞，",
      "token_start": 1658,
      "token_end_exclusive": 1663
    },
    {
      "start_ms": 492790,
      "end_ms": 494765,
      "text": "把这条视频收藏起来，",
      "token_start": 1663,
      "token_end_exclusive": 1672
    },
    {
      "start_ms": 495170,
      "end_ms": 496945,
      "text": "转发给身边的朋友，",
      "token_start": 1672,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 497500,
      "end_ms": 500805,
      "text": "让更多人记住黄伟路这三个字。",
      "token_start": 1680,
      "token_end_exclusive": 1693
    },
    {
      "start_ms": 501630,
      "end_ms": 503365,
      "text": "评论区留下一句黄老，",
      "token_start": 1693,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 503790,
      "end_ms": 505170,
      "text": "谢谢您下棋。",
      "token_start": 1702,
      "token_end_exclusive": 1707
    },
    {
      "start_ms": 505520,
      "end_ms": 506225,
      "text": "我们接着讲。",
      "token_start": 1707,
      "token_end_exclusive": 1712
    }
  ],
