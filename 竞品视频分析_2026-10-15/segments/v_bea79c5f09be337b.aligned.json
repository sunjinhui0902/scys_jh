  "segments": [
    {
      "start_ms": 50,
      "end_ms": 1290,
      "text": "这藕是好藕啊，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1530,
      "end_ms": 3750,
      "text": "就是心眼儿太多了。",
      "token_start": 6,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 3750,
      "end_ms": 5570,
      "text": "领导藕虽然心眼多，",
      "token_start": 14,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5650,
      "end_ms": 6910,
      "text": "但也是您的下酒菜啊。",
      "token_start": 22,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 8890,
      "end_ms": 10510,
      "text": "这鸭子是好鸭子，",
      "token_start": 31,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 10730,
      "end_ms": 11570,
      "text": "就是嘴硬，",
      "token_start": 38,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 11970,
      "end_ms": 12410,
      "text": "嘴硬，",
      "token_start": 42,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12410,
      "end_ms": 13290,
      "text": "才守得住秘密，",
      "token_start": 44,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 16850,
      "end_ms": 19010,
      "text": "小李今天让你破费了。",
      "token_start": 50,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 19290,
      "end_ms": 19730,
      "text": "领导，",
      "token_start": 59,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 19790,
      "end_ms": 21470,
      "text": "您说这些您能来，",
      "token_start": 61,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 21470,
      "end_ms": 22310,
      "text": "就是我的荣幸，",
      "token_start": 68,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 22450,
      "end_ms": 24290,
      "text": "以后还有很多地方向您请教，",
      "token_start": 74,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 24290,
      "end_ms": 28230,
      "text": "不是你酒量挺好的呀。",
      "token_start": 86,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 28270,
      "end_ms": 28650,
      "text": "领导，",
      "token_start": 95,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 28810,
      "end_ms": 29910,
      "text": "您可抬举我了，",
      "token_start": 97,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 29930,
      "end_ms": 31230,
      "text": "我平时真不太能喝，",
      "token_start": 103,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 31510,
      "end_ms": 32990,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 111,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 32990,
      "end_ms": 33550,
      "text": "高兴啊，",
      "token_start": 122,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 33690,
      "end_ms": 35110,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 125,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 36950,
      "end_ms": 37390,
      "text": "小李，",
      "token_start": 135,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 37410,
      "end_ms": 38590,
      "text": "最近表现不错啊，",
      "token_start": 137,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38750,
      "end_ms": 40550,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 144,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 40690,
      "end_ms": 41910,
      "text": "我得提前敬你一杯。",
      "token_start": 157,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 42190,
      "end_ms": 42890,
      "text": "听这意思，",
      "token_start": 165,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 42990,
      "end_ms": 44150,
      "text": "领导是要高升了呀，",
      "token_start": 169,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 44230,
      "end_ms": 46005,
      "text": "我得提前敬领导一杯。",
      "token_start": 177,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 47040,
      "end_ms": 47660,
      "text": "小李啊，",
      "token_start": 186,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 48120,
      "end_ms": 49980,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 189,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 50580,
      "end_ms": 53080,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 199,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 53360,
      "end_ms": 55400,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 212,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 57020,
      "end_ms": 57260,
      "text": "哎，",
      "token_start": 225,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 57500,
      "end_ms": 58460,
      "text": "你什么意思啊，",
      "token_start": 226,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 58580,
      "end_ms": 60140,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 232,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 60300,
      "end_ms": 61340,
      "text": "领导美满美满，",
      "token_start": 243,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 61540,
      "end_ms": 62580,
      "text": "代表幸福美满，",
      "token_start": 249,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 62820,
      "end_ms": 65545,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 255,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 67210,
      "end_ms": 68030,
      "text": "打这么多饭，",
      "token_start": 269,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 68090,
      "end_ms": 68790,
      "text": "你喂猪呢，",
      "token_start": 274,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 68890,
      "end_ms": 69270,
      "text": "领导，",
      "token_start": 278,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 69390,
      "end_ms": 70145,
      "text": "我哪儿敢啊？",
      "token_start": 280,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 70530,
      "end_ms": 72425,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 285,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 72720,
      "end_ms": 74120,
      "text": "都说宰相肚里能撑船，",
      "token_start": 301,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 74240,
      "end_ms": 76025,
      "text": "更何况只是一碗饭呢，",
      "token_start": 310,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 77220,
      "end_ms": 78555,
      "text": "我真不怎么喜欢你，",
      "token_start": 319,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 79070,
      "end_ms": 80830,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 327,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 80830,
      "end_ms": 83295,
      "text": "我领导的格局值得我们学习。",
      "token_start": 340,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 84440,
      "end_ms": 85955,
      "text": "哈哈哈哈哈哈哈哈，",
      "token_start": 352,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 86190,
      "end_ms": 86745,
      "text": "关注我，",
      "token_start": 360,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 87070,
      "end_ms": 88390,
      "text": "每天学点高情商，",
      "token_start": 363,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 88390,
      "end_ms": 89255,
      "text": "说话技巧，",
      "token_start": 370,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 89590,
      "end_ms": 91365,
      "text": "让你的路越走越宽。",
      "token_start": 374,
      "token_end_exclusive": 382
    }
  ],
