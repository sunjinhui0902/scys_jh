{
  "video_id": "v_560ac5ec2c5746f1",
  "duration_s": 458.375,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_560ac5ec2c5746f1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_560ac5ec2c5746f1.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 1010,
      "text": "二零零一年，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1230,
      "end_ms": 4950,
      "text": "美国国家安全档案馆解密了一批绝密文件，",
      "token_start": 5,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5390,
      "end_ms": 8130,
      "text": "揭开了一个藏了四十年的秘密。",
      "token_start": 23,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8870,
      "end_ms": 10690,
      "text": "早在上世纪六十年代，",
      "token_start": 36,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 11090,
      "end_ms": 15070,
      "text": "美国政府就认真研究过至少五套方案，",
      "token_start": 45,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 15530,
      "end_ms": 16870,
      "text": "目标只有一个，",
      "token_start": 61,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 17410,
      "end_ms": 19510,
      "text": "在中国拥有核武器之前，",
      "token_start": 67,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 20130,
      "end_ms": 22550,
      "text": "彻底摧毁中国的核计划，",
      "token_start": 77,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 23310,
      "end_ms": 26450,
      "text": "从特工渗透到海上封锁，",
      "token_start": 87,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 27130,
      "end_ms": 31120,
      "text": "从拉拢苏联联手到挑动动周边局势，",
      "token_start": 97,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 31680,
      "end_ms": 34420,
      "text": "能用的招全摆上了桌面。",
      "token_start": 112,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 34660,
      "end_ms": 37660,
      "text": "可最后这些计划全部作废，",
      "token_start": 122,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 37780,
      "end_ms": 38900,
      "text": "不是他们不想，",
      "token_start": 133,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 39260,
      "end_ms": 40460,
      "text": "是根本做不到。",
      "token_start": 139,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 41180,
      "end_ms": 43040,
      "text": "因为美国情报部门发现，",
      "token_start": 145,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 43400,
      "end_ms": 46380,
      "text": "中国核事业最关键的一批人才，",
      "token_start": 155,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 46940,
      "end_ms": 48720,
      "text": "几乎都连着同一个人，",
      "token_start": 168,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 49540,
      "end_ms": 52780,
      "text": "就算炸掉几座工厂几个基地，",
      "token_start": 177,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 53220,
      "end_ms": 55060,
      "text": "就算这支人才队伍还在，",
      "token_start": 189,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 55560,
      "end_ms": 58360,
      "text": "中国的核计划就永远炸不掉。",
      "token_start": 199,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 59260,
      "end_ms": 61445,
      "text": "这个人叫前三强。",
      "token_start": 211,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 61790,
      "end_ms": 63395,
      "text": "他原名钱炳琼，",
      "token_start": 218,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 64000,
      "end_ms": 68545,
      "text": "一九一三年出生在浙江湖州的书香世家。",
      "token_start": 224,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 69100,
      "end_ms": 73015,
      "text": "父亲钱玄同是新文化运动的先锋，",
      "token_start": 241,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 73630,
      "end_ms": 77920,
      "text": "和陈独秀一起编新青年的国学大师。",
      "token_start": 255,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 78180,
      "end_ms": 78740,
      "text": "小时候，",
      "token_start": 270,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 78740,
      "end_ms": 79680,
      "text": "他排行老三，",
      "token_start": 273,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 80020,
      "end_ms": 81145,
      "text": "身体特别壮，",
      "token_start": 278,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 81470,
      "end_ms": 84325,
      "text": "同学给他起了个绰号叫三强。",
      "token_start": 283,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 85140,
      "end_ms": 85935,
      "text": "父亲一听，",
      "token_start": 295,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 86260,
      "end_ms": 88110,
      "text": "觉得这名字好三强，",
      "token_start": 299,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 88640,
      "end_ms": 89705,
      "text": "就是品格强，",
      "token_start": 307,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 90130,
      "end_ms": 92005,
      "text": "学识强、身体强。",
      "token_start": 312,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 92460,
      "end_ms": 92860,
      "text": "于是，",
      "token_start": 318,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 92860,
      "end_ms": 97450,
      "text": "钱炳琼正式改名叫钱三强一九三三年，",
      "token_start": 320,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 97730,
      "end_ms": 100110,
      "text": "钱三强刚考入清华物理系。",
      "token_start": 336,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 100530,
      "end_ms": 102430,
      "text": "父亲亲手写了一幅字，",
      "token_start": 347,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 102690,
      "end_ms": 103415,
      "text": "送给他，",
      "token_start": 356,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 103680,
      "end_ms": 104495,
      "text": "只有四个字，",
      "token_start": 359,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 104860,
      "end_ms": 107780,
      "text": "从牛到爱前三强属牛。",
      "token_start": 364,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 108240,
      "end_ms": 111015,
      "text": "父亲希望他发扬那股子牛劲儿，",
      "token_start": 373,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 111380,
      "end_ms": 113860,
      "text": "同时向牛顿和爱因斯坦学习。",
      "token_start": 386,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 114040,
      "end_ms": 114820,
      "text": "这四个字，",
      "token_start": 398,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 115040,
      "end_ms": 116145,
      "text": "他带了一辈子，",
      "token_start": 402,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 116440,
      "end_ms": 118085,
      "text": "最后刻在了墓碑上。",
      "token_start": 408,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 118670,
      "end_ms": 122335,
      "text": "一九三二年前三强考清华考了第二名，",
      "token_start": 416,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 122720,
      "end_ms": 123940,
      "text": "他心里很不服气。",
      "token_start": 432,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 124300,
      "end_ms": 125695,
      "text": "更让他意外的是，",
      "token_start": 439,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 126110,
      "end_ms": 128130,
      "text": "第一名居然是个女生，",
      "token_start": 446,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 128470,
      "end_ms": 135625,
      "text": "叫何泽慧、物理、数学、德文、三科都比他高出三分以上。",
      "token_start": 455,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 136400,
      "end_ms": 140375,
      "text": "这份差距让心高气傲的前三强憋足了劲儿，",
      "token_start": 476,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 140920,
      "end_ms": 143245,
      "text": "他开始悄悄观察这个对手。",
      "token_start": 494,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 143690,
      "end_ms": 146905,
      "text": "女孩每天清晨六点就守在图书馆，",
      "token_start": 505,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 147470,
      "end_ms": 151390,
      "text": "研读的都是研究生才涉猎的相对论原理，",
      "token_start": 519,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 151470,
      "end_ms": 154005,
      "text": "甚至能左手演算公式，",
      "token_start": 536,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 154650,
      "end_ms": 158870,
      "text": "右手绘制晶体结构图前三强，",
      "token_start": 545,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 159070,
      "end_ms": 160145,
      "text": "越看越服气。",
      "token_start": 557,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 160970,
      "end_ms": 164005,
      "text": "看着看着就看出了别的心思。",
      "token_start": 562,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 165130,
      "end_ms": 166310,
      "text": "清华园八年，",
      "token_start": 574,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 166350,
      "end_ms": 170540,
      "text": "同窗毕业论文排名何泽惠九十分，",
      "token_start": 579,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 170540,
      "end_ms": 172660,
      "text": "第一前三强八十九分。",
      "token_start": 593,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 172660,
      "end_ms": 173015,
      "text": "第二，",
      "token_start": 602,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 173440,
      "end_ms": 174565,
      "text": "他又输了一分，",
      "token_start": 604,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 174940,
      "end_ms": 176075,
      "text": "但他做了一个决定，",
      "token_start": 610,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 176510,
      "end_ms": 178625,
      "text": "把第一名娶回家。",
      "token_start": 618,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 179680,
      "end_ms": 183615,
      "text": "一九三六年毕业何则会申请南京兵工署，",
      "token_start": 625,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 184190,
      "end_ms": 186155,
      "text": "却因为是女生被拒了。",
      "token_start": 642,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 186980,
      "end_ms": 191810,
      "text": "他远赴柏林高等工业大学攻读弹道学博士，",
      "token_start": 651,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 191970,
      "end_ms": 195305,
      "text": "前三强则赴法国进入居里实验室，",
      "token_start": 669,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 195720,
      "end_ms": 197845,
      "text": "一头扎进核物理研究。",
      "token_start": 683,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 198680,
      "end_ms": 200785,
      "text": "两人一别就是七年，",
      "token_start": 692,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 201740,
      "end_ms": 204695,
      "text": "一九三七年七七事变爆发，",
      "token_start": 700,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 205140,
      "end_ms": 207435,
      "text": "父亲病重卧床啊，",
      "token_start": 711,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 207640,
      "end_ms": 209295,
      "text": "病榻上的父亲对他说，",
      "token_start": 718,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 209760,
      "end_ms": 210780,
      "text": "你学的东西，",
      "token_start": 727,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 210820,
      "end_ms": 212625,
      "text": "将来对国家是有用的，",
      "token_start": 732,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 213390,
      "end_ms": 214575,
      "text": "报效祖国，",
      "token_start": 741,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 214930,
      "end_ms": 216710,
      "text": "造福社会路程。",
      "token_start": 745,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 216710,
      "end_ms": 219665,
      "text": "还远得很男儿志在四方，",
      "token_start": 751,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 219960,
      "end_ms": 222390,
      "text": "不能只顾近忧前三强，",
      "token_start": 761,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 222410,
      "end_ms": 224965,
      "text": "含泪登上了去法国的轮船。",
      "token_start": 770,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 225480,
      "end_ms": 229915,
      "text": "他的导师是居里夫人的长女诺贝尔奖得主。",
      "token_start": 781,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 230260,
      "end_ms": 237225,
      "text": "伊莲娜飞约里奥居里导师对他的评价是十年期间再到我们实验室，",
      "token_start": 799,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 237560,
      "end_ms": 240745,
      "text": "并由我们指导工作的同时代人当中，",
      "token_start": 827,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 241180,
      "end_ms": 242355,
      "text": "他是最优秀的。",
      "token_start": 842,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 244040,
      "end_ms": 244975,
      "text": "一九四三年，",
      "token_start": 848,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 245500,
      "end_ms": 248925,
      "text": "滞留在德国的合泽会和国内亲人彻底失联。",
      "token_start": 853,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 249500,
      "end_ms": 250835,
      "text": "彷徨无助之际，",
      "token_start": 871,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 251120,
      "end_ms": 253065,
      "text": "他想起了清华的老同学，",
      "token_start": 877,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 253440,
      "end_ms": 256665,
      "text": "提笔写下一封短信前三强。",
      "token_start": 887,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 257030,
      "end_ms": 258775,
      "text": "你是否仍在巴黎，",
      "token_start": 898,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 259370,
      "end_ms": 263825,
      "text": "若方便反省代我向国内父母报平安，",
      "token_start": 905,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 264650,
      "end_ms": 267485,
      "text": "这封信成了跨越国界的纽带。",
      "token_start": 920,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 268260,
      "end_ms": 268680,
      "text": "此后，",
      "token_start": 932,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 268720,
      "end_ms": 271180,
      "text": "两人通信越来越频繁。",
      "token_start": 934,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 271240,
      "end_ms": 274015,
      "text": "从学业近况聊到科研难题。",
      "token_start": 943,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 274390,
      "end_ms": 276950,
      "text": "从战争局势聊到家国情怀，",
      "token_start": 954,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 277350,
      "end_ms": 278965,
      "text": "心越靠越近。",
      "token_start": 965,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 279790,
      "end_ms": 280875,
      "text": "一九四六年，",
      "token_start": 970,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 281380,
      "end_ms": 283075,
      "text": "钱三强写下求婚信，",
      "token_start": 975,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 283470,
      "end_ms": 286850,
      "text": "整封信只有二十五个单词翻译过来，",
      "token_start": 983,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 286850,
      "end_ms": 289115,
      "text": "就是经过长期通信，",
      "token_start": 998,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 289560,
      "end_ms": 291680,
      "text": "我向你提出结婚的请求，",
      "token_start": 1006,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 292380,
      "end_ms": 294355,
      "text": "如能同意请回信。",
      "token_start": 1016,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 294850,
      "end_ms": 296535,
      "text": "何泽慧的回答很干脆，",
      "token_start": 1023,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 296920,
      "end_ms": 298105,
      "text": "感谢你的爱情，",
      "token_start": 1032,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 298490,
      "end_ms": 300250,
      "text": "我将对你永远忠诚。",
      "token_start": 1038,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 300730,
      "end_ms": 301970,
      "text": "等我们见面后，",
      "token_start": 1046,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 302130,
      "end_ms": 307315,
      "text": "一同回国童年两人在中国驻法国大使馆。",
      "token_start": 1052,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 307630,
      "end_ms": 313650,
      "text": "注册结婚约里奥居里夫妇特意出席见证，",
      "token_start": 1069,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 314430,
      "end_ms": 319810,
      "text": "婚后两人携手发现右和三分裂四分裂现象，",
      "token_start": 1086,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 320850,
      "end_ms": 325850,
      "text": "打破了物理学界原子核只能一分为二的固有认知，",
      "token_start": 1104,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 326390,
      "end_ms": 330290,
      "text": "被西方媒体称为中国的居里夫妇。",
      "token_start": 1125,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 331330,
      "end_ms": 332370,
      "text": "一九四七年，",
      "token_start": 1139,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 333050,
      "end_ms": 339640,
      "text": "三十四岁的前三强成为法国国家科学研究中心最年轻的研究导师，",
      "token_start": 1144,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 340140,
      "end_ms": 343360,
      "text": "也是第一个拿到这个职位的中国人，",
      "token_start": 1172,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 343820,
      "end_ms": 351560,
      "text": "留在法国顶尖实验室优厚待遇冲击诺奖的坦途就在眼前。",
      "token_start": 1187,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 351760,
      "end_ms": 356340,
      "text": "但一九四八年前三强做了一个让所有人惊诧的决定，",
      "token_start": 1211,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 356700,
      "end_ms": 358260,
      "text": "回国导师挽留。",
      "token_start": 1233,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 358620,
      "end_ms": 359040,
      "text": "他说，",
      "token_start": 1239,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 359460,
      "end_ms": 360940,
      "text": "虽然科学没有国界，",
      "token_start": 1241,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 361080,
      "end_ms": 362740,
      "text": "科学家却是有祖国的，",
      "token_start": 1249,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 363100,
      "end_ms": 364840,
      "text": "祖国再穷是自己的，",
      "token_start": 1258,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 365040,
      "end_ms": 367845,
      "text": "而且正因为他贫穷落后后，",
      "token_start": 1266,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 368240,
      "end_ms": 372065,
      "text": "才更需要我们去努力改变他的面貌。",
      "token_start": 1277,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 372740,
      "end_ms": 373625,
      "text": "临走时，",
      "token_start": 1292,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 374030,
      "end_ms": 378395,
      "text": "居里夫人送给他十克碳酸钡酶标准元，",
      "token_start": 1295,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 379010,
      "end_ms": 381085,
      "text": "还有一些保密的实验数据。",
      "token_start": 1311,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 382240,
      "end_ms": 383540,
      "text": "一九四八年五月，",
      "token_start": 1322,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 383780,
      "end_ms": 391040,
      "text": "钱三强和何泽惠抱着刚半岁的女儿带着十几箱国内稀缺的科研器材和绝版专业图书，",
      "token_start": 1329,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 391260,
      "end_ms": 392865,
      "text": "登上了回国的客船，",
      "token_start": 1365,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 393440,
      "end_ms": 395280,
      "text": "海上颠簸了一个月。",
      "token_start": 1373,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 395600,
      "end_ms": 396365,
      "text": "零两天。",
      "token_start": 1381,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 397100,
      "end_ms": 398145,
      "text": "故事讲到这儿，",
      "token_start": 1384,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 398330,
      "end_ms": 401415,
      "text": "你可能以为回国之后就是鲜花和掌声，",
      "token_start": 1390,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 401820,
      "end_ms": 407545,
      "text": "没有等待他们的是一个原子能事业完全空白的中国。",
      "token_start": 1406,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 408450,
      "end_ms": 411295,
      "text": "而前三强回国后做的第一件事儿，",
      "token_start": 1428,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 411770,
      "end_ms": 413190,
      "text": "居然不是搞科研，",
      "token_start": 1442,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 413390,
      "end_ms": 416175,
      "text": "是找人他找的那些人。",
      "token_start": 1449,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 416680,
      "end_ms": 420045,
      "text": "后来让美国的五套打击方案彻底泡了汤，",
      "token_start": 1458,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 420770,
      "end_ms": 425850,
      "text": "他到底是怎么在一穷二白的条件下布下中国核事业？",
      "token_start": 1475,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 425850,
      "end_ms": 428770,
      "text": "这盘大棋的下集告诉你，",
      "token_start": 1497,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 429670,
      "end_ms": 431470,
      "text": "看到这儿先别划走，",
      "token_start": 1507,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 432330,
      "end_ms": 432970,
      "text": "点个赞，",
      "token_start": 1515,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 433830,
      "end_ms": 436150,
      "text": "是对这位铺路石的敬意。",
      "token_start": 1518,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 436370,
      "end_ms": 437890,
      "text": "收藏起来讲，",
      "token_start": 1528,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 437930,
      "end_ms": 441410,
      "text": "给你的孩子听真正的国之重器，",
      "token_start": 1533,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 441790,
      "end_ms": 442310,
      "text": "背后，",
      "token_start": 1546,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 442530,
      "end_ms": 444570,
      "text": "是一群拿命拼的人，",
      "token_start": 1548,
      "token_end_exclusive": 1556
    },
    {
      "start_ms": 444890,
      "end_ms": 446370,
      "text": "转发给更多人，",
      "token_start": 1556,
      "token_end_exclusive": 1562
    },
    {
      "start_ms": 446950,
      "end_ms": 449970,
      "text": "让钱三强这个名字被更多人记住。",
      "token_start": 1562,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 450270,
      "end_ms": 450970,
      "text": "关注我，",
      "token_start": 1576,
      "token_end_exclusive": 1579
    },
    {
      "start_ms": 451150,
      "end_ms": 452050,
      "text": "下集更狠，",
      "token_start": 1579,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 453630,
      "end_ms": 455590,
      "text": "原子弹爆炸那天是他生日，",
      "token_start": 1583,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 456110,
      "end_ms": 456850,
      "text": "真天后，",
      "token_start": 1594,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 456930,
      "end_ms": 458145,
      "text": "他被下创农村。",
      "token_start": 1597,
      "token_end_exclusive": 1603
    }
  ],
