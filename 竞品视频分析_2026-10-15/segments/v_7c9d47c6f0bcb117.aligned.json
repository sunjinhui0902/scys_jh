{
  "video_id": "v_7c9d47c6f0bcb117",
  "duration_s": 611.636009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_7c9d47c6f0bcb117.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_7c9d47c6f0bcb117.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1470,
      "text": "我跟大家宣布一件事，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 1750,
      "end_ms": 2650,
      "text": "从今天开始，",
      "token_start": 9,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 2930,
      "end_ms": 4830,
      "text": "琳琳就是我们销售部的经理，",
      "token_start": 14,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5070,
      "end_ms": 6025,
      "text": "大家鼓掌祝贺，",
      "token_start": 26,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 11480,
      "end_ms": 12140,
      "text": "谢谢王姐，",
      "token_start": 32,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 12140,
      "end_ms": 12935,
      "text": "也谢谢大家。",
      "token_start": 36,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 16860,
      "end_ms": 18780,
      "text": "王姐怎么了？",
      "token_start": 41,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 20080,
      "end_ms": 21500,
      "text": "我有件事想不明白，",
      "token_start": 46,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 22460,
      "end_ms": 24920,
      "text": "你说凭什么玲玲能当经理？",
      "token_start": 54,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 25320,
      "end_ms": 28640,
      "text": "我不能我俩可是同时进公司的，",
      "token_start": 65,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 28840,
      "end_ms": 30040,
      "text": "我每天来的比他早，",
      "token_start": 78,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 30040,
      "end_ms": 30860,
      "text": "走的比他晚，",
      "token_start": 86,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 31140,
      "end_ms": 32420,
      "text": "业务上我也没比他差。",
      "token_start": 91,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 32700,
      "end_ms": 34320,
      "text": "为什么这个位置不能让我来做？",
      "token_start": 100,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 34800,
      "end_ms": 35400,
      "text": "小张啊，",
      "token_start": 113,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 36000,
      "end_ms": 38220,
      "text": "你平时的努力大家都看得到，",
      "token_start": 116,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 38880,
      "end_ms": 42660,
      "text": "但是工作可不是光靠勤奋就能做好的那还要靠什么？",
      "token_start": 128,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 43080,
      "end_ms": 45340,
      "text": "正好明天李总那边有个项目要谈，",
      "token_start": 150,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 45920,
      "end_ms": 48330,
      "text": "你跟玲玲一起跟我去什么项目。",
      "token_start": 164,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 50670,
      "end_ms": 55290,
      "text": "一千万这个项目李总很重视，",
      "token_start": 177,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 55770,
      "end_ms": 56790,
      "text": "明天你俩都去。",
      "token_start": 189,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 56990,
      "end_ms": 58490,
      "text": "至于你刚才问我的问题，",
      "token_start": 195,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 59530,
      "end_ms": 60225,
      "text": "先别急，",
      "token_start": 205,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 61180,
      "end_ms": 62540,
      "text": "等这个项目结束以后，",
      "token_start": 208,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 62740,
      "end_ms": 63995,
      "text": "你自己告诉我答案。",
      "token_start": 217,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 64660,
      "end_ms": 65125,
      "text": "行，",
      "token_start": 225,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 66040,
      "end_ms": 68125,
      "text": "那我就看看我到底差在哪儿。",
      "token_start": 226,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 71350,
      "end_ms": 71895,
      "text": "李总，",
      "token_start": 238,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 72270,
      "end_ms": 73905,
      "text": "王姐一路辛苦了。",
      "token_start": 240,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 75600,
      "end_ms": 77060,
      "text": "关于这个项目的供应链充值，",
      "token_start": 247,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 77060,
      "end_ms": 78060,
      "text": "你们有什么具体方案，",
      "token_start": 259,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 78080,
      "end_ms": 79200,
      "text": "我们做了两套预案。",
      "token_start": 268,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 79280,
      "end_ms": 80500,
      "text": "一是通过集中采购，",
      "token_start": 276,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 80520,
      "end_ms": 81460,
      "text": "降低原材料成本。",
      "token_start": 284,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 81580,
      "end_ms": 82760,
      "text": "二是优化物流路线，",
      "token_start": 291,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 82940,
      "end_ms": 84945,
      "text": "预计能压缩百分之十五的损耗。",
      "token_start": 299,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 89880,
      "end_ms": 90555,
      "text": "小张啊，",
      "token_start": 312,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 91150,
      "end_ms": 93670,
      "text": "你是第一个十来分钟就能把项目谈下来的人，",
      "token_start": 315,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 93910,
      "end_ms": 95070,
      "text": "真是后生可畏啊，",
      "token_start": 334,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 95070,
      "end_ms": 97295,
      "text": "哪里哪里还是我们王姐厉害，",
      "token_start": 341,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 97530,
      "end_ms": 98555,
      "text": "我就是个打辅助的，",
      "token_start": 353,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 102200,
      "end_ms": 103060,
      "text": "好好合同，",
      "token_start": 361,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 103060,
      "end_ms": 104165,
      "text": "今天先不着急签，",
      "token_start": 365,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 104740,
      "end_ms": 106255,
      "text": "李总还有什么问题吗？",
      "token_start": 372,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 106550,
      "end_ms": 108730,
      "text": "没什么这么大的项目，",
      "token_start": 381,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 108890,
      "end_ms": 109915,
      "text": "我再考虑考虑。",
      "token_start": 390,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 110600,
      "end_ms": 111085,
      "text": "李总，",
      "token_start": 396,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 111470,
      "end_ms": 113020,
      "text": "这正好明天晚上，",
      "token_start": 398,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 113020,
      "end_ms": 114470,
      "text": "我组了个局陈，",
      "token_start": 405,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 114470,
      "end_ms": 115295,
      "text": "总也会过来。",
      "token_start": 411,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 115860,
      "end_ms": 118175,
      "text": "王姐要是有时间一起吃个饭，",
      "token_start": 416,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 119380,
      "end_ms": 120265,
      "text": "李总邀请，",
      "token_start": 428,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 120620,
      "end_ms": 121515,
      "text": "那肯定有时间。",
      "token_start": 432,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 123180,
      "end_ms": 123505,
      "text": "行，",
      "token_start": 438,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 124470,
      "end_ms": 125490,
      "text": "那项目的事儿，",
      "token_start": 439,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 125510,
      "end_ms": 126495,
      "text": "咱们明天再聊。",
      "token_start": 445,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 128750,
      "end_ms": 129165,
      "text": "王姐，",
      "token_start": 451,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 130900,
      "end_ms": 132540,
      "text": "刚才项目不是都已经谈好了吗？",
      "token_start": 453,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 132580,
      "end_ms": 133595,
      "text": "合同都准备签了，",
      "token_start": 466,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 133990,
      "end_ms": 138030,
      "text": "李总怎么突然又说要考虑你自己想想刚才说什么了，",
      "token_start": 473,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 138170,
      "end_ms": 139325,
      "text": "我也没说什么啊。",
      "token_start": 495,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 139680,
      "end_ms": 140460,
      "text": "李总夸我，",
      "token_start": 502,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 140580,
      "end_ms": 141715,
      "text": "我就是谦虚了一下，",
      "token_start": 506,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 142040,
      "end_ms": 143220,
      "text": "总不能人家夸我两句，",
      "token_start": 514,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 143220,
      "end_ms": 144035,
      "text": "我还真认了吧。",
      "token_start": 523,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 144480,
      "end_ms": 146935,
      "text": "李总夸你是认可你的能力，",
      "token_start": 529,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 147450,
      "end_ms": 148395,
      "text": "结果你倒好，",
      "token_start": 540,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 148780,
      "end_ms": 150000,
      "text": "自己先告诉人家，",
      "token_start": 545,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 150120,
      "end_ms": 153145,
      "text": "你就是个打辅助的这句话有什么问题。",
      "token_start": 552,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 153650,
      "end_ms": 156730,
      "text": "一千万的项目你自己都不敢认自己的能力，",
      "token_start": 568,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 156730,
      "end_ms": 157845,
      "text": "你让客户怎么放心？",
      "token_start": 586,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 158400,
      "end_ms": 159715,
      "text": "就因为这一句话，",
      "token_start": 594,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 160090,
      "end_ms": 163055,
      "text": "很多时候人家看的不只是你会不会做事，",
      "token_start": 601,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 163570,
      "end_ms": 165235,
      "text": "也看你会不会跟人打交道。",
      "token_start": 618,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 166480,
      "end_ms": 168100,
      "text": "那这个项目是不是没戏了？",
      "token_start": 629,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 168160,
      "end_ms": 168855,
      "text": "还有机会，",
      "token_start": 640,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 169240,
      "end_ms": 171495,
      "text": "这个项目光提成都不止一百万。",
      "token_start": 644,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 171910,
      "end_ms": 173450,
      "text": "李总既然没有直接拒绝，",
      "token_start": 657,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 173610,
      "end_ms": 175110,
      "text": "还主动约了明天的饭局，",
      "token_start": 667,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 175270,
      "end_ms": 176705,
      "text": "就说明事情还有转机，",
      "token_start": 677,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 177360,
      "end_ms": 179000,
      "text": "能不能把这个项目拿下来，",
      "token_start": 686,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 179300,
      "end_ms": 185230,
      "text": "就看你们两个明天的表现了哟。",
      "token_start": 697,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 185410,
      "end_ms": 186250,
      "text": "王姐来了，",
      "token_start": 710,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 186350,
      "end_ms": 187195,
      "text": "快坐快坐，",
      "token_start": 714,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 187690,
      "end_ms": 188455,
      "text": "不好意思，",
      "token_start": 718,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 188960,
      "end_ms": 190180,
      "text": "让两位久等了。",
      "token_start": 722,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 190420,
      "end_ms": 192305,
      "text": "哪里哪里都是自己人。",
      "token_start": 728,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 198040,
      "end_ms": 198685,
      "text": "小张啊，",
      "token_start": 737,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 199130,
      "end_ms": 199770,
      "text": "今天高兴，",
      "token_start": 740,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 199990,
      "end_ms": 202345,
      "text": "刚好李总和陈总都在你来讲两句。",
      "token_start": 744,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 203170,
      "end_ms": 203410,
      "text": "嗯，",
      "token_start": 758,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 203410,
      "end_ms": 205070,
      "text": "那祝大家吃好喝。",
      "token_start": 759,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 205070,
      "end_ms": 205310,
      "text": "好，",
      "token_start": 766,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 205530,
      "end_ms": 215435,
      "text": "我先干了王姐，",
      "token_start": 767,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 215920,
      "end_ms": 217405,
      "text": "那我也借这个机会说两句。",
      "token_start": 773,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 217770,
      "end_ms": 218010,
      "text": "好，",
      "token_start": 784,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 218330,
      "end_ms": 220695,
      "text": "你说非常感谢李总今天组的局，",
      "token_start": 785,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 221000,
      "end_ms": 222340,
      "text": "也感谢王姐带我们过来，",
      "token_start": 798,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 222340,
      "end_ms": 223880,
      "text": "让我们有幸认识各位前辈，",
      "token_start": 808,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 224040,
      "end_ms": 224720,
      "text": "我叫玲玲。",
      "token_start": 819,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 224780,
      "end_ms": 225300,
      "text": "俗话说，",
      "token_start": 823,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 225400,
      "end_ms": 226735,
      "text": "相聚是一种缘分。",
      "token_start": 826,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 227050,
      "end_ms": 227690,
      "text": "此时此刻，",
      "token_start": 833,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 227690,
      "end_ms": 229875,
      "text": "我把对各位的祝福化作一杯美酒，",
      "token_start": 837,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 230320,
      "end_ms": 231700,
      "text": "祝各位扶摇直上。",
      "token_start": 851,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 231720,
      "end_ms": 232220,
      "text": "九万里，",
      "token_start": 858,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 232380,
      "end_ms": 233820,
      "text": "事业长虹节节高。",
      "token_start": 861,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 234900,
      "end_ms": 235375,
      "text": "好，",
      "token_start": 868,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 235820,
      "end_ms": 236955,
      "text": "这姑娘会说话，",
      "token_start": 869,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 241760,
      "end_ms": 242290,
      "text": "对不对？",
      "token_start": 875,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 245680,
      "end_ms": 246100,
      "text": "王姐，",
      "token_start": 878,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 246820,
      "end_ms": 247560,
      "text": "来这杯，",
      "token_start": 880,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 247560,
      "end_ms": 248105,
      "text": "我敬你。",
      "token_start": 883,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 250800,
      "end_ms": 251240,
      "text": "陈总，",
      "token_start": 886,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 251620,
      "end_ms": 252960,
      "text": "这杯我替王姐敬您，",
      "token_start": 888,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 253480,
      "end_ms": 254880,
      "text": "我敬的是你们领导，",
      "token_start": 896,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 255400,
      "end_ms": 256380,
      "text": "你是领导吗？",
      "token_start": 904,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 256780,
      "end_ms": 257700,
      "text": "瞧您说的，",
      "token_start": 909,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 258000,
      "end_ms": 259120,
      "text": "您敬的是我领导，",
      "token_start": 913,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 259300,
      "end_ms": 260980,
      "text": "我同样敬的也是领导，",
      "token_start": 920,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 261140,
      "end_ms": 262240,
      "text": "您敬领导是心意，",
      "token_start": 929,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 262380,
      "end_ms": 264020,
      "text": "我敬您是尊敬这杯，",
      "token_start": 936,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 264280,
      "end_ms": 265260,
      "text": "我敬的是生意，",
      "token_start": 944,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 265260,
      "end_ms": 265880,
      "text": "咱们随意，",
      "token_start": 950,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 266120,
      "end_ms": 267500,
      "text": "祝您生意一路长虹，",
      "token_start": 954,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 267540,
      "end_ms": 268220,
      "text": "万事顺利，",
      "token_start": 962,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 270300,
      "end_ms": 271680,
      "text": "这小姑娘会说话。",
      "token_start": 966,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 271720,
      "end_ms": 273300,
      "text": "琳琳刚才说的不错，",
      "token_start": 973,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 273340,
      "end_ms": 274280,
      "text": "来咱俩喝一个，",
      "token_start": 981,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 274340,
      "end_ms": 275125,
      "text": "谢谢陈总，",
      "token_start": 987,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 278620,
      "end_ms": 280300,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 991,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 280320,
      "end_ms": 281620,
      "text": "陈总瓶底酒，",
      "token_start": 1002,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 281620,
      "end_ms": 282560,
      "text": "这叫发财酒，",
      "token_start": 1007,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 282700,
      "end_ms": 283760,
      "text": "到底发财好事，",
      "token_start": 1012,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 283760,
      "end_ms": 286680,
      "text": "再来好一个发财酒。",
      "token_start": 1018,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 287020,
      "end_ms": 287400,
      "text": "琳琳，",
      "token_start": 1026,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 288020,
      "end_ms": 289440,
      "text": "你这姑娘反应挺快，",
      "token_start": 1028,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 290160,
      "end_ms": 293705,
      "text": "王姐手底下有你这样的员工省心啊。",
      "token_start": 1036,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 295190,
      "end_ms": 295530,
      "text": "李总，",
      "token_start": 1051,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 295530,
      "end_ms": 296230,
      "text": "您过奖了，",
      "token_start": 1053,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 296510,
      "end_ms": 299750,
      "text": "主要是王姐平时带的好强将手下吴若兵，",
      "token_start": 1057,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 299990,
      "end_ms": 301770,
      "text": "我总不能给我们王姐丢脸呀。",
      "token_start": 1074,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 302930,
      "end_ms": 303390,
      "text": "王姐，",
      "token_start": 1086,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 303790,
      "end_ms": 305470,
      "text": "你手底下这个姑娘不错，",
      "token_start": 1088,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 305810,
      "end_ms": 307810,
      "text": "年轻人还得多跟您学习。",
      "token_start": 1098,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 307930,
      "end_ms": 313440,
      "text": "啊啊啊王姐。",
      "token_start": 1108,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 313740,
      "end_ms": 314200,
      "text": "李总，",
      "token_start": 1113,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 314300,
      "end_ms": 317120,
      "text": "您说昨天那个一千万的项目，",
      "token_start": 1115,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 318120,
      "end_ms": 319040,
      "text": "我考虑好了，",
      "token_start": 1127,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 319280,
      "end_ms": 320540,
      "text": "项目可以继续合作。",
      "token_start": 1132,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 320900,
      "end_ms": 321960,
      "text": "不过我有个条件，",
      "token_start": 1140,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 322800,
      "end_ms": 323220,
      "text": "李总，",
      "token_start": 1147,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 323340,
      "end_ms": 326645,
      "text": "您说这个项目后面我希望让琳琳来负责。",
      "token_start": 1149,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 329290,
      "end_ms": 329750,
      "text": "李总，",
      "token_start": 1166,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 329850,
      "end_ms": 332910,
      "text": "我对小张的业务能力没问题，",
      "token_start": 1168,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 333550,
      "end_ms": 335190,
      "text": "这一点昨天我就看出来了，",
      "token_start": 1180,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 335510,
      "end_ms": 338770,
      "text": "不过这么大的项目后面少不了跟各种人打交道。",
      "token_start": 1191,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 338790,
      "end_ms": 342590,
      "text": "今天晚上我也一直在观察你们两个这个项目交给琳琳，",
      "token_start": 1211,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 342590,
      "end_ms": 343250,
      "text": "我更放心，",
      "token_start": 1234,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 344290,
      "end_ms": 345230,
      "text": "谢谢李总信任，",
      "token_start": 1238,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 345310,
      "end_ms": 346710,
      "text": "也谢谢王姐给我这个机会。",
      "token_start": 1244,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 346970,
      "end_ms": 348690,
      "text": "后面有什么做的不到位的地方，",
      "token_start": 1255,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 348690,
      "end_ms": 349650,
      "text": "还得请两位多指点。",
      "token_start": 1268,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 349910,
      "end_ms": 350150,
      "text": "好，",
      "token_start": 1276,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 350630,
      "end_ms": 351595,
      "text": "那就这么定了。",
      "token_start": 1277,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 355230,
      "end_ms": 358210,
      "text": "琳琳李总那边合同已经确定了，",
      "token_start": 1283,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 358250,
      "end_ms": 359590,
      "text": "后面这个项目你来负责，",
      "token_start": 1296,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 360210,
      "end_ms": 360950,
      "text": "谢谢王姐，",
      "token_start": 1306,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 361110,
      "end_ms": 362010,
      "text": "我一定把它做好，",
      "token_start": 1310,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 362190,
      "end_ms": 363505,
      "text": "有不懂的地方随时问我，",
      "token_start": 1317,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 367650,
      "end_ms": 369910,
      "text": "王姐怎么了？",
      "token_start": 1327,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 370030,
      "end_ms": 371250,
      "text": "我还是有点想不明白，",
      "token_start": 1332,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 371490,
      "end_ms": 373230,
      "text": "这个项目明明是我谈下来的，",
      "token_start": 1341,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 373310,
      "end_ms": 375070,
      "text": "李总问的业务问题也是我回答的，",
      "token_start": 1353,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 375070,
      "end_ms": 376450,
      "text": "为什么最后还是玲玲负责？",
      "token_start": 1367,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 377110,
      "end_ms": 379030,
      "text": "还记得你前几天问我什么吗？",
      "token_start": 1378,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 380270,
      "end_ms": 382850,
      "text": "你问我为什么玲玲能当经理？",
      "token_start": 1390,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 382930,
      "end_ms": 386330,
      "text": "你不能现在你还觉得只要每天来得早，",
      "token_start": 1402,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 386430,
      "end_ms": 386990,
      "text": "走的晚，",
      "token_start": 1418,
      "token_end_exclusive": 1421
    },
    {
      "start_ms": 387070,
      "end_ms": 389190,
      "text": "业务做的好就一定适合当经理吗？",
      "token_start": 1421,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 389850,
      "end_ms": 391770,
      "text": "业务上你不比玲玲差，",
      "token_start": 1435,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 392090,
      "end_ms": 393450,
      "text": "甚至谈项目的时候，",
      "token_start": 1444,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 393530,
      "end_ms": 394590,
      "text": "你表现的很好。",
      "token_start": 1452,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 394810,
      "end_ms": 397860,
      "text": "但经理这个位置不只是自己把事情做好，",
      "token_start": 1458,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 398020,
      "end_ms": 400480,
      "text": "还要面对客户、合作方照顾团队，",
      "token_start": 1475,
      "token_end_exclusive": 1488
    },
    {
      "start_ms": 400600,
      "end_ms": 401920,
      "text": "处理各种突发情况。",
      "token_start": 1488,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 402180,
      "end_ms": 403940,
      "text": "昨天晚上陈总突然问玲玲，",
      "token_start": 1496,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 404200,
      "end_ms": 405080,
      "text": "你是领导吗？",
      "token_start": 1507,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 405200,
      "end_ms": 406100,
      "text": "如果换成你，",
      "token_start": 1512,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 406280,
      "end_ms": 407300,
      "text": "你知道怎么接吗？",
      "token_start": 1517,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 407600,
      "end_ms": 408680,
      "text": "半杯酒的事儿，",
      "token_start": 1524,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 408680,
      "end_ms": 409620,
      "text": "如果换成你呢，",
      "token_start": 1530,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 409980,
      "end_ms": 411180,
      "text": "可能先道歉。",
      "token_start": 1536,
      "token_end_exclusive": 1541
    },
    {
      "start_ms": 411780,
      "end_ms": 415020,
      "text": "所以我让玲玲当经理不是因为他比你更会说漂亮话，",
      "token_start": 1541,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 415260,
      "end_ms": 418000,
      "text": "是因为很多时候他知道什么时候该说什么，",
      "token_start": 1563,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 418120,
      "end_ms": 419915,
      "text": "遇到事情也知道该怎么处理。",
      "token_start": 1581,
      "token_end_exclusive": 1593
    },
    {
      "start_ms": 420670,
      "end_ms": 423380,
      "text": "现在你自己告诉我为什么这个位置，",
      "token_start": 1593,
      "token_end_exclusive": 1608
    },
    {
      "start_ms": 423380,
      "end_ms": 424475,
      "text": "我让玲玲来坐，",
      "token_start": 1608,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 426330,
      "end_ms": 427275,
      "text": "我好像明白了，",
      "token_start": 1614,
      "token_end_exclusive": 1620
    },
    {
      "start_ms": 428860,
      "end_ms": 429795,
      "text": "不服没关系，",
      "token_start": 1620,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 430360,
      "end_ms": 431285,
      "text": "看明白差距，",
      "token_start": 1625,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 431610,
      "end_ms": 433435,
      "text": "才能知道自己下一步该往哪儿走。",
      "token_start": 1630,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 438530,
      "end_ms": 438915,
      "text": "琳琳，",
      "token_start": 1644,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 439220,
      "end_ms": 439535,
      "text": "嗯，",
      "token_start": 1646,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 440290,
      "end_ms": 441170,
      "text": "刚开始你当经理，",
      "token_start": 1647,
      "token_end_exclusive": 1654
    },
    {
      "start_ms": 441170,
      "end_ms": 441955,
      "text": "我确实不服，",
      "token_start": 1654,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 442390,
      "end_ms": 443810,
      "text": "我一直觉得我比你来的早，",
      "token_start": 1659,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 443810,
      "end_ms": 444330,
      "text": "走的晚，",
      "token_start": 1670,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 444450,
      "end_ms": 445535,
      "text": "业务也不比你差。",
      "token_start": 1673,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 446030,
      "end_ms": 447425,
      "text": "但这两天我仔细想了想，",
      "token_start": 1680,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 448500,
      "end_ms": 451630,
      "text": "我现在服了这么快就服了。",
      "token_start": 1690,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 451830,
      "end_ms": 453115,
      "text": "业务上的问题我会答，",
      "token_start": 1701,
      "token_end_exclusive": 1710
    },
    {
      "start_ms": 453440,
      "end_ms": 454540,
      "text": "但一碰到人情世故，",
      "token_start": 1710,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 454580,
      "end_ms": 455300,
      "text": "临场应变，",
      "token_start": 1718,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 455500,
      "end_ms": 456415,
      "text": "我确实不如你。",
      "token_start": 1722,
      "token_end_exclusive": 1728
    },
    {
      "start_ms": 457350,
      "end_ms": 458405,
      "text": "不过我还有个问题，",
      "token_start": 1728,
      "token_end_exclusive": 1736
    },
    {
      "start_ms": 458820,
      "end_ms": 460490,
      "text": "你说李总夸我的时候，",
      "token_start": 1736,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 460490,
      "end_ms": 461555,
      "text": "我把功劳给了王姐。",
      "token_start": 1745,
      "token_end_exclusive": 1753
    },
    {
      "start_ms": 461870,
      "end_ms": 462750,
      "text": "李总夸你的时候，",
      "token_start": 1753,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 462750,
      "end_ms": 464005,
      "text": "你也把功劳给了王姐，",
      "token_start": 1760,
      "token_end_exclusive": 1769
    },
    {
      "start_ms": 464270,
      "end_ms": 464630,
      "text": "为什么？",
      "token_start": 1769,
      "token_end_exclusive": 1772
    },
    {
      "start_ms": 464630,
      "end_ms": 465565,
      "text": "结果完全不一样？",
      "token_start": 1772,
      "token_end_exclusive": 1779
    },
    {
      "start_ms": 466030,
      "end_ms": 469020,
      "text": "七、因为谦虚不等于否定自己啊，",
      "token_start": 1779,
      "token_end_exclusive": 1792
    },
    {
      "start_ms": 469080,
      "end_ms": 470080,
      "text": "你可以抬高别人，",
      "token_start": 1792,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 470080,
      "end_ms": 471380,
      "text": "但没必要把自己压下去。",
      "token_start": 1799,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 471480,
      "end_ms": 472095,
      "text": "什么意思？",
      "token_start": 1809,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 472440,
      "end_ms": 473280,
      "text": "比如李总夸你，",
      "token_start": 1813,
      "token_end_exclusive": 1819
    },
    {
      "start_ms": 473280,
      "end_ms": 474125,
      "text": "后生可畏，",
      "token_start": 1819,
      "token_end_exclusive": 1823
    },
    {
      "start_ms": 474580,
      "end_ms": 477335,
      "text": "你可以说李总您过奖了，",
      "token_start": 1823,
      "token_end_exclusive": 1833
    },
    {
      "start_ms": 477620,
      "end_ms": 479000,
      "text": "要不是您愿意给机会，",
      "token_start": 1833,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 479080,
      "end_ms": 481295,
      "text": "我哪能跟您这么有魄力的人合作啊，",
      "token_start": 1842,
      "token_end_exclusive": 1857
    },
    {
      "start_ms": 481530,
      "end_ms": 482825,
      "text": "以后还得跟您多学呢。",
      "token_start": 1857,
      "token_end_exclusive": 1866
    },
    {
      "start_ms": 483110,
      "end_ms": 484345,
      "text": "这样既抬高了李总，",
      "token_start": 1866,
      "token_end_exclusive": 1874
    },
    {
      "start_ms": 484740,
      "end_ms": 486215,
      "text": "也没有否定自己的能力，",
      "token_start": 1874,
      "token_end_exclusive": 1884
    },
    {
      "start_ms": 487480,
      "end_ms": 488695,
      "text": "可昨天那些情况呢？",
      "token_start": 1884,
      "token_end_exclusive": 1892
    },
    {
      "start_ms": 489100,
      "end_ms": 490100,
      "text": "陈总突然问你，",
      "token_start": 1892,
      "token_end_exclusive": 1898
    },
    {
      "start_ms": 490160,
      "end_ms": 491165,
      "text": "你是领导吗？",
      "token_start": 1898,
      "token_end_exclusive": 1903
    },
    {
      "start_ms": 491640,
      "end_ms": 493355,
      "text": "还有酒突然只剩半杯，",
      "token_start": 1903,
      "token_end_exclusive": 1912
    },
    {
      "start_ms": 494180,
      "end_ms": 495765,
      "text": "这些总没人提前告诉你吧？",
      "token_start": 1912,
      "token_end_exclusive": 1923
    },
    {
      "start_ms": 496150,
      "end_ms": 496925,
      "text": "当然没有。",
      "token_start": 1923,
      "token_end_exclusive": 1927
    },
    {
      "start_ms": 497260,
      "end_ms": 498905,
      "text": "那你为什么每次马上就知道怎么接，",
      "token_start": 1927,
      "token_end_exclusive": 1942
    },
    {
      "start_ms": 500100,
      "end_ms": 500840,
      "text": "你别告诉我，",
      "token_start": 1942,
      "token_end_exclusive": 1947
    },
    {
      "start_ms": 500840,
      "end_ms": 503265,
      "text": "全是你临床现想的当然不是。",
      "token_start": 1947,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 503740,
      "end_ms": 504835,
      "text": "那你到底怎么练的？",
      "token_start": 1959,
      "token_end_exclusive": 1967
    },
    {
      "start_ms": 505200,
      "end_ms": 506575,
      "text": "其实我以前跟你一样，",
      "token_start": 1967,
      "token_end_exclusive": 1976
    },
    {
      "start_ms": 506930,
      "end_ms": 507570,
      "text": "不爱说话，",
      "token_start": 1976,
      "token_end_exclusive": 1980
    },
    {
      "start_ms": 507730,
      "end_ms": 508570,
      "text": "也不爱争辩。",
      "token_start": 1980,
      "token_end_exclusive": 1985
    },
    {
      "start_ms": 508830,
      "end_ms": 509810,
      "text": "一到这种场合，",
      "token_start": 1985,
      "token_end_exclusive": 1991
    },
    {
      "start_ms": 509930,
      "end_ms": 511165,
      "text": "别人突然问我一句，",
      "token_start": 1991,
      "token_end_exclusive": 1999
    },
    {
      "start_ms": 511490,
      "end_ms": 512710,
      "text": "我脑子里明明有话，",
      "token_start": 1999,
      "token_end_exclusive": 2007
    },
    {
      "start_ms": 512870,
      "end_ms": 513850,
      "text": "就是不知道怎么说，",
      "token_start": 2007,
      "token_end_exclusive": 2015
    },
    {
      "start_ms": 514110,
      "end_ms": 515065,
      "text": "你以前也这样。",
      "token_start": 2015,
      "token_end_exclusive": 2021
    },
    {
      "start_ms": 515690,
      "end_ms": 520255,
      "text": "当然后来我就经常看这本把话说的恰到好处，",
      "token_start": 2021,
      "token_end_exclusive": 2040
    },
    {
      "start_ms": 520650,
      "end_ms": 523565,
      "text": "它里面很多都是我们平时真的会碰到的场景，",
      "token_start": 2040,
      "token_end_exclusive": 2059
    },
    {
      "start_ms": 523910,
      "end_ms": 525630,
      "text": "别人怎么说你可以怎么接，",
      "token_start": 2059,
      "token_end_exclusive": 2070
    },
    {
      "start_ms": 525750,
      "end_ms": 527270,
      "text": "都是一句一句给你举例，",
      "token_start": 2070,
      "token_end_exclusive": 2080
    },
    {
      "start_ms": 527410,
      "end_ms": 528290,
      "text": "我就一个场景，",
      "token_start": 2080,
      "token_end_exclusive": 2086
    },
    {
      "start_ms": 528290,
      "end_ms": 529930,
      "text": "一个场景的看一个场景，",
      "token_start": 2086,
      "token_end_exclusive": 2096
    },
    {
      "start_ms": 529930,
      "end_ms": 530645,
      "text": "一个场景的练。",
      "token_start": 2096,
      "token_end_exclusive": 2102
    },
    {
      "start_ms": 531690,
      "end_ms": 532810,
      "text": "所以你昨天那些话，",
      "token_start": 2102,
      "token_end_exclusive": 2110
    },
    {
      "start_ms": 533170,
      "end_ms": 535374,
      "text": "很多都是平时慢慢积累出来的。",
      "token_start": 2110,
      "token_end_exclusive": 2123
    },
    {
      "start_ms": 535620,
      "end_ms": 536820,
      "text": "比如别人夸你优秀，",
      "token_start": 2123,
      "token_end_exclusive": 2131
    },
    {
      "start_ms": 536880,
      "end_ms": 537545,
      "text": "你可以回，",
      "token_start": 2131,
      "token_end_exclusive": 2135
    },
    {
      "start_ms": 537880,
      "end_ms": 538845,
      "text": "那是不优秀点儿，",
      "token_start": 2135,
      "token_end_exclusive": 2142
    },
    {
      "start_ms": 539020,
      "end_ms": 540135,
      "text": "怎么能和你做朋友呢？",
      "token_start": 2142,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 540390,
      "end_ms": 541510,
      "text": "别人说你真聪明，",
      "token_start": 2151,
      "token_end_exclusive": 2158
    },
    {
      "start_ms": 541590,
      "end_ms": 543290,
      "text": "你可以回近朱者赤，",
      "token_start": 2158,
      "token_end_exclusive": 2166
    },
    {
      "start_ms": 543430,
      "end_ms": 544350,
      "text": "和你在一起啊，",
      "token_start": 2166,
      "token_end_exclusive": 2172
    },
    {
      "start_ms": 544370,
      "end_ms": 545430,
      "text": "熏都熏出来了。",
      "token_start": 2172,
      "token_end_exclusive": 2178
    },
    {
      "start_ms": 545470,
      "end_ms": 546690,
      "text": "领导跟你说辛苦了，",
      "token_start": 2178,
      "token_end_exclusive": 2186
    },
    {
      "start_ms": 546690,
      "end_ms": 548000,
      "text": "也可以回领导，",
      "token_start": 2186,
      "token_end_exclusive": 2192
    },
    {
      "start_ms": 548000,
      "end_ms": 549205,
      "text": "这都是我应该做的。",
      "token_start": 2192,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 549430,
      "end_ms": 550590,
      "text": "强将手下吴若兵，",
      "token_start": 2200,
      "token_end_exclusive": 2207
    },
    {
      "start_ms": 550590,
      "end_ms": 551925,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 2207,
      "token_end_exclusive": 2216
    },
    {
      "start_ms": 552250,
      "end_ms": 553910,
      "text": "难怪你每次都能接的这么快，",
      "token_start": 2216,
      "token_end_exclusive": 2228
    },
    {
      "start_ms": 554110,
      "end_ms": 555685,
      "text": "这种东西真不是天生的，",
      "token_start": 2228,
      "token_end_exclusive": 2238
    },
    {
      "start_ms": 555940,
      "end_ms": 557605,
      "text": "每天不用看很多看两页，",
      "token_start": 2238,
      "token_end_exclusive": 2248
    },
    {
      "start_ms": 557870,
      "end_ms": 558450,
      "text": "慢慢积累，",
      "token_start": 2248,
      "token_end_exclusive": 2252
    },
    {
      "start_ms": 558450,
      "end_ms": 560425,
      "text": "不同场景下该怎么说怎么接。",
      "token_start": 2252,
      "token_end_exclusive": 2264
    },
    {
      "start_ms": 560690,
      "end_ms": 562525,
      "text": "这里面还有很多生活里的场景，",
      "token_start": 2264,
      "token_end_exclusive": 2277
    },
    {
      "start_ms": 562800,
      "end_ms": 564040,
      "text": "比如对象给你发红包，",
      "token_start": 2277,
      "token_end_exclusive": 2286
    },
    {
      "start_ms": 564040,
      "end_ms": 566820,
      "text": "你可以回你是我致富道路上最大的功臣。",
      "token_start": 2286,
      "token_end_exclusive": 2303
    },
    {
      "start_ms": 567080,
      "end_ms": 568120,
      "text": "同事向你借钱，",
      "token_start": 2303,
      "token_end_exclusive": 2309
    },
    {
      "start_ms": 568180,
      "end_ms": 568900,
      "text": "你又不想借，",
      "token_start": 2309,
      "token_end_exclusive": 2314
    },
    {
      "start_ms": 568980,
      "end_ms": 569525,
      "text": "可以回，",
      "token_start": 2314,
      "token_end_exclusive": 2317
    },
    {
      "start_ms": 569840,
      "end_ms": 571180,
      "text": "大家都是一样的年纪，",
      "token_start": 2317,
      "token_end_exclusive": 2326
    },
    {
      "start_ms": 571220,
      "end_ms": 571700,
      "text": "你没有的，",
      "token_start": 2326,
      "token_end_exclusive": 2330
    },
    {
      "start_ms": 571700,
      "end_ms": 572545,
      "text": "我能有吗？",
      "token_start": 2330,
      "token_end_exclusive": 2334
    },
    {
      "start_ms": 573640,
      "end_ms": 575875,
      "text": "还有心仪的人跟你说我想你了，",
      "token_start": 2334,
      "token_end_exclusive": 2347
    },
    {
      "start_ms": 576080,
      "end_ms": 577730,
      "text": "你可以回随便想，",
      "token_start": 2347,
      "token_end_exclusive": 2354
    },
    {
      "start_ms": 577890,
      "end_ms": 579010,
      "text": "千万别跟我客气，",
      "token_start": 2354,
      "token_end_exclusive": 2361
    },
    {
      "start_ms": 579090,
      "end_ms": 579975,
      "text": "目前不收费。",
      "token_start": 2361,
      "token_end_exclusive": 2366
    },
    {
      "start_ms": 580640,
      "end_ms": 582465,
      "text": "呵呵这个有意思。",
      "token_start": 2366,
      "token_end_exclusive": 2373
    },
    {
      "start_ms": 582850,
      "end_ms": 584290,
      "text": "我第一次看到这些的时候，",
      "token_start": 2373,
      "token_end_exclusive": 2384
    },
    {
      "start_ms": 584290,
      "end_ms": 585895,
      "text": "也有种豁然开朗的感觉。",
      "token_start": 2384,
      "token_end_exclusive": 2394
    },
    {
      "start_ms": 586290,
      "end_ms": 589275,
      "text": "工作、生活、人际交往里经常碰到的场景，",
      "token_start": 2394,
      "token_end_exclusive": 2410
    },
    {
      "start_ms": 589890,
      "end_ms": 592645,
      "text": "他都会一个一个拆开给你看看的多了，",
      "token_start": 2410,
      "token_end_exclusive": 2426
    },
    {
      "start_ms": 592930,
      "end_ms": 594075,
      "text": "再碰到类似的事情，",
      "token_start": 2426,
      "token_end_exclusive": 2434
    },
    {
      "start_ms": 594400,
      "end_ms": 596640,
      "text": "至少不会一下子不知道该说什么。",
      "token_start": 2434,
      "token_end_exclusive": 2448
    },
    {
      "start_ms": 596680,
      "end_ms": 597675,
      "text": "这本先借我看看，",
      "token_start": 2448,
      "token_end_exclusive": 2455
    },
    {
      "start_ms": 598080,
      "end_ms": 598640,
      "text": "拿去吧，",
      "token_start": 2455,
      "token_end_exclusive": 2458
    },
    {
      "start_ms": 598660,
      "end_ms": 599465,
      "text": "回去慢慢看。",
      "token_start": 2458,
      "token_end_exclusive": 2463
    }
