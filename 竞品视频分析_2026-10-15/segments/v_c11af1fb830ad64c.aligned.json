{
  "video_id": "v_c11af1fb830ad64c",
  "duration_s": 185.712993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c11af1fb830ad64c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c11af1fb830ad64c.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 350,
      "end_ms": 750,
      "text": "周军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1090,
      "end_ms": 1870,
      "text": "你相信吗？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2130,
      "end_ms": 4450,
      "text": "一个人的财富来得越晚越好。",
      "token_start": 6,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4950,
      "end_ms": 5950,
      "text": "少年得志，",
      "token_start": 18,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5970,
      "end_ms": 6610,
      "text": "一、帆船，",
      "token_start": 22,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6950,
      "end_ms": 7930,
      "text": "大器晚成，",
      "token_start": 25,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 8050,
      "end_ms": 8710,
      "text": "真大财。",
      "token_start": 29,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 9250,
      "end_ms": 11150,
      "text": "人不必在同一个年纪成熟，",
      "token_start": 32,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 11450,
      "end_ms": 12950,
      "text": "每个人都有自己的秋天，",
      "token_start": 43,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13650,
      "end_ms": 16530,
      "text": "我们将在八月七号迎来秋天的第一个节气。",
      "token_start": 53,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 16810,
      "end_ms": 19590,
      "text": "立秋都说指缝太宽，",
      "token_start": 71,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 19890,
      "end_ms": 20910,
      "text": "时光太瘦，",
      "token_start": 79,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 21530,
      "end_ms": 22590,
      "text": "未觉三夏，",
      "token_start": 83,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 22590,
      "end_ms": 24490,
      "text": "尽时去以新秋。",
      "token_start": 87,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 24750,
      "end_ms": 26770,
      "text": "但是立秋可不是立刻变凉，",
      "token_start": 93,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 27050,
      "end_ms": 29915,
      "text": "中国各个地方真正进入气象意义上的秋天，",
      "token_start": 104,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 30200,
      "end_ms": 31340,
      "text": "时间并不相同，",
      "token_start": 122,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 31760,
      "end_ms": 34760,
      "text": "古人甚至在夏天会使用麦秋这个词儿。",
      "token_start": 128,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 34920,
      "end_ms": 36560,
      "text": "因为麦子在初夏成熟，",
      "token_start": 144,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 37020,
      "end_ms": 37740,
      "text": "死于实，",
      "token_start": 153,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 37780,
      "end_ms": 39360,
      "text": "虽夏于麦则秋，",
      "token_start": 156,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 39840,
      "end_ms": 42840,
      "text": "所以秋这个字啊一直不只是代表某个日期，",
      "token_start": 162,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 43020,
      "end_ms": 45940,
      "text": "也代表每一种生命自己成熟的时刻。",
      "token_start": 180,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 46220,
      "end_ms": 48400,
      "text": "你看有人二十多岁结婚，",
      "token_start": 195,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 48600,
      "end_ms": 50560,
      "text": "有人四十岁才遇到爱情，",
      "token_start": 205,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 50940,
      "end_ms": 52220,
      "text": "有人年少成名，",
      "token_start": 215,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 52340,
      "end_ms": 53720,
      "text": "有人大器晚成，",
      "token_start": 221,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 54080,
      "end_ms": 55220,
      "text": "有人正在收获，",
      "token_start": 227,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 55480,
      "end_ms": 56900,
      "text": "有人才刚刚发芽，",
      "token_start": 233,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 57260,
      "end_ms": 59625,
      "text": "请允许自己慢慢换季。",
      "token_start": 240,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 60020,
      "end_ms": 60440,
      "text": "同一天，",
      "token_start": 249,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 60440,
      "end_ms": 63180,
      "text": "立秋不代表每个人都要同时入秋。",
      "token_start": 252,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 63440,
      "end_ms": 63984,
      "text": "朱军，",
      "token_start": 266,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 64300,
      "end_ms": 65555,
      "text": "我今年三十三岁，",
      "token_start": 268,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 65950,
      "end_ms": 67450,
      "text": "如果能回到十年前，",
      "token_start": 275,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 67510,
      "end_ms": 68295,
      "text": "二十三岁，",
      "token_start": 283,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 68700,
      "end_ms": 71225,
      "text": "我一定会对那个更年轻的自己说一句话，",
      "token_start": 287,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 71800,
      "end_ms": 74495,
      "text": "你不必在二十岁就找到一生的答案。",
      "token_start": 304,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 74970,
      "end_ms": 76790,
      "text": "真正能够稳住大财富的人，",
      "token_start": 319,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 76790,
      "end_ms": 78090,
      "text": "往往都是在中年。",
      "token_start": 330,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 78090,
      "end_ms": 80260,
      "text": "以后这个时候要心态，",
      "token_start": 337,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 80260,
      "end_ms": 80840,
      "text": "有心态，",
      "token_start": 346,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 81000,
      "end_ms": 81540,
      "text": "要经验，",
      "token_start": 349,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 81540,
      "end_ms": 82135,
      "text": "有经验，",
      "token_start": 352,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 82440,
      "end_ms": 83200,
      "text": "懂得进退，",
      "token_start": 355,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 83260,
      "end_ms": 83740,
      "text": "也懂得。",
      "token_start": 359,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 83740,
      "end_ms": 85210,
      "text": "守藏乾坤，",
      "token_start": 362,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 85290,
      "end_ms": 85670,
      "text": "未定，",
      "token_start": 366,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 85790,
      "end_ms": 86490,
      "text": "别着急，",
      "token_start": 368,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 86490,
      "end_ms": 87215,
      "text": "论成败，",
      "token_start": 371,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 87570,
      "end_ms": 88850,
      "text": "哪一天真正成熟，",
      "token_start": 374,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 89110,
      "end_ms": 90665,
      "text": "哪一天就是你的秋天。",
      "token_start": 381,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 91050,
      "end_ms": 91430,
      "text": "你看，",
      "token_start": 390,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 91710,
      "end_ms": 93030,
      "text": "立秋虽在同一天，",
      "token_start": 392,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 93090,
      "end_ms": 95025,
      "text": "而秋天却不是同时抵达。",
      "token_start": 399,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 95430,
      "end_ms": 95970,
      "text": "此时节。",
      "token_start": 409,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 95990,
      "end_ms": 97510,
      "text": "北方的清晨有露水，",
      "token_start": 412,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 97710,
      "end_ms": 99050,
      "text": "仿佛一夜入秋，",
      "token_start": 420,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 99330,
      "end_ms": 102595,
      "text": "而江南依旧蝉鸣和盛晚稻清青，",
      "token_start": 426,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 103000,
      "end_ms": 104560,
      "text": "岭南更是暑期未退，",
      "token_start": 439,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 104720,
      "end_ms": 106705,
      "text": "交夜还呈着午后的咒语，",
      "token_start": 447,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 107080,
      "end_ms": 108020,
      "text": "有人在添衣，",
      "token_start": 457,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 108160,
      "end_ms": 109360,
      "text": "有人仍在摇膳。",
      "token_start": 462,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 109700,
      "end_ms": 111285,
      "text": "我们共享同一个节气，",
      "token_start": 468,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 111530,
      "end_ms": 112695,
      "text": "却在不同的风里。",
      "token_start": 477,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 112890,
      "end_ms": 114805,
      "text": "第一次收到秋天的来信，",
      "token_start": 484,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 115170,
      "end_ms": 117765,
      "text": "究竟允许自己做个晚熟的人，",
      "token_start": 494,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 118080,
      "end_ms": 118720,
      "text": "不必焦虑，",
      "token_start": 506,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 118720,
      "end_ms": 120245,
      "text": "别人比你提前拥有。",
      "token_start": 510,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 120510,
      "end_ms": 123540,
      "text": "你有没有发现本性善良的人都比较晚熟，",
      "token_start": 518,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 123800,
      "end_ms": 127675,
      "text": "而且他们是被猎人催熟的当其他人聪明伶俐时，",
      "token_start": 535,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 127930,
      "end_ms": 129125,
      "text": "他们既傻又呆。",
      "token_start": 555,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 129440,
      "end_ms": 131340,
      "text": "当其他人在权衡利弊时，",
      "token_start": 561,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 131460,
      "end_ms": 132640,
      "text": "他们却一片赤诚。",
      "token_start": 571,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 132920,
      "end_ms": 135300,
      "text": "当其他人用尽一切心机手段时，",
      "token_start": 578,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 135380,
      "end_ms": 136795,
      "text": "他们才灵魂开窍。",
      "token_start": 591,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 137170,
      "end_ms": 138150,
      "text": "即便开窍之后，",
      "token_start": 598,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 138290,
      "end_ms": 140355,
      "text": "内心依然保持着善良与赤诚。",
      "token_start": 604,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 140800,
      "end_ms": 142120,
      "text": "他们试图寻找同类，",
      "token_start": 616,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 142340,
      "end_ms": 144740,
      "text": "到头来却发现自己是最孤独的。",
      "token_start": 624,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 144740,
      "end_ms": 145135,
      "text": "那个。",
      "token_start": 637,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 145590,
      "end_ms": 146975,
      "text": "你总说时间很慢，",
      "token_start": 639,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 147240,
      "end_ms": 147980,
      "text": "但走着走着，",
      "token_start": 646,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 147980,
      "end_ms": 148865,
      "text": "秋天就到了。",
      "token_start": 651,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 149270,
      "end_ms": 151185,
      "text": "人生总有太多的来不及。",
      "token_start": 656,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 151640,
      "end_ms": 152915,
      "text": "时间走的太快。",
      "token_start": 666,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 153280,
      "end_ms": 155115,
      "text": "一叶落天下秋，",
      "token_start": 672,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 155540,
      "end_ms": 160625,
      "text": "立秋这天记得恳丘咬丘啃一口秋瓜解一下暑气。",
      "token_start": 678,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 160920,
      "end_ms": 161320,
      "text": "而我看，",
      "token_start": 698,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 161320,
      "end_ms": 162755,
      "text": "秋标就没必要贴了。",
      "token_start": 701,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 163010,
      "end_ms": 165955,
      "text": "我多想把多余的脂肪捐给那些真正需要的人。",
      "token_start": 709,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 166340,
      "end_ms": 168275,
      "text": "如今花有花期，",
      "token_start": 728,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 168630,
      "end_ms": 169865,
      "text": "人有食运，",
      "token_start": 734,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 170220,
      "end_ms": 170915,
      "text": "要努力，",
      "token_start": 738,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 171210,
      "end_ms": 171985,
      "text": "但别着急，",
      "token_start": 741,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 172370,
      "end_ms": 173890,
      "text": "不要看见别人开花结果，",
      "token_start": 745,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 173890,
      "end_ms": 175075,
      "text": "就觉得自己枯萎。",
      "token_start": 755,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 175450,
      "end_ms": 176210,
      "text": "你没有落后，",
      "token_start": 762,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 176410,
      "end_ms": 177365,
      "text": "也没有领先。",
      "token_start": 767,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 177730,
      "end_ms": 179770,
      "text": "在命运为你安排的属于你的时，",
      "token_start": 772,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 179770,
      "end_ms": 183480,
      "text": "区里一切都是准时的鼠去又弈秋，",
      "token_start": 785,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 183840,
      "end_ms": 185305,
      "text": "愿君多珍重。",
      "token_start": 799,
      "token_end_exclusive": 804
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
