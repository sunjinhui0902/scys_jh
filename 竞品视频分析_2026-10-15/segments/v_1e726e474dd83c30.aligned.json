{
  "video_id": "v_1e726e474dd83c30",
  "duration_s": 230.586207,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1e726e474dd83c30.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1e726e474dd83c30.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 370,
      "end_ms": 770,
      "text": "朱军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1130,
      "end_ms": 1890,
      "text": "你相信吗？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2170,
      "end_ms": 4050,
      "text": "一个人最顶级的竞争力，",
      "token_start": 6,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4150,
      "end_ms": 5610,
      "text": "其实就是审美，",
      "token_start": 16,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 6150,
      "end_ms": 8410,
      "text": "一定要多跟审美好的人相处。",
      "token_start": 22,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 8770,
      "end_ms": 10030,
      "text": "因为他们做坏事，",
      "token_start": 34,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 10110,
      "end_ms": 11350,
      "text": "不符合他们的审美，",
      "token_start": 41,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 11990,
      "end_ms": 12850,
      "text": "伤些坏事。",
      "token_start": 49,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 12850,
      "end_ms": 13850,
      "text": "他们不是不敢做，",
      "token_start": 53,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 14010,
      "end_ms": 15650,
      "text": "而是觉得做出来太难看。",
      "token_start": 60,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 16129,
      "end_ms": 17210,
      "text": "真正有审美的人，",
      "token_start": 70,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 17210,
      "end_ms": 20850,
      "text": "他们无法忍受粗糙、愚蠢、刺眼的人和事，",
      "token_start": 77,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 21070,
      "end_ms": 23070,
      "text": "最直接的就是不会说脏话。",
      "token_start": 93,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 23550,
      "end_ms": 25610,
      "text": "审美是一个人最隐秘的道德，",
      "token_start": 104,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 25610,
      "end_ms": 26970,
      "text": "伤害他人，",
      "token_start": 116,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 26970,
      "end_ms": 28110,
      "text": "违背道义等等。",
      "token_start": 120,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 28110,
      "end_ms": 28830,
      "text": "在他们看来，",
      "token_start": 126,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 28830,
      "end_ms": 30780,
      "text": "就是丑陋不堪涵。",
      "token_start": 131,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 30780,
      "end_ms": 36820,
      "text": "你看到的每一个好的形象背后都是精力、财力、能力、审美内涵等等，",
      "token_start": 138,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 36940,
      "end_ms": 38260,
      "text": "全是稀缺资源。",
      "token_start": 165,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 38600,
      "end_ms": 40600,
      "text": "请一定要体面的收拾自己。",
      "token_start": 171,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 40800,
      "end_ms": 43320,
      "text": "我再也不相信一个邋里邋遢有理有气的人，",
      "token_start": 182,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 43320,
      "end_ms": 44400,
      "text": "口口声声跟我说，",
      "token_start": 200,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 44520,
      "end_ms": 45500,
      "text": "他是一个艺术家。",
      "token_start": 207,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 45800,
      "end_ms": 47540,
      "text": "你既然是一个创造美的人，",
      "token_start": 214,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 47540,
      "end_ms": 49220,
      "text": "你先把自己活成美本身，",
      "token_start": 225,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 49540,
      "end_ms": 50360,
      "text": "而你相信吗？",
      "token_start": 235,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 50480,
      "end_ms": 52500,
      "text": "审美其实就是最大的生产力。",
      "token_start": 240,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 52740,
      "end_ms": 54540,
      "text": "比如你看世界杯足球比赛，",
      "token_start": 252,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 54720,
      "end_ms": 56100,
      "text": "两个球队你都不认识。",
      "token_start": 263,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 56320,
      "end_ms": 59140,
      "text": "但是你情感上愿意那个长得帅气一点的，",
      "token_start": 272,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 59140,
      "end_ms": 60010,
      "text": "穿的好看一点，",
      "token_start": 289,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 60070,
      "end_ms": 60550,
      "text": "球队赢，",
      "token_start": 295,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 60830,
      "end_ms": 61935,
      "text": "你不愿意让他输。",
      "token_start": 298,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 62260,
      "end_ms": 63960,
      "text": "乔布斯说过一句很经典的话，",
      "token_start": 305,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 64040,
      "end_ms": 66340,
      "text": "他说最终决定人命运的东西，",
      "token_start": 317,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 66340,
      "end_ms": 67635,
      "text": "其实就是品味。",
      "token_start": 329,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 68140,
      "end_ms": 70655,
      "text": "审美升级的本质是价值观的升级。",
      "token_start": 335,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 70910,
      "end_ms": 72195,
      "text": "你开始欣赏克制，",
      "token_start": 349,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 72400,
      "end_ms": 72980,
      "text": "你理解的。",
      "token_start": 356,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 72980,
      "end_ms": 74140,
      "text": "什么叫长期主义？",
      "token_start": 360,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 74220,
      "end_ms": 75615,
      "text": "你开始喜欢留白，",
      "token_start": 367,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 75990,
      "end_ms": 78385,
      "text": "而人与人最后拼的就是审美。",
      "token_start": 374,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 78850,
      "end_ms": 79650,
      "text": "你能想象吗？",
      "token_start": 386,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 79650,
      "end_ms": 82135,
      "text": "那些审美和你不在同一个频道的人，",
      "token_start": 391,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 82340,
      "end_ms": 84055,
      "text": "你永远无法真正喜欢他。",
      "token_start": 406,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 84420,
      "end_ms": 85740,
      "text": "有些人对你明明很好，",
      "token_start": 416,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 85940,
      "end_ms": 87460,
      "text": "也没有犯什么大错误，",
      "token_start": 425,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 87500,
      "end_ms": 89745,
      "text": "但是你就是越来越想远离他。",
      "token_start": 434,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 90060,
      "end_ms": 92120,
      "text": "因为当他进入到你的生活之后，",
      "token_start": 446,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 92240,
      "end_ms": 94925,
      "text": "你开始觉得自己的生活变粗糙了。",
      "token_start": 459,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 95190,
      "end_ms": 97805,
      "text": "这就是关系里最难说出口的审美失配。",
      "token_start": 473,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 98210,
      "end_ms": 99610,
      "text": "甚至你看他选的衣服，",
      "token_start": 489,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 99610,
      "end_ms": 100930,
      "text": "挑的餐厅做的事情，",
      "token_start": 498,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 101050,
      "end_ms": 102915,
      "text": "你心里会有一种说不出的恶心。",
      "token_start": 506,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 103360,
      "end_ms": 105355,
      "text": "审美不同的人很难成为伴侣，",
      "token_start": 519,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 105620,
      "end_ms": 106660,
      "text": "不是三观不合，",
      "token_start": 531,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 106740,
      "end_ms": 108085,
      "text": "而是审美不合。",
      "token_start": 537,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 108510,
      "end_ms": 109910,
      "text": "跟什么样的人在一起，",
      "token_start": 543,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 109910,
      "end_ms": 113180,
      "text": "你就会拥有什么样的审美嘴可以骗人。",
      "token_start": 552,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 113320,
      "end_ms": 114545,
      "text": "审美很难骗人。",
      "token_start": 568,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 114960,
      "end_ms": 118764,
      "text": "爱一个人其实就是在允许他的审美进入你的人生。",
      "token_start": 574,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 119180,
      "end_ms": 120675,
      "text": "因为你们会一起选房子，",
      "token_start": 595,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 120890,
      "end_ms": 123530,
      "text": "一起装修、旅行、吃饭、教育孩子，",
      "token_start": 605,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 123690,
      "end_ms": 124885,
      "text": "这些都是审美。",
      "token_start": 617,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 125380,
      "end_ms": 128240,
      "text": "所以你一定要多去跟那些审美好的人去交朋友，",
      "token_start": 623,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 128240,
      "end_ms": 128840,
      "text": "多相处。",
      "token_start": 643,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 129100,
      "end_ms": 131695,
      "text": "他们的存在本身就是一道过滤网。",
      "token_start": 646,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 132020,
      "end_ms": 133080,
      "text": "和他们相处的时候，",
      "token_start": 660,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 133080,
      "end_ms": 134560,
      "text": "你不需要时刻去提防，",
      "token_start": 668,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 134580,
      "end_ms": 135765,
      "text": "被伤害、被消耗。",
      "token_start": 677,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 136140,
      "end_ms": 138065,
      "text": "因为审美高的人不作恶，",
      "token_start": 683,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 138450,
      "end_ms": 139190,
      "text": "真善美，",
      "token_start": 693,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 139190,
      "end_ms": 141005,
      "text": "三者一定是结合在一起的。",
      "token_start": 696,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 141290,
      "end_ms": 144055,
      "text": "很多人总以为等有钱了就审美了，",
      "token_start": 707,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 144300,
      "end_ms": 144875,
      "text": "真的吗？",
      "token_start": 721,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 145160,
      "end_ms": 147320,
      "text": "你看那些丑的景区丑建筑，",
      "token_start": 724,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 147320,
      "end_ms": 149965,
      "text": "丑街道大多不是因为穷造成的，",
      "token_start": 735,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 150260,
      "end_ms": 152615,
      "text": "明明花了很多钱还是很丑。",
      "token_start": 748,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 152900,
      "end_ms": 154735,
      "text": "其实这就是审美的问题。",
      "token_start": 759,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 155050,
      "end_ms": 157450,
      "text": "很多人以为的审美就是穿名贵的衣服，",
      "token_start": 769,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 157570,
      "end_ms": 158150,
      "text": "会拍照，",
      "token_start": 785,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 158170,
      "end_ms": 158775,
      "text": "会看展。",
      "token_start": 788,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 159120,
      "end_ms": 159460,
      "text": "其实，",
      "token_start": 791,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 159460,
      "end_ms": 160620,
      "text": "这些不是审美能力，",
      "token_start": 793,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 160660,
      "end_ms": 162215,
      "text": "这些是消费能力。",
      "token_start": 801,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 162680,
      "end_ms": 164300,
      "text": "钱可以买到奢侈品，",
      "token_start": 808,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 164320,
      "end_ms": 165605,
      "text": "但买不到审美丽。",
      "token_start": 816,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 165980,
      "end_ms": 168325,
      "text": "因为审美其实是一种判断能力。",
      "token_start": 823,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 168660,
      "end_ms": 169660,
      "text": "一个人怎么说话，",
      "token_start": 836,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 169860,
      "end_ms": 170960,
      "text": "怎么表达情绪，",
      "token_start": 843,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 171040,
      "end_ms": 172380,
      "text": "怎么处理尴尬等等，",
      "token_start": 849,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 172400,
      "end_ms": 173915,
      "text": "这些全部都是审美。",
      "token_start": 857,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 174280,
      "end_ms": 175140,
      "text": "穆前曾经说，",
      "token_start": 865,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 175140,
      "end_ms": 176560,
      "text": "没有沈美丽的绝症，",
      "token_start": 870,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 176640,
      "end_ms": 177615,
      "text": "知识也救不了。",
      "token_start": 878,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 177930,
      "end_ms": 178870,
      "text": "胡冠中先生说，",
      "token_start": 884,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 178870,
      "end_ms": 179970,
      "text": "现在文盲不多了，",
      "token_start": 890,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 179970,
      "end_ms": 181335,
      "text": "但是美盲还很多，",
      "token_start": 897,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 181640,
      "end_ms": 184560,
      "text": "一个人的命运很大程度上取决于他的审美。",
      "token_start": 904,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 184760,
      "end_ms": 185275,
      "text": "为什么？",
      "token_start": 922,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 185580,
      "end_ms": 188995,
      "text": "因为你这一生本质上就是在做无数次的选择，",
      "token_start": 925,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 189430,
      "end_ms": 190410,
      "text": "选择和谁结婚，",
      "token_start": 944,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 190630,
      "end_ms": 191890,
      "text": "选择和谁做朋友，",
      "token_start": 950,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 192070,
      "end_ms": 193190,
      "text": "选择什么样的工作，",
      "token_start": 957,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 193350,
      "end_ms": 194510,
      "text": "选择相信什么，",
      "token_start": 965,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 194570,
      "end_ms": 196135,
      "text": "选择把时间花在哪里，",
      "token_start": 971,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 196430,
      "end_ms": 198530,
      "text": "所有选择背后都是一个问题。",
      "token_start": 980,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 198730,
      "end_ms": 200650,
      "text": "你认为什么东西是好的？",
