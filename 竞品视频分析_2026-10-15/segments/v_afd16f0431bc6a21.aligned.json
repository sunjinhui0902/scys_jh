  "segments": [
    {
      "start_ms": 370,
      "end_ms": 1250,
      "text": "什么是文化？",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1450,
      "end_ms": 2910,
      "text": "今天在书中看到一段话，",
      "token_start": 5,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3090,
      "end_ms": 4470,
      "text": "我觉得写的特别的好，",
      "token_start": 15,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 4750,
      "end_ms": 7290,
      "text": "分享给你文化不是你拥有。",
      "token_start": 24,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 7290,
      "end_ms": 7990,
      "text": "什么学历，",
      "token_start": 35,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 8230,
      "end_ms": 9910,
      "text": "也不是你拥有多少阅历，",
      "token_start": 39,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 10130,
      "end_ms": 11770,
      "text": "更不是你识了多少汉字，",
      "token_start": 49,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 12050,
      "end_ms": 13430,
      "text": "会讲多少大道理。",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 14190,
      "end_ms": 15590,
      "text": "文化是认知的高度，",
      "token_start": 66,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 16010,
      "end_ms": 17270,
      "text": "是包容的高度，",
      "token_start": 74,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 17690,
      "end_ms": 19010,
      "text": "是思想的深度。",
      "token_start": 80,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 19690,
      "end_ms": 22050,
      "text": "文化是一个人刻在骨子里的修养，",
      "token_start": 86,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 22370,
      "end_ms": 23970,
      "text": "是根植于内心的修炼，",
      "token_start": 100,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 24250,
      "end_ms": 25770,
      "text": "是无需提醒的自觉，",
      "token_start": 109,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 26170,
      "end_ms": 28970,
      "text": "是有边界、有束缚的自由文，",
      "token_start": 117,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 30380,
      "end_ms": 32480,
      "text": "它更是刻在我们娘胎里的善良，",
      "token_start": 128,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 32840,
      "end_ms": 34260,
      "text": "是洞察世界的能力，",
      "token_start": 141,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 34720,
      "end_ms": 39815,
      "text": "是分辨是非、善恶分明的立场。",
      "token_start": 149,
      "token_end_exclusive": 161
    }
  ],
