{
  "video_id": "v_288404df23ed46a2",
  "duration_s": 451.604898,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_288404df23ed46a2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_288404df23ed46a2.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1410,
      "text": "他一辈子没结婚，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1410,
      "end_ms": 2130,
      "text": "没孩子，",
      "token_start": 7,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2310,
      "end_ms": 3990,
      "text": "却是五万个孩子的妈。",
      "token_start": 10,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4870,
      "end_ms": 6090,
      "text": "昨天咱们讲了，",
      "token_start": 19,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6630,
      "end_ms": 10810,
      "text": "有位老人临死前嘴里喊的是快拿产钱来，",
      "token_start": 25,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 11650,
      "end_ms": 15650,
      "text": "有人就问她到底是谁怎么这么神，",
      "token_start": 42,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 15930,
      "end_ms": 16910,
      "text": "她叫林巧智。",
      "token_start": 56,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 17810,
      "end_ms": 21150,
      "text": "今天咱们就好好唠唠一个妈字，",
      "token_start": 61,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 22050,
      "end_ms": 24930,
      "text": "在他身上到底有多重？",
      "token_start": 74,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 26070,
      "end_ms": 27270,
      "text": "先问您一个问题，",
      "token_start": 83,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 28250,
      "end_ms": 34920,
      "text": "这世界上有没有一种妈一辈子没生过一个孩子，",
      "token_start": 90,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 35180,
      "end_ms": 37920,
      "text": "却有五万多个孩子把他当妈有，",
      "token_start": 110,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 38300,
      "end_ms": 46180,
      "text": "就是他一九零一年林巧至出生在厦门鼓浪屿那地方，",
      "token_start": 123,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 46180,
      "end_ms": 48320,
      "text": "您去过就知道海风一吹，",
      "token_start": 145,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 48620,
      "end_ms": 50180,
      "text": "满岛都是钢琴声，",
      "token_start": 155,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 50660,
      "end_ms": 52100,
      "text": "美的跟花儿似的。",
      "token_start": 162,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 52640,
      "end_ms": 53980,
      "text": "可她的命苦，",
      "token_start": 169,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 54780,
      "end_ms": 55680,
      "text": "五岁那年，",
      "token_start": 174,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 56040,
      "end_ms": 57420,
      "text": "母亲得了宫颈癌，",
      "token_start": 178,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 57780,
      "end_ms": 60055,
      "text": "在那会儿管这叫妇科肿瘤，",
      "token_start": 185,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 60420,
      "end_ms": 61325,
      "text": "基本没救。",
      "token_start": 196,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 61830,
      "end_ms": 62910,
      "text": "他跪在床边，",
      "token_start": 200,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 63150,
      "end_ms": 67035,
      "text": "眼泪啪嗒啪嗒掉小手攥着妈妈的手，",
      "token_start": 205,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 67440,
      "end_ms": 70095,
      "text": "眼睁睁看着妈妈闭上眼睛。",
      "token_start": 220,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 70630,
      "end_ms": 76160,
      "text": "您想想一个五岁的小姑娘眼睁睁看着亲妈没了，",
      "token_start": 231,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 76160,
      "end_ms": 77175,
      "text": "那是什么滋味？",
      "token_start": 251,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 78100,
      "end_ms": 79175,
      "text": "从那一刻起，",
      "token_start": 257,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 79500,
      "end_ms": 81415,
      "text": "他心里就种下一颗种子，",
      "token_start": 262,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 82030,
      "end_ms": 82945,
      "text": "我要当医生，",
      "token_start": 272,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 83440,
      "end_ms": 86365,
      "text": "我要让别人的妈不再死。",
      "token_start": 277,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 87540,
      "end_ms": 88545,
      "text": "一九二一年，",
      "token_start": 287,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 88860,
      "end_ms": 92315,
      "text": "他二十岁去考协和医学院，",
      "token_start": 292,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 92820,
      "end_ms": 93795,
      "text": "百里挑一，",
      "token_start": 303,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 94360,
      "end_ms": 96320,
      "text": "考最后一门英语的时候，",
      "token_start": 307,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 96520,
      "end_ms": 98945,
      "text": "考场里一个女生中暑晕倒了。",
      "token_start": 317,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 99440,
      "end_ms": 100785,
      "text": "监考老师是男的，",
      "token_start": 329,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 101280,
      "end_ms": 102560,
      "text": "福也不是不服，",
      "token_start": 336,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 102560,
      "end_ms": 105145,
      "text": "也不是别的考生都低头做题，",
      "token_start": 342,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 105760,
      "end_ms": 107435,
      "text": "只有他把笔一扔，",
      "token_start": 354,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 107750,
      "end_ms": 108685,
      "text": "冲过去救人。",
      "token_start": 361,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 109510,
      "end_ms": 110455,
      "text": "等他忙活完，",
      "token_start": 366,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 110800,
      "end_ms": 112185,
      "text": "英语考试结束了，",
      "token_start": 371,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 112310,
      "end_ms": 113835,
      "text": "他以为自己肯定落榜了。",
      "token_start": 378,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 114690,
      "end_ms": 115510,
      "text": "可一个月后，",
      "token_start": 388,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 115750,
      "end_ms": 117445,
      "text": "录取通知书到家了。",
      "token_start": 393,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 118250,
      "end_ms": 118870,
      "text": "考官说，",
      "token_start": 401,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 119210,
      "end_ms": 121655,
      "text": "能放下自己的前程去救人，",
      "token_start": 404,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 122090,
      "end_ms": 123525,
      "text": "这就是当医生的料，",
      "token_start": 415,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 124290,
      "end_ms": 125665,
      "text": "分数可以补考，",
      "token_start": 423,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 126080,
      "end_ms": 127435,
      "text": "人品却补不了。",
      "token_start": 429,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 127950,
      "end_ms": 129190,
      "text": "进了协和医院，",
      "token_start": 435,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 129310,
      "end_ms": 130615,
      "text": "他选了妇产科，",
      "token_start": 441,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 131060,
      "end_ms": 134185,
      "text": "那时候妇产科又脏又累没人愿意干，",
      "token_start": 447,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 134640,
      "end_ms": 136215,
      "text": "医院还撂下一句话，",
      "token_start": 462,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 136610,
      "end_ms": 138765,
      "text": "女医生结婚就得走人。",
      "token_start": 470,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 139420,
      "end_ms": 140460,
      "text": "他二话没说，",
      "token_start": 479,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 140840,
      "end_ms": 142905,
      "text": "直接把自己嫁给了医院，",
      "token_start": 484,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 144000,
      "end_ms": 147560,
      "text": "一辈子没结婚没孩子。",
      "token_start": 494,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 147680,
      "end_ms": 148540,
      "text": "有人问他，",
      "token_start": 503,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 148560,
      "end_ms": 149445,
      "text": "你不后悔。",
      "token_start": 507,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 150530,
      "end_ms": 150990,
      "text": "他说，",
      "token_start": 511,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 152060,
      "end_ms": 158355,
      "text": "我最爱听的声音就是婴儿出生后的第一声啼哭。",
      "token_start": 513,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 159150,
      "end_ms": 161895,
      "text": "这句话他说了几十年，",
      "token_start": 533,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 163330,
      "end_ms": 164755,
      "text": "也做到了几十年，",
      "token_start": 542,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 166380,
      "end_ms": 168750,
      "text": "他有个习惯给孕妇听。",
      "token_start": 549,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 168750,
      "end_ms": 169635,
      "text": "开心之前，",
      "token_start": 558,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 170070,
      "end_ms": 174550,
      "text": "先把兵粮的听诊器贴在自己手心里，",
      "token_start": 562,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 174550,
      "end_ms": 177445,
      "text": "无热再放到孕妇肚子上。",
      "token_start": 577,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 177880,
      "end_ms": 180635,
      "text": "冬天那个凉劲儿能让人一机灵，",
      "token_start": 587,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 181020,
      "end_ms": 182085,
      "text": "就这一个动作，",
      "token_start": 600,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 182560,
      "end_ms": 183615,
      "text": "他做了一辈子，",
      "token_start": 606,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 183900,
      "end_ms": 185145,
      "text": "从来没省略过。",
      "token_start": 612,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 185860,
      "end_ms": 186395,
      "text": "他说，",
      "token_start": 618,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 187680,
      "end_ms": 189245,
      "text": "母亲已经在受罪了，",
      "token_start": 620,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 190480,
      "end_ms": 192995,
      "text": "能少一点粮就少一点粮，",
      "token_start": 628,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 193680,
      "end_ms": 195300,
      "text": "产妇疼的大喊大叫，",
      "token_start": 638,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 195480,
      "end_ms": 197265,
      "text": "别的医生手足无措。",
      "token_start": 646,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 197730,
      "end_ms": 198615,
      "text": "他走过去，",
      "token_start": 654,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 198950,
      "end_ms": 200195,
      "text": "摸摸产妇的头，",
      "token_start": 658,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 200540,
      "end_ms": 201845,
      "text": "握握产妇的手，",
      "token_start": 664,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 202340,
      "end_ms": 204035,
      "text": "产妇立马就安静了。",
      "token_start": 670,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 205410,
      "end_ms": 206815,
      "text": "有人说这是神迹，",
      "token_start": 678,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 207400,
      "end_ms": 209005,
      "text": "其实哪儿有什么神迹，",
      "token_start": 685,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 209370,
      "end_ms": 212315,
      "text": "就是他打心眼里把产妇当亲人，",
      "token_start": 694,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 212690,
      "end_ms": 215015,
      "text": "人一靠近心就安了。",
      "token_start": 707,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 215460,
      "end_ms": 216905,
      "text": "他接生的孩子里，",
      "token_start": 715,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 217210,
      "end_ms": 217790,
      "text": "有一个，",
      "token_start": 722,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 217790,
      "end_ms": 221955,
      "text": "您肯定认识袁隆平。",
      "token_start": 725,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 222570,
      "end_ms": 226345,
      "text": "一九三零年协和医院的出生档案上，",
      "token_start": 733,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 226680,
      "end_ms": 229205,
      "text": "那个小名叫袁小孩的男婴，",
      "token_start": 748,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 230630,
      "end_ms": 235640,
      "text": "杰生医生一栏写着三个英文单词QG零。",
      "token_start": 759,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 236260,
      "end_ms": 239785,
      "text": "后来袁隆平成了杂交水稻之父，",
      "token_start": 775,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 240570,
      "end_ms": 240950,
      "text": "他说，",
      "token_start": 788,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 240970,
      "end_ms": 242775,
      "text": "自己能由林大夫接生，",
      "token_start": 790,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 243210,
      "end_ms": 244625,
      "text": "是莫大的荣幸。",
      "token_start": 799,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 245220,
      "end_ms": 253575,
      "text": "还有一位钟南山院士见到他得规规矩矩喊一声姑婆。",
      "token_start": 805,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 254060,
      "end_ms": 255060,
      "text": "一九四一年，",
      "token_start": 827,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 255060,
      "end_ms": 256235,
      "text": "太平洋战争爆发，",
      "token_start": 832,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 256750,
      "end_ms": 258055,
      "text": "协和医院关门了，",
      "token_start": 839,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 259190,
      "end_ms": 261540,
      "text": "他就在东塘子胡同开了间。",
      "token_start": 846,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 261540,
      "end_ms": 264395,
      "text": "小诊所达官贵人来看病，",
      "token_start": 857,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 264780,
      "end_ms": 267450,
      "text": "他接嗯拉洋车的人来看病，",
      "token_start": 867,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 267530,
      "end_ms": 269795,
      "text": "他也解碰上真穷的，",
      "token_start": 878,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 270020,
      "end_ms": 270705,
      "text": "他不收钱，",
      "token_start": 886,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 271070,
      "end_ms": 275165,
      "text": "还倒贴自己掏钱给产妇买鸡蛋买红糖。",
      "token_start": 890,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 275930,
      "end_ms": 276990,
      "text": "六七年下来，",
      "token_start": 906,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 277190,
      "end_ms": 280745,
      "text": "他攒下八千八百八十八份病例，",
      "token_start": 911,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 281150,
      "end_ms": 283105,
      "text": "每一份都工工整整。",
      "token_start": 924,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 283390,
      "end_ms": 285925,
      "text": "您知道他写病历有多认真吗？",
      "token_start": 932,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 286770,
      "end_ms": 287190,
      "text": "他说，",
      "token_start": 944,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 287470,
      "end_ms": 288850,
      "text": "医生要把字写好，",
      "token_start": 946,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 289050,
      "end_ms": 290665,
      "text": "这是最起码的底线。",
      "token_start": 953,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 291660,
      "end_ms": 293680,
      "text": "看惯了龙飞凤舞的字，",
      "token_start": 961,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 293940,
      "end_ms": 295480,
      "text": "您再看看他的病历，",
      "token_start": 970,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 295960,
      "end_ms": 297040,
      "text": "娟绣工整，",
      "token_start": 978,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 297460,
      "end_ms": 299780,
      "text": "唯恐病人看错一个字，",
      "token_start": 982,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 300220,
      "end_ms": 302300,
      "text": "这不是字好不好看的事，",
      "token_start": 991,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 302740,
      "end_ms": 304640,
      "text": "这是心里有没有病人？",
      "token_start": 1001,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 304760,
      "end_ms": 305900,
      "text": "一九六二年，",
      "token_start": 1010,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 306220,
      "end_ms": 308760,
      "text": "一个刚出生几小时的婴儿，",
      "token_start": 1015,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 309080,
      "end_ms": 310200,
      "text": "全身发黄，",
      "token_start": 1026,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 310620,
      "end_ms": 311820,
      "text": "眼看不行了，",
      "token_start": 1030,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 312120,
      "end_ms": 313960,
      "text": "这种病国内没人治过，",
      "token_start": 1035,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 314200,
      "end_ms": 315760,
      "text": "家属都快放弃了。",
      "token_start": 1044,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 316360,
      "end_ms": 317740,
      "text": "同事劝他别接，",
      "token_start": 1051,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 318300,
      "end_ms": 319180,
      "text": "他摇头道，",
      "token_start": 1057,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 319360,
      "end_ms": 320700,
      "text": "只要有一线希望，",
      "token_start": 1061,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 320700,
      "end_ms": 322070,
      "text": "我就得试试。",
      "token_start": 1068,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 322950,
      "end_ms": 327450,
      "text": "他翻外文资料一页一页找找到一种办法，",
      "token_start": 1073,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 327870,
      "end_ms": 328710,
      "text": "脐待换血，",
      "token_start": 1090,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 328910,
      "end_ms": 329910,
      "text": "第一次没成功，",
      "token_start": 1094,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 330130,
      "end_ms": 331170,
      "text": "第二次又复发，",
      "token_start": 1100,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 331650,
      "end_ms": 334930,
      "text": "第三次孩子终于哭出了声。",
      "token_start": 1106,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 335990,
      "end_ms": 340790,
      "text": "这是中国第一例被救回来的新生儿溶血症患儿。",
      "token_start": 1117,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 340910,
      "end_ms": 345220,
      "text": "他救的不是一个孩子，",
      "token_start": 1137,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 345960,
      "end_ms": 347760,
      "text": "是身后的一整个家。",
      "token_start": 1146,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 348720,
      "end_ms": 351035,
      "text": "一九八三年四月二十二号，",
      "token_start": 1154,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 352030,
      "end_ms": 355040,
      "text": "八十二岁的林巧志走了，",
      "token_start": 1165,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 357170,
      "end_ms": 358465,
      "text": "临终昏迷中，",
      "token_start": 1175,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 359470,
      "end_ms": 362785,
      "text": "他突然喊快快拿产钱来，",
      "token_start": 1180,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 363760,
      "end_ms": 366105,
      "text": "护士抓了样东西塞在他手里，",
      "token_start": 1190,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 366300,
      "end_ms": 367675,
      "text": "他慢慢平静下来，",
      "token_start": 1202,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 368620,
      "end_ms": 369445,
      "text": "过了一会儿，",
      "token_start": 1209,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 370090,
      "end_ms": 371945,
      "text": "脸上露出一丝微笑，",
      "token_start": 1214,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 372900,
      "end_ms": 374425,
      "text": "又是一个胖娃娃。",
      "token_start": 1222,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 375630,
      "end_ms": 376150,
      "text": "一晚上，",
      "token_start": 1229,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 376150,
      "end_ms": 378945,
      "text": "三个真好一辈子。",
      "token_start": 1232,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 380860,
      "end_ms": 381965,
      "text": "最后一句话，",
      "token_start": 1239,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 382830,
      "end_ms": 384195,
      "text": "还是产房的事儿。",
      "token_start": 1244,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 385020,
      "end_ms": 386205,
      "text": "他留下遗嘱，",
      "token_start": 1251,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 386960,
      "end_ms": 388175,
      "text": "积蓄三万元，",
      "token_start": 1256,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 389010,
      "end_ms": 395325,
      "text": "全部捐给幼儿园、托儿所遗体捐给医学院做研究，",
      "token_start": 1261,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 397630,
      "end_ms": 399555,
      "text": "骨灰洒回鼓浪屿的海面。",
      "token_start": 1281,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 400080,
      "end_ms": 401040,
      "text": "他没当过妈，",
      "token_start": 1291,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 401240,
      "end_ms": 404745,
      "text": "却让五万多个家庭圆了妈这个字。",
      "token_start": 1296,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 405430,
      "end_ms": 408805,
      "text": "他的这一生被完整收进了一本书，",
      "token_start": 1310,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 409320,
      "end_ms": 410325,
      "text": "国之脊梁。",
      "token_start": 1324,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 410770,
      "end_ms": 413770,
      "text": "中科院学部编的图文并茂，",
      "token_start": 1328,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 414330,
      "end_ms": 415910,
      "text": "里面不光有林巧智，",
      "token_start": 1339,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 416210,
      "end_ms": 422850,
      "text": "还有钱学森、袁隆平、邓稼先等四十位中国科学家的真实人生。",
      "token_start": 1347,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 422990,
      "end_ms": 426970,
      "text": "大人读的心热孩子看得进去链接，",
      "token_start": 1372,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 427130,
      "end_ms": 428650,
      "text": "我放在视频左下角了，",
      "token_start": 1386,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 429010,
      "end_ms": 431150,
      "text": "感兴趣的朋友可以直接拍下，",
      "token_start": 1395,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 431510,
      "end_ms": 432750,
      "text": "拿到手细细品读。",
      "token_start": 1407,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 433670,
      "end_ms": 436110,
      "text": "如果您也心疼这位林妈妈，",
      "token_start": 1414,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 436490,
      "end_ms": 439630,
      "text": "点个赞转发给身边的女性长辈，",
      "token_start": 1425,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 439630,
      "end_ms": 440315,
      "text": "告诉她，",
      "token_start": 1438,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 440820,
      "end_ms": 444300,
      "text": "您和您的孩子都曾被这样的人守护过。",
      "token_start": 1441,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 444720,
      "end_ms": 445920,
      "text": "收藏这条视频，",
      "token_start": 1457,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 446320,
      "end_ms": 449660,
      "text": "下期咱们讲讲开国大典的那天，",
      "token_start": 1463,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 450140,
      "end_ms": 451425,
      "text": "他为什么没有去？",
      "token_start": 1476,
      "token_end_exclusive": 1483
    }
  ],
