{
  "video_id": "v_38c8fc48799ea7a4",
  "duration_s": 234.683991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_38c8fc48799ea7a4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_38c8fc48799ea7a4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 460,
      "end_ms": 1260,
      "text": "这酒开了，",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1340,
      "end_ms": 2220,
      "text": "你不先给我倒，",
      "token_start": 4,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2760,
      "end_ms": 3540,
      "text": "先倒的是客，",
      "token_start": 10,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3540,
      "end_ms": 4300,
      "text": "后到的是主。",
      "token_start": 15,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4320,
      "end_ms": 5240,
      "text": "您是今天的主人，",
      "token_start": 20,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 5260,
      "end_ms": 6740,
      "text": "最后一杯满上代表压轴，",
      "token_start": 27,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 6800,
      "end_ms": 8665,
      "text": "全桌的福气都沉淀在您杯底，",
      "token_start": 37,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 10470,
      "end_ms": 11710,
      "text": "你酒量挺好的呀。",
      "token_start": 49,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 12030,
      "end_ms": 12430,
      "text": "领导，",
      "token_start": 56,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12450,
      "end_ms": 13390,
      "text": "您可抬举我了，",
      "token_start": 58,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 13410,
      "end_ms": 14570,
      "text": "我平时真不太能喝，",
      "token_start": 64,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 14790,
      "end_ms": 16370,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 72,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 16370,
      "end_ms": 16950,
      "text": "高兴啊，",
      "token_start": 83,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 16970,
      "end_ms": 18389,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 86,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 20150,
      "end_ms": 21970,
      "text": "你这敬酒的顺序是不是不对，",
      "token_start": 96,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 22210,
      "end_ms": 23070,
      "text": "怎么先敬别人，",
      "token_start": 108,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 23070,
      "end_ms": 24190,
      "text": "先把流程走完，",
      "token_start": 114,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 24190,
      "end_ms": 25690,
      "text": "最后踏踏实实坐下来，",
      "token_start": 120,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 25690,
      "end_ms": 26810,
      "text": "陪您慢慢喝好的，",
      "token_start": 129,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 26810,
      "end_ms": 27230,
      "text": "留到最杯。",
      "token_start": 136,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 27230,
      "end_ms": 31770,
      "text": "这鸭子是好鸭子，",
      "token_start": 140,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 31770,
      "end_ms": 32970,
      "text": "就是嘴硬，",
      "token_start": 147,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 32970,
      "end_ms": 34830,
      "text": "嘴硬，",
      "token_start": 151,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 34830,
      "end_ms": 35730,
      "text": "才守得住秘密。",
      "token_start": 153,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 35730,
      "end_ms": 38590,
      "text": "这吃到这个点儿了，",
      "token_start": 159,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 38590,
      "end_ms": 41540,
      "text": "你怎么还没敬敬一杯杯敬您的人排着队呢？",
      "token_start": 167,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 41540,
      "end_ms": 42900,
      "text": "我最后一个敬前面的酒，",
      "token_start": 185,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 42900,
      "end_ms": 43660,
      "text": "您喝的是场面。",
      "token_start": 195,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 43660,
      "end_ms": 44780,
      "text": "我这杯您喝的是收尾，",
      "token_start": 201,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 44780,
      "end_ms": 48399,
      "text": "代表今天的事儿圆满。",
      "token_start": 210,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 48440,
      "end_ms": 49160,
      "text": "这藕是藕，",
      "token_start": 219,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 49160,
      "end_ms": 50080,
      "text": "藕啊，",
      "token_start": 223,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 50080,
      "end_ms": 51300,
      "text": "就是心眼太多了。",
      "token_start": 225,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 52360,
      "end_ms": 54300,
      "text": "领导藕虽然心眼多，",
      "token_start": 232,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 54460,
      "end_ms": 55780,
      "text": "但也是您的下酒菜啊。",
      "token_start": 240,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 57820,
      "end_ms": 58900,
      "text": "怎么我来迟了，",
      "token_start": 249,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 59160,
      "end_ms": 61760,
      "text": "你也不打个电话催催催您是给您压力，",
      "token_start": 255,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 61860,
      "end_ms": 64040,
      "text": "等您是给您尊重您来迟肯定有原因，",
      "token_start": 271,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 64240,
      "end_ms": 65620,
      "text": "我等的就是信任到了，",
      "token_start": 286,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 65620,
      "end_ms": 66945,
      "text": "就是圆满。",
      "token_start": 295,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 67900,
      "end_ms": 68300,
      "text": "小李，",
      "token_start": 299,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 68300,
      "end_ms": 69495,
      "text": "最近表现不错啊，",
      "token_start": 301,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 69840,
      "end_ms": 71675,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 308,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 71940,
      "end_ms": 72965,
      "text": "我得提前敬你一杯。",
      "token_start": 321,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 73300,
      "end_ms": 73980,
      "text": "听这意思，",
      "token_start": 329,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 74120,
      "end_ms": 75255,
      "text": "领导也要高升了呀，",
      "token_start": 333,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 75430,
      "end_ms": 76650,
      "text": "我得提前敬领导一杯，",
      "token_start": 341,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 77930,
      "end_ms": 78755,
      "text": "打这么多饭，",
      "token_start": 350,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 79190,
      "end_ms": 79890,
      "text": "你喂猪呢？",
      "token_start": 355,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 80290,
      "end_ms": 80610,
      "text": "领导，",
      "token_start": 359,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 80610,
      "end_ms": 81310,
      "text": "我哪敢啊，",
      "token_start": 361,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 81370,
      "end_ms": 83365,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 365,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 83530,
      "end_ms": 84930,
      "text": "都说宰相肚里能撑船，",
      "token_start": 381,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 84990,
      "end_ms": 86235,
      "text": "更何况只是一碗饭呢。",
      "token_start": 390,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 86550,
      "end_ms": 87645,
      "text": "哈哈哈哈哈哈，",
      "token_start": 399,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 88280,
      "end_ms": 89585,
      "text": "我这字儿写的一般，",
      "token_start": 405,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 89930,
      "end_ms": 91850,
      "text": "你别为了哄我乱夸字，",
      "token_start": 413,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 91850,
      "end_ms": 92695,
      "text": "我确实不懂，",
      "token_start": 422,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 93010,
      "end_ms": 93830,
      "text": "但你一握笔，",
      "token_start": 427,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 93830,
      "end_ms": 94750,
      "text": "全屋都安静了。",
      "token_start": 432,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 94770,
      "end_ms": 95365,
      "text": "这个我懂。",
      "token_start": 438,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 96110,
      "end_ms": 97755,
      "text": "哈哈哈哈哈哈哈哈，",
      "token_start": 442,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 98010,
      "end_ms": 99385,
      "text": "你这人脾气挺好，",
      "token_start": 450,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 99990,
      "end_ms": 101910,
      "text": "没见你发过火发火，",
      "token_start": 457,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 101910,
      "end_ms": 102835,
      "text": "解决不了问题。",
      "token_start": 465,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 103290,
      "end_ms": 104530,
      "text": "您在前面顶着压力，",
      "token_start": 471,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 104530,
      "end_ms": 106135,
      "text": "我在后面添乱不合适。",
      "token_start": 479,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 106830,
      "end_ms": 108645,
      "text": "哈哈哈哈哈小王啊，",
      "token_start": 488,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 109380,
      "end_ms": 111195,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 496,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 111760,
      "end_ms": 113965,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 506,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 114340,
      "end_ms": 116025,
      "text": "只能在EP上找些自我安慰了。",
      "token_start": 519,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 116420,
      "end_ms": 117275,
      "text": "哈哈哈哈，",
      "token_start": 531,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 117560,
      "end_ms": 119935,
      "text": "怎么你一来我茶杯盖就摔碎了，",
      "token_start": 535,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 120390,
      "end_ms": 122310,
      "text": "岁岁平安盖碎了一地，",
      "token_start": 548,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 122310,
      "end_ms": 123470,
      "text": "平安铺满一地。",
      "token_start": 557,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 123570,
      "end_ms": 125645,
      "text": "您今天出门步步都是平安。",
      "token_start": 563,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 126060,
      "end_ms": 126925,
      "text": "哈哈哈哈，",
      "token_start": 574,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 127510,
      "end_ms": 128785,
      "text": "我真不怎么喜欢你，",
      "token_start": 578,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 130570,
      "end_ms": 132210,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 586,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 132210,
      "end_ms": 134765,
      "text": "我领导的格局值得我们学习。",
      "token_start": 599,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 135350,
      "end_ms": 136595,
      "text": "哈哈哈哈哈哈，",
      "token_start": 611,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 136750,
      "end_ms": 137850,
      "text": "家里没什么好茶，",
      "token_start": 617,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 138110,
      "end_ms": 140440,
      "text": "你就凑合喝吧茶叶好不好？",
      "token_start": 624,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 140560,
      "end_ms": 141535,
      "text": "得看怎么标价。",
      "token_start": 635,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 141890,
      "end_ms": 143030,
      "text": "您亲手倒的这杯，",
      "token_start": 641,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 143170,
      "end_ms": 143890,
      "text": "只讲情分，",
      "token_start": 648,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 143890,
      "end_ms": 146450,
      "text": "不讲价这鱼怎么点的这么赞。",
      "token_start": 652,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 146450,
      "end_ms": 148930,
      "text": "前面大鱼大肉最后来一口清淡的漱漱口。",
      "token_start": 664,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 149070,
      "end_ms": 150310,
      "text": "就像您听完汇报，",
      "token_start": 681,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 150330,
      "end_ms": 151250,
      "text": "最后来一句总结，",
      "token_start": 688,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 151370,
      "end_ms": 151990,
      "text": "清清爽爽，",
      "token_start": 695,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 151990,
      "end_ms": 153740,
      "text": "散会好好啊啊，",
      "token_start": 699,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 153810,
      "end_ms": 154370,
      "text": "来就来，",
      "token_start": 705,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 154710,
      "end_ms": 155710,
      "text": "带什么礼物啊，",
      "token_start": 708,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 155750,
      "end_ms": 156645,
      "text": "都不是外人。",
      "token_start": 714,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 156930,
      "end_ms": 157230,
      "text": "哎呀，",
      "token_start": 719,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 157230,
      "end_ms": 157810,
      "text": "您都说了，",
      "token_start": 721,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 157810,
      "end_ms": 158450,
      "text": "不是外人，",
      "token_start": 725,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 158530,
      "end_ms": 159930,
      "text": "我一直都把您当长辈看，",
      "token_start": 729,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 159950,
      "end_ms": 162095,
      "text": "哪有晚辈看长辈空手来的道理啊。",
      "token_start": 739,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 162690,
      "end_ms": 165345,
      "text": "哈哈请进你一开口就让人喜欢你，",
      "token_start": 753,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 165620,
      "end_ms": 166545,
      "text": "你是怎么做到的？",
      "token_start": 767,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 166860,
      "end_ms": 169000,
      "text": "因为我一直在看这本闲谈高手，",
      "token_start": 774,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 169200,
      "end_ms": 170960,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 787,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 171040,
      "end_ms": 172920,
      "text": "那些会说话、会来事儿的人。",
      "token_start": 798,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 173020,
      "end_ms": 174180,
      "text": "假如你不爱说话，",
      "token_start": 809,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 174260,
      "end_ms": 175000,
      "text": "不爱争辩，",
      "token_start": 816,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 175100,
      "end_ms": 175960,
      "text": "也不爱出门，",
      "token_start": 820,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 176020,
      "end_ms": 177275,
      "text": "甚至恐惧社交，",
      "token_start": 825,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 177620,
      "end_ms": 179515,
      "text": "推荐你读完这本闲谈高手，",
      "token_start": 831,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 179840,
      "end_ms": 182035,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 842,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 182360,
      "end_ms": 183540,
      "text": "你每天就看两页，",
      "token_start": 854,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 183680,
      "end_ms": 185085,
      "text": "每一个场景慢慢练，",
      "token_start": 861,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 185360,
      "end_ms": 187980,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 869,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 188100,
      "end_ms": 189480,
      "text": "在这本书里有一句话，",
      "token_start": 884,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 189500,
      "end_ms": 190375,
      "text": "我特别欣赏，",
      "token_start": 893,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 190720,
      "end_ms": 190880,
      "text": "他，",
      "token_start": 898,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 190880,
      "end_ms": 192915,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 899,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 193160,
      "end_ms": 193875,
      "text": "你可以回，",
      "token_start": 911,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 194340,
      "end_ms": 195260,
      "text": "那是不优秀点，",
      "token_start": 915,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 195340,
      "end_ms": 196715,
      "text": "怎么能和你做朋友呢？",
      "token_start": 921,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 197030,
      "end_ms": 198650,
      "text": "当有人说你真聪明，",
      "token_start": 930,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 198770,
      "end_ms": 200465,
      "text": "你就回近朱者赤，",
      "token_start": 938,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 200780,
      "end_ms": 201740,
      "text": "和你在一起啊，",
      "token_start": 945,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 201840,
      "end_ms": 204880,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 951,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 204960,
      "end_ms": 206140,
      "text": "你就回领导，",
      "token_start": 966,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 206340,
      "end_ms": 207645,
      "text": "这都是我应该做的。",
      "token_start": 971,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 207940,
      "end_ms": 209240,
      "text": "强将手下吴若兵，",
      "token_start": 979,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 209540,
      "end_ms": 210995,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 986,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 211260,
      "end_ms": 212540,
      "text": "当我看到这段的时候，",
      "token_start": 995,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 212620,
      "end_ms": 214475,
      "text": "这个真是让我一解心开啊。",
      "token_start": 1004,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 214790,
      "end_ms": 215995,
      "text": "每一句都很有意思，",
      "token_start": 1015,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 216310,
      "end_ms": 218790,
      "text": "就是手把手教我们在不同的场景之下，",
      "token_start": 1023,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 218790,
      "end_ms": 219490,
      "text": "应该怎么说？",
      "token_start": 1039,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 219770,
      "end_ms": 222435,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1044,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 222690,
      "end_ms": 224010,
      "text": "你就放心的拿回去看，",
      "token_start": 1062,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 224350,
      "end_ms": 225730,
      "text": "就是一句一句的教你，",
      "token_start": 1071,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 225990,
      "end_ms": 228495,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 1080,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 228820,
      "end_ms": 229860,
      "text": "但凡学会三分，",
      "token_start": 1092,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 230100,
      "end_ms": 232455,
      "text": "你就能把人际关系拿捏的死死的，",
      "token_start": 1098,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 232880,
      "end_ms": 234565,
      "text": "这本书真的可以帮助到大家。",
