{
  "video_id": "v_15779fc77ad73396",
  "duration_s": 422.301995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_15779fc77ad73396.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_15779fc77ad73396.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 690,
      "text": "您知道，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 690,
      "end_ms": 6570,
      "text": "中国大地上老天爷亲手凿出来的最不可思议的地下奇观，",
      "token_start": 3,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 7110,
      "end_ms": 9610,
      "text": "究竟藏在哪一个角落吗？",
      "token_start": 27,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 10150,
      "end_ms": 14110,
      "text": "有人说是湖北腾龙洞中国最大的溶洞，",
      "token_start": 37,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 14690,
      "end_ms": 17390,
      "text": "整条清江都被它吞进去了。",
      "token_start": 53,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 18350,
      "end_ms": 20270,
      "text": "有人说是重庆芙蓉洞，",
      "token_start": 64,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 20630,
      "end_ms": 26130,
      "text": "中国唯一一个被列入世界自然遗产名录的天然洞穴。",
      "token_start": 73,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 27030,
      "end_ms": 28590,
      "text": "可您要是真信了，",
      "token_start": 95,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 28910,
      "end_ms": 29905,
      "text": "那就被忽悠了。",
      "token_start": 102,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 31270,
      "end_ms": 33830,
      "text": "真正霸榜的那个一露脸，",
      "token_start": 108,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 33850,
      "end_ms": 34970,
      "text": "他们都得往后站。",
      "token_start": 118,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 35690,
      "end_ms": 38730,
      "text": "他被公认为中国溶洞的终极天花板，",
      "token_start": 125,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 38790,
      "end_ms": 42450,
      "text": "肚子里锁着一件天下独一份的地下至宝。",
      "token_start": 140,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 42910,
      "end_ms": 44730,
      "text": "凡是亲眼见过的人，",
      "token_start": 157,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 45130,
      "end_ms": 46630,
      "text": "出来都只剩一句话，",
      "token_start": 165,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 47350,
      "end_ms": 47890,
      "text": "看过了，",
      "token_start": 173,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 47890,
      "end_ms": 50350,
      "text": "它别的洞再入不了眼。",
      "token_start": 176,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 51490,
      "end_ms": 57350,
      "text": "今天咱们就来盘点盘点中国十大鬼斧神工的天然洞穴奇观。",
      "token_start": 185,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 57730,
      "end_ms": 59685,
      "text": "可能您去过不少名山大川，",
      "token_start": 210,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 60240,
      "end_ms": 63560,
      "text": "可这种藏在地底下几百万年的东西，",
      "token_start": 221,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 63740,
      "end_ms": 64975,
      "text": "看一回少一回。",
      "token_start": 236,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 65330,
      "end_ms": 67310,
      "text": "老规矩开讲之前，",
      "token_start": 242,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 67350,
      "end_ms": 70570,
      "text": "劳烦您顺手扣个一点颗红心，",
      "token_start": 249,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 70810,
      "end_ms": 73865,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 261,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 74130,
      "end_ms": 80655,
      "text": "重庆雪域洞在重庆丰都长江对岸龙和峡谷的岩壁之上，",
      "token_start": 273,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 81000,
      "end_ms": 83125,
      "text": "全长一千六百四十四米。",
      "token_start": 296,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 83610,
      "end_ms": 89645,
      "text": "这洞最绝的是他年轻是国内已开发洞穴里最年轻的一个，",
      "token_start": 306,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 90280,
      "end_ms": 95455,
      "text": "而且还在生长一般洞穴沉积物一百年才长一毫米，",
      "token_start": 330,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 95910,
      "end_ms": 98915,
      "text": "雪玉洞一年涨零点三三毫米，",
      "token_start": 351,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 99450,
      "end_ms": 101655,
      "text": "比别的地方快了三十多倍。",
      "token_start": 363,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 102110,
      "end_ms": 104545,
      "text": "洞内百分之八十的钟乳石，",
      "token_start": 374,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 105030,
      "end_ms": 106095,
      "text": "洁白如雪，",
      "token_start": 385,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 106540,
      "end_ms": 107665,
      "text": "志纯似玉，",
      "token_start": 389,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 108120,
      "end_ms": 109915,
      "text": "所以叫雪欲冻。",
      "token_start": 393,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 111020,
      "end_ms": 112060,
      "text": "这里的钟乳时，",
      "token_start": 399,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 112060,
      "end_ms": 115175,
      "text": "年龄大多在三千三百年到一万年之间，",
      "token_start": 405,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 115620,
      "end_ms": 117325,
      "text": "相当于人类的十几岁。",
      "token_start": 421,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 117740,
      "end_ms": 119315,
      "text": "别的溶洞是老爷爷，",
      "token_start": 430,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 119840,
      "end_ms": 120745,
      "text": "她是个小姑娘，",
      "token_start": 438,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 121040,
      "end_ms": 121980,
      "text": "浑身雪白，",
      "token_start": 444,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 122140,
      "end_ms": 123045,
      "text": "晶莹剔透。",
      "token_start": 448,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 123470,
      "end_ms": 124835,
      "text": "您说这是溶洞，",
      "token_start": 452,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 125370,
      "end_ms": 127385,
      "text": "还是大自然养的一个孩子？",
      "token_start": 458,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 127950,
      "end_ms": 128525,
      "text": "第九名，",
      "token_start": 469,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 128960,
      "end_ms": 133445,
      "text": "北京石花洞在北京房山发现于明朝正统十一年，",
      "token_start": 472,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 133880,
      "end_ms": 136025,
      "text": "开发于二十世纪八十年代，",
      "token_start": 492,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 136600,
      "end_ms": 142215,
      "text": "是中国第一座以岩溶洞穴自然景观为主体的地质公园。",
      "token_start": 503,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 142750,
      "end_ms": 145745,
      "text": "这洞最绝的是洞层多，",
      "token_start": 526,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 146750,
      "end_ms": 147910,
      "text": "一共有八层，",
      "token_start": 535,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 148130,
      "end_ms": 149275,
      "text": "一层叠一层，",
      "token_start": 540,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 149620,
      "end_ms": 151875,
      "text": "像一栋八层楼的地下大厦，",
      "token_start": 545,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 152760,
      "end_ms": 155545,
      "text": "全国岩溶洞穴里层数最多。",
      "token_start": 556,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 156320,
      "end_ms": 158585,
      "text": "洞里的石盾有两百多个，",
      "token_start": 567,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 158900,
      "end_ms": 160235,
      "text": "也是全世界罕见。",
      "token_start": 577,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 160740,
      "end_ms": 165315,
      "text": "石花洞里还有一种别处没有的东西叫月乃石，",
      "token_start": 584,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 165770,
      "end_ms": 166705,
      "text": "外表坚硬，",
      "token_start": 603,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 167080,
      "end_ms": 169375,
      "text": "里面是柔软的粉末状物质，",
      "token_start": 607,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 169740,
      "end_ms": 171445,
      "text": "乳白色像奶酪。",
      "token_start": 618,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 172270,
      "end_ms": 173665,
      "text": "全国首次发现，",
      "token_start": 624,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 174350,
      "end_ms": 177010,
      "text": "专家们认为可能跟细菌作用有关。",
      "token_start": 630,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 177190,
      "end_ms": 179085,
      "text": "您想想一块石头，",
      "token_start": 644,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 179340,
      "end_ms": 180705,
      "text": "外面硬里面软，",
      "token_start": 651,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 181240,
      "end_ms": 182505,
      "text": "只在石花洞里有。",
      "token_start": 657,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 182960,
      "end_ms": 186265,
      "text": "您说这是石头还是大地的奶油蛋糕？",
      "token_start": 664,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 186480,
      "end_ms": 187045,
      "text": "第八名，",
      "token_start": 679,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 187590,
      "end_ms": 198155,
      "text": "四川兴闻十海天泉洞在四川宜宾兴文县这洞最绝的是他大已经探明长度十点五公里，",
      "token_start": 682,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 198400,
      "end_ms": 199375,
      "text": "上下四层，",
      "token_start": 718,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 199990,
      "end_ms": 200690,
      "text": "现开放，",
      "token_start": 722,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 200730,
      "end_ms": 202285,
      "text": "主动约三公里，",
      "token_start": 725,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 202760,
      "end_ms": 204885,
      "text": "总面积八万多平方米，",
      "token_start": 731,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 205420,
      "end_ms": 210065,
      "text": "空间规模和游览长度都居世界洞穴之首。",
      "token_start": 740,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 210710,
      "end_ms": 213815,
      "text": "天泉洞跟景区内的世界第一大漏斗，",
      "token_start": 757,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 214140,
      "end_ms": 217535,
      "text": "还有大型地表石海三绝共生，",
      "token_start": 772,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 217890,
      "end_ms": 220245,
      "text": "构成了世界级的喀斯特景观，",
      "token_start": 784,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 220720,
      "end_ms": 222020,
      "text": "地上是一片石头，",
      "token_start": 796,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 222020,
      "end_ms": 225190,
      "text": "海洋石林石峰从地里冒出来，",
      "token_start": 803,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 225230,
      "end_ms": 226965,
      "text": "地下是天泉洞，",
      "token_start": 815,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 227370,
      "end_ms": 232465,
      "text": "洞庭里藏着谢玉流光石临仙姿浪漫星河。",
      "token_start": 821,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 232940,
      "end_ms": 235285,
      "text": "洞内常年恒温十八度，",
      "token_start": 838,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 235650,
      "end_ms": 236995,
      "text": "您站在地表看，",
      "token_start": 847,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 237350,
      "end_ms": 238990,
      "text": "是石头长成了海。",
      "token_start": 853,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 239210,
      "end_ms": 240210,
      "text": "您钻进地下，",
      "token_start": 860,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 240210,
      "end_ms": 242665,
      "text": "看是石头长成了宫殿。",
      "token_start": 865,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 243590,
      "end_ms": 244935,
      "text": "您说这是景区，",
      "token_start": 874,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 245540,
      "end_ms": 249065,
      "text": "还是老天爷在地上地下各藏了一座宝库？",
      "token_start": 880,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 249960,
      "end_ms": 250685,
      "text": "第七名，",
      "token_start": 897,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 251660,
      "end_ms": 260665,
      "text": "贵州安顺龙宫在贵州安顺这洞最绝的是它是中国第一水溶洞，",
      "token_start": 900,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 261230,
      "end_ms": 262685,
      "text": "全长十五公里，",
      "token_start": 926,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 263010,
      "end_ms": 264905,
      "text": "是中国最长的水溶洞。",
      "token_start": 932,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 265430,
      "end_ms": 267330,
      "text": "水溶洞跟旱洞不一样，",
      "token_start": 941,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 267370,
      "end_ms": 268955,
      "text": "您得坐着船进去，",
      "token_start": 950,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 269640,
      "end_ms": 271005,
      "text": "船在暗河里走。",
      "token_start": 957,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 271790,
      "end_ms": 275505,
      "text": "两边是各种奇形怪状的钟乳石，",
      "token_start": 963,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 276390,
      "end_ms": 279870,
      "text": "头顶上终乳垂悬洞，",
      "token_start": 976,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 279910,
      "end_ms": 282015,
      "text": "里面还藏着一个瀑布，",
      "token_start": 984,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 282780,
      "end_ms": 284595,
      "text": "叫龙门飞瀑。",
      "token_start": 993,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 285090,
      "end_ms": 287340,
      "text": "高五十米宽二十五米，",
      "token_start": 998,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 287500,
      "end_ms": 289605,
      "text": "是中国最大的洞中瀑布。",
      "token_start": 1007,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 290030,
      "end_ms": 294315,
      "text": "天池水从龙门倾泻而下声震山谷。",
      "token_start": 1017,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 294770,
      "end_ms": 295450,
      "text": "您想想，",
      "token_start": 1031,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 295690,
      "end_ms": 297950,
      "text": "在地底下藏着一条河，",
      "token_start": 1034,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 298390,
      "end_ms": 299510,
      "text": "藏着一条瀑布，",
      "token_start": 1043,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 299950,
      "end_ms": 301070,
      "text": "您坐在船上，",
      "token_start": 1049,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 301490,
      "end_ms": 304230,
      "text": "看着瀑布从洞里砸下来。",
      "token_start": 1054,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 304750,
      "end_ms": 305230,
      "text": "您说，",
      "token_start": 1064,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 305230,
      "end_ms": 308370,
      "text": "这是溶洞还是地底下的水帘洞？",
      "token_start": 1066,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 308930,
      "end_ms": 309630,
      "text": "第六名，",
      "token_start": 1079,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 309690,
      "end_ms": 314290,
      "text": "贵州双河洞在贵州绥阳这洞最绝的是它长。",
      "token_start": 1082,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 314770,
      "end_ms": 317150,
      "text": "根据最新发布的科考成果，",
      "token_start": 1100,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 317650,
      "end_ms": 322850,
      "text": "双河洞洞穴系统以探明总长度四百八十一公里，",
      "token_start": 1111,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 323350,
      "end_ms": 326640,
      "text": "是亚洲第一长洞世界第三长洞，",
      "token_start": 1131,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 327180,
      "end_ms": 330000,
      "text": "也是全球最长的白云岩洞穴。",
      "token_start": 1144,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 330580,
      "end_ms": 333240,
      "text": "洞穴系统有上百个洞口，",
      "token_start": 1156,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 333340,
      "end_ms": 334120,
      "text": "相互连通，",
      "token_start": 1166,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 334620,
      "end_ms": 336700,
      "text": "垂直落差九百多米。",
      "token_start": 1170,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 337400,
      "end_ms": 343760,
      "text": "它的长度从一九八七年的十七公里一路刷新到今天的四百八十一公里，",
      "token_start": 1178,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 343980,
      "end_ms": 345680,
      "text": "到现在还没探到头。",
      "token_start": 1208,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 346400,
      "end_ms": 347060,
      "text": "专家说，",
      "token_start": 1216,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 347240,
      "end_ms": 348900,
      "text": "双河洞可能还会更长。",
      "token_start": 1219,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 349200,
      "end_ms": 352260,
      "text": "您想想一个洞探了快四十年，",
      "token_start": 1228,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 352440,
      "end_ms": 355090,
      "text": "还没探完亚洲第一世界。",
      "token_start": 1240,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 355090,
      "end_ms": 355490,
      "text": "第三，",
      "token_start": 1250,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 355670,
      "end_ms": 356975,
      "text": "您说这是溶洞，",
      "token_start": 1252,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 357290,
      "end_ms": 361695,
      "text": "还是地球在贵州底下藏了一条走不完的地下长廊？",
      "token_start": 1258,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 361970,
      "end_ms": 363205,
      "text": "从第十到第六，",
      "token_start": 1279,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 363870,
      "end_ms": 365325,
      "text": "雪玉洞是个小姑娘，",
      "token_start": 1285,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 365900,
      "end_ms": 370195,
      "text": "石花洞有八层楼、天权洞、地上地下都是宝，",
      "token_start": 1293,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 370610,
      "end_ms": 373365,
      "text": "龙宫藏着中国最大的洞中瀑布，",
      "token_start": 1310,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 373880,
      "end_ms": 376455,
      "text": "双河洞是亚洲第一程度，",
      "token_start": 1323,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 377180,
      "end_ms": 379785,
      "text": "可这五个还不是最震撼的。",
      "token_start": 1333,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 380420,
      "end_ms": 382180,
      "text": "接下来第五道第一，",
      "token_start": 1344,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 382380,
      "end_ms": 383745,
      "text": "一个比一个狠，",
      "token_start": 1352,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 384710,
      "end_ms": 389345,
      "text": "有一处地方整条江被一个洞吞进去了。",
      "token_start": 1358,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 390290,
      "end_ms": 394955,
      "text": "有一处地方是中国唯一的世界自然遗产洞穴，",
      "token_start": 1374,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 396010,
      "end_ms": 402845,
      "text": "可他们还不是最狠的、最狠的那个被公认为中国溶洞的终极天花板，",
      "token_start": 1393,
      "token_end_exclusive": 1421
    },
    {
      "start_ms": 403280,
      "end_ms": 406755,
      "text": "肚子里锁着好几件天下独一份的地下之宝。",
      "token_start": 1421,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 407280,
      "end_ms": 411055,
      "text": "凡是亲眼见过的人出来都只剩一句话，",
      "token_start": 1439,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 411550,
      "end_ms": 414085,
      "text": "看过了它别的洞再入不了眼，",
      "token_start": 1455,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 414420,
      "end_ms": 415100,
      "text": "他是哪儿，",
      "token_start": 1467,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 415120,
      "end_ms": 416640,
      "text": "他凭什么排第一，",
      "token_start": 1471,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 416940,
      "end_ms": 418660,
      "text": "下集马上更新，",
      "token_start": 1478,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 419120,
      "end_ms": 420800,
      "text": "您先点个关注点，",
      "token_start": 1484,
      "token_end_exclusive": 1491
    },
    {
      "start_ms": 420800,
      "end_ms": 422195,
      "text": "开头像别走丢。",
      "token_start": 1491,
      "token_end_exclusive": 1497
    }
  ],
