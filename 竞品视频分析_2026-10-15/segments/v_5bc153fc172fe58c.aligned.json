  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_5bc153fc172fe58c.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1090,
      "text": "私下给你提个醒，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1390,
      "end_ms": 3270,
      "text": "最近有人跑我这儿打你小报告。",
      "token_start": 7,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 3610,
      "end_ms": 5130,
      "text": "领导相比于谁说坏话，",
      "token_start": 20,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 5190,
      "end_ms": 6610,
      "text": "我更在意怎样把工作做好。",
      "token_start": 29,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 6690,
      "end_ms": 7390,
      "text": "如果是我的问题，",
      "token_start": 40,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 7390,
      "end_ms": 7930,
      "text": "我马上改，",
      "token_start": 47,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 8010,
      "end_ms": 8710,
      "text": "如果没问题，",
      "token_start": 51,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 8750,
      "end_ms": 9850,
      "text": "非常感谢您的信任。",
      "token_start": 56,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 10110,
      "end_ms": 13330,
      "text": "大家都看看小王这个月业绩做的这么好，",
      "token_start": 64,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 14230,
      "end_ms": 15230,
      "text": "谢谢领导夸奖。",
      "token_start": 81,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 15450,
      "end_ms": 16610,
      "text": "那都是我们的产品好，",
      "token_start": 87,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 16630,
      "end_ms": 17210,
      "text": "团队强，",
      "token_start": 96,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 17310,
      "end_ms": 18530,
      "text": "客户才会放心下单。",
      "token_start": 99,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 19950,
      "end_ms": 22010,
      "text": "看你手头这进度干活，",
      "token_start": 107,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 22010,
      "end_ms": 23910,
      "text": "怎么比乌龟还慢慢俗，",
      "token_start": 116,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 23910,
      "end_ms": 25470,
      "text": "俗说慢慢出细题吗？",
      "token_start": 125,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 25850,
      "end_ms": 27330,
      "text": "我细致对待每一个项目，",
      "token_start": 133,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 27530,
      "end_ms": 29550,
      "text": "不就避免了以后出现质量问题吗？",
      "token_start": 143,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 29610,
      "end_ms": 32860,
      "text": "上次交代的那个重点项目现在推进的怎么样了？",
      "token_start": 157,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 33000,
      "end_ms": 34420,
      "text": "领导第一阶段已完成，",
      "token_start": 177,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 34580,
      "end_ms": 36100,
      "text": "目前正处于复核阶段，",
      "token_start": 186,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 36300,
      "end_ms": 37920,
      "text": "预计本周内能够全部交到。",
      "token_start": 195,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 37920,
      "end_ms": 38360,
      "text": "您手上。",
      "token_start": 206,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 38460,
      "end_ms": 39680,
      "text": "给你转了一千多的，",
      "token_start": 209,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 39680,
      "end_ms": 41340,
      "text": "就当你跑腿的小辛苦费了啊，",
      "token_start": 217,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 41400,
      "end_ms": 41720,
      "text": "领导，",
      "token_start": 229,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 41720,
      "end_ms": 42400,
      "text": "您太客气了，",
      "token_start": 231,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 42400,
      "end_ms": 43160,
      "text": "水果没多少钱，",
      "token_start": 236,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 43360,
      "end_ms": 44640,
      "text": "您平时对我们这么照顾，",
      "token_start": 242,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 44660,
      "end_ms": 47460,
      "text": "帮您买水果是我应该做的多的钱我不能收我，",
      "token_start": 252,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 47460,
      "end_ms": 48420,
      "text": "这就给您退回去。",
      "token_start": 271,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 48440,
      "end_ms": 48840,
      "text": "小王，",
      "token_start": 278,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 49120,
      "end_ms": 49620,
      "text": "早餐钱，",
      "token_start": 280,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 49620,
      "end_ms": 50560,
      "text": "我微信转给你了，",
      "token_start": 283,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 50560,
      "end_ms": 51460,
      "text": "你赶紧接收一下。",
      "token_start": 290,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 51560,
      "end_ms": 51840,
      "text": "领导，",
      "token_start": 297,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 51840,
      "end_ms": 52600,
      "text": "您太客气了，",
      "token_start": 299,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 52600,
      "end_ms": 53760,
      "text": "这都是我顺手的事儿，",
      "token_start": 304,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 53800,
      "end_ms": 54880,
      "text": "本来不应该收的，",
      "token_start": 313,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 54880,
      "end_ms": 56620,
      "text": "但是怕您下次有事就不找我了，",
      "token_start": 320,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 56660,
      "end_ms": 58420,
      "text": "所以我就恭敬不如从命了。",
      "token_start": 333,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 58900,
      "end_ms": 60370,
      "text": "小餐方案思路很清析，",
      "token_start": 344,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 60710,
      "end_ms": 61625,
      "text": "这次干的不错嘛，",
      "token_start": 353,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 61900,
      "end_ms": 62685,
      "text": "谢谢领导的夸奖，",
      "token_start": 360,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 62940,
      "end_ms": 64520,
      "text": "都是因为有您的指导和提点，",
      "token_start": 367,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 64520,
      "end_ms": 65660,
      "text": "我才能取得这样的结果。",
      "token_start": 379,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 65740,
      "end_ms": 67300,
      "text": "接下来我一定会加倍努力，",
      "token_start": 389,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 67320,
      "end_ms": 68015,
      "text": "不让您失望。",
      "token_start": 400,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 68300,
      "end_ms": 69625,
      "text": "你看这报告里的数据，",
      "token_start": 405,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 69890,
      "end_ms": 70970,
      "text": "这块细节怎么没做好，",
      "token_start": 414,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 71210,
      "end_ms": 72295,
      "text": "确实是我的问题，",
      "token_start": 423,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 72500,
      "end_ms": 73725,
      "text": "是我高估了自己的能力，",
      "token_start": 430,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 74080,
      "end_ms": 76320,
      "text": "后续的补救措施我已经拟好这事儿，",
      "token_start": 440,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 76320,
      "end_ms": 78000,
      "text": "还要靠领导继续为我们掌舵。",
      "token_start": 455,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 78220,
      "end_ms": 79745,
      "text": "你看你这脾气太毛躁，",
      "token_start": 467,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 80080,
      "end_ms": 81185,
      "text": "干不了大事啊。",
      "token_start": 476,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 81480,
      "end_ms": 82245,
      "text": "领导说的对，",
      "token_start": 482,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 82600,
      "end_ms": 82900,
      "text": "大事，",
      "token_start": 487,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 82900,
      "end_ms": 84060,
      "text": "您来做小事，",
      "token_start": 489,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 84060,
      "end_ms": 84665,
      "text": "我分担，",
      "token_start": 494,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 85060,
      "end_ms": 86260,
      "text": "我把小事做到极致，",
      "token_start": 497,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 86380,
      "end_ms": 87255,
      "text": "祝您成大事。",
      "token_start": 505,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 88160,
      "end_ms": 89675,
      "text": "这个核心项目交给你了，",
      "token_start": 510,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 90070,
      "end_ms": 91195,
      "text": "我对你期望很高啊，",
      "token_start": 520,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 91980,
      "end_ms": 93445,
      "text": "感谢领导的关心与信任。",
      "token_start": 528,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 93750,
      "end_ms": 93910,
      "text": "有，",
      "token_start": 538,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 93910,
      "end_ms": 95130,
      "text": "您在前面指点导航，",
      "token_start": 539,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 95190,
      "end_ms": 96155,
      "text": "我心里就有底了，",
      "token_start": 547,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 96480,
      "end_ms": 98120,
      "text": "一定全力以赴把项目拿下。",
      "token_start": 554,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 98200,
      "end_ms": 98600,
      "text": "小李，",
      "token_start": 565,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 98680,
      "end_ms": 99835,
      "text": "最近表现不错啊，",
      "token_start": 567,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 100120,
      "end_ms": 101685,
      "text": "我这个位置马上就该你坐了。",
      "token_start": 574,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 102660,
      "end_ms": 103380,
      "text": "听这意思，",
      "token_start": 586,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 103380,
      "end_ms": 103700,
      "text": "领导，",
      "token_start": 590,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 103700,
      "end_ms": 105060,
      "text": "您这是又要高升了呀，",
      "token_start": 592,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 105060,
      "end_ms": 106255,
      "text": "那我得提前敬您一杯。",
      "token_start": 601,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 106500,
      "end_ms": 108770,
      "text": "哈哈哈小王啊，",
      "token_start": 610,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 108910,
      "end_ms": 109870,
      "text": "看你今天喝不少，",
      "token_start": 616,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 109890,
      "end_ms": 110810,
      "text": "你这酒量挺好的。",
      "token_start": 623,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 110810,
      "end_ms": 111720,
      "text": "呀张总，",
      "token_start": 630,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 111800,
      "end_ms": 112640,
      "text": "您可抬举我了，",
      "token_start": 633,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 112640,
      "end_ms": 113725,
      "text": "我平时真不太能喝，",
      "token_start": 639,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 113940,
      "end_ms": 115260,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 647,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 115260,
      "end_ms": 115760,
      "text": "高兴啊，",
      "token_start": 658,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 115760,
      "end_ms": 117160,
      "text": "这一高兴酒量就涨了，",
      "token_start": 661,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 117160,
      "end_ms": 118260,
      "text": "所以就多贪了几杯。",
      "token_start": 670,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 118280,
      "end_ms": 118860,
      "text": "小李啊，",
      "token_start": 678,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 119080,
      "end_ms": 121415,
      "text": "来这么晚只能给我们吃剩菜了吧。",
      "token_start": 681,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 121760,
      "end_ms": 122140,
      "text": "李总，",
      "token_start": 695,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 122300,
      "end_ms": 123340,
      "text": "饭在哪儿我都能吃，",
      "token_start": 697,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 123460,
      "end_ms": 125220,
      "text": "但您这桌可不是谁想做就能做的，",
      "token_start": 705,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 125220,
      "end_ms": 126785,
      "text": "能赶上吃就已经是我运气了。",
      "token_start": 719,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 127110,
      "end_ms": 127535,
      "text": "哈哈哈。",
      "token_start": 731,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 128290,
      "end_ms": 129035,
      "text": "关注我，",
      "token_start": 734,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 129470,
      "end_ms": 131190,
      "text": "每天学点高情商，",
      "token_start": 737,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 131310,
      "end_ms": 132305,
      "text": "说话技巧，",
      "token_start": 744,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 132770,
      "end_ms": 135165,
      "text": "让你的路越走越宽。",
      "token_start": 748,
      "token_end_exclusive": 756
    }
  ],
