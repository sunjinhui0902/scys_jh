{
  "video_id": "v_209edbff0b6b4db9",
  "duration_s": 378.531995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_209edbff0b6b4db9.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_209edbff0b6b4db9.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 4290,
      "text": "你知道中国历史上哪个朝代丢掉的领土最多吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5030,
      "end_ms": 7290,
      "text": "相信很多人第一反应是，",
      "token_start": 20,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7290,
      "end_ms": 10210,
      "text": "清朝签了那么多不平等条约，",
      "token_start": 30,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 10390,
      "end_ms": 16850,
      "text": "丢了外东北丢了台湾丢了香港丢了澳门是中国人最熟悉的朝代。",
      "token_start": 42,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 17650,
      "end_ms": 17890,
      "text": "错，",
      "token_start": 69,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 18210,
      "end_ms": 20210,
      "text": "真要论起丢地的数量，",
      "token_start": 70,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 20690,
      "end_ms": 23310,
      "text": "清朝连前三都进不去。",
      "token_start": 79,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 24090,
      "end_ms": 29785,
      "text": "今天咱们就来盘点中国十大丢失领土最多的朝代。",
      "token_start": 88,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 30220,
      "end_ms": 32020,
      "text": "先讲第十到第六，",
      "token_start": 109,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 32520,
      "end_ms": 34660,
      "text": "一个比一个让人心疼。",
      "token_start": 116,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 35280,
      "end_ms": 39800,
      "text": "老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 125,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 40100,
      "end_ms": 42920,
      "text": "让我看看都是谁在听。",
      "token_start": 142,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 43340,
      "end_ms": 44060,
      "text": "第十名，",
      "token_start": 151,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 44480,
      "end_ms": 47460,
      "text": "秦朝秦始皇统一六国，",
      "token_start": 154,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 47980,
      "end_ms": 50340,
      "text": "又派蒙恬带三十万大军，",
      "token_start": 163,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 50580,
      "end_ms": 51480,
      "text": "北击匈奴，",
      "token_start": 173,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 51760,
      "end_ms": 52560,
      "text": "收复河套，",
      "token_start": 177,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 53160,
      "end_ms": 54220,
      "text": "设了九原郡，",
      "token_start": 181,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 54560,
      "end_ms": 55540,
      "text": "南征百越，",
      "token_start": 186,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 55800,
      "end_ms": 56620,
      "text": "打了三次，",
      "token_start": 190,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 56960,
      "end_ms": 58600,
      "text": "设了桂林南海，",
      "token_start": 194,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 58640,
      "end_ms": 59140,
      "text": "相郡，",
      "token_start": 200,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 59520,
      "end_ms": 62715,
      "text": "把江当裕推到了三百四十万平方公里，",
      "token_start": 202,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 63190,
      "end_ms": 64675,
      "text": "可秦朝太短了，",
      "token_start": 218,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 65010,
      "end_ms": 66555,
      "text": "统一十五年就完了。",
      "token_start": 224,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 67120,
      "end_ms": 68185,
      "text": "秦二世昏庸，",
      "token_start": 232,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 68450,
      "end_ms": 69275,
      "text": "赵高专权，",
      "token_start": 237,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 69620,
      "end_ms": 70505,
      "text": "天下大乱，",
      "token_start": 241,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 70980,
      "end_ms": 72205,
      "text": "陈胜吴广一闹，",
      "token_start": 245,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 72670,
      "end_ms": 76110,
      "text": "北方的匈奴头曼单于趁机南下河套，",
      "token_start": 251,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 76110,
      "end_ms": 77045,
      "text": "又抢回去了。",
      "token_start": 266,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 78030,
      "end_ms": 80440,
      "text": "南边的赵佗也封官爵道，",
      "token_start": 271,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 80640,
      "end_ms": 81255,
      "text": "独立了，",
      "token_start": 281,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 82100,
      "end_ms": 83295,
      "text": "建了南越国。",
      "token_start": 284,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 84120,
      "end_ms": 86305,
      "text": "秦朝从统一到灭亡，",
      "token_start": 289,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 86810,
      "end_ms": 89375,
      "text": "前后丢了将近五十万平方公里。",
      "token_start": 297,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 90760,
      "end_ms": 92745,
      "text": "一个刚刚统一的王朝，",
      "token_start": 310,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 93190,
      "end_ms": 94745,
      "text": "还没捂热就散了，",
      "token_start": 319,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 95790,
      "end_ms": 98015,
      "text": "您说这是可惜还是命短？",
      "token_start": 326,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 99110,
      "end_ms": 103260,
      "text": "第九名隋朝隋文帝统一，",
      "token_start": 336,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 103260,
      "end_ms": 106145,
      "text": "南北又击败突厥控制核套，",
      "token_start": 346,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 107190,
      "end_ms": 110855,
      "text": "隋炀帝一度亲自带兵征服了屠骨魂，",
      "token_start": 357,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 111260,
      "end_ms": 112105,
      "text": "打到青海，",
      "token_start": 372,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 112430,
      "end_ms": 116445,
      "text": "设了西海和源善善且末四个郡，",
      "token_start": 376,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 116690,
      "end_ms": 119435,
      "text": "版图推到了四百六十万平方公里。",
      "token_start": 389,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 120200,
      "end_ms": 121600,
      "text": "可隋炀帝太急了，",
      "token_start": 403,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 121760,
      "end_ms": 125920,
      "text": "修大运河三征高巨丽死了几十万人，",
      "token_start": 410,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 126160,
      "end_ms": 127520,
      "text": "把国力耗干了，",
      "token_start": 425,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 128360,
      "end_ms": 130520,
      "text": "突厥又强大起来。",
      "token_start": 431,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 130880,
      "end_ms": 133340,
      "text": "史必可汗带兵包围雁门关。",
      "token_start": 438,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 134040,
      "end_ms": 135480,
      "text": "隋炀帝差点被抓，",
      "token_start": 449,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 136360,
      "end_ms": 138300,
      "text": "河套平原再次沦陷。",
      "token_start": 456,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 139100,
      "end_ms": 141960,
      "text": "吐谷浑的四个郡没几年也丢了。",
      "token_start": 464,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 142680,
      "end_ms": 144000,
      "text": "隋朝一共丢了，",
      "token_start": 477,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 144000,
      "end_ms": 145960,
      "text": "大约一百万平方公里，",
      "token_start": 483,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 146260,
      "end_ms": 147160,
      "text": "三十七年，",
      "token_start": 492,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 148360,
      "end_ms": 152500,
      "text": "一个短命王朝把家底赔了个精光。",
      "token_start": 496,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 153660,
      "end_ms": 154420,
      "text": "第八名，",
      "token_start": 510,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 154780,
      "end_ms": 160420,
      "text": "宋朝北宋疆域两百八十万平方公里，",
      "token_start": 513,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 160420,
      "end_ms": 163040,
      "text": "是历代大一统王朝里最小的。",
      "token_start": 528,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 163280,
      "end_ms": 164000,
      "text": "为什么小？",
      "token_start": 540,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 164280,
      "end_ms": 165960,
      "text": "因为燕云十六州丢了，",
      "token_start": 544,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 166140,
      "end_ms": 167580,
      "text": "那是长城防线，",
      "token_start": 553,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 168020,
      "end_ms": 173380,
      "text": "没了燕云北方门户大开可就是这两百八十万也没守住。",
      "token_start": 559,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 174360,
      "end_ms": 179555,
      "text": "金兵南下金兵之变徽清二帝被俘，",
      "token_start": 582,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 180240,
      "end_ms": 182465,
      "text": "三千多人被押到东北。",
      "token_start": 596,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 183320,
      "end_ms": 185615,
      "text": "北宋灭亡赵构，",
      "token_start": 605,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 185880,
      "end_ms": 188525,
      "text": "跑到江南建立南宋，",
      "token_start": 611,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 188810,
      "end_ms": 190605,
      "text": "只剩两百万平方公里，",
      "token_start": 619,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 191240,
      "end_ms": 192705,
      "text": "北方全部丢了，",
      "token_start": 628,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 193000,
      "end_ms": 194875,
      "text": "将近八十万平方公里。",
      "token_start": 634,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 195300,
      "end_ms": 199055,
      "text": "燕云十六州从后晋哥给契丹开始，",
      "token_start": 643,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 199370,
      "end_ms": 202355,
      "text": "到明朝才收回来丢了四百多年。",
      "token_start": 657,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 202840,
      "end_ms": 203945,
      "text": "岳飞想收复，",
      "token_start": 670,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 204390,
      "end_ms": 207205,
      "text": "被十二道金牌召回秦桧害死，",
      "token_start": 675,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 207890,
      "end_ms": 209765,
      "text": "从此没人再提北伐。",
      "token_start": 687,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 210170,
      "end_ms": 211745,
      "text": "宋朝重文轻武，",
      "token_start": 695,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 212090,
      "end_ms": 213825,
      "text": "有钱有文化，",
      "token_start": 701,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 215370,
      "end_ms": 216355,
      "text": "就是打不了仗。",
      "token_start": 706,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 216820,
      "end_ms": 218945,
      "text": "您说这是教训还是悲哀？",
      "token_start": 712,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 220050,
      "end_ms": 224025,
      "text": "第七名汉朝西汉鼎盛时期，",
      "token_start": 722,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 224370,
      "end_ms": 226475,
      "text": "六百零九万平方公里，",
      "token_start": 733,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 227360,
      "end_ms": 230265,
      "text": "汉武帝北伐匈奴收复核套，",
      "token_start": 742,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 230550,
      "end_ms": 234875,
      "text": "拿下河西走廊经营西域设西域都护府，",
      "token_start": 753,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 235640,
      "end_ms": 238240,
      "text": "可到了东汉后期西域都护府，",
      "token_start": 769,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 238260,
      "end_ms": 240100,
      "text": "放弃了改设西域，",
      "token_start": 781,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 240100,
      "end_ms": 241380,
      "text": "长使府西域，",
      "token_start": 788,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 241420,
      "end_ms": 244310,
      "text": "逐渐脱离控制班超经营。",
      "token_start": 793,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 244310,
      "end_ms": 244885,
      "text": "三十年，",
      "token_start": 803,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 245110,
      "end_ms": 246315,
      "text": "儿子班勇接着干，",
      "token_start": 806,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 247180,
      "end_ms": 248255,
      "text": "三绝三通，",
      "token_start": 813,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 248510,
      "end_ms": 249535,
      "text": "可国力不行了，",
      "token_start": 817,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 249780,
      "end_ms": 250845,
      "text": "西域还是丢了。",
      "token_start": 823,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 251850,
      "end_ms": 252615,
      "text": "东北那边，",
      "token_start": 829,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 253870,
      "end_ms": 256755,
      "text": "高句丽强大起来慢慢蚕食。",
      "token_start": 833,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 257220,
      "end_ms": 264985,
      "text": "汉四郡热浪悬戳真翻林屯一个一个丢两处加起来，",
      "token_start": 844,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 265590,
      "end_ms": 269755,
      "text": "汉朝后期一共丢了大约两百万平方公里，",
      "token_start": 865,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 270730,
      "end_ms": 273105,
      "text": "一个打出了汉族名字的王朝。",
      "token_start": 882,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 273680,
      "end_ms": 274080,
      "text": "最后，",
      "token_start": 894,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 274160,
      "end_ms": 276325,
      "text": "连自己打下来的地盘都守不住。",
      "token_start": 896,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 277710,
      "end_ms": 278315,
      "text": "第六名，",
      "token_start": 909,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 279600,
      "end_ms": 282770,
      "text": "西晋西晋统一三国，",
      "token_start": 912,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 282950,
      "end_ms": 285515,
      "text": "疆域五百四十多万平方公里，",
      "token_start": 920,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 286450,
      "end_ms": 290185,
      "text": "可西晋是历史上出了名的乱八王之乱。",
      "token_start": 932,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 290860,
      "end_ms": 294120,
      "text": "司马家族自己打自己人打了十六年，",
      "token_start": 948,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 294320,
      "end_ms": 295365,
      "text": "死了几十万人，",
      "token_start": 963,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 296030,
      "end_ms": 297165,
      "text": "打的国力空虚。",
      "token_start": 969,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 297510,
      "end_ms": 300635,
      "text": "北方的匈奴鲜卑结。",
      "token_start": 975,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 301130,
      "end_ms": 302850,
      "text": "羌五个少数民族，",
      "token_start": 983,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 303090,
      "end_ms": 304050,
      "text": "趁乱南下，",
      "token_start": 990,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 304770,
      "end_ms": 305310,
      "text": "匈奴，",
      "token_start": 994,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 305350,
      "end_ms": 308970,
      "text": "刘渊起兵称汉帝石勒亡迷，",
      "token_start": 996,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 309910,
      "end_ms": 311390,
      "text": "各路豪杰勇，",
      "token_start": 1007,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 311410,
      "end_ms": 315670,
      "text": "加之乱洛阳丢了淮帝被俘长安，",
      "token_start": 1012,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 315710,
      "end_ms": 317290,
      "text": "丢了朝帝投降。",
      "token_start": 1025,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 317630,
      "end_ms": 318530,
      "text": "西晋灭亡，",
      "token_start": 1031,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 319350,
      "end_ms": 320630,
      "text": "北方全部沦陷，",
      "token_start": 1035,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 321350,
      "end_ms": 322730,
      "text": "东晋退到江南，",
      "token_start": 1041,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 322850,
      "end_ms": 325170,
      "text": "只剩三百来万平方公里。",
      "token_start": 1047,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 325970,
      "end_ms": 327510,
      "text": "西晋丢掉了北方，",
      "token_start": 1057,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 327790,
      "end_ms": 330595,
      "text": "将近两百五十万平方公里，",
      "token_start": 1064,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 331310,
      "end_ms": 332350,
      "text": "汉人难逃，",
      "token_start": 1075,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 332670,
      "end_ms": 334430,
      "text": "史称衣冠难渡，",
      "token_start": 1079,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 334730,
      "end_ms": 336410,
      "text": "从此南北分裂。",
      "token_start": 1085,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 337070,
      "end_ms": 340250,
      "text": "您说这是内乱还是自毁长城？",
      "token_start": 1091,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 340810,
      "end_ms": 342210,
      "text": "从第十到第六，",
      "token_start": 1103,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 342710,
      "end_ms": 344250,
      "text": "秦朝丢了五十万，",
      "token_start": 1109,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 344670,
      "end_ms": 346230,
      "text": "西晋丢了八百万，",
      "token_start": 1116,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 346490,
      "end_ms": 347970,
      "text": "宋朝丢了八十万，",
      "token_start": 1123,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 348270,
      "end_ms": 349690,
      "text": "隋朝丢了两百万，",
      "token_start": 1130,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 350070,
      "end_ms": 352630,
      "text": "西晋丢了两百五十万可，",
      "token_start": 1137,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 352630,
      "end_ms": 355430,
      "text": "这五个还不是丢的最多的。",
      "token_start": 1147,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 355670,
      "end_ms": 357230,
      "text": "接下来第五到第一，",
      "token_start": 1158,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 357530,
      "end_ms": 358670,
      "text": "一个比一个狠。",
      "token_start": 1166,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 358910,
      "end_ms": 361765,
      "text": "有一个朝代丢了六百万平方公里，",
      "token_start": 1172,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 362280,
      "end_ms": 364460,
      "text": "有一个朝代号称不和亲，",
      "token_start": 1186,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 364560,
      "end_ms": 365100,
      "text": "不纳贡，",
      "token_start": 1196,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 365160,
      "end_ms": 365845,
      "text": "不割地，",
      "token_start": 1199,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 366480,
      "end_ms": 368595,
      "text": "可实际上丢的比谁都多。",
      "token_start": 1202,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 369370,
      "end_ms": 370075,
      "text": "他是哪个？",
      "token_start": 1212,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 370340,
      "end_ms": 371595,
      "text": "他凭什么排第一，",
      "token_start": 1216,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 371950,
      "end_ms": 373485,
      "text": "下集马上更新，",
      "token_start": 1223,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 373940,
      "end_ms": 375400,
      "text": "您先点个关注点，",
      "token_start": 1229,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 375400,
      "end_ms": 378365,
      "text": "开头像别走丢。",
      "token_start": 1236,
      "token_end_exclusive": 1242
    }
