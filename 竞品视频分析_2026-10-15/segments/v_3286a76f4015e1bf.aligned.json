      "end_ms": 6450,
      "text": "你就拿上一面镜子，",
      "token_start": 28,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 6550,
      "end_ms": 8770,
      "text": "看一看自己的头发就知道了。",
      "token_start": 36,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 8910,
      "end_ms": 10210,
      "text": "如果你的白头发变多，",
      "token_start": 48,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 10250,
      "end_ms": 11230,
      "text": "发际线后移，",
      "token_start": 57,
      "token_end_exclusive": 62
    },
    {
