  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2730,
      "text": "如何看出一个女人的身体到底好不好？",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 2950,
      "end_ms": 4230,
      "text": "其实古人早有答案，",
      "token_start": 16,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 4470,
      "end_ms": 5130,
      "text": "此时此刻，",
      "token_start": 24,
      "token_end_exclusive": 28
    },
    {
