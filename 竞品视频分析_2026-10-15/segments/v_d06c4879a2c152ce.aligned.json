  "segments": [
    {
      "start_ms": 310,
      "end_ms": 2010,
      "text": "从退休到生命的终结，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2310,
      "end_ms": 4050,
      "text": "平均时光也就二十年。",
      "token_start": 9,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4610,
      "end_ms": 7050,
      "text": "那么真正的好时光有多少呢？",
      "token_start": 18,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7630,
      "end_ms": 8790,
      "text": "其实也就十年，",
      "token_start": 30,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 9230,
      "end_ms": 12790,
      "text": "也就是你从六十岁到七十岁的这段时间，",
      "token_start": 36,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13510,
      "end_ms": 16070,
      "text": "这是你一生中唯一一段既有点钱，",
      "token_start": 53,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 16370,
      "end_ms": 17070,
      "text": "既有点闲，",
      "token_start": 67,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 17390,
      "end_ms": 18830,
      "text": "还有点经历的时光。",
      "token_start": 71,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 19550,
      "end_ms": 20690,
      "text": "从这个角度讲啊，",
      "token_start": 79,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 20710,
      "end_ms": 23670,
      "text": "这也是你人生中一段最美好的时光。",
      "token_start": 86,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 24490,
      "end_ms": 25770,
      "text": "所以啊莫等闲，",
      "token_start": 101,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 26190,
      "end_ms": 27030,
      "text": "有什么遗憾，",
      "token_start": 107,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 27190,
      "end_ms": 28350,
      "text": "就抓紧去弥补，",
      "token_start": 112,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 28550,
      "end_ms": 30000,
      "text": "有什么愿望就改，",
      "token_start": 118,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 30060,
      "end_ms": 31060,
      "text": "赶紧去实现。",
      "token_start": 125,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 31620,
      "end_ms": 32380,
      "text": "你要记住，",
      "token_start": 130,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 32520,
      "end_ms": 34300,
      "text": "健康不是退休后的福利，",
      "token_start": 134,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 34480,
      "end_ms": 37760,
      "text": "而是你退休前一堂又一堂的必修课。",
      "token_start": 144,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 38480,
      "end_ms": 39500,
      "text": "人生不过三万，",
      "token_start": 159,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 39500,
      "end_ms": 41820,
      "text": "天能过好一天是一天。",
      "token_start": 165,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 42060,
      "end_ms": 42960,
      "text": "从现在开始，",
      "token_start": 174,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 43180,
      "end_ms": 44940,
      "text": "在你力所能及的范围之内，",
      "token_start": 179,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 45220,
      "end_ms": 46060,
      "text": "想吃就吃，",
      "token_start": 190,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 46240,
      "end_ms": 47020,
      "text": "想喝就喝，",
      "token_start": 194,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 47380,
      "end_ms": 48400,
      "text": "想玩就去玩，",
      "token_start": 198,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 48800,
      "end_ms": 51275,
      "text": "因为余生并不多。",
      "token_start": 203,
      "token_end_exclusive": 210
    }
