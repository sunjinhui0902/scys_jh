{
  "video_id": "v_6d23100c98e5cd9d",
  "duration_s": 214.645011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_6d23100c98e5cd9d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_6d23100c98e5cd9d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 3270,
      "text": "朱今一定要研究一个人就能干的生意，",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3690,
      "end_ms": 5130,
      "text": "利润最高的赛道，",
      "token_start": 16,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5310,
      "end_ms": 8550,
      "text": "就是你自己未来大部分公司都将消失，",
      "token_start": 23,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 8670,
      "end_ms": 11470,
      "text": "以后一定是超级个体和艺人公司的趋势。",
      "token_start": 39,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 11530,
      "end_ms": 13470,
      "text": "这家OPC one person company,",
      "token_start": 56,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 13850,
      "end_ms": 14770,
      "text": "这可不是概念，",
      "token_start": 62,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 14830,
      "end_ms": 16309,
      "text": "是正在发生的事实。",
      "token_start": 68,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 16570,
      "end_ms": 17390,
      "text": "就在九月初，",
      "token_start": 76,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 17410,
      "end_ms": 19190,
      "text": "AI酵母李飞飞放了一个大招，",
      "token_start": 81,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 19210,
      "end_ms": 21470,
      "text": "发布了全球首个多模态事件模型。",
      "token_start": 93,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 21770,
      "end_ms": 22410,
      "text": "什么概念？",
      "token_start": 107,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 22610,
      "end_ms": 25830,
      "text": "需要几十个团队耗时数月的场景搭建工作，",
      "token_start": 111,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 25850,
      "end_ms": 32080,
      "text": "一个单人就能在极短时间内完成一个会用AI的人产出比一个公司还要高。",
      "token_start": 129,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 32600,
      "end_ms": 35620,
      "text": "周军请相信你自己就是一家公司。",
      "token_start": 160,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 35900,
      "end_ms": 36520,
      "text": "什么意思？",
      "token_start": 174,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 36680,
      "end_ms": 38680,
      "text": "过去你想创业要招设计，",
      "token_start": 178,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 38700,
      "end_ms": 41060,
      "text": "客服、程序员、财务运营等等等等，",
      "token_start": 188,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 41240,
      "end_ms": 43940,
      "text": "钱还没有赚到工资先发出去了几十万。",
      "token_start": 201,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 44440,
      "end_ms": 46740,
      "text": "而现在呢AI可以给你写方案，",
      "token_start": 217,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 46780,
      "end_ms": 47340,
      "text": "写代码，",
      "token_start": 229,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 47340,
      "end_ms": 48240,
      "text": "做数据分析。",
      "token_start": 232,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 49020,
      "end_ms": 52080,
      "text": "以前一个普通人最大的问题是我有很多想法，",
      "token_start": 237,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 52220,
      "end_ms": 52920,
      "text": "但我没人。",
      "token_start": 256,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 53240,
      "end_ms": 55060,
      "text": "而未来这句话可能不存在了。",
      "token_start": 260,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 55080,
      "end_ms": 55840,
      "text": "你没有团队，",
      "token_start": 272,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 55960,
      "end_ms": 56340,
      "text": "AI,",
      "token_start": 277,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 56340,
      "end_ms": 57220,
      "text": "就是你的团队。",
      "token_start": 278,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 57400,
      "end_ms": 58300,
      "text": "你没有办公室，",
      "token_start": 284,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 58420,
      "end_ms": 59945,
      "text": "一台电脑就是你的办公室。",
      "token_start": 290,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 60350,
      "end_ms": 61550,
      "text": "你没有几十号员工，",
      "token_start": 301,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 61750,
      "end_ms": 64845,
      "text": "你一个人就可以指挥几十个AI智能体同时工作。",
      "token_start": 309,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 65250,
      "end_ms": 67445,
      "text": "所以未来会出现一种非常恐怖的竞争。",
      "token_start": 329,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 67710,
      "end_ms": 69710,
      "text": "一个会用AI的人开始挑战，",
      "token_start": 345,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 69710,
      "end_ms": 71110,
      "text": "一个不会用AI的团队。",
      "token_start": 356,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 71350,
      "end_ms": 73755,
      "text": "所以请你认真的从现在开始，",
      "token_start": 365,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 73980,
      "end_ms": 75680,
      "text": "把你自己想象成一家公司，",
      "token_start": 377,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 75800,
      "end_ms": 77915,
      "text": "一家名为你的有限公司，",
      "token_start": 388,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 78310,
      "end_ms": 81430,
      "text": "你的时间、精力、情绪、智慧、健康，",
      "token_start": 398,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 81510,
      "end_ms": 82250,
      "text": "甚至美貌，",
      "token_start": 410,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 82390,
      "end_ms": 84265,
      "text": "就是这家公司核心的资产。",
      "token_start": 414,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 84760,
      "end_ms": 88135,
      "text": "当你开始用这种资本的眼光来审视自己的人生的时候，",
      "token_start": 425,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 88360,
      "end_ms": 93015,
      "text": "那些曾经让你痛苦、纠结内耗的人和事儿会瞬间变得清新明雅，",
      "token_start": 448,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 93430,
      "end_ms": 94490,
      "text": "你不是变得无情，",
      "token_start": 474,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 94490,
      "end_ms": 95465,
      "text": "而是变得清醒。",
      "token_start": 481,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 95850,
      "end_ms": 98670,
      "text": "但朱军你千万不要误以为你会用AI了，",
      "token_start": 487,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 98670,
      "end_ms": 100435,
      "text": "你就能变成这种超级个体。",
      "token_start": 503,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 100790,
      "end_ms": 102445,
      "text": "因为AI有一个残酷的特点，",
      "token_start": 514,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 102760,
      "end_ms": 104115,
      "text": "他不负责让你变优秀，",
      "token_start": 525,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 104360,
      "end_ms": 106175,
      "text": "他负责把你的特点放大。",
      "token_start": 534,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 106570,
      "end_ms": 107385,
      "text": "比如你有审美，",
      "token_start": 544,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 107600,
      "end_ms": 109255,
      "text": "他会把你的审美放在一百倍。",
      "token_start": 550,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 109550,
      "end_ms": 111270,
      "text": "但如果你脑子里什么都没有，",
      "token_start": 562,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 111310,
      "end_ms": 112930,
      "text": "他放大的就是你的平庸。",
      "token_start": 574,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 113150,
      "end_ms": 113990,
      "text": "在艺人公司，",
      "token_start": 584,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 113990,
      "end_ms": 114830,
      "text": "你要面对的现实，",
      "token_start": 589,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 114830,
      "end_ms": 116995,
      "text": "就是你既是老板也是员工，",
      "token_start": 596,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 117290,
      "end_ms": 118530,
      "text": "没有人安排你的工作，",
      "token_start": 607,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 118650,
      "end_ms": 120705,
      "text": "你要独立判断什么是有价值的。",
      "token_start": 616,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 120980,
      "end_ms": 121220,
      "text": "所以，",
      "token_start": 629,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 121220,
      "end_ms": 123160,
      "text": "未来最可怕的不是慧慧用AI,",
      "token_start": 631,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 123160,
      "end_ms": 126555,
      "text": "而是你突然发现自己根本没有值得AI放大的东西。",
      "token_start": 643,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 126860,
      "end_ms": 129700,
      "text": "这种艺人公司如果能做成功的前提只有一个，",
      "token_start": 664,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 129700,
      "end_ms": 132425,
      "text": "那就是你自己一个人本来就很能挣钱，",
      "token_start": 683,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 132830,
      "end_ms": 133210,
      "text": "AI,",
      "token_start": 699,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 133210,
      "end_ms": 135445,
      "text": "只是让这件事情变得更容易被看见。",
      "token_start": 700,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 135710,
      "end_ms": 137325,
      "text": "就比如说我现在在做新媒体，",
      "token_start": 715,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 137630,
      "end_ms": 141065,
      "text": "我自己一个人就会写文案、剪视频、做直播等等。",
      "token_start": 727,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 141390,
      "end_ms": 142570,
      "text": "我的所有的团队、同事，",
      "token_start": 746,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 142570,
      "end_ms": 144930,
      "text": "他们只是分担了那些我自己可以做，",
      "token_start": 755,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 144950,
      "end_ms": 146465,
      "text": "但是要消耗我时间的事情，",
      "token_start": 770,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 146900,
      "end_ms": 149615,
      "text": "而未来完全可以把这件事交给AI去做。",
      "token_start": 781,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 150070,
      "end_ms": 152865,
      "text": "所以我认为未来真正值钱的只有三种能力。",
      "token_start": 797,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 153070,
      "end_ms": 153450,
      "text": "第一，",
      "token_start": 815,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 153450,
      "end_ms": 156630,
      "text": "判断力AI可以迅速给你一百个答案，",
      "token_start": 817,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 156630,
      "end_ms": 157590,
      "text": "但哪个是对的，",
      "token_start": 832,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 157590,
      "end_ms": 159685,
      "text": "最后还得你拍板你来承担。",
      "token_start": 838,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 160080,
      "end_ms": 160460,
      "text": "第二，",
      "token_start": 849,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 160480,
      "end_ms": 163230,
      "text": "审美力AI能够迅速生成一百张图片，",
      "token_start": 851,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 163230,
      "end_ms": 164230,
      "text": "但哪张更高级，",
      "token_start": 866,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 164470,
      "end_ms": 166570,
      "text": "哪张俗气机器替代不了，",
      "token_start": 872,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 166570,
      "end_ms": 167795,
      "text": "你最后那一下选择。",
      "token_start": 882,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 168650,
      "end_ms": 169090,
      "text": "第三，",
      "token_start": 890,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 169230,
      "end_ms": 170465,
      "text": "调度AI的能力。",
      "token_start": 892,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 170810,
      "end_ms": 171830,
      "text": "未来真正厉害的人，",
      "token_start": 898,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 171830,
      "end_ms": 174035,
      "text": "不仅仅是把AI当成搜索框的人，",
      "token_start": 906,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 174260,
      "end_ms": 176045,
      "text": "而是把AI当成团队的人。",
      "token_start": 919,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 176310,
      "end_ms": 177870,
      "text": "你不是在问AI问题，",
      "token_start": 929,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 177950,
      "end_ms": 180080,
      "text": "你是在带兵你负责方向，",
      "token_start": 937,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 180100,
      "end_ms": 181080,
      "text": "AI负责执行，",
      "token_start": 947,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 181200,
      "end_ms": 182080,
      "text": "你负责品味，",
      "token_start": 952,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 182160,
      "end_ms": 183135,
      "text": "AI负责生产。",
      "token_start": 957,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 183760,
      "end_ms": 184140,
      "text": "如今，",
      "token_start": 962,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 184280,
      "end_ms": 187495,
      "text": "我们何其有幸亲历一场盛大的时代变迁。",
      "token_start": 964,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 187800,
      "end_ms": 190390,
      "text": " Ai时代最大的危险不是变化本身，",
      "token_start": 981,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 190530,
      "end_ms": 194315,
      "text": "而是你还在用过去的生存经验去面对全新的世界。",
      "token_start": 995,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 194640,
      "end_ms": 195380,
      "text": "在这个时代，",
      "token_start": 1016,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 195440,
      "end_ms": 197760,
      "text": "你创业一定要小而精大，",
      "token_start": 1021,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 197760,
      "end_ms": 199645,
      "text": "而美的时代已经彻底过去了。",
      "token_start": 1031,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 199880,
      "end_ms": 201700,
      "text": "你一定要学会轻资产启动，",
      "token_start": 1043,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 201860,
      "end_ms": 202940,
      "text": "能用则不换，",
      "token_start": 1054,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 203040,
      "end_ms": 204145,
      "text": "能租则不买，",
      "token_start": 1059,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 204410,
      "end_ms": 205450,
      "text": "能二手不贴心，",
      "token_start": 1064,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 205590,
      "end_ms": 206770,
      "text": "能少花钱就少花，",
      "token_start": 1070,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 206770,
      "end_ms": 207775,
      "text": "能不花就不花。",
      "token_start": 1077,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 208140,
      "end_ms": 209500,
