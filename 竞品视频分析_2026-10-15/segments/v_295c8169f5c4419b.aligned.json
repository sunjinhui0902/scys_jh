  "segments": [
    {
      "start_ms": 130,
      "end_ms": 4590,
      "text": "最好的活法就是彻底悠闲享受那种绝望的孤独，",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4970,
      "end_ms": 7350,
      "text": "享受那种谁都不在乎的自在，",
      "token_start": 20,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 7950,
      "end_ms": 9730,
      "text": "不在意别人的眼光和评价，",
      "token_start": 32,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 9990,
      "end_ms": 13330,
      "text": "也不介意命运把你拖进什么样的处境里，",
      "token_start": 43,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 13670,
      "end_ms": 14510,
      "text": "顺其自然，",
      "token_start": 60,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 14790,
      "end_ms": 15590,
      "text": "随遇而安，",
      "token_start": 64,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 15930,
      "end_ms": 16790,
      "text": "自得其乐，",
      "token_start": 68,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 17010,
      "end_ms": 18230,
      "text": "一辈子不后悔。",
      "token_start": 72,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 19070,
      "end_ms": 20030,
      "text": "你只需要记住，",
      "token_start": 78,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 20230,
      "end_ms": 22530,
      "text": "过劳者死过惠者添生，",
      "token_start": 84,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 23030,
      "end_ms": 23730,
      "text": "累了就睡，",
      "token_start": 93,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 24050,
      "end_ms": 25770,
      "text": "饿了就吃没苦，",
      "token_start": 97,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 25930,
      "end_ms": 27090,
      "text": "就别自找苦吃。",
      "token_start": 103,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 27450,
      "end_ms": 29210,
      "text": "吃苦耐劳不等于人格，",
      "token_start": 109,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 29210,
      "end_ms": 32980,
      "text": "高尚吃喝玩乐也不等于虚度光阴。",
      "token_start": 118,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 33760,
      "end_ms": 35620,
      "text": "人生啊就像是一滴雨，",
      "token_start": 132,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 35840,
      "end_ms": 37700,
      "text": "生于天亡于地。",
      "token_start": 141,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 37980,
      "end_ms": 40340,
      "text": "最终我们都是时间的过客。",
      "token_start": 147,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 41180,
      "end_ms": 42240,
      "text": "人这一辈子啊，",
      "token_start": 158,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 42340,
      "end_ms": 43860,
      "text": "其实就是用来体验的，",
      "token_start": 164,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 43980,
      "end_ms": 45940,
      "text": "而不是用来证明给谁看的。",
      "token_start": 173,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 46220,
      "end_ms": 47800,
      "text": "你活着的每时每刻，",
      "token_start": 184,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 48100,
      "end_ms": 51245,
      "text": "就是以人生的全部意义。",
      "token_start": 192,
      "token_end_exclusive": 202
    }
  ],
