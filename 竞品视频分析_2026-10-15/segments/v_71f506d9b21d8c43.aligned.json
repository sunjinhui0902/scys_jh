{
  "video_id": "v_71f506d9b21d8c43",
  "duration_s": 554.562993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_71f506d9b21d8c43.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_71f506d9b21d8c43.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 540,
      "end_ms": 1180,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1360,
      "end_ms": 4220,
      "text": "他是全中国的父母都想移民去的一个地方。",
      "token_start": 4,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4460,
      "end_ms": 7920,
      "text": "这里每十个高中生就有九个能够习提本科，",
      "token_start": 22,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 8280,
      "end_ms": 9960,
      "text": "这里就是真正的南哥。",
      "token_start": 40,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 10320,
      "end_ms": 12480,
      "text": "南通中国近代第一城，",
      "token_start": 49,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12680,
      "end_ms": 13280,
      "text": "你知道吗？",
      "token_start": 58,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 13280,
      "end_ms": 16300,
      "text": "南通市中心最贵的一百平方留给了一个人，",
      "token_start": 62,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 16780,
      "end_ms": 17140,
      "text": "没有，",
      "token_start": 80,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 17140,
      "end_ms": 18820,
      "text": "他就没有今天的学通。",
      "token_start": 82,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 19240,
      "end_ms": 21280,
      "text": "他去世的时候负债累累，",
      "token_start": 91,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 21380,
      "end_ms": 23660,
      "text": "但他一生留下了三百七十所学校，",
      "token_start": 101,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 23980,
      "end_ms": 26000,
      "text": "他亲手打造了这个荒僻小城，",
      "token_start": 115,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 26060,
      "end_ms": 29420,
      "text": "百年之后竟然逆袭成GDP过万亿的工业强市。",
      "token_start": 127,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 29660,
      "end_ms": 31600,
      "text": "他就是张俭先生，",
      "token_start": 145,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 31840,
      "end_ms": 32720,
      "text": "南通之父。",
      "token_start": 152,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 33400,
      "end_ms": 36620,
      "text": "八月二十四日是张俭先生逝世一百周年。",
      "token_start": 156,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 36920,
      "end_ms": 37280,
      "text": "最近，",
      "token_start": 173,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 37280,
      "end_ms": 40800,
      "text": "央视热播的江海潮生讲述的正是他的故事。",
      "token_start": 175,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 41240,
      "end_ms": 48460,
      "text": "张俭一生参与创建了南京大学、上海交通大学、同济大学、东南大学、复南大学等等几百座大学。",
      "token_start": 193,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 48780,
      "end_ms": 50280,
      "text": "比如复旦大学建立时，",
      "token_start": 231,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 50280,
      "end_ms": 52540,
      "text": "百分之六十的师资都来自南通。",
      "token_start": 240,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 53040,
      "end_ms": 58940,
      "text": "他创办了中国第一所民办师范学校、通州师范与京师大学堂南洋公学、齐名，",
      "token_start": 253,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 59300,
      "end_ms": 61470,
      "text": "像上海、南今、武汉等城市，",
      "token_start": 284,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 61470,
      "end_ms": 62995,
      "text": "输送了六千多名教师。",
      "token_start": 294,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 63440,
      "end_ms": 71100,
      "text": "中国近代第一所纺织水利、工艺美术警察、新型戏剧艺术、女红、工人子弟玛雅等等。",
      "token_start": 303,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 71240,
      "end_ms": 75095,
      "text": "你能想象到大部分行业的第一所学校都诞生在南通，",
      "token_start": 336,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 75540,
      "end_ms": 78145,
      "text": "而中国人的一生也基本上摆不脱南通。",
      "token_start": 358,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 78440,
      "end_ms": 79660,
      "text": "你上学做的试卷，",
      "token_start": 374,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 79680,
      "end_ms": 80445,
      "text": "南通出的，",
      "token_start": 381,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 80650,
      "end_ms": 81695,
      "text": "你睡觉盖了被子，",
      "token_start": 385,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 81890,
      "end_ms": 82675,
      "text": "南通产的，",
      "token_start": 392,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 82880,
      "end_ms": 85275,
      "text": "你结婚买的房子还是南通人建的？",
      "token_start": 396,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 85680,
      "end_ms": 89385,
      "text": "南通的高考一本率已经连续十年位居全国第一。",
      "token_start": 410,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 89880,
      "end_ms": 90720,
      "text": "张俭先生说，",
      "token_start": 430,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 90820,
      "end_ms": 91480,
      "text": "父教育，",
      "token_start": 435,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 91480,
      "end_ms": 95330,
      "text": "而母实业实业向母亲负责创造财富，",
      "token_start": 438,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 95430,
      "end_ms": 96235,
      "text": "养育社会，",
      "token_start": 453,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 96500,
      "end_ms": 97100,
      "text": "而教育，",
      "token_start": 457,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 97100,
      "end_ms": 98920,
      "text": "像父亲负责培养人才，",
      "token_start": 460,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 99080,
      "end_ms": 99975,
      "text": "塑造未来。",
      "token_start": 469,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 100420,
      "end_ms": 103100,
      "text": "一八五三年张俭出生在江苏海门，",
      "token_start": 473,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 103240,
      "end_ms": 104035,
      "text": "一个农户家，",
      "token_start": 487,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 104380,
      "end_ms": 105600,
      "text": "五岁就能被签字。",
      "token_start": 492,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 105600,
      "end_ms": 105780,
      "text": "文，",
      "token_start": 499,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 105780,
      "end_ms": 107115,
      "text": "十二岁出口成年，",
      "token_start": 500,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 107420,
      "end_ms": 108265,
      "text": "可在那个年代，",
      "token_start": 507,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 108550,
      "end_ms": 110010,
      "text": "你能不能参加科举考试，",
      "token_start": 513,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 110170,
      "end_ms": 111485,
      "text": "光靠你聪明还不行，",
      "token_start": 523,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 111790,
      "end_ms": 113835,
      "text": "竟然还要看祖上够不够资格。",
      "token_start": 531,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 114170,
      "end_ms": 116545,
      "text": "张戬只能借用别人的身份去应试，",
      "token_start": 543,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 116810,
      "end_ms": 117450,
      "text": "但没有想到，",
      "token_start": 557,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 117450,
      "end_ms": 118550,
      "text": "考中秀才之后，",
      "token_start": 562,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 118690,
      "end_ms": 121270,
      "text": "对方竟然借机敲诈张家，",
      "token_start": 568,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 121270,
      "end_ms": 122550,
      "text": "因此倾家荡产，",
      "token_start": 578,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 122590,
      "end_ms": 123785,
      "text": "欠下白银千两，",
      "token_start": 584,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 124220,
      "end_ms": 127195,
      "text": "但命运却没有给张姐一雪前耻的机会。",
      "token_start": 590,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 127480,
      "end_ms": 128400,
      "text": "二十六年间，",
      "token_start": 606,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 128400,
      "end_ms": 130280,
      "text": "他二十多次进出考场，",
      "token_start": 611,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 130460,
      "end_ms": 132205,
      "text": "却最终没有考中进士。",
      "token_start": 620,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 132530,
      "end_ms": 133650,
      "text": "张戬心灰意冷，",
      "token_start": 629,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 133650,
      "end_ms": 134745,
      "text": "几度想要放弃，",
      "token_start": 635,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 135080,
      "end_ms": 137440,
      "text": "终于在四十二岁一举夺魁。",
      "token_start": 641,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 137580,
      "end_ms": 141050,
      "text": "考中状元、朱军状元啊状元，",
      "token_start": 652,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 141050,
      "end_ms": 143025,
      "text": "这是天下文人的至高荣誉，",
      "token_start": 663,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 143220,
      "end_ms": 146225,
      "text": "也是多少人终其一生无可忘见的梦想。",
      "token_start": 674,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 146740,
      "end_ms": 148520,
      "text": "但是张姐考中的那一年，",
      "token_start": 690,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 148560,
      "end_ms": 150095,
      "text": "偏偏是甲午年，",
      "token_start": 700,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 150470,
      "end_ms": 152295,
      "text": "北洋舰队全军覆没，",
      "token_start": 706,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 152480,
      "end_ms": 154470,
      "text": "而朝廷却笙歌燕舞，",
      "token_start": 714,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 154490,
      "end_ms": 155835,
      "text": "庆祝慈禧六十大寿。",
      "token_start": 722,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 156280,
      "end_ms": 159405,
      "text": "当王公贵族都沉醉在天朝上国的幻想中时，",
      "token_start": 730,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 159640,
      "end_ms": 163995,
      "text": "张戬这个刚入仕途的小翰林却站出来坚决主战，",
      "token_start": 748,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 164640,
      "end_ms": 167235,
      "text": "甚至还上书弹劾大权在握的李鸿章。",
      "token_start": 768,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 167810,
      "end_ms": 170230,
      "text": "张姐可不是那种普通的无用书生。",
      "token_start": 783,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 170510,
      "end_ms": 173150,
      "text": "他曾经做过淮军名将吴长庆的幕僚，",
      "token_start": 797,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 173290,
      "end_ms": 174955,
      "text": "协助平定了朝鲜叛乱。",
      "token_start": 812,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 175320,
      "end_ms": 178955,
      "text": "他是水里进火里出战场上闯荡出来的硬汉子。",
      "token_start": 821,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 179390,
      "end_ms": 180910,
      "text": "张戬中状元的第二年，",
      "token_start": 840,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 180950,
      "end_ms": 183205,
      "text": "马关条约签订割地赔管，",
      "token_start": 849,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 183430,
      "end_ms": 184305,
      "text": "丧权辱国。",
      "token_start": 859,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 184670,
      "end_ms": 186485,
      "text": "张戬在日记里字字泣血，",
      "token_start": 863,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 186830,
      "end_ms": 187790,
      "text": "朝廷能忍，",
      "token_start": 873,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 187870,
      "end_ms": 189725,
      "text": "无四万万同胞不能忍。",
      "token_start": 877,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 189980,
      "end_ms": 191575,
      "text": "他做了一个违背祖宗的决定。",
      "token_start": 886,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 191840,
      "end_ms": 194460,
      "text": "他当着文武百官的面扔掉顶戴，",
      "token_start": 898,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 194460,
      "end_ms": 196385,
      "text": "花梨弃官从商，",
      "token_start": 911,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 197170,
      "end_ms": 198490,
      "text": "士农工商，",
      "token_start": 917,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 198710,
      "end_ms": 200245,
      "text": "当时商的地位最低，",
      "token_start": 921,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 200560,
      "end_ms": 202160,
      "text": "一个状元去经商。",
      "token_start": 929,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 202240,
      "end_ms": 204065,
      "text": "这在当时就是自甘堕落，",
      "token_start": 936,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 204310,
      "end_ms": 205010,
      "text": "但张姐说，",
      "token_start": 946,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 205350,
      "end_ms": 207550,
      "text": "愿成一分一毫有用之事，",
      "token_start": 950,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 207550,
      "end_ms": 208570,
      "text": "不愿居八命，",
      "token_start": 960,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 208570,
      "end_ms": 209925,
      "text": "九命可耻之官。",
      "token_start": 965,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 210690,
      "end_ms": 212070,
      "text": "为了筹集半场资金，",
      "token_start": 971,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 212070,
      "end_ms": 216050,
      "text": "他放下状元身段、卖字、卖画、四处借债、求人，",
      "token_start": 979,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 216050,
      "end_ms": 217650,
      "text": "甚至抵押了全部家产，",
      "token_start": 996,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 217650,
      "end_ms": 218965,
      "text": "典当了妻子的手饰，",
      "token_start": 1005,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 219390,
      "end_ms": 220450,
      "text": "整整五年时间，",
      "token_start": 1013,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 220450,
      "end_ms": 221985,
      "text": "沙场才艰难开工。",
      "token_start": 1019,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 222250,
      "end_ms": 223670,
      "text": "为了栽种棉花彰碱，",
      "token_start": 1026,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 223670,
      "end_ms": 227315,
      "text": "组织筑堤挡潮、开渠排水、洗盐、改土，",
      "token_start": 1034,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 227560,
      "end_ms": 230905,
      "text": "把四千多万亩的盐碱地改造成棉田粮仓，",
      "token_start": 1048,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 231150,
      "end_ms": 233855,
      "text": "让苏北涌现出了上百家盐垦公司。",
      "token_start": 1065,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 234230,
      "end_ms": 238485,
      "text": "今天的海门港一带仍然保留着见证这段历史的张公堤。",
      "token_start": 1079,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 238920,
      "end_ms": 239840,
      "text": "他疏浚河道，",
      "token_start": 1102,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 239960,
      "end_ms": 240785,
      "text": "修建船闸，",
      "token_start": 1107,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 241060,
      "end_ms": 244605,
      "text": "让海门青龙港成为长江北岸最繁忙的港口之一。",
      "token_start": 1111,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 244880,
      "end_ms": 245980,
      "text": "在张姐的努力下，",
      "token_start": 1131,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 246060,
      "end_ms": 246840,
      "text": "大声沙场，",
      "token_start": 1138,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 246840,
      "end_ms": 248845,
      "text": "没几年就赚了四百万两白银，",
      "token_start": 1142,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 249130,
      "end_ms": 251215,
      "text": "换做别人早就富甲一方了。",
      "token_start": 1154,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 251440,
      "end_ms": 254175,
      "text": "可是张姐一分钱都没有装进自己的口袋，",
      "token_start": 1165,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 254480,
      "end_ms": 256745,
      "text": "一件长衫能穿三四十年，",
      "token_start": 1182,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 257020,
      "end_ms": 257540,
      "text": "袜子，",
      "token_start": 1192,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 257560,
      "end_ms": 258945,
      "text": "棉袄破了就打补丁，",
      "token_start": 1194,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 259200,
      "end_ms": 261205,
      "text": "直到不能再破才换新的。",
      "token_start": 1202,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 261590,
      "end_ms": 263250,
      "text": "他对自己吝啬极致，",
      "token_start": 1212,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 263350,
      "end_ms": 265710,
      "text": "却慷慨的设立育婴堂两年，",
      "token_start": 1220,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 265710,
      "end_ms": 267475,
      "text": "收养一千五百多个孩子，",
      "token_start": 1231,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 267780,
      "end_ms": 268760,
      "text": "开办七流所，",
      "token_start": 1241,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 268780,
      "end_ms": 269640,
      "text": "收容乞丐，",
      "token_start": 1246,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 269640,
      "end_ms": 270845,
      "text": "教他们谋生技能，",
      "token_start": 1250,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 271160,
      "end_ms": 275035,
      "text": "也让南通成为当时全中国唯一街上没有乞丐的城市。",
      "token_start": 1257,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 275420,
      "end_ms": 276640,
      "text": "他建立计两所，",
      "token_start": 1279,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 276680,
      "end_ms": 279025,
      "text": "帮助风尘女子回归正常生活，",
      "token_start": 1285,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 279360,
      "end_ms": 281520,
      "text": "自费组建测绘队、兴修水利，",
      "token_start": 1297,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 281520,
      "end_ms": 282180,
      "text": "建堤坝，",
      "token_start": 1308,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 282320,
      "end_ms": 283720,
      "text": "疏通河道三十多条，",
      "token_start": 1311,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 283920,
      "end_ms": 285735,
      "text": "修建桥梁四百多座，",
      "token_start": 1319,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 286070,
      "end_ms": 287770,
      "text": "还建了残疾院医院，",
      "token_start": 1327,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 287930,
      "end_ms": 289070,
      "text": "让老有所依，",
      "token_start": 1335,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 289110,
      "end_ms": 289890,
      "text": "幼有所长，",
      "token_start": 1340,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 290070,
      "end_ms": 291550,
      "text": "残疾者皆有所养，",
      "token_start": 1344,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 291730,
      "end_ms": 292745,
      "text": "六十大寿时，",
      "token_start": 1351,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 293010,
      "end_ms": 294675,
      "text": "亲友要为他大摆寿宴，",
      "token_start": 1356,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 294890,
      "end_ms": 298050,
      "text": "他就把寿宴的钱和贺礼全部拿去建了养老院。",
      "token_start": 1365,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 298250,
      "end_ms": 298675,
      "text": "他说，",
      "token_start": 1384,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 299020,
      "end_ms": 299820,
      "text": "一己之响，",
      "token_start": 1386,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 300000,
      "end_ms": 300400,
      "text": "何如，",
      "token_start": 1390,
      "token_end_exclusive": 1392
    },
    {
      "start_ms": 300420,
      "end_ms": 301300,
      "text": "众人之安，",
      "token_start": 1392,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 301400,
      "end_ms": 302180,
      "text": "一日之废，",
      "token_start": 1396,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 302360,
      "end_ms": 303715,
      "text": "何如百年之惠。",
      "token_start": 1400,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 304290,
      "end_ms": 306590,
      "text": "张戬先生在南通创办了大生纱场，",
      "token_start": 1406,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 306590,
      "end_ms": 310190,
      "text": "为全国各地输送了纺织机械三点二万多套，",
      "token_start": 1420,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 310350,
      "end_ms": 313350,
      "text": "推动了十几万家纺织企业遍地开花，",
      "token_start": 1438,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 313530,
      "end_ms": 315810,
      "text": "养活了全中国上千万人就业。",
      "token_start": 1453,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 316090,
      "end_ms": 316790,
      "text": "战乱年代，",
      "token_start": 1465,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 316790,
      "end_ms": 319810,
      "text": "南通糖闸工业区奔赴祖国十八个省市，",
      "token_start": 1469,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 319930,
      "end_ms": 321790,
      "text": "为全国输送纺织业人才，",
      "token_start": 1485,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 321810,
      "end_ms": 323050,
      "text": "二十一点七万人，",
      "token_start": 1495,
      "token_end_exclusive": 1502
    },
    {
      "start_ms": 323230,
      "end_ms": 324970,
      "text": "掏空了南通一半的家底。",
      "token_start": 1502,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 325270,
      "end_ms": 326170,
      "text": "但即便如此，",
      "token_start": 1512,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 326290,
      "end_ms": 328370,
      "text": "南通依然是世界家纺之都，",
      "token_start": 1517,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 328610,
      "end_ms": 331790,
      "text": "海门的叠石桥市场是全球最大的家纺市场，",
      "token_start": 1528,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 331930,
      "end_ms": 333310,
      "text": "承包了全国人的睡眠。",
      "token_start": 1546,
      "token_end_exclusive": 1555
    },
    {
      "start_ms": 333310,
      "end_ms": 336180,
      "text": "前世世界每十件家纺有六件，",
      "token_start": 1555,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 336180,
      "end_ms": 337800,
      "text": "都来自南通朱君。",
      "token_start": 1567,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 338140,
      "end_ms": 340020,
      "text": "一个人究竟要留下些什么，",
      "token_start": 1574,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 340200,
      "end_ms": 343600,
      "text": "才能够在离开一百年以后仍被人如此怀念。",
      "token_start": 1585,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 343820,
      "end_ms": 348160,
      "text": "张俭先生在通海大地上布下了整座近代城市的格局，",
      "token_start": 1603,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 348480,
      "end_ms": 350300,
      "text": "他创办了中国第一座博物院。",
      "token_start": 1625,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 350440,
      "end_ms": 351440,
      "text": "南通博物院，",
      "token_start": 1637,
      "token_end_exclusive": 1642
    },
    {
      "start_ms": 351580,
      "end_ms": 353360,
      "text": "比故宫博物院还早二十年。",
      "token_start": 1642,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 353560,
      "end_ms": 354680,
      "text": "第一所气象台，",
      "token_start": 1653,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 355100,
      "end_ms": 357360,
      "text": "江苏第一条公路港闸公路。",
      "token_start": 1659,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 357400,
      "end_ms": 363080,
      "text": "而当时江苏省百分之七十的公路都在南通修建了苏北第一条铁路、青山铁路，",
      "token_start": 1670,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 363080,
      "end_ms": 366635,
      "text": "还成立了全国第一支交警、第一所交警学校，",
      "token_start": 1702,
      "token_end_exclusive": 1720
    },
    {
      "start_ms": 366870,
      "end_ms": 369005,
      "text": "还建了南通第一个公共体育场，",
      "token_start": 1720,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 369310,
      "end_ms": 371775,
      "text": "让南通涌现了三十多位世界冠军。",
      "token_start": 1733,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 372140,
      "end_ms": 374665,
      "text": "他建公共图书馆、印书局、办报纸，",
      "token_start": 1747,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 375070,
      "end_ms": 377250,
      "text": "让南通人用上了电灯电话。",
      "token_start": 1760,
      "token_end_exclusive": 1771
    },
    {
      "start_ms": 377630,
      "end_ms": 381585,
      "text": "张俭先生还以南通为核心服饰全国创办的七十家企业，",
      "token_start": 1771,
      "token_end_exclusive": 1794
    },
    {
      "start_ms": 381780,
      "end_ms": 384700,
      "text": "开创了无数个第一江浙渔业公司，",
      "token_start": 1794,
      "token_end_exclusive": 1808
    },
    {
      "start_ms": 384900,
      "end_ms": 387145,
      "text": "开创了我国拖网渔轮业的先河。",
      "token_start": 1808,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 387550,
      "end_ms": 391110,
      "text": "怡生酿造厂获得国酒类第一块世博会金牌，",
      "token_start": 1821,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 391110,
      "end_ms": 392405,
      "text": "比茅台早了九年。",
      "token_start": 1839,
      "token_end_exclusive": 1846
    },
    {
      "start_ms": 392710,
      "end_ms": 397670,
      "text": "南通秀之局将分公司开到了纽约第五大道大达轮船公司，",
      "token_start": 1846,
      "token_end_exclusive": 1870
    },
    {
      "start_ms": 397670,
      "end_ms": 400365,
      "text": "修建了上海最著名的客运码头大达码头。",
      "token_start": 1870,
      "token_end_exclusive": 1887
    },
    {
      "start_ms": 400730,
      "end_ms": 404310,
      "text": "江西瓷业公司建设了中国第一家近代瓷器工厂，",
      "token_start": 1887,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 404490,
      "end_ms": 406390,
      "text": "而张瑾还是申报了大股东。",
      "token_start": 1907,
      "token_end_exclusive": 1918
    },
    {
      "start_ms": 406570,
      "end_ms": 408790,
      "text": "甚至你现在能去故宫参观，",
      "token_start": 1918,
      "token_end_exclusive": 1929
    },
    {
      "start_ms": 408830,
      "end_ms": 409665,
      "text": "也得感谢他，",
      "token_start": 1929,
      "token_end_exclusive": 1934
    },
    {
      "start_ms": 409980,
      "end_ms": 411725,
      "text": "就是在他的大礼倡议之下，",
      "token_start": 1934,
      "token_end_exclusive": 1945
    },
    {
      "start_ms": 411970,
      "end_ms": 413470,
      "text": "才成立了古物陈列所，",
      "token_start": 1945,
      "token_end_exclusive": 1954
    },
    {
      "start_ms": 413550,
      "end_ms": 415645,
      "text": "让故宫走出了开放的第一步。",
      "token_start": 1954,
      "token_end_exclusive": 1966
    },
    {
      "start_ms": 415990,
      "end_ms": 420705,
      "text": "他还牵头制定了中国第一部公司法商法总则森林法狩猎法。",
      "token_start": 1966,
      "token_end_exclusive": 1991
    },
    {
      "start_ms": 421200,
      "end_ms": 423220,
      "text": "张姐做事从不问难不难，",
      "token_start": 1991,
      "token_end_exclusive": 2001
    },
    {
      "start_ms": 423280,
      "end_ms": 424485,
      "text": "只问该不该。",
      "token_start": 2001,
      "token_end_exclusive": 2006
    },
    {
      "start_ms": 424780,
      "end_ms": 425145,
      "text": "他说，",
      "token_start": 2006,
      "token_end_exclusive": 2008
    },
    {
      "start_ms": 425520,
      "end_ms": 427985,
      "text": "办一线事要有一省之眼光，",
      "token_start": 2008,
      "token_end_exclusive": 2019
    },
    {
      "start_ms": 428290,
      "end_ms": 429110,
      "text": "办一省事，",
      "token_start": 2019,
      "token_end_exclusive": 2023
    },
    {
      "start_ms": 429250,
      "end_ms": 430470,
      "text": "要有一国之眼光，",
      "token_start": 2023,
      "token_end_exclusive": 2030
    },
    {
      "start_ms": 430670,
      "end_ms": 431530,
      "text": "办一国事，",
      "token_start": 2030,
      "token_end_exclusive": 2034
    },
    {
      "start_ms": 431670,
      "end_ms": 433065,
      "text": "要有世界之眼光，",
      "token_start": 2034,
      "token_end_exclusive": 2041
    },
    {
      "start_ms": 433750,
      "end_ms": 434750,
      "text": "因为内忧外患，",
      "token_start": 2041,
      "token_end_exclusive": 2047
    },
    {
      "start_ms": 434890,
      "end_ms": 436985,
      "text": "张戬的产业最终没能撑下去。",
      "token_start": 2047,
      "token_end_exclusive": 2059
    },
    {
      "start_ms": 437330,
      "end_ms": 439150,
      "text": "一九二六年八月二十四日，",
      "token_start": 2059,
      "token_end_exclusive": 2070
    },
    {
      "start_ms": 439150,
      "end_ms": 441595,
      "text": "七十三岁的张俭先生抱汗而亡，",
      "token_start": 2070,
      "token_end_exclusive": 2083
    },
    {
      "start_ms": 441990,
      "end_ms": 443895,
      "text": "十几万人在街边为他送行。",
      "token_start": 2083,
      "token_end_exclusive": 2094
    },
    {
      "start_ms": 444320,
      "end_ms": 444800,
      "text": "临死前，",
      "token_start": 2094,
      "token_end_exclusive": 2097
    },
    {
      "start_ms": 444800,
      "end_ms": 445770,
      "text": "他担心的是，",
      "token_start": 2097,
      "token_end_exclusive": 2102
    },
    {
      "start_ms": 445770,
      "end_ms": 448890,
      "text": "这儿的电厂没能建成那儿的民兵制度没能普及，",
      "token_start": 2102,
      "token_end_exclusive": 2122
    },
    {
      "start_ms": 448950,
      "end_ms": 451025,
      "text": "从头到尾没有一件私事。",
      "token_start": 2122,
      "token_end_exclusive": 2132
    },
    {
      "start_ms": 451440,
      "end_ms": 453865,
      "text": "他的墓碑上简简单单的一句，",
      "token_start": 2132,
      "token_end_exclusive": 2144
    },
    {
      "start_ms": 454250,
      "end_ms": 458220,
      "text": "南通张先生状元是皇帝给的先生，",
      "token_start": 2144,
      "token_end_exclusive": 2158
    },
    {
      "start_ms": 458360,
      "end_ms": 460250,
      "text": "是百姓教的先生。",
      "token_start": 2158,
      "token_end_exclusive": 2165
    },
    {
      "start_ms": 460250,
      "end_ms": 461250,
      "text": "这两个字很轻，",
      "token_start": 2165,
      "token_end_exclusive": 2171
    },
    {
      "start_ms": 461610,
      "end_ms": 462970,
      "text": "却装得下一座城。",
      "token_start": 2171,
      "token_end_exclusive": 2178
    },
    {
      "start_ms": 463270,
      "end_ms": 463990,
      "text": "胡适评价，",
      "token_start": 2178,
      "token_end_exclusive": 2182
    },
    {
      "start_ms": 463990,
      "end_ms": 464415,
      "text": "张姐，",
      "token_start": 2182,
      "token_end_exclusive": 2184
    },
    {
      "start_ms": 464630,
      "end_ms": 466615,
      "text": "一个伟大的失败的英雄。",
      "token_start": 2184,
      "token_end_exclusive": 2194
    },
    {
      "start_ms": 467400,
      "end_ms": 471250,
      "text": "可是朱军啊、朱军如果一家企业最终债台高筑，",
      "token_start": 2194,
      "token_end_exclusive": 2213
    },
    {
      "start_ms": 471450,
      "end_ms": 474805,
      "text": "但他留下了工厂、学校、养老院、博物馆，",
      "token_start": 2213,
      "token_end_exclusive": 2228
    },
    {
      "start_ms": 475060,
      "end_ms": 476660,
      "text": "让无数家庭有了生计，",
      "token_start": 2228,
      "token_end_exclusive": 2237
    },
    {
      "start_ms": 476660,
      "end_ms": 478040,
      "text": "让无数孩子改变了命。",
      "token_start": 2237,
      "token_end_exclusive": 2246
    },
    {
      "start_ms": 478040,
      "end_ms": 480845,
      "text": "密这个人究竟算成功还是失败？",
      "token_start": 2246,
      "token_end_exclusive": 2259
    },
    {
      "start_ms": 481360,
      "end_ms": 482800,
      "text": "如果你来到南通海门，",
      "token_start": 2259,
      "token_end_exclusive": 2268
    },
    {
      "start_ms": 482920,
      "end_ms": 484215,
      "text": "不妨去张公祠，",
      "token_start": 2268,
      "token_end_exclusive": 2274
    },
    {
      "start_ms": 484500,
      "end_ms": 486960,
      "text": "这是家乡百姓在他逝世十周年时，",
      "token_start": 2274,
      "token_end_exclusive": 2288
    },
    {
      "start_ms": 487000,
      "end_ms": 490940,
      "text": "自发修建的在宜生文博园品一品宜生酒香，",
      "token_start": 2288,
      "token_end_exclusive": 2306
    },
    {
      "start_ms": 491020,
      "end_ms": 492445,
      "text": "逛一逛状元故居，",
      "token_start": 2306,
      "token_end_exclusive": 2313
    },
    {
      "start_ms": 492760,
      "end_ms": 493800,
      "text": "去大声三场，",
      "token_start": 2313,
      "token_end_exclusive": 2318
    },
    {
      "start_ms": 494020,
      "end_ms": 495885,
      "text": "听听百年魏停的钟声，",
      "token_start": 2318,
      "token_end_exclusive": 2327
    },
    {
      "start_ms": 496570,
      "end_ms": 497270,
      "text": "再到张公，",
      "token_start": 2327,
      "token_end_exclusive": 2331
    },
    {
      "start_ms": 497270,
      "end_ms": 499220,
      "text": "低上看潮起潮落，",
      "token_start": 2331,
      "token_end_exclusive": 2338
    },
    {
      "start_ms": 499380,
      "end_ms": 500285,
      "text": "江水奔涌，",
      "token_start": 2338,
      "token_end_exclusive": 2342
    },
    {
      "start_ms": 501050,
      "end_ms": 505655,
      "text": "海门的风里至今还藏着百年前那份敢为天下先的气魄，",
      "token_start": 2342,
      "token_end_exclusive": 2365
    },
    {
      "start_ms": 506230,
      "end_ms": 508425,
      "text": "被南通段的长江给震撼了。",
      "token_start": 2365,
      "token_end_exclusive": 2376
    },
    {
      "start_ms": 508790,
      "end_ms": 509950,
      "text": "漫天碧透，",
      "token_start": 2376,
      "token_end_exclusive": 2380
    },
    {
      "start_ms": 509990,
      "end_ms": 510890,
      "text": "百舸争流，",
      "token_start": 2380,
      "token_end_exclusive": 2384
    },
    {
      "start_ms": 510950,
      "end_ms": 512885,
      "text": "天下英雄如过江之机。",
      "token_start": 2384,
      "token_end_exclusive": 2393
    },
    {
      "start_ms": 513170,
      "end_ms": 513970,
      "text": "站在海门，",
      "token_start": 2393,
      "token_end_exclusive": 2397
    },
    {
      "start_ms": 513970,
      "end_ms": 516250,
      "text": "才算懂得何谓泱泱大国。",
      "token_start": 2397,
      "token_end_exclusive": 2407
    },
    {
      "start_ms": 516250,
      "end_ms": 516745,
      "text": "四个字。",
      "token_start": 2407,
      "token_end_exclusive": 2410
    },
    {
      "start_ms": 517280,
      "end_ms": 518120,
      "text": "一百年之后，",
      "token_start": 2410,
      "token_end_exclusive": 2415
    },
    {
      "start_ms": 518260,
      "end_ms": 520275,
      "text": "张俭先生不止活在纪念馆里，",
      "token_start": 2415,
      "token_end_exclusive": 2427
    },
    {
      "start_ms": 520540,
      "end_ms": 524140,
      "text": "他的家乡南通海门是万里长江奔流入海前，",
      "token_start": 2427,
      "token_end_exclusive": 2445
    },
    {
      "start_ms": 524140,
      "end_ms": 525985,
      "text": "塑造了最后一块丰饶之地。",
      "token_start": 2445,
      "token_end_exclusive": 2456
    },
    {
      "start_ms": 526360,
      "end_ms": 527745,
      "text": "南通人从这里出发，",
      "token_start": 2456,
      "token_end_exclusive": 2464
    },
    {
      "start_ms": 528100,
      "end_ms": 529640,
      "text": "辞家千里又千里，",
      "token_start": 2464,
      "token_end_exclusive": 2471
    },
    {
      "start_ms": 529700,
      "end_ms": 530700,
      "text": "务必争气，",
      "token_start": 2471,
      "token_end_exclusive": 2475
    },
    {
      "start_ms": 530780,
      "end_ms": 531515,
      "text": "再争气。",
      "token_start": 2475,
      "token_end_exclusive": 2478
    },
    {
      "start_ms": 531890,
      "end_ms": 539905,
      "text": "南通人建起的人民大会堂、国家博物馆、央视大楼、东方明珠、鸟巢、港珠澳大桥、世界最高楼、迪拜塔等等。",
      "token_start": 2478,
      "token_end_exclusive": 2519
    },
    {
      "start_ms": 540370,
      "end_ms": 544395,
      "text": "中国现代化城市成就的幕后英雄就是无数南通人。",
      "token_start": 2519,
      "token_end_exclusive": 2540
    },
    {
      "start_ms": 544940,
      "end_ms": 546840,
      "text": "你看到的不只是一个人的故乡，",
      "token_start": 2540,
      "token_end_exclusive": 2553
    },
    {
      "start_ms": 547060,
      "end_ms": 548200,
      "text": "而是一个人的理想，",
      "token_start": 2553,
      "token_end_exclusive": 2561
    },
    {
      "start_ms": 548460,
      "end_ms": 550455,
      "text": "怎样被写进这片土地，",
      "token_start": 2561,
      "token_end_exclusive": 2570
    },
    {
      "start_ms": 550740,
      "end_ms": 554355,
      "text": "又怎样在一百年之后依然滋养着你我的生活。",
      "token_start": 2570,
      "token_end_exclusive": 2589
    }
  ],
