  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 2070,
      "text": "如果你梦到逝去的亲人，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2330,
      "end_ms": 5070,
      "text": "请你一定要好好珍惜这难得的相遇。",
      "token_start": 10,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 5370,
      "end_ms": 7330,
      "text": "不管在梦里他是什么模样，",
      "token_start": 25,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 7470,
      "end_ms": 8890,
      "text": "以何种方式出现，",
      "token_start": 36,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 9290,
      "end_ms": 10150,
      "text": "沉默也好，",
      "token_start": 43,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 10470,
      "end_ms": 11350,
      "text": "温柔也罢，",
      "token_start": 47,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 11730,
      "end_ms": 14630,
      "text": "这或许都是他付出了巨大的代价，",
      "token_start": 51,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 15110,
      "end_ms": 16610,
      "text": "才能够来到你的梦里。",
      "token_start": 65,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 17310,
      "end_ms": 20690,
      "text": "也有可能是他拼尽全力跨越时空，",
      "token_start": 74,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 21010,
      "end_ms": 21890,
      "text": "穿越时空，",
      "token_start": 88,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 22010,
      "end_ms": 22770,
      "text": "不畏艰难，",
      "token_start": 92,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 23110,
      "end_ms": 23970,
      "text": "跨越回应，",
      "token_start": 96,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 24270,
      "end_ms": 26610,
      "text": "只为悄悄的来见你一面，",
      "token_start": 100,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 26970,
      "end_ms": 28530,
      "text": "看看你过得还好不好？",
      "token_start": 110,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 29550,
      "end_ms": 30480,
      "text": "故人入我，",
      "token_start": 119,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 30480,
      "end_ms": 31360,
      "text": "梦明，",
      "token_start": 123,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 31360,
      "end_ms": 33040,
      "text": "我常相忆。",
      "token_start": 125,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 33420,
      "end_ms": 34300,
      "text": "你有没有想过，",
      "token_start": 129,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 34620,
      "end_ms": 37120,
      "text": "他为何不去其他亲朋好友的梦？",
      "token_start": 135,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 37400,
      "end_ms": 38900,
      "text": "偏偏只来你的梦里，",
      "token_start": 148,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 39100,
      "end_ms": 40160,
      "text": "这是巧合吗？",
      "token_start": 156,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 40940,
      "end_ms": 42800,
      "text": "因为你是他最放心不下，",
      "token_start": 161,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 43100,
      "end_ms": 47040,
      "text": "也是他这辈子最思念最相信的人。",
      "token_start": 171,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 47620,
      "end_ms": 48600,
      "text": "接受了离别，",
      "token_start": 185,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 49200,
      "end_ms": 50460,
      "text": "却低估的思念，",
      "token_start": 190,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 51260,
      "end_ms": 52980,
      "text": "过去陪我一同祭拜的人，",
      "token_start": 196,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 53140,
      "end_ms": 56080,
      "text": "变成了如今我为他祭拜的人。",
      "token_start": 206,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 56800,
      "end_ms": 59260,
      "text": "我们总有太多的来不及接的人，",
      "token_start": 218,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 59260,
      "end_ms": 59915,
      "text": "还能再见，",
      "token_start": 231,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 60250,
      "end_ms": 63370,
      "text": "而有的人却再也不见了。",
      "token_start": 235,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 63490,
      "end_ms": 66010,
      "text": "我们总以为有太多的来日方长，",
      "token_start": 245,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 66510,
      "end_ms": 68645,
      "text": "却不知世事无常，",
      "token_start": 258,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 69170,
      "end_ms": 70235,
      "text": "就此一别，",
      "token_start": 265,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 70830,
      "end_ms": 71965,
      "text": "再无归期，",
      "token_start": 269,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 72370,
      "end_ms": 73870,
      "text": "从此相见，",
      "token_start": 273,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 73930,
      "end_ms": 74845,
      "text": "只在梦里。",
      "token_start": 277,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 75920,
      "end_ms": 78095,
      "text": "若你在生活中有惊无险，",
      "token_start": 281,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 78490,
      "end_ms": 81075,
      "text": "在困境中总能化险为夷，",
      "token_start": 291,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 81460,
      "end_ms": 85230,
      "text": "这或许就是你的梦中人在跨越时空庇佑，",
      "token_start": 301,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 85230,
      "end_ms": 87165,
      "text": "你请你记得感恩。",
      "token_start": 318,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 87480,
      "end_ms": 87850,
      "text": "Ok,",
      "token_start": 325,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 88110,
      "end_ms": 90910,
      "text": "最后见天上亲人安息，",
      "token_start": 326,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 90970,
      "end_ms": 91555,
      "text": "斟酌，",
      "token_start": 335,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 92080,
      "end_ms": 95835,
      "text": "世上人间岁岁平安。",
      "token_start": 337,
      "token_end_exclusive": 345
    }
  ],
