{
  "video_id": "v_3c6e3ef7c207a723",
  "duration_s": 410.297007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_3c6e3ef7c207a723.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_3c6e3ef7c207a723.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 4170,
      "text": "您知道中国最不可思议的长寿村是哪一个吗？",
      "token_start": 0,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4750,
      "end_ms": 11050,
      "text": "有人说是广西巴马八盘屯全同五百多人巅峰时，",
      "token_start": 19,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 11150,
      "end_ms": 13450,
      "text": "同时健在的百岁寿星，",
      "token_start": 39,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 13770,
      "end_ms": 17030,
      "text": "就有整整七位名扬海内外。",
      "token_start": 48,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 17390,
      "end_ms": 19730,
      "text": "有人说是湖北钟祥水平村，",
      "token_start": 59,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 20510,
      "end_ms": 24330,
      "text": "明朝皇帝亲自下旨嘉奖的长寿福地，",
      "token_start": 70,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 24990,
      "end_ms": 26610,
      "text": "全村一千多口人，",
      "token_start": 85,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 27150,
      "end_ms": 29845,
      "text": "八九十岁以上的老寿星就有几十号，",
      "token_start": 92,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 30200,
      "end_ms": 37240,
      "text": "对不住了水平村连前五都挤不进名气最大的巴马也不是第一，",
      "token_start": 107,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 37880,
      "end_ms": 42740,
      "text": "真正排在榜首的那座村子根本不在温润水乡，",
      "token_start": 133,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 43420,
      "end_ms": 45200,
      "text": "也不在深山老林，",
      "token_start": 152,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 45560,
      "end_ms": 47940,
      "text": "它紧挨着大漠的风沙边缘，",
      "token_start": 159,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 48420,
      "end_ms": 51240,
      "text": "年降水量甚至不足四十毫米。",
      "token_start": 170,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 51800,
      "end_ms": 52220,
      "text": "今天，",
      "token_start": 182,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 52220,
      "end_ms": 56980,
      "text": "咱们就来盘点中国十大最不可思议的长寿村话。",
      "token_start": 184,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 56980,
      "end_ms": 57520,
      "text": "不多说，",
      "token_start": 204,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 57920,
      "end_ms": 59260,
      "text": "茶给您沏好了，",
      "token_start": 207,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 59700,
      "end_ms": 62265,
      "text": "老麻烦您顺手点个小红心，",
      "token_start": 213,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 62630,
      "end_ms": 63745,
      "text": "咱们这就开讲。",
      "token_start": 224,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 64180,
      "end_ms": 65025,
      "text": "第十名，",
      "token_start": 230,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 65540,
      "end_ms": 69625,
      "text": "江苏如皋长青村江淮平原腹地。",
      "token_start": 233,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 70350,
      "end_ms": 71945,
      "text": "在很多人的印象里，",
      "token_start": 246,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 72370,
      "end_ms": 74215,
      "text": "能出长寿村的地方，",
      "token_start": 254,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 74580,
      "end_ms": 76395,
      "text": "怎么也得是崇山峻岭。",
      "token_start": 262,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 76840,
      "end_ms": 79225,
      "text": "可如皋这片土地一马平川，",
      "token_start": 271,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 79750,
      "end_ms": 81385,
      "text": "海拔只有几米高，",
      "token_start": 282,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 81760,
      "end_ms": 84375,
      "text": "村里八九十岁的老人随处可见，",
      "token_start": 289,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 84830,
      "end_ms": 87195,
      "text": "这里不靠高山阻隔城市，",
      "token_start": 302,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 87620,
      "end_ms": 90485,
      "text": "靠的是世代相传的水土与慢节奏。",
      "token_start": 312,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 90930,
      "end_ms": 93695,
      "text": "您清晨走到长青村的田埂上，",
      "token_start": 326,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 94260,
      "end_ms": 95180,
      "text": "放眼望去，",
      "token_start": 338,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 95240,
      "end_ms": 97485,
      "text": "全是齐整的麦田与菜畦。",
      "token_start": 342,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 98190,
      "end_ms": 101745,
      "text": "七八十岁的老人提着菜篮在石桥边拉家常，",
      "token_start": 352,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 102460,
      "end_ms": 105260,
      "text": "脚步轻快的像一阵风平原，",
      "token_start": 370,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 105340,
      "end_ms": 106875,
      "text": "没有险丰的灵气，",
      "token_start": 381,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 107360,
      "end_ms": 109635,
      "text": "却有踏踏实实的烟火气，",
      "token_start": 388,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 110090,
      "end_ms": 111090,
      "text": "一马平川，",
      "token_start": 398,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 111370,
      "end_ms": 113385,
      "text": "也能孕育漫长岁月。",
      "token_start": 402,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 113960,
      "end_ms": 115955,
      "text": "您说这算不算打破了常理？",
      "token_start": 410,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 116330,
      "end_ms": 117015,
      "text": "第九名，",
      "token_start": 421,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 117740,
      "end_ms": 123145,
      "text": "山东莱州三山岛村胶东半岛的海滨渔村，",
      "token_start": 424,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 124020,
      "end_ms": 128455,
      "text": "有人总觉得长寿是南方温暖水乡的专属。",
      "token_start": 441,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 129130,
      "end_ms": 130630,
      "text": "北方天寒地冻，",
      "token_start": 458,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 130790,
      "end_ms": 132025,
      "text": "养不住高寿。",
      "token_start": 464,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 132380,
      "end_ms": 135865,
      "text": "可三山岛村坐落在渤海湾畔，",
      "token_start": 469,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 136470,
      "end_ms": 138575,
      "text": "两千多口人的渔村，",
      "token_start": 481,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 139460,
      "end_ms": 142605,
      "text": "八十岁以上的老渔民有一百多号人，",
      "token_start": 489,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 143060,
      "end_ms": 143880,
      "text": "这里冬天，",
      "token_start": 504,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 144020,
      "end_ms": 145065,
      "text": "海风呼啸，",
      "token_start": 508,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 145520,
      "end_ms": 146525,
      "text": "滴水成冰，",
      "token_start": 512,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 147070,
      "end_ms": 152005,
      "text": "老人们却是在弦涩的海浪声里摸爬滚打了一辈子。",
      "token_start": 516,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 152430,
      "end_ms": 154815,
      "text": "您要是迎着海风走进村口，",
      "token_start": 537,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 155300,
      "end_ms": 157620,
      "text": "就能瞧见八十多岁的老汉，",
      "token_start": 548,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 157720,
      "end_ms": 160155,
      "text": "光着膀子在岸边修捕渔网，",
      "token_start": 559,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 160740,
      "end_ms": 162915,
      "text": "手指粗糙的像老树皮，",
      "token_start": 570,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 163570,
      "end_ms": 165350,
      "text": "拉起几米长的麻绳，",
      "token_start": 579,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 165470,
      "end_ms": 167760,
      "text": "依旧稳稳当当严寒，",
      "token_start": 587,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 167780,
      "end_ms": 168880,
      "text": "没有冻住生机，",
      "token_start": 595,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 169180,
      "end_ms": 171565,
      "text": "反而淬炼出硬朗的筋骨。",
      "token_start": 601,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 172010,
      "end_ms": 175030,
      "text": "谁说北方海边不养兽第八名？",
      "token_start": 611,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 175310,
      "end_ms": 180135,
      "text": "广东大埔石鼓坪村粤东高山地带的客家古村，",
      "token_start": 623,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 180590,
      "end_ms": 183595,
      "text": "整座村子隐在千米高山之上，",
      "token_start": 642,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 184130,
      "end_ms": 191395,
      "text": "全村几百口人八九十岁的高寿长者就有几十号百岁老人生日，",
      "token_start": 654,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 191740,
      "end_ms": 195795,
      "text": "五世同堂拜寿的场面并不稀奇。",
      "token_start": 680,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 196210,
      "end_ms": 198255,
      "text": "客家人南迁数百年，",
      "token_start": 693,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 198780,
      "end_ms": 203205,
      "text": "整整一个家族都聚居在巨大的圆形土楼里。",
      "token_start": 701,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 203640,
      "end_ms": 205805,
      "text": "您站在维吾天井中央，",
      "token_start": 719,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 206480,
      "end_ms": 209105,
      "text": "八十多岁的老阿婆脚步生风，",
      "token_start": 728,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 209800,
      "end_ms": 212840,
      "text": "还能挑着菜篮麻利的跨过石门槛。",
      "token_start": 740,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 213660,
      "end_ms": 216665,
      "text": "九十多岁的老族长端坐在中堂，",
      "token_start": 754,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 217330,
      "end_ms": 220095,
      "text": "全村的大小事物都得请他定夺。",
      "token_start": 767,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 220520,
      "end_ms": 223295,
      "text": "这里的长寿不是孤零零的熬日子，",
      "token_start": 780,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 223750,
      "end_ms": 228095,
      "text": "而是身前身后都簇拥着几代人的烟火。",
      "token_start": 794,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 228600,
      "end_ms": 230325,
      "text": "宗族相守的温情，",
      "token_start": 810,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 230920,
      "end_ms": 233355,
      "text": "才是长寿最暖的底色。",
      "token_start": 817,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 233690,
      "end_ms": 234375,
      "text": "第七名，",
      "token_start": 826,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 234760,
      "end_ms": 239135,
      "text": "湖南麻阳漫水村武陵山脉余脉深处的苗寨，",
      "token_start": 829,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 239650,
      "end_ms": 242995,
      "text": "这里藏在锦江两岸的崇山峻岭之中，",
      "token_start": 847,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 243470,
      "end_ms": 246655,
      "text": "是盘户文化世代浸润的古老村落。",
      "token_start": 862,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 247110,
      "end_ms": 252550,
      "text": "村里九十岁以上的高龄老人多达几十位千百年间苗，",
      "token_start": 876,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 252550,
      "end_ms": 254165,
      "text": "民们移山结寨，",
      "token_start": 898,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 254620,
      "end_ms": 255940,
      "text": "晨起看山间，",
      "token_start": 904,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 256020,
      "end_ms": 257170,
      "text": "云雾日，",
      "token_start": 909,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 257170,
      "end_ms": 259435,
      "text": "落枕着流水入眠。",
      "token_start": 912,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 259880,
      "end_ms": 262625,
      "text": "您要是顺着青石板路踏进苗寨，",
      "token_start": 919,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 263170,
      "end_ms": 266985,
      "text": "迎面就能撞见挽着青布头帕的九旬阿婆，",
      "token_start": 932,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 267830,
      "end_ms": 270275,
      "text": "一边手脚麻利的编着竹篓，",
      "token_start": 949,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 270700,
      "end_ms": 272995,
      "text": "一边哼唱着古老的苗歌。",
      "token_start": 960,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 273380,
      "end_ms": 274655,
      "text": "他们敬畏自然，",
      "token_start": 970,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 274990,
      "end_ms": 276175,
      "text": "顺应天时。",
      "token_start": 976,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 276870,
      "end_ms": 277750,
      "text": "几百年来，",
      "token_start": 980,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 278150,
      "end_ms": 280614,
      "text": "从不把得失放在心上，",
      "token_start": 984,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 280980,
      "end_ms": 283715,
      "text": "知足常乐的山民性情，",
      "token_start": 993,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 284350,
      "end_ms": 287195,
      "text": "把日子过成了神仙般的悠长。",
      "token_start": 1002,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 287790,
      "end_ms": 289010,
      "text": "您说不可思议，",
      "token_start": 1014,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 289010,
      "end_ms": 290175,
      "text": "不第六名。",
      "token_start": 1020,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 291010,
      "end_ms": 297290,
      "text": "湖北钟祥客店镇水平村坐拥千年古树群的荆楚古村落。",
      "token_start": 1024,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 297990,
      "end_ms": 303690,
      "text": "水坪村拥有上百棵数百年甚至上千年的参天古银杏，",
      "token_start": 1047,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 304470,
      "end_ms": 308410,
      "text": "而村里八九十岁的老寿星更是数不胜数，",
      "token_start": 1069,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 308910,
      "end_ms": 310570,
      "text": "这里自古文风昌盛，",
      "token_start": 1086,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 311470,
      "end_ms": 313810,
      "text": "明清以来的宗祠与石碑上，",
      "token_start": 1094,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 314290,
      "end_ms": 317810,
      "text": "密密麻麻刻满了相邻敬老的族规家训。",
      "token_start": 1105,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 318190,
      "end_ms": 322500,
      "text": "您漫步在铺满金色银杏树叶的青石古道上，",
      "token_start": 1121,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 323080,
      "end_ms": 326100,
      "text": "三百年树龄的大树遮天蔽日，",
      "token_start": 1139,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 326580,
      "end_ms": 331000,
      "text": "八九十岁的老寿星们正坐在石磨旁围炉煮茶，",
      "token_start": 1151,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 331420,
      "end_ms": 332260,
      "text": "谈笑间，",
      "token_start": 1170,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 332540,
      "end_ms": 333520,
      "text": "神采奕奕。",
      "token_start": 1173,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 333840,
      "end_ms": 335380,
      "text": "几百年风雨过去，",
      "token_start": 1177,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 335980,
      "end_ms": 338540,
      "text": "战乱毁掉了无数亭台楼阁，",
      "token_start": 1184,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 339100,
      "end_ms": 342660,
      "text": "但水平村敬老养老的家风一代也没断过，",
      "token_start": 1195,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 343280,
      "end_ms": 345900,
      "text": "古树长青、仁义长寿，",
      "token_start": 1212,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 346520,
      "end_ms": 349975,
      "text": "这是荆楚大地最深沉的岁月回响。",
      "token_start": 1220,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 350320,
      "end_ms": 352620,
      "text": "从第十到第六名长青村，",
      "token_start": 1234,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 352640,
      "end_ms": 354705,
      "text": "让平原打破了高山神话。",
      "token_start": 1244,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 355180,
      "end_ms": 356060,
      "text": "三山岛村，",
      "token_start": 1254,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 356060,
      "end_ms": 358345,
      "text": "让北方海边活出了硬朗筋骨。",
      "token_start": 1258,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 358880,
      "end_ms": 363050,
      "text": "石鼓坪村用土楼围拢起四世同堂漫水村，",
      "token_start": 1270,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 363050,
      "end_ms": 368885,
      "text": "把苗歌唱进了百岁岁月水平村在千年古树下守住了敬老风谷。",
      "token_start": 1287,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 369710,
      "end_ms": 372045,
      "text": "可他们还不是最不可思议的。",
      "token_start": 1313,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 372450,
      "end_ms": 374745,
      "text": "接下来第五道第一名更让人惊叹，",
      "token_start": 1325,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 375330,
      "end_ms": 377890,
      "text": "有一座村庄把长寿过成了溪流，",
      "token_start": 1339,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 377890,
      "end_ms": 379475,
      "text": "茶香里的神仙日子，",
      "token_start": 1352,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 379830,
      "end_ms": 382155,
      "text": "还有一座天下闻名的神仙福地，",
      "token_start": 1360,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 382440,
      "end_ms": 384485,
      "text": "被所有人当成了终极答案，",
      "token_start": 1373,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 384880,
      "end_ms": 389335,
      "text": "可排在榜首的那座村子不在山清水秀之地，",
      "token_start": 1384,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 389850,
      "end_ms": 392995,
      "text": "反而深嵌在大漠狂风的边缘。",
      "token_start": 1402,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 393540,
      "end_ms": 394395,
      "text": "他是哪座？",
      "token_start": 1414,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 394830,
      "end_ms": 397415,
      "text": "他凭什么排在广西巴马前面，",
      "token_start": 1418,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 397860,
      "end_ms": 399945,
      "text": "下一集已经同步更新，",
      "token_start": 1430,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 400740,
      "end_ms": 401980,
      "text": "点开我的头像，",
      "token_start": 1439,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 402020,
      "end_ms": 405495,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1445,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 405960,
      "end_ms": 409955,
      "text": "看看谁才是中国最不可思议的长寿村。",
      "token_start": 1457,
      "token_end_exclusive": 1473
    }
  ],
