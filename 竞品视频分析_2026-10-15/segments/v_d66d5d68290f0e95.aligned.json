{
  "video_id": "v_d66d5d68290f0e95",
  "duration_s": 221.679002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_d66d5d68290f0e95.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_d66d5d68290f0e95.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2850,
      "text": "不喝就是看不起我领导，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3570,
      "end_ms": 4710,
      "text": "我不是看不起您，",
      "token_start": 10,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 5070,
      "end_ms": 6030,
      "text": "我是看不起病，",
      "token_start": 17,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 8850,
      "end_ms": 10210,
      "text": "这鸭子是好鸭子，",
      "token_start": 23,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 10990,
      "end_ms": 11830,
      "text": "就是嘴硬，",
      "token_start": 30,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 13010,
      "end_ms": 13450,
      "text": "嘴硬，",
      "token_start": 34,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 13450,
      "end_ms": 14530,
      "text": "才守得住秘密，",
      "token_start": 36,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 17250,
      "end_ms": 17650,
      "text": "嘴硬，",
      "token_start": 42,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 17670,
      "end_ms": 18610,
      "text": "不怎么喜欢你，",
      "token_start": 44,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 19410,
      "end_ms": 21410,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 50,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 21410,
      "end_ms": 23670,
      "text": "我领导的格局值得我们学习。",
      "token_start": 63,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 26230,
      "end_ms": 27870,
      "text": "领导的格局，",
      "token_start": 75,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 27870,
      "end_ms": 30820,
      "text": "可惜就是刺夺领导。",
      "token_start": 80,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 30820,
      "end_ms": 32120,
      "text": "您看虽然刺多，",
      "token_start": 88,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 32140,
      "end_ms": 34820,
      "text": "但主心骨只有一根心腹是没有刺的。",
      "token_start": 94,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 36200,
      "end_ms": 36800,
      "text": "来就来，",
      "token_start": 109,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 36900,
      "end_ms": 37940,
      "text": "带什么礼物啊，",
      "token_start": 112,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 37960,
      "end_ms": 38900,
      "text": "都不是外人。",
      "token_start": 118,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 39000,
      "end_ms": 39380,
      "text": "哎呀，",
      "token_start": 123,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 39400,
      "end_ms": 40040,
      "text": "您都说了，",
      "token_start": 125,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 40040,
      "end_ms": 40740,
      "text": "不是外人，",
      "token_start": 129,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 40820,
      "end_ms": 42360,
      "text": "我一直都把您当长辈看，",
      "token_start": 133,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 42520,
      "end_ms": 44700,
      "text": "哪有晚辈看长辈空手来的道理啊，",
      "token_start": 143,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 45540,
      "end_ms": 46320,
      "text": "打这么多饭，",
      "token_start": 157,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 46320,
      "end_ms": 47020,
      "text": "你喂猪呢？",
      "token_start": 162,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 47380,
      "end_ms": 47800,
      "text": "领导，",
      "token_start": 166,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 47920,
      "end_ms": 48700,
      "text": "我哪敢啊，",
      "token_start": 168,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 48860,
      "end_ms": 51100,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 172,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 51100,
      "end_ms": 52600,
      "text": "都说宰相肚里能撑船，",
      "token_start": 188,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 52740,
      "end_ms": 53960,
      "text": "更何况只是一碗饭呢。",
      "token_start": 197,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 55640,
      "end_ms": 56840,
      "text": "这藕是好藕啊，",
      "token_start": 206,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 57260,
      "end_ms": 58220,
      "text": "就是心眼太多了。",
      "token_start": 212,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 58220,
      "end_ms": 59420,
      "text": "领导哦，",
      "token_start": 219,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 60020,
      "end_ms": 60880,
      "text": "我虽然心耳多，",
      "token_start": 222,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 60940,
      "end_ms": 62155,
      "text": "但也是那下酒菜呀。",
      "token_start": 228,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 62970,
      "end_ms": 65225,
      "text": "哈哈哈哈哈哈哈小王，",
      "token_start": 236,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 65570,
      "end_ms": 67065,
      "text": "你这菜点的也太多了。",
      "token_start": 245,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 67650,
      "end_ms": 69230,
      "text": "领导菜点的再多，",
      "token_start": 254,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 69230,
      "end_ms": 70590,
      "text": "也比不上平时您对我的照顾。",
      "token_start": 261,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 70590,
      "end_ms": 71290,
      "text": "多这杯酒，",
      "token_start": 273,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 71330,
      "end_ms": 72065,
      "text": "我先敬您。",
      "token_start": 277,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 73930,
      "end_ms": 74270,
      "text": "小李，",
      "token_start": 281,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 74270,
      "end_ms": 75375,
      "text": "最近表现不错啊，",
      "token_start": 283,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 75700,
      "end_ms": 77295,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 290,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 77820,
      "end_ms": 78905,
      "text": "我得提前敬一杯。",
      "token_start": 303,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 79200,
      "end_ms": 79940,
      "text": "听这意思，",
      "token_start": 310,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 80020,
      "end_ms": 81125,
      "text": "领导也要高升了呀，",
      "token_start": 314,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 81420,
      "end_ms": 82600,
      "text": "我得提前敬领导一杯。",
      "token_start": 322,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 83940,
      "end_ms": 84265,
      "text": "哎，",
      "token_start": 331,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 84750,
      "end_ms": 85535,
      "text": "你什么意思啊？",
      "token_start": 332,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 85790,
      "end_ms": 87035,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 338,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 87350,
      "end_ms": 88890,
      "text": "领导美满美满，",
      "token_start": 349,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 88910,
      "end_ms": 89835,
      "text": "代表幸福美满，",
      "token_start": 355,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 90140,
      "end_ms": 91020,
      "text": "这一辈子没满，",
      "token_start": 361,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 91020,
      "end_ms": 92185,
      "text": "就是一辈子没满啊。",
      "token_start": 367,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 92450,
      "end_ms": 93595,
      "text": "哈哈哈哈哈哈哈，",
      "token_start": 375,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 93800,
      "end_ms": 95635,
      "text": "和你这么漂亮的女孩吃饭，",
      "token_start": 382,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 95990,
      "end_ms": 97505,
      "text": "不用喝就已经醉了。",
      "token_start": 393,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 98100,
      "end_ms": 98500,
      "text": "领导，",
      "token_start": 401,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 98580,
      "end_ms": 99355,
      "text": "您真幽默，",
      "token_start": 403,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 99700,
      "end_ms": 100500,
      "text": "您还没沾久，",
      "token_start": 407,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 100560,
      "end_ms": 101595,
      "text": "就让我沾光了，",
      "token_start": 412,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 103770,
      "end_ms": 104785,
      "text": "今天让你破费了。",
      "token_start": 418,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 105110,
      "end_ms": 105575,
      "text": "领导，",
      "token_start": 425,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 105880,
      "end_ms": 107340,
      "text": "您说这些您能来，",
      "token_start": 427,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 107340,
      "end_ms": 108105,
      "text": "就是我的荣幸，",
      "token_start": 434,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 108610,
      "end_ms": 110130,
      "text": "以后还有很多地方向您请教。",
      "token_start": 440,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 110130,
      "end_ms": 110915,
      "text": "不是啊，",
      "token_start": 452,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 111410,
      "end_ms": 112715,
      "text": "哈哈哈哈哈哈哈哈，",
      "token_start": 455,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 112900,
      "end_ms": 113860,
      "text": "你酒量挺好的。",
      "token_start": 463,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 113860,
      "end_ms": 114880,
      "text": "呀张总，",
      "token_start": 469,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 114940,
      "end_ms": 115895,
      "text": "您可抬举我了，",
      "token_start": 472,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 116060,
      "end_ms": 117195,
      "text": "我平时真不太能喝，",
      "token_start": 478,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 117490,
      "end_ms": 118790,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 486,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 118790,
      "end_ms": 119290,
      "text": "高兴啊，",
      "token_start": 497,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 119310,
      "end_ms": 120825,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 500,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 121050,
      "end_ms": 124135,
      "text": "哈哈哈哈哈年轻就是好啊，",
      "token_start": 510,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 124720,
      "end_ms": 126025,
      "text": "年轻就是还不够沉稳，",
      "token_start": 521,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 126270,
      "end_ms": 127350,
      "text": "还要向您多学习，",
      "token_start": 530,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 127530,
      "end_ms": 128775,
      "text": "我们才能变得更优秀。",
      "token_start": 537,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 129800,
      "end_ms": 132015,
      "text": "哈哈哈哈哈哈小汪啊，",
      "token_start": 546,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 132530,
      "end_ms": 134030,
      "text": "你个子是真高比，",
      "token_start": 555,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 134030,
      "end_ms": 134995,
      "text": "我还高一头呢。",
      "token_start": 562,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 135720,
      "end_ms": 137540,
      "text": "个高是为了给领导探路走，",
      "token_start": 568,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 137540,
      "end_ms": 139015,
      "text": "哪不还是得听领导指挥吗？",
      "token_start": 579,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 139850,
      "end_ms": 141965,
      "text": "哈哈哈小王儿啊，",
      "token_start": 590,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 142430,
      "end_ms": 144065,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 597,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 144490,
      "end_ms": 147035,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 607,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 147390,
      "end_ms": 149530,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 620,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 150790,
      "end_ms": 152415,
      "text": "你一开口就让人喜欢你，",
      "token_start": 633,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 152650,
      "end_ms": 153565,
      "text": "你是怎么做到的？",
      "token_start": 643,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 153870,
      "end_ms": 156010,
      "text": "因为我一直在看这本闲谈高手，",
      "token_start": 650,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 156190,
      "end_ms": 157970,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 663,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 158030,
      "end_ms": 159890,
      "text": "那些会说话、会来事儿的人。",
      "token_start": 674,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 160030,
      "end_ms": 161130,
      "text": "假如你不爱说话，",
      "token_start": 685,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 161270,
      "end_ms": 161950,
      "text": "不爱争辩，",
      "token_start": 692,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 162090,
      "end_ms": 162910,
      "text": "也不爱出门，",
      "token_start": 696,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 163030,
      "end_ms": 164285,
      "text": "甚至恐惧社交。",
      "token_start": 701,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 164610,
      "end_ms": 166535,
      "text": "推荐你读完这本闲谈高手，",
      "token_start": 707,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 166840,
      "end_ms": 169025,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 718,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 169380,
      "end_ms": 170560,
      "text": "你每天就看两页，",
      "token_start": 730,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 170700,
      "end_ms": 172075,
      "text": "每一个场景慢慢练，",
      "token_start": 737,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 172360,
      "end_ms": 174980,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 745,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 175100,
      "end_ms": 176480,
      "text": "在这本书里有一句话，",
      "token_start": 760,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 176500,
      "end_ms": 177405,
      "text": "我特别欣赏，",
      "token_start": 769,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 177730,
      "end_ms": 177870,
      "text": "他，",
      "token_start": 774,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 177870,
      "end_ms": 179945,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 775,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 180170,
      "end_ms": 180855,
      "text": "你可以回，",
      "token_start": 787,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 181320,
      "end_ms": 182300,
      "text": "那是不优秀点，",
      "token_start": 791,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 182340,
      "end_ms": 183635,
      "text": "怎么能和你做朋友呢？",
      "token_start": 797,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 184010,
      "end_ms": 185650,
      "text": "当有人说你真聪明，",
      "token_start": 806,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 185750,
      "end_ms": 187475,
      "text": "你就回近朱者赤，",
      "token_start": 814,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 187790,
      "end_ms": 188635,
      "text": "和你在一起啊，",
      "token_start": 821,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 188880,
      "end_ms": 191900,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 827,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 191960,
      "end_ms": 193140,
      "text": "你就回领导，",
      "token_start": 842,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 193340,
      "end_ms": 194615,
      "text": "这都是我应该做的。",
      "token_start": 847,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 194920,
      "end_ms": 196260,
      "text": "强将手下吴若冰，",
      "token_start": 855,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 196540,
      "end_ms": 197985,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 862,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 198220,
      "end_ms": 199560,
      "text": "当我看到这段的时候，",
      "token_start": 871,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 199640,
      "end_ms": 201495,
      "text": "这个真是让我一解心开啊。",
      "token_start": 880,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 201770,
      "end_ms": 203025,
      "text": "每一句都很有意思，",
      "token_start": 891,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 203370,
      "end_ms": 206490,
      "text": "就是手把手教我们在不同的场景之下应该怎么说。",
      "token_start": 899,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 206770,
      "end_ms": 209435,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 920,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 209680,
      "end_ms": 211000,
      "text": "你就放心的拿回去看，",
      "token_start": 938,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 211360,
      "end_ms": 212780,
      "text": "就是一句一句的教你，",
      "token_start": 947,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 213000,
      "end_ms": 215455,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 956,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 215800,
      "end_ms": 216880,
      "text": "但凡学会三分，",
      "token_start": 968,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 217080,
      "end_ms": 219475,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 974,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 219880,
      "end_ms": 221555,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 988,
      "token_end_exclusive": 1000
    }
