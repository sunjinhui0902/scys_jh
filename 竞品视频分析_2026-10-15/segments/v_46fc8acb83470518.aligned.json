{
  "video_id": "v_46fc8acb83470518",
  "duration_s": 156.780998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_46fc8acb83470518.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_46fc8acb83470518.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 400,
      "end_ms": 800,
      "text": "朱君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1080,
      "end_ms": 1880,
      "text": "你相信吗？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2160,
      "end_ms": 3840,
      "text": "拼命的时代已经过去了，",
      "token_start": 6,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3980,
      "end_ms": 5880,
      "text": "现在是保命的时代，",
      "token_start": 16,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6180,
      "end_ms": 8100,
      "text": "很多事儿你不做就是赢，",
      "token_start": 24,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 8380,
      "end_ms": 9000,
      "text": "不贪吃，",
      "token_start": 34,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 9100,
      "end_ms": 9720,
      "text": "不熬夜，",
      "token_start": 37,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 9720,
      "end_ms": 10320,
      "text": "不生气，",
      "token_start": 40,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 10480,
      "end_ms": 12940,
      "text": "彻底远离消耗你的人和事儿。",
      "token_start": 43,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 12960,
      "end_ms": 14160,
      "text": "健康的活下去，",
      "token_start": 55,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 14160,
      "end_ms": 16320,
      "text": "就是在吃这个时代的红利。",
      "token_start": 61,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 16320,
      "end_ms": 19160,
      "text": "我们将在九月七号迎来一年中最舒服。",
      "token_start": 72,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 19160,
      "end_ms": 21060,
      "text": "一天白白露节气，",
      "token_start": 88,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 21660,
      "end_ms": 23880,
      "text": "白露白露藏而不白，",
      "token_start": 95,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 24180,
      "end_ms": 26640,
      "text": "白鹭之天天开始做一件事儿，",
      "token_start": 103,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 26940,
      "end_ms": 28080,
      "text": "收草木，",
      "token_start": 115,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 28220,
      "end_ms": 29760,
      "text": "收起繁盛庄稼，",
      "token_start": 118,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 29820,
      "end_ms": 30730,
      "text": "收锋芒，",
      "token_start": 124,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 31030,
      "end_ms": 35290,
      "text": "白昼也一点点收短人活到一定年纪也该如此。",
      "token_start": 127,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 35590,
      "end_ms": 36310,
      "text": "少解释，",
      "token_start": 146,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 36670,
      "end_ms": 37450,
      "text": "少炫耀，",
      "token_start": 149,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 37670,
      "end_ms": 38410,
      "text": "少证明，",
      "token_start": 152,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 38830,
      "end_ms": 39850,
      "text": "尤其身弱之人，",
      "token_start": 155,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 39850,
      "end_ms": 42530,
      "text": "更不能说出自己的计划不提家业，",
      "token_start": 161,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 42690,
      "end_ms": 44150,
      "text": "不透露实际的收入。",
      "token_start": 175,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 44270,
      "end_ms": 45650,
      "text": "不说未成之事，",
      "token_start": 183,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 46050,
      "end_ms": 46830,
      "text": "受过的苦，",
      "token_start": 189,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 46830,
      "end_ms": 49330,
      "text": "不要反复对别人讲讲多了，",
      "token_start": 193,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 49330,
      "end_ms": 50570,
      "text": "可能会再经历一遍，",
      "token_start": 204,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 50850,
      "end_ms": 52550,
      "text": "往往好事不成坏事，",
      "token_start": 212,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 52550,
      "end_ms": 54670,
      "text": "一说就成别为了获得共鸣，",
      "token_start": 220,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 54850,
      "end_ms": 56470,
      "text": "讲起过往没完没了，",
      "token_start": 231,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 56950,
      "end_ms": 57730,
      "text": "仔细想想，",
      "token_start": 239,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 57910,
      "end_ms": 59370,
      "text": "你哪次滔滔不绝后，",
      "token_start": 243,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 59370,
      "end_ms": 60585,
      "text": "带来的不是欢悔恨。",
      "token_start": 251,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 60860,
      "end_ms": 64705,
      "text": "诸君在这两天你会明白何谓露从今夜白？",
      "token_start": 259,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 65110,
      "end_ms": 65810,
      "text": "白露之后，",
      "token_start": 276,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 65950,
      "end_ms": 67325,
      "text": "昼夜温差明显，",
      "token_start": 280,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 67620,
      "end_ms": 69515,
      "text": "从此天凉好个秋。",
      "token_start": 286,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 69960,
      "end_ms": 72875,
      "text": "真正好的关系都有一点秋天的感觉，",
      "token_start": 293,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 73260,
      "end_ms": 74715,
      "text": "不喧哗、不灼热，",
      "token_start": 308,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 75000,
      "end_ms": 76805,
      "text": "却有恰到好处的温度，",
      "token_start": 314,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 77190,
      "end_ms": 77715,
      "text": "清凉，",
      "token_start": 323,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 78040,
      "end_ms": 79375,
      "text": "清醒清净。",
      "token_start": 325,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 79990,
      "end_ms": 82785,
      "text": "白露秋分夜一夜凉一夜。",
      "token_start": 329,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 83130,
      "end_ms": 83890,
      "text": "白露时节，",
      "token_start": 339,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 83910,
      "end_ms": 86645,
      "text": "很多农作物正在经历丰收前的沉默。",
      "token_start": 343,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 86940,
      "end_ms": 89135,
      "text": "我们可以尝试向天地自然学习。",
      "token_start": 358,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 89440,
      "end_ms": 90645,
      "text": "半隐半藏。",
      "token_start": 371,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 91140,
      "end_ms": 91500,
      "text": "其实，",
      "token_start": 375,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 91500,
      "end_ms": 93185,
      "text": "除了赚钱和日常生活以外，",
      "token_start": 377,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 93450,
      "end_ms": 95685,
      "text": "人不需要太多的社交和喧闹，",
      "token_start": 388,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 96020,
      "end_ms": 98035,
      "text": "旅行也解决不了生活的苦，",
      "token_start": 400,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 98280,
      "end_ms": 99705,
      "text": "我们需要的是安静，",
      "token_start": 411,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 100040,
      "end_ms": 100735,
      "text": "你相信吗？",
      "token_start": 419,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 101090,
      "end_ms": 102490,
      "text": "如果你想多活几年，",
      "token_start": 423,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 102490,
      "end_ms": 103895,
      "text": "不是靠吃什么补品，",
      "token_start": 431,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 104100,
      "end_ms": 105560,
      "text": "也不是玩命的去健身。",
      "token_start": 439,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 105760,
      "end_ms": 107040,
      "text": "就一招很简单，",
      "token_start": 448,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 107360,
      "end_ms": 108695,
      "text": "离人群远一点，",
      "token_start": 454,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 109060,
      "end_ms": 111005,
      "text": "人最好的状态就是销声匿迹。",
      "token_start": 460,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 111470,
      "end_ms": 114405,
      "text": "每一个把自己藏起来的人都在打一场硬仗，",
      "token_start": 472,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 114670,
      "end_ms": 116480,
      "text": "这就是秋收冬藏，",
      "token_start": 490,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 116900,
      "end_ms": 117840,
      "text": "收敛锋芒，",
      "token_start": 497,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 118020,
      "end_ms": 118985,
      "text": "蕴藏能量。",
      "token_start": 501,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 119400,
      "end_ms": 119700,
      "text": "周君，",
      "token_start": 505,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 119700,
      "end_ms": 121220,
      "text": "你看白露节气，",
      "token_start": 507,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 121240,
      "end_ms": 123035,
      "text": "真正的秋天已经来了。",
      "token_start": 513,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 123410,
      "end_ms": 124390,
      "text": "凉风乍起，",
      "token_start": 522,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 124570,
      "end_ms": 125630,
      "text": "倦鸟归林，",
      "token_start": 526,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 125830,
      "end_ms": 126870,
      "text": "山河沉寂，",
      "token_start": 530,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 127090,
      "end_ms": 128135,
      "text": "万物蛰伏。",
      "token_start": 534,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 128670,
      "end_ms": 130055,
      "text": "当你开始变得沉默，",
      "token_start": 538,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 130340,
      "end_ms": 131995,
      "text": "不再有向别人解释的欲望，",
      "token_start": 546,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 132280,
      "end_ms": 134940,
      "text": "不再渴望寻求别人的理解、说话，",
      "token_start": 557,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 134960,
      "end_ms": 136780,
      "text": "直击问题的本质和要害，",
      "token_start": 570,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 136920,
      "end_ms": 138420,
      "text": "做事也杀伐果断，",
      "token_start": 580,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 138420,
      "end_ms": 139315,
      "text": "不拖泥带水，",
      "token_start": 587,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 139690,
      "end_ms": 141810,
      "text": "逐渐明白了言多必失的危害，",
      "token_start": 592,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 142010,
      "end_ms": 142805,
      "text": "那么恭喜你，",
      "token_start": 604,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 143030,
      "end_ms": 145065,
      "text": "你已经开始脱胎换骨了。",
      "token_start": 609,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 145450,
      "end_ms": 146790,
      "text": "在繁华中自律，",
      "token_start": 619,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 146870,
      "end_ms": 148365,
      "text": "在落魄中自愈。",
      "token_start": 625,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 148960,
      "end_ms": 151080,
      "text": "我喜欢白鹭秀而不媚，",
      "token_start": 631,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 151300,
      "end_ms": 152325,
      "text": "清而不寒，",
      "token_start": 640,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 152700,
      "end_ms": 154140,
      "text": "金风玉露一相逢，",
      "token_start": 644,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 154140,
      "end_ms": 156435,
      "text": "便胜却人间无数。",
      "token_start": 651,
      "token_end_exclusive": 658
    }
  ],
