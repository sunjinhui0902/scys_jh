{
  "video_id": "v_38a9aa6c85ba92e8",
  "duration_s": 159.72,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_38a9aa6c85ba92e8.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_38a9aa6c85ba92e8.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 530,
      "end_ms": 930,
      "text": "朱君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1330,
      "end_ms": 3850,
      "text": "你觉得七月半烧纸是迷信吗？",
      "token_start": 2,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 4250,
      "end_ms": 6190,
      "text": "不是中元节烧的，",
      "token_start": 14,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 6190,
      "end_ms": 7030,
      "text": "不单单是纸，",
      "token_start": 21,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7210,
      "end_ms": 8710,
      "text": "而是未报的那份恩情。",
      "token_start": 26,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 9150,
      "end_ms": 10730,
      "text": "曾经带你上坟的人，",
      "token_start": 35,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 10970,
      "end_ms": 13250,
      "text": "成了等你去给他上坟的人，",
      "token_start": 43,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 13610,
      "end_ms": 14230,
      "text": "你知道吗？",
      "token_start": 54,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 14230,
      "end_ms": 15770,
      "text": "中元节并不是鬼节，",
      "token_start": 58,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 15970,
      "end_ms": 17490,
      "text": "而是中国人的思念节。",
      "token_start": 66,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 17810,
      "end_ms": 18870,
      "text": "小时候怕鬼，",
      "token_start": 75,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 19130,
      "end_ms": 20310,
      "text": "长大了以后才发现，",
      "token_start": 80,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 20330,
      "end_ms": 24910,
      "text": "真正让人难过的是这个世界上已经没有那个你想见的人。",
      "token_start": 88,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 25530,
      "end_ms": 29070,
      "text": "如果七月半他们真的能够回来一天该有多好。",
      "token_start": 112,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 29070,
      "end_ms": 30880,
      "text": "人到中年，",
      "token_start": 131,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 30940,
      "end_ms": 33860,
      "text": "再听见七月半想到的是爷爷奶奶，",
      "token_start": 135,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 33940,
      "end_ms": 34640,
      "text": "是父母，",
      "token_start": 149,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 34840,
      "end_ms": 35540,
      "text": "是故乡，",
      "token_start": 152,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 35840,
      "end_ms": 38300,
      "text": "是小时候那张已经坐不满的饭桌。",
      "token_start": 155,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 38800,
      "end_ms": 39600,
      "text": "你有没有发现，",
      "token_start": 169,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 39600,
      "end_ms": 40580,
      "text": "当你烧纸的时候，",
      "token_start": 175,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 40580,
      "end_ms": 42000,
      "text": "不管你站在哪个方向，",
      "token_start": 182,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 42200,
      "end_ms": 44340,
      "text": "那烟和火都会吹向你。",
      "token_start": 191,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 44680,
      "end_ms": 45700,
      "text": "故人轻拂，",
      "token_start": 200,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 45760,
      "end_ms": 46419,
      "text": "金人眉，",
      "token_start": 204,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 46660,
      "end_ms": 48340,
      "text": "为尔抹去半生灾。",
      "token_start": 207,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 48880,
      "end_ms": 50680,
      "text": "清明节是我们去看故人，",
      "token_start": 214,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 50860,
      "end_ms": 52780,
      "text": "中元节是故人来看我们。",
      "token_start": 224,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 53260,
      "end_ms": 56480,
      "text": "你知道经常上坟和不上坟的人有什么区别吗？",
      "token_start": 234,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 56660,
      "end_ms": 57700,
      "text": "人长大之后，",
      "token_start": 253,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 57700,
      "end_ms": 59240,
      "text": "突然就不再害怕上坟。",
      "token_start": 258,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 59620,
      "end_ms": 60590,
      "text": "人到中年，",
      "token_start": 267,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 60650,
      "end_ms": 62050,
      "text": "突然开始理解，",
      "token_start": 271,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 62050,
      "end_ms": 63530,
      "text": "祭祖在中国，",
      "token_start": 277,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 63710,
      "end_ms": 65370,
      "text": "佛你可以不拜神，",
      "token_start": 282,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 65550,
      "end_ms": 66310,
      "text": "你可以不敬，",
      "token_start": 289,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 66430,
      "end_ms": 68235,
      "text": "但祖先不能不祭死。",
      "token_start": 294,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 68530,
      "end_ms": 68975,
      "text": "为什么？",
      "token_start": 302,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 69190,
      "end_ms": 70550,
      "text": "因为佛有他的寺庙，",
      "token_start": 305,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 70690,
      "end_ms": 71790,
      "text": "神有他的道观，",
      "token_start": 313,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 72030,
      "end_ms": 73630,
      "text": "如果祖先不祭祀的话，",
      "token_start": 319,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 73650,
      "end_ms": 75190,
      "text": "就变成了孤魂野鬼。",
      "token_start": 328,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 75410,
      "end_ms": 77325,
      "text": "所以中元节一定要祭祖，",
      "token_start": 336,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 77790,
      "end_ms": 78170,
      "text": "死亡，",
      "token_start": 346,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 78170,
      "end_ms": 78850,
      "text": "不是终点，",
      "token_start": 348,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 78970,
      "end_ms": 79815,
      "text": "遗忘才是。",
      "token_start": 352,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 80110,
      "end_ms": 81490,
      "text": "只要还有人记得你，",
      "token_start": 356,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 81510,
      "end_ms": 83875,
      "text": "你就仍然活在这个世界的某个角落。",
      "token_start": 364,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 84400,
      "end_ms": 86060,
      "text": "如果烧纸都算迷信的话，",
      "token_start": 379,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 86100,
      "end_ms": 87320,
      "text": "那过生日点蜡烛，",
      "token_start": 389,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 87320,
      "end_ms": 88565,
      "text": "许愿也是迷信了，",
      "token_start": 396,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 88830,
      "end_ms": 90470,
      "text": "对着一块蛋糕都能许愿的人，",
      "token_start": 403,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 90470,
      "end_ms": 92265,
      "text": "凭什么去嘲笑别人的信仰？",
      "token_start": 415,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 92720,
      "end_ms": 94440,
      "text": "中国人很少说我想你，",
      "token_start": 426,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 94620,
      "end_ms": 97005,
      "text": "于是把思念直接藏进了七月半，",
      "token_start": 435,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 97320,
      "end_ms": 98060,
      "text": "烧一炷香，",
      "token_start": 448,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 98240,
      "end_ms": 98940,
      "text": "献一束花，",
      "token_start": 452,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 99100,
      "end_ms": 101235,
      "text": "做一道他生前最喜欢吃的菜。",
      "token_start": 456,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 101710,
      "end_ms": 103790,
      "text": "中元节最大的意义是提醒我们，",
      "token_start": 468,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 103870,
      "end_ms": 105085,
      "text": "后仰博葬。",
      "token_start": 481,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 105540,
      "end_ms": 107880,
      "text": "中元节最应该烧给父母的不是纸钱，",
      "token_start": 485,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 108140,
      "end_ms": 109780,
      "text": "而是趁他们还在的时候，",
      "token_start": 500,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 109820,
      "end_ms": 111315,
      "text": "多陪他们吃几顿饭，",
      "token_start": 510,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 111790,
      "end_ms": 114950,
      "text": "别把所有的思念都留到只能思念的时候，",
      "token_start": 518,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 115370,
      "end_ms": 116270,
      "text": "好好陪家人，",
      "token_start": 535,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 116470,
      "end_ms": 117925,
      "text": "好好过自己的人生。",
      "token_start": 540,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 118350,
      "end_ms": 120365,
      "text": "因为我们今天认真生活的样子，",
      "token_start": 548,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 120620,
      "end_ms": 122755,
      "text": "也会成为后辈关于我们的记忆。",
      "token_start": 561,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 123340,
      "end_ms": 124780,
      "text": "所谓慎终追远，",
      "token_start": 574,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 124920,
      "end_ms": 126385,
      "text": "就是趁一切还来得及，",
      "token_start": 580,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 126660,
      "end_ms": 128015,
      "text": "好好珍惜眼前人。",
      "token_start": 589,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 128660,
      "end_ms": 129040,
      "text": "朱军，",
      "token_start": 596,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 129340,
      "end_ms": 130700,
      "text": "如果中元节这一天，",
      "token_start": 598,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 130720,
      "end_ms": 131920,
      "text": "你已经离开的亲人，",
      "token_start": 606,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 131920,
      "end_ms": 132975,
      "text": "真的可以回来一天。",
      "token_start": 614,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 133230,
      "end_ms": 134525,
      "text": "你最想带他去哪里？",
      "token_start": 622,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 134880,
      "end_ms": 137720,
      "text": "我想很多人的答案并不是去什么多么昂贵的地方，",
      "token_start": 630,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 137900,
      "end_ms": 140535,
      "text": "可能只是再回一次老家的房子，",
      "token_start": 651,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 140810,
      "end_ms": 142195,
      "text": "再吃一次妈妈做的饭，",
      "token_start": 664,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 142440,
      "end_ms": 144395,
      "text": "让爷爷看看自己现在的孩子，",
      "token_start": 673,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 144630,
      "end_ms": 145330,
      "text": "告诉奶奶，",
      "token_start": 685,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 145450,
      "end_ms": 146730,
      "text": "我现在过得挺好，",
      "token_start": 689,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 146910,
      "end_ms": 147905,
      "text": "你不用担心，",
      "token_start": 696,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 148640,
      "end_ms": 150240,
      "text": "甚至什么都不用做，",
      "token_start": 701,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 150500,
      "end_ms": 152205,
      "text": "就想再和他坐一会儿。",
      "token_start": 709,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 152730,
      "end_ms": 153450,
      "text": "又到一年，",
      "token_start": 718,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 153450,
      "end_ms": 154125,
      "text": "中元节，",
      "token_start": 722,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 154440,
      "end_ms": 155885,
      "text": "记得去看望我们的祖先，",
      "token_start": 725,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 156190,
      "end_ms": 157235,
      "text": "轻声说一句，",
      "token_start": 735,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 157600,
      "end_ms": 158325,
      "text": "爷爷奶奶。",
      "token_start": 740,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 158660,
      "end_ms": 159405,
      "text": "我想你们。",
      "token_start": 744,
      "token_end_exclusive": 748
    }
  ],
