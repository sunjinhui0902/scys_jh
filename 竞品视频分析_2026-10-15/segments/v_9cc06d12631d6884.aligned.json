{
  "video_id": "v_9cc06d12631d6884",
  "duration_s": 314.458333,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_9cc06d12631d6884.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_9cc06d12631d6884.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 1910,
      "text": "诺奖公布的前几天，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2210,
      "end_ms": 6630,
      "text": "全世界赌桌上赔率排第一的是个中国女人。",
      "token_start": 8,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7450,
      "end_ms": 10350,
      "text": "可你要是随便上街拦个人问，",
      "token_start": 26,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 10450,
      "end_ms": 11670,
      "text": "认不认识残雪。",
      "token_start": 38,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12070,
      "end_ms": 12850,
      "text": "十个人里，",
      "token_start": 44,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 12850,
      "end_ms": 13770,
      "text": "九个得摇头，",
      "token_start": 48,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 14490,
      "end_ms": 19270,
      "text": "一个让外国人排队翻译排队研究排队读的中国作家。",
      "token_start": 53,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 19830,
      "end_ms": 24310,
      "text": "咱自己人愣是没几个人听说过她他到底是谁，",
      "token_start": 75,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 24550,
      "end_ms": 25510,
      "text": "他凭什么。",
      "token_start": 94,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 27010,
      "end_ms": 28130,
      "text": "今天这段的，",
      "token_start": 98,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 28610,
      "end_ms": 30000,
      "text": "咱就好好讲讲这个人，",
      "token_start": 103,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 30120,
      "end_ms": 32500,
      "text": "把中国文学写进了世界，",
      "token_start": 112,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 32880,
      "end_ms": 36040,
      "text": "却差点被自己人忘了的名字。",
      "token_start": 122,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 36180,
      "end_ms": 38240,
      "text": "你要是猜他是书香门第，",
      "token_start": 134,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38680,
      "end_ms": 39800,
      "text": "名校出身，",
      "token_start": 144,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 40120,
      "end_ms": 45020,
      "text": "那可真就想差了他血本名邓小华。",
      "token_start": 148,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 45480,
      "end_ms": 49560,
      "text": "一九五三年五月三十号生在湖南长沙，",
      "token_start": 162,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 50280,
      "end_ms": 51960,
      "text": "一爹邓君鸿，",
      "token_start": 178,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 52580,
      "end_ms": 53980,
      "text": "当年是新湖南报，",
      "token_start": 183,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 54280,
      "end_ms": 61265,
      "text": "就是今天湖南日报的前身的社长兼总编辑娘也是报社的有真文化，",
      "token_start": 190,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 61790,
      "end_ms": 63705,
      "text": "后来还写了本永州旧事，",
      "token_start": 218,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 64180,
      "end_ms": 65455,
      "text": "兄弟姐妹八个，",
      "token_start": 228,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 65840,
      "end_ms": 66905,
      "text": "住在大院里，",
      "token_start": 234,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 67130,
      "end_ms": 69065,
      "text": "家里书多的能铺一地。",
      "token_start": 239,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 69640,
      "end_ms": 73565,
      "text": "按理说这样人家的孩子路都是铺好的，",
      "token_start": 248,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 74360,
      "end_ms": 76000,
      "text": "可命运的巴掌来的。",
      "token_start": 264,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 76000,
      "end_ms": 76845,
      "text": "比谁都快。",
      "token_start": 272,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 77820,
      "end_ms": 78885,
      "text": "一九五七年，",
      "token_start": 276,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 79260,
      "end_ms": 81445,
      "text": "父亲被错划成右派，",
      "token_start": 281,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 82010,
      "end_ms": 82775,
      "text": "一夜之间，",
      "token_start": 289,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 83260,
      "end_ms": 84225,
      "text": "家道中落，",
      "token_start": 293,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 84930,
      "end_ms": 88145,
      "text": "四岁的残雪被送到外婆跟前。",
      "token_start": 297,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 88730,
      "end_ms": 91895,
      "text": "这个外婆是个湘西南的老太太，",
      "token_start": 309,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 92270,
      "end_ms": 94315,
      "text": "一身楚地的老习俗，",
      "token_start": 322,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 94890,
      "end_ms": 97090,
      "text": "半夜起来手里拿根木棒，",
      "token_start": 330,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 97430,
      "end_ms": 98895,
      "text": "在天井里赶鬼，",
      "token_start": 340,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 99370,
      "end_ms": 100775,
      "text": "谁家孩子不舒服，",
      "token_start": 346,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 101070,
      "end_ms": 102805,
      "text": "他拿唾沫给人抹一抹，",
      "token_start": 353,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 103190,
      "end_ms": 107125,
      "text": "闲着没事儿就编些世上没有的故事，",
      "token_start": 362,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 107430,
      "end_ms": 108225,
      "text": "哄孩子，",
      "token_start": 377,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 108990,
      "end_ms": 110990,
      "text": "小残雪就蹲在旁边看，",
      "token_start": 380,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 111090,
      "end_ms": 112655,
      "text": "有时候还跟着搭把手，",
      "token_start": 389,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 113470,
      "end_ms": 116185,
      "text": "这些事儿他记了一辈子。",
      "token_start": 398,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 116970,
      "end_ms": 119250,
      "text": "后来一字不落，",
      "token_start": 408,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 119270,
      "end_ms": 120525,
      "text": "全写进了书里，",
      "token_start": 414,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 121450,
      "end_ms": 122635,
      "text": "可天不饶人，",
      "token_start": 420,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 123760,
      "end_ms": 124260,
      "text": "残雪。",
      "token_start": 425,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 124360,
      "end_ms": 125265,
      "text": "七岁那年，",
      "token_start": 427,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 126090,
      "end_ms": 130860,
      "text": "外婆终究还是没能熬过那几年的饥荒，",
      "token_start": 431,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 130900,
      "end_ms": 133445,
      "text": "岁月撒手人寰哪，",
      "token_start": 447,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 134380,
      "end_ms": 137425,
      "text": "这是他这辈子最狠的一道疤。",
      "token_start": 454,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 138440,
      "end_ms": 141580,
      "text": "一个七八岁的孩子连着尝够了，",
      "token_start": 466,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 141580,
      "end_ms": 142915,
      "text": "什么叫天塌了？",
      "token_start": 479,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 144650,
      "end_ms": 145595,
      "text": "一九六六年，",
      "token_start": 485,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 146160,
      "end_ms": 150245,
      "text": "残学小学刚毕业书就念到头了，",
      "token_start": 490,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 150730,
      "end_ms": 151795,
      "text": "那一年往后，",
      "token_start": 503,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 152190,
      "end_ms": 153815,
      "text": "他再也没进过学校的门，",
      "token_start": 508,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 154060,
      "end_ms": 154875,
      "text": "可他不认命，",
      "token_start": 518,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 155270,
      "end_ms": 156050,
      "text": "没学上，",
      "token_start": 523,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 156130,
      "end_ms": 157115,
      "text": "他就自己学。",
      "token_start": 526,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 157530,
      "end_ms": 158445,
      "text": "翻旧书，",
      "token_start": 531,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 158850,
      "end_ms": 160785,
      "text": "啃西方那些大师的作品，",
      "token_start": 534,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 161680,
      "end_ms": 162375,
      "text": "读哲学，",
      "token_start": 544,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 162870,
      "end_ms": 164815,
      "text": "一个小学文凭的姑娘，",
      "token_start": 547,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 165140,
      "end_ms": 166460,
      "text": "硬是靠着自学，",
      "token_start": 556,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 166800,
      "end_ms": 168240,
      "text": "把别人念一辈子，",
      "token_start": 562,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 168240,
      "end_ms": 169695,
      "text": "大学才能碰的东西，",
      "token_start": 569,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 170210,
      "end_ms": 171435,
      "text": "全都吃进了肚子。",
      "token_start": 577,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 171980,
      "end_ms": 174575,
      "text": "一个小学文凭的姑娘能干啥？",
      "token_start": 584,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 175120,
      "end_ms": 178240,
      "text": "十七岁进街道工厂洗工，",
      "token_start": 596,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 178520,
      "end_ms": 182035,
      "text": "装配工车工一样一样干过来，",
      "token_start": 606,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 182480,
      "end_ms": 184095,
      "text": "手上一道道茧子，",
      "token_start": 618,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 184850,
      "end_ms": 186885,
      "text": "后来被挑去当赤脚医生。",
      "token_start": 625,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 187240,
      "end_ms": 189720,
      "text": "在长沙郊区给人扎针灸，",
      "token_start": 635,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 189740,
      "end_ms": 191805,
      "text": "背着篓子上山采草药，",
      "token_start": 645,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 192640,
      "end_ms": 195745,
      "text": "再往后还去代课教英语。",
      "token_start": 654,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 196210,
      "end_ms": 199595,
      "text": "一个小学毕业的人站上讲台教英语，",
      "token_start": 664,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 200220,
      "end_ms": 202370,
      "text": "你细品品这个，",
      "token_start": 679,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 202370,
      "end_ms": 203325,
      "text": "今天谁敢信？",
      "token_start": 685,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 204390,
      "end_ms": 205845,
      "text": "可那个年月就是这样，",
      "token_start": 690,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 206310,
      "end_ms": 209465,
      "text": "有一双手就得顶上去，",
      "token_start": 699,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 210400,
      "end_ms": 211195,
      "text": "日子是苦，",
      "token_start": 708,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 212040,
      "end_ms": 215435,
      "text": "可这个人从来没低过头。",
      "token_start": 712,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 216540,
      "end_ms": 217620,
      "text": "一九七八年，",
      "token_start": 722,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 217940,
      "end_ms": 222955,
      "text": "她嫁了个刚从乡下回城的知青木匠出身。",
      "token_start": 727,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 225070,
      "end_ms": 226105,
      "text": "一九八零年，",
      "token_start": 744,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 226580,
      "end_ms": 227795,
      "text": "两口子一咬牙，",
      "token_start": 749,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 228090,
      "end_ms": 229030,
      "text": "从厂里出来，",
      "token_start": 755,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 229030,
      "end_ms": 230255,
      "text": "开了间裁缝铺，",
      "token_start": 760,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 231200,
      "end_ms": 233670,
      "text": "他手巧手艺好样子，",
      "token_start": 766,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 233670,
      "end_ms": 236315,
      "text": "新一干就是五年，",
      "token_start": 774,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 237200,
      "end_ms": 238995,
      "text": "生意越做越红火，",
      "token_start": 781,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 239760,
      "end_ms": 241605,
      "text": "白天给人量体裁衣，",
      "token_start": 788,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 241960,
      "end_ms": 244155,
      "text": "到了晚上收拾停当，",
      "token_start": 796,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 244890,
      "end_ms": 247595,
      "text": "他心里那团火越烧越旺，",
      "token_start": 804,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 248010,
      "end_ms": 251255,
      "text": "就这么一个在泥里滚了小半辈子的女人，",
      "token_start": 814,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 251560,
      "end_ms": 255265,
      "text": "您可能觉得这辈子也就这样了，",
      "token_start": 831,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 256370,
      "end_ms": 257675,
      "text": "可谁也没想到，",
      "token_start": 844,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 259020,
      "end_ms": 264045,
      "text": "真正要命的转折恰恰就出在这间裁缝铺上。",
      "token_start": 850,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 264670,
      "end_ms": 265835,
      "text": "三十岁那年，",
      "token_start": 868,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 266290,
      "end_ms": 269710,
      "text": "他干了一件让所有人都觉得他疯了的事。",
      "token_start": 873,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 269790,
      "end_ms": 271210,
      "text": "在一台缝纫机上，",
      "token_start": 890,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 271370,
      "end_ms": 272855,
      "text": "他开始写小说，",
      "token_start": 897,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 273360,
      "end_ms": 277465,
      "text": "一个裁缝写的还是那种谁都看不懂的怪东西。",
      "token_start": 903,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 277900,
      "end_ms": 278820,
      "text": "他写的是啥？",
      "token_start": 922,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 279180,
      "end_ms": 284145,
      "text": "他凭什么能从一个裁缝一路写进世界文坛，",
      "token_start": 927,
      "token_end_exclusive": 945
    },
