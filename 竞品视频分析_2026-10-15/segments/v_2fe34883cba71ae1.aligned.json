{
  "video_id": "v_2fe34883cba71ae1",
  "duration_s": 523.377007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_2fe34883cba71ae1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_2fe34883cba71ae1.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 4390,
      "text": "上一集我们说到王成书本可以拿诺贝尔奖，",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4830,
      "end_ms": 12090,
      "text": "却在一九六四年原子弹爆炸成功后从人间蒸发一消失就是三十年。",
      "token_start": 18,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12630,
      "end_ms": 15630,
      "text": "很多人看完问他到底图什么？",
      "token_start": 46,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 15630,
      "end_ms": 19450,
      "text": "一个站在世界物理学顶端的人，",
      "token_start": 58,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 19450,
      "end_ms": 22490,
      "text": "为什么心甘情愿把名字抹掉？",
      "token_start": 71,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 22490,
      "end_ms": 28410,
      "text": "今天这集答案从他被美国扣留的那七年讲起。",
      "token_start": 83,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 28470,
      "end_ms": 30000,
      "text": "你听我讲说，",
      "token_start": 102,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 30140,
      "end_ms": 34780,
      "text": "讲完就知道这个女人的骨头比你想的硬的多。",
      "token_start": 107,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 35940,
      "end_ms": 36980,
      "text": "一九五一年，",
      "token_start": 126,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 36980,
      "end_ms": 39820,
      "text": "美国密歇根大学有个中国女学者，",
      "token_start": 131,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 39940,
      "end_ms": 41860,
      "text": "正站在人生的巅峰。",
      "token_start": 145,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 42700,
      "end_ms": 43840,
      "text": "她叫王成书，",
      "token_start": 153,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 44740,
      "end_ms": 49520,
      "text": "丈夫研究员两度受邀进普林斯顿高级研究所，",
      "token_start": 158,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 50240,
      "end_ms": 52580,
      "text": "那是爱因斯坦待过的地方。",
      "token_start": 177,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 53020,
      "end_ms": 56180,
      "text": "丈夫张文玉同样是顶尖物理学家，",
      "token_start": 188,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 56660,
      "end_ms": 57560,
      "text": "就在这一年，",
      "token_start": 202,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 57780,
      "end_ms": 59300,
      "text": "她又扔出一颗炸弹，",
      "token_start": 207,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 59460,
      "end_ms": 66075,
      "text": "跟导是乌伦贝克一起解开了困扰国际学界几十年的气体疏于难题，",
      "token_start": 215,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 66690,
      "end_ms": 76030,
      "text": "方程直接以他的姓氏命名WCU方程震惊了全世界导师乌伦贝克最后说了一句话，",
      "token_start": 243,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 76030,
      "end_ms": 79545,
      "text": "他留在美国诺贝尔奖只是时间问题。",
      "token_start": 276,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 80420,
      "end_ms": 84595,
      "text": "可就在所有人都以为他要在美国大展拳脚的时候，",
      "token_start": 291,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 84890,
      "end_ms": 87685,
      "text": "这家人开始变卖家里的东西了。",
      "token_start": 312,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 88110,
      "end_ms": 91755,
      "text": "杀伐送人电器送人能送的全送，",
      "token_start": 325,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 92310,
      "end_ms": 96155,
      "text": "然后开始一箱一箱打包书籍寄往北京，",
      "token_start": 338,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 96900,
      "end_ms": 98295,
      "text": "不是一次性忌，",
      "token_start": 354,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 98640,
      "end_ms": 103065,
      "text": "是分成三百多个包裹跑几十家不同的邮局。",
      "token_start": 360,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 103660,
      "end_ms": 104895,
      "text": "今天寄两个，",
      "token_start": 378,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 105230,
      "end_ms": 106345,
      "text": "明天寄三个，",
      "token_start": 383,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 106800,
      "end_ms": 108335,
      "text": "就像蚂蚁搬家一样，",
      "token_start": 388,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 108660,
      "end_ms": 110205,
      "text": "一点一点往国内挪。",
      "token_start": 396,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 112300,
      "end_ms": 113075,
      "text": "为什么这么干？",
      "token_start": 404,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 113340,
      "end_ms": 115855,
      "text": "因为当时国际包裹现中六磅，",
      "token_start": 410,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 116320,
      "end_ms": 119325,
      "text": "而且美国的情报部门早已经盯上了他。",
      "token_start": 422,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 120390,
      "end_ms": 121510,
      "text": "一九四九年，",
      "token_start": 438,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 121570,
      "end_ms": 122830,
      "text": "新中国一成立，",
      "token_start": 443,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 123210,
      "end_ms": 125110,
      "text": "王成书就跟丈夫说，",
      "token_start": 449,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 126110,
      "end_ms": 127390,
      "text": "咱们现在回国，",
      "token_start": 457,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 127950,
      "end_ms": 129290,
      "text": "美国方面能答应吗？",
      "token_start": 463,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 129770,
      "end_ms": 131870,
      "text": "那是朝鲜战争全面爆发，",
      "token_start": 471,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 132310,
      "end_ms": 134150,
      "text": "美国方面直接下了禁令，",
      "token_start": 481,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 134550,
      "end_ms": 137910,
      "text": "所有学理工科的中国学者不许离境，",
      "token_start": 491,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 138810,
      "end_ms": 142650,
      "text": "在这期间传讯监视、限制出行，",
      "token_start": 506,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 143070,
      "end_ms": 144370,
      "text": "什么手段都用上。",
      "token_start": 518,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 144930,
      "end_ms": 146950,
      "text": "有个美国教授说的特别露骨，",
      "token_start": 525,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 147290,
      "end_ms": 151120,
      "text": "这些搞理工的回去就是潜在的核武制造者，",
      "token_start": 537,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 151540,
      "end_ms": 152840,
      "text": "他们必须留下。",
      "token_start": 555,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 153780,
      "end_ms": 154880,
      "text": "可王成书呢，",
      "token_start": 561,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 154980,
      "end_ms": 156920,
      "text": "他在日记里写下了一句话，",
      "token_start": 566,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 157720,
      "end_ms": 160280,
      "text": "把自己的退路全部堵死了。",
      "token_start": 577,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 161160,
      "end_ms": 163580,
      "text": "经过较长时期的思想斗争，",
      "token_start": 588,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 164180,
      "end_ms": 165380,
      "text": "最后下定决心，",
      "token_start": 599,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 165800,
      "end_ms": 166840,
      "text": "在必要时，",
      "token_start": 605,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 166840,
      "end_ms": 168240,
      "text": "哪怕把我关起来，",
      "token_start": 609,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 168440,
      "end_ms": 169740,
      "text": "也不能做一桩，",
      "token_start": 616,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 169920,
      "end_ms": 171960,
      "text": "不利于祖国的事儿。",
      "token_start": 622,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 172040,
      "end_ms": 174020,
      "text": "你频频这句话，",
      "token_start": 630,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 174020,
      "end_ms": 179380,
      "text": "一个已经站在世界物理学顶端的人拿自己的后半生做担保。",
      "token_start": 636,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 179660,
      "end_ms": 180925,
      "text": "您可被关起来，",
      "token_start": 661,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 181240,
      "end_ms": 183350,
      "text": "也不做对不起祖国的事儿。",
      "token_start": 667,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 183370,
      "end_ms": 184255,
      "text": "这不是口号，",
      "token_start": 678,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 184730,
      "end_ms": 187375,
      "text": "这是他一步一步在做正确的事。",
      "token_start": 683,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 187950,
      "end_ms": 188910,
      "text": "美国不放人，",
      "token_start": 696,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 188910,
      "end_ms": 190560,
      "text": "他就硬等等了。",
      "token_start": 701,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 190560,
      "end_ms": 191115,
      "text": "七年。",
      "token_start": 707,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 191590,
      "end_ms": 192485,
      "text": "这七年里，",
      "token_start": 709,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 192860,
      "end_ms": 196575,
      "text": "他一边应付美国情报部门的传讯和监视，",
      "token_start": 713,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 197280,
      "end_ms": 202280,
      "text": "一边偷偷把资料往国内寄九百公斤左右的书刊，",
      "token_start": 730,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 202300,
      "end_ms": 205005,
      "text": "资料分开成三百多个营包，",
      "token_start": 750,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 205870,
      "end_ms": 207175,
      "text": "全是他一个人打包，",
      "token_start": 761,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 207490,
      "end_ms": 209245,
      "text": "一个人跑邮局寄出去。",
      "token_start": 769,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 210010,
      "end_ms": 211245,
      "text": "你想想那个画面，",
      "token_start": 778,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 211780,
      "end_ms": 213495,
      "text": "一个瘦小的中国女人，",
      "token_start": 785,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 214000,
      "end_ms": 215515,
      "text": "抱着沉重的书香，",
      "token_start": 794,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 215920,
      "end_ms": 218080,
      "text": "在不同的邮局之间穿梭，",
      "token_start": 801,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 218240,
      "end_ms": 219585,
      "text": "生怕被人发现，",
      "token_start": 811,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 219940,
      "end_ms": 221685,
      "text": "生怕哪一包被截下来，",
      "token_start": 817,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 222310,
      "end_ms": 224395,
      "text": "家里的所有东西全送人了。",
      "token_start": 826,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 224920,
      "end_ms": 227075,
      "text": "美方开出再优渥的条件，",
      "token_start": 837,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 227460,
      "end_ms": 229135,
      "text": "他眼皮都不抬一下，",
      "token_start": 847,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 229660,
      "end_ms": 232480,
      "text": "他心里只有一个念头回国。",
      "token_start": 855,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 233060,
      "end_ms": 234105,
      "text": "一九五五年，",
      "token_start": 866,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 234410,
      "end_ms": 237695,
      "text": "中美在日内瓦会谈国家据理力争，",
      "token_start": 871,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 238190,
      "end_ms": 241865,
      "text": "美国才不得不解除禁令放他们回国。",
      "token_start": 885,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 242350,
      "end_ms": 243370,
      "text": "一九五六年，",
      "token_start": 900,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 243630,
      "end_ms": 246425,
      "text": "一家人终于登上了回国的船。",
      "token_start": 905,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 247090,
      "end_ms": 248155,
      "text": "登船之前，",
      "token_start": 917,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 248910,
      "end_ms": 251510,
      "text": "导师乌伦贝克最后一次劝他，",
      "token_start": 921,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 251910,
      "end_ms": 254460,
      "text": "孩子中国一穷二白，",
      "token_start": 933,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 254580,
      "end_ms": 255425,
      "text": "没有仪器，",
      "token_start": 941,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 255680,
      "end_ms": 256375,
      "text": "没有资料，",
      "token_start": 945,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 256670,
      "end_ms": 257935,
      "text": "你回去能干什么呢？",
      "token_start": 949,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 258130,
      "end_ms": 260465,
      "text": "他的回答我建议你记住，",
      "token_start": 957,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 261000,
      "end_ms": 262705,
      "text": "虽然我的祖国很穷，",
      "token_start": 967,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 263470,
      "end_ms": 265605,
      "text": "进行科研的条件也差，",
      "token_start": 975,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 266010,
      "end_ms": 268525,
      "text": "但我不能等别人把条件创造好了，",
      "token_start": 984,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 269040,
      "end_ms": 272575,
      "text": "我一定要参加到创造条件的行列中。",
      "token_start": 998,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 273330,
      "end_ms": 274985,
      "text": "我的事业必须在中国。",
      "token_start": 1013,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 275790,
      "end_ms": 276505,
      "text": "这话说完，",
      "token_start": 1022,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 276980,
      "end_ms": 278415,
      "text": "美国人就来搜身了。",
      "token_start": 1026,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 279020,
      "end_ms": 280705,
      "text": "箱子翻了个底朝天，",
      "token_start": 1034,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 281220,
      "end_ms": 282365,
      "text": "人生搜了个遍，",
      "token_start": 1042,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 282960,
      "end_ms": 284855,
      "text": "连鞋底都撬开检查，",
      "token_start": 1048,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 285230,
      "end_ms": 286970,
      "text": "生怕他带走什么机密。",
      "token_start": 1056,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 286970,
      "end_ms": 290800,
      "text": "资料多年后张文玉回忆这段的时光，",
      "token_start": 1065,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 290940,
      "end_ms": 292425,
      "text": "幽默的让人心酸。",
      "token_start": 1080,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 292970,
      "end_ms": 293770,
      "text": "闹到最后，",
      "token_start": 1087,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 293910,
      "end_ms": 296210,
      "text": "我们带回来的就一个脑袋，",
      "token_start": 1091,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 296830,
      "end_ms": 297590,
      "text": "可他们忘了，",
      "token_start": 1102,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 297590,
      "end_ms": 300290,
      "text": "那三百个邮包有用的知识，",
      "token_start": 1107,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 300490,
      "end_ms": 302070,
      "text": "早就邮寄到家了。",
      "token_start": 1118,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 302730,
      "end_ms": 304290,
      "text": "一九五六年十月，",
      "token_start": 1125,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 304790,
      "end_ms": 306990,
      "text": "双脚一踏上祖国的土地，",
      "token_start": 1132,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 307490,
      "end_ms": 313390,
      "text": "王成书就在笔记本上写在离别了十五年的祖国国境上，",
      "token_start": 1142,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 313690,
      "end_ms": 316670,
      "text": "第一次看到五星红旗在空中飘扬，",
      "token_start": 1165,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 317090,
      "end_ms": 318470,
      "text": "心里说不出的兴奋。",
      "token_start": 1179,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 319110,
      "end_ms": 320990,
      "text": "我要为国家做贡献，",
      "token_start": 1187,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 321870,
      "end_ms": 324480,
      "text": "国家需要要什么我就干什么。",
      "token_start": 1195,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 325140,
      "end_ms": 327440,
      "text": "你以为这是苦尽甘来不？",
      "token_start": 1207,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 327860,
      "end_ms": 329980,
      "text": "这才是他被收割的开始，",
      "token_start": 1217,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 330940,
      "end_ms": 332260,
      "text": "回国才两年。",
      "token_start": 1227,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 333040,
      "end_ms": 334120,
      "text": "一九五八年，",
      "token_start": 1232,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 334740,
      "end_ms": 336700,
      "text": "前三强上门找他谈，",
      "token_start": 1237,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 337620,
      "end_ms": 339620,
      "text": "国家要搞热核巨变，",
      "token_start": 1245,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 340360,
      "end_ms": 341960,
      "text": "国内一片空白，",
      "token_start": 1253,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 343920,
      "end_ms": 344840,
      "text": "你来挂帅。",
      "token_start": 1259,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 345320,
      "end_ms": 347640,
      "text": "他研究了二十年的锡薄气体，",
      "token_start": 1263,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 348000,
      "end_ms": 349200,
      "text": "跟热核巨变，",
      "token_start": 1275,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 349240,
      "end_ms": 350400,
      "text": "完全是两码事。",
      "token_start": 1280,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 351180,
      "end_ms": 352555,
      "text": "他已经四十六岁了，",
      "token_start": 1286,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 353350,
      "end_ms": 354625,
      "text": "专业早已定型，",
      "token_start": 1294,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 354930,
      "end_ms": 358715,
      "text": "这等于让他把过去二十年学的知识一笔勾销，",
      "token_start": 1300,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 359370,
      "end_ms": 361045,
      "text": "重新做回小学生。",
      "token_start": 1319,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 361440,
      "end_ms": 362835,
      "text": "他只说了三个字，",
      "token_start": 1326,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 363210,
      "end_ms": 363785,
      "text": "我愿意。",
      "token_start": 1333,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 364420,
      "end_ms": 365095,
      "text": "然后呢，",
      "token_start": 1336,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 365320,
      "end_ms": 366840,
      "text": "他自学俄语，",
      "token_start": 1339,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 366840,
      "end_ms": 368775,
      "text": "被派去苏联进修，",
      "token_start": 1344,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 369360,
      "end_ms": 370705,
      "text": "从莫斯科回北京，",
      "token_start": 1351,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 371050,
      "end_ms": 372935,
      "text": "坐了七天七夜的火车。",
      "token_start": 1358,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 373620,
      "end_ms": 379030,
      "text": "他愣是把美国核聚变规划的机密文献学武德方案给翻译。",
      "token_start": 1367,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 379030,
      "end_ms": 379485,
      "text": "完了，",
      "token_start": 1391,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 380140,
      "end_ms": 382245,
      "text": "两年就两。",
      "token_start": 1393,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 382850,
      "end_ms": 384235,
      "text": "他带出一支队伍，",
      "token_start": 1397,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 384650,
      "end_ms": 388845,
      "text": "把国内热核聚变理论的空白给填上了，",
      "token_start": 1404,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 389200,
      "end_ms": 392275,
      "text": "成了中国受控核聚变研究的开创者。",
      "token_start": 1420,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 392730,
      "end_ms": 393985,
      "text": "四十六岁规定，",
      "token_start": 1435,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 394590,
      "end_ms": 396905,
      "text": "四十八岁又重新登顶，",
      "token_start": 1441,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 397450,
      "end_ms": 401295,
      "text": "这就是王成书的宿可刚要出大成果，",
      "token_start": 1450,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 401570,
      "end_ms": 402830,
      "text": "第二代又来。",
      "token_start": 1465,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 404170,
      "end_ms": 408630,
      "text": "一九六一年苏联专家卷着图纸跑光原子弹的，",
      "token_start": 1470,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 408630,
      "end_ms": 411905,
      "text": "命门核燃料浓缩又卡死了。",
      "token_start": 1489,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 412450,
      "end_ms": 415435,
      "text": "后来钱三强再次找到他谈合作。",
      "token_start": 1500,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 415950,
      "end_ms": 417430,
      "text": "这次我要把丑话说，",
      "token_start": 1513,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 417430,
      "end_ms": 419635,
      "text": "前面项目要绝对保密，",
      "token_start": 1521,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 419920,
      "end_ms": 420615,
      "text": "不能发论文，",
      "token_start": 1530,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 421330,
      "end_ms": 422195,
      "text": "不能开会，",
      "token_start": 1535,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 422580,
      "end_ms": 423320,
      "text": "你的去向，",
      "token_start": 1539,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 423340,
      "end_ms": 424595,
      "text": "连丈夫都不能讲。",
      "token_start": 1543,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 425130,
      "end_ms": 426550,
      "text": "如果你接下这个项目，",
      "token_start": 1550,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 426550,
      "end_ms": 430100,
      "text": "王成书这个人就等于从这个世界上抹。",
      "token_start": 1559,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 430100,
      "end_ms": 432080,
      "text": "除了四十九岁，",
      "token_start": 1575,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 432100,
      "end_ms": 433685,
      "text": "第二次从零开始，",
      "token_start": 1581,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 434260,
      "end_ms": 436975,
      "text": "还要搭上不能有自己的名字。",
      "token_start": 1588,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 437850,
      "end_ms": 439265,
      "text": "他还是那三个字，",
      "token_start": 1600,
      "token_end_exclusive": 1607
    },
    {
      "start_ms": 440880,
      "end_ms": 443580,
      "text": "我愿意一个被美国扣了七年，",
      "token_start": 1607,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 443760,
      "end_ms": 445095,
      "text": "也要跑回来的女人。",
      "token_start": 1619,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 445570,
      "end_ms": 446425,
      "text": "回来之后，",
      "token_start": 1627,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 446750,
      "end_ms": 448255,
      "text": "为国家藏了三十年，",
      "token_start": 1631,
      "token_end_exclusive": 1639
    },
    {
      "start_ms": 449150,
      "end_ms": 449950,
      "text": "藏道走了，",
      "token_start": 1639,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 449950,
      "end_ms": 451765,
      "text": "都没几个人知道他的名字。",
      "token_start": 1643,
      "token_end_exclusive": 1654
    },
    {
      "start_ms": 452580,
      "end_ms": 455335,
      "text": "回望那段风雨飘摇的岁月，",
      "token_start": 1654,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 455980,
      "end_ms": 457460,
      "text": "正是有这么一群人，",
      "token_start": 1665,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 457520,
      "end_ms": 458695,
      "text": "挺身而出，",
      "token_start": 1673,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 459490,
      "end_ms": 460845,
      "text": "不计个人得失，",
      "token_start": 1677,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 461260,
      "end_ms": 462525,
      "text": "不怕艰难困苦，",
      "token_start": 1683,
      "token_end_exclusive": 1689
    },
    {
      "start_ms": 462850,
      "end_ms": 465015,
      "text": "默默扛起家国重任。",
      "token_start": 1689,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 466020,
      "end_ms": 466440,
      "text": "下集，",
      "token_start": 1697,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 466440,
      "end_ms": 466935,
      "text": "我来讲，",
      "token_start": 1699,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 467330,
      "end_ms": 470045,
      "text": "他这辈子只跟国家说过三个字，",
      "token_start": 1702,
      "token_end_exclusive": 1715
    },
    {
      "start_ms": 470620,
      "end_ms": 471565,
      "text": "说了三回，",
      "token_start": 1715,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 471950,
      "end_ms": 474625,
      "text": "每一回都把自己赔进去一点，",
      "token_start": 1719,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 475080,
      "end_ms": 476080,
      "text": "三回下来，",
      "token_start": 1731,
      "token_end_exclusive": 1735
    },
    {
      "start_ms": 476300,
      "end_ms": 478075,
      "text": "把自己赔的干干净净。",
      "token_start": 1735,
      "token_end_exclusive": 1744
    },
    {
      "start_ms": 478320,
      "end_ms": 478880,
      "text": "这三回，",
      "token_start": 1744,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 478880,
      "end_ms": 481375,
      "text": "我愿意每一回他失去了什么，",
      "token_start": 1747,
      "token_end_exclusive": 1759
    },
    {
      "start_ms": 481590,
      "end_ms": 482885,
      "text": "国家又得到了什么？",
      "token_start": 1759,
      "token_end_exclusive": 1767
    },
    {
      "start_ms": 483390,
      "end_ms": 485545,
      "text": "我一笔一笔给你算清楚，",
      "token_start": 1767,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 485840,
      "end_ms": 489655,
      "text": "点赞、收藏并转发给您身边最亲的人。",
      "token_start": 1777,
      "token_end_exclusive": 1792
    },
    {
      "start_ms": 490320,
      "end_ms": 490955,
      "text": "关注我，",
      "token_start": 1792,
      "token_end_exclusive": 1795
    },
    {
      "start_ms": 491190,
      "end_ms": 492615,
      "text": "下一集我继续讲。",
      "token_start": 1795,
      "token_end_exclusive": 1802
    }
  ],
