{
  "video_id": "v_ac516db0b5dced62",
  "duration_s": 664.230998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_ac516db0b5dced62.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_ac516db0b5dced62.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 4890,
      "text": "您知道中国深秋最惊艳的大地奇观是哪一处吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5270,
      "end_ms": 5750,
      "text": "上集，",
      "token_start": 20,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5750,
      "end_ms": 16610,
      "text": "咱们聊了盘锦红海滩、呼伦贝尔草原、光雾山红叶、鹅济那胡杨、长白山天池这集直接揭开谜底，",
      "token_start": 22,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 17070,
      "end_ms": 19790,
      "text": "看看前五名惊艳到什么程度。",
      "token_start": 60,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 20170,
      "end_ms": 22650,
      "text": "尤其是排在榜首的那处奇观，",
      "token_start": 72,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 23510,
      "end_ms": 27930,
      "text": "碧绿的冰川融水会泛起淡淡的奶白色，",
      "token_start": 84,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 28790,
      "end_ms": 29850,
      "text": "漫山白桦，",
      "token_start": 100,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 30180,
      "end_ms": 31420,
      "text": "画倒映在湖底，",
      "token_start": 104,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 31580,
      "end_ms": 33400,
      "text": "宛如金色绸缎。",
      "token_start": 110,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 33860,
      "end_ms": 34600,
      "text": "话不多说，",
      "token_start": 116,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 35000,
      "end_ms": 36340,
      "text": "茶给您沏好了，",
      "token_start": 120,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 36540,
      "end_ms": 38660,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 126,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 38960,
      "end_ms": 39980,
      "text": "咱们这就开讲。",
      "token_start": 136,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 40280,
      "end_ms": 40940,
      "text": "第五名，",
      "token_start": 142,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 41640,
      "end_ms": 45260,
      "text": "云南原阳哈尼梯田哀牢山深处。",
      "token_start": 145,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 46139,
      "end_ms": 48120,
      "text": "这个您可能在照片里见过，",
      "token_start": 158,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 48660,
      "end_ms": 52520,
      "text": "可照片里的他只是一小脚哈尼族人。",
      "token_start": 169,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 52520,
      "end_ms": 53560,
      "text": "在这座大山里，",
      "token_start": 184,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 54140,
      "end_ms": 54940,
      "text": "一锄头，",
      "token_start": 190,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 54960,
      "end_ms": 55540,
      "text": "一锄头，",
      "token_start": 193,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 55640,
      "end_ms": 57520,
      "text": "刻了整整一千三百角。",
      "token_start": 196,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 58220,
      "end_ms": 59795,
      "text": "十几万亩梯田。",
      "token_start": 205,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 60530,
      "end_ms": 63305,
      "text": "从山脚一层一层垒到云里头，",
      "token_start": 211,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 63690,
      "end_ms": 65085,
      "text": "山顶是森林，",
      "token_start": 223,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 65500,
      "end_ms": 66760,
      "text": "山腰是村寨，",
      "token_start": 228,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 67060,
      "end_ms": 68425,
      "text": "山下是梯田，",
      "token_start": 233,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 69040,
      "end_ms": 70860,
      "text": "水从林子里流下来，",
      "token_start": 238,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 71280,
      "end_ms": 73455,
      "text": "穿过村子灌进田里，",
      "token_start": 246,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 73800,
      "end_ms": 74760,
      "text": "再征成云。",
      "token_start": 254,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 74900,
      "end_ms": 78575,
      "text": "回到山上一圈一圈儿从没断过。",
      "token_start": 258,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 78970,
      "end_ms": 80545,
      "text": "深秋收完了稻子，",
      "token_start": 271,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 81000,
      "end_ms": 86775,
      "text": "整座山开始放水万千块梯田一下子变成了镜子。",
      "token_start": 278,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 87500,
      "end_ms": 89735,
      "text": "年轻晨站在观景台上，",
      "token_start": 298,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 90190,
      "end_ms": 91910,
      "text": "雾从谷底往上爬，",
      "token_start": 307,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 92310,
      "end_ms": 93565,
      "text": "太阳一露头，",
      "token_start": 314,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 93990,
      "end_ms": 96705,
      "text": "满天的朝霞全掉进了田里，",
      "token_start": 319,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 97190,
      "end_ms": 101085,
      "text": "千年手艺换来大山一身澄澈。",
      "token_start": 330,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 101840,
      "end_ms": 105755,
      "text": "您说这是不是洗尽千华后最好看的样子？",
      "token_start": 342,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 106100,
      "end_ms": 106895,
      "text": "第四名，",
      "token_start": 359,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 107240,
      "end_ms": 111335,
      "text": "云南腾冲江东银杏村高黎贡山脚下。",
      "token_start": 362,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 111960,
      "end_ms": 114120,
      "text": "如果说天地造化让人震撼，",
      "token_start": 377,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 114340,
      "end_ms": 118725,
      "text": "那这里就是全中国深秋最温润的人间烟火。",
      "token_start": 388,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 119190,
      "end_ms": 120845,
      "text": "在高丽贡山脚下，",
      "token_start": 406,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 121340,
      "end_ms": 128605,
      "text": "三万多株古银杏树掩映着一处用黑色火山石砌成的百年古村落，",
      "token_start": 413,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 129020,
      "end_ms": 130025,
      "text": "一入深秋，",
      "token_start": 440,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 130610,
      "end_ms": 133050,
      "text": "金黄的落叶如飞絮，",
      "token_start": 444,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 133190,
      "end_ms": 135085,
      "text": "细雨般随风飘洒，",
      "token_start": 452,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 135640,
      "end_ms": 142045,
      "text": "铺满了青石板路、矮矮的火山、石墙以及厚重的瓦屋顶。",
      "token_start": 459,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 142490,
      "end_ms": 146290,
      "text": "村里的老人们围坐在洒满碎金的石桌旁，",
      "token_start": 481,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 146470,
      "end_ms": 150325,
      "text": "烤火烹茶土灶台里柴火正旺，",
      "token_start": 498,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 150730,
      "end_ms": 152675,
      "text": "屋顶炊烟袅袅升起。",
      "token_start": 510,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 153090,
      "end_ms": 154250,
      "text": "您若是走累了，",
      "token_start": 518,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 154290,
      "end_ms": 155765,
      "text": "跨进小院坐下，",
      "token_start": 524,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 156240,
      "end_ms": 159115,
      "text": "脚踩着松软温润的金色落叶，",
      "token_start": 530,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 159500,
      "end_ms": 161300,
      "text": "端起一杯滚烫的热茶，",
      "token_start": 542,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 161840,
      "end_ms": 163680,
      "text": "满身的寒气与疲惫，",
      "token_start": 551,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 163880,
      "end_ms": 165695,
      "text": "瞬间化解在阳光里。",
      "token_start": 559,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 166340,
      "end_ms": 170735,
      "text": "安宁平静的小日子原是人间最深沉的经验。",
      "token_start": 567,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 171100,
      "end_ms": 171740,
      "text": "第三名，",
      "token_start": 585,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 172100,
      "end_ms": 174345,
      "text": "西藏林芝雅鲁藏布大峡谷，",
      "token_start": 588,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 174680,
      "end_ms": 176375,
      "text": "南加巴瓦峰脚下。",
      "token_start": 599,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 176830,
      "end_ms": 178455,
      "text": "他是世界第一大峡谷，",
      "token_start": 606,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 178690,
      "end_ms": 179835,
      "text": "长五百多公里，",
      "token_start": 615,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 180260,
      "end_ms": 182165,
      "text": "最深处六千多米，",
      "token_start": 621,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 182540,
      "end_ms": 185225,
      "text": "四座泰山摞起来才够得着。",
      "token_start": 628,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 185700,
      "end_ms": 188740,
      "text": "雅鲁藏布江绕着南加巴瓦拐的一个大弯儿，",
      "token_start": 639,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 189390,
      "end_ms": 192345,
      "text": "硬生生把大山劈出一道裂缝。",
      "token_start": 657,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 192800,
      "end_ms": 193445,
      "text": "深秋，",
      "token_start": 669,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 194000,
      "end_ms": 195165,
      "text": "江水碧绿，",
      "token_start": 671,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 195550,
      "end_ms": 199585,
      "text": "德相翡翠两岸落叶松金黄，",
      "token_start": 675,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 200000,
      "end_ms": 205565,
      "text": "枫叶火红晴天的傍晚七千七百多米的南加巴瓦，",
      "token_start": 686,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 206000,
      "end_ms": 209085,
      "text": "终年积雪的封顶被夕阳一点。",
      "token_start": 706,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 209460,
      "end_ms": 211445,
      "text": "整个烧成的金色，",
      "token_start": 718,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 211900,
      "end_ms": 213255,
      "text": "这就是日照金山。",
      "token_start": 725,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 214220,
      "end_ms": 216645,
      "text": "金光落进碧绿的江水里，",
      "token_start": 732,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 217360,
      "end_ms": 219770,
      "text": "您站在江边脚下，",
      "token_start": 742,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 219910,
      "end_ms": 220985,
      "text": "江声轰鸣，",
      "token_start": 749,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 221740,
      "end_ms": 223125,
      "text": "抬头是雪峰，",
      "token_start": 753,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 223690,
      "end_ms": 225475,
      "text": "人小的像一粒沙，",
      "token_start": 758,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 226220,
      "end_ms": 228235,
      "text": "心里反倒静了下来。",
      "token_start": 765,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 228740,
      "end_ms": 230120,
      "text": "面对这样的天地，",
      "token_start": 773,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 230120,
      "end_ms": 230580,
      "text": "造化，",
      "token_start": 780,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 230860,
      "end_ms": 232305,
      "text": "什么烦恼都不值一提，",
      "token_start": 782,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 232900,
      "end_ms": 234405,
      "text": "剩下的只有敬畏。",
      "token_start": 791,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 234760,
      "end_ms": 235455,
      "text": "第二名，",
      "token_start": 798,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 235910,
      "end_ms": 242475,
      "text": "四川九寨沟五花海与近海诗人看秋天全在抬眼看岸上，",
      "token_start": 801,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 242990,
      "end_ms": 247425,
      "text": "唯独九寨沟看在清澈见底的深潭水底。",
      "token_start": 824,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 247860,
      "end_ms": 248815,
      "text": "深秋时节，",
      "token_start": 840,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 249240,
      "end_ms": 253575,
      "text": "漫山遍野五彩斑斓的彩林与初雪覆盖的山头，",
      "token_start": 844,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 254060,
      "end_ms": 261505,
      "text": "被五花海、静海那宝石蓝与翡翠绿的盖花湖泊完完整整拓印下来。",
      "token_start": 863,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 261960,
      "end_ms": 264075,
      "text": "由于湖水极其纯净，",
      "token_start": 890,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 264520,
      "end_ms": 266705,
      "text": "钙化的枯木沉在水底，",
      "token_start": 898,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 267120,
      "end_ms": 268795,
      "text": "化作玉树琼枝，",
      "token_start": 907,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 269260,
      "end_ms": 273575,
      "text": "水底的世界甚至比岸上的山林还要斑斓奇绝。",
      "token_start": 913,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 273990,
      "end_ms": 275890,
      "text": "水在林中静静流淌，",
      "token_start": 932,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 276310,
      "end_ms": 278405,
      "text": "林在水底缓缓摇曳。",
      "token_start": 940,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 278860,
      "end_ms": 281105,
      "text": "您沿着湖边木栈道慢慢走，",
      "token_start": 948,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 281510,
      "end_ms": 284345,
      "text": "微风吹起水面的淡淡涟漪，",
      "token_start": 959,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 285040,
      "end_ms": 286840,
      "text": "整座秋天的绚烂，",
      "token_start": 970,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 286940,
      "end_ms": 289040,
      "text": "最终安然自若的沉淀。",
      "token_start": 977,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 289080,
      "end_ms": 290335,
      "text": "在碧水深处，",
      "token_start": 986,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 290810,
      "end_ms": 292635,
      "text": "您说这算不算最高的从容？",
      "token_start": 991,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 293010,
      "end_ms": 294755,
      "text": "那第一名到底是哪儿？",
      "token_start": 1002,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 295390,
      "end_ms": 296315,
      "text": "先别急，",
      "token_start": 1011,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 297060,
      "end_ms": 297895,
      "text": "聊到这儿，",
      "token_start": 1014,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 298190,
      "end_ms": 300005,
      "text": "我先唠几句心里话。",
      "token_start": 1018,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 300360,
      "end_ms": 303490,
      "text": "我发现经常有朋友留言说，",
      "token_start": 1026,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 303630,
      "end_ms": 304630,
      "text": "年轻时候忙，",
      "token_start": 1037,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 304950,
      "end_ms": 305955,
      "text": "没空出门。",
      "token_start": 1042,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 306780,
      "end_ms": 308400,
      "text": "现在退休有空了，",
      "token_start": 1046,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 308620,
      "end_ms": 309540,
      "text": "想去走走，",
      "token_start": 1053,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 310200,
      "end_ms": 312440,
      "text": "可不知道先去哪儿去了，",
      "token_start": 1057,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 312440,
      "end_ms": 313140,
      "text": "看什么。",
      "token_start": 1067,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 313560,
      "end_ms": 316360,
      "text": "还有朋友说身子骨不比从前，",
      "token_start": 1070,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 316420,
      "end_ms": 320800,
      "text": "哪这些地方海拔高上去就头晕气短，",
      "token_start": 1082,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 321300,
      "end_ms": 323300,
      "text": "有没有不用往高处跑，",
      "token_start": 1097,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 323640,
      "end_ms": 325760,
      "text": "也能把他们看明白的办法。",
      "token_start": 1106,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 326240,
      "end_ms": 327920,
      "text": "还有带孙子孙女的，",
      "token_start": 1117,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 328140,
      "end_ms": 331680,
      "text": "想给孩子讲讲这些大地奇观是怎么来的。",
      "token_start": 1125,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 331860,
      "end_ms": 333060,
      "text": "可自己也说不全。",
      "token_start": 1142,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 333440,
      "end_ms": 335880,
      "text": "您看咱们这个年纪看景，",
      "token_start": 1149,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 335980,
      "end_ms": 337750,
      "text": "不光都是图个热闹，",
      "token_start": 1159,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 338290,
      "end_ms": 343090,
      "text": "更想知道这些大好河山到底是怎么长出来的。",
      "token_start": 1167,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 343390,
      "end_ms": 346550,
      "text": "可这些东西在手机上画完就忘上网，",
      "token_start": 1186,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 346570,
      "end_ms": 349250,
      "text": "查一堆乱七八糟的翻大布头，",
      "token_start": 1201,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 349550,
      "end_ms": 350750,
      "text": "又看的眼睛疼。",
      "token_start": 1213,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 351110,
      "end_ms": 352650,
      "text": "前阵子我翻到一本书，",
      "token_start": 1219,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 353150,
      "end_ms": 354690,
      "text": "正好解决这个问题，",
      "token_start": 1228,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 355050,
      "end_ms": 359770,
      "text": "叫大美中国人一生要去的一百零一个地方。",
      "token_start": 1236,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 360190,
      "end_ms": 364150,
      "text": "他把全中国最值得去的一百零一个地方挑出来，",
      "token_start": 1254,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 364510,
      "end_ms": 366840,
      "text": "分成五块自然奇观，",
      "token_start": 1274,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 367220,
      "end_ms": 370480,
      "text": "文明印记、烟火人间秘境，",
      "token_start": 1282,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 370500,
      "end_ms": 372385,
      "text": "寻踪人间天堂。",
      "token_start": 1292,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 372810,
      "end_ms": 374305,
      "text": "咱们今天聊的这些，",
      "token_start": 1298,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 374890,
      "end_ms": 378735,
      "text": "说到底是同一类风景大地的秋色。",
      "token_start": 1306,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 379130,
      "end_ms": 380790,
      "text": "书里头一个地方接一个地方，",
      "token_start": 1320,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 380790,
      "end_ms": 384375,
      "text": "讲这一类风景背后藏着些什么说法？",
      "token_start": 1332,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 384940,
      "end_ms": 386905,
      "text": "这些颜色是怎么来的？",
      "token_start": 1347,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 387500,
      "end_ms": 391545,
      "text": "为什么同是一个秋天各处又各不相同。",
      "token_start": 1356,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 392240,
      "end_ms": 395265,
      "text": "几分钟一个地方讲的明明白白，",
      "token_start": 1372,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 395660,
      "end_ms": 398510,
      "text": "图印的特别透亮一页。",
      "token_start": 1385,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 398510,
      "end_ms": 400555,
      "text": "翻开就是一幅大画，",
      "token_start": 1394,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 401170,
      "end_ms": 402845,
      "text": "我自己是这么用的，",
      "token_start": 1402,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 403390,
      "end_ms": 406790,
      "text": "能去的地方出门前翻一翻到了地方，",
      "token_start": 1410,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 406790,
      "end_ms": 407635,
      "text": "心里有底，",
      "token_start": 1425,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 408140,
      "end_ms": 410625,
      "text": "看的就不只是一片颜色，",
      "token_start": 1429,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 411130,
      "end_ms": 412925,
      "text": "而是背后的故事。",
      "token_start": 1439,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 413370,
      "end_ms": 414455,
      "text": "暂时去不了的，",
      "token_start": 1446,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 414760,
      "end_ms": 415905,
      "text": "就着图文慢慢看，",
      "token_start": 1452,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 416190,
      "end_ms": 417085,
      "text": "也算去过了。",
      "token_start": 1459,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 417590,
      "end_ms": 418685,
      "text": "摆在茶几上，",
      "token_start": 1464,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 419070,
      "end_ms": 419850,
      "text": "孙辈来了，",
      "token_start": 1469,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 419850,
      "end_ms": 420515,
      "text": "翻两页，",
      "token_start": 1473,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 420860,
      "end_ms": 421860,
      "text": "长见识不说，",
      "token_start": 1476,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 422160,
      "end_ms": 423980,
      "text": "写作文也正好用得上。",
      "token_start": 1481,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 424470,
      "end_ms": 429730,
      "text": "老两口晚上翻番商量明年去哪儿比刷手机舒坦多了，",
      "token_start": 1490,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 430250,
      "end_ms": 432790,
      "text": "房子会旧积蓄会花完，",
      "token_start": 1512,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 433210,
      "end_ms": 438070,
      "text": "可装在心里的山河眼界传几辈人都贬不了值。",
      "token_start": 1521,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 438530,
      "end_ms": 441530,
      "text": "这是咱们中国人代代相传的精神。",
      "token_start": 1540,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 441530,
      "end_ms": 443810,
      "text": "家底一旦断了，",
      "token_start": 1554,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 444290,
      "end_ms": 445430,
      "text": "可就不好接了，",
      "token_start": 1560,
      "token_end_exclusive": 1566
    },
    {
      "start_ms": 445750,
      "end_ms": 448250,
      "text": "趁现在还能买到给自己，",
      "token_start": 1566,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 448310,
      "end_ms": 450510,
      "text": "也给下一代备一份书。",
      "token_start": 1576,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 450570,
      "end_ms": 452850,
      "text": "就在左下角的商品里，",
      "token_start": 1585,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 453170,
      "end_ms": 455730,
      "text": "感兴趣的老朋友点进去看看，",
      "token_start": 1594,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 456610,
      "end_ms": 458190,
      "text": "人暂时走不出去，",
      "token_start": 1606,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 458650,
      "end_ms": 461430,
      "text": "咱先把大好河山装进屋里，",
      "token_start": 1613,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 461730,
      "end_ms": 463590,
      "text": "好说回正题，",
      "token_start": 1624,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 464450,
      "end_ms": 465090,
      "text": "第一名。",
      "token_start": 1629,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 465870,
      "end_ms": 471070,
      "text": "新疆喀纳斯湖与和睦阿尔泰山深处是什么？",
      "token_start": 1632,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 471070,
      "end_ms": 473330,
      "text": "是他前面九处，",
      "token_start": 1650,
      "token_end_exclusive": 1656
    },
    {
      "start_ms": 473650,
      "end_ms": 474890,
      "text": "各有各的绝活，",
      "token_start": 1656,
      "token_end_exclusive": 1662
    },
    {
      "start_ms": 475690,
      "end_ms": 476870,
      "text": "有的红的浓，",
      "token_start": 1662,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 477170,
      "end_ms": 478250,
      "text": "有的金的亮，",
      "token_start": 1667,
      "token_end_exclusive": 1672
    },
    {
      "start_ms": 478570,
      "end_ms": 481470,
      "text": "有的道营美喀纳斯不一样，",
      "token_start": 1672,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 481630,
      "end_ms": 488765,
      "text": "他要的是全他在祖国最西北是中国唯一一汇进北冰洋的水系。",
      "token_start": 1683,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 489500,
      "end_ms": 491515,
      "text": "湖面海拔一千三百多米，",
      "token_start": 1709,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 491950,
      "end_ms": 493745,
      "text": "最深处一百八十多米，",
      "token_start": 1719,
      "token_end_exclusive": 1728
    },
    {
      "start_ms": 494140,
      "end_ms": 496405,
      "text": "四周全是冰川雪山。",
      "token_start": 1728,
      "token_end_exclusive": 1736
    },
    {
      "start_ms": 496800,
      "end_ms": 499025,
      "text": "每年九月下旬到十月初，",
      "token_start": 1736,
      "token_end_exclusive": 1746
    },
    {
      "start_ms": 499440,
      "end_ms": 500915,
      "text": "就这短短十来天，",
      "token_start": 1746,
      "token_end_exclusive": 1753
    },
    {
      "start_ms": 501250,
      "end_ms": 503990,
      "text": "冰川融水带着细细的矿物质，",
      "token_start": 1753,
      "token_end_exclusive": 1765
    },
    {
      "start_ms": 503990,
      "end_ms": 506380,
      "text": "流进湖里整片湖水，",
      "token_start": 1765,
      "token_end_exclusive": 1773
    },
    {
      "start_ms": 506440,
      "end_ms": 507955,
      "text": "先变成天青色，",
      "token_start": 1773,
      "token_end_exclusive": 1779
    },
    {
      "start_ms": 508350,
      "end_ms": 509685,
      "text": "再变成奶白色。",
      "token_start": 1779,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 510120,
      "end_ms": 512945,
      "text": "像有人往湖里倒了一整缸牛奶，",
      "token_start": 1785,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 513320,
      "end_ms": 517210,
      "text": "月亮湾卧龙湾两岸数万亩白桦林，",
      "token_start": 1798,
      "token_end_exclusive": 1812
    },
    {
      "start_ms": 517270,
      "end_ms": 520900,
      "text": "同时烧成了纯金金黄的树影，",
      "token_start": 1812,
      "token_end_exclusive": 1824
    },
    {
      "start_ms": 521060,
      "end_ms": 522655,
      "text": "落进清白的水里，",
      "token_start": 1824,
      "token_end_exclusive": 1831
    },
    {
      "start_ms": 523090,
      "end_ms": 524125,
      "text": "一边是火，",
      "token_start": 1831,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 524490,
      "end_ms": 525365,
      "text": "一边是兵。",
      "token_start": 1835,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 525760,
      "end_ms": 526200,
      "text": "清晨，",
      "token_start": 1839,
      "token_end_exclusive": 1841
    },
    {
      "start_ms": 526560,
      "end_ms": 529675,
      "text": "白沙似的雾贴着水面慢慢飘，",
      "token_start": 1841,
      "token_end_exclusive": 1853
    },
    {
      "start_ms": 530110,
      "end_ms": 534035,
      "text": "远处雪峰一排排立着到了和睦。",
      "token_start": 1853,
      "token_end_exclusive": 1866
    },
    {
      "start_ms": 534320,
      "end_ms": 537010,
      "text": "图瓦人的木屋顶上青烟，",
      "token_start": 1866,
      "token_end_exclusive": 1876
    },
    {
      "start_ms": 537150,
      "end_ms": 538685,
      "text": "一缕一缕往上升，",
      "token_start": 1876,
      "token_end_exclusive": 1883
    },
    {
      "start_ms": 539080,
      "end_ms": 540200,
      "text": "您站在湖边。",
      "token_start": 1883,
      "token_end_exclusive": 1888
    },
    {
      "start_ms": 540910,
      "end_ms": 542035,
      "text": "风是凉的，",
      "token_start": 1888,
      "token_end_exclusive": 1892
    },
    {
      "start_ms": 542510,
      "end_ms": 545340,
      "text": "空气是甜的大半辈子，",
      "token_start": 1892,
      "token_end_exclusive": 1901
    },
    {
      "start_ms": 545360,
      "end_ms": 547125,
      "text": "攒下的疲惫和烦恼，",
      "token_start": 1901,
      "token_end_exclusive": 1909
    },
    {
      "start_ms": 547490,
      "end_ms": 551305,
      "text": "被这一整片山水涤荡的干干净净。",
      "token_start": 1909,
      "token_end_exclusive": 1923
    },
    {
      "start_ms": 551730,
      "end_ms": 553550,
      "text": "水山啊，",
      "token_start": 1923,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 553660,
      "end_ms": 554025,
      "text": "树，",
      "token_start": 1926,
      "token_end_exclusive": 1927
    },
    {
      "start_ms": 554450,
      "end_ms": 558105,
      "text": "你大自然关于秋天的所有想象，",
      "token_start": 1927,
      "token_end_exclusive": 1940
    },
    {
      "start_ms": 558560,
      "end_ms": 560745,
      "text": "全在这儿一样都没落下。",
      "token_start": 1940,
      "token_end_exclusive": 1950
    },
    {
      "start_ms": 561540,
      "end_ms": 564535,
      "text": "前面比的是谁更红谁更精。",
      "token_start": 1950,
      "token_end_exclusive": 1961
    },
    {
      "start_ms": 565360,
      "end_ms": 569430,
      "text": "他比的是谁把秋天装的最满十处。",
      "token_start": 1961,
      "token_end_exclusive": 1975
    },
    {
      "start_ms": 569470,
      "end_ms": 572760,
      "text": "深秋奇观讲完了盘锦的简蓬草，",
      "token_start": 1975,
      "token_end_exclusive": 1988
    },
    {
      "start_ms": 572920,
      "end_ms": 575625,
      "text": "在盐碱滩里熬出百里红毯。",
      "token_start": 1988,
      "token_end_exclusive": 1999
    },
    {
      "start_ms": 576100,
      "end_ms": 578420,
      "text": "呼伦贝尔把整座草原铺成，",
      "token_start": 1999,
      "token_end_exclusive": 2010
    },
    {
      "start_ms": 578460,
      "end_ms": 579505,
      "text": "金色大海，",
      "token_start": 2010,
      "token_end_exclusive": 2014
    },
    {
      "start_ms": 579970,
      "end_ms": 582675,
      "text": "光暮山八百里红叶烧成了火浪。",
      "token_start": 2014,
      "token_end_exclusive": 2027
    },
    {
      "start_ms": 583180,
      "end_ms": 586140,
      "text": "额济纳的胡杨在荒漠中璀璨。",
      "token_start": 2027,
      "token_end_exclusive": 2039
    },
    {
      "start_ms": 586180,
      "end_ms": 588570,
      "text": "千年长白山天池，",
      "token_start": 2039,
      "token_end_exclusive": 2046
    },
    {
      "start_ms": 588810,
      "end_ms": 593685,
      "text": "把初雪、金华和墨兰的湖水摆进同一个画面，",
      "token_start": 2046,
      "token_end_exclusive": 2064
    },
    {
      "start_ms": 594440,
      "end_ms": 595580,
      "text": "元阳的梯田，",
      "token_start": 2064,
      "token_end_exclusive": 2069
    },
    {
      "start_ms": 595580,
      "end_ms": 598515,
      "text": "把漫天朝霞装进的千万面镜子。",
      "token_start": 2069,
      "token_end_exclusive": 2082
    },
    {
      "start_ms": 599210,
      "end_ms": 604080,
      "text": "银杏村把金色落叶、融进人间烟火大峡谷，",
      "token_start": 2082,
      "token_end_exclusive": 2099
    },
    {
      "start_ms": 604080,
      "end_ms": 607770,
      "text": "让日照金山同矿、翡翠、江水九寨沟，",
      "token_start": 2099,
      "token_end_exclusive": 2113
    },
    {
      "start_ms": 607950,
      "end_ms": 610555,
      "text": "让整片丘陵长在了水底。",
      "token_start": 2113,
      "token_end_exclusive": 2123
    },
    {
      "start_ms": 611150,
      "end_ms": 619550,
      "text": "可只有喀纳斯湖能将冰川的乳白、白化的纯金、晨雾的空灵与雪山的巍峨，",
      "token_start": 2123,
      "token_end_exclusive": 2153
    },
    {
      "start_ms": 619850,
      "end_ms": 625465,
      "text": "在十多天里淬炼成洗涤人间灵魂的终极画卷。",
      "token_start": 2153,
      "token_end_exclusive": 2172
    },
    {
      "start_ms": 625950,
      "end_ms": 628830,
      "text": "最惊艳的秋天不是红的，",
      "token_start": 2172,
      "token_end_exclusive": 2182
    },
    {
      "start_ms": 628830,
      "end_ms": 629445,
      "text": "最劣，",
      "token_start": 2182,
      "token_end_exclusive": 2184
    },
    {
      "start_ms": 629860,
      "end_ms": 630900,
      "text": "也不是金的，",
      "token_start": 2184,
      "token_end_exclusive": 2189
    },
    {
      "start_ms": 630900,
      "end_ms": 631425,
      "text": "最亮，",
      "token_start": 2189,
      "token_end_exclusive": 2191
    },
    {
      "start_ms": 631870,
      "end_ms": 634125,
      "text": "是看一眼心里就宽的。",
      "token_start": 2191,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 634650,
      "end_ms": 635525,
      "text": "最后问问您，",
      "token_start": 2200,
      "token_end_exclusive": 2205
    },
    {
      "start_ms": 636010,
      "end_ms": 637650,
      "text": "这十处深丘奇观，",
      "token_start": 2205,
      "token_end_exclusive": 2212
    },
    {
      "start_ms": 637650,
      "end_ms": 641100,
      "text": "您去过几处最想去的是哪一处？",
      "token_start": 2212,
      "token_end_exclusive": 2225
    },
    {
      "start_ms": 641400,
      "end_ms": 642545,
      "text": "评论区告诉我，",
      "token_start": 2225,
      "token_end_exclusive": 2231
    },
    {
      "start_ms": 642950,
      "end_ms": 651015,
      "text": "刚才说的那本大美中国左下方商品里就有爱看大美山河的朋友别错过，",
      "token_start": 2231,
      "token_end_exclusive": 2261
    },
    {
      "start_ms": 651610,
      "end_ms": 653885,
      "text": "觉得这期让您长了见识，",
      "token_start": 2261,
      "token_end_exclusive": 2271
    },
    {
      "start_ms": 654360,
      "end_ms": 658285,
      "text": "就转给身边跟您一样爱看大美山河的人，",
      "token_start": 2271,
      "token_end_exclusive": 2288
    },
    {
      "start_ms": 658710,
      "end_ms": 661090,
      "text": "想听更多中华大地的地理传奇。",
      "token_start": 2288,
      "token_end_exclusive": 2301
    },
    {
      "start_ms": 661310,
      "end_ms": 662175,
      "text": "点个关注，",
      "token_start": 2301,
      "token_end_exclusive": 2305
    },
    {
      "start_ms": 662550,
      "end_ms": 663995,
      "text": "咱们下期接着聊。",
      "token_start": 2305,
      "token_end_exclusive": 2312
    }
  ],
