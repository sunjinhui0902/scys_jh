{
  "video_id": "v_b732dc1bab9b46b2",
  "duration_s": 372.68,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b732dc1bab9b46b2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b732dc1bab9b46b2.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 2370,
      "text": "爸爸为什么富人越来越富，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2610,
      "end_ms": 4470,
      "text": "穷人想翻身却难如登天？",
      "token_start": 11,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5090,
      "end_ms": 7810,
      "text": "因为同样一百块钱放在不同的人手里，",
      "token_start": 21,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 8029,
      "end_ms": 9190,
      "text": "作用完全不一样。",
      "token_start": 37,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 9630,
      "end_ms": 10990,
      "text": "钱还有什么不一样？",
      "token_start": 44,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 11090,
      "end_ms": 12830,
      "text": "当然对一个人来说，",
      "token_start": 52,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 13010,
      "end_ms": 13730,
      "text": "他是种子。",
      "token_start": 60,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 13930,
      "end_ms": 14870,
      "text": "对另一个人来说，",
      "token_start": 64,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 14950,
      "end_ms": 16190,
      "text": "他可能只是今天的饭钱，",
      "token_start": 71,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 17410,
      "end_ms": 19410,
      "text": "难道穷人就永远翻不了身吗？",
      "token_start": 81,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 21110,
      "end_ms": 22250,
      "text": "我带你去看一个人，",
      "token_start": 93,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 22790,
      "end_ms": 23310,
      "text": "看完以后，",
      "token_start": 101,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 23310,
      "end_ms": 24055,
      "text": "你自己回答，",
      "token_start": 105,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 27760,
      "end_ms": 30580,
      "text": "请进经理，",
      "token_start": 110,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 30840,
      "end_ms": 31660,
      "text": "我在公司楼下，",
      "token_start": 114,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 31660,
      "end_ms": 35960,
      "text": "商业街租了间店铺好地方地方是好，",
      "token_start": 120,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 36260,
      "end_ms": 37820,
      "text": "可我不知道卖什么租金，",
      "token_start": 135,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 37820,
      "end_ms": 38340,
      "text": "交了吗？",
      "token_start": 145,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 38560,
      "end_ms": 39240,
      "text": "交了一年，",
      "token_start": 148,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 39520,
      "end_ms": 40320,
      "text": "那先别开店，",
      "token_start": 152,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 41940,
      "end_ms": 44320,
      "text": "那我干嘛把铺子往外租，",
      "token_start": 157,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 45460,
      "end_ms": 46900,
      "text": "我是来问开什么店，",
      "token_start": 167,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 46920,
      "end_ms": 48160,
      "text": "不是问怎么租出去，",
      "token_start": 175,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 49440,
      "end_ms": 55880,
      "text": "谁让你真租了贴张告示旺铺转租有人来看店铺，",
      "token_start": 183,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 56180,
      "end_ms": 58330,
      "text": "就问他他做什么生意，",
      "token_start": 203,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 58550,
      "end_ms": 59330,
      "text": "做了多少年，",
      "token_start": 212,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 59610,
      "end_ms": 60625,
      "text": "准备做什么生意？",
      "token_start": 217,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 60930,
      "end_ms": 63155,
      "text": "茶叶卖鞋，",
      "token_start": 224,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 64680,
      "end_ms": 67915,
      "text": "开酒馆、做服装，",
      "token_start": 228,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 68430,
      "end_ms": 75265,
      "text": "我做衣服的服装店也是衣服经理，",
      "token_start": 234,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 75750,
      "end_ms": 76590,
      "text": "三十多波人，",
      "token_start": 248,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 76770,
      "end_ms": 78195,
      "text": "光卖衣服的就十二家，",
      "token_start": 253,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 78560,
      "end_ms": 79600,
      "text": "这地方衣服最好卖，",
      "token_start": 262,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 79680,
      "end_ms": 80725,
      "text": "我明天就进衣服。",
      "token_start": 270,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 81220,
      "end_ms": 81765,
      "text": "别着急，",
      "token_start": 277,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 82360,
      "end_ms": 83180,
      "text": "十二家都看好，",
      "token_start": 280,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 83180,
      "end_ms": 84360,
      "text": "这里肯定能挣钱。",
      "token_start": 286,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 84580,
      "end_ms": 86165,
      "text": "你看见十二家卖衣服的，",
      "token_start": 293,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 86350,
      "end_ms": 87235,
      "text": "觉得衣服好卖，",
      "token_start": 303,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 87550,
      "end_ms": 88650,
      "text": "我看见的是十二个，",
      "token_start": 309,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 88650,
      "end_ms": 89835,
      "text": "还没开门的对手。",
      "token_start": 317,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 90090,
      "end_ms": 92940,
      "text": "我问你那十二个人手里有衣服吗？",
      "token_start": 324,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 92980,
      "end_ms": 94485,
      "text": "当然有懂衣服吗？",
      "token_start": 338,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 94860,
      "end_ms": 97565,
      "text": "肯定比我懂有货又懂衣服，",
      "token_start": 345,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 97910,
      "end_ms": 99315,
      "text": "那你为什么还自己进货？",
      "token_start": 356,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 99730,
      "end_ms": 101565,
      "text": "把那十二个做衣服的全叫回来，",
      "token_start": 366,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 102110,
      "end_ms": 103635,
      "text": "告诉他们店铺不租了，",
      "token_start": 379,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 104010,
      "end_ms": 105605,
      "text": "每家拿二十款衣服放你这儿卖，",
      "token_start": 388,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 105980,
      "end_ms": 108360,
      "text": "他们能愿意他们自己开店铺，",
      "token_start": 401,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 108700,
      "end_ms": 109595,
      "text": "要交租金吧，",
      "token_start": 413,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 109920,
      "end_ms": 111380,
      "text": "要要装修吧，",
      "token_start": 418,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 111480,
      "end_ms": 112780,
      "text": "要要雇员工吧，",
      "token_start": 423,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 112980,
      "end_ms": 115805,
      "text": "也要现在呢衣服卖出去，",
      "token_start": 429,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 116100,
      "end_ms": 117035,
      "text": "你才拿一份钱，",
      "token_start": 439,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 117690,
      "end_ms": 118350,
      "text": "卖不出去，",
      "token_start": 445,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 118550,
      "end_ms": 119230,
      "text": "原样拿走，",
      "token_start": 449,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 119250,
      "end_ms": 121030,
      "text": "换别的款换成你，",
      "token_start": 453,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 121170,
      "end_ms": 127770,
      "text": "你来不来在的。",
      "token_start": 460,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 127770,
      "end_ms": 130275,
      "text": "刚才哎太难了，",
      "token_start": 466,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 131690,
      "end_ms": 138360,
      "text": "拜拜为什么？",
      "token_start": 472,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 138420,
      "end_ms": 139730,
      "text": "然后真卖起来了，",
      "token_start": 477,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 139730,
      "end_ms": 140710,
      "text": "哪家的衣服好卖，",
      "token_start": 484,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 140730,
      "end_ms": 141675,
      "text": "一眼就看出来，",
      "token_start": 491,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 141910,
      "end_ms": 142895,
      "text": "那就更简单了。",
      "token_start": 497,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 143330,
      "end_ms": 144905,
      "text": "卖的好的多给好位置，",
      "token_start": 503,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 145110,
      "end_ms": 146345,
      "text": "卖不动的少摆，",
      "token_start": 512,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 146700,
      "end_ms": 148605,
      "text": "连续几天没人要换下一家，",
      "token_start": 518,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 148880,
      "end_ms": 149240,
      "text": "合着我，",
      "token_start": 529,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 149240,
      "end_ms": 150415,
      "text": "更不用猜哪款好卖，",
      "token_start": 532,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 150940,
      "end_ms": 151860,
      "text": "你猜他干什么，",
      "token_start": 540,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 152000,
      "end_ms": 153420,
      "text": "顾客自然会替你挑。",
      "token_start": 546,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 153740,
      "end_ms": 155260,
      "text": "可十二家挤在一个店铺里，",
      "token_start": 554,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 155260,
      "end_ms": 155860,
      "text": "不乱吗？",
      "token_start": 565,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 156080,
      "end_ms": 156740,
      "text": "乱才好，",
      "token_start": 568,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 156920,
      "end_ms": 157680,
      "text": "谁卖贵了，",
      "token_start": 571,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 157680,
      "end_ms": 158660,
      "text": "顾客买别家的，",
      "token_start": 575,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 158740,
      "end_ms": 160915,
      "text": "谁家的衣服差了好位置让给别人，",
      "token_start": 581,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 161180,
      "end_ms": 162220,
      "text": "你要自己卖衣服，",
      "token_start": 595,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 162340,
      "end_ms": 162920,
      "text": "得进货，",
      "token_start": 602,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 162920,
      "end_ms": 164215,
      "text": "压资金、赌款式。",
      "token_start": 605,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 164630,
      "end_ms": 166430,
      "text": "现在呢十二家给你供货，",
      "token_start": 611,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 166590,
      "end_ms": 167610,
      "text": "顾客替你挑货，",
      "token_start": 621,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 167810,
      "end_ms": 169595,
      "text": "我只从卖出去的衣服里拿钱，",
      "token_start": 627,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 169980,
      "end_ms": 172460,
      "text": "差点把十二个做服装的全变成我的对手。",
      "token_start": 639,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 172580,
      "end_ms": 173340,
      "text": "做买卖啊，",
      "token_start": 656,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 173460,
      "end_ms": 174300,
      "text": "看见同行多，",
      "token_start": 660,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 174460,
      "end_ms": 175715,
      "text": "别光想着怎么打败他，",
      "token_start": 665,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 176270,
      "end_ms": 184310,
      "text": "先琢磨琢磨能不能让他给你干活儿怎么样。",
      "token_start": 674,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 185130,
      "end_ms": 186850,
      "text": "现在能回答刚才的问题了吗？",
      "token_start": 692,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 187190,
      "end_ms": 188410,
      "text": "我好像明白了，",
      "token_start": 704,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 189070,
      "end_ms": 189670,
      "text": "说说看，",
      "token_start": 710,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 189890,
      "end_ms": 191230,
      "text": "同样是租了一间铺子，",
      "token_start": 713,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 191450,
      "end_ms": 193130,
      "text": "他想到的是自己花钱进货，",
      "token_start": 722,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 193370,
      "end_ms": 195770,
      "text": "你想到的却让十二个卖衣服的人给他供货，",
      "token_start": 733,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 196010,
      "end_ms": 197810,
      "text": "再让顾客帮他挑出什么最好卖。",
      "token_start": 751,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 198310,
      "end_ms": 201870,
      "text": "还有呢他原来看到的是十二个竞争对手，",
      "token_start": 764,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 202290,
      "end_ms": 204870,
      "text": "换个角度就变成了十二个可以合作的人。",
      "token_start": 781,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 204970,
      "end_ms": 205950,
      "text": "所以同样的钱，",
      "token_start": 798,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 206170,
      "end_ms": 206950,
      "text": "同样的店铺，",
      "token_start": 804,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 207170,
      "end_ms": 209050,
      "text": "最后的结果可能完全不一样。",
      "token_start": 809,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 209570,
      "end_ms": 214940,
      "text": "现在明白我为什么说同样一百块钱在不同的人手里作用完全不一样了吗？",
      "token_start": 821,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 215000,
      "end_ms": 215660,
      "text": "明白了，",
      "token_start": 852,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 215960,
      "end_ms": 218920,
      "text": "可是爸爸这些东西你都是从哪学来的？",
      "token_start": 855,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 219800,
      "end_ms": 221440,
      "text": "哪有人天生就会做生意，",
      "token_start": 871,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 222680,
      "end_ms": 225465,
      "text": "很多东西都是一点一点学出来的。",
      "token_start": 881,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 228260,
      "end_ms": 229340,
      "text": "浙商思维。",
      "token_start": 895,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 229640,
      "end_ms": 229955,
      "text": "嗯，",
      "token_start": 899,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 232720,
      "end_ms": 233460,
      "text": "你看这一句，",
      "token_start": 900,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 233640,
      "end_ms": 234420,
      "text": "别人扎堆，",
      "token_start": 905,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 234420,
      "end_ms": 234960,
      "text": "我收手，",
      "token_start": 909,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 235120,
      "end_ms": 235840,
      "text": "别人观望，",
      "token_start": 912,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 235860,
      "end_ms": 236440,
      "text": "我入局，",
      "token_start": 916,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 236700,
      "end_ms": 238820,
      "text": "刚才十二个人都准备开服装店。",
      "token_start": 919,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 239100,
      "end_ms": 240060,
      "text": "如果别人卖什么，",
      "token_start": 932,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 240060,
      "end_ms": 241165,
      "text": "你就跟着卖什么，",
      "token_start": 939,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 241400,
      "end_ms": 242565,
      "text": "那不叫发现机会，",
      "token_start": 946,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 242900,
      "end_ms": 244585,
      "text": "那就要跟着别人挤一条路。",
      "token_start": 953,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 245320,
      "end_ms": 246085,
      "text": "再看这一句，",
      "token_start": 964,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 246340,
      "end_ms": 247060,
      "text": "大胆入局，",
      "token_start": 969,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 247220,
      "end_ms": 248635,
      "text": "绝不赌上全部身家。",
      "token_start": 973,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 249050,
      "end_ms": 250550,
      "text": "普通人本钱本来就不多，",
      "token_start": 981,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 250690,
      "end_ms": 251970,
      "text": "更不能还没看懂市场，",
      "token_start": 991,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 251970,
      "end_ms": 254730,
      "text": "就把全部积蓄压进去先试再做，",
      "token_start": 1000,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 255010,
      "end_ms": 255450,
      "text": "跑得通，",
      "token_start": 1013,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 255450,
      "end_ms": 256510,
      "text": "在家跑不通，",
      "token_start": 1016,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 256510,
      "end_ms": 257215,
      "text": "还能回头。",
      "token_start": 1021,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 257480,
      "end_ms": 259240,
      "text": "就像刚才让他先天旺铺转租。",
      "token_start": 1025,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 259460,
      "end_ms": 259700,
      "text": "对，",
      "token_start": 1037,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 259960,
      "end_ms": 262340,
      "text": "先让市场告诉你这里到底适合卖什么。",
      "token_start": 1038,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 262340,
      "end_ms": 264485,
      "text": "还有这一句同行不是敌人，",
      "token_start": 1054,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 264750,
      "end_ms": 265745,
      "text": "是共赢伙伴。",
      "token_start": 1065,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 266070,
      "end_ms": 268210,
      "text": "刚才那个职员看见十二个卖衣服的，",
      "token_start": 1070,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 268250,
      "end_ms": 269210,
      "text": "想到的是竞争，",
      "token_start": 1085,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 269470,
      "end_ms": 270315,
      "text": "换一个角度，",
      "token_start": 1091,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 270680,
      "end_ms": 273300,
      "text": "十二个竞争对手就变成了十二个供货商。",
      "token_start": 1096,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 273520,
      "end_ms": 274715,
      "text": "所以这里还有一句，",
      "token_start": 1113,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 275030,
      "end_ms": 276310,
      "text": "信息渠道共享，",
      "token_start": 1121,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 276490,
      "end_ms": 277550,
      "text": "机遇互利共生，",
      "token_start": 1127,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 277830,
      "end_ms": 278550,
      "text": "别人有货，",
      "token_start": 1133,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 278610,
      "end_ms": 279130,
      "text": "懂衣服，",
      "token_start": 1137,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 279130,
      "end_ms": 280355,
      "text": "他有店铺、有客流，",
      "token_start": 1140,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 280700,
      "end_ms": 282595,
      "text": "不是所有生意都要自己从头做到尾。",
      "token_start": 1147,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 282870,
      "end_ms": 287310,
      "text": "有时候真正重要的是把别人已经有的资源重新组合起来，",
      "token_start": 1162,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 287470,
      "end_ms": 288810,
      "text": "那只要会整合资源，",
      "token_start": 1186,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 288810,
      "end_ms": 289810,
      "text": "就一定能赚钱吗？",
      "token_start": 1194,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 289890,
      "end_ms": 291060,
      "text": "当然不是你。",
      "token_start": 1201,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 291060,
      "end_ms": 291840,
      "text": "再看这一句，",
      "token_start": 1206,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 291980,
      "end_ms": 294140,
      "text": "稳住风险底线比拼命赚钱更重要。",
      "token_start": 1211,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 294220,
      "end_ms": 295320,
      "text": "会赚钱是能力，",
      "token_start": 1225,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 295500,
      "end_ms": 296995,
      "text": "会守钱才是本事，",
      "token_start": 1231,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 297310,
      "end_ms": 299170,
      "text": "尤其是普通人本钱越少，",
      "token_start": 1238,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 299370,
      "end_ms": 301345,
      "text": "越不能拿全部家电去赌一次机会。",
      "token_start": 1248,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 301840,
      "end_ms": 303320,
      "text": "还有这一句拒绝虚胖，",
      "token_start": 1262,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 303340,
      "end_ms": 303740,
      "text": "规模，",
      "token_start": 1271,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 303960,
      "end_ms": 305240,
      "text": "落袋才是真利润。",
      "token_start": 1273,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 305320,
      "end_ms": 306140,
      "text": "开多大的店，",
      "token_start": 1280,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 306160,
      "end_ms": 306860,
      "text": "进多少货，",
      "token_start": 1285,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 307040,
      "end_ms": 309940,
      "text": "都不代表你真正赚到了钱货堆在仓库里，",
      "token_start": 1289,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 309940,
      "end_ms": 310740,
      "text": "那不是利润，",
      "token_start": 1306,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 310860,
      "end_ms": 311940,
      "text": "那是被压住的钱，",
      "token_start": 1311,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 312220,
      "end_ms": 314460,
      "text": "真正能留下来的才是自己的。",
      "token_start": 1318,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 314620,
      "end_ms": 315720,
      "text": "现在你再回答我，",
      "token_start": 1330,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 316440,
      "end_ms": 319120,
      "text": "为什么同样一百块钱放在不同的人手里，",
      "token_start": 1337,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 319140,
      "end_ms": 320380,
      "text": "作用会完全不一样？",
      "token_start": 1354,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 320980,
      "end_ms": 323440,
      "text": "因为有的人只看到一百块钱能买什么，",
      "token_start": 1362,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 323840,
      "end_ms": 325820,
      "text": "有的人却会想怎么利用它，",
      "token_start": 1378,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 325880,
      "end_ms": 326500,
      "text": "怎么借力，",
      "token_start": 1389,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 326500,
      "end_ms": 327380,
      "text": "怎么控制风险，",
      "token_start": 1393,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 327680,
      "end_ms": 329360,
      "text": "再让它慢慢变成更多的钱。",
      "token_start": 1399,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 329560,
      "end_ms": 331180,
      "text": "还有逆向思维、试错思维，",
      "token_start": 1410,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 331180,
      "end_ms": 334410,
      "text": "抱观思维、资源整合、现金流和风险控制。",
      "token_start": 1420,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 334410,
      "end_ms": 335490,
      "text": "别人看见同行，",
      "token_start": 1436,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 335490,
      "end_ms": 336410,
      "text": "只想着怎么竞争，",
      "token_start": 1442,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 336490,
      "end_ms": 337770,
      "text": "有人却会想怎么合作。",
      "token_start": 1449,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 338130,
      "end_ms": 340290,
      "text": "别人一做生意就想着压货扩店，",
      "token_start": 1458,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 340510,
      "end_ms": 342630,
      "text": "有人先想的是怎么把风险降下来，",
      "token_start": 1471,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 342630,
      "end_ms": 343990,
      "text": "那普通人还有机会吗？",
      "token_start": 1485,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 344230,
      "end_ms": 344890,
      "text": "当然有，",
      "token_start": 1494,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 345250,
      "end_ms": 346270,
      "text": "只是本钱越少，",
      "token_start": 1497,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 346330,
      "end_ms": 347110,
      "text": "越不能靠赌，",
      "token_start": 1503,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 347290,
      "end_ms": 349270,
      "text": "要靠判断、靠积累、靠借力，",
      "token_start": 1508,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 349450,
      "end_ms": 350690,
      "text": "更要学会控制风险。",
      "token_start": 1518,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 350850,
      "end_ms": 353450,
      "text": "这本浙商思维里讲的不只是怎么赚钱，",
      "token_start": 1526,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 353550,
      "end_ms": 356430,
      "text": "真正值得学的不是哪一个所谓的发财绝招，",
      "token_start": 1542,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 356590,
      "end_ms": 358290,
      "text": "而是遇到同样一件事的时候，",
      "token_start": 1560,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 358430,
      "end_ms": 359910,
      "text": "你能不能换一个角度去看。",
      "token_start": 1572,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 359970,
      "end_ms": 362535,
      "text": "所以你刚才说的种子其实不只是钱。",
      "token_start": 1583,
      "token_end_exclusive": 1598
    },
    {
      "start_ms": 362870,
      "end_ms": 363185,
      "text": "对，",
      "token_start": 1598,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 363710,
      "end_ms": 364525,
      "text": "钱是种子，",
      "token_start": 1599,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 364910,
      "end_ms": 366150,
      "text": "但真正决定这颗种子，",
      "token_start": 1603,
      "token_end_exclusive": 1612
    },
    {
      "start_ms": 366150,
      "end_ms": 369715,
      "text": "最后能不能长大的是一个人看问题、做选择的方式，",
      "token_start": 1612,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 370090,
      "end_ms": 370850,
      "text": "我明白了，",
      "token_start": 1633,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 370890,
      "end_ms": 372365,
      "text": "明白了就慢慢学。",
      "token_start": 1637,
      "token_end_exclusive": 1644
    }
  ],
