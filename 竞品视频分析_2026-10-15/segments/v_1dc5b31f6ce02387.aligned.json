{
  "video_id": "v_1dc5b31f6ce02387",
  "duration_s": 335.528005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1dc5b31f6ce02387.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1dc5b31f6ce02387.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 4570,
      "text": "上一集我们说到毛蚁生花了九百二十五天，",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4970,
      "end_ms": 6730,
      "text": "建成钱塘江大桥，",
      "token_start": 18,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 7150,
      "end_ms": 8690,
      "text": "通车才八十九天，",
      "token_start": 25,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 9290,
      "end_ms": 13170,
      "text": "就含泪亲自给炸了炸桥。",
      "token_start": 32,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 13190,
      "end_ms": 13590,
      "text": "当晚，",
      "token_start": 42,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 15580,
      "end_ms": 17700,
      "text": "他写下抗战必胜，",
      "token_start": 44,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 17980,
      "end_ms": 22320,
      "text": "此桥必复带着十四箱图纸撤到了后方。",
      "token_start": 51,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 22940,
      "end_ms": 23400,
      "text": "今天，",
      "token_start": 67,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 23440,
      "end_ms": 25060,
      "text": "茅以生系列第二集，",
      "token_start": 69,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 25280,
      "end_ms": 26140,
      "text": "我告诉你，",
      "token_start": 77,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 26520,
      "end_ms": 30520,
      "text": "这座桥的命比你想象的硬的多。",
      "token_start": 81,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 31180,
      "end_ms": 33200,
      "text": "你以为炸完就结束了？",
      "token_start": 94,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 33840,
      "end_ms": 35540,
      "text": "没有这座桥，",
      "token_start": 103,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 36060,
      "end_ms": 38600,
      "text": "前前后后被炸了四次，",
      "token_start": 108,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 39480,
      "end_ms": 42900,
      "text": "第一次是锚以生炸的。",
      "token_start": 117,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 43020,
      "end_ms": 46670,
      "text": "一九三七年十二月二十三日下午五点五，",
      "token_start": 126,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 46750,
      "end_ms": 48190,
      "text": "孔钢梁断裂，",
      "token_start": 143,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 48230,
      "end_ms": 48670,
      "text": "坠江，",
      "token_start": 148,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 49330,
      "end_ms": 51110,
      "text": "为的是不让日军过桥，",
      "token_start": 150,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 51690,
      "end_ms": 53550,
      "text": "可日本人占了桥之后，",
      "token_start": 159,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 54310,
      "end_ms": 55290,
      "text": "不甘心哪。",
      "token_start": 168,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 56310,
      "end_ms": 60935,
      "text": "这是连接护杭营铁路和浙赣铁路的关键通道。",
      "token_start": 172,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 61490,
      "end_ms": 63345,
      "text": "他们做梦都想用上。",
      "token_start": 191,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 64310,
      "end_ms": 65315,
      "text": "一九四零年，",
      "token_start": 199,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 65980,
      "end_ms": 69585,
      "text": "日本人先在坠江的废钢梁上搭木板，",
      "token_start": 204,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 70190,
      "end_ms": 72920,
      "text": "凑合让汽车过那桥走上去，",
      "token_start": 219,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 72920,
      "end_ms": 75345,
      "text": "晃晃悠悠跟走钢丝似的。",
      "token_start": 230,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 75890,
      "end_ms": 77425,
      "text": "到了一九四四年十月，",
      "token_start": 240,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 77890,
      "end_ms": 79735,
      "text": "好不容易把铁路修通，",
      "token_start": 249,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 80190,
      "end_ms": 82190,
      "text": "全是东拼西凑的活，",
      "token_start": 258,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 82210,
      "end_ms": 85745,
      "text": "公路桥到日军投降都没能修好。",
      "token_start": 266,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 86560,
      "end_ms": 87945,
      "text": "你以为这就完了？",
      "token_start": 279,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 88660,
      "end_ms": 90070,
      "text": "更狠的是，",
      "token_start": 286,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 90070,
      "end_ms": 93705,
      "text": "中国人自己抗战到了后期，",
      "token_start": 290,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 94670,
      "end_ms": 98035,
      "text": "中国的游击队员盯上了这座桥。",
      "token_start": 301,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 98700,
      "end_ms": 100325,
      "text": "你日本人不是想修吗？",
      "token_start": 314,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 101080,
      "end_ms": 101815,
      "text": "修好了，",
      "token_start": 323,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 102050,
      "end_ms": 102895,
      "text": "我就给你炸了。",
      "token_start": 326,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 103920,
      "end_ms": 104565,
      "text": "据记载，",
      "token_start": 332,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 105430,
      "end_ms": 111785,
      "text": "一支二十多人的爆破队带着五百多公斤爆破材料摸到萧山，",
      "token_start": 335,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 112740,
      "end_ms": 114145,
      "text": "雇了乡下的船工，",
      "token_start": 360,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 114740,
      "end_ms": 120055,
      "text": "夜里把船滑到桥墩底下装上定时爆破材料，",
      "token_start": 367,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 120630,
      "end_ms": 121845,
      "text": "人撤远了。",
      "token_start": 385,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 122380,
      "end_ms": 128345,
      "text": "在想一九四四年春天五号吨挨炸了一次，",
      "token_start": 389,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 129220,
      "end_ms": 133225,
      "text": "一九四五年年初六号吨又挨炸了一次。",
      "token_start": 406,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 134180,
      "end_ms": 136795,
      "text": "你想想那个画面月黑风高，",
      "token_start": 422,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 137290,
      "end_ms": 138470,
      "text": "小船划到桥墩，",
      "token_start": 433,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 138470,
      "end_ms": 141085,
      "text": "底下人在水下摸黑作业，",
      "token_start": 439,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 141600,
      "end_ms": 143505,
      "text": "头顶上就是日本人的岗哨，",
      "token_start": 449,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 144110,
      "end_ms": 146525,
      "text": "稍有不慎就是没命的事。",
      "token_start": 460,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 147160,
      "end_ms": 150045,
      "text": "茅以升炸桥是不能留给敌人，",
      "token_start": 470,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 150520,
      "end_ms": 157795,
      "text": "游击队长是你修好了也不让你用一座桥来回折腾日本人修一次，",
      "token_start": 482,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 158090,
      "end_ms": 159265,
      "text": "中国人炸一次，",
      "token_start": 509,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 159610,
      "end_ms": 160470,
      "text": "再修一次，",
      "token_start": 515,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 160590,
      "end_ms": 161530,
      "text": "再炸一次。",
      "token_start": 519,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 161610,
      "end_ms": 162950,
      "text": "到了一九四五年，",
      "token_start": 523,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 162970,
      "end_ms": 163915,
      "text": "抗战胜利，",
      "token_start": 530,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 164190,
      "end_ms": 165275,
      "text": "日本人投降了，",
      "token_start": 534,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 165720,
      "end_ms": 168750,
      "text": "你以为这座桥终于能安生了没有？",
      "token_start": 540,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 169230,
      "end_ms": 173225,
      "text": "第四次炸桥发生在一九四九年五月，",
      "token_start": 554,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 173640,
      "end_ms": 175485,
      "text": "杭州被解放的前夕，",
      "token_start": 569,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 176040,
      "end_ms": 178695,
      "text": "撤退的军队又对大乔动了手。",
      "token_start": 577,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 179580,
      "end_ms": 182955,
      "text": "好在地下党员和护桥工人拼死保护，",
      "token_start": 589,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 183650,
      "end_ms": 185385,
      "text": "只炸毁了部分铁轨。",
      "token_start": 604,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 186190,
      "end_ms": 187835,
      "text": "大桥主体保住了，",
      "token_start": 612,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 189520,
      "end_ms": 194205,
      "text": "你算算一九三七年毛以生诈一次，",
      "token_start": 619,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 194720,
      "end_ms": 196955,
      "text": "一九四四年游击队炸一次，",
      "token_start": 633,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 197730,
      "end_ms": 200170,
      "text": "一九四五年游击队再炸一次。",
      "token_start": 644,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 200250,
      "end_ms": 201710,
      "text": "一九四九年撤退，",
      "token_start": 656,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 201730,
      "end_ms": 203445,
      "text": "军队又炸一次，",
      "token_start": 663,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 203890,
      "end_ms": 206135,
      "text": "前前后后炸了四次。",
      "token_start": 669,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 206670,
      "end_ms": 209005,
      "text": "可你知道最神奇的是什么吗？",
      "token_start": 677,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 209450,
      "end_ms": 210315,
      "text": "炸了四次，",
      "token_start": 689,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 210970,
      "end_ms": 212730,
      "text": "这座桥的主体结构，",
      "token_start": 693,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 212970,
      "end_ms": 213965,
      "text": "愣是没垮，",
      "token_start": 701,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 214440,
      "end_ms": 217305,
      "text": "乔墩还在大部分钢粮还能用，",
      "token_start": 705,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 218140,
      "end_ms": 220035,
      "text": "就像一个打不死的硬汉，",
      "token_start": 717,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 220320,
      "end_ms": 221060,
      "text": "挨了四刀，",
      "token_start": 727,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 221240,
      "end_ms": 223695,
      "text": "站起来拍拍灰还能接着干。",
      "token_start": 731,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 224720,
      "end_ms": 226015,
      "text": "为什么这么结实？",
      "token_start": 742,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 226950,
      "end_ms": 229635,
      "text": "因为毛以生当年造桥的时候，",
      "token_start": 749,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 230060,
      "end_ms": 232255,
      "text": "是真材实料往里砸，",
      "token_start": 761,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 233250,
      "end_ms": 234155,
      "text": "每一根桩，",
      "token_start": 769,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 234580,
      "end_ms": 239375,
      "text": "每一个吨每一段钢梁都是按最高标准来建。",
      "token_start": 773,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 239690,
      "end_ms": 242475,
      "text": "他造的不是一座应付了事的桥，",
      "token_start": 791,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 242980,
      "end_ms": 245865,
      "text": "是一座能扛住战火的桥。",
      "token_start": 804,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 246830,
      "end_ms": 247470,
      "text": "杭州人，",
      "token_start": 814,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 247470,
      "end_ms": 249515,
      "text": "后来给这座桥起了个外号，",
      "token_start": 817,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 249960,
      "end_ms": 254330,
      "text": "叫乔坚强一座桥谁都拆不掉，",
      "token_start": 828,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 254330,
      "end_ms": 256995,
      "text": "他谁也没法真正拥有他。",
      "token_start": 840,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 257480,
      "end_ms": 259385,
      "text": "日本人想占站不住，",
      "token_start": 850,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 259660,
      "end_ms": 261485,
      "text": "中国人想炸炸不垮，",
      "token_start": 858,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 262310,
      "end_ms": 263875,
      "text": "战火烧了十几年，",
      "token_start": 866,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 264130,
      "end_ms": 266535,
      "text": "他依然横跨在钱塘江上，",
      "token_start": 873,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 267370,
      "end_ms": 268925,
      "text": "这就是中国桥的骨头。",
      "token_start": 883,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 269500,
      "end_ms": 273515,
      "text": "而这一切的起点是那个叫毛以生的人。",
      "token_start": 892,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 274420,
      "end_ms": 278385,
      "text": "他造桥的时候没想过这座桥会经历这么多磨难。",
      "token_start": 908,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 279360,
      "end_ms": 280115,
      "text": "但他知道，",
      "token_start": 928,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 280680,
      "end_ms": 282655,
      "text": "这座桥必须结示，",
      "token_start": 932,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 283540,
      "end_ms": 286985,
      "text": "因为他承载的不只是火车和汽车，",
      "token_start": 939,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 287570,
      "end_ms": 288905,
      "text": "是中国人的骨气。",
      "token_start": 953,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 289890,
      "end_ms": 291410,
      "text": "这座桥被炸了四次，",
      "token_start": 960,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 291410,
      "end_ms": 295500,
      "text": "还能站起来的故事就写在国之脊梁。",
      "token_start": 968,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 295520,
      "end_ms": 296165,
      "text": "这本书里，",
      "token_start": 983,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 296740,
      "end_ms": 298115,
      "text": "书里还有四十多位，",
      "token_start": 987,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 298490,
      "end_ms": 301005,
      "text": "像毛以生这样的国之脊梁，",
      "token_start": 995,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 301560,
      "end_ms": 304655,
      "text": "每一个人的故事都比小说还精彩。",
      "token_start": 1006,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 305190,
      "end_ms": 309765,
      "text": "想要的朋友左下角点链接直接带走，",
      "token_start": 1020,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 310070,
      "end_ms": 311185,
      "text": "但故事还没完，",
      "token_start": 1035,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 311720,
      "end_ms": 315715,
      "text": "矛以身许下的此桥必复四个字，",
      "token_start": 1041,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 316040,
      "end_ms": 317165,
      "text": "后来兑现了吗？",
      "token_start": 1054,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 317780,
      "end_ms": 320765,
      "text": "下一集毛以生系列大结局，",
      "token_start": 1060,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 321040,
      "end_ms": 321705,
      "text": "他回来了，",
      "token_start": 1071,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 322200,
      "end_ms": 327615,
      "text": "带着十四箱图纸把这座炸了四次的桥修了回来。",
      "token_start": 1075,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 328070,
      "end_ms": 331545,
      "text": "如果你也为这座桥坚强感到震撼，",
      "token_start": 1095,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 331900,
      "end_ms": 333615,
      "text": "点个赞收藏起来，",
      "token_start": 1109,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 333930,
      "end_ms": 335465,
      "text": "关注我大结局见。",
      "token_start": 1116,
      "token_end_exclusive": 1123
    }
