{
  "video_id": "v_fdc54f807b359bf0",
  "duration_s": 227.67,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_fdc54f807b359bf0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_fdc54f807b359bf0.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1930,
      "text": "不喝就是看不起我，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2810,
      "end_ms": 3250,
      "text": "领导，",
      "token_start": 8,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3650,
      "end_ms": 4790,
      "text": "我不是看不起您，",
      "token_start": 10,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 5370,
      "end_ms": 6415,
      "text": "我是看不起病，",
      "token_start": 17,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 9090,
      "end_ms": 10590,
      "text": "这鸭子是好鸭子，",
      "token_start": 23,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 10970,
      "end_ms": 11770,
      "text": "就是嘴硬，",
      "token_start": 30,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 12610,
      "end_ms": 13090,
      "text": "嘴硬，",
      "token_start": 34,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 13150,
      "end_ms": 14205,
      "text": "才守得住秘密。",
      "token_start": 36,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 16120,
      "end_ms": 16615,
      "text": "哈哈哈，",
      "token_start": 42,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 19060,
      "end_ms": 19700,
      "text": "来这么晚，",
      "token_start": 45,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 19900,
      "end_ms": 20980,
      "text": "只能吃剩菜了吧。",
      "token_start": 49,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 21380,
      "end_ms": 21780,
      "text": "领导，",
      "token_start": 56,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 22060,
      "end_ms": 23280,
      "text": "饭在哪儿我都能吃，",
      "token_start": 58,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 23500,
      "end_ms": 25480,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 66,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 25540,
      "end_ms": 26895,
      "text": "能赶上已经是我的运气了。",
      "token_start": 79,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 29080,
      "end_ms": 30400,
      "text": "年轻就是好啊，",
      "token_start": 90,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 30800,
      "end_ms": 32480,
      "text": "年轻就是还不够沉稳，",
      "token_start": 96,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 32700,
      "end_ms": 33900,
      "text": "还要向您多学习，",
      "token_start": 105,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 34080,
      "end_ms": 35675,
      "text": "我们才能变得更优秀。",
      "token_start": 112,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 38060,
      "end_ms": 39240,
      "text": "这藕是好藕啊，",
      "token_start": 121,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 39700,
      "end_ms": 41340,
      "text": "就是心眼儿太多了。",
      "token_start": 127,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 41340,
      "end_ms": 43300,
      "text": "领导藕虽然心眼多，",
      "token_start": 135,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 43300,
      "end_ms": 48100,
      "text": "但也是您的下酒菜啊。",
      "token_start": 143,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 48100,
      "end_ms": 49720,
      "text": "小图最近表现不错啊，",
      "token_start": 152,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 49720,
      "end_ms": 51520,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 161,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 51520,
      "end_ms": 52620,
      "text": "我得提前敬一杯。",
      "token_start": 174,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 53100,
      "end_ms": 53820,
      "text": "听这意思，",
      "token_start": 181,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 53860,
      "end_ms": 55040,
      "text": "领导是要高升了呀，",
      "token_start": 185,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 55040,
      "end_ms": 56160,
      "text": "我得提前敬领导。",
      "token_start": 193,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 56160,
      "end_ms": 58920,
      "text": "一杯鱼是好鱼，",
      "token_start": 200,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 59220,
      "end_ms": 60295,
      "text": "可惜就是刺多。",
      "token_start": 206,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 60700,
      "end_ms": 60960,
      "text": "领导，",
      "token_start": 212,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 60960,
      "end_ms": 61320,
      "text": "您看，",
      "token_start": 214,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 61580,
      "end_ms": 62680,
      "text": "鱼虽然刺多，",
      "token_start": 216,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 62760,
      "end_ms": 64560,
      "text": "但主心骨只有一根心腹，",
      "token_start": 221,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 64560,
      "end_ms": 65395,
      "text": "是没有刺的。",
      "token_start": 231,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 66310,
      "end_ms": 68500,
      "text": "呵呵哈小图，",
      "token_start": 236,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 68620,
      "end_ms": 70115,
      "text": "你这菜点的也太多了。",
      "token_start": 241,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 70500,
      "end_ms": 72050,
      "text": "领导菜点的再多，",
      "token_start": 250,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 72150,
      "end_ms": 75070,
      "text": "也比不上平时您对我的照顾多这杯酒先敬，",
      "token_start": 257,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 75070,
      "end_ms": 78940,
      "text": "您真的打这么多饭，",
      "token_start": 275,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 79000,
      "end_ms": 79720,
      "text": "你喂猪呢？",
      "token_start": 283,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 79820,
      "end_ms": 80260,
      "text": "领导，",
      "token_start": 287,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 80320,
      "end_ms": 81080,
      "text": "我哪儿敢啊？",
      "token_start": 289,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 81220,
      "end_ms": 83280,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 294,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 83280,
      "end_ms": 84760,
      "text": "都说宰相肚里能撑船，",
      "token_start": 310,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 84880,
      "end_ms": 86345,
      "text": "更何况只是一碗饭呢。",
      "token_start": 319,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 88230,
      "end_ms": 88575,
      "text": "哎，",
      "token_start": 328,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 88970,
      "end_ms": 89790,
      "text": "你什么意思啊，",
      "token_start": 329,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 89890,
      "end_ms": 91215,
      "text": "怎么到我这儿就剩半杯了？",
      "token_start": 335,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 91480,
      "end_ms": 92360,
      "text": "领导美满，",
      "token_start": 346,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 92360,
      "end_ms": 92765,
      "text": "美满，",
      "token_start": 350,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 93070,
      "end_ms": 94170,
      "text": "代表幸福美满，",
      "token_start": 352,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 94290,
      "end_ms": 96285,
      "text": "这一辈子美满就是一辈子美满啊，",
      "token_start": 358,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 98390,
      "end_ms": 99405,
      "text": "今天让你破费了。",
      "token_start": 372,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 99640,
      "end_ms": 100020,
      "text": "领导，",
      "token_start": 379,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 100120,
      "end_ms": 101860,
      "text": "您说这些您能来，",
      "token_start": 381,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 101860,
      "end_ms": 102715,
      "text": "就是我的荣幸，",
      "token_start": 388,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 103120,
      "end_ms": 104880,
      "text": "以后还有很多地方向您请教，",
      "token_start": 394,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 104880,
      "end_ms": 108380,
      "text": "不是来就来，",
      "token_start": 406,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 108400,
      "end_ms": 109400,
      "text": "带什么礼物啊，",
      "token_start": 411,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 109420,
      "end_ms": 110220,
      "text": "都不是外人。",
      "token_start": 417,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 110380,
      "end_ms": 110760,
      "text": "领导，",
      "token_start": 422,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 110960,
      "end_ms": 111560,
      "text": "您都说了，",
      "token_start": 424,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 111560,
      "end_ms": 112200,
      "text": "不是外人，",
      "token_start": 428,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 112200,
      "end_ms": 113500,
      "text": "我一直都把您当长辈看，",
      "token_start": 432,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 113740,
      "end_ms": 115965,
      "text": "哪有晚辈看长辈空手来的道理啊。",
      "token_start": 442,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 117910,
      "end_ms": 119005,
      "text": "怎么你这一入职，",
      "token_start": 456,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 119510,
      "end_ms": 120730,
      "text": "我刚种的花就死了，",
      "token_start": 463,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 120990,
      "end_ms": 121950,
      "text": "花开富贵嘛，",
      "token_start": 471,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 121950,
      "end_ms": 123330,
      "text": "花开过了就剩富贵了。",
      "token_start": 476,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 123410,
      "end_ms": 125315,
      "text": "看来领导您啊要发大财了。",
      "token_start": 485,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 125980,
      "end_ms": 126440,
      "text": "哈哈，",
      "token_start": 496,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 126830,
      "end_ms": 128065,
      "text": "我真不怎么喜欢你，",
      "token_start": 498,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 128410,
      "end_ms": 130290,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 506,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 130290,
      "end_ms": 132585,
      "text": "我领导的格局值得我们学习。",
      "token_start": 519,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 136840,
      "end_ms": 137460,
      "text": "小图啊，",
      "token_start": 531,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 137740,
      "end_ms": 139495,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 534,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 140260,
      "end_ms": 142560,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 544,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 142780,
      "end_ms": 144795,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 557,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 146910,
      "end_ms": 147545,
      "text": "小图啊，",
      "token_start": 570,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 147860,
      "end_ms": 149120,
      "text": "你个子是真高比，",
      "token_start": 573,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 149120,
      "end_ms": 149995,
      "text": "我还高一头呢。",
      "token_start": 580,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 150450,
      "end_ms": 154275,
      "text": "个高是为了给领导探路走哪儿不还是得听领导指挥吗？",
      "token_start": 586,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 154660,
      "end_ms": 156510,
      "text": "哈哈哈啊哈小图啊，",
      "token_start": 609,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 156750,
      "end_ms": 158365,
      "text": "你一开口就让人喜欢你，",
      "token_start": 617,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 158610,
      "end_ms": 159565,
      "text": "你是怎么做到的？",
      "token_start": 627,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 159870,
      "end_ms": 162010,
      "text": "因为我一直在看这本闲谈高手，",
      "token_start": 634,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 162210,
      "end_ms": 163970,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 647,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 164030,
      "end_ms": 165910,
      "text": "那些会说话、会来事儿的人。",
      "token_start": 658,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 166050,
      "end_ms": 167130,
      "text": "假如你不爱说话，",
      "token_start": 669,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 167270,
      "end_ms": 167970,
      "text": "不爱争辩，",
      "token_start": 676,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 168110,
      "end_ms": 168930,
      "text": "也不爱出门，",
      "token_start": 680,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 169050,
      "end_ms": 170170,
      "text": "甚至恐惧社交。",
      "token_start": 685,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 170510,
      "end_ms": 172505,
      "text": "推荐你读完这本闲谈高手，",
      "token_start": 691,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 172850,
      "end_ms": 175045,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 702,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 175350,
      "end_ms": 176570,
      "text": "你每天就看两页，",
      "token_start": 714,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 176710,
      "end_ms": 178085,
      "text": "每一个场景慢慢练，",
      "token_start": 721,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 178390,
      "end_ms": 180990,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 729,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 181110,
      "end_ms": 182450,
      "text": "在这本书里有一句话，",
      "token_start": 744,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 182510,
      "end_ms": 183375,
      "text": "我特别欣赏，",
      "token_start": 753,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 183720,
      "end_ms": 183880,
      "text": "他，",
      "token_start": 758,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 183880,
      "end_ms": 185920,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 759,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 186080,
      "end_ms": 186885,
      "text": "你可以回，",
      "token_start": 771,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 187320,
      "end_ms": 188280,
      "text": "那是不优秀点，",
      "token_start": 775,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 188340,
      "end_ms": 189615,
      "text": "怎么能和你做朋友呢？",
      "token_start": 781,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 190020,
      "end_ms": 191660,
      "text": "当有人说你真聪明，",
      "token_start": 790,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 191740,
      "end_ms": 193505,
      "text": "你就回近朱者赤，",
      "token_start": 798,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 193770,
      "end_ms": 194690,
      "text": "和你在一起啊，",
      "token_start": 805,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 194790,
      "end_ms": 197850,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
