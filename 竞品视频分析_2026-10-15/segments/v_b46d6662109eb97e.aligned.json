{
  "video_id": "v_b46d6662109eb97e",
  "duration_s": 506.666667,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b46d6662109eb97e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b46d6662109eb97e.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 4110,
      "text": "上集说到四十三岁的彭桓武乡亲，",
      "token_start": 0,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 4470,
      "end_ms": 6690,
      "text": "一眼看上了山东姑娘。",
      "token_start": 14,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 6710,
      "end_ms": 7350,
      "text": "刘秉贤，",
      "token_start": 23,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 8070,
      "end_ms": 9430,
      "text": "他给姑娘写了封信，",
      "token_start": 26,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 10110,
      "end_ms": 11410,
      "text": "先表达心意，",
      "token_start": 34,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 11710,
      "end_ms": 13090,
      "text": "然后话锋一转，",
      "token_start": 39,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 13350,
      "end_ms": 14410,
      "text": "开始列缺点。",
      "token_start": 45,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 15070,
      "end_ms": 16010,
      "text": "我不会做饭，",
      "token_start": 50,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 16410,
      "end_ms": 17510,
      "text": "不会洗衣服，",
      "token_start": 55,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 17750,
      "end_ms": 19070,
      "text": "不懂人情世故，",
      "token_start": 60,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 19430,
      "end_ms": 21590,
      "text": "对金钱权利全没兴趣，",
      "token_start": 66,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 21910,
      "end_ms": 22950,
      "text": "这哪是表白，",
      "token_start": 75,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 23330,
      "end_ms": 25650,
      "text": "这分明是劝退我，",
      "token_start": 80,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 25670,
      "end_ms": 27630,
      "text": "一般姑娘早吓跑了。",
      "token_start": 87,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 28590,
      "end_ms": 31780,
      "text": "可刘秉贤很快回答回了信几句话，",
      "token_start": 95,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 33360,
      "end_ms": 38020,
      "text": "让彭黄武这个一辈子跟物理公式打交道的人红了眼眶。",
      "token_start": 109,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 38480,
      "end_ms": 39680,
      "text": "你不会洗衣服，",
      "token_start": 132,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 39940,
      "end_ms": 42080,
      "text": "我会你不会做饭，",
      "token_start": 138,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 42320,
      "end_ms": 44840,
      "text": "我做你不懂人情世故，",
      "token_start": 145,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 44960,
      "end_ms": 48180,
      "text": "我懂你对权力金钱没兴趣，",
      "token_start": 154,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 48460,
      "end_ms": 50280,
      "text": "我也没有你不会的，",
      "token_start": 165,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 50800,
      "end_ms": 52380,
      "text": "我来你不爱的，",
      "token_start": 173,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 52400,
      "end_ms": 54580,
      "text": "我陪你躲认识两个月，",
      "token_start": 179,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 54820,
      "end_ms": 55660,
      "text": "两人闪婚。",
      "token_start": 188,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 56320,
      "end_ms": 56800,
      "text": "这年，",
      "token_start": 192,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 57100,
      "end_ms": 60405,
      "text": "彭黄武、四十三岁、刘炳贤三十六、六岁，",
      "token_start": 194,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 60890,
      "end_ms": 62965,
      "text": "婚后的彭黄武相变了个人。",
      "token_start": 209,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 63450,
      "end_ms": 64785,
      "text": "以前邋里邋遢，",
      "token_start": 220,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 65250,
      "end_ms": 66615,
      "text": "现在衣服整洁了。",
      "token_start": 226,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 66920,
      "end_ms": 68615,
      "text": "以前泡实验室不回家，",
      "token_start": 233,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 69100,
      "end_ms": 70395,
      "text": "现在知道往家跑了。",
      "token_start": 242,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 70570,
      "end_ms": 73125,
      "text": "刘秉贤包揽所有生活琐事，",
      "token_start": 250,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 73730,
      "end_ms": 75465,
      "text": "让他毫无后顾之忧，",
      "token_start": 261,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 76040,
      "end_ms": 78135,
      "text": "全心扎进国防科研。",
      "token_start": 269,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 78700,
      "end_ms": 82470,
      "text": "这一过就是十九年十九年里，",
      "token_start": 277,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 82650,
      "end_ms": 86455,
      "text": "他把彭怀武照顾的干干净净体体面面，",
      "token_start": 289,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 86940,
      "end_ms": 89595,
      "text": "他在外面撑起国家的核保护伞。",
      "token_start": 305,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 90000,
      "end_ms": 94595,
      "text": "他在家里撑起他的一片天可红颜薄命。",
      "token_start": 318,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 95350,
      "end_ms": 96425,
      "text": "十九年后，",
      "token_start": 334,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 96780,
      "end_ms": 98545,
      "text": "刘秉贤骤然离世，",
      "token_start": 338,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 99850,
      "end_ms": 101585,
      "text": "彭黄武躺在床上，",
      "token_start": 345,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 102020,
      "end_ms": 105295,
      "text": "整整七天七夜不吃不喝。",
      "token_start": 352,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 106340,
      "end_ms": 107105,
      "text": "七天后，",
      "token_start": 362,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 107360,
      "end_ms": 110450,
      "text": "他爬起来干了三件事，",
      "token_start": 365,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 110590,
      "end_ms": 113505,
      "text": "第一把妻子照片挂床头，",
      "token_start": 374,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 113940,
      "end_ms": 119530,
      "text": "一睁眼就要看到第二把妻子骨灰藏花盆，",
      "token_start": 384,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 119590,
      "end_ms": 120165,
      "text": "深处，",
      "token_start": 401,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 120530,
      "end_ms": 121755,
      "text": "不许任何人碰。",
      "token_start": 403,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 122340,
      "end_ms": 122780,
      "text": "第三，",
      "token_start": 409,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 123520,
      "end_ms": 125045,
      "text": "从此一个人住，",
      "token_start": 411,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 125750,
      "end_ms": 127795,
      "text": "不允许任何人搬进来打扰。",
      "token_start": 417,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 128380,
      "end_ms": 131785,
      "text": "这一首就是三十年。",
      "token_start": 428,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 132990,
      "end_ms": 133975,
      "text": "三十年啊，",
      "token_start": 436,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 134230,
      "end_ms": 136130,
      "text": "一个生活不能自理的人，",
      "token_start": 440,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 136530,
      "end_ms": 137510,
      "text": "妻子走后，",
      "token_start": 450,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 137810,
      "end_ms": 138690,
      "text": "自己做饭，",
      "token_start": 454,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 138990,
      "end_ms": 140010,
      "text": "自己洗衣，",
      "token_start": 458,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 140270,
      "end_ms": 141605,
      "text": "自己打理一切。",
      "token_start": 462,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 142880,
      "end_ms": 143700,
      "text": "七十六岁，",
      "token_start": 468,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 143940,
      "end_ms": 145095,
      "text": "开始学做饭，",
      "token_start": 472,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 145570,
      "end_ms": 148175,
      "text": "常常饭烧糊汤煮肝，",
      "token_start": 477,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 148590,
      "end_ms": 150190,
      "text": "可从来不请保姆，",
      "token_start": 485,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 150450,
      "end_ms": 151765,
      "text": "也不让人帮忙。",
      "token_start": 492,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 152300,
      "end_ms": 154160,
      "text": "有人劝他找个人照顾，",
      "token_start": 498,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 154160,
      "end_ms": 154945,
      "text": "他摇摇头，",
      "token_start": 507,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 155270,
      "end_ms": 156765,
      "text": "这是我们两个人的世界。",
      "token_start": 511,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 157810,
      "end_ms": 160925,
      "text": "第三个人进来就不一样了。",
      "token_start": 521,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 161890,
      "end_ms": 164210,
      "text": "他时常对着一张白纸，",
      "token_start": 532,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 164230,
      "end_ms": 165385,
      "text": "跟妻子说话，",
      "token_start": 541,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 166100,
      "end_ms": 170285,
      "text": "写着写着就写成了一本书。",
      "token_start": 546,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 170820,
      "end_ms": 174845,
      "text": "你说这得有多深的感情，",
      "token_start": 557,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 175380,
      "end_ms": 181135,
      "text": "才能让一个老人守着一盆骨灰一张照片过三十年。",
      "token_start": 567,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 182090,
      "end_ms": 186715,
      "text": "但彭黄武的很远不止于此。",
      "token_start": 588,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 188210,
      "end_ms": 189265,
      "text": "一九九五年，",
      "token_start": 599,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 189790,
      "end_ms": 193625,
      "text": "他获得禾梁合力基金科学与技术成就奖，",
      "token_start": 604,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 194200,
      "end_ms": 195935,
      "text": "奖金一百万港币，",
      "token_start": 621,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 196550,
      "end_ms": 198520,
      "text": "九零年代的一百万。",
      "token_start": 628,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 198600,
      "end_ms": 199345,
      "text": "什么概念？",
      "token_start": 636,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 201030,
      "end_ms": 202195,
      "text": "一笔巨款啊，",
      "token_start": 640,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 203040,
      "end_ms": 204915,
      "text": "当时他身患多种疾病，",
      "token_start": 645,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 205710,
      "end_ms": 208765,
      "text": "有人劝他拿着钱治病吧，",
      "token_start": 654,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 209740,
      "end_ms": 210625,
      "text": "身体要紧。",
      "token_start": 664,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 211880,
      "end_ms": 216015,
      "text": "彭欢武怎么说的这钱对我没用处，",
      "token_start": 668,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 216490,
      "end_ms": 220665,
      "text": "然后拿着一百万港币全部捐赠了出去。",
      "token_start": 682,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 221180,
      "end_ms": 223245,
      "text": "设立彭黄武纪念赠款，",
      "token_start": 698,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 223690,
      "end_ms": 227545,
      "text": "从一九九六年到二零零四年九年间，",
      "token_start": 707,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 228090,
      "end_ms": 230245,
      "text": "分批赠给三十五位。",
      "token_start": 722,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 230580,
      "end_ms": 236215,
      "text": "当年一起搞两弹身体受过伤害或生活困难的老同事，",
      "token_start": 730,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 236570,
      "end_ms": 238790,
      "text": "别人拿奖金奖励后人，",
      "token_start": 752,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 238990,
      "end_ms": 241115,
      "text": "他拿奖金回报同代人。",
      "token_start": 761,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 241590,
      "end_ms": 242010,
      "text": "他说，",
      "token_start": 770,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 242190,
      "end_ms": 244010,
      "text": "原子弹是集体的功劳，",
      "token_start": 772,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 244310,
      "end_ms": 247530,
      "text": "奖金也是集体的轻飘飘。",
      "token_start": 781,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 247530,
      "end_ms": 248265,
      "text": "一句话，",
      "token_start": 791,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 248990,
      "end_ms": 251815,
      "text": "一百万的港币一分都没留，",
      "token_start": 794,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 253480,
      "end_ms": 258215,
      "text": "晚年的彭桓武干了件更让人看不懂的事，",
      "token_start": 805,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 258790,
      "end_ms": 262905,
      "text": "他要把自己在人间的痕迹全部擦掉，",
      "token_start": 822,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 263590,
      "end_ms": 265245,
      "text": "推掉各种社会头衔，",
      "token_start": 837,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 266000,
      "end_ms": 268055,
      "text": "谢绝各级领导接见，",
      "token_start": 845,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 268370,
      "end_ms": 269210,
      "text": "不坐专车，",
      "token_start": 853,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 269490,
      "end_ms": 270455,
      "text": "不请保姆，",
      "token_start": 857,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 270950,
      "end_ms": 274135,
      "text": "公交车上没人认得出这老头是谁？",
      "token_start": 861,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 274670,
      "end_ms": 283355,
      "text": "两弹一星功勋奖章捐给中国人民革命军事博物馆、毕生工资积蓄近五十万元，",
      "token_start": 875,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 283720,
      "end_ms": 284820,
      "text": "捐给中科院，",
      "token_start": 907,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 284880,
      "end_ms": 290065,
      "text": "理论物理研究所全部藏书捐给研究所图书馆。",
      "token_start": 912,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 290510,
      "end_ms": 291255,
      "text": "去世前，",
      "token_start": 931,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 291590,
      "end_ms": 292930,
      "text": "他列了张清单，",
      "token_start": 934,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 293850,
      "end_ms": 298680,
      "text": "家里的一本书、一把椅子、一台电脑、一个打印机，",
      "token_start": 940,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 298900,
      "end_ms": 301640,
      "text": "甚至上网号码都一一备注了，",
      "token_start": 959,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 301640,
      "end_ms": 302895,
      "text": "该归还到哪里，",
      "token_start": 971,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 303320,
      "end_ms": 307305,
      "text": "最后连遗体也捐了捐给医院。",
      "token_start": 977,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 307610,
      "end_ms": 309050,
      "text": "用于医学研究。",
      "token_start": 989,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 310170,
      "end_ms": 314430,
      "text": "二零零七年二月二十八日二十一时四十分，",
      "token_start": 995,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 314490,
      "end_ms": 317010,
      "text": "九十二岁的彭黄武在北京逝世。",
      "token_start": 1013,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 317470,
      "end_ms": 318790,
      "text": "他留下的遗嘱，",
      "token_start": 1026,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 319030,
      "end_ms": 322810,
      "text": "每一个字都戳人心窝丧遗从简，",
      "token_start": 1032,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 323130,
      "end_ms": 325690,
      "text": "不举行任何会骨灰不存。",
      "token_start": 1045,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 325730,
      "end_ms": 330890,
      "text": "任何公墓要与妻子刘炳贤的骨灰合并规范，",
      "token_start": 1055,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 330970,
      "end_ms": 332390,
      "text": "自然不要墓碑，",
      "token_start": 1073,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 332450,
      "end_ms": 333290,
      "text": "不要公墓，",
      "token_start": 1079,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 333710,
      "end_ms": 334610,
      "text": "不要纪念，",
      "token_start": 1083,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 335070,
      "end_ms": 338100,
      "text": "只求和妻子的骨灰混在一在一起，",
      "token_start": 1087,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 338440,
      "end_ms": 339520,
      "text": "洒向大自然。",
      "token_start": 1101,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 340140,
      "end_ms": 341980,
      "text": "他来的时候一无所有，",
      "token_start": 1106,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 342340,
      "end_ms": 344260,
      "text": "走的时候两袖清风，",
      "token_start": 1115,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 344880,
      "end_ms": 348200,
      "text": "把自己的一切全部捐给了这个国家。",
      "token_start": 1123,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 348720,
      "end_ms": 353120,
      "text": "最后连骨灰都要和最爱的人一起回归，",
      "token_start": 1138,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 353140,
      "end_ms": 355200,
      "text": "这片他守护了一生的土地。",
      "token_start": 1154,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 355680,
      "end_ms": 356220,
      "text": "如今，",
      "token_start": 1165,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 356540,
      "end_ms": 358440,
      "text": "他的名字被刻在天上。",
      "token_start": 1167,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 358820,
      "end_ms": 368355,
      "text": "中国科学院国家天文台发现的小行星国际永久编号四八七九八被命名为彭循环五行。",
      "token_start": 1176,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 368740,
      "end_ms": 370055,
      "text": "他什么都没留下，",
      "token_start": 1212,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 370480,
      "end_ms": 374430,
      "text": "只留下了天上的一颗星和戈壁滩上，",
      "token_start": 1219,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 374450,
      "end_ms": 379555,
      "text": "那朵永远铭刻在中华民族记忆里的蘑菇云。",
      "token_start": 1234,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 380140,
      "end_ms": 380755,
      "text": "朋友们，",
      "token_start": 1252,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 382260,
      "end_ms": 383395,
      "text": "记住这个名字吧。",
      "token_start": 1255,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 383690,
      "end_ms": 384715,
      "text": "滕黄武，",
      "token_start": 1262,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 385160,
      "end_ms": 390585,
      "text": "一个能让氢弹爆炸生活却不能自理的两弹元群，",
      "token_start": 1265,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 391640,
      "end_ms": 393695,
      "text": "一个对国家倾尽所有，",
      "token_start": 1285,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 393970,
      "end_ms": 396920,
      "text": "对妻子忠贞一生的纯粹的人。",
      "token_start": 1294,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 397240,
      "end_ms": 397895,
      "text": "这束花，",
      "token_start": 1306,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 399570,
      "end_ms": 403615,
      "text": "我们替十四亿人送给他。",
      "token_start": 1309,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 406470,
      "end_ms": 408025,
      "text": "彭欢武的故事讲完了，",
      "token_start": 1319,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 408270,
      "end_ms": 409125,
      "text": "但你知道吗？",
      "token_start": 1328,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 409440,
      "end_ms": 412035,
      "text": "像他这样隐姓埋名，",
      "token_start": 1333,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 412520,
      "end_ms": 413800,
      "text": "为国助盾的人，",
      "token_start": 1341,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 414020,
      "end_ms": 416530,
      "text": "远不止一个钱学森，",
      "token_start": 1347,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 416570,
      "end_ms": 418350,
      "text": "冲破美国五年封锁，",
      "token_start": 1355,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 418390,
      "end_ms": 419375,
      "text": "毅然回国。",
      "token_start": 1363,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 419830,
      "end_ms": 421470,
      "text": "程开甲扎根戈壁，",
      "token_start": 1367,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 421490,
      "end_ms": 423075,
      "text": "二十八年无人知晓，",
      "token_start": 1374,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 423580,
      "end_ms": 426320,
      "text": "林巧志一生结生了五万多个孩子，",
      "token_start": 1382,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 426320,
      "end_ms": 427720,
      "text": "却自己没当过母亲。",
      "token_start": 1396,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 427860,
      "end_ms": 431165,
      "text": "这些人才是我们真正该追的星。",
      "token_start": 1404,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 432180,
      "end_ms": 434985,
      "text": "如果你想把这些故事完整的读一遍，",
      "token_start": 1417,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 435460,
      "end_ms": 437220,
      "text": "我推荐你看看这本书。",
      "token_start": 1432,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 437400,
      "end_ms": 438365,
      "text": "国之几两。",
      "token_start": 1441,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 439070,
      "end_ms": 447165,
      "text": "他由环球人物杂志社主编收录了三十多位科学界功勋人物的真实人生，",
      "token_start": 1445,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 447880,
      "end_ms": 450785,
      "text": "从两弹一星到航天农业，",
      "token_start": 1475,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 451380,
      "end_ms": 453225,
      "text": "从钱学森到袁隆平，",
      "token_start": 1485,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 453960,
      "end_ms": 458905,
      "text": "每一位的故事都像彭桓武这样戳人心窝，",
      "token_start": 1493,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 459610,
      "end_ms": 464915,
      "text": "书里还有大量珍贵的历史老照片和院士亲笔语录。",
      "token_start": 1510,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 465510,
      "end_ms": 467830,
      "text": "不是那种干巴巴的人物传记，",
      "token_start": 1531,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 467910,
      "end_ms": 474955,
      "text": "是真的能让你读着读着就红了眼眶的那种自己读是一份敬意。",
      "token_start": 1543,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 475400,
      "end_ms": 478085,
      "text": "给孩子读是一种传承，",
      "token_start": 1569,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 478650,
      "end_ms": 482305,
      "text": "让咱们的下一代知道什么叫真正的英雄。",
      "token_start": 1578,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 482910,
      "end_ms": 484605,
      "text": "什么叫国之脊梁？",
      "token_start": 1595,
      "token_end_exclusive": 1602
    },
    {
      "start_ms": 484990,
      "end_ms": 487125,
      "text": "这本书就在左下角链接里，",
      "token_start": 1602,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 487470,
      "end_ms": 489570,
      "text": "感兴趣的朋友可以带回去一本，",
      "token_start": 1613,
      "token_end_exclusive": 1626
    },
    {
      "start_ms": 489570,
      "end_ms": 490490,
      "text": "细细品读，",
      "token_start": 1626,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 490950,
      "end_ms": 491610,
      "text": "点个赞，",
      "token_start": 1630,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 491930,
      "end_ms": 492810,
      "text": "收藏起来，",
      "token_start": 1633,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 493090,
      "end_ms": 494210,
      "text": "评论区留一句，",
      "token_start": 1637,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 494210,
      "end_ms": 495030,
      "text": "致敬朋友，",
      "token_start": 1643,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 495550,
      "end_ms": 497530,
      "text": "再转发给身边的人，",
      "token_start": 1647,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 498330,
      "end_ms": 498970,
      "text": "关注我。",
      "token_start": 1655,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 499470,
      "end_ms": 506415,
      "text": "下一期继续讲那些隐姓埋名为国筑盾的无双国事。",
      "token_start": 1658,
      "token_end_exclusive": 1679
    }
  ],
