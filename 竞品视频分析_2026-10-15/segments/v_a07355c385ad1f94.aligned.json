{
  "video_id": "v_a07355c385ad1f94",
  "duration_s": 317.671995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_a07355c385ad1f94.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_a07355c385ad1f94.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 1190,
      "text": "这j你相信吗？",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1230,
      "end_ms": 2090,
      "text": "未来十年，",
      "token_start": 6,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2150,
      "end_ms": 5450,
      "text": "最能赚到时代红利的一批人就是留学生，",
      "token_start": 10,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 5930,
      "end_ms": 7670,
      "text": "不是因为海外文凭有多值钱，",
      "token_start": 27,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 7970,
      "end_ms": 9470,
      "text": "世界不缺英语好的人，",
      "token_start": 39,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 9490,
      "end_ms": 12590,
      "text": "缺的是同时被中国和外国都需要的人。",
      "token_start": 48,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 12870,
      "end_ms": 13850,
      "text": "最近暑假期间，",
      "token_start": 64,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 13850,
      "end_ms": 16210,
      "text": "我去了一趟美国、加拿大和法国旅行。",
      "token_start": 70,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 16330,
      "end_ms": 18550,
      "text": "我接触了一批在欧美留学生活的朋友，",
      "token_start": 85,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 18550,
      "end_ms": 21970,
      "text": "之后发现留学生正在迅速两极分化。",
      "token_start": 101,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 22470,
      "end_ms": 24430,
      "text": "有一类人花了家里的好几百万，",
      "token_start": 116,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 24450,
      "end_ms": 25570,
      "text": "读完世界名校，",
      "token_start": 129,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 25610,
      "end_ms": 27670,
      "text": "最后却只能拿着一张漂亮的文凭，",
      "token_start": 135,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 27850,
      "end_ms": 30540,
      "text": "重新挤进那些最拥挤的求职市上。",
      "token_start": 149,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 30900,
      "end_ms": 31200,
      "text": "但是，",
      "token_start": 163,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 31200,
      "end_ms": 34480,
      "text": "另一类人会成为中国与世界之间最昂贵的借口，",
      "token_start": 165,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 34840,
      "end_ms": 36100,
      "text": "中国什么都能制造，",
      "token_start": 185,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 36180,
      "end_ms": 37540,
      "text": "却仍然缺少这种人。",
      "token_start": 193,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 37880,
      "end_ms": 40160,
      "text": "网上很多人都说留学生变水了，",
      "token_start": 201,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 40280,
      "end_ms": 43760,
      "text": "其实大家不要被社媒上的人均藤效幻象给骗了。",
      "token_start": 214,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 44020,
      "end_ms": 44380,
      "text": "目前，",
      "token_start": 234,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 44380,
      "end_ms": 48240,
      "text": "全国拥有留学经历的人占比甚至不到百分之零点七。",
      "token_start": 236,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 48560,
      "end_ms": 51060,
      "text": "但是稀少并不直接等于值钱。",
      "token_start": 258,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 51540,
      "end_ms": 54100,
      "text": "如果您家里的留学生一定要清醒的意识到，",
      "token_start": 270,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 54300,
      "end_ms": 57700,
      "text": "留学生身上最值钱的三种溢价正在掉价。",
      "token_start": 288,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 58060,
      "end_ms": 59705,
      "text": "第一种是语言溢价，",
      "token_start": 305,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 60020,
      "end_ms": 60800,
      "text": "在过去会说，",
      "token_start": 313,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 60800,
      "end_ms": 63220,
      "text": "一口流利的外语能够读懂外文资料，",
      "token_start": 318,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 63220,
      "end_ms": 64375,
      "text": "就是一种稀缺能力，",
      "token_start": 333,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 64630,
      "end_ms": 67785,
      "text": "但是现在人工智能基本上已经取代翻译了。",
      "token_start": 341,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 68330,
      "end_ms": 69685,
      "text": "第二种是信息溢价。",
      "token_start": 359,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 69960,
      "end_ms": 73935,
      "text": "过去出国就意味着你能看到国内看不到的东西和接触不到的人。",
      "token_start": 367,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 74180,
      "end_ms": 74640,
      "text": "在今天，",
      "token_start": 394,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 74660,
      "end_ms": 78120,
      "text": "信息平权中国和外国不仅已经没有信息差了，",
      "token_start": 397,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 78120,
      "end_ms": 79805,
      "text": "甚至还走在了他们的前面。",
      "token_start": 416,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 80130,
      "end_ms": 80530,
      "text": "我发现，",
      "token_start": 427,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 80530,
      "end_ms": 84605,
      "text": "很多欧美人对中国的了解要远远小于中国人对他们的了解。",
      "token_start": 430,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 84980,
      "end_ms": 86665,
      "text": "第三种就是文凭溢价。",
      "token_start": 455,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 87100,
      "end_ms": 88700,
      "text": "名校当然仍然重要，",
      "token_start": 464,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 88720,
      "end_ms": 91055,
      "text": "但并不能直接证明你能够解决问题。",
      "token_start": 472,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 91410,
      "end_ms": 93375,
      "text": "比如我的公司有两位副总，",
      "token_start": 487,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 93660,
      "end_ms": 95580,
      "text": "一个是英国伦敦大学的硕士，",
      "token_start": 498,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 95720,
      "end_ms": 96875,
      "text": "另一个只是大专生，",
      "token_start": 510,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 97180,
      "end_ms": 99475,
      "text": "但是他们拿的薪水标准是一模一样的。",
      "token_start": 518,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 99810,
      "end_ms": 104475,
      "text": "今天的企业已经不会仅仅因为你去过国外就自动多付你一份工资。",
      "token_start": 534,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 104960,
      "end_ms": 107600,
      "text": "市场真正在乎的从来不是你见过什么，",
      "token_start": 562,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 107600,
      "end_ms": 108945,
      "text": "而是你能解决什么。",
      "token_start": 578,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 109330,
      "end_ms": 111845,
      "text": "那未来什么东西反而会变得越来越贵呢？",
      "token_start": 586,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 112060,
      "end_ms": 115645,
      "text": "答案就是降低两个世界之间摩擦的能力。",
      "token_start": 603,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 116080,
      "end_ms": 118075,
      "text": "未来十年有一个趋势是一定的，",
      "token_start": 620,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 118340,
      "end_ms": 120215,
      "text": "中国会真正全面走向世界，",
      "token_start": 633,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 120480,
      "end_ms": 122065,
      "text": "不只是简单的made in china,",
      "token_start": 644,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 122280,
      "end_ms": 125340,
      "text": "而是产业出海、技术出海、品牌出海，",
      "token_start": 653,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 125440,
      "end_ms": 126725,
      "text": "甚至是文化出海。",
      "token_start": 667,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 127100,
      "end_ms": 128020,
      "text": "截至二零二五年，",
      "token_start": 674,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 128020,
      "end_ms": 134765,
      "text": "中国已经在全球一百九十个国家和地区设立了五点二万家境外企业、汽车、新能源电商等等。",
      "token_start": 681,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 135030,
      "end_ms": 136745,
      "text": "但是这里面有一个巨大的问题，",
      "token_start": 719,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 136970,
      "end_ms": 140240,
      "text": "那就是我们中国人在外国开的公司员工，",
      "token_start": 732,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 140240,
      "end_ms": 141915,
      "text": "超过一多半都是外国人。",
      "token_start": 749,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 142320,
      "end_ms": 143700,
      "text": "所以你真正的竞争对手，",
      "token_start": 759,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 143700,
      "end_ms": 145215,
      "text": "不只是那些国内的毕业生，",
      "token_start": 769,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 145510,
      "end_ms": 147850,
      "text": "更是那些比你更懂得当地语言，",
      "token_start": 780,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 147850,
      "end_ms": 149030,
      "text": "更懂得当地规则，",
      "token_start": 793,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 149030,
      "end_ms": 151295,
      "text": "更懂得当地人情世故的本地人。",
      "token_start": 800,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 151720,
      "end_ms": 152620,
      "text": "在这种环境中，",
      "token_start": 813,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 152620,
      "end_ms": 155345,
      "text": "最有价值的并不是夹在两边传话的人，",
      "token_start": 819,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 155580,
      "end_ms": 157495,
      "text": "而是能够翻译两套规则，",
      "token_start": 835,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 157780,
      "end_ms": 158920,
      "text": "建立两边信任，",
      "token_start": 845,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 158920,
      "end_ms": 160365,
      "text": "最终让事情落地的人。",
      "token_start": 851,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 160710,
      "end_ms": 161450,
      "text": "而这件事情，",
      "token_start": 860,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 161450,
      "end_ms": 162735,
      "text": "AI永远无法替代，",
      "token_start": 865,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 162960,
      "end_ms": 164045,
      "text": "只有人能够完成。",
      "token_start": 872,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 164320,
      "end_ms": 166220,
      "text": "因为人工智能可以替你翻一句话，",
      "token_start": 879,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 166420,
      "end_ms": 168204,
      "text": "但它却不承担任何后果。",
      "token_start": 893,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 168480,
      "end_ms": 169940,
      "text": "Ai可以生成一份方案，",
      "token_start": 903,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 169980,
      "end_ms": 172025,
      "text": "却不能替你积累十年的信用。",
      "token_start": 912,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 172350,
      "end_ms": 174150,
      "text": "所以未来真正值钱的留学生，",
      "token_start": 924,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 174150,
      "end_ms": 175925,
      "text": "至少要长出两种能力。",
      "token_start": 936,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 176170,
      "end_ms": 178115,
      "text": "第一种能力叫跨境信任，",
      "token_start": 945,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 178440,
      "end_ms": 182375,
      "text": "就是说让中外两边都愿意把事儿很信任的交给你，",
      "token_start": 955,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 182840,
      "end_ms": 184455,
      "text": "你认识一百个人并不值钱，",
      "token_start": 976,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 184720,
      "end_ms": 187925,
      "text": "关键时刻有多少人愿意相信你的判断才值钱。",
      "token_start": 987,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 188460,
      "end_ms": 190100,
      "text": "你得懂中国在想什么，",
      "token_start": 1006,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 190180,
      "end_ms": 191705,
      "text": "也得懂外国人在想什么。",
      "token_start": 1015,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 191910,
      "end_ms": 193530,
      "text": "你要知道中国有什么能力，",
      "token_start": 1025,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 193530,
      "end_ms": 197065,
      "text": "有什么产品也要知道海外真正愿意为什么买单。",
      "token_start": 1036,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 197500,
      "end_ms": 199625,
      "text": "第二种能力叫双向理解力，",
      "token_start": 1056,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 200120,
      "end_ms": 201680,
      "text": "会在英国点杯咖啡，",
      "token_start": 1067,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 201700,
      "end_ms": 203465,
      "text": "并不等于直接懂英国市场。",
      "token_start": 1075,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 203730,
      "end_ms": 207660,
      "text": "会在法国租房不等于懂法国消费者在美国生活几年，",
      "token_start": 1086,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 207660,
      "end_ms": 210595,
      "text": "也并不意味着你天然就理解美国的商业规则。",
      "token_start": 1108,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 210990,
      "end_ms": 214565,
      "text": "这一点我觉得很多留学生都比不上浙江义乌的老板娘们。",
      "token_start": 1127,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 215030,
      "end_ms": 216830,
      "text": "很多义乌和温州的老板娘们，",
      "token_start": 1151,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 216830,
      "end_ms": 218225,
      "text": "他们通宵学习英语，",
      "token_start": 1163,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 218560,
      "end_ms": 221545,
      "text": "白天他们跟中国工厂沟通打样和价格。",
      "token_start": 1171,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 221740,
      "end_ms": 222260,
      "text": "在深夜，",
      "token_start": 1187,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 222440,
      "end_ms": 225525,
      "text": "他们又要按照欧美和中东客户的时间去回复消息。",
      "token_start": 1190,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 225950,
      "end_ms": 227870,
      "text": "国外客户提出一个模糊的想法，",
      "token_start": 1211,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 227950,
      "end_ms": 233395,
      "text": "他们能够迅速把它变成尺寸、颜色、材料和样品工厂生产出来一个好产品，",
      "token_start": 1224,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 233640,
      "end_ms": 236780,
      "text": "他们又要把它重新翻译成当地消费者听得懂，",
      "token_start": 1254,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 236920,
      "end_ms": 238935,
      "text": "愿意相信愿意付款的理由。",
      "token_start": 1273,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 239650,
      "end_ms": 240930,
      "text": "那些浙江的老板娘们，",
      "token_start": 1284,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 240930,
      "end_ms": 242205,
      "text": "他们懂的不只是外语。",
      "token_start": 1293,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 242420,
      "end_ms": 245515,
      "text": "他们知道不同国家的节日审美和消费习惯，",
      "token_start": 1302,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 245770,
      "end_ms": 246750,
      "text": "知道一个标签，",
      "token_start": 1320,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 246830,
      "end_ms": 248535,
      "text": "一种包装或者一个插头，",
      "token_start": 1326,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 248780,
      "end_ms": 251425,
      "text": "都可能决定一批货能不能进入外国市场。",
      "token_start": 1336,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 251790,
      "end_ms": 254975,
      "text": "我记得托马斯弗里德曼在二十年前写过一本畅销书，",
      "token_start": 1353,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 255170,
      "end_ms": 256545,
      "text": "叫世界是平的。",
      "token_start": 1375,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 256860,
      "end_ms": 257160,
      "text": "他说，",
      "token_start": 1381,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 257160,
      "end_ms": 260495,
      "text": "技术互联网和全球供应链正在削屏世界的壁垒。",
      "token_start": 1383,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 260920,
      "end_ms": 263205,
      "text": "但是最近几年他又推翻了当年的判断。",
      "token_start": 1403,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 263480,
      "end_ms": 266250,
      "text": "他的世界其实远没有那么平技术。",
      "token_start": 1419,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 266250,
      "end_ms": 267755,
      "text": "削屏的是信息的高山，",
      "token_start": 1433,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 268010,
      "end_ms": 271845,
      "text": "却没有削平制度的高山、文化的高山和信任的高山。",
      "token_start": 1442,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 272410,
      "end_ms": 273690,
      "text": "而未来最值钱的人，",
      "token_start": 1463,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 273690,
      "end_ms": 278405,
      "text": "正是那些能够带着产品规则和信任翻过这些高山的人。",
      "token_start": 1471,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 279040,
      "end_ms": 281350,
      "text": "朱军对于许多普通家庭来说，",
      "token_start": 1494,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 281430,
      "end_ms": 284655,
      "text": "留学可能是父母多年积蓄换来了一次托举。",
      "token_start": 1506,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 285040,
      "end_ms": 286300,
      "text": "你最应该带回来的，",
      "token_start": 1524,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 286300,
      "end_ms": 287145,
      "text": "不是优越感，",
      "token_start": 1532,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 287400,
      "end_ms": 288225,
      "text": "而是责任感。",
      "token_start": 1537,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 288680,
      "end_ms": 290060,
      "text": "不是我和你们不一样，",
      "token_start": 1542,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 290160,
      "end_ms": 292775,
      "text": "而是我能够让不同的人彼此理解。",
      "token_start": 1551,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 293300,
      "end_ms": 295020,
      "text": "留学真正意义不是逃离中国，",
      "token_start": 1565,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 295020,
      "end_ms": 296255,
      "text": "也不是逃离内卷，",
      "token_start": 1577,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 296480,
      "end_ms": 297835,
      "text": "而是重新认识世界，",
      "token_start": 1584,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 298060,
      "end_ms": 299535,
      "text": "也重新认识中国。",
      "token_start": 1592,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 300070,
      "end_ms": 300970,
      "text": "过去一百多年，",
      "token_start": 1599,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 300970,
      "end_ms": 303250,
      "text": "中国留学生把世界带回中国，",
      "token_start": 1605,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 303330,
      "end_ms": 305810,
      "text": "而未来十年轮到新一代留学生，",
      "token_start": 1617,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 305930,
      "end_ms": 309570,
      "text": "把中国带向世界AI.或许可以翻译所有的语言，",
      "token_start": 1630,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 309610,
      "end_ms": 310670,
      "text": "却永远无法替代。",
      "token_start": 1649,
      "token_end_exclusive": 1656
    },
    {
      "start_ms": 310670,
      "end_ms": 313130,
      "text": "一个同时被两个世界信任的人，",
      "token_start": 1656,
      "token_end_exclusive": 1669
    },
    {
      "start_ms": 313330,
      "end_ms": 314350,
      "text": "真正的国际化，",
      "token_start": 1669,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 314390,
      "end_ms": 315490,
      "text": "不是你去过世界，",
      "token_start": 1675,
      "token_end_exclusive": 1682
    },
    {
      "start_ms": 315630,
      "end_ms": 317465,
      "text": "而是世界开始需要你。",
      "token_start": 1682,
      "token_end_exclusive": 1691
    }
  ],
