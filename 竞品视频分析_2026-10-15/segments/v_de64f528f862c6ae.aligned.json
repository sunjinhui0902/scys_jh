{
  "video_id": "v_de64f528f862c6ae",
  "duration_s": 397.502993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_de64f528f862c6ae.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_de64f528f862c6ae.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 770,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 930,
      "end_ms": 2370,
      "text": "咱们盘了第十道，",
      "token_start": 2,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2390,
      "end_ms": 2790,
      "text": "第六，",
      "token_start": 9,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3270,
      "end_ms": 5310,
      "text": "有人说山海关哪，",
      "token_start": 11,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5510,
      "end_ms": 6450,
      "text": "嘉峪关哪，",
      "token_start": 18,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 6630,
      "end_ms": 7650,
      "text": "函谷关哪？",
      "token_start": 22,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7950,
      "end_ms": 8430,
      "text": "别急，",
      "token_start": 26,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 8990,
      "end_ms": 11230,
      "text": "今天这集就是第五道第一，",
      "token_start": 28,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 11590,
      "end_ms": 12850,
      "text": "一个比一个震撼。",
      "token_start": 39,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 13310,
      "end_ms": 15910,
      "text": "最后那个两千三百年来，",
      "token_start": 46,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 15950,
      "end_ms": 19010,
      "text": "谁想从他身上过都得先留下一条命。",
      "token_start": 56,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 19370,
      "end_ms": 19970,
      "text": "老规矩，",
      "token_start": 71,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 20130,
      "end_ms": 20870,
      "text": "开讲之前，",
      "token_start": 74,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21250,
      "end_ms": 23070,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 78,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 23210,
      "end_ms": 25110,
      "text": "让我看看都是谁在听。",
      "token_start": 88,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 25470,
      "end_ms": 26130,
      "text": "第五名，",
      "token_start": 97,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 26510,
      "end_ms": 31690,
      "text": "雁门关在山西忻州代县横山山脉中，",
      "token_start": 100,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 32250,
      "end_ms": 36010,
      "text": "这关最绝的是他打了两千多年的仗。",
      "token_start": 115,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 36130,
      "end_ms": 37150,
      "text": "战国的时候，",
      "token_start": 130,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 37490,
      "end_ms": 40070,
      "text": "李牧守雁门大破匈奴，",
      "token_start": 135,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 40250,
      "end_ms": 41150,
      "text": "十万骑兵。",
      "token_start": 144,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 41810,
      "end_ms": 43010,
      "text": "秦朝的时候，",
      "token_start": 148,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 43190,
      "end_ms": 46290,
      "text": "蒙恬从雁门出塞打匈奴。",
      "token_start": 153,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 46690,
      "end_ms": 47730,
      "text": "汉朝的时候，",
      "token_start": 163,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 47850,
      "end_ms": 51870,
      "text": "卫青、霍去病、李广都从雁门出关。",
      "token_start": 168,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 52190,
      "end_ms": 53110,
      "text": "北宋的时候，",
      "token_start": 181,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 53290,
      "end_ms": 58210,
      "text": "杨家将一门忠烈杨业带着儿子们守雁门，",
      "token_start": 186,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 58570,
      "end_ms": 59350,
      "text": "金沙滩，",
      "token_start": 203,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 59370,
      "end_ms": 62625,
      "text": "一战七个儿子死的死伞的伞，",
      "token_start": 206,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 62890,
      "end_ms": 64825,
      "text": "杨叶绝食殉国，",
      "token_start": 218,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 65290,
      "end_ms": 69925,
      "text": "两千多年雁门关的每一块砖都浸着血，",
      "token_start": 224,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 70740,
      "end_ms": 72860,
      "text": "您说这是官还是颁部？",
      "token_start": 240,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 72880,
      "end_ms": 74885,
      "text": "中国军事史第四名，",
      "token_start": 249,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 75120,
      "end_ms": 79235,
      "text": "嘉峪关在甘肃河西走廊最西端，",
      "token_start": 257,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 79570,
      "end_ms": 80875,
      "text": "明长城的最西端。",
      "token_start": 270,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 81380,
      "end_ms": 84175,
      "text": "这官最绝的是他是中原的西大门，",
      "token_start": 277,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 85000,
      "end_ms": 86615,
      "text": "从嘉峪关往西，",
      "token_start": 291,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 87410,
      "end_ms": 88295,
      "text": "就是西域，",
      "token_start": 297,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 88730,
      "end_ms": 92655,
      "text": "守住嘉峪关就守住了中原的西大门。",
      "token_start": 301,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 93130,
      "end_ms": 95605,
      "text": "他修在河西走廊最窄的地方，",
      "token_start": 316,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 96070,
      "end_ms": 97555,
      "text": "南边是祁连山，",
      "token_start": 328,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 97880,
      "end_ms": 99005,
      "text": "北边是黑山，",
      "token_start": 334,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 99290,
      "end_ms": 100675,
      "text": "中间只有十五公里。",
      "token_start": 339,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 101180,
      "end_ms": 103925,
      "text": "嘉峪关就卡在这十五公里的正中间，",
      "token_start": 347,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 104600,
      "end_ms": 107475,
      "text": "把整条河西走廊掐得死死的。",
      "token_start": 362,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 108030,
      "end_ms": 109375,
      "text": "明朝修嘉峪关，",
      "token_start": 374,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 109730,
      "end_ms": 117620,
      "text": "修了一百六十八年、关城瓮城罗城外城一层套一层城墙上能跑马城楼，",
      "token_start": 380,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 117620,
      "end_ms": 119290,
      "text": "能驻兵关外，",
      "token_start": 409,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 119290,
      "end_ms": 120845,
      "text": "还修了六十里的长城，",
      "token_start": 414,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 121160,
      "end_ms": 122785,
      "text": "跟关城连在一起。",
      "token_start": 423,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 123180,
      "end_ms": 125805,
      "text": "您说这是官还是中原的西大门？",
      "token_start": 430,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 126530,
      "end_ms": 127150,
      "text": "第三名，",
      "token_start": 443,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 127370,
      "end_ms": 131695,
      "text": "潼关在陕西渭南潼关县、黄河，",
      "token_start": 446,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 132170,
      "end_ms": 134705,
      "text": "为何漯河三河交汇处？",
      "token_start": 458,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 135170,
      "end_ms": 136145,
      "text": "南边是秦岭，",
      "token_start": 467,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 136490,
      "end_ms": 137635,
      "text": "北边是黄河，",
      "token_start": 472,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 138070,
      "end_ms": 140095,
      "text": "中间一条路窄到车，",
      "token_start": 477,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 140410,
      "end_ms": 142100,
      "text": "不能并排走马，",
      "token_start": 485,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 142380,
      "end_ms": 143685,
      "text": "不能并排骑。",
      "token_start": 491,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 144240,
      "end_ms": 149315,
      "text": "这关最绝的是他整个防御体系不是一座孤城，",
      "token_start": 496,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 149620,
      "end_ms": 152235,
      "text": "是一座城加十二座连城，",
      "token_start": 515,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 152810,
      "end_ms": 154365,
      "text": "再加一条净钩。",
      "token_start": 525,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 154840,
      "end_ms": 157445,
      "text": "十二、连城沿着秦岭排开，",
      "token_start": 531,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 157880,
      "end_ms": 158895,
      "text": "敌人从哪儿绕，",
      "token_start": 541,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 159200,
      "end_ms": 161350,
      "text": "都能被发现净钩。",
      "token_start": 547,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 161350,
      "end_ms": 163815,
      "text": "在秦岭里划出禁区，",
      "token_start": 554,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 164450,
      "end_ms": 165985,
      "text": "不许任何人穿行，",
      "token_start": 562,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 166440,
      "end_ms": 168835,
      "text": "防止敌人从山里摸过来。",
      "token_start": 569,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 169880,
      "end_ms": 170985,
      "text": "潼观正面，",
      "token_start": 579,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 171240,
      "end_ms": 173315,
      "text": "一夫当关万夫莫开。",
      "token_start": 583,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 174150,
      "end_ms": 176605,
      "text": "两千年里有记载的战争，",
      "token_start": 591,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 176870,
      "end_ms": 177935,
      "text": "打了八十二场，",
      "token_start": 601,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 178260,
      "end_ms": 179565,
      "text": "唐朝安史之乱，",
      "token_start": 607,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 180060,
      "end_ms": 182860,
      "text": "哥舒汉带着二十万大军守潼关，",
      "token_start": 613,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 183400,
      "end_ms": 185320,
      "text": "本来守得住唐玄宗，",
      "token_start": 626,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 185400,
      "end_ms": 186640,
      "text": "逼他出关迎战，",
      "token_start": 634,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 187140,
      "end_ms": 189460,
      "text": "一出关就败了潼关，",
      "token_start": 640,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 189460,
      "end_ms": 191420,
      "text": "一丢长安就保不住了，",
      "token_start": 648,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 191480,
      "end_ms": 194580,
      "text": "您说这是关还是唐王朝的催命符？",
      "token_start": 657,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 195640,
      "end_ms": 196340,
      "text": "第二名，",
      "token_start": 671,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 196360,
      "end_ms": 199740,
      "text": "山海关在河北秦皇岛渤海边上。",
      "token_start": 674,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 199840,
      "end_ms": 203740,
      "text": "这关最绝的是他是万里长城的第一关，",
      "token_start": 687,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 204580,
      "end_ms": 205540,
      "text": "东边是海，",
      "token_start": 703,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 205840,
      "end_ms": 206740,
      "text": "西边是山，",
      "token_start": 707,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 207080,
      "end_ms": 208060,
      "text": "中间一条路，",
      "token_start": 711,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 208380,
      "end_ms": 210370,
      "text": "窄道只能过一辆车，",
      "token_start": 716,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 210610,
      "end_ms": 212510,
      "text": "山海关就卡在这条路上，",
      "token_start": 724,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 212630,
      "end_ms": 213710,
      "text": "北边是燕山，",
      "token_start": 734,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 214090,
      "end_ms": 215510,
      "text": "南边是渤海，",
      "token_start": 739,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 216410,
      "end_ms": 218550,
      "text": "山海之间只有十五公里。",
      "token_start": 744,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 219350,
      "end_ms": 222750,
      "text": "山海关正好堵在这十五公里的正中间，",
      "token_start": 754,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 223490,
      "end_ms": 226690,
      "text": "把东北进中原的路全掐死了。",
      "token_start": 770,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 227050,
      "end_ms": 228610,
      "text": "关成周长四公里，",
      "token_start": 782,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 228990,
      "end_ms": 234230,
      "text": "城墙高十四米后七米城楼九座笛台二十六座。",
      "token_start": 789,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 234690,
      "end_ms": 236270,
      "text": "明朝修了两百多年，",
      "token_start": 808,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 236790,
      "end_ms": 239595,
      "text": "最绝的是老龙头长城的东段，",
      "token_start": 816,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 240290,
      "end_ms": 242210,
      "text": "直接伸进渤海，",
      "token_start": 828,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 242670,
      "end_ms": 244130,
      "text": "城墙泡在海里，",
      "token_start": 834,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 244610,
      "end_ms": 245870,
      "text": "六百多年不塌，",
      "token_start": 840,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 246650,
      "end_ms": 249150,
      "text": "山海关还跟一个典故绑在一起。",
      "token_start": 846,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 249890,
      "end_ms": 252810,
      "text": "吴三桂冲冠一怒为红颜，",
      "token_start": 859,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 252930,
      "end_ms": 253890,
      "text": "打开了山海关，",
      "token_start": 869,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 254250,
      "end_ms": 255270,
      "text": "清军入关，",
      "token_start": 875,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 255610,
      "end_ms": 256630,
      "text": "明朝灭亡。",
      "token_start": 879,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 257090,
      "end_ms": 260410,
      "text": "您说这是关还是决定王朝命运的门？",
      "token_start": 883,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 261430,
      "end_ms": 266570,
      "text": "第一名函谷关在河南三门峡灵宝事，",
      "token_start": 898,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 266830,
      "end_ms": 269925,
      "text": "这关最绝的是他两千三百年来，",
      "token_start": 913,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 270380,
      "end_ms": 272760,
      "text": "一直是中国最硬的关卡。",
      "token_start": 926,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 273720,
      "end_ms": 276880,
      "text": "函谷关在地山和黄河之间，",
      "token_start": 936,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 277140,
      "end_ms": 280000,
      "text": "一条古道宽不过几米，",
      "token_start": 947,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 280300,
      "end_ms": 281320,
      "text": "两边是山，",
      "token_start": 956,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 281980,
      "end_ms": 282920,
      "text": "北边是河，",
      "token_start": 960,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 283440,
      "end_ms": 288020,
      "text": "一夫当关万夫莫开从战国到秦朝，",
      "token_start": 964,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 288320,
      "end_ms": 290160,
      "text": "从汉朝进唐朝，",
      "token_start": 978,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 290560,
      "end_ms": 294000,
      "text": "谁想从东边进关中必须过。",
      "token_start": 984,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 294060,
      "end_ms": 294715,
      "text": "函谷关。",
      "token_start": 995,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 295390,
      "end_ms": 299110,
      "text": "齐国燕国赵国合纵攻秦，",
      "token_start": 998,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 299490,
      "end_ms": 301030,
      "text": "每次打到函谷关，",
      "token_start": 1008,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 301270,
      "end_ms": 304310,
      "text": "都被挡回去秦国人守在关上。",
      "token_start": 1015,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 304690,
      "end_ms": 308030,
      "text": "看着六国大军在关下扎营就是过不来。",
      "token_start": 1027,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 308490,
      "end_ms": 310410,
      "text": "函谷关还出了两个过关，",
      "token_start": 1043,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 310870,
      "end_ms": 314490,
      "text": "紫气东来老子骑青牛过关。",
      "token_start": 1053,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 315370,
      "end_ms": 319210,
      "text": "关令尹玺看到紫气知道有圣人来了，",
      "token_start": 1064,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 319490,
      "end_ms": 323530,
      "text": "老子就在函谷关写下了道德经鸡鸣狗盗。",
      "token_start": 1079,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 324290,
      "end_ms": 327320,
      "text": "孟尝君被秦昭王扣在秦国。",
      "token_start": 1096,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 327920,
      "end_ms": 331880,
      "text": "手下人学鸡叫骗开了函谷关的城门，",
      "token_start": 1107,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 332300,
      "end_ms": 333140,
      "text": "逃了出去，",
      "token_start": 1122,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 333360,
      "end_ms": 335400,
      "text": "一个关出了两个成语，",
      "token_start": 1126,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 335880,
      "end_ms": 337140,
      "text": "一部道德经，",
      "token_start": 1135,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 337560,
      "end_ms": 338940,
      "text": "两千三百年。",
      "token_start": 1140,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 339840,
      "end_ms": 343960,
      "text": "您说从她身上过都得先留下点什么？",
      "token_start": 1145,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 344220,
      "end_ms": 346420,
      "text": "您说这个第一名服不服？",
      "token_start": 1160,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 346600,
      "end_ms": 347920,
      "text": "您听出来了没有？",
      "token_start": 1170,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 348220,
      "end_ms": 353480,
      "text": "这十座关隘没有一座是光靠险出名娘子，",
      "token_start": 1177,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 353480,
      "end_ms": 356730,
      "text": "光靠的是女人立的黑紫荆关，",
      "token_start": 1194,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 356730,
      "end_ms": 358615,
      "text": "靠的是王朝的生死门。",
      "token_start": 1206,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 359240,
      "end_ms": 363085,
      "text": "友谊关靠的是中国人挺直的腰杆。",
      "token_start": 1215,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 363620,
      "end_ms": 366665,
      "text": "居庸关靠的是北京的北大门，",
      "token_start": 1229,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 367550,
      "end_ms": 368370,
      "text": "剑门关，",
      "token_start": 1241,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 368370,
      "end_ms": 370975,
      "text": "靠的是蜀汉最后的骨气。",
      "token_start": 1244,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 371770,
      "end_ms": 374585,
      "text": "雁门关靠的是半部中国军事史，",
      "token_start": 1254,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 375370,
      "end_ms": 378025,
      "text": "嘉峪关靠的是中原的西大门。",
      "token_start": 1267,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 378510,
      "end_ms": 381125,
      "text": "潼关靠的是十二连城的体系。",
      "token_start": 1279,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 381830,
      "end_ms": 385065,
      "text": "山海关靠的是决定王朝命运，",
      "token_start": 1291,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 385510,
      "end_ms": 388450,
      "text": "函谷关靠的是两千三百年的印，",
      "token_start": 1303,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 388690,
      "end_ms": 392535,
      "text": "每一座关隘的厉害之处都不在他有多高，",
      "token_start": 1316,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 392960,
      "end_ms": 394375,
      "text": "在他守住了什么？",
      "token_start": 1333,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 394700,
      "end_ms": 395445,
      "text": "点个关注，",
      "token_start": 1340,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 395860,
      "end_ms": 397385,
      "text": "咱们下期接着聊。",
      "token_start": 1344,
      "token_end_exclusive": 1351
    }
  ],
