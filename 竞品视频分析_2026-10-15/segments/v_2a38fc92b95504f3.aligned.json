{
  "video_id": "v_2a38fc92b95504f3",
  "duration_s": 200.177007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_2a38fc92b95504f3.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_2a38fc92b95504f3.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1070,
      "text": "靳一丹走了，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1370,
      "end_ms": 2490,
      "text": "享年七十一岁。",
      "token_start": 5,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3030,
      "end_ms": 3810,
      "text": "今早醒来，",
      "token_start": 11,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 4030,
      "end_ms": 5550,
      "text": "突然看到这个新闻，",
      "token_start": 15,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5770,
      "end_ms": 7110,
      "text": "我心里咯噔一下，",
      "token_start": 23,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7390,
      "end_ms": 8470,
      "text": "以为是假消息。",
      "token_start": 30,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8850,
      "end_ms": 11710,
      "text": "明明就在三月还参加了他的读者见面会。",
      "token_start": 36,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 12010,
      "end_ms": 13870,
      "text": "他的温柔从容的模样，",
      "token_start": 53,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 14330,
      "end_ms": 15650,
      "text": "仿佛就在我的眼前。",
      "token_start": 62,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 15970,
      "end_ms": 17450,
      "text": "我最记得他的一句话，",
      "token_start": 70,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 17790,
      "end_ms": 19070,
      "text": "感谢这个世界，",
      "token_start": 79,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 19550,
      "end_ms": 22070,
      "text": "让我走过人这一生啊，",
      "token_start": 85,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 22330,
      "end_ms": 23610,
      "text": "真的太短暂了，",
      "token_start": 94,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 23730,
      "end_ms": 24630,
      "text": "说走就走。",
      "token_start": 100,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 25010,
      "end_ms": 30480,
      "text": "他的离开仿佛也带走了六零七零八零后几代人的荧幕角记忆，",
      "token_start": 104,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 30780,
      "end_ms": 32800,
      "text": "熟悉的时代慢慢退场，",
      "token_start": 130,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 33080,
      "end_ms": 35560,
      "text": "我们也开始慢慢变老了。",
      "token_start": 139,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 35760,
      "end_ms": 36460,
      "text": "在这里啊，",
      "token_start": 149,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 36480,
      "end_ms": 39680,
      "text": "我想和屏幕前的你分享几点人生建议。",
      "token_start": 153,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 39840,
      "end_ms": 40280,
      "text": "第一，",
      "token_start": 169,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 40620,
      "end_ms": 41480,
      "text": "生命无常，",
      "token_start": 171,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 41820,
      "end_ms": 43280,
      "text": "人真的会突然离开。",
      "token_start": 175,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 43480,
      "end_ms": 43880,
      "text": "没错，",
      "token_start": 183,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 44200,
      "end_ms": 47280,
      "text": "就是那种随时随地都有可能离开的那种，",
      "token_start": 185,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 47580,
      "end_ms": 50880,
      "text": "然后彻底的消失在人世界你在人间，",
      "token_start": 202,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 50880,
      "end_ms": 53040,
      "text": "所有的一切都不再属于你，",
      "token_start": 217,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 53200,
      "end_ms": 54940,
      "text": "包括你的父母和你的孩子。",
      "token_start": 228,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 55300,
      "end_ms": 57760,
      "text": "所以啊人活着不必患得患失，",
      "token_start": 239,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 58000,
      "end_ms": 59320,
      "text": "也没必要小心翼翼，",
      "token_start": 251,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 59520,
      "end_ms": 61395,
      "text": "更不用害怕失去谁。",
      "token_start": 259,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 61720,
      "end_ms": 62700,
      "text": "人生本过客，",
      "token_start": 267,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 63080,
      "end_ms": 64540,
      "text": "何必谦谦劫。",
      "token_start": 272,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 64800,
      "end_ms": 68610,
      "text": "人活着就应该敞亮点或打点珍惜每一天，",
      "token_start": 277,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 68750,
      "end_ms": 70965,
      "text": "把每一天都当做最后一天。",
      "token_start": 294,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 71400,
      "end_ms": 71760,
      "text": "第二，",
      "token_start": 305,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 71800,
      "end_ms": 72840,
      "text": "千万不要去相信，",
      "token_start": 307,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 72920,
      "end_ms": 74080,
      "text": "年轻时努力工作，",
      "token_start": 314,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 74300,
      "end_ms": 76160,
      "text": "老了再去享受这种鬼话。",
      "token_start": 321,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 76500,
      "end_ms": 78300,
      "text": "人老了身体都废了，",
      "token_start": 331,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 78420,
      "end_ms": 79500,
      "text": "眼睛都花了，",
      "token_start": 339,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 79520,
      "end_ms": 80515,
      "text": "耳朵都聋了，",
      "token_start": 344,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 80830,
      "end_ms": 82130,
      "text": "走路都走不动了，",
      "token_start": 349,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 82210,
      "end_ms": 83730,
      "text": "你还有什么时间去享受？",
      "token_start": 356,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 84130,
      "end_ms": 85810,
      "text": "所以啊千万不要总说着，",
      "token_start": 366,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 85890,
      "end_ms": 86810,
      "text": "等我有钱了，",
      "token_start": 376,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 86890,
      "end_ms": 88275,
      "text": "等我有时间了。",
      "token_start": 381,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 88630,
      "end_ms": 93010,
      "text": "现在当下就是你余生最好最年轻的一天，",
      "token_start": 387,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 93330,
      "end_ms": 94490,
      "text": "千万不要等着等着，",
      "token_start": 404,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 94750,
      "end_ms": 96355,
      "text": "等到最后什么都没了。",
      "token_start": 412,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 96770,
      "end_ms": 97190,
      "text": "第三，",
      "token_start": 421,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 97330,
      "end_ms": 101305,
      "text": "人生最忌讳的一个字就是过自过劳者死。",
      "token_start": 423,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 101730,
      "end_ms": 102830,
      "text": "过会者天收。",
      "token_start": 440,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 103030,
      "end_ms": 104050,
      "text": "黄帝内经中说，",
      "token_start": 445,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 104250,
      "end_ms": 105110,
      "text": "劳逸结合，",
      "token_start": 451,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 105470,
      "end_ms": 107010,
      "text": "身心健过度，",
      "token_start": 455,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 107010,
      "end_ms": 108755,
      "text": "劳累百病生，",
      "token_start": 460,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 109120,
      "end_ms": 110280,
      "text": "过度操劳伤身，",
      "token_start": 465,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 110440,
      "end_ms": 112060,
      "text": "过度操心伤神。",
      "token_start": 471,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 112360,
      "end_ms": 113200,
      "text": "人生有耻，",
      "token_start": 477,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 113460,
      "end_ms": 114260,
      "text": "做人有度，",
      "token_start": 481,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 114620,
      "end_ms": 115580,
      "text": "福气自来，",
      "token_start": 485,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 115880,
      "end_ms": 116440,
      "text": "人生啊。",
      "token_start": 489,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 116440,
      "end_ms": 117805,
      "text": "他本来就没有意义，",
      "token_start": 492,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 118030,
      "end_ms": 119550,
      "text": "你生来就是来体验的，",
      "token_start": 500,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 119550,
      "end_ms": 121155,
      "text": "而并非演绎完美的。",
      "token_start": 509,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 121480,
      "end_ms": 122900,
      "text": "你生下来所有的体验，",
      "token_start": 517,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 123060,
      "end_ms": 125195,
      "text": "就是你生命全部的意义。",
      "token_start": 526,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 125510,
      "end_ms": 125910,
      "text": "第四，",
      "token_start": 536,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 126030,
      "end_ms": 127375,
      "text": "不要为往事过不去，",
      "token_start": 538,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 127660,
      "end_ms": 128885,
      "text": "因为他已经过气，",
      "token_start": 546,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 129260,
      "end_ms": 130755,
      "text": "也不要为现实过不去，",
      "token_start": 553,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 130990,
      "end_ms": 132970,
      "text": "因为你还要过下去。",
      "token_start": 562,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 133350,
      "end_ms": 134470,
      "text": "既然明天和意外，",
      "token_start": 570,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 134490,
      "end_ms": 136410,
      "text": "我们都不知道哪一个会先降临，",
      "token_start": 577,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 136630,
      "end_ms": 138390,
      "text": "那么不妨开开心心，",
      "token_start": 590,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 138570,
      "end_ms": 139450,
      "text": "活在当下，",
      "token_start": 598,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 139690,
      "end_ms": 140530,
      "text": "得之坦然，",
      "token_start": 602,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 140850,
      "end_ms": 141815,
      "text": "失之淡然，",
      "token_start": 606,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 142180,
      "end_ms": 143080,
      "text": "顺其自然。",
      "token_start": 610,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 143380,
      "end_ms": 144580,
      "text": "人生最好的放生，",
      "token_start": 614,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 144760,
      "end_ms": 145960,
      "text": "就是放过自己，",
      "token_start": 621,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 146180,
      "end_ms": 149300,
      "text": "最好的活法就是活在当下享受。",
      "token_start": 627,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 149340,
      "end_ms": 152400,
      "text": "现在保持快乐的秘诀就是无所谓，",
      "token_start": 640,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 152560,
      "end_ms": 154000,
      "text": "没必要不至于。",
      "token_start": 654,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 154220,
      "end_ms": 154840,
      "text": "第五啊，",
      "token_start": 660,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 154880,
      "end_ms": 156725,
      "text": "幸福它从来都不是有，",
      "token_start": 663,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 157070,
      "end_ms": 157690,
      "text": "而是无。",
      "token_start": 672,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 157910,
      "end_ms": 160990,
      "text": "人们常常把幸福定义为有房有车，",
      "token_start": 675,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 161130,
      "end_ms": 161705,
      "text": "有钱，",
      "token_start": 689,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 162030,
      "end_ms": 162430,
      "text": "有权，",
      "token_start": 691,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 162670,
      "end_ms": 163715,
      "text": "有地位等等。",
      "token_start": 693,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 163940,
      "end_ms": 169190,
      "text": "然而真正的幸福其实在于无无忧无虑、无病无灾。",
      "token_start": 698,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 169530,
      "end_ms": 171490,
      "text": "很多人啊活了一辈子都不明白，",
      "token_start": 718,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 171650,
      "end_ms": 173930,
      "text": "其实有是为了给别人看的，",
      "token_start": 731,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 174010,
      "end_ms": 175650,
      "text": "而无才是自己。",
      "token_start": 742,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 175890,
      "end_ms": 178100,
      "text": "真正想要的最后，",
      "token_start": 748,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 178280,
      "end_ms": 181610,
      "text": "让我们一起祝金一班老师一路走好。",
      "token_start": 755,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 182150,
      "end_ms": 185250,
      "text": "感谢他曾经温暖过亿万观众，",
      "token_start": 770,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 185510,
      "end_ms": 187384,
      "text": "也陪伴了一代又一代人，",
      "token_start": 782,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 187760,
      "end_ms": 190045,
      "text": "走过一个又一个春夏秋冬，",
      "token_start": 792,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 190560,
      "end_ms": 194200,
      "text": "也愿屏幕前的你我从此不负时光，",
      "token_start": 803,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 194600,
      "end_ms": 196880,
      "text": "珍惜善待每一天。",
      "token_start": 817,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 197140,
      "end_ms": 197360,
      "text": "你好，",
      "token_start": 824,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 197360,
      "end_ms": 197820,
      "text": "观众朋友，",
      "token_start": 826,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 197820,
      "end_ms": 199690,
      "text": "欢迎您视看你嗯嗯嗯嗯。",
      "token_start": 830,
      "token_end_exclusive": 840
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
