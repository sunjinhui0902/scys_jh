{
  "video_id": "v_40dfda49e2ded977",
  "duration_s": 357.17,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_40dfda49e2ded977.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_40dfda49e2ded977.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 1170,
      "text": "您有没有想过，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1490,
      "end_ms": 4830,
      "text": "咱们中国古代那些如雷贯耳的地名？",
      "token_start": 6,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5410,
      "end_ms": 6750,
      "text": "要是搁到今天，",
      "token_start": 21,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 7130,
      "end_ms": 15650,
      "text": "您还能认出来几个长安洛阳、金陵、广陵、光念这几个名字是不是就觉得有味儿？",
      "token_start": 27,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15950,
      "end_ms": 18530,
      "text": "可我要是告诉您这些名字，",
      "token_start": 59,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 18890,
      "end_ms": 20270,
      "text": "十个里头有九个，",
      "token_start": 70,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 20550,
      "end_ms": 22110,
      "text": "现在都和原来不一样，",
      "token_start": 77,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 22290,
      "end_ms": 23010,
      "text": "您信吗？",
      "token_start": 86,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 23150,
      "end_ms": 24570,
      "text": "有人说长安没改啊，",
      "token_start": 89,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 24990,
      "end_ms": 25950,
      "text": "还叫长安。",
      "token_start": 97,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 26990,
      "end_ms": 28470,
      "text": "有人说洛阳没改啊，",
      "token_start": 101,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 29130,
      "end_ms": 29935,
      "text": "还叫洛阳，",
      "token_start": 109,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 30400,
      "end_ms": 30640,
      "text": "错，",
      "token_start": 113,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 31500,
      "end_ms": 32020,
      "text": "长安，",
      "token_start": 114,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 32020,
      "end_ms": 33100,
      "text": "现在叫西安，",
      "token_start": 116,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 34260,
      "end_ms": 34700,
      "text": "洛阳，",
      "token_start": 121,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 34700,
      "end_ms": 35800,
      "text": "虽然还叫洛阳，",
      "token_start": 123,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 35940,
      "end_ms": 38600,
      "text": "可它早不是那个天下之中的洛阳了，",
      "token_start": 129,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38880,
      "end_ms": 40640,
      "text": "十个最有名的古地名，",
      "token_start": 144,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 41140,
      "end_ms": 44940,
      "text": "到今天只有一个完完整整的留了下来，",
      "token_start": 153,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 45340,
      "end_ms": 46200,
      "text": "名字没改，",
      "token_start": 169,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 46360,
      "end_ms": 47160,
      "text": "地位没详，",
      "token_start": 173,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 47780,
      "end_ms": 50100,
      "text": "位置没挪就一个。",
      "token_start": 177,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 50460,
      "end_ms": 51540,
      "text": "您猜是哪个？",
      "token_start": 184,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 52040,
      "end_ms": 56320,
      "text": "今天咱们就来盘点中国古代十大地名，",
      "token_start": 189,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 56520,
      "end_ms": 58360,
      "text": "看看他们现在都叫什么了。",
      "token_start": 205,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 58840,
      "end_ms": 64840,
      "text": "最后告诉您这个唯一没改名的是谁觉得有意思的朋友先收藏，",
      "token_start": 216,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 65020,
      "end_ms": 66745,
      "text": "免得刷着刷着找不到了。",
      "token_start": 242,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 67020,
      "end_ms": 67535,
      "text": "老规矩，",
      "token_start": 252,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 67750,
      "end_ms": 68415,
      "text": "开奖之前，",
      "token_start": 255,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 68650,
      "end_ms": 70605,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 259,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 70910,
      "end_ms": 73545,
      "text": "让我看看都是谁在听。",
      "token_start": 269,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 74670,
      "end_ms": 75275,
      "text": "第十名，",
      "token_start": 278,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 76220,
      "end_ms": 79255,
      "text": "朝歌改旗限朝歌。",
      "token_start": 281,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 80110,
      "end_ms": 84435,
      "text": "商朝的都城纣王在朝歌，",
      "token_start": 288,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 85130,
      "end_ms": 91535,
      "text": "妲己在朝歌比干在朝歌姬子在朝歌封神演义里的故事，",
      "token_start": 298,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 92540,
      "end_ms": 93725,
      "text": "大半在朝歌，",
      "token_start": 321,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 94630,
      "end_ms": 95955,
      "text": "朝歌这两个字，",
      "token_start": 326,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 96940,
      "end_ms": 99955,
      "text": "念出来就带着一股王朝气。",
      "token_start": 332,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 100830,
      "end_ms": 104275,
      "text": "朝歌是商朝晚期的政治中心，",
      "token_start": 343,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 105120,
      "end_ms": 108005,
      "text": "是当时全世界最大的城市之一。",
      "token_start": 355,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 108620,
      "end_ms": 109275,
      "text": "您想想，",
      "token_start": 368,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 109890,
      "end_ms": 111155,
      "text": "三千多年前，",
      "token_start": 371,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 111500,
      "end_ms": 113355,
      "text": "朝歌成里车水马龙，",
      "token_start": 376,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 114060,
      "end_ms": 115375,
      "text": "宫殿连着宫殿，",
      "token_start": 384,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 115980,
      "end_ms": 117715,
      "text": "可后来朝歌没了，",
      "token_start": 390,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 118270,
      "end_ms": 119465,
      "text": "改成了祁县。",
      "token_start": 397,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 120120,
      "end_ms": 120840,
      "text": "为什么改？",
      "token_start": 402,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 121440,
      "end_ms": 125400,
      "text": "因为境内有一条齐河就叫祁县了，",
      "token_start": 406,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 126060,
      "end_ms": 127480,
      "text": "一个商朝的都城，",
      "token_start": 420,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 128100,
      "end_ms": 129340,
      "text": "现在叫祁县。",
      "token_start": 427,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 130120,
      "end_ms": 134500,
      "text": "您走进去找朝歌找不到了。",
      "token_start": 432,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 134800,
      "end_ms": 137180,
      "text": "您说这是改名还是改？",
      "token_start": 443,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 137180,
      "end_ms": 138800,
      "text": "忘了第九名，",
      "token_start": 452,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 139220,
      "end_ms": 140600,
      "text": "陈仓改宝鸡，",
      "token_start": 457,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 141000,
      "end_ms": 142100,
      "text": "明修栈道，",
      "token_start": 462,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 142320,
      "end_ms": 143360,
      "text": "暗度陈仓。",
      "token_start": 466,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 144380,
      "end_ms": 146640,
      "text": "这句话读过三国的都知道，",
      "token_start": 470,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 147120,
      "end_ms": 152770,
      "text": "陈仓是韩信帮刘邦打天下的时候最关键的一个地方。",
      "token_start": 481,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 153250,
      "end_ms": 157390,
      "text": "韩信表面上修栈道吸引敌人注意，",
      "token_start": 503,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 157889,
      "end_ms": 160610,
      "text": "暗地里从陈仓小道杀出来，",
      "token_start": 517,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 160990,
      "end_ms": 162590,
      "text": "一举拿下关中。",
      "token_start": 528,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 163150,
      "end_ms": 165930,
      "text": "陈仓这个名字用了一千多年，",
      "token_start": 534,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 166370,
      "end_ms": 167310,
      "text": "可到了唐朝，",
      "token_start": 546,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 167690,
      "end_ms": 169110,
      "text": "唐玄宗做了一个梦，",
      "token_start": 551,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 169650,
      "end_ms": 172570,
      "text": "梦见老子显圣给他托梦，",
      "token_start": 559,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 173130,
      "end_ms": 175570,
      "text": "说陈仓这个地方有神机，",
      "token_start": 569,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 176610,
      "end_ms": 178090,
      "text": "唐玄宗醒了以后，",
      "token_start": 579,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 178910,
      "end_ms": 191040,
      "text": "觉得这是天遵义就把陈仓改成了宝鸡、宝鸡、宝鸡一只宝贝鸡从陈从军事重镇变成了吉祥物，",
      "token_start": 586,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 191400,
      "end_ms": 194100,
      "text": "您说这是改名还是改运？",
      "token_start": 624,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 194620,
      "end_ms": 195300,
      "text": "第八名，",
      "token_start": 634,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 195800,
      "end_ms": 201040,
      "text": "长山改石家庄常山赵子龙这句话读过三国的都知道，",
      "token_start": 637,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 201260,
      "end_ms": 206300,
      "text": "赵云一出场就是常山真定人长坂坡七进七出，",
      "token_start": 659,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 206520,
      "end_ms": 213180,
      "text": "怀里抱着阿斗手里一杆亮银枪杀的曹操八十万大军人仰马翻。",
      "token_start": 678,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 214140,
      "end_ms": 217260,
      "text": "长山这两个字就是赵云的招牌。",
      "token_start": 704,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 218140,
      "end_ms": 222400,
      "text": "常山在汉朝的时候是郡管着真定，",
      "token_start": 717,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 222620,
      "end_ms": 224020,
      "text": "就是今天的正定。",
      "token_start": 731,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 224540,
      "end_ms": 226540,
      "text": "可后来长山改了，",
      "token_start": 738,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 226840,
      "end_ms": 228020,
      "text": "改成石家庄。",
      "token_start": 745,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 228360,
      "end_ms": 229460,
      "text": "石家庄赵子龙，",
      "token_start": 750,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 229760,
      "end_ms": 234720,
      "text": "您品品一个在长坂坡杀的七进七出的常胜将军，",
      "token_start": 756,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 234880,
      "end_ms": 237180,
      "text": "报出名号来是石家庄人，",
      "token_start": 776,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 237440,
      "end_ms": 239785,
      "text": "这是怎么听怎么别扭？",
      "token_start": 786,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 240960,
      "end_ms": 241700,
      "text": "第七名，",
      "token_start": 795,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 242740,
      "end_ms": 246420,
      "text": "琅琊改临沂琅琊这两个字不用多解释。",
      "token_start": 798,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 246700,
      "end_ms": 248520,
      "text": "琅琊榜大家都知道，",
      "token_start": 814,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 248880,
      "end_ms": 250540,
      "text": "琅琊是诸葛亮的故乡，",
      "token_start": 822,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 250800,
      "end_ms": 252220,
      "text": "是王羲之的故乡，",
      "token_start": 831,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 252660,
      "end_ms": 256220,
      "text": "琅琊王氏中国历史上最牛的家族之一。",
      "token_start": 838,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 256980,
      "end_ms": 261980,
      "text": "王导王敦、王羲之全是从琅琊出来的，",
      "token_start": 854,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 262260,
      "end_ms": 265440,
      "text": "琅琊念出来就带着名士的风骨。",
      "token_start": 869,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 265980,
      "end_ms": 267900,
      "text": "可后来琅琊改了，",
      "token_start": 882,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 268060,
      "end_ms": 272910,
      "text": "改成琅琊王沂靠近怡和名字。",
      "token_start": 889,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 272910,
      "end_ms": 273310,
      "text": "没错，",
      "token_start": 901,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 273450,
      "end_ms": 275290,
      "text": "可琅琊那个味道没了。",
      "token_start": 903,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 275490,
      "end_ms": 278030,
      "text": "您说这是改地名还是改家风？",
      "token_start": 912,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 278830,
      "end_ms": 279530,
      "text": "第六名，",
      "token_start": 924,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 279930,
      "end_ms": 285150,
      "text": "兰陵改枣庄兰陵这两个字有多美？",
      "token_start": 927,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 286130,
      "end_ms": 288010,
      "text": "兰陵美酒郁金香，",
      "token_start": 941,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 288550,
      "end_ms": 290350,
      "text": "玉碗盛来琥珀光。",
      "token_start": 948,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 290810,
      "end_ms": 295870,
      "text": "李白写的兰陵是兰陵王高长宫的封地兰陵王。",
      "token_start": 955,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 295870,
      "end_ms": 299510,
      "text": "中国古代四大美男之一打仗的时候，",
      "token_start": 974,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 299510,
      "end_ms": 301945,
      "text": "他带着一个狰狞的面具，",
      "token_start": 989,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 302370,
      "end_ms": 303575,
      "text": "因为他长得太好看，",
      "token_start": 999,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 304180,
      "end_ms": 305755,
      "text": "怕敌人不怕他。",
      "token_start": 1007,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 306090,
      "end_ms": 306970,
      "text": "这样一个地方，",
      "token_start": 1013,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 307210,
      "end_ms": 309435,
      "text": "后来改了改成什么呢？",
      "token_start": 1019,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 309660,
      "end_ms": 311140,
      "text": "枣庄枣树的庄，",
      "token_start": 1028,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 311400,
      "end_ms": 312195,
      "text": "一个美男，",
      "token_start": 1034,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 312630,
      "end_ms": 313415,
      "text": "一座美城，",
      "token_start": 1038,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 313810,
      "end_ms": 315575,
      "text": "最后变成了一个种枣的庄子，",
      "token_start": 1042,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 315900,
      "end_ms": 318015,
      "text": "您说这是改名还是改脸？",
      "token_start": 1054,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 318400,
      "end_ms": 319555,
      "text": "从第十到第六，",
      "token_start": 1064,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 320030,
      "end_ms": 321285,
      "text": "朝歌遍其县，",
      "token_start": 1070,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 321590,
      "end_ms": 327935,
      "text": "陈仓变宝鸡、长山变石家庄、琅琊变临沂、兰陵变枣庄。",
      "token_start": 1075,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 328550,
      "end_ms": 330785,
      "text": "可这五个还不是最可惜的。",
      "token_start": 1096,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 331620,
      "end_ms": 333115,
      "text": "接下来第五到第一，",
      "token_start": 1107,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 333470,
      "end_ms": 335005,
      "text": "一个比一个让人心疼，",
      "token_start": 1115,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 335670,
      "end_ms": 336555,
      "text": "有一座城，",
      "token_start": 1124,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 337130,
      "end_ms": 338315,
      "text": "以前叫金陵，",
      "token_start": 1128,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 338860,
      "end_ms": 340105,
      "text": "现在叫南京。",
      "token_start": 1133,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 340910,
      "end_ms": 343305,
      "text": "有一座城以前叫幽州，",
      "token_start": 1138,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 343900,
      "end_ms": 345035,
      "text": "现在叫北京，",
      "token_start": 1147,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 345860,
      "end_ms": 348325,
      "text": "还有一座城以前叫广陵，",
      "token_start": 1152,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 348750,
      "end_ms": 349955,
      "text": "现在叫扬州，",
      "token_start": 1162,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 350300,
      "end_ms": 351000,
      "text": "他是哪座，",
      "token_start": 1167,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 351260,
      "end_ms": 353825,
      "text": "他凭什么排第一下集马上更新。",
      "token_start": 1171,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 354250,
      "end_ms": 355820,
      "text": "您先点个关注点，",
      "token_start": 1184,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 355820,
      "end_ms": 357045,
      "text": "开头像别走丢。",
      "token_start": 1191,
      "token_end_exclusive": 1197
    }
  ],
