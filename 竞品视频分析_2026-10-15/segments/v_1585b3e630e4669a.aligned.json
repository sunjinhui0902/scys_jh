{
  "video_id": "v_1585b3e630e4669a",
  "duration_s": 634.392993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1585b3e630e4669a.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1585b3e630e4669a.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 350,
      "end_ms": 750,
      "text": "朱君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1150,
      "end_ms": 3730,
      "text": "这里是世界上一座没有二手烟的城市，",
      "token_start": 2,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 3890,
      "end_ms": 6010,
      "text": "却也是新夜的泛滥的城市。",
      "token_start": 18,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6370,
      "end_ms": 7690,
      "text": "这里是最好的城市，",
      "token_start": 29,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 7950,
      "end_ms": 9350,
      "text": "却也是最坏的城市。",
      "token_start": 37,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 9830,
      "end_ms": 11690,
      "text": "今天带你来到地球的另一端。",
      "token_start": 45,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 11830,
      "end_ms": 13190,
      "text": "加拿大温哥华，",
      "token_start": 57,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 13450,
      "end_ms": 16650,
      "text": "你看满大街的麻辣烫、奶茶店、足疗馆，",
      "token_start": 63,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 16850,
      "end_ms": 18510,
      "text": "我真的分不清是在温哥华，",
      "token_start": 78,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 18610,
      "end_ms": 21870,
      "text": "还是在温州朱君世界这本大书，",
      "token_start": 89,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 21890,
      "end_ms": 24070,
      "text": "今天终于翻到了温哥华这页，",
      "token_start": 102,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 24410,
      "end_ms": 25150,
      "text": "你相信吗？",
      "token_start": 114,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 25270,
      "end_ms": 28210,
      "text": "你不会英语也能够在温哥华活一辈子，",
      "token_start": 118,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 28450,
      "end_ms": 35020,
      "text": "尤其是在大温解放区列志文超过百分之五十五的人口都是华人买东西的。",
      "token_start": 134,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 35020,
      "end_ms": 37220,
      "text": "中国人卖东西的还是中国人，",
      "token_start": 165,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 37760,
      "end_ms": 38720,
      "text": "要是不看车牌，",
      "token_start": 177,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 38780,
      "end_ms": 40140,
      "text": "这跟国内有什么区别？",
      "token_start": 183,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 40600,
      "end_ms": 41360,
      "text": "感觉在这里，",
      "token_start": 192,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 41360,
      "end_ms": 42840,
      "text": "中国人更像本地人，",
      "token_start": 197,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 42840,
      "end_ms": 44340,
      "text": "外国人才是外国人。",
      "token_start": 205,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 44840,
      "end_ms": 46480,
      "text": "我还遇到了王祖贤姐姐，",
      "token_start": 213,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 46620,
      "end_ms": 48120,
      "text": "她多年前退出娱乐圈，",
      "token_start": 223,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 48120,
      "end_ms": 49560,
      "text": "之后在温哥华定居，",
      "token_start": 232,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 49560,
      "end_ms": 50620,
      "text": "开了一家艾灸馆。",
      "token_start": 240,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 50860,
      "end_ms": 52760,
      "text": "在温哥华寸土寸金的市中心，",
      "token_start": 247,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 52800,
      "end_ms": 55580,
      "text": "还有一个中山公园、苏式园林，",
      "token_start": 259,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 55660,
      "end_ms": 56600,
      "text": "亭台楼阁，",
      "token_start": 271,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 56700,
      "end_ms": 58520,
      "text": "旁边的路就叫苏州巷，",
      "token_start": 275,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 58840,
      "end_ms": 61555,
      "text": "这里的中国超市东西比国内还要全。",
      "token_start": 284,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 61820,
      "end_ms": 63220,
      "text": "在我身后的斯坦林公园，",
      "token_start": 299,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 63220,
      "end_ms": 65365,
      "text": "还有一张纪念张国荣的长椅。",
      "token_start": 309,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 66050,
      "end_ms": 69810,
      "text": "但是励志文最大的华人夜市将在二零二六年九月落幕，",
      "token_start": 321,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 69830,
      "end_ms": 73705,
      "text": "一个时代结束了美人迟暮去国怀乡。",
      "token_start": 344,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 74200,
      "end_ms": 77645,
      "text": "我身后的温哥华是全球最宜居的城市童话之城，",
      "token_start": 359,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 77960,
      "end_ms": 80285,
      "text": "但却又是全球房价最贵的城市。",
      "token_start": 379,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 80630,
      "end_ms": 81650,
      "text": "这里一面天堂，",
      "token_start": 392,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 81730,
      "end_ms": 83600,
      "text": "一面地狱好的方面，",
      "token_start": 398,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 83680,
      "end_ms": 85515,
      "text": "在温哥华你根本遇不到二手烟。",
      "token_start": 406,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 85850,
      "end_ms": 87810,
      "text": "所有公共场所全面禁烟，",
      "token_start": 419,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 87810,
      "end_ms": 89635,
      "text": "也不允许设立室内吸烟室，",
      "token_start": 429,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 90050,
      "end_ms": 92225,
      "text": "但是在这里却可以当街吸叶子。",
      "token_start": 440,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 92820,
      "end_ms": 94460,
      "text": "加拿大是继乌拉圭之后，",
      "token_start": 453,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 94460,
      "end_ms": 96940,
      "text": "全球第二个将叶子合法化的国家，",
      "token_start": 463,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 96960,
      "end_ms": 98745,
      "text": "比隔壁的美利坚还要自由。",
      "token_start": 477,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 99180,
      "end_ms": 100780,
      "text": "这些新叶子的人赶不走，",
      "token_start": 488,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 100800,
      "end_ms": 102195,
      "text": "还得安置保护他们。",
      "token_start": 498,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 102450,
      "end_ms": 103150,
      "text": "他不咬人，",
      "token_start": 506,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 103210,
      "end_ms": 103825,
      "text": "他膈引人。",
      "token_start": 510,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 104310,
      "end_ms": 106890,
      "text": "加拿大是全世界最大的发达国家，",
      "token_start": 514,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 106930,
      "end_ms": 108310,
      "text": "面积比中国还要大，",
      "token_start": 528,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 108410,
      "end_ms": 111285,
      "text": "但是人口竟然只有我国广东省的三分之一。",
      "token_start": 536,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 111800,
      "end_ms": 113120,
      "text": "如此巨大的国家，",
      "token_start": 554,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 113160,
      "end_ms": 115595,
      "text": "百分之九十的领土几乎是无人区，",
      "token_start": 561,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 115840,
      "end_ms": 117605,
      "text": "他全国就是一个大农村。",
      "token_start": 575,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 118040,
      "end_ms": 121085,
      "text": "而加拿大这个词儿本意就是村儿的意思。",
      "token_start": 585,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 121490,
      "end_ms": 125525,
      "text": "你甚至在大街上还能看到上世纪的电线杆子还都是木头做的。",
      "token_start": 602,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 125760,
      "end_ms": 127775,
      "text": "加拿大的矿产资源相当丰富，",
      "token_start": 628,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 128050,
      "end_ms": 129610,
      "text": "石油储量世界前三，",
      "token_start": 640,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 129750,
      "end_ms": 131210,
      "text": "森林资源世界前三，",
      "token_start": 648,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 131390,
      "end_ms": 133375,
      "text": "数不尽的采矿井采油井，",
      "token_start": 656,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 133680,
      "end_ms": 134915,
      "text": "关键人家人口还少，",
      "token_start": 666,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 135270,
      "end_ms": 137310,
      "text": "这些资源平分到每个人头上，",
      "token_start": 674,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 137390,
      "end_ms": 139365,
      "text": "大约合有七百七十万人民币。",
      "token_start": 686,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 139760,
      "end_ms": 142565,
      "text": "加拿大的福利可以说涵盖了从生到死。",
      "token_start": 698,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 143070,
      "end_ms": 147925,
      "text": "温哥华坐落在加拿大的西海岸西兵乔治亚海峡北望海岸山脉，",
      "token_start": 714,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 148260,
      "end_ms": 149240,
      "text": "早上可以滑雪，",
      "token_start": 740,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 149280,
      "end_ms": 150485,
      "text": "下午扬帆出海。",
      "token_start": 746,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 150810,
      "end_ms": 151910,
      "text": "看到这样的自然环境，",
      "token_start": 752,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 151910,
      "end_ms": 152670,
      "text": "你会突然明白，",
      "token_start": 761,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 152670,
      "end_ms": 156225,
      "text": "为什么这里诞生了露露、lemon和某祖鸟这样的运动品牌。",
      "token_start": 767,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 156550,
      "end_ms": 159855,
      "text": "这是一座被雪山、海洋和森林覆盖的城市。",
      "token_start": 789,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 160210,
      "end_ms": 161410,
      "text": "好山好水，",
      "token_start": 806,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 161490,
      "end_ms": 162145,
      "text": "好无聊，",
      "token_start": 810,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 162560,
      "end_ms": 164125,
      "text": "有人直接被这句话劝退，",
      "token_start": 813,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 164420,
      "end_ms": 167855,
      "text": "有人却觉得徒步骑车、露营周末根本不够用。",
      "token_start": 823,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 168260,
      "end_ms": 170270,
      "text": "你看同样一句好山好水，",
      "token_start": 841,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 170270,
      "end_ms": 170750,
      "text": "好无聊，",
      "token_start": 851,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 170970,
      "end_ms": 172170,
      "text": "有人听见牢笼，",
      "token_start": 854,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 172350,
      "end_ms": 173465,
      "text": "有人听见自由，",
      "token_start": 860,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 173800,
      "end_ms": 175375,
      "text": "这就是喜物同音。",
      "token_start": 866,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 175900,
      "end_ms": 176860,
      "text": "有人喜欢辣椒，",
      "token_start": 873,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 176860,
      "end_ms": 177705,
      "text": "是因为辣椒辣，",
      "token_start": 879,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 177960,
      "end_ms": 178980,
      "text": "有人不喜欢辣椒，",
      "token_start": 885,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 178980,
      "end_ms": 180045,
      "text": "也是因为辣椒辣。",
      "token_start": 892,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 180260,
      "end_ms": 181460,
      "text": "而有人喜欢温哥华，",
      "token_start": 899,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 181460,
      "end_ms": 182425,
      "text": "是因为这里安静。",
      "token_start": 907,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 182780,
      "end_ms": 184060,
      "text": "有人不喜欢温德华，",
      "token_start": 914,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 184060,
      "end_ms": 185095,
      "text": "也是因为这里安静。",
      "token_start": 922,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 185520,
      "end_ms": 187900,
      "text": "最近如果你在冬天来到温哥华，",
      "token_start": 930,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 187980,
      "end_ms": 191075,
      "text": "一到下午四点天暗下了就开始怀疑人生。",
      "token_start": 943,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 191500,
      "end_ms": 193645,
      "text": "温哥华的抑率全球非常高，",
      "token_start": 960,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 193930,
      "end_ms": 195150,
      "text": "它被称之为雨都，",
      "token_start": 971,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 195430,
      "end_ms": 197715,
      "text": "每年超过一百六十一天都在下雨。",
      "token_start": 978,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 198180,
      "end_ms": 200180,
      "text": "这里冬季长达五个月的阴雨，",
      "token_start": 992,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 200180,
      "end_ms": 202155,
      "text": "让人不得不长时间憋在家里。",
      "token_start": 1004,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 202450,
      "end_ms": 203930,
      "text": "很多华人之所以来温哥华，",
      "token_start": 1016,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 203990,
      "end_ms": 205315,
      "text": "就是为了孩子的教育，",
      "token_start": 1027,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 205550,
      "end_ms": 206350,
      "text": "不卷孩子，",
      "token_start": 1036,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 206390,
      "end_ms": 207235,
      "text": "他们卷自己。",
      "token_start": 1040,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 207720,
      "end_ms": 210855,
      "text": "我在温哥华看到很多陪读妈妈的生活并不好过，",
      "token_start": 1045,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 211250,
      "end_ms": 213435,
      "text": "用一代人的孤独来托取下一代。",
      "token_start": 1065,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 213650,
      "end_ms": 215155,
      "text": "这些家庭各有兴奋，",
      "token_start": 1078,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 215810,
      "end_ms": 218510,
      "text": "加拿大是全球受教育程度最高的国家之一，",
      "token_start": 1086,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 218530,
      "end_ms": 220835,
      "text": "每三个国民中就两个是大学生。",
      "token_start": 1104,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 221130,
      "end_ms": 222130,
      "text": "但是你能接受吗？",
      "token_start": 1117,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 222190,
      "end_ms": 225275,
      "text": "这里大多数的大学宿舍竟然是男女混住的。",
      "token_start": 1124,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 225860,
      "end_ms": 228060,
      "text": "加拿大拥有二十八位诺贝尔奖得主，",
      "token_start": 1142,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 228140,
      "end_ms": 230760,
      "text": "人工智能、量子、计算、生物医药等等领域，",
      "token_start": 1157,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 230760,
      "end_ms": 235765,
      "text": "全球领先胰岛素、心脏起搏器、对讲机、篮球都是加拿大人发明。",
      "token_start": 1173,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 236390,
      "end_ms": 240610,
      "text": "加拿大还连续多年蝉联全球最受欢迎留学国家榜，",
      "token_start": 1198,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 240610,
      "end_ms": 244715,
      "text": "守百分之九十四的国际学生表示优先选择来加拿大。",
      "token_start": 1219,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 245160,
      "end_ms": 248360,
      "text": "今天我来参观了温哥华当地非常著名的一家私立学校，",
      "token_start": 1241,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 248500,
      "end_ms": 251665,
      "text": "他们接受两岁到十八岁全年龄段的孩子。",
      "token_start": 1264,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 252020,
      "end_ms": 253940,
      "text": "这里孩子呢从小学六年级开始，",
      "token_start": 1281,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 253940,
      "end_ms": 256985,
      "text": "会在全世界三十个国家之间做交换生。",
      "token_start": 1294,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 257290,
      "end_ms": 261000,
      "text": "该校要求所有的学生都要学会掌握中文学校的课程，",
      "token_start": 1310,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 261000,
      "end_ms": 264420,
      "text": "甚至还会教给孩子们遇到熊狼迷路，",
      "token_start": 1332,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 264420,
      "end_ms": 265115,
      "text": "该怎么办？",
      "token_start": 1347,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 265600,
      "end_ms": 266160,
      "text": "怎么背包？",
      "token_start": 1351,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 266160,
      "end_ms": 267160,
      "text": "露营生火，",
      "token_start": 1355,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 267240,
      "end_ms": 267860,
      "text": "看地图，",
      "token_start": 1359,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 267880,
      "end_ms": 268640,
      "text": "野外避险，",
      "token_start": 1362,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 268800,
      "end_ms": 270140,
      "text": "而且做缝纫设计，",
      "token_start": 1366,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 270140,
      "end_ms": 271680,
      "text": "电锯工具AI智能。",
      "token_start": 1373,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 271680,
      "end_ms": 277360,
      "text": "等等我有一个朋友家孩子来了温华读小学四年级之前在国内呢因为成绩很差，",
      "token_start": 1380,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 277460,
      "end_ms": 278175,
      "text": "特别自卑，",
      "token_start": 1413,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 278460,
      "end_ms": 279460,
      "text": "结果来到温哥华，",
      "token_start": 1417,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 279460,
      "end_ms": 280715,
      "text": "天天被老师夸奖，",
      "token_start": 1424,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 280950,
      "end_ms": 281945,
      "text": "你怎么这么优秀，",
      "token_start": 1431,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 282130,
      "end_ms": 283230,
      "text": "他被夸的都不好意思了，",
      "token_start": 1438,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 283230,
      "end_ms": 283935,
      "text": "这还是我吗？",
      "token_start": 1448,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 284610,
      "end_ms": 287645,
      "text": "其实我发现这边老外呢说话经常水分很大。",
      "token_start": 1453,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 288030,
      "end_ms": 289935,
      "text": "如果他说啊你字儿写的good,",
      "token_start": 1471,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 290390,
      "end_ms": 291835,
      "text": "就说明字是写的根本不咋地。",
      "token_start": 1482,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 292290,
      "end_ms": 294050,
      "text": "如果他说啊amazing啊，",
      "token_start": 1494,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 294050,
      "end_ms": 295390,
      "text": "证明你才刚刚达标，",
      "token_start": 1501,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 295970,
      "end_ms": 297290,
      "text": "主打一个情绪价值。",
      "token_start": 1509,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 297850,
      "end_ms": 300289,
      "text": "我看这里的老师也不怎么劝孩子读书，",
      "token_start": 1517,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 300370,
      "end_ms": 301890,
      "text": "都是劝他们快出去玩，",
      "token_start": 1533,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 301890,
      "end_ms": 302950,
      "text": "会学累了吗？",
      "token_start": 1542,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 303050,
      "end_ms": 303910,
      "text": "放松点儿。",
      "token_start": 1547,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 304050,
      "end_ms": 304610,
      "text": "在我看来，",
      "token_start": 1551,
      "token_end_exclusive": 1555
    },
    {
      "start_ms": 304610,
      "end_ms": 306710,
      "text": "你每天下午三点放学有啥好累？",
      "token_start": 1555,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 307050,
      "end_ms": 312370,
      "text": "加拿大实行从幼儿园到大学的免费公共教育以及全民免费医疗制度，",
      "token_start": 1568,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 312530,
      "end_ms": 314770,
      "text": "包括基础、医疗、手术以及住院费用。",
      "token_start": 1597,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 315050,
      "end_ms": 318590,
      "text": "这种高福利的弊端就是催生了一大批的懒人。",
      "token_start": 1611,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 319010,
      "end_ms": 322100,
      "text": "你看这几位环卫工半小时减了三根树枝，",
      "token_start": 1630,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 322300,
      "end_ms": 324960,
      "text": "几片叶子在这棵树下晃来晃去，",
      "token_start": 1647,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 325180,
      "end_ms": 328320,
      "text": "就这半小时工资比别国普通人一天还要多。",
      "token_start": 1660,
      "token_end_exclusive": 1678
    },
    {
      "start_ms": 328460,
      "end_ms": 328800,
      "text": "那一刻，",
      "token_start": 1678,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 328800,
      "end_ms": 330020,
      "text": "我都想过去告诉他们，",
      "token_start": 1681,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 330020,
      "end_ms": 331620,
      "text": "要不这棵树还是交给我吧。",
      "token_start": 1690,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 332020,
      "end_ms": 334140,
      "text": "温哥华没有多伦多的金融枢纽，",
      "token_start": 1701,
      "token_end_exclusive": 1714
    },
    {
      "start_ms": 334140,
      "end_ms": 334540,
      "text": "锋芒，",
      "token_start": 1714,
      "token_end_exclusive": 1716
    },
    {
      "start_ms": 334600,
      "end_ms": 336340,
      "text": "也没有蒙特利尔的法式浪漫。",
      "token_start": 1716,
      "token_end_exclusive": 1728
    },
    {
      "start_ms": 336620,
      "end_ms": 339380,
      "text": "温哥华人最看重的就是家庭和兴趣爱好。",
      "token_start": 1728,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 339500,
      "end_ms": 342500,
      "text": "天天老婆孩子热炕头遛娃遛狗，",
      "token_start": 1745,
      "token_end_exclusive": 1758
    },
    {
      "start_ms": 342660,
      "end_ms": 344060,
      "text": "日子过得十分慵懒，",
      "token_start": 1758,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 344080,
      "end_ms": 344480,
      "text": "安逸，",
      "token_start": 1766,
      "token_end_exclusive": 1768
    },
    {
      "start_ms": 344540,
      "end_ms": 345480,
      "text": "逢节必过，",
      "token_start": 1768,
      "token_end_exclusive": 1772
    },
    {
      "start_ms": 345780,
      "end_ms": 346800,
      "text": "宁可放弃薪水，",
      "token_start": 1772,
      "token_end_exclusive": 1778
    },
    {
      "start_ms": 346800,
      "end_ms": 349500,
      "text": "也要去休假、滑雪、露营和旅行。",
      "token_start": 1778,
      "token_end_exclusive": 1790
    },
    {
      "start_ms": 349780,
      "end_ms": 351600,
      "text": "与他们这种松弛感明显不同的，",
      "token_start": 1790,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 351600,
      "end_ms": 353165,
      "text": "就是当对华人的勤奋。",
      "token_start": 1803,
      "token_end_exclusive": 1812
    },
    {
      "start_ms": 353680,
      "end_ms": 355140,
      "text": "大湾地区有六十多所，",
      "token_start": 1812,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 355140,
      "end_ms": 357505,
      "text": "中文学校有超过七千家餐厅，",
      "token_start": 1821,
      "token_end_exclusive": 1833
    },
    {
      "start_ms": 357780,
      "end_ms": 359715,
      "text": "人均餐馆密度全球第一。",
      "token_start": 1833,
      "token_end_exclusive": 1843
    },
    {
      "start_ms": 360020,
      "end_ms": 362075,
      "text": "而温哥华的市长也都是华人。",
      "token_start": 1843,
      "token_end_exclusive": 1855
    },
    {
      "start_ms": 362570,
      "end_ms": 364210,
      "text": "如果你来到温哥华的唐人街，",
      "token_start": 1855,
      "token_end_exclusive": 1867
    },
    {
      "start_ms": 364250,
      "end_ms": 366685,
      "text": "看到这样一栋薄的像纸片一样的建筑，",
      "token_start": 1867,
      "token_end_exclusive": 1883
    },
    {
      "start_ms": 366960,
      "end_ms": 369315,
      "text": "这个背后就是一段华人的伤心史。",
      "token_start": 1883,
      "token_end_exclusive": 1897
    },
    {
      "start_ms": 369840,
      "end_ms": 370600,
      "text": "一百多年前，",
      "token_start": 1897,
      "token_end_exclusive": 1902
    },
    {
      "start_ms": 370600,
      "end_ms": 374780,
      "text": "有一位叫陈才的广东客家人从洗衣店砸工逆袭，",
      "token_start": 1902,
      "token_end_exclusive": 1922
    },
    {
      "start_ms": 374780,
      "end_ms": 376385,
      "text": "成为温哥华华人首富。",
      "token_start": 1922,
      "token_end_exclusive": 1931
    },
    {
      "start_ms": 376820,
      "end_ms": 379265,
      "text": "但是加拿大人当时特别排挤华人，",
      "token_start": 1931,
      "token_end_exclusive": 1945
    },
    {
      "start_ms": 379560,
      "end_ms": 380000,
      "text": "温哥华，",
      "token_start": 1945,
      "token_end_exclusive": 1948
    },
    {
      "start_ms": 380000,
      "end_ms": 382045,
      "text": "市政府强行征走了他的一块地，",
      "token_start": 1948,
      "token_end_exclusive": 1961
    },
    {
      "start_ms": 382410,
      "end_ms": 385175,
      "text": "只留下了一条六英尺宽的狭长地皮。",
      "token_start": 1961,
      "token_end_exclusive": 1976
    },
    {
      "start_ms": 385800,
      "end_ms": 388085,
      "text": "就在所有人都认为他会认输的时候，",
      "token_start": 1976,
      "token_end_exclusive": 1991
    },
    {
      "start_ms": 388380,
      "end_ms": 392065,
      "text": "成台偏偏在这么小的地上盖了一座全世界最小的建筑。",
      "token_start": 1991,
      "token_end_exclusive": 2014
    },
    {
      "start_ms": 392460,
      "end_ms": 394620,
      "text": "一八八一到一八八四年前后，",
      "token_start": 2014,
      "token_end_exclusive": 2026
    },
    {
      "start_ms": 394720,
      "end_ms": 396620,
      "text": "大约有一点五万多名华工，",
      "token_start": 2026,
      "token_end_exclusive": 2037
    },
    {
      "start_ms": 396620,
      "end_ms": 398625,
      "text": "参与了加拿大的太平洋铁路建设的。",
      "token_start": 2037,
      "token_end_exclusive": 2052
    },
    {
      "start_ms": 398960,
      "end_ms": 399880,
      "text": "如果没有华人，",
      "token_start": 2052,
      "token_end_exclusive": 2058
    },
    {
      "start_ms": 399880,
      "end_ms": 400840,
      "text": "就没有温哥华的。",
      "token_start": 2058,
      "token_end_exclusive": 2065
    },
    {
      "start_ms": 400840,
      "end_ms": 401285,
      "text": "今天。",
      "token_start": 2065,
      "token_end_exclusive": 2067
    },
    {
      "start_ms": 401650,
      "end_ms": 404590,
      "text": "这段历史最刺痛的地方是需要他们的时候，",
      "token_start": 2067,
      "token_end_exclusive": 2085
    },
    {
      "start_ms": 404590,
      "end_ms": 406930,
      "text": "他们是劳工铁路合拢之后，",
      "token_start": 2085,
      "token_end_exclusive": 2096
    },
    {
      "start_ms": 406930,
      "end_ms": 408805,
      "text": "他们却被当成不该留下的人。",
      "token_start": 2096,
      "token_end_exclusive": 2108
    },
    {
      "start_ms": 409170,
      "end_ms": 410010,
      "text": "直到二零一八年，",
      "token_start": 2108,
      "token_end_exclusive": 2115
    },
    {
      "start_ms": 410010,
      "end_ms": 413085,
      "text": "温哥华市才为这段历史性的骑士正式道歉。",
      "token_start": 2115,
      "token_end_exclusive": 2133
    },
    {
      "start_ms": 413600,
      "end_ms": 420245,
      "text": "华人就这样在温哥华地区上一代在夹缝里求生下一代开始建商场、学校、媒体和争取选票。",
      "token_start": 2133,
      "token_end_exclusive": 2170
    },
    {
      "start_ms": 420610,
      "end_ms": 425485,
      "text": "而未来当地华人真正的挑战不是只在春节舞龙舞狮的时候被欢迎，",
      "token_start": 2170,
      "token_end_exclusive": 2198
    },
    {
      "start_ms": 425750,
      "end_ms": 428605,
      "text": "也要能够在当地争取在公共政策里发生，",
      "token_start": 2198,
      "token_end_exclusive": 2215
    },
    {
      "start_ms": 428900,
      "end_ms": 431905,
      "text": "让两百万在加拿大的华人被打破偏见，",
      "token_start": 2215,
      "token_end_exclusive": 2231
    },
    {
      "start_ms": 432150,
      "end_ms": 433145,
      "text": "获得真正的认可。",
      "token_start": 2231,
      "token_end_exclusive": 2238
    },
    {
      "start_ms": 433720,
      "end_ms": 434215,
      "text": "酒精。",
      "token_start": 2238,
      "token_end_exclusive": 2240
    },
    {
      "start_ms": 434530,
      "end_ms": 437685,
      "text": "我越来越觉得我们中国人终于可以平视这个世界了。",
      "token_start": 2240,
      "token_end_exclusive": 2262
    },
    {
      "start_ms": 438020,
      "end_ms": 441035,
      "text": "以前很多人会靠嘲笑国外的基础设施落后，",
      "token_start": 2262,
      "token_end_exclusive": 2280
    },
    {
      "start_ms": 441260,
      "end_ms": 444255,
      "text": "比如塞纳河、像臭水沟等等来制造一些优越感。",
      "token_start": 2280,
      "token_end_exclusive": 2299
    },
    {
      "start_ms": 444540,
      "end_ms": 447635,
      "text": "而也有一些人把国外想象的处处完美的天堂。",
      "token_start": 2299,
      "token_end_exclusive": 2318
    },
    {
      "start_ms": 448080,
      "end_ms": 450695,
      "text": "其实这两种极端都是很自卑的表现。",
      "token_start": 2318,
      "token_end_exclusive": 2333
    },
    {
      "start_ms": 451050,
      "end_ms": 451470,
      "text": "这些年，",
      "token_start": 2333,
      "token_end_exclusive": 2336
    },
    {
      "start_ms": 451470,
      "end_ms": 452750,
      "text": "当我去过的地方越多，",
      "token_start": 2336,
      "token_end_exclusive": 2345
    },
    {
      "start_ms": 452790,
      "end_ms": 453630,
      "text": "见的人越多，",
      "token_start": 2345,
      "token_end_exclusive": 2350
    },
    {
      "start_ms": 453730,
      "end_ms": 454565,
      "text": "越来越明白，",
      "token_start": 2350,
      "token_end_exclusive": 2355
    },
    {
      "start_ms": 454850,
      "end_ms": 457555,
      "text": "我没有资格去评判我见过的任何一个人。",
      "token_start": 2355,
      "token_end_exclusive": 2372
    },
    {
      "start_ms": 457860,
      "end_ms": 459575,
      "text": "因为每个人的生长环境不同，",
      "token_start": 2372,
      "token_end_exclusive": 2384
    },
    {
      "start_ms": 459860,
      "end_ms": 461385,
      "text": "三观自然天差地别，",
      "token_start": 2384,
      "token_end_exclusive": 2392
    },
    {
      "start_ms": 461640,
      "end_ms": 462745,
      "text": "做出的选择也不同。",
      "token_start": 2392,
      "token_end_exclusive": 2400
    },
    {
      "start_ms": 463110,
      "end_ms": 465355,
      "text": "每个人都是他所处的环境的闲话，",
      "token_start": 2400,
      "token_end_exclusive": 2414
    },
    {
      "start_ms": 465790,
      "end_ms": 470065,
      "text": "每一座城市也都是历史制度与生活方式共同塑造的结果。",
      "token_start": 2414,
      "token_end_exclusive": 2438
    },
    {
      "start_ms": 470470,
      "end_ms": 473735,
      "text": "你眼中的成就或许是别人发达过之后的从容。",
      "token_start": 2438,
      "token_end_exclusive": 2457
    },
    {
      "start_ms": 473990,
      "end_ms": 475655,
      "text": "而你羡慕的松弛感背后，",
      "token_start": 2457,
      "token_end_exclusive": 2467
    },
    {
      "start_ms": 475840,
      "end_ms": 477755,
      "text": "也可能是有低效率和高成本。",
      "token_start": 2467,
      "token_end_exclusive": 2479
    },
    {
      "start_ms": 478140,
      "end_ms": 478360,
      "text": "所以，",
      "token_start": 2479,
      "token_end_exclusive": 2481
    },
    {
      "start_ms": 478360,
      "end_ms": 480565,
      "text": "诸君认识世界的最好方式，",
      "token_start": 2481,
      "token_end_exclusive": 2492
    },
    {
      "start_ms": 480830,
      "end_ms": 483085,
      "text": "不是隔着屏幕去赞美或者嘲笑，",
      "token_start": 2492,
      "token_end_exclusive": 2505
    },
    {
      "start_ms": 483310,
      "end_ms": 484930,
      "text": "而是你自己走进去，",
      "token_start": 2505,
      "token_end_exclusive": 2513
    },
    {
      "start_ms": 485050,
      "end_ms": 486695,
      "text": "与世界坦然相望。",
      "token_start": 2513,
      "token_end_exclusive": 2520
    },
    {
      "start_ms": 487080,
      "end_ms": 487780,
      "text": "有些感受，",
      "token_start": 2520,
      "token_end_exclusive": 2524
    },
    {
      "start_ms": 487780,
      "end_ms": 489455,
      "text": "只有你自己才能亲身体会。",
      "token_start": 2524,
      "token_end_exclusive": 2535
    },
    {
      "start_ms": 489690,
      "end_ms": 491705,
      "text": "比如当你在北美去点麦当劳，",
      "token_start": 2535,
      "token_end_exclusive": 2547
    },
    {
      "start_ms": 492050,
      "end_ms": 493270,
      "text": "服务员会问你可乐，",
      "token_start": 2547,
      "token_end_exclusive": 2555
    },
    {
      "start_ms": 493270,
      "end_ms": 494555,
      "text": "你要大杯还是中杯？",
      "token_start": 2555,
      "token_end_exclusive": 2563
    },
    {
      "start_ms": 494900,
      "end_ms": 495300,
      "text": "大杯呢？",
      "token_start": 2563,
      "token_end_exclusive": 2566
    },
    {
      "start_ms": 495300,
      "end_ms": 496135,
      "text": "要贵几块钱，",
      "token_start": 2566,
      "token_end_exclusive": 2571
    },
    {
      "start_ms": 496360,
      "end_ms": 501420,
      "text": "结果发现竟然是无限免费续杯的那这个分中杯大杯有什么意义吗？",
      "token_start": 2571,
      "token_end_exclusive": 2599
    },
    {
      "start_ms": 501560,
      "end_ms": 503220,
      "text": "搞不懂他们是不会算账吗？",
      "token_start": 2599,
      "token_end_exclusive": 2610
    },
    {
      "start_ms": 503220,
      "end_ms": 504685,
      "text": "还是懒得算这笔账了？",
      "token_start": 2610,
      "token_end_exclusive": 2619
    },
    {
      "start_ms": 505120,
      "end_ms": 507985,
      "text": "再比如加拿大和美国是我去过的非常浪费的国家。",
      "token_start": 2619,
      "token_end_exclusive": 2640
    },
    {
      "start_ms": 508310,
      "end_ms": 512035,
      "text": "你从来不会见到什么节约用水、节约用电这样的标语，",
      "token_start": 2640,
      "token_end_exclusive": 2662
    },
    {
      "start_ms": 512400,
      "end_ms": 513760,
      "text": "尤其是食物吃不完，",
      "token_start": 2662,
      "token_end_exclusive": 2670
    },
    {
      "start_ms": 513760,
      "end_ms": 514545,
      "text": "他们直接扔，",
      "token_start": 2670,
      "token_end_exclusive": 2675
    },
    {
      "start_ms": 514790,
      "end_ms": 516565,
      "text": "从来没有剩饭剩菜这一说。",
      "token_start": 2675,
      "token_end_exclusive": 2686
    },
    {
      "start_ms": 517010,
      "end_ms": 518990,
      "text": "因为他们的孩子从小去农场参观，",
      "token_start": 2686,
      "token_end_exclusive": 2700
    },
    {
      "start_ms": 519030,
      "end_ms": 521890,
      "text": "看到的都是高度机械化的一个人操作，",
      "token_start": 2700,
      "token_end_exclusive": 2716
    },
    {
      "start_ms": 521910,
      "end_ms": 523405,
      "text": "机器可以管理一万亩地。",
      "token_start": 2716,
      "token_end_exclusive": 2726
    },
    {
      "start_ms": 523730,
      "end_ms": 526675,
      "text": "所以他们的孩子从来不觉得农民是一个多么辛苦的职业，",
      "token_start": 2726,
      "token_end_exclusive": 2750
    },
    {
      "start_ms": 527180,
      "end_ms": 528540,
      "text": "甚至会觉得浪费，",
      "token_start": 2750,
      "token_end_exclusive": 2757
    },
    {
      "start_ms": 528540,
      "end_ms": 529725,
      "text": "反而能促进消费。",
      "token_start": 2757,
      "token_end_exclusive": 2764
    },
    {
      "start_ms": 530130,
      "end_ms": 530570,
      "text": "再比如，",
      "token_start": 2764,
      "token_end_exclusive": 2767
    },
    {
      "start_ms": 530570,
      "end_ms": 531690,
      "text": "当我刚想进厕所，",
      "token_start": 2767,
      "token_end_exclusive": 2774
    },
    {
      "start_ms": 531690,
      "end_ms": 533175,
      "text": "突然发现出来一女的，",
      "token_start": 2774,
      "token_end_exclusive": 2783
    },
    {
      "start_ms": 533400,
      "end_ms": 534340,
      "text": "你也无需紧张，",
      "token_start": 2783,
      "token_end_exclusive": 2789
    },
    {
      "start_ms": 534420,
      "end_ms": 536380,
      "text": "不是我走错了也不是他走错了。",
      "token_start": 2789,
      "token_end_exclusive": 2802
    },
    {
      "start_ms": 536380,
      "end_ms": 537880,
      "text": "这里是全性别厕所，",
      "token_start": 2802,
      "token_end_exclusive": 2810
    },
    {
      "start_ms": 538000,
      "end_ms": 538775,
      "text": "习惯就好。",
      "token_start": 2810,
      "token_end_exclusive": 2814
    },
    {
      "start_ms": 539250,
      "end_ms": 542155,
      "text": "温哥华的自由就是一种各过各的自由。",
      "token_start": 2814,
      "token_end_exclusive": 2830
    },
    {
      "start_ms": 542660,
      "end_ms": 544520,
      "text": "这里有一九八五年开通的sky,",
      "token_start": 2830,
      "token_end_exclusive": 2842
    },
    {
      "start_ms": 544520,
      "end_ms": 544800,
      "text": " train,",
      "token_start": 2842,
      "token_end_exclusive": 2843
    },
    {
      "start_ms": 544800,
      "end_ms": 548235,
      "text": "是世界上最早的全自动无人驾驶快速交通系统。",
      "token_start": 2843,
      "token_end_exclusive": 2863
    },
    {
      "start_ms": 548590,
      "end_ms": 551745,
      "text": "这里也还有世界上唯一一台还在服役的蒸汽钟，",
      "token_start": 2863,
      "token_end_exclusive": 2883
    },
    {
      "start_ms": 552170,
      "end_ms": 554370,
      "text": "很多人以为他是维多利亚时代的古董，",
      "token_start": 2883,
      "token_end_exclusive": 2899
    },
    {
      "start_ms": 554490,
      "end_ms": 559975,
      "text": "其实他一九七七年才建成加拿大没有经历过什么真正的大规模战争，",
      "token_start": 2899,
      "token_end_exclusive": 2928
    },
    {
      "start_ms": 560240,
      "end_ms": 562160,
      "text": "这个国家底色是四平八稳的，",
      "token_start": 2928,
      "token_end_exclusive": 2940
    },
    {
      "start_ms": 562160,
      "end_ms": 562675,
      "text": "平静。",
      "token_start": 2940,
      "token_end_exclusive": 2942
    },
    {
      "start_ms": 562990,
      "end_ms": 564290,
      "text": "我见过了很多加拿大人，",
      "token_start": 2942,
      "token_end_exclusive": 2952
    },
    {
      "start_ms": 564290,
      "end_ms": 565430,
      "text": "说话轻声细语，",
      "token_start": 2952,
      "token_end_exclusive": 2958
    },
    {
      "start_ms": 565430,
      "end_ms": 566210,
      "text": "穿着朴素，",
      "token_start": 2958,
      "token_end_exclusive": 2962
    },
    {
      "start_ms": 566370,
      "end_ms": 567315,
      "text": "不太显摆，",
      "token_start": 2962,
      "token_end_exclusive": 2966
    },
    {
      "start_ms": 567620,
      "end_ms": 568240,
      "text": "日常相处，",
      "token_start": 2966,
      "token_end_exclusive": 2970
    },
    {
      "start_ms": 568240,
      "end_ms": 569845,
      "text": "有一种平和克制，",
      "token_start": 2970,
      "token_end_exclusive": 2977
    },
    {
      "start_ms": 570070,
      "end_ms": 571485,
      "text": "甚至与世无争的感觉。",
      "token_start": 2977,
      "token_end_exclusive": 2986
    },
    {
      "start_ms": 571990,
      "end_ms": 572950,
      "text": "在一九三九年，",
      "token_start": 2986,
      "token_end_exclusive": 2992
    },
    {
      "start_ms": 572950,
      "end_ms": 575815,
      "text": "德国的客轮圣路易斯号抵达加拿大港口，",
      "token_start": 2992,
      "token_end_exclusive": 3009
    },
    {
      "start_ms": 576190,
      "end_ms": 577890,
      "text": "船上载着九百多名，",
      "token_start": 3009,
      "token_end_exclusive": 3017
    },
    {
      "start_ms": 577890,
      "end_ms": 580615,
      "text": "主要为犹太人的乘客逃离纳粹的迫害，",
      "token_start": 3017,
      "token_end_exclusive": 3033
    },
    {
      "start_ms": 580860,
      "end_ms": 583500,
      "text": "而加拿大人拒绝了这些犹太难民的安全。",
      "token_start": 3033,
      "token_end_exclusive": 3050
    },
    {
      "start_ms": 583500,
      "end_ms": 585435,
      "text": "避护后来到了二零一八年，",
      "token_start": 3050,
      "token_end_exclusive": 3061
    },
    {
      "start_ms": 585700,
      "end_ms": 588955,
      "text": "加纳人全国开始为当时这段历史正式道歉。",
      "token_start": 3061,
      "token_end_exclusive": 3079
    },
    {
      "start_ms": 589320,
      "end_ms": 591515,
      "text": "他们反思自己的祖父辈们的选择，",
      "token_start": 3079,
      "token_end_exclusive": 3093
    },
    {
      "start_ms": 591820,
      "end_ms": 593385,
      "text": "当求救的人来到门口，",
      "token_start": 3093,
      "token_end_exclusive": 3102
    },
    {
      "start_ms": 593640,
      "end_ms": 595870,
      "text": "你们为什么没有伸手周勋，",
      "token_start": 3102,
      "token_end_exclusive": 3113
    },
    {
      "start_ms": 596090,
      "end_ms": 598130,
      "text": "你只有来过加拿大体验一段时间，",
      "token_start": 3113,
      "token_end_exclusive": 3127
    },
    {
      "start_ms": 598130,
      "end_ms": 598910,
      "text": "你才会明白，",
      "token_start": 3127,
      "token_end_exclusive": 3132
    },
    {
      "start_ms": 598910,
      "end_ms": 604535,
      "text": "为什么这片土地会孕育出白求恩这种伟大的人道主义的善良酒精。",
      "token_start": 3132,
      "token_end_exclusive": 3160
    },
    {
      "start_ms": 604740,
      "end_ms": 610300,
      "text": "如果你不小心生活在这样一种资源充足、节奏缓慢、竞争不激烈的环境中，",
      "token_start": 3160,
      "token_end_exclusive": 3190
    },
    {
      "start_ms": 610520,
      "end_ms": 611835,
      "text": "你会变成什么样的人？",
      "token_start": 3190,
      "token_end_exclusive": 3199
    },
    {
      "start_ms": 612350,
      "end_ms": 613295,
      "text": "环境会影响，",
      "token_start": 3199,
      "token_end_exclusive": 3204
    },
    {
      "start_ms": 613650,
      "end_ms": 616245,
      "text": "但不会决定温哥华不是答案，",
      "token_start": 3204,
      "token_end_exclusive": 3216
    },
    {
      "start_ms": 616520,
      "end_ms": 621330,
      "text": "它是一道关于人生排序的选择题、工作和家庭挣钱和生活。",
      "token_start": 3216,
      "token_end_exclusive": 3240
    },
    {
      "start_ms": 621470,
      "end_ms": 623640,
      "text": "你把什么放在前面当自由，",
      "token_start": 3240,
      "token_end_exclusive": 3251
    },
    {
      "start_ms": 623700,
      "end_ms": 625760,
      "text": "也包括那些你不喜欢的人的时候，",
      "token_start": 3251,
      "token_end_exclusive": 3265
    },
    {
      "start_ms": 625900,
      "end_ms": 627175,
      "text": "你还愿不愿意尊重他？",
      "token_start": 3265,
      "token_end_exclusive": 3274
    },
    {
      "start_ms": 627740,
      "end_ms": 630280,
      "text": "旅行利益从来不是给不同的国家去打分，",
      "token_start": 3274,
      "token_end_exclusive": 3291
    },
    {
      "start_ms": 630520,
      "end_ms": 633715,
      "text": "而是让我们重新校准自己看世界的尺度。",
      "token_start": 3291,
      "token_end_exclusive": 3308
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
