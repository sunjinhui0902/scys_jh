{
  "video_id": "v_801c9248f1d13659",
  "duration_s": 542.371995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_801c9248f1d13659.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_801c9248f1d13659.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 710,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 930,
      "end_ms": 1750,
      "text": "咱们盘了。",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1750,
      "end_ms": 3150,
      "text": "第十到第六，",
      "token_start": 6,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3710,
      "end_ms": 5250,
      "text": "雪玉洞是个小姑娘，",
      "token_start": 11,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 5690,
      "end_ms": 8370,
      "text": "石花洞有八层楼、天泉洞，",
      "token_start": 19,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 8430,
      "end_ms": 9910,
      "text": "地上地下都是宝，",
      "token_start": 29,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 10450,
      "end_ms": 13330,
      "text": "龙宫藏着中国最大的洞中瀑布，",
      "token_start": 36,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 13850,
      "end_ms": 16610,
      "text": "双河洞是亚洲第一长洞。",
      "token_start": 49,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 17270,
      "end_ms": 19370,
      "text": "好多朋友看完在评论区吵翻了，",
      "token_start": 59,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 19710,
      "end_ms": 24510,
      "text": "有人说腾龙洞呢芙蓉洞呢织金洞呢别急，",
      "token_start": 72,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 24810,
      "end_ms": 26910,
      "text": "今天这集就是第五道第一，",
      "token_start": 89,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 27350,
      "end_ms": 28530,
      "text": "一个比一个震撼。",
      "token_start": 100,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 29630,
      "end_ms": 33460,
      "text": "最后后那个中国最美旅游洞穴第一名，",
      "token_start": 107,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 33880,
      "end_ms": 34960,
      "text": "溶洞之王。",
      "token_start": 123,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 35240,
      "end_ms": 38140,
      "text": "老规矩开讲之前，",
      "token_start": 127,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 38400,
      "end_ms": 40340,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 134,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 40620,
      "end_ms": 42440,
      "text": "让我看看都是谁在停。",
      "token_start": 144,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 43100,
      "end_ms": 43760,
      "text": "第五名，",
      "token_start": 153,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 44160,
      "end_ms": 52320,
      "text": "辽宁本溪水洞在辽宁本溪四五十万年前形成的石灰岩冲水溶洞，",
      "token_start": 156,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 52900,
      "end_ms": 55120,
      "text": "洞内全长五千八百米，",
      "token_start": 183,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 55260,
      "end_ms": 56740,
      "text": "现开发两千八百米，",
      "token_start": 192,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 57120,
      "end_ms": 62925,
      "text": "二零一八年被认证为世界上最长可供连续乘船游览的地下暗河。",
      "token_start": 200,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 63390,
      "end_ms": 65975,
      "text": "洞内四季恒温十二度，",
      "token_start": 227,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 66510,
      "end_ms": 67575,
      "text": "东吴严寒，",
      "token_start": 236,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67960,
      "end_ms": 69065,
      "text": "夏无酷暑。",
      "token_start": 240,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 69510,
      "end_ms": 72675,
      "text": "您坐着船在地下暗河里走，",
      "token_start": 244,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 73420,
      "end_ms": 76715,
      "text": "两边是各种奇形怪状的钟乳石，",
      "token_start": 255,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 77050,
      "end_ms": 80495,
      "text": "头顶上终乳垂悬形态万千，",
      "token_start": 268,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 80830,
      "end_ms": 84795,
      "text": "有三峡七功九湾的独特景观。",
      "token_start": 279,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 85400,
      "end_ms": 90325,
      "text": "别人看溶洞是走进去看本溪水洞是坐着船飘进去看，",
      "token_start": 291,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 90700,
      "end_ms": 93465,
      "text": "您说这是溶洞还是地下漓江？",
      "token_start": 313,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 94720,
      "end_ms": 95425,
      "text": "第四名，",
      "token_start": 325,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 95740,
      "end_ms": 99825,
      "text": "湖北腾龙洞在湖北恩施利川市，",
      "token_start": 328,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 100680,
      "end_ms": 103475,
      "text": "这洞最绝的是他大的离谱。",
      "token_start": 341,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 104400,
      "end_ms": 106065,
      "text": "洞口高七十四米，",
      "token_start": 352,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 106380,
      "end_ms": 107435,
      "text": "宽六十四米，",
      "token_start": 359,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 108130,
      "end_ms": 111225,
      "text": "直升机能在洞口自由盘旋，",
      "token_start": 364,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 111820,
      "end_ms": 115725,
      "text": "以探明洞穴总长度五十九点八公里，",
      "token_start": 375,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 116670,
      "end_ms": 119095,
      "text": "洞穴总面积两百多万平方米。",
      "token_start": 390,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 119280,
      "end_ms": 120635,
      "text": "洞里有五座山峰，",
      "token_start": 402,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 120960,
      "end_ms": 121665,
      "text": "十个大厅，",
      "token_start": 409,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 122190,
      "end_ms": 126575,
      "text": "地下瀑布十多处容积总量居世界第一，",
      "token_start": 413,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 127000,
      "end_ms": 129075,
      "text": "是中国目前最大的溶洞。",
      "token_start": 429,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 129550,
      "end_ms": 130970,
      "text": "可最震撼的不是洞，",
      "token_start": 439,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 130970,
      "end_ms": 132560,
      "text": "里面是洞，",
      "token_start": 447,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 132660,
      "end_ms": 137090,
      "text": "外面八百里清江流到腾龙洞口的时候，",
      "token_start": 451,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 137190,
      "end_ms": 138905,
      "text": "突然猛跌三十多米，",
      "token_start": 467,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 139280,
      "end_ms": 142015,
      "text": "浩浩荡荡的江水垂直扑下去，",
      "token_start": 475,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 142420,
      "end_ms": 144595,
      "text": "一头扎进黑暗的洞穴里，",
      "token_start": 487,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 145170,
      "end_ms": 146265,
      "text": "消失在洞中。",
      "token_start": 497,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 146620,
      "end_ms": 148575,
      "text": "这个场景叫卧龙吞江，",
      "token_start": 502,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 149300,
      "end_ms": 151985,
      "text": "整条江被一个洞吞进去了，",
      "token_start": 511,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 152400,
      "end_ms": 153595,
      "text": "您说这是溶洞，",
      "token_start": 522,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 153830,
      "end_ms": 154450,
      "text": "还是大帝？",
      "token_start": 528,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 154470,
      "end_ms": 155870,
      "text": "张开了一张嘴讲了？",
      "token_start": 532,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 155870,
      "end_ms": 159355,
      "text": "这几个地方我发现评论区有个事儿特别一致。",
      "token_start": 540,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 159950,
      "end_ms": 163755,
      "text": "好多朋友说年轻时候忙没空去，",
      "token_start": 559,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 164640,
      "end_ms": 165680,
      "text": "现在退休了，",
      "token_start": 572,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 165780,
      "end_ms": 166555,
      "text": "有空了，",
      "token_start": 577,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 166920,
      "end_ms": 168295,
      "text": "可不知道该先去哪儿，",
      "token_start": 580,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 168760,
      "end_ms": 170285,
      "text": "也不知道去了看什么。",
      "token_start": 589,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 170900,
      "end_ms": 173225,
      "text": "还有朋友说腿脚不好了，",
      "token_start": 598,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 173580,
      "end_ms": 175105,
      "text": "有些溶洞爬不动，",
      "token_start": 608,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 175570,
      "end_ms": 177885,
      "text": "有没有不用爬山也能看的？",
      "token_start": 615,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 178270,
      "end_ms": 180010,
      "text": "还有带孙子孙女的，",
      "token_start": 626,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 180130,
      "end_ms": 183395,
      "text": "想给孩子讲讲这些山洞的来历。",
      "token_start": 634,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 184000,
      "end_ms": 185225,
      "text": "可自己也说不全，",
      "token_start": 647,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 186150,
      "end_ms": 187485,
      "text": "咱们这个年纪看景，",
      "token_start": 654,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 187890,
      "end_ms": 189150,
      "text": "不光是看个热闹，",
      "token_start": 662,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 189150,
      "end_ms": 191654,
      "text": "是想知道这山这水有什么讲究，",
      "token_start": 669,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 191970,
      "end_ms": 192785,
      "text": "有什么故事。",
      "token_start": 682,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 193330,
      "end_ms": 196000,
      "text": "可手机上刷完就忘上网，",
      "token_start": 687,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 196000,
      "end_ms": 199035,
      "text": "查一堆乱七八糟的翻大布头，",
      "token_start": 697,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 199300,
      "end_ms": 200445,
      "text": "又看的眼睛疼。",
      "token_start": 709,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 200960,
      "end_ms": 205325,
      "text": "前阵子我翻到一本叫三百六十五日走遍中国的日历书，",
      "token_start": 715,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 205850,
      "end_ms": 207670,
      "text": "左边一页是实景，",
      "token_start": 738,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 207670,
      "end_ms": 209645,
      "text": "大图加一段冷知识，",
      "token_start": 745,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 210090,
      "end_ms": 211935,
      "text": "右边是日期记事夜，",
      "token_start": 753,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 212330,
      "end_ms": 213505,
      "text": "什么季节去哪，",
      "token_start": 761,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 213780,
      "end_ms": 214640,
      "text": "走哪条路，",
      "token_start": 767,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 214740,
      "end_ms": 216395,
      "text": "看什么风景最合适，",
      "token_start": 771,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 216640,
      "end_ms": 217865,
      "text": "都给你安排好了。",
      "token_start": 779,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 218490,
      "end_ms": 219795,
      "text": "今天翻到至金洞，",
      "token_start": 786,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 220130,
      "end_ms": 221535,
      "text": "明天翻到芙蓉洞，",
      "token_start": 793,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 221900,
      "end_ms": 222680,
      "text": "翻到哪页，",
      "token_start": 800,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 222860,
      "end_ms": 225600,
      "text": "就觉得那个地方在喊你能去的地方，",
      "token_start": 804,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 225820,
      "end_ms": 228560,
      "text": "出门前翻一翻到了地方，",
      "token_start": 819,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 228560,
      "end_ms": 229300,
      "text": "心里有底，",
      "token_start": 829,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 229540,
      "end_ms": 230815,
      "text": "看的就不是石头，",
      "token_start": 833,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 231050,
      "end_ms": 233245,
      "text": "是故事去不了的地方。",
      "token_start": 840,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 233460,
      "end_ms": 234720,
      "text": "翻翻书看看图，",
      "token_start": 849,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 235080,
      "end_ms": 236105,
      "text": "也算去过，",
      "token_start": 855,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 237150,
      "end_ms": 239040,
      "text": "放茶几上孙子，",
      "token_start": 859,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 239040,
      "end_ms": 239840,
      "text": "孙女来了，",
      "token_start": 865,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 239860,
      "end_ms": 241470,
      "text": "翻两页长知识，",
      "token_start": 869,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 241470,
      "end_ms": 241895,
      "text": "不说，",
      "token_start": 875,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 242200,
      "end_ms": 243805,
      "text": "写作文都用得上，",
      "token_start": 877,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 244220,
      "end_ms": 245525,
      "text": "老两口晚上翻番，",
      "token_start": 884,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 245790,
      "end_ms": 248675,
      "text": "商量明年去哪比刷手机有意思多了。",
      "token_start": 891,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 248950,
      "end_ms": 250155,
      "text": "我已经放下面了，",
      "token_start": 906,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 250600,
      "end_ms": 251965,
      "text": "点开就能看到，",
      "token_start": 913,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 252220,
      "end_ms": 253305,
      "text": "暂时走不出去，",
      "token_start": 919,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 253750,
      "end_ms": 255755,
      "text": "咱就把祖国装进屋里。",
      "token_start": 925,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 257310,
      "end_ms": 257855,
      "text": "第三名，",
      "token_start": 934,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 258280,
      "end_ms": 262455,
      "text": "重庆芙蓉洞在重庆武隆芙蓉江畔。",
      "token_start": 937,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 262880,
      "end_ms": 270895,
      "text": "这洞最绝的是他是中国唯一一个被列入世界自然遗产名录的天然洞穴，",
      "token_start": 951,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 271980,
      "end_ms": 274565,
      "text": "全长两千三百九十二米，",
      "token_start": 981,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 275120,
      "end_ms": 279105,
      "text": "跟美国的猛犸洞、法国的克拉姆斯杜，",
      "token_start": 991,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 279900,
      "end_ms": 281865,
      "text": "并称世界三大洞穴。",
      "token_start": 1006,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 282850,
      "end_ms": 284950,
      "text": "芙蓉洞里近三十种，",
      "token_start": 1014,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 285070,
      "end_ms": 286825,
      "text": "喀斯特沉积形态，",
      "token_start": 1022,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 287640,
      "end_ms": 291065,
      "text": "石忠儒、石损石柱。",
      "token_start": 1029,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 292580,
      "end_ms": 302555,
      "text": "时代石葡萄珊瑚金花几乎包括了钟乳师所有沉疾类型数量之多、形态之美国内罕见，",
      "token_start": 1036,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 302940,
      "end_ms": 304715,
      "text": "被洞穴专家誉为。",
      "token_start": 1071,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 305030,
      "end_ms": 308170,
      "text": "一座斑斓辉煌的地下艺术宫殿，",
      "token_start": 1078,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 308310,
      "end_ms": 311170,
      "text": "一座内容丰富的洞穴科学博物馆，",
      "token_start": 1091,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 311830,
      "end_ms": 314410,
      "text": "它形成于大约一百二十多万。",
      "token_start": 1105,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 314410,
      "end_ms": 317750,
      "text": "年前一百二十万年漫漫，",
      "token_start": 1117,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 317750,
      "end_ms": 318710,
      "text": "长漫漫，",
      "token_start": 1127,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 318710,
      "end_ms": 322170,
      "text": "长长出了这一栋的千姿百态。",
      "token_start": 1130,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 322890,
      "end_ms": 328570,
      "text": "您说这是洞还是一座用一百二十万年盖起来的地下宫殿。",
      "token_start": 1142,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 329050,
      "end_ms": 329650,
      "text": "第二名，",
      "token_start": 1166,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 330210,
      "end_ms": 333250,
      "text": "广西芦狄岩在广西桂林。",
      "token_start": 1169,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 333810,
      "end_ms": 336860,
      "text": "这洞最绝的的是它被叫做国宾。",
      "token_start": 1179,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 336920,
      "end_ms": 339560,
      "text": "洞洞深两百四十米，",
      "token_start": 1192,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 339820,
      "end_ms": 341060,
      "text": "游长五百米，",
      "token_start": 1200,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 341400,
      "end_ms": 343019,
      "text": "形成于三亿年前，",
      "token_start": 1205,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 343580,
      "end_ms": 349440,
      "text": "洞内分布狮岭、朝霞、水晶宫等三十多处钟乳石景观。",
      "token_start": 1212,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 349640,
      "end_ms": 359420,
      "text": "整个岩洞犹如一座用宝石、珊瑚、翡翠雕砌而成的宏伟壮丽的地下宫殿，",
      "token_start": 1233,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 359660,
      "end_ms": 362060,
      "text": "被誉为大自然艺术之宫。",
      "token_start": 1262,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 362840,
      "end_ms": 364220,
      "text": "卢堤岩开放以来，",
      "token_start": 1272,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 364240,
      "end_ms": 366235,
      "text": "接待过四千多万游客，",
      "token_start": 1279,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 366640,
      "end_ms": 370605,
      "text": "先后接待过三百多位国内外元首和政要。",
      "token_start": 1288,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 371450,
      "end_ms": 377985,
      "text": "邓小平来过尼克松来过卡特来过联合国前秘书长德奎利亚尔也来过。",
      "token_start": 1305,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 379060,
      "end_ms": 380040,
      "text": "一九八六年，",
      "token_start": 1334,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 380060,
      "end_ms": 381945,
      "text": "西游记拍东海龙宫，",
      "token_start": 1339,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 382510,
      "end_ms": 384025,
      "text": "取景帝就是卢迪言。",
      "token_start": 1347,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 384510,
      "end_ms": 388875,
      "text": "您说这是溶洞还是大自然亲手盖的一座国宾馆？",
      "token_start": 1355,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 389080,
      "end_ms": 389495,
      "text": "第一名？",
      "token_start": 1375,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 390090,
      "end_ms": 393785,
      "text": "贵州至金洞在贵州毕节至金县，",
      "token_start": 1378,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 394370,
      "end_ms": 398025,
      "text": "这洞最绝的是他被叫做中国溶洞之王。",
      "token_start": 1391,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 398560,
      "end_ms": 399625,
      "text": "二零零五年，",
      "token_start": 1407,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 399990,
      "end_ms": 406155,
      "text": "中国国家地理杂志评选中国最美旅游洞穴织金洞排第一，",
      "token_start": 1412,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 407150,
      "end_ms": 410485,
      "text": "中国最美的六大旅游洞穴之首，",
      "token_start": 1436,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 410970,
      "end_ms": 412765,
      "text": "中国十大奇洞之首。",
      "token_start": 1449,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 413220,
      "end_ms": 420085,
      "text": "中科院下辖的中国国家地理等国家级地理研究部门也给予高度赞誉，",
      "token_start": 1457,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 420650,
      "end_ms": 423175,
      "text": "称他为中国溶洞之王，",
      "token_start": 1486,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 423730,
      "end_ms": 425730,
      "text": "并留下了黄山归来。",
      "token_start": 1495,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 425950,
      "end_ms": 427270,
      "text": "不看月织，",
      "token_start": 1503,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 427270,
      "end_ms": 429620,
      "text": "今洞外无洞天的感叹。",
      "token_start": 1507,
      "token_end_exclusive": 1516
    },
    {
      "start_ms": 429780,
      "end_ms": 431735,
      "text": "洞长六点六公里，",
      "token_start": 1516,
      "token_end_exclusive": 1523
    },
    {
      "start_ms": 432200,
      "end_ms": 434365,
      "text": "最宽处一百七十五米，",
      "token_start": 1523,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 434830,
      "end_ms": 436385,
      "text": "相对高差一百五十多米，",
      "token_start": 1532,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 437260,
      "end_ms": 439665,
      "text": "全动容积五百万立方米。",
      "token_start": 1542,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 440050,
      "end_ms": 446545,
      "text": "有上中下三层四十七个厅堂一百五十多个景点，",
      "token_start": 1552,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 446980,
      "end_ms": 450005,
      "text": "最大的动听面积三万多平方米，",
      "token_start": 1572,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 450540,
      "end_ms": 453225,
      "text": "洞内有四十多种岩溶堆积物，",
      "token_start": 1585,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 453740,
      "end_ms": 456620,
      "text": "最出名的是那棵银榆树，",
      "token_start": 1597,
      "token_end_exclusive": 1607
    },
    {
      "start_ms": 456960,
      "end_ms": 457855,
      "text": "高十七米，",
      "token_start": 1607,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 458160,
      "end_ms": 459085,
      "text": "通体洁白，",
      "token_start": 1611,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 459480,
      "end_ms": 461375,
      "text": "由结晶方解释构成，",
      "token_start": 1615,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 462000,
      "end_ms": 463315,
      "text": "五十六层年轮，",
      "token_start": 1623,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 463930,
      "end_ms": 467185,
      "text": "记录了第四季冰川期的气候信息，",
      "token_start": 1629,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 467600,
      "end_ms": 469310,
      "text": "被称为地球之花。",
      "token_start": 1643,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 469450,
      "end_ms": 473075,
      "text": "别的钟乳石都是慢慢滴水长成的，",
      "token_start": 1650,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 473550,
      "end_ms": 476345,
      "text": "银雨术是被水滴砸出来的，",
      "token_start": 1664,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 477290,
      "end_ms": 478375,
      "text": "砸了几万年，",
      "token_start": 1675,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 479150,
      "end_ms": 482425,
      "text": "砸出了一身像花椰菜一样的水晶。",
      "token_start": 1680,
      "token_end_exclusive": 1694
    },
    {
      "start_ms": 484290,
      "end_ms": 487880,
      "text": "您说这是石头还是地球开出来的？",
      "token_start": 1694,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 487880,
      "end_ms": 488605,
      "text": "一朵花，",
      "token_start": 1708,
      "token_end_exclusive": 1711
    },
    {
      "start_ms": 489510,
      "end_ms": 491805,
      "text": "这个第一名服不服？",
      "token_start": 1711,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 492720,
      "end_ms": 493945,
      "text": "您听出来了没有？",
      "token_start": 1719,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 494770,
      "end_ms": 496765,
      "text": "这十处洞穴奇观，",
      "token_start": 1726,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 497490,
      "end_ms": 502160,
      "text": "没有一处是光靠好看出名的雪玉洞，",
      "token_start": 1733,
      "token_end_exclusive": 1748
    },
    {
      "start_ms": 502160,
      "end_ms": 504390,
      "text": "靠的是最年轻石花洞，",
      "token_start": 1748,
      "token_end_exclusive": 1757
    },
    {
      "start_ms": 504570,
      "end_ms": 507310,
      "text": "靠的是八层楼天泉洞，",
      "token_start": 1757,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 507470,
      "end_ms": 510155,
      "text": "靠的是空间规模世界第一。",
      "token_start": 1766,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 510940,
      "end_ms": 514340,
      "text": "龙宫靠的是中国最大洞中瀑布，",
      "token_start": 1777,
      "token_end_exclusive": 1790
    },
    {
      "start_ms": 514540,
      "end_ms": 520605,
      "text": "双河洞靠的是亚洲第一长洞本溪水洞靠的是坐着船漂进去。",
      "token_start": 1790,
      "token_end_exclusive": 1815
    },
    {
      "start_ms": 521100,
      "end_ms": 524465,
      "text": "腾龙洞靠的是整条江被吞进去，",
      "token_start": 1815,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 524920,
      "end_ms": 527935,
      "text": "芙蓉洞靠的是唯一世界遗产洞穴。",
      "token_start": 1828,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 528650,
      "end_ms": 530305,
      "text": "卢狄岩靠的是国宾洞，",
      "token_start": 1842,
      "token_end_exclusive": 1851
    },
    {
      "start_ms": 530650,
      "end_ms": 533685,
      "text": "织金洞靠的是中国溶洞之王。",
      "token_start": 1851,
      "token_end_exclusive": 1863
    },
    {
      "start_ms": 534180,
      "end_ms": 537805,
      "text": "每一处洞穴的厉害之处都不在它有多深。",
      "token_start": 1863,
      "token_end_exclusive": 1880
    },
    {
      "start_ms": 538080,
      "end_ms": 540345,
      "text": "在他有多奇点个关注，",
      "token_start": 1880,
      "token_end_exclusive": 1889
    },
    {
      "start_ms": 540890,
      "end_ms": 542255,
      "text": "咱们下期接着聊。",
      "token_start": 1889,
      "token_end_exclusive": 1896
    }
  ],
