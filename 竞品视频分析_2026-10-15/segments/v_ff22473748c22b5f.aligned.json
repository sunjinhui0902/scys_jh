  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 640,
      "end_ms": 1940,
      "text": "这鸭子是好鸭子，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2380,
      "end_ms": 3200,
      "text": "就是嘴硬，",
      "token_start": 7,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3620,
      "end_ms": 3980,
      "text": "嘴硬，",
      "token_start": 11,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3980,
      "end_ms": 4940,
      "text": "才守得住秘密。",
      "token_start": 13,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 7320,
      "end_ms": 8240,
      "text": "鱼是好鱼，",
      "token_start": 19,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 8620,
      "end_ms": 9740,
      "text": "可惜就是刺多。",
      "token_start": 23,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 9880,
      "end_ms": 10140,
      "text": "领导，",
      "token_start": 29,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 10140,
      "end_ms": 11760,
      "text": "您看鱼虽然刺多，",
      "token_start": 31,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 11840,
      "end_ms": 14700,
      "text": "但主心骨只有一根心腹是没有刺的。",
      "token_start": 38,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 17400,
      "end_ms": 18940,
      "text": "小李最近表现不错啊，",
      "token_start": 53,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 19180,
      "end_ms": 21280,
      "text": "我的这个位置马上就该你做了，",
      "token_start": 62,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 21600,
      "end_ms": 22860,
      "text": "我得提前敬你一杯。",
      "token_start": 75,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 23080,
      "end_ms": 23780,
      "text": "听这意思。",
      "token_start": 83,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 24080,
      "end_ms": 25280,
      "text": "领导是要高升了呀，",
      "token_start": 87,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 25440,
      "end_ms": 26740,
      "text": "我得提前敬领导一杯。",
      "token_start": 95,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 29200,
      "end_ms": 29660,
      "text": "小李，",
      "token_start": 104,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 30020,
      "end_ms": 31770,
      "text": "你这菜点的也太多了，",
      "token_start": 106,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 32270,
      "end_ms": 33990,
      "text": "领导菜点的再多，",
      "token_start": 115,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 33990,
      "end_ms": 36530,
      "text": "也比不上平时您对我的照顾多这杯酒，",
      "token_start": 122,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 36530,
      "end_ms": 40270,
      "text": "我先敬您来这么晚，",
      "token_start": 138,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 40690,
      "end_ms": 41990,
      "text": "只能吃剩菜了吧。",
      "token_start": 146,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 42550,
      "end_ms": 44370,
      "text": "领导饭在哪儿我都能吃，",
      "token_start": 153,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 44670,
      "end_ms": 46690,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 163,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 46870,
      "end_ms": 48250,
      "text": "能赶上已经是我的运气了。",
      "token_start": 176,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 48490,
      "end_ms": 49130,
      "text": "说的好，",
      "token_start": 187,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 50250,
      "end_ms": 51350,
      "text": "怎么你这一入职，",
      "token_start": 190,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 51630,
      "end_ms": 52970,
      "text": "我刚种的花就死了，",
      "token_start": 197,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 53930,
      "end_ms": 54930,
      "text": "花开富贵嘛，",
      "token_start": 205,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 54990,
      "end_ms": 56430,
      "text": "花开过了就剩富贵了。",
      "token_start": 210,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 56610,
      "end_ms": 59335,
      "text": "看来领导您啊要发大财了。",
      "token_start": 219,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 60480,
      "end_ms": 61125,
      "text": "小李啊，",
      "token_start": 230,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 61510,
      "end_ms": 62950,
      "text": "你个子是真高比，",
      "token_start": 233,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 62950,
      "end_ms": 64005,
      "text": "我还高一头呢。",
      "token_start": 240,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 64280,
      "end_ms": 65820,
      "text": "个高是为了给领导探路，",
      "token_start": 246,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 66000,
      "end_ms": 67695,
      "text": "走哪儿不还是得听领导指挥吗？",
      "token_start": 256,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 68960,
      "end_ms": 69470,
      "text": "哈哈，",
      "token_start": 269,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 70440,
      "end_ms": 71875,
      "text": "年轻就是好啊，",
      "token_start": 271,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 72240,
      "end_ms": 73535,
      "text": "年轻就是还不够沉稳，",
      "token_start": 277,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 73990,
      "end_ms": 75055,
      "text": "还要向您多学习，",
      "token_start": 286,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 75360,
      "end_ms": 76685,
      "text": "我们才能变得更优秀。",
      "token_start": 293,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 77130,
      "end_ms": 77960,
      "text": "哈哈哈哈，",
      "token_start": 302,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 78470,
      "end_ms": 79255,
      "text": "小李呀，",
      "token_start": 306,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 79740,
      "end_ms": 81895,
      "text": "我看你最近是越来越精神了啊，",
      "token_start": 309,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 82450,
      "end_ms": 83410,
      "text": "那是因为沾了领导，",
      "token_start": 322,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 83410,
      "end_ms": 85110,
      "text": "您的光跟着您干事儿，",
      "token_start": 330,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 85110,
      "end_ms": 86194,
      "text": "气色都不敢差。",
      "token_start": 339,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 86690,
      "end_ms": 88205,
      "text": "哈哈哈哈哈哈哈哈，",
      "token_start": 345,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 88390,
      "end_ms": 89055,
      "text": "小李啊，",
      "token_start": 353,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 89390,
      "end_ms": 90910,
      "text": "你一开口就让人喜欢你，",
      "token_start": 356,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 90970,
      "end_ms": 92025,
      "text": "你是怎么做到的？",
      "token_start": 366,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 92340,
      "end_ms": 94745,
      "text": "因为我一直在看这本把话说的恰到好处，",
      "token_start": 373,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 95090,
      "end_ms": 96670,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 390,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 96770,
      "end_ms": 98335,
      "text": "那些会说话、会来事儿的人。",
      "token_start": 401,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 98540,
      "end_ms": 99600,
      "text": "假如你不爱说话，",
      "token_start": 412,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 99660,
      "end_ms": 100320,
      "text": "不爱争辩，",
      "token_start": 419,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 100440,
      "end_ms": 101440,
      "text": "甚至恐惧社交，",
      "token_start": 423,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 101660,
      "end_ms": 103880,
      "text": "推荐你读完这本把话说的恰到好处，",
      "token_start": 429,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 104100,
      "end_ms": 106015,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 444,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 106300,
      "end_ms": 107120,
      "text": "每天看两页，",
      "token_start": 456,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 107180,
      "end_ms": 108420,
      "text": "每一个场景慢慢练，",
      "token_start": 461,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 108480,
      "end_ms": 111175,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 469,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 111530,
      "end_ms": 112750,
      "text": "在这本书里有一句话，",
      "token_start": 484,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 112750,
      "end_ms": 113715,
      "text": "我特别欣赏，",
      "token_start": 493,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 113980,
      "end_ms": 114120,
      "text": "他，",
      "token_start": 498,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 114120,
      "end_ms": 116435,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 499,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 116720,
      "end_ms": 117300,
      "text": "你可以回，",
      "token_start": 511,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 117520,
      "end_ms": 118600,
      "text": "那是不优秀点，",
      "token_start": 515,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 118820,
      "end_ms": 120205,
      "text": "怎么能和你做朋友呢？",
      "token_start": 521,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 120550,
      "end_ms": 122005,
      "text": "当有人说你真聪明，",
      "token_start": 530,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 122240,
      "end_ms": 123995,
      "text": "你就回近朱者赤，",
      "token_start": 538,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 124250,
      "end_ms": 125170,
      "text": "和你在一起啊，",
      "token_start": 545,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 125190,
      "end_ms": 128225,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 551,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 128470,
      "end_ms": 129510,
      "text": "你就回领导，",
      "token_start": 566,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 129530,
      "end_ms": 130755,
      "text": "这都是我应该做的。",
      "token_start": 571,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 131240,
      "end_ms": 132655,
      "text": "强将手下吴若冰，",
      "token_start": 579,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 132970,
      "end_ms": 134375,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 586,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 134760,
      "end_ms": 136140,
      "text": "当我看到这段的时候，",
      "token_start": 595,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 136220,
      "end_ms": 137925,
      "text": "真是让我欲解心开啊，",
      "token_start": 604,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 138670,
      "end_ms": 140155,
      "text": "每一句都很有意思，",
      "token_start": 613,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 140640,
      "end_ms": 144300,
      "text": "就是手把手教我们在不同场景之下应该怎么说。",
      "token_start": 621,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 144580,
      "end_ms": 147535,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 641,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 147770,
      "end_ms": 149195,
      "text": "你就放心的拿回去看，",
      "token_start": 659,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 149580,
      "end_ms": 151075,
      "text": "就是一句一句的教你，",
      "token_start": 668,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 151330,
      "end_ms": 153370,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 677,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 153670,
      "end_ms": 154995,
      "text": "但凡学会三分，",
      "token_start": 689,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 155320,
      "end_ms": 157985,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 695,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 158310,
      "end_ms": 160415,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 709,
      "token_end_exclusive": 721
    }
  ],
