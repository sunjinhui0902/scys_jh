  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1350,
      "text": "你酒量挺好的呀，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1530,
      "end_ms": 1950,
      "text": "领导，",
      "token_start": 7,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2110,
      "end_ms": 3210,
      "text": "您可抬举我了，",
      "token_start": 9,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3290,
      "end_ms": 4530,
      "text": "我平时真不太能喝，",
      "token_start": 15,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 4810,
      "end_ms": 6350,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 23,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 6350,
      "end_ms": 6910,
      "text": "高兴啊，",
      "token_start": 34,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 7010,
      "end_ms": 8590,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 37,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 10090,
      "end_ms": 10510,
      "text": "小王，",
      "token_start": 47,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 10850,
      "end_ms": 12550,
      "text": "你这菜点的也太多了。",
      "token_start": 49,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12750,
      "end_ms": 14330,
      "text": "领导菜点的再多，",
      "token_start": 58,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 14390,
      "end_ms": 17030,
      "text": "也比不上平时您对我的照顾多这杯酒。",
      "token_start": 65,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 17030,
      "end_ms": 17690,
      "text": "我先敬您。",
      "token_start": 81,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 20150,
      "end_ms": 20790,
      "text": "小王啊，",
      "token_start": 85,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 21430,
      "end_ms": 23190,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 88,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 23790,
      "end_ms": 26010,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 98,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 26010,
      "end_ms": 28170,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 111,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 28170,
      "end_ms": 28410,
      "text": "来，",
      "token_start": 124,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 29630,
      "end_ms": 31900,
      "text": "这杯杯这么晚只能吃剩菜了吧，",
      "token_start": 125,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 32120,
      "end_ms": 33760,
      "text": "领导饭在哪我都能吃，",
      "token_start": 138,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 33900,
      "end_ms": 35780,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 147,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 35780,
      "end_ms": 37200,
      "text": "能赶上已经是我的运气了。",
      "token_start": 160,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 39640,
      "end_ms": 41200,
      "text": "这鸭子是好鸭子，",
      "token_start": 171,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 41440,
      "end_ms": 42340,
      "text": "就是嘴硬，",
      "token_start": 178,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 42820,
      "end_ms": 43240,
      "text": "嘴硬，",
      "token_start": 182,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 43240,
      "end_ms": 44765,
      "text": "才守得住秘密，",
      "token_start": 184,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 47940,
      "end_ms": 49520,
      "text": "咋这么多饭你喂猪呢？",
      "token_start": 190,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 49880,
      "end_ms": 50300,
      "text": "领导，",
      "token_start": 199,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 50300,
      "end_ms": 51020,
      "text": "我哪敢啊，",
      "token_start": 201,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 51180,
      "end_ms": 53100,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 205,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 53180,
      "end_ms": 54520,
      "text": "都说宰相肚里能撑船，",
      "token_start": 221,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 54760,
      "end_ms": 55900,
      "text": "更何况只是一碗饭呢。",
      "token_start": 230,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 57880,
      "end_ms": 59240,
      "text": "小黄最近表现不错，",
      "token_start": 239,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 59580,
      "end_ms": 61545,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 247,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 61750,
      "end_ms": 62795,
      "text": "我得提前敬一杯。",
      "token_start": 260,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 63110,
      "end_ms": 63790,
      "text": "听这意思。",
      "token_start": 267,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 63810,
      "end_ms": 64850,
      "text": "领导烧高升了呀，",
      "token_start": 271,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 64850,
      "end_ms": 65710,
      "text": "我得提前敬领导，",
      "token_start": 278,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 65710,
      "end_ms": 68850,
      "text": "一杯鱼是好鱼，",
      "token_start": 285,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 69210,
      "end_ms": 70450,
      "text": "可惜就是刺多。",
      "token_start": 291,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 70610,
      "end_ms": 70870,
      "text": "领导，",
      "token_start": 297,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 70870,
      "end_ms": 72290,
      "text": "您看鱼虽然刺多，",
      "token_start": 299,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 72430,
      "end_ms": 73590,
      "text": "但主心骨只有一根。",
      "token_start": 306,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 73890,
      "end_ms": 79645,
      "text": "心腹是没有刺的这偶是好藕啊，",
      "token_start": 314,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 80040,
      "end_ms": 81425,
      "text": "就是心眼儿太多了。",
      "token_start": 327,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 81840,
      "end_ms": 83740,
      "text": "领导藕虽然心眼多，",
      "token_start": 335,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 83740,
      "end_ms": 86395,
      "text": "但也是您的下酒菜啊哈哈哈哈哈，",
      "token_start": 343,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 88650,
      "end_ms": 89310,
      "text": "关注我，",
      "token_start": 357,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 89470,
      "end_ms": 90990,
      "text": "每天学点高情商，",
      "token_start": 360,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 90990,
      "end_ms": 91825,
      "text": "说话技巧，",
      "token_start": 367,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 92080,
      "end_ms": 93855,
      "text": "让你的路越走越宽。",
      "token_start": 371,
      "token_end_exclusive": 379
    }
  ],
