  "segments": [
    {
      "start_ms": 150,
      "end_ms": 590,
      "text": "小王，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1070,
      "end_ms": 2190,
      "text": "今天让你破费了，",
      "token_start": 2,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2430,
      "end_ms": 2850,
      "text": "领导，",
      "token_start": 9,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2870,
      "end_ms": 4250,
      "text": "您说这些您能来，",
      "token_start": 11,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4250,
      "end_ms": 5010,
      "text": "就是我的荣幸，",
      "token_start": 18,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5230,
      "end_ms": 7050,
      "text": "以后还有很多地方向您请教，",
      "token_start": 24,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 7050,
      "end_ms": 10810,
      "text": "不是来就来，",
      "token_start": 36,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 10990,
      "end_ms": 12010,
      "text": "带什么礼物啊，",
      "token_start": 41,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 12030,
      "end_ms": 12910,
      "text": "都不是外人。",
      "token_start": 47,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 13030,
      "end_ms": 13450,
      "text": "领导，",
      "token_start": 52,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 13730,
      "end_ms": 14350,
      "text": "您都说了，",
      "token_start": 54,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 14350,
      "end_ms": 15010,
      "text": "不是外人，",
      "token_start": 58,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 15110,
      "end_ms": 16610,
      "text": "我一直都把您当长辈看，",
      "token_start": 62,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 16890,
      "end_ms": 19250,
      "text": "哪有晚辈看长辈空手来的道理呀。",
      "token_start": 72,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 20150,
      "end_ms": 21170,
      "text": "怎么你这一入职，",
      "token_start": 86,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 21230,
      "end_ms": 22590,
      "text": "我刚种的花就死了，",
      "token_start": 93,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 22670,
      "end_ms": 23610,
      "text": "花开富贵嘛，",
      "token_start": 101,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 23670,
      "end_ms": 25230,
      "text": "花开过了就剩富贵了。",
      "token_start": 106,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 25430,
      "end_ms": 29430,
      "text": "看来领导您啊要发大财了不喝，",
      "token_start": 115,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 30080,
      "end_ms": 31120,
      "text": "就是看不起我。",
      "token_start": 128,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 31600,
      "end_ms": 32020,
      "text": "领导，",
      "token_start": 134,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 32100,
      "end_ms": 33160,
      "text": "我不是看不起您，",
      "token_start": 136,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 33280,
      "end_ms": 34240,
      "text": "我是看不起病，",
      "token_start": 143,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 39240,
      "end_ms": 41480,
      "text": "来这么晚只能吃剩菜了吧。",
      "token_start": 149,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 41720,
      "end_ms": 42840,
      "text": "领导饭在哪儿？",
      "token_start": 160,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 42840,
      "end_ms": 43560,
      "text": "我都能吃，",
      "token_start": 166,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 43560,
      "end_ms": 45520,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 170,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 45520,
      "end_ms": 49480,
      "text": "能赶上已经是我的运气吗？",
      "token_start": 183,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 49480,
      "end_ms": 50700,
      "text": "小王啊，",
      "token_start": 194,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 50700,
      "end_ms": 52200,
      "text": "你个子是真高比，",
      "token_start": 197,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 52200,
      "end_ms": 53140,
      "text": "我还高一头呢。",
      "token_start": 204,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 53360,
      "end_ms": 55420,
      "text": "个高是为了给领导探路走，",
      "token_start": 210,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 55420,
      "end_ms": 57040,
      "text": "哪不还是得听领导指挥吗？",
      "token_start": 221,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 58520,
      "end_ms": 59440,
      "text": "小王啊，",
      "token_start": 232,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 59440,
      "end_ms": 60945,
      "text": "你这点点演的也太多了，",
      "token_start": 235,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 61200,
      "end_ms": 62810,
      "text": "领导菜点的再多，",
      "token_start": 245,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 62850,
      "end_ms": 64490,
      "text": "也比不上平时您对我的照顾。",
      "token_start": 252,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 64490,
      "end_ms": 65460,
      "text": "多这杯酒，",
      "token_start": 264,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 65460,
      "end_ms": 67930,
      "text": "我先敬您好，",
      "token_start": 268,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 68560,
      "end_ms": 68875,
      "text": "哎，",
      "token_start": 273,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 69370,
      "end_ms": 70215,
      "text": "你什么意思啊？",
      "token_start": 274,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 70480,
      "end_ms": 71865,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 280,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 72100,
      "end_ms": 72880,
      "text": "领导美满，",
      "token_start": 291,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 72880,
      "end_ms": 73280,
      "text": "美满，",
      "token_start": 295,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 73380,
      "end_ms": 74400,
      "text": "代表幸福美满，",
      "token_start": 297,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 74520,
      "end_ms": 76335,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 303,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 77520,
      "end_ms": 78135,
      "text": "哈哈哈，",
      "token_start": 317,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 78660,
      "end_ms": 80125,
      "text": "年轻就是好啊，",
      "token_start": 320,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 80730,
      "end_ms": 82245,
      "text": "年轻就是还不够沉稳，",
      "token_start": 326,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 82590,
      "end_ms": 83690,
      "text": "还要向您多学习，",
      "token_start": 335,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 83890,
      "end_ms": 85205,
      "text": "我们才能变得更优秀。",
      "token_start": 342,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 85960,
      "end_ms": 86695,
      "text": "哈哈哈哈，",
      "token_start": 351,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 88750,
      "end_ms": 89955,
      "text": "我真不怎么喜欢你，",
      "token_start": 355,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 90480,
      "end_ms": 92440,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 363,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 92440,
      "end_ms": 94545,
      "text": "我领导的格局值得我们学习。",
      "token_start": 376,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 96820,
      "end_ms": 98155,
      "text": "哈哈哈哈哈哈哈，",
      "token_start": 388,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 98690,
      "end_ms": 99325,
      "text": "关注我，",
      "token_start": 395,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 99660,
      "end_ms": 101140,
      "text": "每天学点高情商，",
      "token_start": 398,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 101160,
      "end_ms": 101900,
      "text": "说话技巧，",
      "token_start": 405,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 102200,
      "end_ms": 104035,
      "text": "让你的路越走越宽。",
      "token_start": 409,
      "token_end_exclusive": 417
    }
  ],
