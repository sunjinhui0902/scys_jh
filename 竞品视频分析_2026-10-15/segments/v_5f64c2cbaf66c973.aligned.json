{
  "video_id": "v_5f64c2cbaf66c973",
  "duration_s": 529.901995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_5f64c2cbaf66c973.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_5f64c2cbaf66c973.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 2550,
      "text": "百年杨绛历经风雨，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2790,
      "end_ms": 5110,
      "text": "活成人间最通透的先生。",
      "token_start": 8,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5970,
      "end_ms": 6430,
      "text": "今天，",
      "token_start": 18,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 6510,
      "end_ms": 11730,
      "text": "我们聊一位跨越三个时代活足一百零五岁的女子，",
      "token_start": 20,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 12410,
      "end_ms": 13650,
      "text": "她是文坛译者，",
      "token_start": 41,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 14050,
      "end_ms": 14450,
      "text": "散门，",
      "token_start": 47,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 14450,
      "end_ms": 22020,
      "text": "大家也是无数人心中风骨与温柔并存的杨绛先生。",
      "token_start": 49,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 22860,
      "end_ms": 26000,
      "text": "世人总爱摘抄他通透清醒的句子，",
      "token_start": 70,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 26780,
      "end_ms": 33030,
      "text": "却很少完整读懂那些治愈无数人的人生智慧。",
      "token_start": 84,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 33470,
      "end_ms": 37870,
      "text": "全是他百年岁月一步一步熬出来的答案。",
      "token_start": 103,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 38470,
      "end_ms": 39970,
      "text": "一九一一年盛夏，",
      "token_start": 120,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 40370,
      "end_ms": 42130,
      "text": "杨绛生于北京，",
      "token_start": 127,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 42190,
      "end_ms": 43090,
      "text": "书香世家，",
      "token_start": 133,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 43130,
      "end_ms": 44650,
      "text": "本名杨继康，",
      "token_start": 137,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 45610,
      "end_ms": 46730,
      "text": "父亲杨殷航，",
      "token_start": 142,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 47030,
      "end_ms": 49190,
      "text": "是民国知名法学家。",
      "token_start": 147,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 49750,
      "end_ms": 50810,
      "text": "思想开明，",
      "token_start": 155,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 51210,
      "end_ms": 53210,
      "text": "从不约束女儿的喜好，",
      "token_start": 159,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 53590,
      "end_ms": 55650,
      "text": "只告诉他喜欢什么，",
      "token_start": 168,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 55730,
      "end_ms": 57090,
      "text": "便去钻研什么。",
      "token_start": 176,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 58170,
      "end_ms": 60445,
      "text": "这份自由宽松的成长环境，",
      "token_start": 182,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 60640,
      "end_ms": 60850,
      "text": "嗯，",
      "token_start": 193,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 61100,
      "end_ms": 64575,
      "text": "早早在他心底种下独立淡然的底色，",
      "token_start": 194,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 65510,
      "end_ms": 66510,
      "text": "年少求学，",
      "token_start": 209,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 66550,
      "end_ms": 68485,
      "text": "辗转苏州上海。",
      "token_start": 213,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 69230,
      "end_ms": 71575,
      "text": "他读书从不死记硬背。",
      "token_start": 219,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 71970,
      "end_ms": 73250,
      "text": "政华女中时期，",
      "token_start": 228,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 73250,
      "end_ms": 75825,
      "text": "跳级提前毕业十七岁，",
      "token_start": 234,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 76110,
      "end_ms": 82495,
      "text": "同时考上东吴大学金陵女大只因当年清华不招收女生，",
      "token_start": 243,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 82910,
      "end_ms": 86030,
      "text": "才战时搁置心中学府梦。",
      "token_start": 266,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 86170,
      "end_ms": 87305,
      "text": "二十一岁那年，",
      "token_start": 276,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 87750,
      "end_ms": 89900,
      "text": "命运安排了一场一眼。",
      "token_start": 282,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 89940,
      "end_ms": 91455,
      "text": "定终身的相遇，",
      "token_start": 291,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 92360,
      "end_ms": 94675,
      "text": "杨绛借读燕京大学，",
      "token_start": 297,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 95070,
      "end_ms": 97545,
      "text": "顺路去往清华古乐堂，",
      "token_start": 305,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 97850,
      "end_ms": 99105,
      "text": "初见钱钟书。",
      "token_start": 314,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 100040,
      "end_ms": 102110,
      "text": "彼时旁人传话说，",
      "token_start": 319,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 102110,
      "end_ms": 103970,
      "text": "二人各有婚约见面。",
      "token_start": 326,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 103970,
      "end_ms": 104465,
      "text": "第一句，",
      "token_start": 334,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 105250,
      "end_ms": 106615,
      "text": "钱钟书直白开口，",
      "token_start": 337,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 107490,
      "end_ms": 108925,
      "text": "我并未订婚。",
      "token_start": 344,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 109530,
      "end_ms": 112815,
      "text": "杨绛也坦然回应自己没有男友，",
      "token_start": 349,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 113080,
      "end_ms": 114060,
      "text": "简单两句话，",
      "token_start": 362,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 114340,
      "end_ms": 117625,
      "text": "拉开了两人长达六十余年相守的序幕，",
      "token_start": 367,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 118030,
      "end_ms": 118545,
      "text": "相恋，",
      "token_start": 383,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 120210,
      "end_ms": 121570,
      "text": "订婚成婚。",
      "token_start": 385,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 122210,
      "end_ms": 123230,
      "text": "一九三五年，",
      "token_start": 389,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 123270,
      "end_ms": 125990,
      "text": "夫妻二人远赴牛津留学，",
      "token_start": 394,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 126250,
      "end_ms": 128090,
      "text": "钱钟书一身书卷气，",
      "token_start": 404,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 128370,
      "end_ms": 130170,
      "text": "却不通生活琐事，",
      "token_start": 412,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 130710,
      "end_ms": 131550,
      "text": "打翻墨水，",
      "token_start": 419,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 132330,
      "end_ms": 133350,
      "text": "弄坏器物，",
      "token_start": 423,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 133350,
      "end_ms": 135330,
      "text": "是尝试反绛，",
      "token_start": 427,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 135350,
      "end_ms": 136810,
      "text": "从无半句埋怨，",
      "token_start": 432,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 137430,
      "end_ms": 139090,
      "text": "反倒放下学业之余，",
      "token_start": 438,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 139270,
      "end_ms": 140710,
      "text": "学着操持三餐。",
      "token_start": 446,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 141310,
      "end_ms": 143210,
      "text": "为做出合口味的中餐，",
      "token_start": 452,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 143570,
      "end_ms": 144770,
      "text": "为反复摸索，",
      "token_start": 461,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 144870,
      "end_ms": 145850,
      "text": "文火炖肉，",
      "token_start": 466,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 146210,
      "end_ms": 147410,
      "text": "笨拙却认真。",
      "token_start": 470,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 148310,
      "end_ms": 149715,
      "text": "女儿钱科出生后，",
      "token_start": 475,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 150020,
      "end_ms": 151860,
      "text": "一家三口在一国相守，",
      "token_start": 482,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 152260,
      "end_ms": 153960,
      "text": "平淡琐碎的日常，",
      "token_start": 491,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 154360,
      "end_ms": 157140,
      "text": "成了往后半生最珍贵的念想。",
      "token_start": 498,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 157700,
      "end_ms": 158380,
      "text": "归国后，",
      "token_start": 510,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 158580,
      "end_ms": 159580,
      "text": "战火连绵，",
      "token_start": 513,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 160140,
      "end_ms": 162340,
      "text": "上海沦陷时期杨绛，",
      "token_start": 517,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 162520,
      "end_ms": 164140,
      "text": "扛起养家重担，",
      "token_start": 525,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 164540,
      "end_ms": 167240,
      "text": "提笔创作话剧称心如意，",
      "token_start": 531,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 167260,
      "end_ms": 168200,
      "text": "弄真成假，",
      "token_start": 541,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 168240,
      "end_ms": 169400,
      "text": "接连登上舞台，",
      "token_start": 545,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 169980,
      "end_ms": 172260,
      "text": "杨绛这个笔名自此流传。",
      "token_start": 551,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 172740,
      "end_ms": 173280,
      "text": "白天，",
      "token_start": 561,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 173300,
      "end_ms": 174540,
      "text": "他执教教书，",
      "token_start": 563,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 174980,
      "end_ms": 177480,
      "text": "夜晚伏案写剧本补贴家用。",
      "token_start": 568,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 177960,
      "end_ms": 178800,
      "text": "乱世之中，",
      "token_start": 579,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 179080,
      "end_ms": 181745,
      "text": "一支笔撑起一家三口安稳。",
      "token_start": 583,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 182310,
      "end_ms": 184625,
      "text": "后来前谁书动笔写围城，",
      "token_start": 594,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 185070,
      "end_ms": 188170,
      "text": "杨绛主动包揽全部家务刊，",
      "token_start": 604,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 188170,
      "end_ms": 188875,
      "text": "写书稿，",
      "token_start": 615,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 189270,
      "end_ms": 190305,
      "text": "斟酌字据，",
      "token_start": 618,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 190640,
      "end_ms": 192885,
      "text": "甘愿做他身后安静的支撑。",
      "token_start": 622,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 193380,
      "end_ms": 194425,
      "text": "围城问世，",
      "token_start": 633,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 194810,
      "end_ms": 195875,
      "text": "轰动文坛。",
      "token_start": 637,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 196470,
      "end_ms": 197845,
      "text": "可很少有人知道，",
      "token_start": 641,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 198680,
      "end_ms": 200225,
      "text": "这部传世之作，",
      "token_start": 648,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 200710,
      "end_ms": 203550,
      "text": "藏着杨绛无数默默付出的时光。",
      "token_start": 654,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 203750,
      "end_ms": 204935,
      "text": "事业刚有起色，",
      "token_start": 667,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 205260,
      "end_ms": 206955,
      "text": "人生磨难接踵而至。",
      "token_start": 673,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 207780,
      "end_ms": 208785,
      "text": "五十多岁那年，",
      "token_start": 681,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 209130,
      "end_ms": 210515,
      "text": "时代动荡袭来，",
      "token_start": 687,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 210940,
      "end_ms": 213195,
      "text": "杨绛被安排打扫公共厕所，",
      "token_start": 693,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 213510,
      "end_ms": 216115,
      "text": "还被剃去半边头发当众受辱，",
      "token_start": 704,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 216600,
      "end_ms": 218945,
      "text": "旁人都以为他会崩溃落泪。",
      "token_start": 716,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 219330,
      "end_ms": 220610,
      "text": "可他回家取剪刀，",
      "token_start": 727,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 220850,
      "end_ms": 221730,
      "text": "干脆剃光，",
      "token_start": 734,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 221790,
      "end_ms": 222665,
      "text": "剩于长发，",
      "token_start": 738,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 223100,
      "end_ms": 223580,
      "text": "坦然。",
      "token_start": 742,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 223600,
      "end_ms": 227405,
      "text": "面对周遭眼光下放武器干校的日子，",
      "token_start": 744,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 228350,
      "end_ms": 229945,
      "text": "寒冬住在漏风茅屋，",
      "token_start": 759,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 230390,
      "end_ms": 231995,
      "text": "双手冻满裂口。",
      "token_start": 767,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 232360,
      "end_ms": 233500,
      "text": "他一边干粗活，",
      "token_start": 773,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 233970,
      "end_ms": 235565,
      "text": "一边悄悄揣着字典，",
      "token_start": 779,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 235920,
      "end_ms": 238215,
      "text": "抓住零碎时间研读文字。",
      "token_start": 787,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 239080,
      "end_ms": 239645,
      "text": "彼时，",
      "token_start": 797,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 239930,
      "end_ms": 241650,
      "text": "他正在翻译堂吉诃德，",
      "token_start": 799,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 241710,
      "end_ms": 243090,
      "text": "为忠于原著。",
      "token_start": 808,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 243690,
      "end_ms": 247230,
      "text": "四十七岁的他从零自学西班牙语，",
      "token_start": 813,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 247470,
      "end_ms": 248710,
      "text": "耗费数年，",
      "token_start": 827,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 248830,
      "end_ms": 250210,
      "text": "一完大半稿件，",
      "token_start": 831,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 250730,
      "end_ms": 252730,
      "text": "却在动乱中全部遗世。",
      "token_start": 837,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 253290,
      "end_ms": 254810,
      "text": "他没有就此放弃，",
      "token_start": 846,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 255390,
      "end_ms": 257930,
      "text": "多年后取回残破手稿。",
      "token_start": 853,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 258470,
      "end_ms": 260190,
      "text": "他狭小简陋的办公室里，",
      "token_start": 862,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 260190,
      "end_ms": 261110,
      "text": "从头重艺，",
      "token_start": 872,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 261890,
      "end_ms": 264730,
      "text": "前后历时近二十年前，",
      "token_start": 876,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 264750,
      "end_ms": 267390,
      "text": "本终于在一九七八年面世。",
      "token_start": 885,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 268350,
      "end_ms": 270660,
      "text": "这份译文精过准、温润，",
      "token_start": 896,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 271040,
      "end_ms": 272920,
      "text": "兼具中西文字美感，",
      "token_start": 905,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 273340,
      "end_ms": 276820,
      "text": "至今仍是国内公认最优版本。",
      "token_start": 913,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 277460,
      "end_ms": 280160,
      "text": "西班牙国王特意为他颁发十字勋章，",
      "token_start": 925,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 280540,
      "end_ms": 283880,
      "text": "称赞他搭建起两国文学沟通的桥梁。",
      "token_start": 940,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 284020,
      "end_ms": 286440,
      "text": "熬过漫长苦难安稳，",
      "token_start": 955,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 286560,
      "end_ms": 288540,
      "text": "日子却格外短暂。",
      "token_start": 963,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 289080,
      "end_ms": 291600,
      "text": "晚年接连两场生离，",
      "token_start": 970,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 292120,
      "end_ms": 294440,
      "text": "先送走相伴半生的女儿。",
      "token_start": 978,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 294440,
      "end_ms": 296260,
      "text": "钱巩没过一年，",
      "token_start": 988,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 296660,
      "end_ms": 300270,
      "text": "相守六十余载的钱钟书也撒手离去，",
      "token_start": 994,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 300790,
      "end_ms": 302450,
      "text": "至亲尽数离开，",
      "token_start": 1009,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 303070,
      "end_ms": 303990,
      "text": "偌大屋子，",
      "token_start": 1015,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 304170,
      "end_ms": 305190,
      "text": "只剩他一人，",
      "token_start": 1019,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 305650,
      "end_ms": 306550,
      "text": "旁人都怕。",
      "token_start": 1024,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 306570,
      "end_ms": 308565,
      "text": "这位八十八岁老人撑不住。",
      "token_start": 1028,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 309030,
      "end_ms": 312350,
      "text": "他却平静写下一句中书，",
      "token_start": 1039,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 312410,
      "end_ms": 313130,
      "text": "逃走了，",
      "token_start": 1049,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 313370,
      "end_ms": 314430,
      "text": "我也想逃走，",
      "token_start": 1052,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 314870,
      "end_ms": 317710,
      "text": "可我不能逃得留在世间。",
      "token_start": 1057,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 317770,
      "end_ms": 318670,
      "text": "打扫现场。",
      "token_start": 1067,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 319530,
      "end_ms": 320950,
      "text": "所谓打扫现场，",
      "token_start": 1071,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 321250,
      "end_ms": 323870,
      "text": "是整理丈夫七万多页，",
      "token_start": 1077,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 324130,
      "end_ms": 325130,
      "text": "散乱手稿，",
      "token_start": 1086,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 325230,
      "end_ms": 329980,
      "text": "校对分类编撰，",
      "token_start": 1090,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 330820,
      "end_ms": 331960,
      "text": "耗费数年，",
      "token_start": 1096,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 332260,
      "end_ms": 334540,
      "text": "整理出钱钟书手稿集，",
      "token_start": 1100,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 335420,
      "end_ms": 342680,
      "text": "是提笔写下我们仨把一家三口温暖细碎的回忆妥帖。",
      "token_start": 1109,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 342700,
      "end_ms": 346200,
      "text": "收藏是看淡名利，",
      "token_start": 1131,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 346620,
      "end_ms": 350940,
      "text": "将毕生稿酬、版税全术捐给清华，",
      "token_start": 1138,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 351480,
      "end_ms": 353440,
      "text": "设立好读书奖学金，",
      "token_start": 1151,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 354000,
      "end_ms": 359230,
      "text": "资助家境清贫却勤学的学子名利荣华。",
      "token_start": 1159,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 359290,
      "end_ms": 363610,
      "text": "他从不贪恋晚年独居，",
      "token_start": 1175,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 363710,
      "end_ms": 366230,
      "text": "简朴小屋沙发旧了，",
      "token_start": 1184,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 366290,
      "end_ms": 368310,
      "text": "不肯更换茶几，",
      "token_start": 1192,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 368410,
      "end_ms": 370595,
      "text": "常年摆放两副碗筷，",
      "token_start": 1198,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 370950,
      "end_ms": 372645,
      "text": "仿佛爱人从未走远。",
      "token_start": 1206,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 374130,
      "end_ms": 375190,
      "text": "九十多岁时，",
      "token_start": 1214,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 375350,
      "end_ms": 376065,
      "text": "他写下，",
      "token_start": 1219,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 376420,
      "end_ms": 377855,
      "text": "走到人生边上，",
      "token_start": 1222,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 378520,
      "end_ms": 382315,
      "text": "自问自答生死人性与欲望，",
      "token_start": 1228,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 382980,
      "end_ms": 384785,
      "text": "文字没有华丽迟藻，",
      "token_start": 1239,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 385410,
      "end_ms": 387345,
      "text": "句句戳破生活本质。",
      "token_start": 1247,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 388430,
      "end_ms": 390985,
      "text": "我们熟知的那句世界是自己的，",
      "token_start": 1255,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 391500,
      "end_ms": 393695,
      "text": "与他人毫无关系，",
      "token_start": 1268,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 394260,
      "end_ms": 395765,
      "text": "不是消极避世，",
      "token_start": 1275,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 396240,
      "end_ms": 399085,
      "text": "而是他历经悲欢后悟透的清醒。",
      "token_start": 1281,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 399800,
      "end_ms": 403855,
      "text": "他见过世态凉薄受过无端委屈，",
      "token_start": 1294,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 404310,
      "end_ms": 406515,
      "text": "却始终守住心底柔软，",
      "token_start": 1307,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 407150,
      "end_ms": 408835,
      "text": "不随意评判他人，",
      "token_start": 1316,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 409210,
      "end_ms": 409890,
      "text": "不纠结，",
      "token_start": 1323,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 409970,
      "end_ms": 410925,
      "text": "过往遗憾。",
      "token_start": 1326,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 411320,
      "end_ms": 412360,
      "text": "不盲目追逐，",
      "token_start": 1330,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 412360,
      "end_ms": 413245,
      "text": "外界认可。",
      "token_start": 1335,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 413830,
      "end_ms": 414565,
      "text": "他曾说，",
      "token_start": 1339,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 414980,
      "end_ms": 416440,
      "text": "人除了生死，",
      "token_start": 1342,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 416620,
      "end_ms": 418135,
      "text": "其余不过擦伤，",
      "token_start": 1347,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 418540,
      "end_ms": 419525,
      "text": "平视自己，",
      "token_start": 1353,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 419820,
      "end_ms": 422385,
      "text": "才能看清人生本来模样。",
      "token_start": 1357,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 423260,
      "end_ms": 425285,
      "text": "读书不是为了发财牟利，",
      "token_start": 1367,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 425570,
      "end_ms": 428655,
      "text": "而是成为有温度、会思考的人。",
      "token_start": 1377,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 429770,
      "end_ms": 431850,
      "text": "这些流传全网的短句，",
      "token_start": 1389,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 432350,
      "end_ms": 434070,
      "text": "从来不是空洞鸡汤，",
      "token_start": 1398,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 434490,
      "end_ms": 440350,
      "text": "是他在扫厕所的清晨干笑寒夜失去至亲的深夜，",
      "token_start": 1406,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 440950,
      "end_ms": 443290,
      "text": "慢慢沉淀出的人生答案。",
      "token_start": 1426,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 444130,
      "end_ms": 445550,
      "text": "世零一六年五月，",
      "token_start": 1436,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 445910,
      "end_ms": 448730,
      "text": "一百零五岁的杨绛安然离世，",
      "token_start": 1443,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 449290,
      "end_ms": 453270,
      "text": "世人称她为中国最后一位女先生先生。",
      "token_start": 1455,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 453390,
      "end_ms": 455190,
      "text": "二字无关性别，",
      "token_start": 1471,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 455270,
      "end_ms": 459840,
      "text": "是世人对学识、风骨格局最高的境称。",
      "token_start": 1477,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 460380,
      "end_ms": 462640,
      "text": "他一生兼具三重身份，",
      "token_start": 1492,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 463020,
      "end_ms": 464740,
      "text": "有才情的创作者，",
      "token_start": 1501,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 464940,
      "end_ms": 467140,
      "text": "打通中西文化的翻译家。",
      "token_start": 1508,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 467519,
      "end_ms": 469220,
      "text": "温柔坚韧的妻子，",
      "token_start": 1518,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 469220,
      "end_ms": 471380,
      "text": "与母亲顺境不骄，",
      "token_start": 1525,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 471820,
      "end_ms": 472760,
      "text": "逆境不屈，",
      "token_start": 1532,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 473260,
      "end_ms": 474260,
      "text": "痛失所爱，",
      "token_start": 1536,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 474260,
      "end_ms": 475340,
      "text": "不沉溺悲泣，",
      "token_start": 1540,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 475639,
      "end_ms": 476700,
      "text": "坐勇盛名，",
      "token_start": 1545,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 476720,
      "end_ms": 477780,
      "text": "不贪恋浮化。",
      "token_start": 1549,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 478260,
      "end_ms": 480120,
      "text": "回望杨绛的百年人生，",
      "token_start": 1554,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 480540,
      "end_ms": 481800,
      "text": "而们终会明白，",
      "token_start": 1563,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 482200,
      "end_ms": 483340,
      "text": "真正的优雅，",
      "token_start": 1569,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 483720,
      "end_ms": 486340,
      "text": "从不是精致外表与顺遂人生，",
      "token_start": 1574,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 486840,
      "end_ms": 490490,
      "text": "而是无论命运给予风雨还是荣光，",
      "token_start": 1586,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 490850,
      "end_ms": 493070,
      "text": "始终守住内心从容，",
      "token_start": 1600,
      "token_end_exclusive": 1608
    },
    {
      "start_ms": 493110,
      "end_ms": 494375,
      "text": "不愿不怒，",
      "token_start": 1608,
      "token_end_exclusive": 1612
    },
    {
      "start_ms": 494740,
      "end_ms": 497145,
      "text": "不值岁月会带走亲友，",
      "token_start": 1612,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 497580,
      "end_ms": 498675,
      "text": "消磨年华，",
      "token_start": 1621,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 499060,
      "end_ms": 501645,
      "text": "但内心沉淀的通透与温柔，",
      "token_start": 1625,
      "token_end_exclusive": 1636
    },
    {
      "start_ms": 502120,
      "end_ms": 504065,
      "text": "会伴随我们走完这一生。",
      "token_start": 1636,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 505240,
      "end_ms": 506795,
      "text": "就像杨绛走过的路，",
      "token_start": 1646,
      "token_end_exclusive": 1654
    },
    {
      "start_ms": 507250,
      "end_ms": 508665,
      "text": "一半烟火谋生，",
      "token_start": 1654,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 509030,
      "end_ms": 509970,
      "text": "一伴清欢，",
      "token_start": 1660,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 510070,
      "end_ms": 511440,
      "text": "修心清醒，",
      "token_start": 1664,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 511580,
      "end_ms": 512025,
      "text": "释然，",
      "token_start": 1668,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 512790,
      "end_ms": 514195,
      "text": "便是最好的活法。",
      "token_start": 1670,
      "token_end_exclusive": 1677
    },
    {
