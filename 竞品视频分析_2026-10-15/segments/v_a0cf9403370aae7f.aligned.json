  "segments": [
    {
      "start_ms": 150,
      "end_ms": 2190,
      "text": "原来情绪好身体就会很好，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2430,
      "end_ms": 4710,
      "text": "中医说心情愉悦是大补，",
      "token_start": 11,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5130,
      "end_ms": 6630,
      "text": "情绪低落是大伤，",
      "token_start": 21,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7050,
      "end_ms": 8010,
      "text": "百病生于气。",
      "token_start": 28,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8290,
      "end_ms": 9070,
      "text": "只要不生气，",
      "token_start": 33,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 9470,
      "end_ms": 10690,
      "text": "你就很难生病。",
      "token_start": 38,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 11310,
      "end_ms": 14170,
      "text": "凡是能够让你快乐的都是你的良药，",
      "token_start": 44,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 14490,
      "end_ms": 15830,
      "text": "凡是能困住你的，",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 16090,
      "end_ms": 17030,
      "text": "也不是环境，",
      "token_start": 66,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 17330,
      "end_ms": 18350,
      "text": "而是你自己。",
      "token_start": 71,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 18950,
      "end_ms": 20210,
      "text": "你可以穷可以累，",
      "token_start": 76,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 20550,
      "end_ms": 21830,
      "text": "但是你不能不开心。",
      "token_start": 83,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 22370,
      "end_ms": 23910,
      "text": "因为人长期的不开心，",
      "token_start": 91,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 24250,
      "end_ms": 25230,
      "text": "真的会生病。",
      "token_start": 100,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 25850,
      "end_ms": 27090,
      "text": "只有心情愉悦了，",
      "token_start": 105,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 27190,
      "end_ms": 28050,
      "text": "情绪好了，",
      "token_start": 112,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 28210,
      "end_ms": 29310,
      "text": "气血才会通畅，",
      "token_start": 116,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 29550,
      "end_ms": 31480,
      "text": "人生才才会顺起来。",
      "token_start": 122,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 31840,
      "end_ms": 33680,
      "text": "心平能愈三千疾，",
      "token_start": 130,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 33980,
      "end_ms": 36140,
      "text": "心境可通万事理。",
      "token_start": 137,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 36540,
      "end_ms": 37560,
      "text": "所以中医上说，",
      "token_start": 144,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 37860,
      "end_ms": 42305,
      "text": "关喜才是世界上的第一大补。",
      "token_start": 150,
      "token_end_exclusive": 162
    }
  ],
