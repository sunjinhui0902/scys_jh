{
  "video_id": "v_9eb25043ec7535d2",
  "duration_s": 218.267007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_9eb25043ec7535d2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_9eb25043ec7535d2.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 630,
      "end_ms": 1030,
      "text": "Jj,",
      "token_start": 0,
      "token_end_exclusive": 1
    },
    {
      "start_ms": 1330,
      "end_ms": 2150,
      "text": "你相信吗？",
      "token_start": 1,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 2390,
      "end_ms": 4610,
      "text": "越没用的东西越值钱。",
      "token_start": 5,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 5070,
      "end_ms": 6730,
      "text": "比如像这种拉波波的玩偶，",
      "token_start": 14,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6730,
      "end_ms": 8130,
      "text": "一个要大几百上千，",
      "token_start": 25,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8430,
      "end_ms": 9330,
      "text": "它有什么用呢？",
      "token_start": 33,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9530,
      "end_ms": 11010,
      "text": "它能给孩子辅导作业吗？",
      "token_start": 39,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 11150,
      "end_ms": 12190,
      "text": "他没有任何用，",
      "token_start": 49,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 12430,
      "end_ms": 14770,
      "text": "但是如果把它里面做成一个，",
      "token_start": 55,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 14770,
      "end_ms": 16270,
      "text": "比如蓝牙音箱很有用，",
      "token_start": 67,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 16509,
      "end_ms": 17810,
      "text": "它反而就不值钱了。",
      "token_start": 76,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 18190,
      "end_ms": 19490,
      "text": "如果它里面有个u盘，",
      "token_start": 84,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 19790,
      "end_ms": 21250,
      "text": "但是最多只会买一个。",
      "token_start": 93,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 21410,
      "end_ms": 22990,
      "text": "因为你会从功能性的考虑，",
      "token_start": 102,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 22990,
      "end_ms": 23770,
      "text": "已经有一个了，",
      "token_start": 113,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 23770,
      "end_ms": 25190,
      "text": "没必要再多买一个u盘。",
      "token_start": 119,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 25410,
      "end_ms": 27730,
      "text": "正是因为拉波布除了情绪价值之外，",
      "token_start": 129,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 27730,
      "end_ms": 28530,
      "text": "一无所用，",
      "token_start": 144,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 28530,
      "end_ms": 30135,
      "text": "大家才会一买再买，",
      "token_start": 148,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 30500,
      "end_ms": 31160,
      "text": "你相信吗？",
      "token_start": 156,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 31260,
      "end_ms": 33420,
      "text": "人一定会为漂亮的东西买单，",
      "token_start": 160,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 33600,
      "end_ms": 34500,
      "text": "就算不买，",
      "token_start": 172,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 34520,
      "end_ms": 35520,
      "text": "也会念念不忘。",
      "token_start": 176,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 35760,
      "end_ms": 37180,
      "text": "比如最近的苹果折叠屏，",
      "token_start": 182,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 37380,
      "end_ms": 39120,
      "text": "实在找不到其他任何优点。",
      "token_start": 192,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 39120,
      "end_ms": 42220,
      "text": "你看开屏的渐变动画就成了最大的卖点，",
      "token_start": 203,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 42340,
      "end_ms": 45380,
      "text": "而且这种情绪价值的审美是高度个性化的。",
      "token_start": 220,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 45380,
      "end_ms": 47380,
      "text": "比如我个人就觉得拉波波长得很，",
      "token_start": 238,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 47380,
      "end_ms": 47980,
      "text": "像个飞，",
      "token_start": 252,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 48180,
      "end_ms": 49000,
      "text": "整天呲个牙，",
      "token_start": 255,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 49000,
      "end_ms": 50440,
      "text": "还有点阴森邪恶的笑。",
      "token_start": 260,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 50580,
      "end_ms": 52100,
      "text": "他并不在我的审之之上。",
      "token_start": 269,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 52340,
      "end_ms": 53660,
      "text": "我虽然不买他的东西，",
      "token_start": 279,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 53840,
      "end_ms": 55300,
      "text": "但是完全不单我的老婆，",
      "token_start": 288,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 55300,
      "end_ms": 55980,
      "text": "孩子会买。",
      "token_start": 298,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 56180,
      "end_ms": 57360,
      "text": "之所以我没有入坑，",
      "token_start": 302,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 57480,
      "end_ms": 59905,
      "text": "是因为他开发的IP还没有在我的心坎上。",
      "token_start": 310,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 60210,
      "end_ms": 63315,
      "text": "但是花钱买情趣驾驶这个事儿谁都跑不了。",
      "token_start": 327,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 63670,
      "end_ms": 65790,
      "text": "那这是一代人有一代人的茅台，",
      "token_start": 345,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 66050,
      "end_ms": 69045,
      "text": "比如你觉得茅台的竞争对手会是其他酒吗？",
      "token_start": 358,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 69420,
      "end_ms": 71400,
      "text": "喝茅台的人是不用买茅台的，",
      "token_start": 376,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 71500,
      "end_ms": 75525,
      "text": "买茅台的人是舍不得自己喝的这叫社交领域的情绪价值。",
      "token_start": 388,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 75790,
      "end_ms": 77190,
      "text": "泡泡玛特的老板有个理论，",
      "token_start": 412,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 77190,
      "end_ms": 78550,
      "text": "我最近发现特别深刻。",
      "token_start": 423,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 78550,
      "end_ms": 78995,
      "text": "他说，",
      "token_start": 432,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 79350,
      "end_ms": 80825,
      "text": "假如你是一个千万富翁，",
      "token_start": 434,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 81040,
      "end_ms": 83445,
      "text": "你出门的时候忘记关掉厨房水龙头了，",
      "token_start": 444,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 83660,
      "end_ms": 84600,
      "text": "你会觉得不舒服，",
      "token_start": 460,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 84600,
      "end_ms": 86005,
      "text": "总觉得浪费了几十块钱。",
      "token_start": 467,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 86390,
      "end_ms": 88670,
      "text": "但是你家小区门口的高级景观喷泉，",
      "token_start": 477,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 88670,
      "end_ms": 89990,
      "text": "哪怕不是循环的水，",
      "token_start": 492,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 90090,
      "end_ms": 91350,
      "text": "每天浪费那么多水，",
      "token_start": 500,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 91430,
      "end_ms": 92610,
      "text": "你完全不会心疼。",
      "token_start": 508,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 92830,
      "end_ms": 93270,
      "text": "因此，",
      "token_start": 515,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 93330,
      "end_ms": 95585,
      "text": "情绪价值有时候比钱更重要，",
      "token_start": 517,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 95860,
      "end_ms": 99315,
      "text": "就像几乎没有人是因为要看时间才去买那么贵的手表，",
      "token_start": 529,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 99700,
      "end_ms": 102600,
      "text": "它最没用的地方恰恰是它最值钱的部分。",
      "token_start": 552,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 102660,
      "end_ms": 103365,
      "text": "你发现了吗？",
      "token_start": 569,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 103620,
      "end_ms": 104820,
      "text": "只要没有具体功能，",
      "token_start": 574,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 104820,
      "end_ms": 106220,
      "text": "就不会存在够用了。",
      "token_start": 582,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 106220,
      "end_ms": 108690,
      "text": "这三字情感永远不会饱和，",
      "token_start": 590,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 108710,
      "end_ms": 110310,
      "text": "于是你会买第二个。",
      "token_start": 601,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 110310,
      "end_ms": 110890,
      "text": "第三个，",
      "token_start": 609,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 110910,
      "end_ms": 112610,
      "text": "这就是无用及永恒。",
      "token_start": 612,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 112890,
      "end_ms": 115495,
      "text": "人永远比自己以为的要感性的多。",
      "token_start": 620,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 115930,
      "end_ms": 116950,
      "text": "而且你回头想想，",
      "token_start": 634,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 116970,
      "end_ms": 118670,
      "text": "真正撑起你人生厚度的，",
      "token_start": 641,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 118750,
      "end_ms": 120815,
      "text": "恰恰全是一些无用之事。",
      "token_start": 651,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 121280,
      "end_ms": 123145,
      "text": "每天傍晚下楼散的那一圈步，",
      "token_start": 661,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 123460,
      "end_ms": 125860,
      "text": "阳台上那会儿养了半年才开一朵的花。",
      "token_start": 673,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 126120,
      "end_ms": 126920,
      "text": "他们不赚钱，",
      "token_start": 689,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 126920,
      "end_ms": 128000,
      "text": "不加分、不升值，",
      "token_start": 694,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 128020,
      "end_ms": 129775,
      "text": "不产生任何显性效益。",
      "token_start": 700,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 130080,
      "end_ms": 132000,
      "text": "可他们在悄悄治愈你的焦虑，",
      "token_start": 709,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 132000,
      "end_ms": 134230,
      "text": "抚平你的疲惫有用的事，",
      "token_start": 721,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 134270,
      "end_ms": 135310,
      "text": "养活你的生活，",
      "token_start": 731,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 135410,
      "end_ms": 136150,
      "text": "无用的事，",
      "token_start": 737,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 136250,
      "end_ms": 137330,
      "text": "养活你的灵魂。",
      "token_start": 741,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 137570,
      "end_ms": 138530,
      "text": "而最魔幻的是，",
      "token_start": 747,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 138650,
      "end_ms": 140250,
      "text": "越拼命追求有用的人，",
      "token_start": 753,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 140270,
      "end_ms": 141329,
      "text": "眼里越没有光。",
      "token_start": 762,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 141530,
      "end_ms": 143950,
      "text": "反倒是那些肯花时间没用的人，",
      "token_start": 768,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 143990,
      "end_ms": 145205,
      "text": "活的热气腾腾。",
      "token_start": 781,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 145550,
      "end_ms": 146230,
      "text": "魏晋时期，",
      "token_start": 787,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 146270,
      "end_ms": 147710,
      "text": "门阀斗的你死我活，",
      "token_start": 791,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 147730,
      "end_ms": 149675,
      "text": "读书人连小命都未必保得住。",
      "token_start": 799,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 150000,
      "end_ms": 151840,
      "text": "竹林七贤跑到山里喝酒，",
      "token_start": 811,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 151940,
      "end_ms": 152955,
      "text": "弹琴长啸，",
      "token_start": 821,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 153270,
      "end_ms": 154945,
      "text": "不谈仕途、只谈风月。",
      "token_start": 825,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 155280,
      "end_ms": 157660,
      "text": "在那样一个玩不好就要掉脑袋的年代里，",
      "token_start": 833,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 157660,
      "end_ms": 158060,
      "text": "无用，",
      "token_start": 850,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 158240,
      "end_ms": 159840,
      "text": "反倒成了他们保命的方式。",
      "token_start": 852,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 160100,
      "end_ms": 162160,
      "text": "在过去那个物质稀缺的时代，",
      "token_start": 863,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 162160,
      "end_ms": 163715,
      "text": "我们主打一个功能价值。",
      "token_start": 875,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 164000,
      "end_ms": 165820,
      "text": "而现在是物质过剩的时代，",
      "token_start": 885,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 165900,
      "end_ms": 168145,
      "text": "在功能上面要叠加情绪价值。",
      "token_start": 896,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 168380,
      "end_ms": 169965,
      "text": "这就是月季经济。",
      "token_start": 908,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 170240,
      "end_ms": 172200,
      "text": "许多人都在抱怨说内卷严重，",
      "token_start": 915,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 172240,
      "end_ms": 173620,
      "text": "大家没有消费能力了。",
      "token_start": 927,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 173620,
      "end_ms": 173860,
      "text": "来，",
      "token_start": 936,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 173980,
      "end_ms": 174920,
      "text": "你看一下拉布布，",
      "token_start": 937,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 175080,
      "end_ms": 176480,
      "text": "全世界都在排队买。",
      "token_start": 944,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 176480,
      "end_ms": 177355,
      "text": "不光是中国，",
      "token_start": 952,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 177740,
      "end_ms": 179860,
      "text": "其实并不是消费者没有消费能力的，",
      "token_start": 957,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 179880,
      "end_ms": 181400,
      "text": "而是旧的商业思维，",
      "token_start": 972,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 181440,
      "end_ms": 182900,
      "text": "无法适应新的市场。",
      "token_start": 980,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 183120,
      "end_ms": 185100,
      "text": "如今在九子灵活时期，",
      "token_start": 988,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 185280,
      "end_ms": 189635,
      "text": "你要靠近所有跟情绪、跟能量、跟文化相关的场域。",
      "token_start": 997,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 189890,
      "end_ms": 192650,
      "text": "当消费者愿意为情绪价值去支付溢价，",
      "token_start": 1017,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 192730,
      "end_ms": 193525,
      "text": "什么叫溢价？",
      "token_start": 1033,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 193770,
      "end_ms": 196625,
      "text": "你明明知道这玩意生产出来可能只需要几十块钱，",
      "token_start": 1038,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 196900,
      "end_ms": 199435,
      "text": "但是也仍然愿意花几百和几千去买它。",
      "token_start": 1059,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 199800,
      "end_ms": 202575,
      "text": "传统的成本定价逻辑已经失效了，",
      "token_start": 1075,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 203000,
      "end_ms": 205705,
      "text": "情绪价值一定是未来十年最大的风口。",
      "token_start": 1089,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 206040,
      "end_ms": 206740,
      "text": "从今天起，",
      "token_start": 1105,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 206900,
      "end_ms": 209320,
      "text": "允许自己读一本不能立马变现的书，",
      "token_start": 1109,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 209500,
      "end_ms": 211580,
      "text": "走一条不通往任何目的的路。",
      "token_start": 1124,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 211720,
      "end_ms": 214355,
      "text": "在阳台上发十分钟没用的呆，",
      "token_start": 1136,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 214710,
      "end_ms": 216110,
      "text": "因为那些没用的时刻，",
      "token_start": 1148,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 216250,
      "end_ms": 218015,
      "text": "才是你真正活着的时刻。",
      "token_start": 1157,
      "token_end_exclusive": 1167
    }
  ],
