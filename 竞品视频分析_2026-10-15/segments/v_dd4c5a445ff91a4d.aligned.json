{
  "video_id": "v_dd4c5a445ff91a4d",
  "duration_s": 406.535011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_dd4c5a445ff91a4d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_dd4c5a445ff91a4d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 2130,
      "text": "要说中国哪里的秋天，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2410,
      "end_ms": 4770,
      "text": "能一边看尽漫山秋色，",
      "token_start": 9,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5350,
      "end_ms": 7350,
      "text": "一边把心安静下来，",
      "token_start": 18,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7910,
      "end_ms": 9730,
      "text": "古刹绝对算得上一个。",
      "token_start": 26,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 10410,
      "end_ms": 14870,
      "text": "可您知道中国秋天最震撼心灵的古刹是哪一座吗？",
      "token_start": 35,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 15230,
      "end_ms": 19310,
      "text": "有人说是灵隐寺一千七百年的江南古刹，",
      "token_start": 56,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 19710,
      "end_ms": 20870,
      "text": "满寺桂花香。",
      "token_start": 73,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21650,
      "end_ms": 23250,
      "text": "有人说是悬空寺，",
      "token_start": 78,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 23790,
      "end_ms": 26730,
      "text": "在悬崖上挂了一千五百年错。",
      "token_start": 85,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 27370,
      "end_ms": 31020,
      "text": "灵隐寺连前五都进不了悬空寺，",
      "token_start": 97,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 31080,
      "end_ms": 32020,
      "text": "也不是第一，",
      "token_start": 110,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 32440,
      "end_ms": 36760,
      "text": "真正排在榜首的那座不是皇家名寺，",
      "token_start": 115,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 37040,
      "end_ms": 38440,
      "text": "不在佛教名山，",
      "token_start": 130,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 39040,
      "end_ms": 41300,
      "text": "连像样的大殿都没有。",
      "token_start": 136,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 41640,
      "end_ms": 42980,
      "text": "院子里有一棵树，",
      "token_start": 145,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 43520,
      "end_ms": 48480,
      "text": "相传是一位皇帝亲手栽下的一千四百年了。",
      "token_start": 152,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 49080,
      "end_ms": 49560,
      "text": "今天，",
      "token_start": 170,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 49580,
      "end_ms": 54520,
      "text": "咱们就来盘点中国十大最震撼心灵的秋日古刹。",
      "token_start": 172,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 54920,
      "end_ms": 55720,
      "text": "话不多说，",
      "token_start": 192,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 55960,
      "end_ms": 57220,
      "text": "茶给您沏好了，",
      "token_start": 196,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 57440,
      "end_ms": 59260,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 202,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 59480,
      "end_ms": 60555,
      "text": "咱们这就开讲。",
      "token_start": 212,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 60870,
      "end_ms": 63125,
      "text": "第十名寒山寺，",
      "token_start": 218,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 63550,
      "end_ms": 66125,
      "text": "江苏苏州枫桥边上，",
      "token_start": 224,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 66710,
      "end_ms": 68695,
      "text": "月落乌啼霜满天，",
      "token_start": 232,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 69100,
      "end_ms": 71095,
      "text": "江枫渔火对愁眠，",
      "token_start": 239,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 71480,
      "end_ms": 75145,
      "text": "写的就是他一千二百多年前的一个秋叶，",
      "token_start": 246,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 75830,
      "end_ms": 77490,
      "text": "相传落了地的书生。",
      "token_start": 263,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 77490,
      "end_ms": 80245,
      "text": "张继把船停在枫桥下，",
      "token_start": 271,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 80710,
      "end_ms": 81725,
      "text": "躺着睡不着。",
      "token_start": 280,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 82640,
      "end_ms": 83625,
      "text": "霜是冷的，",
      "token_start": 285,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 84080,
      "end_ms": 85145,
      "text": "渔火是晃的，",
      "token_start": 289,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 85730,
      "end_ms": 87075,
      "text": "心里是一场空。",
      "token_start": 294,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 87540,
      "end_ms": 88395,
      "text": "就在这会儿，",
      "token_start": 300,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 88890,
      "end_ms": 92155,
      "text": "半夜里一记钟声从寺里荡出来，",
      "token_start": 305,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 92660,
      "end_ms": 95675,
      "text": "穿过双气落到他的船头。",
      "token_start": 318,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 96460,
      "end_ms": 100615,
      "text": "这座寺始建于南朝梁代一千五百多年了，",
      "token_start": 328,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 101030,
      "end_ms": 105345,
      "text": "可真正让他传遍天下的就是那二十八个字，",
      "token_start": 345,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 106050,
      "end_ms": 108070,
      "text": "一个失一人一计，",
      "token_start": 363,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 108070,
      "end_ms": 112215,
      "text": "终生满心的委屈就被敲散了。",
      "token_start": 370,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 112970,
      "end_ms": 119715,
      "text": "您说这穿越千年的夜半钟声算不算世间最好的定心丸？",
      "token_start": 382,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 120110,
      "end_ms": 120935,
      "text": "第九名，",
      "token_start": 405,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 121380,
      "end_ms": 122165,
      "text": "红螺寺，",
      "token_start": 408,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 122560,
      "end_ms": 128025,
      "text": "北京怀柔红螺山南路老北京人都念叨一句老话，",
      "token_start": 411,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 128520,
      "end_ms": 129600,
      "text": "男败雍和，",
      "token_start": 431,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 130000,
      "end_ms": 131175,
      "text": "女败红罗。",
      "token_start": 435,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 131640,
      "end_ms": 133295,
      "text": "这座寺始建于东晋，",
      "token_start": 439,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 133790,
      "end_ms": 135125,
      "text": "一千六百多年了，",
      "token_start": 447,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 135570,
      "end_ms": 139205,
      "text": "是北方历史最悠久的佛教名刹之一。",
      "token_start": 454,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 139950,
      "end_ms": 140850,
      "text": "一进山门，",
      "token_start": 469,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 141170,
      "end_ms": 143785,
      "text": "您会先被满山的红叶晃了眼，",
      "token_start": 473,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 144430,
      "end_ms": 145410,
      "text": "层层叠叠，",
      "token_start": 485,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 145410,
      "end_ms": 146235,
      "text": "铺到山顶，",
      "token_start": 489,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 146810,
      "end_ms": 148715,
      "text": "像一块摊开的锦缎，",
      "token_start": 493,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 149130,
      "end_ms": 151765,
      "text": "寺里还有一对上千年的古银杏。",
      "token_start": 501,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 152290,
      "end_ms": 155785,
      "text": "一雌一雄分立在殿前两侧，",
      "token_start": 514,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 156330,
      "end_ms": 157310,
      "text": "深秋一到，",
      "token_start": 525,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 157530,
      "end_ms": 160210,
      "text": "满树金黄树下，",
      "token_start": 529,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 160310,
      "end_ms": 163355,
      "text": "全是母亲在为儿女磕头祈福。",
      "token_start": 535,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 163770,
      "end_ms": 166125,
      "text": "母亲们不求自己大富大贵。",
      "token_start": 547,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 166720,
      "end_ms": 168995,
      "text": "只盼孩子一生平安顺遂，",
      "token_start": 558,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 169740,
      "end_ms": 171855,
      "text": "漫山红叶是秋色。",
      "token_start": 568,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 172380,
      "end_ms": 176144,
      "text": "这满殿母爱才是红螺寺最动人的慈悲。",
      "token_start": 575,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 176630,
      "end_ms": 181475,
      "text": "您说这天底下的母爱是不是比满山彩叶还要厚厚住？",
      "token_start": 591,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 181780,
      "end_ms": 183725,
      "text": "第八名灵隐寺，",
      "token_start": 613,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 184250,
      "end_ms": 185415,
      "text": "浙江杭州。",
      "token_start": 619,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 186140,
      "end_ms": 187905,
      "text": "他坐落在飞来峰下，",
      "token_start": 623,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 188400,
      "end_ms": 189720,
      "text": "一千六百多载，",
      "token_start": 631,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 189720,
      "end_ms": 191950,
      "text": "光阴深秋时节，",
      "token_start": 637,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 192050,
      "end_ms": 194650,
      "text": "满似金桂飘香洪峰，",
      "token_start": 643,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 194790,
      "end_ms": 197660,
      "text": "斜掩着斑驳黄墙冷泉，",
      "token_start": 651,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 197780,
      "end_ms": 201360,
      "text": "溪水在脚边潺潺流过清冽，",
      "token_start": 660,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 201380,
      "end_ms": 204835,
      "text": "空气里全是一股子沁人心脾的甜香。",
      "token_start": 671,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 205660,
      "end_ms": 207095,
      "text": "您走在石阶上，",
      "token_start": 686,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 207450,
      "end_ms": 210245,
      "text": "看着济公殿前那尊笑眯眯的佛像，",
      "token_start": 692,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 210760,
      "end_ms": 212395,
      "text": "大度能容天下事，",
      "token_start": 706,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 212820,
      "end_ms": 213900,
      "text": "心里那些纠结，",
      "token_start": 713,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 214120,
      "end_ms": 215565,
      "text": "瞬间就释怀了。",
      "token_start": 719,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 216000,
      "end_ms": 217055,
      "text": "人生过半，",
      "token_start": 725,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 217640,
      "end_ms": 218735,
      "text": "争了一辈子，",
      "token_start": 729,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 219170,
      "end_ms": 220285,
      "text": "操劳了一辈子，",
      "token_start": 734,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 220680,
      "end_ms": 223275,
      "text": "到头来随遇而安才是真。",
      "token_start": 740,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 223950,
      "end_ms": 226485,
      "text": "这满四金桂配一系平常心，",
      "token_start": 750,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 226930,
      "end_ms": 229165,
      "text": "您说这算不算最通透的智慧？",
      "token_start": 761,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 229570,
      "end_ms": 233005,
      "text": "第七名苏州西园寺门外，",
      "token_start": 773,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 233310,
      "end_ms": 234385,
      "text": "就在留园隔壁。",
      "token_start": 783,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 235190,
      "end_ms": 237135,
      "text": "这座寺始建元代，",
      "token_start": 789,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 237580,
      "end_ms": 240395,
      "text": "后来一户官宦人家舍园为斯，",
      "token_start": 796,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 241100,
      "end_ms": 243575,
      "text": "所以他不像别的明察那样森严，",
      "token_start": 808,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 243890,
      "end_ms": 245425,
      "text": "倒像一座大园子。",
      "token_start": 821,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 245860,
      "end_ms": 247280,
      "text": "深秋的放生池，",
      "token_start": 828,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 247300,
      "end_ms": 248325,
      "text": "水清见底，",
      "token_start": 834,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 248970,
      "end_ms": 251205,
      "text": "金黄的银杏落满庭院，",
      "token_start": 838,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 251710,
      "end_ms": 252890,
      "text": "几十只四猫，",
      "token_start": 847,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 252950,
      "end_ms": 254645,
      "text": "趴在落叶堆里晒太阳，",
      "token_start": 852,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 255130,
      "end_ms": 256825,
      "text": "谁走过都懒得睁眼。",
      "token_start": 861,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 257230,
      "end_ms": 258245,
      "text": "连廊底下，",
      "token_start": 869,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 258660,
      "end_ms": 261495,
      "text": "您捧一碗热气腾腾的素面，",
      "token_start": 873,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 261850,
      "end_ms": 263105,
      "text": "一口汤下去，",
      "token_start": 884,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 263530,
      "end_ms": 265525,
      "text": "从嗓子暖到胃里。",
      "token_start": 889,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 265890,
      "end_ms": 268310,
      "text": "这儿没有惊天动地的传说，",
      "token_start": 896,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 268770,
      "end_ms": 270535,
      "text": "也没有悬崖绝壁，",
      "token_start": 907,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 271050,
      "end_ms": 275665,
      "text": "可人到了一定岁数才懂折腾了大半辈子。",
      "token_start": 914,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 276050,
      "end_ms": 280190,
      "text": "最想要的不过是有太阳晒有猫胚，",
      "token_start": 931,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 280610,
      "end_ms": 281945,
      "text": "有一碗热汤。",
      "token_start": 945,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 282500,
      "end_ms": 285775,
      "text": "您说这算不算最朴素的慈悲？",
      "token_start": 950,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 286170,
      "end_ms": 286830,
      "text": "第六名，",
      "token_start": 962,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 287230,
      "end_ms": 291535,
      "text": "山西大同悬空寺、浑源县金龙峡。",
      "token_start": 965,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 292230,
      "end_ms": 293150,
      "text": "讲到这儿，",
      "token_start": 978,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 293470,
      "end_ms": 295370,
      "text": "分量可就彻底沉下来了。",
      "token_start": 982,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 295670,
      "end_ms": 298650,
      "text": "他凌空挂在百米垂直绝壁上，",
      "token_start": 992,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 298690,
      "end_ms": 300930,
      "text": "一千五百年深秋，",
      "token_start": 1004,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 300990,
      "end_ms": 302790,
      "text": "峡谷里秋风呼啸，",
      "token_start": 1011,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 303170,
      "end_ms": 304690,
      "text": "两岸黄叶翻飞，",
      "token_start": 1018,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 305250,
      "end_ms": 310670,
      "text": "整座古寺紧靠几根飞梁暗插在悬崖里凌空傲立。",
      "token_start": 1024,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 311150,
      "end_ms": 313370,
      "text": "您扶着木兰往下瞅一眼，",
      "token_start": 1044,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 314030,
      "end_ms": 316130,
      "text": "脚底下是万丈深渊，",
      "token_start": 1054,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 316130,
      "end_ms": 318950,
      "text": "冷风直往领口里钻。",
      "token_start": 1062,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 318950,
      "end_ms": 321650,
      "text": "可这木楼历经风雨，",
      "token_start": 1070,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 321650,
      "end_ms": 325080,
      "text": "连雷击愣是一寸都没挪动过。",
      "token_start": 1078,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 325500,
      "end_ms": 327900,
      "text": "修他的人早已化作尘土，",
      "token_start": 1090,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 328400,
      "end_ms": 331300,
      "text": "他却在绝壁上站成了铁骨头。",
      "token_start": 1100,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 331660,
      "end_ms": 332040,
      "text": "您说，",
      "token_start": 1112,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 332040,
      "end_ms": 334480,
      "text": "这份千百年屹立不倒的气魄，",
      "token_start": 1114,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 334840,
      "end_ms": 336800,
      "text": "怎能不让人肃然起敬？",
      "token_start": 1126,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 337100,
      "end_ms": 338900,
      "text": "从第十到第六名，",
      "token_start": 1135,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 339380,
      "end_ms": 342140,
      "text": "寒山寺的一骑钟声敲散了，",
      "token_start": 1142,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 342300,
      "end_ms": 346380,
      "text": "落地书生的愁红罗寺的满山红叶里，",
      "token_start": 1153,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 346440,
      "end_ms": 348120,
      "text": "全是母亲的牵挂。",
      "token_start": 1168,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 348640,
      "end_ms": 351000,
      "text": "灵隐寺一缕桂香化开，",
      "token_start": 1175,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 351240,
      "end_ms": 352445,
      "text": "半生执念，",
      "token_start": 1184,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 352980,
      "end_ms": 354720,
      "text": "西园寺的一碗素面，",
      "token_start": 1188,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 354920,
      "end_ms": 357560,
      "text": "暖了人间的冷悬空寺，",
      "token_start": 1196,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 357560,
      "end_ms": 360705,
      "text": "在悬崖绝壁上硬撑了一千五百年，",
      "token_start": 1205,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 361450,
      "end_ms": 364105,
      "text": "可他们还不是最震撼心灵的。",
      "token_start": 1219,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 364600,
      "end_ms": 366565,
      "text": "接下来第五道第一名更动人，",
      "token_start": 1231,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 367040,
      "end_ms": 368335,
      "text": "有一座古刹，",
      "token_start": 1243,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 368790,
      "end_ms": 370375,
      "text": "满山红枫如火，",
      "token_start": 1248,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 370920,
      "end_ms": 374745,
      "text": "千年石窟在烈火般的秋色里静坐。",
      "token_start": 1254,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 375270,
      "end_ms": 377150,
      "text": "有一座寺门前，",
      "token_start": 1268,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 377230,
      "end_ms": 379080,
      "text": "就是大海潮生，",
      "token_start": 1274,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 379320,
      "end_ms": 381925,
      "text": "日夜不停的往人心里涌，",
      "token_start": 1280,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 382300,
      "end_ms": 385470,
      "text": "可排在榜首的那座深秋，",
      "token_start": 1290,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 385630,
      "end_ms": 386625,
      "text": "山风一吹，",
      "token_start": 1300,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 387180,
      "end_ms": 391315,
      "text": "便能下一场天地间最壮阔的万叶金雨。",
      "token_start": 1304,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 391880,
      "end_ms": 392675,
      "text": "他是哪座？",
      "token_start": 1320,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 393110,
      "end_ms": 397315,
      "text": "他凭什么排在灵隐寺和悬空寺前面，",
      "token_start": 1324,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 397730,
      "end_ms": 399465,
      "text": "下一集已经同步更新，",
      "token_start": 1339,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 400320,
      "end_ms": 401400,
      "text": "点开我的头像，",
      "token_start": 1348,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 401420,
      "end_ms": 402160,
      "text": "进入主页，",
      "token_start": 1354,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 402300,
      "end_ms": 404275,
      "text": "就能看到点个关注，",
      "token_start": 1358,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 404770,
      "end_ms": 406155,
      "text": "咱们下集接着聊。",
      "token_start": 1366,
      "token_end_exclusive": 1373
    }
  ],
