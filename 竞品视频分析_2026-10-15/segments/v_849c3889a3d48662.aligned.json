{
  "video_id": "v_849c3889a3d48662",
  "duration_s": 397.108005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_849c3889a3d48662.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_849c3889a3d48662.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 5310,
      "text": "您知道中国最适合慢慢走的原生态古镇是哪一个吗？",
      "token_start": 0,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5850,
      "end_ms": 6990,
      "text": "有人说是乌镇。",
      "token_start": 22,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7570,
      "end_ms": 9790,
      "text": "有人说是西塘错了，",
      "token_start": 28,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 10210,
      "end_ms": 12490,
      "text": "那些地方走几步就碰肩膀，",
      "token_start": 36,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 13230,
      "end_ms": 15590,
      "text": "真正的榜首不在江南水乡，",
      "token_start": 47,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 16190,
      "end_ms": 17930,
      "text": "也不在旅游大干线上。",
      "token_start": 58,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 18370,
      "end_ms": 20630,
      "text": "它藏在一片宁静山谷里，",
      "token_start": 67,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 21050,
      "end_ms": 23730,
      "text": "一条清澈江水流过老石桥。",
      "token_start": 77,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 24210,
      "end_ms": 27210,
      "text": "一座六百年的古戏台立在空地上，",
      "token_start": 88,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 27670,
      "end_ms": 30480,
      "text": "连骡马走过的堤印还在。",
      "token_start": 102,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 30960,
      "end_ms": 36980,
      "text": "今天咱们就来盘点中国十大最适合慢慢走的原生态古镇。",
      "token_start": 112,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 37340,
      "end_ms": 39700,
      "text": "看到这儿觉得有点意思的朋友，",
      "token_start": 136,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 40260,
      "end_ms": 42620,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 149,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 42740,
      "end_ms": 43640,
      "text": "收藏起来，",
      "token_start": 159,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 44120,
      "end_ms": 45200,
      "text": "省得手一滑，",
      "token_start": 163,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 45280,
      "end_ms": 47340,
      "text": "咱们就错过了第十名。",
      "token_start": 168,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 47700,
      "end_ms": 49920,
      "text": "目睹古镇江苏苏州，",
      "token_start": 177,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 50640,
      "end_ms": 54040,
      "text": "他在苏州城西边灵岩山脚下，",
      "token_start": 185,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 54520,
      "end_ms": 57160,
      "text": "一条河川镇过园子，",
      "token_start": 197,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 57160,
      "end_ms": 58540,
      "text": "和人家都挨着水。",
      "token_start": 205,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 58920,
      "end_ms": 59765,
      "text": "老外人说，",
      "token_start": 212,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 60380,
      "end_ms": 61600,
      "text": "两千五百年前，",
      "token_start": 216,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 62020,
      "end_ms": 64135,
      "text": "吴王夫差给西施修宫殿，",
      "token_start": 222,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 64490,
      "end_ms": 66050,
      "text": "全国的木头运过来，",
      "token_start": 232,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 66070,
      "end_ms": 67015,
      "text": "堵满了河道，",
      "token_start": 240,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 67650,
      "end_ms": 68865,
      "text": "证明就这么来的。",
      "token_start": 245,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 69380,
      "end_ms": 71615,
      "text": "后来乾隆六次下江南，",
      "token_start": 252,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 72050,
      "end_ms": 73575,
      "text": "据说回回的往这儿跑，",
      "token_start": 261,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 74050,
      "end_ms": 75415,
      "text": "可您今天去，",
      "token_start": 270,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 75750,
      "end_ms": 77105,
      "text": "不用直奔园子，",
      "token_start": 275,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 77470,
      "end_ms": 80540,
      "text": "顺着河边的老街走青石板路，",
      "token_start": 281,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 80560,
      "end_ms": 81485,
      "text": "平平整整，",
      "token_start": 293,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 81740,
      "end_ms": 82455,
      "text": "不爬坡，",
      "token_start": 297,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 82960,
      "end_ms": 85845,
      "text": "累了就在廊桥边找张茶桌坐下。",
      "token_start": 300,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 86260,
      "end_ms": 88865,
      "text": "红印山房里常能赶上平淡，",
      "token_start": 313,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 89370,
      "end_ms": 90450,
      "text": "软软的无语，",
      "token_start": 324,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 90570,
      "end_ms": 91905,
      "text": "听不懂也不要紧。",
      "token_start": 329,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 92650,
      "end_ms": 93810,
      "text": "一杯茶的功夫，",
      "token_start": 336,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 94210,
      "end_ms": 97750,
      "text": "脚底下赶路的那股劲儿就谢了头。",
      "token_start": 342,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 97750,
      "end_ms": 98185,
      "text": "一战，",
      "token_start": 356,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 98730,
      "end_ms": 100635,
      "text": "先让您的脚慢下来。",
      "token_start": 358,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 101030,
      "end_ms": 101905,
      "text": "第九名，",
      "token_start": 366,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 102510,
      "end_ms": 103515,
      "text": "新市古镇，",
      "token_start": 369,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 103950,
      "end_ms": 105275,
      "text": "浙江湖州德清，",
      "token_start": 373,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 106010,
      "end_ms": 107165,
      "text": "他挨着运河，",
      "token_start": 379,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 107740,
      "end_ms": 114025,
      "text": "是个没怎么被包装过的水乡老镇镇上有几十座老石桥，",
      "token_start": 384,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 114600,
      "end_ms": 117965,
      "text": "一座接一座把河两岸连在一块儿，",
      "token_start": 407,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 118400,
      "end_ms": 122145,
      "text": "老辈子这儿靠养蚕麦斯过日子，",
      "token_start": 421,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 122580,
      "end_ms": 124755,
      "text": "镇子是被蚕丝养大的。",
      "token_start": 434,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 125280,
      "end_ms": 129075,
      "text": "您今天去找不着满街吆喝的铺子，",
      "token_start": 443,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 129570,
      "end_ms": 130775,
      "text": "青藻合不投，",
      "token_start": 457,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 131150,
      "end_ms": 132895,
      "text": "蹲着洗菜的老街坊，",
      "token_start": 462,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 133410,
      "end_ms": 136825,
      "text": "手里洗着嘴上聊着家长里短，",
      "token_start": 470,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 137320,
      "end_ms": 140625,
      "text": "河边茶滩的水壶一直冒热气。",
      "token_start": 482,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 141350,
      "end_ms": 142755,
      "text": "您端一杯坐下，",
      "token_start": 494,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 143280,
      "end_ms": 143980,
      "text": "没人催，",
      "token_start": 500,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 143980,
      "end_ms": 146470,
      "text": "您买东西也没人催，",
      "token_start": 503,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 146470,
      "end_ms": 147655,
      "text": "您赶下一站，",
      "token_start": 511,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 148070,
      "end_ms": 151930,
      "text": "别的阵子是摆出来给您看的心事，",
      "token_start": 516,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 151990,
      "end_ms": 154145,
      "text": "是人家自己在过日子。",
      "token_start": 530,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 154790,
      "end_ms": 157805,
      "text": "您走进去就像串门，",
      "token_start": 539,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 158430,
      "end_ms": 159305,
      "text": "不吵人，",
      "token_start": 547,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 159680,
      "end_ms": 161005,
      "text": "也不用拘着。",
      "token_start": 550,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 161380,
      "end_ms": 161985,
      "text": "第八名。",
      "token_start": 555,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 162510,
      "end_ms": 165775,
      "text": "青木川古镇陕西汉中宁强，",
      "token_start": 558,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 166620,
      "end_ms": 175095,
      "text": "他卧在陕西、甘肃、四川三省交界的秦巴山地里回龙场老街足足有八百多米长，",
      "token_start": 569,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 175700,
      "end_ms": 179175,
      "text": "远远看过去像一条青龙趴在金旗河畔，",
      "token_start": 601,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 179740,
      "end_ms": 184095,
      "text": "沿街保留着五十多座完整的四合院和汉船房。",
      "token_start": 617,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 184530,
      "end_ms": 187455,
      "text": "这里以前是陕南茶马贸易的要道，",
      "token_start": 636,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 188090,
      "end_ms": 190625,
      "text": "岁月把老街磨得油光发亮，",
      "token_start": 650,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 191040,
      "end_ms": 194095,
      "text": "星辰的商雾从河面上漫上来，",
      "token_start": 661,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 194710,
      "end_ms": 197945,
      "text": "木隔窗棂后面飘出早点的热气，",
      "token_start": 673,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 198650,
      "end_ms": 200795,
      "text": "既有西北秦岭的厚重，",
      "token_start": 686,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 201230,
      "end_ms": 203415,
      "text": "又有巴蜀水汽的润泽。",
      "token_start": 695,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 203800,
      "end_ms": 205185,
      "text": "没有喧闹的喇叭，",
      "token_start": 704,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 205660,
      "end_ms": 208945,
      "text": "走在石板路上能听见自己的脚步声，",
      "token_start": 711,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 209470,
      "end_ms": 211735,
      "text": "大山深处的踏实与自得，",
      "token_start": 726,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 212180,
      "end_ms": 213815,
      "text": "全在这一条老街里。",
      "token_start": 736,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 214200,
      "end_ms": 216765,
      "text": "第七名乾同古镇，",
      "token_start": 744,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 217540,
      "end_ms": 221995,
      "text": "浙江宁波、宁海这座古镇被群山环抱，",
      "token_start": 751,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 222630,
      "end_ms": 225170,
      "text": "里面完好保存着上千间。",
      "token_start": 766,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 225290,
      "end_ms": 229285,
      "text": "明清传统老屋乾通最绝的是八卦水系，",
      "token_start": 776,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 229650,
      "end_ms": 231045,
      "text": "引来白皙的活水，",
      "token_start": 792,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 231570,
      "end_ms": 237895,
      "text": "家家户户门前都躺着清泉路面全是用溪水里的鹅卵石，",
      "token_start": 799,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 238260,
      "end_ms": 242090,
      "text": "一块块铺平的踩上去圆润贴脚。",
      "token_start": 822,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 242510,
      "end_ms": 244670,
      "text": "这里宗族传了七百多年，",
      "token_start": 835,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 245350,
      "end_ms": 248149,
      "text": "家家户户讲究耕读传家，",
      "token_start": 845,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 248810,
      "end_ms": 250650,
      "text": "房门常年敞着，",
      "token_start": 855,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 251110,
      "end_ms": 252930,
      "text": "老人们坐在堂屋前，",
      "token_start": 861,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 253050,
      "end_ms": 254490,
      "text": "晒太阳编竹筐，",
      "token_start": 869,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 254930,
      "end_ms": 256330,
      "text": "推开门就是流水，",
      "token_start": 875,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 256830,
      "end_ms": 258490,
      "text": "推几步就是潺潺，",
      "token_start": 882,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 258610,
      "end_ms": 261250,
      "text": "全生人和山水挨着。",
      "token_start": 889,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 261270,
      "end_ms": 262210,
      "text": "过了七百年，",
      "token_start": 897,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 262870,
      "end_ms": 264490,
      "text": "您去走一趟步子，",
      "token_start": 902,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 264490,
      "end_ms": 266570,
      "text": "自己就慢下来了第六名。",
      "token_start": 909,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 266970,
      "end_ms": 271250,
      "text": "偏远古镇重庆北碚讲到这里，",
      "token_start": 919,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 271850,
      "end_ms": 274310,
      "text": "上级的分量就开始变重了。",
      "token_start": 931,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 274630,
      "end_ms": 277410,
      "text": "很多人以为巴蜀古镇都在深山，",
      "token_start": 942,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 277450,
      "end_ms": 279450,
      "text": "悬崖上可偏沿，",
      "token_start": 955,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 279630,
      "end_ms": 283990,
      "text": "偏偏依着黑水滩河顺着河道铺开一条老街，",
      "token_start": 961,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 284590,
      "end_ms": 287750,
      "text": "地势平展的很一点不费脚力，",
      "token_start": 979,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 288170,
      "end_ms": 290030,
      "text": "镇上立的好几十足，",
      "token_start": 991,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 290030,
      "end_ms": 291705,
      "text": "几百年的老黄爵树。",
      "token_start": 999,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 292550,
      "end_ms": 296150,
      "text": "树冠大的像把巨伞遮天蔽日，",
      "token_start": 1007,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 296990,
      "end_ms": 298190,
      "text": "几百张竹椅，",
      "token_start": 1019,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 298370,
      "end_ms": 300690,
      "text": "就顺着河滩一字排开，",
      "token_start": 1024,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 301450,
      "end_ms": 302490,
      "text": "一壶清茶，",
      "token_start": 1033,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 302590,
      "end_ms": 303570,
      "text": "只要几块钱，",
      "token_start": 1037,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 303930,
      "end_ms": 305910,
      "text": "河水清的能见底，",
      "token_start": 1042,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 306530,
      "end_ms": 308950,
      "text": "在树荫下哗啦啦流淌。",
      "token_start": 1049,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 309650,
      "end_ms": 311890,
      "text": "重庆夏天的太阳再险，",
      "token_start": 1058,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 312470,
      "end_ms": 314470,
      "text": "坐在这儿也凉风习习，",
      "token_start": 1067,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 314830,
      "end_ms": 315710,
      "text": "您走累了，",
      "token_start": 1076,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 315950,
      "end_ms": 317270,
      "text": "要一盅茶坐下，",
      "token_start": 1080,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 317710,
      "end_ms": 320690,
      "text": "满耳朵都是水生巴蜀的山，",
      "token_start": 1086,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 320750,
      "end_ms": 323520,
      "text": "再咸这的日子是平的。",
      "token_start": 1097,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 323920,
      "end_ms": 325620,
      "text": "从第十到第六名，",
      "token_start": 1106,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 326180,
      "end_ms": 328560,
      "text": "牧渎在廊桥边听平淡，",
      "token_start": 1113,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 329160,
      "end_ms": 330600,
      "text": "心是在河埠头，",
      "token_start": 1122,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 330680,
      "end_ms": 331840,
      "text": "洗菜过日子，",
      "token_start": 1128,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 332360,
      "end_ms": 333040,
      "text": "青木川，",
      "token_start": 1133,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 333100,
      "end_ms": 335560,
      "text": "在三省交界处藏着老街。",
      "token_start": 1136,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 336160,
      "end_ms": 338020,
      "text": "钱童饮清泉流过，",
      "token_start": 1146,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 338220,
      "end_ms": 342860,
      "text": "每家门前偏言在百岁老树下摆开竹椅。",
      "token_start": 1153,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 343220,
      "end_ms": 345960,
      "text": "可他们还不是最适合慢慢走的。",
      "token_start": 1169,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 346480,
      "end_ms": 349260,
      "text": "接下来第五道第一名更让人心动，",
      "token_start": 1182,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 349920,
      "end_ms": 351060,
      "text": "有一座水乡，",
      "token_start": 1196,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 351460,
      "end_ms": 355175,
      "text": "把三十六六座古石桥架在开阔大湖之上，",
      "token_start": 1201,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 355650,
      "end_ms": 357155,
      "text": "走一步看一处景，",
      "token_start": 1218,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 357860,
      "end_ms": 358985,
      "text": "还有一座古镇，",
      "token_start": 1225,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 359230,
      "end_ms": 362935,
      "text": "把明清老屋全浸在天青色的烟雨里，",
      "token_start": 1231,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 363490,
      "end_ms": 365795,
      "text": "白墙黑瓦连着青山，",
      "token_start": 1246,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 366180,
      "end_ms": 368245,
      "text": "可排在榜首的那座，",
      "token_start": 1254,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 368840,
      "end_ms": 369940,
      "text": "既不在江南，",
      "token_start": 1262,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 370260,
      "end_ms": 371545,
      "text": "也不在巴蜀。",
      "token_start": 1267,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 372180,
      "end_ms": 374465,
      "text": "他被大山紧紧护在怀里，",
      "token_start": 1272,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 375000,
      "end_ms": 380305,
      "text": "把数百年前茶马古道的古籍是原原本本活到了今天。",
      "token_start": 1282,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 380700,
      "end_ms": 381415,
      "text": "他是哪座？",
      "token_start": 1304,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 381860,
      "end_ms": 387455,
      "text": "他凭什么排在周庄乌镇前面下一集已经同步更新，",
      "token_start": 1308,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 388210,
      "end_ms": 389410,
      "text": "点开我的头像，",
      "token_start": 1329,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 389570,
      "end_ms": 392905,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1335,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 393180,
      "end_ms": 396875,
      "text": "看看谁才是中国最适合慢慢走的古镇。",
      "token_start": 1347,
      "token_end_exclusive": 1363
    }
  ],
