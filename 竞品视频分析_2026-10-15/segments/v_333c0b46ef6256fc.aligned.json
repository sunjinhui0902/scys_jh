{
  "video_id": "v_333c0b46ef6256fc",
  "duration_s": 493.47,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_333c0b46ef6256fc.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_333c0b46ef6256fc.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 5610,
      "text": "你知道中国有多少人放着国外高出几百倍的薪水，",
      "token_start": 0,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5710,
      "end_ms": 7950,
      "text": "不要回国钻深山，",
      "token_start": 21,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 8590,
      "end_ms": 10390,
      "text": "求人求了十几年，",
      "token_start": 28,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 10650,
      "end_ms": 13930,
      "text": "就为了给国家造一件大国重器吗？",
      "token_start": 35,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 14270,
      "end_ms": 16790,
      "text": "不是一个人是一群人。",
      "token_start": 49,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 17590,
      "end_ms": 18950,
      "text": "今天讲的这个人，",
      "token_start": 58,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 19130,
      "end_ms": 20210,
      "text": "他叫南仁东，",
      "token_start": 65,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 20630,
      "end_ms": 23610,
      "text": "他造的重器叫中国天眼。",
      "token_start": 70,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 24450,
      "end_ms": 25590,
      "text": "像他这样的人，",
      "token_start": 80,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 26010,
      "end_ms": 29755,
      "text": "一共四十位覆盖三十三个学科领域，",
      "token_start": 86,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 30310,
      "end_ms": 31730,
      "text": "都写在一本书里，",
      "token_start": 101,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 31730,
      "end_ms": 32530,
      "text": "国之脊梁，",
      "token_start": 108,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 32570,
      "end_ms": 34870,
      "text": "中国院士的科学人生，",
      "token_start": 112,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 34890,
      "end_ms": 37970,
      "text": "百年中国科学院学部科学人生。",
      "token_start": 121,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 38030,
      "end_ms": 41270,
      "text": "百年项目组编的四十个院士，",
      "token_start": 134,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 41710,
      "end_ms": 44370,
      "text": "四十个把命交给国家的故事，",
      "token_start": 146,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 44990,
      "end_ms": 47790,
      "text": "每一个都能让你心口发烫。",
      "token_start": 158,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 48530,
      "end_ms": 53530,
      "text": "每一集我们讲一九九三年南仁东在东京撂下一句话，",
      "token_start": 169,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 53730,
      "end_ms": 56830,
      "text": "我们也见一个这句话说出来，",
      "token_start": 191,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 57070,
      "end_ms": 58650,
      "text": "只要两秒钟，",
      "token_start": 203,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 58650,
      "end_ms": 66195,
      "text": "可为了兑现他这个男人在贵州的大山里求人求了十一年。",
      "token_start": 208,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 66710,
      "end_ms": 72780,
      "text": "今天这一集咱们就讲讲天眼最苦的那十一年。",
      "token_start": 232,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 73020,
      "end_ms": 74020,
      "text": "一九九四年，",
      "token_start": 251,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 74060,
      "end_ms": 78420,
      "text": "四十九岁的南仁东辞掉日本的高薪工作，",
      "token_start": 256,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 78720,
      "end_ms": 79715,
      "text": "回到祖国。",
      "token_start": 273,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 80310,
      "end_ms": 83135,
      "text": "他做的第一件事儿不是画图纸，",
      "token_start": 277,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 83500,
      "end_ms": 84340,
      "text": "不是开会，",
      "token_start": 290,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 84640,
      "end_ms": 85705,
      "text": "而是选址。",
      "token_start": 294,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 86200,
      "end_ms": 90435,
      "text": "你可能觉得找个地方见望远镜有什么难的，",
      "token_start": 298,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 91060,
      "end_ms": 91865,
      "text": "难真的难。",
      "token_start": 316,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 92230,
      "end_ms": 97290,
      "text": "五百米的大锅不是随便找个坑就能放它得远离城市。",
      "token_start": 320,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 97570,
      "end_ms": 99915,
      "text": "方圆几公里不能有电磁干扰，",
      "token_start": 342,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 100380,
      "end_ms": 102705,
      "text": "他得是一个天然的洼地，",
      "token_start": 354,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 103110,
      "end_ms": 105285,
      "text": "能兜住五百米的直径，",
      "token_start": 364,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 105660,
      "end_ms": 106360,
      "text": "地质的稳，",
      "token_start": 373,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 106460,
      "end_ms": 107480,
      "text": "岩层得硬，",
      "token_start": 377,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 107760,
      "end_ms": 109800,
      "text": "还得干燥少语，",
      "token_start": 381,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 109900,
      "end_ms": 110655,
      "text": "没干扰，",
      "token_start": 387,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 111350,
      "end_ms": 114575,
      "text": "一个条件都不能少差一个，",
      "token_start": 390,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 115350,
      "end_ms": 117125,
      "text": "整个工程就白干了，",
      "token_start": 401,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 118230,
      "end_ms": 118795,
      "text": "怎么办？",
      "token_start": 409,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 119130,
      "end_ms": 119705,
      "text": "爬山，",
      "token_start": 412,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 120780,
      "end_ms": 124430,
      "text": "一座一座的爬南仁东，",
      "token_start": 414,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 124430,
      "end_ms": 129815,
      "text": "带着团队把贵州、云南、广西的山翻了个遍，",
      "token_start": 423,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 130400,
      "end_ms": 132960,
      "text": "三百多座山头一百多个洼地，",
      "token_start": 440,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 133120,
      "end_ms": 134020,
      "text": "一个一个看，",
      "token_start": 452,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 134220,
      "end_ms": 135285,
      "text": "一个一个比对。",
      "token_start": 457,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 136380,
      "end_ms": 138495,
      "text": "我给你描述一下那个画面，",
      "token_start": 463,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 138940,
      "end_ms": 139545,
      "text": "没有路，",
      "token_start": 474,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 140710,
      "end_ms": 141830,
      "text": "拄着拐杖走，",
      "token_start": 477,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 141930,
      "end_ms": 142550,
      "text": "没有饭，",
      "token_start": 482,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 142770,
      "end_ms": 143890,
      "text": "背上干粮走，",
      "token_start": 485,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 143990,
      "end_ms": 144785,
      "text": "天黑了，",
      "token_start": 490,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 145150,
      "end_ms": 147005,
      "text": "就在山沟里凑合一宿。",
      "token_start": 493,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 147680,
      "end_ms": 151955,
      "text": "一个世界级的科学家活成了深山里的老行者。",
      "token_start": 502,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 152760,
      "end_ms": 153965,
      "text": "有同事回忆，",
      "token_start": 521,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 154390,
      "end_ms": 156265,
      "text": "南老看洼地的时候，",
      "token_start": 526,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 157610,
      "end_ms": 161195,
      "text": "不像总工程师像个地质队的老工人，",
      "token_start": 534,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 161710,
      "end_ms": 162870,
      "text": "一身旧衣服，",
      "token_start": 549,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 163090,
      "end_ms": 164325,
      "text": "鞋上全是泥，",
      "token_start": 554,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 164780,
      "end_ms": 165600,
      "text": "蹲在坑边，",
      "token_start": 559,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 165600,
      "end_ms": 167035,
      "text": "一看就是大半天，",
      "token_start": 563,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 167840,
      "end_ms": 171205,
      "text": "嘴里念叨着地形排水岩层，",
      "token_start": 570,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 171560,
      "end_ms": 174645,
      "text": "他看中的那个坑叫大窝囊。",
      "token_start": 581,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 174870,
      "end_ms": 175120,
      "text": "嗯，",
      "token_start": 592,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 175740,
      "end_ms": 177525,
      "text": "在贵州平塘，",
      "token_start": 593,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 178540,
      "end_ms": 183080,
      "text": "当时那个地方没水没电，",
      "token_start": 598,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 183200,
      "end_ms": 183815,
      "text": "没路，",
      "token_start": 608,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 184270,
      "end_ms": 186705,
      "text": "连当地人都觉得是块荒废之地。",
      "token_start": 610,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 187330,
      "end_ms": 191535,
      "text": "可就因为南仁东一句这儿行这块废地，",
      "token_start": 623,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 191870,
      "end_ms": 193795,
      "text": "后来成了全世界的焦点。",
      "token_start": 639,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 194470,
      "end_ms": 196025,
      "text": "他自己说过一句话，",
      "token_start": 649,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 196530,
      "end_ms": 198885,
      "text": "别人都有自己的大设备，",
      "token_start": 657,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 199480,
      "end_ms": 201885,
      "text": "我们没有我挺想试一试。",
      "token_start": 667,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 202880,
      "end_ms": 207525,
      "text": "这句话他念叨了十一年选址南还不是最难的，",
      "token_start": 677,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 208180,
      "end_ms": 209100,
      "text": "最难的是什么？",
      "token_start": 696,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 209100,
      "end_ms": 210300,
      "text": "是没人信你。",
      "token_start": 702,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 211200,
      "end_ms": 215295,
      "text": "从一九九四年到二零零五年整整十一年，",
      "token_start": 707,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 215740,
      "end_ms": 219225,
      "text": "南仁东干的最多的一件事就是求人，",
      "token_start": 724,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 219840,
      "end_ms": 221535,
      "text": "求上级批经费，",
      "token_start": 739,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 221840,
      "end_ms": 223280,
      "text": "求专家来参与，",
      "token_start": 745,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 223560,
      "end_ms": 225245,
      "text": "求各个部门支持。",
      "token_start": 751,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 226070,
      "end_ms": 227765,
      "text": "他逢人就讲大赦殿，",
      "token_start": 758,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 228160,
      "end_ms": 228540,
      "text": "讲的，",
      "token_start": 766,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 228540,
      "end_ms": 229505,
      "text": "口干舌燥，",
      "token_start": 768,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 229990,
      "end_ms": 230410,
      "text": "讲的，",
      "token_start": 772,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 230410,
      "end_ms": 231790,
      "text": "有些人一见他来，",
      "token_start": 774,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 231790,
      "end_ms": 233370,
      "text": "就想躲他自己。",
      "token_start": 781,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 233370,
      "end_ms": 235485,
      "text": "后来开玩笑说那几年，",
      "token_start": 787,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 235900,
      "end_ms": 238255,
      "text": "我把全世界的马屁都拍了一遍。",
      "token_start": 796,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 238780,
      "end_ms": 239965,
      "text": "你听听这句话，",
      "token_start": 809,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 240400,
      "end_ms": 241845,
      "text": "一个搞科研的，",
      "token_start": 815,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 242340,
      "end_ms": 245015,
      "text": "硬生生把自己逼成了推销员。",
      "token_start": 821,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 245460,
      "end_ms": 246525,
      "text": "他心里清楚，",
      "token_start": 833,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 246870,
      "end_ms": 248085,
      "text": "光有技术不行，",
      "token_start": 838,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 248680,
      "end_ms": 253020,
      "text": "你得先让所有人相信中国能建成这个东西，",
      "token_start": 844,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 253180,
      "end_ms": 258435,
      "text": "可人家凭什么信你一个连大型的望远镜都没造过的国家？",
      "token_start": 862,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 258910,
      "end_ms": 261135,
      "text": "那几年国际上什么态度？",
      "token_start": 886,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 261650,
      "end_ms": 262645,
      "text": "二零零六年，",
      "token_start": 896,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 263070,
      "end_ms": 265685,
      "text": "fast项目召开国际评估会，",
      "token_start": 901,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 266060,
      "end_ms": 268740,
      "text": "评审专家研究了一圈结论，",
      "token_start": 911,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 268960,
      "end_ms": 270745,
      "text": "技术上可行，",
      "token_start": 922,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 271560,
      "end_ms": 273045,
      "text": "但是国际上不支持。",
      "token_start": 927,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 273510,
      "end_ms": 275370,
      "text": "有些国家更直白的说，",
      "token_start": 935,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 275670,
      "end_ms": 277430,
      "text": "这么大的项目放在中国，",
      "token_start": 944,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 277650,
      "end_ms": 278835,
      "text": "我们信不过，",
      "token_start": 954,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 279300,
      "end_ms": 281140,
      "text": "你看难的不是技术，",
      "token_start": 959,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 281360,
      "end_ms": 282195,
      "text": "是偏见。",
      "token_start": 967,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 282700,
      "end_ms": 283940,
      "text": "南仁宗没有退路。",
      "token_start": 970,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 284100,
      "end_ms": 284520,
      "text": "他说，",
      "token_start": 977,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 284820,
      "end_ms": 286540,
      "text": "既然国际上不支持，",
      "token_start": 979,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 286680,
      "end_ms": 287835,
      "text": "那我们就自己干，",
      "token_start": 987,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 288860,
      "end_ms": 293635,
      "text": "自己干意味着什么经费自己愁，",
      "token_start": 994,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 293980,
      "end_ms": 296330,
      "text": "技术自己工所有，",
      "token_start": 1007,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 296330,
      "end_ms": 297615,
      "text": "难题自己扛，",
      "token_start": 1014,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 298470,
      "end_ms": 299605,
      "text": "他早就把命。",
      "token_start": 1019,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 301180,
      "end_ms": 302175,
      "text": "都压上去了，",
      "token_start": 1024,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 304180,
      "end_ms": 307100,
      "text": "你可能觉得这个人怎么这么硬，",
      "token_start": 1029,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 307500,
      "end_ms": 309440,
      "text": "他真的一点都不怕吗？",
      "token_start": 1042,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 310500,
      "end_ms": 310740,
      "text": "来，",
      "token_start": 1051,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 310900,
      "end_ms": 312240,
      "text": "我给你讲一个画面。",
      "token_start": 1052,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 313380,
      "end_ms": 314340,
      "text": "一天深夜，",
      "token_start": 1060,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 315220,
      "end_ms": 319500,
      "text": "南仁东一个人在办公室里哭了，",
      "token_start": 1064,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 320720,
      "end_ms": 325180,
      "text": "一个六十多岁内心硬的像铁的老爷子，",
      "token_start": 1077,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 325400,
      "end_ms": 326320,
      "text": "压低声音，",
      "token_start": 1093,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 326620,
      "end_ms": 328060,
      "text": "哭的肩膀发抖。",
      "token_start": 1097,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 328520,
      "end_ms": 329600,
      "text": "经费的压力，",
      "token_start": 1103,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 329860,
      "end_ms": 330860,
      "text": "技术的压力，",
      "token_start": 1108,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 330880,
      "end_ms": 334250,
      "text": "无数人的期望全压在他一个人身上上，",
      "token_start": 1113,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 334530,
      "end_ms": 336210,
      "text": "他也有扛不住的时候。",
      "token_start": 1129,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 336650,
      "end_ms": 337530,
      "text": "可第二天，",
      "token_start": 1138,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 337770,
      "end_ms": 339630,
      "text": "他照常出现在办公室，",
      "token_start": 1142,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 340010,
      "end_ms": 342070,
      "text": "照常笑呵呵的跟人打招呼，",
      "token_start": 1151,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 342670,
      "end_ms": 345490,
      "text": "没人知道前一晚发生了什么。",
      "token_start": 1162,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 345730,
      "end_ms": 347990,
      "text": "你以为只有精神的压力，",
      "token_start": 1174,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 348310,
      "end_ms": 350750,
      "text": "还有身体上的那十一年？",
      "token_start": 1184,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 351110,
      "end_ms": 351950,
      "text": "为了省钱，",
      "token_start": 1194,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 352230,
      "end_ms": 353910,
      "text": "他出差跟人挤一张床。",
      "token_start": 1198,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 354750,
      "end_ms": 357570,
      "text": "有一次屁股上长了个大疖子，",
      "token_start": 1207,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 357830,
      "end_ms": 359665,
      "text": "疼的走路都变了形，",
      "token_start": 1219,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 360200,
      "end_ms": 361440,
      "text": "他硬挺着不去，",
      "token_start": 1227,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 361460,
      "end_ms": 362895,
      "text": "医院怕耽误时间，",
      "token_start": 1233,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 364320,
      "end_ms": 366930,
      "text": "最后接着破了血，",
      "token_start": 1240,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 366970,
      "end_ms": 368855,
      "text": "顺着腿流到地板上，",
      "token_start": 1247,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 369490,
      "end_ms": 372945,
      "text": "同时才发现硬把他拖进了医院。",
      "token_start": 1255,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 373910,
      "end_ms": 375645,
      "text": "同时红着眼眶问他，",
      "token_start": 1268,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 376650,
      "end_ms": 380095,
      "text": "南老你就不能对自己好一点吗？",
      "token_start": 1276,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 380510,
      "end_ms": 382625,
      "text": "他说时间不够用啊，",
      "token_start": 1289,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 383700,
      "end_ms": 386455,
      "text": "二零零七年fast正式立项，",
      "token_start": 1297,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 387250,
      "end_ms": 389870,
      "text": "二零一一年三月开工嗯，",
      "token_start": 1307,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 390360,
      "end_ms": 393955,
      "text": "二零一三年十二月五百米的圈粮合龙，",
      "token_start": 1317,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 395760,
      "end_ms": 400530,
      "text": "二零一四年六座百米高的溃圆塔立了起来。",
      "token_start": 1333,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 400610,
      "end_ms": 401650,
      "text": "二零一五年，",
      "token_start": 1351,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 401710,
      "end_ms": 404065,
      "text": "天眼的索网胜利合拢，",
      "token_start": 1356,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 404790,
      "end_ms": 410525,
      "text": "那张王是全世界精度最高、跨度最大的索网结构。",
      "token_start": 1365,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 411240,
      "end_ms": 412405,
      "text": "到了这个时候，",
      "token_start": 1385,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 412890,
      "end_ms": 414890,
      "text": "当年那句被当成笑话的，",
      "token_start": 1391,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 414890,
      "end_ms": 418575,
      "text": "我们也见一个已经快要变成现实了。",
      "token_start": 1401,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 419100,
      "end_ms": 422265,
      "text": "工地上的人越来越多天眼的样子，",
      "token_start": 1416,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 422570,
      "end_ms": 424755,
      "text": "一天比一天清晰起来。",
      "token_start": 1430,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 425200,
      "end_ms": 426855,
      "text": "可所有人不知道的是，",
      "token_start": 1439,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 427290,
      "end_ms": 429905,
      "text": "命运正在最后一程，",
      "token_start": 1448,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 430400,
      "end_ms": 432245,
      "text": "跟他开一个天大的玩笑。",
      "token_start": 1456,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 434470,
      "end_ms": 435470,
      "text": "二零一五年，",
      "token_start": 1466,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 435630,
      "end_ms": 439145,
      "text": "天眼工程进入最关键的攻坚期，",
      "token_start": 1471,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 440110,
      "end_ms": 441335,
      "text": "也就在这一年，",
      "token_start": 1484,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 441940,
      "end_ms": 445715,
      "text": "南仁东被查出肺癌晚期。",
      "token_start": 1490,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 446440,
      "end_ms": 447400,
      "text": "消息传开，",
      "token_start": 1500,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 447420,
      "end_ms": 447855,
      "text": "那天，",
      "token_start": 1504,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 448690,
      "end_ms": 450150,
      "text": "工地上安静了，",
      "token_start": 1506,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 450150,
      "end_ms": 454910,
      "text": "很久没人敢相信他，",
      "token_start": 1512,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 454910,
      "end_ms": 455815,
      "text": "自己的身体，",
      "token_start": 1520,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 456060,
      "end_ms": 456880,
      "text": "他最清楚，",
      "token_start": 1525,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 457100,
      "end_ms": 457975,
      "text": "可他没有停。",
      "token_start": 1529,
      "token_end_exclusive": 1534
    },
    {
      "start_ms": 458960,
      "end_ms": 461355,
      "text": "他是怎么撑过最后两年的？",
      "token_start": 1534,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 462070,
      "end_ms": 468255,
      "text": "可为什么医生都想不通一个病成那样的人还能天天泡在工地上？",
      "token_start": 1545,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 468920,
      "end_ms": 470775,
      "text": "点个关注下一集。",
      "token_start": 1572,
      "token_end_exclusive": 1579
    },
    {
      "start_ms": 471090,
      "end_ms": 474215,
      "text": "我讲男老生命里最后那段时光，",
      "token_start": 1579,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 475330,
      "end_ms": 481765,
      "text": "如果你也被这个求了十一年人的老爷子触动到了点赞、收藏、转发，",
      "token_start": 1592,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 482920,
      "end_ms": 486105,
      "text": "让更多人知道天眼的背后，",
      "token_start": 1619,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 487290,
      "end_ms": 489965,
      "text": "有一个在山里求了十一年的人，",
      "token_start": 1630,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 491380,
      "end_ms": 493315,
      "text": "连医院都不敢去的老头。",
      "token_start": 1643,
      "token_end_exclusive": 1653
    }
  ],
