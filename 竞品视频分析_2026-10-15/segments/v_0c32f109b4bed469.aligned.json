  "segments": [
    {
      "start_ms": 150,
      "end_ms": 2190,
      "text": "原来睡觉就是最好的保养，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2490,
      "end_ms": 4250,
      "text": "你一天比别人多睡一个小时，",
      "token_start": 11,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 4250,
      "end_ms": 7830,
      "text": "一周就比别人多睡一天一个月就比别人多睡四天，",
      "token_start": 23,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 7830,
      "end_ms": 10370,
      "text": "一年下来就比别人多睡四十八天。",
      "token_start": 44,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 11070,
      "end_ms": 12750,
      "text": "如果你睡不够或者睡不好，",
      "token_start": 58,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 13010,
      "end_ms": 14730,
      "text": "哪怕你天天蹲在健身房，",
      "token_start": 69,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 14970,
      "end_ms": 17110,
      "text": "或者是做什么保养都没用。",
      "token_start": 79,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 17350,
      "end_ms": 18070,
      "text": "你要记住，",
      "token_start": 90,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 18350,
      "end_ms": 19330,
      "text": "睡觉高于玩乐，",
      "token_start": 94,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 19470,
      "end_ms": 20170,
      "text": "高于吃饭，",
      "token_start": 100,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 20170,
      "end_ms": 21950,
      "text": "高于工作高于一切。",
      "token_start": 104,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 22450,
      "end_ms": 23630,
      "text": "谁影响你睡觉，",
      "token_start": 112,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 23850,
      "end_ms": 24870,
      "text": "你就远离谁，",
      "token_start": 118,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 25230,
      "end_ms": 26550,
      "text": "咱就睡回笼觉，",
      "token_start": 123,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 26830,
      "end_ms": 27630,
      "text": "睡美容觉，",
      "token_start": 129,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 27970,
      "end_ms": 29130,
      "text": "睡自然醒的觉，",
      "token_start": 133,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 29410,
      "end_ms": 30480,
      "text": "只要睡好了好了觉，",
      "token_start": 139,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 30760,
      "end_ms": 33560,
      "text": "就可以减少人生百分之九十的烦恼。",
      "token_start": 147,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 33880,
      "end_ms": 35460,
      "text": "睡觉就是修复受损细胞，",
      "token_start": 162,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 35600,
      "end_ms": 36640,
      "text": "保养五脏六腑，",
      "token_start": 172,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 36960,
      "end_ms": 39395,
      "text": "延长寿命最好的方式。",
      "token_start": 178,
      "token_end_exclusive": 187
    }
  ],
