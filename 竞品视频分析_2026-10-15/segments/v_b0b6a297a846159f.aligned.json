{
  "video_id": "v_b0b6a297a846159f",
  "duration_s": 221.54,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b0b6a297a846159f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b0b6a297a846159f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 1230,
      "text": "会说话是优势，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1470,
      "end_ms": 2850,
      "text": "会接话才是本事。",
      "token_start": 6,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3070,
      "end_ms": 5090,
      "text": "一个会接话的人到底有多厉害？",
      "token_start": 13,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5090,
      "end_ms": 6450,
      "text": "领导说鱼是好鱼，",
      "token_start": 26,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 6530,
      "end_ms": 7590,
      "text": "可惜就是刺多。",
      "token_start": 33,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 7610,
      "end_ms": 8050,
      "text": "怎么说？",
      "token_start": 39,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 8250,
      "end_ms": 8550,
      "text": "领导，",
      "token_start": 42,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 8550,
      "end_ms": 8950,
      "text": "您看，",
      "token_start": 44,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 9250,
      "end_ms": 10330,
      "text": "鱼虽然刺多，",
      "token_start": 46,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 10390,
      "end_ms": 13110,
      "text": "但主心骨只有一根心腹是没有刺的。",
      "token_start": 51,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 13110,
      "end_ms": 13570,
      "text": "领导说，",
      "token_start": 66,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 13570,
      "end_ms": 15290,
      "text": "不喝就是看不起我怎么说？",
      "token_start": 69,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 15530,
      "end_ms": 15950,
      "text": "领导，",
      "token_start": 80,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 16290,
      "end_ms": 17330,
      "text": "我不是看不起您，",
      "token_start": 82,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 17610,
      "end_ms": 18590,
      "text": "我是看不起病。",
      "token_start": 89,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 18970,
      "end_ms": 19970,
      "text": "领导说来这么晚，",
      "token_start": 95,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 19970,
      "end_ms": 20950,
      "text": "只能吃剩菜了吧。",
      "token_start": 102,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 20950,
      "end_ms": 21370,
      "text": "怎么说，",
      "token_start": 109,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 21450,
      "end_ms": 23310,
      "text": "领导饭在哪儿我都能吃，",
      "token_start": 112,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 23470,
      "end_ms": 25650,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 122,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 25650,
      "end_ms": 27290,
      "text": "能赶上已经是我的运气了。",
      "token_start": 135,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 27290,
      "end_ms": 27750,
      "text": "领导说，",
      "token_start": 146,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 27750,
      "end_ms": 29010,
      "text": "这鸭子是好鸭子，",
      "token_start": 149,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 29150,
      "end_ms": 29875,
      "text": "就是嘴硬。",
      "token_start": 156,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 30060,
      "end_ms": 32340,
      "text": "怎么说嘴硬，",
      "token_start": 160,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 32500,
      "end_ms": 33880,
      "text": "才守得住秘密，",
      "token_start": 165,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 34040,
      "end_ms": 34600,
      "text": "领导说，",
      "token_start": 171,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 34680,
      "end_ms": 35980,
      "text": "你这菜点的也太多了。",
      "token_start": 174,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 35980,
      "end_ms": 36420,
      "text": "怎么说，",
      "token_start": 183,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 36740,
      "end_ms": 38500,
      "text": "领导菜点的再多，",
      "token_start": 186,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 38580,
      "end_ms": 41360,
      "text": "也比不上平时您对我的照顾多这杯酒，",
      "token_start": 193,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 41400,
      "end_ms": 42140,
      "text": "我先敬您。",
      "token_start": 209,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 42240,
      "end_ms": 42700,
      "text": "领导说，",
      "token_start": 213,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 42700,
      "end_ms": 43660,
      "text": "今天让你破费了。",
      "token_start": 216,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 43660,
      "end_ms": 44120,
      "text": "怎么说？",
      "token_start": 223,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 44400,
      "end_ms": 44840,
      "text": "领导，",
      "token_start": 226,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 45400,
      "end_ms": 46780,
      "text": "您说这些您能来，",
      "token_start": 228,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 46780,
      "end_ms": 47520,
      "text": "就是我的荣幸，",
      "token_start": 235,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 47780,
      "end_ms": 49560,
      "text": "以后还有很多地方向您请教，",
      "token_start": 241,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 49560,
      "end_ms": 51780,
      "text": "不是领导说你酒量挺好的呀。",
      "token_start": 253,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 51780,
      "end_ms": 52220,
      "text": "怎么说？",
      "token_start": 265,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 52500,
      "end_ms": 52880,
      "text": "领导，",
      "token_start": 268,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 52880,
      "end_ms": 53940,
      "text": "您可抬举我了，",
      "token_start": 270,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 53940,
      "end_ms": 55120,
      "text": "我平时真不太能喝，",
      "token_start": 276,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 55320,
      "end_ms": 56800,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 284,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 56800,
      "end_ms": 57400,
      "text": "高兴啊，",
      "token_start": 295,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 57480,
      "end_ms": 58960,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 298,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 59160,
      "end_ms": 59580,
      "text": "领导说，",
      "token_start": 308,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 59580,
      "end_ms": 60830,
      "text": "这偶像藕是好藕啊，",
      "token_start": 311,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 60830,
      "end_ms": 61910,
      "text": "就是心眼太多了。",
      "token_start": 319,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 61910,
      "end_ms": 62370,
      "text": "怎么说？",
      "token_start": 326,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 62570,
      "end_ms": 64590,
      "text": "领导藕虽然心眼多，",
      "token_start": 329,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 64850,
      "end_ms": 66490,
      "text": "但也是您的下酒菜啊。",
      "token_start": 337,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 66570,
      "end_ms": 67070,
      "text": "领导说，",
      "token_start": 346,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 67070,
      "end_ms": 68150,
      "text": "你个子是真高比，",
      "token_start": 349,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 68150,
      "end_ms": 68870,
      "text": "我还高一头呢。",
      "token_start": 356,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 68870,
      "end_ms": 71370,
      "text": "怎么说个高是为了给领导探路走，",
      "token_start": 362,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 71490,
      "end_ms": 73395,
      "text": "哪儿不还是得听领导指挥吗？",
      "token_start": 376,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 75500,
      "end_ms": 76140,
      "text": "领导说，",
      "token_start": 388,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 76180,
      "end_ms": 77940,
      "text": "我真不怎么喜欢你怎么说，",
      "token_start": 391,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 78240,
      "end_ms": 80460,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 402,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 80460,
      "end_ms": 83030,
      "text": "我领导的格局值得我们学习。",
      "token_start": 415,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 83110,
      "end_ms": 84890,
      "text": "领导说你最近表现不错啊，",
      "token_start": 427,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 84910,
      "end_ms": 86550,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 438,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 86550,
      "end_ms": 87630,
      "text": "我得提前敬你一杯。",
      "token_start": 451,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 87630,
      "end_ms": 88070,
      "text": "怎么说？",
      "token_start": 459,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 88410,
      "end_ms": 89190,
      "text": "听这意思，",
      "token_start": 462,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 89290,
      "end_ms": 90610,
      "text": "领导是要高升了呀，",
      "token_start": 466,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 90710,
      "end_ms": 92170,
      "text": "我得提前敬领导一杯。",
      "token_start": 474,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 92210,
      "end_ms": 92770,
      "text": "领导说，",
      "token_start": 483,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 92850,
      "end_ms": 93910,
      "text": "怎么你这一入职，",
      "token_start": 486,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 94030,
      "end_ms": 95450,
      "text": "我刚种的花就死了。",
      "token_start": 493,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 95450,
      "end_ms": 96950,
      "text": "怎么说花开富贵嘛，",
      "token_start": 501,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 96970,
      "end_ms": 98505,
      "text": "花开过了就剩富贵了。",
      "token_start": 509,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 98750,
      "end_ms": 100735,
      "text": "看来领导您啊要发大财了，",
      "token_start": 518,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 101830,
      "end_ms": 102690,
      "text": "给领导倒酒，",
      "token_start": 529,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 102730,
      "end_ms": 103750,
      "text": "刚好只剩半杯了。",
      "token_start": 534,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 103750,
      "end_ms": 104190,
      "text": "领导说，",
      "token_start": 541,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 104190,
      "end_ms": 105330,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 544,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 105330,
      "end_ms": 105770,
      "text": "怎么说？",
      "token_start": 555,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 105930,
      "end_ms": 107590,
      "text": "领导美满美满，",
      "token_start": 558,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 107750,
      "end_ms": 109010,
      "text": "代表幸福美满，",
      "token_start": 564,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 109130,
      "end_ms": 111395,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 570,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 111910,
      "end_ms": 112450,
      "text": "领导说，",
      "token_start": 584,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 112470,
      "end_ms": 113470,
      "text": "年轻就是好啊，",
      "token_start": 587,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 113550,
      "end_ms": 113990,
      "text": "怎么说，",
      "token_start": 593,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 114070,
      "end_ms": 115470,
      "text": "年轻就是还不够沉稳，",
      "token_start": 596,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 115650,
      "end_ms": 116850,
      "text": "还要向您多学习，",
      "token_start": 605,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 117090,
      "end_ms": 118445,
      "text": "我们才能变得更优秀。",
      "token_start": 612,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 118810,
      "end_ms": 119250,
      "text": "领导说，",
      "token_start": 621,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 119270,
      "end_ms": 120570,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 624,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 120570,
      "end_ms": 120990,
      "text": "怎么说？",
      "token_start": 634,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 121270,
      "end_ms": 123590,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 637,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 123810,
      "end_ms": 125965,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 650,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 126600,
      "end_ms": 127720,
      "text": "领导说来就来，",
      "token_start": 663,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 127720,
      "end_ms": 128580,
      "text": "带什么礼物啊，",
      "token_start": 669,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 128580,
      "end_ms": 129900,
      "text": "都不是外人怎么说，",
      "token_start": 675,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 130180,
      "end_ms": 131660,
      "text": "领导您都说了，",
      "token_start": 683,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 131660,
      "end_ms": 132360,
      "text": "不是外人，",
      "token_start": 689,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 132500,
      "end_ms": 134160,
      "text": "我一直都把您当长辈看，",
      "token_start": 693,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 134300,
      "end_ms": 136660,
      "text": "哪有晚辈看长辈空手来的道理啊。",
      "token_start": 703,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 136660,
      "end_ms": 138780,
      "text": "当领导在客户面前夸你怎么说，",
      "token_start": 717,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 139020,
      "end_ms": 139840,
      "text": "火车跑得快，",
      "token_start": 730,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 139860,
      "end_ms": 140800,
      "text": "全靠车头带，",
      "token_start": 735,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 140940,
      "end_ms": 142640,
      "text": "还请领导继续培养提携。",
      "token_start": 740,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 142700,
      "end_ms": 144260,
      "text": "当领导夸你菜点的不错，",
      "token_start": 750,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 144280,
      "end_ms": 144700,
      "text": "怎么说？",
      "token_start": 760,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 145020,
      "end_ms": 147120,
      "text": "多谢领导赏识我点的只是菜，",
      "token_start": 763,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 147240,
      "end_ms": 148140,
      "text": "而领导您点的，",
      "token_start": 775,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 148140,
      "end_ms": 149665,
      "text": "可是公司前行的灯塔，",
      "token_start": 781,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 149960,
      "end_ms": 151160,
      "text": "别人夸你衣服真好看。",
      "token_start": 790,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 151180,
      "end_ms": 151620,
      "text": "怎么说？",
      "token_start": 799,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 151920,
      "end_ms": 152425,
      "text": "谢谢。",
      "token_start": 802,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 152630,
      "end_ms": 153630,
      "text": "因为今天要见你，",
      "token_start": 804,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 153630,
      "end_ms": 154795,
      "text": "所以穿的好看一点。",
      "token_start": 811,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 155070,
      "end_ms": 155485,
      "text": "老师，",
      "token_start": 819,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 155960,
      "end_ms": 157780,
      "text": "你是怎么做到见招拆招，",
      "token_start": 821,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 158060,
      "end_ms": 159140,
      "text": "既不显得拍马屁，",
      "token_start": 831,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 159380,
      "end_ms": 161220,
      "text": "还能让领导听了这么舒服的。",
      "token_start": 838,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 161220,
      "end_ms": 163235,
      "text": "因为我一直在看这本闲谈高手，",
      "token_start": 850,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 163690,
      "end_ms": 166210,
      "text": "你要知道这个世界上谁都不会拒绝，",
      "token_start": 863,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 166210,
      "end_ms": 167150,
      "text": "那些会说话，",
      "token_start": 878,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 167150,
      "end_ms": 168050,
      "text": "会来事儿的人。",
      "token_start": 883,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 168150,
      "end_ms": 169230,
      "text": "假如你不爱说话，",
      "token_start": 889,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 169310,
      "end_ms": 170010,
      "text": "不爱争辩，",
      "token_start": 896,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 170010,
      "end_ms": 170730,
      "text": "也不爱出门，",
      "token_start": 900,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 170830,
      "end_ms": 171870,
      "text": "甚至恐惧社交，",
      "token_start": 905,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 172130,
      "end_ms": 173950,
      "text": "推荐你读完这本闲谈高手，",
      "token_start": 911,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 174070,
      "end_ms": 176110,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 922,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 176110,
      "end_ms": 177290,
      "text": "你每天就看两页，",
      "token_start": 934,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 177490,
      "end_ms": 178790,
      "text": "每一个场景慢慢练，",
      "token_start": 941,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 178970,
      "end_ms": 181485,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 949,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 182000,
      "end_ms": 183220,
      "text": "在这本书里有一句话，",
      "token_start": 964,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 183220,
      "end_ms": 184060,
      "text": "我特别欣赏，",
      "token_start": 973,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 184120,
      "end_ms": 184260,
      "text": "他，",
      "token_start": 978,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 184260,
      "end_ms": 186200,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 979,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 186260,
      "end_ms": 186800,
      "text": "你可以回，",
      "token_start": 991,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 187040,
      "end_ms": 188060,
      "text": "那是不优秀点，",
      "token_start": 995,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 188080,
      "end_ms": 189240,
      "text": "怎么能和你做朋友呢？",
      "token_start": 1001,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 189240,
      "end_ms": 190680,
      "text": "当有人说你真聪明，",
      "token_start": 1010,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 190700,
      "end_ms": 192180,
      "text": "你就回近朱者赤，",
      "token_start": 1018,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 192360,
      "end_ms": 193240,
      "text": "和你在一起啊，",
      "token_start": 1025,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 193240,
      "end_ms": 195600,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 1031,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 195600,
      "end_ms": 196685,
      "text": "你就回领导，",
      "token_start": 1046,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 196950,
      "end_ms": 198030,
      "text": "这都是我应该做的。",
      "token_start": 1051,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 198030,
      "end_ms": 199130,
      "text": "强将手下无弱兵，",
      "token_start": 1059,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 199210,
      "end_ms": 200450,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 1066,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 200470,
      "end_ms": 201650,
      "text": "当我看到这段的时候，",
      "token_start": 1075,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 201650,
      "end_ms": 203530,
      "text": "这个真是让我欲解心开啊。",
      "token_start": 1084,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 203670,
      "end_ms": 204904,
      "text": "每一句都很有意思，",
      "token_start": 1095,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 205250,
      "end_ms": 208230,
      "text": "就是手把手教我们在不同的场景之下应该怎么说。",
      "token_start": 1103,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 208450,
      "end_ms": 211195,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1124,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 211370,
      "end_ms": 212550,
      "text": "你就放心的拿回去看，",
      "token_start": 1142,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 212830,
      "end_ms": 214150,
      "text": "就是一句一句的教你，",
      "token_start": 1151,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 214250,
      "end_ms": 216410,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 1160,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 216490,
      "end_ms": 217490,
      "text": "但凡学会三分，",
      "token_start": 1172,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 217630,
      "end_ms": 219685,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 1178,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 219930,
      "end_ms": 221435,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 1192,
      "token_end_exclusive": 1204
    }
