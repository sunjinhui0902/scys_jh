{
  "video_id": "v_a7626c5b80217c24",
  "duration_s": 419.167007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_a7626c5b80217c24.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_a7626c5b80217c24.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 3990,
      "text": "您知道中国深秋最惊艳的大地奇观是哪一处吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4410,
      "end_ms": 9310,
      "text": "有人说是四川九寨沟一百多处海子五彩斑斓。",
      "token_start": 20,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9910,
      "end_ms": 13930,
      "text": "有人说是内蒙古额济纳数万株千年胡杨，",
      "token_start": 39,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 14190,
      "end_ms": 15110,
      "text": "金光冲天，",
      "token_start": 56,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 15570,
      "end_ms": 16370,
      "text": "对不住了，",
      "token_start": 60,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 16730,
      "end_ms": 18350,
      "text": "九寨沟排不进榜首，",
      "token_start": 64,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 19090,
      "end_ms": 21050,
      "text": "胡杨连前五都进不了，",
      "token_start": 72,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21590,
      "end_ms": 25650,
      "text": "真正排在榜首的那处奇观不在中原，",
      "token_start": 81,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 25670,
      "end_ms": 29550,
      "text": "腹地也不在烟雨江南不年，",
      "token_start": 96,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 29590,
      "end_ms": 30600,
      "text": "只有十来天，",
      "token_start": 107,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 31220,
      "end_ms": 34060,
      "text": "整片湖水会自己换上一身，",
      "token_start": 112,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 34180,
      "end_ms": 35620,
      "text": "不像人间的颜色。",
      "token_start": 123,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 36180,
      "end_ms": 41480,
      "text": "今天咱们就来盘点中国十大最惊艳的深秋大地奇观。",
      "token_start": 130,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 41820,
      "end_ms": 42620,
      "text": "话不多说，",
      "token_start": 152,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 43000,
      "end_ms": 44360,
      "text": "茶给您起好了，",
      "token_start": 156,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 44780,
      "end_ms": 47340,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 162,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 47660,
      "end_ms": 49860,
      "text": "咱们这就开讲第十名。",
      "token_start": 172,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 50300,
      "end_ms": 53920,
      "text": "辽宁盘锦红海滩辽河入海口，",
      "token_start": 181,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 54580,
      "end_ms": 56380,
      "text": "很多人以为一入深秋，",
      "token_start": 193,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 57120,
      "end_ms": 58480,
      "text": "大地不是金黄，",
      "token_start": 202,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 58560,
      "end_ms": 59855,
      "text": "就是落叶枯黄。",
      "token_start": 208,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 60130,
      "end_ms": 60320,
      "text": "嗯，",
      "token_start": 214,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 60520,
      "end_ms": 63615,
      "text": "可辽宁盘锦彻底打破了这种成见。",
      "token_start": 215,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 64080,
      "end_ms": 69110,
      "text": "这片辽河入海口的湿地广达上万亩放眼望去，",
      "token_start": 229,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 69210,
      "end_ms": 71925,
      "text": "是一片无边无际的血红地毯，",
      "token_start": 248,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 72360,
      "end_ms": 75765,
      "text": "成千上万株纤弱微小的剪蓬草，",
      "token_start": 260,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 76100,
      "end_ms": 79405,
      "text": "在又咸又苦的泥泞海滩里扎下根。",
      "token_start": 273,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 79880,
      "end_ms": 80700,
      "text": "借着深秋，",
      "token_start": 287,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 80700,
      "end_ms": 85965,
      "text": "海风硬生生憋出全中国最浓烈纯正的鲜红。",
      "token_start": 291,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 86380,
      "end_ms": 89380,
      "text": "您光脚往泥滩边上一站衔，",
      "token_start": 309,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 89520,
      "end_ms": 91645,
      "text": "湿海风扑面吹来，",
      "token_start": 320,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 92020,
      "end_ms": 94865,
      "text": "头顶上是翻飞起伏的白鹤，",
      "token_start": 327,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 95320,
      "end_ms": 97735,
      "text": "脚下是烧到天边的红霞，",
      "token_start": 338,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 98140,
      "end_ms": 100215,
      "text": "一株微不足道的小草，",
      "token_start": 348,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 100780,
      "end_ms": 105725,
      "text": "能在最苦涩的盐碱淤泥里活出惊天动地的风骨。",
      "token_start": 357,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 106420,
      "end_ms": 109195,
      "text": "您说这算不算大自然的绝唱？",
      "token_start": 377,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 109540,
      "end_ms": 110135,
      "text": "第九名，",
      "token_start": 389,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 110530,
      "end_ms": 115005,
      "text": "内蒙古呼伦贝尔金秋草原夏天它是翠绿的。",
      "token_start": 392,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 115400,
      "end_ms": 116375,
      "text": "一入深秋，",
      "token_start": 410,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 116790,
      "end_ms": 120820,
      "text": "整片草原褪成了金色十万平方公里，",
      "token_start": 414,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 120820,
      "end_ms": 122995,
      "text": "上下一眼望过去，",
      "token_start": 429,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 123370,
      "end_ms": 128040,
      "text": "天和地之间只剩一条细线蔚蓝清澈的末日格勒河，",
      "token_start": 436,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 128200,
      "end_ms": 130815,
      "text": "像一条飘动的银色丝带，",
      "token_start": 457,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 131280,
      "end_ms": 134625,
      "text": "千回百转地在大地中间穿行，",
      "token_start": 467,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 135220,
      "end_ms": 140305,
      "text": "漫山遍野散落着成千上万个巨大的圆形草垛。",
      "token_start": 479,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 141030,
      "end_ms": 143390,
      "text": "落日余晖洒在草尖上，",
      "token_start": 498,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 143610,
      "end_ms": 145165,
      "text": "泛起一片暖光。",
      "token_start": 507,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 145600,
      "end_ms": 150360,
      "text": "您要是从城里忙碌的厨房和繁杂琐事里走出来往。",
      "token_start": 513,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 150360,
      "end_ms": 153175,
      "text": "这辽阔无垠的金色草甸上一坐，",
      "token_start": 534,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 153670,
      "end_ms": 156435,
      "text": "胸口那口憋了大半辈子的闷气，",
      "token_start": 547,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 156850,
      "end_ms": 159065,
      "text": "瞬间就能散的干干净净，",
      "token_start": 560,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 159520,
      "end_ms": 161775,
      "text": "天地宽到连影子都容得下，",
      "token_start": 570,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 162230,
      "end_ms": 162570,
      "text": "您说，",
      "token_start": 581,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 162570,
      "end_ms": 164585,
      "text": "还有什么事值得堵在心头。",
      "token_start": 583,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 164930,
      "end_ms": 165745,
      "text": "第八名，",
      "token_start": 594,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 166230,
      "end_ms": 169295,
      "text": "四川巴中光武山、大巴山腹地，",
      "token_start": 597,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 169640,
      "end_ms": 172295,
      "text": "他被人称作亚洲第一红叶山，",
      "token_start": 609,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 172700,
      "end_ms": 175370,
      "text": "可不是白叫的红叶一铺，",
      "token_start": 621,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 175370,
      "end_ms": 176165,
      "text": "就是八百里。",
      "token_start": 631,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 176540,
      "end_ms": 177865,
      "text": "八百里是什么概念？",
      "token_start": 636,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 178350,
      "end_ms": 181185,
      "text": "差不多是北京到济南那么长，",
      "token_start": 644,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 181620,
      "end_ms": 185085,
      "text": "数十个树种各有各的脾气，",
      "token_start": 656,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 185900,
      "end_ms": 188935,
      "text": "山顶先皇往下转成，",
      "token_start": 667,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 189480,
      "end_ms": 193855,
      "text": "再往下是朱洪紫红一层压着一层，",
      "token_start": 675,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 194320,
      "end_ms": 196595,
      "text": "顺着山势往沟底躺，",
      "token_start": 689,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 197000,
      "end_ms": 197915,
      "text": "山高沟深，",
      "token_start": 697,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 198550,
      "end_ms": 199610,
      "text": "早晚温差，",
      "token_start": 701,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 199610,
      "end_ms": 203325,
      "text": "大叶子里的色素越攒越浓。",
      "token_start": 705,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 203730,
      "end_ms": 206015,
      "text": "您站在山梁上往下看，",
      "token_start": 716,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 206600,
      "end_ms": 209755,
      "text": "满眼的红一浪接着一浪翻过来，",
      "token_start": 725,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 210200,
      "end_ms": 211820,
      "text": "向整座山烧着，",
      "token_start": 738,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 211820,
      "end_ms": 213985,
      "text": "了却一点烟都没有。",
      "token_start": 744,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 214710,
      "end_ms": 217545,
      "text": "大自然这回泼墨不打草稿，",
      "token_start": 752,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 217840,
      "end_ms": 219205,
      "text": "也不心疼颜料，",
      "token_start": 763,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 219710,
      "end_ms": 220490,
      "text": "慷慨德，",
      "token_start": 769,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 220490,
      "end_ms": 221745,
      "text": "叫人张不开嘴。",
      "token_start": 772,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 222170,
      "end_ms": 223855,
      "text": "您说这样的大手笔，",
      "token_start": 778,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 224180,
      "end_ms": 226435,
      "text": "一辈子见上一回值不值？",
      "token_start": 786,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 226820,
      "end_ms": 227575,
      "text": "第七名？",
      "token_start": 796,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 228140,
      "end_ms": 230985,
      "text": "内蒙古额济纳旗金色胡杨林，",
      "token_start": 799,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 231640,
      "end_ms": 234715,
      "text": "他扎根在巴丹吉林沙漠、西北边缘，",
      "token_start": 811,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 235200,
      "end_ms": 239065,
      "text": "是中国最古老的一片荒漠野生胡杨林。",
      "token_start": 825,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 239520,
      "end_ms": 240645,
      "text": "民间常说，",
      "token_start": 841,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 241100,
      "end_ms": 246225,
      "text": "他生儿一千年不死死而一千年不倒道而一千年不朽，",
      "token_start": 845,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 246680,
      "end_ms": 253715,
      "text": "整整四十四万亩苍净古墓在每年深秋仅有短短十多天的黄金窗口期，",
      "token_start": 867,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 254220,
      "end_ms": 255360,
      "text": "借着烈猎秋风，",
      "token_start": 896,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 255440,
      "end_ms": 257300,
      "text": "把积蓄一整年的力量，",
      "token_start": 902,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 257340,
      "end_ms": 265405,
      "text": "全数化为纯金烈焰金色的沙丘波纹与求取如铁骨的胡杨紧紧相宜，",
      "token_start": 911,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 265840,
      "end_ms": 268105,
      "text": "狂风掀起漫天黄沙，",
      "token_start": 939,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 268510,
      "end_ms": 272245,
      "text": "今夜却在沙海里燃烧的耀眼夺目。",
      "token_start": 947,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 272660,
      "end_ms": 275495,
      "text": "您走在粗糙滚烫的沙土上，",
      "token_start": 961,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 275960,
      "end_ms": 278835,
      "text": "摸一摸那皲裂如铁的苍老树皮，",
      "token_start": 972,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 279490,
      "end_ms": 282605,
      "text": "生命在绝境风沙里战成这般模样，",
      "token_start": 985,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 283000,
      "end_ms": 284910,
      "text": "换谁看一眼心头，",
      "token_start": 999,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 284910,
      "end_ms": 286225,
      "text": "不被震得发颤。",
      "token_start": 1006,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 286640,
      "end_ms": 287385,
      "text": "第六名，",
      "token_start": 1012,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 287940,
      "end_ms": 291725,
      "text": "吉林长白山天池东北第一高峰。",
      "token_start": 1015,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 292270,
      "end_ms": 297350,
      "text": "十六座雪峰围成一圈圈出一个火山口湖，",
      "token_start": 1028,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 298210,
      "end_ms": 300690,
      "text": "水面海拔两千一百多米，",
      "token_start": 1045,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 301210,
      "end_ms": 303330,
      "text": "最深处三百七十多米，",
      "token_start": 1055,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 303870,
      "end_ms": 307270,
      "text": "是火山喷发后一点点积水成的。",
      "token_start": 1064,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 307650,
      "end_ms": 308590,
      "text": "深秋一到，",
      "token_start": 1077,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 308830,
      "end_ms": 310510,
      "text": "峰顶先落了初雪。",
      "token_start": 1081,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 310930,
      "end_ms": 312850,
      "text": "十六峰白得晃眼，",
      "token_start": 1088,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 313250,
      "end_ms": 314230,
      "text": "往下一截。",
      "token_start": 1095,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 314770,
      "end_ms": 317570,
      "text": "月化林长在森林最高的一线，",
      "token_start": 1099,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 317910,
      "end_ms": 319070,
      "text": "满山纯金，",
      "token_start": 1111,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 319670,
      "end_ms": 323520,
      "text": "像一条金龙盘在黑色的火山岩上，",
      "token_start": 1115,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 323940,
      "end_ms": 327540,
      "text": "中间握着天池水蓝的发黑，",
      "token_start": 1129,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 328280,
      "end_ms": 330640,
      "text": "像一块墨玉嵌进雪里。",
      "token_start": 1140,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 330960,
      "end_ms": 334240,
      "text": "您站在山口冷风往领口里灌，",
      "token_start": 1149,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 334680,
      "end_ms": 335560,
      "text": "低头是墨，",
      "token_start": 1161,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 336040,
      "end_ms": 337000,
      "text": "抬眼是雪，",
      "token_start": 1165,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 337380,
      "end_ms": 338360,
      "text": "侧身是金，",
      "token_start": 1169,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 339000,
      "end_ms": 341480,
      "text": "抬样颜色挤在一个视野里，",
      "token_start": 1173,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 341840,
      "end_ms": 345540,
      "text": "谁也不肯让谁别处的秋天是一种颜色，",
      "token_start": 1184,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 346220,
      "end_ms": 350820,
      "text": "这儿的秋天是三重天这样的胜境。",
      "token_start": 1200,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 351440,
      "end_ms": 353735,
      "text": "您说谁见得不屏住呼吸？",
      "token_start": 1214,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 354130,
      "end_ms": 355825,
      "text": "从第十到第六名，",
      "token_start": 1224,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 356420,
      "end_ms": 360535,
      "text": "盘锦的简蓬草在盐碱滩里熬出了百里红毯，",
      "token_start": 1231,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 361190,
      "end_ms": 364305,
      "text": "呼伦贝尔把整座草原铺成了金色大海。",
      "token_start": 1249,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 364820,
      "end_ms": 367455,
      "text": "光雾山八百里红叶烧成了火浪，",
      "token_start": 1265,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 367950,
      "end_ms": 370950,
      "text": "额济那胡杨在无垠荒漠中狂舞。",
      "token_start": 1278,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 370970,
      "end_ms": 376665,
      "text": "千年长白山天池用初雪与精化铸造出北国盛境，",
      "token_start": 1291,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 377240,
      "end_ms": 379505,
      "text": "可他们还不是最惊艳的。",
      "token_start": 1311,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 379970,
      "end_ms": 382745,
      "text": "接下来第五道第一名更厉害，",
      "token_start": 1321,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 383470,
      "end_ms": 384575,
      "text": "有一座大山，",
      "token_start": 1333,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 385000,
      "end_ms": 386065,
      "text": "万亩梯田，",
      "token_start": 1338,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 386450,
      "end_ms": 388975,
      "text": "一夜之间变成了天上的镜子。",
      "token_start": 1342,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 389640,
      "end_ms": 390655,
      "text": "有一个村子，",
      "token_start": 1354,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 391090,
      "end_ms": 392455,
      "text": "三万多颗银杏，",
      "token_start": 1359,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 392810,
      "end_ms": 395585,
      "text": "把黑石头老屋埋进了金子里，",
      "token_start": 1365,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 395960,
      "end_ms": 402435,
      "text": "可排在榜首的那一处湖两岸数万亩白桦全都烧成了纯金。",
      "token_start": 1377,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 403230,
      "end_ms": 404025,
      "text": "他是哪里？",
      "token_start": 1401,
      "token_end_exclusive": 1405
    },
    {
      "start_ms": 404560,
      "end_ms": 406855,
      "text": "他凭什么排在九寨沟前面，",
      "token_start": 1405,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 407490,
      "end_ms": 409555,
      "text": "下一集已经同步更新，",
      "token_start": 1416,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 410150,
      "end_ms": 411275,
      "text": "点开我的头像，",
      "token_start": 1425,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 411520,
      "end_ms": 414315,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1431,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 414930,
      "end_ms": 418865,
      "text": "看看谁才是中国深秋大地真正的天花板。",
      "token_start": 1443,
      "token_end_exclusive": 1460
    }
  ],
