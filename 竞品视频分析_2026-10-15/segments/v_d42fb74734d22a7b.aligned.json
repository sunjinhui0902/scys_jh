{
  "video_id": "v_d42fb74734d22a7b",
  "duration_s": 465.448276,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_d42fb74734d22a7b.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_d42fb74734d22a7b.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2610,
      "text": "上集说到一九四八年，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2890,
      "end_ms": 7050,
      "text": "何泽会和丈夫钱三强放弃了法国的一切，",
      "token_start": 9,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7470,
      "end_ms": 10930,
      "text": "带着半岁的女儿回到了一穷二白的中国。",
      "token_start": 26,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 11590,
      "end_ms": 15350,
      "text": "很多人以为诺奖级的科学家回国，",
      "token_start": 43,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 15810,
      "end_ms": 17450,
      "text": "肯定是要风得风，",
      "token_start": 57,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 17530,
      "end_ms": 18350,
      "text": "要雨得雨。",
      "token_start": 64,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 19270,
      "end_ms": 19730,
      "text": "没有，",
      "token_start": 68,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 20530,
      "end_ms": 24690,
      "text": "当时中国的原子能事业是一张白纸，",
      "token_start": 70,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 25710,
      "end_ms": 27330,
      "text": "要设备、没设备，",
      "token_start": 85,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 28190,
      "end_ms": 29725,
      "text": "要资料、没资料。",
      "token_start": 91,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 30200,
      "end_ms": 32980,
      "text": "西方国家对中国严防死守，",
      "token_start": 97,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 33700,
      "end_ms": 36460,
      "text": "苏联后来又撤走了全部专家。",
      "token_start": 108,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 37380,
      "end_ms": 43940,
      "text": "何则会接到的第一项重要任务是研制核乳胶核乳胶是什么？",
      "token_start": 120,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 44120,
      "end_ms": 46640,
      "text": "是研究核物理的核心工具，",
      "token_start": 145,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 47180,
      "end_ms": 49220,
      "text": "没有他原子弹的很多，",
      "token_start": 156,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 49220,
      "end_ms": 51060,
      "text": "关键实验根本做不了。",
      "token_start": 165,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 51600,
      "end_ms": 54580,
      "text": "可当时中国连一台像样的仪器都没有，",
      "token_start": 174,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 55040,
      "end_ms": 55420,
      "text": "何则，",
      "token_start": 190,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 55420,
      "end_ms": 58980,
      "text": "会带着两个年轻人去旧货摊买各种零件，",
      "token_start": 192,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 58980,
      "end_ms": 61010,
      "text": "自己所组装仪器，",
      "token_start": 209,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 61350,
      "end_ms": 62590,
      "text": "自己改良设备，",
      "token_start": 216,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 62850,
      "end_ms": 63915,
      "text": "自己做实验。",
      "token_start": 222,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 64360,
      "end_ms": 65755,
      "text": "就这么徒法上马。",
      "token_start": 227,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 66250,
      "end_ms": 67310,
      "text": "一九五六年，",
      "token_start": 234,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 67750,
      "end_ms": 72105,
      "text": "他们成功研制出了达到国际先进水平的核乳胶。",
      "token_start": 239,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 72650,
      "end_ms": 73315,
      "text": "紧接着，",
      "token_start": 259,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 73660,
      "end_ms": 77130,
      "text": "原子弹的点火装置遇到了技术瓶颈，",
      "token_start": 262,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 77350,
      "end_ms": 79275,
      "text": "何泽会默默展开实验，",
      "token_start": 277,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 79720,
      "end_ms": 83495,
      "text": "成功研制出了原子弹的点火中子源，",
      "token_start": 286,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 84110,
      "end_ms": 88055,
      "text": "确保了一九六四年第一颗原子弹顺利引爆。",
      "token_start": 301,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 88670,
      "end_ms": 89715,
      "text": "要不是他出手，",
      "token_start": 319,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 90220,
      "end_ms": 93995,
      "text": "中国原子弹的进程可能要晚上好几年，",
      "token_start": 325,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 94470,
      "end_ms": 96545,
      "text": "原子弹搞成了清淡，",
      "token_start": 341,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 96900,
      "end_ms": 98035,
      "text": "又遇到了麻烦。",
      "token_start": 349,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 98510,
      "end_ms": 100290,
      "text": "研制清淡的过程中，",
      "token_start": 355,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 100470,
      "end_ms": 103005,
      "text": "团队发现关键数据有问题，",
      "token_start": 363,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 103600,
      "end_ms": 105205,
      "text": "需要全部重测。",
      "token_start": 374,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 106080,
      "end_ms": 107885,
      "text": "平常做这样的物理实验，",
      "token_start": 380,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 108310,
      "end_ms": 110395,
      "text": "大概需要三年时间。",
      "token_start": 390,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 110990,
      "end_ms": 112745,
      "text": "但清淡盐制等不起，",
      "token_start": 398,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 113150,
      "end_ms": 114875,
      "text": "国际形势不等人。",
      "token_start": 406,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 115150,
      "end_ms": 119485,
      "text": "何则慧带着团队夜以继日的泡在实验室里，",
      "token_start": 413,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 119890,
      "end_ms": 123590,
      "text": "最后只用了几个月就推翻了原来的数据，",
      "token_start": 431,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 123970,
      "end_ms": 126050,
      "text": "让氢弹如期完成。",
      "token_start": 448,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 126770,
      "end_ms": 128070,
      "text": "毫不夸张的说，",
      "token_start": 455,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 128610,
      "end_ms": 129630,
      "text": "如果没有他，",
      "token_start": 461,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 130470,
      "end_ms": 134710,
      "text": "中国的氢弹可能要晚好几年才能搞出来，",
      "token_start": 466,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 135670,
      "end_ms": 136690,
      "text": "可你知道吗？",
      "token_start": 483,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 137590,
      "end_ms": 142610,
      "text": "就是这样一个为两弹事业立下汗马功劳的人，",
      "token_start": 488,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 144210,
      "end_ms": 147350,
      "text": "一九六九年却被下放到外地，",
      "token_start": 507,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 147770,
      "end_ms": 149445,
      "text": "扫了好几年厕所，",
      "token_start": 519,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 149900,
      "end_ms": 151320,
      "text": "有人替他鸣不平，",
      "token_start": 526,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 152360,
      "end_ms": 152820,
      "text": "何则。",
      "token_start": 533,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 152820,
      "end_ms": 153600,
      "text": "会笑了笑，",
      "token_start": 535,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 153840,
      "end_ms": 154620,
      "text": "说了一句话，",
      "token_start": 539,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 154660,
      "end_ms": 157660,
      "text": "没有谁对不起我们国家需要我，",
      "token_start": 544,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 157820,
      "end_ms": 158620,
      "text": "我就去做。",
      "token_start": 557,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 159520,
      "end_ms": 160600,
      "text": "一九七三年，",
      "token_start": 561,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 160840,
      "end_ms": 167180,
      "text": "中科院高能物理研究所成立五十九岁的何则慧高龄挂帅。",
      "token_start": 566,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 168500,
      "end_ms": 169400,
      "text": "这个年纪，",
      "token_start": 590,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 169940,
      "end_ms": 172040,
      "text": "别人早就退休享福了，",
      "token_start": 594,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 172500,
      "end_ms": 177420,
      "text": "他却带着氧气瓶跑到海拔四千多米的青藏高原，",
      "token_start": 603,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 178200,
      "end_ms": 179160,
      "text": "在那里建立。",
      "token_start": 623,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 179180,
      "end_ms": 180515,
      "text": "何如交观测站？",
      "token_start": 628,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 181480,
      "end_ms": 183295,
      "text": "高原反应让他喘不上气，",
      "token_start": 634,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 183840,
      "end_ms": 185865,
      "text": "他吸一口氧接着干。",
      "token_start": 644,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 186900,
      "end_ms": 187465,
      "text": "就这样，",
      "token_start": 652,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 188440,
      "end_ms": 194500,
      "text": "中国成了当时世界上少数几个能生产核乳胶的国家之一。",
      "token_start": 655,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 194580,
      "end_ms": 201975,
      "text": "他还为国家培养出了第一个气球工程博士发展的空间x射线探测技术。",
      "token_start": 679,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 202450,
      "end_ms": 203425,
      "text": "二零一七年，",
      "token_start": 709,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 203780,
      "end_ms": 208305,
      "text": "中国第一颗x射线天门卫星慧眼发射升空，",
      "token_start": 714,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 208890,
      "end_ms": 213745,
      "text": "这个名字就是为了纪念何泽惠。",
      "token_start": 732,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 214570,
      "end_ms": 216215,
      "text": "可你再看看他的生活，",
      "token_start": 745,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 217070,
      "end_ms": 220015,
      "text": "他把祖上留下的苏州园林往施园，",
      "token_start": 754,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 220500,
      "end_ms": 223835,
      "text": "那可是世界文化遗产价值上亿，",
      "token_start": 768,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 224350,
      "end_ms": 227780,
      "text": "无偿捐给了国家自己的蜗居。",
      "token_start": 781,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 227780,
      "end_ms": 231620,
      "text": "在一间只有二十平米的破旧小屋里，",
      "token_start": 793,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 231620,
      "end_ms": 233135,
      "text": "一住就是几十年，",
      "token_start": 808,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 234050,
      "end_ms": 235685,
      "text": "中科院要给他配专车。",
      "token_start": 815,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 236110,
      "end_ms": 237225,
      "text": "他直接拒绝了，",
      "token_start": 824,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 237800,
      "end_ms": 239485,
      "text": "直到二零零零年，",
      "token_start": 830,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 239800,
      "end_ms": 241875,
      "text": "他还坚持坐公交车上班。",
      "token_start": 837,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 242520,
      "end_ms": 243885,
      "text": "九十二岁那年，",
      "token_start": 847,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 244270,
      "end_ms": 245830,
      "text": "他还挤着绿皮火车。",
      "token_start": 853,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 245830,
      "end_ms": 246915,
      "text": "到外地出差。",
      "token_start": 861,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 247510,
      "end_ms": 248490,
      "text": "一九九二年，",
      "token_start": 866,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 248630,
      "end_ms": 250455,
      "text": "丈夫钱三强去世了，",
      "token_start": 871,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 251290,
      "end_ms": 255215,
      "text": "他又一个人为国家奉献了整整十九年。",
      "token_start": 879,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 256170,
      "end_ms": 258055,
      "text": "二零一一年六月二十日，",
      "token_start": 895,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 258760,
      "end_ms": 260335,
      "text": "何泽会在北京逝世，",
      "token_start": 905,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 260860,
      "end_ms": 262225,
      "text": "享年九十七岁。",
      "token_start": 913,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 262760,
      "end_ms": 263720,
      "text": "他走的时候，",
      "token_start": 919,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 263940,
      "end_ms": 268705,
      "text": "邻居甚至不知道这个天天坐公交车住破房子。",
      "token_start": 924,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 269040,
      "end_ms": 275225,
      "text": "在菜摊前被人翻白眼的老太太是中国顶尖的核物理科学家，",
      "token_start": 943,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 276010,
      "end_ms": 277790,
      "text": "最让人心疼的是什么？",
      "token_start": 968,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 277910,
      "end_ms": 278930,
      "text": "一九九九年，",
      "token_start": 977,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 279210,
      "end_ms": 285585,
      "text": "国家表彰两弹一星功勋科学家这二十三个名字里竟然没有何泽会。",
      "token_start": 982,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 286410,
      "end_ms": 288330,
      "text": "他为原子弹做了点火，",
      "token_start": 1010,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 288350,
      "end_ms": 290185,
      "text": "中子源为清淡，",
      "token_start": 1019,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 290470,
      "end_ms": 291765,
      "text": "抢回了几年时间，",
      "token_start": 1025,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 292270,
      "end_ms": 296425,
      "text": "为中国核物理事业从零起步打下了根基。",
      "token_start": 1032,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 297140,
      "end_ms": 299585,
      "text": "可功劳簿上没有他的名字，",
      "token_start": 1049,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 299910,
      "end_ms": 301190,
      "text": "他从来没争过，",
      "token_start": 1060,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 301470,
      "end_ms": 302790,
      "text": "从来没抱怨过。",
      "token_start": 1066,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 302930,
      "end_ms": 303910,
      "text": "有人采访他，",
      "token_start": 1072,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 304090,
      "end_ms": 306885,
      "text": "问他是怎么发现游河寺分裂的？",
      "token_start": 1077,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 307410,
      "end_ms": 308430,
      "text": "他当当一句，",
      "token_start": 1090,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 309030,
      "end_ms": 309790,
      "text": "我看见了，",
      "token_start": 1095,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 309790,
      "end_ms": 310570,
      "text": "就发现了，",
      "token_start": 1099,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 311110,
      "end_ms": 313390,
      "text": "每个人都可以发现好些东西，",
      "token_start": 1103,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 314070,
      "end_ms": 316130,
      "text": "除非你一天到晚不动脑筋。",
      "token_start": 1115,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 316550,
      "end_ms": 320390,
      "text": "记者又提到他为原子弹、氢弹做出的贡献，",
      "token_start": 1126,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 321150,
      "end_ms": 322010,
      "text": "他直接说，",
      "token_start": 1143,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 322870,
      "end_ms": 324050,
      "text": "这不算什么，",
      "token_start": 1147,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 324830,
      "end_ms": 326610,
      "text": "都是些超烂的本子。",
      "token_start": 1152,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 327650,
      "end_ms": 330810,
      "text": "听说现在的年轻人爱听他的故事，",
      "token_start": 1160,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 331270,
      "end_ms": 332370,
      "text": "老太太头一歪，",
      "token_start": 1174,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 332690,
      "end_ms": 333790,
      "text": "还有点不乐意，",
      "token_start": 1180,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 334130,
      "end_ms": 335350,
      "text": "他们来向我学习。",
      "token_start": 1186,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 336130,
      "end_ms": 336910,
      "text": "你倒霉了，",
      "token_start": 1193,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 337050,
      "end_ms": 338900,
      "text": "我们我做事都不符合时代，",
      "token_start": 1197,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 338960,
      "end_ms": 343760,
      "text": "就是这么一个耿直朴素、不图名不图利的老太太，",
      "token_start": 1208,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 344540,
      "end_ms": 347460,
      "text": "把这一辈子都奉献给了这个国家。",
      "token_start": 1228,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 348360,
      "end_ms": 349620,
      "text": "她出身名门，",
      "token_start": 1242,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 349960,
      "end_ms": 352180,
      "text": "却选了最难走的那条路。",
      "token_start": 1247,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 352660,
      "end_ms": 355780,
      "text": "她功高盖世却甘愿隐姓埋名，",
      "token_start": 1257,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 356620,
      "end_ms": 359540,
      "text": "他把价值连城的祖宅捐给国家，",
      "token_start": 1269,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 359920,
      "end_ms": 362180,
      "text": "自己住二十平米的破房子。",
      "token_start": 1282,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 363080,
      "end_ms": 366380,
      "text": "何泽会这三个字不该被忘记。",
      "token_start": 1293,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 366780,
      "end_ms": 369415,
      "text": "其实像何泽慧这样的人，",
      "token_start": 1305,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 369780,
      "end_ms": 371225,
      "text": "还有很多很多，",
      "token_start": 1315,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 372050,
      "end_ms": 376170,
      "text": "他们有的在戈壁滩上隐姓埋名几十年，",
      "token_start": 1321,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 376370,
      "end_ms": 379475,
      "text": "有的在实验室里熬到油尽灯枯，",
      "token_start": 1337,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 380080,
      "end_ms": 382625,
      "text": "有的把毕生积蓄捐给国家，",
      "token_start": 1350,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 383040,
      "end_ms": 385605,
      "text": "自己却连一件新衣服都舍不得买。",
      "token_start": 1361,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 386480,
      "end_ms": 389215,
      "text": "他们是真正的国之脊梁，",
      "token_start": 1375,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 389800,
      "end_ms": 392725,
      "text": "却很少出现在聚光灯下。",
      "token_start": 1385,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 393580,
      "end_ms": 395900,
      "text": "如果你想知道更多他们的故事，",
      "token_start": 1395,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 396260,
      "end_ms": 396660,
      "text": "推荐，",
      "token_start": 1408,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 396660,
      "end_ms": 398140,
      "text": "你看看国之脊梁。",
      "token_start": 1410,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 398160,
      "end_ms": 398735,
      "text": "这本书，",
      "token_start": 1417,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 399500,
      "end_ms": 405495,
      "text": "书里记录了几十位为新中国立下汗马功劳的科学家和建设者。",
      "token_start": 1420,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 406200,
      "end_ms": 409720,
      "text": "钱学森邓稼先、袁隆平、屠呦呦，",
      "token_start": 1446,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 410040,
      "end_ms": 411880,
      "text": "还有像何泽会这样，",
      "token_start": 1458,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 411880,
      "end_ms": 413580,
      "text": "功劳簿上没有名字，",
      "token_start": 1466,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 413660,
      "end_ms": 416125,
      "text": "却同样不该被遗忘的人。",
      "token_start": 1474,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 416980,
      "end_ms": 422105,
      "text": "每一个名字背后都是一段拿命拼出来的传奇。",
      "token_start": 1484,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 423050,
      "end_ms": 424225,
      "text": "读完你会明白，",
      "token_start": 1503,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 424940,
      "end_ms": 429060,
      "text": "今天的安稳日子不是天上掉下来的，",
      "token_start": 1509,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 429380,
      "end_ms": 433080,
      "text": "是有人用一辈子替我们扛下来的。",
      "token_start": 1524,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 433920,
      "end_ms": 434160,
      "text": "点。",
      "token_start": 1538,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 434220,
      "end_ms": 437500,
      "text": "左下方链接把这本书带回家，",
      "token_start": 1539,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 438240,
      "end_ms": 440620,
      "text": "自己读也给孩子读，",
      "token_start": 1551,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 441420,
      "end_ms": 446000,
      "text": "让我们的下一代知道谁才是真正该追的。",
      "token_start": 1559,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 446000,
      "end_ms": 451320,
      "text": "星点赞是给何泽会迟来的掌声收发，",
      "token_start": 1576,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 451740,
      "end_ms": 454380,
      "text": "是怕以后再也找不到这样的故事。",
      "token_start": 1591,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 454460,
      "end_ms": 460190,
      "text": "收发是让更多人知道谁才是真正的国家脊梁。",
      "token_start": 1605,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 460790,
      "end_ms": 461450,
      "text": "关注我，",
      "token_start": 1624,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 461550,
      "end_ms": 465335,
      "text": "咱们一起把该记住的人一个一个讲完。",
      "token_start": 1627,
      "token_end_exclusive": 1643
    }
  ],
