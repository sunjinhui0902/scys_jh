{
  "video_id": "v_eaf6c8ea1aac9864",
  "duration_s": 432.889002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_eaf6c8ea1aac9864.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_eaf6c8ea1aac9864.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1010,
      "text": "美国人说，",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1010,
      "end_ms": 3270,
      "text": "他一个人抵得上五个师。",
      "token_start": 4,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 3270,
      "end_ms": 7050,
      "text": "后来他们才发现这句话说小了，",
      "token_start": 14,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 7050,
      "end_ms": 9010,
      "text": "家人们先说一句，",
      "token_start": 27,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 9030,
      "end_ms": 10650,
      "text": "提气的话，",
      "token_start": 34,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 10650,
      "end_ms": 12550,
      "text": "有句话说的特别好，",
      "token_start": 38,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12570,
      "end_ms": 15330,
      "text": "手里没有剑和有剑，",
      "token_start": 46,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 15330,
      "end_ms": 17050,
      "text": "不用是两回事。",
      "token_start": 54,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 17850,
      "end_ms": 21870,
      "text": "今天讲的这个人就是给咱们中国人递荐的人，",
      "token_start": 60,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 22730,
      "end_ms": 24930,
      "text": "他叫钱钱学森。",
      "token_start": 79,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 24930,
      "end_ms": 26790,
      "text": "一九五五年，",
      "token_start": 85,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 26870,
      "end_ms": 29870,
      "text": "当钱学森终于回到祖国的时候，",
      "token_start": 90,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 29870,
      "end_ms": 30940,
      "text": "美国人还在嘴硬，",
      "token_start": 103,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 31080,
      "end_ms": 32440,
      "text": "说放他回去又怎么样，",
      "token_start": 110,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 33240,
      "end_ms": 35740,
      "text": "中国连手扶拖拉机都造不明白，",
      "token_start": 119,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 35740,
      "end_ms": 37940,
      "text": "他一个人能翻起什么浪。",
      "token_start": 132,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 38840,
      "end_ms": 40340,
      "text": "当时谁也没想到，",
      "token_start": 142,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 41180,
      "end_ms": 47100,
      "text": "这句话成了美国人在整个冷战里最大的一个笑话。",
      "token_start": 149,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 48540,
      "end_ms": 57400,
      "text": "钱学森回国之后干的第一件大事是一九五五年冬天在哈尔滨陈赓大将问他，",
      "token_start": 170,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 58200,
      "end_ms": 58900,
      "text": "钱先生，",
      "token_start": 202,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 59120,
      "end_ms": 63515,
      "text": "您看咱们中国人自己搞导弹行不行？",
      "token_start": 205,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 64640,
      "end_ms": 66355,
      "text": "钱学森只回了一句，",
      "token_start": 220,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 67490,
      "end_ms": 68135,
      "text": "怎么不行，",
      "token_start": 228,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 68580,
      "end_ms": 69695,
      "text": "外国人能搞的，",
      "token_start": 232,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 69930,
      "end_ms": 71355,
      "text": "中国人为什么不能搞？",
      "token_start": 238,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 71750,
      "end_ms": 74340,
      "text": "我们中国人不比他们矮一截，",
      "token_start": 247,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 74420,
      "end_ms": 79405,
      "text": "就这一句话定下了中国国防现代化的乾坤。",
      "token_start": 259,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 80340,
      "end_ms": 81405,
      "text": "可话说回来，",
      "token_start": 277,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 82250,
      "end_ms": 86505,
      "text": "那会儿搞导弹拿什么搞家人们，",
      "token_start": 282,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 87870,
      "end_ms": 90195,
      "text": "您知道当时的条件有多苦吗？",
      "token_start": 295,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 90770,
      "end_ms": 91535,
      "text": "没有图纸，",
      "token_start": 307,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 91940,
      "end_ms": 92745,
      "text": "没有设备，",
      "token_start": 311,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 93040,
      "end_ms": 93845,
      "text": "没有专家，",
      "token_start": 315,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 94320,
      "end_ms": 97245,
      "text": "整个中国真正见过导弹的人，",
      "token_start": 319,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 97560,
      "end_ms": 99095,
      "text": "一只手数得过来。",
      "token_start": 331,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 99760,
      "end_ms": 105985,
      "text": "钱学森手里有什么一支笔、一张纸和一屋子刚毕业的年轻人。",
      "token_start": 338,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 106550,
      "end_ms": 107555,
      "text": "一九五六年，",
      "token_start": 363,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 107880,
      "end_ms": 109865,
      "text": "国防部第五研究院成立，",
      "token_start": 368,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 110410,
      "end_ms": 112830,
      "text": "这是中国第一个导弹研究机构。",
      "token_start": 378,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 112910,
      "end_ms": 113605,
      "text": "一开始，",
      "token_start": 391,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 114430,
      "end_ms": 118675,
      "text": "全院就几百号人办公地点是几间旧房子。",
      "token_start": 394,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 119650,
      "end_ms": 122515,
      "text": "钱学森亲自给这群年轻人上课，",
      "token_start": 411,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 123270,
      "end_ms": 125085,
      "text": "从最基础的讲起，",
      "token_start": 424,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 125800,
      "end_ms": 126865,
      "text": "他出的考题，",
      "token_start": 431,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 127500,
      "end_ms": 129735,
      "text": "据说难道没几个人能及格？",
      "token_start": 436,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 130220,
      "end_ms": 130965,
      "text": "可就是这样，",
      "token_start": 447,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 131400,
      "end_ms": 136465,
      "text": "他硬是在一群学生兵里带出了中国导弹事业的班底。",
      "token_start": 452,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 137410,
      "end_ms": 138970,
      "text": "那时候算导弹弹道，",
      "token_start": 474,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 139230,
      "end_ms": 140210,
      "text": "没有计算机，",
      "token_start": 482,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 140370,
      "end_ms": 141355,
      "text": "全靠算盘，",
      "token_start": 487,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 141700,
      "end_ms": 142775,
      "text": "手摇计算机。",
      "token_start": 491,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 143470,
      "end_ms": 145745,
      "text": "一屋子人噼里啪啦打一整天，",
      "token_start": 496,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 146690,
      "end_ms": 149165,
      "text": "钱学森就是带着这群年轻人，",
      "token_start": 508,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 149400,
      "end_ms": 154435,
      "text": "用最原始的工具算出了中国人自己的导弹数据。",
      "token_start": 520,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 155490,
      "end_ms": 157495,
      "text": "一九六零年十一月五号，",
      "token_start": 540,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 158290,
      "end_ms": 165215,
      "text": "中国第一枚近程导弹东风一号发射成功。",
      "token_start": 550,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 165750,
      "end_ms": 168000,
      "text": "从五院成立到导弹，",
      "token_start": 567,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 168000,
      "end_ms": 169435,
      "text": "上天四年，",
      "token_start": 575,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 170130,
      "end_ms": 172195,
      "text": "美国人听说这个消息的时候，",
      "token_start": 579,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 172520,
      "end_ms": 174075,
      "text": "下巴差点没掉下来，",
      "token_start": 591,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 174630,
      "end_ms": 175785,
      "text": "但这才哪到哪。",
      "token_start": 599,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 176400,
      "end_ms": 178715,
      "text": "一九六四年十月十六号，",
      "token_start": 605,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 179280,
      "end_ms": 182005,
      "text": "中国第一颗原子弹爆炸成功。",
      "token_start": 615,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 182710,
      "end_ms": 184925,
      "text": "一九六六年十月二十七号，",
      "token_start": 627,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 185570,
      "end_ms": 188610,
      "text": "钱学森给原子弹装上了翅膀。",
      "token_start": 638,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 188690,
      "end_ms": 190205,
      "text": "导弹载着核弹头，",
      "token_start": 650,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 190640,
      "end_ms": 192865,
      "text": "从戈壁滩腾空而起，",
      "token_start": 657,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 193230,
      "end_ms": 195035,
      "text": "准确命中预定目标，",
      "token_start": 665,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 195490,
      "end_ms": 196270,
      "text": "两弹结合，",
      "token_start": 673,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 196270,
      "end_ms": 196985,
      "text": "试验成功。",
      "token_start": 677,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 197470,
      "end_ms": 200835,
      "text": "那一年距离他回国才十一年。",
      "token_start": 681,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 201200,
      "end_ms": 203225,
      "text": "一九六七年氢弹爆炸。",
      "token_start": 693,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 203730,
      "end_ms": 206425,
      "text": "一九七零年四月二十四号，",
      "token_start": 702,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 206820,
      "end_ms": 209115,
      "text": "东方红一号卫星上天，",
      "token_start": 713,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 209690,
      "end_ms": 214115,
      "text": "东方红的乐曲响彻太空家人们，",
      "token_start": 722,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 215010,
      "end_ms": 217775,
      "text": "您把这些时间线排在一起看看，",
      "token_start": 735,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 218250,
      "end_ms": 222815,
      "text": "从一无所有到两弹一星全部拿下来，",
      "token_start": 748,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 223370,
      "end_ms": 224555,
      "text": "中间隔了多久？",
      "token_start": 763,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 224880,
      "end_ms": 226990,
      "text": "十五年十五年前，",
      "token_start": 769,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 227330,
      "end_ms": 229655,
      "text": "美国人说他一个人翻不起浪。",
      "token_start": 776,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 230060,
      "end_ms": 231005,
      "text": "十五年后，",
      "token_start": 788,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 231370,
      "end_ms": 235705,
      "text": "中国人手里已经有了一把谁都动不了的剑。",
      "token_start": 792,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 236270,
      "end_ms": 238685,
      "text": "这就是从零到一的可怕。",
      "token_start": 810,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 239640,
      "end_ms": 243435,
      "text": "美国人当年为什么宁可关他五年也不放他？",
      "token_start": 820,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 243920,
      "end_ms": 245305,
      "text": "因为他们太清楚了，",
      "token_start": 838,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 245610,
      "end_ms": 250405,
      "text": "像钱学森这种人一个就能顶一支军队，",
      "token_start": 846,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 251210,
      "end_ms": 253275,
      "text": "他完成的不是仿制，",
      "token_start": 862,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 253560,
      "end_ms": 254385,
      "text": "不是追赶，",
      "token_start": 870,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 254650,
      "end_ms": 255355,
      "text": "是开创，",
      "token_start": 874,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 256200,
      "end_ms": 258665,
      "text": "更觉得是他超前的眼光。",
      "token_start": 877,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 259210,
      "end_ms": 261490,
      "text": "今天让全世界都头疼的。",
      "token_start": 887,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 261490,
      "end_ms": 266495,
      "text": "东风时期高超音速导弹用的那个钱学森弹道，",
      "token_start": 897,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 266780,
      "end_ms": 268120,
      "text": "不是普通抛物线，",
      "token_start": 916,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 268200,
      "end_ms": 270025,
      "text": "是助推加滑翔，",
      "token_start": 923,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 270370,
      "end_ms": 272415,
      "text": "飞着飞着还能变鬼道，",
      "token_start": 929,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 272730,
      "end_ms": 275075,
      "text": "让所有防空系统都摸不着头脑。",
      "token_start": 938,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 276020,
      "end_ms": 280225,
      "text": "这个理论底子钱学森早在几十年前就画出来了，",
      "token_start": 951,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 280750,
      "end_ms": 282325,
      "text": "美国研究了这么多年，",
      "token_start": 971,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 282630,
      "end_ms": 284935,
      "text": "到现在也没完全吃透。",
      "token_start": 980,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 285890,
      "end_ms": 286595,
      "text": "写到这儿，",
      "token_start": 989,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 286950,
      "end_ms": 288515,
      "text": "我还想跟您提一个人。",
      "token_start": 993,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 288820,
      "end_ms": 289485,
      "text": "郭有怀，",
      "token_start": 1002,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 290380,
      "end_ms": 292285,
      "text": "他跟钱学森是好友。",
      "token_start": 1005,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 292690,
      "end_ms": 299430,
      "text": "也是一九五六年前后冲破阻挠回国的顶尖科学家两弹一星的元勋。",
      "token_start": 1013,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 300070,
      "end_ms": 301930,
      "text": "一九六八年十二月五号，",
      "token_start": 1041,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 302090,
      "end_ms": 305150,
      "text": "郭永怀从青海基地赶回北京，",
      "token_start": 1051,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 305150,
      "end_ms": 306890,
      "text": "汇报一起飞机失事。",
      "token_start": 1063,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 307790,
      "end_ms": 310670,
      "text": "人们找到他和警卫员遗体的时候，",
      "token_start": 1071,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 311090,
      "end_ms": 313470,
      "text": "发现两个人紧紧抱在一起，",
      "token_start": 1085,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 313950,
      "end_ms": 317010,
      "text": "怀里护着的公文包完好无损，",
      "token_start": 1096,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 317850,
      "end_ms": 322285,
      "text": "里面装的是热核导弹的绝密数据。",
      "token_start": 1108,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 322830,
      "end_ms": 323430,
      "text": "那一年，",
      "token_start": 1122,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 323730,
      "end_ms": 326410,
      "text": "他五十九岁家人们，",
      "token_start": 1125,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 327770,
      "end_ms": 329110,
      "text": "中国导弹事业，",
      "token_start": 1133,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 329110,
      "end_ms": 332170,
      "text": "这条路上不只是钱学森，",
      "token_start": 1139,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 332190,
      "end_ms": 332690,
      "text": "一个人，",
      "token_start": 1149,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 333110,
      "end_ms": 338030,
      "text": "是无数个像郭永怀这样把命都搭进去的人才，",
      "token_start": 1152,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 338030,
      "end_ms": 340890,
      "text": "让咱们今天能挺直腰杆说话。",
      "token_start": 1171,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 341750,
      "end_ms": 342350,
      "text": "美国人说，",
      "token_start": 1183,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 342350,
      "end_ms": 345430,
      "text": "钱学森抵得上五个师才在回头看。",
      "token_start": 1187,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 345470,
      "end_ms": 347050,
      "text": "这句话缩小了，",
      "token_start": 1201,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 347910,
      "end_ms": 353270,
      "text": "他给中国带来的是一个完整的国防工业体系，",
      "token_start": 1207,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 353500,
      "end_ms": 356595,
      "text": "是一整代能打仗的科学家队伍，",
      "token_start": 1226,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 357420,
      "end_ms": 360525,
      "text": "是往后几十年的和平家人们。",
      "token_start": 1239,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 360810,
      "end_ms": 363705,
      "text": "您记住今天这个日子里的每一个名字，",
      "token_start": 1251,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 364230,
      "end_ms": 366585,
      "text": "他们那一代人把建筑好了，",
      "token_start": 1267,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 366820,
      "end_ms": 371145,
      "text": "咱们这一代人才有资格说我们爱好和平，",
      "token_start": 1278,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 371750,
      "end_ms": 374275,
      "text": "因为和平是手里的剑给的。",
      "token_start": 1295,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 375070,
      "end_ms": 376115,
      "text": "听完他的故事，",
      "token_start": 1306,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 376520,
      "end_ms": 377835,
      "text": "心里真的很感慨，",
      "token_start": 1312,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 378480,
      "end_ms": 379995,
      "text": "咱们现在安稳的日子，",
      "token_start": 1319,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 380260,
      "end_ms": 381460,
      "text": "那是凭空来的，",
      "token_start": 1328,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 381480,
      "end_ms": 383425,
      "text": "都是这一批国之先辈，",
      "token_start": 1334,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 383900,
      "end_ms": 384865,
      "text": "吃苦受累，",
      "token_start": 1343,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 385190,
      "end_ms": 386365,
      "text": "咬牙扛出来。",
      "token_start": 1347,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 387480,
      "end_ms": 388180,
      "text": "很多时候，",
      "token_start": 1352,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 388180,
      "end_ms": 390040,
      "text": "我们生活里遇到点难处，",
      "token_start": 1356,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 390320,
      "end_ms": 391665,
      "text": "就容易觉得累，",
      "token_start": 1366,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 392010,
      "end_ms": 392805,
      "text": "觉得委屈。",
      "token_start": 1372,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 393420,
      "end_ms": 395025,
      "text": "回头看看这些先辈，",
      "token_start": 1376,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 395500,
      "end_ms": 399025,
      "text": "他当年面临的是更大的苦难和抉择。",
      "token_start": 1384,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 400100,
      "end_ms": 401185,
      "text": "读他们的故事，",
      "token_start": 1399,
      "token_end_exclusive": 1405
    },
    {
      "start_ms": 401420,
      "end_ms": 402765,
      "text": "不是单纯看历史，",
      "token_start": 1405,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 403220,
      "end_ms": 404160,
      "text": "更是读懂。",
      "token_start": 1412,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 404180,
      "end_ms": 405285,
      "text": "什么叫骨气？",
      "token_start": 1416,
      "token_end_exclusive": 1421
    },
    {
      "start_ms": 405620,
      "end_ms": 406575,
      "text": "什么叫担当？",
      "token_start": 1421,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 407670,
      "end_ms": 408885,
      "text": "这本国之几两？",
      "token_start": 1426,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 409170,
      "end_ms": 416775,
      "text": "就在左下角链接里书里面记录的就是这些近代先辈们真实的人生。",
      "token_start": 1432,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 418340,
      "end_ms": 419660,
      "text": "没事的时候翻一翻，",
      "token_start": 1460,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 419720,
      "end_ms": 420985,
      "text": "不管是自己看，",
      "token_start": 1468,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 421350,
      "end_ms": 423215,
      "text": "家里孩子也可以读一读，",
      "token_start": 1474,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 423750,
      "end_ms": 426605,
      "text": "了解我们真正的民族榜样，",
      "token_start": 1484,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 427780,
      "end_ms": 430845,
      "text": "有需要的朋友直接拍下现货，",
      "token_start": 1495,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 431120,
      "end_ms": 431695,
      "text": "带回家，",
      "token_start": 1507,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 431990,
      "end_ms": 432775,
      "text": "慢慢品读。",
      "token_start": 1510,
      "token_end_exclusive": 1514
    }
  ],
