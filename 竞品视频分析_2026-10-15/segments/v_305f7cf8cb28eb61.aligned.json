{
  "video_id": "v_305f7cf8cb28eb61",
  "duration_s": 554.701995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_305f7cf8cb28eb61.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_305f7cf8cb28eb61.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 710,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 870,
      "end_ms": 5670,
      "text": "咱们盘了第十到第六浪中藏在山水里，",
      "token_start": 2,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 6210,
      "end_ms": 7770,
      "text": "丽江长在水上，",
      "token_start": 18,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 8010,
      "end_ms": 14710,
      "text": "徽州把城套在城里镇原守着太极图凤凰住在沱江上。",
      "token_start": 24,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 15670,
      "end_ms": 18470,
      "text": "好多朋友看完在评论区炒翻了，",
      "token_start": 46,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 18790,
      "end_ms": 22190,
      "text": "有人说绍兴呢赣州呢襄阳呢？",
      "token_start": 59,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 22350,
      "end_ms": 22850,
      "text": "别急，",
      "token_start": 71,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 23210,
      "end_ms": 25350,
      "text": "今天这集就是第五道第一，",
      "token_start": 73,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 25590,
      "end_ms": 26670,
      "text": "一座比一座狠。",
      "token_start": 84,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 27050,
      "end_ms": 29810,
      "text": "最后那个被叫做华夏第一城。",
      "token_start": 90,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 29810,
      "end_ms": 33460,
      "text": "上迟老规矩开讲之前，",
      "token_start": 102,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 33820,
      "end_ms": 35980,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 111,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 36580,
      "end_ms": 38660,
      "text": "让我看看都是谁在听。",
      "token_start": 121,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 38800,
      "end_ms": 39440,
      "text": "第五名，",
      "token_start": 130,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 39760,
      "end_ms": 45320,
      "text": "浙江绍兴古城在会稽山脚下越湖水边上。",
      "token_start": 133,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 46139,
      "end_ms": 48060,
      "text": "公元前四百九十年，",
      "token_start": 150,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 48460,
      "end_ms": 51900,
      "text": "越王勾践让大夫范蠡建城，",
      "token_start": 158,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 52740,
      "end_ms": 55420,
      "text": "到今天两千五百多年了。",
      "token_start": 169,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 55900,
      "end_ms": 59735,
      "text": "这城最绝的是他城址从来没挪过窝。",
      "token_start": 179,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 60670,
      "end_ms": 63745,
      "text": "两千五百年改朝换代多少回，",
      "token_start": 194,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 64510,
      "end_ms": 67220,
      "text": "他还在老地方跟他一样，",
      "token_start": 206,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 67300,
      "end_ms": 71210,
      "text": "老的只有苏州绍兴。",
      "token_start": 216,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 71210,
      "end_ms": 76075,
      "text": "城里有三座小山、釜山、杉杉塔山，",
      "token_start": 224,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 76500,
      "end_ms": 81745,
      "text": "三座山并立在城里浙东古运河穿城而过，",
      "token_start": 237,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 82230,
      "end_ms": 85850,
      "text": "八千多条河道六百多座桥有句老话叫，",
      "token_start": 254,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 86210,
      "end_ms": 88405,
      "text": "三山万户象盘曲，",
      "token_start": 270,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 88800,
      "end_ms": 91245,
      "text": "百桥、千阶水纵横。",
      "token_start": 277,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 91780,
      "end_ms": 92455,
      "text": "您想想，",
      "token_start": 284,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 92850,
      "end_ms": 94505,
      "text": "两千五百年了，",
      "token_start": 287,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 94840,
      "end_ms": 96950,
      "text": "河还是那条河桥，",
      "token_start": 293,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 97110,
      "end_ms": 98045,
      "text": "还是那座桥，",
      "token_start": 300,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 98460,
      "end_ms": 98700,
      "text": "人，",
      "token_start": 305,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 98760,
      "end_ms": 100145,
      "text": "还是住在老地方，",
      "token_start": 306,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 100580,
      "end_ms": 102205,
      "text": "这城不是建在地上，",
      "token_start": 313,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 102520,
      "end_ms": 103625,
      "text": "是长在地里的。",
      "token_start": 321,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 104090,
      "end_ms": 105935,
      "text": "王羲之在这写了兰亭序。",
      "token_start": 327,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 106420,
      "end_ms": 108020,
      "text": "陆游在这儿写下死去，",
      "token_start": 337,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 108080,
      "end_ms": 109015,
      "text": "元知万事空。",
      "token_start": 346,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 109610,
      "end_ms": 110975,
      "text": "鲁迅从这儿走出去，",
      "token_start": 351,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 111660,
      "end_ms": 116405,
      "text": "一座城把江南的骨和魂全泡在黄酒里了。",
      "token_start": 359,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 117580,
      "end_ms": 118185,
      "text": "第四名，",
      "token_start": 376,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 118560,
      "end_ms": 124880,
      "text": "江西赣州古城在江西南部张江和共江在城下汇合，",
      "token_start": 379,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 125200,
      "end_ms": 127585,
      "text": "汇成赣江三面环水。",
      "token_start": 400,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 128080,
      "end_ms": 130555,
      "text": "这城有两千两百多年历史，",
      "token_start": 408,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 131080,
      "end_ms": 134255,
      "text": "最绝的地方是他九百多年没被淹过。",
      "token_start": 419,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 134600,
      "end_ms": 136225,
      "text": "赣州三面都是水，",
      "token_start": 434,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 136850,
      "end_ms": 138935,
      "text": "北宋以前年年闹水患，",
      "token_start": 441,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 139590,
      "end_ms": 145075,
      "text": "北宋西宁年间知州刘怡修了一套地下排水系统，",
      "token_start": 450,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 145590,
      "end_ms": 149545,
      "text": "因为排水沟的走向像古篆体的福寿两个字，",
      "token_start": 470,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 149810,
      "end_ms": 150925,
      "text": "所以叫福寿沟。",
      "token_start": 488,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 151600,
      "end_ms": 154245,
      "text": "这套沟全长十二点六公里，",
      "token_start": 494,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 154840,
      "end_ms": 157835,
      "text": "利用赣州西南高东北低的地势，",
      "token_start": 505,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 158350,
      "end_ms": 162190,
      "text": "用明沟暗渠和池塘连成一张网。",
      "token_start": 518,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 162350,
      "end_ms": 162970,
      "text": "水大了，",
      "token_start": 531,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 162970,
      "end_ms": 164450,
      "text": "排走水小了，",
      "token_start": 534,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 164450,
      "end_ms": 166965,
      "text": "存住九百多年了，",
      "token_start": 539,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 167540,
      "end_ms": 169475,
      "text": "赣州再没被淹过，",
      "token_start": 546,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 170300,
      "end_ms": 171260,
      "text": "人称不落。",
      "token_start": 553,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 171280,
      "end_ms": 173795,
      "text": "浮城您去赣州看看，",
      "token_start": 557,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 174650,
      "end_ms": 183030,
      "text": "宋代城墙还在玉孤台还在辛弃疾写过玉孤台下清江水，",
      "token_start": 565,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 183310,
      "end_ms": 186390,
      "text": "中间多少行人泪站在城墙上，",
      "token_start": 588,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 186750,
      "end_ms": 187990,
      "text": "一边是张江，",
      "token_start": 600,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 188150,
      "end_ms": 191230,
      "text": "一边是共江两条江合在一起。",
      "token_start": 605,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 191950,
      "end_ms": 196910,
      "text": "这城站在两条江中间占了两千两百多年。",
      "token_start": 617,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 197370,
      "end_ms": 197990,
      "text": "第三名，",
      "token_start": 634,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 198370,
      "end_ms": 201770,
      "text": "湖北荆州古城在长江边上，",
      "token_start": 637,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 202110,
      "end_ms": 205890,
      "text": "楚国文化的发祥地两千八百多年了。",
      "token_start": 648,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 205910,
      "end_ms": 208470,
      "text": "这城最绝的是他的城墙。",
      "token_start": 663,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 208870,
      "end_ms": 213870,
      "text": "荆州古城墙是中国南方保存最完整的古城墙，",
      "token_start": 673,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 214690,
      "end_ms": 214930,
      "text": "城，",
      "token_start": 692,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 214950,
      "end_ms": 216450,
      "text": "高将近九米，",
      "token_start": 693,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 217110,
      "end_ms": 218590,
      "text": "周长十一公里多，",
      "token_start": 698,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 218870,
      "end_ms": 220870,
      "text": "绕城一周完整无缺。",
      "token_start": 705,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 221370,
      "end_ms": 222910,
      "text": "为什么修的这么结实？",
      "token_start": 713,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 223370,
      "end_ms": 225770,
      "text": "荆州是兵家必争之地，",
      "token_start": 722,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 226090,
      "end_ms": 228430,
      "text": "关羽在这镇守过李白，",
      "token_start": 731,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 228430,
      "end_ms": 231270,
      "text": "写过千里江陵一日还，",
      "token_start": 740,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 231570,
      "end_ms": 235050,
      "text": "就是这儿城墙外面是护城河，",
      "token_start": 749,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 235550,
      "end_ms": 236850,
      "text": "全长一万多米，",
      "token_start": 761,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 236950,
      "end_ms": 238650,
      "text": "宽三十米水深，",
      "token_start": 767,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 238690,
      "end_ms": 240115,
      "text": "四米系通太湖。",
      "token_start": 773,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 240200,
      "end_ms": 240365,
      "text": "嗯，",
      "token_start": 779,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 240670,
      "end_ms": 243245,
      "text": "东联长湖跟古运河连着。",
      "token_start": 780,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 245190,
      "end_ms": 245830,
      "text": "您想想，",
      "token_start": 790,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 245990,
      "end_ms": 247950,
      "text": "城里有东西长三公里多，",
      "token_start": 793,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 248230,
      "end_ms": 250025,
      "text": "南北宽一公里多，",
      "token_start": 803,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 250470,
      "end_ms": 251930,
      "text": "四面都是城墙，",
      "token_start": 810,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 251930,
      "end_ms": 255325,
      "text": "围着外面一圈水围着这城怎么打？",
      "token_start": 816,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 255940,
      "end_ms": 256660,
      "text": "最绝的是，",
      "token_start": 830,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 256660,
      "end_ms": 257945,
      "text": "城砖上还有文字，",
      "token_start": 834,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 258480,
      "end_ms": 261075,
      "text": "记录着烧砖的年代和工匠的名字，",
      "token_start": 841,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 261710,
      "end_ms": 266690,
      "text": "比万里长城上目前发现最早的砖还早。",
      "token_start": 855,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 266930,
      "end_ms": 269605,
      "text": "两百零七年第二名，",
      "token_start": 871,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 269870,
      "end_ms": 272705,
      "text": "云南大理古城在苍山脚下，",
      "token_start": 879,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 273150,
      "end_ms": 274115,
      "text": "洱海边上。",
      "token_start": 890,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 274590,
      "end_ms": 278495,
      "text": "明洪武十五年建的一千两百多年哪，",
      "token_start": 894,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 279240,
      "end_ms": 281655,
      "text": "这城最绝的是他的位置。",
      "token_start": 909,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 283080,
      "end_ms": 284040,
      "text": "东临洱海，",
      "token_start": 919,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 284240,
      "end_ms": 290730,
      "text": "西镇苍山、苍山十九峰十八西溪水从山上流下来，",
      "token_start": 923,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 290910,
      "end_ms": 291875,
      "text": "穿过古城。",
      "token_start": 943,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 292270,
      "end_ms": 300690,
      "text": "流径洱海整座城的布局是九街十八巷棋盘格局从南城门进去，",
      "token_start": 947,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 301150,
      "end_ms": 302490,
      "text": "抬头就能看见。",
      "token_start": 973,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 302530,
      "end_ms": 305130,
      "text": "苍山回头看就是洱海，",
      "token_start": 979,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 305990,
      "end_ms": 308050,
      "text": "古人把这叫风花雪月，",
      "token_start": 988,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 308510,
      "end_ms": 313030,
      "text": "下观风上观花、苍山雪洱海月，",
      "token_start": 997,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 313750,
      "end_ms": 316550,
      "text": "这四样东西全在这座城周围。",
      "token_start": 1009,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 317070,
      "end_ms": 320150,
      "text": "古理在唐代是南赵国的都城，",
      "token_start": 1021,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 320670,
      "end_ms": 323160,
      "text": "宋代是大理李国的都城，",
      "token_start": 1033,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 323660,
      "end_ms": 327420,
      "text": "一座城做了五百多年的国都站在城墙上，",
      "token_start": 1043,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 327600,
      "end_ms": 328620,
      "text": "左边是苍山，",
      "token_start": 1060,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 328760,
      "end_ms": 329680,
      "text": "右边是洱海，",
      "token_start": 1065,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 330420,
      "end_ms": 334180,
      "text": "这地方不是神仙住的地方是什么？",
      "token_start": 1070,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 335500,
      "end_ms": 340400,
      "text": "我前阵子翻到一本叫三百六十五日走遍中国的日历书，",
      "token_start": 1084,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 341040,
      "end_ms": 343760,
      "text": "左边一页是每个地方的实景大图，",
      "token_start": 1107,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 344000,
      "end_ms": 346800,
      "text": "加一段五十来个字的冷知识，",
      "token_start": 1121,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 347380,
      "end_ms": 349440,
      "text": "右边是日期纪事夜，",
      "token_start": 1133,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 349720,
      "end_ms": 351685,
      "text": "什么季节去哪座小城，",
      "token_start": 1141,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 352120,
      "end_ms": 352860,
      "text": "走哪条路，",
      "token_start": 1150,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 352880,
      "end_ms": 354405,
      "text": "看什么风景最合适，",
      "token_start": 1154,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 354970,
      "end_ms": 356305,
      "text": "都给你安排好了。",
      "token_start": 1162,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 356590,
      "end_ms": 359385,
      "text": "不是那种千篇一律的景点介绍，",
      "token_start": 1169,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 359690,
      "end_ms": 360915,
      "text": "是帮你挑日子。",
      "token_start": 1182,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 361410,
      "end_ms": 362610,
      "text": "今天翻到镇原，",
      "token_start": 1188,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 362770,
      "end_ms": 364090,
      "text": "明天翻到巍山，",
      "token_start": 1194,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 364290,
      "end_ms": 365715,
      "text": "后天翻到阆中，",
      "token_start": 1200,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 366060,
      "end_ms": 366945,
      "text": "翻到哪页，",
      "token_start": 1206,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 367210,
      "end_ms": 372595,
      "text": "就觉得那个地方在喊你我自己的习惯是每天早起翻一页当个消遣，",
      "token_start": 1210,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 373150,
      "end_ms": 375665,
      "text": "翻到一个从来没听说过的小地方，",
      "token_start": 1238,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 376210,
      "end_ms": 377525,
      "text": "就去网上搜搜照片，",
      "token_start": 1252,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 377930,
      "end_ms": 379225,
      "text": "搜完就想订票。",
      "token_start": 1260,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 379530,
      "end_ms": 380605,
      "text": "我已经放下面了，",
      "token_start": 1266,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 381530,
      "end_ms": 382610,
      "text": "点开就能看到。",
      "token_start": 1273,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 382830,
      "end_ms": 384570,
      "text": "喜欢到处走走的朋友，",
      "token_start": 1279,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 384570,
      "end_ms": 385730,
      "text": "弄一本放茶几，",
      "token_start": 1288,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 385730,
      "end_ms": 388435,
      "text": "上一年下来，",
      "token_start": 1294,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 388900,
      "end_ms": 390460,
      "text": "整个中国哪儿值得去，",
      "token_start": 1299,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 390460,
      "end_ms": 391140,
      "text": "哪个乐去，",
      "token_start": 1308,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 391440,
      "end_ms": 392615,
      "text": "心里全有谱了。",
      "token_start": 1312,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 393720,
      "end_ms": 394235,
      "text": "第一名，",
      "token_start": 1318,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 394740,
      "end_ms": 398635,
      "text": "湖北襄阳古城在汉水中游南岸，",
      "token_start": 1321,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 399020,
      "end_ms": 400115,
      "text": "三面环水，",
      "token_start": 1334,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 400420,
      "end_ms": 401235,
      "text": "一面靠山。",
      "token_start": 1338,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 401750,
      "end_ms": 405005,
      "text": "这座城有两千八百多年历史，",
      "token_start": 1342,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 405610,
      "end_ms": 408115,
      "text": "最绝的地方是他的护城河，",
      "token_start": 1354,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 408590,
      "end_ms": 410905,
      "text": "平均宽度一百八十米，",
      "token_start": 1365,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 411640,
      "end_ms": 412720,
      "text": "最宽的地方，",
      "token_start": 1374,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 412900,
      "end_ms": 413935,
      "text": "两百五十米，",
      "token_start": 1379,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 414370,
      "end_ms": 417425,
      "text": "相当于将近三个标准足球场连在一起。",
      "token_start": 1384,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 417890,
      "end_ms": 420425,
      "text": "这是中国最宽的人工护城河。",
      "token_start": 1400,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 420900,
      "end_ms": 421665,
      "text": "您想想，",
      "token_start": 1412,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 422130,
      "end_ms": 423955,
      "text": "两百多米宽的水面，",
      "token_start": 1415,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 424570,
      "end_ms": 427195,
      "text": "加上三面环水的天然地势，",
      "token_start": 1423,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 427680,
      "end_ms": 428595,
      "text": "这城怎么打？",
      "token_start": 1434,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 429290,
      "end_ms": 431965,
      "text": "历史上襄阳打过一百七十二次仗，",
      "token_start": 1439,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 432360,
      "end_ms": 433555,
      "text": "最出名的一次，",
      "token_start": 1453,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 433920,
      "end_ms": 435125,
      "text": "南宋守了六年，",
      "token_start": 1459,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 435430,
      "end_ms": 437655,
      "text": "蒙古铁骑硬是没打下来。",
      "token_start": 1465,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 438050,
      "end_ms": 439415,
      "text": "所以襄阳有个外号，",
      "token_start": 1475,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 439680,
      "end_ms": 442975,
      "text": "叫铁打的襄阳华夏第一城池，",
      "token_start": 1483,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 443790,
      "end_ms": 445615,
      "text": "城墙上现在还能走人，",
      "token_start": 1495,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 446360,
      "end_ms": 448265,
      "text": "周长七千三百多米。",
      "token_start": 1504,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 448760,
      "end_ms": 450300,
      "text": "站在临汉门城楼上，",
      "token_start": 1512,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 450480,
      "end_ms": 451715,
      "text": "北面就是汉江。",
      "token_start": 1520,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 452240,
      "end_ms": 454190,
      "text": "王维写过江流，",
      "token_start": 1526,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 454250,
      "end_ms": 454950,
      "text": "天地外，",
      "token_start": 1532,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 455290,
      "end_ms": 456645,
      "text": "山色有无中，",
      "token_start": 1535,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 457130,
      "end_ms": 460215,
      "text": "就是站在襄阳城上看到的景。",
      "token_start": 1540,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 460770,
      "end_ms": 463220,
      "text": "南面是国的山西，",
      "token_start": 1552,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 463280,
      "end_ms": 464415,
      "text": "灭是万善，",
      "token_start": 1559,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 464770,
      "end_ms": 466395,
      "text": "北面是汉江，",
      "token_start": 1563,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 467240,
      "end_ms": 470300,
      "text": "东面是汉江的曲流山。",
      "token_start": 1568,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 470360,
      "end_ms": 471940,
      "text": "把城围住，",
      "token_start": 1577,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 472080,
      "end_ms": 472320,
      "text": "水，",
      "token_start": 1581,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 472360,
      "end_ms": 473220,
      "text": "把城抱住，",
      "token_start": 1582,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 474180,
      "end_ms": 477720,
      "text": "城就在山水中间两千多年来。",
      "token_start": 1586,
      "token_end_exclusive": 1598
    },
    {
      "start_ms": 477880,
      "end_ms": 479400,
      "text": "不管怎么改朝换代，",
      "token_start": 1598,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 479780,
      "end_ms": 481660,
      "text": "襄阳的山水格局没动过，",
      "token_start": 1606,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 482000,
      "end_ms": 484600,
      "text": "汉江还在北边流一去，",
      "token_start": 1616,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 484600,
      "end_ms": 489680,
      "text": "山还在南边站城还在中间一座城跟山水绑在一起，",
      "token_start": 1625,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 490300,
      "end_ms": 491720,
      "text": "绑了两千多年，",
      "token_start": 1646,
      "token_end_exclusive": 1652
    },
    {
      "start_ms": 492040,
      "end_ms": 495120,
      "text": "这才是真正做头把交椅的东西。",
      "token_start": 1652,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 495400,
      "end_ms": 496800,
      "text": "不是城墙有多厚，",
      "token_start": 1665,
      "token_end_exclusive": 1672
    },
    {
      "start_ms": 497280,
      "end_ms": 500340,
      "text": "是这城跟山水长在一起了，",
      "token_start": 1672,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 501080,
      "end_ms": 503530,
      "text": "别的城修在山水旁边，",
      "token_start": 1683,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 505050,
      "end_ms": 507250,
      "text": "襄阳是长在山水里面，",
      "token_start": 1692,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 507630,
      "end_ms": 508810,
      "text": "您听出来了没有？",
      "token_start": 1701,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 509650,
      "end_ms": 513830,
      "text": "这十座古城没有一座是靠楼高出名的，",
      "token_start": 1708,
      "token_end_exclusive": 1724
    },
    {
      "start_ms": 514730,
      "end_ms": 518270,
      "text": "绍兴靠的是山围四面水绕三方。",
      "token_start": 1724,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 518510,
      "end_ms": 523750,
      "text": "丽江靠的是没有城墙水穿城过徽州靠的是城套城镇，",
      "token_start": 1737,
      "token_end_exclusive": 1759
    },
    {
      "start_ms": 523770,
      "end_ms": 525250,
      "text": "远靠的是太极图。",
      "token_start": 1759,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 525670,
      "end_ms": 528430,
      "text": "阆中靠的是沱江吊脚楼。",
      "token_start": 1766,
      "token_end_exclusive": 1776
    },
    {
      "start_ms": 528930,
      "end_ms": 531845,
      "text": "绍兴靠的是两千五百年不成窝。",
      "token_start": 1776,
      "token_end_exclusive": 1789
    },
    {
      "start_ms": 532500,
      "end_ms": 534320,
      "text": "赣州靠的是九百年，",
      "token_start": 1789,
      "token_end_exclusive": 1797
    },
    {
      "start_ms": 534400,
      "end_ms": 535700,
      "text": "不烙荆州，",
      "token_start": 1797,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 535720,
      "end_ms": 538260,
      "text": "靠的是南方最完整的城墙。",
      "token_start": 1801,
      "token_end_exclusive": 1812
    },
    {
      "start_ms": 538940,
      "end_ms": 540900,
      "text": "大理靠的是苍山洱海，",
      "token_start": 1812,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 541300,
      "end_ms": 543700,
      "text": "襄阳靠的是华夏第一城池，",
      "token_start": 1821,
      "token_end_exclusive": 1832
    },
    {
      "start_ms": 544480,
      "end_ms": 548680,
      "text": "每一座古城的厉害之处都不在楼有多高，",
      "token_start": 1832,
      "token_end_exclusive": 1849
    },
    {
      "start_ms": 549100,
      "end_ms": 551420,
      "text": "在它跟山水过了一辈子，",
      "token_start": 1849,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 551720,
      "end_ms": 552620,
      "text": "点个关注，",
      "token_start": 1859,
      "token_end_exclusive": 1863
    },
    {
      "start_ms": 552820,
      "end_ms": 554595,
      "text": "咱们下期接着聊。",
      "token_start": 1863,
      "token_end_exclusive": 1870
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
