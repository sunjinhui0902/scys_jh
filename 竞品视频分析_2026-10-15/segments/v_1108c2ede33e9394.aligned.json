{
  "video_id": "v_1108c2ede33e9394",
  "duration_s": 402.355011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1108c2ede33e9394.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1108c2ede33e9394.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1650,
      "text": "一九七零年冬天，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2110,
      "end_ms": 4110,
      "text": "北京中关村街头，",
      "token_start": 7,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 4650,
      "end_ms": 11110,
      "text": "一个穿破棉袄的老头弓着背在水果摊前站了足足三分钟，",
      "token_start": 14,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 11890,
      "end_ms": 13990,
      "text": "摊上的苹果几毛钱一斤。",
      "token_start": 38,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 14550,
      "end_ms": 16090,
      "text": "他伸手摸了摸兜里，",
      "token_start": 48,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 16270,
      "end_ms": 17330,
      "text": "最后啥也没买，",
      "token_start": 56,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 17470,
      "end_ms": 18710,
      "text": "低着头慢慢走了。",
      "token_start": 62,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 19510,
      "end_ms": 21010,
      "text": "旁边有认识他的学生，",
      "token_start": 69,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21010,
      "end_ms": 21890,
      "text": "看不下去了，",
      "token_start": 78,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 22530,
      "end_ms": 24150,
      "text": "追上去塞给他几块钱。",
      "token_start": 83,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25470,
      "end_ms": 26490,
      "text": "老头接过钱，",
      "token_start": 92,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 27050,
      "end_ms": 28290,
      "text": "两只手指哆嗦，",
      "token_start": 97,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 28630,
      "end_ms": 31060,
      "text": "竟然像个做错事的的孩子似的。",
      "token_start": 103,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 31340,
      "end_ms": 33280,
      "text": "弯下腰连连道谢，",
      "token_start": 116,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 33980,
      "end_ms": 36460,
      "text": "路过的年轻人捂着鼻子绕着走。",
      "token_start": 123,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 36560,
      "end_ms": 42200,
      "text": "他们哪知道这个连苹果都舍不得买的老头到底是个什么人物。",
      "token_start": 136,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 43040,
      "end_ms": 43820,
      "text": "我跟你说，",
      "token_start": 162,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 44660,
      "end_ms": 45840,
      "text": "听完他的故事，",
      "token_start": 166,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 46080,
      "end_ms": 47640,
      "text": "你要是心里不堵的话，",
      "token_start": 172,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 48420,
      "end_ms": 49260,
      "text": "我跟找我，",
      "token_start": 181,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 49680,
      "end_ms": 51120,
      "text": "他叫叶启孙，",
      "token_start": 185,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 51900,
      "end_ms": 53560,
      "text": "这名字你可能头一回听，",
      "token_start": 190,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 53820,
      "end_ms": 56080,
      "text": "但接下来这些人你肯定熟。",
      "token_start": 200,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 56640,
      "end_ms": 65410,
      "text": "杨振宁、李政道、邓稼先、钱学深、钱三强、钱伟长、赵九章、华罗庚、王淦昌。",
      "token_start": 211,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 65710,
      "end_ms": 67190,
      "text": "随便拎一个出来，",
      "token_start": 238,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 67290,
      "end_ms": 69455,
      "text": "都是写进教科书的大人物。",
      "token_start": 245,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 70590,
      "end_ms": 71450,
      "text": "可你知道吗？",
      "token_start": 256,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 71490,
      "end_ms": 73995,
      "text": "这帮人全都是叶启孙的学生。",
      "token_start": 261,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 74400,
      "end_ms": 80405,
      "text": "中国二十三位两弹一星元勋九位是他一手带出来。",
      "token_start": 273,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 80970,
      "end_ms": 83445,
      "text": "他这辈子教出了七十九位院士，",
      "token_start": 294,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 83900,
      "end_ms": 84040,
      "text": "说，",
      "token_start": 307,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 84040,
      "end_ms": 86275,
      "text": "他是大师中的大师，",
      "token_start": 308,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 86630,
      "end_ms": 87945,
      "text": "那是一点没吹，",
      "token_start": 316,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 88420,
      "end_ms": 89565,
      "text": "可就是这么一个人，",
      "token_start": 322,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 90000,
      "end_ms": 91975,
      "text": "晚年却生活窘迫，",
      "token_start": 330,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 92390,
      "end_ms": 95065,
      "text": "在中关村一带徘徊街头，",
      "token_start": 337,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 95680,
      "end_ms": 98180,
      "text": "偶尔碰到熟识的学生，",
      "token_start": 347,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 98560,
      "end_ms": 100565,
      "text": "才低着头轻声说一句，",
      "token_start": 356,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 101050,
      "end_ms": 104485,
      "text": "你有钱给我几个索求不过三五块钱，",
      "token_start": 365,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 105210,
      "end_ms": 106490,
      "text": "你说这叫什么事儿？",
      "token_start": 380,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 106490,
      "end_ms": 107785,
      "text": "咱们倒回去说，",
      "token_start": 388,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 109960,
      "end_ms": 112545,
      "text": "一八九八年叶启孙出生在上海，",
      "token_start": 394,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 113490,
      "end_ms": 113910,
      "text": "那年，",
      "token_start": 407,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 113930,
      "end_ms": 116990,
      "text": "正好戊戌变法大清朝，",
      "token_start": 409,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 117070,
      "end_ms": 120565,
      "text": "风雨飘摇洋人骑在脖子上欺负人。",
      "token_start": 418,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 121550,
      "end_ms": 123395,
      "text": "他从小就看在眼里，",
      "token_start": 432,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 123830,
      "end_ms": 125175,
      "text": "心里憋着一股劲，",
      "token_start": 440,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 126100,
      "end_ms": 128525,
      "text": "中国不能再这么窝囊下去了。",
      "token_start": 447,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 128770,
      "end_ms": 129010,
      "text": "嗯，",
      "token_start": 459,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 129400,
      "end_ms": 133255,
      "text": "十三岁他考上清华学堂，",
      "token_start": 460,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 133950,
      "end_ms": 136125,
      "text": "是清华头一批学生，",
      "token_start": 470,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 136910,
      "end_ms": 137690,
      "text": "二十岁，",
      "token_start": 478,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 137930,
      "end_ms": 140265,
      "text": "去芝加哥大学读物理，",
      "token_start": 481,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 140780,
      "end_ms": 142200,
      "text": "二十二岁进哈佛。",
      "token_start": 490,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 142600,
      "end_ms": 143860,
      "text": "二十三岁那年，",
      "token_start": 497,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 144280,
      "end_ms": 150690,
      "text": "他在实验室里测出了当时全世界最精确的朗克常数。",
      "token_start": 503,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 150830,
      "end_ms": 151545,
      "text": "啥概念？",
      "token_start": 525,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 152590,
      "end_ms": 156785,
      "text": "这个数值被国际物理学界整整用了十六年。",
      "token_start": 528,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 157810,
      "end_ms": 160465,
      "text": "一个二十三岁的中国年轻人，",
      "token_start": 546,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 160920,
      "end_ms": 165195,
      "text": "头一回把中国人的名字写进了世界物理教材。",
      "token_start": 558,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 165840,
      "end_ms": 166620,
      "text": "哈佛一看，",
      "token_start": 577,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 166620,
      "end_ms": 167715,
      "text": "这是天才啊，",
      "token_start": 581,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 167930,
      "end_ms": 170890,
      "text": "高薪实验室终身教职，",
      "token_start": 586,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 171190,
      "end_ms": 172675,
      "text": "啥条件都开出来了，",
      "token_start": 595,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 173550,
      "end_ms": 175655,
      "text": "可叶启孙呢头也不回，",
      "token_start": 603,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 176170,
      "end_ms": 177805,
      "text": "买张船票就回国了。",
      "token_start": 612,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 178160,
      "end_ms": 179325,
      "text": "有人问他图啥，",
      "token_start": 620,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 179780,
      "end_ms": 180705,
      "text": "他就一句话，",
      "token_start": 626,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 181400,
      "end_ms": 182915,
      "text": "中国条件再差，",
      "token_start": 631,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 183450,
      "end_ms": 184515,
      "text": "我也要回去，",
      "token_start": 637,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 185510,
      "end_ms": 186505,
      "text": "就这一句话，",
      "token_start": 642,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 187340,
      "end_ms": 189755,
      "text": "今天多少人听了不脸红。",
      "token_start": 647,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 190110,
      "end_ms": 191055,
      "text": "一九二五年，",
      "token_start": 657,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 191380,
      "end_ms": 193845,
      "text": "二十七岁的叶启孙到了清华，",
      "token_start": 662,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 194340,
      "end_ms": 195955,
      "text": "一个人扛起了物理系。",
      "token_start": 674,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 196420,
      "end_ms": 199705,
      "text": "当时啥情况全系就他一个教授，",
      "token_start": 683,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 200190,
      "end_ms": 200850,
      "text": "所有课，",
      "token_start": 696,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 200930,
      "end_ms": 204775,
      "text": "全是他上本科生加起来才七个人，",
      "token_start": 699,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 205450,
      "end_ms": 206250,
      "text": "没有仪器，",
      "token_start": 713,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 206250,
      "end_ms": 206830,
      "text": "自己做，",
      "token_start": 717,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 207130,
      "end_ms": 208010,
      "text": "没有设备，",
      "token_start": 720,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 208010,
      "end_ms": 209940,
      "text": "自己拼没有经费，",
      "token_start": 724,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 210020,
      "end_ms": 211635,
      "text": "从自己工资里掏，",
      "token_start": 731,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 212140,
      "end_ms": 212925,
      "text": "就这么着。",
      "token_start": 738,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 213210,
      "end_ms": 218035,
      "text": "他硬生生把清华物理系带成了全中国最好的物理系。",
      "token_start": 742,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 218530,
      "end_ms": 219410,
      "text": "三十一岁，",
      "token_start": 764,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 219630,
      "end_ms": 221255,
      "text": "又创建了理学院，",
      "token_start": 768,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 221770,
      "end_ms": 226780,
      "text": "一口气办了算学物理化学生物，",
      "token_start": 775,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 227090,
      "end_ms": 229610,
      "text": "心里地穴六个系清华，",
      "token_start": 788,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 229690,
      "end_ms": 232395,
      "text": "从此逆袭成全国顶尖学府。",
      "token_start": 797,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 233010,
      "end_ms": 236130,
      "text": "叶启孙最牛的本事不是自己搞研究，",
      "token_start": 808,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 236430,
      "end_ms": 237755,
      "text": "是发现人才。",
      "token_start": 823,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 238340,
      "end_ms": 240495,
      "text": "那双眼睛跟探照灯似的，",
      "token_start": 828,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 240900,
      "end_ms": 241845,
      "text": "谁是块料，",
      "token_start": 838,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 242130,
      "end_ms": 243405,
      "text": "一眼就能看出来。",
      "token_start": 842,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 243820,
      "end_ms": 246980,
      "text": "华罗庚杂货铺、伙计、初中学历，",
      "token_start": 849,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 247180,
      "end_ms": 248825,
      "text": "所有人都反对招蹋。",
      "token_start": 861,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 249110,
      "end_ms": 251490,
      "text": "只有叶启孙力排众议，",
      "token_start": 869,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 251590,
      "end_ms": 252785,
      "text": "把他弄进清华，",
      "token_start": 878,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 253180,
      "end_ms": 255325,
      "text": "后来又送他去剑桥。",
      "token_start": 884,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 256280,
      "end_ms": 257060,
      "text": "再后来，",
      "token_start": 892,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 257380,
      "end_ms": 260235,
      "text": "华罗庚成了中国数学界的泰斗，",
      "token_start": 895,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 261170,
      "end_ms": 264190,
      "text": "钱伟长考清华物理只考了五分，",
      "token_start": 908,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 264370,
      "end_ms": 266365,
      "text": "数理化加一块才二十五分，",
      "token_start": 921,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 266750,
      "end_ms": 267975,
      "text": "换别人早拒了。",
      "token_start": 932,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 268520,
      "end_ms": 270415,
      "text": "叶启孙偏偏破歌收了，",
      "token_start": 938,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 271270,
      "end_ms": 273790,
      "text": "后来钱伟长成了中国力学之父，",
      "token_start": 947,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 274030,
      "end_ms": 276740,
      "text": "李政道性格太冲，",
      "token_start": 960,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 277020,
      "end_ms": 278080,
      "text": "差点被开除。",
      "token_start": 967,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 278600,
      "end_ms": 282320,
      "text": "叶启孙一路护着自己掏工资，",
      "token_start": 972,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 282560,
      "end_ms": 283835,
      "text": "资助他去美国，",
      "token_start": 984,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 284540,
      "end_ms": 286060,
      "text": "后来李政道三十一岁，",
      "token_start": 990,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 286060,
      "end_ms": 288060,
      "text": "拿了诺贝尔奖领奖时说。",
      "token_start": 999,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 288580,
      "end_ms": 290915,
      "text": "叶启孙老师改变了我一生的命运。",
      "token_start": 1009,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 291430,
      "end_ms": 293790,
      "text": "钱学森补习时没地方住，",
      "token_start": 1023,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 294190,
      "end_ms": 296670,
      "text": "叶启孙直接让他住自己家里，",
      "token_start": 1033,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 296670,
      "end_ms": 299835,
      "text": "还引导他从铁道转向航空。",
      "token_start": 1045,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 300550,
      "end_ms": 302765,
      "text": "后来的事儿大伙都知道了，",
      "token_start": 1056,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 303120,
      "end_ms": 305855,
      "text": "钱学森成了中国航天之父。",
      "token_start": 1067,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 306650,
      "end_ms": 309490,
      "text": "还有王淦昌参加学生运动，",
      "token_start": 1078,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 309590,
      "end_ms": 310330,
      "text": "差点出事。",
      "token_start": 1089,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 311190,
      "end_ms": 312830,
      "text": "叶启孙把他叫到跟前，",
      "token_start": 1093,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 313430,
      "end_ms": 314630,
      "text": "声泪俱下的问，",
      "token_start": 1102,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 314910,
      "end_ms": 315990,
      "text": "谁让你去的？",
      "token_start": 1108,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 317130,
      "end_ms": 318990,
      "text": "你明白自己的使命吗？",
      "token_start": 1113,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 319370,
      "end_ms": 322370,
      "text": "王淦昌当场就哭了一辈子。",
      "token_start": 1122,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 322370,
      "end_ms": 323230,
      "text": "记着这句话，",
      "token_start": 1133,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 323570,
      "end_ms": 326075,
      "text": "后来成了中国核弹之父。",
      "token_start": 1138,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 328010,
      "end_ms": 330050,
      "text": "你看看这哪是教书，",
      "token_start": 1148,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 331070,
      "end_ms": 333590,
      "text": "这是拿自己的命在托人啊，",
      "token_start": 1156,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 334550,
      "end_ms": 336590,
      "text": "可偏偏就是这么一个好人，",
      "token_start": 1167,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 336710,
      "end_ms": 339510,
      "text": "后来的遭遇说出来你都不敢信。",
      "token_start": 1178,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 339990,
      "end_ms": 341070,
      "text": "一九三七年，",
      "token_start": 1191,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 341250,
      "end_ms": 342690,
      "text": "抗战全面爆发，",
      "token_start": 1196,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 343070,
      "end_ms": 346510,
      "text": "叶启孙有个最得意的学生叫熊大枕。",
      "token_start": 1202,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 347050,
      "end_ms": 348670,
      "text": "这学生主动请缨，",
      "token_start": 1217,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 348970,
      "end_ms": 351890,
      "text": "要去前线研究炸药打鬼，",
      "token_start": 1224,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 351890,
      "end_ms": 353630,
      "text": "子叶启孙舍不得。",
      "token_start": 1234,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 353710,
      "end_ms": 356590,
      "text": "但还是支持他去了师徒。",
      "token_start": 1241,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 356590,
      "end_ms": 358260,
      "text": "二人隔着战线和合作，",
      "token_start": 1251,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 358660,
      "end_ms": 362720,
      "text": "研制出了烈性炸药地雷和无线电设备。",
      "token_start": 1260,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 363620,
      "end_ms": 368915,
      "text": "后来著名的地道战地雷战里面就有他们的心血。",
      "token_start": 1276,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 369820,
      "end_ms": 371185,
      "text": "可谁也没想到，",
      "token_start": 1296,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 371580,
      "end_ms": 375915,
      "text": "熊大枕这一去竟然成了叶启孙一生噩梦的开始。",
      "token_start": 1302,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 376440,
      "end_ms": 377185,
      "text": "看到这儿，",
      "token_start": 1322,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 377410,
      "end_ms": 379565,
      "text": "你是不是已经气的手都在抖了？",
      "token_start": 1326,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 379830,
      "end_ms": 380610,
      "text": "先别划走，",
      "token_start": 1339,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 380790,
      "end_ms": 381915,
      "text": "下集更揪心。",
      "token_start": 1343,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 382320,
      "end_ms": 385465,
      "text": "觉得这段历史该让更多人知道的，",
      "token_start": 1348,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 385950,
      "end_ms": 386715,
      "text": "先点个赞，",
      "token_start": 1362,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 387490,
      "end_ms": 388505,
      "text": "点个收藏，",
      "token_start": 1366,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 389330,
      "end_ms": 392195,
      "text": "再转发给身边的亲戚朋友。",
      "token_start": 1370,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 393100,
      "end_ms": 393900,
      "text": "没关注的，",
      "token_start": 1381,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 393940,
      "end_ms": 395000,
      "text": "赶紧点个关注，",
      "token_start": 1385,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 395240,
      "end_ms": 396355,
      "text": "下集马上更，",
      "token_start": 1391,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 396850,
      "end_ms": 400375,
      "text": "我带你看看叶启孙后半辈子到底受了多少罪，",
      "token_start": 1396,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 400800,
      "end_ms": 402275,
      "text": "看完你绝对忘不了。",
      "token_start": 1415,
      "token_end_exclusive": 1423
    }
  ],
