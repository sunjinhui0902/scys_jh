{
  "video_id": "v_acdf28603fafbffb",
  "duration_s": 386.170998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_acdf28603fafbffb.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_acdf28603fafbffb.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 3450,
      "text": "你知道中国的省名都是怎么来的吗？",
      "token_start": 0,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 4350,
      "end_ms": 8470,
      "text": "我猜十个人里八个会说是按山川河流取的，",
      "token_start": 15,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8930,
      "end_ms": 11050,
      "text": "说什么山东就是山的东边，",
      "token_start": 33,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 11510,
      "end_ms": 13390,
      "text": "河南就是河的南边，",
      "token_start": 44,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 13930,
      "end_ms": 15290,
      "text": "听着确实有道理，",
      "token_start": 52,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 16070,
      "end_ms": 17830,
      "text": "但我今天把话撂这儿。",
      "token_start": 59,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 18450,
      "end_ms": 21710,
      "text": "中国的省名远没有你想的那么简单，",
      "token_start": 68,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 22270,
      "end_ms": 26910,
      "text": "每一个名字背后都藏着一套古人精心设计的地理密码。",
      "token_start": 83,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 27450,
      "end_ms": 31260,
      "text": "真正排在榜首的那个省名两个字里，",
      "token_start": 106,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 31280,
      "end_ms": 33520,
      "text": "装着一个民族的精神故乡。",
      "token_start": 121,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 33940,
      "end_ms": 35380,
      "text": "听完你绝对忘不了，",
      "token_start": 132,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 35440,
      "end_ms": 39200,
      "text": "今天咱们就来扒一扒那些古人取名最有讲究的省份。",
      "token_start": 140,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 40040,
      "end_ms": 40700,
      "text": "老规矩，",
      "token_start": 162,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 41000,
      "end_ms": 41960,
      "text": "开讲之前，",
      "token_start": 165,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 42120,
      "end_ms": 45240,
      "text": "劳烦您顺手扣个一点颗红心，",
      "token_start": 169,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 45580,
      "end_ms": 48660,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 181,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 49640,
      "end_ms": 56100,
      "text": "福建福建的取名方式用的是拼字法福，",
      "token_start": 193,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 56140,
      "end_ms": 59140,
      "text": "取自福州建取自建州，",
      "token_start": 209,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 60360,
      "end_ms": 61875,
      "text": "就是今天的建瓯。",
      "token_start": 218,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 62870,
      "end_ms": 65370,
      "text": "唐朝的时候设了福建精略，",
      "token_start": 225,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 65370,
      "end_ms": 68715,
      "text": "使管辖福州和建州一带。",
      "token_start": 236,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 69500,
      "end_ms": 72725,
      "text": "从此福建这个名字就定了下来。",
      "token_start": 246,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 73250,
      "end_ms": 74510,
      "text": "可符和建这两个字，",
      "token_start": 259,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 74510,
      "end_ms": 75710,
      "text": "选的也有深意，",
      "token_start": 267,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 75950,
      "end_ms": 78455,
      "text": "福州的福就是福气的福。",
      "token_start": 273,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 79000,
      "end_ms": 80300,
      "text": "传说五代时期，",
      "token_start": 283,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 80380,
      "end_ms": 87660,
      "text": "闵王王审之把福州治理的风调雨顺、百姓安居福州因此得名。",
      "token_start": 289,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 87680,
      "end_ms": 88625,
      "text": "有福之州。",
      "token_start": 314,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 89190,
      "end_ms": 91235,
      "text": "建州的建是建造的建，",
      "token_start": 318,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 91760,
      "end_ms": 94265,
      "text": "建州是闽北的门户，",
      "token_start": 327,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 95090,
      "end_ms": 97405,
      "text": "从中原进入福建的第一战，",
      "token_start": 335,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 97970,
      "end_ms": 99865,
      "text": "是建功立业的起点。",
      "token_start": 346,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 100830,
      "end_ms": 104105,
      "text": "福气加上建功福建这个名字，",
      "token_start": 354,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 104420,
      "end_ms": 106135,
      "text": "听着就让人心里舒坦，",
      "token_start": 366,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 106630,
      "end_ms": 107825,
      "text": "而且您发现没有？",
      "token_start": 375,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 108150,
      "end_ms": 110385,
      "text": "中国三十四个省级行政区里，",
      "token_start": 382,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 110710,
      "end_ms": 113745,
      "text": "名字里带福字的就只有福建一个。",
      "token_start": 394,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 114810,
      "end_ms": 117230,
      "text": "古人把福字用在省名里，",
      "token_start": 408,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 117230,
      "end_ms": 119675,
      "text": "可见对这块地方寄予了多大的期望。",
      "token_start": 418,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 120150,
      "end_ms": 121550,
      "text": "一个福字带福气，",
      "token_start": 433,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 121770,
      "end_ms": 123230,
      "text": "一个建字有根基，",
      "token_start": 440,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 123530,
      "end_ms": 124850,
      "text": "两个字拼在一起，",
      "token_start": 447,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 124850,
      "end_ms": 127770,
      "text": "就是福建有福气有根基的地方。",
      "token_start": 454,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 128170,
      "end_ms": 128850,
      "text": "第九名，",
      "token_start": 467,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 129230,
      "end_ms": 132030,
      "text": "云南很多人都好奇，",
      "token_start": 470,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 132350,
      "end_ms": 133950,
      "text": "有云南为什么没有云？",
      "token_start": 478,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 133950,
      "end_ms": 134190,
      "text": "北？",
      "token_start": 487,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 134630,
      "end_ms": 135790,
      "text": "答案特别简单，",
      "token_start": 488,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 135970,
      "end_ms": 138370,
      "text": "因为云南的云不是天上的，",
      "token_start": 494,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 138370,
      "end_ms": 141250,
      "text": "云是云岭的云云岭，",
      "token_start": 505,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 141250,
      "end_ms": 143210,
      "text": "是横断山脉的一段。",
      "token_start": 513,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 143650,
      "end_ms": 147890,
      "text": "从西藏东部一直延伸到云南西北部。",
      "token_start": 521,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 148250,
      "end_ms": 148490,
      "text": "答，",
      "token_start": 536,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 148610,
      "end_ms": 149775,
      "text": "拔四五千米，",
      "token_start": 537,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 150200,
      "end_ms": 151920,
      "text": "常年云雾缭绕，",
      "token_start": 542,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 152240,
      "end_ms": 154200,
      "text": "云岭的南边就是云南。",
      "token_start": 548,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 154220,
      "end_ms": 155420,
      "text": "所以云南的意思是，",
      "token_start": 557,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 155420,
      "end_ms": 158920,
      "text": "云岭之南跟天上的白云没关系。",
      "token_start": 565,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 159360,
      "end_ms": 161500,
      "text": "汉武帝的时候派人出使西南，",
      "token_start": 578,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 161860,
      "end_ms": 162660,
      "text": "走到云岭，",
      "token_start": 590,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 162660,
      "end_ms": 164680,
      "text": "南边发现了一大片土地，",
      "token_start": 594,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 164860,
      "end_ms": 165740,
      "text": "就叫它云南。",
      "token_start": 604,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 166240,
      "end_ms": 166880,
      "text": "从那以后，",
      "token_start": 609,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 166880,
      "end_ms": 168980,
      "text": "这个名字用了两千多年没换过，",
      "token_start": 613,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 169820,
      "end_ms": 171140,
      "text": "可为什么没有云北？",
      "token_start": 626,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 171800,
      "end_ms": 174420,
      "text": "因为云岭的北边是四川和西藏，",
      "token_start": 634,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 175080,
      "end_ms": 177000,
      "text": "人家早就有自己的名字了，",
      "token_start": 647,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 177340,
      "end_ms": 178800,
      "text": "不需要再叫云北。",
      "token_start": 658,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 179320,
      "end_ms": 181930,
      "text": "古人取名讲究以山为界，",
      "token_start": 665,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 182470,
      "end_ms": 184350,
      "text": "山南叫一个名山，",
      "token_start": 675,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 184450,
      "end_ms": 186910,
      "text": "北叫另一个名各管各的地盘。",
      "token_start": 682,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 187050,
      "end_ms": 189230,
      "text": "一座山岭把南北分开，",
      "token_start": 694,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 189630,
      "end_ms": 191510,
      "text": "南边的就叫云南，",
      "token_start": 703,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 191950,
      "end_ms": 193950,
      "text": "名字简单可道理深。",
      "token_start": 710,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 194830,
      "end_ms": 195510,
      "text": "第八名。",
      "token_start": 718,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 196030,
      "end_ms": 200370,
      "text": "浙江浙江这个名字来自一条江，",
      "token_start": 721,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 201310,
      "end_ms": 203430,
      "text": "这条江就是钱塘江，",
      "token_start": 734,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 203910,
      "end_ms": 205330,
      "text": "古时候叫浙江。",
      "token_start": 742,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 206110,
      "end_ms": 207970,
      "text": "浙字本身就带着讲究，",
      "token_start": 748,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 208190,
      "end_ms": 209410,
      "text": "它的意思是曲折，",
      "token_start": 757,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 210280,
      "end_ms": 212980,
      "text": "专指江水盘回曲折的样子。",
      "token_start": 764,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 213780,
      "end_ms": 219440,
      "text": "您想想钱塘江到了下游弯弯绕绕拐了多少道弯，",
      "token_start": 775,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 219680,
      "end_ms": 224120,
      "text": "这这个字把江水的形态直接写进了名字里，",
      "token_start": 795,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 224500,
      "end_ms": 225360,
      "text": "可您知道吗？",
      "token_start": 813,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 225520,
      "end_ms": 229560,
      "text": "浙江的简称浙其实跟名字是同一个字，",
      "token_start": 818,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 230360,
      "end_ms": 231940,
      "text": "这在省份里不多见。",
      "token_start": 834,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 232720,
      "end_ms": 234760,
      "text": "浙江阴江得名，",
      "token_start": 842,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 235040,
      "end_ms": 236440,
      "text": "以曲折为名，",
      "token_start": 848,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 237160,
      "end_ms": 238360,
      "text": "一个省的名字，",
      "token_start": 853,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 238540,
      "end_ms": 242055,
      "text": "把一条大江最先民的特征永远刻了下来。",
      "token_start": 859,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 242600,
      "end_ms": 248435,
      "text": "第七名、江苏、江苏是江宁和苏州各取一个字合起来的。",
      "token_start": 876,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 248950,
      "end_ms": 250030,
      "text": "江宁就是南京，",
      "token_start": 898,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 250310,
      "end_ms": 251395,
      "text": "苏州就是姑苏，",
      "token_start": 904,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 252030,
      "end_ms": 253515,
      "text": "一个江一个书。",
      "token_start": 910,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 254100,
      "end_ms": 255015,
      "text": "江是长江，",
      "token_start": 916,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 255400,
      "end_ms": 256280,
      "text": "大气磅礴，",
      "token_start": 920,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 256760,
      "end_ms": 258575,
      "text": "苏轼苏醒复苏，",
      "token_start": 924,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 259040,
      "end_ms": 262330,
      "text": "万物复苏的苏江是刚苏，",
      "token_start": 930,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 262370,
      "end_ms": 264665,
      "text": "是柔江势壮阔，",
      "token_start": 940,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 265080,
      "end_ms": 267045,
      "text": "苏轼温柔合在一起，",
      "token_start": 946,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 267740,
      "end_ms": 268755,
      "text": "刚柔并济，",
      "token_start": 954,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 269140,
      "end_ms": 270025,
      "text": "可您知道吗？",
      "token_start": 958,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 270320,
      "end_ms": 273445,
      "text": "江苏这个名字是清朝才定下来的。",
      "token_start": 963,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 274300,
      "end_ms": 275260,
      "text": "明朝的时候，",
      "token_start": 977,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 275360,
      "end_ms": 279025,
      "text": "江苏和安徽还是一家叫难直隶。",
      "token_start": 982,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 279870,
      "end_ms": 281365,
      "text": "清朝康熙年间，",
      "token_start": 995,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 281830,
      "end_ms": 283205,
      "text": "江南省一分为二，",
      "token_start": 1001,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 283530,
      "end_ms": 286865,
      "text": "去江宁府和苏州府的首次才有了江苏。",
      "token_start": 1008,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 287520,
      "end_ms": 288980,
      "text": "您看一个苏字，",
      "token_start": 1024,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 289080,
      "end_ms": 290855,
      "text": "还带着复苏的好兆头。",
      "token_start": 1030,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 291090,
      "end_ms": 291685,
      "text": "第六名。",
      "token_start": 1039,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 292050,
      "end_ms": 295530,
      "text": "四川四川这个名字听起来简单，",
      "token_start": 1042,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 295770,
      "end_ms": 297930,
      "text": "可它的来历比很多人想的都复杂。",
      "token_start": 1055,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 298690,
      "end_ms": 304450,
      "text": "有人说是因为境内有四条、大河、岷江、沱江、嘉陵江、乌江。",
      "token_start": 1069,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 304990,
      "end_ms": 305770,
      "text": "也有人说，",
      "token_start": 1091,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 306050,
      "end_ms": 311570,
      "text": "是因为北宋时期设了益州、子州、利州、夔州四路，",
      "token_start": 1095,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 311770,
      "end_ms": 313370,
      "text": "合称川峡四路，",
      "token_start": 1114,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 313550,
      "end_ms": 314610,
      "text": "简称四川。",
      "token_start": 1120,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 315470,
      "end_ms": 318390,
      "text": "不管是哪条河还是哪四路，",
      "token_start": 1124,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 318630,
      "end_ms": 319590,
      "text": "一个川字，",
      "token_start": 1135,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 319990,
      "end_ms": 322340,
      "text": "把四川盆地万里顺水，",
      "token_start": 1139,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 322440,
      "end_ms": 326260,
      "text": "汇聚千山环抱的地形全写进去了。",
      "token_start": 1148,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 326700,
      "end_ms": 327960,
      "text": "四川简称蜀，",
      "token_start": 1162,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 328760,
      "end_ms": 330380,
      "text": "蜀是古蜀国的蜀，",
      "token_start": 1167,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 331020,
      "end_ms": 331820,
      "text": "是蚕丛。",
      "token_start": 1174,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 332240,
      "end_ms": 334760,
      "text": "榆公的蜀是三星堆，",
      "token_start": 1177,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 335340,
      "end_ms": 336380,
      "text": "金沙的蜀，",
      "token_start": 1185,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 336980,
      "end_ms": 337580,
      "text": "一个川，",
      "token_start": 1189,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 338059,
      "end_ms": 338600,
      "text": "一个蜀，",
      "token_start": 1192,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 339060,
      "end_ms": 340200,
      "text": "一个讲地形，",
      "token_start": 1195,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 340580,
      "end_ms": 341580,
      "text": "一个讲历史，",
      "token_start": 1200,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 342000,
      "end_ms": 342780,
      "text": "两个名字，",
      "token_start": 1205,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 342860,
      "end_ms": 344860,
      "text": "把四川的魂全抓住了。",
      "token_start": 1209,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 345020,
      "end_ms": 346480,
      "text": "从第十到第六，",
      "token_start": 1218,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 346820,
      "end_ms": 348880,
      "text": "福建是福州加建州，",
      "token_start": 1224,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 349260,
      "end_ms": 350920,
      "text": "云南是云岭之南，",
      "token_start": 1232,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 351300,
      "end_ms": 353205,
      "text": "浙江一因钱塘江得名，",
      "token_start": 1239,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 353720,
      "end_ms": 357955,
      "text": "江苏是江宁加苏州、四川因四条大船得名。",
      "token_start": 1248,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 358510,
      "end_ms": 361695,
      "text": "可这五个还不是最有讲究的。",
      "token_start": 1265,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 362620,
      "end_ms": 364505,
      "text": "接下来第五道第一，",
      "token_start": 1277,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 365120,
      "end_ms": 366425,
      "text": "一个比一个震撼，",
      "token_start": 1285,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 367340,
      "end_ms": 370895,
      "text": "有一个省两个字里藏着一个黎明，",
      "token_start": 1292,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 371470,
      "end_ms": 374795,
      "text": "还有一个省两个字里装着一位圣人，",
      "token_start": 1306,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 375420,
      "end_ms": 379615,
      "text": "最后那个两个字里装着一个民族的精神故乡。",
      "token_start": 1321,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 379880,
      "end_ms": 382210,
      "text": "他是哪个下级马上更新，",
      "token_start": 1340,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 382370,
      "end_ms": 386045,
      "text": "您先点个关注点开头像别走丢。",
      "token_start": 1350,
      "token_end_exclusive": 1363
    }
  ],
