{
  "video_id": "v_276035124ad947a4",
  "duration_s": 383.137931,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_276035124ad947a4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_276035124ad947a4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2490,
      "text": "上集说到一九四九年，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2550,
      "end_ms": 7290,
      "text": "身在伦敦的李四光站在人生最大的悬崖边上，",
      "token_start": 9,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7790,
      "end_ms": 10770,
      "text": "国民党当局放话不公开声明，",
      "token_start": 28,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 10770,
      "end_ms": 11410,
      "text": "不回国，",
      "token_start": 40,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 11690,
      "end_ms": 17270,
      "text": "就把你扣在海外留下来洋房搞废国际地位。",
      "token_start": 43,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 17470,
      "end_ms": 20030,
      "text": "要啥有啥回去，",
      "token_start": 61,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 20330,
      "end_ms": 21710,
      "text": "一个刚打完仗，",
      "token_start": 67,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 22010,
      "end_ms": 23790,
      "text": "百废待兴的新中国，",
      "token_start": 73,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 24010,
      "end_ms": 25110,
      "text": "你猜他怎么选？",
      "token_start": 81,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 25930,
      "end_ms": 27630,
      "text": "他放下半生心血，",
      "token_start": 87,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 27950,
      "end_ms": 29310,
      "text": "悄悄离开伦敦，",
      "token_start": 94,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 29730,
      "end_ms": 30000,
      "text": "斩开，",
      "token_start": 100,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 30060,
      "end_ms": 32500,
      "text": "辗转多地冲破封锁。",
      "token_start": 102,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 32980,
      "end_ms": 34000,
      "text": "一九五零年，",
      "token_start": 110,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 34260,
      "end_ms": 36580,
      "text": "终于踏上祖国的故土。",
      "token_start": 115,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 36740,
      "end_ms": 37540,
      "text": "这一回去，",
      "token_start": 124,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 37740,
      "end_ms": 41420,
      "text": "他干了一件让全世界瞠目结舌的事，",
      "token_start": 128,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 41880,
      "end_ms": 48000,
      "text": "把扣在中国头上几十年的平游国帽子亲手撕了个粉碎。",
      "token_start": 143,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 48560,
      "end_ms": 49680,
      "text": "啥叫平游国？",
      "token_start": 166,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 50060,
      "end_ms": 50520,
      "text": "说出来，",
      "token_start": 171,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 50520,
      "end_ms": 51300,
      "text": "你可能不信。",
      "token_start": 174,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 51840,
      "end_ms": 53320,
      "text": "二十世纪上半叶，",
      "token_start": 179,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 53620,
      "end_ms": 55540,
      "text": "国际地质界流行一句话，",
      "token_start": 186,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 56040,
      "end_ms": 60350,
      "text": "中国平游一九二二年美国斯坦福大学。",
      "token_start": 196,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 60490,
      "end_ms": 62325,
      "text": "一位教授公开断言，",
      "token_start": 212,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 62780,
      "end_ms": 65685,
      "text": "中国东北不会有大量食言，",
      "token_start": 220,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 66220,
      "end_ms": 68100,
      "text": "此前美孚石油公司，",
      "token_start": 231,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 68100,
      "end_ms": 70670,
      "text": "跑到中国西北打了足足七口，",
      "token_start": 239,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 70670,
      "end_ms": 72365,
      "text": "井一滴油都没见着，",
      "token_start": 251,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 73240,
      "end_ms": 76435,
      "text": "于是西方给中国扣上了一顶帽子。",
      "token_start": 259,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 77500,
      "end_ms": 78465,
      "text": "平游国，",
      "token_start": 273,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 79210,
      "end_ms": 80575,
      "text": "这顶帽子有多重？",
      "token_start": 276,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 81530,
      "end_ms": 82345,
      "text": "你琢磨琢磨，",
      "token_start": 283,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 83350,
      "end_ms": 85105,
      "text": "一个没有石油的国家，",
      "token_start": 288,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 85340,
      "end_ms": 86455,
      "text": "飞机上不了天，",
      "token_start": 297,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 87000,
      "end_ms": 88000,
      "text": "坦克跑不动，",
      "token_start": 303,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 88000,
      "end_ms": 90055,
      "text": "路工业的血库是干的。",
      "token_start": 308,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 90440,
      "end_ms": 91415,
      "text": "谈什么强国，",
      "token_start": 317,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 92160,
      "end_ms": 93565,
      "text": "从一九二八年起，",
      "token_start": 322,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 93950,
      "end_ms": 95755,
      "text": "李四光就公开发声，",
      "token_start": 329,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 96140,
      "end_ms": 97585,
      "text": "跟平游论叫板。",
      "token_start": 337,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 98280,
      "end_ms": 99255,
      "text": "一九三五年，",
      "token_start": 343,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 99590,
      "end_ms": 103155,
      "text": "他在英国多所大学演讲明确指出，",
      "token_start": 348,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 103660,
      "end_ms": 110295,
      "text": "新华夏构造体系的内陆沉降带蕴藏着巨大的找由原景。",
      "token_start": 362,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 111020,
      "end_ms": 112805,
      "text": "啥是新华夏构造体系？",
      "token_start": 385,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 113440,
      "end_ms": 114225,
      "text": "说人话，",
      "token_start": 394,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 114700,
      "end_ms": 116445,
      "text": "地球在应力作用下，",
      "token_start": 397,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 116800,
      "end_ms": 121950,
      "text": "在中国东部挤出了一连串北北东走向的盆地带，",
      "token_start": 405,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 122490,
      "end_ms": 125250,
      "text": "像一条条被压出来的长槽，",
      "token_start": 425,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 125970,
      "end_ms": 129250,
      "text": "李四光把这些沉降带分成三个，",
      "token_start": 436,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 130090,
      "end_ms": 136250,
      "text": "等于在地图上给新中国的石油勘探画出了三道金线。",
      "token_start": 449,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 137970,
      "end_ms": 138950,
      "text": "一九五二年，",
      "token_start": 471,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 139310,
      "end_ms": 142850,
      "text": "李四光出任新中国首任地质部部长。",
      "token_start": 476,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 143550,
      "end_ms": 144750,
      "text": "一九五三年底，",
      "token_start": 491,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 144990,
      "end_ms": 149665,
      "text": "毛泽东主席周南总理在中南海专门把他请了去，",
      "token_start": 497,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 150070,
      "end_ms": 151190,
      "text": "当面问了一句话，",
      "token_start": 517,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 152090,
      "end_ms": 155930,
      "text": "中国的地下到底能不能找到石油？",
      "token_start": 524,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 156790,
      "end_ms": 158550,
      "text": "当时国内外多少权威，",
      "token_start": 538,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 158790,
      "end_ms": 160350,
      "text": "早就把话说死了。",
      "token_start": 547,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 160730,
      "end_ms": 162330,
      "text": "中国没有大油田，",
      "token_start": 554,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 162690,
      "end_ms": 164370,
      "text": "顶着全世界的质疑。",
      "token_start": 561,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 164790,
      "end_ms": 168370,
      "text": "李四光摊开自己手绘的中国地质草图，",
      "token_start": 569,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 168850,
      "end_ms": 169990,
      "text": "斩钉截铁，",
      "token_start": 585,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 170390,
      "end_ms": 173330,
      "text": "倾华夏构造体系的三大沉降带，",
      "token_start": 589,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 173850,
      "end_ms": 175310,
      "text": "既生油又出油。",
      "token_start": 602,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 175670,
      "end_ms": 177710,
      "text": "中国绝不会平油。",
      "token_start": 608,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 178370,
      "end_ms": 179505,
      "text": "一九五四年，",
      "token_start": 615,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 179860,
      "end_ms": 183865,
      "text": "全国石油地质普查委员会成立李四光亲任主任。",
      "token_start": 620,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 184580,
      "end_ms": 191015,
      "text": "一场史无前例的石油大会战在九百六十万平方公里的土地上铺开了。",
      "token_start": 640,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 192010,
      "end_ms": 193495,
      "text": "那时候的勘探队员，",
      "token_start": 669,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 194000,
      "end_ms": 196545,
      "text": "背着仪弃走进茫茫荒原，",
      "token_start": 677,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 197050,
      "end_ms": 198155,
      "text": "风餐露宿，",
      "token_start": 687,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 198530,
      "end_ms": 200045,
      "text": "没人知道能不能找到。",
      "token_start": 691,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 200300,
      "end_ms": 201195,
      "text": "可没人退缩，",
      "token_start": 700,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 201700,
      "end_ms": 203045,
      "text": "可很少有人知道，",
      "token_start": 705,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 203320,
      "end_ms": 206835,
      "text": "这场大会战的总指挥自己正在拼着命找牛。",
      "token_start": 712,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 209520,
      "end_ms": 210475,
      "text": "一九五七年，",
      "token_start": 730,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 210920,
      "end_ms": 212875,
      "text": "长期透支的李四光，",
      "token_start": 735,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 213340,
      "end_ms": 215735,
      "text": "因为节石切除了左肾，",
      "token_start": 743,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 216340,
      "end_ms": 217305,
      "text": "只剩一个肾，",
      "token_start": 752,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 217950,
      "end_ms": 219875,
      "text": "医生反复叮嘱静养，",
      "token_start": 757,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 221470,
      "end_ms": 222355,
      "text": "必须敬仰。",
      "token_start": 765,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 223250,
      "end_ms": 227275,
      "text": "可他的心从来没有离开过勘探前线。",
      "token_start": 769,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 228250,
      "end_ms": 231495,
      "text": "有人劝他一把年纪了，",
      "token_start": 784,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 231860,
      "end_ms": 235875,
      "text": "野外吃苦的事儿交给年轻人吧。",
      "token_start": 793,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 237340,
      "end_ms": 241775,
      "text": "李四光摇摇头说了一句让人鼻子发酸的话，",
      "token_start": 806,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 242550,
      "end_ms": 244865,
      "text": "地质工作就是要跑野外，",
      "token_start": 824,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 245800,
      "end_ms": 250345,
      "text": "坐在办公室里是找不到石油的荒山野岭，",
      "token_start": 834,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 250650,
      "end_ms": 251595,
      "text": "风餐露宿，",
      "token_start": 851,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 252570,
      "end_ms": 254565,
      "text": "一个只剩一个肾的老人，",
      "token_start": 855,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 254690,
      "end_ms": 254825,
      "text": "嗯，",
      "token_start": 865,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 255420,
      "end_ms": 258995,
      "text": "带着队伍翻遍山河历史，",
      "token_start": 866,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 259230,
      "end_ms": 261905,
      "text": "给了这位老人最响亮的回音。",
      "token_start": 876,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 262170,
      "end_ms": 264245,
      "text": "一九五九年九月二十六日，",
      "token_start": 888,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 264680,
      "end_ms": 268985,
      "text": "松积三井在松辽盆地喷出工业油流，",
      "token_start": 899,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 269460,
      "end_ms": 271875,
      "text": "大庆油田横空出世。",
      "token_start": 914,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 272310,
      "end_ms": 276225,
      "text": "从一九五五年全国普查启动到大庆突破，",
      "token_start": 922,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 276810,
      "end_ms": 279260,
      "text": "只用了大约四年四年。",
      "token_start": 939,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 279300,
      "end_ms": 284985,
      "text": "一个被全世界断言无有可救的平庸国打出了自己的大油田。",
      "token_start": 948,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 285570,
      "end_ms": 286365,
      "text": "大庆之后，",
      "token_start": 973,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 286710,
      "end_ms": 288715,
      "text": "华北大港胜利，",
      "token_start": 977,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 289050,
      "end_ms": 293565,
      "text": "辽河、江汉、南阳油田一个接一个被发现，",
      "token_start": 983,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 294140,
      "end_ms": 297705,
      "text": "东北、华北乃至两湖的地下喜讯不断。",
      "token_start": 999,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 298230,
      "end_ms": 299150,
      "text": "一九六三年，",
      "token_start": 1014,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 299150,
      "end_ms": 303375,
      "text": "周恩来总理在二届人大四次会议上庄严宣告。",
      "token_start": 1019,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 303910,
      "end_ms": 309070,
      "text": "我国需要的石油现在可以基本自己听到这句话，",
      "token_start": 1038,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 309530,
      "end_ms": 315410,
      "text": "李四光这个大半生被西方冷眼相待的科学家热泪盈眶。",
      "token_start": 1058,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 316270,
      "end_ms": 320150,
      "text": "当年哪顶扣在中国头上的贫油帽子，",
      "token_start": 1081,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 320450,
      "end_ms": 324030,
      "text": "被他自己亲手摘了下来。",
      "token_start": 1096,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 324510,
      "end_ms": 328590,
      "text": "很多人以为李四光这一生的功劳到此就结束，",
      "token_start": 1106,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 329150,
      "end_ms": 335380,
      "text": "石油有了功业的血库满了这位老人总该先这一些了吧？",
      "token_start": 1125,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 335380,
      "end_ms": 336640,
      "text": "可很少有人知道，",
      "token_start": 1148,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 337400,
      "end_ms": 340580,
      "text": "就在石油难题即将攻克的同时，",
      "token_start": 1155,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 341080,
      "end_ms": 344040,
      "text": "还有一道更凶险的国防难关。",
      "token_start": 1168,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 344400,
      "end_ms": 345480,
      "text": "横在他面前，",
      "token_start": 1180,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 345900,
      "end_ms": 351340,
      "text": "造原子弹必不可少的油矿遭到全世界封锁，",
      "token_start": 1185,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 351620,
      "end_ms": 352240,
      "text": "没有油，",
      "token_start": 1203,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 352720,
      "end_ms": 354340,
      "text": "两弹就是一句空话。",
      "token_start": 1206,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 354820,
      "end_ms": 361040,
      "text": "这道关他怎么闯他生命的最后几年又拼到了什么程度？",
      "token_start": 1214,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 361620,
      "end_ms": 363435,
      "text": "咱们下级大结局，",
      "token_start": 1237,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 364490,
      "end_ms": 365990,
      "text": "关注我下集，",
      "token_start": 1244,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 365990,
      "end_ms": 368420,
      "text": "带你看一个八十二岁的老人。",
      "token_start": 1249,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 368540,
      "end_ms": 374900,
      "text": "如何把最后的光烧成两代人的信仰、点赞、收藏、转发，",
      "token_start": 1261,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 375180,
      "end_ms": 376595,
      "text": "让更多人知道。",
      "token_start": 1282,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 377490,
      "end_ms": 379455,
      "text": "今天我们开车加满油，",
      "token_start": 1288,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 380050,
      "end_ms": 383090,
      "text": "背后有这样一个拼着命找由的人。",
      "token_start": 1297,
      "token_end_exclusive": 1311
    }
  ],
