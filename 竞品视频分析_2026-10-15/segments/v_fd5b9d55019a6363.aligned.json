{
  "video_id": "v_fd5b9d55019a6363",
  "duration_s": 331.929002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_fd5b9d55019a6363.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_fd5b9d55019a6363.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 270,
      "end_ms": 2470,
      "text": "领导的暗示你能听懂吗？",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 4030,
      "end_ms": 6570,
      "text": "你和王宇把后备箱的茅台拿上去。",
      "token_start": 10,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6650,
      "end_ms": 6890,
      "text": "哎，",
      "token_start": 24,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6930,
      "end_ms": 7285,
      "text": "好，",
      "token_start": 25,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 10190,
      "end_ms": 10430,
      "text": "哎，",
      "token_start": 26,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 10670,
      "end_ms": 11510,
      "text": "这里没有啊，",
      "token_start": 27,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 13210,
      "end_ms": 13610,
      "text": "哎呦，",
      "token_start": 32,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 13750,
      "end_ms": 14330,
      "text": "被偷了。",
      "token_start": 34,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 14330,
      "end_ms": 15430,
      "text": "这张总张总，",
      "token_start": 37,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 16490,
      "end_ms": 17290,
      "text": "我去告诉张总，",
      "token_start": 42,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 17290,
      "end_ms": 18110,
      "text": "茅台被偷了，",
      "token_start": 48,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 19370,
      "end_ms": 19610,
      "text": "哎，",
      "token_start": 53,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 19610,
      "end_ms": 20330,
      "text": "你干什么呀？",
      "token_start": 54,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 20590,
      "end_ms": 21510,
      "text": "这酒都被偷了，",
      "token_start": 59,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 21510,
      "end_ms": 22470,
      "text": "你以为我跟你闹玩呢？",
      "token_start": 65,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 22630,
      "end_ms": 24090,
      "text": "我是怕你犯蠢张，",
      "token_start": 74,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 24090,
      "end_ms": 25770,
      "text": "总能不知道他车里没有酒吗？",
      "token_start": 81,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 25950,
      "end_ms": 28470,
      "text": "职场上最忌讳的就是会错领导的意，",
      "token_start": 93,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 28510,
      "end_ms": 29410,
      "text": "这车里没有酒，",
      "token_start": 108,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 29770,
      "end_ms": 31090,
      "text": "领导还让你送上去，",
      "token_start": 114,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 31090,
      "end_ms": 32330,
      "text": "说明他只在意结果。",
      "token_start": 122,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 32490,
      "end_ms": 34550,
      "text": "比起寻找车内酒的去向和真实性，",
      "token_start": 130,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 34690,
      "end_ms": 37210,
      "text": "首当其冲的是先满足领导的需求啊，",
      "token_start": 144,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 37390,
      "end_ms": 39140,
      "text": "这么点事儿都干不利索。",
      "token_start": 159,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 39920,
      "end_ms": 40580,
      "text": "那个领导，",
      "token_start": 169,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 40860,
      "end_ms": 41580,
      "text": "您后备箱，",
      "token_start": 173,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 41580,
      "end_ms": 42360,
      "text": "我不好意思翻，",
      "token_start": 177,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 42520,
      "end_ms": 43260,
      "text": "就自己准备了。",
      "token_start": 183,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 43260,
      "end_ms": 44460,
      "text": "四瓶有两瓶，",
      "token_start": 189,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 44460,
      "end_ms": 45340,
      "text": "放您后备箱了，",
      "token_start": 194,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 45460,
      "end_ms": 46360,
      "text": "这两瓶拿出来，",
      "token_start": 200,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 46380,
      "end_ms": 46900,
      "text": "您先用，",
      "token_start": 206,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 46960,
      "end_ms": 48400,
      "text": "你这酒量可以啊，",
      "token_start": 209,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 48900,
      "end_ms": 51140,
      "text": "这个项目啊就交给你们公司了，",
      "token_start": 216,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 51200,
      "end_ms": 51980,
      "text": "谢谢谢谢。",
      "token_start": 229,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 52140,
      "end_ms": 54380,
      "text": "慢走啊随风啊，",
      "token_start": 233,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 54560,
      "end_ms": 55700,
      "text": "还是你想的周到，",
      "token_start": 239,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 55820,
      "end_ms": 57620,
      "text": "把白酒提前换成了雪碧，",
      "token_start": 246,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 57820,
      "end_ms": 60480,
      "text": "否则啊李总这一单还真不一定拿得下，",
      "token_start": 256,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 60640,
      "end_ms": 62400,
      "text": "这个项目就由你来负责吧。",
      "token_start": 272,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 62400,
      "end_ms": 62580,
      "text": "哎，",
      "token_start": 283,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 62580,
      "end_ms": 62820,
      "text": "哎，",
      "token_start": 284,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 62900,
      "end_ms": 63415,
      "text": "对了，",
      "token_start": 285,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 63860,
      "end_ms": 64780,
      "text": "明天下午三点，",
      "token_start": 287,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 64900,
      "end_ms": 67720,
      "text": "你们一块来我家商讨一下李总这个项目的方案。",
      "token_start": 293,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 67760,
      "end_ms": 69065,
      "text": "好好好好好，",
      "token_start": 313,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 69830,
      "end_ms": 70010,
      "text": "哎，",
      "token_start": 318,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 70010,
      "end_ms": 70350,
      "text": "张总，",
      "token_start": 319,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 70350,
      "end_ms": 71055,
      "text": "我送送你啊。",
      "token_start": 321,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 72190,
      "end_ms": 75385,
      "text": "签合同啊是要领导在客户面前保持清醒的，",
      "token_start": 326,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 75720,
      "end_ms": 77375,
      "text": "这样也能保证公司形象。",
      "token_start": 344,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 77970,
      "end_ms": 79595,
      "text": "那倒瓶矿泉水不就行了，",
      "token_start": 354,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 79980,
      "end_ms": 80900,
      "text": "怎么还整瓶雪碧，",
      "token_start": 364,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 81180,
      "end_ms": 82020,
      "text": "白酒挂杯，",
      "token_start": 371,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 82180,
      "end_ms": 83075,
      "text": "但水不挂，",
      "token_start": 375,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 83400,
      "end_ms": 84605,
      "text": "这样更容易被发现。",
      "token_start": 379,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 85040,
      "end_ms": 86540,
      "text": "但是雪碧跟白酒一样，",
      "token_start": 387,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 86680,
      "end_ms": 87565,
      "text": "都能挂杯，",
      "token_start": 396,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 88460,
      "end_ms": 89160,
      "text": "又学到了，",
      "token_start": 400,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 89160,
      "end_ms": 90000,
      "text": "这都两点半了，",
      "token_start": 404,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 90000,
      "end_ms": 91180,
      "text": "你怎么还不换衣服啊？",
      "token_start": 410,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 91380,
      "end_ms": 92740,
      "text": "人王宇早就过去了，",
      "token_start": 419,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 92860,
      "end_ms": 94700,
      "text": "现在是竞争副总的关键时刻，",
      "token_start": 427,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 94760,
      "end_ms": 95860,
      "text": "咱早点过去好表现，",
      "token_start": 439,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 95860,
      "end_ms": 97200,
      "text": "表现呢不着急，",
      "token_start": 447,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 97420,
      "end_ms": 98665,
      "text": "早点去显得重视。",
      "token_start": 453,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 98970,
      "end_ms": 100130,
      "text": "家是私人场所，",
      "token_start": 460,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 100250,
      "end_ms": 101090,
      "text": "不要提前到，",
      "token_start": 466,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 101290,
      "end_ms": 102230,
      "text": "尤其是张总家，",
      "token_start": 471,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 102230,
      "end_ms": 102930,
      "text": "孩子还小，",
      "token_start": 477,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 103090,
      "end_ms": 104230,
      "text": "正是忙乱的时候，",
      "token_start": 481,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 104390,
      "end_ms": 105730,
      "text": "万一人家突击准备，",
      "token_start": 488,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 105790,
      "end_ms": 106550,
      "text": "你提前去了，",
      "token_start": 496,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 106550,
      "end_ms": 107330,
      "text": "多尴尬呀，",
      "token_start": 501,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 107330,
      "end_ms": 108470,
      "text": "咱准时到就行。",
      "token_start": 505,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 108590,
      "end_ms": 108825,
      "text": "哎，",
      "token_start": 511,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 109030,
      "end_ms": 109535,
      "text": "还有啊，",
      "token_start": 512,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 109740,
      "end_ms": 111520,
      "text": "你赶紧去把你这身西装给换掉，",
      "token_start": 515,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 111720,
      "end_ms": 113060,
      "text": "人家张总让咱们去他家，",
      "token_start": 528,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 113060,
      "end_ms": 114360,
      "text": "那是没把咱们当外人，",
      "token_start": 538,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 114600,
      "end_ms": 115980,
      "text": "你这穿一身职业装去，",
      "token_start": 547,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 116180,
      "end_ms": 117700,
      "text": "这不是跟人家疏远关系吗？",
      "token_start": 556,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 117740,
      "end_ms": 117980,
      "text": "好，",
      "token_start": 567,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 118140,
      "end_ms": 122200,
      "text": "我这就去换张总张总，",
      "token_start": 568,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 122600,
      "end_ms": 124180,
      "text": "这是思义送给嫂子的礼物。",
      "token_start": 577,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 124600,
      "end_ms": 125860,
      "text": "你们俩太客气了，",
      "token_start": 588,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 126280,
      "end_ms": 126520,
      "text": "来，",
      "token_start": 595,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 126660,
      "end_ms": 127400,
      "text": "快进快进。",
      "token_start": 596,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 128480,
      "end_ms": 128960,
      "text": "哎呀，",
      "token_start": 600,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 129260,
      "end_ms": 130880,
      "text": "来了张总，",
      "token_start": 602,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 130880,
      "end_ms": 131840,
      "text": "让你们三点来，",
      "token_start": 606,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 132080,
      "end_ms": 133400,
      "text": "你们还真三点来啊。",
      "token_start": 612,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 134440,
      "end_ms": 134680,
      "text": "哎，",
      "token_start": 620,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 134800,
      "end_ms": 135540,
      "text": "这么久了，",
      "token_start": 621,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 135560,
      "end_ms": 136860,
      "text": "咋没见嫂子出现呀，",
      "token_start": 625,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 138240,
      "end_ms": 139260,
      "text": "女主人不出现，",
      "token_start": 633,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 139500,
      "end_ms": 140980,
      "text": "大概率就是不欢迎他，",
      "token_start": 639,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 141940,
      "end_ms": 142840,
      "text": "你想多了吧，",
      "token_start": 648,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 143620,
      "end_ms": 144400,
      "text": "随风思夜，",
      "token_start": 653,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 144400,
      "end_ms": 145060,
      "text": "你们来啊。",
      "token_start": 657,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 145480,
      "end_ms": 145720,
      "text": "哎，",
      "token_start": 661,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 145860,
      "end_ms": 150600,
      "text": "嫂子今天为孩子啊弄得到处都是，",
      "token_start": 662,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 151140,
      "end_ms": 152280,
      "text": "还没等收拾完，",
      "token_start": 676,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 152580,
      "end_ms": 153420,
      "text": "他就来了，",
      "token_start": 682,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 154180,
      "end_ms": 156060,
      "text": "也不想想别人方不方便，",
      "token_start": 686,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 156840,
      "end_ms": 159400,
      "text": "真不懂礼数来喝水啊。",
      "token_start": 696,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 160940,
      "end_ms": 161340,
      "text": "好呀，",
      "token_start": 705,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 161340,
      "end_ms": 162100,
      "text": "谢谢张总，",
      "token_start": 707,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 162260,
      "end_ms": 162480,
      "text": "哎，",
      "token_start": 711,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 162480,
      "end_ms": 163120,
      "text": "谢谢张总。",
      "token_start": 712,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 164260,
      "end_ms": 164500,
      "text": "好，",
      "token_start": 716,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 165220,
      "end_ms": 166360,
      "text": "就这么决定了啊，",
      "token_start": 717,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 168180,
      "end_ms": 169060,
      "text": "时间不早了，",
      "token_start": 724,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 169720,
      "end_ms": 170920,
      "text": "就不在家里做了，",
      "token_start": 729,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 171240,
      "end_ms": 172160,
      "text": "咱们出去吃吧。",
      "token_start": 736,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 173500,
      "end_ms": 173960,
      "text": "好好，",
      "token_start": 742,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 174540,
      "end_ms": 174780,
      "text": "哎，",
      "token_start": 744,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 174960,
      "end_ms": 175580,
      "text": "正好啊，",
      "token_start": 745,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 175720,
      "end_ms": 176880,
      "text": "我媳妇今晚不在家，",
      "token_start": 748,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 176960,
      "end_ms": 177985,
      "text": "都没地儿吃饭了。",
      "token_start": 756,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 179760,
      "end_ms": 180340,
      "text": "张总啊，",
      "token_start": 763,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 180340,
      "end_ms": 181465,
      "text": "我们家还有事儿呢，",
      "token_start": 766,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 182110,
      "end_ms": 183090,
      "text": "那我们就先走了。",
      "token_start": 774,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 183290,
      "end_ms": 183605,
      "text": "行，",
      "token_start": 781,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 184110,
      "end_ms": 186030,
      "text": "既然有事儿就不留你们了啊。",
      "token_start": 782,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 186250,
      "end_ms": 186490,
      "text": "哦，",
      "token_start": 794,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 188100,
      "end_ms": 190040,
      "text": "嗯嗯张总家的茶是真香，",
      "token_start": 795,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 190240,
      "end_ms": 191320,
      "text": "刚才聊的太尽兴，",
      "token_start": 805,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 191320,
      "end_ms": 192125,
      "text": "都忘记尝了。",
      "token_start": 812,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 192290,
      "end_ms": 195575,
      "text": "随风你也尝一下好喝，",
      "token_start": 817,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 196550,
      "end_ms": 197685,
      "text": "那我们就不打扰了。",
      "token_start": 826,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 197930,
      "end_ms": 199000,
      "text": "张总张总，",
      "token_start": 834,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 199040,
      "end_ms": 199620,
      "text": "我们走了，",
      "token_start": 838,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 199660,
      "end_ms": 200405,
      "text": "下次再见。",
      "token_start": 842,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 200850,
      "end_ms": 201550,
      "text": "慢走啊，",
      "token_start": 846,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 201610,
      "end_ms": 202375,
      "text": "慢走啊，",
      "token_start": 849,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 204970,
      "end_ms": 206210,
      "text": "咱家哪有什么事儿啊，",
      "token_start": 852,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 206430,
      "end_ms": 207690,
      "text": "嫂子叫咱出去吃饭，",
      "token_start": 861,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 207810,
      "end_ms": 208230,
      "text": "咱不去，",
      "token_start": 869,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 208230,
      "end_ms": 209195,
      "text": "不是不给面子吗？",
      "token_start": 872,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 209560,
      "end_ms": 211945,
      "text": "张总夫人看似是在叫你一块儿吃饭，",
      "token_start": 879,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 212410,
      "end_ms": 213770,
      "text": "其实是在下逐客令，",
      "token_start": 894,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 213910,
      "end_ms": 215405,
      "text": "像是改天一块吃饭，",
      "token_start": 902,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 215790,
      "end_ms": 218075,
      "text": "或者是今天不在家吃了出去吃，",
      "token_start": 910,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 218480,
      "end_ms": 220040,
      "text": "这些都不是真的找你吃饭，",
      "token_start": 923,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 220420,
      "end_ms": 221700,
      "text": "而是在下逐客令，",
      "token_start": 934,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 221980,
      "end_ms": 222720,
      "text": "那都要走了，",
      "token_start": 941,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 222720,
      "end_ms": 223925,
      "text": "你怎么还喝起茶来了？",
      "token_start": 946,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 224180,
      "end_ms": 225220,
      "text": "喝主人家的茶，",
      "token_start": 955,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 225460,
      "end_ms": 228465,
      "text": "是对主人家表示尊重啊啊，",
      "token_start": 961,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 228940,
      "end_ms": 229675,
      "text": "原来如此。",
      "token_start": 972,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 229990,
      "end_ms": 230285,
      "text": "嗯，",
      "token_start": 976,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 232030,
      "end_ms": 232390,
      "text": "随风，",
      "token_start": 977,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 232390,
      "end_ms": 233455,
      "text": "你做事有分寸，",
      "token_start": 979,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 234030,
      "end_ms": 236195,
      "text": "公司二把手就需要你这种人才。",
      "token_start": 985,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 236870,
      "end_ms": 238850,
      "text": "这王宇明明业务能力比我强，",
      "token_start": 998,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 239170,
      "end_ms": 239810,
      "text": "我怎么还？",
      "token_start": 1010,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 240070,
      "end_ms": 241145,
      "text": "能力固然重要，",
      "token_start": 1014,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 241430,
      "end_ms": 243985,
      "text": "但越是高位的越需要注意人情世故。",
      "token_start": 1020,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 244380,
      "end_ms": 245500,
      "text": "王宇连这都不懂，",
      "token_start": 1035,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 245640,
      "end_ms": 248035,
      "text": "张总怎么敢放心把副总的位置交给他，",
      "token_start": 1042,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 248450,
      "end_ms": 249965,
      "text": "就没想到有这么多讲究啊。",
      "token_start": 1058,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 250260,
      "end_ms": 251820,
      "text": "人情世故无小事，",
      "token_start": 1069,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 252200,
      "end_ms": 253605,
      "text": "细节决定成败，",
      "token_start": 1076,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 254030,
      "end_ms": 256405,
      "text": "你呀多看看这本闲谈高手。",
      "token_start": 1082,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 256770,
      "end_ms": 257770,
      "text": "假如你不爱说话，",
      "token_start": 1093,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 257910,
      "end_ms": 258590,
      "text": "不爱争辩，",
      "token_start": 1100,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 258670,
      "end_ms": 259530,
      "text": "也不爱出门，",
      "token_start": 1104,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 259610,
      "end_ms": 260730,
      "text": "甚至恐惧社交，",
      "token_start": 1109,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 260910,
      "end_ms": 262145,
      "text": "你就每天看两页，",
      "token_start": 1115,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 262440,
      "end_ms": 263635,
      "text": "每一个场景慢慢练，",
      "token_start": 1122,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 263980,
      "end_ms": 265680,
      "text": "你也会变成一个会说话的人。",
      "token_start": 1130,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 265760,
      "end_ms": 266940,
      "text": "当时听到这句话的时候，",
      "token_start": 1142,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 266940,
      "end_ms": 268035,
      "text": "我的眼泪就出来了。",
      "token_start": 1152,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 268280,
      "end_ms": 270300,
      "text": "他写的是别人夸你优秀你就回，",
      "token_start": 1160,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 270520,
      "end_ms": 271480,
      "text": "那是不优秀点，",
      "token_start": 1173,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 271500,
      "end_ms": 272700,
      "text": "怎么能和你做朋友？",
      "token_start": 1179,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 272700,
      "end_ms": 273680,
      "text": "你看很有味道，",
      "token_start": 1187,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 273740,
      "end_ms": 274640,
      "text": "假如不爱说话，",
      "token_start": 1193,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 274660,
      "end_ms": 275300,
      "text": "不爱争辩，",
      "token_start": 1199,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 275300,
      "end_ms": 276060,
      "text": "也不爱出门，",
      "token_start": 1203,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 276080,
      "end_ms": 277080,
      "text": "甚至恐惧社交。",
      "token_start": 1208,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 277200,
      "end_ms": 278335,
      "text": "你每天就看两页，",
      "token_start": 1214,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 278570,
      "end_ms": 279930,
      "text": "每一个场景慢慢练，",
      "token_start": 1221,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 280070,
      "end_ms": 282410,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 1229,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 282610,
      "end_ms": 282850,
      "text": "哇，",
      "token_start": 1244,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 282850,
      "end_ms": 283810,
      "text": "这真是太棒了。",
      "token_start": 1245,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 283810,
      "end_ms": 284650,
      "text": "在这本书里边，",
      "token_start": 1251,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 284650,
      "end_ms": 285830,
      "text": "有一句话我特别欣赏。",
      "token_start": 1257,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 285910,
      "end_ms": 287570,
      "text": "他说有人嘲讽你眼睛小，",
      "token_start": 1266,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 287830,
      "end_ms": 288750,
      "text": "高情商回答，",
      "token_start": 1276,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 288790,
      "end_ms": 289770,
      "text": "万物皆有裂痕，",
      "token_start": 1281,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 289890,
      "end_ms": 291295,
      "text": "那是光照进来的地方。",
      "token_start": 1287,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 291580,
      "end_ms": 291780,
      "text": "哇，",
      "token_start": 1296,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 291780,
      "end_ms": 292720,
      "text": "这真是太棒了，",
      "token_start": 1297,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 292720,
      "end_ms": 293840,
      "text": "每一句都很有意思，",
      "token_start": 1303,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 293860,
      "end_ms": 294280,
      "text": "随便翻，",
      "token_start": 1311,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 294280,
      "end_ms": 294680,
      "text": "对吧？",
      "token_start": 1314,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 294820,
      "end_ms": 295060,
      "text": "哇，",
      "token_start": 1316,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 295100,
      "end_ms": 296095,
      "text": "这句话太好了，",
      "token_start": 1317,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 296390,
      "end_ms": 298730,
      "text": "他写的是别人问你一个月工资多少，",
      "token_start": 1323,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 298870,
      "end_ms": 300655,
      "text": "你就回比以前好多了。",
      "token_start": 1338,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 300920,
      "end_ms": 302725,
      "text": "现在吃泡面敢放两根肠了。",
      "token_start": 1347,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 303020,
      "end_ms": 304020,
      "text": "我读到这段的时候，",
      "token_start": 1358,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 304020,
      "end_ms": 306200,
      "text": "我觉得这个让我真是一解心开啊，",
      "token_start": 1366,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 306540,
      "end_ms": 308365,
      "text": "这本书就像是个社交宝典，",
      "token_start": 1380,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 308760,
      "end_ms": 311805,
      "text": "把各种社交场景都变成了问题加答案的形式。",
      "token_start": 1391,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 312080,
      "end_ms": 314515,
      "text": "你说哪家的书架上不应该有一本这个书，",
      "token_start": 1410,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 314830,
      "end_ms": 317870,
      "text": "就是手把手的教我们不同的场景之下应该怎么说？",
      "token_start": 1427,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 318230,
      "end_ms": 320690,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1448,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 320690,
      "end_ms": 321870,
      "text": "你就放心拿回去看，",
      "token_start": 1466,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 321930,
      "end_ms": 323290,
      "text": "就是一句一句的教你，",
      "token_start": 1474,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 323530,
      "end_ms": 326230,
      "text": "这是我这几年来讲过的最简单的一本书。",
      "token_start": 1483,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 326350,
      "end_ms": 327890,
      "text": "我觉得这书适合所有人，",
      "token_start": 1500,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 328030,
      "end_ms": 328550,
      "text": "让你不管，",
      "token_start": 1510,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 328550,
      "end_ms": 330705,
      "text": "在任何场合都能够轻松拿捏，",
      "token_start": 1514,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 331010,
      "end_ms": 331855,
      "text": "所以强烈推荐。",
      "token_start": 1526,
      "token_end_exclusive": 1532
    }
  ],
