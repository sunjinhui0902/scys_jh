{
  "video_id": "v_7fa3a84d41edebb9",
  "duration_s": 672.032993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_7fa3a84d41edebb9.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_7fa3a84d41edebb9.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 330,
      "end_ms": 4050,
      "text": "您知道中国此生必看的十大壮丽奇观岭，",
      "token_start": 0,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4430,
      "end_ms": 6330,
      "text": "最震撼的是哪一个吗？",
      "token_start": 17,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6730,
      "end_ms": 7270,
      "text": "上集，",
      "token_start": 26,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7290,
      "end_ms": 16010,
      "text": "咱们聊了黄山、鸣沙山月牙泉、黄果树瀑布、张家界、武陵源、秦始皇陵兵马俑。",
      "token_start": 28,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 16670,
      "end_ms": 18050,
      "text": "有人在评论区说，",
      "token_start": 58,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 18390,
      "end_ms": 20730,
      "text": "兵马俑鞋底的针脚听得人心，",
      "token_start": 65,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 20730,
      "end_ms": 21390,
      "text": "头一震，",
      "token_start": 77,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 21810,
      "end_ms": 22650,
      "text": "可我跟您说，",
      "token_start": 80,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 22950,
      "end_ms": 25350,
      "text": "兵马俑排第六后头，",
      "token_start": 85,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 25350,
      "end_ms": 28370,
      "text": "这五个才真正叫改写认知榜首，",
      "token_start": 93,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 28470,
      "end_ms": 31000,
      "text": "那个地方全是世界都听过，",
      "token_start": 106,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 31360,
      "end_ms": 35920,
      "text": "可绝大多数人不知道他的真实模样有多震撼。",
      "token_start": 117,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 36340,
      "end_ms": 38480,
      "text": "老规矩开讲前，",
      "token_start": 136,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 38920,
      "end_ms": 41960,
      "text": "劳烦各位老友顺手点亮红心。",
      "token_start": 142,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 42280,
      "end_ms": 44000,
      "text": "评论区打的来了，",
      "token_start": 154,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 44640,
      "end_ms": 47880,
      "text": "咱们直接揭开前五名第五名，",
      "token_start": 161,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 48200,
      "end_ms": 50220,
      "text": "都江堰、四川成都。",
      "token_start": 173,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 50760,
      "end_ms": 54280,
      "text": "这是整张榜单里最不像奇观的一处，",
      "token_start": 180,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 54920,
      "end_ms": 56320,
      "text": "它长得太素了，",
      "token_start": 195,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 56720,
      "end_ms": 59260,
      "text": "就是一条江一堆石头，",
      "token_start": 201,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 59600,
      "end_ms": 60405,
      "text": "一条高低，",
      "token_start": 210,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 60900,
      "end_ms": 62440,
      "text": "可他是唯一一处，",
      "token_start": 214,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 62480,
      "end_ms": 64644,
      "text": "还在替咱们干活的老古董。",
      "token_start": 221,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 65350,
      "end_ms": 67095,
      "text": "两千两百多年前，",
      "token_start": 232,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 67560,
      "end_ms": 68400,
      "text": "李兵到这儿，",
      "token_start": 239,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 68400,
      "end_ms": 69325,
      "text": "当蜀郡守，",
      "token_start": 244,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 69860,
      "end_ms": 73305,
      "text": "面对的是一条年年发大水的岷江。",
      "token_start": 248,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 74030,
      "end_ms": 75845,
      "text": "别人治水是修大坝，",
      "token_start": 262,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 76120,
      "end_ms": 77415,
      "text": "赌李兵不堵，",
      "token_start": 270,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 77780,
      "end_ms": 80765,
      "text": "他在江中间拿竹笼装上鹅卵石，",
      "token_start": 275,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 81320,
      "end_ms": 83575,
      "text": "垒出一条分水的鱼嘴，",
      "token_start": 288,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 84250,
      "end_ms": 85825,
      "text": "把江一劈两半。",
      "token_start": 297,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 86230,
      "end_ms": 86670,
      "text": "冬天，",
      "token_start": 303,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 86730,
      "end_ms": 88310,
      "text": "水少六成，",
      "token_start": 305,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 88310,
      "end_ms": 92635,
      "text": "水自动拐进内江去灌成都平原的庄稼。",
      "token_start": 309,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 93230,
      "end_ms": 95520,
      "text": "夏天水大多余的水，",
      "token_start": 325,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 95560,
      "end_ms": 98675,
      "text": "自己翻出去从外疆抬走，",
      "token_start": 333,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 99060,
      "end_ms": 101620,
      "text": "不费一度电不烧一顿煤，",
      "token_start": 343,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 102000,
      "end_ms": 103555,
      "text": "没有任何高科技。",
      "token_start": 353,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 104180,
      "end_ms": 105540,
      "text": "两千两百年来，",
      "token_start": 360,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 105620,
      "end_ms": 107565,
      "text": "每天都在自动运转，",
      "token_start": 366,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 108070,
      "end_ms": 112290,
      "text": "硬生生把一个水旱灾害不断的地方浇灌，",
      "token_start": 374,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 112290,
      "end_ms": 115525,
      "text": "成了天下文明的天府之国粮仓。",
      "token_start": 391,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 115920,
      "end_ms": 117905,
      "text": "您站在鱼嘴上往下看，",
      "token_start": 404,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 118400,
      "end_ms": 122260,
      "text": "水就在那儿分分了两千两百年，",
      "token_start": 413,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 122760,
      "end_ms": 124180,
      "text": "一天没停过。",
      "token_start": 426,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 124620,
      "end_ms": 127420,
      "text": "前面兵马俑是两千两百年前做的，",
      "token_start": 431,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 128040,
      "end_ms": 129080,
      "text": "早就不用了。",
      "token_start": 445,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 129560,
      "end_ms": 131960,
      "text": "都江堰是两千两百年前建的，",
      "token_start": 450,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 132400,
      "end_ms": 133760,
      "text": "今天还在烧饭，",
      "token_start": 462,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 134300,
      "end_ms": 135240,
      "text": "还在灌地，",
      "token_start": 468,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 135820,
      "end_ms": 136920,
      "text": "这不是古迹，",
      "token_start": 472,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 137540,
      "end_ms": 138920,
      "text": "这是还在上班的。",
      "token_start": 477,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 138920,
      "end_ms": 139800,
      "text": "祖宗手艺。",
      "token_start": 484,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 140200,
      "end_ms": 140940,
      "text": "第四名，",
      "token_start": 488,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 141420,
      "end_ms": 142900,
      "text": "衡山悬空寺，",
      "token_start": 491,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 143560,
      "end_ms": 147940,
      "text": "山西浑源这一处是拿胆子看的，",
      "token_start": 496,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 148160,
      "end_ms": 149280,
      "text": "他不是盖在山上，",
      "token_start": 509,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 149280,
      "end_ms": 151090,
      "text": "是钉在山上。",
      "token_start": 516,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 151450,
      "end_ms": 154550,
      "text": "整座寺庙挂在金龙峡的绝壁上，",
      "token_start": 521,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 155110,
      "end_ms": 156530,
      "text": "离谷底几十米，",
      "token_start": 534,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 157030,
      "end_ms": 161250,
      "text": "四十来间房就这么贴着直上直下的岩壁排开。",
      "token_start": 540,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 161970,
      "end_ms": 163470,
      "text": "从下面往上看，",
      "token_start": 559,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 163990,
      "end_ms": 167830,
      "text": "像是从石头缝里长出来的一排燕子窝。",
      "token_start": 565,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 168250,
      "end_ms": 170170,
      "text": "您顺着窄梯子上去，",
      "token_start": 581,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 170790,
      "end_ms": 172370,
      "text": "脚底下踩的是木板，",
      "token_start": 589,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 172730,
      "end_ms": 173210,
      "text": "一踩，",
      "token_start": 597,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 173330,
      "end_ms": 174170,
      "text": "咯吱一响，",
      "token_start": 599,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 174830,
      "end_ms": 176390,
      "text": "扶着栏杆往下探头，",
      "token_start": 603,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 176390,
      "end_ms": 178310,
      "text": "下面就一道缝。",
      "token_start": 611,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 178310,
      "end_ms": 179630,
      "text": "风从窄，",
      "token_start": 617,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 179730,
      "end_ms": 180985,
      "text": "口口灌进来，",
      "token_start": 620,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 181410,
      "end_ms": 183355,
      "text": "整座楼跟着耳朵一起晃，",
      "token_start": 625,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 183900,
      "end_ms": 186200,
      "text": "他凭什么挂得住古人？",
      "token_start": 635,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 186220,
      "end_ms": 187995,
      "text": "每往石头上钉一根钉，",
      "token_start": 644,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 188770,
      "end_ms": 191345,
      "text": "而是在岩壁上凿出暗孔，",
      "token_start": 653,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 192160,
      "end_ms": 197090,
      "text": "把穆衡梁一头深深插进山体插进去的那一段，",
      "token_start": 663,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 197130,
      "end_ms": 199205,
      "text": "占了整根梁的三分之二，",
      "token_start": 682,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 199810,
      "end_ms": 201445,
      "text": "另一头挑出来承重，",
      "token_start": 692,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 202150,
      "end_ms": 204835,
      "text": "上面再搭楼粮是好粮，",
      "token_start": 700,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 205300,
      "end_ms": 206805,
      "text": "一千五百年不烂。",
      "token_start": 709,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 207180,
      "end_ms": 208545,
      "text": "这一千五百年里，",
      "token_start": 716,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 208820,
      "end_ms": 210440,
      "text": "这一带地震闹过多少回，",
      "token_start": 723,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 210720,
      "end_ms": 212095,
      "text": "山洪冲过多少回，",
      "token_start": 733,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 212380,
      "end_ms": 213735,
      "text": "他照样扎在那儿，",
      "token_start": 740,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 214040,
      "end_ms": 215485,
      "text": "一片瓦都没掉下来。",
      "token_start": 747,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 215930,
      "end_ms": 221525,
      "text": "四十间房靠几十根插进石头里的木头占了十五个世纪。",
      "token_start": 755,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 222240,
      "end_ms": 223765,
      "text": "这不仅是胆量，",
      "token_start": 778,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 224330,
      "end_ms": 228685,
      "text": "这是中国古代木构建筑留在绝壁上的奇迹。",
      "token_start": 784,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 229070,
      "end_ms": 229825,
      "text": "第三名，",
      "token_start": 802,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 230360,
      "end_ms": 234305,
      "text": "四川阿坝的九寨沟九寨归来不看水，",
      "token_start": 805,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 234680,
      "end_ms": 235845,
      "text": "这话不是吹的，",
      "token_start": 820,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 236320,
      "end_ms": 239005,
      "text": "他的水干净到让人没话说。",
      "token_start": 826,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 239450,
      "end_ms": 241165,
      "text": "您站在湖边往下看，",
      "token_start": 837,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 241500,
      "end_ms": 247435,
      "text": "能看到水底几百年倒下去的老树横在湖底早就死了，",
      "token_start": 845,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 247880,
      "end_ms": 248705,
      "text": "可他没烂。",
      "token_start": 867,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 249340,
      "end_ms": 252065,
      "text": "水里的碳酸钙一层一层裹上去，",
      "token_start": 871,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 252430,
      "end_ms": 253790,
      "text": "把黑木头裹成了，",
      "token_start": 884,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 253790,
      "end_ms": 257155,
      "text": "白的像一根根搁在水底的白玉。",
      "token_start": 891,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 257550,
      "end_ms": 258555,
      "text": "再往边上看，",
      "token_start": 904,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 258940,
      "end_ms": 260875,
      "text": "水浅的地方是碧绿，",
      "token_start": 909,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 261700,
      "end_ms": 264355,
      "text": "往前走几步变成孔雀蓝。",
      "token_start": 917,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 265110,
      "end_ms": 266410,
      "text": "太阳转到头顶，",
      "token_start": 927,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 266550,
      "end_ms": 267745,
      "text": "又成了深蓝，",
      "token_start": 933,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 268200,
      "end_ms": 269175,
      "text": "同一片湖，",
      "token_start": 938,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 270090,
      "end_ms": 271710,
      "text": "一上午换好几回，",
      "token_start": 942,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 271710,
      "end_ms": 272315,
      "text": "脸色，",
      "token_start": 949,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 272920,
      "end_ms": 274400,
      "text": "可不管什么颜色，",
      "token_start": 951,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 274620,
      "end_ms": 276545,
      "text": "底下都看得清清楚楚，",
      "token_start": 958,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 276970,
      "end_ms": 278545,
      "text": "九寨沟也不是没遭过难。",
      "token_start": 967,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 279470,
      "end_ms": 280370,
      "text": "二零一七年，",
      "token_start": 977,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 280370,
      "end_ms": 281135,
      "text": "那场地震，",
      "token_start": 982,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 281790,
      "end_ms": 287375,
      "text": "山体震塌了一段盖华瀑布震断的很多人说这地方完了，",
      "token_start": 986,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 287900,
      "end_ms": 290055,
      "text": "结果呢水自己回来了。",
      "token_start": 1009,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 290510,
      "end_ms": 291490,
      "text": "几年时间，",
      "token_start": 1018,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 291890,
      "end_ms": 295550,
      "text": "那些断了的地方又慢慢长出新的盖，",
      "token_start": 1022,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 295550,
      "end_ms": 299190,
      "text": "花一层一层往回铺瀑布，",
      "token_start": 1037,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 299310,
      "end_ms": 301050,
      "text": "重新留成了白色。",
      "token_start": 1047,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 301530,
      "end_ms": 303390,
      "text": "这就是九寨沟最厉害的地方，",
      "token_start": 1054,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 303870,
      "end_ms": 306609,
      "text": "它不是一幅挂在那儿不动的画，",
      "token_start": 1066,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 307190,
      "end_ms": 310510,
      "text": "他是活的有自愈的能力，",
      "token_start": 1079,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 311070,
      "end_ms": 314090,
      "text": "看一眼就让人心里通透宽敞。",
      "token_start": 1089,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 314450,
      "end_ms": 315050,
      "text": "第二名，",
      "token_start": 1101,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 315410,
      "end_ms": 317030,
      "text": "甘肃敦煌的莫高窟，",
      "token_start": 1104,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 317370,
      "end_ms": 318170,
      "text": "他排第二，",
      "token_start": 1112,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 318710,
      "end_ms": 320205,
      "text": "不是因为它有多好看，",
      "token_start": 1116,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 320840,
      "end_ms": 328200,
      "text": "而是因为这是一处正在以肉眼可见的速度一天天离我们而去的文明孤品。",
      "token_start": 1125,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 328660,
      "end_ms": 332140,
      "text": "鸣沙山东路断崖上开凿的七百多个洞窟，",
      "token_start": 1156,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 332700,
      "end_ms": 335900,
      "text": "里面保存着四万五千多平米的壁画。",
      "token_start": 1173,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 336540,
      "end_ms": 338540,
      "text": "四万五千平米是什么概念？",
      "token_start": 1188,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 339120,
      "end_ms": 342540,
      "text": "铺开来有整整六十多架波音客机，",
      "token_start": 1199,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 342540,
      "end_ms": 344460,
      "text": "那么大可这些壁画，",
      "token_start": 1213,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 344540,
      "end_ms": 347400,
      "text": "全是画在脆弱的泥土草料，",
      "token_start": 1221,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 347420,
      "end_ms": 350005,
      "text": "墙上的大漠的风沙，",
      "token_start": 1232,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 350470,
      "end_ms": 351715,
      "text": "昼夜的温差，",
      "token_start": 1240,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 352140,
      "end_ms": 356875,
      "text": "再加上游客进洞呼出的一口口二氧化碳和水汽，",
      "token_start": 1245,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 357410,
      "end_ms": 357890,
      "text": "壁画，",
      "token_start": 1265,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 357970,
      "end_ms": 360300,
      "text": "齐甲开裂褪色，",
      "token_start": 1267,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 360480,
      "end_ms": 362385,
      "text": "每天都在悄悄发生。",
      "token_start": 1273,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 362860,
      "end_ms": 365495,
      "text": "打着微弱的冷光手电走进去，",
      "token_start": 1281,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 365860,
      "end_ms": 369130,
      "text": "空气里是干燥的黄土乡手电。",
      "token_start": 1293,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 369190,
      "end_ms": 371015,
      "text": "光照上去的一刹那，",
      "token_start": 1305,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 371370,
      "end_ms": 374310,
      "text": "反弹琵琶的飞天衣带飘飘，",
      "token_start": 1313,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 374710,
      "end_ms": 375845,
      "text": "色泽斑斓，",
      "token_start": 1324,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 376240,
      "end_ms": 378815,
      "text": "可讲解袁惠轻声催您走，",
      "token_start": 1328,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 379450,
      "end_ms": 381365,
      "text": "因为每多待一分钟，",
      "token_start": 1338,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 381850,
      "end_ms": 384025,
      "text": "温度湿度都在变。",
      "token_start": 1346,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 384820,
      "end_ms": 386885,
      "text": "今天看得到的几个哭，",
      "token_start": 1353,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 387400,
      "end_ms": 390085,
      "text": "过两年可能就得永久封存，",
      "token_start": 1362,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 390520,
      "end_ms": 392485,
      "text": "这地方不是想去就能去，",
      "token_start": 1373,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 392940,
      "end_ms": 395465,
      "text": "是再不去就真的看不到了。",
      "token_start": 1383,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 395860,
      "end_ms": 396675,
      "text": "聊到这儿，",
      "token_start": 1394,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 396860,
      "end_ms": 398545,
      "text": "我想跟你唠几句心里话。",
      "token_start": 1398,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 398920,
      "end_ms": 400455,
      "text": "评论区不少朋友说，",
      "token_start": 1408,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 400970,
      "end_ms": 403505,
      "text": "这些地方心里记挂了半辈子，",
      "token_start": 1416,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 404030,
      "end_ms": 406235,
      "text": "可林道动身又犯了难，",
      "token_start": 1428,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 406850,
      "end_ms": 407830,
      "text": "怕海拔高，",
      "token_start": 1437,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 408130,
      "end_ms": 410185,
      "text": "身子骨吃不消是一头，",
      "token_start": 1441,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 410810,
      "end_ms": 412250,
      "text": "更怕费了半天劲。",
      "token_start": 1450,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 412330,
      "end_ms": 413185,
      "text": "到了跟前，",
      "token_start": 1457,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 413650,
      "end_ms": 415555,
      "text": "门道一点看不出来，",
      "token_start": 1461,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 416070,
      "end_ms": 420995,
      "text": "这话我懂就说莫高窟壁画不摸清背景，",
      "token_start": 1469,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 421350,
      "end_ms": 423445,
      "text": "在您眼里就是一片颜色。",
      "token_start": 1485,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 423860,
      "end_ms": 428470,
      "text": "都江堰不知道李兵当年怎么把一条江劈成两半，",
      "token_start": 1495,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 429060,
      "end_ms": 430120,
      "text": "站在鱼嘴上，",
      "token_start": 1515,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 430360,
      "end_ms": 431395,
      "text": "也就看个热闹。",
      "token_start": 1520,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 431830,
      "end_ms": 435605,
      "text": "悬空寺那几根木梁是怎么挂住的？",
      "token_start": 1526,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 436370,
      "end_ms": 437595,
      "text": "更没人跟您讲，",
      "token_start": 1540,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 438200,
      "end_ms": 440740,
      "text": "带孙辈出门的孩子，",
      "token_start": 1546,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 440740,
      "end_ms": 441640,
      "text": "只着问一句，",
      "token_start": 1554,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 441780,
      "end_ms": 443575,
      "text": "这水怎么自己就分了。",
      "token_start": 1559,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 444030,
      "end_ms": 445455,
      "text": "您要是答不上来，",
      "token_start": 1568,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 445840,
      "end_ms": 446745,
      "text": "脸上就挂不住。",
      "token_start": 1575,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 447210,
      "end_ms": 450530,
      "text": "前阵子有朋友给我推了本书叫大美，",
      "token_start": 1581,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 450530,
      "end_ms": 454695,
      "text": "中国人一生要去的一百零一个地方，",
      "token_start": 1596,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 455160,
      "end_ms": 459085,
      "text": "说是把全国一百零一个最值得去的地方，",
      "token_start": 1611,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 459750,
      "end_ms": 463835,
      "text": "一个一个的攻略来历、门道都理好了，",
      "token_start": 1628,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 464300,
      "end_ms": 465705,
      "text": "还配的实拍的图，",
      "token_start": 1643,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 466320,
      "end_ms": 467085,
      "text": "翻着不累，",
      "token_start": 1650,
      "token_end_exclusive": 1654
    },
    {
      "start_ms": 467500,
      "end_ms": 469940,
      "text": "出门前翻一翻到了地方，",
      "token_start": 1654,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 469940,
      "end_ms": 470765,
      "text": "心里有底，",
      "token_start": 1664,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 471070,
      "end_ms": 472215,
      "text": "知道该往哪看，",
      "token_start": 1668,
      "token_end_exclusive": 1674
    },
    {
      "start_ms": 472850,
      "end_ms": 473995,
      "text": "暂时去不了的，",
      "token_start": 1674,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 474320,
      "end_ms": 475305,
      "text": "就着慢慢翻，",
      "token_start": 1680,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 475680,
      "end_ms": 477770,
      "text": "也算走过一趟书，",
      "token_start": 1685,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 477790,
      "end_ms": 482365,
      "text": "我搁在左下方商品里感兴趣的老朋友去瞅一眼。",
      "token_start": 1692,
      "token_end_exclusive": 1712
    },
    {
      "start_ms": 482670,
      "end_ms": 484345,
      "text": "好社会正题。",
      "token_start": 1712,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 484740,
      "end_ms": 485280,
      "text": "第一名，",
      "token_start": 1717,
      "token_end_exclusive": 1720
    },
    {
      "start_ms": 485740,
      "end_ms": 491385,
      "text": "西藏林芝的雅鲁藏布大峡谷和他守着的南迦巴瓦峰，",
      "token_start": 1720,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 492200,
      "end_ms": 493315,
      "text": "为什么是他？",
      "token_start": 1742,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 493780,
      "end_ms": 494755,
      "text": "我先问您一句，",
      "token_start": 1747,
      "token_end_exclusive": 1753
    },
    {
      "start_ms": 495120,
      "end_ms": 496605,
      "text": "整张榜单走到这儿，",
      "token_start": 1753,
      "token_end_exclusive": 1761
    },
    {
      "start_ms": 496960,
      "end_ms": 500105,
      "text": "前面那些一个是人用泥捏的，",
      "token_start": 1761,
      "token_end_exclusive": 1773
    },
    {
      "start_ms": 500470,
      "end_ms": 502485,
      "text": "一个是人拿石头垒的，",
      "token_start": 1773,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 502780,
      "end_ms": 505185,
      "text": "一个是人把木头插进崖壁的，",
      "token_start": 1782,
      "token_end_exclusive": 1794
    },
    {
      "start_ms": 505860,
      "end_ms": 507125,
      "text": "全是人干的活。",
      "token_start": 1794,
      "token_end_exclusive": 1800
    },
    {
      "start_ms": 507580,
      "end_ms": 510235,
      "text": "您以为第一也该是这么一处老古董，",
      "token_start": 1800,
      "token_end_exclusive": 1815
    },
    {
      "start_ms": 510580,
      "end_ms": 511705,
      "text": "可偏偏不是，",
      "token_start": 1815,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 512410,
      "end_ms": 514925,
      "text": "它是喜马拉雅东边的一条口子，",
      "token_start": 1820,
      "token_end_exclusive": 1833
    },
    {
      "start_ms": 515530,
      "end_ms": 520335,
      "text": "被雅鲁藏布江从世界屋脊上硬生生劈出来，",
      "token_start": 1833,
      "token_end_exclusive": 1851
    },
    {
      "start_ms": 520740,
      "end_ms": 522985,
      "text": "还拐了一个著名的大弯。",
      "token_start": 1851,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 523390,
      "end_ms": 528240,
      "text": "世界上最深的峡谷最深的地方超过六千米南加，",
      "token_start": 1861,
      "token_end_exclusive": 1881
    },
    {
      "start_ms": 528240,
      "end_ms": 529480,
      "text": "巴瓦峰立在旁边，",
      "token_start": 1881,
      "token_end_exclusive": 1888
    },
    {
      "start_ms": 529880,
      "end_ms": 531745,
      "text": "海拔七千七百八十二米，",
      "token_start": 1888,
      "token_end_exclusive": 1898
    },
    {
      "start_ms": 532470,
      "end_ms": 533775,
      "text": "从谷底到封顶，",
      "token_start": 1898,
      "token_end_exclusive": 1904
    },
    {
      "start_ms": 534200,
      "end_ms": 535495,
      "text": "落差五千多米。",
      "token_start": 1904,
      "token_end_exclusive": 1910
    },
    {
      "start_ms": 535950,
      "end_ms": 536635,
      "text": "什么概念？",
      "token_start": 1910,
      "token_end_exclusive": 1914
    },
    {
      "start_ms": 537260,
      "end_ms": 538855,
      "text": "您从峡谷底往上走，",
      "token_start": 1914,
      "token_end_exclusive": 1922
    },
    {
      "start_ms": 539260,
      "end_ms": 542065,
      "text": "一开始是湿热的原始森林，",
      "token_start": 1922,
      "token_end_exclusive": 1933
    },
    {
      "start_ms": 542850,
      "end_ms": 544335,
      "text": "藤蔓缠在树上，",
      "token_start": 1933,
      "token_end_exclusive": 1939
    },
    {
      "start_ms": 544860,
      "end_ms": 546395,
      "text": "跟西双版纳一个样。",
      "token_start": 1939,
      "token_end_exclusive": 1947
    },
    {
      "start_ms": 547070,
      "end_ms": 549555,
      "text": "再往上是甄叶林，",
      "token_start": 1947,
      "token_end_exclusive": 1954
    },
    {
      "start_ms": 550230,
      "end_ms": 552445,
      "text": "再往上是高山草甸，",
      "token_start": 1954,
      "token_end_exclusive": 1962
    },
    {
      "start_ms": 552940,
      "end_ms": 553775,
      "text": "走到最后，",
      "token_start": 1962,
      "token_end_exclusive": 1966
    },
    {
      "start_ms": 554190,
      "end_ms": 559755,
      "text": "是终年不化的血和冰一根柱子上四个世界，",
      "token_start": 1966,
      "token_end_exclusive": 1984
    },
    {
      "start_ms": 560420,
      "end_ms": 563415,
      "text": "可这条裂缝平时是不给您看的。",
      "token_start": 1984,
      "token_end_exclusive": 1997
    },
    {
      "start_ms": 563810,
      "end_ms": 566865,
      "text": "南家爸爸一年里大半时间裹在云雾里，",
      "token_start": 1997,
      "token_end_exclusive": 2013
    },
    {
      "start_ms": 567140,
      "end_ms": 569540,
      "text": "当地人管他叫修女峰说，",
      "token_start": 2013,
      "token_end_exclusive": 2023
    },
    {
      "start_ms": 569540,
      "end_ms": 572205,
      "text": "能看见封顶的人是攒的福气。",
      "token_start": 2023,
      "token_end_exclusive": 2035
    },
    {
      "start_ms": 572620,
      "end_ms": 574020,
      "text": "很多人守好几天，",
      "token_start": 2035,
      "token_end_exclusive": 2042
    },
    {
      "start_ms": 574340,
      "end_ms": 575835,
      "text": "连一块石头都没看着，",
      "token_start": 2042,
      "token_end_exclusive": 2051
    },
    {
      "start_ms": 576200,
      "end_ms": 576865,
      "text": "就下山了。",
      "token_start": 2051,
      "token_end_exclusive": 2055
    },
    {
      "start_ms": 577710,
      "end_ms": 581545,
      "text": "前面九处有的是老天爷给咱们造的奇观，",
      "token_start": 2055,
      "token_end_exclusive": 2072
    },
    {
      "start_ms": 582220,
      "end_ms": 584565,
      "text": "有的是老祖宗给咱们留的手艺，",
      "token_start": 2072,
      "token_end_exclusive": 2085
    },
    {
      "start_ms": 585000,
      "end_ms": 589945,
      "text": "只有这一处是老天爷再量自己的尺寸。",
      "token_start": 2085,
      "token_end_exclusive": 2101
    },
    {
      "start_ms": 590630,
      "end_ms": 597170,
      "text": "把冰和火把、雪山和雨林全塞进一条五千米深的口子里。",
      "token_start": 2101,
      "token_end_exclusive": 2124
    },
    {
      "start_ms": 597650,
      "end_ms": 598430,
      "text": "看完它，",
      "token_start": 2124,
      "token_end_exclusive": 2127
    },
    {
      "start_ms": 598790,
      "end_ms": 602310,
      "text": "您才知道前面那九个太单薄，",
      "token_start": 2127,
      "token_end_exclusive": 2139
    },
    {
      "start_ms": 602550,
      "end_ms": 603390,
      "text": "太渺小，",
      "token_start": 2139,
      "token_end_exclusive": 2142
    },
    {
      "start_ms": 603810,
      "end_ms": 605070,
      "text": "十个地方说完了，",
      "token_start": 2142,
      "token_end_exclusive": 2149
    },
    {
      "start_ms": 605170,
      "end_ms": 606430,
      "text": "您回头细品品。",
      "token_start": 2149,
      "token_end_exclusive": 2155
    },
    {
      "start_ms": 607150,
      "end_ms": 608710,
      "text": "黄山是水墨画，",
      "token_start": 2155,
      "token_end_exclusive": 2161
    },
    {
      "start_ms": 609390,
      "end_ms": 613490,
      "text": "月牙泉是大漠清泉月果树是水声，",
      "token_start": 2161,
      "token_end_exclusive": 2175
    },
    {
      "start_ms": 613490,
      "end_ms": 613910,
      "text": "如雷，",
      "token_start": 2175,
      "token_end_exclusive": 2177
    },
    {
      "start_ms": 614590,
      "end_ms": 616370,
      "text": "张家界是大地骨骼。",
      "token_start": 2177,
      "token_end_exclusive": 2185
    },
    {
      "start_ms": 616950,
      "end_ms": 620205,
      "text": "张马俑是泥土清浑都江堰，",
      "token_start": 2185,
      "token_end_exclusive": 2196
    },
    {
      "start_ms": 620420,
      "end_ms": 621360,
      "text": "这道法自然，",
      "token_start": 2196,
      "token_end_exclusive": 2201
    },
    {
      "start_ms": 621840,
      "end_ms": 622440,
      "text": "悬空，",
      "token_start": 2201,
      "token_end_exclusive": 2203
    },
    {
      "start_ms": 622480,
      "end_ms": 624120,
      "text": "似是绝壁奇迹。",
      "token_start": 2203,
      "token_end_exclusive": 2209
    },
    {
      "start_ms": 624460,
      "end_ms": 626460,
      "text": "九寨沟是活水生命，",
      "token_start": 2209,
      "token_end_exclusive": 2217
    },
    {
      "start_ms": 627040,
      "end_ms": 629800,
      "text": "莫高窟是一面正在褪色的墙。",
      "token_start": 2217,
      "token_end_exclusive": 2229
    },
    {
      "start_ms": 630520,
      "end_ms": 637160,
      "text": "雅鲁藏布大峡谷与南加巴瓦峰是看一眼就让人闭上嘴巴的终极尺度。",
      "token_start": 2229,
      "token_end_exclusive": 2258
    },
    {
      "start_ms": 637540,
      "end_ms": 639380,
      "text": "这十处壮丽奇观，",
      "token_start": 2258,
      "token_end_exclusive": 2265
    },
    {
      "start_ms": 639740,
      "end_ms": 640940,
      "text": "趁要紧的是，",
      "token_start": 2265,
      "token_end_exclusive": 2270
    },
    {
      "start_ms": 640960,
      "end_ms": 642140,
      "text": "他们都不等人。",
      "token_start": 2270,
      "token_end_exclusive": 2276
    },
    {
      "start_ms": 642620,
      "end_ms": 645660,
      "text": "壁画在一寸寸风化雪山，",
      "token_start": 2276,
      "token_end_exclusive": 2286
    },
    {
      "start_ms": 645660,
      "end_ms": 647160,
      "text": "在一年年变样，",
      "token_start": 2286,
      "token_end_exclusive": 2292
    },
    {
      "start_ms": 647420,
      "end_ms": 648780,
      "text": "趁腿脚还利索，",
      "token_start": 2292,
      "token_end_exclusive": 2298
    },
    {
      "start_ms": 649080,
      "end_ms": 650275,
      "text": "趁眼里还有光，",
      "token_start": 2298,
      "token_end_exclusive": 2304
    },
    {
      "start_ms": 650690,
      "end_ms": 652205,
      "text": "别光顾着收藏了。",
      "token_start": 2304,
      "token_end_exclusive": 2311
    },
    {
      "start_ms": 652590,
      "end_ms": 657430,
      "text": "出发前想把门道摸透的那本大美中国的链接。",
      "token_start": 2311,
      "token_end_exclusive": 2330
    },
    {
      "start_ms": 657750,
      "end_ms": 661955,
      "text": "就在左下角觉得这期内容给您提了提气，",
      "token_start": 2330,
      "token_end_exclusive": 2347
    },
    {
      "start_ms": 662490,
      "end_ms": 663910,
      "text": "劳烦转给身边，",
      "token_start": 2347,
      "token_end_exclusive": 2353
    },
    {
      "start_ms": 664070,
      "end_ms": 666085,
      "text": "想一块出门看看的朋友，",
      "token_start": 2353,
      "token_end_exclusive": 2363
    },
    {
      "start_ms": 666540,
      "end_ms": 668995,
      "text": "想听更多中华大地的好故事。",
      "token_start": 2363,
      "token_end_exclusive": 2375
    },
    {
      "start_ms": 669260,
      "end_ms": 669955,
      "text": "点个关注，",
      "token_start": 2375,
      "token_end_exclusive": 2379
    },
    {
      "start_ms": 670280,
      "end_ms": 671755,
      "text": "咱们下期接着聊。",
      "token_start": 2379,
      "token_end_exclusive": 2386
    }
  ],
