{
  "video_id": "v_7d8477f6d742b9b9",
  "duration_s": 578.344828,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_7d8477f6d742b9b9.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_7d8477f6d742b9b9.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 4470,
      "text": "上一集咱们说到屠呦呦拿了诺贝尔科学奖，",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5110,
      "end_ms": 6930,
      "text": "全世界都在给他鼓掌，",
      "token_start": 18,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 7410,
      "end_ms": 10630,
      "text": "可他到现在依然不是中国科学院的院士。",
      "token_start": 27,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12070,
      "end_ms": 13210,
      "text": "有人可能会问，",
      "token_start": 44,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 13690,
      "end_ms": 15130,
      "text": "院士有那么重要吗？",
      "token_start": 50,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 15330,
      "end_ms": 16430,
      "text": "对屠呦呦来说，",
      "token_start": 58,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 16790,
      "end_ms": 17810,
      "text": "也许不重要，",
      "token_start": 64,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 18470,
      "end_ms": 20330,
      "text": "他一辈子不看重这个，",
      "token_start": 69,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 20990,
      "end_ms": 24570,
      "text": "但这事儿背后的道理让人心里不是滋味。",
      "token_start": 78,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 25390,
      "end_ms": 27030,
      "text": "屠呦呦是个三无科学家，",
      "token_start": 95,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 27390,
      "end_ms": 29905,
      "text": "哪三无没有博士学位，",
      "token_start": 105,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 30460,
      "end_ms": 31780,
      "text": "没有留学经历，",
      "token_start": 114,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 32020,
      "end_ms": 33340,
      "text": "没有院士头衔。",
      "token_start": 120,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 33920,
      "end_ms": 37360,
      "text": "中国学术圈最看重的那些东西，",
      "token_start": 126,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 37420,
      "end_ms": 39000,
      "text": "他一样都不占他。",
      "token_start": 139,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 39000,
      "end_ms": 41480,
      "text": "一九五五年毕业于北京医学院，",
      "token_start": 146,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 41840,
      "end_ms": 44720,
      "text": "就是新中国培养的第一批大学生。",
      "token_start": 159,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 45140,
      "end_ms": 47520,
      "text": "没读过博士没出过国，",
      "token_start": 173,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 47520,
      "end_ms": 48000,
      "text": "镀金，",
      "token_start": 182,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 48420,
      "end_ms": 50580,
      "text": "毕业后直接进了中医研究院，",
      "token_start": 184,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 50960,
      "end_ms": 53380,
      "text": "白大褂一穿就是六十多年，",
      "token_start": 196,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 54300,
      "end_ms": 56380,
      "text": "可就是这么一个三无老太太，",
      "token_start": 207,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 56780,
      "end_ms": 59765,
      "text": "拿下了中国第一个诺贝尔科学生。",
      "token_start": 219,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 60680,
      "end_ms": 64280,
      "text": "你说讽刺不讽刺比评不上院士，",
      "token_start": 233,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 64300,
      "end_ms": 66210,
      "text": "更让人心疼的是，",
      "token_start": 246,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 66210,
      "end_ms": 69265,
      "text": "他这一辈子对家人的亏欠。",
      "token_start": 253,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 69930,
      "end_ms": 70650,
      "text": "前面说了，",
      "token_start": 264,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 70670,
      "end_ms": 72410,
      "text": "接下五二三任务的时候，",
      "token_start": 268,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 72550,
      "end_ms": 74510,
      "text": "他两个女儿大的四岁，",
      "token_start": 278,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 74710,
      "end_ms": 75995,
      "text": "小的还不会走路。",
      "token_start": 287,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 76690,
      "end_ms": 78230,
      "text": "他把大女儿送去全托，",
      "token_start": 294,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 78450,
      "end_ms": 80290,
      "text": "把小女儿送回宁波老家，",
      "token_start": 303,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 80590,
      "end_ms": 81695,
      "text": "托给外婆带，",
      "token_start": 313,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 82100,
      "end_ms": 84005,
      "text": "这一送就是好多年。",
      "token_start": 318,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 84330,
      "end_ms": 84910,
      "text": "几年后，",
      "token_start": 326,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 85070,
      "end_ms": 86495,
      "text": "他回老家看小女儿，",
      "token_start": 329,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 86780,
      "end_ms": 88105,
      "text": "孩子已经跟他生份了。",
      "token_start": 337,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 88350,
      "end_ms": 92510,
      "text": "站在外婆身后不敢上前接大女儿回家时，",
      "token_start": 346,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 92810,
      "end_ms": 95330,
      "text": "孩子也跟他生叔了半天，",
      "token_start": 363,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 95330,
      "end_ms": 96585,
      "text": "喊不出一声妈，",
      "token_start": 373,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 96920,
      "end_ms": 99725,
      "text": "哪个当妈的看见这场面，",
      "token_start": 379,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 100020,
      "end_ms": 100925,
      "text": "心不会碎，",
      "token_start": 389,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 101780,
      "end_ms": 103080,
      "text": "可他抹掉眼泪，",
      "token_start": 393,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 103160,
      "end_ms": 104805,
      "text": "转身又回了实验室。",
      "token_start": 399,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 105630,
      "end_ms": 107545,
      "text": "他后来不怎么提这些事儿，",
      "token_start": 407,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 107860,
      "end_ms": 109985,
      "text": "只说孩子长大了会理解的。",
      "token_start": 418,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 110680,
      "end_ms": 114375,
      "text": "可这句话背后藏着多少个不眠之夜，",
      "token_start": 429,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 115220,
      "end_ms": 116675,
      "text": "只有他自己知道，",
      "token_start": 444,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 117080,
      "end_ms": 118375,
      "text": "对女儿是亏欠，",
      "token_start": 451,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 119140,
      "end_ms": 121965,
      "text": "对自己的母亲是一辈子的遗憾。",
      "token_start": 457,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 122770,
      "end_ms": 123990,
      "text": "那些年搞研究，",
      "token_start": 470,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 124250,
      "end_ms": 125655,
      "text": "他忙的脚不沾地。",
      "token_start": 476,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 126370,
      "end_ms": 127910,
      "text": "母亲病重的时候，",
      "token_start": 483,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 128130,
      "end_ms": 130205,
      "text": "她在实验室里实在走不开，",
      "token_start": 490,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 130670,
      "end_ms": 133475,
      "text": "想着等忙完这一阵再回去，",
      "token_start": 501,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 133890,
      "end_ms": 134930,
      "text": "可等他忙完，",
      "token_start": 512,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 135210,
      "end_ms": 136625,
      "text": "母亲人已经没了，",
      "token_start": 517,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 137210,
      "end_ms": 140450,
      "text": "他连母亲最后一面都没见上这件事，",
      "token_start": 524,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 140670,
      "end_ms": 142195,
      "text": "他后来几乎不提，",
      "token_start": 539,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 142730,
      "end_ms": 144295,
      "text": "但了解他的人都说，",
      "token_start": 546,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 144820,
      "end_ms": 146635,
      "text": "那是他心里永远的遗憾，",
      "token_start": 554,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 147140,
      "end_ms": 148355,
      "text": "对家人亏欠，",
      "token_start": 564,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 148640,
      "end_ms": 150285,
      "text": "对自己他更狠，",
      "token_start": 569,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 151510,
      "end_ms": 152530,
      "text": "以身试药。",
      "token_start": 575,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 152530,
      "end_ms": 154435,
      "text": "那事儿上一集说了，",
      "token_start": 579,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 155230,
      "end_ms": 157075,
      "text": "他自己第一个喝下去，",
      "token_start": 587,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 157890,
      "end_ms": 158785,
      "text": "可你知道吗？",
      "token_start": 596,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 159450,
      "end_ms": 161070,
      "text": "长期接触乙醚，",
      "token_start": 601,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 161070,
      "end_ms": 162375,
      "text": "那些有毒试剂，",
      "token_start": 607,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 162860,
      "end_ms": 165365,
      "text": "他的肝脏早就受了损伤，",
      "token_start": 613,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 165870,
      "end_ms": 167275,
      "text": "听力也越来越差，",
      "token_start": 623,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 167790,
      "end_ms": 171525,
      "text": "跟人说话总得侧着耳朵仔细听，",
      "token_start": 630,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 172370,
      "end_ms": 174135,
      "text": "可他呢九十多岁了，",
      "token_start": 643,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 174410,
      "end_ms": 176810,
      "text": "还坚持去研究所指导科研，",
      "token_start": 651,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 176970,
      "end_ms": 180245,
      "text": "带着团队研究青蒿素的新用途，",
      "token_start": 662,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 180790,
      "end_ms": 186435,
      "text": "想让这味药能治疗红斑狼疮等更多疾病救更多的病人。",
      "token_start": 675,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 187210,
      "end_ms": 188250,
      "text": "记者堵在门口，",
      "token_start": 698,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 188390,
      "end_ms": 191785,
      "text": "想采访他他摆摆手，",
      "token_start": 704,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 192360,
      "end_ms": 195310,
      "text": "说自己就是个搞科研的工作，",
      "token_start": 712,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 195310,
      "end_ms": 196085,
      "text": "就是爱好。",
      "token_start": 724,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 196440,
      "end_ms": 197755,
      "text": "他老伴挡在门前，",
      "token_start": 728,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 198320,
      "end_ms": 201920,
      "text": "几乎是恳求说都八十多岁的人了，",
      "token_start": 735,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 201980,
      "end_ms": 205565,
      "text": "什么名头都不在乎了别再打扰了，",
      "token_start": 749,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 206040,
      "end_ms": 207635,
      "text": "你再看看这反差。",
      "token_start": 763,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 208350,
      "end_ms": 212815,
      "text": "国外的公共广播机构举办大众票选活动，",
      "token_start": 770,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 213160,
      "end_ms": 217120,
      "text": "把他评为二十世纪最伟大的科学家之一，",
      "token_start": 787,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 217240,
      "end_ms": 220765,
      "text": "跟那些改变人类历史的大科学家相提并论。",
      "token_start": 804,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 221370,
      "end_ms": 222625,
      "text": "诺贝尔颁奖台上，",
      "token_start": 822,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 223050,
      "end_ms": 224965,
      "text": "副主席跪地给他举话筒。",
      "token_start": 829,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 225560,
      "end_ms": 228315,
      "text": "非洲的孩子因为他的药活了下来，",
      "token_start": 839,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 228830,
      "end_ms": 230345,
      "text": "全世界都在感谢他。",
      "token_start": 853,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 230790,
      "end_ms": 233410,
      "text": "可在国内呢整整四十年，",
      "token_start": 861,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 233670,
      "end_ms": 235135,
      "text": "没人知道他是谁。",
      "token_start": 871,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 235740,
      "end_ms": 236645,
      "text": "在单位里，",
      "token_start": 878,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 236920,
      "end_ms": 240970,
      "text": "他一直是最不起眼的那一个申报院士，",
      "token_start": 882,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 240970,
      "end_ms": 243150,
      "text": "好几次每次都落选。",
      "token_start": 898,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 243410,
      "end_ms": 244890,
      "text": "理由呢说法很多，",
      "token_start": 906,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 245310,
      "end_ms": 246990,
      "text": "有人说他没有博士学位，",
      "token_start": 913,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 247070,
      "end_ms": 249130,
      "text": "有人说他的研究不够系统。",
      "token_start": 923,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 249610,
      "end_ms": 251530,
      "text": "有人说成果是集体的，",
      "token_start": 934,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 251950,
      "end_ms": 254770,
      "text": "不能算他一个人的合着。",
      "token_start": 943,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 254770,
      "end_ms": 258170,
      "text": "在有些人眼里救了几百万人的命，",
      "token_start": 953,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 258810,
      "end_ms": 260810,
      "text": "还顶不上一张文凭。",
      "token_start": 967,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 261270,
      "end_ms": 262310,
      "text": "更扎心的是，",
      "token_start": 975,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 262550,
      "end_ms": 264810,
      "text": "在国外把他捧上神坛之前，",
      "token_start": 980,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 265290,
      "end_ms": 267870,
      "text": "咱们普通人根本不知道屠呦呦是谁，",
      "token_start": 991,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 268410,
      "end_ms": 272260,
      "text": "合着诺贝尔奖砸过来才恍然大悟。",
      "token_start": 1006,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 272580,
      "end_ms": 275740,
      "text": "原来咱们身边藏着这么牛的人物，",
      "token_start": 1020,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 276000,
      "end_ms": 276940,
      "text": "我就纳闷了，",
      "token_start": 1034,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 277260,
      "end_ms": 278960,
      "text": "这么伟大的科学家，",
      "token_start": 1039,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 279180,
      "end_ms": 280640,
      "text": "这么动人的故事，",
      "token_start": 1047,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 280740,
      "end_ms": 282760,
      "text": "为啥是外国人先发现呢？",
      "token_start": 1054,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 283180,
      "end_ms": 286400,
      "text": "难道不是该咱们自己骄傲的讲给全世界听吗？",
      "token_start": 1064,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 286980,
      "end_ms": 288900,
      "text": "咱们的媒体每天忙忙碌碌，",
      "token_start": 1083,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 289380,
      "end_ms": 291120,
      "text": "今天这个明星上热搜，",
      "token_start": 1094,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 291580,
      "end_ms": 293460,
      "text": "明天那个网红炒话题，",
      "token_start": 1103,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 293900,
      "end_ms": 296560,
      "text": "咋就把这些真正的英雄给漏了。",
      "token_start": 1112,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 297360,
      "end_ms": 299320,
      "text": "有人说过一句扎心的话，",
      "token_start": 1125,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 299680,
      "end_ms": 302890,
      "text": "这个真正有本事的人往往不吭声，",
      "token_start": 1135,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 303490,
      "end_ms": 304905,
      "text": "那些不会混圈子。",
      "token_start": 1149,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 305510,
      "end_ms": 306610,
      "text": "不会搞应酬，",
      "token_start": 1156,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 307030,
      "end_ms": 308890,
      "text": "只会闷头干事的人，",
      "token_start": 1161,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 309170,
      "end_ms": 310450,
      "text": "就容易被忽略。",
      "token_start": 1169,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 311290,
      "end_ms": 312610,
      "text": "这话听着刺耳，",
      "token_start": 1175,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 312930,
      "end_ms": 316370,
      "text": "可想想屠呦呦的遭遇又让人没法反驳。",
      "token_start": 1181,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 316830,
      "end_ms": 320270,
      "text": "他一辈子埋头在实验室里不混圈子，",
      "token_start": 1197,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 320430,
      "end_ms": 321290,
      "text": "不搞应酬，",
      "token_start": 1212,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 321610,
      "end_ms": 323070,
      "text": "一门心思搞研究，",
      "token_start": 1216,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 323490,
      "end_ms": 325650,
      "text": "结果却要靠外国人的认可，",
      "token_start": 1223,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 325910,
      "end_ms": 327270,
      "text": "才能被自己人发现。",
      "token_start": 1234,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 327930,
      "end_ms": 329410,
      "text": "更让人揪心的是，",
      "token_start": 1242,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 329830,
      "end_ms": 332830,
      "text": "现在还有多少像屠呦呦这样的人，",
      "token_start": 1249,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 333090,
      "end_ms": 334150,
      "text": "他们没留过洋，",
      "token_start": 1263,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 334490,
      "end_ms": 338000,
      "text": "没进过什什么核心圈子只会闷头干事，",
      "token_start": 1269,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 338220,
      "end_ms": 339380,
      "text": "不会溜须拍马，",
      "token_start": 1285,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 339780,
      "end_ms": 342920,
      "text": "他们的成就可能不比任何人差，",
      "token_start": 1291,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 343640,
      "end_ms": 345060,
      "text": "却因为不会来事，",
      "token_start": 1304,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 345320,
      "end_ms": 347280,
      "text": "就只能默默无闻。",
      "token_start": 1311,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 347600,
      "end_ms": 349320,
      "text": "咱们到底缺了点啥？",
      "token_start": 1318,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 349560,
      "end_ms": 355660,
      "text": "为啥自家的英雄要靠外人来发掘那些埋头苦干的科研人？",
      "token_start": 1326,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 356040,
      "end_ms": 358220,
      "text": "该怎么才能真正被看见？",
      "token_start": 1350,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 359000,
      "end_ms": 362540,
      "text": "屠呦呦的名字是他父亲从诗经里取的，",
      "token_start": 1360,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 363080,
      "end_ms": 365270,
      "text": "悠呦鹿鸣使野之好，",
      "token_start": 1376,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 365310,
      "end_ms": 367465,
      "text": "蒿蒿就是青蒿。",
      "token_start": 1384,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 367960,
      "end_ms": 369685,
      "text": "他父亲大概也想不到，",
      "token_start": 1390,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 370130,
      "end_ms": 371615,
      "text": "这个叫悠悠的姑娘，",
      "token_start": 1399,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 372100,
      "end_ms": 374875,
      "text": "这辈子真的和青蒿死磕到底了。",
      "token_start": 1407,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 375670,
      "end_ms": 380815,
      "text": "他就像一株默默生长在田野里的青蒿不起眼，",
      "token_start": 1420,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 381120,
      "end_ms": 381745,
      "text": "不张扬，",
      "token_start": 1439,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 382030,
      "end_ms": 383350,
      "text": "没有耀眼的光环，",
      "token_start": 1442,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 383470,
      "end_ms": 384890,
      "text": "没有华丽的言辞，",
      "token_start": 1449,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 385430,
      "end_ms": 391195,
      "text": "却用一生的坚守为几百万人撑起了一把生命之伞。",
      "token_start": 1456,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 392110,
      "end_ms": 395135,
      "text": "有些人需要一顶帽子来证明自己，",
      "token_start": 1477,
      "token_end_exclusive": 1491
    },
    {
      "start_ms": 395750,
      "end_ms": 398185,
      "text": "有些人本身就是一座碑，",
      "token_start": 1491,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 398620,
      "end_ms": 400395,
      "text": "屠呦呦属于后者，",
      "token_start": 1501,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 400820,
      "end_ms": 402855,
      "text": "他不需要谁的施舍和承认。",
      "token_start": 1508,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 403390,
      "end_ms": 406490,
      "text": "他早就把自己活成了那株救命的青蒿，",
      "token_start": 1519,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 406830,
      "end_ms": 407870,
      "text": "生于平凡，",
      "token_start": 1535,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 408270,
      "end_ms": 410005,
      "text": "却至于万千生灵。",
      "token_start": 1539,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 411210,
      "end_ms": 415895,
      "text": "其实啊咱们中国像屠呦呦这样的人还有很多。",
      "token_start": 1546,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 416310,
      "end_ms": 418530,
      "text": "你想想搞原子弹的邓稼先，",
      "token_start": 1565,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 418670,
      "end_ms": 419885,
      "text": "搞清弹的渔民，",
      "token_start": 1576,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 420230,
      "end_ms": 422005,
      "text": "搞杂交水稻的袁隆平，",
      "token_start": 1582,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 422380,
      "end_ms": 424080,
      "text": "搞核潜艇的黄旭华，",
      "token_start": 1591,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 424480,
      "end_ms": 428445,
      "text": "还有那些在戈壁滩上隐姓埋名几十年，",
      "token_start": 1599,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 428910,
      "end_ms": 430905,
      "text": "连名字都不能往外说的人，",
      "token_start": 1615,
      "token_end_exclusive": 1626
    },
    {
      "start_ms": 431330,
      "end_ms": 433345,
      "text": "他们哪一个不是拿命在拼，",
      "token_start": 1626,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 433750,
      "end_ms": 436305,
      "text": "哪一个不是把一辈子都搭进去了？",
      "token_start": 1637,
      "token_end_exclusive": 1651
    },
    {
      "start_ms": 436760,
      "end_ms": 441195,
      "text": "可我们普通老百姓又真正知道他们几个的故事。",
      "token_start": 1651,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 443080,
      "end_ms": 443825,
      "text": "这些年，",
      "token_start": 1671,
      "token_end_exclusive": 1674
    },
    {
      "start_ms": 444350,
      "end_ms": 446690,
      "text": "我每次看到这些人物的资料，",
      "token_start": 1674,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 447030,
      "end_ms": 448345,
      "text": "心里都不是滋味，",
      "token_start": 1686,
      "token_end_exclusive": 1693
    },
    {
      "start_ms": 449110,
      "end_ms": 451975,
      "text": "他们干的是惊天动地的大事。",
      "token_start": 1693,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 452930,
      "end_ms": 456590,
      "text": "可我们的孩子张嘴闭嘴追的都是这个明星。",
      "token_start": 1705,
      "token_end_exclusive": 1723
    },
    {
      "start_ms": 456610,
      "end_ms": 459375,
      "text": "那个网红连邓稼先是谁？",
      "token_start": 1723,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 459760,
      "end_ms": 462055,
      "text": "黄旭华是谁都不知道。",
      "token_start": 1733,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 462550,
      "end_ms": 463275,
      "text": "说实话，",
      "token_start": 1742,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 463640,
      "end_ms": 465320,
      "text": "我做这期视频的时候，",
      "token_start": 1745,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 465480,
      "end_ms": 467285,
      "text": "心里一直有个念头，",
      "token_start": 1754,
      "token_end_exclusive": 1762
    },
    {
      "start_ms": 467930,
      "end_ms": 470945,
      "text": "这些人的故事不能就这么被埋了。",
      "token_start": 1762,
      "token_end_exclusive": 1776
    },
    {
      "start_ms": 471820,
      "end_ms": 474005,
      "text": "咱们这代人要是不把他们记住，",
      "token_start": 1776,
      "token_end_exclusive": 1789
    },
    {
      "start_ms": 474510,
      "end_ms": 476745,
      "text": "将来孩子问起来谁来讲？",
      "token_start": 1789,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 477660,
      "end_ms": 483055,
      "text": "所以今天我想给大家推荐一本书叫国之脊梁。",
      "token_start": 1799,
      "token_end_exclusive": 1818
    },
    {
      "start_ms": 483990,
      "end_ms": 488145,
      "text": "这本书里写了几十位中国科学家的真实故事。",
      "token_start": 1818,
      "token_end_exclusive": 1837
    },
    {
      "start_ms": 488730,
      "end_ms": 491500,
      "text": "从两弹一星到杂交水稻，",
      "token_start": 1837,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 491520,
      "end_ms": 493525,
      "text": "从青蒿素到核潜艇，",
      "token_start": 1847,
      "token_end_exclusive": 1855
    },
    {
      "start_ms": 493890,
      "end_ms": 495210,
      "text": "那些你听过名字，",
      "token_start": 1855,
      "token_end_exclusive": 1862
    },
    {
      "start_ms": 495210,
      "end_ms": 500765,
      "text": "但不知道事迹的你连名字都没听过的英雄全在这本书里。",
      "token_start": 1862,
      "token_end_exclusive": 1886
    },
    {
      "start_ms": 501260,
      "end_ms": 502745,
      "text": "我翻开这本书的时候，",
      "token_start": 1886,
      "token_end_exclusive": 1895
    },
    {
      "start_ms": 503130,
      "end_ms": 506115,
      "text": "说实话好几次差点没忍住。",
      "token_start": 1895,
      "token_end_exclusive": 1906
    },
    {
      "start_ms": 506740,
      "end_ms": 509005,
      "text": "你知道他们那代人是怎么干事的吗？",
      "token_start": 1906,
      "token_end_exclusive": 1921
    },
    {
      "start_ms": 509390,
      "end_ms": 510290,
      "text": "没有加班费，",
      "token_start": 1921,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 510490,
      "end_ms": 512490,
      "text": "没有房子、没有职称，",
      "token_start": 1926,
      "token_end_exclusive": 1934
    },
    {
      "start_ms": 512830,
      "end_ms": 514945,
      "text": "甚至连名字都不能公开，",
      "token_start": 1934,
      "token_end_exclusive": 1944
    },
    {
      "start_ms": 515490,
      "end_ms": 517150,
      "text": "就凭着一腔热血，",
      "token_start": 1944,
      "token_end_exclusive": 1951
    },
    {
      "start_ms": 517370,
      "end_ms": 521245,
      "text": "把国家急需的东西硬生生给搞了出来。",
      "token_start": 1951,
      "token_end_exclusive": 1967
    },
    {
      "start_ms": 521760,
      "end_ms": 524720,
      "text": "这本书不是那种干巴巴的教科书，",
      "token_start": 1967,
      "token_end_exclusive": 1981
    },
    {
      "start_ms": 524840,
      "end_ms": 526975,
      "text": "全是一个一个真实的故事，",
      "token_start": 1981,
      "token_end_exclusive": 1992
    },
    {
      "start_ms": 527720,
      "end_ms": 528965,
      "text": "语言很朴实。",
      "token_start": 1992,
      "token_end_exclusive": 1997
    },
    {
      "start_ms": 529640,
      "end_ms": 531585,
      "text": "咱们中老年人看着不累，",
      "token_start": 1997,
      "token_end_exclusive": 2007
    },
    {
      "start_ms": 531850,
      "end_ms": 532935,
      "text": "孩子也能看懂，",
      "token_start": 2007,
      "token_end_exclusive": 2013
    },
    {
      "start_ms": 533720,
      "end_ms": 536495,
      "text": "我就把链结放在视频左下角了，",
      "token_start": 2013,
      "token_end_exclusive": 2026
    },
    {
      "start_ms": 537250,
      "end_ms": 539090,
      "text": "感兴趣的朋友点进去，",
      "token_start": 2026,
      "token_end_exclusive": 2035
    },
    {
      "start_ms": 539090,
      "end_ms": 539795,
      "text": "直接拍，",
      "token_start": 2035,
      "token_end_exclusive": 2038
    },
    {
      "start_ms": 540190,
      "end_ms": 540750,
      "text": "拿到手，",
      "token_start": 2038,
      "token_end_exclusive": 2041
    },
    {
      "start_ms": 540850,
      "end_ms": 542115,
      "text": "细细品读。",
      "token_start": 2041,
      "token_end_exclusive": 2045
    },
    {
      "start_ms": 543070,
      "end_ms": 546570,
      "text": "如果你也觉得屠呦呦这样的人值得被更多人记住。",
      "token_start": 2045,
      "token_end_exclusive": 2066
    },
    {
      "start_ms": 546810,
      "end_ms": 547465,
      "text": "点个赞，",
      "token_start": 2066,
      "token_end_exclusive": 2069
    },
    {
      "start_ms": 548390,
      "end_ms": 549945,
      "text": "把这条视频转出去，",
      "token_start": 2069,
      "token_end_exclusive": 2077
