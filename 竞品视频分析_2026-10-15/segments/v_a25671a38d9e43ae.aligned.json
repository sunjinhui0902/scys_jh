{
  "video_id": "v_a25671a38d9e43ae",
  "duration_s": 421.952993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_a25671a38d9e43ae.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_a25671a38d9e43ae.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 3930,
      "text": "您知道中国秋天最有诗意的湖泊是哪一个吗？",
      "token_start": 0,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4210,
      "end_ms": 10930,
      "text": "有人说是杭州西湖两千多年文人题咏平湖秋月，",
      "token_start": 19,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 10990,
      "end_ms": 12610,
      "text": "伴着满城桂香。",
      "token_start": 39,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 13030,
      "end_ms": 17510,
      "text": "有人说是新疆喀纳斯阿尔泰山密林深处，",
      "token_start": 45,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 17970,
      "end_ms": 21410,
      "text": "两千多米长卷泼翻了整座金秋，",
      "token_start": 62,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 21890,
      "end_ms": 22670,
      "text": "对不住了，",
      "token_start": 75,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 23150,
      "end_ms": 23690,
      "text": "西湖，",
      "token_start": 79,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 23850,
      "end_ms": 25410,
      "text": "连前四都进不了，",
      "token_start": 81,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 25850,
      "end_ms": 27330,
      "text": "喀纳斯也不是第一。",
      "token_start": 88,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 27790,
      "end_ms": 29845,
      "text": "真正排在第一名的那一处，",
      "token_start": 96,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 30260,
      "end_ms": 32380,
      "text": "从不跟名山大川争锋，",
      "token_start": 107,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 33080,
      "end_ms": 36580,
      "text": "只静静隐在万山褶皱深处。",
      "token_start": 116,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 36980,
      "end_ms": 40520,
      "text": "它的湖水清的能望穿十二米深处的水草。",
      "token_start": 127,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 41100,
      "end_ms": 41860,
      "text": "深秋里，",
      "token_start": 144,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 41860,
      "end_ms": 43220,
      "text": "万亩草海金黄，",
      "token_start": 147,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 43300,
      "end_ms": 43700,
      "text": "如梦，",
      "token_start": 153,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 44060,
      "end_ms": 44540,
      "text": "一叶，",
      "token_start": 155,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 44560,
      "end_ms": 46319,
      "text": "独木舟荡开成雾，",
      "token_start": 157,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 46700,
      "end_ms": 48840,
      "text": "接得住人间所有的湖泊。",
      "token_start": 164,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 49300,
      "end_ms": 49740,
      "text": "今天，",
      "token_start": 174,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 49760,
      "end_ms": 54220,
      "text": "咱们就来盘点中国秋天十大最有诗意的湖泊。",
      "token_start": 176,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 54600,
      "end_ms": 55420,
      "text": "话不多说，",
      "token_start": 195,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 55920,
      "end_ms": 57160,
      "text": "茶给您沏好了，",
      "token_start": 199,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 57740,
      "end_ms": 59645,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 205,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 60020,
      "end_ms": 61045,
      "text": "咱们这就开讲。",
      "token_start": 215,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 61360,
      "end_ms": 63375,
      "text": "第十名瘦西湖，",
      "token_start": 221,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 63750,
      "end_ms": 65940,
      "text": "江苏扬州瘦西湖，",
      "token_start": 227,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 65960,
      "end_ms": 69065,
      "text": "您肯定听过二十四桥明月夜，",
      "token_start": 234,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 69440,
      "end_ms": 71425,
      "text": "杜牧写的风雅全在这儿。",
      "token_start": 246,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 71800,
      "end_ms": 76325,
      "text": "两百多亩狭长水面如同一条青色丝绢，",
      "token_start": 256,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 77000,
      "end_ms": 78800,
      "text": "穿行于亭台楼阁，",
      "token_start": 272,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 79060,
      "end_ms": 80885,
      "text": "与画房曲桥之间。",
      "token_start": 279,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 81620,
      "end_ms": 82060,
      "text": "当年，",
      "token_start": 286,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 82100,
      "end_ms": 84365,
      "text": "扬州盐商耗银千万，",
      "token_start": 288,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 84770,
      "end_ms": 86375,
      "text": "依水叠石造园，",
      "token_start": 296,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 86940,
      "end_ms": 89825,
      "text": "把江南世人的青雅做到了极致。",
      "token_start": 302,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 90260,
      "end_ms": 91320,
      "text": "秋风一吹，",
      "token_start": 315,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 91760,
      "end_ms": 94125,
      "text": "两岸垂柳泛起微黄，",
      "token_start": 319,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 94720,
      "end_ms": 99130,
      "text": "白塔古桥倒映在建寿的水波里不见了。",
      "token_start": 327,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 99130,
      "end_ms": 100305,
      "text": "三月的喧闹，",
      "token_start": 343,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 100780,
      "end_ms": 102965,
      "text": "只剩下沉静的书卷气。",
      "token_start": 348,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 103630,
      "end_ms": 105775,
      "text": "您在湖畔走上一圈，",
      "token_start": 357,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 106340,
      "end_ms": 106860,
      "text": "心绪，",
      "token_start": 365,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 107080,
      "end_ms": 109255,
      "text": "便跟着水波慢了下来。",
      "token_start": 367,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 109630,
      "end_ms": 111145,
      "text": "这不是热烈的秋。",
      "token_start": 376,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 111760,
      "end_ms": 115755,
      "text": "这是江南文人留给岁月的一抹清倦，",
      "token_start": 383,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 116270,
      "end_ms": 118795,
      "text": "您说这算不算最舒心的雅致？",
      "token_start": 398,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 119130,
      "end_ms": 119975,
      "text": "第九名，",
      "token_start": 410,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 120710,
      "end_ms": 126435,
      "text": "长白山天池、吉林东南部诗意不一定在江南。",
      "token_start": 413,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 127130,
      "end_ms": 130335,
      "text": "他在长白山主峰的火山口里，",
      "token_start": 431,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 130730,
      "end_ms": 132985,
      "text": "水面海拔两千一百多米，",
      "token_start": 443,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 133340,
      "end_ms": 134080,
      "text": "最深处，",
      "token_start": 453,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 134120,
      "end_ms": 136150,
      "text": "三百七十多米一圈，",
      "token_start": 456,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 136210,
      "end_ms": 139205,
      "text": "十六座山峰把湖水围在当中。",
      "token_start": 464,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 139610,
      "end_ms": 140670,
      "text": "一千多年前，",
      "token_start": 476,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 140670,
      "end_ms": 142135,
      "text": "那场大喷发过后，",
      "token_start": 481,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 142510,
      "end_ms": 144950,
      "text": "火山口里的水慢慢存下来，",
      "token_start": 488,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 145270,
      "end_ms": 147215,
      "text": "才有了这面天上的镜子。",
      "token_start": 499,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 147680,
      "end_ms": 148835,
      "text": "深秋时节，",
      "token_start": 509,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 149370,
      "end_ms": 153055,
      "text": "十六封先落了一层薄雪白的山，",
      "token_start": 513,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 153440,
      "end_ms": 154065,
      "text": "蓝的水，",
      "token_start": 526,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 154530,
      "end_ms": 158990,
      "text": "蓝得像一块嵌在天边的玄律四下，",
      "token_start": 529,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 159050,
      "end_ms": 160245,
      "text": "没有一点声音。",
      "token_start": 543,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 160640,
      "end_ms": 163225,
      "text": "这一年里有大半年封着冰雪，",
      "token_start": 549,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 163700,
      "end_ms": 165315,
      "text": "哪天能看清全貌，",
      "token_start": 561,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 165670,
      "end_ms": 169465,
      "text": "全凭运气上去的人都得赶个好天，",
      "token_start": 568,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 170240,
      "end_ms": 170900,
      "text": "赶不上，",
      "token_start": 582,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 171220,
      "end_ms": 172995,
      "text": "也只能笑笑下山。",
      "token_start": 585,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 173400,
      "end_ms": 175155,
      "text": "边塞失里的冷峻，",
      "token_start": 592,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 175570,
      "end_ms": 177025,
      "text": "高拔孤傲，",
      "token_start": 599,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 177350,
      "end_ms": 178615,
      "text": "原来长在这里，",
      "token_start": 603,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 179150,
      "end_ms": 181765,
      "text": "您说这是不是另一种诗意？",
      "token_start": 609,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 182170,
      "end_ms": 182875,
      "text": "第八名？",
      "token_start": 620,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 183480,
      "end_ms": 184835,
      "text": "云南大理洱海，",
      "token_start": 623,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 185470,
      "end_ms": 187235,
      "text": "他在点苍山脚下，",
      "token_start": 629,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 187750,
      "end_ms": 189415,
      "text": "弧形像一只耳朵，",
      "token_start": 636,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 189820,
      "end_ms": 192085,
      "text": "面积两百五十多平方公里，",
      "token_start": 643,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 192600,
      "end_ms": 193845,
      "text": "苍山十九封，",
      "token_start": 654,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 194300,
      "end_ms": 195445,
      "text": "十八条溪水，",
      "token_start": 659,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 195870,
      "end_ms": 196890,
      "text": "一路流下来，",
      "token_start": 664,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 196890,
      "end_ms": 197690,
      "text": "全汇进。",
      "token_start": 669,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 197690,
      "end_ms": 200175,
      "text": "这片湖里秋高气爽，",
      "token_start": 672,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 200710,
      "end_ms": 203415,
      "text": "苍山顶上先披一层薄雪，",
      "token_start": 680,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 203990,
      "end_ms": 205775,
      "text": "岸边的红山红了，",
      "token_start": 690,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 206170,
      "end_ms": 208950,
      "text": "倒映在水里一阵风过去，",
      "token_start": 697,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 209290,
      "end_ms": 211275,
      "text": "水鸟擦着水皮飞。",
      "token_start": 707,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 211730,
      "end_ms": 214175,
      "text": "您要是在岸边找个地方坐下，",
      "token_start": 714,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 214530,
      "end_ms": 217395,
      "text": "能做一整个下午不用做什么，",
      "token_start": 726,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 217840,
      "end_ms": 219535,
      "text": "也也没人催您。",
      "token_start": 738,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 219940,
      "end_ms": 221320,
      "text": "岸边的白族人，",
      "token_start": 744,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 221320,
      "end_ms": 224575,
      "text": "家门口晒的红红的辣椒和玉米，",
      "token_start": 750,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 225060,
      "end_ms": 232255,
      "text": "老人搬个小凳就坐在水边一坐就是半天大半辈子都在照顾别人，",
      "token_start": 763,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 232770,
      "end_ms": 235765,
      "text": "到了这儿才算被允许慢下来，",
      "token_start": 790,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 236130,
      "end_ms": 238805,
      "text": "给操劳半生的自己松一松绑，",
      "token_start": 802,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 239590,
      "end_ms": 241145,
      "text": "这就是洱海的诗意。",
      "token_start": 814,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 241510,
      "end_ms": 242535,
      "text": "第七名，",
      "token_start": 822,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 242980,
      "end_ms": 243705,
      "text": "纳木错，",
      "token_start": 825,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 244480,
      "end_ms": 250355,
      "text": "西藏拉萨与那曲之间海拔四千七百多米的高原圣湖，",
      "token_start": 828,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 250980,
      "end_ms": 254005,
      "text": "接近两千平方公里的广袤水域，",
      "token_start": 850,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 254550,
      "end_ms": 256805,
      "text": "是直抵灵魂的苍茫。",
      "token_start": 863,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 257200,
      "end_ms": 257660,
      "text": "深秋，",
      "token_start": 871,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 257740,
      "end_ms": 259610,
      "text": "游人少了湖水，",
      "token_start": 873,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 259630,
      "end_ms": 260525,
      "text": "还没封冻，",
      "token_start": 879,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 261060,
      "end_ms": 262735,
      "text": "懒得让人说不出话。",
      "token_start": 883,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 263280,
      "end_ms": 264045,
      "text": "风一吹，",
      "token_start": 891,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 264460,
      "end_ms": 267270,
      "text": "岸边的鲸幡哗啦啦响转，",
      "token_start": 894,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 267390,
      "end_ms": 269995,
      "text": "胡的藏族老人一步一步走，",
      "token_start": 904,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 270310,
      "end_ms": 272665,
      "text": "嘴里念着经脚下不停。",
      "token_start": 915,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 273090,
      "end_ms": 274385,
      "text": "多少人到了这儿，",
      "token_start": 924,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 274800,
      "end_ms": 276345,
      "text": "原本想说点什么，",
      "token_start": 931,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 276790,
      "end_ms": 277985,
      "text": "结果站了半天，",
      "token_start": 938,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 278420,
      "end_ms": 279345,
      "text": "一个字没说。",
      "token_start": 944,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 279770,
      "end_ms": 282425,
      "text": "撞壶的人一圈要走好些天，",
      "token_start": 949,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 282990,
      "end_ms": 283575,
      "text": "走得慢，",
      "token_start": 960,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 283890,
      "end_ms": 284955,
      "text": "可没人嫌卖，",
      "token_start": 963,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 285570,
      "end_ms": 287115,
      "text": "也没人急着赶路，",
      "token_start": 968,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 287440,
      "end_ms": 288885,
      "text": "更没人回头张望。",
      "token_start": 975,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 289630,
      "end_ms": 291410,
      "text": "站在这样大的天地底下，",
      "token_start": 982,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 291710,
      "end_ms": 295475,
      "text": "您心里那些放不下的事忽然就小了，",
      "token_start": 992,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 295830,
      "end_ms": 296790,
      "text": "他不说话，",
      "token_start": 1007,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 297170,
      "end_ms": 298575,
      "text": "却让人放下。",
      "token_start": 1011,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 299230,
      "end_ms": 301915,
      "text": "您说这算不算最纯粹的释怀？",
      "token_start": 1016,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 302270,
      "end_ms": 302965,
      "text": "第六名，",
      "token_start": 1028,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 303350,
      "end_ms": 304145,
      "text": "洞庭湖，",
      "token_start": 1031,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 304790,
      "end_ms": 305745,
      "text": "湖南岳阳。",
      "token_start": 1034,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 306590,
      "end_ms": 308190,
      "text": "两千多平方公里，",
      "token_start": 1038,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 308610,
      "end_ms": 310650,
      "text": "浩瀚水域吞吐长江，",
      "token_start": 1045,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 311310,
      "end_ms": 314230,
      "text": "自古便有八百里洞庭的壮阔。",
      "token_start": 1053,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 314310,
      "end_ms": 314770,
      "text": "声明，",
      "token_start": 1065,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 315190,
      "end_ms": 318370,
      "text": "范仲淹写沙鸥降集锦。",
      "token_start": 1067,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 318430,
      "end_ms": 319150,
      "text": "林游泳，",
      "token_start": 1076,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 319830,
      "end_ms": 323930,
      "text": "杜甫写吴楚东南主乾坤日夜浮，",
      "token_start": 1079,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 324650,
      "end_ms": 325850,
      "text": "千百年文脉，",
      "token_start": 1092,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 326170,
      "end_ms": 327950,
      "text": "全凝在这片水里。",
      "token_start": 1097,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 328370,
      "end_ms": 332430,
      "text": "深秋的洞庭寒波万叠如花，",
      "token_start": 1104,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 332490,
      "end_ms": 334470,
      "text": "像雪一样飘在水面，",
      "token_start": 1115,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 334990,
      "end_ms": 337380,
      "text": "沙鸥落下去又飞起来。",
      "token_start": 1123,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 337940,
      "end_ms": 339160,
      "text": "登上岳阳楼，",
      "token_start": 1132,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 339340,
      "end_ms": 342460,
      "text": "往湖上一望天水连成一片，",
      "token_start": 1137,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 342880,
      "end_ms": 343840,
      "text": "望不到边。",
      "token_start": 1148,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 344240,
      "end_ms": 345440,
      "text": "一个老人的泪，",
      "token_start": 1152,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 345760,
      "end_ms": 349340,
      "text": "一个贤臣的胸襟都沉在这片水里。",
      "token_start": 1158,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 349720,
      "end_ms": 350180,
      "text": "您说，",
      "token_start": 1172,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 350600,
      "end_ms": 353340,
      "text": "这是何等博大的胸襟与尸骨。",
      "token_start": 1174,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 353700,
      "end_ms": 355020,
      "text": "从第十道第六名，",
      "token_start": 1186,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 355420,
      "end_ms": 359220,
      "text": "瘦西湖藏着江南文人的清雅天池，",
      "token_start": 1193,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 359300,
      "end_ms": 365560,
      "text": "展现云端孤傲的玄律洱还给疲惫身心解了绑纳木错，",
      "token_start": 1207,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 365560,
      "end_ms": 369240,
      "text": "用纯净的定胜兰荡敌反扰洞庭湖，",
      "token_start": 1229,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 369240,
      "end_ms": 372235,
      "text": "用吞吐乾坤的大胸襟震撼古今，",
      "token_start": 1243,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 372670,
      "end_ms": 375025,
      "text": "可他们还不是最有诗意的。",
      "token_start": 1256,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 375470,
      "end_ms": 377530,
      "text": "接下来第五道第一名更厉害，",
      "token_start": 1267,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 377530,
      "end_ms": 379455,
      "text": "有一座湖名满天下，",
      "token_start": 1279,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 379990,
      "end_ms": 381005,
      "text": "秋风一吹，",
      "token_start": 1287,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 381390,
      "end_ms": 383705,
      "text": "落满贵子残何听雨。",
      "token_start": 1291,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 384250,
      "end_ms": 387230,
      "text": "有一座湖深秋水退千顷，",
      "token_start": 1299,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 387370,
      "end_ms": 387855,
      "text": "湖底，",
      "token_start": 1309,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 388170,
      "end_ms": 392255,
      "text": "竟然生生化作粉紫花海与千年石岛，",
      "token_start": 1311,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 392630,
      "end_ms": 395915,
      "text": "可排在榜首的那座深山明镜。",
      "token_start": 1326,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 396710,
      "end_ms": 403975,
      "text": "一平如镜的水面上只飘着白花与独木舟静的能听见自己的心跳。",
      "token_start": 1338,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 404730,
      "end_ms": 405805,
      "text": "他是哪个湖？",
      "token_start": 1365,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 406550,
      "end_ms": 408825,
      "text": "他凭什么排在西湖前面？",
      "token_start": 1370,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 409230,
      "end_ms": 411235,
      "text": "下一集已经同步更新，",
      "token_start": 1380,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 411970,
      "end_ms": 413275,
      "text": "点开我的头像，",
      "token_start": 1389,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 413600,
      "end_ms": 416550,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1395,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 416710,
      "end_ms": 421635,
      "text": "看看谁才是中国秋天最有诗意的湖泊。",
      "token_start": 1407,
      "token_end_exclusive": 1423
    }
  ],
