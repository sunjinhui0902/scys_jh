{
  "video_id": "v_f80e9c7bc712ea91",
  "duration_s": 469.577007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f80e9c7bc712ea91.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f80e9c7bc712ea91.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1890,
      "text": "一百零五岁老人离世，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2310,
      "end_ms": 4230,
      "text": "藏在身上的秘密曝光，",
      "token_start": 9,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4470,
      "end_ms": 5430,
      "text": "全网泪崩。",
      "token_start": 18,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 6490,
      "end_ms": 7970,
      "text": "刷到这条消息的时候，",
      "token_start": 22,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 7970,
      "end_ms": 8890,
      "text": "我愣了好久，",
      "token_start": 31,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 9570,
      "end_ms": 11710,
      "text": "原来我们课本里学的长征，",
      "token_start": 36,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 11990,
      "end_ms": 13310,
      "text": "真的还有亲历者。",
      "token_start": 47,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 13310,
      "end_ms": 15950,
      "text": "刚刚离开二零二六年。",
      "token_start": 54,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 16010,
      "end_ms": 17690,
      "text": "七月二十二日凌晨，",
      "token_start": 63,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 18250,
      "end_ms": 22550,
      "text": "全国最后一位长征女红军王全英老人走了，",
      "token_start": 71,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 22850,
      "end_ms": 24630,
      "text": "享年一百零五岁。",
      "token_start": 89,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 25230,
      "end_ms": 27450,
      "text": "很多人说一个时代结束了，",
      "token_start": 96,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 27930,
      "end_ms": 30000,
      "text": "可只有了解完她的一生年龄，",
      "token_start": 107,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 30140,
      "end_ms": 35020,
      "text": "才知道这个十四岁跟着火把跑出大山的藏族姑娘，",
      "token_start": 119,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 35260,
      "end_ms": 37940,
      "text": "用一辈子活成了长征本身。",
      "token_start": 140,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 38160,
      "end_ms": 39080,
      "text": "一九二一年，",
      "token_start": 151,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 39180,
      "end_ms": 45300,
      "text": "王全英出生在四川阿坝州金山县安宁乡一个贫寒的藏族家庭。",
      "token_start": 156,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 46139,
      "end_ms": 48360,
      "text": "那时候他不叫王全英，",
      "token_start": 182,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 48600,
      "end_ms": 49380,
      "text": "叫桂香，",
      "token_start": 191,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 49900,
      "end_ms": 53500,
      "text": "一岁多父母双亡舅舅把他养到五岁，",
      "token_start": 194,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 53900,
      "end_ms": 56200,
      "text": "便送给了当地大户人家。",
      "token_start": 209,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 56200,
      "end_ms": 58240,
      "text": "做帮佣说是帮佣，",
      "token_start": 219,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 58620,
      "end_ms": 61270,
      "text": "其实就是农奴放牛，",
      "token_start": 226,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 61590,
      "end_ms": 62185,
      "text": "放羊，",
      "token_start": 234,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 62530,
      "end_ms": 65175,
      "text": "推磨给地主带孩子。",
      "token_start": 236,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 67430,
      "end_ms": 68470,
      "text": "最残忍的是，",
      "token_start": 244,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 68470,
      "end_ms": 73690,
      "text": "地主曾把他用绳子拴着扔进冰冷刺骨的河水里，",
      "token_start": 249,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 73690,
      "end_ms": 78320,
      "text": "来回冲刷一个五六岁的孩子被当成牲口对待。",
      "token_start": 269,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 78440,
      "end_ms": 79440,
      "text": "一九三五年，",
      "token_start": 288,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 79460,
      "end_ms": 83050,
      "text": "红军长征到达金川十四岁的桂香，",
      "token_start": 293,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 83130,
      "end_ms": 86710,
      "text": "第一次见到这支队伍穿的整整齐齐，",
      "token_start": 307,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 87010,
      "end_ms": 87975,
      "text": "从不扰民，",
      "token_start": 322,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 88670,
      "end_ms": 90635,
      "text": "对村里人和和气气。",
      "token_start": 326,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 91080,
      "end_ms": 93805,
      "text": "红军女干部召集群众开会，",
      "token_start": 334,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 94380,
      "end_ms": 95540,
      "text": "讲的都是穷人，",
      "token_start": 345,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 95540,
      "end_ms": 96335,
      "text": "怎么翻身，",
      "token_start": 351,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 96780,
      "end_ms": 97655,
      "text": "他听懂了，",
      "token_start": 355,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 97900,
      "end_ms": 100075,
      "text": "跟着几位金川的姐妹，",
      "token_start": 359,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 100500,
      "end_ms": 102075,
      "text": "他离开了地主家，",
      "token_start": 368,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 102470,
      "end_ms": 103715,
      "text": "投奔了红军。",
      "token_start": 375,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 104240,
      "end_ms": 106200,
      "text": "被编入红四方面军，",
      "token_start": 380,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 106240,
      "end_ms": 107315,
      "text": "妇女独立团，",
      "token_start": 388,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 107820,
      "end_ms": 110205,
      "text": "成为了一名占地卫生员。",
      "token_start": 393,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 110690,
      "end_ms": 111570,
      "text": "长征路上，",
      "token_start": 403,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 111590,
      "end_ms": 113475,
      "text": "王全英负责护理伤员，",
      "token_start": 407,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 113870,
      "end_ms": 114870,
      "text": "筹粮运粮，",
      "token_start": 416,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 114970,
      "end_ms": 115785,
      "text": "他不识字，",
      "token_start": 420,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 116270,
      "end_ms": 117290,
      "text": "但有个本事，",
      "token_start": 424,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 117630,
      "end_ms": 119225,
      "text": "擅长分辨药草。",
      "token_start": 429,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 120160,
      "end_ms": 121120,
      "text": "部队缺药时，",
      "token_start": 435,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 121520,
      "end_ms": 124360,
      "text": "他总能找到合适的草药，",
      "token_start": 440,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 124780,
      "end_ms": 127060,
      "text": "用土筏子救过不少人，",
      "token_start": 450,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 127900,
      "end_ms": 129500,
      "text": "但长征的残酷，",
      "token_start": 459,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 129820,
      "end_ms": 132140,
      "text": "远不是草药能解决的。",
      "token_start": 465,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 132560,
      "end_ms": 133580,
      "text": "过雪山时，",
      "token_start": 474,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 133960,
      "end_ms": 135440,
      "text": "冻的实在受不了了，",
      "token_start": 478,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 135440,
      "end_ms": 136039,
      "text": "就烤火，",
      "token_start": 486,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 136580,
      "end_ms": 138960,
      "text": "可冻伤的地方一烤就化脓，",
      "token_start": 489,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 139440,
      "end_ms": 141840,
      "text": "他的左脚小脚趾就是这样，",
      "token_start": 500,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 141960,
      "end_ms": 143500,
      "text": "硬生生冻没了。",
      "token_start": 511,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 143960,
      "end_ms": 144460,
      "text": "此后，",
      "token_start": 517,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 144540,
      "end_ms": 147580,
      "text": "他的左脚只剩下四根脚趾。",
      "token_start": 519,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 148040,
      "end_ms": 149735,
      "text": "他的女儿刘桂华回忆，",
      "token_start": 530,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 150560,
      "end_ms": 151700,
      "text": "一到下雨天，",
      "token_start": 539,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 151980,
      "end_ms": 153980,
      "text": "母亲整个脚背都会疼。",
      "token_start": 544,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 154460,
      "end_ms": 156320,
      "text": "这个伤痛跟了他一辈子。",
      "token_start": 553,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 156420,
      "end_ms": 157980,
      "text": "一九三六年三月，",
      "token_start": 563,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 158339,
      "end_ms": 161340,
      "text": "王全英随部队转战至丹巴县，",
      "token_start": 570,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 162040,
      "end_ms": 164980,
      "text": "遭遇了国民党二十四军的围攻。",
      "token_start": 582,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 165560,
      "end_ms": 166840,
      "text": "激烈的战斗中，",
      "token_start": 595,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 167000,
      "end_ms": 168400,
      "text": "他与大部队失散。",
      "token_start": 601,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 169360,
      "end_ms": 170620,
      "text": "为了追赶部队，",
      "token_start": 608,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 171040,
      "end_ms": 173420,
      "text": "他和几名同伴翻越雪山，",
      "token_start": 614,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 173740,
      "end_ms": 174680,
      "text": "没有鞋穿，",
      "token_start": 624,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 175160,
      "end_ms": 177440,
      "text": "踩着深深的积雪前行，",
      "token_start": 628,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 177860,
      "end_ms": 180960,
      "text": "靠挖野草、喝雪水冲攻击。",
      "token_start": 637,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 181530,
      "end_ms": 182605,
      "text": "一个多月以后，",
      "token_start": 647,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 182960,
      "end_ms": 185365,
      "text": "他流落到汶川三江一带，",
      "token_start": 653,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 185840,
      "end_ms": 188215,
      "text": "未能走完长征的全程，",
      "token_start": 663,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 188680,
      "end_ms": 190395,
      "text": "成了他毕生的遗憾。",
      "token_start": 672,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 191000,
      "end_ms": 194860,
      "text": "流落到汶川后王全英隐姓埋名，",
      "token_start": 680,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 195000,
      "end_ms": 197635,
      "text": "他从未向人提起长征的经历，",
      "token_start": 693,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 198050,
      "end_ms": 201915,
      "text": "与当地村民刘富光成家生育了五个子女，",
      "token_start": 705,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 202850,
      "end_ms": 204245,
      "text": "但因条件艰苦，",
      "token_start": 722,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 204570,
      "end_ms": 206735,
      "text": "仅有两个女儿存活了下来。",
      "token_start": 728,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 207840,
      "end_ms": 211845,
      "text": "一个走过雪山草地冻掉脚趾的女红军，",
      "token_start": 739,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 212130,
      "end_ms": 214605,
      "text": "成了一个普通的农村妇女，",
      "token_start": 755,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 215000,
      "end_ms": 216675,
      "text": "洗衣做饭、带孩子，",
      "token_start": 766,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 217160,
      "end_ms": 219915,
      "text": "像所有那个年代的川西女人一样，",
      "token_start": 773,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 220330,
      "end_ms": 221250,
      "text": "日出而作，",
      "token_start": 787,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 221450,
      "end_ms": 222465,
      "text": "日落而息。",
      "token_start": 791,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 223250,
      "end_ms": 225735,
      "text": "他把那段历史藏了将近五十年。",
      "token_start": 795,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 226190,
      "end_ms": 227535,
      "text": "新中国成立后，",
      "token_start": 808,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 227860,
      "end_ms": 229360,
      "text": "他给自己改了个名字。",
      "token_start": 814,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 229580,
      "end_ms": 233735,
      "text": "王全英全英全天下的红军都是英雄。",
      "token_start": 823,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 234590,
      "end_ms": 235475,
      "text": "也有人说，",
      "token_start": 838,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 235940,
      "end_ms": 240285,
      "text": "这是为了让牺牲的战友跟着自己一起见证国家的发展。",
      "token_start": 842,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 241290,
      "end_ms": 243005,
      "text": "一个不识字的女人，",
      "token_start": 865,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 243440,
      "end_ms": 248885,
      "text": "用改名的方式完成了对占友最深沉的承诺。",
      "token_start": 873,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 249450,
      "end_ms": 249990,
      "text": "他活着，",
      "token_start": 891,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 249990,
      "end_ms": 253285,
      "text": "就是替那些倒在雪山草地上的姐妹们活着。",
      "token_start": 894,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 254270,
      "end_ms": 255125,
      "text": "一九八四年，",
      "token_start": 912,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 255390,
      "end_ms": 261355,
      "text": "阿坝州人民政府民政局开展流落红军全面排查认定工作，",
      "token_start": 917,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 261810,
      "end_ms": 265160,
      "text": "工作人员多方寻访通过。",
      "token_start": 941,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 265460,
      "end_ms": 268740,
      "text": "战士们互相回忆和指认的方式，",
      "token_start": 951,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 268880,
      "end_ms": 274560,
      "text": "终于找到了这位隐于民间近五十年的老战士童年。",
      "token_start": 964,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 274860,
      "end_ms": 279045,
      "text": "阿坝州人民政府为他颁发了流落红军政容书，",
      "token_start": 985,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 279770,
      "end_ms": 281190,
      "text": "拿到证明书那一刻，",
      "token_start": 1004,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 281450,
      "end_ms": 282785,
      "text": "他终于被看见。",
      "token_start": 1012,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 283370,
      "end_ms": 283790,
      "text": "此后，",
      "token_start": 1018,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 283790,
      "end_ms": 288805,
      "text": "他先后获得中国工农红军长征胜利八十周年纪念章，",
      "token_start": 1020,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 289410,
      "end_ms": 293245,
      "text": "庆祝中华人民共和国成立七十周年纪念章，",
      "token_start": 1042,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 293890,
      "end_ms": 296805,
      "text": "家门口挂上了光荣之家的牌子。",
      "token_start": 1060,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 297430,
      "end_ms": 298470,
      "text": "二零二二年，",
      "token_start": 1073,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 298470,
      "end_ms": 301115,
      "text": "一百零一岁的王全英接受了。",
      "token_start": 1078,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 301490,
      "end_ms": 306190,
      "text": "央视专题片长征之歌摄制组的采访虽然不识字，",
      "token_start": 1090,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 306450,
      "end_ms": 309610,
      "text": "却能吐字清晰的唱出革命老歌，",
      "token_start": 1110,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 309850,
      "end_ms": 312530,
      "text": "还能独自行走做针线活。",
      "token_start": 1123,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 313330,
      "end_ms": 314950,
      "text": "今年的六月二十七日，",
      "token_start": 1133,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 314950,
      "end_ms": 318210,
      "text": "家人提前为他庆祝了一百零五岁的生日。",
      "token_start": 1142,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 318870,
      "end_ms": 319230,
      "text": "那天，",
      "token_start": 1159,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 319230,
      "end_ms": 320790,
      "text": "他穿上了红军的衣服，",
      "token_start": 1161,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 321230,
      "end_ms": 322890,
      "text": "佩戴上所有的纪念章，",
      "token_start": 1170,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 323590,
      "end_ms": 326410,
      "text": "那是他最后一次穿那身军装。",
      "token_start": 1179,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 327230,
      "end_ms": 330850,
      "text": "七月二十二日凌晨的十二三十，",
      "token_start": 1191,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 331560,
      "end_ms": 334940,
      "text": "王全英在都江堰的家中离世。",
      "token_start": 1204,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 335560,
      "end_ms": 336800,
      "text": "女儿刘桂华说，",
      "token_start": 1216,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 337220,
      "end_ms": 338840,
      "text": "母亲走的很安详。",
      "token_start": 1222,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 339380,
      "end_ms": 341720,
      "text": "在睡梦中离开的家，",
      "token_start": 1229,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 341820,
      "end_ms": 343800,
      "text": "人均陪伴在侧，",
      "token_start": 1237,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 344040,
      "end_ms": 348520,
      "text": "唯一的遗憾是没能撑到长征胜利九十周年纪念日。",
      "token_start": 1243,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 349460,
      "end_ms": 352300,
      "text": "今年正是长征胜利九十周年，",
      "token_start": 1264,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 352960,
      "end_ms": 354680,
      "text": "他只差不到三个月。",
      "token_start": 1276,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 356460,
      "end_ms": 358280,
      "text": "刘贵华在朋友圈写道，",
      "token_start": 1284,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 358760,
      "end_ms": 363815,
      "text": "雪域巾帼踏雪长征隐功仪式初心不改，",
      "token_start": 1293,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 364280,
      "end_ms": 365820,
      "text": "遵照老人的遗愿，",
      "token_start": 1309,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 366120,
      "end_ms": 369445,
      "text": "他的遗体将被送回汶川安葬。",
      "token_start": 1316,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 370250,
      "end_ms": 375855,
      "text": "回到他当年流落成家、隐姓埋名生活过的那片土地。",
      "token_start": 1328,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 376490,
      "end_ms": 377655,
      "text": "一九三五年，",
      "token_start": 1349,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 378000,
      "end_ms": 383430,
      "text": "隋红四方面军西渡嘉陵江参加长征的女红军共有八千余人，",
      "token_start": 1354,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 383430,
      "end_ms": 385555,
      "text": "其中绝大部分是四川人，",
      "token_start": 1379,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 385910,
      "end_ms": 389935,
      "text": "占长征女红军总人数的百分之九十以上，",
      "token_start": 1389,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 390620,
      "end_ms": 392785,
      "text": "八千多人走过雪山草地。",
      "token_start": 1406,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 393470,
      "end_ms": 395115,
      "text": "如今最后一个也走了，",
      "token_start": 1416,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 395740,
      "end_ms": 397665,
      "text": "有人说一个时代结束了，",
      "token_start": 1425,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 398190,
      "end_ms": 399885,
      "text": "但更准确的说法是，",
      "token_start": 1435,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 400390,
      "end_ms": 401875,
      "text": "亲历者离开了，",
      "token_start": 1443,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 402090,
      "end_ms": 403735,
      "text": "但长征没有结束。",
      "token_start": 1449,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 404230,
      "end_ms": 407715,
      "text": "那个十四岁从农奴变成红军的小女孩，",
      "token_start": 1456,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 408210,
      "end_ms": 411065,
      "text": "那个在雪山上冻掉脚趾的卫生员，",
      "token_start": 1472,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 411680,
      "end_ms": 414835,
      "text": "那个隐姓埋名五十年的普通农妇，",
      "token_start": 1486,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 415450,
      "end_ms": 418490,
      "text": "那个一百零五岁还穿着红军军装的老人，",
      "token_start": 1500,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 418630,
      "end_ms": 420565,
      "text": "他用一生证明了一件事儿，",
      "token_start": 1517,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 421110,
      "end_ms": 424845,
      "text": "有些人活着的每一天都是历史的本身。",
      "token_start": 1528,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 425310,
      "end_ms": 430215,
      "text": "你看真正的英雄从来都不是站在聚光灯下的，",
      "token_start": 1544,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 431120,
      "end_ms": 434635,
      "text": "他们可能就是你身边那个普普通通的老人，",
      "token_start": 1563,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 435290,
      "end_ms": 438815,
      "text": "把轰轰烈烈的过往藏进柴米油盐里，",
      "token_start": 1581,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 439130,
      "end_ms": 441815,
      "text": "用一辈子守着当年的初心。",
      "token_start": 1596,
      "token_end_exclusive": 1607
    },
    {
      "start_ms": 442560,
      "end_ms": 446260,
      "text": "如果你也被这个隐姓埋名五十年的老红军打动，",
      "token_start": 1607,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 446540,
      "end_ms": 448395,
      "text": "就点个赞收藏一下，",
      "token_start": 1627,
      "token_end_exclusive": 1635
    },
    {
      "start_ms": 448990,
      "end_ms": 450985,
      "text": "把他的故事转发出去，",
      "token_start": 1635,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 451470,
      "end_ms": 452730,
      "text": "让更多人知道。",
      "token_start": 1644,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 452910,
      "end_ms": 455810,
      "text": "还有过这样一位了不起的女战士，",
      "token_start": 1650,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 455890,
      "end_ms": 457465,
      "text": "也可以在评论区聊聊，",
      "token_start": 1664,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 458420,
      "end_ms": 464350,
      "text": "你觉得是什么样的信念能支撑一个人隐姓埋名五十年，",
      "token_start": 1673,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 464550,
      "end_ms": 465895,
      "text": "都不提自己的功劳。",
      "token_start": 1696,
      "token_end_exclusive": 1704
    },
    {
      "start_ms": 467590,
      "end_ms": 468905,
      "text": "我们评论区聊聊。",
      "token_start": 1704,
      "token_end_exclusive": 1711
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
