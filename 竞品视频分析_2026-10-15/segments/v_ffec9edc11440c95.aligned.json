{
  "video_id": "v_ffec9edc11440c95",
  "duration_s": 395.435828,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_ffec9edc11440c95.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_ffec9edc11440c95.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 3690,
      "text": "林徽因爬上佛光寺梁上找到了什么？",
      "token_start": 0,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 4150,
      "end_ms": 5510,
      "text": "如果林徽因活在，",
      "token_start": 15,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5510,
      "end_ms": 12530,
      "text": "今天我猜他第一件事就是把网上那些情感八卦全部举报了。",
      "token_start": 22,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 12550,
      "end_ms": 13770,
      "text": "因为几十年来，",
      "token_start": 47,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 14130,
      "end_ms": 18670,
      "text": "太多人只盯着他跟徐志摩金月林的关系，",
      "token_start": 53,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 19190,
      "end_ms": 23350,
      "text": "却不知道他当年干过一件更疯狂的事，",
      "token_start": 70,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 23810,
      "end_ms": 26510,
      "text": "爬到一座千年古殿的房梁上。",
      "token_start": 86,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 27050,
      "end_ms": 30880,
      "text": "在蝙蝠和臭虫堆里找个找一行字。",
      "token_start": 98,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 32100,
      "end_ms": 39020,
      "text": "林徽因出生在杭州祖父林孝荀是当地有名望的读书人，",
      "token_start": 112,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 39800,
      "end_ms": 44360,
      "text": "他的名字出自诗经里的大四司徽，",
      "token_start": 135,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 44360,
      "end_ms": 46220,
      "text": "因则百思难。",
      "token_start": 149,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 47220,
      "end_ms": 49680,
      "text": "他从小跟着祖母游氏生活，",
      "token_start": 154,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 50580,
      "end_ms": 52140,
      "text": "尤氏喜欢读书，",
      "token_start": 165,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 52340,
      "end_ms": 53280,
      "text": "精通书法，",
      "token_start": 171,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 53740,
      "end_ms": 55840,
      "text": "还特别接纳新思想。",
      "token_start": 175,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 56760,
      "end_ms": 60675,
      "text": "家里请的私塾先生不光教私塾、书、五经，",
      "token_start": 183,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 60980,
      "end_ms": 62395,
      "text": "还有天文地理，",
      "token_start": 199,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 62930,
      "end_ms": 66800,
      "text": "甚至请了外文老师教英语、日语，",
      "token_start": 205,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 68340,
      "end_ms": 72155,
      "text": "这在当时是非常罕见的启蒙，",
      "token_start": 218,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 73230,
      "end_ms": 76525,
      "text": "但林徽因的童年并不只有书香，",
      "token_start": 230,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 77420,
      "end_ms": 81535,
      "text": "他的母亲何雪原是个目不识丁的传统女人，",
      "token_start": 243,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 82260,
      "end_ms": 85505,
      "text": "嫁到邻家后跟婆婆由事处不来，",
      "token_start": 261,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 86110,
      "end_ms": 88245,
      "text": "又接连失去两个孩子。",
      "token_start": 274,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 88800,
      "end_ms": 89280,
      "text": "后来，",
      "token_start": 283,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 89500,
      "end_ms": 90955,
      "text": "林昌明纳了妾，",
      "token_start": 285,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 91460,
      "end_ms": 93325,
      "text": "母亲彻底被冷落。",
      "token_start": 291,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 93970,
      "end_ms": 96050,
      "text": "林徽因从小夹在中间，",
      "token_start": 298,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 96170,
      "end_ms": 97650,
      "text": "他爱开明的父亲，",
      "token_start": 307,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 97950,
      "end_ms": 100175,
      "text": "又心疼孤寂的母亲，",
      "token_start": 314,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 100750,
      "end_ms": 102445,
      "text": "他恨母亲不争气，",
      "token_start": 322,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 102800,
      "end_ms": 104605,
      "text": "又无法改变他的命运。",
      "token_start": 329,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 105650,
      "end_ms": 109215,
      "text": "这种撕裂感让林徽因很早就明白，",
      "token_start": 338,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 109620,
      "end_ms": 112125,
      "text": "女人不能只活成母亲那样。",
      "token_start": 352,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 112710,
      "end_ms": 113945,
      "text": "一九二零年，",
      "token_start": 363,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 115190,
      "end_ms": 117050,
      "text": "林长明做了一个改变，",
      "token_start": 368,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 117090,
      "end_ms": 119045,
      "text": "林徽因一生的决定，",
      "token_start": 377,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 119840,
      "end_ms": 122120,
      "text": "带十六岁的女儿去欧洲。",
      "token_start": 385,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 122960,
      "end_ms": 124820,
      "text": "他在信里写的很清楚，",
      "token_start": 395,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 125240,
      "end_ms": 127020,
      "text": "一是让你多看看世界，",
      "token_start": 404,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 127599,
      "end_ms": 128940,
      "text": "增长见识。",
      "token_start": 413,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 129960,
      "end_ms": 133380,
      "text": "二是让你了解我的理想抱负。",
      "token_start": 417,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 134280,
      "end_ms": 138160,
      "text": "三是让你暂时离开家庭琐事，",
      "token_start": 429,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 138340,
      "end_ms": 139600,
      "text": "开阔眼界，",
      "token_start": 441,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 140040,
      "end_ms": 143660,
      "text": "养成将来改良社会的见解和能力。",
      "token_start": 445,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 144580,
      "end_ms": 149175,
      "text": "这封信几乎就是林徽因一生的注脚。",
      "token_start": 459,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 150000,
      "end_ms": 150740,
      "text": "在欧洲，",
      "token_start": 474,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 151340,
      "end_ms": 153600,
      "text": "林徽因看到了更大的世界，",
      "token_start": 477,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 154200,
      "end_ms": 156000,
      "text": "他站上轮船甲板。",
      "token_start": 488,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 156300,
      "end_ms": 161020,
      "text": "看着父亲对赴法勤工俭学的青年演讲，",
      "token_start": 495,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 161640,
      "end_ms": 166580,
      "text": "突然发现世界不再只是高高的墙和四方的天，",
      "token_start": 511,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 167500,
      "end_ms": 169940,
      "text": "他开始疯狂吸收新知识。",
      "token_start": 530,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 170480,
      "end_ms": 172500,
      "text": "在伦敦的社交场合，",
      "token_start": 540,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 173040,
      "end_ms": 179365,
      "text": "他接触的几乎是当时东西方最前沿的思想和人物。",
      "token_start": 548,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 179790,
      "end_ms": 181010,
      "text": "也就是在那段时间，",
      "token_start": 569,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 181090,
      "end_ms": 184030,
      "text": "他找到了自己愿意奋斗一生的事业。",
      "token_start": 577,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 184050,
      "end_ms": 189030,
      "text": "建筑学可真正让他咬牙坚持的是，",
      "token_start": 592,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 189030,
      "end_ms": 191715,
      "text": "这条路远比想象中难走。",
      "token_start": 606,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 192510,
      "end_ms": 193545,
      "text": "一九二四年，",
      "token_start": 616,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 193920,
      "end_ms": 197405,
      "text": "他和梁思成一起去美国宾夕法尼亚大学留学，",
      "token_start": 621,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 198160,
      "end_ms": 199525,
      "text": "他想读建筑系。",
      "token_start": 640,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 199970,
      "end_ms": 201095,
      "text": "但那个年代，",
      "token_start": 646,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 201380,
      "end_ms": 204455,
      "text": "滨大建筑系根本不招女生。",
      "token_start": 651,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 204990,
      "end_ms": 206385,
      "text": "林徽因没有放弃，",
      "token_start": 662,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 206980,
      "end_ms": 208665,
      "text": "他先进入美术系，",
      "token_start": 669,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 209030,
      "end_ms": 210710,
      "text": "然后旁听建筑系。",
      "token_start": 676,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 210710,
      "end_ms": 213220,
      "text": "所有专业课不到两年，",
      "token_start": 683,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 213500,
      "end_ms": 216785,
      "text": "他就修完了建筑系的主要课程，",
      "token_start": 692,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 217240,
      "end_ms": 221160,
      "text": "还受聘担任建筑设计教师助理，",
      "token_start": 705,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 221160,
      "end_ms": 224465,
      "text": "后来甚至成了这门课的辅导教师。",
      "token_start": 718,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 225480,
      "end_ms": 228560,
      "text": "这在一个不招收女生的院系里，",
      "token_start": 732,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 228760,
      "end_ms": 230545,
      "text": "几乎是不可想象的。",
      "token_start": 745,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 231620,
      "end_ms": 233105,
      "text": "一九二八年回国后，",
      "token_start": 753,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 233580,
      "end_ms": 237835,
      "text": "他和梁思成一起创办了东北大学建筑系。",
      "token_start": 761,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 238350,
      "end_ms": 243330,
      "text": "那是中国大学里最早系统建立的建筑学系之一。",
      "token_start": 778,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 244150,
      "end_ms": 247210,
      "text": "林徽因前后教过四十多名学生，",
      "token_start": 798,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 247930,
      "end_ms": 252090,
      "text": "其中不少人后来成为建筑界的中坚力量，",
      "token_start": 811,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 252750,
      "end_ms": 257170,
      "text": "但真正让林徽因燃烧的是古建筑考察。",
      "token_start": 828,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 257190,
      "end_ms": 259530,
      "text": "上世纪三十年代，",
      "token_start": 844,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 259530,
      "end_ms": 263210,
      "text": "中国的古建筑研究几乎一片空白，",
      "token_start": 851,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 263210,
      "end_ms": 267310,
      "text": "日本人甚至扬言要看唐代木构建筑，",
      "token_start": 865,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 267330,
      "end_ms": 268770,
      "text": "只能去日本。",
      "token_start": 880,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 268770,
      "end_ms": 272340,
      "text": "耐良所是林徽因和梁思成不信邪，",
      "token_start": 885,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 272980,
      "end_ms": 276700,
      "text": "他们带着考察队走遍了六七个省份，",
      "token_start": 899,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 277360,
      "end_ms": 279940,
      "text": "在荒山野岭里攀爬古建，",
      "token_start": 914,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 280540,
      "end_ms": 283840,
      "text": "在破庙残园里测绘记录。",
      "token_start": 924,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 284860,
      "end_ms": 286820,
      "text": "一九三七年初夏，",
      "token_start": 934,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 287520,
      "end_ms": 291140,
      "text": "他们来到五台山侧路崎岖，",
      "token_start": 941,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 291920,
      "end_ms": 293520,
      "text": "连骡子都不肯走。",
      "token_start": 952,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 294400,
      "end_ms": 298320,
      "text": "一群人盘山两天几乎绝望时，",
      "token_start": 959,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 298860,
      "end_ms": 303515,
      "text": "在黄昏中看到了远处夕阳下的佛光寺。",
      "token_start": 971,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 304450,
      "end_ms": 306350,
      "text": "林徽因不顾危险，",
      "token_start": 987,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 306750,
      "end_ms": 309350,
      "text": "爬到高悬的大殿梁上，",
      "token_start": 994,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 309490,
      "end_ms": 314370,
      "text": "那里挤满了成百上千年的灰尘、臭虫和蝙蝠。",
      "token_start": 1003,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 315010,
      "end_ms": 316230,
      "text": "但他毫不在意，",
      "token_start": 1021,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 316690,
      "end_ms": 318090,
      "text": "一点一点寻找，",
      "token_start": 1027,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 318450,
      "end_ms": 323350,
      "text": "终于在梁底下找到了一行依稀可辨的题字。",
      "token_start": 1033,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 323970,
      "end_ms": 325330,
      "text": "经过一周辨认，",
      "token_start": 1051,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 325570,
      "end_ms": 330350,
      "text": "他们确认这座大殿建于唐大中十一年，",
      "token_start": 1057,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 330750,
      "end_ms": 333585,
      "text": "也就是公元八百五十七年，",
      "token_start": 1073,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 334240,
      "end_ms": 339500,
      "text": "这是中国现存最重要的唐代木构建筑之一。",
      "token_start": 1084,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 340140,
      "end_ms": 340700,
      "text": "从此，",
      "token_start": 1102,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 341060,
      "end_ms": 345000,
      "text": "中国人再也不用跑到日本去看唐代木构了。",
      "token_start": 1104,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 345540,
      "end_ms": 346920,
      "text": "新中国成立后，",
      "token_start": 1122,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 347420,
      "end_ms": 353640,
      "text": "林徽因又拖着病体参与了国徽和人民英雄纪念碑的设计。",
      "token_start": 1128,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 353840,
      "end_ms": 354900,
      "text": "很多人不知道，",
      "token_start": 1152,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 355700,
      "end_ms": 361980,
      "text": "那个庄严的国徽里有林徽因无数次渴血后修改的痕迹。",
      "token_start": 1158,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 362760,
      "end_ms": 365615,
      "text": "他的才华从从来不只是写诗，",
      "token_start": 1181,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 366420,
      "end_ms": 370455,
      "text": "他的身份也从来不只是梁思成的妻子，",
      "token_start": 1193,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 371110,
      "end_ms": 374565,
      "text": "他是一个把生命献给中国建筑的人，",
      "token_start": 1209,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 375220,
      "end_ms": 378345,
      "text": "那些被后人津津乐道的绯闻，",
      "token_start": 1224,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 378840,
      "end_ms": 381085,
      "text": "和他真正的事业比起来，",
      "token_start": 1236,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 381450,
      "end_ms": 383205,
      "text": "实在太过轻飘。",
      "token_start": 1246,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 383880,
      "end_ms": 386755,
      "text": "如果你也被林徽因的专业精神打，",
      "token_start": 1252,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 386940,
      "end_ms": 388385,
      "text": "都点个赞，",
      "token_start": 1266,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 388610,
      "end_ms": 389155,
      "text": "关注我，",
      "token_start": 1270,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 389450,
      "end_ms": 390685,
      "text": "收藏这条视频，",
      "token_start": 1273,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 391000,
      "end_ms": 392140,
      "text": "评论区告诉我，",
      "token_start": 1279,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 392160,
      "end_ms": 395245,
      "text": "你以前是不是也只看过他的八卦？",
      "token_start": 1285,
      "token_end_exclusive": 1299
    }
  ],
