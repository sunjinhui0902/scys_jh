{
  "video_id": "v_e24e8bbd60d71cee",
  "duration_s": 389.12,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_e24e8bbd60d71cee.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_e24e8bbd60d71cee.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 350,
      "end_ms": 750,
      "text": "朱军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1010,
      "end_ms": 1870,
      "text": "你敢相信吗？",
      "token_start": 2,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2050,
      "end_ms": 2850,
      "text": "未来十年，",
      "token_start": 7,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2850,
      "end_ms": 5050,
      "text": "中国最抢手的人不是大学生，",
      "token_start": 11,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5110,
      "end_ms": 6350,
      "text": "也不是科技精英，",
      "token_start": 23,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 6350,
      "end_ms": 8050,
      "text": "而是老年人。",
      "token_start": 30,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 8490,
      "end_ms": 10910,
      "text": "全国已经开始抢老人了，",
      "token_start": 35,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 11270,
      "end_ms": 15590,
      "text": "过去城市之间抢什么抢大学生、抢年轻人送户口给补贴。",
      "token_start": 45,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 15790,
      "end_ms": 16370,
      "text": "但现在，",
      "token_start": 68,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 16430,
      "end_ms": 18690,
      "text": "一场围绕老年人的抢人大战，",
      "token_start": 71,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 18830,
      "end_ms": 21390,
      "text": "开始了广西直接定下目标。",
      "token_start": 83,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 21550,
      "end_ms": 25630,
      "text": "二零二六年要吸引五百五十万人次老年人来广西旅居养老，",
      "token_start": 94,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 25750,
      "end_ms": 27130,
      "text": "而且要住满一周以上，",
      "token_start": 119,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 27430,
      "end_ms": 29770,
      "text": "吉林更直接从二零二七年开始，",
      "token_start": 128,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 29770,
      "end_ms": 34940,
      "text": "连续三年每年安排一亿元专项资金支持旅居康养产业。",
      "token_start": 141,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 35220,
      "end_ms": 38820,
      "text": "云南八个部门联手要打造三千个老年旅居村，",
      "token_start": 164,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 39060,
      "end_ms": 39420,
      "text": "看病，",
      "token_start": 183,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 39420,
      "end_ms": 42840,
      "text": "怕麻烦异地医保、能结算、就诊有绿色通道，",
      "token_start": 185,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 43240,
      "end_ms": 44280,
      "text": "出门怕折腾，",
      "token_start": 202,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 44320,
      "end_ms": 45700,
      "text": "银发专列送到站，",
      "token_start": 207,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 45880,
      "end_ms": 47200,
      "text": "连买房都有补贴。",
      "token_start": 214,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 47580,
      "end_ms": 49120,
      "text": "十六个省集体出手，",
      "token_start": 221,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 49300,
      "end_ms": 51220,
      "text": "招招都是抢着对老人好，",
      "token_start": 229,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 51500,
      "end_ms": 53000,
      "text": "别再说老了就没用了。",
      "token_start": 239,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 53160,
      "end_ms": 54860,
      "text": "老了正是吃香的时候啊，",
      "token_start": 248,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 54980,
      "end_ms": 55940,
      "text": "朝气蓬勃，",
      "token_start": 258,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 56120,
      "end_ms": 57080,
      "text": "有钱有闲，",
      "token_start": 262,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 57560,
      "end_ms": 58940,
      "text": "把时间花在哪里，",
      "token_start": 266,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 59080,
      "end_ms": 61105,
      "text": "人生的花会开在哪里。",
      "token_start": 273,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 61420,
      "end_ms": 62660,
      "text": "而且老人一旦在哪里，",
      "token_start": 282,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 62660,
      "end_ms": 63240,
      "text": "待的舒服，",
      "token_start": 291,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 63240,
      "end_ms": 64620,
      "text": "就会引起涟漪效应。",
      "token_start": 295,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 64740,
      "end_ms": 68655,
      "text": "一个人就可能带动一片人来盘活整个城市经济，",
      "token_start": 303,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 68940,
      "end_ms": 70345,
      "text": "你以为这和你无关吗？",
      "token_start": 323,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 70660,
      "end_ms": 71720,
      "text": "到了二零二三年，",
      "token_start": 332,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 71780,
      "end_ms": 74775,
      "text": "中国六十岁以上的老年人口将突破四亿人。",
      "token_start": 339,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 75070,
      "end_ms": 75605,
      "text": "什么概念？",
      "token_start": 357,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 76020,
      "end_ms": 77100,
      "text": "每三个人当中，",
      "token_start": 361,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 77100,
      "end_ms": 78135,
      "text": "就一个老年人。",
      "token_start": 367,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 78560,
      "end_ms": 80160,
      "text": "今天四十五岁的八零后，",
      "token_start": 373,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 80160,
      "end_ms": 82015,
      "text": "再过十五年就是六十岁。",
      "token_start": 383,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 82350,
      "end_ms": 83830,
      "text": "今天三十五岁的九零后，",
      "token_start": 393,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 83830,
      "end_ms": 85725,
      "text": "再过二十五年也六十岁了。",
      "token_start": 403,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 85980,
      "end_ms": 88265,
      "text": "今天的年轻人就是明天的老年人。",
      "token_start": 414,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 88600,
      "end_ms": 89880,
      "text": "如何看待老年，",
      "token_start": 428,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 90060,
      "end_ms": 92080,
      "text": "就是如何看待未来的自己。",
      "token_start": 434,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 92220,
      "end_ms": 95695,
      "text": "所以不要再把银发经济理解成多开几家养老院，",
      "token_start": 445,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 95970,
      "end_ms": 97005,
      "text": "这格局太像了。",
      "token_start": 465,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 97370,
      "end_ms": 100985,
      "text": "这可能是未来十多年、中国最大的生活方式革命之一。",
      "token_start": 471,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 101570,
      "end_ms": 105045,
      "text": "你觉得这一代人老了以后会天天坐在家里看电视吗？",
      "token_start": 493,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 105330,
      "end_ms": 105690,
      "text": "不会，",
      "token_start": 515,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 105970,
      "end_ms": 111790,
      "text": "这是一代用过智能手机的人是一代喝咖啡看演唱会的人是一代见过世面，",
      "token_start": 517,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 111790,
      "end_ms": 113325,
      "text": "体验过消费升级的人。",
      "token_start": 548,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 113640,
      "end_ms": 115295,
      "text": "说一个你可能想不到的事儿。",
      "token_start": 557,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 115490,
      "end_ms": 116570,
      "text": "和年轻人相比，",
      "token_start": 569,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 116750,
      "end_ms": 119374,
      "text": "这届老年人才是AI的重度用户，",
      "token_start": 575,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 119710,
      "end_ms": 123010,
      "text": "智能穿戴设备、远程医疗、陪护机器人等等。",
      "token_start": 588,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 123150,
      "end_ms": 124190,
      "text": "而就在前几天，",
      "token_start": 605,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 124390,
      "end_ms": 127615,
      "text": "广东七十三岁的奶奶拿下太空船票，",
      "token_start": 611,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 127910,
      "end_ms": 131335,
      "text": "成为中国首批商业太空游客将直冲宇宙，",
      "token_start": 626,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 131700,
      "end_ms": 133000,
      "text": "花三百万的船票，",
      "token_start": 643,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 133220,
      "end_ms": 135265,
      "text": "换一次四十分钟的太空之旅。",
      "token_start": 650,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 135460,
      "end_ms": 136385,
      "text": "你觉得值得吗？",
      "token_start": 662,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 136750,
      "end_ms": 137730,
      "text": "黄晓纯奶奶说，",
      "token_start": 668,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 137930,
      "end_ms": 139030,
      "text": "我自己赚的钱，",
      "token_start": 674,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 139170,
      "end_ms": 140070,
      "text": "该花就要花。",
      "token_start": 680,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 140330,
      "end_ms": 142225,
      "text": "七八十岁正是闯的年纪，",
      "token_start": 685,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 142420,
      "end_ms": 143415,
      "text": "不再是笑谈。",
      "token_start": 695,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 143850,
      "end_ms": 144750,
      "text": "十八岁的你，",
      "token_start": 700,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 144750,
      "end_ms": 146195,
      "text": "漂亮不是你漂亮，",
      "token_start": 705,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 146380,
      "end_ms": 147515,
      "text": "是十八岁漂亮。",
      "token_start": 712,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 147820,
      "end_ms": 149780,
      "text": "五十岁漂亮也不是五十岁，",
      "token_start": 718,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 149780,
      "end_ms": 151385,
      "text": "漂亮是你活的漂亮。",
      "token_start": 729,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 151690,
      "end_ms": 153750,
      "text": "谁规定老人只能穿老年装，",
      "token_start": 737,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 153970,
      "end_ms": 156590,
      "text": "我特别讨厌老年装老年鞋。",
      "token_start": 748,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 156610,
      "end_ms": 157245,
      "text": "这种词儿，",
      "token_start": 759,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 157570,
      "end_ms": 159470,
      "text": "为什么年轻人爱美叫月季？",
      "token_start": 763,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 159630,
      "end_ms": 161290,
      "text": "老人爱美就叫这么大岁数，",
      "token_start": 774,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 161290,
      "end_ms": 162910,
      "text": "还折腾银发。",
      "token_start": 785,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 162930,
      "end_ms": 167890,
      "text": "经济最大的升级就是允许老年人继续爱美恋爱、旅行学习，",
      "token_start": 790,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 168050,
      "end_ms": 169235,
      "text": "继续拥有欲望。",
      "token_start": 814,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 169580,
      "end_ms": 171900,
      "text": "老年人真正需要的不是提醒自己，",
      "token_start": 820,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 171920,
      "end_ms": 172555,
      "text": "我老了，",
      "token_start": 834,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 172830,
      "end_ms": 174875,
      "text": "而是被允许忘记自己的年龄，",
      "token_start": 837,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 175270,
      "end_ms": 175910,
      "text": "你相信吗？",
      "token_start": 849,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 176130,
      "end_ms": 178950,
      "text": "银发一族会催生中国很多产业的变革。",
      "token_start": 853,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 179190,
      "end_ms": 179590,
      "text": "比如，",
      "token_start": 869,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 179610,
      "end_ms": 181790,
      "text": "我们过去买房子、看学区、看地段，",
      "token_start": 871,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 181790,
      "end_ms": 183880,
      "text": "看升值以后越来越多了。",
      "token_start": 884,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 183880,
      "end_ms": 185765,
      "text": "还会问轮椅进不进得去，",
      "token_start": 894,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 186110,
      "end_ms": 187375,
      "text": "卫生间会不会摔倒？",
      "token_start": 904,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 187650,
      "end_ms": 189630,
      "text": "医院进不进电梯停不停，",
      "token_start": 912,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 189870,
      "end_ms": 191145,
      "text": "社区有没有食堂？",
      "token_start": 922,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 191450,
      "end_ms": 192630,
      "text": "一个人住安全吗？",
      "token_start": 929,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 192770,
      "end_ms": 195265,
      "text": "家里的智能设备能不能发现老年人跌倒？",
      "token_start": 936,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 195590,
      "end_ms": 195850,
      "text": "所以，",
      "token_start": 953,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 195850,
      "end_ms": 198365,
      "text": "中国房地产下一个巨大的改造需求，",
      "token_start": 955,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 198620,
      "end_ms": 200380,
      "text": "可能不再是让房子更豪华，",
      "token_start": 970,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 200540,
      "end_ms": 202435,
      "text": "而是让人在里面安心变老。",
      "token_start": 981,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 202860,
      "end_ms": 205565,
      "text": "真正的好房子不是年轻的时候住进去漂亮，",
      "token_start": 992,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 205810,
      "end_ms": 207270,
      "text": "而是到了八十岁的时候，",
      "token_start": 1010,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 207350,
      "end_ms": 208575,
      "text": "女孩不用搬出去。",
      "token_start": 1020,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 209030,
      "end_ms": 211810,
      "text": "所以这些城市争夺老年人的本质是什么？",
      "token_start": 1027,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 211930,
      "end_ms": 214005,
      "text": "在争抢一种新的人口红利，",
      "token_start": 1044,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 214480,
      "end_ms": 216940,
      "text": "以前的人口红利是年轻人进厂打工，",
      "token_start": 1055,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 217120,
      "end_ms": 219740,
      "text": "而未来的一部分人口红利就是老年人，",
      "token_start": 1070,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 219740,
      "end_ms": 220525,
      "text": "走出家门，",
      "token_start": 1086,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 221020,
      "end_ms": 222780,
      "text": "一个老人住进一座小城，",
      "token_start": 1090,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 223040,
      "end_ms": 227120,
      "text": "他需要住宿、吃饭、交通、娱乐和文化活动等等等等。",
      "token_start": 1100,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 227240,
      "end_ms": 229495,
      "text": "一个人背后就是一条消费链，",
      "token_start": 1120,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 229810,
      "end_ms": 232905,
      "text": "我其实不太喜欢把所有的事情都叫做银发经济，",
      "token_start": 1132,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 233120,
      "end_ms": 234685,
      "text": "好像只盯着老年人的钱。",
      "token_start": 1152,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 235040,
      "end_ms": 236660,
      "text": "因为老人们不是一个市场，",
      "token_start": 1162,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 236800,
      "end_ms": 237925,
      "text": "他们首先是人，",
      "token_start": 1173,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 238300,
      "end_ms": 240135,
      "text": "他们需要的不只是消费产品，",
      "token_start": 1179,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 240360,
      "end_ms": 241340,
      "text": "而是尊严。",
      "token_start": 1191,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 241560,
      "end_ms": 246285,
      "text": "陪伴、自由选择和参与的真正值得发展的银发经济，",
      "token_start": 1195,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 246490,
      "end_ms": 248010,
      "text": "不应该利用老年人的焦虑，",
      "token_start": 1216,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 248170,
      "end_ms": 250245,
      "text": "而应该奖励老年人的热爱。",
      "token_start": 1227,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 250780,
      "end_ms": 255275,
      "text": "今天中国这一代五六十岁六七十岁的人是非常特殊的一代人，",
      "token_start": 1238,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 255600,
      "end_ms": 258035,
      "text": "他们年轻的时候物质没有今天丰富。",
      "token_start": 1264,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 258350,
      "end_ms": 260975,
      "text": "很多人经历过从自行车到汽车，",
      "token_start": 1279,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 261280,
      "end_ms": 263295,
      "text": "从粮票到手机、移动支付，",
      "token_start": 1292,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 263530,
      "end_ms": 265275,
      "text": "从绿皮火车到高铁，",
      "token_start": 1302,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 265540,
      "end_ms": 267135,
      "text": "从写信到智能手机。",
      "token_start": 1310,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 267560,
      "end_ms": 269305,
      "text": "他们不是跟不上时代的人，",
      "token_start": 1318,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 269520,
      "end_ms": 273125,
      "text": "他们恰恰是亲眼看着中国一步一步走到今天的人。",
      "token_start": 1329,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 273460,
      "end_ms": 276135,
      "text": "他们把最能吃苦的年龄交给了家庭，",
      "token_start": 1350,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 276380,
      "end_ms": 278575,
      "text": "把最有经历的年月交给了工作，",
      "token_start": 1365,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 278890,
      "end_ms": 282435,
      "text": "把能省下来的钱给孩子读书、买房、成家。",
      "token_start": 1378,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 282770,
      "end_ms": 283570,
      "text": "所以到了晚年，",
      "token_start": 1394,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 283810,
      "end_ms": 286175,
      "text": "请允许这一代人对自己好一点。",
      "token_start": 1400,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 286710,
      "end_ms": 289410,
      "text": "很多中国人真正第一次拥有属于自己的时间，",
      "token_start": 1413,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 289410,
      "end_ms": 290735,
      "text": "恰恰是在退休以后。",
      "token_start": 1432,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 291260,
      "end_ms": 291540,
      "text": "所以，",
      "token_start": 1440,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 291540,
      "end_ms": 292940,
      "text": "退休不是失去工作，",
      "token_start": 1442,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 293120,
      "end_ms": 294560,
      "text": "而是拿回时间。",
      "token_start": 1450,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 294940,
      "end_ms": 296420,
      "text": "年轻时候挣钱养家，",
      "token_start": 1456,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 296600,
      "end_ms": 299179,
      "text": "老了以后终于可以花时间养自己，",
      "token_start": 1464,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 299600,
      "end_ms": 301260,
      "text": "不要舍不得坐一次高铁，",
      "token_start": 1478,
      "token_end_exclusive": 1488
    },
    {
      "start_ms": 301460,
      "end_ms": 303240,
      "text": "不要舍不得住一次好酒店，",
      "token_start": 1488,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 303340,
      "end_ms": 304360,
      "text": "不要舍不得去看。",
      "token_start": 1499,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 304360,
      "end_ms": 305880,
      "text": "年轻时没看过的世界，",
      "token_start": 1506,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 306260,
      "end_ms": 306920,
      "text": "你辛苦了，",
      "token_start": 1515,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 306920,
      "end_ms": 307420,
      "text": "一辈子，",
      "token_start": 1519,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 307480,
      "end_ms": 309640,
      "text": "晚年不是用来继续委屈自己的。",
      "token_start": 1522,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 309880,
      "end_ms": 310720,
      "text": "年轻的时候，",
      "token_start": 1535,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 310800,
      "end_ms": 311800,
      "text": "你是谁的女儿，",
      "token_start": 1540,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 311800,
      "end_ms": 312460,
      "text": "谁的妻子？",
      "token_start": 1546,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 312460,
      "end_ms": 314120,
      "text": "谁的妈妈老了以后，",
      "token_start": 1550,
      "token_end_exclusive": 1558
    },
    {
      "start_ms": 314240,
      "end_ms": 316940,
      "text": "希望你终于可以重新成为你自己。",
      "token_start": 1558,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 317200,
      "end_ms": 317660,
      "text": "朱军，",
      "token_start": 1572,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 317960,
      "end_ms": 318640,
      "text": "一个社会，",
      "token_start": 1574,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 318640,
      "end_ms": 319400,
      "text": "真正的文明，",
      "token_start": 1578,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 319680,
      "end_ms": 323310,
      "text": "恰恰体现在她如何对待那些不再年轻的人。",
      "token_start": 1583,
      "token_end_exclusive": 1601
    },
    {
      "start_ms": 323550,
      "end_ms": 325710,
      "text": "一座城市不能只爱你的青春，",
      "token_start": 1601,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 325910,
      "end_ms": 327750,
      "text": "他还应该接得住你的晚年。",
      "token_start": 1613,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 328370,
      "end_ms": 330610,
      "text": "老人不是一张等待报销的医保卡，",
      "token_start": 1624,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 330810,
      "end_ms": 332770,
      "text": "不是一张等待领取的养老金卡，",
      "token_start": 1638,
      "token_end_exclusive": 1651
    },
    {
      "start_ms": 332970,
      "end_ms": 338450,
      "text": "而是一个仍然在生活、消费、旅行、学习、交朋友的人一个社会。",
      "token_start": 1651,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 338450,
      "end_ms": 339650,
      "text": "真正成熟的标志，",
      "token_start": 1675,
      "token_end_exclusive": 1682
    },
    {
      "start_ms": 339730,
      "end_ms": 342410,
      "text": "就是不再只歌颂年轻青春，",
      "token_start": 1682,
      "token_end_exclusive": 1693
    },
    {
      "start_ms": 342450,
      "end_ms": 343470,
      "text": "当然值得赞美。",
      "token_start": 1693,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 343710,
      "end_ms": 345570,
      "text": "但白发同样值得尊重，",
      "token_start": 1699,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 346130,
      "end_ms": 347730,
      "text": "年轻人的价值叫潜力，",
      "token_start": 1708,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 347930,
      "end_ms": 349470,
      "text": "老年人的价值叫阅历。",
      "token_start": 1717,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 349650,
      "end_ms": 350815,
      "text": "你只是退休了，",
      "token_start": 1726,
      "token_end_exclusive": 1732
    },
    {
      "start_ms": 351030,
      "end_ms": 355080,
      "text": "不是被时代淘汰的当一个社会开始抢老人。",
      "token_start": 1732,
      "token_end_exclusive": 1750
    },
    {
      "start_ms": 355300,
      "end_ms": 357795,
      "text": "真正值得高兴的不是老人终于值钱了，",
      "token_start": 1750,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 357990,
      "end_ms": 359405,
      "text": "而是我们终于开始意识到，",
      "token_start": 1766,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 359740,
      "end_ms": 360440,
      "text": "人老了，",
      "token_start": 1777,
      "token_end_exclusive": 1780
    },
    {
      "start_ms": 360440,
      "end_ms": 362715,
      "text": "依然值得被需要、值得被尊重，",
      "token_start": 1780,
      "token_end_exclusive": 1792
    },
    {
      "start_ms": 362950,
      "end_ms": 363770,
      "text": "值得被欢迎，",
      "token_start": 1792,
      "token_end_exclusive": 1797
    },
    {
      "start_ms": 363990,
      "end_ms": 366095,
      "text": "值得拥有热气腾腾的生活。",
      "token_start": 1797,
      "token_end_exclusive": 1808
    },
    {
      "start_ms": 366550,
      "end_ms": 367750,
      "text": "我们嘴里说的老人，",
      "token_start": 1808,
      "token_end_exclusive": 1816
    },
    {
      "start_ms": 367850,
      "end_ms": 370105,
      "text": "其实就是几十年之后的自己。",
      "token_start": 1816,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 370560,
      "end_ms": 375375,
      "text": "所以我们今天修的每一个无障碍坡道完善了每一次异地医保，",
      "token_start": 1828,
      "token_end_exclusive": 1854
    },
    {
      "start_ms": 375660,
      "end_ms": 377240,
      "text": "增加了每一张公务员座椅。",
      "token_start": 1854,
      "token_end_exclusive": 1865
    },
    {
      "start_ms": 377260,
      "end_ms": 378500,
      "text": "表面上是在服务，",
      "token_start": 1865,
      "token_end_exclusive": 1872
    },
    {
      "start_ms": 378500,
      "end_ms": 379300,
      "text": "今天的老人，",
      "token_start": 1872,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 379520,
      "end_ms": 382005,
      "text": "其实都是在给未来的自己修路。",
      "token_start": 1877,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 382500,
      "end_ms": 383960,
      "text": "如果来不及认真年轻，",
      "token_start": 1890,
      "token_end_exclusive": 1899
    },
    {
      "start_ms": 384120,
      "end_ms": 385735,
      "text": "那就认真老去，",
      "token_start": 1899,
      "token_end_exclusive": 1905
    },
    {
      "start_ms": 386190,
      "end_ms": 388965,
      "text": "你会发现在变老也是在变好。",
      "token_start": 1905,
      "token_end_exclusive": 1917
    }
  ],
