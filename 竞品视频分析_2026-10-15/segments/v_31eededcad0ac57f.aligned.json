{
  "video_id": "v_31eededcad0ac57f",
  "duration_s": 392.973991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_31eededcad0ac57f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_31eededcad0ac57f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 680,
      "end_ms": 1160,
      "text": "爸爸，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1160,
      "end_ms": 4260,
      "text": "为什么同样一瓶矿泉水超市卖两块钱，",
      "token_start": 2,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4540,
      "end_ms": 6060,
      "text": "高铁上却卖的更贵？",
      "token_start": 18,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6580,
      "end_ms": 8160,
      "text": "高铁上的东西本来就贵，",
      "token_start": 26,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8359,
      "end_ms": 9400,
      "text": "有什么好奇怪的，",
      "token_start": 36,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 9640,
      "end_ms": 11200,
      "text": "可明明是同样的水，",
      "token_start": 43,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 11580,
      "end_ms": 13600,
      "text": "为什么换个地方就涨价了？",
      "token_start": 51,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 13840,
      "end_ms": 14920,
      "text": "人家卖多少钱，",
      "token_start": 62,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 14920,
      "end_ms": 16040,
      "text": "你不买不就行了吗？",
      "token_start": 68,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 16200,
      "end_ms": 17420,
      "text": "咱们自己带水就好了。",
      "token_start": 76,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 18020,
      "end_ms": 18440,
      "text": "爸爸，",
      "token_start": 85,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 18440,
      "end_ms": 19160,
      "text": "那我问你，",
      "token_start": 87,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 19400,
      "end_ms": 23220,
      "text": "如果高铁上有好几家卖水的价格还会这么贵吗？",
      "token_start": 91,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 23740,
      "end_ms": 25620,
      "text": "那肯定要看他们怎么定价了。",
      "token_start": 111,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 25860,
      "end_ms": 26340,
      "text": "对呀，",
      "token_start": 123,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 26820,
      "end_ms": 28140,
      "text": "如果买水不方便，",
      "token_start": 125,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 28300,
      "end_ms": 29100,
      "text": "选择又少，",
      "token_start": 132,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 29340,
      "end_ms": 31210,
      "text": "商家就可能卖的贵一些。",
      "token_start": 136,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 31570,
      "end_ms": 35150,
      "text": "不过还要算运输经营这些成本哟。",
      "token_start": 146,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 35730,
      "end_ms": 37870,
      "text": "你小子什么时候开始研究做生意了？",
      "token_start": 160,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 38529,
      "end_ms": 40355,
      "text": "我知道的可不止这些。",
      "token_start": 175,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 42220,
      "end_ms": 42660,
      "text": "爸爸，",
      "token_start": 184,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 42740,
      "end_ms": 43780,
      "text": "你有没有发现，",
      "token_start": 186,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 44220,
      "end_ms": 47240,
      "text": "很多商场一楼都是化妆品和珠宝，",
      "token_start": 192,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 47560,
      "end_ms": 48020,
      "text": "吃饭，",
      "token_start": 206,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 48040,
      "end_ms": 49460,
      "text": "看电影却要去楼上，",
      "token_start": 208,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 50060,
      "end_ms": 51380,
      "text": "可能是楼上环境好，",
      "token_start": 216,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 51440,
      "end_ms": 52320,
      "text": "吃饭舒服呗。",
      "token_start": 224,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 52720,
      "end_ms": 54900,
      "text": "那为什么不把餐厅放一楼，",
      "token_start": 229,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 55320,
      "end_ms": 56620,
      "text": "大家进来就能吃，",
      "token_start": 240,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 56900,
      "end_ms": 58060,
      "text": "不是更方便吗？",
      "token_start": 247,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 58760,
      "end_ms": 61400,
      "text": "商场人家自己设计的哪有那么多，",
      "token_start": 253,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 61400,
      "end_ms": 63930,
      "text": "为什么爸爸，",
      "token_start": 267,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 64190,
      "end_ms": 67495,
      "text": "你看大家进商场是不是都要经过一楼？",
      "token_start": 272,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 67820,
      "end_ms": 68725,
      "text": "那当然了，",
      "token_start": 288,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 69180,
      "end_ms": 72425,
      "text": "那如果一楼放的是容易吸引人注意的商品，",
      "token_start": 292,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 72810,
      "end_ms": 74490,
      "text": "就算本来没打算买的人，",
      "token_start": 310,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 74790,
      "end_ms": 76875,
      "text": "路过的时候也可能进去看看。",
      "token_start": 320,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 77830,
      "end_ms": 79615,
      "text": "那餐厅为什么要放楼上呢？",
      "token_start": 332,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 79980,
      "end_ms": 82505,
      "text": "因为很多人本来就是来吃饭看电影的，",
      "token_start": 343,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 82830,
      "end_ms": 84270,
      "text": "把这些店放在楼上，",
      "token_start": 359,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 84430,
      "end_ms": 85630,
      "text": "就能让人往上走。",
      "token_start": 367,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 85670,
      "end_ms": 88070,
      "text": "经过更多店铺这么说，",
      "token_start": 374,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 88590,
      "end_ms": 90615,
      "text": "商场连顾客怎么走都要考虑。",
      "token_start": 383,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 90890,
      "end_ms": 91470,
      "text": "当然啦，",
      "token_start": 395,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 91670,
      "end_ms": 93650,
      "text": "做生意不光要看卖什么，",
      "token_start": 398,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 93670,
      "end_ms": 95455,
      "text": "还要看东西摆在哪里。",
      "token_start": 408,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 103610,
      "end_ms": 105410,
      "text": "儿子刚才都是你在问我，",
      "token_start": 417,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 105430,
      "end_ms": 106835,
      "text": "现在爸爸考你一个问题。",
      "token_start": 427,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 107490,
      "end_ms": 107990,
      "text": "好啊，",
      "token_start": 437,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 108660,
      "end_ms": 111215,
      "text": "你说这自助餐交一次钱就能随便吃，",
      "token_start": 439,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 111660,
      "end_ms": 113045,
      "text": "万一客人都拼命吃，",
      "token_start": 454,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 113460,
      "end_ms": 114820,
      "text": "老板不是要亏本了吗？",
      "token_start": 462,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 114880,
      "end_ms": 115280,
      "text": "对呀，",
      "token_start": 471,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 115360,
      "end_ms": 116880,
      "text": "有些人一顿能吃好多呢，",
      "token_start": 473,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 117020,
      "end_ms": 120880,
      "text": "可是爸爸你觉得每个人都能把一百块钱的东西吃回本吗？",
      "token_start": 483,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 121080,
      "end_ms": 121960,
      "text": "那肯定不能。",
      "token_start": 507,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 122080,
      "end_ms": 124215,
      "text": "所以老板看的不是某一个人吃了多少，",
      "token_start": 512,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 124510,
      "end_ms": 127455,
      "text": "而是所有客人加起来平均能吃掉多少成本。",
      "token_start": 528,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 127690,
      "end_ms": 129610,
      "text": "你的意思是有人吃的多，",
      "token_start": 546,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 129690,
      "end_ms": 130550,
      "text": "也有人吃的少。",
      "token_start": 556,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 130730,
      "end_ms": 130970,
      "text": "对，",
      "token_start": 562,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 131370,
      "end_ms": 133050,
      "text": "而且老板还要算食材，",
      "token_start": 563,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 133150,
      "end_ms": 134915,
      "text": "人工、房租这些成本，",
      "token_start": 572,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 135250,
      "end_ms": 137290,
      "text": "只要整体收入能盖住成本，",
      "token_start": 580,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 137390,
      "end_ms": 138465,
      "text": "才有机会赚钱。",
      "token_start": 591,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 139300,
      "end_ms": 141025,
      "text": "以前只想着怎么吃回本，",
      "token_start": 597,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 141550,
      "end_ms": 143545,
      "text": "还真没想过老板是怎么算账的。",
      "token_start": 607,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 143880,
      "end_ms": 146500,
      "text": "所以啊吃饭的人想着怎么吃划算，",
      "token_start": 620,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 146640,
      "end_ms": 148675,
      "text": "开店的人想着怎么经营才赚钱，",
      "token_start": 634,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 149580,
      "end_ms": 150680,
      "text": "你不是要考儿子吗？",
      "token_start": 647,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 150700,
      "end_ms": 152555,
      "text": "怎么反倒让儿子给你上课了？",
      "token_start": 655,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 159480,
      "end_ms": 160985,
      "text": "今天这猪肉还挺便宜的，",
      "token_start": 667,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 161300,
      "end_ms": 162780,
      "text": "比上次买的时候降了不少，",
      "token_start": 677,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 163120,
      "end_ms": 164705,
      "text": "那正好多买点回去，",
      "token_start": 688,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 165120,
      "end_ms": 166275,
      "text": "便宜是便宜了。",
      "token_start": 696,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 166660,
      "end_ms": 168905,
      "text": "可最近这肉卖的还没以前好呢，",
      "token_start": 702,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 169360,
      "end_ms": 170360,
      "text": "价格都降了，",
      "token_start": 715,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 170500,
      "end_ms": 171700,
      "text": "怎么反而不好卖了。",
      "token_start": 720,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 171820,
      "end_ms": 173745,
      "text": "可能最近买肉的人少了吧，",
      "token_start": 728,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 174040,
      "end_ms": 175470,
      "text": "爸爸按道理，",
      "token_start": 739,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 175470,
      "end_ms": 176170,
      "text": "猪肉便宜了，",
      "token_start": 744,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 176170,
      "end_ms": 177710,
      "text": "买的人不是应该更多吗？",
      "token_start": 749,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 177910,
      "end_ms": 179270,
      "text": "可能大家手里没钱了吧，",
      "token_start": 759,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 179270,
      "end_ms": 180090,
      "text": "想省着点花。",
      "token_start": 769,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 180350,
      "end_ms": 180930,
      "text": "那爸爸，",
      "token_start": 774,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 181030,
      "end_ms": 182949,
      "text": "你觉得附近工地开工少了，",
      "token_start": 777,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 182949,
      "end_ms": 184475,
      "text": "会不会也影响猪肉销量？",
      "token_start": 788,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 184980,
      "end_ms": 186840,
      "text": "工地开工跟猪肉有什么关系？",
      "token_start": 798,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 186960,
      "end_ms": 190520,
      "text": "你想啊如果一个工地原来每天有几百个工人吃饭，",
      "token_start": 810,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 190820,
      "end_ms": 192840,
      "text": "食堂是不是每天都要买不少肉？",
      "token_start": 831,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 193040,
      "end_ms": 195355,
      "text": "那肯定啊人多吃的也多。",
      "token_start": 844,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 195680,
      "end_ms": 197025,
      "text": "那如果工地停工了，",
      "token_start": 854,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 197320,
      "end_ms": 198335,
      "text": "吃饭的人少了，",
      "token_start": 862,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 198690,
      "end_ms": 200510,
      "text": "食堂还需要买那么多肉吗？",
      "token_start": 868,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 200710,
      "end_ms": 201750,
      "text": "当然不需要了。",
      "token_start": 879,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 201950,
      "end_ms": 204450,
      "text": "所以啊有时候不是因为猪肉降价了，",
      "token_start": 885,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 204450,
      "end_ms": 205330,
      "text": "大家才买的少，",
      "token_start": 900,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 205590,
      "end_ms": 207410,
      "text": "而是因为买肉的人变少了，",
      "token_start": 906,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 207430,
      "end_ms": 208905,
      "text": "价格才可能跟着下降。",
      "token_start": 917,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 209270,
      "end_ms": 209730,
      "text": "这么说，",
      "token_start": 926,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 209870,
      "end_ms": 210970,
      "text": "猪肉卖的好不好，",
      "token_start": 929,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 211070,
      "end_ms": 212365,
      "text": "还跟别的行业有关系。",
      "token_start": 936,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 212550,
      "end_ms": 213085,
      "text": "当然啦，",
      "token_start": 945,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 213430,
      "end_ms": 214570,
      "text": "工地开工少了，",
      "token_start": 948,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 214590,
      "end_ms": 216025,
      "text": "不光猪肉可能卖的少，",
      "token_start": 954,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 216340,
      "end_ms": 219075,
      "text": "蔬菜米面这些东西的需求也可能跟着减少，",
      "token_start": 963,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 219530,
      "end_ms": 222410,
      "text": "原来一个地方的变化还会影响这么多生意。",
      "token_start": 981,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 222470,
      "end_ms": 222825,
      "text": "对，",
      "token_start": 999,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 223290,
      "end_ms": 226505,
      "text": "不过猪肉价格和销量变化也不一定就是工地造成的，",
      "token_start": 1000,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 226770,
      "end_ms": 230165,
      "text": "还可能跟供应多少季节和大家的消费习惯有关。",
      "token_start": 1022,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 230590,
      "end_ms": 232250,
      "text": "以前我只知道东西便宜了，",
      "token_start": 1042,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 232250,
      "end_ms": 233095,
      "text": "应该更好卖。",
      "token_start": 1053,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 233510,
      "end_ms": 235375,
      "text": "还真没想过背后有这么多原因。",
      "token_start": 1058,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 235650,
      "end_ms": 237170,
      "text": "所以爸爸生活里，",
      "token_start": 1071,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 237170,
      "end_ms": 239115,
      "text": "很多事情不能只看表面，",
      "token_start": 1078,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 239480,
      "end_ms": 241675,
      "text": "要想想他们之间有没有联系。",
      "token_start": 1088,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 242240,
      "end_ms": 242660,
      "text": "行了，",
      "token_start": 1100,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 242800,
      "end_ms": 244875,
      "text": "你们爷俩的经济学课先上到这儿，",
      "token_start": 1102,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 245070,
      "end_ms": 246365,
      "text": "咱们还得回家做饭呢。",
      "token_start": 1116,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 246810,
      "end_ms": 248815,
      "text": "看来今天这趟超市没白来，",
      "token_start": 1125,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 249180,
      "end_ms": 250595,
      "text": "我又跟儿子学了一课，",
      "token_start": 1136,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 259760,
      "end_ms": 261855,
      "text": "儿子妈妈也考你一个问题，",
      "token_start": 1145,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 262230,
      "end_ms": 262650,
      "text": "妈妈，",
      "token_start": 1156,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 262650,
      "end_ms": 263325,
      "text": "你问吧，",
      "token_start": 1158,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 263650,
      "end_ms": 266130,
      "text": "为什么很多牛奶都是方盒子可乐，",
      "token_start": 1161,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 266130,
      "end_ms": 267345,
      "text": "却经常用圆瓶子？",
      "token_start": 1175,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 267600,
      "end_ms": 268340,
      "text": "这个我知道，",
      "token_start": 1182,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 268400,
      "end_ms": 270060,
      "text": "不就是厂家觉得这样好看吗？",
      "token_start": 1187,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 270140,
      "end_ms": 271660,
      "text": "爸爸可不只是为了好看？",
      "token_start": 1199,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 271840,
      "end_ms": 274420,
      "text": "那你说说方形的牛奶盒摆在一起，",
      "token_start": 1209,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 274420,
      "end_ms": 275385,
      "text": "可以贴得更紧，",
      "token_start": 1223,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 275680,
      "end_ms": 278085,
      "text": "运输和存放的时候能更好的利用空间。",
      "token_start": 1229,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 278480,
      "end_ms": 280180,
      "text": "可乐里面有气圆形，",
      "token_start": 1245,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 280180,
      "end_ms": 281420,
      "text": "瓶身更容易均匀，",
      "token_start": 1253,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 281420,
      "end_ms": 281780,
      "text": "分散，",
      "token_start": 1260,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 281780,
      "end_ms": 282545,
      "text": "内部压力。",
      "token_start": 1262,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 283010,
      "end_ms": 284325,
      "text": "不过包装怎么设计，",
      "token_start": 1266,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 284540,
      "end_ms": 287500,
      "text": "还得考虑材料成本和使用方不方便，",
      "token_start": 1274,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 287660,
      "end_ms": 290040,
      "text": "连一个瓶子的形状都有这么多讲究。",
      "token_start": 1289,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 290300,
      "end_ms": 290935,
      "text": "当然啦，",
      "token_start": 1304,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 291380,
      "end_ms": 293200,
      "text": "生活里很多不起眼的小东西，",
      "token_start": 1307,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 293360,
      "end_ms": 294975,
      "text": "背后都有做生意的学问。",
      "token_start": 1319,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 295790,
      "end_ms": 296205,
      "text": "儿子，",
      "token_start": 1329,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 296390,
      "end_ms": 297095,
      "text": "爸爸问你个事，",
      "token_start": 1331,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 297820,
      "end_ms": 298505,
      "text": "什么事儿？",
      "token_start": 1337,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 298950,
      "end_ms": 300465,
      "text": "这些东西学校还没交吧。",
      "token_start": 1341,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 301220,
      "end_ms": 302515,
      "text": "你到底从哪里学来的？",
      "token_start": 1351,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 314380,
      "end_ms": 318140,
      "text": "就是从这套写给孩子的经济学启蒙课里面学来的。",
      "token_start": 1360,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 319700,
      "end_ms": 320240,
      "text": "你们看，",
      "token_start": 1381,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 320460,
      "end_ms": 322640,
      "text": "他不是光讲那些难懂的道理，",
      "token_start": 1384,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 322860,
      "end_ms": 326880,
      "text": "而是把生活里跟钱买东西、做生意有关的知识，",
      "token_start": 1396,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 327160,
      "end_ms": 328800,
      "text": "都用漫画故事讲出来。",
      "token_start": 1415,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 329580,
      "end_ms": 331720,
      "text": "难怪你最近总爱问这些问题，",
      "token_start": 1424,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 331920,
      "end_ms": 334840,
      "text": "你们看书里还讲了很多有意思的问题，",
      "token_start": 1436,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 335260,
      "end_ms": 337460,
      "text": "比如由谁来决定价格呢？",
      "token_start": 1452,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 337640,
      "end_ms": 339140,
      "text": "什么是需求和供题，",
      "token_start": 1462,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 339380,
      "end_ms": 341240,
      "text": "比如如何不盲目购物？",
      "token_start": 1470,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 341440,
      "end_ms": 341680,
      "text": "哎，",
      "token_start": 1479,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 341700,
      "end_ms": 343725,
      "text": "这里还有一个冰淇淋的价格，",
      "token_start": 1480,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 343910,
      "end_ms": 344910,
      "text": "为什么不一样呢？",
      "token_start": 1492,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 344990,
      "end_ms": 347730,
      "text": "还有这个我们花的钱是从哪儿来的？",
      "token_start": 1499,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 347930,
      "end_ms": 349090,
      "text": "以前我买东西，",
      "token_start": 1514,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 349270,
      "end_ms": 350590,
      "text": "只知道想买就买，",
      "token_start": 1520,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 351010,
      "end_ms": 353410,
      "text": "现在我会想这个东西到底值不值，",
      "token_start": 1527,
      "token_end_exclusive": 1541
    },
    {
      "start_ms": 353510,
      "end_ms": 354590,
      "text": "我是不是真的需要。",
      "token_start": 1541,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 354770,
      "end_ms": 356990,
      "text": "原来财商不只是教孩子怎么存钱，",
      "token_start": 1549,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 357070,
      "end_ms": 357710,
      "text": "怎么赚钱，",
      "token_start": 1563,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 357990,
      "end_ms": 358590,
      "text": "当然了，",
      "token_start": 1567,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 358710,
      "end_ms": 360630,
      "text": "还要知道钱是怎么花出去的，",
      "token_start": 1570,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 360730,
      "end_ms": 362185,
      "text": "商家又是怎么赚钱的。",
      "token_start": 1582,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 362560,
      "end_ms": 365570,
      "text": "我以前总觉得你现在还小赚钱的事情，",
      "token_start": 1591,
      "token_end_exclusive": 1607
    },
    {
      "start_ms": 365590,
      "end_ms": 367085,
      "text": "等长大了再学也不迟。",
      "token_start": 1607,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 367510,
      "end_ms": 367790,
      "text": "其实，",
      "token_start": 1616,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 367790,
      "end_ms": 369250,
      "text": "孩子每天都在接触钱，",
      "token_start": 1618,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 369450,
      "end_ms": 371390,
      "text": "买零食、买玩具、逛超市，",
      "token_start": 1627,
      "token_end_exclusive": 1636
    },
    {
      "start_ms": 371610,
      "end_ms": 372810,
      "text": "哪一样不需要花钱。",
      "token_start": 1636,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 372950,
      "end_ms": 373495,
      "text": "是啊，",
      "token_start": 1644,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 373940,
      "end_ms": 375840,
      "text": "与其等他长大以后自己吃亏，",
      "token_start": 1646,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 375980,
      "end_ms": 378165,
      "text": "不如现在就让他慢慢学会判断。",
      "token_start": 1658,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 378600,
      "end_ms": 380700,
      "text": "以后你再有什么不懂的就拿出来，",
      "token_start": 1671,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 380700,
      "end_ms": 381665,
      "text": "咱们一起研究。",
      "token_start": 1685,
      "token_end_exclusive": 1691
    },
    {
      "start_ms": 381990,
      "end_ms": 382890,
      "text": "爸爸不知道的，",
      "token_start": 1691,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 382890,
      "end_ms": 383855,
      "text": "也跟你一起学。",
      "token_start": 1697,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 384160,
      "end_ms": 385560,
      "text": "那咱们从今天开始，",
      "token_start": 1703,
      "token_end_exclusive": 1711
    },
    {
      "start_ms": 385720,
      "end_ms": 387420,
      "text": "每天一起看两个漫画故事，",
      "token_start": 1711,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 387420,
      "end_ms": 387900,
      "text": "好不好？",
      "token_start": 1722,
      "token_end_exclusive": 1725
    },
    {
      "start_ms": 388020,
      "end_ms": 390395,
      "text": "好爸爸陪你妈妈也陪你。",
      "token_start": 1725,
      "token_end_exclusive": 1735
    }
  ],
