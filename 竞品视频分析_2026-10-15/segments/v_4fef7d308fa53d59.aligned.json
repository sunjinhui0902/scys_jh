{
  "video_id": "v_4fef7d308fa53d59",
  "duration_s": 396.573991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_4fef7d308fa53d59.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_4fef7d308fa53d59.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 6090,
      "text": "您知道中国秋天最值得专程跑一趟的圣地是哪一处吗？",
      "token_start": 0,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 7090,
      "end_ms": 11590,
      "text": "有人说四川九寨沟秋天水色天下第一，",
      "token_start": 23,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 12190,
      "end_ms": 16309,
      "text": "有人说北京香山红叶名气大的没边，",
      "token_start": 39,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 16790,
      "end_ms": 17570,
      "text": "对不住了，",
      "token_start": 54,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 18550,
      "end_ms": 20390,
      "text": "九寨沟排不进前五，",
      "token_start": 58,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 20910,
      "end_ms": 22650,
      "text": "香山也只能垫底。",
      "token_start": 66,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 23430,
      "end_ms": 27150,
      "text": "香正排第一的那一处不在名山大川，",
      "token_start": 73,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 27790,
      "end_ms": 29605,
      "text": "也不在古都名城，",
      "token_start": 88,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 30470,
      "end_ms": 32810,
      "text": "一年就那么短短几十天，",
      "token_start": 95,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 33310,
      "end_ms": 36230,
      "text": "整座大山从山顶到山脚，",
      "token_start": 105,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 36390,
      "end_ms": 38010,
      "text": "自己换上一身颜色。",
      "token_start": 115,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 38670,
      "end_ms": 43410,
      "text": "今天咱们就来盘点中国十大秋日名山。",
      "token_start": 123,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 43490,
      "end_ms": 44250,
      "text": "话不多说，",
      "token_start": 139,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 44510,
      "end_ms": 45670,
      "text": "茶给您沏上了，",
      "token_start": 143,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 45990,
      "end_ms": 48130,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 149,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 48370,
      "end_ms": 49390,
      "text": "咱们这就开讲。",
      "token_start": 159,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 50550,
      "end_ms": 51250,
      "text": "第十名。",
      "token_start": 165,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 52110,
      "end_ms": 58970,
      "text": "北京香山京西名山香山红叶是京城秋天的金字招牌。",
      "token_start": 168,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 59350,
      "end_ms": 64045,
      "text": "全园采叶树种有黄痤、元宝峰、银杏等，",
      "token_start": 190,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 64580,
      "end_ms": 68985,
      "text": "红叶节期间累计接待游客超过八十五万人次。",
      "token_start": 205,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 69480,
      "end_ms": 71155,
      "text": "黄格赤是主力军，",
      "token_start": 224,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 71750,
      "end_ms": 74595,
      "text": "漫山遍野红的像火焰一样，",
      "token_start": 231,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 75030,
      "end_ms": 79095,
      "text": "跟碧云寺、香山寺这些古建筑搭在一起，",
      "token_start": 242,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 79670,
      "end_ms": 81275,
      "text": "别处找不到这个味儿，",
      "token_start": 258,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 81800,
      "end_ms": 82580,
      "text": "可您知道吗？",
      "token_start": 267,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 82580,
      "end_ms": 83615,
      "text": "一到红叶节，",
      "token_start": 272,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 84050,
      "end_ms": 84870,
      "text": "香炉峰上，",
      "token_start": 277,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 84890,
      "end_ms": 86900,
      "text": "全是人脑袋拍照的，",
      "token_start": 281,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 86900,
      "end_ms": 87540,
      "text": "举着手机，",
      "token_start": 289,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 87540,
      "end_ms": 88905,
      "text": "等半天才轮得上。",
      "token_start": 293,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 89350,
      "end_ms": 92195,
      "text": "您说看红叶到底是看树还是看人呢？",
      "token_start": 300,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 92540,
      "end_ms": 93845,
      "text": "能排进前十，",
      "token_start": 315,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 94400,
      "end_ms": 98115,
      "text": "靠的是老底子和京城的那股子气派。",
      "token_start": 320,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 98660,
      "end_ms": 99325,
      "text": "第九名，",
      "token_start": 335,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 99670,
      "end_ms": 102205,
      "text": "湖南张家界、湘西武陵源。",
      "token_start": 338,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 102770,
      "end_ms": 106535,
      "text": "很多人一提张家界脑子里就是那些石头柱子，",
      "token_start": 348,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 107200,
      "end_ms": 110255,
      "text": "可秋天的张家界完全是另一副面孔。",
      "token_start": 367,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 111130,
      "end_ms": 113335,
      "text": "每年九月到十一月，",
      "token_start": 382,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 113870,
      "end_ms": 114870,
      "text": "天子山一带，",
      "token_start": 390,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 114950,
      "end_ms": 115965,
      "text": "云雾缭绕，",
      "token_start": 395,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 116550,
      "end_ms": 117550,
      "text": "石英沙岩。",
      "token_start": 399,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 117570,
      "end_ms": 120500,
      "text": "风林在云海里若隐若现，",
      "token_start": 403,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 120640,
      "end_ms": 123745,
      "text": "金黄的银杏和火红的枫叶，",
      "token_start": 413,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 124070,
      "end_ms": 126755,
      "text": "跟灰白色的石头风铃搅在一起。",
      "token_start": 424,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 127730,
      "end_ms": 129255,
      "text": "雨后初晴的清晨，",
      "token_start": 437,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 129790,
      "end_ms": 132235,
      "text": "云海沿山谷漫涌过来，",
      "token_start": 444,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 133090,
      "end_ms": 135510,
      "text": "一座座石柱忽明武汉，",
      "token_start": 453,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 136000,
      "end_ms": 137255,
      "text": "时而露出全身，",
      "token_start": 462,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 137580,
      "end_ms": 138695,
      "text": "时而缩进云里。",
      "token_start": 468,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 139800,
      "end_ms": 141555,
      "text": "您站在天子阁上往下望，",
      "token_start": 474,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 142400,
      "end_ms": 144690,
      "text": "脚底下是云云，",
      "token_start": 484,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 144690,
      "end_ms": 146470,
      "text": "里头是风风，",
      "token_start": 490,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 146510,
      "end_ms": 151175,
      "text": "上面是秋叶三千座奇峰泡在云海里。",
      "token_start": 495,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 151710,
      "end_ms": 154170,
      "text": "您说这样的地方是不是老天爷喝醉了，",
      "token_start": 510,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 154170,
      "end_ms": 156545,
      "text": "画出来第八名，",
      "token_start": 526,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 157480,
      "end_ms": 163730,
      "text": "江西庐山、九江名山庐山的秋天跟别处不一样，",
      "token_start": 532,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 163750,
      "end_ms": 165485,
      "text": "他是有文人气质的。",
      "token_start": 551,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 165900,
      "end_ms": 168225,
      "text": "李白写过飞流直下三千尺，",
      "token_start": 559,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 168840,
      "end_ms": 170185,
      "text": "可秋天来庐山。",
      "token_start": 570,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 170500,
      "end_ms": 171700,
      "text": "您看的不是瀑布，",
      "token_start": 576,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 171880,
      "end_ms": 172485,
      "text": "是雾。",
      "token_start": 583,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 173170,
      "end_ms": 174135,
      "text": "深秋一到，",
      "token_start": 585,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 174530,
      "end_ms": 177815,
      "text": "如琴湖畔的洪峰倒映在水面上，",
      "token_start": 589,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 178270,
      "end_ms": 179515,
      "text": "梧桐叶黄了，",
      "token_start": 602,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 179830,
      "end_ms": 180775,
      "text": "鸡爪红了，",
      "token_start": 607,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 181090,
      "end_ms": 182650,
      "text": "山雾随风飘过来，",
      "token_start": 611,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 182750,
      "end_ms": 185780,
      "text": "半遮半掩彩色的秋景，",
      "token_start": 618,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 185780,
      "end_ms": 186680,
      "text": "一会儿看得见，",
      "token_start": 627,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 186680,
      "end_ms": 187605,
      "text": "一会儿看不见，",
      "token_start": 633,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 187920,
      "end_ms": 188880,
      "text": "倒映在湖里，",
      "token_start": 639,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 188880,
      "end_ms": 191860,
      "text": "跟做梦似最佳赏秋期。",
      "token_start": 644,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 192060,
      "end_ms": 194825,
      "text": "是十月下旬到十一月上旬，",
      "token_start": 653,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 195340,
      "end_ms": 197375,
      "text": "高海拔的红叶鲜红，",
      "token_start": 664,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 197880,
      "end_ms": 201010,
      "text": "低处的银杏接棒能一直美。",
      "token_start": 672,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 201010,
      "end_ms": 202190,
      "text": "到十二月初，",
      "token_start": 683,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 202390,
      "end_ms": 204605,
      "text": "您沿着锦绣谷慢慢走，",
      "token_start": 688,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 204980,
      "end_ms": 206405,
      "text": "雾来了就歇歇脚，",
      "token_start": 697,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 206800,
      "end_ms": 207500,
      "text": "误走了，",
      "token_start": 704,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 207500,
      "end_ms": 209470,
      "text": "就接着看一座山，",
      "token_start": 707,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 209730,
      "end_ms": 213305,
      "text": "能让您一天里看到三种不同的秋色。",
      "token_start": 714,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 213800,
      "end_ms": 218045,
      "text": "您说这是不是把秋天过程的事第七名？",
      "token_start": 729,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 219190,
      "end_ms": 220115,
      "text": "安徽黄山，",
      "token_start": 745,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 220460,
      "end_ms": 226115,
      "text": "皖南名山黄山的秋天是云海和高山松的搭配。",
      "token_start": 749,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 226600,
      "end_ms": 227455,
      "text": "深秋一到，",
      "token_start": 768,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 228160,
      "end_ms": 228660,
      "text": "洪枫，",
      "token_start": 772,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 229000,
      "end_ms": 232945,
      "text": "乌折银杏点缀在奇松怪石之间，",
      "token_start": 774,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 233210,
      "end_ms": 233930,
      "text": "晴天多，",
      "token_start": 787,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 234410,
      "end_ms": 235235,
      "text": "湿度低，",
      "token_start": 790,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 235690,
      "end_ms": 238235,
      "text": "撞见云海日出的机会特别大。",
      "token_start": 793,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 238910,
      "end_ms": 243520,
      "text": "最佳观赏期是十月下旬到十一月上旬。",
      "token_start": 805,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 243660,
      "end_ms": 244440,
      "text": "这段时间，",
      "token_start": 821,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 244440,
      "end_ms": 246355,
      "text": "彩铃和云海一起上，",
      "token_start": 825,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 246770,
      "end_ms": 248735,
      "text": "您在光明顶等日出，",
      "token_start": 833,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 249190,
      "end_ms": 251005,
      "text": "脚底下云海翻腾，",
      "token_start": 841,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 251690,
      "end_ms": 254685,
      "text": "远处的山峰从云里冒出来，",
      "token_start": 848,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 255080,
      "end_ms": 257805,
      "text": "近处的松树枝上挂着秋叶，",
      "token_start": 859,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 258490,
      "end_ms": 261895,
      "text": "您站在鳌鱼峰上看西海大峡谷，",
      "token_start": 870,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 262720,
      "end_ms": 267415,
      "text": "整条峡谷从浅黄到火红一层一层往底下铺。",
      "token_start": 883,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 268190,
      "end_ms": 269775,
      "text": "松树还是绿的，",
      "token_start": 901,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 270690,
      "end_ms": 271470,
      "text": "夹在中间，",
      "token_start": 907,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 271590,
      "end_ms": 274410,
      "text": "像有人拿刀刻出来的一座山，",
      "token_start": 911,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 274470,
      "end_ms": 279735,
      "text": "把云海齐松、秋叶三样东西攒在一块儿，",
      "token_start": 923,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 280370,
      "end_ms": 283330,
      "text": "您说值不值得爬那一千多级台阶。",
      "token_start": 939,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 283450,
      "end_ms": 284030,
      "text": "第六名，",
      "token_start": 953,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 284110,
      "end_ms": 290535,
      "text": "江苏南京栖霞山、金陵名山栖霞山被叫做金陵最美的一座山。",
      "token_start": 956,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 291130,
      "end_ms": 293905,
      "text": "每年十一月中旬到十二月初。",
      "token_start": 981,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 294590,
      "end_ms": 297350,
      "text": "红叶覆盖率超过百分之八十。",
      "token_start": 993,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 298010,
      "end_ms": 303510,
      "text": "栖霞古寺是南朝四百八十寺里留下来的红墙黑瓦，",
      "token_start": 1005,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 303550,
      "end_ms": 305950,
      "text": "配上满天红叶蝉，",
      "token_start": 1026,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 306030,
      "end_ms": 307410,
      "text": "意浓的化不开。",
      "token_start": 1033,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 307830,
      "end_ms": 309190,
      "text": "您从西门进去，",
      "token_start": 1039,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 309590,
      "end_ms": 310990,
      "text": "先过栖霞寺，",
      "token_start": 1045,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 311390,
      "end_ms": 312910,
      "text": "再往桃花湖走，",
      "token_start": 1050,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 313390,
      "end_ms": 315310,
      "text": "先边鸡爪红的发亮。",
      "token_start": 1056,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 315950,
      "end_ms": 318410,
      "text": "石面上飘着一层红叶，",
      "token_start": 1064,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 318930,
      "end_ms": 321530,
      "text": "石阶上飘着一厚一层，",
      "token_start": 1073,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 322090,
      "end_ms": 323835,
      "text": "踩上去咔咔响。",
      "token_start": 1082,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 324750,
      "end_ms": 327550,
      "text": "中山陵那边的梧桐也黄了，",
      "token_start": 1088,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 327570,
      "end_ms": 328330,
      "text": "一条陵园，",
      "token_start": 1099,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 328330,
      "end_ms": 330070,
      "text": "路两侧全是金色，",
      "token_start": 1103,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 330730,
      "end_ms": 332410,
      "text": "南京的秋天短的很，",
      "token_start": 1110,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 332530,
      "end_ms": 333650,
      "text": "就那么二十来天。",
      "token_start": 1118,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 334550,
      "end_ms": 338690,
      "text": "一座山把六朝古都的秋天浓缩在一条山沟里，",
      "token_start": 1125,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 339390,
      "end_ms": 342510,
      "text": "您说这是不是老天爷对南京的偏爱？",
      "token_start": 1144,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 343070,
      "end_ms": 344490,
      "text": "从第十道第六名，",
      "token_start": 1159,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 344970,
      "end_ms": 347290,
      "text": "香山靠的是京城老底子。",
      "token_start": 1166,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 347810,
      "end_ms": 350410,
      "text": "张家界的奇峰泡在云海里，",
      "token_start": 1176,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 350870,
      "end_ms": 354155,
      "text": "庐山用雾和红叶搭出了石意。",
      "token_start": 1187,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 354980,
      "end_ms": 358015,
      "text": "黄山把云海和彩林攒在一块儿，",
      "token_start": 1199,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 358380,
      "end_ms": 360725,
      "text": "栖霞山拿古饰配红墙，",
      "token_start": 1212,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 361200,
      "end_ms": 363920,
      "text": "可他们还不是最值得专程跑一趟的。",
      "token_start": 1221,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 363980,
      "end_ms": 366205,
      "text": "接下来第五道第一名更厉害。",
      "token_start": 1236,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 366710,
      "end_ms": 367715,
      "text": "有一座古村，",
      "token_start": 1248,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 368010,
      "end_ms": 370835,
      "text": "把梯田和银杏画成了油画，",
      "token_start": 1253,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 371260,
      "end_ms": 372960,
      "text": "有一片贪涂在秋天，",
      "token_start": 1264,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 372960,
      "end_ms": 374625,
      "text": "变成光影的海洋，",
      "token_start": 1272,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 375010,
      "end_ms": 377185,
      "text": "可排在榜首的那一处。",
      "token_start": 1279,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 377740,
      "end_ms": 381145,
      "text": "整座火山天池泡在金黄色的林海里，",
      "token_start": 1288,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 381480,
      "end_ms": 382085,
      "text": "他是哪里？",
      "token_start": 1303,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 382400,
      "end_ms": 387185,
      "text": "他凭什么排在九寨沟前面下一集已经同步更新了，",
      "token_start": 1307,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 387570,
      "end_ms": 388670,
      "text": "点开我的头像，",
      "token_start": 1328,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 388830,
      "end_ms": 391980,
      "text": "进主页就能看到点个关注，",
      "token_start": 1334,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 392080,
      "end_ms": 396445,
      "text": "看看谁才是中国秋日胜地真正的天花板。",
      "token_start": 1345,
      "token_end_exclusive": 1362
    }
  ],
