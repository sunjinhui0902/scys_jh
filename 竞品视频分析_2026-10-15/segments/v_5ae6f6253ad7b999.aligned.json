{
  "video_id": "v_5ae6f6253ad7b999",
  "duration_s": 365.133991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_5ae6f6253ad7b999.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_5ae6f6253ad7b999.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 830,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1210,
      "end_ms": 4470,
      "text": "据联合国教科文组织不完全统计，",
      "token_start": 4,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5270,
      "end_ms": 20930,
      "text": "全世界四十七个国家的两百一十八家博物馆里藏着一百六十七万件中国文物流散在民间的更是馆藏的十倍之多可。",
      "token_start": 18,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 20930,
      "end_ms": 23730,
      "text": "要说哪一件最让人心疼，",
      "token_start": 67,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 24210,
      "end_ms": 25530,
      "text": "那说法可就多了。",
      "token_start": 77,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 26270,
      "end_ms": 28350,
      "text": "有人说是圆明园兽首，",
      "token_start": 84,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 28750,
      "end_ms": 30580,
      "text": "有人说是敦煌的经卷。",
      "token_start": 93,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 31160,
      "end_ms": 31400,
      "text": "错，",
      "token_start": 102,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 31780,
      "end_ms": 33840,
      "text": "真要论起心疼进兽首，",
      "token_start": 103,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 33840,
      "end_ms": 35140,
      "text": "连乾五都进不去。",
      "token_start": 112,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 35600,
      "end_ms": 36040,
      "text": "今天，",
      "token_start": 119,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 36220,
      "end_ms": 40340,
      "text": "咱们就来盘点中国流落海外的十大文物。",
      "token_start": 121,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 40460,
      "end_ms": 41480,
      "text": "先讲第十道，",
      "token_start": 138,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 41480,
      "end_ms": 42620,
      "text": "第六一件，",
      "token_start": 143,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 42620,
      "end_ms": 43620,
      "text": "比一剑揪心。",
      "token_start": 147,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 44300,
      "end_ms": 45000,
      "text": "老规矩，",
      "token_start": 152,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 45320,
      "end_ms": 46200,
      "text": "开讲之前，",
      "token_start": 155,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 46540,
      "end_ms": 48660,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 159,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 49020,
      "end_ms": 51100,
      "text": "让我看看都是谁在听。",
      "token_start": 169,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 52220,
      "end_ms": 52900,
      "text": "第十名。",
      "token_start": 178,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 53220,
      "end_ms": 57520,
      "text": "圆明园十二生肖兽首一八六零年，",
      "token_start": 181,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 57860,
      "end_ms": 66185,
      "text": "英法联军火烧圆圆明园海宴堂前喷泉上的十二尊兽首铜像被抢走了。",
      "token_start": 195,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 66920,
      "end_ms": 67860,
      "text": "一百多年来，",
      "token_start": 224,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 68060,
      "end_ms": 69945,
      "text": "他们散落在世界各地，",
      "token_start": 229,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 70520,
      "end_ms": 75295,
      "text": "直到最近这些年才有七尊回到了中国牛首。",
      "token_start": 238,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 75590,
      "end_ms": 79865,
      "text": "虎首猴首猪首鼠首兔首马首。",
      "token_start": 256,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 80350,
      "end_ms": 84665,
      "text": "这七尊通过拍卖和捐献陆续回来了，",
      "token_start": 268,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 85120,
      "end_ms": 89655,
      "text": "可还有五尊龙首蛇首养手棘手，",
      "token_start": 283,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 89930,
      "end_ms": 92415,
      "text": "狗手到现在下落不明。",
      "token_start": 296,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 92780,
      "end_ms": 95160,
      "text": "十二个铜脑袋走散了，",
      "token_start": 305,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 95160,
      "end_ms": 98040,
      "text": "一百六十多年只回来了，",
      "token_start": 314,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 98040,
      "end_ms": 98745,
      "text": "一半多，",
      "token_start": 324,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 99700,
      "end_ms": 101465,
      "text": "一家人被拆散了，",
      "token_start": 327,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 101660,
      "end_ms": 103685,
      "text": "您说这事上上儿说理去。",
      "token_start": 334,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 104830,
      "end_ms": 105585,
      "text": "第九名。",
      "token_start": 344,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 105960,
      "end_ms": 108935,
      "text": "河北易县辽代三彩罗汉。",
      "token_start": 347,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 109640,
      "end_ms": 112175,
      "text": "河北易县巴佛洼的山洞里，",
      "token_start": 357,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 112570,
      "end_ms": 116190,
      "text": "供着十六尊等身大的三彩罗汉，",
      "token_start": 368,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 116190,
      "end_ms": 120430,
      "text": "像每一尊都跟真人差不多大，",
      "token_start": 381,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 120590,
      "end_ms": 121635,
      "text": "面部表情，",
      "token_start": 393,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 122040,
      "end_ms": 123700,
      "text": "手指姿态一吻，",
      "token_start": 397,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 123700,
      "end_ms": 125825,
      "text": "褶皱做的跟活人一样。",
      "token_start": 403,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 126710,
      "end_ms": 128195,
      "text": "西方学者看了说，",
      "token_start": 412,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 128560,
      "end_ms": 131535,
      "text": "这双手比达芬奇画的蒙娜丽莎的手都好。",
      "token_start": 419,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 132290,
      "end_ms": 133435,
      "text": "可一百多年前，",
      "token_start": 436,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 134020,
      "end_ms": 136975,
      "text": "古董商把他们一尊一尊偷运出去，",
      "token_start": 442,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 137360,
      "end_ms": 139815,
      "text": "十六尊罗汉碎了五尊，",
      "token_start": 456,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 140160,
      "end_ms": 141255,
      "text": "剩下十一尊，",
      "token_start": 465,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 141700,
      "end_ms": 142160,
      "text": "散落。",
      "token_start": 470,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 142160,
      "end_ms": 144315,
      "text": "在全世界九个博物馆里，",
      "token_start": 472,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 145430,
      "end_ms": 155075,
      "text": "大英博物馆大都会博物馆、波士顿美术馆、集美博物馆、加拿大皇家安大略博物馆。",
      "token_start": 482,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 156200,
      "end_ms": 156915,
      "text": "您想想，",
      "token_start": 515,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 158050,
      "end_ms": 161415,
      "text": "依山洞的罗汉本来整整齐齐坐着，",
      "token_start": 518,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 161770,
      "end_ms": 163945,
      "text": "现在被拆散到五六个国家，",
      "token_start": 532,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 164330,
      "end_ms": 165445,
      "text": "再也凑不齐了。",
      "token_start": 543,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 166640,
      "end_ms": 167335,
      "text": "第八名，",
      "token_start": 549,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 167960,
      "end_ms": 169805,
      "text": "龙门石窟帝后礼佛图，",
      "token_start": 552,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 170630,
      "end_ms": 171485,
      "text": "北魏时期，",
      "token_start": 561,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 171780,
      "end_ms": 176515,
      "text": "洛阳龙门石窟冰阳中洞刻着两幅大型浮雕，",
      "token_start": 565,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 176940,
      "end_ms": 178965,
      "text": "一副是孝文帝李佛图，",
      "token_start": 583,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 179360,
      "end_ms": 183605,
      "text": "一幅是文昭皇后礼佛图合称帝后里佛土。",
      "token_start": 592,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 184460,
      "end_ms": 188465,
      "text": "这是中国石窟里最精美的北魏时刻。",
      "token_start": 609,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 189040,
      "end_ms": 192565,
      "text": "可上世纪三十年代古董商跟美国人勾结，",
      "token_start": 624,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 193010,
      "end_ms": 196025,
      "text": "把这两幅浮雕从石壁上凿下来，",
      "token_start": 641,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 196440,
      "end_ms": 198015,
      "text": "砸碎偷运出境。",
      "token_start": 654,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 198410,
      "end_ms": 202234,
      "text": "孝文帝李佛图卖给了纽约大都会博物馆。",
      "token_start": 660,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 203040,
      "end_ms": 207255,
      "text": "文昭皇后李佛图卖给了堪萨斯纳尔逊博物馆，",
      "token_start": 677,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 208090,
      "end_ms": 209735,
      "text": "您去龙门石窟看看。",
      "token_start": 696,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 210150,
      "end_ms": 213835,
      "text": "宾阳中洞那面墙上现在只剩两个大窟窿，",
      "token_start": 704,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 214280,
      "end_ms": 215875,
      "text": "石头早走了，",
      "token_start": 721,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 216120,
      "end_ms": 216955,
      "text": "只剩伤痕。",
      "token_start": 726,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 217950,
      "end_ms": 218675,
      "text": "第七名，",
      "token_start": 730,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 219370,
      "end_ms": 219610,
      "text": "唐，",
      "token_start": 733,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 219650,
      "end_ms": 220830,
      "text": "弘应景，",
      "token_start": 734,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 220990,
      "end_ms": 224280,
      "text": "克食这块石头在旅顺。",
      "token_start": 737,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 224320,
      "end_ms": 228840,
      "text": "黄金山上刻着二十九个字是唐朝。",
      "token_start": 746,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 229000,
      "end_ms": 229965,
      "text": "开元年间，",
      "token_start": 760,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 230810,
      "end_ms": 236205,
      "text": "洪兄卿催新奉旨册封东北地方政权回来时，",
      "token_start": 764,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 236640,
      "end_ms": 238360,
      "text": "路过旅顺凿带，",
      "token_start": 782,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 238460,
      "end_ms": 240445,
      "text": "距今一千三百多年。",
      "token_start": 788,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 240930,
      "end_ms": 244075,
      "text": "这是唐朝对东北行使管辖权的铁证。",
      "token_start": 796,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 245010,
      "end_ms": 247575,
      "text": "一九零八年日俄战争以后，",
      "token_start": 811,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 247910,
      "end_ms": 251425,
      "text": "日本海军把这块石头和碑亭移起，",
      "token_start": 822,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 251740,
      "end_ms": 252745,
      "text": "当成战利品，",
      "token_start": 836,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 253000,
      "end_ms": 255245,
      "text": "运回的日本献给了日本皇宫，",
      "token_start": 841,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 255620,
      "end_ms": 257760,
      "text": "藏在皇宫里的建安府蜜，",
      "token_start": 853,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 257760,
      "end_ms": 259565,
      "text": "不是人一百多年了。",
      "token_start": 863,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 260410,
      "end_ms": 262225,
      "text": "中国民间多次追讨，",
      "token_start": 871,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 263090,
      "end_ms": 265965,
      "text": "日本方面至今没有正式答复。",
      "token_start": 879,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 266380,
      "end_ms": 267315,
      "text": "一块石头，",
      "token_start": 891,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 267670,
      "end_ms": 268875,
      "text": "一千三百年，",
      "token_start": 895,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 269740,
      "end_ms": 271945,
      "text": "被锁在别人家的皇宫里。",
      "token_start": 900,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 273280,
      "end_ms": 273885,
      "text": "第六名，",
      "token_start": 910,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 274430,
      "end_ms": 279845,
      "text": "王羲之丧乱帖书圣王羲之的字真迹早就没有了，",
      "token_start": 913,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 280720,
      "end_ms": 282535,
      "text": "传世的都是魔本。",
      "token_start": 933,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 282870,
      "end_ms": 287455,
      "text": "丧乱铁是唐代内府双沟田末模本，",
      "token_start": 940,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 288260,
      "end_ms": 292625,
      "text": "被学者认为是王羲之传世书籍中最好的一幅。",
      "token_start": 954,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 293120,
      "end_ms": 294120,
      "text": "唐朝的时候，",
      "token_start": 973,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 294260,
      "end_ms": 296115,
      "text": "由遣唐使带到了日本，",
      "token_start": 978,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 296560,
      "end_ms": 298115,
      "text": "先藏在东大寺。",
      "token_start": 987,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 298620,
      "end_ms": 301480,
      "text": "后来辗转到了日本皇室手里，",
      "token_start": 993,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 301940,
      "end_ms": 304420,
      "text": "一千多年来一直密藏。",
      "token_start": 1005,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 304480,
      "end_ms": 306040,
      "text": "在日本宫内厅，",
      "token_start": 1014,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 306600,
      "end_ms": 308000,
      "text": "从不对外展出，",
      "token_start": 1020,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 308440,
      "end_ms": 309980,
      "text": "一直到二零零六年，",
      "token_start": 1026,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 310060,
      "end_ms": 312680,
      "text": "他才第一次回到中国展出。",
      "token_start": 1034,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 313120,
      "end_ms": 315300,
      "text": "在上海博物馆待了没几天，",
      "token_start": 1045,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 315540,
      "end_ms": 316380,
      "text": "又回去了，",
      "token_start": 1056,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 316980,
      "end_ms": 319080,
      "text": "一千三百年就回来。",
      "token_start": 1060,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 319080,
      "end_ms": 320020,
      "text": "过这么一次。",
      "token_start": 1068,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 320880,
      "end_ms": 324840,
      "text": "从第十道第六兽首走散了，",
      "token_start": 1073,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 324840,
      "end_ms": 329510,
      "text": "一百六十多年罗汉被拆散到五六个国家。",
      "token_start": 1084,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 330070,
      "end_ms": 332690,
      "text": "帝后李佛图只剩两个窟窿，",
      "token_start": 1101,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 333110,
      "end_ms": 335750,
      "text": "红垦井刻石锁在日本皇宫，",
      "token_start": 1112,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 336230,
      "end_ms": 338610,
      "text": "丧乱铁一千年只回来过一次。",
      "token_start": 1123,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 339470,
      "end_ms": 342690,
      "text": "可这五件还不是最让人心疼的。",
      "token_start": 1135,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 343610,
      "end_ms": 348310,
      "text": "接下来第五道第一一件比一件揪心，",
      "token_start": 1148,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 348910,
      "end_ms": 352550,
      "text": "有一件被大英博物馆切成好几块，",
      "token_start": 1163,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 353290,
      "end_ms": 354530,
      "text": "装在了木板上。",
      "token_start": 1177,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 354850,
      "end_ms": 357230,
      "text": "还有一件整面墙被剥走了，",
      "token_start": 1183,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 357310,
      "end_ms": 358125,
      "text": "它是哪件？",
      "token_start": 1194,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 358380,
      "end_ms": 361255,
      "text": "他凭什么排第一下集马上更新，",
      "token_start": 1198,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 361580,
      "end_ms": 364995,
      "text": "您先点个关注点开头像别走丢。",
      "token_start": 1211,
      "token_end_exclusive": 1224
    }
  ],
