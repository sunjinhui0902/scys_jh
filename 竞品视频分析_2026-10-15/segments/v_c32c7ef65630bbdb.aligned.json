{
  "video_id": "v_c32c7ef65630bbdb",
  "duration_s": 566.057007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c32c7ef65630bbdb.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c32c7ef65630bbdb.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 390,
      "end_ms": 790,
      "text": "朱军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1210,
      "end_ms": 5270,
      "text": "你知道五十块的瓷器和五十万的瓷器差别在哪里吗？",
      "token_start": 2,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5670,
      "end_ms": 8550,
      "text": "你知道一个小镇凭什么能够代表中国吗？",
      "token_start": 24,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 8850,
      "end_ms": 9870,
      "text": "今天挑战一口气，",
      "token_start": 41,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 9870,
      "end_ms": 11670,
      "text": "给你讲清楚世界瓷都。",
      "token_start": 48,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 11910,
      "end_ms": 15090,
      "text": "景德镇就在今天七月二十五号，",
      "token_start": 57,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 15230,
      "end_ms": 19090,
      "text": "景德镇手工瓷业遗存正式列入世界遗产名录。",
      "token_start": 70,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 19610,
      "end_ms": 20470,
      "text": "更有意思的是，",
      "token_start": 89,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 20470,
      "end_ms": 22970,
      "text": "这次审议地点是在韩国釜山。",
      "token_start": 95,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 23550,
      "end_ms": 24950,
      "text": "这些年总有韩国人说，",
      "token_start": 107,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 25130,
      "end_ms": 26210,
      "text": "端午是他们的，",
      "token_start": 116,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 26230,
      "end_ms": 27270,
      "text": "中餐是他们的，",
      "token_start": 122,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 27270,
      "end_ms": 28370,
      "text": "汉服是他们的。",
      "token_start": 128,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 28410,
      "end_ms": 30680,
      "text": "但是瓷器他们抢夺不敢抢。",
      "token_start": 134,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 30920,
      "end_ms": 33420,
      "text": "如今全国只有一个剩遗名额，",
      "token_start": 145,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 33440,
      "end_ms": 35540,
      "text": "凭什么给了景德镇这件事？",
      "token_start": 157,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 35540,
      "end_ms": 37020,
      "text": "分量重到难以想象，",
      "token_start": 168,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 37140,
      "end_ms": 39100,
      "text": "藏了三个破天荒的第一次。",
      "token_start": 176,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 39400,
      "end_ms": 42760,
      "text": "这是第一次中国以产业遗产的名义申报世界遗产，",
      "token_start": 187,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 43000,
      "end_ms": 49820,
      "text": "第一次完整申报一座依旧在运转生生不息的手工业城市第一次填补全球世界遗产。",
      "token_start": 208,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 49820,
      "end_ms": 50280,
      "text": "名录里，",
      "token_start": 243,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 50280,
      "end_ms": 52780,
      "text": "陶瓷文明主题的空白过往，",
      "token_start": 246,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 52780,
      "end_ms": 56700,
      "text": "我们申报的大多是宫殿、山川、古村落这类静态古迹，",
      "token_start": 257,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 57000,
      "end_ms": 58500,
      "text": "但是景德镇截然不同，",
      "token_start": 278,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 58740,
      "end_ms": 60290,
      "text": "它是一个活着的千年年。",
      "token_start": 287,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 60290,
      "end_ms": 63095,
      "text": "瓷都千百年窑火生生不息，",
      "token_start": 297,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 63360,
      "end_ms": 64600,
      "text": "匠人代代延续。",
      "token_start": 308,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 64620,
      "end_ms": 65445,
      "text": "手艺致辞，",
      "token_start": 314,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 65730,
      "end_ms": 67025,
      "text": "烟火延续至今。",
      "token_start": 318,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 67420,
      "end_ms": 68100,
      "text": "一千年前，",
      "token_start": 324,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 68180,
      "end_ms": 70100,
      "text": "景德镇最早叫昌南镇，",
      "token_start": 328,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 70180,
      "end_ms": 72595,
      "text": "据说昌南后来演化为china,",
      "token_start": 337,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 72840,
      "end_ms": 74105,
      "text": "成为中国的代名词。",
      "token_start": 347,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 74450,
      "end_ms": 76285,
      "text": "昌南曾经属于浮梁。",
      "token_start": 355,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 76570,
      "end_ms": 77210,
      "text": "白居易说，",
      "token_start": 363,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 77250,
      "end_ms": 78790,
      "text": "商人重力轻别离，",
      "token_start": 367,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 78810,
      "end_ms": 81340,
      "text": "前月浮梁买茶去奶茶，",
      "token_start": 374,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 81520,
      "end_ms": 83455,
      "text": "喝茶就催生了瓷器产业。",
      "token_start": 383,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 83790,
      "end_ms": 86330,
      "text": "宋真宗更是把自己的年号景德，",
      "token_start": 393,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 86370,
      "end_ms": 87325,
      "text": "赐给这座小镇。",
      "token_start": 406,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 87640,
      "end_ms": 88280,
      "text": "从此以后，",
      "token_start": 412,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 88400,
      "end_ms": 89500,
      "text": "窑火没灭过，",
      "token_start": 416,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 89540,
      "end_ms": 91160,
      "text": "手艺没断过审美，",
      "token_start": 421,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 91160,
      "end_ms": 92095,
      "text": "更没倒退过。",
      "token_start": 428,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 92480,
      "end_ms": 93695,
      "text": "走在景德镇街上，",
      "token_start": 433,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 93980,
      "end_ms": 95100,
      "text": "路灯斑马线，",
      "token_start": 440,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 95300,
      "end_ms": 97425,
      "text": "连电线杆都是陶瓷做的。",
      "token_start": 445,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 97660,
      "end_ms": 100975,
      "text": "景德镇陶瓷大学把瓷盆当做录取通知书，",
      "token_start": 455,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 101250,
      "end_ms": 102685,
      "text": "这需要复印件可以怎么办？",
      "token_start": 472,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 102960,
      "end_ms": 105695,
      "text": "景德镇凭什么能烧出全世界最好的瓷器？",
      "token_start": 483,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 106070,
      "end_ms": 106970,
      "text": "没有金刚钻，",
      "token_start": 500,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 107050,
      "end_ms": 108155,
      "text": "别来瓷器货。",
      "token_start": 505,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 108520,
      "end_ms": 110340,
      "text": "景德镇的瓷器白如玉，",
      "token_start": 510,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 110500,
      "end_ms": 111220,
      "text": "明如镜，",
      "token_start": 519,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 111340,
      "end_ms": 112040,
      "text": "薄如纸，",
      "token_start": 522,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 112260,
      "end_ms": 113175,
      "text": "生如镜，",
      "token_start": 525,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 113680,
      "end_ms": 114280,
      "text": "你敢信吗？",
      "token_start": 528,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 114280,
      "end_ms": 116205,
      "text": "故宫博物院有三十六万件瓷器，",
      "token_start": 532,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 116500,
      "end_ms": 119085,
      "text": "竟然有三十三万件来自景德镇。",
      "token_start": 545,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 119360,
      "end_ms": 121455,
      "text": "你看这是景德镇的无语菩萨，",
      "token_start": 558,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 121700,
      "end_ms": 122780,
      "text": "他确实挺无语的，",
      "token_start": 570,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 122780,
      "end_ms": 123920,
      "text": "毕竟他不是菩萨，",
      "token_start": 577,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 123920,
      "end_ms": 124840,
      "text": "而是沉思。",
      "token_start": 584,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 124840,
      "end_ms": 126730,
      "text": "罗汉菩萨的状态领先。",
      "token_start": 588,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 126730,
      "end_ms": 127885,
      "text": "我们几千年呢，",
      "token_start": 597,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 128370,
      "end_ms": 130405,
      "text": "没有人能够空手离开景德镇。",
      "token_start": 603,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 130760,
      "end_ms": 132600,
      "text": "景德镇最会拿捏现代人的地方，",
      "token_start": 615,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 132600,
      "end_ms": 134555,
      "text": "是他把逛街变成了考古。",
      "token_start": 628,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 134930,
      "end_ms": 137750,
      "text": "你买的不是流水线上复制出来的标准答案，",
      "token_start": 638,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 137830,
      "end_ms": 140690,
      "text": "而是某个年轻人捏歪了一点的杯口，",
      "token_start": 656,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 140870,
      "end_ms": 141870,
      "text": "是某次窑火，",
      "token_start": 671,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 141930,
      "end_ms": 143430,
      "text": "偶然留下了一片留釉，",
      "token_start": 676,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 143690,
      "end_ms": 145390,
      "text": "是画室那天心情很好，",
      "token_start": 685,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 145510,
      "end_ms": 146945,
      "text": "才多添的一只小鸟。",
      "token_start": 694,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 147290,
      "end_ms": 147705,
      "text": "朱今，",
      "token_start": 702,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 147990,
      "end_ms": 150125,
      "text": "你知道景德镇的风水有多好吗？",
      "token_start": 704,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 150460,
      "end_ms": 152565,
      "text": "瓷器的核心材料叫高岭土，",
      "token_start": 717,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 152820,
      "end_ms": 155285,
      "text": "来自于景德镇浮梁县的高岭村。",
      "token_start": 728,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 155810,
      "end_ms": 157170,
      "text": "景德镇周围有山，",
      "token_start": 741,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 157310,
      "end_ms": 157650,
      "text": "山里，",
      "token_start": 748,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 157650,
      "end_ms": 161450,
      "text": "有瓷石和烧窑所需要的木材、山谷和河流，",
      "token_start": 750,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 161650,
      "end_ms": 165615,
      "text": "提供陶洗、陶土驱动、水源和运输原料的条件。",
      "token_start": 767,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 166090,
      "end_ms": 169285,
      "text": "昌江水系又把成品送向鄱阳湖长江，",
      "token_start": 785,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 169530,
      "end_ms": 171155,
      "text": "再送往中国各地和海外。",
      "token_start": 800,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 171590,
      "end_ms": 172930,
      "text": "你看这座城的地理，",
      "token_start": 810,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 173030,
      "end_ms": 176040,
      "text": "简直像位烧瓷定制的一张配方表山，",
      "token_start": 818,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 176160,
      "end_ms": 177500,
      "text": "负责给材料水，",
      "token_start": 833,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 177640,
      "end_ms": 179470,
      "text": "负责给动力和运输火，",
      "token_start": 839,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 179530,
      "end_ms": 185460,
      "text": "负责完成质变人负责把这一切组织成产业、天时地利人和，",
      "token_start": 848,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 185600,
      "end_ms": 188695,
      "text": "共同促成一条完整的古代瓷器超级产业链。",
      "token_start": 872,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 189150,
      "end_ms": 190650,
      "text": "如果以氧化硅为颜料，",
      "token_start": 890,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 190670,
      "end_ms": 191450,
      "text": "在速配上，",
      "token_start": 899,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 191450,
      "end_ms": 192850,
      "text": "绘画图案被透明，",
      "token_start": 903,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 192850,
      "end_ms": 194415,
      "text": "釉罩在下面晶莹剔透，",
      "token_start": 910,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 194640,
      "end_ms": 196685,
      "text": "这就是釉下彩青花瓷。",
      "token_start": 919,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 197000,
      "end_ms": 199265,
      "text": "明朝郑和下西洋带回来一种颜料，",
      "token_start": 928,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 199500,
      "end_ms": 201635,
      "text": "烧出带有黑色斑点的青花瓷，",
      "token_start": 942,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 201900,
      "end_ms": 203605,
      "text": "这种颜料叫酥麻沥青。",
      "token_start": 954,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 203920,
      "end_ms": 205020,
      "text": "如果颜料含有铜，",
      "token_start": 963,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 205260,
      "end_ms": 207105,
      "text": "那就能烧出来红色的釉里红。",
      "token_start": 970,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 207530,
      "end_ms": 209665,
      "text": "如果用青料和红料一起烧制，",
      "token_start": 982,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 209830,
      "end_ms": 211235,
      "text": "就是青花釉里红。",
      "token_start": 994,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 211670,
      "end_ms": 213370,
      "text": "如果以白瓷胎为画布，",
      "token_start": 1001,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 213490,
      "end_ms": 215610,
      "text": "在釉外面用玻璃白作画，",
      "token_start": 1010,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 215730,
      "end_ms": 216930,
      "text": "低温二次烧制，",
      "token_start": 1020,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 217010,
      "end_ms": 219065,
      "text": "这就是釉上彩粉彩瓷。",
      "token_start": 1026,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 219460,
      "end_ms": 223695,
      "text": "如果用红黄金蓝绿诸多矿物颜料平涂在釉上，",
      "token_start": 1035,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 223920,
      "end_ms": 225445,
      "text": "这就是光滑的五彩瓷。",
      "token_start": 1054,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 225790,
      "end_ms": 227950,
      "text": "如果你买到了进口的颜料珐琅，",
      "token_start": 1063,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 228150,
      "end_ms": 230330,
      "text": "这就是表面有凹凸感的珐琅彩。",
      "token_start": 1076,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 230590,
      "end_ms": 233185,
      "text": "您家装猪油用的搪瓷缸就是发廊，",
      "token_start": 1089,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 233720,
      "end_ms": 235460,
      "text": "从珐琅彩发展到粉彩，",
      "token_start": 1103,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 235580,
      "end_ms": 238640,
      "text": "景德镇的手艺人则叫做爬花内务府，",
      "token_start": 1112,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 238660,
      "end_ms": 241065,
      "text": "把这种瓷器工艺称之为锦上添花。",
      "token_start": 1127,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 241520,
      "end_ms": 243460,
      "text": "这些纹样不是画在瓷器上的，",
      "token_start": 1141,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 243460,
      "end_ms": 244545,
      "text": "也不是贴上去的，",
      "token_start": 1153,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 244710,
      "end_ms": 247625,
      "text": "而是直接拿一根针头在磁器上刮线。",
      "token_start": 1160,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 248040,
      "end_ms": 249360,
      "text": "如果不小心刮错一笔，",
      "token_start": 1175,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 249360,
      "end_ms": 250505,
      "text": "就要全部作废。",
      "token_start": 1184,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 251000,
      "end_ms": 253320,
      "text": "如果在右上和右下都作画，",
      "token_start": 1190,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 253320,
      "end_ms": 255705,
      "text": "就是斗彩瓷和青花五彩瓷，",
      "token_start": 1201,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 256070,
      "end_ms": 259105,
      "text": "这是明朝斗彩鸡缸杯拍出了二点八个亿。",
      "token_start": 1212,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 259350,
      "end_ms": 261355,
      "text": "当时刷新瓷器全球拍卖纪录。",
      "token_start": 1229,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 261680,
      "end_ms": 262445,
      "text": "这是什么词？",
      "token_start": 1241,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 262730,
      "end_ms": 264585,
      "text": "这是龙泉青瓷冰裂纹，",
      "token_start": 1246,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 264860,
      "end_ms": 265780,
      "text": "每一声脆响，",
      "token_start": 1255,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 265780,
      "end_ms": 267565,
      "text": "都可能让他身价多一个零，",
      "token_start": 1260,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 267780,
      "end_ms": 270975,
      "text": "变成十万百万千万甚至一个小目标。",
      "token_start": 1271,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 271410,
      "end_ms": 272970,
      "text": "它的花纹遇水则化，",
      "token_start": 1286,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 273170,
      "end_ms": 274145,
      "text": "水干则裂，",
      "token_start": 1294,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 274390,
      "end_ms": 276825,
      "text": "这就是独属于中国人的冰与火之歌。",
      "token_start": 1298,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 277210,
      "end_ms": 277995,
      "text": "这是什么词？",
      "token_start": 1313,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 278330,
      "end_ms": 279970,
      "text": "这是老太太碰死不？",
      "token_start": 1318,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 280090,
      "end_ms": 281565,
      "text": "这是剑盏开窑，",
      "token_start": 1326,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 282080,
      "end_ms": 282860,
      "text": "这是什么瓷？",
      "token_start": 1332,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 282940,
      "end_ms": 284160,
      "text": "这是玲珑瓷，",
      "token_start": 1337,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 284360,
      "end_ms": 285280,
      "text": "浑身是孔，",
      "token_start": 1342,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 285300,
      "end_ms": 286425,
      "text": "却滴水不漏，",
      "token_start": 1346,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 286700,
      "end_ms": 290850,
      "text": "花纹处还会透光鹤光同尘十窑九不成，",
      "token_start": 1351,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 290950,
      "end_ms": 292485,
      "text": "能否烧成全看运气。",
      "token_start": 1367,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 292900,
      "end_ms": 295085,
      "text": "这是什么词就是德化白子，",
      "token_start": 1375,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 295390,
      "end_ms": 296250,
      "text": "远看是杀，",
      "token_start": 1386,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 296290,
      "end_ms": 297105,
      "text": "近看是词。",
      "token_start": 1390,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 297450,
      "end_ms": 299190,
      "text": "采用高刃薄胎瓷衣，",
      "token_start": 1394,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 299250,
      "end_ms": 300390,
      "text": "这何止是瓷器，",
      "token_start": 1402,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 300650,
      "end_ms": 302610,
      "text": "简直是把灵魂都塑造出来了。",
      "token_start": 1408,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 302830,
      "end_ms": 303630,
      "text": "这是什么词？",
      "token_start": 1420,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 303770,
      "end_ms": 305470,
      "text": "这是琉璃荷花盏，",
      "token_start": 1425,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 305770,
      "end_ms": 308830,
      "text": "当年卷帘大将就是不小心打碎了这玩意儿，",
      "token_start": 1432,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 308830,
      "end_ms": 309550,
      "text": "被贬下凡，",
      "token_start": 1450,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 309550,
      "end_ms": 310210,
      "text": "成了沙僧。",
      "token_start": 1454,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 310650,
      "end_ms": 312730,
      "text": "但我一直怀疑为了一个琉璃盏，",
      "token_start": 1458,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 312730,
      "end_ms": 313730,
      "text": "至于这样恨他吗？",
      "token_start": 1471,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 313950,
      "end_ms": 316610,
      "text": "肯定是他做卷帘大将卷帘子的时候，",
      "token_start": 1478,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 316630,
      "end_ms": 317810,
      "text": "看到什么不该看的。",
      "token_start": 1493,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 318030,
      "end_ms": 318830,
      "text": "这是什么词？",
      "token_start": 1501,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 319050,
      "end_ms": 320310,
      "text": "耀变天幕盏，",
      "token_start": 1506,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 320430,
      "end_ms": 321570,
      "text": "宋代第一茶器，",
      "token_start": 1511,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 321710,
      "end_ms": 323550,
      "text": "全世界仅存三只完整。",
      "token_start": 1517,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 323850,
      "end_ms": 324650,
      "text": "这是什么词？",
      "token_start": 1526,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 324750,
      "end_ms": 326995,
      "text": "这是古瓷洁白如玉。",
      "token_start": 1531,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 327420,
      "end_ms": 328160,
      "text": "这是什么词？",
      "token_start": 1539,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 328340,
      "end_ms": 332920,
      "text": "这是景德镇一手作坊匠人做出的像西藏转经筒一样的陶瓷，",
      "token_start": 1544,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 333100,
      "end_ms": 333820,
      "text": "转起来时，",
      "token_start": 1569,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 333940,
      "end_ms": 335740,
      "text": "像穿着流苏裙的仙子，",
      "token_start": 1573,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 336000,
      "end_ms": 338180,
      "text": "这位匠人眼里没有对金钱的渴望，",
      "token_start": 1582,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 338200,
      "end_ms": 339920,
      "text": "全是对自己手艺的欣赏。",
      "token_start": 1596,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 340400,
      "end_ms": 341260,
      "text": "这是什么瓷？",
      "token_start": 1606,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 341400,
      "end_ms": 343980,
      "text": "这是瓷板画快要失传的非遗。",
      "token_start": 1611,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 344240,
      "end_ms": 346440,
      "text": "这是手艺人在瓷器上手写字，",
      "token_start": 1623,
      "token_end_exclusive": 1635
    },
    {
      "start_ms": 346620,
      "end_ms": 348780,
      "text": "第一次对蝇头小楷有了画面感。",
      "token_start": 1635,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 349160,
      "end_ms": 353020,
      "text": "景德镇写字匠五千字的金刚经抄在一个杯子上，",
      "token_start": 1648,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 353200,
      "end_ms": 354580,
      "text": "这是我见过最稳的手。",
      "token_start": 1668,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 354940,
      "end_ms": 356320,
      "text": "每个字不到一毫米，",
      "token_start": 1677,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 356460,
      "end_ms": 358090,
      "text": "这睛就是一齿手，",
      "token_start": 1685,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 358090,
      "end_ms": 359025,
      "text": "就是打印机。",
      "token_start": 1692,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 359410,
      "end_ms": 360970,
      "text": "烧制瓷器的厂叫窑。",
      "token_start": 1697,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 361350,
      "end_ms": 363110,
      "text": "宋代形成的瓷窑体系有，",
      "token_start": 1705,
      "token_end_exclusive": 1715
    },
    {
      "start_ms": 363110,
      "end_ms": 363535,
      "text": "六种，",
      "token_start": 1715,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 363750,
      "end_ms": 370445,
      "text": "北方地区、定窑君窑、词、州窑、耀州窑、南方地区龙泉窑、景德镇的青白瓷窑，",
      "token_start": 1717,
      "token_end_exclusive": 1746
    },
    {
      "start_ms": 370740,
      "end_ms": 372605,
      "text": "后来形成了五大民谣。",
      "token_start": 1746,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 372960,
      "end_ms": 377040,
      "text": "汝官割君定雨过天青，",
      "token_start": 1755,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 377220,
      "end_ms": 386850,
      "text": "汝窑子口铁足官窑、金丝铁、剑歌窑、窑变、万彩、均窑、白釉、荷花、定窑、每一件浴火重生的瓷器，",
      "token_start": 1764,
      "token_end_exclusive": 1800
    },
    {
      "start_ms": 386910,
      "end_ms": 388695,
      "text": "都像极了中国人的气质。",
      "token_start": 1800,
      "token_end_exclusive": 1810
    },
    {
      "start_ms": 389210,
      "end_ms": 390990,
      "text": "你知道景德镇为什么这么火吗？",
      "token_start": 1810,
      "token_end_exclusive": 1823
    },
    {
      "start_ms": 391010,
      "end_ms": 392495,
      "text": "得从一只鸭子说起，",
      "token_start": 1823,
      "token_end_exclusive": 1831
    },
    {
      "start_ms": 392730,
      "end_ms": 395165,
      "text": "重申我在景德镇当网红鸭。",
      "token_start": 1831,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 395830,
      "end_ms": 398665,
      "text": "景德镇御窑厂是明清两朝的皇家瓷厂，",
      "token_start": 1842,
      "token_end_exclusive": 1858
    },
    {
      "start_ms": 398950,
      "end_ms": 401145,
      "text": "每年烧出来的瓷器要精挑细选，",
      "token_start": 1858,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 401390,
      "end_ms": 401910,
      "text": "不合格，",
      "token_start": 1871,
      "token_end_exclusive": 1874
    },
    {
      "start_ms": 401910,
      "end_ms": 404155,
      "text": "就直接砸碎深埋在地下。",
      "token_start": 1874,
      "token_end_exclusive": 1884
    },
    {
      "start_ms": 404540,
      "end_ms": 405400,
      "text": "几百年下来，",
      "token_start": 1884,
      "token_end_exclusive": 1889
    },
    {
      "start_ms": 405520,
      "end_ms": 408485,
      "text": "御窑厂遗址底下埋着两千多万片碎石。",
      "token_start": 1889,
      "token_end_exclusive": 1905
    },
    {
      "start_ms": 408740,
      "end_ms": 410575,
      "text": "这些碎瓷片里有一只小鸭子，",
      "token_start": 1905,
      "token_end_exclusive": 1917
    },
    {
      "start_ms": 410790,
      "end_ms": 412985,
      "text": "竟然被考古学家一片一片拼回来，",
      "token_start": 1917,
      "token_end_exclusive": 1931
    },
    {
      "start_ms": 413170,
      "end_ms": 415115,
      "text": "成了镇馆之宝碎碎压。",
      "token_start": 1931,
      "token_end_exclusive": 1940
    },
    {
      "start_ms": 415520,
      "end_ms": 417480,
      "text": "为什么现在景漂越来越多了？",
      "token_start": 1940,
      "token_end_exclusive": 1952
    },
    {
      "start_ms": 417480,
      "end_ms": 420265,
      "text": "过去十年新增了十三点六万常住人口。",
      "token_start": 1952,
      "token_end_exclusive": 1968
    },
    {
      "start_ms": 420710,
      "end_ms": 425075,
      "text": "陶西川创意市集从五十五个摊位涨到一千两百多个。",
      "token_start": 1968,
      "token_end_exclusive": 1990
    },
    {
      "start_ms": 425310,
      "end_ms": 426695,
      "text": "摊主平均二十八岁，",
      "token_start": 1990,
      "token_end_exclusive": 1998
    },
    {
      "start_ms": 427160,
      "end_ms": 429400,
      "text": "小县城安置不了肉体北上广，",
      "token_start": 1998,
      "token_end_exclusive": 2010
    },
    {
      "start_ms": 429420,
      "end_ms": 431070,
      "text": "安置不了灵魂来。",
      "token_start": 2010,
      "token_end_exclusive": 2017
    },
    {
      "start_ms": 431070,
      "end_ms": 435065,
      "text": "景德镇捏泥儿身心同时落地如晶。",
      "token_start": 2017,
      "token_end_exclusive": 2031
    },
    {
      "start_ms": 435350,
      "end_ms": 438535,
      "text": "你是不是觉得景德镇的瓷器只能用在厨房和餐厅，",
      "token_start": 2031,
      "token_end_exclusive": 2052
    },
    {
      "start_ms": 438910,
      "end_ms": 439875,
      "text": "那就格局小了。",
      "token_start": 2052,
      "token_end_exclusive": 2058
    },
    {
      "start_ms": 440090,
      "end_ms": 443785,
      "text": "你手机里有一种零件叫多层片式陶瓷电容器，",
      "token_start": 2058,
      "token_end_exclusive": 2077
    },
    {
      "start_ms": 444170,
      "end_ms": 447395,
      "text": "每部手机几百颗每辆新能源汽车几千颗，",
      "token_start": 2077,
      "token_end_exclusive": 2094
    },
    {
      "start_ms": 447750,
      "end_ms": 449030,
      "text": "以前只能靠进口，",
      "token_start": 2094,
      "token_end_exclusive": 2101
    },
    {
      "start_ms": 449030,
      "end_ms": 450050,
      "text": "被人卡着脖子。",
      "token_start": 2101,
      "token_end_exclusive": 2107
    },
    {
      "start_ms": 450130,
      "end_ms": 452715,
      "text": "而现在景德镇自己的企业做出来了，",
      "token_start": 2107,
      "token_end_exclusive": 2122
    },
    {
      "start_ms": 453060,
      "end_ms": 454560,
      "text": "你每天在家里面开灯，",
      "token_start": 2122,
      "token_end_exclusive": 2131
    },
    {
      "start_ms": 454620,
      "end_ms": 459075,
      "text": "关灯电流都会路过景德镇生产的真空开关管磁壳。",
      "token_start": 2131,
      "token_end_exclusive": 2152
    },
    {
      "start_ms": 459560,
      "end_ms": 461360,
      "text": "你坐高铁高铁的轴承里，",
      "token_start": 2152,
      "token_end_exclusive": 2162
    },
    {
      "start_ms": 461360,
      "end_ms": 463480,
      "text": "有一种氮化硅陶瓷轴承，",
      "token_start": 2162,
      "token_end_exclusive": 2172
    },
    {
      "start_ms": 463560,
      "end_ms": 464895,
      "text": "也是景德镇生产的。",
      "token_start": 2172,
      "token_end_exclusive": 2180
    },
    {
      "start_ms": 465370,
      "end_ms": 470715,
      "text": "嫦娥三号登陆月球神舟飞船上天、北斗导航组网、天问一号去火星。",
      "token_start": 2180,
      "token_end_exclusive": 2207
    },
    {
      "start_ms": 471050,
      "end_ms": 474325,
      "text": "这些大国重戏里都有景德镇的特种陶瓷，",
      "token_start": 2207,
      "token_end_exclusive": 2224
    },
    {
      "start_ms": 474800,
      "end_ms": 477730,
      "text": "究竟其实不是景德镇需要世界的认可，",
      "token_start": 2224,
      "token_end_exclusive": 2240
    },
    {
      "start_ms": 477810,
      "end_ms": 479775,
      "text": "是世界需要中国瓷器。",
      "token_start": 2240,
      "token_end_exclusive": 2249
    },
    {
      "start_ms": 480140,
      "end_ms": 483265,
      "text": "中国瓷器一直是世界顶流顶级奢侈品。",
      "token_start": 2249,
      "token_end_exclusive": 2265
    },
    {
      "start_ms": 483780,
      "end_ms": 484920,
      "text": "公元一七一七年，",
      "token_start": 2265,
      "token_end_exclusive": 2272
    },
    {
      "start_ms": 485160,
      "end_ms": 489910,
      "text": "神圣罗马帝国奥古斯特二世招来了一整支六百人的龙骑兵团，",
      "token_start": 2272,
      "token_end_exclusive": 2298
    },
    {
      "start_ms": 490070,
      "end_ms": 492505,
      "text": "使欧洲王侯开疆拓土的精锐。",
      "token_start": 2298,
      "token_end_exclusive": 2310
    },
    {
      "start_ms": 492850,
      "end_ms": 493110,
      "text": "然而，",
      "token_start": 2310,
      "token_end_exclusive": 2312
    },
    {
      "start_ms": 493110,
      "end_ms": 493530,
      "text": "这一次，",
      "token_start": 2312,
      "token_end_exclusive": 2315
    },
    {
      "start_ms": 493530,
      "end_ms": 495465,
      "text": "他们的任务却并非奔赴战场。",
      "token_start": 2315,
      "token_end_exclusive": 2327
    },
    {
      "start_ms": 495940,
      "end_ms": 497600,
      "text": "奥古斯特二世大手一挥，",
      "token_start": 2327,
      "token_end_exclusive": 2337
    },
    {
      "start_ms": 497760,
      "end_ms": 499925,
      "text": "直接将他们全部送给了普鲁士国王，",
      "token_start": 2337,
      "token_end_exclusive": 2352
    },
    {
      "start_ms": 500260,
      "end_ms": 503195,
      "text": "只为换取一百五十一件中国瓷器。",
      "token_start": 2352,
      "token_end_exclusive": 2366
    },
    {
      "start_ms": 503960,
      "end_ms": 506100,
      "text": "意大利有一幅名画叫诸神之焰，",
      "token_start": 2366,
      "token_end_exclusive": 2379
    },
    {
      "start_ms": 506180,
      "end_ms": 508040,
      "text": "画的是希腊众神开派对，",
      "token_start": 2379,
      "token_end_exclusive": 2389
    },
    {
      "start_ms": 508160,
      "end_ms": 510155,
      "text": "手里端的也是中国瓷器。",
      "token_start": 2389,
      "token_end_exclusive": 2399
    },
    {
      "start_ms": 510670,
      "end_ms": 513730,
      "text": "英国人为了仿制中国瓷器配方是几百年，",
      "token_start": 2399,
      "token_end_exclusive": 2416
    },
    {
      "start_ms": 513730,
      "end_ms": 514705,
      "text": "愣是没试出来，",
      "token_start": 2416,
      "token_end_exclusive": 2422
    },
    {
      "start_ms": 514950,
      "end_ms": 515735,
      "text": "法国人更狠，",
      "token_start": 2422,
      "token_end_exclusive": 2427
    },
    {
      "start_ms": 516110,
      "end_ms": 517870,
      "text": "直接派传教士当间谍，",
      "token_start": 2427,
      "token_end_exclusive": 2436
    },
    {
      "start_ms": 517890,
      "end_ms": 518870,
      "text": "潜入景德镇，",
      "token_start": 2436,
      "token_end_exclusive": 2441
    },
    {
      "start_ms": 518970,
      "end_ms": 520285,
      "text": "偷学自食技术，",
      "token_start": 2441,
      "token_end_exclusive": 2447
    },
    {
      "start_ms": 520520,
      "end_ms": 523675,
      "text": "拖了半个多世纪才勉强烧出几件像样的。",
      "token_start": 2447,
      "token_end_exclusive": 2464
    },
    {
      "start_ms": 524140,
      "end_ms": 525460,
      "text": "不是我们输出了技术，",
      "token_start": 2464,
      "token_end_exclusive": 2473
    },
    {
      "start_ms": 525520,
      "end_ms": 526795,
      "text": "而是我们输出了审美。",
      "token_start": 2473,
      "token_end_exclusive": 2482
    },
    {
      "start_ms": 527370,
      "end_ms": 527770,
      "text": "今天，",
      "token_start": 2482,
      "token_end_exclusive": 2484
    },
    {
      "start_ms": 527910,
      "end_ms": 531665,
      "text": "当景德镇手工瓷业遗存成为中国第六十一项世界遗产，",
      "token_start": 2484,
      "token_end_exclusive": 2507
    },
    {
      "start_ms": 532090,
      "end_ms": 537105,
      "text": "世界认可的不只是几处遥指和矿山世界认可的是这样一种能力。",
      "token_start": 2507,
      "token_end_exclusive": 2534
    },
    {
      "start_ms": 537480,
      "end_ms": 539295,
      "text": "把山里的石头变成泥，",
      "token_start": 2534,
      "token_end_exclusive": 2543
    },
    {
      "start_ms": 539620,
      "end_ms": 540900,
      "text": "把泥变成气，",
      "token_start": 2543,
      "token_end_exclusive": 2548
    },
    {
      "start_ms": 541100,
      "end_ms": 542540,
      "text": "把气变成商品，",
      "token_start": 2548,
      "token_end_exclusive": 2554
    },
    {
      "start_ms": 542680,
      "end_ms": 544285,
      "text": "把商品变成审美，",
      "token_start": 2554,
      "token_end_exclusive": 2561
    },
    {
      "start_ms": 544490,
      "end_ms": 547195,
      "text": "把审美变成跨越语言的文明交流。",
      "token_start": 2561,
      "token_end_exclusive": 2575
    },
    {
      "start_ms": 547700,
      "end_ms": 549735,
      "text": "所以下次你端起一只景德镇的杯子，",
      "token_start": 2575,
      "token_end_exclusive": 2590
    },
    {
      "start_ms": 549970,
      "end_ms": 551350,
      "text": "您端起的是一座城。",
      "token_start": 2590,
      "token_end_exclusive": 2598
    },
    {
      "start_ms": 551390,
      "end_ms": 552555,
      "text": "一千年的协作，",
      "token_start": 2598,
      "token_end_exclusive": 2604
    },
    {
      "start_ms": 552840,
      "end_ms": 554845,
      "text": "是无数无名工匠手，",
      "token_start": 2604,
      "token_end_exclusive": 2612
    },
    {
      "start_ms": 555160,
      "end_ms": 558855,
      "text": "是山河泥火与人的共同作品。",
      "token_start": 2612,
      "token_end_exclusive": 2624
    },
    {
      "start_ms": 559260,
      "end_ms": 562445,
      "text": "你端起的也是中国送给世界的一张名片，",
      "token_start": 2624,
      "token_end_exclusive": 2641
    },
    {
      "start_ms": 562890,
      "end_ms": 564265,
      "text": "天青色等烟雨，",
      "token_start": 2641,
      "token_end_exclusive": 2647
    },
    {
      "start_ms": 564520,
      "end_ms": 565695,
      "text": "而我在等你。",
      "token_start": 2647,
      "token_end_exclusive": 2652
    }
  ],
