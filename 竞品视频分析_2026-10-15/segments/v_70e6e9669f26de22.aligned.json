{
  "video_id": "v_70e6e9669f26de22",
  "duration_s": 477.856357,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_70e6e9669f26de22.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_70e6e9669f26de22.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 1070,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1690,
      "end_ms": 5010,
      "text": "二零二六年世界杯决赛西班牙赢了之后，",
      "token_start": 4,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5370,
      "end_ms": 6930,
      "text": "有个人没有冲向奖杯，",
      "token_start": 21,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7150,
      "end_ms": 8230,
      "text": "他冲向了看台，",
      "token_start": 30,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8810,
      "end_ms": 11530,
      "text": "他把大力神杯塞进一个女人怀里。",
      "token_start": 36,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 12010,
      "end_ms": 14890,
      "text": "那个女人叫希拉十六岁当妈，",
      "token_start": 50,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 15170,
      "end_ms": 16670,
      "text": "麦当劳站了十年，",
      "token_start": 62,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 17270,
      "end_ms": 17870,
      "text": "那一天，",
      "token_start": 69,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 18150,
      "end_ms": 20030,
      "text": "全世界都在查她的资料，",
      "token_start": 72,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 20350,
      "end_ms": 23610,
      "text": "结果查出来的东西比世界杯决赛还好看。",
      "token_start": 82,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 24210,
      "end_ms": 25710,
      "text": "今天我们不聊足球，",
      "token_start": 99,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 26130,
      "end_ms": 27870,
      "text": "聊聊那个连越位都不懂，",
      "token_start": 107,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 28230,
      "end_ms": 31060,
      "text": "却养出了一个世界冠军的女人。",
      "token_start": 117,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 31660,
      "end_ms": 33280,
      "text": "希拉不是西班牙人，",
      "token_start": 130,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 33860,
      "end_ms": 36600,
      "text": "她出生在赤道几内亚十几岁，",
      "token_start": 138,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 36600,
      "end_ms": 38300,
      "text": "一个人飘到巴塞罗那，",
      "token_start": 150,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 38640,
      "end_ms": 39980,
      "text": "住进了罗卡芬达，",
      "token_start": 159,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 40340,
      "end_ms": 42800,
      "text": "一个连外卖都不愿意送的移民哭。",
      "token_start": 166,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 43400,
      "end_ms": 44060,
      "text": "十六岁，",
      "token_start": 180,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 44340,
      "end_ms": 45480,
      "text": "他生了一个儿子，",
      "token_start": 183,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 46020,
      "end_ms": 48420,
      "text": "孩子他爸是摩洛哥来的油漆工。",
      "token_start": 190,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 48720,
      "end_ms": 49980,
      "text": "熊走了，",
      "token_start": 203,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 50580,
      "end_ms": 51420,
      "text": "希拉没哭，",
      "token_start": 206,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 51900,
      "end_ms": 54700,
      "text": "她只是从此再也没睡过一个整觉。",
      "token_start": 210,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 55360,
      "end_ms": 56800,
      "text": "她去麦当劳上夜班，",
      "token_start": 224,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 57120,
      "end_ms": 59740,
      "text": "晚上十点站到早上六点回家，",
      "token_start": 232,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 59740,
      "end_ms": 60630,
      "text": "给儿儿子做饭，",
      "token_start": 244,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 60770,
      "end_ms": 61665,
      "text": "哄他睡觉，",
      "token_start": 250,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 62010,
      "end_ms": 64245,
      "text": "再去菜市场捡收他的菜叶子。",
      "token_start": 254,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 64740,
      "end_ms": 65740,
      "text": "那是他的青春。",
      "token_start": 266,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 66000,
      "end_ms": 68270,
      "text": "十八岁别的女孩化妆，",
      "token_start": 272,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 68470,
      "end_ms": 69785,
      "text": "她在洗油烟机，",
      "token_start": 281,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 70370,
      "end_ms": 72480,
      "text": "二十岁别的女孩谈恋爱，",
      "token_start": 287,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 72740,
      "end_ms": 74775,
      "text": "她在暑映必买打折面包，",
      "token_start": 297,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 75260,
      "end_ms": 77380,
      "text": "那双被洗涤剂泡得发白的手。",
      "token_start": 307,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 77720,
      "end_ms": 81220,
      "text": "后来抱着一个三个月大的婴儿坐了两小时公交，",
      "token_start": 319,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 81580,
      "end_ms": 85235,
      "text": "穿越整座巴塞罗那去接一个叫梅西的男人。",
      "token_start": 339,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 85810,
      "end_ms": 86885,
      "text": "二零零七年，",
      "token_start": 357,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 87290,
      "end_ms": 88765,
      "text": "巴萨拍慈善日历，",
      "token_start": 362,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 89100,
      "end_ms": 91305,
      "text": "梅西会给几个婴儿洗澡，",
      "token_start": 369,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 91850,
      "end_ms": 93990,
      "text": "希腊在报纸上看到这条消息，",
      "token_start": 379,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 94250,
      "end_ms": 95705,
      "text": "抱起孩子就出发了，",
      "token_start": 391,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 96250,
      "end_ms": 97755,
      "text": "他不知道梅西是谁。",
      "token_start": 399,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 98090,
      "end_ms": 98865,
      "text": "他只知道，",
      "token_start": 407,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 99190,
      "end_ms": 102330,
      "text": "如果这个人能让他的孩子将来过得好一点，",
      "token_start": 411,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 102510,
      "end_ms": 104955,
      "text": "那他就去那张合影。",
      "token_start": 429,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 105370,
      "end_ms": 106935,
      "text": "希拉存了十九年，",
      "token_start": 437,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 107510,
      "end_ms": 111255,
      "text": "他大概也不知道照片里那个帮婴儿洗澡的球星，",
      "token_start": 444,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 111620,
      "end_ms": 114780,
      "text": "十几年后会把十号球衣脱给他怀里。",
      "token_start": 464,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 114780,
      "end_ms": 119410,
      "text": "那个婴儿穿亚马尔六岁那年在街头踢一颗破网球。",
      "token_start": 479,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 119810,
      "end_ms": 121275,
      "text": "希拉看了二十分钟，",
      "token_start": 500,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 121620,
      "end_ms": 124365,
      "text": "做了一个让所有人都觉得疯了的决定。",
      "token_start": 508,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 124870,
      "end_ms": 127165,
      "text": "他把儿子送进了巴萨青训，",
      "token_start": 524,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 127740,
      "end_ms": 128605,
      "text": "邻居笑他，",
      "token_start": 535,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 128940,
      "end_ms": 131040,
      "text": "你连报名表上的字都认不全，",
      "token_start": 539,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 131320,
      "end_ms": 132635,
      "text": "你儿子能踢出来？",
      "token_start": 551,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 133090,
      "end_ms": 134210,
      "text": "希拉说了一句话，",
      "token_start": 558,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 134510,
      "end_ms": 135535,
      "text": "我没读过书，",
      "token_start": 565,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 135940,
      "end_ms": 137435,
      "text": "但我认得我儿子的眼睛，",
      "token_start": 570,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 137730,
      "end_ms": 140145,
      "text": "他看球的时候眼睛里有光。",
      "token_start": 580,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 140610,
      "end_ms": 141510,
      "text": "就这一句话，",
      "token_start": 591,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 141890,
      "end_ms": 144255,
      "text": "他开始了长达七年的摆渡，",
      "token_start": 596,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 144780,
      "end_ms": 146280,
      "text": "拉玛西亚在城内头，",
      "token_start": 607,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 146580,
      "end_ms": 147800,
      "text": "希拉筑城这一头，",
      "token_start": 615,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 148060,
      "end_ms": 150915,
      "text": "每周三趟公交来回四个小时。",
      "token_start": 622,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 151480,
      "end_ms": 154035,
      "text": "他坐在铁丝网外面不玩手机，",
      "token_start": 634,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 154390,
      "end_ms": 157370,
      "text": "不聊天就那么看着清旬教练。",
      "token_start": 646,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 157370,
      "end_ms": 159165,
      "text": "后来回忆所有孩子里，",
      "token_start": 658,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 159440,
      "end_ms": 161055,
      "text": "亚马尔不是最有天赋的，",
      "token_start": 667,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 161380,
      "end_ms": 162340,
      "text": "但他是唯一一个。",
      "token_start": 677,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 162340,
      "end_ms": 163135,
      "text": "每次回头，",
      "token_start": 684,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 163390,
      "end_ms": 164565,
      "text": "妈妈都在场边的，",
      "token_start": 688,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 165090,
      "end_ms": 166970,
      "text": "有一回下暴雨训练，",
      "token_start": 695,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 166970,
      "end_ms": 167870,
      "text": "临时取消。",
      "token_start": 703,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 168150,
      "end_ms": 169325,
      "text": "希腊不知道，",
      "token_start": 707,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 169840,
      "end_ms": 174285,
      "text": "他坐了两个小时公交到了发现训练场空无一人。",
      "token_start": 712,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 174910,
      "end_ms": 177215,
      "text": "他又坐了两个小时公交回去。",
      "token_start": 732,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 177870,
      "end_ms": 180235,
      "text": "这件事亚马尔是后来才知道的，",
      "token_start": 744,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 180630,
      "end_ms": 182715,
      "text": "他妈从来不说自己吃了什么苦，",
      "token_start": 757,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 182990,
      "end_ms": 184975,
      "text": "他只说今天天气不错，",
      "token_start": 770,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 185480,
      "end_ms": 187560,
      "text": "亚马尔十二岁进了拉马西亚，",
      "token_start": 779,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 187960,
      "end_ms": 190115,
      "text": "从此他的世界越来越大。",
      "token_start": 791,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 190440,
      "end_ms": 196390,
      "text": "梅西欧洲杯十号球衣世界杯希腊的世界一直没变过，",
      "token_start": 801,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 196690,
      "end_ms": 203040,
      "text": "还是那个出租屋那双缝鞋的手那趟来回四小时的公交雅马。",
      "token_start": 823,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 203040,
      "end_ms": 205815,
      "text": "尔后来说过两件事一件事，",
      "token_start": 848,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 206110,
      "end_ms": 207405,
      "text": "有一年圣诞节，",
      "token_start": 859,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 207770,
      "end_ms": 209725,
      "text": "希拉给他买了一台游戏机，",
      "token_start": 865,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 210210,
      "end_ms": 216505,
      "text": "他长大了才知道那台游戏机是他占了多少个夜班才换来的另一件事。",
      "token_start": 876,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 216780,
      "end_ms": 218205,
      "text": "有一天半夜他醒来，",
      "token_start": 905,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 218530,
      "end_ms": 221755,
      "text": "看见他妈在灯下缝他的球鞋鞋底开胶了，",
      "token_start": 913,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 222080,
      "end_ms": 224545,
      "text": "他用于线缝封了整整一夜。",
      "token_start": 930,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 225080,
      "end_ms": 225700,
      "text": "第二天，",
      "token_start": 941,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 225860,
      "end_ms": 227460,
      "text": "他穿着那双鞋去训练，",
      "token_start": 944,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 227760,
      "end_ms": 229025,
      "text": "踢进了三个球。",
      "token_start": 953,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 229570,
      "end_ms": 230230,
      "text": "亚马尔说，",
      "token_start": 959,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 230450,
      "end_ms": 232045,
      "text": "我现在身价两亿欧元，",
      "token_start": 963,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 232350,
      "end_ms": 233350,
      "text": "但我什么都给不了。",
      "token_start": 972,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 233350,
      "end_ms": 233765,
      "text": "我妈，",
      "token_start": 980,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 234060,
      "end_ms": 236355,
      "text": "因为他给我的东西钱买不到。",
      "token_start": 982,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 236840,
      "end_ms": 240475,
      "text": "二零二四年亚马尔十七岁拿了欧洲杯，",
      "token_start": 994,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 241020,
      "end_ms": 244525,
      "text": "二零二五年十八岁接过巴萨十号，",
      "token_start": 1010,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 245060,
      "end_ms": 246720,
      "text": "全世界都在喊天才，",
      "token_start": 1024,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 247000,
      "end_ms": 250755,
      "text": "只有亚马尔知道天才不是从天上掉下来的。",
      "token_start": 1032,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 251120,
      "end_ms": 254560,
      "text": "天才是从罗卡丰达的公交车上坐了七年，",
      "token_start": 1050,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 254600,
      "end_ms": 256520,
      "text": "来来回回才到的诺坎普。",
      "token_start": 1067,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 257120,
      "end_ms": 259685,
      "text": "记者问他压力大不大？",
      "token_start": 1077,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 260270,
      "end_ms": 261215,
      "text": "他说了一段话，",
      "token_start": 1086,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 261620,
      "end_ms": 262640,
      "text": "我妈十六岁生，",
      "token_start": 1092,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 262640,
      "end_ms": 263995,
      "text": "我那才是压力。",
      "token_start": 1098,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 264360,
      "end_ms": 266580,
      "text": "他一个人在麦当劳站了十年，",
      "token_start": 1104,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 266740,
      "end_ms": 267695,
      "text": "那才是压力。",
      "token_start": 1116,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 268170,
      "end_ms": 270695,
      "text": "我要做的只是踢好足球。",
      "token_start": 1121,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 271190,
      "end_ms": 274565,
      "text": "二零二六年世界杯决赛终场哨响，",
      "token_start": 1131,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 275180,
      "end_ms": 276385,
      "text": "西班牙赢了。",
      "token_start": 1145,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 276990,
      "end_ms": 278630,
      "text": "亚马尔穿过整座球场，",
      "token_start": 1150,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 278890,
      "end_ms": 279870,
      "text": "翻过广告牌，",
      "token_start": 1159,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 280110,
      "end_ms": 280890,
      "text": "冲上看台，",
      "token_start": 1164,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 281150,
      "end_ms": 282335,
      "text": "一把抱住希拉，",
      "token_start": 1168,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 282620,
      "end_ms": 284755,
      "text": "把大力神杯塞进他怀里。",
      "token_start": 1174,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 285270,
      "end_ms": 287870,
      "text": "然后他转身从人群中抱起，",
      "token_start": 1184,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 287870,
      "end_ms": 290230,
      "text": "一个三岁的小男孩叫凯恩。",
      "token_start": 1195,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 290530,
      "end_ms": 291125,
      "text": "他弟弟。",
      "token_start": 1206,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 291730,
      "end_ms": 294070,
      "text": "他把金牌从自己脖子上摘下来，",
      "token_start": 1209,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 294310,
      "end_ms": 295690,
      "text": "挂在他弟弟脖子上，",
      "token_start": 1222,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 295970,
      "end_ms": 298390,
      "text": "让那只小手去摸大地神杯。",
      "token_start": 1230,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 298990,
      "end_ms": 300590,
      "text": "全世界都在拍亚马尔，",
      "token_start": 1241,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 300950,
      "end_ms": 301970,
      "text": "亚马尔的镜头，",
      "token_start": 1250,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 302010,
      "end_ms": 303050,
      "text": "只对着两个人，",
      "token_start": 1256,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 303230,
      "end_ms": 305870,
      "text": "他妈妈和他弟弟他说过一段话，",
      "token_start": 1262,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 306230,
      "end_ms": 307950,
      "text": "我弟弟每天早晨醒来，",
      "token_start": 1275,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 308090,
      "end_ms": 308970,
      "text": "有热牛奶，",
      "token_start": 1284,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 308970,
      "end_ms": 310290,
      "text": "喝有玩具玩，",
      "token_start": 1288,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 310470,
      "end_ms": 311910,
      "text": "有哥哥陪他踢球。",
      "token_start": 1293,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 312470,
      "end_ms": 313810,
      "text": "这听起来很普通，",
      "token_start": 1300,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 314410,
      "end_ms": 318970,
      "text": "但这对我来说是我这辈子拼了命也要守护的画面。",
      "token_start": 1307,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 319550,
      "end_ms": 322940,
      "text": "因为那是我小时候从从来没有过的早晨。",
      "token_start": 1328,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 323660,
      "end_ms": 325100,
      "text": "希拉三十五岁，",
      "token_start": 1345,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 325700,
      "end_ms": 326720,
      "text": "他十六岁生，",
      "token_start": 1351,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 327080,
      "end_ms": 329720,
      "text": "十七岁抱着孩子坐公交去见维西。",
      "token_start": 1356,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 330080,
      "end_ms": 330900,
      "text": "三十五岁，",
      "token_start": 1370,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 330900,
      "end_ms": 332460,
      "text": "站在世界杯领奖台上，",
      "token_start": 1374,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 332760,
      "end_ms": 333900,
      "text": "大儿子十九岁，",
      "token_start": 1383,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 334120,
      "end_ms": 335100,
      "text": "小儿子三岁，",
      "token_start": 1389,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 335640,
      "end_ms": 339220,
      "text": "大儿子把所有的荣誉都变成了弟弟手里的玩具。",
      "token_start": 1394,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 339760,
      "end_ms": 340900,
      "text": "有人问亚马尔，",
      "token_start": 1414,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 341060,
      "end_ms": 342940,
      "text": "你职业生涯谁最重要？",
      "token_start": 1420,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 343480,
      "end_ms": 344360,
      "text": "他说我妈，",
      "token_start": 1429,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 344960,
      "end_ms": 349580,
      "text": "然后他说小时候我每天最怕的是天亮天亮了，",
      "token_start": 1433,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 349940,
      "end_ms": 351375,
      "text": "我妈就要去麦当劳了，",
      "token_start": 1452,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 351750,
      "end_ms": 353095,
      "text": "家里就剩我一个人。",
      "token_start": 1461,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 353690,
      "end_ms": 355295,
      "text": "现在我最怕的是天亮，",
      "token_start": 1469,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 355600,
      "end_ms": 356215,
      "text": "天亮了，",
      "token_start": 1478,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 356640,
      "end_ms": 358895,
      "text": "我弟就有新的一天可以去玩了，",
      "token_start": 1481,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 359450,
      "end_ms": 360395,
      "text": "我不怕黑了，",
      "token_start": 1494,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 360750,
      "end_ms": 362565,
      "text": "因为我把光都留给他了。",
      "token_start": 1499,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 363110,
      "end_ms": 364910,
      "text": "希拉那天站在领奖台上，",
      "token_start": 1509,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 365210,
      "end_ms": 366750,
      "text": "手里握着大力神杯，",
      "token_start": 1519,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 367110,
      "end_ms": 369395,
      "text": "身边站着他三岁的小儿子，",
      "token_start": 1527,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 369930,
      "end_ms": 370725,
      "text": "他没有哭，",
      "token_start": 1538,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 371110,
      "end_ms": 372645,
      "text": "他笑得不知所措。",
      "token_start": 1542,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 373280,
      "end_ms": 375320,
      "text": "那个画面被摄影师拍了下来，",
      "token_start": 1549,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 375560,
      "end_ms": 377125,
      "text": "后来在网上传疯了。",
      "token_start": 1561,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 377680,
      "end_ms": 379195,
      "text": "照片里只有一个女人，",
      "token_start": 1569,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 379530,
      "end_ms": 381185,
      "text": "手里握着一座奖杯，",
      "token_start": 1578,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 381520,
      "end_ms": 382855,
      "text": "身边站着一个孩子，",
      "token_start": 1586,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 383180,
      "end_ms": 384440,
      "text": "阳光打在他脸上，",
      "token_start": 1594,
      "token_end_exclusive": 1601
    },
    {
      "start_ms": 384600,
      "end_ms": 387275,
      "text": "三十五岁的脸笑得像个小女孩。",
      "token_start": 1601,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 387770,
      "end_ms": 391555,
      "text": "那张照片底下有一行字是亚马尔后来写上去的。",
      "token_start": 1614,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 392130,
      "end_ms": 392510,
      "text": "他说，",
      "token_start": 1634,
      "token_end_exclusive": 1636
    },
    {
      "start_ms": 392910,
      "end_ms": 395470,
      "text": "这双手在麦当劳后锄断了十年，",
      "token_start": 1636,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 395470,
      "end_ms": 397745,
      "text": "盘子被洗涤剂泡白了，",
      "token_start": 1649,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 397940,
      "end_ms": 399285,
      "text": "被油烟熏皱了，",
      "token_start": 1658,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 399540,
      "end_ms": 400795,
      "text": "被生活磨粗了。",
      "token_start": 1664,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 401310,
      "end_ms": 403530,
      "text": "但就是这双手抱我，",
      "token_start": 1670,
      "token_end_exclusive": 1678
    },
    {
      "start_ms": 403530,
      "end_ms": 405875,
      "text": "坐了两个小时公交去见梅西。",
      "token_start": 1678,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 406480,
      "end_ms": 410265,
      "text": "就是这双手用鱼线给我缝了一整夜的球鞋。",
      "token_start": 1690,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 410830,
      "end_ms": 413615,
      "text": "就是这双手在无数个凌晨做晚饭，",
      "token_start": 1708,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 413880,
      "end_ms": 414595,
      "text": "看着我吃完，",
      "token_start": 1722,
      "token_end_exclusive": 1727
    },
    {
      "start_ms": 414860,
      "end_ms": 416185,
      "text": "然后自己去上夜班。",
      "token_start": 1727,
      "token_end_exclusive": 1735
    },
    {
      "start_ms": 416790,
      "end_ms": 417590,
      "text": "十九年后，",
      "token_start": 1735,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 417910,
      "end_ms": 420405,
      "text": "这双手握住了一座大力神碑。",
      "token_start": 1739,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 420920,
      "end_ms": 422725,
      "text": "我觉得大力神杯很轻，",
      "token_start": 1751,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 423130,
      "end_ms": 426125,
      "text": "因为他沃国的生活比他重一万倍。",
      "token_start": 1760,
      "token_end_exclusive": 1774
    },
    {
      "start_ms": 426730,
      "end_ms": 428330,
      "text": "希腊至今不懂越位，",
      "token_start": 1774,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 428530,
      "end_ms": 429505,
      "text": "不懂战术，",
      "token_start": 1782,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 429790,
      "end_ms": 431165,
      "text": "不懂什么清训体系，",
      "token_start": 1786,
      "token_end_exclusive": 1794
    },
    {
      "start_ms": 431670,
      "end_ms": 432905,
      "text": "他只知道一件事，",
      "token_start": 1794,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 433240,
      "end_ms": 434480,
      "text": "他儿子喜欢踢球，",
      "token_start": 1801,
      "token_end_exclusive": 1808
    },
    {
      "start_ms": 434700,
      "end_ms": 435785,
      "text": "他就送他去了，",
      "token_start": 1808,
      "token_end_exclusive": 1814
    },
    {
      "start_ms": 436340,
      "end_ms": 437365,
      "text": "仅此而已。",
      "token_start": 1814,
      "token_end_exclusive": 1818
    },
    {
      "start_ms": 437970,
      "end_ms": 441675,
      "text": "但就是这个连足球规则都搞不清楚的女人，",
      "token_start": 1818,
      "token_end_exclusive": 1836
    },
    {
      "start_ms": 441940,
      "end_ms": 443835,
      "text": "成了世界冠军的榜样，",
      "token_start": 1836,
      "token_end_exclusive": 1845
    },
    {
      "start_ms": 444380,
      "end_ms": 445775,
      "text": "亚马尔的榜样。",
      "token_start": 1845,
      "token_end_exclusive": 1851
    },
    {
      "start_ms": 446270,
      "end_ms": 447290,
      "text": "十六岁当妈，",
      "token_start": 1851,
      "token_end_exclusive": 1856
    },
    {
      "start_ms": 447670,
      "end_ms": 448530,
      "text": "三十五岁，",
      "token_start": 1856,
      "token_end_exclusive": 1860
    },
    {
      "start_ms": 448610,
      "end_ms": 450035,
      "text": "站在世界之巅。",
      "token_start": 1860,
      "token_end_exclusive": 1866
    },
    {
      "start_ms": 450580,
      "end_ms": 452035,
      "text": "这双手端过盘子，",
      "token_start": 1866,
      "token_end_exclusive": 1873
    },
    {
      "start_ms": 452300,
      "end_ms": 453555,
      "text": "也捧过奖杯。",
      "token_start": 1873,
      "token_end_exclusive": 1878
    },
    {
      "start_ms": 454100,
      "end_ms": 455880,
      "text": "这个女人没踢过一脚球，",
      "token_start": 1878,
      "token_end_exclusive": 1888
    },
    {
      "start_ms": 456180,
      "end_ms": 457120,
      "text": "但她生了冠军，",
      "token_start": 1888,
      "token_end_exclusive": 1894
    },
    {
      "start_ms": 457320,
      "end_ms": 458140,
      "text": "养了冠军，",
      "token_start": 1894,
      "token_end_exclusive": 1898
    },
    {
      "start_ms": 458400,
      "end_ms": 459915,
      "text": "最后活成了冠军。",
      "token_start": 1898,
      "token_end_exclusive": 1905
    },
    {
      "start_ms": 460570,
      "end_ms": 461470,
      "text": "如果有一天，",
      "token_start": 1905,
      "token_end_exclusive": 1910
    },
    {
      "start_ms": 461570,
      "end_ms": 464405,
      "text": "你在凌晨的麦当劳看见一个收银员，",
      "token_start": 1910,
      "token_end_exclusive": 1925
    },
    {
      "start_ms": 464710,
      "end_ms": 466330,
      "text": "他手上有洗洁精的味道，",
      "token_start": 1925,
      "token_end_exclusive": 1935
    },
    {
      "start_ms": 466490,
      "end_ms": 467625,
      "text": "他眼里有困意。",
      "token_start": 1935,
      "token_end_exclusive": 1941
    },
    {
      "start_ms": 467880,
      "end_ms": 468805,
      "text": "他动作很快，",
      "token_start": 1941,
      "token_end_exclusive": 1946
    },
    {
      "start_ms": 469190,
      "end_ms": 470935,
      "text": "因为他急着回家看孩子，",
      "token_start": 1946,
      "token_end_exclusive": 1956
    },
    {
      "start_ms": 471470,
      "end_ms": 472830,
      "text": "请你对他笑一下。",
      "token_start": 1956,
      "token_end_exclusive": 1963
