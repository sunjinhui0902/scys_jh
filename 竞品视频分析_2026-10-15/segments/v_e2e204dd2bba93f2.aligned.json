{
  "video_id": "v_e2e204dd2bba93f2",
  "duration_s": 525.932993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_e2e204dd2bba93f2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_e2e204dd2bba93f2.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 650,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 650,
      "end_ms": 3150,
      "text": "咱们从第十名讲到了第六名，",
      "token_start": 2,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 3550,
      "end_ms": 8550,
      "text": "北京香山靠的是京城老底子黄根红的像火焰。",
      "token_start": 14,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 9170,
      "end_ms": 11850,
      "text": "张家界的奇风泡在云海里，",
      "token_start": 33,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12370,
      "end_ms": 14430,
      "text": "石柱忽隐忽现，",
      "token_start": 44,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 15010,
      "end_ms": 17710,
      "text": "庐山用雾和红叶搭出诗意。",
      "token_start": 50,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 18490,
      "end_ms": 21430,
      "text": "庐山把云海和彩云攒在一块儿，",
      "token_start": 61,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 21930,
      "end_ms": 23970,
      "text": "栖霞山拿古寺配红墙，",
      "token_start": 74,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 24690,
      "end_ms": 27810,
      "text": "金陵秋色全浓缩在那条山沟里。",
      "token_start": 83,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 28590,
      "end_ms": 30000,
      "text": "石处都是明白，",
      "token_start": 96,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 30060,
      "end_ms": 33820,
      "text": "名山大川、古寺、老城名气大，",
      "token_start": 102,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 34000,
      "end_ms": 34660,
      "text": "底子厚，",
      "token_start": 113,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 35080,
      "end_ms": 38420,
      "text": "可他们还不是最值得专程跑一趟的。",
      "token_start": 116,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 38960,
      "end_ms": 41660,
      "text": "接下来第五道第一名更厉害。",
      "token_start": 131,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 41800,
      "end_ms": 42740,
      "text": "有一座古村，",
      "token_start": 143,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 43040,
      "end_ms": 46860,
      "text": "把梯田、银杏和红枫画成了油画。",
      "token_start": 148,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 47480,
      "end_ms": 48960,
      "text": "有一片滩涂，",
      "token_start": 161,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 48960,
      "end_ms": 51120,
      "text": "在秋天变成光影海洋。",
      "token_start": 166,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 51580,
      "end_ms": 52660,
      "text": "有一条秦岭，",
      "token_start": 175,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 52680,
      "end_ms": 54580,
      "text": "山沟铺出百里彩林。",
      "token_start": 180,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 55040,
      "end_ms": 60795,
      "text": "有一片红叶染红长江两岸可排在榜首的那一处。",
      "token_start": 188,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 61550,
      "end_ms": 64945,
      "text": "整座火山天池泡在金黄色的林海里，",
      "token_start": 208,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 65820,
      "end_ms": 66585,
      "text": "他是哪里？",
      "token_start": 223,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 66850,
      "end_ms": 70235,
      "text": "他凭什么排在九寨沟前面茶给您续上了，",
      "token_start": 227,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 70400,
      "end_ms": 71275,
      "text": "点个关注，",
      "token_start": 244,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 71890,
      "end_ms": 72995,
      "text": "咱们接着往下讲。",
      "token_start": 248,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 73360,
      "end_ms": 73935,
      "text": "第五名，",
      "token_start": 255,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 75170,
      "end_ms": 80700,
      "text": "浙江临安指南村、杭州临安太湖园镇指南村。",
      "token_start": 258,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 80760,
      "end_ms": 83420,
      "text": "挂在海拔六百多米的山腰上，",
      "token_start": 276,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 83480,
      "end_ms": 86305,
      "text": "是华东地区最美古村落之一，",
      "token_start": 288,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 87120,
      "end_ms": 89505,
      "text": "村里有古树一百二十二株，",
      "token_start": 300,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 90290,
      "end_ms": 96270,
      "text": "主要是封箱银杏麻月深秋一道村口那口天池，",
      "token_start": 311,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 96270,
      "end_ms": 100465,
      "text": "把五彩秋色和粉墙古宅一起倒扣进水里，",
      "token_start": 330,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 100910,
      "end_ms": 102845,
      "text": "随手一按就是一张画。",
      "token_start": 347,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 103780,
      "end_ms": 107055,
      "text": "村子真正的底色是那几百亩梯田。",
      "token_start": 356,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 107980,
      "end_ms": 109680,
      "text": "十月下旬开始倒浪，",
      "token_start": 370,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 109860,
      "end_ms": 111065,
      "text": "一层层翻巾，",
      "token_start": 378,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 111940,
      "end_ms": 114025,
      "text": "银杏和蜂箱接着变色，",
      "token_start": 383,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 114780,
      "end_ms": 116385,
      "text": "黄红绿搅在一起，",
      "token_start": 392,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 116800,
      "end_ms": 119325,
      "text": "古朴民居点缀其间。",
      "token_start": 399,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 120010,
      "end_ms": 122350,
      "text": "村里有手工豆腐坊，",
      "token_start": 407,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 122830,
      "end_ms": 127150,
      "text": "能看着豆浆在点卤的瞬间变成豆腐，",
      "token_start": 415,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 127230,
      "end_ms": 129410,
      "text": "还有红叶咖啡端一杯，",
      "token_start": 430,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 129490,
      "end_ms": 130610,
      "text": "坐在田埂边，",
      "token_start": 439,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 131030,
      "end_ms": 133010,
      "text": "把整片金色喝下去。",
      "token_start": 444,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 133910,
      "end_ms": 137790,
      "text": "最佳赏期是十月下旬到十一月，",
      "token_start": 452,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 138570,
      "end_ms": 140970,
      "text": "一个藏在山腰里的老村子，",
      "token_start": 465,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 141510,
      "end_ms": 145750,
      "text": "把梯田、银杏、红枫和豆腐香攒在了一起。",
      "token_start": 476,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 146210,
      "end_ms": 148530,
      "text": "您说这是不是把日子过成了话？",
      "token_start": 492,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 149130,
      "end_ms": 150000,
      "text": "第四名明，",
      "token_start": 505,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 150220,
      "end_ms": 155480,
      "text": "福建霞浦、闽东海岸霞浦的秋天跟山里不一样，",
      "token_start": 509,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 155940,
      "end_ms": 157400,
      "text": "它是海上的秋天。",
      "token_start": 528,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 157879,
      "end_ms": 158760,
      "text": "每年秋天，",
      "token_start": 535,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 158760,
      "end_ms": 161640,
      "text": "北齐滩涂进入紫菜采收旺季，",
      "token_start": 539,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 162080,
      "end_ms": 164520,
      "text": "渔民在滩涂上擦干挂网，",
      "token_start": 551,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 164600,
      "end_ms": 165300,
      "text": "收紫菜，",
      "token_start": 561,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 165480,
      "end_ms": 168160,
      "text": "一根根竹竿在潮水褪去后露出来，",
      "token_start": 564,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 168220,
      "end_ms": 169600,
      "text": "排列成各种线条。",
      "token_start": 578,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 170560,
      "end_ms": 172100,
      "text": "清晨五点到七点，",
      "token_start": 585,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 173020,
      "end_ms": 174020,
      "text": "晨雾还没散，",
      "token_start": 592,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 174300,
      "end_ms": 176540,
      "text": "光线从海面上斜着照过来。",
      "token_start": 597,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 176900,
      "end_ms": 179600,
      "text": "滩涂上的水洼反着光渔民，",
      "token_start": 608,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 179750,
      "end_ms": 181075,
      "text": "您的影子拉的老长。",
      "token_start": 619,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 181590,
      "end_ms": 182895,
      "text": "傍晚四点到六点，",
      "token_start": 627,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 183360,
      "end_ms": 187095,
      "text": "落日柔光把整片滩涂染成金色，",
      "token_start": 634,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 187660,
      "end_ms": 188765,
      "text": "一片贪涂，",
      "token_start": 647,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 189140,
      "end_ms": 190925,
      "text": "汇聚万千光影，",
      "token_start": 651,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 191670,
      "end_ms": 194135,
      "text": "被摄影圈叫做朝圣之地。",
      "token_start": 657,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 194860,
      "end_ms": 198965,
      "text": "您要是站在岸边的高处往下看海的纹理，",
      "token_start": 667,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 199220,
      "end_ms": 200100,
      "text": "光的线条，",
      "token_start": 684,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 200520,
      "end_ms": 202940,
      "text": "人的影子全搅在一块儿，",
      "token_start": 688,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 202940,
      "end_ms": 205615,
      "text": "一片泥滩能变成一幅画。",
      "token_start": 698,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 206400,
      "end_ms": 209545,
      "text": "您说这是不是把苦日子过出了名堂？",
      "token_start": 708,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 210340,
      "end_ms": 210755,
      "text": "对了，",
      "token_start": 723,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 211690,
      "end_ms": 217025,
      "text": "我前阵子翻到一本叫三百六十五日走遍中国的日历书，",
      "token_start": 725,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 217600,
      "end_ms": 221105,
      "text": "左边一页是每个地方的实景大图，",
      "token_start": 748,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 221570,
      "end_ms": 223845,
      "text": "加一段五十来个字的知识，",
      "token_start": 762,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 224380,
      "end_ms": 226015,
      "text": "右边是日期计时夜，",
      "token_start": 773,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 226580,
      "end_ms": 228245,
      "text": "什么季节去哪座山，",
      "token_start": 781,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 228610,
      "end_ms": 228990,
      "text": "哪个月，",
      "token_start": 789,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 228990,
      "end_ms": 231060,
      "text": "看哪片林走哪条路，",
      "token_start": 792,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 231060,
      "end_ms": 232575,
      "text": "看什么风景最合适，",
      "token_start": 800,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 232840,
      "end_ms": 233985,
      "text": "都给你安排好了。",
      "token_start": 808,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 234910,
      "end_ms": 237435,
      "text": "不是那种千篇一律的景点介绍，",
      "token_start": 815,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 237780,
      "end_ms": 239045,
      "text": "是帮你挑日子。",
      "token_start": 828,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 239240,
      "end_ms": 240845,
      "text": "今天翻到巫山红叶，",
      "token_start": 834,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 241190,
      "end_ms": 242950,
      "text": "明天翻到二山临海，",
      "token_start": 842,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 243170,
      "end_ms": 245094,
      "text": "后天翻到霞浦滩图，",
      "token_start": 850,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 245680,
      "end_ms": 246520,
      "text": "翻到哪页，",
      "token_start": 858,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 246600,
      "end_ms": 253385,
      "text": "就觉得那个地方在喊你我自己的习惯是每天早起翻一页当个消遣，",
      "token_start": 862,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 253850,
      "end_ms": 257015,
      "text": "翻到一个从来没听说过的小地方，",
      "token_start": 890,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 257370,
      "end_ms": 259055,
      "text": "就去网上搜搜照片，",
      "token_start": 904,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 259560,
      "end_ms": 260995,
      "text": "搜完就想订票。",
      "token_start": 912,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 261360,
      "end_ms": 262625,
      "text": "我已经放下面了，",
      "token_start": 918,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 262950,
      "end_ms": 264195,
      "text": "点开就能看到。",
      "token_start": 925,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 264550,
      "end_ms": 266225,
      "text": "喜欢到处走走的朋友，",
      "token_start": 931,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 266490,
      "end_ms": 267610,
      "text": "弄一本放茶几。",
      "token_start": 940,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 267610,
      "end_ms": 269585,
      "text": "上一年下来，",
      "token_start": 946,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 270060,
      "end_ms": 271800,
      "text": "整个中国哪儿值得去，",
      "token_start": 951,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 271800,
      "end_ms": 272615,
      "text": "哪个乐器，",
      "token_start": 960,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 273010,
      "end_ms": 274235,
      "text": "心里全有谱了。",
      "token_start": 964,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 274380,
      "end_ms": 275005,
      "text": "第三名，",
      "token_start": 970,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 275460,
      "end_ms": 284010,
      "text": "陕西秦岭黄伯铎、宝鸡太白县、黄伯陀藏在秦岭深处，",
      "token_start": 973,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 284210,
      "end_ms": 292235,
      "text": "被叫做秦岭小九寨秦岭香格里拉、大涧沟一带的彩林贴着溪水生长。",
      "token_start": 994,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 292670,
      "end_ms": 295230,
      "text": "十月中下旬迎来颜值巅峰，",
      "token_start": 1022,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 295790,
      "end_ms": 302650,
      "text": "太阳公路沿线全线换装秋日色彩红叶变色率从十月上旬的百分之十，",
      "token_start": 1033,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 303190,
      "end_ms": 306290,
      "text": "一路涨到十月下旬的百分之九十五，",
      "token_start": 1062,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 306770,
      "end_ms": 307310,
      "text": "沟里，",
      "token_start": 1077,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 307350,
      "end_ms": 310850,
      "text": "铺着平缓栈道和观景台，",
      "token_start": 1079,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 311470,
      "end_ms": 319050,
      "text": "徒步轻松自驾进沟山路蜿蜒镇上住宿有限旺季的提前定，",
      "token_start": 1089,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 319610,
      "end_ms": 322800,
      "text": "您沿着溪水边的栈道慢慢走走。",
      "token_start": 1113,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 323180,
      "end_ms": 324280,
      "text": "水是青的，",
      "token_start": 1126,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 324460,
      "end_ms": 325660,
      "text": "叶子是红的，",
      "token_start": 1130,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 325760,
      "end_ms": 326320,
      "text": "黄的，",
      "token_start": 1135,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 326680,
      "end_ms": 329080,
      "text": "倒影在水面上晃来晃去，",
      "token_start": 1137,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 329520,
      "end_ms": 332780,
      "text": "一条山沟把彩铃和溪水搭在一起。",
      "token_start": 1147,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 333300,
      "end_ms": 336680,
      "text": "您说这是不是秦岭秋天压箱底的绝活？",
      "token_start": 1161,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 337860,
      "end_ms": 338520,
      "text": "第二名，",
      "token_start": 1177,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 339040,
      "end_ms": 347140,
      "text": "重庆巫山、长江三峡巫山拥有一百二十万亩红叶品种多达两百余个，",
      "token_start": 1180,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 347540,
      "end_ms": 351040,
      "text": "是亚洲规模最大的红叶观赏圣地。",
      "token_start": 1208,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 351700,
      "end_ms": 354165,
      "text": "每年十一、一月到次年一月，",
      "token_start": 1222,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 354550,
      "end_ms": 356575,
      "text": "红叶剑刺染红，",
      "token_start": 1233,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 357020,
      "end_ms": 358240,
      "text": "绵延长江，",
      "token_start": 1239,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 358300,
      "end_ms": 360695,
      "text": "两岸观赏期长达三个月。",
      "token_start": 1243,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 361230,
      "end_ms": 362770,
      "text": "高峡平湖蓄水之后，",
      "token_start": 1253,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 362990,
      "end_ms": 364555,
      "text": "长江水面变宽了，",
      "token_start": 1261,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 365150,
      "end_ms": 367635,
      "text": "两岸的红叶倒映在江水里，",
      "token_start": 1268,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 368310,
      "end_ms": 370615,
      "text": "坐船从巫峡穿过，",
      "token_start": 1279,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 371040,
      "end_ms": 372445,
      "text": "抬头是红叶山，",
      "token_start": 1286,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 372950,
      "end_ms": 374795,
      "text": "低头是红叶水。",
      "token_start": 1292,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 375270,
      "end_ms": 379885,
      "text": "核心观赏区覆盖无暇神女景区、小三峡等地。",
      "token_start": 1298,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 380500,
      "end_ms": 382985,
      "text": "您站在沈女峰对岸往上看，",
      "token_start": 1316,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 383730,
      "end_ms": 387345,
      "text": "整面山坡从江边一直红到山顶，",
      "token_start": 1327,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 387820,
      "end_ms": 388880,
      "text": "船在江里，",
      "token_start": 1340,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 388880,
      "end_ms": 390590,
      "text": "走山在两岸，",
      "token_start": 1344,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 390590,
      "end_ms": 394975,
      "text": "红一百二十万亩红叶挂在长江两岸。",
      "token_start": 1349,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 395670,
      "end_ms": 399440,
      "text": "您说这样的排场别处哪里找得到第一名？",
      "token_start": 1364,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 399520,
      "end_ms": 405365,
      "text": "内蒙古阿尔山大兴安岭西南山路排第一的是二山，",
      "token_start": 1381,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 406280,
      "end_ms": 409205,
      "text": "很多人只知道阿尔山是个边陲小城，",
      "token_start": 1402,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 409630,
      "end_ms": 413185,
      "text": "不知道他的秋天才是真正压箱底的绝活。",
      "token_start": 1417,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 413860,
      "end_ms": 416585,
      "text": "阿尔山地处大兴安岭西南山路，",
      "token_start": 1434,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 417050,
      "end_ms": 419435,
      "text": "全年无双期只有约九十五天，",
      "token_start": 1447,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 420020,
      "end_ms": 423115,
      "text": "是国内最早入秋的地方之一。",
      "token_start": 1459,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 423810,
      "end_ms": 426365,
      "text": "每年九月中下旬到十月上旬，",
      "token_start": 1471,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 426870,
      "end_ms": 429240,
      "text": "万顷临海如彩锦，",
      "token_start": 1483,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 429260,
      "end_ms": 433345,
      "text": "铺展金黄火红墨绿交织，",
      "token_start": 1490,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 433730,
      "end_ms": 434805,
      "text": "松涛阵阵，",
      "token_start": 1500,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 435340,
      "end_ms": 436445,
      "text": "雾气氤氲。",
      "token_start": 1504,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 437000,
      "end_ms": 440690,
      "text": "驼峰岭天池像一面天空之境，",
      "token_start": 1508,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 440730,
      "end_ms": 443445,
      "text": "倒映着蓝天和金黄的凌海。",
      "token_start": 1520,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 444370,
      "end_ms": 448525,
      "text": "石塘林的火山遗迹跟五彩丘陵形成强烈对比。",
      "token_start": 1531,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 449380,
      "end_ms": 454260,
      "text": "黑色的火山岩上长着金黄的落叶松像，",
      "token_start": 1550,
      "token_end_exclusive": 1566
    },
    {
      "start_ms": 454300,
      "end_ms": 455845,
      "text": "穿越到了另一个世界，",
      "token_start": 1566,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 456440,
      "end_ms": 456960,
      "text": "不冻河，",
      "token_start": 1575,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 456960,
      "end_ms": 459055,
      "text": "在零下的天气里照样流着。",
      "token_start": 1578,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 459990,
      "end_ms": 461535,
      "text": "河面上冒着热气，",
      "token_start": 1589,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 462160,
      "end_ms": 463835,
      "text": "两岸是金色的林子，",
      "token_start": 1596,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 464660,
      "end_ms": 465840,
      "text": "一座火山天池，",
      "token_start": 1604,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 465840,
      "end_ms": 467445,
      "text": "把林海泡在金子里。",
      "token_start": 1610,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 468350,
      "end_ms": 471295,
      "text": "您说这样的地方凭什么不能排第一？",
      "token_start": 1618,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 471730,
      "end_ms": 473705,
      "text": "从第十到第一名，",
      "token_start": 1633,
      "token_end_exclusive": 1640
    },
    {
      "start_ms": 474130,
      "end_ms": 476315,
      "text": "香山靠的是京城老底子。",
      "token_start": 1640,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 476830,
      "end_ms": 479730,
      "text": "张家界的骑风炮在云海里，",
      "token_start": 1650,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 479730,
      "end_ms": 482445,
      "text": "庐山用雾和红叶搭出失意。",
      "token_start": 1661,
      "token_end_exclusive": 1672
    },
    {
      "start_ms": 483030,
      "end_ms": 485965,
      "text": "黄山把云海和彩铃攒在一块儿。",
      "token_start": 1672,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 486430,
      "end_ms": 489730,
      "text": "栖霞山拿古寺配红墙指南村，",
      "token_start": 1685,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 489730,
      "end_ms": 493640,
      "text": "把梯田和银杏画成了油画峡浦，",
      "token_start": 1697,
      "token_end_exclusive": 1710
    },
    {
      "start_ms": 493640,
      "end_ms": 496495,
      "text": "让贪涂变成了光影的画布。",
      "token_start": 1710,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 497100,
      "end_ms": 501035,
      "text": "黄白塔在秦岭深处突出了百里彩铃。",
      "token_start": 1721,
      "token_end_exclusive": 1736
    },
    {
      "start_ms": 501680,
      "end_ms": 506115,
      "text": "巫山用一百二十万亩红叶染红了长江两岸，",
      "token_start": 1736,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 506590,
      "end_ms": 513645,
      "text": "可真正排在榜首的阿尔山用火山天池、金色林海和不动河的雾气，",
      "token_start": 1754,
      "token_end_exclusive": 1781
    },
    {
      "start_ms": 514170,
      "end_ms": 517955,
      "text": "给中国秋日胜地画上了最浓的一笔。",
      "token_start": 1781,
      "token_end_exclusive": 1796
    },
    {
      "start_ms": 518950,
      "end_ms": 522185,
      "text": "您心里头那个第一名跟这个排法对得上吗？",
      "token_start": 1796,
      "token_end_exclusive": 1814
    },
    {
      "start_ms": 522360,
      "end_ms": 523055,
      "text": "点个关注，",
      "token_start": 1814,
      "token_end_exclusive": 1818
    },
    {
      "start_ms": 524030,
      "end_ms": 525815,
      "text": "下回咱们接着聊。",
      "token_start": 1818,
      "token_end_exclusive": 1825
    }
  ],
