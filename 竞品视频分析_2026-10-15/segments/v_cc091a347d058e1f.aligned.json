{
  "video_id": "v_cc091a347d058e1f",
  "duration_s": 417.89,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_cc091a347d058e1f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_cc091a347d058e1f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 330,
      "end_ms": 1070,
      "text": "老话说，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 1670,
      "end_ms": 3570,
      "text": "地上文物看山西，",
      "token_start": 3,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 4430,
      "end_ms": 8189,
      "text": "要说中国哪里的老建筑最让人服气，",
      "token_start": 10,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 8630,
      "end_ms": 12370,
      "text": "山西绝对算得上一个这里的木头，",
      "token_start": 25,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 12630,
      "end_ms": 14170,
      "text": "扛过千年风雨，",
      "token_start": 39,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 14450,
      "end_ms": 16730,
      "text": "到今天依然站得笔直。",
      "token_start": 45,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 17170,
      "end_ms": 20210,
      "text": "可您知道山西那么多国宝古建，",
      "token_start": 54,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 20890,
      "end_ms": 23670,
      "text": "最不可思议的到底是哪一座吗？",
      "token_start": 67,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 24170,
      "end_ms": 28410,
      "text": "有人说是悬空寺挂在绝壁上一千五百年。",
      "token_start": 80,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 28830,
      "end_ms": 33580,
      "text": "有人说是佛光寺一千一百多年的唐代大殿，",
      "token_start": 97,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 33880,
      "end_ms": 34120,
      "text": "错，",
      "token_start": 115,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 34600,
      "end_ms": 37060,
      "text": "悬空寺连前寺都进不了，",
      "token_start": 116,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 37600,
      "end_ms": 39380,
      "text": "佛光寺也不是第一，",
      "token_start": 126,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 39740,
      "end_ms": 41960,
      "text": "真正排在榜首的那座，",
      "token_start": 134,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 42620,
      "end_ms": 44060,
      "text": "不用一根铁钉，",
      "token_start": 143,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 44840,
      "end_ms": 48000,
      "text": "近千年里挨了近两百发炮弹，",
      "token_start": 149,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 48740,
      "end_ms": 49960,
      "text": "还站在那儿。",
      "token_start": 161,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 50480,
      "end_ms": 56100,
      "text": "今天咱们就来盘点山西十大最不可思议的古代木结构建筑。",
      "token_start": 166,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 56440,
      "end_ms": 57180,
      "text": "话不多说，",
      "token_start": 191,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 57580,
      "end_ms": 58720,
      "text": "茶给您砌好了，",
      "token_start": 195,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 59040,
      "end_ms": 60915,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 201,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 61240,
      "end_ms": 62105,
      "text": "咱们这就开讲。",
      "token_start": 211,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 62430,
      "end_ms": 63335,
      "text": "第十名，",
      "token_start": 217,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 63740,
      "end_ms": 65040,
      "text": "平遥镇国寺，",
      "token_start": 220,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 65060,
      "end_ms": 65855,
      "text": "万佛殿，",
      "token_start": 225,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 66220,
      "end_ms": 66660,
      "text": "山西，",
      "token_start": 228,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 66720,
      "end_ms": 67275,
      "text": "平遥。",
      "token_start": 230,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 68060,
      "end_ms": 69045,
      "text": "说起平遥，",
      "token_start": 232,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 69460,
      "end_ms": 71280,
      "text": "您想到的准是明清。",
      "token_start": 236,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 71280,
      "end_ms": 74785,
      "text": "古城可从古城往东北走十来公里。",
      "token_start": 244,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 75230,
      "end_ms": 77215,
      "text": "郝洞村里还藏着一座殿，",
      "token_start": 258,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 77950,
      "end_ms": 81765,
      "text": "公元九百六十三年盖的五代乱世的手艺，",
      "token_start": 268,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 82570,
      "end_ms": 84415,
      "text": "全国现存的五代木构，",
      "token_start": 285,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 84700,
      "end_ms": 85735,
      "text": "一共就三座，",
      "token_start": 294,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 86200,
      "end_ms": 87165,
      "text": "他占了一座。",
      "token_start": 299,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 87610,
      "end_ms": 92425,
      "text": "您站在殿前屋檐底下那圈斗拱大的像撑开的伞，",
      "token_start": 304,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 93010,
      "end_ms": 96055,
      "text": "比后来明清的斗拱粗壮好几倍。",
      "token_start": 324,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 96910,
      "end_ms": 99435,
      "text": "店里的良家一颗铁钉没用，",
      "token_start": 337,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 100030,
      "end_ms": 102845,
      "text": "全靠木头一榫一毛咬在一起，",
      "token_start": 348,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 103500,
      "end_ms": 105885,
      "text": "一千多年过去没散，",
      "token_start": 360,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 106250,
      "end_ms": 108645,
      "text": "这乱世里留下的奇迹，",
      "token_start": 368,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 109070,
      "end_ms": 110545,
      "text": "您说惊人不惊人。",
      "token_start": 377,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 110940,
      "end_ms": 111775,
      "text": "第九名，",
      "token_start": 384,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 112300,
      "end_ms": 114140,
      "text": "高平崇明寺中佛殿，",
      "token_start": 387,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 114480,
      "end_ms": 115915,
      "text": "山西晋城高平。",
      "token_start": 395,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 116490,
      "end_ms": 119465,
      "text": "这座殿是北宋开宝年间盖的，",
      "token_start": 401,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 119760,
      "end_ms": 120815,
      "text": "一千多年了，",
      "token_start": 413,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 121440,
      "end_ms": 124215,
      "text": "他藏着一门几乎失传的绝活，",
      "token_start": 418,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 124790,
      "end_ms": 126075,
      "text": "叫断粮造。",
      "token_start": 430,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 126550,
      "end_ms": 127530,
      "text": "您走进店里，",
      "token_start": 434,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 127530,
      "end_ms": 128215,
      "text": "一抬头，",
      "token_start": 439,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 128620,
      "end_ms": 130485,
      "text": "那根大梁是断开的，",
      "token_start": 442,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 131280,
      "end_ms": 134305,
      "text": "两节短木头在半空中对接。",
      "token_start": 450,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 134740,
      "end_ms": 137725,
      "text": "当年工匠手里凑不齐那么长的枕木，",
      "token_start": 461,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 138280,
      "end_ms": 139855,
      "text": "就琢磨出一个办法，",
      "token_start": 476,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 140350,
      "end_ms": 145535,
      "text": "让两段木头靠榫卯和杠杆的巧劲彼此咬住，",
      "token_start": 484,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 146100,
      "end_ms": 149175,
      "text": "再让斗拱和立柱一起分担重量。",
      "token_start": 502,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 149570,
      "end_ms": 150755,
      "text": "听着像要塌吧，",
      "token_start": 515,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 151210,
      "end_ms": 157785,
      "text": "可他这一段就是一千年风雪压着屋顶压着粮还在。",
      "token_start": 521,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 158170,
      "end_ms": 161995,
      "text": "别人是把木头接掌宋代的民间工匠，",
      "token_start": 542,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 162420,
      "end_ms": 166035,
      "text": "是把一根断梁接成了千年不倒的本事。",
      "token_start": 557,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 166730,
      "end_ms": 169895,
      "text": "您说这手艺算不算鬼斧神工？",
      "token_start": 573,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 170270,
      "end_ms": 171165,
      "text": "第八名，",
      "token_start": 585,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 171620,
      "end_ms": 172920,
      "text": "朔州崇福寺，",
      "token_start": 588,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 173020,
      "end_ms": 173735,
      "text": "弥陀殿，",
      "token_start": 593,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 174090,
      "end_ms": 175195,
      "text": "山西朔州，",
      "token_start": 596,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 175940,
      "end_ms": 179035,
      "text": "他是金代皇家下令修的大殿，",
      "token_start": 600,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 179710,
      "end_ms": 183005,
      "text": "面阔期间宽的像个大礼堂，",
      "token_start": 612,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 183610,
      "end_ms": 184945,
      "text": "您往店里一站，",
      "token_start": 623,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 185450,
      "end_ms": 189555,
      "text": "心里最先冒出来的念头准是柱子呢？",
      "token_start": 629,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 190020,
      "end_ms": 190380,
      "text": "原来，",
      "token_start": 644,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 190380,
      "end_ms": 195780,
      "text": "为了让礼佛的人有足够的地方站工匠大胆抽掉了殿内，",
      "token_start": 646,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 195900,
      "end_ms": 197735,
      "text": "整整八根承重柱，",
      "token_start": 669,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 198250,
      "end_ms": 202075,
      "text": "这叫减铸造头顶沉甸甸的屋顶。",
      "token_start": 676,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 202850,
      "end_ms": 205820,
      "text": "万军的重量全被分到了，",
      "token_start": 689,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 205820,
      "end_ms": 207045,
      "text": "四周的粮价，",
      "token_start": 699,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 207280,
      "end_ms": 209280,
      "text": "可都拱上八百多年。",
      "token_start": 704,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 209280,
      "end_ms": 211140,
      "text": "过去店里空空荡荡，",
      "token_start": 712,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 211340,
      "end_ms": 212705,
      "text": "屋顶稳稳当当，",
      "token_start": 720,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 213580,
      "end_ms": 214955,
      "text": "抽掉八根柱子，",
      "token_start": 726,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 215270,
      "end_ms": 216895,
      "text": "还敢盖期间的大殿。",
      "token_start": 732,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 217360,
      "end_ms": 217760,
      "text": "古人，",
      "token_start": 740,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 217760,
      "end_ms": 219970,
      "text": "这胆子大的包天心，",
      "token_start": 742,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 220010,
      "end_ms": 221415,
      "text": "似又细如发丝，",
      "token_start": 750,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 221950,
      "end_ms": 223225,
      "text": "八根柱子抽走，",
      "token_start": 756,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 223610,
      "end_ms": 224030,
      "text": "大殿，",
      "token_start": 762,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 224050,
      "end_ms": 225375,
      "text": "稳立八百多年。",
      "token_start": 764,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 225850,
      "end_ms": 227755,
      "text": "您说这力学琢磨的透不透？",
      "token_start": 770,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 228110,
      "end_ms": 228835,
      "text": "第七名，",
      "token_start": 781,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 229490,
      "end_ms": 230570,
      "text": "太原晋祠，",
      "token_start": 784,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 230650,
      "end_ms": 231335,
      "text": "圣母殿，",
      "token_start": 788,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 231880,
      "end_ms": 232825,
      "text": "山西太原，",
      "token_start": 791,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 233740,
      "end_ms": 234260,
      "text": "晋祠，",
      "token_start": 795,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 234320,
      "end_ms": 235485,
      "text": "您或许去过，",
      "token_start": 797,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 236030,
      "end_ms": 238175,
      "text": "可多数人只顾着看泉水，",
      "token_start": 802,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 238640,
      "end_ms": 241415,
      "text": "没留意殿前廊下那八根柱子，",
      "token_start": 812,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 241890,
      "end_ms": 244970,
      "text": "每根柱子上都盘着一条木雕。",
      "token_start": 824,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 244990,
      "end_ms": 249085,
      "text": "巨龙是北宋刻的将近一千年，",
      "token_start": 836,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 249610,
      "end_ms": 252410,
      "text": "是现存最早的一批木雕盘。",
      "token_start": 848,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 253160,
      "end_ms": 259195,
      "text": "这座殿还有个第一四周一圈回廊叫覆街周匝。",
      "token_start": 859,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 259880,
      "end_ms": 264865,
      "text": "现存最早的食物就是他最不可思议的是，",
      "token_start": 878,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 265380,
      "end_ms": 267465,
      "text": "店就坐在泉水边上，",
      "token_start": 895,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 268110,
      "end_ms": 270740,
      "text": "常年潮气裹着木头，",
      "token_start": 903,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 270740,
      "end_ms": 271995,
      "text": "本该早就烂了。",
      "token_start": 911,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 272370,
      "end_ms": 275115,
      "text": "可这八条龙到今天还怒目圆睁，",
      "token_start": 917,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 275690,
      "end_ms": 276635,
      "text": "张牙舞爪，",
      "token_start": 930,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 277160,
      "end_ms": 279855,
      "text": "像随时要从柱子上飞出去。",
      "token_start": 934,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 280250,
      "end_ms": 284675,
      "text": "一千年前刻在木头上的龙没烂在水汽里，",
      "token_start": 945,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 285180,
      "end_ms": 286105,
      "text": "您说神不神。",
      "token_start": 962,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 286460,
      "end_ms": 287295,
      "text": "第六名，",
      "token_start": 967,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 287750,
      "end_ms": 293375,
      "text": "芮城永乐宫三清殿山西运城芮城讲到这里，",
      "token_start": 970,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 293840,
      "end_ms": 296525,
      "text": "上级最重的一锤就砸下来了。",
      "token_start": 988,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 297010,
      "end_ms": 302905,
      "text": "这是元代的大殿七百多年呢公里近千平方米的壁画，",
      "token_start": 1000,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 303520,
      "end_ms": 306055,
      "text": "诸神列队气势压人。",
      "token_start": 1022,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 306740,
      "end_ms": 309700,
      "text": "可他最让人吃惊的不是壁画，",
      "token_start": 1030,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 309980,
      "end_ms": 311020,
      "text": "是一次搬家。",
      "token_start": 1042,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 311440,
      "end_ms": 312520,
      "text": "一九五九年，",
      "token_start": 1047,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 313020,
      "end_ms": 315280,
      "text": "黄河、三门峡要修水库，",
      "token_start": 1052,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 316120,
      "end_ms": 317660,
      "text": "永乐宫的老地方。",
      "token_start": 1061,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 317660,
      "end_ms": 319500,
      "text": "要被淹了怎么办？",
      "token_start": 1068,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 319840,
      "end_ms": 323060,
      "text": "工匠们把整座大殿一块一块拆开，",
      "token_start": 1075,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 323360,
      "end_ms": 324080,
      "text": "编上号，",
      "token_start": 1089,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 324620,
      "end_ms": 326780,
      "text": "拆成几千个榫卯构件，",
      "token_start": 1092,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 327360,
      "end_ms": 329060,
      "text": "壁画也一块一块，",
      "token_start": 1101,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 329100,
      "end_ms": 330180,
      "text": "小心切下来，",
      "token_start": 1108,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 330740,
      "end_ms": 332820,
      "text": "一起运到二十公里外，",
      "token_start": 1113,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 333160,
      "end_ms": 334680,
      "text": "再原样拼回去。",
      "token_start": 1122,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 335100,
      "end_ms": 337370,
      "text": "一座七百岁的木头大殿，",
      "token_start": 1128,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 337810,
      "end_ms": 339110,
      "text": "像搭积木一样，",
      "token_start": 1138,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 339150,
      "end_ms": 339890,
      "text": "拆了又拼，",
      "token_start": 1144,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 340310,
      "end_ms": 342050,
      "text": "您说这是什么样的手艺？",
      "token_start": 1148,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 342850,
      "end_ms": 346650,
      "text": "千年的榫卯经得起剑也经得起拆，",
      "token_start": 1158,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 346990,
      "end_ms": 348450,
      "text": "这才是真功夫。",
      "token_start": 1172,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 348810,
      "end_ms": 350310,
      "text": "从第十到第六名，",
      "token_start": 1178,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 350710,
      "end_ms": 354190,
      "text": "镇国寺的散状斗工撑过了五代乱世，",
      "token_start": 1185,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 354790,
      "end_ms": 356290,
      "text": "崇明寺断了梁阙，",
      "token_start": 1200,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 356510,
      "end_ms": 357310,
      "text": "千年不垮，",
      "token_start": 1207,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 357910,
      "end_ms": 358630,
      "text": "崇福寺，",
      "token_start": 1211,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 358810,
      "end_ms": 360050,
      "text": "抽掉八根柱子，",
      "token_start": 1214,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 360170,
      "end_ms": 361310,
      "text": "屋顶纹丝不动。",
      "token_start": 1220,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 361950,
      "end_ms": 364610,
      "text": "圣母殿木雕盘龙千年不动，",
      "token_start": 1226,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 365230,
      "end_ms": 365930,
      "text": "圣乐宫，",
      "token_start": 1237,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 365990,
      "end_ms": 367940,
      "text": "整座大殿拆成几千块，",
      "token_start": 1240,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 367940,
      "end_ms": 368965,
      "text": "又拼了回去，",
      "token_start": 1249,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 369580,
      "end_ms": 372225,
      "text": "可他们还不是最不可思议的。",
      "token_start": 1254,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 372580,
      "end_ms": 374935,
      "text": "接下来第五道第一名更加绝妙，",
      "token_start": 1266,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 375590,
      "end_ms": 376630,
      "text": "有一座楼阁，",
      "token_start": 1279,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 376710,
      "end_ms": 378930,
      "text": "全凭悬空倒挂的柱子，",
      "token_start": 1284,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 378950,
      "end_ms": 380555,
      "text": "把楼层挑在半空。",
      "token_start": 1293,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 381290,
      "end_ms": 382930,
      "text": "有一座绝壁奇构，",
      "token_start": 1300,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 382970,
      "end_ms": 384745,
      "text": "看似用细木撑着，",
      "token_start": 1307,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 385240,
      "end_ms": 387875,
      "text": "骨子里却横插在岩石深处，",
      "token_start": 1314,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 388280,
      "end_ms": 392855,
      "text": "可排在榜首的那座二十层楼高的纯木身躯，",
      "token_start": 1325,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 393560,
      "end_ms": 397555,
      "text": "在狂风地震和两百发战争炮弹的洗礼下，",
      "token_start": 1343,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 397970,
      "end_ms": 400825,
      "text": "硬是一点没他他是哪座，",
      "token_start": 1360,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 401270,
      "end_ms": 404290,
      "text": "他凭什么排在大名鼎鼎的悬空寺？",
      "token_start": 1370,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 404310,
      "end_ms": 407085,
      "text": "前面下一集已经同步更新，",
      "token_start": 1384,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 407980,
      "end_ms": 409165,
      "text": "点开我的头像，",
      "token_start": 1395,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 409410,
      "end_ms": 412515,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1401,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 413100,
      "end_ms": 417595,
      "text": "看看谁才是山西古代木结构建筑的巅峰神话。",
      "token_start": 1413,
      "token_end_exclusive": 1432
    }
  ],
