{
  "video_id": "v_002792061fd566b1",
  "duration_s": 319.739002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_002792061fd566b1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_002792061fd566b1.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 890,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1130,
      "end_ms": 5130,
      "text": "咱们国家公路总里程已经超过五百四十万公里，",
      "token_start": 4,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5430,
      "end_ms": 6970,
      "text": "能绕地球一百多圈。",
      "token_start": 24,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 7230,
      "end_ms": 9430,
      "text": "可要说哪一条自驾路线最美？",
      "token_start": 32,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 9750,
      "end_ms": 11090,
      "text": "那争议可就大了。",
      "token_start": 44,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 11410,
      "end_ms": 16129,
      "text": "中国说是川藏线中国人的景观大道，",
      "token_start": 51,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 16350,
      "end_ms": 18570,
      "text": "有人说是青海大环线，",
      "token_start": 66,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 19390,
      "end_ms": 19630,
      "text": "错，",
      "token_start": 75,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 19970,
      "end_ms": 21630,
      "text": "真要论清美这个字，",
      "token_start": 76,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 21730,
      "end_ms": 23330,
      "text": "他们连前三都进不去。",
      "token_start": 84,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 23330,
      "end_ms": 29070,
      "text": "今天咱们就来盘点中国十大最美自驾路线，",
      "token_start": 93,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 29070,
      "end_ms": 31260,
      "text": "有先讲第十道，",
      "token_start": 111,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 31260,
      "end_ms": 33700,
      "text": "第六一条比一条好看。",
      "token_start": 117,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 34180,
      "end_ms": 38660,
      "text": "老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 126,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 38920,
      "end_ms": 42260,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 143,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 42520,
      "end_ms": 45420,
      "text": "海南环岛线从海口出发，",
      "token_start": 155,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 45660,
      "end_ms": 47460,
      "text": "走东线到三亚，",
      "token_start": 165,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 47800,
      "end_ms": 49980,
      "text": "再从西线绕回海口，",
      "token_start": 171,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 50280,
      "end_ms": 51720,
      "text": "全程六百多公里。",
      "token_start": 179,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 52200,
      "end_ms": 57160,
      "text": "这条路最绝的是他把整个海南岛串成了一个圈儿。",
      "token_start": 186,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 57460,
      "end_ms": 58540,
      "text": "东线看海，",
      "token_start": 207,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 58980,
      "end_ms": 60010,
      "text": "文昌的椰林，",
      "token_start": 211,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 60370,
      "end_ms": 61575,
      "text": "万宁的冲浪，",
      "token_start": 216,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 61910,
      "end_ms": 64455,
      "text": "陵水的清水湾西线看山，",
      "token_start": 221,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 64730,
      "end_ms": 66025,
      "text": "儋州的石花水洞，",
      "token_start": 231,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 66520,
      "end_ms": 67945,
      "text": "东方的榆林州，",
      "token_start": 238,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 68290,
      "end_ms": 70960,
      "text": "昌江的棋子湾一圈下来，",
      "token_start": 244,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 71240,
      "end_ms": 76030,
      "text": "热带雨林温泉海滩盐田全看了，",
      "token_start": 254,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 76030,
      "end_ms": 78065,
      "text": "冬天走这条线最舒服，",
      "token_start": 267,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 78410,
      "end_ms": 79825,
      "text": "北方零下十几度，",
      "token_start": 276,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 80070,
      "end_ms": 81165,
      "text": "海南二十多度，",
      "token_start": 283,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 81640,
      "end_ms": 83105,
      "text": "一件短袖就够了。",
      "token_start": 289,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 83540,
      "end_ms": 84785,
      "text": "您说这是自驾，",
      "token_start": 296,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 85070,
      "end_ms": 87245,
      "text": "还是把冬天甩在了身后？",
      "token_start": 302,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 87850,
      "end_ms": 88485,
      "text": "第九名，",
      "token_start": 312,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 88850,
      "end_ms": 91295,
      "text": "皖南环线从黄山出发，",
      "token_start": 315,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 91630,
      "end_ms": 94575,
      "text": "经洪村西地齐云山、太平湖，",
      "token_start": 324,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 95020,
      "end_ms": 95965,
      "text": "再回黄山，",
      "token_start": 335,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 96360,
      "end_ms": 99150,
      "text": "全程三百多公里这条路。",
      "token_start": 339,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 99150,
      "end_ms": 100300,
      "text": "最绝的是，",
      "token_start": 349,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 100300,
      "end_ms": 104325,
      "text": "他把徽州最好的山水和村子串成了一个圈儿。",
      "token_start": 353,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 104770,
      "end_ms": 105885,
      "text": "红村的越长，",
      "token_start": 372,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 106250,
      "end_ms": 107345,
      "text": "西地的牌坊，",
      "token_start": 377,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 107660,
      "end_ms": 108675,
      "text": "踏川的秋色，",
      "token_start": 382,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 109100,
      "end_ms": 110300,
      "text": "齐云山的丹下，",
      "token_start": 387,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 110480,
      "end_ms": 111515,
      "text": "太平湖的水，",
      "token_start": 393,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 111910,
      "end_ms": 113730,
      "text": "一路都是白墙黑瓦，",
      "token_start": 398,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 113990,
      "end_ms": 115445,
      "text": "马头墙青石板。",
      "token_start": 406,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 116050,
      "end_ms": 119315,
      "text": "您春天去油菜花铺满山坡，",
      "token_start": 412,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 119750,
      "end_ms": 123680,
      "text": "秋天去塔川的红叶烧红了半边天。",
      "token_start": 423,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 123840,
      "end_ms": 125005,
      "text": "这条路不长，",
      "token_start": 437,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 125520,
      "end_ms": 127365,
      "text": "但每一段都是话，",
      "token_start": 442,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 128160,
      "end_ms": 132355,
      "text": "您说这是自驾还是在一幅徽州长卷里慢慢翻第八名。",
      "token_start": 449,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 132530,
      "end_ms": 134870,
      "text": "甘南环县从兰州出发，",
      "token_start": 471,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 135170,
      "end_ms": 138095,
      "text": "经下河朗目四扎嘎纳，",
      "token_start": 480,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 138500,
      "end_ms": 140105,
      "text": "若尔盖再回兰州，",
      "token_start": 489,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 140470,
      "end_ms": 141775,
      "text": "全程一千多公里。",
      "token_start": 496,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 142120,
      "end_ms": 148035,
      "text": "这条路最绝的是他把青藏高原的精华浓缩在一个圈里。",
      "token_start": 503,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 148540,
      "end_ms": 152675,
      "text": "拉布棱寺世界最长的转经郎郎目四，",
      "token_start": 526,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 153160,
      "end_ms": 158405,
      "text": "一脚踏两省扎嘎纳石头城里的葬寨、若尔盖草原，",
      "token_start": 541,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 159240,
      "end_ms": 164225,
      "text": "中国最美的湿地草原、花壶黄河九曲第一湾，",
      "token_start": 561,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 164540,
      "end_ms": 167985,
      "text": "一路都是雪山草原寺庙经翻，",
      "token_start": 579,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 168290,
      "end_ms": 169075,
      "text": "海拔不高，",
      "token_start": 591,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 169370,
      "end_ms": 170155,
      "text": "路也好走，",
      "token_start": 595,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 170570,
      "end_ms": 173465,
      "text": "特别适合第一次上高原的人。",
      "token_start": 599,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 173830,
      "end_ms": 174865,
      "text": "您说这是自驾，",
      "token_start": 611,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 175430,
      "end_ms": 178685,
      "text": "还是把西藏搬到了甘肃第七名？",
      "token_start": 617,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 179070,
      "end_ms": 181795,
      "text": "滇西北环线从昆明出发，",
      "token_start": 630,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 182130,
      "end_ms": 187410,
      "text": "经大理、丽江、香格里拉、泸沽湖再回昆明，",
      "token_start": 640,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 187690,
      "end_ms": 189985,
      "text": "全城一千八百多公里。",
      "token_start": 656,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 191000,
      "end_ms": 196365,
      "text": "这条路最绝的是他把云南最好的风景全串在一起。",
      "token_start": 665,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 196710,
      "end_ms": 198245,
      "text": "大理的苍山洱海，",
      "token_start": 686,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 198710,
      "end_ms": 208045,
      "text": "丽江的玉龙雪山、香格里拉的普达措、泸沽湖的走婚桥、虎跳峡的惊涛拍岸，",
      "token_start": 693,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 208580,
      "end_ms": 210905,
      "text": "梅里雪山的日照金山，",
      "token_start": 723,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 211470,
      "end_ms": 213415,
      "text": "白水台的盖华梯田，",
      "token_start": 732,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 214070,
      "end_ms": 218035,
      "text": "一条环线从热带雨林走到雪山高原，",
      "token_start": 740,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 218660,
      "end_ms": 221635,
      "text": "从海拔五百米爬到四千米，",
      "token_start": 755,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 222510,
      "end_ms": 223275,
      "text": "走一趟，",
      "token_start": 766,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 224080,
      "end_ms": 227160,
      "text": "等于把云南的四季都过了一遍。",
      "token_start": 769,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 227240,
      "end_ms": 227915,
      "text": "第六名，",
      "token_start": 782,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 229020,
      "end_ms": 231690,
      "text": "青海大环线从西宁出发，",
      "token_start": 785,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 231910,
      "end_ms": 238605,
      "text": "经青海湖、茶卡盐湖、大柴、蛋、敦煌、嘉峪关、张掖、祁连山，",
      "token_start": 795,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 239700,
      "end_ms": 240520,
      "text": "再回西宁，",
      "token_start": 816,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 240780,
      "end_ms": 242485,
      "text": "全程两千多公里。",
      "token_start": 820,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 243060,
      "end_ms": 248775,
      "text": "这条路最绝的是他把青海和甘肃的精华串成了一个圈儿。",
      "token_start": 827,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 249580,
      "end_ms": 253685,
      "text": "青海湖的兰、茶卡盐湖的静、翡翠湖的绿，",
      "token_start": 851,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 254130,
      "end_ms": 257345,
      "text": "莫高窟的壁画、鸣沙山的骆驼，",
      "token_start": 867,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 257860,
      "end_ms": 262905,
      "text": "嘉峪关的城楼、七彩丹霞的彩、祁连山的雪，",
      "token_start": 879,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 263250,
      "end_ms": 264695,
      "text": "一路都是视觉轰炸。",
      "token_start": 896,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 265030,
      "end_ms": 268655,
      "text": "您开一天停一天拍一天两千多公里，",
      "token_start": 904,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 268900,
      "end_ms": 269995,
      "text": "走完要七八天，",
      "token_start": 919,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 270410,
      "end_ms": 271675,
      "text": "可每一段都值。",
      "token_start": 925,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 272190,
      "end_ms": 273505,
      "text": "您说这是自驾，",
      "token_start": 931,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 273920,
      "end_ms": 278665,
      "text": "还是在中国最后的历史和最野的风景里走了一圈儿。",
      "token_start": 937,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 279130,
      "end_ms": 280525,
      "text": "从第十到第六，",
      "token_start": 959,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 280840,
      "end_ms": 283245,
      "text": "海南环岛把冬天甩在身后，",
      "token_start": 965,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 283660,
      "end_ms": 287470,
      "text": "皖南环线在徽州长卷里翻甘南环线，",
      "token_start": 976,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 287670,
      "end_ms": 289525,
      "text": "把西藏搬到了甘肃。",
      "token_start": 991,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 289920,
      "end_ms": 293255,
      "text": "滇西北环线把云南四季过一遍，",
      "token_start": 999,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 293720,
      "end_ms": 294660,
      "text": "青海大环线，",
      "token_start": 1012,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 294700,
      "end_ms": 296540,
      "text": "把历史和风景串成圈，",
      "token_start": 1017,
      "token_end_exclusive": 1026
    },
    {
