  "segments": [
    {
      "start_ms": 700,
      "end_ms": 2040,
      "text": "人一定要多出去走走，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2220,
      "end_ms": 4140,
      "text": "其实啊去哪并不重要，",
      "token_start": 9,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4520,
      "end_ms": 7620,
      "text": "关键是不能长时间的待在同一个地方。",
      "token_start": 18,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 8320,
      "end_ms": 13000,
      "text": "你看人和木在一起是一个修字人和山在一起，",
      "token_start": 34,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13440,
      "end_ms": 16220,
      "text": "是一个仙字最好的休息啊，",
      "token_start": 53,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 16240,
      "end_ms": 18140,
      "text": "不是长时间待在同一个地方，",
      "token_start": 64,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 18380,
      "end_ms": 19640,
      "text": "而是多出去走走，",
      "token_start": 76,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 19920,
      "end_ms": 20840,
      "text": "呼吸天地，",
      "token_start": 83,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 20900,
      "end_ms": 21320,
      "text": "清气，",
      "token_start": 87,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 21600,
      "end_ms": 23100,
      "text": "感受万物有灵。",
      "token_start": 89,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 23800,
      "end_ms": 27180,
      "text": "山川草木阳光雨露能沐浴生心。",
      "token_start": 95,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 27740,
      "end_ms": 28800,
      "text": "黄帝内经中说，",
      "token_start": 108,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 29080,
      "end_ms": 29965,
      "text": "久坐伤肉，",
      "token_start": 114,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 30550,
      "end_ms": 31570,
      "text": "酒卧伤气，",
      "token_start": 118,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 32170,
      "end_ms": 33770,
      "text": "跳出眼前的方寸之地，",
      "token_start": 122,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 34110,
      "end_ms": 35390,
      "text": "去见不一样的风景，",
      "token_start": 131,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 35530,
      "end_ms": 38650,
      "text": "不一样的人舒展自己被困住的情绪，",
      "token_start": 139,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 39010,
      "end_ms": 41945,
      "text": "在路上慢慢治愈自己。",
      "token_start": 154,
      "token_end_exclusive": 163
    }
