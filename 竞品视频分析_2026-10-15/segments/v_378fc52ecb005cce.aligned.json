{
  "video_id": "v_378fc52ecb005cce",
  "duration_s": 466.206897,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_378fc52ecb005cce.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_378fc52ecb005cce.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1250,
      "text": "一九三七年，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1730,
      "end_ms": 3410,
      "text": "杭州钱塘江边，",
      "token_start": 5,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 4330,
      "end_ms": 6510,
      "text": "一个戴眼镜的中年人，",
      "token_start": 11,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 7210,
      "end_ms": 9030,
      "text": "站在自己花了三年。",
      "token_start": 20,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 9890,
      "end_ms": 14490,
      "text": "这九百二十五个日夜建成的大桥桥头，",
      "token_start": 28,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 15570,
      "end_ms": 19590,
      "text": "他身后是几十万哭喊着的逃难百姓，",
      "token_start": 44,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 20250,
      "end_ms": 25230,
      "text": "他面前是扬着尘土马上就要到的日本骑兵。",
      "token_start": 59,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 25690,
      "end_ms": 27810,
      "text": "然后他做了一个决定，",
      "token_start": 77,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 28210,
      "end_ms": 31560,
      "text": "把自己这辈子的心头骨肉炸掉了。",
      "token_start": 86,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 33040,
      "end_ms": 36820,
      "text": "这座桥通车才八十九天。",
      "token_start": 100,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 38000,
      "end_ms": 42500,
      "text": "今天这个故事最狠的不是炸桥，",
      "token_start": 110,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 42740,
      "end_ms": 46940,
      "text": "是炸桥之前他干的事先说这个人是谁？",
      "token_start": 123,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 47860,
      "end_ms": 51240,
      "text": "先说茅以生中国现代桥梁之父。",
      "token_start": 139,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 52180,
      "end_ms": 53700,
      "text": "上世纪三十年代，",
      "token_start": 152,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 54060,
      "end_ms": 56020,
      "text": "全世界的工程师都断言，",
      "token_start": 159,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 56780,
      "end_ms": 60010,
      "text": "钱塘江上不可能建桥江底，",
      "token_start": 169,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 60150,
      "end_ms": 62670,
      "text": "四十米厚的流沙一脚踩下去，",
      "token_start": 180,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 62670,
      "end_ms": 63465,
      "text": "直往下陷，",
      "token_start": 192,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 63880,
      "end_ms": 65475,
      "text": "水深的看不见底。",
      "token_start": 196,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 65990,
      "end_ms": 66890,
      "text": "潮水一来，",
      "token_start": 203,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 67190,
      "end_ms": 70105,
      "text": "能把几百吨的沉香先着走。",
      "token_start": 207,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 70870,
      "end_ms": 72435,
      "text": "杭州人有句歇后语，",
      "token_start": 218,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 72950,
      "end_ms": 76580,
      "text": "钱塘江上造桥不可能毛以生，",
      "token_start": 226,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 76580,
      "end_ms": 77345,
      "text": "不信邪。",
      "token_start": 238,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 78000,
      "end_ms": 80480,
      "text": "他带着团队蹲在江滩上，",
      "token_start": 241,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 80560,
      "end_ms": 85695,
      "text": "硬是发明了涉水法打桩臣襄法驻敦福运法架梁，",
      "token_start": 251,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 86080,
      "end_ms": 88095,
      "text": "解决了八十多个技术难题。",
      "token_start": 271,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 89020,
      "end_ms": 89615,
      "text": "有一次，",
      "token_start": 282,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 90040,
      "end_ms": 93905,
      "text": "一个六百吨重的沉乡被大潮冲走，",
      "token_start": 285,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 94430,
      "end_ms": 98975,
      "text": "毛以生带着人在江面上追了三天三夜才拖回来。",
      "token_start": 299,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 100050,
      "end_ms": 101885,
      "text": "一九三七年九月二十六日，",
      "token_start": 319,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 102660,
      "end_ms": 104625,
      "text": "第一列火车从桥上开过。",
      "token_start": 330,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 105530,
      "end_ms": 106415,
      "text": "汽笛一响，",
      "token_start": 340,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 106860,
      "end_ms": 110255,
      "text": "两岸老百姓哭着喊中国人自己造的。",
      "token_start": 344,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 110550,
      "end_ms": 112785,
      "text": "全长一千四百五十三米，",
      "token_start": 359,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 113710,
      "end_ms": 116260,
      "text": "上层跑汽车下层跑火车。",
      "token_start": 369,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 116380,
      "end_ms": 122340,
      "text": "中国第一座双层铁路公路两用桥全部由中国人自己设计，",
      "token_start": 379,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 122620,
      "end_ms": 123640,
      "text": "自己建造。",
      "token_start": 403,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 124220,
      "end_ms": 126920,
      "text": "可就在全杭州都在欢呼的时候，",
      "token_start": 407,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 127200,
      "end_ms": 128820,
      "text": "没人知道这两件事。",
      "token_start": 420,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 129240,
      "end_ms": 133850,
      "text": "第一件卢沟桥的枪声一响，",
      "token_start": 428,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 134370,
      "end_ms": 138290,
      "text": "茅倚声就偷偷改了自己设计的图纸。",
      "token_start": 439,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 138810,
      "end_ms": 141030,
      "text": "在南岸那个桥墩的肚子里，",
      "token_start": 454,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 141130,
      "end_ms": 143430,
      "text": "他留下一个长方形的空洞，",
      "token_start": 465,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 144090,
      "end_ms": 145930,
      "text": "别人问他干什么用的，",
      "token_start": 476,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 146090,
      "end_ms": 147610,
      "text": "他一个字都不解释，",
      "token_start": 485,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 147969,
      "end_ms": 150490,
      "text": "那是预留的爆破材料室。",
      "token_start": 493,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 151210,
      "end_ms": 158210,
      "text": "第二件总工程师罗英建桥的时候出过一个上联，",
      "token_start": 503,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 158650,
      "end_ms": 161090,
      "text": "钱塘江桥五行缺火。",
      "token_start": 523,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 161490,
      "end_ms": 166780,
      "text": "你看前四个字金字旁土字旁、三点水、木字旁偏偏缺个火，",
      "token_start": 531,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 167280,
      "end_ms": 169820,
      "text": "他一直等人来对下联结，",
      "token_start": 554,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 169820,
      "end_ms": 172580,
      "text": "过火真来了。",
      "token_start": 564,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 173620,
      "end_ms": 176220,
      "text": "一九三七年十一月十六日，",
      "token_start": 569,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 176940,
      "end_ms": 180835,
      "text": "南京的紧急命令送到毛以生手上，",
      "token_start": 580,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 181670,
      "end_ms": 182805,
      "text": "杭州不保，",
      "token_start": 594,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 184210,
      "end_ms": 185215,
      "text": "即刻扎桥。",
      "token_start": 598,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 186360,
      "end_ms": 186875,
      "text": "当晚，",
      "token_start": 602,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 187210,
      "end_ms": 189105,
      "text": "毛以生一夜没睡，",
      "token_start": 604,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 189580,
      "end_ms": 192845,
      "text": "他拿着笔把这座桥所有的致命点，",
      "token_start": 611,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 193240,
      "end_ms": 195295,
      "text": "一个一个标在图纸上，",
      "token_start": 625,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 195930,
      "end_ms": 199630,
      "text": "就像给自己的亲儿子挑断筋骨的位置。",
      "token_start": 634,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 199790,
      "end_ms": 202395,
      "text": "工程兵问他确定要炸这么狠。",
      "token_start": 650,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 202940,
      "end_ms": 203380,
      "text": "他说，",
      "token_start": 662,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 203680,
      "end_ms": 204285,
      "text": "诈不狠，",
      "token_start": 664,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 204590,
      "end_ms": 208175,
      "text": "敌人就能拿来用爆破材料往桥里一装，",
      "token_start": 667,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 208610,
      "end_ms": 210535,
      "text": "乔墩肚子里二十二香，",
      "token_start": 683,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 211030,
      "end_ms": 212885,
      "text": "每箱四百四十公斤，",
      "token_start": 692,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 213530,
      "end_ms": 214330,
      "text": "蹲着两头，",
      "token_start": 700,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 214330,
      "end_ms": 215295,
      "text": "再挂十六香，",
      "token_start": 704,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 215690,
      "end_ms": 217625,
      "text": "旁边那个墩子再来十四降，",
      "token_start": 709,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 218080,
      "end_ms": 219565,
      "text": "加起来一万多公斤，",
      "token_start": 720,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 219990,
      "end_ms": 225795,
      "text": "一百几十根引线全部拧到南岸一间房子里边引爆气上。",
      "token_start": 728,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 226290,
      "end_ms": 228225,
      "text": "他后来在回忆录里写了一句话，",
      "token_start": 751,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 229830,
      "end_ms": 231390,
      "text": "我第一次读到的时候，",
      "token_start": 764,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 231490,
      "end_ms": 232655,
      "text": "后背是麻的。",
      "token_start": 773,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 233310,
      "end_ms": 238115,
      "text": "开桥的第一天桥里就先有了放爆破材料的地，",
      "token_start": 778,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 239230,
      "end_ms": 243805,
      "text": "这在古今中外的桥梁史上要算是空前的了。",
      "token_start": 797,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 244200,
      "end_ms": 248005,
      "text": "可是接下来所有人都想不到的事发生了，",
      "token_start": 815,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 248430,
      "end_ms": 249695,
      "text": "引线都接好了，",
      "token_start": 832,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 250040,
      "end_ms": 252190,
      "text": "随时能炸毛以生，",
      "token_start": 838,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 252190,
      "end_ms": 253865,
      "text": "却开始往省政府跑，",
      "token_start": 845,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 254260,
      "end_ms": 255625,
      "text": "一遍一遍的磨，",
      "token_start": 853,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 256030,
      "end_ms": 256675,
      "text": "再等等，",
      "token_start": 859,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 256990,
      "end_ms": 257825,
      "text": "再让我等等。",
      "token_start": 862,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 258450,
      "end_ms": 260155,
      "text": "他要多等三十七天，",
      "token_start": 867,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 261800,
      "end_ms": 262295,
      "text": "为什么？",
      "token_start": 875,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 263780,
      "end_ms": 265245,
      "text": "因为桥还能过人，",
      "token_start": 878,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 267480,
      "end_ms": 268965,
      "text": "十一月十七日，",
      "token_start": 885,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 270080,
      "end_ms": 272945,
      "text": "公路桥开放就那一天，",
      "token_start": 891,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 273720,
      "end_ms": 276620,
      "text": "十万多难民从桥上走过去，",
      "token_start": 900,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 276700,
      "end_ms": 279885,
      "text": "逃难整个八十九天里，",
      "token_start": 911,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 280470,
      "end_ms": 286100,
      "text": "三百多台机车两千多节车厢从桥上抢运。",
      "token_start": 920,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 286120,
      "end_ms": 296345,
      "text": "过江转移的军民上百万人运走的物资价值比这座桥五百四十万银元的造价还要贵。",
      "token_start": 937,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 297000,
      "end_ms": 299165,
      "text": "闸桥命令早一天执行，",
      "token_start": 972,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 299670,
      "end_ms": 301365,
      "text": "日军早一天过江，",
      "token_start": 981,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 301890,
      "end_ms": 304245,
      "text": "晚一天就多救一天的人。",
      "token_start": 988,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 305090,
      "end_ms": 306905,
      "text": "毛益生这是在拿桥换命。",
      "token_start": 998,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 307330,
      "end_ms": 310610,
      "text": "他知道这座桥每一根钢梁值多少钱，",
      "token_start": 1008,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 310690,
      "end_ms": 314150,
      "text": "他更知道桥上每一个难民值多少钱。",
      "token_start": 1023,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 314970,
      "end_ms": 318150,
      "text": "一九三七年十二月二十三日下午，",
      "token_start": 1038,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 318570,
      "end_ms": 322690,
      "text": "日军骑兵的烟尘在桥头已经看得见了。",
      "token_start": 1052,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 323030,
      "end_ms": 325270,
      "text": "紧急命令再次传来，",
      "token_start": 1068,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 325790,
      "end_ms": 326470,
      "text": "立即炸。",
      "token_start": 1076,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 327670,
      "end_ms": 332870,
      "text": "可北岸还有成千上万的人在哭喊着要过江茅蚁升墙，",
      "token_start": 1079,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 332990,
      "end_ms": 335870,
      "text": "压着引爆器一分一秒的熬。",
      "token_start": 1101,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 336290,
      "end_ms": 337680,
      "text": "直到下午五点，",
      "token_start": 1112,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 337720,
      "end_ms": 339760,
      "text": "人群清完通道关闭，",
      "token_start": 1118,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 340300,
      "end_ms": 344400,
      "text": "日本兵的马已经到了视野里。",
      "token_start": 1126,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 345299,
      "end_ms": 345865,
      "text": "他说，",
      "token_start": 1138,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 347790,
      "end_ms": 351360,
      "text": "引爆一声巨响，",
      "token_start": 1140,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 351600,
      "end_ms": 362660,
      "text": "五孔每孔六十七米的钢梁砸进钱塘江南岸那座他亲手建的桥墩炸的只剩半截斜着歪在水面上。",
      "token_start": 1146,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 363040,
      "end_ms": 366240,
      "text": "事后核对爆炸结果和计划分毫不差。",
      "token_start": 1186,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 366720,
      "end_ms": 368155,
      "text": "敌人就算想修，",
      "token_start": 1201,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 368680,
      "end_ms": 370145,
      "text": "短期也修不好。",
      "token_start": 1207,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 370930,
      "end_ms": 373775,
      "text": "大桥总工程处解散的当晚，",
      "token_start": 1213,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 374430,
      "end_ms": 376925,
      "text": "毛以生写下了十个字，",
      "token_start": 1224,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 377720,
      "end_ms": 378915,
      "text": "抗战必胜，",
      "token_start": 1233,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 379400,
      "end_ms": 382455,
      "text": "此乔必复他嫌不够，",
      "token_start": 1237,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 384130,
      "end_ms": 385210,
      "text": "又写了一首诗，",
      "token_start": 1245,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 385490,
      "end_ms": 389455,
      "text": "最后七个字是不负元桥不丈夫。",
      "token_start": 1251,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 390060,
      "end_ms": 392195,
      "text": "然后他干了最后一件事，",
      "token_start": 1264,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 392680,
      "end_ms": 396444,
      "text": "把剑桥的档案和图纸装了整整十四箱，",
      "token_start": 1274,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 396920,
      "end_ms": 399595,
      "text": "一路护送到后方桥可以炸，",
      "token_start": 1290,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 400040,
      "end_ms": 400885,
      "text": "图纸不能丢，",
      "token_start": 1301,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 401290,
      "end_ms": 402565,
      "text": "那是富桥的种子。",
      "token_start": 1306,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 403300,
      "end_ms": 404195,
      "text": "很多人问，",
      "token_start": 1313,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 404610,
      "end_ms": 407985,
      "text": "毛以生毁掉自己一生的心血值吗？",
      "token_start": 1317,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 408550,
      "end_ms": 409985,
      "text": "他自己早就回答了，",
      "token_start": 1331,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 410960,
      "end_ms": 412745,
      "text": "剑桥是为了争气，",
      "token_start": 1339,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 413120,
      "end_ms": 415820,
      "text": "炸桥是为了胜利桥炸了，",
      "token_start": 1346,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 415820,
      "end_ms": 416595,
      "text": "可以再修，",
      "token_start": 1356,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 416990,
      "end_ms": 417710,
      "text": "国家没了，",
      "token_start": 1360,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 417710,
      "end_ms": 418715,
      "text": "就什么都没了。",
      "token_start": 1364,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 419690,
      "end_ms": 421730,
      "text": "毛以生亲自炸掉，",
      "token_start": 1370,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 421730,
      "end_ms": 426180,
      "text": "自己心血的故事就写在国之脊梁。",
      "token_start": 1377,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 426240,
      "end_ms": 427005,
      "text": "这本书里，",
      "token_start": 1391,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 427650,
      "end_ms": 429050,
      "text": "书里还有四十多位，",
      "token_start": 1395,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 429050,
      "end_ms": 430030,
      "text": "像他这样的人，",
      "token_start": 1403,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 430050,
      "end_ms": 433585,
      "text": "每一位讲出来都能让你红着眼眶看完。",
      "token_start": 1409,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 434230,
      "end_ms": 437225,
      "text": "但这座桥的传奇才到一半，",
      "token_start": 1425,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 437710,
      "end_ms": 439985,
      "text": "你以为炸完就结束了？",
      "token_start": 1436,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 440960,
      "end_ms": 446165,
      "text": "接下来发生的事更狠下一集。",
      "token_start": 1445,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 446520,
      "end_ms": 448785,
      "text": "毛以生系列第二集，",
      "token_start": 1457,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 449570,
      "end_ms": 450395,
      "text": "这座桥，",
      "token_start": 1465,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 450830,
      "end_ms": 453335,
      "text": "前前后后被炸了四次，",
      "token_start": 1468,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 453870,
      "end_ms": 454930,
      "text": "谁都拆不掉，",
      "token_start": 1477,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 454930,
      "end_ms": 458015,
      "text": "他谁也没法真正拥有他。",
      "token_start": 1482,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 458760,
      "end_ms": 460455,
      "text": "如果你被这个故事打动了，",
      "token_start": 1492,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 460670,
      "end_ms": 461275,
      "text": "点个赞，",
      "token_start": 1503,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 461740,
      "end_ms": 462625,
      "text": "收藏起来，",
      "token_start": 1506,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 463570,
      "end_ms": 464185,
      "text": "关注我，",
      "token_start": 1510,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 464470,
      "end_ms": 466035,
      "text": "下一集更震撼。",
      "token_start": 1513,
      "token_end_exclusive": 1519
    }
  ],
