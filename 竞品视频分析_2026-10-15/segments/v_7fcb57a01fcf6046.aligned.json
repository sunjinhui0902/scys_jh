{
  "video_id": "v_7fcb57a01fcf6046",
  "duration_s": 587.425,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_7fcb57a01fcf6046.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_7fcb57a01fcf6046.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 640,
      "end_ms": 1340,
      "text": "你相信吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1500,
      "end_ms": 3680,
      "text": "中国最能挣钱的人不在上海，",
      "token_start": 4,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3680,
      "end_ms": 4380,
      "text": "不在深圳。",
      "token_start": 16,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4740,
      "end_ms": 7860,
      "text": "中国最牛的投资机构是合肥市政府。",
      "token_start": 20,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 8460,
      "end_ms": 9820,
      "text": "曾经没人看得上他，",
      "token_start": 35,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 9880,
      "end_ms": 11080,
      "text": "偏偏他最争气，",
      "token_start": 43,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 11580,
      "end_ms": 12460,
      "text": "你敢相信吗？",
      "token_start": 49,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 12500,
      "end_ms": 13220,
      "text": "一觉醒来，",
      "token_start": 54,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 13220,
      "end_ms": 16300,
      "text": "合肥凭空多了一点二万亿朱军，",
      "token_start": 58,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 16500,
      "end_ms": 18860,
      "text": "你知道这一点二万亿是个什么概念吗？",
      "token_start": 71,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 18980,
      "end_ms": 23880,
      "text": "相当于广州市小半年的GDP总和全国近三成的土地财政收入。",
      "token_start": 87,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 24000,
      "end_ms": 25500,
      "text": "过去是江浙沪皖，",
      "token_start": 112,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 25620,
      "end_ms": 26580,
      "text": "现在是皖，",
      "token_start": 119,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 26780,
      "end_ms": 30295,
      "text": "江浙沪安徽省的名字是由安庆和徽州组。",
      "token_start": 123,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 30810,
      "end_ms": 34210,
      "text": "原本安徽的省会是在安庆长江五湖之一，",
      "token_start": 140,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 34290,
      "end_ms": 36550,
      "text": "却因为战争导致城市严重受损，",
      "token_start": 157,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 36690,
      "end_ms": 38150,
      "text": "最后选择在了小县城。",
      "token_start": 170,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 38150,
      "end_ms": 38570,
      "text": "合肥。",
      "token_start": 179,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 38830,
      "end_ms": 39770,
      "text": "它既不临江，",
      "token_start": 181,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 39790,
      "end_ms": 40490,
      "text": "也不靠海，",
      "token_start": 186,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 40610,
      "end_ms": 42350,
      "text": "甚至并不算交通枢纽，",
      "token_start": 190,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 42770,
      "end_ms": 44150,
      "text": "总人口只有五六万，",
      "token_start": 199,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 44330,
      "end_ms": 47130,
      "text": "连隔壁的凤阳、小岗村都比它还要出名。",
      "token_start": 207,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 47350,
      "end_ms": 49050,
      "text": "论金融资本比不过上海，",
      "token_start": 223,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 49110,
      "end_ms": 50010,
      "text": "论民营经济，",
      "token_start": 233,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 50010,
      "end_ms": 50850,
      "text": "拼不过杭州，",
      "token_start": 238,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 51050,
      "end_ms": 52750,
      "text": "论外贸制造干不过无锡，",
      "token_start": 243,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 52870,
      "end_ms": 53550,
      "text": "论教育，",
      "token_start": 253,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 53550,
      "end_ms": 54910,
      "text": "科研拼不过南京，",
      "token_start": 256,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 55290,
      "end_ms": 57070,
      "text": "二十年前曾被人嘲笑，",
      "token_start": 263,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 57070,
      "end_ms": 59230,
      "text": "是中国最大的县城省会。",
      "token_start": 272,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 59570,
      "end_ms": 60400,
      "text": "如果不是一手，",
      "token_start": 282,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 60460,
      "end_ms": 61340,
      "text": "我歌泸州月，",
      "token_start": 288,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 61360,
      "end_ms": 63285,
      "text": "我都不知道合肥原来叫泸州，",
      "token_start": 293,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 63730,
      "end_ms": 70495,
      "text": "甚至很多人一直以为安徽的省会是南京憋屈的合肥十年寒窗一战成名。",
      "token_start": 305,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 70800,
      "end_ms": 72575,
      "text": "就在长兴敲钟的那一周，",
      "token_start": 335,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 72840,
      "end_ms": 74620,
      "text": "韩国股市连跌五天，",
      "token_start": 345,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 74960,
      "end_ms": 77305,
      "text": "美国的科技股一周跌了将近百分之八。",
      "token_start": 353,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 77800,
      "end_ms": 78880,
      "text": "这一个项目的回报，",
      "token_start": 369,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 78880,
      "end_ms": 80495,
      "text": "顶了合肥一整年的GDP,",
      "token_start": 377,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 80910,
      "end_ms": 83715,
      "text": "合肥改命最厉害的东西叫长期主义。",
      "token_start": 386,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 84150,
      "end_ms": 84930,
      "text": "二零零八年，",
      "token_start": 401,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 85090,
      "end_ms": 86535,
      "text": "全球金融危机爆发，",
      "token_start": 406,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 86790,
      "end_ms": 88010,
      "text": "京东方走投无路，",
      "token_start": 414,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 88170,
      "end_ms": 91310,
      "text": "合肥拿出全市三分之一的财政收入砸进京，",
      "token_start": 421,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 91310,
      "end_ms": 92535,
      "text": "东方做液晶面板，",
      "token_start": 439,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 92830,
      "end_ms": 94965,
      "text": "二零二零年未来资金链断裂，",
      "token_start": 446,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 95180,
      "end_ms": 95875,
      "text": "濒临倒闭。",
      "token_start": 458,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 96150,
      "end_ms": 97310,
      "text": "合肥雪中送炭，",
      "token_start": 462,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 97310,
      "end_ms": 98650,
      "text": "投了一百亿救命钱，",
      "token_start": 468,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 98650,
      "end_ms": 99555,
      "text": "拉了未来一把。",
      "token_start": 476,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 99790,
      "end_ms": 101470,
      "text": "刚投资完整个新能源，",
      "token_start": 482,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 101470,
      "end_ms": 102985,
      "text": "汽车行业开始起飞。",
      "token_start": 491,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 103370,
      "end_ms": 103770,
      "text": "现在，",
      "token_start": 499,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 103770,
      "end_ms": 106205,
      "text": "合肥的新能源汽车产量占全国第一，",
      "token_start": 501,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 106560,
      "end_ms": 107260,
      "text": "二零一六年，",
      "token_start": 516,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 107400,
      "end_ms": 112155,
      "text": "全球存储芯片的百分之九十六的市场被美韩三大巨头垄断。",
      "token_start": 521,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 112460,
      "end_ms": 114265,
      "text": "中国自主产能几乎为零，",
      "token_start": 546,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 114520,
      "end_ms": 115565,
      "text": "长兴要搞芯片，",
      "token_start": 556,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 115850,
      "end_ms": 118555,
      "text": "合肥掏出了全市财政收入的四分之一。",
      "token_start": 562,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 118900,
      "end_ms": 122215,
      "text": "长兴成立的前六年累计亏掉三百六十六亿，",
      "token_start": 578,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 122420,
      "end_ms": 124020,
      "text": "但合肥无怨无悔，",
      "token_start": 596,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 124020,
      "end_ms": 125305,
      "text": "陪跑了整整十年。",
      "token_start": 603,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 125980,
      "end_ms": 128150,
      "text": "合肥奇迹的真相是后代，",
      "token_start": 610,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 128170,
      "end_ms": 130335,
      "text": "读书人的城市永远不会输。",
      "token_start": 620,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 130690,
      "end_ms": 133150,
      "text": "合肥真正押重的并不只是几家公司，",
      "token_start": 631,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 133350,
      "end_ms": 135595,
      "text": "而是知识产业和时间，",
      "token_start": 646,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 135970,
      "end_ms": 137690,
      "text": "它最难复制的也不是投钱，",
      "token_start": 655,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 137950,
      "end_ms": 139390,
      "text": "而是前人栽树，",
      "token_start": 666,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 139390,
      "end_ms": 141545,
      "text": "后人不拔树继续浇水。",
      "token_start": 672,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 141900,
      "end_ms": 144845,
      "text": "合肥真正的逆袭之路得从一所大学开始。",
      "token_start": 681,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 145170,
      "end_ms": 145830,
      "text": "一九六九年，",
      "token_start": 698,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 145830,
      "end_ms": 147925,
      "text": "中国科学技术大学从北京外迁，",
      "token_start": 703,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 148200,
      "end_ms": 150515,
      "text": "当时河南、江西、湖北都说养不起，",
      "token_start": 716,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 150820,
      "end_ms": 154355,
      "text": "只有安徽合肥砸锅卖铁把中科大接回了家。",
      "token_start": 729,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 155070,
      "end_ms": 155870,
      "text": "一九七零年，",
      "token_start": 747,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 155870,
      "end_ms": 157575,
      "text": "中科大正式迁入合肥，",
      "token_start": 752,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 157850,
      "end_ms": 161975,
      "text": "搬来了三万五千多箱的仪器和图书和六千多名师生。",
      "token_start": 761,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 162290,
      "end_ms": 163290,
      "text": "合肥没有暖气，",
      "token_start": 783,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 163430,
      "end_ms": 166525,
      "text": "却为北方来的师生们铺设了全市第一条供暖线。",
      "token_start": 789,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 167130,
      "end_ms": 168370,
      "text": "合肥最穷的时候，",
      "token_start": 809,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 168450,
      "end_ms": 169670,
      "text": "市政府可以停电，",
      "token_start": 816,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 169690,
      "end_ms": 171325,
      "text": "但中科大绝不能停电。",
      "token_start": 823,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 171690,
      "end_ms": 174365,
      "text": "全城所有的粮食优先给到中科大，",
      "token_start": 832,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 174780,
      "end_ms": 176260,
      "text": "每人每天省下一口粮，",
      "token_start": 846,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 176360,
      "end_ms": 178585,
      "text": "也一定要让中科大的师生吃饱。",
      "token_start": 855,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 178870,
      "end_ms": 180890,
      "text": "在那个物质极度匮乏的年代，",
      "token_start": 868,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 180890,
      "end_ms": 182650,
      "text": "一座又小又穷的城市，",
      "token_start": 880,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 182770,
      "end_ms": 183730,
      "text": "倾其所有，",
      "token_start": 889,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 183810,
      "end_ms": 186075,
      "text": "把一所流浪的大学揽入怀中，",
      "token_start": 893,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 186480,
      "end_ms": 188805,
      "text": "这是一座城市对于知识最大的敬意。",
      "token_start": 905,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 189560,
      "end_ms": 190760,
      "text": "半个多世纪过去了，",
      "token_start": 920,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 190760,
      "end_ms": 194500,
      "text": "这颗当年被合肥小心翼翼种下的种子生根开花，",
      "token_start": 928,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 194700,
      "end_ms": 196840,
      "text": "成为合肥发展最坚实的人才。",
      "token_start": 948,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 196840,
      "end_ms": 200255,
      "text": "底座千生一愿是百人一结清，",
      "token_start": 960,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 200690,
      "end_ms": 201390,
      "text": "号称AI,",
      "token_start": 972,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 201390,
      "end_ms": 204405,
      "text": "黄埔军校撑起了人工智能国内的半边天。",
      "token_start": 975,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 204910,
      "end_ms": 206390,
      "text": "清华北大出天才，",
      "token_start": 992,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 206450,
      "end_ms": 207915,
      "text": "而中科大出神仙，",
      "token_start": 999,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 208630,
      "end_ms": 212150,
      "text": "火星探测天问一号深海探测东风导弹的背后，",
      "token_start": 1006,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 212230,
      "end_ms": 213475,
      "text": "都有柯大人的影子。",
      "token_start": 1025,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 213960,
      "end_ms": 216315,
      "text": "哪个丈母娘不希望找一个中科大的女婿？",
      "token_start": 1033,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 216610,
      "end_ms": 218690,
      "text": "一个国家如果没有自己的存储芯片，",
      "token_start": 1050,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 218890,
      "end_ms": 221575,
      "text": "就是把数字时代的饭碗端在别人手里。",
      "token_start": 1065,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 221800,
      "end_ms": 224295,
      "text": "而长兴更给了全中国人以底气。",
      "token_start": 1081,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 224760,
      "end_ms": 225660,
      "text": "如果没有安徽，",
      "token_start": 1094,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 225720,
      "end_ms": 227240,
      "text": "就没有江浙沪的繁华，",
      "token_start": 1100,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 227320,
      "end_ms": 229630,
      "text": "没有国泰民安的守护你，",
      "token_start": 1109,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 229630,
      "end_ms": 232085,
      "text": "知道为什么安徽总是感觉很穷吗？",
      "token_start": 1119,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 232370,
      "end_ms": 235555,
      "text": "是因为安徽的抗日要比其他省份提前了几十年。",
      "token_start": 1133,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 235900,
      "end_ms": 237945,
      "text": "中国抗日战争从九一八开始，",
      "token_start": 1153,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 238240,
      "end_ms": 240975,
      "text": "而安徽人的抗日从甲午战争就开始。",
      "token_start": 1165,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 241410,
      "end_ms": 242895,
      "text": "一八九四年甲午海战，",
      "token_start": 1180,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 243110,
      "end_ms": 245545,
      "text": "李鸿章的淮军撑起了北洋水师，",
      "token_start": 1189,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 245880,
      "end_ms": 246680,
      "text": "舰上的兵将，",
      "token_start": 1202,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 246700,
      "end_ms": 248225,
      "text": "几乎全是江淮子弟。",
      "token_start": 1207,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 248640,
      "end_ms": 249740,
      "text": "安徽人一省战，",
      "token_start": 1215,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 249740,
      "end_ms": 251720,
      "text": "一国与日寇展开殊死搏斗，",
      "token_start": 1221,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 251720,
      "end_ms": 252915,
      "text": "最终全部牺牲。",
      "token_start": 1232,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 253260,
      "end_ms": 253960,
      "text": "抗战期间，",
      "token_start": 1238,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 254120,
      "end_ms": 255140,
      "text": "安徽打没了，",
      "token_start": 1242,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 255140,
      "end_ms": 258880,
      "text": "整整一代人打到十室九空打到山穷水尽，",
      "token_start": 1247,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 258980,
      "end_ms": 261475,
      "text": "最终无奈组建了中国第一支孤儿军，",
      "token_start": 1264,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 262010,
      "end_ms": 263670,
      "text": "全国二点九万个历史陵园，",
      "token_start": 1279,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 263670,
      "end_ms": 265045,
      "text": "安徽就占了二点二万。",
      "token_start": 1290,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 265670,
      "end_ms": 266990,
      "text": "安徽之所以吃米，",
      "token_start": 1299,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 266990,
      "end_ms": 267570,
      "text": "也吃面，",
      "token_start": 1306,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 267630,
      "end_ms": 268470,
      "text": "十里不同音，",
      "token_start": 1309,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 268470,
      "end_ms": 269355,
      "text": "百里不同俗。",
      "token_start": 1314,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 269610,
      "end_ms": 272285,
      "text": "就是因为安徽人后来汇聚了五湖四海的兄弟，",
      "token_start": 1319,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 272490,
      "end_ms": 273785,
      "text": "组成现在的安徽。",
      "token_start": 1338,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 274410,
      "end_ms": 276630,
      "text": "如今的安徽又承担着泄洪使命，",
      "token_start": 1345,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 276710,
      "end_ms": 278945,
      "text": "是全国泄洪区最多的省份。",
      "token_start": 1358,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 279280,
      "end_ms": 280695,
      "text": "二零二一年的河南大水，",
      "token_start": 1369,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 280950,
      "end_ms": 281270,
      "text": "郑州，",
      "token_start": 1379,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 281270,
      "end_ms": 283735,
      "text": "一小时的降水量相当于一百五十个西湖。",
      "token_start": 1381,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 284220,
      "end_ms": 286555,
      "text": "这洪水从郑州退去以后去哪儿了？",
      "token_start": 1398,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 286740,
      "end_ms": 287855,
      "text": "大部分到了安徽，",
      "token_start": 1412,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 288190,
      "end_ms": 291015,
      "text": "当时安徽自己有将近四百万人受灾，",
      "token_start": 1419,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 291280,
      "end_ms": 292680,
      "text": "但是为了上保河南，",
      "token_start": 1434,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 292700,
      "end_ms": 293760,
      "text": "下保江浙沪，",
      "token_start": 1442,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 293940,
      "end_ms": 295965,
      "text": "安徽默默捂着自己的伤口。",
      "token_start": 1447,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 296290,
      "end_ms": 300510,
      "text": "开闸泄洪王家坝的村民放弃了自己辛苦建起来的房子，",
      "token_start": 1458,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 300630,
      "end_ms": 302310,
      "text": "放弃了种满粮食的土地，",
      "token_start": 1481,
      "token_end_exclusive": 1491
    },
    {
      "start_ms": 302490,
      "end_ms": 303450,
      "text": "连夜转移。",
      "token_start": 1491,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 303590,
      "end_ms": 304510,
      "text": "而这样的牺牲，",
      "token_start": 1495,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 304630,
      "end_ms": 306550,
      "text": "安徽建国以来做了十多次，",
      "token_start": 1501,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 306790,
      "end_ms": 308230,
      "text": "舍小家为大家，",
      "token_start": 1512,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 308410,
      "end_ms": 310330,
      "text": "为饱城市自毁家乡，",
      "token_start": 1518,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 310450,
      "end_ms": 315530,
      "text": "是安徽人扛下了所有滚滚逝去的洪水里藏着安徽人的泪水。",
      "token_start": 1526,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 315870,
      "end_ms": 316650,
      "text": "总有人调侃，",
      "token_start": 1551,
      "token_end_exclusive": 1556
    },
    {
      "start_ms": 316650,
      "end_ms": 317330,
      "text": "安徽很穷，",
      "token_start": 1556,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 317490,
      "end_ms": 318510,
      "text": "遍地是乞丐。",
      "token_start": 1560,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 318750,
      "end_ms": 319110,
      "text": "可是，",
      "token_start": 1565,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 319110,
      "end_ms": 319470,
      "text": "诸君，",
      "token_start": 1567,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 319710,
      "end_ms": 321430,
      "text": "中国四大商帮之一，",
      "token_start": 1569,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 321430,
      "end_ms": 323550,
      "text": "鼎鼎有名的徽商怎么会穷，",
      "token_start": 1577,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 323930,
      "end_ms": 327000,
      "text": "不过是把满腔热血献给了最爱的祖国？",
      "token_start": 1588,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 327420,
      "end_ms": 328360,
      "text": "安徽人委屈，",
      "token_start": 1604,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 328500,
      "end_ms": 330760,
      "text": "但安徽人从来不说中国。",
      "token_start": 1609,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 330760,
      "end_ms": 336740,
      "text": "第一台蒸汽机、第一台卫星计算机、第一台电冰箱、第一艘电动船都在安徽诞生。",
      "token_start": 1619,
      "token_end_exclusive": 1651
    },
    {
      "start_ms": 337020,
      "end_ms": 339560,
      "text": "安徽省高铁总里程全国第一，",
      "token_start": 1651,
      "token_end_exclusive": 1663
    },
    {
      "start_ms": 339720,
      "end_ms": 341900,
      "text": "汽车整车出口量全国第一，",
      "token_start": 1663,
      "token_end_exclusive": 1674
    },
    {
      "start_ms": 341940,
      "end_ms": 344040,
      "text": "液晶显示屏产量全国第一。",
      "token_start": 1674,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 344260,
      "end_ms": 347520,
      "text": "冰箱、空调、洗衣机产量都是全国第一，",
      "token_start": 1685,
      "token_end_exclusive": 1700
    },
    {
      "start_ms": 347640,
      "end_ms": 351100,
      "text": "而量子科技专利更是全球前二全国第一，",
      "token_start": 1700,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 351460,
      "end_ms": 354580,
      "text": "全球百分之十的笔记本电脑都是安徽生产。",
      "token_start": 1717,
      "token_end_exclusive": 1735
    },
    {
      "start_ms": 355080,
      "end_ms": 356055,
      "text": "更让人感动的是，",
      "token_start": 1735,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 356410,
      "end_ms": 357850,
      "text": "好不容易富起来的合肥，",
      "token_start": 1742,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 357990,
      "end_ms": 359475,
      "text": "也从来不吃独食，",
      "token_start": 1752,
      "token_end_exclusive": 1759
    },
    {
      "start_ms": 359800,
      "end_ms": 361485,
      "text": "从不忘给兄弟们分一杯羹。",
      "token_start": 1759,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 361860,
      "end_ms": 362520,
      "text": "它做新能源，",
      "token_start": 1770,
      "token_end_exclusive": 1775
    },
    {
      "start_ms": 362520,
      "end_ms": 365300,
      "text": "整车芜湖搞传统车升级安庆，",
      "token_start": 1775,
      "token_end_exclusive": 1787
    },
    {
      "start_ms": 365360,
      "end_ms": 367260,
      "text": "做车灯、六安做储能，",
      "token_start": 1787,
      "token_end_exclusive": 1795
    },
    {
      "start_ms": 367440,
      "end_ms": 370325,
      "text": "宣城负责上游原材料马鞍山做电池，",
      "token_start": 1795,
      "token_end_exclusive": 1810
    },
    {
      "start_ms": 370650,
      "end_ms": 372815,
      "text": "安徽十六个地市全部上出，",
      "token_start": 1810,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 373060,
      "end_ms": 373835,
      "text": "没有一个掉队。",
      "token_start": 1821,
      "token_end_exclusive": 1827
    },
    {
      "start_ms": 374210,
      "end_ms": 376750,
      "text": "诸晶合肥模式不能被简化，",
      "token_start": 1827,
      "token_end_exclusive": 1838
    },
    {
      "start_ms": 376750,
      "end_ms": 378895,
      "text": "成地方政府都去压龙头。",
      "token_start": 1838,
      "token_end_exclusive": 1848
    },
    {
      "start_ms": 379110,
      "end_ms": 384635,
      "text": "他背后是有中科大科学岛国家科学中心工程教育与既有制造业，",
      "token_start": 1848,
      "token_end_exclusive": 1875
    },
    {
      "start_ms": 384970,
      "end_ms": 387715,
      "text": "也有专业国资平台和跨任期的连续性。",
      "token_start": 1875,
      "token_end_exclusive": 1891
    },
    {
      "start_ms": 388190,
      "end_ms": 390325,
      "text": "如果没有技术判断和产业配套，",
      "token_start": 1891,
      "token_end_exclusive": 1904
    },
    {
      "start_ms": 390530,
      "end_ms": 393665,
      "text": "只学大手笔投钱复制出来的可能不是合肥，",
      "token_start": 1904,
      "token_end_exclusive": 1922
    },
    {
      "start_ms": 393880,
      "end_ms": 394505,
      "text": "而是债务。",
      "token_start": 1922,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 395190,
      "end_ms": 396905,
      "text": "你看看合肥官方怎么说，",
      "token_start": 1926,
      "token_end_exclusive": 1936
    },
    {
      "start_ms": 397230,
      "end_ms": 398150,
      "text": "我们不是风投，",
      "token_start": 1936,
      "token_end_exclusive": 1942
    },
    {
      "start_ms": 398330,
      "end_ms": 399090,
      "text": "是铲投，",
      "token_start": 1942,
      "token_end_exclusive": 1945
    },
    {
      "start_ms": 399330,
      "end_ms": 400175,
      "text": "不是赌博，",
      "token_start": 1945,
      "token_end_exclusive": 1949
    },
    {
      "start_ms": 400430,
      "end_ms": 401085,
      "text": "是拼搏。",
      "token_start": 1949,
      "token_end_exclusive": 1952
    },
    {
      "start_ms": 401460,
      "end_ms": 402460,
      "text": "更让人敬佩的是，",
      "token_start": 1952,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 402520,
      "end_ms": 405610,
      "text": "合肥国资的胸怀与格局掏了几百亿，",
      "token_start": 1959,
      "token_end_exclusive": 1974
    },
    {
      "start_ms": 405710,
      "end_ms": 407035,
      "text": "却是投而不控，",
      "token_start": 1974,
      "token_end_exclusive": 1980
    },
    {
      "start_ms": 407500,
      "end_ms": 408420,
      "text": "不抢控制权，",
      "token_start": 1980,
      "token_end_exclusive": 1985
    },
    {
      "start_ms": 408460,
      "end_ms": 409395,
      "text": "不插手经营，",
      "token_start": 1985,
      "token_end_exclusive": 1990
    },
    {
      "start_ms": 409600,
      "end_ms": 410765,
      "text": "不往董事会塞人，",
      "token_start": 1990,
      "token_end_exclusive": 1997
    },
    {
      "start_ms": 411060,
      "end_ms": 413540,
      "text": "这才是对专业主义精神的最大的尊重。",
      "token_start": 1997,
      "token_end_exclusive": 2013
    },
    {
      "start_ms": 413780,
      "end_ms": 417105,
      "text": "这也就是为什么没有任何城市能够复制合肥模式。",
      "token_start": 2013,
      "token_end_exclusive": 2034
    },
    {
      "start_ms": 417420,
      "end_ms": 420845,
      "text": "合肥真正押中的第一张王牌并不是某家公司，",
      "token_start": 2034,
      "token_end_exclusive": 2053
    },
    {
      "start_ms": 421120,
      "end_ms": 421745,
      "text": "而是知识。",
      "token_start": 2053,
      "token_end_exclusive": 2057
    },
    {
      "start_ms": 422170,
      "end_ms": 424905,
      "text": "他还为阅读这种慢事留下了空间。",
      "token_start": 2057,
      "token_end_exclusive": 2071
    },
    {
      "start_ms": 425270,
      "end_ms": 430775,
      "text": "合肥被称为高阅读城市密集的建设城市阅读空间和十五分钟的阅读圈。",
      "token_start": 2071,
      "token_end_exclusive": 2101
    },
    {
      "start_ms": 431150,
      "end_ms": 433615,
      "text": "一间公共书房并不能直接制造GDP,",
      "token_start": 2101,
      "token_end_exclusive": 2115
    },
    {
      "start_ms": 433890,
      "end_ms": 435095,
      "text": "但他会告诉年轻人，",
      "token_start": 2115,
      "token_end_exclusive": 2123
    },
    {
      "start_ms": 435390,
      "end_ms": 439280,
      "text": "这座城市愿意为一个人安静坐下来的时间买单，",
      "token_start": 2123,
      "token_end_exclusive": 2143
    },
    {
      "start_ms": 439480,
      "end_ms": 442245,
      "text": "而这也是合肥模式最容易被人忽视的细节。",
      "token_start": 2143,
      "token_end_exclusive": 2161
    },
    {
      "start_ms": 442610,
      "end_ms": 444510,
      "text": "网上喜欢说他出手果断，",
      "token_start": 2161,
      "token_end_exclusive": 2171
    },
    {
      "start_ms": 444670,
      "end_ms": 446925,
      "text": "却很少说他为何判断得出。",
      "token_start": 2171,
      "token_end_exclusive": 2182
    },
    {
      "start_ms": 447320,
      "end_ms": 448480,
      "text": "喜欢说他敢砸钱，",
      "token_start": 2182,
      "token_end_exclusive": 2189
    },
    {
      "start_ms": 448700,
      "end_ms": 455570,
      "text": "却很少说知识、科研、工程、教育和产业调查才是钱不至于变成烟花的底层结构。",
      "token_start": 2189,
      "token_end_exclusive": 2221
    },
    {
      "start_ms": 455750,
      "end_ms": 458365,
      "text": "合肥是真正靠读书改变命运。",
      "token_start": 2221,
      "token_end_exclusive": 2233
    },
    {
      "start_ms": 458850,
      "end_ms": 460120,
      "text": "朱军这世上，",
      "token_start": 2233,
      "token_end_exclusive": 2238
    },
    {
      "start_ms": 460120,
      "end_ms": 462315,
      "text": "哪有什么点石成金的风头神话。",
      "token_start": 2238,
      "token_end_exclusive": 2251
    },
    {
      "start_ms": 462700,
      "end_ms": 463940,
      "text": "长兴上市的钟声，",
      "token_start": 2251,
      "token_end_exclusive": 2258
    },
    {
      "start_ms": 464100,
      "end_ms": 466535,
      "text": "不过是时间给合肥的一封回信。",
      "token_start": 2258,
      "token_end_exclusive": 2271
    },
    {
      "start_ms": 466900,
      "end_ms": 468040,
      "text": "那是五十六年前，",
      "token_start": 2271,
      "token_end_exclusive": 2278
    },
    {
      "start_ms": 468060,
      "end_ms": 473275,
      "text": "合肥用砸锅卖铁的制成为军学者保留下来了一张温暖的书桌。",
      "token_start": 2278,
      "token_end_exclusive": 2304
    },
    {
      "start_ms": 473580,
      "end_ms": 474280,
      "text": "那是厂房，",
      "token_start": 2304,
      "token_end_exclusive": 2308
    },
    {
      "start_ms": 474280,
      "end_ms": 475745,
      "text": "机器二十四小时运转，",
      "token_start": 2308,
      "token_end_exclusive": 2317
    },
    {
      "start_ms": 476010,
      "end_ms": 478730,
      "text": "一群穿着无尘服的人看不见风景，",
      "token_start": 2317,
      "token_end_exclusive": 2331
    },
    {
      "start_ms": 478830,
      "end_ms": 479990,
      "text": "却在制造未来。",
      "token_start": 2331,
      "token_end_exclusive": 2337
    },
    {
      "start_ms": 480350,
      "end_ms": 481370,
      "text": "五十六年之后，",
      "token_start": 2337,
      "token_end_exclusive": 2343
    },
    {
      "start_ms": 481550,
      "end_ms": 483770,
      "text": "对知识的后代和技术的尊重，",
      "token_start": 2343,
      "token_end_exclusive": 2355
    },
    {
      "start_ms": 484030,
      "end_ms": 485310,
      "text": "反哺了这座城市，",
      "token_start": 2355,
      "token_end_exclusive": 2362
    },
    {
      "start_ms": 485770,
      "end_ms": 488130,
      "text": "而你以为这就是合肥的极限了吗？",
      "token_start": 2362,
      "token_end_exclusive": 2376
    },
    {
      "start_ms": 488350,
      "end_ms": 491530,
      "text": "合肥的手里还握着一张震撼世界的终极王牌，",
      "token_start": 2376,
      "token_end_exclusive": 2395
    },
    {
      "start_ms": 491830,
      "end_ms": 493030,
      "text": "可控核聚变。",
      "token_start": 2395,
      "token_end_exclusive": 2400
    },
    {
      "start_ms": 493390,
      "end_ms": 495430,
      "text": "从东方超环屡破世界纪录，",
      "token_start": 2400,
      "token_end_exclusive": 2411
    },
    {
      "start_ms": 495490,
      "end_ms": 497350,
      "text": "到跨府大科学装置，",
      "token_start": 2411,
      "token_end_exclusive": 2419
    },
    {
      "start_ms": 497370,
      "end_ms": 498370,
      "text": "破译核心部件，",
      "token_start": 2419,
      "token_end_exclusive": 2425
    },
    {
      "start_ms": 498610,
      "end_ms": 500570,
      "text": "再到人造太阳装置冲刺，",
      "token_start": 2425,
      "token_end_exclusive": 2435
    },
    {
      "start_ms": 500650,
      "end_ms": 502910,
      "text": "点亮人类第一盏聚变之灯。",
      "token_start": 2435,
      "token_end_exclusive": 2446
    },
    {
      "start_ms": 503330,
      "end_ms": 506360,
      "text": "全国百分之三十七的核聚变专利都在合肥，",
      "token_start": 2446,
      "token_end_exclusive": 2464
    },
    {
      "start_ms": 506620,
      "end_ms": 509520,
      "text": "这里正在孕育属于全人类的能源未来。",
      "token_start": 2464,
      "token_end_exclusive": 2480
    },
    {
      "start_ms": 509920,
      "end_ms": 511980,
      "text": "从当年毫无优势的中部城市，",
      "token_start": 2480,
      "token_end_exclusive": 2492
    },
    {
      "start_ms": 512040,
      "end_ms": 514960,
      "text": "到如今一战封神的直逼全国第四城，",
      "token_start": 2492,
      "token_end_exclusive": 2507
    },
    {
      "start_ms": 515240,
      "end_ms": 518440,
      "text": "合肥不追风口、不赚快钱、不炒概念，",
      "token_start": 2507,
      "token_end_exclusive": 2521
    },
    {
      "start_ms": 518740,
      "end_ms": 519880,
      "text": "所年如一日，",
      "token_start": 2521,
      "token_end_exclusive": 2526
    },
    {
      "start_ms": 520020,
      "end_ms": 521080,
      "text": "倾一城之力，",
      "token_start": 2526,
      "token_end_exclusive": 2531
    },
    {
      "start_ms": 521200,
      "end_ms": 523820,
      "text": "托举属于中国的科技巨头企业，",
      "token_start": 2531,
      "token_end_exclusive": 2544
    },
    {
      "start_ms": 523820,
      "end_ms": 527300,
      "text": "在熬城市也在熬熬过了周期低谷，",
      "token_start": 2544,
      "token_end_exclusive": 2558
    },
    {
      "start_ms": 527400,
      "end_ms": 528560,
      "text": "熬过了技术封锁。",
      "token_start": 2558,
      "token_end_exclusive": 2565
    },
    {
      "start_ms": 528740,
      "end_ms": 531060,
      "text": "终于迎来了万物复苏的收获期。",
      "token_start": 2565,
      "token_end_exclusive": 2578
    },
    {
      "start_ms": 531380,
      "end_ms": 534920,
      "text": "所有的爆发都是折伏后的必然为合肥骄傲，",
      "token_start": 2578,
      "token_end_exclusive": 2596
    },
    {
      "start_ms": 534920,
      "end_ms": 536875,
      "text": "为中国硬科技点赞。",
      "token_start": 2596,
      "token_end_exclusive": 2604
    },
    {
      "start_ms": 537440,
      "end_ms": 538760,
      "text": "回望合肥这座城，",
      "token_start": 2604,
      "token_end_exclusive": 2611
    },
    {
      "start_ms": 538780,
      "end_ms": 541685,
      "text": "你会发现他几乎一直在做合这件事儿。",
      "token_start": 2611,
      "token_end_exclusive": 2627
    },
    {
      "start_ms": 541980,
      "end_ms": 544085,
      "text": "它让长江与淮河相合，",
      "token_start": 2627,
      "token_end_exclusive": 2636
    },
    {
      "start_ms": 544430,
      "end_ms": 547235,
      "text": "让北方的刚劲与南方的细腻相合，",
      "token_start": 2636,
      "token_end_exclusive": 2650
    },
    {
      "start_ms": 547560,
      "end_ms": 550205,
      "text": "让古老的泸州与现代科创相合，",
      "token_start": 2650,
      "token_end_exclusive": 2663
    },
    {
      "start_ms": 550460,
      "end_ms": 553105,
      "text": "让一座大学与一座城相合。",
      "token_start": 2663,
      "token_end_exclusive": 2674
    },
    {
      "start_ms": 553750,
      "end_ms": 554490,
      "text": "三国时代，",
      "token_start": 2674,
      "token_end_exclusive": 2678
    },
    {
      "start_ms": 554650,
      "end_ms": 557070,
      "text": "合肥守住的是曹魏东南的一道门。",
      "token_start": 2678,
      "token_end_exclusive": 2692
    },
    {
      "start_ms": 557250,
      "end_ms": 561265,
      "text": "而今天他打开的是中国硬科创未来的一扇门。",
      "token_start": 2692,
      "token_end_exclusive": 2711
    },
    {
      "start_ms": 561670,
      "end_ms": 564565,
      "text": "所以驻军合肥到底肥在哪里？",
      "token_start": 2711,
      "token_end_exclusive": 2723
    },
    {
      "start_ms": 565090,
      "end_ms": 566770,
      "text": "他不是肥在天生富足，",
      "token_start": 2723,
      "token_end_exclusive": 2732
    },
    {
      "start_ms": 566770,
      "end_ms": 567890,
      "text": "而是肥在胆识，",
      "token_start": 2732,
      "token_end_exclusive": 2738
    },
    {
      "start_ms": 567910,
      "end_ms": 568765,
      "text": "肥在耐心。",
      "token_start": 2738,
      "token_end_exclusive": 2742
    },
    {
      "start_ms": 569010,
      "end_ms": 570725,
      "text": "一座城市最伟大的逆袭，",
      "token_start": 2742,
      "token_end_exclusive": 2752
    },
    {
      "start_ms": 570970,
      "end_ms": 572165,
      "text": "不是终于被人看见，",
      "token_start": 2752,
      "token_end_exclusive": 2760
    },
    {
      "start_ms": 572510,
      "end_ms": 574290,
      "text": "而是他当年在无人看见时，",
      "token_start": 2760,
      "token_end_exclusive": 2771
    },
    {
      "start_ms": 574290,
      "end_ms": 577265,
      "text": "仍然愿意把钱、时间和信任交给明天。",
      "token_start": 2771,
      "token_end_exclusive": 2786
    },
    {
      "start_ms": 577680,
      "end_ms": 579180,
      "text": "这座城市从来不信风口，",
      "token_start": 2786,
      "token_end_exclusive": 2796
    },
    {
      "start_ms": 579340,
      "end_ms": 580355,
      "text": "它只信一件事，",
      "token_start": 2796,
      "token_end_exclusive": 2802
    },
    {
      "start_ms": 580720,
      "end_ms": 582400,
      "text": "把种子埋进土里，",
      "token_start": 2802,
      "token_end_exclusive": 2809
    },
    {
      "start_ms": 582440,
      "end_ms": 583340,
      "text": "浇十年水，",
      "token_start": 2809,
      "token_end_exclusive": 2813
    },
    {
      "start_ms": 583460,
      "end_ms": 584640,
      "text": "等它自己长出来。",
      "token_start": 2813,
      "token_end_exclusive": 2820
    },
    {
      "start_ms": 584760,
      "end_ms": 587015,
      "text": "而这才是真正的合肥。",
      "token_start": 2820,
      "token_end_exclusive": 2829
    }
  ],
