{
  "video_id": "v_5ddb5a8ad7ccdb86",
  "duration_s": 514.996009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_5ddb5a8ad7ccdb86.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_5ddb5a8ad7ccdb86.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 710,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 730,
      "end_ms": 1430,
      "text": "咱们盘了。",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1430,
      "end_ms": 2490,
      "text": "第十到第六，",
      "token_start": 6,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2950,
      "end_ms": 5250,
      "text": "海南环岛把冬天甩在身后，",
      "token_start": 11,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5890,
      "end_ms": 10090,
      "text": "皖南环线在徽州长卷里翻甘南环线，",
      "token_start": 22,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 10110,
      "end_ms": 13990,
      "text": "把西藏搬到了甘肃滇西北环线，",
      "token_start": 37,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 14170,
      "end_ms": 16190,
      "text": "把云南四季过一遍。",
      "token_start": 50,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 16610,
      "end_ms": 19670,
      "text": "青海大环线把历史和风景串成圈。",
      "token_start": 58,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 20210,
      "end_ms": 22770,
      "text": "好多朋友看完在评论区炒翻了。",
      "token_start": 72,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 23190,
      "end_ms": 26850,
      "text": "有人说川藏线呢北疆环线呢，",
      "token_start": 85,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 27030,
      "end_ms": 28530,
      "text": "呼伦贝尔环线了。",
      "token_start": 97,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 30060,
      "end_ms": 30420,
      "text": "别急，",
      "token_start": 104,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 30960,
      "end_ms": 33520,
      "text": "今天这集就是第五道第一，",
      "token_start": 106,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 34060,
      "end_ms": 37840,
      "text": "一条比一条震撼川藏线排第四。",
      "token_start": 117,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 38480,
      "end_ms": 40760,
      "text": "最后那个从成都出发，",
      "token_start": 130,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 41060,
      "end_ms": 41720,
      "text": "走一圈，",
      "token_start": 139,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 42100,
      "end_ms": 51180,
      "text": "回到成都雪山草原藏寨全都有老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 142,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 51540,
      "end_ms": 52980,
      "text": "让我看看都是谁。",
      "token_start": 172,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 52980,
      "end_ms": 54400,
      "text": "在听第五名，",
      "token_start": 179,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 54700,
      "end_ms": 58420,
      "text": "内蒙古呼伦贝尔环线从海拉尔出发，",
      "token_start": 184,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 58780,
      "end_ms": 62505,
      "text": "经额尔古纳、石尾摸耳道嘎、满洲里，",
      "token_start": 199,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 62750,
      "end_ms": 63665,
      "text": "再回海拉尔，",
      "token_start": 213,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 64090,
      "end_ms": 65635,
      "text": "全程一千多公里。",
      "token_start": 218,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 66070,
      "end_ms": 68000,
      "text": "这条路最绝的是，",
      "token_start": 225,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 68000,
      "end_ms": 71420,
      "text": "他把中国最好的草原串成了一个圈儿。",
      "token_start": 232,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 72200,
      "end_ms": 73580,
      "text": "呼伦贝尔大草原，",
      "token_start": 248,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 73940,
      "end_ms": 78915,
      "text": "世界四大草原之一、德尔古纳湿地、亚洲第一湿地，",
      "token_start": 255,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 79260,
      "end_ms": 81335,
      "text": "实为俄罗斯民族乡。",
      "token_start": 275,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 81650,
      "end_ms": 82605,
      "text": "穆克楞房子，",
      "token_start": 283,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 82860,
      "end_ms": 85905,
      "text": "摩尔道嘎大兴安岭原始森林，",
      "token_start": 288,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 86790,
      "end_ms": 87565,
      "text": "满洲里，",
      "token_start": 300,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 87840,
      "end_ms": 89675,
      "text": "中俄蒙三国风情，",
      "token_start": 303,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 90410,
      "end_ms": 91445,
      "text": "套娃广场，",
      "token_start": 310,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 91780,
      "end_ms": 92285,
      "text": "国门，",
      "token_start": 314,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 92620,
      "end_ms": 95665,
      "text": "一路草原森林湿地边境。",
      "token_start": 316,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 95950,
      "end_ms": 98800,
      "text": "您夏天去草原绿到天边，",
      "token_start": 326,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 99020,
      "end_ms": 99615,
      "text": "二十度，",
      "token_start": 336,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 99890,
      "end_ms": 101125,
      "text": "晚上盖被子，",
      "token_start": 339,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 101620,
      "end_ms": 102815,
      "text": "您说这是自驾，",
      "token_start": 344,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 103140,
      "end_ms": 105615,
      "text": "还是在一副草原长卷里走了一圈儿。",
      "token_start": 350,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 106140,
      "end_ms": 110930,
      "text": "第四名川藏线从成都出发，",
      "token_start": 365,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 111150,
      "end_ms": 120065,
      "text": "经雅安、康定、新都桥、李唐、八、唐盲、康、左贡、八宿、波蜜、灵芝，",
      "token_start": 376,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 120510,
      "end_ms": 121350,
      "text": "一直到拉萨，",
      "token_start": 398,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 121610,
      "end_ms": 123675,
      "text": "全长两千一百四十二公里。",
      "token_start": 403,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 124510,
      "end_ms": 126240,
      "text": "这条路最绝的是，",
      "token_start": 414,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 126240,
      "end_ms": 127600,
      "text": "他从海拔五百米，",
      "token_start": 421,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 127600,
      "end_ms": 129025,
      "text": "一路爬到五千多米，",
      "token_start": 428,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 129540,
      "end_ms": 130825,
      "text": "翻十几座大山，",
      "token_start": 436,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 131180,
      "end_ms": 136040,
      "text": "跨十几条大河折多山崖口经翻在风里，",
      "token_start": 442,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 136040,
      "end_ms": 140605,
      "text": "略略响远处的贡嘎雪山群峰若隐若现。",
      "token_start": 458,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 141480,
      "end_ms": 145365,
      "text": "新都桥光与影的天堂日落的时候，",
      "token_start": 474,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 145700,
      "end_ms": 148405,
      "text": "塔宫草原方向美的不像真的。",
      "token_start": 488,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 148870,
      "end_ms": 149645,
      "text": "杨芜湖，",
      "token_start": 500,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 150180,
      "end_ms": 152545,
      "text": "碧绿的湖面倒映着雪山，",
      "token_start": 503,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 153330,
      "end_ms": 155610,
      "text": "清晨雾气缭绕的时候，",
      "token_start": 513,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 155770,
      "end_ms": 159350,
      "text": "您站在湖边分不清哪是天哪，",
      "token_start": 522,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 159350,
      "end_ms": 162910,
      "text": "是水木将七十二拐一条路。",
      "token_start": 534,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 162910,
      "end_ms": 164545,
      "text": "在悬崖边拐了又拐，",
      "token_start": 545,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 164920,
      "end_ms": 167600,
      "text": "从山顶一直盘到谷底。",
      "token_start": 553,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 167840,
      "end_ms": 171585,
      "text": "林芝西藏的江南春天桃花开了，",
      "token_start": 562,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 172030,
      "end_ms": 175640,
      "text": "雪山底下全是粉色的中国国家地理，",
      "token_start": 575,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 175640,
      "end_ms": 177685,
      "text": "管他叫中国人的景观大道，",
      "token_start": 590,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 178130,
      "end_ms": 178970,
      "text": "一天之内，",
      "token_start": 601,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 179250,
      "end_ms": 184660,
      "text": "雪山、湖泊、藏寨、草原寺庙全在你眼前。",
      "token_start": 605,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 184700,
      "end_ms": 186615,
      "text": "过走一趟川藏线，",
      "token_start": 620,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 187410,
      "end_ms": 191215,
      "text": "等于看了大半个中国别的路线是串起风景。",
      "token_start": 627,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 191770,
      "end_ms": 196145,
      "text": "川藏线是把半个中国的风景铺在了一条路上。",
      "token_start": 645,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 196540,
      "end_ms": 200935,
      "text": "我前阵子翻到一本叫三百六十五日走遍中国的日历书，",
      "token_start": 664,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 201480,
      "end_ms": 204640,
      "text": "左边一页是每个地方的实景大图，",
      "token_start": 687,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 204640,
      "end_ms": 207275,
      "text": "加一段五十来个字的冷知识，",
      "token_start": 701,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 207870,
      "end_ms": 209545,
      "text": "右边是日期记事夜，",
      "token_start": 713,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 210020,
      "end_ms": 211920,
      "text": "什么季节去哪座小城，",
      "token_start": 721,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 212260,
      "end_ms": 213160,
      "text": "走哪条路，",
      "token_start": 730,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 213260,
      "end_ms": 214875,
      "text": "看什么风景最合适，",
      "token_start": 734,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 215270,
      "end_ms": 216455,
      "text": "都给你安排好了。",
      "token_start": 742,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 216970,
      "end_ms": 219555,
      "text": "不是那种千篇一律的景点介绍，",
      "token_start": 749,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 220080,
      "end_ms": 221475,
      "text": "是帮你挑日子。",
      "token_start": 762,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 222510,
      "end_ms": 223985,
      "text": "今天翻到呼伦贝尔，",
      "token_start": 768,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 224420,
      "end_ms": 226105,
      "text": "明天翻到川藏线，",
      "token_start": 776,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 226490,
      "end_ms": 228065,
      "text": "后天翻到川西，",
      "token_start": 783,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 228620,
      "end_ms": 229460,
      "text": "翻到哪页，",
      "token_start": 789,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 229620,
      "end_ms": 235035,
      "text": "就觉得那个地方在喊你我自己的习惯是每天早起翻一页当个消遣，",
      "token_start": 793,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 235810,
      "end_ms": 238795,
      "text": "翻到一个从来没听说过的小地方，",
      "token_start": 821,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 239180,
      "end_ms": 240955,
      "text": "就去网上搜搜照片，",
      "token_start": 835,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 241840,
      "end_ms": 243365,
      "text": "搜完就想订票。",
      "token_start": 843,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 244320,
      "end_ms": 246570,
      "text": "我已经放下面点开，",
      "token_start": 849,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 246770,
      "end_ms": 249825,
      "text": "就能看到喜欢到处走走的朋友，",
      "token_start": 857,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 250110,
      "end_ms": 251350,
      "text": "弄一本放茶几。",
      "token_start": 870,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 251350,
      "end_ms": 252930,
      "text": "上一年下来，",
      "token_start": 876,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 253150,
      "end_ms": 255290,
      "text": "整个中国哪儿值得去，",
      "token_start": 881,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 255310,
      "end_ms": 258035,
      "text": "哪个乐曲心里全有谱了。",
      "token_start": 890,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 259680,
      "end_ms": 260315,
      "text": "第三名，",
      "token_start": 900,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 260930,
      "end_ms": 263425,
      "text": "贵州环县从贵阳出发，",
      "token_start": 903,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 263750,
      "end_ms": 269675,
      "text": "经黄果树沥波、西江千户苗寨、镇远、梵净山，",
      "token_start": 912,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 270050,
      "end_ms": 270945,
      "text": "再回贵阳，",
      "token_start": 929,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 271180,
      "end_ms": 272695,
      "text": "全程一千多公里。",
      "token_start": 933,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 273410,
      "end_ms": 280215,
      "text": "这条路最绝的是他把贵州的山水和民族风情串成了一个圈儿。",
      "token_start": 940,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 280870,
      "end_ms": 282025,
      "text": "黄果树瀑布，",
      "token_start": 966,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 282420,
      "end_ms": 285475,
      "text": "亚洲第一大瀑布利波小七孔，",
      "token_start": 971,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 286150,
      "end_ms": 290255,
      "text": "地球腰带上的绿宝石西江千户苗寨，",
      "token_start": 983,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 290720,
      "end_ms": 304725,
      "text": "世界最大的苗族聚居村寨镇原古城太极图上的千年古城梵净山、蘑菇石、红云金顶一路瀑布。",
      "token_start": 998,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 305130,
      "end_ms": 307810,
      "text": "溶洞苗寨、洞寨古城，",
      "token_start": 1036,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 308190,
      "end_ms": 310510,
      "text": "宁夏天去避暑，",
      "token_start": 1044,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 310690,
      "end_ms": 314750,
      "text": "冬天去看苗年一条环线，",
      "token_start": 1050,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 314970,
      "end_ms": 319770,
      "text": "把贵州最野的山水和最浓的民族味儿全串在一起。",
      "token_start": 1060,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 320250,
      "end_ms": 320850,
      "text": "第二名，",
      "token_start": 1081,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 321230,
      "end_ms": 323490,
      "text": "滇藏县从昆明出发，",
      "token_start": 1084,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 323790,
      "end_ms": 335320,
      "text": "经大理、丽江、香格里拉、德钦、延井、芒康、左贡巴秀、波密、林芝一直到了拉萨，",
      "token_start": 1092,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 335820,
      "end_ms": 338120,
      "text": "全长两千三百多公里。",
      "token_start": 1121,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 338940,
      "end_ms": 339540,
      "text": "这条路。",
      "token_start": 1130,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 339540,
      "end_ms": 343860,
      "text": "最绝的是他从热带雨林一路爬到雪山高原，",
      "token_start": 1133,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 344400,
      "end_ms": 346980,
      "text": "从海拔五百米爬到五千多米。",
      "token_start": 1151,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 347780,
      "end_ms": 356720,
      "text": "严理的苍山洱海、丽江的玉龙雪山、香格里拉的普达措、梅里雪山的日照金山，",
      "token_start": 1163,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 357280,
      "end_ms": 359120,
      "text": "盐井的千年盐田。",
      "token_start": 1194,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 359580,
      "end_ms": 365465,
      "text": "然芜湖怒江七十二拐林芝的桃花一条路，",
      "token_start": 1201,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 365900,
      "end_ms": 367685,
      "text": "从云南走到西藏，",
      "token_start": 1218,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 367960,
      "end_ms": 369915,
      "text": "从热带走到高原，",
      "token_start": 1225,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 370380,
      "end_ms": 371685,
      "text": "走一趟滇藏县，",
      "token_start": 1232,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 372110,
      "end_ms": 375415,
      "text": "等于把云南和西藏的精华全看了一遍。",
      "token_start": 1238,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 375970,
      "end_ms": 379845,
      "text": "中国国家地理管它叫进藏最美路线。",
      "token_start": 1254,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 380800,
      "end_ms": 381405,
      "text": "第一名。",
      "token_start": 1269,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 381780,
      "end_ms": 385475,
      "text": "川西大环线从成都出发，",
      "token_start": 1272,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 385980,
      "end_ms": 395190,
      "text": "经都江堰、四姑娘山、丹巴、瑟达、甘孜、李唐、稻成、亚丁、新都桥，",
      "token_start": 1282,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 395490,
      "end_ms": 398665,
      "text": "康定再回成都，",
      "token_start": 1305,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 398960,
      "end_ms": 400255,
      "text": "全程两千多公里。",
      "token_start": 1311,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 400620,
      "end_ms": 402320,
      "text": "这条路最绝的是，",
      "token_start": 1318,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 402320,
      "end_ms": 406235,
      "text": "他把川西最好的风景全串成了一个圈儿。",
      "token_start": 1325,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 406750,
      "end_ms": 420795,
      "text": "四姑娘山单巴藏寨、色达五名佛学院、干孜草原、李唐世界高城道城、亚丁水蓝色星球上的最后一片净土。",
      "token_start": 1342,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 421320,
      "end_ms": 422120,
      "text": "新都桥，",
      "token_start": 1384,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 422380,
      "end_ms": 423785,
      "text": "光与影的天堂，",
      "token_start": 1387,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 424150,
      "end_ms": 424785,
      "text": "牛背山，",
      "token_start": 1393,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 425700,
      "end_ms": 427700,
      "text": "中国最大的观景平台，",
      "token_start": 1396,
      "token_end_exclusive": 1405
    },
    {
      "start_ms": 427980,
      "end_ms": 437660,
      "text": "一条环线从海拔五百米爬到四千七百米雪山、草原、葬寨、寺庙、冰川、湖泊全都有。",
      "token_start": 1405,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 437780,
      "end_ms": 438655,
      "text": "您走一趟，",
      "token_start": 1437,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 439210,
      "end_ms": 442985,
      "text": "等于把川崎高原从头到尾看了一遍，",
      "token_start": 1441,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 443910,
      "end_ms": 445485,
      "text": "别的路线串一条线。",
      "token_start": 1456,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 446370,
      "end_ms": 449005,
      "text": "川西大环线串的是一个高原，",
      "token_start": 1464,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 449860,
      "end_ms": 452695,
      "text": "这才是真正做头把交椅的东西。",
      "token_start": 1476,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 453360,
      "end_ms": 455440,
      "text": "不是哪一条路有多美，",
      "token_start": 1489,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 455740,
      "end_ms": 460135,
      "text": "是这一圈把整个川西的美全装进去了。",
      "token_start": 1498,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 460640,
      "end_ms": 461955,
      "text": "您听出来了没有？",
      "token_start": 1514,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 462790,
      "end_ms": 464305,
      "text": "这十条自驾路线，",
      "token_start": 1521,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 464570,
      "end_ms": 469250,
      "text": "没有一条是光靠好看出名的海南环岛，",
      "token_start": 1528,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 469270,
      "end_ms": 471345,
      "text": "靠的是把冬天甩在身后。",
      "token_start": 1544,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 472130,
      "end_ms": 474875,
      "text": "皖南环线靠的是徽州长卷。",
      "token_start": 1554,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 475410,
      "end_ms": 478950,
      "text": "甘南环线靠的是把西藏搬到甘肃。",
      "token_start": 1565,
      "token_end_exclusive": 1579
    },
    {
      "start_ms": 479150,
      "end_ms": 482370,
      "text": "滇西北环线靠的是云南四季青，",
      "token_start": 1579,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 482410,
      "end_ms": 483290,
      "text": "海大环线，",
      "token_start": 1592,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 483370,
      "end_ms": 486195,
      "text": "靠的是历史和风景串成圈。",
      "token_start": 1596,
      "token_end_exclusive": 1607
    },
    {
      "start_ms": 486770,
      "end_ms": 489045,
      "text": "呼伦贝尔靠的是草原长卷，",
      "token_start": 1607,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 489560,
      "end_ms": 493285,
      "text": "川藏线靠的是把半个中国不在路上。",
      "token_start": 1618,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 493840,
      "end_ms": 496725,
      "text": "贵州环线靠的是山水和民族味儿。",
      "token_start": 1633,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 497200,
      "end_ms": 502150,
      "text": "滇藏线靠的是从热带走到高原川西大环线，",
      "token_start": 1647,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 502290,
      "end_ms": 504685,
      "text": "靠的是把一个高原装进去，",
      "token_start": 1665,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 505130,
      "end_ms": 509410,
      "text": "每一条路线的厉害之处都不在他有多长，",
      "token_start": 1676,
      "token_end_exclusive": 1693
    },
    {
      "start_ms": 509770,
      "end_ms": 511225,
      "text": "在他串起了什么？",
      "token_start": 1693,
      "token_end_exclusive": 1700
    },
    {
      "start_ms": 512050,
      "end_ms": 512895,
      "text": "点个关注，",
      "token_start": 1700,
      "token_end_exclusive": 1704
    },
    {
      "start_ms": 513280,
      "end_ms": 514895,
      "text": "咱们下期接着聊。",
      "token_start": 1704,
      "token_end_exclusive": 1711
    }
  ],
