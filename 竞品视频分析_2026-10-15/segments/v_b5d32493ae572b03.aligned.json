{
  "video_id": "v_b5d32493ae572b03",
  "duration_s": 411.724138,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b5d32493ae572b03.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b5d32493ae572b03.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2070,
      "text": "全班就他一个人没考上高中。",
      "token_start": 0,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 2930,
      "end_ms": 3870,
      "text": "三十年后，",
      "token_start": 12,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4470,
      "end_ms": 6510,
      "text": "全世界数学家向他低头。",
      "token_start": 16,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7550,
      "end_ms": 11170,
      "text": "家人们先问你一个扎心的问题，",
      "token_start": 26,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 12210,
      "end_ms": 17270,
      "text": "要是你的孩子被老师当着全班的面说笨，",
      "token_start": 39,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 17910,
      "end_ms": 18770,
      "text": "你会咋想？",
      "token_start": 56,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 19370,
      "end_ms": 20570,
      "text": "一九二五年，",
      "token_start": 60,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 20610,
      "end_ms": 23490,
      "text": "江苏金坛就有这么一个孩子，",
      "token_start": 65,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 23790,
      "end_ms": 24630,
      "text": "初中毕业，",
      "token_start": 77,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 25030,
      "end_ms": 27570,
      "text": "全班同学都考上了高中，",
      "token_start": 81,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 28130,
      "end_ms": 29695,
      "text": "就他一个落了榜，",
      "token_start": 91,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 30140,
      "end_ms": 32380,
      "text": "老师嫌他字写的潦草，",
      "token_start": 98,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 32880,
      "end_ms": 33880,
      "text": "作业不工整，",
      "token_start": 107,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 34980,
      "end_ms": 36280,
      "text": "当着人面说他笨，",
      "token_start": 112,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 36640,
      "end_ms": 38240,
      "text": "同学还给他起了个外号，",
      "token_start": 119,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 38300,
      "end_ms": 41420,
      "text": "叫罗呆子爹妈也死了心，",
      "token_start": 129,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 41780,
      "end_ms": 43760,
      "text": "撂下一句话别，",
      "token_start": 139,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 43760,
      "end_ms": 47040,
      "text": "念了回家站柜台卖棉花去吧。",
      "token_start": 145,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 47820,
      "end_ms": 49320,
      "text": "那年他才十五岁，",
      "token_start": 157,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 50100,
      "end_ms": 50700,
      "text": "搁一般，",
      "token_start": 164,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 50700,
      "end_ms": 52020,
      "text": "人这一辈子，",
      "token_start": 167,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 52660,
      "end_ms": 53380,
      "text": "别念了，",
      "token_start": 172,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 53420,
      "end_ms": 55060,
      "text": "就算盖棺定论了。",
      "token_start": 175,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 55560,
      "end_ms": 56740,
      "text": "可三十年后，",
      "token_start": 182,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 57040,
      "end_ms": 60525,
      "text": "这个人站到了全世界数学家的头顶顶上，",
      "token_start": 187,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 61180,
      "end_ms": 63805,
      "text": "清华大学为他头一回破了规矩。",
      "token_start": 204,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 64130,
      "end_ms": 66235,
      "text": "剑桥大学抢着请他去深造，",
      "token_start": 217,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 66840,
      "end_ms": 68700,
      "text": "美国人开出天价年薪，",
      "token_start": 228,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 68760,
      "end_ms": 70455,
      "text": "想留他他不干，",
      "token_start": 237,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 71750,
      "end_ms": 72755,
      "text": "他叫华罗庚，",
      "token_start": 243,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 73760,
      "end_ms": 78370,
      "text": "全世界公认的中国数学之父。",
      "token_start": 248,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 78570,
      "end_ms": 80695,
      "text": "你肯定要问一个初中生，",
      "token_start": 260,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 81030,
      "end_ms": 83110,
      "text": "凭啥凭的？",
      "token_start": 270,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 83110,
      "end_ms": 85230,
      "text": "就是全世界都放弃他的时候，",
      "token_start": 274,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 85310,
      "end_ms": 89135,
      "text": "他没放弃自己家里穷供不起高中，",
      "token_start": 286,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 89730,
      "end_ms": 92055,
      "text": "他进了一所职业学校学会计，",
      "token_start": 300,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 92710,
      "end_ms": 94835,
      "text": "想着穴门守艺混口饭吃，",
      "token_start": 312,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 95510,
      "end_ms": 96615,
      "text": "可学了没几天，",
      "token_start": 322,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 96990,
      "end_ms": 99345,
      "text": "连职业学校的学费都交不起了，",
      "token_start": 328,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 99680,
      "end_ms": 101345,
      "text": "他只能卷铺盖回家，",
      "token_start": 341,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 101910,
      "end_ms": 103830,
      "text": "白天站柜台卖棉花，",
      "token_start": 349,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 104090,
      "end_ms": 105885,
      "text": "晚上别人都睡了，",
      "token_start": 357,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 106550,
      "end_ms": 108155,
      "text": "他点起一盏油灯，",
      "token_start": 364,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 108670,
      "end_ms": 110605,
      "text": "趴在柜台上算数学，",
      "token_start": 371,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 111140,
      "end_ms": 112055,
      "text": "没有老师，",
      "token_start": 379,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 112360,
      "end_ms": 113265,
      "text": "没有教材，",
      "token_start": 383,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 113750,
      "end_ms": 116635,
      "text": "他就四处求爷爷告奶奶的借书，",
      "token_start": 387,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 117160,
      "end_ms": 118180,
      "text": "一本破书，",
      "token_start": 400,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 118260,
      "end_ms": 119460,
      "text": "翻来覆去的啃，",
      "token_start": 404,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 119620,
      "end_ms": 120935,
      "text": "啃烂了接着啃。",
      "token_start": 410,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 121320,
      "end_ms": 122160,
      "text": "常常一算，",
      "token_start": 416,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 122180,
      "end_ms": 125865,
      "text": "就是大半夜油灯熏的鼻孔都是黑的。",
      "token_start": 420,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 126360,
      "end_ms": 129595,
      "text": "学校里有个数学老师叫王维克，",
      "token_start": 435,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 130030,
      "end_ms": 132055,
      "text": "别的老师都嫌华罗庚笨，",
      "token_start": 448,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 132490,
      "end_ms": 133835,
      "text": "只有王维克说，",
      "token_start": 458,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 134630,
      "end_ms": 135505,
      "text": "你不是笨，",
      "token_start": 464,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 136520,
      "end_ms": 137815,
      "text": "你是还没开窍，",
      "token_start": 468,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 138750,
      "end_ms": 139210,
      "text": "开窍，",
      "token_start": 474,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 139210,
      "end_ms": 141805,
      "text": "那天没人拦得住你。",
      "token_start": 476,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 142670,
      "end_ms": 148145,
      "text": "他把珍藏的数学书一本一本借给华洛庚。",
      "token_start": 484,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 149960,
      "end_ms": 150665,
      "text": "这句话，",
      "token_start": 501,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 151070,
      "end_ms": 152405,
      "text": "华罗庚记了一辈子。",
      "token_start": 504,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 153370,
      "end_ms": 158980,
      "text": "可命运这东西专挑苦命人欺负十九岁。",
      "token_start": 512,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 158980,
      "end_ms": 159455,
      "text": "那年，",
      "token_start": 528,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 159780,
      "end_ms": 162670,
      "text": "一场伤寒差点要了他的命。",
      "token_start": 530,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 162850,
      "end_ms": 164245,
      "text": "那时候缺医少药，",
      "token_start": 541,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 164680,
      "end_ms": 167035,
      "text": "他在床上烧了整整半年，",
      "token_start": 548,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 167590,
      "end_ms": 170045,
      "text": "烧的迷迷糊糊水米不进，",
      "token_start": 558,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 170780,
      "end_ms": 173165,
      "text": "家里人连棺材都给他备好了。",
      "token_start": 568,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 173950,
      "end_ms": 176120,
      "text": "命是保住了左腿，",
      "token_start": 580,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 176420,
      "end_ms": 178635,
      "text": "却落下了终身残疾，",
      "token_start": 587,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 179120,
      "end_ms": 180515,
      "text": "走路一瘸一拐，",
      "token_start": 595,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 180880,
      "end_ms": 182045,
      "text": "再也站不直了。",
      "token_start": 601,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 182390,
      "end_ms": 183485,
      "text": "一个穷小子，",
      "token_start": 607,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 183820,
      "end_ms": 184965,
      "text": "又瘸了一条腿。",
      "token_start": 612,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 185420,
      "end_ms": 186955,
      "text": "街坊都在背后嘀咕，",
      "token_start": 618,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 187290,
      "end_ms": 189995,
      "text": "老画家那小子这辈子算交代了，",
      "token_start": 626,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 190910,
      "end_ms": 192970,
      "text": "可华罗庚不信命病。",
      "token_start": 639,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 193190,
      "end_ms": 194115,
      "text": "刚好一点，",
      "token_start": 647,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 194450,
      "end_ms": 195825,
      "text": "他又趴在柜台上算，",
      "token_start": 651,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 196170,
      "end_ms": 196785,
      "text": "没有纸，",
      "token_start": 659,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 197110,
      "end_ms": 198245,
      "text": "就在废纸上写。",
      "token_start": 662,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 198550,
      "end_ms": 199835,
      "text": "他给报刊投稿，",
      "token_start": 668,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 200900,
      "end_ms": 205735,
      "text": "一篇两篇三篇大多石沉大海，",
      "token_start": 674,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 206520,
      "end_ms": 207305,
      "text": "他不气馁，",
      "token_start": 686,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 208160,
      "end_ms": 208775,
      "text": "接着写。",
      "token_start": 690,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 209930,
      "end_ms": 211085,
      "text": "一九三零年，",
      "token_start": 693,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 211330,
      "end_ms": 216105,
      "text": "二十岁的华罗庚在杂志上发表了一篇论文，",
      "token_start": 698,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 216620,
      "end_ms": 220575,
      "text": "指出了当时一位著名教授论文里的错误，",
      "token_start": 716,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 221020,
      "end_ms": 223955,
      "text": "就是这篇论文改写了他的一生。",
      "token_start": 733,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 224830,
      "end_ms": 228715,
      "text": "论文传到清华大学数学系主任熊庆来手里，",
      "token_start": 746,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 229100,
      "end_ms": 231155,
      "text": "熊庆来读完之后大吃一惊。",
      "token_start": 764,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 231570,
      "end_ms": 232920,
      "text": "问这个话，",
      "token_start": 775,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 232940,
      "end_ms": 233805,
      "text": "罗庚是谁？",
      "token_start": 779,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 234210,
      "end_ms": 235610,
      "text": "在哪个大学任教？",
      "token_start": 783,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 235710,
      "end_ms": 238085,
      "text": "人家告诉他他没上过大学，",
      "token_start": 790,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 238570,
      "end_ms": 240385,
      "text": "是个初中毕业的店员，",
      "token_start": 801,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 240750,
      "end_ms": 242255,
      "text": "还在老家卖棉花，",
      "token_start": 810,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 243040,
      "end_ms": 244995,
      "text": "雄庆来当场拍板，",
      "token_start": 817,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 245260,
      "end_ms": 246495,
      "text": "把他请到清华来。",
      "token_start": 824,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 247720,
      "end_ms": 248995,
      "text": "花罗庚回信说，",
      "token_start": 831,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 249460,
      "end_ms": 250080,
      "text": "家里穷，",
      "token_start": 837,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 250420,
      "end_ms": 251935,
      "text": "连路费都拿不出来，",
      "token_start": 840,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 252700,
      "end_ms": 255535,
      "text": "雄庆来当天就把路费寄了过去。",
      "token_start": 848,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 256130,
      "end_ms": 259820,
      "text": "一九三一年华罗庚拖着一条残腿，",
      "token_start": 861,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 260080,
      "end_ms": 262085,
      "text": "第一次走进了清化园。",
      "token_start": 875,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 262590,
      "end_ms": 264055,
      "text": "可清华给他的活儿，",
      "token_start": 884,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 264190,
      "end_ms": 264935,
      "text": "不是老师，",
      "token_start": 892,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 265250,
      "end_ms": 266085,
      "text": "是助理员，",
      "token_start": 896,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 266400,
      "end_ms": 269490,
      "text": "说白了就是管管图书跑跑腿，",
      "token_start": 900,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 269710,
      "end_ms": 270450,
      "text": "收发文件，",
      "token_start": 912,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 270610,
      "end_ms": 271270,
      "text": "工资低，",
      "token_start": 916,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 271470,
      "end_ms": 271990,
      "text": "活砸，",
      "token_start": 919,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 272270,
      "end_ms": 274035,
      "text": "换个人早扭头走了。",
      "token_start": 921,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 274970,
      "end_ms": 276445,
      "text": "可华罗庚高兴坏了。",
      "token_start": 929,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 276790,
      "end_ms": 277170,
      "text": "他说，",
      "token_start": 937,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 277590,
      "end_ms": 278650,
      "text": "能进清华，",
      "token_start": 939,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 278990,
      "end_ms": 281005,
      "text": "能天天跟数学待在一起，",
      "token_start": 943,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 281320,
      "end_ms": 282375,
      "text": "让我扫地都行。",
      "token_start": 953,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 282850,
      "end_ms": 284095,
      "text": "白天干杂活，",
      "token_start": 959,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 284520,
      "end_ms": 285615,
      "text": "晚上蹭客，",
      "token_start": 964,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 286050,
      "end_ms": 287945,
      "text": "一有空就泡在图书馆。",
      "token_start": 968,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 288460,
      "end_ms": 289295,
      "text": "几年时间，",
      "token_start": 977,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 289640,
      "end_ms": 294545,
      "text": "他硬是把大学数学的全部课程是学完了论文。",
      "token_start": 981,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 294850,
      "end_ms": 298090,
      "text": "一篇接一篇发到国外权威期刊上，",
      "token_start": 1000,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 298470,
      "end_ms": 300350,
      "text": "清华的教授们坐不住了，",
      "token_start": 1014,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 301270,
      "end_ms": 304930,
      "text": "这个助理园水平已经超过了系里。",
      "token_start": 1024,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 304930,
      "end_ms": 308850,
      "text": "不少老师最终清华打破常规破格，",
      "token_start": 1038,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 308870,
      "end_ms": 311250,
      "text": "把他从祝理园直接提为教员，",
      "token_start": 1052,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 311670,
      "end_ms": 314350,
      "text": "后来又送他去英国剑桥深造。",
      "token_start": 1064,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 315030,
      "end_ms": 315670,
      "text": "家人们，",
      "token_start": 1076,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 315810,
      "end_ms": 317550,
      "text": "你频频这件事儿，",
      "token_start": 1079,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 319030,
      "end_ms": 320530,
      "text": "一个初中没毕业，",
      "token_start": 1086,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 321030,
      "end_ms": 322330,
      "text": "被叫呆子，",
      "token_start": 1093,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 322730,
      "end_ms": 324610,
      "text": "十九岁瘸了腿的孩子，",
      "token_start": 1097,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 325200,
      "end_ms": 328040,
      "text": "靠着一盏油灯和一股子狠劲，",
      "token_start": 1106,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 328600,
      "end_ms": 331580,
      "text": "把学历两个字生生踩在了脚下。",
      "token_start": 1118,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 332480,
      "end_ms": 335160,
      "text": "学历从来不是天花板，",
      "token_start": 1131,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 335640,
      "end_ms": 339120,
      "text": "认命才是说句掏心窝子的话，",
      "token_start": 1140,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 339520,
      "end_ms": 341920,
      "text": "最们当爹当妈的最怕啥，",
      "token_start": 1152,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 342460,
      "end_ms": 344500,
      "text": "最怕孩子将来没出戏，",
      "token_start": 1162,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 344700,
      "end_ms": 345720,
      "text": "可你天天吼他，",
      "token_start": 1171,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 345720,
      "end_ms": 346300,
      "text": "你要努力，",
      "token_start": 1177,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 346300,
      "end_ms": 347140,
      "text": "他听不进去，",
      "token_start": 1181,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 347360,
      "end_ms": 348680,
      "text": "你给他讲大道理，",
      "token_start": 1186,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 348820,
      "end_ms": 349580,
      "text": "他嫌你烦。",
      "token_start": 1193,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 350000,
      "end_ms": 350480,
      "text": "为啥？",
      "token_start": 1197,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 350840,
      "end_ms": 353480,
      "text": "因为道理是空的故事，",
      "token_start": 1199,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 353480,
      "end_ms": 356315,
      "text": "是真的华罗庚这样的故事。",
      "token_start": 1208,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 356590,
      "end_ms": 357430,
      "text": "孩子听完，",
      "token_start": 1219,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 357690,
      "end_ms": 358855,
      "text": "他自己就明白了，",
      "token_start": 1223,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 359240,
      "end_ms": 361995,
      "text": "原来不是非得聪明才能成事。",
      "token_start": 1230,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 362650,
      "end_ms": 364245,
      "text": "原来穷的叮当响，",
      "token_start": 1242,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 364610,
      "end_ms": 366765,
      "text": "瘸着一条腿的人都能爬起来。",
      "token_start": 1249,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 367300,
      "end_ms": 369035,
      "text": "我四肢健全的，",
      "token_start": 1261,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 370140,
      "end_ms": 372435,
      "text": "凭啥不好好读书？",
      "token_start": 1267,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 373580,
      "end_ms": 375335,
      "text": "这本国值脊梁里面，",
      "token_start": 1274,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 375560,
      "end_ms": 377340,
      "text": "像华罗庚这样的中国人，",
      "token_start": 1282,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 377380,
      "end_ms": 378395,
      "text": "还有四十位，",
      "token_start": 1292,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 378750,
      "end_ms": 382265,
      "text": "每一位都是一盏油灯点出来的故事。",
      "token_start": 1297,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 382790,
      "end_ms": 385185,
      "text": "这本书我真心推荐放在孩子床头，",
      "token_start": 1312,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 385570,
      "end_ms": 387045,
      "text": "孩子不想学习的时候，",
      "token_start": 1326,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 387360,
      "end_ms": 388475,
      "text": "翻一页给他听，",
      "token_start": 1335,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 388980,
      "end_ms": 391635,
      "text": "比你说一万句你要努力都管用。",
      "token_start": 1341,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 392340,
      "end_ms": 396325,
      "text": "链接就在视频左下角点进去就能看到，",
      "token_start": 1354,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 396910,
      "end_ms": 401685,
      "text": "觉得画老了不起的评论区打自强不息四个字，",
      "token_start": 1370,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 402140,
      "end_ms": 403535,
      "text": "转发到家庭群，",
      "token_start": 1389,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 403930,
      "end_ms": 406235,
      "text": "让更多人看到这个逆袭的故事。",
      "token_start": 1395,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 406760,
      "end_ms": 407525,
      "text": "点个收藏，",
      "token_start": 1408,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 408070,
      "end_ms": 410350,
      "text": "这是华罗庚三部曲的第一步。",
      "token_start": 1412,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 410450,
      "end_ms": 410990,
      "text": "关注我，",
      "token_start": 1424,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 411110,
      "end_ms": 411615,
      "text": "别走丢。",
      "token_start": 1427,
      "token_end_exclusive": 1430
    }
  ],
