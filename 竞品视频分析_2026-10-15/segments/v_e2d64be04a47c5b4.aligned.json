{
  "video_id": "v_e2d64be04a47c5b4",
  "duration_s": 299.837823,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_e2d64be04a47c5b4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_e2d64be04a47c5b4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 1820,
      "end_ms": 2060,
      "text": "嗯，",
      "token_start": 0,
      "token_end_exclusive": 1
    },
    {
      "start_ms": 4980,
      "end_ms": 6960,
      "text": "姑娘怎么了？",
      "token_start": 1,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 7180,
      "end_ms": 8940,
      "text": "领导让我来后备箱拿茅台，",
      "token_start": 6,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 9240,
      "end_ms": 10680,
      "text": "可里面明明是空的，",
      "token_start": 17,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 11040,
      "end_ms": 12340,
      "text": "我不知道该怎么交差，",
      "token_start": 25,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 12720,
      "end_ms": 14320,
      "text": "回去肯定要被开除了。",
      "token_start": 34,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 14500,
      "end_ms": 15400,
      "text": "傻孩子，",
      "token_start": 43,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 15680,
      "end_ms": 17780,
      "text": "领导能不知道自己车里没酒吗？",
      "token_start": 46,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 17920,
      "end_ms": 19280,
      "text": "人家要的是结果，",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 19660,
      "end_ms": 20780,
      "text": "你看看这个视频，",
      "token_start": 66,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 20960,
      "end_ms": 22380,
      "text": "学学人家怎么做的。",
      "token_start": 73,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 22380,
      "end_ms": 22800,
      "text": "小李，",
      "token_start": 81,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 23100,
      "end_ms": 25135,
      "text": "你把我后备箱里的茅台拿上去，",
      "token_start": 83,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 30460,
      "end_ms": 31320,
      "text": "领导的暗示，",
      "token_start": 96,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 31320,
      "end_ms": 32320,
      "text": "你能听得懂吗？",
      "token_start": 101,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 33580,
      "end_ms": 34280,
      "text": "没有啊，",
      "token_start": 107,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 35800,
      "end_ms": 39430,
      "text": "哎被偷你干什么？",
      "token_start": 110,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 39990,
      "end_ms": 40390,
      "text": "赵总，",
      "token_start": 117,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 40390,
      "end_ms": 41210,
      "text": "茅台都被偷了，",
      "token_start": 119,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 41210,
      "end_ms": 42410,
      "text": "你为什么不让我说呀？",
      "token_start": 125,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 42430,
      "end_ms": 44310,
      "text": "领导能不知道后备箱有没有酒吗？",
      "token_start": 134,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 44610,
      "end_ms": 44910,
      "text": "不是，",
      "token_start": 148,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 44910,
      "end_ms": 47110,
      "text": "这职场上理会错，",
      "token_start": 150,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 47110,
      "end_ms": 48450,
      "text": "领导的意思是大忌。",
      "token_start": 157,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 48930,
      "end_ms": 49750,
      "text": "车里没有酒，",
      "token_start": 165,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 49990,
      "end_ms": 51430,
      "text": "赵总却让你送上去，",
      "token_start": 170,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 51670,
      "end_ms": 53110,
      "text": "说明他只在意结果，",
      "token_start": 178,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 53450,
      "end_ms": 54490,
      "text": "你又何必去在意。",
      "token_start": 186,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 54490,
      "end_ms": 58490,
      "text": "车里酒的去向和真实性呢满足领导的需求最重要。",
      "token_start": 193,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 58950,
      "end_ms": 59495,
      "text": "哦，",
      "token_start": 214,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 61690,
      "end_ms": 62145,
      "text": "赵总，",
      "token_start": 215,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 62630,
      "end_ms": 63590,
      "text": "您车里的东西呢，",
      "token_start": 217,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 63590,
      "end_ms": 64350,
      "text": "我不好乱翻，",
      "token_start": 224,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 64510,
      "end_ms": 65210,
      "text": "就自己准备了。",
      "token_start": 229,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 65210,
      "end_ms": 66260,
      "text": "四瓶两瓶，",
      "token_start": 235,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 66260,
      "end_ms": 67120,
      "text": "留在您车里了，",
      "token_start": 239,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 67260,
      "end_ms": 75460,
      "text": "这两瓶拿上来您先用公赵总，",
      "token_start": 245,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 75540,
      "end_ms": 76500,
      "text": "咱们下次见啊。",
      "token_start": 257,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 76540,
      "end_ms": 77465,
      "text": "哎哎好，",
      "token_start": 263,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 77850,
      "end_ms": 78030,
      "text": "哎，",
      "token_start": 266,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 78030,
      "end_ms": 79190,
      "text": "刘总你怎么走了呀？",
      "token_start": 267,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 79430,
      "end_ms": 80765,
      "text": "是不是嫌报价不满意啊？",
      "token_start": 275,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 81670,
      "end_ms": 83885,
      "text": "哼哎哎，",
      "token_start": 285,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 87840,
      "end_ms": 88440,
      "text": "恭喜赵总，",
      "token_start": 288,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 88440,
      "end_ms": 89245,
      "text": "拿下合同，",
      "token_start": 292,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 90540,
      "end_ms": 91065,
      "text": "小李，",
      "token_start": 296,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 91380,
      "end_ms": 92765,
      "text": "后续你来负责吧。",
      "token_start": 298,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 94680,
      "end_ms": 94920,
      "text": "哎，",
      "token_start": 305,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 94960,
      "end_ms": 97695,
      "text": "赵总这哎，",
      "token_start": 306,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 97990,
      "end_ms": 98330,
      "text": "这赵总，",
      "token_start": 310,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 98330,
      "end_ms": 99275,
      "text": "这怎么回事啊？",
      "token_start": 313,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 99710,
      "end_ms": 101275,
      "text": "这个项目一直是大刘在负责，",
      "token_start": 319,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 101620,
      "end_ms": 103005,
      "text": "赵总突然把项目给我了。",
      "token_start": 331,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 103230,
      "end_ms": 103590,
      "text": "茶汤。",
      "token_start": 341,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 103590,
      "end_ms": 105485,
      "text": "回鹘是谈判的收尾动作，",
      "token_start": 343,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 105790,
      "end_ms": 106890,
      "text": "象征着交易达成。",
      "token_start": 353,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 107090,
      "end_ms": 108290,
      "text": "大刘连这个都不懂，",
      "token_start": 360,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 108510,
      "end_ms": 110335,
      "text": "赵总怎么敢把项目交给他呀？",
      "token_start": 368,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 111130,
      "end_ms": 111710,
      "text": "不能吧，",
      "token_start": 380,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 112170,
      "end_ms": 112950,
      "text": "人情世故，",
      "token_start": 383,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 112950,
      "end_ms": 114045,
      "text": "可是门大学问，",
      "token_start": 387,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 114350,
      "end_ms": 115270,
      "text": "你要学的呀，",
      "token_start": 393,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 115270,
      "end_ms": 116095,
      "text": "还多着呢。",
      "token_start": 398,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 116960,
      "end_ms": 117435,
      "text": "老婆。",
      "token_start": 402,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 118050,
      "end_ms": 119590,
      "text": "赵总把上次的酒钱转过来了，",
      "token_start": 404,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 119590,
      "end_ms": 122290,
      "text": "你看哎，",
      "token_start": 416,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 122390,
      "end_ms": 123330,
      "text": "你怎么收了呀？",
      "token_start": 419,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 123410,
      "end_ms": 124210,
      "text": "赵总转多了，",
      "token_start": 425,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 124210,
      "end_ms": 125205,
      "text": "你赶紧给他退回去，",
      "token_start": 430,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 125390,
      "end_ms": 126910,
      "text": "你自以为有原则的退回，",
      "token_start": 438,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 126930,
      "end_ms": 128485,
      "text": "只会让领导觉得麻烦，",
      "token_start": 448,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 128860,
      "end_ms": 130205,
      "text": "还不如大大方方收下呢。",
      "token_start": 457,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 131620,
      "end_ms": 133255,
      "text": "那我是不是得说点啥呀？",
      "token_start": 467,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 133510,
      "end_ms": 134950,
      "text": "你就说感谢领导，",
      "token_start": 477,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 134950,
      "end_ms": 135405,
      "text": "大气，",
      "token_start": 484,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 135850,
      "end_ms": 137505,
      "text": "果然跟着领导有甜头吃，",
      "token_start": 486,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 138390,
      "end_ms": 139285,
      "text": "就这样就行了。",
      "token_start": 496,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 139730,
      "end_ms": 140685,
      "text": "当然不行啊，",
      "token_start": 502,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 141620,
      "end_ms": 141960,
      "text": "赵总，",
      "token_start": 507,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 141960,
      "end_ms": 143100,
      "text": "请大家喝奶茶了啊，",
      "token_start": 509,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 143140,
      "end_ms": 143885,
      "text": "人人都有。",
      "token_start": 517,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 148450,
      "end_ms": 148770,
      "text": "小李，",
      "token_start": 521,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 148770,
      "end_ms": 149275,
      "text": "你来一下。",
      "token_start": 523,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 150770,
      "end_ms": 152575,
      "text": "我什么时候请大家喝奶茶了？",
      "token_start": 527,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 153210,
      "end_ms": 153810,
      "text": "奶茶钱，",
      "token_start": 539,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 153810,
      "end_ms": 155655,
      "text": "您不是跟着酒钱一块转给我了吗？",
      "token_start": 542,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 156610,
      "end_ms": 158825,
      "text": "小李周天来家里坐坐，",
      "token_start": 556,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 159300,
      "end_ms": 162975,
      "text": "尝尝你嫂子的手艺啊。",
      "token_start": 565,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 163280,
      "end_ms": 163840,
      "text": "哎嫂子，",
      "token_start": 574,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 163840,
      "end_ms": 164820,
      "text": "你可算出来了，",
      "token_start": 577,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 164860,
      "end_ms": 165995,
      "text": "我都快憋死了。",
      "token_start": 583,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 168630,
      "end_ms": 169030,
      "text": "哎哎，",
      "token_start": 589,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 170130,
      "end_ms": 171050,
      "text": "你拉我干什么？",
      "token_start": 591,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 171050,
      "end_ms": 171990,
      "text": "我也很急啊，",
      "token_start": 597,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 172210,
      "end_ms": 173045,
      "text": "憋死了，",
      "token_start": 602,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 174500,
      "end_ms": 178145,
      "text": "不知道的还以为洗手间是什么好地方。",
      "token_start": 605,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 178430,
      "end_ms": 178810,
      "text": "哎呀，",
      "token_start": 621,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 178870,
      "end_ms": 179425,
      "text": "行了，",
      "token_start": 623,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 179720,
      "end_ms": 180760,
      "text": "你们做我去做饭，",
      "token_start": 625,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 180900,
      "end_ms": 181920,
      "text": "老赵帮我处理一下。",
      "token_start": 632,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 181920,
      "end_ms": 183855,
      "text": "鱼老婆，",
      "token_start": 640,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 184400,
      "end_ms": 184980,
      "text": "我怎么看？",
      "token_start": 643,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 185660,
      "end_ms": 187175,
      "text": "赵总和嫂子有点不高兴，",
      "token_start": 647,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 187480,
      "end_ms": 189285,
      "text": "因为异性厕所十分钟效应，",
      "token_start": 657,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 189590,
      "end_ms": 191890,
      "text": "人家赵总老婆刚从卫生间出来，",
      "token_start": 668,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 192010,
      "end_ms": 193070,
      "text": "你就是再着急，",
      "token_start": 681,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 193130,
      "end_ms": 194070,
      "text": "你等十分钟再走，",
      "token_start": 687,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 194070,
      "end_ms": 196525,
      "text": "怎么可能是因为这个你照做就行。",
      "token_start": 694,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 198310,
      "end_ms": 198630,
      "text": "嫂子，",
      "token_start": 708,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 198630,
      "end_ms": 200975,
      "text": "我来帮你三宝，",
      "token_start": 710,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 202100,
      "end_ms": 202540,
      "text": "赵总，",
      "token_start": 716,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 202600,
      "end_ms": 203060,
      "text": "嫂子，",
      "token_start": 718,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 203160,
      "end_ms": 203915,
      "text": "那我走了，",
      "token_start": 720,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 205960,
      "end_ms": 209460,
      "text": "那我们也先走小李，",
      "token_start": 724,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 209460,
      "end_ms": 211140,
      "text": "留下接待王总的事情，",
      "token_start": 732,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 211160,
      "end_ms": 211985,
      "text": "咱们再碰一下，",
      "token_start": 741,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 212230,
      "end_ms": 213325,
      "text": "那得叫小张回来啊，",
      "token_start": 747,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 213900,
      "end_ms": 215435,
      "text": "不用你来负责就行。",
      "token_start": 755,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 216540,
      "end_ms": 216820,
      "text": "好的，",
      "token_start": 763,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 216820,
      "end_ms": 217215,
      "text": "赵总，",
      "token_start": 765,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 217460,
      "end_ms": 217640,
      "text": "哎，",
      "token_start": 767,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 217640,
      "end_ms": 218145,
      "text": "老婆，",
      "token_start": 768,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 218590,
      "end_ms": 221085,
      "text": "你这个厕所十分钟效应还真有说法，",
      "token_start": 770,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 221460,
      "end_ms": 223205,
      "text": "这都是不成文的社交规矩。",
      "token_start": 785,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 223560,
      "end_ms": 226245,
      "text": "你呀多看看这本把话说的恰到好处。",
      "token_start": 796,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 226550,
      "end_ms": 227490,
      "text": "假如你不爱说话，",
      "token_start": 811,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 227550,
      "end_ms": 228190,
      "text": "不爱争辩，",
      "token_start": 818,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 228190,
      "end_ms": 228910,
      "text": "也不爱出门，",
      "token_start": 822,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 228990,
      "end_ms": 229970,
      "text": "甚至恐惧社交，",
      "token_start": 827,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 230170,
      "end_ms": 231270,
      "text": "你就每天看两页，",
      "token_start": 833,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 231350,
      "end_ms": 232615,
      "text": "每一个场景慢慢练，",
      "token_start": 840,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 232840,
      "end_ms": 234420,
      "text": "你也会变成一个会说话的人。",
      "token_start": 848,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 234420,
      "end_ms": 235640,
      "text": "当我听到这句话的时候，",
      "token_start": 860,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 235640,
      "end_ms": 236845,
      "text": "我的眼泪就出来了。",
      "token_start": 870,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 237070,
      "end_ms": 238530,
      "text": "他写的是别人夸你优秀，",
      "token_start": 878,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 238530,
      "end_ms": 238970,
      "text": "你就回，",
      "token_start": 888,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 239150,
      "end_ms": 240110,
      "text": "那是不优秀点儿，",
      "token_start": 891,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 240110,
      "end_ms": 241330,
      "text": "怎么能和你做朋友？",
      "token_start": 898,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 241530,
      "end_ms": 242470,
      "text": "你看很有味道，",
      "token_start": 906,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 242490,
      "end_ms": 243470,
      "text": "假如不爱说话，",
      "token_start": 912,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 243550,
      "end_ms": 244210,
      "text": "不爱争辩，",
      "token_start": 918,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 244210,
      "end_ms": 244969,
      "text": "也不爱出门，",
      "token_start": 922,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 245110,
      "end_ms": 246150,
      "text": "甚至恐惧社交，",
      "token_start": 927,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 246330,
      "end_ms": 247530,
      "text": "你每天就看两页，",
      "token_start": 933,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 247690,
      "end_ms": 248935,
      "text": "每一个场景慢慢练，",
      "token_start": 940,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 249220,
      "end_ms": 251560,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 948,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 251560,
      "end_ms": 251740,
      "text": "哇，",
      "token_start": 963,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 251740,
      "end_ms": 252705,
      "text": "这真是太棒了。",
      "token_start": 964,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 253000,
      "end_ms": 253720,
      "text": "在这本书里边，",
      "token_start": 970,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 253720,
      "end_ms": 254945,
      "text": "有句话我特别欣赏。",
      "token_start": 976,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 255260,
      "end_ms": 256680,
      "text": "他说有人嘲讽你眼睛小，",
      "token_start": 984,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 256820,
      "end_ms": 257700,
      "text": "高情商回答，",
      "token_start": 994,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 257860,
      "end_ms": 258880,
      "text": "万物皆有裂痕，",
      "token_start": 999,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 258960,
      "end_ms": 260175,
      "text": "那是光照进来的地方。",
      "token_start": 1005,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 260460,
      "end_ms": 260660,
      "text": "哇，",
      "token_start": 1014,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 260660,
      "end_ms": 261620,
      "text": "这真是太棒了，",
      "token_start": 1015,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 261620,
      "end_ms": 262720,
      "text": "每一句都很有意思，",
      "token_start": 1021,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 262720,
      "end_ms": 263655,
      "text": "随便翻对吧？",
      "token_start": 1029,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 264060,
      "end_ms": 264260,
      "text": "哇，",
      "token_start": 1034,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 264260,
      "end_ms": 265340,
      "text": "这句话太棒了，",
      "token_start": 1035,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 265360,
      "end_ms": 267760,
      "text": "他写的是别人问你一个月工资多少，",
      "token_start": 1041,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 267780,
      "end_ms": 269385,
      "text": "你就回比以前好多了。",
      "token_start": 1056,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 269730,
      "end_ms": 271605,
      "text": "现在吃泡面敢放两根肠了。",
      "token_start": 1065,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 271840,
      "end_ms": 272700,
      "text": "我读到这段的时候，",
      "token_start": 1076,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 272700,
      "end_ms": 274785,
      "text": "我觉得这个让我真是异解心开啊，",
      "token_start": 1084,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 275020,
      "end_ms": 276660,
      "text": "这本书就像是个社交宝典，",
      "token_start": 1098,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 276800,
      "end_ms": 278800,
      "text": "把各种社交场景都变成了问题。",
      "token_start": 1109,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 278800,
      "end_ms": 279680,
      "text": "加答案的形式。",
      "token_start": 1122,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 279740,
      "end_ms": 282265,
      "text": "你说哪家的书架上不应该有一本这个书，",
      "token_start": 1128,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 282510,
      "end_ms": 285495,
      "text": "就是手把手的教我们不同的场景之下应该怎么说？",
      "token_start": 1145,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 285890,
      "end_ms": 288535,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1166,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 288730,
      "end_ms": 289710,
      "text": "你就放心拿回去看，",
      "token_start": 1184,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 289790,
      "end_ms": 291165,
      "text": "就是一句一句的教你，",
      "token_start": 1192,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 291690,
      "end_ms": 293950,
      "text": "这是我这几年来讲过的最简单的一本书。",
      "token_start": 1201,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 294050,
      "end_ms": 295495,
      "text": "我觉得这书适合所有人，",
      "token_start": 1218,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 295800,
      "end_ms": 296340,
      "text": "让你不管，",
      "token_start": 1228,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 296340,
      "end_ms": 298515,
      "text": "在任何场合都能够轻松拿捏，",
      "token_start": 1232,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 298840,
      "end_ms": 299735,
      "text": "所以强烈推荐。",
      "token_start": 1244,
      "token_end_exclusive": 1250
    }
