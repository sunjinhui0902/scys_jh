  "segments": [
    {
      "start_ms": 250,
      "end_ms": 1230,
      "text": "什么是有文化？",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1470,
      "end_ms": 3810,
      "text": "很多人说有文化就是读书多，",
      "token_start": 6,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4130,
      "end_ms": 4830,
      "text": "学历高，",
      "token_start": 18,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5190,
      "end_ms": 7350,
      "text": "其实还真不是文化，",
      "token_start": 21,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 7350,
      "end_ms": 8230,
      "text": "跟文凭无关。",
      "token_start": 29,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 8410,
      "end_ms": 9550,
      "text": "跟钱财无关，",
      "token_start": 34,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9850,
      "end_ms": 10990,
      "text": "跟身份无关，",
      "token_start": 39,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 11590,
      "end_ms": 13810,
      "text": "它就是一个人骨子里的修养，",
      "token_start": 44,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 14070,
      "end_ms": 15590,
      "text": "是根植于内心的修炼，",
      "token_start": 56,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 15930,
      "end_ms": 17090,
      "text": "是认知的高度，",
      "token_start": 65,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 17370,
      "end_ms": 18590,
      "text": "是包容的宽度，",
      "token_start": 71,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 18910,
      "end_ms": 20210,
      "text": "是思想的深度，",
      "token_start": 77,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 20770,
      "end_ms": 22250,
      "text": "是洞察世界的能力，",
      "token_start": 83,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 22430,
      "end_ms": 25470,
      "text": "是分辨是非、善恶分明的立场。",
      "token_start": 91,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 25870,
      "end_ms": 28530,
      "text": "他更是处处为别人着想的善场。",
      "token_start": 103,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 29110,
      "end_ms": 29905,
      "text": "说到底啊，",
      "token_start": 116,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 30300,
      "end_ms": 32240,
      "text": "有知识不代表有文化，",
      "token_start": 120,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 32560,
      "end_ms": 36275,
      "text": "有教养才是真的有文化。",
      "token_start": 129,
      "token_end_exclusive": 139
    }
  ],
