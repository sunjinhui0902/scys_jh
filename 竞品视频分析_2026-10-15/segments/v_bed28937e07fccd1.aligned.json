{
  "video_id": "v_bed28937e07fccd1",
  "duration_s": 421.163991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_bed28937e07fccd1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_bed28937e07fccd1.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 830,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1070,
      "end_ms": 3450,
      "text": "咱们国家历代帝王陵寝，",
      "token_start": 4,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 3730,
      "end_ms": 6270,
      "text": "有名有姓的不下两百座，",
      "token_start": 14,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6990,
      "end_ms": 12150,
      "text": "最不可思议的有人说是秦始皇陵世界第八大奇迹。",
      "token_start": 24,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12810,
      "end_ms": 14170,
      "text": "有人说是乾陵，",
      "token_start": 45,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 14670,
      "end_ms": 16570,
      "text": "武则天和李治合葬，",
      "token_start": 51,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 17110,
      "end_ms": 17890,
      "text": "四十年，",
      "token_start": 59,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 17930,
      "end_ms": 19090,
      "text": "大军没挖洞，",
      "token_start": 62,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 19450,
      "end_ms": 21430,
      "text": "错争论起邪乎，",
      "token_start": 67,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 21430,
      "end_ms": 23170,
      "text": "进秦始皇陵，",
      "token_start": 73,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 23230,
      "end_ms": 24970,
      "text": "连前三都进不去。",
      "token_start": 78,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 25690,
      "end_ms": 30900,
      "text": "今天咱们就来盘点中国最不可思议的十足座帝王陵。",
      "token_start": 85,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 31520,
      "end_ms": 33460,
      "text": "先讲第十到第六，",
      "token_start": 107,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 33700,
      "end_ms": 34720,
      "text": "一个比一个悬。",
      "token_start": 114,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 35540,
      "end_ms": 36220,
      "text": "老规矩，",
      "token_start": 120,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 36440,
      "end_ms": 37300,
      "text": "开讲之前，",
      "token_start": 123,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 37600,
      "end_ms": 39620,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 127,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 39880,
      "end_ms": 42680,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 137,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 43040,
      "end_ms": 44940,
      "text": "河南巩义北宋皇陵，",
      "token_start": 149,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 45800,
      "end_ms": 47280,
      "text": "北宋九个皇帝，",
      "token_start": 157,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 47500,
      "end_ms": 49560,
      "text": "除了被金兵掳走的两个，",
      "token_start": 163,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 49780,
      "end_ms": 50820,
      "text": "剩下七个，",
      "token_start": 173,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 51140,
      "end_ms": 54640,
      "text": "加上赵匡胤他爹一共八座陵。",
      "token_start": 177,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 55060,
      "end_ms": 59320,
      "text": "全埋在巩义这陵最绝的地方不是大，",
      "token_start": 189,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 59520,
      "end_ms": 62255,
      "text": "是韩盐酸跟秦始皇陵比，",
      "token_start": 204,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 62700,
      "end_ms": 64095,
      "text": "跟唐乾陵比，",
      "token_start": 214,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 64520,
      "end_ms": 66805,
      "text": "北宋皇陵小的可怜。",
      "token_start": 219,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 67700,
      "end_ms": 70825,
      "text": "就拿开国皇帝赵匡胤的永昌龄来说，",
      "token_start": 227,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 71370,
      "end_ms": 72965,
      "text": "没有巍峨的风土，",
      "token_start": 242,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 73400,
      "end_ms": 74935,
      "text": "没有豪华的地宫，",
      "token_start": 249,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 75270,
      "end_ms": 76590,
      "text": "就一个夯土堆，",
      "token_start": 256,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 76830,
      "end_ms": 80125,
      "text": "前面立着石人石马孤零零站在麦田里。",
      "token_start": 262,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 80740,
      "end_ms": 81725,
      "text": "您可能要问了，",
      "token_start": 278,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 82180,
      "end_ms": 85525,
      "text": "宋朝那么富清明上河图里那么热闹，",
      "token_start": 284,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 85870,
      "end_ms": 87895,
      "text": "皇帝陵怎么修的这么寒酸？",
      "token_start": 299,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 88620,
      "end_ms": 90300,
      "text": "因为赵匡胤立了个规矩，",
      "token_start": 310,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 90440,
      "end_ms": 91325,
      "text": "叫驳葬，",
      "token_start": 320,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 91700,
      "end_ms": 93085,
      "text": "他自己就是这么做的。",
      "token_start": 323,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 93860,
      "end_ms": 97485,
      "text": "一座开国皇帝的陵藏在麦田里，",
      "token_start": 332,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 97870,
      "end_ms": 99495,
      "text": "石象生占了一千年，",
      "token_start": 345,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 99950,
      "end_ms": 101945,
      "text": "看着庄稼一茬一茬长，",
      "token_start": 353,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 102520,
      "end_ms": 105465,
      "text": "您说这是是寒酸还是通透？",
      "token_start": 362,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 106140,
      "end_ms": 106835,
      "text": "第九名，",
      "token_start": 373,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 107320,
      "end_ms": 115725,
      "text": "宁夏银川西夏亡陵在贺兰山东路一片戈壁滩上立着九座金字塔一样的土堆。",
      "token_start": 376,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 116240,
      "end_ms": 121565,
      "text": "西夏王朝党项人建的跟宋辽金打了将近两百年，",
      "token_start": 408,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 121970,
      "end_ms": 123555,
      "text": "最后被蒙古人灭了，",
      "token_start": 428,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 123790,
      "end_ms": 125065,
      "text": "亡灵也被砸了，",
      "token_start": 436,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 125330,
      "end_ms": 125795,
      "text": "烧了。",
      "token_start": 442,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 126430,
      "end_ms": 130195,
      "text": "但这些土堆到现在还站着快一千年了。",
      "token_start": 444,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 130590,
      "end_ms": 133090,
      "text": "这陵最邪乎的地方不是造型，",
      "token_start": 460,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 133090,
      "end_ms": 133995,
      "text": "像金字塔，",
      "token_start": 472,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 134350,
      "end_ms": 135290,
      "text": "是他不长草，",
      "token_start": 476,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 135530,
      "end_ms": 136265,
      "text": "也不落鸟。",
      "token_start": 481,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 137170,
      "end_ms": 139015,
      "text": "周围的戈壁上有草，",
      "token_start": 485,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 139430,
      "end_ms": 142885,
      "text": "唯独王陵的封土堆上寸草不生，",
      "token_start": 493,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 143440,
      "end_ms": 144815,
      "text": "鸟也不往上落。",
      "token_start": 506,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 145650,
      "end_ms": 147355,
      "text": "科学家研究了好多年，",
      "token_start": 512,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 147630,
      "end_ms": 148410,
      "text": "也没弄明白，",
      "token_start": 521,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 148410,
      "end_ms": 149330,
      "text": "到底为什么？",
      "token_start": 526,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 149350,
      "end_ms": 152345,
      "text": "有人说是夯土里掺了特殊材料，",
      "token_start": 531,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 152840,
      "end_ms": 154875,
      "text": "有人说是风水布局，",
      "token_start": 544,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 155620,
      "end_ms": 160345,
      "text": "您说一个被灭国的王朝留下一堆不长草的土堆，",
      "token_start": 552,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 161000,
      "end_ms": 162125,
      "text": "占了一千年，",
      "token_start": 572,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 163320,
      "end_ms": 165285,
      "text": "这世上哪儿说理去？",
      "token_start": 577,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 165840,
      "end_ms": 166480,
      "text": "第八名，",
      "token_start": 585,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 166820,
      "end_ms": 168485,
      "text": "陕西咸阳汉阳陵，",
      "token_start": 588,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 169340,
      "end_ms": 170300,
      "text": "汉武帝他爹，",
      "token_start": 595,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 170620,
      "end_ms": 172235,
      "text": "汉景帝刘启的灵。",
      "token_start": 600,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 173050,
      "end_ms": 175300,
      "text": "这灵最绝的不是灵，",
      "token_start": 607,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 175320,
      "end_ms": 175760,
      "text": "本身，",
      "token_start": 615,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 176080,
      "end_ms": 177935,
      "text": "是它旁边的陪葬坑。",
      "token_start": 617,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 178830,
      "end_ms": 180235,
      "text": "考古队挖开一看，",
      "token_start": 625,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 180680,
      "end_ms": 181420,
      "text": "好家伙，",
      "token_start": 632,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 181840,
      "end_ms": 184660,
      "text": "密密麻麻的陶俑不是兵马俑，",
      "token_start": 635,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 184660,
      "end_ms": 187245,
      "text": "那种真人大小的是缩小版的，",
      "token_start": 647,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 187730,
      "end_ms": 189710,
      "text": "只有真人三分之一大，",
      "token_start": 659,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 189790,
      "end_ms": 191215,
      "text": "但胳膊是木头的，",
      "token_start": 668,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 191460,
      "end_ms": 192025,
      "text": "能活动，",
      "token_start": 675,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 192450,
      "end_ms": 194495,
      "text": "身上穿着丝绸衣服，",
      "token_start": 678,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 194850,
      "end_ms": 195965,
      "text": "衣服早就烂了。",
      "token_start": 686,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 196440,
      "end_ms": 199805,
      "text": "但胳膊的关节还在几十万个陶俑，",
      "token_start": 692,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 200070,
      "end_ms": 204080,
      "text": "有当官的有当兵的、有太监、有宫女，",
      "token_start": 706,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 204300,
      "end_ms": 205840,
      "text": "还有猪马牛羊、鸡，",
      "token_start": 720,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 206140,
      "end_ms": 208835,
      "text": "甚至还有狗一座地下动物园。",
      "token_start": 727,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 209230,
      "end_ms": 209935,
      "text": "您想想，",
      "token_start": 739,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 210390,
      "end_ms": 217275,
      "text": "两千多年前的人做了一整套缩微版的人间社会埋在地下，",
      "token_start": 742,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 218650,
      "end_ms": 221105,
      "text": "这心思得有多细？",
      "token_start": 766,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 222510,
      "end_ms": 223145,
      "text": "第七名，",
      "token_start": 773,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 224510,
      "end_ms": 229155,
      "text": "陕西咸阳、唐昭陵、唐太宗李世民的陵，",
      "token_start": 776,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 229580,
      "end_ms": 231805,
      "text": "这陵最绝的地方不是地宫，",
      "token_start": 791,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 232130,
      "end_ms": 233175,
      "text": "是陪葬墓，",
      "token_start": 802,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 233640,
      "end_ms": 237145,
      "text": "昭陵周围埋了两百多座陪葬墓。",
      "token_start": 806,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 237960,
      "end_ms": 239415,
      "text": "您听听这些名字，",
      "token_start": 819,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 239790,
      "end_ms": 247095,
      "text": "魏征、房玄龄、李靖、秦琼、程咬金、长孙无忌、尉迟敬德，",
      "token_start": 826,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 247510,
      "end_ms": 249965,
      "text": "全是贞观年间响当当的人物。",
      "token_start": 846,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 250690,
      "end_ms": 254520,
      "text": "跟李世民打天下的那帮老兄弟死了以后，",
      "token_start": 858,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 254680,
      "end_ms": 257145,
      "text": "还围着他排着队守着，",
      "token_start": 875,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 257660,
      "end_ms": 258545,
      "text": "这还不算晚。",
      "token_start": 884,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 260060,
      "end_ms": 261875,
      "text": "昭陵北面祭坛上，",
      "token_start": 889,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 262310,
      "end_ms": 265655,
      "text": "原来立着六块浮雕叫昭陵六郡，",
      "token_start": 896,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 266040,
      "end_ms": 269565,
      "text": "是李世民当年骑过的六匹战马，",
      "token_start": 909,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 270250,
      "end_ms": 271590,
      "text": "每一匹都有名字，",
      "token_start": 922,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 271710,
      "end_ms": 272435,
      "text": "有故事，",
      "token_start": 929,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 273830,
      "end_ms": 279895,
      "text": "可惜其中两批一百多年前被人偷运出国，",
      "token_start": 932,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 280530,
      "end_ms": 282355,
      "text": "现在还在美国的博物馆里，",
      "token_start": 949,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 283220,
      "end_ms": 286915,
      "text": "四匹在国内六匹马分了两地。",
      "token_start": 960,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 287280,
      "end_ms": 290645,
      "text": "您说这算不算生前马上打天下？",
      "token_start": 972,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 291150,
      "end_ms": 291650,
      "text": "死后，",
      "token_start": 985,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 291690,
      "end_ms": 294815,
      "text": "战马守灵前第六名，",
      "token_start": 987,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 295830,
      "end_ms": 297405,
      "text": "北京昌平名十三陵，",
      "token_start": 995,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 298330,
      "end_ms": 301275,
      "text": "明朝十六个皇帝十三个埋在这儿。",
      "token_start": 1003,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 302270,
      "end_ms": 303535,
      "text": "这林最绝的。",
      "token_start": 1017,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 305130,
      "end_ms": 305890,
      "text": "不是规模，",
      "token_start": 1022,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 306250,
      "end_ms": 313069,
      "text": "是他有一个地宫被打开了定陵万历皇帝的陵。",
      "token_start": 1026,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 314670,
      "end_ms": 315690,
      "text": "一九五六年，",
      "token_start": 1045,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 315890,
      "end_ms": 325350,
      "text": "考古队主动挖的中国历史上第一座也是唯一一座用科学考古方法主动发掘的皇陵地宫。",
      "token_start": 1050,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 325350,
      "end_ms": 326110,
      "text": "打开以后，",
      "token_start": 1087,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 326390,
      "end_ms": 328370,
      "text": "出土了三千多件文物，",
      "token_start": 1091,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 328890,
      "end_ms": 329990,
      "text": "金冠凤冠，",
      "token_start": 1100,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 330490,
      "end_ms": 332930,
      "text": "龙袍、金银器数不清。",
      "token_start": 1104,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 333370,
      "end_ms": 334785,
      "text": "但那时候技术不行，",
      "token_start": 1112,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 335450,
      "end_ms": 338670,
      "text": "很多丝绸绒袍一接触空气，",
      "token_start": 1120,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 339050,
      "end_ms": 341610,
      "text": "当场就变黑变脆碎，",
      "token_start": 1131,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 341670,
      "end_ms": 344110,
      "text": "掉了三千件文物。",
      "token_start": 1139,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 344330,
      "end_ms": 345550,
      "text": "后来搬来搬去，",
      "token_start": 1146,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 345990,
      "end_ms": 347590,
      "text": "存放条件一直不好，",
      "token_start": 1152,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 347810,
      "end_ms": 351470,
      "text": "直到二零一五年才重新搬回地下，",
      "token_start": 1160,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 352270,
      "end_ms": 356270,
      "text": "这回是恒温恒湿专门盖的库房。",
      "token_start": 1174,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 356510,
      "end_ms": 362010,
      "text": "您说一座主动挖开的皇陵挖出来三千件宝贝，",
      "token_start": 1187,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 362370,
      "end_ms": 363745,
      "text": "结果保护不了，",
      "token_start": 1206,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 364080,
      "end_ms": 364845,
      "text": "又送回去，",
      "token_start": 1212,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 365570,
      "end_ms": 367705,
      "text": "这事是教训还是幸运？",
      "token_start": 1216,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 368080,
      "end_ms": 369465,
      "text": "从第十到第六，",
      "token_start": 1225,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 369760,
      "end_ms": 373610,
      "text": "北宋皇陵藏在麦田里西夏王陵不长草，",
      "token_start": 1231,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 373610,
      "end_ms": 375290,
      "text": "不落鸟汉阳陵，",
      "token_start": 1247,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 375330,
      "end_ms": 378890,
      "text": "埋着几十万缩微陶俑唐昭陵两百个，",
      "token_start": 1253,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 378890,
      "end_ms": 383145,
      "text": "老兄弟守着明定陵三千件文物挖出来又送回去。",
      "token_start": 1268,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 383690,
      "end_ms": 387015,
      "text": "可这五座还不是最邪乎，",
      "token_start": 1288,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 388180,
      "end_ms": 390075,
      "text": "接下来第五到第一，",
      "token_start": 1298,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 391310,
      "end_ms": 394540,
      "text": "一座比一座悬有一座陵山，",
      "token_start": 1306,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 394540,
      "end_ms": 400610,
      "text": "就是灵灵就是山整座山掏空铁水浇死四十万人，",
      "token_start": 1317,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 400610,
      "end_ms": 401430,
      "text": "挖了几个月，",
      "token_start": 1337,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 401610,
      "end_ms": 402995,
      "text": "连门都找不着，",
      "token_start": 1342,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 403360,
      "end_ms": 405705,
      "text": "还有一座根本找不到在哪？",
      "token_start": 1348,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 406200,
      "end_ms": 407985,
      "text": "全世界找了一百年，",
      "token_start": 1359,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 408530,
      "end_ms": 410115,
      "text": "连影子都没见着，",
      "token_start": 1367,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 410950,
      "end_ms": 411670,
      "text": "他是哪座，",
      "token_start": 1374,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 411810,
      "end_ms": 414945,
      "text": "他凭什么排第一下集马上更新，",
      "token_start": 1378,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 416000,
      "end_ms": 418420,
      "text": "您先点个关注点，",
      "token_start": 1391,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 418420,
      "end_ms": 421095,
      "text": "开头像别走丢。",
      "token_start": 1398,
      "token_end_exclusive": 1404
    }
  ],
