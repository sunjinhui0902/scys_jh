{
  "video_id": "v_158f32a208d4e3c0",
  "duration_s": 434.376009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_158f32a208d4e3c0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_158f32a208d4e3c0.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 270,
      "end_ms": 4290,
      "text": "您知道中国秋天最令人惊叹的风光是哪一处吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4530,
      "end_ms": 8130,
      "text": "有人说是长白山天池两千多米，",
      "token_start": 20,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8130,
      "end_ms": 9910,
      "text": "火山口九月，",
      "token_start": 33,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 9930,
      "end_ms": 14150,
      "text": "整座群峰被五花山色染成了绚丽彩锦。",
      "token_start": 38,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 14570,
      "end_ms": 17990,
      "text": "有人说是稻城亚丁两千多米，",
      "token_start": 54,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 18210,
      "end_ms": 20210,
      "text": "海拔落差深丘，",
      "token_start": 66,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 20290,
      "end_ms": 24890,
      "text": "万亩高丘草甸全化作了耀眼纯金错，",
      "token_start": 72,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 25790,
      "end_ms": 27990,
      "text": "长白山只能排到第六，",
      "token_start": 87,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 28510,
      "end_ms": 30840,
      "text": "稻城亚丁也不是第一，",
      "token_start": 96,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 31580,
      "end_ms": 35200,
      "text": "真正排在榜首的那处深藏。",
      "token_start": 105,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 35320,
      "end_ms": 38920,
      "text": "在极北边陲一汪高山大湖，",
      "token_start": 116,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 39240,
      "end_ms": 41420,
      "text": "一天能变好几种颜色，",
      "token_start": 127,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 42200,
      "end_ms": 42800,
      "text": "清晨，",
      "token_start": 136,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 42900,
      "end_ms": 48720,
      "text": "峡谷里还能生出像仙境一样在半空盘旋的白雾。",
      "token_start": 138,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 49020,
      "end_ms": 49440,
      "text": "今天，",
      "token_start": 158,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 49460,
      "end_ms": 53380,
      "text": "咱们就来盘点中国十大最令人惊叹的秋天，",
      "token_start": 160,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 53560,
      "end_ms": 54460,
      "text": "绝美风光。",
      "token_start": 178,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 55180,
      "end_ms": 55900,
      "text": "老规矩，",
      "token_start": 182,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 56180,
      "end_ms": 58780,
      "text": "劳烦您先扣个一点个红心，",
      "token_start": 185,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 59200,
      "end_ms": 64025,
      "text": "让我看看这今天都有哪些老朋友在听第十名。",
      "token_start": 196,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 64420,
      "end_ms": 66935,
      "text": "内蒙古呼伦贝尔额尔古纳湿地，",
      "token_start": 215,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 67580,
      "end_ms": 70475,
      "text": "他占地十二万六千公顷，",
      "token_start": 228,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 71200,
      "end_ms": 74445,
      "text": "坐落在根河与额尔古纳河交汇处，",
      "token_start": 238,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 75100,
      "end_ms": 77575,
      "text": "被叫做亚洲第一湿地。",
      "token_start": 252,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 78000,
      "end_ms": 78905,
      "text": "到了九月，",
      "token_start": 261,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 79360,
      "end_ms": 81275,
      "text": "大兴安岭的秋风一吹，",
      "token_start": 265,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 81850,
      "end_ms": 85235,
      "text": "整片湿地几乎一夜之间换的颜色，",
      "token_start": 274,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 85910,
      "end_ms": 90585,
      "text": "灌木草甸白桦林全染成了纯金。",
      "token_start": 288,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 90970,
      "end_ms": 94730,
      "text": "最绝的是额尔古纳河在金黄大地里，",
      "token_start": 301,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 94770,
      "end_ms": 96270,
      "text": "拐出无数道弯儿，",
      "token_start": 316,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 96690,
      "end_ms": 99090,
      "text": "像一条纯净的翡翠绸缎，",
      "token_start": 323,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 99230,
      "end_ms": 100445,
      "text": "在大地上舒展。",
      "token_start": 333,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 100870,
      "end_ms": 103250,
      "text": "您站在高处的木栈道上，",
      "token_start": 339,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 103330,
      "end_ms": 104155,
      "text": "往前看，",
      "token_start": 349,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 104700,
      "end_ms": 106475,
      "text": "视野拉开几十公里，",
      "token_start": 352,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 106980,
      "end_ms": 110695,
      "text": "那条河湾划出的圆弧流畅到极致，",
      "token_start": 360,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 111260,
      "end_ms": 114760,
      "text": "连掠过的风里都带着草木成熟的清香。",
      "token_start": 374,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 115160,
      "end_ms": 116415,
      "text": "大地当画布，",
      "token_start": 390,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 116730,
      "end_ms": 117955,
      "text": "江河当笔墨。",
      "token_start": 395,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 118590,
      "end_ms": 120610,
      "text": "您说这第一笔秋色够不够？",
      "token_start": 400,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 120610,
      "end_ms": 121095,
      "text": "惊艳？",
      "token_start": 411,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 121440,
      "end_ms": 122195,
      "text": "第九名，",
      "token_start": 413,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 122550,
      "end_ms": 126535,
      "text": "甘肃张掖七彩丹霞西北荒原上的奇迹。",
      "token_start": 416,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 127090,
      "end_ms": 129395,
      "text": "它核心面积五十多平方公里，",
      "token_start": 432,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 129910,
      "end_ms": 132905,
      "text": "上一年的地壳挤压与风雨雕琢，",
      "token_start": 444,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 133340,
      "end_ms": 137845,
      "text": "把彩色泥岩砂岩揉成了连绵起伏的丘陵。",
      "token_start": 457,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 138270,
      "end_ms": 140325,
      "text": "别的秋天是看草木变色。",
      "token_start": 474,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 140770,
      "end_ms": 141710,
      "text": "张掖的秋天，",
      "token_start": 484,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 141710,
      "end_ms": 143295,
      "text": "看的却是大地的筋骨。",
      "token_start": 489,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 143700,
      "end_ms": 144200,
      "text": "秋季，",
      "token_start": 498,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 144280,
      "end_ms": 146715,
      "text": "大西北的天空瓦蓝通透，",
      "token_start": 500,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 147030,
      "end_ms": 148005,
      "text": "毫无杂质。",
      "token_start": 510,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 148560,
      "end_ms": 151965,
      "text": "当午后的斜阳打在起伏的山峦上，",
      "token_start": 514,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 152410,
      "end_ms": 155300,
      "text": "红橙黄青灰，",
      "token_start": 528,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 155780,
      "end_ms": 157595,
      "text": "一层层清晰分明。",
      "token_start": 533,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 158100,
      "end_ms": 162835,
      "text": "整片荒原就像被铺上了一层厚厚的巨幅油画，",
      "token_start": 540,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 163260,
      "end_ms": 165215,
      "text": "狂风刮了上千万年，",
      "token_start": 559,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 165900,
      "end_ms": 168045,
      "text": "不仅没吹干他的生机，",
      "token_start": 567,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 168680,
      "end_ms": 171485,
      "text": "反倒吹出了最磅礴的文理，",
      "token_start": 576,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 172110,
      "end_ms": 175275,
      "text": "连石头都能在秋天烧的这么绚烂，",
      "token_start": 587,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 176170,
      "end_ms": 179245,
      "text": "您说这算不算大自然的鬼斧神工？",
      "token_start": 601,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 179660,
      "end_ms": 180400,
      "text": "第八名，",
      "token_start": 615,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 180720,
      "end_ms": 183815,
      "text": "四川米亚罗红叶阿坝州李县，",
      "token_start": 618,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 184660,
      "end_ms": 186995,
      "text": "很多人去川西看雪山，",
      "token_start": 630,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 187540,
      "end_ms": 192905,
      "text": "却不知道秋天的米亚罗才是整个川西最红火的地方。",
      "token_start": 639,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 193280,
      "end_ms": 196595,
      "text": "红叶顺着杂谷脑河两岸一路铺开，",
      "token_start": 661,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 197160,
      "end_ms": 200085,
      "text": "从海拔两千多米铺到三千多米，",
      "token_start": 675,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 200650,
      "end_ms": 202175,
      "text": "每往上走一节，",
      "token_start": 688,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 202550,
      "end_ms": 205170,
      "text": "颜色就换一层山脚，",
      "token_start": 694,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 205270,
      "end_ms": 208065,
      "text": "还是黄绿半山已经成红。",
      "token_start": 702,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 208570,
      "end_ms": 210895,
      "text": "再往上红里掺着雪，",
      "token_start": 712,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 211400,
      "end_ms": 213515,
      "text": "十月中下旬最盛，",
      "token_start": 720,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 214090,
      "end_ms": 215365,
      "text": "一眼看过去，",
      "token_start": 727,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 215800,
      "end_ms": 218105,
      "text": "满山满谷全是红的，",
      "token_start": 732,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 218660,
      "end_ms": 220775,
      "text": "被远处的雪山一衬，",
      "token_start": 740,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 221240,
      "end_ms": 222365,
      "text": "红的更透。",
      "token_start": 748,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 223000,
      "end_ms": 225345,
      "text": "溪水从林子里穿过去，",
      "token_start": 752,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 225800,
      "end_ms": 230105,
      "text": "也被印成了红的这不是一两棵树红了，",
      "token_start": 761,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 230500,
      "end_ms": 233685,
      "text": "是整条山沟在同一时间烧了起来，",
      "token_start": 777,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 234260,
      "end_ms": 236435,
      "text": "您说这么大的气势，",
      "token_start": 791,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 236840,
      "end_ms": 238565,
      "text": "谁看了不得愣一会儿。",
      "token_start": 799,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 238930,
      "end_ms": 239715,
      "text": "第七名，",
      "token_start": 808,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 240150,
      "end_ms": 244385,
      "text": "新疆塔里木胡杨林、塔克拉玛干沙漠边缘。",
      "token_start": 811,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 245040,
      "end_ms": 247115,
      "text": "这里是胡阳最集中的地方，",
      "token_start": 828,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 247730,
      "end_ms": 251434,
      "text": "全世界九成左右的胡杨林在中国，",
      "token_start": 839,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 252190,
      "end_ms": 255335,
      "text": "中国的胡杨又绝大部分长在塔里木。",
      "token_start": 853,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 255780,
      "end_ms": 258135,
      "text": "这片土地一年下不了几场雨，",
      "token_start": 868,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 258690,
      "end_ms": 259945,
      "text": "一边是流沙，",
      "token_start": 880,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 260290,
      "end_ms": 262480,
      "text": "一边是戈壁胡杨，",
      "token_start": 885,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 262560,
      "end_ms": 264365,
      "text": "偏偏就在这扎了根，",
      "token_start": 892,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 265050,
      "end_ms": 267055,
      "text": "他的根能往地下扎十几米，",
      "token_start": 900,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 267510,
      "end_ms": 269350,
      "text": "一路找水叶子，",
      "token_start": 911,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 269350,
      "end_ms": 271455,
      "text": "还能把多余的盐分排出去。",
      "token_start": 917,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 271910,
      "end_ms": 272750,
      "text": "人们常说，",
      "token_start": 928,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 273250,
      "end_ms": 276040,
      "text": "活着一千年不死死了，",
      "token_start": 932,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 276040,
      "end_ms": 277145,
      "text": "一千年不倒，",
      "token_start": 941,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 277520,
      "end_ms": 278000,
      "text": "倒下，",
      "token_start": 946,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 278020,
      "end_ms": 279015,
      "text": "一千年不朽。",
      "token_start": 948,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 279360,
      "end_ms": 280555,
      "text": "到了十月中旬，",
      "token_start": 953,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 281120,
      "end_ms": 282875,
      "text": "满树的叶子一起变金，",
      "token_start": 959,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 283670,
      "end_ms": 286475,
      "text": "金黄的树冠倒映在塔里木河里，",
      "token_start": 968,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 286900,
      "end_ms": 292325,
      "text": "水面也成了金的背后就是沙丘这么苍凉的地方。",
      "token_start": 981,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 293140,
      "end_ms": 294980,
      "text": "开出这么亮的颜色，",
      "token_start": 1001,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 295620,
      "end_ms": 297980,
      "text": "您说这是什么样的生命力？",
      "token_start": 1009,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 298220,
      "end_ms": 298940,
      "text": "第六名，",
      "token_start": 1020,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 299420,
      "end_ms": 302880,
      "text": "吉林长白山天池、延边安图。",
      "token_start": 1023,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 303560,
      "end_ms": 305880,
      "text": "它是中国和朝鲜的界湖，",
      "token_start": 1034,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 306620,
      "end_ms": 308880,
      "text": "更是一座火山的口子。",
      "token_start": 1044,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 309360,
      "end_ms": 311740,
      "text": "水面海拔两千一百八十九米，",
      "token_start": 1053,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 312300,
      "end_ms": 314740,
      "text": "湖水最深三百七十三米，",
      "token_start": 1065,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 315160,
      "end_ms": 317660,
      "text": "差不多是一座一百层的高峰，",
      "token_start": 1075,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 317960,
      "end_ms": 319400,
      "text": "倒着插进了湖里，",
      "token_start": 1087,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 319700,
      "end_ms": 322575,
      "text": "周围十六座山峰把它抱在怀里。",
      "token_start": 1094,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 322990,
      "end_ms": 324270,
      "text": "这是一座活火山，",
      "token_start": 1107,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 324930,
      "end_ms": 327450,
      "text": "与一千年前有过一次大喷发，",
      "token_start": 1114,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 328050,
      "end_ms": 329070,
      "text": "炸出了山顶。",
      "token_start": 1126,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 329110,
      "end_ms": 330030,
      "text": "这么大一个口，",
      "token_start": 1131,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 330630,
      "end_ms": 334150,
      "text": "雨水和雪水慢慢把它灌满水深，",
      "token_start": 1137,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 334590,
      "end_ms": 336010,
      "text": "所以蓝得发黑。",
      "token_start": 1150,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 336410,
      "end_ms": 338210,
      "text": "九月五花山上了，",
      "token_start": 1156,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 338210,
      "end_ms": 341990,
      "text": "色绿的黄的、红的、红的，",
      "token_start": 1163,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 342210,
      "end_ms": 343370,
      "text": "一片挨着一片，",
      "token_start": 1172,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 343650,
      "end_ms": 344750,
      "text": "围着这帮深蓝，",
      "token_start": 1178,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 345250,
      "end_ms": 347010,
      "text": "可高山上说变就变，",
      "token_start": 1184,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 347370,
      "end_ms": 348450,
      "text": "一阵雾过来，",
      "token_start": 1192,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 348870,
      "end_ms": 350190,
      "text": "整个湖就没了。",
      "token_start": 1197,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 350190,
      "end_ms": 351990,
      "text": "影大半年冰封，",
      "token_start": 1203,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 352630,
      "end_ms": 355135,
      "text": "只给秋天留这么短短一段，",
      "token_start": 1209,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 355820,
      "end_ms": 359555,
      "text": "您说这样的兰谁看的不惊叹？",
      "token_start": 1220,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 359940,
      "end_ms": 361460,
      "text": "从第十到第六名，",
      "token_start": 1232,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 361700,
      "end_ms": 365825,
      "text": "额尔古纳师弟把河湾画成了一笔金线，",
      "token_start": 1239,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 366550,
      "end_ms": 370085,
      "text": "张掖丹霞把调色板打翻在了隔壁上。",
      "token_start": 1255,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 370600,
      "end_ms": 373505,
      "text": "尼亚罗红叶烧红了整条山沟，",
      "token_start": 1270,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 374230,
      "end_ms": 378820,
      "text": "塔里木胡杨一战就是千年长白山天池，",
      "token_start": 1282,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 378820,
      "end_ms": 381815,
      "text": "把三百多米的深蓝藏进了火山口，",
      "token_start": 1298,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 382410,
      "end_ms": 385005,
      "text": "可他们还不是最令人惊叹的。",
      "token_start": 1312,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 385430,
      "end_ms": 387675,
      "text": "接下来第五道第一名更厉害，",
      "token_start": 1324,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 388050,
      "end_ms": 389005,
      "text": "有一处地方，",
      "token_start": 1336,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 389680,
      "end_ms": 397005,
      "text": "几百年一层一层垒出来的山稻子一黄整座山都像在发光。",
      "token_start": 1341,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 397450,
      "end_ms": 398655,
      "text": "有一处沟谷，",
      "token_start": 1365,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 399100,
      "end_ms": 400665,
      "text": "三千多个池子，",
      "token_start": 1370,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 401120,
      "end_ms": 402385,
      "text": "一池一个颜色，",
      "token_start": 1376,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 402820,
      "end_ms": 405155,
      "text": "边上的林子一片金黄。",
      "token_start": 1382,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 405530,
      "end_ms": 407435,
      "text": "可排在榜首的那一处，",
      "token_start": 1391,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 408110,
      "end_ms": 408770,
      "text": "一天里，",
      "token_start": 1400,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 408770,
      "end_ms": 410335,
      "text": "湖水换几个颜色，",
      "token_start": 1403,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 411030,
      "end_ms": 414255,
      "text": "连老辈人都说不清他到底有几副面孔，",
      "token_start": 1410,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 414820,
      "end_ms": 415825,
      "text": "他是哪一处？",
      "token_start": 1426,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 416410,
      "end_ms": 422325,
      "text": "他凭什么排在天池和鸭丁前面下一集已经同步更新，",
      "token_start": 1431,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 423090,
      "end_ms": 424485,
      "text": "点开我的头像，",
      "token_start": 1453,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 425100,
      "end_ms": 428675,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1459,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 429150,
      "end_ms": 433305,
      "text": "看看谁才是中国秋天最令人惊叹的风光。",
      "token_start": 1471,
      "token_end_exclusive": 1488
    }
  ],
