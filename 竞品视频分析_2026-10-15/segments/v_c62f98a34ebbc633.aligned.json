  "segments": [
    {
      "start_ms": 480,
      "end_ms": 2580,
      "text": "我曾经不止一次的想过，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3180,
      "end_ms": 4620,
      "text": "祖国到底是什么？",
      "token_start": 10,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 5400,
      "end_ms": 6000,
      "text": "它是山，",
      "token_start": 17,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 6520,
      "end_ms": 8340,
      "text": "是海、是森林，",
      "token_start": 20,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 8340,
      "end_ms": 9040,
      "text": "是草地，",
      "token_start": 25,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 9480,
      "end_ms": 10180,
      "text": "是村庄，",
      "token_start": 28,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 10180,
      "end_ms": 10900,
      "text": "是城市，",
      "token_start": 31,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 11400,
      "end_ms": 13240,
      "text": "是茫茫无垠的沙漠。",
      "token_start": 34,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 14260,
      "end_ms": 15280,
      "text": "祖国是什么？",
      "token_start": 42,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 15740,
      "end_ms": 16579,
      "text": "她是炊烟，",
      "token_start": 47,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 16940,
      "end_ms": 17660,
      "text": "是歌哨，",
      "token_start": 51,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 18220,
      "end_ms": 19400,
      "text": "是端午的龙舟，",
      "token_start": 54,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 19820,
      "end_ms": 21080,
      "text": "是中秋的火把，",
      "token_start": 60,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 21820,
      "end_ms": 25140,
      "text": "是妈妈在平底锅上烙出的煎饼，",
      "token_start": 66,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 25620,
      "end_ms": 31750,
      "text": "是父亲在远行时的嘤嘤叮咛祖国是什么？",
      "token_start": 79,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 32090,
      "end_ms": 35230,
      "text": "它是孔子老子庄子的思考，",
      "token_start": 96,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 35810,
      "end_ms": 36490,
      "text": "是屈原。",
      "token_start": 107,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 36790,
      "end_ms": 38530,
      "text": "李白、陆游的诗，",
      "token_start": 110,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 39210,
      "end_ms": 40610,
      "text": "是韩愈、柳宗元。",
      "token_start": 116,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 41070,
      "end_ms": 46010,
      "text": "苏轼的散文是李煜、李清照、辛弃疾的词，",
      "token_start": 122,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 47110,
      "end_ms": 49590,
      "text": "世界上有许多美好的地方。",
      "token_start": 138,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 49970,
      "end_ms": 52350,
      "text": "但是那里有黄山吗？",
      "token_start": 149,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 52810,
      "end_ms": 53830,
      "text": "有黄河吗？",
      "token_start": 157,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 54270,
      "end_ms": 55270,
      "text": "有长江吗？",
      "token_start": 161,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 55810,
      "end_ms": 56890,
      "text": "有长城吗？",
      "token_start": 165,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 57610,
      "end_ms": 57850,
      "text": "有，",
      "token_start": 169,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 57850,
      "end_ms": 62295,
      "text": "我和我的亲友们都已习惯了的那些民风民俗吗？",
      "token_start": 170,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 63090,
      "end_ms": 63250,
      "text": "有，",
      "token_start": 190,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 63250,
      "end_ms": 68085,
      "text": "我一开口哼唱就已经觉得荡气回肠的乡音吗？",
      "token_start": 191,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 69120,
      "end_ms": 69580,
      "text": "没有，",
      "token_start": 210,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 70170,
      "end_ms": 71605,
      "text": "既然这些都没有，",
      "token_start": 212,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 72170,
      "end_ms": 75745,
      "text": "那么祖国就是一个不可替代的地方。",
      "token_start": 219,
      "token_end_exclusive": 234
    }
  ],
