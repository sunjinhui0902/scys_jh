{
  "video_id": "v_94919cc1dd04b49f",
  "duration_s": 667.272993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_94919cc1dd04b49f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_94919cc1dd04b49f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 340,
      "end_ms": 740,
      "text": "朱君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1140,
      "end_ms": 2100,
      "text": "你敢相信吗？",
      "token_start": 2,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2360,
      "end_ms": 5280,
      "text": "全世界最多的黄金就藏在这里，",
      "token_start": 7,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5700,
      "end_ms": 7800,
      "text": "这是地球上最富有的城市，",
      "token_start": 20,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 7940,
      "end_ms": 10000,
      "text": "但也是流浪汉最多的地方。",
      "token_start": 31,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 10320,
      "end_ms": 13480,
      "text": "为什么每天都能排队来摸一头牛的蛋蛋？",
      "token_start": 42,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 14080,
      "end_ms": 14500,
      "text": "今天，",
      "token_start": 59,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 14520,
      "end_ms": 18100,
      "text": "挑战带你一口气走进美国纽约世界。",
      "token_start": 61,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 18100,
      "end_ms": 20320,
      "text": "这本书终于翻到了东海岸。",
      "token_start": 76,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 20320,
      "end_ms": 31450,
      "text": "这一出了趟国仿佛没出过一样随处可见的中餐馆。",
      "token_start": 87,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 31550,
      "end_ms": 33310,
      "text": "你看这老外擀面皮贼溜，",
      "token_start": 108,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 33690,
      "end_ms": 34290,
      "text": "公园里，",
      "token_start": 118,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 34290,
      "end_ms": 36590,
      "text": "中国的大爷大妈广场舞跳的热闹。",
      "token_start": 121,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 37210,
      "end_ms": 40550,
      "text": "这是纽约华人庆祝祖国的国庆锣鼓喧天，",
      "token_start": 135,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 40610,
      "end_ms": 41550,
      "text": "鞭炮齐鸣，",
      "token_start": 152,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 41550,
      "end_ms": 42330,
      "text": "人山人海，",
      "token_start": 156,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 42790,
      "end_ms": 43370,
      "text": "你知道吗？",
      "token_start": 160,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 43370,
      "end_ms": 44430,
      "text": "就在国庆期间，",
      "token_start": 164,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 44610,
      "end_ms": 47670,
      "text": "纽约的bapup way改名为广东大道。",
      "token_start": 170,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 49990,
      "end_ms": 52230,
      "text": "朱今都知道美国有五十个州，",
      "token_start": 182,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 52410,
      "end_ms": 54250,
      "text": "其实是五十三个州，",
      "token_start": 194,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 54490,
      "end_ms": 56950,
      "text": "还有温州、广州和福州。",
      "token_start": 202,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 57550,
      "end_ms": 58330,
      "text": "你能想象吗？",
      "token_start": 211,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 58330,
      "end_ms": 59170,
      "text": "在美国纽约，",
      "token_start": 216,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 59190,
      "end_ms": 60005,
      "text": "寸土寸金，",
      "token_start": 221,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 60420,
      "end_ms": 63895,
      "text": "曼哈顿市中心还有福建人、林则徐的雕像。",
      "token_start": 225,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 64380,
      "end_ms": 65540,
      "text": "在纽约的法拉盛，",
      "token_start": 242,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 65540,
      "end_ms": 66905,
      "text": "你根本不需要讲英文，",
      "token_start": 249,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 67120,
      "end_ms": 68575,
      "text": "讲福建话就可以了。",
      "token_start": 258,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 69140,
      "end_ms": 70940,
      "text": "纽约总人口八百多万人，",
      "token_start": 266,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 71080,
      "end_ms": 73325,
      "text": "这里的人竟然有九十七种性别，",
      "token_start": 276,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 73710,
      "end_ms": 75630,
      "text": "他一个城市就超过了全世界。",
      "token_start": 289,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 75630,
      "end_ms": 78990,
      "text": "百分之九十国家的GDP站在华尔街，",
      "token_start": 301,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 78990,
      "end_ms": 81015,
      "text": "就像掉进了金钱的深渊里。",
      "token_start": 315,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 81450,
      "end_ms": 83630,
      "text": "全世界最大的纽约证券交易所，",
      "token_start": 326,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 83750,
      "end_ms": 87095,
      "text": "它一天的交易额比很多国家一年的财政收入还要多。",
      "token_start": 339,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 87870,
      "end_ms": 90050,
      "text": "纽交所门口站着一个五位女孩，",
      "token_start": 361,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 90230,
      "end_ms": 93095,
      "text": "象征着男女平等对金钱和权力的挑战。",
      "token_start": 374,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 93830,
      "end_ms": 95200,
      "text": "朱军十年后，",
      "token_start": 390,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 95280,
      "end_ms": 96815,
      "text": "这里会有你的位置吗？",
      "token_start": 395,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 97390,
      "end_ms": 98070,
      "text": "总有一天，",
      "token_start": 404,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 98130,
      "end_ms": 99955,
      "text": "我一定会闯出一番天地的。",
      "token_start": 408,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 100470,
      "end_ms": 103190,
      "text": "你看这两个大弹是不是被摸得锃亮，",
      "token_start": 419,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 103270,
      "end_ms": 104214,
      "text": "牛气冲天。",
      "token_start": 434,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 104870,
      "end_ms": 106290,
      "text": "附近呢就是纳斯达克，",
      "token_start": 438,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 106310,
      "end_ms": 107555,
      "text": "还有联邦大厅。",
      "token_start": 447,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 108040,
      "end_ms": 111160,
      "text": "一七八九年华盛顿就是在这里阳台上宣誓，",
      "token_start": 453,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 111160,
      "end_ms": 112760,
      "text": "成为美利坚合众国。",
      "token_start": 471,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 112760,
      "end_ms": 116895,
      "text": "第一任总统华尔街边上就是纽约联储的地下金库，",
      "token_start": 479,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 117160,
      "end_ms": 119295,
      "text": "存放着来自全世界的黄金。",
      "token_start": 500,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 119670,
      "end_ms": 120545,
      "text": "更不可思议的是，",
      "token_start": 511,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 120780,
      "end_ms": 122975,
      "text": "这些黄金大多并不是美国自己的，",
      "token_start": 518,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 123240,
      "end_ms": 125680,
      "text": "而是世界各国把黄金送到纽约，",
      "token_start": 532,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 125860,
      "end_ms": 127335,
      "text": "让他来替自己保管。",
      "token_start": 545,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 128120,
      "end_ms": 130490,
      "text": "而且你手上的金镯子的价格，",
      "token_start": 553,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 130490,
      "end_ms": 131855,
      "text": "明天是涨还是跌？",
      "token_start": 565,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 132280,
      "end_ms": 135175,
      "text": "金价很大程度上由纽约期货市场说了算。",
      "token_start": 572,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 135780,
      "end_ms": 138845,
      "text": "水晶发达国家并不是现在才发达的，",
      "token_start": 589,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 139010,
      "end_ms": 140585,
      "text": "而是他们一直都很发达。",
      "token_start": 604,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 141050,
      "end_ms": 144525,
      "text": "你看到的这些曼哈顿的建筑群已经存在一百多年了，",
      "token_start": 614,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 144910,
      "end_ms": 145870,
      "text": "难怪一百多年前，",
      "token_start": 636,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 145870,
      "end_ms": 148390,
      "text": "李鸿章峰、纽约回来之后就一言不发。",
      "token_start": 643,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 149180,
      "end_ms": 158425,
      "text": "布鲁克林大桥一八八三年建成世界第一座钢铁大桥李鸿章当年也建过这座桥一百二十年前的一九零四年。",
      "token_start": 658,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 158750,
      "end_ms": 160245,
      "text": "纽约的地铁正式开通，",
      "token_start": 703,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 160580,
      "end_ms": 162840,
      "text": "如今他已经老旧脏乱，",
      "token_start": 712,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 162980,
      "end_ms": 165915,
      "text": "但始终让纽约这个庞然大物日夜奔流。",
      "token_start": 721,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 166570,
      "end_ms": 167470,
      "text": "一九三零年，",
      "token_start": 737,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 167470,
      "end_ms": 170775,
      "text": "美国家庭的汽车普及率已经超过了百分之五十，",
      "token_start": 742,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 171130,
      "end_ms": 175110,
      "text": "而当时每四个人里面就已经有一个人拥有汽车周军。",
      "token_start": 762,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 175110,
      "end_ms": 179310,
      "text": "你看世界上最细的牙签楼摩天楼有多极端？",
      "token_start": 784,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 179330,
      "end_ms": 180810,
      "text": "它只有十九米宽，",
      "token_start": 802,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 180950,
      "end_ms": 182525,
      "text": "却有四百三十五米高，",
      "token_start": 809,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 182880,
      "end_ms": 184040,
      "text": "这么高风一吹，",
      "token_start": 818,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 184300,
      "end_ms": 185885,
      "text": "顶层的人会不会晕船呢？",
      "token_start": 824,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 186370,
      "end_ms": 186730,
      "text": "纽约，",
      "token_start": 834,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 186730,
      "end_ms": 189405,
      "text": "这是我去过的全世界最复杂的一座城市。",
      "token_start": 836,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 189720,
      "end_ms": 192600,
      "text": "你在地图上能找到的任何国家和地区，",
      "token_start": 853,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 192760,
      "end_ms": 194315,
      "text": "都会有人住在纽约。",
      "token_start": 869,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 194800,
      "end_ms": 196775,
      "text": "你在纽约见到什么都不会奇怪，",
      "token_start": 877,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 197060,
      "end_ms": 198985,
      "text": "因为联合国总部就在这里，",
      "token_start": 890,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 199270,
      "end_ms": 201010,
      "text": "但是纽约又不容易迷路。",
      "token_start": 901,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 201150,
      "end_ms": 202005,
      "text": "路很规整，",
      "token_start": 911,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 202180,
      "end_ms": 205655,
      "text": "横平竖直的横着的叫街竖着的叫大道，",
      "token_start": 915,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 205880,
      "end_ms": 207735,
      "text": "有一条斜着的就是百老汇。",
      "token_start": 931,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 208120,
      "end_ms": 211365,
      "text": "其中第五大道相当于曼哈顿的南北中轴线，",
      "token_start": 942,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 211790,
      "end_ms": 216510,
      "text": "五大道的起点是四百四十三米的帝国大厦建立于一九三一年，",
      "token_start": 960,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 216630,
      "end_ms": 218555,
      "text": "只用了四百一十天就建成。",
      "token_start": 986,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 219000,
      "end_ms": 222175,
      "text": "当时纽约掀起了一场世界第一高楼的疯狂竞赛，",
      "token_start": 997,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 222610,
      "end_ms": 224950,
      "text": "与他竞争的那栋楼在华尔街四十号，",
      "token_start": 1017,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 224990,
      "end_ms": 228830,
      "text": "现在叫特朗普大厦第五大道中心就是洛克菲勒中心。",
      "token_start": 1032,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 228970,
      "end_ms": 232435,
      "text": "这哥们被评为人类历史上一辈子挣钱最多的一个人。",
      "token_start": 1054,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 232720,
      "end_ms": 234710,
      "text": "从一个穷小子逆携程，",
      "token_start": 1076,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 234730,
      "end_ms": 237195,
      "text": "全世界三分之二的油田都是他的，",
      "token_start": 1085,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 237600,
      "end_ms": 240885,
      "text": "但是他给后代立下的规矩就是千万不要做生意。",
      "token_start": 1099,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 241400,
      "end_ms": 243700,
      "text": "第五大道上面还有大都会艺术博物馆，",
      "token_start": 1119,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 243740,
      "end_ms": 245415,
      "text": "收藏着大量的中国文物，",
      "token_start": 1135,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 245740,
      "end_ms": 248380,
      "text": "尤其是汝窑竟然就随便放在走廊上，",
      "token_start": 1145,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 248560,
      "end_ms": 251125,
      "text": "而武大道的尽头就是时代广场，",
      "token_start": 1160,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 251380,
      "end_ms": 255015,
      "text": "号称世界十字路口人生小长沙解放路。",
      "token_start": 1173,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 255590,
      "end_ms": 258830,
      "text": "时代广场上的屏幕呢是可以花钱直接现场投屏的。",
      "token_start": 1189,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 258910,
      "end_ms": 262895,
      "text": "你花小几百美金就可以把自己的照片在上面出现几十秒。",
      "token_start": 1210,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 263440,
      "end_ms": 266160,
      "text": "这里最酷的可不是无人驾驶的赛博新车，",
      "token_start": 1234,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 266260,
      "end_ms": 268385,
      "text": "而是朴实无华的三墩子。",
      "token_start": 1251,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 269010,
      "end_ms": 269730,
      "text": "万万没想到，",
      "token_start": 1261,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 269730,
      "end_ms": 271250,
      "text": "美国人学会了第一句中国话，",
      "token_start": 1266,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 271250,
      "end_ms": 276300,
      "text": "竟然是请注意倒车刘军，",
      "token_start": 1278,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 276420,
      "end_ms": 277675,
      "text": "这是一张十美元。",
      "token_start": 1288,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 277960,
      "end_ms": 284495,
      "text": "上面印着的是美国金融之父汉密尔顿、现代、美国的起点就是从这张十美元起价的。",
      "token_start": 1295,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 284900,
      "end_ms": 286880,
      "text": "美国刚建国的时候非常穷。",
      "token_start": 1329,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 287140,
      "end_ms": 289380,
      "text": "国务卿杰弗逊坚持农业立国，",
      "token_start": 1340,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 289460,
      "end_ms": 293145,
      "text": "但是财政部长海密尔顿则主张发展制造业和金融业。",
      "token_start": 1352,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 293530,
      "end_ms": 294775,
      "text": "两个人吵了十几年。",
      "token_start": 1374,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 295030,
      "end_ms": 297270,
      "text": "也成了美国两党制的雏形。",
      "token_start": 1382,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 297510,
      "end_ms": 297930,
      "text": "最后，",
      "token_start": 1393,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 298030,
      "end_ms": 299790,
      "text": "国会通过了汉密尔顿的方案。",
      "token_start": 1395,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 299950,
      "end_ms": 304750,
      "text": "于是一个崭新的美国就此开始凭借着华尔街的融资和并购，",
      "token_start": 1407,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 304850,
      "end_ms": 307030,
      "text": "美国的基建开始飞速发展。",
      "token_start": 1432,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 307310,
      "end_ms": 308810,
      "text": "到了一八八零年代，",
      "token_start": 1443,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 308870,
      "end_ms": 313790,
      "text": "美国已经诞生了通用电器、可口可乐、杜邦这样的世界级企业。",
      "token_start": 1451,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 313990,
      "end_ms": 314570,
      "text": "而今天，",
      "token_start": 1476,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 314650,
      "end_ms": 321290,
      "text": "纽约排名前五的企业分别是摩根大通、花旗银行、高盛、摩根、史丹利这样的金融机构，",
      "token_start": 1479,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 321290,
      "end_ms": 322770,
      "text": "再加上辉瑞制药，",
      "token_start": 1513,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 322770,
      "end_ms": 324270,
      "text": "而你能想象吗？",
      "token_start": 1520,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 324270,
      "end_ms": 328900,
      "text": "纽纽约在十七世纪只是一个靠渔业为生的小据点，",
      "token_start": 1526,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 329260,
      "end_ms": 331900,
      "text": "当时被荷兰殖民者称为新阿姆斯克丹，",
      "token_start": 1547,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 332060,
      "end_ms": 337100,
      "text": "后来被英国人夺取之后取名为new york.中文应该叫新乡哦，",
      "token_start": 1563,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 337100,
      "end_ms": 337340,
      "text": "不，",
      "token_start": 1586,
      "token_end_exclusive": 1587
    },
    {
      "start_ms": 337380,
      "end_ms": 339920,
      "text": "纽约周军你知道多可怕吗？",
      "token_start": 1587,
      "token_end_exclusive": 1598
    },
    {
      "start_ms": 340100,
      "end_ms": 342380,
      "text": "从一八九零年至今一百多年了，",
      "token_start": 1598,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 342380,
      "end_ms": 347200,
      "text": "美国始终是全球第一大经济体、全球市值最高的一百家上市公司，",
      "token_start": 1611,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 347320,
      "end_ms": 350980,
      "text": "美国占了六十二家纽约、香港、伦敦，",
      "token_start": 1638,
      "token_end_exclusive": 1652
    },
    {
      "start_ms": 351080,
      "end_ms": 352600,
      "text": "并称为纽伦港，",
      "token_start": 1652,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 352660,
      "end_ms": 354515,
      "text": "是全球三大金融中心。",
      "token_start": 1658,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 355120,
      "end_ms": 357560,
      "text": "虽然美国依然是经济超级大国，",
      "token_start": 1667,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 357600,
      "end_ms": 359215,
      "text": "但是难掩颓势，",
      "token_start": 1680,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 359780,
      "end_ms": 362105,
      "text": "大家千万可别把美国想象的特别美好。",
      "token_start": 1686,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 362380,
      "end_ms": 364275,
      "text": "不管你是在纽约还是在洛杉矶，",
      "token_start": 1702,
      "token_end_exclusive": 1715
    },
    {
      "start_ms": 364590,
      "end_ms": 366515,
      "text": "其实市区都是非常脏乱的，",
      "token_start": 1715,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 366760,
      "end_ms": 367900,
      "text": "随处可见垃圾，",
      "token_start": 1726,
      "token_end_exclusive": 1732
    },
    {
      "start_ms": 368020,
      "end_ms": 369505,
      "text": "还总有一股尿骚味儿。",
      "token_start": 1732,
      "token_end_exclusive": 1741
    },
    {
      "start_ms": 369910,
      "end_ms": 373895,
      "text": "我个人最接受不了的就是美国的小费文化已经完全变质了。",
      "token_start": 1741,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 374150,
      "end_ms": 375490,
      "text": "本来应该是自愿给的，",
      "token_start": 1766,
      "token_end_exclusive": 1775
    },
    {
      "start_ms": 375530,
      "end_ms": 377425,
      "text": "现在普遍给付百分之二十，",
      "token_start": 1775,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 377810,
      "end_ms": 379790,
      "text": "墙上到处各种乱涂乱画。",
      "token_start": 1786,
      "token_end_exclusive": 1796
    },
    {
      "start_ms": 379890,
      "end_ms": 381055,
      "text": "纽约不养闲人，",
      "token_start": 1796,
      "token_end_exclusive": 1802
    },
    {
      "start_ms": 381850,
      "end_ms": 383030,
      "text": "自由是一种放大镜，",
      "token_start": 1802,
      "token_end_exclusive": 1810
    },
    {
      "start_ms": 383070,
      "end_ms": 385505,
      "text": "它把人的勇敢、天真和善良会放大，",
      "token_start": 1810,
      "token_end_exclusive": 1824
    },
    {
      "start_ms": 385750,
      "end_ms": 389815,
      "text": "但也会把人性的懒、蝉、贪渍都加倍放大。",
      "token_start": 1824,
      "token_end_exclusive": 1840
    },
    {
      "start_ms": 390330,
      "end_ms": 392550,
      "text": "纽约是繁华与先进的代名词，",
      "token_start": 1840,
      "token_end_exclusive": 1852
    },
    {
      "start_ms": 392630,
      "end_ms": 394905,
      "text": "也是自由与罪恶的综合体。",
      "token_start": 1852,
      "token_end_exclusive": 1863
    },
    {
      "start_ms": 395540,
      "end_ms": 398185,
      "text": "你看这自由女神像是法国赠送的铜像，",
      "token_start": 1863,
      "token_end_exclusive": 1879
    },
    {
      "start_ms": 398410,
      "end_ms": 399665,
      "text": "他一开始是金色的，",
      "token_start": 1879,
      "token_end_exclusive": 1887
    },
    {
      "start_ms": 399870,
      "end_ms": 401985,
      "text": "我们现在看到的绿色是铜锈，",
      "token_start": 1887,
      "token_end_exclusive": 1899
    },
    {
      "start_ms": 402510,
      "end_ms": 405610,
      "text": "这斑驳的铜锈就像日渐衰落的美国，",
      "token_start": 1899,
      "token_end_exclusive": 1914
    },
    {
      "start_ms": 405690,
      "end_ms": 407655,
      "text": "已经不再是世界的灯塔。",
      "token_start": 1914,
      "token_end_exclusive": 1924
    },
    {
      "start_ms": 408010,
      "end_ms": 408390,
      "text": "周军，",
      "token_start": 1924,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 408390,
      "end_ms": 409035,
      "text": "你知道吗？",
      "token_start": 1926,
      "token_end_exclusive": 1930
    },
    {
      "start_ms": 409360,
      "end_ms": 412345,
      "text": "世界上最长的路就是美国人的下坡路。",
      "token_start": 1930,
      "token_end_exclusive": 1946
    },
    {
      "start_ms": 412720,
      "end_ms": 413600,
      "text": "从我记事起，",
      "token_start": 1946,
      "token_end_exclusive": 1951
    },
    {
      "start_ms": 413600,
      "end_ms": 414945,
      "text": "他就一直在走下坡路。",
      "token_start": 1951,
      "token_end_exclusive": 1960
    },
    {
      "start_ms": 415370,
      "end_ms": 417610,
      "text": "世界上最硬的脚就是美国人的脚，",
      "token_start": 1960,
      "token_end_exclusive": 1974
    },
    {
      "start_ms": 417750,
      "end_ms": 420185,
      "text": "因为他们总是搬起石头砸自己的脚。",
      "token_start": 1974,
      "token_end_exclusive": 1989
    },
    {
      "start_ms": 420610,
      "end_ms": 421105,
      "text": "朱军，",
      "token_start": 1989,
      "token_end_exclusive": 1991
    },
    {
      "start_ms": 421450,
      "end_ms": 423645,
      "text": "你是不是总是听人说美国快要完蛋了，",
      "token_start": 1991,
      "token_end_exclusive": 2007
    },
    {
      "start_ms": 423920,
      "end_ms": 424800,
      "text": "霸权崩溃，",
      "token_start": 2007,
      "token_end_exclusive": 2011
    },
    {
      "start_ms": 424820,
      "end_ms": 425685,
      "text": "社会撕裂，",
      "token_start": 2011,
      "token_end_exclusive": 2015
    },
    {
      "start_ms": 425970,
      "end_ms": 427145,
      "text": "产业空心化等等。",
      "token_start": 2015,
      "token_end_exclusive": 2022
    },
    {
      "start_ms": 427720,
      "end_ms": 428620,
      "text": "但是事实上，",
      "token_start": 2022,
      "token_end_exclusive": 2027
    },
    {
      "start_ms": 428820,
      "end_ms": 433025,
      "text": "我发现真的是没有人比美国人更懂得如何收割世界的人才。",
      "token_start": 2027,
      "token_end_exclusive": 2052
    },
    {
      "start_ms": 433720,
      "end_ms": 434060,
      "text": "你看，",
      "token_start": 2052,
      "token_end_exclusive": 2054
    },
    {
      "start_ms": 434060,
      "end_ms": 436160,
      "text": "美国当今活跃的这些科技强人，",
      "token_start": 2054,
      "token_end_exclusive": 2067
    },
    {
      "start_ms": 436200,
      "end_ms": 437455,
      "text": "其实都是进口来的。",
      "token_start": 2067,
      "token_end_exclusive": 2075
    },
    {
      "start_ms": 437830,
      "end_ms": 444475,
      "text": "马斯克来自非洲、黄仁勋、苏资峰、李菲菲、来自中国、微软和谷歌的CEO都来自印度。",
      "token_start": 2075,
      "token_end_exclusive": 2107
    },
    {
      "start_ms": 444950,
      "end_ms": 445930,
      "text": "而你能想象吗？",
      "token_start": 2107,
      "token_end_exclusive": 2113
    },
    {
      "start_ms": 446010,
      "end_ms": 448170,
      "text": "从一九七八年到二零一五年，",
      "token_start": 2113,
      "token_end_exclusive": 2125
    },
    {
      "start_ms": 448270,
      "end_ms": 452895,
      "text": "光硅谷一个小地方就吸纳了两万多名中国、清华大学的毕业生，",
      "token_start": 2125,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 453250,
      "end_ms": 454510,
      "text": "年轻人去往哪里，",
      "token_start": 2151,
      "token_end_exclusive": 2158
    },
    {
      "start_ms": 454610,
      "end_ms": 456085,
      "text": "财富就流往哪里。",
      "token_start": 2158,
      "token_end_exclusive": 2165
    },
    {
      "start_ms": 456420,
      "end_ms": 460115,
      "text": "我们中国也正在为吸纳世界级的人才准备一片沃土，",
      "token_start": 2165,
      "token_end_exclusive": 2187
    },
    {
      "start_ms": 460420,
      "end_ms": 463800,
      "text": "要让全世界的顶尖人才争着抢着来，",
      "token_start": 2187,
      "token_end_exclusive": 2202
    },
    {
      "start_ms": 463800,
      "end_ms": 466625,
      "text": "给中国发展良情择木而泣。",
      "token_start": 2202,
      "token_end_exclusive": 2213
    },
    {
      "start_ms": 467020,
      "end_ms": 467240,
      "text": "当然，",
      "token_start": 2213,
      "token_end_exclusive": 2215
    },
    {
      "start_ms": 467240,
      "end_ms": 469120,
      "text": "美国也不只是盯着我们中国人，",
      "token_start": 2215,
      "token_end_exclusive": 2228
    },
    {
      "start_ms": 469120,
      "end_ms": 471145,
      "text": "他吸引的是来自全世界的人才。",
      "token_start": 2228,
      "token_end_exclusive": 2241
    },
    {
      "start_ms": 471470,
      "end_ms": 473815,
      "text": "我这几天在纽约的哥伦比亚大学上课，",
      "token_start": 2241,
      "token_end_exclusive": 2257
    },
    {
      "start_ms": 474180,
      "end_ms": 475700,
      "text": "诺贝尔奖得主克教授，",
      "token_start": 2257,
      "token_end_exclusive": 2266
    },
    {
      "start_ms": 475760,
      "end_ms": 478265,
      "text": "他就是德国人被美国给吸纳进来的。",
      "token_start": 2266,
      "token_end_exclusive": 2281
    },
    {
      "start_ms": 478890,
      "end_ms": 481790,
      "text": "美国自己公布的二零二五年博士大普查，",
      "token_start": 2281,
      "token_end_exclusive": 2298
    },
    {
      "start_ms": 482030,
      "end_ms": 484770,
      "text": "中国籍的博士仍然数量位居第一，",
      "token_start": 2298,
      "token_end_exclusive": 2312
    },
    {
      "start_ms": 484890,
      "end_ms": 487595,
      "text": "近八成毕业的时候打算留在美国。",
      "token_start": 2312,
      "token_end_exclusive": 2326
    },
    {
      "start_ms": 488100,
      "end_ms": 492075,
      "text": "所以以后的竞争本质上就是中国人和中国人的竞争。",
      "token_start": 2326,
      "token_end_exclusive": 2348
    },
    {
      "start_ms": 492490,
      "end_ms": 495935,
      "text": "在中国的中国人和他们在美国的中国人之间的镜头，",
      "token_start": 2348,
      "token_end_exclusive": 2370
    },
    {
      "start_ms": 496310,
      "end_ms": 503790,
      "text": "我身后就是美国常青藤高校哥伦比亚大学在纽约历史最古老的大学始建于一七五四年，",
      "token_start": 2370,
      "token_end_exclusive": 2407
    },
    {
      "start_ms": 503870,
      "end_ms": 505395,
      "text": "比美国建国还早，",
      "token_start": 2407,
      "token_end_exclusive": 2414
    },
    {
      "start_ms": 505740,
      "end_ms": 508365,
      "text": "从这里走出了八十八位诺贝尔奖得主。",
      "token_start": 2414,
      "token_end_exclusive": 2430
    },
    {
      "start_ms": 508780,
      "end_ms": 511765,
      "text": "李政道当年就是在这里拿下诺贝尔物理学奖，",
      "token_start": 2430,
      "token_end_exclusive": 2449
    },
    {
      "start_ms": 512060,
      "end_ms": 513260,
      "text": "从这里走出了北大。",
      "token_start": 2449,
      "token_end_exclusive": 2457
    },
    {
      "start_ms": 513280,
      "end_ms": 528025,
      "text": "三位校长胡是蒋梦琳、马英初、南开大学创始人张柏林猴氏制检法发明人、侯德榜原子弹之母、吴建雄大哲学家、冯友兰社会学泰斗、潘光诞、平民教育家、陶行知等等。",
      "token_start": 2457,
      "token_end_exclusive": 2523
    },
    {
      "start_ms": 528280,
      "end_ms": 530125,
      "text": "中国近代史的半壁江山，",
      "token_start": 2523,
      "token_end_exclusive": 2533
    },
    {
      "start_ms": 530360,
      "end_ms": 531745,
      "text": "都在纽约读过书。",
      "token_start": 2533,
      "token_end_exclusive": 2540
    },
    {
      "start_ms": 532090,
      "end_ms": 532490,
      "text": "朱今，",
      "token_start": 2540,
      "token_end_exclusive": 2542
    },
    {
      "start_ms": 532670,
      "end_ms": 535275,
      "text": "我们要很理性的看待中外的差距。",
      "token_start": 2542,
      "token_end_exclusive": 2556
    },
    {
      "start_ms": 535610,
      "end_ms": 537310,
      "text": "我发现很多人会嘲笑他们，",
      "token_start": 2556,
      "token_end_exclusive": 2567
    },
    {
      "start_ms": 537310,
      "end_ms": 538430,
      "text": "国外没有支付宝，",
      "token_start": 2567,
      "token_end_exclusive": 2574
    },
    {
      "start_ms": 538530,
      "end_ms": 540415,
      "text": "于是就简单的得出个结论，",
      "token_start": 2574,
      "token_end_exclusive": 2585
    },
    {
      "start_ms": 540630,
      "end_ms": 542435,
      "text": "他们的移动支付太落后了。",
      "token_start": 2585,
      "token_end_exclusive": 2596
    },
    {
      "start_ms": 542850,
      "end_ms": 543725,
      "text": "但事实上呢，",
      "token_start": 2596,
      "token_end_exclusive": 2601
    },
    {
      "start_ms": 544010,
      "end_ms": 545285,
      "text": "其实他们用apple pay ir,",
      "token_start": 2601,
      "token_end_exclusive": 2609
    },
    {
      "start_ms": 545620,
      "end_ms": 547860,
      "text": "完全不需要二维码碰一下就能支付，",
      "token_start": 2609,
      "token_end_exclusive": 2624
    },
    {
      "start_ms": 547960,
      "end_ms": 548860,
      "text": "我自己也试过，",
      "token_start": 2624,
      "token_end_exclusive": 2630
    },
    {
      "start_ms": 548980,
      "end_ms": 550185,
      "text": "其实真的非常方便。",
      "token_start": 2630,
      "token_end_exclusive": 2638
    },
    {
      "start_ms": 550640,
      "end_ms": 553700,
      "text": "再比如很多人说咱们中国是高铁强国，",
      "token_start": 2638,
      "token_end_exclusive": 2654
    },
    {
      "start_ms": 553780,
      "end_ms": 555880,
      "text": "但是你看美国连高铁都没有，",
      "token_start": 2654,
      "token_end_exclusive": 2666
    },
    {
      "start_ms": 555940,
      "end_ms": 557045,
      "text": "是因为他们很穷。",
      "token_start": 2666,
      "token_end_exclusive": 2673
    },
    {
      "start_ms": 557510,
      "end_ms": 558475,
      "text": "但事实真的吗？",
      "token_start": 2673,
      "token_end_exclusive": 2679
    },
    {
      "start_ms": 558850,
      "end_ms": 562765,
      "text": "其实有一个原因是因为他们飞机实在是太多了。",
      "token_start": 2679,
      "token_end_exclusive": 2699
    },
    {
      "start_ms": 563210,
      "end_ms": 564370,
      "text": "我们中国有机场，",
      "token_start": 2699,
      "token_end_exclusive": 2706
    },
    {
      "start_ms": 564450,
      "end_ms": 566335,
      "text": "大大小小加起来五百多座，",
      "token_start": 2706,
      "token_end_exclusive": 2717
    },
    {
      "start_ms": 566630,
      "end_ms": 569785,
      "text": "而美国竟然有一万九千多座机场。",
      "token_start": 2717,
      "token_end_exclusive": 2731
    },
    {
      "start_ms": 570160,
      "end_ms": 572425,
      "text": "真正的自信可不是把世界看低，",
      "token_start": 2731,
      "token_end_exclusive": 2744
    },
    {
      "start_ms": 572710,
      "end_ms": 574245,
      "text": "而是把世界看清。",
      "token_start": 2744,
      "token_end_exclusive": 2751
    },
    {
      "start_ms": 574960,
      "end_ms": 577560,
      "text": "其实我发现美国适合两类人移民到这里，",
      "token_start": 2751,
      "token_end_exclusive": 2768
    },
    {
      "start_ms": 577560,
      "end_ms": 579615,
      "text": "一种是特别有钱的超级大土豪。",
      "token_start": 2768,
      "token_end_exclusive": 2781
    },
    {
      "start_ms": 579900,
      "end_ms": 581845,
      "text": "这种在全球各地都是舒适圈，",
      "token_start": 2781,
      "token_end_exclusive": 2793
    },
    {
      "start_ms": 582120,
      "end_ms": 586095,
      "text": "还有一种就是底层的凭手艺吃饭呢能够挣到辛苦钱，",
      "token_start": 2793,
      "token_end_exclusive": 2815
    },
    {
      "start_ms": 586570,
      "end_ms": 589525,
      "text": "最怕的就是夹在中间的普通中产阶层。",
      "token_start": 2815,
      "token_end_exclusive": 2831
    },
    {
      "start_ms": 589970,
      "end_ms": 593515,
      "text": "我见过很多在国内卖掉了北上广深仅有的一套房子，",
      "token_start": 2831,
      "token_end_exclusive": 2853
    },
    {
      "start_ms": 593830,
      "end_ms": 595605,
      "text": "然后使尽了全身的力气。",
      "token_start": 2853,
      "token_end_exclusive": 2863
    },
    {
      "start_ms": 595860,
      "end_ms": 597925,
      "text": "为了孩子来这儿接娃的陪读父母。",
      "token_start": 2863,
      "token_end_exclusive": 2877
    },
    {
      "start_ms": 598270,
      "end_ms": 599710,
      "text": "这类人群是最痛苦的，",
      "token_start": 2877,
      "token_end_exclusive": 2886
    },
    {
      "start_ms": 599850,
      "end_ms": 604150,
      "text": "因为他们失去了人民币制造的现金流和社会地位非常憋屈的。",
      "token_start": 2886,
      "token_end_exclusive": 2912
    },
    {
      "start_ms": 604150,
      "end_ms": 605990,
      "text": "在这里做边缘的二等公民，",
      "token_start": 2912,
      "token_end_exclusive": 2923
    },
    {
      "start_ms": 606230,
      "end_ms": 607130,
      "text": "但是又不甘心，",
      "token_start": 2923,
      "token_end_exclusive": 2929
    },
    {
      "start_ms": 607230,
      "end_ms": 608450,
      "text": "承认自己选错了。",
      "token_start": 2929,
      "token_end_exclusive": 2936
    },
    {
      "start_ms": 609190,
      "end_ms": 612470,
      "text": "其实这些年我见过很多海外的华人都非常爱国，",
      "token_start": 2936,
      "token_end_exclusive": 2956
    },
    {
      "start_ms": 612590,
      "end_ms": 613710,
      "text": "也很关心祖国。",
      "token_start": 2956,
      "token_end_exclusive": 2962
    },
    {
      "start_ms": 614190,
      "end_ms": 616290,
      "text": "有些人嘴上说已经习惯了纽约，",
      "token_start": 2962,
      "token_end_exclusive": 2975
    },
    {
      "start_ms": 616430,
      "end_ms": 621190,
      "text": "但手机里的天气预报永远关注的是自己的家乡、北京、成都、武汉等等。",
      "token_start": 2975,
      "token_end_exclusive": 3003
    },
    {
      "start_ms": 621710,
      "end_ms": 624610,
      "text": "他们特别像从中国出发的蒲公英种子，",
      "token_start": 3003,
      "token_end_exclusive": 3019
    },
    {
      "start_ms": 624810,
      "end_ms": 626290,
      "text": "一阵时代的风吹过，",
      "token_start": 3019,
      "token_end_exclusive": 3027
    },
    {
      "start_ms": 626370,
      "end_ms": 630260,
      "text": "他们就散落到了世界各地求学谋生成家，",
      "token_start": 3027,
      "token_end_exclusive": 3044
    },
    {
      "start_ms": 630620,
      "end_ms": 631460,
      "text": "一次远行，",
      "token_start": 3044,
      "token_end_exclusive": 3048
    },
    {
      "start_ms": 631660,
      "end_ms": 632780,
      "text": "最后变成了一生。",
      "token_start": 3048,
      "token_end_exclusive": 3055
    },
    {
      "start_ms": 633280,
      "end_ms": 634460,
      "text": "在外面过得好的，",
      "token_start": 3055,
      "token_end_exclusive": 3062
    },
    {
      "start_ms": 634560,
      "end_ms": 635840,
      "text": "我们真心为你高兴，",
      "token_start": 3062,
      "token_end_exclusive": 3070
    },
    {
      "start_ms": 636199,
      "end_ms": 637180,
      "text": "过得不容易的。",
      "token_start": 3070,
      "token_end_exclusive": 3076
    },
    {
      "start_ms": 637180,
      "end_ms": 639360,
      "text": "也希望你知道千里万里之外，",
      "token_start": 3076,
      "token_end_exclusive": 3088
    },
    {
      "start_ms": 639460,
      "end_ms": 640800,
      "text": "还有人牵挂着你。",
      "token_start": 3088,
      "token_end_exclusive": 3095
    },
    {
      "start_ms": 641040,
      "end_ms": 643840,
      "text": "爱故乡从来不意味着必须生活在故乡，",
      "token_start": 3095,
      "token_end_exclusive": 3111
    },
    {
      "start_ms": 644159,
      "end_ms": 645580,
      "text": "只需要风吹到哪里，",
      "token_start": 3111,
      "token_end_exclusive": 3119
    },
    {
      "start_ms": 645740,
      "end_ms": 646660,
      "text": "你就在哪里。",
      "token_start": 3119,
      "token_end_exclusive": 3124
    },
    {
      "start_ms": 646860,
      "end_ms": 648400,
      "text": "好好生长朱君，",
      "token_start": 3124,
      "token_end_exclusive": 3130
    },
    {
      "start_ms": 648680,
      "end_ms": 650620,
      "text": "欢迎来到纽约为你，",
      "token_start": 3130,
      "token_end_exclusive": 3138
    },
    {
      "start_ms": 650680,
      "end_ms": 651860,
      "text": "他已等候多时。",
      "token_start": 3138,
      "token_end_exclusive": 3144
    },
    {
      "start_ms": 652460,
      "end_ms": 653180,
      "text": "四百年前，",
      "token_start": 3144,
      "token_end_exclusive": 3148
    },
    {
      "start_ms": 653180,
      "end_ms": 656000,
      "text": "当第一批远航者的帆船驶入哈德逊河时，",
      "token_start": 3148,
      "token_end_exclusive": 3165
    },
    {
      "start_ms": 656160,
      "end_ms": 659065,
      "text": "这座城市的传奇便悄然开篇。",
      "token_start": 3165,
      "token_end_exclusive": 3177
    },
    {
      "start_ms": 659530,
      "end_ms": 660250,
      "text": "时至今日，",
      "token_start": 3177,
      "token_end_exclusive": 3181
    },
    {
      "start_ms": 660470,
      "end_ms": 662665,
      "text": "纽约依旧在创造传奇，",
      "token_start": 3181,
      "token_end_exclusive": 3190
    },
    {
      "start_ms": 663000,
      "end_ms": 666505,
      "text": "而每一个奔赴纽约的人本身就是传奇。",
      "token_start": 3190,
      "token_end_exclusive": 3206
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
