{
  "video_id": "v_1b225d87255676fa",
  "duration_s": 523.448276,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1b225d87255676fa.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1b225d87255676fa.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 2070,
      "text": "一九六四年十月十六日，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2070,
      "end_ms": 4890,
      "text": "新疆罗布泊内一声巨响，",
      "token_start": 10,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5070,
      "end_ms": 5910,
      "text": "撕裂长空，",
      "token_start": 20,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6370,
      "end_ms": 8350,
      "text": "一团蘑菇云拔地而起，",
      "token_start": 24,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8710,
      "end_ms": 10330,
      "text": "全中国都沸腾了。",
      "token_start": 33,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 10870,
      "end_ms": 12850,
      "text": "北京街头人山人海，",
      "token_start": 40,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 13350,
      "end_ms": 14770,
      "text": "全世界都懵了。",
      "token_start": 48,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 14950,
      "end_ms": 19370,
      "text": "那个穷的叮当响被人封锁了个严严实实的中国，",
      "token_start": 54,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 19790,
      "end_ms": 22950,
      "text": "怎么就造出为国争气的原子弹呢？",
      "token_start": 74,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 23990,
      "end_ms": 24570,
      "text": "可各位，",
      "token_start": 88,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 24750,
      "end_ms": 25890,
      "text": "你们想过没有？",
      "token_start": 91,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26250,
      "end_ms": 31440,
      "text": "这枚原子弹背后站着一个伟大女人没有他，",
      "token_start": 97,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 32320,
      "end_ms": 36700,
      "text": "中国第一颗核爆的心脏至少还要多卡好几年。",
      "token_start": 115,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 36880,
      "end_ms": 38240,
      "text": "诡异的是什么呢？",
      "token_start": 134,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 38920,
      "end_ms": 39920,
      "text": "成功之后，",
      "token_start": 141,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 40280,
      "end_ms": 43580,
      "text": "所有的报纸上找不到他的名字。",
      "token_start": 145,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 44360,
      "end_ms": 47580,
      "text": "所有的庆功队伍里看不见他的人，",
      "token_start": 158,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 48420,
      "end_ms": 50680,
      "text": "他就像人间蒸发了一样，",
      "token_start": 172,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 51120,
      "end_ms": 53140,
      "text": "一消失就是三十年。",
      "token_start": 182,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 54060,
      "end_ms": 54940,
      "text": "他去哪儿了？",
      "token_start": 190,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 55800,
      "end_ms": 56980,
      "text": "他是什么身份？",
      "token_start": 195,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 57260,
      "end_ms": 58600,
      "text": "他为什么要消失？",
      "token_start": 201,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 59120,
      "end_ms": 66175,
      "text": "今天我就带你认识下这位中国最不能出名的女科学家。",
      "token_start": 208,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 66670,
      "end_ms": 69695,
      "text": "王成书故事得从老上海说起。",
      "token_start": 231,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 70350,
      "end_ms": 72165,
      "text": "一九一二年六月二十六日，",
      "token_start": 243,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 72660,
      "end_ms": 75600,
      "text": "王成书出生在上海一个书香门第，",
      "token_start": 254,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 75680,
      "end_ms": 78640,
      "text": "名字取自尚书家里四个姐妹，",
      "token_start": 268,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 78640,
      "end_ms": 79585,
      "text": "她排行第二，",
      "token_start": 280,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 79960,
      "end_ms": 82065,
      "text": "是全家的真人计算器。",
      "token_start": 285,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 82690,
      "end_ms": 84735,
      "text": "家里人经常喊二小姐，",
      "token_start": 294,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 84940,
      "end_ms": 85755,
      "text": "快来算个账。",
      "token_start": 303,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 86710,
      "end_ms": 87405,
      "text": "没办法，",
      "token_start": 308,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 87720,
      "end_ms": 90075,
      "text": "这姑娘数学考试从来都是第一。",
      "token_start": 311,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 90690,
      "end_ms": 95325,
      "text": "一九三零年十八岁的他考进燕京大学物理系。",
      "token_start": 324,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 95890,
      "end_ms": 96450,
      "text": "那一年，",
      "token_start": 343,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 96470,
      "end_ms": 98635,
      "text": "物理系只招了十三个学生，",
      "token_start": 346,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 99070,
      "end_ms": 101675,
      "text": "其中十二个男的和一个女的。",
      "token_start": 357,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 101980,
      "end_ms": 109580,
      "text": "那个女学生就是她那个年代什么风言风语都有说什么女孩子读什么理科王成书，",
      "token_start": 369,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 109620,
      "end_ms": 110400,
      "text": "不吵不闹，",
      "token_start": 403,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 110420,
      "end_ms": 110995,
      "text": "不打架，",
      "token_start": 407,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 111310,
      "end_ms": 112005,
      "text": "他就考试。",
      "token_start": 410,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 112620,
      "end_ms": 114095,
      "text": "从大一考到大四，",
      "token_start": 414,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 114510,
      "end_ms": 117085,
      "text": "全系总是第一雷打不动。",
      "token_start": 421,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 117920,
      "end_ms": 119425,
      "text": "一九三四年毕业，",
      "token_start": 431,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 119890,
      "end_ms": 121450,
      "text": "他们那一届十三个人，",
      "token_start": 438,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 121990,
      "end_ms": 123970,
      "text": "最后拿到学位的只有四个人，",
      "token_start": 447,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 124570,
      "end_ms": 125530,
      "text": "他还是榜首，",
      "token_start": 459,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 126170,
      "end_ms": 129650,
      "text": "甚至还捧走了学校的最高荣誉金钥匙奖。",
      "token_start": 464,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 130310,
      "end_ms": 131630,
      "text": "他要强还拼命。",
      "token_start": 481,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 132490,
      "end_ms": 136470,
      "text": "一九三六年拿下了燕大硕士留校任教。",
      "token_start": 487,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 136830,
      "end_ms": 143170,
      "text": "一九三九年战火纷飞他和物理学家张文玉在昆明成了婚。",
      "token_start": 503,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 143670,
      "end_ms": 146590,
      "text": "一九四一年两口子一起赴美留学，",
      "token_start": 527,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 146690,
      "end_ms": 148810,
      "text": "进了密歇根大学王成书，",
      "token_start": 541,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 148830,
      "end_ms": 153340,
      "text": "败在世界物理学权威人物乌伦贝克门下王成书，",
      "token_start": 551,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 153340,
      "end_ms": 154700,
      "text": "这个学生有多恐怖？",
      "token_start": 571,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 155180,
      "end_ms": 157620,
      "text": "一九四四年拿到博士学位。",
      "token_start": 579,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 158100,
      "end_ms": 159120,
      "text": "一九五一年，",
      "token_start": 590,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 159140,
      "end_ms": 165700,
      "text": "他和导师一起解开了困扰国际学界多年的气体书韵难题。",
      "token_start": 595,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 165740,
      "end_ms": 176840,
      "text": "方程直接以两个人的姓氏命名王成书乌伦贝克方程简称WCU方程学术发表即轰动世件。",
      "token_start": 619,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 177260,
      "end_ms": 178160,
      "text": "直到今天，",
      "token_start": 655,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 178180,
      "end_ms": 179475,
      "text": "这个领域的论文里，",
      "token_start": 659,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 179790,
      "end_ms": 183670,
      "text": "还在引用导师乌伦贝克放话，",
      "token_start": 667,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 183750,
      "end_ms": 187825,
      "text": "我这个学生只要留在美国诺贝尔奖就是时间问题。",
      "token_start": 679,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 188540,
      "end_ms": 190085,
      "text": "诺贝尔奖啊朋友们，",
      "token_start": 700,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 190560,
      "end_ms": 193625,
      "text": "多少人一辈子摸不着边的东西，",
      "token_start": 708,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 194060,
      "end_ms": 195835,
      "text": "在他那儿就是个时间问题，",
      "token_start": 721,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 196700,
      "end_ms": 198395,
      "text": "可就在这个节骨眼上。",
      "token_start": 732,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 198860,
      "end_ms": 201185,
      "text": "一九四九年十月一日，",
      "token_start": 741,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 201700,
      "end_ms": 204365,
      "text": "新中国成立的消息漂洋过海，",
      "token_start": 750,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 205060,
      "end_ms": 209945,
      "text": "王成书和张文玉做了个让所有美国同行崩溃的决定，",
      "token_start": 762,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 210750,
      "end_ms": 213375,
      "text": "回到祖国美国这边不放牛。",
      "token_start": 784,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 214410,
      "end_ms": 216395,
      "text": "朝鲜战争刚刚爆发，",
      "token_start": 795,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 217180,
      "end_ms": 223365,
      "text": "美方直接禁止中国学者李靖中间不乏监视传讯扣资料。",
      "token_start": 803,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 224210,
      "end_ms": 226365,
      "text": "有个美国教授说的更直白了，",
      "token_start": 826,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 226890,
      "end_ms": 230895,
      "text": "这些人回去就是潜在的核武制造者，",
      "token_start": 838,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 231870,
      "end_ms": 232665,
      "text": "越阻拦，",
      "token_start": 853,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 232880,
      "end_ms": 233775,
      "text": "他越铁了心。",
      "token_start": 856,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 234360,
      "end_ms": 235825,
      "text": "为了保住科研资料，",
      "token_start": 861,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 236390,
      "end_ms": 239195,
      "text": "他把书刊分成三百多个邮包，",
      "token_start": 869,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 240000,
      "end_ms": 241480,
      "text": "跑去不同的邮局，",
      "token_start": 881,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 241840,
      "end_ms": 250580,
      "text": "像蚂蚁搬家一样一点点寄回北京邮包的重量加起来足足有九百公斤左右。",
      "token_start": 888,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 251640,
      "end_ms": 253160,
      "text": "夹当宋人的宋人，",
      "token_start": 919,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 253520,
      "end_ms": 256019,
      "text": "美方开出再优渥的条件，",
      "token_start": 926,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 256200,
      "end_ms": 257880,
      "text": "他眼皮都不抬一下。",
      "token_start": 936,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 259260,
      "end_ms": 260820,
      "text": "整整七年的时间，",
      "token_start": 944,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 260980,
      "end_ms": 263740,
      "text": "国家在日内瓦谈判上据理力争，",
      "token_start": 951,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 264280,
      "end_ms": 266320,
      "text": "美国不得不解除禁令。",
      "token_start": 964,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 267000,
      "end_ms": 268540,
      "text": "一九五六年十月，",
      "token_start": 973,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 269000,
      "end_ms": 271490,
      "text": "双脚一踏上祖国的土地，",
      "token_start": 980,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 271930,
      "end_ms": 276810,
      "text": "他在笔记里就写在离别的十五年的祖国国境上。",
      "token_start": 990,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 277230,
      "end_ms": 280030,
      "text": "第一次看到五星红旗在空中飘扬，",
      "token_start": 1010,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 280510,
      "end_ms": 282010,
      "text": "心里说不出的兴奋。",
      "token_start": 1024,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 282510,
      "end_ms": 284170,
      "text": "我要为国家做贡献，",
      "token_start": 1032,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 284430,
      "end_ms": 285590,
      "text": "国家需要什么，",
      "token_start": 1040,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 285690,
      "end_ms": 287410,
      "text": "我就干什么这话，",
      "token_start": 1046,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 287410,
      "end_ms": 289695,
      "text": "他真就用一辈子去兑现。",
      "token_start": 1053,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 290370,
      "end_ms": 291270,
      "text": "一九五八年，",
      "token_start": 1063,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 291710,
      "end_ms": 293070,
      "text": "前三强上门找，",
      "token_start": 1068,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 293070,
      "end_ms": 297030,
      "text": "他说国家要建热核聚变研究室，",
      "token_start": 1074,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 297110,
      "end_ms": 298810,
      "text": "国内这个项目还一片空白，",
      "token_start": 1087,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 299010,
      "end_ms": 300550,
      "text": "让你挑头干不干。",
      "token_start": 1098,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 301330,
      "end_ms": 302690,
      "text": "他已经四十六岁，",
      "token_start": 1105,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 302930,
      "end_ms": 304370,
      "text": "专业已经定了型，",
      "token_start": 1112,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 304910,
      "end_ms": 307470,
      "text": "这跟研究了二十年的锡箔气体，",
      "token_start": 1119,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 307470,
      "end_ms": 308890,
      "text": "根本是两码事儿，",
      "token_start": 1132,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 309390,
      "end_ms": 311750,
      "text": "等于从教授退回小学生，",
      "token_start": 1139,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 312110,
      "end_ms": 313710,
      "text": "但是他只回了仨字，",
      "token_start": 1149,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 314150,
      "end_ms": 314850,
      "text": "我愿意。",
      "token_start": 1157,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 315470,
      "end_ms": 316650,
      "text": "一九六一年，",
      "token_start": 1160,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 316830,
      "end_ms": 318870,
      "text": "苏联的专家全部撤走，",
      "token_start": 1165,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 319250,
      "end_ms": 320880,
      "text": "图纸也卷走，",
      "token_start": 1174,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 321080,
      "end_ms": 322840,
      "text": "核抱最要命的一步，",
      "token_start": 1179,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 323520,
      "end_ms": 325300,
      "text": "浓缩又卡死了，",
      "token_start": 1187,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 326160,
      "end_ms": 328299,
      "text": "前三强把话给他挑明了。",
      "token_start": 1193,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 328980,
      "end_ms": 331160,
      "text": "这件事要绝对保密，",
      "token_start": 1203,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 331380,
      "end_ms": 332560,
      "text": "不能发表论文，",
      "token_start": 1211,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 332560,
      "end_ms": 335600,
      "text": "不能出席任何学术会议去向。",
      "token_start": 1217,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 335640,
      "end_ms": 337080,
      "text": "不能告诉任何人，",
      "token_start": 1229,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 337420,
      "end_ms": 338580,
      "text": "包括你的丈夫，",
      "token_start": 1236,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 339460,
      "end_ms": 342240,
      "text": "干这个项目等于物理学家王成书，",
      "token_start": 1242,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 342260,
      "end_ms": 344500,
      "text": "这个人就在社会上消失了。",
      "token_start": 1256,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 345040,
      "end_ms": 347680,
      "text": "四十九岁的他还是那三个字，",
      "token_start": 1267,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 347920,
      "end_ms": 348760,
      "text": "我愿意。",
      "token_start": 1279,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 349740,
      "end_ms": 350730,
      "text": "一九九六二年，",
      "token_start": 1282,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 350730,
      "end_ms": 354465,
      "text": "他悄悄离京去了甘肃兰州的武陵寺场，",
      "token_start": 1288,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 355270,
      "end_ms": 356875,
      "text": "丈夫在外承担任务，",
      "token_start": 1304,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 357200,
      "end_ms": 360115,
      "text": "儿子一个人在北京读寄宿学校，",
      "token_start": 1312,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 360680,
      "end_ms": 362785,
      "text": "一家三口天各一方。",
      "token_start": 1325,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 363540,
      "end_ms": 369740,
      "text": "他提出分九批启动第五批取料的方案，",
      "token_start": 1333,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 369740,
      "end_ms": 373785,
      "text": "把投产周期整整缩短了一百一十三天。",
      "token_start": 1349,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 374980,
      "end_ms": 377165,
      "text": "一九六四年一月十四日，",
      "token_start": 1365,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 377930,
      "end_ms": 383965,
      "text": "新中国第一批风度百分之九十以上的合格核燃料下线。",
      "token_start": 1375,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 384500,
      "end_ms": 385180,
      "text": "九个月后，",
      "token_start": 1398,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 385280,
      "end_ms": 386875,
      "text": "罗布泊一声巨响，",
      "token_start": 1402,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 387800,
      "end_ms": 390515,
      "text": "聂荣臻向毛主席汇报成功的消息。",
      "token_start": 1409,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 391280,
      "end_ms": 392065,
      "text": "毛主席说，",
      "token_start": 1423,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 392830,
      "end_ms": 395795,
      "text": "这是中国第一颗核爆的女功臣，",
      "token_start": 1427,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 396970,
      "end_ms": 398985,
      "text": "可举国欢庆的人群里，",
      "token_start": 1440,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 399500,
      "end_ms": 400875,
      "text": "根本没有王成书，",
      "token_start": 1449,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 401330,
      "end_ms": 405220,
      "text": "组织上询问他继续隐姓埋名干下去，",
      "token_start": 1456,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 405440,
      "end_ms": 406280,
      "text": "你愿意吗？",
      "token_start": 1471,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 406380,
      "end_ms": 407025,
      "text": "我愿意。",
      "token_start": 1475,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 407680,
      "end_ms": 408280,
      "text": "第三次，",
      "token_start": 1478,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 408280,
      "end_ms": 409985,
      "text": "王成书又答应了下来，",
      "token_start": 1481,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 410250,
      "end_ms": 412035,
      "text": "从此他继续藏，",
      "token_start": 1490,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 412430,
      "end_ms": 415855,
      "text": "一直藏到一九七七年才回到北京。",
      "token_start": 1496,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 416700,
      "end_ms": 419955,
      "text": "一九八零年当选中国科学院学部委员，",
      "token_start": 1510,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 420360,
      "end_ms": 422675,
      "text": "可老百姓压根儿不知道他是谁。",
      "token_start": 1526,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 423310,
      "end_ms": 425150,
      "text": "一九九四年六月十八日，",
      "token_start": 1539,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 425150,
      "end_ms": 427245,
      "text": "八十二岁的王成书病逝，",
      "token_start": 1549,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 428190,
      "end_ms": 429985,
      "text": "当众公布遗嘱时，",
      "token_start": 1559,
      "token_end_exclusive": 1566
    },
    {
      "start_ms": 430440,
      "end_ms": 433525,
      "text": "所有人沉默了不办丧事，",
      "token_start": 1566,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 433870,
      "end_ms": 437780,
      "text": "遗体捐给医学研究毕昇书籍资料，",
      "token_start": 1576,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 438040,
      "end_ms": 447235,
      "text": "送给核工业研究院零存整取的七千两百二十二点八八元作为最后一次党费上交，",
      "token_start": 1590,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 447880,
      "end_ms": 452464,
      "text": "其余约十万元的积蓄全部捐给国家的希望工程。",
      "token_start": 1624,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 452990,
      "end_ms": 456205,
      "text": "他本可以站在诺贝尔奖的领奖台台上，",
      "token_start": 1644,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 456680,
      "end_ms": 459565,
      "text": "最后却站在大西北的稿纸堆里。",
      "token_start": 1660,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 460110,
      "end_ms": 461775,
      "text": "他本可以名满天下，",
      "token_start": 1673,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 462290,
      "end_ms": 467695,
      "text": "最后连儿子都不知道妈妈这些年到底在哪在干些什么。",
      "token_start": 1681,
      "token_end_exclusive": 1704
    },
    {
      "start_ms": 468760,
      "end_ms": 473295,
      "text": "这就是王成书蘑菇云里有他的一份，",
      "token_start": 1704,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 473800,
      "end_ms": 475865,
      "text": "他却不肯留自己的名字，",
      "token_start": 1719,
      "token_end_exclusive": 1729
    },
    {
      "start_ms": 476390,
      "end_ms": 479800,
      "text": "王成书的故事就写在国之脊梁。",
      "token_start": 1729,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 479800,
      "end_ms": 480505,
      "text": "这本书里，",
      "token_start": 1742,
      "token_end_exclusive": 1746
    },
    {
      "start_ms": 481210,
      "end_ms": 482605,
      "text": "书中还有四十多位，",
      "token_start": 1746,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 482960,
      "end_ms": 484040,
      "text": "像他这样的人，",
      "token_start": 1754,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 484040,
      "end_ms": 487230,
      "text": "每一位拿出来都能让你红着眼况。",
      "token_start": 1760,
      "token_end_exclusive": 1774
    },
    {
      "start_ms": 487230,
      "end_ms": 491485,
      "text": "看完想要深入了解这些为国隐身的国之脊梁，",
      "token_start": 1774,
      "token_end_exclusive": 1793
    },
    {
      "start_ms": 491890,
      "end_ms": 494345,
      "text": "点左下角链接直接带走，",
      "token_start": 1793,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 494640,
      "end_ms": 495365,
      "text": "给自己看，",
      "token_start": 1803,
      "token_end_exclusive": 1807
    },
    {
      "start_ms": 495700,
      "end_ms": 497295,
      "text": "给孩子看都值得。",
      "token_start": 1807,
      "token_end_exclusive": 1814
    },
    {
      "start_ms": 497860,
      "end_ms": 501235,
      "text": "但这只是开始一个能拿诺贝尔奖的女人，",
      "token_start": 1814,
      "token_end_exclusive": 1831
    },
    {
      "start_ms": 501980,
      "end_ms": 504545,
      "text": "为什么心甘情愿消失三十年？",
      "token_start": 1831,
      "token_end_exclusive": 1843
    },
    {
      "start_ms": 505410,
      "end_ms": 509985,
      "text": "他在美国被扣的那七年到底经历了什么？",
      "token_start": 1843,
      "token_end_exclusive": 1860
    },
    {
      "start_ms": 510890,
      "end_ms": 511595,
      "text": "关注我，",
      "token_start": 1860,
      "token_end_exclusive": 1863
    },
    {
      "start_ms": 512090,
      "end_ms": 513435,
      "text": "下一集更震撼。",
      "token_start": 1863,
      "token_end_exclusive": 1869
    },
    {
      "start_ms": 514780,
      "end_ms": 516925,
      "text": "如果你被这个故事触动到了，",
      "token_start": 1869,
      "token_end_exclusive": 1881
    },
    {
      "start_ms": 517390,
      "end_ms": 518025,
      "text": "点个赞，",
      "token_start": 1881,
      "token_end_exclusive": 1884
    },
    {
      "start_ms": 519860,
      "end_ms": 520700,
      "text": "收藏起来，",
      "token_start": 1884,
      "token_end_exclusive": 1888
    },
    {
      "start_ms": 520840,
      "end_ms": 523335,
      "text": "转发给您的家人、朋友一起来看。",
      "token_start": 1888,
      "token_end_exclusive": 1901
    }
  ],
