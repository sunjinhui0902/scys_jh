{
  "video_id": "v_4ed4d46352185f2f",
  "duration_s": 432.262993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_4ed4d46352185f2f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_4ed4d46352185f2f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 810,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1090,
      "end_ms": 2730,
      "text": "咱们脚下这片土地，",
      "token_start": 4,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 3350,
      "end_ms": 6930,
      "text": "几千年来曾经存在过无数个国家，",
      "token_start": 12,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7390,
      "end_ms": 9070,
      "text": "有的在史书里留了名，",
      "token_start": 26,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 9430,
      "end_ms": 11170,
      "text": "有的连一个字都没留下，",
      "token_start": 35,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 11470,
      "end_ms": 13670,
      "text": "可他们都真真切切的活过。",
      "token_start": 45,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 14070,
      "end_ms": 15890,
      "text": "有人说是楼兰，",
      "token_start": 56,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 16230,
      "end_ms": 17930,
      "text": "丝绸之路上的明珠，",
      "token_start": 62,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 18410,
      "end_ms": 19490,
      "text": "说没就没了。",
      "token_start": 70,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 19890,
      "end_ms": 22430,
      "text": "有人说是夜郎夜郎自大，",
      "token_start": 75,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 22430,
      "end_ms": 25350,
      "text": "那个夜郎两千年前突然消失。",
      "token_start": 85,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 25890,
      "end_ms": 26130,
      "text": "错，",
      "token_start": 97,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 26970,
      "end_ms": 28550,
      "text": "真要论起邪乎劲儿，",
      "token_start": 98,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 28550,
      "end_ms": 31240,
      "text": "楼兰和夜郎联想前五都进不去。",
      "token_start": 106,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 31600,
      "end_ms": 38540,
      "text": "今天咱们就来盘点中国最不可思议的十五个消氏文明分三级讲。",
      "token_start": 119,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 38840,
      "end_ms": 41300,
      "text": "今天先讲第十五到第十一，",
      "token_start": 146,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 41720,
      "end_ms": 43040,
      "text": "一个比一个神秘。",
      "token_start": 157,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 43820,
      "end_ms": 44540,
      "text": "老规矩，",
      "token_start": 164,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 44840,
      "end_ms": 45720,
      "text": "开讲之前，",
      "token_start": 167,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 46000,
      "end_ms": 48540,
      "text": "麻烦您扣个一越个红心，",
      "token_start": 171,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 48880,
      "end_ms": 52300,
      "text": "让我看看都是谁在听第十五名。",
      "token_start": 181,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 52600,
      "end_ms": 55900,
      "text": "闽越王国在今天的福建，",
      "token_start": 194,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 56180,
      "end_ms": 58000,
      "text": "公元前三百三十四年，",
      "token_start": 204,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 58840,
      "end_ms": 64465,
      "text": "越王勾践的西士孙吴江跟楚威王打仗兵败被杀，",
      "token_start": 213,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 65240,
      "end_ms": 67055,
      "text": "越国被楚国灭了。",
      "token_start": 233,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67400,
      "end_ms": 70635,
      "text": "越国王族从海陆逃到福建，",
      "token_start": 240,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 70960,
      "end_ms": 73470,
      "text": "跟当地的闽人融合，",
      "token_start": 251,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 73700,
      "end_ms": 75260,
      "text": "建立了闽越国，",
      "token_start": 259,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 75540,
      "end_ms": 78220,
      "text": "成为东南一带最强的势力。",
      "token_start": 265,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 78300,
      "end_ms": 79845,
      "text": "公元前一百一十年，",
      "token_start": 276,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 80590,
      "end_ms": 83765,
      "text": "芈越国想脱离汉朝版图，",
      "token_start": 284,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 84650,
      "end_ms": 86395,
      "text": "汉武帝派大军灭了他，",
      "token_start": 294,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 87080,
      "end_ms": 90015,
      "text": "把百姓全部迁到江淮一带。",
      "token_start": 303,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 90770,
      "end_ms": 93105,
      "text": "一座王城就这样被烧毁，",
      "token_start": 314,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 93490,
      "end_ms": 95095,
      "text": "埋在了武夷山脚下。",
      "token_start": 324,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 95930,
      "end_ms": 97125,
      "text": "两千多年后，",
      "token_start": 332,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 97560,
      "end_ms": 102905,
      "text": "考古队挖出了城村汉城遗址大型宫殿机制，",
      "token_start": 337,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 103820,
      "end_ms": 106455,
      "text": "出土了大量带铭文的文物。",
      "token_start": 355,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 107360,
      "end_ms": 110255,
      "text": "一个在史书里只有一千多字的王国，",
      "token_start": 366,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 110700,
      "end_ms": 114435,
      "text": "就这样重现人间第十四名。",
      "token_start": 381,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 114780,
      "end_ms": 117560,
      "text": "夜郎王国就是夜郎自大。",
      "token_start": 392,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 117780,
      "end_ms": 120440,
      "text": "那个夜郎很多人以为夜郎是个笑话，",
      "token_start": 402,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 120620,
      "end_ms": 123685,
      "text": "其实不是史记里写的清楚。",
      "token_start": 417,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 124250,
      "end_ms": 128095,
      "text": "西南夷军常以神术夜郎最大。",
      "token_start": 428,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 128980,
      "end_ms": 131485,
      "text": "汉朝使者出使夜郎的时候，",
      "token_start": 440,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 132360,
      "end_ms": 133705,
      "text": "夜郎王问了一句，",
      "token_start": 451,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 134220,
      "end_ms": 135535,
      "text": "汉属于我大，",
      "token_start": 458,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 135970,
      "end_ms": 137415,
      "text": "这句话传了两千年，",
      "token_start": 463,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 137630,
      "end_ms": 138565,
      "text": "变成了成语，",
      "token_start": 471,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 139360,
      "end_ms": 140655,
      "text": "可夜郎其实不小。",
      "token_start": 476,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 141030,
      "end_ms": 141650,
      "text": "史记说，",
      "token_start": 483,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 141650,
      "end_ms": 143775,
      "text": "夜郎有精兵十余万，",
      "token_start": 486,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 144590,
      "end_ms": 146585,
      "text": "能拿出十万兵的国家，",
      "token_start": 494,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 147010,
      "end_ms": 149395,
      "text": "在当时算得上一方霸主，",
      "token_start": 503,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 149880,
      "end_ms": 152785,
      "text": "夜郎国大概存在了三百多年。",
      "token_start": 513,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 153680,
      "end_ms": 156275,
      "text": "从战国到西汉成帝年间，",
      "token_start": 525,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 156960,
      "end_ms": 158620,
      "text": "夜郎王兴造反，",
      "token_start": 535,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 158760,
      "end_ms": 161395,
      "text": "被蔡太守陈立剿灭，",
      "token_start": 541,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 162350,
      "end_ms": 164250,
      "text": "夜郎国就此灭亡。",
      "token_start": 549,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 164390,
      "end_ms": 166905,
      "text": "可他的族群和文化没有消失，",
      "token_start": 556,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 167610,
      "end_ms": 170825,
      "text": "继续在贵州的深山里延续了很长时间。",
      "token_start": 568,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 172230,
      "end_ms": 178545,
      "text": "考古队在赫章可勒遗址发现了国内独一无二的套头葬，",
      "token_start": 584,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 179200,
      "end_ms": 179720,
      "text": "死者，",
      "token_start": 607,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 179720,
      "end_ms": 181035,
      "text": "头部套着铜斧。",
      "token_start": 609,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 181460,
      "end_ms": 186015,
      "text": "这种藏俗在全国其他地区从来没发现过第十三名。",
      "token_start": 615,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 186460,
      "end_ms": 189695,
      "text": "八国巴人是一个古老的部族，",
      "token_start": 636,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 190330,
      "end_ms": 193405,
      "text": "可以追溯到传说里的五帝时代。",
      "token_start": 648,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 194290,
      "end_ms": 195775,
      "text": "山海经里就有记载，",
      "token_start": 661,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 196570,
      "end_ms": 199495,
      "text": "八人最早活动在汉水流域，",
      "token_start": 669,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 199730,
      "end_ms": 201445,
      "text": "后来迁徙到四川东部，",
      "token_start": 680,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 201700,
      "end_ms": 203275,
      "text": "跟蜀国打了几百年。",
      "token_start": 689,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 203840,
      "end_ms": 205665,
      "text": "公元前三百一十六年，",
      "token_start": 697,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 206340,
      "end_ms": 207915,
      "text": "蜀国进攻八国，",
      "token_start": 706,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 208240,
      "end_ms": 209875,
      "text": "八国向秦国求救，",
      "token_start": 712,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 210610,
      "end_ms": 211630,
      "text": "秦军南下，",
      "token_start": 719,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 211750,
      "end_ms": 212935,
      "text": "先灭了蜀国，",
      "token_start": 723,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 213360,
      "end_ms": 216580,
      "text": "顺手把八国也灭了巴人，",
      "token_start": 728,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 216580,
      "end_ms": 219825,
      "text": "就这样消失在了四川的崇山峻岭中。",
      "token_start": 738,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 220390,
      "end_ms": 222965,
      "text": "史书对巴人的记载语言不详，",
      "token_start": 753,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 223460,
      "end_ms": 225405,
      "text": "更多的是传说和推测。",
      "token_start": 765,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 225960,
      "end_ms": 231515,
      "text": "考古队在涪陵小田溪发现了战国晚期的八国亡陵区，",
      "token_start": 774,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 232170,
      "end_ms": 235335,
      "text": "在宣汉罗家坝发现了八人遗址，",
      "token_start": 796,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 236100,
      "end_ms": 238240,
      "text": "出土了大批青铜器八人。",
      "token_start": 809,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 238260,
      "end_ms": 239825,
      "text": "上午兵甲繁盛，",
      "token_start": 819,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 240220,
      "end_ms": 242465,
      "text": "隔剑越一剑比一剑锋利，",
      "token_start": 825,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 242960,
      "end_ms": 244405,
      "text": "可巴人到底长什么样，",
      "token_start": 835,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 244690,
      "end_ms": 246265,
      "text": "说什么话信什么神，",
      "token_start": 844,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 246720,
      "end_ms": 249015,
      "text": "到现在也没人完全搞清楚。",
      "token_start": 852,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 249430,
      "end_ms": 253725,
      "text": "第十二名滇国在今天的云南滇池一带，",
      "token_start": 863,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 254200,
      "end_ms": 257790,
      "text": "司马迁在史记里写过滇国出现于战国，",
      "token_start": 879,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 257790,
      "end_ms": 260425,
      "text": "中期消失于东汉中期，",
      "token_start": 895,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 260800,
      "end_ms": 262185,
      "text": "大约存在了五百年。",
      "token_start": 904,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 262900,
      "end_ms": 264575,
      "text": "公元前一百零九年，",
      "token_start": 912,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 264930,
      "end_ms": 267230,
      "text": "汉武帝发兵灭了滇国，",
      "token_start": 920,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 267530,
      "end_ms": 269465,
      "text": "赐了一枚滇王之印，",
      "token_start": 929,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 269720,
      "end_ms": 272590,
      "text": "给滇王滇国就销声匿迹了。",
      "token_start": 937,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 272670,
      "end_ms": 273610,
      "text": "之后的史料里，",
      "token_start": 948,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 273610,
      "end_ms": 275935,
      "text": "几乎再也没有提到过滇国。",
      "token_start": 954,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 276570,
      "end_ms": 277935,
      "text": "直到一九五六年，",
      "token_start": 965,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 278390,
      "end_ms": 285195,
      "text": "考古学家在滇池东岸的晋宁石寨山发掘出了古滇国墓葬群，",
      "token_start": 972,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 285760,
      "end_ms": 289135,
      "text": "出土了那枚滇王之印晶印一亮出来，",
      "token_start": 997,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 289580,
      "end_ms": 292395,
      "text": "两千年的谜案一下子对上了。",
      "token_start": 1012,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 292890,
      "end_ms": 296390,
      "text": "史书上写的滇国地底下挖出来了，",
      "token_start": 1024,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 296650,
      "end_ms": 304050,
      "text": "古滇国最出名的文物是那些青铜器储备器上著作祭祀的场面，",
      "token_start": 1038,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 304850,
      "end_ms": 306510,
      "text": "杀人祭住嫖牛，",
      "token_start": 1064,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 306830,
      "end_ms": 308290,
      "text": "一件比一件震撼。",
      "token_start": 1070,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 309070,
      "end_ms": 312370,
      "text": "可滇国为什么突然消失到现在？",
      "token_start": 1077,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 312370,
      "end_ms": 313330,
      "text": "也没个定论。",
      "token_start": 1090,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 314430,
      "end_ms": 320810,
      "text": "第十一名古虚王国徐国是夏朝就存在的古国，",
      "token_start": 1095,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 321650,
      "end_ms": 325500,
      "text": "大约公元前两千一百七十年下棋，",
      "token_start": 1114,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 325760,
      "end_ms": 328980,
      "text": "把博弈的次子若木封在徐地，",
      "token_start": 1128,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 329360,
      "end_ms": 331300,
      "text": "徐国就此诞生。",
      "token_start": 1140,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 332200,
      "end_ms": 334120,
      "text": "徐国最强盛的时候，",
      "token_start": 1146,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 334760,
      "end_ms": 338480,
      "text": "国君徐衍王被周穆王派楚国打败，",
      "token_start": 1154,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 338920,
      "end_ms": 339920,
      "text": "弃国逃走，",
      "token_start": 1168,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 340380,
      "end_ms": 341300,
      "text": "投海而死。",
      "token_start": 1172,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 341780,
      "end_ms": 342260,
      "text": "后来，",
      "token_start": 1176,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 342380,
      "end_ms": 347700,
      "text": "吴国伐徐水淹徐国都城徐王投奔楚国，",
      "token_start": 1178,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 348680,
      "end_ms": 351000,
      "text": "徐国从此失去国号，",
      "token_start": 1194,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 351460,
      "end_ms": 353945,
      "text": "一个存在了一千多年的古国，",
      "token_start": 1202,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 354800,
      "end_ms": 358335,
      "text": "就这样在春秋乱世里被抹掉了。",
      "token_start": 1214,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 358500,
      "end_ms": 362765,
      "text": "考古队在江苏邳州一带发现了徐国贵族墓葬，",
      "token_start": 1227,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 363530,
      "end_ms": 365375,
      "text": "出土了大量青铜器，",
      "token_start": 1246,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 365930,
      "end_ms": 368070,
      "text": "铭文里频频出现。",
      "token_start": 1254,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 368270,
      "end_ms": 369515,
      "text": "徐王二字。",
      "token_start": 1261,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 369940,
      "end_ms": 372645,
      "text": "一个被史书遗忘的王国，",
      "token_start": 1265,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 373290,
      "end_ms": 375305,
      "text": "靠着青铜器上的铭门，",
      "token_start": 1275,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 375700,
      "end_ms": 378200,
      "text": "才让后人知道他曾经存在。",
      "token_start": 1284,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 378200,
      "end_ms": 380685,
      "text": "过从第十五到第十一，",
      "token_start": 1295,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 381060,
      "end_ms": 383300,
      "text": "闽越国被汉武帝迁走了，",
      "token_start": 1304,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 383300,
      "end_ms": 388485,
      "text": "百姓夜郎国留下了一个成语和一种奇特的藏俗，",
      "token_start": 1314,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 389130,
      "end_ms": 391655,
      "text": "八国消失在崇山峻岭里，",
      "token_start": 1334,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 392590,
      "end_ms": 395945,
      "text": "滇国靠着金印才被重新发现。",
      "token_start": 1344,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 396810,
      "end_ms": 401570,
      "text": "徐国全靠青铜器上的铭文证明自己存在过，",
      "token_start": 1356,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 401690,
      "end_ms": 404255,
      "text": "可这五个还只是开胃菜。",
      "token_start": 1374,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 405230,
      "end_ms": 407155,
      "text": "接下来第十到第六根邪乎，",
      "token_start": 1384,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 408160,
      "end_ms": 409075,
      "text": "有一个国家，",
      "token_start": 1395,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 409900,
      "end_ms": 411985,
      "text": "史书上连一个字都没写过，",
      "token_start": 1400,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 412700,
      "end_ms": 416500,
      "text": "全靠考古队挖出来的青铜器才知道他存在过。",
      "token_start": 1411,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 416920,
      "end_ms": 419020,
      "text": "有一个国家被灭之后，",
      "token_start": 1430,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 419020,
      "end_ms": 421680,
      "text": "连二十四师里都没有他的专使，",
      "token_start": 1439,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 422120,
      "end_ms": 422700,
      "text": "他是谁？",
      "token_start": 1452,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 423180,
      "end_ms": 424740,
      "text": "他凭什么这么神秘？",
      "token_start": 1455,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 425080,
      "end_ms": 425640,
      "text": "终极，",
      "token_start": 1463,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 425900,
      "end_ms": 426880,
      "text": "马上更新。",
      "token_start": 1465,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 427360,
      "end_ms": 432125,
      "text": "您先点个关注点开头像别走丢。",
      "token_start": 1469,
      "token_end_exclusive": 1482
    }
  ],
