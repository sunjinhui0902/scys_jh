  "segments": [
    {
      "start_ms": 210,
      "end_ms": 1410,
      "text": "很干净的四句话，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1670,
      "end_ms": 2490,
      "text": "受用终生，",
      "token_start": 7,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2790,
      "end_ms": 5690,
      "text": "第一句人再难也不要说话，",
      "token_start": 11,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5690,
      "end_ms": 6330,
      "text": "不算数，",
      "token_start": 22,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6770,
      "end_ms": 7470,
      "text": "人再穷，",
      "token_start": 25,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7810,
      "end_ms": 8930,
      "text": "也千万不要借钱，",
      "token_start": 28,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 8930,
      "end_ms": 10510,
      "text": "不还钱没了，",
      "token_start": 35,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 10510,
      "end_ms": 11410,
      "text": "咱还可以再正，",
      "token_start": 40,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 11710,
      "end_ms": 12910,
      "text": "但是信任没机，",
      "token_start": 46,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 13090,
      "end_ms": 14350,
      "text": "你将寸步难行。",
      "token_start": 52,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 14750,
      "end_ms": 16370,
      "text": "第二句人可以精，",
      "token_start": 58,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 16670,
      "end_ms": 18290,
      "text": "但是千万不能没有底线。",
      "token_start": 65,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 18810,
      "end_ms": 20690,
      "text": "人前不耍心机人后，",
      "token_start": 75,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 21030,
      "end_ms": 21930,
      "text": "不玩阴谋。",
      "token_start": 83,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 22370,
      "end_ms": 24390,
      "text": "第三句人只有行得正，",
      "token_start": 87,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 24690,
      "end_ms": 25770,
      "text": "才能够站得稳，",
      "token_start": 96,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 26150,
      "end_ms": 27270,
      "text": "人品重于山，",
      "token_start": 102,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 27670,
      "end_ms": 28950,
      "text": "良心比金，",
      "token_start": 107,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 28950,
      "end_ms": 30300,
      "text": "贵在穷，",
      "token_start": 111,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 30300,
      "end_ms": 31300,
      "text": "也别骗朋友，",
      "token_start": 114,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 31480,
      "end_ms": 33340,
      "text": "再富也别忘恩人。",
      "token_start": 119,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 33740,
      "end_ms": 34420,
      "text": "第四句，",
      "token_start": 126,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 34760,
      "end_ms": 35660,
      "text": "人品第一，",
      "token_start": 129,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 35860,
      "end_ms": 36740,
      "text": "不昧良心，",
      "token_start": 133,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 37220,
      "end_ms": 38700,
      "text": "人品永远大于能力，",
      "token_start": 137,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 39000,
      "end_ms": 41220,
      "text": "良心永远贵于黄金。",
      "token_start": 145,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 41720,
      "end_ms": 42360,
      "text": "人品好，",
      "token_start": 153,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 42600,
      "end_ms": 43780,
      "text": "一切才会都好。",
      "token_start": 156,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 44220,
      "end_ms": 46600,
      "text": "良心在福气长，",
      "token_start": 162,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 47160,
      "end_ms": 48185,
      "text": "你认同吗？",
      "token_start": 168,
      "token_end_exclusive": 172
    }
