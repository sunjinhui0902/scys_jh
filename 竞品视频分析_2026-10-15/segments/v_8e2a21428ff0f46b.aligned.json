  "segments": [
    {
      "start_ms": 250,
      "end_ms": 1530,
      "text": "这藕是好藕啊，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1830,
      "end_ms": 3810,
      "text": "就是心眼儿太多了。",
      "token_start": 6,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 3810,
      "end_ms": 5670,
      "text": "领导藕虽然心眼多，",
      "token_start": 14,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5670,
      "end_ms": 10350,
      "text": "但也是您的下酒菜啊。",
      "token_start": 22,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 10350,
      "end_ms": 11650,
      "text": "来就来带什么礼物，",
      "token_start": 31,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 11650,
      "end_ms": 12730,
      "text": "都都不是外领。",
      "token_start": 39,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12730,
      "end_ms": 13510,
      "text": "领导，",
      "token_start": 45,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 13510,
      "end_ms": 14170,
      "text": "您都说了，",
      "token_start": 47,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 14170,
      "end_ms": 15070,
      "text": "不是外人，",
      "token_start": 51,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 15070,
      "end_ms": 16850,
      "text": "我一直都把您当辈辈看，",
      "token_start": 55,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 16850,
      "end_ms": 20450,
      "text": "哪有晚辈看长辈空手来的道理啊。",
      "token_start": 65,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 20450,
      "end_ms": 21170,
      "text": "小李，",
      "token_start": 79,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21170,
      "end_ms": 22830,
      "text": "今天让您荣费领导，",
      "token_start": 81,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 22990,
      "end_ms": 24510,
      "text": "您说这些您能来，",
      "token_start": 89,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 24530,
      "end_ms": 25290,
      "text": "就是我的荣幸，",
      "token_start": 96,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 25470,
      "end_ms": 27350,
      "text": "以后还有很多地方向您请教，",
      "token_start": 102,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 27350,
      "end_ms": 32200,
      "text": "不是来这么晚只能吃剩菜了吧？",
      "token_start": 114,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 32500,
      "end_ms": 32920,
      "text": "领导，",
      "token_start": 127,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 33100,
      "end_ms": 34180,
      "text": "饭在哪儿我都能吃，",
      "token_start": 129,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 34440,
      "end_ms": 36400,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 137,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 36400,
      "end_ms": 37940,
      "text": "能赶上已经是我的运气了，",
      "token_start": 150,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 40100,
      "end_ms": 41540,
      "text": "你酒量挺好的呀。",
      "token_start": 161,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 41640,
      "end_ms": 42060,
      "text": "领导，",
      "token_start": 168,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 42060,
      "end_ms": 43100,
      "text": "您可抬举我了，",
      "token_start": 170,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 43200,
      "end_ms": 44400,
      "text": "我平时真不太能喝，",
      "token_start": 176,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 44560,
      "end_ms": 45940,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 184,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 45940,
      "end_ms": 46440,
      "text": "高兴啊，",
      "token_start": 195,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 46440,
      "end_ms": 47860,
      "text": "这一高兴就多贪了几杯，",
      "token_start": 198,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 50200,
      "end_ms": 52060,
      "text": "这喝就是看不起我。",
      "token_start": 208,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 52760,
      "end_ms": 53200,
      "text": "领导，",
      "token_start": 216,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 53680,
      "end_ms": 54760,
      "text": "我不是看不起您，",
      "token_start": 218,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 55140,
      "end_ms": 57905,
      "text": "我是看不起病。",
      "token_start": 225,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 60210,
      "end_ms": 60450,
      "text": "哎，",
      "token_start": 231,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 60610,
      "end_ms": 61490,
      "text": "你什么意思啊？",
      "token_start": 232,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 61630,
      "end_ms": 63125,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 238,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 63380,
      "end_ms": 64360,
      "text": "领导美满美满，",
      "token_start": 249,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 64460,
      "end_ms": 65600,
      "text": "代表幸福美满，",
      "token_start": 255,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 65720,
      "end_ms": 68135,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 261,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 70340,
      "end_ms": 70720,
      "text": "小李，",
      "token_start": 275,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 70720,
      "end_ms": 71960,
      "text": "最近表现不错啊，",
      "token_start": 277,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 72100,
      "end_ms": 74040,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 284,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 74060,
      "end_ms": 75220,
      "text": "我得提前敬你一杯。",
      "token_start": 297,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 75240,
      "end_ms": 75940,
      "text": "听这意思，",
      "token_start": 305,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 76040,
      "end_ms": 77240,
      "text": "领导是要高升了呀，",
      "token_start": 309,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 77240,
      "end_ms": 78200,
      "text": "我得提前敬领导。",
      "token_start": 317,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 78200,
      "end_ms": 82015,
      "text": "一杯这鸭子是好鸭子，",
      "token_start": 324,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 82460,
      "end_ms": 83275,
      "text": "就是嘴硬，",
      "token_start": 333,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 84160,
      "end_ms": 84680,
      "text": "嘴硬，",
      "token_start": 337,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 84680,
      "end_ms": 88140,
      "text": "才守得住秘密哈哈哈哈。",
      "token_start": 339,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 90560,
      "end_ms": 91145,
      "text": "关注我，",
      "token_start": 349,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 91460,
      "end_ms": 92900,
      "text": "每天学点儿高情商，",
      "token_start": 352,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 92940,
      "end_ms": 93685,
      "text": "说话技巧，",
      "token_start": 360,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 94040,
      "end_ms": 95795,
      "text": "让你的路越走越宽。",
      "token_start": 364,
      "token_end_exclusive": 372
    }
  ],
