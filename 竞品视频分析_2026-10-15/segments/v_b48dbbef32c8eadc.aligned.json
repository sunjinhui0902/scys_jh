{
  "video_id": "v_b48dbbef32c8eadc",
  "duration_s": 226.020998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b48dbbef32c8eadc.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b48dbbef32c8eadc.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 2350,
      "text": "王铁王铁领导，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2630,
      "end_ms": 3410,
      "text": "我叫王毅，",
      "token_start": 6,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3530,
      "end_ms": 4375,
      "text": "不叫王铁，",
      "token_start": 10,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 7330,
      "end_ms": 8410,
      "text": "你要是能摆五十下，",
      "token_start": 14,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 8570,
      "end_ms": 9695,
      "text": "我倒立洗头。",
      "token_start": 22,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 12690,
      "end_ms": 15750,
      "text": "外公听说有公积金的人都很厉害，",
      "token_start": 27,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 15870,
      "end_ms": 17350,
      "text": "你一个月公积金多少啊？",
      "token_start": 41,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 17530,
      "end_ms": 18190,
      "text": "傻孩子，",
      "token_start": 51,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 18270,
      "end_ms": 19610,
      "text": "外公就是普通岗位，",
      "token_start": 54,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 19770,
      "end_ms": 20770,
      "text": "跟普通人一样，",
      "token_start": 62,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 20770,
      "end_ms": 21350,
      "text": "才七千，",
      "token_start": 68,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 21750,
      "end_ms": 22770,
      "text": "那也不多嘛。",
      "token_start": 71,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 23190,
      "end_ms": 23490,
      "text": "好了，",
      "token_start": 76,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 23490,
      "end_ms": 24330,
      "text": "跟爸爸回家喽，",
      "token_start": 78,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 24950,
      "end_ms": 25795,
      "text": "走了回家了，",
      "token_start": 84,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 27620,
      "end_ms": 32070,
      "text": "你爸爸你怎么说啊，",
      "token_start": 89,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 36400,
      "end_ms": 38220,
      "text": "你为什么不叫同学一起收拾呢？",
      "token_start": 97,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 38700,
      "end_ms": 41500,
      "text": "既然我不打算再邀请他们来家里玩，",
      "token_start": 110,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 41820,
      "end_ms": 43580,
      "text": "我何必再得罪他一次呢？",
      "token_start": 125,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 44600,
      "end_ms": 45780,
      "text": "这小子才七岁，",
      "token_start": 135,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 46360,
      "end_ms": 48120,
      "text": "一个暑假去了潮汕老家，",
      "token_start": 141,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 48680,
      "end_ms": 50305,
      "text": "看来外公教的不错啊。",
      "token_start": 151,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 64030,
      "end_ms": 65170,
      "text": "你这个能掰多少个，",
      "token_start": 160,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 65710,
      "end_ms": 66835,
      "text": "也就五十个吧。",
      "token_start": 168,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 69960,
      "end_ms": 71040,
      "text": "你要是能摆五十下，",
      "token_start": 174,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 71200,
      "end_ms": 72295,
      "text": "我倒立洗头，",
      "token_start": 182,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 78790,
      "end_ms": 83610,
      "text": "一二三四十八、四十九。",
      "token_start": 187,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 87090,
      "end_ms": 89215,
      "text": "你说的对我确实掰不动了。",
      "token_start": 196,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 92590,
      "end_ms": 94970,
      "text": "王铁王铁领导，",
      "token_start": 207,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 95230,
      "end_ms": 95970,
      "text": "我叫王毅，",
      "token_start": 213,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 96130,
      "end_ms": 96965,
      "text": "不叫王铁，",
      "token_start": 217,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 101840,
      "end_ms": 102200,
      "text": "对不起，",
      "token_start": 221,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 102200,
      "end_ms": 102540,
      "text": "领导，",
      "token_start": 224,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 102640,
      "end_ms": 104155,
      "text": "是我不小心把名字打错了，",
      "token_start": 226,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 106220,
      "end_ms": 108420,
      "text": "这种小毛病下次再犯就卷铺盖走人，",
      "token_start": 237,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 108840,
      "end_ms": 110020,
      "text": "这个项目你来负责，",
      "token_start": 252,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 110380,
      "end_ms": 112580,
      "text": "合同金额上千万别让我失望。",
      "token_start": 260,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 112880,
      "end_ms": 113300,
      "text": "明白，",
      "token_start": 272,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 113300,
      "end_ms": 121330,
      "text": "我一定做好陈总啊，",
      "token_start": 274,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 121610,
      "end_ms": 122770,
      "text": "这是您托我买的酒，",
      "token_start": 282,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 123250,
      "end_ms": 123950,
      "text": "找到零钱，",
      "token_start": 290,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 124130,
      "end_ms": 125150,
      "text": "我给您放桌上了，",
      "token_start": 294,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 125490,
      "end_ms": 125930,
      "text": "您忙，",
      "token_start": 301,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 125950,
      "end_ms": 126690,
      "text": "我先回去了，",
      "token_start": 303,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 129970,
      "end_ms": 131210,
      "text": "客户那边已经确认了，",
      "token_start": 308,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 131210,
      "end_ms": 131950,
      "text": "过来签正式合同。",
      "token_start": 317,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 131950,
      "end_ms": 132190,
      "text": "好，",
      "token_start": 324,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 132250,
      "end_ms": 133055,
      "text": "我马上过去。",
      "token_start": 325,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 137800,
      "end_ms": 138220,
      "text": "白公，",
      "token_start": 330,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 138540,
      "end_ms": 139860,
      "text": "我昨天刚谈了一个项目，",
      "token_start": 332,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 139860,
      "end_ms": 141020,
      "text": "一下子提成了三十万，",
      "token_start": 342,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 141080,
      "end_ms": 142560,
      "text": "我要不要请同事们吃个饭呢？",
      "token_start": 351,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 142680,
      "end_ms": 143940,
      "text": "免得他们眼红说闲话，",
      "token_start": 363,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 144520,
      "end_ms": 146700,
      "text": "不如请客户去五星级搓澡，",
      "token_start": 372,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 147120,
      "end_ms": 148420,
      "text": "说不定他一开心呢，",
      "token_start": 383,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 148520,
      "end_ms": 149860,
      "text": "又给你介绍几个客户，",
      "token_start": 391,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 150180,
      "end_ms": 151840,
      "text": "提成三十万又到手了，",
      "token_start": 400,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 152300,
      "end_ms": 154100,
      "text": "请同事人走茶凉，",
      "token_start": 409,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 154520,
      "end_ms": 155900,
      "text": "不如结交贵人，",
      "token_start": 416,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 156600,
      "end_ms": 160940,
      "text": "平步青云小既是聚集卧室馆了。",
      "token_start": 422,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 161060,
      "end_ms": 161685,
      "text": "怎么样？",
      "token_start": 435,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 165880,
      "end_ms": 167260,
      "text": "经公司研究决定，",
      "token_start": 438,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 167480,
      "end_ms": 168440,
      "text": "从今天开始，",
      "token_start": 445,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 168740,
      "end_ms": 170755,
      "text": "由小张担任部门经理，",
      "token_start": 450,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 173100,
      "end_ms": 173740,
      "text": "谢谢领导。",
      "token_start": 459,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 175520,
      "end_ms": 176620,
      "text": "我马上就要离职了，",
      "token_start": 463,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 176880,
      "end_ms": 179100,
      "text": "你从读大学的时候就跟其他同学不一样，",
      "token_start": 471,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 179460,
      "end_ms": 180640,
      "text": "你到底是怎么做到的？",
      "token_start": 488,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 180740,
      "end_ms": 182615,
      "text": "才两个月就升经理了。",
      "token_start": 497,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 185000,
      "end_ms": 186795,
      "text": "从小外公就让让我看这本书，",
      "token_start": 506,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 187390,
      "end_ms": 189390,
      "text": "这本书以前是上位者的枕边书。",
      "token_start": 518,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 189690,
      "end_ms": 191195,
      "text": "如今也被一一拆解了。",
      "token_start": 531,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 191640,
      "end_ms": 193590,
      "text": "你看啊一定要培养自己，",
      "token_start": 540,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 193590,
      "end_ms": 194775,
      "text": "不接别人话的能力。",
      "token_start": 550,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 195080,
      "end_ms": 196320,
      "text": "听别人讲话的时候呢，",
      "token_start": 558,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 196320,
      "end_ms": 197120,
      "text": "先思考一下，",
      "token_start": 567,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 197200,
      "end_ms": 198080,
      "text": "不要别人问什么，",
      "token_start": 572,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 198080,
      "end_ms": 198900,
      "text": "你就答什么。",
      "token_start": 579,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 198980,
      "end_ms": 200500,
      "text": "别人越是催你的时候呢，",
      "token_start": 584,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 200560,
      "end_ms": 201575,
      "text": "越是要缓一缓，",
      "token_start": 594,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 201830,
      "end_ms": 203575,
      "text": "这就是高手跟普通人的差距。",
      "token_start": 600,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 203830,
      "end_ms": 205175,
      "text": "它不同于传统的书籍，",
      "token_start": 612,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 205450,
      "end_ms": 206390,
      "text": "随便打开一页，",
      "token_start": 621,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 206390,
      "end_ms": 207595,
      "text": "就像开了一扇心窗。",
      "token_start": 627,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 207890,
      "end_ms": 209230,
      "text": "他把普通人接触不到，",
      "token_start": 635,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 209430,
      "end_ms": 212845,
      "text": "和上层人心照不宣的生存法则呈现在你的面前，",
      "token_start": 644,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 213090,
      "end_ms": 215525,
      "text": "让你站在前人智慧的肩膀上去看问题。",
      "token_start": 664,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 215780,
      "end_ms": 216880,
      "text": "他不会教你做圣人，",
      "token_start": 680,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 216960,
      "end_ms": 219350,
      "text": "而是教你做棋手二零二六年。",
      "token_start": 688,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 219490,
      "end_ms": 220890,
      "text": "如果你想换一种活法，",
      "token_start": 700,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 221150,
      "end_ms": 224295,
      "text": "想在人际、职场、社交关系中更游刃有余，",
      "token_start": 709,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 224640,
      "end_ms": 225865,
      "text": "那一定要读一读这本书。",
      "token_start": 725,
      "token_end_exclusive": 735
    }
  ],
