  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c3a892a3cf5094cc.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c3a892a3cf5094cc.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 2790,
      "text": "来这么晚只能吃剩菜了吧，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3410,
      "end_ms": 5410,
      "text": "领导饭在哪儿我都能吃，",
      "token_start": 11,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5650,
      "end_ms": 7790,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 21,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 7930,
      "end_ms": 9570,
      "text": "能赶上已经是我的运气了，",
      "token_start": 34,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12410,
      "end_ms": 13650,
      "text": "谁学一声狗叫，",
      "token_start": 45,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 14370,
      "end_ms": 15355,
      "text": "我就给一千。",
      "token_start": 51,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 19940,
      "end_ms": 20480,
      "text": "祝领导，",
      "token_start": 56,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 20480,
      "end_ms": 21040,
      "text": "家庭旺，",
      "token_start": 59,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 21080,
      "end_ms": 22540,
      "text": "事业旺以后日子旺，",
      "token_start": 62,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 22540,
      "end_ms": 23080,
      "text": "上家旺，",
      "token_start": 70,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 23240,
      "end_ms": 24520,
      "text": "一共四生四千块。",
      "token_start": 73,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 26580,
      "end_ms": 26820,
      "text": "好，",
      "token_start": 80,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 27140,
      "end_ms": 27580,
      "text": "小林，",
      "token_start": 81,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 27980,
      "end_ms": 28600,
      "text": "说实话，",
      "token_start": 83,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 28740,
      "end_ms": 31220,
      "text": "我不太喜欢你那我更该谢谢您了。",
      "token_start": 86,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 31540,
      "end_ms": 32300,
      "text": "你谢什么？",
      "token_start": 100,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 32560,
      "end_ms": 33460,
      "text": "您不喜欢我，",
      "token_start": 104,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 33660,
      "end_ms": 35000,
      "text": "可该给的机会照样给，",
      "token_start": 109,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 35120,
      "end_ms": 36360,
      "text": "工作上也没少支持，",
      "token_start": 118,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 36660,
      "end_ms": 37980,
      "text": "没拿个人好感为难我，",
      "token_start": 126,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 38100,
      "end_ms": 39660,
      "text": "这份格局就够我福气了。",
      "token_start": 135,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 40280,
      "end_ms": 41400,
      "text": "年轻就是好啊，",
      "token_start": 145,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 41640,
      "end_ms": 43000,
      "text": "年轻就是还不够沉稳，",
      "token_start": 151,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 43420,
      "end_ms": 44560,
      "text": "还要向您多学习，",
      "token_start": 160,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 44900,
      "end_ms": 46120,
      "text": "我们才能变得更优秀。",
      "token_start": 167,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 46600,
      "end_ms": 47440,
      "text": "你这么能干，",
      "token_start": 176,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 47720,
      "end_ms": 49535,
      "text": "我这位置看来要让给你了，",
      "token_start": 181,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 49790,
      "end_ms": 50930,
      "text": "那我得先恭喜您，",
      "token_start": 192,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 51130,
      "end_ms": 52190,
      "text": "你坐我的位置，",
      "token_start": 199,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 52390,
      "end_ms": 53190,
      "text": "恭喜我什么？",
      "token_start": 205,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 53230,
      "end_ms": 54030,
      "text": "您高升了，",
      "token_start": 210,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 54070,
      "end_ms": 55330,
      "text": "才轮得到我们往前挪。",
      "token_start": 214,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 55670,
      "end_ms": 58550,
      "text": "我真有那一天也得是您先走到更高的地方，",
      "token_start": 223,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 58730,
      "end_ms": 60555,
      "text": "这杯先敬您步步高升。",
      "token_start": 241,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 61020,
      "end_ms": 61425,
      "text": "好，",
      "token_start": 250,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 61830,
      "end_ms": 63245,
      "text": "这藕是好藕啊，",
      "token_start": 251,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 64080,
      "end_ms": 65715,
      "text": "就是心眼儿太多了。",
      "token_start": 257,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 66930,
      "end_ms": 69280,
      "text": "领导藕虽然心眼多，",
      "token_start": 265,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 69480,
      "end_ms": 70855,
      "text": "但也是您的下酒菜啊。",
      "token_start": 273,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 71160,
      "end_ms": 72775,
      "text": "哈哈哈哈哎呀，",
      "token_start": 282,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 73070,
      "end_ms": 74295,
      "text": "你点那么多菜，",
      "token_start": 288,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 74750,
      "end_ms": 76510,
      "text": "该不会是想把我吃穷吧，",
      "token_start": 294,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 76650,
      "end_ms": 78505,
      "text": "帮领导您把穷给吃了，",
      "token_start": 304,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 78730,
      "end_ms": 79935,
      "text": "那您就只剩负了。",
      "token_start": 313,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 81010,
      "end_ms": 84245,
      "text": "哈哈哈哈哈哈小林啊，",
      "token_start": 320,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 84990,
      "end_ms": 86795,
      "text": "你一开口就让人喜欢，",
      "token_start": 329,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 87310,
      "end_ms": 88485,
      "text": "你是怎么做到的？",
      "token_start": 338,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 88730,
      "end_ms": 89590,
      "text": "多亏了我父母，",
      "token_start": 345,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 89610,
      "end_ms": 92230,
      "text": "从小就让我看这本把话说的恰到好处，",
      "token_start": 351,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 92390,
      "end_ms": 93775,
      "text": "才学会这些处事思路。",
      "token_start": 367,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 94090,
      "end_ms": 95090,
      "text": "假如你不爱说话，",
      "token_start": 376,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 95170,
      "end_ms": 95850,
      "text": "不爱争辩，",
      "token_start": 383,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 95870,
      "end_ms": 96630,
      "text": "也不爱出门，",
      "token_start": 387,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 96770,
      "end_ms": 100245,
      "text": "甚至恐惧社交推荐你读完这本把话说的恰到好处，",
      "token_start": 392,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 100560,
      "end_ms": 102480,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 413,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 102700,
      "end_ms": 103895,
      "text": "你每天就看两页，",
      "token_start": 425,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 104200,
      "end_ms": 105425,
      "text": "每一个场景慢慢练，",
      "token_start": 432,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 105710,
      "end_ms": 108025,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 440,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 108390,
      "end_ms": 109630,
      "text": "在这本书里有一句话，",
      "token_start": 455,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 109630,
      "end_ms": 110625,
      "text": "我特别欣赏，",
      "token_start": 464,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 110930,
      "end_ms": 111010,
      "text": "他，",
      "token_start": 469,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 111010,
      "end_ms": 113110,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 470,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 113250,
      "end_ms": 113870,
      "text": "你可以回，",
      "token_start": 482,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 114150,
      "end_ms": 115130,
      "text": "那是不优秀点，",
      "token_start": 486,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 115250,
      "end_ms": 116605,
      "text": "怎么能和你做朋友呢？",
      "token_start": 492,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 116830,
      "end_ms": 118170,
      "text": "当有人说你真聪明，",
      "token_start": 501,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 118310,
      "end_ms": 119805,
      "text": "你就回近朱者赤，",
      "token_start": 509,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 120080,
      "end_ms": 120880,
      "text": "和你在一起啊，",
      "token_start": 516,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 120880,
      "end_ms": 123685,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 522,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 124040,
      "end_ms": 125160,
      "text": "你就会领导，",
      "token_start": 537,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 125160,
      "end_ms": 126395,
      "text": "这都是我应该做的，",
      "token_start": 542,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 126690,
      "end_ms": 128050,
      "text": "强将手下无弱兵，",
      "token_start": 550,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 128190,
      "end_ms": 129595,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 557,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 129970,
      "end_ms": 131370,
      "text": "当我看到这段的时候，",
      "token_start": 566,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 131370,
      "end_ms": 133275,
      "text": "这个真是让我欲解心开啊。",
      "token_start": 575,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 133750,
      "end_ms": 135065,
      "text": "每一句都很有意思，",
      "token_start": 586,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 135340,
      "end_ms": 138460,
      "text": "就是手把手教我们在不同的场景之下应该怎么说。",
      "token_start": 594,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 138800,
      "end_ms": 141555,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 615,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 141790,
      "end_ms": 143110,
      "text": "你就放心的拿回去看，",
      "token_start": 633,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 143330,
      "end_ms": 144710,
      "text": "就是一句一句的教你，",
      "token_start": 642,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 144810,
      "end_ms": 146970,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 651,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 147170,
      "end_ms": 148230,
      "text": "但凡学会三分，",
      "token_start": 663,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 148370,
      "end_ms": 150665,
      "text": "你都能把人际关系拿捏的死死的，",
      "token_start": 669,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 150910,
      "end_ms": 152645,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 683,
      "token_end_exclusive": 695
    }
  ],
