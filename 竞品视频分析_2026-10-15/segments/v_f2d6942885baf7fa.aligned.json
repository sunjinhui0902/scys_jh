{
  "video_id": "v_f2d6942885baf7fa",
  "duration_s": 212.137914,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f2d6942885baf7fa.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f2d6942885baf7fa.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 710,
      "text": "朱军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1010,
      "end_ms": 2730,
      "text": "你知道你有多少个祖先吗？",
      "token_start": 2,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 2990,
      "end_ms": 6550,
      "text": "你知道一句列祖列宗在上就能码出来多少人吗？",
      "token_start": 13,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 6830,
      "end_ms": 7910,
      "text": "除了龟孙儿，",
      "token_start": 33,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 7910,
      "end_ms": 10070,
      "text": "这就是你的祖宗十八代。",
      "token_start": 38,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 10070,
      "end_ms": 10670,
      "text": "你看，",
      "token_start": 48,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 10670,
      "end_ms": 11850,
      "text": "当你站立时，",
      "token_start": 50,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 11850,
      "end_ms": 13590,
      "text": "父亲站在你的左后肩，",
      "token_start": 55,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 13590,
      "end_ms": 15330,
      "text": "母亲站在你的右后肩，",
      "token_start": 64,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 15330,
      "end_ms": 18330,
      "text": "而你的父母后面又在站着他们的父亲母亲，",
      "token_start": 73,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 18570,
      "end_ms": 19450,
      "text": "以此类推。",
      "token_start": 91,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 19510,
      "end_ms": 21250,
      "text": "往上仅仅数十八代，",
      "token_start": 95,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 21310,
      "end_ms": 24470,
      "text": "据说你身后就站着五十二万位祖先，",
      "token_start": 103,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 24790,
      "end_ms": 26630,
      "text": "相当于一个小县城的人口啊，",
      "token_start": 118,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 26830,
      "end_ms": 28310,
      "text": "就这五十二万人里面，",
      "token_start": 130,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 28310,
      "end_ms": 30360,
      "text": "但凡有一个人差一个环节，",
      "token_start": 139,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 30360,
      "end_ms": 31120,
      "text": "在古代饿死了，",
      "token_start": 150,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 31120,
      "end_ms": 31900,
      "text": "或者没了，",
      "token_start": 156,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 31900,
      "end_ms": 33280,
      "text": "咱就不存在了。",
      "token_start": 160,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 33280,
      "end_ms": 36100,
      "text": "所以诸君你永远不要妄自菲薄，",
      "token_start": 166,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 36100,
      "end_ms": 37540,
      "text": "但凡能够留到今天。",
      "token_start": 179,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 37540,
      "end_ms": 40480,
      "text": "你的祖上一定是达官显贵名门望族，",
      "token_start": 187,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 40480,
      "end_ms": 43200,
      "text": "没点实力搁古代那个环境根本活不下来，",
      "token_start": 202,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 43440,
      "end_ms": 45360,
      "text": "一句列祖列宗在上，",
      "token_start": 219,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 45580,
      "end_ms": 47700,
      "text": "你这时候是一个人在面对问题吗？",
      "token_start": 227,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 47720,
      "end_ms": 49740,
      "text": "我们的祖先都站在我们的身后，",
      "token_start": 241,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 49820,
      "end_ms": 51040,
      "text": "你有啥坎过不去？",
      "token_start": 254,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 51440,
      "end_ms": 53440,
      "text": "你看这就是风华正茂的。",
      "token_start": 261,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 53440,
      "end_ms": 55240,
      "text": "你上一代是你的父亲，",
      "token_start": 271,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 55480,
      "end_ms": 56880,
      "text": "你父亲的父亲叫祖父，",
      "token_start": 280,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 56880,
      "end_ms": 58800,
      "text": "祖父的父亲叫曾祖，",
      "token_start": 289,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 58800,
      "end_ms": 60650,
      "text": "曾祖的父亲叫高祖，",
      "token_start": 297,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 60970,
      "end_ms": 62565,
      "text": "高祖的父亲叫天祖。",
      "token_start": 305,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 62960,
      "end_ms": 64475,
      "text": "天祖的父亲叫列祖，",
      "token_start": 313,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 64780,
      "end_ms": 66360,
      "text": "列祖的父亲叫太祖，",
      "token_start": 321,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 66560,
      "end_ms": 68175,
      "text": "太祖的父亲叫元祖，",
      "token_start": 329,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 68460,
      "end_ms": 70185,
      "text": "元祖的父亲叫鼻祖。",
      "token_start": 337,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 70520,
      "end_ms": 73075,
      "text": "所以我们把鼻祖做门内地位最高的人，",
      "token_start": 345,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 73370,
      "end_ms": 75185,
      "text": "而这就是上九代，",
      "token_start": 361,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 75500,
      "end_ms": 77085,
      "text": "你的下一代就是儿子。",
      "token_start": 368,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 77390,
      "end_ms": 78690,
      "text": "儿子的儿子叫孙子，",
      "token_start": 377,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 78830,
      "end_ms": 80175,
      "text": "孙子的儿子叫曾孙，",
      "token_start": 385,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 80520,
      "end_ms": 81955,
      "text": "曾孙的儿子叫玄孙，",
      "token_start": 393,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 82300,
      "end_ms": 83700,
      "text": "玄孙的儿子叫来孙，",
      "token_start": 401,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 83960,
      "end_ms": 85455,
      "text": "来孙的儿子叫昆孙，",
      "token_start": 409,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 85730,
      "end_ms": 87670,
      "text": "昆孙的儿子叫仁孙仁，",
      "token_start": 417,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 87670,
      "end_ms": 88875,
      "text": "孙的儿子叫云孙，",
      "token_start": 426,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 89200,
      "end_ms": 90720,
      "text": "云孙的儿子叫耳孙，",
      "token_start": 433,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 91100,
      "end_ms": 92475,
      "text": "这些就是下九代，",
      "token_start": 441,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 92880,
      "end_ms": 94020,
      "text": "上九辈叫祖，",
      "token_start": 448,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 94320,
      "end_ms": 95440,
      "text": "下九辈叫宗，",
      "token_start": 453,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 95660,
      "end_ms": 97855,
      "text": "合起来就是祖宗十八代。",
      "token_start": 458,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 98190,
      "end_ms": 99070,
      "text": "而民间说法，",
      "token_start": 468,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 99250,
      "end_ms": 100950,
      "text": "龟孙就是耳孙之后，",
      "token_start": 473,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 101030,
      "end_ms": 102275,
      "text": "也就是下时代，",
      "token_start": 481,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 102590,
      "end_ms": 104390,
      "text": "只是把对方贬的辈分很低，",
      "token_start": 487,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 104510,
      "end_ms": 105595,
      "text": "是不文明的语言啊，",
      "token_start": 498,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 105930,
      "end_ms": 106605,
      "text": "你知道吗？",
      "token_start": 506,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 106890,
      "end_ms": 108170,
      "text": "佛你可以不拜神，",
      "token_start": 510,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 108170,
      "end_ms": 108950,
      "text": "你可以不敬，",
      "token_start": 517,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 109130,
      "end_ms": 110590,
      "text": "但是祖先不能不祭死，",
      "token_start": 522,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 110750,
      "end_ms": 111375,
      "text": "为什么呢？",
      "token_start": 531,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 111580,
      "end_ms": 112660,
      "text": "因为佛有寺庙，",
      "token_start": 535,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 112660,
      "end_ms": 113435,
      "text": "神有道观，",
      "token_start": 541,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 113690,
      "end_ms": 115150,
      "text": "如果祖先不祭祀的话，",
      "token_start": 545,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 115150,
      "end_ms": 116590,
      "text": "就会变成孤魂野鬼。",
      "token_start": 554,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 116770,
      "end_ms": 118010,
      "text": "所以每一年中元节，",
      "token_start": 562,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 118030,
      "end_ms": 119785,
      "text": "七月半一定要祭祖，",
      "token_start": 570,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 120220,
      "end_ms": 122220,
      "text": "没有一个人真正是白手起家的。",
      "token_start": 578,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 122220,
      "end_ms": 124015,
      "text": "你以为自己是从零开始，",
      "token_start": 591,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 124280,
      "end_ms": 127725,
      "text": "其实你的零都是祖祖辈辈几代人的终点。",
      "token_start": 601,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 128140,
      "end_ms": 128520,
      "text": "朱军，",
      "token_start": 618,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 128720,
      "end_ms": 130840,
      "text": "您知道自己家的糖号是什么吗？",
      "token_start": 620,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 130980,
      "end_ms": 132260,
      "text": "比如我们肇庆啊，",
      "token_start": 633,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 132260,
      "end_ms": 136300,
      "text": "就有天水堂、半步堂、南阳堂、颍川堂、卓郡堂等等堂，",
      "token_start": 640,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 136500,
      "end_ms": 137600,
      "text": "就是房子的意思，",
      "token_start": 660,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 137740,
      "end_ms": 139760,
      "text": "家族昌盛就叫四世同堂，",
      "token_start": 667,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 139960,
      "end_ms": 140640,
      "text": "长得好看，",
      "token_start": 677,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 140680,
      "end_ms": 141780,
      "text": "叫相貌堂堂，",
      "token_start": 681,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 141960,
      "end_ms": 143945,
      "text": "为人正直叫堂堂正正。",
      "token_start": 686,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 144340,
      "end_ms": 146485,
      "text": "唐昊是中国一个家族的标志，",
      "token_start": 695,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 147000,
      "end_ms": 150885,
      "text": "全世界每一个名门望族都有自己姓氏的独特的logo,",
      "token_start": 707,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 151150,
      "end_ms": 152390,
      "text": "在欧洲叫盾牌，",
      "token_start": 728,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 152570,
      "end_ms": 153790,
      "text": "在新西兰是涂徽，",
      "token_start": 734,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 153930,
      "end_ms": 154510,
      "text": "在中国，",
      "token_start": 741,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 154550,
      "end_ms": 155745,
      "text": "这就是唐昊。",
      "token_start": 744,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 156140,
      "end_ms": 158575,
      "text": "比如我们家祖上半部论语治天下，",
      "token_start": 749,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 158820,
      "end_ms": 160085,
      "text": "所以叫半步糖。",
      "token_start": 763,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 160500,
      "end_ms": 163835,
      "text": "我们每一年祭祖总是在说列祖列宗保佑我们。",
      "token_start": 769,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 164100,
      "end_ms": 167225,
      "text": "但是朱军一百年以后你也是列祖列宗啊，",
      "token_start": 788,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 167590,
      "end_ms": 169365,
      "text": "我们准备给后人留下什么呢？",
      "token_start": 805,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 169830,
      "end_ms": 170410,
      "text": "一个家庭，",
      "token_start": 817,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 170410,
      "end_ms": 171150,
      "text": "最好的风水，",
      "token_start": 821,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 171150,
      "end_ms": 172875,
      "text": "就是祖祖辈辈怎么做人。",
      "token_start": 826,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 173200,
      "end_ms": 174340,
      "text": "爷爷做人厚道，",
      "token_start": 836,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 174380,
      "end_ms": 175580,
      "text": "父亲做事诚信，",
      "token_start": 842,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 175660,
      "end_ms": 176815,
      "text": "母亲待人善良，",
      "token_start": 848,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 177090,
      "end_ms": 178715,
      "text": "孩子从小耳濡目染，",
      "token_start": 854,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 179170,
      "end_ms": 179830,
      "text": "所谓祖宗，",
      "token_start": 862,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 179830,
      "end_ms": 180930,
      "text": "基德就是上一代，",
      "token_start": 866,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 180930,
      "end_ms": 181810,
      "text": "留下好名声，",
      "token_start": 873,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 181990,
      "end_ms": 183170,
      "text": "真的会变成下一代。",
      "token_start": 878,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 183170,
      "end_ms": 184285,
      "text": "走路时的底气。",
      "token_start": 886,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 184720,
      "end_ms": 185660,
      "text": "祖坟在哪儿，",
      "token_start": 892,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 185660,
      "end_ms": 186965,
      "text": "未必会决定你的命运。",
      "token_start": 897,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 187170,
      "end_ms": 187410,
      "text": "但是，",
      "token_start": 906,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 187410,
      "end_ms": 188390,
      "text": "祖辈怎么做人，",
      "token_start": 908,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 188390,
      "end_ms": 190325,
      "text": "真的可能会影响几代人的命运。",
      "token_start": 914,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 190690,
      "end_ms": 191670,
      "text": "所谓家族兴旺，",
      "token_start": 927,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 191670,
      "end_ms": 193765,
      "text": "并不是哪一代人突然飞黄腾达，",
      "token_start": 933,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 194000,
      "end_ms": 195560,
      "text": "而是一代人托举一代人，",
      "token_start": 946,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 195700,
      "end_ms": 197095,
      "text": "一代人照亮一代人。",
      "token_start": 956,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 197440,
      "end_ms": 200995,
      "text": "真正的家风是父母用思维垫高后代的起点。",
      "token_start": 964,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 201310,
      "end_ms": 201875,
      "text": "弯下腰，",
      "token_start": 982,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 202160,
      "end_ms": 203720,
      "text": "让孩子站在自己的肩膀上，",
      "token_start": 985,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 203720,
      "end_ms": 204685,
      "text": "看整个世界。",
      "token_start": 996,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 205070,
      "end_ms": 205670,
      "text": "百年之后，",
      "token_start": 1001,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 205670,
      "end_ms": 207555,
      "text": "我们给后代留下一个什么样的世界，",
