{
  "video_id": "v_c11293bda31d14a7",
  "duration_s": 420.096009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c11293bda31d14a7.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c11293bda31d14a7.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 4610,
      "text": "您知道中国最适合慢慢走的原生态古镇是哪一座吗？",
      "token_start": 0,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5210,
      "end_ms": 5870,
      "text": "上集，",
      "token_start": 22,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5890,
      "end_ms": 10330,
      "text": "咱们聊了木渎新氏青木川，",
      "token_start": 24,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 10410,
      "end_ms": 14550,
      "text": "钱同偏言这集直接揭开谜底，",
      "token_start": 35,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 14970,
      "end_ms": 18110,
      "text": "看看前五名让人心安到什么程度。",
      "token_start": 47,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 18110,
      "end_ms": 23270,
      "text": "尤其是排在榜首的那座藏在隐秘山谷里，",
      "token_start": 61,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 23270,
      "end_ms": 29635,
      "text": "留存着整个茶马古道上唯一存活至今的原生态集市。",
      "token_start": 78,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 30140,
      "end_ms": 33360,
      "text": "日子安宁的像停在了几百年前。",
      "token_start": 100,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 33800,
      "end_ms": 35880,
      "text": "看到这儿觉得有点意思的朋友，",
      "token_start": 113,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 36040,
      "end_ms": 37600,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 126,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 37780,
      "end_ms": 38560,
      "text": "收藏起来，",
      "token_start": 136,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 38740,
      "end_ms": 39640,
      "text": "省得手一滑，",
      "token_start": 140,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 39720,
      "end_ms": 40660,
      "text": "咱们就错过了。",
      "token_start": 145,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 40940,
      "end_ms": 41680,
      "text": "第五名，",
      "token_start": 151,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 42060,
      "end_ms": 43300,
      "text": "锦溪古镇，",
      "token_start": 154,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 43640,
      "end_ms": 44680,
      "text": "江苏苏州，",
      "token_start": 158,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 44700,
      "end_ms": 47200,
      "text": "昆山下集头一站，",
      "token_start": 162,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 47440,
      "end_ms": 49600,
      "text": "咱们回到您最熟的江南，",
      "token_start": 169,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 50040,
      "end_ms": 51580,
      "text": "锦西守着五宝湖，",
      "token_start": 179,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 52020,
      "end_ms": 53860,
      "text": "镇上有三十六座古桥，",
      "token_start": 186,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 54460,
      "end_ms": 55420,
      "text": "有的跨河，",
      "token_start": 195,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 55820,
      "end_ms": 57460,
      "text": "有的就架在湖面上。",
      "token_start": 199,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 57700,
      "end_ms": 58600,
      "text": "一座挨着，",
      "token_start": 207,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 58600,
      "end_ms": 60705,
      "text": "一座锦面变开阔，",
      "token_start": 211,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 61090,
      "end_ms": 62030,
      "text": "站在桥上，",
      "token_start": 218,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 62170,
      "end_ms": 64010,
      "text": "眼前没有遮挡视野，",
      "token_start": 222,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 64010,
      "end_ms": 66130,
      "text": "一下子就打开了古莲。",
      "token_start": 230,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 66130,
      "end_ms": 67445,
      "text": "池边风一吹，",
      "token_start": 239,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 67860,
      "end_ms": 70440,
      "text": "荷叶晃成一片盐湖，",
      "token_start": 244,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 70460,
      "end_ms": 71860,
      "text": "那条青石板路，",
      "token_start": 252,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 72020,
      "end_ms": 73160,
      "text": "平平缓缓，",
      "token_start": 258,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 73280,
      "end_ms": 74275,
      "text": "不用爬坡。",
      "token_start": 262,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 74800,
      "end_ms": 76225,
      "text": "三十六座桥。",
      "token_start": 266,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 76570,
      "end_ms": 77145,
      "text": "您想想，",
      "token_start": 271,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 77430,
      "end_ms": 79450,
      "text": "一天只走一座也够，",
      "token_start": 274,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 79450,
      "end_ms": 80655,
      "text": "您走一个多月，",
      "token_start": 282,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 81040,
      "end_ms": 82315,
      "text": "您不用赶着打卡，",
      "token_start": 288,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 83060,
      "end_ms": 85465,
      "text": "走几步就能停下来看水，",
      "token_start": 295,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 86030,
      "end_ms": 86750,
      "text": "看够了，",
      "token_start": 305,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 86750,
      "end_ms": 88640,
      "text": "再往前走，",
      "token_start": 308,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 88680,
      "end_ms": 90145,
      "text": "一步停一会儿，",
      "token_start": 312,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 90510,
      "end_ms": 91730,
      "text": "心里一点不亏欠，",
      "token_start": 318,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 91730,
      "end_ms": 93575,
      "text": "谁这才叫慢慢走。",
      "token_start": 325,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 93930,
      "end_ms": 96095,
      "text": "第四名名鹤古镇，",
      "token_start": 332,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 96540,
      "end_ms": 100715,
      "text": "浙江宁波慈溪听名字像仙鹤待的地方。",
      "token_start": 339,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 101140,
      "end_ms": 101920,
      "text": "老辈人说，",
      "token_start": 355,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 101980,
      "end_ms": 103380,
      "text": "唐朝有位隐士，",
      "token_start": 359,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 103460,
      "end_ms": 105000,
      "text": "在这住过镇子，",
      "token_start": 365,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 105000,
      "end_ms": 106155,
      "text": "就叫了名贺。",
      "token_start": 371,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 106640,
      "end_ms": 108335,
      "text": "他一边临着白杨湖，",
      "token_start": 376,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 108670,
      "end_ms": 110075,
      "text": "一边是青蛙老街，",
      "token_start": 384,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 110540,
      "end_ms": 112985,
      "text": "湖边的堤是平缓的步道。",
      "token_start": 391,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 113470,
      "end_ms": 118295,
      "text": "镇上最出名的是国药叶种德唐开了三百多年，",
      "token_start": 401,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 118760,
      "end_ms": 120660,
      "text": "药柜一排挨一排，",
      "token_start": 420,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 121020,
      "end_ms": 122695,
      "text": "到今天还摆在那儿。",
      "token_start": 427,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 123070,
      "end_ms": 124370,
      "text": "您一进老街，",
      "token_start": 435,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 124850,
      "end_ms": 127055,
      "text": "先闻到的是药草味，",
      "token_start": 440,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 127490,
      "end_ms": 129785,
      "text": "淡淡的苦里带点甘，",
      "token_start": 448,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 130520,
      "end_ms": 132405,
      "text": "顺着街走到湖边，",
      "token_start": 456,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 132760,
      "end_ms": 134635,
      "text": "风里就换成了水汽。",
      "token_start": 463,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 135000,
      "end_ms": 136775,
      "text": "这儿不用您打起精神，",
      "token_start": 471,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 137330,
      "end_ms": 139775,
      "text": "是让您把气喘匀的地方。",
      "token_start": 480,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 140390,
      "end_ms": 141465,
      "text": "一边是湖，",
      "token_start": 490,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 141900,
      "end_ms": 142925,
      "text": "一边是药铺，",
      "token_start": 494,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 143370,
      "end_ms": 146205,
      "text": "走着走着肩膀就松下来了。",
      "token_start": 499,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 146620,
      "end_ms": 147385,
      "text": "第三名，",
      "token_start": 510,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 147730,
      "end_ms": 148555,
      "text": "姚里古镇，",
      "token_start": 513,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 149120,
      "end_ms": 151075,
      "text": "江西景德镇浮梁。",
      "token_start": 517,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 151840,
      "end_ms": 154045,
      "text": "很多人知道景德镇的瓷器，",
      "token_start": 524,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 154430,
      "end_ms": 157375,
      "text": "却不知道窑里才是瓷器的源头。",
      "token_start": 535,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 158140,
      "end_ms": 161925,
      "text": "一条清冽见底的瑶河从大山深处流出，",
      "token_start": 548,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 162430,
      "end_ms": 163975,
      "text": "把镇子一分为二，",
      "token_start": 564,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 164410,
      "end_ms": 166070,
      "text": "两岸整整齐齐排开。",
      "token_start": 571,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 166070,
      "end_ms": 169700,
      "text": "上百幢明清徽派老屋飞檐翘角，",
      "token_start": 579,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 169960,
      "end_ms": 172035,
      "text": "被苍翠的山林抱在怀里。",
      "token_start": 592,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 172630,
      "end_ms": 173110,
      "text": "清晨，",
      "token_start": 602,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 173210,
      "end_ms": 175205,
      "text": "山里的晨雾漫过河面，",
      "token_start": 604,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 175730,
      "end_ms": 180480,
      "text": "河滩上是一声接一声的木锤倒衣声木桥，",
      "token_start": 613,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 180580,
      "end_ms": 183160,
      "text": "横跨两岸老樟树，",
      "token_start": 630,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 183360,
      "end_ms": 184240,
      "text": "垂下浓荫，",
      "token_start": 637,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 184980,
      "end_ms": 188020,
      "text": "这就是真正的天青色等烟雨。",
      "token_start": 641,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 188700,
      "end_ms": 191060,
      "text": "没有商业的矫揉造作，",
      "token_start": 653,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 191440,
      "end_ms": 192560,
      "text": "您撑一把伞，",
      "token_start": 662,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 192680,
      "end_ms": 194420,
      "text": "踩在湿润的石阶上，",
      "token_start": 667,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 194880,
      "end_ms": 197280,
      "text": "走在水墨画一般的景致里，",
      "token_start": 675,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 197640,
      "end_ms": 202300,
      "text": "身心都被这片山水洗的清透窑里排第三，",
      "token_start": 686,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 202720,
      "end_ms": 203860,
      "text": "靠的是两个字，",
      "token_start": 703,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 204120,
      "end_ms": 204700,
      "text": "出尘。",
      "token_start": 709,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 205120,
      "end_ms": 205720,
      "text": "第二名，",
      "token_start": 711,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 206140,
      "end_ms": 207160,
      "text": "黄姚古镇，",
      "token_start": 714,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 207560,
      "end_ms": 209285,
      "text": "广西贺州昭平。",
      "token_start": 718,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 210020,
      "end_ms": 211160,
      "text": "一提广西，",
      "token_start": 724,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 211580,
      "end_ms": 213540,
      "text": "您先想到桂林的山，",
      "token_start": 728,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 214160,
      "end_ms": 215640,
      "text": "黄窑的山也不疏，",
      "token_start": 736,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 216540,
      "end_ms": 219180,
      "text": "齐峰一座座从田里拔起来，",
      "token_start": 743,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 219680,
      "end_ms": 221700,
      "text": "溪水绕着镇子回环。",
      "token_start": 754,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 222160,
      "end_ms": 226660,
      "text": "他宋朝开宝年间就有了一千多年下来，",
      "token_start": 762,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 227080,
      "end_ms": 229000,
      "text": "明清时越来越热闹。",
      "token_start": 778,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 229560,
      "end_ms": 230620,
      "text": "抗战那几年，",
      "token_start": 786,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 230980,
      "end_ms": 233040,
      "text": "不少文化人躲到这避难。",
      "token_start": 791,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 233420,
      "end_ms": 236900,
      "text": "待龙桥边有龙爪龙根须垂下来，",
      "token_start": 801,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 236900,
      "end_ms": 238140,
      "text": "向龙爪抓着地，",
      "token_start": 814,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 238500,
      "end_ms": 240635,
      "text": "把青石路折的严严实实。",
      "token_start": 820,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 241030,
      "end_ms": 241870,
      "text": "站在桥上，",
      "token_start": 830,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 242130,
      "end_ms": 243750,
      "text": "一抬头是清风，",
      "token_start": 834,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 243810,
      "end_ms": 244255,
      "text": "古树，",
      "token_start": 840,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 244630,
      "end_ms": 246255,
      "text": "一低头是溪水。",
      "token_start": 842,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 246570,
      "end_ms": 248045,
      "text": "这儿天气温润，",
      "token_start": 848,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 248810,
      "end_ms": 252195,
      "text": "街巷里的人家就在山水中间过日子，",
      "token_start": 854,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 252780,
      "end_ms": 254445,
      "text": "中间没有一道围墙。",
      "token_start": 869,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 255150,
      "end_ms": 256365,
      "text": "黄瑶排第二，",
      "token_start": 877,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 256690,
      "end_ms": 257845,
      "text": "靠的是两个字，",
      "token_start": 882,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 258230,
      "end_ms": 259720,
      "text": "天然第一名。",
      "token_start": 888,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 260040,
      "end_ms": 260995,
      "text": "沙溪古镇，",
      "token_start": 893,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 261450,
      "end_ms": 262915,
      "text": "云南、大理建川。",
      "token_start": 897,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 263490,
      "end_ms": 264475,
      "text": "为什么是他？",
      "token_start": 903,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 264920,
      "end_ms": 265860,
      "text": "很多朋友以为，",
      "token_start": 908,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 265860,
      "end_ms": 269445,
      "text": "榜首肯定是大理古城或者凤凰古镇，",
      "token_start": 914,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 270130,
      "end_ms": 274195,
      "text": "可那些地方早就被酒吧、民谣和游客填满了。",
      "token_start": 929,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 274630,
      "end_ms": 282115,
      "text": "而沙溪一直安静的藏在剑川县黑会江畔的狭长盆地里。",
      "token_start": 947,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 282550,
      "end_ms": 286565,
      "text": "当年两千多公里的茶马古道马蹄声碎，",
      "token_start": 970,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 287020,
      "end_ms": 288235,
      "text": "几百年过去，",
      "token_start": 986,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 288640,
      "end_ms": 293765,
      "text": "所有的古籍是全被现代公路和高楼大厦抹平了，",
      "token_start": 991,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 294350,
      "end_ms": 295950,
      "text": "唯独留下杀溪。",
      "token_start": 1011,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 296190,
      "end_ms": 301825,
      "text": "这一个完整活着的古籍是红砂石铺成的四方街上。",
      "token_start": 1017,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 302530,
      "end_ms": 305555,
      "text": "古戏台信教寺隔街相望，",
      "token_start": 1038,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 306260,
      "end_ms": 308745,
      "text": "四周是土坯墙和黑瓦屋顶，",
      "token_start": 1048,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 309230,
      "end_ms": 310735,
      "text": "地势平展如镜，",
      "token_start": 1059,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 311150,
      "end_ms": 315950,
      "text": "黑惠江水安安静静躺过玉金桥几百岁的老槐树，",
      "token_start": 1065,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 315950,
      "end_ms": 317345,
      "text": "叶子落了一地。",
      "token_start": 1085,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 317760,
      "end_ms": 319125,
      "text": "这里没有检票口，",
      "token_start": 1091,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 319620,
      "end_ms": 321095,
      "text": "没有拉客的导游，",
      "token_start": 1098,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 321680,
      "end_ms": 323980,
      "text": "当地白族阿婆挽着竹篮，",
      "token_start": 1105,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 323980,
      "end_ms": 325215,
      "text": "慢慢走过小巷，",
      "token_start": 1115,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 325730,
      "end_ms": 328195,
      "text": "连猫狗都躺在石板上午睡。",
      "token_start": 1121,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 328630,
      "end_ms": 330885,
      "text": "他没有把岁月当成商品卖掉，",
      "token_start": 1132,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 331300,
      "end_ms": 335205,
      "text": "而是完整封存了时间最原始的模样。",
      "token_start": 1144,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 335650,
      "end_ms": 336655,
      "text": "在沙溪走路，",
      "token_start": 1159,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 337030,
      "end_ms": 338745,
      "text": "您根本不用考虑往哪儿拐，",
      "token_start": 1164,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 339100,
      "end_ms": 340745,
      "text": "也不用赶任何景点，",
      "token_start": 1175,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 341210,
      "end_ms": 344085,
      "text": "每一步都踩在平缓的大地上，",
      "token_start": 1183,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 344660,
      "end_ms": 345760,
      "text": "听得见江水，",
      "token_start": 1195,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 345760,
      "end_ms": 347665,
      "text": "声闻得见泥土香。",
      "token_start": 1200,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 348320,
      "end_ms": 349320,
      "text": "杀溪排第一，",
      "token_start": 1207,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 349620,
      "end_ms": 350955,
      "text": "靠的是两个字，",
      "token_start": 1212,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 351590,
      "end_ms": 352850,
      "text": "本真十座。",
      "token_start": 1218,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 352850,
      "end_ms": 353775,
      "text": "古镇讲完了，",
      "token_start": 1222,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 354400,
      "end_ms": 355940,
      "text": "目睹让您听得平淡，",
      "token_start": 1227,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 356060,
      "end_ms": 357395,
      "text": "放下赶路的劲儿。",
      "token_start": 1235,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 358050,
      "end_ms": 365315,
      "text": "新氏是何布头洗菜的老街坊、青木川、青藻的河面起着三省交界的雾。",
      "token_start": 1242,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 365910,
      "end_ms": 373910,
      "text": "钱童家家门前躺着泉水偏严的黄爵树底下排着一溜竹蚁锦溪三十六座桥，",
      "token_start": 1270,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 373970,
      "end_ms": 376205,
      "text": "一天走一座够走一个多月，",
      "token_start": 1301,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 376670,
      "end_ms": 380300,
      "text": "鸣贺在药草香里调神窑里，",
      "token_start": 1312,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 380340,
      "end_ms": 382775,
      "text": "在天情水墨里出沉。",
      "token_start": 1323,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 383280,
      "end_ms": 386400,
      "text": "可只有沙溪古镇两千公里，",
      "token_start": 1331,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 386500,
      "end_ms": 388725,
      "text": "茶马古道退去繁华，",
      "token_start": 1342,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 389280,
      "end_ms": 392565,
      "text": "他却守住了天地间最干净的从容。",
      "token_start": 1350,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 393320,
      "end_ms": 394820,
      "text": "您说什么叫最适合？",
      "token_start": 1364,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 394820,
      "end_ms": 396480,
      "text": "慢慢走慢慢走，",
      "token_start": 1372,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 396500,
      "end_ms": 397455,
      "text": "不是脚下慢，",
      "token_start": 1378,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 397810,
      "end_ms": 403490,
      "text": "是心里没有下一站在催您最后问问您这十处古镇，",
      "token_start": 1383,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 403490,
      "end_ms": 406655,
      "text": "您去过几处最想去的是哪一处？",
      "token_start": 1404,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 407000,
      "end_ms": 407995,
      "text": "评论区告诉我，",
      "token_start": 1417,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 408450,
      "end_ms": 410525,
      "text": "觉得这期让您长了见识，",
      "token_start": 1423,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 410860,
      "end_ms": 412660,
      "text": "就转给身边跟您一样，",
      "token_start": 1433,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 412680,
      "end_ms": 414125,
      "text": "爱看古镇风物的人，",
      "token_start": 1442,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 414690,
      "end_ms": 415930,
      "text": "想听更多大美。",
      "token_start": 1450,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 415930,
      "end_ms": 418150,
      "text": "中国山河的故事点个关注，",
      "token_start": 1456,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 418370,
      "end_ms": 419815,
      "text": "咱们下期接着了。",
      "token_start": 1467,
      "token_end_exclusive": 1474
    }
  ],
