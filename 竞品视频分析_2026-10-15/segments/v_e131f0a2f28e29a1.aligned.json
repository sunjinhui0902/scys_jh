{
  "video_id": "v_e131f0a2f28e29a1",
  "duration_s": 587.023991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_e131f0a2f28e29a1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_e131f0a2f28e29a1.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 300,
      "end_ms": 4740,
      "text": "您知道中国秋天最令人惊叹的风光是哪一处吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5100,
      "end_ms": 5640,
      "text": "上集，",
      "token_start": 20,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5660,
      "end_ms": 15580,
      "text": "咱们聊了额尔古纳湿地、张掖七彩丹霞、米亚罗、红叶、塔里木胡杨林、长白山天池尤一集，",
      "token_start": 22,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 15700,
      "end_ms": 17180,
      "text": "直接揭开谜底，",
      "token_start": 57,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 17520,
      "end_ms": 19820,
      "text": "看看前五名惊叹到什么奇景，",
      "token_start": 63,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 20240,
      "end_ms": 23460,
      "text": "尤其是排在榜首的那处奇景，",
      "token_start": 75,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 24060,
      "end_ms": 28500,
      "text": "不仅坐拥一天之内变换数种色泽的奇幻大湖，",
      "token_start": 87,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 29200,
      "end_ms": 34630,
      "text": "清晨更更能在峡谷间幻化出如梦似幻的流动成物。",
      "token_start": 106,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 35050,
      "end_ms": 35830,
      "text": "话不多说，",
      "token_start": 127,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 36190,
      "end_ms": 37510,
      "text": "茶给您沏好了，",
      "token_start": 131,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 38069,
      "end_ms": 39950,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 137,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 40370,
      "end_ms": 41630,
      "text": "咱们这就开讲。",
      "token_start": 147,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 41930,
      "end_ms": 42650,
      "text": "第五名，",
      "token_start": 153,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 43150,
      "end_ms": 47230,
      "text": "往西龙脊梯田、桂林龙盛梯田，",
      "token_start": 156,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 47230,
      "end_ms": 48210,
      "text": "您肯定见过。",
      "token_start": 168,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 48610,
      "end_ms": 54190,
      "text": "可龙脊的梯田是把一整座山都当成了田梯田，",
      "token_start": 173,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 54290,
      "end_ms": 55630,
      "text": "从海拔三百米，",
      "token_start": 192,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 55750,
      "end_ms": 57490,
      "text": "一路啃到一千一百米，",
      "token_start": 198,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 57930,
      "end_ms": 59370,
      "text": "层层叠叠往上爬。",
      "token_start": 207,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 60180,
      "end_ms": 63630,
      "text": "这些田是壮族和瑶族的先民，",
      "token_start": 214,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 63770,
      "end_ms": 65835,
      "text": "一锄头一锄头啃出来的，",
      "token_start": 226,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 66320,
      "end_ms": 68940,
      "text": "从元朝开始修到清朝，",
      "token_start": 236,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 69020,
      "end_ms": 70155,
      "text": "初年才成型。",
      "token_start": 245,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 70970,
      "end_ms": 74075,
      "text": "前后六百多年没有机器，",
      "token_start": 250,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 74690,
      "end_ms": 76365,
      "text": "全靠人手和牛力。",
      "token_start": 260,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 76840,
      "end_ms": 77855,
      "text": "秋收时节，",
      "token_start": 267,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 78500,
      "end_ms": 79475,
      "text": "稻子熟了，",
      "token_start": 271,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 80320,
      "end_ms": 82615,
      "text": "空气里一股新米的清香，",
      "token_start": 275,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 83350,
      "end_ms": 85930,
      "text": "满山一圈一圈的金像，",
      "token_start": 285,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 85970,
      "end_ms": 87865,
      "text": "一条金龙盘在山上，",
      "token_start": 294,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 88500,
      "end_ms": 90225,
      "text": "木楼点缀在山腰，",
      "token_start": 302,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 90760,
      "end_ms": 92390,
      "text": "晨雾一绕人，",
      "token_start": 309,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 92390,
      "end_ms": 93615,
      "text": "走在田埂上，",
      "token_start": 314,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 93980,
      "end_ms": 95205,
      "text": "就像走在云里，",
      "token_start": 319,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 95580,
      "end_ms": 98965,
      "text": "一座山养活了一代又一代人，",
      "token_start": 325,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 99310,
      "end_ms": 102445,
      "text": "您说这是不是诗话更是日子？",
      "token_start": 337,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 102890,
      "end_ms": 103570,
      "text": "第四名，",
      "token_start": 349,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 103850,
      "end_ms": 107465,
      "text": "广西桂林海洋银杏灵川海洋乡。",
      "token_start": 352,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 108240,
      "end_ms": 110040,
      "text": "说起金黄的银杏，",
      "token_start": 365,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 110260,
      "end_ms": 112215,
      "text": "您多半想到北方，",
      "token_start": 372,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 112860,
      "end_ms": 114135,
      "text": "可谁能想到，",
      "token_start": 379,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 114560,
      "end_ms": 118425,
      "text": "南方的石头山里藏着一片银杏的海，",
      "token_start": 384,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 119130,
      "end_ms": 123315,
      "text": "当地人说有上百万株银杏是活化石，",
      "token_start": 399,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 124190,
      "end_ms": 126685,
      "text": "两亿多年前就长在地球上。",
      "token_start": 414,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 127030,
      "end_ms": 129410,
      "text": "后来大多灭绝了中国，",
      "token_start": 425,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 129430,
      "end_ms": 132780,
      "text": "成了他最后的老家海洋乡的人，",
      "token_start": 434,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 132820,
      "end_ms": 134685,
      "text": "把他们种在房前屋后，",
      "token_start": 447,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 135410,
      "end_ms": 136575,
      "text": "白果换钱，",
      "token_start": 456,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 137160,
      "end_ms": 138295,
      "text": "叶子遮阴，",
      "token_start": 460,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 138970,
      "end_ms": 140395,
      "text": "一代传一代。",
      "token_start": 464,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 140830,
      "end_ms": 142375,
      "text": "十一月中下旬，",
      "token_start": 469,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 142890,
      "end_ms": 145230,
      "text": "叶子黄透了风一过，",
      "token_start": 475,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 145610,
      "end_ms": 146715,
      "text": "哗哗往下落。",
      "token_start": 483,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 147430,
      "end_ms": 152115,
      "text": "孙露田埂屋顶全铺成了金色，",
      "token_start": 488,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 152540,
      "end_ms": 154360,
      "text": "更绝得是树，",
      "token_start": 500,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 154480,
      "end_ms": 157065,
      "text": "后面是一座座喀斯特石峰，",
      "token_start": 505,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 157500,
      "end_ms": 159795,
      "text": "风青辉树金黄，",
      "token_start": 516,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 160500,
      "end_ms": 163455,
      "text": "这样的搭配一点也不像南方，",
      "token_start": 522,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 164180,
      "end_ms": 167425,
      "text": "您说这是不是最暖的一种惊叹？",
      "token_start": 534,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 167770,
      "end_ms": 168435,
      "text": "第三名，",
      "token_start": 547,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 168850,
      "end_ms": 171205,
      "text": "四川阿坝黄龙五彩池，",
      "token_start": 550,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 171730,
      "end_ms": 173855,
      "text": "落入人间的高原瑶池。",
      "token_start": 559,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 174760,
      "end_ms": 176505,
      "text": "他海拔三千五百多米，",
      "token_start": 568,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 177060,
      "end_ms": 178840,
      "text": "整整六百九十三个，",
      "token_start": 577,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 178840,
      "end_ms": 179220,
      "text": "盖花，",
      "token_start": 585,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 179240,
      "end_ms": 180935,
      "text": "彩池层层相叠，",
      "token_start": 587,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 181340,
      "end_ms": 183245,
      "text": "规模达两万多平方米。",
      "token_start": 593,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 183680,
      "end_ms": 186480,
      "text": "数万年富含矿物质的高山泉水，",
      "token_start": 602,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 186600,
      "end_ms": 189670,
      "text": "奔流沉积在山谷间，",
      "token_start": 615,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 189850,
      "end_ms": 192845,
      "text": "凝结成一道道天然的金色池梗。",
      "token_start": 623,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 193330,
      "end_ms": 196825,
      "text": "深秋十月四周群峰耸立，",
      "token_start": 636,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 197280,
      "end_ms": 200605,
      "text": "漫山红花与落叶松正值金黄，",
      "token_start": 646,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 201200,
      "end_ms": 204715,
      "text": "这片彩池便展现出惊世的华彩。",
      "token_start": 658,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 205150,
      "end_ms": 208025,
      "text": "由于池底沉淀与光线折射，",
      "token_start": 671,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 208640,
      "end_ms": 209240,
      "text": "水色，",
      "token_start": 682,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 209280,
      "end_ms": 211230,
      "text": "呈现出翠绿战。",
      "token_start": 684,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 211230,
      "end_ms": 215660,
      "text": "蓝明皇与墨子如同一颗颗宝石，",
      "token_start": 690,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 215980,
      "end_ms": 219650,
      "text": "坠入金黄山林清冽的高原，",
      "token_start": 703,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 219890,
      "end_ms": 220890,
      "text": "秋风吹过，",
      "token_start": 714,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 221270,
      "end_ms": 222365,
      "text": "水光潋滟，",
      "token_start": 718,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 222730,
      "end_ms": 223655,
      "text": "澄澈见底，",
      "token_start": 722,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 224070,
      "end_ms": 228405,
      "text": "把斑斓水色与丘陵交织的如此纯粹。",
      "token_start": 726,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 228780,
      "end_ms": 230675,
      "text": "您说这神仙手笔服不服？",
      "token_start": 741,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 231030,
      "end_ms": 231725,
      "text": "第二名，",
      "token_start": 751,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 232140,
      "end_ms": 237540,
      "text": "四川稻城亚丁甘孜稻城亚丁在藏语里，",
      "token_start": 754,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 237540,
      "end_ms": 239210,
      "text": "是向阳之地被，",
      "token_start": 770,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 239210,
      "end_ms": 241225,
      "text": "叫做最后的香格里拉。",
      "token_start": 776,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 241690,
      "end_ms": 247360,
      "text": "三座雪山品字形立着最高的鲜乃至六千多米央，",
      "token_start": 785,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 247360,
      "end_ms": 251015,
      "text": "麦勇和夏诺多吉也在五千九百米上下。",
      "token_start": 805,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 251560,
      "end_ms": 253945,
      "text": "藏族人把他们当成神山，",
      "token_start": 821,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 254360,
      "end_ms": 255965,
      "text": "冰川就挂在山腰。",
      "token_start": 831,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 256440,
      "end_ms": 257805,
      "text": "秋天阳光一打，",
      "token_start": 838,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 258330,
      "end_ms": 260215,
      "text": "反着一层冷冷的白光。",
      "token_start": 844,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 260680,
      "end_ms": 264255,
      "text": "山下是冲古草殿和落荣牛场。",
      "token_start": 853,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 264750,
      "end_ms": 265210,
      "text": "十月，",
      "token_start": 865,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 265270,
      "end_ms": 270050,
      "text": "草甸一片惊黄牦牛慢慢走过几个孩子，",
      "token_start": 867,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 270050,
      "end_ms": 274185,
      "text": "拦得像从天上掉下来的海拔四千多米，",
      "token_start": 883,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 274710,
      "end_ms": 276875,
      "text": "风里带着冰碴子的粮，",
      "token_start": 899,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 277370,
      "end_ms": 278525,
      "text": "可真站在那儿。",
      "token_start": 908,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 278790,
      "end_ms": 286355,
      "text": "人先觉得自己小冰川的白草甸的、金天的蓝压在一个画面里，",
      "token_start": 914,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 286730,
      "end_ms": 289155,
      "text": "好看两个字根本装不下。",
      "token_start": 939,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 289630,
      "end_ms": 290085,
      "text": "您说。",
      "token_start": 949,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 290680,
      "end_ms": 291460,
      "text": "站在这儿，",
      "token_start": 951,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 291900,
      "end_ms": 295060,
      "text": "谁还敢说自己大那第一名到底是哪？",
      "token_start": 955,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 295220,
      "end_ms": 295900,
      "text": "先别急，",
      "token_start": 970,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 296660,
      "end_ms": 297580,
      "text": "聊到到这，",
      "token_start": 973,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 297720,
      "end_ms": 299620,
      "text": "我先唠几句心里话，",
      "token_start": 977,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 300100,
      "end_ms": 304060,
      "text": "盘完这九处留言区有个事儿特别一致。",
      "token_start": 985,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 304720,
      "end_ms": 307040,
      "text": "好多朋友说年轻时候忙，",
      "token_start": 1001,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 307280,
      "end_ms": 308180,
      "text": "没空出门，",
      "token_start": 1011,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 308880,
      "end_ms": 309860,
      "text": "好在退休，",
      "token_start": 1015,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 310020,
      "end_ms": 311940,
      "text": "有空了想去走走，",
      "token_start": 1019,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 312380,
      "end_ms": 314400,
      "text": "可不知道先去哪儿去了。",
      "token_start": 1026,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 314400,
      "end_ms": 316300,
      "text": "看什么高原的景，",
      "token_start": 1036,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 316640,
      "end_ms": 317440,
      "text": "北国的景，",
      "token_start": 1043,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 317840,
      "end_ms": 318960,
      "text": "身子骨去不了，",
      "token_start": 1047,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 319400,
      "end_ms": 321770,
      "text": "有没有坐在家家里也能看明白的，",
      "token_start": 1053,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 322210,
      "end_ms": 324170,
      "text": "还有带孙子孙女儿的更愁。",
      "token_start": 1067,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 324830,
      "end_ms": 327470,
      "text": "孩子问咱这地方为什么叫这个名字？",
      "token_start": 1078,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 327950,
      "end_ms": 330450,
      "text": "为什么到秋天会长成这样？",
      "token_start": 1093,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 330870,
      "end_ms": 332250,
      "text": "可自己也说不全。",
      "token_start": 1104,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 332850,
      "end_ms": 335190,
      "text": "您看咱们这个年纪看景，",
      "token_start": 1111,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 335310,
      "end_ms": 336850,
      "text": "不光是图个热闹，",
      "token_start": 1121,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 337410,
      "end_ms": 341410,
      "text": "更想知道这些大好河山到底是怎么来的。",
      "token_start": 1128,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 341770,
      "end_ms": 345050,
      "text": "可这些东西在手机上画完就忘上网，",
      "token_start": 1145,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 345090,
      "end_ms": 347990,
      "text": "查一堆乱七八糟的翻大布头，",
      "token_start": 1160,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 348310,
      "end_ms": 349490,
      "text": "又看的眼睛疼。",
      "token_start": 1172,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 349910,
      "end_ms": 350325,
      "text": "前阵。",
      "token_start": 1178,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 350460,
      "end_ms": 353745,
      "text": "那我翻到一本书正好解决这个问题，",
      "token_start": 1180,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 354330,
      "end_ms": 359485,
      "text": "叫大美中国人一生要去的一百零一个地方。",
      "token_start": 1195,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 359960,
      "end_ms": 364025,
      "text": "他把全中国最值得去的一百零一个地方挑出来，",
      "token_start": 1213,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 364320,
      "end_ms": 366200,
      "text": "分成五块自然奇观，",
      "token_start": 1233,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 366500,
      "end_ms": 369390,
      "text": "文明印记、烟火人间秘境，",
      "token_start": 1241,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 369390,
      "end_ms": 371005,
      "text": "寻踪人间天堂。",
      "token_start": 1251,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 371670,
      "end_ms": 374615,
      "text": "咱们今天聊的这些自然也都在里头，",
      "token_start": 1257,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 375060,
      "end_ms": 377025,
      "text": "这些秋色是怎么形成的？",
      "token_start": 1272,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 377380,
      "end_ms": 379560,
      "text": "有什么故事去了，",
      "token_start": 1282,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 379560,
      "end_ms": 382400,
      "text": "该看哪几处什么季节去，",
      "token_start": 1289,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 382400,
      "end_ms": 384230,
      "text": "最值几分钟。",
      "token_start": 1299,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 384270,
      "end_ms": 386470,
      "text": "一个地方讲的明明白白，",
      "token_start": 1304,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 386830,
      "end_ms": 388425,
      "text": "涂印的特别漂亮。",
      "token_start": 1314,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 388900,
      "end_ms": 390885,
      "text": "一页翻开就是一幅画，",
      "token_start": 1321,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 391320,
      "end_ms": 393045,
      "text": "我自己是这么用的，",
      "token_start": 1330,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 393410,
      "end_ms": 396830,
      "text": "能去的地方出门前翻一翻到了地方，",
      "token_start": 1338,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 396990,
      "end_ms": 397805,
      "text": "心里有底，",
      "token_start": 1353,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 398220,
      "end_ms": 400905,
      "text": "看的就不只是一片颜色，",
      "token_start": 1357,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 401230,
      "end_ms": 403990,
      "text": "而是故事暂时去不了的，",
      "token_start": 1367,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 404190,
      "end_ms": 405835,
      "text": "就着图文慢慢看，",
      "token_start": 1377,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 406190,
      "end_ms": 407185,
      "text": "也算去过了。",
      "token_start": 1384,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 407640,
      "end_ms": 408945,
      "text": "摆在茶几上，",
      "token_start": 1389,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 409680,
      "end_ms": 410840,
      "text": "孙辈来了，",
      "token_start": 1394,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 410860,
      "end_ms": 411755,
      "text": "翻两页，",
      "token_start": 1398,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 412140,
      "end_ms": 413385,
      "text": "长见识不说，",
      "token_start": 1401,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 413990,
      "end_ms": 416265,
      "text": "写作文也正好用得上。",
      "token_start": 1406,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 416930,
      "end_ms": 419330,
      "text": "老两口晚上翻翻商量，",
      "token_start": 1415,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 419430,
      "end_ms": 422885,
      "text": "明年去哪儿比刷手机舒坦多了，",
      "token_start": 1424,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 423340,
      "end_ms": 425935,
      "text": "房子会旧积蓄会花完，",
      "token_start": 1437,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 426710,
      "end_ms": 431885,
      "text": "可装在心里的山河眼界传几辈人都贬不了职，",
      "token_start": 1446,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 432550,
      "end_ms": 435070,
      "text": "趁现在还能买到给自己，",
      "token_start": 1465,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 435070,
      "end_ms": 437210,
      "text": "也给下一代备一份书。",
      "token_start": 1475,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 437290,
      "end_ms": 438995,
      "text": "就在左下角的商品里，",
      "token_start": 1484,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 439790,
      "end_ms": 442035,
      "text": "感兴趣的老朋友点进去看看，",
      "token_start": 1493,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 442730,
      "end_ms": 444515,
      "text": "人暂时走不出去，",
      "token_start": 1505,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 445000,
      "end_ms": 447155,
      "text": "咱先把大好河山装进屋里，",
      "token_start": 1512,
      "token_end_exclusive": 1523
    },
    {
      "start_ms": 447540,
      "end_ms": 449315,
      "text": "好说回正题，",
      "token_start": 1523,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 450050,
      "end_ms": 450675,
      "text": "第一名，",
      "token_start": 1528,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 451440,
      "end_ms": 455635,
      "text": "新疆喀纳斯湖与月亮湾乘雾阿尔泰山深处。",
      "token_start": 1531,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 456340,
      "end_ms": 457125,
      "text": "为什么是他？",
      "token_start": 1549,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 457630,
      "end_ms": 460465,
      "text": "前面的风光各有各的绝活，",
      "token_start": 1554,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 461080,
      "end_ms": 462275,
      "text": "有的靠颜色，",
      "token_start": 1565,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 462860,
      "end_ms": 464055,
      "text": "有的靠雪山，",
      "token_start": 1570,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 464550,
      "end_ms": 465655,
      "text": "有的靠池水，",
      "token_start": 1575,
      "token_end_exclusive": 1580
    },
    {
      "start_ms": 466200,
      "end_ms": 469040,
      "text": "可喀纳斯把他们全装进了。",
      "token_start": 1580,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 469040,
      "end_ms": 469955,
      "text": "同一个清晨，",
      "token_start": 1591,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 470390,
      "end_ms": 476470,
      "text": "他在新疆阿勒泰地区布尔金县藏在阿尔泰山最深的山坳里，",
      "token_start": 1596,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 476970,
      "end_ms": 479090,
      "text": "湖面四十多平方公里，",
      "token_start": 1621,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 479570,
      "end_ms": 481490,
      "text": "水深一百八十多米。",
      "token_start": 1630,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 481910,
      "end_ms": 484490,
      "text": "湖水是冰川融水汇成的，",
      "token_start": 1638,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 484810,
      "end_ms": 487470,
      "text": "湖水里带着冰川磨出来的细粉，",
      "token_start": 1648,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 488390,
      "end_ms": 489390,
      "text": "光线一换，",
      "token_start": 1661,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 489870,
      "end_ms": 490370,
      "text": "林子，",
      "token_start": 1665,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 490370,
      "end_ms": 492930,
      "text": "一黄水色也跟着换。",
      "token_start": 1667,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 493350,
      "end_ms": 495490,
      "text": "一天里能变好几个颜色，",
      "token_start": 1675,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 495830,
      "end_ms": 497710,
      "text": "当地图瓦人还世代传说，",
      "token_start": 1685,
      "token_end_exclusive": 1695
    },
    {
      "start_ms": 498210,
      "end_ms": 499230,
      "text": "湖里有大怪兽。",
      "token_start": 1695,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 499230,
      "end_ms": 502640,
      "text": "有有人说是一种叫折罗龟的大鱼，",
      "token_start": 1701,
      "token_end_exclusive": 1715
    },
    {
      "start_ms": 502960,
      "end_ms": 504440,
      "text": "到今天也没个定论。",
      "token_start": 1715,
      "token_end_exclusive": 1723
    },
    {
      "start_ms": 504860,
      "end_ms": 506420,
      "text": "九月底十月初，",
      "token_start": 1723,
      "token_end_exclusive": 1729
    },
    {
      "start_ms": 506820,
      "end_ms": 507360,
      "text": "秋天，",
      "token_start": 1729,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 507400,
      "end_ms": 516100,
      "text": "来的最早山坡上的白桦落叶松一起黄透金黄的林子沿着山坡铺到湖边。",
      "token_start": 1731,
      "token_end_exclusive": 1761
    },
    {
      "start_ms": 516860,
      "end_ms": 519260,
      "text": "可真正最神的是，",
      "token_start": 1761,
      "token_end_exclusive": 1768
    },
    {
      "start_ms": 519400,
      "end_ms": 521020,
      "text": "清早天没亮，",
      "token_start": 1768,
      "token_end_exclusive": 1773
    },
    {
      "start_ms": 521440,
      "end_ms": 523040,
      "text": "透山谷里起的雾，",
      "token_start": 1773,
      "token_end_exclusive": 1780
    },
    {
      "start_ms": 523440,
      "end_ms": 525860,
      "text": "一层一层从水面升上来，",
      "token_start": 1780,
      "token_end_exclusive": 1790
    },
    {
      "start_ms": 526140,
      "end_ms": 527000,
      "text": "漫过湖，",
      "token_start": 1790,
      "token_end_exclusive": 1793
    },
    {
      "start_ms": 527400,
      "end_ms": 531090,
      "text": "漫过林子湖和天分看不出边界。",
      "token_start": 1793,
      "token_end_exclusive": 1806
    },
    {
      "start_ms": 531470,
      "end_ms": 535230,
      "text": "喀纳斯河在山谷里拐出一道月牙形的河湾，",
      "token_start": 1806,
      "token_end_exclusive": 1824
    },
    {
      "start_ms": 535410,
      "end_ms": 538210,
      "text": "这就是月亮湾雾绕着河湾，",
      "token_start": 1824,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 538770,
      "end_ms": 541630,
      "text": "金黄的林子从雾里露出头来。",
      "token_start": 1835,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 542050,
      "end_ms": 542890,
      "text": "他排第一，",
      "token_start": 1847,
      "token_end_exclusive": 1851
    },
    {
      "start_ms": 543190,
      "end_ms": 545390,
      "text": "不是比谁最高最大，",
      "token_start": 1851,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 545850,
      "end_ms": 549110,
      "text": "而是因为只有他把冰川的水，",
      "token_start": 1859,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 549830,
      "end_ms": 555090,
      "text": "原始的林河湾和晨雾一起留在了一个清晨里，",
      "token_start": 1871,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 555450,
      "end_ms": 557190,
      "text": "十处绝美秋色讲完了，",
      "token_start": 1890,
      "token_end_exclusive": 1899
    },
    {
      "start_ms": 557370,
      "end_ms": 558750,
      "text": "最后把问题交给您。",
      "token_start": 1899,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 559430,
      "end_ms": 561760,
      "text": "这十处秋景您去过几处，",
      "token_start": 1907,
      "token_end_exclusive": 1917
    },
    {
      "start_ms": 562060,
      "end_ms": 563500,
      "text": "最想去的是哪一处？",
      "token_start": 1917,
      "token_end_exclusive": 1925
    },
    {
      "start_ms": 563740,
      "end_ms": 564820,
      "text": "评论区告诉我，",
      "token_start": 1925,
      "token_end_exclusive": 1931
    },
    {
      "start_ms": 565140,
      "end_ms": 573440,
