{
  "video_id": "v_f959190bccab511c",
  "duration_s": 243.666667,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f959190bccab511c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f959190bccab511c.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 1590,
      "text": "东坡先生你好吗？",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2070,
      "end_ms": 5370,
      "text": "我脚下的这片岛屿是你人生中最心酸的地方，",
      "token_start": 7,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5730,
      "end_ms": 7830,
      "text": "这是你流放之路上的最后一站。",
      "token_start": 26,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 8109,
      "end_ms": 10810,
      "text": "海南宋哲宗少盛四年，",
      "token_start": 39,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 10930,
      "end_ms": 13150,
      "text": "六十二岁的你被贬到海南儋州，",
      "token_start": 48,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 13550,
      "end_ms": 16490,
      "text": "据说在宋朝最终的罪罚就是满门抄斩。",
      "token_start": 61,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 16670,
      "end_ms": 18170,
      "text": "其次就是放逐海南，",
      "token_start": 77,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 18410,
      "end_ms": 20210,
      "text": "你甚至已经安排好了后事。",
      "token_start": 85,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 20350,
      "end_ms": 20930,
      "text": "到了海南，",
      "token_start": 96,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 20930,
      "end_ms": 22470,
      "text": "第一件事就是去做棺材。",
      "token_start": 100,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 22690,
      "end_ms": 23070,
      "text": "此时，",
      "token_start": 110,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 23090,
      "end_ms": 24990,
      "text": "你的爱妾昭云已经去世，",
      "token_start": 112,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 25070,
      "end_ms": 26950,
      "text": "弟弟苏辙也受到你的牵连。",
      "token_start": 122,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 26950,
      "end_ms": 27810,
      "text": "被贬雷州，",
      "token_start": 133,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 28070,
      "end_ms": 29815,
      "text": "你在岛上旧病复发，",
      "token_start": 137,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 30080,
      "end_ms": 31600,
      "text": "当时这里蛇虫出没，",
      "token_start": 145,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 31740,
      "end_ms": 33400,
      "text": "而你又被撵出住处，",
      "token_start": 153,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 33600,
      "end_ms": 34840,
      "text": "只能流落街头。",
      "token_start": 161,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 35080,
      "end_ms": 38740,
      "text": "过着食无肉病、无药居无事的悲惨生活。",
      "token_start": 167,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 39000,
      "end_ms": 41540,
      "text": "你在椰子树下搭了一个窝棚度日啊，",
      "token_start": 183,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 41660,
      "end_ms": 44260,
      "text": "岛上的黎族土著常常来接近你，",
      "token_start": 198,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 44260,
      "end_ms": 47540,
      "text": "你的回报是交给他们种植水稻、开发香料。",
      "token_start": 211,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 47760,
      "end_ms": 49640,
      "text": "你在这里广收弟子学生，",
      "token_start": 228,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 49920,
      "end_ms": 53400,
      "text": "你还教出了海南岛历史上第一位举人和第一位进士，",
      "token_start": 238,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 53600,
      "end_ms": 55740,
      "text": "你成了这座荒岛上的启蒙者。",
      "token_start": 260,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 55980,
      "end_ms": 58000,
      "text": "一个人可以改变一整座岛，",
      "token_start": 272,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 58480,
      "end_ms": 60885,
      "text": "你给一位海南的学生将唐左写诗，",
      "token_start": 283,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 61140,
      "end_ms": 62615,
      "text": "但只写了前两句，",
      "token_start": 297,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 62940,
      "end_ms": 64200,
      "text": "你说要等他考中举人，",
      "token_start": 304,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 64200,
      "end_ms": 65645,
      "text": "就把整首诗给补全。",
      "token_start": 313,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 66090,
      "end_ms": 66815,
      "text": "东坡先生，",
      "token_start": 321,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 67060,
      "end_ms": 67780,
      "text": "你知道吗？",
      "token_start": 325,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 68060,
      "end_ms": 70265,
      "text": "姜唐左后来真的考中了举人，",
      "token_start": 329,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 70530,
      "end_ms": 71315,
      "text": "而可惜的是，",
      "token_start": 341,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 71600,
      "end_ms": 73945,
      "text": "他再也等不到你剩下的几居室了。",
      "token_start": 346,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 74360,
      "end_ms": 75020,
      "text": "就在这一年，",
      "token_start": 360,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 75020,
      "end_ms": 79025,
      "text": "你结束了海南的流放生涯去世于北归的路上。",
      "token_start": 365,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 79550,
      "end_ms": 80330,
      "text": "在去世之前，",
      "token_start": 384,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 80330,
      "end_ms": 81610,
      "text": "你总结自己的一生，",
      "token_start": 389,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 81610,
      "end_ms": 83760,
      "text": "写下了几句诗心，",
      "token_start": 397,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 83760,
      "end_ms": 85460,
      "text": "似已晖之木深。",
      "token_start": 404,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 85460,
      "end_ms": 90590,
      "text": "如不际之舟问如平生工业黄州、惠州、儋州，",
      "token_start": 410,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 90790,
      "end_ms": 92135,
      "text": "儋州就是现在的海南。",
      "token_start": 427,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 92550,
      "end_ms": 93210,
      "text": "回首一生，",
      "token_start": 436,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 93210,
      "end_ms": 96265,
      "text": "你最想夸耀的并不是高居庙堂的辉煌，",
      "token_start": 440,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 96560,
      "end_ms": 98860,
      "text": "而竟然是你受贬谪的流离的时光。",
      "token_start": 456,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 99160,
      "end_ms": 100240,
      "text": "这些流浪的日子，",
      "token_start": 470,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 100240,
      "end_ms": 101695,
      "text": "成了你的黄金岁月，",
      "token_start": 477,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 102070,
      "end_ms": 102690,
      "text": "你这一生，",
      "token_start": 485,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 102970,
      "end_ms": 103990,
      "text": "少年丧母，",
      "token_start": 489,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 103990,
      "end_ms": 104950,
      "text": "青年丧妻，",
      "token_start": 493,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 105030,
      "end_ms": 107665,
      "text": "中年丧子被流放了大半个中国。",
      "token_start": 497,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 107960,
      "end_ms": 108615,
      "text": "你想不通，",
      "token_start": 510,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 108890,
      "end_ms": 110565,
      "text": "为什么总是不断的被流放？",
      "token_start": 514,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 110930,
      "end_ms": 112910,
      "text": "你不是科举电视的第二名吗？",
      "token_start": 525,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 113090,
      "end_ms": 114685,
      "text": "甚至你应该是第一名啊，",
      "token_start": 537,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 114900,
      "end_ms": 116515,
      "text": "你怎么总是被流放呢？",
      "token_start": 547,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 117100,
      "end_ms": 121445,
      "text": "是因为有些人觉得你有才华是他最大的障碍。",
      "token_start": 556,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 121930,
      "end_ms": 124545,
      "text": "你从没有想过你的潇洒会招来别人的恨，",
      "token_start": 575,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 124920,
      "end_ms": 126535,
      "text": "有人见不得你过得好，",
      "token_start": 592,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 127060,
      "end_ms": 127900,
      "text": "被贬黄州时，",
      "token_start": 601,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 127900,
      "end_ms": 130735,
      "text": "你说谁怕一蓑烟雨任平生？",
      "token_start": 606,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 130990,
      "end_ms": 131240,
      "text": "嗯，",
      "token_start": 617,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 131370,
      "end_ms": 132865,
      "text": "但你真的没有怕过吗？",
      "token_start": 618,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 133240,
      "end_ms": 134545,
      "text": "其实你是怕过的吧。",
      "token_start": 627,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 134820,
      "end_ms": 135760,
      "text": "当你被抓时，",
      "token_start": 635,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 135960,
      "end_ms": 137620,
      "text": "甚至两次投河自尽，",
      "token_start": 640,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 137620,
      "end_ms": 138620,
      "text": "被衙役救起，",
      "token_start": 648,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 138700,
      "end_ms": 140880,
      "text": "而后你突然动悟给自己起了个号。",
      "token_start": 653,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 141080,
      "end_ms": 141575,
      "text": "东坡，",
      "token_start": 667,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 142020,
      "end_ms": 144355,
      "text": "你从苏轼正式成为苏东坡。",
      "token_start": 669,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 144830,
      "end_ms": 146510,
      "text": "莫听穿林打叶声，",
      "token_start": 680,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 146590,
      "end_ms": 149660,
      "text": "何妨吟啸且徐行被贬惠州时，",
      "token_start": 687,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 149660,
      "end_ms": 151440,
      "text": "你说日诞荔枝三百颗，",
      "token_start": 699,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 151440,
      "end_ms": 153105,
      "text": "不辞常做岭南人。",
      "token_start": 708,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 153390,
      "end_ms": 155345,
      "text": "结果皇帝读到这句诗很生气啊，",
      "token_start": 715,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 155620,
      "end_ms": 156860,
      "text": "明明是在处罚你，",
      "token_start": 728,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 156860,
      "end_ms": 157520,
      "text": "流放你，",
      "token_start": 735,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 157540,
      "end_ms": 159360,
      "text": "而你却吃荔枝吃那么开心，",
      "token_start": 738,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 159560,
      "end_ms": 161045,
      "text": "就把你载贬到海南来。",
      "token_start": 749,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 161380,
      "end_ms": 162320,
      "text": "结果你到了海南，",
      "token_start": 758,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 162320,
      "end_ms": 165435,
      "text": "却说眼前见天下无一个不是好人，",
      "token_start": 765,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 165780,
      "end_ms": 168725,
      "text": "可是明明朝堂上都是要害你整你的人呢？",
      "token_start": 779,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 169030,
      "end_ms": 169765,
      "text": "东坡先生，",
      "token_start": 796,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 170010,
      "end_ms": 173405,
      "text": "我好想知道你是怎么做到如此的豁达的，",
      "token_start": 800,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 173610,
      "end_ms": 174265,
      "text": "你知道吗？",
      "token_start": 817,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 174720,
      "end_ms": 176075,
      "text": "我总是在调侃自己，",
      "token_start": 821,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 176350,
      "end_ms": 177745,
      "text": "明明懂得很多的道理，",
      "token_start": 829,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 177980,
      "end_ms": 179425,
      "text": "可是依旧过不好这一生。",
      "token_start": 838,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 179920,
      "end_ms": 181240,
      "text": "直到这次来到海南，",
      "token_start": 848,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 181240,
      "end_ms": 183060,
      "text": "想起你我才突然明白，",
      "token_start": 856,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 183380,
      "end_ms": 186420,
      "text": "我其实并不是真的懂得那些道理，",
      "token_start": 865,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 186560,
      "end_ms": 188280,
      "text": "我只是听过见过，",
      "token_start": 879,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 188560,
      "end_ms": 189420,
      "text": "让它经过，",
      "token_start": 886,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 189800,
      "end_ms": 192240,
      "text": "是你让我明白了怎么才能了悟。",
      "token_start": 890,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 192240,
      "end_ms": 193900,
      "text": "人生必须得在困难，",
      "token_start": 903,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 193900,
      "end_ms": 195280,
      "text": "处在至暗处，",
      "token_start": 911,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 195600,
      "end_ms": 197200,
      "text": "在人看不到的地方，",
      "token_start": 916,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 197200,
      "end_ms": 197840,
      "text": "在不顺意，",
      "token_start": 924,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 197840,
      "end_ms": 200480,
      "text": "处在在处处所谓门槛，",
      "token_start": 928,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 200740,
      "end_ms": 202280,
      "text": "跨不过去的就是一道坎，",
      "token_start": 937,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 202340,
      "end_ms": 204140,
      "text": "而跨过去的就是一扇门。",
      "token_start": 947,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 204620,
      "end_ms": 206640,
      "text": "今天我站在一千年之后的海南，",
      "token_start": 957,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 206820,
      "end_ms": 208500,
      "text": "曾经吹拂着你的海风，",
      "token_start": 970,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 208720,
      "end_ms": 210430,
      "text": "如今在吹拂陪着我。",
      "token_start": 979,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 210430,
      "end_ms": 213990,
      "text": "我会突然有一瞬间觉得自己真的走错了好多路啊。",
      "token_start": 987,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 214310,
      "end_ms": 215550,
      "text": "在岁月的长河中，",
      "token_start": 1008,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 215550,
      "end_ms": 217570,
      "text": "最不缺的其中之一就是遗憾。",
      "token_start": 1015,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 217990,
      "end_ms": 218890,
      "text": "像东坡先生，",
      "token_start": 1027,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 218890,
      "end_ms": 221270,
      "text": "你这样的人中龙凤都举步维艰。",
      "token_start": 1032,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 221410,
      "end_ms": 222410,
      "text": "我等榆目，",
      "token_start": 1045,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 222430,
      "end_ms": 223970,
      "text": "又岂会一路顺遂，",
      "token_start": 1049,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 224690,
      "end_ms": 226950,
      "text": "我会永远记得你在海南写的这句诗，",
      "token_start": 1056,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 227370,
      "end_ms": 227910,
      "text": "世事，",
      "token_start": 1071,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 227990,
      "end_ms": 228870,
      "text": "一场大梦，",
      "token_start": 1073,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 229130,
      "end_ms": 231930,
      "text": "人生几度秋凉东坡先生。",
      "token_start": 1077,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 232170,
      "end_ms": 232510,
      "text": "我想，",
      "token_start": 1087,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 232510,
      "end_ms": 233730,
      "text": "几乎每一个中国人，",
      "token_start": 1089,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 233730,
      "end_ms": 236650,
      "text": "都会在人生的某一个时刻与你相遇吧。",
      "token_start": 1097,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 236750,
      "end_ms": 238030,
      "text": "东坡永谢，",
      "token_start": 1113,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 238030,
      "end_ms": 238570,
      "text": "你来过，",
      "token_start": 1117,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 238870,
      "end_ms": 239370,
      "text": "谢谢你，",
      "token_start": 1120,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 239370,
      "end_ms": 240165,
      "text": "让我明白，",
      "token_start": 1123,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 240490,
      "end_ms": 243345,
      "text": "最终能拯救自己的只有我自己。",
      "token_start": 1127,
      "token_end_exclusive": 1140
    }
  ],
