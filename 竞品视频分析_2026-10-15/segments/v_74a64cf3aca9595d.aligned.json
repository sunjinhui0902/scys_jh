  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_74a64cf3aca9595d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_74a64cf3aca9595d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1930,
      "text": "不喝就是看不起我，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2410,
      "end_ms": 2890,
      "text": "领导，",
      "token_start": 8,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3250,
      "end_ms": 4310,
      "text": "我不是看不起您，",
      "token_start": 10,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4630,
      "end_ms": 5695,
      "text": "我是看不起病，",
      "token_start": 17,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 9110,
      "end_ms": 9930,
      "text": "打这么多饭，",
      "token_start": 23,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 10030,
      "end_ms": 10750,
      "text": "你喂猪呢？",
      "token_start": 28,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 11070,
      "end_ms": 11470,
      "text": "领导，",
      "token_start": 32,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 11530,
      "end_ms": 12370,
      "text": "我哪儿敢啊？",
      "token_start": 34,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 12470,
      "end_ms": 14830,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 39,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 14830,
      "end_ms": 16430,
      "text": "都说宰相肚里能撑船，",
      "token_start": 55,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 16750,
      "end_ms": 18230,
      "text": "更何况只是一碗饭呢。",
      "token_start": 64,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 19190,
      "end_ms": 20090,
      "text": "鱼是好鱼，",
      "token_start": 73,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 20590,
      "end_ms": 21710,
      "text": "可惜就是刺多。",
      "token_start": 77,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 21870,
      "end_ms": 22190,
      "text": "领导，",
      "token_start": 83,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 22190,
      "end_ms": 23850,
      "text": "您看鱼虽然刺多，",
      "token_start": 85,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 23850,
      "end_ms": 26490,
      "text": "但主心骨只有一根心腹是没有刺的，",
      "token_start": 92,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 28350,
      "end_ms": 29550,
      "text": "年天让你破费了。",
      "token_start": 107,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 29930,
      "end_ms": 30390,
      "text": "领导，",
      "token_start": 114,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 30570,
      "end_ms": 32010,
      "text": "您说这些您能来，",
      "token_start": 116,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 32010,
      "end_ms": 32830,
      "text": "就是我的荣幸，",
      "token_start": 123,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 33010,
      "end_ms": 34750,
      "text": "以后还有很多地方向您请教。",
      "token_start": 129,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 34750,
      "end_ms": 38470,
      "text": "不是领导，",
      "token_start": 141,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 38490,
      "end_ms": 39280,
      "text": "您是好啊，",
      "token_start": 145,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 39700,
      "end_ms": 41240,
      "text": "年轻就是还不够沉稳，",
      "token_start": 149,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 41660,
      "end_ms": 42740,
      "text": "还要向您多学习，",
      "token_start": 158,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 42980,
      "end_ms": 44180,
      "text": "我们才能变得更优秀。",
      "token_start": 165,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 46960,
      "end_ms": 47420,
      "text": "小王，",
      "token_start": 174,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 47700,
      "end_ms": 49260,
      "text": "你这菜点的也太多了，",
      "token_start": 176,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 49600,
      "end_ms": 51420,
      "text": "领导菜点的再多，",
      "token_start": 185,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 51420,
      "end_ms": 53980,
      "text": "也比不上平时您对我的照顾多这杯酒。",
      "token_start": 192,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 53980,
      "end_ms": 54460,
      "text": "我先敬，",
      "token_start": 208,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 54460,
      "end_ms": 57460,
      "text": "您来就来，",
      "token_start": 211,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 57880,
      "end_ms": 58680,
      "text": "带什么礼物啊，",
      "token_start": 215,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 58680,
      "end_ms": 59440,
      "text": "都不是外人。",
      "token_start": 221,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 59600,
      "end_ms": 60100,
      "text": "哎呀，",
      "token_start": 226,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 60240,
      "end_ms": 60820,
      "text": "您都说了，",
      "token_start": 228,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 60820,
      "end_ms": 61660,
      "text": "不是外人来，",
      "token_start": 232,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 61660,
      "end_ms": 62960,
      "text": "一直都把您当长辈看，",
      "token_start": 237,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 63100,
      "end_ms": 65025,
      "text": "哪有晚辈看长辈空手来的道理啊。",
      "token_start": 246,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 65350,
      "end_ms": 68370,
      "text": "请进小王最近表现不错啊，",
      "token_start": 260,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 68470,
      "end_ms": 70210,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 271,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 70230,
      "end_ms": 71365,
      "text": "我得提前敬你一杯。",
      "token_start": 284,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 71740,
      "end_ms": 72420,
      "text": "听这意思，",
      "token_start": 292,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 72520,
      "end_ms": 73580,
      "text": "领导是要高升了呀，",
      "token_start": 296,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 73580,
      "end_ms": 74945,
      "text": "我得提前敬领导一杯，",
      "token_start": 304,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 76640,
      "end_ms": 77995,
      "text": "我真不怎么喜欢你，",
      "token_start": 313,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 78310,
      "end_ms": 80150,
      "text": "但您从来没有在工作上为难过。",
      "token_start": 321,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 80150,
      "end_ms": 84325,
      "text": "我领导的格局值得我们学习啊。",
      "token_start": 334,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 85670,
      "end_ms": 86305,
      "text": "小王啊，",
      "token_start": 347,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 86940,
      "end_ms": 88815,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 350,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 89820,
      "end_ms": 92395,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 360,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 92850,
      "end_ms": 94930,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 373,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 95010,
      "end_ms": 95590,
      "text": "小王啊，",
      "token_start": 386,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 95850,
      "end_ms": 97590,
      "text": "你一开口就让人喜欢你，",
      "token_start": 389,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 97690,
      "end_ms": 98665,
      "text": "你是怎么做到的？",
      "token_start": 399,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 98840,
      "end_ms": 101335,
      "text": "因为我一直在看这本把话说的恰到好处，",
      "token_start": 406,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 101600,
      "end_ms": 103180,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 423,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 103280,
      "end_ms": 105080,
      "text": "那些会说话、会来事儿的人。",
      "token_start": 434,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 105100,
      "end_ms": 106140,
      "text": "假如你不爱说话，",
      "token_start": 445,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 106180,
      "end_ms": 106860,
      "text": "不爱争辩，",
      "token_start": 452,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 106940,
      "end_ms": 107940,
      "text": "甚至恐惧社交，",
      "token_start": 456,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 108180,
      "end_ms": 110465,
      "text": "推荐你读完这本把话说的恰到好处，",
      "token_start": 462,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 110680,
      "end_ms": 112680,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 477,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 112860,
      "end_ms": 113680,
      "text": "每天看两页，",
      "token_start": 489,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 113760,
      "end_ms": 115035,
      "text": "每一个场景慢慢练，",
      "token_start": 494,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 115210,
      "end_ms": 117905,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 502,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 118270,
      "end_ms": 119070,
      "text": "在这本书里，",
      "token_start": 517,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 119070,
      "end_ms": 119590,
      "text": "有一句话，",
      "token_start": 522,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 119590,
      "end_ms": 120495,
      "text": "我特别欣赏，",
      "token_start": 526,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 120770,
      "end_ms": 120910,
      "text": "他，",
      "token_start": 531,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 120910,
      "end_ms": 123255,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 532,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 123530,
      "end_ms": 124050,
      "text": "你可以回，",
      "token_start": 544,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 124370,
      "end_ms": 125410,
      "text": "那是不优秀点，",
      "token_start": 548,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 125570,
      "end_ms": 127015,
      "text": "怎么能和你做朋友呢？",
      "token_start": 554,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 127410,
      "end_ms": 128770,
      "text": "当有人说你真聪明，",
      "token_start": 563,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 128950,
      "end_ms": 130750,
      "text": "你就回近朱者赤，",
      "token_start": 571,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 131010,
      "end_ms": 131970,
      "text": "和你在一起啊，",
      "token_start": 578,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 132030,
      "end_ms": 134900,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 584,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 134900,
      "end_ms": 136180,
      "text": "你就回领导，",
      "token_start": 599,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 136360,
      "end_ms": 137745,
      "text": "这都是我应该做的。",
      "token_start": 604,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 138080,
      "end_ms": 139580,
      "text": "强将手下吴若冰，",
      "token_start": 612,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 139720,
      "end_ms": 141185,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 619,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 141570,
      "end_ms": 142790,
      "text": "当我看到这段的时候，",
      "token_start": 628,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 142790,
      "end_ms": 144425,
      "text": "真是让我欲解心开呀。",
      "token_start": 637,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 144820,
      "end_ms": 146205,
      "text": "每一句都很有意思，",
      "token_start": 646,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 146620,
      "end_ms": 150180,
      "text": "就是手把手教我们在不同场景之下应该怎么说。",
      "token_start": 654,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 150360,
      "end_ms": 153405,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 674,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 153600,
      "end_ms": 155060,
      "text": "你就放心的拿回去看，",
      "token_start": 692,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 155400,
      "end_ms": 156900,
      "text": "就是一句一句的教你，",
      "token_start": 701,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 157040,
      "end_ms": 159335,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 710,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 159630,
      "end_ms": 160850,
      "text": "但凡学会三分，",
      "token_start": 722,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 161110,
      "end_ms": 163895,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 728,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 164210,
      "end_ms": 166315,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 742,
      "token_end_exclusive": 754
    }
  ],
