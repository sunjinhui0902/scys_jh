{
  "video_id": "v_7e9d12d17d945cb4",
  "duration_s": 420.931995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_7e9d12d17d945cb4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_7e9d12d17d945cb4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 3090,
      "text": "你有没有发现这世上最冤的死法？",
      "token_start": 0,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 3490,
      "end_ms": 4370,
      "text": "不是坏人，",
      "token_start": 14,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4370,
      "end_ms": 6910,
      "text": "害你是你自己太实在。",
      "token_start": 18,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 7970,
      "end_ms": 10550,
      "text": "资治通鉴写了一千三百六十二年，",
      "token_start": 27,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 10870,
      "end_ms": 12950,
      "text": "我翻烂了才看懂一句话，",
      "token_start": 41,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 13450,
      "end_ms": 16590,
      "text": "脑子松一扣的人跟脑子紧一扣的人，",
      "token_start": 51,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 16810,
      "end_ms": 18710,
      "text": "结局差着十万八千里。",
      "token_start": 66,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 18710,
      "end_ms": 20970,
      "text": "今天给您讲两个真人真事，",
      "token_start": 75,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 20970,
      "end_ms": 22730,
      "text": "听完您就明白，",
      "token_start": 86,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 22730,
      "end_ms": 24870,
      "text": "咱这岁数可以善良，",
      "token_start": 92,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 24870,
      "end_ms": 26550,
      "text": "但不能犯犯魂。",
      "token_start": 100,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 27750,
      "end_ms": 32500,
      "text": "头一个他唐朝的刘司礼吉州刺史，",
      "token_start": 106,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 33500,
      "end_ms": 35560,
      "text": "正儿八经的朝廷大员。",
      "token_start": 120,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 36520,
      "end_ms": 37120,
      "text": "有一天，",
      "token_start": 129,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 38180,
      "end_ms": 41000,
      "text": "武则天她亲侄子武一宗来了，",
      "token_start": 132,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 41720,
      "end_ms": 47340,
      "text": "把他单独叫到后堂门一关压低声音说，",
      "token_start": 144,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 48860,
      "end_ms": 51840,
      "text": "刘大人皇上怀疑有人谋反，",
      "token_start": 160,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 52200,
      "end_ms": 53220,
      "text": "你帮我个忙，",
      "token_start": 171,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 53560,
      "end_ms": 55180,
      "text": "假装跟那几个人串通，",
      "token_start": 176,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 55700,
      "end_ms": 56840,
      "text": "再大义灭亲，",
      "token_start": 185,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 56840,
      "end_ms": 60255,
      "text": "把他们告了事成保你当宰相讲。",
      "token_start": 190,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 60720,
      "end_ms": 61645,
      "text": "刘思理一听，",
      "token_start": 203,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 61970,
      "end_ms": 62975,
      "text": "眼睛都亮了，",
      "token_start": 208,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 63560,
      "end_ms": 65665,
      "text": "心里头想还有这好事儿，",
      "token_start": 213,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 66020,
      "end_ms": 68345,
      "text": "动动嘴皮子就能当宰相。",
      "token_start": 223,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 69020,
      "end_ms": 70900,
      "text": "他当天晚上就开始忙活，",
      "token_start": 233,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 71020,
      "end_ms": 72140,
      "text": "今天找这个喝酒，",
      "token_start": 243,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 72260,
      "end_ms": 73495,
      "text": "明天找那个密谈，",
      "token_start": 250,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 73900,
      "end_ms": 75120,
      "text": "回头恭恭敬敬，",
      "token_start": 257,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 75120,
      "end_ms": 76325,
      "text": "把名单递上去，",
      "token_start": 263,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 76660,
      "end_ms": 78475,
      "text": "脸上笑的跟朵花似的，",
      "token_start": 269,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 78780,
      "end_ms": 79560,
      "text": "一口一个。",
      "token_start": 278,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 79680,
      "end_ms": 81165,
      "text": "多谢武大人提醒，",
      "token_start": 282,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 81800,
      "end_ms": 83995,
      "text": "结果呢无意中接过名单，",
      "token_start": 289,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 84310,
      "end_ms": 85025,
      "text": "不急不慢，",
      "token_start": 299,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 85330,
      "end_ms": 88275,
      "text": "拿起笔把刘思理的名字也填上去了。",
      "token_start": 303,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 89240,
      "end_ms": 90115,
      "text": "第二天上朝，",
      "token_start": 318,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 90450,
      "end_ms": 91750,
      "text": "吴一宗往地上一跪，",
      "token_start": 323,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 91990,
      "end_ms": 93105,
      "text": "声泪俱下，",
      "token_start": 331,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 94240,
      "end_ms": 98720,
      "text": "陛下刘斯理谋反证据确凿。",
      "token_start": 335,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 99000,
      "end_ms": 102600,
      "text": "刘思礼站在朝堂上脸刷的就白了，",
      "token_start": 346,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 102600,
      "end_ms": 103200,
      "text": "张着嘴，",
      "token_start": 360,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 103200,
      "end_ms": 103660,
      "text": "想说，",
      "token_start": 363,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 103660,
      "end_ms": 104955,
      "text": "不是您让我干的吗？",
      "token_start": 365,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 105230,
      "end_ms": 106145,
      "text": "话到嘴边，",
      "token_start": 373,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 106480,
      "end_ms": 108085,
      "text": "硬生生咽回去了，",
      "token_start": 377,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 108840,
      "end_ms": 109620,
      "text": "他敢说吗？",
      "token_start": 384,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 109780,
      "end_ms": 110595,
      "text": "说了谁信？",
      "token_start": 388,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 111060,
      "end_ms": 113965,
      "text": "甚至当天下来斩权族灭，",
      "token_start": 392,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 114440,
      "end_ms": 116080,
      "text": "亲戚朋友流放，",
      "token_start": 402,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 116180,
      "end_ms": 117940,
      "text": "一千多人押赴。",
      "token_start": 408,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 117940,
      "end_ms": 118785,
      "text": "刑场那天，",
      "token_start": 414,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 119090,
      "end_ms": 120070,
      "text": "刘斯理一路走，",
      "token_start": 418,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 120070,
      "end_ms": 120925,
      "text": "一路念叨，",
      "token_start": 424,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 121160,
      "end_ms": 122335,
      "text": "跟魔怔了似的，",
      "token_start": 428,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 122540,
      "end_ms": 123385,
      "text": "他说好了的，",
      "token_start": 434,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 124360,
      "end_ms": 125325,
      "text": "他说好了的，",
      "token_start": 439,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 126380,
      "end_ms": 127420,
      "text": "您说他坏吗？",
      "token_start": 444,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 127520,
      "end_ms": 128205,
      "text": "他不坏，",
      "token_start": 449,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 129170,
      "end_ms": 130535,
      "text": "他就是太实在了。",
      "token_start": 452,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 130960,
      "end_ms": 133960,
      "text": "实在到把官场算计当成了拜把子，",
      "token_start": 459,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 133980,
      "end_ms": 137595,
      "text": "把人家一句口头承诺当成了钢刀铁券。",
      "token_start": 473,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 138410,
      "end_ms": 139010,
      "text": "他忘了，",
      "token_start": 489,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 139150,
      "end_ms": 140345,
      "text": "在利益面前，",
      "token_start": 492,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 140690,
      "end_ms": 143555,
      "text": "有些人翻脸比翻书还快。",
      "token_start": 497,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 144320,
      "end_ms": 146165,
      "text": "您别觉得这是古代的事儿。",
      "token_start": 507,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 147200,
      "end_ms": 149510,
      "text": "现在职场上生意场上，",
      "token_start": 518,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 149730,
      "end_ms": 150610,
      "text": "有人跟您说，",
      "token_start": 527,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 150610,
      "end_ms": 151270,
      "text": "帮我个忙，",
      "token_start": 532,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 151410,
      "end_ms": 152270,
      "text": "亏待不了你，",
      "token_start": 536,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 152310,
      "end_ms": 153075,
      "text": "您接不接，",
      "token_start": 541,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 153560,
      "end_ms": 154260,
      "text": "咱接着听。",
      "token_start": 545,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 154260,
      "end_ms": 154785,
      "text": "第二个，",
      "token_start": 549,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 155500,
      "end_ms": 156680,
      "text": "明朝的李擅长，",
      "token_start": 552,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 156860,
      "end_ms": 159905,
      "text": "朱元璋打天下的老兄弟开国宰相，",
      "token_start": 558,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 160430,
      "end_ms": 161315,
      "text": "七十多岁了，",
      "token_start": 572,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 162680,
      "end_ms": 163440,
      "text": "退休在家，",
      "token_start": 577,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 163500,
      "end_ms": 164320,
      "text": "儿孙满堂，",
      "token_start": 581,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 164660,
      "end_ms": 166815,
      "text": "按说这辈子圆满了。",
      "token_start": 585,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 167680,
      "end_ms": 169625,
      "text": "可他有个亲戚叫丁斌，",
      "token_start": 593,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 170030,
      "end_ms": 170725,
      "text": "犯了事儿，",
      "token_start": 602,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 171010,
      "end_ms": 172795,
      "text": "让朱元璋抓进大牢了。",
      "token_start": 606,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 173710,
      "end_ms": 175105,
      "text": "李擅长重感情，",
      "token_start": 615,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 175460,
      "end_ms": 175915,
      "text": "心想，",
      "token_start": 621,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 177130,
      "end_ms": 178750,
      "text": "我跟陛下出生入死，",
      "token_start": 623,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 178750,
      "end_ms": 181080,
      "text": "几十年给亲戚求个情，",
      "token_start": 631,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 181380,
      "end_ms": 182760,
      "text": "这个面子总该给吧。",
      "token_start": 640,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 183520,
      "end_ms": 184920,
      "text": "他就写了一封奏折，",
      "token_start": 648,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 185620,
      "end_ms": 186420,
      "text": "客客气气，",
      "token_start": 656,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 187160,
      "end_ms": 190000,
      "text": "陛下丁兵罪不至死，",
      "token_start": 660,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 190780,
      "end_ms": 191740,
      "text": "求您开恩。",
      "token_start": 668,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 192800,
      "end_ms": 195280,
      "text": "他以为这就是普通的人情往来，",
      "token_start": 672,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 195759,
      "end_ms": 196900,
      "text": "可他万万没想到，",
      "token_start": 685,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 196900,
      "end_ms": 199700,
      "text": "这封信就是要他全家命的催命符。",
      "token_start": 692,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 200580,
      "end_ms": 202860,
      "text": "朱元璋看完冷笑一声，",
      "token_start": 706,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 203360,
      "end_ms": 206160,
      "text": "他心里头早就对李善长不放心了。",
      "token_start": 715,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 207000,
      "end_ms": 209455,
      "text": "开国功臣威望太高，",
      "token_start": 729,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 210270,
      "end_ms": 211930,
      "text": "活着就是一根刺，",
      "token_start": 737,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 212390,
      "end_ms": 213730,
      "text": "正愁没借口呢。",
      "token_start": 744,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 214630,
      "end_ms": 216790,
      "text": "李善长自己把脖子伸过来了，",
      "token_start": 750,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 217610,
      "end_ms": 218270,
      "text": "没多久，",
      "token_start": 762,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 218590,
      "end_ms": 219650,
      "text": "青天剑来报，",
      "token_start": 765,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 220530,
      "end_ms": 221630,
      "text": "天象有变，",
      "token_start": 770,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 221870,
      "end_ms": 223850,
      "text": "诛杀大臣颤。",
      "token_start": 774,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 223850,
      "end_ms": 225330,
      "text": "元璋等的就是这句话，",
      "token_start": 779,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 226390,
      "end_ms": 227510,
      "text": "当场下旨。",
      "token_start": 788,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 227970,
      "end_ms": 231630,
      "text": "李善长全家七十多口全部处死，",
      "token_start": 792,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 232270,
      "end_ms": 233950,
      "text": "圣旨送到李府那天，",
      "token_start": 805,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 234030,
      "end_ms": 236050,
      "text": "李善长正坐在院子里喝茶，",
      "token_start": 813,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 236330,
      "end_ms": 237790,
      "text": "颤巍巍接过圣旨，",
      "token_start": 824,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 238230,
      "end_ms": 239510,
      "text": "手抖的茶碗，",
      "token_start": 831,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 239660,
      "end_ms": 240585,
      "text": "耳都端不住，",
      "token_start": 836,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 241360,
      "end_ms": 243145,
      "text": "旁边儿子嚎啕大哭。",
      "token_start": 841,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 244030,
      "end_ms": 244345,
      "text": "爹，",
      "token_start": 849,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 244910,
      "end_ms": 246245,
      "text": "您求求陛下。",
      "token_start": 850,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 248010,
      "end_ms": 249585,
      "text": "李擅长坐了很久，",
      "token_start": 855,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 250040,
      "end_ms": 251215,
      "text": "最后只说了一句，",
      "token_start": 862,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 251470,
      "end_ms": 252270,
      "text": "陛下要杀，",
      "token_start": 869,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 252450,
      "end_ms": 253245,
      "text": "那就杀吧，",
      "token_start": 873,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 254240,
      "end_ms": 254975,
      "text": "他没跑，",
      "token_start": 877,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 255330,
      "end_ms": 256895,
      "text": "没闹没申辩，",
      "token_start": 880,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 257270,
      "end_ms": 258645,
      "text": "他可能到死都在想，",
      "token_start": 885,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 259070,
      "end_ms": 260695,
      "text": "我跟了陛下三十多年，",
      "token_start": 893,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 261020,
      "end_ms": 261820,
      "text": "没有功劳，",
      "token_start": 902,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 261820,
      "end_ms": 262745,
      "text": "也有苦劳，",
      "token_start": 906,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 263240,
      "end_ms": 264905,
      "text": "陛下不会真杀我吧。",
      "token_start": 910,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 265930,
      "end_ms": 266810,
      "text": "可现实是，",
      "token_start": 918,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 266810,
      "end_ms": 272795,
      "text": "朱元璋从头到尾眼皮都没多眨一下李善长犯的什么病，",
      "token_start": 922,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 273380,
      "end_ms": 274475,
      "text": "迷信权威。",
      "token_start": 945,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 274980,
      "end_ms": 277845,
      "text": "他以为皇帝说的话就是铁律，",
      "token_start": 949,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 278410,
      "end_ms": 280935,
      "text": "自己乖乖听话就能善终。",
      "token_start": 961,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 281490,
      "end_ms": 283775,
      "text": "可他忘了制定规则的人，",
      "token_start": 971,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 284240,
      "end_ms": 285545,
      "text": "随时可以改规则。",
      "token_start": 981,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 286450,
      "end_ms": 287150,
      "text": "听到这儿，",
      "token_start": 988,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 287150,
      "end_ms": 288055,
      "text": "您就明白了，",
      "token_start": 992,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 288880,
      "end_ms": 290215,
      "text": "单纯不失美德，",
      "token_start": 997,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 290860,
      "end_ms": 295945,
      "text": "清醒才是咱这岁数不要求您学算计，",
      "token_start": 1003,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 296770,
      "end_ms": 297925,
      "text": "但得长个心眼。",
      "token_start": 1018,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 299370,
      "end_ms": 303600,
      "text": "我从这两个故事里给您提炼出三句话，",
      "token_start": 1024,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 303660,
      "end_ms": 304455,
      "text": "您记好了。",
      "token_start": 1040,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 306030,
      "end_ms": 306490,
      "text": "第一，",
      "token_start": 1044,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 306740,
      "end_ms": 307600,
      "text": "不管面对谁，",
      "token_start": 1046,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 307820,
      "end_ms": 309925,
      "text": "留个后手再核实一下。",
      "token_start": 1051,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 310740,
      "end_ms": 313095,
      "text": "甭管对方是领导还是老相识，",
      "token_start": 1060,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 313490,
      "end_ms": 316085,
      "text": "甭管拿的是红头文件还是口头承诺，",
      "token_start": 1072,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 316540,
      "end_ms": 318245,
      "text": "您心里的绷一根弦，",
      "token_start": 1087,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 318730,
      "end_ms": 321005,
      "text": "这事儿有没有可能不对？",
      "token_start": 1095,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 321710,
      "end_ms": 324430,
      "text": "成年人的体面不在于我听话，",
      "token_start": 1105,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 324650,
      "end_ms": 328075,
      "text": "而在于我再确认一下不丢人。",
      "token_start": 1117,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 328450,
      "end_ms": 329130,
      "text": "丢人的是，",
      "token_start": 1129,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 329130,
      "end_ms": 331190,
      "text": "被坑了之后哭着说，",
      "token_start": 1133,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 331450,
      "end_ms": 332885,
      "text": "我以为第二，",
      "token_start": 1141,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 333160,
      "end_ms": 335965,
      "text": "别把别人的承诺当成您的护身符。",
      "token_start": 1146,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 336910,
      "end_ms": 338190,
      "text": "刘思礼死到临头，",
      "token_start": 1160,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 338310,
      "end_ms": 339885,
      "text": "还在念叨他说好了的。",
      "token_start": 1167,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 340360,
      "end_ms": 341905,
      "text": "在任何大事面前，",
      "token_start": 1176,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 342430,
      "end_ms": 346535,
      "text": "对方的承诺只等于他撕毁承诺的成本，",
      "token_start": 1183,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 346990,
      "end_ms": 348025,
      "text": "成本够低，",
      "token_start": 1199,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 348690,
      "end_ms": 349785,
      "text": "他一定会死。",
      "token_start": 1203,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 350670,
      "end_ms": 351110,
      "text": "别问他，",
      "token_start": 1208,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 351110,
      "end_ms": 353500,
      "text": "你怎么能这样要问自己，",
      "token_start": 1211,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 353500,
      "end_ms": 354565,
      "text": "我凭什么信他？",
      "token_start": 1221,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 355650,
      "end_ms": 356090,
      "text": "第三，",
      "token_start": 1227,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 356940,
      "end_ms": 358905,
      "text": "遇事先问自己三句话，",
      "token_start": 1229,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 359850,
      "end_ms": 361410,
      "text": "最坏的结果是什么？",
      "token_start": 1238,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 361510,
      "end_ms": 362670,
      "text": "我扛得住吗？",
      "token_start": 1246,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 363150,
      "end_ms": 364590,
      "text": "我现在能做什么？",
      "token_start": 1251,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 365110,
      "end_ms": 365870,
      "text": "想明白了，",
      "token_start": 1258,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 365870,
      "end_ms": 369430,
      "text": "再动比闭着眼睛冲上去强一百倍。",
      "token_start": 1262,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 369910,
      "end_ms": 370570,
      "text": "说到底，",
      "token_start": 1276,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 370670,
      "end_ms": 373330,
      "text": "资治通鉴写了一千三百六十二年，",
      "token_start": 1279,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 373690,
      "end_ms": 375889,
      "text": "翻来覆去就是一笔账，",
      "token_start": 1293,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 376790,
      "end_ms": 378290,
      "text": "脑子勤快的人活，",
      "token_start": 1302,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 378770,
      "end_ms": 380270,
      "text": "脑子犯懒的人死。",
      "token_start": 1309,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 381070,
      "end_ms": 382310,
      "text": "真正的成熟，",
      "token_start": 1316,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 382830,
      "end_ms": 384330,
      "text": "是您看透了人心，",
      "token_start": 1321,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 384410,
      "end_ms": 386970,
      "text": "能有多黑黑暗才伤不到您。",
      "token_start": 1328,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 387310,
      "end_ms": 389335,
      "text": "您算清楚了利益背后的账，",
      "token_start": 1339,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 389990,
      "end_ms": 391050,
      "text": "在利益面前，",
      "token_start": 1350,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 391450,
      "end_ms": 393390,
      "text": "才不会光着身子被人打。",
      "token_start": 1355,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 393890,
      "end_ms": 395010,
      "text": "真正的善良，",
      "token_start": 1365,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 395510,
      "end_ms": 397470,
      "text": "从来不是天真的轻信，",
      "token_start": 1370,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 397850,
      "end_ms": 399430,
      "text": "是您什么都看透了，",
      "token_start": 1379,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 400070,
      "end_ms": 402070,
      "text": "依然愿意选择仁慈。",
      "token_start": 1387,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 402270,
      "end_ms": 406210,
      "text": "这段话建议您点赞、收藏慢慢品。",
      "token_start": 1395,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 406690,
      "end_ms": 410390,
      "text": "要是觉得在里转发给您那个太实在的老朋友，",
      "token_start": 1408,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 410750,
      "end_ms": 411870,
      "text": "或者转给孩子，",
      "token_start": 1427,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 411870,
      "end_ms": 413850,
      "text": "看看咱可以不害人，",
      "token_start": 1433,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 414250,
      "end_ms": 415530,
      "text": "但不能不防人。",
      "token_start": 1441,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 416070,
      "end_ms": 416670,
      "text": "关注我，",
      "token_start": 1447,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 416870,
      "end_ms": 419605,
      "text": "每天给您讲一段历史里的大智慧。",
      "token_start": 1450,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 419800,
      "end_ms": 420010,
      "text": "嗯，",
      "token_start": 1464,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 420050,
      "end_ms": 420795,
      "text": "咱们下回见。",
      "token_start": 1465,
      "token_end_exclusive": 1470
    }
  ],
