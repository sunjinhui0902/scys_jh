{
  "video_id": "v_794a2b8ce8d2ca0b",
  "duration_s": 454.508005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_794a2b8ce8d2ca0b.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_794a2b8ce8d2ca0b.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 2250,
      "text": "要说中国哪里的秋天，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2530,
      "end_ms": 4770,
      "text": "能一边看尽漫山秋色，",
      "token_start": 9,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5090,
      "end_ms": 6810,
      "text": "一边把心安静下来，",
      "token_start": 18,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6990,
      "end_ms": 9130,
      "text": "古刹绝对算得上一个。",
      "token_start": 26,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 9770,
      "end_ms": 13990,
      "text": "可您知道中国秋天最震撼心灵的古刹是哪一座吗？",
      "token_start": 35,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 14370,
      "end_ms": 14890,
      "text": "上集，",
      "token_start": 56,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 14890,
      "end_ms": 23670,
      "text": "咱们聊了寒山寺、悬空寺、灵隐寺、苏州西元寺、悬空寺这一集直接揭开谜底，",
      "token_start": 58,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 23910,
      "end_ms": 26370,
      "text": "看看前五名震撼到什么程度。",
      "token_start": 88,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 26850,
      "end_ms": 31720,
      "text": "尤其是排在榜首的那座一千四百年来，",
      "token_start": 100,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 32300,
      "end_ms": 35740,
      "text": "每到深秋都要落一地黄金。",
      "token_start": 116,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 36120,
      "end_ms": 36760,
      "text": "有人说，",
      "token_start": 127,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 37420,
      "end_ms": 39400,
      "text": "在他面前站上一会儿，",
      "token_start": 130,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 39600,
      "end_ms": 42080,
      "text": "一辈子的疲惫都能放下。",
      "token_start": 139,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 42340,
      "end_ms": 43160,
      "text": "话不多说，",
      "token_start": 149,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 43520,
      "end_ms": 44720,
      "text": "茶给您沏好了，",
      "token_start": 153,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 45160,
      "end_ms": 47360,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 159,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 47680,
      "end_ms": 48720,
      "text": "咱们这就开讲。",
      "token_start": 169,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 49000,
      "end_ms": 49740,
      "text": "第五名，",
      "token_start": 175,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 50160,
      "end_ms": 51000,
      "text": "栖霞寺，",
      "token_start": 178,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 51720,
      "end_ms": 56520,
      "text": "江苏南京栖霞山中风西路南京人说，",
      "token_start": 181,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 57060,
      "end_ms": 61065,
      "text": "春牛首秋栖霞秋天先指的就是仗。",
      "token_start": 196,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 61520,
      "end_ms": 65405,
      "text": "这座寺始建于南齐一千五百多年了，",
      "token_start": 210,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 66130,
      "end_ms": 70075,
      "text": "山壁上的千佛岩近三百个佛龛，",
      "token_start": 225,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 70730,
      "end_ms": 75405,
      "text": "五百多尊佛像也是从那会儿一凿一凿凿出来的。",
      "token_start": 238,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 75860,
      "end_ms": 76885,
      "text": "每年深秋，",
      "token_start": 258,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 77440,
      "end_ms": 79765,
      "text": "漫山枫叶一夜烧红，",
      "token_start": 262,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 80420,
      "end_ms": 82315,
      "text": "红叶底下是古石窟，",
      "token_start": 270,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 82830,
      "end_ms": 85095,
      "text": "红叶后头是皇墙古殿。",
      "token_start": 278,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 85600,
      "end_ms": 86675,
      "text": "您走进去，",
      "token_start": 287,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 87120,
      "end_ms": 90025,
      "text": "像走进一幅浓得化不开的画。",
      "token_start": 291,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 90560,
      "end_ms": 91240,
      "text": "杜牧说，",
      "token_start": 303,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 91640,
      "end_ms": 93635,
      "text": "霜叶红于二月花，",
      "token_start": 306,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 94100,
      "end_ms": 95655,
      "text": "枫叶就这个脾气，",
      "token_start": 313,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 96550,
      "end_ms": 99905,
      "text": "越是挨过霜月红的深，",
      "token_start": 320,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 100700,
      "end_ms": 102575,
      "text": "春天的花娇嫩，",
      "token_start": 329,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 103080,
      "end_ms": 104775,
      "text": "一场雨就谢了，",
      "token_start": 335,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 105320,
      "end_ms": 109185,
      "text": "唯有吃够了风霜的叶子红的罪臣。",
      "token_start": 341,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 109800,
      "end_ms": 110260,
      "text": "您说，",
      "token_start": 355,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 110600,
      "end_ms": 111620,
      "text": "人到晚年，",
      "token_start": 357,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 112100,
      "end_ms": 114335,
      "text": "是不是正该活成这个颜色？",
      "token_start": 361,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 114700,
      "end_ms": 116565,
      "text": "第四名潭柘寺，",
      "token_start": 372,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 117050,
      "end_ms": 121400,
      "text": "北京门头沟宝珠峰南路北京城有句老话，",
      "token_start": 378,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 122060,
      "end_ms": 123320,
      "text": "先有潭柘寺，",
      "token_start": 395,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 123560,
      "end_ms": 124640,
      "text": "后有北京城，",
      "token_start": 400,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 125280,
      "end_ms": 126860,
      "text": "它立在西山脚下。",
      "token_start": 405,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 127100,
      "end_ms": 128340,
      "text": "一千七百多年，",
      "token_start": 412,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 128740,
      "end_ms": 133320,
      "text": "毗卢阁前的两株唐代古银杏高三十多米，",
      "token_start": 418,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 133680,
      "end_ms": 136180,
      "text": "被历代皇帝封为帝王树。",
      "token_start": 435,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 136800,
      "end_ms": 137920,
      "text": "深秋金黄，",
      "token_start": 445,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 138000,
      "end_ms": 139540,
      "text": "树冠铺天盖地。",
      "token_start": 449,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 139980,
      "end_ms": 140980,
      "text": "金风一过，",
      "token_start": 455,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 141380,
      "end_ms": 144260,
      "text": "金色雨幕簌簌落了满院。",
      "token_start": 459,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 144700,
      "end_ms": 147500,
      "text": "您踩在松软的金色落叶上，",
      "token_start": 469,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 147980,
      "end_ms": 149795,
      "text": "听得风声脑，",
      "token_start": 480,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 149990,
      "end_ms": 151110,
      "text": "脑子里过着历史。",
      "token_start": 485,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 151650,
      "end_ms": 155850,
      "text": "多少帝王将相当年在这里烧香许愿，",
      "token_start": 492,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 156550,
      "end_ms": 158650,
      "text": "那些泼天的富贵繁华，",
      "token_start": 507,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 159290,
      "end_ms": 161710,
      "text": "如今全归了这满地尘土，",
      "token_start": 516,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 162070,
      "end_ms": 163570,
      "text": "争了一辈子名利，",
      "token_start": 526,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 163950,
      "end_ms": 166370,
      "text": "到头来一家老小健健康康，",
      "token_start": 533,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 166790,
      "end_ms": 167750,
      "text": "比什么都强。",
      "token_start": 544,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 168170,
      "end_ms": 170570,
      "text": "这座寺峨眉山万年寺，",
      "token_start": 549,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 170930,
      "end_ms": 171770,
      "text": "四川乐山。",
      "token_start": 558,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 172570,
      "end_ms": 176130,
      "text": "这座寺始建于东晋一千六百多年了，",
      "token_start": 562,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 176590,
      "end_ms": 178230,
      "text": "供的是普贤菩萨，",
      "token_start": 577,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 178690,
      "end_ms": 181300,
      "text": "寺里有座明代的无梁砖殿，",
      "token_start": 584,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 181960,
      "end_ms": 182920,
      "text": "不用一根梁，",
      "token_start": 595,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 183280,
      "end_ms": 185620,
      "text": "一层层砖砌出穹顶，",
      "token_start": 600,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 186280,
      "end_ms": 191180,
      "text": "殿里坐着一尊铜柱的普贤齐象像七米多高，",
      "token_start": 608,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 191480,
      "end_ms": 194220,
      "text": "六十多吨重是北宋住的。",
      "token_start": 626,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 194600,
      "end_ms": 195180,
      "text": "深秋，",
      "token_start": 636,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 195760,
      "end_ms": 197760,
      "text": "您沿着山路往上走，",
      "token_start": 638,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 198300,
      "end_ms": 200760,
      "text": "满山彩林云海，",
      "token_start": 646,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 200820,
      "end_ms": 202020,
      "text": "在山间翻涌。",
      "token_start": 652,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 202640,
      "end_ms": 204460,
      "text": "峨眉石井里的白水。",
      "token_start": 657,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 204480,
      "end_ms": 209825,
      "text": "秋风说的就是这普贤菩萨最出名的不是神通，",
      "token_start": 665,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 210590,
      "end_ms": 213110,
      "text": "是行愿答应了的事，",
      "token_start": 684,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 213350,
      "end_ms": 214790,
      "text": "一辈子做下去，",
      "token_start": 692,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 215150,
      "end_ms": 216110,
      "text": "从不叫苦。",
      "token_start": 698,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 216530,
      "end_ms": 217130,
      "text": "这像谁？",
      "token_start": 702,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 217870,
      "end_ms": 220890,
      "text": "像那些默默操劳了一辈子的母亲，",
      "token_start": 705,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 221290,
      "end_ms": 225510,
      "text": "老天爷看得见这份厚重、默默付出的人，",
      "token_start": 719,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 225990,
      "end_ms": 228370,
      "text": "终有老天给的心安福报。",
      "token_start": 735,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 228670,
      "end_ms": 237050,
      "text": "第二名法与寺浙江舟山、普陀山光熙风下普陀山是观音菩萨的道场。",
      "token_start": 745,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 237550,
      "end_ms": 239895,
      "text": "法语寺是山上的第二大寺，",
      "token_start": 773,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 240520,
      "end_ms": 241445,
      "text": "面朝大海。",
      "token_start": 784,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 241910,
      "end_ms": 245015,
      "text": "他始建于明代四百多年了。",
      "token_start": 788,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 245530,
      "end_ms": 248780,
      "text": "市里的九龙殿是清康熙年间，",
      "token_start": 799,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 248800,
      "end_ms": 250865,
      "text": "从南京明故宫差来的。",
      "token_start": 811,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 251410,
      "end_ms": 253945,
      "text": "店内凿井盘着九条龙，",
      "token_start": 820,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 254560,
      "end_ms": 257675,
      "text": "皇宫的气派就这么搬到了海边。",
      "token_start": 829,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 258080,
      "end_ms": 260125,
      "text": "可法语是最动人的，",
      "token_start": 842,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 260420,
      "end_ms": 261215,
      "text": "不是电，",
      "token_start": 850,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 261550,
      "end_ms": 262255,
      "text": "是声音。",
      "token_start": 853,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 262970,
      "end_ms": 266305,
      "text": "晨中暮鼓混着海潮声，",
      "token_start": 856,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 267170,
      "end_ms": 269845,
      "text": "一浪接一浪从没停过。",
      "token_start": 865,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 270260,
      "end_ms": 275595,
      "text": "您站在寺前听潮声涌过来又退下去，",
      "token_start": 874,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 276160,
      "end_ms": 278140,
      "text": "心里攒了一年的委屈，",
      "token_start": 889,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 278500,
      "end_ms": 280095,
      "text": "也跟着退下去了，",
      "token_start": 898,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 280690,
      "end_ms": 283415,
      "text": "女人的心就该向这片海，",
      "token_start": 905,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 283930,
      "end_ms": 288355,
      "text": "什么委屈都装得下装着装着就化成了慈悲。",
      "token_start": 915,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 288820,
      "end_ms": 291445,
      "text": "您说这是不是最了不起的力量？",
      "token_start": 933,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 291860,
      "end_ms": 292315,
      "text": "第一名？",
      "token_start": 946,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 293050,
      "end_ms": 295510,
      "text": "终南山古观音禅寺，",
      "token_start": 949,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 296030,
      "end_ms": 299950,
      "text": "陕西西安长安区终南山北路脚下。",
      "token_start": 957,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 300390,
      "end_ms": 303410,
      "text": "很多人以为第一名不是北京的皇家大厦，",
      "token_start": 971,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 303810,
      "end_ms": 305450,
      "text": "就是四大佛教名山。",
      "token_start": 988,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 306050,
      "end_ms": 307010,
      "text": "绝想不到，",
      "token_start": 996,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 307110,
      "end_ms": 310550,
      "text": "压轴的竟是秦岭终南山脚下，",
      "token_start": 1000,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 310550,
      "end_ms": 313350,
      "text": "一座极朴素的小小禅院，",
      "token_start": 1012,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 313850,
      "end_ms": 321510,
      "text": "整座寺庙全部的魂魄全聚在院里那株一千四百年的古银杏树上，",
      "token_start": 1022,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 321510,
      "end_ms": 329660,
      "text": "像相传是唐太宗李世民亲手栽下的这一千四百年里盛唐的繁华。",
      "token_start": 1049,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 329660,
      "end_ms": 332580,
      "text": "他见过安史之乱的风烟，",
      "token_start": 1076,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 332600,
      "end_ms": 334740,
      "text": "他也见过朝代，",
      "token_start": 1086,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 334800,
      "end_ms": 337260,
      "text": "换了一个又一个皇帝，",
      "token_start": 1092,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 337340,
      "end_ms": 338800,
      "text": "走了一茬又一茬。",
      "token_start": 1101,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 339460,
      "end_ms": 343660,
      "text": "当年栽树的人早就成了史书里的几行字，",
      "token_start": 1108,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 344140,
      "end_ms": 345320,
      "text": "可他还在这站着。",
      "token_start": 1125,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 346040,
      "end_ms": 346940,
      "text": "每到深秋，",
      "token_start": 1132,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 347800,
      "end_ms": 349400,
      "text": "秦岭的山风一吹，",
      "token_start": 1136,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 350240,
      "end_ms": 351560,
      "text": "满树金叶子，",
      "token_start": 1143,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 351700,
      "end_ms": 355350,
      "text": "簌簌的落一层压一层铺成，",
      "token_start": 1148,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 355370,
      "end_ms": 358255,
      "text": "一张厚厚软软的黄金地毯，",
      "token_start": 1159,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 358700,
      "end_ms": 360575,
      "text": "您就站在那树底下，",
      "token_start": 1170,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 361240,
      "end_ms": 362420,
      "text": "什么也不用说，",
      "token_start": 1178,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 362820,
      "end_ms": 364115,
      "text": "什么也不用想，",
      "token_start": 1184,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 364490,
      "end_ms": 366275,
      "text": "一路上受过的委屈，",
      "token_start": 1190,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 366600,
      "end_ms": 368845,
      "text": "熬过的夜咽下去的话，",
      "token_start": 1198,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 369280,
      "end_ms": 372945,
      "text": "在一千四百年的静默与金色的暖光里，",
      "token_start": 1207,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 373210,
      "end_ms": 374895,
      "text": "一下子都被融化了。",
      "token_start": 1223,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 375290,
      "end_ms": 377190,
      "text": "别的寺争的是殿堂，",
      "token_start": 1231,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 377250,
      "end_ms": 377765,
      "text": "恢弘，",
      "token_start": 1239,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 378330,
      "end_ms": 379775,
      "text": "是香火鼎盛，",
      "token_start": 1241,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 380340,
      "end_ms": 382185,
      "text": "而他只守着一棵树，",
      "token_start": 1246,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 382630,
      "end_ms": 385245,
      "text": "就守住了人心最软的地方。",
      "token_start": 1254,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 385680,
      "end_ms": 388390,
      "text": "十座古刹讲完了寒山寺，",
      "token_start": 1265,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 388550,
      "end_ms": 389665,
      "text": "画了诗意，",
      "token_start": 1275,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 390180,
      "end_ms": 391080,
      "text": "红螺寺，",
      "token_start": 1279,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 391200,
      "end_ms": 392145,
      "text": "圆了母爱。",
      "token_start": 1282,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 392660,
      "end_ms": 394475,
      "text": "灵隐寺解了执念，",
      "token_start": 1286,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 394950,
      "end_ms": 396955,
      "text": "西园寺暖的烟火，",
      "token_start": 1293,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 397350,
      "end_ms": 399215,
      "text": "悬空寺立了风骨。",
      "token_start": 1300,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 399610,
      "end_ms": 401735,
      "text": "栖霞山燃透了风霜，",
      "token_start": 1307,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 402200,
      "end_ms": 409125,
      "text": "谈柘寺看淡的富贵万年寺抚慰了付出法语四融下了沧海，",
      "token_start": 1315,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 409900,
      "end_ms": 412685,
      "text": "可只有终南山古观音禅寺，",
      "token_start": 1339,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 413220,
      "end_ms": 415295,
      "text": "借一数千年的金黄，",
      "token_start": 1350,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 415960,
      "end_ms": 418345,
      "text": "融化了人间所有的沧桑。",
      "token_start": 1358,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 418750,
      "end_ms": 420715,
      "text": "您说什么叫震撼心灵？",
      "token_start": 1368,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 421130,
      "end_ms": 424415,
      "text": "最震撼心灵的不是佛像贴了多少金，",
      "token_start": 1377,
      "token_end_exclusive": 1392
    },
    {
      "start_ms": 424930,
      "end_ms": 426785,
      "text": "不是大殿修了多少帐，",
      "token_start": 1392,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 427260,
      "end_ms": 429385,
      "text": "而是在这千百年的秋风里，",
      "token_start": 1401,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 429840,
      "end_ms": 433505,
      "text": "老祖宗给咱们的心灵留了一方避风的港湾。",
      "token_start": 1412,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 433940,
      "end_ms": 435035,
      "text": "最后问问您，",
      "token_start": 1430,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 435600,
      "end_ms": 436640,
      "text": "这十座古刹，",
      "token_start": 1435,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 436640,
      "end_ms": 440225,
      "text": "您去过几座最想去的是哪一座？",
      "token_start": 1440,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 440690,
      "end_ms": 441905,
      "text": "评论区告诉我，",
      "token_start": 1453,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 442540,
      "end_ms": 444525,
      "text": "觉得这期让您长了见识，",
      "token_start": 1459,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 445090,
      "end_ms": 447170,
      "text": "就转给身边跟您一样，",
      "token_start": 1469,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 447170,
      "end_ms": 448795,
      "text": "爱看人文古迹的人，",
      "token_start": 1478,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 449260,
      "end_ms": 451615,
      "text": "想听更多古刹里的千年故事。",
      "token_start": 1486,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 451930,
      "end_ms": 452550,
      "text": "点个关注，",
      "token_start": 1498,
      "token_end_exclusive": 1502
    },
    {
      "start_ms": 452790,
      "end_ms": 454185,
      "text": "咱们下期接着聊。",
      "token_start": 1502,
      "token_end_exclusive": 1509
    }
  ],
