{
  "video_id": "v_325a2849484e6f15",
  "duration_s": 245.571995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_325a2849484e6f15.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_325a2849484e6f15.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 470,
      "text": "小李，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 650,
      "end_ms": 2550,
      "text": "你把我后备箱里的茅台拿上去，",
      "token_start": 2,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 2770,
      "end_ms": 3630,
      "text": "领导的暗示，",
      "token_start": 15,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 3630,
      "end_ms": 4590,
      "text": "你能听得懂吗？",
      "token_start": 20,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5990,
      "end_ms": 6630,
      "text": "没有啊，",
      "token_start": 26,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6630,
      "end_ms": 8010,
      "text": "哎被偷你干什么？",
      "token_start": 29,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8090,
      "end_ms": 8370,
      "text": "赵总，",
      "token_start": 36,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 8370,
      "end_ms": 9090,
      "text": "茅台都被偷了，",
      "token_start": 38,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 9090,
      "end_ms": 10170,
      "text": "你为什么不让我说呀？",
      "token_start": 44,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 10190,
      "end_ms": 10450,
      "text": "不是，",
      "token_start": 53,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 10450,
      "end_ms": 11850,
      "text": "这职场上理会错，",
      "token_start": 55,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 11850,
      "end_ms": 12910,
      "text": "领导的意思是大忌。",
      "token_start": 62,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 13030,
      "end_ms": 13750,
      "text": "车里没有酒，",
      "token_start": 70,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 13750,
      "end_ms": 14710,
      "text": "赵总却让你送上去，",
      "token_start": 75,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 14710,
      "end_ms": 15850,
      "text": "说明他只在意结果，",
      "token_start": 83,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 15850,
      "end_ms": 18290,
      "text": "你又何必去纠结车里酒的去向和真实性呢？",
      "token_start": 91,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 18390,
      "end_ms": 20030,
      "text": "满足领导的需求最重要哦。",
      "token_start": 109,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 22070,
      "end_ms": 22490,
      "text": "赵总，",
      "token_start": 120,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 22730,
      "end_ms": 23690,
      "text": "您车里的东西呢？",
      "token_start": 122,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 23690,
      "end_ms": 24410,
      "text": "我不好乱翻，",
      "token_start": 129,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 24610,
      "end_ms": 25330,
      "text": "就自己准备了。",
      "token_start": 134,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 25330,
      "end_ms": 27130,
      "text": "四瓶两瓶留在您车里了。",
      "token_start": 140,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 27130,
      "end_ms": 29155,
      "text": "这两瓶拿上来您先用，",
      "token_start": 150,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 33390,
      "end_ms": 33770,
      "text": "赵总，",
      "token_start": 159,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 33890,
      "end_ms": 34670,
      "text": "咱们下次见啊。",
      "token_start": 161,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 34670,
      "end_ms": 34770,
      "text": "哎，",
      "token_start": 167,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 34770,
      "end_ms": 35010,
      "text": "好，",
      "token_start": 168,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 35210,
      "end_ms": 35450,
      "text": "哎，",
      "token_start": 169,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 35450,
      "end_ms": 36490,
      "text": "刘总你怎么走了呀，",
      "token_start": 170,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 36610,
      "end_ms": 38115,
      "text": "是不是嫌报价不满意啊？",
      "token_start": 178,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 40410,
      "end_ms": 41670,
      "text": "恭喜赵总拿下合同，",
      "token_start": 188,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 41710,
      "end_ms": 42090,
      "text": "小李，",
      "token_start": 196,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 42510,
      "end_ms": 43530,
      "text": "后续你来负责吧。",
      "token_start": 198,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 44010,
      "end_ms": 44250,
      "text": "哎，",
      "token_start": 205,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 44330,
      "end_ms": 44730,
      "text": "赵总，",
      "token_start": 206,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 44890,
      "end_ms": 47390,
      "text": "这这赵总这怎么回事儿？",
      "token_start": 208,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 47390,
      "end_ms": 49130,
      "text": "这个项目一直是大刘在负责，",
      "token_start": 218,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 49130,
      "end_ms": 50630,
      "text": "赵总突然把项目给我了。",
      "token_start": 230,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 50630,
      "end_ms": 52670,
      "text": "茶汤回湖是谈判的收尾动作，",
      "token_start": 240,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 52670,
      "end_ms": 53850,
      "text": "象征着交易达成。",
      "token_start": 252,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 53850,
      "end_ms": 54870,
      "text": "大刘连这个都不懂，",
      "token_start": 259,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 54870,
      "end_ms": 56550,
      "text": "赵总怎么敢把项目交给他呀？",
      "token_start": 267,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 56550,
      "end_ms": 57570,
      "text": "不能吧，",
      "token_start": 279,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 57570,
      "end_ms": 59250,
      "text": "人情世故是是门大问，",
      "token_start": 282,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 59390,
      "end_ms": 60325,
      "text": "你要学的呀，",
      "token_start": 291,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 60500,
      "end_ms": 61125,
      "text": "还多着呢。",
      "token_start": 296,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 61360,
      "end_ms": 62420,
      "text": "老婆赵，",
      "token_start": 300,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 62420,
      "end_ms": 63620,
      "text": "总把上次的酒钱转过来了，",
      "token_start": 303,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 63620,
      "end_ms": 65150,
      "text": "你看哎，",
      "token_start": 314,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 65150,
      "end_ms": 66090,
      "text": "你怎么收了呀？",
      "token_start": 317,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 66090,
      "end_ms": 66690,
      "text": "赵总转多了，",
      "token_start": 323,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 66690,
      "end_ms": 67510,
      "text": "你赶紧给他退回去。",
      "token_start": 328,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 67510,
      "end_ms": 68930,
      "text": "你自以为有原则的退还，",
      "token_start": 336,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 68950,
      "end_ms": 70110,
      "text": "只会让领导觉得麻烦，",
      "token_start": 346,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 70170,
      "end_ms": 71575,
      "text": "还不如大大方方收下呢。",
      "token_start": 355,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 72120,
      "end_ms": 73715,
      "text": "那我是不是得说点啥呀，",
      "token_start": 365,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 74060,
      "end_ms": 75945,
      "text": "你就说感谢领导大气，",
      "token_start": 375,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 76290,
      "end_ms": 77750,
      "text": "果然跟着领导有甜头，",
      "token_start": 384,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 77750,
      "end_ms": 79220,
      "text": "吃就这样就行了。",
      "token_start": 393,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 79340,
      "end_ms": 80205,
      "text": "当然不行啊，",
      "token_start": 400,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 81070,
      "end_ms": 81555,
      "text": "好吃的。",
      "token_start": 405,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 81770,
      "end_ms": 82150,
      "text": "赵总，",
      "token_start": 408,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 82150,
      "end_ms": 83410,
      "text": "请大家喝奶茶了啊，",
      "token_start": 410,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 83490,
      "end_ms": 84345,
      "text": "人人都有。",
      "token_start": 418,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 86770,
      "end_ms": 88570,
      "text": "我什么时候请大家喝奶茶了？",
      "token_start": 422,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 88650,
      "end_ms": 89290,
      "text": "奶茶钱，",
      "token_start": 434,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 89590,
      "end_ms": 91615,
      "text": "您不是跟着酒钱一块转给我了吗？",
      "token_start": 437,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 92290,
      "end_ms": 92725,
      "text": "哈哈哈，",
      "token_start": 451,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 92910,
      "end_ms": 93135,
      "text": "拜拜。",
      "token_start": 454,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 94010,
      "end_ms": 96740,
      "text": "小李周天来家里坐坐，",
      "token_start": 456,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 97060,
      "end_ms": 98585,
      "text": "尝尝你嫂子的手艺。",
      "token_start": 465,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 102370,
      "end_ms": 102830,
      "text": "嫂子，",
      "token_start": 473,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 102830,
      "end_ms": 103710,
      "text": "你可算出来了，",
      "token_start": 475,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 103710,
      "end_ms": 104805,
      "text": "我都快憋死了。",
      "token_start": 481,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 105920,
      "end_ms": 106165,
      "text": "哎，",
      "token_start": 487,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 106740,
      "end_ms": 107880,
      "text": "你拉我干什么？",
      "token_start": 488,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 107900,
      "end_ms": 109000,
      "text": "我也很急啊，",
      "token_start": 494,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 109040,
      "end_ms": 109935,
      "text": "憋死吧，",
      "token_start": 499,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 110500,
      "end_ms": 113720,
      "text": "不知道的还以为洗手间是什么好地方。",
      "token_start": 502,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 113860,
      "end_ms": 114300,
      "text": "哎呀，",
      "token_start": 518,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 114340,
      "end_ms": 114865,
      "text": "行了，",
      "token_start": 520,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 115360,
      "end_ms": 116365,
      "text": "你们坐我去做饭，",
      "token_start": 522,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 116780,
      "end_ms": 118055,
      "text": "老赵帮我处理一下鱼。",
      "token_start": 529,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 118800,
      "end_ms": 119255,
      "text": "老婆，",
      "token_start": 538,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 119620,
      "end_ms": 120200,
      "text": "我怎么看？",
      "token_start": 540,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 120580,
      "end_ms": 122095,
      "text": "赵总和嫂子有点不高兴，",
      "token_start": 544,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 122590,
      "end_ms": 124525,
      "text": "因为异性厕所十分钟效应，",
      "token_start": 554,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 124760,
      "end_ms": 125000,
      "text": "人家。",
      "token_start": 565,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 125000,
      "end_ms": 125300,
      "text": "赵总，",
      "token_start": 567,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 125300,
      "end_ms": 126640,
      "text": "老婆刚从卫生间出来，",
      "token_start": 569,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 126700,
      "end_ms": 127460,
      "text": "你就是再着急，",
      "token_start": 578,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 127460,
      "end_ms": 130135,
      "text": "你等十分钟再怎么可能是因为这个呀，",
      "token_start": 584,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 130770,
      "end_ms": 131895,
      "text": "你照做就行，",
      "token_start": 600,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 134070,
      "end_ms": 134550,
      "text": "嫂子，",
      "token_start": 605,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 134650,
      "end_ms": 135350,
      "text": "我来帮你。",
      "token_start": 607,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 135790,
      "end_ms": 136190,
      "text": "赵总，",
      "token_start": 611,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 136230,
      "end_ms": 136675,
      "text": "嫂子，",
      "token_start": 613,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 136910,
      "end_ms": 137605,
      "text": "那我走了，",
      "token_start": 615,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 137930,
      "end_ms": 142660,
      "text": "那我们也先走小李，",
      "token_start": 619,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 142660,
      "end_ms": 144525,
      "text": "留下接待王总的事情，",
      "token_start": 627,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 144740,
      "end_ms": 145540,
      "text": "咱们再碰一下，",
      "token_start": 636,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 145620,
      "end_ms": 147115,
      "text": "那得叫小张回来呀，",
      "token_start": 642,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 150090,
      "end_ms": 152005,
      "text": "不用你负责就行。",
      "token_start": 650,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 152970,
      "end_ms": 153370,
      "text": "好的，",
      "token_start": 657,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 153370,
      "end_ms": 153730,
      "text": "赵总，",
      "token_start": 659,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 153910,
      "end_ms": 154150,
      "text": "哎，",
      "token_start": 661,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 154270,
      "end_ms": 154705,
      "text": "老婆，",
      "token_start": 662,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 155030,
      "end_ms": 157405,
      "text": "你这个厕所十分钟效应还真有说法，",
      "token_start": 664,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 157630,
      "end_ms": 159315,
      "text": "这都是不成文的社交规矩。",
      "token_start": 679,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 159690,
      "end_ms": 161730,
      "text": "你呀多看看这本闲谈高手，",
      "token_start": 690,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 161970,
      "end_ms": 163090,
      "text": "假如你不爱说话，",
      "token_start": 701,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 163130,
      "end_ms": 163870,
      "text": "不爱争辩，",
      "token_start": 708,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 163950,
      "end_ms": 164810,
      "text": "也不爱出门，",
      "token_start": 712,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 165150,
      "end_ms": 166425,
      "text": "甚至恐惧社交，",
      "token_start": 717,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 166730,
      "end_ms": 167890,
      "text": "你就每天看两页，",
      "token_start": 723,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 168110,
      "end_ms": 169435,
      "text": "每一个场景慢慢练，",
      "token_start": 730,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 169750,
      "end_ms": 173490,
      "text": "你也会变成一个会说话的人我当时听到这句话的时候，",
      "token_start": 738,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 173650,
      "end_ms": 174930,
      "text": "我的眼泪就出来了，",
      "token_start": 761,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 174930,
      "end_ms": 177310,
      "text": "他写的是别人夸你优秀你就回，",
      "token_start": 769,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 177590,
      "end_ms": 178690,
      "text": "那是不优秀点，",
      "token_start": 782,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 178850,
      "end_ms": 180190,
      "text": "怎么能和你做朋友？",
      "token_start": 788,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 180270,
      "end_ms": 181310,
      "text": "你看很有味道，",
      "token_start": 796,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 181350,
      "end_ms": 182390,
      "text": "假如不爱说话，",
      "token_start": 802,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 182530,
      "end_ms": 183290,
      "text": "不爱争辩，",
      "token_start": 808,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 183430,
      "end_ms": 184310,
      "text": "也不爱出门，",
      "token_start": 812,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 184550,
      "end_ms": 185690,
      "text": "甚至恐惧社交，",
      "token_start": 817,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 185870,
      "end_ms": 187110,
      "text": "你每天就看两页，",
      "token_start": 823,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 187270,
      "end_ms": 188610,
      "text": "每一个场景慢慢练，",
      "token_start": 830,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 188670,
      "end_ms": 191190,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 838,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 191490,
      "end_ms": 191730,
      "text": "哇，",
      "token_start": 853,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 191910,
      "end_ms": 192985,
      "text": "这真是太棒了。",
      "token_start": 854,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 193180,
      "end_ms": 194000,
      "text": "在这本书里边，",
      "token_start": 860,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 194000,
      "end_ms": 195360,
      "text": "有一句话我特别欣赏。",
      "token_start": 866,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 195620,
      "end_ms": 197280,
      "text": "他说有人嘲讽你眼睛小，",
      "token_start": 875,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 197540,
      "end_ms": 198580,
      "text": "高情商回答，",
      "token_start": 885,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 198760,
      "end_ms": 199900,
      "text": "万物皆有裂痕，",
      "token_start": 890,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 200120,
      "end_ms": 201560,
      "text": "那是光照进来的地方。",
      "token_start": 896,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 201780,
      "end_ms": 202020,
      "text": "哇，",
      "token_start": 905,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 202100,
      "end_ms": 203115,
      "text": "这真是太棒了，",
      "token_start": 906,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 203360,
      "end_ms": 204560,
      "text": "每一句都很有意思，",
      "token_start": 912,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 204740,
      "end_ms": 205740,
      "text": "随便翻对吧？",
      "token_start": 920,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 205860,
      "end_ms": 206100,
      "text": "哇，",
      "token_start": 925,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 206200,
      "end_ms": 207245,
      "text": "这句话太好了，",
      "token_start": 926,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 207590,
      "end_ms": 209750,
      "text": "他写的是别人问你一个月工资多少，",
      "token_start": 932,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 209950,
      "end_ms": 211405,
      "text": "你就会比以前好多了。",
      "token_start": 947,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 211710,
      "end_ms": 213650,
      "text": "现在吃泡面敢放两根长了。",
      "token_start": 956,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 213830,
      "end_ms": 215070,
      "text": "我读到这段的时候，",
      "token_start": 967,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 215170,
      "end_ms": 217330,
      "text": "我觉得这个让我真是欲解心开啊，",
      "token_start": 975,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 217430,
      "end_ms": 219315,
      "text": "这本书就像是个社交宝典，",
      "token_start": 989,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 219630,
      "end_ms": 221910,
      "text": "把各种社交场景都变成了问题，",
      "token_start": 1000,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 221910,
      "end_ms": 222995,
      "text": "加答案的形式。",
      "token_start": 1013,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 223310,
      "end_ms": 225925,
      "text": "你说哪家的书架上不应该有一本这个书，",
      "token_start": 1019,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 226300,
      "end_ms": 229700,
      "text": "就是手把手的教我们不同的场景之下应该怎么说？",
      "token_start": 1036,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 229960,
      "end_ms": 232825,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1057,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 233120,
      "end_ms": 234400,
      "text": "你就放心拿回去看，",
      "token_start": 1075,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 234620,
      "end_ms": 236095,
      "text": "就是一句一句的教你，",
      "token_start": 1083,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 236450,
      "end_ms": 239165,
      "text": "这是我这几年来讲过的最简单的一本书。",
      "token_start": 1092,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 239560,
      "end_ms": 241180,
      "text": "我觉得这书适合所有人，",
      "token_start": 1109,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 241480,
      "end_ms": 244195,
      "text": "让你不管在任何场合都能够轻松拿捏。",
      "token_start": 1119,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 244540,
      "end_ms": 245475,
      "text": "所以强烈推荐。",
      "token_start": 1135,
      "token_end_exclusive": 1141
    }
