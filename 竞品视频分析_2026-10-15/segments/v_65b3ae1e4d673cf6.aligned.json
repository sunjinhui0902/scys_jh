{
  "video_id": "v_65b3ae1e4d673cf6",
  "duration_s": 167.113991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_65b3ae1e4d673cf6.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_65b3ae1e4d673cf6.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 2910,
      "text": "你知道为什么有些人特别害怕别人笑话吗？",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 3150,
      "end_ms": 4550,
      "text": "因为他们最喜欢笑话，",
      "token_start": 18,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 4550,
      "end_ms": 5910,
      "text": "别人朱君，",
      "token_start": 27,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 6110,
      "end_ms": 7110,
      "text": "请你一定要记住。",
      "token_start": 31,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 7310,
      "end_ms": 9190,
      "text": "如果一个侮辱能够让你崩溃，",
      "token_start": 38,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 9330,
      "end_ms": 10990,
      "text": "一个掌声能让你膨胀，",
      "token_start": 50,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 11270,
      "end_ms": 13210,
      "text": "你的心智就不属于你自己。",
      "token_start": 59,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 13410,
      "end_ms": 15850,
      "text": "你是任何开口之人的一名奴隶。",
      "token_start": 70,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 16050,
      "end_ms": 17650,
      "text": "为什么说在这个焦虑的时代，",
      "token_start": 83,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 17650,
      "end_ms": 19910,
      "text": "四多个主义哲学值得每一个人学习？",
      "token_start": 95,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 20310,
      "end_ms": 21770,
      "text": "别人一句无心的评价，",
      "token_start": 110,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 21790,
      "end_ms": 22730,
      "text": "就能让你低落。",
      "token_start": 119,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 22730,
      "end_ms": 24930,
      "text": "一整晚一条没有回复的消息，",
      "token_start": 125,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 24930,
      "end_ms": 26250,
      "text": "就能让你脑补一整夜，",
      "token_start": 137,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 26630,
      "end_ms": 27030,
      "text": "一点，",
      "token_start": 146,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 27030,
      "end_ms": 28890,
      "text": "不确定就能让你反复内行。",
      "token_start": 148,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 29130,
      "end_ms": 30820,
      "text": "其实压垮你的的不是生活，",
      "token_start": 159,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 31040,
      "end_ms": 32140,
      "text": "是你的控制欲，",
      "token_start": 170,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 32480,
      "end_ms": 33520,
      "text": "你想控制别人，",
      "token_start": 176,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 33520,
      "end_ms": 35440,
      "text": "怎么看你控制事情的结果，",
      "token_start": 182,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 35560,
      "end_ms": 36740,
      "text": "控制关系的走向，",
      "token_start": 193,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 36920,
      "end_ms": 38199,
      "text": "甚至控制未来，",
      "token_start": 200,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 38199,
      "end_ms": 39560,
      "text": "按照你预期去发生。",
      "token_start": 206,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 39960,
      "end_ms": 40880,
      "text": "斯洛克主义说，",
      "token_start": 214,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 41080,
      "end_ms": 43000,
      "text": "世界只分两件事儿，",
      "token_start": 220,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 43000,
      "end_ms": 43560,
      "text": "一件事，",
      "token_start": 228,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 43560,
      "end_ms": 45160,
      "text": "你能控制的一件事，",
      "token_start": 231,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 45240,
      "end_ms": 46060,
      "text": "你怎么折腾，",
      "token_start": 239,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 46060,
      "end_ms": 47080,
      "text": "你都控制不了的。",
      "token_start": 244,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 47380,
      "end_ms": 49820,
      "text": "而大多数人一辈子都在干一件蠢事，",
      "token_start": 251,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 50160,
      "end_ms": 51460,
      "text": "放弃掌控自己，",
      "token_start": 266,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 51520,
      "end_ms": 52900,
      "text": "却拼命去掌控别人。",
      "token_start": 272,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 53220,
      "end_ms": 56920,
      "text": "你所有的焦虑本质都是在试图掌控一个不属于你的世界。",
      "token_start": 280,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 56920,
      "end_ms": 60590,
      "text": "庄子早在两千多年前就已经告告诉我们，",
      "token_start": 304,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 60690,
      "end_ms": 64755,
      "text": "心别受力、掌声和嘘声本质上都是噪声。",
      "token_start": 321,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 65110,
      "end_ms": 66165,
      "text": "比如我是做自媒体，",
      "token_start": 337,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 66410,
      "end_ms": 68755,
      "text": "就会面对很多人对我的种种评价。",
      "token_start": 345,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 69040,
      "end_ms": 69960,
      "text": "而孟子有一句话，",
      "token_start": 359,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 69960,
      "end_ms": 71560,
      "text": "说有不渝之欲，",
      "token_start": 366,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 71640,
      "end_ms": 72795,
      "text": "有求全之慧，",
      "token_start": 372,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 73150,
      "end_ms": 74205,
      "text": "什么叫不逾之欲？",
      "token_start": 377,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 74430,
      "end_ms": 76535,
      "text": "就是意料之外的过分的赞美。",
      "token_start": 384,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 76780,
      "end_ms": 78100,
      "text": "别人说你真厉害啊，",
      "token_start": 396,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 78100,
      "end_ms": 79140,
      "text": "实际上你心里清楚，",
      "token_start": 404,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 79140,
      "end_ms": 80020,
      "text": "并没有这么厉害。",
      "token_start": 412,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 80120,
      "end_ms": 82065,
      "text": "既然你接受了这么多不愉之语，",
      "token_start": 419,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 82320,
      "end_ms": 84495,
      "text": "那你也应该接受那些求全智慧。",
      "token_start": 432,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 84840,
      "end_ms": 86240,
      "text": "你在别人口中的好坏，",
      "token_start": 445,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 86260,
      "end_ms": 88085,
      "text": "其实和你本身没有太大关系。",
      "token_start": 454,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 88360,
      "end_ms": 90520,
      "text": "朱军人在过得很好的时候，",
      "token_start": 466,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 90520,
      "end_ms": 91855,
      "text": "就会原谅很多事情，",
      "token_start": 477,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 92140,
      "end_ms": 93915,
      "text": "因为自己的内心有了力量，",
      "token_start": 485,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 94150,
      "end_ms": 95765,
      "text": "就懒得跟外界较劲儿。",
      "token_start": 496,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 95980,
      "end_ms": 96220,
      "text": "你看，",
      "token_start": 505,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 96220,
      "end_ms": 99075,
      "text": "山顶的风永远不与谷底的尘埃作战，",
      "token_start": 507,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 99450,
      "end_ms": 102515,
      "text": "所以精神海拔决定了包容的半径。",
      "token_start": 522,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 103060,
      "end_ms": 104980,
      "text": "人强大到能自我满足时，",
      "token_start": 536,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 105020,
      "end_ms": 107305,
      "text": "别人的冒犯就变成了蚊虫叮咬。",
      "token_start": 546,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 107810,
      "end_ms": 109630,
      "text": "你来我欢迎你走，",
      "token_start": 559,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 109710,
      "end_ms": 112155,
      "text": "我不送别人说的话可以听见，",
      "token_start": 566,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 112420,
      "end_ms": 113720,
      "text": "却不必句句收藏。",
      "token_start": 578,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 114020,
      "end_ms": 116015,
      "text": "生活带来的情绪可以感受，",
      "token_start": 585,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 116260,
      "end_ms": 118125,
      "text": "却不必让他们长期居住。",
      "token_start": 596,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 118600,
      "end_ms": 119600,
      "text": "心不受力，",
      "token_start": 606,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 119700,
      "end_ms": 120480,
      "text": "不是冷漠，",
      "token_start": 610,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 120500,
      "end_ms": 121260,
      "text": "不是麻木，",
      "token_start": 614,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 121320,
      "end_ms": 123075,
      "text": "也不是假装什么都不在乎，",
      "token_start": 618,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 123290,
      "end_ms": 124910,
      "text": "而是你可以接受建议，",
      "token_start": 629,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 125030,
      "end_ms": 126175,
      "text": "却不接受审判，",
      "token_start": 638,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 126520,
      "end_ms": 127620,
      "text": "可以经历失去，",
      "token_start": 644,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 127740,
      "end_ms": 128805,
      "text": "却不否定自己，",
      "token_start": 650,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 129120,
      "end_ms": 130860,
      "text": "可以在秋天多愁善感，",
      "token_start": 656,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 130940,
      "end_ms": 133495,
      "text": "却不让一阵风替你决定整个人生。",
      "token_start": 665,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 134200,
      "end_ms": 135140,
      "text": "每每到了秋天，",
      "token_start": 679,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 135220,
      "end_ms": 137735,
      "text": "树木会把养分从叶片收回根部，",
      "token_start": 685,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 138060,
      "end_ms": 141155,
      "text": "人也要把散落在外界的注意力收回来。",
      "token_start": 698,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 141370,
      "end_ms": 143015,
      "text": "从别人的评价里收回来，",
      "token_start": 714,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 143370,
      "end_ms": 145125,
      "text": "该落的意让他落，",
      "token_start": 724,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 145500,
      "end_ms": 147025,
      "text": "该走的人让他走，",
      "token_start": 731,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 147340,
      "end_ms": 150110,
      "text": "该来的风让他来树不追，",
      "token_start": 738,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 150110,
      "end_ms": 151565,
      "text": "夜山不留云。",
      "token_start": 748,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 151860,
      "end_ms": 152660,
      "text": "真正有根的人，",
      "token_start": 753,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 152660,
      "end_ms": 154835,
      "text": "也不必向每一阵风去解释自己。",
      "token_start": 759,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 155170,
      "end_ms": 155830,
      "text": "这个秋天，",
      "token_start": 772,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 156050,
      "end_ms": 157195,
      "text": "让风负责吹，",
      "token_start": 776,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 157500,
      "end_ms": 158900,
      "text": "让夜负责落，",
      "token_start": 781,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 159160,
      "end_ms": 160845,
      "text": "而你只负责站稳，",
      "token_start": 786,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 161150,
      "end_ms": 162905,
      "text": "总有人会喜欢那个真实的你，",
      "token_start": 793,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 163250,
      "end_ms": 164005,
      "text": "一定要相信我。",
      "token_start": 805,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 164340,
      "end_ms": 165615,
      "text": "如果没有请告诉我，",
      "token_start": 811,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 165990,
      "end_ms": 166735,
      "text": "我喜欢你。",
      "token_start": 819,
      "token_end_exclusive": 823
    }
  ],
