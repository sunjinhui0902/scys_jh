{
  "video_id": "v_21fb6a2ddb3553d0",
  "duration_s": 434.399002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_21fb6a2ddb3553d0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_21fb6a2ddb3553d0.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 710,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 990,
      "end_ms": 1810,
      "text": "咱们盘了。",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1810,
      "end_ms": 3410,
      "text": "第十到第六，",
      "token_start": 6,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 4050,
      "end_ms": 6470,
      "text": "福建是福州加建州，",
      "token_start": 11,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 7030,
      "end_ms": 8810,
      "text": "云南是云岭之南，",
      "token_start": 19,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 9490,
      "end_ms": 11750,
      "text": "浙江因钱塘江得名，",
      "token_start": 26,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 12190,
      "end_ms": 14210,
      "text": "江苏是江宁加苏州，",
      "token_start": 34,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 14730,
      "end_ms": 17130,
      "text": "四川因四条大川得名。",
      "token_start": 42,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 17610,
      "end_ms": 19830,
      "text": "好多朋友看完在评论区炒翻了。",
      "token_start": 51,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 20050,
      "end_ms": 21690,
      "text": "有人说山东呢？",
      "token_start": 64,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 21730,
      "end_ms": 23730,
      "text": "有人说安徽呢别急，",
      "token_start": 70,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 24630,
      "end_ms": 27030,
      "text": "今天这集就是第五道第一，",
      "token_start": 78,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 27330,
      "end_ms": 28590,
      "text": "一个比一个震撼。",
      "token_start": 89,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 28750,
      "end_ms": 32920,
      "text": "最后那个两两个字里装着一个民族的精神故乡。",
      "token_start": 96,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 33600,
      "end_ms": 34300,
      "text": "老规矩，",
      "token_start": 116,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 34480,
      "end_ms": 35380,
      "text": "开讲之前，",
      "token_start": 119,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 35760,
      "end_ms": 37760,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 123,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 37920,
      "end_ms": 39200,
      "text": "让我看看都是谁。",
      "token_start": 133,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 39200,
      "end_ms": 40880,
      "text": "在听第五名。",
      "token_start": 140,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 41220,
      "end_ms": 47460,
      "text": "安徽、安徽这个名字是安庆和徽州各取一个字拼出来的。",
      "token_start": 145,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 48180,
      "end_ms": 48720,
      "text": "安庆，",
      "token_start": 168,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 49080,
      "end_ms": 50880,
      "text": "南宋时期叫安庆君，",
      "token_start": 170,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 51600,
      "end_ms": 53200,
      "text": "意思是平安吉庆。",
      "token_start": 178,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 53640,
      "end_ms": 56500,
      "text": "徽州徽字本身就是美好的意思，",
      "token_start": 185,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 57160,
      "end_ms": 60570,
      "text": "一个安一个徽安是平安婚，",
      "token_start": 198,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 60570,
      "end_ms": 61210,
      "text": "视美好，",
      "token_start": 209,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 61390,
      "end_ms": 63625,
      "text": "合在一起平安美好，",
      "token_start": 212,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 63970,
      "end_ms": 64875,
      "text": "可您知道吗？",
      "token_start": 220,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 65160,
      "end_ms": 66845,
      "text": "安徽简称皖，",
      "token_start": 225,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 67540,
      "end_ms": 69890,
      "text": "这个字更有来头晚。",
      "token_start": 230,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 69970,
      "end_ms": 71310,
      "text": "在古书里的意思是，",
      "token_start": 238,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 71310,
      "end_ms": 72215,
      "text": "黎明时分，",
      "token_start": 246,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 72670,
      "end_ms": 75570,
      "text": "古代有一个以澄光为图腾的部落，",
      "token_start": 250,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 75570,
      "end_ms": 76595,
      "text": "就叫挽国，",
      "token_start": 264,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 77090,
      "end_ms": 78235,
      "text": "一个省的名字，",
      "token_start": 268,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 78550,
      "end_ms": 80705,
      "text": "把两个最美好的地名合并，",
      "token_start": 274,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 81210,
      "end_ms": 86085,
      "text": "又用一个象征着黎明的字做简称安灰。",
      "token_start": 285,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 86450,
      "end_ms": 92125,
      "text": " Why平安美好晨光三个字三种住院第四名，",
      "token_start": 301,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 92550,
      "end_ms": 95545,
      "text": "山西山西这两个字，",
      "token_start": 318,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 95960,
      "end_ms": 98645,
      "text": "表面上看是太行山之西，",
      "token_start": 326,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 99340,
      "end_ms": 100435,
      "text": "简单直接，",
      "token_start": 336,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 101020,
      "end_ms": 102495,
      "text": "可您要是往深了想，",
      "token_start": 340,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 102860,
      "end_ms": 104120,
      "text": "山西简称晋，",
      "token_start": 348,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 104400,
      "end_ms": 105905,
      "text": "这个字的分量太重了。",
      "token_start": 353,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 106370,
      "end_ms": 108350,
      "text": "晋是春秋五霸之一，",
      "token_start": 362,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 108350,
      "end_ms": 111455,
      "text": "晋国的晋是三家分晋的晋，",
      "token_start": 370,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 111880,
      "end_ms": 114430,
      "text": "是三晋大地的晋山西。",
      "token_start": 381,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 114430,
      "end_ms": 119185,
      "text": "这片土地上发生了多少改变中国历史的大事。",
      "token_start": 390,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 119890,
      "end_ms": 122330,
      "text": "晋文公称霸赵魏韩，",
      "token_start": 409,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 122530,
      "end_ms": 123530,
      "text": "三家分晋，",
      "token_start": 417,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 124170,
      "end_ms": 125870,
      "text": "李渊从晋阳起兵，",
      "token_start": 421,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 126150,
      "end_ms": 127950,
      "text": "建立唐朝一个晋字，",
      "token_start": 428,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 128270,
      "end_ms": 131350,
      "text": "把两千多年的风云全装进去了。",
      "token_start": 436,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 131350,
      "end_ms": 133390,
      "text": "山西太行山之西，",
      "token_start": 449,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 133730,
      "end_ms": 136210,
      "text": "简称晋三晋大地。",
      "token_start": 456,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 136990,
      "end_ms": 138010,
      "text": "表里山河。",
      "token_start": 463,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 138990,
      "end_ms": 140410,
      "text": "一个省的名字里，",
      "token_start": 467,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 140670,
      "end_ms": 141530,
      "text": "有地理，",
      "token_start": 474,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 141950,
      "end_ms": 145370,
      "text": "有历史、有霸业、有兴亡。",
      "token_start": 477,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 145610,
      "end_ms": 146210,
      "text": "第三名，",
      "token_start": 486,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 147210,
      "end_ms": 150720,
      "text": "甘肃、甘肃的名字是怎么来的？",
      "token_start": 489,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 151140,
      "end_ms": 154620,
      "text": "把甘州和宿州各取一个字合在一起，",
      "token_start": 501,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 154700,
      "end_ms": 156120,
      "text": "就是甘肃甘州，",
      "token_start": 516,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 156120,
      "end_ms": 157480,
      "text": "就是今天的张掖，",
      "token_start": 522,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 158180,
      "end_ms": 158740,
      "text": "肃州，",
      "token_start": 529,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 158900,
      "end_ms": 160120,
      "text": "就是今天的酒泉。",
      "token_start": 531,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 161060,
      "end_ms": 163180,
      "text": "这两座城都在河西走廊上，",
      "token_start": 538,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 163500,
      "end_ms": 166280,
      "text": "是古代丝绸之路的必经之地。",
      "token_start": 549,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 167140,
      "end_ms": 168200,
      "text": "元朝的时候，",
      "token_start": 561,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 168320,
      "end_ms": 170180,
      "text": "朝廷设了甘肃行省，",
      "token_start": 566,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 170640,
      "end_ms": 174180,
      "text": "取甘州的甘和肃州的肃拼成了甘肃。",
      "token_start": 574,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 174960,
      "end_ms": 177000,
      "text": "可这两个字选的也有讲究，",
      "token_start": 589,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 177660,
      "end_ms": 179425,
      "text": "甘是甘甜的意思。",
      "token_start": 600,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 179850,
      "end_ms": 181775,
      "text": "张掖这个地方水草丰美，",
      "token_start": 607,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 182120,
      "end_ms": 185455,
      "text": "祁连山的雪水灌溉出了大片绿洲，",
      "token_start": 617,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 186110,
      "end_ms": 189315,
      "text": "确实甘甜肃是肃穆的意思。",
      "token_start": 631,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 189760,
      "end_ms": 191660,
      "text": "酒泉往昔就是戈壁，",
      "token_start": 642,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 191660,
      "end_ms": 193600,
      "text": "大漠荒凉肃杀，",
      "token_start": 650,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 193660,
      "end_ms": 197990,
      "text": "用素字再合适不过一个甘一个素，",
      "token_start": 656,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 198230,
      "end_ms": 199745,
      "text": "一个是绿洲的甘甜，",
      "token_start": 670,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 200140,
      "end_ms": 203000,
      "text": "一个是大漠的肃穆两个字，",
      "token_start": 678,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 203080,
      "end_ms": 207635,
      "text": "把河西走廊从东到西的风景全概括了。",
      "token_start": 689,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 208060,
      "end_ms": 209460,
      "text": "讲了这么多评论区，",
      "token_start": 705,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 209460,
      "end_ms": 211860,
      "text": "好多朋友说这些省名的讲究，",
      "token_start": 713,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 212120,
      "end_ms": 213115,
      "text": "听着有意思，",
      "token_start": 725,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 213440,
      "end_ms": 216920,
      "text": "可咱们这年纪记不住那么多带孙子的时候，",
      "token_start": 730,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 216920,
      "end_ms": 218755,
      "text": "想讲讲自己也说不全。",
      "token_start": 748,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 219370,
      "end_ms": 222325,
      "text": "前阵子我翻到一本中华文化常识一千问，",
      "token_start": 757,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 222770,
      "end_ms": 223730,
      "text": "分门别类，",
      "token_start": 774,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 223930,
      "end_ms": 224945,
      "text": "一问一答，",
      "token_start": 778,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 225320,
      "end_ms": 228380,
      "text": "把中国历史上的文化常识讲的清清楚楚。",
      "token_start": 782,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 228520,
      "end_ms": 229880,
      "text": "这些省名的来历，",
      "token_start": 799,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 230140,
      "end_ms": 231535,
      "text": "书里能查到不少，",
      "token_start": 806,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 232110,
      "end_ms": 234155,
      "text": "特别适合中老年朋友，",
      "token_start": 813,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 234550,
      "end_ms": 235690,
      "text": "每天翻两页，",
      "token_start": 822,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 235910,
      "end_ms": 237055,
      "text": "心里全有谱，",
      "token_start": 827,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 237420,
      "end_ms": 238455,
      "text": "已经放下面了，",
      "token_start": 832,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 238810,
      "end_ms": 240115,
      "text": "点开就能看到。",
      "token_start": 838,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 240900,
      "end_ms": 242965,
      "text": "喜欢历史的弄一本放床头，",
      "token_start": 844,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 243480,
      "end_ms": 244620,
      "text": "随手翻一页，",
      "token_start": 855,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 244760,
      "end_ms": 245805,
      "text": "就是一段历史。",
      "token_start": 860,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 246080,
      "end_ms": 246645,
      "text": "第二名，",
      "token_start": 866,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 247000,
      "end_ms": 250190,
      "text": "贵州贵州这个名字很多人以为跟贵重有关，",
      "token_start": 869,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 250350,
      "end_ms": 252825,
      "text": "其实不是贵州的贵，",
      "token_start": 887,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 253100,
      "end_ms": 255530,
      "text": "最早指的是一座山桂山。",
      "token_start": 895,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 255550,
      "end_ms": 256390,
      "text": "就在今天，",
      "token_start": 905,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 256510,
      "end_ms": 259030,
      "text": "贵阳附近宋朝的时候，",
      "token_start": 909,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 259030,
      "end_ms": 261495,
      "text": "朝廷在这一带设了贵州。",
      "token_start": 918,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 261810,
      "end_ms": 262445,
      "text": "这个地名。",
      "token_start": 928,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 262690,
      "end_ms": 263775,
      "text": "为什么用贵字？",
      "token_start": 932,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 264210,
      "end_ms": 265835,
      "text": "因为当地有座桂山，",
      "token_start": 938,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 266250,
      "end_ms": 267735,
      "text": "山下有条贵水，",
      "token_start": 946,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 268370,
      "end_ms": 269625,
      "text": "先有山有水。",
      "token_start": 952,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 270000,
      "end_ms": 273725,
      "text": "再有省明古人取名的规矩就是这样，",
      "token_start": 957,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 274550,
      "end_ms": 277005,
      "text": "先找到一个标志性的地理特征，",
      "token_start": 972,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 277590,
      "end_ms": 280105,
      "text": "然后用它来命名整片区域。",
      "token_start": 985,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 280950,
      "end_ms": 282895,
      "text": "可贵州还有一个说法更有意思。",
      "token_start": 996,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 283810,
      "end_ms": 287255,
      "text": "据说当年朝廷给这块地方取名的时候，",
      "token_start": 1009,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 287800,
      "end_ms": 289720,
      "text": "当地的土司首领说了一句，",
      "token_start": 1025,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 289720,
      "end_ms": 290585,
      "text": "此地甚贵，",
      "token_start": 1036,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 291190,
      "end_ms": 293675,
      "text": "意思是这块地方物产丰富。",
      "token_start": 1040,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 294300,
      "end_ms": 296440,
      "text": "地势险要很金贵，",
      "token_start": 1051,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 296980,
      "end_ms": 298260,
      "text": "朝廷一听行，",
      "token_start": 1058,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 298300,
      "end_ms": 299320,
      "text": "那就叫贵州吧。",
      "token_start": 1063,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 299360,
      "end_ms": 300580,
      "text": "不管是哪个说法，",
      "token_start": 1069,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 300820,
      "end_ms": 301060,
      "text": "贵，",
      "token_start": 1076,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 301140,
      "end_ms": 302840,
      "text": "这个字都不是白给的。",
      "token_start": 1077,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 303640,
      "end_ms": 306360,
      "text": "贵州地处云贵高原山，",
      "token_start": 1086,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 306440,
      "end_ms": 307160,
      "text": "高林密，",
      "token_start": 1095,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 307420,
      "end_ms": 308460,
      "text": "矿产丰富，",
      "token_start": 1098,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 308780,
      "end_ms": 311040,
      "text": "确实当得起一个贵字，",
      "token_start": 1102,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 311880,
      "end_ms": 312980,
      "text": "一座山叫，",
      "token_start": 1111,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 313080,
      "end_ms": 314700,
      "text": "贵山一座河，",
      "token_start": 1115,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 314700,
      "end_ms": 315420,
      "text": "叫贵山，",
      "token_start": 1120,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 315780,
      "end_ms": 317140,
      "text": "一个省就叫贵州。",
      "token_start": 1123,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 317860,
      "end_ms": 320380,
      "text": "古人取名先看山水，",
      "token_start": 1130,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 320700,
      "end_ms": 321700,
      "text": "再定名号。",
      "token_start": 1138,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 322060,
      "end_ms": 322420,
      "text": "第一，",
      "token_start": 1142,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 322420,
      "end_ms": 325430,
      "text": "名贵东山东这两个字，",
      "token_start": 1144,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 325790,
      "end_ms": 327950,
      "text": "表面上是太行山之东，",
      "token_start": 1153,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 328650,
      "end_ms": 329570,
      "text": "可您知道吗？",
      "token_start": 1162,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 329870,
      "end_ms": 331610,
      "text": "山东简称鲁，",
      "token_start": 1167,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 332450,
      "end_ms": 335670,
      "text": "这个字的分量比山西的晋还重。",
      "token_start": 1172,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 336550,
      "end_ms": 338910,
      "text": "鲁是周公旦的封国，",
      "token_start": 1185,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 339230,
      "end_ms": 340510,
      "text": "是孔子的故乡，",
      "token_start": 1193,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 340710,
      "end_ms": 342790,
      "text": "是礼乐文明的发源地。",
      "token_start": 1199,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 343610,
      "end_ms": 345010,
      "text": "周公治礼作乐，",
      "token_start": 1208,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 345250,
      "end_ms": 346630,
      "text": "孔子创立儒家，",
      "token_start": 1214,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 346850,
      "end_ms": 348770,
      "text": "都在鲁国这片土地上，",
      "token_start": 1220,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 349590,
      "end_ms": 350450,
      "text": "一个鲁字，",
      "token_start": 1229,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 350810,
      "end_ms": 355095,
      "text": "把中国两千多年的礼乐文明全装进去了。",
      "token_start": 1233,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 355490,
      "end_ms": 357450,
      "text": "山东太行山之东，",
      "token_start": 1250,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 357590,
      "end_ms": 358535,
      "text": "简称鲁，",
      "token_start": 1257,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 359080,
      "end_ms": 360055,
      "text": "齐鲁大地，",
      "token_start": 1260,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 360440,
      "end_ms": 361325,
      "text": "礼仪之邦。",
      "token_start": 1264,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 361990,
      "end_ms": 363295,
      "text": "一个省的名字里，",
      "token_start": 1268,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 363590,
      "end_ms": 367545,
      "text": "有地理、有圣人、有礼乐、有文章。",
      "token_start": 1275,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 368170,
      "end_ms": 369995,
      "text": "全中国那么多省民，",
      "token_start": 1287,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 370570,
      "end_ms": 377085,
      "text": "有哪一个能像山东这样两个字里装着一个民族的精神故乡，",
      "token_start": 1295,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 377560,
      "end_ms": 378775,
      "text": "他就是山东。",
      "token_start": 1320,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 379240,
      "end_ms": 381500,
      "text": "这个名字的讲究不在字面上，",
      "token_start": 1325,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 381700,
      "end_ms": 387085,
      "text": "在他背后藏着的那段让所有中国人热血沸腾的故事里，",
      "token_start": 1337,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 387310,
      "end_ms": 388065,
      "text": "您发现没有？",
      "token_start": 1360,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 388930,
      "end_ms": 392305,
      "text": "这些省名没有一个是随便起的，",
      "token_start": 1365,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 393160,
      "end_ms": 395465,
      "text": "福建靠的是福州加建州，",
      "token_start": 1378,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 396040,
      "end_ms": 397965,
      "text": "云南靠的是云岭之南，",
      "token_start": 1388,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 398390,
      "end_ms": 401015,
      "text": "浙江靠的是一条江的曲折。",
      "token_start": 1397,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 401650,
      "end_ms": 404345,
      "text": "江苏靠的是江宁加苏州，",
      "token_start": 1408,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 404780,
      "end_ms": 406865,
      "text": "四川靠的是四条大船，",
      "token_start": 1418,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 407260,
      "end_ms": 409765,
      "text": "安徽靠的是安庆加徽州。",
      "token_start": 1427,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 410370,
      "end_ms": 412425,
      "text": "山西靠的是三晋大地，",
      "token_start": 1437,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 412930,
      "end_ms": 415175,
      "text": "甘肃靠的是甘州加肃州，",
      "token_start": 1446,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 415630,
      "end_ms": 418115,
      "text": "贵州靠的是贵山贵水。",
      "token_start": 1456,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 418600,
      "end_ms": 420780,
      "text": "山东靠的是齐鲁大地，",
      "token_start": 1465,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 420860,
      "end_ms": 421805,
      "text": "礼仪之邦，",
      "token_start": 1474,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 422160,
      "end_ms": 430455,
      "text": "每一个省民的讲究都不在字面上在他背后藏着的那段历史那个故事那份心思，",
      "token_start": 1478,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 431610,
      "end_ms": 432405,
      "text": "点个关注，",
      "token_start": 1511,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 432740,
      "end_ms": 434275,
      "text": "咱们下期接着聊。",
      "token_start": 1515,
      "token_end_exclusive": 1522
    }
  ],
