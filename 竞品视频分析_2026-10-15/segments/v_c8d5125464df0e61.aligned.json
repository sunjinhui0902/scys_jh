{
  "video_id": "v_c8d5125464df0e61",
  "duration_s": 412.517241,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c8d5125464df0e61.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c8d5125464df0e61.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1890,
      "text": "美国关了他整整五年，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2310,
      "end_ms": 3510,
      "text": "他瘦了三十斤，",
      "token_start": 9,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3790,
      "end_ms": 4470,
      "text": "靠一封，",
      "token_start": 15,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4650,
      "end_ms": 5910,
      "text": "夹带着求救信，",
      "token_start": 18,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6190,
      "end_ms": 8470,
      "text": "回到了祖国家人们。",
      "token_start": 24,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 8770,
      "end_ms": 12970,
      "text": "今天讲一件让所有中国人心里发烫的往事。",
      "token_start": 32,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 13730,
      "end_ms": 14770,
      "text": "一九五零年，",
      "token_start": 50,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 14950,
      "end_ms": 16190,
      "text": "美国洛杉矶，",
      "token_start": 55,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 16730,
      "end_ms": 18650,
      "text": "一个中国人订好了船票，",
      "token_start": 60,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 19270,
      "end_ms": 20990,
      "text": "打包好了全部行李，",
      "token_start": 70,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21290,
      "end_ms": 23430,
      "text": "准备带着妻子孩子回国。",
      "token_start": 78,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 24030,
      "end_ms": 25770,
      "text": "他在美国是什么地位？",
      "token_start": 88,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26170,
      "end_ms": 29310,
      "text": "世界顶尖的空气动力学专家，",
      "token_start": 97,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 29670,
      "end_ms": 32320,
      "text": "美国国海军和空军的座上宾，",
      "token_start": 109,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 32760,
      "end_ms": 35320,
      "text": "手里攥着最高级别的保密许可。",
      "token_start": 121,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 35800,
      "end_ms": 37700,
      "text": "可就在他要上船的时候，",
      "token_start": 134,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 37880,
      "end_ms": 39340,
      "text": "海关把他拦下了，",
      "token_start": 144,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 39440,
      "end_ms": 40400,
      "text": "行李被扣了，",
      "token_start": 151,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 40420,
      "end_ms": 41960,
      "text": "人被带走了。",
      "token_start": 156,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 43300,
      "end_ms": 44240,
      "text": "理由是什么？",
      "token_start": 161,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 44580,
      "end_ms": 48000,
      "text": "莫须有怀疑他携带机密材料，",
      "token_start": 166,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 48700,
      "end_ms": 51080,
      "text": "他被关进了太平洋上的一个小岛，",
      "token_start": 178,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 51080,
      "end_ms": 53920,
      "text": "拘留所一关就是十五天。",
      "token_start": 192,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 54400,
      "end_ms": 55240,
      "text": "那十五天，",
      "token_start": 202,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 55800,
      "end_ms": 57340,
      "text": "美国人不让他睡觉，",
      "token_start": 206,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 57680,
      "end_ms": 59080,
      "text": "每隔一会儿就把他叫醒。",
      "token_start": 214,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 59120,
      "end_ms": 61060,
      "text": "一次轮番审问，",
      "token_start": 224,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 61340,
      "end_ms": 63685,
      "text": "软硬兼施家人们，",
      "token_start": 230,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 64930,
      "end_ms": 65965,
      "text": "您能想象吗？",
      "token_start": 237,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 67050,
      "end_ms": 68730,
      "text": "一个人被剥夺睡眠，",
      "token_start": 242,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 69010,
      "end_ms": 70210,
      "text": "反复折磨，",
      "token_start": 250,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 70630,
      "end_ms": 71535,
      "text": "是什么滋味？",
      "token_start": 254,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 72330,
      "end_ms": 73810,
      "text": "等他被放出来的时候，",
      "token_start": 259,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 74110,
      "end_ms": 75430,
      "text": "整个人暴瘦了，",
      "token_start": 268,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 75430,
      "end_ms": 76495,
      "text": "大概三十斤。",
      "token_start": 274,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 76970,
      "end_ms": 80045,
      "text": "后来是他的老师冯卡门，",
      "token_start": 279,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 80390,
      "end_ms": 84965,
      "text": "还有一帮美国科学家凑了一万五千美元才把他保了出来。",
      "token_start": 289,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 85590,
      "end_ms": 87920,
      "text": "可出了拘留所就自由了吗？",
      "token_start": 313,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 88040,
      "end_ms": 88585,
      "text": "没有。",
      "token_start": 324,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 89040,
      "end_ms": 89665,
      "text": "从此，",
      "token_start": 326,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 89950,
      "end_ms": 93565,
      "text": "他过上了长达五年的软禁生活。",
      "token_start": 328,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 93980,
      "end_ms": 95105,
      "text": "电话被监听，",
      "token_start": 341,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 95470,
      "end_ms": 99435,
      "text": "信件被拆看家门口永远停着监视的车。",
      "token_start": 346,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 100240,
      "end_ms": 100995,
      "text": "他走到哪儿，",
      "token_start": 362,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 101270,
      "end_ms": 103090,
      "text": "美国人都盯着美国人，",
      "token_start": 367,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 103090,
      "end_ms": 104065,
      "text": "为什么这么怕他？",
      "token_start": 376,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 104680,
      "end_ms": 107815,
      "text": "美国海军司长金布尔说过一句著名的话，",
      "token_start": 383,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 108280,
      "end_ms": 111445,
      "text": "我宁可把他毙了也不能让他离开美国，",
      "token_start": 400,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 111870,
      "end_ms": 114795,
      "text": "他无论走到哪里都抵得上五个师。",
      "token_start": 416,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 115480,
      "end_ms": 116945,
      "text": "五个师啊家人们，",
      "token_start": 430,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 117470,
      "end_ms": 118925,
      "text": "美国人是懂价值的。",
      "token_start": 437,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 119250,
      "end_ms": 120785,
      "text": "可美国人不知道的是，",
      "token_start": 445,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 121110,
      "end_ms": 125230,
      "text": "他们关得住钱学森的人关不住，",
      "token_start": 454,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 125230,
      "end_ms": 128415,
      "text": "钱学森的心被软禁的那五年，",
      "token_start": 467,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 128710,
      "end_ms": 129845,
      "text": "他做了两件事，",
      "token_start": 479,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 130150,
      "end_ms": 133605,
      "text": "第一写的一本书叫工程控制论。",
      "token_start": 485,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 134110,
      "end_ms": 136925,
      "text": "这本书直接开创了一门新学科，",
      "token_start": 498,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 137620,
      "end_ms": 138665,
      "text": "直到今天，",
      "token_start": 511,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 139050,
      "end_ms": 142190,
      "text": "全世界的工程师还在读第二。",
      "token_start": 515,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 142850,
      "end_ms": 144365,
      "text": "他一直在想一件事，",
      "token_start": 527,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 145230,
      "end_ms": 147615,
      "text": "怎么才能联系上祖国？",
      "token_start": 535,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 148460,
      "end_ms": 150970,
      "text": "信写不了信会被检查，",
      "token_start": 544,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 151250,
      "end_ms": 152270,
      "text": "电话打不了，",
      "token_start": 553,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 152450,
      "end_ms": 154875,
      "text": "会被监听怎么办？",
      "token_start": 558,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 155890,
      "end_ms": 157385,
      "text": "一九五五年的一天，",
      "token_start": 565,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 157760,
      "end_ms": 160555,
      "text": "钱学森在报纸上看到了一个名字，",
      "token_start": 573,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 160790,
      "end_ms": 164495,
      "text": "陈书通一位德高望重的老人，",
      "token_start": 587,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 164950,
      "end_ms": 167025,
      "text": "他小时候跟着父亲去拜访过。",
      "token_start": 599,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 167520,
      "end_ms": 168140,
      "text": "钱学森，",
      "token_start": 611,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 168140,
      "end_ms": 168865,
      "text": "心里一动，",
      "token_start": 614,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 169310,
      "end_ms": 170835,
      "text": "提笔写了一封信，",
      "token_start": 618,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 171350,
      "end_ms": 173925,
      "text": "信上写着我准备归国，",
      "token_start": 625,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 174640,
      "end_ms": 176425,
      "text": "但美国处处阻挠，",
      "token_start": 634,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 176890,
      "end_ms": 178425,
      "text": "请求祖国帮助。",
      "token_start": 641,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 178990,
      "end_ms": 181245,
      "text": "信写好了怎么寄出去？",
      "token_start": 647,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 182620,
      "end_ms": 183295,
      "text": "这时候，",
      "token_start": 656,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 183820,
      "end_ms": 185595,
      "text": "他的夫人蒋英站了出来，",
      "token_start": 659,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 185990,
      "end_ms": 186790,
      "text": "蒋英是谁？",
      "token_start": 669,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 187050,
      "end_ms": 188125,
      "text": "著名歌唱家，",
      "token_start": 673,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 188490,
      "end_ms": 191535,
      "text": "他的父亲是民国著名军事家蒋百里，",
      "token_start": 678,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 192430,
      "end_ms": 194215,
      "text": "这位出身名门的女子，",
      "token_start": 693,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 194510,
      "end_ms": 197735,
      "text": "做了一件让后来无数人泪目的事，",
      "token_start": 702,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 198490,
      "end_ms": 203215,
      "text": "他用左手模仿小孩歪歪扭扭的笔迹，",
      "token_start": 716,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 203790,
      "end_ms": 204810,
      "text": "把信封写好，",
      "token_start": 731,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 205150,
      "end_ms": 209885,
      "text": "然后把那封求救信夹在了一封给妹妹的家书里。",
      "token_start": 736,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 210290,
      "end_ms": 213475,
      "text": "既往比利时妹妹一看就明白了，",
      "token_start": 756,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 214190,
      "end_ms": 216375,
      "text": "立刻转继回祖国。",
      "token_start": 769,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 217710,
      "end_ms": 219925,
      "text": "这封信一路辗转，",
      "token_start": 776,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 220270,
      "end_ms": 223835,
      "text": "最后摆在了周总理的办公桌上家人们，",
      "token_start": 783,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 224250,
      "end_ms": 226185,
      "text": "您知道这封信有多重要吗？",
      "token_start": 799,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 226520,
      "end_ms": 226960,
      "text": "那会儿，",
      "token_start": 810,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 226960,
      "end_ms": 229315,
      "text": "中美正在日内瓦谈判，",
      "token_start": 813,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 230190,
      "end_ms": 233385,
      "text": "美国想换回十一个被俘的美军飞行员，",
      "token_start": 822,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 233880,
      "end_ms": 235055,
      "text": "嘴上却硬的很，",
      "token_start": 838,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 235550,
      "end_ms": 241195,
      "text": "说钱学森是自愿留在美国的中方代表当场把信拿出来，",
      "token_start": 844,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 241560,
      "end_ms": 242605,
      "text": "白纸黑字，",
      "token_start": 867,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 243010,
      "end_ms": 244105,
      "text": "铁证如山，",
      "token_start": 871,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 244780,
      "end_ms": 247545,
      "text": "美国人的脸当场就挂不住了。",
      "token_start": 875,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 248420,
      "end_ms": 253200,
      "text": "最后双方达成交换十一个美军飞行员，",
      "token_start": 887,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 253500,
      "end_ms": 256375,
      "text": "换一个钱学森家人们，",
      "token_start": 903,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 256840,
      "end_ms": 258275,
      "text": "您算算这笔账，",
      "token_start": 912,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 258750,
      "end_ms": 260825,
      "text": "十一个飞行员换一个人，",
      "token_start": 918,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 261350,
      "end_ms": 263285,
      "text": "美国人心疼的是一个兵。",
      "token_start": 928,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 263740,
      "end_ms": 265240,
      "text": "可他们换出去的是谁？",
      "token_start": 938,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 265560,
      "end_ms": 267865,
      "text": "是抵得上五个师的钱学森。",
      "token_start": 947,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 268660,
      "end_ms": 271165,
      "text": "后来有美国人自己都承认，",
      "token_start": 958,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 271510,
      "end_ms": 277225,
      "text": "这笔买卖是他们在冷战里做过的最亏本的交易之一。",
      "token_start": 969,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 278950,
      "end_ms": 280935,
      "text": "一九五五年九月十七号，",
      "token_start": 991,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 281400,
      "end_ms": 284385,
      "text": "钱学森终于登上了回国的轮船，",
      "token_start": 1001,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 284800,
      "end_ms": 287390,
      "text": "克利夫兰总统号船。",
      "token_start": 1014,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 287450,
      "end_ms": 289690,
      "text": "经过日本横滨码头上，",
      "token_start": 1022,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 289690,
      "end_ms": 292670,
      "text": "有人再三劝他下去逛逛嘛，",
      "token_start": 1031,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 292750,
      "end_ms": 293885,
      "text": "买点土特产，",
      "token_start": 1042,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 294790,
      "end_ms": 296785,
      "text": "钱学森一步都没有下船。",
      "token_start": 1047,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 297270,
      "end_ms": 298275,
      "text": "据后来披露。",
      "token_start": 1057,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 299020,
      "end_ms": 303780,
      "text": "组织上早就提前以他父亲的名义发来电报，",
      "token_start": 1062,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 303800,
      "end_ms": 306340,
      "text": "叮嘱他沿途切勿下船。",
      "token_start": 1080,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 307280,
      "end_ms": 307960,
      "text": "为什么？",
      "token_start": 1089,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 308320,
      "end_ms": 310600,
      "text": "因为一旦踏上日本的土地，",
      "token_start": 1092,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 310840,
      "end_ms": 313220,
      "text": "就什么意外都可能发生，",
      "token_start": 1103,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 313660,
      "end_ms": 316700,
      "text": "而美国人可以说跟我们没关系。",
      "token_start": 1113,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 318500,
      "end_ms": 319160,
      "text": "就这样，",
      "token_start": 1126,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 319640,
      "end_ms": 323760,
      "text": "这艘船载着全中国最值钱的一个头脑，",
      "token_start": 1129,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 324580,
      "end_ms": 325560,
      "text": "破浪向西。",
      "token_start": 1145,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 326500,
      "end_ms": 328375,
      "text": "一九五五年十月八号，",
      "token_start": 1149,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 328770,
      "end_ms": 331750,
      "text": "钱学森踏上祖国土地的那一刻，",
      "token_start": 1158,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 332530,
      "end_ms": 336250,
      "text": "迎接他的是罗湖桥上的五星红旗。",
      "token_start": 1171,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 336909,
      "end_ms": 337970,
      "text": "他后来回忆说，",
      "token_start": 1185,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 338390,
      "end_ms": 339770,
      "text": "看到国旗那一刻，",
      "token_start": 1191,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 340050,
      "end_ms": 341630,
      "text": "眼泪差点没绷住。",
      "token_start": 1198,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 343330,
      "end_ms": 343930,
      "text": "家人们，",
      "token_start": 1205,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 343930,
      "end_ms": 344530,
      "text": "您想想，",
      "token_start": 1208,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 344530,
      "end_ms": 345330,
      "text": "那段日子，",
      "token_start": 1211,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 345630,
      "end_ms": 346830,
      "text": "他被关了五年，",
      "token_start": 1215,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 347290,
      "end_ms": 349890,
      "text": "瘦了三十斤受尽折磨，",
      "token_start": 1221,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 350190,
      "end_ms": 353350,
      "text": "可他一句怨言都没有蒋英。",
      "token_start": 1230,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 353370,
      "end_ms": 354250,
      "text": "后来回忆说，",
      "token_start": 1241,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 354670,
      "end_ms": 355390,
      "text": "那五年，",
      "token_start": 1246,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 355610,
      "end_ms": 357730,
      "text": "他甚至做好了最坏的打算，",
      "token_start": 1249,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 358230,
      "end_ms": 359785,
      "text": "但但他们始终相信，",
      "token_start": 1260,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 360260,
      "end_ms": 362255,
      "text": "祖国一定会接他回家。",
      "token_start": 1268,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 363370,
      "end_ms": 364165,
      "text": "事实证明，",
      "token_start": 1277,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 364470,
      "end_ms": 365595,
      "text": "他们赌赢了，",
      "token_start": 1281,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 366560,
      "end_ms": 369525,
      "text": "而中国赢回了自己的未来。",
      "token_start": 1286,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 370470,
      "end_ms": 371530,
      "text": "有一句话说的好，",
      "token_start": 1297,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 371810,
      "end_ms": 374395,
      "text": "有些历史我们不该忘，",
      "token_start": 1304,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 374720,
      "end_ms": 375535,
      "text": "也不能忘。",
      "token_start": 1313,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 376580,
      "end_ms": 382450,
      "text": "钱学森用五年自由换回了中国航天整整一个时代。",
      "token_start": 1317,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 382530,
      "end_ms": 386385,
      "text": "今天的神州嫦娥天问、东风快递，",
      "token_start": 1338,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 386940,
      "end_ms": 392905,
      "text": "所有的根都从他一九五五年迈上罗浮桥那一刻开始，",
      "token_start": 1351,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 393890,
      "end_ms": 395585,
      "text": "家人们点个关注，",
      "token_start": 1373,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 395910,
      "end_ms": 399475,
      "text": "下期我接着讲钱老回国之后的故事。",
      "token_start": 1380,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 399910,
      "end_ms": 404025,
      "text": "这条视频请您一定点赞、收藏、转发，",
      "token_start": 1395,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 404550,
      "end_ms": 405830,
      "text": "让更多人知道，",
      "token_start": 1409,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 406010,
      "end_ms": 412405,
      "text": "当年有一个中国人用一封藏在信封里的求救信救回了自己的祖国。",
      "token_start": 1415,
      "token_end_exclusive": 1443
    }
  ],
