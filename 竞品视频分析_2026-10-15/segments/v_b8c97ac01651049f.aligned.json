{
  "video_id": "v_b8c97ac01651049f",
  "duration_s": 434.862993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b8c97ac01651049f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b8c97ac01651049f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 7220,
      "text": "上集说到平油帽摘了大庆油田出油了，",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 8000,
      "end_ms": 12160,
      "text": "一到更凶险的难关就横在了面前。",
      "token_start": 16,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 13180,
      "end_ms": 18944,
      "text": "造原子弹的油矿被全世界都封锁起来，",
      "token_start": 30,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 20940,
      "end_ms": 22060,
      "text": "没有浓缩油，",
      "token_start": 46,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 22620,
      "end_ms": 24160,
      "text": "两弹就是一句空话。",
      "token_start": 51,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 24640,
      "end_ms": 26080,
      "text": "一九五五年一月，",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 26440,
      "end_ms": 29240,
      "text": "中央专门召开书记处扩大会议，",
      "token_start": 66,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 29720,
      "end_ms": 31820,
      "text": "讨论发展原子能事业。",
      "token_start": 79,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 32840,
      "end_ms": 34880,
      "text": "李四光带去了两样东西，",
      "token_start": 88,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 36440,
      "end_ms": 38700,
      "text": "国内发现的油矿石，",
      "token_start": 98,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 39280,
      "end_ms": 42180,
      "text": "还有从英国冒险带回的伽马探测仪。",
      "token_start": 106,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 42640,
      "end_ms": 45160,
      "text": "他当场给中央领导演示。",
      "token_start": 121,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 45320,
      "end_ms": 48220,
      "text": "仪器一靠近矿石嘎嘎作响。",
      "token_start": 131,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 48900,
      "end_ms": 50950,
      "text": "中国的地下有油油，",
      "token_start": 142,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 51350,
      "end_ms": 54990,
      "text": "就是这一声响定下了中国核工业的起点。",
      "token_start": 150,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 55650,
      "end_ms": 57310,
      "text": "从一九五四年起，",
      "token_start": 167,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 57590,
      "end_ms": 60225,
      "text": "李四光指导找油矿的队伍。",
      "token_start": 174,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 60920,
      "end_ms": 62800,
      "text": "在华南的崇山峻岭里，",
      "token_start": 185,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 62800,
      "end_ms": 64015,
      "text": "开展油矿普查，",
      "token_start": 194,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 64620,
      "end_ms": 66905,
      "text": "相继发现一系列油矿床，",
      "token_start": 200,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 67380,
      "end_ms": 70575,
      "text": "其中就包括特大型的二幺幺油矿船，",
      "token_start": 210,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 71270,
      "end_ms": 72675,
      "text": "正是这批矿石，",
      "token_start": 225,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 73060,
      "end_ms": 77015,
      "text": "撑起了我国第一颗原子弹的原料底气。",
      "token_start": 231,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 77750,
      "end_ms": 78725,
      "text": "一九六四年，",
      "token_start": 247,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 79190,
      "end_ms": 79790,
      "text": "戈壁滩，",
      "token_start": 252,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 79970,
      "end_ms": 82570,
      "text": "罗布泊内蘑菇云腾空而起。",
      "token_start": 255,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 82830,
      "end_ms": 84375,
      "text": "今天荣光的背后，",
      "token_start": 266,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 84810,
      "end_ms": 88970,
      "text": "藏着李四光和无数的地质人无声的坚守。",
      "token_start": 273,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 89210,
      "end_ms": 94230,
      "text": "石油油矿两件大事落的所有人，",
      "token_start": 290,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 94230,
      "end_ms": 99845,
      "text": "都以为这位为国家拼了大半辈子的老人终于可以歇歇了。",
      "token_start": 303,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 100860,
      "end_ms": 105425,
      "text": "可他偏不一九六六年河北邢台发生大地震，",
      "token_start": 327,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 105810,
      "end_ms": 107295,
      "text": "大地剧烈震颤，",
      "token_start": 345,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 107770,
      "end_ms": 109725,
      "text": "无数百姓流离失所。",
      "token_start": 351,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 110130,
      "end_ms": 110615,
      "text": "那一年，",
      "token_start": 359,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 110900,
      "end_ms": 112495,
      "text": "李四光七十六岁。",
      "token_start": 362,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 113210,
      "end_ms": 115045,
      "text": "他肚子里长着一个动脉瘤，",
      "token_start": 369,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 115610,
      "end_ms": 117045,
      "text": "随时可能破裂，",
      "token_start": 380,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 117900,
      "end_ms": 118965,
      "text": "奔波激动，",
      "token_start": 386,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 119230,
      "end_ms": 120530,
      "text": "都有性命之忧，",
      "token_start": 390,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 120670,
      "end_ms": 122710,
      "text": "身边所有人轮番劝阻，",
      "token_start": 396,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 122890,
      "end_ms": 124185,
      "text": "千万别去灾区，",
      "token_start": 405,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 124870,
      "end_ms": 127605,
      "text": "您这身体经不起折腾，",
      "token_start": 411,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 128410,
      "end_ms": 130085,
      "text": "可李四光说了一句话，",
      "token_start": 420,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 130810,
      "end_ms": 133545,
      "text": "让在场所有人都沉默了，",
      "token_start": 429,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 134700,
      "end_ms": 135175,
      "text": "他说，",
      "token_start": 439,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 136620,
      "end_ms": 137895,
      "text": "不要再阻拦我了。",
      "token_start": 441,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 138360,
      "end_ms": 140380,
      "text": "总理都去到灾区视察，",
      "token_start": 448,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 140720,
      "end_ms": 142135,
      "text": "我就是做这个工作的，",
      "token_start": 457,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 143130,
      "end_ms": 144705,
      "text": "怎么能贪生怕死呢？",
      "token_start": 466,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 145660,
      "end_ms": 146245,
      "text": "蹲了蹲，",
      "token_start": 474,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 146580,
      "end_ms": 147540,
      "text": "他又说了一句，",
      "token_start": 477,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 147540,
      "end_ms": 148715,
      "text": "藏在心底的话，",
      "token_start": 483,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 149120,
      "end_ms": 152265,
      "text": "地震预报这个难关总要有人去闯，",
      "token_start": 489,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 152780,
      "end_ms": 153505,
      "text": "我不来闯，",
      "token_start": 503,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 153820,
      "end_ms": 154455,
      "text": "谁来闯？",
      "token_start": 507,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 155170,
      "end_ms": 156355,
      "text": "他不顾生死，",
      "token_start": 510,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 156700,
      "end_ms": 158140,
      "text": "奔赴地震灾区，",
      "token_start": 515,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 158320,
      "end_ms": 159955,
      "text": "踏遍震后的土地，",
      "token_start": 521,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 160330,
      "end_ms": 163215,
      "text": "争分夺秒的研究地震预警系统。",
      "token_start": 528,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 163690,
      "end_ms": 171480,
      "text": "他提出用地应力测量、结合构造、应力场分析、再和活动构造的实地观测，",
      "token_start": 541,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 171740,
      "end_ms": 172955,
      "text": "拧成一股绳，",
      "token_start": 570,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 173630,
      "end_ms": 176695,
      "text": "给地震预报趟出一条新路。",
      "token_start": 575,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 177600,
      "end_ms": 180495,
      "text": "他是我国地震地质学的开路先锋。",
      "token_start": 586,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 181420,
      "end_ms": 182455,
      "text": "一九七零年，",
      "token_start": 600,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 182810,
      "end_ms": 184595,
      "text": "他以八十一岁高龄，",
      "token_start": 605,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 184940,
      "end_ms": 186145,
      "text": "仍跋山涉水，",
      "token_start": 613,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 186530,
      "end_ms": 188835,
      "text": "亲自去查看地震现象。",
      "token_start": 618,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 189420,
      "end_ms": 190365,
      "text": "有人劝他，",
      "token_start": 627,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 190800,
      "end_ms": 193105,
      "text": "您老这把年纪歇着吧。",
      "token_start": 631,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 194140,
      "end_ms": 194965,
      "text": "他摇头，",
      "token_start": 640,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 196010,
      "end_ms": 197885,
      "text": "地下的脾气还没磨透，",
      "token_start": 643,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 199490,
      "end_ms": 200290,
      "text": "我歇不下。",
      "token_start": 652,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 200510,
      "end_ms": 202655,
      "text": "一九七一年四月二十九日，",
      "token_start": 656,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 203380,
      "end_ms": 207155,
      "text": "八十二岁的李四光最终还是倒下了，",
      "token_start": 667,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 208080,
      "end_ms": 209115,
      "text": "住进了医院。",
      "token_start": 682,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 209930,
      "end_ms": 210775,
      "text": "弥留之际，",
      "token_start": 687,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 211470,
      "end_ms": 213735,
      "text": "他不问自己还能活多久，",
      "token_start": 691,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 214750,
      "end_ms": 215975,
      "text": "只问了一句话，",
      "token_start": 701,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 216440,
      "end_ms": 220875,
      "text": "还有多少时间可以安排剩下的科研工作？",
      "token_start": 707,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 221560,
      "end_ms": 222415,
      "text": "他走之后，",
      "token_start": 724,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 222740,
      "end_ms": 224340,
      "text": "人们翻开他的手稿，",
      "token_start": 728,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 224620,
      "end_ms": 229745,
      "text": "写满了地热海洋帝质地震预报的规划，",
      "token_start": 736,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 230160,
      "end_ms": 232765,
      "text": "没有一句关于自己的私事。",
      "token_start": 752,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 233670,
      "end_ms": 234825,
      "text": "每次看到这里，",
      "token_start": 763,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 235170,
      "end_ms": 237225,
      "text": "我心里久久不能平静。",
      "token_start": 769,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 238580,
      "end_ms": 240600,
      "text": "一个人一辈子坚守初心，",
      "token_start": 778,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 240620,
      "end_ms": 241295,
      "text": "已经很难。",
      "token_start": 788,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 241980,
      "end_ms": 242965,
      "text": "更难得的是，",
      "token_start": 792,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 243340,
      "end_ms": 247505,
      "text": "这份刻在骨子里的报国信念没有随他而去，",
      "token_start": 797,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 247810,
      "end_ms": 250865,
      "text": "而是顺着血脉传到了下一代。",
      "token_start": 815,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 252000,
      "end_ms": 256385,
      "text": "他的女儿李林英国博士毕业答辩一结束，",
      "token_start": 827,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 256750,
      "end_ms": 257985,
      "text": "不等学位证书，",
      "token_start": 844,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 258310,
      "end_ms": 261050,
      "text": "便立刻回到祖国国家。",
      "token_start": 850,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 261050,
      "end_ms": 262370,
      "text": "哪里缺科研人才，",
      "token_start": 859,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 262550,
      "end_ms": 265775,
      "text": "他就去哪里数次转换研究方向，",
      "token_start": 866,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 266090,
      "end_ms": 268575,
      "text": "一头扎进艰苦的核材料可言。",
      "token_start": 879,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 269190,
      "end_ms": 274950,
      "text": "女婿周成鲁学成后也是直接归国投身基础科学，",
      "token_start": 891,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 275010,
      "end_ms": 278145,
      "text": "是人工合成牛胰岛素的核心工程。",
      "token_start": 911,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 278880,
      "end_ms": 279440,
      "text": "后来，",
      "token_start": 925,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 279690,
      "end_ms": 288945,
      "text": "李林与周成鲁双双当选中科院院士、李四光、李林、邹成、鲁一门两代三院士。",
      "token_start": 927,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 289600,
      "end_ms": 290020,
      "text": "当年，",
      "token_start": 957,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 290060,
      "end_ms": 291840,
      "text": "孙中山那句努力，",
      "token_start": 959,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 291940,
      "end_ms": 296295,
      "text": "向学未为国用一代人的初心，",
      "token_start": 966,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 296790,
      "end_ms": 299135,
      "text": "成了两代人不变的信仰。",
      "token_start": 978,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 300290,
      "end_ms": 301910,
      "text": "回看李四光这一生，",
      "token_start": 988,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 302570,
      "end_ms": 305250,
      "text": "你会发现一条极清晰的线，",
      "token_start": 996,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 305790,
      "end_ms": 308705,
      "text": "十四岁名字填错了。",
      "token_start": 1007,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 309310,
      "end_ms": 310750,
      "text": "他将错就错，",
      "token_start": 1015,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 311050,
      "end_ms": 312670,
      "text": "定下了一生的方向。",
      "token_start": 1020,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 313710,
      "end_ms": 315890,
      "text": "青年国家缺造船的，",
      "token_start": 1028,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 315910,
      "end_ms": 316790,
      "text": "他学造船，",
      "token_start": 1036,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 317630,
      "end_ms": 319310,
      "text": "国家缺采矿的。",
      "token_start": 1040,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 319970,
      "end_ms": 321030,
      "text": "他学采矿，",
      "token_start": 1046,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 321410,
      "end_ms": 323010,
      "text": "国家缺地质的，",
      "token_start": 1050,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 323430,
      "end_ms": 325950,
      "text": "他转地质中年，",
      "token_start": 1056,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 326370,
      "end_ms": 328150,
      "text": "全世界说中国没油。",
      "token_start": 1062,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 328870,
      "end_ms": 330430,
      "text": "他不信四年，",
      "token_start": 1070,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 330510,
      "end_ms": 331925,
      "text": "找到大庆油田，",
      "token_start": 1075,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 334200,
      "end_ms": 336440,
      "text": "晚年油矿被封锁，",
      "token_start": 1081,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 336780,
      "end_ms": 338200,
      "text": "他去找地震，",
      "token_start": 1088,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 338200,
      "end_ms": 338960,
      "text": "没法预报。",
      "token_start": 1093,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 339180,
      "end_ms": 339800,
      "text": "他去闯。",
      "token_start": 1097,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 340280,
      "end_ms": 341060,
      "text": "身故后，",
      "token_start": 1100,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 341300,
      "end_ms": 343520,
      "text": "女儿女婿接过那束光，",
      "token_start": 1103,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 343780,
      "end_ms": 345660,
      "text": "继续照亮咱们这个国家。",
      "token_start": 1112,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 346460,
      "end_ms": 347160,
      "text": "他曾说，",
      "token_start": 1122,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 347560,
      "end_ms": 349260,
      "text": "我是炎黄的子孙，",
      "token_start": 1125,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 349860,
      "end_ms": 355540,
      "text": "理所当然的要把所学到的知识全部献给我亲爱的祖国。",
      "token_start": 1132,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 356400,
      "end_ms": 356980,
      "text": "他还说，",
      "token_start": 1155,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 357060,
      "end_ms": 357700,
      "text": "不怀疑，",
      "token_start": 1158,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 357780,
      "end_ms": 358540,
      "text": "不能见真。",
      "token_start": 1161,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 359000,
      "end_ms": 361160,
      "text": "所以我希望大家都去怀疑态度，",
      "token_start": 1165,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 361500,
      "end_ms": 363440,
      "text": "不要为已成的学说。",
      "token_start": 1178,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 363440,
      "end_ms": 366010,
      "text": "所压达倒这两句朴素的话，",
      "token_start": 1186,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 366470,
      "end_ms": 367550,
      "text": "一个讲立场，",
      "token_start": 1197,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 367830,
      "end_ms": 368905,
      "text": "一个讲方法，",
      "token_start": 1202,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 369430,
      "end_ms": 372245,
      "text": "合起来就是李四光一生的写照。",
      "token_start": 1207,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 373210,
      "end_ms": 375895,
      "text": "今天当我们开车加满油，",
      "token_start": 1220,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 376470,
      "end_ms": 380385,
      "text": "当我们抬头看见北斗族网、神州飞天，",
      "token_start": 1230,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 381380,
      "end_ms": 382225,
      "text": "请不要忘了。",
      "token_start": 1245,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 383960,
      "end_ms": 385155,
      "text": "在很久以前，",
      "token_start": 1250,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 385710,
      "end_ms": 387755,
      "text": "有一个叫李四光的老人，",
      "token_start": 1255,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 388390,
      "end_ms": 390715,
      "text": "用一支笔一张图，",
      "token_start": 1265,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 391240,
      "end_ms": 392925,
      "text": "一双磨破的布鞋，",
      "token_start": 1272,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 393430,
      "end_ms": 397985,
      "text": "把他的论文一笔一划写在了祖国的山河之上。",
      "token_start": 1279,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 398790,
      "end_ms": 399855,
      "text": "他叫李四光，",
      "token_start": 1298,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 400320,
      "end_ms": 402135,
      "text": "当年那个名字是填错的，",
      "token_start": 1303,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 402400,
      "end_ms": 407565,
      "text": "可他用一生把这三个字写成了这个国家最硬的底气。",
      "token_start": 1313,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 408230,
      "end_ms": 411645,
      "text": "如果你也被这位老人和他的一家人打动了，",
      "token_start": 1335,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 411900,
      "end_ms": 412955,
      "text": "请点个关注，",
      "token_start": 1353,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 413270,
      "end_ms": 417535,
      "text": "我会继续讲更多不该被遗忘的国之脊梁。",
      "token_start": 1358,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 418910,
      "end_ms": 420095,
      "text": "点赞、收藏，",
      "token_start": 1375,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 421590,
      "end_ms": 425065,
      "text": "把这条视频转发给你的家人和朋友，",
      "token_start": 1379,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 425640,
      "end_ms": 427765,
      "text": "让更多人记住李四光，",
      "token_start": 1394,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 428680,
      "end_ms": 431105,
      "text": "记住那些为我们拼过命的人，",
      "token_start": 1403,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 432830,
      "end_ms": 434655,
      "text": "致敬国之脊梁。",
      "token_start": 1415,
      "token_end_exclusive": 1421
    }
  ],
