{
  "video_id": "v_d3f3bf3980928b72",
  "duration_s": 542.673991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_d3f3bf3980928b72.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_d3f3bf3980928b72.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1770,
      "text": "我跟你说件事儿，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1770,
      "end_ms": 5490,
      "text": "洛阳这座城市可能是全中国最委屈的古都，",
      "token_start": 7,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 5670,
      "end_ms": 6450,
      "text": "没有之一。",
      "token_start": 25,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 7250,
      "end_ms": 8130,
      "text": "为什么这么说？",
      "token_start": 29,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 9130,
      "end_ms": 11290,
      "text": "你听听大家对他的评价就知道了。",
      "token_start": 35,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 11570,
      "end_ms": 13390,
      "text": "洛阳啊牡丹挺好看，",
      "token_start": 49,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 14110,
      "end_ms": 17510,
      "text": "洛阳啊龙门石窟拍张照挺出片儿。",
      "token_start": 57,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 17890,
      "end_ms": 20030,
      "text": "洛阳啊水席挺好吃的，",
      "token_start": 71,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 20370,
      "end_ms": 22170,
      "text": "然后呢没有然后了。",
      "token_start": 80,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 22530,
      "end_ms": 24330,
      "text": "在很多人的认知里，",
      "token_start": 88,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 24830,
      "end_ms": 27270,
      "text": "这座十三朝古都已经退休了，",
      "token_start": 96,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 27990,
      "end_ms": 29785,
      "text": "坐在历史的功劳簿上，",
      "token_start": 108,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 30140,
      "end_ms": 30380,
      "text": "靠，",
      "token_start": 117,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 30400,
      "end_ms": 33100,
      "text": "每年四月的牡丹花会续命。",
      "token_start": 118,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 33240,
      "end_ms": 35000,
      "text": "我两年前去的时候，",
      "token_start": 129,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 35240,
      "end_ms": 36320,
      "text": "就是这个心态，",
      "token_start": 137,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 36860,
      "end_ms": 38180,
      "text": "白马寺转一圈，",
      "token_start": 143,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 38520,
      "end_ms": 39960,
      "text": "龙门石窟打个卡，",
      "token_start": 149,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 40280,
      "end_ms": 42500,
      "text": "看一场牡丹走的时候，",
      "token_start": 156,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 42500,
      "end_ms": 43740,
      "text": "心里还给他下了个结论，",
      "token_start": 165,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 43740,
      "end_ms": 45640,
      "text": "古都就剩个名头了，",
      "token_start": 175,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 45640,
      "end_ms": 47260,
      "text": "夜市还没旁边，",
      "token_start": 183,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 47260,
      "end_ms": 49580,
      "text": "郑州热闹也就那么回事儿。",
      "token_start": 189,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 50020,
      "end_ms": 51220,
      "text": "直到去年春天，",
      "token_start": 200,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 51720,
      "end_ms": 53380,
      "text": "一个德国人把我点醒了。",
      "token_start": 206,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 53440,
      "end_ms": 54280,
      "text": "不是真点，",
      "token_start": 216,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 54280,
      "end_ms": 57500,
      "text": "是那种让你整个人愣在原地的。",
      "token_start": 220,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 57500,
      "end_ms": 57860,
      "text": "追问，",
      "token_start": 233,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 57860,
      "end_ms": 59900,
      "text": "他是一位研究啊，",
      "token_start": 235,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 60070,
      "end_ms": 64495,
      "text": "欧亚古都兴衰的历史学者干了三十多年，",
      "token_start": 242,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 65590,
      "end_ms": 69045,
      "text": "德国人嘛较真一辈子就琢磨一件事，",
      "token_start": 259,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 69500,
      "end_ms": 72345,
      "text": "历史上的大城市为什么兴起？",
      "token_start": 274,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 72720,
      "end_ms": 73725,
      "text": "为什么衰落？",
      "token_start": 286,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 74090,
      "end_ms": 76435,
      "text": "为什么有的摔了就再也起不来？",
      "token_start": 291,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 77010,
      "end_ms": 81230,
      "text": "这趟来中国是受邀考察古都保护行程单上，",
      "token_start": 304,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 81250,
      "end_ms": 82565,
      "text": "北京、西安都有，",
      "token_start": 322,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 82950,
      "end_ms": 84450,
      "text": "但他自己加了一战，",
      "token_start": 328,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 84470,
      "end_ms": 87255,
      "text": "洛阳说什么都要来现场走一走。",
      "token_start": 336,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 88060,
      "end_ms": 88815,
      "text": "到了洛阳，",
      "token_start": 349,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 89190,
      "end_ms": 90585,
      "text": "我没带他去牡丹园，",
      "token_start": 353,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 90990,
      "end_ms": 91710,
      "text": "直接去了。",
      "token_start": 361,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 91710,
      "end_ms": 92685,
      "text": "应天门遗址，",
      "token_start": 365,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 93220,
      "end_ms": 99325,
      "text": "他站在那片隋唐宫城的夯土钳又踱到漯河边，",
      "token_start": 370,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 99680,
      "end_ms": 101700,
      "text": "看着那条并不宽的河，",
      "token_start": 389,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 101900,
      "end_ms": 102820,
      "text": "一句话不说，",
      "token_start": 398,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 103080,
      "end_ms": 104355,
      "text": "看了半个多小时，",
      "token_start": 403,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 104810,
      "end_ms": 106495,
      "text": "然后他突然转过头问我，",
      "token_start": 410,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 106830,
      "end_ms": 110865,
      "text": "你知道你脚下这条河的两边埋着几座都城吗？",
      "token_start": 420,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 111200,
      "end_ms": 111480,
      "text": "我说，",
      "token_start": 439,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 111480,
      "end_ms": 112795,
      "text": "知道洛阳吗？",
      "token_start": 441,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 113310,
      "end_ms": 114375,
      "text": "十三朝古都，",
      "token_start": 446,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 114860,
      "end_ms": 115925,
      "text": "他说十三朝，",
      "token_start": 451,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 116370,
      "end_ms": 119755,
      "text": "你知道这十三座城都埋在什么地方吗？",
      "token_start": 456,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 120240,
      "end_ms": 120840,
      "text": "我摇头，",
      "token_start": 472,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 121320,
      "end_ms": 122140,
      "text": "他蹲下来，",
      "token_start": 475,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 122420,
      "end_ms": 128020,
      "text": "在地图上从东往西画了一条线三十公里，",
      "token_start": 479,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 128380,
      "end_ms": 132800,
      "text": "从二里头下的都城到偃池商城，",
      "token_start": 496,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 133140,
      "end_ms": 135200,
      "text": "五汤灭夏之后建的城，",
      "token_start": 509,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 135740,
      "end_ms": 137160,
      "text": "再到东周王城，",
      "token_start": 518,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 137360,
      "end_ms": 138780,
      "text": "再到汉卫洛阳城，",
      "token_start": 524,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 139240,
      "end_ms": 142800,
      "text": "再到隋唐洛阳城五座都城遗址，",
      "token_start": 531,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 143040,
      "end_ms": 146080,
      "text": "沿着这条漯河一字排开，",
      "token_start": 544,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 146540,
      "end_ms": 148020,
      "text": "东西直线距离，",
      "token_start": 554,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 148020,
      "end_ms": 149645,
      "text": "只有三十多公里。",
      "token_start": 560,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 150150,
      "end_ms": 152030,
      "text": "学考古的管这个叫五都会，",
      "token_start": 567,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 152030,
      "end_ms": 158010,
      "text": "洛五座都城全部入选了中国百年百大考古发现。",
      "token_start": 578,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 158510,
      "end_ms": 159510,
      "text": "他站起身说，",
      "token_start": 598,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 159950,
      "end_ms": 166329,
      "text": "我在欧洲研究了三十年古城巴比伦现在是一片土丘，",
      "token_start": 603,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 166850,
      "end_ms": 169270,
      "text": "比比斯现在是个村子。",
      "token_start": 625,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 169730,
      "end_ms": 171310,
      "text": "罗马被攻陷之后，",
      "token_start": 634,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 171730,
      "end_ms": 174470,
      "text": "再也没能回到帝国首都的位置上。",
      "token_start": 641,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 174630,
      "end_ms": 176450,
      "text": "一座都城衰落之后，",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 176470,
      "end_ms": 178850,
      "text": "还能在原址重新爬起来的，",
      "token_start": 663,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 178850,
      "end_ms": 180760,
      "text": "全世界的被我找不出。",
      "token_start": 674,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 180760,
      "end_ms": 181225,
      "text": "第二个，",
      "token_start": 683,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 181860,
      "end_ms": 184060,
      "text": "而你们这座城灭了，",
      "token_start": 686,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 184060,
      "end_ms": 184535,
      "text": "再见。",
      "token_start": 694,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 184970,
      "end_ms": 186690,
      "text": "见了再面灭了，",
      "token_start": 696,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 186690,
      "end_ms": 194325,
      "text": "接着见十三个王朝一千五百多年都城市别的国家是保住了一座遗址。",
      "token_start": 702,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 194800,
      "end_ms": 197725,
      "text": "你们是在一个盆地里罗了一罗都城，",
      "token_start": 731,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 198160,
      "end_ms": 200765,
      "text": "全世界的古都都死在原址上，",
      "token_start": 746,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 201190,
      "end_ms": 203655,
      "text": "只有洛阳在原址上反复复活。",
      "token_start": 758,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 204130,
      "end_ms": 204675,
      "text": "第二天，",
      "token_start": 770,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 205050,
      "end_ms": 207075,
      "text": "他非要去看二里头。",
      "token_start": 773,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 207400,
      "end_ms": 208800,
      "text": "在夏都遗址博物馆，",
      "token_start": 781,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 208820,
      "end_ms": 211545,
      "text": "他站在那件汝丁文铜爵前面，",
      "token_start": 789,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 212340,
      "end_ms": 213165,
      "text": "突然又问我，",
      "token_start": 801,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 213540,
      "end_ms": 218495,
      "text": "你知道中国人为什么三千年前非要往这片盆地里建都吗？",
      "token_start": 806,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 219340,
      "end_ms": 220425,
      "text": "我说位置好啊，",
      "token_start": 830,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 221740,
      "end_ms": 223015,
      "text": "中原富庶，",
      "token_start": 836,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 223510,
      "end_ms": 224455,
      "text": "天下粮仓。",
      "token_start": 840,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 224720,
      "end_ms": 226430,
      "text": "他摇头说，",
      "token_start": 844,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 226430,
      "end_ms": 228945,
      "text": "你们总是用经济解释一切。",
      "token_start": 848,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 229710,
      "end_ms": 230050,
      "text": "他说，",
      "token_start": 859,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 230050,
      "end_ms": 232950,
      "text": "欧洲人选都城的逻辑是港口，",
      "token_start": 861,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 233130,
      "end_ms": 233895,
      "text": "是贸易，",
      "token_start": 873,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 234220,
      "end_ms": 234965,
      "text": "是军事。",
      "token_start": 876,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 236270,
      "end_ms": 238030,
      "text": "雅典对着海罗马，",
      "token_start": 879,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 238030,
      "end_ms": 240665,
      "text": "卡着河道伦敦守着入海口，",
      "token_start": 886,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 240950,
      "end_ms": 245635,
      "text": "但你们的祖宗不是你们的祖宗发明了另一个逻辑。",
      "token_start": 897,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 245880,
      "end_ms": 247940,
      "text": "叫泽中三千年前，",
      "token_start": 918,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 248220,
      "end_ms": 250775,
      "text": "周公在这里用龟表测日影，",
      "token_start": 925,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 251220,
      "end_ms": 253485,
      "text": "测出这里是天下的正中间，",
      "token_start": 936,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 254140,
      "end_ms": 256550,
      "text": "四方诸侯来进贡路程，",
      "token_start": 947,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 256550,
      "end_ms": 257925,
      "text": "远近差不多均等。",
      "token_start": 956,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 258300,
      "end_ms": 259965,
      "text": "所以把新都建在这里，",
      "token_start": 963,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 260620,
      "end_ms": 264605,
      "text": "他指着掌柜里何尊铭文的他骗说，",
      "token_start": 972,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 265040,
      "end_ms": 269820,
      "text": "你知道中国这两个字最早出现在哪吗？",
      "token_start": 986,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 270060,
      "end_ms": 275670,
      "text": "就这尊青铜器上一百二十二字的铭文宅资中国，",
      "token_start": 1002,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 276050,
      "end_ms": 278715,
      "text": "我要住在天下的中央。",
      "token_start": 1022,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 279500,
      "end_ms": 281745,
      "text": "中国这个词诞生的时候，",
      "token_start": 1031,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 282130,
      "end_ms": 283630,
      "text": "指的不是整个国家，",
      "token_start": 1041,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 283750,
      "end_ms": 285750,
      "text": "就是脚下这片盆地，",
      "token_start": 1049,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 286030,
      "end_ms": 286945,
      "text": "就是洛阳。",
      "token_start": 1057,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 287420,
      "end_ms": 290180,
      "text": "然后他说了一段让我头皮发麻的话，",
      "token_start": 1061,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 290580,
      "end_ms": 292760,
      "text": "我们欧洲人打了两千年仗，",
      "token_start": 1076,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 293180,
      "end_ms": 294660,
      "text": "画了无数张地图，",
      "token_start": 1087,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 295080,
      "end_ms": 297460,
      "text": "到今天都没想明白一件事。",
      "token_start": 1094,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 297520,
      "end_ms": 300350,
      "text": "一个文明的心脏可以不靠海，",
      "token_start": 1105,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 300490,
      "end_ms": 301165,
      "text": "不靠边，",
      "token_start": 1117,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 301470,
      "end_ms": 302885,
      "text": "不卡任何伤路。",
      "token_start": 1120,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 303650,
      "end_ms": 306590,
      "text": "就因为他在中间你们的祖宗，",
      "token_start": 1126,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 306930,
      "end_ms": 308090,
      "text": "用一个中字，",
      "token_start": 1138,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 308870,
      "end_ms": 311510,
      "text": "给一个文明定了三千年的位。",
      "token_start": 1143,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 312370,
      "end_ms": 314730,
      "text": "今天你们的国家还叫中国，",
      "token_start": 1155,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 315290,
      "end_ms": 320350,
      "text": "而你们脚下这块地是这个名字最初落地的地方，",
      "token_start": 1166,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 320390,
      "end_ms": 323650,
      "text": "全世界的都城都是经济和军事的产物。",
      "token_start": 1186,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 324150,
      "end_ms": 327410,
      "text": "只有这个文明给都城发明了一个理由，",
      "token_start": 1202,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 327770,
      "end_ms": 328670,
      "text": "叫居中。",
      "token_start": 1218,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 329570,
      "end_ms": 330290,
      "text": "第三天，",
      "token_start": 1221,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 330510,
      "end_ms": 334220,
      "text": "我们去了汉卫洛阳城遗址那座城，",
      "token_start": 1224,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 334520,
      "end_ms": 336120,
      "text": "当年一百平方公里，",
      "token_start": 1238,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 336260,
      "end_ms": 338700,
      "text": "是当时全世界最大的都市。",
      "token_start": 1246,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 339640,
      "end_ms": 343900,
      "text": "北魏孝文帝把一个游牧王朝的都城迁到这里，",
      "token_start": 1257,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 344080,
      "end_ms": 346120,
      "text": "下诏全国改汉姓，",
      "token_start": 1276,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 346780,
      "end_ms": 347500,
      "text": "说汉话，",
      "token_start": 1283,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 347760,
      "end_ms": 350020,
      "text": "穿汉服从皇帝，",
      "token_start": 1286,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 350040,
      "end_ms": 352520,
      "text": "开始把自己改成中原人。",
      "token_start": 1292,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 353060,
      "end_ms": 355340,
      "text": "后来这座城毁于战乱，",
      "token_start": 1302,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 355880,
      "end_ms": 358580,
      "text": "今天只剩下一望无际的夯土，",
      "token_start": 1311,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 358720,
      "end_ms": 360840,
      "text": "他在那片废墟上占了很久。",
      "token_start": 1323,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 361560,
      "end_ms": 362340,
      "text": "突然问我，",
      "token_start": 1334,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 363140,
      "end_ms": 367405,
      "text": "你们你知道司马光路过这里的时候写了一句什么吗？",
      "token_start": 1338,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 368380,
      "end_ms": 369195,
      "text": "我说不知道，",
      "token_start": 1360,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 370110,
      "end_ms": 373185,
      "text": "他说若问古今兴废事，",
      "token_start": 1365,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 373650,
      "end_ms": 375015,
      "text": "请君只看洛阳城。",
      "token_start": 1374,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 375370,
      "end_ms": 376065,
      "text": "然后他说，",
      "token_start": 1381,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 376440,
      "end_ms": 377965,
      "text": "你知道这句话狠在哪吗？",
      "token_start": 1385,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 378510,
      "end_ms": 379565,
      "text": "司马光的意思是，",
      "token_start": 1395,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 379880,
      "end_ms": 381755,
      "text": "想知道一个文明会不会断，",
      "token_start": 1402,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 382180,
      "end_ms": 384625,
      "text": "不用读史书来洛阳看就行。",
      "token_start": 1413,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 385250,
      "end_ms": 386690,
      "text": "这座城被烧过，",
      "token_start": 1424,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 386890,
      "end_ms": 387750,
      "text": "被淹过，",
      "token_start": 1430,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 387990,
      "end_ms": 388930,
      "text": "被抢过，",
      "token_start": 1433,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 389090,
      "end_ms": 390190,
      "text": "被废弃过，",
      "token_start": 1436,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 390370,
      "end_ms": 391485,
      "text": "塌了那么多次，",
      "token_start": 1440,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 391980,
      "end_ms": 395105,
      "text": "可隋朝建新都还是回到这个盆地，",
      "token_start": 1446,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 395850,
      "end_ms": 396615,
      "text": "为什么？",
      "token_start": 1460,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 397270,
      "end_ms": 398875,
      "text": "因为在中国的观念里，",
      "token_start": 1463,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 399140,
      "end_ms": 400705,
      "text": "这不是一块地产，",
      "token_start": 1472,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 401340,
      "end_ms": 404855,
      "text": "这是一个坐标城塌了可以重修，",
      "token_start": 1479,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 405580,
      "end_ms": 406715,
      "text": "坐标不能挪，",
      "token_start": 1492,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 407560,
      "end_ms": 409795,
      "text": "这不是一座城市的任性，",
      "token_start": 1497,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 410420,
      "end_ms": 413255,
      "text": "这是一个文明对自己来处的执念。",
      "token_start": 1507,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 414320,
      "end_ms": 416565,
      "text": "我站在汉卫故城的夯土上，",
      "token_start": 1521,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 417290,
      "end_ms": 418315,
      "text": "突然意识到，",
      "token_start": 1532,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 418850,
      "end_ms": 422315,
      "text": "洛阳真正的分量根本不在牡丹里，",
      "token_start": 1537,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 422990,
      "end_ms": 424215,
      "text": "也不在石窟里。",
      "token_start": 1551,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 424710,
      "end_ms": 426030,
      "text": "而在这片盆地，",
      "token_start": 1557,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 426170,
      "end_ms": 430435,
      "text": "一次次从废墟里原地长出新都城的执念里，",
      "token_start": 1563,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 430990,
      "end_ms": 432610,
      "text": "别的城市怕衰落。",
      "token_start": 1581,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 432710,
      "end_ms": 434125,
      "text": "洛阳的地基里，",
      "token_start": 1588,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 434450,
      "end_ms": 435785,
      "text": "罗着一落盛世，",
      "token_start": 1594,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 436160,
      "end_ms": 436780,
      "text": "回来之后，",
      "token_start": 1600,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 436780,
      "end_ms": 437960,
      "text": "我怎么也放不下。",
      "token_start": 1604,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 438340,
      "end_ms": 439140,
      "text": "搜了一圈，",
      "token_start": 1611,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 439640,
      "end_ms": 441425,
      "text": "发现讲洛阳的文章，",
      "token_start": 1615,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 441740,
      "end_ms": 442600,
      "text": "要么讲牡丹，",
      "token_start": 1623,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 442880,
      "end_ms": 444405,
      "text": "要么讲汉服打卡，",
      "token_start": 1628,
      "token_end_exclusive": 1635
    },
    {
      "start_ms": 444980,
      "end_ms": 447175,
      "text": "要么教你怎么点水席，",
      "token_start": 1635,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 447870,
      "end_ms": 451785,
      "text": "几乎没有人讲武都贿赂这个人类文明史上的孤立。",
      "token_start": 1644,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 452310,
      "end_ms": 453110,
      "text": "更没人讲，",
      "token_start": 1665,
      "token_end_exclusive": 1669
    },
    {
      "start_ms": 453130,
      "end_ms": 454100,
      "text": "中国这两个字，",
      "token_start": 1669,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 454680,
      "end_ms": 457295,
      "text": "最初就是为这片盆地写下的。",
      "token_start": 1675,
      "token_end_exclusive": 1687
    },
    {
      "start_ms": 457940,
      "end_ms": 461425,
      "text": "后来翻到那套书中国历史名城，",
      "token_start": 1687,
      "token_end_exclusive": 1700
    },
    {
      "start_ms": 461790,
      "end_ms": 467885,
      "text": "中央民族大学出版社符号中国系列搬到洛阳那一部分一口气读完。",
      "token_start": 1700,
      "token_end_exclusive": 1728
    },
    {
      "start_ms": 468350,
      "end_ms": 471055,
      "text": "他不是把洛阳当一个旅游城市来写，",
      "token_start": 1728,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 471540,
      "end_ms": 472475,
      "text": "他掰开了桨，",
      "token_start": 1743,
      "token_end_exclusive": 1748
    },
    {
      "start_ms": 473020,
      "end_ms": 476225,
      "text": "为什么夏商周非要挤在这条河的两边？",
      "token_start": 1748,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 476780,
      "end_ms": 479265,
      "text": "为什么周公要在这里立表恻隐？",
      "token_start": 1764,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 479880,
      "end_ms": 480380,
      "text": "为什么？",
      "token_start": 1777,
      "token_end_exclusive": 1780
    },
    {
      "start_ms": 480380,
      "end_ms": 482700,
      "text": "十三朝塌了又见见了，",
      "token_start": 1780,
      "token_end_exclusive": 1789
    },
    {
      "start_ms": 482700,
      "end_ms": 487635,
      "text": "又他为什么中国之民从这片盆地走向九州，",
      "token_start": 1789,
      "token_end_exclusive": 1807
    },
    {
      "start_ms": 488200,
      "end_ms": 491435,
      "text": "每一座老城翻开都是一句话，",
      "token_start": 1807,
      "token_end_exclusive": 1819
    },
    {
      "start_ms": 491840,
      "end_ms": 494875,
      "text": "原来我们的祖宗敢想敢干到这个地步。",
      "token_start": 1819,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 495440,
      "end_ms": 496995,
      "text": "下次你要是去洛阳，",
      "token_start": 1835,
      "token_end_exclusive": 1843
    },
    {
      "start_ms": 497310,
      "end_ms": 499690,
      "text": "别光蹲在牡丹丛里拍照，",
      "token_start": 1843,
      "token_end_exclusive": 1853
    },
    {
      "start_ms": 499870,
      "end_ms": 501285,
      "text": "去漯河边上站一站，",
      "token_start": 1853,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 501590,
      "end_ms": 504955,
      "text": "往东西两头望一望三十公里，",
      "token_start": 1861,
      "token_end_exclusive": 1873
    },
    {
      "start_ms": 505330,
      "end_ms": 508495,
      "text": "五个王朝在土里排着队等你。",
      "token_start": 1873,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 509070,
      "end_ms": 511095,
      "text": "这座立了几千年的古都，",
      "token_start": 1885,
      "token_end_exclusive": 1895
    },
    {
      "start_ms": 511480,
      "end_ms": 513045,
      "text": "等的不是游客一聚，",
      "token_start": 1895,
      "token_end_exclusive": 1903
    },
    {
      "start_ms": 513300,
      "end_ms": 514045,
      "text": "也就那样。",
      "token_start": 1903,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 514490,
      "end_ms": 515010,
      "text": "等的是，",
      "token_start": 1907,
      "token_end_exclusive": 1910
    },
    {
      "start_ms": 515010,
      "end_ms": 517450,
      "text": "终于有个中国人站在漯河边上，",
      "token_start": 1910,
      "token_end_exclusive": 1923
    },
    {
      "start_ms": 517450,
      "end_ms": 517775,
      "text": "说，",
      "token_start": 1923,
      "token_end_exclusive": 1924
    },
    {
      "start_ms": 518210,
      "end_ms": 521210,
      "text": "我知道你是什么你是我们的祖宗。",
      "token_start": 1924,
      "token_end_exclusive": 1938
    },
    {
      "start_ms": 521270,
      "end_ms": 524510,
      "text": "三千年前跟这片土地达成的约定，",
      "token_start": 1938,
      "token_end_exclusive": 1952
    },
    {
      "start_ms": 524510,
      "end_ms": 527915,
      "text": "成可以塌文明的正脉不挪地方，",
      "token_start": 1952,
      "token_end_exclusive": 1965
    },
    {
      "start_ms": 528440,
      "end_ms": 529905,
      "text": "至今没有失约，",
      "token_start": 1965,
      "token_end_exclusive": 1971
    },
    {
      "start_ms": 530400,
      "end_ms": 531945,
      "text": "书放在橱窗了。",
      "token_start": 1971,
      "token_end_exclusive": 1977
    },
    {
      "start_ms": 532320,
      "end_ms": 538475,
