{
  "video_id": "v_29b87f19019347e7",
  "duration_s": 567.62069,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_29b87f19019347e7.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_29b87f19019347e7.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 4190,
      "text": "上集说到一九六零年，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 4230,
      "end_ms": 6610,
      "text": "四十二岁的程开甲留下一句，",
      "token_start": 9,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 6610,
      "end_ms": 8010,
      "text": "我要出趟远差，",
      "token_start": 21,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 8650,
      "end_ms": 11010,
      "text": "从学术界彻底消失了。",
      "token_start": 27,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 12350,
      "end_ms": 13110,
      "text": "三年后，",
      "token_start": 36,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 13450,
      "end_ms": 17490,
      "text": "他出现在了罗布泊那地方叫死亡之海。",
      "token_start": 39,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 18030,
      "end_ms": 19650,
      "text": "白天热的像蒸笼，",
      "token_start": 55,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 20190,
      "end_ms": 22410,
      "text": "地表温度能烤鸡蛋，",
      "token_start": 62,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 23030,
      "end_ms": 24630,
      "text": "晚上冷的像冰窖，",
      "token_start": 70,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 25070,
      "end_ms": 27150,
      "text": "裹着棉被还打哆嗦。",
      "token_start": 77,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 27950,
      "end_ms": 30000,
      "text": "裹的水是苦咸的正的，",
      "token_start": 85,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 30060,
      "end_ms": 30340,
      "text": "吃的，",
      "token_start": 94,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 30340,
      "end_ms": 32020,
      "text": "馒头里能嚼出沙子，",
      "token_start": 96,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 32420,
      "end_ms": 33820,
      "text": "没有先进计算机，",
      "token_start": 104,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 34040,
      "end_ms": 35560,
      "text": "没有现成参考资料，",
      "token_start": 111,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 35800,
      "end_ms": 39800,
      "text": "连一块像样的黑板都得自己往墙上装成开甲。",
      "token_start": 119,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 39800,
      "end_ms": 44420,
      "text": "就在这儿开始了中国第一颗原子弹的研制，",
      "token_start": 138,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 45180,
      "end_ms": 46740,
      "text": "他在家里装一块黑板，",
      "token_start": 156,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 47440,
      "end_ms": 50700,
      "text": "办公室装一块搬家的时候，",
      "token_start": 165,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 50700,
      "end_ms": 52800,
      "text": "专门留一面墙装黑板。",
      "token_start": 176,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 53280,
      "end_ms": 55780,
      "text": "这块黑板就是他的武器库，",
      "token_start": 185,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 56500,
      "end_ms": 60010,
      "text": "每一道粉笔演算都是在黑暗里摸下，",
      "token_start": 196,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 60050,
      "end_ms": 61210,
      "text": "像光明的脚印。",
      "token_start": 211,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 61590,
      "end_ms": 62235,
      "text": "很快，",
      "token_start": 217,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 62670,
      "end_ms": 65775,
      "text": "一个巨大的争论摆在了所有人面前。",
      "token_start": 219,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 66420,
      "end_ms": 69775,
      "text": "当时高层倾向于用飞机投掷，",
      "token_start": 234,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 70120,
      "end_ms": 71605,
      "text": "觉得更接近实战。",
      "token_start": 246,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 72330,
      "end_ms": 75345,
      "text": "但陈开甲在黑板上反复推演后，",
      "token_start": 253,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 75720,
      "end_ms": 76955,
      "text": "拍了桌子不行，",
      "token_start": 266,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 77380,
      "end_ms": 79165,
      "text": "必须用百米高塔爆炸。",
      "token_start": 272,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 80080,
      "end_ms": 81215,
      "text": "他的理由很简单，",
      "token_start": 281,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 82020,
      "end_ms": 84055,
      "text": "飞机投掷偏差太大，",
      "token_start": 288,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 84770,
      "end_ms": 86535,
      "text": "一旦数据采集失败，",
      "token_start": 296,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 87060,
      "end_ms": 87580,
      "text": "几年，",
      "token_start": 304,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 87680,
      "end_ms": 89045,
      "text": "心血全白费。",
      "token_start": 306,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 89890,
      "end_ms": 91045,
      "text": "国家这么穷，",
      "token_start": 311,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 91460,
      "end_ms": 93235,
      "text": "做一次试验不容易，",
      "token_start": 316,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 93590,
      "end_ms": 96030,
      "text": "每一个数据都得拿命去换，",
      "token_start": 324,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 96470,
      "end_ms": 98075,
      "text": "容不得半点闪失。",
      "token_start": 335,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 98830,
      "end_ms": 100585,
      "text": "争论最激烈的时候，",
      "token_start": 342,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 100880,
      "end_ms": 103855,
      "text": "他敢跟基地司令员当面拍桌子，",
      "token_start": 350,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 104650,
      "end_ms": 105575,
      "text": "有人劝他，",
      "token_start": 363,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 105930,
      "end_ms": 106945,
      "text": "领导都定了，",
      "token_start": 367,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 107490,
      "end_ms": 108190,
      "text": "你叫什么？",
      "token_start": 372,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 108190,
      "end_ms": 109715,
      "text": "真陈开甲说，",
      "token_start": 376,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 110800,
      "end_ms": 112905,
      "text": "我不管他是不是司令员，",
      "token_start": 381,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 113480,
      "end_ms": 115725,
      "text": "我只看他讲不讲科学，",
      "token_start": 391,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 116020,
      "end_ms": 119805,
      "text": "我是怕国家的事业在我手里出半分差错，",
      "token_start": 400,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 120720,
      "end_ms": 123370,
      "text": "最终高层采纳了他的方案。",
      "token_start": 417,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 123370,
      "end_ms": 124650,
      "text": "一百零二米高，",
      "token_start": 428,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 124650,
      "end_ms": 126675,
      "text": "铁塔爆炸。",
      "token_start": 434,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 128220,
      "end_ms": 129985,
      "text": "一九六四年十月十六日，",
      "token_start": 438,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 130410,
      "end_ms": 132985,
      "text": "罗布泊上空一声巨响，",
      "token_start": 448,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 133430,
      "end_ms": 135265,
      "text": "蘑菇云腾空而起。",
      "token_start": 457,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 135780,
      "end_ms": 137455,
      "text": "因为坚持了塔报方案，",
      "token_start": 464,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 138060,
      "end_ms": 144445,
      "text": "程开甲带队研制的一千七百多台测试仪器全部拿到了完整数据。",
      "token_start": 473,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 145070,
      "end_ms": 146375,
      "text": "这个成果有多牛？",
      "token_start": 500,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 147410,
      "end_ms": 150335,
      "text": "法国第一次核试验没拿到任何数据，",
      "token_start": 507,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 151280,
      "end_ms": 155510,
      "text": "美国、英国苏联第一次也只拿到很少一部分。",
      "token_start": 522,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 155510,
      "end_ms": 162255,
      "text": "而中国第一次就全部拿到了蘑菇云升起来的那一刻，",
      "token_start": 540,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 163120,
      "end_ms": 164595,
      "text": "所有人都在欢呼。",
      "token_start": 562,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 165610,
      "end_ms": 166685,
      "text": "陈开甲笑了，",
      "token_start": 569,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 167460,
      "end_ms": 169155,
      "text": "但他的脑子没停下来，",
      "token_start": 574,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 169980,
      "end_ms": 171255,
      "text": "气还没喘匀，",
      "token_start": 583,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 171830,
      "end_ms": 173825,
      "text": "他又扎进了清弹的研究里。",
      "token_start": 588,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 174700,
      "end_ms": 175365,
      "text": "说到这儿，",
      "token_start": 599,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 176140,
      "end_ms": 177695,
      "text": "我得给你讲个小插曲，",
      "token_start": 603,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 178540,
      "end_ms": 180955,
      "text": "你就知道这个人疯到什么程度。",
      "token_start": 612,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 182090,
      "end_ms": 184465,
      "text": "有一次在研究所食堂排队打饭，",
      "token_start": 625,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 185050,
      "end_ms": 186365,
      "text": "轮到城开甲了，",
      "token_start": 638,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 186790,
      "end_ms": 188895,
      "text": "他把饭票递进窗口，",
      "token_start": 644,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 189330,
      "end_ms": 192485,
      "text": "眼睛直勾勾盯着师傅手里的勺子，",
      "token_start": 652,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 192980,
      "end_ms": 194680,
      "text": "嘴里一本正经的说，",
      "token_start": 666,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 194800,
      "end_ms": 196045,
      "text": "我给你这个数据，",
      "token_start": 674,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 196470,
      "end_ms": 197525,
      "text": "你验算一下。",
      "token_start": 681,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 198080,
      "end_ms": 200285,
      "text": "食堂师傅拿着饭票愣在那儿，",
      "token_start": 686,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 200560,
      "end_ms": 204375,
      "text": "一脸蒙圈儿排在后面的邓稼先实在忍不住了，",
      "token_start": 698,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 204690,
      "end_ms": 206125,
      "text": "扑哧一声笑出来，",
      "token_start": 717,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 206460,
      "end_ms": 207805,
      "text": "拍着他的肩膀说，",
      "token_start": 724,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 208730,
      "end_ms": 212790,
      "text": "老城这儿是食堂程开甲，",
      "token_start": 731,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 212850,
      "end_ms": 214275,
      "text": "这才如梦初醒，",
      "token_start": 741,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 214630,
      "end_ms": 216465,
      "text": "不好意思的挠头道歉，",
      "token_start": 747,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 217450,
      "end_ms": 218575,
      "text": "这不是段子，",
      "token_start": 756,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 219420,
      "end_ms": 220375,
      "text": "这是真事儿，",
      "token_start": 761,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 221490,
      "end_ms": 224025,
      "text": "一个把自己活成了数据的人，",
      "token_start": 766,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 224570,
      "end_ms": 225625,
      "text": "你说他疯不疯？",
      "token_start": 778,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 226370,
      "end_ms": 230700,
      "text": "但真正让所有人红了眼眶的是另一件事。",
      "token_start": 784,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 230840,
      "end_ms": 233545,
      "text": "一次地下河试验爆炸成功后，",
      "token_start": 801,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 234050,
      "end_ms": 236190,
      "text": "众人欢呼雀跃的时候，",
      "token_start": 813,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 236430,
      "end_ms": 240345,
      "text": "程开甲做了一个让所有人都吓傻的决定，",
      "token_start": 822,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 240900,
      "end_ms": 244225,
      "text": "他要亲自钻进爆炸中心的坑道，",
      "token_start": 839,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 244690,
      "end_ms": 246115,
      "text": "收集第一手资料。",
      "token_start": 852,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 246650,
      "end_ms": 251685,
      "text": "那条坑道被核爆的冲击力挤压到直径不到八十厘米，",
      "token_start": 859,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 252220,
      "end_ms": 253195,
      "text": "刚报答完，",
      "token_start": 881,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 253570,
      "end_ms": 258455,
      "text": "里面全是致命的放射性危害探测笔一直在响，",
      "token_start": 885,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 258920,
      "end_ms": 260145,
      "text": "警报声刺耳，",
      "token_start": 904,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 260510,
      "end_ms": 262895,
      "text": "而且坑道随时可能坍塌。",
      "token_start": 909,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 263700,
      "end_ms": 265195,
      "text": "身边的人都急了，",
      "token_start": 919,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 266310,
      "end_ms": 268720,
      "text": "手掌您不能去，",
      "token_start": 926,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 268860,
      "end_ms": 269695,
      "text": "太危险了。",
      "token_start": 932,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 269990,
      "end_ms": 272565,
      "text": "我们年轻人去陈凯甲一把拦住他们，",
      "token_start": 936,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 272890,
      "end_ms": 273935,
      "text": "只说了八个字，",
      "token_start": 951,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 274290,
      "end_ms": 276605,
      "text": "不入虎穴焉得虎子。",
      "token_start": 957,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 277580,
      "end_ms": 278000,
      "text": "说完，",
      "token_start": 965,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 278240,
      "end_ms": 279600,
      "text": "他穿上防护服，",
      "token_start": 967,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 279960,
      "end_ms": 283905,
      "text": "第一个钻进了那条不到八十厘米宽的坑道，",
      "token_start": 973,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 284520,
      "end_ms": 290855,
      "text": "在高温、高放射性随时可能坍塌的坑道里匍匐前进，",
      "token_start": 991,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 291250,
      "end_ms": 293130,
      "text": "一步一步爬向爆炸。",
      "token_start": 1012,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 293130,
      "end_ms": 295070,
      "text": "中心出来的时候，",
      "token_start": 1020,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 295210,
      "end_ms": 296370,
      "text": "他浑身是汗，",
      "token_start": 1027,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 296710,
      "end_ms": 298055,
      "text": "脸上全是灰。",
      "token_start": 1032,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 298680,
      "end_ms": 299695,
      "text": "警卫员问他，",
      "token_start": 1037,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 300680,
      "end_ms": 301385,
      "text": "首长，",
      "token_start": 1042,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 302230,
      "end_ms": 303145,
      "text": "您不怕吗？",
      "token_start": 1044,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 303470,
      "end_ms": 303775,
      "text": "嗯，",
      "token_start": 1048,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 304380,
      "end_ms": 305660,
      "text": "程铠甲淡定的说，",
      "token_start": 1049,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 305740,
      "end_ms": 306145,
      "text": "怕。",
      "token_start": 1056,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 308030,
      "end_ms": 311170,
      "text": "但我更怕祖国的试验有什么闪失？",
      "token_start": 1057,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 312370,
      "end_ms": 318570,
      "text": "这句话比任何豪言壮语都重在罗布泊的。",
      "token_start": 1071,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 318570,
      "end_ms": 319490,
      "text": "二十多年里，",
      "token_start": 1088,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 319990,
      "end_ms": 323450,
      "text": "程开甲参与主持了三十多次核试验，",
      "token_start": 1093,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 323990,
      "end_ms": 325710,
      "text": "从原子弹到氢弹，",
      "token_start": 1108,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 326090,
      "end_ms": 328890,
      "text": "从地面爆炸到地下数井。",
      "token_start": 1115,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 329330,
      "end_ms": 331170,
      "text": "每一次都很成功，",
      "token_start": 1125,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 331810,
      "end_ms": 333790,
      "text": "他被称为中国核试令，",
      "token_start": 1132,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 334050,
      "end_ms": 337655,
      "text": "是中国参与核试验次数最多的科学家。",
      "token_start": 1141,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 338280,
      "end_ms": 339120,
      "text": "可你知道吗？",
      "token_start": 1157,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 339920,
      "end_ms": 341220,
      "text": "这二十多年里，",
      "token_start": 1162,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 341740,
      "end_ms": 345960,
      "text": "他把生活的重担全留给了妻子高耀山。",
      "token_start": 1168,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 346880,
      "end_ms": 349660,
      "text": "他穿着带补丁的旧军衣，",
      "token_start": 1184,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 349800,
      "end_ms": 353200,
      "text": "扛着铁锹和家属们一起开荒种地，",
      "token_start": 1194,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 353440,
      "end_ms": 355880,
      "text": "种萝卜、土豆、大白菜，",
      "token_start": 1208,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 356240,
      "end_ms": 360440,
      "text": "把家里的事儿全包了让程开甲一门心思搞实验，",
      "token_start": 1216,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 360900,
      "end_ms": 362760,
      "text": "而他满脑子都是数据，",
      "token_start": 1236,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 363220,
      "end_ms": 366960,
      "text": "连妻子什么时候白了头都没注意到。",
      "token_start": 1245,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 367420,
      "end_ms": 368945,
      "text": "直到一九九九年，",
      "token_start": 1260,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 369260,
      "end_ms": 374155,
      "text": "国家授予二十三名科学家两弹一星功勋奖章，",
      "token_start": 1267,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 374570,
      "end_ms": 377455,
      "text": "隐姓埋名四十年的陈开家，",
      "token_start": 1286,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 378090,
      "end_ms": 381375,
      "text": "这个名字才重新出现在公众面前。",
      "token_start": 1297,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 382250,
      "end_ms": 383465,
      "text": "人们这才知道，",
      "token_start": 1311,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 384300,
      "end_ms": 386555,
      "text": "这位满头白发的老人，",
      "token_start": 1317,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 386930,
      "end_ms": 391430,
      "text": "是中国唯一一位及其六大最高荣誉的科学家。",
      "token_start": 1326,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 391590,
      "end_ms": 400905,
      "text": "中国科学院院士、两弹一星功勋奖章、国家最高科学技术奖八一勋章改革先锋称号，",
      "token_start": 1345,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 401550,
      "end_ms": 404940,
      "text": "人民科学家、国家荣誉称号六大荣誉，",
      "token_start": 1379,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 405180,
      "end_ms": 406725,
      "text": "给予一人之身，",
      "token_start": 1394,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 407210,
      "end_ms": 408155,
      "text": "前无古人。",
      "token_start": 1400,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 409470,
      "end_ms": 411495,
      "text": "二零一八年十一月十七日，",
      "token_start": 1404,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 412220,
      "end_ms": 413260,
      "text": "程凯甲病逝，",
      "token_start": 1415,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 413560,
      "end_ms": 415015,
      "text": "享年一百零一岁。",
      "token_start": 1420,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 415900,
      "end_ms": 416935,
      "text": "他来的时候，",
      "token_start": 1427,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 417570,
      "end_ms": 419095,
      "text": "中国山河破碎，",
      "token_start": 1432,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 420090,
      "end_ms": 421155,
      "text": "被人看不起。",
      "token_start": 1438,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 422420,
      "end_ms": 423605,
      "text": "他走的时候，",
      "token_start": 1443,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 424070,
      "end_ms": 425330,
      "text": "中国国富民强，",
      "token_start": 1448,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 425690,
      "end_ms": 427925,
      "text": "再也没人敢随便欺负。",
      "token_start": 1454,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 428520,
      "end_ms": 428940,
      "text": "程老。",
      "token_start": 1463,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 428940,
      "end_ms": 430160,
      "text": "生前说过一句话，",
      "token_start": 1465,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 430220,
      "end_ms": 437935,
      "text": "我这辈子最大的幸福就是自己所做的一切都和祖国紧紧的联系在一起。",
      "token_start": 1472,
      "token_end_exclusive": 1502
    },
    {
      "start_ms": 438770,
      "end_ms": 440390,
      "text": "他本可以留在英国，",
      "token_start": 1502,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 440730,
      "end_ms": 441630,
      "text": "穿着西装，",
      "token_start": 1510,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 441870,
      "end_ms": 444735,
      "text": "喝着咖啡走学术的坦途，",
      "token_start": 1514,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 445350,
      "end_ms": 447955,
      "text": "但他选择了在大漠里喝风吃沙，",
      "token_start": 1524,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 448370,
      "end_ms": 450115,
      "text": "隐姓埋名四十年。",
      "token_start": 1537,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 450610,
      "end_ms": 454525,
      "text": "他本可以名扬四海享受鲜花和掌声，",
      "token_start": 1544,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 455070,
      "end_ms": 457395,
      "text": "但他选择了把名字埋进黄沙，",
      "token_start": 1559,
      "token_end_exclusive": 1571
    },
    {
      "start_ms": 457880,
      "end_ms": 460065,
      "text": "连家人都不知道他在干什么。",
      "token_start": 1571,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 460820,
      "end_ms": 461715,
      "text": "有人说他傻，",
      "token_start": 1583,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 462250,
      "end_ms": 463495,
      "text": "可正是这种傻，",
      "token_start": 1588,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 464010,
      "end_ms": 466310,
      "text": "撑起了我们今天的腰杆子。",
      "token_start": 1594,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 466450,
      "end_ms": 469930,
      "text": "我们今天能安安稳稳坐在家里看手机，",
      "token_start": 1605,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 470290,
      "end_ms": 471855,
      "text": "吃饭睡觉，",
      "token_start": 1621,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 472340,
      "end_ms": 473820,
      "text": "不用看别人脸色，",
      "token_start": 1625,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 474100,
      "end_ms": 476955,
      "text": "不用怕别人的军舰开到家门口，",
      "token_start": 1632,
      "token_end_exclusive": 1645
    },
    {
      "start_ms": 477310,
      "end_ms": 482145,
      "text": "有多少是程开甲和他的战友们拿命换来的。",
      "token_start": 1645,
      "token_end_exclusive": 1663
    },
    {
      "start_ms": 482370,
      "end_ms": 483365,
      "text": "记住这个名字，",
      "token_start": 1663,
      "token_end_exclusive": 1669
    },
    {
      "start_ms": 484890,
      "end_ms": 485665,
      "text": "程开甲，",
      "token_start": 1669,
      "token_end_exclusive": 1672
    },
    {
      "start_ms": 487170,
      "end_ms": 490225,
      "text": "中国核司令共和国的脊梁。",
      "token_start": 1672,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 491180,
      "end_ms": 491800,
      "text": "说到这儿，",
      "token_start": 1683,
      "token_end_exclusive": 1687
    },
    {
      "start_ms": 491800,
      "end_ms": 492965,
      "text": "我想多说一句，",
      "token_start": 1687,
      "token_end_exclusive": 1693
    },
    {
      "start_ms": 493400,
      "end_ms": 497485,
      "text": "程开甲只是千千万万国事中的一个，",
      "token_start": 1693,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 498020,
      "end_ms": 500705,
      "text": "那些把名字埋进黄沙，",
      "token_start": 1708,
      "token_end_exclusive": 1717
    },
    {
      "start_ms": 501170,
      "end_ms": 503255,
      "text": "拿命换国家安定的人。",
      "token_start": 1717,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 503660,
      "end_ms": 506290,
      "text": "他们的故事真的不该被遗忘。",
      "token_start": 1726,
      "token_end_exclusive": 1738
    },
    {
      "start_ms": 506410,
      "end_ms": 514035,
      "text": "这套国之脊梁里面写了包括程开甲在内的四十多位中国科学家的真实人生。",
      "token_start": 1738,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 514940,
      "end_ms": 517545,
      "text": "不是那种喊口号的人物简介，",
      "token_start": 1770,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 517950,
      "end_ms": 524125,
      "text": "是真的把他们受的苦冒的险做的选择一装一件写出来了。",
      "token_start": 1782,
      "token_end_exclusive": 1806
    },
    {
      "start_ms": 525060,
      "end_ms": 526060,
      "text": "我自己看的时候，",
      "token_start": 1806,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 526060,
      "end_ms": 527625,
      "text": "好几次没忍住眼泪，",
      "token_start": 1813,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 527950,
      "end_ms": 530770,
      "text": "尤其是家里有孩子的真，",
      "token_start": 1821,
      "token_end_exclusive": 1831
    },
    {
      "start_ms": 530770,
      "end_ms": 532025,
      "text": "该让孩子读读，",
      "token_start": 1831,
      "token_end_exclusive": 1837
    },
    {
      "start_ms": 532400,
      "end_ms": 533455,
      "text": "在大漠里，",
      "token_start": 1837,
      "token_end_exclusive": 1841
    },
    {
      "start_ms": 533890,
      "end_ms": 534825,
      "text": "在实验室里，",
      "token_start": 1841,
      "token_end_exclusive": 1846
    },
    {
      "start_ms": 535130,
      "end_ms": 538035,
      "text": "在生死线上拿命给我们铺路的人。",
      "token_start": 1846,
      "token_end_exclusive": 1860
    },
    {
      "start_ms": 538540,
      "end_ms": 541245,
      "text": "书就在视频左下角链接里，",
      "token_start": 1860,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 541790,
      "end_ms": 543430,
      "text": "感兴趣的朋友可以带回家，",
      "token_start": 1871,
      "token_end_exclusive": 1882
    },
    {
      "start_ms": 543610,
      "end_ms": 544510,
      "text": "细细品读。",
      "token_start": 1882,
      "token_end_exclusive": 1886
    },
    {
      "start_ms": 544750,
      "end_ms": 546955,
      "text": "如果你也被程老的故事打动了，",
      "token_start": 1886,
      "token_end_exclusive": 1899
    },
    {
      "start_ms": 547270,
      "end_ms": 548170,
      "text": "请点个赞，",
      "token_start": 1899,
      "token_end_exclusive": 1903
    },
    {
      "start_ms": 548350,
      "end_ms": 550765,
      "text": "把这条视频转发出去，",
      "token_start": 1903,
      "token_end_exclusive": 1912
    },
    {
      "start_ms": 551160,
      "end_ms": 555260,
      "text": "让更多人知道谁才是我们最该追的星。",
      "token_start": 1912,
      "token_end_exclusive": 1928
    },
    {
      "start_ms": 555440,
      "end_ms": 556420,
      "text": "评论区告诉我，",
      "token_start": 1928,
      "token_end_exclusive": 1934
    },
    {
      "start_ms": 556680,
      "end_ms": 559125,
      "text": "程老的哪个瞬间最戳你的心？",
      "token_start": 1934,
      "token_end_exclusive": 1946
    },
    {
      "start_ms": 559490,
      "end_ms": 560330,
      "text": "收藏起来，",
      "token_start": 1946,
      "token_end_exclusive": 1950
    },
    {
      "start_ms": 560510,
      "end_ms": 561430,
      "text": "讲给你的孩子，",
      "token_start": 1950,
      "token_end_exclusive": 1956
    },
    {
      "start_ms": 561430,
      "end_ms": 563315,
      "text": "听关注我。",
      "token_start": 1956,
      "token_end_exclusive": 1960
    },
    {
      "start_ms": 563690,
      "end_ms": 565170,
      "text": "下一期继续讲，",
      "token_start": 1960,
      "token_end_exclusive": 1966
    },
    {
      "start_ms": 565170,
      "end_ms": 567455,
      "text": "那些不该被遗忘的国事。",
      "token_start": 1966,
      "token_end_exclusive": 1976
    }
  ],
