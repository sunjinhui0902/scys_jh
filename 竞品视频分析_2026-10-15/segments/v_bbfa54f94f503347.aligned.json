{
  "video_id": "v_bbfa54f94f503347",
  "duration_s": 232.455011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_bbfa54f94f503347.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_bbfa54f94f503347.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 340,
      "end_ms": 780,
      "text": "朱军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1180,
      "end_ms": 2080,
      "text": "你能想象吗？",
      "token_start": 2,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2440,
      "end_ms": 4180,
      "text": "我把南京的大房子卖了，",
      "token_start": 7,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4300,
      "end_ms": 6880,
      "text": "一家人蜗居在香港的小出租屋里，",
      "token_start": 17,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 7220,
      "end_ms": 9080,
      "text": "这样的生活你愿意吗？",
      "token_start": 31,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 9980,
      "end_ms": 13220,
      "text": "我儿子两岁半开始在香港念幼儿园了，",
      "token_start": 40,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 13440,
      "end_ms": 15920,
      "text": "第一天送他去学校的时候特别紧张，",
      "token_start": 56,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 16219,
      "end_ms": 17040,
      "text": "我怕他哭，",
      "token_start": 71,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 17460,
      "end_ms": 18240,
      "text": "怕他听不懂，",
      "token_start": 75,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 18780,
      "end_ms": 20460,
      "text": "甚至怕自己作为一个父亲，",
      "token_start": 80,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 20660,
      "end_ms": 23440,
      "text": "是不是替一个两岁孩子做了一个太大的决定，",
      "token_start": 91,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 24000,
      "end_ms": 25900,
      "text": "结果没想到他比我勇敢。",
      "token_start": 110,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 26260,
      "end_ms": 29100,
      "text": "我儿子很快就适应香港的幼儿园，",
      "token_start": 120,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 29100,
      "end_ms": 29640,
      "text": "配了三组，",
      "token_start": 134,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 29640,
      "end_ms": 34090,
      "text": "老师是两文三语的教育、普通话、粤语和英语。",
      "token_start": 138,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 35050,
      "end_ms": 37750,
      "text": "我从小出生在淮安的农村家门口，",
      "token_start": 156,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 37750,
      "end_ms": 39050,
      "text": "就是京杭大运河。",
      "token_start": 170,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 39510,
      "end_ms": 40990,
      "text": "后来在我上小学的时候，",
      "token_start": 177,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 40990,
      "end_ms": 43110,
      "text": "父母把我带到了南京这座城市，",
      "token_start": 187,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 43410,
      "end_ms": 45090,
      "text": "把家搬到了长江边。",
      "token_start": 200,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 45630,
      "end_ms": 50290,
      "text": "现在我又牵着我儿子的手把他带到香港维多利亚港的海边。",
      "token_start": 208,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 50970,
      "end_ms": 52390,
      "text": "我们一个家庭的三代人，",
      "token_start": 233,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 52390,
      "end_ms": 56030,
      "text": "就这样一步一步沿着水走向更大的世界。",
      "token_start": 243,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 56610,
      "end_ms": 59030,
      "text": "我特别喜欢香港的国际化教育环境，",
      "token_start": 260,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 59330,
      "end_ms": 62655,
      "text": "我也越发理解人就是环境的产物。",
      "token_start": 275,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 63180,
      "end_ms": 64435,
      "text": "所谓孟母三迁，",
      "token_start": 289,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 64780,
      "end_ms": 66275,
      "text": "这既是对孩子的托举，",
      "token_start": 295,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 66650,
      "end_ms": 68205,
      "text": "也是对于我自己的成长。",
      "token_start": 304,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 68870,
      "end_ms": 69190,
      "text": "周军，",
      "token_start": 314,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 69190,
      "end_ms": 69950,
      "text": "你能想象吗？",
      "token_start": 316,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 70230,
      "end_ms": 71310,
      "text": "决定搬来香港，",
      "token_start": 321,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 71470,
      "end_ms": 72965,
      "text": "我只花了一天的时间。",
      "token_start": 327,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 73740,
      "end_ms": 75560,
      "text": "曾经有一位前辈跟我说过一段话，",
      "token_start": 336,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 75700,
      "end_ms": 78300,
      "text": "他说跳槽、结婚、换城市等等。",
      "token_start": 350,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 78300,
      "end_ms": 82285,
      "text": "这种人生大事没有一件是靠周密的计划完成了，",
      "token_start": 361,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 82530,
      "end_ms": 83970,
      "text": "都是机会来了，",
      "token_start": 381,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 84110,
      "end_ms": 85070,
      "text": "脑子一热就上，",
      "token_start": 387,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 85370,
      "end_ms": 87585,
      "text": "然后人生就拐了个弯儿。",
      "token_start": 393,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 88070,
      "end_ms": 89455,
      "text": "这句话我记了好多年。",
      "token_start": 403,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 89850,
      "end_ms": 92585,
      "text": "真正重要的事情是不给你时间准备的。",
      "token_start": 412,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 93540,
      "end_ms": 95220,
      "text": "还记得来香港租房子的时候，",
      "token_start": 428,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 95220,
      "end_ms": 96855,
      "text": "中介推荐了好多房源。",
      "token_start": 440,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 97200,
      "end_ms": 99575,
      "text": "我看到第一户就感觉很有缘分，",
      "token_start": 449,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 99920,
      "end_ms": 101340,
      "text": "特别喜欢窗外的海景。",
      "token_start": 462,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 101480,
      "end_ms": 103100,
      "text": "我说其他就不看了，",
      "token_start": 471,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 103280,
      "end_ms": 103965,
      "text": "就他了。",
      "token_start": 479,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 104680,
      "end_ms": 106060,
      "text": "虽然只有六十平米，",
      "token_start": 482,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 106060,
      "end_ms": 108425,
      "text": "但是每个月租金高达三万多块钱。",
      "token_start": 490,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 109170,
      "end_ms": 110130,
      "text": "寸土寸金，",
      "token_start": 504,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 110270,
      "end_ms": 111945,
      "text": "是香港最谦虚的说法。",
      "token_start": 508,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 112490,
      "end_ms": 114390,
      "text": "出门买菜买半棵，",
      "token_start": 517,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 114410,
      "end_ms": 116675,
      "text": "圆白菜竟然要花四十多块钱。",
      "token_start": 524,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 117240,
      "end_ms": 119475,
      "text": "但是香港的食品安全也很规范，",
      "token_start": 536,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 119860,
      "end_ms": 122965,
      "text": "在这里你永远不用担心吃到嘴里的东西不安全。",
      "token_start": 549,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 123350,
      "end_ms": 126505,
      "text": "超市里的每一颗蔬菜都能精准追溯到原产地。",
      "token_start": 569,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 127110,
      "end_ms": 130760,
      "text": "我儿子渐渐的喜欢上了香港下楼散步逛商场，",
      "token_start": 588,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 130900,
      "end_ms": 133605,
      "text": "总能看到很多人用推车推着小动物。",
      "token_start": 607,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 133980,
      "end_ms": 136715,
      "text": "香港街头很少见到流浪猫流浪狗，",
      "token_start": 622,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 137150,
      "end_ms": 140425,
      "text": "突然发现我最幸福的是就是有一个儿子，",
      "token_start": 636,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 140970,
      "end_ms": 141450,
      "text": "名利，",
      "token_start": 653,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 141530,
      "end_ms": 143455,
      "text": "金钱皆是过眼云烟。",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 143810,
      "end_ms": 145815,
      "text": "唯有这个朝气蓬勃的少年，",
      "token_start": 663,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 146190,
      "end_ms": 147365,
      "text": "是我满心的欢喜。",
      "token_start": 674,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 148140,
      "end_ms": 150345,
      "text": "儿子身上全是小时候我的影子，",
      "token_start": 681,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 150660,
      "end_ms": 151975,
      "text": "贪玩倔强，",
      "token_start": 694,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 152460,
      "end_ms": 154695,
      "text": "他不是我却又像极了我，",
      "token_start": 698,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 155220,
      "end_ms": 156200,
      "text": "我带他来香港，",
      "token_start": 708,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 156200,
      "end_ms": 160115,
      "text": "只是希望他的世界可以比我小时候大一点，",
      "token_start": 714,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 161210,
      "end_ms": 162530,
      "text": "特别感恩于这个时代。",
      "token_start": 732,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 162710,
      "end_ms": 163965,
      "text": "让我们做新媒体的人，",
      "token_start": 741,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 164220,
      "end_ms": 165305,
      "text": "只要有一台手机，",
      "token_start": 750,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 165550,
      "end_ms": 167010,
      "text": "我在任何地方都能工作，",
      "token_start": 757,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 167190,
      "end_ms": 168370,
      "text": "还能够陪伴家人。",
      "token_start": 767,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 168370,
      "end_ms": 169700,
      "text": "孩子说实话，",
      "token_start": 774,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 169700,
      "end_ms": 171855,
      "text": "我也不知道香港是不是最好的答案，",
      "token_start": 779,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 172120,
      "end_ms": 172760,
      "text": "但我知道，",
      "token_start": 794,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 172840,
      "end_ms": 173760,
      "text": "停在原地，",
      "token_start": 798,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 173840,
      "end_ms": 175035,
      "text": "一定不是我的答案。",
      "token_start": 802,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 175420,
      "end_ms": 177705,
      "text": "我很喜欢香港的城市风水格局。",
      "token_start": 810,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 178110,
      "end_ms": 178970,
      "text": "每次来到香港，",
      "token_start": 823,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 178970,
      "end_ms": 180405,
      "text": "整个人都好像充满了电。",
      "token_start": 829,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 180750,
      "end_ms": 184055,
      "text": "这里会让一些洗金水的人天然产生事业心。",
      "token_start": 839,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 184720,
      "end_ms": 186765,
      "text": "明年是香港回归祖国三十周年，",
      "token_start": 857,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 187100,
      "end_ms": 190885,
      "text": "我相信三十而立的香港会是他最好的黄金时代。",
      "token_start": 870,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 191370,
      "end_ms": 192375,
      "text": "今年国庆假期，",
      "token_start": 890,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 192690,
      "end_ms": 195095,
      "text": "维多利亚港会再次举行烟花汇演，",
      "token_start": 896,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 195530,
      "end_ms": 197150,
      "text": "我们将要度过第一个全家。",
      "token_start": 910,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 197150,
      "end_ms": 198505,
      "text": "在香港的中秋节，",
      "token_start": 921,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 198930,
      "end_ms": 201025,
      "text": "我儿子特别喜欢吃香港月饼。",
      "token_start": 928,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 201920,
      "end_ms": 203240,
      "text": "今天我在香港的地铁站，",
      "token_start": 940,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 203260,
      "end_ms": 203940,
      "text": "看到一句话，",
      "token_start": 950,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 204120,
      "end_ms": 204780,
      "text": "一瞬间，",
      "token_start": 955,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 204920,
      "end_ms": 206075,
      "text": "我竟然泪流满面，",
      "token_start": 958,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 206950,
      "end_ms": 208095,
      "text": "请往前走，",
      "token_start": 965,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 208480,
      "end_ms": 209835,
      "text": "不要在此停留。",
      "token_start": 969,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 210730,
      "end_ms": 213295,
      "text": "我不确定搬到香港最终会收获什么？",
      "token_start": 975,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 213570,
      "end_ms": 216765,
      "text": "但是我相信人只要卯足劲往前走，",
      "token_start": 990,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 216980,
      "end_ms": 219305,
      "text": "就一定有新的东西在前面等着，",
      "token_start": 1004,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 219860,
      "end_ms": 222995,
      "text": "甚至比那些错过的懊恼的还要好一万倍。",
      "token_start": 1017,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 223510,
      "end_ms": 226885,
      "text": "就像渔夫出海之前并不知道鱼在哪里，",
      "token_start": 1034,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 227250,
      "end_ms": 228905,
      "text": "可是他还是选择出发，",
      "token_start": 1050,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 229310,
      "end_ms": 232245,
      "text": "因为他们相信一定会满载而归。",
      "token_start": 1059,
      "token_end_exclusive": 1072
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
    "timestamp_starts_monotonic": true,
