  "segments": [
    {
      "start_ms": 110,
      "end_ms": 3330,
      "text": "养好孩子一定是你这一生最大的财富，",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3590,
      "end_ms": 5370,
      "text": "你这一辈子最值得骄傲的，",
      "token_start": 16,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 5430,
      "end_ms": 7870,
      "text": "从来都不是房子、车子、票子，",
      "token_start": 27,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 8109,
      "end_ms": 9490,
      "text": "这些都是身外之物。",
      "token_start": 38,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 9790,
      "end_ms": 15230,
      "text": "没有这个意气风发的翩翩少年才是上天赐予你最好的礼物。",
      "token_start": 46,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 15550,
      "end_ms": 16910,
      "text": "它是你血脉的延续，",
      "token_start": 71,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 17150,
      "end_ms": 18450,
      "text": "是你精神的寄托，",
      "token_start": 79,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 18830,
      "end_ms": 20070,
      "text": "是你生命的见证，",
      "token_start": 86,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 20330,
      "end_ms": 22830,
      "text": "更是照亮你人生的那束光。",
      "token_start": 93,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 23610,
      "end_ms": 24690,
      "text": "无论发生什么事情，",
      "token_start": 104,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 24690,
      "end_ms": 27930,
      "text": "都没有比养好孩子这件事更重要。",
      "token_start": 112,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 27930,
      "end_ms": 29310,
      "text": "不管你有钱没钱，",
      "token_start": 126,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 29310,
      "end_ms": 30760,
      "text": "永远心引导，",
      "token_start": 133,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 30920,
      "end_ms": 33460,
      "text": "全力托举问心无愧就好。",
      "token_start": 138,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 33700,
      "end_ms": 35360,
      "text": "因为就这么一个心头肉啊，",
      "token_start": 148,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 35460,
      "end_ms": 36960,
      "text": "你就是最富有的人。",
      "token_start": 159,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 37600,
      "end_ms": 39460,
      "text": "愿你的孩子岁月兼安，",
      "token_start": 167,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 39880,
      "end_ms": 40840,
      "text": "喜乐常伴，",
      "token_start": 176,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 41200,
      "end_ms": 41620,
      "text": "福运，",
      "token_start": 180,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 41660,
      "end_ms": 44675,
      "text": "长达人生繁华。",
      "token_start": 182,
      "token_end_exclusive": 188
    }
  ],
