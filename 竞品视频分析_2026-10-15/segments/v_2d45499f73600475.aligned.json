{
  "video_id": "v_2d45499f73600475",
  "duration_s": 285.370998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_2d45499f73600475.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_2d45499f73600475.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 1170,
      "text": "从今天开始，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1450,
      "end_ms": 3410,
      "text": "玲玲就是我们销售部的经理，",
      "token_start": 5,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 3710,
      "end_ms": 4310,
      "text": "大家鼓掌。",
      "token_start": 17,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 4310,
      "end_ms": 11640,
      "text": "祝贺王姐，",
      "token_start": 21,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 12020,
      "end_ms": 13240,
      "text": "凭什么玲玲能当经理？",
      "token_start": 25,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 13240,
      "end_ms": 14280,
      "text": "我不能我俩。",
      "token_start": 34,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 14280,
      "end_ms": 15460,
      "text": "可是同时进公司的，",
      "token_start": 39,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 15700,
      "end_ms": 16920,
      "text": "我每天来的比他早，",
      "token_start": 47,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 16920,
      "end_ms": 17680,
      "text": "走的比他晚，",
      "token_start": 55,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 17980,
      "end_ms": 20480,
      "text": "为什么这个位置不能让我来坐小张啊？",
      "token_start": 60,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 20660,
      "end_ms": 22460,
      "text": "你平时的努力大家都看得到，",
      "token_start": 76,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 22680,
      "end_ms": 25080,
      "text": "但是工作可不是光靠勤奋就能做好的。",
      "token_start": 88,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 25160,
      "end_ms": 26340,
      "text": "正好今天有个酒局，",
      "token_start": 104,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 26480,
      "end_ms": 28740,
      "text": "我叫上玲玲一起去参加怎么样？",
      "token_start": 112,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 29020,
      "end_ms": 29820,
      "text": "今晚有空吗？",
      "token_start": 125,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 30120,
      "end_ms": 30540,
      "text": "有空，",
      "token_start": 130,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 30800,
      "end_ms": 31260,
      "text": "哎呀，",
      "token_start": 132,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 31340,
      "end_ms": 32500,
      "text": "这肯定迟到了呀，",
      "token_start": 134,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 32640,
      "end_ms": 34240,
      "text": "今天这场商务洽谈很重要，",
      "token_start": 141,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 34660,
      "end_ms": 35980,
      "text": "去晚了可咋办呀？",
      "token_start": 152,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 36260,
      "end_ms": 39240,
      "text": "急什么合作方那边能够理解路况，",
      "token_start": 159,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 39240,
      "end_ms": 41690,
      "text": "堵车的没关系，",
      "token_start": 173,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 42230,
      "end_ms": 43790,
      "text": "兵来将挡水来土掩，",
      "token_start": 179,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 43990,
      "end_ms": 45210,
      "text": "有王姐在怕啥？",
      "token_start": 187,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 46190,
      "end_ms": 49310,
      "text": "今天我当个观众能不能拿下这笔大业务，",
      "token_start": 193,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 49330,
      "end_ms": 53080,
      "text": "就看你俩的表现了哟。",
      "token_start": 210,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 53500,
      "end_ms": 55280,
      "text": "来这么晚只能吃剩饭了吧。",
      "token_start": 219,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 55560,
      "end_ms": 56000,
      "text": "王总，",
      "token_start": 230,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 56340,
      "end_ms": 57240,
      "text": "真不好意思，",
      "token_start": 232,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 57480,
      "end_ms": 58480,
      "text": "路上太堵了。",
      "token_start": 237,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 58480,
      "end_ms": 59640,
      "text": "我们哎呀，",
      "token_start": 242,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 59640,
      "end_ms": 60970,
      "text": "王总饭在哪儿？",
      "token_start": 246,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 60970,
      "end_ms": 61705,
      "text": "我们都能吃，",
      "token_start": 252,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 62060,
      "end_ms": 64060,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 257,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 64140,
      "end_ms": 65964,
      "text": "能赶上已经是我们的运气了。",
      "token_start": 270,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 66310,
      "end_ms": 67510,
      "text": "哈哈哈哈哈哈，",
      "token_start": 282,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 68550,
      "end_ms": 69450,
      "text": "赶紧坐吧，",
      "token_start": 288,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 69590,
      "end_ms": 70550,
      "text": "位置都给你们留。",
      "token_start": 292,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 70550,
      "end_ms": 71175,
      "text": "好了，",
      "token_start": 299,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 72470,
      "end_ms": 73130,
      "text": "各位领导，",
      "token_start": 301,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 73350,
      "end_ms": 73970,
      "text": "不好意思，",
      "token_start": 305,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 73970,
      "end_ms": 74730,
      "text": "今天迟到了，",
      "token_start": 309,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 74730,
      "end_ms": 76635,
      "text": "我们给大家敬一个来小张，",
      "token_start": 314,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 76940,
      "end_ms": 77925,
      "text": "你来起个头吧，",
      "token_start": 325,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 80840,
      "end_ms": 81660,
      "text": "大家吃好喝。",
      "token_start": 331,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 81660,
      "end_ms": 82015,
      "text": "好，",
      "token_start": 336,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 82370,
      "end_ms": 84145,
      "text": "我干了领导们随意，",
      "token_start": 337,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 86470,
      "end_ms": 87170,
      "text": "这就完了。",
      "token_start": 345,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 87430,
      "end_ms": 87670,
      "text": "嗯，",
      "token_start": 349,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 87910,
      "end_ms": 88505,
      "text": "完了，",
      "token_start": 350,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 88840,
      "end_ms": 89145,
      "text": "哎，",
      "token_start": 352,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 90760,
      "end_ms": 91285,
      "text": "来琳琳，",
      "token_start": 353,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 91610,
      "end_ms": 94625,
      "text": "你也给大家敬一个这俗话说，",
      "token_start": 356,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 95090,
      "end_ms": 95890,
      "text": "跟着领导走，",
      "token_start": 368,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 95910,
      "end_ms": 96610,
      "text": "吃喝啥都有，",
      "token_start": 373,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 96610,
      "end_ms": 97490,
      "text": "跟着领导干呀，",
      "token_start": 378,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 97490,
      "end_ms": 98615,
      "text": "年年赚个几百万。",
      "token_start": 384,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 98980,
      "end_ms": 101460,
      "text": "来这杯酒祝领导们左手招财，",
      "token_start": 391,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 101460,
      "end_ms": 102460,
      "text": "右手富平安，",
      "token_start": 403,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 102460,
      "end_ms": 104065,
      "text": "席乐万事足干杯。",
      "token_start": 408,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 105720,
      "end_ms": 107980,
      "text": "你们公司呀虽然能力强，",
      "token_start": 415,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 108360,
      "end_ms": 110155,
      "text": "但是个个心高气傲，",
      "token_start": 425,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 110570,
      "end_ms": 113255,
      "text": "就像这藕偶是好偶啊，",
      "token_start": 433,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 113630,
      "end_ms": 115075,
      "text": "就是心眼儿太多了。",
      "token_start": 442,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 115370,
      "end_ms": 116770,
      "text": "领导者虽然心眼多，",
      "token_start": 450,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 116830,
      "end_ms": 117930,
      "text": "但也是您的下酒菜。",
      "token_start": 458,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 117930,
      "end_ms": 118895,
      "text": "啊啊，",
      "token_start": 466,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 119110,
      "end_ms": 120430,
      "text": "哈哈哈哈哈哈哈，",
      "token_start": 468,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 122860,
      "end_ms": 123995,
      "text": "这鱼是好鱼，",
      "token_start": 475,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 124750,
      "end_ms": 125725,
      "text": "就是刺多。",
      "token_start": 480,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 126910,
      "end_ms": 127210,
      "text": "领导，",
      "token_start": 484,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 127210,
      "end_ms": 129000,
      "text": "您看鱼虽然刺多，",
      "token_start": 486,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 129140,
      "end_ms": 131365,
      "text": "但主心骨只有一根心腹是没有刺的。",
      "token_start": 493,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 133170,
      "end_ms": 134590,
      "text": "哈哈哈哈啊，",
      "token_start": 508,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 135340,
      "end_ms": 137415,
      "text": "嗯小伙子帮我打碗饭。",
      "token_start": 513,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 137760,
      "end_ms": 138160,
      "text": "嗯嗯，",
      "token_start": 522,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 138160,
      "end_ms": 138725,
      "text": "好好好，",
      "token_start": 524,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 143920,
      "end_ms": 144580,
      "text": "打这么多，",
      "token_start": 527,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 144620,
      "end_ms": 145525,
      "text": "你喂猪呢，",
      "token_start": 531,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 145930,
      "end_ms": 147375,
      "text": "王总小张哪敢啊？",
      "token_start": 535,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 147620,
      "end_ms": 149755,
      "text": "他以为您的饭量和肚量是一样的呢，",
      "token_start": 542,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 150290,
      "end_ms": 152405,
      "text": "都说宰相肚里能撑船，",
      "token_start": 557,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 152820,
      "end_ms": 154155,
      "text": "更何况只是一碗饭呢。",
      "token_start": 566,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 155210,
      "end_ms": 172150,
      "text": "哈哈哈什么意思呀？",
      "token_start": 575,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 172250,
      "end_ms": 173965,
      "text": "怎么到我这儿只剩半杯了？",
      "token_start": 583,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 174810,
      "end_ms": 176210,
      "text": "是因为我职位不如王总，",
      "token_start": 594,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 176210,
      "end_ms": 177070,
      "text": "李总看不上我，",
      "token_start": 604,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 177070,
      "end_ms": 177455,
      "text": "对吧？",
      "token_start": 610,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 178150,
      "end_ms": 179490,
      "text": "钱总美满，",
      "token_start": 612,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 179490,
      "end_ms": 179925,
      "text": "美满，",
      "token_start": 616,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 180200,
      "end_ms": 181315,
      "text": "代表幸福美满，",
      "token_start": 618,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 181650,
      "end_ms": 183670,
      "text": "这一辈子美满就是一辈子美满。",
      "token_start": 624,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 183670,
      "end_ms": 186205,
      "text": "啊哈哈哈哈哈，",
      "token_start": 637,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 188160,
      "end_ms": 189605,
      "text": "你酒量挺好的呀，",
      "token_start": 643,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 190110,
      "end_ms": 191535,
      "text": "领导您可抬举我了，",
      "token_start": 650,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 191960,
      "end_ms": 193375,
      "text": "我平时真不太能喝。",
      "token_start": 658,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 193810,
      "end_ms": 195530,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 666,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 195690,
      "end_ms": 196465,
      "text": "高兴啊，",
      "token_start": 677,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 196760,
      "end_ms": 198555,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 680,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 200630,
      "end_ms": 200870,
      "text": "呃，",
      "token_start": 690,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 201320,
      "end_ms": 205715,
      "text": "哈哈哈哈哈王姐这顿饭吃的很开心，",
      "token_start": 691,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 206400,
      "end_ms": 208035,
      "text": "这个小姑娘我看挺灵光，",
      "token_start": 706,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 208510,
      "end_ms": 209470,
      "text": "新项目交给他，",
      "token_start": 716,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 209470,
      "end_ms": 210175,
      "text": "我也放心，",
      "token_start": 722,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 210550,
      "end_ms": 210955,
      "text": "行，",
      "token_start": 726,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 211420,
      "end_ms": 212745,
      "text": "这笔生意就这么定了，",
      "token_start": 727,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 213020,
      "end_ms": 213460,
      "text": "放心吧，",
      "token_start": 736,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 213460,
      "end_ms": 220565,
      "text": "王总您慢走怎么样？",
      "token_start": 739,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 221070,
      "end_ms": 223225,
      "text": "一顿饭就看出来你和玲玲的差距了吧。",
      "token_start": 747,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 223570,
      "end_ms": 224250,
      "text": "可不是嘛，",
      "token_start": 763,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 224250,
      "end_ms": 226280,
      "text": "王姐这琳琳也太会说了，",
      "token_start": 767,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 226280,
      "end_ms": 227365,
      "text": "我离她差得远呢，",
      "token_start": 777,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 227720,
      "end_ms": 229095,
      "text": "这下我输的心服口服，",
      "token_start": 784,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 229380,
      "end_ms": 231700,
      "text": "你呀多看看这本把话说的恰到好处。",
      "token_start": 793,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 231900,
      "end_ms": 232960,
      "text": "假如你不爱说话，",
      "token_start": 808,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 233000,
      "end_ms": 233680,
      "text": "不爱争辩，",
      "token_start": 815,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 233700,
      "end_ms": 234500,
      "text": "也不爱出门，",
      "token_start": 819,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 234720,
      "end_ms": 235760,
      "text": "甚至恐惧社交，",
      "token_start": 824,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 235840,
      "end_ms": 237020,
      "text": "你就每天看两页，",
      "token_start": 830,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 237200,
      "end_ms": 238380,
      "text": "每一个场景慢慢练，",
      "token_start": 837,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 238520,
      "end_ms": 240220,
      "text": "你也会变成一个会说话的人。",
      "token_start": 845,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 240280,
      "end_ms": 241660,
      "text": "在这本书里有一句话，",
      "token_start": 857,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 241660,
      "end_ms": 242500,
      "text": "我特别欣赏，",
      "token_start": 866,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 242640,
      "end_ms": 242820,
      "text": "他，",
      "token_start": 871,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 242820,
      "end_ms": 245380,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 872,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 245440,
      "end_ms": 246195,
      "text": "你可以回，",
      "token_start": 884,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 246610,
      "end_ms": 247590,
      "text": "那是不优秀点，",
      "token_start": 888,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 247830,
      "end_ms": 249225,
      "text": "怎么能和你做朋友呢？",
      "token_start": 894,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 249450,
      "end_ms": 250835,
      "text": "当有人说你真聪明，",
      "token_start": 903,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 251020,
      "end_ms": 252800,
      "text": "你就回近朱者赤，",
      "token_start": 911,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 252940,
      "end_ms": 253940,
      "text": "和你在一起啊，",
      "token_start": 918,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 253940,
      "end_ms": 257285,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 924,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 257710,
      "end_ms": 258870,
      "text": "你就回领导，",
      "token_start": 939,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 258870,
      "end_ms": 260175,
      "text": "这都是我应该做的。",
      "token_start": 944,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 260900,
      "end_ms": 262400,
      "text": "强将手下吴弱兵，",
      "token_start": 952,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 262600,
      "end_ms": 264065,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 959,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 264370,
      "end_ms": 265635,
      "text": "每一句都很有意思，",
      "token_start": 968,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 265990,
      "end_ms": 269290,
      "text": "就是手把手教我们在不同的场景之下应该怎么说。",
      "token_start": 976,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 269650,
      "end_ms": 272685,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 997,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 272990,
      "end_ms": 274290,
      "text": "你就放心的拿回去看，",
      "token_start": 1015,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 274490,
      "end_ms": 276135,
      "text": "就是一句一句的教你，",
      "token_start": 1024,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 276490,
      "end_ms": 279005,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 1033,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 279520,
      "end_ms": 280760,
      "text": "但凡学会三分，",
      "token_start": 1045,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 281060,
      "end_ms": 283835,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 1051,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 284500,
      "end_ms": 285255,
      "text": "我这就回去看。",
      "token_start": 1065,
      "token_end_exclusive": 1071
    }
  ],
