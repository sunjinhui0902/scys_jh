{
  "video_id": "v_30cc827b5d5dd936",
  "duration_s": 179.7,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_30cc827b5d5dd936.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_30cc827b5d5dd936.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1010,
      "text": "你能想象吗？",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1230,
      "end_ms": 2790,
      "text": "一位九十七岁的老人，",
      "token_start": 5,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 2850,
      "end_ms": 5970,
      "text": "依然在坚守着一家一百多年历史的旧书店。",
      "token_start": 14,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 6330,
      "end_ms": 8950,
      "text": "这是我见过的全中国最孤独的一家书店。",
      "token_start": 32,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 9350,
      "end_ms": 12010,
      "text": "我想把他的故事告诉给每一个爱书的人。",
      "token_start": 49,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 12610,
      "end_ms": 13990,
      "text": "在苏州的柳家巷，",
      "token_start": 66,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 14130,
      "end_ms": 15710,
      "text": "一棵高大的玉兰树下，",
      "token_start": 73,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 15850,
      "end_ms": 17390,
      "text": "有一个不起眼的小门脸，",
      "token_start": 82,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 17790,
      "end_ms": 19610,
      "text": "文学山房旧书店，",
      "token_start": 92,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 20110,
      "end_ms": 21890,
      "text": "他卖书只卖旧书。",
      "token_start": 99,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 22190,
      "end_ms": 25610,
      "text": "这个规矩从一百三十多年前就定下了书店，",
      "token_start": 106,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 25610,
      "end_ms": 26010,
      "text": "不大，",
      "token_start": 124,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 26170,
      "end_ms": 28350,
      "text": "一进去就能闻到书籍的油墨。",
      "token_start": 126,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 28350,
      "end_ms": 30540,
      "text": "香爱书人闻到这种这种味道，",
      "token_start": 138,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 30540,
      "end_ms": 32260,
      "text": "顿顿时静静来来，",
      "token_start": 150,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 32260,
      "end_ms": 33160,
      "text": "里面没有空调，",
      "token_start": 157,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 33500,
      "end_ms": 35920,
      "text": "只有老式的电风扇在吱呀作响。",
      "token_start": 163,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 36220,
      "end_ms": 39340,
      "text": "坐在角落的就是店主江成波老爷爷，",
      "token_start": 176,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 39620,
      "end_ms": 41440,
      "text": "他今年已经九十七岁了，",
      "token_start": 191,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 41740,
      "end_ms": 46600,
      "text": "他是从他的爷爷那里继承了这家创立于清朝光绪年间的旧书店，",
      "token_start": 201,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 47080,
      "end_ms": 48040,
      "text": "江成波老人家，",
      "token_start": 228,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 48040,
      "end_ms": 50380,
      "text": "也是我国著名的古籍版本学家。",
      "token_start": 234,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 51240,
      "end_ms": 53740,
      "text": "他从小跟随祖父学习十几岁，",
      "token_start": 247,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 53740,
      "end_ms": 56640,
      "text": "就能熟练的背诵四库全书的版本目录。",
      "token_start": 259,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 56640,
      "end_ms": 59040,
      "text": "他已经和古籍打了一辈子的教导。",
      "token_start": 275,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 59040,
      "end_ms": 62950,
      "text": "每一套收来的古籍都经他的手整理修补，",
      "token_start": 289,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 62990,
      "end_ms": 63850,
      "text": "编好序号，",
      "token_start": 306,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 64070,
      "end_ms": 65115,
      "text": "再放上书架。",
      "token_start": 310,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 65540,
      "end_ms": 66760,
      "text": "他的记忆力特别强，",
      "token_start": 315,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 66760,
      "end_ms": 68465,
      "text": "说话逻辑性很清晰。",
      "token_start": 323,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 68780,
      "end_ms": 70340,
      "text": "顾客只要一报出书名，",
      "token_start": 331,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 70460,
      "end_ms": 74865,
      "text": "他就能说出作者成熟年月、看课时间和大致内容。",
      "token_start": 340,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 75400,
      "end_ms": 78435,
      "text": "老人家曾经也为抢救古籍做过很多贡献。",
      "token_start": 360,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 78880,
      "end_ms": 85165,
      "text": "国家图书馆南京图书馆南京博物院里面有很多江成波捐献的珍贵的宋代国籍。",
      "token_start": 377,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 85760,
      "end_ms": 87760,
      "text": "姜爷爷很投入的向我描述说，",
      "token_start": 410,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 87780,
      "end_ms": 91465,
      "text": "曾经有很多大师级的学者都来文学山房买过书。",
      "token_start": 422,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 92140,
      "end_ms": 97165,
      "text": "他小时候就见过章太炎、叶圣陶、郑正铎这些名家来店里的卖书，",
      "token_start": 442,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 97630,
      "end_ms": 99470,
      "text": "这个书店呢一点也不网红，",
      "token_start": 468,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 99590,
      "end_ms": 102365,
      "text": "就这样本本分分安安静静，",
      "token_start": 479,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 102790,
      "end_ms": 105320,
      "text": "让人看了有一种踏踏实实的感觉。",
      "token_start": 490,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 105560,
      "end_ms": 106920,
      "text": "进店的读者来到这里，",
      "token_start": 504,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 106920,
      "end_ms": 110475,
      "text": "不会打卡拍照都只是安安静静的读书。",
      "token_start": 513,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 111190,
      "end_ms": 114090,
      "text": "九十七岁的江爷爷由于白内障视力不太好，",
      "token_start": 529,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 114230,
      "end_ms": 116870,
      "text": "但他还是坚持着给我的短视频提了字。",
      "token_start": 547,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 117110,
      "end_ms": 120525,
      "text": "他的落款是九七老人江成波，",
      "token_start": 563,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 121420,
      "end_ms": 122680,
      "text": "而我看望他的这一天，",
      "token_start": 575,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 122680,
      "end_ms": 124985,
      "text": "正好是二零二二年九月七号。",
      "token_start": 584,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 125530,
      "end_ms": 126070,
      "text": "姜老说，",
      "token_start": 596,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 126070,
      "end_ms": 127435,
      "text": "这是很神奇的缘分。",
      "token_start": 599,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 128350,
      "end_ms": 128730,
      "text": "他说，",
      "token_start": 607,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 128770,
      "end_ms": 130630,
      "text": "书店就像一个城市的眉毛，",
      "token_start": 609,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 130790,
      "end_ms": 132010,
      "text": "眉毛长在脸上，",
      "token_start": 620,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 132090,
      "end_ms": 133970,
      "text": "也许并不是最要紧的五官，",
      "token_start": 626,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 134170,
      "end_ms": 135805,
      "text": "但若少了这两道眉毛，",
      "token_start": 637,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 136160,
      "end_ms": 139145,
      "text": "再天生丽质的脸蛋就会显得美中不足。",
      "token_start": 646,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 139760,
      "end_ms": 141280,
      "text": "我十六岁就到书店，",
      "token_start": 662,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 141500,
      "end_ms": 143140,
      "text": "十六岁也在九十七岁，",
      "token_start": 670,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 143380,
      "end_ms": 144400,
      "text": "您今年九十七岁，",
      "token_start": 679,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 144400,
      "end_ms": 146060,
      "text": "但是八十年八十年啊，",
      "token_start": 686,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 146060,
      "end_ms": 146825,
      "text": "八十岁，",
      "token_start": 695,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 147110,
      "end_ms": 148705,
      "text": "准备要进零点三，",
      "token_start": 698,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 149240,
      "end_ms": 149665,
      "text": "真的，",
      "token_start": 705,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 149900,
      "end_ms": 151740,
      "text": "你九十七岁这么这么好。",
      "token_start": 707,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 152000,
      "end_ms": 152360,
      "text": "对呀，",
      "token_start": 717,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 152360,
      "end_ms": 153480,
      "text": "我是太太妹妹，",
      "token_start": 719,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 153480,
      "end_ms": 154980,
      "text": "九十七岁了不稀岁的，",
      "token_start": 725,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 156120,
      "end_ms": 157325,
      "text": "他这个有误之极，",
      "token_start": 734,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 157670,
      "end_ms": 158610,
      "text": "学无止境啊。",
      "token_start": 741,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 158610,
      "end_ms": 159005,
      "text": "哎，",
      "token_start": 746,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 159790,
      "end_ms": 160390,
      "text": "学弟呀，",
      "token_start": 747,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 160390,
      "end_ms": 161850,
      "text": "我我也在也是，",
      "token_start": 750,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 161930,
      "end_ms": 163025,
      "text": "我也在也在学，",
      "token_start": 756,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 163460,
      "end_ms": 163850,
      "text": "嗯嗯，",
      "token_start": 762,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 164190,
      "end_ms": 165545,
      "text": "现在说站着也有，",
      "token_start": 764,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 166270,
      "end_ms": 166815,
      "text": "对不对？",
      "token_start": 771,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 167310,
      "end_ms": 168530,
      "text": "如果你下次来苏州，",
      "token_start": 774,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 168670,
      "end_ms": 171130,
      "text": "请记得看一看文学山房旧书店，",
      "token_start": 782,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 171330,
      "end_ms": 176760,
      "text": "看一看江成伯老爷爷嗯。",
      "token_start": 795,
      "token_end_exclusive": 805
    }
  ],
