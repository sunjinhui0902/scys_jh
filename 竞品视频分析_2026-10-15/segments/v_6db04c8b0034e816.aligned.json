{
  "video_id": "v_6db04c8b0034e816",
  "duration_s": 419.517241,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_6db04c8b0034e816.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_6db04c8b0034e816.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1370,
      "text": "三十年不回家，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1610,
      "end_ms": 3830,
      "text": "父亲到死都不知道他是谁。",
      "token_start": 6,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4390,
      "end_ms": 5270,
      "text": "九十三岁，",
      "token_start": 17,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5290,
      "end_ms": 7130,
      "text": "老母亲看完证件哭了。",
      "token_start": 21,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7730,
      "end_ms": 8330,
      "text": "家人们，",
      "token_start": 30,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8390,
      "end_ms": 10130,
      "text": "我问你一个扎心的问题，",
      "token_start": 33,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 10710,
      "end_ms": 12350,
      "text": "如果你的父亲去世了，",
      "token_start": 43,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 12710,
      "end_ms": 14930,
      "text": "而你连回去奔丧都做不到，",
      "token_start": 52,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 15230,
      "end_ms": 16910,
      "text": "你会恨自己一辈子吗？",
      "token_start": 63,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 17250,
      "end_ms": 17990,
      "text": "有一个人，",
      "token_start": 72,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 18210,
      "end_ms": 19010,
      "text": "他就这么干，",
      "token_start": 76,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 19890,
      "end_ms": 21050,
      "text": "不是不想回，",
      "token_start": 81,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 21350,
      "end_ms": 22170,
      "text": "是不能回。",
      "token_start": 86,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 23110,
      "end_ms": 24330,
      "text": "整整三十年，",
      "token_start": 90,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 24550,
      "end_ms": 26190,
      "text": "家里人都以为他死了，",
      "token_start": 95,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 26550,
      "end_ms": 28350,
      "text": "兄弟姐妹骂他不孝，",
      "token_start": 104,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 28770,
      "end_ms": 31300,
      "text": "可他连一句我都在干什么都不能说。",
      "token_start": 112,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 32200,
      "end_ms": 33460,
      "text": "直到三十年后，",
      "token_start": 127,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 33560,
      "end_ms": 36160,
      "text": "九十三岁的老母亲看到他的工作证，",
      "token_start": 133,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 36480,
      "end_ms": 40880,
      "text": "才知道这个不孝子是中国的核潜艇之父。",
      "token_start": 148,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 41140,
      "end_ms": 43640,
      "text": "黄旭华黄旭华出生，",
      "token_start": 165,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 43640,
      "end_ms": 45360,
      "text": "在广东一个书香门第，",
      "token_start": 173,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 45860,
      "end_ms": 47220,
      "text": "从小就是学霸，",
      "token_start": 182,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 47640,
      "end_ms": 49740,
      "text": "一路考上了上海交通大学，",
      "token_start": 188,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 50200,
      "end_ms": 51760,
      "text": "学的是造船专业。",
      "token_start": 199,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 52300,
      "end_ms": 55180,
      "text": "年轻时候的他长得一表人才，",
      "token_start": 206,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 55640,
      "end_ms": 57040,
      "text": "前途一片光明。",
      "token_start": 218,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 58680,
      "end_ms": 60940,
      "text": "一九五八年国家找到了，",
      "token_start": 224,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 60940,
      "end_ms": 61750,
      "text": "他说，",
      "token_start": 234,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 61750,
      "end_ms": 62975,
      "text": "我们要搞核潜艇，",
      "token_start": 236,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 63430,
      "end_ms": 65925,
      "text": "需要你加入全程保密。",
      "token_start": 243,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 66310,
      "end_ms": 67345,
      "text": "尚不告父母，",
      "token_start": 252,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 67660,
      "end_ms": 68715,
      "text": "下不告妻儿，",
      "token_start": 257,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 68980,
      "end_ms": 70815,
      "text": "黄旭华想都没想就答应了。",
      "token_start": 262,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 71220,
      "end_ms": 72155,
      "text": "他心里清楚，",
      "token_start": 273,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 72620,
      "end_ms": 73955,
      "text": "新中国刚成立，",
      "token_start": 278,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 74290,
      "end_ms": 75715,
      "text": "海上没有防护，",
      "token_start": 284,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 76190,
      "end_ms": 79195,
      "text": "人家的军舰说开到我们家门口就开过来了。",
      "token_start": 290,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 79580,
      "end_ms": 80595,
      "text": "没有核潜艇，",
      "token_start": 308,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 81340,
      "end_ms": 83415,
      "text": "我们就没有海上的话语权。",
      "token_start": 313,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 84200,
      "end_ms": 85000,
      "text": "临走之前，",
      "token_start": 324,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 85200,
      "end_ms": 87795,
      "text": "他回了一趟老家跟父母告别，",
      "token_start": 328,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 88230,
      "end_ms": 90055,
      "text": "只说自己要去北京工作，",
      "token_start": 340,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 90450,
      "end_ms": 92025,
      "text": "以后可能很少回来。",
      "token_start": 350,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 92940,
      "end_ms": 94605,
      "text": "母亲拉着他的手说，",
      "token_start": 358,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 95090,
      "end_ms": 96475,
      "text": "你放心去干事业，",
      "token_start": 366,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 97390,
      "end_ms": 98665,
      "text": "家里不用你操心，",
      "token_start": 373,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 99110,
      "end_ms": 100515,
      "text": "寄得长写信回来，",
      "token_start": 380,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 101460,
      "end_ms": 102700,
      "text": "他嘴上答应着，",
      "token_start": 387,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 102800,
      "end_ms": 104515,
      "text": "心里却满是愧疚。",
      "token_start": 393,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 105200,
      "end_ms": 109205,
      "text": "因为他知道这一去别说写信了，",
      "token_start": 400,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 109870,
      "end_ms": 111545,
      "text": "连自己是死是活，",
      "token_start": 413,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 111900,
      "end_ms": 113295,
      "text": "家里都未必能知道。",
      "token_start": 420,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 114180,
      "end_ms": 117295,
      "text": "这一走就是整整三十年，",
      "token_start": 428,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 118650,
      "end_ms": 120235,
      "text": "搞核潜艇有多难？",
      "token_start": 438,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 120740,
      "end_ms": 125965,
      "text": "那时候全世界只有美国、苏联几个国家有技术严密封锁，",
      "token_start": 445,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 126350,
      "end_ms": 128935,
      "text": "我们连一张像样的图纸都没有。",
      "token_start": 468,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 129650,
      "end_ms": 133395,
      "text": "外国人甚至嘲讽说中国人想搞核潜艇，",
      "token_start": 481,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 133990,
      "end_ms": 135335,
      "text": "再等一百年吧。",
      "token_start": 497,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 136530,
      "end_ms": 137755,
      "text": "黄旭华不服气，",
      "token_start": 503,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 138680,
      "end_ms": 139415,
      "text": "没有资料，",
      "token_start": 509,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 139790,
      "end_ms": 142855,
      "text": "他们就从国外的报纸杂志里抠信息，",
      "token_start": 513,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 143090,
      "end_ms": 144165,
      "text": "一点点拼凑。",
      "token_start": 528,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 144610,
      "end_ms": 148075,
      "text": "没有计算机就用算盘计算尺，",
      "token_start": 533,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 148590,
      "end_ms": 150650,
      "text": "没日没夜的算算，",
      "token_start": 545,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 150670,
      "end_ms": 152645,
      "text": "错一个数就要从头再来。",
      "token_start": 552,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 153570,
      "end_ms": 155795,
      "text": "最苦的是心里的苦，",
      "token_start": 562,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 156330,
      "end_ms": 157695,
      "text": "他不能跟家里联系，",
      "token_start": 570,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 158000,
      "end_ms": 159755,
      "text": "不能说自己在做什么。",
      "token_start": 578,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 160060,
      "end_ms": 163025,
      "text": "家里来信问他在哪做什么工作，",
      "token_start": 587,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 163330,
      "end_ms": 165125,
      "text": "他每次都只字不提，",
      "token_start": 600,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 165520,
      "end_ms": 167175,
      "text": "只说自己一切都好。",
      "token_start": 608,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 167570,
      "end_ms": 168290,
      "text": "就这么熬了。",
      "token_start": 616,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 168290,
      "end_ms": 169175,
      "text": "一年又一年，",
      "token_start": 621,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 169890,
      "end_ms": 170835,
      "text": "一九七零年，",
      "token_start": 626,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 171300,
      "end_ms": 173425,
      "text": "中国第一艘核潜艇下水。",
      "token_start": 631,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 173930,
      "end_ms": 175035,
      "text": "一九八一年，",
      "token_start": 641,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 175470,
      "end_ms": 177835,
      "text": "第一艘导弹核潜艇下水，",
      "token_start": 646,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 178190,
      "end_ms": 182595,
      "text": "中国成为了世界上第五个拥有核潜艇的国家。",
      "token_start": 656,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 183520,
      "end_ms": 191495,
      "text": "可这时候的黄旭华已经从一个意气风发的青年变成了两鬓斑白的老人。",
      "token_start": 675,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 192140,
      "end_ms": 193065,
      "text": "一九八八年，",
      "token_start": 705,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 193350,
      "end_ms": 196285,
      "text": "核潜艇要做极限深浅试验，",
      "token_start": 710,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 197050,
      "end_ms": 198475,
      "text": "这是最危险的一步。",
      "token_start": 721,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 199340,
      "end_ms": 202595,
      "text": "国外很多次深浅试验都出过事故，",
      "token_start": 729,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 203350,
      "end_ms": 204335,
      "text": "停毁人亡。",
      "token_start": 743,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 205450,
      "end_ms": 206805,
      "text": "所有人都劝他，",
      "token_start": 747,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 207190,
      "end_ms": 207685,
      "text": "黄总，",
      "token_start": 753,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 210180,
      "end_ms": 211295,
      "text": "你是总设计师，",
      "token_start": 755,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 211550,
      "end_ms": 212575,
      "text": "你就别下去了，",
      "token_start": 761,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 213560,
      "end_ms": 214335,
      "text": "太危险了。",
      "token_start": 767,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 215730,
      "end_ms": 216945,
      "text": "黄旭华摇了摇头，",
      "token_start": 771,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 217870,
      "end_ms": 218215,
      "text": "说，",
      "token_start": 778,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 220240,
      "end_ms": 220935,
      "text": "我下去，",
      "token_start": 779,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 222350,
      "end_ms": 223090,
      "text": "我是总师，",
      "token_start": 782,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 223250,
      "end_ms": 226085,
      "text": "我必须对艇上每一个人的生命负责。",
      "token_start": 786,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 226650,
      "end_ms": 227145,
      "text": "就这样，",
      "token_start": 801,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 227590,
      "end_ms": 232835,
      "text": "六十二岁的黄旭华跟着潜艇一起下潜到了极限深度。",
      "token_start": 804,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 233600,
      "end_ms": 235385,
      "text": "当潜艇成功上浮，",
      "token_start": 826,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 235820,
      "end_ms": 237535,
      "text": "所有人都欢呼的时候，",
      "token_start": 833,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 237890,
      "end_ms": 241955,
      "text": "黄旭华却只是平静的拿起笔记下了所有数据。",
      "token_start": 842,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 242670,
      "end_ms": 245005,
      "text": "一九七五年老家传来电报，",
      "token_start": 861,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 245380,
      "end_ms": 247285,
      "text": "父亲病重不行了，",
      "token_start": 872,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 247620,
      "end_ms": 249675,
      "text": "让他赶紧回去见最后一面。",
      "token_start": 879,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 250380,
      "end_ms": 252145,
      "text": "黄旭华攥着那封电报，",
      "token_start": 890,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 252520,
      "end_ms": 255430,
      "text": "在办公室里坐了一下午电报，",
      "token_start": 899,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 255430,
      "end_ms": 256930,
      "text": "被他捏的皱巴巴的，",
      "token_start": 911,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 256950,
      "end_ms": 258135,
      "text": "他看了又看，",
      "token_start": 919,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 258490,
      "end_ms": 259035,
      "text": "放下，",
      "token_start": 924,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 259340,
      "end_ms": 260975,
      "text": "拿起来又放下。",
      "token_start": 926,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 261450,
      "end_ms": 262625,
      "text": "最后他做了一个决定，",
      "token_start": 932,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 263300,
      "end_ms": 263775,
      "text": "不回，",
      "token_start": 941,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 264670,
      "end_ms": 265585,
      "text": "不是不想回，",
      "token_start": 943,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 266120,
      "end_ms": 269985,
      "text": "是核潜艇正在最要命的攻关阶段。",
      "token_start": 948,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 270910,
      "end_ms": 272215,
      "text": "他是总负责人，",
      "token_start": 962,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 272850,
      "end_ms": 273425,
      "text": "他一走，",
      "token_start": 968,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 273710,
      "end_ms": 275935,
      "text": "整个项目的进度就要往后拖，",
      "token_start": 971,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 276420,
      "end_ms": 277335,
      "text": "父亲可以等，",
      "token_start": 983,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 277800,
      "end_ms": 279905,
      "text": "可国家的大仗等不起。",
      "token_start": 988,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 280320,
      "end_ms": 284125,
      "text": "那天晚上他一个人躲在办公室里关上门，",
      "token_start": 997,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 284500,
      "end_ms": 286405,
      "text": "谁也不知道他在里面哭了多久，",
      "token_start": 1014,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 286960,
      "end_ms": 287815,
      "text": "父亲走了，",
      "token_start": 1027,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 288040,
      "end_ms": 290680,
      "text": "他没能送终家里的兄弟姐妹，",
      "token_start": 1031,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 290680,
      "end_ms": 291520,
      "text": "拍着桌子骂。",
      "token_start": 1043,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 291520,
      "end_ms": 292785,
      "text": "他读了那么多书，",
      "token_start": 1048,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 293170,
      "end_ms": 294745,
      "text": "连爹娘都不要了。",
      "token_start": 1055,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 295040,
      "end_ms": 296625,
      "text": "他一句话都不辩解，",
      "token_start": 1062,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 297260,
      "end_ms": 297875,
      "text": "那一年，",
      "token_start": 1070,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 298170,
      "end_ms": 300465,
      "text": "他五十五岁从那天起，",
      "token_start": 1073,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 300820,
      "end_ms": 302345,
      "text": "他把自己活成了一座。",
      "token_start": 1082,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 302730,
      "end_ms": 308290,
      "text": "孤倒所有委屈愧疚思念全部咽进肚子里，",
      "token_start": 1091,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 308470,
      "end_ms": 309610,
      "text": "一个字都不能说。",
      "token_start": 1108,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 310570,
      "end_ms": 311390,
      "text": "十三年后，",
      "token_start": 1115,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 311730,
      "end_ms": 312770,
      "text": "一九八八年，",
      "token_start": 1119,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 312770,
      "end_ms": 314150,
      "text": "他终于能回家了。",
      "token_start": 1124,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 315350,
      "end_ms": 319170,
      "text": "九十三岁的老母亲站在门口，",
      "token_start": 1131,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 319650,
      "end_ms": 323790,
      "text": "看着这个满头白发的男人愣了很久很久，",
      "token_start": 1143,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 324330,
      "end_ms": 326710,
      "text": "才认出这是自己的儿子。",
      "token_start": 1160,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 327810,
      "end_ms": 331070,
      "text": "黄旭华扑通一声跪下去喊了一声娘，",
      "token_start": 1170,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 331390,
      "end_ms": 333640,
      "text": "满屋子的人全都哭了。",
      "token_start": 1185,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 333760,
      "end_ms": 334700,
      "text": "老母亲没哭，",
      "token_start": 1194,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 335140,
      "end_ms": 338660,
      "text": "她只是颤巍巍的伸出手摸了摸儿子的脸，",
      "token_start": 1199,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 338880,
      "end_ms": 340100,
      "text": "说回来就好。",
      "token_start": 1216,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 340360,
      "end_ms": 342260,
      "text": "娘知道你是干大事的。",
      "token_start": 1221,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 342260,
      "end_ms": 343500,
      "text": "人家人们。",
      "token_start": 1230,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 343720,
      "end_ms": 345780,
      "text": "什么叫忠孝不能两全？",
      "token_start": 1234,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 346320,
      "end_ms": 350860,
      "text": "这就是啊黄旭华把自己的三十年藏进了深海，",
      "token_start": 1243,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 351580,
      "end_ms": 353440,
      "text": "藏进了国家的机密里，",
      "token_start": 1262,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 353720,
      "end_ms": 354980,
      "text": "他对得起父亲，",
      "token_start": 1271,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 355280,
      "end_ms": 356300,
      "text": "对不起家人。",
      "token_start": 1277,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 356780,
      "end_ms": 358400,
      "text": "可他对得起这个国家，",
      "token_start": 1282,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 359180,
      "end_ms": 361875,
      "text": "对得起我们每一个中国人。",
      "token_start": 1291,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 363060,
      "end_ms": 364420,
      "text": "有人说他是英雄，",
      "token_start": 1302,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 364480,
      "end_ms": 365635,
      "text": "可他自己却说，",
      "token_start": 1309,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 366650,
      "end_ms": 367725,
      "text": "我不是英雄。",
      "token_start": 1315,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 368200,
      "end_ms": 371635,
      "text": "我只是一个普普通通的科研工作者，",
      "token_start": 1320,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 372200,
      "end_ms": 373235,
      "text": "国家需要我，",
      "token_start": 1335,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 373540,
      "end_ms": 374275,
      "text": "我就去做。",
      "token_start": 1340,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 374990,
      "end_ms": 376885,
      "text": "就是这样一句朴实的话，",
      "token_start": 1344,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 377440,
      "end_ms": 379815,
      "text": "藏着中国人最硬的骨气，",
      "token_start": 1354,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 380400,
      "end_ms": 385765,
      "text": "能理解这位老母亲心情的在评论区大致敬两个字，",
      "token_start": 1364,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 386370,
      "end_ms": 388945,
      "text": "让这份理解被更多人看到。",
      "token_start": 1385,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 389930,
      "end_ms": 392405,
      "text": "把这条视频转到家族群，",
      "token_start": 1396,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 392950,
      "end_ms": 397130,
      "text": "让全家人一起看看什么叫真正的顶天立地。",
      "token_start": 1406,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 397410,
      "end_ms": 398750,
      "text": "顺手点个收藏，",
      "token_start": 1424,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 399090,
      "end_ms": 401670,
      "text": "下次教育孩子的时候不用再翻半天，",
      "token_start": 1430,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 401670,
      "end_ms": 404175,
      "text": "找不着关注我。",
      "token_start": 1445,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 405540,
      "end_ms": 407345,
      "text": "每天一位国之脊梁，",
      "token_start": 1451,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 408110,
      "end_ms": 410055,
      "text": "比追连续剧还上瘾。",
      "token_start": 1459,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 411000,
      "end_ms": 414085,
      "text": "像他这样把一辈子藏进深海的英雄，",
      "token_start": 1467,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 415030,
      "end_ms": 416175,
      "text": "书里还有四十位，",
      "token_start": 1482,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 416600,
      "end_ms": 419315,
      "text": "每一篇都看的人热泪盈眶。",
      "token_start": 1489,
      "token_end_exclusive": 1500
    }
  ],
