{
  "video_id": "v_38eb65b8de747391",
  "duration_s": 451.241379,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_38eb65b8de747391.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_38eb65b8de747391.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 5550,
      "text": "钱学森这一生爽文编剧都不敢这么写家。",
      "token_start": 0,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 5550,
      "end_ms": 8630,
      "text": "人们今天讲一个爽文，",
      "token_start": 17,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 8630,
      "end_ms": 11790,
      "text": "男主不是我编的是真事儿。",
      "token_start": 26,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 12490,
      "end_ms": 15030,
      "text": "而且我负责任的告诉你，",
      "token_start": 37,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 15450,
      "end_ms": 17230,
      "text": "爽文编句要是敢这么写，",
      "token_start": 47,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 17470,
      "end_ms": 20230,
      "text": "能被读者骂死太离谱了，",
      "token_start": 57,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 20330,
      "end_ms": 21430,
      "text": "不符合逻辑。",
      "token_start": 67,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 22030,
      "end_ms": 25690,
      "text": "可钱学森这一辈子偏偏就这么离谱。",
      "token_start": 72,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 26570,
      "end_ms": 28650,
      "text": "一九一一年十二月十一号，",
      "token_start": 87,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 28650,
      "end_ms": 31120,
      "text": "上海钱学家添了个儿子，",
      "token_start": 98,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 31420,
      "end_ms": 32740,
      "text": "这家人什么来头？",
      "token_start": 108,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 33160,
      "end_ms": 35620,
      "text": "杭州前氏书香门第，",
      "token_start": 115,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 36080,
      "end_ms": 36860,
      "text": "父亲前，",
      "token_start": 123,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 36880,
      "end_ms": 38300,
      "text": "军夫是教育家。",
      "token_start": 126,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 38460,
      "end_ms": 40280,
      "text": "这孩子从小聪明，",
      "token_start": 132,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 40640,
      "end_ms": 43160,
      "text": "但您猜他迷什么火车，",
      "token_start": 139,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 43280,
      "end_ms": 46260,
      "text": "天天蹲在铁轨边上看火车头，",
      "token_start": 148,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 46700,
      "end_ms": 47520,
      "text": "看得入迷。",
      "token_start": 160,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 48020,
      "end_ms": 49380,
      "text": "所以后来考大学，",
      "token_start": 164,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 49760,
      "end_ms": 53260,
      "text": "老师劝他学这学那他谁都不听，",
      "token_start": 171,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 53700,
      "end_ms": 55300,
      "text": "愣是填了铁道工程，",
      "token_start": 184,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 55680,
      "end_ms": 56860,
      "text": "他想修铁路，",
      "token_start": 192,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 57180,
      "end_ms": 59100,
      "text": "让火车跑遍全中国，",
      "token_start": 197,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 59100,
      "end_ms": 61520,
      "text": "按按这条路走下去，",
      "token_start": 205,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 61740,
      "end_ms": 65625,
      "text": "他大概会成为一个优秀的铁道工程师。",
      "token_start": 213,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 66110,
      "end_ms": 67210,
      "text": "可一九三二年，",
      "token_start": 229,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 67510,
      "end_ms": 69775,
      "text": "日军的飞机在上海上空扔炸弹，",
      "token_start": 235,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 70220,
      "end_ms": 71555,
      "text": "他站在校园里，",
      "token_start": 248,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 71870,
      "end_ms": 73165,
      "text": "看着火光冲天，",
      "token_start": 254,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 73490,
      "end_ms": 74350,
      "text": "同胞倒下，",
      "token_start": 260,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 74430,
      "end_ms": 76355,
      "text": "心里那把火腾地就烧起来了。",
      "token_start": 264,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 77300,
      "end_ms": 80225,
      "text": "他扔下铁道工程的书说，",
      "token_start": 276,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 81260,
      "end_ms": 82635,
      "text": "我要学造飞机，",
      "token_start": 286,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 83430,
      "end_ms": 87355,
      "text": "让中国的天上也有自己的翅膀。",
      "token_start": 292,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 88540,
      "end_ms": 89335,
      "text": "就这一年，",
      "token_start": 305,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 90220,
      "end_ms": 91945,
      "text": "他自学航空之师，",
      "token_start": 309,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 92330,
      "end_ms": 97615,
      "text": "考上了清华的耕子赔款公费留学那年全国只招二十个人。",
      "token_start": 316,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 98020,
      "end_ms": 100555,
      "text": "他考上了到了美国麻省理工，",
      "token_start": 340,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 100880,
      "end_ms": 104405,
      "text": "他只用一年就拿下航空工程硕士，",
      "token_start": 352,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 105020,
      "end_ms": 109290,
      "text": "全系学霸被一道难题难住集体抗议。",
      "token_start": 366,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 109290,
      "end_ms": 111065,
      "text": "教授故意刁难的时候，",
      "token_start": 381,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 111420,
      "end_ms": 118355,
      "text": "教授门口贴除了钱学森满分大卷名字后面跟了一长串的a家人们。",
      "token_start": 390,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 118710,
      "end_ms": 120195,
      "text": "什么叫降维打击？",
      "token_start": 418,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 120470,
      "end_ms": 120975,
      "text": "这就是，",
      "token_start": 425,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 121960,
      "end_ms": 124725,
      "text": "但他还不满足麻省理工，",
      "token_start": 428,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 125030,
      "end_ms": 125775,
      "text": "偏实操，",
      "token_start": 438,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 126110,
      "end_ms": 127075,
      "text": "他要去搞理论，",
      "token_start": 441,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 127390,
      "end_ms": 129675,
      "text": "于是转投加州理工，",
      "token_start": 447,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 130130,
      "end_ms": 132630,
      "text": "找到了世界空气动力学泰斗。",
      "token_start": 455,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 132690,
      "end_ms": 136815,
      "text": "冯卡门别的学生是上门求学，",
      "token_start": 467,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 137320,
      "end_ms": 138955,
      "text": "钱学森是上门说，",
      "token_start": 479,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 139390,
      "end_ms": 139965,
      "text": "教授，",
      "token_start": 486,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 140310,
      "end_ms": 141970,
      "text": "我想跟您一起研究。",
      "token_start": 488,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 141970,
      "end_ms": 145095,
      "text": "火箭冯卡门考了几个问题，",
      "token_start": 496,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 145730,
      "end_ms": 147810,
      "text": "他对答如流老头子，",
      "token_start": 507,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 147810,
      "end_ms": 149870,
      "text": "当场破格收他做博士生。",
      "token_start": 515,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 150090,
      "end_ms": 152245,
      "text": "四年博士学位到手。",
      "token_start": 525,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 152690,
      "end_ms": 153745,
      "text": "接下来的履历，",
      "token_start": 533,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 154000,
      "end_ms": 155810,
      "text": "您坐稳的听不到。",
      "token_start": 539,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 155810,
      "end_ms": 159500,
      "text": "三十岁成了世界知名的空气动力学。",
      "token_start": 546,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 159500,
      "end_ms": 163715,
      "text": "专家跟导师搞出了著名的卡门。",
      "token_start": 561,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 164120,
      "end_ms": 172430,
      "text": "钱学森公事参与创建了后来大名鼎鼎的喷气推进实验室GPL.今天，",
      "token_start": 574,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 172510,
      "end_ms": 175285,
      "text": "拉萨的火星车追根溯源，",
      "token_start": 601,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 175630,
      "end_ms": 176865,
      "text": "还带着他的基因。",
      "token_start": 611,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 177610,
      "end_ms": 178805,
      "text": "二战结束后，",
      "token_start": 618,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 179240,
      "end_ms": 184245,
      "text": "美国派他去德国审讯v two火箭之父冯布劳恩，",
      "token_start": 623,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 184850,
      "end_ms": 188010,
      "text": "他拿到了美国最高级别的保密通行证。",
      "token_start": 642,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 188090,
      "end_ms": 190115,
      "text": "五角大楼来去自由。",
      "token_start": 658,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 190560,
      "end_ms": 194220,
      "text": "那会儿的美国把它当宝一样供着要钱，",
      "token_start": 666,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 194280,
      "end_ms": 195800,
      "text": "给钱要地位，",
      "token_start": 682,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 195800,
      "end_ms": 196465,
      "text": "给地位，",
      "token_start": 687,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 196810,
      "end_ms": 197755,
      "text": "前程似锦，",
      "token_start": 690,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 198070,
      "end_ms": 200215,
      "text": "荣华富贵唾手可得，",
      "token_start": 694,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 200660,
      "end_ms": 204845,
      "text": "换个人可能早就在好莱坞的阳光里躺平了。",
      "token_start": 702,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 205700,
      "end_ms": 206615,
      "text": "可钱学森呢，",
      "token_start": 720,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 206880,
      "end_ms": 209125,
      "text": "他回国的心一天都没变过。",
      "token_start": 725,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 209810,
      "end_ms": 212050,
      "text": "新中国成立的喜讯传到美国，",
      "token_start": 736,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 212250,
      "end_ms": 213555,
      "text": "他激动的睡不着觉，",
      "token_start": 748,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 213950,
      "end_ms": 216015,
      "text": "立刻开始收拾行囊。",
      "token_start": 756,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 216540,
      "end_ms": 217605,
      "text": "美国人急了，",
      "token_start": 764,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 218110,
      "end_ms": 221975,
      "text": "一批又一批人轮番来劝留下来，",
      "token_start": 769,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 222260,
      "end_ms": 223440,
      "text": "你要什么给什么。",
      "token_start": 782,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 223500,
      "end_ms": 224985,
      "text": "钱学森就一句话，",
      "token_start": 789,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 225310,
      "end_ms": 226290,
      "text": "我要回中国，",
      "token_start": 796,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 226550,
      "end_ms": 228075,
      "text": "劝不动就来硬的。",
      "token_start": 801,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 229090,
      "end_ms": 230035,
      "text": "一九五零年，",
      "token_start": 808,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 230350,
      "end_ms": 233610,
      "text": "他以回国探亲的名义准备启程行李，",
      "token_start": 813,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 233610,
      "end_ms": 236480,
      "text": "被扣人被扣关进拘留所，",
      "token_start": 828,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 236480,
      "end_ms": 239085,
      "text": "十五天出来瘦了三十斤。",
      "token_start": 838,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 239500,
      "end_ms": 240620,
      "text": "此后五年，",
      "token_start": 848,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 241080,
      "end_ms": 243585,
      "text": "软禁监视监听，",
      "token_start": 852,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 244030,
      "end_ms": 246570,
      "text": "全用上美国海军次长，",
      "token_start": 858,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 246590,
      "end_ms": 247270,
      "text": "甚至放话，",
      "token_start": 867,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 247470,
      "end_ms": 249625,
      "text": "他一个人抵得上五个师，",
      "token_start": 871,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 250020,
      "end_ms": 251375,
      "text": "我宁可毙了他，",
      "token_start": 881,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 251890,
      "end_ms": 253065,
      "text": "也不放他走。",
      "token_start": 887,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 254080,
      "end_ms": 255700,
      "text": "后来的事家，",
      "token_start": 892,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 255700,
      "end_ms": 259890,
      "text": "人们都知道了一封夹在家书里的求救信，",
      "token_start": 897,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 259990,
      "end_ms": 260945,
      "text": "绕到比利时，",
      "token_start": 914,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 261340,
      "end_ms": 263025,
      "text": "摆上周总理的办公桌。",
      "token_start": 919,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 263560,
      "end_ms": 268055,
      "text": "日内瓦谈判十一个美军飞行员换一个钱学森。",
      "token_start": 928,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 268970,
      "end_ms": 270315,
      "text": "一九五五年十月，",
      "token_start": 947,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 270630,
      "end_ms": 271770,
      "text": "他踏上罗湖桥，",
      "token_start": 954,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 272070,
      "end_ms": 274575,
      "text": "看到了五星红旗家人们，",
      "token_start": 960,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 275190,
      "end_ms": 276855,
      "text": "您把这段人生捋一遍。",
      "token_start": 970,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 277350,
      "end_ms": 279695,
      "text": "书香门第天才少年，",
      "token_start": 979,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 280110,
      "end_ms": 284520,
      "text": "弃铁从行全国公费留学碾压世界，",
      "token_start": 987,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 284520,
      "end_ms": 286625,
      "text": "学霸娶了名门之女。",
      "token_start": 1001,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 287250,
      "end_ms": 289970,
      "text": "他妻子蒋英是军事家，",
      "token_start": 1009,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 290010,
      "end_ms": 291335,
      "text": "蒋百里的女儿，",
      "token_start": 1018,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 292280,
      "end_ms": 293875,
      "text": "家里的亲戚圈儿，",
      "token_start": 1024,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 294090,
      "end_ms": 297605,
      "text": "还占着金庸、徐志摩这些名字。",
      "token_start": 1031,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 297800,
      "end_ms": 298365,
      "text": "这配置。",
      "token_start": 1043,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 299440,
      "end_ms": 301500,
      "text": "放爽文里都得被骂。",
      "token_start": 1046,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 302480,
      "end_ms": 302960,
      "text": "作者，",
      "token_start": 1054,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 302960,
      "end_ms": 303720,
      "text": "亲儿子，",
      "token_start": 1056,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 304520,
      "end_ms": 307080,
      "text": "可爽文和现实的分水岭在哪？",
      "token_start": 1059,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 308060,
      "end_ms": 310600,
      "text": "爽文的结局是功成名就，",
      "token_start": 1071,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 311500,
      "end_ms": 312580,
      "text": "人生圆满。",
      "token_start": 1081,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 314060,
      "end_ms": 317680,
      "text": "钱学森的结局是一穷二白的，",
      "token_start": 1085,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 317680,
      "end_ms": 321440,
      "text": "祖国需要他他放弃一切回来了。",
      "token_start": 1097,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 321660,
      "end_ms": 324000,
      "text": "从头开始没有办公室，",
      "token_start": 1110,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 324380,
      "end_ms": 326160,
      "text": "他就在旧房子里上课。",
      "token_start": 1119,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 326580,
      "end_ms": 327660,
      "text": "没有计算机，",
      "token_start": 1128,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 328120,
      "end_ms": 330090,
      "text": "他就带着年轻亲人用。",
      "token_start": 1133,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 330130,
      "end_ms": 331330,
      "text": "算盘算弹道。",
      "token_start": 1142,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 331950,
      "end_ms": 332770,
      "text": "没有专家，",
      "token_start": 1147,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 332970,
      "end_ms": 334510,
      "text": "他就自己当老师。",
      "token_start": 1151,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 334850,
      "end_ms": 336430,
      "text": "初题出道没人及格，",
      "token_start": 1158,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 336730,
      "end_ms": 338930,
      "text": "愣是带出了一整支队伍，",
      "token_start": 1166,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 339050,
      "end_ms": 341570,
      "text": "然后呢东风一号两弹，",
      "token_start": 1176,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 341650,
      "end_ms": 345690,
      "text": "结合东方红一号一样一样全搞出来。",
      "token_start": 1185,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 346170,
      "end_ms": 348510,
      "text": "冯卡门当年送他回国时说，",
      "token_start": 1200,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 348850,
      "end_ms": 352050,
      "text": "现在你在学术上已经超过了我。",
      "token_start": 1211,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 352550,
      "end_ms": 355690,
      "text": "钱学森用后半辈子证明了另一件事。",
      "token_start": 1224,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 356110,
      "end_ms": 358090,
      "text": "他不止在学术上超过了他。",
      "token_start": 1239,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 358090,
      "end_ms": 360890,
      "text": "老师他还在选择这件事上，",
      "token_start": 1250,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 361090,
      "end_ms": 362370,
      "text": "超过了那个时代。",
      "token_start": 1261,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 362510,
      "end_ms": 363575,
      "text": "几乎所有人，",
      "token_start": 1268,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 364270,
      "end_ms": 366145,
      "text": "美国人到今天都想不通，",
      "token_start": 1273,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 366600,
      "end_ms": 367980,
      "text": "当年放着高薪，",
      "token_start": 1283,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 368080,
      "end_ms": 371580,
      "text": "不要非要回一穷二白的祖国图什么？",
      "token_start": 1289,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 371760,
      "end_ms": 373775,
      "text": "钱老自己早就回答过了。",
      "token_start": 1304,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 374680,
      "end_ms": 375185,
      "text": "他说，",
      "token_start": 1314,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 376310,
      "end_ms": 378495,
      "text": "我作为一名科技工作者，",
      "token_start": 1316,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 379290,
      "end_ms": 381805,
      "text": "活着的目的就是为人民服务。",
      "token_start": 1326,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 382840,
      "end_ms": 386875,
      "text": "如果人民最后对我这一生所做的工作表示满意，",
      "token_start": 1338,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 387340,
      "end_ms": 389005,
      "text": "那才是最高的奖赏。",
      "token_start": 1358,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 389980,
      "end_ms": 390580,
      "text": "家人们，",
      "token_start": 1366,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 390660,
      "end_ms": 394065,
      "text": "您听听没有一句豪言壮语，",
      "token_start": 1369,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 394360,
      "end_ms": 395955,
      "text": "没有一句漂亮话，",
      "token_start": 1380,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 396810,
      "end_ms": 398695,
      "text": "就这么朴实的一句话，",
      "token_start": 1387,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 399190,
      "end_ms": 404925,
      "text": "分量重的能压他秤爽文难主的故事到这儿就讲完了吗？",
      "token_start": 1396,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 405390,
      "end_ms": 407255,
      "text": "没有他真正的故事，",
      "token_start": 1419,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 407590,
      "end_ms": 411450,
      "text": "从他踏上祖国土地那一刻才刚刚开场。",
      "token_start": 1427,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 411630,
      "end_ms": 416145,
      "text": "让更多孩子知道中国最该追的星长什么样。",
      "token_start": 1443,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 416600,
      "end_ms": 418235,
      "text": "很多家长发愁，",
      "token_start": 1461,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 418610,
      "end_ms": 420455,
      "text": "不知道给孩子看什么书，",
      "token_start": 1467,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 421020,
      "end_ms": 421600,
      "text": "刷手机，",
      "token_start": 1477,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 421600,
      "end_ms": 424565,
      "text": "看多了迷恋各种流量明星。",
      "token_start": 1480,
      "token_end_exclusive": 1491
    },
    {
      "start_ms": 425220,
      "end_ms": 425640,
      "text": "其实，",
      "token_start": 1491,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 425640,
      "end_ms": 430185,
      "text": "最该让孩子认识的是我们国家这些真正的脊梁，",
      "token_start": 1493,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 431130,
      "end_ms": 432745,
      "text": "没有华丽的传奇，",
      "token_start": 1513,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 433190,
      "end_ms": 436375,
      "text": "都是实实在在的奋斗与坚守。",
      "token_start": 1520,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 437220,
      "end_ms": 438455,
      "text": "读他们的经历，",
      "token_start": 1532,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 438830,
      "end_ms": 442465,
      "text": "教会孩子责任、勇气和家国情怀。",
      "token_start": 1538,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 442920,
      "end_ms": 446160,
      "text": "这本国之脊梁放在左下角链接里了，",
      "token_start": 1551,
      "token_end_exclusive": 1566
    },
    {
      "start_ms": 446160,
      "end_ms": 448200,
      "text": "大人看同样深受触动，",
      "token_start": 1566,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 448220,
      "end_ms": 448860,
      "text": "感兴趣，",
      "token_start": 1575,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 448920,
      "end_ms": 450300,
      "text": "直接拍收到，",
      "token_start": 1578,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 450300,
      "end_ms": 451075,
      "text": "好好品读。",
      "token_start": 1583,
      "token_end_exclusive": 1587
    }
  ],
