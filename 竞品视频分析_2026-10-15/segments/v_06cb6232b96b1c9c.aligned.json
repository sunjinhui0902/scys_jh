{
  "video_id": "v_06cb6232b96b1c9c",
  "duration_s": 484.043991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_06cb6232b96b1c9c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_06cb6232b96b1c9c.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 610,
      "end_ms": 1010,
      "text": "周君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1450,
      "end_ms": 4170,
      "text": "你知道中国最受欢迎的男人是谁吗？",
      "token_start": 2,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4410,
      "end_ms": 5790,
      "text": "商人向他求财，",
      "token_start": 17,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 6010,
      "end_ms": 7470,
      "text": "兄弟向他求义气。",
      "token_start": 23,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7590,
      "end_ms": 9190,
      "text": "考生向他求运气，",
      "token_start": 30,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 9630,
      "end_ms": 11310,
      "text": "一个败走麦城的人，",
      "token_start": 37,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 11310,
      "end_ms": 12410,
      "text": "为什么赢了中国人？",
      "token_start": 45,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 12410,
      "end_ms": 13330,
      "text": "一千八百年，",
      "token_start": 53,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 13630,
      "end_ms": 15590,
      "text": "今天挑战一口气给你讲清楚。",
      "token_start": 58,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 15810,
      "end_ms": 25170,
      "text": "三界伏魔大帝神威远征天尊关圣帝君关公关二爷今年八月是关公诞辰一千八百六十六周年。",
      "token_start": 70,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 25530,
      "end_ms": 27270,
      "text": "关公咆下过关关，",
      "token_start": 109,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 27330,
      "end_ms": 29490,
      "text": "难过关关过朱君。",
      "token_start": 116,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 29690,
      "end_ms": 30295,
      "text": "我说说，",
      "token_start": 123,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 30580,
      "end_ms": 31320,
      "text": "你听听。",
      "token_start": 126,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 31440,
      "end_ms": 34120,
      "text": "在想当初后汉三国年间，",
      "token_start": 129,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 34240,
      "end_ms": 36040,
      "text": "自从桃园三结义以来，",
      "token_start": 139,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 36180,
      "end_ms": 37200,
      "text": "大爷姓刘，",
      "token_start": 148,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 37200,
      "end_ms": 38200,
      "text": "名备字玄德，",
      "token_start": 152,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 38260,
      "end_ms": 39560,
      "text": "家住大树楼桑。",
      "token_start": 157,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 39780,
      "end_ms": 41060,
      "text": "二弟姓关名，",
      "token_start": 163,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 41060,
      "end_ms": 41780,
      "text": "羽字云长，",
      "token_start": 168,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 41940,
      "end_ms": 46120,
      "text": "家住山西蒲州谢良县三弟姓张名飞字翼德，",
      "token_start": 172,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 46120,
      "end_ms": 47580,
      "text": "家住涿州范阳郡。",
      "token_start": 190,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 47820,
      "end_ms": 49200,
      "text": "后续四弟姓赵，",
      "token_start": 197,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 49220,
      "end_ms": 50100,
      "text": "名云字子龙，",
      "token_start": 203,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 50100,
      "end_ms": 51060,
      "text": "家住镇定府，",
      "token_start": 208,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 51120,
      "end_ms": 54640,
      "text": "常山县末战过胜后称为常胜将军。",
      "token_start": 213,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 55020,
      "end_ms": 57160,
      "text": "这关云长温九斩华雄，",
      "token_start": 227,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 57340,
      "end_ms": 58780,
      "text": "过五关斩六将，",
      "token_start": 236,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 58940,
      "end_ms": 61830,
      "text": "华容道义士曹好青龙偃月刀，",
      "token_start": 242,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 61830,
      "end_ms": 62450,
      "text": "赤兔马，",
      "token_start": 254,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 62510,
      "end_ms": 63475,
      "text": "红脸绿袍。",
      "token_start": 257,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 63790,
      "end_ms": 66090,
      "text": "在博马坡斩颜良诛文丑之时，",
      "token_start": 261,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 66250,
      "end_ms": 68590,
      "text": "百万军中能取上将之首级，",
      "token_start": 273,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 68670,
      "end_ms": 69830,
      "text": "如探囊取物，",
      "token_start": 284,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 69950,
      "end_ms": 70490,
      "text": "反掌，",
      "token_start": 289,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 70630,
      "end_ms": 72590,
      "text": "官文一般率部北伐。",
      "token_start": 291,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 72690,
      "end_ms": 74430,
      "text": "他借连日暴雨的天时，",
      "token_start": 299,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 74590,
      "end_ms": 75510,
      "text": "水淹于尽，",
      "token_start": 308,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 75530,
      "end_ms": 77470,
      "text": "欺军生擒三万曹军，",
      "token_start": 312,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 77630,
      "end_ms": 78930,
      "text": "一度逼得曹操商议，",
      "token_start": 320,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 78930,
      "end_ms": 80235,
      "text": "迁都避其锋芒。",
      "token_start": 328,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 80510,
      "end_ms": 81250,
      "text": "从古至今，",
      "token_start": 334,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 81350,
      "end_ms": 82470,
      "text": "威震华夏者，",
      "token_start": 338,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 82470,
      "end_ms": 84485,
      "text": "唯有关云长一人而已。",
      "token_start": 343,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 84810,
      "end_ms": 85410,
      "text": "你知道吗？",
      "token_start": 352,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 85410,
      "end_ms": 86790,
      "text": "中国神仙那么多，",
      "token_start": 356,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 86850,
      "end_ms": 90640,
      "text": "但没有谁能像关公如佛道斯三教，",
      "token_start": 363,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 90700,
      "end_ms": 94090,
      "text": "并尊士农工商四名同伴儒家，",
      "token_start": 377,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 94090,
      "end_ms": 96010,
      "text": "尊他为武圣人和文圣人。",
      "token_start": 389,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 96010,
      "end_ms": 99245,
      "text": "孔子并列还被考生奉为文衡帝君，",
      "token_start": 399,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 99630,
      "end_ms": 102720,
      "text": "佛家封他为护法神奇兰菩萨、道家，",
      "token_start": 413,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 102720,
      "end_ms": 105465,
      "text": "把他奉为档魔除妖的关胜帝君。",
      "token_start": 427,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 105800,
      "end_ms": 107160,
      "text": "这一千八百多年间，",
      "token_start": 440,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 107160,
      "end_ms": 109525,
      "text": "十六位皇帝二十三次给他加封，",
      "token_start": 448,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 109870,
      "end_ms": 112050,
      "text": "从侯公王到大帝，",
      "token_start": 461,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 112150,
      "end_ms": 113845,
      "text": "最长封号打二十六个字。",
      "token_start": 468,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 114120,
      "end_ms": 116345,
      "text": "这一切都源于一个字义字。",
      "token_start": 478,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 116750,
      "end_ms": 120640,
      "text": "帝王看中他风金挂印千里寻凶的忠义百姓，",
      "token_start": 489,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 120660,
      "end_ms": 122360,
      "text": "需要他不求同年同日生，",
      "token_start": 507,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 122480,
      "end_ms": 125405,
      "text": "但求同年同月同日死的抱团情谊。",
      "token_start": 517,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 125760,
      "end_ms": 126700,
      "text": "商人敬重他，",
      "token_start": 531,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 126700,
      "end_ms": 127420,
      "text": "华容道义，",
      "token_start": 536,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 127420,
      "end_ms": 129020,
      "text": "是曹操报恩的信义。",
      "token_start": 540,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 129160,
      "end_ms": 130640,
      "text": "黑道拜他讲义气，",
      "token_start": 548,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 130820,
      "end_ms": 132595,
      "text": "白道敬他守诚信，",
      "token_start": 555,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 133080,
      "end_ms": 135740,
      "text": "老百姓不愿指拜那些高高在上的神明。",
      "token_start": 562,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 135760,
      "end_ms": 138325,
      "text": "大家发自内心的偏爱关二爷，",
      "token_start": 578,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 138690,
      "end_ms": 140290,
      "text": "感念他重情重义，",
      "token_start": 590,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 140330,
      "end_ms": 141190,
      "text": "体恤凡人，",
      "token_start": 597,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 141270,
      "end_ms": 143485,
      "text": "把他视作自家可靠的亲人一般，",
      "token_start": 601,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 143700,
      "end_ms": 145800,
      "text": "他永远是那位重守信诺，",
      "token_start": 614,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 145940,
      "end_ms": 147785,
      "text": "有血有肉的关二爷。",
      "token_start": 624,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 148120,
      "end_ms": 149760,
      "text": "你知道关公有多牛吗？",
      "token_start": 632,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 149900,
      "end_ms": 154555,
      "text": "全世界一百六十八个国家和地区有超过三万座关帝庙。",
      "token_start": 641,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 154950,
      "end_ms": 160875,
      "text": "从美国纽约、旧金山到神户、横滨、新加坡、曼谷等地关帝庙宇神龛随处可见，",
      "token_start": 664,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 161370,
      "end_ms": 163110,
      "text": "早年大批的华人下南洋，",
      "token_start": 694,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 163130,
      "end_ms": 164310,
      "text": "远赴美洲谋生，",
      "token_start": 704,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 164490,
      "end_ms": 164910,
      "text": "行囊，",
      "token_start": 710,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 164910,
      "end_ms": 167535,
      "text": "里面总会带上关公神像与牌位。",
      "token_start": 712,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 167990,
      "end_ms": 170370,
      "text": "北美的旧金山、纽约唐人街的商铺，",
      "token_start": 725,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 170430,
      "end_ms": 173120,
      "text": "家家供奉关公海外华人经商。",
      "token_start": 739,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 173140,
      "end_ms": 174120,
      "text": "一旦遇到纠纷，",
      "token_start": 751,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 174160,
      "end_ms": 175805,
      "text": "就会请出关公牌位。",
      "token_start": 757,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 176120,
      "end_ms": 177920,
      "text": "怪不得说凡有华人处，",
      "token_start": 765,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 177960,
      "end_ms": 178860,
      "text": "必有关公。",
      "token_start": 774,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 178860,
      "end_ms": 179980,
      "text": "在朱军，",
      "token_start": 778,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 179980,
      "end_ms": 181740,
      "text": "您看关羽头枕洛阳，",
      "token_start": 781,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 181800,
      "end_ms": 182700,
      "text": "身卧当阳，",
      "token_start": 789,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 182800,
      "end_ms": 183640,
      "text": "魂归故里，",
      "token_start": 793,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 183740,
      "end_ms": 184240,
      "text": "破阵，",
      "token_start": 797,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 184260,
      "end_ms": 185925,
      "text": "荆州位尊帝王庙。",
      "token_start": 799,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 186250,
      "end_ms": 188170,
      "text": "这是全世界最早的关帝庙。",
      "token_start": 806,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 188310,
      "end_ms": 191660,
      "text": "洛阳关林世界上最著名的两个陵，",
      "token_start": 817,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 191660,
      "end_ms": 193780,
      "text": "一个是孔圣人的曲服孔林，",
      "token_start": 831,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 193920,
      "end_ms": 196485,
      "text": "另外一个就是关圣人的洛阳关陵。",
      "token_start": 842,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 196840,
      "end_ms": 198480,
      "text": "你看这关公坟头上的树，",
      "token_start": 856,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 198540,
      "end_ms": 200020,
      "text": "只要长到五十八年，",
      "token_start": 866,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 200100,
      "end_ms": 201440,
      "text": "这些树不是枯死，",
      "token_start": 874,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 201460,
      "end_ms": 202515,
      "text": "就是被雷劈死。",
      "token_start": 881,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 202860,
      "end_ms": 203700,
      "text": "五十八岁，",
      "token_start": 887,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 203880,
      "end_ms": 206724,
      "text": "武圣人无头草木又岂敢冒头。",
      "token_start": 891,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 206990,
      "end_ms": 209070,
      "text": "而且关羽人墓一千多年以来，",
      "token_start": 903,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 209070,
      "end_ms": 211820,
      "text": "从来没有被盗过木门上的两个小孔，",
      "token_start": 915,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 211960,
      "end_ms": 212940,
      "text": "左求平安，",
      "token_start": 930,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 212980,
      "end_ms": 213905,
      "text": "右求富贵，",
      "token_start": 934,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 214150,
      "end_ms": 215610,
      "text": "老百姓塞个铜板进去。",
      "token_start": 938,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 215750,
      "end_ms": 217390,
      "text": "当当当一声响就表示，",
      "token_start": 947,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 217450,
      "end_ms": 219370,
      "text": "官老爷听见了朱金，",
      "token_start": 956,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 219710,
      "end_ms": 222685,
      "text": "您知道这洛阳关林是谁安排建设的吗？",
      "token_start": 964,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 223050,
      "end_ms": 226065,
      "text": "曹操以诸侯之礼厚葬关公，",
      "token_start": 980,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 226410,
      "end_ms": 229905,
      "text": "这曹操才是关羽最有分量的人格认证人。",
      "token_start": 991,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 230290,
      "end_ms": 231290,
      "text": "因为真正的人格，",
      "token_start": 1008,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 231290,
      "end_ms": 232690,
      "text": "不只是让朋友追随，",
      "token_start": 1015,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 232830,
      "end_ms": 234610,
      "text": "也会让对手敬重他，",
      "token_start": 1023,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 234610,
      "end_ms": 235470,
      "text": "不负旧义，",
      "token_start": 1031,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 235610,
      "end_ms": 236695,
      "text": "也不欠新恩。",
      "token_start": 1035,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 236980,
      "end_ms": 239015,
      "text": "每一份情奋都有交代。",
      "token_start": 1040,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 239350,
      "end_ms": 240210,
      "text": "在中国古代，",
      "token_start": 1049,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 240370,
      "end_ms": 241570,
      "text": "县县有文庙，",
      "token_start": 1054,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 241770,
      "end_ms": 243015,
      "text": "村村有武庙，",
      "token_start": 1059,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 243290,
      "end_ms": 243825,
      "text": "你敢信吗？",
      "token_start": 1064,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 244070,
      "end_ms": 245630,
      "text": "仅在山西运城一地，",
      "token_start": 1068,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 245690,
      "end_ms": 247775,
      "text": "就有大约两百座关帝庙。",
      "token_start": 1076,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 248230,
      "end_ms": 251150,
      "text": "这是湖北当阳关陵埋葬着关羽的身躯，",
      "token_start": 1086,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 251430,
      "end_ms": 252630,
      "text": "一部荆州城，",
      "token_start": 1102,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 252750,
      "end_ms": 253830,
      "text": "半部三国史，",
      "token_start": 1107,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 253830,
      "end_ms": 255605,
      "text": "被誉为天下第一关羽子。",
      "token_start": 1112,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 255940,
      "end_ms": 256260,
      "text": "你看，",
      "token_start": 1122,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 256460,
      "end_ms": 259660,
      "text": "这是世界上规模最大、保存最完整的关帝庙。",
      "token_start": 1124,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 259840,
      "end_ms": 260960,
      "text": "始建于隋代，",
      "token_start": 1142,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 261060,
      "end_ms": 262920,
      "text": "距今已有一千四百多年的历史，",
      "token_start": 1147,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 262940,
      "end_ms": 264415,
      "text": "被誉为官庙之祖。",
      "token_start": 1160,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 264690,
      "end_ms": 267510,
      "text": "它就是关于老家山西运城的谢州。",
      "token_start": 1167,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 267570,
      "end_ms": 268165,
      "text": "关帝庙，",
      "token_start": 1181,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 268480,
      "end_ms": 269460,
      "text": "身长九尺，",
      "token_start": 1184,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 269460,
      "end_ms": 270960,
      "text": "美人弓面如虫，",
      "token_start": 1188,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 270980,
      "end_ms": 272305,
      "text": "藻唇若图纸。",
      "token_start": 1194,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 272600,
      "end_ms": 273880,
      "text": "丹凤眼卧蚕眉，",
      "token_start": 1199,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 273960,
      "end_ms": 274820,
      "text": "相貌堂堂，",
      "token_start": 1205,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 274840,
      "end_ms": 275635,
      "text": "威风凛凛，",
      "token_start": 1209,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 275880,
      "end_ms": 276915,
      "text": "品读春秋。",
      "token_start": 1213,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 277390,
      "end_ms": 279990,
      "text": "这是全世界最大最重的关公铜像，",
      "token_start": 1217,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 280170,
      "end_ms": 282070,
      "text": "相当于二十多层楼的高度，",
      "token_start": 1231,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 282150,
      "end_ms": 284150,
      "text": "比美国的自由女神像还要高。",
      "token_start": 1242,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 284170,
      "end_ms": 286270,
      "text": "十五米人站在他的脚下，",
      "token_start": 1254,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 286270,
      "end_ms": 287965,
      "text": "甚至还没有他的脚趾高。",
      "token_start": 1264,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 288360,
      "end_ms": 289180,
      "text": "俗话说得好，",
      "token_start": 1274,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 289280,
      "end_ms": 290860,
      "text": "关公脚下走一走，",
      "token_start": 1279,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 291040,
      "end_ms": 293025,
      "text": "幸福长长又久久，",
      "token_start": 1286,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 293610,
      "end_ms": 295840,
      "text": "朱晶关公明明是武将，",
      "token_start": 1293,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 295980,
      "end_ms": 297865,
      "text": "但为什么说他是财神呢？",
      "token_start": 1302,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 298210,
      "end_ms": 300610,
      "text": "仔细观察您会发现公司的前台，",
      "token_start": 1312,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 300650,
      "end_ms": 301550,
      "text": "街边的小店，",
      "token_start": 1325,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 301690,
      "end_ms": 303775,
      "text": "甚至有一些搓澡的地方都供奉着。",
      "token_start": 1330,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 304010,
      "end_ms": 304610,
      "text": "关二爷，",
      "token_start": 1344,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 304770,
      "end_ms": 305730,
      "text": "这是为什么呢？",
      "token_start": 1347,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 305970,
      "end_ms": 306390,
      "text": "原来，",
      "token_start": 1353,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 306430,
      "end_ms": 308550,
      "text": "关公的老乡晋商走南闯北，",
      "token_start": 1355,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 308550,
      "end_ms": 311550,
      "text": "做生意就到处修建关公会馆和关帝庙。",
      "token_start": 1366,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 311750,
      "end_ms": 314370,
      "text": "因为生意做到最后拼的从来不只是算盘，",
      "token_start": 1382,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 314370,
      "end_ms": 315550,
      "text": "而是信用。",
      "token_start": 1399,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 315970,
      "end_ms": 318010,
      "text": "关公不是来教你怎么赚快钱的，",
      "token_start": 1403,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 318030,
      "end_ms": 320270,
      "text": "而是在财的面前给你立一条规矩。",
      "token_start": 1416,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 320530,
      "end_ms": 321950,
      "text": "利可以求义，",
      "token_start": 1430,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 322030,
      "end_ms": 323690,
      "text": "不能丢钱可以赚，",
      "token_start": 1435,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 323810,
      "end_ms": 324950,
      "text": "承诺不能破。",
      "token_start": 1442,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 325350,
      "end_ms": 326450,
      "text": "每次涉火表演，",
      "token_start": 1447,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 326450,
      "end_ms": 327150,
      "text": "关公的家候，",
      "token_start": 1453,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 327150,
      "end_ms": 329310,
      "text": "都会有很多带着孩子叩拜的家长。",
      "token_start": 1458,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 329530,
      "end_ms": 331890,
      "text": "关二爷手舞青龙偃月春秋刀，",
      "token_start": 1472,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 332010,
      "end_ms": 332490,
      "text": "斩除，",
      "token_start": 1484,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 332530,
      "end_ms": 333805,
      "text": "世间所有的不公。",
      "token_start": 1486,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 334320,
      "end_ms": 335640,
      "text": "如果科学解释不了，",
      "token_start": 1493,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 335640,
      "end_ms": 337420,
      "text": "那信仰就是最后的防线。",
      "token_start": 1501,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 337880,
      "end_ms": 338860,
      "text": "而你能想象吗？",
      "token_start": 1511,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 338960,
      "end_ms": 341380,
      "text": "关羽竟然还是世界警察之父，",
      "token_start": 1517,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 341660,
      "end_ms": 343940,
      "text": "关二爷曾经担任过别部司马，",
      "token_start": 1529,
      "token_end_exclusive": 1541
    },
    {
      "start_ms": 344000,
      "end_ms": 345260,
      "text": "相当于现在的警察。",
      "token_start": 1541,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 345340,
      "end_ms": 348200,
      "text": "你看香港很多警察局都有关羽的，",
      "token_start": 1549,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 348200,
      "end_ms": 349860,
      "text": "像特警队的警徽，",
      "token_start": 1563,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 349940,
      "end_ms": 350820,
      "text": "就是关老爷，",
      "token_start": 1570,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 350820,
      "end_ms": 351480,
      "text": "拿一把刀。",
      "token_start": 1575,
      "token_end_exclusive": 1579
    },
    {
      "start_ms": 352020,
      "end_ms": 354020,
      "text": "旧金山有一个执法联盟的警徽，",
      "token_start": 1579,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 354020,
      "end_ms": 355320,
      "text": "一看也是关老爷。",
      "token_start": 1592,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 355400,
      "end_ms": 355920,
      "text": "而如今，",
      "token_start": 1599,
      "token_end_exclusive": 1602
    },
    {
      "start_ms": 355920,
      "end_ms": 358660,
      "text": "在英国、加拿大、澳洲等地的华人警局，",
      "token_start": 1602,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 358800,
      "end_ms": 360580,
      "text": "都会摆放着关公塑像，",
      "token_start": 1617,
      "token_end_exclusive": 1626
    },
    {
      "start_ms": 360980,
      "end_ms": 362200,
      "text": "警员拜关公，",
      "token_start": 1626,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 362380,
      "end_ms": 363400,
      "text": "时刻提醒自己，",
      "token_start": 1631,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 363520,
      "end_ms": 365355,
      "text": "终于于国家忠于人民，",
      "token_start": 1637,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 365900,
      "end_ms": 366540,
      "text": "你知道吗？",
      "token_start": 1646,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 366540,
      "end_ms": 368725,
      "text": "关二爷可不是谁都能演的。",
      "token_start": 1650,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 369170,
      "end_ms": 371465,
      "text": "关公戏在梨园行里规矩极多，",
      "token_start": 1661,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 371750,
      "end_ms": 373490,
      "text": "扮演者全程都要心怀敬畏，",
      "token_start": 1673,
      "token_end_exclusive": 1684
    },
    {
      "start_ms": 373570,
      "end_ms": 373910,
      "text": "第一，",
      "token_start": 1684,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 373910,
      "end_ms": 375085,
      "text": "扮相要破脸，",
      "token_start": 1686,
      "token_end_exclusive": 1691
    },
    {
      "start_ms": 375560,
      "end_ms": 376700,
      "text": "脸谱上要点痣，",
      "token_start": 1691,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 376780,
      "end_ms": 377480,
      "text": "画细差，",
      "token_start": 1697,
      "token_end_exclusive": 1700
    },
    {
      "start_ms": 377560,
      "end_ms": 379440,
      "text": "不能画完整无缺的关公脸，",
      "token_start": 1700,
      "token_end_exclusive": 1711
    },
    {
      "start_ms": 379480,
      "end_ms": 380980,
      "text": "寓意演员只是模仿，",
      "token_start": 1711,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 381020,
      "end_ms": 382460,
      "text": "扮演并非真身，",
      "token_start": 1719,
      "token_end_exclusive": 1725
    },
    {
      "start_ms": 382500,
      "end_ms": 383235,
      "text": "以示恭敬。",
      "token_start": 1725,
      "token_end_exclusive": 1729
    },
    {
      "start_ms": 383610,
      "end_ms": 384430,
      "text": "早年老规矩，",
      "token_start": 1729,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 384430,
      "end_ms": 386345,
      "text": "甚至要点七颗破相痣。",
      "token_start": 1734,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 386610,
      "end_ms": 387035,
      "text": "第二，",
      "token_start": 1743,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 387190,
      "end_ms": 388810,
      "text": "办戏前后有斋戒，",
      "token_start": 1745,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 388830,
      "end_ms": 389230,
      "text": "晋身，",
      "token_start": 1752,
      "token_end_exclusive": 1754
    },
    {
      "start_ms": 389230,
      "end_ms": 389625,
      "text": "讲究。",
      "token_start": 1754,
      "token_end_exclusive": 1756
    },
    {
      "start_ms": 389910,
      "end_ms": 390370,
      "text": "旧时候，",
      "token_start": 1756,
      "token_end_exclusive": 1759
    },
    {
      "start_ms": 390370,
      "end_ms": 392285,
      "text": "演员上台前需要沐浴斋戒，",
      "token_start": 1759,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 392560,
      "end_ms": 393620,
      "text": "后台设香案，",
      "token_start": 1770,
      "token_end_exclusive": 1775
    },
    {
      "start_ms": 393660,
      "end_ms": 394440,
      "text": "祭拜关公，",
      "token_start": 1775,
      "token_end_exclusive": 1779
    },
    {
      "start_ms": 394660,
      "end_ms": 396180,
      "text": "勾脸穿戴行头的时候，",
      "token_start": 1779,
      "token_end_exclusive": 1788
    },
    {
      "start_ms": 396180,
      "end_ms": 397905,
      "text": "不能随意说笑、喧哗。",
      "token_start": 1788,
      "token_end_exclusive": 1796
    },
    {
      "start_ms": 398170,
      "end_ms": 398545,
      "text": "第三，",
      "token_start": 1796,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 398810,
      "end_ms": 401965,
      "text": "带好染口完整拌上之后不可以随意和人搭话，",
      "token_start": 1798,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 402230,
      "end_ms": 403990,
      "text": "直视旁人登台亮相，",
      "token_start": 1817,
      "token_end_exclusive": 1825
    },
    {
      "start_ms": 403990,
      "end_ms": 406150,
      "text": "也有专属的四十八式关公身段，",
      "token_start": 1825,
      "token_end_exclusive": 1838
    },
    {
      "start_ms": 406150,
      "end_ms": 407250,
      "text": "不能乱做姿态，",
      "token_start": 1838,
      "token_end_exclusive": 1844
    },
    {
      "start_ms": 407450,
      "end_ms": 409330,
      "text": "还有青龙偃月刀属于神械，",
      "token_start": 1844,
      "token_end_exclusive": 1855
    },
    {
      "start_ms": 409490,
      "end_ms": 409830,
      "text": "后台，",
      "token_start": 1855,
      "token_end_exclusive": 1857
    },
    {
      "start_ms": 409830,
      "end_ms": 411335,
      "text": "不能随意把玩磕碰。",
      "token_start": 1857,
      "token_end_exclusive": 1865
    },
    {
      "start_ms": 411650,
      "end_ms": 415905,
      "text": "这些老规矩就是梨元航前辈对忠义武圣的敬重。",
      "token_start": 1865,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 416580,
      "end_ms": 417440,
      "text": "朱军啊朱军，",
      "token_start": 1885,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 417700,
      "end_ms": 418680,
      "text": "您看这关羽，",
      "token_start": 1890,
      "token_end_exclusive": 1895
    },
    {
      "start_ms": 418820,
      "end_ms": 421180,
      "text": "从汉寿亭侯到关胜大帝，",
      "token_start": 1895,
      "token_end_exclusive": 1905
    },
    {
      "start_ms": 421300,
      "end_ms": 422120,
      "text": "千百年来，",
      "token_start": 1905,
      "token_end_exclusive": 1909
    },
    {
      "start_ms": 422280,
      "end_ms": 425010,
      "text": "一个败军之将却配享官庙，",
      "token_start": 1909,
      "token_end_exclusive": 1920
    },
    {
      "start_ms": 425110,
      "end_ms": 427570,
      "text": "被尊为武圣与文圣齐名。",
      "token_start": 1920,
      "token_end_exclusive": 1930
    },
    {
      "start_ms": 427810,
      "end_ms": 431050,
      "text": "只因为中国人相信成败不足以论英雄，",
      "token_start": 1930,
      "token_end_exclusive": 1946
    },
    {
      "start_ms": 431390,
      "end_ms": 432610,
      "text": "他没有守住荆州，",
      "token_start": 1946,
      "token_end_exclusive": 1953
    },
    {
      "start_ms": 432790,
      "end_ms": 434750,
      "text": "却替中国人守住了一个义字。",
      "token_start": 1953,
      "token_end_exclusive": 1965
    },
    {
      "start_ms": 434990,
      "end_ms": 436770,
      "text": "我们中国人真正的英雄关，",
      "token_start": 1965,
      "token_end_exclusive": 1976
    },
    {
      "start_ms": 436770,
      "end_ms": 438230,
      "text": "从来不是谁赢了，",
      "token_start": 1976,
      "token_end_exclusive": 1983
    },
    {
      "start_ms": 438230,
      "end_ms": 438990,
      "text": "我就崇拜谁，",
      "token_start": 1983,
      "token_end_exclusive": 1988
    },
    {
      "start_ms": 439130,
      "end_ms": 442230,
      "text": "而是你在输赢之外守住了什么。",
      "token_start": 1988,
      "token_end_exclusive": 2001
    },
    {
      "start_ms": 442590,
      "end_ms": 443910,
      "text": "关羽败走麦城，",
      "token_start": 2001,
      "token_end_exclusive": 2007
    },
    {
      "start_ms": 443930,
      "end_ms": 445710,
      "text": "没有完成匡扶汉室的大业。",
      "token_start": 2007,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 445870,
      "end_ms": 449290,
      "text": "诸葛亮六出祁山并是五丈原北伐失败。",
      "token_start": 2018,
      "token_end_exclusive": 2034
    },
    {
      "start_ms": 449450,
      "end_ms": 450870,
      "text": "岳飞败志未酬。",
      "token_start": 2034,
      "token_end_exclusive": 2040
    },
    {
      "start_ms": 450870,
      "end_ms": 452890,
      "text": "十二道金牌之后死于风波亭。",
      "token_start": 2040,
      "token_end_exclusive": 2052
    },
    {
      "start_ms": 453250,
      "end_ms": 454960,
      "text": "文天祥强兵败被俘，",
      "token_start": 2052,
      "token_end_exclusive": 2060
    },
    {
      "start_ms": 455040,
      "end_ms": 456260,
      "text": "南宋也没有获救。",
      "token_start": 2060,
      "token_end_exclusive": 2067
    },
    {
      "start_ms": 456580,
      "end_ms": 457940,
      "text": "项羽乌江自刎，",
      "token_start": 2067,
      "token_end_exclusive": 2073
    },
    {
      "start_ms": 458040,
      "end_ms": 459800,
      "text": "连天下都是刘邦的，",
      "token_start": 2073,
      "token_end_exclusive": 2081
    },
    {
      "start_ms": 460020,
      "end_ms": 461820,
      "text": "可中国人偏偏记住了，",
      "token_start": 2081,
      "token_end_exclusive": 2090
    },
    {
      "start_ms": 461820,
      "end_ms": 463860,
      "text": "他们事情可以没做成，",
      "token_start": 2090,
      "token_end_exclusive": 2099
    },
    {
      "start_ms": 464120,
      "end_ms": 464940,
      "text": "人不能垮，",
      "token_start": 2099,
      "token_end_exclusive": 2103
    },
    {
      "start_ms": 465220,
      "end_ms": 467300,
      "text": "江山可以失去气节，",
      "token_start": 2103,
      "token_end_exclusive": 2111
    },
    {
      "start_ms": 467300,
      "end_ms": 467820,
      "text": "不能丢。",
      "token_start": 2111,
      "token_end_exclusive": 2114
    },
    {
      "start_ms": 468320,
      "end_ms": 471520,
      "text": "世界上很多东西都可以靠努力争取成独，",
      "token_start": 2114,
      "token_end_exclusive": 2131
    },
    {
      "start_ms": 471620,
      "end_ms": 473920,
      "text": "遇到一个有情有义的人，",
      "token_start": 2131,
      "token_end_exclusive": 2141
    },
    {
      "start_ms": 474060,
      "end_ms": 476660,
      "text": "需要运气成是能力，",
      "token_start": 2141,
      "token_end_exclusive": 2149
    },
    {
      "start_ms": 476840,
      "end_ms": 478400,
      "text": "而败是命气。",
      "token_start": 2149,
      "token_end_exclusive": 2154
    },
    {
      "start_ms": 478700,
      "end_ms": 480020,
      "text": "但在成败之间，",
      "token_start": 2154,
      "token_end_exclusive": 2160
    },
    {
      "start_ms": 480260,
      "end_ms": 481700,
      "text": "如何守住人格，",
      "token_start": 2160,
      "token_end_exclusive": 2166
    },
    {
      "start_ms": 481940,
      "end_ms": 483525,
      "text": "这就是英雄。",
      "token_start": 2166,
      "token_end_exclusive": 2171
    }
  ],
