{
  "video_id": "v_c93dd57c844ff532",
  "duration_s": 572.344828,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c93dd57c844ff532.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c93dd57c844ff532.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 890,
      "text": "你见过吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1550,
      "end_ms": 2850,
      "text": "诺贝尔颁奖台上，",
      "token_start": 4,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3150,
      "end_ms": 7410,
      "text": "一个外国老头当着全世界的面单膝跪下，",
      "token_start": 11,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 8250,
      "end_ms": 9390,
      "text": "他不是在领奖，",
      "token_start": 28,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 9750,
      "end_ms": 13030,
      "text": "他是在给一位坐着的中国老太太举话筒，",
      "token_start": 34,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 13570,
      "end_ms": 14050,
      "text": "话筒，",
      "token_start": 51,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 14050,
      "end_ms": 15610,
      "text": "架太高线又短，",
      "token_start": 53,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15830,
      "end_ms": 16810,
      "text": "老太太够不着。",
      "token_start": 59,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 17570,
      "end_ms": 23090,
      "text": "大会副主席没叫工作人员自己直接跪在冰凉的大理石地上，",
      "token_start": 65,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 23510,
      "end_ms": 24830,
      "text": "一手扶着椅背，",
      "token_start": 90,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 25050,
      "end_ms": 26870,
      "text": "一手稳稳的举着话筒，",
      "token_start": 96,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 27350,
      "end_ms": 28770,
      "text": "一直举到老太太讲，",
      "token_start": 105,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 28770,
      "end_ms": 30480,
      "text": "完全又全场，",
      "token_start": 113,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 30480,
      "end_ms": 33040,
      "text": "先是敬的掉根针都能听见。",
      "token_start": 118,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 33780,
      "end_ms": 37540,
      "text": "接着掌声跟打雷似的震的耳朵嗡嗡响。",
      "token_start": 129,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 38400,
      "end_ms": 41660,
      "text": "这一跪跪的是对科学的敬畏，",
      "token_start": 145,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 42080,
      "end_ms": 47160,
      "text": "更是对一个救了几百万人命的中国医生的敬意。",
      "token_start": 157,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 47900,
      "end_ms": 48840,
      "text": "可你知道吗？",
      "token_start": 177,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 49080,
      "end_ms": 52240,
      "text": "就是这位让全世界都俯首的老太太，",
      "token_start": 182,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 52660,
      "end_ms": 55360,
      "text": "在咱们国内整整四十年，",
      "token_start": 197,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 55600,
      "end_ms": 59435,
      "text": "连名字都没几个人知道她叫屠呦呦。",
      "token_start": 207,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 60020,
      "end_ms": 63195,
      "text": "这事儿得从上世纪六十年代说起。",
      "token_start": 222,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 64300,
      "end_ms": 64780,
      "text": "那时候，",
      "token_start": 236,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 64780,
      "end_ms": 68185,
      "text": "越南战场上最要命的不是枪子儿，",
      "token_start": 239,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 68350,
      "end_ms": 70820,
      "text": "是文字被咬一口，",
      "token_start": 253,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 71200,
      "end_ms": 72425,
      "text": "染上疟疾，",
      "token_start": 260,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 72800,
      "end_ms": 74540,
      "text": "先冷得浑身打颤，",
      "token_start": 264,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 74680,
      "end_ms": 76325,
      "text": "骨头缝里都冒寒气，",
      "token_start": 271,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 76760,
      "end_ms": 78475,
      "text": "转眼又烧到四十度，",
      "token_start": 279,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 79040,
      "end_ms": 79820,
      "text": "说胡话，",
      "token_start": 287,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 80080,
      "end_ms": 80705,
      "text": "抽风，",
      "token_start": 290,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 81340,
      "end_ms": 83190,
      "text": "昏迷几天，",
      "token_start": 292,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 83190,
      "end_ms": 84015,
      "text": "人就没了。",
      "token_start": 296,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 84500,
      "end_ms": 88935,
      "text": "因疟疾倒下的士兵比重担的多了好几倍，",
      "token_start": 300,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 89560,
      "end_ms": 90625,
      "text": "不光是战场，",
      "token_start": 317,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 91090,
      "end_ms": 93150,
      "text": "全世界一百多个国家，",
      "token_start": 322,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 93210,
      "end_ms": 95585,
      "text": "上亿人被疟疾折腾，",
      "token_start": 331,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 96180,
      "end_ms": 98265,
      "text": "每年上百万人丢了命。",
      "token_start": 339,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 98810,
      "end_ms": 101205,
      "text": "西方大药厂砸了几十亿，",
      "token_start": 348,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 101530,
      "end_ms": 105215,
      "text": "筛了几十万种化学药全失败了，",
      "token_start": 358,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 106820,
      "end_ms": 108920,
      "text": "人类眼看着就要拿着病，",
      "token_start": 371,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 108920,
      "end_ms": 109545,
      "text": "没辙了。",
      "token_start": 381,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 110640,
      "end_ms": 111635,
      "text": "一九六七年，",
      "token_start": 384,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 112600,
      "end_ms": 117280,
      "text": "国家启动了代号五二三的秘密抗虐任务，",
      "token_start": 389,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 117360,
      "end_ms": 119485,
      "text": "全国调集力量找新药。",
      "token_start": 406,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 119950,
      "end_ms": 121010,
      "text": "一九六九年，",
      "token_start": 415,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 121410,
      "end_ms": 127110,
      "text": "这个烫手的山芋落到了北京一个三十九岁的女研究员手里，",
      "token_start": 420,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 127470,
      "end_ms": 128490,
      "text": "她叫屠呦呦，",
      "token_start": 445,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 128990,
      "end_ms": 130650,
      "text": "当时就是中医研究院，",
      "token_start": 450,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 130690,
      "end_ms": 132250,
      "text": "一个普通的科研人员，",
      "token_start": 459,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 132670,
      "end_ms": 133390,
      "text": "没名气，",
      "token_start": 468,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 133630,
      "end_ms": 134290,
      "text": "没头衔，",
      "token_start": 471,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 134550,
      "end_ms": 136630,
      "text": "连团队都是临时凑的。",
      "token_start": 474,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 137050,
      "end_ms": 139550,
      "text": "说是组长其实就那么几个人，",
      "token_start": 483,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 140110,
      "end_ms": 141470,
      "text": "要设备、没设备，",
      "token_start": 495,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 141690,
      "end_ms": 142430,
      "text": "要经费，",
      "token_start": 501,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 142470,
      "end_ms": 143150,
      "text": "没经费，",
      "token_start": 504,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 143370,
      "end_ms": 144070,
      "text": "要经验，",
      "token_start": 507,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 144070,
      "end_ms": 147880,
      "text": "没经验更难的是，",
      "token_start": 510,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 148540,
      "end_ms": 151700,
      "text": "那时候她两个女儿大的才四岁，",
      "token_start": 517,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 152020,
      "end_ms": 153440,
      "text": "小的还不会走路。",
      "token_start": 530,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 153540,
      "end_ms": 154980,
      "text": "丈夫在外地工作，",
      "token_start": 537,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 155160,
      "end_ms": 156420,
      "text": "家里根本顾不上，",
      "token_start": 544,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 157080,
      "end_ms": 159960,
      "text": "他咬咬牙把大女儿送去全托，",
      "token_start": 551,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 160400,
      "end_ms": 162400,
      "text": "把小女儿送回宁波老家，",
      "token_start": 563,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 162740,
      "end_ms": 166840,
      "text": "托给外婆带一家四口分居三地。",
      "token_start": 573,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 167420,
      "end_ms": 169660,
      "text": "后来有人问他舍得吗？",
      "token_start": 586,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 169940,
      "end_ms": 170860,
      "text": "他没说什么，",
      "token_start": 595,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 170860,
      "end_ms": 171740,
      "text": "豪言壮语，",
      "token_start": 600,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 172040,
      "end_ms": 174980,
      "text": "就说国家交给的任务得完成，",
      "token_start": 604,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 175480,
      "end_ms": 177960,
      "text": "接下来的日子就两个字，",
      "token_start": 616,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 178200,
      "end_ms": 178780,
      "text": "硬熬。",
      "token_start": 626,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 180000,
      "end_ms": 183200,
      "text": "他带着团队把老祖宗传下来的遗书，",
      "token_start": 628,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 183440,
      "end_ms": 190430,
      "text": "一本一本翻本草纲目肘后背疾方千金方，",
      "token_start": 643,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 190630,
      "end_ms": 194530,
      "text": "前前后后收集了两千多个药方，",
      "token_start": 660,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 194810,
      "end_ms": 201575,
      "text": "一个一个筛筛出六百四十多种可能有效的再一个一个市，",
      "token_start": 673,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 202210,
      "end_ms": 205315,
      "text": "整整数百次实验全失败，",
      "token_start": 697,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 205810,
      "end_ms": 207250,
      "text": "不是药效微弱，",
      "token_start": 707,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 207530,
      "end_ms": 209035,
      "text": "就是毒性超标。",
      "token_start": 713,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 209950,
      "end_ms": 211685,
      "text": "团队里有人开始动摇了，",
      "token_start": 719,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 212070,
      "end_ms": 213670,
      "text": "说是不是方向就不对，",
      "token_start": 729,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 213910,
      "end_ms": 215635,
      "text": "连西医都搞不定的事儿，",
      "token_start": 738,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 215870,
      "end_ms": 217705,
      "text": "翻老皇帝能有什么用？",
      "token_start": 748,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 218060,
      "end_ms": 218875,
      "text": "他没辩解，",
      "token_start": 757,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 219070,
      "end_ms": 219895,
      "text": "继续翻书，",
      "token_start": 761,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 220210,
      "end_ms": 221055,
      "text": "继续做实验。",
      "token_start": 765,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 221810,
      "end_ms": 230300,
      "text": "转机出现在一本一千七百年前的古书上东晋葛洪写的肘后背及方里。",
      "token_start": 770,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 230300,
      "end_ms": 231105,
      "text": "有一句话，",
      "token_start": 799,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 231650,
      "end_ms": 232745,
      "text": "青蒿一卧，",
      "token_start": 803,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 233310,
      "end_ms": 236655,
      "text": "沂水二生字叫去之，",
      "token_start": 807,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 237330,
      "end_ms": 238235,
      "text": "尽扶之。",
      "token_start": 815,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 239100,
      "end_ms": 240500,
      "text": "他盯着缴曲之。",
      "token_start": 818,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 240500,
      "end_ms": 242745,
      "text": "这三个字看了很久，",
      "token_start": 824,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 243600,
      "end_ms": 245080,
      "text": "老祖宗用的是字，",
      "token_start": 832,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 245280,
      "end_ms": 245835,
      "text": "是炮，",
      "token_start": 839,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 246270,
      "end_ms": 246925,
      "text": "是脚，",
      "token_start": 841,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 247590,
      "end_ms": 248745,
      "text": "也就是拧之，",
      "token_start": 843,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 249290,
      "end_ms": 249970,
      "text": "不是煎，",
      "token_start": 848,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 250210,
      "end_ms": 250850,
      "text": "不是熬。",
      "token_start": 851,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 251270,
      "end_ms": 253114,
      "text": "是不是高温煎煮，",
      "token_start": 854,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 253540,
      "end_ms": 257285,
      "text": "把青蒿里最关键的有效成分给破坏了，",
      "token_start": 861,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 257630,
      "end_ms": 259265,
      "text": "他一下子全明白了。",
      "token_start": 877,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 259660,
      "end_ms": 262875,
      "text": "之前所有的实验方向全错了。",
      "token_start": 885,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 263340,
      "end_ms": 263900,
      "text": "第二天，",
      "token_start": 897,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 264100,
      "end_ms": 266235,
      "text": "他就推翻了之前的全部方案。",
      "token_start": 900,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 267200,
      "end_ms": 268060,
      "text": "不用水煎，",
      "token_start": 912,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 268200,
      "end_ms": 269120,
      "text": "改用乙醚，",
      "token_start": 916,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 269160,
      "end_ms": 273095,
      "text": "低温提取乙醚沸点只有三十四点六度，",
      "token_start": 920,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 273530,
      "end_ms": 275525,
      "text": "能最大程度保住药性。",
      "token_start": 936,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 276280,
      "end_ms": 277480,
      "text": "可那时候条件差，",
      "token_start": 945,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 278180,
      "end_ms": 281375,
      "text": "实验室连像样的通风设备都没有，",
      "token_start": 952,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 281790,
      "end_ms": 284355,
      "text": "乙醚又刺鼻又有毒。",
      "token_start": 966,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 284810,
      "end_ms": 287495,
      "text": "白色的雾气弥漫整个房间，",
      "token_start": 974,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 288040,
      "end_ms": 289195,
      "text": "他戴着口罩，",
      "token_start": 985,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 289670,
      "end_ms": 291815,
      "text": "硬扛着继续记录数据。",
      "token_start": 990,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 292130,
      "end_ms": 292770,
      "text": "头晕了，",
      "token_start": 999,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 292810,
      "end_ms": 294590,
      "text": "就坐一会儿缓过来，",
      "token_start": 1002,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 294630,
      "end_ms": 296635,
      "text": "接着干没几天，",
      "token_start": 1010,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 297210,
      "end_ms": 299585,
      "text": "团队里好几个人开始头晕，",
      "token_start": 1016,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 300010,
      "end_ms": 300630,
      "text": "流鼻血，",
      "token_start": 1027,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 301390,
      "end_ms": 303910,
      "text": "屠呦呦自己的肝脏也受了损伤。",
      "token_start": 1030,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 304650,
      "end_ms": 306050,
      "text": "可他一步没退，",
      "token_start": 1043,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 306210,
      "end_ms": 307975,
      "text": "一九七一年十月四号。",
      "token_start": 1049,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 308350,
      "end_ms": 313650,
      "text": "第一百九十一号样品对疟原虫的抑制率达到了百分之百，",
      "token_start": 1058,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 314270,
      "end_ms": 316090,
      "text": "整个实验室沸腾了，",
      "token_start": 1082,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 316570,
      "end_ms": 319510,
      "text": "这百分之百意味着上亿。",
      "token_start": 1090,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 319810,
      "end_ms": 323570,
      "text": "被疟疾折磨的人终于看到了活路，",
      "token_start": 1100,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 323990,
      "end_ms": 324550,
      "text": "可高兴。",
      "token_start": 1114,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 324550,
      "end_ms": 325130,
      "text": "没多久，",
      "token_start": 1117,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 325310,
      "end_ms": 326270,
      "text": "新问题来了，",
      "token_start": 1120,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 326650,
      "end_ms": 332310,
      "text": "动物实验发现这个提取物有疑似毒性反应药能治病，",
      "token_start": 1125,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 332550,
      "end_ms": 334830,
      "text": "但给人吃到底安不安全，",
      "token_start": 1147,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 335370,
      "end_ms": 338520,
      "text": "没人敢拍胸脯按流流程，",
      "token_start": 1157,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 339480,
      "end_ms": 341560,
      "text": "得先做长期动物实验，",
      "token_start": 1167,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 341980,
      "end_ms": 343480,
      "text": "再慢慢等审批。",
      "token_start": 1176,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 343680,
      "end_ms": 345160,
      "text": "可疟季是季节病，",
      "token_start": 1182,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 345520,
      "end_ms": 348680,
      "text": "错过这几个月就得再等一年。",
      "token_start": 1189,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 349600,
      "end_ms": 353100,
      "text": "海南的疫病区每天都有人在发烧，",
      "token_start": 1201,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 353460,
      "end_ms": 356520,
      "text": "在死人几百万条命，",
      "token_start": 1215,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 357540,
      "end_ms": 358200,
      "text": "等不起。",
      "token_start": 1223,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 359520,
      "end_ms": 361180,
      "text": "屠呦呦做了一个决定，",
      "token_start": 1226,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 361660,
      "end_ms": 362620,
      "text": "拿自己先试，",
      "token_start": 1235,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 363520,
      "end_ms": 366340,
      "text": "他跟领导表态自己是族长。",
      "token_start": 1240,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 367200,
      "end_ms": 369390,
      "text": "第一个是出了事，",
      "token_start": 1251,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 369390,
      "end_ms": 372075,
      "text": "他担着一九七二年，",
      "token_start": 1258,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 372790,
      "end_ms": 376705,
      "text": "他和另外两名同事直接住进了北京东直门医院，",
      "token_start": 1266,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 377250,
      "end_ms": 381930,
      "text": "亲手把还没确定安全性的青蒿提取物喝了下去，",
      "token_start": 1286,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 382290,
      "end_ms": 383550,
      "text": "连吃了好几天，",
      "token_start": 1306,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 383770,
      "end_ms": 385625,
      "text": "每天记录身体反应。",
      "token_start": 1312,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 386170,
      "end_ms": 387210,
      "text": "后来有人问他，",
      "token_start": 1320,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 387410,
      "end_ms": 388295,
      "text": "你不怕吗？",
      "token_start": 1326,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 389030,
      "end_ms": 390875,
      "text": "这药万一有毒呢，",
      "token_start": 1330,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 391650,
      "end_ms": 393550,
      "text": "他没说什么豪言壮语，",
      "token_start": 1337,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 393650,
      "end_ms": 395265,
      "text": "就说没想那么多，",
      "token_start": 1346,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 396040,
      "end_ms": 399165,
      "text": "就想赶紧把药用到病人身上。",
      "token_start": 1353,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 399570,
      "end_ms": 402565,
      "text": "第一批药是他用自己的身体试出来的。",
      "token_start": 1365,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 403460,
      "end_ms": 404440,
      "text": "一九七二年，",
      "token_start": 1381,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 404640,
      "end_ms": 408320,
      "text": "青蒿素成功分离出来之后的事，",
      "token_start": 1386,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 408560,
      "end_ms": 409955,
      "text": "全世界都知道了。",
      "token_start": 1399,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 410850,
      "end_ms": 415105,
      "text": "世卫组织把青蒿素列为抗虐一线药物，",
      "token_start": 1406,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 415650,
      "end_ms": 419625,
      "text": "全球疟疾死亡率应声生降了一半以上。",
      "token_start": 1422,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 420080,
      "end_ms": 422930,
      "text": "光在非洲就有数不清的孩子，",
      "token_start": 1438,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 423030,
      "end_ms": 424890,
      "text": "因为这味药活了下来。",
      "token_start": 1450,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 424990,
      "end_ms": 426245,
      "text": "可讽刺的是什么？",
      "token_start": 1459,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 427170,
      "end_ms": 430415,
      "text": "从一九七二年到二零一一年，",
      "token_start": 1466,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 430850,
      "end_ms": 431885,
      "text": "将近四十年，",
      "token_start": 1478,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 432840,
      "end_ms": 436535,
      "text": "国内知道屠呦呦这个名字的人却寥寥无几。",
      "token_start": 1483,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 437360,
      "end_ms": 441675,
      "text": "因为那时候成果论文署名是集体很长一段时间，",
      "token_start": 1501,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 442020,
      "end_ms": 446570,
      "text": "没人知道背后的核心人物是他他就那么安安静静的。",
      "token_start": 1521,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 446570,
      "end_ms": 447865,
      "text": "在实验室里待着，",
      "token_start": 1543,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 448150,
      "end_ms": 449485,
      "text": "一呆就是一辈子。",
      "token_start": 1550,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 450130,
      "end_ms": 451165,
      "text": "在单位里，",
      "token_start": 1557,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 451400,
      "end_ms": 455320,
      "text": "他一直是最不起眼的那一个申报院士，",
      "token_start": 1561,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 455660,
      "end_ms": 458555,
      "text": "前前后后好几次每次都落选，",
      "token_start": 1577,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 458960,
      "end_ms": 460240,
      "text": "他一句牢骚没有，",
      "token_start": 1589,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 460320,
      "end_ms": 462875,
      "text": "还是天天泡实验室该干嘛干嘛。",
      "token_start": 1596,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 463510,
      "end_ms": 464330,
      "text": "直到后来，",
      "token_start": 1609,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 464670,
      "end_ms": 468550,
      "text": "一位美国专家到非洲调研发现青蒿素，",
      "token_start": 1613,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 468630,
      "end_ms": 471815,
      "text": "让当地疟疾死亡率直降一半。",
      "token_start": 1629,
      "token_end_exclusive": 1641
    },
    {
      "start_ms": 472310,
      "end_ms": 474315,
      "text": "特地跑到中国来寻根，",
      "token_start": 1641,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 474980,
      "end_ms": 477315,
      "text": "可他走访了多家参演单位。",
      "token_start": 1650,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 477830,
      "end_ms": 479905,
      "text": "家家都说成果是自己的，",
      "token_start": 1661,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 480410,
      "end_ms": 482455,
      "text": "根本查不到谁是关键人物。",
      "token_start": 1671,
      "token_end_exclusive": 1682
    },
    {
      "start_ms": 483100,
      "end_ms": 484495,
      "text": "最后他换了个问法，",
      "token_start": 1682,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 485060,
      "end_ms": 488065,
      "text": "您觉得第二重要的人是谁？",
      "token_start": 1690,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 489130,
      "end_ms": 491575,
      "text": "几家的答案出奇的一致。",
      "token_start": 1701,
      "token_end_exclusive": 1711
    },
    {
      "start_ms": 493040,
      "end_ms": 493620,
      "text": "屠呦呦，",
      "token_start": 1711,
      "token_end_exclusive": 1714
    },
    {
      "start_ms": 493760,
      "end_ms": 494745,
      "text": "二零一一年，",
      "token_start": 1714,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 495100,
      "end_ms": 501935,
      "text": "八十一岁的屠呦呦拿到了美国拉斯克奖医学界分量最重的奖项之一，",
      "token_start": 1719,
      "token_end_exclusive": 1748
    },
    {
      "start_ms": 502340,
      "end_ms": 506360,
      "text": "被称为诺奖风向标国人才。",
      "token_start": 1748,
      "token_end_exclusive": 1759
    },
    {
      "start_ms": 506380,
      "end_ms": 508635,
      "text": "第一次大规模的听说这个名字，",
      "token_start": 1759,
      "token_end_exclusive": 1772
    },
    {
      "start_ms": 509110,
      "end_ms": 513185,
      "text": "原来中国竟有这样一位了不起的科学家。",
      "token_start": 1772,
      "token_end_exclusive": 1789
    },
    {
      "start_ms": 514180,
      "end_ms": 516145,
      "text": "二零一五年十月五号，",
      "token_start": 1789,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 516710,
      "end_ms": 522705,
      "text": "八十五岁的屠呦呦是后来从电视新闻里才知道自己得了诺贝尔奖。",
      "token_start": 1798,
      "token_end_exclusive": 1826
    },
    {
      "start_ms": 523120,
      "end_ms": 526775,
      "text": "他耳朵背之前的很多事儿都后知后觉，",
      "token_start": 1826,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 527190,
      "end_ms": 528350,
      "text": "站上领奖台。",
      "token_start": 1842,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 528490,
      "end_ms": 529590,
      "text": "他满头白发，",
      "token_start": 1847,
      "token_end_exclusive": 1852
    },
    {
      "start_ms": 529910,
      "end_ms": 532125,
      "text": "穿着一身素雅的旗袍，",
      "token_start": 1852,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 532590,
      "end_ms": 533955,
      "text": "平静的说了一句，",
      "token_start": 1861,
      "token_end_exclusive": 1868
    },
    {
      "start_ms": 534700,
      "end_ms": 538575,
      "text": "青蒿素是中医药献给世界的礼物。",
      "token_start": 1868,
      "token_end_exclusive": 1882
    },
    {
      "start_ms": 539230,
      "end_ms": 539790,
      "text": "那一刻，",
      "token_start": 1882,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 540150,
      "end_ms": 543055,
      "text": "全世界都在为这位中国老太太鼓掌。",
      "token_start": 1885,
      "token_end_exclusive": 1900
    },
    {
      "start_ms": 543580,
      "end_ms": 544480,
      "text": "可你知道吗？",
      "token_start": 1900,
      "token_end_exclusive": 1905
    },
    {
      "start_ms": 544620,
      "end_ms": 546120,
      "text": "就算拿了诺贝尔奖，",
      "token_start": 1905,
      "token_end_exclusive": 1913
    },
    {
      "start_ms": 546180,
      "end_ms": 548075,
      "text": "就算全世界都认他，",
      "token_start": 1913,
      "token_end_exclusive": 1921
    },
    {
      "start_ms": 548480,
      "end_ms": 552530,
      "text": "屠呦呦到现在依然不是中国科学院的院士，",
      "token_start": 1921,
      "token_end_exclusive": 1939
    },
    {
      "start_ms": 553170,
      "end_ms": 555995,
      "text": "一个救了几百万人命的科学家，",
      "token_start": 1939,
      "token_end_exclusive": 1952
    },
    {
      "start_ms": 556620,
      "end_ms": 558780,
      "text": "一个拿了诺贝尔奖的科学家，",
      "token_start": 1952,
      "token_end_exclusive": 1964
    },
    {
      "start_ms": 559100,
      "end_ms": 563060,
      "text": "为什么在自己的国家连院士都评不上他？",
      "token_start": 1964,
      "token_end_exclusive": 1981
    },
    {
      "start_ms": 563060,
      "end_ms": 566405,
      "text": "这一辈子到底还亏欠了多少人，",
      "token_start": 1981,
      "token_end_exclusive": 1994
