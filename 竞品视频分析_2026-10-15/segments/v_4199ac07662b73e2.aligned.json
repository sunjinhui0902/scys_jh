{
  "video_id": "v_4199ac07662b73e2",
  "duration_s": 366.344828,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_4199ac07662b73e2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_4199ac07662b73e2.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 4290,
      "text": "一个六十四岁的老太太在菜摊前东挑西拣，",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5070,
      "end_ms": 7150,
      "text": "摊主见她衣服打满补丁，",
      "token_start": 18,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7410,
      "end_ms": 8350,
      "text": "翻了个白眼，",
      "token_start": 28,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8370,
      "end_ms": 8890,
      "text": "对她说，",
      "token_start": 33,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 9550,
      "end_ms": 11770,
      "text": "冬笋很贵的买不起，",
      "token_start": 36,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 11770,
      "end_ms": 12370,
      "text": "就别碰。",
      "token_start": 44,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 13750,
      "end_ms": 14690,
      "text": "老太太一愣，",
      "token_start": 47,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 15110,
      "end_ms": 15830,
      "text": "没说话，",
      "token_start": 52,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 16350,
      "end_ms": 17210,
      "text": "默默走了。",
      "token_start": 55,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 18190,
      "end_ms": 26010,
      "text": "小摊主哪里知道他刚刚羞辱的这个人是中国物理界第一位女院士，",
      "token_start": 59,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 26910,
      "end_ms": 33340,
      "text": "是被西方国家称为中国国的居里夫人的核物理科学家。",
      "token_start": 87,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 33660,
      "end_ms": 37640,
      "text": "她手里随便一项成果都够拿诺贝尔奖。",
      "token_start": 110,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 38480,
      "end_ms": 39740,
      "text": "更讽刺的是，",
      "token_start": 126,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 39820,
      "end_ms": 41660,
      "text": "她住的房子破破烂烂，",
      "token_start": 131,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 42200,
      "end_ms": 48780,
      "text": "却把价值上亿的苏州园林祖宅网师园无偿捐给了国家，",
      "token_start": 140,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 49320,
      "end_ms": 50460,
      "text": "他叫何泽惠。",
      "token_start": 163,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 51100,
      "end_ms": 52260,
      "text": "一九一四年，",
      "token_start": 168,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 52700,
      "end_ms": 56080,
      "text": "何泽慧出生在苏州的名门望族，",
      "token_start": 173,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 56700,
      "end_ms": 59020,
      "text": "他家祖上出过十五名进士，",
      "token_start": 186,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 59380,
      "end_ms": 60750,
      "text": "二十九、五个举人，",
      "token_start": 197,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 60990,
      "end_ms": 61870,
      "text": "兄弟姐妹，",
      "token_start": 204,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 61870,
      "end_ms": 63865,
      "text": "八个人出了六个院士。",
      "token_start": 208,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 64360,
      "end_ms": 65425,
      "text": "一九三二年，",
      "token_start": 217,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 65770,
      "end_ms": 68530,
      "text": "十八岁的何泽会参加高考，",
      "token_start": 222,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 68890,
      "end_ms": 71425,
      "text": "三千多人报考清华物理系，",
      "token_start": 233,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 71970,
      "end_ms": 72945,
      "text": "他考了第一名，",
      "token_start": 244,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 73410,
      "end_ms": 74670,
      "text": "结果开学没几天，",
      "token_start": 250,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 74770,
      "end_ms": 76730,
      "text": "系主任叶启孙找他谈话，",
      "token_start": 257,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 77070,
      "end_ms": 77310,
      "text": "说，",
      "token_start": 267,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 77350,
      "end_ms": 79170,
      "text": "女生学物理难有成就，",
      "token_start": 268,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 79470,
      "end_ms": 80515,
      "text": "劝他转系，",
      "token_start": 277,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 81090,
      "end_ms": 81530,
      "text": "何则，",
      "token_start": 281,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 81530,
      "end_ms": 82955,
      "text": "惠当场就火了。",
      "token_start": 283,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 83350,
      "end_ms": 86095,
      "text": "您这是歧视女性救国，",
      "token_start": 289,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 86460,
      "end_ms": 89665,
      "text": "何分男女就这么着，",
      "token_start": 298,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 90100,
      "end_ms": 91815,
      "text": "他应留在了物理系。",
      "token_start": 306,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 92320,
      "end_ms": 93020,
      "text": "毕业那年，",
      "token_start": 314,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 93240,
      "end_ms": 94120,
      "text": "物理系大半，",
      "token_start": 318,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 94120,
      "end_ms": 96465,
      "text": "男生因为课程太难退了学，",
      "token_start": 323,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 97060,
      "end_ms": 99145,
      "text": "他稳稳拿了全系第一。",
      "token_start": 334,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 99600,
      "end_ms": 102645,
      "text": "第二名是一个叫钱三强的男生，",
      "token_start": 343,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 103290,
      "end_ms": 105775,
      "text": "两个人在清华就互相欣赏，",
      "token_start": 356,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 106170,
      "end_ms": 108665,
      "text": "但谁也没捅破那层窗户纸，",
      "token_start": 367,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 109210,
      "end_ms": 111290,
      "text": "真正让他们下定决心走。",
      "token_start": 378,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 111290,
      "end_ms": 114405,
      "text": "科技救国这条路的是一次毕业考察。",
      "token_start": 388,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 116380,
      "end_ms": 117385,
      "text": "一九三六年，",
      "token_start": 403,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 118080,
      "end_ms": 120555,
      "text": "他们坐火车去外地考察，",
      "token_start": 408,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 121410,
      "end_ms": 124530,
      "text": "整节车厢的中国学生都挤在过道里，",
      "token_start": 418,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 124530,
      "end_ms": 130485,
      "text": "站着所有座位上堆满的日本人要倾销到中国的货物。",
      "token_start": 433,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 131040,
      "end_ms": 132320,
      "text": "在自己的国土上，",
      "token_start": 455,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 132520,
      "end_ms": 137785,
      "text": "中国人连个坐的地方都没有碰一下货物都会遭到训斥。",
      "token_start": 462,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 138620,
      "end_ms": 141875,
      "text": "满车厢的中国人敢怒不敢言，",
      "token_start": 485,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 142790,
      "end_ms": 143210,
      "text": "何则。",
      "token_start": 497,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 143210,
      "end_ms": 145115,
      "text": "惠攥紧了拳头。",
      "token_start": 499,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 145460,
      "end_ms": 145900,
      "text": "那一刻，",
      "token_start": 505,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 145900,
      "end_ms": 146635,
      "text": "他明白了，",
      "token_start": 508,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 146960,
      "end_ms": 147620,
      "text": "国家弱，",
      "token_start": 512,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 147920,
      "end_ms": 149985,
      "text": "老百姓连头都抬不起来。",
      "token_start": 515,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 150520,
      "end_ms": 153505,
      "text": "毕业后前三强去了法国学核物理，",
      "token_start": 525,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 153920,
      "end_ms": 157095,
      "text": "何泽会去了德国柏林高等工业大学，",
      "token_start": 539,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 157620,
      "end_ms": 158985,
      "text": "学的是弹道学，",
      "token_start": 554,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 159500,
      "end_ms": 163785,
      "text": "说白了就是研究枪炮子弹的整个专业。",
      "token_start": 560,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 164380,
      "end_ms": 166915,
      "text": "就他一个外国学生还是个女的。",
      "token_start": 576,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 167770,
      "end_ms": 168775,
      "text": "导师觉得奇怪，",
      "token_start": 589,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 169490,
      "end_ms": 170045,
      "text": "问他，",
      "token_start": 595,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 170410,
      "end_ms": 173435,
      "text": "你一个女孩子来学军工干什么？",
      "token_start": 597,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 174270,
      "end_ms": 175065,
      "text": "何作会说，",
      "token_start": 610,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 176000,
      "end_ms": 177955,
      "text": "我就是要打败日本侵略者。",
      "token_start": 614,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 178500,
      "end_ms": 179445,
      "text": "一九四三年，",
      "token_start": 625,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 179890,
      "end_ms": 184090,
      "text": "他凭借子弹飞行速度的研究拿下博士学位，",
      "token_start": 630,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 184610,
      "end_ms": 188150,
      "text": "随后进入海德堡威廉皇家核物理研究院。",
      "token_start": 648,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 188310,
      "end_ms": 189590,
      "text": "三十一岁那年，",
      "token_start": 665,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 189890,
      "end_ms": 193370,
      "text": "他发现了正负电子弹性碰撞现象，",
      "token_start": 671,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 194090,
      "end_ms": 197310,
      "text": "英国自然杂志称之为科学珍品。",
      "token_start": 685,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 197870,
      "end_ms": 199770,
      "text": "可他一点儿也高兴不起来。",
      "token_start": 698,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 200370,
      "end_ms": 201270,
      "text": "战争爆发，",
      "token_start": 709,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 201730,
      "end_ms": 204250,
      "text": "他和国内的亲人彻底失联了。",
      "token_start": 713,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 204670,
      "end_ms": 206170,
      "text": "彷徨无助的时候，",
      "token_start": 725,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 206270,
      "end_ms": 209435,
      "text": "他想起了远在法国的前三强，",
      "token_start": 732,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 209860,
      "end_ms": 210700,
      "text": "异国他乡，",
      "token_start": 744,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 211360,
      "end_ms": 213200,
      "text": "两个人开始书信往来，",
      "token_start": 748,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 213460,
      "end_ms": 214340,
      "text": "互相依靠。",
      "token_start": 757,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 214780,
      "end_ms": 215420,
      "text": "有一天，",
      "token_start": 761,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 215840,
      "end_ms": 217880,
      "text": "何泽慧收到一封信，",
      "token_start": 764,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 218480,
      "end_ms": 219300,
      "text": "打开一看，",
      "token_start": 772,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 219780,
      "end_ms": 220560,
      "text": "整封信，",
      "token_start": 776,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 220880,
      "end_ms": 222480,
      "text": "只有二十五个单词，",
      "token_start": 779,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 223400,
      "end_ms": 225000,
      "text": "翻译过来是这样写的。",
      "token_start": 787,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 225000,
      "end_ms": 226900,
      "text": "我向你提出结婚的请求，",
      "token_start": 796,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 227320,
      "end_ms": 228220,
      "text": "如能同意，",
      "token_start": 806,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 228460,
      "end_ms": 230200,
      "text": "我将等你一同回国。",
      "token_start": 810,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 231100,
      "end_ms": 232640,
      "text": "何则慧的回信更短，",
      "token_start": 818,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 233000,
      "end_ms": 234080,
      "text": "感谢你的爱情，",
      "token_start": 826,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 234440,
      "end_ms": 236060,
      "text": "我将对你永远忠诚。",
      "token_start": 832,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 236480,
      "end_ms": 238480,
      "text": "等我们见面后一同回国。",
      "token_start": 840,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 238480,
      "end_ms": 240115,
      "text": "一九四四六年，",
      "token_start": 850,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 240420,
      "end_ms": 241835,
      "text": "两人在巴黎结婚，",
      "token_start": 856,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 242180,
      "end_ms": 244835,
      "text": "双双进入居里实验室工作。",
      "token_start": 863,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 245450,
      "end_ms": 246490,
      "text": "婚后第二年，",
      "token_start": 874,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 246710,
      "end_ms": 253055,
      "text": "何泽惠在实验室里首次观测到了游河的三分裂和四分裂现象。",
      "token_start": 879,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 253670,
      "end_ms": 254675,
      "text": "这是什么概念？",
      "token_start": 905,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 255770,
      "end_ms": 258550,
      "text": "这是核爆炸的核心基本原理，",
      "token_start": 911,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 258610,
      "end_ms": 260535,
      "text": "是诺奖级别的发现。",
      "token_start": 923,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 261130,
      "end_ms": 261950,
      "text": "消息一出，",
      "token_start": 931,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 262070,
      "end_ms": 263555,
      "text": "整个科学界都炸了。",
      "token_start": 935,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 264160,
      "end_ms": 268485,
      "text": "各国媒体尊称他为中国的居里夫人。",
      "token_start": 943,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 269230,
      "end_ms": 271530,
      "text": "法国政府破格晋升前三强，",
      "token_start": 958,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 271530,
      "end_ms": 275965,
      "text": "为研究导师各种优厚待遇摆在他们面前，",
      "token_start": 969,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 276450,
      "end_ms": 278790,
      "text": "只要他们愿意下半辈子，",
      "token_start": 986,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 278790,
      "end_ms": 281785,
      "text": "可以在法国过最顶尖的科研生活，",
      "token_start": 996,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 282580,
      "end_ms": 285085,
      "text": "诺贝尔奖也只是时间问题。",
      "token_start": 1010,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 286080,
      "end_ms": 287145,
      "text": "但一九四八年，",
      "token_start": 1021,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 287640,
      "end_ms": 296670,
      "text": "他们做了一个让所有人都看不懂的决定放弃法国的高薪顶尖实验室和一切荣誉。",
      "token_start": 1027,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 296950,
      "end_ms": 299870,
      "text": "带着不足半岁的女儿回中国。",
      "token_start": 1061,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 300570,
      "end_ms": 303070,
      "text": "有人问他们为什么何则？",
      "token_start": 1073,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 303070,
      "end_ms": 305495,
      "text": "会说我们学的就是要回来。",
      "token_start": 1083,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 306010,
      "end_ms": 307030,
      "text": "没有说去了，",
      "token_start": 1094,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 307030,
      "end_ms": 308130,
      "text": "不想回来的。",
      "token_start": 1099,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 308490,
      "end_ms": 309630,
      "text": "故事讲到这儿，",
      "token_start": 1104,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 309630,
      "end_ms": 312810,
      "text": "你可能以为回国之后就是鲜花和掌声。",
      "token_start": 1110,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 313550,
      "end_ms": 314890,
      "text": "没有等待，",
      "token_start": 1126,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 314910,
      "end_ms": 319030,
      "text": "他们的是一个原子能事业完全空白的中国，",
      "token_start": 1130,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 319630,
      "end_ms": 321829,
      "text": "是西方国家的技术封锁，",
      "token_start": 1148,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 322270,
      "end_ms": 325490,
      "text": "是苏联专家突然撤走的烂摊子。",
      "token_start": 1158,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 325730,
      "end_ms": 329090,
      "text": "还有后来那段谁也想不到的遭遇，",
      "token_start": 1171,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 329210,
      "end_ms": 331230,
      "text": "他回国后到底经历了什么？",
      "token_start": 1185,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 331530,
      "end_ms": 338040,
      "text": "他又是怎么在一穷二白的条件下帮中国造出原子弹和氢弹的下集。",
      "token_start": 1196,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 338040,
      "end_ms": 338560,
      "text": "告诉你，",
      "token_start": 1224,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 339480,
      "end_ms": 341200,
      "text": "看到这儿先别划走，",
      "token_start": 1227,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 341760,
      "end_ms": 342400,
      "text": "点个赞，",
      "token_start": 1235,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 343600,
      "end_ms": 345700,
      "text": "是对这位老太太的敬意。",
      "token_start": 1238,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 345880,
      "end_ms": 347380,
      "text": "收藏起来讲，",
      "token_start": 1248,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 347420,
      "end_ms": 350300,
      "text": "给你的孩子听真正的明星，",
      "token_start": 1253,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 350700,
      "end_ms": 352860,
      "text": "从来不是舞台上的那些人，",
      "token_start": 1264,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 353280,
      "end_ms": 354660,
      "text": "转发给更多人，",
      "token_start": 1275,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 355280,
      "end_ms": 358380,
      "text": "让合泽会这个名字被更多人记住。",
      "token_start": 1281,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 358840,
      "end_ms": 359500,
      "text": "关注我，",
      "token_start": 1295,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 359680,
      "end_ms": 360520,
      "text": "下集更狠。",
      "token_start": 1298,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 360860,
      "end_ms": 363880,
      "text": "他帮中国造出了原子弹氢弹，",
      "token_start": 1302,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 363920,
      "end_ms": 366245,
      "text": "功劳簿上却没有他的名名字。",
      "token_start": 1314,
      "token_end_exclusive": 1326
    }
  ],
