  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_fae397f32afce779.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 3930,
      "text": "你信不信这个世界上比出轨更伤害婚姻的，",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4210,
      "end_ms": 6310,
      "text": "是把情绪甩给伴侣。",
      "token_start": 18,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6910,
      "end_ms": 7630,
      "text": "你发现没？",
      "token_start": 26,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7750,
      "end_ms": 9290,
      "text": "明明夫妻两个吵完了架，",
      "token_start": 30,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 9610,
      "end_ms": 10910,
      "text": "一方气已经消了，",
      "token_start": 40,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 11090,
      "end_ms": 13590,
      "text": "但是另一方却还在那生闷气，",
      "token_start": 47,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 14010,
      "end_ms": 14910,
      "text": "气的是什么？",
      "token_start": 59,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 15150,
      "end_ms": 18090,
      "text": "气的是对方根本就没有在乎我的感受。",
      "token_start": 64,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 18090,
      "end_ms": 21550,
      "text": "我们总把最差的脾气留给了外人，",
      "token_start": 80,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 21550,
      "end_ms": 24530,
      "text": "却把最差的脾气留给了爱人，",
      "token_start": 94,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 24530,
      "end_ms": 26750,
      "text": "反正想着总是一家人，",
      "token_start": 106,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 26750,
      "end_ms": 27130,
      "text": "怎么说，",
      "token_start": 115,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 27130,
      "end_ms": 28290,
      "text": "怎么做都没事儿，",
      "token_start": 118,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 28650,
      "end_ms": 29725,
      "text": "但你知道吗？",
      "token_start": 125,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 30120,
      "end_ms": 31300,
      "text": "家是讲爱的地方，",
      "token_start": 130,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 31560,
      "end_ms": 33040,
      "text": "不是情绪的垃圾桶，",
      "token_start": 137,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 33340,
      "end_ms": 34160,
      "text": "有情有爱，",
      "token_start": 145,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 34160,
      "end_ms": 37480,
      "text": "有效才是家家也不是战场，",
      "token_start": 149,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 37620,
      "end_ms": 39460,
      "text": "不要老想着赢夫妻，",
      "token_start": 160,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 39460,
      "end_ms": 40460,
      "text": "更不是敌人。",
      "token_start": 168,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 40640,
      "end_ms": 42560,
      "text": "不要总想着压着对方，",
      "token_start": 173,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 42580,
      "end_ms": 44960,
      "text": "一头真正毁到一个家庭的，",
      "token_start": 182,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 45040,
      "end_ms": 45780,
      "text": "不是贫穷，",
      "token_start": 193,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 46020,
      "end_ms": 47400,
      "text": "也不是多苦多累，",
      "token_start": 197,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 47620,
      "end_ms": 50160,
      "text": "而是无休止的负面情绪消耗。",
      "token_start": 204,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 50560,
      "end_ms": 51480,
      "text": "遇事不解决，",
      "token_start": 216,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 51780,
      "end_ms": 52960,
      "text": "只会发泄情绪，",
      "token_start": 221,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 53160,
      "end_ms": 55900,
      "text": "那么这个家迟早都会被掏空。",
      "token_start": 227,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 56740,
      "end_ms": 58900,
      "text": "所以啊下次在你想发火的时候，",
      "token_start": 239,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 59200,
      "end_ms": 60830,
      "text": "记得坚停三秒，",
      "token_start": 252,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 61190,
      "end_ms": 62890,
      "text": "把最坏的脾气留给自己，",
      "token_start": 258,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 63070,
      "end_ms": 65605,
      "text": "把最好的情绪留给家人，",
      "token_start": 268,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 65940,
      "end_ms": 67700,
      "text": "一个家庭相互扶软，",
      "token_start": 278,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 67960,
      "end_ms": 68820,
      "text": "轮流低头，",
      "token_start": 286,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 69160,
      "end_ms": 72715,
      "text": "彼此心疼才会越来越好。",
      "token_start": 290,
      "token_end_exclusive": 300
    }
  ],
