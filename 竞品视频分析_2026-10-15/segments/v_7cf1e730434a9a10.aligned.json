  "segments": [
    {
      "start_ms": 110,
      "end_ms": 2910,
      "text": "这是我听过关于自救最好的一段话，",
      "token_start": 0,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3690,
      "end_ms": 5130,
      "text": "我老想着出去走走，",
      "token_start": 15,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5730,
      "end_ms": 8070,
      "text": "有可能是我不知道该怎么活了。",
      "token_start": 23,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8770,
      "end_ms": 10330,
      "text": "有些钱看的像是挥霍，",
      "token_start": 36,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 10710,
      "end_ms": 11650,
      "text": "实则是救赎。",
      "token_start": 45,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 12050,
      "end_ms": 14770,
      "text": "你看一杯奶茶可以换十个鸡蛋，",
      "token_start": 50,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 15070,
      "end_ms": 18410,
      "text": "但是你不可能一口气吞下十个鸡蛋吧。",
      "token_start": 63,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 19290,
      "end_ms": 22430,
      "text": "一次远行改变的从来都不是地理位置，",
      "token_start": 79,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 22850,
      "end_ms": 27390,
      "text": "而是一个人在精神困顿里一点点把自己打捞上来的过程。",
      "token_start": 95,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 28450,
      "end_ms": 30000,
      "text": "所以请你珍惜自己，",
      "token_start": 119,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 30060,
      "end_ms": 32140,
      "text": "你身体里那些尚存的欲望，",
      "token_start": 127,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 32740,
      "end_ms": 33820,
      "text": "去想去的地方，",
      "token_start": 138,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 34060,
      "end_ms": 35140,
      "text": "是想吃的东西，",
      "token_start": 144,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 35500,
      "end_ms": 36620,
      "text": "见想见的人，",
      "token_start": 150,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 37220,
      "end_ms": 41700,
      "text": "因为你永远都不知道哪一天这些东西你就不想要了。",
      "token_start": 155,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 42600,
      "end_ms": 43560,
      "text": "生命的救赎，",
      "token_start": 177,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 43880,
      "end_ms": 46180,
      "text": "其实就藏在每一次想要出走的冲动，",
      "token_start": 182,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 46180,
      "end_ms": 48820,
      "text": "里藏在那些被当做是挥霍，",
      "token_start": 197,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 49640,
      "end_ms": 53585,
      "text": "却实实在在撑住你的瞬间里。",
      "token_start": 208,
      "token_end_exclusive": 220
    }
  ],
