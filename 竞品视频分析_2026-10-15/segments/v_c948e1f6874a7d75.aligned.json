{
  "video_id": "v_c948e1f6874a7d75",
  "duration_s": 203.766667,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c948e1f6874a7d75.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c948e1f6874a7d75.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 370,
      "end_ms": 1370,
      "text": "你能想象吗？",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1530,
      "end_ms": 3330,
      "text": "这位一百零四岁的老太太，",
      "token_start": 5,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3490,
      "end_ms": 5670,
      "text": "应该是中国最后一位贵族小姐。",
      "token_start": 16,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6090,
      "end_ms": 9550,
      "text": "汪曾祺、杨振宁是她在西南联大的同学。",
      "token_start": 29,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 9950,
      "end_ms": 12310,
      "text": "沈从文、巴金是她一生的知己。",
      "token_start": 45,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 13090,
      "end_ms": 13530,
      "text": "她说，",
      "token_start": 57,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 13530,
      "end_ms": 15730,
      "text": "呼啸山庄就是她翻译成中文的。",
      "token_start": 59,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 15930,
      "end_ms": 18530,
      "text": "她的丈夫赵瑞虹则翻译了小说红与黑，",
      "token_start": 72,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 18810,
      "end_ms": 23410,
      "text": "她的哥哥杨献义和大嫂、戴乃蝶被认为是翻译了整个中国的人。",
      "token_start": 88,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 24050,
      "end_ms": 25770,
      "text": "时代不是她的人生背景，",
      "token_start": 114,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 26050,
      "end_ms": 28050,
      "text": "她的人生就是时代本身。",
      "token_start": 124,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 28650,
      "end_ms": 31260,
      "text": "他的同辈人在世的已所剩无几，",
      "token_start": 134,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 31600,
      "end_ms": 32380,
      "text": "因为长寿，",
      "token_start": 147,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 32660,
      "end_ms": 34720,
      "text": "他几乎看到了所有人的结局。",
      "token_start": 151,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 35300,
      "end_ms": 37840,
      "text": "他叫杨毅文坛的一位祖母，",
      "token_start": 163,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 38900,
      "end_ms": 43520,
      "text": "杨毅先生的家在南京大学附近门口的芭蕉树苍翠欲滴。",
      "token_start": 174,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 43840,
      "end_ms": 47160,
      "text": "杨先生虽然一百零四岁了也依然是小女生，",
      "token_start": 197,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 47600,
      "end_ms": 50340,
      "text": "有人拜访时他都会描眉毛抹口红，",
      "token_start": 215,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 50680,
      "end_ms": 52080,
      "text": "他的思维非常敏捷，",
      "token_start": 229,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 52300,
      "end_ms": 53820,
      "text": "说起话来中气十足，",
      "token_start": 237,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 53860,
      "end_ms": 55840,
      "text": "根本不像一位一百多岁的老人，",
      "token_start": 245,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 56040,
      "end_ms": 57400,
      "text": "而且记忆力非常强，",
      "token_start": 258,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 57780,
      "end_ms": 60765,
      "text": "一个世纪前的往事连细节都记得很很清楚。",
      "token_start": 266,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 61460,
      "end_ms": 63755,
      "text": "杨毅十六岁就和巴金成了至交，",
      "token_start": 284,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 64130,
      "end_ms": 66085,
      "text": "后来认识了巴金的哥哥李瑶玲，",
      "token_start": 297,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 66500,
      "end_ms": 67835,
      "text": "他叫他大理先生，",
      "token_start": 310,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 68310,
      "end_ms": 69845,
      "text": "大力先生很喜欢音乐，",
      "token_start": 317,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 70250,
      "end_ms": 70990,
      "text": "有一段日子，",
      "token_start": 326,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 70990,
      "end_ms": 71695,
      "text": "每到下午，",
      "token_start": 331,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 71920,
      "end_ms": 75630,
      "text": "杨颖就会把房间里对接的窗户打开在留声机上，",
      "token_start": 335,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 75650,
      "end_ms": 76785,
      "text": "大声的放唱片。",
      "token_start": 355,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 77240,
      "end_ms": 79535,
      "text": "这是一个小女生和大李先生的秘密，",
      "token_start": 361,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 79860,
      "end_ms": 81655,
      "text": "大理先生每天都会经过这里，",
      "token_start": 376,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 81890,
      "end_ms": 83905,
      "text": "那音乐就是放给他听的。",
      "token_start": 388,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 84730,
      "end_ms": 86410,
      "text": "杨毅后来考上了西南联大，",
      "token_start": 398,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 86610,
      "end_ms": 88615,
      "text": "他与大理先生相约昆明见，",
      "token_start": 409,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 88890,
      "end_ms": 90785,
      "text": "但最终大李先生并没有出现。",
      "token_start": 420,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 91240,
      "end_ms": 92935,
      "text": "杨毅先生回忆往事时说，",
      "token_start": 432,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 93270,
      "end_ms": 95975,
      "text": "大李先生是不是他的初恋他不懂，",
      "token_start": 442,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 96330,
      "end_ms": 98285,
      "text": "但他曾经是他心里的一盏灯。",
      "token_start": 456,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 99230,
      "end_ms": 100525,
      "text": "在沈从文的建议下，",
      "token_start": 468,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 100790,
      "end_ms": 102735,
      "text": "杨颖就读了西南联大外文系，",
      "token_start": 476,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 103050,
      "end_ms": 105425,
      "text": "她的室友杜志理后来嫁给了杨振宁，",
      "token_start": 488,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 105720,
      "end_ms": 108120,
      "text": "而杨乙则被学长赵瑞虹追求。",
      "token_start": 503,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 108320,
      "end_ms": 109295,
      "text": "一九四零年，",
      "token_start": 515,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 109580,
      "end_ms": 111285,
      "text": "在那个战火纷飞的年代里，",
      "token_start": 520,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 111560,
      "end_ms": 112325,
      "text": "两人结婚。",
      "token_start": 531,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 113240,
      "end_ms": 114200,
      "text": "在特殊时期，",
      "token_start": 535,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 114280,
      "end_ms": 115865,
      "text": "哥哥杨现义被捕入狱，",
      "token_start": 540,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 116210,
      "end_ms": 118150,
      "text": "杨椅则一次次挨批斗，",
      "token_start": 549,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 118150,
      "end_ms": 118875,
      "text": "遭拳脚，",
      "token_start": 558,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 119190,
      "end_ms": 120490,
      "text": "甚至被当众扇耳光。",
      "token_start": 561,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 120890,
      "end_ms": 123115,
      "text": "罪名呢现在看起来简直荒唐，",
      "token_start": 569,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 123430,
      "end_ms": 128280,
      "text": "说他翻译的呼啸山庄宣扬了爱情至上在杨毅先生的身上。",
      "token_start": 581,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 128280,
      "end_ms": 128860,
      "text": "我明白了，",
      "token_start": 605,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 128860,
      "end_ms": 130275,
      "text": "什么叫做见过世面，",
      "token_start": 609,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 130650,
      "end_ms": 132125,
      "text": "那就是见过最好的，",
      "token_start": 617,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 132340,
      "end_ms": 133725,
      "text": "也承受过最坏的。",
      "token_start": 625,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 134080,
      "end_ms": 134465,
      "text": "他说，",
      "token_start": 632,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 134760,
      "end_ms": 138180,
      "text": "杨家人最骄傲的是在任何突然来临的事故，",
      "token_start": 634,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 138180,
      "end_ms": 139635,
      "text": "甚至劫难出现时，",
      "token_start": 652,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 139870,
      "end_ms": 142390,
      "text": "都能做到猝然临之而不精，",
      "token_start": 659,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 142590,
      "end_ms": 143985,
      "text": "无故加之而不怒。",
      "token_start": 670,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 144450,
      "end_ms": 145365,
      "text": "或许正因为此，",
      "token_start": 677,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 145630,
      "end_ms": 147705,
      "text": "杨家人有着惊人的长寿基因，",
      "token_start": 683,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 148120,
      "end_ms": 149635,
      "text": "母亲享年九十六岁。",
      "token_start": 695,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 149980,
      "end_ms": 151275,
      "text": "哥哥活到九十四岁，",
      "token_start": 703,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 151650,
      "end_ms": 153225,
      "text": "姐姐活到一百零二岁。",
      "token_start": 711,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 153990,
      "end_ms": 155890,
      "text": "杨毅先生今年出版了一本自传，",
      "token_start": 720,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 156130,
      "end_ms": 157754,
      "text": "回忆他百年的往事，",
      "token_start": 733,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 158130,
      "end_ms": 159390,
      "text": "让我非常感动的是，",
      "token_start": 741,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 159530,
      "end_ms": 161905,
      "text": "他依然为我在书上签下了名。",
      "token_start": 749,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 162450,
      "end_ms": 162850,
      "text": "我问他，",
      "token_start": 761,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 162850,
      "end_ms": 165005,
      "text": "有哪些话想对当下的年轻人说，",
      "token_start": 764,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 165270,
      "end_ms": 167375,
      "text": "他引用了基督山伯爵里的一句话，",
      "token_start": 777,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 167870,
      "end_ms": 172755,
      "text": "人类的全部智慧就包含在这两个词当中等待与希望。",
      "token_start": 791,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 173630,
      "end_ms": 175115,
      "text": "我似乎听懂了他的话语，",
      "token_start": 813,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 175730,
      "end_ms": 176665,
      "text": "冬天又要来了，",
      "token_start": 823,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 176930,
      "end_ms": 180175,
      "text": "但这片土地本来就不可能是四季如春的，",
      "token_start": 829,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 180550,
      "end_ms": 182605,
      "text": "与其祈求春天永远不走，",
      "token_start": 846,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 182920,
      "end_ms": 185505,
      "text": "不如想一想怎样去面对风和雨雪。",
      "token_start": 856,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 189130,
      "end_ms": 189800,
      "text": "嗯嗯。",
      "token_start": 870,
      "token_end_exclusive": 872
    }
  ],
