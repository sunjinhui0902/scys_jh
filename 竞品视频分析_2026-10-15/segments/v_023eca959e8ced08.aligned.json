{
  "video_id": "v_023eca959e8ced08",
  "duration_s": 701.708005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_023eca959e8ced08.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_023eca959e8ced08.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 450,
      "end_ms": 3690,
      "text": "朱军、给你一个亿和哈佛录取通知书，",
      "token_start": 0,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3950,
      "end_ms": 4890,
      "text": "你选哪一个？",
      "token_start": 15,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5550,
      "end_ms": 6110,
      "text": "你知道吗？",
      "token_start": 20,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6110,
      "end_ms": 9730,
      "text": "全世界最牛的大学门口竟然挂了一个猪头一百多年，",
      "token_start": 24,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 10330,
      "end_ms": 12130,
      "text": "今天挑战一口气跟你说清楚。",
      "token_start": 46,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12230,
      "end_ms": 14770,
      "text": "常春藤大学联盟朱军，",
      "token_start": 58,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 14950,
      "end_ms": 16970,
      "text": "你这辈子的苦已经吃完了。",
      "token_start": 67,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 17150,
      "end_ms": 19190,
      "text": "今天这八个学校任你挑选，",
      "token_start": 78,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 19510,
      "end_ms": 21650,
      "text": "你被自己的前途晾的睡不着觉。",
      "token_start": 89,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 21970,
      "end_ms": 22430,
      "text": "第一，",
      "token_start": 102,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 22470,
      "end_ms": 24930,
      "text": "哈佛大学创办于一六三六年，",
      "token_start": 104,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 25050,
      "end_ms": 28350,
      "text": "中国的明朝比美国建国还要早一百多年，",
      "token_start": 116,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 28590,
      "end_ms": 33700,
      "text": "一共走出一百六十为诺诺尔奖得主八位美国总统一百八十八位亿万富翁，",
      "token_start": 133,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 33900,
      "end_ms": 34500,
      "text": "你知道吗？",
      "token_start": 164,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 34500,
      "end_ms": 36880,
      "text": "哈佛是全球最难申请的大学之一，",
      "token_start": 168,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 37000,
      "end_ms": 38700,
      "text": "每一年录取中国本科生，",
      "token_start": 182,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 38700,
      "end_ms": 39760,
      "text": "不到十位学生，",
      "token_start": 192,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 40060,
      "end_ms": 41620,
      "text": "二零二四年录取了九个，",
      "token_start": 198,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 41640,
      "end_ms": 43180,
      "text": "二零二五年录取了八个，",
      "token_start": 208,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 43500,
      "end_ms": 45640,
      "text": "但是收到非常重视中国文化，",
      "token_start": 218,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 45900,
      "end_ms": 48340,
      "text": "这是哈佛副教务长在用中文演讲，",
      "token_start": 230,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 48580,
      "end_ms": 50680,
      "text": "谢谢你们把哈佛当做自己的家，",
      "token_start": 244,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 50940,
      "end_ms": 51820,
      "text": "也感谢各位，",
      "token_start": 257,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 52060,
      "end_ms": 54400,
      "text": "让我们的大学变得更加优秀。",
      "token_start": 262,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 54780,
      "end_ms": 58600,
      "text": "如果你不小心被哈佛录取了当你收到录取通知书的那一刻，",
      "token_start": 274,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 58780,
      "end_ms": 61965,
      "text": "你就进入了地球上汇聚全市的顶级中枢，",
      "token_start": 299,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 62330,
      "end_ms": 64165,
      "text": "左手白宫、右手华尔街，",
      "token_start": 316,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 64520,
      "end_ms": 66680,
      "text": "这就是你在哈佛大学每天要走的门，",
      "token_start": 325,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 66840,
      "end_ms": 67545,
      "text": "智慧门，",
      "token_start": 340,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 67820,
      "end_ms": 70180,
      "text": "你看哈佛门口挂着一个猪头，",
      "token_start": 343,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 70480,
      "end_ms": 71060,
      "text": "啥意思？",
      "token_start": 355,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 71160,
      "end_ms": 72505,
      "text": "猪来了都会有智慧吗？",
      "token_start": 358,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 73020,
      "end_ms": 75100,
      "text": "哈佛光图书馆就有七十多座，",
      "token_start": 367,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 75100,
      "end_ms": 76695,
      "text": "有十二个本科宿舍楼，",
      "token_start": 379,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 76980,
      "end_ms": 78515,
      "text": "每一栋楼都有自己的徽章。",
      "token_start": 388,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 78810,
      "end_ms": 83740,
      "text": "这里培养的是美国东部最老牌最老钱的一群人从这里走出去的你，",
      "token_start": 399,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 83820,
      "end_ms": 85675,
      "text": "手里拿的不仅仅是一张文凭，",
      "token_start": 427,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 85930,
      "end_ms": 87885,
      "text": "而是一柄执掌时代的权杖。",
      "token_start": 439,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 88340,
      "end_ms": 89835,
      "text": "哈佛校训只有一个词，",
      "token_start": 450,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 90240,
      "end_ms": 90740,
      "text": "真理，",
      "token_start": 459,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 91350,
      "end_ms": 91950,
      "text": "你知道吗？",
      "token_start": 461,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 91950,
      "end_ms": 92710,
      "text": "在一年以前，",
      "token_start": 465,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 92730,
      "end_ms": 95845,
      "text": "哈佛曾经被强制要求停止接收国际留学生，",
      "token_start": 470,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 96050,
      "end_ms": 97590,
      "text": "并且要求他们全部转学。",
      "token_start": 488,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 97730,
      "end_ms": 98095,
      "text": "但是，",
      "token_start": 498,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 98400,
      "end_ms": 99900,
      "text": "哈佛打响了不自由，",
      "token_start": 500,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 99900,
      "end_ms": 101055,
      "text": "勿宁死的第一枪，",
      "token_start": 508,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 101370,
      "end_ms": 103695,
      "text": "郑重拒绝当局一系列非法要求。",
      "token_start": 515,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 104010,
      "end_ms": 104650,
      "text": "结果当天，",
      "token_start": 528,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 104770,
      "end_ms": 106655,
      "text": "哈佛的拨款就被全部冻结，",
      "token_start": 532,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 107230,
      "end_ms": 109030,
      "text": "大量校友自愿捐款，",
      "token_start": 543,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 109130,
      "end_ms": 110875,
      "text": "教授自愿降低薪资，",
      "token_start": 551,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 111140,
      "end_ms": 114115,
      "text": "只为捍卫每一个年轻人平等接受教育的权利。",
      "token_start": 559,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 114640,
      "end_ms": 116235,
      "text": "究竟何谓大学？",
      "token_start": 578,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 116580,
      "end_ms": 117395,
      "text": "人类先锋？",
      "token_start": 584,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 117910,
      "end_ms": 118710,
      "text": "从去年开始，",
      "token_start": 588,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 118710,
      "end_ms": 122255,
      "text": "哈佛大学就在官网上放出了超过一百五十门顶级课程，",
      "token_start": 593,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 122540,
      "end_ms": 124645,
      "text": "全部零门槛全球开放。",
      "token_start": 616,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 125360,
      "end_ms": 126920,
      "text": "这是哈佛著名的铜像，",
      "token_start": 625,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 127040,
      "end_ms": 128280,
      "text": "他叫约翰哈佛，",
      "token_start": 634,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 128360,
      "end_ms": 129515,
      "text": "一个屠夫的儿子，",
      "token_start": 640,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 129770,
      "end_ms": 132465,
      "text": "一个在伦敦酒馆里擦桌子长大的孤儿，",
      "token_start": 647,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 132790,
      "end_ms": 134645,
      "text": "甚至没来得及活到三十二岁。",
      "token_start": 663,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 134950,
      "end_ms": 138370,
      "text": "他在临终前将财产和藏书捐赠给了一座新学校。",
      "token_start": 675,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 138510,
      "end_ms": 140025,
      "text": "这就是后来的哈佛大学，",
      "token_start": 695,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 140430,
      "end_ms": 142595,
      "text": "它同向左脚已经被摸得锃亮，",
      "token_start": 705,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 142900,
      "end_ms": 147240,
      "text": "因为全世界各地的人们相信看到他就能感受到知识，",
      "token_start": 717,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 147370,
      "end_ms": 148515,
      "text": "可以改变命运。",
      "token_start": 739,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 149120,
      "end_ms": 149535,
      "text": "第二，",
      "token_start": 745,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 149670,
      "end_ms": 152695,
      "text": "哥伦比亚大学录取中国学生最多的成效。",
      "token_start": 747,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 152970,
      "end_ms": 162040,
      "text": "二零二五年一共录取了中国学生六千三百七十二人我这几天在各大上课发现这里中文要比英文还要亲切朱晶。",
      "token_start": 764,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 162340,
      "end_ms": 164420,
      "text": "今天你的母校是哥伦比亚大学，",
      "token_start": 811,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 164440,
      "end_ms": 167105,
      "text": "你就登上了全球话语权的绝对高地。",
      "token_start": 824,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 167450,
      "end_ms": 168730,
      "text": "左手普利策右手，",
      "token_start": 839,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 168730,
      "end_ms": 170440,
      "text": "联合国窗外是华尔街，",
      "token_start": 846,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 170460,
      "end_ms": 171535,
      "text": "手里是柏拉图。",
      "token_start": 855,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 171940,
      "end_ms": 174225,
      "text": "你的校友有一百零位获得了诺奖，",
      "token_start": 861,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 174480,
      "end_ms": 175445,
      "text": "下一个就是你。",
      "token_start": 875,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 175760,
      "end_ms": 178380,
      "text": "它是北美第一个实现原子核裂变的地方，",
      "token_start": 881,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 178440,
      "end_ms": 180245,
      "text": "是曼哈顿计划的诞生地。",
      "token_start": 898,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 180520,
      "end_ms": 182940,
      "text": "而全球新闻界最高奖项普利策奖，",
      "token_start": 908,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 182940,
      "end_ms": 184424,
      "text": "每一年都在各大颁发，",
      "token_start": 922,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 184810,
      "end_ms": 186945,
      "text": "这里培养了二十九位奥斯卡得主。",
      "token_start": 931,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 187250,
      "end_ms": 189530,
      "text": "你的学长学姐们一边造原子弹，",
      "token_start": 945,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 189530,
      "end_ms": 190525,
      "text": "一边拿奥斯卡，",
      "token_start": 958,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 190930,
      "end_ms": 191630,
      "text": "而你知道吗？",
      "token_start": 964,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 191630,
      "end_ms": 194725,
      "text": "中国近代史的半壁江山都在各大读过书。",
      "token_start": 969,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 195040,
      "end_ms": 204870,
      "text": "三位北大校长胡适、蒋梦琳、马云初、南开大学创始人张柏霖、侯氏质检法、发明人、侯德榜、原子弹之母、吴建雄等等。",
      "token_start": 986,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 204910,
      "end_ms": 206165,
      "text": "群星闪耀时，",
      "token_start": 1031,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 206740,
      "end_ms": 210115,
      "text": "你看哥大的这尊铜像里藏着一只猫头鹰，",
      "token_start": 1036,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 210370,
      "end_ms": 212655,
      "text": "据说谁先找到他就是最聪明的人，",
      "token_start": 1053,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 212930,
      "end_ms": 214355,
      "text": "你看到那只猫头鹰了吗？",
      "token_start": 1067,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 214720,
      "end_ms": 216820,
      "text": "今天在各大厅弗兰克教授讲课，",
      "token_start": 1077,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 217080,
      "end_ms": 219895,
      "text": "没想到这么朴素的老爷子也是诺贝尔奖得主，",
      "token_start": 1090,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 220260,
      "end_ms": 222055,
      "text": "很羡慕在这里上学的同学们，",
      "token_start": 1109,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 222460,
      "end_ms": 224715,
      "text": "环境才是人生最大的奢侈品。",
      "token_start": 1121,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 225360,
      "end_ms": 225780,
      "text": "第三，",
      "token_start": 1133,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 225840,
      "end_ms": 227650,
      "text": "宾夕法尼亚大学诞生，",
      "token_start": 1135,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 227670,
      "end_ms": 232255,
      "text": "亿万富翁最多的学校从这里走出了巴菲特、马斯克、特朗普。",
      "token_start": 1144,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 232730,
      "end_ms": 234055,
      "text": "也许你没有来过冰大，",
      "token_start": 1168,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 234210,
      "end_ms": 236730,
      "text": "但是你一定见过一百美元上的美国国父，",
      "token_start": 1177,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 236850,
      "end_ms": 239015,
      "text": "他就是宾夕法尼亚大学的创办人。",
      "token_start": 1194,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 239240,
      "end_ms": 242415,
      "text": "富兰克林冰大绝对是美国最务实的大学，",
      "token_start": 1208,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 242670,
      "end_ms": 246035,
      "text": "当其他的学校还沉浸在古典学和神学的世界里。",
      "token_start": 1225,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 246290,
      "end_ms": 250735,
      "text": "滨大创立了全美第一所医学院全球最著名的沃顿商学院。",
      "token_start": 1245,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 251100,
      "end_ms": 252580,
      "text": "一九四六年历史上，",
      "token_start": 1269,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 252580,
      "end_ms": 254945,
      "text": "第一台通用电子计算机在这里诞生，",
      "token_start": 1277,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 255180,
      "end_ms": 257205,
      "text": "从此开启了人类信息时代。",
      "token_start": 1292,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 257430,
      "end_ms": 258470,
      "text": "川普逢人就说，",
      "token_start": 1303,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 258610,
      "end_ms": 260050,
      "text": "我是一个非常聪明的人，",
      "token_start": 1309,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 260050,
      "end_ms": 261825,
      "text": "因为我念的是沃顿商学院。",
      "token_start": 1319,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 262150,
      "end_ms": 263985,
      "text": "这里是全球CEO的摇篮。",
      "token_start": 1330,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 264270,
      "end_ms": 267275,
      "text": "雅诗兰黛家族的四位继承人都是冰大校友，",
      "token_start": 1339,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 267550,
      "end_ms": 269315,
      "text": "这里更是行业规则的定义者，",
      "token_start": 1357,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 269680,
      "end_ms": 272295,
      "text": "现代金融市场、营销管理资讯等等，",
      "token_start": 1369,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 272580,
      "end_ms": 275495,
      "text": "一切你能想象的金融名词都来源于此。",
      "token_start": 1383,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 275800,
      "end_ms": 277100,
      "text": "当你从兵大毕业，",
      "token_start": 1399,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 277160,
      "end_ms": 279905,
      "text": "你将享受赢者通吃的巅峰人生。",
      "token_start": 1406,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 280460,
      "end_ms": 282985,
      "text": "我在滨大的博物馆里看到了很多中国文物，",
      "token_start": 1419,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 283280,
      "end_ms": 286380,
      "text": "唐太宗昭陵六郡竟然有三分之一不在中国。",
      "token_start": 1437,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 286540,
      "end_ms": 289400,
      "text": "而在宾夕法尼亚大学并大两年之前，",
      "token_start": 1455,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 289400,
      "end_ms": 292845,
      "text": "给一位中国女学生补发了一张迟到了一百年的学位证书。",
      "token_start": 1470,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 293080,
      "end_ms": 294365,
      "text": "他就是灵魂。",
      "token_start": 1494,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 294730,
      "end_ms": 301310,
      "text": "从兵大走出了中国第一代建筑学者、梁思成林徽因杨廷宝、童俊、范文照等等。",
      "token_start": 1499,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 301710,
      "end_ms": 303170,
      "text": "如今每一年都有几百位，",
      "token_start": 1530,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 303170,
      "end_ms": 304830,
      "text": "中国留学生在兵大读书，",
      "token_start": 1540,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 305110,
      "end_ms": 306390,
      "text": "一口流利普通话，",
      "token_start": 1550,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 306490,
      "end_ms": 307890,
      "text": "家住宾夕法尼亚。",
      "token_start": 1557,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 308110,
      "end_ms": 311170,
      "text": "但是朱军你知道为什么广东人不要轻易报考？",
      "token_start": 1564,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 311310,
      "end_ms": 312010,
      "text": "兵大嘛。",
      "token_start": 1583,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 312230,
      "end_ms": 312730,
      "text": "第四，",
      "token_start": 1586,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 312750,
      "end_ms": 316010,
      "text": "普林斯顿大学美国人眼里公认最好的大学，",
      "token_start": 1588,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 316070,
      "end_ms": 316790,
      "text": "没有之一。",
      "token_start": 1606,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 317070,
      "end_ms": 320030,
      "text": "二零二六年全球只诞生了四位菲尔斯奖得主。",
      "token_start": 1610,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 320030,
      "end_ms": 323990,
      "text": "其中三个都是他的校友最赚钱的商学院法学院医学院，",
      "token_start": 1629,
      "token_end_exclusive": 1652
    },
    {
      "start_ms": 323990,
      "end_ms": 326360,
      "text": "他居院一个都没有两百多年来，",
      "token_start": 1652,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 326360,
      "end_ms": 327240,
      "text": "只干一件事，",
      "token_start": 1665,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 327280,
      "end_ms": 328500,
      "text": "死磕基础学科，",
      "token_start": 1670,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 328980,
      "end_ms": 331140,
      "text": "只有八百人的数学系到底有多猛？",
      "token_start": 1676,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 331500,
      "end_ms": 333940,
      "text": "纳什均衡博弈论的开山之作，",
      "token_start": 1690,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 334180,
      "end_ms": 337900,
      "text": "费马大定理数学界最难砍的骨头在这里被证明，",
      "token_start": 1702,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 338300,
      "end_ms": 340000,
      "text": "一个只有八千多人的大学，",
      "token_start": 1722,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 340140,
      "end_ms": 343400,
      "text": "却产出了足以匹敌一个国家的顶级人才密度。",
      "token_start": 1733,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 343840,
      "end_ms": 346460,
      "text": "贝尔斯奖历史上一共六十八位得主，",
      "token_start": 1752,
      "token_end_exclusive": 1767
    },
    {
      "start_ms": 346520,
      "end_ms": 349640,
      "text": "有四十九位都来自普林斯顿、爱因斯坦。",
      "token_start": 1767,
      "token_end_exclusive": 1783
    },
    {
      "start_ms": 349640,
      "end_ms": 351720,
      "text": "生命最后二十二年没有住在纽约，",
      "token_start": 1783,
      "token_end_exclusive": 1797
    },
    {
      "start_ms": 351840,
      "end_ms": 353840,
      "text": "而是躲进了这个没有人打扰的小镇。",
      "token_start": 1797,
      "token_end_exclusive": 1812
    },
    {
      "start_ms": 353840,
      "end_ms": 354965,
      "text": "普林金斯顿，",
      "token_start": 1812,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 355590,
      "end_ms": 358855,
      "text": "这里很清高的坚守了近三百年的基因主义传统，",
      "token_start": 1817,
      "token_end_exclusive": 1837
    },
    {
      "start_ms": 359240,
      "end_ms": 361985,
      "text": "窄窄的校门指向天资最高的学生开放。",
      "token_start": 1837,
      "token_end_exclusive": 1853
    },
    {
      "start_ms": 362340,
      "end_ms": 363500,
      "text": "可你一旦进入校园，",
      "token_start": 1853,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 363560,
      "end_ms": 366035,
      "text": "你接受的就是全世界最优质的教育。",
      "token_start": 1861,
      "token_end_exclusive": 1876
    },
    {
      "start_ms": 366240,
      "end_ms": 366600,
      "text": "在这里，",
      "token_start": 1876,
      "token_end_exclusive": 1879
    },
    {
      "start_ms": 366600,
      "end_ms": 369155,
      "text": "所有的学生都拿同一个学位、文学士，",
      "token_start": 1879,
      "token_end_exclusive": 1894
    },
    {
      "start_ms": 369510,
      "end_ms": 370725,
      "text": "不管你想当工程师，",
      "token_start": 1894,
      "token_end_exclusive": 1902
    },
    {
      "start_ms": 370900,
      "end_ms": 371735,
      "text": "还是当诗人，",
      "token_start": 1902,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 372080,
      "end_ms": 377140,
      "text": "所有学生都必须完成涵盖人文、社科、自然科学等等领域的三十五门核心课程。",
      "token_start": 1907,
      "token_end_exclusive": 1939
    },
    {
      "start_ms": 377280,
      "end_ms": 378540,
      "text": "学物理的也得啃完，",
      "token_start": 1939,
      "token_end_exclusive": 1947
    },
    {
      "start_ms": 378540,
      "end_ms": 380720,
      "text": "莎士比亚搞文学的也得刷完。",
      "token_start": 1947,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 380720,
      "end_ms": 381345,
      "text": "微积分，",
      "token_start": 1959,
      "token_end_exclusive": 1962
    },
    {
      "start_ms": 381680,
      "end_ms": 383180,
      "text": "普林斯顿要的不是专才，",
      "token_start": 1962,
      "token_end_exclusive": 1972
    },
    {
      "start_ms": 383260,
      "end_ms": 384205,
      "text": "而是通才。",
      "token_start": 1972,
      "token_end_exclusive": 1976
    },
    {
      "start_ms": 384650,
      "end_ms": 387175,
      "text": "当你从普林斯顿毕业同学，",
      "token_start": 1976,
      "token_end_exclusive": 1987
    },
    {
      "start_ms": 387350,
      "end_ms": 390085,
      "text": "你的人生失败率将无限趋近于零。",
      "token_start": 1987,
      "token_end_exclusive": 2001
    },
    {
      "start_ms": 390680,
      "end_ms": 391140,
      "text": "第五，",
      "token_start": 2001,
      "token_end_exclusive": 2003
    },
    {
      "start_ms": 391220,
      "end_ms": 394055,
      "text": "康奈尔大学世界上最美的大学之一，",
      "token_start": 2003,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 394320,
      "end_ms": 395600,
      "text": "占地三千英亩，",
      "token_start": 2018,
      "token_end_exclusive": 2024
    },
    {
      "start_ms": 395700,
      "end_ms": 398820,
      "text": "相当于三个故宫建立在峡谷之间，",
      "token_start": 2024,
      "token_end_exclusive": 2038
    },
    {
      "start_ms": 398900,
      "end_ms": 400245,
      "text": "吸取天地灵气，",
      "token_start": 2038,
      "token_end_exclusive": 2044
    },
    {
      "start_ms": 400600,
      "end_ms": 402600,
      "text": "大河旷野碧波荡漾，",
      "token_start": 2044,
      "token_end_exclusive": 2052
    },
    {
      "start_ms": 402660,
      "end_ms": 404115,
      "text": "就像在仙境里读书。",
      "token_start": 2052,
      "token_end_exclusive": 2060
    },
    {
      "start_ms": 404490,
      "end_ms": 407045,
      "text": "康奈尔是第一所男女同校的常春藤，",
      "token_start": 2060,
      "token_end_exclusive": 2075
    },
    {
      "start_ms": 407290,
      "end_ms": 409185,
      "text": "一八七零年开始招收女生，",
      "token_start": 2075,
      "token_end_exclusive": 2086
    },
    {
      "start_ms": 409440,
      "end_ms": 411615,
      "text": "也是猥琐公私合营的藤效。",
      "token_start": 2086,
      "token_end_exclusive": 2097
    },
    {
      "start_ms": 411970,
      "end_ms": 414435,
      "text": "这里的专业更是野到你超乎想象。",
      "token_start": 2097,
      "token_end_exclusive": 2111
    },
    {
      "start_ms": 414790,
      "end_ms": 417565,
      "text": "酒店管理全球第一自带教学的酒店。",
      "token_start": 2111,
      "token_end_exclusive": 2126
    },
    {
      "start_ms": 417850,
      "end_ms": 419865,
      "text": "而兽医学院全球前三，",
      "token_start": 2126,
      "token_end_exclusive": 2135
    },
    {
      "start_ms": 420270,
      "end_ms": 422765,
      "text": "全世界第一头克隆牛艾米诞生在这里，",
      "token_start": 2135,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 423010,
      "end_ms": 426405,
      "text": "这里还是中国的国宝大熊猫在海外的健康监测站。",
      "token_start": 2151,
      "token_end_exclusive": 2172
    },
    {
      "start_ms": 426860,
      "end_ms": 430655,
      "text": "当你在康奈尔你的同学可能在研究火星探测器机械臂，",
      "token_start": 2172,
      "token_end_exclusive": 2195
    },
    {
      "start_ms": 430860,
      "end_ms": 432935,
      "text": "也可能在隔壁养转基因奶牛，",
      "token_start": 2195,
      "token_end_exclusive": 2207
    },
    {
      "start_ms": 433270,
      "end_ms": 434905,
      "text": "从宇宙物理到动物科学。",
      "token_start": 2207,
      "token_end_exclusive": 2217
    },
    {
      "start_ms": 435180,
      "end_ms": 437265,
      "text": "从量子计算到葡萄栽培，",
      "token_start": 2217,
      "token_end_exclusive": 2227
    },
    {
      "start_ms": 437520,
      "end_ms": 438680,
      "text": "这里只有你想不到，",
      "token_start": 2227,
      "token_end_exclusive": 2235
    },
    {
      "start_ms": 438680,
      "end_ms": 440045,
      "text": "没有你学不到的专业。",
      "token_start": 2235,
      "token_end_exclusive": 2244
    },
    {
      "start_ms": 440280,
      "end_ms": 441515,
      "text": "就像康奈尔的校训。",
      "token_start": 2244,
      "token_end_exclusive": 2252
    },
    {
      "start_ms": 441840,
      "end_ms": 442715,
      "text": "有教无类，",
      "token_start": 2252,
      "token_end_exclusive": 2256
    },
    {
      "start_ms": 443410,
      "end_ms": 450125,
      "text": "康奈尔还是全世界唯一拥有四位女性诺奖校友的大学著名作家赛珍珠就是这里的校友，",
      "token_start": 2256,
      "token_end_exclusive": 2293
    },
    {
      "start_ms": 450450,
      "end_ms": 453125,
      "text": "而康奈尔的中国校友名单更是长的吓人。",
      "token_start": 2293,
      "token_end_exclusive": 2310
    },
    {
      "start_ms": 453350,
      "end_ms": 457070,
      "text": "胡适、赵圆润毛以生梁思成林徽因冰心。",
      "token_start": 2310,
      "token_end_exclusive": 2326
    },
    {
      "start_ms": 457230,
      "end_ms": 460555,
      "text": "徐志摩在一百多年前的一九一五年，",
      "token_start": 2326,
      "token_end_exclusive": 2341
    },
    {
      "start_ms": 460790,
      "end_ms": 463615,
      "text": "中国留学生在康奈尔成立了中国科学社，",
      "token_start": 2341,
      "token_end_exclusive": 2358
    },
    {
      "start_ms": 463880,
      "end_ms": 465745,
      "text": "就是后来的中国科学院。",
      "token_start": 2358,
      "token_end_exclusive": 2368
    },
    {
      "start_ms": 466050,
      "end_ms": 467810,
      "text": "但是朱军出身名校，",
      "token_start": 2368,
      "token_end_exclusive": 2376
    },
    {
      "start_ms": 467830,
      "end_ms": 469535,
      "text": "从来保证不了一个人的道德。",
      "token_start": 2376,
      "token_end_exclusive": 2388
    },
    {
      "start_ms": 469890,
      "end_ms": 475230,
      "text": "很难想象最近在康奈尔大学会发生七个男人对一个女生进行长达七小时的侵害。",
      "token_start": 2388,
      "token_end_exclusive": 2422
    },
    {
      "start_ms": 475390,
      "end_ms": 478210,
      "text": "向世界撕开的顶级名校的阴暗一角，",
      "token_start": 2422,
      "token_end_exclusive": 2437
    },
    {
      "start_ms": 478250,
      "end_ms": 480470,
      "text": "也让人看清常春藤的光环，",
      "token_start": 2437,
      "token_end_exclusive": 2448
    },
    {
      "start_ms": 480630,
      "end_ms": 482450,
      "text": "并掩盖不住人性恶。",
      "token_start": 2448,
      "token_end_exclusive": 2456
    },
    {
      "start_ms": 482830,
      "end_ms": 483290,
      "text": "第六，",
      "token_start": 2456,
      "token_end_exclusive": 2458
    },
    {
      "start_ms": 483410,
      "end_ms": 486015,
      "text": "耶鲁大学创办于一七零一年，",
      "token_start": 2458,
      "token_end_exclusive": 2470
    },
    {
      "start_ms": 486190,
      "end_ms": 487395,
      "text": "中国康熙年间，",
      "token_start": 2470,
      "token_end_exclusive": 2476
    },
    {
      "start_ms": 487680,
      "end_ms": 491500,
      "text": "这里诞生了六十五位诺奖得主和五十枚奥运会金牌，",
      "token_start": 2476,
      "token_end_exclusive": 2498
    },
    {
      "start_ms": 491600,
      "end_ms": 493365,
      "text": "以及五位美国总统，",
      "token_start": 2498,
      "token_end_exclusive": 2506
    },
    {
      "start_ms": 493640,
      "end_ms": 498045,
      "text": "尤其是连续四季老布什、克林顿、小布什全是耶鲁毕业生，",
      "token_start": 2506,
      "token_end_exclusive": 2529
    },
    {
      "start_ms": 498410,
      "end_ms": 500095,
      "text": "耶鲁最牛的就是法学院。",
      "token_start": 2529,
      "token_end_exclusive": 2539
    },
    {
      "start_ms": 500380,
      "end_ms": 501940,
      "text": "自从有法学院排名以来，",
      "token_start": 2539,
      "token_end_exclusive": 2549
    },
    {
      "start_ms": 501960,
      "end_ms": 503180,
      "text": "常年世界第一，",
      "token_start": 2549,
      "token_end_exclusive": 2555
    },
    {
      "start_ms": 503240,
      "end_ms": 504355,
      "text": "从未跌到第二。",
      "token_start": 2555,
      "token_end_exclusive": 2561
    },
    {
      "start_ms": 504710,
      "end_ms": 507385,
      "text": "克林顿和希拉里就是在耶鲁法学院认识的，",
      "token_start": 2561,
      "token_end_exclusive": 2579
    },
    {
      "start_ms": 507720,
      "end_ms": 508340,
      "text": "你知道吗？",
      "token_start": 2579,
      "token_end_exclusive": 2583
    },
    {
      "start_ms": 508440,
      "end_ms": 510880,
      "text": "美国有一个比中情局还要神秘的组织，",
      "token_start": 2583,
      "token_end_exclusive": 2599
    },
    {
      "start_ms": 510960,
      "end_ms": 516115,
      "text": "据说就在耶鲁骷髅会每年只在大三学生里挑选十五个人入会，",
      "token_start": 2599,
      "token_end_exclusive": 2625
    },
    {
      "start_ms": 516430,
      "end_ms": 518785,
      "text": "新人要在泥浆里摔跤被殴打。",
      "token_start": 2625,
      "token_end_exclusive": 2637
    },
    {
      "start_ms": 518970,
      "end_ms": 520565,
      "text": "经历长时间的心理训练，",
      "token_start": 2637,
      "token_end_exclusive": 2647
    },
    {
      "start_ms": 520840,
      "end_ms": 521775,
      "text": "目的只有一个，",
      "token_start": 2647,
      "token_end_exclusive": 2653
    },
    {
      "start_ms": 522030,
      "end_ms": 524250,
      "text": "让成员互相知道彼此的隐私，",
      "token_start": 2653,
      "token_end_exclusive": 2665
    },
    {
      "start_ms": 524410,
      "end_ms": 525725,
      "text": "一辈子绑定在一起。",
      "token_start": 2665,
      "token_end_exclusive": 2673
    },
    {
      "start_ms": 526210,
      "end_ms": 528230,
      "text": "这个社团走出了三位美国总统，",
      "token_start": 2673,
      "token_end_exclusive": 2686
    },
    {
      "start_ms": 528350,
      "end_ms": 530365,
      "text": "布什家族三代都是会员。",
      "token_start": 2686,
      "token_end_exclusive": 2696
    },
    {
      "start_ms": 530610,
      "end_ms": 531310,
      "text": "而你知道吗？",
      "token_start": 2696,
      "token_end_exclusive": 2701
    },
    {
      "start_ms": 531390,
      "end_ms": 534785,
      "text": "我们中国历史上第一位留学生就毕业于耶鲁大学，",
      "token_start": 2701,
      "token_end_exclusive": 2722
    },
    {
      "start_ms": 535040,
      "end_ms": 536695,
      "text": "他叫容红广东人，",
      "token_start": 2722,
      "token_end_exclusive": 2729
    },
    {
      "start_ms": 537120,
      "end_ms": 540805,
      "text": "一八五四年成为了在美国大学里第一个拿到学位的中国人。",
      "token_start": 2729,
      "token_end_exclusive": 2754
    },
    {
      "start_ms": 541120,
      "end_ms": 542220,
      "text": "他毕业之后回国，",
      "token_start": 2754,
      "token_end_exclusive": 2761
    },
    {
      "start_ms": 542420,
      "end_ms": 544060,
      "text": "说服了曾国藩和李鸿章，",
      "token_start": 2761,
      "token_end_exclusive": 2771
    },
    {
      "start_ms": 544280,
      "end_ms": 548365,
      "text": "把一百二十个平均只有十二岁的中国孩子送去美国留学，",
      "token_start": 2771,
      "token_end_exclusive": 2795
    },
    {
      "start_ms": 548750,
      "end_ms": 552225,
      "text": "后来成长为民国总理、清华校长等等大人物。",
      "token_start": 2795,
      "token_end_exclusive": 2813
    },
    {
      "start_ms": 552630,
      "end_ms": 554290,
      "text": "这群被遗忘的留美幼童，",
      "token_start": 2813,
      "token_end_exclusive": 2823
    },
    {
      "start_ms": 554530,
      "end_ms": 559560,
      "text": "改变了中国历史第七达特茅斯学院存在感最低的成效。",
      "token_start": 2823,
      "token_end_exclusive": 2846
    },
    {
      "start_ms": 559740,
      "end_ms": 561735,
      "text": "隐形王者幕后大佬，",
      "token_start": 2846,
      "token_end_exclusive": 2854
    },
    {
      "start_ms": 562170,
      "end_ms": 566005,
      "text": "学校坐落在新罕布什尔州的一百多平方公里的森林之中，",
      "token_start": 2854,
      "token_end_exclusive": 2878
    },
    {
      "start_ms": 566230,
      "end_ms": 567475,
      "text": "位置相当偏僻，",
      "token_start": 2878,
      "token_end_exclusive": 2884
    },
    {
      "start_ms": 567690,
      "end_ms": 570615,
      "text": "而且QS排名连前两百都排不上，",
      "token_start": 2884,
      "token_end_exclusive": 2897
    },
    {
      "start_ms": 570960,
      "end_ms": 571895,
      "text": "但是你敢相信吗？",
      "token_start": 2897,
      "token_end_exclusive": 2904
    },
    {
      "start_ms": 572190,
      "end_ms": 573850,
      "text": "美国收入前十的家庭，",
      "token_start": 2904,
      "token_end_exclusive": 2913
    },
    {
      "start_ms": 573850,
      "end_ms": 575305,
      "text": "争着要把孩子送到这里。",
      "token_start": 2913,
      "token_end_exclusive": 2923
    },
    {
      "start_ms": 575720,
      "end_ms": 578720,
      "text": "达特茅斯是常春藤里唯一坚持小而精的学校。",
      "token_start": 2923,
      "token_end_exclusive": 2942
    },
    {
      "start_ms": 578900,
      "end_ms": 582755,
      "text": "每个班平均十六人教授能够叫出每个学生的名字。",
      "token_start": 2942,
      "token_end_exclusive": 2963
    },
    {
      "start_ms": 583810,
      "end_ms": 586695,
      "text": "有些学校拼命想让自己听起来像一个大学，",
      "token_start": 2963,
      "token_end_exclusive": 2981
    },
    {
      "start_ms": 586980,
      "end_ms": 589700,
      "text": "但是达特茅斯已经强到两百多年了，",
      "token_start": 2981,
      "token_end_exclusive": 2996
    },
    {
      "start_ms": 589700,
      "end_ms": 591425,
      "text": "懒得把学院改成大学。",
      "token_start": 2996,
      "token_end_exclusive": 3005
    },
    {
      "start_ms": 591890,
      "end_ms": 592590,
      "text": "一八一九年，",
      "token_start": 3005,
      "token_end_exclusive": 3010
    },
    {
      "start_ms": 592590,
      "end_ms": 595185,
      "text": "州政府想把名字改成达特茅斯大学，",
      "token_start": 3010,
      "token_end_exclusive": 3025
    },
    {
      "start_ms": 595520,
      "end_ms": 596980,
      "text": "但是学校坚决不同意，",
      "token_start": 3025,
      "token_end_exclusive": 3034
    },
    {
      "start_ms": 597060,
      "end_ms": 598380,
      "text": "一路告到最高法院，",
      "token_start": 3034,
      "token_end_exclusive": 3042
    },
    {
      "start_ms": 598420,
      "end_ms": 599155,
      "text": "最终赢了，",
      "token_start": 3042,
      "token_end_exclusive": 3046
    },
    {
      "start_ms": 599640,
      "end_ms": 601200,
      "text": "谁也别想改我的名字，",
      "token_start": 3046,
      "token_end_exclusive": 3055
    },
    {
      "start_ms": 601220,
      "end_ms": 602285,
      "text": "哪怕你是州长。",
      "token_start": 3055,
      "token_end_exclusive": 3061
    },
    {
      "start_ms": 602670,
      "end_ms": 603750,
      "text": "因为在达特茅斯，",
      "token_start": 3061,
      "token_end_exclusive": 3068
    },
    {
      "start_ms": 603970,
      "end_ms": 605190,
      "text": "小而精的学院，",
      "token_start": 3068,
      "token_end_exclusive": 3074
    },
    {
      "start_ms": 605290,
      "end_ms": 606270,
      "text": "可不是降级，",
      "token_start": 3074,
      "token_end_exclusive": 3079
    },
    {
      "start_ms": 606390,
      "end_ms": 607290,
      "text": "是一种勋章。",
      "token_start": 3079,
      "token_end_exclusive": 3084
    },
    {
      "start_ms": 607550,
      "end_ms": 608010,
      "text": "第八，",
      "token_start": 3084,
      "token_end_exclusive": 3086
    },
    {
      "start_ms": 608110,
      "end_ms": 610950,
      "text": "布朗大学最适合摩羯座的大学。",
      "token_start": 3086,
      "token_end_exclusive": 3099
    },
    {
      "start_ms": 610950,
      "end_ms": 612310,
      "text": "因为这里自由的可怕，",
      "token_start": 3099,
      "token_end_exclusive": 3108
    },
    {
      "start_ms": 612750,
      "end_ms": 614350,
      "text": "美国最顶级的一批大学里，",
      "token_start": 3108,
      "token_end_exclusive": 3119
    },
    {
      "start_ms": 614350,
      "end_ms": 615970,
      "text": "他是最敢把你的人生，",
      "token_start": 3119,
      "token_end_exclusive": 3128
    },
    {
      "start_ms": 615990,
      "end_ms": 616930,
      "text": "你自己负责。",
      "token_start": 3128,
      "token_end_exclusive": 3133
    },
    {
      "start_ms": 616970,
      "end_ms": 618110,
      "text": "贯彻到底的学校，",
      "token_start": 3133,
      "token_end_exclusive": 3140
    },
    {
      "start_ms": 618310,
      "end_ms": 620030,
      "text": "全靠学生的自驱力。",
      "token_start": 3140,
      "token_end_exclusive": 3148
    },
    {
      "start_ms": 620270,
      "end_ms": 621170,
      "text": "在布朗大学，",
      "token_start": 3148,
      "token_end_exclusive": 3153
    },
    {
      "start_ms": 621170,
      "end_ms": 622550,
      "text": "没有任何一门必修课，",
      "token_start": 3153,
      "token_end_exclusive": 3162
    },
    {
      "start_ms": 622690,
      "end_ms": 625030,
      "text": "学生想上什么课就上什么课，",
      "token_start": 3162,
      "token_end_exclusive": 3174
    },
    {
      "start_ms": 625130,
      "end_ms": 626430,
      "text": "没有通识教育要求，",
      "token_start": 3174,
      "token_end_exclusive": 3182
    },
    {
      "start_ms": 626590,
      "end_ms": 627990,
      "text": "没有核心课程限制，",
      "token_start": 3182,
      "token_end_exclusive": 3190
    },
    {
      "start_ms": 628230,
      "end_ms": 630030,
      "text": "两千多门课随你选。",
      "token_start": 3190,
      "token_end_exclusive": 3198
    },
    {
      "start_ms": 630930,
      "end_ms": 632275,
      "text": "所以江湖上有一句话，",
      "token_start": 3198,
      "token_end_exclusive": 3207
    },
    {
      "start_ms": 632620,
      "end_ms": 634180,
      "text": "世上奇葩千千万，",
      "token_start": 3207,
      "token_end_exclusive": 3214
    },
    {
      "start_ms": 634200,
      "end_ms": 635440,
      "text": "布朗大学占一半。",
      "token_start": 3214,
      "token_end_exclusive": 3221
    },
    {
      "start_ms": 635600,
      "end_ms": 637300,
      "text": "因为这里的课程太自由了，",
      "token_start": 3221,
      "token_end_exclusive": 3232
    },
    {
      "start_ms": 637300,
      "end_ms": 638620,
      "text": "什么奇怪的专业都有。",
      "token_start": 3232,
      "token_end_exclusive": 3241
    },
    {
      "start_ms": 639320,
      "end_ms": 640140,
      "text": "布朗最牛的，",
      "token_start": 3241,
      "token_end_exclusive": 3246
    },
    {
      "start_ms": 640140,
      "end_ms": 641840,
      "text": "不是我们给你最好的教育，",
      "token_start": 3246,
      "token_end_exclusive": 3257
    },
    {
      "start_ms": 641920,
      "end_ms": 644660,
      "text": "而是我们把教育的方向盘交给你自己。",
      "token_start": 3257,
      "token_end_exclusive": 3273
    },
    {
      "start_ms": 644960,
      "end_ms": 646940,
      "text": "在这样快乐自由的氛围之下，",
      "token_start": 3273,
      "token_end_exclusive": 3285
    },
    {
      "start_ms": 646940,
      "end_ms": 650520,
      "text": "布朗诞生了十一位诺奖得主二十四位普利茨奖得主。",
      "token_start": 3285,
      "token_end_exclusive": 3307
    },
    {
      "start_ms": 650780,
      "end_ms": 653040,
      "text": "在一八五八年布朗有一位毕业生，",
      "token_start": 3307,
      "token_end_exclusive": 3321
    },
    {
      "start_ms": 653140,
      "end_ms": 654880,
      "text": "后来他成为美国国务卿，",
      "token_start": 3321,
      "token_end_exclusive": 3331
    },
    {
      "start_ms": 655080,
      "end_ms": 658360,
      "text": "他直接推动了美国退还部分超额的庚子赔款。",
      "token_start": 3331,
      "token_end_exclusive": 3350
    },
    {
      "start_ms": 658640,
      "end_ms": 659500,
      "text": "有了这笔钱，",
      "token_start": 3350,
      "token_end_exclusive": 3355
    },
    {
      "start_ms": 659680,
      "end_ms": 662105,
      "text": "后来才创建了中国的清华大学，",
      "token_start": 3355,
      "token_end_exclusive": 3368
    },
    {
      "start_ms": 662460,
      "end_ms": 665895,
      "text": "而今天布朗居然还藏着十六万册的中文图书，",
      "token_start": 3368,
      "token_end_exclusive": 3387
    },
    {
      "start_ms": 666130,
      "end_ms": 668600,
      "text": "尤其是明清古籍朱君，",
      "token_start": 3387,
      "token_end_exclusive": 3396
    },
    {
      "start_ms": 668860,
      "end_ms": 670260,
      "text": "这就是常春藤。",
      "token_start": 3396,
      "token_end_exclusive": 3402
    },
    {
      "start_ms": 670740,
      "end_ms": 673485,
      "text": "上个世纪美国东海岸这八所老牌的名校，",
      "token_start": 3402,
      "token_end_exclusive": 3419
    },
    {
      "start_ms": 673750,
      "end_ms": 676425,
      "text": "其实一开始只是一个橄榄球的体育联盟，",
      "token_start": 3419,
      "token_end_exclusive": 3436
    },
    {
      "start_ms": 676630,
      "end_ms": 678355,
      "text": "后来才成了所谓的藤效。",
      "token_start": 3436,
      "token_end_exclusive": 3446
    },
    {
      "start_ms": 678920,
      "end_ms": 680460,
      "text": "当你坐在教室的那一瞬间，",
      "token_start": 3446,
      "token_end_exclusive": 3457
    },
    {
      "start_ms": 680460,
      "end_ms": 681115,
      "text": "会感叹，",
      "token_start": 3457,
      "token_end_exclusive": 3460
    },
    {
      "start_ms": 681450,
      "end_ms": 683845,
      "text": "原来曾经拼命努力走过的路，",
      "token_start": 3460,
      "token_end_exclusive": 3472
    },
    {
      "start_ms": 684100,
      "end_ms": 686035,
      "text": "真的能带你走向更大的世界。",
      "token_start": 3472,
      "token_end_exclusive": 3484
    },
    {
      "start_ms": 686440,
      "end_ms": 688560,
      "text": "一个人最好的学历不是清华北大，",
      "token_start": 3484,
      "token_end_exclusive": 3498
    },
    {
      "start_ms": 688580,
      "end_ms": 689340,
      "text": "也不是哈佛。",
      "token_start": 3498,
      "token_end_exclusive": 3503
    },
    {
      "start_ms": 689340,
      "end_ms": 692000,
      "text": "耶鲁是当你走过足够大的世界之后，",
      "token_start": 3503,
      "token_end_exclusive": 3518
    },
    {
      "start_ms": 692160,
      "end_ms": 694135,
      "text": "依然对知识保持敬畏，",
      "token_start": 3518,
      "token_end_exclusive": 3527
    },
    {
      "start_ms": 694320,
      "end_ms": 695725,
      "text": "对未来保持好奇，",
      "token_start": 3527,
      "token_end_exclusive": 3534
    },
    {
      "start_ms": 696000,
      "end_ms": 697495,
      "text": "对理想保持热爱。",
      "token_start": 3534,
      "token_end_exclusive": 3541
    },
    {
      "start_ms": 697930,
      "end_ms": 699690,
      "text": "山的那边不是名校，",
      "token_start": 3541,
      "token_end_exclusive": 3549
    },
    {
      "start_ms": 699970,
      "end_ms": 701535,
      "text": "是一个更辽阔的自己。",
      "token_start": 3549,
      "token_end_exclusive": 3558
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
    "timestamp_starts_monotonic": true,
