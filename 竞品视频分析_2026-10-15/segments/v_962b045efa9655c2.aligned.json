  "segments": [
    {
      "start_ms": 230,
      "end_ms": 2310,
      "text": "永远不要害怕任何关系的破裂。",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 2510,
      "end_ms": 3450,
      "text": "接触的人越多，",
      "token_start": 13,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 3590,
      "end_ms": 4470,
      "text": "你越会发现，",
      "token_start": 19,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 4710,
      "end_ms": 5370,
      "text": "敢翻脸，",
      "token_start": 24,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 5550,
      "end_ms": 6270,
      "text": "敢绝交，",
      "token_start": 27,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 6590,
      "end_ms": 9790,
      "text": "敢独处才是一个人真正的底气。",
      "token_start": 30,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 10550,
      "end_ms": 12970,
      "text": "不伤人是你的三观和教养，",
      "token_start": 43,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 13330,
      "end_ms": 15470,
      "text": "但不代表是别人来伤害你的理由。",
      "token_start": 54,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 15830,
      "end_ms": 16610,
      "text": "你可以真诚，",
      "token_start": 68,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 16870,
      "end_ms": 17630,
      "text": "可以老实，",
      "token_start": 73,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 18070,
      "end_ms": 20930,
      "text": "但是该计较偶尔还是得计较一下。",
      "token_start": 77,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 21150,
      "end_ms": 22170,
      "text": "别人敢欺负你，",
      "token_start": 91,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 22410,
      "end_ms": 23370,
      "text": "就是笃定了，",
      "token_start": 97,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 23510,
      "end_ms": 24450,
      "text": "你不会计较，",
      "token_start": 102,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 24910,
      "end_ms": 25950,
      "text": "更不会翻脸，",
      "token_start": 107,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 26610,
      "end_ms": 28050,
      "text": "因为好人不容易翻脸，",
      "token_start": 112,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 28110,
      "end_ms": 30420,
      "text": "而坏人往往不要弟。",
      "token_start": 121,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 30840,
      "end_ms": 31480,
      "text": "记住了，",
      "token_start": 129,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 31720,
      "end_ms": 32960,
      "text": "温柔是你的选择，",
      "token_start": 132,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 33280,
      "end_ms": 35160,
      "text": "锋芒是你的边界，",
      "token_start": 139,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 35500,
      "end_ms": 39005,
      "text": "但是翻脸一定是你的底线。",
      "token_start": 146,
      "token_end_exclusive": 157
    }
