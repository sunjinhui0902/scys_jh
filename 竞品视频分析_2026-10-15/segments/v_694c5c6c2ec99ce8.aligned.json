{
  "video_id": "v_694c5c6c2ec99ce8",
  "duration_s": 675.376916,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_694c5c6c2ec99ce8.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_694c5c6c2ec99ce8.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 4830,
      "text": "您知道中国历史上被写进古诗里最多的名城是哪一座吗？",
      "token_start": 0,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5190,
      "end_ms": 5690,
      "text": "上集，",
      "token_start": 24,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5690,
      "end_ms": 11110,
      "text": "咱们聊了苏州、成都、武汉、岳阳、扬州这集，",
      "token_start": 26,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 11190,
      "end_ms": 12610,
      "text": "直接揭开谜底，",
      "token_start": 42,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 12870,
      "end_ms": 14930,
      "text": "看看前五名多到什么程度，",
      "token_start": 48,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15470,
      "end_ms": 18290,
      "text": "尤其是排在榜首的那座城，",
      "token_start": 59,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 19010,
      "end_ms": 19790,
      "text": "不靠湖，",
      "token_start": 70,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 20230,
      "end_ms": 20930,
      "text": "不靠水，",
      "token_start": 73,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 21490,
      "end_ms": 27870,
      "text": "把一世的功名与跌宕全融进了两万多首诗的字里行间。",
      "token_start": 76,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 28510,
      "end_ms": 31660,
      "text": "这五座里除说不定就有您家那座，",
      "token_start": 99,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 32020,
      "end_ms": 33040,
      "text": "看看他排第几。",
      "token_start": 113,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 33480,
      "end_ms": 35560,
      "text": "看到这儿觉得有点意思的朋友，",
      "token_start": 119,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 35880,
      "end_ms": 38020,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 132,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 38199,
      "end_ms": 39020,
      "text": "收藏起来，",
      "token_start": 142,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 39280,
      "end_ms": 40220,
      "text": "省得手一滑，",
      "token_start": 146,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 40320,
      "end_ms": 41300,
      "text": "咱们就错过了。",
      "token_start": 151,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 41580,
      "end_ms": 42320,
      "text": "第五名，",
      "token_start": 157,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 42640,
      "end_ms": 50400,
      "text": "洛阳十三个朝代在这定过都也叫神都写洛阳写洛城的诗，",
      "token_start": 160,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 50720,
      "end_ms": 51720,
      "text": "五千多首，",
      "token_start": 184,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 52420,
      "end_ms": 53820,
      "text": "唐朝有钱的人。",
      "token_start": 188,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 54000,
      "end_ms": 57340,
      "text": "五书的人都爱在洛阳置一处宅院，",
      "token_start": 194,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 57720,
      "end_ms": 59915,
      "text": "白居易晚年干脆搬了进去。",
      "token_start": 208,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 60310,
      "end_ms": 61865,
      "text": "在吕道坊买了房，",
      "token_start": 219,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 62330,
      "end_ms": 63090,
      "text": "挖池塘，",
      "token_start": 226,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 63470,
      "end_ms": 64335,
      "text": "种竹子，",
      "token_start": 229,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 64780,
      "end_ms": 66295,
      "text": "前后住了十七年，",
      "token_start": 232,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 66660,
      "end_ms": 69375,
      "text": "七十五岁走的葬在龙门山上，",
      "token_start": 239,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 69840,
      "end_ms": 72975,
      "text": "唐朝人写洛阳离不开花。",
      "token_start": 251,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 73400,
      "end_ms": 76595,
      "text": "刘禹锡写唯有牡丹真国色，",
      "token_start": 261,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 77050,
      "end_ms": 79315,
      "text": "花开时节动京城。",
      "token_start": 272,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 80160,
      "end_ms": 80960,
      "text": "牡丹一开，",
      "token_start": 279,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 81300,
      "end_ms": 83355,
      "text": "满城的人放下手里的活，",
      "token_start": 283,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 83700,
      "end_ms": 88135,
      "text": "出门看花李白春夜在洛阳听见谁家吹笛，",
      "token_start": 293,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 88530,
      "end_ms": 89535,
      "text": "也写了一句，",
      "token_start": 310,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 89980,
      "end_ms": 91805,
      "text": "何人不起故园情，",
      "token_start": 315,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 92380,
      "end_ms": 95315,
      "text": "一只笛子吹得满城人想家。",
      "token_start": 322,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 95770,
      "end_ms": 96565,
      "text": "到今天，",
      "token_start": 333,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 96950,
      "end_ms": 99250,
      "text": "洛阳每年四月还办牡丹，",
      "token_start": 336,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 99250,
      "end_ms": 99765,
      "text": "花卉，",
      "token_start": 346,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 100250,
      "end_ms": 101775,
      "text": "满城牡丹一起开。",
      "token_start": 348,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 102300,
      "end_ms": 103885,
      "text": "您想想那是什么场面？",
      "token_start": 355,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 104270,
      "end_ms": 105005,
      "text": "第四名，",
      "token_start": 364,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 105340,
      "end_ms": 110155,
      "text": "开封八朝古都北宋的时候叫东京，",
      "token_start": 367,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 110660,
      "end_ms": 111845,
      "text": "也叫汴京。",
      "token_start": 381,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 112460,
      "end_ms": 113135,
      "text": "据统计，",
      "token_start": 385,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 113560,
      "end_ms": 115125,
      "text": "写汴京繁华，",
      "token_start": 388,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 115620,
      "end_ms": 119085,
      "text": "想汴京救世的宋词有上万阙。",
      "token_start": 393,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 119760,
      "end_ms": 121405,
      "text": "这座城有多热闹？",
      "token_start": 405,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 121880,
      "end_ms": 123700,
      "text": "夜市开到三更才散，",
      "token_start": 412,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 123900,
      "end_ms": 125235,
      "text": "五更又开张，",
      "token_start": 420,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 125640,
      "end_ms": 126440,
      "text": "大相国寺，",
      "token_start": 425,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 126500,
      "end_ms": 129100,
      "text": "每个月开五回庙会卖什么的，",
      "token_start": 429,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 129100,
      "end_ms": 131435,
      "text": "都有人挤得迈不开步。",
      "token_start": 441,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 131960,
      "end_ms": 134585,
      "text": "宋其一句红杏枝头春意闹，",
      "token_start": 450,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 134930,
      "end_ms": 136455,
      "text": "硬把春天鞋炒了。",
      "token_start": 461,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 136900,
      "end_ms": 140885,
      "text": "可这份热闹没撑到头一一二七年，",
      "token_start": 468,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 141340,
      "end_ms": 142925,
      "text": "金兵打下汴京，",
      "token_start": 482,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 143350,
      "end_ms": 144375,
      "text": "皇帝被抓走，",
      "token_start": 488,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 144680,
      "end_ms": 146935,
      "text": "大家逃去南方再没回来。",
      "token_start": 493,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 147340,
      "end_ms": 149125,
      "text": "后来黄河几次绝口，",
      "token_start": 503,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 149620,
      "end_ms": 151405,
      "text": "把汴京埋进了地下。",
      "token_start": 511,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 152020,
      "end_ms": 155510,
      "text": "今天开封城底下摞着好几座古城，",
      "token_start": 519,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 155950,
      "end_ms": 157530,
      "text": "您去清明上河园，",
      "token_start": 533,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 157730,
      "end_ms": 159275,
      "text": "大相国寺走一圈，",
      "token_start": 540,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 159910,
      "end_ms": 162015,
      "text": "看到的是复原的热闹。",
      "token_start": 547,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 162560,
      "end_ms": 167305,
      "text": "宋朝人想回家的话一句一句还留在词里。",
      "token_start": 556,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 167710,
      "end_ms": 168410,
      "text": "第三名，",
      "token_start": 573,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 168690,
      "end_ms": 169415,
      "text": "南京，",
      "token_start": 576,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 170180,
      "end_ms": 171305,
      "text": "古时候叫金陵，",
      "token_start": 578,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 171680,
      "end_ms": 172345,
      "text": "六个朝代，",
      "token_start": 584,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 172590,
      "end_ms": 174830,
      "text": "在这建过都写金陵，",
      "token_start": 588,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 175110,
      "end_ms": 177465,
      "text": "写情怀写微巷的诗，",
      "token_start": 596,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 177830,
      "end_ms": 178775,
      "text": "九千多首。",
      "token_start": 604,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 179180,
      "end_ms": 181000,
      "text": "东晋的王道谢，",
      "token_start": 608,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 181060,
      "end_ms": 184045,
      "text": "安两大家族就住在威巷，",
      "token_start": 614,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 184570,
      "end_ms": 186775,
      "text": "当年是最有权势的人家。",
      "token_start": 624,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 187180,
      "end_ms": 188115,
      "text": "到了唐朝，",
      "token_start": 634,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 188620,
      "end_ms": 189200,
      "text": "刘禹锡，",
      "token_start": 638,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 189200,
      "end_ms": 192515,
      "text": "路过朱雀桥边长满野草，",
      "token_start": 641,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 192930,
      "end_ms": 195215,
      "text": "乌衣巷口斜照着夕阳。",
      "token_start": 651,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 195590,
      "end_ms": 198935,
      "text": "他写就时王谢堂前燕，",
      "token_start": 660,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 199440,
      "end_ms": 201625,
      "text": "飞入寻常百姓家，",
      "token_start": 669,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 202230,
      "end_ms": 204145,
      "text": "燕子还认得老地方，",
      "token_start": 676,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 204570,
      "end_ms": 205070,
      "text": "门里，",
      "token_start": 684,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 205270,
      "end_ms": 206265,
      "text": "已经换了人。",
      "token_start": 686,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 206750,
      "end_ms": 209055,
      "text": "杜牧把船停在秦淮河边，",
      "token_start": 691,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 209620,
      "end_ms": 211785,
      "text": "隔岸有人在唱后庭花。",
      "token_start": 701,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 212430,
      "end_ms": 216965,
      "text": "杜牧听着写下烟笼寒水月笼沙。",
      "token_start": 710,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 217440,
      "end_ms": 219950,
      "text": "今天您到夫子庙河边，",
      "token_start": 723,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 219990,
      "end_ms": 220835,
      "text": "灯笼一亮，",
      "token_start": 732,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 221200,
      "end_ms": 222300,
      "text": "有人吃小吃，",
      "token_start": 736,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 222700,
      "end_ms": 223935,
      "text": "有人听曲。",
      "token_start": 741,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 224520,
      "end_ms": 228015,
      "text": "王谢的大宅子早就落成了寻常日子，",
      "token_start": 745,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 228450,
      "end_ms": 231445,
      "text": "九千多首诗写尽的起起落落，",
      "token_start": 760,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 231840,
      "end_ms": 236345,
      "text": "给后世所有人换来了一份看透浮沉的清醒。",
      "token_start": 772,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 236770,
      "end_ms": 237495,
      "text": "第二名，",
      "token_start": 790,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 237950,
      "end_ms": 240815,
      "text": "杭州古时候叫钱塘，",
      "token_start": 793,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 241420,
      "end_ms": 242305,
      "text": "也叫临安，",
      "token_start": 801,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 243050,
      "end_ms": 243985,
      "text": "写杭州，",
      "token_start": 805,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 244690,
      "end_ms": 247535,
      "text": "写西湖写钱唐的诗。",
      "token_start": 808,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 248360,
      "end_ms": 250500,
      "text": "一万两千多首苏轼，",
      "token_start": 816,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 250500,
      "end_ms": 252625,
      "text": "任知州时修筑苏堤，",
      "token_start": 824,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 252990,
      "end_ms": 255135,
      "text": "写下欲把西湖比西子，",
      "token_start": 832,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 255530,
      "end_ms": 258170,
      "text": "淡妆浓抹总相宜说，",
      "token_start": 841,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 258230,
      "end_ms": 260805,
      "text": "不管晴天雨天这处水色，",
      "token_start": 849,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 261070,
      "end_ms": 262475,
      "text": "都美如绝代佳人，",
      "token_start": 859,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 263040,
      "end_ms": 266145,
      "text": "白居易也写下最爱湖东行不足。",
      "token_start": 866,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 266730,
      "end_ms": 268535,
      "text": "绿杨阴里白沙堤。",
      "token_start": 879,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 269030,
      "end_ms": 271630,
      "text": "两位顶尖文豪不仅用诗写他，",
      "token_start": 886,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 271890,
      "end_ms": 274185,
      "text": "更亲手挖泥筑堤，",
      "token_start": 898,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 274620,
      "end_ms": 276380,
      "text": "把整座西湖雕琢，",
      "token_start": 905,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 276380,
      "end_ms": 278345,
      "text": "成了中国山水的样板。",
      "token_start": 912,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 278760,
      "end_ms": 281445,
      "text": "您今天清晨走在苏堤之上，",
      "token_start": 921,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 282070,
      "end_ms": 283535,
      "text": "两岸柳丝拂面，",
      "token_start": 932,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 283840,
      "end_ms": 284925,
      "text": "烟波浩渺。",
      "token_start": 938,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 285390,
      "end_ms": 288090,
      "text": "哪怕是不懂事的人心神，",
      "token_start": 942,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 288150,
      "end_ms": 289825,
      "text": "也被洗的干干净净。",
      "token_start": 952,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 290280,
      "end_ms": 292600,
      "text": "一万两千多首诗密密麻麻，",
      "token_start": 960,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 292620,
      "end_ms": 294315,
      "text": "绣满了西湖的水面。",
      "token_start": 971,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 294770,
      "end_ms": 300890,
      "text": "天下文人把对人间圣境最极致的念想全砸在了这座湖山里。",
      "token_start": 979,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 301170,
      "end_ms": 302730,
      "text": "那第一名到底是谁？",
      "token_start": 1004,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 303450,
      "end_ms": 307770,
      "text": "为什么写了一万两千首的杭州都只能排第二？",
      "token_start": 1012,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 308150,
      "end_ms": 308850,
      "text": "先别急，",
      "token_start": 1031,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 309150,
      "end_ms": 310809,
      "text": "我跟您说几句实在话，",
      "token_start": 1034,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 311250,
      "end_ms": 316450,
      "text": "咱们这代人唐诗宋词谁嘴里都能念上几句，",
      "token_start": 1043,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 316790,
      "end_ms": 318050,
      "text": "可光会背诗，",
      "token_start": 1061,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 318430,
      "end_ms": 321530,
      "text": "您真觉得就算懂了老祖那点家底吗？",
      "token_start": 1066,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 322210,
      "end_ms": 324135,
      "text": "诗是写在纸上的，",
      "token_start": 1081,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 324580,
      "end_ms": 326240,
      "text": "城是立在地上的，",
      "token_start": 1088,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 326640,
      "end_ms": 328680,
      "text": "这些城当年是怎么起来的？",
      "token_start": 1095,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 329060,
      "end_ms": 330000,
      "text": "守过什么，",
      "token_start": 1106,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 330200,
      "end_ms": 331080,
      "text": "丢过什么，",
      "token_start": 1110,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 331420,
      "end_ms": 331840,
      "text": "诗里，",
      "token_start": 1114,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 331840,
      "end_ms": 332699,
      "text": "一个字都不写。",
      "token_start": 1116,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 333060,
      "end_ms": 334560,
      "text": "很多老朋友跟我聊过，",
      "token_start": 1122,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 334920,
      "end_ms": 336400,
      "text": "年轻时候忙工作，",
      "token_start": 1131,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 336720,
      "end_ms": 337180,
      "text": "顾家，",
      "token_start": 1138,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 337540,
      "end_ms": 338560,
      "text": "没那个闲心。",
      "token_start": 1140,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 339100,
      "end_ms": 340420,
      "text": "现在岁数到了，",
      "token_start": 1145,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 340639,
      "end_ms": 343820,
      "text": "反倒越来越想把这块琢磨明白。",
      "token_start": 1151,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 344160,
      "end_ms": 347180,
      "text": "平时跟老同学老战友出去走走，",
      "token_start": 1164,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 347560,
      "end_ms": 348380,
      "text": "到了地方，",
      "token_start": 1177,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 348580,
      "end_ms": 349940,
      "text": "大家扎堆拍个照，",
      "token_start": 1181,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 350240,
      "end_ms": 351960,
      "text": "买点特产也就完了。",
      "token_start": 1188,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 352360,
      "end_ms": 354380,
      "text": "您要是能站在城门楼，",
      "token_start": 1196,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 354380,
      "end_ms": 356845,
      "text": "等底下念出一句诗，",
      "token_start": 1205,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 357460,
      "end_ms": 359000,
      "text": "再顺手说一句，",
      "token_start": 1213,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 359060,
      "end_ms": 360995,
      "text": "这城当年是干什么的，",
      "token_start": 1219,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 361480,
      "end_ms": 362815,
      "text": "后来怎么败的？",
      "token_start": 1228,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 363250,
      "end_ms": 365695,
      "text": "旁边的人自然高看您一眼。",
      "token_start": 1234,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 366140,
      "end_ms": 367545,
      "text": "还有一件更要紧的，",
      "token_start": 1245,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 368040,
      "end_ms": 372815,
      "text": "现在家里都有孙子孙女儿放假带孩子去古迹。",
      "token_start": 1253,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 373330,
      "end_ms": 375245,
      "text": "孩子指着城门楼问一句，",
      "token_start": 1272,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 375640,
      "end_ms": 377415,
      "text": "这地方以前是干嘛的？",
      "token_start": 1282,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 377950,
      "end_ms": 380125,
      "text": "您要是当场翻手机查，",
      "token_start": 1291,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 380560,
      "end_ms": 381405,
      "text": "那就露怯了。",
      "token_start": 1300,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 381810,
      "end_ms": 385795,
      "text": "能给孩子的除了吃穿还有一样。",
      "token_start": 1305,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 386050,
      "end_ms": 386910,
      "text": "他问什么？",
      "token_start": 1318,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 387130,
      "end_ms": 388215,
      "text": "您答得上来。",
      "token_start": 1322,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 388760,
      "end_ms": 397395,
      "text": "前阵子我翻到一套书叫中国历史名城中央民族大学出版社出的符号中国系列，",
      "token_start": 1327,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 397840,
      "end_ms": 399775,
      "text": "他讲的是这些城的来路。",
      "token_start": 1360,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 400470,
      "end_ms": 402575,
      "text": "这座城为什么建在这个位置，",
      "token_start": 1370,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 403320,
      "end_ms": 405285,
      "text": "当过哪个朝代的都城，",
      "token_start": 1382,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 406080,
      "end_ms": 407165,
      "text": "出过什么人，",
      "token_start": 1391,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 407510,
      "end_ms": 408515,
      "text": "遭过什么难，",
      "token_start": 1396,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 409090,
      "end_ms": 411325,
      "text": "后来又怎么留到了今天？",
      "token_start": 1401,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 411740,
      "end_ms": 412415,
      "text": "说白了，",
      "token_start": 1411,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 412750,
      "end_ms": 416920,
      "text": "咱们国家这些立了几千年的老城书里，",
      "token_start": 1414,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 416920,
      "end_ms": 423885,
      "text": "一座一座单开一篇一座城的建制兴衰人物大意，",
      "token_start": 1430,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 424290,
      "end_ms": 426245,
      "text": "几页纸就给您讲透了，",
      "token_start": 1450,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 426770,
      "end_ms": 429145,
      "text": "配的彩色插图字也大，",
      "token_start": 1459,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 429600,
      "end_ms": 430265,
      "text": "看着不累。",
      "token_start": 1468,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 431000,
      "end_ms": 433500,
      "text": "我自己是常年搁在茶几上，",
      "token_start": 1472,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 433960,
      "end_ms": 437090,
      "text": "闲了泡壶热茶翻两页带，",
      "token_start": 1483,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 437090,
      "end_ms": 441015,
      "text": "孙子孙女出门前先翻一翻到了地方。",
      "token_start": 1493,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 441400,
      "end_ms": 446610,
      "text": "您就是孩子眼里最懂行的那个跟老朋友聚会闲聊，",
      "token_start": 1508,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 446610,
      "end_ms": 449535,
      "text": "天说出来的话也扎实，",
      "token_start": 1529,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 450150,
      "end_ms": 451925,
      "text": "不是网上现抄的。",
      "token_start": 1538,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 452390,
      "end_ms": 453395,
      "text": "喜欢文史，",
      "token_start": 1545,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 453850,
      "end_ms": 455485,
      "text": "心里装着家国的朋友，",
      "token_start": 1549,
      "token_end_exclusive": 1558
    },
    {
      "start_ms": 455830,
      "end_ms": 457335,
      "text": "真可以在家里备一套，",
      "token_start": 1558,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 458110,
      "end_ms": 460385,
      "text": "我放在左下方商品里了，",
      "token_start": 1567,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 460940,
      "end_ms": 462855,
      "text": "感兴趣的去瞅一眼，",
      "token_start": 1577,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 463320,
      "end_ms": 464855,
      "text": "好说回正题，",
      "token_start": 1585,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 465250,
      "end_ms": 467000,
      "text": "第一名西安，",
      "token_start": 1590,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 467500,
      "end_ms": 468435,
      "text": "古称长安，",
      "token_start": 1595,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 469230,
      "end_ms": 470435,
      "text": "为什么是他？",
      "token_start": 1599,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 470880,
      "end_ms": 473015,
      "text": "杭州写了一万两千首，",
      "token_start": 1604,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 473500,
      "end_ms": 475060,
      "text": "大家都以为他稳拿。",
      "token_start": 1613,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 475060,
      "end_ms": 475515,
      "text": "第一，",
      "token_start": 1621,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 476040,
      "end_ms": 479025,
      "text": "可大数据一统计长安二字，",
      "token_start": 1623,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 479410,
      "end_ms": 482155,
      "text": "加上西京、曲江等称谓，",
      "token_start": 1634,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 482540,
      "end_ms": 486575,
      "text": "在唐宋诗词里被写了整整两万多回，",
      "token_start": 1643,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 487120,
      "end_ms": 489745,
      "text": "足足比第二名多出了将近一倍。",
      "token_start": 1658,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 490430,
      "end_ms": 494975,
      "text": "唐朝的读书人头等大事就是考进长安，",
      "token_start": 1671,
      "token_end_exclusive": 1687
    },
    {
      "start_ms": 495470,
      "end_ms": 497995,
      "text": "一辈子的指望都压在这儿。",
      "token_start": 1687,
      "token_end_exclusive": 1698
    },
    {
      "start_ms": 498350,
      "end_ms": 499835,
      "text": "孟郊考了好几回，",
      "token_start": 1698,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 500270,
      "end_ms": 501350,
      "text": "前头落过榜，",
      "token_start": 1705,
      "token_end_exclusive": 1710
    },
    {
      "start_ms": 501870,
      "end_ms": 503885,
      "text": "四十六岁才中进士，",
      "token_start": 1710,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 504460,
      "end_ms": 507215,
      "text": "高兴的写下春风得意马蹄疾，",
      "token_start": 1718,
      "token_end_exclusive": 1730
    },
    {
      "start_ms": 507570,
      "end_ms": 509225,
      "text": "一日看尽长安花。",
      "token_start": 1730,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 509700,
      "end_ms": 512545,
      "text": "骑着马一天就把满城的花看完了，",
      "token_start": 1737,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 512960,
      "end_ms": 516005,
      "text": "可同一座城也能让人疼。",
      "token_start": 1751,
      "token_end_exclusive": 1761
    },
    {
      "start_ms": 516410,
      "end_ms": 517305,
      "text": "安史之乱，",
      "token_start": 1761,
      "token_end_exclusive": 1765
    },
    {
      "start_ms": 517730,
      "end_ms": 519035,
      "text": "杜甫被困在这儿，",
      "token_start": 1765,
      "token_end_exclusive": 1772
    },
    {
      "start_ms": 519310,
      "end_ms": 521705,
      "text": "看见的是国破山河在，",
      "token_start": 1772,
      "token_end_exclusive": 1781
    },
    {
      "start_ms": 522040,
      "end_ms": 523465,
      "text": "城春草木深，",
      "token_start": 1781,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 524200,
      "end_ms": 525360,
      "text": "山河还在，",
      "token_start": 1786,
      "token_end_exclusive": 1790
    },
    {
      "start_ms": 525600,
      "end_ms": 527385,
      "text": "城里只剩草木。",
      "token_start": 1790,
      "token_end_exclusive": 1796
    },
    {
      "start_ms": 527790,
      "end_ms": 528405,
      "text": "一句话，",
      "token_start": 1796,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 528750,
      "end_ms": 530825,
      "text": "把这座城的藤写透了，",
      "token_start": 1799,
      "token_end_exclusive": 1808
    },
    {
      "start_ms": 531250,
      "end_ms": 534515,
      "text": "少年白居易带着文稿踏进城门，",
      "token_start": 1808,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 535240,
      "end_ms": 539215,
      "text": "写下野火烧不尽春风吹又生，",
      "token_start": 1821,
      "token_end_exclusive": 1833
    },
    {
      "start_ms": 539860,
      "end_ms": 541705,
      "text": "从此名扬天下。",
      "token_start": 1833,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 542180,
      "end_ms": 543755,
      "text": "今天您去大雁塔，",
      "token_start": 1839,
      "token_end_exclusive": 1846
    },
    {
      "start_ms": 544180,
      "end_ms": 550020,
      "text": "当年的新科进士就在塔下提名去曲江池遗址公园。",
      "token_start": 1846,
      "token_end_exclusive": 1867
    },
    {
      "start_ms": 550340,
      "end_ms": 553155,
      "text": "当年的新科进士就在这儿摆宴。",
      "token_start": 1867,
      "token_end_exclusive": 1880
    },
    {
      "start_ms": 553570,
      "end_ms": 556250,
      "text": "杭州比的是湖扬州，",
      "token_start": 1880,
      "token_end_exclusive": 1888
    },
    {
      "start_ms": 556330,
      "end_ms": 558090,
      "text": "比的是河长安，",
      "token_start": 1888,
      "token_end_exclusive": 1894
    },
    {
      "start_ms": 558130,
      "end_ms": 559390,
      "text": "比的是读书人，",
      "token_start": 1894,
      "token_end_exclusive": 1900
    },
    {
      "start_ms": 559690,
      "end_ms": 562065,
      "text": "心里最大的那个念想。",
      "token_start": 1900,
      "token_end_exclusive": 1909
    },
    {
      "start_ms": 562890,
      "end_ms": 566165,
      "text": "两万多首诗从这里喷涌而出，",
      "token_start": 1909,
      "token_end_exclusive": 1921
    },
    {
      "start_ms": 566980,
      "end_ms": 569805,
      "text": "每一手里装的都是大唐文人，",
      "token_start": 1921,
      "token_end_exclusive": 1933
    },
    {
      "start_ms": 570110,
      "end_ms": 572090,
      "text": "拿命去博的虔程。",
      "token_start": 1933,
      "token_end_exclusive": 1940
    },
    {
      "start_ms": 572090,
      "end_ms": 578845,
      "text": "和天下十座城讲完了苏州在客船里敲响了千年晚钟。",
      "token_start": 1940,
      "token_end_exclusive": 1962
    },
    {
      "start_ms": 579500,
      "end_ms": 582875,
      "text": "成都在草堂绿竹中安顿的诗圣残年。",
      "token_start": 1962,
      "token_end_exclusive": 1977
    },
    {
      "start_ms": 583560,
      "end_ms": 586575,
      "text": "武汉在黄鹤楼前送进的天涯游子，",
      "token_start": 1977,
      "token_end_exclusive": 1991
    },
    {
      "start_ms": 587300,
      "end_ms": 590765,
      "text": "岳阳在八百里洞庭边挺直了文人家国。",
      "token_start": 1991,
      "token_end_exclusive": 2007
    },
    {
      "start_ms": 591240,
      "end_ms": 593240,
      "text": "扬州在大运河波光里，",
      "token_start": 2007,
      "token_end_exclusive": 2016
    },
    {
      "start_ms": 593380,
      "end_ms": 597940,
      "text": "聚起了八千首风乐洛阳在龙门颐河畔，",
      "token_start": 2016,
      "token_end_exclusive": 2032
    },
    {
      "start_ms": 598140,
      "end_ms": 599595,
      "text": "守着神都富贵。",
      "token_start": 2032,
      "token_end_exclusive": 2038
    },
    {
      "start_ms": 600140,
      "end_ms": 603140,
      "text": "开封把汴京市井填成了上万。",
      "token_start": 2038,
      "token_end_exclusive": 2050
    },
    {
      "start_ms": 603140,
      "end_ms": 607540,
      "text": "宋词南京在乌衣巷口看透了六朝沉浮。",
      "token_start": 2050,
      "token_end_exclusive": 2066
    },
    {
      "start_ms": 608020,
      "end_ms": 613540,
      "text": "杭州用两道长堤把西湖装进了一万两千首绝唱，",
      "token_start": 2066,
      "token_end_exclusive": 2086
    },
    {
      "start_ms": 614200,
      "end_ms": 621020,
      "text": "可只有长安把一个读书人一辈子的欢喜和眼泪全装在了里头。",
      "token_start": 2086,
      "token_end_exclusive": 2112
    },
    {
      "start_ms": 621720,
      "end_ms": 623340,
      "text": "数字排的是诗，",
      "token_start": 2112,
      "token_end_exclusive": 2118
    },
    {
      "start_ms": 624000,
      "end_ms": 627240,
      "text": "数出来的是人最多的那座城，",
      "token_start": 2118,
      "token_end_exclusive": 2130
    },
    {
      "start_ms": 627740,
      "end_ms": 629425,
      "text": "不是最美的地方，",
      "token_start": 2130,
      "token_end_exclusive": 2137
    },
    {
      "start_ms": 629970,
      "end_ms": 632590,
      "text": "是人心里最放不下的地方。",
      "token_start": 2137,
      "token_end_exclusive": 2148
    },
    {
      "start_ms": 632990,
      "end_ms": 634390,
      "text": "读懂这些诗句，",
      "token_start": 2148,
      "token_end_exclusive": 2154
    },
    {
      "start_ms": 634530,
      "end_ms": 636130,
      "text": "落地的古迹名城，",
      "token_start": 2154,
      "token_end_exclusive": 2161
    },
    {
      "start_ms": 636990,
      "end_ms": 640670,
      "text": "您才算真正摸到了咱们华夏文脉的根。",
      "token_start": 2161,
      "token_end_exclusive": 2177
    },
    {
      "start_ms": 641490,
      "end_ms": 646950,
      "text": "想顺着这条根往下读最才说的那本中国历史名城，",
      "token_start": 2177,
      "token_end_exclusive": 2198
    },
    {
      "start_ms": 647590,
      "end_ms": 652810,
      "text": "左下方商品里就有爱看古城古迹的朋友别错过。",
      "token_start": 2198,
      "token_end_exclusive": 2218
    },
    {
      "start_ms": 653250,
      "end_ms": 654310,
      "text": "最后问问您，",
      "token_start": 2218,
      "token_end_exclusive": 2223
    },
    {
      "start_ms": 654730,
      "end_ms": 656170,
      "text": "这十座名城，",
      "token_start": 2223,
      "token_end_exclusive": 2228
    },
    {
      "start_ms": 656550,
      "end_ms": 660365,
      "text": "您去过几座最想去的是哪一座？",
      "token_start": 2228,
      "token_end_exclusive": 2241
    },
    {
      "start_ms": 660750,
      "end_ms": 661825,
      "text": "评论区告诉我，",
      "token_start": 2241,
      "token_end_exclusive": 2247
    },
    {
      "start_ms": 662250,
      "end_ms": 664325,
      "text": "觉得这期让您长了见识，",
      "token_start": 2247,
      "token_end_exclusive": 2257
    },
    {
      "start_ms": 664810,
      "end_ms": 667210,
      "text": "就转给身边跟您一样。",
      "token_start": 2257,
      "token_end_exclusive": 2266
    },
    {
      "start_ms": 667250,
      "end_ms": 668815,
      "text": "爱看人文名城的人。",
      "token_start": 2266,
      "token_end_exclusive": 2274
    },
    {
      "start_ms": 669240,
      "end_ms": 672255,
      "text": "想读懂更多古城古迹里的文脉故事，",
      "token_start": 2274,
      "token_end_exclusive": 2289
    },
    {
      "start_ms": 672580,
      "end_ms": 673260,
      "text": "点个关注，",
      "token_start": 2289,
      "token_end_exclusive": 2293
    },
    {
      "start_ms": 673440,
      "end_ms": 674805,
      "text": "咱们下期接着聊。",
      "token_start": 2293,
      "token_end_exclusive": 2300
    }
  ],
