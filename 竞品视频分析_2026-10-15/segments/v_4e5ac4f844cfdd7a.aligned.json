{
  "video_id": "v_4e5ac4f844cfdd7a",
  "duration_s": 300.280998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_4e5ac4f844cfdd7a.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_4e5ac4f844cfdd7a.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 320,
      "end_ms": 4480,
      "text": "朱军一家八口人蜗居在香港五十平的出租里，",
      "token_start": 0,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4700,
      "end_ms": 6100,
      "text": "你想过这样的生活吗？",
      "token_start": 19,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 6180,
      "end_ms": 7720,
      "text": "你看香港的房子再小，",
      "token_start": 28,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 7720,
      "end_ms": 8780,
      "text": "都会设计一个保姆，",
      "token_start": 37,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 8780,
      "end_ms": 10400,
      "text": "间上铺是床，",
      "token_start": 45,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 10720,
      "end_ms": 12440,
      "text": "下铺是收纳的柜子，",
      "token_start": 50,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12740,
      "end_ms": 15600,
      "text": "还有他独立的洗澡、卫生间和洗衣机。",
      "token_start": 58,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 16240,
      "end_ms": 17960,
      "text": "菲佣的每个月四千多块钱，",
      "token_start": 73,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 17960,
      "end_ms": 19500,
      "text": "工资其实并不算高，",
      "token_start": 84,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 19900,
      "end_ms": 21420,
      "text": "和我们相处很负责任，",
      "token_start": 92,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 21520,
      "end_ms": 22480,
      "text": "也很有边界感。",
      "token_start": 101,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 22960,
      "end_ms": 23340,
      "text": "今天，",
      "token_start": 107,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 23340,
      "end_ms": 25540,
      "text": "中秋节带我儿子去上幼儿园，",
      "token_start": 109,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 25960,
      "end_ms": 29020,
      "text": "发现全校每个孩子都穿着中式传统服装，",
      "token_start": 121,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 29260,
      "end_ms": 33050,
      "text": "特别重视小朋友们手里还都拎着自己做的花灯，",
      "token_start": 138,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 33550,
      "end_ms": 36290,
      "text": "还会给邻居和物业派发月饼礼物。",
      "token_start": 158,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 36930,
      "end_ms": 39390,
      "text": "带我儿子逛了一下维多利亚公园的彩灯，",
      "token_start": 172,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 39810,
      "end_ms": 41430,
      "text": "黄大仙子的莺歌舞，",
      "token_start": 189,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 41650,
      "end_ms": 43830,
      "text": "我们还赶上了铜锣湾的五火龙，",
      "token_start": 197,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 44450,
      "end_ms": 48670,
      "text": "长长的火龙在人群中翻香龙身插了几千根。",
      "token_start": 210,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 48670,
      "end_ms": 53210,
      "text": "檀香仪式结束后会把这些香火分发给路人游客，",
      "token_start": 228,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 53850,
      "end_ms": 56510,
      "text": "诸君祝福每一个看到火龙的你，",
      "token_start": 248,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 56690,
      "end_ms": 58070,
      "text": "一切顺顺利利。",
      "token_start": 261,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 58510,
      "end_ms": 59450,
      "text": "今年中秋节，",
      "token_start": 267,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 59470,
      "end_ms": 60200,
      "text": "我们家很热，",
      "token_start": 272,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 60240,
      "end_ms": 60540,
      "text": "电脑，",
      "token_start": 277,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 61020,
      "end_ms": 63395,
      "text": "安娜、爷爷奶奶、姥姥姥爷都在，",
      "token_start": 279,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 63760,
      "end_ms": 70130,
      "text": "再加上保姆阿姨和我家的黑猫警长阿sir全家八口人加一只猫挤在一起，",
      "token_start": 291,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 70250,
      "end_ms": 71095,
      "text": "其乐融融。",
      "token_start": 321,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 71750,
      "end_ms": 73995,
      "text": "这只猫是五年前在路边捡来的，",
      "token_start": 325,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 74300,
      "end_ms": 75935,
      "text": "现在成了我们的家人。",
      "token_start": 338,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 76480,
      "end_ms": 78395,
      "text": "阿瑟很快适应了香港的生活。",
      "token_start": 347,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 78910,
      "end_ms": 81545,
      "text": "我老婆是西安人我是淮安人，",
      "token_start": 359,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 81900,
      "end_ms": 83245,
      "text": "所以我儿子叫安安，",
      "token_start": 371,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 83700,
      "end_ms": 87270,
      "text": "现在他叫铜锣湾安仔嘟图姐快呀。",
      "token_start": 379,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 87290,
      "end_ms": 91065,
      "text": "猫咪为什么想到带孩子来香港上学？",
      "token_start": 393,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 91460,
      "end_ms": 96545,
      "text": "其实我并不是想让我儿子接受香港本地的DSE考试和华侨生联考，",
      "token_start": 408,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 96960,
      "end_ms": 99555,
      "text": "我特别认可一众将IB的教育体系。",
      "token_start": 435,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 99970,
      "end_ms": 103465,
      "text": "而中国实行IB学校最多的城市就是香港，",
      "token_start": 449,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 104120,
      "end_ms": 106625,
      "text": "而且这是全球最难的一种课程体系，",
      "token_start": 466,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 106870,
      "end_ms": 108555,
      "text": "对孩子的挑战会非常大，",
      "token_start": 481,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 108970,
      "end_ms": 113735,
      "text": "他要比内地的高考要比level AP、 DSE等等都要更难。",
      "token_start": 491,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 114140,
      "end_ms": 115280,
      "text": "不仅要求会考试，",
      "token_start": 510,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 115460,
      "end_ms": 118175,
      "text": "还要学会独立做研究、写长论文。",
      "token_start": 517,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 118590,
      "end_ms": 120850,
      "text": "而且IB教育很强调尊重差异，",
      "token_start": 530,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 121090,
      "end_ms": 122325,
      "text": "主动与别人合作，",
      "token_start": 542,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 122790,
      "end_ms": 124985,
      "text": "多数人追求的根本就不是幸福，",
      "token_start": 549,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 125290,
      "end_ms": 126835,
      "text": "而是高人一等的优越感。",
      "token_start": 562,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 127350,
      "end_ms": 129815,
      "text": "我很认可IB这种很善良的教育观。",
      "token_start": 572,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 130180,
      "end_ms": 132595,
      "text": "我希望我的孩子他会主动阅读，",
      "token_start": 586,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 132890,
      "end_ms": 133990,
      "text": "会批判性思考，",
      "token_start": 599,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 134290,
      "end_ms": 136885,
      "text": "勇于表达、尊重这个丰富的世界。",
      "token_start": 605,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 137330,
      "end_ms": 140165,
      "text": "人成长的过程就是在逐渐减少偏见。",
      "token_start": 618,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 140700,
      "end_ms": 144835,
      "text": "目前内地在幼儿园和小学阶段就开始实行IB教育的很少。",
      "token_start": 633,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 145210,
      "end_ms": 147705,
      "text": "其实上海和北京的IB中学也很好。",
      "token_start": 657,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 148100,
      "end_ms": 149660,
      "text": "我之所以没有在香港买房，",
      "token_start": 671,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 150060,
      "end_ms": 152805,
      "text": "就是想着以后也许随着我儿子上中学，",
      "token_start": 682,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 153040,
      "end_ms": 154485,
      "text": "我们还会继续搬家。",
      "token_start": 698,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 155020,
      "end_ms": 156615,
      "text": "我不在任何城市下注，",
      "token_start": 706,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 156890,
      "end_ms": 159120,
      "text": "不在任何地点抱有定居思维，",
      "token_start": 715,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 159320,
      "end_ms": 161055,
      "text": "也不和任何人或物绑定，",
      "token_start": 727,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 161540,
      "end_ms": 163720,
      "text": "随时随地拥有绝对的迁徙。",
      "token_start": 737,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 163720,
      "end_ms": 165000,
      "text": "权要知道，",
      "token_start": 748,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 165000,
      "end_ms": 165520,
      "text": "这几年，",
      "token_start": 752,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 165520,
      "end_ms": 166880,
      "text": "我为了寻找IB学校，",
      "token_start": 755,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 167080,
      "end_ms": 172055,
      "text": "专门考察过加拿大、芬兰、德国、美国、新西兰等等很多国家，",
      "token_start": 763,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 172320,
      "end_ms": 175510,
      "text": "但最终还是选择回到中国香港，",
      "token_start": 786,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 175510,
      "end_ms": 176335,
      "text": "很国际化，",
      "token_start": 799,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 176640,
      "end_ms": 178435,
      "text": "但他永远是我们中国的香港。",
      "token_start": 803,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 178730,
      "end_ms": 181645,
      "text": "这是一个可进可退的、很现实的城市选择，",
      "token_start": 815,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 182250,
      "end_ms": 184545,
      "text": "我对其他国家真的实在没有归属感。",
      "token_start": 832,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 185070,
      "end_ms": 186675,
      "text": "你要让我去国外旅游，",
      "token_start": 847,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 186940,
      "end_ms": 187835,
      "text": "但我非常开心，",
      "token_start": 856,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 188330,
      "end_ms": 190295,
      "text": "但真要让我长期住在那里，",
      "token_start": 862,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 190730,
      "end_ms": 191755,
      "text": "想想都很孤独。",
      "token_start": 873,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 192420,
      "end_ms": 193780,
      "text": "我看到很多国外的陪读，",
      "token_start": 879,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 193780,
      "end_ms": 196565,
      "text": "父母表面看起来物质生活很丰富，",
      "token_start": 889,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 196870,
      "end_ms": 198505,
      "text": "但是内心都异常痛苦。",
      "token_start": 903,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 198900,
      "end_ms": 202025,
      "text": "因为你知道你很难融入当地的主流生活，",
      "token_start": 912,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 202640,
      "end_ms": 204975,
      "text": "而为什么做游客的时候总是快乐的？",
      "token_start": 929,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 205200,
      "end_ms": 208215,
      "text": "因为你知道你的痛苦和责任都不在这里，",
      "token_start": 944,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 208560,
      "end_ms": 209435,
      "text": "置身事外，",
      "token_start": 961,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 209820,
      "end_ms": 211095,
      "text": "才能感受到幸福。",
      "token_start": 965,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 211840,
      "end_ms": 212280,
      "text": "爸爸，",
      "token_start": 972,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 212280,
      "end_ms": 213960,
      "text": "你这样好好嗯，",
      "token_start": 974,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 214300,
      "end_ms": 214965,
      "text": "好吃吗？",
      "token_start": 980,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 215750,
      "end_ms": 219460,
      "text": "是嗯这么大，",
      "token_start": 983,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 220220,
      "end_ms": 220945,
      "text": "你吃这么多，",
      "token_start": 988,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 222640,
      "end_ms": 223255,
      "text": "慢点吃，",
      "token_start": 993,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 225400,
      "end_ms": 227140,
      "text": "我期待安安在香港成长，",
      "token_start": 996,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 227360,
      "end_ms": 228560,
      "text": "经常跟着我往返。",
      "token_start": 1006,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 228580,
      "end_ms": 231055,
      "text": "香港和北京既有中国灵魂，",
      "token_start": 1013,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 231320,
      "end_ms": 232465,
      "text": "又有世界胸怀。",
      "token_start": 1024,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 232920,
      "end_ms": 234115,
      "text": "香港人特别爱国，",
      "token_start": 1030,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 234450,
      "end_ms": 235895,
      "text": "街头处处挂着国旗。",
      "token_start": 1037,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 236300,
      "end_ms": 236880,
      "text": "在香港，",
      "token_start": 1045,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 236960,
      "end_ms": 239575,
      "text": "我最喜欢的就是自己在家做油泼面吃。",
      "token_start": 1048,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 240350,
      "end_ms": 241630,
      "text": "你看香港这么发达，",
      "token_start": 1064,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 241810,
      "end_ms": 244210,
      "text": "怎么还是给人一种九十年代的感觉。",
      "token_start": 1072,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 244790,
      "end_ms": 248690,
      "text": "其实内地普通人的生活便利性是遥遥领先的。",
      "token_start": 1087,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 249230,
      "end_ms": 252530,
      "text": "每一个在香港打拼的内地朋友都各有心算。",
      "token_start": 1106,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 252950,
      "end_ms": 255630,
      "text": "我很佩服每一个能出去单打独斗的人，",
      "token_start": 1124,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 255870,
      "end_ms": 257610,
      "text": "敢想敢拼敢干，",
      "token_start": 1140,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 257890,
      "end_ms": 259470,
      "text": "一个人就能活出一个队伍。",
      "token_start": 1146,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 259950,
      "end_ms": 260970,
      "text": "你可以回头看，",
      "token_start": 1157,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 261330,
      "end_ms": 262450,
      "text": "但不能往回走。",
      "token_start": 1163,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 262810,
      "end_ms": 263230,
      "text": "朱军，",
      "token_start": 1169,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 263490,
      "end_ms": 264190,
      "text": "你知道吗？",
      "token_start": 1171,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 264410,
      "end_ms": 267070,
      "text": "我儿子到维多利亚港只要二十分钟，",
      "token_start": 1175,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 267450,
      "end_ms": 269855,
      "text": "但我这一路走了三十多年，",
      "token_start": 1190,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 270500,
      "end_ms": 271400,
      "text": "而你相信吗？",
      "token_start": 1201,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 271620,
      "end_ms": 273960,
      "text": "你莫名向往的那个陌生的城市，",
      "token_start": 1206,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 274120,
      "end_ms": 275940,
      "text": "都是今生有羁绊的地方。",
      "token_start": 1219,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 276400,
      "end_ms": 279220,
      "text": "那种心底的拉扯从不是偶然，",
      "token_start": 1229,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 279600,
      "end_ms": 282640,
      "text": "而是上天在指引你去完成未尽的缘分。",
      "token_start": 1241,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 283160,
      "end_ms": 285400,
      "text": "那里或许有你要重逢的人，",
      "token_start": 1257,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 285640,
      "end_ms": 287300,
      "text": "又或许有属于你的机会。",
      "token_start": 1268,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 287680,
      "end_ms": 289320,
      "text": "当你站在那片土地上时，",
      "token_start": 1278,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 289320,
      "end_ms": 290300,
      "text": "你才会明白，",
      "token_start": 1288,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 290640,
      "end_ms": 293160,
      "text": "所有的奔赴都是命中注定的。",
      "token_start": 1293,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 293340,
      "end_ms": 294300,
      "text": "久别重逢，",
      "token_start": 1305,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 294900,
      "end_ms": 295500,
      "text": "祝福你，",
      "token_start": 1309,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 295680,
      "end_ms": 297360,
      "text": "别再过你应该过的人生。",
      "token_start": 1312,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 297660,
      "end_ms": 299695,
      "text": "去过你想过的人生。",
      "token_start": 1322,
      "token_end_exclusive": 1330
    }
  ],
