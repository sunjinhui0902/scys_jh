{
  "video_id": "v_3706898b9468c498",
  "duration_s": 420.35,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_3706898b9468c498.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_3706898b9468c498.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1250,
      "text": "没留过一天，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1250,
      "end_ms": 3470,
      "text": "羊却造出中国氢弹，",
      "token_start": 5,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 4270,
      "end_ms": 5370,
      "text": "外国人慌了，",
      "token_start": 13,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 6350,
      "end_ms": 6990,
      "text": "不可能，",
      "token_start": 18,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 7750,
      "end_ms": 10170,
      "text": "你们肯定是偷的家人们。",
      "token_start": 21,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 10310,
      "end_ms": 11790,
      "text": "全世界造氢弹，",
      "token_start": 31,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 12150,
      "end_ms": 13650,
      "text": "美国用了七年多，",
      "token_start": 37,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 13970,
      "end_ms": 15270,
      "text": "苏联用了四年，",
      "token_start": 44,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 15850,
      "end_ms": 18450,
      "text": "可有一个国家连计算机都没有，",
      "token_start": 50,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 18690,
      "end_ms": 21390,
      "text": "只用了两年零八个月就造出来了，",
      "token_start": 63,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 21510,
      "end_ms": 23010,
      "text": "比美国快了四年半。",
      "token_start": 77,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 23590,
      "end_ms": 24870,
      "text": "外国人打死不信，",
      "token_start": 85,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25130,
      "end_ms": 26790,
      "text": "说中国人肯定是偷的。",
      "token_start": 92,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 27210,
      "end_ms": 30340,
      "text": "可他们不知道造出这颗氢弹的药人，",
      "token_start": 101,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 30660,
      "end_ms": 32860,
      "text": "这辈子连一天羊都没留过，",
      "token_start": 116,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 33620,
      "end_ms": 34960,
      "text": "他叫俞敏。",
      "token_start": 127,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 34980,
      "end_ms": 38960,
      "text": "今天我就给你讲讲这个让外国人慌了神的中国老人。",
      "token_start": 131,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 40080,
      "end_ms": 45020,
      "text": "俞敏年轻的时候是国内顶尖的理论物理天才，",
      "token_start": 153,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 45860,
      "end_ms": 46680,
      "text": "二十多岁，",
      "token_start": 172,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 46860,
      "end_ms": 49440,
      "text": "就在学术界闯出了名气。",
      "token_start": 176,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 50120,
      "end_ms": 53860,
      "text": "当时很多人都说俞敏要是去国外留学深造，",
      "token_start": 186,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 54200,
      "end_ms": 56020,
      "text": "将来肯定能拿诺贝尔奖。",
      "token_start": 204,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 56560,
      "end_ms": 59885,
      "text": "可就在一九六一年领导找他谈了一次话，",
      "token_start": 214,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 60230,
      "end_ms": 61395,
      "text": "改变了他的一生。",
      "token_start": 231,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 61970,
      "end_ms": 62645,
      "text": "领导说，",
      "token_start": 238,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 63790,
      "end_ms": 64945,
      "text": "国家要搞氢弹，",
      "token_start": 241,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 65800,
      "end_ms": 70360,
      "text": "需要你转行来做这件事是最高机密，",
      "token_start": 247,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 70380,
      "end_ms": 75015,
      "text": "以后你就不能再发表论文了也不能再公开露面。",
      "token_start": 262,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 75910,
      "end_ms": 79445,
      "text": "你的名字要从学术界彻底消失。",
      "token_start": 282,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 80090,
      "end_ms": 84795,
      "text": "那时候的渔民在自己的研究领域正做的顺风顺水，",
      "token_start": 295,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 85470,
      "end_ms": 86895,
      "text": "前途一片光明。",
      "token_start": 316,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 87450,
      "end_ms": 88155,
      "text": "搞清淡，",
      "token_start": 322,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 88450,
      "end_ms": 91005,
      "text": "意味着要放弃自己熟悉的领域，",
      "token_start": 325,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 91510,
      "end_ms": 92645,
      "text": "从零开始，",
      "token_start": 338,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 92960,
      "end_ms": 94445,
      "text": "还要隐姓埋名，",
      "token_start": 342,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 94810,
      "end_ms": 96095,
      "text": "一辈子不能出名，",
      "token_start": 348,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 96630,
      "end_ms": 97565,
      "text": "换做别人，",
      "token_start": 355,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 97920,
      "end_ms": 99545,
      "text": "可能还要犹豫一下，",
      "token_start": 359,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 100140,
      "end_ms": 101925,
      "text": "可俞敏当场就答应了。",
      "token_start": 367,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 102750,
      "end_ms": 103135,
      "text": "他说，",
      "token_start": 376,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 103620,
      "end_ms": 104620,
      "text": "国家兴亡，",
      "token_start": 378,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 104940,
      "end_ms": 106135,
      "text": "匹夫有责，",
      "token_start": 382,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 106530,
      "end_ms": 107610,
      "text": "国家需要我，",
      "token_start": 386,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 107610,
      "end_ms": 109250,
      "text": "我就去做外国人，",
      "token_start": 391,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 109250,
      "end_ms": 110215,
      "text": "能造出来的，",
      "token_start": 398,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 110460,
      "end_ms": 113775,
      "text": "我们中国人也一定能就这么着，",
      "token_start": 403,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 114120,
      "end_ms": 117175,
      "text": "于敏从公众视野里彻底消失了，",
      "token_start": 416,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 117430,
      "end_ms": 120535,
      "text": "这一消失就是整整二十八年。",
      "token_start": 429,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 121140,
      "end_ms": 122425,
      "text": "搞清淡有多难。",
      "token_start": 441,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 123280,
      "end_ms": 127105,
      "text": "当时全世界只有美国和苏联掌握氢弹技术，",
      "token_start": 447,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 127440,
      "end_ms": 128500,
      "text": "严密封锁，",
      "token_start": 465,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 128700,
      "end_ms": 131165,
      "text": "连一点点资料都露不出来。",
      "token_start": 469,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 131710,
      "end_ms": 132725,
      "text": "我们没有经验，",
      "token_start": 480,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 132930,
      "end_ms": 133655,
      "text": "没有图纸，",
      "token_start": 486,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 134170,
      "end_ms": 136565,
      "text": "甚至连氢弹长什么样都不知道。",
      "token_start": 490,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 137120,
      "end_ms": 138100,
      "text": "没有计算机，",
      "token_start": 503,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 138380,
      "end_ms": 139795,
      "text": "他们就用算盘算，",
      "token_start": 508,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 140120,
      "end_ms": 142060,
      "text": "用计算尺算几个人，",
      "token_start": 515,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 142060,
      "end_ms": 143485,
      "text": "一组轮班倒，",
      "token_start": 523,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 143890,
      "end_ms": 145615,
      "text": "一天算十几个小时，",
      "token_start": 528,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 146100,
      "end_ms": 149045,
      "text": "眼睛都熬红了手都算肿了。",
      "token_start": 536,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 149530,
      "end_ms": 152995,
      "text": "算出来的草稿纸堆满了一整个屋子，",
      "token_start": 547,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 153350,
      "end_ms": 154445,
      "text": "俞敏更是拼，",
      "token_start": 562,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 154990,
      "end_ms": 156825,
      "text": "他每天工作十几个小时，",
      "token_start": 567,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 157120,
      "end_ms": 159115,
      "text": "连吃饭睡觉都在想问题。",
      "token_start": 577,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 159750,
      "end_ms": 160745,
      "text": "有好几次，",
      "token_start": 587,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 161050,
      "end_ms": 162490,
      "text": "他因为过度劳累，",
      "token_start": 591,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 162670,
      "end_ms": 164915,
      "text": "直接晕倒在了办公室，",
      "token_start": 598,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 165460,
      "end_ms": 168530,
      "text": "被送到医院抢救醒过来。",
      "token_start": 607,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 168530,
      "end_ms": 171714,
      "text": "第一句话还是问工作进展怎么样了。",
      "token_start": 617,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 172440,
      "end_ms": 173520,
      "text": "那时候条件苦，",
      "token_start": 632,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 173660,
      "end_ms": 174220,
      "text": "吃不饱，",
      "token_start": 638,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 174260,
      "end_ms": 174885,
      "text": "穿不暖。",
      "token_start": 641,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 175260,
      "end_ms": 177280,
      "text": "冬天办公室里没有暖气，",
      "token_start": 644,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 177400,
      "end_ms": 179084,
      "text": "冻得手都握不住笔，",
      "token_start": 654,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 179810,
      "end_ms": 181470,
      "text": "可没有一个人叫苦，",
      "token_start": 662,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 181690,
      "end_ms": 183135,
      "text": "没有一个人退缩。",
      "token_start": 670,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 183820,
      "end_ms": 185425,
      "text": "因为大家心里都清楚，",
      "token_start": 677,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 186000,
      "end_ms": 187965,
      "text": "这不是一份普通的工作，",
      "token_start": 686,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 188640,
      "end_ms": 190485,
      "text": "这是在给国家铸盾牌，",
      "token_start": 696,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 190960,
      "end_ms": 192645,
      "text": "就这么没日没夜的干，",
      "token_start": 705,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 193440,
      "end_ms": 201035,
      "text": "俞敏带领团队居然真的摸索出了一套完全属于中国人自己的清淡方案。",
      "token_start": 714,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 201240,
      "end_ms": 203735,
      "text": "也就是后来震惊世界的俞敏构型。",
      "token_start": 744,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 204300,
      "end_ms": 205565,
      "text": "这个构型有多牛？",
      "token_start": 758,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 205990,
      "end_ms": 209505,
      "text": "全世界的清淡一共就两种构型。",
      "token_start": 765,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 210070,
      "end_ms": 211375,
      "text": "遗嘱是美国的，",
      "token_start": 778,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 211770,
      "end_ms": 213985,
      "text": "另一种就是中国的渔敏构型。",
      "token_start": 784,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 214850,
      "end_ms": 221035,
      "text": "而且俞敏构型在维护成本保存时间上比美国的还要先进。",
      "token_start": 796,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 222190,
      "end_ms": 224055,
      "text": "一九六七年六月十七日，",
      "token_start": 820,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 224400,
      "end_ms": 228165,
      "text": "罗布泊情俞敏站在指挥所外面，",
      "token_start": 830,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 228560,
      "end_ms": 230375,
      "text": "仰头看着天空，",
      "token_start": 843,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 231030,
      "end_ms": 234725,
      "text": "那架运载氢弹的飞机在头顶画着圈儿，",
      "token_start": 849,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 235170,
      "end_ms": 236635,
      "text": "一圈儿又一圈，",
      "token_start": 865,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 237470,
      "end_ms": 240165,
      "text": "现场安静的能听见自己的心跳。",
      "token_start": 871,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 240780,
      "end_ms": 242830,
      "text": "八点整天空突然亮了，",
      "token_start": 884,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 242830,
      "end_ms": 243735,
      "text": "比太阳还亮，",
      "token_start": 893,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 244670,
      "end_ms": 249645,
      "text": "一朵巨大的蘑菇云从地平线上升起来越升越高。",
      "token_start": 898,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 249940,
      "end_ms": 251985,
      "text": "像一座突然长出来的山，",
      "token_start": 918,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 252550,
      "end_ms": 253795,
      "text": "所有人都疯了，",
      "token_start": 928,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 254220,
      "end_ms": 255915,
      "text": "跳起来抱在一起，",
      "token_start": 934,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 256360,
      "end_ms": 259495,
      "text": "哭的笑的吼的闹的混成一片，",
      "token_start": 941,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 260120,
      "end_ms": 263365,
      "text": "只有俞敏站在原地一动不动。",
      "token_start": 953,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 264370,
      "end_ms": 269135,
      "text": "他仰着头看着那片蘑菇云看了很久很久，",
      "token_start": 965,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 270060,
      "end_ms": 274205,
      "text": "然后眼泪顺着他的脸颊无声的留了下来。",
      "token_start": 982,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 275160,
      "end_ms": 276285,
      "text": "他没有欢呼，",
      "token_start": 999,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 276600,
      "end_ms": 277645,
      "text": "也没有说话，",
      "token_start": 1004,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 278160,
      "end_ms": 279815,
      "text": "可家人们你们知道吗？",
      "token_start": 1009,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 280600,
      "end_ms": 281495,
      "text": "为了这一天，",
      "token_start": 1018,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 281990,
      "end_ms": 285510,
      "text": "这个文弱书生几年里晕倒在办公室，",
      "token_start": 1023,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 285510,
      "end_ms": 288460,
      "text": "好多次被送进医院醒过来，",
      "token_start": 1038,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 288460,
      "end_ms": 291425,
      "text": "第一句话问的还是算到哪一步了？",
      "token_start": 1049,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 292030,
      "end_ms": 294725,
      "text": "从一张白纸到这颗清淡。",
      "token_start": 1063,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 295230,
      "end_ms": 298050,
      "text": "他只用了两年零八个月，",
      "token_start": 1073,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 298670,
      "end_ms": 300330,
      "text": "美国人用了七年多，",
      "token_start": 1083,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 300830,
      "end_ms": 302250,
      "text": "苏联人用了四年。",
      "token_start": 1091,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 302830,
      "end_ms": 305110,
      "text": "外国的专家们怎么也想不通，",
      "token_start": 1098,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 305430,
      "end_ms": 308290,
      "text": "一个连计算机都要靠算盘的国家，",
      "token_start": 1110,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 308470,
      "end_ms": 309610,
      "text": "怎么可能这么快？",
      "token_start": 1124,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 310150,
      "end_ms": 310910,
      "text": "他们不懂，",
      "token_start": 1131,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 311250,
      "end_ms": 314090,
      "text": "他们永远也不会懂中国人逼急了，",
      "token_start": 1135,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 314570,
      "end_ms": 317790,
      "text": "是可以不要命的氢弹造出来了，",
      "token_start": 1149,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 317910,
      "end_ms": 320910,
      "text": "可于敏的名字还是没人知道。",
      "token_start": 1162,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 321210,
      "end_ms": 323130,
      "text": "他继续隐姓埋名，",
      "token_start": 1174,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 323630,
      "end_ms": 326100,
      "text": "继续在幕后默默工作，",
      "token_start": 1181,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 326400,
      "end_ms": 328780,
      "text": "为中国的核武器事业操劳。",
      "token_start": 1190,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 329040,
      "end_ms": 330400,
      "text": "直到一九八八年，",
      "token_start": 1201,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 330720,
      "end_ms": 333260,
      "text": "俞敏的身份才正式解密。",
      "token_start": 1208,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 333860,
      "end_ms": 334420,
      "text": "这时候，",
      "token_start": 1218,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 334420,
      "end_ms": 335300,
      "text": "人们才知道，",
      "token_start": 1221,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 335660,
      "end_ms": 337640,
      "text": "原来中国氢弹的背后，",
      "token_start": 1226,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 337860,
      "end_ms": 340320,
      "text": "有这样一位伟大的科学家。",
      "token_start": 1235,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 340920,
      "end_ms": 341820,
      "text": "有人问他，",
      "token_start": 1246,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 342240,
      "end_ms": 344400,
      "text": "你这辈子隐姓埋名，",
      "token_start": 1250,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 344700,
      "end_ms": 345720,
      "text": "放弃了名利，",
      "token_start": 1258,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 346040,
      "end_ms": 347520,
      "text": "放弃了学术前途，",
      "token_start": 1263,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 348020,
      "end_ms": 348760,
      "text": "后悔吗？",
      "token_start": 1270,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 349180,
      "end_ms": 350140,
      "text": "俞敏笑着说，",
      "token_start": 1273,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 350520,
      "end_ms": 354040,
      "text": "我这辈子最大的心愿就是国家不受欺负，",
      "token_start": 1278,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 354340,
      "end_ms": 355730,
      "text": "能为国家他做点事儿，",
      "token_start": 1295,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 355730,
      "end_ms": 357135,
      "text": "我这辈子就值了。",
      "token_start": 1304,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 357670,
      "end_ms": 358310,
      "text": "家人们，",
      "token_start": 1311,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 358390,
      "end_ms": 359835,
      "text": "什么叫民族脊梁？",
      "token_start": 1314,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 360270,
      "end_ms": 362165,
      "text": "这就是啊没有留过洋，",
      "token_start": 1321,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 362510,
      "end_ms": 363785,
      "text": "没有喝过洋墨水。",
      "token_start": 1330,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 364200,
      "end_ms": 366345,
      "text": "可他凭着一腔爱国热血，",
      "token_start": 1337,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 366730,
      "end_ms": 369025,
      "text": "凭着一股子不服输的劲头，",
      "token_start": 1347,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 369610,
      "end_ms": 373125,
      "text": "硬生生为中国撑起了一把核保护伞。",
      "token_start": 1358,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 373610,
      "end_ms": 375005,
      "text": "他没有拿过诺贝尔奖，",
      "token_start": 1373,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 375390,
      "end_ms": 378485,
      "text": "可他的功劳比诺贝尔奖重千斤。",
      "token_start": 1382,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 379130,
      "end_ms": 389680,
      "text": "他的名字值得我们每一个中国人永远铭记为于老感到自豪的在评论区打中国骄傲四个字，",
      "token_start": 1395,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 389740,
      "end_ms": 396455,
      "text": "让咱中国人看看有多少人记得他把这条视频转到同学群、战友群，",
      "token_start": 1433,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 396960,
      "end_ms": 400085,
      "text": "让大家看看中国人到底有多硬气。",
      "token_start": 1460,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 400370,
      "end_ms": 402390,
      "text": "点个收藏以后，",
      "token_start": 1474,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 402390,
      "end_ms": 404525,
      "text": "孩子问为什么咱们中国这么牛，",
      "token_start": 1480,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 405100,
      "end_ms": 406715,
      "text": "这就是现成的答案。",
      "token_start": 1493,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 407450,
      "end_ms": 408135,
      "text": "关注我，",
      "token_start": 1501,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 408520,
      "end_ms": 411115,
      "text": "每天讲一位国之脊梁。",
      "token_start": 1504,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 411790,
      "end_ms": 414215,
      "text": "像俞敏这样为国助盾的人，",
      "token_start": 1513,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 414620,
      "end_ms": 415845,
      "text": "书里还有四十位，",
      "token_start": 1524,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 416370,
      "end_ms": 420245,
      "text": "每一篇都让你觉得生在中国值了。",
      "token_start": 1531,
      "token_end_exclusive": 1545
    }
  ],
