  "segments": [
    {
      "start_ms": 130,
      "end_ms": 590,
      "text": "记住，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1150,
      "end_ms": 2010,
      "text": "不要做生意，",
      "token_start": 2,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2350,
      "end_ms": 3930,
      "text": "要做资产生意，",
      "token_start": 7,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3930,
      "end_ms": 5430,
      "text": "做的是利润越做越累，",
      "token_start": 13,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5730,
      "end_ms": 8070,
      "text": "而资产做的是现就流越做越稳。",
      "token_start": 22,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 8450,
      "end_ms": 9810,
      "text": "老板的尽头是收支，",
      "token_start": 35,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 10070,
      "end_ms": 11410,
      "text": "创业的尽头是自由，",
      "token_start": 43,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 11510,
      "end_ms": 12850,
      "text": "要想实现财富自由，",
      "token_start": 51,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 13030,
      "end_ms": 14110,
      "text": "只有三条路径，",
      "token_start": 59,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 14470,
      "end_ms": 15730,
      "text": "要么靠人力杠杆，",
      "token_start": 65,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 15830,
      "end_ms": 17090,
      "text": "让一群人帮你赚钱，",
      "token_start": 72,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 17390,
      "end_ms": 18590,
      "text": "要么靠资本杠杆，",
      "token_start": 80,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 18830,
      "end_ms": 20210,
      "text": "让你的钱自动生钱，",
      "token_start": 87,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 20590,
      "end_ms": 21770,
      "text": "要么靠资产杠杆，",
      "token_start": 95,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 22110,
      "end_ms": 24810,
      "text": "让你手里的动产和不动产收租赚钱。",
      "token_start": 102,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 24890,
      "end_ms": 25830,
      "text": "缺少了这三样，",
      "token_start": 117,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 26150,
      "end_ms": 28370,
      "text": "那你只能用体力和时间来换酬劳，",
      "token_start": 123,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 28370,
      "end_ms": 30480,
      "text": "本质就是拿命运换钱。",
      "token_start": 137,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 31080,
      "end_ms": 33040,
      "text": "你以后多看看这本隐形的契约，",
      "token_start": 146,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 33520,
      "end_ms": 36220,
      "text": "很多认知和赚钱思维都是来源于这本书。",
      "token_start": 159,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 36360,
      "end_ms": 37540,
      "text": "你看这社会多奇怪，",
      "token_start": 176,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 38100,
      "end_ms": 39080,
      "text": "好多人不上班，",
      "token_start": 184,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 39180,
      "end_ms": 40280,
      "text": "但是日子过得挺好，",
      "token_start": 190,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 40420,
      "end_ms": 41300,
      "text": "哪来的钱呢？",
      "token_start": 198,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 41660,
      "end_ms": 42800,
      "text": "有些人天天上班，",
      "token_start": 203,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 42820,
      "end_ms": 43540,
      "text": "反而没有钱。",
      "token_start": 210,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 43960,
      "end_ms": 45360,
      "text": "后来看完这本书才发现，",
      "token_start": 215,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 45560,
      "end_ms": 47100,
      "text": "原来秘密都在这本书里，",
      "token_start": 225,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 47400,
      "end_ms": 48720,
      "text": "叫做隐形的契约。",
      "token_start": 235,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 48900,
      "end_ms": 50820,
      "text": "如果你想了解更多赚钱思路，",
      "token_start": 242,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 51000,
      "end_ms": 52600,
      "text": "那你熬夜也要看完这本书，",
      "token_start": 254,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 52940,
      "end_ms": 54340,
      "text": "它就是一本赚钱秘籍。",
      "token_start": 265,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 54540,
      "end_ms": 56200,
      "text": "读完后惊出一身冷汗，",
      "token_start": 274,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 56540,
      "end_ms": 59795,
      "text": "会发现自己以前的思维认知就像被带上了枷锁。",
      "token_start": 283,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 60270,
      "end_ms": 61295,
      "text": "而每翻开一页，",
      "token_start": 303,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 61520,
      "end_ms": 63060,
      "text": "都像是打开了一扇心窗，",
      "token_start": 309,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 63260,
      "end_ms": 64440,
      "text": "勤劳能致富吗？",
      "token_start": 319,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 64720,
      "end_ms": 68620,
      "text": "外卖小哥凌晨三四点下班也赚不到一万块，",
      "token_start": 325,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 68840,
      "end_ms": 70060,
      "text": "靠打工发不了财。",
      "token_start": 343,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 70300,
      "end_ms": 73280,
      "text": "书中教的全是互利社交的方法和商业法则，",
      "token_start": 350,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 73480,
      "end_ms": 74780,
      "text": "帮你打破社交误区，",
      "token_start": 368,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 74960,
      "end_ms": 76020,
      "text": "拆解关系核心，",
      "token_start": 376,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 76200,
      "end_ms": 77220,
      "text": "掌握相处方法，",
      "token_start": 382,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 77460,
      "end_ms": 79435,
      "text": "讲透社会运行的底层逻辑，",
      "token_start": 388,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 79730,
      "end_ms": 81230,
      "text": "用反向思维思考问题。",
      "token_start": 399,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 81330,
      "end_ms": 82370,
      "text": "这本书拿到以后，",
      "token_start": 408,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 82370,
      "end_ms": 83310,
      "text": "你不管送给谁，",
      "token_start": 415,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 83450,
      "end_ms": 84635,
      "text": "都会感谢你一辈子。",
      "token_start": 421,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 84930,
      "end_ms": 87185,
      "text": "年轻人现在读少走十年冤枉路，",
      "token_start": 429,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 87480,
      "end_ms": 90035,
      "text": "四十岁以后读可能迎来人生巅峰。",
      "token_start": 442,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 90510,
      "end_ms": 93325,
      "text": "所以不管你是三十岁、四十岁还是五十岁，",
      "token_start": 456,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 93740,
      "end_ms": 94860,
      "text": "这本隐形的契约，",
      "token_start": 473,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 95100,
      "end_ms": 98020,
      "text": "你一定要带回去认真看今天这本书，",
      "token_start": 480,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 98020,
      "end_ms": 99025,
      "text": "我放在左下角了。",
      "token_start": 495,
      "token_end_exclusive": 502
    }
  ],
