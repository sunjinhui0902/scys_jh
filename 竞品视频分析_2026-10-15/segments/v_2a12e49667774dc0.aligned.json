{
  "video_id": "v_2a12e49667774dc0",
  "duration_s": 346.000998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_2a12e49667774dc0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_2a12e49667774dc0.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1170,
      "text": "有一根石头，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1750,
      "end_ms": 3510,
      "text": "保险公司给他投了一个亿，",
      "token_start": 5,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4210,
      "end_ms": 8430,
      "text": "有一池子水科考队蹲在边上看了半个钟头，",
      "token_start": 16,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 9050,
      "end_ms": 9930,
      "text": "没人敢动。",
      "token_start": 34,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 10850,
      "end_ms": 12030,
      "text": "还有一件东西，",
      "token_start": 38,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12910,
      "end_ms": 14970,
      "text": "外国专家飞来看了三趟，",
      "token_start": 44,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 15350,
      "end_ms": 17310,
      "text": "走的时候撂下两个字，",
      "token_start": 54,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 18170,
      "end_ms": 21930,
      "text": "不可能他们全藏在咱们中国的地底下，",
      "token_start": 63,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 22890,
      "end_ms": 23990,
      "text": "九成九的人，",
      "token_start": 79,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 23990,
      "end_ms": 25830,
      "text": "这辈子都不知道他们长什么样。",
      "token_start": 84,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26150,
      "end_ms": 27510,
      "text": "有人说溶洞吗？",
      "token_start": 97,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 27950,
      "end_ms": 30440,
      "text": "不就是钟乳石看一一个，",
      "token_start": 103,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 30440,
      "end_ms": 31660,
      "text": "等于看全部。",
      "token_start": 113,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 32020,
      "end_ms": 34000,
      "text": "我劝您把这话咽回去，",
      "token_start": 118,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 34640,
      "end_ms": 37420,
      "text": "看完今天这五个您再说这句话。",
      "token_start": 127,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 37520,
      "end_ms": 38119,
      "text": "老规矩，",
      "token_start": 140,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 38440,
      "end_ms": 39300,
      "text": "开讲之前，",
      "token_start": 143,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 39300,
      "end_ms": 40400,
      "text": "劳驾您点个赞，",
      "token_start": 147,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 40480,
      "end_ms": 43640,
      "text": "我看看今天都是哪些老朋友在听第十名，",
      "token_start": 153,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 44540,
      "end_ms": 46319,
      "text": "别庆丰都雪鱼洞，",
      "token_start": 170,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 47080,
      "end_ms": 49200,
      "text": "这里的石头正在长个子，",
      "token_start": 177,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 49700,
      "end_ms": 52360,
      "text": "别的溶洞一百年才长一毫米，",
      "token_start": 187,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 53040,
      "end_ms": 55600,
      "text": "他一年就涨零点三三毫米，",
      "token_start": 199,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 56320,
      "end_ms": 57460,
      "text": "快了三十多倍。",
      "token_start": 210,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 58160,
      "end_ms": 62055,
      "text": "洞里的钟乳石只有有三千三百年到一万年，",
      "token_start": 216,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 62780,
      "end_ms": 65175,
      "text": "相当于人类的十三四岁，",
      "token_start": 234,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 65590,
      "end_ms": 66405,
      "text": "是个小姑娘。",
      "token_start": 244,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 67090,
      "end_ms": 69065,
      "text": "可这小姑娘有个怪脾气，",
      "token_start": 249,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 69540,
      "end_ms": 70840,
      "text": "下雨天长得快，",
      "token_start": 259,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 71100,
      "end_ms": 72355,
      "text": "旱季长得慢，",
      "token_start": 265,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 72940,
      "end_ms": 75660,
      "text": "下雨的时候长得比旱季快八成多。",
      "token_start": 270,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 75800,
      "end_ms": 77225,
      "text": "科学家研究了半天，",
      "token_start": 284,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 77490,
      "end_ms": 79025,
      "text": "也没完全弄明白，",
      "token_start": 292,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 79530,
      "end_ms": 82500,
      "text": "更绝得是洞里面温度恒定。",
      "token_start": 299,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 82580,
      "end_ms": 83375,
      "text": "十八度二，",
      "token_start": 310,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 83830,
      "end_ms": 85855,
      "text": "水汽永远是饱和的，",
      "token_start": 314,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 86230,
      "end_ms": 88105,
      "text": "一根四米高的石墩，",
      "token_start": 322,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 88470,
      "end_ms": 90215,
      "text": "一片八米长的石岐，",
      "token_start": 330,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 90770,
      "end_ms": 91890,
      "text": "全世界找不到。",
      "token_start": 338,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 91890,
      "end_ms": 92510,
      "text": "第二处，",
      "token_start": 344,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 92750,
      "end_ms": 94105,
      "text": "您去别处找找，",
      "token_start": 347,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 94400,
      "end_ms": 95875,
      "text": "找不着这么年轻的洞。",
      "token_start": 353,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 96260,
      "end_ms": 96865,
      "text": "第九名，",
      "token_start": 362,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 97390,
      "end_ms": 100190,
      "text": "辽宁本溪水洞三千米，",
      "token_start": 365,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 100190,
      "end_ms": 104035,
      "text": "暗河水清的发蓝游船开进去，",
      "token_start": 374,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 104460,
      "end_ms": 106735,
      "text": "两岸的钟乳师倒挂着往后退，",
      "token_start": 386,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 107050,
      "end_ms": 110060,
      "text": "冷气顺着水面往脸上扑大，",
      "token_start": 398,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 110060,
      "end_ms": 112350,
      "text": "夏天的进去也得裹件外套。",
      "token_start": 409,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 112490,
      "end_ms": 113445,
      "text": "当地老人讲，",
      "token_start": 420,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 114410,
      "end_ms": 117805,
      "text": "这水是从长白山上化下来的雪水。",
      "token_start": 425,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 118370,
      "end_ms": 121740,
      "text": "三伏天捧一口喝那个凉劲儿，",
      "token_start": 439,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 121740,
      "end_ms": 124235,
      "text": "从嗓子眼儿一路窜到脚后跟。",
      "token_start": 451,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 124980,
      "end_ms": 127755,
      "text": "当年地质队进洞勘测的时候，",
      "token_start": 463,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 128170,
      "end_ms": 128970,
      "text": "船开出去，",
      "token_start": 475,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 128970,
      "end_ms": 130465,
      "text": "两千多米还没到头，",
      "token_start": 479,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 130980,
      "end_ms": 133735,
      "text": "队长抬头看着头顶的钟乳石，",
      "token_start": 487,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 134100,
      "end_ms": 134815,
      "text": "说了一句，",
      "token_start": 499,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 135190,
      "end_ms": 136155,
      "text": "这哪是溶洞？",
      "token_start": 503,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 136560,
      "end_ms": 138025,
      "text": "这是地下银河，",
      "token_start": 508,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 138490,
      "end_ms": 140245,
      "text": "这名字就这么叫下来了，",
      "token_start": 514,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 140830,
      "end_ms": 144125,
      "text": "一直叫到今天这水打哪来的？",
      "token_start": 524,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 144400,
      "end_ms": 146425,
      "text": "到今天也没完全弄清楚。",
      "token_start": 536,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 147500,
      "end_ms": 148045,
      "text": "第八名，",
      "token_start": 546,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 149350,
      "end_ms": 156505,
      "text": "湖南郴州万华岩十四米高的绝壁上面藏着一道会变色的瀑布，",
      "token_start": 549,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 157100,
      "end_ms": 157740,
      "text": "科考队，",
      "token_start": 575,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 157920,
      "end_ms": 160835,
      "text": "在洞里发现了一条地下暗河，",
      "token_start": 578,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 161320,
      "end_ms": 162285,
      "text": "好几公里长，",
      "token_start": 590,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 163020,
      "end_ms": 164785,
      "text": "可这水是从哪儿来的，",
      "token_start": 595,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 165380,
      "end_ms": 166745,
      "text": "找了十七年没找着。",
      "token_start": 604,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 167590,
      "end_ms": 170585,
      "text": "后来美国探险队带着攀岩装备来了，",
      "token_start": 612,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 170870,
      "end_ms": 172805,
      "text": "爬上去一看傻了，",
      "token_start": 627,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 173180,
      "end_ms": 174035,
      "text": "里面还有洞，",
      "token_start": 634,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 174310,
      "end_ms": 175085,
      "text": "还有瀑布，",
      "token_start": 639,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 175420,
      "end_ms": 176925,
      "text": "还有更深的暗河。",
      "token_start": 643,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 177760,
      "end_ms": 182065,
      "text": "最后探险队员往水里放了绿色和红色的颜料，",
      "token_start": 650,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 182530,
      "end_ms": 183335,
      "text": "等了两天，",
      "token_start": 669,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 183720,
      "end_ms": 187145,
      "text": "颜料从洞口流出来了才搞清楚，",
      "token_start": 673,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 187660,
      "end_ms": 191580,
      "text": "可至今这条暗河还有一大半没人走，",
      "token_start": 686,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 191580,
      "end_ms": 195815,
      "text": "通过这道瀑布后面到底还有多深，",
      "token_start": 701,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 196650,
      "end_ms": 198050,
      "text": "您自己琢磨琢磨。",
      "token_start": 715,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 198130,
      "end_ms": 198770,
      "text": "第七名，",
      "token_start": 722,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 199010,
      "end_ms": 203030,
      "text": "湖北恩施腾龙洞八百里清江浩浩荡荡，",
      "token_start": 725,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 203030,
      "end_ms": 203830,
      "text": "流到洞口，",
      "token_start": 741,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 203930,
      "end_ms": 205525,
      "text": "突然一头扎进地下，",
      "token_start": 745,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 205820,
      "end_ms": 206465,
      "text": "消失了，",
      "token_start": 753,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 206700,
      "end_ms": 209675,
      "text": "变成了一条十六点八公里长的浮流。",
      "token_start": 756,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 210030,
      "end_ms": 211565,
      "text": "这叫卧龙吞江，",
      "token_start": 771,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 211950,
      "end_ms": 214365,
      "text": "整条江被一个洞吞进去，",
      "token_start": 777,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 214820,
      "end_ms": 218140,
      "text": "全世界找不出第二处可最吓人的地方。",
      "token_start": 787,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 218140,
      "end_ms": 218900,
      "text": "在洞里头，",
      "token_start": 803,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 219160,
      "end_ms": 222670,
      "text": "有一座山叫妖雾闪山洞里，",
      "token_start": 807,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 222670,
      "end_ms": 224130,
      "text": "居然藏着一座山。",
      "token_start": 818,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 224410,
      "end_ms": 225550,
      "text": "阴雨天的时候，",
      "token_start": 825,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 225710,
      "end_ms": 227145,
      "text": "山被雾气笼罩，",
      "token_start": 831,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 227420,
      "end_ms": 228565,
      "text": "跟有妖怪一样。",
      "token_start": 837,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 229030,
      "end_ms": 229970,
      "text": "科学家说了，",
      "token_start": 843,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 230190,
      "end_ms": 232805,
      "text": "这是洞顶塌了石头堆成的，",
      "token_start": 848,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 233750,
      "end_ms": 234795,
      "text": "可老百姓不信，",
      "token_start": 859,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 235210,
      "end_ms": 238430,
      "text": "说这山底下压着龙骨腾龙洞的名字，",
      "token_start": 865,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 238430,
      "end_ms": 239375,
      "text": "就是这么来的。",
      "token_start": 880,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 239880,
      "end_ms": 240700,
      "text": "一条江说，",
      "token_start": 886,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 240700,
      "end_ms": 241360,
      "text": "没就没，",
      "token_start": 890,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 241660,
      "end_ms": 244060,
      "text": "您说这底下得藏着多大的东西。",
      "token_start": 893,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 244700,
      "end_ms": 245380,
      "text": "第六名，",
      "token_start": 906,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 245740,
      "end_ms": 250280,
      "text": "重庆五龙芙蓉洞、珊瑚瑶池面积三十二平方米，",
      "token_start": 909,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 250760,
      "end_ms": 252080,
      "text": "水深八十厘米。",
      "token_start": 928,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 252380,
      "end_ms": 253880,
      "text": "池底分三层，",
      "token_start": 934,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 254280,
      "end_ms": 257520,
      "text": "最上面一层像云雾一样蓬松，",
      "token_start": 939,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 257960,
      "end_ms": 259560,
      "text": "像球现式颗粒，",
      "token_start": 951,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 259680,
      "end_ms": 262420,
      "text": "中间一层像白玉一样薄，",
      "token_start": 957,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 262940,
      "end_ms": 265180,
      "text": "每层只有零点一毫米。",
      "token_start": 967,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 265580,
      "end_ms": 268360,
      "text": "第三层像珊瑚一样伸展开，",
      "token_start": 976,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 268800,
      "end_ms": 270770,
      "text": "全世界找不出第二处。",
      "token_start": 987,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 272130,
      "end_ms": 274010,
      "text": "为什么能长成这样？",
      "token_start": 996,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 274470,
      "end_ms": 275930,
      "text": "科学家研究了半天，",
      "token_start": 1004,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 276110,
      "end_ms": 279630,
      "text": "说是水温差异是镁元素是晶体结构，",
      "token_start": 1012,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 280110,
      "end_ms": 281970,
      "text": "可到底怎么形成的，",
      "token_start": 1027,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 282090,
      "end_ms": 284130,
      "text": "到现在也没一个定论。",
      "token_start": 1035,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 284950,
      "end_ms": 287650,
      "text": "当年最先发现他的那支科考队，",
      "token_start": 1044,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 288150,
      "end_ms": 289750,
      "text": "有个队员后来回忆说，",
      "token_start": 1057,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 290110,
      "end_ms": 291910,
      "text": "手电筒往水面一照，",
      "token_start": 1066,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 292450,
      "end_ms": 294950,
      "text": "整个池子像活了一样在发光。",
      "token_start": 1074,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 295510,
      "end_ms": 298610,
      "text": "全队人蹲在池子边上看了半个多钟头，",
      "token_start": 1086,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 298790,
      "end_ms": 303580,
      "text": "没有一个人能萝布水滴的几百万年才攒出这么一池子头，",
      "token_start": 1102,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 303580,
      "end_ms": 305505,
      "text": "一个看见他的居然是这帮人，",
      "token_start": 1126,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 305880,
      "end_ms": 307325,
      "text": "这运气上哪说理去？",
      "token_start": 1138,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 307780,
      "end_ms": 309205,
      "text": "从第十到第六，",
      "token_start": 1146,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 309690,
      "end_ms": 311595,
      "text": "雪玉洞的石头是个小姑娘，",
      "token_start": 1152,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 312050,
      "end_ms": 314915,
      "text": "本溪水洞飘着一条地下银河，",
      "token_start": 1163,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 315480,
      "end_ms": 317155,
      "text": "万花岩的瀑布会变色，",
      "token_start": 1175,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 317630,
      "end_ms": 319475,
      "text": "腾龙洞吞了一整条江，",
      "token_start": 1184,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 319880,
      "end_ms": 321615,
      "text": "芙蓉洞的池子会发光。",
      "token_start": 1193,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 322200,
      "end_ms": 324580,
      "text": "可这五个还不是秘密最多的。",
      "token_start": 1202,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 324580,
      "end_ms": 326280,
      "text": "接下来第五道第一，",
      "token_start": 1214,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 326400,
      "end_ms": 327485,
      "text": "一个比一个狠，",
      "token_start": 1222,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 327840,
      "end_ms": 329720,
      "text": "有一根石头值一个亿，",
      "token_start": 1228,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 329860,
      "end_ms": 331715,
      "text": "有一片瀑布是石头长的。",
      "token_start": 1237,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 332430,
      "end_ms": 333415,
      "text": "还有一件东西，",
      "token_start": 1247,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 333820,
      "end_ms": 336475,
      "text": "科学家到今天都定不了他的成因，",
      "token_start": 1253,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 337320,
      "end_ms": 338075,
      "text": "他是哪儿，",
      "token_start": 1267,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 338740,
      "end_ms": 342245,
      "text": "他凭什么排第一下集马上更新，",
      "token_start": 1271,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 342690,
      "end_ms": 345885,
      "text": "您先点个关注点开头像别走丢。",
      "token_start": 1284,
      "token_end_exclusive": 1297
    }
  ],
