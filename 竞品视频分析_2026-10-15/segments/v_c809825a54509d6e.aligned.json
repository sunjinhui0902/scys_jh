{
  "video_id": "v_c809825a54509d6e",
  "duration_s": 417.726984,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c809825a54509d6e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c809825a54509d6e.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 2970,
      "text": "一九四九年十月一号下午三点，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3750,
      "end_ms": 6070,
      "text": "天安门广场上锣鼓喧天，",
      "token_start": 13,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 6090,
      "end_ms": 7030,
      "text": "礼炮轰鸣，",
      "token_start": 23,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 7410,
      "end_ms": 10550,
      "text": "全中国都沉浸在胜利的欢呼声中。",
      "token_start": 27,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 11270,
      "end_ms": 13850,
      "text": "几公里外的协和医院产房里，",
      "token_start": 41,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 14350,
      "end_ms": 16770,
      "text": "一位产妇拉着医生的手，",
      "token_start": 53,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 17130,
      "end_ms": 18390,
      "text": "小心翼翼的问，",
      "token_start": 63,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 18730,
      "end_ms": 19410,
      "text": "林大夫，",
      "token_start": 69,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 19650,
      "end_ms": 20550,
      "text": "外面这么热闹，",
      "token_start": 72,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 20550,
      "end_ms": 21930,
      "text": "您不去看看吗？",
      "token_start": 78,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 21930,
      "end_ms": 24090,
      "text": "医生笑着摇摇头，",
      "token_start": 84,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 24090,
      "end_ms": 25330,
      "text": "说出一句，",
      "token_start": 91,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 25330,
      "end_ms": 28330,
      "text": "让在场所有人都记了一辈子的话，",
      "token_start": 95,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 28330,
      "end_ms": 29590,
      "text": "不去了，",
      "token_start": 109,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 29630,
      "end_ms": 33100,
      "text": "就民族的未来都在你们肚子里了。",
      "token_start": 112,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 33580,
      "end_ms": 35740,
      "text": "这位医生就是林巧智。",
      "token_start": 126,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 35960,
      "end_ms": 36400,
      "text": "那天，",
      "token_start": 135,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 36640,
      "end_ms": 40400,
      "text": "他其实收到了一张红底金字的请柬，",
      "token_start": 137,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 41000,
      "end_ms": 43460,
      "text": "开国大典观礼邀请函。",
      "token_start": 152,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 44200,
      "end_ms": 45780,
      "text": "可他把他搁在桌上，",
      "token_start": 161,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 46200,
      "end_ms": 47820,
      "text": "转身进了产房。",
      "token_start": 169,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 48800,
      "end_ms": 49800,
      "text": "在他心里，",
      "token_start": 175,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 50300,
      "end_ms": 56980,
      "text": "产房里每一声啼哭都比天安门城楼上的万道荣光更重要。",
      "token_start": 179,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 57980,
      "end_ms": 58960,
      "text": "有人不理解，",
      "token_start": 203,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 59640,
      "end_ms": 61645,
      "text": "他说是不是不爱这个国家。",
      "token_start": 208,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 62160,
      "end_ms": 65080,
      "text": "您要是知道他这一辈子做过什么，",
      "token_start": 219,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 65400,
      "end_ms": 66885,
      "text": "就不会这么问了。",
      "token_start": 233,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67460,
      "end_ms": 68645,
      "text": "一九三九年，",
      "token_start": 240,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 69050,
      "end_ms": 77925,
      "text": "他在美国芝加哥进修美国顶级医院开出优厚条件留他他说科学可以没有国界，",
      "token_start": 245,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 78360,
      "end_ms": 80805,
      "text": "医生不能没有祖国回国。",
      "token_start": 278,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 81520,
      "end_ms": 83400,
      "text": "一九四九年解放前夕，",
      "token_start": 288,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 83820,
      "end_ms": 89965,
      "text": "傅作义将军的夫人亲自送来一张亲笔签名的飞机票，",
      "token_start": 297,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 90450,
      "end_ms": 92165,
      "text": "拿着他能去任何城市，",
      "token_start": 319,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 92490,
      "end_ms": 94565,
      "text": "多少人用金条都换不来，",
      "token_start": 328,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 95300,
      "end_ms": 96395,
      "text": "他却谢绝了。",
      "token_start": 338,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 96780,
      "end_ms": 98165,
      "text": "我的病人还在这儿，",
      "token_start": 343,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 98320,
      "end_ms": 99255,
      "text": "我哪儿也不去，",
      "token_start": 351,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 100100,
      "end_ms": 101445,
      "text": "他不是不爱国，",
      "token_start": 357,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 101840,
      "end_ms": 104675,
      "text": "他只是把国守在了产房里，",
      "token_start": 363,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 105620,
      "end_ms": 109835,
      "text": "他爱这个国家的证据是一点一点做出来的。",
      "token_start": 374,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 111350,
      "end_ms": 112370,
      "text": "一九零一年，",
      "token_start": 392,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 112450,
      "end_ms": 114155,
      "text": "他出生在厦门鼓浪屿，",
      "token_start": 397,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 114600,
      "end_ms": 116705,
      "text": "五岁丧母励志学医，",
      "token_start": 406,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 117630,
      "end_ms": 119995,
      "text": "一九二一年考进协和医学院，",
      "token_start": 414,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 120390,
      "end_ms": 121710,
      "text": "后来成了新中国。",
      "token_start": 426,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 121730,
      "end_ms": 123225,
      "text": "第一位女院士，",
      "token_start": 433,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 123590,
      "end_ms": 125485,
      "text": "中国妇产科学的奠基人，",
      "token_start": 439,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 126220,
      "end_ms": 128015,
      "text": "他接生了五万多个婴儿，",
      "token_start": 449,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 128360,
      "end_ms": 132985,
      "text": "其中就有袁隆平钟南山见了他都要喊一声姑婆，",
      "token_start": 459,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 133560,
      "end_ms": 134500,
      "text": "可您知道吗？",
      "token_start": 479,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 134600,
      "end_ms": 136015,
      "text": "他做的还不止这些，",
      "token_start": 484,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 136440,
      "end_ms": 140765,
      "text": "他发现光在产房里救人远远不够。",
      "token_start": 492,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 141660,
      "end_ms": 143035,
      "text": "新中国成立前，",
      "token_start": 506,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 143590,
      "end_ms": 147020,
      "text": "我国的婴儿死亡率高达千分之二百。",
      "token_start": 512,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 147160,
      "end_ms": 147865,
      "text": "什么意思？",
      "token_start": 527,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 148690,
      "end_ms": 153705,
      "text": "每出生一千个孩子有两百个活不过周岁，",
      "token_start": 531,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 154530,
      "end_ms": 158275,
      "text": "多少孩子根本等不到见医生一面。",
      "token_start": 548,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 159290,
      "end_ms": 161645,
      "text": "他说过一句特别朴素的话，",
      "token_start": 562,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 162560,
      "end_ms": 165295,
      "text": "医院只是治病的第二道防线。",
      "token_start": 573,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 165790,
      "end_ms": 168185,
      "text": "第一道防线是在预防上。",
      "token_start": 585,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 168660,
      "end_ms": 174705,
      "text": "于是他带着团队在北京开展大规模的妇女宫颈癌普查。",
      "token_start": 595,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 175590,
      "end_ms": 179635,
      "text": "那时候很多农村妇女一辈子没进过医院，",
      "token_start": 618,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 180270,
      "end_ms": 182290,
      "text": "觉得妇科检查不光彩，",
      "token_start": 635,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 182570,
      "end_ms": 183310,
      "text": "躲着不去，",
      "token_start": 644,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 183570,
      "end_ms": 185470,
      "text": "他就挨家挨户的动员，",
      "token_start": 648,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 185510,
      "end_ms": 186970,
      "text": "带着医生们上门。",
      "token_start": 657,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 187850,
      "end_ms": 190310,
      "text": "在他苦口婆心的劝解之下，",
      "token_start": 664,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 191090,
      "end_ms": 193490,
      "text": "几十万名女性走进医院，",
      "token_start": 675,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 194230,
      "end_ms": 196710,
      "text": "他了人生第一次妇科检查，",
      "token_start": 685,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 197650,
      "end_ms": 199230,
      "text": "他怕老百姓听不懂。",
      "token_start": 696,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 199270,
      "end_ms": 205570,
      "text": "医学术语就主编了家庭卫生顾问、农村妇幼卫生常识问答，",
      "token_start": 704,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 206410,
      "end_ms": 213200,
      "text": "用大白话告诉最偏远的山村妇女生孩子不是闯鬼门关，",
      "token_start": 728,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 213960,
      "end_ms": 217100,
      "text": "他接生一般不开刀，",
      "token_start": 751,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 217520,
      "end_ms": 219500,
      "text": "而是努力矫正胎位。",
      "token_start": 759,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 219940,
      "end_ms": 220400,
      "text": "他说，",
      "token_start": 767,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 220820,
      "end_ms": 223080,
      "text": "绝不能出现医生治好了病，",
      "token_start": 769,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 223540,
      "end_ms": 226440,
      "text": "病人却失去了完整生活的情况。",
      "token_start": 780,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 226560,
      "end_ms": 229600,
      "text": "他守产房一守就是半个多世纪。",
      "token_start": 793,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 230200,
      "end_ms": 231340,
      "text": "一九四一年，",
      "token_start": 806,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 231380,
      "end_ms": 232720,
      "text": "太平洋战争爆发，",
      "token_start": 811,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 233160,
      "end_ms": 234440,
      "text": "协和医院关门。",
      "token_start": 818,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 234880,
      "end_ms": 237740,
      "text": "他就在东堂子胡同开小诊所，",
      "token_start": 824,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 238520,
      "end_ms": 239925,
      "text": "穷人没钱治病，",
      "token_start": 836,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 240090,
      "end_ms": 240360,
      "text": "嗯，",
      "token_start": 842,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 240600,
      "end_ms": 242385,
      "text": "还倒贴鸡蛋和红糖。",
      "token_start": 843,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 242810,
      "end_ms": 243770,
      "text": "后来那些年，",
      "token_start": 851,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 243970,
      "end_ms": 245165,
      "text": "他受了委屈，",
      "token_start": 856,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 245510,
      "end_ms": 246865,
      "text": "被伐打扫卫生，",
      "token_start": 861,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 247280,
      "end_ms": 247935,
      "text": "洗便盆，",
      "token_start": 867,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 248400,
      "end_ms": 249515,
      "text": "他也只说一句，",
      "token_start": 870,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 249990,
      "end_ms": 251590,
      "text": "只要还让我留在协和，",
      "token_start": 876,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 251930,
      "end_ms": 253005,
      "text": "干什么都行。",
      "token_start": 885,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 253620,
      "end_ms": 256085,
      "text": "一九八三年四月二十二号，",
      "token_start": 890,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 256570,
      "end_ms": 258265,
      "text": "八十二岁的他走了，",
      "token_start": 901,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 258760,
      "end_ms": 259665,
      "text": "弥留之际，",
      "token_start": 909,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 259930,
      "end_ms": 263580,
      "text": "他断断续续喊的是快快拿产钱来，",
      "token_start": 913,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 263740,
      "end_ms": 266325,
      "text": "这是他留在世间的最后一句话。",
      "token_start": 927,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 267280,
      "end_ms": 271595,
      "text": "林巧志生前留下遗嘱三万元积蓄，",
      "token_start": 940,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 272120,
      "end_ms": 277825,
      "text": "全部捐给幼儿园、托儿所遗体捐给医学院做研究。",
      "token_start": 954,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 278360,
      "end_ms": 281315,
      "text": "骨灰撒回故乡鼓浪屿的海面。",
      "token_start": 974,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 281660,
      "end_ms": 283515,
      "text": "您看他这一辈子，",
      "token_start": 986,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 283880,
      "end_ms": 285505,
      "text": "其实就干了一件事儿，",
      "token_start": 993,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 285850,
      "end_ms": 292125,
      "text": "让中国的孩子平安的来到这个世界上开国大典那天，",
      "token_start": 1002,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 292660,
      "end_ms": 295025,
      "text": "他没能站在天安门城楼上。",
      "token_start": 1024,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 295630,
      "end_ms": 296315,
      "text": "可今天。",
      "token_start": 1035,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 296770,
      "end_ms": 299350,
      "text": "每一个平安出生的中国孩子，",
      "token_start": 1038,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 299650,
      "end_ms": 302710,
      "text": "每一个当了妈妈的中国女人都记得他，",
      "token_start": 1050,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 303190,
      "end_ms": 304190,
      "text": "什么叫爱国？",
      "token_start": 1066,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 304650,
      "end_ms": 306110,
      "text": "爱国不是喊口号，",
      "token_start": 1071,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 306450,
      "end_ms": 308030,
      "text": "是把民族的未来。",
      "token_start": 1078,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 308210,
      "end_ms": 311550,
      "text": "一个个接到人世间民族的未来是谁？",
      "token_start": 1085,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 311950,
      "end_ms": 313110,
      "text": "就是咱们的孩子。",
      "token_start": 1100,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 313910,
      "end_ms": 315390,
      "text": "可孩子总会长大，",
      "token_start": 1107,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 315810,
      "end_ms": 317550,
      "text": "总有一天会问爷爷，",
      "token_start": 1114,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 317790,
      "end_ms": 319870,
      "text": "咱们中国为什么了不起？",
      "token_start": 1122,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 320670,
      "end_ms": 321550,
      "text": "到那时候，",
      "token_start": 1132,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 321970,
      "end_ms": 324790,
      "text": "您指着手里的国之脊梁跟他说，",
      "token_start": 1136,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 325810,
      "end_ms": 328040,
      "text": "因为中我出过这样一群人，",
      "token_start": 1149,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 328480,
      "end_ms": 335060,
      "text": "林巧至钱学森、袁隆平、邓稼先等等四十位院士，",
      "token_start": 1160,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 335260,
      "end_ms": 336600,
      "text": "他们一辈子的故事。",
      "token_start": 1179,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 336700,
      "end_ms": 337800,
      "text": "全在这本书里，",
      "token_start": 1187,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 338220,
      "end_ms": 341100,
      "text": "中科院学不编的有老照片，",
      "token_start": 1193,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 341360,
      "end_ms": 342100,
      "text": "有插画，",
      "token_start": 1204,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 342480,
      "end_ms": 343720,
      "text": "孩子看得进去，",
      "token_start": 1207,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 344240,
      "end_ms": 345580,
      "text": "大子看得心热。",
      "token_start": 1213,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 346040,
      "end_ms": 352040,
      "text": "科学群星耀华夏院士精神代代传说的就是他们，",
      "token_start": 1219,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 352520,
      "end_ms": 355400,
      "text": "您给孩子讲这些不是讲故事，",
      "token_start": 1239,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 355740,
      "end_ms": 358315,
      "text": "是给他心心里种下一颗种子，",
      "token_start": 1251,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 358740,
      "end_ms": 361665,
      "text": "这个国家是靠什么人撑起来的。",
      "token_start": 1263,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 362710,
      "end_ms": 365030,
      "text": "等有一天孩子跟别人说起，",
      "token_start": 1276,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 365050,
      "end_ms": 366875,
      "text": "我爷爷给我讲过林巧智，",
      "token_start": 1287,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 367470,
      "end_ms": 371445,
      "text": "您就明白了什么是真正的爱国教育。",
      "token_start": 1297,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 372340,
      "end_ms": 378140,
      "text": "这本书我不是非让我是觉得他该在攒家书架上，",
      "token_start": 1312,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 378360,
      "end_ms": 379680,
      "text": "有一本不冲，",
      "token_start": 1332,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 379740,
      "end_ms": 380830,
      "text": "别的就冲。",
      "token_start": 1337,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 380870,
      "end_ms": 383180,
      "text": "孩子将来能挺直腰杆，",
      "token_start": 1341,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 383200,
      "end_ms": 383815,
      "text": "说一句，",
      "token_start": 1350,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 384160,
      "end_ms": 387230,
      "text": "咱中国出过这样的人，",
      "token_start": 1353,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 387860,
      "end_ms": 390735,
      "text": "点亮红心收藏这条视频，",
      "token_start": 1362,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 391210,
      "end_ms": 393310,
      "text": "转发给家里当妈的人，",
      "token_start": 1372,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 393310,
      "end_ms": 398195,
      "text": "看看评论区留下一句致敬万英之母，",
      "token_start": 1381,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 398530,
      "end_ms": 404155,
      "text": "让更多人记住这位把一生献给中国母亲和孩子的医生。",
      "token_start": 1396,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 404780,
      "end_ms": 405425,
      "text": "关注我，",
      "token_start": 1419,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 405800,
      "end_ms": 407475,
      "text": "下期讲述最后一个问题，",
      "token_start": 1422,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 408610,
      "end_ms": 411470,
      "text": "如果人民币上要印一位中国女性，",
      "token_start": 1432,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 411690,
      "end_ms": 413065,
      "text": "凭什么是她？",
      "token_start": 1446,
      "token_end_exclusive": 1451
    }
  ],
