{
  "video_id": "v_02cae841d1a72b7c",
  "duration_s": 530.622993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_02cae841d1a72b7c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_02cae841d1a72b7c.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 270,
      "end_ms": 4530,
      "text": "您知道中国历史上最有文人气的名楼都有哪些吗？",
      "token_start": 0,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 4810,
      "end_ms": 5370,
      "text": "上集，",
      "token_start": 21,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5390,
      "end_ms": 13150,
      "text": "咱们聊了甲绣楼、望江楼、太白楼、大观楼、鹳雀楼这集直接揭开谜底，",
      "token_start": 23,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 13810,
      "end_ms": 16910,
      "text": "看看前五名文气身后到了什么程度，",
      "token_start": 50,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 17270,
      "end_ms": 20030,
      "text": "尤其是排在榜首的那座楼，",
      "token_start": 65,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 20770,
      "end_ms": 22670,
      "text": "全国老少全知道，",
      "token_start": 76,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 22930,
      "end_ms": 27210,
      "text": "但给他注入灵魂的那位老祖宗一辈子，",
      "token_start": 83,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 27390,
      "end_ms": 30300,
      "text": "连他的楼梯都没踩过一步。",
      "token_start": 99,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 30620,
      "end_ms": 32140,
      "text": "他隔着几百里地，",
      "token_start": 110,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 32320,
      "end_ms": 35980,
      "text": "就凭手头一张图纸一封老朋友的信，",
      "token_start": 117,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 36500,
      "end_ms": 41780,
      "text": "就让这座楼成了全天下读书人做人做官的一盏明灯。",
      "token_start": 132,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 42240,
      "end_ms": 42920,
      "text": "老规矩，",
      "token_start": 154,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 43180,
      "end_ms": 44040,
      "text": "开讲之前，",
      "token_start": 157,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 44060,
      "end_ms": 46139,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 161,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 46500,
      "end_ms": 47760,
      "text": "让我看看都是谁。",
      "token_start": 171,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 47760,
      "end_ms": 49200,
      "text": "在听第五名，",
      "token_start": 178,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 49680,
      "end_ms": 57640,
      "text": "天星阁、湖南长沙到了前五名历史的沉重感就压上来了。",
      "token_start": 183,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 57940,
      "end_ms": 61845,
      "text": "它是长沙老城墙上无唯一剩下来的制高点，",
      "token_start": 206,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 62660,
      "end_ms": 65555,
      "text": "就坐在老城东南角的高土坡上，",
      "token_start": 224,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 66360,
      "end_ms": 69600,
      "text": "青砖大墙垒的老高三层阁楼，",
      "token_start": 237,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 69600,
      "end_ms": 71945,
      "text": "像大鸟展翅一样立在风里。",
      "token_start": 249,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 72360,
      "end_ms": 73275,
      "text": "早些年间，",
      "token_start": 260,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 73810,
      "end_ms": 78325,
      "text": "这里就是湖南读书人聚在一起谈论天下大事的地方。",
      "token_start": 264,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 79000,
      "end_ms": 81905,
      "text": "名字的意思就是人心顺应天理，",
      "token_start": 286,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 82480,
      "end_ms": 86505,
      "text": "是湖南人讲究真刀真枪干实事的根据地。",
      "token_start": 299,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 86950,
      "end_ms": 88490,
      "text": "结果到了一九三八年，",
      "token_start": 316,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 88490,
      "end_ms": 90005,
      "text": "那场惨烈的大火，",
      "token_start": 325,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 90680,
      "end_ms": 93815,
      "text": "整座长沙老城几乎全给烧平了，",
      "token_start": 332,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 94380,
      "end_ms": 95995,
      "text": "天心阁也没躲过去，",
      "token_start": 345,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 96620,
      "end_ms": 99045,
      "text": "雕花大梁一眨眼全成了灰，",
      "token_start": 353,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 99450,
      "end_ms": 102635,
      "text": "但湖南的老少爷们儿硬是没认输。",
      "token_start": 364,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 103370,
      "end_ms": 107475,
      "text": "咬着牙在烧焦的明代老城墙石基上，",
      "token_start": 378,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 107880,
      "end_ms": 110265,
      "text": "一次次又把它重新立了起来，",
      "token_start": 393,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 110790,
      "end_ms": 113485,
      "text": "城被炸破了楼被烧塌了，",
      "token_start": 405,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 113910,
      "end_ms": 118065,
      "text": "但文人手里的骨气一直牢牢钉在城头上，",
      "token_start": 415,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 118480,
      "end_ms": 121525,
      "text": "您说这是不是最硬气的一抹文人骨气？",
      "token_start": 432,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 122010,
      "end_ms": 122735,
      "text": "第四名，",
      "token_start": 448,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 123110,
      "end_ms": 123730,
      "text": "蓬莱阁，",
      "token_start": 451,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 124030,
      "end_ms": 125095,
      "text": "山东烟台。",
      "token_start": 454,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 125710,
      "end_ms": 128875,
      "text": "如果说别的名楼讲的是在朝廷里做大官，",
      "token_start": 458,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 129480,
      "end_ms": 135085,
      "text": "那这座讲的就是文人骨子里想要放飞的浪漫与洒脱。",
      "token_start": 475,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 135500,
      "end_ms": 138720,
      "text": "他直接趴在黄海边上的大悬崖，",
      "token_start": 497,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 138720,
      "end_ms": 141495,
      "text": "顶上楼阁拔地而起，",
      "token_start": 510,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 142040,
      "end_ms": 144135,
      "text": "脚底下全是悬崖峭壁，",
      "token_start": 518,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 144570,
      "end_ms": 145430,
      "text": "海风一吹，",
      "token_start": 527,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 145450,
      "end_ms": 146345,
      "text": "白雾茫茫，",
      "token_start": 531,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 146730,
      "end_ms": 149315,
      "text": "远远看着就跟飘在海水里一样。",
      "token_start": 535,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 149970,
      "end_ms": 153405,
      "text": "这里历来是老百姓讲八仙过海的地方。",
      "token_start": 548,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 153780,
      "end_ms": 156120,
      "text": "当年大文豪苏东坡到这里，",
      "token_start": 564,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 156120,
      "end_ms": 156520,
      "text": "做官，",
      "token_start": 575,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 156880,
      "end_ms": 159435,
      "text": "在海市蜃楼前头看呆了，",
      "token_start": 577,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 159920,
      "end_ms": 161805,
      "text": "写下了长长的名诗。",
      "token_start": 587,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 162420,
      "end_ms": 163180,
      "text": "几百年来，",
      "token_start": 595,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 163180,
      "end_ms": 167050,
      "text": "不知多少失意的文人跑到这儿面朝大海，",
      "token_start": 599,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 167130,
      "end_ms": 168145,
      "text": "放声大喊，",
      "token_start": 616,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 168550,
      "end_ms": 170355,
      "text": "在石壁上刻满了字。",
      "token_start": 620,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 170780,
      "end_ms": 171240,
      "text": "可文，",
      "token_start": 628,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 171280,
      "end_ms": 172975,
      "text": "人们大老远跑来，",
      "token_start": 630,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 173630,
      "end_ms": 176115,
      "text": "不是真为了上天当神仙，",
      "token_start": 637,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 176740,
      "end_ms": 181245,
      "text": "而是把官场里的窝囊气心里的憋屈，",
      "token_start": 647,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 181790,
      "end_ms": 185055,
      "text": "通通借着狂风巨浪倒进大海里，",
      "token_start": 662,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 185520,
      "end_ms": 187340,
      "text": "在神仙住的地方，",
      "token_start": 675,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 187400,
      "end_ms": 189125,
      "text": "安放人间的失落。",
      "token_start": 682,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 189670,
      "end_ms": 192250,
      "text": "您说这算不算最洒脱的文人？",
      "token_start": 689,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 192250,
      "end_ms": 193835,
      "text": "妻第三名，",
      "token_start": 701,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 194300,
      "end_ms": 195245,
      "text": "黄鹤楼，",
      "token_start": 705,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 195690,
      "end_ms": 196615,
      "text": "湖北武汉，",
      "token_start": 708,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 197360,
      "end_ms": 200215,
      "text": "这是全中国名气最大的楼之一。",
      "token_start": 712,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 200850,
      "end_ms": 203220,
      "text": "但他真正厉害的地方是，",
      "token_start": 725,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 203220,
      "end_ms": 208305,
      "text": "这里成了历代顶尖高手互不服气的一座斗石场。",
      "token_start": 735,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 208730,
      "end_ms": 209930,
      "text": "主楼五十多米，",
      "token_start": 755,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 209930,
      "end_ms": 211210,
      "text": "高五层，",
      "token_start": 761,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 211270,
      "end_ms": 213395,
      "text": "飞檐金碧辉煌，",
      "token_start": 764,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 213820,
      "end_ms": 219255,
      "text": "傲生生立在蛇山顶上眼皮子底下就是滚滚长江。",
      "token_start": 770,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 219830,
      "end_ms": 221045,
      "text": "一千多年里，",
      "token_start": 790,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 221520,
      "end_ms": 225265,
      "text": "文人在上面留下的诗有一千四百多首。",
      "token_start": 795,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 225700,
      "end_ms": 228505,
      "text": "当年唐朝诗人崔颢爬上楼，",
      "token_start": 811,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 228870,
      "end_ms": 231535,
      "text": "一口气写下黄鹤一去不复返，",
      "token_start": 822,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 231920,
      "end_ms": 233555,
      "text": "白云千载空悠悠。",
      "token_start": 834,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 234360,
      "end_ms": 238885,
      "text": "狂的没边的李白兴冲冲跑过来读完这首诗。",
      "token_start": 841,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 239230,
      "end_ms": 240820,
      "text": "站在原地半天，",
      "token_start": 859,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 240820,
      "end_ms": 241705,
      "text": "没说出话，",
      "token_start": 865,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 242170,
      "end_ms": 243325,
      "text": "最后叹了口气，",
      "token_start": 869,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 243740,
      "end_ms": 245245,
      "text": "把毛笔往桌上一撂，",
      "token_start": 875,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 245670,
      "end_ms": 246685,
      "text": "留下两句话。",
      "token_start": 883,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 247490,
      "end_ms": 249645,
      "text": "眼前有景到不得，",
      "token_start": 888,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 250120,
      "end_ms": 253895,
      "text": "崔颢题诗在上头硬是没敢接着写。",
      "token_start": 895,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 254350,
      "end_ms": 255575,
      "text": "直到好多年后，",
      "token_start": 909,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 255980,
      "end_ms": 257905,
      "text": "李白还是咽不下这口气，",
      "token_start": 915,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 258420,
      "end_ms": 262140,
      "text": "又补写了名句来回敬一座楼，",
      "token_start": 925,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 262260,
      "end_ms": 267020,
      "text": "能让全天下最傲气的天才在同一堵墙上较劲。",
      "token_start": 937,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 267300,
      "end_ms": 268055,
      "text": "一千多年。",
      "token_start": 956,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 268700,
      "end_ms": 269645,
      "text": "除了黄鹤楼，",
      "token_start": 960,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 270030,
      "end_ms": 271815,
      "text": "天底下再找不出第二座，",
      "token_start": 965,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 272270,
      "end_ms": 275255,
      "text": "这是什么样的文气与傲气？",
      "token_start": 975,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 275640,
      "end_ms": 276265,
      "text": "第二名，",
      "token_start": 986,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 276620,
      "end_ms": 277300,
      "text": "滕王阁，",
      "token_start": 989,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 277720,
      "end_ms": 280605,
      "text": "江西南昌讲到第二名，",
      "token_start": 992,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 281150,
      "end_ms": 285125,
      "text": "他已经几乎把读书人的才气堆到了顶峰。",
      "token_start": 1001,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 285680,
      "end_ms": 288150,
      "text": "五十七米高九层，",
      "token_start": 1018,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 288230,
      "end_ms": 290155,
      "text": "飞檐气派大的很。",
      "token_start": 1025,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 290870,
      "end_ms": 292850,
      "text": "微微立在赣江边上，",
      "token_start": 1032,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 293270,
      "end_ms": 294830,
      "text": "公元六百七十五年，",
      "token_start": 1040,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 294890,
      "end_ms": 296450,
      "text": "九月初九重阳节，",
      "token_start": 1048,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 296850,
      "end_ms": 298490,
      "text": "严都督在阁子里，",
      "token_start": 1055,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 298490,
      "end_ms": 299910,
      "text": "大摆酒席请客。",
      "token_start": 1062,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 300270,
      "end_ms": 302370,
      "text": "本来想让自己女婿出风头，",
      "token_start": 1068,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 302710,
      "end_ms": 306090,
      "text": "二十出头的穷小子王勃路过这儿，",
      "token_start": 1079,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 306210,
      "end_ms": 308110,
      "text": "提笔写下了滕王阁序。",
      "token_start": 1093,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 308510,
      "end_ms": 310210,
      "text": "落霞与孤鹜齐飞，",
      "token_start": 1102,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 310690,
      "end_ms": 312550,
      "text": "秋水共长天一色，",
      "token_start": 1109,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 313030,
      "end_ms": 316310,
      "text": "字字漂亮的吓勃现场，",
      "token_start": 1116,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 316310,
      "end_ms": 319130,
      "text": "那些当官的和有钱人全看傻了眼。",
      "token_start": 1125,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 319450,
      "end_ms": 321500,
      "text": "可真正让人人心疼的是，",
      "token_start": 1139,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 322040,
      "end_ms": 324540,
      "text": "这藤王阁命运太坎坷了。",
      "token_start": 1149,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 325000,
      "end_ms": 326100,
      "text": "在战火里，",
      "token_start": 1159,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 326140,
      "end_ms": 334120,
      "text": "前前后后被烧塌了二十八次后人硬是咬牙重建了二十九次王勃。",
      "token_start": 1163,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 334160,
      "end_ms": 336400,
      "text": "当年喝酒的那座木头老楼，",
      "token_start": 1190,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 336880,
      "end_ms": 339860,
      "text": "连一粒木头沫子都没能留到今天。",
      "token_start": 1201,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 340400,
      "end_ms": 343440,
      "text": "可哪怕现实里的楼塌了二十八回，",
      "token_start": 1215,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 344040,
      "end_ms": 350835,
      "text": "连一有读书人心里那座金碧辉煌的滕王阁永远高高挂在天边，",
      "token_start": 1229,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 351220,
      "end_ms": 352905,
      "text": "楼塌了二十八次，",
      "token_start": 1255,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 353460,
      "end_ms": 355875,
      "text": "才华却赢了一千四百年。",
      "token_start": 1262,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 356730,
      "end_ms": 359465,
      "text": "这就是滕王阁不可替代的遗纯。",
      "token_start": 1272,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 359880,
      "end_ms": 360460,
      "text": "第一名，",
      "token_start": 1285,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 360700,
      "end_ms": 361340,
      "text": "岳阳楼，",
      "token_start": 1288,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 361640,
      "end_ms": 365240,
      "text": "湖南岳阳为什么是他黄鹤楼？",
      "token_start": 1291,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 365240,
      "end_ms": 366515,
      "text": "有无数的好诗，",
      "token_start": 1303,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 367100,
      "end_ms": 368995,
      "text": "滕王阁有绝顶的文章，",
      "token_start": 1309,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 369460,
      "end_ms": 376275,
      "text": "可只有岳阳楼让一座冰冷的建筑彻底变成了全中国人的精神脊梁。",
      "token_start": 1318,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 376780,
      "end_ms": 378765,
      "text": "他就立在洞庭湖边上，",
      "token_start": 1346,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 379440,
      "end_ms": 382625,
      "text": "全是木头搭起来的三层楼，",
      "token_start": 1355,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 383300,
      "end_ms": 388205,
      "text": "四根通天大柱顶上像扣了个大将军头盔，",
      "token_start": 1366,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 388750,
      "end_ms": 391315,
      "text": "从头到尾每使一根铁钉。",
      "token_start": 1383,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 391720,
      "end_ms": 395675,
      "text": "公元一零四四年滕子京重修岳阳楼，",
      "token_start": 1393,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 396420,
      "end_ms": 399315,
      "text": "给远在河南老家养病的好哥们儿，",
      "token_start": 1408,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 399500,
      "end_ms": 401465,
      "text": "范仲淹寄了一幅画。",
      "token_start": 1422,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 401920,
      "end_ms": 402260,
      "text": "这时候，",
      "token_start": 1430,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 402260,
      "end_ms": 403700,
      "text": "范仲淹刚革新失败，",
      "token_start": 1433,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 403700,
      "end_ms": 404680,
      "text": "被朝廷贬了。",
      "token_start": 1441,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 404680,
      "end_ms": 406210,
      "text": "官一身是病，",
      "token_start": 1446,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 406350,
      "end_ms": 408210,
      "text": "他这辈子压根就没去过岳阳楼，",
      "token_start": 1451,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 408410,
      "end_ms": 409835,
      "text": "也没踩过一级楼梯。",
      "token_start": 1464,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 410260,
      "end_ms": 412020,
      "text": "可他把画纸铺在桌上，",
      "token_start": 1472,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 412720,
      "end_ms": 415140,
      "text": "提笔写下的不是自己的委屈，",
      "token_start": 1481,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 415600,
      "end_ms": 417240,
      "text": "不是官场上的窝囊，",
      "token_start": 1493,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 417640,
      "end_ms": 419440,
      "text": "也不是湖边的美景，",
      "token_start": 1501,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 420040,
      "end_ms": 422920,
      "text": "而是砸在历史骨缝里的十个大字。",
      "token_start": 1509,
      "token_end_exclusive": 1523
    },
    {
      "start_ms": 423680,
      "end_ms": 425480,
      "text": "先天下之忧而忧，",
      "token_start": 1523,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 425880,
      "end_ms": 428060,
      "text": "后天下之乐而乐。",
      "token_start": 1530,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 428720,
      "end_ms": 430880,
      "text": "一座楼打这天起，",
      "token_start": 1537,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 431180,
      "end_ms": 433980,
      "text": "不再只是个看风景的亭台楼阁，",
      "token_start": 1544,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 434580,
      "end_ms": 439140,
      "text": "他成了中国读书人一辈子做人做事的最高标尺。",
      "token_start": 1557,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 439560,
      "end_ms": 442330,
      "text": "别的楼楼比的是词句有多漂亮，",
      "token_start": 1577,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 442870,
      "end_ms": 444310,
      "text": "花样有多好看。",
      "token_start": 1590,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 444970,
      "end_ms": 448790,
      "text": "而岳阳楼比的是文人胸怀天下，",
      "token_start": 1596,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 448930,
      "end_ms": 451730,
      "text": "苍生的骨头到底有多硬？",
      "token_start": 1609,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 452110,
      "end_ms": 454910,
      "text": "十座名楼讲完了太秀楼，",
      "token_start": 1619,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 454990,
      "end_ms": 456690,
      "text": "点亮了贵州的文脉。",
      "token_start": 1629,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 457250,
      "end_ms": 460110,
      "text": "望江楼藏着才女的烈泪，",
      "token_start": 1637,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 460590,
      "end_ms": 463090,
      "text": "太白楼倒满了诗仙的烈酒。",
      "token_start": 1647,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 463450,
      "end_ms": 465970,
      "text": "太观楼看透了百年的历史。",
      "token_start": 1658,
      "token_end_exclusive": 1669
    },
    {
      "start_ms": 466470,
      "end_ms": 468130,
      "text": "鹳雀楼二十个字，",
      "token_start": 1669,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 468210,
      "end_ms": 470480,
      "text": "穿透黄河天金阁，",
      "token_start": 1676,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 470480,
      "end_ms": 473900,
      "text": "在大火焦土里立起硬骨头蓬莱阁，",
      "token_start": 1683,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 473900,
      "end_ms": 475815,
      "text": "把人间心事丢给了大海。",
      "token_start": 1697,
      "token_end_exclusive": 1707
    },
    {
      "start_ms": 476320,
      "end_ms": 480560,
      "text": "黄鹤楼让千百个文豪把笔较劲滕王阁，",
      "token_start": 1707,
      "token_end_exclusive": 1723
    },
    {
      "start_ms": 480560,
      "end_ms": 481940,
      "text": "哪怕踏了二十八回，",
      "token_start": 1723,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 482040,
      "end_ms": 485375,
      "text": "依然才气无双可唯独岳阳楼。",
      "token_start": 1731,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 485830,
      "end_ms": 486690,
      "text": "写他的人，",
      "token_start": 1743,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 486810,
      "end_ms": 488805,
      "text": "一辈子没踏进一步，",
      "token_start": 1747,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 489290,
      "end_ms": 494395,
      "text": "却用一肚子的胸襟重新立起了读书人的灵魂。",
      "token_start": 1755,
      "token_end_exclusive": 1774
    },
    {
      "start_ms": 495020,
      "end_ms": 497495,
      "text": "您说什么叫真正的文人气？",
      "token_start": 1774,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 497930,
      "end_ms": 501910,
      "text": "最顶级的文人气从来不是楼修的，",
      "token_start": 1785,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 501910,
      "end_ms": 503175,
      "text": "有多高有多大，",
      "token_start": 1799,
      "token_end_exclusive": 1805
    },
    {
      "start_ms": 503630,
      "end_ms": 506005,
      "text": "也不是词句堆的有多华丽，",
      "token_start": 1805,
      "token_end_exclusive": 1816
    },
    {
      "start_ms": 506610,
      "end_ms": 509305,
      "text": "而是即便自己被踩在泥坑里，",
      "token_start": 1816,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 509790,
      "end_ms": 514485,
      "text": "心里头想的依然是天下老百姓能不能过上好日子？",
      "token_start": 1828,
      "token_end_exclusive": 1849
    },
    {
      "start_ms": 514940,
      "end_ms": 515925,
      "text": "最后问您一句，",
      "token_start": 1849,
      "token_end_exclusive": 1855
    },
    {
      "start_ms": 516660,
      "end_ms": 519825,
      "text": "这十座名楼您去过哪几座？",
      "token_start": 1855,
      "token_end_exclusive": 1866
    },
    {
      "start_ms": 520360,
      "end_ms": 523725,
      "text": "您心里最有文人气的是哪一座？",
      "token_start": 1866,
      "token_end_exclusive": 1879
    },
    {
      "start_ms": 524300,
      "end_ms": 527265,
      "text": "想听更多名胜古迹背后的故事，",
      "token_start": 1879,
      "token_end_exclusive": 1892
    },
    {
      "start_ms": 527660,
      "end_ms": 528485,
      "text": "点个关注，",
      "token_start": 1892,
      "token_end_exclusive": 1896
    },
    {
      "start_ms": 528790,
      "end_ms": 530335,
      "text": "咱们下期接着聊。",
      "token_start": 1896,
      "token_end_exclusive": 1903
    }
  ],
