{
  "video_id": "v_1c3a47f2eb6e852b",
  "duration_s": 565.137931,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1c3a47f2eb6e852b.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1c3a47f2eb6e852b.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 1650,
      "text": "校门口来了个乞丐，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2010,
      "end_ms": 4350,
      "text": "抱着咸菜坛子死活不撒手，",
      "token_start": 8,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4770,
      "end_ms": 6990,
      "text": "校长一看当场泪崩。",
      "token_start": 19,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 7550,
      "end_ms": 9730,
      "text": "坛子里装的是全中国的命。",
      "token_start": 27,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 10530,
      "end_ms": 11970,
      "text": "一九三七年十月，",
      "token_start": 38,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 11970,
      "end_ms": 14830,
      "text": "长沙衣服大学临时校门口，",
      "token_start": 45,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 15370,
      "end_ms": 18470,
      "text": "门卫拦住了一个要往里闯的乞丐。",
      "token_start": 56,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 18970,
      "end_ms": 20750,
      "text": "这个乞丐蓬头垢面，",
      "token_start": 70,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21190,
      "end_ms": 22070,
      "text": "胡子拉碴，",
      "token_start": 78,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 22410,
      "end_ms": 24050,
      "text": "衣服烂的看不出颜色，",
      "token_start": 82,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 24410,
      "end_ms": 26070,
      "text": "浑身一股馊味儿，",
      "token_start": 91,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 26290,
      "end_ms": 29490,
      "text": "怀里却死死抱着一个破咸菜坛子，",
      "token_start": 98,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 30120,
      "end_ms": 32200,
      "text": "像是抱着什么天大的宝贝。",
      "token_start": 112,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 32640,
      "end_ms": 36460,
      "text": "门卫一边推他一边骂要饭的这是学校，",
      "token_start": 123,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 36640,
      "end_ms": 37580,
      "text": "不是石周棚。",
      "token_start": 139,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38240,
      "end_ms": 39320,
      "text": "乞丐不说话，",
      "token_start": 144,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 39580,
      "end_ms": 40880,
      "text": "拼了命的往里闯。",
      "token_start": 149,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 41540,
      "end_ms": 44600,
      "text": "这时候校长刚好从里面出来，",
      "token_start": 156,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 45060,
      "end_ms": 46800,
      "text": "乞丐猛的挣脱门卫，",
      "token_start": 168,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 47040,
      "end_ms": 48900,
      "text": "一把抓住校长的袖子，",
      "token_start": 176,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 49260,
      "end_ms": 53980,
      "text": "用嘶哑的几乎听不清的声音喊了一声校长，",
      "token_start": 185,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 54460,
      "end_ms": 58800,
      "text": "然后当着所有人的面蹲在地上放声痛哭。",
      "token_start": 203,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 58800,
      "end_ms": 60555,
      "text": "校长立马愣住了，",
      "token_start": 220,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 60880,
      "end_ms": 66700,
      "text": "他仔仔细细看了半天才认出眼前这个叫花子，",
      "token_start": 227,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 66780,
      "end_ms": 69420,
      "text": "竟然是清华大学物理系教授，",
      "token_start": 246,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 69500,
      "end_ms": 71585,
      "text": "中国核物理事业的先驱。",
      "token_start": 258,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 71910,
      "end_ms": 72545,
      "text": "赵忠尧，",
      "token_start": 268,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 72870,
      "end_ms": 74255,
      "text": "一个堂堂大教授，",
      "token_start": 271,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 74630,
      "end_ms": 76225,
      "text": "怎么会变成这副模样？",
      "token_start": 278,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 76750,
      "end_ms": 79365,
      "text": "这是得从他这一生说起。",
      "token_start": 287,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 80370,
      "end_ms": 81325,
      "text": "一九零二年，",
      "token_start": 297,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 81730,
      "end_ms": 86355,
      "text": "赵忠尧出生在浙江诸暨一个医学世家，",
      "token_start": 302,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 86820,
      "end_ms": 89495,
      "text": "父亲是当地有名的大夫，",
      "token_start": 318,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 90070,
      "end_ms": 91185,
      "text": "悬壶济世，",
      "token_start": 328,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 91650,
      "end_ms": 92375,
      "text": "按常理，",
      "token_start": 332,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 92770,
      "end_ms": 94395,
      "text": "他应该子承父业，",
      "token_start": 335,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 94850,
      "end_ms": 96275,
      "text": "做个安稳的医生，",
      "token_start": 342,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 96590,
      "end_ms": 98015,
      "text": "一辈子衣食无忧。",
      "token_start": 349,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 98920,
      "end_ms": 103135,
      "text": "可他偏偏没有那个年代山河破碎，",
      "token_start": 356,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 104070,
      "end_ms": 105750,
      "text": "他想起鲁迅先生那句话，",
      "token_start": 370,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 105890,
      "end_ms": 106310,
      "text": "学医，",
      "token_start": 380,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 106310,
      "end_ms": 107165,
      "text": "救不了中国人，",
      "token_start": 382,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 107500,
      "end_ms": 108375,
      "text": "国家都没了，",
      "token_start": 388,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 108600,
      "end_ms": 109785,
      "text": "哪来的安稳日子？",
      "token_start": 393,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 110270,
      "end_ms": 111415,
      "text": "他放下手术刀，",
      "token_start": 400,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 111710,
      "end_ms": 114335,
      "text": "拿起物理书考进东南大学物理系，",
      "token_start": 406,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 114690,
      "end_ms": 117635,
      "text": "又跟着恩师叶启孙进了清华大学，",
      "token_start": 420,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 118040,
      "end_ms": 119425,
      "text": "当上了物理系教授。",
      "token_start": 434,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 120590,
      "end_ms": 122290,
      "text": "在那个兵荒马乱的年代，",
      "token_start": 442,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 122890,
      "end_ms": 124810,
      "text": "这已经是顶好的日子了。",
      "token_start": 452,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 125570,
      "end_ms": 127870,
      "text": "稳定体面、饿不着。",
      "token_start": 462,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 128670,
      "end_ms": 130490,
      "text": "可赵忠尧偏偏不知足，",
      "token_start": 469,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 131190,
      "end_ms": 133130,
      "text": "他不是嫌日子不够安稳，",
      "token_start": 478,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 133550,
      "end_ms": 135410,
      "text": "他是嫌自己活的太安稳。",
      "token_start": 488,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 136290,
      "end_ms": 140790,
      "text": "那时候中国的物理水平和西方差着十万八千里，",
      "token_start": 498,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 140870,
      "end_ms": 143770,
      "text": "他自掏腰包凑了三年工资，",
      "token_start": 518,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 144110,
      "end_ms": 148030,
      "text": "跑去美国加州理工投到诺贝尔奖得主，",
      "token_start": 529,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 148270,
      "end_ms": 149250,
      "text": "密立根门下，",
      "token_start": 545,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 149250,
      "end_ms": 151580,
      "text": "密立根心疼他，",
      "token_start": 550,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 151920,
      "end_ms": 154160,
      "text": "特意给了他一个轻松的课题，",
      "token_start": 556,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 154780,
      "end_ms": 156560,
      "text": "两年就能拿博士学位，",
      "token_start": 568,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 156740,
      "end_ms": 158400,
      "text": "赵忠尧去主动找上门。",
      "token_start": 577,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 158960,
      "end_ms": 159420,
      "text": "老师，",
      "token_start": 586,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 159780,
      "end_ms": 161580,
      "text": "我想换个更难的题目，",
      "token_start": 588,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 162100,
      "end_ms": 163980,
      "text": "密立根以为他疯了，",
      "token_start": 597,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 164380,
      "end_ms": 165240,
      "text": "他想了想，",
      "token_start": 605,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 165560,
      "end_ms": 168580,
      "text": "索性出了一道公认的难题。",
      "token_start": 609,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 169200,
      "end_ms": 170260,
      "text": "谁也没想到，",
      "token_start": 620,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 170980,
      "end_ms": 173680,
      "text": "这道难题不但没难住赵钟尧，",
      "token_start": 625,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 174040,
      "end_ms": 176840,
      "text": "反而让他做出了一个轰动世界的发现。",
      "token_start": 637,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 177140,
      "end_ms": 178280,
      "text": "一九三零年，",
      "token_start": 653,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 178280,
      "end_ms": 180695,
      "text": "他观测到了一种特殊的符辐射。",
      "token_start": 658,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 181440,
      "end_ms": 181780,
      "text": "后来，",
      "token_start": 671,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 181780,
      "end_ms": 182665,
      "text": "人们才知道，",
      "token_start": 673,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 182950,
      "end_ms": 186225,
      "text": "那是正负电子湮灭时产生的辐射，",
      "token_start": 678,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 186690,
      "end_ms": 192685,
      "text": "这是人类历史上第一次观测到反物质产生和湮灭的现象。",
      "token_start": 692,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 193500,
      "end_ms": 197245,
      "text": "这个发现分量重到足以拿诺贝尔奖。",
      "token_start": 716,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 198190,
      "end_ms": 199495,
      "text": "可是一九三六年，",
      "token_start": 731,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 199820,
      "end_ms": 204845,
      "text": "诺贝尔物理学奖颁给了另一位物理学家安德森，",
      "token_start": 738,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 205760,
      "end_ms": 211500,
      "text": "因为他一九三二年在允始中拍到了正殿子的竞技安德森。",
      "token_start": 758,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 211500,
      "end_ms": 218285,
      "text": "后来亲口承认自己的研究是建立在赵忠尧工作的基础之上的。",
      "token_start": 782,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 219170,
      "end_ms": 220535,
      "text": "末将搬错了人，",
      "token_start": 808,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 221360,
      "end_ms": 224845,
      "text": "这个遗憾成了世界物理学界公认的公案。",
      "token_start": 814,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 225920,
      "end_ms": 229905,
      "text": "前诺贝尔物理学奖委员会主任艾克斯彭后来公开写道，",
      "token_start": 831,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 230400,
      "end_ms": 234675,
      "text": "赵忠尧在世界物理学家心中是实实在在的诺贝尔奖得主，",
      "token_start": 854,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 235660,
      "end_ms": 236935,
      "text": "可赵忠尧在乎吗？",
      "token_start": 878,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 237610,
      "end_ms": 240265,
      "text": "他顾不上一九三一年，",
      "token_start": 885,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 240930,
      "end_ms": 243425,
      "text": "他揣着一身本事回到清华，",
      "token_start": 894,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 243800,
      "end_ms": 250460,
      "text": "从零开始开设了中国第一个核物理课堂建立的中国第一个核物理实验室。",
      "token_start": 905,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 250620,
      "end_ms": 252145,
      "text": "他教出来的学生有谁？",
      "token_start": 936,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 252560,
      "end_ms": 260015,
      "text": "王淦昌钱三强邓稼先朱光亚、赵九章、彭焕、武王、大宠、陈方允两弹一星。",
      "token_start": 945,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 260340,
      "end_ms": 263335,
      "text": "圆勋里有八位出自他的门下，",
      "token_start": 973,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 263820,
      "end_ms": 264825,
      "text": "还有杨振宁，",
      "token_start": 985,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 265220,
      "end_ms": 267725,
      "text": "李政道两位诺贝尔奖得主，",
      "token_start": 990,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 268160,
      "end_ms": 270735,
      "text": "一个人交出了半个中国科学界，",
      "token_start": 1001,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 271170,
      "end_ms": 274645,
      "text": "连他的学生钱伟长都说我的老师赵忠尧，",
      "token_start": 1014,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 275020,
      "end_ms": 276705,
      "text": "才是中国原子能之父。",
      "token_start": 1031,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 277200,
      "end_ms": 278265,
      "text": "一九三七年，",
      "token_start": 1040,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 278630,
      "end_ms": 279605,
      "text": "北平沦陷，",
      "token_start": 1045,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 280400,
      "end_ms": 281860,
      "text": "所有人都往南撤，",
      "token_start": 1049,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 282020,
      "end_ms": 285445,
      "text": "赵忠尧却一个人冒着枪林弹雨折回清华，",
      "token_start": 1056,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 285900,
      "end_ms": 287960,
      "text": "就为了实验室里那五十毫克。",
      "token_start": 1073,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 287960,
      "end_ms": 291105,
      "text": "雷那是研究核能的关键原料，",
      "token_start": 1085,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 291670,
      "end_ms": 294615,
      "text": "是当时全中国仅有的一点家底。",
      "token_start": 1097,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 295380,
      "end_ms": 299725,
      "text": "他把雷庄进特制的铅桶塞进一个咸菜坛子，",
      "token_start": 1110,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 300140,
      "end_ms": 301860,
      "text": "把自己打扮成乞丐，",
      "token_start": 1128,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 302340,
      "end_ms": 304000,
      "text": "混进逃难的人群，",
      "token_start": 1136,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 304360,
      "end_ms": 305655,
      "text": "一路往长沙走。",
      "token_start": 1143,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 306070,
      "end_ms": 308390,
      "text": "一个多月一千四百多公里，",
      "token_start": 1149,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 308830,
      "end_ms": 311450,
      "text": "他昼伏夜行风餐露宿，",
      "token_start": 1160,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 311890,
      "end_ms": 313790,
      "text": "几乎丢掉了所有行李，",
      "token_start": 1169,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 314130,
      "end_ms": 315810,
      "text": "唯独那个咸菜坛子，",
      "token_start": 1178,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 315890,
      "end_ms": 317130,
      "text": "白天抱在怀里。",
      "token_start": 1186,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 317350,
      "end_ms": 318870,
      "text": "晚上搂着睡觉，",
      "token_start": 1192,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 319250,
      "end_ms": 320730,
      "text": "有人问他抱着什么，",
      "token_start": 1198,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 320790,
      "end_ms": 321550,
      "text": "他不说话，",
      "token_start": 1206,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 321870,
      "end_ms": 323590,
      "text": "只是把坛子抱得更紧。",
      "token_start": 1210,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 324110,
      "end_ms": 326350,
      "text": "于是他有了开头那一幕，",
      "token_start": 1219,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 327010,
      "end_ms": 328550,
      "text": "校长听完他的经历，",
      "token_start": 1229,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 329090,
      "end_ms": 330950,
      "text": "看着他怀里那个破坛子，",
      "token_start": 1237,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 331290,
      "end_ms": 332930,
      "text": "眼泪夺眶而出。",
      "token_start": 1247,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 333650,
      "end_ms": 334130,
      "text": "后来，",
      "token_start": 1253,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 334610,
      "end_ms": 337380,
      "text": "正是以这五十万豪克雷为基础，",
      "token_start": 1255,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 338040,
      "end_ms": 340540,
      "text": "中国建立的第一个核物理实验室，",
      "token_start": 1268,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 341220,
      "end_ms": 344920,
      "text": "培养出了一批又一批原子能专家，",
      "token_start": 1282,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 345300,
      "end_ms": 346460,
      "text": "追根溯源，",
      "token_start": 1296,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 347100,
      "end_ms": 352140,
      "text": "两弹一星的种子就藏在这个咸菜坛子里。",
      "token_start": 1300,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 352180,
      "end_ms": 353220,
      "text": "一九四六年，",
      "token_start": 1317,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 353460,
      "end_ms": 356100,
      "text": "美国在太平洋上试爆原子弹，",
      "token_start": 1322,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 356100,
      "end_ms": 358200,
      "text": "赵忠尧受邀观看。",
      "token_start": 1334,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 358200,
      "end_ms": 359920,
      "text": "看着那朵蘑菇云，",
      "token_start": 1341,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 359920,
      "end_ms": 361560,
      "text": "他攥紧了拳头，",
      "token_start": 1348,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 361600,
      "end_ms": 364580,
      "text": "中国什么时候才能有这东西？",
      "token_start": 1354,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 364580,
      "end_ms": 366515,
      "text": "一台加具加速器，",
      "token_start": 1366,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 366870,
      "end_ms": 367725,
      "text": "贵的惊人，",
      "token_start": 1373,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 368190,
      "end_ms": 370875,
      "text": "国家给的经费远远不够怎么办？",
      "token_start": 1377,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 371360,
      "end_ms": 376215,
      "text": "他做了一个让所有人没想到的决定留在美国不走了。",
      "token_start": 1390,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 377690,
      "end_ms": 378795,
      "text": "接下来的四年，",
      "token_start": 1412,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 379360,
      "end_ms": 381935,
      "text": "他跑遍了美国顶尖的实验室，",
      "token_start": 1418,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 382780,
      "end_ms": 384040,
      "text": "白天学技术，",
      "token_start": 1430,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 384280,
      "end_ms": 385585,
      "text": "晚上画图纸，",
      "token_start": 1435,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 386500,
      "end_ms": 387405,
      "text": "核心部件，",
      "token_start": 1440,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 387670,
      "end_ms": 388475,
      "text": "他省着钱，",
      "token_start": 1444,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 388800,
      "end_ms": 389580,
      "text": "秘密定制，",
      "token_start": 1448,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 389620,
      "end_ms": 393135,
      "text": "其余的全部学会准备回国自己造。",
      "token_start": 1452,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 393730,
      "end_ms": 394675,
      "text": "一九五零年，",
      "token_start": 1466,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 394860,
      "end_ms": 401135,
      "text": "他带着几十箱设备零部件登上了威尔逊总统号轮船准备回家，",
      "token_start": 1471,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 402150,
      "end_ms": 403605,
      "text": "可传到日本横滨。",
      "token_start": 1497,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 404080,
      "end_ms": 405260,
      "text": "美军冲上船，",
      "token_start": 1504,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 405560,
      "end_ms": 406565,
      "text": "把他扣了下来，",
      "token_start": 1509,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 407440,
      "end_ms": 408485,
      "text": "关进了监狱。",
      "token_start": 1515,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 409310,
      "end_ms": 411095,
      "text": "他们怀疑他掌握着机密，",
      "token_start": 1520,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 411410,
      "end_ms": 412895,
      "text": "翻来覆去的审讯，",
      "token_start": 1530,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 413710,
      "end_ms": 415475,
      "text": "台湾方面也派人来劝他，",
      "token_start": 1537,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 416200,
      "end_ms": 417145,
      "text": "只要去台湾，",
      "token_start": 1547,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 417650,
      "end_ms": 418665,
      "text": "一切好商量。",
      "token_start": 1552,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 419060,
      "end_ms": 421685,
      "text": "赵忠尧翻来覆去就一句话，",
      "token_start": 1557,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 422170,
      "end_ms": 423085,
      "text": "我要回大陆。",
      "token_start": 1568,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 423520,
      "end_ms": 424800,
      "text": "消息传回国内，",
      "token_start": 1573,
      "token_end_exclusive": 1579
    },
    {
      "start_ms": 424820,
      "end_ms": 430735,
      "text": "中国政府强烈抗议国际科学界也纷纷声援关了两个多月，",
      "token_start": 1579,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 431160,
      "end_ms": 432585,
      "text": "美国顶不住压力，",
      "token_start": 1603,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 432890,
      "end_ms": 433525,
      "text": "只好放人。",
      "token_start": 1610,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 434200,
      "end_ms": 435705,
      "text": "一九五零年十一月，",
      "token_start": 1614,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 436100,
      "end_ms": 438860,
      "text": "赵忠尧终于踏上祖国的途途。",
      "token_start": 1622,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 439550,
      "end_ms": 443945,
      "text": "他把带回来的核心部件全部上交一个零件都没留。",
      "token_start": 1634,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 444840,
      "end_ms": 445615,
      "text": "几年时间，",
      "token_start": 1655,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 445910,
      "end_ms": 450595,
      "text": "他带着团队造出了中国第一台质子静电加速器，",
      "token_start": 1659,
      "token_end_exclusive": 1679
    },
    {
      "start_ms": 451400,
      "end_ms": 455235,
      "text": "后来又建成了二点五兆电子伏的加速器。",
      "token_start": 1679,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 455800,
      "end_ms": 456935,
      "text": "正是有了他，",
      "token_start": 1696,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 457770,
      "end_ms": 462395,
      "text": "中国才一步步拥有了原子弹、氢弹、核潜艇，",
      "token_start": 1701,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 462830,
      "end_ms": 467125,
      "text": "才有了让世界再也不敢小看的两弹一星。",
      "token_start": 1718,
      "token_end_exclusive": 1735
    },
    {
      "start_ms": 468100,
      "end_ms": 470595,
      "text": "可这样一位功勋卓著的老人，",
      "token_start": 1735,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 470960,
      "end_ms": 473165,
      "text": "却在最该出成果的年纪。",
      "token_start": 1747,
      "token_end_exclusive": 1757
    },
    {
      "start_ms": 473910,
      "end_ms": 475705,
      "text": "在一段特殊的岁月里，",
      "token_start": 1757,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 476170,
      "end_ms": 478220,
      "text": "被怀疑被误解，",
      "token_start": 1766,
      "token_end_exclusive": 1772
    },
    {
      "start_ms": 478440,
      "end_ms": 480585,
      "text": "错过了科研的黄金时期，",
      "token_start": 1772,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 480860,
      "end_ms": 481700,
      "text": "他怨过吗？",
      "token_start": 1782,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 481800,
      "end_ms": 483445,
      "text": "没有七十一岁，",
      "token_start": 1786,
      "token_end_exclusive": 1792
    },
    {
      "start_ms": 483910,
      "end_ms": 485815,
      "text": "他重新回到和氏野一线，",
      "token_start": 1792,
      "token_end_exclusive": 1802
    },
    {
      "start_ms": 486130,
      "end_ms": 486765,
      "text": "八十二岁，",
      "token_start": 1802,
      "token_end_exclusive": 1806
    },
    {
      "start_ms": 487160,
      "end_ms": 488995,
      "text": "国家要建高能加速器，",
      "token_start": 1806,
      "token_end_exclusive": 1815
    },
    {
      "start_ms": 489480,
      "end_ms": 491425,
      "text": "他再次披挂上阵，",
      "token_start": 1815,
      "token_end_exclusive": 1822
    },
    {
      "start_ms": 492300,
      "end_ms": 495275,
      "text": "这一干就是十几年。",
      "token_start": 1822,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 496160,
      "end_ms": 497285,
      "text": "一九九八年，",
      "token_start": 1830,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 498360,
      "end_ms": 501160,
      "text": "九十六岁的赵忠尧平静离世，",
      "token_start": 1835,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 501360,
      "end_ms": 503295,
      "text": "他晚年回顾自己的一生，",
      "token_start": 1847,
      "token_end_exclusive": 1857
    },
    {
      "start_ms": 503590,
      "end_ms": 504665,
      "text": "只留下一句话，",
      "token_start": 1857,
      "token_end_exclusive": 1863
    },
    {
      "start_ms": 505190,
      "end_ms": 508285,
      "text": "回想自己的一生经历过许多坎坷，",
      "token_start": 1863,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 508820,
      "end_ms": 513415,
      "text": "唯一希望的就是祖国繁荣昌盛、科学发达。",
      "token_start": 1877,
      "token_end_exclusive": 1894
    },
    {
      "start_ms": 513900,
      "end_ms": 516315,
      "text": "他生前生活极为简朴，",
      "token_start": 1894,
      "token_end_exclusive": 1903
    },
    {
      "start_ms": 516750,
      "end_ms": 518055,
      "text": "从不争名争利。",
      "token_start": 1903,
      "token_end_exclusive": 1909
    },
    {
      "start_ms": 518790,
      "end_ms": 519745,
      "text": "他走的时候，",
      "token_start": 1909,
      "token_end_exclusive": 1914
    },
    {
      "start_ms": 520110,
      "end_ms": 521450,
      "text": "安静的像一滴水，",
      "token_start": 1914,
      "token_end_exclusive": 1921
    },
    {
      "start_ms": 521530,
      "end_ms": 522385,
      "text": "落进大海。",
      "token_start": 1921,
      "token_end_exclusive": 1925
    },
    {
      "start_ms": 523220,
      "end_ms": 524475,
      "text": "他没有诺贝尔奖，",
      "token_start": 1925,
      "token_end_exclusive": 1932
    },
    {
      "start_ms": 524860,
      "end_ms": 526915,
      "text": "没有两弹一星功勋章，",
      "token_start": 1932,
      "token_end_exclusive": 1941
    },
    {
      "start_ms": 527420,
      "end_ms": 530225,
      "text": "连教科书上都很难找到他的名字。",
      "token_start": 1941,
      "token_end_exclusive": 1955
    },
    {
      "start_ms": 531070,
      "end_ms": 534345,
      "text": "可他教出的学生撑起了这个国家的脊梁。",
      "token_start": 1955,
      "token_end_exclusive": 1972
    },
    {
      "start_ms": 535280,
      "end_ms": 537700,
      "text": "如果你也被他的事迹感动，",
      "token_start": 1972,
      "token_end_exclusive": 1983
    },
    {
      "start_ms": 537800,
      "end_ms": 539705,
      "text": "吉利到了可以点个小红心。",
      "token_start": 1983,
      "token_end_exclusive": 1994
    },
    {
      "start_ms": 540250,
      "end_ms": 541610,
      "text": "像他这样的科学家，",
      "token_start": 1994,
      "token_end_exclusive": 2002
    },
    {
      "start_ms": 541810,
      "end_ms": 548165,
      "text": "还有太多太多这本国家脊梁写的就是他们有些名字不该被忘。",
      "token_start": 2002,
      "token_end_exclusive": 2028
    },
    {
      "start_ms": 549070,
      "end_ms": 550225,
      "text": "想想你在工作，",
      "token_start": 2028,
      "token_end_exclusive": 2034
    },
    {
      "start_ms": 550630,
      "end_ms": 552410,
      "text": "生活上遇到过不去的坎，",
      "token_start": 2034,
      "token_end_exclusive": 2044
    },
    {
      "start_ms": 552470,
      "end_ms": 555475,
      "text": "哪可以拿起来翻一翻读一读，",
      "token_start": 2044,
      "token_end_exclusive": 2056
    },
    {
      "start_ms": 555900,
      "end_ms": 559175,
      "text": "看看他们的故事是不是又有努力下去的动力了。",
      "token_start": 2056,
      "token_end_exclusive": 2076
    },
    {
      "start_ms": 559870,
      "end_ms": 562285,
      "text": "这本书就在左下角链接里，",
      "token_start": 2076,
      "token_end_exclusive": 2087
    },
    {
