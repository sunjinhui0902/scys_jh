  "segments": [
    {
      "start_ms": 350,
      "end_ms": 1670,
      "text": "人一旦过了五十啊，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 1670,
      "end_ms": 2670,
      "text": "你一定得服老。",
      "token_start": 8,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 2750,
      "end_ms": 3870,
      "text": "这一点要是不在意，",
      "token_start": 14,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4090,
      "end_ms": 5930,
      "text": "后果真的不堪设想。",
      "token_start": 22,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 6170,
      "end_ms": 7210,
      "text": "很多人年纪大了，",
      "token_start": 30,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 7210,
      "end_ms": 8750,
      "text": "上个楼梯膝盖咔咔响，",
      "token_start": 37,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 8890,
      "end_ms": 11030,
      "text": "跳广场舞跳一会儿就跳不动了，",
      "token_start": 46,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 11210,
      "end_ms": 12590,
      "text": "以为这是正常现象。",
      "token_start": 59,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 12770,
      "end_ms": 14030,
      "text": "以为是年纪纪大，",
      "token_start": 67,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 14090,
      "end_ms": 15590,
      "text": "于是开始喝喝牛奶，",
      "token_start": 74,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 15590,
      "end_ms": 16410,
      "text": "吃钙片，",
      "token_start": 82,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 16410,
      "end_ms": 18870,
      "text": "实际上根本就不到内在其其。",
      "token_start": 85,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 18870,
      "end_ms": 19070,
      "text": "啊，",
      "token_start": 97,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 19070,
      "end_ms": 21470,
      "text": "这是因为缺缺少了一核心的营养养，",
      "token_start": 98,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 21470,
      "end_ms": 22470,
      "text": "就是骨胶原。",
      "token_start": 113,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 22670,
      "end_ms": 25010,
      "text": "骨胶原作为关节节面的重要的营养，",
      "token_start": 118,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 25010,
      "end_ms": 27330,
      "text": "随随着年龄的增长而加速流失，",
      "token_start": 133,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 27690,
      "end_ms": 29610,
      "text": "用的越多流失的越快，",
      "token_start": 146,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 29750,
      "end_ms": 31680,
      "text": "关你还不能自身合成。",
      "token_start": 155,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 31680,
      "end_ms": 32340,
      "text": "这个时候啊，",
      "token_start": 164,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 32340,
      "end_ms": 34900,
      "text": "你喝再多的牛奶骨头汤都没用，",
      "token_start": 169,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 34900,
      "end_ms": 36400,
      "text": "记住了补钙不补，",
      "token_start": 182,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 36400,
      "end_ms": 39180,
      "text": "骨胶原补再多都是浪费钱。",
      "token_start": 189,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 39460,
      "end_ms": 41260,
      "text": "所以啊朋友们人到中年，",
      "token_start": 200,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 41400,
      "end_ms": 43680,
      "text": "咱可千万不要盲目的去补钙思路，",
      "token_start": 210,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 43680,
      "end_ms": 45020,
      "text": "一定要对方法，",
      "token_start": 224,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 45160,
      "end_ms": 46220,
      "text": "也一定要找好。",
      "token_start": 230,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 46400,
      "end_ms": 48920,
      "text": "要知道钙针对的是硬骨骨胶原，",
      "token_start": 236,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 49180,
      "end_ms": 52140,
      "text": "照顾到的是软骨钙和骨胶原的关系啊，",
      "token_start": 249,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 52240,
      "end_ms": 54420,
      "text": "其实就像是钢筋和水泥一样，",
      "token_start": 265,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 54600,
      "end_ms": 57280,
      "text": "只有相互作用才能够牢牢的支撑。",
      "token_start": 277,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 57480,
      "end_ms": 58540,
      "text": "那有人就说了，",
      "token_start": 291,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 58560,
      "end_ms": 60670,
      "text": "这么好的东西是不是很贵？",
      "token_start": 297,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 60910,
      "end_ms": 63470,
      "text": "那么我再说一个颠覆大家认知的事情吧。",
      "token_start": 308,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 63670,
      "end_ms": 65670,
      "text": "其实骨胶原从工厂生产出来，",
      "token_start": 325,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 65850,
      "end_ms": 67390,
      "text": "它的成本并没有那么高。",
      "token_start": 337,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 67530,
      "end_ms": 70790,
      "text": "大家手里两百块钱的骨胶原和二十块钱的骨胶原，",
      "token_start": 347,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 71030,
      "end_ms": 73365,
      "text": "其实成分和含量都差不多。",
      "token_start": 368,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 73680,
      "end_ms": 74780,
      "text": "这些贵的骨胶原啊，",
      "token_start": 379,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 74780,
      "end_ms": 77675,
      "text": "其实都是贵在中间商和品牌溢价上。",
      "token_start": 387,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 78000,
      "end_ms": 81580,
      "text": "你看像我和我的家人一直在用的这一款诺特兰德的骨胶原。",
      "token_start": 402,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 81820,
      "end_ms": 84430,
      "text": "它的每一粒里面含有三百毫克的钙，",
      "token_start": 427,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 84570,
      "end_ms": 85910,
      "text": "一百毫克的骨胶原，",
      "token_start": 442,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 86210,
      "end_ms": 89035,
      "text": "同时添加了维生素d促进钙的吸收。",
      "token_start": 450,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 89320,
      "end_ms": 91240,
      "text": "这一瓶里面有足足的一百二十粒，",
      "token_start": 465,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 91320,
      "end_ms": 92355,
      "text": "够吃两个多月，",
      "token_start": 479,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 92620,
      "end_ms": 93940,
      "text": "现在刚好有优惠活动，",
      "token_start": 485,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 94160,
      "end_ms": 95055,
      "text": "拍二送一，",
      "token_start": 494,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 95400,
      "end_ms": 95800,
      "text": "算下来，",
      "token_start": 498,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 95800,
      "end_ms": 97540,
      "text": "每天也只需要几毛钱，",
      "token_start": 501,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 97800,
      "end_ms": 100040,
      "text": "关键是国货品牌品质有保障，",
      "token_start": 510,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 100200,
      "end_ms": 101940,
      "text": "老人小孩吃起来才放心，",
      "token_start": 522,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 102120,
      "end_ms": 103260,
      "text": "趁现在还没断货啊。",
      "token_start": 532,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 103260,
      "end_ms": 106185,
      "text": "点击视频的左下角千万别错过。",
      "token_start": 540,
