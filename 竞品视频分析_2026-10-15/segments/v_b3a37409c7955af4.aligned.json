{
  "video_id": "v_b3a37409c7955af4",
  "duration_s": 371.147007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b3a37409c7955af4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b3a37409c7955af4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1470,
      "text": "父亲三十三岁，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1750,
      "end_ms": 2970,
      "text": "唱着歌就义，",
      "token_start": 6,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3370,
      "end_ms": 4710,
      "text": "儿子九十六岁，",
      "token_start": 11,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 5010,
      "end_ms": 5850,
      "text": "守着大海，",
      "token_start": 17,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5850,
      "end_ms": 6990,
      "text": "走一门，",
      "token_start": 21,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 7050,
      "end_ms": 8890,
      "text": "两忠恋家。",
      "token_start": 24,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 8890,
      "end_ms": 12490,
      "text": "人们今天这个故事讲的不是一个人，",
      "token_start": 28,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 12730,
      "end_ms": 13750,
      "text": "是两代人。",
      "token_start": 43,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 14230,
      "end_ms": 16790,
      "text": "父亲正值三十三岁，",
      "token_start": 47,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 17250,
      "end_ms": 19910,
      "text": "高唱着国际歌走向刑场，",
      "token_start": 55,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 20310,
      "end_ms": 22850,
      "text": "为的是让老百姓翻身做主人。",
      "token_start": 65,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 23450,
      "end_ms": 25530,
      "text": "儿子四岁成了孤儿，",
      "token_start": 77,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 25590,
      "end_ms": 28350,
      "text": "九十六岁离世前还在念叨，",
      "token_start": 85,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 28790,
      "end_ms": 30420,
      "text": "参数核对好了什么，",
      "token_start": 96,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 30840,
      "end_ms": 33400,
      "text": "为的是让中国挺直腰杆，",
      "token_start": 104,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 34360,
      "end_ms": 37300,
      "text": "父子俩一个倒在黎明前，",
      "token_start": 114,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 38180,
      "end_ms": 39800,
      "text": "一个奋斗了一辈子。",
      "token_start": 124,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 39980,
      "end_ms": 41000,
      "text": "两代人的命，",
      "token_start": 132,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 41360,
      "end_ms": 44060,
      "text": "给新中国筑起了两道屏障。",
      "token_start": 137,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 44880,
      "end_ms": 49260,
      "text": "父亲叫彭湃共产党早期领导人之一。",
      "token_start": 148,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 50020,
      "end_ms": 52680,
      "text": "领导过轰轰烈烈的农民运动，",
      "token_start": 163,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 52940,
      "end_ms": 55420,
      "text": "是老百姓心里的大英雄。",
      "token_start": 175,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 56260,
      "end_ms": 57220,
      "text": "一九二九年，",
      "token_start": 185,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 57420,
      "end_ms": 58660,
      "text": "他在上海被捕，",
      "token_start": 190,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 58960,
      "end_ms": 59800,
      "text": "临行行前，",
      "token_start": 196,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 60280,
      "end_ms": 61480,
      "text": "高唱国际歌，",
      "token_start": 200,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 61700,
      "end_ms": 62785,
      "text": "慷慨赴死。",
      "token_start": 205,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 63580,
      "end_ms": 64175,
      "text": "那一年，",
      "token_start": 209,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 64510,
      "end_ms": 66985,
      "text": "他的小儿子彭士禄才四岁，",
      "token_start": 212,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 67800,
      "end_ms": 72785,
      "text": "四岁的孩子对父母的记忆就剩一张老照片。",
      "token_start": 223,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 73200,
      "end_ms": 73860,
      "text": "照片上，",
      "token_start": 241,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 74080,
      "end_ms": 76915,
      "text": "父亲抱着他亲手写了一行字，",
      "token_start": 244,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 77730,
      "end_ms": 79550,
      "text": "澎湃及他的小乖乖，",
      "token_start": 256,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 79590,
      "end_ms": 80395,
      "text": "多好的字，",
      "token_start": 264,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 80990,
      "end_ms": 82125,
      "text": "多狠的世道。",
      "token_start": 268,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 83280,
      "end_ms": 84735,
      "text": "彭时路三岁那年，",
      "token_start": 273,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 85150,
      "end_ms": 87495,
      "text": "母亲蔡素萍被捕就医，",
      "token_start": 280,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 88310,
      "end_ms": 89055,
      "text": "一夜之间，",
      "token_start": 289,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 89870,
      "end_ms": 91775,
      "text": "他没了爹没了妈，",
      "token_start": 293,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 92230,
      "end_ms": 93505,
      "text": "还成了敌人妖。",
      "token_start": 300,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 93810,
      "end_ms": 99995,
      "text": "斩草除根的目标是海丰的老百姓硬拿命护住了这个孩子。",
      "token_start": 306,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 100950,
      "end_ms": 102715,
      "text": "东家给塞一口红薯，",
      "token_start": 330,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 103080,
      "end_ms": 105265,
      "text": "西家给补一件旧衣，",
      "token_start": 338,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 105650,
      "end_ms": 108035,
      "text": "二十多户人家轮流藏他。",
      "token_start": 346,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 109520,
      "end_ms": 110405,
      "text": "八岁那年，",
      "token_start": 356,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 110860,
      "end_ms": 113165,
      "text": "他还是被抓进了监狱，",
      "token_start": 360,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 113500,
      "end_ms": 114460,
      "text": "被吊起来打，",
      "token_start": 369,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 114580,
      "end_ms": 115365,
      "text": "被折磨，",
      "token_start": 374,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 115780,
      "end_ms": 117360,
      "text": "双腿烂得站不起来。",
      "token_start": 377,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 117640,
      "end_ms": 118620,
      "text": "十岁出狱，",
      "token_start": 385,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 118640,
      "end_ms": 121095,
      "text": "他沿着铁路爬了十几公里，",
      "token_start": 389,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 121540,
      "end_ms": 123965,
      "text": "膝盖磨的血肉模糊，",
      "token_start": 400,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 124580,
      "end_ms": 125945,
      "text": "才爬回养母家。",
      "token_start": 408,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 126800,
      "end_ms": 128135,
      "text": "一个烈士的孩子，",
      "token_start": 414,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 128470,
      "end_ms": 130095,
      "text": "本该在父母怀里长大，",
      "token_start": 421,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 130510,
      "end_ms": 133425,
      "text": "却把童年活成了刀尖上的行走。",
      "token_start": 430,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 134240,
      "end_ms": 135165,
      "text": "一九四零年，",
      "token_start": 443,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 135470,
      "end_ms": 137855,
      "text": "周恩来总理派人辗转找到他，",
      "token_start": 448,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 138330,
      "end_ms": 139345,
      "text": "握着他的手说，",
      "token_start": 460,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 140230,
      "end_ms": 143145,
      "text": "孩子终于找到你了。",
      "token_start": 466,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 144350,
      "end_ms": 147555,
      "text": "十五岁的彭适路被送到延安，",
      "token_start": 474,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 148450,
      "end_ms": 149515,
      "text": "这才算有了家。",
      "token_start": 486,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 150180,
      "end_ms": 152325,
      "text": "后来他考取留宿资格，",
      "token_start": 492,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 152660,
      "end_ms": 154225,
      "text": "去苏联学化工。",
      "token_start": 501,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 155200,
      "end_ms": 158480,
      "text": "一九五六年陈赓大将问他，",
      "token_start": 507,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 158480,
      "end_ms": 159885,
      "text": "国家要搞核动力，",
      "token_start": 518,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 160410,
      "end_ms": 161470,
      "text": "需要你改行，",
      "token_start": 525,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 161790,
      "end_ms": 162625,
      "text": "你愿意吗？",
      "token_start": 530,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 163440,
      "end_ms": 163985,
      "text": "他说，",
      "token_start": 534,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 164730,
      "end_ms": 166545,
      "text": "只要祖国需要我，",
      "token_start": 536,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 166940,
      "end_ms": 168365,
      "text": "我愿意贡献一切。",
      "token_start": 543,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 168870,
      "end_ms": 169425,
      "text": "从此，",
      "token_start": 550,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 169720,
      "end_ms": 170880,
      "text": "他像父亲一样，",
      "token_start": 552,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 170940,
      "end_ms": 173245,
      "text": "把一切都献给了国家，",
      "token_start": 558,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 173770,
      "end_ms": 175135,
      "text": "只是换了一种方式。",
      "token_start": 567,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 175650,
      "end_ms": 178530,
      "text": "父亲轰轰烈烈走向历史舞台。",
      "token_start": 575,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 178530,
      "end_ms": 178925,
      "text": "中央，",
      "token_start": 587,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 179810,
      "end_ms": 181995,
      "text": "他悄无声息的深浅，",
      "token_start": 589,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 182860,
      "end_ms": 184515,
      "text": "一切就是三十年。",
      "token_start": 597,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 185120,
      "end_ms": 186675,
      "text": "在四川的深山里，",
      "token_start": 604,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 187050,
      "end_ms": 194515,
      "text": "他带着几百号人用算盘和计算尺算出了十几万个核动力数据。",
      "token_start": 611,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 195340,
      "end_ms": 198875,
      "text": "一九七零年八月三十日反应堆达到满功率，",
      "token_start": 637,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 199300,
      "end_ms": 200995,
      "text": "他五天五夜没合眼。",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 201420,
      "end_ms": 202635,
      "text": "同年十二月，",
      "token_start": 663,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 202990,
      "end_ms": 205135,
      "text": "中国第一艘核潜艇下水，",
      "token_start": 668,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 205580,
      "end_ms": 209765,
      "text": "中国成了世界上第五个拥有核潜艇的国家。",
      "token_start": 678,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 210380,
      "end_ms": 211275,
      "text": "一九七四年，",
      "token_start": 696,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 211560,
      "end_ms": 212585,
      "text": "他未穿孔，",
      "token_start": 701,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 213060,
      "end_ms": 214795,
      "text": "未被切除了四分之三，",
      "token_start": 705,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 215340,
      "end_ms": 216895,
      "text": "可核潜艇搞成了，",
      "token_start": 714,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 217130,
      "end_ms": 219325,
      "text": "他又转身去搞核电站。",
      "token_start": 721,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 219710,
      "end_ms": 223725,
      "text": "大亚湾秦山、中国核电从无到有，",
      "token_start": 730,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 224320,
      "end_ms": 225745,
      "text": "都踩着他的脚印。",
      "token_start": 743,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 226680,
      "end_ms": 227685,
      "text": "二零一七年，",
      "token_start": 750,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 228510,
      "end_ms": 232675,
      "text": "九十二岁的他拿到一百万港币的科技大奖，",
      "token_start": 755,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 233630,
      "end_ms": 237055,
      "text": "一分不留全捐给国家培养年轻人。",
      "token_start": 773,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 237280,
      "end_ms": 238735,
      "text": "女儿还劝他留点儿，",
      "token_start": 787,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 239620,
      "end_ms": 240185,
      "text": "他说，",
      "token_start": 795,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 241070,
      "end_ms": 242205,
      "text": "这钱是国家的，",
      "token_start": 797,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 243190,
      "end_ms": 244355,
      "text": "我一分都不能动。",
      "token_start": 803,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 245450,
      "end_ms": 246905,
      "text": "二零二一年三月，",
      "token_start": 810,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 247390,
      "end_ms": 250355,
      "text": "九十六岁的彭时路在北京逝世。",
      "token_start": 817,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 251330,
      "end_ms": 252165,
      "text": "临终前，",
      "token_start": 830,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 252920,
      "end_ms": 256045,
      "text": "他还在念叨参数核对好了吗？",
      "token_start": 833,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 256550,
      "end_ms": 260205,
      "text": "他的骨灰按照遗愿洒进了大海，",
      "token_start": 845,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 260910,
      "end_ms": 262365,
      "text": "他要陪着核潜艇，",
      "token_start": 858,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 262720,
      "end_ms": 263765,
      "text": "守着这片海。",
      "token_start": 865,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 264870,
      "end_ms": 265345,
      "text": "家人们，",
      "token_start": 870,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 265870,
      "end_ms": 267745,
      "text": "你品品这两代人，",
      "token_start": 873,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 268230,
      "end_ms": 269505,
      "text": "父亲澎湃，",
      "token_start": 880,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 269990,
      "end_ms": 271565,
      "text": "三十三岁就义，",
      "token_start": 884,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 272010,
      "end_ms": 273645,
      "text": "为的是老百姓的解放。",
      "token_start": 890,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 274130,
      "end_ms": 275105,
      "text": "儿子彭世路，",
      "token_start": 899,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 275670,
      "end_ms": 276930,
      "text": "九十六岁离世，",
      "token_start": 904,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 277090,
      "end_ms": 279940,
      "text": "为的是祖国的强盛一门。",
      "token_start": 910,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 280120,
      "end_ms": 282595,
      "text": "两忠列两代报国心，",
      "token_start": 920,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 283580,
      "end_ms": 287025,
      "text": "父亲那一辈用热血换来了新中国。",
      "token_start": 928,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 287530,
      "end_ms": 288010,
      "text": "儿子。",
      "token_start": 942,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 288010,
      "end_ms": 291965,
      "text": "这一辈用一辈子守住了新中国的安宁。",
      "token_start": 944,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 292710,
      "end_ms": 295335,
      "text": "今天我们能安安稳稳过日子，",
      "token_start": 960,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 295700,
      "end_ms": 296960,
      "text": "能挺直腰杆，",
      "token_start": 972,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 296980,
      "end_ms": 299800,
      "text": "说话背后就是彭老这样的。",
      "token_start": 977,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 300470,
      "end_ms": 304465,
      "text": "用隐姓埋名的一辈子给我们撑起了保护伞。",
      "token_start": 988,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 305160,
      "end_ms": 306620,
      "text": "彭时录生前常说，",
      "token_start": 1006,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 307120,
      "end_ms": 310340,
      "text": "我这辈子顶多算一颗螺丝钉，",
      "token_start": 1013,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 310900,
      "end_ms": 313020,
      "text": "可正是这一颗颗螺丝钉，",
      "token_start": 1025,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 313480,
      "end_ms": 315300,
      "text": "拧出了中国的核潜艇，",
      "token_start": 1035,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 315440,
      "end_ms": 317100,
      "text": "拧出了中国的核电站，",
      "token_start": 1044,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 317540,
      "end_ms": 319480,
      "text": "拧出了咱们今天的底气。",
      "token_start": 1053,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 320400,
      "end_ms": 321040,
      "text": "有人说，",
      "token_start": 1063,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 321840,
      "end_ms": 323740,
      "text": "英雄都活在书里。",
      "token_start": 1066,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 324380,
      "end_ms": 328820,
      "text": "电影里家人们彭家父子俩告诉你，",
      "token_start": 1073,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 330260,
      "end_ms": 333860,
      "text": "英雄就活在我们身边，",
      "token_start": 1087,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 334400,
      "end_ms": 336510,
      "text": "活在这片土地里，",
      "token_start": 1096,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 336510,
      "end_ms": 342090,
      "text": "觉得这个家族了不起的评论区打两代报国四个字，",
      "token_start": 1103,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 342150,
      "end_ms": 342570,
      "text": "致敬。",
      "token_start": 1124,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 342570,
      "end_ms": 349850,
      "text": "这对父子致敬所有为国家默默付出的人像彭老这样的故事，",
      "token_start": 1126,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 349890,
      "end_ms": 350850,
      "text": "国之吉梁。",
      "token_start": 1151,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 350850,
      "end_ms": 353250,
      "text": "这本书里还有四十位，",
      "token_start": 1155,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 353250,
      "end_ms": 355790,
      "text": "喜欢的朋友可以直接拍链接。",
      "token_start": 1164,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 355790,
      "end_ms": 357770,
      "text": "我放在视频左下角了，",
      "token_start": 1176,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 357770,
      "end_ms": 359490,
      "text": "没事的时候翻一翻，",
      "token_start": 1185,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 359490,
      "end_ms": 362010,
      "text": "遇到心里过不去的时候也看一看，",
      "token_start": 1193,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 362010,
      "end_ms": 363810,
      "text": "是不是也就过得去了。",
      "token_start": 1207,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 363810,
      "end_ms": 364530,
      "text": "关注我，",
      "token_start": 1216,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 364530,
      "end_ms": 369680,
      "text": "把帮你拆解历史名人背后的故事、厚重乏味的历史经我的讲解，",
      "token_start": 1219,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 369700,
      "end_ms": 370965,
      "text": "让你耳目一新。",
      "token_start": 1245,
      "token_end_exclusive": 1251
    }
  ],
