      "token_end_exclusive": 56
    },
    {
      "start_ms": 15250,
      "end_ms": 16550,
      "text": "照样活得快乐，",
      "token_start": 56,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 16850,
      "end_ms": 18710,
      "text": "做到精神独立。",
      "token_start": 62,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 19490,
      "end_ms": 22850,
      "text": "养育孩子其实不是牢牢的把他们拴在我们身边，",
      "token_start": 68,
      "token_end_exclusive": 88
