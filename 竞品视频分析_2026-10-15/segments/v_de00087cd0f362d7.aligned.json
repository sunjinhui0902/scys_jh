{
  "video_id": "v_de00087cd0f362d7",
  "duration_s": 513.88,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_de00087cd0f362d7.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_de00087cd0f362d7.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 2790,
      "text": "那颗乳牙他揣了一辈子，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2890,
      "end_ms": 4230,
      "text": "各位今儿个这个故事，",
      "token_start": 10,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4970,
      "end_ms": 5990,
      "text": "我不跟你掰扯，",
      "token_start": 19,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 5990,
      "end_ms": 9970,
      "text": "那些数据也不讲那些惊天动地的场面，",
      "token_start": 25,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 11110,
      "end_ms": 16309,
      "text": "我就想跟你唠一颗乳牙和一个孩子没能等到的心愿。",
      "token_start": 41,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 17090,
      "end_ms": 23790,
      "text": "因为啊就是这么一颗小牙悄悄改写了好几亿人的命，",
      "token_start": 63,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 25010,
      "end_ms": 29185,
      "text": "故事的主角叫顾方舟。",
      "token_start": 85,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 30360,
      "end_ms": 31520,
      "text": "不过在说他之前，",
      "token_start": 94,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 32200,
      "end_ms": 35540,
      "text": "我想先让你认认一个叫阿楚的小娃。",
      "token_start": 101,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 36100,
      "end_ms": 37340,
      "text": "那是五十年代末，",
      "token_start": 116,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 37620,
      "end_ms": 39620,
      "text": "南方一家医院里头顾方舟，",
      "token_start": 123,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 39620,
      "end_ms": 42780,
      "text": "为了摸清一种阳明脊髓灰质炎，",
      "token_start": 134,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 43380,
      "end_ms": 46300,
      "text": "老百姓叫小儿麻痹症的病的底细，",
      "token_start": 147,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 47140,
      "end_ms": 48640,
      "text": "正到处搜罗资料。",
      "token_start": 161,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 49280,
      "end_ms": 51400,
      "text": "他背上包刚要抬腿，",
      "token_start": 168,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 51420,
      "end_ms": 51640,
      "text": "走，",
      "token_start": 176,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 51640,
      "end_ms": 54200,
      "text": "人一个脸都蜡黄了的汉子，",
      "token_start": 177,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 54640,
      "end_ms": 55580,
      "text": "一把薅住了。",
      "token_start": 188,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 55580,
      "end_ms": 56180,
      "text": "他同志，",
      "token_start": 193,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 56480,
      "end_ms": 58340,
      "text": "求求您哪救救我娃吧。",
      "token_start": 196,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 59520,
      "end_ms": 60665,
      "text": "顾方舟愣了下，",
      "token_start": 205,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 61520,
      "end_ms": 62105,
      "text": "大哥，",
      "token_start": 211,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 62920,
      "end_ms": 64385,
      "text": "您是不是认错人了？",
      "token_start": 213,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 65630,
      "end_ms": 67255,
      "text": "我不是看病的大夫，",
      "token_start": 221,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 68510,
      "end_ms": 70335,
      "text": "我是捣鼓病毒的。",
      "token_start": 229,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 70990,
      "end_ms": 71370,
      "text": "没错，",
      "token_start": 236,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 71370,
      "end_ms": 71770,
      "text": "没错，",
      "token_start": 238,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 71930,
      "end_ms": 74440,
      "text": "您就是搞这行的那您准有辙，",
      "token_start": 240,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 74660,
      "end_ms": 75440,
      "text": "您行行好，",
      "token_start": 252,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 75540,
      "end_ms": 80730,
      "text": "瞅瞅我娃顾方舟就这么被拽到了一个男孩的床前，",
      "token_start": 256,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 80730,
      "end_ms": 87960,
      "text": "那幅画面他记了一辈子一个本该在日头底下撒欢的半大娃两条腿，",
      "token_start": 277,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 88040,
      "end_ms": 90455,
      "text": "蜷着拧着变的形，",
      "token_start": 305,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 90860,
      "end_ms": 93395,
      "text": "硬生生被拴在了这张床上。",
      "token_start": 312,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 93790,
      "end_ms": 95590,
      "text": "他叫阿楚得的，",
      "token_start": 323,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 95590,
      "end_ms": 98830,
      "text": "正是那种专捡小娃娃欺负的病，",
      "token_start": 329,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 98870,
      "end_ms": 102895,
      "text": "轻的跛一辈子重的连口气都喘不利索。",
      "token_start": 342,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 103460,
      "end_ms": 104865,
      "text": "顾方舟鼻子一酸，",
      "token_start": 358,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 105230,
      "end_ms": 106370,
      "text": "亲口像被杀，",
      "token_start": 365,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 106470,
      "end_ms": 107775,
      "text": "狠狠攥了一吧。",
      "token_start": 370,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 108280,
      "end_ms": 111425,
      "text": "他蹲下去声音放的软软的。",
      "token_start": 376,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 111550,
      "end_ms": 112005,
      "text": "阿楚，",
      "token_start": 387,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 112380,
      "end_ms": 113905,
      "text": "你长大了想做个啥呀？",
      "token_start": 389,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 114670,
      "end_ms": 116370,
      "text": "娃的眼睛先亮了一下，",
      "token_start": 398,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 116550,
      "end_ms": 117485,
      "text": "又暗下去，",
      "token_start": 407,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 117990,
      "end_ms": 118825,
      "text": "小声嘟囔。",
      "token_start": 411,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 119720,
      "end_ms": 122055,
      "text": "我原先想当解放军，",
      "token_start": 415,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 122400,
      "end_ms": 124325,
      "text": "可现在我想当大夫，",
      "token_start": 423,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 125250,
      "end_ms": 128605,
      "text": "我想把小朋友们得的病一个个都治好，",
      "token_start": 431,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 128970,
      "end_ms": 133555,
      "text": "我还盼着往后头的小娃再也不用摊上这病了。",
      "token_start": 447,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 134210,
      "end_ms": 134765,
      "text": "说完，",
      "token_start": 466,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 135140,
      "end_ms": 137160,
      "text": "他小心翼翼打枕头底下，",
      "token_start": 468,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 137160,
      "end_ms": 139560,
      "text": "摸出一个东西塞进顾方舟，",
      "token_start": 478,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 139560,
      "end_ms": 141115,
      "text": "手心是一颗小小的，",
      "token_start": 489,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 141730,
      "end_ms": 146330,
      "text": "还带着他体温的乳牙牙。",
      "token_start": 497,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 146330,
      "end_ms": 151210,
      "text": "婆婆能替人圆梦的大伙听听，",
      "token_start": 507,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 151290,
      "end_ms": 152450,
      "text": "就在那一刹那，",
      "token_start": 519,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 152470,
      "end_ms": 158750,
      "text": "一个孩子的天真烂漫撞上了一个科学家的天梁顾方舟，",
      "token_start": 525,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 158810,
      "end_ms": 160055,
      "text": "攥紧那颗小牙，",
      "token_start": 548,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 160570,
      "end_ms": 162045,
      "text": "眼泪差点没绷住，",
      "token_start": 554,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 163040,
      "end_ms": 164195,
      "text": "这哪是颗牙啊。",
      "token_start": 561,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 164610,
      "end_ms": 168505,
      "text": "这分明是一个孩子对好好活一场的全部念想，",
      "token_start": 567,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 169130,
      "end_ms": 173875,
      "text": "是一个家在绝路上死死抓住的最后一根稻草。",
      "token_start": 586,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 174790,
      "end_ms": 176245,
      "text": "他跟自己较上了劲，",
      "token_start": 605,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 178340,
      "end_ms": 180315,
      "text": "我记下来这档子事儿，",
      "token_start": 613,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 180700,
      "end_ms": 181625,
      "text": "我管定了。",
      "token_start": 622,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 182660,
      "end_ms": 183895,
      "text": "后来外头都说，",
      "token_start": 626,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 184780,
      "end_ms": 187925,
      "text": "顾方舟捣鼓出糖丸是为了论文，",
      "token_start": 632,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 188270,
      "end_ms": 189830,
      "text": "是为了上头的任务。",
      "token_start": 645,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 189990,
      "end_ms": 191790,
      "text": "可只有他自己心里透亮，",
      "token_start": 653,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 191810,
      "end_ms": 194830,
      "text": "最开头那簇火苗是打一个陌生娃，",
      "token_start": 663,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 194850,
      "end_ms": 200665,
      "text": "手里接过来这颗小小的牙和那句听着就飘渺的心愿。",
      "token_start": 677,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 201520,
      "end_ms": 202675,
      "text": "揣着这句承诺，",
      "token_start": 699,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 203160,
      "end_ms": 206875,
      "text": "顾方舟一头扎进了疫苗研发那不见底的深渊。",
      "token_start": 705,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 207460,
      "end_ms": 211190,
      "text": "那会儿的中国是个啥家底像样的实验室，",
      "token_start": 724,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 211250,
      "end_ms": 215280,
      "text": "每一间做实验的猴子寻不着垫不稳钱，",
      "token_start": 741,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 215360,
      "end_ms": 216820,
      "text": "更没有这病。",
      "token_start": 757,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 216940,
      "end_ms": 219295,
      "text": "一年祸害成千上万的娃，",
      "token_start": 762,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 219640,
      "end_ms": 220905,
      "text": "上头急得直跺脚。",
      "token_start": 772,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 221400,
      "end_ms": 223210,
      "text": "眼前的道有两条，",
      "token_start": 779,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 223410,
      "end_ms": 227040,
      "text": "一条是美国的死疫苗稳当可疑，",
      "token_start": 786,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 227040,
      "end_ms": 228595,
      "text": "真十块美金。",
      "token_start": 799,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 229110,
      "end_ms": 230905,
      "text": "这病还分好几个型号，",
      "token_start": 804,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 231760,
      "end_ms": 233000,
      "text": "得连着挨好几针。",
      "token_start": 813,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 233000,
      "end_ms": 233500,
      "text": "那年月，",
      "token_start": 820,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 233500,
      "end_ms": 235775,
      "text": "一个普通人一个月就挣几十块钱，",
      "token_start": 823,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 236260,
      "end_ms": 239275,
      "text": "谁吃的消全国也覆盖不过来。",
      "token_start": 837,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 239750,
      "end_ms": 243100,
      "text": "另一条是活疫苗便宜，",
      "token_start": 849,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 243160,
      "end_ms": 243840,
      "text": "顶多死，",
      "token_start": 858,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 243840,
      "end_ms": 246455,
      "text": "疫苗的千分之一还能兑水喝。",
      "token_start": 861,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 247180,
      "end_ms": 253755,
      "text": "可全世界没一个敢拍胸脯说他保险顾方舟把牙一咬走活疫苗这条道，",
      "token_start": 873,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 254600,
      "end_ms": 255960,
      "text": "因为他答应过阿楚，",
      "token_start": 902,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 256120,
      "end_ms": 258615,
      "text": "要让往后的娃再别摊上这病。",
      "token_start": 910,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 258990,
      "end_ms": 259895,
      "text": "为了做实验，",
      "token_start": 922,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 260290,
      "end_ms": 264045,
      "text": "他带着队伍猫进了昆明大山深处的山洞，",
      "token_start": 927,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 264540,
      "end_ms": 265485,
      "text": "没水没电，",
      "token_start": 944,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 265940,
      "end_ms": 269215,
      "text": "做实验的料子得徒步十几公里扛上山。",
      "token_start": 948,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 269930,
      "end_ms": 275245,
      "text": "他索性把亲娘媳妇刚落地的小儿子一大家子全搬了过去。",
      "token_start": 964,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 275650,
      "end_ms": 276525,
      "text": "在荒山上，",
      "token_start": 988,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 276830,
      "end_ms": 279125,
      "text": "一砖一瓦抠出了个研究所，",
      "token_start": 992,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 279570,
      "end_ms": 280575,
      "text": "为啥这么玩命？",
      "token_start": 1003,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 280850,
      "end_ms": 282295,
      "text": "因为他答应过一个娃，",
      "token_start": 1009,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 282910,
      "end_ms": 284155,
      "text": "日子一天天熬，",
      "token_start": 1018,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 284520,
      "end_ms": 286205,
      "text": "疫苗总算捣鼓出来，",
      "token_start": 1024,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 287210,
      "end_ms": 290760,
      "text": "可猴子身上没事不代表人身上没事儿，",
      "token_start": 1032,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 290760,
      "end_ms": 292725,
      "text": "谁敢投一个势顾方舟。",
      "token_start": 1048,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 293260,
      "end_ms": 295080,
      "text": "又把自个儿往前推了一步，",
      "token_start": 1057,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 295360,
      "end_ms": 297880,
      "text": "扬起脖把一瓶灌了下去。",
      "token_start": 1068,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 298580,
      "end_ms": 299320,
      "text": "我是党员，",
      "token_start": 1078,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 299560,
      "end_ms": 301720,
      "text": "我先来猴子，",
      "token_start": 1082,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 301720,
      "end_ms": 302620,
      "text": "他不会开口，",
      "token_start": 1087,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 304360,
      "end_ms": 306800,
      "text": "可我会灌完没啥事儿，",
      "token_start": 1092,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 306800,
      "end_ms": 308800,
      "text": "他又琢磨出一个心坎，",
      "token_start": 1101,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 308800,
      "end_ms": 310060,
      "text": "自个儿是大人，",
      "token_start": 1110,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 310060,
      "end_ms": 313480,
      "text": "大人早就被这病毒磨出抵抗力了。",
      "token_start": 1116,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 313480,
      "end_ms": 315760,
      "text": "可这病真正要命的是，",
      "token_start": 1130,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 315760,
      "end_ms": 318320,
      "text": "那些三五岁的奶娃娃，",
      "token_start": 1139,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 318340,
      "end_ms": 326150,
      "text": "得有个娃试才成成得这个当爹的做了一个让所有人后脊梁发凉的决定。",
      "token_start": 1148,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 326210,
      "end_ms": 327210,
      "text": "他瞒着婆姨，",
      "token_start": 1178,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 327270,
      "end_ms": 331150,
      "text": "把刚落地没多久的小儿子喂了那管疫苗，",
      "token_start": 1183,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 331770,
      "end_ms": 332770,
      "text": "足足一个月，",
      "token_start": 1200,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 333170,
      "end_ms": 335510,
      "text": "他日夜守在娃床边，",
      "token_start": 1205,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 335930,
      "end_ms": 338690,
      "text": "盯着孩子每一个细小的动静，",
      "token_start": 1213,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 339170,
      "end_ms": 342470,
      "text": "直到确认好好的一丁点岔子，",
      "token_start": 1225,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 342470,
      "end_ms": 344610,
      "text": "没有才敢跟媳妇挑明。",
      "token_start": 1237,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 344610,
      "end_ms": 346710,
      "text": "爱人又气又怕，",
      "token_start": 1246,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 346710,
      "end_ms": 347730,
      "text": "哭了好半晌，",
      "token_start": 1252,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 347730,
      "end_ms": 349330,
      "text": "大伙品品，",
      "token_start": 1257,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 349330,
      "end_ms": 353420,
      "text": "他拿亲儿子的命去赌堵的究竟是是啥？",
      "token_start": 1261,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 353910,
      "end_ms": 355010,
      "text": "不就是阿楚那句，",
      "token_start": 1277,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 355010,
      "end_ms": 358265,
      "text": "往后的小朋友再也不用得这病了。",
      "token_start": 1284,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 358600,
      "end_ms": 359040,
      "text": "后来，",
      "token_start": 1298,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 359260,
      "end_ms": 363280,
      "text": "队里其他人的侍灵娃也陆陆续续入了实验组，",
      "token_start": 1300,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 363420,
      "end_ms": 368395,
      "text": "这帮科研人员的崽成了咱中国头一波被唐王护住的娃。",
      "token_start": 1319,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 369220,
      "end_ms": 370765,
      "text": "可顾方舟还不甘心，",
      "token_start": 1342,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 371270,
      "end_ms": 374645,
      "text": "他发现呢液体的疫苗又苦又娇气，",
      "token_start": 1350,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 375210,
      "end_ms": 377925,
      "text": "乡下山坳里的娃根本吃不上，",
      "token_start": 1364,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 378360,
      "end_ms": 378900,
      "text": "有一回，",
      "token_start": 1376,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 379120,
      "end_ms": 381040,
      "text": "他瞅见小孙子辈吃糖，",
      "token_start": 1379,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 381120,
      "end_ms": 382175,
      "text": "那股子馋劲儿，",
      "token_start": 1388,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 382680,
      "end_ms": 383760,
      "text": "脑子里钉一下，",
      "token_start": 1394,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 383760,
      "end_ms": 385065,
      "text": "咋不捣鼓成堂呢？",
      "token_start": 1400,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 385520,
      "end_ms": 386545,
      "text": "他和队伍一合计，",
      "token_start": 1407,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 386910,
      "end_ms": 389795,
      "text": "把疫苗掺进葡萄糖奶粉里，",
      "token_start": 1414,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 390260,
      "end_ms": 393665,
      "text": "搓成了一颗甜丝丝圆溜溜的小糖丸。",
      "token_start": 1425,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 394250,
      "end_ms": 396830,
      "text": "外头瞅着跟寻常糖果没两样，",
      "token_start": 1440,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 396830,
      "end_ms": 399125,
      "text": "娃高高兴兴就给咽下去了。",
      "token_start": 1452,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 399980,
      "end_ms": 401835,
      "text": "打从六七十年代起，",
      "token_start": 1463,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 402110,
      "end_ms": 406905,
      "text": "糖丸就在全国撒开了一代又一代的中国娃，",
      "token_start": 1471,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 407270,
      "end_ms": 409555,
      "text": "就是裹着这么一口甜味儿，",
      "token_start": 1489,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 410010,
      "end_ms": 412135,
      "text": "躲过了那场要命的瘟神来。",
      "token_start": 1500,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 412680,
      "end_ms": 414000,
      "text": "我把结局摊给你看。",
      "token_start": 1511,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 414000,
      "end_ms": 420065,
      "text": "九十年代后半截中国大地上再没冒出过一例本土的这种病例。",
      "token_start": 1519,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 420510,
      "end_ms": 422205,
      "text": "跨进新世纪没多久，",
      "token_start": 1545,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 422780,
      "end_ms": 428025,
      "text": "七十好几的顾方舟代表中国在消灭几徽的认证书上，",
      "token_start": 1553,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 428400,
      "end_ms": 430895,
      "text": "一笔一画签下了自个儿的名。",
      "token_start": 1575,
      "token_end_exclusive": 1587
    },
    {
      "start_ms": 431150,
      "end_ms": 432595,
      "text": "那个叫阿楚的男孩，",
      "token_start": 1587,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 432960,
      "end_ms": 434400,
      "text": "没能亲眼瞧见的，",
      "token_start": 1595,
      "token_end_exclusive": 1602
    },
    {
      "start_ms": 434400,
      "end_ms": 437985,
      "text": "将来他替他一点一点给圆上了。",
      "token_start": 1602,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 438990,
      "end_ms": 439830,
      "text": "二零一九年，",
      "token_start": 1615,
      "token_end_exclusive": 1620
    },
    {
      "start_ms": 439830,
      "end_ms": 443065,
      "text": "顾方舟走了九十二岁，",
      "token_start": 1620,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 443980,
      "end_ms": 447995,
      "text": "有人念叨老人临走那会儿，",
      "token_start": 1629,
      "token_end_exclusive": 1640
    },
    {
      "start_ms": 448320,
      "end_ms": 451485,
      "text": "手里还珍藏着那颗几十年的乳牙，",
      "token_start": 1640,
      "token_end_exclusive": 1654
    },
    {
      "start_ms": 452130,
      "end_ms": 453015,
      "text": "一颗乳牙，",
      "token_start": 1654,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 453280,
      "end_ms": 460015,
      "text": "一句童言被一个大男人记得一辈子气到把一个国家从瘟疫里拽了出来，",
      "token_start": 1658,
      "token_end_exclusive": 1688
    },
    {
      "start_ms": 460420,
      "end_ms": 466095,
      "text": "气到让好几亿娃都能在日头底下撒丫子跑跳效果。",
      "token_start": 1688,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 466370,
      "end_ms": 468100,
      "text": "今儿个我把这事儿讲给你听，",
      "token_start": 1709,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 468140,
      "end_ms": 469675,
      "text": "不是非要删你的情，",
      "token_start": 1721,
      "token_end_exclusive": 1729
    },
    {
      "start_ms": 470680,
      "end_ms": 474310,
      "text": "我就想让你晓得这世上真有这么一种大人，",
      "token_start": 1729,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 474650,
      "end_ms": 477850,
      "text": "会把一个孩子随口嘟囔的心愿，",
      "token_start": 1747,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 478270,
      "end_ms": 480370,
      "text": "当成自个儿一辈子的差事。",
      "token_start": 1760,
      "token_end_exclusive": 1771
    },
    {
      "start_ms": 480889,
      "end_ms": 484370,
      "text": "你小时候含过的那颗甜丝丝的糖丸，",
      "token_start": 1771,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 484850,
      "end_ms": 488430,
      "text": "是一个娃在病床上许下的愿，",
      "token_start": 1786,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 488950,
      "end_ms": 492210,
      "text": "是一个当爹的拿亲儿子的命，",
      "token_start": 1798,
      "token_end_exclusive": 1810
    },
    {
      "start_ms": 492610,
      "end_ms": 494370,
      "text": "替他兑现的诺言。",
      "token_start": 1810,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 494950,
      "end_ms": 496510,
      "text": "你要是也被暖着了，",
      "token_start": 1817,
      "token_end_exclusive": 1825
    },
    {
      "start_ms": 496850,
      "end_ms": 497710,
      "text": "就点个赞，",
      "token_start": 1825,
      "token_end_exclusive": 1829
    },
    {
      "start_ms": 498010,
      "end_ms": 498610,
      "text": "收个藏，",
      "token_start": 1829,
      "token_end_exclusive": 1832
    },
    {
      "start_ms": 499070,
      "end_ms": 501790,
      "text": "顺手转给你心尖上的人。",
      "token_start": 1832,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 501970,
      "end_ms": 505920,
      "text": "尤其是要是是你家也有打小吃过那颗糖的老人，",
      "token_start": 1842,
      "token_end_exclusive": 1862
    },
    {
      "start_ms": 506460,
      "end_ms": 510160,
      "text": "今晚替他们跟顾方舟爷爷道一声谢，",
      "token_start": 1862,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 511060,
      "end_ms": 513795,
      "text": "记着他顾方舟糖丸爷爷。",
      "token_start": 1877,
      "token_end_exclusive": 1887
    }
  ],
