{
  "video_id": "v_4d1bc3ed519e0994",
  "duration_s": 472.688005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_4d1bc3ed519e0994.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_4d1bc3ed519e0994.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1950,
      "text": "全世界都知道他是天才，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2310,
      "end_ms": 4890,
      "text": "只有他女儿知道他连鞋马都，",
      "token_start": 10,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4890,
      "end_ms": 7150,
      "text": "不知道他是个天才。",
      "token_start": 22,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7630,
      "end_ms": 9730,
      "text": "十三岁考进县城高校，",
      "token_start": 30,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 10030,
      "end_ms": 13430,
      "text": "十七岁成全县第一个公费中学生，",
      "token_start": 39,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13830,
      "end_ms": 15110,
      "text": "二十岁上南开，",
      "token_start": 53,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15290,
      "end_ms": 17150,
      "text": "二十二岁进北大。",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 17390,
      "end_ms": 20790,
      "text": "留学美国是从世界气体力学第一人，",
      "token_start": 66,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21070,
      "end_ms": 25050,
      "text": "冯卡门啃下了全世界没人敢碰的课题。",
      "token_start": 81,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 25050,
      "end_ms": 34600,
      "text": "他是全世界唯一一个在核弹、导弹进人造卫星三个领域都做出开创性贡献的科学家。",
      "token_start": 97,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 35820,
      "end_ms": 36700,
      "text": "钱学森说，",
      "token_start": 132,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 36780,
      "end_ms": 38360,
      "text": "郭永怀能顶两个，",
      "token_start": 136,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 38360,
      "end_ms": 40640,
      "text": "我可就是这么个天才。",
      "token_start": 143,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 40840,
      "end_ms": 41800,
      "text": "有一件事儿，",
      "token_start": 152,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 42380,
      "end_ms": 43100,
      "text": "他不知道，",
      "token_start": 157,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 43820,
      "end_ms": 45980,
      "text": "他不知道自己女儿的脚有多大。",
      "token_start": 161,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 46960,
      "end_ms": 48000,
      "text": "女儿叫郭琴。",
      "token_start": 174,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 48900,
      "end_ms": 49920,
      "text": "有一年冬天，",
      "token_start": 179,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 50400,
      "end_ms": 51720,
      "text": "他在内蒙古插队，",
      "token_start": 184,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 52140,
      "end_ms": 53160,
      "text": "脚冻伤了，",
      "token_start": 191,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 53400,
      "end_ms": 54340,
      "text": "写信给爸爸，",
      "token_start": 195,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 54640,
      "end_ms": 57620,
      "text": "想要一双棉鞋郭永怀。",
      "token_start": 200,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 57620,
      "end_ms": 59320,
      "text": "拿着信愣了半天，",
      "token_start": 209,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 59620,
      "end_ms": 60645,
      "text": "他想给给女儿买，",
      "token_start": 216,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 61460,
      "end_ms": 64195,
      "text": "可他连女儿穿几码的鞋都不知道。",
      "token_start": 223,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 64650,
      "end_ms": 67835,
      "text": "他提笔回信写了一句让人心酸的话，",
      "token_start": 237,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 68580,
      "end_ms": 71985,
      "text": "布鞋暂时没有你画个脚样系来，",
      "token_start": 252,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 72380,
      "end_ms": 77595,
      "text": "等有货了一定买你想想一个父亲连女儿的鞋码都不知道，",
      "token_start": 265,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 77950,
      "end_ms": 79985,
      "text": "得让女儿画个脚样才能买鞋，",
      "token_start": 289,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 80930,
      "end_ms": 82225,
      "text": "这得忙到什么程度？",
      "token_start": 301,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 83420,
      "end_ms": 84980,
      "text": "这封信寄出去，",
      "token_start": 309,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 85020,
      "end_ms": 85805,
      "text": "一个月后，",
      "token_start": 315,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 86360,
      "end_ms": 87455,
      "text": "郭永怀牺牲啊，",
      "token_start": 319,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 88490,
      "end_ms": 92305,
      "text": "那双棉鞋终究没能寄到女儿手上。",
      "token_start": 325,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 92740,
      "end_ms": 93625,
      "text": "他为啥这么忙？",
      "token_start": 339,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 94200,
      "end_ms": 95085,
      "text": "一九五六年，",
      "token_start": 345,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 95420,
      "end_ms": 98935,
      "text": "他放弃美国康奈尔大学终身教授的职位，",
      "token_start": 350,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 99410,
      "end_ms": 102725,
      "text": "放弃花园洋房、小汽车和优厚年薪，",
      "token_start": 367,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 103320,
      "end_ms": 106425,
      "text": "一把火烧掉自己十几年的研究手稿，",
      "token_start": 381,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 106800,
      "end_ms": 108340,
      "text": "带着老婆孩子回了国。",
      "token_start": 396,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 108580,
      "end_ms": 109245,
      "text": "为啥烧？",
      "token_start": 405,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 109690,
      "end_ms": 115545,
      "text": "因为钱学森回国时带的八百公斤书籍笔记全被美国海关没收了。",
      "token_start": 408,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 116020,
      "end_ms": 118055,
      "text": "他说这些东西带不走的，",
      "token_start": 435,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 118450,
      "end_ms": 119955,
      "text": "都装进我脑子里了。",
      "token_start": 445,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 120470,
      "end_ms": 121150,
      "text": "回国后，",
      "token_start": 453,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 121350,
      "end_ms": 123035,
      "text": "周总理问他有什么要求，",
      "token_start": 456,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 123420,
      "end_ms": 124455,
      "text": "他只说了一句，",
      "token_start": 466,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 125040,
      "end_ms": 126985,
      "text": "我想尽快投入工作，",
      "token_start": 472,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 127560,
      "end_ms": 129785,
      "text": "这一投入就是十二年，",
      "token_start": 480,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 130320,
      "end_ms": 131605,
      "text": "再也没停下来过。",
      "token_start": 489,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 132120,
      "end_ms": 135475,
      "text": "他见风洞半地学斑编教材，",
      "token_start": 496,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 135860,
      "end_ms": 139465,
      "text": "跟钱学森一起撑起了中国近代力学的家底。",
      "token_start": 507,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 140050,
      "end_ms": 140930,
      "text": "一九六三年，",
      "token_start": 525,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 140990,
      "end_ms": 143255,
      "text": "他扎进青海高原的合基地，",
      "token_start": 530,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 143550,
      "end_ms": 144815,
      "text": "海拔三千多米，",
      "token_start": 541,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 145120,
      "end_ms": 146455,
      "text": "冬天零下四十度，",
      "token_start": 547,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 146810,
      "end_ms": 148485,
      "text": "和碱水住帐篷，",
      "token_start": 554,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 148800,
      "end_ms": 150235,
      "text": "亲手搅拌炸药，",
      "token_start": 560,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 150660,
      "end_ms": 152425,
      "text": "手上冻的裂满口子，",
      "token_start": 566,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 152830,
      "end_ms": 153965,
      "text": "搓一搓接着干。",
      "token_start": 574,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 154470,
      "end_ms": 155565,
      "text": "他忙到什么程度，",
      "token_start": 580,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 155930,
      "end_ms": 156935,
      "text": "喜欢听音乐，",
      "token_start": 587,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 157220,
      "end_ms": 158980,
      "text": "从美国带回来两箱，",
      "token_start": 592,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 158980,
      "end_ms": 160955,
      "text": "唱片连封都没拆，",
      "token_start": 600,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 161360,
      "end_ms": 164685,
      "text": "最后送给了中央人民广播电台爱好集邮，",
      "token_start": 607,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 165010,
      "end_ms": 166055,
      "text": "收集了三大本，",
      "token_start": 624,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 166590,
      "end_ms": 168385,
      "text": "全送给了邮政总局。",
      "token_start": 630,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 168710,
      "end_ms": 169435,
      "text": "喜欢摄影，",
      "token_start": 638,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 169770,
      "end_ms": 172445,
      "text": "忙得连镜头都没空摸一下，",
      "token_start": 642,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 172960,
      "end_ms": 175075,
      "text": "一个人的爱好全扔了，",
      "token_start": 653,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 175260,
      "end_ms": 177415,
      "text": "他的时间全部给了国家。",
      "token_start": 662,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 182690,
      "end_ms": 186110,
      "text": "女儿郭秦从小就很少见到爸爸，",
      "token_start": 672,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 186910,
      "end_ms": 188430,
      "text": "有一次女儿过生日，",
      "token_start": 685,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 188750,
      "end_ms": 190025,
      "text": "问爸爸要礼物，",
      "token_start": 693,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 192620,
      "end_ms": 193840,
      "text": "郭永怀太忙了，",
      "token_start": 699,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 194740,
      "end_ms": 195460,
      "text": "忙的忘了。",
      "token_start": 705,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 195460,
      "end_ms": 196360,
      "text": "女儿的生日，",
      "token_start": 709,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 196720,
      "end_ms": 197980,
      "text": "他愧疚的想了想，",
      "token_start": 714,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 198340,
      "end_ms": 201800,
      "text": "指着窗外的夜空半开玩笑半认真的说，",
      "token_start": 721,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 202320,
      "end_ms": 204260,
      "text": "以后天上会多一颗星星，",
      "token_start": 737,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 204620,
      "end_ms": 206360,
      "text": "那就是爸爸送你的礼物。",
      "token_start": 747,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 207000,
      "end_ms": 208380,
      "text": "女儿咯咯咯的笑了，",
      "token_start": 757,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 208820,
      "end_ms": 211860,
      "text": "他不知道爸爸这句话不是玩笑。",
      "token_start": 765,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 212420,
      "end_ms": 214140,
      "text": "一九六四年十月十六日，",
      "token_start": 778,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 214140,
      "end_ms": 216280,
      "text": "中国第一颗原子弹爆炸成功，",
      "token_start": 788,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 216420,
      "end_ms": 218380,
      "text": "郭永怀累得瘫软在地，",
      "token_start": 800,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 218820,
      "end_ms": 221765,
      "text": "流着泪说成功了。",
      "token_start": 809,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 222770,
      "end_ms": 224610,
      "text": "一九六七年六月十七日，",
      "token_start": 816,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 224610,
      "end_ms": 227290,
      "text": "中国第一颗氢弹爆炸成功，",
      "token_start": 826,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 228050,
      "end_ms": 231410,
      "text": "他又一次泪晕在欢呼声里醒来。",
      "token_start": 837,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 231410,
      "end_ms": 232430,
      "text": "第一句话成功了，",
      "token_start": 850,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 232430,
      "end_ms": 234210,
      "text": "第二句话不能停下，",
      "token_start": 857,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 234690,
      "end_ms": 236310,
      "text": "要抓紧搞热核弹，",
      "token_start": 865,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 236450,
      "end_ms": 237550,
      "text": "搞人造卫星，",
      "token_start": 872,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 238070,
      "end_ms": 241475,
      "text": "他惦记的永远是给女儿的那颗行星。",
      "token_start": 877,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 242190,
      "end_ms": 243650,
      "text": "一九六八年十二月，",
      "token_start": 892,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 243650,
      "end_ms": 246365,
      "text": "他在青海发现了关键数据，",
      "token_start": 900,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 246970,
      "end_ms": 248715,
      "text": "必须立刻赶回北京。",
      "token_start": 911,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 249690,
      "end_ms": 251665,
      "text": "同事劝他别做夜行，",
      "token_start": 919,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 252520,
      "end_ms": 255940,
      "text": "他说晚上非省时间打个盹儿。",
      "token_start": 927,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 255940,
      "end_ms": 259045,
      "text": "就到了十二月五日傍晚，",
      "token_start": 939,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 259300,
      "end_ms": 261705,
      "text": "飞机在首都机场上空失控，",
      "token_start": 949,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 262680,
      "end_ms": 263180,
      "text": "坠毁。",
      "token_start": 960,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 263240,
      "end_ms": 265335,
      "text": "在一公里外的玉米地里，",
      "token_start": 962,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 266320,
      "end_ms": 268580,
      "text": "巨击上唯一生还者。",
      "token_start": 972,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 268600,
      "end_ms": 271205,
      "text": "回忆坠机前，",
      "token_start": 980,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 271760,
      "end_ms": 274185,
      "text": "郭永怀喊了一声我的材料，",
      "token_start": 985,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 274570,
      "end_ms": 277695,
      "text": "然后和警卫员谋方东紧紧抱在一起，",
      "token_start": 996,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 278020,
      "end_ms": 280575,
      "text": "把一个公文包护在两人胸前。",
      "token_start": 1011,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 281300,
      "end_ms": 284265,
      "text": "救援人员分开两具烧焦的尸体时，",
      "token_start": 1023,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 284800,
      "end_ms": 288555,
      "text": "公文包里的热核导弹试验数据完好无损，",
      "token_start": 1037,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 289300,
      "end_ms": 292255,
      "text": "他用自己的命护住了国家的机密。",
      "token_start": 1054,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 292500,
      "end_ms": 293735,
      "text": "十二月二十五日，",
      "token_start": 1068,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 294090,
      "end_ms": 295855,
      "text": "中央追认他为烈士。",
      "token_start": 1075,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 296420,
      "end_ms": 297725,
      "text": "十二月二十七日。",
      "token_start": 1083,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 298150,
      "end_ms": 300150,
      "text": "他牺牲的第二十二天，",
      "token_start": 1090,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 300570,
      "end_ms": 303990,
      "text": "中国第一颗热核导弹试验成功。",
      "token_start": 1099,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 305230,
      "end_ms": 307210,
      "text": "一九七零年四月二十四日，",
      "token_start": 1112,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 307570,
      "end_ms": 309910,
      "text": "东方红一号卫星发射成功。",
      "token_start": 1123,
      "token_end_exclusive": 1134
    },
    {
      "start_ms": 310410,
      "end_ms": 314209,
      "text": "夜空里真的多了一颗会唱歌的星星。",
      "token_start": 1134,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 314830,
      "end_ms": 315230,
      "text": "那天，",
      "token_start": 1149,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 315230,
      "end_ms": 316790,
      "text": "郭琴仰头看着天，",
      "token_start": 1151,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 317130,
      "end_ms": 318410,
      "text": "忽然全明白了，",
      "token_start": 1158,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 319910,
      "end_ms": 321450,
      "text": "爸爸当年说的礼物，",
      "token_start": 1164,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 322010,
      "end_ms": 323250,
      "text": "不是哄他玩的，",
      "token_start": 1172,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 323550,
      "end_ms": 325470,
      "text": "他真的送了他一颗星星。",
      "token_start": 1178,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 325910,
      "end_ms": 329140,
      "text": "可这颗星星爸爸没能亲手手交到他手上，",
      "token_start": 1188,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 330120,
      "end_ms": 332420,
      "text": "那双棉鞋也没能寄到，",
      "token_start": 1205,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 332420,
      "end_ms": 333700,
      "text": "给他穿到脚上，",
      "token_start": 1214,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 334060,
      "end_ms": 334820,
      "text": "那个生日，",
      "token_start": 1220,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 334820,
      "end_ms": 336440,
      "text": "爸爸也没能陪他过。",
      "token_start": 1224,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 337040,
      "end_ms": 337980,
      "text": "二零一八年，",
      "token_start": 1232,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 337980,
      "end_ms": 344340,
      "text": "编号二幺二七九六的小行星被永久命名为郭勇怀星。",
      "token_start": 1237,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 344880,
      "end_ms": 348420,
      "text": "爸爸答应女儿的星星在宇宙里永恒的亮着。",
      "token_start": 1259,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 348800,
      "end_ms": 349680,
      "text": "我们这代人，",
      "token_start": 1277,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 349920,
      "end_ms": 352180,
      "text": "多少人的爸爸也是这样。",
      "token_start": 1282,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 352500,
      "end_ms": 353320,
      "text": "为了养家，",
      "token_start": 1292,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 353500,
      "end_ms": 354220,
      "text": "为了工作，",
      "token_start": 1296,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 354540,
      "end_ms": 355960,
      "text": "错过了孩子的成长，",
      "token_start": 1300,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 356520,
      "end_ms": 357605,
      "text": "欠了一个生日，",
      "token_start": 1308,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 358220,
      "end_ms": 359505,
      "text": "欠了一双棉鞋，",
      "token_start": 1314,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 360220,
      "end_ms": 363185,
      "text": "欠了无数个下次陪你。",
      "token_start": 1320,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 363410,
      "end_ms": 367040,
      "text": "可郭永怀的亏欠献给了整个国家，",
      "token_start": 1329,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 367180,
      "end_ms": 370545,
      "text": "他把给女儿的星星送给了中国每一个人。",
      "token_start": 1343,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 371110,
      "end_ms": 373095,
      "text": "他欠女儿一双棉鞋，",
      "token_start": 1360,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 373630,
      "end_ms": 377285,
      "text": "可他让全中国的孩子都能穿上暖和的鞋。",
      "token_start": 1368,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 377820,
      "end_ms": 379175,
      "text": "他欠女儿一个生日，",
      "token_start": 1385,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 379870,
      "end_ms": 383815,
      "text": "可他让全中国的孩子都能安心的过生日。",
      "token_start": 1393,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 384640,
      "end_ms": 386525,
      "text": "他欠女儿无数个陪伴，",
      "token_start": 1410,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 386920,
      "end_ms": 391505,
      "text": "可他让全中国的孩子都能在和平的天空下长大。",
      "token_start": 1419,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 392040,
      "end_ms": 393055,
      "text": "作为科学家，",
      "token_start": 1439,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 393620,
      "end_ms": 395605,
      "text": "他是天才中的天才，",
      "token_start": 1444,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 396170,
      "end_ms": 398905,
      "text": "他能算出超音速的数学难题，",
      "token_start": 1452,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 399470,
      "end_ms": 401395,
      "text": "能造出原子弹和氢弹，",
      "token_start": 1464,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 402100,
      "end_ms": 403640,
      "text": "能把卫星送上天，",
      "token_start": 1473,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 403780,
      "end_ms": 405420,
      "text": "能在坠机的最后一秒，",
      "token_start": 1480,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 405420,
      "end_ms": 408095,
      "text": "用身体互主国家最高机密。",
      "token_start": 1489,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 408620,
      "end_ms": 409625,
      "text": "可作为父亲，",
      "token_start": 1500,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 410030,
      "end_ms": 411805,
      "text": "他连女儿的鞋码都不知道，",
      "token_start": 1505,
      "token_end_exclusive": 1516
    },
    {
      "start_ms": 412630,
      "end_ms": 413465,
      "text": "这不是矛盾，",
      "token_start": 1516,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 414450,
      "end_ms": 415245,
      "text": "这是选择。",
      "token_start": 1521,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 416560,
      "end_ms": 420485,
      "text": "他选择了做一个不称职的父亲，",
      "token_start": 1525,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 420830,
      "end_ms": 423365,
      "text": "去做一个最称职的科学家。",
      "token_start": 1538,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 424080,
      "end_ms": 426705,
      "text": "他把给女儿的时间给了国家，",
      "token_start": 1549,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 427380,
      "end_ms": 429975,
      "text": "把给女儿的陪伴给了隔壁滩，",
      "token_start": 1561,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 430380,
      "end_ms": 433555,
      "text": "发给女儿的棉鞋换成了蘑菇云，",
      "token_start": 1573,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 434020,
      "end_ms": 436995,
      "text": "把给女儿的星星送给了全中国。",
      "token_start": 1586,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 437570,
      "end_ms": 439175,
      "text": "有人说他亏欠了女儿，",
      "token_start": 1599,
      "token_end_exclusive": 1608
    },
    {
      "start_ms": 439600,
      "end_ms": 440880,
      "text": "可他女儿后来懂了，",
      "token_start": 1608,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 440880,
      "end_ms": 442105,
      "text": "爸爸不是不爱他。",
      "token_start": 1616,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 442510,
      "end_ms": 446595,
      "text": "爸爸是把对他一个人的爱分给了全中国的孩子。",
      "token_start": 1623,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 447520,
      "end_ms": 448675,
      "text": "这就是郭永怀，",
      "token_start": 1643,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 449300,
      "end_ms": 451785,
      "text": "一个全世界都仰望的科学家。",
      "token_start": 1649,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 452800,
      "end_ms": 456445,
      "text": "一个女儿眼里不称职的父亲，",
      "token_start": 1661,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 457640,
      "end_ms": 461585,
      "text": "可正是这千千万万个不称职的父亲，",
      "token_start": 1673,
      "token_end_exclusive": 1688
    },
    {
      "start_ms": 462000,
      "end_ms": 464085,
      "text": "撑起了这个国家的腰杆子，",
      "token_start": 1688,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 464450,
      "end_ms": 466275,
      "text": "觉得心里热的点个赞，",
      "token_start": 1699,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 466530,
      "end_ms": 468580,
      "text": "收藏起来转发给你的孩子，",
      "token_start": 1708,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 468580,
      "end_ms": 469005,
      "text": "看看，",
      "token_start": 1719,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 469460,
      "end_ms": 470465,
      "text": "也点个关注，",
      "token_start": 1721,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 470870,
      "end_ms": 472545,
      "text": "后面我接着给你讲。",
      "token_start": 1726,
      "token_end_exclusive": 1734
    }
  ],
