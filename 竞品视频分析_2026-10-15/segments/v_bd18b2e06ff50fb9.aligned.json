{
  "video_id": "v_bd18b2e06ff50fb9",
  "duration_s": 375.235011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_bd18b2e06ff50fb9.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_bd18b2e06ff50fb9.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 4530,
      "text": "你知道中国古代最让人想不通的建筑是哪一座吗？",
      "token_start": 0,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5230,
      "end_ms": 5910,
      "text": "有人说，",
      "token_start": 21,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5950,
      "end_ms": 7930,
      "text": "故宫九千多间，",
      "token_start": 24,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7930,
      "end_ms": 9790,
      "text": "房六百年没塌。",
      "token_start": 30,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 10050,
      "end_ms": 13010,
      "text": "有人说万里长城两万多公里，",
      "token_start": 36,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 13470,
      "end_ms": 15770,
      "text": "修了两千年错，",
      "token_start": 48,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 16730,
      "end_ms": 19130,
      "text": "故宫连乾五都挤不进去，",
      "token_start": 54,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 19850,
      "end_ms": 21150,
      "text": "长城也不是第一。",
      "token_start": 64,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 21950,
      "end_ms": 24990,
      "text": "真正做头把交椅的那座东西，",
      "token_start": 71,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 25730,
      "end_ms": 26550,
      "text": "不是宫殿，",
      "token_start": 83,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 26790,
      "end_ms": 27745,
      "text": "不是城墙，",
      "token_start": 87,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 29690,
      "end_ms": 30690,
      "text": "没有一块砖，",
      "token_start": 91,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 31190,
      "end_ms": 32170,
      "text": "没有一根铁。",
      "token_start": 96,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 32530,
      "end_ms": 34970,
      "text": "两千二百多年以前没停过到，",
      "token_start": 101,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 34970,
      "end_ms": 37850,
      "text": "今天还在给上千万人供水浇地，",
      "token_start": 113,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 38390,
      "end_ms": 39290,
      "text": "他就在四川，",
      "token_start": 126,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 39630,
      "end_ms": 40970,
      "text": "你天天听说他，",
      "token_start": 131,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 41050,
      "end_ms": 43670,
      "text": "但你从来没把它当成建筑来看。",
      "token_start": 137,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 44610,
      "end_ms": 49470,
      "text": "今天咱们就来盘点中国古代十大最不可思议的建筑。",
      "token_start": 150,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 50490,
      "end_ms": 54610,
      "text": "老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 172,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 54950,
      "end_ms": 56890,
      "text": "让我看看都是谁在停。",
      "token_start": 189,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 57610,
      "end_ms": 58330,
      "text": "第十名，",
      "token_start": 198,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 58630,
      "end_ms": 60675,
      "text": "四川逃平枪战，",
      "token_start": 201,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 61530,
      "end_ms": 63435,
      "text": "西汉时期就有了。",
      "token_start": 207,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 64310,
      "end_ms": 65050,
      "text": "在四川，",
      "token_start": 214,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 65190,
      "end_ms": 67925,
      "text": "阿坝澧县两千多年了，",
      "token_start": 217,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 68540,
      "end_ms": 70635,
      "text": "整个寨子全是石头垒的，",
      "token_start": 226,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 71070,
      "end_ms": 71935,
      "text": "没有图纸，",
      "token_start": 236,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 72200,
      "end_ms": 73000,
      "text": "没有吊车，",
      "token_start": 240,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 73260,
      "end_ms": 74155,
      "text": "没有水泥。",
      "token_start": 244,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 74660,
      "end_ms": 79240,
      "text": "最绝的是地底下挖了一套完整的暗渠水网，",
      "token_start": 248,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 79280,
      "end_ms": 80745,
      "text": "家家户户通水，",
      "token_start": 266,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 81090,
      "end_ms": 82725,
      "text": "人在无里就能取水，",
      "token_start": 272,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 83180,
      "end_ms": 85395,
      "text": "外人进来跟进了迷宫一样。",
      "token_start": 280,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 86250,
      "end_ms": 87390,
      "text": "一九三三年，",
      "token_start": 291,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 87470,
      "end_ms": 88485,
      "text": "迭西大地震，",
      "token_start": 296,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 88890,
      "end_ms": 90545,
      "text": "周围村子塌了大半，",
      "token_start": 301,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 91410,
      "end_ms": 94325,
      "text": "陶坪羌寨连墙皮都没掉几块。",
      "token_start": 309,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 94810,
      "end_ms": 95790,
      "text": "两千年前，",
      "token_start": 321,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 96050,
      "end_ms": 99655,
      "text": "一帮羌族老百姓用石头垒出来的寨子，",
      "token_start": 325,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 100030,
      "end_ms": 102555,
      "text": "把现代地震专家都看傻了。",
      "token_start": 341,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 103010,
      "end_ms": 104425,
      "text": "您说邪门不邪门儿？",
      "token_start": 352,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 105710,
      "end_ms": 106365,
      "text": "第九名，",
      "token_start": 360,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 106780,
      "end_ms": 107965,
      "text": "河北挖皇宫，",
      "token_start": 363,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 108260,
      "end_ms": 113885,
      "text": "北齐时候修的在邯郸歙县钟黄山一千四百多年了，",
      "token_start": 368,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 114660,
      "end_ms": 116425,
      "text": "一座四层楼阁，",
      "token_start": 389,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 117210,
      "end_ms": 118950,
      "text": "通高二十三米，",
      "token_start": 395,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 118970,
      "end_ms": 120645,
      "text": "不是盖在地上的，",
      "token_start": 401,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 120920,
      "end_ms": 122425,
      "text": "是挂在悬崖上的。",
      "token_start": 408,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 123360,
      "end_ms": 129125,
      "text": "怎么挂悬崖上凿了八个栓马鼻九根铁链，",
      "token_start": 415,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 129390,
      "end_ms": 132025,
      "text": "把楼阁跟崖壁拴在一起，",
      "token_start": 432,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 132900,
      "end_ms": 134575,
      "text": "平时铁链是松的，",
      "token_start": 442,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 135140,
      "end_ms": 136925,
      "text": "人一多楼往前倾，",
      "token_start": 449,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 137260,
      "end_ms": 138060,
      "text": "铁链崩的，",
      "token_start": 456,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 138060,
      "end_ms": 139240,
      "text": "跟弓弦一样，",
      "token_start": 460,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 139360,
      "end_ms": 140385,
      "text": "把楼稳住了。",
      "token_start": 465,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 141020,
      "end_ms": 142925,
      "text": "专家罗哲文先生说过，",
      "token_start": 470,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 143230,
      "end_ms": 146205,
      "text": "这用的是重心偏离安全律的原理，",
      "token_start": 479,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 146720,
      "end_ms": 148285,
      "text": "比比萨斜塔还早，",
      "token_start": 493,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 148690,
      "end_ms": 151665,
      "text": "当地老百姓给他起了个名叫活楼吊庙。",
      "token_start": 500,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 152760,
      "end_ms": 153515,
      "text": "第八名，",
      "token_start": 516,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 153840,
      "end_ms": 156490,
      "text": "福建洛阳桥北宋时候修的，",
      "token_start": 519,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 156490,
      "end_ms": 160285,
      "text": "在泉州洛阳江入海口快一千年了。",
      "token_start": 530,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 161210,
      "end_ms": 165470,
      "text": "这座桥建在江海交汇的地方底下，",
      "token_start": 544,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 165470,
      "end_ms": 166395,
      "text": "全是烂泥，",
      "token_start": 558,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 167120,
      "end_ms": 168365,
      "text": "根本打不了桩。",
      "token_start": 562,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 169430,
      "end_ms": 170795,
      "text": "古人想了个办法，",
      "token_start": 568,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 171920,
      "end_ms": 177210,
      "text": "在桥底下养牡蛎牡蛎壳一层一层粘，",
      "token_start": 575,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 177210,
      "end_ms": 179795,
      "text": "在桥基上把石头全浇住了，",
      "token_start": 590,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 180220,
      "end_ms": 181820,
      "text": "比水泥还结实。",
      "token_start": 601,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 182180,
      "end_ms": 184100,
      "text": "这叫种力固给法。",
      "token_start": 607,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 184820,
      "end_ms": 187340,
      "text": "全世界独一份建成以来，",
      "token_start": 614,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 187340,
      "end_ms": 191860,
      "text": "经历了多少次台风洪水地震，",
      "token_start": 624,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 192920,
      "end_ms": 198045,
      "text": "到现在汽车还在上面跑老祖宗的办法。",
      "token_start": 636,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 199990,
      "end_ms": 202590,
      "text": "你说土不土土，",
      "token_start": 652,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 204570,
      "end_ms": 205530,
      "text": "但他管用。",
      "token_start": 658,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 205730,
      "end_ms": 206370,
      "text": "第七名，",
      "token_start": 662,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 208150,
      "end_ms": 215050,
      "text": "浙江龙游石窟在衢州龙游县一个水塘底下藏着的。",
      "token_start": 665,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 215830,
      "end_ms": 216950,
      "text": "一九九二年，",
      "token_start": 686,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 216950,
      "end_ms": 219910,
      "text": "几个村民把水抽干底下冒出来，",
      "token_start": 691,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 219910,
      "end_ms": 222470,
      "text": "一大群人工凿出来的地下石窟，",
      "token_start": 704,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 222930,
      "end_ms": 223770,
      "text": "二十四个，",
      "token_start": 717,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 224130,
      "end_ms": 225390,
      "text": "最高的三十米，",
      "token_start": 721,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 225650,
      "end_ms": 229800,
      "text": "凿出来的石头将近一百万立方石窟。",
      "token_start": 727,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 229860,
      "end_ms": 230740,
      "text": "屋里没有文字，",
      "token_start": 742,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 231000,
      "end_ms": 231820,
      "text": "没有壁画，",
      "token_start": 748,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 232080,
      "end_ms": 233300,
      "text": "没有任何记载，",
      "token_start": 752,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 233940,
      "end_ms": 236040,
      "text": "谁凿的什么时候凿的，",
      "token_start": 758,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 236460,
      "end_ms": 237540,
      "text": "用什么凿的，",
      "token_start": 767,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 237680,
      "end_ms": 238440,
      "text": "为什么凿？",
      "token_start": 772,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 239100,
      "end_ms": 241445,
      "text": "全世界专家研究了二十多年，",
      "token_start": 776,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 241930,
      "end_ms": 243010,
      "text": "一个都答不上来，",
      "token_start": 788,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 243110,
      "end_ms": 245795,
      "text": "有人叫他世界第九大奇迹。",
      "token_start": 795,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 246490,
      "end_ms": 247095,
      "text": "你想想，",
      "token_start": 806,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 247610,
      "end_ms": 250715,
      "text": "两千年前的人在地下干这么大的工程，",
      "token_start": 809,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 251300,
      "end_ms": 253715,
      "text": "竟然一点痕迹都没留下。",
      "token_start": 825,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 254650,
      "end_ms": 256265,
      "text": "这事儿你上哪儿说了一句？",
      "token_start": 835,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 256700,
      "end_ms": 257335,
      "text": "第六名，",
      "token_start": 846,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 257800,
      "end_ms": 259660,
      "text": "河南登封观星台，",
      "token_start": 849,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 260040,
      "end_ms": 263375,
      "text": "元朝建的在登封告城镇，",
      "token_start": 856,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 263780,
      "end_ms": 270845,
      "text": "七百多年了郭守敬修的中国现存最古老的天文建筑，",
      "token_start": 866,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 271210,
      "end_ms": 274095,
      "text": "就这么一个十来米高的土台子加一根横梁。",
      "token_start": 888,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 274670,
      "end_ms": 276965,
      "text": "郭守敬靠他测出了授时力，",
      "token_start": 906,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 277250,
      "end_ms": 280830,
      "text": "一年三百六十五点二四二五天，",
      "token_start": 917,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 280950,
      "end_ms": 284535,
      "text": "跟现在全世界用的公历几乎一模一样，",
      "token_start": 930,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 285130,
      "end_ms": 287725,
      "text": "比欧洲人早了整整三百年。",
      "token_start": 946,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 288270,
      "end_ms": 289230,
      "text": "没有望远镜，",
      "token_start": 957,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 289450,
      "end_ms": 290470,
      "text": "没有计算机，",
      "token_start": 962,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 290690,
      "end_ms": 291615,
      "text": "没有卫星，",
      "token_start": 967,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 292100,
      "end_ms": 297175,
      "text": "一个人用一根棍和一个台子把天上的事儿算明白了，",
      "token_start": 971,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 298540,
      "end_ms": 300455,
      "text": "您说这脑袋瓜子是什么做的？",
      "token_start": 993,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 301510,
      "end_ms": 302945,
      "text": "从第十到第六名，",
      "token_start": 1005,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 303340,
      "end_ms": 305645,
      "text": "枪寨用石头把地震扛住了，",
      "token_start": 1012,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 306490,
      "end_ms": 307715,
      "text": "挖皇工用铁链。",
      "token_start": 1023,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 308050,
      "end_ms": 310810,
      "text": "把楼阁拴在悬崖上洛阳桥，",
      "token_start": 1029,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 310810,
      "end_ms": 313510,
      "text": "用牡蛎把桥粘在烂泥里。",
      "token_start": 1040,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 314290,
      "end_ms": 318970,
      "text": "龙游石窟地底下挖了个没人能解释的泥登峰观星台，",
      "token_start": 1050,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 319210,
      "end_ms": 321830,
      "text": "用一个土台子算出了功力，",
      "token_start": 1072,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 322590,
      "end_ms": 324230,
      "text": "可他们还不是最邪乎的。",
      "token_start": 1083,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 324970,
      "end_ms": 327410,
      "text": "接下来第五到第一名更离谱。",
      "token_start": 1093,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 328310,
      "end_ms": 329390,
      "text": "有一座建筑，",
      "token_start": 1105,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 329610,
      "end_ms": 331310,
      "text": "一块三百多吨的石头，",
      "token_start": 1110,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 331310,
      "end_ms": 333210,
      "text": "是趁着冬天泼水洞，",
      "token_start": 1119,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 333210,
      "end_ms": 337900,
      "text": "冰在上万人拉的滑板上运了七十公里土。",
      "token_start": 1127,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 337960,
      "end_ms": 339980,
      "text": "郭进城的有一个工城，",
      "token_start": 1144,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 340100,
      "end_ms": 341960,
      "text": "藏在地底下五千多公里，",
      "token_start": 1153,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 341960,
      "end_ms": 344900,
      "text": "长让火焰山边上长出了葡萄，",
      "token_start": 1163,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 345520,
      "end_ms": 349200,
      "text": "可坐在头把交椅上的那座没有一块砖，",
      "token_start": 1175,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 349440,
      "end_ms": 350520,
      "text": "没有一根铁，",
      "token_start": 1191,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 350940,
      "end_ms": 352260,
      "text": "两千二百多年，",
      "token_start": 1196,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 352280,
      "end_ms": 353440,
      "text": "一天没写过到，",
      "token_start": 1202,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 353440,
      "end_ms": 355540,
      "text": "今天还在给上千万人供水，",
      "token_start": 1208,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 355920,
      "end_ms": 356680,
      "text": "他是哪座？",
      "token_start": 1219,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 356920,
      "end_ms": 360200,
      "text": "他凭什么把故宫和长城都压下去了，",
      "token_start": 1223,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 360640,
      "end_ms": 362720,
      "text": "下一集已经同步更新，",
      "token_start": 1238,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 363320,
      "end_ms": 365420,
      "text": "现在直接点开我的头像，",
      "token_start": 1247,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 365660,
      "end_ms": 366560,
      "text": "进入主页，",
      "token_start": 1257,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 367240,
      "end_ms": 370515,
      "text": "他一条视频就是下一集点个关注，",
      "token_start": 1261,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 371020,
      "end_ms": 375105,
      "text": "看看谁才是中国古代最不可思议的建筑。",
      "token_start": 1275,
      "token_end_exclusive": 1292
    }
  ],
