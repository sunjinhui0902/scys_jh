{
  "video_id": "v_c58c58689d57b3cb",
  "duration_s": 280.24,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c58c58689d57b3cb.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c58c58689d57b3cb.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 870,
      "end_ms": 1350,
      "text": "周凯，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1850,
      "end_ms": 3270,
      "text": "你们家住这破步梯房，",
      "token_start": 2,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3270,
      "end_ms": 4330,
      "text": "连电梯都没有，",
      "token_start": 11,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4770,
      "end_ms": 6710,
      "text": "楼道里一股油烟味儿熏都恶心，",
      "token_start": 17,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 8150,
      "end_ms": 10490,
      "text": "这是单位以前分的房老了点儿，",
      "token_start": 30,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 10570,
      "end_ms": 12215,
      "text": "但我爸妈特意打扫了一天，",
      "token_start": 43,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 15560,
      "end_ms": 16220,
      "text": "姑娘快坐，",
      "token_start": 54,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 16520,
      "end_ms": 19120,
      "text": "阿姨特意托人从乡下买的老母鸡，",
      "token_start": 58,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 19120,
      "end_ms": 20565,
      "text": "实打实做四个小时呢。",
      "token_start": 72,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 26930,
      "end_ms": 27350,
      "text": "阿姨，",
      "token_start": 81,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 27650,
      "end_ms": 28950,
      "text": "这上面浮着一层油，",
      "token_start": 83,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 29190,
      "end_ms": 30130,
      "text": "怎么下嘴啊？",
      "token_start": 91,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 30270,
      "end_ms": 32650,
      "text": "还有这桌子边角漆都掉了。",
      "token_start": 96,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 32830,
      "end_ms": 36390,
      "text": "第一次请人上门去大饭店订个包厢能花几个钱？",
      "token_start": 107,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 37010,
      "end_ms": 45280,
      "text": "真够寒碜的三观不合的感情，",
      "token_start": 127,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 45960,
      "end_ms": 46815,
      "text": "尽早止损。",
      "token_start": 139,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 49070,
      "end_ms": 49650,
      "text": "半年后，",
      "token_start": 143,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 50570,
      "end_ms": 53770,
      "text": "我遇见了苏晴同一个老小区，",
      "token_start": 146,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 54390,
      "end_ms": 55550,
      "text": "同是一桌家常菜，",
      "token_start": 158,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 56190,
      "end_ms": 62490,
      "text": "气氛却彻底变了小苏。",
      "token_start": 165,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 62490,
      "end_ms": 63070,
      "text": "快请进。",
      "token_start": 174,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 63390,
      "end_ms": 63850,
      "text": "哎呀，",
      "token_start": 177,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 64430,
      "end_ms": 67530,
      "text": "这老小区连个电梯都没有爬上来，",
      "token_start": 179,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 67530,
      "end_ms": 68230,
      "text": "累坏了吧。",
      "token_start": 193,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 68670,
      "end_ms": 68950,
      "text": "阿姨，",
      "token_start": 197,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 68950,
      "end_ms": 70790,
      "text": "好哪能累呀？",
      "token_start": 199,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 71110,
      "end_ms": 73250,
      "text": "我刚才进院子就觉得特别亲切，",
      "token_start": 204,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 73790,
      "end_ms": 74390,
      "text": "绿化好，",
      "token_start": 217,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 74690,
      "end_ms": 76950,
      "text": "邻里之间打招呼特别有人情味。",
      "token_start": 220,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 78510,
      "end_ms": 80910,
      "text": "现在那些高层总感觉少些烟火气，",
      "token_start": 233,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 81710,
      "end_ms": 83010,
      "text": "真没这儿住着舒服。",
      "token_start": 247,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 83410,
      "end_ms": 84870,
      "text": "小苏快尝尝这鸡汤。",
      "token_start": 255,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 85530,
      "end_ms": 87630,
      "text": "阿姨平时手一粗做不来，",
      "token_start": 263,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 87630,
      "end_ms": 89830,
      "text": "外头精致的大餐可能有点油，",
      "token_start": 273,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 89910,
      "end_ms": 91265,
      "text": "你别挑理啊。",
      "token_start": 285,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 97580,
      "end_ms": 100080,
      "text": "阿姨大饭店做的是生意，",
      "token_start": 290,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 100100,
      "end_ms": 101220,
      "text": "您这做的是暖意，",
      "token_start": 300,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 101720,
      "end_ms": 104820,
      "text": "这老母鸡一尝就是文火慢炖出来的本味儿，",
      "token_start": 307,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 104940,
      "end_ms": 106180,
      "text": "香气全在汤里，",
      "token_start": 325,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 107060,
      "end_ms": 108700,
      "text": "平时在外面净吃外卖，",
      "token_start": 331,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 109140,
      "end_ms": 110620,
      "text": "好久没喝到这么地道，",
      "token_start": 340,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 110620,
      "end_ms": 111820,
      "text": "又有锅气的好汤了，",
      "token_start": 349,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 113320,
      "end_ms": 115820,
      "text": "喜欢就多喝点小苏啊。",
      "token_start": 357,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 116000,
      "end_ms": 116300,
      "text": "阿姨，",
      "token_start": 366,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 116300,
      "end_ms": 117000,
      "text": "问你个问题，",
      "token_start": 368,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 117260,
      "end_ms": 118680,
      "text": "要是哪后你和周凯成的家，",
      "token_start": 373,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 119040,
      "end_ms": 120600,
      "text": "万一哪天我跟你闹了意见，",
      "token_start": 384,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 120660,
      "end_ms": 122005,
      "text": "你觉得周凯应该帮谁？",
      "token_start": 395,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 124230,
      "end_ms": 124765,
      "text": "阿姨，",
      "token_start": 404,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 126090,
      "end_ms": 127650,
      "text": "有您这么通情达理的长辈，",
      "token_start": 406,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 127950,
      "end_ms": 129765,
      "text": "我们哪舍得跟您闹意见呀？",
      "token_start": 417,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 130250,
      "end_ms": 131130,
      "text": "真要碰上想法，",
      "token_start": 428,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 131130,
      "end_ms": 132010,
      "text": "不一样的时候，",
      "token_start": 434,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 132150,
      "end_ms": 133485,
      "text": "谁有理就听谁的。",
      "token_start": 440,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 133830,
      "end_ms": 136050,
      "text": "您走过的路比我们吃过的盐都多，",
      "token_start": 447,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 136170,
      "end_ms": 137670,
      "text": "肯定是周凯先反省自己，",
      "token_start": 461,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 137670,
      "end_ms": 138465,
      "text": "尊重长辈，",
      "token_start": 471,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 139070,
      "end_ms": 140915,
      "text": "但要真是我年轻考虑不周，",
      "token_start": 475,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 141490,
      "end_ms": 142570,
      "text": "您随时敲打我，",
      "token_start": 486,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 142710,
      "end_ms": 143965,
      "text": "我心里只有感激，",
      "token_start": 492,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 145520,
      "end_ms": 147975,
      "text": "对这孩子太明事理了。",
      "token_start": 499,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 148840,
      "end_ms": 149435,
      "text": "苏晴，",
      "token_start": 508,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 149970,
      "end_ms": 151115,
      "text": "我现在是真服你了，",
      "token_start": 510,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 151480,
      "end_ms": 151935,
      "text": "怎么了？",
      "token_start": 518,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 152340,
      "end_ms": 154500,
      "text": "我妈说这老小区没电梯，",
      "token_start": 521,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 154580,
      "end_ms": 157465,
      "text": "楼道旧你一句话就夸得他喜笑颜开。",
      "token_start": 531,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 158110,
      "end_ms": 158670,
      "text": "吃饭时，",
      "token_start": 546,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 158670,
      "end_ms": 159250,
      "text": "他不自信，",
      "token_start": 549,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 159310,
      "end_ms": 160630,
      "text": "说鸡汤做油了没，",
      "token_start": 553,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 160630,
      "end_ms": 161575,
      "text": "外面大饭店好吃，",
      "token_start": 560,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 161950,
      "end_ms": 162510,
      "text": "换成我，",
      "token_start": 567,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 162510,
      "end_ms": 163465,
      "text": "我都不知道怎么接。",
      "token_start": 570,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 163820,
      "end_ms": 164780,
      "text": "后面他又突然问，",
      "token_start": 578,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 164780,
      "end_ms": 165700,
      "text": "你闹矛盾了，",
      "token_start": 585,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 165700,
      "end_ms": 166505,
      "text": "我该帮谁？",
      "token_start": 590,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 167020,
      "end_ms": 168885,
      "text": "我坐旁边听着都替你捏把汗，",
      "token_start": 594,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 169990,
      "end_ms": 171115,
      "text": "你到底是怎么练的？",
      "token_start": 606,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 171590,
      "end_ms": 173070,
      "text": "为什么别人突然给你一句话，",
      "token_start": 614,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 173210,
      "end_ms": 174705,
      "text": "你马上就知道该怎么接？",
      "token_start": 626,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 175060,
      "end_ms": 176385,
      "text": "其实我以前跟你一样，",
      "token_start": 636,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 176720,
      "end_ms": 177675,
      "text": "不爱说话，",
      "token_start": 645,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 178350,
      "end_ms": 179955,
      "text": "也不知道怎么组织语言，",
      "token_start": 649,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 180310,
      "end_ms": 182805,
      "text": "一到这种场合就不知道应该说什么。",
      "token_start": 659,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 183800,
      "end_ms": 187685,
      "text": "后来我就经常看这本把话说的恰到好处哦，",
      "token_start": 674,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 188000,
      "end_ms": 189340,
      "text": "它里面就是一个场景，",
      "token_start": 692,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 189340,
      "end_ms": 190480,
      "text": "一个场景的告诉你，",
      "token_start": 701,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 190540,
      "end_ms": 193075,
      "text": "遇到不同的人不同的话应该怎么接。",
      "token_start": 709,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 193700,
      "end_ms": 195215,
      "text": "比如别人夸你优秀，",
      "token_start": 724,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 195600,
      "end_ms": 196345,
      "text": "你可以回，",
      "token_start": 732,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 197130,
      "end_ms": 198370,
      "text": "那是不优秀点儿，",
      "token_start": 736,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 198370,
      "end_ms": 199750,
      "text": "怎么能和你做朋友呢？",
      "token_start": 743,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 199790,
      "end_ms": 201170,
      "text": "当别人说你真聪明，",
      "token_start": 752,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 201170,
      "end_ms": 202800,
      "text": "你就回近朱者赤，",
      "token_start": 760,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 202900,
      "end_ms": 203820,
      "text": "和你在一起啊，",
      "token_start": 767,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 203820,
      "end_ms": 206120,
      "text": "熏都熏出来了当领导跟你说，",
      "token_start": 773,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 206120,
      "end_ms": 206720,
      "text": "辛苦了，",
      "token_start": 785,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 206720,
      "end_ms": 207985,
      "text": "你就回领导，",
      "token_start": 788,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 208320,
      "end_ms": 209545,
      "text": "这都是我应该做的。",
      "token_start": 793,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 209780,
      "end_ms": 211000,
      "text": "强将手下无弱兵，",
      "token_start": 801,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 211060,
      "end_ms": 212365,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 808,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 212810,
      "end_ms": 214575,
      "text": "难怪你每次都能接的这么快，",
      "token_start": 817,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 215360,
      "end_ms": 216885,
      "text": "这种东西不是天生的，",
      "token_start": 829,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 217190,
      "end_ms": 218510,
      "text": "就是平时一个场景，",
      "token_start": 838,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 218510,
      "end_ms": 219455,
      "text": "一个场景的看，",
      "token_start": 846,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 219760,
      "end_ms": 220340,
      "text": "一个场景，",
      "token_start": 852,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 220340,
      "end_ms": 221135,
      "text": "一个场景的练。",
      "token_start": 856,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 221430,
      "end_ms": 222405,
      "text": "每天看两页，",
      "token_start": 862,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 222790,
      "end_ms": 224710,
      "text": "慢慢积累一些不同场景之下，",
      "token_start": 867,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 224730,
      "end_ms": 225410,
      "text": "应该怎么说？",
      "token_start": 879,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 225770,
      "end_ms": 227725,
      "text": "这里面还有很多生活里的场景，",
      "token_start": 884,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 228100,
      "end_ms": 229520,
      "text": "比如对象给你发红包，",
      "token_start": 897,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 229580,
      "end_ms": 232655,
      "text": "你可以回你是我致富道路上最大的功臣。",
      "token_start": 906,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 233090,
      "end_ms": 234230,
      "text": "同事向你借钱，",
      "token_start": 923,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 234490,
      "end_ms": 235230,
      "text": "你又不想借，",
      "token_start": 929,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 235350,
      "end_ms": 235925,
      "text": "可以回，",
      "token_start": 934,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 236290,
      "end_ms": 237610,
      "text": "大家都是一样的年纪，",
      "token_start": 937,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 237610,
      "end_ms": 238210,
      "text": "你没有的，",
      "token_start": 946,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 238210,
      "end_ms": 238965,
      "text": "我能有吗？",
      "token_start": 950,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 239280,
      "end_ms": 241500,
      "text": "还有心仪的人跟你说我想你了，",
      "token_start": 954,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 241560,
      "end_ms": 243155,
      "text": "你可以回随便想，",
      "token_start": 967,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 243430,
      "end_ms": 244690,
      "text": "千万别跟我客气，",
      "token_start": 974,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 244790,
      "end_ms": 245715,
      "text": "目前不收费。",
      "token_start": 981,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 246450,
      "end_ms": 247805,
      "text": "哈哈这个有意思。",
      "token_start": 986,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 248230,
      "end_ms": 249630,
      "text": "我第一次读到这些的时候，",
      "token_start": 993,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 249630,
      "end_ms": 251115,
      "text": "也有种豁然开朗的感觉。",
      "token_start": 1004,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 251580,
      "end_ms": 254975,
      "text": "这本书就是把工作、生活和人际交往里经常遇到的场景，",
      "token_start": 1014,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 255260,
      "end_ms": 256705,
      "text": "一个一个拆开给你看，",
      "token_start": 1037,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 257300,
      "end_ms": 258040,
      "text": "别人怎么说，",
      "token_start": 1046,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 258100,
      "end_ms": 258795,
      "text": "你可以怎么接，",
      "token_start": 1051,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 259130,
      "end_ms": 260355,
      "text": "都是一句句给你举例。",
      "token_start": 1057,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 261240,
      "end_ms": 263680,
      "text": "所以你平时就是这么练的对啊，",
      "token_start": 1066,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 264030,
      "end_ms": 265815,
      "text": "每天不用看很多看两页，",
      "token_start": 1079,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 266070,
      "end_ms": 269430,
      "text": "碰到自己觉得有用的表达就记一记慢慢积累的多了。",
      "token_start": 1089,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 269510,
      "end_ms": 271570,
      "text": "工作和生活里再碰到类似的场景，",
      "token_start": 1111,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 271570,
      "end_ms": 272605,
      "text": "你就知道怎么接了。",
      "token_start": 1125,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 274570,
      "end_ms": 275505,
      "text": "这本先借我看看，",
      "token_start": 1133,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 275870,
      "end_ms": 276445,
      "text": "拿去吧，",
      "token_start": 1140,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 276840,
      "end_ms": 277665,
      "text": "回去慢慢看。",
      "token_start": 1143,
      "token_end_exclusive": 1148
    }
