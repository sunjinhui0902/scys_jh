{
  "video_id": "v_8b46188e8a3e2826",
  "duration_s": 364.53,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_8b46188e8a3e2826.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_8b46188e8a3e2826.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 330,
      "end_ms": 730,
      "text": "经理，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 910,
      "end_ms": 2150,
      "text": "这个钱我取回来了，",
      "token_start": 2,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2430,
      "end_ms": 4370,
      "text": "来芳芳给我装这个包里，",
      "token_start": 10,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4410,
      "end_ms": 5450,
      "text": "咱给李总送过去，",
      "token_start": 20,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 5690,
      "end_ms": 7070,
      "text": "人家给咱介绍了个好活，",
      "token_start": 27,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 7130,
      "end_ms": 8049,
      "text": "咱也得懂规矩，",
      "token_start": 37,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 8129,
      "end_ms": 9250,
      "text": "中间人这份不能少。",
      "token_start": 43,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 9350,
      "end_ms": 9590,
      "text": "哎，",
      "token_start": 51,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 9610,
      "end_ms": 9850,
      "text": "好，",
      "token_start": 52,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 11410,
      "end_ms": 12850,
      "text": "李总给我打来电话了。",
      "token_start": 53,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 13630,
      "end_ms": 13870,
      "text": "喂，",
      "token_start": 62,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 13930,
      "end_ms": 18710,
      "text": "李总正准备出发去你那儿呢哦换个地方去饭店见面，",
      "token_start": 63,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 19130,
      "end_ms": 20090,
      "text": "是有什么安排吗？",
      "token_start": 85,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 20150,
      "end_ms": 20630,
      "text": "哎呀，",
      "token_start": 92,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 20910,
      "end_ms": 21830,
      "text": "别管那么多了，",
      "token_start": 94,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 21830,
      "end_ms": 22730,
      "text": "你赶紧过来吧，",
      "token_start": 100,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 23410,
      "end_ms": 24210,
      "text": "再晚一会儿，",
      "token_start": 106,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 24210,
      "end_ms": 26055,
      "text": "你连吃屎都赶不上热的了。",
      "token_start": 111,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 28020,
      "end_ms": 28260,
      "text": "哎，",
      "token_start": 122,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 28260,
      "end_ms": 28500,
      "text": "好，",
      "token_start": 123,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 30000,
      "end_ms": 30660,
      "text": "咋回事啊？",
      "token_start": 124,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 30660,
      "end_ms": 33380,
      "text": "经理理总那边应该是有什么事儿了，",
      "token_start": 128,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 33820,
      "end_ms": 36520,
      "text": "但是又不能明说咱们走吧，",
      "token_start": 143,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 36520,
      "end_ms": 39940,
      "text": "随机应变这个事儿。",
      "token_start": 154,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 39940,
      "end_ms": 41020,
      "text": "李总，",
      "token_start": 162,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 41020,
      "end_ms": 41500,
      "text": "哎呀，",
      "token_start": 164,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 41500,
      "end_ms": 43080,
      "text": "宋经理来来来赶紧做，",
      "token_start": 166,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 43240,
      "end_ms": 43680,
      "text": "哎呀，",
      "token_start": 175,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 43880,
      "end_ms": 45460,
      "text": "人家都是千里送鹅毛，",
      "token_start": 177,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 45540,
      "end_ms": 46540,
      "text": "礼轻情意重，",
      "token_start": 186,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 46660,
      "end_ms": 49060,
      "text": "你这是鸡毛都不带一根就跑过来了。",
      "token_start": 191,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 49620,
      "end_ms": 51340,
      "text": "今天要不是看在赵总的面子，",
      "token_start": 206,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 51560,
      "end_ms": 52920,
      "text": "你一口菜你都倒不上，",
      "token_start": 218,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 53380,
      "end_ms": 54720,
      "text": "往后还能不能继续占？",
      "token_start": 227,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 54720,
      "end_ms": 55480,
      "text": "赵总的便宜，",
      "token_start": 236,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 55720,
      "end_ms": 57545,
      "text": "可全看你今天的表现了啊。",
      "token_start": 241,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 57910,
      "end_ms": 58490,
      "text": "李总啊，",
      "token_start": 252,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 58830,
      "end_ms": 61035,
      "text": "那咱也不能奔着占赵总便宜去啊，",
      "token_start": 255,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 61380,
      "end_ms": 62975,
      "text": "咱得先做一个有用的人。",
      "token_start": 269,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 63360,
      "end_ms": 63900,
      "text": "不好意思啊，",
      "token_start": 279,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 63900,
      "end_ms": 64220,
      "text": "赵总，",
      "token_start": 284,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 64420,
      "end_ms": 65275,
      "text": "我这来迟了，",
      "token_start": 286,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 65620,
      "end_ms": 66735,
      "text": "我先来个入场酒，",
      "token_start": 291,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 72950,
      "end_ms": 73885,
      "text": "咋不吭声了？",
      "token_start": 298,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 74380,
      "end_ms": 79970,
      "text": "找我啥事儿说呀啊您上次不是给我介绍了一个好活吗？",
      "token_start": 303,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 80130,
      "end_ms": 80995,
      "text": "已经结束了，",
      "token_start": 326,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 81290,
      "end_ms": 82570,
      "text": "我来给您汇报一下工作，",
      "token_start": 331,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 82850,
      "end_ms": 84415,
      "text": "要不您和赵总先谈，",
      "token_start": 341,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 85260,
      "end_ms": 86445,
      "text": "我看烟快抽完了，",
      "token_start": 349,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 87000,
      "end_ms": 88145,
      "text": "我去车里拿两包烟。",
      "token_start": 356,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 88700,
      "end_ms": 89695,
      "text": "你别急歪了，",
      "token_start": 364,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 90240,
      "end_ms": 91240,
      "text": "有话赶紧的吧，",
      "token_start": 369,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 91240,
      "end_ms": 92000,
      "text": "都不是外人。",
      "token_start": 375,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 92220,
      "end_ms": 92845,
      "text": "李总啊，",
      "token_start": 380,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 93190,
      "end_ms": 94705,
      "text": "您能给我一个表现的机会，",
      "token_start": 383,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 95020,
      "end_ms": 96735,
      "text": "让我在不同的圈子里面立名，",
      "token_start": 394,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 97130,
      "end_ms": 98030,
      "text": "结识不同的人脉。",
      "token_start": 406,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 98110,
      "end_ms": 98935,
      "text": "我感激不尽，",
      "token_start": 413,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 99450,
      "end_ms": 101845,
      "text": "这次啊我把咱下次项目的备用金带来了，",
      "token_start": 418,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 103330,
      "end_ms": 105135,
      "text": "这下次的项目还没影呢。",
      "token_start": 435,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 105540,
      "end_ms": 106025,
      "text": "老弟，",
      "token_start": 445,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 106710,
      "end_ms": 107985,
      "text": "你就先站住了，",
      "token_start": 447,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 110080,
      "end_ms": 112045,
      "text": "今人是听天命。",
      "token_start": 453,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 112670,
      "end_ms": 113255,
      "text": "赵总啊，",
      "token_start": 459,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 113690,
      "end_ms": 115135,
      "text": "这宋经理啥都好，",
      "token_start": 462,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 115520,
      "end_ms": 116815,
      "text": "就是胆小重规矩，",
      "token_start": 469,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 117390,
      "end_ms": 118110,
      "text": "你不让他吃，",
      "token_start": 476,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 118350,
      "end_ms": 119175,
      "text": "他就是饿死，",
      "token_start": 481,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 119400,
      "end_ms": 120655,
      "text": "都不会主动伸筷子，",
      "token_start": 486,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 121190,
      "end_ms": 122195,
      "text": "咱给它夹个菜吧。",
      "token_start": 494,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 122680,
      "end_ms": 123515,
      "text": "宋老弟可以，",
      "token_start": 501,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 123890,
      "end_ms": 124495,
      "text": "李总先请，",
      "token_start": 506,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 126620,
      "end_ms": 126780,
      "text": "哎，",
      "token_start": 510,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 126780,
      "end_ms": 127940,
      "text": "呦呦受宠若惊啊，",
      "token_start": 511,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 127940,
      "end_ms": 128425,
      "text": "李总。",
      "token_start": 518,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 129070,
      "end_ms": 129370,
      "text": "哎呀，",
      "token_start": 520,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 129370,
      "end_ms": 130225,
      "text": "赵总哎呀，",
      "token_start": 522,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 130650,
      "end_ms": 131205,
      "text": "赵总啊，",
      "token_start": 526,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 131760,
      "end_ms": 133695,
      "text": "今天这个鱼吃的怎么样？",
      "token_start": 529,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 134080,
      "end_ms": 134440,
      "text": "不错，",
      "token_start": 539,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 134620,
      "end_ms": 135055,
      "text": "可以，",
      "token_start": 541,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 135680,
      "end_ms": 137365,
      "text": "宋经理啊跑个腿儿，",
      "token_start": 543,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 137760,
      "end_ms": 138820,
      "text": "把这鱼打包一份，",
      "token_start": 551,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 138820,
      "end_ms": 140415,
      "text": "送赵总车里去就在楼下，",
      "token_start": 558,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 141850,
      "end_ms": 143315,
      "text": "那李总，",
      "token_start": 568,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 143840,
      "end_ms": 145355,
      "text": "我送完鱼就直接回去了。",
      "token_start": 571,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 145680,
      "end_ms": 147100,
      "text": "今天打扰两位哥哥，",
      "token_start": 581,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 147100,
      "end_ms": 148285,
      "text": "雅兴海岸，",
      "token_start": 589,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 148650,
      "end_ms": 149290,
      "text": "下次补过。",
      "token_start": 593,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 149330,
      "end_ms": 149570,
      "text": "哎，",
      "token_start": 597,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 149650,
      "end_ms": 150385,
      "text": "去吧去吧，",
      "token_start": 598,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 150710,
      "end_ms": 151095,
      "text": "经理，",
      "token_start": 602,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 151450,
      "end_ms": 151950,
      "text": "那个鱼，",
      "token_start": 604,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 152070,
      "end_ms": 152865,
      "text": "我去打包吧，",
      "token_start": 607,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 153350,
      "end_ms": 154530,
      "text": "听不懂弦外之音呢，",
      "token_start": 612,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 154530,
      "end_ms": 157695,
      "text": "芳芳把后备箱内箱好酒给赵总放车上去。",
      "token_start": 620,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 158400,
      "end_ms": 158895,
      "text": "哦，",
      "token_start": 637,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 160660,
      "end_ms": 161175,
      "text": "经理，",
      "token_start": 638,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 161550,
      "end_ms": 163270,
      "text": "我还是不明白那个鱼，",
      "token_start": 640,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 163470,
      "end_ms": 168020,
      "text": "那个鱼喂，",
      "token_start": 649,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 168080,
      "end_ms": 170080,
      "text": "李总哦，",
      "token_start": 653,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 170340,
      "end_ms": 171485,
      "text": "明天晚上和赵总，",
      "token_start": 656,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 171930,
      "end_ms": 172170,
      "text": "哎，",
      "token_start": 663,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 172190,
      "end_ms": 172775,
      "text": "好好好，",
      "token_start": 664,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 173080,
      "end_ms": 173835,
      "text": "感谢哥哥，",
      "token_start": 667,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 174140,
      "end_ms": 175000,
      "text": "这到底咋回事啊？",
      "token_start": 671,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 175000,
      "end_ms": 176300,
      "text": "经理李总说，",
      "token_start": 678,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 176300,
      "end_ms": 178940,
      "text": "赵总有个项目想跟我谈约我明天晚上见面，",
      "token_start": 683,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 179060,
      "end_ms": 180595,
      "text": "看来今天啊是过关了。",
      "token_start": 701,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 181060,
      "end_ms": 182080,
      "text": "李总真是太好了，",
      "token_start": 710,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 182080,
      "end_ms": 182720,
      "text": "看似粗鲁，",
      "token_start": 717,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 182720,
      "end_ms": 184165,
      "text": "实则一直在帮我们说话。",
      "token_start": 721,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 184650,
      "end_ms": 185170,
      "text": "经理，",
      "token_start": 731,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 185430,
      "end_ms": 187030,
      "text": "你这样显得我很呆呀，",
      "token_start": 733,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 187090,
      "end_ms": 187750,
      "text": "到底咋回事啊？",
      "token_start": 742,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 187750,
      "end_ms": 189980,
      "text": "今天我把今天的话给你翻译，",
      "token_start": 748,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 189980,
      "end_ms": 190705,
      "text": "翻译就懂了，",
      "token_start": 760,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 190990,
      "end_ms": 192765,
      "text": "咱们说好的去公司找李总，",
      "token_start": 765,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 193050,
      "end_ms": 194850,
      "text": "再然后呢又让赶到去饭店。",
      "token_start": 776,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 194990,
      "end_ms": 196930,
      "text": "这八成啊是赵总有项目，",
      "token_start": 787,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 197070,
      "end_ms": 198590,
      "text": "李总给赵总推荐了咱，",
      "token_start": 797,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 198730,
      "end_ms": 200450,
      "text": "但赵总啊想眼见为实，",
      "token_start": 806,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 200610,
      "end_ms": 203275,
      "text": "于是啊李总临时安排了在饭店见面，",
      "token_start": 815,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 203630,
      "end_ms": 205915,
      "text": "就是想让赵总看看咱是怎么表现的。",
      "token_start": 830,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 206340,
      "end_ms": 206580,
      "text": "哦，",
      "token_start": 845,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 207560,
      "end_ms": 209260,
      "text": "我说怎么换地方了？",
      "token_start": 846,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 209440,
      "end_ms": 210075,
      "text": "然后呢，",
      "token_start": 854,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 210410,
      "end_ms": 211130,
      "text": "然后一见面，",
      "token_start": 857,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 211130,
      "end_ms": 213970,
      "text": "李总就说鸡毛都不带一根儿就跑来了，",
      "token_start": 862,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 214070,
      "end_ms": 216170,
      "text": "完全不是他以前那种稳重的风格。",
      "token_start": 878,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 216330,
      "end_ms": 219990,
      "text": "对我啊更像是关系非常好的兄弟一样口无遮拦，",
      "token_start": 892,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 220270,
      "end_ms": 222210,
      "text": "就是想借这种方式告诉赵总，",
      "token_start": 912,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 222290,
      "end_ms": 223930,
      "text": "他和咱们的关系非常近。",
      "token_start": 924,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 224190,
      "end_ms": 227375,
      "text": "怪不得李总今天说话这么的鸡毛。",
      "token_start": 934,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 227810,
      "end_ms": 231425,
      "text": "再然后呢再然后李总让我直接说这次项目的事儿，",
      "token_start": 948,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 231590,
      "end_ms": 233250,
      "text": "就是想让赵总看看我的表现，",
      "token_start": 969,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 233610,
      "end_ms": 235085,
      "text": "而且也是想告诉赵总，",
      "token_start": 981,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 235300,
      "end_ms": 236700,
      "text": "他自己也在跟我合作，",
      "token_start": 990,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 236840,
      "end_ms": 237980,
      "text": "让赵总对我放心。",
      "token_start": 999,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 238280,
      "end_ms": 241665,
      "text": "怪不得呢这按说这事儿都是私底下讲的。",
      "token_start": 1006,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 242160,
      "end_ms": 244720,
      "text": "再然后呢再然后啊李总我啥都好，",
      "token_start": 1023,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 244860,
      "end_ms": 246260,
      "text": "就是胆小重规矩，",
      "token_start": 1037,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 246340,
      "end_ms": 247460,
      "text": "别人不说让我吃，",
      "token_start": 1044,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 247600,
      "end_ms": 249415,
      "text": "我饿死都不会主动伸筷子。",
      "token_start": 1051,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 249670,
      "end_ms": 251775,
      "text": "这句话的潜台词就是告诉赵总，",
      "token_start": 1062,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 252050,
      "end_ms": 252770,
      "text": "别人给了我，",
      "token_start": 1075,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 252770,
      "end_ms": 254290,
      "text": "就要别人不给我，",
      "token_start": 1080,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 254290,
      "end_ms": 255550,
      "text": "绝对不会主动伸手，",
      "token_start": 1087,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 255710,
      "end_ms": 257250,
      "text": "说明我是一个做事的人，",
      "token_start": 1095,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 257250,
      "end_ms": 258345,
      "text": "不是爱钱的人。",
      "token_start": 1105,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 258670,
      "end_ms": 258910,
      "text": "哇。",
      "token_start": 1111,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 259170,
      "end_ms": 260425,
      "text": "这这么多道道啊，",
      "token_start": 1112,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 260870,
      "end_ms": 264945,
      "text": "那那那个鱼李总给我加了一块鱼腹部的肉，",
      "token_start": 1119,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 265220,
      "end_ms": 266400,
      "text": "这叫推心置腹。",
      "token_start": 1137,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 266740,
      "end_ms": 269035,
      "text": "而且有了李总帮我做了这么多的铺垫，",
      "token_start": 1143,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 269320,
      "end_ms": 271140,
      "text": "赵总呢就给我加了一颗鱼眼，",
      "token_start": 1159,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 271360,
      "end_ms": 272555,
      "text": "这叫高看一眼。",
      "token_start": 1171,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 272880,
      "end_ms": 274340,
      "text": "所以李总最后问赵总，",
      "token_start": 1177,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 274540,
      "end_ms": 276120,
      "text": "今天这鱼吃着怎么样？",
      "token_start": 1186,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 276220,
      "end_ms": 277740,
      "text": "就是想让赵总表个态，",
      "token_start": 1195,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 278080,
      "end_ms": 279640,
      "text": "如果赵总说不好吃，",
      "token_start": 1204,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 279920,
      "end_ms": 281500,
      "text": "那就说明赵总的项目啊，",
      "token_start": 1212,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 281500,
      "end_ms": 282525,
      "text": "咱们没机会了。",
      "token_start": 1222,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 282900,
      "end_ms": 284100,
      "text": "如果赵总说好吃，",
      "token_start": 1228,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 284240,
      "end_ms": 289280,
      "text": "那李总啊就会借着让咱给赵总往车上送鱼的噱头表示一下。",
      "token_start": 1235,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 289380,
      "end_ms": 291060,
      "text": "所以啊打包鱼是假的，",
      "token_start": 1260,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 291100,
      "end_ms": 292255,
      "text": "表示才是真的。",
      "token_start": 1269,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 292610,
      "end_ms": 294110,
      "text": "甲方愿意给咱机会了，",
      "token_start": 1275,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 294110,
      "end_ms": 295790,
      "text": "作为乙方必须要表示啊。",
      "token_start": 1284,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 295870,
      "end_ms": 299465,
      "text": "所以我让你把我车里那箱好酒给赵总送车上去了。",
      "token_start": 1294,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 299790,
      "end_ms": 301830,
      "text": "话能听懂又能接住事儿，",
      "token_start": 1315,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 301830,
      "end_ms": 302490,
      "text": "还能做对，",
      "token_start": 1325,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 302490,
      "end_ms": 303790,
      "text": "那机会自然就成了，",
      "token_start": 1329,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 303790,
      "end_ms": 304295,
      "text": "不是吗？",
      "token_start": 1337,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 304750,
      "end_ms": 305630,
      "text": "我的天哪，",
      "token_start": 1340,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 305950,
      "end_ms": 307190,
      "text": "这么多弦外之音，",
      "token_start": 1344,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 307190,
      "end_ms": 308510,
      "text": "你是怎么听明白的？",
      "token_start": 1351,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 308510,
      "end_ms": 309810,
      "text": "经理教教我呗。",
      "token_start": 1359,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 309990,
      "end_ms": 311010,
      "text": "鸟欲高飞仙，",
      "token_start": 1365,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 311010,
      "end_ms": 311850,
      "text": "振翅人，",
      "token_start": 1370,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 311850,
      "end_ms": 312990,
      "text": "求上尽多读书。",
      "token_start": 1373,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 313210,
      "end_ms": 314530,
      "text": "我给你推荐本书吧，",
      "token_start": 1379,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 314670,
      "end_ms": 315070,
      "text": "小芳，",
      "token_start": 1387,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 315350,
      "end_ms": 318610,
      "text": "就是这本我最近在反复看的这本书啊，",
      "token_start": 1389,
      "token_end_exclusive": 1405
    },
    {
      "start_ms": 318730,
      "end_ms": 321710,
      "text": "教你在不同的场合下怎么审时度势，",
      "token_start": 1405,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 321890,
      "end_ms": 322490,
      "text": "会接话，",
      "token_start": 1420,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 322670,
      "end_ms": 323690,
      "text": "会精准表达，",
      "token_start": 1423,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 323970,
      "end_ms": 325970,
      "text": "掌握倾听与接话的艺术。",
      "token_start": 1428,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 326290,
      "end_ms": 328710,
      "text": "这里面啊包含了六十一种口才技巧，",
      "token_start": 1438,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 328970,
      "end_ms": 333450,
      "text": "每一篇都是以案例加方法的形式来教我们实用的表达术。",
      "token_start": 1453,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 333730,
      "end_ms": 334700,
      "text": "不仅能教会我，",
      "token_start": 1477,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 334700,
      "end_ms": 335960,
      "text": "我们听懂外外音，",
      "token_start": 1483,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 336360,
      "end_ms": 338900,
      "text": "还能教我们精准的把话说到点子上，",
      "token_start": 1490,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 339160,
      "end_ms": 342500,
      "text": "从而啊游刃有余的应对不同的人和场合，",
      "token_start": 1505,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 342740,
      "end_ms": 345060,
      "text": "耳才和口才都是成功的标配，",
      "token_start": 1522,
      "token_end_exclusive": 1534
    },
    {
      "start_ms": 345300,
      "end_ms": 347280,
      "text": "是改善人际关系的一把利器。",
      "token_start": 1534,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 347500,
      "end_ms": 351180,
      "text": "尤其是跟客户、领导、老板等高水平的人对话，",
      "token_start": 1546,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 351540,
      "end_ms": 353700,
      "text": "一定要学会把话说到刀刃上。",
      "token_start": 1564,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 353940,
      "end_ms": 354880,
      "text": "唯有如此啊，",
      "token_start": 1576,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 354880,
      "end_ms": 356680,
      "text": "才能让我们得到更多的机会，",
      "token_start": 1581,
      "token_end_exclusive": 1593
    },
    {
      "start_ms": 356860,
      "end_ms": 358060,
      "text": "见识更多的贵人，",
      "token_start": 1593,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 358260,
      "end_ms": 359740,
      "text": "从而走向更高的位置，",
      "token_start": 1600,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 359840,
      "end_ms": 361060,
      "text": "获得更高的财富。",
      "token_start": 1609,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 361320,
      "end_ms": 362080,
      "text": "这些书啊，",
      "token_start": 1616,
      "token_end_exclusive": 1620
    },
    {
      "start_ms": 362080,
      "end_ms": 363820,
      "text": "我都放在左下方链接了，",
      "token_start": 1620,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 363840,
      "end_ms": 364415,
      "text": "快去拍吧。",
      "token_start": 1630,
      "token_end_exclusive": 1634
    }
  ],
