{
  "video_id": "v_0b4fe2503841c930",
  "duration_s": 460.758621,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_0b4fe2503841c930.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_0b4fe2503841c930.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1530,
      "text": "隐姓埋名三十年，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1790,
      "end_ms": 8070,
      "text": "女儿喊他叔叔这个失踪的男人造出了核潜艇家人们。",
      "token_start": 7,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 8310,
      "end_ms": 11950,
      "text": "今天讲一个失踪了三十年的男人，",
      "token_start": 29,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 12990,
      "end_ms": 14590,
      "text": "他消失到什么程度，",
      "token_start": 43,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 14970,
      "end_ms": 16129,
      "text": "常年不着家，",
      "token_start": 51,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 16770,
      "end_ms": 20210,
      "text": "不能跟任何人说自己在哪在干啥。",
      "token_start": 56,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 21290,
      "end_ms": 23070,
      "text": "有一次好不容易回趟家，",
      "token_start": 70,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 23830,
      "end_ms": 26310,
      "text": "年幼的女儿已经不认识他了。",
      "token_start": 80,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 27110,
      "end_ms": 28770,
      "text": "怯生生的问了一句，",
      "token_start": 92,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 29330,
      "end_ms": 29790,
      "text": "叔叔，",
      "token_start": 100,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 30280,
      "end_ms": 30960,
      "text": "你是谁？",
      "token_start": 102,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 31360,
      "end_ms": 33280,
      "text": "你听听亲闺女，",
      "token_start": 105,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 33520,
      "end_ms": 34960,
      "text": "管亲爹叫叔叔。",
      "token_start": 111,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 35380,
      "end_ms": 36040,
      "text": "那一刻，",
      "token_start": 117,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 36060,
      "end_ms": 37780,
      "text": "这个在核反应堆面前，",
      "token_start": 120,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 37800,
      "end_ms": 41740,
      "text": "眉头都不皱一下的硬汉眼泪差点掉下来。",
      "token_start": 129,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 42380,
      "end_ms": 47540,
      "text": "他叫彭时录中国核潜艇第一任总设计师他爹，",
      "token_start": 146,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 47920,
      "end_ms": 51140,
      "text": "是一九二九年高唱国际歌，",
      "token_start": 165,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 51360,
      "end_ms": 54080,
      "text": "走向刑场的革命先烈澎湃。",
      "token_start": 176,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 54560,
      "end_ms": 56100,
      "text": "他四岁成孤儿，",
      "token_start": 187,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 56380,
      "end_ms": 57660,
      "text": "八岁做大牢，",
      "token_start": 193,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 58240,
      "end_ms": 58800,
      "text": "十岁，",
      "token_start": 198,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 58820,
      "end_ms": 60710,
      "text": "拖着烂腿爬了十几公里，",
      "token_start": 200,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 60710,
      "end_ms": 61905,
      "text": "才捡回一条命。",
      "token_start": 210,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 62720,
      "end_ms": 65215,
      "text": "就这么一个从苦水里泡大的人，",
      "token_start": 216,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 65590,
      "end_ms": 67665,
      "text": "一辈子只干了两件事。",
      "token_start": 229,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 68350,
      "end_ms": 74475,
      "text": "一造核潜艇二建核电站，",
      "token_start": 238,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 75850,
      "end_ms": 79610,
      "text": "件件都是让中国挺直腰杆的大事。",
      "token_start": 248,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 79830,
      "end_ms": 80790,
      "text": "一九五六年，",
      "token_start": 262,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 81010,
      "end_ms": 84625,
      "text": "彭时路在苏联留学正打算毕业回国，",
      "token_start": 267,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 85230,
      "end_ms": 87385,
      "text": "陈赓大将把他叫到大使馆。",
      "token_start": 282,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 87860,
      "end_ms": 89115,
      "text": "开门见山的讲，",
      "token_start": 293,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 89960,
      "end_ms": 92245,
      "text": "中央决定选一批留学生，",
      "token_start": 299,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 92540,
      "end_ms": 94315,
      "text": "改行学原子能核动力，",
      "token_start": 309,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 94820,
      "end_ms": 95740,
      "text": "你愿意吗？",
      "token_start": 318,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 95820,
      "end_ms": 96775,
      "text": "他脱口而出，",
      "token_start": 322,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 97240,
      "end_ms": 97885,
      "text": "我愿意。",
      "token_start": 327,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 98590,
      "end_ms": 100350,
      "text": "只要祖国需要，",
      "token_start": 330,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 100350,
      "end_ms": 102070,
      "text": "我就这一句话，",
      "token_start": 336,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 102350,
      "end_ms": 104435,
      "text": "他的人生彻底转向，",
      "token_start": 342,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 104810,
      "end_ms": 107115,
      "text": "从此他像核潜艇一样，",
      "token_start": 350,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 107470,
      "end_ms": 109175,
      "text": "悄无声息的深浅了。",
      "token_start": 359,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 110000,
      "end_ms": 113435,
      "text": "以前就是三十年一九五八年，",
      "token_start": 367,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 113740,
      "end_ms": 116075,
      "text": "中央批准研制核潜艇，",
      "token_start": 379,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 116290,
      "end_ms": 117705,
      "text": "后来中苏关系破裂，",
      "token_start": 388,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 118370,
      "end_ms": 119010,
      "text": "苏联撤。",
      "token_start": 396,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 119010,
      "end_ms": 121050,
      "text": "总专家撂下话，",
      "token_start": 399,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 122110,
      "end_ms": 122890,
      "text": "没有我们，",
      "token_start": 405,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 124170,
      "end_ms": 125050,
      "text": "你们干不成。",
      "token_start": 409,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 126510,
      "end_ms": 127930,
      "text": "毛主席拍下一句话，",
      "token_start": 414,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 129070,
      "end_ms": 130090,
      "text": "掷地有声，",
      "token_start": 422,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 131630,
      "end_ms": 134150,
      "text": "核潜艇一万年也要搞出来，",
      "token_start": 426,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 134570,
      "end_ms": 135650,
      "text": "话说的容易，",
      "token_start": 437,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 135890,
      "end_ms": 136850,
      "text": "活却难干。",
      "token_start": 442,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 137390,
      "end_ms": 138390,
      "text": "一九六五年，",
      "token_start": 446,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 138730,
      "end_ms": 141330,
      "text": "代号久的核潜艇攻城上马，",
      "token_start": 451,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 141750,
      "end_ms": 146470,
      "text": "彭时路带着几百号人进了四川青衣江畔的深山。",
      "token_start": 462,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 147070,
      "end_ms": 151220,
      "text": "对外只说自己搞水电给家里写信，",
      "token_start": 482,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 151520,
      "end_ms": 155040,
      "text": "地址永远是成都二百九十一信向。",
      "token_start": 496,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 155220,
      "end_ms": 159160,
      "text": "连他的妻子都不知道他在干什么，",
      "token_start": 510,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 160300,
      "end_ms": 162160,
      "text": "那条件苦到啥程度，",
      "token_start": 524,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 163000,
      "end_ms": 165620,
      "text": "交通不便吃住都在工地，",
      "token_start": 532,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 166700,
      "end_ms": 168735,
      "text": "一百八十天见不到太阳，",
      "token_start": 542,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 170980,
      "end_ms": 172480,
      "text": "毒蛇蚊虫遍地，",
      "token_start": 552,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 172480,
      "end_ms": 174320,
      "text": "都是没有计算机，",
      "token_start": 558,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 174560,
      "end_ms": 175440,
      "text": "就靠算盘。",
      "token_start": 565,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 175620,
      "end_ms": 181720,
      "text": "计算尺手摇计算器三扳倒连轴算油灯拨到凌晨三点，",
      "token_start": 569,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 181940,
      "end_ms": 184024,
      "text": "算盘珠子噼里啪啦响个不停。",
      "token_start": 591,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 184520,
      "end_ms": 189435,
      "text": "十几万个核心数据硬是拿人手算了一遍又一遍，",
      "token_start": 603,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 189970,
      "end_ms": 191905,
      "text": "草稿纸堆的比人还高，",
      "token_start": 623,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 192360,
      "end_ms": 194180,
      "text": "装满三个大铁皮柜，",
      "token_start": 632,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 194340,
      "end_ms": 195535,
      "text": "粮食不够吃，",
      "token_start": 640,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 195930,
      "end_ms": 196670,
      "text": "挖野菜，",
      "token_start": 645,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 196910,
      "end_ms": 197765,
      "text": "啃菜根，",
      "token_start": 648,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 198150,
      "end_ms": 199055,
      "text": "没人喊苦。",
      "token_start": 651,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 199520,
      "end_ms": 200585,
      "text": "数据算错了，",
      "token_start": 655,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 200860,
      "end_ms": 201700,
      "text": "推倒重来，",
      "token_start": 660,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 201880,
      "end_ms": 202825,
      "text": "没人抱怨。",
      "token_start": 664,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 203670,
      "end_ms": 204555,
      "text": "有人问他，",
      "token_start": 668,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 205380,
      "end_ms": 206365,
      "text": "这么大的事儿，",
      "token_start": 672,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 206590,
      "end_ms": 209395,
      "text": "你一个人拍板不怕担责任吗？",
      "token_start": 678,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 210020,
      "end_ms": 212755,
      "text": "他说怕就不干了，",
      "token_start": 690,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 214210,
      "end_ms": 217985,
      "text": "不干中国就永远都会被人掐脖子。",
      "token_start": 697,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 219170,
      "end_ms": 219590,
      "text": "对了，",
      "token_start": 711,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 220600,
      "end_ms": 223690,
      "text": "功劳算你们的错了，",
      "token_start": 713,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 225170,
      "end_ms": 226205,
      "text": "责任算我的，",
      "token_start": 721,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 228030,
      "end_ms": 231380,
      "text": "就凭这句错了，",
      "token_start": 726,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 231380,
      "end_ms": 232305,
      "text": "责任算我的，",
      "token_start": 732,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 232780,
      "end_ms": 234235,
      "text": "大家给他起了个外号，",
      "token_start": 737,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 234620,
      "end_ms": 236725,
      "text": "叫澎拍板。",
      "token_start": 746,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 238290,
      "end_ms": 240670,
      "text": "一九七零年八月三十日，",
      "token_start": 750,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 240690,
      "end_ms": 243835,
      "text": "核潜艇反应堆首次达到满功率，",
      "token_start": 760,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 244420,
      "end_ms": 246185,
      "text": "整个深山都沸腾了，",
      "token_start": 773,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 247100,
      "end_ms": 252125,
      "text": "可总设计师彭士路已经连续五天五夜没合眼。",
      "token_start": 781,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 253250,
      "end_ms": 255035,
      "text": "消息传来的那一刻，",
      "token_start": 800,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 255500,
      "end_ms": 258225,
      "text": "他靠在墙角直接昏睡了过去。",
      "token_start": 808,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 258670,
      "end_ms": 260305,
      "text": "同年十二月二十六日，",
      "token_start": 820,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 260750,
      "end_ms": 266435,
      "text": "中国第一艘核潜艇下水四点六万个零部件全部国产，",
      "token_start": 829,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 267470,
      "end_ms": 272005,
      "text": "中国成了世界上第五个拥有核潜艇的国家。",
      "token_start": 851,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 272570,
      "end_ms": 273410,
      "text": "西方大国。",
      "token_start": 869,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 273410,
      "end_ms": 274995,
      "text": "那句再等二十年，",
      "token_start": 873,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 275450,
      "end_ms": 279580,
      "text": "被他和他的团队硬生生提前干成了。",
      "token_start": 880,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 279620,
      "end_ms": 286715,
      "text": "可这背后是拿命换来一九七四年核潜艇最后调试阶段，",
      "token_start": 895,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 287130,
      "end_ms": 288490,
      "text": "彭氏路突发，",
      "token_start": 918,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 288510,
      "end_ms": 290725,
      "text": "魏川孔倒在了工位上。",
      "token_start": 923,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 291700,
      "end_ms": 294200,
      "text": "医生切掉了他四分之三的胃，",
      "token_start": 932,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 294700,
      "end_ms": 295460,
      "text": "从那以后，",
      "token_start": 944,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 295660,
      "end_ms": 297560,
      "text": "他兜里永远揣着胃药，",
      "token_start": 948,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 297840,
      "end_ms": 299060,
      "text": "疼的厉害了，",
      "token_start": 957,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 299740,
      "end_ms": 300540,
      "text": "吞两片。",
      "token_start": 962,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 301360,
      "end_ms": 302700,
      "text": "接着往工地上跑，",
      "token_start": 965,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 303720,
      "end_ms": 304860,
      "text": "八十八岁那年，",
      "token_start": 972,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 305520,
      "end_ms": 306600,
      "text": "有记者问他，",
      "token_start": 978,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 307800,
      "end_ms": 309000,
      "text": "当年值得吗？",
      "token_start": 983,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 310080,
      "end_ms": 312460,
      "text": "他说值得搞成功了，",
      "token_start": 988,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 312640,
      "end_ms": 313540,
      "text": "特别高兴，",
      "token_start": 996,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 313800,
      "end_ms": 314620,
      "text": "就是死了，",
      "token_start": 1000,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 314760,
      "end_ms": 315820,
      "text": "也是值得的。",
      "token_start": 1004,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 316640,
      "end_ms": 321410,
      "text": "核潜艇搞成了他转身又去拓荒中国的核电。",
      "token_start": 1009,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 321730,
      "end_ms": 328470,
      "text": "大亚湾秦山中国核电站从无到有的每一步都踩着他的脚印。",
      "token_start": 1027,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 328890,
      "end_ms": 330070,
      "text": "一九八三年，",
      "token_start": 1052,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 330430,
      "end_ms": 333910,
      "text": "他任大亚湾核电站筹建总指挥，",
      "token_start": 1057,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 334650,
      "end_ms": 335290,
      "text": "那一年，",
      "token_start": 1070,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 335590,
      "end_ms": 339590,
      "text": "我国外汇储备才一点六七亿美元，",
      "token_start": 1073,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 340090,
      "end_ms": 342170,
      "text": "大亚湾要四十亿美元。",
      "token_start": 1087,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 342910,
      "end_ms": 343670,
      "text": "钱不够，",
      "token_start": 1096,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 343870,
      "end_ms": 346830,
      "text": "他四处奔波筹资人才，",
      "token_start": 1099,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 346850,
      "end_ms": 349050,
      "text": "没有他一点点带。",
      "token_start": 1108,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 349950,
      "end_ms": 350450,
      "text": "后来，",
      "token_start": 1115,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 350450,
      "end_ms": 353165,
      "text": "他又任秦张二期核电站董事长，",
      "token_start": 1117,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 353920,
      "end_ms": 356485,
      "text": "从主要参数到投资方案，",
      "token_start": 1130,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 356930,
      "end_ms": 357965,
      "text": "大到反应堆，",
      "token_start": 1140,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 358300,
      "end_ms": 359580,
      "text": "小到一颗螺丝钉，",
      "token_start": 1145,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 359700,
      "end_ms": 360975,
      "text": "他都心中有数。",
      "token_start": 1152,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 361470,
      "end_ms": 366170,
      "text": "二零一七年九十二岁的他拿到一百万港币的科技大奖，",
      "token_start": 1158,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 366250,
      "end_ms": 368005,
      "text": "一分钱没往家里拿，",
      "token_start": 1181,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 368370,
      "end_ms": 369905,
      "text": "权数捐给了国家，",
      "token_start": 1189,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 370250,
      "end_ms": 372445,
      "text": "用来资助核工业的年轻人。",
      "token_start": 1196,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 373500,
      "end_ms": 374655,
      "text": "女儿跟他开玩笑，",
      "token_start": 1207,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 375610,
      "end_ms": 376685,
      "text": "留点给自己嘛，",
      "token_start": 1214,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 377560,
      "end_ms": 378445,
      "text": "他板起脸，",
      "token_start": 1220,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 379630,
      "end_ms": 380865,
      "text": "这钱是国家的，",
      "token_start": 1224,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 381360,
      "end_ms": 382545,
      "text": "我一分都不能动。",
      "token_start": 1230,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 383720,
      "end_ms": 385100,
      "text": "二零二一年三月，",
      "token_start": 1237,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 385100,
      "end_ms": 387464,
      "text": "九十六岁的彭时路在北京离世。",
      "token_start": 1244,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 388240,
      "end_ms": 390660,
      "text": "他的遗嘱里没有半句，",
      "token_start": 1257,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 390740,
      "end_ms": 391235,
      "text": "家事，",
      "token_start": 1266,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 391570,
      "end_ms": 392695,
      "text": "只有一个心愿，",
      "token_start": 1268,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 393560,
      "end_ms": 395405,
      "text": "把我的骨灰撒进大海。",
      "token_start": 1274,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 395890,
      "end_ms": 397365,
      "text": "我要陪着核潜艇，",
      "token_start": 1283,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 397780,
      "end_ms": 399005,
      "text": "守着这片海，",
      "token_start": 1290,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 399460,
      "end_ms": 401275,
      "text": "临终前昏迷的时候，",
      "token_start": 1295,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 401650,
      "end_ms": 403230,
      "text": "他还在含糊的念叨，",
      "token_start": 1303,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 403270,
      "end_ms": 405320,
      "text": "参数核对好了吗？",
      "token_start": 1311,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 405500,
      "end_ms": 406045,
      "text": "家人们，",
      "token_start": 1318,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 406530,
      "end_ms": 409485,
      "text": "你听听都到生命的最后一口气了，",
      "token_start": 1321,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 409910,
      "end_ms": 412385,
      "text": "他心里装的还是工作，",
      "token_start": 1335,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 412820,
      "end_ms": 413855,
      "text": "他这一辈子，",
      "token_start": 1344,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 414230,
      "end_ms": 416565,
      "text": "小时候老百姓用命护他。",
      "token_start": 1349,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 417040,
      "end_ms": 417600,
      "text": "长大后，",
      "token_start": 1359,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 417600,
      "end_ms": 422595,
      "text": "他用命护国造核潜艇、建核电站两件大事，",
      "token_start": 1362,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 423560,
      "end_ms": 426525,
      "text": "渐渐关系着咱们十四亿人的安稳。",
      "token_start": 1379,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 427830,
      "end_ms": 431295,
      "text": "你说这样的人是不是该被永远记住？",
      "token_start": 1393,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 431760,
      "end_ms": 436565,
      "text": "觉得彭老了不起的评论区打深浅一生四个字，",
      "token_start": 1408,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 437380,
      "end_ms": 443175,
      "text": "致敬这位隐姓埋名一辈子的老人点亮小红心，",
      "token_start": 1427,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 443490,
      "end_ms": 444395,
      "text": "转发出去，",
      "token_start": 1446,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 444840,
      "end_ms": 448345,
      "text": "让更多人知道今天我们能挺直腰杆说话。",
      "token_start": 1450,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 448690,
      "end_ms": 450405,
      "text": "背后就是彭老这样的人，",
      "token_start": 1467,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 451120,
      "end_ms": 453745,
      "text": "用一辈子在暗处给我们撑伞，",
      "token_start": 1477,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 454330,
      "end_ms": 455110,
      "text": "点个收藏，",
      "token_start": 1489,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 455410,
      "end_ms": 456475,
      "text": "讲给孩子听，",
      "token_start": 1493,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 456750,
      "end_ms": 457295,
      "text": "关注我，",
      "token_start": 1498,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 457670,
      "end_ms": 460675,
      "text": "往后咱们一起讲更多先辈的故事。",
      "token_start": 1501,
      "token_end_exclusive": 1515
    }
  ],
