{
  "video_id": "v_8802249238f121f5",
  "duration_s": 463.241379,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_8802249238f121f5.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_8802249238f121f5.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1230,
      "text": "蒋英赌命，",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1390,
      "end_ms": 3870,
      "text": "传信唤回中国航天，",
      "token_start": 4,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 3890,
      "end_ms": 6510,
      "text": "未来举国皆知。",
      "token_start": 12,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 6830,
      "end_ms": 9310,
      "text": "钱学森奠基中国航天，",
      "token_start": 18,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 9950,
      "end_ms": 12190,
      "text": "却极少有人知晓，",
      "token_start": 27,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 13390,
      "end_ms": 15670,
      "text": "拯救这位科学巨匠，",
      "token_start": 34,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 16010,
      "end_ms": 18410,
      "text": "成全我国航天事业的，",
      "token_start": 42,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 18970,
      "end_ms": 22010,
      "text": "是他身后看似温柔的蒋英，",
      "token_start": 51,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 22970,
      "end_ms": 24750,
      "text": "这段尘封的往事，",
      "token_start": 62,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 25250,
      "end_ms": 26970,
      "text": "没有激昂的赞歌，",
      "token_start": 69,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 27730,
      "end_ms": 31780,
      "text": "只有一场精心动炼动魄的生死营救，",
      "token_start": 76,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 32300,
      "end_ms": 34540,
      "text": "读懂他的无畏与坚守，",
      "token_start": 91,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 35040,
      "end_ms": 40520,
      "text": "才算真正读懂何谓大国风骨女性担当。",
      "token_start": 100,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 41020,
      "end_ms": 42140,
      "text": "整整五年，",
      "token_start": 116,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 42740,
      "end_ms": 47220,
      "text": "一家人深陷一国软禁的绝境，",
      "token_start": 120,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 47720,
      "end_ms": 48480,
      "text": "想回国，",
      "token_start": 132,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 48720,
      "end_ms": 50160,
      "text": "想为祖国做事，",
      "token_start": 135,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 50760,
      "end_ms": 54040,
      "text": "却连踏出家门一步的权利都没有。",
      "token_start": 141,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 55080,
      "end_ms": 56920,
      "text": "美方层层设防，",
      "token_start": 155,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 57520,
      "end_ms": 58660,
      "text": "严密监控，",
      "token_start": 161,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 59260,
      "end_ms": 63735,
      "text": "彻底锁住了钱学森的人身自由与科研之路。",
      "token_start": 165,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 64460,
      "end_ms": 68365,
      "text": "这位享誉全球的顶尖航天科学家，",
      "token_start": 183,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 69000,
      "end_ms": 71000,
      "text": "昔日意气风发，",
      "token_start": 197,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 71460,
      "end_ms": 72865,
      "text": "深耕科研，",
      "token_start": 203,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 73710,
      "end_ms": 76155,
      "text": "彼时却万般无奈，",
      "token_start": 207,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 76650,
      "end_ms": 82170,
      "text": "只能日日凝望祖国版图满心结是归乡，",
      "token_start": 214,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 82270,
      "end_ms": 85585,
      "text": "执念却寸步难行。",
      "token_start": 230,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 86360,
      "end_ms": 87465,
      "text": "电话被监听，",
      "token_start": 237,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 87940,
      "end_ms": 88440,
      "text": "出门，",
      "token_start": 242,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 88720,
      "end_ms": 90820,
      "text": "有人跟踪信件，",
      "token_start": 244,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 90900,
      "end_ms": 92105,
      "text": "全部拆开检查，",
      "token_start": 250,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 92910,
      "end_ms": 95520,
      "text": "特务二十四小时盯着他们，",
      "token_start": 256,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 95520,
      "end_ms": 97075,
      "text": "一家人滴水不漏。",
      "token_start": 267,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 97840,
      "end_ms": 102955,
      "text": "所有人都觉得钱学森这辈子可能再也回不来了，",
      "token_start": 274,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 103730,
      "end_ms": 107185,
      "text": "但只有讲英从来没有放弃。",
      "token_start": 294,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 108220,
      "end_ms": 111475,
      "text": "她看着丈夫日渐憔悴，",
      "token_start": 305,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 112010,
      "end_ms": 113925,
      "text": "报国无门的模样，",
      "token_start": 314,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 114550,
      "end_ms": 116295,
      "text": "心里比谁都清楚，",
      "token_start": 321,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 116860,
      "end_ms": 117775,
      "text": "耗下去，",
      "token_start": 328,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 118340,
      "end_ms": 121665,
      "text": "困住的不只是一个钱学森，",
      "token_start": 331,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 122240,
      "end_ms": 125160,
      "text": "更是中国未来几十年的航天。",
      "token_start": 342,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 125300,
      "end_ms": 127615,
      "text": "希望绝境之中，",
      "token_start": 354,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 128070,
      "end_ms": 130095,
      "text": "他想出了一个玩命的办法。",
      "token_start": 360,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 131220,
      "end_ms": 133905,
      "text": "蒋英有个妹妹定居比利时。",
      "token_start": 371,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 134530,
      "end_ms": 140940,
      "text": "他决定把求救信息藏进继王比利时的家书里，",
      "token_start": 382,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 140960,
      "end_ms": 141940,
      "text": "经由海外，",
      "token_start": 401,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 142040,
      "end_ms": 144585,
      "text": "辗转送回祖国。",
      "token_start": 405,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 145470,
      "end_ms": 149205,
      "text": "但这一步步步是死局，",
      "token_start": 411,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 150250,
      "end_ms": 152055,
      "text": "一旦被美方识破，",
      "token_start": 420,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 152500,
      "end_ms": 154165,
      "text": "不仅信送不出去，",
      "token_start": 427,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 154590,
      "end_ms": 157915,
      "text": "夫妻俩轻则永久监禁，",
      "token_start": 434,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 158810,
      "end_ms": 161195,
      "text": "重则再也没有活路。",
      "token_start": 443,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 161820,
      "end_ms": 163700,
      "text": "为了骗过严密审查，",
      "token_start": 451,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 164160,
      "end_ms": 165895,
      "text": "蒋莹铤而走险，",
      "token_start": 459,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 166450,
      "end_ms": 170055,
      "text": "他特意找来一张孩子的作业本纸，",
      "token_start": 465,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 170750,
      "end_ms": 174345,
      "text": "刻意模仿稚嫩的儿童笔记，",
      "token_start": 479,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 174950,
      "end_ms": 177805,
      "text": "通篇只写家常琐事，",
      "token_start": 490,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 178690,
      "end_ms": 179910,
      "text": "看似平平，",
      "token_start": 498,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 179990,
      "end_ms": 182575,
      "text": "无奇人畜无害。",
      "token_start": 502,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 183180,
      "end_ms": 185755,
      "text": "可就在普通的字里行间，",
      "token_start": 508,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 186200,
      "end_ms": 190830,
      "text": "他悄悄藏下了最关键的求救信号。",
      "token_start": 518,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 190910,
      "end_ms": 192425,
      "text": "我们渴望回国，",
      "token_start": 532,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 192990,
      "end_ms": 195145,
      "text": "却被美方无理软禁，",
      "token_start": 538,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 195590,
      "end_ms": 197405,
      "text": "恳请祖国相助，",
      "token_start": 546,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 197970,
      "end_ms": 199145,
      "text": "字字轻柔，",
      "token_start": 552,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 199540,
      "end_ms": 200635,
      "text": "句句千钧。",
      "token_start": 556,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 201580,
      "end_ms": 204025,
      "text": "趁着特务松懈的间隙，",
      "token_start": 560,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 204510,
      "end_ms": 205985,
      "text": "他强压着心跳，",
      "token_start": 569,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 206720,
      "end_ms": 210315,
      "text": "把这张救命纸条悄悄塞进包裹。",
      "token_start": 575,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 211280,
      "end_ms": 212635,
      "text": "那几天的蒋英，",
      "token_start": 588,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 213050,
      "end_ms": 214695,
      "text": "整夜不敢熟睡，",
      "token_start": 594,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 215310,
      "end_ms": 215870,
      "text": "疑点，",
      "token_start": 600,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 216030,
      "end_ms": 219805,
      "text": "风吹草动都让他心惊肉跳。",
      "token_start": 602,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 220360,
      "end_ms": 222355,
      "text": "他赌上了自己的性命，",
      "token_start": 613,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 223090,
      "end_ms": 224710,
      "text": "赌一家人的未来，",
      "token_start": 622,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 225210,
      "end_ms": 228535,
      "text": "只为给祖国留住一个钱学森。",
      "token_start": 629,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 229240,
      "end_ms": 230085,
      "text": "万幸，",
      "token_start": 641,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 230690,
      "end_ms": 232785,
      "text": "苍天不负有心人，",
      "token_start": 643,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 233760,
      "end_ms": 235875,
      "text": "这封跨越山海的密信，",
      "token_start": 650,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 236430,
      "end_ms": 238730,
      "text": "成功躲过层层审查，",
      "token_start": 659,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 238950,
      "end_ms": 240655,
      "text": "辗转半个地球，",
      "token_start": 667,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 241170,
      "end_ms": 244510,
      "text": "稳稳送到了北京祖国，",
      "token_start": 673,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 244510,
      "end_ms": 245595,
      "text": "收到讯息，",
      "token_start": 682,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 246020,
      "end_ms": 248655,
      "text": "立刻全力开展外交斡旋。",
      "token_start": 686,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 249660,
      "end_ms": 250175,
      "text": "最终，",
      "token_start": 696,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 250430,
      "end_ms": 254715,
      "text": "我国以释放十一名美国飞行员战俘为代价，",
      "token_start": 698,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 255370,
      "end_ms": 258435,
      "text": "换回了钱学森一家的归国资格。",
      "token_start": 716,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 259620,
      "end_ms": 262405,
      "text": "当拿到回国签证的那一刻，",
      "token_start": 729,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 262910,
      "end_ms": 265355,
      "text": "隐忍了五年的蒋英，",
      "token_start": 740,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 265890,
      "end_ms": 269265,
      "text": "终于抱着钱学森失声痛哭，",
      "token_start": 748,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 270040,
      "end_ms": 274755,
      "text": "五年屈辱五年煎熬五年坚守，",
      "token_start": 759,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 275080,
      "end_ms": 276875,
      "text": "他们终于可以回家了，",
      "token_start": 771,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 277860,
      "end_ms": 281155,
      "text": "可危险从来没有真正消散。",
      "token_start": 780,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 281430,
      "end_ms": 283965,
      "text": "登上归国轮船的那一刻，",
      "token_start": 791,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 284490,
      "end_ms": 287075,
      "text": "特务依旧暗中尾随，",
      "token_start": 801,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 287540,
      "end_ms": 291470,
      "text": "杀鸡暗藏整趟行城蒋英，",
      "token_start": 809,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 291510,
      "end_ms": 293295,
      "text": "全程神经紧绷，",
      "token_start": 819,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 293900,
      "end_ms": 295895,
      "text": "无论散步、吃饭。",
      "token_start": 825,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 296430,
      "end_ms": 296990,
      "text": "休息，",
      "token_start": 831,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 297610,
      "end_ms": 300570,
      "text": "他永远下意识挡在钱学森身前。",
      "token_start": 833,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 301410,
      "end_ms": 302310,
      "text": "有人问他，",
      "token_start": 846,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 302750,
      "end_ms": 303910,
      "text": "你不怕死吗？",
      "token_start": 850,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 304930,
      "end_ms": 308110,
      "text": "蒋莹的回答震撼人心。",
      "token_start": 855,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 309190,
      "end_ms": 311470,
      "text": "国家可以少一个音乐家，",
      "token_start": 864,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 311750,
      "end_ms": 314150,
      "text": "但绝对不能少一个钱学森。",
      "token_start": 874,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 315230,
      "end_ms": 318330,
      "text": "我能为他做的就是替他挡子弹。",
      "token_start": 885,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 319050,
      "end_ms": 320130,
      "text": "这不是情话，",
      "token_start": 898,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 320670,
      "end_ms": 325375,
      "text": "是一个中国人最深的家国大义。",
      "token_start": 903,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 326180,
      "end_ms": 329140,
      "text": "当轮船驶入中国领海，",
      "token_start": 916,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 329280,
      "end_ms": 333380,
      "text": "看见五星红旗迎风飘扬的那一刻，",
      "token_start": 925,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 334180,
      "end_ms": 336500,
      "text": "夫妻俩红了双眼，",
      "token_start": 939,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 337760,
      "end_ms": 340640,
      "text": "阔别多年历尽磨难，",
      "token_start": 946,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 341300,
      "end_ms": 343920,
      "text": "他们终于踏上了故土。",
      "token_start": 954,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 344580,
      "end_ms": 348660,
      "text": "彼时的钱学森行李箱空空如也。",
      "token_start": 963,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 349220,
      "end_ms": 356110,
      "text": "数十年心血的论文手稿研究资料全被美国赶到，",
      "token_start": 976,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 356190,
      "end_ms": 357435,
      "text": "扣押掠夺，",
      "token_start": 996,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 358050,
      "end_ms": 359485,
      "text": "但他毫无遗憾，",
      "token_start": 1000,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 360400,
      "end_ms": 361775,
      "text": "底气十足。",
      "token_start": 1006,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 362070,
      "end_ms": 362195,
      "text": "嗯，",
      "token_start": 1010,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 362770,
      "end_ms": 364785,
      "text": "他们拿走了我的手稿，",
      "token_start": 1011,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 365150,
      "end_ms": 373835,
      "text": "却拿不走我的大脑更拿不走我让同胞挺直腰杆体面生活的初心。",
      "token_start": 1020,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 374980,
      "end_ms": 375995,
      "text": "归国之后，",
      "token_start": 1047,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 376470,
      "end_ms": 378730,
      "text": "钱学森不负众望，",
      "token_start": 1051,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 378830,
      "end_ms": 379910,
      "text": "白手起家，",
      "token_start": 1058,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 380330,
      "end_ms": 385505,
      "text": "搭建起新中国第一支火箭导弹研究团队，",
      "token_start": 1062,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 386060,
      "end_ms": 389155,
      "text": "撑起了中国航天的半壁江山。",
      "token_start": 1079,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 389990,
      "end_ms": 393975,
      "text": "而本该站上世界顶级舞台，",
      "token_start": 1091,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 394460,
      "end_ms": 396735,
      "text": "光芒万丈的蒋英，",
      "token_start": 1102,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 397410,
      "end_ms": 399685,
      "text": "彻底收敛了所有锋芒。",
      "token_start": 1109,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 400430,
      "end_ms": 401935,
      "text": "他褪去光环，",
      "token_start": 1118,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 402400,
      "end_ms": 403505,
      "text": "引入幕后，",
      "token_start": 1123,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 404280,
      "end_ms": 406000,
      "text": "走进中央音乐学院，",
      "token_start": 1127,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 406040,
      "end_ms": 407025,
      "text": "教书育人。",
      "token_start": 1135,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 407730,
      "end_ms": 411265,
      "text": "别人问他是否后悔放弃巅峰事业，",
      "token_start": 1139,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 411720,
      "end_ms": 413715,
      "text": "他只是淡然一笑，",
      "token_start": 1153,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 414260,
      "end_ms": 416045,
      "text": "钱学森为国铸剑，",
      "token_start": 1160,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 416760,
      "end_ms": 420200,
      "text": "我便为他守家育人家。",
      "token_start": 1167,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 420280,
      "end_ms": 422905,
      "text": "国两全此生无憾。",
      "token_start": 1176,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 423260,
      "end_ms": 424340,
      "text": "世人皆知，",
      "token_start": 1183,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 424800,
      "end_ms": 426185,
      "text": "钱学森伟大，",
      "token_start": 1187,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 426680,
      "end_ms": 427720,
      "text": "却鲜有。",
      "token_start": 1192,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 427780,
      "end_ms": 431710,
      "text": "人知是蒋英以温柔之躯，",
      "token_start": 1195,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 431910,
      "end_ms": 433335,
      "text": "扛住风雨，",
      "token_start": 1205,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 433750,
      "end_ms": 438715,
      "text": "以一己之勇托举起中国航天的未来。",
      "token_start": 1209,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 440530,
      "end_ms": 444375,
      "text": "这样的女性值得我们永远铭记，",
      "token_start": 1224,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 445140,
      "end_ms": 446175,
      "text": "永远致敬。",
      "token_start": 1237,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 446650,
      "end_ms": 448925,
      "text": "你们觉得若无讲阴，",
      "token_start": 1241,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 449390,
      "end_ms": 451515,
      "text": "何来两弹一星？",
      "token_start": 1249,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 452630,
      "end_ms": 455135,
      "text": "评论区留下一句致敬。",
      "token_start": 1255,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 455570,
      "end_ms": 457600,
      "text": "巾帼英雄蒋英，",
      "token_start": 1264,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 458650,
      "end_ms": 463075,
      "text": "下期带你解锁更多历史名人背后的故事。",
      "token_start": 1270,
      "token_end_exclusive": 1287
    }
  ],
