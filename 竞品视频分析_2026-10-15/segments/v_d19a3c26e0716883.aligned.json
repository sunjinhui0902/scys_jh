{
  "video_id": "v_d19a3c26e0716883",
  "duration_s": 485.506984,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_d19a3c26e0716883.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_d19a3c26e0716883.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 650,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 650,
      "end_ms": 2370,
      "text": "咱们盘的第十到第六，",
      "token_start": 2,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3190,
      "end_ms": 9810,
      "text": "郭亮挂壁公路天窗是画框和那高速穿行在枫林里永无公路。",
      "token_start": 11,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 9810,
      "end_ms": 10870,
      "text": "夏天在水里，",
      "token_start": 36,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 11270,
      "end_ms": 14110,
      "text": "草原天路被老百姓捧红了。",
      "token_start": 41,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 14530,
      "end_ms": 16850,
      "text": "塔里木沙漠公路跟死亡之海打了一仗，",
      "token_start": 52,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 17150,
      "end_ms": 19130,
      "text": "好多朋友看完在评论区吵翻了。",
      "token_start": 68,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 19490,
      "end_ms": 23730,
      "text": "有人说川藏线呢独库公路呢盘龙古道了。",
      "token_start": 81,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 23830,
      "end_ms": 24270,
      "text": "别急，",
      "token_start": 98,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 24870,
      "end_ms": 27090,
      "text": "今天这集就是第五道第一，",
      "token_start": 100,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 27510,
      "end_ms": 29190,
      "text": "一条比一条震撼，",
      "token_start": 111,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 29570,
      "end_ms": 33400,
      "text": "最后后那个被叫做世界无极上的天路。",
      "token_start": 118,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 34140,
      "end_ms": 34780,
      "text": "老规矩，",
      "token_start": 134,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 34880,
      "end_ms": 35680,
      "text": "开讲之前，",
      "token_start": 137,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 36040,
      "end_ms": 38060,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 141,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 38300,
      "end_ms": 41600,
      "text": "让我看看都是谁在听第五名，",
      "token_start": 151,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 42100,
      "end_ms": 47760,
      "text": "一three hundred hundred的a teen川藏南线从成都到拉萨，",
      "token_start": 163,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 48120,
      "end_ms": 50820,
      "text": "全长两千一百四十二公里。",
      "token_start": 180,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 51240,
      "end_ms": 52860,
      "text": "这条路最绝的是，",
      "token_start": 191,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 52860,
      "end_ms": 54520,
      "text": "他从海拔五百米，",
      "token_start": 198,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 54780,
      "end_ms": 56440,
      "text": "一路爬到五千多米，",
      "token_start": 205,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 56580,
      "end_ms": 57940,
      "text": "翻十几座大山，",
      "token_start": 213,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 58620,
      "end_ms": 61180,
      "text": "跨十几条大和折多山。",
      "token_start": 219,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 61180,
      "end_ms": 66770,
      "text": "崖口经翻在风里裂裂响远处的共嘎雪山，",
      "token_start": 228,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 66790,
      "end_ms": 68645,
      "text": "群峰若隐若现。",
      "token_start": 245,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 69020,
      "end_ms": 72880,
      "text": "新都桥光与影的天堂日落的时候，",
      "token_start": 251,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 73020,
      "end_ms": 75395,
      "text": "塔宫草原方向美的不像真的。",
      "token_start": 265,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 75580,
      "end_ms": 79085,
      "text": "然芜湖碧绿的湖面倒映着雪山，",
      "token_start": 277,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 80070,
      "end_ms": 82225,
      "text": "清晨雾气缭绕的时候，",
      "token_start": 290,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 82600,
      "end_ms": 85720,
      "text": "您站在湖边分不清哪是天哪，",
      "token_start": 299,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 85720,
      "end_ms": 86125,
      "text": "是水。",
      "token_start": 311,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 86940,
      "end_ms": 89310,
      "text": "怒江七十二拐一条路，",
      "token_start": 313,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 89310,
      "end_ms": 91275,
      "text": "在悬崖边拐了又拐，",
      "token_start": 322,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 91670,
      "end_ms": 94105,
      "text": "从山顶一直盘到谷底。",
      "token_start": 330,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 94910,
      "end_ms": 98125,
      "text": "中国国家地理管他叫中国人的景观大道，",
      "token_start": 339,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 99010,
      "end_ms": 99930,
      "text": "一天之内，",
      "token_start": 356,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 100130,
      "end_ms": 106680,
      "text": "雪山、湖泊、葬寨、草原寺庙全在你眼前。",
      "token_start": 360,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 106680,
      "end_ms": 108775,
      "text": "过走一趟川藏线，",
      "token_start": 375,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 109580,
      "end_ms": 111555,
      "text": "等于看了大半个中国。",
      "token_start": 382,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 112550,
      "end_ms": 113215,
      "text": "第四名，",
      "token_start": 391,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 114220,
      "end_ms": 118850,
      "text": "新疆独库公路从独山子到库车，",
      "token_start": 394,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 119150,
      "end_ms": 121335,
      "text": "全长五百六十一公里。",
      "token_start": 407,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 122400,
      "end_ms": 126125,
      "text": "这条路最绝的是一天能过四个季节。",
      "token_start": 416,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 126970,
      "end_ms": 129115,
      "text": "早上从独山子出发，",
      "token_start": 431,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 129810,
      "end_ms": 134205,
      "text": "穿羽绒服翻雪山雪就在路边，",
      "token_start": 439,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 135360,
      "end_ms": 139150,
      "text": "伸手能摸到中午到乔尔玛草原上，",
      "token_start": 451,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 139170,
      "end_ms": 143305,
      "text": "牛羊成群毡房冒着炊烟换短袖。",
      "token_start": 465,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 143800,
      "end_ms": 145585,
      "text": "下午进巴音布鲁克，",
      "token_start": 478,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 146420,
      "end_ms": 147675,
      "text": "九曲十八弯，",
      "token_start": 486,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 148460,
      "end_ms": 150105,
      "text": "夕阳照在河面上，",
      "token_start": 491,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 150760,
      "end_ms": 153685,
      "text": "一条河变成九条金带子。",
      "token_start": 498,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 154130,
      "end_ms": 158360,
      "text": "天鹅在湖面上游傍晚到库车峡谷，",
      "token_start": 508,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 158360,
      "end_ms": 160400,
      "text": "丹霞赤红的岩壁，",
      "token_start": 522,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 160640,
      "end_ms": 162155,
      "text": "跟火烧过一样，",
      "token_start": 529,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 162580,
      "end_ms": 163980,
      "text": "热的跟火炉一样，",
      "token_start": 535,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 164000,
      "end_ms": 165435,
      "text": "五百六十一公里，",
      "token_start": 542,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 165830,
      "end_ms": 168535,
      "text": "浓缩了新疆百分之八十的地貌。",
      "token_start": 549,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 169140,
      "end_ms": 176525,
      "text": "中国国家地理天山山地区域最美公路独库公路排第一第三名，",
      "token_start": 562,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 176890,
      "end_ms": 179655,
      "text": "青海环湖公路在青海，",
      "token_start": 588,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 180350,
      "end_ms": 181890,
      "text": "绕着青海湖走一圈，",
      "token_start": 597,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 182230,
      "end_ms": 183990,
      "text": "全长三百六十公里。",
      "token_start": 605,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 184470,
      "end_ms": 188530,
      "text": "这条路最绝的是它围着中国最大的内陆湖。",
      "token_start": 613,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 188530,
      "end_ms": 192190,
      "text": "转青海湖四千五百多平方公里。",
      "token_start": 631,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 192630,
      "end_ms": 193510,
      "text": "跟海一样，",
      "token_start": 644,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 193510,
      "end_ms": 196270,
      "text": "大公路就从湖边上过，",
      "token_start": 648,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 196650,
      "end_ms": 197570,
      "text": "一边是湖，",
      "token_start": 657,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 197890,
      "end_ms": 198890,
      "text": "一边是草原。",
      "token_start": 661,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 199450,
      "end_ms": 200990,
      "text": "夏天油菜花开了，",
      "token_start": 666,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 201110,
      "end_ms": 203990,
      "text": "金黄金黄的一片连着一片。",
      "token_start": 673,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 204350,
      "end_ms": 206970,
      "text": "从路边一直铺到山脚下，",
      "token_start": 684,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 207750,
      "end_ms": 209970,
      "text": "再往外是祁连山山顶，",
      "token_start": 694,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 210120,
      "end_ms": 212560,
      "text": "还带着雪湖是蓝的，",
      "token_start": 703,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 212760,
      "end_ms": 213880,
      "text": "花是黄的，",
      "token_start": 711,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 214080,
      "end_ms": 215200,
      "text": "山是白的，",
      "token_start": 715,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 215560,
      "end_ms": 216520,
      "text": "天是青的，",
      "token_start": 719,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 216880,
      "end_ms": 218680,
      "text": "四种颜色排成一条线。",
      "token_start": 723,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 219160,
      "end_ms": 221960,
      "text": "从车窗看出去就是一幅油画，",
      "token_start": 732,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 222700,
      "end_ms": 224420,
      "text": "您开一段停一段，",
      "token_start": 744,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 224600,
      "end_ms": 228180,
      "text": "拍一段三百六十公里能开一整天。",
      "token_start": 751,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 228780,
      "end_ms": 233880,
      "text": "中国国家地理西部最美公路环湖公路排在前头。",
      "token_start": 765,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 234420,
      "end_ms": 239080,
      "text": "我前阵子翻到一本叫三百六十五日走遍中国的日历书，",
      "token_start": 785,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 239260,
      "end_ms": 242290,
      "text": "左边一页是每个地方的实景大图，",
      "token_start": 808,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 242290,
      "end_ms": 245425,
      "text": "加一段五十来个字的冷知识，",
      "token_start": 822,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 246020,
      "end_ms": 247865,
      "text": "右边是日期记事夜，",
      "token_start": 834,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 248360,
      "end_ms": 250235,
      "text": "什么季节去哪座小城，",
      "token_start": 842,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 250710,
      "end_ms": 251490,
      "text": "走哪条路，",
      "token_start": 851,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 251490,
      "end_ms": 253045,
      "text": "看什么风景最合适，",
      "token_start": 855,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 253610,
      "end_ms": 254965,
      "text": "都给你安排好了。",
      "token_start": 863,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 255240,
      "end_ms": 258165,
      "text": "不是那种千篇一律的景点介绍，",
      "token_start": 870,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 258540,
      "end_ms": 259985,
      "text": "是帮你挑日子。",
      "token_start": 883,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 260610,
      "end_ms": 262355,
      "text": "今天翻到独库公路，",
      "token_start": 889,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 262670,
      "end_ms": 264415,
      "text": "明天翻到环湖公路，",
      "token_start": 897,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 264720,
      "end_ms": 266795,
      "text": "后天翻到盘龙古道，",
      "token_start": 905,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 267230,
      "end_ms": 268030,
      "text": "翻到哪页，",
      "token_start": 913,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 268030,
      "end_ms": 273505,
      "text": "就觉得那个地方在喊你我自己的习惯是每天早起翻一页当个消遣，",
      "token_start": 917,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 273920,
      "end_ms": 276180,
      "text": "翻到一个从来没听说过的小地方，",
      "token_start": 945,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 276280,
      "end_ms": 278075,
      "text": "就去网上搜搜照片，",
      "token_start": 959,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 278550,
      "end_ms": 279910,
      "text": "搜完就想订票。",
      "token_start": 967,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 280130,
      "end_ms": 281425,
      "text": "我已经放下面了，",
      "token_start": 973,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 281890,
      "end_ms": 283325,
      "text": "点开就能看到。",
      "token_start": 980,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 283720,
      "end_ms": 285320,
      "text": "喜欢到处走走的朋友，",
      "token_start": 986,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 285480,
      "end_ms": 286800,
      "text": "弄一本放茶几，",
      "token_start": 995,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 286800,
      "end_ms": 288635,
      "text": "上一年下来，",
      "token_start": 1001,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 289080,
      "end_ms": 290880,
      "text": "整个中国哪儿值得去，",
      "token_start": 1006,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 290880,
      "end_ms": 293275,
      "text": "哪个乐曲心里全有谱了。",
      "token_start": 1015,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 293720,
      "end_ms": 294295,
      "text": "第二名，",
      "token_start": 1025,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 294690,
      "end_ms": 298305,
      "text": "新疆盘龙古道在帕米尔高原上。",
      "token_start": 1028,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 298770,
      "end_ms": 301530,
      "text": "从塔什库尔干到瓦恰乡，",
      "token_start": 1041,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 301830,
      "end_ms": 303330,
      "text": "全长三十六公里，",
      "token_start": 1051,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 303990,
      "end_ms": 309730,
      "text": "这条路最绝的是它弯到多到吓人三十多公里的路，",
      "token_start": 1058,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 310170,
      "end_ms": 311770,
      "text": "六百多个s弯，",
      "token_start": 1079,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 312150,
      "end_ms": 314590,
      "text": "平均每五十米就有一个弯。",
      "token_start": 1085,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 314670,
      "end_ms": 315950,
      "text": "从山顶往下看，",
      "token_start": 1096,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 316290,
      "end_ms": 319790,
      "text": "整条路像一条巨龙盘在山脊上，",
      "token_start": 1102,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 319950,
      "end_ms": 320870,
      "text": "弯弯绕绕，",
      "token_start": 1115,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 321190,
      "end_ms": 322350,
      "text": "一层叠着一层，",
      "token_start": 1119,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 322790,
      "end_ms": 324570,
      "text": "从海拔四千二百米，",
      "token_start": 1125,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 324710,
      "end_ms": 326190,
      "text": "一路降到三千米，",
      "token_start": 1133,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 326430,
      "end_ms": 329040,
      "text": "落差一千多米全是弯。",
      "token_start": 1140,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 330980,
      "end_ms": 331960,
      "text": "您坐在车里，",
      "token_start": 1149,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 332880,
      "end_ms": 334060,
      "text": "方向盘还没回，",
      "token_start": 1154,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 334060,
      "end_ms": 336280,
      "text": "正下一个弯就到了。",
      "token_start": 1160,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 337300,
      "end_ms": 337980,
      "text": "当地人。",
      "token_start": 1168,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 337980,
      "end_ms": 339300,
      "text": "有句话叫，",
      "token_start": 1171,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 339360,
      "end_ms": 342020,
      "text": "今日走过了人生所有的弯路，",
      "token_start": 1175,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 342920,
      "end_ms": 345140,
      "text": "从此人生尽是坦途。",
      "token_start": 1187,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 345760,
      "end_ms": 347940,
      "text": "这条路本来是给牧民走的，",
      "token_start": 1195,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 348400,
      "end_ms": 350040,
      "text": "后来修成了柏油路，",
      "token_start": 1206,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 350480,
      "end_ms": 351720,
      "text": "自驾的人来了，",
      "token_start": 1214,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 352440,
      "end_ms": 354820,
      "text": "拍了照片发到网上火了。",
      "token_start": 1220,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 354980,
      "end_ms": 355840,
      "text": "帕米尔高原，",
      "token_start": 1230,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 356260,
      "end_ms": 357880,
      "text": "祖国最西边的地方，",
      "token_start": 1235,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 358100,
      "end_ms": 359295,
      "text": "天蓝难得发黑，",
      "token_start": 1243,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 359670,
      "end_ms": 360715,
      "text": "云白的刺眼，",
      "token_start": 1249,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 361140,
      "end_ms": 362415,
      "text": "雪山就在路边，",
      "token_start": 1254,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 362780,
      "end_ms": 364475,
      "text": "一条路六百个弯。",
      "token_start": 1260,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 364870,
      "end_ms": 365250,
      "text": "您说，",
      "token_start": 1267,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 365250,
      "end_ms": 367915,
      "text": "这是公路还是大自然的过山车？",
      "token_start": 1269,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 368580,
      "end_ms": 369115,
      "text": "第一名，",
      "token_start": 1282,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 369510,
      "end_ms": 373575,
      "text": "青藏公路从青海格尔木到西藏拉萨，",
      "token_start": 1285,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 373920,
      "end_ms": 375795,
      "text": "全长一千一百多公里。",
      "token_start": 1300,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 376710,
      "end_ms": 379765,
      "text": "这条路最绝的是他修在天上，",
      "token_start": 1309,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 380140,
      "end_ms": 382275,
      "text": "平均海拔四千多米，",
      "token_start": 1321,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 382840,
      "end_ms": 383905,
      "text": "翻过昆仑山，",
      "token_start": 1329,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 384210,
      "end_ms": 385335,
      "text": "穿过可可西里，",
      "token_start": 1334,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 385720,
      "end_ms": 386925,
      "text": "跨过唐古拉山，",
      "token_start": 1340,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 387300,
      "end_ms": 389515,
      "text": "一路都在云端上走，",
      "token_start": 1346,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 390000,
      "end_ms": 392555,
      "text": "路边能看到藏羚羊，",
      "token_start": 1354,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 392840,
      "end_ms": 395465,
      "text": "一群一群的在草原上跑，",
      "token_start": 1362,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 395780,
      "end_ms": 396815,
      "text": "能看到雪山，",
      "token_start": 1372,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 397410,
      "end_ms": 399985,
      "text": "一座连着一座白的晃眼，",
      "token_start": 1377,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 400370,
      "end_ms": 407455,
      "text": "能看到草原无边无际的绿到天边可可西里、世界屋脊上的净土。",
      "token_start": 1387,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 407960,
      "end_ms": 411015,
      "text": "青藏高原世界四大超禁区之一，",
      "token_start": 1413,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 411450,
      "end_ms": 413005,
      "text": "天空蓝的不像话，",
      "token_start": 1426,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 413350,
      "end_ms": 416220,
      "text": "云低的伸手就能摘这条路。",
      "token_start": 1433,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 416220,
      "end_ms": 417300,
      "text": "修了四年多，",
      "token_start": 1444,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 417560,
      "end_ms": 419740,
      "text": "三千多人牺牲在路上，",
      "token_start": 1449,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 419960,
      "end_ms": 422695,
      "text": "平均每公里埋着一个修路人，",
      "token_start": 1458,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 423290,
      "end_ms": 424505,
      "text": "别的路美在风景，",
      "token_start": 1470,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 425030,
      "end_ms": 425870,
      "text": "青藏公路，",
      "token_start": 1477,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 425870,
      "end_ms": 427540,
      "text": "美在他是用命，",
      "token_start": 1481,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 427800,
      "end_ms": 431105,
      "text": "从戈壁滩上一步一步拖到天上的。",
      "token_start": 1487,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 431300,
      "end_ms": 432820,
      "text": "您说这条路排第一，",
      "token_start": 1501,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 433040,
      "end_ms": 433845,
      "text": "服不服？",
      "token_start": 1509,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 434160,
      "end_ms": 435305,
      "text": "您听出来了没有？",
      "token_start": 1512,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 435780,
      "end_ms": 442100,
      "text": "这十条公路没有一条是光靠好看出名的郭亮挂壁公路，",
      "token_start": 1519,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 442200,
      "end_ms": 444570,
      "text": "靠的是天窗画框河，",
      "token_start": 1542,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 444570,
      "end_ms": 447505,
      "text": "那高速靠的是穿行在枫林里，",
      "token_start": 1550,
      "token_end_exclusive": 1562
    },
    {
      "start_ms": 448400,
      "end_ms": 449260,
      "text": "永无公路，",
      "token_start": 1562,
      "token_end_exclusive": 1566
    },
    {
      "start_ms": 449500,
      "end_ms": 450480,
      "text": "靠的是夏天。",
      "token_start": 1566,
      "token_end_exclusive": 1571
    },
    {
      "start_ms": 450480,
      "end_ms": 451165,
      "text": "在水里，",
      "token_start": 1571,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 451890,
      "end_ms": 452790,
      "text": "草原天路，",
      "token_start": 1574,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 452950,
      "end_ms": 454545,
      "text": "靠的是老百姓的眼睛。",
      "token_start": 1578,
      "token_end_exclusive": 1587
    },
    {
      "start_ms": 455460,
      "end_ms": 459365,
      "text": "塔里木沙漠公路靠的是跟沙漠打了一仗，",
      "token_start": 1587,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 459760,
      "end_ms": 463735,
      "text": "川藏线靠的是用命铺出来的景观大道，",
      "token_start": 1604,
      "token_end_exclusive": 1620
    },
    {
      "start_ms": 464450,
      "end_ms": 467145,
      "text": "独库公路靠的是一天过四季，",
      "token_start": 1620,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 467700,
      "end_ms": 468720,
      "text": "环湖公路，",
      "token_start": 1632,
      "token_end_exclusive": 1636
    },
    {
      "start_ms": 468840,
      "end_ms": 471260,
      "text": "靠的是围着青海湖转一圈。",
      "token_start": 1636,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 471480,
      "end_ms": 473760,
      "text": "盘龙古道靠的是六百个弯儿，",
      "token_start": 1647,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 474170,
      "end_ms": 477155,
      "text": "青藏公路靠的是从戈壁拖到天上，",
      "token_start": 1659,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 477640,
      "end_ms": 480735,
      "text": "每一条路的厉害之处都不在它有多长，",
      "token_start": 1673,
      "token_end_exclusive": 1689
    },
    {
      "start_ms": 481110,
      "end_ms": 482135,
      "text": "在他有多好看，",
      "token_start": 1689,
      "token_end_exclusive": 1695
    },
    {
      "start_ms": 482430,
      "end_ms": 483255,
      "text": "点个关注，",
      "token_start": 1695,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 483760,
      "end_ms": 485375,
      "text": "咱们下期接着聊。",
      "token_start": 1699,
      "token_end_exclusive": 1706
    }
  ],
