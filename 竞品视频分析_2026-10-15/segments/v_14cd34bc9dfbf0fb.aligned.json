{
  "video_id": "v_14cd34bc9dfbf0fb",
  "duration_s": 397.586207,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_14cd34bc9dfbf0fb.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_14cd34bc9dfbf0fb.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 3210,
      "text": "前两集我们讲了茅以生花九百二十五天，",
      "token_start": 0,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 3270,
      "end_ms": 6930,
      "text": "建成钱塘江大桥通车八十九天。",
      "token_start": 17,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 6990,
      "end_ms": 9150,
      "text": "含泪亲手炸掉的故事，",
      "token_start": 30,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9690,
      "end_ms": 10950,
      "text": "也讲了这座桥，",
      "token_start": 39,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 11070,
      "end_ms": 13230,
      "text": "前前后后被炸了四次，",
      "token_start": 45,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 13950,
      "end_ms": 17010,
      "text": "被称为桥坚强的传奇。",
      "token_start": 54,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 18150,
      "end_ms": 18630,
      "text": "今天，",
      "token_start": 63,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 18730,
      "end_ms": 20310,
      "text": "毛以生系列大结局，",
      "token_start": 65,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 20690,
      "end_ms": 30600,
      "text": "我们讲最燃的部分毛以生兑现承诺了一九四六年春天抗战胜利后的第第二年，",
      "token_start": 73,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 31080,
      "end_ms": 33460,
      "text": "毛以生回到了节后的杭州。",
      "token_start": 106,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 34140,
      "end_ms": 38840,
      "text": "站在钱塘江边看着被炸的断壁残垣的大桥，",
      "token_start": 117,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 39040,
      "end_ms": 42620,
      "text": "他想起了九年前闸桥那晚写下的十个字，",
      "token_start": 135,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 42980,
      "end_ms": 44180,
      "text": "抗战必胜，",
      "token_start": 152,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 44640,
      "end_ms": 48120,
      "text": "此桥必复现在抗战胜利了，",
      "token_start": 156,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 48360,
      "end_ms": 49440,
      "text": "该修复桥了。",
      "token_start": 167,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 49820,
      "end_ms": 54440,
      "text": "交通部的命令也到了修桥可摆在毛以生，",
      "token_start": 172,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 54440,
      "end_ms": 56680,
      "text": "面前的是一个烂摊子，",
      "token_start": 189,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 56920,
      "end_ms": 58540,
      "text": "而且是三重烂摊子，",
      "token_start": 198,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 58720,
      "end_ms": 60360,
      "text": "第一重无五孔，",
      "token_start": 206,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 60380,
      "end_ms": 64545,
      "text": "钢良在江底躺了八九年了得一段一段打捞上来，",
      "token_start": 212,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 64980,
      "end_ms": 66015,
      "text": "弯了的矫正，",
      "token_start": 232,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 66320,
      "end_ms": 68740,
      "text": "断了的地方换新的铆钉，",
      "token_start": 237,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 68760,
      "end_ms": 69995,
      "text": "一颗一颗打回去。",
      "token_start": 247,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 70840,
      "end_ms": 73760,
      "text": "好在当年设计师十六孔全是等跨，",
      "token_start": 254,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 73920,
      "end_ms": 76575,
      "text": "每孔六十七米统一制造。",
      "token_start": 268,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 77580,
      "end_ms": 78625,
      "text": "这时候救了命，",
      "token_start": 278,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 79540,
      "end_ms": 84795,
      "text": "打捞上来的钢粮能配得上新造的第二重。",
      "token_start": 284,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 85940,
      "end_ms": 89480,
      "text": "日本人当年凑合休往桥里填，",
      "token_start": 301,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 89560,
      "end_ms": 90675,
      "text": "劣质砂石，",
      "token_start": 313,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 91190,
      "end_ms": 91890,
      "text": "结歪斜，",
      "token_start": 317,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 91890,
      "end_ms": 94185,
      "text": "钢梁全得拆掉重来。",
      "token_start": 320,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 94900,
      "end_ms": 96015,
      "text": "日本人干的活，",
      "token_start": 328,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 96380,
      "end_ms": 97615,
      "text": "毛以生看不上，",
      "token_start": 334,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 97890,
      "end_ms": 98985,
      "text": "必须推倒重来。",
      "token_start": 340,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 99960,
      "end_ms": 101425,
      "text": "第三重最要命。",
      "token_start": 346,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 101840,
      "end_ms": 102520,
      "text": "五号六号，",
      "token_start": 352,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 102520,
      "end_ms": 107855,
      "text": "墩伤在水下钱塘江水急潮翻涌，",
      "token_start": 356,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 108400,
      "end_ms": 110145,
      "text": "怎么在水下修桥墩？",
      "token_start": 369,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 111080,
      "end_ms": 111640,
      "text": "这时候，",
      "token_start": 377,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 111640,
      "end_ms": 117930,
      "text": "毛以生的团队总工程师汪菊潜带着一批年轻人，",
      "token_start": 380,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 117970,
      "end_ms": 119890,
      "text": "硬是发明了套箱法，",
      "token_start": 400,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 120090,
      "end_ms": 122730,
      "text": "做一个巨大的钢筋混凝土箱子，",
      "token_start": 408,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 122730,
      "end_ms": 123385,
      "text": "沉下去，",
      "token_start": 421,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 123690,
      "end_ms": 124785,
      "text": "把桥墩套住，",
      "token_start": 424,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 125110,
      "end_ms": 125745,
      "text": "排干水，",
      "token_start": 429,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 126140,
      "end_ms": 129005,
      "text": "在无水的房间里修复墩身。",
      "token_start": 432,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 129680,
      "end_ms": 132975,
      "text": "你想想那个画面几十米深的江底，",
      "token_start": 443,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 133250,
      "end_ms": 134470,
      "text": "一个巨大的箱子，",
      "token_start": 457,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 134470,
      "end_ms": 136735,
      "text": "把桥墩罩住水排干了，",
      "token_start": 464,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 137350,
      "end_ms": 140275,
      "text": "工人在里面像在陆地上一样施工，",
      "token_start": 473,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 140760,
      "end_ms": 142455,
      "text": "外面是滔滔江水，",
      "token_start": 487,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 142780,
      "end_ms": 145925,
      "text": "里面是汗花似溅这套技术，",
      "token_start": 494,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 146300,
      "end_ms": 151955,
      "text": "后来成了中国桥梁修水下桥墩的看家本领。",
      "token_start": 505,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 152560,
      "end_ms": 153325,
      "text": "直到今天，",
      "token_start": 523,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 153890,
      "end_ms": 158385,
      "text": "中国修水下桥墩用的还是这套思路的升级版。",
      "token_start": 527,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 159800,
      "end_ms": 161125,
      "text": "一九四七年三月，",
      "token_start": 546,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 161540,
      "end_ms": 162895,
      "text": "大桥临时通车，",
      "token_start": 553,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 163760,
      "end_ms": 167235,
      "text": "一九四八年五月正式开始修复。",
      "token_start": 559,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 168700,
      "end_ms": 169635,
      "text": "注意这个时间，",
      "token_start": 572,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 170010,
      "end_ms": 172175,
      "text": "从设计到炸毁，",
      "token_start": 578,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 172500,
      "end_ms": 175295,
      "text": "再到修复三个关键节点，",
      "token_start": 584,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 175680,
      "end_ms": 180410,
      "text": "全是毛蚁生亲自修复完的世界桥梁。",
      "token_start": 594,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 180430,
      "end_ms": 184485,
      "text": "史上找不出第二个人自己设计的桥，",
      "token_start": 609,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 184870,
      "end_ms": 185595,
      "text": "自己炸的，",
      "token_start": 624,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 186050,
      "end_ms": 187255,
      "text": "自己再修回来，",
      "token_start": 628,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 188370,
      "end_ms": 189725,
      "text": "这不是电影剧本，",
      "token_start": 634,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 190070,
      "end_ms": 191755,
      "text": "这是真实发生的事儿。",
      "token_start": 641,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 192850,
      "end_ms": 194995,
      "text": "可你以为这就完了没有？",
      "token_start": 650,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 197010,
      "end_ms": 198475,
      "text": "一九四九年五月，",
      "token_start": 660,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 198780,
      "end_ms": 203085,
      "text": "杭州在被解放前夕撤退的军队又炸了一次。",
      "token_start": 667,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 203590,
      "end_ms": 207415,
      "text": "好在地下党员和护桥工人拼死保护，",
      "token_start": 685,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 207880,
      "end_ms": 209545,
      "text": "只炸毁了部分铁轨。",
      "token_start": 700,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 210110,
      "end_ms": 212430,
      "text": "大桥主体保住了新中国，",
      "token_start": 708,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 212430,
      "end_ms": 214425,
      "text": "成立后继续修复。",
      "token_start": 718,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 215440,
      "end_ms": 217900,
      "text": "一九五三年九月六号，",
      "token_start": 725,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 217900,
      "end_ms": 222575,
      "text": "墩彻底修完嗯一九五四年大桥全面恢复使用，",
      "token_start": 734,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 223080,
      "end_ms": 226570,
      "text": "从一九三四年开工到一九五四年，",
      "token_start": 753,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 226590,
      "end_ms": 228695,
      "text": "全面恢复整整二十年。",
      "token_start": 767,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 229230,
      "end_ms": 232125,
      "text": "一座桥折腾了二十年之久，",
      "token_start": 776,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 232750,
      "end_ms": 235345,
      "text": "而毛以生的故事还在继续。",
      "token_start": 787,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 235920,
      "end_ms": 237225,
      "text": "新中国成立后，",
      "token_start": 798,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 237720,
      "end_ms": 241775,
      "text": "毛以生又主持了武汉长江大桥的技术工作。",
      "token_start": 804,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 242400,
      "end_ms": 245995,
      "text": "万里长江第一桥在他手里架了起来，",
      "token_start": 822,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 246870,
      "end_ms": 251095,
      "text": "从此京汉铁路和粤汉铁路连成一线，",
      "token_start": 837,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 251600,
      "end_ms": 254805,
      "text": "整个中国的南北动脉被全面打通了。",
      "token_start": 852,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 255750,
      "end_ms": 256190,
      "text": "后来，",
      "token_start": 867,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 256430,
      "end_ms": 258045,
      "text": "人民大会堂的建设，",
      "token_start": 869,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 258410,
      "end_ms": 260735,
      "text": "中国铁道科学研究院的组建，",
      "token_start": 877,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 261210,
      "end_ms": 263325,
      "text": "上百万字的科普著作，",
      "token_start": 889,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 263700,
      "end_ms": 266565,
      "text": "毛以生都注入了大量心血。",
      "token_start": 898,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 267210,
      "end_ms": 272920,
      "text": "一九八七年九十一岁的毛以生递交了入党申请书，",
      "token_start": 909,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 273120,
      "end_ms": 274375,
      "text": "他在申请书里写，",
      "token_start": 930,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 274830,
      "end_ms": 276345,
      "text": "我已年逾九十，",
      "token_start": 937,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 276850,
      "end_ms": 279345,
      "text": "能为党工作之日日短，",
      "token_start": 943,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 279750,
      "end_ms": 281630,
      "text": "而要求入党之殷切，",
      "token_start": 952,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 281710,
      "end_ms": 283295,
      "text": "愿望与日俱增。",
      "token_start": 960,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 284230,
      "end_ms": 284945,
      "text": "两年后，",
      "token_start": 966,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 285190,
      "end_ms": 287265,
      "text": "一九八九年十一月十二日，",
      "token_start": 969,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 287730,
      "end_ms": 288985,
      "text": "毛以身世事，",
      "token_start": 980,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 289410,
      "end_ms": 290845,
      "text": "享年九十三岁。",
      "token_start": 985,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 291390,
      "end_ms": 292385,
      "text": "二零零六年，",
      "token_start": 991,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 292640,
      "end_ms": 296345,
      "text": "中国科学院把一颗小行星永久命名为。",
      "token_start": 996,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 296730,
      "end_ms": 297750,
      "text": "毛蚁生心，",
      "token_start": 1012,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 298370,
      "end_ms": 306110,
      "text": "今天钱塘江大桥依然横跨在钱塘江面上上面跑汽车下面跑火车，",
      "token_start": 1016,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 306390,
      "end_ms": 308270,
      "text": "天天有火车呼啸而过。",
      "token_start": 1043,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 309050,
      "end_ms": 311930,
      "text": "这座桥的设计寿命其实只有五十年，",
      "token_start": 1052,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 312070,
      "end_ms": 315150,
      "text": "到今天它已经服役快九十年了。",
      "token_start": 1067,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 315670,
      "end_ms": 321970,
      "text": "钱塘江大桥陈列馆里至今摆着一段被打捞上来的钢梁，",
      "token_start": 1080,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 322430,
      "end_ms": 325090,
      "text": "断口的痕迹清清楚楚。",
      "token_start": 1103,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 325430,
      "end_ms": 326800,
      "text": "那是历史的商吧，",
      "token_start": 1112,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 327440,
      "end_ms": 328880,
      "text": "也是民族的勋章。",
      "token_start": 1119,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 330020,
      "end_ms": 332300,
      "text": "有人问茅以生，",
      "token_start": 1126,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 332640,
      "end_ms": 334040,
      "text": "这辈子图什么？",
      "token_start": 1132,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 334740,
      "end_ms": 336140,
      "text": "图的就是四个字，",
      "token_start": 1138,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 336460,
      "end_ms": 340920,
      "text": "此桥必覆他把这四个字刻进骨头里，",
      "token_start": 1145,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 341100,
      "end_ms": 343480,
      "text": "然后用后半辈子证明了一件事，",
      "token_start": 1160,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 343960,
      "end_ms": 347560,
      "text": "中国人能建桥赶炸桥更修的回来。",
      "token_start": 1173,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 348160,
      "end_ms": 349940,
      "text": "从钱塘江到长江，",
      "token_start": 1187,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 350120,
      "end_ms": 351500,
      "text": "从内河到跨海，",
      "token_start": 1194,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 352340,
      "end_ms": 353420,
      "text": "今天的中国，",
      "token_start": 1200,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 353740,
      "end_ms": 356445,
      "text": "拥有世界上最长的跨海大桥，",
      "token_start": 1205,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 356530,
      "end_ms": 358075,
      "text": "好最高的桥梁，",
      "token_start": 1217,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 358480,
      "end_ms": 359925,
      "text": "最多的特大桥梁，",
      "token_start": 1223,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 360880,
      "end_ms": 363145,
      "text": "全球排名前一百的高桥，",
      "token_start": 1230,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 363540,
      "end_ms": 365085,
      "text": "中国战狼八十多岁。",
      "token_start": 1240,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 365640,
      "end_ms": 367395,
      "text": "而这一切的起点，",
      "token_start": 1248,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 367820,
      "end_ms": 371335,
      "text": "就在一九三四年的钱塘江边，",
      "token_start": 1255,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 372170,
      "end_ms": 375905,
      "text": "在那个叫毛以生的人说出我来的那一刻，",
      "token_start": 1267,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 376560,
      "end_ms": 379865,
      "text": "毛以生系列到这儿就全部讲完了。",
      "token_start": 1284,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 380270,
      "end_ms": 383385,
      "text": "三座桥一个人一辈子。",
      "token_start": 1298,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 384030,
      "end_ms": 389265,
      "text": "如果你也为这个用一生兑现承诺的老人打动了点个赞，",
      "token_start": 1307,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 389620,
      "end_ms": 392925,
      "text": "收藏起来转发给更多人看看。",
      "token_start": 1330,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 394100,
      "end_ms": 396375,
      "text": "关注我下一个国之脊梁，",
      "token_start": 1342,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 396640,
      "end_ms": 397455,
      "text": "我们继续讲。",
      "token_start": 1352,
      "token_end_exclusive": 1357
    }
  ],
