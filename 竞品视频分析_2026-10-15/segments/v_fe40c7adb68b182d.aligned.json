{
  "video_id": "v_fe40c7adb68b182d",
  "duration_s": 245.015011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_fe40c7adb68b182d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_fe40c7adb68b182d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 290,
      "text": "哎，",
      "token_start": 0,
      "token_end_exclusive": 1
    },
    {
      "start_ms": 470,
      "end_ms": 1350,
      "text": "你什么意思啊，",
      "token_start": 1,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1630,
      "end_ms": 3210,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 7,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 3430,
      "end_ms": 4170,
      "text": "领导美满，",
      "token_start": 18,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4170,
      "end_ms": 4510,
      "text": "美满，",
      "token_start": 22,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 4810,
      "end_ms": 6010,
      "text": "代表幸福美满，",
      "token_start": 24,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 6090,
      "end_ms": 8390,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 30,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 10130,
      "end_ms": 12110,
      "text": "来这么晚只能吃剩菜了吧，",
      "token_start": 44,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 12490,
      "end_ms": 14210,
      "text": "领导饭在哪儿我都能吃，",
      "token_start": 55,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 14450,
      "end_ms": 16350,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 65,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 16350,
      "end_ms": 18415,
      "text": "能赶上已经是我的运气了。",
      "token_start": 78,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 20590,
      "end_ms": 21710,
      "text": "这藕是好藕啊，",
      "token_start": 89,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 22370,
      "end_ms": 24230,
      "text": "就是心眼儿太多了。",
      "token_start": 95,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 24230,
      "end_ms": 26110,
      "text": "领导藕虽然心眼多，",
      "token_start": 103,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 26230,
      "end_ms": 27650,
      "text": "但也是您的下酒菜啊。",
      "token_start": 111,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 30410,
      "end_ms": 31610,
      "text": "年轻就是好啊，",
      "token_start": 120,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 32090,
      "end_ms": 33710,
      "text": "年轻就是还不够沉稳，",
      "token_start": 126,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 33950,
      "end_ms": 35070,
      "text": "还要向您多学习，",
      "token_start": 135,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 35370,
      "end_ms": 36690,
      "text": "我们才能变得更优秀。",
      "token_start": 142,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 38830,
      "end_ms": 39450,
      "text": "小图啊，",
      "token_start": 151,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 39850,
      "end_ms": 40990,
      "text": "今天让你破费了，",
      "token_start": 154,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 41170,
      "end_ms": 41590,
      "text": "领导，",
      "token_start": 161,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 41770,
      "end_ms": 43210,
      "text": "您说这些您能来，",
      "token_start": 163,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 43210,
      "end_ms": 43930,
      "text": "就是我的荣幸，",
      "token_start": 170,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 44210,
      "end_ms": 45770,
      "text": "以后还有很多地方向您请教，",
      "token_start": 176,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 45770,
      "end_ms": 49070,
      "text": "不是来就来，",
      "token_start": 188,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 49150,
      "end_ms": 50090,
      "text": "带什么礼物啊，",
      "token_start": 193,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 50090,
      "end_ms": 50420,
      "text": "都不是，",
      "token_start": 199,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 50480,
      "end_ms": 50940,
      "text": "是外人。",
      "token_start": 202,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 51380,
      "end_ms": 51840,
      "text": "领导，",
      "token_start": 205,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 52020,
      "end_ms": 52620,
      "text": "您都说了，",
      "token_start": 207,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 52620,
      "end_ms": 53200,
      "text": "不是外人，",
      "token_start": 211,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 53320,
      "end_ms": 54700,
      "text": "我一直都把您当长辈看，",
      "token_start": 215,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 54960,
      "end_ms": 56940,
      "text": "哪有晚辈看长辈空手来的道理呀。",
      "token_start": 225,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 58539,
      "end_ms": 59340,
      "text": "打这么多饭，",
      "token_start": 239,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 59340,
      "end_ms": 60175,
      "text": "你喂猪呢？",
      "token_start": 244,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 60630,
      "end_ms": 60990,
      "text": "领导，",
      "token_start": 248,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 60990,
      "end_ms": 61750,
      "text": "我哪儿敢啊？",
      "token_start": 250,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 61890,
      "end_ms": 63955,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 255,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 64150,
      "end_ms": 65370,
      "text": "都说宰相肚里能撑船，",
      "token_start": 271,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 65570,
      "end_ms": 66945,
      "text": "更何况只是一碗饭呢。",
      "token_start": 280,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 67170,
      "end_ms": 67620,
      "text": "不要了，",
      "token_start": 289,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 68760,
      "end_ms": 69735,
      "text": "鱼是好鱼，",
      "token_start": 292,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 70150,
      "end_ms": 71275,
      "text": "可惜就是刺儿多。",
      "token_start": 296,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 71590,
      "end_ms": 71830,
      "text": "领导，",
      "token_start": 303,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 71830,
      "end_ms": 72255,
      "text": "您看，",
      "token_start": 305,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 72590,
      "end_ms": 73450,
      "text": "鱼虽然刺多，",
      "token_start": 307,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 73650,
      "end_ms": 75560,
      "text": "但主心骨只有一根心腹，",
      "token_start": 312,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 75560,
      "end_ms": 76385,
      "text": "是没有刺的。",
      "token_start": 322,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 76720,
      "end_ms": 79375,
      "text": "呵呵哈小图啊，",
      "token_start": 327,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 79800,
      "end_ms": 81375,
      "text": "你这菜点的也太多了。",
      "token_start": 333,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 81880,
      "end_ms": 83440,
      "text": "领导菜点的再多，",
      "token_start": 342,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 83440,
      "end_ms": 84960,
      "text": "也比不上平时您对我的照顾。",
      "token_start": 349,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 84960,
      "end_ms": 85840,
      "text": "多这杯酒，",
      "token_start": 361,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 85840,
      "end_ms": 86555,
      "text": "我先敬您。",
      "token_start": 365,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 88870,
      "end_ms": 90375,
      "text": "小图最近表现不错啊，",
      "token_start": 369,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 90660,
      "end_ms": 92375,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 378,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 92650,
      "end_ms": 93715,
      "text": "我得提前敬一杯。",
      "token_start": 391,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 94080,
      "end_ms": 94780,
      "text": "听这意思。",
      "token_start": 398,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 94860,
      "end_ms": 96120,
      "text": "领导是要高升了呀，",
      "token_start": 402,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 96140,
      "end_ms": 96740,
      "text": "我得提前敬。",
      "token_start": 410,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 96740,
      "end_ms": 97000,
      "text": "领导，",
      "token_start": 415,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 97000,
      "end_ms": 97415,
      "text": "一杯，",
      "token_start": 417,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 99280,
      "end_ms": 100885,
      "text": "这鸭子是好鸭子，",
      "token_start": 419,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 101310,
      "end_ms": 102185,
      "text": "就是嘴硬。",
      "token_start": 426,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 102550,
      "end_ms": 102790,
      "text": "嗯，",
      "token_start": 430,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 103090,
      "end_ms": 103510,
      "text": "嘴硬，",
      "token_start": 431,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 103570,
      "end_ms": 104555,
      "text": "才守得住秘密。",
      "token_start": 433,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 105390,
      "end_ms": 105840,
      "text": "哈哈哈哈，",
      "token_start": 439,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 108350,
      "end_ms": 109585,
      "text": "你酒量挺好的呀。",
      "token_start": 443,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 109910,
      "end_ms": 110290,
      "text": "领导，",
      "token_start": 450,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 110390,
      "end_ms": 111450,
      "text": "您可抬举我了，",
      "token_start": 452,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 111450,
      "end_ms": 112715,
      "text": "我平时真不太能喝，",
      "token_start": 458,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 113030,
      "end_ms": 114510,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 466,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 114510,
      "end_ms": 115010,
      "text": "高兴啊，",
      "token_start": 477,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 115090,
      "end_ms": 116150,
      "text": "这一高兴就多贪了，",
      "token_start": 480,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 116150,
      "end_ms": 120045,
      "text": "几杯不喝就是看不起我。",
      "token_start": 488,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 120400,
      "end_ms": 120780,
      "text": "领导，",
      "token_start": 498,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 120920,
      "end_ms": 121940,
      "text": "我不是看不起您，",
      "token_start": 500,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 122100,
      "end_ms": 123115,
      "text": "我是看不起病，",
      "token_start": 507,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 126480,
      "end_ms": 126720,
      "text": "哎，",
      "token_start": 513,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 126820,
      "end_ms": 128295,
      "text": "我这肚子喝茶都能胖。",
      "token_start": 514,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 128700,
      "end_ms": 129100,
      "text": "领导，",
      "token_start": 523,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 129100,
      "end_ms": 129905,
      "text": "你那不叫胖，",
      "token_start": 525,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 130170,
      "end_ms": 131430,
      "text": "那叫宰相肚里能撑船，",
      "token_start": 530,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 131530,
      "end_ms": 133110,
      "text": "装的全是大事儿哈。",
      "token_start": 539,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 133110,
      "end_ms": 136365,
      "text": "呵呵呵小图啊，",
      "token_start": 547,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 136680,
      "end_ms": 138455,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 553,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 139030,
      "end_ms": 141410,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 563,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 141670,
      "end_ms": 144185,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 576,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 144920,
      "end_ms": 145865,
      "text": "怎么你这一入职，",
      "token_start": 589,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 146230,
      "end_ms": 147615,
      "text": "我刚种的花儿就死了，",
      "token_start": 596,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 148150,
      "end_ms": 149130,
      "text": "花开富贵嘛，",
      "token_start": 605,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 149290,
      "end_ms": 150765,
      "text": "花开过了就剩富贵了。",
      "token_start": 610,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 151050,
      "end_ms": 153025,
      "text": "看来领导您啊要发大财了。",
      "token_start": 619,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 154210,
      "end_ms": 154570,
      "text": "哈哈，",
      "token_start": 630,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 154740,
      "end_ms": 155335,
      "text": "小图啊，",
      "token_start": 632,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 155630,
      "end_ms": 156970,
      "text": "你个子是真高比，",
      "token_start": 635,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 156970,
      "end_ms": 157945,
      "text": "我还高一头呢。",
      "token_start": 642,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 158340,
      "end_ms": 162395,
      "text": "个高是为了给领导探路走哪儿不还是得听领导指挥吗？",
      "token_start": 648,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 163330,
      "end_ms": 164655,
      "text": "我真不怎么喜欢你，",
      "token_start": 671,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 165690,
      "end_ms": 167750,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 679,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 167750,
      "end_ms": 170635,
      "text": "我领导的格局值得我们学习。",
      "token_start": 692,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 173330,
      "end_ms": 173805,
      "text": "小图啊，",
      "token_start": 704,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 174090,
      "end_ms": 175410,
      "text": "你一开口就让人喜欢你，",
      "token_start": 707,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 175410,
      "end_ms": 176375,
      "text": "你是怎么做到的？",
      "token_start": 717,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 176580,
      "end_ms": 178525,
      "text": "因为我一直在看这本闲谈高手，",
      "token_start": 724,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 179050,
      "end_ms": 180710,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 737,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 180710,
      "end_ms": 182435,
      "text": "那些会说话、会来事儿的人。",
      "token_start": 748,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 182720,
      "end_ms": 183840,
      "text": "假如你不爱说话，",
      "token_start": 759,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 183920,
      "end_ms": 184660,
      "text": "不爱争辩，",
      "token_start": 766,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 184780,
      "end_ms": 185620,
      "text": "也不爱出门，",
      "token_start": 770,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 185900,
      "end_ms": 187100,
      "text": "甚至恐惧社交。",
      "token_start": 775,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 187260,
      "end_ms": 189265,
      "text": "推荐你读完这本闲谈高手，",
      "token_start": 781,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 189540,
      "end_ms": 191705,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 792,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 192030,
      "end_ms": 193210,
      "text": "你每天就看两页，",
      "token_start": 804,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 193350,
      "end_ms": 194690,
      "text": "每一个场景慢慢练，",
      "token_start": 811,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 194930,
      "end_ms": 197615,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 819,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 197840,
      "end_ms": 199100,
      "text": "在这本书里有一句话，",
      "token_start": 834,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 199160,
      "end_ms": 200005,
      "text": "我特别欣赏，",
      "token_start": 843,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 200360,
      "end_ms": 200500,
      "text": "他，",
      "token_start": 848,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 200500,
      "end_ms": 202575,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 849,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 202840,
      "end_ms": 203525,
      "text": "你可以回，",
      "token_start": 861,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 203960,
      "end_ms": 204900,
      "text": "那是不优秀点，",
      "token_start": 865,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 204980,
      "end_ms": 206325,
      "text": "怎么能和你做朋友呢？",
      "token_start": 871,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 206660,
      "end_ms": 208300,
      "text": "当有人说你真聪明，",
      "token_start": 880,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 208420,
      "end_ms": 210115,
      "text": "你就回近朱者赤，",
      "token_start": 888,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 210420,
      "end_ms": 211380,
      "text": "和你在一起啊，",
      "token_start": 895,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 211440,
      "end_ms": 214555,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 901,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 214740,
      "end_ms": 215845,
      "text": "你就回领导，",
      "token_start": 916,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 216100,
      "end_ms": 217295,
      "text": "这都是我应该做的。",
      "token_start": 921,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 217580,
      "end_ms": 218995,
      "text": "强将手下吴若冰，",
      "token_start": 929,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 219270,
      "end_ms": 220615,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 936,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 221040,
      "end_ms": 222320,
      "text": "当我看到这段的时候，",
      "token_start": 945,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 222320,
      "end_ms": 224045,
      "text": "真是让我欲解心开啊，",
      "token_start": 954,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 224460,
      "end_ms": 225745,
      "text": "每一句都很有意思，",
      "token_start": 963,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 226090,
      "end_ms": 228750,
      "text": "就是手把手教我们在不同的场景之下，",
      "token_start": 971,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 228890,
      "end_ms": 229690,
      "text": "应该怎么说？",
      "token_start": 987,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 230090,
      "end_ms": 232785,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 992,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 233040,
      "end_ms": 234360,
      "text": "你就放心的拿回去看，",
      "token_start": 1010,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 234700,
      "end_ms": 236175,
      "text": "就是一句一句的教你，",
      "token_start": 1019,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 236420,
      "end_ms": 238825,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 1028,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 239160,
      "end_ms": 240200,
      "text": "但凡学会三分，",
      "token_start": 1040,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 240460,
      "end_ms": 242885,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 1046,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 243210,
      "end_ms": 244925,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 1060,
      "token_end_exclusive": 1072
    }
