{
  "video_id": "v_8a0ef669cfb1a547",
  "duration_s": 472.583333,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_8a0ef669cfb1a547.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_8a0ef669cfb1a547.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 930,
      "text": "上集说到，",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1210,
      "end_ms": 1890,
      "text": "朱可臻，",
      "token_start": 4,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 2130,
      "end_ms": 5610,
      "text": "用十年时间建起了中国自己的气象网络。",
      "token_start": 7,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5990,
      "end_ms": 10630,
      "text": "一九三零年元旦发布了第一张全国天气预报。",
      "token_start": 24,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 12030,
      "end_ms": 13150,
      "text": "抗战爆发后，",
      "token_start": 43,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 13670,
      "end_ms": 15650,
      "text": "他抱着二十七箱仪器，",
      "token_start": 48,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 15810,
      "end_ms": 16610,
      "text": "一路撤退，",
      "token_start": 57,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 17410,
      "end_ms": 20090,
      "text": "炸弹在几百米外爆炸。",
      "token_start": 61,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 20830,
      "end_ms": 22230,
      "text": "他蹲在地上，",
      "token_start": 70,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 22270,
      "end_ms": 24570,
      "text": "祭数据头都不抬。",
      "token_start": 75,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 25770,
      "end_ms": 26670,
      "text": "可你知道吗？",
      "token_start": 82,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 28050,
      "end_ms": 29545,
      "text": "可在同一年，",
      "token_start": 87,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 31540,
      "end_ms": 32840,
      "text": "一九三六年，",
      "token_start": 92,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 33260,
      "end_ms": 37640,
      "text": "他还接了一个更烫手的山渝浙江大学校长。",
      "token_start": 97,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 38580,
      "end_ms": 41700,
      "text": "那时候的浙大经费紧缺，",
      "token_start": 115,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 42060,
      "end_ms": 43140,
      "text": "人心涣散，",
      "token_start": 125,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 43920,
      "end_ms": 46180,
      "text": "校长换了一茬又一茬，",
      "token_start": 129,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 46320,
      "end_ms": 47680,
      "text": "没人真心干事。",
      "token_start": 138,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 48680,
      "end_ms": 49720,
      "text": "朱可臻上任，",
      "token_start": 144,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 50140,
      "end_ms": 53000,
      "text": "先跑经费再定下两个字。",
      "token_start": 149,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 53120,
      "end_ms": 54800,
      "text": "当校训求是，",
      "token_start": 159,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 55640,
      "end_ms": 57980,
      "text": "他说只问是非，",
      "token_start": 164,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 58200,
      "end_ms": 59505,
      "text": "不计利害，",
      "token_start": 170,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 60080,
      "end_ms": 61220,
      "text": "大学不在大楼，",
      "token_start": 174,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 61440,
      "end_ms": 66825,
      "text": "在大师王淦昌、马一福这些名家都被他请了过来。",
      "token_start": 180,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 67560,
      "end_ms": 70315,
      "text": "他还留下了那句著名的哲大两问，",
      "token_start": 200,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 70870,
      "end_ms": 72375,
      "text": "你们到浙大来做什么，",
      "token_start": 214,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 72630,
      "end_ms": 73925,
      "text": "将来要做什么样的人？",
      "token_start": 223,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 74650,
      "end_ms": 76030,
      "text": "没安稳几年。",
      "token_start": 232,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 76350,
      "end_ms": 78865,
      "text": "抗战烽火就烧到了江南。",
      "token_start": 237,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 80180,
      "end_ms": 82000,
      "text": "为了保住读书的火种，",
      "token_start": 247,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 82020,
      "end_ms": 86990,
      "text": "朱可贞带着全校师生西迁两千六百多公里，",
      "token_start": 256,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 86990,
      "end_ms": 88640,
      "text": "路走了两年多，",
      "token_start": 274,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 88920,
      "end_ms": 91250,
      "text": "跨了四个省庙里上课，",
      "token_start": 280,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 91630,
      "end_ms": 92550,
      "text": "石板当桌，",
      "token_start": 289,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 92930,
      "end_ms": 93995,
      "text": "再苦再难，",
      "token_start": 293,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 94350,
      "end_ms": 95775,
      "text": "没停过一天课。",
      "token_start": 297,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 96420,
      "end_ms": 97245,
      "text": "这一路上，",
      "token_start": 303,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 97630,
      "end_ms": 100730,
      "text": "他的次子染病走了没过多久，",
      "token_start": 307,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 101070,
      "end_ms": 104085,
      "text": "妻子也操劳过度撒手人寰。",
      "token_start": 319,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 104830,
      "end_ms": 105950,
      "text": "短短几个月，",
      "token_start": 330,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 106190,
      "end_ms": 107855,
      "text": "丧子丧妻，",
      "token_start": 335,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 108460,
      "end_ms": 110835,
      "text": "他把眼泪往肚子里咽，",
      "token_start": 339,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 112480,
      "end_ms": 113245,
      "text": "转过身，",
      "token_start": 348,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 113750,
      "end_ms": 115655,
      "text": "依旧站在队伍最前面，",
      "token_start": 351,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 116000,
      "end_ms": 117455,
      "text": "带着浙大往前走。",
      "token_start": 360,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 118340,
      "end_ms": 119720,
      "text": "学生们后来回忆说，",
      "token_start": 367,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 120120,
      "end_ms": 121020,
      "text": "那段日子，",
      "token_start": 375,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 121060,
      "end_ms": 123215,
      "text": "竹校长的背好像更弯了，",
      "token_start": 379,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 123870,
      "end_ms": 125955,
      "text": "但脚步却从来没停过。",
      "token_start": 389,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 126890,
      "end_ms": 128910,
      "text": "就是在这样的逃难路上，",
      "token_start": 398,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 129230,
      "end_ms": 132675,
      "text": "王淦昌研究出了中微子探测方法，",
      "token_start": 408,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 133190,
      "end_ms": 137280,
      "text": "科研的火种从来没灭过他当了十三年。",
      "token_start": 422,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 137380,
      "end_ms": 145255,
      "text": "浙大校长把一所普通地方学校扮成了能跟顶尖学府比肩的强校，",
      "token_start": 438,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 145710,
      "end_ms": 147065,
      "text": "培养出了李政道。",
      "token_start": 465,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 147860,
      "end_ms": 148580,
      "text": "陈开甲，",
      "token_start": 472,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 148600,
      "end_ms": 150225,
      "text": "一个个国之栋梁。",
      "token_start": 475,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 150740,
      "end_ms": 152595,
      "text": "李政道后来拿了诺贝尔奖，",
      "token_start": 482,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 153360,
      "end_ms": 155975,
      "text": "程开甲成了两弹一星元勋。",
      "token_start": 493,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 157000,
      "end_ms": 158105,
      "text": "一九四九年，",
      "token_start": 504,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 158620,
      "end_ms": 160960,
      "text": "有人三次登门请他去台湾，",
      "token_start": 509,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 161000,
      "end_ms": 162285,
      "text": "他次次都回绝了，",
      "token_start": 520,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 163180,
      "end_ms": 164600,
      "text": "他要留在这片土地上，",
      "token_start": 527,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 164860,
      "end_ms": 166135,
      "text": "跟师生在一起，",
      "token_start": 536,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 166420,
      "end_ms": 167805,
      "text": "跟新中国在一起。",
      "token_start": 542,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 168510,
      "end_ms": 169770,
      "text": "新中国成立后，",
      "token_start": 549,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 170070,
      "end_ms": 172545,
      "text": "逐可臻已经年过花甲，",
      "token_start": 555,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 172950,
      "end_ms": 174145,
      "text": "可他依旧没歇着。",
      "token_start": 564,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 174720,
      "end_ms": 178595,
      "text": "他带着学生走遍全中国考察自然资源，",
      "token_start": 571,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 179180,
      "end_ms": 182275,
      "text": "从东北临海到青藏高原，",
      "token_start": 587,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 182680,
      "end_ms": 184820,
      "text": "从新疆戈壁到海南，",
      "token_start": 597,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 185080,
      "end_ms": 185635,
      "text": "榆林，",
      "token_start": 605,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 185930,
      "end_ms": 187425,
      "text": "哪里艰苦往哪里去，",
      "token_start": 607,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 188190,
      "end_ms": 189525,
      "text": "六十几岁的人了，",
      "token_start": 615,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 189980,
      "end_ms": 192125,
      "text": "跟着年轻人一起爬山。",
      "token_start": 622,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 192520,
      "end_ms": 194345,
      "text": "汤和水住帐篷，",
      "token_start": 631,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 195270,
      "end_ms": 197810,
      "text": "他随身带的还是那只温度计。",
      "token_start": 637,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 197870,
      "end_ms": 198750,
      "text": "每到一处，",
      "token_start": 649,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 198970,
      "end_ms": 202195,
      "text": "第一件事就是测气温记数据，",
      "token_start": 653,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 202690,
      "end_ms": 203955,
      "text": "学生们偷偷说，",
      "token_start": 665,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 204370,
      "end_ms": 207230,
      "text": "竹老的笔记本摞起来比镯子还高，",
      "token_start": 671,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 207670,
      "end_ms": 212495,
      "text": "上面的字迹工工整整数十年如一日。",
      "token_start": 685,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 213130,
      "end_ms": 215515,
      "text": "从一九三六年到一九七四年，",
      "token_start": 700,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 215990,
      "end_ms": 217495,
      "text": "整整三十八年，",
      "token_start": 712,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 218270,
      "end_ms": 219955,
      "text": "他每天早上起床，",
      "token_start": 718,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 220310,
      "end_ms": 224055,
      "text": "第一件事就是看云看风，",
      "token_start": 725,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 224490,
      "end_ms": 225465,
      "text": "看气温，",
      "token_start": 735,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 226010,
      "end_ms": 227195,
      "text": "然后记下来。",
      "token_start": 738,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 228720,
      "end_ms": 231670,
      "text": "今天几点刮风刮的什么风，",
      "token_start": 743,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 232090,
      "end_ms": 233635,
      "text": "几朵云什么形状，",
      "token_start": 754,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 234120,
      "end_ms": 235560,
      "text": "燕子什么时候飞来，",
      "token_start": 761,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 235600,
      "end_ms": 236800,
      "text": "桃花什么时候开，",
      "token_start": 769,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 237080,
      "end_ms": 237885,
      "text": "全在里面。",
      "token_start": 776,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 238370,
      "end_ms": 241715,
      "text": "你可能觉得这不就是个老头写天气日记吗？",
      "token_start": 780,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 242010,
      "end_ms": 245185,
      "text": "不是的这四百多万字的日记，",
      "token_start": 798,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 245530,
      "end_ms": 251825,
      "text": "后来成了中国近现代最完整的气候变化原始档案。",
      "token_start": 810,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 252330,
      "end_ms": 255805,
      "text": "科学家研究中国几十年的气候规律，",
      "token_start": 831,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 256120,
      "end_ms": 258865,
      "text": "物候变迁离不开这份记录。",
      "token_start": 846,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 259360,
      "end_ms": 260635,
      "text": "有研究人员说，",
      "token_start": 857,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 261040,
      "end_ms": 265435,
      "text": "逐可珍的日记就是中国半个世纪的天气底稿，",
      "token_start": 863,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 265880,
      "end_ms": 270270,
      "text": "他一个人用一支笔干了一个气象局几百人。",
      "token_start": 882,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 270310,
      "end_ms": 272775,
      "text": "该干的事更让人敬佩的是，",
      "token_start": 900,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 273120,
      "end_ms": 273920,
      "text": "到了晚年，",
      "token_start": 911,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 274260,
      "end_ms": 276365,
      "text": "他一头扎进了古籍里，",
      "token_start": 915,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 277150,
      "end_ms": 279965,
      "text": "从二十四史到几千部方制，",
      "token_start": 924,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 280350,
      "end_ms": 281705,
      "text": "他一点点梳理，",
      "token_start": 935,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 282490,
      "end_ms": 289625,
      "text": "硬是从浩如烟海的史料中找出了中国五千多年气候变迁的规律。",
      "token_start": 941,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 290570,
      "end_ms": 295855,
      "text": "一九七二年那篇中国近五千年来气候变迁的初步研究发表，",
      "token_start": 968,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 296310,
      "end_ms": 297485,
      "text": "震惊了全世界。",
      "token_start": 993,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 298310,
      "end_ms": 300030,
      "text": "从古代王朝兴衰，",
      "token_start": 999,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 300170,
      "end_ms": 300850,
      "text": "到今天，",
      "token_start": 1006,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 300890,
      "end_ms": 303350,
      "text": "咱们治沙调水搞西部，",
      "token_start": 1009,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 303350,
      "end_ms": 305685,
      "text": "建设很多决策的底气。",
      "token_start": 1018,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 306150,
      "end_ms": 307790,
      "text": "都来自他当年的研究。",
      "token_start": 1027,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 307970,
      "end_ms": 310430,
      "text": "一九七四年二月六日深夜，",
      "token_start": 1036,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 310750,
      "end_ms": 314009,
      "text": "八十四岁的朱可臻躺在病床上，",
      "token_start": 1047,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 314550,
      "end_ms": 316130,
      "text": "手指已经没有力气，",
      "token_start": 1060,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 316130,
      "end_ms": 319270,
      "text": "握笔了却还在长子的搀扶下，",
      "token_start": 1068,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 319750,
      "end_ms": 322330,
      "text": "颤抖着写完最后一行字，",
      "token_start": 1080,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 322810,
      "end_ms": 324430,
      "text": "他喃喃自语哦，",
      "token_start": 1090,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 324790,
      "end_ms": 326390,
      "text": "原来今天这么冷啊，",
      "token_start": 1096,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 327330,
      "end_ms": 329150,
      "text": "这是他最后一次问天。",
      "token_start": 1104,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 330230,
      "end_ms": 332450,
      "text": "第二天他走了，",
      "token_start": 1113,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 333430,
      "end_ms": 337140,
      "text": "他这一辈子只做了一件事，",
      "token_start": 1119,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 338280,
      "end_ms": 343500,
      "text": "让中国人知道自己头顶上的天到底是什么性格。",
      "token_start": 1130,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 344720,
      "end_ms": 346600,
      "text": "有人问什么叫爱国？",
      "token_start": 1150,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 346880,
      "end_ms": 351520,
      "text": "我想就是像朱可臻这样把一只温度计装进口袋，",
      "token_start": 1158,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 351820,
      "end_ms": 354260,
      "text": "然后用了整整三十八年，",
      "token_start": 1178,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 354560,
      "end_ms": 356000,
      "text": "把这件事做到底。",
      "token_start": 1188,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 356600,
      "end_ms": 357860,
      "text": "他没有请史，",
      "token_start": 1195,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 358200,
      "end_ms": 359120,
      "text": "没有绯闻，",
      "token_start": 1200,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 359480,
      "end_ms": 361080,
      "text": "没有戏剧性的八卦，",
      "token_start": 1204,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 361580,
      "end_ms": 363600,
      "text": "就是一个闷头干活，",
      "token_start": 1212,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 363800,
      "end_ms": 365725,
      "text": "一辈子看云际风的老头。",
      "token_start": 1220,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 366300,
      "end_ms": 369305,
      "text": "可我觉得这才是最了不起的地方。",
      "token_start": 1230,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 369830,
      "end_ms": 372355,
      "text": "轰轰烈烈的人生很多人会过，",
      "token_start": 1244,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 372770,
      "end_ms": 376350,
      "text": "但你见过几个人能把一件枯燥的事做三十八年，",
      "token_start": 1256,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 376350,
      "end_ms": 383810,
      "text": "一天不断见过几个人在生命最后一天还在认真完成自己一辈子的功课，",
      "token_start": 1276,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 384030,
      "end_ms": 386645,
      "text": "像朱可珍这样的人还有很多，",
      "token_start": 1306,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 387190,
      "end_ms": 389515,
      "text": "他们干着惊天动地的事，",
      "token_start": 1318,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 389880,
      "end_ms": 391805,
      "text": "做着隐姓埋名的人，",
      "token_start": 1328,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 392420,
      "end_ms": 393140,
      "text": "不求名，",
      "token_start": 1336,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 393160,
      "end_ms": 393935,
      "text": "不求利，",
      "token_start": 1339,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 394250,
      "end_ms": 398675,
      "text": "就想让后世子孙能挺直腰杆做人。",
      "token_start": 1342,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 399480,
      "end_ms": 401955,
      "text": "如果你想知道更多他们的故事，",
      "token_start": 1356,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 402530,
      "end_ms": 404975,
      "text": "推荐你看看国之脊两这本书。",
      "token_start": 1369,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 405840,
      "end_ms": 411995,
      "text": "书里记录了几十位为新中国立下汗马功劳的科学家和建设者。",
      "token_start": 1381,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 412560,
      "end_ms": 414175,
      "text": "有我们熟悉的名字，",
      "token_start": 1407,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 414600,
      "end_ms": 417785,
      "text": "也有像朱可珍这样被时光淡忘，",
      "token_start": 1415,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 418180,
      "end_ms": 420315,
      "text": "却同样不该被遗忘的人。",
      "token_start": 1428,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 420990,
      "end_ms": 425725,
      "text": "每一个名字背后都是一段拿命拼出来的传奇。",
      "token_start": 1438,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 426130,
      "end_ms": 427215,
      "text": "读完你会明白，",
      "token_start": 1457,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 428260,
      "end_ms": 431785,
      "text": "今天的安稳日子不是天上掉下来的，",
      "token_start": 1463,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 432270,
      "end_ms": 435625,
      "text": "是有人用一辈子替我们扛下来的。",
      "token_start": 1478,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 437530,
      "end_ms": 438775,
      "text": "点下方链接，",
      "token_start": 1492,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 439230,
      "end_ms": 441075,
      "text": "把这本书带回家，",
      "token_start": 1497,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 441400,
      "end_ms": 442060,
      "text": "自己读，",
      "token_start": 1504,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 442460,
      "end_ms": 443575,
      "text": "也给孩子读，",
      "token_start": 1507,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 444110,
      "end_ms": 448845,
      "text": "让我们的下一代知道谁才是真正该追的星。",
      "token_start": 1512,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 449570,
      "end_ms": 452450,
      "text": "他用一只温度计量了三十八年，",
      "token_start": 1530,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 452450,
      "end_ms": 453195,
      "text": "中国的天，",
      "token_start": 1543,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 453880,
      "end_ms": 457535,
      "text": "一个倔老头做了一辈子该做的事。",
      "token_start": 1547,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 458610,
      "end_ms": 460795,
      "text": "点赞是给他的掌声。",
      "token_start": 1561,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 461150,
      "end_ms": 468725,
      "text": "转发是让更多人知道收藏是怕忘了今天的安稳从哪来关注我，",
      "token_start": 1569,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 468960,
      "end_ms": 472475,
      "text": "咱们一起把该记住的人一个一个讲完。",
      "token_start": 1595,
      "token_end_exclusive": 1611
    }
  ],
