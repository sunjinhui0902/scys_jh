{
  "video_id": "v_f531fac7d333139d",
  "duration_s": 270.6039,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f531fac7d333139d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f531fac7d333139d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 590,
      "text": "李恩，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 890,
      "end_ms": 2730,
      "text": "你把我后备箱里的茅台拿上去，",
      "token_start": 2,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3050,
      "end_ms": 3870,
      "text": "领导的暗示，",
      "token_start": 15,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4010,
      "end_ms": 5010,
      "text": "你能听得懂吗？",
      "token_start": 20,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5170,
      "end_ms": 5730,
      "text": "没有啊，",
      "token_start": 26,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6010,
      "end_ms": 8670,
      "text": "哎被偷你干什么？",
      "token_start": 29,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8770,
      "end_ms": 9110,
      "text": "赵总，",
      "token_start": 36,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 9110,
      "end_ms": 9970,
      "text": "茅台都被偷了，",
      "token_start": 38,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 9970,
      "end_ms": 11410,
      "text": "你为什么不让我说呀？",
      "token_start": 44,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 11750,
      "end_ms": 13450,
      "text": "赵总能不知道车里有没有酒吗？",
      "token_start": 53,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 13530,
      "end_ms": 13850,
      "text": "不是，",
      "token_start": 66,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 13850,
      "end_ms": 15790,
      "text": "这职场上理会错，",
      "token_start": 68,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 15790,
      "end_ms": 17030,
      "text": "领导的意思是大忌。",
      "token_start": 75,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 17310,
      "end_ms": 18170,
      "text": "车里没有酒，",
      "token_start": 83,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 18410,
      "end_ms": 19730,
      "text": "赵总却让你送上去，",
      "token_start": 88,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 19910,
      "end_ms": 21210,
      "text": "说明他只在意结果，",
      "token_start": 96,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 21410,
      "end_ms": 24150,
      "text": "你又何必去纠结车里酒的去向和真实性呢？",
      "token_start": 104,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 24230,
      "end_ms": 26210,
      "text": "满足领导的需求最重要哦，",
      "token_start": 122,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 29290,
      "end_ms": 29670,
      "text": "赵总，",
      "token_start": 133,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 30170,
      "end_ms": 31690,
      "text": "您车里的东西我不好乱翻，",
      "token_start": 135,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 31830,
      "end_ms": 32510,
      "text": "就自己准备了。",
      "token_start": 146,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 32510,
      "end_ms": 34070,
      "text": "四瓶两瓶留在您车里，",
      "token_start": 152,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 34070,
      "end_ms": 35310,
      "text": "这两瓶拿上来您先用。",
      "token_start": 161,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 36150,
      "end_ms": 36955,
      "text": "好好好，",
      "token_start": 170,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 40520,
      "end_ms": 45320,
      "text": "我赵总，",
      "token_start": 173,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 45660,
      "end_ms": 46580,
      "text": "咱们下次见。",
      "token_start": 176,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 46700,
      "end_ms": 47115,
      "text": "好，",
      "token_start": 181,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 50800,
      "end_ms": 51220,
      "text": "刘总，",
      "token_start": 182,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 51440,
      "end_ms": 52360,
      "text": "你怎么走了呀，",
      "token_start": 184,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 52360,
      "end_ms": 53760,
      "text": "是不是嫌报价不满意啊？",
      "token_start": 190,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 56960,
      "end_ms": 57700,
      "text": "恭喜赵总，",
      "token_start": 200,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 57720,
      "end_ms": 60125,
      "text": "拿下合同李恩，",
      "token_start": 204,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 60620,
      "end_ms": 62165,
      "text": "后续项目你来负责吧。",
      "token_start": 210,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 63810,
      "end_ms": 63990,
      "text": "嗯，",
      "token_start": 219,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 63990,
      "end_ms": 65240,
      "text": "不哎哎，",
      "token_start": 220,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 65240,
      "end_ms": 68455,
      "text": "赵总这哎老婆这怎么回事儿？",
      "token_start": 223,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 68710,
      "end_ms": 70330,
      "text": "这个项目一直是刘涛在负责，",
      "token_start": 235,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 70530,
      "end_ms": 72055,
      "text": "赵总突然把项目给我了。",
      "token_start": 247,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 72510,
      "end_ms": 74430,
      "text": "茶汤回湖是谈判的收尾动作，",
      "token_start": 257,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 74530,
      "end_ms": 75630,
      "text": "象征着交易达成。",
      "token_start": 269,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 75830,
      "end_ms": 76870,
      "text": "刘涛连这个都不懂，",
      "token_start": 276,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 76870,
      "end_ms": 78315,
      "text": "赵总怎么敢把项目给他呀？",
      "token_start": 284,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 78620,
      "end_ms": 79205,
      "text": "不能吧，",
      "token_start": 295,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 79580,
      "end_ms": 80340,
      "text": "人情世故，",
      "token_start": 298,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 80340,
      "end_ms": 81355,
      "text": "可是门大学问，",
      "token_start": 302,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 81680,
      "end_ms": 82495,
      "text": "你要学的呀，",
      "token_start": 308,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 82670,
      "end_ms": 83205,
      "text": "还多着呢。",
      "token_start": 313,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 85890,
      "end_ms": 86315,
      "text": "老婆，",
      "token_start": 317,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 86600,
      "end_ms": 87820,
      "text": "赵总把上次的酒钱转过来了，",
      "token_start": 319,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 87820,
      "end_ms": 89510,
      "text": "你看哎，",
      "token_start": 331,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 89510,
      "end_ms": 90330,
      "text": "你怎么收了呀？",
      "token_start": 334,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 90330,
      "end_ms": 90790,
      "text": "赵总转多，",
      "token_start": 340,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 90790,
      "end_ms": 91665,
      "text": "你赶紧给退回去。",
      "token_start": 344,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 91870,
      "end_ms": 93310,
      "text": "你自以为有原则的退还，",
      "token_start": 351,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 93550,
      "end_ms": 94975,
      "text": "只会让领导觉得更麻烦，",
      "token_start": 361,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 95430,
      "end_ms": 96870,
      "text": "还不如大大方方收下呢。",
      "token_start": 371,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 96870,
      "end_ms": 98230,
      "text": "那我是不是得说点啥呀？",
      "token_start": 381,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 98250,
      "end_ms": 98410,
      "text": "嗯，",
      "token_start": 391,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 98410,
      "end_ms": 99730,
      "text": "你就说感谢领导，",
      "token_start": 392,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 99730,
      "end_ms": 100090,
      "text": "大气，",
      "token_start": 399,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 100090,
      "end_ms": 102870,
      "text": "果然跟着领导有甜头吃这样就行了。",
      "token_start": 401,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 102990,
      "end_ms": 103965,
      "text": "当然不行啊。",
      "token_start": 416,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 106210,
      "end_ms": 106430,
      "text": "来，",
      "token_start": 421,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 106430,
      "end_ms": 106770,
      "text": "赵总，",
      "token_start": 422,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 106770,
      "end_ms": 108010,
      "text": "请大家喝奶茶了啊，",
      "token_start": 424,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 108010,
      "end_ms": 108955,
      "text": "人人都有，",
      "token_start": 432,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 110420,
      "end_ms": 112180,
      "text": "我什么时候请大家喝奶茶了？",
      "token_start": 436,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 112320,
      "end_ms": 112820,
      "text": "奶茶钱，",
      "token_start": 448,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 112820,
      "end_ms": 114605,
      "text": "您不跟酒钱一块转给我了吗？",
      "token_start": 451,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 117400,
      "end_ms": 119640,
      "text": "李恩周天来家里坐坐，",
      "token_start": 463,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 119800,
      "end_ms": 120160,
      "text": "尝尝，",
      "token_start": 472,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 120160,
      "end_ms": 121035,
      "text": "你嫂子手艺，",
      "token_start": 474,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 121780,
      "end_ms": 122085,
      "text": "嗨，",
      "token_start": 479,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 125710,
      "end_ms": 126150,
      "text": "嫂子，",
      "token_start": 480,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 126250,
      "end_ms": 127310,
      "text": "你可算出来了，",
      "token_start": 482,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 127310,
      "end_ms": 128275,
      "text": "我都快憋死了。",
      "token_start": 488,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 128760,
      "end_ms": 132540,
      "text": "嗯嗯，",
      "token_start": 494,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 133580,
      "end_ms": 134520,
      "text": "你拉我干什么？",
      "token_start": 496,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 134520,
      "end_ms": 135560,
      "text": "我也很急啊，",
      "token_start": 502,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 135740,
      "end_ms": 136735,
      "text": "憋死我了。",
      "token_start": 507,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 137510,
      "end_ms": 137800,
      "text": "嗯，",
      "token_start": 511,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 138220,
      "end_ms": 138780,
      "text": "不知道的，",
      "token_start": 512,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 138780,
      "end_ms": 140700,
      "text": "还以为洗手间是什么好地方。",
      "token_start": 516,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 140900,
      "end_ms": 141300,
      "text": "哎呀，",
      "token_start": 528,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 141340,
      "end_ms": 142045,
      "text": "行了，",
      "token_start": 530,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 142770,
      "end_ms": 143790,
      "text": "你们坐我去做饭，",
      "token_start": 532,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 143950,
      "end_ms": 145425,
      "text": "老赵帮我处理一下鱼，",
      "token_start": 539,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 147260,
      "end_ms": 147715,
      "text": "老婆，",
      "token_start": 548,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 148290,
      "end_ms": 148750,
      "text": "我怎么看？",
      "token_start": 550,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 148750,
      "end_ms": 150485,
      "text": "赵总和嫂子有点不高兴啊，",
      "token_start": 554,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 150750,
      "end_ms": 153125,
      "text": "哎因为异性厕所十分钟效应，",
      "token_start": 565,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 153490,
      "end_ms": 155370,
      "text": "人家赵总老婆刚从卫生间出来，",
      "token_start": 577,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 155370,
      "end_ms": 156310,
      "text": "你就算再着急，",
      "token_start": 590,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 156310,
      "end_ms": 156970,
      "text": "也等十分钟，",
      "token_start": 596,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 156970,
      "end_ms": 159935,
      "text": "再怎么可能是因为这个你照做就行。",
      "token_start": 601,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 160490,
      "end_ms": 160910,
      "text": "嫂子，",
      "token_start": 616,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 161050,
      "end_ms": 161705,
      "text": "我来帮你。",
      "token_start": 618,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 162120,
      "end_ms": 163105,
      "text": "赵总嫂子，",
      "token_start": 622,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 163500,
      "end_ms": 164215,
      "text": "那我走了，",
      "token_start": 626,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 165140,
      "end_ms": 166140,
      "text": "嗯嗯，",
      "token_start": 630,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 167160,
      "end_ms": 168255,
      "text": "那我们也先走，",
      "token_start": 632,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 168940,
      "end_ms": 171885,
      "text": "李恩留下接待王总的事情，",
      "token_start": 638,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 172330,
      "end_ms": 173235,
      "text": "咱们再碰一下，",
      "token_start": 649,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 173930,
      "end_ms": 174990,
      "text": "那得叫张强回来啊，",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 174990,
      "end_ms": 176815,
      "text": "不用你负责就行。",
      "token_start": 663,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 179480,
      "end_ms": 180790,
      "text": "哎哎，",
      "token_start": 670,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 180790,
      "end_ms": 181265,
      "text": "老婆，",
      "token_start": 672,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 181700,
      "end_ms": 184755,
      "text": "你这个厕所十分钟效应还真有说法，",
      "token_start": 674,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 185110,
      "end_ms": 186875,
      "text": "这都是不成文的社交规则。",
      "token_start": 689,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 187300,
      "end_ms": 190110,
      "text": "你呀多看看这本闲谈高手吧。",
      "token_start": 700,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 190150,
      "end_ms": 191310,
      "text": "假如你不爱说话，",
      "token_start": 712,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 191370,
      "end_ms": 192130,
      "text": "不爱争辩，",
