{
  "video_id": "v_f72848ff9c5f770d",
  "duration_s": 431.775896,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f72848ff9c5f770d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f72848ff9c5f770d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 300,
      "end_ms": 4660,
      "text": "您知道中国最绝美的秋日古村落是哪一个吗？",
      "token_start": 0,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 5140,
      "end_ms": 9080,
      "text": "有人说是洪村近九百年的徽州水乡，",
      "token_start": 19,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 9300,
      "end_ms": 12020,
      "text": "一池秋水倒映着半个村子。",
      "token_start": 34,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12380,
      "end_ms": 16500,
      "text": "有人说是黄岭屋顶上摆满五彩的竹匾，",
      "token_start": 45,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 16860,
      "end_ms": 19800,
      "text": "一晒就是几百年错了，",
      "token_start": 61,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 20480,
      "end_ms": 22920,
      "text": "红村在上级就得讲完，",
      "token_start": 70,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 23400,
      "end_ms": 25180,
      "text": "黄岭也拿不到头名。",
      "token_start": 79,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 25600,
      "end_ms": 28120,
      "text": "真正排在榜首的那个村子，",
      "token_start": 87,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 28240,
      "end_ms": 29140,
      "text": "不是水乡，",
      "token_start": 98,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 29440,
      "end_ms": 30390,
      "text": "不是晒秋，",
      "token_start": 102,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 31110,
      "end_ms": 35270,
      "text": "整座村子就挂在一道大峡谷的峭壁边上。",
      "token_start": 106,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 35910,
      "end_ms": 36770,
      "text": "到了秋天，",
      "token_start": 123,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 37130,
      "end_ms": 39630,
      "text": "漫山红叶黄叶的头顶上，",
      "token_start": 127,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 39990,
      "end_ms": 42150,
      "text": "压着终年不化的积雪。",
      "token_start": 137,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 42490,
      "end_ms": 47830,
      "text": "今天咱们就来盘点中国十大最绝美的秋日古村落。",
      "token_start": 146,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 48530,
      "end_ms": 49330,
      "text": "话不多说，",
      "token_start": 167,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 49930,
      "end_ms": 51190,
      "text": "茶给您切好了，",
      "token_start": 171,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 51490,
      "end_ms": 53390,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 177,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 53750,
      "end_ms": 54710,
      "text": "咱们这就开讲。",
      "token_start": 187,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 55070,
      "end_ms": 55790,
      "text": "第十名。",
      "token_start": 193,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 56210,
      "end_ms": 59270,
      "text": "指南村浙江杭州话，",
      "token_start": 196,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 59270,
      "end_ms": 61260,
      "text": "是想看江南的秋天。",
      "token_start": 204,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 61540,
      "end_ms": 73315,
      "text": "老底子杭州人第一反应准是他这座藏在临安六百米高山上的古老村落村里村外长得近五百棵数百年树龄的古树，",
      "token_start": 212,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 73880,
      "end_ms": 77280,
      "text": "单是明清留下来的古银杏和古风香，",
      "token_start": 260,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 77520,
      "end_ms": 79670,
      "text": "就有三百多克老屋，",
      "token_start": 275,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 79710,
      "end_ms": 83115,
      "text": "依着太湖源头的山势层叠错落。",
      "token_start": 283,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 83650,
      "end_ms": 84650,
      "text": "几百年来，",
      "token_start": 296,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 84990,
      "end_ms": 87370,
      "text": "村民就守着这片古树林，",
      "token_start": 300,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 87530,
      "end_ms": 88725,
      "text": "耕山种茶。",
      "token_start": 310,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 89160,
      "end_ms": 90585,
      "text": "每到深秋十一月，",
      "token_start": 314,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 90970,
      "end_ms": 95175,
      "text": "几百颗金黄的银杏和火红的枫箱遮天蔽日，",
      "token_start": 321,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 95660,
      "end_ms": 97855,
      "text": "红、黄落叶铺满青石台阶，",
      "token_start": 339,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 98170,
      "end_ms": 98905,
      "text": "风一吹，",
      "token_start": 349,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 99310,
      "end_ms": 102605,
      "text": "整座村子宛如浮在五彩云霞里。",
      "token_start": 352,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 103050,
      "end_ms": 105015,
      "text": "您踩着落叶往村里走，",
      "token_start": 365,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 105520,
      "end_ms": 107185,
      "text": "脚底下沙沙作响，",
      "token_start": 374,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 107590,
      "end_ms": 109885,
      "text": "满眼都是温润的暖色。",
      "token_start": 381,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 110710,
      "end_ms": 113955,
      "text": "这份藏在江南深处的秋日层次，",
      "token_start": 390,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 114610,
      "end_ms": 117595,
      "text": "您说算不算给秋天开了个好头？",
      "token_start": 403,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 117980,
      "end_ms": 118675,
      "text": "第九名，",
      "token_start": 416,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 119010,
      "end_ms": 120880,
      "text": "塔川安徽一县，",
      "token_start": 419,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 121540,
      "end_ms": 122740,
      "text": "他就挨着洪村，",
      "token_start": 425,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 123460,
      "end_ms": 125800,
      "text": "是个不大的徽派小山村，",
      "token_start": 431,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 126240,
      "end_ms": 127360,
      "text": "可秋天来了，",
      "token_start": 441,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 127500,
      "end_ms": 129200,
      "text": "名气一点不输邻居。",
      "token_start": 446,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 129740,
      "end_ms": 132620,
      "text": "塔川最出名的是村子四周，",
      "token_start": 454,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 132740,
      "end_ms": 134640,
      "text": "漫山遍野的乌漆树。",
      "token_start": 465,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 135040,
      "end_ms": 139860,
      "text": "乌渠这种树叶子变色是一步步来的，",
      "token_start": 473,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 140520,
      "end_ms": 142000,
      "text": "先由绿转黄，",
      "token_start": 488,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 142720,
      "end_ms": 144280,
      "text": "再从黄变橙，",
      "token_start": 493,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 144720,
      "end_ms": 147220,
      "text": "最后红的像着了火。",
      "token_start": 498,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 147680,
      "end_ms": 149735,
      "text": "十月下旬到十一月，",
      "token_start": 506,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 150610,
      "end_ms": 152210,
      "text": "同一面山坡上，",
      "token_start": 514,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 153050,
      "end_ms": 156350,
      "text": "绿的黄的、橙的、红的全摆在一起，",
      "token_start": 520,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 157190,
      "end_ms": 159330,
      "text": "像打翻了的调色盘。",
      "token_start": 533,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 160270,
      "end_ms": 161310,
      "text": "更妙的是，",
      "token_start": 541,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 161790,
      "end_ms": 167110,
      "text": "红叶底下还藏着粉墙黛瓦的老房子，",
      "token_start": 545,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 167610,
      "end_ms": 169990,
      "text": "颜色一浓一淡，",
      "token_start": 560,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 170290,
      "end_ms": 171610,
      "text": "一焰一素，",
      "token_start": 566,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 172130,
      "end_ms": 173710,
      "text": "摄影的人天不亮，",
      "token_start": 570,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 173830,
      "end_ms": 175850,
      "text": "就扛着相机往山上爬，",
      "token_start": 577,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 176150,
      "end_ms": 177590,
      "text": "就为等着一层光。",
      "token_start": 586,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 178110,
      "end_ms": 179840,
      "text": "您说这样的秋天，",
      "token_start": 593,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 179900,
      "end_ms": 181980,
      "text": "天谁看了不想多留几天。",
      "token_start": 600,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 182280,
      "end_ms": 182940,
      "text": "第八名，",
      "token_start": 610,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 183580,
      "end_ms": 184800,
      "text": "肇兴洞寨，",
      "token_start": 613,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 185340,
      "end_ms": 186420,
      "text": "贵州黎平，",
      "token_start": 617,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 187240,
      "end_ms": 189100,
      "text": "它号称千户洞寨，",
      "token_start": 621,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 189460,
      "end_ms": 192640,
      "text": "是全国规模最大的侗族村寨之一。",
      "token_start": 628,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 193040,
      "end_ms": 195580,
      "text": "寨子里立着五座鼓楼，",
      "token_start": 642,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 195979,
      "end_ms": 197720,
      "text": "一座座高高的木楼，",
      "token_start": 651,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 198020,
      "end_ms": 199760,
      "text": "层层叠叠的飞檐，",
      "token_start": 659,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 200120,
      "end_ms": 202080,
      "text": "据说全靠榫卯，",
      "token_start": 666,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 202080,
      "end_ms": 204120,
      "text": "咬合不用一颗铁钉。",
      "token_start": 672,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 204880,
      "end_ms": 207420,
      "text": "鼓楼周围是成片的吊脚楼。",
      "token_start": 680,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 207840,
      "end_ms": 211390,
      "text": "顺着山坡铺开秋收的时候，",
      "token_start": 691,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 211810,
      "end_ms": 214450,
      "text": "寨子四周的稻田全黄了，",
      "token_start": 702,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 215130,
      "end_ms": 218390,
      "text": "金灿灿的道浪一直涌到房脚下，",
      "token_start": 712,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 219010,
      "end_ms": 222230,
      "text": "家家户户的合架上都亮满了稻鼓。",
      "token_start": 725,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 223010,
      "end_ms": 228750,
      "text": "鼓楼是侗家人议事聚会、唱歌的地方。",
      "token_start": 739,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 229550,
      "end_ms": 236890,
      "text": "侗族大歌就是在这样的楼下唱出来的金黄的田木头的楼，",
      "token_start": 754,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 237470,
      "end_ms": 238690,
      "text": "再配上歌声。",
      "token_start": 778,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 239110,
      "end_ms": 244525,
      "text": "您说这是不是一副活着的丰收图第七名，",
      "token_start": 783,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 245390,
      "end_ms": 246895,
      "text": "太行山大商村，",
      "token_start": 800,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 247640,
      "end_ms": 249285,
      "text": "山西阳泉盂县。",
      "token_start": 806,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 250080,
      "end_ms": 252665,
      "text": "如果说前面几个是南方的温柔，",
      "token_start": 812,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 253180,
      "end_ms": 255235,
      "text": "那他就是北方的硬骨头。",
      "token_start": 825,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 255860,
      "end_ms": 258205,
      "text": "他建在太行山的悬崖边上，",
      "token_start": 835,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 258560,
      "end_ms": 260425,
      "text": "据说有一千多年的历史。",
      "token_start": 846,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 260940,
      "end_ms": 262905,
      "text": "房子全是石头垒的墙，",
      "token_start": 856,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 263380,
      "end_ms": 264535,
      "text": "石板盖的顶，",
      "token_start": 865,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 264860,
      "end_ms": 267035,
      "text": "一层层贴着崖壁往上挪，",
      "token_start": 870,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 267490,
      "end_ms": 271465,
      "text": "远远看去像一座挂在山上的小布达拉宫。",
      "token_start": 880,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 272020,
      "end_ms": 274500,
      "text": "深秋一到崖壁上，",
      "token_start": 897,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 274540,
      "end_ms": 278185,
      "text": "红叶烧成一片家家户户的墙头，",
      "token_start": 904,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 278810,
      "end_ms": 283425,
      "text": "树梢上挂满惊鸿的柿子红的叶红的柿，",
      "token_start": 917,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 283970,
      "end_ms": 285755,
      "text": "趁着灰青的石头屋，",
      "token_start": 933,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 286500,
      "end_ms": 288135,
      "text": "苍镜里透着热烈，",
      "token_start": 941,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 288840,
      "end_ms": 289925,
      "text": "住在这里的人，",
      "token_start": 948,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 290290,
      "end_ms": 292225,
      "text": "一辈子跟石头打交道。",
      "token_start": 954,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 292900,
      "end_ms": 294760,
      "text": "石头给了他们屋子，",
      "token_start": 963,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 295120,
      "end_ms": 296560,
      "text": "也给了他们脾气，",
      "token_start": 971,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 297120,
      "end_ms": 301940,
      "text": "您说这股子倔劲是不是也算一种美？",
      "token_start": 978,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 302400,
      "end_ms": 308000,
      "text": "第六名洪村安徽黄山一线讲到这儿，",
      "token_start": 993,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 308220,
      "end_ms": 310200,
      "text": "上级的分量就彻底重了。",
      "token_start": 1008,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 310560,
      "end_ms": 312480,
      "text": "它是世界文化遗产，",
      "token_start": 1018,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 313100,
      "end_ms": 315540,
      "text": "有着近九百年的岁月沉淀，",
      "token_start": 1026,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 316100,
      "end_ms": 320560,
      "text": "整个村落被巧妙布局成一头卧着的羚牛。",
      "token_start": 1037,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 321020,
      "end_ms": 323450,
      "text": "明代先祖从栖息引来，",
      "token_start": 1054,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 323470,
      "end_ms": 325610,
      "text": "活水九曲十八弯，",
      "token_start": 1063,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 326110,
      "end_ms": 327710,
      "text": "绕过一百四十多幢，",
      "token_start": 1070,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 327810,
      "end_ms": 330390,
      "text": "明清古宅汇进月沼，",
      "token_start": 1078,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 330890,
      "end_ms": 332190,
      "text": "再淌进南湖，",
      "token_start": 1086,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 332710,
      "end_ms": 334650,
      "text": "家家门前清流潺潺。",
      "token_start": 1091,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 335110,
      "end_ms": 336090,
      "text": "深秋时节，",
      "token_start": 1099,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 336530,
      "end_ms": 341110,
      "text": "南湖明镜般的水面上映着粉墙晃瓦，",
      "token_start": 1103,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 341530,
      "end_ms": 346010,
      "text": "岸边的枫叶红透了落进水里几挺，",
      "token_start": 1118,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 346130,
      "end_ms": 347990,
      "text": "残荷立在水中央，",
      "token_start": 1132,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 348510,
      "end_ms": 349490,
      "text": "急风一吹，",
      "token_start": 1139,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 349910,
      "end_ms": 352365,
      "text": "整幅画跟着轻轻晃动，",
      "token_start": 1143,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 352780,
      "end_ms": 354355,
      "text": "把水养的这么活，",
      "token_start": 1152,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 354750,
      "end_ms": 356270,
      "text": "把秋天养的这么静，",
      "token_start": 1159,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 356550,
      "end_ms": 359375,
      "text": "您说这到底是画还是村子？",
      "token_start": 1167,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 359900,
      "end_ms": 362610,
      "text": "从第十到第六名指南，",
      "token_start": 1178,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 362610,
      "end_ms": 366065,
      "text": "村把银杏和枫叶铺满了石板路，",
      "token_start": 1187,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 366420,
      "end_ms": 370025,
      "text": "塔川的乌冲树把山染成了调色盘。",
      "token_start": 1200,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 370460,
      "end_ms": 373715,
      "text": "赵兴洞寨的道浪涌到了鼓楼脚下，",
      "token_start": 1214,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 374090,
      "end_ms": 375370,
      "text": "太行山大天村，",
      "token_start": 1228,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 375570,
      "end_ms": 378275,
      "text": "把惊鸿的世子挂上了石崖，",
      "token_start": 1234,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 378780,
      "end_ms": 379220,
      "text": "洪村，",
      "token_start": 1245,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 379220,
      "end_ms": 381915,
      "text": "把整个秋天养进了一池水里。",
      "token_start": 1247,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 382250,
      "end_ms": 384315,
      "text": "可他们还不是最绝美的，",
      "token_start": 1259,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 384980,
      "end_ms": 387815,
      "text": "接下来第五道第一名更加惊艳。",
      "token_start": 1269,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 388490,
      "end_ms": 389595,
      "text": "有一个村子，",
      "token_start": 1282,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 390040,
      "end_ms": 393710,
      "text": "梯田一层层铺了几千级云海。",
      "token_start": 1287,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 393890,
      "end_ms": 396465,
      "text": "就在田里翻有一个村子，",
      "token_start": 1299,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 397080,
      "end_ms": 400025,
      "text": "守在中国的西北边境门口，",
      "token_start": 1309,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 400390,
      "end_ms": 402625,
      "text": "就是白桦林和雪峰，",
      "token_start": 1320,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 403020,
      "end_ms": 404785,
      "text": "可排在榜首的那一座。",
      "token_start": 1328,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 405220,
      "end_ms": 409920,
      "text": "把几百座像碉堡一样的古宅立体悬在千米峡谷之上，",
      "token_start": 1337,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 410600,
      "end_ms": 411575,
      "text": "头枕雪山，",
      "token_start": 1359,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 412010,
      "end_ms": 413155,
      "text": "身披彩霞。",
      "token_start": 1363,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 413570,
      "end_ms": 414395,
      "text": "他是哪座？",
      "token_start": 1367,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 414850,
      "end_ms": 418425,
      "text": "他凭什么能排在洪村和晒秋圣地的前面，",
      "token_start": 1371,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 418830,
      "end_ms": 420805,
      "text": "下一集已经同步更新，",
      "token_start": 1388,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 421470,
      "end_ms": 422625,
      "text": "点开我的头像，",
      "token_start": 1397,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 423230,
      "end_ms": 426515,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1403,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 426960,
      "end_ms": 431415,
      "text": "看看谁才是中国十大最绝美的秋日古村落。",
      "token_start": 1415,
      "token_end_exclusive": 1433
    }
  ],
