  "segments": [
    {
      "start_ms": 280,
      "end_ms": 1680,
      "text": "人为什么要经常出去玩？",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 1920,
      "end_ms": 3300,
      "text": "因为长时间呆在家里，",
      "token_start": 10,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 3360,
      "end_ms": 4380,
      "text": "会灵气尽失，",
      "token_start": 19,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 4640,
      "end_ms": 5700,
      "text": "身心疲惫。",
      "token_start": 24,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 6100,
      "end_ms": 7080,
      "text": "黄帝内经中说，",
      "token_start": 28,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 7300,
      "end_ms": 8260,
      "text": "久坐伤肉，",
      "token_start": 34,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 8500,
      "end_ms": 9520,
      "text": "久卧伤气，",
      "token_start": 38,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 10020,
      "end_ms": 11560,
      "text": "越是在房间里面呆久了，",
      "token_start": 42,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 11620,
      "end_ms": 12580,
      "text": "越是虚弱。",
      "token_start": 52,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 12900,
      "end_ms": 16940,
      "text": "你看人和梦在一起是修字人和山在一起，",
      "token_start": 56,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 17240,
      "end_ms": 19820,
      "text": "便是仙字最好的休息啊。",
      "token_start": 73,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 19860,
      "end_ms": 20900,
      "text": "不是躺在床上，",
      "token_start": 83,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 21040,
      "end_ms": 22320,
      "text": "也不是窝在沙发里，",
      "token_start": 89,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 22620,
      "end_ms": 24960,
      "text": "而是到大自然中到山里面来，",
      "token_start": 97,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 25160,
      "end_ms": 26520,
      "text": "呼吸天地清气，",
      "token_start": 109,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 26780,
      "end_ms": 28260,
      "text": "感受万物有灵。",
      "token_start": 115,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 28840,
      "end_ms": 29815,
      "text": "山川草木，",
      "token_start": 121,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 30090,
      "end_ms": 30850,
      "text": "阳光雨露，",
      "token_start": 125,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 31010,
      "end_ms": 32990,
      "text": "能沐浴身心走出去，",
      "token_start": 129,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 33250,
      "end_ms": 34230,
      "text": "运气才会好。",
      "token_start": 137,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 34570,
      "end_ms": 34970,
      "text": "走运，",
      "token_start": 142,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 34970,
      "end_ms": 37145,
      "text": "走运就是这么来的。",
      "token_start": 144,
      "token_end_exclusive": 152
    }
  ],
