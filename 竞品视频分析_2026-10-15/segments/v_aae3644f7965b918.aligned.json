  "segments": [
    {
      "start_ms": 130,
      "end_ms": 370,
      "text": "哎，",
      "token_start": 0,
      "token_end_exclusive": 1
    },
    {
      "start_ms": 810,
      "end_ms": 1770,
      "text": "你什么意思啊，",
      "token_start": 1,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1870,
      "end_ms": 3470,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 7,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 3750,
      "end_ms": 5010,
      "text": "领导美满美满，",
      "token_start": 18,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5150,
      "end_ms": 6210,
      "text": "代表幸福美满，",
      "token_start": 24,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 6350,
      "end_ms": 8490,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 30,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 10290,
      "end_ms": 10930,
      "text": "小李啊，",
      "token_start": 44,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 11230,
      "end_ms": 13210,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 47,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 14010,
      "end_ms": 16430,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 57,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 16770,
      "end_ms": 18710,
      "text": "只能在衣聘上找些自我安慰了。",
      "token_start": 70,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 20090,
      "end_ms": 20510,
      "text": "小李，",
      "token_start": 83,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 21070,
      "end_ms": 22190,
      "text": "今天让你破费了，",
      "token_start": 85,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 22430,
      "end_ms": 22850,
      "text": "领导，",
      "token_start": 92,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 23050,
      "end_ms": 24650,
      "text": "您说这些您能来，",
      "token_start": 94,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 24650,
      "end_ms": 25470,
      "text": "就是我的荣幸，",
      "token_start": 101,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 25750,
      "end_ms": 28855,
      "text": "以后还有很多地方要向您请教。",
      "token_start": 107,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 30220,
      "end_ms": 30460,
      "text": "哎，",
      "token_start": 120,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 30620,
      "end_ms": 32220,
      "text": "我这肚子喝茶都能胖，",
      "token_start": 121,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 32700,
      "end_ms": 34060,
      "text": "领导你那不叫胖，",
      "token_start": 130,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 34300,
      "end_ms": 35860,
      "text": "那叫宰相肚里能撑船，",
      "token_start": 137,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 36220,
      "end_ms": 37480,
      "text": "装的全是大事儿，",
      "token_start": 146,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 40280,
      "end_ms": 41740,
      "text": "年轻就是好啊，",
      "token_start": 153,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 42760,
      "end_ms": 44200,
      "text": "年轻就是还不够沉稳，",
      "token_start": 159,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 44600,
      "end_ms": 45760,
      "text": "还要向您多学习，",
      "token_start": 168,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 46200,
      "end_ms": 47380,
      "text": "我们才能变得更优秀。",
      "token_start": 175,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 50180,
      "end_ms": 52180,
      "text": "年李最近表现不错，",
      "token_start": 184,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 52520,
      "end_ms": 54460,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 192,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 54480,
      "end_ms": 55580,
      "text": "我得提前敬一杯。",
      "token_start": 205,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 56160,
      "end_ms": 56800,
      "text": "听这意思，",
      "token_start": 212,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 56820,
      "end_ms": 57860,
      "text": "领导是要高升了呀，",
      "token_start": 216,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 57860,
      "end_ms": 58800,
      "text": "我得提前敬领导，",
      "token_start": 224,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 58800,
      "end_ms": 62665,
      "text": "一杯不喝就是看不起我。",
      "token_start": 231,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 63490,
      "end_ms": 63870,
      "text": "领导，",
      "token_start": 241,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 63930,
      "end_ms": 64945,
      "text": "我不是看不起您，",
      "token_start": 243,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 65260,
      "end_ms": 66245,
      "text": "我是看不起病，",
      "token_start": 250,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 70460,
      "end_ms": 71735,
      "text": "我真不怎么喜欢你，",
      "token_start": 256,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 72390,
      "end_ms": 74390,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 264,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 74390,
      "end_ms": 80730,
      "text": "我领导的格局值得我们学习关注。",
      "token_start": 277,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 80730,
      "end_ms": 82880,
      "text": "我每天学点儿高情商，",
      "token_start": 291,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 83000,
      "end_ms": 83815,
      "text": "说话技巧，",
      "token_start": 300,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 84170,
      "end_ms": 86095,
      "text": "让你的路越走越宽。",
      "token_start": 304,
      "token_end_exclusive": 312
    }
