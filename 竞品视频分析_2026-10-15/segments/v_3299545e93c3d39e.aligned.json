{
  "video_id": "v_3299545e93c3d39e",
  "duration_s": 244.552993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_3299545e93c3d39e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_3299545e93c3d39e.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 2010,
      "text": "这酒怎么喝到最后还有半瓶，",
      "token_start": 0,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 2350,
      "end_ms": 3450,
      "text": "半瓶留着下次喝，",
      "token_start": 12,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 3550,
      "end_ms": 5110,
      "text": "说明咱俩的局还没完。",
      "token_start": 19,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 5290,
      "end_ms": 6490,
      "text": "酒喝干了是散场，",
      "token_start": 28,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 6530,
      "end_ms": 7410,
      "text": "剩半瓶续举，",
      "token_start": 35,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 7590,
      "end_ms": 11290,
      "text": "您下回还得来都吃到这个点儿了，",
      "token_start": 40,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 11290,
      "end_ms": 13970,
      "text": "你怎么还没敬我一杯敬您的人排着队呢？",
      "token_start": 54,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 13970,
      "end_ms": 15250,
      "text": "我最后一个敬前面的酒，",
      "token_start": 71,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 15250,
      "end_ms": 16010,
      "text": "您喝的是场面。",
      "token_start": 81,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 16010,
      "end_ms": 17150,
      "text": "我这杯您喝的是收尾，",
      "token_start": 87,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 17150,
      "end_ms": 18290,
      "text": "代表今天的事儿圆满，",
      "token_start": 96,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 20210,
      "end_ms": 22290,
      "text": "你怎么就喝这点儿养鱼呢？",
      "token_start": 105,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 22730,
      "end_ms": 23550,
      "text": "我得留着量，",
      "token_start": 116,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 23650,
      "end_ms": 24710,
      "text": "万一您喝到位了，",
      "token_start": 121,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 24710,
      "end_ms": 25910,
      "text": "总得有个清醒的人负责。",
      "token_start": 128,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 25910,
      "end_ms": 28375,
      "text": "掏您家门钥匙吧。",
      "token_start": 138,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 30180,
      "end_ms": 30960,
      "text": "这酒开了，",
      "token_start": 145,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 31040,
      "end_ms": 31900,
      "text": "你不先给我倒，",
      "token_start": 149,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 32460,
      "end_ms": 33260,
      "text": "先倒的是客，",
      "token_start": 155,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 33260,
      "end_ms": 34000,
      "text": "后倒的是主。",
      "token_start": 160,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 34040,
      "end_ms": 34960,
      "text": "您是今天的主人，",
      "token_start": 165,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 34980,
      "end_ms": 36460,
      "text": "最后一杯满上代表压轴，",
      "token_start": 172,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 36540,
      "end_ms": 38300,
      "text": "全桌的福气都沉淀在您杯底。",
      "token_start": 182,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 39900,
      "end_ms": 40340,
      "text": "哎呀，",
      "token_start": 194,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 40640,
      "end_ms": 41480,
      "text": "我都老了，",
      "token_start": 196,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 41720,
      "end_ms": 42620,
      "text": "不中用了。",
      "token_start": 200,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 42820,
      "end_ms": 43060,
      "text": "哎，",
      "token_start": 204,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 43080,
      "end_ms": 43420,
      "text": "领导，",
      "token_start": 205,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 43420,
      "end_ms": 44480,
      "text": "您可千万别这么说，",
      "token_start": 207,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 44640,
      "end_ms": 46680,
      "text": "我们论能力、论经验论、资历都不如您，",
      "token_start": 215,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 46680,
      "end_ms": 49100,
      "text": "这样的老前辈还得靠您带着我们进步啊。",
      "token_start": 230,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 50060,
      "end_ms": 51840,
      "text": "你这敬酒的顺序是不是不对？",
      "token_start": 247,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 52120,
      "end_ms": 53100,
      "text": "怎么先敬别人，",
      "token_start": 259,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 53220,
      "end_ms": 54240,
      "text": "先把流程走完，",
      "token_start": 265,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 54360,
      "end_ms": 55640,
      "text": "最后踏踏实实坐下来，",
      "token_start": 271,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 55640,
      "end_ms": 56340,
      "text": "陪您慢慢喝。",
      "token_start": 280,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 56480,
      "end_ms": 56760,
      "text": "好的，",
      "token_start": 285,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 56760,
      "end_ms": 57300,
      "text": "留到最后。",
      "token_start": 287,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 59600,
      "end_ms": 63465,
      "text": "我看看你这丫头最近是越来越精神了啊，",
      "token_start": 291,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 63810,
      "end_ms": 64750,
      "text": "那是因为沾了领导，",
      "token_start": 308,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 64750,
      "end_ms": 66310,
      "text": "您的光跟着您干事儿，",
      "token_start": 316,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 66310,
      "end_ms": 67445,
      "text": "气色当然不会差了。",
      "token_start": 325,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 67620,
      "end_ms": 71235,
      "text": "啊哈瞧你最近表现的不错啊，",
      "token_start": 333,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 71590,
      "end_ms": 73775,
      "text": "看来我的这个位置马上就该你坐了，",
      "token_start": 345,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 73960,
      "end_ms": 75220,
      "text": "我得提前敬你一杯。",
      "token_start": 360,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 75320,
      "end_ms": 76080,
      "text": "听您的意思，",
      "token_start": 368,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 76100,
      "end_ms": 77100,
      "text": "领导也是高升了呀，",
      "token_start": 373,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 77100,
      "end_ms": 78285,
      "text": "我也提前敬领导一杯。",
      "token_start": 381,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 78590,
      "end_ms": 81005,
      "text": "哈哈哈哈哈你今天话怎么这么少？",
      "token_start": 390,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 81280,
      "end_ms": 81980,
      "text": "再听您说，",
      "token_start": 404,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 82180,
      "end_ms": 82640,
      "text": "酒桌上，",
      "token_start": 408,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 82640,
      "end_ms": 84435,
      "text": "您讲东西比开会时还有料，",
      "token_start": 411,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 84660,
      "end_ms": 89070,
      "text": "我舍不得打断你怎么菜还没上齐，",
      "token_start": 422,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 89070,
      "end_ms": 89915,
      "text": "你就结账了。",
      "token_start": 436,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 90370,
      "end_ms": 91875,
      "text": "先结账是表明态度，",
      "token_start": 441,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 92060,
      "end_ms": 93075,
      "text": "这顿饭我请定了，",
      "token_start": 449,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 93330,
      "end_ms": 94010,
      "text": "后面再加菜。",
      "token_start": 456,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 94010,
      "end_ms": 94685,
      "text": "您随便点，",
      "token_start": 461,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 94900,
      "end_ms": 95700,
      "text": "没有心理负担，",
      "token_start": 465,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 95700,
      "end_ms": 96615,
      "text": "吃了才尽兴。",
      "token_start": 471,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 97810,
      "end_ms": 99815,
      "text": "你这衣服穿了好几年了吧，",
      "token_start": 476,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 100840,
      "end_ms": 101665,
      "text": "穿着舒服，",
      "token_start": 487,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 102060,
      "end_ms": 102960,
      "text": "跟您共事久了，",
      "token_start": 491,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 102960,
      "end_ms": 106085,
      "text": "人也实在了不讲究那些虚的啊。",
      "token_start": 497,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 106250,
      "end_ms": 106915,
      "text": "哈哈哈哈，",
      "token_start": 510,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 107860,
      "end_ms": 109155,
      "text": "我这字儿写的一般，",
      "token_start": 514,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 109510,
      "end_ms": 111450,
      "text": "你别为了哄我乱夸字，",
      "token_start": 522,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 111450,
      "end_ms": 112225,
      "text": "我确实不懂，",
      "token_start": 531,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 112560,
      "end_ms": 113380,
      "text": "但你一握笔，",
      "token_start": 536,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 113380,
      "end_ms": 114300,
      "text": "全屋都安静了。",
      "token_start": 541,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 114300,
      "end_ms": 118865,
      "text": "这个我懂你这人脾气挺好，",
      "token_start": 547,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 119390,
      "end_ms": 120515,
      "text": "没见你发过火，",
      "token_start": 558,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 120940,
      "end_ms": 122265,
      "text": "发火解决不了问题，",
      "token_start": 564,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 122730,
      "end_ms": 123970,
      "text": "您在前面顶着压力，",
      "token_start": 572,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 123970,
      "end_ms": 125575,
      "text": "我在后面添乱不合适。",
      "token_start": 580,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 126220,
      "end_ms": 127225,
      "text": "哈哈哈哈哈。",
      "token_start": 589,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 127470,
      "end_ms": 127990,
      "text": "小王站，",
      "token_start": 594,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 127990,
      "end_ms": 131945,
      "text": "我旁边不怕把你照老了站您旁边哪会显老，",
      "token_start": 597,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 132280,
      "end_ms": 134175,
      "text": "只会显得我年纪轻轻站的挺对。",
      "token_start": 615,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 134600,
      "end_ms": 135865,
      "text": "哈哈哈哈哈哈哈，",
      "token_start": 628,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 136320,
      "end_ms": 137415,
      "text": "怎么我来迟了，",
      "token_start": 635,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 137750,
      "end_ms": 140250,
      "text": "你也不打个电话催催催您是给您压力，",
      "token_start": 641,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 140350,
      "end_ms": 142490,
      "text": "等您是给您尊重您来迟肯定有原因，",
      "token_start": 657,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 142690,
      "end_ms": 144070,
      "text": "我等的就是信任到了，",
      "token_start": 672,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 144070,
      "end_ms": 144715,
      "text": "就是圆满。",
      "token_start": 681,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 145330,
      "end_ms": 145915,
      "text": "哈哈哈，",
      "token_start": 685,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 146370,
      "end_ms": 147510,
      "text": "家里没什么好茶，",
      "token_start": 688,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 147790,
      "end_ms": 150130,
      "text": "你就凑合喝吧茶叶好不好？",
      "token_start": 695,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 150210,
      "end_ms": 151225,
      "text": "得看怎么标价。",
      "token_start": 706,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 151570,
      "end_ms": 152710,
      "text": "您亲手倒的这杯，",
      "token_start": 712,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 152850,
      "end_ms": 153530,
      "text": "只讲情分，",
      "token_start": 719,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 153530,
      "end_ms": 156020,
      "text": "不讲价这鱼怎么点的这么赞。",
      "token_start": 723,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 156020,
      "end_ms": 158500,
      "text": "前面大鱼大肉最后来一口清淡的漱漱口。",
      "token_start": 735,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 158640,
      "end_ms": 159880,
      "text": "就像您听完汇报，",
      "token_start": 752,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 159900,
      "end_ms": 160820,
      "text": "最后来一句总结，",
      "token_start": 759,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 160940,
      "end_ms": 161560,
      "text": "清清爽爽，",
      "token_start": 766,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 161560,
      "end_ms": 163000,
      "text": "散会好好啊。",
      "token_start": 770,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 163000,
      "end_ms": 163240,
      "text": "好，",
      "token_start": 775,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 163370,
      "end_ms": 163490,
      "text": "梨，",
      "token_start": 776,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 163490,
      "end_ms": 164295,
      "text": "我就先收下了，",
      "token_start": 777,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 164520,
      "end_ms": 165540,
      "text": "但事儿能不能办成，",
      "token_start": 783,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 165540,
      "end_ms": 166680,
      "text": "我可不敢打包票啊。",
      "token_start": 791,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 166680,
      "end_ms": 166880,
      "text": "领导，",
      "token_start": 799,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 166880,
      "end_ms": 167565,
      "text": "您说笑了，",
      "token_start": 801,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 167820,
      "end_ms": 169060,
      "text": "这事儿能成是您的加持，",
      "token_start": 805,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 169100,
      "end_ms": 170360,
      "text": "不能成的话就是我的造化，",
      "token_start": 815,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 170460,
      "end_ms": 171240,
      "text": "无论结果如何，",
      "token_start": 826,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 171240,
      "end_ms": 171820,
      "text": "都得感谢。",
      "token_start": 832,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 171820,
      "end_ms": 172660,
      "text": "领导您的提携，",
      "token_start": 836,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 173660,
      "end_ms": 175095,
      "text": "你一开口就让人喜欢你，",
      "token_start": 842,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 175350,
      "end_ms": 176295,
      "text": "你是怎么做到的？",
      "token_start": 852,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 176680,
      "end_ms": 178760,
      "text": "因为我一直在看这本对答如流，",
      "token_start": 859,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 179060,
      "end_ms": 180840,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 872,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 180920,
      "end_ms": 181800,
      "text": "那些会说话，",
      "token_start": 883,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 181900,
      "end_ms": 182780,
      "text": "会来事儿的人。",
      "token_start": 888,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 182860,
      "end_ms": 183940,
      "text": "假如你不爱说话，",
      "token_start": 894,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 184080,
      "end_ms": 184840,
      "text": "不爱争辩，",
      "token_start": 901,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 184920,
      "end_ms": 185800,
      "text": "也不爱出门，",
      "token_start": 905,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 185960,
      "end_ms": 187120,
      "text": "甚至恐惧社交，",
      "token_start": 910,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 187500,
      "end_ms": 189500,
      "text": "推荐你读完这本对答如流，",
      "token_start": 916,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 189660,
      "end_ms": 191925,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 927,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 192250,
      "end_ms": 193410,
      "text": "你每天就看两页，",
      "token_start": 939,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 193550,
      "end_ms": 194955,
      "text": "每一个场景慢慢练，",
      "token_start": 946,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 195270,
      "end_ms": 197830,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 954,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 197990,
      "end_ms": 198750,
      "text": "在这本书里，",
      "token_start": 969,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 198750,
      "end_ms": 199330,
      "text": "有一句话，",
      "token_start": 974,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 199390,
      "end_ms": 200285,
      "text": "我特别欣赏，",
      "token_start": 978,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 200600,
      "end_ms": 200780,
      "text": "他，",
      "token_start": 983,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 200780,
      "end_ms": 202825,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 984,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 203070,
      "end_ms": 203755,
      "text": "你可以回，",
      "token_start": 996,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 204220,
      "end_ms": 205160,
      "text": "那是不优秀点，",
      "token_start": 1000,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 205240,
      "end_ms": 206525,
      "text": "怎么能和你做朋友呢？",
      "token_start": 1006,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 206900,
      "end_ms": 208580,
      "text": "当有人说你真聪明，",
      "token_start": 1015,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 208640,
      "end_ms": 210395,
      "text": "你就回近朱者赤，",
      "token_start": 1023,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 210670,
      "end_ms": 211610,
      "text": "和你在一起啊，",
      "token_start": 1030,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 211730,
      "end_ms": 214730,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 1036,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 214810,
      "end_ms": 216045,
      "text": "你就回领导，",
      "token_start": 1051,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 216280,
      "end_ms": 217515,
      "text": "这都是我应该做的。",
      "token_start": 1056,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 217780,
      "end_ms": 219160,
      "text": "强将手下吴若冰，",
      "token_start": 1064,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 219400,
      "end_ms": 220885,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 1071,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 221300,
      "end_ms": 222620,
      "text": "当我看到这段的时候，",
      "token_start": 1080,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 222620,
      "end_ms": 224435,
      "text": "这个真是让我欲解心开啊。",
      "token_start": 1089,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 224790,
      "end_ms": 226055,
      "text": "每一句都很有意思，",
      "token_start": 1100,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 226340,
      "end_ms": 228760,
      "text": "就是手把手教我们在不同的场景之下，",
      "token_start": 1108,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 228760,
      "end_ms": 229500,
      "text": "应该怎么说？",
      "token_start": 1124,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 229620,
      "end_ms": 232285,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1129,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 232550,
      "end_ms": 233870,
      "text": "你就放心的拿回去看，",
      "token_start": 1147,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 234210,
      "end_ms": 235650,
      "text": "就是一句一句的教你，",
      "token_start": 1156,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 235870,
      "end_ms": 238355,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 1165,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 238690,
      "end_ms": 239730,
      "text": "但凡学会三分，",
      "token_start": 1177,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 239970,
      "end_ms": 242325,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 1183,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 242750,
      "end_ms": 244435,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 1197,
      "token_end_exclusive": 1209
    }
