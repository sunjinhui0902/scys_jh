{
  "video_id": "v_87049fb430a5dbb6",
  "duration_s": 459.662993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_87049fb430a5dbb6.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_87049fb430a5dbb6.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 590,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 590,
      "end_ms": 990,
      "text": "我说，",
      "token_start": 2,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1030,
      "end_ms": 3390,
      "text": "秦始皇陵连前三都进不去，",
      "token_start": 4,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3810,
      "end_ms": 5550,
      "text": "好多朋友在评论区不服，",
      "token_start": 15,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6170,
      "end_ms": 6690,
      "text": "别急，",
      "token_start": 25,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 6990,
      "end_ms": 8770,
      "text": "今天您听完就明白了，",
      "token_start": 27,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 9310,
      "end_ms": 11350,
      "text": "他确实进不了前三，",
      "token_start": 36,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 11730,
      "end_ms": 14890,
      "text": "但他的邪乎劲儿一点不比前三。",
      "token_start": 44,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 14890,
      "end_ms": 15130,
      "text": "差。",
      "token_start": 57,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 15550,
      "end_ms": 16490,
      "text": "第十道第六，",
      "token_start": 58,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 17250,
      "end_ms": 23070,
      "text": "北宋皇陵藏在麦田里西夏王陵不长草不落鸟汉阳陵，",
      "token_start": 63,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 23330,
      "end_ms": 28030,
      "text": "埋着几十万缩微陶俑唐昭陵两百个，",
      "token_start": 85,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 28030,
      "end_ms": 32320,
      "text": "老兄弟守着明定陵零三千件文物挖出来又送回去。",
      "token_start": 100,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 32760,
      "end_ms": 34720,
      "text": "今天这集就是第五到第一，",
      "token_start": 121,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 35160,
      "end_ms": 36180,
      "text": "一个比一个悬。",
      "token_start": 132,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 36400,
      "end_ms": 38660,
      "text": "最后那个全世界找了一百年，",
      "token_start": 138,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 38920,
      "end_ms": 40280,
      "text": "连影子都没见着。",
      "token_start": 150,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 40620,
      "end_ms": 41240,
      "text": "老规矩，",
      "token_start": 157,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 41540,
      "end_ms": 42320,
      "text": "开讲之前，",
      "token_start": 160,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 42780,
      "end_ms": 44760,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 164,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 45080,
      "end_ms": 46460,
      "text": "让我看看都是谁。",
      "token_start": 174,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 46460,
      "end_ms": 48540,
      "text": "在听第五名，",
      "token_start": 181,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 49020,
      "end_ms": 52480,
      "text": "陕西咸阳、汉武帝、茂陵、汉武帝刘彻的陵，",
      "token_start": 186,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 52880,
      "end_ms": 58120,
      "text": "汉朝皇帝里陵修的最大的一座陵修了五十三年。",
      "token_start": 202,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 58500,
      "end_ms": 59760,
      "text": "汉武帝当了多少年，",
      "token_start": 222,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 59760,
      "end_ms": 61615,
      "text": "皇皇帝就修了多少年，",
      "token_start": 230,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 62240,
      "end_ms": 64245,
      "text": "您知道里面埋了多少东西吗？",
      "token_start": 239,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 65220,
      "end_ms": 66315,
      "text": "史书上写着，",
      "token_start": 251,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 66610,
      "end_ms": 68365,
      "text": "到汉武帝下葬的时候，",
      "token_start": 256,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 69010,
      "end_ms": 72760,
      "text": "地宫里的陪葬品已经多到不负容物，",
      "token_start": 265,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 72940,
      "end_ms": 77025,
      "text": "就是塞不下了金银珠宝、丝绸、酒具，",
      "token_start": 280,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 77310,
      "end_ms": 79085,
      "text": "还有活的飞禽走兽，",
      "token_start": 294,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 79450,
      "end_ms": 81935,
      "text": "专门有人养着等着殉葬。",
      "token_start": 302,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 82410,
      "end_ms": 89875,
      "text": "茂陵旁边还埋着卫青、霍去病、霍光这些大汉名将名臣一座陵，",
      "token_start": 312,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 90320,
      "end_ms": 93135,
      "text": "把整个汉武盛世全埋进去了。",
      "token_start": 337,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 94210,
      "end_ms": 94905,
      "text": "第四名，",
      "token_start": 349,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 95300,
      "end_ms": 99560,
      "text": "陕西西安秦始皇陵这陵最绝的不是大，",
      "token_start": 352,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 99700,
      "end_ms": 101560,
      "text": "是不敢挖兵马俑，",
      "token_start": 368,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 101840,
      "end_ms": 104155,
      "text": "只是他陵园的一个角落。",
      "token_start": 375,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 104480,
      "end_ms": 107115,
      "text": "整个林区五十六平方公里，",
      "token_start": 385,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 107490,
      "end_ms": 110105,
      "text": "相当于七十八个故宫地宫里头。",
      "token_start": 396,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 110380,
      "end_ms": 118725,
      "text": "史书上写着以水银为百川江河大海上句天文下句地理什么意思？",
      "token_start": 409,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 119300,
      "end_ms": 122710,
      "text": "用水银灌成江河湖海顶上，",
      "token_start": 436,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 122890,
      "end_ms": 125390,
      "text": "画着天门星象底下，",
      "token_start": 447,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 125390,
      "end_ms": 126465,
      "text": "铺着山川地里，",
      "token_start": 455,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 126920,
      "end_ms": 128405,
      "text": "秦始皇躺在中间，",
      "token_start": 461,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 128840,
      "end_ms": 132120,
      "text": "天文地理全踩在脚下考古队。",
      "token_start": 468,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 132120,
      "end_ms": 138055,
      "text": "用物探技术测过风土堆的汞含量是周围土壤的七十多倍。",
      "token_start": 480,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 138480,
      "end_ms": 140565,
      "text": "水银的记载是真的，",
      "token_start": 504,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 140800,
      "end_ms": 141755,
      "text": "为什么不挖？",
      "token_start": 512,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 142290,
      "end_ms": 142670,
      "text": "第一，",
      "token_start": 517,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 143210,
      "end_ms": 144115,
      "text": "技术不行，",
      "token_start": 519,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 145020,
      "end_ms": 148055,
      "text": "兵马俑挖出来的时候是彩色的，",
      "token_start": 523,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 148250,
      "end_ms": 150405,
      "text": "一接触空气几分钟，",
      "token_start": 536,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 150730,
      "end_ms": 151695,
      "text": "颜色就掉了，",
      "token_start": 544,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 152060,
      "end_ms": 154640,
      "text": "变成了灰扑扑的泥人地，",
      "token_start": 549,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 154640,
      "end_ms": 157025,
      "text": "宫里的东西只会更脆弱。",
      "token_start": 559,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 157370,
      "end_ms": 157725,
      "text": "第二，",
      "token_start": 569,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 158070,
      "end_ms": 162325,
      "text": "水银有毒拱蒸汽人进去就是送死。",
      "token_start": 571,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 162950,
      "end_ms": 163370,
      "text": "第三，",
      "token_start": 585,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 163670,
      "end_ms": 166335,
      "text": "挖了就保护不了兵马俑坑，",
      "token_start": 587,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 166870,
      "end_ms": 168790,
      "text": "到现在还是挖一半，",
      "token_start": 598,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 168790,
      "end_ms": 169310,
      "text": "留一半，",
      "token_start": 606,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 169390,
      "end_ms": 170515,
      "text": "不敢全打开，",
      "token_start": 609,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 170980,
      "end_ms": 173450,
      "text": "一座陵埋了两千两，",
      "token_start": 614,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 173450,
      "end_ms": 175930,
      "text": "百年全世界都知道，",
      "token_start": 622,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 175930,
      "end_ms": 176535,
      "text": "他在哪，",
      "token_start": 630,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 177240,
      "end_ms": 178105,
      "text": "就是不敢动。",
      "token_start": 633,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 179120,
      "end_ms": 181385,
      "text": "您说这是胆小还是敬畏？",
      "token_start": 638,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 182400,
      "end_ms": 183005,
      "text": "第三名，",
      "token_start": 648,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 184140,
      "end_ms": 185300,
      "text": "陕西礼泉，",
      "token_start": 651,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 185560,
      "end_ms": 189085,
      "text": "唐乾陵、武则天和唐高宗李治的合葬礼。",
      "token_start": 655,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 189540,
      "end_ms": 191875,
      "text": "这灵最绝的就一个字，",
      "token_start": 671,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 192170,
      "end_ms": 192685,
      "text": "挖不动，",
      "token_start": 680,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 193220,
      "end_ms": 194105,
      "text": "怎么修的呢？",
      "token_start": 683,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 194400,
      "end_ms": 197220,
      "text": "把整座梁山掏空了墓道口，",
      "token_start": 688,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 197220,
      "end_ms": 199685,
      "text": "用两千五百多条石条封死，",
      "token_start": 699,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 200400,
      "end_ms": 202275,
      "text": "每块石条上凿了凹槽，",
      "token_start": 710,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 202690,
      "end_ms": 203955,
      "text": "用铁板卡住，",
      "token_start": 719,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 204320,
      "end_ms": 205255,
      "text": "然后灌铁水，",
      "token_start": 724,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 205740,
      "end_ms": 208885,
      "text": "整个墓道成了一条铁柱的通道。",
      "token_start": 729,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 209690,
      "end_ms": 210675,
      "text": "唐朝末年，",
      "token_start": 742,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 211030,
      "end_ms": 214195,
      "text": "黄巢起义带了四十万大军，",
      "token_start": 746,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 214740,
      "end_ms": 216255,
      "text": "在梁山挖了几个月，",
      "token_start": 757,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 216590,
      "end_ms": 218365,
      "text": "挖了一条四十米深的沟，",
      "token_start": 765,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 218710,
      "end_ms": 220565,
      "text": "现在还在叫黄巢沟，",
      "token_start": 775,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 220970,
      "end_ms": 222410,
      "text": "连墓道口都没找着。",
      "token_start": 783,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 222490,
      "end_ms": 223230,
      "text": "五代时候，",
      "token_start": 791,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 223430,
      "end_ms": 227645,
      "text": "盗墓贼温韬把唐朝十七座皇陵全挖了，",
      "token_start": 795,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 228030,
      "end_ms": 230595,
      "text": "唯独乾陵他带着人马去了。",
      "token_start": 811,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 231440,
      "end_ms": 233620,
      "text": "刚到山脚下狂风暴雨，",
      "token_start": 822,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 233720,
      "end_ms": 236250,
      "text": "电闪雷鸣人马一撤天，",
      "token_start": 831,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 236270,
      "end_ms": 238205,
      "text": "就晴了试了三次，",
      "token_start": 840,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 238730,
      "end_ms": 239625,
      "text": "三次都这样。",
      "token_start": 847,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 240090,
      "end_ms": 244750,
      "text": "后来民国军阀孙连仲用炸药炸炸开了，",
      "token_start": 852,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 244750,
      "end_ms": 246810,
      "text": "外面几层进去一看，",
      "token_start": 868,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 247030,
      "end_ms": 249850,
      "text": "铁水浇死的通道根本炸不开，",
      "token_start": 876,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 250410,
      "end_ms": 252550,
      "text": "最后也撤了一座陵，",
      "token_start": 888,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 252850,
      "end_ms": 256910,
      "text": "一千三百多年四十万人没挖洞，",
      "token_start": 896,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 256950,
      "end_ms": 259250,
      "text": "三次天变三次退兵。",
      "token_start": 909,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 259350,
      "end_ms": 261530,
      "text": "您说这是防盗还是天意？",
      "token_start": 917,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 262510,
      "end_ms": 263070,
      "text": "第二名，",
      "token_start": 927,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 263330,
      "end_ms": 265950,
      "text": "内蒙古鄂尔多斯成吉思汗陵。",
      "token_start": 930,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 266790,
      "end_ms": 267210,
      "text": "注意，",
      "token_start": 942,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 267450,
      "end_ms": 269330,
      "text": "这个陵是衣冠冢，",
      "token_start": 944,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 270670,
      "end_ms": 272930,
      "text": "真正的成吉思汗葬在哪儿？",
      "token_start": 951,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 272930,
      "end_ms": 275370,
      "text": "没人知道怎么葬的呢？",
      "token_start": 962,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 275370,
      "end_ms": 277630,
      "text": "蒙古密史里记载了一个习俗，",
      "token_start": 971,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 277670,
      "end_ms": 278870,
      "text": "叫秘葬，",
      "token_start": 983,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 278910,
      "end_ms": 280650,
      "text": "人死了挖一条深沟，",
      "token_start": 986,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 280950,
      "end_ms": 282210,
      "text": "把遗体放进去，",
      "token_start": 994,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 282470,
      "end_ms": 285030,
      "text": "然后用万马踏平不留坟头。",
      "token_start": 1000,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 285350,
      "end_ms": 287770,
      "text": "等到第二年草长出来了，",
      "token_start": 1011,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 287770,
      "end_ms": 289030,
      "text": "跟周围一模一样，",
      "token_start": 1021,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 289090,
      "end_ms": 291410,
      "text": "根本看不出来下葬的时候，",
      "token_start": 1028,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 291610,
      "end_ms": 295550,
      "text": "当着母骆驼的面把小骆驼杀了母骆驼。",
      "token_start": 1039,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 295550,
      "end_ms": 297330,
      "text": "记住这个地方以后，",
      "token_start": 1055,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 297350,
      "end_ms": 300175,
      "text": "祭祀牵着母骆驼来，",
      "token_start": 1063,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 300460,
      "end_ms": 302075,
      "text": "他在哪儿停下哀鸣，",
      "token_start": 1071,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 303010,
      "end_ms": 306090,
      "text": "就在那儿记登姆骆驼死了，",
      "token_start": 1079,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 306290,
      "end_ms": 307185,
      "text": "谁也找不到。",
      "token_start": 1090,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 307820,
      "end_ms": 310000,
      "text": "全世界考古队找了一百多年，",
      "token_start": 1095,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 310300,
      "end_ms": 312340,
      "text": "蒙古国找过贺兰山，",
      "token_start": 1107,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 312360,
      "end_ms": 313800,
      "text": "找过六盘山，",
      "token_start": 1115,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 313800,
      "end_ms": 315220,
      "text": "找过阿尔泰山，",
      "token_start": 1120,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 315240,
      "end_ms": 318140,
      "text": "找过连卫星遥感都用上了，",
      "token_start": 1126,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 318660,
      "end_ms": 321260,
      "text": "到现在连一块砖都没找着。",
      "token_start": 1137,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 321760,
      "end_ms": 324240,
      "text": "一个征服了半个世界的帝王。",
      "token_start": 1148,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 324580,
      "end_ms": 326580,
      "text": "死后连坟头都找不到，",
      "token_start": 1160,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 327340,
      "end_ms": 330700,
      "text": "您说这是低调还是最高明的防道？",
      "token_start": 1169,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 330840,
      "end_ms": 331360,
      "text": "第一名，",
      "token_start": 1183,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 331700,
      "end_ms": 334300,
      "text": "陕西延安黄帝陵等等。",
      "token_start": 1186,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 334720,
      "end_ms": 336520,
      "text": "黄帝陵不是帝王陵吗？",
      "token_start": 1195,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 336680,
      "end_ms": 336920,
      "text": "对，",
      "token_start": 1204,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 337570,
      "end_ms": 339710,
      "text": "但他跟前面九座都不一样。",
      "token_start": 1205,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 340130,
      "end_ms": 342410,
      "text": "前面九座埋的是皇帝，",
      "token_start": 1216,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 342590,
      "end_ms": 344150,
      "text": "是王皇帝陵，",
      "token_start": 1225,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 344670,
      "end_ms": 347130,
      "text": "埋的是咱们所有人的老祖宗。",
      "token_start": 1230,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 347530,
      "end_ms": 350910,
      "text": "司马迁的史记第一篇武帝本纪，",
      "token_start": 1242,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 351270,
      "end_ms": 353110,
      "text": "第一个写的就是皇帝。",
      "token_start": 1255,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 353649,
      "end_ms": 354910,
      "text": "从汉武帝开始，",
      "token_start": 1264,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 355270,
      "end_ms": 356950,
      "text": "历代皇帝登基了，",
      "token_start": 1270,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 357390,
      "end_ms": 359050,
      "text": "要来记打仗了，",
      "token_start": 1277,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 359230,
      "end_ms": 359890,
      "text": "要来记。",
      "token_start": 1283,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 360810,
      "end_ms": 364730,
      "text": "武朝换代了清皇帝第一件事还是来记，",
      "token_start": 1286,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 365050,
      "end_ms": 365910,
      "text": "一直记到。",
      "token_start": 1302,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 365910,
      "end_ms": 367330,
      "text": "今天两千多，",
      "token_start": 1306,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 367560,
      "end_ms": 368900,
      "text": "当年没断过。",
      "token_start": 1311,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 369060,
      "end_ms": 371325,
      "text": "每年清明国家功绩，",
      "token_start": 1316,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 371750,
      "end_ms": 375635,
      "text": "海内外华人几万人聚在桥山脚下，",
      "token_start": 1324,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 376250,
      "end_ms": 377615,
      "text": "皇帝手执摆，",
      "token_start": 1338,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 378280,
      "end_ms": 380955,
      "text": "传说是皇帝亲手种的，",
      "token_start": 1343,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 381200,
      "end_ms": 382255,
      "text": "五千多年了，",
      "token_start": 1352,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 382630,
      "end_ms": 383295,
      "text": "还活着，",
      "token_start": 1357,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 383650,
      "end_ms": 385615,
      "text": "七个人合抱都抱不过来。",
      "token_start": 1360,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 386020,
      "end_ms": 386755,
      "text": "您想想，",
      "token_start": 1370,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 387240,
      "end_ms": 390485,
      "text": "前面九座陵埋的是金银珠宝，",
      "token_start": 1373,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 390750,
      "end_ms": 391450,
      "text": "是水银，",
      "token_start": 1385,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 391550,
      "end_ms": 392215,
      "text": "江河，",
      "token_start": 1388,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 392670,
      "end_ms": 394225,
      "text": "是铁水封门。",
      "token_start": 1390,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 394600,
      "end_ms": 396775,
      "text": "皇帝陵埋的是什么？",
      "token_start": 1395,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 397220,
      "end_ms": 398320,
      "text": "是中国人的根，",
      "token_start": 1403,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 398600,
      "end_ms": 402505,
      "text": "是每个中国人走到哪儿都忘不了的那个老家，",
      "token_start": 1409,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 402920,
      "end_ms": 403500,
      "text": "别的灵，",
      "token_start": 1428,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 403720,
      "end_ms": 406655,
      "text": "再牛都是一个人的黄帝陵，",
      "token_start": 1431,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 407640,
      "end_ms": 408665,
      "text": "是所有人的，",
      "token_start": 1442,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 410090,
      "end_ms": 411225,
      "text": "您听出来了没有？",
      "token_start": 1447,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 411500,
      "end_ms": 418210,
      "text": "这十座帝王陵没有一座是光靠大出名的北宋皇陵，",
      "token_start": 1454,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 418490,
      "end_ms": 419545,
      "text": "靠的是通透。",
      "token_start": 1475,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 420140,
      "end_ms": 422035,
      "text": "西夏王陵靠的是不长草，",
      "token_start": 1480,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 422530,
      "end_ms": 424350,
      "text": "汉阳陵靠的是缩威。",
      "token_start": 1490,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 424350,
      "end_ms": 426150,
      "text": "人间唐昭陵，",
      "token_start": 1498,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 426150,
      "end_ms": 427195,
      "text": "靠的是老兄弟。",
      "token_start": 1503,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 427530,
      "end_ms": 428170,
      "text": "明定陵，",
      "token_start": 1509,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 428170,
      "end_ms": 429045,
      "text": "靠的是教训。",
      "token_start": 1512,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 429680,
      "end_ms": 431255,
      "text": "茂陵靠的是塞不下，",
      "token_start": 1517,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 431750,
      "end_ms": 432770,
      "text": "秦始皇陵，",
      "token_start": 1525,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 432790,
      "end_ms": 433865,
      "text": "靠的是不敢挖。",
      "token_start": 1529,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 434340,
      "end_ms": 437640,
      "text": "乾陵靠的是挖不动成吉思汗陵，",
      "token_start": 1535,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 437640,
      "end_ms": 440360,
      "text": "靠的是找不着皇帝陵，",
      "token_start": 1548,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 440360,
      "end_ms": 443530,
      "text": "靠的是所有人都认，",
      "token_start": 1557,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 443610,
      "end_ms": 447285,
      "text": "您发现没有这些灵厉害的地方，",
      "token_start": 1565,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 447660,
      "end_ms": 449405,
      "text": "不在于埋了多少宝贝，",
      "token_start": 1578,
      "token_end_exclusive": 1587
    },
    {
      "start_ms": 450110,
      "end_ms": 456035,
      "text": "在于每一座都藏着一段中国人自己的故事，",
      "token_start": 1587,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 456820,
      "end_ms": 457540,
      "text": "点个关注，",
      "token_start": 1605,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 457760,
      "end_ms": 459555,
      "text": "咱们下期接着聊。",
      "token_start": 1609,
      "token_end_exclusive": 1616
    }
  ],
