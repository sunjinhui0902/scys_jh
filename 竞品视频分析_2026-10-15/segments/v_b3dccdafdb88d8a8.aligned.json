{
  "video_id": "v_b3dccdafdb88d8a8",
  "duration_s": 398.416667,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b3dccdafdb88d8a8.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b3dccdafdb88d8a8.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 1950,
      "text": "二零一一年二月二十六号，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2450,
      "end_ms": 3870,
      "text": "北京下着大雪，",
      "token_start": 11,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4690,
      "end_ms": 7290,
      "text": "一个八十七岁的老头走了，",
      "token_start": 17,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 8010,
      "end_ms": 8950,
      "text": "没有热搜，",
      "token_start": 28,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 9550,
      "end_ms": 10570,
      "text": "没有头条，",
      "token_start": 32,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 11010,
      "end_ms": 12670,
      "text": "没有全网哀悼。",
      "token_start": 36,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 12930,
      "end_ms": 17930,
      "text": "单位门口的布告栏上就贴了一张白纸黑字的布告，",
      "token_start": 42,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 18170,
      "end_ms": 21050,
      "text": "安安静静跟什么都没发生似的。",
      "token_start": 63,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 21270,
      "end_ms": 23190,
      "text": "邻居路过扫了一眼，",
      "token_start": 76,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 23450,
      "end_ms": 24510,
      "text": "当场就傻了。",
      "token_start": 84,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 24790,
      "end_ms": 27890,
      "text": "这个每天骑个破自行车买菜排队，",
      "token_start": 89,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 27890,
      "end_ms": 29870,
      "text": "见谁都笑呵呵。",
      "token_start": 103,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 29870,
      "end_ms": 32980,
      "text": "呵科的老头竟然是两弹一星。",
      "token_start": 109,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 33100,
      "end_ms": 36980,
      "text": "二十三昧元勋里最后一个被解密的人，",
      "token_start": 121,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 37060,
      "end_ms": 37940,
      "text": "他叫朱光亚。",
      "token_start": 137,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 39160,
      "end_ms": 44740,
      "text": "今天我就给你讲讲这个老头的一生有多狠，",
      "token_start": 142,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 45820,
      "end_ms": 47320,
      "text": "有多让人心疼。",
      "token_start": 160,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 48380,
      "end_ms": 53930,
      "text": "时间倒回一九四五年那一年，",
      "token_start": 166,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 55270,
      "end_ms": 60815,
      "text": "朱光亚二十一岁被当时的政府派去美国学造原子弹。",
      "token_start": 178,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 61730,
      "end_ms": 65240,
      "text": "物理学家吴大由带着朱光亚李政道，",
      "token_start": 200,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 65440,
      "end_ms": 67965,
      "text": "还有几个教授兴冲冲就去了，",
      "token_start": 215,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 68790,
      "end_ms": 70890,
      "text": "结果呢踏上美国土地。",
      "token_start": 227,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 70890,
      "end_ms": 71375,
      "text": "第一天，",
      "token_start": 236,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 71890,
      "end_ms": 75120,
      "text": "当头一棒美国人说，",
      "token_start": 239,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 75420,
      "end_ms": 79565,
      "text": "核设施基地中国人连门口都不许站，",
      "token_start": 247,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 80620,
      "end_ms": 81660,
      "text": "不是针对谁？",
      "token_start": 262,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 81820,
      "end_ms": 83060,
      "text": "是一九四六年。",
      "token_start": 267,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 83120,
      "end_ms": 85825,
      "text": "美国刚出台了原子能法，",
      "token_start": 273,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 86300,
      "end_ms": 88625,
      "text": "核技术列成了最高机密，",
      "token_start": 283,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 89340,
      "end_ms": 90335,
      "text": "谁都不让碰。",
      "token_start": 293,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 90690,
      "end_ms": 94310,
      "text": "英国二战时跟美国合伙搞曼哈顿计划，",
      "token_start": 298,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 94530,
      "end_ms": 97135,
      "text": "战后照样被拒之门外。",
      "token_start": 314,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 97580,
      "end_ms": 98405,
      "text": "但你想想，",
      "token_start": 323,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 98810,
      "end_ms": 103685,
      "text": "一个二十一岁的中国年轻人大老远跑来学造原子弹，",
      "token_start": 327,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 104120,
      "end_ms": 106075,
      "text": "结果连大门都进不去，",
      "token_start": 349,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 106380,
      "end_ms": 107075,
      "text": "这叫什么？",
      "token_start": 358,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 107320,
      "end_ms": 108315,
      "text": "这不是拒绝，",
      "token_start": 362,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 108760,
      "end_ms": 112525,
      "text": "这是把一个民族的尊严暗在泥里踩。",
      "token_start": 367,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 113540,
      "end_ms": 115385,
      "text": "朱光亚没吵没闹，",
      "token_start": 382,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 116290,
      "end_ms": 118990,
      "text": "把这口气咽进了骨头里。",
      "token_start": 389,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 119050,
      "end_ms": 121075,
      "text": "他转身进了密歇根大学，",
      "token_start": 399,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 121500,
      "end_ms": 123185,
      "text": "一头扎进实验室。",
      "token_start": 409,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 123630,
      "end_ms": 125315,
      "text": "别人喝咖啡谈恋爱，",
      "token_start": 416,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 125630,
      "end_ms": 126685,
      "text": "他在啃和物理。",
      "token_start": 424,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 127580,
      "end_ms": 129345,
      "text": "三年整整三年，",
      "token_start": 430,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 129980,
      "end_ms": 132155,
      "text": "他拿下了核物理博士学位，",
      "token_start": 436,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 132620,
      "end_ms": 136505,
      "text": "门门功克全a连拿了四年奖学金。",
      "token_start": 447,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 137090,
      "end_ms": 138655,
      "text": "导师后来说了一句话，",
      "token_start": 461,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 139170,
      "end_ms": 140695,
      "text": "批改朱光亚的论文，",
      "token_start": 470,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 141200,
      "end_ms": 145655,
      "text": "不像在评判学生更像在见证一颗原子弹的诞生。",
      "token_start": 478,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 146430,
      "end_ms": 147515,
      "text": "这话狂不狂，",
      "token_start": 498,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 148010,
      "end_ms": 149685,
      "text": "但人家有狂的资本。",
      "token_start": 503,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 150390,
      "end_ms": 151645,
      "text": "一九四九年，",
      "token_start": 511,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 152000,
      "end_ms": 153595,
      "text": "朱光亚博士毕业了，",
      "token_start": 516,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 154070,
      "end_ms": 154610,
      "text": "这时候，",
      "token_start": 524,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 154610,
      "end_ms": 156910,
      "text": "他面前摆着两条路一条路，",
      "token_start": 527,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 157130,
      "end_ms": 161150,
      "text": "留在美国高薪洋房实验室，",
      "token_start": 538,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 161450,
      "end_ms": 163085,
      "text": "前途一片光明。",
      "token_start": 549,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 163980,
      "end_ms": 167655,
      "text": "他的同学李政道就是选了这条路，",
      "token_start": 555,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 168710,
      "end_ms": 171515,
      "text": "后来跟杨振宁一起拿了诺贝尔奖，",
      "token_start": 569,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 172080,
      "end_ms": 174185,
      "text": "另一条路回中国。",
      "token_start": 583,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 174940,
      "end_ms": 177025,
      "text": "那时候的中国刚打完仗，",
      "token_start": 590,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 177330,
      "end_ms": 178230,
      "text": "百废待兴，",
      "token_start": 600,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 178510,
      "end_ms": 179625,
      "text": "别说原子弹了，",
      "token_start": 604,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 179890,
      "end_ms": 181230,
      "text": "圆珠笔都造不出来，",
      "token_start": 610,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 181490,
      "end_ms": 182550,
      "text": "回去能干啥。",
      "token_start": 618,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 184450,
      "end_ms": 185970,
      "text": "朱光亚选了第二条，",
      "token_start": 623,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 186470,
      "end_ms": 187470,
      "text": "不光自己回，",
      "token_start": 631,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 187930,
      "end_ms": 190990,
      "text": "他还干了一件震动美国学界的大事。",
      "token_start": 636,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 191710,
      "end_ms": 193150,
      "text": "一九五零年春天，",
      "token_start": 651,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 193550,
      "end_ms": 197930,
      "text": "二十六岁的朱光亚把自己关在宿舍里写了整整一夜。",
      "token_start": 658,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 199370,
      "end_ms": 199970,
      "text": "第二天，",
      "token_start": 680,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 200910,
      "end_ms": 208110,
      "text": "一封给留美同学的一封公开信塞进了全美各高校中国留学生的信箱。",
      "token_start": 683,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 209130,
      "end_ms": 210240,
      "text": "信里有一封段话，",
      "token_start": 712,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 211220,
      "end_ms": 213700,
      "text": "今天读起来还让人热血上头。",
      "token_start": 719,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 214320,
      "end_ms": 214900,
      "text": "回去吧，",
      "token_start": 731,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 216620,
      "end_ms": 218140,
      "text": "祖国在向我们召唤，",
      "token_start": 734,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 219080,
      "end_ms": 220880,
      "text": "我们都是在中国长大的，",
      "token_start": 742,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 221720,
      "end_ms": 223220,
      "text": "不曾种过一粒米，",
      "token_start": 752,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 223400,
      "end_ms": 224780,
      "text": "不曾挖过一块煤。",
      "token_start": 759,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 225260,
      "end_ms": 228480,
      "text": "我们都是靠千千万万中日劳动的，",
      "token_start": 766,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 228620,
      "end_ms": 231720,
      "text": "中国工农大众的血汗供养长大，",
      "token_start": 780,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 232440,
      "end_ms": 236800,
      "text": "让我们回去把血汗洒在祖国的土地上。",
      "token_start": 793,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 236840,
      "end_ms": 239460,
      "text": "这封信带着十几个惊叹号，",
      "token_start": 809,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 240030,
      "end_ms": 241245,
      "text": "像一颗炸弹，",
      "token_start": 820,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 241930,
      "end_ms": 245654,
      "text": "在留美学生里炸开了五十二个人签的名。",
      "token_start": 825,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 246610,
      "end_ms": 251090,
      "text": "五十二把实验室的钥匙扔进了太平洋五十二个。",
      "token_start": 842,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 251090,
      "end_ms": 253305,
      "text": "美国做梦都想留住的大脑，",
      "token_start": 862,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 253630,
      "end_ms": 257760,
      "text": "在同一艘船上掉头向东李征。",
      "token_start": 873,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 257760,
      "end_ms": 259065,
      "text": "到后来开玩笑说，",
      "token_start": 885,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 259950,
      "end_ms": 261795,
      "text": "当年派去美国的人礼，",
      "token_start": 892,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 262120,
      "end_ms": 264550,
      "text": "只有朱光雅是派对的派，",
      "token_start": 901,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 264550,
      "end_ms": 265925,
      "text": "我算是派错了，",
      "token_start": 911,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 266380,
      "end_ms": 268085,
      "text": "因为朱光亚真回去了，",
      "token_start": 917,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 268440,
      "end_ms": 269785,
      "text": "回到了新中国。",
      "token_start": 926,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 270570,
      "end_ms": 271990,
      "text": "一九五零年二月，",
      "token_start": 932,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 272290,
      "end_ms": 276655,
      "text": "朱光亚拒绝了美国的救济舰登上了回国的船，",
      "token_start": 939,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 277620,
      "end_ms": 279455,
      "text": "他心里只有一个念头，",
      "token_start": 958,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 280220,
      "end_ms": 283485,
      "text": "中国人必须有自己的原子弹。",
      "token_start": 967,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 284460,
      "end_ms": 285615,
      "text": "但他没想到，",
      "token_start": 979,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 286340,
      "end_ms": 287495,
      "text": "回国之后，",
      "token_start": 984,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 288220,
      "end_ms": 291385,
      "text": "真正的苦日子才刚开始。",
      "token_start": 988,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 291880,
      "end_ms": 292800,
      "text": "一九五二年，",
      "token_start": 998,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 292980,
      "end_ms": 294525,
      "text": "抗美援朝打的正凶。",
      "token_start": 1003,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 294710,
      "end_ms": 294945,
      "text": "嗯，",
      "token_start": 1011,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 295190,
      "end_ms": 300385,
      "text": "朱光雅被派去板门店当停战谈判的英文翻译。",
      "token_start": 1012,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 301120,
      "end_ms": 301820,
      "text": "临走前，",
      "token_start": 1031,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 302140,
      "end_ms": 303975,
      "text": "他跟妻子许慧君说，",
      "token_start": 1034,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 305100,
      "end_ms": 306465,
      "text": "我去东北打老虎，",
      "token_start": 1042,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 306930,
      "end_ms": 307975,
      "text": "到了谈判桌上。",
      "token_start": 1049,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 308310,
      "end_ms": 310350,
      "text": "他每天面对的是什么？",
      "token_start": 1055,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 310670,
      "end_ms": 313590,
      "text": "是美方代表手里挥舞着核大棒，",
      "token_start": 1064,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 314050,
      "end_ms": 317110,
      "text": "扬言要对中国进行核打击。",
      "token_start": 1077,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 317330,
      "end_ms": 318730,
      "text": "人家手里有核弹，",
      "token_start": 1088,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 319070,
      "end_ms": 320290,
      "text": "说话腰杆就硬。",
      "token_start": 1095,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 320770,
      "end_ms": 324890,
      "text": "朱光亚坐在那里一字一句翻译的那些威胁的话，",
      "token_start": 1101,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 325230,
      "end_ms": 326210,
      "text": "心里在滴血。",
      "token_start": 1121,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 326690,
      "end_ms": 329630,
      "text": "他算是彻底明白了没有原子弹，",
      "token_start": 1126,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 330130,
      "end_ms": 333450,
      "text": "你在谈判桌上连大声说话的资格都没有。",
      "token_start": 1139,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 334350,
      "end_ms": 335190,
      "text": "回国之后，",
      "token_start": 1156,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 335350,
      "end_ms": 339520,
      "text": "朱光亚提笔写了一本原子能和原子武器，",
      "token_start": 1160,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 340320,
      "end_ms": 341740,
      "text": "不只是给别人看，",
      "token_start": 1177,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 342360,
      "end_ms": 344200,
      "text": "也是在提醒自己，",
      "token_start": 1184,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 344800,
      "end_ms": 346420,
      "text": "这个年轻的共和国，",
      "token_start": 1191,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 346800,
      "end_ms": 348740,
      "text": "绝对不能没有原子弹。",
      "token_start": 1199,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 349740,
      "end_ms": 350780,
      "text": "一九五五年，",
      "token_start": 1208,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 351160,
      "end_ms": 354259,
      "text": "中国终于启动了原子能工业。",
      "token_start": 1213,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 354419,
      "end_ms": 356880,
      "text": "一开始有苏联老大哥帮忙，",
      "token_start": 1225,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 357140,
      "end_ms": 359040,
      "text": "朱光亚心里还踏实点，",
      "token_start": 1236,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 359900,
      "end_ms": 361180,
      "text": "可谁又能想到，",
      "token_start": 1245,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 361460,
      "end_ms": 365020,
      "text": "一九五九年中苏的关系说崩就崩？",
      "token_start": 1251,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 365580,
      "end_ms": 367715,
      "text": "苏联人拍拍屁股走了，",
      "token_start": 1265,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 368120,
      "end_ms": 369205,
      "text": "主纸带走了，",
      "token_start": 1274,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 369640,
      "end_ms": 370920,
      "text": "专家也撤走了，",
      "token_start": 1279,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 370960,
      "end_ms": 372195,
      "text": "还丢下一句话，",
      "token_start": 1285,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 372830,
      "end_ms": 373615,
      "text": "没有我们，",
      "token_start": 1291,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 374500,
      "end_ms": 377645,
      "text": "你们中国二十年也搞不出原子弹，",
      "token_start": 1295,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 378540,
      "end_ms": 379795,
      "text": "就是在这一年，",
      "token_start": 1309,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 380350,
      "end_ms": 385305,
      "text": "三十五岁的朱光亚像人间蒸发一样消失了。",
      "token_start": 1315,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 386160,
      "end_ms": 386925,
      "text": "他去了哪儿，",
      "token_start": 1333,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 387770,
      "end_ms": 388715,
      "text": "他干了什么，",
      "token_start": 1338,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 389700,
      "end_ms": 391160,
      "text": "他的妻子不知道，",
      "token_start": 1343,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 391220,
      "end_ms": 392280,
      "text": "邻居不知道，",
      "token_start": 1350,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 392520,
      "end_ms": 394265,
      "text": "连他的孩子都不知道，",
      "token_start": 1355,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 394670,
      "end_ms": 398390,
      "text": "只知道这个家的男人突然就没了。",
      "token_start": 1364,
      "token_end_exclusive": 1378
    }
  ],
