{
  "video_id": "v_1d871674fe185072",
  "duration_s": 498.904921,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1d871674fe185072.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1d871674fe185072.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 2810,
      "text": "前一阵咱们看了不少大好河山，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3570,
      "end_ms": 6710,
      "text": "可您发现没有再好看的风景，",
      "token_start": 13,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 7030,
      "end_ms": 8790,
      "text": "底下总踩着一座城。",
      "token_start": 25,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 9570,
      "end_ms": 11190,
      "text": "今天咱们换个走法，",
      "token_start": 33,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 11650,
      "end_ms": 12870,
      "text": "不往山上看，",
      "token_start": 41,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 13410,
      "end_ms": 15030,
      "text": "往城里走一走。",
      "token_start": 46,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 15390,
      "end_ms": 20650,
      "text": "您说被写进古诗里最多的城市会是哪一座？",
      "token_start": 52,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 20950,
      "end_ms": 25190,
      "text": "有人说是杭州光写西湖写钱塘的诗，",
      "token_start": 70,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 25590,
      "end_ms": 28310,
      "text": "据统计就有一万两千多首。",
      "token_start": 85,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 28690,
      "end_ms": 31040,
      "text": "有人说是南京金陵，",
      "token_start": 96,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 31380,
      "end_ms": 34860,
      "text": "秦淮乌衣巷加起来九千多首，",
      "token_start": 104,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 35660,
      "end_ms": 37320,
      "text": "对不住了杭州，",
      "token_start": 116,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 37360,
      "end_ms": 38460,
      "text": "只能排第二。",
      "token_start": 122,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 38940,
      "end_ms": 45580,
      "text": "南京连前二都进不了真正排在榜首的那座城写他的诗，",
      "token_start": 127,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 46000,
      "end_ms": 46700,
      "text": "据统计，",
      "token_start": 150,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 46940,
      "end_ms": 50660,
      "text": "两万多首比杭州还多出八千多首。",
      "token_start": 153,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 51280,
      "end_ms": 53180,
      "text": "他的名字就两个字，",
      "token_start": 167,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 53940,
      "end_ms": 55500,
      "text": "在唐宋诗词里，",
      "token_start": 175,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 55780,
      "end_ms": 59400,
      "text": "光是这两个字就出现了一万四千多字。",
      "token_start": 181,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 59660,
      "end_ms": 65885,
      "text": "今今天咱们就来盘点中国历史上被写进古诗里最多的十大名城。",
      "token_start": 197,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 66430,
      "end_ms": 68470,
      "text": "这十座城有没有您家？",
      "token_start": 224,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 68470,
      "end_ms": 70605,
      "text": "那座咱们一座一座看，",
      "token_start": 233,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 70930,
      "end_ms": 72710,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 242,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 72810,
      "end_ms": 73675,
      "text": "收藏起来，",
      "token_start": 252,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 74040,
      "end_ms": 74960,
      "text": "省得手一滑，",
      "token_start": 256,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 74980,
      "end_ms": 77305,
      "text": "咱们就错过了第十名。",
      "token_start": 261,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 77830,
      "end_ms": 80555,
      "text": "苏州古时候叫姑苏，",
      "token_start": 270,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 81160,
      "end_ms": 85175,
      "text": "也叫吴忠太湖边上的一座水城，",
      "token_start": 278,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 86010,
      "end_ms": 90230,
      "text": "写苏州的诗存世将近三千五百首，",
      "token_start": 291,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 90630,
      "end_ms": 96725,
      "text": "最有名的是您小时候背过的那首姑苏城外寒山寺，",
      "token_start": 305,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 97130,
      "end_ms": 103075,
      "text": "夜半钟声到客船写诗的张继是个赶路的读书人，",
      "token_start": 326,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 103620,
      "end_ms": 105200,
      "text": "船停在枫桥边，",
      "token_start": 346,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 105580,
      "end_ms": 106255,
      "text": "睡不着，",
      "token_start": 352,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 106790,
      "end_ms": 111155,
      "text": "听见寒山寺半夜敲钟就二十八个字，",
      "token_start": 355,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 111480,
      "end_ms": 115290,
      "text": "唐朝写下传到今天寺里。",
      "token_start": 370,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 115290,
      "end_ms": 119195,
      "text": "这口钟每年除夕夜还要敲一百零八下，",
      "token_start": 380,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 119910,
      "end_ms": 121330,
      "text": "不少人专门赶来，",
      "token_start": 396,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 121890,
      "end_ms": 123310,
      "text": "就为听这一下。",
      "token_start": 403,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 123650,
      "end_ms": 126650,
      "text": "后来的文人顺着钟声往下写写，",
      "token_start": 409,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 126690,
      "end_ms": 128230,
      "text": "小桥写河道，",
      "token_start": 422,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 128530,
      "end_ms": 130130,
      "text": "写吴地软软的口音，",
      "token_start": 427,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 130610,
      "end_ms": 134510,
      "text": "一写就是三千多首三千多首诗写下来，",
      "token_start": 435,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 134830,
      "end_ms": 136830,
      "text": "其实写的不是城有多大，",
      "token_start": 451,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 137250,
      "end_ms": 139770,
      "text": "而是奔波了一辈子的普通人，",
      "token_start": 461,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 140350,
      "end_ms": 141450,
      "text": "心里头多想，",
      "token_start": 473,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 141510,
      "end_ms": 146770,
      "text": "有这么一处能让自己慢下来的江南水乡第九名。",
      "token_start": 478,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 147170,
      "end_ms": 149525,
      "text": "成都古时候叫景观城，",
      "token_start": 498,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 150160,
      "end_ms": 151120,
      "text": "也叫益州，",
      "token_start": 507,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 151920,
      "end_ms": 154640,
      "text": "历代写成都的诗超过三千首。",
      "token_start": 511,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 155400,
      "end_ms": 157220,
      "text": "光是杜甫住在这里，",
      "token_start": 523,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 157240,
      "end_ms": 160800,
      "text": "几年就一个人写了将近二百五十首。",
      "token_start": 531,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 161220,
      "end_ms": 162840,
      "text": "那时候安史之乱爆发，",
      "token_start": 546,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 163420,
      "end_ms": 165880,
      "text": "诗圣一路逃难到浣花溪边，",
      "token_start": 555,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 166480,
      "end_ms": 168100,
      "text": "盖了三间破草房，",
      "token_start": 566,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 168800,
      "end_ms": 175160,
      "text": "写下晓看红湿处花重锦关城说的是清晨推开柴门，",
      "token_start": 573,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 175880,
      "end_ms": 178820,
      "text": "满城湿润的落花映红了眼睛，",
      "token_start": 594,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 179220,
      "end_ms": 184925,
      "text": "颠沛被琉璃的大半辈子全在成都的绿竹和细雨里被治愈了。",
      "token_start": 606,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 185370,
      "end_ms": 187555,
      "text": "您今天去杜甫草堂走一圈，",
      "token_start": 631,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 188000,
      "end_ms": 188440,
      "text": "参天，",
      "token_start": 642,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 188500,
      "end_ms": 189780,
      "text": "红墙幽深，",
      "token_start": 644,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 189800,
      "end_ms": 191590,
      "text": "竹林风吹过来，",
      "token_start": 648,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 191590,
      "end_ms": 192435,
      "text": "凉悠悠的。",
      "token_start": 654,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 192870,
      "end_ms": 196035,
      "text": "老人们在树荫底下摇着蒲扇喝盖碗茶，",
      "token_start": 658,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 196470,
      "end_ms": 198735,
      "text": "还是那个最安生的慢日子。",
      "token_start": 674,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 199150,
      "end_ms": 201555,
      "text": "三千首诗写进锦官城，",
      "token_start": 685,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 202140,
      "end_ms": 206595,
      "text": "能让流离失所的诗圣写出两百多首安乐诗，",
      "token_start": 694,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 207340,
      "end_ms": 208155,
      "text": "您想想，",
      "token_start": 712,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 208560,
      "end_ms": 210615,
      "text": "这得是多温暖的一座城。",
      "token_start": 715,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 211030,
      "end_ms": 212645,
      "text": "第八名武汉，",
      "token_start": 725,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 213380,
      "end_ms": 214745,
      "text": "古时候叫江城，",
      "token_start": 730,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 215400,
      "end_ms": 216620,
      "text": "长江和汗水。",
      "token_start": 736,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 216660,
      "end_ms": 217445,
      "text": "在这碰头，",
      "token_start": 741,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 218140,
      "end_ms": 224005,
      "text": "历代写武昌、汉阳和黄鹤楼的名篇超过三千五百首。",
      "token_start": 745,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 224420,
      "end_ms": 228765,
      "text": "崔颢站在蛇山顶上写下黄鹤一去不复返，",
      "token_start": 766,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 229390,
      "end_ms": 231235,
      "text": "白云千载空悠悠。",
      "token_start": 783,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 231840,
      "end_ms": 233025,
      "text": "意思特明白，",
      "token_start": 790,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 233570,
      "end_ms": 235275,
      "text": "神仙早就飞走了，",
      "token_start": 795,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 235710,
      "end_ms": 238715,
      "text": "眼前只剩万古不变的悠悠白云，",
      "token_start": 802,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 239280,
      "end_ms": 241705,
      "text": "连李白来了都戈壁长叹。",
      "token_start": 815,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 242140,
      "end_ms": 244535,
      "text": "长江和汉水在城下碰头，",
      "token_start": 825,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 245020,
      "end_ms": 246895,
      "text": "把这里变成水陆枢纽，",
      "token_start": 835,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 247440,
      "end_ms": 252435,
      "text": "也成了天下游子告别故土、奔赴远方的第一关口。",
      "token_start": 844,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 252850,
      "end_ms": 254330,
      "text": "您登上晴川阁，",
      "token_start": 864,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 254530,
      "end_ms": 255565,
      "text": "隔江一望，",
      "token_start": 870,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 255880,
      "end_ms": 257440,
      "text": "大江滚滚东流。",
      "token_start": 874,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 257820,
      "end_ms": 258915,
      "text": "汽笛一响，",
      "token_start": 880,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 259390,
      "end_ms": 262215,
      "text": "心里头那股沉甸甸的乡愁，",
      "token_start": 884,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 262680,
      "end_ms": 263780,
      "text": "不用谁多说，",
      "token_start": 895,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 264080,
      "end_ms": 265270,
      "text": "自己就涌上来了。",
      "token_start": 900,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 265760,
      "end_ms": 269295,
      "text": "三千五百多首送别诗留在这片江面上，",
      "token_start": 907,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 270130,
      "end_ms": 276090,
      "text": "江水带走的是离人留下的全是割舍不下的故土。",
      "token_start": 923,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 276110,
      "end_ms": 276605,
      "text": "亲情。",
      "token_start": 943,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 276980,
      "end_ms": 277725,
      "text": "第七名，",
      "token_start": 945,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 278090,
      "end_ms": 280785,
      "text": "岳阳古时候叫巴陵，",
      "token_start": 948,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 281370,
      "end_ms": 283575,
      "text": "在八百里洞庭湖边上，",
      "token_start": 956,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 284150,
      "end_ms": 289965,
      "text": "历代吟宋岳阳和洞庭湖的名作足足有四千多首。",
      "token_start": 965,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 290460,
      "end_ms": 294255,
      "text": "杜甫登岳阳楼写下吴楚东南渡，",
      "token_start": 985,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 294610,
      "end_ms": 296065,
      "text": "乾坤日夜浮。",
      "token_start": 998,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 296760,
      "end_ms": 302340,
      "text": "胡大的像把吴地和楚地撕开天和地都在水面上，",
      "token_start": 1003,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 302340,
      "end_ms": 305520,
      "text": "漂那年他五十七岁又老，",
      "token_start": 1023,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 305540,
      "end_ms": 306520,
      "text": "又病家，",
      "token_start": 1033,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 306540,
      "end_ms": 307635,
      "text": "就是一条船。",
      "token_start": 1036,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 308160,
      "end_ms": 308895,
      "text": "两年后。",
      "token_start": 1041,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 309310,
      "end_ms": 311650,
      "text": "人死在湖南的一条船上，",
      "token_start": 1044,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 312110,
      "end_ms": 317270,
      "text": "过了二百七十多年范仲淹一句先天下之忧而忧，",
      "token_start": 1054,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 317830,
      "end_ms": 323210,
      "text": "硬生生把一座楼的风景拔成了中国士大夫的脊梁骨。",
      "token_start": 1074,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 323570,
      "end_ms": 326070,
      "text": "您今天站在岳阳楼廊檐下，",
      "token_start": 1096,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 326610,
      "end_ms": 327630,
      "text": "极目望去，",
      "token_start": 1107,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 327770,
      "end_ms": 328890,
      "text": "水天一色，",
      "token_start": 1111,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 329470,
      "end_ms": 331050,
      "text": "浪头拍在石矶上，",
      "token_start": 1115,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 331110,
      "end_ms": 331990,
      "text": "砰砰作响，",
      "token_start": 1122,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 332410,
      "end_ms": 334570,
      "text": "胸膛自然就跟着挺了起来。",
      "token_start": 1126,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 334950,
      "end_ms": 338110,
      "text": "四千多首壮阔诗篇立在风浪里。",
      "token_start": 1137,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 338510,
      "end_ms": 341840,
      "text": "老祖宗宗留给咱们的这四千多绝唱，",
      "token_start": 1150,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 342240,
      "end_ms": 343320,
      "text": "教的是做人，",
      "token_start": 1165,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 343320,
      "end_ms": 345200,
      "text": "心里该有的一股骨气。",
      "token_start": 1170,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 345600,
      "end_ms": 346280,
      "text": "第六名，",
      "token_start": 1179,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 346680,
      "end_ms": 347219,
      "text": "扬州，",
      "token_start": 1182,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 348020,
      "end_ms": 349440,
      "text": "古时候叫广陵，",
      "token_start": 1184,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 350220,
      "end_ms": 352620,
      "text": "京杭大运河边上的老码头，",
      "token_start": 1190,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 353420,
      "end_ms": 359560,
      "text": "前面四座城写诗的数量都在三四千首到了扬州，",
      "token_start": 1201,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 360040,
      "end_ms": 362540,
      "text": "一下子蹦到将近八千首，",
      "token_start": 1221,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 363060,
      "end_ms": 364460,
      "text": "直接翻了一倍。",
      "token_start": 1231,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 364900,
      "end_ms": 365480,
      "text": "为什么？",
      "token_start": 1237,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 365700,
      "end_ms": 368120,
      "text": "因为运河南来北往，",
      "token_start": 1240,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 368240,
      "end_ms": 369750,
      "text": "运盐运到梁的船，",
      "token_start": 1248,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 370190,
      "end_ms": 371755,
      "text": "都得在扬州靠岸，",
      "token_start": 1255,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 372510,
      "end_ms": 382075,
      "text": "盐商扎堆李白、杜牧这些大诗人也一波一波的来李白一句烟花三月下扬州，",
      "token_start": 1262,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 382500,
      "end_ms": 390435,
      "text": "把暮春柳絮写成了天下相王杜牧又添一句二十四桥明月夜，",
      "token_start": 1293,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 390820,
      "end_ms": 393705,
      "text": "把清冷月光洒满了画法。",
      "token_start": 1318,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 394090,
      "end_ms": 395245,
      "text": "大唐的豪放，",
      "token_start": 1328,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 395600,
      "end_ms": 396665,
      "text": "大宋的温暖，",
      "token_start": 1333,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 397000,
      "end_ms": 398580,
      "text": "大清的富庶文，",
      "token_start": 1338,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 398620,
      "end_ms": 400525,
      "text": "人们兜里有钱没钱，",
      "token_start": 1344,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 400980,
      "end_ms": 405295,
      "text": "全把最放浪的笔墨倾倒在瘦西湖的水面上。",
      "token_start": 1352,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 405660,
      "end_ms": 407665,
      "text": "您今天走上二十四桥，",
      "token_start": 1370,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 408160,
      "end_ms": 409300,
      "text": "玉带般的水面，",
      "token_start": 1379,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 409340,
      "end_ms": 410235,
      "text": "泛着涟漪，",
      "token_start": 1385,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 410710,
      "end_ms": 412165,
      "text": "两岸垂柳依依，",
      "token_start": 1389,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 412550,
      "end_ms": 416430,
      "text": "那份极尽繁华后的微凉依然扑面而来。",
      "token_start": 1395,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 416890,
      "end_ms": 419975,
      "text": "将近八千首诗砸在扬州城里，",
      "token_start": 1411,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 420500,
      "end_ms": 421820,
      "text": "那是古代文人，",
      "token_start": 1423,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 421880,
      "end_ms": 425040,
      "text": "把最阔绰的春光全掏给了。",
      "token_start": 1429,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 425040,
      "end_ms": 427615,
      "text": "这里谁读了能不动心？",
      "token_start": 1440,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 427970,
      "end_ms": 429530,
      "text": "从第十到第六名，",
      "token_start": 1449,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 429530,
      "end_ms": 433055,
      "text": "是舟在客船里敲响了千年晚钟。",
      "token_start": 1456,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 433580,
      "end_ms": 441285,
      "text": "成都在草堂绿竹中安顿的流离失圣武汉在长江风浪前送进的天涯游子。",
      "token_start": 1469,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 441740,
      "end_ms": 445020,
      "text": "岳阳在八百里洞庭边挺直了文人家国，",
      "token_start": 1499,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 445460,
      "end_ms": 449145,
      "text": "扬州在大运河波光里聚起了八千首风乐，",
      "token_start": 1515,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 449530,
      "end_ms": 452905,
      "text": "可他们还不是被写进古诗里最多的。",
      "token_start": 1532,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 453440,
      "end_ms": 455705,
      "text": "接下来第五道第一名更吓人，",
      "token_start": 1547,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 456350,
      "end_ms": 467635,
      "text": "有个老都城满大街的热闹日子被古人写进了一万多首词里有一座城文豪亲自筑起长堤，",
      "token_start": 1559,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 468070,
      "end_ms": 470290,
      "text": "写下一万两千首绝唱，",
      "token_start": 1596,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 470630,
      "end_ms": 472975,
      "text": "可排在榜首的那座城。",
      "token_start": 1605,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 473640,
      "end_ms": 475275,
      "text": "古人只要一提笔，",
      "token_start": 1614,
      "token_end_exclusive": 1621
    },
    {
      "start_ms": 475760,
      "end_ms": 479325,
      "text": "满篇写下的都是走不出的功名与天下。",
      "token_start": 1621,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 479730,
      "end_ms": 480545,
      "text": "他是哪座？",
      "token_start": 1637,
      "token_end_exclusive": 1641
    },
    {
      "start_ms": 480990,
      "end_ms": 486435,
      "text": "他凭什么能力压西湖与金陵下一集已经同步更新，",
      "token_start": 1641,
      "token_end_exclusive": 1662
    },
    {
      "start_ms": 487290,
      "end_ms": 488475,
      "text": "点开我的头像，",
      "token_start": 1662,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 488900,
      "end_ms": 491835,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1668,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 492330,
      "end_ms": 497715,
      "text": "看看谁才是中国历史上被写进古诗里最多的名称。",
      "token_start": 1680,
      "token_end_exclusive": 1701
    }
  ],
