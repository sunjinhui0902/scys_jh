{
  "video_id": "v_63829a063cf7908d",
  "duration_s": 364.368005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_63829a063cf7908d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_63829a063cf7908d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 670,
      "text": "您知道，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 670,
      "end_ms": 6510,
      "text": "中国大地上冬天最暖和的小城究竟藏在哪一个角落吗？",
      "token_start": 3,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6890,
      "end_ms": 9850,
      "text": "有人说是三亚东方夏威夷。",
      "token_start": 26,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 10130,
      "end_ms": 11410,
      "text": "有人说是海口，",
      "token_start": 37,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 11750,
      "end_ms": 14710,
      "text": "椰城真正要是真信了，",
      "token_start": 43,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 14950,
      "end_ms": 16129,
      "text": "那就被忽悠了。",
      "token_start": 52,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 16850,
      "end_ms": 19070,
      "text": "三亚和海口确实暖和，",
      "token_start": 58,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 19750,
      "end_ms": 21290,
      "text": "可他们一个地级市，",
      "token_start": 67,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 21530,
      "end_ms": 22910,
      "text": "一个省会人，",
      "token_start": 75,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 22970,
      "end_ms": 24810,
      "text": "多价高商业化，",
      "token_start": 80,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 25290,
      "end_ms": 27690,
      "text": "真正适合咱们退休以后慢慢住。",
      "token_start": 86,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 28030,
      "end_ms": 31480,
      "text": "慢慢过冬的是那些藏库藏在山间海边，",
      "token_start": 99,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 31880,
      "end_ms": 34840,
      "text": "物价便宜、阳光管够的小城。",
      "token_start": 115,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 35320,
      "end_ms": 39860,
      "text": "今天咱们就来盘点盘点中国冬天最暖的十座小城。",
      "token_start": 126,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 40200,
      "end_ms": 40820,
      "text": "老规矩，",
      "token_start": 147,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 41060,
      "end_ms": 41800,
      "text": "开讲之前，",
      "token_start": 150,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 41800,
      "end_ms": 44360,
      "text": "劳烦您顺手扣个一点颗红心，",
      "token_start": 154,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 44600,
      "end_ms": 46920,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 166,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 47260,
      "end_ms": 58960,
      "text": "云南弥勒在云南红河洲这地方最绝的是一座被阳光偏爱的滇南暖城弥勒年均气温十八点八摄氏度，",
      "token_start": 178,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 59320,
      "end_ms": 65425,
      "text": "冬季平均最高气温在十七点七摄氏度到二十点九摄氏度之间。",
      "token_start": 220,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 66120,
      "end_ms": 66900,
      "text": "入冬以来，",
      "token_start": 246,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 66900,
      "end_ms": 69490,
      "text": "平均二十二摄氏度的气温，",
      "token_start": 250,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 69610,
      "end_ms": 72570,
      "text": "让老年人可以尽情在户外散步。",
      "token_start": 261,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 72630,
      "end_ms": 73110,
      "text": "赏景。",
      "token_start": 274,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 73170,
      "end_ms": 83485,
      "text": "弥勒最出名的是温泉湖泉生态园周边及梅花温泉社区的民宿酒店预订量持续攀升。",
      "token_start": 276,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 83960,
      "end_ms": 85180,
      "text": "进入冬季以来，",
      "token_start": 311,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 85260,
      "end_ms": 87625,
      "text": "入住率基本是满房状态。",
      "token_start": 317,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 88170,
      "end_ms": 89815,
      "text": "一位吉林游客说的好，",
      "token_start": 327,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 90430,
      "end_ms": 92635,
      "text": "东北已经零下十五六度。",
      "token_start": 336,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 93530,
      "end_ms": 96085,
      "text": "这里气温太适合退休养老了。",
      "token_start": 346,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 96280,
      "end_ms": 98085,
      "text": "这座小城节奏慢，",
      "token_start": 358,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 98360,
      "end_ms": 99095,
      "text": "物价低，",
      "token_start": 365,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 99730,
      "end_ms": 101665,
      "text": "特别适合退休的老两口，",
      "token_start": 368,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 102140,
      "end_ms": 104765,
      "text": "安安静静住上十天半个月，",
      "token_start": 378,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 105300,
      "end_ms": 108955,
      "text": "每天泡温泉晒太阳吃葡萄。",
      "token_start": 389,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 109380,
      "end_ms": 110000,
      "text": "第九名，",
      "token_start": 400,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 110120,
      "end_ms": 117185,
      "text": "云南建水在云南红河州这地方最绝的是一座活着的千年古城。",
      "token_start": 403,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 117810,
      "end_ms": 122495,
      "text": "建水冬季平均温度在十五到二十摄氏度，",
      "token_start": 429,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 123220,
      "end_ms": 124355,
      "text": "白天晒晒太阳，",
      "token_start": 446,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 124860,
      "end_ms": 127355,
      "text": "随便一站就是蓝天白云。",
      "token_start": 452,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 128150,
      "end_ms": 131455,
      "text": "建水最出名的是他的烟火气。",
      "token_start": 462,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 131910,
      "end_ms": 139075,
      "text": "建水双龙桥建水文庙朱家花园全是几百年的老建筑。",
      "token_start": 474,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 139490,
      "end_ms": 141795,
      "text": "最绝的是建水的美食，",
      "token_start": 496,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 142340,
      "end_ms": 144985,
      "text": "汽锅鸡、烧豆腐、草芽米线，",
      "token_start": 505,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 145420,
      "end_ms": 148255,
      "text": "每一道都带着古城的历史和温度。",
      "token_start": 515,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 148870,
      "end_ms": 152245,
      "text": "您坐在古城的老街上吃一碗草芽米线，",
      "token_start": 529,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 152670,
      "end_ms": 153330,
      "text": "看夕阳，",
      "token_start": 545,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 153330,
      "end_ms": 155795,
      "text": "照在朝阳楼上那种舒服劲儿，",
      "token_start": 548,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 156000,
      "end_ms": 157755,
      "text": "别的地方找不着第八名。",
      "token_start": 560,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 158000,
      "end_ms": 165415,
      "text": "云南芒氏在云南德宏州这地方最绝的是他有一个特别好听的名字，",
      "token_start": 570,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 165860,
      "end_ms": 167565,
      "text": "傣语叫猛幻，",
      "token_start": 598,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 168150,
      "end_ms": 169885,
      "text": "意思是黎明之城。",
      "token_start": 603,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 170710,
      "end_ms": 172750,
      "text": "芒氏位于北纬二十四度，",
      "token_start": 610,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 172750,
      "end_ms": 174414,
      "text": "全球黄金气候带，",
      "token_start": 620,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 174880,
      "end_ms": 177835,
      "text": "年平均气温十九点六摄氏度。",
      "token_start": 627,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 178450,
      "end_ms": 180995,
      "text": "冬季白天多数在二十摄氏度以上，",
      "token_start": 639,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 181760,
      "end_ms": 183400,
      "text": "夜间气温很少，",
      "token_start": 653,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 183400,
      "end_ms": 184585,
      "text": "低于十摄氏度。",
      "token_start": 659,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 185160,
      "end_ms": 187740,
      "text": "芒氏最绝的是他的绿化街道，",
      "token_start": 665,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 187740,
      "end_ms": 192245,
      "text": "两旁种的全是菠萝蜜、芒果、龙眼棕榈树，",
      "token_start": 677,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 193010,
      "end_ms": 195725,
      "text": "走在街上抬头就是果子。",
      "token_start": 693,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 196530,
      "end_ms": 201645,
      "text": "这座小城空气质量优良率常年保持在百分之九十九以上，",
      "token_start": 703,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 202160,
      "end_ms": 204745,
      "text": "森林覆盖率接近百分之七十。",
      "token_start": 727,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 205440,
      "end_ms": 206745,
      "text": "一位武汉游客说，",
      "token_start": 739,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 207100,
      "end_ms": 210855,
      "text": "冬天也能穿短袖第七名。",
      "token_start": 746,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 211270,
      "end_ms": 219630,
      "text": "云南沅江在云南玉溪这地方最绝的是一座被太阳厚爱的干热。",
      "token_start": 756,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 219710,
      "end_ms": 224665,
      "text": "河谷小城援疆年均气温二十四点一摄氏度，",
      "token_start": 782,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 225150,
      "end_ms": 227290,
      "text": "就算是最冷的一月，",
      "token_start": 800,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 227370,
      "end_ms": 231235,
      "text": "平均气温也稳稳保持在十七摄氏度以上，",
      "token_start": 808,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 232000,
      "end_ms": 233065,
      "text": "终年无双，",
      "token_start": 825,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 233470,
      "end_ms": 235425,
      "text": "素有天然温室之称。",
      "token_start": 829,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 236430,
      "end_ms": 238745,
      "text": "援疆现在专门做吕居康养，",
      "token_start": 837,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 239360,
      "end_ms": 243305,
      "text": "全县可承载吕居的空间达一点四七万余间套，",
      "token_start": 848,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 243800,
      "end_ms": 245985,
      "text": "床位超二点二五万个，",
      "token_start": 867,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 246580,
      "end_ms": 251025,
      "text": "还开了圆圆食堂、自家人、食堂等主客共享食堂，",
      "token_start": 876,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 251650,
      "end_ms": 253575,
      "text": "融合各地饮食文化。",
      "token_start": 895,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 254180,
      "end_ms": 263735,
      "text": "吕居公寓负责人苏月龄已从卖房人变成大家长房车营地经营者苍少平则与诸多客人成了老朋友。",
      "token_start": 903,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 263960,
      "end_ms": 264900,
      "text": "外地人去了，",
      "token_start": 944,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 265020,
      "end_ms": 266415,
      "text": "慢慢就成了自家人。",
      "token_start": 949,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 266950,
      "end_ms": 267645,
      "text": "第六名，",
      "token_start": 957,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 268030,
      "end_ms": 277835,
      "text": "四川米易在四川攀枝花这地方最绝的是一个藏在北纬二十六度阳光黄金带上的小县城。",
      "token_start": 960,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 278520,
      "end_ms": 283005,
      "text": "闽疫冬季日均气温保持在十一摄氏度到二十五摄氏度之间，",
      "token_start": 997,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 283510,
      "end_ms": 286935,
      "text": "年日照时数达二千七百小时，",
      "token_start": 1022,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 287790,
      "end_ms": 292245,
      "text": "空气质量优良率常年保持在百分之九十五以上。",
      "token_start": 1034,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 292860,
      "end_ms": 295520,
      "text": "当川西高原被冰雪覆盖的时候，",
      "token_start": 1054,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 295840,
      "end_ms": 298760,
      "text": "米邑还是暖洋洋的这座小城。",
      "token_start": 1067,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 298880,
      "end_ms": 302100,
      "text": "最舒服的过法是找个农家乐住下来，",
      "token_start": 1079,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 302780,
      "end_ms": 304080,
      "text": "白天晒太阳，",
      "token_start": 1094,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 304560,
      "end_ms": 305340,
      "text": "吃鲜果，",
      "token_start": 1099,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 305560,
      "end_ms": 306340,
      "text": "泡温泉，",
      "token_start": 1102,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 306960,
      "end_ms": 309340,
      "text": "晚上在安宁河边散散步。",
      "token_start": 1105,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 310180,
      "end_ms": 315440,
      "text": "米邑的琵琶芒果樱桃便宜到您不敢相信。",
      "token_start": 1115,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 315920,
      "end_ms": 317540,
      "text": "从第十到第六，",
      "token_start": 1132,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 318500,
      "end_ms": 322365,
      "text": "米勒有温泉和慢节奏见水，",
      "token_start": 1138,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 322670,
      "end_ms": 324510,
      "text": "有古城和烧豆腐，",
      "token_start": 1149,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 325390,
      "end_ms": 329130,
      "text": "忙市满街都是果树援江，",
      "token_start": 1156,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 329130,
      "end_ms": 330850,
      "text": "把旅居客当自家人。",
      "token_start": 1166,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 331850,
      "end_ms": 334970,
      "text": "米邑是阳光黄金带上的小县城，",
      "token_start": 1174,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 335510,
      "end_ms": 337850,
      "text": "这五个还只是开胃菜。",
      "token_start": 1187,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 338710,
      "end_ms": 340410,
      "text": "接下来第五道第一，",
      "token_start": 1196,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 340830,
      "end_ms": 341970,
      "text": "一个比一个暖，",
      "token_start": 1204,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 342310,
      "end_ms": 343470,
      "text": "有一座小城，",
      "token_start": 1210,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 343710,
      "end_ms": 344750,
      "text": "跟三亚共享，",
      "token_start": 1215,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 344750,
      "end_ms": 345690,
      "text": "同一片海，",
      "token_start": 1220,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 345690,
      "end_ms": 348030,
      "text": "价格却温柔一半。",
      "token_start": 1224,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 348030,
      "end_ms": 349770,
      "text": "有一座小城，",
      "token_start": 1231,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 349770,
      "end_ms": 351850,
      "text": "冬天能穿开胃，",
      "token_start": 1236,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 351850,
      "end_ms": 353965,
      "text": "却海鲜十块钱一打。",
      "token_start": 1242,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 354600,
      "end_ms": 355765,
      "text": "还有一座小城，",
      "token_start": 1250,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 356160,
      "end_ms": 358785,
      "text": "是中国唯一的热带半岛城市，",
      "token_start": 1256,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 359290,
      "end_ms": 361215,
      "text": "他们是哪下集马上更新，",
