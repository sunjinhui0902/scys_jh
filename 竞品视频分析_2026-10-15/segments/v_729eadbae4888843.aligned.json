{
  "video_id": "v_729eadbae4888843",
  "duration_s": 609.801995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_729eadbae4888843.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_729eadbae4888843.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1890,
      "text": "他喂给亲儿子的那口药，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2830,
      "end_ms": 4510,
      "text": "救了全中国的孩子。",
      "token_start": 10,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5410,
      "end_ms": 5830,
      "text": "各位，",
      "token_start": 18,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 6770,
      "end_ms": 8210,
      "text": "我先撂下一句，",
      "token_start": 20,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 8430,
      "end_ms": 9770,
      "text": "掏心窝子的话，",
      "token_start": 26,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 11390,
      "end_ms": 16525,
      "text": "你品品这天底下最疼孩子的爹，",
      "token_start": 32,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 18460,
      "end_ms": 21040,
      "text": "不是把孩子挡在身后的那个，",
      "token_start": 45,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 21480,
      "end_ms": 25880,
      "text": "而是敢把刀尖儿朝自己娃身上捅的那个。",
      "token_start": 57,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 25880,
      "end_ms": 29260,
      "text": "今儿个要说的这位就是这么一个当爸的，",
      "token_start": 74,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 29260,
      "end_ms": 30080,
      "text": "他干了一桩，",
      "token_start": 91,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 30080,
      "end_ms": 31540,
      "text": "听着就脊背发凉的事，",
      "token_start": 96,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 31540,
      "end_ms": 35900,
      "text": "把自个儿的青骨肉当成了第一只试药的兔子，",
      "token_start": 105,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 35900,
      "end_ms": 37940,
      "text": "它叫顾方舟。",
      "token_start": 124,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 37940,
      "end_ms": 39180,
      "text": "这名你可能生熟，",
      "token_start": 129,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 39260,
      "end_ms": 40680,
      "text": "可他捣鼓出来的东西，",
      "token_start": 136,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 41020,
      "end_ms": 42360,
      "text": "你打小就尝过，",
      "token_start": 145,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 42480,
      "end_ms": 45360,
      "text": "就是那颗黄澄澄甜丝丝的淌丸，",
      "token_start": 151,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 45960,
      "end_ms": 49050,
      "text": "咱把把历历往回翻个大跟头。",
      "token_start": 164,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 49490,
      "end_ms": 51190,
      "text": "那是五十年代的事儿。",
      "token_start": 176,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 51470,
      "end_ms": 54610,
      "text": "一种阳名叫脊髓灰质炎的瘟神，",
      "token_start": 185,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 54990,
      "end_ms": 57170,
      "text": "冷不丁就闯进了咱们的日子，",
      "token_start": 198,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 58030,
      "end_ms": 60030,
      "text": "老百姓嘴里的叫法更直白。",
      "token_start": 210,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 60290,
      "end_ms": 64175,
      "text": "小儿麻痹症这玩意儿专挑小娃娃下手，",
      "token_start": 221,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 64620,
      "end_ms": 66785,
      "text": "六七岁以下的最倒霉，",
      "token_start": 237,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 67660,
      "end_ms": 69640,
      "text": "头一天还活蹦乱跳的宰，",
      "token_start": 246,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 69940,
      "end_ms": 76230,
      "text": "稍一退抽两下金两条腿就跟不是自己的似的软了歪了，",
      "token_start": 256,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 76370,
      "end_ms": 81250,
      "text": "这辈子都别想再稳当当的走路轻的呢，",
      "token_start": 279,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 81470,
      "end_ms": 83145,
      "text": "缺一辈子重的，",
      "token_start": 295,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 83420,
      "end_ms": 85785,
      "text": "连喘气的劲儿都被他抽干，",
      "token_start": 301,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 86410,
      "end_ms": 87625,
      "text": "活活给憋死。",
      "token_start": 312,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 88110,
      "end_ms": 91380,
      "text": "最叫我忘不掉的是江苏南通，",
      "token_start": 317,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 91500,
      "end_ms": 93605,
      "text": "那回没多少功夫，",
      "token_start": 329,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 94030,
      "end_ms": 97475,
      "text": "一千出头的孩子就摊在了皇上，",
      "token_start": 336,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 98610,
      "end_ms": 102495,
      "text": "四百多个小命就这么没了。",
      "token_start": 349,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 102950,
      "end_ms": 107055,
      "text": "那股子邪火眨眼就窜到了青岛、上海、南宁，",
      "token_start": 360,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 107550,
      "end_ms": 109970,
      "text": "家家户户吓得门栓插的死死的，",
      "token_start": 377,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 109970,
      "end_ms": 112195,
      "text": "死活不让马往外头迈一步，",
      "token_start": 390,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 112930,
      "end_ms": 117235,
      "text": "医院大门口全是抱着孩子跪地上嚎啕的爹妈。",
      "token_start": 401,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 117980,
      "end_ms": 121210,
      "text": "可那会儿的新中国兜里比脸还干净，",
      "token_start": 420,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 121210,
      "end_ms": 122915,
      "text": "没要没人会治。",
      "token_start": 435,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 123380,
      "end_ms": 124685,
      "text": "大夫除了叹气，",
      "token_start": 441,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 125060,
      "end_ms": 125815,
      "text": "啥辙也没用，",
      "token_start": 447,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 126700,
      "end_ms": 127585,
      "text": "上头急眼了，",
      "token_start": 452,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 128080,
      "end_ms": 132460,
      "text": "把这千斤重担撂给了一个三十来岁的小伙子，",
      "token_start": 457,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 132460,
      "end_ms": 135590,
      "text": "顾方舟把苏联啃了几年。",
      "token_start": 476,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 135610,
      "end_ms": 138235,
      "text": "病毒学刚回国没多久，",
      "token_start": 486,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 138640,
      "end_ms": 142080,
      "text": "摆在他眼前的是两条道头，",
      "token_start": 495,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 142080,
      "end_ms": 143630,
      "text": "一条是洋人。",
      "token_start": 506,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 143630,
      "end_ms": 146465,
      "text": "美国的死疫苗稳妥是稳妥，",
      "token_start": 511,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 146730,
      "end_ms": 148885,
      "text": "可一针就要十块美金，",
      "token_start": 522,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 149500,
      "end_ms": 151165,
      "text": "这病还分好几个型号，",
      "token_start": 531,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 151480,
      "end_ms": 152880,
      "text": "得一针一针的，",
      "token_start": 540,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 152880,
      "end_ms": 155665,
      "text": "挨一个人少说也得三针。",
      "token_start": 546,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 156300,
      "end_ms": 156900,
      "text": "那年月，",
      "token_start": 556,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 157060,
      "end_ms": 157880,
      "text": "一个普通人，",
      "token_start": 559,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 157880,
      "end_ms": 159880,
      "text": "一个月拢共就挣几十块人民币，",
      "token_start": 564,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 159880,
      "end_ms": 161665,
      "text": "你让老百姓上哪弄这笔钱，",
      "token_start": 577,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 162300,
      "end_ms": 163775,
      "text": "国库也经不起这么躁。",
      "token_start": 588,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 164810,
      "end_ms": 169165,
      "text": "第二条道叫活疫苗便宜，",
      "token_start": 597,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 169840,
      "end_ms": 170880,
      "text": "顶多算死。",
      "token_start": 607,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 170920,
      "end_ms": 174925,
      "text": "疫苗的千分之一还能兑水里喝下去，",
      "token_start": 611,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 175820,
      "end_ms": 177035,
      "text": "瞅着是真香，",
      "token_start": 626,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 177970,
      "end_ms": 180410,
      "text": "可全世界没一个敢往人，",
      "token_start": 631,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 180410,
      "end_ms": 182510,
      "text": "身上招魂的病毒是活的呀，",
      "token_start": 641,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 182550,
      "end_ms": 184315,
      "text": "万一没驯服利索，",
      "token_start": 652,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 184670,
      "end_ms": 184850,
      "text": "哇，",
      "token_start": 659,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 184850,
      "end_ms": 185450,
      "text": "喝下去，",
      "token_start": 660,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 185450,
      "end_ms": 186865,
      "text": "反倒真摊上这病，",
      "token_start": 663,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 187160,
      "end_ms": 188325,
      "text": "那不成害人了吗？",
      "token_start": 670,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 188830,
      "end_ms": 189955,
      "text": "一边是保险，",
      "token_start": 677,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 190230,
      "end_ms": 191915,
      "text": "可绝大多数人够不着，",
      "token_start": 682,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 192320,
      "end_ms": 193405,
      "text": "一边是便宜，",
      "token_start": 691,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 194090,
      "end_ms": 195295,
      "text": "可谁心里也没底。",
      "token_start": 696,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 195940,
      "end_ms": 196520,
      "text": "顾方舟，",
      "token_start": 703,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 196520,
      "end_ms": 198320,
      "text": "把后槽牙一咬走，",
      "token_start": 706,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 198340,
      "end_ms": 199415,
      "text": "活疫苗那条道，",
      "token_start": 713,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 200650,
      "end_ms": 201285,
      "text": "凭啥？",
      "token_start": 719,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 202150,
      "end_ms": 208555,
      "text": "因为他心里装着的是全国千千万万嗷嗷待哺的小婴儿，",
      "token_start": 721,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 209630,
      "end_ms": 212195,
      "text": "不是一个两个有钱人的太平。",
      "token_start": 744,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 212750,
      "end_ms": 214190,
      "text": "他自个儿说的实在死，",
      "token_start": 756,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 214210,
      "end_ms": 216455,
      "text": "疫苗是自个儿图省事的法子，",
      "token_start": 765,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 216770,
      "end_ms": 222035,
      "text": "活疫苗才是给千百万个家正处的一条活路。",
      "token_start": 777,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 223070,
      "end_ms": 224085,
      "text": "一九五九年，",
      "token_start": 795,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 224910,
      "end_ms": 232775,
      "text": "他从苏联好歹把活疫苗的门道连同几份金贵的种子材料带了回来。",
      "token_start": 800,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 233280,
      "end_ms": 234760,
      "text": "可一落地就傻眼，",
      "token_start": 828,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 234780,
      "end_ms": 236215,
      "text": "压根没地儿做实验，",
      "token_start": 835,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 236890,
      "end_ms": 239270,
      "text": "要拿动武事就得有恒。",
      "token_start": 843,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 239370,
      "end_ms": 244085,
      "text": "和侯北京城里一纸能用的都寻不着，",
      "token_start": 852,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 245860,
      "end_ms": 246275,
      "text": "咋整？",
      "token_start": 867,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 248250,
      "end_ms": 251785,
      "text": "搬上云南昆明边上那片大山，",
      "token_start": 869,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 252290,
      "end_ms": 253830,
      "text": "慌得兔子都不拉屎，",
      "token_start": 881,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 253830,
      "end_ms": 254405,
      "text": "不通路，",
      "token_start": 889,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 254870,
      "end_ms": 256305,
      "text": "没水没电。",
      "token_start": 892,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 256980,
      "end_ms": 258120,
      "text": "顾方舟干了一桩，",
      "token_start": 896,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 258120,
      "end_ms": 260120,
      "text": "让大伙扶起到骨头里的事儿。",
      "token_start": 903,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 260120,
      "end_ms": 261880,
      "text": "他把自个儿的亲娘媳妇，",
      "token_start": 915,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 262020,
      "end_ms": 263775,
      "text": "还有刚落地的小儿子，",
      "token_start": 925,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 264050,
      "end_ms": 268010,
      "text": "一大家子全从北京碾上了山屠杀。",
      "token_start": 934,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 268770,
      "end_ms": 270070,
      "text": "他要给中国盖头，",
      "token_start": 948,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 270090,
      "end_ms": 271975,
      "text": "一座几会疫苗的研究所，",
      "token_start": 955,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 272610,
      "end_ms": 274835,
      "text": "还得给手底下的人立个杆瞧瞧，",
      "token_start": 965,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 275260,
      "end_ms": 277935,
      "text": "瞅见没我家当家的都来了，",
      "token_start": 978,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 278240,
      "end_ms": 279415,
      "text": "你们还哆嗦个啥？",
      "token_start": 989,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 280420,
      "end_ms": 282235,
      "text": "科研人员住的是窝棚，",
      "token_start": 996,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 282590,
      "end_ms": 283345,
      "text": "是山洞，",
      "token_start": 1005,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 283910,
      "end_ms": 286605,
      "text": "连间像人住的屋子都抠不出来。",
      "token_start": 1008,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 287260,
      "end_ms": 288555,
      "text": "做实验的料子，",
      "token_start": 1021,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 288820,
      "end_ms": 291240,
      "text": "得先送到山脚下的冷库里，",
      "token_start": 1027,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 291240,
      "end_ms": 294305,
      "text": "镇着要用的时候再吭哧吭哧扛回来，",
      "token_start": 1038,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 294510,
      "end_ms": 296285,
      "text": "就这么个苦哈哈的境地，",
      "token_start": 1053,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 296600,
      "end_ms": 297895,
      "text": "一回又一回的事。",
      "token_start": 1063,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 298350,
      "end_ms": 299665,
      "text": "熬到一九六零年，",
      "token_start": 1070,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 300030,
      "end_ms": 301890,
      "text": "疫苗总算捣鼓出来了，",
      "token_start": 1077,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 302510,
      "end_ms": 303950,
      "text": "猴子身上没毛病。",
      "token_start": 1086,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 303950,
      "end_ms": 305690,
      "text": "可猴没事儿不代表人，",
      "token_start": 1093,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 305690,
      "end_ms": 306445,
      "text": "没事儿啊。",
      "token_start": 1102,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 306970,
      "end_ms": 308690,
      "text": "谁敢头一个往嘴里灌，",
      "token_start": 1106,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 308890,
      "end_ms": 310310,
      "text": "谁又敢往娃嘴里灌？",
      "token_start": 1115,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 310870,
      "end_ms": 315870,
      "text": "接下来这墓是全篇最叫人后脊梁冒凉气的一段，",
      "token_start": 1123,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 315930,
      "end_ms": 319770,
      "text": "顾方舟先抄起一瓶自个儿灌了个底朝天，",
      "token_start": 1143,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 320370,
      "end_ms": 322330,
      "text": "同时一把拦住顾老师，",
      "token_start": 1160,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 322590,
      "end_ms": 323890,
      "text": "您可是带头的，",
      "token_start": 1169,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 324070,
      "end_ms": 325330,
      "text": "您要有个闪失，",
      "token_start": 1175,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 325590,
      "end_ms": 326710,
      "text": "后头可咋整？",
      "token_start": 1181,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 327010,
      "end_ms": 329150,
      "text": "他甩出一句硬邦邦的话，",
      "token_start": 1186,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 329670,
      "end_ms": 330470,
      "text": "我是党员，",
      "token_start": 1196,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 330790,
      "end_ms": 332390,
      "text": "我先来猴子，",
      "token_start": 1200,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 332390,
      "end_ms": 333350,
      "text": "他不会开口，",
      "token_start": 1205,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 333690,
      "end_ms": 337040,
      "text": "可我会只有拿自个儿身子试过，",
      "token_start": 1210,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 337240,
      "end_ms": 341160,
      "text": "我才最明白这玩意儿进到人肚子里是个啥动静。",
      "token_start": 1223,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 341760,
      "end_ms": 345220,
      "text": "紧跟着好几个年轻科研人员也呼啦一下站起来，",
      "token_start": 1243,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 345220,
      "end_ms": 346060,
      "text": "我也是党员，",
      "token_start": 1263,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 346360,
      "end_ms": 348460,
      "text": "算我一个这帮人，",
      "token_start": 1268,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 348840,
      "end_ms": 350660,
      "text": "就是咱中国头一搏，",
      "token_start": 1275,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 350900,
      "end_ms": 352520,
      "text": "拿命是药的硬汉。",
      "token_start": 1283,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 353640,
      "end_ms": 357680,
      "text": "结果咋样一个不少全都安然无恙。",
      "token_start": 1290,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 358640,
      "end_ms": 361860,
      "text": "可顾方舟胸口那块石头愣是没落地，",
      "token_start": 1304,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 362120,
      "end_ms": 365080,
      "text": "因为他冷不丁琢磨出一个要命的坎儿。",
      "token_start": 1319,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 365080,
      "end_ms": 366085,
      "text": "他是大人，",
      "token_start": 1335,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 366560,
      "end_ms": 369765,
      "text": "大人早就被这病毒磨除抵抗力了。",
      "token_start": 1339,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 370500,
      "end_ms": 375595,
      "text": "可这病真正要人命的对象是那些三五岁的奶娃娃，",
      "token_start": 1353,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 376170,
      "end_ms": 377535,
      "text": "大人喝了不碍事，",
      "token_start": 1374,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 378120,
      "end_ms": 380355,
      "text": "不等于孩子喝了也不碍事啊。",
      "token_start": 1381,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 381260,
      "end_ms": 383725,
      "text": "那么问题就明晃晃的处在那了，",
      "token_start": 1393,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 384870,
      "end_ms": 395315,
      "text": "谁他娘的舍得拿自家的娃去烫这道雷下头这一段是我听过最揪心、最拧巴的父爱那阵子。",
      "token_start": 1406,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 395680,
      "end_ms": 398255,
      "text": "顾方舟最小的儿子刚落地没多久，",
      "token_start": 1443,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 398490,
      "end_ms": 401910,
      "text": "他做了一个往后余生都在担惊受怕的决定。",
      "token_start": 1457,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 401910,
      "end_ms": 408265,
      "text": "他瞒着伯姨悄悄的把那馆几回活疫苗喂尽了亲儿子的嘴。",
      "token_start": 1475,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 409230,
      "end_ms": 411415,
      "text": "你把那画面在脑子里过一遍，",
      "token_start": 1499,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 411990,
      "end_ms": 415320,
      "text": "一个专攻病毒的专家亲手霸一馆，",
      "token_start": 1511,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 415420,
      "end_ms": 416985,
      "text": "说不定要命的药水。",
      "token_start": 1525,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 417490,
      "end_ms": 420515,
      "text": "一滴一滴滴进自己青蛙的嘴里，",
      "token_start": 1533,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 421030,
      "end_ms": 423845,
      "text": "赌赢了娃平平安安，",
      "token_start": 1546,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 424140,
      "end_ms": 426555,
      "text": "赌输了他的心头肉，",
      "token_start": 1554,
      "token_end_exclusive": 1562
    },
    {
      "start_ms": 427110,
      "end_ms": 428605,
      "text": "轻则贪一辈子，",
      "token_start": 1562,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 428830,
      "end_ms": 430375,
      "text": "重则把命搭进去。",
      "token_start": 1568,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 431070,
      "end_ms": 432845,
      "text": "他后来念叨起这事儿，",
      "token_start": 1575,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 433080,
      "end_ms": 438180,
      "text": "语气平淡的像在说隔壁老张家的闲篇不这么干不成啊，",
      "token_start": 1584,
      "token_end_exclusive": 1607
    },
    {
      "start_ms": 438300,
      "end_ms": 439665,
      "text": "你自己都不嫌尝，",
      "token_start": 1607,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 440140,
      "end_ms": 442305,
      "text": "你咋好意思让别人去尝，",
      "token_start": 1614,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 443250,
      "end_ms": 444795,
      "text": "你让人家去试，",
      "token_start": 1624,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 445190,
      "end_ms": 446905,
      "text": "你自个儿良心过得去。",
      "token_start": 1630,
      "token_end_exclusive": 1639
    },
    {
      "start_ms": 447370,
      "end_ms": 449795,
      "text": "大伙儿听听这哪是心狠哪，",
      "token_start": 1639,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 450320,
      "end_ms": 455905,
      "text": "分明是把刀刃对准了自己身上最软最疼的那块肉。",
      "token_start": 1650,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 456830,
      "end_ms": 462735,
      "text": "他那口子那边是彻彻底底被蒙在鼓里的那一个月，",
      "token_start": 1671,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 463750,
      "end_ms": 467455,
      "text": "顾方舟天天半宿半宿的爬起来，",
      "token_start": 1692,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 467950,
      "end_ms": 469205,
      "text": "摸娃的脑门儿，",
      "token_start": 1705,
      "token_end_exclusive": 1711
    },
    {
      "start_ms": 469430,
      "end_ms": 470695,
      "text": "丁娃抽不抽筋儿，",
      "token_start": 1711,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 470910,
      "end_ms": 472895,
      "text": "白天还得装的跟没事人一样，",
      "token_start": 1718,
      "token_end_exclusive": 1730
    },
    {
      "start_ms": 473270,
      "end_ms": 474570,
      "text": "足足熬了一个月。",
      "token_start": 1730,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 474870,
      "end_ms": 477530,
      "text": "眼看儿子好好的一丁点差子，",
      "token_start": 1737,
      "token_end_exclusive": 1749
    },
    {
      "start_ms": 477530,
      "end_ms": 477915,
      "text": "没有，",
      "token_start": 1749,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 478240,
      "end_ms": 480165,
      "text": "他才敢跟媳妇儿挑明。",
      "token_start": 1751,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 480810,
      "end_ms": 482995,
      "text": "爱人一听又气又后怕，",
      "token_start": 1760,
      "token_end_exclusive": 1769
    },
    {
      "start_ms": 483340,
      "end_ms": 483800,
      "text": "半天，",
      "token_start": 1769,
      "token_end_exclusive": 1771
    },
    {
      "start_ms": 483880,
      "end_ms": 484920,
      "text": "憋不出一个字，",
      "token_start": 1771,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 484920,
      "end_ms": 486880,
      "text": "哪个当娘的扛得住。",
      "token_start": 1777,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 486880,
      "end_ms": 487835,
      "text": "这种惊吓，",
      "token_start": 1785,
      "token_end_exclusive": 1789
    },
    {
      "start_ms": 488380,
      "end_ms": 490645,
      "text": "可就是这么个狼心狗肺的爹，",
      "token_start": 1789,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 491260,
      "end_ms": 500725,
      "text": "换回了千千万万个孩子的太平打那儿往后对比其他科研人员的侍灵娃也陆陆续续跟着服了疫苗，",
      "token_start": 1801,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 501160,
      "end_ms": 502135,
      "text": "入了观察组，",
      "token_start": 1842,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 502700,
      "end_ms": 509135,
      "text": "这帮科研人员的宰成了咱中国头一波被唐玩护住的孩子。",
      "token_start": 1847,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 509780,
      "end_ms": 510455,
      "text": "后来呢，",
      "token_start": 1871,
      "token_end_exclusive": 1874
    },
    {
      "start_ms": 510640,
      "end_ms": 514455,
      "text": "顾方舟嫌那液体的疫苗又苦又难伺候，",
      "token_start": 1874,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 514840,
      "end_ms": 515600,
      "text": "脑子一转，",
      "token_start": 1890,
      "token_end_exclusive": 1894
    },
    {
      "start_ms": 515640,
      "end_ms": 516965,
      "text": "干脆做成糖丸呗，",
      "token_start": 1894,
      "token_end_exclusive": 1901
    },
    {
      "start_ms": 517430,
      "end_ms": 518215,
      "text": "我爱吃，",
      "token_start": 1901,
      "token_end_exclusive": 1904
    },
    {
      "start_ms": 518540,
      "end_ms": 520375,
      "text": "还耐放好搬运。",
      "token_start": 1904,
      "token_end_exclusive": 1910
    },
    {
      "start_ms": 520990,
      "end_ms": 522755,
      "text": "打从六七十年代起，",
      "token_start": 1910,
      "token_end_exclusive": 1918
    },
    {
      "start_ms": 523150,
      "end_ms": 525025,
      "text": "糖丸就在全国撒开了，",
      "token_start": 1918,
      "token_end_exclusive": 1927
    },
    {
      "start_ms": 525530,
      "end_ms": 529880,
      "text": "再犄角旮旯的山沟沟瓦也能美滋滋的，",
      "token_start": 1927,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 529880,
      "end_ms": 532095,
      "text": "含上一颗结局，",
      "token_start": 1943,
      "token_end_exclusive": 1949
    },
    {
      "start_ms": 532560,
      "end_ms": 533525,
      "text": "咱都晓得了。",
      "token_start": 1949,
      "token_end_exclusive": 1954
    },
    {
      "start_ms": 533860,
      "end_ms": 534780,
      "text": "九十年代后，",
      "token_start": 1954,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 534780,
      "end_ms": 543020,
      "text": "半截中国大地上再没冒出过一粒本土的小儿麻痹症跨进新世纪。",
      "token_start": 1959,
      "token_end_exclusive": 1986
    },
    {
      "start_ms": 543020,
      "end_ms": 543695,
      "text": "没多久，",
      "token_start": 1986,
      "token_end_exclusive": 1989
    },
    {
      "start_ms": 544000,
      "end_ms": 547700,
      "text": "顾方舟代表中国在消灭几回的认证书上，",
      "token_start": 1989,
      "token_end_exclusive": 2006
    },
    {
      "start_ms": 547780,
      "end_ms": 550315,
      "text": "一笔一划签下了自个儿的名，",
      "token_start": 2006,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 550910,
      "end_ms": 553015,
      "text": "他是拿亲儿子的命去赌，",
      "token_start": 2018,
      "token_end_exclusive": 2028
    },
    {
      "start_ms": 553730,
      "end_ms": 556935,
      "text": "赌赢了整整一代中国孩子的安康。",
      "token_start": 2028,
      "token_end_exclusive": 2042
    },
    {
      "start_ms": 557840,
      "end_ms": 558440,
      "text": "顾方舟，",
      "token_start": 2042,
      "token_end_exclusive": 2045
    },
    {
      "start_ms": 558440,
      "end_ms": 561900,
      "text": "于二零一九年一月二日三时三十五分，",
      "token_start": 2045,
      "token_end_exclusive": 2061
    },
    {
      "start_ms": 561920,
      "end_ms": 564170,
      "text": "在北京因病世事，",
      "token_start": 2061,
      "token_end_exclusive": 2068
    },
    {
      "start_ms": 564250,
      "end_ms": 565905,
      "text": "享年九十二岁。",
      "token_start": 2068,
      "token_end_exclusive": 2074
    },
    {
      "start_ms": 566680,
      "end_ms": 567375,
      "text": "说到这儿，",
      "token_start": 2074,
      "token_end_exclusive": 2078
    },
    {
      "start_ms": 567670,
      "end_ms": 570640,
      "text": "我这眼眶是发烫的当爹。",
      "token_start": 2078,
      "token_end_exclusive": 2088
    },
    {
      "start_ms": 570740,
      "end_ms": 571840,
      "text": "当妈的都明白，",
      "token_start": 2088,
      "token_end_exclusive": 2094
    },
    {
      "start_ms": 571840,
      "end_ms": 573545,
      "text": "孩子是身上掉下来的肉，",
      "token_start": 2094,
      "token_end_exclusive": 2104
    },
    {
      "start_ms": 573820,
      "end_ms": 574685,
      "text": "是命里的命。",
      "token_start": 2104,
      "token_end_exclusive": 2109
    },
    {
      "start_ms": 575670,
      "end_ms": 581655,
      "text": "可顾方舟硬生生把这块肉弯下来去填了全天下的娃，",
      "token_start": 2109,
      "token_end_exclusive": 2131
    },
    {
      "start_ms": 582400,
      "end_ms": 585405,
      "text": "这样的人不该被遗忘。",
      "token_start": 2131,
      "token_end_exclusive": 2140
    },
    {
      "start_ms": 585620,
      "end_ms": 587095,
      "text": "所以今儿个这条视频，",
      "token_start": 2140,
      "token_end_exclusive": 2149
    },
    {
      "start_ms": 587660,
      "end_ms": 589495,
      "text": "你要是也被戳着了，",
      "token_start": 2149,
      "token_end_exclusive": 2157
    },
    {
      "start_ms": 589880,
      "end_ms": 590665,
      "text": "就点个赞，",
      "token_start": 2157,
      "token_end_exclusive": 2161
    },
    {
      "start_ms": 591000,
      "end_ms": 591585,
      "text": "收个藏，",
      "token_start": 2161,
      "token_end_exclusive": 2164
    },
    {
      "start_ms": 592050,
      "end_ms": 594145,
      "text": "顺手转给你身边的亲朋，",
      "token_start": 2164,
      "token_end_exclusive": 2174
    },
    {
      "start_ms": 594780,
      "end_ms": 599415,
      "text": "让咱们的娃娃的娃都晓得咱们今儿个能撒鸭子跑，",
      "token_start": 2174,
      "token_end_exclusive": 2195
    },
    {
      "start_ms": 599860,
      "end_ms": 602285,
      "text": "能蹦能跳能疯能闹。",
      "token_start": 2195,
      "token_end_exclusive": 2203
    },
    {
      "start_ms": 602740,
      "end_ms": 606865,
      "text": "是因为老早以前有人把命压在了咱们身上，",
      "token_start": 2203,
      "token_end_exclusive": 2221
    },
    {
      "start_ms": 607350,
      "end_ms": 608815,
      "text": "记着他顾方舟，",
      "token_start": 2221,
      "token_end_exclusive": 2227
    },
    {
      "start_ms": 609090,
      "end_ms": 609760,
      "text": "唐湾爷爷。",
      "token_start": 2227,
      "token_end_exclusive": 2231
    }
  ],
