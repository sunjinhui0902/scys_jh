{
  "video_id": "v_3b605f84d647c9a0",
  "duration_s": 506.083333,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_3b605f84d647c9a0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_3b605f84d647c9a0.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1410,
      "text": "真正的顶级家风，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1690,
      "end_ms": 3270,
      "text": "从不是富贵传承，",
      "token_start": 7,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 4130,
      "end_ms": 5850,
      "text": "谢长达的育人智慧，",
      "token_start": 14,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 6150,
      "end_ms": 8230,
      "text": "值得所有父母借鉴。",
      "token_start": 22,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 8630,
      "end_ms": 11590,
      "text": "他一手缔造了中国顶级豪门，",
      "token_start": 30,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 12270,
      "end_ms": 14830,
      "text": "他的八个子女皆是社会名人，",
      "token_start": 42,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 15250,
      "end_ms": 16190,
      "text": "五个孙辈，",
      "token_start": 54,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 16610,
      "end_ms": 18170,
      "text": "其中四个为院士，",
      "token_start": 58,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 18470,
      "end_ms": 20630,
      "text": "一个重孙名扬国内外，",
      "token_start": 65,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 21170,
      "end_ms": 22730,
      "text": "他的名字叫谢长达。",
      "token_start": 74,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 23490,
      "end_ms": 26430,
      "text": "他以坚韧不拔的意志和非凡的智慧，",
      "token_start": 82,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26770,
      "end_ms": 29755,
      "text": "一手缔造了中国顶级豪门，",
      "token_start": 97,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 30280,
      "end_ms": 33700,
      "text": "培养出的八个子女结成为社会名人，",
      "token_start": 108,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 34100,
      "end_ms": 36820,
      "text": "孙辈中更是人才辈出。",
      "token_start": 123,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 36940,
      "end_ms": 38600,
      "text": "其中五个为院士，",
      "token_start": 132,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 38800,
      "end_ms": 40700,
      "text": "一个重孙名扬国内外。",
      "token_start": 139,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 41420,
      "end_ms": 45180,
      "text": "他的名字注定铭刻在中国近代史上，",
      "token_start": 148,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 45780,
      "end_ms": 48900,
      "text": "成为女性力量与智慧的象征。",
      "token_start": 163,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 49800,
      "end_ms": 51840,
      "text": "身为晚清寡母谢，",
      "token_start": 175,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 51840,
      "end_ms": 53440,
      "text": "长达的人生开局，",
      "token_start": 182,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 53580,
      "end_ms": 54760,
      "text": "堪称绝境，",
      "token_start": 189,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 55560,
      "end_ms": 56620,
      "text": "中年丧夫，",
      "token_start": 193,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 56880,
      "end_ms": 57940,
      "text": "独自养家。",
      "token_start": 197,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 58280,
      "end_ms": 59875,
      "text": "九孩待养家，",
      "token_start": 201,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 60110,
      "end_ms": 60915,
      "text": "净清贫，",
      "token_start": 206,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 61290,
      "end_ms": 62305,
      "text": "乱世求生。",
      "token_start": 209,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 63150,
      "end_ms": 64835,
      "text": "没有优越的物质条件，",
      "token_start": 213,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 65130,
      "end_ms": 66745,
      "text": "没有优质的教育资源，",
      "token_start": 222,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 67190,
      "end_ms": 69095,
      "text": "没有亲友扶持助力，",
      "token_start": 231,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 69530,
      "end_ms": 70830,
      "text": "甚至身处女性，",
      "token_start": 239,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 70890,
      "end_ms": 74290,
      "text": "地位极低、教育资源匮乏的时代。",
      "token_start": 245,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 74390,
      "end_ms": 78035,
      "text": "可他硬生生将一手烂牌打成王炸，",
      "token_start": 258,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 78550,
      "end_ms": 81045,
      "text": "让所有子女突破时代局限，",
      "token_start": 272,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 81500,
      "end_ms": 82360,
      "text": "逆袭成才。",
      "token_start": 283,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 82680,
      "end_ms": 85205,
      "text": "孙辈更是登顶行业巅峰，",
      "token_start": 287,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 85560,
      "end_ms": 86495,
      "text": "为国争光。",
      "token_start": 297,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 87120,
      "end_ms": 93030,
      "text": "很多人误以为世家成才靠的是天赋、运气、资源，",
      "token_start": 301,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 93440,
      "end_ms": 94145,
      "text": "实则不然。",
      "token_start": 320,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 95190,
      "end_ms": 101465,
      "text": "王氏家族的传奇核心源于谢长达坚守的四大育人准则，",
      "token_start": 324,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 102150,
      "end_ms": 103245,
      "text": "简单通透，",
      "token_start": 347,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 103590,
      "end_ms": 104655,
      "text": "却极具力量，",
      "token_start": 351,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 105220,
      "end_ms": 107485,
      "text": "值得每一位家长学习借鉴。",
      "token_start": 356,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 108160,
      "end_ms": 108610,
      "text": "第一，",
      "token_start": 367,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 108910,
      "end_ms": 110005,
      "text": "以身作则，",
      "token_start": 369,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 110380,
      "end_ms": 111325,
      "text": "自立自强，",
      "token_start": 373,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 111730,
      "end_ms": 113890,
      "text": "给孩子最正的精神底色。",
      "token_start": 377,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 114130,
      "end_ms": 119205,
      "text": "谢长达医生育人最核心的四个字就是以身作则。",
      "token_start": 387,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 119910,
      "end_ms": 121650,
      "text": "她从不空谈道理，",
      "token_start": 407,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 121750,
      "end_ms": 122910,
      "text": "不苛求孩子，",
      "token_start": 414,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 123250,
      "end_ms": 126810,
      "text": "所有要求孩子做到的自己首先做到。",
      "token_start": 419,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 127290,
      "end_ms": 128470,
      "text": "丈夫离世后，",
      "token_start": 434,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 128770,
      "end_ms": 130510,
      "text": "她从未自怨自艾，",
      "token_start": 439,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 130850,
      "end_ms": 131950,
      "text": "消极沉沦，",
      "token_start": 446,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 132370,
      "end_ms": 134630,
      "text": "也从未向孩子灌输苦难，",
      "token_start": 450,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 135350,
      "end_ms": 136310,
      "text": "抱怨命运，",
      "token_start": 460,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 136610,
      "end_ms": 138110,
      "text": "反而直面困境，",
      "token_start": 464,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 138410,
      "end_ms": 142410,
      "text": "咬牙支撑他用一张自我跪拜的照片，",
      "token_start": 470,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 142990,
      "end_ms": 145170,
      "text": "教会孩子万事靠自己，",
      "token_start": 485,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 145450,
      "end_ms": 147150,
      "text": "求人不如求己。",
      "token_start": 494,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 147630,
      "end_ms": 148650,
      "text": "生活结局，",
      "token_start": 500,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 148890,
      "end_ms": 150020,
      "text": "他不投不强，",
      "token_start": 504,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 150160,
      "end_ms": 150940,
      "text": "不卑不亢，",
      "token_start": 509,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 151020,
      "end_ms": 153280,
      "text": "凭自己的能力撑起全家。",
      "token_start": 513,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 153820,
      "end_ms": 154720,
      "text": "时代落后。",
      "token_start": 523,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 154920,
      "end_ms": 157300,
      "text": "他终身学习与时俱进，",
      "token_start": 527,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 157740,
      "end_ms": 159500,
      "text": "主动接纳新思想，",
      "token_start": 536,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 159800,
      "end_ms": 162260,
      "text": "拥抱新变革、地位受限。",
      "token_start": 543,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 162540,
      "end_ms": 163700,
      "text": "他不甘平庸，",
      "token_start": 552,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 163980,
      "end_ms": 164880,
      "text": "主动破局，",
      "token_start": 557,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 165380,
      "end_ms": 166440,
      "text": "办学兴教，",
      "token_start": 561,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 166780,
      "end_ms": 168960,
      "text": "推动女权公益助人。",
      "token_start": 565,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 169680,
      "end_ms": 171420,
      "text": "在他的言传身教下，",
      "token_start": 573,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 171780,
      "end_ms": 178240,
      "text": "所有子女都养成了坚韧、自强、独立、自律、永不言弃的性格，",
      "token_start": 581,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 178500,
      "end_ms": 179495,
      "text": "不依附他人，",
      "token_start": 604,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 180100,
      "end_ms": 181360,
      "text": "不畏惧困境，",
      "token_start": 609,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 181680,
      "end_ms": 183100,
      "text": "遇事迎难而上，",
      "token_start": 614,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 183360,
      "end_ms": 184240,
      "text": "主动破局，",
      "token_start": 620,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 184720,
      "end_ms": 187220,
      "text": "这是孩子一生最珍贵的财富。",
      "token_start": 624,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 188280,
      "end_ms": 188720,
      "text": "第二，",
      "token_start": 636,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 188760,
      "end_ms": 189740,
      "text": "重视教育，",
      "token_start": 638,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 189920,
      "end_ms": 191000,
      "text": "终身读书，",
      "token_start": 642,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 191320,
      "end_ms": 193340,
      "text": "守住家庭最好的家风。",
      "token_start": 646,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 194100,
      "end_ms": 195120,
      "text": "谢长达一生。",
      "token_start": 655,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 195420,
      "end_ms": 198840,
      "text": "最坚定的信仰就是读书育人，",
      "token_start": 660,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 199580,
      "end_ms": 202420,
      "text": "哪怕家徒四壁、度日施难，",
      "token_start": 672,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 202760,
      "end_ms": 204940,
      "text": "他也绝不牺牲孩子的学业，",
      "token_start": 682,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 205400,
      "end_ms": 207280,
      "text": "始终坚持全员读书，",
      "token_start": 693,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 207520,
      "end_ms": 208380,
      "text": "因材施教。",
      "token_start": 701,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 208380,
      "end_ms": 210610,
      "text": "他打破生时代偏见，",
      "token_start": 705,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 210850,
      "end_ms": 211670,
      "text": "不重男女，",
      "token_start": 713,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 211850,
      "end_ms": 212690,
      "text": "不分长幼。",
      "token_start": 717,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 213370,
      "end_ms": 216110,
      "text": "所有孩子一律平等接受教育，",
      "token_start": 721,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 216490,
      "end_ms": 217830,
      "text": "打破应试局限，",
      "token_start": 733,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 218070,
      "end_ms": 218850,
      "text": "不为分数，",
      "token_start": 739,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 219430,
      "end_ms": 220530,
      "text": "不为功名，",
      "token_start": 743,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 220890,
      "end_ms": 222390,
      "text": "鼓励孩子深耕，",
      "token_start": 747,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 222510,
      "end_ms": 224010,
      "text": "热爱发挥特长。",
      "token_start": 753,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 224350,
      "end_ms": 225910,
      "text": "他深知读书，",
      "token_start": 759,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 226130,
      "end_ms": 227770,
      "text": "不是为了追名逐利，",
      "token_start": 764,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 227790,
      "end_ms": 228850,
      "text": "而是为了修身，",
      "token_start": 772,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 228890,
      "end_ms": 229330,
      "text": "立命，",
      "token_start": 778,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 229750,
      "end_ms": 230710,
      "text": "发宽学局。",
      "token_start": 780,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 231190,
      "end_ms": 231610,
      "text": "因此，",
      "token_start": 784,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 231610,
      "end_ms": 234110,
      "text": "他鼓励子女兼修中西学识，",
      "token_start": 786,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 235030,
      "end_ms": 237650,
      "text": "既要懂传统、明德行，",
      "token_start": 797,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 238070,
      "end_ms": 240380,
      "text": "也要懂科学拓视野，",
      "token_start": 805,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 241140,
      "end_ms": 244020,
      "text": "不强迫孩子走统一的人生道路，",
      "token_start": 813,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 244440,
      "end_ms": 246840,
      "text": "尊重每个孩子的天赋与热爱，",
      "token_start": 826,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 247260,
      "end_ms": 249460,
      "text": "擅长理科的深耕科研，",
      "token_start": 838,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 250080,
      "end_ms": 251920,
      "text": "热爱教育的教书育人，",
      "token_start": 847,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 252280,
      "end_ms": 254660,
      "text": "有志实业的实干兴邦。",
      "token_start": 856,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 255540,
      "end_ms": 259100,
      "text": "这种因材施教、尊重天性的教育方式，",
      "token_start": 865,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 259540,
      "end_ms": 262920,
      "text": "让每个孩子都能最大化发挥自身优势，",
      "token_start": 880,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 263160,
      "end_ms": 264840,
      "text": "成就独一无二的人生。",
      "token_start": 896,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 266540,
      "end_ms": 267000,
      "text": "第三，",
      "token_start": 905,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 267100,
      "end_ms": 268140,
      "text": "格局开阔，",
      "token_start": 907,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 268640,
      "end_ms": 269695,
      "text": "心怀家国，",
      "token_start": 911,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 270730,
      "end_ms": 272570,
      "text": "拔高孩子的人生高度。",
      "token_start": 915,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 273270,
      "end_ms": 274610,
      "text": "普通家长育人，",
      "token_start": 924,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 275030,
      "end_ms": 277370,
      "text": "只求孩子安稳度日，",
      "token_start": 930,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 277650,
      "end_ms": 278610,
      "text": "衣食无忧，",
      "token_start": 938,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 278950,
      "end_ms": 279990,
      "text": "平淡一生。",
      "token_start": 942,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 281110,
      "end_ms": 283230,
      "text": "但谢长达的育人格局，",
      "token_start": 946,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 283710,
      "end_ms": 285630,
      "text": "从来不止于小家安稳，",
      "token_start": 955,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 285890,
      "end_ms": 287290,
      "text": "更在于大国担当。",
      "token_start": 964,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 287830,
      "end_ms": 289690,
      "text": "她一生推动放逐运动，",
      "token_start": 971,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 289930,
      "end_ms": 291190,
      "text": "创办女子学校，",
      "token_start": 980,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 291450,
      "end_ms": 292730,
      "text": "成立公益团体。",
      "token_start": 986,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 293170,
      "end_ms": 294110,
      "text": "不求名利，",
      "token_start": 992,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 294270,
      "end_ms": 298545,
      "text": "不计得失成为唤益女性振兴教育。",
      "token_start": 996,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 299000,
      "end_ms": 306100,
      "text": "助力家国母亲的家国情怀、大爱格局深深浸润着每一位子女。",
      "token_start": 1010,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 306180,
      "end_ms": 306640,
      "text": "因此，",
      "token_start": 1035,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 307000,
      "end_ms": 310040,
      "text": "王室后人成才后无一追逐，",
      "token_start": 1037,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 310300,
      "end_ms": 311300,
      "text": "富贵享乐，",
      "token_start": 1048,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 311620,
      "end_ms": 312740,
      "text": "全部扎根。",
      "token_start": 1052,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 312760,
      "end_ms": 317160,
      "text": "科研哪育实业一线默默深耕，",
      "token_start": 1056,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 317340,
      "end_ms": 320460,
      "text": "为国奉献子女奠基。",
      "token_start": 1068,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 320720,
      "end_ms": 322980,
      "text": "近代学科发展孙辈，",
      "token_start": 1076,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 323140,
      "end_ms": 324460,
      "text": "攻克核心技术，",
      "token_start": 1084,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 324680,
      "end_ms": 325840,
      "text": "助力国家崛起，",
      "token_start": 1090,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 326260,
      "end_ms": 327500,
      "text": "哪怕放弃海外，",
      "token_start": 1096,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 327500,
      "end_ms": 329930,
      "text": "高薪优渥条件也要归国，",
      "token_start": 1102,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 330230,
      "end_ms": 333590,
      "text": "建设祖国格局决定结局。",
      "token_start": 1112,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 334070,
      "end_ms": 336470,
      "text": "正是这份心怀家国的家风，",
      "token_start": 1122,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 336930,
      "end_ms": 340050,
      "text": "让家族后辈跳出个人得失，",
      "token_start": 1133,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 340430,
      "end_ms": 344830,
      "text": "拥有了更高的人生追求与精神境界。",
      "token_start": 1144,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 345910,
      "end_ms": 346390,
      "text": "第四，",
      "token_start": 1159,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 346650,
      "end_ms": 347650,
      "text": "无私奉献，",
      "token_start": 1161,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 347830,
      "end_ms": 348730,
      "text": "疏财助学，",
      "token_start": 1165,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 349230,
      "end_ms": 351490,
      "text": "传承利他向善的家风。",
      "token_start": 1169,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 352250,
      "end_ms": 355010,
      "text": "谢长达一生清贫、乐善好施，",
      "token_start": 1178,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 355570,
      "end_ms": 357410,
      "text": "始终坚守利他初心，",
      "token_start": 1189,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 357950,
      "end_ms": 359310,
      "text": "深耕工工艺，",
      "token_start": 1197,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 359450,
      "end_ms": 360305,
      "text": "帮扶弱者。",
      "token_start": 1202,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 361160,
      "end_ms": 362145,
      "text": "一九一五年，",
      "token_start": 1206,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 362470,
      "end_ms": 364665,
      "text": "他牵头成立苏州女子工艺团，",
      "token_start": 1211,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 365120,
      "end_ms": 367715,
      "text": "专门帮扶底层弱势女性，",
      "token_start": 1223,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 368070,
      "end_ms": 369465,
      "text": "开设就业培训，",
      "token_start": 1233,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 369950,
      "end_ms": 371345,
      "text": "提供法律援助，",
      "token_start": 1239,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 371710,
      "end_ms": 374430,
      "text": "开展公益义诊庇护。",
      "token_start": 1245,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 374470,
      "end_ms": 376795,
      "text": "受欺凌受压迫的女性，",
      "token_start": 1253,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 377240,
      "end_ms": 380215,
      "text": "被苏州百姓亲切称作王老虎，",
      "token_start": 1262,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 380740,
      "end_ms": 382415,
      "text": "专替弱者撑腰，",
      "token_start": 1274,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 382830,
      "end_ms": 383925,
      "text": "为女性发声。",
      "token_start": 1280,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 384560,
      "end_ms": 388945,
      "text": "他一生积蓄大多用于办学助学、公益帮扶，",
      "token_start": 1285,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 389390,
      "end_ms": 391825,
      "text": "七十岁受遗悉数捐校，",
      "token_start": 1302,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 392150,
      "end_ms": 395975,
      "text": "临终遗嘱捐赠全部奠移设立奖学金，",
      "token_start": 1311,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 396560,
      "end_ms": 398895,
      "text": "一生与人终身奉献。",
      "token_start": 1326,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 399400,
      "end_ms": 402555,
      "text": "这份无私向善、利他担当的品格，",
      "token_start": 1334,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 403130,
      "end_ms": 404690,
      "text": "代代传承让，",
      "token_start": 1347,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 404690,
      "end_ms": 407665,
      "text": "家族后辈始终心怀善意，",
      "token_start": 1352,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 408140,
      "end_ms": 410155,
      "text": "懂得感恩、勇于奉献。",
      "token_start": 1362,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 410660,
      "end_ms": 411545,
      "text": "成才之后，",
      "token_start": 1370,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 411790,
      "end_ms": 414295,
      "text": "不忘反哺社会、报效国家，",
      "token_start": 1374,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 414780,
      "end_ms": 418345,
      "text": "成就了家族百年不衰的口碑与底蕴。",
      "token_start": 1384,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 419160,
      "end_ms": 420980,
      "text": "回看谢长达的一生，",
      "token_start": 1399,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 421440,
      "end_ms": 423080,
      "text": "他不是高官权贵，",
      "token_start": 1407,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 423500,
      "end_ms": 424940,
      "text": "不是富商巨骨，",
      "token_start": 1414,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 425360,
      "end_ms": 427160,
      "text": "只是一位裹着小脚，",
      "token_start": 1420,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 427300,
      "end_ms": 429060,
      "text": "历经风雨的普通母亲。",
      "token_start": 1428,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 429540,
      "end_ms": 430980,
      "text": "但他用一生证明，",
      "token_start": 1437,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 431400,
      "end_ms": 434620,
      "text": "真正的豪门从不是财富的堆积，",
      "token_start": 1444,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 434920,
      "end_ms": 436420,
      "text": "而是家风的堆承。",
      "token_start": 1457,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 436900,
      "end_ms": 437920,
      "text": "真正的育儿，",
      "token_start": 1464,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 438260,
      "end_ms": 439960,
      "text": "从不是物质的堆积，",
      "token_start": 1469,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 440520,
      "end_ms": 442280,
      "text": "而是精神的滋养。",
      "token_start": 1477,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 443180,
      "end_ms": 445160,
      "text": "世间所有的岁月静好，",
      "token_start": 1484,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 445620,
      "end_ms": 446600,
      "text": "家族荣光，",
      "token_start": 1493,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 446880,
      "end_ms": 449390,
      "text": "结缘于前辈的负重前行，",
      "token_start": 1497,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 449770,
      "end_ms": 451290,
      "text": "深耕坚守谢，",
      "token_start": 1507,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 451290,
      "end_ms": 453630,
      "text": "长达以一介女子之躯，",
      "token_start": 1512,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 453910,
      "end_ms": 455610,
      "text": "活成了时代标杆。",
      "token_start": 1521,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 456130,
      "end_ms": 457210,
      "text": "母亲典范。",
      "token_start": 1528,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 457990,
      "end_ms": 459850,
      "text": "她的坚韧通透，",
      "token_start": 1532,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 460230,
      "end_ms": 460810,
      "text": "善良，",
      "token_start": 1538,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 461130,
      "end_ms": 461650,
      "text": "担当，",
      "token_start": 1540,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 462530,
      "end_ms": 463570,
      "text": "跨越百年，",
      "token_start": 1542,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 463890,
      "end_ms": 466730,
      "text": "依旧治愈世人启迪后人。",
      "token_start": 1546,
      "token_end_exclusive": 1556
    },
    {
      "start_ms": 466890,
      "end_ms": 468290,
      "text": "最好的家庭教育，",
      "token_start": 1556,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 468530,
      "end_ms": 471290,
      "text": "从来不是给孩子最好的一切，",
      "token_start": 1563,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 471830,
      "end_ms": 474570,
      "text": "而是自己活成最好的榜样。",
      "token_start": 1575,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 475130,
      "end_ms": 476610,
      "text": "传承一身风骨，",
      "token_start": 1586,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 476850,
      "end_ms": 477810,
      "text": "一世善良，",
      "token_start": 1592,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 478210,
      "end_ms": 479315,
      "text": "一生自强。",
      "token_start": 1596,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 480390,
      "end_ms": 487115,
      "text": "这便是谢长达留给后世最珍贵最值得传承的人生智慧。",
      "token_start": 1600,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 487630,
      "end_ms": 488915,
      "text": "乱世无人撑腰，",
      "token_start": 1623,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 489240,
      "end_ms": 490160,
      "text": "他自己做官，",
      "token_start": 1629,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 490380,
      "end_ms": 491615,
      "text": "一生无依无靠，",
      "token_start": 1634,
      "token_end_exclusive": 1640
    },
    {
      "start_ms": 491980,
      "end_ms": 493805,
      "text": "他活成整座家族的靠山，",
      "token_start": 1640,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 494360,
      "end_ms": 498085,
      "text": "这样的中国女性值得被更多人看见。",
      "token_start": 1650,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 498510,
      "end_ms": 499050,
      "text": "点赞，",
      "token_start": 1665,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 499090,
      "end_ms": 499995,
      "text": "致敬先辈，",
      "token_start": 1667,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 500300,
      "end_ms": 500720,
      "text": "转发，",
      "token_start": 1671,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 500820,
      "end_ms": 501755,
      "text": "传递力量。",
      "token_start": 1673,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 502190,
      "end_ms": 504910,
      "text": "喜欢这种温柔又有力量的故事，",
      "token_start": 1677,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 504970,
