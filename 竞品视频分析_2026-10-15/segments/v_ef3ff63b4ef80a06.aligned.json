{
  "video_id": "v_ef3ff63b4ef80a06",
  "duration_s": 505.041667,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_ef3ff63b4ef80a06.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_ef3ff63b4ef80a06.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 2310,
      "text": "二零一六年九月二十五日，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2790,
      "end_ms": 8109,
      "text": "贵州的平塘大窝荡中国天眼正式落成启用，",
      "token_start": 11,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 8610,
      "end_ms": 10450,
      "text": "现场一片欢腾。",
      "token_start": 29,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 10990,
      "end_ms": 12730,
      "text": "所有人都在鼓掌，",
      "token_start": 35,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 13090,
      "end_ms": 14530,
      "text": "拥抱合影，",
      "token_start": 42,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 15250,
      "end_ms": 18830,
      "text": "只有一个人安安静静的坐在角落里。",
      "token_start": 46,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 19650,
      "end_ms": 21950,
      "text": "他刚做完肺癌手术没多久，",
      "token_start": 61,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 22250,
      "end_ms": 23210,
      "text": "为了这一天，",
      "token_start": 72,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 23430,
      "end_ms": 24810,
      "text": "他等了二十二年，",
      "token_start": 77,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 25290,
      "end_ms": 26730,
      "text": "他比谁都清楚。",
      "token_start": 84,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 27090,
      "end_ms": 32560,
      "text": "这是他第一次也是最后一次亲眼看着天眼工作，",
      "token_start": 90,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 33000,
      "end_ms": 35260,
      "text": "这个人就是南人。",
      "token_start": 110,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 35260,
      "end_ms": 37700,
      "text": "东时间倒回到二零一五年，",
      "token_start": 117,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 38660,
      "end_ms": 42560,
      "text": "天眼工程进入最关键的攻坚阶段。",
      "token_start": 128,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 43380,
      "end_ms": 46680,
      "text": "南仁东的身体却开始不对劲了，",
      "token_start": 142,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 47780,
      "end_ms": 52920,
      "text": "直嗽发低烧人一天比一天瘦。",
      "token_start": 155,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 53460,
      "end_ms": 54820,
      "text": "同事劝他去医院，",
      "token_start": 167,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 54940,
      "end_ms": 57940,
      "text": "他摆摆手说工地上走不烧。",
      "token_start": 174,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 58680,
      "end_ms": 61030,
      "text": "咳到有一天他实在撑不住了。",
      "token_start": 185,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 61110,
      "end_ms": 61875,
      "text": "去检查，",
      "token_start": 197,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 62930,
      "end_ms": 63915,
      "text": "结果出来后，",
      "token_start": 200,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 64360,
      "end_ms": 65755,
      "text": "所有人都傻了眼，",
      "token_start": 205,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 66070,
      "end_ms": 67425,
      "text": "确定是肺癌晚期。",
      "token_start": 212,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 67930,
      "end_ms": 69290,
      "text": "医生说的很直白，",
      "token_start": 219,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 69450,
      "end_ms": 70165,
      "text": "太晚了，",
      "token_start": 226,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 71250,
      "end_ms": 73710,
      "text": "你猜南仁东的第一反应是什么？",
      "token_start": 229,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 73770,
      "end_ms": 74590,
      "text": "不是崩溃，",
      "token_start": 242,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 74630,
      "end_ms": 75485,
      "text": "不是害怕。",
      "token_start": 246,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 76320,
      "end_ms": 77235,
      "text": "他问医生，",
      "token_start": 250,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 77740,
      "end_ms": 83300,
      "text": "能不能让我把天眼见成再走这个病？",
      "token_start": 254,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 83480,
      "end_ms": 84660,
      "text": "他瞒着妻子，",
      "token_start": 269,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 84840,
      "end_ms": 85685,
      "text": "瞒着儿女，",
      "token_start": 274,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 85990,
      "end_ms": 89315,
      "text": "一个人扛了下来手术。",
      "token_start": 278,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 90690,
      "end_ms": 94005,
      "text": "他做了化疗，",
      "token_start": 287,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 94480,
      "end_ms": 96020,
      "text": "他也做了头发，",
      "token_start": 292,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 96080,
      "end_ms": 97820,
      "text": "一把一把的掉喉咙，",
      "token_start": 298,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 97820,
      "end_ms": 99525,
      "text": "嘶哑的几乎说不出话。",
      "token_start": 306,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 99960,
      "end_ms": 101335,
      "text": "可术后第三个月，",
      "token_start": 315,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 101670,
      "end_ms": 103275,
      "text": "他就出现在了工地上。",
      "token_start": 322,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 103710,
      "end_ms": 104855,
      "text": "同事们吓坏了。",
      "token_start": 331,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 106770,
      "end_ms": 107265,
      "text": "南老，",
      "token_start": 337,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 107750,
      "end_ms": 108715,
      "text": "您怎么来了？",
      "token_start": 339,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 109630,
      "end_ms": 111075,
      "text": "您得好好休息呀，",
      "token_start": 344,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 112050,
      "end_ms": 114555,
      "text": "他摆摆手不说话，",
      "token_start": 351,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 115750,
      "end_ms": 118900,
      "text": "不是不想说是怕一张嘴，",
      "token_start": 358,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 119020,
      "end_ms": 122715,
      "text": "那嘶哑的声音能让人听出他病的有多重？",
      "token_start": 368,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 123630,
      "end_ms": 127795,
      "text": "工地上有一个让所有人心疼的画面，",
      "token_start": 385,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 128150,
      "end_ms": 130115,
      "text": "南仁东太虚弱了，",
      "token_start": 400,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 130930,
      "end_ms": 131885,
      "text": "站都站不住，",
      "token_start": 407,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 132210,
      "end_ms": 135825,
      "text": "就坐在椅子上盯着施公说不出话，",
      "token_start": 412,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 136420,
      "end_ms": 138335,
      "text": "他就趴在桌上画图纸，",
      "token_start": 426,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 138640,
      "end_ms": 140965,
      "text": "一笔一笔画到手指发抖，",
      "token_start": 435,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 141800,
      "end_ms": 143800,
      "text": "给他看病的医生都理解不了，",
      "token_start": 445,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 144040,
      "end_ms": 145395,
      "text": "这到底是个什么人，",
      "token_start": 457,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 146160,
      "end_ms": 147780,
      "text": "都病成这个样子了，",
      "token_start": 465,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 147820,
      "end_ms": 148960,
      "text": "怎么还在工作，",
      "token_start": 473,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 149260,
      "end_ms": 151455,
      "text": "自己的病是一点都不顾了。",
      "token_start": 479,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 152460,
      "end_ms": 153840,
      "text": "同事们更想不通，",
      "token_start": 490,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 153980,
      "end_ms": 158180,
      "text": "几个月前还在工地上忙前忙后的男老怎么说，",
      "token_start": 497,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 158260,
      "end_ms": 161175,
      "text": "突然肺癌晚期就是肺癌晚期了。",
      "token_start": 516,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 162020,
      "end_ms": 163505,
      "text": "其实答案很简单，",
      "token_start": 529,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 163910,
      "end_ms": 165665,
      "text": "他一直都在硬撑。",
      "token_start": 536,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 166600,
      "end_ms": 169435,
      "text": "从二零一一年开工那天起，",
      "token_start": 543,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 169980,
      "end_ms": 171825,
      "text": "他就没给自己留过退路。",
      "token_start": 554,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 172680,
      "end_ms": 176685,
      "text": "那两年在他身边的人还发现了一件事，",
      "token_start": 564,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 177090,
      "end_ms": 178255,
      "text": "南老好像变了，",
      "token_start": 580,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 179380,
      "end_ms": 182700,
      "text": "变得冷漠了。",
      "token_start": 586,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 183640,
      "end_ms": 187880,
      "text": "亲戚来北京看他他不接待，",
      "token_start": 591,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 188240,
      "end_ms": 190500,
      "text": "从小要好的朋友知道他病了，",
      "token_start": 602,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 191180,
      "end_ms": 192180,
      "text": "打电话过来，",
      "token_start": 614,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 192280,
      "end_ms": 195940,
      "text": "他几乎不接工作中往来的邮件，",
      "token_start": 619,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 196020,
      "end_ms": 199060,
      "text": "他永远在最后加一句不必回复，",
      "token_start": 632,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 200020,
      "end_ms": 201500,
      "text": "只人心里犯嘀咕，",
      "token_start": 645,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 202320,
      "end_ms": 203720,
      "text": "南老这是怎么了？",
      "token_start": 652,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 204480,
      "end_ms": 205580,
      "text": "病糊涂了，",
      "token_start": 659,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 205740,
      "end_ms": 207260,
      "text": "还是心变硬了。",
      "token_start": 663,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 208320,
      "end_ms": 210660,
      "text": "只有离他最近的同事都明白，",
      "token_start": 669,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 211060,
      "end_ms": 212040,
      "text": "他不是冷漠，",
      "token_start": 681,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 212240,
      "end_ms": 213420,
      "text": "他是没时间了。",
      "token_start": 686,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 214160,
      "end_ms": 217470,
      "text": "他知道前面还有大量的工作，",
      "token_start": 692,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 217510,
      "end_ms": 222190,
      "text": "等着他他知道自己随时可能倒下。",
      "token_start": 704,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 223070,
      "end_ms": 229190,
      "text": "他要把剩下的每一分每一秒都留给建造天眼。",
      "token_start": 718,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 229590,
      "end_ms": 231870,
      "text": "二零一六年九月二十五日，",
      "token_start": 737,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 232290,
      "end_ms": 234150,
      "text": "天眼终于落成。",
      "token_start": 748,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 235350,
      "end_ms": 237310,
      "text": "那天晚上星光特别好，",
      "token_start": 754,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 237510,
      "end_ms": 239675,
      "text": "所有人都围在一起庆祝，",
      "token_start": 763,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 240180,
      "end_ms": 245865,
      "text": "只有南仁东一个人慢慢走到观测系统前坐下来看了很久很久。",
      "token_start": 773,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 246140,
      "end_ms": 246310,
      "text": "嗯，",
      "token_start": 799,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 246370,
      "end_ms": 247030,
      "text": "没人知道，",
      "token_start": 800,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 247030,
      "end_ms": 248665,
      "text": "那一刻他在想些什么，",
      "token_start": 804,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 249110,
      "end_ms": 251450,
      "text": "他只是安安静静的看着那口。",
      "token_start": 813,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 251510,
      "end_ms": 258455,
      "text": "世界上最大的郭看着他第一次睁开眼望向星空。",
      "token_start": 825,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 259320,
      "end_ms": 261145,
      "text": "有人说那天夜里，",
      "token_start": 845,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 261450,
      "end_ms": 263855,
      "text": "他看到了深夜升起的太阳。",
      "token_start": 852,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 264570,
      "end_ms": 266845,
      "text": "这是南仁东第一次使用天眼，",
      "token_start": 863,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 267690,
      "end_ms": 269025,
      "text": "也是最后一次。",
      "token_start": 875,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 270230,
      "end_ms": 272150,
      "text": "二零一七年九月十五日，",
      "token_start": 881,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 272230,
      "end_ms": 273330,
      "text": "南仁东走了，",
      "token_start": 891,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 273650,
      "end_ms": 275075,
      "text": "享年七十二岁，",
      "token_start": 896,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 275530,
      "end_ms": 279635,
      "text": "离建造天眼落成还不到一年的时间，",
      "token_start": 902,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 280000,
      "end_ms": 281295,
      "text": "他走的很安静，",
      "token_start": 917,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 281710,
      "end_ms": 283255,
      "text": "没有盛大的追悼会，",
      "token_start": 923,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 283590,
      "end_ms": 285125,
      "text": "没有气派的墓碑，",
      "token_start": 931,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 285610,
      "end_ms": 291675,
      "text": "连骨灰都遵照他的遗愿洒在了大窝荡的群山之间。",
      "token_start": 938,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 292600,
      "end_ms": 294965,
      "text": "他生前说过这么一句话，",
      "token_start": 959,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 295890,
      "end_ms": 299595,
      "text": "人这一辈子总要做一些事情，",
      "token_start": 969,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 300550,
      "end_ms": 301830,
      "text": "哪怕只做一件，",
      "token_start": 981,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 302250,
      "end_ms": 303670,
      "text": "也要做到极致。",
      "token_start": 987,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 304490,
      "end_ms": 305955,
      "text": "他做到了。",
      "token_start": 993,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 306630,
      "end_ms": 310130,
      "text": "可这句话是用命做出来的。",
      "token_start": 997,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 311190,
      "end_ms": 312410,
      "text": "还有一个细节，",
      "token_start": 1008,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 312490,
      "end_ms": 313430,
      "text": "很多人不知道，",
      "token_start": 1014,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 313870,
      "end_ms": 315750,
      "text": "这样一个为国铸剑的人，",
      "token_start": 1020,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 316050,
      "end_ms": 318570,
      "text": "一辈子没当过院士，",
      "token_start": 1030,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 319090,
      "end_ms": 320850,
      "text": "他生前不爱宣传自己，",
      "token_start": 1038,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 321150,
      "end_ms": 322990,
      "text": "很多荣誉都让了出去。",
      "token_start": 1047,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 323310,
      "end_ms": 325030,
      "text": "可他悄悄做的一件事，",
      "token_start": 1056,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 325570,
      "end_ms": 326650,
      "text": "很多人不知道，",
      "token_start": 1065,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 327470,
      "end_ms": 333650,
      "text": "他常年把自己的工资一笔又一笔捐给大山里的贫困学生。",
      "token_start": 1071,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 334570,
      "end_ms": 337740,
      "text": "他自己呢只有一件旧夹克，",
      "token_start": 1095,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 338580,
      "end_ms": 341100,
      "text": "穿了好多年出差，",
      "token_start": 1106,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 341140,
      "end_ms": 342900,
      "text": "坐的是绿皮火车，",
      "token_start": 1113,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 343440,
      "end_ms": 345880,
      "text": "却舍不得为自己多花一分钱。",
      "token_start": 1120,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 346660,
      "end_ms": 350400,
      "text": "这就是南人东对自己抠搜了一辈子，",
      "token_start": 1132,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 350400,
      "end_ms": 353300,
      "text": "把所有的光都奉献给了别人。",
      "token_start": 1147,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 353840,
      "end_ms": 354800,
      "text": "二零一八年，",
      "token_start": 1159,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 355100,
      "end_ms": 361260,
      "text": "国际天文学联合会将一颗小行星正式命名为南仁东星。",
      "token_start": 1164,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 362000,
      "end_ms": 363960,
      "text": "那颗星离我们很远，",
      "token_start": 1187,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 363980,
      "end_ms": 366875,
      "text": "很远远到要用光年去算。",
      "token_start": 1195,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 367250,
      "end_ms": 371075,
      "text": "可天眼那个他拼了命建出来的中国天眼，",
      "token_start": 1205,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 371600,
      "end_ms": 375385,
      "text": "就静静的守在中国西南的大山里。",
      "token_start": 1222,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 376180,
      "end_ms": 379915,
      "text": "他每捕捉到一次来自宇宙深处的信号，",
      "token_start": 1236,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 380400,
      "end_ms": 381600,
      "text": "都像是男老，",
      "token_start": 1252,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 381980,
      "end_ms": 384285,
      "text": "还在替我们仰望星空。",
      "token_start": 1257,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 384870,
      "end_ms": 387090,
      "text": "南仁东先生已经不在了，",
      "token_start": 1266,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 387090,
      "end_ms": 390155,
      "text": "但中国天眼永远矗立在那里，",
      "token_start": 1276,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 390770,
      "end_ms": 394555,
      "text": "天上那颗名为南人东星永远都亮着。",
      "token_start": 1288,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 395740,
      "end_ms": 397375,
      "text": "这个系列讲完了，",
      "token_start": 1303,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 397800,
      "end_ms": 399285,
      "text": "可我还想问你一个问题，",
      "token_start": 1310,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 399790,
      "end_ms": 401065,
      "text": "南仁东这样的人，",
      "token_start": 1320,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 401630,
      "end_ms": 403975,
      "text": "咱们的孩子认识几个？",
      "token_start": 1327,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 404800,
      "end_ms": 409085,
      "text": "我见过太多孩子能爆出明星的生日，",
      "token_start": 1336,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 409480,
      "end_ms": 411925,
      "text": "却叫不出一个科学家的名字。",
      "token_start": 1351,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 412480,
      "end_ms": 414925,
      "text": "这个连墓碑都没留下的老人，",
      "token_start": 1363,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 415540,
      "end_ms": 417865,
      "text": "不该只活在一天的新闻里，",
      "token_start": 1375,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 418650,
      "end_ms": 420255,
      "text": "他应该被写进书里，",
      "token_start": 1386,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 420890,
      "end_ms": 422495,
      "text": "放在孩子的床头。",
      "token_start": 1394,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 423770,
      "end_ms": 424430,
      "text": "视频中。",
      "token_start": 1401,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 424430,
      "end_ms": 425950,
      "text": "这本书国之脊梁，",
      "token_start": 1404,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 425990,
      "end_ms": 428275,
      "text": "中国院士的科学人生百年，",
      "token_start": 1411,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 428800,
      "end_ms": 433745,
      "text": "是由中国科学院学部科学人生百年项目组编的。",
      "token_start": 1422,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 434650,
      "end_ms": 436285,
      "text": "书中四十位院士，",
      "token_start": 1442,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 436720,
      "end_ms": 438385,
      "text": "三十三个学科领域，",
      "token_start": 1449,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 438970,
      "end_ms": 443210,
      "text": "钱学森、郭永怀、程开甲、朱光亚等等，",
      "token_start": 1457,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 443460,
      "end_ms": 447115,
      "text": "每一位都是把命交给国家的人。",
      "token_start": 1471,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 448140,
      "end_ms": 449635,
      "text": "国家出版基金项目，",
      "token_start": 1484,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 449940,
      "end_ms": 455815,
      "text": "认准正版科学群星耀华夏院士精神代代传。",
      "token_start": 1492,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 456870,
      "end_ms": 460025,
      "text": "这句话就印在这本书上。",
      "token_start": 1510,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 460410,
      "end_ms": 466265,
      "text": "咱们这一代记得他们还不够得让孙子孙女为戴，",
      "token_start": 1520,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 466590,
      "end_ms": 469400,
      "text": "也记得他们视频左下角的链接，",
      "token_start": 1540,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 469420,
      "end_ms": 474935,
      "text": "点进去给家里的孩子带一本这四十个故事，",
      "token_start": 1553,
      "token_end_exclusive": 1571
    },
    {
      "start_ms": 475660,
      "end_ms": 478375,
      "text": "四十个把命交给国家的人，",
      "token_start": 1571,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 478920,
      "end_ms": 480655,
      "text": "值得放在孩子枕边。",
      "token_start": 1582,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 481140,
      "end_ms": 483215,
      "text": "如果你也被这位老人打动，",
      "token_start": 1590,
      "token_end_exclusive": 1601
    },
    {
      "start_ms": 483620,
      "end_ms": 485950,
      "text": "点个关注点个赞、收藏，",
      "token_start": 1601,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 486190,
      "end_ms": 487505,
      "text": "转发给更多的人。",
      "token_start": 1610,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 488580,
      "end_ms": 490725,
      "text": "让这个时代的年轻人知道，",
      "token_start": 1617,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 492310,
      "end_ms": 494195,
      "text": "中国天眼的背后，",
      "token_start": 1628,
      "token_end_exclusive": 1635
    },
    {
      "start_ms": 494700,
      "end_ms": 496735,
      "text": "有一个叫南仁东的老头，",
      "token_start": 1635,
      "token_end_exclusive": 1645
    },
    {
      "start_ms": 497110,
      "end_ms": 498045,
      "text": "拼尽了一生，",
      "token_start": 1645,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 498680,
      "end_ms": 501540,
      "text": "只为做一件事做到极致。",
      "token_start": 1650,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 501720,
      "end_ms": 502815,
      "text": "感谢你看到这里，",
      "token_start": 1660,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 503170,
      "end_ms": 504905,
      "text": "咱们下个故事见。",
      "token_start": 1667,
      "token_end_exclusive": 1674
    }
  ],
