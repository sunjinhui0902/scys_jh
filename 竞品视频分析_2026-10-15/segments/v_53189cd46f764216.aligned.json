  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1050,
      "text": "今天让你破费了，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1470,
      "end_ms": 3270,
      "text": "领导饭钱是小事儿，",
      "token_start": 7,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3370,
      "end_ms": 4750,
      "text": "能跟您单独请教一次。",
      "token_start": 15,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 4810,
      "end_ms": 6250,
      "text": "这顿对我来说是投资，",
      "token_start": 24,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8010,
      "end_ms": 8830,
      "text": "真会说话，",
      "token_start": 33,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 9070,
      "end_ms": 10690,
      "text": "我这肚子喝茶都能胖。",
      "token_start": 37,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 11470,
      "end_ms": 11890,
      "text": "领导，",
      "token_start": 46,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 12070,
      "end_ms": 12910,
      "text": "您那不叫胖，",
      "token_start": 48,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13190,
      "end_ms": 14710,
      "text": "那叫宰相肚里能撑船，",
      "token_start": 53,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 14810,
      "end_ms": 15930,
      "text": "装的全是大事儿，",
      "token_start": 62,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 17870,
      "end_ms": 19130,
      "text": "这藕是好藕啊，",
      "token_start": 69,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 19250,
      "end_ms": 20610,
      "text": "就是心眼儿太多了。",
      "token_start": 75,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 20810,
      "end_ms": 21210,
      "text": "领导，",
      "token_start": 83,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 21610,
      "end_ms": 22670,
      "text": "您虽然心儿多，",
      "token_start": 85,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 22770,
      "end_ms": 24050,
      "text": "但也是您的下酒菜啊，",
      "token_start": 91,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 26510,
      "end_ms": 27810,
      "text": "年轻就是好啊，",
      "token_start": 100,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 28670,
      "end_ms": 30000,
      "text": "年轻就是还够够撑啊，",
      "token_start": 106,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 30060,
      "end_ms": 30480,
      "text": "沉稳，",
      "token_start": 115,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 30660,
      "end_ms": 31720,
      "text": "还要向您多学习。",
      "token_start": 117,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 31920,
      "end_ms": 33100,
      "text": "我们才能变得更优秀，",
      "token_start": 124,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 33840,
      "end_ms": 35500,
      "text": "咋这么多饭你喂猪呢？",
      "token_start": 133,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 35640,
      "end_ms": 35980,
      "text": "领导，",
      "token_start": 142,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 35980,
      "end_ms": 36700,
      "text": "我哪敢啊，",
      "token_start": 144,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 36800,
      "end_ms": 38840,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 148,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 38980,
      "end_ms": 40460,
      "text": "都说在箱肚里能撑船，",
      "token_start": 164,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 40720,
      "end_ms": 41900,
      "text": "更何况只是一碗饭呢。",
      "token_start": 173,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 43560,
      "end_ms": 44000,
      "text": "小王，",
      "token_start": 182,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 44380,
      "end_ms": 45960,
      "text": "你这菜点的也太多了，",
      "token_start": 184,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 46580,
      "end_ms": 47820,
      "text": "领导菜点的再多，",
      "token_start": 193,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 47880,
      "end_ms": 49380,
      "text": "也比不上平时您对我的照顾。",
      "token_start": 200,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 49380,
      "end_ms": 50240,
      "text": "多这杯酒，",
      "token_start": 212,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 50240,
      "end_ms": 50880,
      "text": "我先敬您。",
      "token_start": 216,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 52140,
      "end_ms": 52960,
      "text": "鱼是好鱼，",
      "token_start": 220,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 53260,
      "end_ms": 54100,
      "text": "可惜就是刺。",
      "token_start": 224,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 54100,
      "end_ms": 54760,
      "text": "多领导，",
      "token_start": 229,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 54760,
      "end_ms": 55900,
      "text": "您看虽然刺多，",
      "token_start": 232,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 55920,
      "end_ms": 58420,
      "text": "但主心骨只有一根心腹是没有刺的。",
      "token_start": 238,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 59980,
      "end_ms": 60235,
      "text": "哎，",
      "token_start": 253,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 60620,
      "end_ms": 61415,
      "text": "你什么意思啊？",
      "token_start": 254,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 61730,
      "end_ms": 62935,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 260,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 63730,
      "end_ms": 64950,
      "text": "领导美满美满，",
      "token_start": 271,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 64950,
      "end_ms": 65875,
      "text": "代表幸福美满，",
      "token_start": 277,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 66130,
      "end_ms": 68065,
      "text": "这辈子美满就是一辈子美满啊。",
      "token_start": 283,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 69410,
      "end_ms": 70030,
      "text": "小王啊，",
      "token_start": 296,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 70270,
      "end_ms": 71550,
      "text": "你个子是真高比，",
      "token_start": 299,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 71550,
      "end_ms": 76705,
      "text": "我高一头呢个高是为了给领导探路走哪儿不还是得听领导指挥吗？",
      "token_start": 306,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 77350,
      "end_ms": 77730,
      "text": "哈哈，",
      "token_start": 334,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 79380,
      "end_ms": 79980,
      "text": "关注我，",
      "token_start": 336,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 80100,
      "end_ms": 81440,
      "text": "每天学点高情商，",
      "token_start": 339,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 81520,
      "end_ms": 82375,
      "text": "说话技巧，",
      "token_start": 346,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 83020,
      "end_ms": 85075,
      "text": "让你的路越走越宽。",
      "token_start": 350,
      "token_end_exclusive": 358
    }
