    },
    {
      "start_ms": 4310,
      "end_ms": 5370,
      "text": "没有血缘关系，",
      "token_start": 16,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5690,
      "end_ms": 7870,
      "text": "却依旧愿意疼你爱你，",
      "token_start": 22,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 8370,
      "end_ms": 9490,
      "text": "善待你的人。",
      "token_start": 31,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 10450,
      "end_ms": 12250,
      "text": "亲情是生来就有的羁绊，",
      "token_start": 36,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12750,
      "end_ms": 14450,
      "text": "可这份无关血脉的真心，",
      "token_start": 46,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 14970,
      "end_ms": 17210,
      "text": "是命运额外的馈赠，",
      "token_start": 56,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 18090,
      "end_ms": 19430,
      "text": "不沾亲情的纽带，",
      "token_start": 64,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 19930,
      "end_ms": 22410,
      "text": "却依旧愿意向你释放善意，",
      "token_start": 71,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 22930,
      "end_ms": 23970,
      "text": "全心付出。",
      "token_start": 82,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 25250,
      "end_ms": 26730,
      "text": "这份难得的相遇，",
