{
  "video_id": "v_34a16819ec77feb4",
  "duration_s": 194.769002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_34a16819ec77feb4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_34a16819ec77feb4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 410,
      "text": "究君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 850,
      "end_ms": 3090,
      "text": "你知道人生最大的危险是什么吗？",
      "token_start": 2,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3170,
      "end_ms": 4470,
      "text": "不是坏人太坏，",
      "token_start": 16,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4650,
      "end_ms": 7110,
      "text": "而是蠢人太蠢、保命。",
      "token_start": 22,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7190,
      "end_ms": 9090,
      "text": "最重要的就是远离蠢人，",
      "token_start": 30,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 9490,
      "end_ms": 11290,
      "text": "因为蠢人是不可能善良的，",
      "token_start": 40,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 11370,
      "end_ms": 12910,
      "text": "他连善恶都分不清楚。",
      "token_start": 51,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 13410,
      "end_ms": 15370,
      "text": "你说的每一句话他都会反驳，",
      "token_start": 60,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 15490,
      "end_ms": 19130,
      "text": "而且喜欢用小概率的个案来反驳你常规的事实。",
      "token_start": 72,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 19390,
      "end_ms": 21470,
      "text": "就比如你说吸烟有害健康，",
      "token_start": 92,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 21690,
      "end_ms": 22490,
      "text": "他说不可能。",
      "token_start": 103,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 22630,
      "end_ms": 24450,
      "text": "我爷爷抽烟喝酒活到九十五，",
      "token_start": 108,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 24770,
      "end_ms": 27090,
      "text": "你劝他好好学习读书提升学历，",
      "token_start": 120,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 27310,
      "end_ms": 28890,
      "text": "他会觉得你是看不起他。",
      "token_start": 133,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 29070,
      "end_ms": 29830,
      "text": "反驳说，",
      "token_start": 143,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 29830,
      "end_ms": 31580,
      "text": "你你你看人家小学毕业的，",
      "token_start": 146,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 31580,
      "end_ms": 33540,
      "text": "照样还是大老板硕士毕业出来，",
      "token_start": 157,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 33540,
      "end_ms": 34480,
      "text": "还是得送外卖。",
      "token_start": 170,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 35000,
      "end_ms": 36700,
      "text": "这种认知越匮乏，",
      "token_start": 176,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 36720,
      "end_ms": 37840,
      "text": "认知越低的人，",
      "token_start": 183,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 37940,
      "end_ms": 38980,
      "text": "想法越绝对。",
      "token_start": 189,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 39180,
      "end_ms": 39640,
      "text": "朱军，",
      "token_start": 194,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 39760,
      "end_ms": 41060,
      "text": "你身边有这种人吗？",
      "token_start": 196,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 41300,
      "end_ms": 42480,
      "text": "蠢人都有个特点，",
      "token_start": 204,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 42660,
      "end_ms": 43620,
      "text": "谁跟他越亲，",
      "token_start": 211,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 43760,
      "end_ms": 44700,
      "text": "他就越防备，",
      "token_start": 216,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 44700,
      "end_ms": 46200,
      "text": "谁谁对他越好，",
      "token_start": 221,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 46340,
      "end_ms": 47400,
      "text": "他就越折磨谁。",
      "token_start": 227,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 47780,
      "end_ms": 49680,
      "text": "他可以相信全世界的骗子，",
      "token_start": 233,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 49740,
      "end_ms": 55300,
      "text": "却偏偏怀疑最爱他的人一个蠢人能够造成的伤害比坏人还要多。",
      "token_start": 244,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 55740,
      "end_ms": 57520,
      "text": "坏人他还会承担后果，",
      "token_start": 271,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 57660,
      "end_ms": 59915,
      "text": "但蠢人做蠢事却要别人来背锅。",
      "token_start": 280,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 60480,
      "end_ms": 62365,
      "text": "愚蠢是一种道德上的缺陷，",
      "token_start": 293,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 62830,
      "end_ms": 64315,
      "text": "蠢就是坏，",
      "token_start": 304,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 64790,
      "end_ms": 65630,
      "text": "这不是刻薄，",
      "token_start": 308,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 65710,
      "end_ms": 67325,
      "text": "也不是居高临下的傲慢。",
      "token_start": 313,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 67690,
      "end_ms": 69090,
      "text": "世界上最危险的恶，",
      "token_start": 323,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 69090,
      "end_ms": 70665,
      "text": "就是这种无知之恶。",
      "token_start": 331,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 71100,
      "end_ms": 72960,
      "text": "我自己做新媒体以来发现，",
      "token_start": 339,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 72960,
      "end_ms": 76395,
      "text": "互联网最大的危险并不是让无知的人变多了，",
      "token_start": 350,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 76690,
      "end_ms": 78930,
      "text": "而是让无知的人找到了彼此，",
      "token_start": 369,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 79150,
      "end_ms": 80770,
      "text": "形成傻子共振的信息。",
      "token_start": 381,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 80770,
      "end_ms": 81255,
      "text": "检房，",
      "token_start": 390,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 81650,
      "end_ms": 84030,
      "text": "坏人处心积虑不如蠢人，",
      "token_start": 392,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 84090,
      "end_ms": 85025,
      "text": "灵机一动。",
      "token_start": 402,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 85400,
      "end_ms": 86160,
      "text": "比如有个女生，",
      "token_start": 406,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 86300,
      "end_ms": 89520,
      "text": "她的重要的档案寄回家里面千叮咛万嘱咐，",
      "token_start": 412,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 89520,
      "end_ms": 90880,
      "text": "父母千万不能拆开来，",
      "token_start": 430,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 90980,
      "end_ms": 93320,
      "text": "结果回家发现还是被她母亲给拆开了。",
      "token_start": 439,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 93480,
      "end_ms": 95340,
      "text": "但她并没有反思自己的行为，",
      "token_start": 455,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 95360,
      "end_ms": 96895,
      "text": "反而怪孩子脾气太大，",
      "token_start": 467,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 97190,
      "end_ms": 98470,
      "text": "自己只是好心帮忙，",
      "token_start": 476,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 98470,
      "end_ms": 98870,
      "text": "看看，",
      "token_start": 484,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 98970,
      "end_ms": 100475,
      "text": "不至于有什么严重的后果。",
      "token_start": 486,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 100750,
      "end_ms": 102150,
      "text": "而这种拒绝思考，",
      "token_start": 497,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 102170,
      "end_ms": 104265,
      "text": "只按照自己想法行动的行为，",
      "token_start": 504,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 104540,
      "end_ms": 107695,
      "text": "在心理学中就是一种以自我为中心的认知惰性，",
      "token_start": 516,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 108130,
      "end_ms": 110930,
      "text": "他们没有接受差异化、多元化的能力。",
      "token_start": 536,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 111090,
      "end_ms": 112790,
      "text": "只要是他们没见过的，",
      "token_start": 551,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 112790,
      "end_ms": 113550,
      "text": "没听过的，",
      "token_start": 560,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 113570,
      "end_ms": 116230,
      "text": "或者但凡和他已有的认知不一致的，",
      "token_start": 564,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 116250,
      "end_ms": 118875,
      "text": "他们通通会无差别的攻击和否认。",
      "token_start": 579,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 119140,
      "end_ms": 121420,
      "text": "他们很难接受新鲜事物认知，",
      "token_start": 593,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 121420,
      "end_ms": 122355,
      "text": "非常封闭。",
      "token_start": 605,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 122740,
      "end_ms": 125375,
      "text": "朱军千万不要让蠢人接近自己，",
      "token_start": 609,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 125740,
      "end_ms": 127520,
      "text": "我接受你有不同的价值观，",
      "token_start": 622,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 127540,
      "end_ms": 128580,
      "text": "不同的生活方式，",
      "token_start": 633,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 128720,
      "end_ms": 130630,
      "text": "但真的不能蠢蠢人，",
      "token_start": 640,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 130630,
      "end_ms": 131985,
      "text": "最擅长道德绑架。",
      "token_start": 648,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 132270,
      "end_ms": 134610,
      "text": "他们不知道事物并不是非黑即白的，",
      "token_start": 655,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 134630,
      "end_ms": 136720,
      "text": "而是有灰色地带的蠢人，",
      "token_start": 670,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 136720,
      "end_ms": 138060,
      "text": "没有办法理解他人。",
      "token_start": 680,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 138160,
      "end_ms": 140085,
      "text": "他丧失了最基本的同理心，",
      "token_start": 688,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 140570,
      "end_ms": 142530,
      "text": "认知水平低的人做不了好人，",
      "token_start": 699,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 142670,
      "end_ms": 144010,
      "text": "因为做好人并不简单，",
      "token_start": 711,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 144010,
      "end_ms": 146735,
      "text": "他需要你有一定的判断力和反思能力。",
      "token_start": 720,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 147000,
      "end_ms": 149945,
      "text": "但我发现厌蠢的人其实赚不了大钱，",
      "token_start": 736,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 150170,
      "end_ms": 150745,
      "text": "为什么呢？",
      "token_start": 751,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 151000,
      "end_ms": 151940,
      "text": "因为赚大钱，",
      "token_start": 755,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 151940,
      "end_ms": 154515,
      "text": "本质上就是一场尊重笨蛋的游戏，",
      "token_start": 760,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 154920,
      "end_ms": 155800,
      "text": "你瞧不起谁，",
      "token_start": 774,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 155860,
      "end_ms": 156955,
      "text": "就赚不到谁的钱，",
      "token_start": 779,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 157330,
      "end_ms": 159415,
      "text": "向下兼容才是财富密码，",
      "token_start": 786,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 159720,
      "end_ms": 162895,
      "text": "能伺候好自己讨厌的人才是赚钱的最高境界。",
      "token_start": 796,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 163150,
      "end_ms": 165415,
      "text": "而有些品牌就只赚蠢人的钱，",
      "token_start": 815,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 165700,
      "end_ms": 167925,
      "text": "你要是鼓励一个愚蠢的人继续愚蠢，",
      "token_start": 827,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 168170,
      "end_ms": 168975,
      "text": "他会感激你。",
      "token_start": 842,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 169310,
      "end_ms": 171570,
      "text": "但是你要试图帮他走出愚蠢，",
      "token_start": 847,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 171750,
      "end_ms": 173620,
      "text": "他会恨你的尊重。",
      "token_start": 859,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 173620,
      "end_ms": 175140,
      "text": "每一只青蛙和它的景，",
      "token_start": 866,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 175400,
      "end_ms": 176944,
      "text": "不要去试图改变什么。",
      "token_start": 875,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 177360,
      "end_ms": 179695,
      "text": "每个人的认知都配得上他的苦难。",
      "token_start": 884,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 180160,
      "end_ms": 182440,
      "text": "唯上至与下愚不疑。",
      "token_start": 898,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 183100,
      "end_ms": 183580,
      "text": "诸君，",
      "token_start": 906,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 183720,
      "end_ms": 185320,
      "text": "你之所以受到委屈，",
      "token_start": 908,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 185500,
      "end_ms": 188620,
      "text": "是因为你一直在试图改变一个根本不可能改变的人。",
      "token_start": 916,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 188860,
      "end_ms": 191920,
      "text": "人生最大的清醒就是允许别人愚蠢，",
      "token_start": 938,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 192060,
      "end_ms": 193540,
      "text": "但绝不允许别人的愚蠢，",
      "token_start": 953,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 193700,
      "end_ms": 194585,
      "text": "毁掉自己。",
      "token_start": 963,
      "token_end_exclusive": 967
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
