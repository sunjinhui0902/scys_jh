{
  "video_id": "v_b2bbecb4fc6ef0e9",
  "duration_s": 290.850998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b2bbecb4fc6ef0e9.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b2bbecb4fc6ef0e9.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 2430,
      "text": "今天有个业务要和供应商那边对接，",
      "token_start": 0,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 2810,
      "end_ms": 3890,
      "text": "我有别的事情要忙，",
      "token_start": 15,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 4510,
      "end_ms": 5830,
      "text": "你俩就替我去一趟吧。",
      "token_start": 23,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 6270,
      "end_ms": 6610,
      "text": "好的，",
      "token_start": 32,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 6610,
      "end_ms": 8650,
      "text": "王姐保证完成任务哦。",
      "token_start": 34,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 8650,
      "end_ms": 9050,
      "text": "对了，",
      "token_start": 43,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 9830,
      "end_ms": 11790,
      "text": "供应商那边的陈姐可是个厉害角色，",
      "token_start": 45,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 12110,
      "end_ms": 13405,
      "text": "别被人家拿捏了哦，",
      "token_start": 60,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 16820,
      "end_ms": 17140,
      "text": "师傅，",
      "token_start": 68,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 17140,
      "end_ms": 17900,
      "text": "能不能快点啊，",
      "token_start": 70,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 17900,
      "end_ms": 18840,
      "text": "我们有急事儿，",
      "token_start": 76,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 19080,
      "end_ms": 19560,
      "text": "哎呀，",
      "token_start": 82,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 19580,
      "end_ms": 20920,
      "text": "慢点安全不差。",
      "token_start": 84,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 20920,
      "end_ms": 26820,
      "text": "这一会儿师傅麻烦快点儿，",
      "token_start": 90,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 26820,
      "end_ms": 28400,
      "text": "我早上吃坏了东西，",
      "token_start": 101,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 28400,
      "end_ms": 29480,
      "text": "感觉要憋不住了。",
      "token_start": 109,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 29900,
      "end_ms": 30200,
      "text": "哎呦，",
      "token_start": 116,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 30200,
      "end_ms": 30720,
      "text": "小姑娘，",
      "token_start": 118,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 30860,
      "end_ms": 31600,
      "text": "你忍住哈，",
      "token_start": 121,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 31660,
      "end_ms": 32320,
      "text": "马上就到了，",
      "token_start": 125,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 32320,
      "end_ms": 41200,
      "text": "马上到人家这里拜访也不能空着手吧，",
      "token_start": 130,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 41340,
      "end_ms": 42920,
      "text": "走咱们看看去买点礼物。",
      "token_start": 146,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 43320,
      "end_ms": 43760,
      "text": "好的，",
      "token_start": 156,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 43960,
      "end_ms": 46919,
      "text": "我觉得也是听说这个陈姐爱打羽毛球，",
      "token_start": 158,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 47580,
      "end_ms": 48700,
      "text": "那这个球拍正合适，",
      "token_start": 174,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 48920,
      "end_ms": 50075,
      "text": "一千多块够档次。",
      "token_start": 182,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 52180,
      "end_ms": 53460,
      "text": "那我买盒羽毛球吧，",
      "token_start": 189,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 53540,
      "end_ms": 54340,
      "text": "也是一千多。",
      "token_start": 197,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 54680,
      "end_ms": 57260,
      "text": "陈姐肯定喜欢我这个高档球拍，",
      "token_start": 202,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 57580,
      "end_ms": 58680,
      "text": "羽毛球买这么贵的，",
      "token_start": 215,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 58680,
      "end_ms": 60085,
      "text": "干啥不都一个样吗？",
      "token_start": 223,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 60330,
      "end_ms": 63685,
      "text": "要感谢两位百忙之中来我们这儿，",
      "token_start": 231,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 64150,
      "end_ms": 65035,
      "text": "欢迎欢迎。",
      "token_start": 245,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 65610,
      "end_ms": 65970,
      "text": "陈姐，",
      "token_start": 249,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 65970,
      "end_ms": 66585,
      "text": "您真客气，",
      "token_start": 251,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 66770,
      "end_ms": 68590,
      "text": "这不我听说您爱打羽毛球，",
      "token_start": 255,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 68810,
      "end_ms": 70375,
      "text": "特意给您挑了个好球拍，",
      "token_start": 266,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 74140,
      "end_ms": 74945,
      "text": "破费了。",
      "token_start": 276,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 75270,
      "end_ms": 75715,
      "text": "陈姐，",
      "token_start": 279,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 76000,
      "end_ms": 77340,
      "text": "这是我给您买的羽毛球，",
      "token_start": 281,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 77640,
      "end_ms": 79020,
      "text": "听说是手工制作的，",
      "token_start": 291,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 79020,
      "end_ms": 79580,
      "text": "我也不懂，",
      "token_start": 299,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 79600,
      "end_ms": 80445,
      "text": "您凑合用吧。",
      "token_start": 303,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 81920,
      "end_ms": 82380,
      "text": "哎呦，",
      "token_start": 308,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 82920,
      "end_ms": 84285,
      "text": "这球手该可棒了。",
      "token_start": 310,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 84790,
      "end_ms": 85830,
      "text": "小姑娘这么远过来，",
      "token_start": 317,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 85830,
      "end_ms": 86350,
      "text": "饿了吧，",
      "token_start": 325,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 86490,
      "end_ms": 87470,
      "text": "走走走包间，",
      "token_start": 328,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 87470,
      "end_ms": 87990,
      "text": "我都订好了，",
      "token_start": 333,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 87990,
      "end_ms": 88915,
      "text": "咱们边吃边聊。",
      "token_start": 338,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 90320,
      "end_ms": 92175,
      "text": "感谢陈姐和大家的宴请。",
      "token_start": 344,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 92760,
      "end_ms": 93840,
      "text": "这俗话说得好，",
      "token_start": 354,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 94080,
      "end_ms": 94840,
      "text": "酒杯一拿，",
      "token_start": 360,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 95020,
      "end_ms": 95740,
      "text": "事业发达，",
      "token_start": 364,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 95960,
      "end_ms": 96620,
      "text": "酒杯一抬，",
      "token_start": 368,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 96780,
      "end_ms": 97520,
      "text": "升官发财，",
      "token_start": 372,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 97760,
      "end_ms": 99475,
      "text": "酒杯一举鹏程万里。",
      "token_start": 376,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 99790,
      "end_ms": 100485,
      "text": "酒杯一碰，",
      "token_start": 384,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 100780,
      "end_ms": 101520,
      "text": "财源滚滚，",
      "token_start": 388,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 101660,
      "end_ms": 102340,
      "text": "酒杯一响，",
      "token_start": 392,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 102500,
      "end_ms": 105175,
      "text": "黄金万两酒杯一干业绩翻番。",
      "token_start": 396,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 105820,
      "end_ms": 106060,
      "text": "来，",
      "token_start": 408,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 106200,
      "end_ms": 107165,
      "text": "我们一起举杯。",
      "token_start": 409,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 107810,
      "end_ms": 114225,
      "text": "那个哈哈哈陈姐，",
      "token_start": 415,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 114550,
      "end_ms": 115295,
      "text": "我敬你一杯，",
      "token_start": 422,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 116240,
      "end_ms": 117635,
      "text": "你凭什么敬我这一杯？",
      "token_start": 427,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 120470,
      "end_ms": 120970,
      "text": "陈姐，",
      "token_start": 436,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 121550,
      "end_ms": 122570,
      "text": "我们不图升官，",
      "token_start": 438,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 122650,
      "end_ms": 123290,
      "text": "也不图财，",
      "token_start": 444,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 123790,
      "end_ms": 126030,
      "text": "究竟您愿意看得起我们这些晚辈，",
      "token_start": 448,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 126450,
      "end_ms": 128290,
      "text": "很多东西花钱都买不到，",
      "token_start": 462,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 128590,
      "end_ms": 130450,
      "text": "但您几句话就能把我们点透，",
      "token_start": 472,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 130990,
      "end_ms": 132170,
      "text": "真的得记一辈子。",
      "token_start": 484,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 133730,
      "end_ms": 135170,
      "text": "好好这话，",
      "token_start": 491,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 135170,
      "end_ms": 136515,
      "text": "我爱听来干了。",
      "token_start": 495,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 138610,
      "end_ms": 139030,
      "text": "琳琳。",
      "token_start": 501,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 139610,
      "end_ms": 141470,
      "text": "今天这桌菜合不合你胃口啊，",
      "token_start": 503,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 141530,
      "end_ms": 143030,
      "text": "饭菜是填饱肚子的，",
      "token_start": 515,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 143090,
      "end_ms": 144870,
      "text": "您讲的话才是充实脑子的。",
      "token_start": 523,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 145130,
      "end_ms": 146490,
      "text": "今天这顿饭不重要，",
      "token_start": 534,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 146710,
      "end_ms": 147350,
      "text": "能坐在这儿，",
      "token_start": 542,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 147350,
      "end_ms": 149350,
      "text": "听您说话才是真的赚大了。",
      "token_start": 547,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 150190,
      "end_ms": 152570,
      "text": "听听都听听这姑娘会说话，",
      "token_start": 558,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 153630,
      "end_ms": 154610,
      "text": "谁学声狗叫，",
      "token_start": 569,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 154950,
      "end_ms": 156405,
      "text": "我就给谁一千块钱。",
      "token_start": 574,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 160670,
      "end_ms": 161690,
      "text": "祝陈姐家庭旺，",
      "token_start": 582,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 161690,
      "end_ms": 162390,
      "text": "事业旺以后，",
      "token_start": 588,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 162390,
      "end_ms": 163390,
      "text": "日子旺上加旺，",
      "token_start": 593,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 163410,
      "end_ms": 165435,
      "text": "一共四升四千块。",
      "token_start": 599,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 173720,
      "end_ms": 174200,
      "text": "这酒开了，",
      "token_start": 606,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 174200,
      "end_ms": 175100,
      "text": "怎么不先给我倒，",
      "token_start": 610,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 176640,
      "end_ms": 177480,
      "text": "先倒的是客，",
      "token_start": 617,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 177680,
      "end_ms": 178560,
      "text": "后倒的是主。",
      "token_start": 622,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 178900,
      "end_ms": 179980,
      "text": "您是今天的主人，",
      "token_start": 627,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 180220,
      "end_ms": 181780,
      "text": "最后一杯满上代表压肘，",
      "token_start": 634,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 181920,
      "end_ms": 184375,
      "text": "全桌的福气都沉淀在您这杯里啊。",
      "token_start": 644,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 184600,
      "end_ms": 186310,
      "text": "哈哈哈说的好，",
      "token_start": 658,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 186690,
      "end_ms": 189350,
      "text": "这杯我干了让你跑这么远，",
      "token_start": 664,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 189350,
      "end_ms": 192665,
      "text": "送我耽误你俩工作了吧，",
      "token_start": 675,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 193000,
      "end_ms": 196495,
      "text": "不耽误在办公室忙一天是把事儿做完，",
      "token_start": 685,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 197050,
      "end_ms": 198550,
      "text": "路上听您聊半个小时，",
      "token_start": 701,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 198790,
      "end_ms": 200210,
      "text": "是学怎么把事儿做好，",
      "token_start": 710,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 200630,
      "end_ms": 201690,
      "text": "这哪是耽误啊，",
      "token_start": 719,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 201750,
      "end_ms": 202855,
      "text": "这是赚了。",
      "token_start": 725,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 203710,
      "end_ms": 205690,
      "text": "今天咱们两家公司谈的很开心，",
      "token_start": 729,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 205930,
      "end_ms": 208470,
      "text": "下批材料我给你们价格再低十个点儿，",
      "token_start": 742,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 208870,
      "end_ms": 209535,
      "text": "太感谢了。",
      "token_start": 758,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 209720,
      "end_ms": 210160,
      "text": "陈姐，",
      "token_start": 762,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 210160,
      "end_ms": 213055,
      "text": "您慢走琳琳，",
      "token_start": 764,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 213350,
      "end_ms": 214235,
      "text": "你太厉害了。",
      "token_start": 769,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 214500,
      "end_ms": 217445,
      "text": "今天这陈杰可太难对付了没你我肯定完蛋。",
      "token_start": 774,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 217980,
      "end_ms": 219575,
      "text": "你这嘴皮子是咋练的呀？",
      "token_start": 792,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 220220,
      "end_ms": 221000,
      "text": "我总是嘴笨，",
      "token_start": 802,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 221020,
      "end_ms": 221940,
      "text": "反应慢一点，",
      "token_start": 807,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 221940,
      "end_ms": 222615,
      "text": "都不会说。",
      "token_start": 812,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 223870,
      "end_ms": 227465,
      "text": "我父母从小就让我看这本把话说的恰到好处。",
      "token_start": 816,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 227770,
      "end_ms": 228870,
      "text": "假如你不爱说话，",
      "token_start": 835,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 228890,
      "end_ms": 229570,
      "text": "不爱争辩，",
      "token_start": 842,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 229570,
      "end_ms": 230390,
      "text": "也不爱出门，",
      "token_start": 846,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 230530,
      "end_ms": 234525,
      "text": "甚至恐惧社交推荐你读完这本把话说的恰到好处，",
      "token_start": 851,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 234780,
      "end_ms": 236825,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 872,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 237250,
      "end_ms": 238415,
      "text": "你每天就看两页，",
      "token_start": 884,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 238670,
      "end_ms": 240010,
      "text": "每一个场景慢慢练，",
      "token_start": 891,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 240210,
      "end_ms": 242634,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 899,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 242880,
      "end_ms": 244020,
      "text": "在这本书里有一句话，",
      "token_start": 914,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 244040,
      "end_ms": 244955,
      "text": "我特别欣赏，",
      "token_start": 923,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 245290,
      "end_ms": 245450,
      "text": "他，",
      "token_start": 928,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 245450,
      "end_ms": 247090,
      "text": "写的是面对别人夸你优秀，",
      "token_start": 929,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 247210,
      "end_ms": 247905,
      "text": "你可以回，",
      "token_start": 940,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 248270,
      "end_ms": 249470,
      "text": "那是不优秀点儿，",
      "token_start": 944,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 249470,
      "end_ms": 250735,
      "text": "怎么能和你做朋友呢？",
      "token_start": 951,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 251380,
      "end_ms": 252655,
      "text": "当别人说你真聪明，",
      "token_start": 960,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 252860,
      "end_ms": 254580,
      "text": "你就回近朱者赤，",
      "token_start": 968,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 254680,
      "end_ms": 255580,
      "text": "和你在一起呀，",
      "token_start": 975,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 255620,
      "end_ms": 258180,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 981,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 258180,
      "end_ms": 259495,
      "text": "你就回领导，",
      "token_start": 996,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 259710,
      "end_ms": 260815,
      "text": "这都是我应该做的。",
      "token_start": 1001,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 261060,
      "end_ms": 262340,
      "text": "强将手下无弱兵，",
      "token_start": 1009,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 262420,
      "end_ms": 263705,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 1016,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 264130,
      "end_ms": 265210,
      "text": "当我看到这段的时候，",
      "token_start": 1025,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 265210,
      "end_ms": 267205,
      "text": "这个真是让我异解心开啊。",
      "token_start": 1034,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 267440,
      "end_ms": 268615,
      "text": "每一句都很有意思，",
      "token_start": 1045,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 268870,
      "end_ms": 271270,
      "text": "就是手把手教我们在不同的场景之下，",
      "token_start": 1053,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 271270,
      "end_ms": 272055,
      "text": "应该怎么说。",
      "token_start": 1069,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 272400,
      "end_ms": 274980,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1074,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 274980,
      "end_ms": 276100,
      "text": "你就放心的拿回去看，",
      "token_start": 1092,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 276320,
      "end_ms": 277720,
      "text": "就是一句一句的教你，",
      "token_start": 1101,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 277720,
      "end_ms": 279645,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 1110,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 279970,
      "end_ms": 281010,
      "text": "还有配套书籍，",
      "token_start": 1122,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 281150,
      "end_ms": 282490,
      "text": "把事做的恰到好处，",
      "token_start": 1128,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 283010,
      "end_ms": 284210,
      "text": "但凡学会三分，",
      "token_start": 1136,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 284270,
      "end_ms": 286375,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 1142,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 286790,
      "end_ms": 289150,
      "text": "这套书真的可以帮助到你好的。",
      "token_start": 1156,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 289150,
      "end_ms": 289605,
      "text": "林姐，",
      "token_start": 1169,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 289910,
      "end_ms": 290685,
      "text": "我这就回去看。",
      "token_start": 1171,
      "token_end_exclusive": 1177
    }
