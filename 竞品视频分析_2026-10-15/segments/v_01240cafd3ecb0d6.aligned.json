{
  "video_id": "v_01240cafd3ecb0d6",
  "duration_s": 434.399002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_01240cafd3ecb0d6.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_01240cafd3ecb0d6.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 670,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 670,
      "end_ms": 2550,
      "text": "咱们盘了第十到第六，",
      "token_start": 2,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2990,
      "end_ms": 5130,
      "text": "虎丘塔斜了一千年不倒，",
      "token_start": 11,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5770,
      "end_ms": 7290,
      "text": "小雁塔裂了三次，",
      "token_start": 21,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7490,
      "end_ms": 9370,
      "text": "自己合上松。",
      "token_start": 28,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 9370,
      "end_ms": 15010,
      "text": "岳寺塔是全国唯一的十二边形大理三塔堆土，",
      "token_start": 33,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 15050,
      "end_ms": 16370,
      "text": "修了千年不塌。",
      "token_start": 52,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 16870,
      "end_ms": 18890,
      "text": "六合塔送走了鲁智深，",
      "token_start": 58,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 19190,
      "end_ms": 20090,
      "text": "留住了武松。",
      "token_start": 67,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 20930,
      "end_ms": 23370,
      "text": "好多朋友看完在评论区炒翻了。",
      "token_start": 72,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 24150,
      "end_ms": 26790,
      "text": "有人说应县木塔呢？",
      "token_start": 85,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 26910,
      "end_ms": 27930,
      "text": "大雁塔呢？",
      "token_start": 93,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 28010,
      "end_ms": 28890,
      "text": "雷峰塔呢？",
      "token_start": 97,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 28990,
      "end_ms": 29635,
      "text": "别急，",
      "token_start": 101,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 31040,
      "end_ms": 33760,
      "text": "今天这集就是第五道第一，",
      "token_start": 103,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 34240,
      "end_ms": 35440,
      "text": "一个比一个悬。",
      "token_start": 114,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 35900,
      "end_ms": 38420,
      "text": "最后那个一根木头没烂，",
      "token_start": 120,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 38640,
      "end_ms": 39860,
      "text": "一块砖没碎，",
      "token_start": 130,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 40040,
      "end_ms": 47160,
      "text": "一千年了还占着老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 135,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 47400,
      "end_ms": 50280,
      "text": "让我看看都是谁在听。",
      "token_start": 159,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 51300,
      "end_ms": 51960,
      "text": "第五名，",
      "token_start": 168,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 52840,
      "end_ms": 57760,
      "text": "陕西西安大雁塔建于唐永辉三年，",
      "token_start": 171,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 58260,
      "end_ms": 59795,
      "text": "建元六百五十二年，",
      "token_start": 185,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 60160,
      "end_ms": 66090,
      "text": "玄奘法是为了存放从印度带回来的经卷和佛像亲自主持。",
      "token_start": 193,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 66090,
      "end_ms": 69795,
      "text": "修的这塔最绝的地方不是他有多高，",
      "token_start": 217,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 70180,
      "end_ms": 74165,
      "text": "是他底下有什么法门寺宝塔底下发现了地宫，",
      "token_start": 232,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 74620,
      "end_ms": 78980,
      "text": "出土了半个盛唐大雁塔底下呢专家说了，",
      "token_start": 251,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 79100,
      "end_ms": 80515,
      "text": "肯定也有地宫，",
      "token_start": 268,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 81000,
      "end_ms": 82540,
      "text": "到现在没发掘，",
      "token_start": 274,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 82720,
      "end_ms": 83565,
      "text": "也没被盗。",
      "token_start": 280,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 84310,
      "end_ms": 84975,
      "text": "为什么？",
      "token_start": 284,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 85280,
      "end_ms": 93705,
      "text": "因为大雁塔的地宫里极有可能藏着玄奘从印度带回来的贝叶经背叶经鼻纸结实，",
      "token_start": 287,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 94030,
      "end_ms": 95265,
      "text": "如果保存完好，",
      "token_start": 321,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 95530,
      "end_ms": 99445,
      "text": "那些一千三百多年前的经卷可能还在里面躺着。",
      "token_start": 327,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 99850,
      "end_ms": 103685,
      "text": "玄奘走了五万里路带回六百五十七部经书，",
      "token_start": 347,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 104300,
      "end_ms": 105465,
      "text": "翻译了一辈子。",
      "token_start": 365,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 105760,
      "end_ms": 109045,
      "text": "最后那些原版经卷就埋在塔底下，",
      "token_start": 371,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 109400,
      "end_ms": 110155,
      "text": "没人敢动。",
      "token_start": 385,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 110750,
      "end_ms": 113270,
      "text": "您说这是给后人留的悬念，",
      "token_start": 389,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 113470,
      "end_ms": 115435,
      "text": "还是给玄奘留的清净？",
      "token_start": 400,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 116540,
      "end_ms": 117285,
      "text": "第四名，",
      "token_start": 409,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 118260,
      "end_ms": 122150,
      "text": "山西朔州应县木塔建于辽，",
      "token_start": 412,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 122210,
      "end_ms": 123195,
      "text": "清明二年，",
      "token_start": 423,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 124220,
      "end_ms": 126225,
      "text": "公元一千零五十六年，",
      "token_start": 427,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 127180,
      "end_ms": 133045,
      "text": "全名佛宫寺释迦塔高六十七点三一米，",
      "token_start": 436,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 133610,
      "end_ms": 135265,
      "text": "相当于二十二层楼。",
      "token_start": 452,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 136130,
      "end_ms": 138480,
      "text": "全木头搭的没用一根铁钉，",
      "token_start": 460,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 138840,
      "end_ms": 140535,
      "text": "全靠榫卯和斗拱，",
      "token_start": 471,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 140890,
      "end_ms": 144445,
      "text": "一根扣一根一层压一层光斗骨，",
      "token_start": 478,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 144740,
      "end_ms": 146585,
      "text": "就有五十四种样式，",
      "token_start": 491,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 147240,
      "end_ms": 151375,
      "text": "人称斗拱博物馆近一千年里，",
      "token_start": 499,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 151630,
      "end_ms": 153465,
      "text": "经历了四十多次地震。",
      "token_start": 511,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 154330,
      "end_ms": 156150,
      "text": "民国军阀混战的时候，",
      "token_start": 520,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 156310,
      "end_ms": 158990,
      "text": "两百多发炮弹打在他身上，",
      "token_start": 529,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 159110,
      "end_ms": 161845,
      "text": "但恐现在还能看见他照样站着。",
      "token_start": 540,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 162410,
      "end_ms": 163365,
      "text": "一九二六年，",
      "token_start": 553,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 163680,
      "end_ms": 164415,
      "text": "军阀打仗，",
      "token_start": 558,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 164820,
      "end_ms": 167255,
      "text": "炮弹把塔身打的千疮百孔，",
      "token_start": 562,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 167710,
      "end_ms": 168555,
      "text": "木塔没倒，",
      "token_start": 573,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 168990,
      "end_ms": 173565,
      "text": "一九七六年唐山大地震应线震感强烈，",
      "token_start": 577,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 173920,
      "end_ms": 174785,
      "text": "木塔没倒。",
      "token_start": 593,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 175240,
      "end_ms": 177360,
      "text": "您说一堆木头搭的塔，",
      "token_start": 597,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 177620,
      "end_ms": 178600,
      "text": "扛过地震，",
      "token_start": 606,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 178780,
      "end_ms": 180915,
      "text": "扛过炮弹扛了一千年。",
      "token_start": 610,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 181690,
      "end_ms": 182710,
      "text": "这是什么手艺？",
      "token_start": 619,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 182870,
      "end_ms": 184135,
      "text": "这是什么样的智慧？",
      "token_start": 625,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 184600,
      "end_ms": 185220,
      "text": "第三名，",
      "token_start": 633,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 185540,
      "end_ms": 188275,
      "text": "浙江杭州雷峰塔建于北宋，",
      "token_start": 636,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 188710,
      "end_ms": 190335,
      "text": "公元九百七十七年，",
      "token_start": 647,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 190750,
      "end_ms": 197045,
      "text": "吴越王钱弘修的这塔最有名的不是他是传说。",
      "token_start": 655,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 197450,
      "end_ms": 198345,
      "text": "白蛇传里，",
      "token_start": 674,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 198840,
      "end_ms": 202035,
      "text": "法海把白娘子压在雷峰塔底下，",
      "token_start": 678,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 202580,
      "end_ms": 204565,
      "text": "鲁迅先生还写过一篇文章，",
      "token_start": 691,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 204910,
      "end_ms": 206990,
      "text": "叫论雷峰塔的倒调。",
      "token_start": 702,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 207390,
      "end_ms": 210295,
      "text": "一九二四年雷峰塔真的倒了，",
      "token_start": 710,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 210570,
      "end_ms": 211250,
      "text": "倒了以后，",
      "token_start": 722,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 211450,
      "end_ms": 213465,
      "text": "大家以为故事就这么完了。",
      "token_start": 726,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 213900,
      "end_ms": 221265,
      "text": "没想到两千年考古队清理废墟在地宫里挖出来一件东西。",
      "token_start": 737,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 221580,
      "end_ms": 231190,
      "text": "纯银的阿育王塔里面有一个金盒子盒子里装着佛罗纪发舍利佛罗纪发是什么？",
      "token_start": 761,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 231330,
      "end_ms": 233550,
      "text": "就是佛祖释迦牟尼的头发，",
      "token_start": 794,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 233730,
      "end_ms": 235085,
      "text": "全世界就这一份，",
      "token_start": 805,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 235420,
      "end_ms": 238565,
      "text": "白娘子没找着找着了佛祖的头发，",
      "token_start": 812,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 238840,
      "end_ms": 241750,
      "text": "一座塔压着一段爱情传说，",
      "token_start": 826,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 242190,
      "end_ms": 244090,
      "text": "也压着一件佛教至宝。",
      "token_start": 837,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 244830,
      "end_ms": 248090,
      "text": "您说这是巧合还是天意？",
      "token_start": 846,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 249010,
      "end_ms": 249650,
      "text": "第二名，",
      "token_start": 856,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 250550,
      "end_ms": 252650,
      "text": "河南开封开宝寺塔，",
      "token_start": 859,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 253330,
      "end_ms": 254910,
      "text": "也叫开封铁塔。",
      "token_start": 867,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 255230,
      "end_ms": 256290,
      "text": "建于北宋，",
      "token_start": 873,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 256330,
      "end_ms": 257250,
      "text": "皇佑元年，",
      "token_start": 877,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 258150,
      "end_ms": 260190,
      "text": "公元一千零四十九年，",
      "token_start": 881,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 260930,
      "end_ms": 262030,
      "text": "这不是铁塔，",
      "token_start": 890,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 262390,
      "end_ms": 263650,
      "text": "是琉璃铁塔，",
      "token_start": 895,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 264130,
      "end_ms": 266290,
      "text": "因为砖的颜色像铁锈，",
      "token_start": 900,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 266590,
      "end_ms": 267450,
      "text": "所以叫铁塔。",
      "token_start": 909,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 267450,
      "end_ms": 271580,
      "text": "高五十五点二八八米十三层。",
      "token_start": 914,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 272060,
      "end_ms": 273980,
      "text": "这塔最绝的地方是，",
      "token_start": 926,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 273980,
      "end_ms": 274700,
      "text": "他扛得住。",
      "token_start": 934,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 274800,
      "end_ms": 275600,
      "text": "建成以来，",
      "token_start": 938,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 275840,
      "end_ms": 280260,
      "text": "经历了三十八次六级以上地震九次，",
      "token_start": 942,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 280420,
      "end_ms": 281460,
      "text": "黄河水患。",
      "token_start": 957,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 281860,
      "end_ms": 283020,
      "text": "抗日战争时期，",
      "token_start": 961,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 283380,
      "end_ms": 286500,
      "text": "日军用炮弹轰塔身上，",
      "token_start": 967,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 286540,
      "end_ms": 287740,
      "text": "现在还留着弹孔，",
      "token_start": 976,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 287920,
      "end_ms": 288760,
      "text": "它就是不倒，",
      "token_start": 983,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 289200,
      "end_ms": 290200,
      "text": "怎么做到的？",
      "token_start": 988,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 290320,
      "end_ms": 292180,
      "text": "塔里面有一根塔心柱，",
      "token_start": 993,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 292580,
      "end_ms": 296060,
      "text": "从底一直通到顶螺旋式的台阶，",
      "token_start": 1002,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 296520,
      "end_ms": 299060,
      "text": "把塔心柱和外墙死死连在一起。",
      "token_start": 1015,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 299380,
      "end_ms": 300270,
      "text": "外面怎么画？",
      "token_start": 1028,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 300450,
      "end_ms": 302710,
      "text": "里面是抱团的一座塔，",
      "token_start": 1033,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 303630,
      "end_ms": 304530,
      "text": "扛了地震，",
      "token_start": 1042,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 304530,
      "end_ms": 305310,
      "text": "扛了洪水，",
      "token_start": 1046,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 305410,
      "end_ms": 306265,
      "text": "扛了炮弹。",
      "token_start": 1050,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 307100,
      "end_ms": 308220,
      "text": "九百多年了，",
      "token_start": 1054,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 308600,
      "end_ms": 310380,
      "text": "连块砖都没掉，",
      "token_start": 1059,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 310640,
      "end_ms": 313320,
      "text": "您说这琉璃砖是不是比铁还硬？",
      "token_start": 1065,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 314400,
      "end_ms": 314999,
      "text": "第一名，",
      "token_start": 1078,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 315220,
      "end_ms": 318700,
      "text": "陕西西安建福寺、小雁塔等等。",
      "token_start": 1081,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 319360,
      "end_ms": 321100,
      "text": "小雁塔不是第九名吗？",
      "token_start": 1093,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 321940,
      "end_ms": 322180,
      "text": "对，",
      "token_start": 1102,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 323160,
      "end_ms": 325520,
      "text": "第九名是小雁塔的塔。",
      "token_start": 1103,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 325680,
      "end_ms": 329900,
      "text": "我说的第一名是小雁塔底下的那套地基，",
      "token_start": 1112,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 330860,
      "end_ms": 334980,
      "text": "您知道小雁塔为什么裂了三次都能合上吗？",
      "token_start": 1129,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 335700,
      "end_ms": 336360,
      "text": "不是神，",
      "token_start": 1147,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 336870,
      "end_ms": 337530,
      "text": "是地基。",
      "token_start": 1150,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 338430,
      "end_ms": 340210,
      "text": "考古队勘探以后发现，",
      "token_start": 1153,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 340230,
      "end_ms": 345770,
      "text": "小雁塔底下是一整套夯土和卵石交替的地基，",
      "token_start": 1162,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 346350,
      "end_ms": 348470,
      "text": "一层土一层石头，",
      "token_start": 1181,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 348750,
      "end_ms": 349490,
      "text": "一层土，",
      "token_start": 1188,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 349910,
      "end_ms": 352430,
      "text": "一层石头就像一个弹簧。",
      "token_start": 1191,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 352630,
      "end_ms": 353490,
      "text": "地震来了，",
      "token_start": 1201,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 353670,
      "end_ms": 355010,
      "text": "地基先把力卸掉，",
      "token_start": 1205,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 355010,
      "end_ms": 358950,
      "text": "大半传到塔身上的力已经没那么大了，",
      "token_start": 1212,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 359270,
      "end_ms": 360370,
      "text": "所以塔裂了，",
      "token_start": 1228,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 360370,
      "end_ms": 361390,
      "text": "能合合了，",
      "token_start": 1233,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 361390,
      "end_ms": 361990,
      "text": "能再裂。",
      "token_start": 1237,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 362510,
      "end_ms": 365610,
      "text": "这套地基从唐朝一直管到今天，",
      "token_start": 1240,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 365610,
      "end_ms": 370815,
      "text": "一一千三百多年别的古塔靠的是塔身结石。",
      "token_start": 1253,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 371610,
      "end_ms": 373995,
      "text": "小雁塔靠的是地底下有弹性，",
      "token_start": 1271,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 374770,
      "end_ms": 378165,
      "text": "这才是真正坐头把交椅的东西。",
      "token_start": 1283,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 379230,
      "end_ms": 380435,
      "text": "不是他有多高，",
      "token_start": 1296,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 380740,
      "end_ms": 382805,
      "text": "是地基有多软软的，",
      "token_start": 1302,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 383100,
      "end_ms": 384635,
      "text": "比硬的更扛得住。",
      "token_start": 1310,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 385060,
      "end_ms": 386275,
      "text": "您听出来了没有？",
      "token_start": 1317,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 386600,
      "end_ms": 392230,
      "text": "这十座古塔没有一座是光靠高出名的虎丘塔，",
      "token_start": 1324,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 392250,
      "end_ms": 393575,
      "text": "靠的是邪而不倒。",
      "token_start": 1343,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 394210,
      "end_ms": 396570,
      "text": "小雁塔靠的是裂而复合。",
      "token_start": 1350,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 397150,
      "end_ms": 401430,
      "text": "松岳寺塔靠的是全国孤立大理三塔，",
      "token_start": 1360,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 401670,
      "end_ms": 403575,
      "text": "靠的是堆土建塔，",
      "token_start": 1375,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 403980,
      "end_ms": 405925,
      "text": "六和塔靠的是水浒英雄，",
      "token_start": 1382,
      "token_end_exclusive": 1392
    },
    {
      "start_ms": 406580,
      "end_ms": 408825,
      "text": "大雁塔靠的是地宫悬念。",
      "token_start": 1392,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 409520,
      "end_ms": 412035,
      "text": "应县木塔靠的是无丁无卯，",
      "token_start": 1402,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 412550,
      "end_ms": 414790,
      "text": "雷峰塔靠的是白蛇传说，",
      "token_start": 1413,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 415370,
      "end_ms": 418225,
      "text": "开封铁塔靠的是炮弹轰不倒。",
      "token_start": 1423,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 418760,
      "end_ms": 421095,
      "text": "小雁塔靠的是地基有弹性，",
      "token_start": 1435,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 421440,
      "end_ms": 422245,
      "text": "您发现没有？",
      "token_start": 1446,
      "token_end_exclusive": 1451
    },
    {
      "start_ms": 422550,
      "end_ms": 424175,
      "text": "这些塔厉害的地方，",
      "token_start": 1451,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 424490,
      "end_ms": 426135,
      "text": "不在于砖有多硬，",
      "token_start": 1459,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 426520,
      "end_ms": 427600,
      "text": "木头有多好，",
      "token_start": 1466,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 427760,
      "end_ms": 431700,
      "text": "在于每一座都把古人的智慧刻在了骨子里。",
      "token_start": 1471,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 431780,
      "end_ms": 432580,
      "text": "点个关注，",
      "token_start": 1489,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 432780,
      "end_ms": 434285,
      "text": "咱们下期接着聊。",
      "token_start": 1493,
      "token_end_exclusive": 1500
    }
  ],
