  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1930,
      "text": "不喝就是看不起我。",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2290,
      "end_ms": 2770,
      "text": "领导，",
      "token_start": 8,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3050,
      "end_ms": 4130,
      "text": "我不是看不起您，",
      "token_start": 10,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4550,
      "end_ms": 5695,
      "text": "我是看不起病。",
      "token_start": 17,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 8200,
      "end_ms": 8580,
      "text": "小李，",
      "token_start": 23,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 9080,
      "end_ms": 10140,
      "text": "今天让你破费了。",
      "token_start": 25,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 10500,
      "end_ms": 10900,
      "text": "领导，",
      "token_start": 32,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 11140,
      "end_ms": 12720,
      "text": "您说这些您能来，",
      "token_start": 34,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 12720,
      "end_ms": 13460,
      "text": "就是我的荣幸。",
      "token_start": 41,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 13880,
      "end_ms": 15540,
      "text": "以后还有很多地方向您请教。",
      "token_start": 47,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15540,
      "end_ms": 19790,
      "text": "不是年轻就是好啊，",
      "token_start": 59,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 20190,
      "end_ms": 21690,
      "text": "年轻就是还不够沉稳，",
      "token_start": 67,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 22030,
      "end_ms": 23170,
      "text": "还要向您多学习，",
      "token_start": 76,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 23370,
      "end_ms": 24855,
      "text": "我们才能变得更优秀。",
      "token_start": 83,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 27670,
      "end_ms": 28990,
      "text": "这鸭子是好鸭子，",
      "token_start": 92,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 29310,
      "end_ms": 30110,
      "text": "就是嘴硬，",
      "token_start": 99,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 30990,
      "end_ms": 31430,
      "text": "嘴硬，",
      "token_start": 103,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 31430,
      "end_ms": 36510,
      "text": "才守得住秘密鱼是好鱼，",
      "token_start": 105,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 36890,
      "end_ms": 38010,
      "text": "可惜就是刺多。",
      "token_start": 115,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 38330,
      "end_ms": 38670,
      "text": "领导，",
      "token_start": 121,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 38670,
      "end_ms": 40390,
      "text": "您看鱼虽然刺多，",
      "token_start": 123,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 40530,
      "end_ms": 43130,
      "text": "但主心骨只有一根心腹是没有刺的。",
      "token_start": 130,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 45230,
      "end_ms": 45410,
      "text": "来，",
      "token_start": 145,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 45410,
      "end_ms": 47190,
      "text": "这么晚只能吃剩菜了吧。",
      "token_start": 146,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 47510,
      "end_ms": 47910,
      "text": "领导，",
      "token_start": 156,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 48150,
      "end_ms": 49250,
      "text": "饭在哪儿我都能吃，",
      "token_start": 158,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 49430,
      "end_ms": 51450,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 166,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 51450,
      "end_ms": 53095,
      "text": "能赶上已经是我的运气了。",
      "token_start": 179,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 55340,
      "end_ms": 55720,
      "text": "小李，",
      "token_start": 190,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 56040,
      "end_ms": 57500,
      "text": "你这菜点的也太多了，",
      "token_start": 192,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 57960,
      "end_ms": 59540,
      "text": "领导菜点的再多，",
      "token_start": 201,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 59540,
      "end_ms": 61720,
      "text": "也比不上平时您对我的照顾多这杯酒，",
      "token_start": 208,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 61720,
      "end_ms": 62405,
      "text": "我先敬您。",
      "token_start": 224,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 65790,
      "end_ms": 66495,
      "text": "小李啊，",
      "token_start": 228,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 66860,
      "end_ms": 68380,
      "text": "你个子是真高比，",
      "token_start": 231,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 68380,
      "end_ms": 69405,
      "text": "我还高一头呢。",
      "token_start": 238,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 69910,
      "end_ms": 73755,
      "text": "个高是为了给领导探路走哪儿不还是得听领导指挥吗？",
      "token_start": 244,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 74270,
      "end_ms": 76865,
      "text": "哈哈哈哈哈怎么你这一入职，",
      "token_start": 267,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 77370,
      "end_ms": 78845,
      "text": "我刚种的花就死了，",
      "token_start": 279,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 79420,
      "end_ms": 80380,
      "text": "花开富贵嘛，",
      "token_start": 287,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 80520,
      "end_ms": 81960,
      "text": "花开过了就剩富贵了。",
      "token_start": 292,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 82100,
      "end_ms": 84125,
      "text": "看来领导您啊要发大财了。",
      "token_start": 301,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 84490,
      "end_ms": 86325,
      "text": "哈哈哈哈关注我，",
      "token_start": 312,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 86610,
      "end_ms": 88190,
      "text": "每天学点高情商，",
      "token_start": 319,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 88250,
      "end_ms": 89125,
      "text": "说话技巧，",
      "token_start": 326,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 89460,
      "end_ms": 91315,
      "text": "让你的路越走越宽。",
      "token_start": 330,
      "token_end_exclusive": 338
    }
  ],
