{
  "video_id": "v_bbc826285634ad42",
  "duration_s": 518.344828,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_bbc826285634ad42.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_bbc826285634ad42.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1490,
      "text": "上一集我们讲了，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1490,
      "end_ms": 3810,
      "text": "王成书被美国扣留七年，",
      "token_start": 7,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4330,
      "end_ms": 7990,
      "text": "硬是把九百公斤资料蚂蚁搬家寄回国。",
      "token_start": 17,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8530,
      "end_ms": 11530,
      "text": "一九五六年终于踏上祖国的土地。",
      "token_start": 33,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 12130,
      "end_ms": 12910,
      "text": "很多人问，",
      "token_start": 47,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 13530,
      "end_ms": 14530,
      "text": "回来之后呢，",
      "token_start": 51,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 14630,
      "end_ms": 16070,
      "text": "她到底干了什么？",
      "token_start": 56,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 16410,
      "end_ms": 19190,
      "text": "能让毛主席亲口叫她女功臣。",
      "token_start": 63,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 19730,
      "end_ms": 22410,
      "text": "今天这集我给你算清一笔账，",
      "token_start": 75,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 23870,
      "end_ms": 28250,
      "text": "有个女人这辈子在关键时刻只说过三个字，",
      "token_start": 87,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 28250,
      "end_ms": 28890,
      "text": "我愿意。",
      "token_start": 105,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 29310,
      "end_ms": 31480,
      "text": "有这仨字字他说了三回，",
      "token_start": 108,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 32380,
      "end_ms": 36460,
      "text": "第一回扔掉了研究二十年的看家本领，",
      "token_start": 118,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 36460,
      "end_ms": 39620,
      "text": "第二回把名字从全世界抹掉了，",
      "token_start": 134,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 40420,
      "end_ms": 43100,
      "text": "第三回把余生也埋了进去，",
      "token_start": 147,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 43740,
      "end_ms": 47700,
      "text": "连丈夫都不能说他在哪到去世那天，",
      "token_start": 158,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 48000,
      "end_ms": 49980,
      "text": "全国没几个人知道他叫啥，",
      "token_start": 173,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 50400,
      "end_ms": 53500,
      "text": "而他本来是能拿诺贝尔奖的，",
      "token_start": 184,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 54080,
      "end_ms": 55240,
      "text": "他叫王成书。",
      "token_start": 196,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 55820,
      "end_ms": 56980,
      "text": "今天我把这三回，",
      "token_start": 201,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 57000,
      "end_ms": 57580,
      "text": "我愿意，",
      "token_start": 208,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 58060,
      "end_ms": 59945,
      "text": "一单一单给你算清楚。",
      "token_start": 211,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 60130,
      "end_ms": 60370,
      "text": "嗯，",
      "token_start": 220,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 60680,
      "end_ms": 62000,
      "text": "每当他赔进去，",
      "token_start": 221,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 62000,
      "end_ms": 65345,
      "text": "什么国家又赢回了什么第一回，",
      "token_start": 227,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67460,
      "end_ms": 68155,
      "text": "我愿意。",
      "token_start": 240,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 70620,
      "end_ms": 71515,
      "text": "一九五八年，",
      "token_start": 243,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 71930,
      "end_ms": 79045,
      "text": "他已经四十六岁二十年积累的锡箔气体研究说清零就清零。",
      "token_start": 248,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 79350,
      "end_ms": 81830,
      "text": "一九五六年回国后王成书，",
      "token_start": 273,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 81850,
      "end_ms": 84345,
      "text": "本来可以接着搞他的锡薄气体，",
      "token_start": 284,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 84900,
      "end_ms": 86325,
      "text": "那是他搞了二十年，",
      "token_start": 297,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 86860,
      "end_ms": 89235,
      "text": "已经站在世界顶端的领域，",
      "token_start": 305,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 89690,
      "end_ms": 91955,
      "text": "WCU方程就是他的名片。",
      "token_start": 316,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 92530,
      "end_ms": 93605,
      "text": "可才过了两年，",
      "token_start": 325,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 94050,
      "end_ms": 96145,
      "text": "钱三强上门找他谈合作，",
      "token_start": 331,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 96510,
      "end_ms": 98965,
      "text": "国家要建热核聚变研究室，",
      "token_start": 341,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 99780,
      "end_ms": 101685,
      "text": "国内这方面一片空白。",
      "token_start": 352,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 101960,
      "end_ms": 102625,
      "text": "你来带头，",
      "token_start": 361,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 103960,
      "end_ms": 105545,
      "text": "你知道这意味着什么吗？",
      "token_start": 365,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 106040,
      "end_ms": 108445,
      "text": "他搞的是高空稀薄气体，",
      "token_start": 375,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 109010,
      "end_ms": 110545,
      "text": "那是天上飘的东西。",
      "token_start": 385,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 110980,
      "end_ms": 113160,
      "text": "热何聚变是地上的工程，",
      "token_start": 393,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 113240,
      "end_ms": 114705,
      "text": "物理听着都叫物理，",
      "token_start": 403,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 115030,
      "end_ms": 116715,
      "text": "实际上完全是两码事。",
      "token_start": 411,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 117510,
      "end_ms": 118495,
      "text": "更要命的是，",
      "token_start": 420,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 118790,
      "end_ms": 120225,
      "text": "他已经四十六岁了，",
      "token_start": 425,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 121390,
      "end_ms": 123025,
      "text": "专业早就定型了。",
      "token_start": 433,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 123790,
      "end_ms": 126570,
      "text": "这是让他把过去研究了二十年的心血，",
      "token_start": 440,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 126610,
      "end_ms": 127554,
      "text": "一笔勾销，",
      "token_start": 456,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 128140,
      "end_ms": 131035,
      "text": "回去当小学生重新改研究方向，",
      "token_start": 460,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 131600,
      "end_ms": 132300,
      "text": "前三强，",
      "token_start": 473,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 132360,
      "end_ms": 133815,
      "text": "还在等他犹豫，",
      "token_start": 476,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 134180,
      "end_ms": 135225,
      "text": "他张嘴就来，",
      "token_start": 482,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 135580,
      "end_ms": 138555,
      "text": "我愿意接下来发生的事儿，",
      "token_start": 487,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 138850,
      "end_ms": 140845,
      "text": "只能用恐怖来形容。",
      "token_start": 498,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 141680,
      "end_ms": 144415,
      "text": "他从四十六岁开始自学俄语，",
      "token_start": 506,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 144810,
      "end_ms": 148495,
      "text": "被派去苏联库尔恰托夫研究所进修，",
      "token_start": 518,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 149270,
      "end_ms": 150810,
      "text": "从莫斯科回到北京，",
      "token_start": 533,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 150910,
      "end_ms": 152925,
      "text": "坐了七天七夜的火车。",
      "token_start": 541,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 153850,
      "end_ms": 155095,
      "text": "别人在睡觉，",
      "token_start": 550,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 155820,
      "end_ms": 157485,
      "text": "他趴在小桌板上，",
      "token_start": 555,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 158210,
      "end_ms": 163380,
      "text": "把美国核聚变规划的机密文献学武德方案给翻译。",
      "token_start": 562,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 163380,
      "end_ms": 165055,
      "text": "完了两年。",
      "token_start": 583,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 167150,
      "end_ms": 167875,
      "text": "就这两年，",
      "token_start": 587,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 168430,
      "end_ms": 169555,
      "text": "他带出一支队伍，",
      "token_start": 591,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 170580,
      "end_ms": 174695,
      "text": "把国内热核聚变理论的空白给填上了，",
      "token_start": 598,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 175450,
      "end_ms": 180205,
      "text": "直接成了中国受控核聚变和等离子体物理的开创者。",
      "token_start": 614,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 181360,
      "end_ms": 182615,
      "text": "四十六岁归零，",
      "token_start": 636,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 183140,
      "end_ms": 186400,
      "text": "四十八岁又重新登顶单。",
      "token_start": 642,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 186400,
      "end_ms": 191215,
      "text": "这一项他培进去二十年的专业知识的积累，",
      "token_start": 652,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 191520,
      "end_ms": 194355,
      "text": "国家迎回了一个从零到一的新领域。",
      "token_start": 670,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 194530,
      "end_ms": 194970,
      "text": "第二回，",
      "token_start": 685,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 194970,
      "end_ms": 195575,
      "text": "我愿意。",
      "token_start": 688,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 196780,
      "end_ms": 197980,
      "text": "一九六一年那年，",
      "token_start": 691,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 197980,
      "end_ms": 199005,
      "text": "他四十九岁，",
      "token_start": 698,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 199460,
      "end_ms": 201425,
      "text": "连人带名字一起销毁，",
      "token_start": 703,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 201820,
      "end_ms": 203155,
      "text": "刚要出大成果。",
      "token_start": 712,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 203490,
      "end_ms": 204305,
      "text": "第二单来了。",
      "token_start": 718,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 205900,
      "end_ms": 206905,
      "text": "一九六一年，",
      "token_start": 723,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 207270,
      "end_ms": 209935,
      "text": "苏联专家卷着图纸全跑了，",
      "token_start": 728,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 210400,
      "end_ms": 211620,
      "text": "原子弹的命门，",
      "token_start": 739,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 211900,
      "end_ms": 214865,
      "text": "核燃料浓缩又卡死了。",
      "token_start": 745,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 215230,
      "end_ms": 218730,
      "text": "天然釉里能裂变的又两百三十五，",
      "token_start": 754,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 218730,
      "end_ms": 220015,
      "text": "只有百分之零点七，",
      "token_start": 768,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 220640,
      "end_ms": 224140,
      "text": "要造原子弹又又得浓缩到百分之九十以上。",
      "token_start": 776,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 224240,
      "end_ms": 229500,
      "text": "这活儿全中国压根儿就没人会钱三强，",
      "token_start": 794,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 229600,
      "end_ms": 231925,
      "text": "第三次坐到他对面和他谈。",
      "token_start": 810,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 232870,
      "end_ms": 234310,
      "text": "这次我把丑话说，",
      "token_start": 821,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 234310,
      "end_ms": 234915,
      "text": "在前面，",
      "token_start": 828,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 235830,
      "end_ms": 237315,
      "text": "这事儿要绝对保密，",
      "token_start": 831,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 238790,
      "end_ms": 239575,
      "text": "不能发论文，",
      "token_start": 839,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 240390,
      "end_ms": 241330,
      "text": "也不能参加。",
      "token_start": 844,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 241330,
      "end_ms": 242070,
      "text": "学术会议，",
      "token_start": 849,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 242550,
      "end_ms": 243390,
      "text": "你的去向，",
      "token_start": 853,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 243410,
      "end_ms": 244650,
      "text": "连你丈夫都不能说。",
      "token_start": 857,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 245130,
      "end_ms": 246690,
      "text": "你要是接了这项羽，",
      "token_start": 865,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 246950,
      "end_ms": 251110,
      "text": "从今往后物理学家王成书就等于没了，",
      "token_start": 873,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 252830,
      "end_ms": 253870,
      "text": "年近半百，",
      "token_start": 889,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 254350,
      "end_ms": 255910,
      "text": "第二次从零开始，",
      "token_start": 893,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 256190,
      "end_ms": 258350,
      "text": "还要把名字从这世界上抹去，",
      "token_start": 900,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 258710,
      "end_ms": 259970,
      "text": "他又是那仨字，",
      "token_start": 912,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 260150,
      "end_ms": 260810,
      "text": "我愿意。",
      "token_start": 918,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 261510,
      "end_ms": 263070,
      "text": "事后他自己说过一句话，",
      "token_start": 921,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 263130,
      "end_ms": 265710,
      "text": "我建议你记住谁干都不容易。",
      "token_start": 931,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 266530,
      "end_ms": 268650,
      "text": "何况回国前我就下了决心，",
      "token_start": 943,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 269430,
      "end_ms": 271420,
      "text": "一定服从祖国的需要，",
      "token_start": 954,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 272100,
      "end_ms": 273400,
      "text": "哪怕从零开始。",
      "token_start": 963,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 274500,
      "end_ms": 275500,
      "text": "一九六二年，",
      "token_start": 969,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 275500,
      "end_ms": 276760,
      "text": "她悄悄离开北京，",
      "token_start": 974,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 277280,
      "end_ms": 279740,
      "text": "去了甘肃兰州的武陵寺厂。",
      "token_start": 981,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 279920,
      "end_ms": 283460,
      "text": "中国第一座幼童未素分离工厂，",
      "token_start": 992,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 284260,
      "end_ms": 286620,
      "text": "丈夫在外地承担国家任务，",
      "token_start": 1005,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 286860,
      "end_ms": 289800,
      "text": "儿子一个人在北京念寄宿学校，",
      "token_start": 1016,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 290240,
      "end_ms": 292360,
      "text": "一家三口天各一方。",
      "token_start": 1029,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 292740,
      "end_ms": 294580,
      "text": "一别就是好几年。",
      "token_start": 1037,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 295840,
      "end_ms": 298595,
      "text": "武陵四厂那么多科研人员。",
      "token_start": 1044,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 299240,
      "end_ms": 302900,
      "text": "她是这里面唯一的女性条件苦到什么程度，",
      "token_start": 1055,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 303140,
      "end_ms": 306720,
      "text": "全索就一台每秒十五万次的电子计算机。",
      "token_start": 1073,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 307580,
      "end_ms": 309000,
      "text": "白天大家排队用，",
      "token_start": 1090,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 309180,
      "end_ms": 312760,
      "text": "她就专挑后半夜和节假日去抢机时。",
      "token_start": 1097,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 313100,
      "end_ms": 318640,
      "text": "手摇计算机计算尺几十箱计算纸条，",
      "token_start": 1112,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 319420,
      "end_ms": 322100,
      "text": "它一张一张过目验算，",
      "token_start": 1127,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 323020,
      "end_ms": 323980,
      "text": "别人算出，",
      "token_start": 1136,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 323980,
      "end_ms": 325280,
      "text": "结果她还不满意，",
      "token_start": 1140,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 326080,
      "end_ms": 327500,
      "text": "非要你说清楚，",
      "token_start": 1147,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 327540,
      "end_ms": 328575,
      "text": "物理意义，",
      "token_start": 1153,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 329800,
      "end_ms": 333520,
      "text": "硬生生把一头黑发算成了白雪。",
      "token_start": 1157,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 333900,
      "end_ms": 335140,
      "text": "他提出了一个方案，",
      "token_start": 1170,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 335380,
      "end_ms": 338840,
      "text": "分九批启动第五批即取料，",
      "token_start": 1178,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 339140,
      "end_ms": 342200,
      "text": "直接把投产周期提前了一百一十三天。",
      "token_start": 1189,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 342440,
      "end_ms": 344940,
      "text": "一九六二年领导来视察，",
      "token_start": 1205,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 345260,
      "end_ms": 348120,
      "text": "问他能不能按时完成。",
      "token_start": 1215,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 349060,
      "end_ms": 349880,
      "text": "他说了一句，",
      "token_start": 1224,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 349880,
      "end_ms": 352420,
      "text": "后来扎进无数人心窝子的话。",
      "token_start": 1229,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 353260,
      "end_ms": 354400,
      "text": "在我的字典里，",
      "token_start": 1241,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 354820,
      "end_ms": 359375,
      "text": "除了对孩子的承诺没有兑现对国家的要求，",
      "token_start": 1247,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 359910,
      "end_ms": 361095,
      "text": "我全能兑现，",
      "token_start": 1265,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 362020,
      "end_ms": 364800,
      "text": "对得起四万万孩子就对不起自己。",
      "token_start": 1270,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 364800,
      "end_ms": 365455,
      "text": "那一个。",
      "token_start": 1284,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 366140,
      "end_ms": 368125,
      "text": "一九六四年一月十四日，",
      "token_start": 1287,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 368500,
      "end_ms": 372965,
      "text": "第一批风度百分之九十以上的合格核燃料下限，",
      "token_start": 1297,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 373600,
      "end_ms": 377555,
      "text": "中国成了世界上第五个掌握这项技术的国家。",
      "token_start": 1317,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 378210,
      "end_ms": 379870,
      "text": "同年十月十六日，",
      "token_start": 1336,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 379930,
      "end_ms": 381745,
      "text": "罗布泊内一声巨响，",
      "token_start": 1343,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 382210,
      "end_ms": 385255,
      "text": "聂荣臻向毛主席报告成功的消息。",
      "token_start": 1351,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 385540,
      "end_ms": 386385,
      "text": "毛主席说，",
      "token_start": 1365,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 386740,
      "end_ms": 390735,
      "text": "这是中国第一颗原子弹爆炸的女功臣，",
      "token_start": 1369,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 391370,
      "end_ms": 393765,
      "text": "可他连上节欢庆的资格都没有。",
      "token_start": 1385,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 394380,
      "end_ms": 394965,
      "text": "这一单，",
      "token_start": 1398,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 395250,
      "end_ms": 396605,
      "text": "他赔进去的名字，",
      "token_start": 1401,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 396940,
      "end_ms": 402195,
      "text": "家庭名誉国家赢回了原子弹的心脏第三回，",
      "token_start": 1408,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 402490,
      "end_ms": 403175,
      "text": "我愿意。",
      "token_start": 1426,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 403530,
      "end_ms": 404915,
      "text": "一九六四年之后，",
      "token_start": 1429,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 405230,
      "end_ms": 406955,
      "text": "他把余生也交了出去，",
      "token_start": 1436,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 407460,
      "end_ms": 408485,
      "text": "原子弹响了，",
      "token_start": 1445,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 408810,
      "end_ms": 412125,
      "text": "他本可以功成身退名字也可以公开了吧。",
      "token_start": 1450,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 414240,
      "end_ms": 415885,
      "text": "没有组织找到他，",
      "token_start": 1467,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 416270,
      "end_ms": 417510,
      "text": "国家还有项目，",
      "token_start": 1474,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 417510,
      "end_ms": 418475,
      "text": "要他继续干，",
      "token_start": 1480,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 419140,
      "end_ms": 420800,
      "text": "你的身份还得藏着。",
      "token_start": 1485,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 421220,
      "end_ms": 423740,
      "text": "问他这儿有什么困难，",
      "token_start": 1493,
      "token_end_exclusive": 1502
    },
    {
      "start_ms": 424460,
      "end_ms": 424940,
      "text": "没有，",
      "token_start": 1502,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 425900,
      "end_ms": 427340,
      "text": "生活上有困难，",
      "token_start": 1504,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 427340,
      "end_ms": 427740,
      "text": "没有，",
      "token_start": 1510,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 428060,
      "end_ms": 430320,
      "text": "有话要带给丈夫孩子吗？",
      "token_start": 1512,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 430640,
      "end_ms": 431160,
      "text": "没有，",
      "token_start": 1522,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 432300,
      "end_ms": 434140,
      "text": "那让你继续留下搞研究，",
      "token_start": 1524,
      "token_end_exclusive": 1534
    },
    {
      "start_ms": 434440,
      "end_ms": 435100,
      "text": "愿意吗？",
      "token_start": 1534,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 436500,
      "end_ms": 437320,
      "text": "我愿意。",
      "token_start": 1537,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 438240,
      "end_ms": 444440,
      "text": "这一留就从一九六四年留到了一九七七年才调回北京。",
      "token_start": 1540,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 445580,
      "end_ms": 446720,
      "text": "一九八零年，",
      "token_start": 1563,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 446860,
      "end_ms": 449370,
      "text": "他当选中科院学部委员。",
      "token_start": 1568,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 449930,
      "end_ms": 453810,
      "text": "可普通老百姓压根就没没听过这名字。",
      "token_start": 1578,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 453850,
      "end_ms": 458430,
      "text": "现在这这回合合起来看一个本可以去领诺贝尔奖的女人，",
      "token_start": 1594,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 458510,
      "end_ms": 460270,
      "text": "用一辈子说了三次，",
      "token_start": 1618,
      "token_end_exclusive": 1626
    },
    {
      "start_ms": 460270,
      "end_ms": 463890,
      "text": "我愿意换来中国热核巨变零的突破。",
      "token_start": 1626,
      "token_end_exclusive": 1641
    },
    {
      "start_ms": 464290,
      "end_ms": 470810,
      "text": "何然料提前一百一十三天以及一条自己从头走到底的沉默之路，",
      "token_start": 1641,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 471430,
      "end_ms": 473670,
      "text": "她有权不会用有钱，",
      "token_start": 1668,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 473710,
      "end_ms": 475170,
      "text": "不会花有福，",
      "token_start": 1676,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 475250,
      "end_ms": 475770,
      "text": "不会享。",
      "token_start": 1681,
      "token_end_exclusive": 1684
    },
    {
      "start_ms": 476630,
      "end_ms": 480815,
      "text": "这话说他是骂人的话里最重的夸耀。",
      "token_start": 1684,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 481300,
      "end_ms": 481960,
      "text": "王成书，",
      "token_start": 1699,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 481960,
      "end_ms": 486220,
      "text": "三次说我愿意的故事就写在国之脊梁。",
      "token_start": 1702,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 486220,
      "end_ms": 486985,
      "text": "这本书里，",
      "token_start": 1718,
      "token_end_exclusive": 1722
    },
    {
      "start_ms": 487960,
      "end_ms": 489220,
      "text": "书里还有四十多位，",
      "token_start": 1722,
      "token_end_exclusive": 1730
    },
    {
      "start_ms": 489220,
      "end_ms": 489805,
      "text": "像他这样，",
      "token_start": 1730,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 490830,
      "end_ms": 493705,
      "text": "国家医生召唤就毫不犹豫说我愿意的人，",
      "token_start": 1734,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 493970,
      "end_ms": 497115,
      "text": "每一位的选择都比小说还震撼。",
      "token_start": 1751,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 497610,
      "end_ms": 501545,
      "text": "有兴趣的朋友左下角链接直接带走下一集。",
      "token_start": 1764,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 501900,
      "end_ms": 502845,
      "text": "我们换个角度，",
      "token_start": 1782,
      "token_end_exclusive": 1788
    },
    {
      "start_ms": 503270,
      "end_ms": 506125,
      "text": "在全是男人的核武研制团队里，",
      "token_start": 1788,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 506600,
      "end_ms": 507815,
      "text": "她是唯一的女人。",
      "token_start": 1801,
      "token_end_exclusive": 1808
    },
    {
      "start_ms": 508240,
      "end_ms": 510965,
      "text": "这个女人用一辈子打了三次脸，",
      "token_start": 1808,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 511300,
      "end_ms": 512605,
      "text": "点赞、收藏，",
      "token_start": 1821,
      "token_end_exclusive": 1825
    },
    {
      "start_ms": 513000,
      "end_ms": 516515,
      "text": "把这条转给身边更多的人关注我，",
      "token_start": 1825,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 516760,
      "end_ms": 518235,
      "text": "咱们下一集接着讲。",
      "token_start": 1839,
      "token_end_exclusive": 1847
    }
  ],
