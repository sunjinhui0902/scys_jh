{
  "video_id": "v_b9e2a55ffcca9398",
  "duration_s": 425.367007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b9e2a55ffcca9398.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b9e2a55ffcca9398.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 770,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1010,
      "end_ms": 3030,
      "text": "咱们盘了第十到第六，",
      "token_start": 2,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3930,
      "end_ms": 6330,
      "text": "茶卡盐湖是一面镜子，",
      "token_start": 11,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 6970,
      "end_ms": 8910,
      "text": "洱海是一张成绩单。",
      "token_start": 20,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 9590,
      "end_ms": 12910,
      "text": "千岛湖是一座泡在水里的博物馆，",
      "token_start": 28,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 13610,
      "end_ms": 16930,
      "text": "赛仙湖是一个藏着秘密的深渊，",
      "token_start": 42,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 17430,
      "end_ms": 20030,
      "text": "赛里木湖是大西洋的一滴眼泪。",
      "token_start": 55,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 20810,
      "end_ms": 23190,
      "text": "好多朋友看完在评论区炒翻了。",
      "token_start": 68,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 23470,
      "end_ms": 27270,
      "text": "有人说西湖呢、青海湖呢喀纳斯湖呢？",
      "token_start": 81,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 27370,
      "end_ms": 27870,
      "text": "别急，",
      "token_start": 96,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 28330,
      "end_ms": 32200,
      "text": "今天这集就是第五道到第一一个比一个狠，",
      "token_start": 98,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 32620,
      "end_ms": 35140,
      "text": "最后那个养活了一整个高原。",
      "token_start": 116,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 35680,
      "end_ms": 36340,
      "text": "老规矩，",
      "token_start": 128,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 36640,
      "end_ms": 37540,
      "text": "开讲之前，",
      "token_start": 131,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 37800,
      "end_ms": 39860,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 135,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 40100,
      "end_ms": 43820,
      "text": "让我看看都是谁在听第五名，",
      "token_start": 145,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 44120,
      "end_ms": 45140,
      "text": "浙江西湖，",
      "token_start": 157,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 45500,
      "end_ms": 49920,
      "text": "在浙江杭州这湖最绝的不是水是人。",
      "token_start": 161,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 50600,
      "end_ms": 53580,
      "text": "白居易来过苏东坡来过他们，",
      "token_start": 176,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 53580,
      "end_ms": 54220,
      "text": "不光来看，",
      "token_start": 188,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 54400,
      "end_ms": 58960,
      "text": "还动手修白堤、苏堤都是他们带人修的。",
      "token_start": 192,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 59200,
      "end_ms": 60405,
      "text": "西湖的歌格局，",
      "token_start": 208,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 60700,
      "end_ms": 63015,
      "text": "一壶两堤三倒一池三山，",
      "token_start": 214,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 63390,
      "end_ms": 65075,
      "text": "成了中国园林的教科书。",
      "token_start": 224,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 65490,
      "end_ms": 66625,
      "text": "南宋的时候，",
      "token_start": 234,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 66920,
      "end_ms": 73645,
      "text": "评了西湖十景、苏堤春晓、断桥残雪、柳浪、文英，",
      "token_start": 239,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 73970,
      "end_ms": 75785,
      "text": "每一个井都是一首诗。",
      "token_start": 257,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 76870,
      "end_ms": 77815,
      "text": "二零一一年，",
      "token_start": 266,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 78660,
      "end_ms": 81795,
      "text": "西湖文化景观列入世界遗产名录，",
      "token_start": 271,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 82650,
      "end_ms": 87675,
      "text": "成为中国第一处以文化景观申报成功的遗产。",
      "token_start": 285,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 88070,
      "end_ms": 89435,
      "text": "别的湖美在自然，",
      "token_start": 304,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 89930,
      "end_ms": 90990,
      "text": "西湖美在人跟，",
      "token_start": 311,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 90990,
      "end_ms": 92250,
      "text": "自然一起过了。",
      "token_start": 317,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 92250,
      "end_ms": 94745,
      "text": "两千年第四名，",
      "token_start": 323,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 95580,
      "end_ms": 103275,
      "text": "西藏纳木错在西藏拉萨当雄县湖面海拔四千七百一十八米。",
      "token_start": 329,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 103600,
      "end_ms": 104780,
      "text": "藏语里纳姆。",
      "token_start": 354,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 104780,
      "end_ms": 105725,
      "text": "错的意思是，",
      "token_start": 359,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 106170,
      "end_ms": 106785,
      "text": "天湖，",
      "token_start": 364,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 107180,
      "end_ms": 108520,
      "text": "因为这湖太高了，",
      "token_start": 366,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 108520,
      "end_ms": 110550,
      "text": "高的像在天上这壶，",
      "token_start": 373,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 110590,
      "end_ms": 115860,
      "text": "最绝的是他每年冬天整面湖冻成一块巨大的冰。",
      "token_start": 381,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 116040,
      "end_ms": 119025,
      "text": "五月冰面开始裂开，",
      "token_start": 401,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 119620,
      "end_ms": 121175,
      "text": "发出轰隆隆的巨响，",
      "token_start": 409,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 122030,
      "end_ms": 123125,
      "text": "像打雷一样，",
      "token_start": 417,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 123950,
      "end_ms": 125225,
      "text": "当地人叫开壶。",
      "token_start": 422,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 126250,
      "end_ms": 127055,
      "text": "开湖那天，",
      "token_start": 428,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 127340,
      "end_ms": 129515,
      "text": "湖面上的冰一块一块裂开，",
      "token_start": 432,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 130490,
      "end_ms": 133565,
      "text": "推着挤着发出雷鸣般的声音，",
      "token_start": 443,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 133850,
      "end_ms": 137635,
      "text": "站在湖边脚下在震耳朵里全是轰响。",
      "token_start": 455,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 138100,
      "end_ms": 141300,
      "text": "您说这是湖还是老天爷在跟大地说话？",
      "token_start": 470,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 141580,
      "end_ms": 145905,
      "text": "我前阵子翻到一本叫三百六十五日走遍中国的日历书，",
      "token_start": 486,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 146550,
      "end_ms": 149630,
      "text": "左边一页是每个地方的实景大图，",
      "token_start": 509,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 149670,
      "end_ms": 152925,
      "text": "加一段五十来个字的冷知识，",
      "token_start": 523,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 153190,
      "end_ms": 154805,
      "text": "右边是日期计时页，",
      "token_start": 535,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 155230,
      "end_ms": 156985,
      "text": "什么季节去哪座湖，",
      "token_start": 543,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 157380,
      "end_ms": 158180,
      "text": "走哪条路，",
      "token_start": 551,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 158240,
      "end_ms": 159945,
      "text": "看什么风景最合适，",
      "token_start": 555,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 160310,
      "end_ms": 161515,
      "text": "都给你安排好了。",
      "token_start": 563,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 162140,
      "end_ms": 165025,
      "text": "不是那种千篇一律的景点介绍，",
      "token_start": 570,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 165660,
      "end_ms": 167135,
      "text": "是帮你挑日子。",
      "token_start": 583,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 168150,
      "end_ms": 169730,
      "text": "今天翻到纳木错，",
      "token_start": 589,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 169950,
      "end_ms": 171485,
      "text": "明天翻到喀纳斯，",
      "token_start": 596,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 171890,
      "end_ms": 173315,
      "text": "后天翻到泸沽湖，",
      "token_start": 603,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 173930,
      "end_ms": 174750,
      "text": "翻到哪页，",
      "token_start": 610,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 174810,
      "end_ms": 180590,
      "text": "就觉得那个地方在喊你我自己的习惯是每天早起翻一页当个消遣，",
      "token_start": 614,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 181190,
      "end_ms": 183990,
      "text": "翻到一个从来没听说过的小地方，",
      "token_start": 642,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 184370,
      "end_ms": 185770,
      "text": "就去网上搜搜照片，",
      "token_start": 656,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 186190,
      "end_ms": 187510,
      "text": "搜完就想订票。",
      "token_start": 664,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 187850,
      "end_ms": 189090,
      "text": "我已经放下面了，",
      "token_start": 670,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 189090,
      "end_ms": 192570,
      "text": "点开就能看到喜欢到处走走的朋友，",
      "token_start": 677,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 192690,
      "end_ms": 193890,
      "text": "弄一本放茶几。",
      "token_start": 692,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 193890,
      "end_ms": 195430,
      "text": "上一年下来，",
      "token_start": 698,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 195630,
      "end_ms": 197210,
      "text": "整个中国哪值得去，",
      "token_start": 703,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 197230,
      "end_ms": 197930,
      "text": "哪个乐曲，",
      "token_start": 711,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 198250,
      "end_ms": 199395,
      "text": "心里全有谱了。",
      "token_start": 715,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 201150,
      "end_ms": 201790,
      "text": "第三名，",
      "token_start": 721,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 202270,
      "end_ms": 207290,
      "text": "云南泸沽湖在四川盐源和云南宁确的交界处，",
      "token_start": 724,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 207610,
      "end_ms": 209490,
      "text": "湖面海拔约两千七百米。",
      "token_start": 743,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 210170,
      "end_ms": 213210,
      "text": "这湖最绝的是湖边住着一群人，",
      "token_start": 753,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 213390,
      "end_ms": 214050,
      "text": "摩梭人，",
      "token_start": 766,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 214810,
      "end_ms": 217810,
      "text": "摩梭人到现在还保留着母系大家庭。",
      "token_start": 769,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 218190,
      "end_ms": 220810,
      "text": "家里由最年长的女性当家，",
      "token_start": 784,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 221190,
      "end_ms": 224090,
      "text": "孩子跟着妈妈姓舅舅负责养家。",
      "token_start": 795,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 224250,
      "end_ms": 227330,
      "text": "走婚桥是摩梭男女约会的地方。",
      "token_start": 808,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 228270,
      "end_ms": 230805,
      "text": "泸沽湖的水面上飘着一朵花，",
      "token_start": 821,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 231360,
      "end_ms": 233040,
      "text": "叫波叶海菜，",
      "token_start": 833,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 233100,
      "end_ms": 235180,
      "text": "花白色的花瓣，",
      "token_start": 838,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 235460,
      "end_ms": 238680,
      "text": "黄色的花蕊只在干净的水里才能活。",
      "token_start": 844,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 239240,
      "end_ms": 242410,
      "text": "您坐着竹草船穿过花海船，",
      "token_start": 859,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 242410,
      "end_ms": 243725,
      "text": "底下是清清的水，",
      "token_start": 870,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 244080,
      "end_ms": 245775,
      "text": "水底下是长长的花茎。",
      "token_start": 877,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 246560,
      "end_ms": 249985,
      "text": "您说这是湖还是东方女儿国的一个梦？",
      "token_start": 886,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 251310,
      "end_ms": 251825,
      "text": "第二名，",
      "token_start": 902,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 252290,
      "end_ms": 259545,
      "text": "新疆喀纳斯湖嗯在新疆阿勒泰布尔金县湖面海拔一千三百七十四米，",
      "token_start": 905,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 260120,
      "end_ms": 262145,
      "text": "最深处一百八十八米。",
      "token_start": 934,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 262350,
      "end_ms": 264705,
      "text": "这壶最绝的是他会变色。",
      "token_start": 943,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 265550,
      "end_ms": 266315,
      "text": "同一个湖，",
      "token_start": 953,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 266540,
      "end_ms": 267865,
      "text": "早上看是青灰色，",
      "token_start": 957,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 268170,
      "end_ms": 269585,
      "text": "中午看是碧蓝色，",
      "token_start": 964,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 269910,
      "end_ms": 271195,
      "text": "下午看是翠绿色，",
      "token_start": 971,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 271520,
      "end_ms": 273725,
      "text": "傍晚看又变成了暗紫色，",
      "token_start": 978,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 274010,
      "end_ms": 275065,
      "text": "所以叫变色壶。",
      "token_start": 988,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 275510,
      "end_ms": 276605,
      "text": "为什么变色？",
      "token_start": 994,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 277160,
      "end_ms": 280670,
      "text": "因为湖水来自冰川水里，",
      "token_start": 999,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 280670,
      "end_ms": 282135,
      "text": "含着不同的矿物质，",
      "token_start": 1009,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 282720,
      "end_ms": 284415,
      "text": "加上光线角度不同，",
      "token_start": 1017,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 284750,
      "end_ms": 286730,
      "text": "水就跟着变更。",
      "token_start": 1025,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 286750,
      "end_ms": 287985,
      "text": "邪乎的是水怪。",
      "token_start": 1031,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 288860,
      "end_ms": 290375,
      "text": "当地人传了好几代，",
      "token_start": 1037,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 290800,
      "end_ms": 291020,
      "text": "说，",
      "token_start": 1045,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 291020,
      "end_ms": 292035,
      "text": "狐狸有巨兽，",
      "token_start": 1046,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 292540,
      "end_ms": 294945,
      "text": "能把湖边喝水的马拖下水。",
      "token_start": 1051,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 295920,
      "end_ms": 298840,
      "text": "科考队用环境DNA技术检测，",
      "token_start": 1062,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 299120,
      "end_ms": 303280,
      "text": "发现湖里有巨大的折罗龟能长到好几米，",
      "token_start": 1073,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 303600,
      "end_ms": 305120,
      "text": "可到底有没有水怪？",
      "token_start": 1090,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 305600,
      "end_ms": 307520,
      "text": "到现在没人说得清。",
      "token_start": 1098,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 307820,
      "end_ms": 309920,
      "text": "一池湖水一个传说，",
      "token_start": 1106,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 310280,
      "end_ms": 312600,
      "text": "勾了全世界几十年的好奇心。",
      "token_start": 1114,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 313060,
      "end_ms": 313620,
      "text": "第一名。",
      "token_start": 1126,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 313860,
      "end_ms": 317460,
      "text": "青海湖在青海、海南和海北之间，",
      "token_start": 1129,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 317740,
      "end_ms": 320260,
      "text": "湖面四千六百五十平方公里，",
      "token_start": 1142,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 320680,
      "end_ms": 323500,
      "text": "中国最大的内陆咸水湖。",
      "token_start": 1154,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 324060,
      "end_ms": 326230,
      "text": "这湖最绝的不是大，",
      "token_start": 1164,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 326590,
      "end_ms": 328790,
      "text": "是他养活了半个高原的生命。",
      "token_start": 1172,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 329370,
      "end_ms": 331790,
      "text": "青海湖罗里就是筛鱼，",
      "token_start": 1184,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 332210,
      "end_ms": 336150,
      "text": "资源量从二零零二年的两千五百多吨，",
      "token_start": 1193,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 336270,
      "end_ms": 338850,
      "text": "恢复到了现在的十二万多吨。",
      "token_start": 1209,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 339690,
      "end_ms": 340690,
      "text": "俯世园林，",
      "token_start": 1221,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 341370,
      "end_ms": 344290,
      "text": "全世界只剩几千只大半，",
      "token_start": 1225,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 344290,
      "end_ms": 348950,
      "text": "在青海湖边数量增加到了三千七百多只。",
      "token_start": 1235,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 349810,
      "end_ms": 353630,
      "text": "每年有六十多万只水鸟飞到青海湖，",
      "token_start": 1252,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 353910,
      "end_ms": 355485,
      "text": "有三百多种鸟。",
      "token_start": 1267,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 356430,
      "end_ms": 357835,
      "text": "您站在湖边看，",
      "token_start": 1273,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 358690,
      "end_ms": 360045,
      "text": "天上飞的是鸟，",
      "token_start": 1279,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 360750,
      "end_ms": 362065,
      "text": "水里游的是鱼，",
      "token_start": 1285,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 362900,
      "end_ms": 364995,
      "text": "草原上跑的是羚羊，",
      "token_start": 1291,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 365870,
      "end_ms": 366515,
      "text": "一个湖，",
      "token_start": 1299,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 367430,
      "end_ms": 369925,
      "text": "撑起了一整个高原的生态。",
      "token_start": 1302,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 370400,
      "end_ms": 371905,
      "text": "别的湖美在颜色，",
      "token_start": 1313,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 372430,
      "end_ms": 373765,
      "text": "青海湖美在，",
      "token_start": 1320,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 374140,
      "end_ms": 376725,
      "text": "他是以整个高原的生命之源。",
      "token_start": 1325,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 378410,
      "end_ms": 380455,
      "text": "您说这个第一名服不服？",
      "token_start": 1337,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 380760,
      "end_ms": 381775,
      "text": "您听出来了没有？",
      "token_start": 1347,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 382230,
      "end_ms": 386375,
      "text": "这十个湖没有一个是因为好看才排上来的。",
      "token_start": 1354,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 386960,
      "end_ms": 389055,
      "text": "茶卡盐湖靠的是一面镜子，",
      "token_start": 1372,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 389570,
      "end_ms": 390790,
      "text": "洱海靠的是水，",
      "token_start": 1383,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 390930,
      "end_ms": 391915,
      "text": "越来越干净。",
      "token_start": 1389,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 392550,
      "end_ms": 395425,
      "text": "千岛湖靠的是一座泡在水里的博物馆。",
      "token_start": 1394,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 395950,
      "end_ms": 398095,
      "text": "抚仙湖靠的是一个深渊，",
      "token_start": 1410,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 398710,
      "end_ms": 401755,
      "text": "赛里木湖靠的是大西洋的一滴眼泪。",
      "token_start": 1420,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 402430,
      "end_ms": 405365,
      "text": "西湖靠的是人跟自然过了两千年，",
      "token_start": 1435,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 406070,
      "end_ms": 408355,
      "text": "纳木错靠的是老天爷在说话。",
      "token_start": 1449,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 408860,
      "end_ms": 411045,
      "text": "泸沽湖靠的是东方女儿国，",
      "token_start": 1461,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 411540,
      "end_ms": 414220,
      "text": "喀纳斯湖靠的是变色和水怪。",
      "token_start": 1472,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 414380,
      "end_ms": 417235,
      "text": "青海湖靠的是养活了一整个高原，",
      "token_start": 1484,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 418050,
      "end_ms": 421115,
      "text": "每一个湖的厉害之处都不在他有多难，",
      "token_start": 1498,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 421480,
      "end_ms": 423435,
      "text": "在他有多厚点个关注，",
      "token_start": 1514,
      "token_end_exclusive": 1523
    },
    {
      "start_ms": 423760,
      "end_ms": 425265,
      "text": "咱们下期接着聊。",
      "token_start": 1523,
      "token_end_exclusive": 1530
    }
  ],
