{
  "video_id": "v_3a99cb8f56df9807",
  "duration_s": 230.876009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_3a99cb8f56df9807.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_3a99cb8f56df9807.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 590,
      "text": "从前，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 610,
      "end_ms": 3810,
      "text": "有个在码头扛大包过活的穷汉子，",
      "token_start": 2,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4130,
      "end_ms": 6210,
      "text": "住在城东漏雨的窝棚里，",
      "token_start": 16,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6490,
      "end_ms": 8530,
      "text": "天天天不亮就爬起来干活，",
      "token_start": 26,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 8770,
      "end_ms": 10150,
      "text": "累得腰都直不起来，",
      "token_start": 37,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 10690,
      "end_ms": 13050,
      "text": "可一家老小还是吃了上顿愁，",
      "token_start": 45,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 13050,
      "end_ms": 13570,
      "text": "下顿。",
      "token_start": 57,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 14150,
      "end_ms": 16490,
      "text": "他瞅着城里那个开粮铺的东家，",
      "token_start": 59,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 16970,
      "end_ms": 19430,
      "text": "天天坐在柜台后头喝茶算账，",
      "token_start": 72,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 19810,
      "end_ms": 21350,
      "text": "手指头都不用沾灰，",
      "token_start": 84,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 21650,
      "end_ms": 23190,
      "text": "银子却哗哗往里流。",
      "token_start": 92,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 24050,
      "end_ms": 26010,
      "text": "他心里越琢磨越窝火，",
      "token_start": 100,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 26430,
      "end_ms": 28350,
      "text": "觉着这老天爷太偏心了。",
      "token_start": 109,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 29230,
      "end_ms": 30000,
      "text": "这天夜里，",
      "token_start": 119,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 30940,
      "end_ms": 33040,
      "text": "穷汉子跪在土地庙跟前，",
      "token_start": 123,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 33100,
      "end_ms": 35300,
      "text": "哭诉一把鼻涕一把泪的说，",
      "token_start": 133,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 35300,
      "end_ms": 36040,
      "text": "自个儿命苦。",
      "token_start": 144,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 36700,
      "end_ms": 37420,
      "text": "没成想，",
      "token_start": 149,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 37420,
      "end_ms": 41640,
      "text": "真把巡夜的土地爷给惊动了土地爷笑呵呵，",
      "token_start": 152,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 41640,
      "end_ms": 42040,
      "text": "问他，",
      "token_start": 170,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 42980,
      "end_ms": 44840,
      "text": "那你说咋样才算公平？",
      "token_start": 172,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 45780,
      "end_ms": 47420,
      "text": "穷汉子磕头如捣蒜，",
      "token_start": 181,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 47900,
      "end_ms": 48740,
      "text": "求土地爷，",
      "token_start": 189,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 48980,
      "end_ms": 53240,
      "text": "把那个粮铺东家变得跟我一样穷干一样的活，",
      "token_start": 193,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 54100,
      "end_ms": 55500,
      "text": "他要是还能翻身，",
      "token_start": 212,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 55920,
      "end_ms": 57840,
      "text": "我这辈子再也不吭一声。",
      "token_start": 219,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 58920,
      "end_ms": 60285,
      "text": "土地爷点了点头，",
      "token_start": 229,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 60570,
      "end_ms": 61225,
      "text": "一挥手，",
      "token_start": 236,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 61790,
      "end_ms": 66170,
      "text": "那梁甫东家转眼就变成了跟穷汉子一模一样的打扮。",
      "token_start": 239,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 66230,
      "end_ms": 68305,
      "text": "破衣烂衫兜里比脸还干净，",
      "token_start": 261,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 68710,
      "end_ms": 70905,
      "text": "土地爷又给俩人各分了一座荒山。",
      "token_start": 272,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 71150,
      "end_ms": 71785,
      "text": "吩咐道，",
      "token_start": 286,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 72410,
      "end_ms": 73715,
      "text": "这山里有铁矿，",
      "token_start": 289,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 74080,
      "end_ms": 75240,
      "text": "你俩每天挖了矿，",
      "token_start": 295,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 75480,
      "end_ms": 76900,
      "text": "扛到镇上铁匠铺，",
      "token_start": 302,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 76920,
      "end_ms": 77745,
      "text": "卖了换钱。",
      "token_start": 309,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 78350,
      "end_ms": 79335,
      "text": "一个月之内，",
      "token_start": 313,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 79710,
      "end_ms": 82290,
      "text": "谁先把山上的铁矿石挖完，",
      "token_start": 318,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 82290,
      "end_ms": 82905,
      "text": "卖光，",
      "token_start": 329,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 83370,
      "end_ms": 85025,
      "text": "谁就能得到我指点。",
      "token_start": 331,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 85790,
      "end_ms": 87745,
      "text": "往后的财运不用愁，",
      "token_start": 339,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 88750,
      "end_ms": 90685,
      "text": "穷汉子扛大包出身，",
      "token_start": 347,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 91020,
      "end_ms": 91835,
      "text": "力气大的很，",
      "token_start": 355,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 92340,
      "end_ms": 94405,
      "text": "挖矿对他来说不算啥。",
      "token_start": 360,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 94910,
      "end_ms": 95510,
      "text": "头一天，",
      "token_start": 369,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 95510,
      "end_ms": 97815,
      "text": "他就挖了满满两筐铁矿，",
      "token_start": 372,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 98250,
      "end_ms": 99910,
      "text": "扛到镇上铁匠铺，",
      "token_start": 382,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 99910,
      "end_ms": 101290,
      "text": "换了几块碎银子，",
      "token_start": 389,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 101390,
      "end_ms": 103845,
      "text": "转头就全买了白面和大肉，",
      "token_start": 396,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 104180,
      "end_ms": 107495,
      "text": "回家给婆娘娃娃炖了一锅喷香的肉汤。",
      "token_start": 407,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 107980,
      "end_ms": 111525,
      "text": "那梁铺东家细皮嫩肉的从没干过重活，",
      "token_start": 423,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 111970,
      "end_ms": 113070,
      "text": "抡了几下镐头，",
      "token_start": 439,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 113090,
      "end_ms": 115005,
      "text": "手心就磨出了血泡，",
      "token_start": 445,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 115540,
      "end_ms": 117305,
      "text": "气喘吁吁歇了好几回，",
      "token_start": 453,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 118080,
      "end_ms": 121615,
      "text": "天黑透才勉强凑够一筐矿。",
      "token_start": 462,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 122460,
      "end_ms": 123700,
      "text": "换了碎银子以后，",
      "token_start": 473,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 123700,
      "end_ms": 125095,
      "text": "他没敢大手大脚，",
      "token_start": 480,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 125820,
      "end_ms": 127905,
      "text": "只买了几个窝窝头垫肚子，",
      "token_start": 487,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 128700,
      "end_ms": 130280,
      "text": "剩下的钱一文没动，",
      "token_start": 498,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 130420,
      "end_ms": 131245,
      "text": "揣了起来。",
      "token_start": 506,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 131750,
      "end_ms": 132550,
      "text": "第二天一早，",
      "token_start": 510,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 132710,
      "end_ms": 135370,
      "text": "穷汉子又吭哧吭哧上山挖矿去了。",
      "token_start": 515,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 135370,
      "end_ms": 137070,
      "text": "心里光想着多挖点，",
      "token_start": 529,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 137090,
      "end_ms": 138335,
      "text": "多换点好吃的。",
      "token_start": 537,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 139020,
      "end_ms": 141200,
      "text": "可那粮铺东家压根儿没上山，",
      "token_start": 543,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 141460,
      "end_ms": 143985,
      "text": "反而揣着昨天省下的碎银子，",
      "token_start": 555,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 144430,
      "end_ms": 147810,
      "text": "跑到镇上找了两个闲汉给他们工钱，",
      "token_start": 567,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 147930,
      "end_ms": 148995,
      "text": "让帮忙挖矿。",
      "token_start": 582,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 149550,
      "end_ms": 151030,
      "text": "他自己搬了个小马扎，",
      "token_start": 587,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 151150,
      "end_ms": 153690,
      "text": "坐在树底下时不时吆喝两声，",
      "token_start": 596,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 153690,
      "end_ms": 154555,
      "text": "指点几句，",
      "token_start": 608,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 154960,
      "end_ms": 156355,
      "text": "一点力气都不用出，",
      "token_start": 612,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 156910,
      "end_ms": 158345,
      "text": "就一上午的功夫，",
      "token_start": 620,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 158800,
      "end_ms": 161340,
      "text": "两个咸汉就挖了满满六大筐，",
      "token_start": 627,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 161340,
      "end_ms": 165440,
      "text": "铁矿石东家拉着矿石去铁匠铺卖掉，",
      "token_start": 639,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 165780,
      "end_ms": 168475,
      "text": "转头又雇了四个壮劳力。",
      "token_start": 654,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 169750,
      "end_ms": 170570,
      "text": "一天下来，",
      "token_start": 664,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 170710,
      "end_ms": 172625,
      "text": "刨去给工人们的工钱。",
      "token_start": 668,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 172920,
      "end_ms": 177965,
      "text": "他兜里剩的银子比穷汉子累死累活挖一天矿赚的还多出好几倍。",
      "token_start": 677,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 178400,
      "end_ms": 180245,
      "text": "一个月眨眼就过完了，",
      "token_start": 704,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 180630,
      "end_ms": 182470,
      "text": "穷汉子天天挖矿换钱，",
      "token_start": 713,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 182470,
      "end_ms": 183195,
      "text": "买吃的，",
      "token_start": 722,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 183690,
      "end_ms": 185595,
      "text": "手里几乎没存下啥余钱，",
      "token_start": 725,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 186120,
      "end_ms": 188235,
      "text": "山上的铁矿才挖了一小脚。",
      "token_start": 735,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 189020,
      "end_ms": 192045,
      "text": "可能梁浦东家呢早就靠雇人，",
      "token_start": 746,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 192450,
      "end_ms": 195525,
      "text": "把整座山的铁矿挖的干干净净，",
      "token_start": 758,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 195820,
      "end_ms": 196995,
      "text": "赚了一大笔钱，",
      "token_start": 771,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 197470,
      "end_ms": 199795,
      "text": "拿着钱在镇上盘了间铺面，",
      "token_start": 777,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 200310,
      "end_ms": 202345,
      "text": "倒腾起铁器买卖来了。",
      "token_start": 788,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 203240,
      "end_ms": 204275,
      "text": "没过多久，",
      "token_start": 797,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 205010,
      "end_ms": 206375,
      "text": "又成了有钱人，",
      "token_start": 801,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 206640,
      "end_ms": 207240,
      "text": "穷汉子，",
      "token_start": 807,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 207240,
      "end_ms": 208135,
      "text": "瞅着这一切，",
      "token_start": 810,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 208550,
      "end_ms": 209370,
      "text": "再也不抱怨，",
      "token_start": 815,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 209370,
      "end_ms": 210285,
      "text": "老天不公了。",
      "token_start": 820,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 211010,
      "end_ms": 215480,
      "text": "这个故事告诉咱们富人富在脑子不再力气，",
      "token_start": 825,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 215680,
      "end_ms": 220035,
      "text": "真正的大钱从来不是靠死干硬干政来的，",
      "token_start": 843,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 220630,
      "end_ms": 223205,
      "text": "是靠你的想法和眼界赚来的。",
      "token_start": 860,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 223780,
      "end_ms": 225005,
      "text": "人穷不可怕，",
      "token_start": 872,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 225400,
      "end_ms": 228510,
      "text": "可怕的是脑子穷人穷穷，",
      "token_start": 877,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 228510,
      "end_ms": 230725,
      "text": "一时脑子穷穷一世。",
      "token_start": 887,
      "token_end_exclusive": 895
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
