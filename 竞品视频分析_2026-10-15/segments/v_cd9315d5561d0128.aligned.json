{
  "video_id": "v_cd9315d5561d0128",
  "duration_s": 273.367007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_cd9315d5561d0128.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_cd9315d5561d0128.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 510,
      "text": "小李，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 710,
      "end_ms": 3230,
      "text": "你把我后备箱里的茅台拿上去好的，",
      "token_start": 2,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 3230,
      "end_ms": 3590,
      "text": "赵总，",
      "token_start": 17,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4630,
      "end_ms": 5490,
      "text": "领导的暗示，",
      "token_start": 19,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5490,
      "end_ms": 6625,
      "text": "你能听得懂吗？",
      "token_start": 24,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 9980,
      "end_ms": 10660,
      "text": "没有啊，",
      "token_start": 30,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 11460,
      "end_ms": 14000,
      "text": "哎他被偷你干什么？",
      "token_start": 33,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 14320,
      "end_ms": 14680,
      "text": "赵总，",
      "token_start": 41,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 14680,
      "end_ms": 15460,
      "text": "茅台都被偷了，",
      "token_start": 43,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 15460,
      "end_ms": 16460,
      "text": "你为什么不让说呀？",
      "token_start": 49,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 16520,
      "end_ms": 18360,
      "text": "赵总能不知道车里有没有酒吗？",
      "token_start": 57,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 19640,
      "end_ms": 19980,
      "text": "不是，",
      "token_start": 70,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 19980,
      "end_ms": 21600,
      "text": "这职场上，",
      "token_start": 72,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 21600,
      "end_ms": 23500,
      "text": "李慧错领导的意思是大忌，",
      "token_start": 76,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 23980,
      "end_ms": 24880,
      "text": "车里没有酒。",
      "token_start": 87,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25080,
      "end_ms": 26500,
      "text": "赵总却让你送上去，",
      "token_start": 92,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 26540,
      "end_ms": 27940,
      "text": "说明他只在意结果，",
      "token_start": 100,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 28300,
      "end_ms": 31280,
      "text": "你又何必去纠结车里酒的去向和真实性呢？",
      "token_start": 108,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 31600,
      "end_ms": 32980,
      "text": "满足领导的需求最重要。",
      "token_start": 126,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 32980,
      "end_ms": 33220,
      "text": "哦，",
      "token_start": 136,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 37870,
      "end_ms": 38290,
      "text": "赵总，",
      "token_start": 137,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 38690,
      "end_ms": 39730,
      "text": "您车里的东西呢，",
      "token_start": 139,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 39730,
      "end_ms": 40550,
      "text": "我不好乱翻，",
      "token_start": 146,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 40750,
      "end_ms": 41490,
      "text": "就自己准备了。",
      "token_start": 151,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 41490,
      "end_ms": 43210,
      "text": "四瓶两瓶留在您车里了，",
      "token_start": 157,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 43210,
      "end_ms": 44765,
      "text": "这两瓶拿上来您先用。",
      "token_start": 167,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 52820,
      "end_ms": 53240,
      "text": "赵总，",
      "token_start": 176,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 53480,
      "end_ms": 54520,
      "text": "咱们下次见啊。",
      "token_start": 178,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 54520,
      "end_ms": 54960,
      "text": "哎好，",
      "token_start": 184,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 55920,
      "end_ms": 56160,
      "text": "哎，",
      "token_start": 186,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 56600,
      "end_ms": 56940,
      "text": "刘总，",
      "token_start": 187,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 56940,
      "end_ms": 57720,
      "text": "你怎么走了呀，",
      "token_start": 189,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 57720,
      "end_ms": 59060,
      "text": "是不是嫌报价不满意啊？",
      "token_start": 195,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 59160,
      "end_ms": 61035,
      "text": "哼哎，",
      "token_start": 205,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 61800,
      "end_ms": 62840,
      "text": "好吧对，",
      "token_start": 207,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 63190,
      "end_ms": 63870,
      "text": "恭喜赵总，",
      "token_start": 210,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 63870,
      "end_ms": 65465,
      "text": "拿下合同小李，",
      "token_start": 214,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 65960,
      "end_ms": 67205,
      "text": "后续你来负责吧。",
      "token_start": 220,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 67810,
      "end_ms": 68050,
      "text": "哎，",
      "token_start": 227,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 68070,
      "end_ms": 68510,
      "text": "赵总哎，",
      "token_start": 228,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 68510,
      "end_ms": 71055,
      "text": "这哎，",
      "token_start": 231,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 71330,
      "end_ms": 72550,
      "text": "这赵总这怎么回事啊？",
      "token_start": 233,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 72750,
      "end_ms": 74275,
      "text": "这个项目一直是大刘在负责，",
      "token_start": 242,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 74630,
      "end_ms": 75795,
      "text": "赵总突然把枪给我了。",
      "token_start": 254,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 76310,
      "end_ms": 78670,
      "text": "茶汤回湖是谈判的收尾动作，",
      "token_start": 263,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 79030,
      "end_ms": 80295,
      "text": "象征着交易达成。",
      "token_start": 275,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 80650,
      "end_ms": 81945,
      "text": "大刘连这个都不懂，",
      "token_start": 282,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 82260,
      "end_ms": 84225,
      "text": "赵总怎么敢把项目交给他呀？",
      "token_start": 290,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 84650,
      "end_ms": 85535,
      "text": "不能吧，",
      "token_start": 302,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 86050,
      "end_ms": 86910,
      "text": "人情世故，",
      "token_start": 305,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 86990,
      "end_ms": 88035,
      "text": "可是门大学问，",
      "token_start": 309,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 88550,
      "end_ms": 89450,
      "text": "你要学的呀，",
      "token_start": 315,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 89510,
      "end_ms": 90335,
      "text": "还多着呢。",
      "token_start": 320,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 92400,
      "end_ms": 92905,
      "text": "老婆，",
      "token_start": 324,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 93420,
      "end_ms": 93580,
      "text": "赵，",
      "token_start": 326,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 93580,
      "end_ms": 94955,
      "text": "总把上次酒钱转过来了，",
      "token_start": 327,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 95130,
      "end_ms": 97525,
      "text": "看嘿，",
      "token_start": 337,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 97830,
      "end_ms": 98570,
      "text": "你怎么收了呀？",
      "token_start": 339,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 98610,
      "end_ms": 99390,
      "text": "赵总转多了，",
      "token_start": 345,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 99390,
      "end_ms": 100475,
      "text": "你赶紧给他退回去，",
      "token_start": 350,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 100830,
      "end_ms": 102570,
      "text": "你自为有原则的退回，",
      "token_start": 358,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 102770,
      "end_ms": 104205,
      "text": "只会让领导觉得麻烦，",
      "token_start": 367,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 104560,
      "end_ms": 106205,
      "text": "还不如大大方方收下呢。",
      "token_start": 376,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 108670,
      "end_ms": 110285,
      "text": "那我是不是得说点啥呀，",
      "token_start": 386,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 110560,
      "end_ms": 111780,
      "text": "你就说感谢领导，",
      "token_start": 396,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 111780,
      "end_ms": 112200,
      "text": "大气，",
      "token_start": 403,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 112280,
      "end_ms": 113775,
      "text": "果然跟着领导有甜头吃，",
      "token_start": 405,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 114300,
      "end_ms": 115145,
      "text": "就这样就行了。",
      "token_start": 415,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 115640,
      "end_ms": 116705,
      "text": "当那不行啊，",
      "token_start": 421,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 119070,
      "end_ms": 119530,
      "text": "赵总，",
      "token_start": 426,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 119590,
      "end_ms": 120510,
      "text": "请大家喝奶茶啦，",
      "token_start": 428,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 120530,
      "end_ms": 121150,
      "text": "人人都有。",
      "token_start": 435,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 126040,
      "end_ms": 127725,
      "text": "我什么时候请大家喝奶茶了？",
      "token_start": 439,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 128040,
      "end_ms": 128560,
      "text": "奶茶钱，",
      "token_start": 451,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 128700,
      "end_ms": 130655,
      "text": "您不是跟着酒钱一块转给我了吗？",
      "token_start": 454,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 131940,
      "end_ms": 132225,
      "text": "哎，",
      "token_start": 468,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 133420,
      "end_ms": 136065,
      "text": "小李周天来家里坐坐，",
      "token_start": 469,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 136500,
      "end_ms": 139355,
      "text": "尝尝你嫂子的手艺好好的。",
      "token_start": 478,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 143380,
      "end_ms": 143620,
      "text": "哎，",
      "token_start": 489,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 143900,
      "end_ms": 144240,
      "text": "嫂子，",
      "token_start": 490,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 144240,
      "end_ms": 145060,
      "text": "你可算出来了，",
      "token_start": 492,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 145060,
      "end_ms": 146035,
      "text": "我都快憋死了，",
      "token_start": 498,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 146350,
      "end_ms": 147210,
      "text": "你拉我干什么？",
      "token_start": 504,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 147210,
      "end_ms": 148050,
      "text": "我也很急啊，",
      "token_start": 510,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 148050,
      "end_ms": 148810,
      "text": "憋死了，",
      "token_start": 515,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 148910,
      "end_ms": 152265,
      "text": "不知道的还以为洗手间是什么好地方。",
      "token_start": 518,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 152760,
      "end_ms": 153120,
      "text": "哎呀，",
      "token_start": 534,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 153120,
      "end_ms": 153645,
      "text": "行了，",
      "token_start": 536,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 153980,
      "end_ms": 155005,
      "text": "你们坐我去做饭，",
      "token_start": 538,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 155310,
      "end_ms": 156495,
      "text": "老赵帮我出了一下鱼。",
      "token_start": 545,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 157450,
      "end_ms": 157875,
      "text": "老婆，",
      "token_start": 554,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 158210,
      "end_ms": 158915,
      "text": "我怎么看？",
      "token_start": 556,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 159420,
      "end_ms": 160875,
      "text": "赵总和嫂子有点不高兴，",
      "token_start": 560,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 161180,
      "end_ms": 162985,
      "text": "因为异性厕所十分钟效应，",
      "token_start": 570,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 163300,
      "end_ms": 163560,
      "text": "人家。",
      "token_start": 581,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 163560,
      "end_ms": 163840,
      "text": "赵总，",
      "token_start": 583,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 163840,
      "end_ms": 165260,
      "text": "老婆刚从卫生间出来，",
      "token_start": 585,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 165260,
      "end_ms": 165940,
      "text": "你就是再着急，",
      "token_start": 594,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 165940,
      "end_ms": 168545,
      "text": "你等十分钟再怎么可能是因为这个呀，",
      "token_start": 600,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 169160,
      "end_ms": 170135,
      "text": "你照做就行，",
      "token_start": 616,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 171310,
      "end_ms": 171630,
      "text": "嫂子，",
      "token_start": 621,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 171630,
      "end_ms": 172315,
      "text": "我来帮你。",
      "token_start": 623,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 173980,
      "end_ms": 174820,
      "text": "赵总嫂子，",
      "token_start": 627,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 174960,
      "end_ms": 175585,
      "text": "那我走了，",
      "token_start": 631,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 176240,
      "end_ms": 178605,
      "text": "那我们也先走嗯嗯，",
      "token_start": 635,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 180020,
      "end_ms": 182180,
      "text": "小李留下接待王总的事情，",
      "token_start": 643,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 182180,
      "end_ms": 183000,
      "text": "咱们再碰一下，",
      "token_start": 654,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 183260,
      "end_ms": 184535,
      "text": "那得叫小张回来啊，",
      "token_start": 660,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 186900,
      "end_ms": 189080,
      "text": "不用你来负责就行。",
      "token_start": 668,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 190280,
      "end_ms": 190720,
      "text": "好的，",
      "token_start": 676,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 190720,
      "end_ms": 191120,
      "text": "赵总，",
      "token_start": 678,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 191480,
      "end_ms": 191720,
      "text": "哎，",
      "token_start": 680,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 191800,
      "end_ms": 192200,
      "text": "老婆，",
      "token_start": 681,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 192400,
      "end_ms": 194780,
      "text": "你这个厕所十分钟效应还真有说法，",
      "token_start": 683,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 194900,
      "end_ms": 196520,
      "text": "这都是不成文的社交规则。",
      "token_start": 698,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 196660,
      "end_ms": 199440,
      "text": "你呀多看看这本把话说的恰到好处。",
      "token_start": 709,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 199740,
      "end_ms": 200880,
      "text": "假如你不爱说话，",
      "token_start": 724,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 200880,
      "end_ms": 201540,
      "text": "不爱争辩，",
      "token_start": 731,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 201680,
      "end_ms": 202500,
      "text": "也不爱出门，",
      "token_start": 735,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 202700,
      "end_ms": 203760,
      "text": "甚至恐惧社交，",
      "token_start": 740,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 203940,
      "end_ms": 205080,
      "text": "你就每天看两页，",
      "token_start": 746,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 205220,
      "end_ms": 206520,
      "text": "每一个场景慢慢练，",
      "token_start": 753,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 206680,
      "end_ms": 210060,
      "text": "你也会变成一个会说话的人我当时听到这句话的时候，",
      "token_start": 761,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 210060,
      "end_ms": 211240,
      "text": "我的眼泪就出来了。",
      "token_start": 784,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 211260,
      "end_ms": 212860,
      "text": "他写的是别人夸你优秀，",
      "token_start": 792,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 212980,
      "end_ms": 213520,
      "text": "你就回，",
      "token_start": 802,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 213720,
      "end_ms": 214640,
      "text": "那是不优秀点，",
      "token_start": 805,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 214760,
      "end_ms": 215900,
      "text": "怎么能和你做朋友？",
      "token_start": 811,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 216040,
      "end_ms": 217190,
      "text": "你看很有味道，",
      "token_start": 819,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 217290,
      "end_ms": 218250,
      "text": "假如不爱说话，",
      "token_start": 825,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 218270,
      "end_ms": 218970,
      "text": "不爱争辩，",
      "token_start": 831,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 218970,
      "end_ms": 219750,
      "text": "也不爱出门，",
      "token_start": 835,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 219930,
      "end_ms": 220950,
      "text": "甚至恐惧社交，",
      "token_start": 840,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 221090,
      "end_ms": 222210,
      "text": "你每天就看两页，",
      "token_start": 846,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 222310,
      "end_ms": 223510,
      "text": "每一个场景慢慢练，",
      "token_start": 853,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 223650,
      "end_ms": 225870,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 861,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 225990,
      "end_ms": 226230,
      "text": "哇，",
      "token_start": 876,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 226430,
      "end_ms": 227530,
      "text": "这真是太棒了。",
      "token_start": 877,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 227610,
      "end_ms": 228490,
      "text": "在这本书里边，",
      "token_start": 883,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 228490,
      "end_ms": 229010,
      "text": "有一句话，",
      "token_start": 889,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 229010,
      "end_ms": 229790,
      "text": "我特别欣赏。",
      "token_start": 893,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 229930,
      "end_ms": 231530,
      "text": "他说有人嘲讽你眼睛小，",
      "token_start": 898,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 231610,
      "end_ms": 232550,
      "text": "高情商回答，",
      "token_start": 908,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 232650,
      "end_ms": 233750,
      "text": "万物皆有裂痕，",
      "token_start": 913,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 233830,
      "end_ms": 235230,
      "text": "那是光照进来的地方。",
      "token_start": 919,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 235290,
      "end_ms": 235530,
      "text": "哇，",
      "token_start": 928,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 235550,
      "end_ms": 236610,
      "text": "这真是太棒了，",
      "token_start": 929,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 236610,
      "end_ms": 237810,
      "text": "每一句都很有意思，",
      "token_start": 935,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 237950,
      "end_ms": 238490,
      "text": "随便翻，",
      "token_start": 943,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 238490,
      "end_ms": 238870,
      "text": "对吧？",
      "token_start": 946,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 238870,
      "end_ms": 239110,
      "text": "哇，",
      "token_start": 948,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 239230,
      "end_ms": 240235,
      "text": "这句话太好了，",
      "token_start": 949,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 240410,
      "end_ms": 242395,
      "text": "他写的是别人问你一个月工资多少，",
      "token_start": 955,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 242640,
      "end_ms": 243920,
      "text": "你就会比以前好多了。",
      "token_start": 970,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 243940,
      "end_ms": 245615,
      "text": "现在吃泡面敢放两根肠了。",
      "token_start": 979,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 245810,
      "end_ms": 246930,
      "text": "我读到这段的时候，",
      "token_start": 990,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 247010,
      "end_ms": 248950,
      "text": "我觉得这个让我真是一解心开啊，",
      "token_start": 998,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 248970,
      "end_ms": 250630,
      "text": "这本书就像是个社交宝典，",
      "token_start": 1012,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 250750,
      "end_ms": 253670,
      "text": "把各种社交场景都变成了问题加答案的形式。",
      "token_start": 1023,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 253789,
      "end_ms": 256235,
      "text": "你说哪家的书架上不应该有一本这个书，",
      "token_start": 1042,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 256520,
      "end_ms": 259700,
      "text": "就是手把手的教我们不同的场景之下应该怎么说？",
      "token_start": 1059,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 259900,
      "end_ms": 262660,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1080,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 262660,
      "end_ms": 263860,
      "text": "你就放心拿回去看，",
      "token_start": 1098,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 263920,
      "end_ms": 265160,
      "text": "就是一句一句的教你，",
      "token_start": 1106,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 265240,
      "end_ms": 267740,
      "text": "这是我这几年来讲过的最简单的一本书。",
      "token_start": 1115,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 268000,
      "end_ms": 269580,
      "text": "我觉得这书适合所有人，",
      "token_start": 1132,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 269600,
      "end_ms": 272160,
      "text": "让你不管在任何场合都能够轻松拿捏。",
      "token_start": 1142,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 272320,
      "end_ms": 273265,
      "text": "所以强烈推荐。",
      "token_start": 1158,
      "token_end_exclusive": 1164
    }
