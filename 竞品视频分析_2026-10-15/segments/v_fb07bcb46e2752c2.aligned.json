{
  "video_id": "v_fb07bcb46e2752c2",
  "duration_s": 316.672993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_fb07bcb46e2752c2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_fb07bcb46e2752c2.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2790,
      "text": "上集说到二零零八年，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2830,
      "end_ms": 6450,
      "text": "北京奥运郎平带美国队赢了中国队，",
      "token_start": 9,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6770,
      "end_ms": 9610,
      "text": "被全中国骂成吃里扒外。",
      "token_start": 24,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 10190,
      "end_ms": 13270,
      "text": "很多人以为他这辈子不会再回来了，",
      "token_start": 34,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 13570,
      "end_ms": 15290,
      "text": "毕竟他不欠谁。",
      "token_start": 49,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 16610,
      "end_ms": 18050,
      "text": "第一次回国救火，",
      "token_start": 55,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 18310,
      "end_ms": 19910,
      "text": "她离了婚丢了，",
      "token_start": 62,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 19910,
      "end_ms": 21890,
      "text": "家住十平米宿舍，",
      "token_start": 68,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 22130,
      "end_ms": 24510,
      "text": "一年挣六千两百七十块，",
      "token_start": 75,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 25070,
      "end_ms": 28650,
      "text": "把一盘散沙的女排带进了奥运决赛。",
      "token_start": 85,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 29270,
      "end_ms": 29905,
      "text": "然后呢，",
      "token_start": 100,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 30200,
      "end_ms": 31260,
      "text": "身体垮了，",
      "token_start": 103,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 31340,
      "end_ms": 35860,
      "text": "没人管他他去美国治病带美国队，",
      "token_start": 107,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 37560,
      "end_ms": 38500,
      "text": "赢了一场球，",
      "token_start": 121,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 38680,
      "end_ms": 40540,
      "text": "就成了千古罪人。",
      "token_start": 126,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 40940,
      "end_ms": 41840,
      "text": "换做是你，",
      "token_start": 133,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 42020,
      "end_ms": 43220,
      "text": "你还会回来吗？",
      "token_start": 137,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 43720,
      "end_ms": 44540,
      "text": "他回来了。",
      "token_start": 143,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 44680,
      "end_ms": 45620,
      "text": "二零一三年，",
      "token_start": 147,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 45860,
      "end_ms": 47880,
      "text": "中国女排又跌到了世界第五，",
      "token_start": 152,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 48340,
      "end_ms": 51900,
      "text": "没人敢接主教练这个位置赢了是应该的，",
      "token_start": 164,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 52140,
      "end_ms": 53700,
      "text": "输了就是千古罪人。",
      "token_start": 181,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 54140,
      "end_ms": 57900,
      "text": "五十三岁的郎平髌骨已经摘了膝盖，",
      "token_start": 189,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 57900,
      "end_ms": 59200,
      "text": "动过十几次手术，",
      "token_start": 204,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 59480,
      "end_ms": 60325,
      "text": "走路都会不疼。",
      "token_start": 211,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 61270,
      "end_ms": 64315,
      "text": "领导问他还能拼吗？",
      "token_start": 217,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 64810,
      "end_ms": 65285,
      "text": "他说，",
      "token_start": 225,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 65660,
      "end_ms": 67165,
      "text": "能就一个字，",
      "token_start": 227,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 67670,
      "end_ms": 72990,
      "text": "他把朱婷、袁新月、张常宁这些十几岁的小孩招进队，",
      "token_start": 232,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 73050,
      "end_ms": 75165,
      "text": "那时候他们还是小树苗，",
      "token_start": 253,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 75670,
      "end_ms": 78605,
      "text": "没人知道这帮孩子能不能打出来。",
      "token_start": 263,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 79250,
      "end_ms": 81645,
      "text": "郎平每天熬到半夜看录像，",
      "token_start": 277,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 82020,
      "end_ms": 84495,
      "text": "房间的灯永远最后一个灭。",
      "token_start": 288,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 85330,
      "end_ms": 88535,
      "text": "二零一五年世界杯主力伤了一半，",
      "token_start": 299,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 88930,
      "end_ms": 91265,
      "text": "媒体说中国队是去陪跑的，",
      "token_start": 313,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 91700,
      "end_ms": 94135,
      "text": "对于俄罗斯先输后赢，",
      "token_start": 324,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 94520,
      "end_ms": 95620,
      "text": "第四局落后，",
      "token_start": 333,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 95940,
      "end_ms": 97105,
      "text": "身后就是悬崖，",
      "token_start": 338,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 97960,
      "end_ms": 99145,
      "text": "郎平叫暂停，",
      "token_start": 344,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 99510,
      "end_ms": 100425,
      "text": "只说了一句，",
      "token_start": 349,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 100820,
      "end_ms": 101615,
      "text": "输了也认，",
      "token_start": 354,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 101900,
      "end_ms": 102655,
      "text": "但不能怂。",
      "token_start": 358,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 103480,
      "end_ms": 106165,
      "text": "对日本三比一，",
      "token_start": 362,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 107100,
      "end_ms": 108235,
      "text": "时隔十一年，",
      "token_start": 368,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 109120,
      "end_ms": 111660,
      "text": "中国女排重回世界之巅，",
      "token_start": 373,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 111740,
      "end_ms": 114950,
      "text": "但真正封神的是二零一六年，",
      "token_start": 383,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 114950,
      "end_ms": 117295,
      "text": "里约小组赛输了三场，",
      "token_start": 395,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 117640,
      "end_ms": 119020,
      "text": "勉强第四，",
      "token_start": 404,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 119020,
      "end_ms": 122400,
      "text": "出现八强战打巴西东道主。",
      "token_start": 408,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 122760,
      "end_ms": 124800,
      "text": "此前对中国队十八连败，",
      "token_start": 419,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 124980,
      "end_ms": 127959,
      "text": "一场没赢过二万人的场馆，",
      "token_start": 429,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 128300,
      "end_ms": 129460,
      "text": "嘘声震天。",
      "token_start": 440,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 129940,
      "end_ms": 133540,
      "text": "巴西球迷都在提前庆祝郎平教暂停，",
      "token_start": 444,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 133900,
      "end_ms": 134960,
      "text": "对着姑娘们喊，",
      "token_start": 459,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 135340,
      "end_ms": 136080,
      "text": "听见了吗？",
      "token_start": 465,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 136840,
      "end_ms": 137660,
      "text": "这是战鼓，",
      "token_start": 469,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 138600,
      "end_ms": 140720,
      "text": "第五局比分焦灼。",
      "token_start": 473,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 141420,
      "end_ms": 145080,
      "text": "巴西主教练的孙子在场边被打哭了之前，",
      "token_start": 480,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 145120,
      "end_ms": 147120,
      "text": "发球几乎不失误的谢了。",
      "token_start": 497,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 147200,
      "end_ms": 148140,
      "text": "关键时刻，",
      "token_start": 507,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 148320,
      "end_ms": 156730,
      "text": "发球出界送给中国队赛点朱婷一记中扣一锤定音三比二翻盘了。",
      "token_start": 511,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 157690,
      "end_ms": 158110,
      "text": "赛后，",
      "token_start": 538,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 158110,
      "end_ms": 160430,
      "text": "她转过身抹了一把眼泪，",
      "token_start": 540,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 160770,
      "end_ms": 161510,
      "text": "说了一句，",
      "token_start": 550,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 162050,
      "end_ms": 162710,
      "text": "这一刻，",
      "token_start": 554,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 163010,
      "end_ms": 164390,
      "text": "我等了二十年。",
      "token_start": 557,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 165530,
      "end_ms": 166169,
      "text": "二十年。",
      "token_start": 563,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 166470,
      "end_ms": 172690,
      "text": "从一九九六年亚特兰大的银牌到二零一六年里约的金牌，",
      "token_start": 566,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 173350,
      "end_ms": 175330,
      "text": "他等了整整二十年，",
      "token_start": 590,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 176490,
      "end_ms": 179765,
      "text": "决赛对塞尔维亚先丢一局。",
      "token_start": 598,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 180180,
      "end_ms": 180980,
      "text": "他叫暂停，",
      "token_start": 609,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 181340,
      "end_ms": 181580,
      "text": "说，",
      "token_start": 613,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 181600,
      "end_ms": 183440,
      "text": "放开打天塌下来，",
      "token_start": 614,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 183440,
      "end_ms": 186640,
      "text": "我顶着第四局。",
      "token_start": 621,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 186780,
      "end_ms": 189680,
      "text": "二十三平张常宁发球，",
      "token_start": 627,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 190500,
      "end_ms": 191720,
      "text": "对方送探头，",
      "token_start": 636,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 192740,
      "end_ms": 198060,
      "text": "惠若琪一记探头打中冠军十二年，",
      "token_start": 641,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 199120,
      "end_ms": 201960,
      "text": "中国女排重回奥运之巅。",
      "token_start": 655,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 203640,
      "end_ms": 204640,
      "text": "二零一九年，",
      "token_start": 665,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 204660,
      "end_ms": 206560,
      "text": "世界杯十一连胜，",
      "token_start": 670,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 207000,
      "end_ms": 207940,
      "text": "一场没输，",
      "token_start": 677,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 208420,
      "end_ms": 209620,
      "text": "强势夺冠。",
      "token_start": 681,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 210000,
      "end_ms": 214460,
      "text": "一向沉稳的郎平哭了最后一场比赛，",
      "token_start": 685,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 214700,
      "end_ms": 217110,
      "text": "她把十四个队员队员全换上场，",
      "token_start": 700,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 217490,
      "end_ms": 218670,
      "text": "每个人都打了，",
      "token_start": 713,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 218970,
      "end_ms": 220350,
      "text": "不是来拍手的。",
      "token_start": 719,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 220850,
      "end_ms": 224830,
      "text": "然后是二零二一年东京伤病满盈，",
      "token_start": 725,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 225210,
      "end_ms": 226750,
      "text": "小组赛没出现，",
      "token_start": 739,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 226830,
      "end_ms": 228970,
      "text": "创造了队史最差战绩。",
      "token_start": 745,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 229570,
      "end_ms": 231050,
      "text": "舆论瞬间翻脸，",
      "token_start": 754,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 231390,
      "end_ms": 231590,
      "text": "说，",
      "token_start": 760,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 231590,
      "end_ms": 232790,
      "text": "她毁了中国女排，",
      "token_start": 761,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 233090,
      "end_ms": 234230,
      "text": "舆论瞬会捞金，",
      "token_start": 768,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 234830,
      "end_ms": 236910,
      "text": "她一个人把所有责任揽下来。",
      "token_start": 774,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 237130,
      "end_ms": 237690,
      "text": "卸任。",
      "token_start": 786,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 238010,
      "end_ms": 238470,
      "text": "赛后，",
      "token_start": 788,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 238930,
      "end_ms": 240475,
      "text": "姑娘们排成一排，",
      "token_start": 790,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 241090,
      "end_ms": 242715,
      "text": "给他深深鞠了一躬，",
      "token_start": 797,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 243730,
      "end_ms": 244975,
      "text": "张常宁望着他，",
      "token_start": 805,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 245600,
      "end_ms": 246975,
      "text": "眼睛里全是泪。",
      "token_start": 811,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 247850,
      "end_ms": 248935,
      "text": "采访的时候，",
      "token_start": 817,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 249330,
      "end_ms": 250495,
      "text": "郎平哭着说，",
      "token_start": 822,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 251500,
      "end_ms": 252565,
      "text": "我向大家道歉，",
      "token_start": 827,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 253580,
      "end_ms": 254340,
      "text": "我没带好，",
      "token_start": 833,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 254460,
      "end_ms": 259525,
      "text": "你算算从一九八一年到二零二一年，",
      "token_start": 837,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 260090,
      "end_ms": 261535,
      "text": "整整四十年，",
      "token_start": 852,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 261920,
      "end_ms": 262760,
      "text": "别人退役了，",
      "token_start": 857,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 262760,
      "end_ms": 263255,
      "text": "当官，",
      "token_start": 862,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 263610,
      "end_ms": 264190,
      "text": "他退役了，",
      "token_start": 864,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 264190,
      "end_ms": 264790,
      "text": "去留学，",
      "token_start": 868,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 264930,
      "end_ms": 266450,
      "text": "别人安稳的享福，",
      "token_start": 871,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 266690,
      "end_ms": 269285,
      "text": "他一次次在最低谷的时候站出来，",
      "token_start": 878,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 270150,
      "end_ms": 271470,
      "text": "别人被骂了就躲，",
      "token_start": 892,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 271910,
      "end_ms": 273495,
      "text": "他被骂完了还敢回来。",
      "token_start": 899,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 273730,
      "end_ms": 275330,
      "text": "他叫郎平外号，",
      "token_start": 908,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 275330,
      "end_ms": 278165,
      "text": "铁榔头榔头是干嘛的？",
      "token_start": 914,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 278540,
      "end_ms": 279445,
      "text": "砸困难的。",
      "token_start": 923,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 280980,
      "end_ms": 284445,
      "text": "他这一辈子砸开过世界冠军的大门，",
      "token_start": 927,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 285010,
      "end_ms": 285670,
      "text": "砸开过，",
      "token_start": 942,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 285710,
      "end_ms": 286210,
      "text": "治暗，",
      "token_start": 945,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 286230,
      "end_ms": 289295,
      "text": "时刻砸开过所有的质疑和骂声。",
      "token_start": 947,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 290400,
      "end_ms": 295045,
      "text": "最狠的一锤不是扣向日本队的那个制胜球，",
      "token_start": 960,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 295530,
      "end_ms": 297815,
      "text": "是每次被骂到骨子里，",
      "token_start": 978,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 298100,
      "end_ms": 299600,
      "text": "他依然敢说一句，",
      "token_start": 987,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 299900,
      "end_ms": 301015,
      "text": "我能拼。",
      "token_start": 994,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 301500,
      "end_ms": 303065,
      "text": "这样的人不该被忘记，",
      "token_start": 997,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 303440,
      "end_ms": 306010,
      "text": "觉得解气的点赞，",
      "token_start": 1006,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 306320,
      "end_ms": 309745,
      "text": "觉得该让更多人知道的转发，",
      "token_start": 1013,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 310530,
      "end_ms": 312700,
      "text": "怕以后找不到的收藏，",
      "token_start": 1025,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 313180,
      "end_ms": 313765,
      "text": "关注我，",
      "token_start": 1034,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 314050,
      "end_ms": 316545,
      "text": "下一个人物更狠。",
      "token_start": 1037,
      "token_end_exclusive": 1044
    }
  ],
