  "segments": [
    {
      "start_ms": 270,
      "end_ms": 2070,
      "text": "这个中秋一定要回趟家，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2730,
      "end_ms": 5430,
      "text": "因为不是每一个八月十五都能团圆，",
      "token_start": 10,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 5890,
      "end_ms": 8710,
      "text": "也不是每一个路口都会有所期盼。",
      "token_start": 25,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9730,
      "end_ms": 11230,
      "text": "光阴似箭的流年，",
      "token_start": 39,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 11590,
      "end_ms": 12970,
      "text": "我们已不再是少年。",
      "token_start": 46,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 13750,
      "end_ms": 17150,
      "text": "那个曾经为我们遮风挡雨的人慢慢老去，",
      "token_start": 54,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 17770,
      "end_ms": 18650,
      "text": "头发渐白，",
      "token_start": 71,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 19110,
      "end_ms": 20090,
      "text": "撩身渐弯，",
      "token_start": 75,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 20850,
      "end_ms": 23430,
      "text": "我们看着他渐行渐远。",
      "token_start": 79,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 24450,
      "end_ms": 26250,
      "text": "那间最大的亏欠是什么？",
      "token_start": 88,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 26650,
      "end_ms": 28830,
      "text": "最大的亏欠永远是父母。",
      "token_start": 98,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 29130,
      "end_ms": 31660,
      "text": "其他的都只是礼尚往来，",
      "token_start": 108,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 32580,
      "end_ms": 34360,
      "text": "父亲在天就在，",
      "token_start": 118,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 34580,
      "end_ms": 36580,
      "text": "母亲在家就在。",
      "token_start": 124,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 37360,
      "end_ms": 40760,
      "text": "所以这个中秋佳节记得回家看看父母，",
      "token_start": 130,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 41000,
      "end_ms": 42300,
      "text": "陪他们吃上一顿饭，",
      "token_start": 146,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 42660,
      "end_ms": 43440,
      "text": "唠唠家常。",
      "token_start": 154,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 44140,
      "end_ms": 46020,
      "text": "树欲静而风不止，",
      "token_start": 158,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 46340,
      "end_ms": 48520,
      "text": "子欲养而亲不待。",
      "token_start": 165,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 49300,
      "end_ms": 50560,
      "text": "世间最大的幸福，",
      "token_start": 172,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 50740,
      "end_ms": 53800,
      "text": "莫过于父母尚在有家，",
      "token_start": 179,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 54880,
      "end_ms": 55745,
      "text": "可还。",
      "token_start": 188,
      "token_end_exclusive": 190
    }
  ],
