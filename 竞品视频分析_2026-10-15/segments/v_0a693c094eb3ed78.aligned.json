{
  "video_id": "v_0a693c094eb3ed78",
  "duration_s": 515.437007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_0a693c094eb3ed78.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_0a693c094eb3ed78.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 710,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 710,
      "end_ms": 1390,
      "text": "咱们盘了，",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1390,
      "end_ms": 3110,
      "text": "第十到第六，",
      "token_start": 6,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3770,
      "end_ms": 4990,
      "text": "兽首走散了。",
      "token_start": 11,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4990,
      "end_ms": 9110,
      "text": "一百六十多年罗汉被拆散到五六个国家。",
      "token_start": 16,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 9770,
      "end_ms": 12770,
      "text": "帝后礼佛图只剩两个窟窿。",
      "token_start": 33,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 13310,
      "end_ms": 18690,
      "text": "皇宫井刻时所在日本皇宫丧乱铁一千年只回来过一次。",
      "token_start": 44,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 19130,
      "end_ms": 21450,
      "text": "好多朋友看完在评论区炒翻了，",
      "token_start": 67,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 21930,
      "end_ms": 24210,
      "text": "有人说女史征图呢？",
      "token_start": 80,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 24830,
      "end_ms": 26130,
      "text": "东皇经卷哪，",
      "token_start": 88,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 26250,
      "end_ms": 27450,
      "text": "昭陵六郡哪。",
      "token_start": 93,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 28210,
      "end_ms": 28710,
      "text": "别急，",
      "token_start": 98,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 29230,
      "end_ms": 33340,
      "text": "今天这集就是第五到第一一件比一件揪心。",
      "token_start": 100,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 34340,
      "end_ms": 37280,
      "text": "最后那个你可能都不知道它长什么样。",
      "token_start": 118,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 37380,
      "end_ms": 38000,
      "text": "老规矩，",
      "token_start": 134,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 38160,
      "end_ms": 38960,
      "text": "开讲之前，",
      "token_start": 137,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 39180,
      "end_ms": 41240,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 141,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 41580,
      "end_ms": 46080,
      "text": "让我看看都是谁在听刻五名昭陵六郡。",
      "token_start": 151,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 46580,
      "end_ms": 48480,
      "text": "唐太宗李世民死了以后，",
      "token_start": 167,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 48680,
      "end_ms": 50520,
      "text": "埋在了昭陵陵前，",
      "token_start": 177,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 50560,
      "end_ms": 51220,
      "text": "祭坛上，",
      "token_start": 184,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 51400,
      "end_ms": 52720,
      "text": "立着六块浮雕，",
      "token_start": 187,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 53200,
      "end_ms": 58560,
      "text": "刻的是他生前骑过的六匹战马、飒禄子全矛杆，",
      "token_start": 193,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 58560,
      "end_ms": 64725,
      "text": "白天提屋、特勒芳、清池、石伐赤，",
      "token_start": 212,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 65100,
      "end_ms": 67615,
      "text": "每一批都有名字都有故事。",
      "token_start": 224,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 68280,
      "end_ms": 69325,
      "text": "一九一四年，",
      "token_start": 235,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 69780,
      "end_ms": 75095,
      "text": "古董商卢钦斋把飒禄子和全谋干偷运到了美国，",
      "token_start": 240,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 75620,
      "end_ms": 79395,
      "text": "卖给了宾夕法尼亚大学博物馆十二万五千美元，",
      "token_start": 260,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 80330,
      "end_ms": 82490,
      "text": "剩下的四郡留在了西安。",
      "token_start": 280,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 82490,
      "end_ms": 87805,
      "text": "碑林博物馆六匹马两批在美国四批在中国，",
      "token_start": 290,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 88510,
      "end_ms": 90065,
      "text": "他们分开一百多年了，",
      "token_start": 308,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 91540,
      "end_ms": 92965,
      "text": "您去西安看思郡，",
      "token_start": 317,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 93420,
      "end_ms": 94480,
      "text": "再去费城，",
      "token_start": 324,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 94480,
      "end_ms": 95095,
      "text": "看两郡，",
      "token_start": 328,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 95520,
      "end_ms": 97095,
      "text": "中间隔着半个地球。",
      "token_start": 331,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 97500,
      "end_ms": 99915,
      "text": "您说这是保护还是拆散？",
      "token_start": 339,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 100780,
      "end_ms": 101355,
      "text": "第四名，",
      "token_start": 349,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 101880,
      "end_ms": 103885,
      "text": "东皇藏经洞文物？",
      "token_start": 352,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 104470,
      "end_ms": 105515,
      "text": "一九零零年，",
      "token_start": 359,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 105850,
      "end_ms": 113275,
      "text": "敦煌莫高窟的道士王元自无意中打开了一个封闭了近千年的洞窟，",
      "token_start": 364,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 114180,
      "end_ms": 119140,
      "text": "里面堆满了从南北朝到北宋的写经文书。",
      "token_start": 392,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 119300,
      "end_ms": 122385,
      "text": "捐画密密麻麻好几万卷。",
      "token_start": 409,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 123050,
      "end_ms": 124715,
      "text": "可接下来发生的事，",
      "token_start": 419,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 125050,
      "end_ms": 127425,
      "text": "是全中国最痛的一段。",
      "token_start": 427,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 128030,
      "end_ms": 129045,
      "text": "一九零七年，",
      "token_start": 436,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 129590,
      "end_ms": 131375,
      "text": "英国人斯坦因来了，",
      "token_start": 441,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 131830,
      "end_ms": 135585,
      "text": "用极少银元骗走了二十四箱血本，",
      "token_start": 449,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 136070,
      "end_ms": 138865,
      "text": "五相捐画一万多件，",
      "token_start": 463,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 139540,
      "end_ms": 141195,
      "text": "全部运回了伦敦。",
      "token_start": 471,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 142110,
      "end_ms": 143010,
      "text": "大英博物馆。",
      "token_start": 478,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 143230,
      "end_ms": 147615,
      "text": "现藏敦煌文物约一万三千七百件，",
      "token_start": 483,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 148160,
      "end_ms": 151565,
      "text": "是世界上收藏敦煌文物最多的地方。",
      "token_start": 497,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 152130,
      "end_ms": 152865,
      "text": "十个月后，",
      "token_start": 512,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 153200,
      "end_ms": 154805,
      "text": "法国人伯希河又来了，",
      "token_start": 516,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 155360,
      "end_ms": 159915,
      "text": "用五百两银子带走了七千卷精品中的精品。",
      "token_start": 525,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 160160,
      "end_ms": 161245,
      "text": "后来日本人来了，",
      "token_start": 543,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 161570,
      "end_ms": 162530,
      "text": "俄国人也来了，",
      "token_start": 550,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 162790,
      "end_ms": 164825,
      "text": "藏经洞里几万卷文书，",
      "token_start": 556,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 165490,
      "end_ms": 168125,
      "text": "就这样一箱一箱被搬空了。",
      "token_start": 565,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 169040,
      "end_ms": 172005,
      "text": "您说这是学术考察还是搬家？",
      "token_start": 576,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 172550,
      "end_ms": 175215,
      "text": "第三名要遍天目茶碗。",
      "token_start": 588,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 175580,
      "end_ms": 176565,
      "text": "南宋时期，",
      "token_start": 597,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 176980,
      "end_ms": 180385,
      "text": "福建建阳窑烧出了一种黑釉茶碗，",
      "token_start": 601,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 180910,
      "end_ms": 185695,
      "text": "碗里面在特定光线下会浮现出深蓝色的光斑，",
      "token_start": 615,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 186280,
      "end_ms": 186965,
      "text": "像宇宙，",
      "token_start": 634,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 187290,
      "end_ms": 187975,
      "text": "像星空，",
      "token_start": 637,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 188750,
      "end_ms": 190445,
      "text": "日本人管他叫要变，",
      "token_start": 640,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 190920,
      "end_ms": 193035,
      "text": "说碗里藏着一片宇宙。",
      "token_start": 648,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 193890,
      "end_ms": 194745,
      "text": "这种茶碗，",
      "token_start": 657,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 195070,
      "end_ms": 197990,
      "text": "全世界保存完好的只有三件，",
      "token_start": 661,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 198210,
      "end_ms": 206440,
      "text": "全在日本东京晋家堂文库、一建、京都大德寺、龙光苑、一建、大阪藤田美术馆，",
      "token_start": 673,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 206440,
      "end_ms": 208000,
      "text": "一件三件，",
      "token_start": 703,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 208040,
      "end_ms": 209255,
      "text": "都是日本国宝，",
      "token_start": 707,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 209620,
      "end_ms": 211335,
      "text": "其中敬家堂的那一件，",
      "token_start": 713,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 211890,
      "end_ms": 218365,
      "text": "被称为天下第一晚万中宇宙三件国宝级的中国茶碗，",
      "token_start": 722,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 218780,
      "end_ms": 219975,
      "text": "一件都没回来。",
      "token_start": 744,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 220270,
      "end_ms": 222705,
      "text": "您说这是收藏还是占友？",
      "token_start": 750,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 223440,
      "end_ms": 223985,
      "text": "第二名，",
      "token_start": 760,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 224490,
      "end_ms": 225585,
      "text": "女史贞图，",
      "token_start": 763,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 225960,
      "end_ms": 229565,
      "text": "东晋顾恺之画的原作早就没了，",
      "token_start": 767,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 230390,
      "end_ms": 232175,
      "text": "现存的唐代模本，",
      "token_start": 780,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 232570,
      "end_ms": 234625,
      "text": "是大英博物馆的镇馆之宝。",
      "token_start": 787,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 236270,
      "end_ms": 237290,
      "text": "一九零零年，",
      "token_start": 798,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 237390,
      "end_ms": 238625,
      "text": "八国联军侵华，",
      "token_start": 803,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 239170,
      "end_ms": 241915,
      "text": "一个英国上尉从北京把他带走了。",
      "token_start": 809,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 242650,
      "end_ms": 243690,
      "text": "一九零三年，",
      "token_start": 823,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 243890,
      "end_ms": 247285,
      "text": "大英博物馆只花了二十五英镑就买下了它。",
      "token_start": 828,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 247880,
      "end_ms": 249180,
      "text": "更让人心疼的是，",
      "token_start": 846,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 249180,
      "end_ms": 253505,
      "text": "后来大英博物馆的修画师不懂中国手绢怎么装裱。",
      "token_start": 853,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 254090,
      "end_ms": 256395,
      "text": "按照日本屏风化的办法，",
      "token_start": 874,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 257020,
      "end_ms": 262545,
      "text": "把这幅一千多年前的古画硬生生切成了好几段，",
      "token_start": 884,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 263110,
      "end_ms": 264845,
      "text": "装在了木板上。",
      "token_start": 904,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 265200,
      "end_ms": 265895,
      "text": "您想想，",
      "token_start": 910,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 266250,
      "end_ms": 269515,
      "text": "一副完整的手卷被裁成三段，",
      "token_start": 913,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 269940,
      "end_ms": 271485,
      "text": "贴在三块板子上，",
      "token_start": 925,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 271940,
      "end_ms": 273335,
      "text": "旁边还打了钉子，",
      "token_start": 932,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 273520,
      "end_ms": 276845,
      "text": "一幅千年古画被剪碎了裱起来。",
      "token_start": 939,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 277280,
      "end_ms": 279165,
      "text": "这事您上哪说理去，",
      "token_start": 952,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 279920,
      "end_ms": 281205,
      "text": "您听出来了没有？",
      "token_start": 960,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 281620,
      "end_ms": 290080,
      "text": "这五件文物没有一件是光靠值钱出名的昭陵六郡靠的是六匹马分。",
      "token_start": 967,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 290080,
      "end_ms": 292150,
      "text": "在两国东皇经眷，",
      "token_start": 995,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 292150,
      "end_ms": 294025,
      "text": "靠的是一箱一箱被搬走。",
      "token_start": 1002,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 294890,
      "end_ms": 295810,
      "text": "要变天幕，",
      "token_start": 1012,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 295830,
      "end_ms": 297170,
      "text": "靠的是三件国宝，",
      "token_start": 1016,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 297210,
      "end_ms": 299810,
      "text": "全在日本女史贞图，",
      "token_start": 1023,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 300170,
      "end_ms": 302030,
      "text": "靠的是被切碎装扮，",
      "token_start": 1031,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 303710,
      "end_ms": 305670,
      "text": "每一件文物的厉害之处，",
      "token_start": 1039,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 306090,
      "end_ms": 308250,
      "text": "不在于它值多少银子，",
      "token_start": 1049,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 309050,
      "end_ms": 310110,
      "text": "在它回不了家。",
      "token_start": 1058,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 311310,
      "end_ms": 312850,
      "text": "我最近翻了一本书，",
      "token_start": 1064,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 313790,
      "end_ms": 315430,
      "text": "叫人一生要看的。",
      "token_start": 1072,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 315570,
      "end_ms": 320510,
      "text": "一百个博物馆里头精选了全球一百个顶级博物馆，",
      "token_start": 1079,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 321230,
      "end_ms": 322210,
      "text": "每个馆里有什么？",
      "token_start": 1100,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 322210,
      "end_ms": 324375,
      "text": "中国文物哪一年出去的？",
      "token_start": 1107,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 324620,
      "end_ms": 327360,
      "text": "现在摆在哪个展厅写的清清楚楚。",
      "token_start": 1117,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 327680,
      "end_ms": 330300,
      "text": "大英博物馆两万三千多件，",
      "token_start": 1131,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 330920,
      "end_ms": 332940,
      "text": "法国集美两万多件，",
      "token_start": 1142,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 333480,
      "end_ms": 335680,
      "text": "美国大都会三万多件。",
      "token_start": 1150,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 336660,
      "end_ms": 339880,
      "text": "咱们上级下集讲的这些书里都有，",
      "token_start": 1159,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 340360,
      "end_ms": 344280,
      "text": "您可以带着孩子一页一页翻翻到哪儿。",
      "token_start": 1173,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 344280,
      "end_ms": 348840,
      "text": "讲到哪告诉他这件是咱们的那件也是咱们的，",
      "token_start": 1189,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 348960,
      "end_ms": 350640,
      "text": "他们是怎么离开家的，",
      "token_start": 1208,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 350780,
      "end_ms": 352380,
      "text": "将来要靠谁接回来。",
      "token_start": 1217,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 352520,
      "end_ms": 353480,
      "text": "什么叫爱国？",
      "token_start": 1225,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 353480,
      "end_ms": 356075,
      "text": "爱国不是喊出来的，",
      "token_start": 1230,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 356340,
      "end_ms": 358460,
      "text": "是让孩子知道自己从哪儿来，",
      "token_start": 1238,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 358800,
      "end_ms": 360135,
      "text": "家里丢过什么，",
      "token_start": 1250,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 360390,
      "end_ms": 361805,
      "text": "以后要争回什么。",
      "token_start": 1256,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 362830,
      "end_ms": 364885,
      "text": "这本书放在主页橱窗了，",
      "token_start": 1263,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 365300,
      "end_ms": 370185,
      "text": "点开头像就能看到中老年朋友看这种书最合适。",
      "token_start": 1273,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 370740,
      "end_ms": 374505,
      "text": "图多四大不费眼睛放床头，",
      "token_start": 1293,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 374860,
      "end_ms": 375705,
      "text": "放茶几，",
      "token_start": 1304,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 376210,
      "end_ms": 378665,
      "text": "随手翻一页就是一段历史。",
      "token_start": 1307,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 379250,
      "end_ms": 379795,
      "text": "第一名。",
      "token_start": 1318,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 380170,
      "end_ms": 386840,
      "text": "敦煌莫高窟壁画前面说的藏经洞抢走的是经卷和卷画可，",
      "token_start": 1321,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 386840,
      "end_ms": 390205,
      "text": "还有一样东西比经卷更让人心疼，",
      "token_start": 1345,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 390490,
      "end_ms": 392135,
      "text": "是画在墙上的画。",
      "token_start": 1359,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 393090,
      "end_ms": 397725,
      "text": "莫高窟的壁画总面积四万五千多平方米，",
      "token_start": 1366,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 398550,
      "end_ms": 402465,
      "text": "从十六国到元代画了一千多年。",
      "token_start": 1383,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 403380,
      "end_ms": 404545,
      "text": "可一百多年前，",
      "token_start": 1396,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 404870,
      "end_ms": 406315,
      "text": "西方探险家来了，",
      "token_start": 1402,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 406740,
      "end_ms": 409375,
      "text": "用特制的胶布贴在墙上，",
      "token_start": 1409,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 409740,
      "end_ms": 412145,
      "text": "把壁画一块一块粘下来，",
      "token_start": 1419,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 412440,
      "end_ms": 413135,
      "text": "运出境。",
      "token_start": 1429,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 413520,
      "end_ms": 423520,
      "text": "现在大英博物馆、法国集美博物馆、俄罗斯埃尔米塔什博物馆、日本、美国到处都有敦煌壁画，",
      "token_start": 1432,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 423840,
      "end_ms": 425180,
      "text": "有的被切成方块，",
      "token_start": 1469,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 425400,
      "end_ms": 426720,
      "text": "有的被拼成整墙，",
      "token_start": 1476,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 427080,
      "end_ms": 428680,
      "text": "有的整面墙被剥走。",
      "token_start": 1483,
      "token_end_exclusive": 1491
    },
    {
      "start_ms": 428800,
      "end_ms": 429515,
      "text": "您想想，",
      "token_start": 1491,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 429910,
      "end_ms": 432370,
      "text": "敦煌的墙是连着的画，",
      "token_start": 1494,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 432490,
      "end_ms": 434685,
      "text": "是连着画的一个故事，",
      "token_start": 1503,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 434960,
      "end_ms": 437005,
      "text": "从这面墙画到那面墙，",
      "token_start": 1512,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 437410,
      "end_ms": 439250,
      "text": "现在被切开了一半，",
      "token_start": 1521,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 439250,
      "end_ms": 439965,
      "text": "在伦敦，",
      "token_start": 1529,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 440250,
      "end_ms": 441345,
      "text": "一半儿在巴黎，",
      "token_start": 1532,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 441850,
      "end_ms": 444110,
      "text": "一半在圣彼得堡丢了，",
      "token_start": 1538,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 444110,
      "end_ms": 446940,
      "text": "还能找回来墙上被剥走的画，",
      "token_start": 1547,
      "token_end_exclusive": 1559
    },
    {
      "start_ms": 447160,
      "end_ms": 448205,
      "text": "怎么拼回去？",
      "token_start": 1559,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 448570,
      "end_ms": 451115,
      "text": "您可以归还一件完整的文物，",
      "token_start": 1564,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 451960,
      "end_ms": 453595,
      "text": "但你怎么归还一面墙，",
      "token_start": 1576,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 454110,
      "end_ms": 456570,
      "text": "怎么归还一面被切成十几块，",
      "token_start": 1585,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 456890,
      "end_ms": 458825,
      "text": "散落在四个国家的墙，",
      "token_start": 1597,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 459410,
      "end_ms": 462125,
      "text": "这才是中国流失文物最大的痛。",
      "token_start": 1606,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 462610,
      "end_ms": 464410,
      "text": "不是某一件东西丢了，",
      "token_start": 1619,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 464470,
      "end_ms": 466795,
      "text": "是某一件东西被撕碎了。",
      "token_start": 1628,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 467090,
      "end_ms": 469865,
      "text": "圆明园被烧是一八六零年的事，",
      "token_start": 1638,
      "token_end_exclusive": 1651
    },
    {
      "start_ms": 470210,
      "end_ms": 472015,
      "text": "到今天一百六十多年了，",
      "token_start": 1651,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 472460,
      "end_ms": 475495,
      "text": "一百六十多年里有些文物回来了，",
      "token_start": 1661,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 475900,
      "end_ms": 476985,
      "text": "兽首回来了，",
      "token_start": 1675,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 477400,
      "end_ms": 478835,
      "text": "永乐大典回来过，",
      "token_start": 1680,
      "token_end_exclusive": 1687
    },
    {
      "start_ms": 479710,
      "end_ms": 480875,
      "text": "可还有更多的。",
      "token_start": 1687,
      "token_end_exclusive": 1693
    },
    {
      "start_ms": 482070,
      "end_ms": 483505,
      "text": "在伦敦的玻璃柜里，",
      "token_start": 1693,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 484370,
      "end_ms": 485555,
      "text": "巴黎的库房里，",
      "token_start": 1701,
      "token_end_exclusive": 1707
    },
    {
      "start_ms": 486400,
      "end_ms": 487765,
      "text": "东京的展厅里，",
      "token_start": 1707,
      "token_end_exclusive": 1713
    },
    {
      "start_ms": 488700,
      "end_ms": 491575,
      "text": "某个英国乡下庄园的阁楼上，",
      "token_start": 1713,
      "token_end_exclusive": 1725
    },
    {
      "start_ms": 492450,
      "end_ms": 493535,
      "text": "他们不会说话，",
      "token_start": 1725,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 493970,
      "end_ms": 495485,
      "text": "但如果他们会说话，",
      "token_start": 1731,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 496420,
      "end_ms": 497525,
      "text": "一百六十多年，",
      "token_start": 1739,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 498420,
      "end_ms": 499815,
      "text": "他们只会说两个字，",
      "token_start": 1745,
      "token_end_exclusive": 1753
    },
    {
      "start_ms": 500740,
      "end_ms": 501255,
      "text": "回家。",
      "token_start": 1753,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 502450,
      "end_ms": 505270,
      "text": "你觉得哪一件文物的故事最让你心疼？",
      "token_start": 1755,
      "token_end_exclusive": 1771
    },
    {
      "start_ms": 505570,
      "end_ms": 508815,
      "text": "是被切成三段装版的女史真图，",
      "token_start": 1771,
      "token_end_exclusive": 1784
    },
    {
      "start_ms": 509380,
      "end_ms": 512680,
      "text": "还是那三件全在日本的药变天。",
      "token_start": 1784,
      "token_end_exclusive": 1797
    },
    {
      "start_ms": 512680,
      "end_ms": 514625,
      "text": "木茶碗评论区聊聊，",
      "token_start": 1797,
      "token_end_exclusive": 1805
    },
    {
      "start_ms": 514880,
      "end_ms": 515325,
      "text": "我等你。",
      "token_start": 1805,
      "token_end_exclusive": 1808
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
