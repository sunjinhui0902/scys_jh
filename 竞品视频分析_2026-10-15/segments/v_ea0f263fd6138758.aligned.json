{
  "video_id": "v_ea0f263fd6138758",
  "duration_s": 410.529002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_ea0f263fd6138758.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_ea0f263fd6138758.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 4350,
      "text": "你知道中国古代那些号称镇国的顶级国宝，",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4710,
      "end_ms": 7510,
      "text": "真正排第一的到底是哪一件吗？",
      "token_start": 18,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 8270,
      "end_ms": 11710,
      "text": "有人说是后母戊鼎八百多公斤，",
      "token_start": 31,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12630,
      "end_ms": 14470,
      "text": "世界最重青铜器。",
      "token_start": 44,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 14950,
      "end_ms": 16850,
      "text": "有人说是清明上河图，",
      "token_start": 51,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 17430,
      "end_ms": 18530,
      "text": "八百多个人物，",
      "token_start": 60,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 19330,
      "end_ms": 20750,
      "text": "中华第一神品。",
      "token_start": 66,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 21570,
      "end_ms": 23310,
      "text": "可这两样虽然珍贵，",
      "token_start": 72,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 24030,
      "end_ms": 26730,
      "text": "却都不是最逆天的那一件。",
      "token_start": 80,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 26990,
      "end_ms": 28110,
      "text": "有这么一个宝贝，",
      "token_start": 91,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 28590,
      "end_ms": 32260,
      "text": "它身上刻着三千年前的天文档案，",
      "token_start": 98,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 33040,
      "end_ms": 35560,
      "text": "到现在科学家还没完全看懂。",
      "token_start": 112,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 36100,
      "end_ms": 38420,
      "text": "还有一件他被人偷运出境，",
      "token_start": 124,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 38840,
      "end_ms": 40160,
      "text": "碎成了二十多块，",
      "token_start": 135,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 40500,
      "end_ms": 42020,
      "text": "又一块一块拼了回来。",
      "token_start": 142,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 42840,
      "end_ms": 46860,
      "text": "今天咱们就来盘点盘点中国古代十大镇国之宝。",
      "token_start": 151,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 47060,
      "end_ms": 49080,
      "text": "老规矩开讲之前，",
      "token_start": 171,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 49300,
      "end_ms": 52420,
      "text": "劳烦您顺手扣个一点颗红心，",
      "token_start": 178,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 53020,
      "end_ms": 55240,
      "text": "让我看看都是谁在听。",
      "token_start": 190,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 55980,
      "end_ms": 56620,
      "text": "第十名，",
      "token_start": 199,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 57320,
      "end_ms": 59520,
      "text": "流经午马鲜杯纹银壶。",
      "token_start": 202,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 60560,
      "end_ms": 65510,
      "text": "这件宝贝藏在陕西历史博物馆高十八点五厘米，",
      "token_start": 211,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 65570,
      "end_ms": 70005,
      "text": "银质表面鎏金壶身上刻着一匹马，",
      "token_start": 231,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 70470,
      "end_ms": 72235,
      "text": "嘴里叼着一只酒杯，",
      "token_start": 245,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 72620,
      "end_ms": 74695,
      "text": "前腿斜撑后腿蹲起，",
      "token_start": 253,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 75060,
      "end_ms": 75875,
      "text": "马尾上摆，",
      "token_start": 261,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 76130,
      "end_ms": 76925,
      "text": "像是在跳舞，",
      "token_start": 265,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 77410,
      "end_ms": 79255,
      "text": "这匹马可不是随便画的。",
      "token_start": 270,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 79780,
      "end_ms": 80765,
      "text": "唐朝的时候，",
      "token_start": 280,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 81000,
      "end_ms": 82515,
      "text": "唐玄宗每年过生日，",
      "token_start": 285,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 82840,
      "end_ms": 88305,
      "text": "都要在兴庆宫的秦政楼前举行盛大宴会宴会的高潮是什么？",
      "token_start": 293,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 88770,
      "end_ms": 90945,
      "text": "一百匹训练过的骏马，",
      "token_start": 318,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 91290,
      "end_ms": 92655,
      "text": "穿着锦绣衣服，",
      "token_start": 327,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 92990,
      "end_ms": 94345,
      "text": "披着金银饰品。",
      "token_start": 333,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 94710,
      "end_ms": 95955,
      "text": "随着音乐起舞，",
      "token_start": 339,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 96360,
      "end_ms": 100225,
      "text": "跳到最后领头的马会叼起一只酒杯，",
      "token_start": 345,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 100810,
      "end_ms": 102235,
      "text": "送到皇帝面前。",
      "token_start": 360,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 102560,
      "end_ms": 104575,
      "text": "助皇帝万寿无疆。",
      "token_start": 366,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 105040,
      "end_ms": 106225,
      "text": "安史之乱以后，",
      "token_start": 373,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 106590,
      "end_ms": 108485,
      "text": "这些午马散落民间，",
      "token_start": 379,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 108750,
      "end_ms": 111500,
      "text": "被不知道的人当成普通马使唤。",
      "token_start": 387,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 111620,
      "end_ms": 112120,
      "text": "有一天，",
      "token_start": 400,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 112120,
      "end_ms": 114395,
      "text": "军中宴乐音乐一响，",
      "token_start": 403,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 114870,
      "end_ms": 120395,
      "text": "一匹午马条件反射的跳起舞来养马的士兵以为马疯了，",
      "token_start": 411,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 120700,
      "end_ms": 121675,
      "text": "活活把他打死。",
      "token_start": 434,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 122210,
      "end_ms": 124845,
      "text": "一段盛世记忆就这么断了。",
      "token_start": 440,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 125510,
      "end_ms": 131235,
      "text": "这件银壶是那段记忆唯一留下的第九名。",
      "token_start": 451,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 131830,
      "end_ms": 137925,
      "text": "中山靖王刘胜的金吕御衣这件宝贝藏在河北博物院，",
      "token_start": 468,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 138300,
      "end_ms": 140075,
      "text": "它长一点八八米，",
      "token_start": 490,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 140540,
      "end_ms": 147475,
      "text": "用两千四百九十八片玉片一千一百克金丝编缀而成。",
      "token_start": 497,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 148110,
      "end_ms": 150705,
      "text": "制作这么一件御医有多难？",
      "token_start": 519,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 150890,
      "end_ms": 154125,
      "text": "玉片要按人体比例一点一点打磨，",
      "token_start": 530,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 154550,
      "end_ms": 156065,
      "text": "厚薄要均匀，",
      "token_start": 544,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 156470,
      "end_ms": 157925,
      "text": "视角要钻孔，",
      "token_start": 549,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 158500,
      "end_ms": 160975,
      "text": "金丝要拉的粗细一致，",
      "token_start": 554,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 161290,
      "end_ms": 163095,
      "text": "才能穿过玉片孔洞。",
      "token_start": 563,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 163960,
      "end_ms": 164875,
      "text": "专家推测，",
      "token_start": 571,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 165170,
      "end_ms": 169885,
      "text": "一名熟练的御工要耗费十余年才能完成一件。",
      "token_start": 575,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 170840,
      "end_ms": 173475,
      "text": "而且刘胜的御医有个特别的地方，",
      "token_start": 594,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 174000,
      "end_ms": 176895,
      "text": "肚子那里预留了一个啤酒肚的空间。",
      "token_start": 608,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 177860,
      "end_ms": 179355,
      "text": "考古队出土的时候，",
      "token_start": 623,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 179800,
      "end_ms": 182105,
      "text": "旁边还发现了大量的酒气，",
      "token_start": 631,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 182810,
      "end_ms": 188205,
      "text": "这位中山靖王生前是真能喝两千多年前的人，",
      "token_start": 642,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 188550,
      "end_ms": 195535,
      "text": "用玉片和金丝把一个人的体型、习惯甚至嗜好全都封存了下来。",
      "token_start": 661,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 196690,
      "end_ms": 197295,
      "text": "第八名，",
      "token_start": 687,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 198180,
      "end_ms": 203735,
      "text": "相金兽首玛瑙杯这件宝贝藏在陕西历史博物馆，",
      "token_start": 690,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 204490,
      "end_ms": 209235,
      "text": "他用一块罕见的红色蚕丝玛瑙雕成兽首行，",
      "token_start": 710,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 209660,
      "end_ms": 210835,
      "text": "双脚为杯柄，",
      "token_start": 728,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 211310,
      "end_ms": 212615,
      "text": "嘴部镶着金帽。",
      "token_start": 733,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 213010,
      "end_ms": 217475,
      "text": "这是至今所见唐代唯一一件俏色玉雕。",
      "token_start": 739,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 218290,
      "end_ms": 219335,
      "text": "什么叫俏色？",
      "token_start": 755,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 219740,
      "end_ms": 223885,
      "text": "就是工匠顺着玛瑙天然的纹理和颜色，",
      "token_start": 760,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 224500,
      "end_ms": 226795,
      "text": "把深色的地方雕成兽眼，",
      "token_start": 776,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 227300,
      "end_ms": 229095,
      "text": "浅色的地方雕成兽脚，",
      "token_start": 786,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 229510,
      "end_ms": 232085,
      "text": "红色最浓的地方雕成受嘴。",
      "token_start": 795,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 232330,
      "end_ms": 233650,
      "text": "这不是后天染色，",
      "token_start": 806,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 234150,
      "end_ms": 236465,
      "text": "是石头自己长出来的颜色。",
      "token_start": 813,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 237310,
      "end_ms": 238615,
      "text": "一千两百多年前，",
      "token_start": 824,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 239060,
      "end_ms": 241320,
      "text": "一个唐代工匠拿到这块，",
      "token_start": 831,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 241320,
      "end_ms": 243145,
      "text": "玛瑙端详了很久，",
      "token_start": 841,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 243560,
      "end_ms": 249575,
      "text": "然后一刀一刀把石头里的那头兽放了出来第七名。",
      "token_start": 848,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 249970,
      "end_ms": 252235,
      "text": "越王勾践践这把剑，",
      "token_start": 869,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 252550,
      "end_ms": 254115,
      "text": "藏在湖北省博物馆，",
      "token_start": 877,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 254850,
      "end_ms": 257890,
      "text": "一九六五年出土于湖北江陵望山一号。",
      "token_start": 885,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 257930,
      "end_ms": 259930,
      "text": "楚牧出土的时候，",
      "token_start": 901,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 260090,
      "end_ms": 262500,
      "text": "一个工人伸手去拿手指，",
      "token_start": 908,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 262500,
      "end_ms": 263465,
      "text": "刚碰到剑刃，",
      "token_start": 918,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 263820,
      "end_ms": 265755,
      "text": "立刻被划了一道口子，",
      "token_start": 923,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 266100,
      "end_ms": 266825,
      "text": "鲜血直流。",
      "token_start": 932,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 267080,
      "end_ms": 268265,
      "text": "两千多年了，",
      "token_start": 936,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 268730,
      "end_ms": 270905,
      "text": "这把剑还跟刚磨出来的一样，",
      "token_start": 941,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 271670,
      "end_ms": 273835,
      "text": "剑身上刻着八个鸟篆字。",
      "token_start": 953,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 274600,
      "end_ms": 276910,
      "text": "越王纠遣制作用，",
      "token_start": 963,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 276910,
      "end_ms": 278665,
      "text": "剑纠浅就是勾践。",
      "token_start": 970,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 279590,
      "end_ms": 283505,
      "text": "为什么千年不锈科学家研究了好多年，",
      "token_start": 977,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 283960,
      "end_ms": 286645,
      "text": "一是铜锡合金配比近乎完美，",
      "token_start": 993,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 287150,
      "end_ms": 289595,
      "text": "含蓄量百分之十八到二十，",
      "token_start": 1005,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 290110,
      "end_ms": 291085,
      "text": "杂质极低。",
      "token_start": 1016,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 291800,
      "end_ms": 296725,
      "text": "二是墓视深埋地下棺裹密封几乎隔绝了空气。",
      "token_start": 1020,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 297510,
      "end_ms": 298905,
      "text": "三世出土的时候，",
      "token_start": 1039,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 299340,
      "end_ms": 301705,
      "text": "剑身上还套着七木剑鞘，",
      "token_start": 1046,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 302200,
      "end_ms": 303560,
      "text": "天时地利人和，",
      "token_start": 1056,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 303920,
      "end_ms": 304740,
      "text": "缺一不可。",
      "token_start": 1062,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 304880,
      "end_ms": 309085,
      "text": "这把剑是春秋霸主留给后人的一把钥匙。",
      "token_start": 1066,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 309680,
      "end_ms": 311520,
      "text": "打开了两千多年的时光。",
      "token_start": 1083,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 312360,
      "end_ms": 313020,
      "text": "第六名，",
      "token_start": 1093,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 313400,
      "end_ms": 318520,
      "text": "曾侯乙编钟这套编钟藏在湖北省博物馆，",
      "token_start": 1096,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 319080,
      "end_ms": 327440,
      "text": "一九七八年出土于湖北随州六十五件青铜编钟总重量两千五百多公斤。",
      "token_start": 1113,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 328180,
      "end_ms": 329300,
      "text": "最绝的是，",
      "token_start": 1143,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 329300,
      "end_ms": 332140,
      "text": "它的音域跨五个半八度十二个，",
      "token_start": 1147,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 332140,
      "end_ms": 332940,
      "text": "半音齐全，",
      "token_start": 1160,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 333480,
      "end_ms": 335640,
      "text": "比现代钢琴只少一个八度，",
      "token_start": 1164,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 336420,
      "end_ms": 343390,
      "text": "中体上刻着三千七百多字的霍金铭文标明了每一件中的发音。",
      "token_start": 1175,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 343630,
      "end_ms": 344530,
      "text": "属于什么律？",
      "token_start": 1201,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 344570,
      "end_ms": 347410,
      "text": "跟其他诸侯国的律怎么对应？",
      "token_start": 1206,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 348430,
      "end_ms": 349930,
      "text": "这套编钟出土之前，",
      "token_start": 1218,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 350290,
      "end_ms": 354290,
      "text": "学术界一直认为十二律是从西方传入中国的。",
      "token_start": 1226,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 355010,
      "end_ms": 359210,
      "text": "他一出土这个论断被彻底推翻，",
      "token_start": 1245,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 359630,
      "end_ms": 365010,
      "text": "两千四百多年前的中国人已经把音乐玩到了这个高度。",
      "token_start": 1258,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 365690,
      "end_ms": 366990,
      "text": "从第十到第六，",
      "token_start": 1281,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 367270,
      "end_ms": 369400,
      "text": "银湖封存了盛世的境。",
      "token_start": 1287,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 369440,
      "end_ms": 369705,
      "text": "嗯嗯，",
      "token_start": 1296,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 370240,
      "end_ms": 372565,
      "text": "御医封存了一个人的身体，",
      "token_start": 1298,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 373150,
      "end_ms": 377215,
      "text": "玛瑙杯放出了石头里的兽勾践剑，",
      "token_start": 1309,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 377510,
      "end_ms": 379385,
      "text": "打开了两千年的时光，",
      "token_start": 1323,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 380200,
      "end_ms": 382555,
      "text": "编钟改写了世界音乐史。",
      "token_start": 1332,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 382800,
      "end_ms": 385080,
      "text": "可这舞剑还不是最正果的，",
      "token_start": 1342,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 385100,
      "end_ms": 388910,
      "text": "接下来第五到第一一件比一件震撼，",
      "token_start": 1353,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 388970,
      "end_ms": 392530,
      "text": "有一件身上刻着武王伐纣的准确日期。",
      "token_start": 1368,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 392730,
      "end_ms": 394395,
      "text": "有一件八千多公斤，",
      "token_start": 1384,
      "token_end_exclusive": 1392
    },
    {
      "start_ms": 394850,
      "end_ms": 397010,
      "text": "是全世界最重的青铜器，",
      "token_start": 1392,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 397130,
      "end_ms": 401225,
      "text": "还有一件被称作中国文化遗产的标志，",
      "token_start": 1402,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 401630,
      "end_ms": 402805,
      "text": "他们是哪几件？",
      "token_start": 1418,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 403240,
      "end_ms": 406205,
      "text": "凭什么排前面下集马上更新，",
      "token_start": 1424,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 406710,
      "end_ms": 410385,
      "text": "您先点个关注点开头像别走丢。",
      "token_start": 1436,
      "token_end_exclusive": 1449
    }
  ],
