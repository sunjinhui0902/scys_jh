{
  "video_id": "v_eaa1f34d8a000b69",
  "duration_s": 522.471995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_eaa1f34d8a000b69.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_eaa1f34d8a000b69.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 830,
      "end_ms": 2610,
      "text": "明天李总那边有个项目要谈，",
      "token_start": 0,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 2610,
      "end_ms": 4650,
      "text": "你俩跟我一起去什么项目啊？",
      "token_start": 12,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 4650,
      "end_ms": 5070,
      "text": "王姐，",
      "token_start": 24,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6950,
      "end_ms": 8430,
      "text": "一千万哦，",
      "token_start": 26,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 9110,
      "end_ms": 9790,
      "text": "这么大，",
      "token_start": 30,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 10210,
      "end_ms": 11890,
      "text": "这个项目李总很重视，",
      "token_start": 33,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 12170,
      "end_ms": 13730,
      "text": "你俩跟着我说话，",
      "token_start": 42,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 13750,
      "end_ms": 14810,
      "text": "做事都注意点，",
      "token_start": 49,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 14990,
      "end_ms": 15390,
      "text": "没问题。",
      "token_start": 55,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 15390,
      "end_ms": 15810,
      "text": "王姐，",
      "token_start": 58,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 15950,
      "end_ms": 16370,
      "text": "放心吧，",
      "token_start": 60,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 16370,
      "end_ms": 17785,
      "text": "王姐肯定不给您丢脸。",
      "token_start": 63,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 22710,
      "end_ms": 23150,
      "text": "李总，",
      "token_start": 72,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 23190,
      "end_ms": 23910,
      "text": "好久不见。",
      "token_start": 74,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 24230,
      "end_ms": 26130,
      "text": "关于这个项目的核心技术壁垒，",
      "token_start": 78,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 26130,
      "end_ms": 27130,
      "text": "你们是如何考虑的？",
      "token_start": 91,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 27330,
      "end_ms": 29570,
      "text": "我们的技术团队已经完成了三代迭代，",
      "token_start": 99,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 29850,
      "end_ms": 33505,
      "text": "目前的方案在稳定性和成本控制上都具备行业领先优势。",
      "token_start": 115,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 35790,
      "end_ms": 36370,
      "text": "小张啊，",
      "token_start": 139,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 37090,
      "end_ms": 40130,
      "text": "你是第一个十来分钟就能把项目谈下来的人，",
      "token_start": 142,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 40810,
      "end_ms": 41970,
      "text": "真是后生可畏啊，",
      "token_start": 161,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 42470,
      "end_ms": 44950,
      "text": "哪里哪里还是我们王姐厉害，",
      "token_start": 168,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 45310,
      "end_ms": 51110,
      "text": "我就是个打辅助的合同，",
      "token_start": 180,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 51110,
      "end_ms": 52110,
      "text": "今天先不着急签。",
      "token_start": 190,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 52470,
      "end_ms": 54070,
      "text": "李总还有什么问题吗？",
      "token_start": 197,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 54310,
      "end_ms": 56930,
      "text": "没什么这么大的项目，",
      "token_start": 206,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 57250,
      "end_ms": 58170,
      "text": "我再考虑考虑。",
      "token_start": 215,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 58590,
      "end_ms": 59010,
      "text": "李总，",
      "token_start": 221,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 59130,
      "end_ms": 62590,
      "text": "这正好明天晚上我组了个局陈，",
      "token_start": 223,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 62590,
      "end_ms": 63325,
      "text": "总也会过来。",
      "token_start": 236,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 63830,
      "end_ms": 65965,
      "text": "王杰要是有时间一起吃个饭，",
      "token_start": 241,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 66970,
      "end_ms": 67810,
      "text": "李总邀请，",
      "token_start": 253,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 67890,
      "end_ms": 68995,
      "text": "那肯定有时间。",
      "token_start": 257,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 70360,
      "end_ms": 70605,
      "text": "行，",
      "token_start": 263,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 71360,
      "end_ms": 72480,
      "text": "那项目的事儿，",
      "token_start": 264,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 72500,
      "end_ms": 73425,
      "text": "咱们明天再聊。",
      "token_start": 270,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 76380,
      "end_ms": 76835,
      "text": "王姐，",
      "token_start": 276,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 79270,
      "end_ms": 81090,
      "text": "刚才项目不是都已经谈好了吗？",
      "token_start": 278,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 81330,
      "end_ms": 82535,
      "text": "合同都准备签了，",
      "token_start": 291,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 82980,
      "end_ms": 84375,
      "text": "李总怎么突然又说要考虑，",
      "token_start": 298,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 84900,
      "end_ms": 86745,
      "text": "你自己想想刚才说什么了，",
      "token_start": 309,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 86950,
      "end_ms": 88095,
      "text": "我也没说什么啊。",
      "token_start": 320,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 88450,
      "end_ms": 89130,
      "text": "李总夸我，",
      "token_start": 327,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 89130,
      "end_ms": 90135,
      "text": "我就是谦虚了一下，",
      "token_start": 331,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 90610,
      "end_ms": 91810,
      "text": "总不能人家夸我两句，",
      "token_start": 339,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 91810,
      "end_ms": 92630,
      "text": "我还真认了吧。",
      "token_start": 348,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 92730,
      "end_ms": 95370,
      "text": "李总夸你是认可你的能力，",
      "token_start": 354,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 95830,
      "end_ms": 96690,
      "text": "结果你倒好，",
      "token_start": 365,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 96910,
      "end_ms": 98230,
      "text": "自己先告诉人家，",
      "token_start": 370,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 98290,
      "end_ms": 101715,
      "text": "你就是个打辅助的这句话有什么问题。",
      "token_start": 377,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 101940,
      "end_ms": 102935,
      "text": "一千万的项目，",
      "token_start": 393,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 103460,
      "end_ms": 104980,
      "text": "你自己都不敢认自己的能力，",
      "token_start": 399,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 105060,
      "end_ms": 106245,
      "text": "你让客户怎么放心？",
      "token_start": 411,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 107940,
      "end_ms": 108880,
      "text": "就因为这一句话，",
      "token_start": 419,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 109100,
      "end_ms": 111995,
      "text": "很多时候人家看的不只是你会不会做事，",
      "token_start": 426,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 112590,
      "end_ms": 114225,
      "text": "也看你会不会跟人打交道。",
      "token_start": 443,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 115270,
      "end_ms": 116850,
      "text": "那这个项目是不是没戏了？",
      "token_start": 454,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 116850,
      "end_ms": 117575,
      "text": "还有机会，",
      "token_start": 465,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 117880,
      "end_ms": 119925,
      "text": "这个项目光提成都不止一百万。",
      "token_start": 469,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 120640,
      "end_ms": 122300,
      "text": "李总既然没有直接拒绝，",
      "token_start": 482,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 122480,
      "end_ms": 124055,
      "text": "还主动约了明天的饭局，",
      "token_start": 492,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 124390,
      "end_ms": 125695,
      "text": "就说明事情还有转机，",
      "token_start": 502,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 126090,
      "end_ms": 127630,
      "text": "能不能把这个项目拿下来，",
      "token_start": 511,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 127710,
      "end_ms": 133920,
      "text": "就看你们两个明天的表现了哟。",
      "token_start": 522,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 134100,
      "end_ms": 134940,
      "text": "王姐来了，",
      "token_start": 535,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 135020,
      "end_ms": 135885,
      "text": "快坐快坐，",
      "token_start": 539,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 136610,
      "end_ms": 137345,
      "text": "不好意思，",
      "token_start": 543,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 137720,
      "end_ms": 138880,
      "text": "让两位久等了，",
      "token_start": 547,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 139080,
      "end_ms": 140845,
      "text": "哪里哪里都是自己人。",
      "token_start": 553,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 141440,
      "end_ms": 142055,
      "text": "嗯嗯的。",
      "token_start": 562,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 142450,
      "end_ms": 142700,
      "text": "嗯，",
      "token_start": 565,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 148080,
      "end_ms": 148775,
      "text": "小张啊，",
      "token_start": 566,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 149320,
      "end_ms": 150040,
      "text": "今天高兴，",
      "token_start": 569,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 150320,
      "end_ms": 152740,
      "text": "刚好李总和陈总都在你来讲两句。",
      "token_start": 573,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 152820,
      "end_ms": 154700,
      "text": "那祝大家吃好喝。",
      "token_start": 587,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 154700,
      "end_ms": 154880,
      "text": "好，",
      "token_start": 594,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 154880,
      "end_ms": 155340,
      "text": "我先干了，",
      "token_start": 595,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 155340,
      "end_ms": 166570,
      "text": "领导们随意王姐，",
      "token_start": 599,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 166790,
      "end_ms": 168335,
      "text": "那我也借这个机会说两句。",
      "token_start": 606,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 168630,
      "end_ms": 168995,
      "text": "好，",
      "token_start": 617,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 169500,
      "end_ms": 171840,
      "text": "你说非常感谢李总今天组的局，",
      "token_start": 618,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 171980,
      "end_ms": 173440,
      "text": "也感谢王姐带我们过来，",
      "token_start": 631,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 173460,
      "end_ms": 174860,
      "text": "让我们有幸认识各位前辈，",
      "token_start": 641,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 175120,
      "end_ms": 175875,
      "text": "我叫琳琳。",
      "token_start": 652,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 176270,
      "end_ms": 176830,
      "text": "俗话说，",
      "token_start": 656,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 176990,
      "end_ms": 178130,
      "text": "相聚是一种缘分。",
      "token_start": 659,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 178430,
      "end_ms": 179090,
      "text": "此时此刻，",
      "token_start": 666,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 179230,
      "end_ms": 181535,
      "text": "我把对各位的祝福化作一杯美酒，",
      "token_start": 670,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 181820,
      "end_ms": 182860,
      "text": "祝各位扶摇直上。",
      "token_start": 684,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 182860,
      "end_ms": 184900,
      "text": "九万里事业长虹节节高。",
      "token_start": 691,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 186120,
      "end_ms": 186555,
      "text": "好，",
      "token_start": 701,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 187000,
      "end_ms": 188205,
      "text": "这姑娘会说话。",
      "token_start": 702,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 192970,
      "end_ms": 193635,
      "text": "好好好，",
      "token_start": 708,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 194960,
      "end_ms": 196430,
      "text": "王姐来这杯，",
      "token_start": 711,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 196430,
      "end_ms": 196945,
      "text": "我敬你。",
      "token_start": 716,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 197200,
      "end_ms": 197425,
      "text": "哎，",
      "token_start": 719,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 200010,
      "end_ms": 200545,
      "text": "陈总，",
      "token_start": 720,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 200920,
      "end_ms": 202045,
      "text": "这杯我替王姐敬您，",
      "token_start": 722,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 203420,
      "end_ms": 204745,
      "text": "我敬的是你们领导，",
      "token_start": 730,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 205520,
      "end_ms": 206425,
      "text": "你是领导吗？",
      "token_start": 738,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 207200,
      "end_ms": 207995,
      "text": "瞧您说的，",
      "token_start": 743,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 208440,
      "end_ms": 209560,
      "text": "您敬的是我领导，",
      "token_start": 747,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 209640,
      "end_ms": 211465,
      "text": "我同样敬的也是领导，",
      "token_start": 754,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 211780,
      "end_ms": 212860,
      "text": "您敬领导是心意，",
      "token_start": 763,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 213060,
      "end_ms": 214960,
      "text": "我敬您是尊敬这杯，",
      "token_start": 770,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 214960,
      "end_ms": 215820,
      "text": "我敬的是生意，",
      "token_start": 778,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 215900,
      "end_ms": 216575,
      "text": "咱们随意，",
      "token_start": 784,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 216830,
      "end_ms": 218090,
      "text": "祝您生意一路长虹，",
      "token_start": 788,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 218170,
      "end_ms": 218905,
      "text": "万事顺利。",
      "token_start": 796,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 219290,
      "end_ms": 222050,
      "text": "哈哈哈哈哈这小姑娘会说话，",
      "token_start": 800,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 222130,
      "end_ms": 223740,
      "text": "琳莲刚才说的不错，",
      "token_start": 812,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 223860,
      "end_ms": 224660,
      "text": "来咱俩喝一个，",
      "token_start": 820,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 224660,
      "end_ms": 225265,
      "text": "谢谢陈总，",
      "token_start": 826,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 228020,
      "end_ms": 228305,
      "text": "哎，",
      "token_start": 830,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 229060,
      "end_ms": 230425,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 831,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 230690,
      "end_ms": 231880,
      "text": "陈总平底酒，",
      "token_start": 842,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 231880,
      "end_ms": 232735,
      "text": "这叫发财酒，",
      "token_start": 847,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 233080,
      "end_ms": 234040,
      "text": "到底发财好事，",
      "token_start": 852,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 234040,
      "end_ms": 237050,
      "text": "再来好一个发财酒。",
      "token_start": 858,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 237210,
      "end_ms": 237715,
      "text": "琳琳，",
      "token_start": 866,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 238490,
      "end_ms": 240025,
      "text": "你这姑娘反应挺快，",
      "token_start": 868,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 240460,
      "end_ms": 243565,
      "text": "王姐手底下有你这样的员工省心啊。",
      "token_start": 876,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 244090,
      "end_ms": 244470,
      "text": "李总，",
      "token_start": 891,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 244470,
      "end_ms": 245175,
      "text": "您过奖了，",
      "token_start": 893,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 245480,
      "end_ms": 248795,
      "text": "主要是王姐平时带的好强将手下吴若斌，",
      "token_start": 897,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 249150,
      "end_ms": 252675,
      "text": "我总不能给我们王姐丢脸啊哈哈哈哈哈。",
      "token_start": 914,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 253180,
      "end_ms": 253725,
      "text": "王姐，",
      "token_start": 931,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 254090,
      "end_ms": 255595,
      "text": "你手底下这个姑娘不错，",
      "token_start": 933,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 256530,
      "end_ms": 258555,
      "text": "年轻人还得多跟您学习。",
      "token_start": 943,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 261040,
      "end_ms": 265405,
      "text": "哈哈哈哈哈哈王姐李总，",
      "token_start": 953,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 266340,
      "end_ms": 268345,
      "text": "昨天那个一千万的项目，",
      "token_start": 963,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 269950,
      "end_ms": 270945,
      "text": "我考虑好了，",
      "token_start": 973,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 271520,
      "end_ms": 272715,
      "text": "项目可以继续合作。",
      "token_start": 978,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 273150,
      "end_ms": 274025,
      "text": "不过我有个条件，",
      "token_start": 986,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 274850,
      "end_ms": 275290,
      "text": "李总，",
      "token_start": 993,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 275350,
      "end_ms": 279005,
      "text": "您说这个项目后面我希望让琳琳来负责。",
      "token_start": 995,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 281450,
      "end_ms": 282025,
      "text": "李总，",
      "token_start": 1012,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 282450,
      "end_ms": 284995,
      "text": "我对小张的业务能力没问题，",
      "token_start": 1014,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 285460,
      "end_ms": 286935,
      "text": "这一点昨天我就看出来了。",
      "token_start": 1026,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 287670,
      "end_ms": 290830,
      "text": "不过这么大的项目后面少不了跟各种人打交道。",
      "token_start": 1037,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 290930,
      "end_ms": 294180,
      "text": "今天晚上我也一直在观察你们两个这个项目，",
      "token_start": 1057,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 294180,
      "end_ms": 294760,
      "text": "交给琳琳，",
      "token_start": 1076,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 294760,
      "end_ms": 295395,
      "text": "我更放心，",
      "token_start": 1080,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 296360,
      "end_ms": 297335,
      "text": "谢谢李总信任，",
      "token_start": 1084,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 297610,
      "end_ms": 298250,
      "text": "也谢谢王姐，",
      "token_start": 1090,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 298250,
      "end_ms": 298925,
      "text": "给我这个机会。",
      "token_start": 1095,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 299250,
      "end_ms": 300630,
      "text": "后面有什么做的不到位的地方，",
      "token_start": 1101,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 300670,
      "end_ms": 301710,
      "text": "还得请两位多指点，",
      "token_start": 1114,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 301710,
      "end_ms": 302465,
      "text": "那就这么定了。",
      "token_start": 1122,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 305880,
      "end_ms": 308780,
      "text": "琳琳李总那边合同已经确定了，",
      "token_start": 1128,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 309060,
      "end_ms": 310700,
      "text": "后面这个项目你来负责，",
      "token_start": 1141,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 311160,
      "end_ms": 311820,
      "text": "谢谢王姐，",
      "token_start": 1151,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 311960,
      "end_ms": 312900,
      "text": "我一定把它做好，",
      "token_start": 1155,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 313080,
      "end_ms": 314435,
      "text": "有不懂的地方随时问我，",
      "token_start": 1162,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 317580,
      "end_ms": 319840,
      "text": "黄姐怎么了？",
      "token_start": 1172,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 320140,
      "end_ms": 322460,
      "text": "这个项目前两天明明是我谈下来的，",
      "token_start": 1177,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 322980,
      "end_ms": 325319,
      "text": "李总问的那些业务问题也是我回答的，",
      "token_start": 1192,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 326020,
      "end_ms": 328180,
      "text": "为什么最后负责人却变成琳玲了？",
      "token_start": 1208,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 328340,
      "end_ms": 334660,
      "text": "你真不知道为什么业务上你不比玲玲差，",
      "token_start": 1222,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 335160,
      "end_ms": 336820,
      "text": "甚至前两天谈项目的时候，",
      "token_start": 1239,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 336820,
      "end_ms": 337660,
      "text": "你表现的很好，",
      "token_start": 1250,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 338140,
      "end_ms": 339980,
      "text": "可为什么都已经准备签合同了。",
      "token_start": 1256,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 340360,
      "end_ms": 341720,
      "text": "李总突然又不签了，",
      "token_start": 1269,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 342460,
      "end_ms": 344000,
      "text": "再想想昨天晚上的饭局，",
      "token_start": 1277,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 344720,
      "end_ms": 346020,
      "text": "我突然让你讲两句，",
      "token_start": 1287,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 346200,
      "end_ms": 346980,
      "text": "你说了什么？",
      "token_start": 1295,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 347000,
      "end_ms": 347700,
      "text": "大家吃好喝。",
      "token_start": 1300,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 347700,
      "end_ms": 347940,
      "text": "好，",
      "token_start": 1305,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 348080,
      "end_ms": 348780,
      "text": "我先干了。",
      "token_start": 1306,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 348920,
      "end_ms": 349800,
      "text": "陈总问玲玲，",
      "token_start": 1310,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 349900,
      "end_ms": 350820,
      "text": "你是领导吗？",
      "token_start": 1315,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 350940,
      "end_ms": 351760,
      "text": "如果换成你，",
      "token_start": 1320,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 351840,
      "end_ms": 352900,
      "text": "你知道怎么接吗？",
      "token_start": 1325,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 354140,
      "end_ms": 354600,
      "text": "陈总，",
      "token_start": 1332,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 354600,
      "end_ms": 355660,
      "text": "杯子里知倒半杯酒，",
      "token_start": 1334,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 355660,
      "end_ms": 358235,
      "text": "如果是你你的第一反应是什么？",
      "token_start": 1342,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 359670,
      "end_ms": 361565,
      "text": "可能先跟陈总道歉，",
      "token_start": 1355,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 361920,
      "end_ms": 362855,
      "text": "这就是区别。",
      "token_start": 1363,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 363330,
      "end_ms": 364395,
      "text": "你不是能力不行，",
      "token_start": 1368,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 364840,
      "end_ms": 365900,
      "text": "是这么大的项目，",
      "token_start": 1375,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 366020,
      "end_ms": 367020,
      "text": "除了把事情做好，",
      "token_start": 1382,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 367320,
      "end_ms": 369160,
      "text": "还要面对客户、合作方，",
      "token_start": 1389,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 369240,
      "end_ms": 370545,
      "text": "还有各种突发情况。",
      "token_start": 1398,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 371600,
      "end_ms": 372800,
      "text": "李总最后选琳琳，",
      "token_start": 1406,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 372880,
      "end_ms": 375005,
      "text": "不是因为她比你会说几句漂亮话，",
      "token_start": 1413,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 375600,
      "end_ms": 379975,
      "text": "是因为昨天晚上他都在看你们两个人遇到事情的时候怎么处理，",
      "token_start": 1427,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 381150,
      "end_ms": 383265,
      "text": "别光想着自己为什么没拿到，",
      "token_start": 1454,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 383920,
      "end_ms": 391570,
      "text": "好好想想玲玲为什么能拿到练练，",
      "token_start": 1466,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 391680,
      "end_ms": 392740,
      "text": "刚才我确实有点不服。",
      "token_start": 1480,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 392800,
      "end_ms": 393105,
      "text": "嗯，",
      "token_start": 1489,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 393360,
      "end_ms": 394805,
      "text": "毕竟这个项目前两天是我谈的，",
      "token_start": 1490,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 394980,
      "end_ms": 396875,
      "text": "李总问的那些业务问题也是我回答的。",
      "token_start": 1503,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 397590,
      "end_ms": 398710,
      "text": "但是王姐刚才说完，",
      "token_start": 1519,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 398870,
      "end_ms": 399825,
      "text": "我仔细想了想，",
      "token_start": 1527,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 400410,
      "end_ms": 402305,
      "text": "我好像明白李总为什么最后选你了。",
      "token_start": 1533,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 402580,
      "end_ms": 405390,
      "text": "为什么业务上的问题我会回答。",
      "token_start": 1548,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 405590,
      "end_ms": 406930,
      "text": "可一碰到这种突发情况，",
      "token_start": 1561,
      "token_end_exclusive": 1571
    },
    {
      "start_ms": 406930,
      "end_ms": 408315,
      "text": "我就嘴笨反应慢，",
      "token_start": 1571,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 408970,
      "end_ms": 411280,
      "text": "但有件事我还是没想明白什么。",
      "token_start": 1578,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 411420,
      "end_ms": 412400,
      "text": "李总夸我的时候，",
      "token_start": 1591,
      "token_end_exclusive": 1598
    },
    {
      "start_ms": 412400,
      "end_ms": 413465,
      "text": "我把功劳给了王姐。",
      "token_start": 1598,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 413680,
      "end_ms": 414620,
      "text": "后来李总夸你的时候，",
      "token_start": 1606,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 414620,
      "end_ms": 415725,
      "text": "你也把功劳给了王姐。",
      "token_start": 1615,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 416010,
      "end_ms": 416670,
      "text": "可我说完，",
      "token_start": 1624,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 416690,
      "end_ms": 418005,
      "text": "人家合同都不想签了。",
      "token_start": 1628,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 418390,
      "end_ms": 418930,
      "text": "你说完，",
      "token_start": 1637,
      "token_end_exclusive": 1640
    },
    {
      "start_ms": 418930,
      "end_ms": 420125,
      "text": "人家反而越来越认可你。",
      "token_start": 1640,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 420470,
      "end_ms": 423125,
      "text": "因为谦虚不等于否定自己啊，",
      "token_start": 1650,
      "token_end_exclusive": 1662
    },
    {
      "start_ms": 423490,
      "end_ms": 424535,
      "text": "你可以抬高别人，",
      "token_start": 1662,
      "token_end_exclusive": 1669
    },
    {
      "start_ms": 424840,
      "end_ms": 426280,
      "text": "但是没必要把自己压下去。",
      "token_start": 1669,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 426420,
      "end_ms": 427005,
      "text": "什么意思？",
      "token_start": 1680,
      "token_end_exclusive": 1684
    },
    {
      "start_ms": 427230,
      "end_ms": 428570,
      "text": "比如那天李总夸你，",
      "token_start": 1684,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 428590,
      "end_ms": 429350,
      "text": "后生可畏，",
      "token_start": 1692,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 429510,
      "end_ms": 431375,
      "text": "你完全可以说李总过奖了。",
      "token_start": 1696,
      "token_end_exclusive": 1707
    },
    {
      "start_ms": 431660,
      "end_ms": 432940,
      "text": "要不是您愿意给机会，",
      "token_start": 1707,
      "token_end_exclusive": 1716
    },
    {
      "start_ms": 433080,
      "end_ms": 435055,
      "text": "我哪能跟您这么有魄力的人合作啊，",
      "token_start": 1716,
      "token_end_exclusive": 1731
    },
    {
      "start_ms": 435300,
      "end_ms": 436725,
      "text": "以后还得跟您多学呢。",
      "token_start": 1731,
      "token_end_exclusive": 1740
    },
    {
      "start_ms": 437030,
      "end_ms": 439410,
      "text": "这样既没有把功劳全揽到自己身上，",
      "token_start": 1740,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 439510,
      "end_ms": 441275,
      "text": "也没有把自己说的一文不值。",
      "token_start": 1755,
      "token_end_exclusive": 1767
    },
    {
      "start_ms": 441770,
      "end_ms": 442595,
      "text": "可是还有个问题，",
      "token_start": 1767,
      "token_end_exclusive": 1774
    },
    {
      "start_ms": 443350,
      "end_ms": 444530,
      "text": "昨天陈总突然问你，",
      "token_start": 1774,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 444730,
      "end_ms": 445530,
      "text": "你是领导吗？",
      "token_start": 1782,
      "token_end_exclusive": 1787
    },
    {
      "start_ms": 445690,
      "end_ms": 447185,
      "text": "还有倒酒突然只剩半杯，",
      "token_start": 1787,
      "token_end_exclusive": 1797
    },
    {
      "start_ms": 447630,
      "end_ms": 448925,
      "text": "这些又没人提前告诉你，",
      "token_start": 1797,
      "token_end_exclusive": 1807
    },
    {
      "start_ms": 449590,
      "end_ms": 451435,
      "text": "你为什么每次马上就知道怎么接。",
      "token_start": 1807,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 452360,
      "end_ms": 454320,
      "text": "你别告诉我这些全都是林场想的。",
      "token_start": 1821,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 454480,
      "end_ms": 455285,
      "text": "当然不是，",
      "token_start": 1835,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 455730,
      "end_ms": 457075,
      "text": "那你到底是怎么练的？",
      "token_start": 1839,
      "token_end_exclusive": 1848
    },
    {
      "start_ms": 457830,
      "end_ms": 459295,
      "text": "其实我以前跟你一样，",
      "token_start": 1848,
      "token_end_exclusive": 1857
    },
    {
      "start_ms": 459760,
      "end_ms": 460520,
      "text": "不爱说话，",
      "token_start": 1857,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 460700,
      "end_ms": 461525,
      "text": "不爱争辩，",
      "token_start": 1861,
      "token_end_exclusive": 1865
    },
    {
      "start_ms": 461890,
      "end_ms": 464415,
      "text": "一到这种场合就不知道应该说什么。",
      "token_start": 1865,
      "token_end_exclusive": 1880
    },
    {
      "start_ms": 464910,
      "end_ms": 467365,
      "text": "后来我就经常看这本闲谈高手，",
      "token_start": 1880,
      "token_end_exclusive": 1893
    },
    {
      "start_ms": 467790,
      "end_ms": 469150,
      "text": "它里面就是一个场景，",
      "token_start": 1893,
      "token_end_exclusive": 1902
    },
    {
      "start_ms": 469150,
      "end_ms": 470425,
      "text": "一个场景的告诉你，",
      "token_start": 1902,
      "token_end_exclusive": 1910
    },
    {
      "start_ms": 470660,
      "end_ms": 473035,
      "text": "遇到不同的人不同的话应该怎么接。",
      "token_start": 1910,
      "token_end_exclusive": 1925
    },
    {
      "start_ms": 473580,
      "end_ms": 474040,
      "text": "比如，",
      "token_start": 1925,
      "token_end_exclusive": 1927
    },
    {
      "start_ms": 474430,
      "end_ms": 475430,
      "text": "别人夸你优秀，",
      "token_start": 1927,
      "token_end_exclusive": 1933
    },
    {
      "start_ms": 475670,
      "end_ms": 476465,
      "text": "你可以回，",
      "token_start": 1933,
      "token_end_exclusive": 1937
    },
    {
      "start_ms": 476920,
      "end_ms": 478140,
      "text": "那是不优秀点儿，",
      "token_start": 1937,
      "token_end_exclusive": 1944
    },
    {
      "start_ms": 478140,
      "end_ms": 479380,
      "text": "怎么能和你做朋友呢？",
      "token_start": 1944,
      "token_end_exclusive": 1953
    },
    {
      "start_ms": 479580,
      "end_ms": 480980,
      "text": "当别人说你真聪明，",
      "token_start": 1953,
      "token_end_exclusive": 1961
    },
    {
      "start_ms": 481000,
      "end_ms": 482540,
      "text": "你就回近朱者赤，",
      "token_start": 1961,
      "token_end_exclusive": 1968
    },
    {
      "start_ms": 482660,
      "end_ms": 483580,
      "text": "和你在一起啊，",
      "token_start": 1968,
      "token_end_exclusive": 1974
    },
    {
      "start_ms": 483580,
      "end_ms": 485970,
      "text": "熏都熏出来了当领导跟你说，",
      "token_start": 1974,
      "token_end_exclusive": 1986
    },
    {
      "start_ms": 485970,
      "end_ms": 486590,
      "text": "辛苦了，",
      "token_start": 1986,
      "token_end_exclusive": 1989
    },
    {
      "start_ms": 486730,
      "end_ms": 487950,
      "text": "你就回领导，",
      "token_start": 1989,
      "token_end_exclusive": 1994
    },
    {
      "start_ms": 488190,
      "end_ms": 489515,
      "text": "这都是我应该做的。",
      "token_start": 1994,
      "token_end_exclusive": 2002
    },
    {
      "start_ms": 489750,
      "end_ms": 491030,
      "text": "强将手下吴若兵，",
      "token_start": 2002,
      "token_end_exclusive": 2009
    },
    {
      "start_ms": 491150,
      "end_ms": 492490,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 2009,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 492690,
      "end_ms": 494625,
      "text": "难怪你每次都能接的这么快，",
      "token_start": 2018,
      "token_end_exclusive": 2030
    },
    {
      "start_ms": 495100,
      "end_ms": 496725,
      "text": "这种东西不是天生的，",
      "token_start": 2030,
      "token_end_exclusive": 2039
    },
    {
      "start_ms": 497070,
      "end_ms": 498450,
      "text": "就是平时一个场景，",
      "token_start": 2039,
      "token_end_exclusive": 2047
    },
    {
      "start_ms": 498450,
      "end_ms": 499210,
      "text": "一个场景的看，",
      "token_start": 2047,
      "token_end_exclusive": 2053
    },
    {
      "start_ms": 499430,
      "end_ms": 499990,
      "text": "一个场景，",
      "token_start": 2053,
      "token_end_exclusive": 2057
    },
    {
      "start_ms": 499990,
      "end_ms": 500865,
      "text": "一个场景的练。",
      "token_start": 2057,
      "token_end_exclusive": 2063
    },
    {
      "start_ms": 501350,
      "end_ms": 502295,
      "text": "每天看两页，",
      "token_start": 2063,
      "token_end_exclusive": 2068
    },
    {
      "start_ms": 502650,
      "end_ms": 504630,
      "text": "慢慢积累一些不同的场景之下，",
      "token_start": 2068,
      "token_end_exclusive": 2081
    },
    {
      "start_ms": 504630,
      "end_ms": 505495,
      "text": "应该怎么说。",
      "token_start": 2081,
      "token_end_exclusive": 2086
    },
    {
      "start_ms": 505970,
      "end_ms": 507995,
      "text": "所以你平时就是这么练的对啊，",
      "token_start": 2086,
      "token_end_exclusive": 2099
    },
    {
      "start_ms": 508400,
      "end_ms": 510140,
      "text": "每天不用看很多看两页，",
      "token_start": 2099,
      "token_end_exclusive": 2109
    },
    {
      "start_ms": 510220,
      "end_ms": 513760,
      "text": "碰到自己觉得有用的表达就记一记慢慢积累的多了。",
      "token_start": 2109,
      "token_end_exclusive": 2131
    },
    {
      "start_ms": 513780,
      "end_ms": 515845,
      "text": "工作和生活里再碰到类似的场景，",
      "token_start": 2131,
      "token_end_exclusive": 2145
    },
    {
      "start_ms": 516060,
      "end_ms": 517255,
      "text": "你就知道怎么接了。",
      "token_start": 2145,
      "token_end_exclusive": 2153
    },
    {
      "start_ms": 517930,
      "end_ms": 518855,
      "text": "这本先借我看看，",
      "token_start": 2153,
      "token_end_exclusive": 2160
    },
    {
      "start_ms": 519420,
      "end_ms": 519960,
      "text": "拿去吧，",
      "token_start": 2160,
      "token_end_exclusive": 2163
    },
    {
      "start_ms": 519960,
      "end_ms": 520815,
      "text": "回去慢慢看。",
      "token_start": 2163,
      "token_end_exclusive": 2168
    }
