{
  "video_id": "v_f43b6f1228c21749",
  "duration_s": 213.25,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f43b6f1228c21749.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f43b6f1228c21749.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 280,
      "end_ms": 2980,
      "text": "妈妈为啥商场一楼全是化妆品、珠宝，",
      "token_start": 0,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3340,
      "end_ms": 4960,
      "text": "吃饭、看电影却都在顶楼，",
      "token_start": 15,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 5640,
      "end_ms": 6860,
      "text": "因为顶楼风景好，",
      "token_start": 25,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 7060,
      "end_ms": 9020,
      "text": "吃饭香一楼太吵了呗，",
      "token_start": 32,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 9820,
      "end_ms": 12180,
      "text": "这都讲不清楚孩子以后怎么学做生意。",
      "token_start": 41,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 12500,
      "end_ms": 12900,
      "text": "妈妈，",
      "token_start": 57,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 12900,
      "end_ms": 13920,
      "text": "我知道是为什么？",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 14020,
      "end_ms": 15420,
      "text": "因为一楼人流量大，",
      "token_start": 66,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 15720,
      "end_ms": 18280,
      "text": "大家都要经过有人会冲动消费，",
      "token_start": 74,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 18700,
      "end_ms": 21965,
      "text": "这是经济学启蒙课里提到过的瀑布效应。",
      "token_start": 87,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 24400,
      "end_ms": 27500,
      "text": "妈妈商场里面停车为什么比我们小区贵呀？",
      "token_start": 104,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 28000,
      "end_ms": 29300,
      "text": "因为商场地段好，",
      "token_start": 122,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 29380,
      "end_ms": 30560,
      "text": "所以停车自然贵，",
      "token_start": 129,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 31320,
      "end_ms": 33000,
      "text": "只知道地段好停车费。",
      "token_start": 136,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 33000,
      "end_ms": 36125,
      "text": "为什么贵都讲不清楚孩子以后怎么学会控制成本。",
      "token_start": 145,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 39320,
      "end_ms": 39760,
      "text": "妈妈，",
      "token_start": 166,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 39940,
      "end_ms": 41000,
      "text": "同样是矿泉水，",
      "token_start": 168,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 41280,
      "end_ms": 42920,
      "text": "为什么高铁上卖这么贵啊？",
      "token_start": 174,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 43580,
      "end_ms": 43820,
      "text": "嗯，",
      "token_start": 185,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 43980,
      "end_ms": 45020,
      "text": "高铁上就是贵，",
      "token_start": 186,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 45240,
      "end_ms": 46860,
      "text": "咱们自己带水喝就好了。",
      "token_start": 192,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 47520,
      "end_ms": 51940,
      "text": "连那么基础的经济学原理都讲不清楚孩子以后怎么发现商机。",
      "token_start": 202,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 52120,
      "end_ms": 52660,
      "text": "你想想，",
      "token_start": 228,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 52960,
      "end_ms": 55179,
      "text": "如果高铁上允许外面的人上来卖水，",
      "token_start": 231,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 55300,
      "end_ms": 56300,
      "text": "他还卖这么贵吗？",
      "token_start": 246,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 56840,
      "end_ms": 58160,
      "text": "就是因为只有他能卖，",
      "token_start": 253,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 58300,
      "end_ms": 59180,
      "text": "你又渴的不行，",
      "token_start": 262,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 59480,
      "end_ms": 60735,
      "text": "所以再贵你也得买。",
      "token_start": 268,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 61110,
      "end_ms": 63665,
      "text": "这是经济学启蒙课里提到的独家生意。",
      "token_start": 276,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 64350,
      "end_ms": 66190,
      "text": "妈妈自助餐随便吃，",
      "token_start": 292,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 66550,
      "end_ms": 68335,
      "text": "老板为什么还能赚钱啊？",
      "token_start": 300,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 68910,
      "end_ms": 70070,
      "text": "大部分人吃不多，",
      "token_start": 310,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 70270,
      "end_ms": 71555,
      "text": "所以老板不会亏。",
      "token_start": 317,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 72300,
      "end_ms": 74660,
      "text": "连自助餐厅为什么赚钱都给孩子讲，",
      "token_start": 324,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 74660,
      "end_ms": 76645,
      "text": "不清楚孩子以后怎么赚钱？",
      "token_start": 339,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 79760,
      "end_ms": 81360,
      "text": "妈妈猪肉便宜了，",
      "token_start": 350,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 81380,
      "end_ms": 83145,
      "text": "吃的人应该更多才对啊。",
      "token_start": 357,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 83410,
      "end_ms": 85545,
      "text": "为什么说猪肉销量反而下降了？",
      "token_start": 367,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 86080,
      "end_ms": 87620,
      "text": "可能大家兜里没钱了吧，",
      "token_start": 380,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 87820,
      "end_ms": 89125,
      "text": "穷了就少吃肉呗。",
      "token_start": 390,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 89550,
      "end_ms": 94025,
      "text": "也可能跟附近工地开工少了有关工地跟猪肉有什么关系？",
      "token_start": 397,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 94380,
      "end_ms": 95580,
      "text": "比如工地食堂，",
      "token_start": 421,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 95620,
      "end_ms": 97710,
      "text": "原来每天要买不少肉开工，",
      "token_start": 427,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 97710,
      "end_ms": 98170,
      "text": "少了，",
      "token_start": 438,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 98250,
      "end_ms": 99050,
      "text": "吃饭的人少，",
      "token_start": 440,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 99330,
      "end_ms": 100715,
      "text": "采购也可能跟着减。",
      "token_start": 445,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 101270,
      "end_ms": 102025,
      "text": "不光是肉，",
      "token_start": 453,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 102420,
      "end_ms": 104135,
      "text": "蔬菜米面也可能受影响。",
      "token_start": 457,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 104510,
      "end_ms": 106875,
      "text": "一个地方的变化会连着影响别的生意。",
      "token_start": 467,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 107780,
      "end_ms": 112205,
      "text": "这我确实没想到妈妈为什么牛奶是方盒子，",
      "token_start": 483,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 112550,
      "end_ms": 114175,
      "text": "可乐却是圆瓶子。",
      "token_start": 501,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 116080,
      "end_ms": 117675,
      "text": "厂家就是这么设计的，",
      "token_start": 508,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 117980,
      "end_ms": 119965,
      "text": "具体原因我也不太清楚。",
      "token_start": 517,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 120350,
      "end_ms": 121570,
      "text": "可乐内部有气压，",
      "token_start": 527,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 121850,
      "end_ms": 124135,
      "text": "圆形瓶身可以均匀分散压力。",
      "token_start": 534,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 124450,
      "end_ms": 125510,
      "text": "牛奶没有气压，",
      "token_start": 546,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 125770,
      "end_ms": 128745,
      "text": "方形盒子可以省下冷柜的仓储空间，",
      "token_start": 552,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 129060,
      "end_ms": 130085,
      "text": "降低商家成本。",
      "token_start": 567,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 130620,
      "end_ms": 132040,
      "text": "你们怎么什么都知道，",
      "token_start": 573,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 132340,
      "end_ms": 133365,
      "text": "我啥都不懂，",
      "token_start": 582,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 134770,
      "end_ms": 135550,
      "text": "这多亏了我。",
      "token_start": 587,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 135550,
      "end_ms": 142335,
      "text": "妈妈从小陪我看写给孩子的漫画经济学里面把这些商业模式全化成漫画故事了。",
      "token_start": 592,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 142570,
      "end_ms": 143445,
      "text": "一看就懂了。",
      "token_start": 626,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 143720,
      "end_ms": 144315,
      "text": "我妈说，",
      "token_start": 631,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 144630,
      "end_ms": 146250,
      "text": "一个人如果没有财商思维，",
      "token_start": 634,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 146550,
      "end_ms": 147845,
      "text": "长大要吃很多亏，",
      "token_start": 645,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 148320,
      "end_ms": 149685,
      "text": "所以我从小就在学。",
      "token_start": 652,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 150240,
      "end_ms": 152525,
      "text": "如果你不教导孩子金钱方面的知识，",
      "token_start": 660,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 152890,
      "end_ms": 155090,
      "text": "将来进入社会的他就像一张白纸，",
      "token_start": 675,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 155210,
      "end_ms": 157070,
      "text": "被人骗了也不自知错。",
      "token_start": 689,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 157070,
      "end_ms": 160720,
      "text": "把别人精心设计的陷阱当做自己的运气推荐。",
      "token_start": 698,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 160720,
      "end_ms": 161720,
      "text": "在孩子十岁前，",
      "token_start": 717,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 161920,
      "end_ms": 165740,
      "text": "父母陪他读这套写给孩子的漫画经济学这套书，",
      "token_start": 723,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 165740,
      "end_ms": 169380,
      "text": "用生动有趣的故事帮助孩子树立正确的金钱观。",
      "token_start": 743,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 169720,
      "end_ms": 171645,
      "text": "像我们花的钱是从哪儿来的？",
      "token_start": 763,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 171880,
      "end_ms": 173745,
      "text": "教会孩子认识金钱的来源，",
      "token_start": 775,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 174210,
      "end_ms": 175350,
      "text": "如何不盲目购物？",
      "token_start": 786,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 175570,
      "end_ms": 178034,
      "text": "教会孩子理性消费不乱花钱，",
      "token_start": 793,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 178250,
      "end_ms": 179670,
      "text": "玩具只能选一个怎么办？",
      "token_start": 805,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 179850,
      "end_ms": 181225,
      "text": "教会孩子学会取舍，",
      "token_start": 815,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 181470,
      "end_ms": 183245,
      "text": "把钱花在真正需要的地方。",
      "token_start": 823,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 183530,
      "end_ms": 184385,
      "text": "什么是打折？",
      "token_start": 834,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 184710,
      "end_ms": 186350,
      "text": "教会孩子正确看待优惠，",
      "token_start": 839,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 186370,
      "end_ms": 189275,
      "text": "不因为便宜就盲目购买记账的日子。",
      "token_start": 849,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 189510,
      "end_ms": 191110,
      "text": "教会孩子记录日常开销，",
      "token_start": 864,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 191350,
      "end_ms": 193010,
      "text": "养成管理零花钱的习惯。",
      "token_start": 874,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 193210,
      "end_ms": 194310,
      "text": "钱越多越好吗？",
      "token_start": 884,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 194530,
      "end_ms": 196210,
      "text": "引导孩子正确看待财富，",
      "token_start": 890,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 196230,
      "end_ms": 197645,
      "text": "树立健康的金钱观。",
      "token_start": 900,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 198010,
      "end_ms": 198990,
      "text": "让孩子从小明白，",
      "token_start": 908,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 198990,
      "end_ms": 199890,
      "text": "钱从哪里来，",
      "token_start": 915,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 199930,
      "end_ms": 200750,
      "text": "东西为什么有贵，",
      "token_start": 920,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 200750,
      "end_ms": 201405,
      "text": "有便宜，",
      "token_start": 927,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 201640,
      "end_ms": 202280,
      "text": "什么该买，",
      "token_start": 930,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 202420,
      "end_ms": 203220,
      "text": "什么不该买，",
      "token_start": 934,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 203240,
      "end_ms": 204500,
      "text": "慢慢学会合理花钱，",
      "token_start": 939,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 204620,
      "end_ms": 205395,
      "text": "管理金钱，",
      "token_start": 947,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 205640,
      "end_ms": 207145,
      "text": "培养独立思考的能力。",
      "token_start": 951,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 207440,
      "end_ms": 208360,
      "text": "家里有孩子的，",
      "token_start": 960,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 208360,
      "end_ms": 209520,
      "text": "真的可以准备一套，",
      "token_start": 966,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 209620,
      "end_ms": 210965,
      "text": "每天陪孩子看一点，",
      "token_start": 974,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 211170,
      "end_ms": 213065,
      "text": "让孩子从小建立财商思维。",
      "token_start": 982,
      "token_end_exclusive": 993
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
