  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1350,
      "text": "今天是九月九日，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1370,
      "end_ms": 3390,
      "text": "星期三又是一年九月九。",
      "token_start": 7,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4070,
      "end_ms": 7770,
      "text": "今天是毛泽东同志逝世五十周年纪念日，",
      "token_start": 17,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 8570,
      "end_ms": 11410,
      "text": "请停留三秒为他献朵花。",
      "token_start": 34,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12610,
      "end_ms": 14890,
      "text": "我们缅怀伟大领袖毛主席，",
      "token_start": 44,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 15330,
      "end_ms": 18310,
      "text": "是他带领人民浴血奋战，",
      "token_start": 55,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 18550,
      "end_ms": 19570,
      "text": "冲破苦难，",
      "token_start": 65,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 19890,
      "end_ms": 21130,
      "text": "建立新中国，",
      "token_start": 69,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 21810,
      "end_ms": 25490,
      "text": "换来我们今天幸福安宁的生活。",
      "token_start": 74,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 25990,
      "end_ms": 27170,
      "text": "饮水思源，",
      "token_start": 87,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 27650,
      "end_ms": 28610,
      "text": "不忘来路，",
      "token_start": 91,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 28970,
      "end_ms": 31660,
      "text": "踏实过好的当下的每一天。",
      "token_start": 95,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 32340,
      "end_ms": 36640,
      "text": "他是中国历史上第一个喊出人民万岁的领袖，",
      "token_start": 106,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 37260,
      "end_ms": 40520,
      "text": "他把自己的一生献给党和人民，",
      "token_start": 125,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 40640,
      "end_ms": 43940,
      "text": "留下了永志后人的崇高精神风范，",
      "token_start": 138,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 44720,
      "end_ms": 46980,
      "text": "对毛泽东同志的最好纪念，",
      "token_start": 152,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 47080,
      "end_ms": 50940,
      "text": "就是把他开创的事业继续推向前进。",
      "token_start": 163,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 52020,
      "end_ms": 52480,
      "text": "今天，",
      "token_start": 178,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 52820,
      "end_ms": 55300,
      "text": "缅怀一代伟人毛泽东，",
      "token_start": 180,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 55880,
      "end_ms": 59020,
      "text": "正所谓唯有牺牲多壮志感，",
      "token_start": 189,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 59020,
      "end_ms": 63565,
      "text": "交日月换新天伟人精神永济心间。",
      "token_start": 200,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 63870,
      "end_ms": 65715,
      "text": "愿五辈砥砺前行，",
      "token_start": 214,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 66070,
      "end_ms": 68980,
      "text": "家国长安加油。",
      "token_start": 221,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 69660,
      "end_ms": 74325,
      "text": "请在评论区打上嗯缅怀伟人毛泽东。",
      "token_start": 227,
      "token_end_exclusive": 242
    }
  ],
