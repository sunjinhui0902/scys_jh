{
  "video_id": "v_abf33f113a520cdb",
  "duration_s": 160.078005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_abf33f113a520cdb.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_abf33f113a520cdb.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 550,
      "end_ms": 950,
      "text": "Jj,",
      "token_start": 0,
      "token_end_exclusive": 1
    },
    {
      "start_ms": 1070,
      "end_ms": 1770,
      "text": "你相信吗？",
      "token_start": 1,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1890,
      "end_ms": 4170,
      "text": "世界上真的有一种没有脚的鸟，",
      "token_start": 5,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4370,
      "end_ms": 5670,
      "text": "它的一生一直在飞，",
      "token_start": 18,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6010,
      "end_ms": 6610,
      "text": "一辈子，",
      "token_start": 26,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6610,
      "end_ms": 7510,
      "text": "只落一次地。",
      "token_start": 29,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 7970,
      "end_ms": 9970,
      "text": "她是世界上最孤独的旅人，",
      "token_start": 34,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 10070,
      "end_ms": 11650,
      "text": "也是最长情的信徒。",
      "token_start": 45,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 11870,
      "end_ms": 13270,
      "text": "她叫北京雨燕，",
      "token_start": 53,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 13570,
      "end_ms": 16150,
      "text": "就是当年北京奥运吉祥物妮妮的原型，",
      "token_start": 59,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 16350,
      "end_ms": 16990,
      "text": "你知道吗？",
      "token_start": 75,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 17110,
      "end_ms": 20150,
      "text": "燕子南飞其实不是飞到我国的南方，",
      "token_start": 79,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 20250,
      "end_ms": 21830,
      "text": "而是一直飞到南非。",
      "token_start": 94,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 22050,
      "end_ms": 22430,
      "text": "没错，",
      "token_start": 102,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 22550,
      "end_ms": 25470,
      "text": "非洲南部什么补给装备都没有，",
      "token_start": 104,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 25510,
      "end_ms": 29010,
      "text": "凭借一双小小的翅膀就出发了我们的朋友。",
      "token_start": 117,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 29050,
      "end_ms": 30700,
      "text": "北京雨燕一入秋，",
      "token_start": 135,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 30700,
      "end_ms": 32500,
      "text": "这几天已经陆续出发了，",
      "token_start": 142,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 32760,
      "end_ms": 38660,
      "text": "他们可以在空中连续飞行十个月不落地睡觉、吃饭交配都在空中进行，",
      "token_start": 152,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 39040,
      "end_ms": 40520,
      "text": "即便身体仍在飞行。",
      "token_start": 181,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 40520,
      "end_ms": 42140,
      "text": "他的大脑却能陷入沉睡。",
      "token_start": 189,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 42460,
      "end_ms": 43640,
      "text": "他们从北京出发，",
      "token_start": 199,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 43660,
      "end_ms": 45260,
      "text": "经过蒙古到达中亚，",
      "token_start": 206,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 45280,
      "end_ms": 46619,
      "text": "再穿越阿拉伯沙漠，",
      "token_start": 214,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 46640,
      "end_ms": 47460,
      "text": "渡过红海。",
      "token_start": 222,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 47540,
      "end_ms": 49740,
      "text": "最终抵达南非高原海，",
      "token_start": 226,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 49740,
      "end_ms": 51480,
      "text": "不到一颗鸡蛋大的重量，",
      "token_start": 235,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 51520,
      "end_ms": 52680,
      "text": "飞越欧亚大陆，",
      "token_start": 245,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 52720,
      "end_ms": 54280,
      "text": "全程飞行三万里路。",
      "token_start": 251,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 54340,
      "end_ms": 55840,
      "text": "经过三十七个国家，",
      "token_start": 259,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 56120,
      "end_ms": 57400,
      "text": "里约一夫一妻制，",
      "token_start": 267,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 57440,
      "end_ms": 58780,
      "text": "终身只有一个半围，",
      "token_start": 274,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 58920,
      "end_ms": 61335,
      "text": "夫妻双方一起穿也山川荒漠。",
      "token_start": 282,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 61670,
      "end_ms": 63410,
      "text": "而今年刚出生的雨燕宝宝，",
      "token_start": 294,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 63570,
      "end_ms": 66210,
      "text": "要先于父母一步独自前往非洲，",
      "token_start": 305,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 66430,
      "end_ms": 68530,
      "text": "从此和父母山高水远，",
      "token_start": 318,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 68710,
      "end_ms": 69575,
      "text": "不再相见，",
      "token_start": 327,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 70010,
      "end_ms": 70530,
      "text": "在路上。",
      "token_start": 331,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 70530,
      "end_ms": 72430,
      "text": "他们要面对的是天敌的捕食，",
      "token_start": 334,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 72430,
      "end_ms": 73490,
      "text": "是恶劣的天气，",
      "token_start": 346,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 73690,
      "end_ms": 76735,
      "text": "唯一可以依靠的是不返航的勇气和信念。",
      "token_start": 352,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 77140,
      "end_ms": 79480,
      "text": "那你知道雨燕为什么能够不落地吗？",
      "token_start": 369,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 79580,
      "end_ms": 80620,
      "text": "一直到最近几年，",
      "token_start": 384,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 80620,
      "end_ms": 82675,
      "text": "科学家才发现了一个惊人的秘密，",
      "token_start": 391,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 82930,
      "end_ms": 85705,
      "text": "他们的飞行高度竟然接近了平流层。",
      "token_start": 405,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 86050,
      "end_ms": 87950,
      "text": "大部分生物都生活在对流层，",
      "token_start": 420,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 88130,
      "end_ms": 89785,
      "text": "我们会受到重力的拖拽。",
      "token_start": 432,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 90080,
      "end_ms": 91300,
      "text": "比如在坐飞机的时候，",
      "token_start": 442,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 91300,
      "end_ms": 92380,
      "text": "一旦突破颠簸了，",
      "token_start": 451,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 92380,
      "end_ms": 95485,
      "text": "对流层就会在平流层开启定速巡航。",
      "token_start": 458,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 95950,
      "end_ms": 97250,
      "text": "而在平流层的雨燕，",
      "token_start": 473,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 97430,
      "end_ms": 99190,
      "text": "它不需要剧烈的煽动翅膀，",
      "token_start": 481,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 99330,
      "end_ms": 101940,
      "text": "它只需要稍微张开双翼风，",
      "token_start": 492,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 101940,
      "end_ms": 103675,
      "text": "就会拖着他往前飞。",
      "token_start": 503,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 104260,
      "end_ms": 106540,
      "text": "雨燕在空中飞行的状态很像鸭子，",
      "token_start": 511,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 106540,
      "end_ms": 108795,
      "text": "在水里水的浮力会拖着它。",
      "token_start": 525,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 109060,
      "end_ms": 111075,
      "text": "我们的人生就像在对流层飞行，",
      "token_start": 536,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 111320,
      "end_ms": 112540,
      "text": "这里有太多的干扰，",
      "token_start": 549,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 112780,
      "end_ms": 113720,
      "text": "情绪的风暴，",
      "token_start": 557,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 113760,
      "end_ms": 115675,
      "text": "信息的噪音、拥挤的竞争，",
      "token_start": 562,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 115980,
      "end_ms": 117635,
      "text": "大家都在同一高度盘旋，",
      "token_start": 572,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 117920,
      "end_ms": 118760,
      "text": "互相碰撞，",
      "token_start": 582,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 118860,
      "end_ms": 119735,
      "text": "互相消耗。",
      "token_start": 586,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 120080,
      "end_ms": 122970,
      "text": "如果你一旦飞到了人生的平流层在那里，",
      "token_start": 590,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 122970,
      "end_ms": 123930,
      "text": "情绪更稳定，",
      "token_start": 607,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 124130,
      "end_ms": 125225,
      "text": "环境更安静，",
      "token_start": 612,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 125510,
      "end_ms": 128845,
      "text": "你不再通过剧烈的自我损耗的方式去换取成功。",
      "token_start": 617,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 129210,
      "end_ms": 131170,
      "text": "你会发现天空其实很宽，",
      "token_start": 637,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 131470,
      "end_ms": 133045,
      "text": "气流其实很温柔。",
      "token_start": 647,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 133400,
      "end_ms": 135085,
      "text": "人生是不需要过分努力的，",
      "token_start": 654,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 135300,
      "end_ms": 138450,
      "text": "你只需要不断的去筛选匹配自己的环境，",
      "token_start": 665,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 138650,
      "end_ms": 140470,
      "text": "然后让自己放松下来，",
      "token_start": 682,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 140590,
      "end_ms": 141675,
      "text": "闲下来就可以。",
      "token_start": 691,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 142080,
      "end_ms": 143325,
      "text": "就像北京语言一样，",
      "token_start": 697,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 143550,
      "end_ms": 144635,
      "text": "推到他的平流层，",
      "token_start": 705,
      "token_end_exclusive": 712
    },
    {
      "start_ms": 145110,
      "end_ms": 146625,
      "text": "天空才是他真正的家。",
      "token_start": 712,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 146890,
      "end_ms": 149535,
      "text": "地面只是他筑巢休整零时的地方，",
      "token_start": 721,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 149970,
      "end_ms": 153555,
      "text": "渺小的身躯却完成在地球上最壮阔的候鸟冒险，",
      "token_start": 735,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 154000,
      "end_ms": 155140,
      "text": "祝他们一路顺风。",
      "token_start": 755,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 155280,
      "end_ms": 156440,
      "text": "明年四月见，",
      "token_start": 762,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 156580,
      "end_ms": 159755,
      "text": "也祝愿诸军都能飞到人生的平流层。",
      "token_start": 767,
      "token_end_exclusive": 782
    }
  ],
