{
  "video_id": "v_61abd978ec06a646",
  "duration_s": 266.771995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_61abd978ec06a646.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_61abd978ec06a646.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 3050,
      "text": "你们三个去老街夜市卖冰棍儿，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3050,
      "end_ms": 3790,
      "text": "每人一百，",
      "token_start": 13,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4230,
      "end_ms": 5110,
      "text": "谁赚最多。",
      "token_start": 17,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5270,
      "end_ms": 7430,
      "text": "爷爷答应他一个愿望得嘞，",
      "token_start": 21,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 7430,
      "end_ms": 7970,
      "text": "爷爷您瞧，",
      "token_start": 32,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 7970,
      "end_ms": 8390,
      "text": "好吧，",
      "token_start": 36,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 8730,
      "end_ms": 9390,
      "text": "必须的，",
      "token_start": 38,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 9450,
      "end_ms": 10470,
      "text": "咱肯定整明白。",
      "token_start": 41,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 10670,
      "end_ms": 10910,
      "text": "好，",
      "token_start": 47,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 11090,
      "end_ms": 16660,
      "text": "爷爷冰棍儿老甜，",
      "token_start": 48,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 16680,
      "end_ms": 17960,
      "text": "老凉快的冰棍儿，",
      "token_start": 55,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 19420,
      "end_ms": 20480,
      "text": "冰棍儿咋卖呀？",
      "token_start": 62,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 21660,
      "end_ms": 23675,
      "text": "两块钱一根老凉快了，",
      "token_start": 68,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 26470,
      "end_ms": 27810,
      "text": "进价一块卖两块，",
      "token_start": 77,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 28170,
      "end_ms": 29830,
      "text": "一天卖一百根挣一百。",
      "token_start": 84,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 31110,
      "end_ms": 31570,
      "text": "老板，",
      "token_start": 93,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 32170,
      "end_ms": 34010,
      "text": "咱以后天天从您这儿拿货，",
      "token_start": 95,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 34310,
      "end_ms": 34910,
      "text": "先压二十，",
      "token_start": 106,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 34910,
      "end_ms": 35810,
      "text": "卖完再结账，",
      "token_start": 110,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 35810,
      "end_ms": 37050,
      "text": "您不用担风险，",
      "token_start": 115,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 37050,
      "end_ms": 38530,
      "text": "每卖一根儿，",
      "token_start": 121,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 38610,
      "end_ms": 39675,
      "text": "我分您五毛。",
      "token_start": 126,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 42100,
      "end_ms": 42340,
      "text": "行，",
      "token_start": 131,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 43180,
      "end_ms": 45020,
      "text": "这买卖我没风险成交。",
      "token_start": 132,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 46940,
      "end_ms": 47660,
      "text": "各位老板，",
      "token_start": 141,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 47900,
      "end_ms": 50460,
      "text": "以后我提前把冰棍儿送到您摊位上，",
      "token_start": 145,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 50880,
      "end_ms": 52480,
      "text": "价钱比夜市便宜。",
      "token_start": 160,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 52780,
      "end_ms": 54160,
      "text": "包装上印您店名，",
      "token_start": 167,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 54440,
      "end_ms": 56420,
      "text": "您帮我卖每个给您提成，",
      "token_start": 174,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 56920,
      "end_ms": 57500,
      "text": "这不错，",
      "token_start": 184,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 58240,
      "end_ms": 59120,
      "text": "客人方便，",
      "token_start": 187,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 59380,
      "end_ms": 60435,
      "text": "我们也省事儿。",
      "token_start": 191,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 60800,
      "end_ms": 67215,
      "text": "哈哈哈经理，",
      "token_start": 197,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 67550,
      "end_ms": 69290,
      "text": "我给你们夜市长期供冰棍，",
      "token_start": 202,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 69410,
      "end_ms": 70615,
      "text": "价钱比市场低。",
      "token_start": 213,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 71050,
      "end_ms": 72670,
      "text": "你先给我订单和预付金，",
      "token_start": 219,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 72670,
      "end_ms": 73425,
      "text": "我再采购，",
      "token_start": 229,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 74870,
      "end_ms": 76415,
      "text": "先拿订单再采购。",
      "token_start": 233,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 76980,
      "end_ms": 77180,
      "text": "好。",
      "token_start": 240,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 77180,
      "end_ms": 78245,
      "text": "星仔有头脑，",
      "token_start": 241,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 78980,
      "end_ms": 80980,
      "text": "合同签了预付金，",
      "token_start": 246,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 80980,
      "end_ms": 84790,
      "text": "打给你统一采购，",
      "token_start": 253,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 84870,
      "end_ms": 85670,
      "text": "统一仓储，",
      "token_start": 260,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 85750,
      "end_ms": 86430,
      "text": "统一派送，",
      "token_start": 264,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 86550,
      "end_ms": 87695,
      "text": "按路线执行。",
      "token_start": 268,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 88140,
      "end_ms": 91960,
      "text": "卖不完的转给其他摊位包装上印夜市和商户名，",
      "token_start": 273,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 92220,
      "end_ms": 93120,
      "text": "几万个游客，",
      "token_start": 293,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 93120,
      "end_ms": 95995,
      "text": "每天看到广告在向商家收推广费。",
      "token_start": 298,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 96440,
      "end_ms": 97020,
      "text": "可以呀，",
      "token_start": 312,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 97020,
      "end_ms": 97685,
      "text": "小孩哥，",
      "token_start": 315,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 98120,
      "end_ms": 99280,
      "text": "我天天守在夜市，",
      "token_start": 318,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 99400,
      "end_ms": 101465,
      "text": "扯着嗓子喊一根儿一根的卖。",
      "token_start": 325,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 101830,
      "end_ms": 102510,
      "text": "一年下来，",
      "token_start": 337,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 102730,
      "end_ms": 103785,
      "text": "我赚了两万多，",
      "token_start": 341,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 104760,
      "end_ms": 105935,
      "text": "你赚的是差价。",
      "token_start": 347,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 106750,
      "end_ms": 108005,
      "text": "看着像做生意，",
      "token_start": 353,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 108550,
      "end_ms": 111655,
      "text": "其实是给自己找了份风吹日晒的苦差事。",
      "token_start": 359,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 112050,
      "end_ms": 113030,
      "text": "我找了批发商，",
      "token_start": 376,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 113150,
      "end_ms": 113870,
      "text": "先压二十，",
      "token_start": 382,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 114010,
      "end_ms": 114810,
      "text": "卖完再结账，",
      "token_start": 386,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 114950,
      "end_ms": 115710,
      "text": "又找了夜市，",
      "token_start": 391,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 115870,
      "end_ms": 117010,
      "text": "五个摊主帮我卖，",
      "token_start": 396,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 117110,
      "end_ms": 118150,
      "text": "每根给他们提成，",
      "token_start": 403,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 118330,
      "end_ms": 119210,
      "text": "我没自己守摊，",
      "token_start": 410,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 119410,
      "end_ms": 120525,
      "text": "一年赚了五万多。",
      "token_start": 416,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 120980,
      "end_ms": 122735,
      "text": "你没拥有所有资源，",
      "token_start": 423,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 123100,
      "end_ms": 125075,
      "text": "但你控制并调动了资源，",
      "token_start": 431,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 125540,
      "end_ms": 126760,
      "text": "这叫借力赚钱。",
      "token_start": 441,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 127060,
      "end_ms": 128400,
      "text": "我先找夜市管理方，",
      "token_start": 447,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 128640,
      "end_ms": 130025,
      "text": "拿订单和预付金，",
      "token_start": 455,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 130610,
      "end_ms": 133830,
      "text": "再统一采购仓储配送卖不完的，",
      "token_start": 462,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 133870,
      "end_ms": 137635,
      "text": "换给其他摊位包装上印夜市和商户名。",
      "token_start": 475,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 137990,
      "end_ms": 140790,
      "text": "在说广告前一年赚了八十多万，",
      "token_start": 491,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 141050,
      "end_ms": 143325,
      "text": "你控制的不是一批冰棍儿，",
      "token_start": 504,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 143740,
      "end_ms": 144460,
      "text": "而是一套，",
      "token_start": 515,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 144480,
      "end_ms": 147850,
      "text": "即使你不在也能持续运转的系统。",
      "token_start": 519,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 148110,
      "end_ms": 149695,
      "text": "老板短袖多少钱一件？",
      "token_start": 533,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 150070,
      "end_ms": 151985,
      "text": "都是今年新款五十九一件。",
      "token_start": 542,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 152400,
      "end_ms": 153515,
      "text": "帅哥来一件吗？",
      "token_start": 553,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 154330,
      "end_ms": 155185,
      "text": "太贵了，",
      "token_start": 559,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 155620,
      "end_ms": 156500,
      "text": "五十九一件儿，",
      "token_start": 562,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 156500,
      "end_ms": 157560,
      "text": "没人买你，",
      "token_start": 568,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 157560,
      "end_ms": 158975,
      "text": "应该卖一块钱一件儿，",
      "token_start": 572,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 159630,
      "end_ms": 160815,
      "text": "你是来找茬的吧，",
      "token_start": 581,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 161230,
      "end_ms": 162825,
      "text": "我进货都得十块钱一件儿。",
      "token_start": 588,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 163070,
      "end_ms": 163485,
      "text": "别急，",
      "token_start": 599,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 164090,
      "end_ms": 165690,
      "text": "我能让你的短袖卖一块钱，",
      "token_start": 601,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 165790,
      "end_ms": 166930,
      "text": "不亏钱还能多赚。",
      "token_start": 612,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 167170,
      "end_ms": 167930,
      "text": "如果做到了，",
      "token_start": 619,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 167970,
      "end_ms": 168945,
      "text": "跟我爸相个亲，",
      "token_start": 624,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 169560,
      "end_ms": 169855,
      "text": "行，",
      "token_start": 630,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 170280,
      "end_ms": 171350,
      "text": "啥方法买？",
      "token_start": 631,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 171350,
      "end_ms": 172335,
      "text": "第一件五十九，",
      "token_start": 635,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 172640,
      "end_ms": 173620,
      "text": "第二件三十九，",
      "token_start": 641,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 173640,
      "end_ms": 174535,
      "text": "第三件十九，",
      "token_start": 647,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 174760,
      "end_ms": 176580,
      "text": "第四件变一块钱四件，",
      "token_start": 652,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 176600,
      "end_ms": 177365,
      "text": "成本四十，",
      "token_start": 661,
      "token_end_exclusive": 665
    },
    {
      "start_ms": 177680,
      "end_ms": 179445,
      "text": "卖一百一十八挣七十八。",
      "token_start": 665,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 180920,
      "end_ms": 182160,
      "text": "我摆了三年地摊，",
      "token_start": 675,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 182420,
      "end_ms": 184800,
      "text": "也没想到这法子想卖的更快。",
      "token_start": 682,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 185100,
      "end_ms": 188160,
      "text": "花二十八块采购四桶四斤装洗衣液，",
      "token_start": 694,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 188480,
      "end_ms": 189940,
      "text": "外面至少三十一桶，",
      "token_start": 709,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 190260,
      "end_ms": 193360,
      "text": "买四件短袖就送价值一百二的洗衣液，",
      "token_start": 717,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 193560,
      "end_ms": 196060,
      "text": "顾客等于没花钱买了四件短袖，",
      "token_start": 733,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 196300,
      "end_ms": 197420,
      "text": "你怎么这么厉害？",
      "token_start": 746,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 197620,
      "end_ms": 200840,
      "text": "我爷爷从小就给我看这本书叫做粤商思维。",
      "token_start": 753,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 201200,
      "end_ms": 205260,
      "text": "你知道为什么泰国、深圳、香港的首富清一色都是潮汕人吗？",
      "token_start": 771,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 205440,
      "end_ms": 207000,
      "text": "背后不是什么神秘力量，",
      "token_start": 795,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 207320,
      "end_ms": 209340,
      "text": "而是代代相传的生意思维。",
      "token_start": 805,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 210000,
      "end_ms": 212530,
      "text": "你打开看看看这本乐商思维就知道了。",
      "token_start": 816,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 212790,
      "end_ms": 213590,
      "text": "你看这一句，",
      "token_start": 832,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 213890,
      "end_ms": 215830,
      "text": "您做小老板不打高端工，",
      "token_start": 837,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 216010,
      "end_ms": 217210,
      "text": "先落地再做大，",
      "token_start": 847,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 217730,
      "end_ms": 221210,
      "text": "很多大生意都是从小生意一点一点积累起来的。",
      "token_start": 853,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 221890,
      "end_ms": 222710,
      "text": "再看这一句，",
      "token_start": 873,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 223070,
      "end_ms": 225590,
      "text": "没有先天资源就靠敢吃苦，",
      "token_start": 878,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 225750,
      "end_ms": 226370,
      "text": "能弯腰。",
      "token_start": 889,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 226650,
      "end_ms": 228210,
      "text": "很多人不是输在起点，",
      "token_start": 892,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 228330,
      "end_ms": 229710,
      "text": "而是输在不敢开始。",
      "token_start": 901,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 230010,
      "end_ms": 231590,
      "text": "还有这句新会陈皮，",
      "token_start": 909,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 231590,
      "end_ms": 234550,
      "text": "深耕百年熬出垄断式复利小生意，",
      "token_start": 917,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 234550,
      "end_ms": 236410,
      "text": "做久了也能积累出大价值。",
      "token_start": 931,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 236650,
      "end_ms": 238410,
      "text": "还有这一句潮商不传，",
      "token_start": 942,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 238410,
      "end_ms": 238810,
      "text": "横财，",
      "token_start": 951,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 238830,
      "end_ms": 239470,
      "text": "传本事，",
      "token_start": 953,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 239550,
      "end_ms": 240150,
      "text": "不传虚名，",
      "token_start": 956,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 240150,
      "end_ms": 241035,
      "text": "传基业。",
      "token_start": 960,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 241290,
      "end_ms": 242170,
      "text": "真正厉害的人，",
      "token_start": 963,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 242170,
      "end_ms": 243370,
      "text": "留下的不只是财富，",
      "token_start": 969,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 243570,
      "end_ms": 245415,
      "text": "而是一套创造财富的方法。",
      "token_start": 977,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 245860,
      "end_ms": 248920,
      "text": "这本书里面真的是每一句话都在教你如何赚钱，",
      "token_start": 988,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 249000,
      "end_ms": 249845,
      "text": "如何做买卖，",
      "token_start": 1008,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 250160,
      "end_ms": 251120,
      "text": "如何经营人脉，",
      "token_start": 1013,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 251220,
      "end_ms": 252665,
      "text": "如何拥有老板思维。",
      "token_start": 1019,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 253120,
      "end_ms": 256080,
      "text": "他把那些祖祖辈辈传下来的生意经掰开了，",
      "token_start": 1027,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 256080,
      "end_ms": 257560,
      "text": "揉碎了喂到你的面前，",
      "token_start": 1045,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 257740,
      "end_ms": 259520,
      "text": "帮助我们普通人开悟开窍，",
      "token_start": 1054,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 259680,
      "end_ms": 260835,
      "text": "完成财富跃迁。",
      "token_start": 1065,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 261210,
      "end_ms": 263470,
      "text": "但凡你想要改变一下自己当下的状态，",
      "token_start": 1071,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 263630,
      "end_ms": 264705,
      "text": "打开思维格局，",
      "token_start": 1087,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 265000,
      "end_ms": 266645,
      "text": "那么这本书真的适合读一读。",
      "token_start": 1093,
      "token_end_exclusive": 1105
    }
  ],
