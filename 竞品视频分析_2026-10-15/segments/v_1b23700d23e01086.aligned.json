{
  "video_id": "v_1b23700d23e01086",
  "duration_s": 396.851995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1b23700d23e01086.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1b23700d23e01086.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 1910,
      "text": "一九九四年六月十八日，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 1910,
      "end_ms": 2310,
      "text": "北京，",
      "token_start": 10,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 2670,
      "end_ms": 4890,
      "text": "一位八十二岁的老太太走了，",
      "token_start": 12,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5370,
      "end_ms": 8770,
      "text": "按她生前立的遗嘱后事是这么办的。",
      "token_start": 24,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9130,
      "end_ms": 9610,
      "text": "第一，",
      "token_start": 39,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 9950,
      "end_ms": 11170,
      "text": "遗体不火化，",
      "token_start": 41,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 11650,
      "end_ms": 14050,
      "text": "直接捐给医学研究单位，",
      "token_start": 46,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 14470,
      "end_ms": 15470,
      "text": "可用的部分，",
      "token_start": 56,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 15770,
      "end_ms": 16730,
      "text": "充分利用。",
      "token_start": 61,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 17130,
      "end_ms": 24030,
      "text": "第二一辈子的书籍、笔记手稿全部打包送给核工业研究院。",
      "token_start": 65,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 24650,
      "end_ms": 25110,
      "text": "第三，",
      "token_start": 89,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 25410,
      "end_ms": 27150,
      "text": "存折摊开数一遍，",
      "token_start": 91,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 27590,
      "end_ms": 32860,
      "text": "零存整取的七千两百二十万二点八八元交最后一次党费，",
      "token_start": 98,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 33300,
      "end_ms": 34660,
      "text": "剩下约十万元，",
      "token_start": 122,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 35440,
      "end_ms": 41420,
      "text": "全部捐给希望工程三样遗体手稿存款一样不剩，",
      "token_start": 128,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 41880,
      "end_ms": 42920,
      "text": "全给了国家，",
      "token_start": 148,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 43160,
      "end_ms": 45260,
      "text": "自己一分没留葬礼，",
      "token_start": 153,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 45500,
      "end_ms": 46319,
      "text": "一个都不办。",
      "token_start": 161,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 46840,
      "end_ms": 48900,
      "text": "可你知道最扎心的是什么吗？",
      "token_start": 166,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 49300,
      "end_ms": 52060,
      "text": "这位把全部家当捐出去的老太太，",
      "token_start": 178,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 52600,
      "end_ms": 54520,
      "text": "不是没本事挣钱，",
      "token_start": 192,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 55180,
      "end_ms": 57160,
      "text": "她是中科院学部委员，",
      "token_start": 199,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 57620,
      "end_ms": 61050,
      "text": "核物理学家是美国顶尖学府，",
      "token_start": 208,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 61090,
      "end_ms": 62475,
      "text": "请走过的天才，",
      "token_start": 220,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 63050,
      "end_ms": 67045,
      "text": "是被西方媒体称为中国的居里夫人的人。",
      "token_start": 226,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 67820,
      "end_ms": 69555,
      "text": "他这辈子挣的每一分钱，",
      "token_start": 243,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 70070,
      "end_ms": 71950,
      "text": "最后都流出了自己的口袋。",
      "token_start": 253,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 71990,
      "end_ms": 76185,
      "text": "他这辈子出的每一个名最后都填进了国家的需要，",
      "token_start": 264,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 76750,
      "end_ms": 79115,
      "text": "他叫王成书聚集。",
      "token_start": 285,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 79450,
      "end_ms": 81915,
      "text": "我从他留下的三件遗物讲起，",
      "token_start": 292,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 82680,
      "end_ms": 86725,
      "text": "一物一一张发黄的纸条，",
      "token_start": 304,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 87250,
      "end_ms": 90765,
      "text": "整理他笔记本的人翻到的上面一行字，",
      "token_start": 314,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 91240,
      "end_ms": 92905,
      "text": "在无论任何条件下，",
      "token_start": 330,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 93300,
      "end_ms": 95965,
      "text": "坚决完成党交给我的任何任务，",
      "token_start": 338,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 96450,
      "end_ms": 99415,
      "text": "在必要时不惜牺牲自己的生命。",
      "token_start": 351,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 100040,
      "end_ms": 105745,
      "text": "这张纸条是一九六一年他入党那天写的童年，",
      "token_start": 364,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 106100,
      "end_ms": 111530,
      "text": "他从两百八十多块的月薪里直接抽出两百块交党费，",
      "token_start": 383,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 111710,
      "end_ms": 115025,
      "text": "剩下八十多块还要接济困难的人。",
      "token_start": 405,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 116010,
      "end_ms": 117225,
      "text": "党委同志劝他，",
      "token_start": 419,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 118040,
      "end_ms": 118685,
      "text": "王先生，",
      "token_start": 425,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 119280,
      "end_ms": 120395,
      "text": "你不能这么教，",
      "token_start": 428,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 120710,
      "end_ms": 121915,
      "text": "你还得过日子啊。",
      "token_start": 434,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 122830,
      "end_ms": 123645,
      "text": "他摇摇头，",
      "token_start": 441,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 124720,
      "end_ms": 125895,
      "text": "我既然入了党，",
      "token_start": 445,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 126560,
      "end_ms": 128545,
      "text": "就要给党做贡献。",
      "token_start": 451,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 129230,
      "end_ms": 130695,
      "text": "我用不了这么多钱，",
      "token_start": 458,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 131180,
      "end_ms": 132975,
      "text": "国家不用给我那么多钱，",
      "token_start": 466,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 133950,
      "end_ms": 138335,
      "text": "你听听两百八十块工资拿二百交党。",
      "token_start": 476,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 138490,
      "end_ms": 138655,
      "text": "对，",
      "token_start": 491,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 139560,
      "end_ms": 140545,
      "text": "这是什么觉悟？",
      "token_start": 492,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 141600,
      "end_ms": 142585,
      "text": "从那天起，",
      "token_start": 498,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 143310,
      "end_ms": 144735,
      "text": "他把名字藏了起来，",
      "token_start": 502,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 145210,
      "end_ms": 148035,
      "text": "把家撤了一头扎进大西北。",
      "token_start": 510,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 148500,
      "end_ms": 150695,
      "text": "干了一件不能说不能写，",
      "token_start": 521,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 151020,
      "end_ms": 152560,
      "text": "不能告诉任何人的事，",
      "token_start": 531,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 152680,
      "end_ms": 154505,
      "text": "一干就是三十年。",
      "token_start": 540,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 155750,
      "end_ms": 157265,
      "text": "他学生说了一句狠话，",
      "token_start": 547,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 158220,
      "end_ms": 162835,
      "text": "我的老师是那种死后既有资格见先烈，",
      "token_start": 556,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 163530,
      "end_ms": 165995,
      "text": "又有资格见同行的人。",
      "token_start": 572,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 167640,
      "end_ms": 168060,
      "text": "遗物。",
      "token_start": 581,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 168060,
      "end_ms": 168365,
      "text": "二，",
      "token_start": 583,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 170010,
      "end_ms": 171195,
      "text": "一副放大镜。",
      "token_start": 584,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 171800,
      "end_ms": 172780,
      "text": "一九八零年，",
      "token_start": 589,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 172780,
      "end_ms": 175850,
      "text": "他当选中科院学部委员植务，",
      "token_start": 594,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 175850,
      "end_ms": 179245,
      "text": "一路做到核工业部科学技术局总工程师。",
      "token_start": 606,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 180040,
      "end_ms": 180600,
      "text": "可了解。",
      "token_start": 623,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 180600,
      "end_ms": 181540,
      "text": "她的人都知道，",
      "token_start": 626,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 181680,
      "end_ms": 182880,
      "text": "这老太太有三样，",
      "token_start": 632,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 182880,
      "end_ms": 184360,
      "text": "不会有权，",
      "token_start": 639,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 184520,
      "end_ms": 185080,
      "text": "不会用，",
      "token_start": 643,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 185500,
      "end_ms": 186040,
      "text": "有钱，",
      "token_start": 646,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 186140,
      "end_ms": 187780,
      "text": "不会花有福，",
      "token_start": 648,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 188060,
      "end_ms": 189680,
      "text": "不会享先说，",
      "token_start": 653,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 189780,
      "end_ms": 190520,
      "text": "不会花钱，",
      "token_start": 658,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 191120,
      "end_ms": 192980,
      "text": "晚年患上白内障。",
      "token_start": 662,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 193000,
      "end_ms": 193580,
      "text": "医生说，",
      "token_start": 669,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 193600,
      "end_ms": 194540,
      "text": "打进口药，",
      "token_start": 672,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 194720,
      "end_ms": 195720,
      "text": "一支六百块，",
      "token_start": 676,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 196440,
      "end_ms": 197640,
      "text": "她乐呵呵摆手，",
      "token_start": 681,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 197800,
      "end_ms": 200820,
      "text": "你看我这双眼睛还值六千块吗？",
      "token_start": 687,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 201040,
      "end_ms": 201720,
      "text": "不治了。",
      "token_start": 700,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 201940,
      "end_ms": 206140,
      "text": "年近八十就靠一副放大镜批学生的论文，",
      "token_start": 703,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 206740,
      "end_ms": 208840,
      "text": "一个标点符号错了都不放过。",
      "token_start": 720,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 209990,
      "end_ms": 212030,
      "text": "三年期间的困难时期，",
      "token_start": 732,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 212330,
      "end_ms": 217110,
      "text": "学生们用的笔记本和铅笔全是他从工资里掏钱买的。",
      "token_start": 741,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 217969,
      "end_ms": 219810,
      "text": "再说他怎么浪费钱。",
      "token_start": 763,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 220410,
      "end_ms": 221610,
      "text": "一九八六年，",
      "token_start": 771,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 221950,
      "end_ms": 227350,
      "text": "一家三代纪念回国三十周年摆了一次小小的家宴。",
      "token_start": 776,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 227490,
      "end_ms": 228790,
      "text": "他当众说了一句话，",
      "token_start": 797,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 229210,
      "end_ms": 231370,
      "text": "让满桌人都沉默了，",
      "token_start": 805,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 231830,
      "end_ms": 233690,
      "text": "现在有人弃祖国而去，",
      "token_start": 813,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 233930,
      "end_ms": 235970,
      "text": "有人出国学习不愿回来。",
      "token_start": 822,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 236710,
      "end_ms": 239780,
      "text": "我这一生最后悔的事情，",
      "token_start": 832,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 239800,
      "end_ms": 241625,
      "text": "请就是回国太晚了，",
      "token_start": 842,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 242190,
      "end_ms": 243135,
      "text": "回国晚了，",
      "token_start": 850,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 243740,
      "end_ms": 247675,
      "text": "这四个字从一个被美国扣了七年，",
      "token_start": 854,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 248210,
      "end_ms": 250270,
      "text": "想尽一切办法才回来的。",
      "token_start": 868,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 250270,
      "end_ms": 252645,
      "text": "人口中说出来是什么分量，",
      "token_start": 878,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 253180,
      "end_ms": 254795,
      "text": "他后悔的不是回来，",
      "token_start": 889,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 255260,
      "end_ms": 255900,
      "text": "是回来的，",
      "token_start": 897,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 255900,
      "end_ms": 256575,
      "text": "太晚了，",
      "token_start": 901,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 257520,
      "end_ms": 259505,
      "text": "为国家干的时间太少了。",
      "token_start": 904,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 261090,
      "end_ms": 264995,
      "text": "一五三一个捐了两次款的存折。",
      "token_start": 914,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 266140,
      "end_ms": 268160,
      "text": "希望工程的捐款名单里，",
      "token_start": 927,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 268160,
      "end_ms": 272195,
      "text": "张文玉、王成书这两个名字出现了不止一次。",
      "token_start": 937,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 272780,
      "end_ms": 274435,
      "text": "一九九二年十一月，",
      "token_start": 955,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 274800,
      "end_ms": 282230,
      "text": "丈夫张文玉、中国高能物理学的开拓者、中科院学部委员积劳成疾，",
      "token_start": 963,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 282230,
      "end_ms": 282775,
      "text": "先走了。",
      "token_start": 990,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 283830,
      "end_ms": 285515,
      "text": "老两口早就有个约定，",
      "token_start": 993,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 286270,
      "end_ms": 287685,
      "text": "不给儿孙留遗产，",
      "token_start": 1002,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 288220,
      "end_ms": 289300,
      "text": "全部积蓄，",
      "token_start": 1009,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 289380,
      "end_ms": 291055,
      "text": "捐给国家的教育事业。",
      "token_start": 1013,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 292010,
      "end_ms": 294500,
      "text": "送走丈夫王成书，",
      "token_start": 1022,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 294500,
      "end_ms": 299130,
      "text": "转头把先生一辈子的积蓄十万元整捐给了希望。",
      "token_start": 1029,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 299150,
      "end_ms": 302995,
      "text": "工臣在西藏日喀则萨迦县盖起一所小学，",
      "token_start": 1049,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 303730,
      "end_ms": 305635,
      "text": "小名就用丈夫的名字。",
      "token_start": 1066,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 305940,
      "end_ms": 308375,
      "text": "文艺小学第二年，",
      "token_start": 1075,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 308720,
      "end_ms": 309315,
      "text": "他自知。",
      "token_start": 1082,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 309690,
      "end_ms": 310610,
      "text": "时日无多，",
      "token_start": 1085,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 310990,
      "end_ms": 313370,
      "text": "写下了本集开头那份遗嘱。",
      "token_start": 1089,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 313790,
      "end_ms": 315110,
      "text": "他给学生写信说，",
      "token_start": 1100,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 315570,
      "end_ms": 317430,
      "text": "我一生平淡无奇，",
      "token_start": 1107,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 317890,
      "end_ms": 319470,
      "text": "只是踏踏实实的工作。",
      "token_start": 1114,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 320050,
      "end_ms": 321090,
      "text": "至于说贡献，",
      "token_start": 1123,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 321590,
      "end_ms": 322770,
      "text": "谁又没有贡献？",
      "token_start": 1128,
      "token_end_exclusive": 1134
    },
    {
      "start_ms": 323190,
      "end_ms": 324370,
      "text": "为国家做贡献，",
      "token_start": 1134,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 324790,
      "end_ms": 326650,
      "text": "是每一个公民的职责，",
      "token_start": 1140,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 327130,
      "end_ms": 328870,
      "text": "何况是一个共产党员。",
      "token_start": 1149,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 329810,
      "end_ms": 334250,
      "text": "你看把三次改行半生，",
      "token_start": 1158,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 334350,
      "end_ms": 338870,
      "text": "引身全部身家都做完的人管，",
      "token_start": 1167,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 338870,
      "end_ms": 340280,
      "text": "这叫平安平淡无奇。",
      "token_start": 1179,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 340520,
      "end_ms": 343440,
      "text": "他这八十二年生前不能署名，",
      "token_start": 1187,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 343840,
      "end_ms": 345120,
      "text": "死后不许办丧。",
      "token_start": 1199,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 345640,
      "end_ms": 347400,
      "text": "他把名字还给了时代，",
      "token_start": 1205,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 347760,
      "end_ms": 350220,
      "text": "把遗体还给了医学研究，",
      "token_start": 1214,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 350700,
      "end_ms": 353100,
      "text": "把积蓄捐献给了孩子，",
      "token_start": 1224,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 353440,
      "end_ms": 356440,
      "text": "连最后一点私心都没给自己留。",
      "token_start": 1233,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 357160,
      "end_ms": 359320,
      "text": "今天我把这个名字还给他，",
      "token_start": 1246,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 359580,
      "end_ms": 360640,
      "text": "王成书系列，",
      "token_start": 1257,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 360640,
      "end_ms": 365100,
      "text": "到这就全部讲讲完了五一一个一辈子。",
      "token_start": 1262,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 365540,
      "end_ms": 368420,
      "text": "如果你也为这个一分没留给自己的老人，",
      "token_start": 1278,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 368420,
      "end_ms": 369175,
      "text": "动容，",
      "token_start": 1295,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 369680,
      "end_ms": 371055,
      "text": "请做三件事，",
      "token_start": 1297,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 371880,
      "end_ms": 378340,
      "text": "点赞、收藏、转发，",
      "token_start": 1302,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 378460,
      "end_ms": 384795,
      "text": "让更多人看到评论区打上王成书三个字，",
      "token_start": 1308,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 385720,
      "end_ms": 386500,
      "text": "这三个字，",
      "token_start": 1325,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 386720,
      "end_ms": 388255,
      "text": "他低调了一辈子，",
      "token_start": 1329,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 389120,
      "end_ms": 392965,
      "text": "我们替他大声说一次关注我，",
      "token_start": 1336,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 393300,
      "end_ms": 395415,
      "text": "下一个国之脊梁。",
      "token_start": 1348,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 395960,
      "end_ms": 396745,
      "text": "我们继续讲。",
      "token_start": 1355,
      "token_end_exclusive": 1360
    }
  ],
