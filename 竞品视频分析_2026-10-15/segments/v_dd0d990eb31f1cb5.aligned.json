{
  "video_id": "v_dd0d990eb31f1cb5",
  "duration_s": 402.332948,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_dd0d990eb31f1cb5.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_dd0d990eb31f1cb5.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 670,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 670,
      "end_ms": 1310,
      "text": "咱们盘了。",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1310,
      "end_ms": 2610,
      "text": "第十到第六，",
      "token_start": 6,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3110,
      "end_ms": 9970,
      "text": "朝歌变祁县陈仓变宝鸡常山变石家庄琅琊变临沂，",
      "token_start": 11,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 10310,
      "end_ms": 11710,
      "text": "兰陵变枣庄。",
      "token_start": 32,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 12650,
      "end_ms": 15310,
      "text": "好多朋友看完在评论区吵翻了，",
      "token_start": 37,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 15830,
      "end_ms": 19130,
      "text": "有人说金陵呢幽州呢？",
      "token_start": 50,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 19270,
      "end_ms": 20090,
      "text": "炒陵呢？",
      "token_start": 59,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 20870,
      "end_ms": 21350,
      "text": "别急，",
      "token_start": 62,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 21670,
      "end_ms": 23630,
      "text": "今天这集就是第五道第一，",
      "token_start": 64,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 24030,
      "end_ms": 25590,
      "text": "一个比一个让人心疼。",
      "token_start": 75,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 26590,
      "end_ms": 29170,
      "text": "最后那个三千多年了名字，",
      "token_start": 84,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 29170,
      "end_ms": 30000,
      "text": "一个字没动过，",
      "token_start": 95,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 30060,
      "end_ms": 34720,
      "text": "见过老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 101,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 34720,
      "end_ms": 42760,
      "text": "让我看看都是谁在听第五名金陵改南京金陵这两个字听着就跪气。",
      "token_start": 120,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 43640,
      "end_ms": 47700,
      "text": "孙权在这儿建都叫建业，",
      "token_start": 148,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 47800,
      "end_ms": 51340,
      "text": "东晋在这建都都建权。",
      "token_start": 158,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 51780,
      "end_ms": 54540,
      "text": "南唐在这儿建都叫江陵，",
      "token_start": 167,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 55120,
      "end_ms": 57460,
      "text": "朱元璋在这建都叫应天，",
      "token_start": 177,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 57540,
      "end_ms": 62165,
      "text": "可最早早建名最好听的还是金陵。",
      "token_start": 187,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 62950,
      "end_ms": 69365,
      "text": "金陵十二钗说的就是南京秦淮河从城中间流过，",
      "token_start": 201,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 69790,
      "end_ms": 71095,
      "text": "讲生登迎礼，",
      "token_start": 221,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 71480,
      "end_ms": 73275,
      "text": "藏着半部中国史。",
      "token_start": 226,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 73870,
      "end_ms": 77405,
      "text": "可后来金陵改成了南京南边的京城，",
      "token_start": 233,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 77930,
      "end_ms": 78930,
      "text": "名字是大了，",
      "token_start": 248,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 78990,
      "end_ms": 81110,
      "text": "可金陵那个味道没了。",
      "token_start": 253,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 81210,
      "end_ms": 83655,
      "text": "您说这是升格还是降格？",
      "token_start": 262,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 84530,
      "end_ms": 85165,
      "text": "第四名，",
      "token_start": 272,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 85560,
      "end_ms": 91865,
      "text": "幽州改北京幽州这两个字念出来就带着一股边塞的苍凉。",
      "token_start": 275,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 92430,
      "end_ms": 94185,
      "text": "幽州是古代九州之一，",
      "token_start": 299,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 94430,
      "end_ms": 95950,
      "text": "从汉朝到唐朝，",
      "token_start": 308,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 96290,
      "end_ms": 99085,
      "text": "幽州一直是北方的军事重镇。",
      "token_start": 314,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 99820,
      "end_ms": 100675,
      "text": "安史之乱，",
      "token_start": 326,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 101000,
      "end_ms": 104200,
      "text": "安禄山就是从幽州起兵的幽州，",
      "token_start": 330,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 104200,
      "end_ms": 109585,
      "text": "在唐朝的时候管着今天的北京、天津、河北北部，",
      "token_start": 343,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 109940,
      "end_ms": 111985,
      "text": "是中原王朝的北大门。",
      "token_start": 362,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 112910,
      "end_ms": 114690,
      "text": "可后来幽州改了，",
      "token_start": 371,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 114830,
      "end_ms": 115850,
      "text": "改成什么了？",
      "token_start": 378,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 115890,
      "end_ms": 120905,
      "text": "北京北边的京城明清两朝在这儿建都，",
      "token_start": 383,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 121460,
      "end_ms": 124245,
      "text": "现在更是首都名字是大了，",
      "token_start": 399,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 124950,
      "end_ms": 128000,
      "text": "可幽州那个铁马秋风的味道没了，",
      "token_start": 410,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 128180,
      "end_ms": 130805,
      "text": "您说这是改名还是改命？",
      "token_start": 424,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 131490,
      "end_ms": 132185,
      "text": "第三名，",
      "token_start": 434,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 132500,
      "end_ms": 134205,
      "text": "广陵改扬州，",
      "token_start": 437,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 135670,
      "end_ms": 140515,
      "text": "广陵这两个字念出来就带着文人的风骨。",
      "token_start": 442,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 141570,
      "end_ms": 143845,
      "text": "广陵是汉朝时候的郡，",
      "token_start": 459,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 144170,
      "end_ms": 149855,
      "text": "管着今天的扬州广灵王是汉朝最尊贵的封号之一。",
      "token_start": 468,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 150800,
      "end_ms": 154015,
      "text": "广陵散是中国十大古琴曲之一。",
      "token_start": 489,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 154640,
      "end_ms": 157800,
      "text": "嵇康临死前谈的就是广陵散，",
      "token_start": 502,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 157940,
      "end_ms": 161835,
      "text": "广陵这两个字就是魏晋风度的代名词。",
      "token_start": 514,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 162360,
      "end_ms": 165105,
      "text": "可后来广陵改了改成扬州。",
      "token_start": 530,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 165770,
      "end_ms": 167935,
      "text": "扬州是古代九州之一，",
      "token_start": 541,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 168240,
      "end_ms": 169020,
      "text": "名字没错，",
      "token_start": 550,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 169280,
      "end_ms": 171670,
      "text": "可广陵那个味道没了。",
      "token_start": 554,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 171770,
      "end_ms": 174105,
      "text": "您说这是改地名还是改气质？",
      "token_start": 563,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 174650,
      "end_ms": 175270,
      "text": "第二名，",
      "token_start": 575,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 175510,
      "end_ms": 176575,
      "text": "姑苏改苏州。",
      "token_start": 578,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 176810,
      "end_ms": 178780,
      "text": "姑苏这两个字，",
      "token_start": 583,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 179000,
      "end_ms": 179680,
      "text": "念出来，",
      "token_start": 589,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 179680,
      "end_ms": 181535,
      "text": "就带着江南的温柔。",
      "token_start": 592,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 181940,
      "end_ms": 183965,
      "text": "姑苏城外寒山寺，",
      "token_start": 600,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 184400,
      "end_ms": 186310,
      "text": "夜半钟声到客船。",
      "token_start": 607,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 186590,
      "end_ms": 190025,
      "text": "张继写的姑苏是吴国的都城，",
      "token_start": 614,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 190350,
      "end_ms": 193055,
      "text": "使越王勾践卧薪尝胆的地方，",
      "token_start": 626,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 193390,
      "end_ms": 196500,
      "text": "是范蠡带着西施泛舟五湖的起点。",
      "token_start": 638,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 196640,
      "end_ms": 199385,
      "text": "姑苏这两个字就是江南的魂，",
      "token_start": 652,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 200270,
      "end_ms": 202565,
      "text": "可后来姑苏改了，",
      "token_start": 664,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 203090,
      "end_ms": 205740,
      "text": "改成苏州苏州名字。",
      "token_start": 671,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 205740,
      "end_ms": 206265,
      "text": "没错，",
      "token_start": 679,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 206970,
      "end_ms": 209255,
      "text": "可姑苏那个味道没了，",
      "token_start": 681,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 209500,
      "end_ms": 211875,
      "text": "您说这是改名还是改梦？",
      "token_start": 690,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 212510,
      "end_ms": 217875,
      "text": "我前阵子翻到一本叫中华文化常识一千问的书。",
      "token_start": 700,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 218770,
      "end_ms": 223395,
      "text": "这本书把中国历史上的文化常识分门别类，",
      "token_start": 720,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 223690,
      "end_ms": 225005,
      "text": "讲的清清楚楚。",
      "token_start": 738,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 226070,
      "end_ms": 227965,
      "text": "从三皇五帝到明清，",
      "token_start": 744,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 228310,
      "end_ms": 230855,
      "text": "从政治经济到科技文化，",
      "token_start": 752,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 231220,
      "end_ms": 233415,
      "text": "一千个问题一千个答案，",
      "token_start": 762,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 233690,
      "end_ms": 237355,
      "text": "咱们这几集讲的这些地名以前叫什么？",
      "token_start": 772,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 237660,
      "end_ms": 238635,
      "text": "现在叫什么？",
      "token_start": 788,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 239050,
      "end_ms": 244085,
      "text": "为什么改的书里都有他不是那种干巴巴的教科书，",
      "token_start": 793,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 244610,
      "end_ms": 246665,
      "text": "是一问一答的形式。",
      "token_start": 814,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 247060,
      "end_ms": 248000,
      "text": "翻到哪一页，",
      "token_start": 822,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 248000,
      "end_ms": 248675,
      "text": "看哪页，",
      "token_start": 827,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 249550,
      "end_ms": 251295,
      "text": "特别适合中老年朋友。",
      "token_start": 830,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 251700,
      "end_ms": 253135,
      "text": "每天翻两页。",
      "token_start": 839,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 253530,
      "end_ms": 254595,
      "text": "一年下来，",
      "token_start": 844,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 254920,
      "end_ms": 258645,
      "text": "中国历史的基本脉络心里全有谱了。",
      "token_start": 848,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 259170,
      "end_ms": 260545,
      "text": "我已经放下面了，",
      "token_start": 863,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 260840,
      "end_ms": 263725,
      "text": "点开就能看到喜欢历史的朋友，",
      "token_start": 870,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 263950,
      "end_ms": 265165,
      "text": "弄一本放床头，",
      "token_start": 883,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 265850,
      "end_ms": 268445,
      "text": "随手翻一页就是一段历史。",
      "token_start": 889,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 268830,
      "end_ms": 269375,
      "text": "第一名，",
      "token_start": 900,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 269590,
      "end_ms": 271680,
      "text": "邯郸等等。",
      "token_start": 903,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 272530,
      "end_ms": 273690,
      "text": "邯郸没改名吗？",
      "token_start": 907,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 273710,
      "end_ms": 273950,
      "text": "对，",
      "token_start": 913,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 274250,
      "end_ms": 275505,
      "text": "邯郸没改名。",
      "token_start": 914,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 276120,
      "end_ms": 281825,
      "text": "中国历史上只有邯郸从建成到现在三千一百年了，",
      "token_start": 919,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 282170,
      "end_ms": 283765,
      "text": "名字一个字没动过。",
      "token_start": 940,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 284530,
      "end_ms": 286175,
      "text": "为什么邯郸能不改名？",
      "token_start": 948,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 287020,
      "end_ms": 290195,
      "text": "因为他的名字太特别了。",
      "token_start": 957,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 290720,
      "end_ms": 294040,
      "text": "邯郸两个字拆开看寒是寒山，",
      "token_start": 967,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 294300,
      "end_ms": 295795,
      "text": "单是尽头的意思，",
      "token_start": 979,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 296670,
      "end_ms": 299035,
      "text": "邯郸就是邯山的尽头。",
      "token_start": 986,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 300010,
      "end_ms": 304695,
      "text": "战国时期邯郸是赵国的都城秦始皇嬴政。",
      "token_start": 995,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 305400,
      "end_ms": 306780,
      "text": "就出生在邯郸，",
      "token_start": 1012,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 307160,
      "end_ms": 312780,
      "text": "邯郸学步完璧归赵负荆请罪纸上谈兵。",
      "token_start": 1018,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 313319,
      "end_ms": 316000,
      "text": "这些成语全跟邯郸有关。",
      "token_start": 1034,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 316840,
      "end_ms": 320600,
      "text": "跟邯郸有关的成语有三千多条，",
      "token_start": 1044,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 321560,
      "end_ms": 322520,
      "text": "全国第一，",
      "token_start": 1057,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 322760,
      "end_ms": 328800,
      "text": "三千一百年改朝换代多少回邯郸还是邯郸？",
      "token_start": 1061,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 328940,
      "end_ms": 333900,
      "text": "别的城市改名是因为新朝代要新气象。",
      "token_start": 1079,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 334740,
      "end_ms": 335970,
      "text": "邯陈单没改，",
      "token_start": 1095,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 336310,
      "end_ms": 339370,
      "text": "是因为他的名字刻在成语里，",
      "token_start": 1100,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 339530,
      "end_ms": 340690,
      "text": "刻在历史里，",
      "token_start": 1112,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 340970,
      "end_ms": 343130,
      "text": "刻在每个中国人的记忆里。",
      "token_start": 1117,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 343290,
      "end_ms": 344330,
      "text": "名字没改，",
      "token_start": 1128,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 344510,
      "end_ms": 345530,
      "text": "地位没降，",
      "token_start": 1132,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 346070,
      "end_ms": 346910,
      "text": "位置没挪，",
      "token_start": 1136,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 347270,
      "end_ms": 347990,
      "text": "就这一个，",
      "token_start": 1140,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 349010,
      "end_ms": 350970,
      "text": "您说这个第一名服不服？",
      "token_start": 1144,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 351269,
      "end_ms": 352470,
      "text": "您听出来了没有？",
      "token_start": 1154,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 352910,
      "end_ms": 356010,
      "text": "这十个地名没有一个是随便改的。",
      "token_start": 1161,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 356270,
      "end_ms": 362050,
      "text": "朝歌改旗县是因为境内有条齐河陈仓改宝鸡，",
      "token_start": 1175,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 362450,
      "end_ms": 364685,
      "text": "是因为唐玄宗做了一个梦。",
      "token_start": 1194,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 365180,
      "end_ms": 370145,
      "text": "常山改石家庄是因为石家庄村琅琊改临沂，",
      "token_start": 1205,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 370530,
      "end_ms": 376645,
      "text": "是因为靠近颐和兰陵改枣庄是因为附近有枣庄煤矿，",
      "token_start": 1223,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 377180,
      "end_ms": 380940,
      "text": "金陵改南京是为了区分南北幽州，",
      "token_start": 1245,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 381020,
      "end_ms": 384715,
      "text": "改北京是为了突出北方的京城。",
      "token_start": 1259,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 385220,
      "end_ms": 388195,
      "text": "广陵改扬州是因为古代九州。",
      "token_start": 1272,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 388640,
      "end_ms": 395475,
      "text": "姑苏改苏州是因为姑苏山只有邯郸三千一百年没改过，",
      "token_start": 1284,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 395830,
      "end_ms": 398335,
      "text": "每一个地名都是一段历史，",
      "token_start": 1307,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 398600,
      "end_ms": 399815,
      "text": "改了就断了，",
      "token_start": 1318,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 400070,
      "end_ms": 400690,
      "text": "点个关注，",
      "token_start": 1323,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 400830,
      "end_ms": 402255,
      "text": "咱们下期接着聊。",
      "token_start": 1327,
      "token_end_exclusive": 1334
    }
  ],
