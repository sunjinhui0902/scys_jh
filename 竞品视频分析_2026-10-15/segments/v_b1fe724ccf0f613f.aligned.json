{
  "video_id": "v_b1fe724ccf0f613f",
  "duration_s": 639.2,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b1fe724ccf0f613f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b1fe724ccf0f613f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 2170,
      "text": "一个躺在行军帐篷里，",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2170,
      "end_ms": 3450,
      "text": "发着高烧的老人，",
      "token_start": 9,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3910,
      "end_ms": 5550,
      "text": "浑身烫的像块炭，",
      "token_start": 16,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 6130,
      "end_ms": 7890,
      "text": "连水都咽不下去了，",
      "token_start": 23,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 8670,
      "end_ms": 11310,
      "text": "身边的儿子和将领围了一圈，",
      "token_start": 31,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 11650,
      "end_ms": 12990,
      "text": "等着他交代后事。",
      "token_start": 43,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 13610,
      "end_ms": 15450,
      "text": "那个老人突然睁开眼，",
      "token_start": 50,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15970,
      "end_ms": 18130,
      "text": "咬着牙从嘴里挤出一句话，",
      "token_start": 59,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 18490,
      "end_ms": 21310,
      "text": "让帐篷里所有人都僵住了。",
      "token_start": 70,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 22030,
      "end_ms": 25270,
      "text": "那个地方一个活口都不要留，",
      "token_start": 81,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 26530,
      "end_ms": 27850,
      "text": "房墙给我推了，",
      "token_start": 93,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 28130,
      "end_ms": 29330,
      "text": "房子给我烧了，",
      "token_start": 99,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 29330,
      "end_ms": 30780,
      "text": "连地都给我给我淹了。",
      "token_start": 105,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 31580,
      "end_ms": 32500,
      "text": "说这话的人，",
      "token_start": 114,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 33280,
      "end_ms": 35500,
      "text": "不是哪个占山为王的土匪，",
      "token_start": 119,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 36060,
      "end_ms": 39680,
      "text": "而是当时地球上最强大的征服者。",
      "token_start": 130,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 39780,
      "end_ms": 41240,
      "text": "成吉思汗铁木真，",
      "token_start": 144,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 41680,
      "end_ms": 45540,
      "text": "一个被无数人捧为一代天骄的草原帝王。",
      "token_start": 151,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 46319,
      "end_ms": 49560,
      "text": "他要灭的是一个在中亚大地上，",
      "token_start": 168,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 49600,
      "end_ms": 51000,
      "text": "繁华了上百年，",
      "token_start": 181,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 51520,
      "end_ms": 54760,
      "text": "控制着整条丝绸之路的富庶大国。",
      "token_start": 187,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 54780,
      "end_ms": 58120,
      "text": "花喇子模这个国家有坚固的城墙，",
      "token_start": 201,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 58580,
      "end_ms": 61480,
      "text": "有精美的清真四有藏书，",
      "token_start": 215,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 61580,
      "end_ms": 65890,
      "text": "丰富的经学院有自己的文字和货币都城，",
      "token_start": 225,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 65910,
      "end_ms": 70510,
      "text": "御龙劫赤的人口比当时欧洲任何一座城市都多可。",
      "token_start": 242,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 70510,
      "end_ms": 73370,
      "text": "就因为成吉思汗厌弃前的一句话，",
      "token_start": 263,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 73450,
      "end_ms": 76450,
      "text": "蒙古大军把玉龙劫持的城墙拆了，",
      "token_start": 277,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 76570,
      "end_ms": 77825,
      "text": "把清真寺烧了，",
      "token_start": 291,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 78200,
      "end_ms": 80300,
      "text": "把经书和档案堆在广场上，",
      "token_start": 297,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 80300,
      "end_ms": 80855,
      "text": "点了火，",
      "token_start": 308,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 81400,
      "end_ms": 83755,
      "text": "最后还掘开阿姆河的堤坝，",
      "token_start": 311,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 84120,
      "end_ms": 86685,
      "text": "把整座城市泡在了水里，",
      "token_start": 322,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 87490,
      "end_ms": 89050,
      "text": "一个靠丝路贸易，",
      "token_start": 332,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 89090,
      "end_ms": 90625,
      "text": "富甲一方的文明。",
      "token_start": 339,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 91060,
      "end_ms": 97475,
      "text": "就这么从地图上被硬生生抹掉了一个已经打下半个世界的老人。",
      "token_start": 346,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 98070,
      "end_ms": 100415,
      "text": "为什么非要在自己快不行的时候，",
      "token_start": 373,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 100890,
      "end_ms": 104395,
      "text": "咬着牙非要把一个中亚大国从根上刨了。",
      "token_start": 387,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 105100,
      "end_ms": 112730,
      "text": "您先别急着划走这一段被蒙古西征的宏大叙事盖的严严实实的故事，",
      "token_start": 404,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 112810,
      "end_ms": 116615,
      "text": "其实藏着成吉思汗一生中最愤怒，",
      "token_start": 433,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 116890,
      "end_ms": 118755,
      "text": "也最冷血的一次算计。",
      "token_start": 447,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 119270,
      "end_ms": 120295,
      "text": "老哥哥老姐姐，",
      "token_start": 456,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 120620,
      "end_ms": 122460,
      "text": "麻烦您指尖轻点一下，",
      "token_start": 462,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 122460,
      "end_ms": 126040,
      "text": "小红心算给我撑个场也方便。",
      "token_start": 471,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 126040,
      "end_ms": 127480,
      "text": "您想回看的时候，",
      "token_start": 483,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 127500,
      "end_ms": 131565,
      "text": "一翻就找着咱们泡壶茶慢慢往下聊。",
      "token_start": 490,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 132370,
      "end_ms": 136415,
      "text": "咱们把时间拨回到公元一千两百一十八年。",
      "token_start": 505,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 137310,
      "end_ms": 140705,
      "text": "那时候的成吉思汗刚刚统一蒙古草原，",
      "token_start": 523,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 141270,
      "end_ms": 144365,
      "text": "正想跟西边的花喇子模做做生意。",
      "token_start": 539,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 144960,
      "end_ms": 145500,
      "text": "过几天，",
      "token_start": 553,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 145500,
      "end_ms": 146185,
      "text": "安生日子，",
      "token_start": 556,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 146680,
      "end_ms": 149020,
      "text": "他派了一支四百多人的商队，",
      "token_start": 560,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 149060,
      "end_ms": 152895,
      "text": "带着金银和货物浩浩荡荡往花喇子模走。",
      "token_start": 572,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 153520,
      "end_ms": 156775,
      "text": "结果走到一个叫额达腊的边境城市，",
      "token_start": 589,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 157240,
      "end_ms": 159385,
      "text": "花喇子模的守将起了贪心，",
      "token_start": 604,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 159850,
      "end_ms": 161605,
      "text": "把商队的人全杀了，",
      "token_start": 615,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 162180,
      "end_ms": 163335,
      "text": "货物全抢了。",
      "token_start": 623,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 163800,
      "end_ms": 165615,
      "text": "成吉思汗听到这个消息，",
      "token_start": 628,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 165960,
      "end_ms": 167155,
      "text": "没有立刻发兵，",
      "token_start": 638,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 167590,
      "end_ms": 171575,
      "text": "他先派了三个使者去花辣子磨交涉，",
      "token_start": 644,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 172140,
      "end_ms": 173875,
      "text": "说咱们有话好好说，",
      "token_start": 659,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 174210,
      "end_ms": 175585,
      "text": "把凶手交出来就行。",
      "token_start": 667,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 176330,
      "end_ms": 179075,
      "text": "可花喇子魔的国王磨和墨干了什么？",
      "token_start": 675,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 179830,
      "end_ms": 181570,
      "text": "他把蒙古的政史杀了，",
      "token_start": 690,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 181630,
      "end_ms": 184270,
      "text": "把两个副使的胡子剃了赶了回去，",
      "token_start": 699,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 184750,
      "end_ms": 185370,
      "text": "剃胡子。",
      "token_start": 713,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 185370,
      "end_ms": 187669,
      "text": "在当时是对男人最大的侮辱。",
      "token_start": 716,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 188290,
      "end_ms": 190370,
      "text": "成吉思汗听到这个消息，",
      "token_start": 728,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 190670,
      "end_ms": 193530,
      "text": "一个人跑到山顶上摘下帽子，",
      "token_start": 738,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 193790,
      "end_ms": 198090,
      "text": "脸贴着地向长生天祈祷了三天三夜。",
      "token_start": 750,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 198530,
      "end_ms": 201150,
      "text": "然后他站起来说了一句话，",
      "token_start": 765,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 202050,
      "end_ms": 203530,
      "text": "只要我还有一口气，",
      "token_start": 776,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 203990,
      "end_ms": 206350,
      "text": "我就要让花喇子模付出代价。",
      "token_start": 784,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 207190,
      "end_ms": 209050,
      "text": "戴着这种极度的愤怒。",
      "token_start": 796,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 209700,
      "end_ms": 211920,
      "text": "成吉思汗亲率二十万，",
      "token_start": 805,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 211920,
      "end_ms": 213920,
      "text": "蒙古大军越过天山，",
      "token_start": 814,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 214280,
      "end_ms": 215900,
      "text": "杀进了花喇子摩。",
      "token_start": 822,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 216780,
      "end_ms": 218160,
      "text": "花喇子摩虽然富，",
      "token_start": 829,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 218520,
      "end_ms": 221460,
      "text": "但国王摩诃没根本不会打仗，",
      "token_start": 836,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 221460,
      "end_ms": 223840,
      "text": "他把军队分散在各个城里，",
      "token_start": 848,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 224140,
      "end_ms": 225940,
      "text": "想靠城墙硬扛。",
      "token_start": 859,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 226560,
      "end_ms": 228620,
      "text": "蒙古大军像蝗虫一样，",
      "token_start": 865,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 228720,
      "end_ms": 230900,
      "text": "一个城一个城地撵过去，",
      "token_start": 874,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 231840,
      "end_ms": 233115,
      "text": "撒马尔汗投降了，",
      "token_start": 884,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 234960,
      "end_ms": 235380,
      "text": "布哈拉，",
      "token_start": 891,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 235380,
      "end_ms": 236860,
      "text": "被屠了摩诃墨，",
      "token_start": 894,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 236880,
      "end_ms": 238000,
      "text": "一路往西逃，",
      "token_start": 900,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 238400,
      "end_ms": 241405,
      "text": "最后病死在里海的一个小岛上，",
      "token_start": 905,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 242220,
      "end_ms": 247055,
      "text": "可成吉思汗的怒火没有因为摩和墨的死而熄灭，",
      "token_start": 918,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 247760,
      "end_ms": 252235,
      "text": "他把目光转向了花喇子模的旧都玉龙洁赤。",
      "token_start": 938,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 252920,
      "end_ms": 254475,
      "text": "这座城太富了，",
      "token_start": 956,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 254730,
      "end_ms": 256105,
      "text": "城墙太厚了，",
      "token_start": 962,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 256590,
      "end_ms": 258605,
      "text": "里面的守军太顽固了，",
      "token_start": 967,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 259420,
      "end_ms": 262130,
      "text": "蒙古大军围了整整半年，",
      "token_start": 976,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 262390,
      "end_ms": 263555,
      "text": "死了好几个大将，",
      "token_start": 986,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 263820,
      "end_ms": 264915,
      "text": "硬是打不下来。",
      "token_start": 993,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 265340,
      "end_ms": 267485,
      "text": "成吉思汗这时候已经六十多岁了，",
      "token_start": 999,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 267850,
      "end_ms": 270205,
      "text": "常年征战把他的身体拖垮了。",
      "token_start": 1013,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 270610,
      "end_ms": 272755,
      "text": "他在行军途中发起了高烧，",
      "token_start": 1025,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 273400,
      "end_ms": 276275,
      "text": "躺在帐篷里听着前方传来的战报，",
      "token_start": 1036,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 276890,
      "end_ms": 279660,
      "text": "他脑子里翻来覆去想的只有一件事儿，",
      "token_start": 1050,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 280040,
      "end_ms": 281255,
      "text": "如果自己死了，",
      "token_start": 1066,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 281530,
      "end_ms": 283155,
      "text": "玉龙劫翅还没打下来，",
      "token_start": 1072,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 283570,
      "end_ms": 285775,
      "text": "花辣子魔人会不会又缓过劲来？",
      "token_start": 1081,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 286430,
      "end_ms": 287915,
      "text": "蒙古大军撤了以后，",
      "token_start": 1094,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 288270,
      "end_ms": 291865,
      "text": "这座城会不会又变成一根卡在喉咙里的刺？",
      "token_start": 1102,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 292510,
      "end_ms": 297190,
      "text": "对于一个把帝国命运看得比命还重的征服者来说，",
      "token_start": 1120,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 297270,
      "end_ms": 298270,
      "text": "答案只有一个，",
      "token_start": 1141,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 298410,
      "end_ms": 299690,
      "text": "趁自己还能说话，",
      "token_start": 1147,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 300050,
      "end_ms": 303070,
      "text": "把这座城盯死成吉思汗，",
      "token_start": 1154,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 303070,
      "end_ms": 306390,
      "text": "把儿子窝阔台和察和台叫到床前，",
      "token_start": 1164,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 306810,
      "end_ms": 309870,
      "text": "用沙哑的声音交代了最后的命令。",
      "token_start": 1178,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 310390,
      "end_ms": 313390,
      "text": "玉龙劫赤不接受投降。",
      "token_start": 1192,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 313690,
      "end_ms": 314590,
      "text": "城破之后，",
      "token_start": 1201,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 314850,
      "end_ms": 317470,
      "text": "工匠全部挑出来送回蒙古，",
      "token_start": 1205,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 318210,
      "end_ms": 322960,
      "text": "剩下的一个不留城里的金银财宝，",
      "token_start": 1216,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 323740,
      "end_ms": 324700,
      "text": "不用急着搬，",
      "token_start": 1230,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 325500,
      "end_ms": 327040,
      "text": "先把人杀干净再说。",
      "token_start": 1235,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 327480,
      "end_ms": 330740,
      "text": "然后掘开阿姆河的堤坝放水，",
      "token_start": 1243,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 330840,
      "end_ms": 335300,
      "text": "淹城让这座城从此以后再也住不了人。",
      "token_start": 1255,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 335440,
      "end_ms": 336560,
      "text": "交代完这一切，",
      "token_start": 1271,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 336880,
      "end_ms": 340380,
      "text": "成吉思汗在六盘山的军营里闭上了眼睛。",
      "token_start": 1277,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 340980,
      "end_ms": 343680,
      "text": "蒙古大军严格执行了这个命令。",
      "token_start": 1294,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 344100,
      "end_ms": 346420,
      "text": "公元一千两百两十一年四月，",
      "token_start": 1307,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 346900,
      "end_ms": 350645,
      "text": "玉龙劫赤的守军在围了半年之后终于撑不住了，",
      "token_start": 1319,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 351680,
      "end_ms": 353605,
      "text": "城里的粮食早就吃光了，",
      "token_start": 1339,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 353960,
      "end_ms": 355785,
      "text": "连老鼠都被人抓来吃了。",
      "token_start": 1349,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 356460,
      "end_ms": 358025,
      "text": "蒙古军攻破城墙后，",
      "token_start": 1359,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 358550,
      "end_ms": 360855,
      "text": "把全城的老百姓驱赶到城外，",
      "token_start": 1367,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 361630,
      "end_ms": 366195,
      "text": "工匠被一批一批挑出来数了数整整十万，",
      "token_start": 1379,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 367020,
      "end_ms": 368985,
      "text": "全部押送回东方。",
      "token_start": 1396,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 369680,
      "end_ms": 372770,
      "text": "剩下的壮丁被编进了蒙古军队，",
      "token_start": 1403,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 372830,
      "end_ms": 373410,
      "text": "当炮灰，",
      "token_start": 1416,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 373410,
      "end_ms": 376695,
      "text": "使其余的居民不管男女老少，",
      "token_start": 1419,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 377180,
      "end_ms": 380165,
      "text": "全部被分配给了蒙古将士，",
      "token_start": 1431,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 380560,
      "end_ms": 384695,
      "text": "任由处置史书上写的冰冷渔民进屠。",
      "token_start": 1442,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 385650,
      "end_ms": 390665,
      "text": "接下来发生的事情超出了当时中亚人对战争的一切想象。",
      "token_start": 1457,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 391500,
      "end_ms": 393235,
      "text": "蒙古士兵挨家挨户搜，",
      "token_start": 1481,
      "token_end_exclusive": 1490
    },
    {
      "start_ms": 393980,
      "end_ms": 394985,
      "text": "只要是活着的，",
      "token_start": 1490,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 395320,
      "end_ms": 396985,
      "text": "不管你是念经的学者，",
      "token_start": 1496,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 397320,
      "end_ms": 398795,
      "text": "还是种地的农民。",
      "token_start": 1505,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 399100,
      "end_ms": 399885,
      "text": "一刀下去，",
      "token_start": 1512,
      "token_end_exclusive": 1516
    },
    {
      "start_ms": 400310,
      "end_ms": 401905,
      "text": "玉龙截翅的街道上，",
      "token_start": 1516,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 402310,
      "end_ms": 405395,
      "text": "尸体堆的比城墙还高学，",
      "token_start": 1524,
      "token_end_exclusive": 1534
    },
    {
      "start_ms": 405830,
      "end_ms": 408375,
      "text": "顺着排水沟流进了阿姆河，",
      "token_start": 1534,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 409270,
      "end_ms": 410770,
      "text": "把河水都染红了。",
      "token_start": 1545,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 410830,
      "end_ms": 412175,
      "text": "可杀人只是第一步，",
      "token_start": 1552,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 412780,
      "end_ms": 415125,
      "text": "蒙古人把城里的清真寺推倒，",
      "token_start": 1560,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 415380,
      "end_ms": 418860,
      "text": "把经学院里的藏书和手稿全部搬出来，",
      "token_start": 1572,
      "token_end_exclusive": 1588
    },
    {
      "start_ms": 418960,
      "end_ms": 420065,
      "text": "堆在广场上，",
      "token_start": 1588,
      "token_end_exclusive": 1593
    },
    {
      "start_ms": 420320,
      "end_ms": 422340,
      "text": "一把火烧了花。",
      "token_start": 1593,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 422340,
      "end_ms": 429845,
      "text": "喇子魔人写的史书诗集、天文历法、医学典籍烧了整整几天几夜。",
      "token_start": 1599,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 430760,
      "end_ms": 434735,
      "text": "花喇子模的文字写在羊皮和木片上的那种，",
      "token_start": 1625,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 435470,
      "end_ms": 437225,
      "text": "从此以后再也没有人教，",
      "token_start": 1643,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 437920,
      "end_ms": 439005,
      "text": "再也没有人写。",
      "token_start": 1653,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 439750,
      "end_ms": 442300,
      "text": "然后蒙古士兵掘开了，",
      "token_start": 1659,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 442300,
      "end_ms": 443465,
      "text": "阿姆河的堤坝，",
      "token_start": 1668,
      "token_end_exclusive": 1674
    },
    {
      "start_ms": 444180,
      "end_ms": 448910,
      "text": "洪水像一头野兽一样冲进了玉龙皆持把，",
      "token_start": 1674,
      "token_end_exclusive": 1691
    },
    {
      "start_ms": 448910,
      "end_ms": 453515,
      "text": "剩下的房屋、宫殿、寺庙全部泡在了水里，",
      "token_start": 1691,
      "token_end_exclusive": 1707
    },
    {
      "start_ms": 454310,
      "end_ms": 459265,
      "text": "一座曾经比巴格达还繁华的城市变成了一片沼泽。",
      "token_start": 1707,
      "token_end_exclusive": 1728
    },
    {
      "start_ms": 460110,
      "end_ms": 461955,
      "text": "玉龙劫翅被淹掉之后，",
      "token_start": 1728,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 462410,
      "end_ms": 465415,
      "text": "蒙古人在旁边重新建了一座小城，",
      "token_start": 1737,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 466050,
      "end_ms": 471215,
      "text": "但花蜡子模这个名字从此在中亚的历史上彻底消失了。",
      "token_start": 1751,
      "token_end_exclusive": 1774
    },
    {
      "start_ms": 472020,
      "end_ms": 473995,
      "text": "没有人再提花剌子墨的文字。",
      "token_start": 1774,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 474520,
      "end_ms": 477435,
      "text": "没有人再提玉荣劫持的经学院。",
      "token_start": 1786,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 477950,
      "end_ms": 482555,
      "text": "没有人再提那条曾经养活了几十万人的丝路商道。",
      "token_start": 1799,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 483230,
      "end_ms": 485080,
      "text": "此后几百年里，",
      "token_start": 1820,
      "token_end_exclusive": 1826
    },
    {
      "start_ms": 485140,
      "end_ms": 488165,
      "text": "这片土地上来来往往的都是新的征服者，",
      "token_start": 1826,
      "token_end_exclusive": 1843
    },
    {
      "start_ms": 488480,
      "end_ms": 492875,
      "text": "新的帝国花辣子馍就像从来没有存在过一样。",
      "token_start": 1843,
      "token_end_exclusive": 1862
    },
    {
      "start_ms": 493400,
      "end_ms": 494315,
      "text": "直到近代，",
      "token_start": 1862,
      "token_end_exclusive": 1866
    },
    {
      "start_ms": 494670,
      "end_ms": 498435,
      "text": "考古学家拿着铲子跑到土库曼斯坦的沙漠里，",
      "token_start": 1866,
      "token_end_exclusive": 1885
    },
    {
      "start_ms": 498980,
      "end_ms": 501380,
      "text": "在库尼亚沃尔根旗的遗址底下，",
      "token_start": 1885,
      "token_end_exclusive": 1898
    },
    {
      "start_ms": 501420,
      "end_ms": 507865,
      "text": "挖出了花喇子摩时代的钱币、陶器和刻着花喇子馍文字的残片。",
      "token_start": 1898,
      "token_end_exclusive": 1924
    },
    {
      "start_ms": 508660,
      "end_ms": 517565,
      "text": "这个被大火和洪水从人类记忆里强行抠掉的文明才一点一点从土里被刨了出来。",
      "token_start": 1924,
      "token_end_exclusive": 1958
    },
    {
      "start_ms": 518540,
      "end_ms": 520020,
      "text": "很多人读到这段历史，",
      "token_start": 1958,
      "token_end_exclusive": 1967
    },
    {
      "start_ms": 520140,
      "end_ms": 521405,
      "text": "心里都会堵的慌。",
      "token_start": 1967,
      "token_end_exclusive": 1974
    },
    {
      "start_ms": 522410,
      "end_ms": 525065,
      "text": "成吉思汗在蒙古草原上是一个神，",
      "token_start": 1974,
      "token_end_exclusive": 1988
    },
    {
      "start_ms": 525840,
      "end_ms": 527065,
      "text": "他统一了部落，",
      "token_start": 1988,
      "token_end_exclusive": 1994
    },
    {
      "start_ms": 527390,
      "end_ms": 528445,
      "text": "建立了帝国，",
      "token_start": 1994,
      "token_end_exclusive": 1999
    },
    {
      "start_ms": 528990,
      "end_ms": 530795,
      "text": "打通了东西方的商路。",
      "token_start": 1999,
      "token_end_exclusive": 2008
    },
    {
      "start_ms": 531710,
      "end_ms": 533745,
      "text": "可他在花喇子摩做的事情，",
      "token_start": 2008,
      "token_end_exclusive": 2019
    },
    {
      "start_ms": 534390,
      "end_ms": 537855,
      "text": "让所有读过这段历史的人都后背发凉。",
      "token_start": 2019,
      "token_end_exclusive": 2035
    },
    {
      "start_ms": 538520,
      "end_ms": 539895,
      "text": "他下的那道命令，",
      "token_start": 2035,
      "token_end_exclusive": 2042
    },
    {
      "start_ms": 540270,
      "end_ms": 542445,
      "text": "说到底不是一时的暴怒，",
      "token_start": 2042,
      "token_end_exclusive": 2052
    },
    {
      "start_ms": 542860,
      "end_ms": 545140,
      "text": "而是一种极其冷血的帝王，",
      "token_start": 2052,
      "token_end_exclusive": 2063
    },
    {
      "start_ms": 545160,
      "end_ms": 546900,
      "text": "算计一个城，",
      "token_start": 2063,
      "token_end_exclusive": 2068
    },
    {
      "start_ms": 546920,
      "end_ms": 548025,
      "text": "只要还有人住，",
      "token_start": 2068,
      "token_end_exclusive": 2074
    },
    {
      "start_ms": 548560,
      "end_ms": 551125,
      "text": "只要还有人记得自己的文字和信仰，",
      "token_start": 2074,
      "token_end_exclusive": 2089
    },
    {
      "start_ms": 551460,
      "end_ms": 553565,
      "text": "他就有可能重新站起来。",
      "token_start": 2089,
      "token_end_exclusive": 2099
    },
    {
      "start_ms": 554000,
      "end_ms": 556420,
      "text": "所以最彻底的办法不是打赢，",
      "token_start": 2099,
      "token_end_exclusive": 2111
    },
    {
      "start_ms": 556480,
      "end_ms": 559505,
      "text": "他是让他从地图上消失，",
      "token_start": 2111,
      "token_end_exclusive": 2121
    },
    {
      "start_ms": 559940,
      "end_ms": 561605,
      "text": "从记忆里断掉。",
      "token_start": 2121,
      "token_end_exclusive": 2127
    },
    {
      "start_ms": 562340,
      "end_ms": 563960,
      "text": "今日的千古迷局，",
      "token_start": 2127,
      "token_end_exclusive": 2134
    },
    {
      "start_ms": 564060,
      "end_ms": 565115,
      "text": "咱就聊到这儿。",
      "token_start": 2134,
      "token_end_exclusive": 2140
    },
    {
      "start_ms": 565330,
      "end_ms": 566710,
      "text": "可最要命的谜团，",
      "token_start": 2140,
      "token_end_exclusive": 2147
    },
    {
      "start_ms": 567050,
      "end_ms": 569755,
      "text": "其实还埋在阿姆河的淤泥底下。",
      "token_start": 2147,
      "token_end_exclusive": 2160
    },
    {
      "start_ms": 570390,
      "end_ms": 573410,
      "text": "当御龙劫持的工匠们被蒙古兵压着，",
      "token_start": 2160,
      "token_end_exclusive": 2175
    },
    {
      "start_ms": 573410,
      "end_ms": 575070,
      "text": "往东走回头，",
      "token_start": 2175,
      "token_end_exclusive": 2180
    },
    {
      "start_ms": 575070,
      "end_ms": 578705,
      "text": "看见自己的家乡正在被洪水吞没的时候，",
      "token_start": 2180,
      "token_end_exclusive": 2197
    },
    {
      "start_ms": 579170,
      "end_ms": 581895,
      "text": "他们心里到底是恨蒙古人太狠，",
      "token_start": 2197,
      "token_end_exclusive": 2210
    },
    {
      "start_ms": 582640,
      "end_ms": 584060,
      "text": "还是恨自己的国王，",
      "token_start": 2210,
      "token_end_exclusive": 2218
    },
    {
      "start_ms": 584080,
      "end_ms": 587615,
      "text": "当初为什么要剃掉那三个使者的胡子？",
      "token_start": 2218,
      "token_end_exclusive": 2234
    },
    {
      "start_ms": 588350,
      "end_ms": 593570,
      "text": "而成吉思汗在六盘山的帐篷里咽下最后一口气的时候，",
      "token_start": 2234,
      "token_end_exclusive": 2257
    },
    {
      "start_ms": 593570,
      "end_ms": 597695,
      "text": "他到底觉得自己是在为蒙古帝国永绝后患，",
      "token_start": 2257,
      "token_end_exclusive": 2275
    },
    {
      "start_ms": 598080,
      "end_ms": 603225,
      "text": "还是被一股连他自己都控制不住的怒火推着走完了最后一步。",
      "token_start": 2275,
      "token_end_exclusive": 2301
    },
    {
      "start_ms": 603740,
      "end_ms": 604635,
      "text": "最后问您一句，",
      "token_start": 2301,
      "token_end_exclusive": 2307
    },
    {
      "start_ms": 605090,
      "end_ms": 607195,
      "text": "抛开一代天骄的光环，",
      "token_start": 2307,
      "token_end_exclusive": 2316
    },
    {
      "start_ms": 607730,
      "end_ms": 614215,
      "text": "您觉得成吉思汗下令水淹遇龙结翅屠灭花喇子模这件事，",
      "token_start": 2316,
      "token_end_exclusive": 2340
    },
    {
      "start_ms": 614600,
      "end_ms": 618435,
      "text": "到底是一个帝国缔造者必须做的决断，",
      "token_start": 2340,
      "token_end_exclusive": 2356
    },
    {
      "start_ms": 618970,
      "end_ms": 626265,
      "text": "还是一个被愤怒和权力同时吞掉的人对另一个文明犯下的不可原谅的罪行，",
      "token_start": 2356,
      "token_end_exclusive": 2388
    },
    {
      "start_ms": 627190,
      "end_ms": 629545,
      "text": "评论区静待您的高见。",
      "token_start": 2388,
      "token_end_exclusive": 2397
    },
    {
      "start_ms": 629840,
      "end_ms": 633115,
      "text": "如果您喜欢听这种藏在历史缝里的故事，",
      "token_start": 2397,
      "token_end_exclusive": 2414
    },
    {
      "start_ms": 633570,
      "end_ms": 634815,
      "text": "别忘了点个关注，",
      "token_start": 2414,
      "token_end_exclusive": 2421
    },
    {
      "start_ms": 635250,
      "end_ms": 637125,
      "text": "带您看透历史迷局。",
      "token_start": 2421,
      "token_end_exclusive": 2429
    },
    {
      "start_ms": 637840,
      "end_ms": 639065,
      "text": "咱们下期视频见。",
      "token_start": 2429,
      "token_end_exclusive": 2436
    }
