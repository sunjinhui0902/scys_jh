  "segments": [
    {
      "start_ms": 410,
      "end_ms": 2550,
      "text": "何其有幸生于华夏，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2890,
      "end_ms": 3810,
      "text": "安于盛世，",
      "token_start": 8,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 4330,
      "end_ms": 5370,
      "text": "见证百年。",
      "token_start": 12,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 6170,
      "end_ms": 7530,
      "text": "我们生在红旗下，",
      "token_start": 16,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 7970,
      "end_ms": 9070,
      "text": "长在春风里，",
      "token_start": 23,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 9590,
      "end_ms": 10630,
      "text": "人民有信仰，",
      "token_start": 28,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 10910,
      "end_ms": 12070,
      "text": "国家有力量，",
      "token_start": 33,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 12510,
      "end_ms": 13750,
      "text": "民族有希望，",
      "token_start": 38,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 14290,
      "end_ms": 16190,
      "text": "目光所至皆华夏。",
      "token_start": 43,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 16750,
      "end_ms": 20630,
      "text": "五星红旗皆信仰生于盛世，",
      "token_start": 50,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 20910,
      "end_ms": 22130,
      "text": "当不负盛世，",
      "token_start": 61,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 22790,
      "end_ms": 24270,
      "text": "愿以无辈之青春，",
      "token_start": 66,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 24750,
      "end_ms": 27090,
      "text": "捍卫着盛世之中华，",
      "token_start": 73,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 27870,
      "end_ms": 29010,
      "text": "祝愿祖国母亲，",
      "token_start": 81,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 29430,
      "end_ms": 29935,
      "text": "繁荣昌，",
      "token_start": 87,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 30040,
      "end_ms": 33185,
      "text": "昌盛、国泰民安。",
      "token_start": 90,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 35970,
      "end_ms": 36210,
      "text": "嗯。",
      "token_start": 96,
      "token_end_exclusive": 97
    }
