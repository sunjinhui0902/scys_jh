{
  "video_id": "v_5a1f4e863379cd2e",
  "duration_s": 536.707007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_5a1f4e863379cd2e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_5a1f4e863379cd2e.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 3450,
      "text": "您知道中国此生必看的十大壮丽奇观里，",
      "token_start": 0,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 3630,
      "end_ms": 5430,
      "text": "最震撼的是哪一个吗？",
      "token_start": 17,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6050,
      "end_ms": 10270,
      "text": "有人说是兵马俑那支沉睡两千两百年的地下军团。",
      "token_start": 26,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 10990,
      "end_ms": 13490,
      "text": "有人说是雄志千年的黄山，",
      "token_start": 47,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 13530,
      "end_ms": 15050,
      "text": "云海错了，",
      "token_start": 58,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 15450,
      "end_ms": 17270,
      "text": "黄山排在第十位。",
      "token_start": 62,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 18010,
      "end_ms": 20030,
      "text": "兵马俑也压不住榜首，",
      "token_start": 69,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 20450,
      "end_ms": 23010,
      "text": "真正排榜首的那一处，",
      "token_start": 78,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 23390,
      "end_ms": 24390,
      "text": "不在中原，",
      "token_start": 87,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 24870,
      "end_ms": 25890,
      "text": "不在江南，",
      "token_start": 91,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 26330,
      "end_ms": 31740,
      "text": "真把世界屋脊硬生生劈开一道口子谷底。",
      "token_start": 95,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 31820,
      "end_ms": 33160,
      "text": "长着热带的树，",
      "token_start": 112,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 33420,
      "end_ms": 35920,
      "text": "抬头就是终年不化的雪。",
      "token_start": 118,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 36360,
      "end_ms": 40580,
      "text": "今天咱们就来盘点中国十大此生必看的壮丽奇观，",
      "token_start": 128,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 41420,
      "end_ms": 43520,
      "text": "还是咱们的老规矩开讲。",
      "token_start": 149,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 43540,
      "end_ms": 46740,
      "text": "之前劳烦各位老友顺手点亮红心，",
      "token_start": 159,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 47040,
      "end_ms": 47660,
      "text": "评论区，",
      "token_start": 173,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 47660,
      "end_ms": 52360,
      "text": "打个来了让我看看今天又有多少知音来捧场。",
      "token_start": 176,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 52780,
      "end_ms": 53440,
      "text": "第十名，",
      "token_start": 195,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 53920,
      "end_ms": 56260,
      "text": "安徽黄山黄山，",
      "token_start": 198,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 56260,
      "end_ms": 57280,
      "text": "您太熟了，",
      "token_start": 204,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 57720,
      "end_ms": 59555,
      "text": "五岳归来不看山，",
      "token_start": 208,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 60020,
      "end_ms": 61495,
      "text": "黄山归来不看月，",
      "token_start": 215,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 61950,
      "end_ms": 62955,
      "text": "说的就是他，",
      "token_start": 222,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 63560,
      "end_ms": 67005,
      "text": "可大部分人上黄山的时间挑错了，",
      "token_start": 227,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 67480,
      "end_ms": 68235,
      "text": "大晴天，",
      "token_start": 241,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 68740,
      "end_ms": 69435,
      "text": "人挤人，",
      "token_start": 244,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 69990,
      "end_ms": 73935,
      "text": "排着队在那个迎客松前面拍张合影就下来了。",
      "token_start": 247,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 74700,
      "end_ms": 76665,
      "text": "真正懂黄山的人，",
      "token_start": 266,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 77040,
      "end_ms": 78180,
      "text": "盼的是阴天，",
      "token_start": 273,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 78280,
      "end_ms": 78785,
      "text": "下雨，",
      "token_start": 278,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 79240,
      "end_ms": 80135,
      "text": "雨一停，",
      "token_start": 280,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 80560,
      "end_ms": 83775,
      "text": "山风一吹云就从谷底往上涌，",
      "token_start": 283,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 84100,
      "end_ms": 86905,
      "text": "大大小小的风头全被云淹了，",
      "token_start": 295,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 87210,
      "end_ms": 88965,
      "text": "只剩下尖尖露在外面，",
      "token_start": 307,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 89560,
      "end_ms": 90945,
      "text": "像海上的小岛，",
      "token_start": 316,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 91370,
      "end_ms": 92945,
      "text": "您站在崖边，",
      "token_start": 322,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 93360,
      "end_ms": 94060,
      "text": "脚底下，",
      "token_start": 327,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 94160,
      "end_ms": 95455,
      "text": "白茫茫一片，",
      "token_start": 330,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 95860,
      "end_ms": 96680,
      "text": "云在动，",
      "token_start": 335,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 96960,
      "end_ms": 98045,
      "text": "小岛也在动。",
      "token_start": 338,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 98920,
      "end_ms": 99580,
      "text": "那一刻，",
      "token_start": 343,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 99580,
      "end_ms": 100280,
      "text": "您就明白，",
      "token_start": 346,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 100280,
      "end_ms": 102325,
      "text": "古人为什么管它叫云海，",
      "token_start": 350,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 102710,
      "end_ms": 103815,
      "text": "那不是以景，",
      "token_start": 360,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 104200,
      "end_ms": 105225,
      "text": "那是一片海。",
      "token_start": 365,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 105710,
      "end_ms": 106785,
      "text": "再看那些松树，",
      "token_start": 370,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 107250,
      "end_ms": 109050,
      "text": "长在光秃秃的花岗岩，",
      "token_start": 376,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 109050,
      "end_ms": 110545,
      "text": "石缝里没土，",
      "token_start": 385,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 110850,
      "end_ms": 112620,
      "text": "没水根就那么死死，",
      "token_start": 390,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 112640,
      "end_ms": 113495,
      "text": "咬着石头，",
      "token_start": 398,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 113970,
      "end_ms": 115250,
      "text": "枝干还往外伸，",
      "token_start": 402,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 115550,
      "end_ms": 116455,
      "text": "往上看，",
      "token_start": 408,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 117020,
      "end_ms": 117800,
      "text": "晴天看，",
      "token_start": 411,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 117800,
      "end_ms": 119680,
      "text": "他是树云里看，",
      "token_start": 414,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 119680,
      "end_ms": 123445,
      "text": "他是一笔墨徐霞客当年爬完黄山，",
      "token_start": 420,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 124270,
      "end_ms": 126715,
      "text": "写下渤海内外之名山，",
      "token_start": 434,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 127370,
      "end_ms": 128935,
      "text": "无如灰之黄山。",
      "token_start": 443,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 129690,
      "end_ms": 133585,
      "text": "他看见的跟您现在看见的是同一场云，",
      "token_start": 449,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 134050,
      "end_ms": 135665,
      "text": "这就是黄山的脾气，",
      "token_start": 465,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 136450,
      "end_ms": 138110,
      "text": "宁越挑好天气，",
      "token_start": 473,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 138210,
      "end_ms": 138565,
      "text": "去，",
      "token_start": 479,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 139150,
      "end_ms": 141375,
      "text": "越看不见他最好的样子。",
      "token_start": 480,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 141780,
      "end_ms": 144845,
      "text": "第九名鸣沙山月牙泉，",
      "token_start": 490,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 145200,
      "end_ms": 148385,
      "text": "甘肃敦煌这一处没什么说道，",
      "token_start": 499,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 148690,
      "end_ms": 150005,
      "text": "就一个字怪，",
      "token_start": 511,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 150510,
      "end_ms": 152910,
      "text": "四面全是沙山风，",
      "token_start": 516,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 152990,
      "end_ms": 158150,
      "text": "一年刮到头沙子一天到晚往谷底滚可谷底，",
      "token_start": 523,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 158190,
      "end_ms": 159615,
      "text": "偏偏躺着一汪水，",
      "token_start": 541,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 160090,
      "end_ms": 164765,
      "text": "形状像一弯月牙两千多年没被填平过。",
      "token_start": 548,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 165290,
      "end_ms": 167485,
      "text": "您越琢磨越觉得不可思议，",
      "token_start": 564,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 168150,
      "end_ms": 170615,
      "text": "一边是能把骆驼埋掉的沙，",
      "token_start": 575,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 171090,
      "end_ms": 172605,
      "text": "一边是不肯干，",
      "token_start": 586,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 172880,
      "end_ms": 173895,
      "text": "不肯浑的水，",
      "token_start": 592,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 174500,
      "end_ms": 176985,
      "text": "就这么脸对脸呆了两千年。",
      "token_start": 597,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 177430,
      "end_ms": 180180,
      "text": "所以当地人管他叫沙井叫，",
      "token_start": 608,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 180180,
      "end_ms": 182060,
      "text": "要全都盼着，",
      "token_start": 619,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 182060,
      "end_ms": 184400,
      "text": "它是活的真去看。",
      "token_start": 624,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 184940,
      "end_ms": 186380,
      "text": "最好的时候是黄昏，",
      "token_start": 631,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 186860,
      "end_ms": 188640,
      "text": "您爬到沙梁上坐下来，",
      "token_start": 639,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 189300,
      "end_ms": 190440,
      "text": "太阳往下沉，",
      "token_start": 648,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 191300,
      "end_ms": 194140,
      "text": "一边是金灿灿的沙海风，",
      "token_start": 653,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 194240,
      "end_ms": 196480,
      "text": "把沙棘吹的跟刀片子似的，",
      "token_start": 663,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 197040,
      "end_ms": 198520,
      "text": "一道一道全是棱。",
      "token_start": 674,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 199160,
      "end_ms": 199800,
      "text": "另一边，",
      "token_start": 681,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 199800,
      "end_ms": 200740,
      "text": "就那一碗水，",
      "token_start": 684,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 201160,
      "end_ms": 202520,
      "text": "安安静静躺着，",
      "token_start": 689,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 202700,
      "end_ms": 204320,
      "text": "把天光收在里面，",
      "token_start": 695,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 204760,
      "end_ms": 208340,
      "text": "苍凉和生机中间就隔着一条沙棘，",
      "token_start": 702,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 208880,
      "end_ms": 211190,
      "text": "一眼看尽风沙。",
      "token_start": 716,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 211210,
      "end_ms": 211490,
      "text": "说了，",
      "token_start": 722,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 211490,
      "end_ms": 212430,
      "text": "两千年的，",
      "token_start": 724,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 212490,
      "end_ms": 213570,
      "text": "我要填平你。",
      "token_start": 728,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 214090,
      "end_ms": 215970,
      "text": "泉水说了两千年的，",
      "token_start": 733,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 216030,
      "end_ms": 218350,
      "text": "我还在就冲这一生，",
      "token_start": 741,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 218390,
      "end_ms": 220090,
      "text": "我还在他值得排。",
      "token_start": 749,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 220090,
      "end_ms": 220510,
      "text": "第九，",
      "token_start": 756,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 220750,
      "end_ms": 221470,
      "text": "第八名，",
      "token_start": 758,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 222010,
      "end_ms": 223390,
      "text": "黄果树瀑布，",
      "token_start": 761,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 223690,
      "end_ms": 226009,
      "text": "贵州安顺瀑布，",
      "token_start": 766,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 226030,
      "end_ms": 226850,
      "text": "谁没见过？",
      "token_start": 772,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 227350,
      "end_ms": 230210,
      "text": "可黄果树有个别人没有的带鱼，",
      "token_start": 776,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 230630,
      "end_ms": 232250,
      "text": "您能走到它后面去。",
      "token_start": 789,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 232650,
      "end_ms": 234450,
      "text": "瀑布底下那道悬崖里，",
      "token_start": 797,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 235030,
      "end_ms": 239485,
      "text": "瀑着一条一百多米长的石缝叫水帘洞，",
      "token_start": 806,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 240330,
      "end_ms": 242630,
      "text": "人从侧面一步步钻进去。",
      "token_start": 822,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 243050,
      "end_ms": 244790,
      "text": "走到正中间的时候，",
      "token_start": 832,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 245270,
      "end_ms": 248190,
      "text": "您就站在这挂瀑布的背面了，",
      "token_start": 840,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 248530,
      "end_ms": 250290,
      "text": "头顶上是压下来的。",
      "token_start": 852,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 250290,
      "end_ms": 253110,
      "text": "水脚底下是湿的石头，",
      "token_start": 860,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 253790,
      "end_ms": 257290,
      "text": "成吨成吨的水从眼前砸下去，",
      "token_start": 869,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 257910,
      "end_ms": 261370,
      "text": "隔着一层水木外面什么都模糊了，",
      "token_start": 881,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 261730,
      "end_ms": 262930,
      "text": "耳朵先受不了，",
      "token_start": 895,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 263350,
      "end_ms": 264290,
      "text": "那不是水声，",
      "token_start": 901,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 264730,
      "end_ms": 265850,
      "text": "是一堵墙，",
      "token_start": 906,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 266050,
      "end_ms": 267710,
      "text": "一直在您旁边炸开，",
      "token_start": 910,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 268130,
      "end_ms": 268910,
      "text": "嗡嗡嗡，",
      "token_start": 918,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 268950,
      "end_ms": 270020,
      "text": "把整个脑子灌满。",
      "token_start": 921,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 270540,
      "end_ms": 273440,
      "text": "八六版西游记片尾师徒四个，",
      "token_start": 928,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 273440,
      "end_ms": 275040,
      "text": "就是从这儿踩过去的。",
      "token_start": 940,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 275460,
      "end_ms": 277840,
      "text": "多少人小时候在电视上看过，",
      "token_start": 949,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 278260,
      "end_ms": 280960,
      "text": "可不知道脚底下真有这么个地方。",
      "token_start": 961,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 281540,
      "end_ms": 283880,
      "text": "外边是一百多米宽的水，",
      "token_start": 975,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 284260,
      "end_ms": 289160,
      "text": "万马奔腾里头是一步一滴水的幽深，",
      "token_start": 985,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 289240,
      "end_ms": 289700,
      "text": "石缝，",
      "token_start": 1000,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 290380,
      "end_ms": 291480,
      "text": "一墙之隔，",
      "token_start": 1002,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 291840,
      "end_ms": 292740,
      "text": "两个世界，",
      "token_start": 1006,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 293300,
      "end_ms": 297055,
      "text": "这种能把手伸进瀑布肚子里的震撼。",
      "token_start": 1010,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 297450,
      "end_ms": 303630,
      "text": "全国找不到第二家第七名、张家界、武陵源、湖南、张家界。",
      "token_start": 1025,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 304310,
      "end_ms": 305830,
      "text": "前面几个是好，",
      "token_start": 1047,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 305850,
      "end_ms": 308010,
      "text": "看到这儿开始震撼，",
      "token_start": 1053,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 308630,
      "end_ms": 314450,
      "text": "三千根石柱一根一根从地上直插上去高的三百多米，",
      "token_start": 1061,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 314670,
      "end_ms": 316730,
      "text": "低的也有几十米高，",
      "token_start": 1083,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 316790,
      "end_ms": 323310,
      "text": "是刀削过一样的直壁柱跟柱之间留着一道成年人过不去的窄缝，",
      "token_start": 1091,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 323750,
      "end_ms": 325590,
      "text": "您站在谷底往上看，",
      "token_start": 1118,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 325950,
      "end_ms": 330460,
      "text": "头顶的天被切成成一条一条的风从缝里穿下来，",
      "token_start": 1126,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 330680,
      "end_ms": 333700,
      "text": "声音都是斜的这不是山，",
      "token_start": 1146,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 334060,
      "end_ms": 336500,
      "text": "这是一排排站着的石头，",
      "token_start": 1156,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 337100,
      "end_ms": 338120,
      "text": "它怎么来的？",
      "token_start": 1166,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 338440,
      "end_ms": 339680,
      "text": "三亿多年前，",
      "token_start": 1171,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 340200,
      "end_ms": 343380,
      "text": "这一带是一片平坦的沙岩台地。",
      "token_start": 1176,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 343940,
      "end_ms": 345480,
      "text": "后来地壳抬起来，",
      "token_start": 1189,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 346100,
      "end_ms": 349860,
      "text": "水顺着石头里的裂缝往下切一条缝，",
      "token_start": 1196,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 350020,
      "end_ms": 352840,
      "text": "一年深一点点切了三亿年，",
      "token_start": 1211,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 353320,
      "end_ms": 356500,
      "text": "把一整块地切成了三千根柱子。",
      "token_start": 1222,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 356820,
      "end_ms": 358470,
      "text": "别人您是长出来的，",
      "token_start": 1235,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 358590,
      "end_ms": 359805,
      "text": "它是刻出来的。",
      "token_start": 1243,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 360410,
      "end_ms": 362185,
      "text": "赶上起云雾的日子，",
      "token_start": 1249,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 362500,
      "end_ms": 368575,
      "text": "云不进谷底就横在半山腰上面露着一排柱头，",
      "token_start": 1257,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 369070,
      "end_ms": 372400,
      "text": "下面藏着一整片谷整片枫林，",
      "token_start": 1276,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 372640,
      "end_ms": 374845,
      "text": "看着就像悬在空中，",
      "token_start": 1288,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 375310,
      "end_ms": 379255,
      "text": "当地人说是三千奇风八百秀水，",
      "token_start": 1296,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 380080,
      "end_ms": 381020,
      "text": "这不是哪位？",
      "token_start": 1309,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 381040,
      "end_ms": 382235,
      "text": "古人写出来的，",
      "token_start": 1314,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 382820,
      "end_ms": 384200,
      "text": "是老天爷拿水。",
      "token_start": 1320,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 384260,
      "end_ms": 387385,
      "text": "当刀一刀一刀削出来的地骨，",
      "token_start": 1326,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 387750,
      "end_ms": 388445,
      "text": "第六名，",
      "token_start": 1338,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 388850,
      "end_ms": 394240,
      "text": "秦始皇陵兵马俑、陕西西安这一处不用我说，",
      "token_start": 1341,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 394240,
      "end_ms": 397545,
      "text": "您也听过世界第八大奇迹，",
      "token_start": 1359,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 398170,
      "end_ms": 400355,
      "text": "可他最厉害的地方不在多，",
      "token_start": 1370,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 400670,
      "end_ms": 403605,
      "text": "在真八千多个泥人排成方阵，",
      "token_start": 1381,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 404320,
      "end_ms": 405605,
      "text": "一个一个都不重样。",
      "token_start": 1393,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 406010,
      "end_ms": 407815,
      "text": "您弯下腰细看，",
      "token_start": 1401,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 408280,
      "end_ms": 410145,
      "text": "能看见特别小的东西，",
      "token_start": 1407,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 411000,
      "end_ms": 415505,
      "text": "有的陶俑鞋底上还留着一道一道的针脚纹，",
      "token_start": 1416,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 416240,
      "end_ms": 420715,
      "text": "有的胳膊内侧有一个工匠按下去的手指印儿。",
      "token_start": 1434,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 421050,
      "end_ms": 422515,
      "text": "两千两百多年了，",
      "token_start": 1453,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 422850,
      "end_ms": 423950,
      "text": "那个人早没了，",
      "token_start": 1460,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 424230,
      "end_ms": 425615,
      "text": "名字也没留下来，",
      "token_start": 1466,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 426260,
      "end_ms": 428655,
      "text": "可他的指纹还在泥上，",
      "token_start": 1473,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 429080,
      "end_ms": 429840,
      "text": "再往前排，",
      "token_start": 1482,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 429840,
      "end_ms": 432815,
      "text": "看最前面那几排不穿铠甲，",
      "token_start": 1486,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 433350,
      "end_ms": 436305,
      "text": "都是些十几二十出头的小伙子，",
      "token_start": 1497,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 437040,
      "end_ms": 438775,
      "text": "脸是照着真人做的，",
      "token_start": 1510,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 439350,
      "end_ms": 441285,
      "text": "有人嘴角往下抿着，",
      "token_start": 1518,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 441750,
      "end_ms": 443155,
      "text": "有人眼神发愣，",
      "token_start": 1526,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 443800,
      "end_ms": 445165,
      "text": "不知道在想什么。",
      "token_start": 1532,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 445570,
      "end_ms": 446865,
      "text": "他们不是雕塑，",
      "token_start": 1539,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 447400,
      "end_ms": 453025,
      "text": "是一支被泥封了两千两百年还没开口的队伍，",
      "token_start": 1545,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 453800,
      "end_ms": 455225,
      "text": "您站在坑边上，",
      "token_start": 1564,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 455770,
      "end_ms": 459235,
      "text": "一整个坑的人齐刷刷朝着一个方向站着，",
      "token_start": 1570,
      "token_end_exclusive": 1587
    },
    {
      "start_ms": 459670,
      "end_ms": 463330,
      "text": "他们等的那个皇帝就睡在旁边，",
      "token_start": 1587,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 463350,
      "end_ms": 465775,
      "text": "那座至今没打开的地宫里。",
      "token_start": 1600,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 466670,
      "end_ms": 471025,
      "text": "前面这五个地方是大地给咱们看的奇景，",
      "token_start": 1611,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 471810,
      "end_ms": 475045,
      "text": "这一处是人给咱们留下的奇景。",
      "token_start": 1628,
      "token_end_exclusive": 1641
    },
    {
      "start_ms": 475420,
      "end_ms": 477485,
      "text": "从第十到第六名，",
      "token_start": 1641,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 477900,
      "end_ms": 480855,
      "text": "黄山是等一场雨才看得见的山。",
      "token_start": 1648,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 481590,
      "end_ms": 485125,
      "text": "鸣沙山是一汪跟沙子对峙了两千年的水，",
      "token_start": 1661,
      "token_end_exclusive": 1678
    },
    {
      "start_ms": 485940,
      "end_ms": 489035,
      "text": "黄果树是能走到他背面去的瀑布。",
      "token_start": 1678,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 489430,
      "end_ms": 493125,
      "text": "张家界是水拿三亿年刻出来的三千根石头柱子。",
      "token_start": 1692,
      "token_end_exclusive": 1712
    },
    {
      "start_ms": 493550,
      "end_ms": 496285,
      "text": "兵马俑是带的工匠指纹的八千个人，",
      "token_start": 1712,
      "token_end_exclusive": 1727
    },
    {
      "start_ms": 497030,
      "end_ms": 498855,
      "text": "可他们还不是最壮丽的。",
      "token_start": 1727,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 499230,
      "end_ms": 500850,
      "text": "接下来第五道第一名，",
      "token_start": 1737,
      "token_end_exclusive": 1746
    },
    {
      "start_ms": 501110,
      "end_ms": 502005,
      "text": "一个比一个狠，",
      "token_start": 1746,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 502470,
      "end_ms": 503665,
      "text": "有一处工城，",
      "token_start": 1752,
      "token_end_exclusive": 1757
    },
    {
      "start_ms": 504050,
      "end_ms": 506575,
      "text": "两千两百多年没筑过一道坝，",
      "token_start": 1757,
      "token_end_exclusive": 1769
    },
    {
      "start_ms": 507050,
      "end_ms": 509585,
      "text": "今天还在给几千万人供水，",
      "token_start": 1769,
      "token_end_exclusive": 1780
    },
    {
      "start_ms": 510300,
      "end_ms": 513475,
      "text": "有一座寺庙定在百米的绝壁上，",
      "token_start": 1780,
      "token_end_exclusive": 1793
    },
    {
      "start_ms": 514000,
      "end_ms": 516545,
      "text": "一千五百年没钓过一片吧，",
      "token_start": 1793,
      "token_end_exclusive": 1804
    },
    {
      "start_ms": 516960,
      "end_ms": 517920,
      "text": "可排榜首。",
      "token_start": 1804,
      "token_end_exclusive": 1808
    },
    {
      "start_ms": 517920,
      "end_ms": 521105,
      "text": "那一处是地球自己拉的一道口子，",
      "token_start": 1808,
      "token_end_exclusive": 1822
    },
    {
      "start_ms": 521540,
      "end_ms": 522965,
      "text": "五千米的落差，",
      "token_start": 1822,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 523840,
      "end_ms": 525195,
      "text": "谁站上去都得输。",
      "token_start": 1828,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 525750,
      "end_ms": 526475,
      "text": "他是哪里？",
      "token_start": 1835,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 527160,
      "end_ms": 529115,
      "text": "他凭什么排在兵马俑前面，",
      "token_start": 1839,
      "token_end_exclusive": 1850
    },
    {
      "start_ms": 529520,
      "end_ms": 531565,
      "text": "下一集已经同步更新，",
      "token_start": 1850,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 531920,
      "end_ms": 533220,
      "text": "点开我的头像，",
      "token_start": 1859,
      "token_end_exclusive": 1865
    },
    {
      "start_ms": 533340,
      "end_ms": 534185,
      "text": "进入主页，",
      "token_start": 1865,
      "token_end_exclusive": 1869
    },
    {
      "start_ms": 534400,
      "end_ms": 536005,
      "text": "就能看到点个关注。",
      "token_start": 1869,
      "token_end_exclusive": 1877
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
