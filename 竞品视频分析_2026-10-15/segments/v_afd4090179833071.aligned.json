{
  "video_id": "v_afd4090179833071",
  "duration_s": 402.866009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_afd4090179833071.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_afd4090179833071.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1190,
      "text": "假如有来生，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1410,
      "end_ms": 2490,
      "text": "我还要搞导弹，",
      "token_start": 5,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2850,
      "end_ms": 7350,
      "text": "这是一个九十五岁老人在病榻上留下的最后一句话。",
      "token_start": 11,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 7810,
      "end_ms": 8610,
      "text": "说完这句话，",
      "token_start": 33,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 8610,
      "end_ms": 10090,
      "text": "没多久他就走了。",
      "token_start": 38,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 10430,
      "end_ms": 12190,
      "text": "你可能没听过他的名字，",
      "token_start": 45,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 12610,
      "end_ms": 16190,
      "text": "但你今天能安安稳稳坐在家里吃饭、睡觉，",
      "token_start": 55,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 16370,
      "end_ms": 17090,
      "text": "刷手机，",
      "token_start": 72,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 17570,
      "end_ms": 18830,
      "text": "不用担惊受怕，",
      "token_start": 75,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 19590,
      "end_ms": 21450,
      "text": "跟这个人有天大的关系。",
      "token_start": 81,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 22270,
      "end_ms": 23370,
      "text": "他叫黄尾鹿，",
      "token_start": 91,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 23430,
      "end_ms": 25230,
      "text": "两弹一星元勋，",
      "token_start": 96,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 25750,
      "end_ms": 30420,
      "text": "中国第一枚潜地导弹巨浪一号总是计天历史，",
      "token_start": 102,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 30940,
      "end_ms": 33040,
      "text": "有人叫他巨浪之父，",
      "token_start": 121,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 33120,
      "end_ms": 35260,
      "text": "也有人叫他东风二十一之父。",
      "token_start": 129,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 35920,
      "end_ms": 38540,
      "text": "但这些头衔他活着的时候，",
      "token_start": 141,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 38880,
      "end_ms": 40040,
      "text": "几乎没人知道，",
      "token_start": 152,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 40820,
      "end_ms": 43700,
      "text": "故事得从一九四三年的伦敦说起。",
      "token_start": 158,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 44240,
      "end_ms": 44840,
      "text": "那一年，",
      "token_start": 172,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 45100,
      "end_ms": 49380,
      "text": "二十七岁的黄纬路在英国一家无线电工厂实习。",
      "token_start": 175,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 49980,
      "end_ms": 50760,
      "text": "那天早上，",
      "token_start": 195,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 50940,
      "end_ms": 53440,
      "text": "他像往常一样往工厂走，",
      "token_start": 199,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 53680,
      "end_ms": 59795,
      "text": "因为是实习生公司规定他可以比正式员工晚到半个小时，",
      "token_start": 209,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 60400,
      "end_ms": 62735,
      "text": "就这半个小时救了他一条命。",
      "token_start": 233,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 63310,
      "end_ms": 64790,
      "text": "等他走到工厂门口，",
      "token_start": 245,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 65090,
      "end_ms": 66385,
      "text": "整个人都傻了。",
      "token_start": 253,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 66590,
      "end_ms": 68010,
      "text": "昨天还好好的，",
      "token_start": 259,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 68010,
      "end_ms": 71620,
      "text": "车间被完全炸毁一枚德国导弹，",
      "token_start": 265,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 71680,
      "end_ms": 74525,
      "text": "就落在他办公室外面几米远的地方，",
      "token_start": 278,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 74790,
      "end_ms": 79185,
      "text": "五位朝夕相处的英国同事不幸全部遇难。",
      "token_start": 293,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 79710,
      "end_ms": 82885,
      "text": "那个他每天坐的位置已经荡然无存，",
      "token_start": 310,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 83510,
      "end_ms": 85155,
      "text": "他站在废墟前面，",
      "token_start": 325,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 85470,
      "end_ms": 86355,
      "text": "浑身发抖，",
      "token_start": 332,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 86670,
      "end_ms": 87525,
      "text": "不是害怕，",
      "token_start": 336,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 87820,
      "end_ms": 89375,
      "text": "是一种说不出来的痛。",
      "token_start": 340,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 90190,
      "end_ms": 90665,
      "text": "他想，",
      "token_start": 349,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 91140,
      "end_ms": 93805,
      "text": "如果我的祖国也有这样的武器，",
      "token_start": 351,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 94300,
      "end_ms": 95605,
      "text": "谁敢来欺负我们？",
      "token_start": 364,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 96080,
      "end_ms": 97595,
      "text": "如果中国没有导弹，",
      "token_start": 371,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 97850,
      "end_ms": 100630,
      "text": "老百姓的命就跟这五个同事一样，",
      "token_start": 379,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 100650,
      "end_ms": 101685,
      "text": "说没就没了。",
      "token_start": 393,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 102040,
      "end_ms": 103005,
      "text": "从那天起，",
      "token_start": 398,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 103400,
      "end_ms": 106165,
      "text": "这个年轻人心里埋下了一颗种子，",
      "token_start": 402,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 106810,
      "end_ms": 109015,
      "text": "中国必须有自己的导弹。",
      "token_start": 416,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 109870,
      "end_ms": 110310,
      "text": "后来，",
      "token_start": 426,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 110590,
      "end_ms": 115250,
      "text": "英国博物馆把一枚缴获的德国v突导弹解剖了，",
      "token_start": 428,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 115250,
      "end_ms": 125015,
      "text": "展出黄纬路挤在人群里围着这个十几米长的大家伙一圈一圈的看看了一遍又一遍。",
      "token_start": 448,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 125480,
      "end_ms": 126715,
      "text": "别人看个新鲜，",
      "token_start": 483,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 127050,
      "end_ms": 128750,
      "text": "他看的是怎么造出来的，",
      "token_start": 489,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 128990,
      "end_ms": 130505,
      "text": "他心里只有一个念头，",
      "token_start": 499,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 131330,
      "end_ms": 135015,
      "text": "这东西中国必须也得有。",
      "token_start": 508,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 136770,
      "end_ms": 137830,
      "text": "一九四七年，",
      "token_start": 518,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 137910,
      "end_ms": 141725,
      "text": "黄伟禄拿到了伦敦大学帝国学院的硕士学位。",
      "token_start": 523,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 142130,
      "end_ms": 146705,
      "text": "英国好几家公司抢着要他开的薪水高的吓人，",
      "token_start": 542,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 147450,
      "end_ms": 149710,
      "text": "他想都没想全拒了。",
      "token_start": 561,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 149850,
      "end_ms": 152515,
      "text": "收拾行李回了国有人说他傻，",
      "token_start": 569,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 152760,
      "end_ms": 153445,
      "text": "他才不傻，",
      "token_start": 581,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 154110,
      "end_ms": 155625,
      "text": "他心里装着那片废墟，",
      "token_start": 585,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 155950,
      "end_ms": 158035,
      "text": "装着那五位再也回不来的同事。",
      "token_start": 594,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 158590,
      "end_ms": 159330,
      "text": "回国之后，",
      "token_start": 607,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 159530,
      "end_ms": 161295,
      "text": "他等了整整九年。",
      "token_start": 611,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 163110,
      "end_ms": 164495,
      "text": "一九五六年春天，",
      "token_start": 618,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 165030,
      "end_ms": 166695,
      "text": "中南海怀仁堂内，",
      "token_start": 625,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 167050,
      "end_ms": 173235,
      "text": "黄纬路坐在台下听刚刚回国的钱学森讲火箭技术。",
      "token_start": 632,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 174010,
      "end_ms": 175430,
      "text": "钱学森说了一句话，",
      "token_start": 653,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 175450,
      "end_ms": 178965,
      "text": "他记了一辈子外国人能搞出来的东西，",
      "token_start": 661,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 179420,
      "end_ms": 181285,
      "text": "我们中国人也一定能搞出来。",
      "token_start": 677,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 182380,
      "end_ms": 183475,
      "text": "报告会结束，",
      "token_start": 689,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 184230,
      "end_ms": 186145,
      "text": "黄纬路热血沸腾。",
      "token_start": 694,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 186540,
      "end_ms": 187385,
      "text": "没过多久，",
      "token_start": 701,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 187760,
      "end_ms": 191325,
      "text": "他就被抽调到了刚刚成立的导弹研制机构，",
      "token_start": 705,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 191780,
      "end_ms": 192355,
      "text": "从此，",
      "token_start": 723,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 192790,
      "end_ms": 196645,
      "text": "这个人从公众视野里彻底消失了。",
      "token_start": 725,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 197530,
      "end_ms": 198565,
      "text": "尚不告父母，",
      "token_start": 739,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 198930,
      "end_ms": 199795,
      "text": "下不告妻儿，",
      "token_start": 744,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 200640,
      "end_ms": 204145,
      "text": "家里人只知道他在搞科研搞什么，",
      "token_start": 749,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 205120,
      "end_ms": 207665,
      "text": "不能说去哪儿了，",
      "token_start": 763,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 208130,
      "end_ms": 209945,
      "text": "不能说什么时候回来，",
      "token_start": 770,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 210750,
      "end_ms": 213210,
      "text": "更不能说当时的条件有多苦。",
      "token_start": 779,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 213490,
      "end_ms": 214925,
      "text": "说出来你可能不信。",
      "token_start": 791,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 215240,
      "end_ms": 218725,
      "text": "研究院在北京永定路用的是旧校舍，",
      "token_start": 799,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 219030,
      "end_ms": 220415,
      "text": "周围全是荒地，",
      "token_start": 814,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 220770,
      "end_ms": 221510,
      "text": "没有资料，",
      "token_start": 820,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 221770,
      "end_ms": 222725,
      "text": "没有图纸，",
      "token_start": 824,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 223060,
      "end_ms": 223915,
      "text": "没有样品，",
      "token_start": 828,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 224250,
      "end_ms": 226485,
      "text": "连一台像样的计算器都没有。",
      "token_start": 832,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 226970,
      "end_ms": 236055,
      "text": "整个团队就靠手摇计算器计算尺一笔一笔的算草稿纸堆了满满一屋子。",
      "token_start": 844,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 236470,
      "end_ms": 238165,
      "text": "聂荣臻元帅说了一句话，",
      "token_start": 874,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 239720,
      "end_ms": 241075,
      "text": "我们要搞蒸汽弹，",
      "token_start": 884,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 241490,
      "end_ms": 243215,
      "text": "为中国人民争气。",
      "token_start": 891,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 244120,
      "end_ms": 247450,
      "text": "黄伟路负责的是导弹控制系统，",
      "token_start": 898,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 247790,
      "end_ms": 250930,
      "text": "说白了就是导弹的大脑和神经，",
      "token_start": 911,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 251090,
      "end_ms": 252030,
      "text": "飞得稳不稳，",
      "token_start": 924,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 252190,
      "end_ms": 253115,
      "text": "打的准不准。",
      "token_start": 929,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 253400,
      "end_ms": 254245,
      "text": "全看这个。",
      "token_start": 934,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 254800,
      "end_ms": 257700,
      "text": "他带着团队没日没夜的干办公室，",
      "token_start": 938,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 257700,
      "end_ms": 261655,
      "text": "就是家楼里的灯经常亮到天亮。",
      "token_start": 952,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 262340,
      "end_ms": 266205,
      "text": "那几年正好赶上国家最困难的时候，",
      "token_start": 965,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 266570,
      "end_ms": 267475,
      "text": "饭都吃不饱。",
      "token_start": 980,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 268490,
      "end_ms": 270945,
      "text": "黄伟禄本来就有魏溃疡的老毛病，",
      "token_start": 985,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 271290,
      "end_ms": 272435,
      "text": "一饿就疼，",
      "token_start": 999,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 272800,
      "end_ms": 274425,
      "text": "一疼就是几个小时，",
      "token_start": 1003,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 275240,
      "end_ms": 278995,
      "text": "他不去医院也不跟人说疼的实在扛不住了，",
      "token_start": 1011,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 279340,
      "end_ms": 281420,
      "text": "就用手死死抵住胸口，",
      "token_start": 1029,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 281700,
      "end_ms": 283290,
      "text": "接着算接着干。",
      "token_start": 1038,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 283390,
      "end_ms": 285290,
      "text": "后来他女儿收拾衣服的时候，",
      "token_start": 1044,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 285450,
      "end_ms": 287305,
      "text": "发现一件贴身背心，",
      "token_start": 1056,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 287710,
      "end_ms": 290455,
      "text": "胸口位置磨出了一个大洞。",
      "token_start": 1064,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 290860,
      "end_ms": 292155,
      "text": "女儿问他怎么回事，",
      "token_start": 1075,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 292810,
      "end_ms": 294685,
      "text": "他轻描淡写的说了一句，",
      "token_start": 1083,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 295040,
      "end_ms": 297545,
      "text": "疼的时候抵一抵磨的。",
      "token_start": 1093,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 298200,
      "end_ms": 302710,
      "text": "你想想一件厚棉布背心得用多大的劲，",
      "token_start": 1102,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 302890,
      "end_ms": 305715,
      "text": "抵多长时间才能磨出一个洞，",
      "token_start": 1118,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 306130,
      "end_ms": 308625,
      "text": "那不是磨的那是拿命在扛啊。",
      "token_start": 1130,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 309090,
      "end_ms": 310790,
      "text": "就是在这样的条件下，",
      "token_start": 1142,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 311390,
      "end_ms": 313730,
      "text": "奇迹一个接一个的来了。",
      "token_start": 1151,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 314690,
      "end_ms": 316410,
      "text": "一九六零年十一月，",
      "token_start": 1161,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 316630,
      "end_ms": 318750,
      "text": "东风一号发射成功，",
      "token_start": 1169,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 318830,
      "end_ms": 321010,
      "text": "中国有了自己的第一枚导弹。",
      "token_start": 1177,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 321370,
      "end_ms": 322810,
      "text": "一九六四年六月，",
      "token_start": 1189,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 323030,
      "end_ms": 324530,
      "text": "东风二号发射成功，",
      "token_start": 1196,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 325010,
      "end_ms": 328035,
      "text": "中国人自己设计的导弹飞上了天。",
      "token_start": 1204,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 330470,
      "end_ms": 331910,
      "text": "一九六六年十月，",
      "token_start": 1218,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 332370,
      "end_ms": 335330,
      "text": "导弹带的特殊弹头精准命中目标，",
      "token_start": 1225,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 335750,
      "end_ms": 336790,
      "text": "两弹结合，",
      "token_start": 1239,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 336790,
      "end_ms": 338250,
      "text": "试验圆满成功。",
      "token_start": 1243,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 339230,
      "end_ms": 344490,
      "text": "中国终于有了真正的战略威慑能力，",
      "token_start": 1249,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 345650,
      "end_ms": 348430,
      "text": "从一无所有到两弹结合，",
      "token_start": 1264,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 349030,
      "end_ms": 350530,
      "text": "他们只用了十年，",
      "token_start": 1274,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 351530,
      "end_ms": 353470,
      "text": "外国人搞了几十年的路，",
      "token_start": 1281,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 354250,
      "end_ms": 356450,
      "text": "中国人十年就走完了，",
      "token_start": 1291,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 357310,
      "end_ms": 359810,
      "text": "可黄尾路还没来得及喘口气。",
      "token_start": 1300,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 359890,
      "end_ms": 364520,
      "text": "一个更难更险、更要命的任务落到了他的肩上。",
      "token_start": 1312,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 365280,
      "end_ms": 365900,
      "text": "那一年，",
      "token_start": 1331,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 366320,
      "end_ms": 372485,
      "text": "他五十四岁这个任务就是把导弹藏到海里，",
      "token_start": 1334,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 373860,
      "end_ms": 379425,
      "text": "从潜艇上发射一个五十四岁的老人能不能扛得住，",
      "token_start": 1352,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 379780,
      "end_ms": 381765,
      "text": "他又会付出怎样的代价？",
      "token_start": 1373,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 382550,
      "end_ms": 383285,
      "text": "讲到这儿，",
      "token_start": 1383,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 383680,
      "end_ms": 387685,
      "text": "如果你也被黄纬禄老人的故事触动了麻烦点个赞，",
      "token_start": 1387,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 388190,
      "end_ms": 389885,
      "text": "把这条视频收藏起来。",
      "token_start": 1408,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 390270,
      "end_ms": 392615,
      "text": "再转发给身边的朋友，",
      "token_start": 1417,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 393060,
      "end_ms": 397360,
      "text": "让更多人知道这位隐姓埋名一辈子的护国英雄。",
      "token_start": 1426,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 397520,
      "end_ms": 399315,
      "text": "评论区留下一句黄老，",
      "token_start": 1446,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 399620,
      "end_ms": 400225,
      "text": "辛苦了。",
      "token_start": 1455,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 400560,
      "end_ms": 401125,
      "text": "关注我，",
      "token_start": 1458,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 401460,
      "end_ms": 402735,
      "text": "下集更精彩。",
      "token_start": 1461,
      "token_end_exclusive": 1466
    }
  ],
