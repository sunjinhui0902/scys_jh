{
  "video_id": "v_0225e71719275a3e",
  "duration_s": 337.241379,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_0225e71719275a3e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_0225e71719275a3e.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 930,
      "text": "你敢信吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 2010,
      "end_ms": 5510,
      "text": "一个堂堂清华大学的校长住院的时候，",
      "token_start": 4,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5510,
      "end_ms": 6610,
      "text": "连药都吃不起，",
      "token_start": 20,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7410,
      "end_ms": 8310,
      "text": "去世之后，",
      "token_start": 26,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 8310,
      "end_ms": 9850,
      "text": "连入土的钱都没有。",
      "token_start": 30,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 10170,
      "end_ms": 11550,
      "text": "最后是学生们，",
      "token_start": 38,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 11550,
      "end_ms": 13090,
      "text": "你一块我一块凑的钱，",
      "token_start": 44,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13590,
      "end_ms": 15410,
      "text": "才让他入土为安。",
      "token_start": 53,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 16370,
      "end_ms": 17570,
      "text": "这个人叫梅玉奇，",
      "token_start": 60,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 18550,
      "end_ms": 24030,
      "text": "清华历史上任期最长的校长干了整整十七年。",
      "token_start": 67,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 25130,
      "end_ms": 26190,
      "text": "先说一件事，",
      "token_start": 86,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 27210,
      "end_ms": 31980,
      "text": "这一天本该他上课铃都响了，",
      "token_start": 91,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 32340,
      "end_ms": 33180,
      "text": "人还没到。",
      "token_start": 103,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 34300,
      "end_ms": 35700,
      "text": "学生们正纳闷呢，",
      "token_start": 107,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 35860,
      "end_ms": 38020,
      "text": "教士们猛的推开梅，",
      "token_start": 114,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 38020,
      "end_ms": 39400,
      "text": "一齐气喘吁吁，",
      "token_start": 122,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 39480,
      "end_ms": 40120,
      "text": "跑进来，",
      "token_start": 128,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 40440,
      "end_ms": 41500,
      "text": "满头大汗。",
      "token_start": 131,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 41660,
      "end_ms": 43060,
      "text": "长袍上还沾着灰。",
      "token_start": 135,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 43540,
      "end_ms": 44620,
      "text": "他一边擦汗，",
      "token_start": 142,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 44660,
      "end_ms": 45780,
      "text": "一边笑说，",
      "token_start": 147,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 45780,
      "end_ms": 46600,
      "text": "对不住各位，",
      "token_start": 151,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 46920,
      "end_ms": 50440,
      "text": "我刚才在街上替我内人看糕点摊呢，",
      "token_start": 156,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 51200,
      "end_ms": 52300,
      "text": "他去进货了，",
      "token_start": 171,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 52480,
      "end_ms": 53860,
      "text": "七点半还没回来，",
      "token_start": 176,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 54220,
      "end_ms": 54880,
      "text": "我有课，",
      "token_start": 183,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 55120,
      "end_ms": 57400,
      "text": "只好把摊子一丢就跑来了。",
      "token_start": 186,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 58060,
      "end_ms": 59500,
      "text": "不过今天生意不错，",
      "token_start": 197,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 59600,
      "end_ms": 61065,
      "text": "点心卖的特别好。",
      "token_start": 205,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 61720,
      "end_ms": 64820,
      "text": "说完他自己还笑底下的学生呢，",
      "token_start": 212,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 64920,
      "end_ms": 67300,
      "text": "一个个眼泪止不住的往下掉。",
      "token_start": 225,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 67800,
      "end_ms": 70920,
      "text": "一个名牌大学的校长放了学不回家，",
      "token_start": 237,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 70920,
      "end_ms": 75130,
      "text": "歇着跟夫人一块儿站大街上摆摊卖点心。",
      "token_start": 252,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 75330,
      "end_ms": 77055,
      "text": "他夫人叫韩永华，",
      "token_start": 269,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 77830,
      "end_ms": 78910,
      "text": "做的这种米糕，",
      "token_start": 276,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 79050,
      "end_ms": 81475,
      "text": "有个名字叫定胜糕，",
      "token_start": 282,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 82170,
      "end_ms": 85115,
      "text": "取的是抗战一定胜利的意思。",
      "token_start": 290,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 85950,
      "end_ms": 88270,
      "text": "为了不让人认出自己是校长，",
      "token_start": 302,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 88330,
      "end_ms": 88805,
      "text": "夫人，",
      "token_start": 314,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 89370,
      "end_ms": 92710,
      "text": "他特意穿上佣人才穿的蓝布褂子，",
      "token_start": 316,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 93070,
      "end_ms": 95265,
      "text": "挎着篮子步行一个多钟头，",
      "token_start": 330,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 95690,
      "end_ms": 98655,
      "text": "跑到老远的冠生园食品店去寄卖，",
      "token_start": 341,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 99280,
      "end_ms": 100515,
      "text": "舍不得穿袜子，",
      "token_start": 355,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 100810,
      "end_ms": 102195,
      "text": "光着脚穿皮鞋，",
      "token_start": 361,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 102570,
      "end_ms": 104365,
      "text": "脚磨破了肿的老高。",
      "token_start": 367,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 104720,
      "end_ms": 106880,
      "text": "咬着牙还去有人问他，",
      "token_start": 375,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 106880,
      "end_ms": 107755,
      "text": "你图什么？",
      "token_start": 384,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 108690,
      "end_ms": 109265,
      "text": "他说，",
      "token_start": 388,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 110090,
      "end_ms": 111215,
      "text": "孩子们要读书，",
      "token_start": 390,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 112040,
      "end_ms": 112900,
      "text": "家里要吃饭，",
      "token_start": 396,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 112980,
      "end_ms": 114600,
      "text": "校长那点薪水不够用，",
      "token_start": 401,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 114820,
      "end_ms": 116165,
      "text": "不够用到什么程度？",
      "token_start": 410,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 116540,
      "end_ms": 117895,
      "text": "我给你说几个细节，",
      "token_start": 418,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 118390,
      "end_ms": 122040,
      "text": "他儿子在昆明跑警报就是躲空袭，",
      "token_start": 426,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 122460,
      "end_ms": 123705,
      "text": "把眼镜跑丢了，",
      "token_start": 440,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 123910,
      "end_ms": 127440,
      "text": "居然没钱再配一副一个校长的儿子，",
      "token_start": 446,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 127740,
      "end_ms": 129495,
      "text": "连副眼镜都配不起。",
      "token_start": 461,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 129880,
      "end_ms": 132380,
      "text": "有学生亲眼看见梅一齐，",
      "token_start": 469,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 132400,
      "end_ms": 135435,
      "text": "有时候拿包衣服去典当行换钱应急。",
      "token_start": 479,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 136160,
      "end_ms": 137060,
      "text": "一九四一年，",
      "token_start": 494,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 137060,
      "end_ms": 140405,
      "text": "他去成都出差回来的飞机票都买好了。",
      "token_start": 499,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 140790,
      "end_ms": 142665,
      "text": "听说能搭邮政汽车，",
      "token_start": 515,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 143330,
      "end_ms": 144710,
      "text": "虽然要多走一天，",
      "token_start": 523,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 144790,
      "end_ms": 146705,
      "text": "路上还可能遭遇空袭，",
      "token_start": 530,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 147240,
      "end_ms": 149265,
      "text": "但能给学校省二百多块钱。",
      "token_start": 539,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 149910,
      "end_ms": 150710,
      "text": "他二话不说，",
      "token_start": 550,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 150710,
      "end_ms": 152950,
      "text": "把飞机票退了改坐油车，",
      "token_start": 555,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 153230,
      "end_ms": 154130,
      "text": "一路颠簸，",
      "token_start": 565,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 154170,
      "end_ms": 155825,
      "text": "灰头土脸的赶回来，",
      "token_start": 569,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 156300,
      "end_ms": 156720,
      "text": "开会，",
      "token_start": 577,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 156800,
      "end_ms": 158125,
      "text": "迟到了二十分钟，",
      "token_start": 579,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 158750,
      "end_ms": 159130,
      "text": "进门。",
      "token_start": 586,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 159130,
      "end_ms": 160270,
      "text": "第一句话就是，",
      "token_start": 588,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 160270,
      "end_ms": 160815,
      "text": "对不起，",
      "token_start": 594,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 161430,
      "end_ms": 162265,
      "text": "我来晚了，",
      "token_start": 597,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 162530,
      "end_ms": 163355,
      "text": "他当校长，",
      "token_start": 601,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 163780,
      "end_ms": 166225,
      "text": "把自己该享受的待遇全砍了。",
      "token_start": 605,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 166760,
      "end_ms": 168735,
      "text": "校长免费用的电话，",
      "token_start": 617,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 169090,
      "end_ms": 170705,
      "text": "免费供应的米面，",
      "token_start": 625,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 171280,
      "end_ms": 174420,
      "text": "冬天免费拉的燃煤通通取消，",
      "token_start": 632,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 174840,
      "end_ms": 176540,
      "text": "省下来的钱干什么？",
      "token_start": 644,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 176780,
      "end_ms": 178100,
      "text": "全贴给教授了，",
      "token_start": 652,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 178100,
      "end_ms": 180375,
      "text": "他说要留住好老师，",
      "token_start": 658,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 180730,
      "end_ms": 182325,
      "text": "不能光靠情怀。",
      "token_start": 666,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 183070,
      "end_ms": 185585,
      "text": "可就是这么一个穷的叮当响的人，",
      "token_start": 672,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 185970,
      "end_ms": 187070,
      "text": "手里管着的钱，",
      "token_start": 686,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 187290,
      "end_ms": 188715,
      "text": "说出来能吓你一跳。",
      "token_start": 692,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 189590,
      "end_ms": 191130,
      "text": "清华有一笔耕子赔款，",
      "token_start": 700,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 191130,
      "end_ms": 192975,
      "text": "基金数目巨大，",
      "token_start": 709,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 193840,
      "end_ms": 200235,
      "text": "多少大人物都惦记着这笔钱从梅一其手上过了十几年，",
      "token_start": 715,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 201080,
      "end_ms": 206580,
      "text": "他到哪都带着一个旧皮包形影不离睡觉，",
      "token_start": 738,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 206600,
      "end_ms": 208390,
      "text": "放床头住院，",
      "token_start": 755,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 208610,
      "end_ms": 209630,
      "text": "放床底下，",
      "token_start": 760,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 209850,
      "end_ms": 210845,
      "text": "谁也不让碰。",
      "token_start": 764,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 211400,
      "end_ms": 214940,
      "text": "所有人都猜这里面肯定装着什么贵重东西，",
      "token_start": 769,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 215000,
      "end_ms": 216055,
      "text": "要么是银票，",
      "token_start": 787,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 216390,
      "end_ms": 217965,
      "text": "要么是贵重财物，",
      "token_start": 792,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 218680,
      "end_ms": 220785,
      "text": "至少也得是重要文件吧。",
      "token_start": 799,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 221760,
      "end_ms": 223395,
      "text": "你再看他办事的原则，",
      "token_start": 809,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 224100,
      "end_ms": 225565,
      "text": "就知道这个人有多硬。",
      "token_start": 818,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 226700,
      "end_ms": 230525,
      "text": "当年云南省主席龙云在云南说一不二，",
      "token_start": 827,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 230950,
      "end_ms": 232825,
      "text": "西南联大在昆明办学，",
      "token_start": 843,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 233290,
      "end_ms": 234790,
      "text": "人家龙云要钱，",
      "token_start": 852,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 234790,
      "end_ms": 235940,
      "text": "给钱要力，",
      "token_start": 858,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 235940,
      "end_ms": 236405,
      "text": "出力，",
      "token_start": 862,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 236880,
      "end_ms": 238385,
      "text": "是联大的大恩人。",
      "token_start": 864,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 238860,
      "end_ms": 242315,
      "text": "可龙云的女儿考联大附中落榜了，",
      "token_start": 871,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 242750,
      "end_ms": 244305,
      "text": "龙云脸上挂不住，",
      "token_start": 885,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 244710,
      "end_ms": 248700,
      "text": "派秘书长去找梅伊齐书童秘书长去了半天，",
      "token_start": 892,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 248980,
      "end_ms": 250095,
      "text": "回来跟龙云说，",
      "token_start": 910,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 250680,
      "end_ms": 251100,
      "text": "主席，",
      "token_start": 916,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 251160,
      "end_ms": 255460,
      "text": "我打听了梅校长自己的女儿。",
      "token_start": 918,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 255460,
      "end_ms": 259185,
      "text": "梅祖芬考清华也差了两分，",
      "token_start": 930,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 259590,
      "end_ms": 260255,
      "text": "没录取，",
      "token_start": 941,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 260780,
      "end_ms": 262965,
      "text": "人家亲闺女都没走后门，",
      "token_start": 944,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 265050,
      "end_ms": 267635,
      "text": "龙云听完半天没说出话来，",
      "token_start": 954,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 268010,
      "end_ms": 269555,
      "text": "从此再也不提这事儿了。",
      "token_start": 965,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 271580,
      "end_ms": 273930,
      "text": "梅祖峰回家哭说，",
      "token_start": 975,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 273930,
      "end_ms": 274175,
      "text": "爸，",
      "token_start": 982,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 275050,
      "end_ms": 276065,
      "text": "我就差两分，",
      "token_start": 983,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 277120,
      "end_ms": 278635,
      "text": "你就不能说句话吗？",
      "token_start": 988,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 278970,
      "end_ms": 279090,
      "text": "嗯，",
      "token_start": 996,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 279090,
      "end_ms": 283475,
      "text": "有没一起看着女儿沉默了很久，",
      "token_start": 997,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 285460,
      "end_ms": 286605,
      "text": "一个字都没说，",
      "token_start": 1010,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 287080,
      "end_ms": 288420,
      "text": "那是他亲闺女啊，",
      "token_start": 1016,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 288500,
      "end_ms": 289545,
      "text": "一句话的事儿，",
      "token_start": 1023,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 289730,
      "end_ms": 291010,
      "text": "他就是不开这个口。",
      "token_start": 1029,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 291270,
      "end_ms": 294480,
      "text": "你说这样一个人手里握着千万巨款，",
      "token_start": 1037,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 294600,
      "end_ms": 296085,
      "text": "自己穷到摆地摊，",
      "token_start": 1052,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 296470,
      "end_ms": 297590,
      "text": "女儿差两分，",
      "token_start": 1059,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 297610,
      "end_ms": 298655,
      "text": "不肯通融。",
      "token_start": 1064,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 299100,
      "end_ms": 302830,
      "text": "他那个从不离身的皮包里到底装着什么？",
      "token_start": 1068,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 303110,
      "end_ms": 307055,
      "text": "是钱是账还是什么不为人知的秘密？",
      "token_start": 1085,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 307520,
      "end_ms": 309915,
      "text": "这个答案我留到下集告诉你，",
      "token_start": 1100,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 310700,
      "end_ms": 312065,
      "text": "但我可以先透一句。",
      "token_start": 1112,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 313040,
      "end_ms": 313880,
      "text": "一九六二年，",
      "token_start": 1120,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 313880,
      "end_ms": 315675,
      "text": "梅一琦在台北病逝后，",
      "token_start": 1125,
      "token_end_exclusive": 1134
    },
    {
      "start_ms": 316110,
      "end_ms": 318775,
      "text": "这个皮包在众人面前被打开。",
      "token_start": 1134,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 320040,
      "end_ms": 323920,
      "text": "在场的人没有一个不掉眼泪的关注。",
      "token_start": 1146,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 323920,
      "end_ms": 324925,
      "text": "我下集，",
      "token_start": 1161,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 325240,
      "end_ms": 326065,
      "text": "咱们接着讲，",
      "token_start": 1164,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 326540,
      "end_ms": 331645,
      "text": "觉得没校长有骨气的点赞、收藏、评论区说说你的看法，",
      "token_start": 1169,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 332420,
      "end_ms": 334080,
      "text": "再转发给身边的人，",
      "token_start": 1191,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 334080,
      "end_ms": 337200,
      "text": "看看什么叫真正的读书人。",
      "token_start": 1199,
      "token_end_exclusive": 1210
    }
  ],
