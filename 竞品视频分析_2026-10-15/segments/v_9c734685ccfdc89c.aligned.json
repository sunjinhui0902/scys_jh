  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2730,
      "text": "人一定要和见得了自己好的人在一起。",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 2930,
      "end_ms": 5550,
      "text": "主持人朱迅的这番话冲上了热搜，",
      "token_start": 16,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 5930,
      "end_ms": 6330,
      "text": "他说，",
      "token_start": 30,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 6730,
      "end_ms": 7870,
      "text": "和喜欢的人在一起，",
      "token_start": 32,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 7870,
      "end_ms": 8530,
      "text": "是大步，",
      "token_start": 40,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 8770,
      "end_ms": 10090,
      "text": "和快乐的人在一起，",
      "token_start": 43,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 10090,
      "end_ms": 10690,
      "text": "是养生。",
      "token_start": 51,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 11290,
      "end_ms": 13190,
      "text": "和善良的人在一起在一起，",
      "token_start": 54,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 13690,
      "end_ms": 16309,
      "text": "和优雅的人在一起是养德。",
      "token_start": 65,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 17130,
      "end_ms": 19830,
      "text": "我们一定要和有情有义的人在一起，",
      "token_start": 76,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 20030,
      "end_ms": 22110,
      "text": "和见得了你好的人在一起，",
      "token_start": 91,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 22310,
      "end_ms": 23870,
      "text": "和彼此尊重的人在一起，",
      "token_start": 102,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 23870,
      "end_ms": 26130,
      "text": "和心疼你的人在一起，",
      "token_start": 112,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 26130,
      "end_ms": 30760,
      "text": "他们不会在你低谷时转身和不会在你高光的当时失衡。",
      "token_start": 121,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 31580,
      "end_ms": 32900,
      "text": "这份双向的真诚，",
      "token_start": 144,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 33500,
      "end_ms": 38164,
      "text": "才是我们这一生最值得奔赴的关系。",
      "token_start": 151,
      "token_end_exclusive": 166
    }
