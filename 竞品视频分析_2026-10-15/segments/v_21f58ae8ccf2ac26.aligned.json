{
  "video_id": "v_21f58ae8ccf2ac26",
  "duration_s": 361.517241,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_21f58ae8ccf2ac26.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_21f58ae8ccf2ac26.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 6210,
      "text": "上一集说到袁隆平四年心血培育的七百多株秧苗一夜被拔光，",
      "token_start": 0,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6930,
      "end_ms": 10330,
      "text": "他在一口废井里捞出仅存的五株，",
      "token_start": 26,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 10810,
      "end_ms": 11770,
      "text": "擦干眼泪，",
      "token_start": 40,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 11950,
      "end_ms": 12850,
      "text": "从头再来，",
      "token_start": 44,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 13510,
      "end_ms": 14770,
      "text": "你知道从头再来，",
      "token_start": 48,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 14770,
      "end_ms": 15470,
      "text": "有多难吗？",
      "token_start": 55,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15970,
      "end_ms": 17150,
      "text": "为了抢时间，",
      "token_start": 59,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 17390,
      "end_ms": 22370,
      "text": "他带着团队开始了长达十几年的南返北遇。",
      "token_start": 64,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 23030,
      "end_ms": 24270,
      "text": "冬天去海南，",
      "token_start": 82,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 24390,
      "end_ms": 25590,
      "text": "夏天回湖南，",
      "token_start": 87,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25830,
      "end_ms": 26850,
      "text": "追着温度跑，",
      "token_start": 92,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 27290,
      "end_ms": 29310,
      "text": "追着生长季跑一年。",
      "token_start": 97,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 29390,
      "end_ms": 34880,
      "text": "当两年连用坐三十多个小时的绿皮硬座挤在人堆里，",
      "token_start": 105,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 34880,
      "end_ms": 36400,
      "text": "腿肿的脱不下裤子。",
      "token_start": 127,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 36480,
      "end_ms": 37460,
      "text": "饿了肯干磨，",
      "token_start": 135,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 37820,
      "end_ms": 38720,
      "text": "渴了喝凉水，",
      "token_start": 140,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 38980,
      "end_ms": 40640,
      "text": "从来没说过一句苦。",
      "token_start": 145,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 41540,
      "end_ms": 43220,
      "text": "一九七零年十一月，",
      "token_start": 153,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 43400,
      "end_ms": 47820,
      "text": "他的助手李碧湖在海南岛一片沼泽地里，",
      "token_start": 161,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 48600,
      "end_ms": 52660,
      "text": "发现了一株极为罕见的野生雄性捕。",
      "token_start": 178,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 52660,
      "end_ms": 55900,
      "text": "遇到袁隆平给他取名叫野草，",
      "token_start": 193,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 56760,
      "end_ms": 58720,
      "text": "就是这株不起眼的野草，",
      "token_start": 205,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 59440,
      "end_ms": 62915,
      "text": "彻底打开了杂交水稻研究的大门。",
      "token_start": 215,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 63920,
      "end_ms": 64655,
      "text": "三年后，",
      "token_start": 229,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 65270,
      "end_ms": 66325,
      "text": "一九七三年，",
      "token_start": 232,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 66880,
      "end_ms": 68820,
      "text": "袁隆平正式宣布，",
      "token_start": 237,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 68880,
      "end_ms": 72890,
      "text": "中国先行杂交水稻三系配套成功，",
      "token_start": 244,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 73050,
      "end_ms": 74705,
      "text": "整个农业界震惊了。",
      "token_start": 258,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 75780,
      "end_ms": 76280,
      "text": "那一年，",
      "token_start": 266,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 76280,
      "end_ms": 77225,
      "text": "他四十三岁，",
      "token_start": 269,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 78220,
      "end_ms": 82885,
      "text": "一九七六年杂交水稻开始在全国大面积推广，",
      "token_start": 274,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 83750,
      "end_ms": 85255,
      "text": "数据是最狠的语言。",
      "token_start": 293,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 86210,
      "end_ms": 91670,
      "text": "亩产从普通水稻的三百公斤一路突破五百六百字，",
      "token_start": 301,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 92170,
      "end_ms": 95995,
      "text": "后来屡创新高到上世纪末，",
      "token_start": 322,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 96420,
      "end_ms": 99525,
      "text": "中国用不到世界百分之九的耕地，",
      "token_start": 333,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 99980,
      "end_ms": 102765,
      "text": "养活了世界百分之二十二的人口，",
      "token_start": 347,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 103320,
      "end_ms": 106275,
      "text": "这是震撼世界的伟大奇迹。",
      "token_start": 361,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 106880,
      "end_ms": 108825,
      "text": "可当年美国人傲慢的很，",
      "token_start": 372,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 109250,
      "end_ms": 110995,
      "text": "说中国人口太多，",
      "token_start": 382,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 111460,
      "end_ms": 113640,
      "text": "没有哪个国家能解决吃饭问题，",
      "token_start": 389,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 113660,
      "end_ms": 115745,
      "text": "中国人至少一半得饿死。",
      "token_start": 402,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 116130,
      "end_ms": 117825,
      "text": "袁隆平听了没争辩，",
      "token_start": 412,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 118180,
      "end_ms": 119575,
      "text": "一头扎进稻田，",
      "token_start": 420,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 120070,
      "end_ms": 121970,
      "text": "最后稻香飘遍神州，",
      "token_start": 426,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 122450,
      "end_ms": 124595,
      "text": "老外的断言成了笑话。",
      "token_start": 434,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 126760,
      "end_ms": 128080,
      "text": "育种成功之后，",
      "token_start": 443,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 128500,
      "end_ms": 131140,
      "text": "美国一家种子公司开出天价，",
      "token_start": 449,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 131520,
      "end_ms": 134180,
      "text": "想买杂交水稻的技术专利，",
      "token_start": 461,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 134960,
      "end_ms": 136160,
      "text": "袁隆平却拒绝。",
      "token_start": 472,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 137100,
      "end_ms": 137600,
      "text": "他说，",
      "token_start": 478,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 138520,
      "end_ms": 139940,
      "text": "这是中国的技术，",
      "token_start": 480,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 140160,
      "end_ms": 141740,
      "text": "不是我个人的技术，",
      "token_start": 487,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 142020,
      "end_ms": 149740,
      "text": "他反而把技术无偿传授给越南、菲律宾、印度、巴基斯坦等几十个发展中国家。",
      "token_start": 495,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 150060,
      "end_ms": 150940,
      "text": "有人说他傻，",
      "token_start": 526,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 151340,
      "end_ms": 153460,
      "text": "他说饥饿没有国界，",
      "token_start": 531,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 153820,
      "end_ms": 155915,
      "text": "种子没有国籍。",
      "token_start": 539,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 156590,
      "end_ms": 158510,
      "text": "很多人以为功成名就之后，",
      "token_start": 545,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 158510,
      "end_ms": 159590,
      "text": "他该退休了，",
      "token_start": 556,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 160170,
      "end_ms": 164250,
      "text": "结果呢八十岁还在田里插秧九十岁，",
      "token_start": 561,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 164410,
      "end_ms": 165990,
      "text": "还天天看天气预报，",
      "token_start": 576,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 166490,
      "end_ms": 168190,
      "text": "关心稻田长势。",
      "token_start": 584,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 168430,
      "end_ms": 169390,
      "text": "他有两个梦，",
      "token_start": 590,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 170110,
      "end_ms": 171370,
      "text": "全世界都知道，",
      "token_start": 595,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 171530,
      "end_ms": 174650,
      "text": "一个是河下乘凉梦梦见水稻，",
      "token_start": 601,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 174790,
      "end_ms": 176390,
      "text": "长得像高粱一样高，",
      "token_start": 613,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 177050,
      "end_ms": 179030,
      "text": "穗子像扫帚一样大。",
      "token_start": 621,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 179690,
      "end_ms": 182795,
      "text": "他和同事都坐在稻穗下面乘凉，",
      "token_start": 629,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 183330,
      "end_ms": 186315,
      "text": "另一个是杂交水稻覆盖全球梦，",
      "token_start": 642,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 186700,
      "end_ms": 189695,
      "text": "让饥饿从地球上彻底消失。",
      "token_start": 655,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 190450,
      "end_ms": 192750,
      "text": "可你知道他自己过的什么日子吗？",
      "token_start": 666,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 192790,
      "end_ms": 196150,
      "text": "穿十几块钱的衬衫破了补补，",
      "token_start": 680,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 196150,
      "end_ms": 199705,
      "text": "继续穿脚上的皮鞋磨白了还在穿。",
      "token_start": 692,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 200660,
      "end_ms": 203510,
      "text": "记者采访时问他他低头看了看，",
      "token_start": 706,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 203510,
      "end_ms": 203795,
      "text": "说，",
      "token_start": 719,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 204220,
      "end_ms": 205265,
      "text": "能走路就行，",
      "token_start": 720,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 206460,
      "end_ms": 207475,
      "text": "又不找对象。",
      "token_start": 725,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 208040,
      "end_ms": 210165,
      "text": "国家给的上千万奖金，",
      "token_start": 730,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 210670,
      "end_ms": 212030,
      "text": "他全部捐出去，",
      "token_start": 739,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 212030,
      "end_ms": 216540,
      "text": "成立了基金奖励搞农业的年轻的科研。",
      "token_start": 745,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 216540,
      "end_ms": 220555,
      "text": "后辈这辈子没给自己买过一套房，",
      "token_start": 761,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 221300,
      "end_ms": 224005,
      "text": "一直住在单位分的老家属楼里，",
      "token_start": 775,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 224650,
      "end_ms": 226235,
      "text": "他有个雷打不动的习惯，",
      "token_start": 788,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 226630,
      "end_ms": 227835,
      "text": "每天天还没亮，",
      "token_start": 798,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 228290,
      "end_ms": 230520,
      "text": "就打着手电筒去看稻田，",
      "token_start": 804,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 230720,
      "end_ms": 231925,
      "text": "看叶子上的露水，",
      "token_start": 814,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 232270,
      "end_ms": 233270,
      "text": "看稻穗抽出来，",
      "token_start": 821,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 233270,
      "end_ms": 234560,
      "text": "没有他管，",
      "token_start": 827,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 234560,
      "end_ms": 236200,
      "text": "这叫跟道子问。",
      "token_start": 831,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 236220,
      "end_ms": 236685,
      "text": "早安。",
      "token_start": 837,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 237660,
      "end_ms": 239885,
      "text": "二零二一年五月二十二号，",
      "token_start": 839,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 240270,
      "end_ms": 243385,
      "text": "九十一岁的袁隆平在长沙离世了，",
      "token_start": 850,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 244060,
      "end_ms": 245575,
      "text": "就有了开头那一幕，",
      "token_start": 864,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 246700,
      "end_ms": 248795,
      "text": "老百姓自发涌上街头，",
      "token_start": 872,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 249480,
      "end_ms": 250555,
      "text": "捧着菊花，",
      "token_start": 881,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 250980,
      "end_ms": 253705,
      "text": "抱着稻穗送他最后一程。",
      "token_start": 885,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 254690,
      "end_ms": 259745,
      "text": "他研究的杂交水稻迄今累计推广超过八十亿亩，",
      "token_start": 895,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 260340,
      "end_ms": 263145,
      "text": "增产粮食六千多亿公斤。",
      "token_start": 915,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 263870,
      "end_ms": 266785,
      "text": "可他自己的一辈子跟泥土打交道，",
      "token_start": 925,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 267280,
      "end_ms": 271815,
      "text": "一辈子在太阳底下弯腰一辈子没为自己活过一天。",
      "token_start": 939,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 272340,
      "end_ms": 276975,
      "text": "我们这一代人是有史以来最少挨过饿的中国人，",
      "token_start": 960,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 277640,
      "end_ms": 280395,
      "text": "很多人觉得吃饱饭是理所当然的，",
      "token_start": 980,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 281070,
      "end_ms": 283515,
      "text": "可这份理所当然的背后，",
      "token_start": 994,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 284090,
      "end_ms": 287255,
      "text": "站着一个弯腰在稻田里度过了一生的老人。",
      "token_start": 1004,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 287770,
      "end_ms": 289235,
      "text": "下次端起碗的时候，",
      "token_start": 1022,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 289620,
      "end_ms": 293385,
      "text": "记得他记得那粒种子，",
      "token_start": 1030,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 293690,
      "end_ms": 294515,
      "text": "记得那个梦，",
      "token_start": 1039,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 296280,
      "end_ms": 301365,
      "text": "记得那个叫袁隆平的人用一辈子喂饱了一个时代的我们，",
      "token_start": 1044,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 301940,
      "end_ms": 304340,
      "text": "其实元老只是国之脊梁。",
      "token_start": 1068,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 304340,
      "end_ms": 305120,
      "text": "这本书里，",
      "token_start": 1078,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 305120,
      "end_ms": 308425,
      "text": "四十位科学家中的一位书里还有很多人。",
      "token_start": 1082,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 308890,
      "end_ms": 309370,
      "text": "名字，",
      "token_start": 1099,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 309370,
      "end_ms": 311010,
      "text": "你可能头一回听说，",
      "token_start": 1101,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 311510,
      "end_ms": 314610,
      "text": "有人隐姓埋名几十年搞原子弹，",
      "token_start": 1109,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 315090,
      "end_ms": 317350,
      "text": "有人在废井里捞秧苗。",
      "token_start": 1122,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 317830,
      "end_ms": 320890,
      "text": "有人把国家讲的房子改成实验室，",
      "token_start": 1131,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 321470,
      "end_ms": 324630,
      "text": "他们干的是惊天动地过的日子。",
      "token_start": 1145,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 324630,
      "end_ms": 329450,
      "text": "普普通通这本书不是什么高高在上的名人传记，",
      "token_start": 1158,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 329910,
      "end_ms": 331590,
      "text": "是四十个普通人。",
      "token_start": 1178,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 332270,
      "end_ms": 334170,
      "text": "用一辈子告诉你一件事，",
      "token_start": 1185,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 334690,
      "end_ms": 335790,
      "text": "人这一辈子，",
      "token_start": 1195,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 335970,
      "end_ms": 337350,
      "text": "该为什么活着。",
      "token_start": 1200,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 337950,
      "end_ms": 338700,
      "text": "家里有孩子，",
      "token_start": 1206,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 338760,
      "end_ms": 340360,
      "text": "孩子的让他也读一读。",
      "token_start": 1211,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 340760,
      "end_ms": 342740,
      "text": "如果你也被元老感动了，",
      "token_start": 1220,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 342740,
      "end_ms": 344360,
      "text": "点个关注点个赞，",
      "token_start": 1230,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 344800,
      "end_ms": 347300,
      "text": "收藏起来转发给身边的人，",
      "token_start": 1237,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 348140,
      "end_ms": 351540,
      "text": "想把这四十个故事带回家的点击下方链接，",
      "token_start": 1248,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 351740,
      "end_ms": 353460,
      "text": "就是这本国之脊梁。",
      "token_start": 1266,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 354820,
      "end_ms": 356980,
      "text": "评论区留下一句元老，",
      "token_start": 1274,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 358760,
      "end_ms": 359680,
      "text": "一路走好，",
      "token_start": 1283,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 360160,
      "end_ms": 361450,
      "text": "算给老人家回个礼。",
      "token_start": 1287,
      "token_end_exclusive": 1295
    }
  ],
