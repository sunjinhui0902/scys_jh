{
  "video_id": "v_54305777bc2e5896",
  "duration_s": 410.738005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_54305777bc2e5896.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_54305777bc2e5896.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 870,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1150,
      "end_ms": 3030,
      "text": "咱们国家现存的古塔，",
      "token_start": 4,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3810,
      "end_ms": 6330,
      "text": "有名有姓的不下两千座，",
      "token_start": 13,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 6650,
      "end_ms": 9730,
      "text": "可要问哪一座最不可思议？",
      "token_start": 23,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 10570,
      "end_ms": 12130,
      "text": "那争议可就大了。",
      "token_start": 34,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 13570,
      "end_ms": 15430,
      "text": "有人说是硬线木塔，",
      "token_start": 41,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 15890,
      "end_ms": 16910,
      "text": "全木头搭的，",
      "token_start": 49,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 16930,
      "end_ms": 19370,
      "text": "每一根钉挨了二百多发炮弹，",
      "token_start": 54,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 19530,
      "end_ms": 20990,
      "text": "扛了四十多发地震。",
      "token_start": 66,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 21230,
      "end_ms": 23070,
      "text": "有人说是大理三塔，",
      "token_start": 74,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 23310,
      "end_ms": 24390,
      "text": "一千多年，",
      "token_start": 82,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 24690,
      "end_ms": 25650,
      "text": "镇住水患，",
      "token_start": 86,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 25830,
      "end_ms": 28130,
      "text": "屹立不倒错。",
      "token_start": 90,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 28650,
      "end_ms": 29870,
      "text": "真要论起邪乎，",
      "token_start": 95,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 29870,
      "end_ms": 31520,
      "text": "桥进应县木塔，",
      "token_start": 101,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 31520,
      "end_ms": 33160,
      "text": "连前三都进不去。",
      "token_start": 107,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 33720,
      "end_ms": 39260,
      "text": "今天咱们就来盘点中国最不可思议的十座古塔。",
      "token_start": 114,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 39440,
      "end_ms": 41300,
      "text": "先讲第十到第六，",
      "token_start": 134,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 41600,
      "end_ms": 42560,
      "text": "一个比一个悬。",
      "token_start": 141,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 43240,
      "end_ms": 43940,
      "text": "老规矩，",
      "token_start": 147,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 44220,
      "end_ms": 45080,
      "text": "开讲之前，",
      "token_start": 150,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 45440,
      "end_ms": 47460,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 154,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 47720,
      "end_ms": 50640,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 164,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 51100,
      "end_ms": 52720,
      "text": "江苏苏州虎丘塔，",
      "token_start": 176,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 53100,
      "end_ms": 55000,
      "text": "鉴于五代后周，",
      "token_start": 183,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 55380,
      "end_ms": 57040,
      "text": "公元九百五十九年，",
      "token_start": 189,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 57400,
      "end_ms": 61525,
      "text": "比意大利的比萨斜塔还早了两百多年。",
      "token_start": 197,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 62360,
      "end_ms": 65835,
      "text": "这塔最绝的地方就一个字，",
      "token_start": 213,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 66180,
      "end_ms": 69585,
      "text": "鞋从明朝开始，",
      "token_start": 224,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 70050,
      "end_ms": 72045,
      "text": "塔身就往西北倾斜，",
      "token_start": 230,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 72620,
      "end_ms": 74225,
      "text": "现在塔尖偏离中心，",
      "token_start": 238,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 74730,
      "end_ms": 75790,
      "text": "两米三十四，",
      "token_start": 246,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 76110,
      "end_ms": 78025,
      "text": "倾斜度将近三度，",
      "token_start": 251,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 78510,
      "end_ms": 80570,
      "text": "人称中国的比萨斜塔。",
      "token_start": 258,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 80690,
      "end_ms": 81810,
      "text": "您可能要问了，",
      "token_start": 267,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 81930,
      "end_ms": 84440,
      "text": "斜了怎么不倒明朝？",
      "token_start": 273,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 84480,
      "end_ms": 85325,
      "text": "崇祯年间，",
      "token_start": 281,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 85690,
      "end_ms": 87645,
      "text": "工匠发现他歪了，",
      "token_start": 285,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 88370,
      "end_ms": 91535,
      "text": "修第七层的时候故意往反方向砌，",
      "token_start": 292,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 92210,
      "end_ms": 93665,
      "text": "想把重心掰回来，",
      "token_start": 306,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 94780,
      "end_ms": 95845,
      "text": "结果掰过头了，",
      "token_start": 313,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 96240,
      "end_ms": 97980,
      "text": "整座塔变成了香蕉，",
      "token_start": 319,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 98040,
      "end_ms": 99800,
      "text": "形歪上加歪，",
      "token_start": 327,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 100000,
      "end_ms": 102965,
      "text": "反倒站稳了一千多年了。",
      "token_start": 332,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 103240,
      "end_ms": 104480,
      "text": "台风也吹过，",
      "token_start": 342,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 104680,
      "end_ms": 106025,
      "text": "地震也晃过，",
      "token_start": 347,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 106360,
      "end_ms": 108020,
      "text": "他就是斜着站不倒。",
      "token_start": 352,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 108200,
      "end_ms": 110980,
      "text": "您说这是歪打正着还是手艺？",
      "token_start": 360,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 110980,
      "end_ms": 115785,
      "text": "太精第九名陕西西安小雁塔建于唐朝，",
      "token_start": 372,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 116150,
      "end_ms": 117450,
      "text": "公元七百零七年，",
      "token_start": 388,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 117590,
      "end_ms": 118810,
      "text": "为了存放高僧，",
      "token_start": 395,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 118890,
      "end_ms": 120885,
      "text": "从印度带回来的经卷。",
      "token_start": 401,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 121390,
      "end_ms": 123895,
      "text": "这塔最邪乎的地方不是冷，",
      "token_start": 410,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 124140,
      "end_ms": 125345,
      "text": "是他会自己合。",
      "token_start": 421,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 125900,
      "end_ms": 127560,
      "text": "明朝成化二十三年，",
      "token_start": 427,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 127880,
      "end_ms": 129095,
      "text": "陕西大地震，",
      "token_start": 435,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 129370,
      "end_ms": 135145,
      "text": "六级小雁塔中间从上到下裂了一条一尺多宽的缝。",
      "token_start": 440,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 135810,
      "end_ms": 138275,
      "text": "当时人都觉得这塔完了，",
      "token_start": 461,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 138610,
      "end_ms": 146095,
      "text": "结果三十四年以后又一次大地震那条缝一夜之间自己合上了。",
      "token_start": 471,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 147400,
      "end_ms": 149135,
      "text": "后来又列了两次，",
      "token_start": 497,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 149990,
      "end_ms": 151050,
      "text": "又合了两次，",
      "token_start": 504,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 151330,
      "end_ms": 153105,
      "text": "三次裂三次合。",
      "token_start": 509,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 154410,
      "end_ms": 159090,
      "text": "老百姓管他叫神和科学家研究了半天，",
      "token_start": 515,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 159410,
      "end_ms": 162165,
      "text": "说是因为塔身结构特殊，",
      "token_start": 531,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 162690,
      "end_ms": 163470,
      "text": "裂缝以后，",
      "token_start": 541,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 163510,
      "end_ms": 164770,
      "text": "重心还偏向，",
      "token_start": 545,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 164830,
      "end_ms": 166530,
      "text": "中间小地震，",
      "token_start": 550,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 166530,
      "end_ms": 168625,
      "text": "一晃反而往中间聚。",
      "token_start": 555,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 169160,
      "end_ms": 170775,
      "text": "您说这塔是成精了，",
      "token_start": 563,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 171140,
      "end_ms": 173605,
      "text": "还是古人把力学算到了骨头里？",
      "token_start": 571,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 174270,
      "end_ms": 174925,
      "text": "第八名，",
      "token_start": 584,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 175600,
      "end_ms": 178985,
      "text": "河南登峰松月寺塔建于北魏，",
      "token_start": 587,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 179430,
      "end_ms": 181425,
      "text": "公元五百二十年左右，",
      "token_start": 599,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 181900,
      "end_ms": 185945,
      "text": "中国现存最古老的砖塔一千五百年了，",
      "token_start": 608,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 186350,
      "end_ms": 189595,
      "text": "这塔最绝的地方是它的形状。",
      "token_start": 624,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 190040,
      "end_ms": 194035,
      "text": "中国古塔千千万方的圆的八角的，",
      "token_start": 636,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 194410,
      "end_ms": 197005,
      "text": "唯独这一座是十二边形，",
      "token_start": 650,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 197360,
      "end_ms": 198945,
      "text": "全国找不到第二座。",
      "token_start": 660,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 199820,
      "end_ms": 200620,
      "text": "建筑学家。",
      "token_start": 668,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 200740,
      "end_ms": 202225,
      "text": "罗哲文先生说过，",
      "token_start": 672,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 203050,
      "end_ms": 209075,
      "text": "这塔的建筑结构艺术造型堪称爵响和第一，",
      "token_start": 679,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 209880,
      "end_ms": 215245,
      "text": "而且是古代唯一一座十二边形十五层塔的孤立。",
      "token_start": 697,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 215580,
      "end_ms": 216555,
      "text": "孤立什么意思？",
      "token_start": 717,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 216950,
      "end_ms": 219500,
      "text": "就是他自己一个没有同类，",
      "token_start": 723,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 219720,
      "end_ms": 220560,
      "text": "没有后代，",
      "token_start": 734,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 220760,
      "end_ms": 222555,
      "text": "中国古塔从它开始。",
      "token_start": 738,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 223150,
      "end_ms": 227460,
      "text": "可他这个造型后面再也没人复制过一座塔，",
      "token_start": 746,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 227620,
      "end_ms": 231055,
      "text": "站在嵩山脚下孤零零站了一千五百年，",
      "token_start": 764,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 231950,
      "end_ms": 235865,
      "text": "您说他是开路先锋还是天外来客第七名？",
      "token_start": 780,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 236280,
      "end_ms": 240935,
      "text": "云南大理崇圣寺三塔主塔叫千寻塔，",
      "token_start": 797,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 241780,
      "end_ms": 243765,
      "text": "鉴于唐朝南诏时期，",
      "token_start": 812,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 244520,
      "end_ms": 249120,
      "text": "公元八百多年高六十九点一、三米十六层，",
      "token_start": 820,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 249220,
      "end_ms": 251655,
      "text": "这个高度算得上是摩天大厦。",
      "token_start": 837,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 252630,
      "end_ms": 255695,
      "text": "这塔最绝的地方不是高，",
      "token_start": 849,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 256430,
      "end_ms": 257335,
      "text": "是怎么修的？",
      "token_start": 859,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 258280,
      "end_ms": 260125,
      "text": "大理古时候是个泽国，",
      "token_start": 864,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 260870,
      "end_ms": 261430,
      "text": "水患，",
      "token_start": 873,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 261470,
      "end_ms": 263380,
      "text": "多修塔，",
      "token_start": 875,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 263460,
      "end_ms": 264935,
      "text": "除了弘扬佛法，",
      "token_start": 878,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 265350,
      "end_ms": 266235,
      "text": "还要镇水，",
      "token_start": 884,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 266680,
      "end_ms": 268985,
      "text": "怎么把这么高的塔修起来的，",
      "token_start": 888,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 269250,
      "end_ms": 272855,
      "text": "用的是堆土建塔法垫一层土，",
      "token_start": 900,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 273300,
      "end_ms": 274225,
      "text": "修一层塔，",
      "token_start": 912,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 274630,
      "end_ms": 275650,
      "text": "再垫一层土，",
      "token_start": 916,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 275810,
      "end_ms": 278095,
      "text": "再修一层一直堆到塔顶，",
      "token_start": 921,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 278360,
      "end_ms": 281040,
      "text": "然后从上面往下一层一层挖土，",
      "token_start": 931,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 281240,
      "end_ms": 282185,
      "text": "它就出来了，",
      "token_start": 944,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 282540,
      "end_ms": 284530,
      "text": "这就叫堆土践踏，",
      "token_start": 949,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 284790,
      "end_ms": 286105,
      "text": "挖土陷塌。",
      "token_start": 956,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 286750,
      "end_ms": 287830,
      "text": "一千多年里，",
      "token_start": 960,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 287990,
      "end_ms": 291065,
      "text": "大理经历了三十多次强地震。",
      "token_start": 965,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 291610,
      "end_ms": 293475,
      "text": "一九二五年大地震，",
      "token_start": 977,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 294460,
      "end_ms": 296705,
      "text": "大理城里民房倒了百分之九十九，",
      "token_start": 985,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 297550,
      "end_ms": 300095,
      "text": "千寻塔就掉了顶上的宝刹。",
      "token_start": 999,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 300950,
      "end_ms": 302265,
      "text": "踏身纹丝不动，",
      "token_start": 1010,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 303170,
      "end_ms": 307025,
      "text": "您说这堆土法是笨办法？",
      "token_start": 1016,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 307450,
      "end_ms": 308710,
      "text": "还是大智慧。",
      "token_start": 1026,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 308930,
      "end_ms": 309550,
      "text": "第六名，",
      "token_start": 1031,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 309730,
      "end_ms": 313210,
      "text": "浙江杭州六合塔建于北宋开宝三年，",
      "token_start": 1034,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 313390,
      "end_ms": 314710,
      "text": "公元九百七十年，",
      "token_start": 1049,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 314830,
      "end_ms": 321290,
      "text": "吴越王钱弘横为了镇江潮修的这塔最绝的地方不在塔本身。",
      "token_start": 1056,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 321830,
      "end_ms": 323850,
      "text": "在塔里的人水浒传里，",
      "token_start": 1081,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 324030,
      "end_ms": 326430,
      "text": "鲁智深跟着宋江打完方腊，",
      "token_start": 1090,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 326610,
      "end_ms": 328230,
      "text": "驻扎在六合塔，",
      "token_start": 1101,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 328650,
      "end_ms": 331030,
      "text": "半夜听见钱塘江潮水响，",
      "token_start": 1107,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 331230,
      "end_ms": 332230,
      "text": "以为是战鼓，",
      "token_start": 1117,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 332650,
      "end_ms": 334690,
      "text": "抄起禅杖就要冲出去。",
      "token_start": 1122,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 335050,
      "end_ms": 336430,
      "text": "和尚告诉他在，",
      "token_start": 1131,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 336430,
      "end_ms": 337175,
      "text": "不是战鼓，",
      "token_start": 1137,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 337420,
      "end_ms": 338140,
      "text": "是朝信。",
      "token_start": 1141,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 339220,
      "end_ms": 340100,
      "text": "鲁智深一听，",
      "token_start": 1144,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 340400,
      "end_ms": 341140,
      "text": "想起师傅，",
      "token_start": 1149,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 341140,
      "end_ms": 344540,
      "text": "说过听朝而园见信而济。",
      "token_start": 1153,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 345280,
      "end_ms": 346220,
      "text": "当天晚上，",
      "token_start": 1163,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 346440,
      "end_ms": 347400,
      "text": "沐浴更衣，",
      "token_start": 1167,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 348100,
      "end_ms": 350760,
      "text": "坐在六合塔里圆寂了，",
      "token_start": 1171,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 351420,
      "end_ms": 355000,
      "text": "后来武松也不跟宋江回去见皇帝了，",
      "token_start": 1180,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 355100,
      "end_ms": 356560,
      "text": "留在六合塔出家，",
      "token_start": 1195,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 356800,
      "end_ms": 359200,
      "text": "一直活到八十岁一座塔，",
      "token_start": 1202,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 359640,
      "end_ms": 360920,
      "text": "送走了一个花河，",
      "token_start": 1212,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 360920,
      "end_ms": 361160,
      "text": "尚，",
      "token_start": 1219,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 361400,
      "end_ms": 363020,
      "text": "留住了一个打虎英雄。",
      "token_start": 1220,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 363540,
      "end_ms": 366975,
      "text": "您说这塔是镇江朝的还是收人心的？",
      "token_start": 1229,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 367380,
      "end_ms": 369125,
      "text": "从第十到第六，",
      "token_start": 1244,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 370180,
      "end_ms": 371660,
      "text": "虎丘塔斜了一千年，",
      "token_start": 1250,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 371660,
      "end_ms": 374120,
      "text": "不到小雁塔列了三次，",
      "token_start": 1258,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 374360,
      "end_ms": 376250,
      "text": "自己合上松。",
      "token_start": 1267,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 376250,
      "end_ms": 380920,
      "text": "岳寺塔是全国唯一的十二边形大理三塔堆土，",
      "token_start": 1272,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 380920,
      "end_ms": 382495,
      "text": "修了千年不塌，",
      "token_start": 1291,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 382930,
      "end_ms": 384785,
      "text": "六和塔送走了鲁智深，",
      "token_start": 1297,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 385110,
      "end_ms": 386790,
      "text": "留住了五苏可，",
      "token_start": 1306,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 386790,
      "end_ms": 388825,
      "text": "这五座还不是最邪乎的。",
      "token_start": 1312,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 389430,
      "end_ms": 391130,
      "text": "接下来第五道第一，",
      "token_start": 1322,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 391250,
      "end_ms": 393330,
      "text": "一座比一座悬有一座塔，",
      "token_start": 1330,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 393650,
      "end_ms": 395555,
      "text": "全木头搭的没一根钉，",
      "token_start": 1340,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 395920,
      "end_ms": 398400,
      "text": "挨了二百多发炮弹四十多次，",
      "token_start": 1349,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 398400,
      "end_ms": 399635,
      "text": "地震还站着，",
      "token_start": 1361,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 399970,
      "end_ms": 400850,
      "text": "还有一座塔，",
      "token_start": 1366,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 401130,
      "end_ms": 401970,
      "text": "地宫打开，",
      "token_start": 1371,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 402210,
      "end_ms": 403535,
      "text": "全世界都轰动了，",
      "token_start": 1375,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 404090,
      "end_ms": 404845,
      "text": "他是哪座？",
      "token_start": 1382,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 405220,
      "end_ms": 407615,
      "text": "他凭什么排第一下集马上更新，",
      "token_start": 1386,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 408100,
      "end_ms": 410635,
      "text": "您先点个关注点开头像别走丢。",
      "token_start": 1399,
      "token_end_exclusive": 1412
    }
  ],
