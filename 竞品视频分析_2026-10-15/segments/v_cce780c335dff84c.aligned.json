{
  "video_id": "v_cce780c335dff84c",
  "duration_s": 461.589002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_cce780c335dff84c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_cce780c335dff84c.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 1050,
      "text": "一九四六年，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1250,
      "end_ms": 2190,
      "text": "英国伦敦，",
      "token_start": 5,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2690,
      "end_ms": 4110,
      "text": "一家皮草店里，",
      "token_start": 9,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 4210,
      "end_ms": 8830,
      "text": "一个二十八岁的中国留学生攥着刚领到的薪水，",
      "token_start": 15,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 9190,
      "end_ms": 12130,
      "text": "想给国内的妻子买件皮大衣，",
      "token_start": 35,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 12750,
      "end_ms": 14570,
      "text": "店员上下扫了他一眼，",
      "token_start": 47,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 14850,
      "end_ms": 16190,
      "text": "鼻子里哼出一声，",
      "token_start": 56,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 16790,
      "end_ms": 17870,
      "text": "这么贵的东西，",
      "token_start": 63,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 18110,
      "end_ms": 20450,
      "text": "你们中国人买得起吗？",
      "token_start": 69,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21410,
      "end_ms": 25530,
      "text": "这句话像一把刀扎进了这个年轻人的心里。",
      "token_start": 78,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 26070,
      "end_ms": 27210,
      "text": "他没吵没闹，",
      "token_start": 96,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 27930,
      "end_ms": 28590,
      "text": "攥着钱，",
      "token_start": 101,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 28710,
      "end_ms": 29815,
      "text": "转身就走。",
      "token_start": 104,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 30680,
      "end_ms": 32080,
      "text": "但你记住这个画面，",
      "token_start": 108,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 32600,
      "end_ms": 34420,
      "text": "这个被人当面羞辱，",
      "token_start": 116,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 34540,
      "end_ms": 41360,
      "text": "买不起的中国人十几年后会亲手在罗布泊升起一朵蘑菇云，",
      "token_start": 124,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 42080,
      "end_ms": 45500,
      "text": "让整个西方国家再也不敢小看中国。",
      "token_start": 149,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 46240,
      "end_ms": 47280,
      "text": "他叫陈开甲，",
      "token_start": 164,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 48320,
      "end_ms": 48840,
      "text": "说出来，",
      "token_start": 169,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 48840,
      "end_ms": 52140,
      "text": "你可能不信这位后来的中国和司令，",
      "token_start": 172,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 52440,
      "end_ms": 54940,
      "text": "小时候是个实打实的问题少年。",
      "token_start": 187,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 55480,
      "end_ms": 56500,
      "text": "一九一八年，",
      "token_start": 200,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 56940,
      "end_ms": 60650,
      "text": "程开甲出生在江苏吴江盛泽镇的商人。",
      "token_start": 205,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 60650,
      "end_ms": 63225,
      "text": "家庭含着金汤匙长大，",
      "token_start": 221,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 63830,
      "end_ms": 65905,
      "text": "祖父给他取名开甲，",
      "token_start": 230,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 66360,
      "end_ms": 68175,
      "text": "盼的是开科取士，",
      "token_start": 238,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 69140,
      "end_ms": 70135,
      "text": "金榜题名。",
      "token_start": 245,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 70390,
      "end_ms": 71865,
      "text": "可天有不测风云，",
      "token_start": 249,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 72370,
      "end_ms": 73525,
      "text": "七岁丧父，",
      "token_start": 256,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 73930,
      "end_ms": 74410,
      "text": "九岁，",
      "token_start": 260,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 74490,
      "end_ms": 76205,
      "text": "母亲被逼迫离家，",
      "token_start": 262,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 76650,
      "end_ms": 78905,
      "text": "一个本该无忧无虑的孩子，",
      "token_start": 269,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 79320,
      "end_ms": 82195,
      "text": "一夜之间成了没人管的野孩子。",
      "token_start": 280,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 82610,
      "end_ms": 83605,
      "text": "他开始叛逆。",
      "token_start": 293,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 84180,
      "end_ms": 85180,
      "text": "小学二年级，",
      "token_start": 298,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 85180,
      "end_ms": 86505,
      "text": "连续留级三年，",
      "token_start": 303,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 87060,
      "end_ms": 92235,
      "text": "同学给他起外号叫年年老板十二岁那年更离谱，",
      "token_start": 309,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 92640,
      "end_ms": 93795,
      "text": "偷拿家里的钱，",
      "token_start": 329,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 94250,
      "end_ms": 101515,
      "text": "一个人跑到上海流浪花个金光厚露宿街头被家人找回去痛打了一顿。",
      "token_start": 335,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 102590,
      "end_ms": 104815,
      "text": "你以为这孩子这辈子就毁了，",
      "token_start": 364,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 105110,
      "end_ms": 107975,
      "text": "没有那顿打？",
      "token_start": 376,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 108800,
      "end_ms": 113380,
      "text": "加上一九三一年九一八事变国土沦丧的消息，",
      "token_start": 381,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 113760,
      "end_ms": 116975,
      "text": "向两记重锤把他砸醒了，",
      "token_start": 400,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 118160,
      "end_ms": 122750,
      "text": "他突然明白了自己再怎么胡闹。",
      "token_start": 410,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 123170,
      "end_ms": 125210,
      "text": "在一个快要亡国的国家里，",
      "token_start": 423,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 125310,
      "end_ms": 126110,
      "text": "什么都不是。",
      "token_start": 434,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 126970,
      "end_ms": 128030,
      "text": "从那天起，",
      "token_start": 439,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 128290,
      "end_ms": 131070,
      "text": "这个留级三年的学渣像换了一个人。",
      "token_start": 443,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 131610,
      "end_ms": 135790,
      "text": "他把所有叛逆和愤怒全拧成了一股劲。",
      "token_start": 458,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 136330,
      "end_ms": 139390,
      "text": "读书学科学救中国。",
      "token_start": 474,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 140370,
      "end_ms": 143830,
      "text": "他曾为钻研课业三天三夜，",
      "token_start": 482,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 144090,
      "end_ms": 147710,
      "text": "不眠不休十九岁考上浙江大学，",
      "token_start": 493,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 147910,
      "end_ms": 151520,
      "text": "整个大学是在抗战炮火声中读完的。",
      "token_start": 506,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 152420,
      "end_ms": 153720,
      "text": "浙大一路西迁，",
      "token_start": 521,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 153800,
      "end_ms": 154980,
      "text": "搬了七个地方。",
      "token_start": 527,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 155680,
      "end_ms": 157140,
      "text": "他跟着一路逃亡，",
      "token_start": 533,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 157160,
      "end_ms": 160780,
      "text": "一路学那段日子把一句话刻进了。",
      "token_start": 540,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 160780,
      "end_ms": 165200,
      "text": "他骨头里落后就要挨打师。",
      "token_start": 554,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 165200,
      "end_ms": 166520,
      "text": "九四六年八月，",
      "token_start": 565,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 167200,
      "end_ms": 173280,
      "text": "程开甲公费留学英国爱丁堡大学师从物理学。",
      "token_start": 571,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 173480,
      "end_ms": 177625,
      "text": "泰斗波恩教授这个岛是什么级别？",
      "token_start": 590,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 179780,
      "end_ms": 182505,
      "text": "诺贝尔奖得主城开家也争气。",
      "token_start": 604,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 183190,
      "end_ms": 187095,
      "text": "他和导师联手提出超导电双待模型，",
      "token_start": 616,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 187460,
      "end_ms": 189885,
      "text": "在国际学术界崭露头角。",
      "token_start": 631,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 190070,
      "end_ms": 191485,
      "text": "可学术上的光环，",
      "token_start": 641,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 191890,
      "end_ms": 193495,
      "text": "换不来英国人的尊重。",
      "token_start": 648,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 194200,
      "end_ms": 195515,
      "text": "走在伦敦街头，",
      "token_start": 657,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 195930,
      "end_ms": 199805,
      "text": "他会无缘无故被人翻白眼、去海边游泳。",
      "token_start": 663,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 200730,
      "end_ms": 201810,
      "text": "几个英国人一看，",
      "token_start": 679,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 201810,
      "end_ms": 202965,
      "text": "中国人下水了，",
      "token_start": 686,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 203400,
      "end_ms": 204235,
      "text": "立马上岸，",
      "token_start": 692,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 204630,
      "end_ms": 205610,
      "text": "嘴里嘟囔着，",
      "token_start": 696,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 205610,
      "end_ms": 209245,
      "text": "有批人把我们的水都弄脏了去商店买东西。",
      "token_start": 701,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 209660,
      "end_ms": 210360,
      "text": "店员一看，",
      "token_start": 719,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 210360,
      "end_ms": 211085,
      "text": "是中国人，",
      "token_start": 723,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 211330,
      "end_ms": 212545,
      "text": "态度立马冷下来，",
      "token_start": 727,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 212920,
      "end_ms": 214685,
      "text": "开头那件皮大衣的事儿，",
      "token_start": 734,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 215170,
      "end_ms": 217595,
      "text": "只是无数次歧视中的一次，",
      "token_start": 744,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 218450,
      "end_ms": 219505,
      "text": "他心里清楚，",
      "token_start": 755,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 220170,
      "end_ms": 221435,
      "text": "在英国人眼里，",
      "token_start": 760,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 222080,
      "end_ms": 223315,
      "text": "你学问再高，",
      "token_start": 766,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 223600,
      "end_ms": 224555,
      "text": "也低人一等。",
      "token_start": 771,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 224770,
      "end_ms": 225765,
      "text": "陈开甲忍了，",
      "token_start": 776,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 226650,
      "end_ms": 227675,
      "text": "他不是懦弱，",
      "token_start": 781,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 228530,
      "end_ms": 229995,
      "text": "他在等一个机会，",
      "token_start": 786,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 230900,
      "end_ms": 231785,
      "text": "这个机会。",
      "token_start": 793,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 232910,
      "end_ms": 234475,
      "text": "一九四九年来了。",
      "token_start": 797,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 235830,
      "end_ms": 237465,
      "text": "一九四九年四月，",
      "token_start": 804,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 238990,
      "end_ms": 242075,
      "text": "英国军舰紫石英号无视警告，",
      "token_start": 811,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 242520,
      "end_ms": 244415,
      "text": "擅自闯入长江水域，",
      "token_start": 823,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 244850,
      "end_ms": 247075,
      "text": "被解放军炮火直接击中，",
      "token_start": 831,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 247900,
      "end_ms": 250125,
      "text": "搁浅后升起白旗投降。",
      "token_start": 841,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 250990,
      "end_ms": 253330,
      "text": "消息传到英国程开甲，",
      "token_start": 850,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 253350,
      "end_ms": 254935,
      "text": "看到报纸的那一刻，",
      "token_start": 859,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 255340,
      "end_ms": 260225,
      "text": "这个向来理性克制的物理学家当场哽咽了。",
      "token_start": 867,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 260590,
      "end_ms": 262330,
      "text": "他一拳砸在桌子上，",
      "token_start": 885,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 262350,
      "end_ms": 264085,
      "text": "眼泪止不住的流。",
      "token_start": 893,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 264520,
      "end_ms": 265160,
      "text": "在后来，",
      "token_start": 900,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 265180,
      "end_ms": 267995,
      "text": "九十多岁的程老回忆起这一幕，",
      "token_start": 903,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 268350,
      "end_ms": 269935,
      "text": "还是激动的拍桌子，",
      "token_start": 916,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 270510,
      "end_ms": 273045,
      "text": "说完就忍不住掩面而泣。",
      "token_start": 924,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 273930,
      "end_ms": 274935,
      "text": "他为什么哭？",
      "token_start": 934,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 275440,
      "end_ms": 276640,
      "text": "因为他等这一天，",
      "token_start": 939,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 276660,
      "end_ms": 277940,
      "text": "等了太多年了。",
      "token_start": 946,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 278420,
      "end_ms": 280440,
      "text": "从鸦片战争到那时，",
      "token_start": 952,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 280720,
      "end_ms": 283324,
      "text": "西方国家欺负了中国一百多年，",
      "token_start": 960,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 283860,
      "end_ms": 287940,
      "text": "现在中国人终于敢对着英国军舰开火了，",
      "token_start": 973,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 288140,
      "end_ms": 290885,
      "text": "而且打赢了程开甲说了一句话，",
      "token_start": 990,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 291550,
      "end_ms": 293310,
      "text": "我就知道我们有这一天的，",
      "token_start": 1003,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 293530,
      "end_ms": 294845,
      "text": "是时候回去了，",
      "token_start": 1014,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 296370,
      "end_ms": 297130,
      "text": "他要回去，",
      "token_start": 1020,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 297230,
      "end_ms": 298550,
      "text": "不是回去当教授，",
      "token_start": 1024,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 298550,
      "end_ms": 299765,
      "text": "过安稳日子，",
      "token_start": 1031,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 300120,
      "end_ms": 303915,
      "text": "而是回去给这个一穷二白的国家铸一把。",
      "token_start": 1036,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 304250,
      "end_ms": 306770,
      "text": "护国的剑临走前，",
      "token_start": 1053,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 307070,
      "end_ms": 311030,
      "text": "他做了一个让所有人都看不懂的决定，",
      "token_start": 1060,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 311590,
      "end_ms": 314130,
      "text": "把英国攒的积蓄全拿出来。",
      "token_start": 1076,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 314410,
      "end_ms": 318150,
      "text": "真皮大衣、收音机这些值钱东西全卖了，",
      "token_start": 1087,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 318410,
      "end_ms": 322690,
      "text": "换成了国内根本买不到的学术资料和精密仪器。",
      "token_start": 1103,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 323230,
      "end_ms": 324790,
      "text": "那个曾经穿着西装，",
      "token_start": 1123,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 324810,
      "end_ms": 326690,
      "text": "走在伦敦街头的洋博士，",
      "token_start": 1131,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 327230,
      "end_ms": 328250,
      "text": "回国的时候，",
      "token_start": 1141,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 328250,
      "end_ms": 331010,
      "text": "肩扛手提大包小包，",
      "token_start": 1146,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 331570,
      "end_ms": 332510,
      "text": "像个逃难。",
      "token_start": 1154,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 332710,
      "end_ms": 334035,
      "text": "一九五零年八月，",
      "token_start": 1158,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 334480,
      "end_ms": 336120,
      "text": "程开甲回到祖国，",
      "token_start": 1165,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 336700,
      "end_ms": 338460,
      "text": "先在浙江大学任教。",
      "token_start": 1172,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 338940,
      "end_ms": 339900,
      "text": "一九五二年，",
      "token_start": 1180,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 339920,
      "end_ms": 340800,
      "text": "院系调整，",
      "token_start": 1185,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 341040,
      "end_ms": 343540,
      "text": "他被调到南京大学学校，",
      "token_start": 1189,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 343560,
      "end_ms": 345820,
      "text": "把他当归国高级知识分子，",
      "token_start": 1199,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 346420,
      "end_ms": 347980,
      "text": "要给他定二级教授。",
      "token_start": 1210,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 348920,
      "end_ms": 351020,
      "text": "他填表师执意不要二级，",
      "token_start": 1218,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 351320,
      "end_ms": 353060,
      "text": "只肯领三级的工资，",
      "token_start": 1228,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 353860,
      "end_ms": 355640,
      "text": "说国家正在打仗，",
      "token_start": 1236,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 355960,
      "end_ms": 357600,
      "text": "我这份薪金够用了。",
      "token_start": 1243,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 358420,
      "end_ms": 359340,
      "text": "教学之余，",
      "token_start": 1251,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 359640,
      "end_ms": 363955,
      "text": "他一个人编写了中国第一部固体物理学专著。",
      "token_start": 1255,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 364580,
      "end_ms": 367540,
      "text": "那时候国内这方面资料几乎空白，",
      "token_start": 1274,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 367600,
      "end_ms": 368840,
      "text": "他硬是一个字，",
      "token_start": 1288,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 368840,
      "end_ms": 370015,
      "text": "一个字啃出来。",
      "token_start": 1294,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 370940,
      "end_ms": 372835,
      "text": "如果日子就这么过下去，",
      "token_start": 1300,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 373350,
      "end_ms": 378405,
      "text": "陈开甲可能会成为一个受人尊敬的大学教授。",
      "token_start": 1310,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 379370,
      "end_ms": 383505,
      "text": "但一九六零年一直掉令，",
      "token_start": 1329,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 383930,
      "end_ms": 385775,
      "text": "彻底改变了他的人生。",
      "token_start": 1339,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 386610,
      "end_ms": 387210,
      "text": "那一年，",
      "token_start": 1348,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 387390,
      "end_ms": 388705,
      "text": "程开甲四十二岁，",
      "token_start": 1351,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 389150,
      "end_ms": 391925,
      "text": "正是科学家出成果的黄金年龄。",
      "token_start": 1358,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 392340,
      "end_ms": 393400,
      "text": "他接到通知，",
      "token_start": 1371,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 393700,
      "end_ms": 395060,
      "text": "立刻去北京报道，",
      "token_start": 1376,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 395240,
      "end_ms": 396115,
      "text": "去干什么，",
      "token_start": 1383,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 396500,
      "end_ms": 398095,
      "text": "去哪里去多久，",
      "token_start": 1387,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 399240,
      "end_ms": 399785,
      "text": "不能问，",
      "token_start": 1393,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 400740,
      "end_ms": 401535,
      "text": "不能说，",
      "token_start": 1396,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 402450,
      "end_ms": 405410,
      "text": "连家人都不能告诉他。",
      "token_start": 1399,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 405410,
      "end_ms": 407530,
      "text": "对妻子高耀山只说了一句话，",
      "token_start": 1408,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 407590,
      "end_ms": 408885,
      "text": "我要出趟远差。",
      "token_start": 1420,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 409820,
      "end_ms": 410720,
      "text": "从那天起，",
      "token_start": 1426,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 410740,
      "end_ms": 412205,
      "text": "程开甲这个名字，",
      "token_start": 1430,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 412470,
      "end_ms": 414715,
      "text": "在学术界彻底消失了，",
      "token_start": 1437,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 415530,
      "end_ms": 417250,
      "text": "没有人知道他去了哪里，",
      "token_start": 1446,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 417330,
      "end_ms": 418825,
      "text": "没有人知道他在干什么。",
      "token_start": 1456,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 419160,
      "end_ms": 420815,
      "text": "他像人间蒸发一样，",
      "token_start": 1466,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 421360,
      "end_ms": 427265,
      "text": "从所有公开场合所有学术期刊里消失的干干净净。",
      "token_start": 1474,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 428170,
      "end_ms": 428790,
      "text": "三年后，",
      "token_start": 1495,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 428790,
      "end_ms": 429535,
      "text": "一九六三年，",
      "token_start": 1498,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 429790,
      "end_ms": 432365,
      "text": "他第一次踏上了罗布泊的土地。",
      "token_start": 1503,
      "token_end_exclusive": 1516
    },
    {
      "start_ms": 433870,
      "end_ms": 436825,
      "text": "那地方有个外号叫死亡之海，",
      "token_start": 1516,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 437790,
      "end_ms": 441275,
      "text": "这一消失就是整整四十年。",
      "token_start": 1528,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 441530,
      "end_ms": 442245,
      "text": "先点个赞，",
      "token_start": 1539,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 443360,
      "end_ms": 445205,
      "text": "把这条视频收藏起来，",
      "token_start": 1543,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 446000,
      "end_ms": 447995,
      "text": "再转发给身边的朋友。",
      "token_start": 1552,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 448960,
      "end_ms": 451495,
      "text": "他在罗布泊到底经历了什么？",
      "token_start": 1561,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 452580,
      "end_ms": 460380,
      "text": "为什么一个浏阳博士会变成让西方国家闻风丧胆的中国核司令下集？",
      "token_start": 1573,
      "token_end_exclusive": 1602
    },
    {
      "start_ms": 460660,
      "end_ms": 461505,
      "text": "我接着讲。",
      "token_start": 1602,
      "token_end_exclusive": 1606
    }
  ],
