{
  "video_id": "v_2c5841ec9d341753",
  "duration_s": 441.806939,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_2c5841ec9d341753.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_2c5841ec9d341753.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 330,
      "end_ms": 5550,
      "text": "您知道中国历史上最像世外桃源的古村落都有哪些吗？",
      "token_start": 0,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5910,
      "end_ms": 6450,
      "text": "上集，",
      "token_start": 23,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6530,
      "end_ms": 12250,
      "text": "咱们聊了红村西地诸葛村茶记和云端上的郭亮村。",
      "token_start": 25,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12930,
      "end_ms": 14650,
      "text": "这集直接揭开谜底，",
      "token_start": 46,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 15010,
      "end_ms": 17930,
      "text": "看看前五名超凡脱俗到什么程度。",
      "token_start": 54,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 18290,
      "end_ms": 21470,
      "text": "尤其是排在榜首的那座终极桃园，",
      "token_start": 68,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 22270,
      "end_ms": 24990,
      "text": "藏在冰川与大森林的怀抱里，",
      "token_start": 82,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 25390,
      "end_ms": 30780,
      "text": "把那种与世隔绝的安静过成了神仙吧安的日子。",
      "token_start": 94,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 31120,
      "end_ms": 31720,
      "text": "老规矩，",
      "token_start": 114,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 32080,
      "end_ms": 32900,
      "text": "开讲之前，",
      "token_start": 117,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 32900,
      "end_ms": 35140,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 121,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 35580,
      "end_ms": 37580,
      "text": "让我看看都是谁在听。",
      "token_start": 131,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 37940,
      "end_ms": 38600,
      "text": "第五名，",
      "token_start": 140,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 38980,
      "end_ms": 42980,
      "text": "塔川村安徽一县离红村不远，",
      "token_start": 143,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 43560,
      "end_ms": 45900,
      "text": "是一个藏在山里的小村子。",
      "token_start": 155,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 46740,
      "end_ms": 47880,
      "text": "别的地方好看，",
      "token_start": 166,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 47940,
      "end_ms": 48780,
      "text": "靠老房子，",
      "token_start": 172,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 49160,
      "end_ms": 50820,
      "text": "塔川靠的是一座山，",
      "token_start": 176,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 51240,
      "end_ms": 53440,
      "text": "它被人叫做塔川秋色。",
      "token_start": 184,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 54140,
      "end_ms": 55120,
      "text": "每到深秋，",
      "token_start": 193,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 55360,
      "end_ms": 57580,
      "text": "满山的巫棵枫树，",
      "token_start": 197,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 57940,
      "end_ms": 59645,
      "text": "青松一起变色，",
      "token_start": 204,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 60160,
      "end_ms": 61890,
      "text": "红的像火黄的，",
      "token_start": 210,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 61890,
      "end_ms": 63090,
      "text": "像金绿的，",
      "token_start": 216,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 63090,
      "end_ms": 65505,
      "text": "还没退一层压一层，",
      "token_start": 220,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 66110,
      "end_ms": 71565,
      "text": "把白墙黑瓦的小村整个拖在一片彩色的山林里。",
      "token_start": 228,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 72330,
      "end_ms": 75185,
      "text": "这满山的颜色不是天生的，",
      "token_start": 248,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 75670,
      "end_ms": 78355,
      "text": "村里的老人一代代传下规矩，",
      "token_start": 259,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 78940,
      "end_ms": 82725,
      "text": "水口山林里的树一颗也不许乱砍，",
      "token_start": 271,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 83410,
      "end_ms": 84595,
      "text": "守了几百年，",
      "token_start": 285,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 85030,
      "end_ms": 87565,
      "text": "才守住今天这一整面秋色。",
      "token_start": 290,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 88410,
      "end_ms": 89485,
      "text": "每年秋天，",
      "token_start": 301,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 89940,
      "end_ms": 94425,
      "text": "摄影师天不亮就扛着相机蹲在山坡上等光。",
      "token_start": 305,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 94860,
      "end_ms": 98440,
      "text": "您说这算不算祖宗种树后人？",
      "token_start": 323,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 98460,
      "end_ms": 100065,
      "text": "看画第四名，",
      "token_start": 335,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 100690,
      "end_ms": 101665,
      "text": "黄岭村，",
      "token_start": 340,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 102200,
      "end_ms": 108220,
      "text": "江西婺源婺源被叫做中国最美的乡村黄岭，",
      "token_start": 343,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 108320,
      "end_ms": 111125,
      "text": "又是婺源里最有画面感的一个。",
      "token_start": 361,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 111670,
      "end_ms": 114175,
      "text": "他始建于明代五百多年了，",
      "token_start": 374,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 114670,
      "end_ms": 119595,
      "text": "一排排灰派老房子沿着陡峭的山坡一层压一层，",
      "token_start": 385,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 120420,
      "end_ms": 121600,
      "text": "下面是梯田，",
      "token_start": 405,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 122240,
      "end_ms": 123400,
      "text": "四周是山谷，",
      "token_start": 410,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 123840,
      "end_ms": 124840,
      "text": "云雾一来，",
      "token_start": 415,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 125240,
      "end_ms": 127420,
      "text": "整个村子像挂在半空。",
      "token_start": 419,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 127820,
      "end_ms": 130220,
      "text": "它最出名的是晒丘，",
      "token_start": 428,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 130560,
      "end_ms": 131960,
      "text": "山里没有平地，",
      "token_start": 436,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 132540,
      "end_ms": 139560,
      "text": "家家户户只能把收下来的辣椒、玉米、南瓜、稻谷搬上屋顶，",
      "token_start": 442,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 140300,
      "end_ms": 141600,
      "text": "摆在木架子上，",
      "token_start": 465,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 142080,
      "end_ms": 147640,
      "text": "红的、黄的、橙的一圈一圈挂在白墙黑瓦之间，",
      "token_start": 471,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 148000,
      "end_ms": 151070,
      "text": "成了全国最出名的乡村画面。",
      "token_start": 489,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 151710,
      "end_ms": 154250,
      "text": "一个因为缺地才出现的土办法，",
      "token_start": 501,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 154610,
      "end_ms": 156410,
      "text": "晒成了最美的风景，",
      "token_start": 514,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 156670,
      "end_ms": 159570,
      "text": "您说这是不是生活本身的诗意？",
      "token_start": 522,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 159930,
      "end_ms": 160590,
      "text": "第三名，",
      "token_start": 535,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 161030,
      "end_ms": 162150,
      "text": "丹巴藏寨，",
      "token_start": 538,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 162570,
      "end_ms": 163710,
      "text": "四川甘孜，",
      "token_start": 542,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 164130,
      "end_ms": 165190,
      "text": "它不是一个村，",
      "token_start": 546,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 165570,
      "end_ms": 172090,
      "text": "而是一大片藏在高山河谷里的嘉戎藏族村寨山坡上。",
      "token_start": 552,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 172470,
      "end_ms": 175850,
      "text": "白墙红边的藏房散落在绿树间，",
      "token_start": 574,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 176690,
      "end_ms": 178730,
      "text": "一座座石头垒起的碉楼，",
      "token_start": 587,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 179350,
      "end_ms": 182715,
      "text": "高的能用有几十米直直插向天空，",
      "token_start": 597,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 183670,
      "end_ms": 186325,
      "text": "背后是终年不化的雪山。",
      "token_start": 611,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 186720,
      "end_ms": 190260,
      "text": "丹巴被叫做铅雕之国碉楼，",
      "token_start": 621,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 190300,
      "end_ms": 191395,
      "text": "多到数不清，",
      "token_start": 632,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 191920,
      "end_ms": 193755,
      "text": "至今还立着几百座，",
      "token_start": 637,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 194280,
      "end_ms": 196245,
      "text": "有的已经立了好几百年。",
      "token_start": 645,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 196640,
      "end_ms": 198215,
      "text": "这些碉楼没有钢筋，",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 198550,
      "end_ms": 199485,
      "text": "没有水泥，",
      "token_start": 663,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 200020,
      "end_ms": 203335,
      "text": "全靠一块块石头一层层垒起来。",
      "token_start": 667,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 203970,
      "end_ms": 205365,
      "text": "当年是为了防御，",
      "token_start": 680,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 205990,
      "end_ms": 209555,
      "text": "如今成了雪山下最壮观的一道风景。",
      "token_start": 687,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 209990,
      "end_ms": 212195,
      "text": "您站在山腰往下看，",
      "token_start": 702,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 212980,
      "end_ms": 219685,
      "text": "河谷森林碉楼、雪山一个镜头就装得下。",
      "token_start": 710,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 220150,
      "end_ms": 222635,
      "text": "您说这是不是真正的逆境？",
      "token_start": 726,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 223020,
      "end_ms": 223785,
      "text": "第二名，",
      "token_start": 737,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 224210,
      "end_ms": 224810,
      "text": "和睦村，",
      "token_start": 740,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 225170,
      "end_ms": 226325,
      "text": "新疆阿勒泰。",
      "token_start": 743,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 226890,
      "end_ms": 229315,
      "text": "他在新疆最北边的山里，",
      "token_start": 748,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 229650,
      "end_ms": 231635,
      "text": "离喀纳斯六十来公里，",
      "token_start": 758,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 232170,
      "end_ms": 233865,
      "text": "住在这里的是图瓦人，",
      "token_start": 767,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 234480,
      "end_ms": 236175,
      "text": "全国只有两千多人，",
      "token_start": 776,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 236710,
      "end_ms": 239835,
      "text": "相传是成吉思汗西征大军的后代。",
      "token_start": 784,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 240220,
      "end_ms": 243525,
      "text": "村里的房子清一色是原木垒起来的木屋，",
      "token_start": 798,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 244220,
      "end_ms": 246120,
      "text": "一根压一根凿草，",
      "token_start": 815,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 246140,
      "end_ms": 250250,
      "text": "咬合屋顶盖的厚厚的雪和睦河。",
      "token_start": 822,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 250250,
      "end_ms": 252010,
      "text": "从村子中间穿过，",
      "token_start": 835,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 252330,
      "end_ms": 254365,
      "text": "四周是白桦林和雪山，",
      "token_start": 842,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 255010,
      "end_ms": 255715,
      "text": "天一亮，",
      "token_start": 851,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 256070,
      "end_ms": 258485,
      "text": "晨雾裹着炊烟慢慢升起来，",
      "token_start": 854,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 258910,
      "end_ms": 261105,
      "text": "整个村子像浮在云里，",
      "token_start": 865,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 261520,
      "end_ms": 262985,
      "text": "冬天来的漫长，",
      "token_start": 874,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 263730,
      "end_ms": 265895,
      "text": "村里人踩着雪去放牧，",
      "token_start": 880,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 266650,
      "end_ms": 268585,
      "text": "一代代都是这样过日子。",
      "token_start": 889,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 269360,
      "end_ms": 271085,
      "text": "别人是造了一座村，",
      "token_start": 899,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 271630,
      "end_ms": 272150,
      "text": "和睦，",
      "token_start": 907,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 272150,
      "end_ms": 276385,
      "text": "是把整个村子种进了森林和雪山里。",
      "token_start": 909,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 276890,
      "end_ms": 277975,
      "text": "这样的画面，",
      "token_start": 924,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 278300,
      "end_ms": 281825,
      "text": "您说这是不是一眼就让人想住下来？",
      "token_start": 929,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 282170,
      "end_ms": 283915,
      "text": "第一名雨崩村，",
      "token_start": 944,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 284290,
      "end_ms": 286985,
      "text": "云南迪庆为什么是他？",
      "token_start": 950,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 287400,
      "end_ms": 289445,
      "text": "因为他不靠老房子取胜，",
      "token_start": 959,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 290110,
      "end_ms": 292395,
      "text": "他靠的是一个字远。",
      "token_start": 969,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 292920,
      "end_ms": 295325,
      "text": "他藏在梅里雪山脚下，",
      "token_start": 977,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 295770,
      "end_ms": 300160,
      "text": "海拔三千米上下分上羽崩夏雨崩，",
      "token_start": 986,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 300340,
      "end_ms": 302020,
      "text": "两个小村加起来，",
      "token_start": 1000,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 302020,
      "end_ms": 307175,
      "text": "不过几十户人家很长一段时间里通往他的只有一条路。",
      "token_start": 1007,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 307840,
      "end_ms": 309260,
      "text": "从西当村出发，",
      "token_start": 1030,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 309620,
      "end_ms": 313640,
      "text": "十几公里山路翻过三千七百米左右的垭口，",
      "token_start": 1036,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 314280,
      "end_ms": 315360,
      "text": "走上大半天。",
      "token_start": 1054,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 315880,
      "end_ms": 317280,
      "text": "运货的是罗马，",
      "token_start": 1059,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 317680,
      "end_ms": 320520,
      "text": "赶路的靠两条腿进了村，",
      "token_start": 1065,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 320940,
      "end_ms": 323980,
      "text": "一抬头就是梅里雪山的主峰。",
      "token_start": 1075,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 324160,
      "end_ms": 327460,
      "text": "卡瓦格伯海拔六千七百四十米，",
      "token_start": 1087,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 327720,
      "end_ms": 329780,
      "text": "是藏族人心里的神山。",
      "token_start": 1100,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 330340,
      "end_ms": 331940,
      "text": "到今天没有人登顶。",
      "token_start": 1109,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 332320,
      "end_ms": 333740,
      "text": "村后有森林，",
      "token_start": 1117,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 334280,
      "end_ms": 335120,
      "text": "有峡谷，",
      "token_start": 1122,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 335600,
      "end_ms": 337850,
      "text": "有终年不断的神谱处，",
      "token_start": 1125,
      "token_end_exclusive": 1134
    },
    {
      "start_ms": 338050,
      "end_ms": 345270,
      "text": "有冰湖村民每天的日子就是放牛、种地、看雪山，",
      "token_start": 1134,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 345710,
      "end_ms": 346650,
      "text": "没有喇叭，",
      "token_start": 1153,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 346990,
      "end_ms": 347890,
      "text": "没有堵车，",
      "token_start": 1157,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 348390,
      "end_ms": 349570,
      "text": "没有人催您。",
      "token_start": 1161,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 349990,
      "end_ms": 352690,
      "text": "前面九个村离的是老房子，",
      "token_start": 1166,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 353010,
      "end_ms": 354470,
      "text": "比的是山水好看，",
      "token_start": 1177,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 354890,
      "end_ms": 358630,
      "text": "可雨崩比的是离离城市，",
      "token_start": 1184,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 358630,
      "end_ms": 360350,
      "text": "有多远离喧闹，",
      "token_start": 1194,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 360370,
      "end_ms": 362670,
      "text": "有多远离烦恼有多远？",
      "token_start": 1200,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 362990,
      "end_ms": 364290,
      "text": "坐在木门槛上，",
      "token_start": 1209,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 364890,
      "end_ms": 368840,
      "text": "看着雪山所有的烦躁和委屈，",
      "token_start": 1215,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 369080,
      "end_ms": 371045,
      "text": "瞬间烟消云散，",
      "token_start": 1227,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 371600,
      "end_ms": 373205,
      "text": "心中出现一个念头，",
      "token_start": 1233,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 373800,
      "end_ms": 374855,
      "text": "真想住下来。",
      "token_start": 1241,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 375360,
      "end_ms": 376885,
      "text": "十座古村讲完了，",
      "token_start": 1246,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 377650,
      "end_ms": 381290,
      "text": "洪村把一头牛养成画西帝，",
      "token_start": 1253,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 381290,
      "end_ms": 383385,
      "text": "把老时光留到今天。",
      "token_start": 1264,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 384060,
      "end_ms": 389305,
      "text": "诸葛村邻里清和常志慧茶记老桥伴着流水声，",
      "token_start": 1272,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 390150,
      "end_ms": 392535,
      "text": "郭亮在云端守着石头房。",
      "token_start": 1291,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 393290,
      "end_ms": 393770,
      "text": "塔窗，",
      "token_start": 1301,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 393770,
      "end_ms": 395385,
      "text": "红叶配着热茶，",
      "token_start": 1303,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 396020,
      "end_ms": 400570,
      "text": "黄岭在向阳坡上晒出丰收锦绣单。",
      "token_start": 1309,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 400590,
      "end_ms": 404030,
      "text": "八、碉楼望着高雪山和睦，",
      "token_start": 1323,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 404090,
      "end_ms": 405975,
      "text": "把木屋种进森林里，",
      "token_start": 1333,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 406570,
      "end_ms": 410525,
      "text": "可只有于崩村在圣洁雪山的怀抱里，",
      "token_start": 1341,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 410960,
      "end_ms": 414285,
      "text": "给疲惫的人安顿的一个真正的家。",
      "token_start": 1356,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 414720,
      "end_ms": 416235,
      "text": "什么叫世外桃源？",
      "token_start": 1370,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 416650,
      "end_ms": 419265,
      "text": "不是躲在深山不吃人间烟火，",
      "token_start": 1377,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 419680,
      "end_ms": 422960,
      "text": "而是有一方天地能让您推开门，",
      "token_start": 1389,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 423060,
      "end_ms": 424225,
      "text": "看见好山水，",
      "token_start": 1402,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 424640,
      "end_ms": 425420,
      "text": "关上门，",
      "token_start": 1407,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 425420,
      "end_ms": 426240,
      "text": "过上安稳，",
      "token_start": 1410,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 426240,
      "end_ms": 426785,
      "text": "日子，",
      "token_start": 1414,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 427140,
      "end_ms": 428345,
      "text": "心里头踏实，",
      "token_start": 1416,
      "token_end_exclusive": 1421
    },
    {
      "start_ms": 428690,
      "end_ms": 429695,
      "text": "不慌不忙。",
      "token_start": 1421,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 430090,
      "end_ms": 431085,
      "text": "最后问您一句，",
      "token_start": 1425,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 431440,
      "end_ms": 433775,
      "text": "这十个村子您去过哪几个？",
      "token_start": 1431,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 434480,
      "end_ms": 436685,
      "text": "哪一个最让您想住下来，",
      "token_start": 1442,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 437330,
      "end_ms": 438935,
      "text": "想听更多这类故事，",
      "token_start": 1452,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 439230,
      "end_ms": 439910,
      "text": "点个关注，",
      "token_start": 1460,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 440050,
      "end_ms": 441505,
      "text": "咱们下期接着聊。",
      "token_start": 1464,
      "token_end_exclusive": 1471
    }
  ],
