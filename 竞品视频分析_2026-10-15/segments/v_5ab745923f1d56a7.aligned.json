{
  "video_id": "v_5ab745923f1d56a7",
  "duration_s": 318.67,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_5ab745923f1d56a7.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_5ab745923f1d56a7.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 3090,
      "text": "二零二一年五月二十二号下午，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3370,
      "end_ms": 6990,
      "text": "长沙湘雅医院门口来了一波又一波人，",
      "token_start": 13,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 7530,
      "end_ms": 9130,
      "text": "有人手里捧着菊花，",
      "token_start": 29,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 9390,
      "end_ms": 11230,
      "text": "有人抱着干戈的稻穗，",
      "token_start": 37,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 11490,
      "end_ms": 12730,
      "text": "有人什么都没带，",
      "token_start": 46,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13210,
      "end_ms": 14930,
      "text": "就站在那儿抹眼泪。",
      "token_start": 53,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 15290,
      "end_ms": 18350,
      "text": "从医院到殡仪馆的路上车停了，",
      "token_start": 61,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 18530,
      "end_ms": 19370,
      "text": "喇叭响了，",
      "token_start": 74,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 19670,
      "end_ms": 23230,
      "text": "开车的、骑车的、走路的都停下来，",
      "token_start": 78,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 23230,
      "end_ms": 29430,
      "text": "目送一个上了年纪的农民把一捆带着泥的稻穗放在医院，",
      "token_start": 91,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 29430,
      "end_ms": 32280,
      "text": "路边的在台阶上弯下腰，",
      "token_start": 115,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 32560,
      "end_ms": 33840,
      "text": "深深鞠了一躬。",
      "token_start": 125,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 33980,
      "end_ms": 37260,
      "text": "那天去世的这位老人叫袁隆平，",
      "token_start": 131,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38039,
      "end_ms": 39540,
      "text": "你可能听过他的名字，",
      "token_start": 144,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 39820,
      "end_ms": 42120,
      "text": "知道他是杂交水稻之父，",
      "token_start": 153,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 42620,
      "end_ms": 43980,
      "text": "拿过共和国勋章。",
      "token_start": 163,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 44520,
      "end_ms": 46080,
      "text": "但我今天不想跟你说，",
      "token_start": 170,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 46080,
      "end_ms": 46980,
      "text": "他有多风光，",
      "token_start": 179,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 47620,
      "end_ms": 50280,
      "text": "我想把他从领奖台上拽下来，",
      "token_start": 184,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 50640,
      "end_ms": 52260,
      "text": "放回那个饿漂遍野，",
      "token_start": 196,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 52800,
      "end_ms": 55020,
      "text": "连树皮都被扒光的年代。",
      "token_start": 204,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 55920,
      "end_ms": 57600,
      "text": "那是上世纪六十年代，",
      "token_start": 214,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 58140,
      "end_ms": 60010,
      "text": "袁隆平还只是湖南安，",
      "token_start": 223,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 60070,
      "end_ms": 61875,
      "text": "将农校一个普通老师，",
      "token_start": 232,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 62450,
      "end_ms": 64255,
      "text": "月工资四十多块，",
      "token_start": 241,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 65240,
      "end_ms": 67815,
      "text": "住在一间漏雨的宿舍里，",
      "token_start": 248,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 68050,
      "end_ms": 69050,
      "text": "全国闹饥荒。",
      "token_start": 258,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 69270,
      "end_ms": 71715,
      "text": "他亲眼看见路边有人饿的走不动，",
      "token_start": 263,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 72040,
      "end_ms": 74135,
      "text": "倒在田埂上就再也没起来。",
      "token_start": 277,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 74620,
      "end_ms": 75645,
      "text": "他自己也饿，",
      "token_start": 288,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 76210,
      "end_ms": 78205,
      "text": "饿的两条腿肿的发亮，",
      "token_start": 293,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 78880,
      "end_ms": 81265,
      "text": "用手指头一按就是一个坑，",
      "token_start": 302,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 81800,
      "end_ms": 83865,
      "text": "好半天才能慢慢鼓回来，",
      "token_start": 313,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 84190,
      "end_ms": 85785,
      "text": "那是饿出来的浮肿。",
      "token_start": 323,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 86640,
      "end_ms": 88205,
      "text": "后来在记者采访时，",
      "token_start": 331,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 88530,
      "end_ms": 90625,
      "text": "他讲了一件让人非常痛心的事，",
      "token_start": 339,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 90930,
      "end_ms": 93155,
      "text": "说他看见一个母亲抱着孩子，",
      "token_start": 352,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 93550,
      "end_ms": 94815,
      "text": "孩子已经没气了，",
      "token_start": 364,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 95280,
      "end_ms": 97745,
      "text": "母亲还在往孩子嘴里塞东西。",
      "token_start": 371,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 98220,
      "end_ms": 98540,
      "text": "他说，",
      "token_start": 383,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 98540,
      "end_ms": 98960,
      "text": "那一刻，",
      "token_start": 385,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 98960,
      "end_ms": 101440,
      "text": "他站在田埂上浑身发抖，",
      "token_start": 388,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 101620,
      "end_ms": 103125,
      "text": "心里只有一个念头。",
      "token_start": 398,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 103580,
      "end_ms": 104195,
      "text": "袁隆平，",
      "token_start": 406,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 104730,
      "end_ms": 107570,
      "text": "你这辈子要是不让中国人吃饱饭，",
      "token_start": 409,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 107870,
      "end_ms": 108985,
      "text": "你就是个罪人。",
      "token_start": 423,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 109740,
      "end_ms": 110820,
      "text": "就是从那天起，",
      "token_start": 429,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 111080,
      "end_ms": 112635,
      "text": "他开始跟自己死磕，",
      "token_start": 435,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 113570,
      "end_ms": 115995,
      "text": "可你知道当时的科学界怎么看他吗？",
      "token_start": 443,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 116560,
      "end_ms": 117060,
      "text": "他们说，",
      "token_start": 458,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 117060,
      "end_ms": 121340,
      "text": "水稻是自花授粉植物杂交育种，",
      "token_start": 461,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 121380,
      "end_ms": 122940,
      "text": "根本不可能成功。",
      "token_start": 474,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 123420,
      "end_ms": 125640,
      "text": "这是写进教科书的定论，",
      "token_start": 481,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 126140,
      "end_ms": 128400,
      "text": "是全世界农业科学家的共识。",
      "token_start": 491,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 129020,
      "end_ms": 132520,
      "text": "一个小小的农校老师想推翻这个，",
      "token_start": 503,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 132680,
      "end_ms": 134320,
      "text": "简直是异想天开。",
      "token_start": 517,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 134760,
      "end_ms": 136060,
      "text": "袁隆平偏不信，",
      "token_start": 524,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 136240,
      "end_ms": 136660,
      "text": "他说，",
      "token_start": 530,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 136960,
      "end_ms": 139580,
      "text": "书本上的结论都是前人做不来，",
      "token_start": 532,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 139920,
      "end_ms": 141080,
      "text": "前人做不到，",
      "token_start": 545,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 141240,
      "end_ms": 142620,
      "text": "不代表后人做不到。",
      "token_start": 550,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 143480,
      "end_ms": 145500,
      "text": "没有实验室没有经费，",
      "token_start": 558,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 145840,
      "end_ms": 147600,
      "text": "他就一个人扎进稻田，",
      "token_start": 567,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 148120,
      "end_ms": 156490,
      "text": "像个农民一样逐竹竹竹穗的找找什么找那种天然雄性不育珠，",
      "token_start": 576,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 156910,
      "end_ms": 160670,
      "text": "也就是不能自我授粉的特殊水稻。",
      "token_start": 602,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 161570,
      "end_ms": 164630,
      "text": "水稻只在正午短短几十分钟开花，",
      "token_start": 616,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 165130,
      "end_ms": 165950,
      "text": "错过一秒，",
      "token_start": 630,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 166129,
      "end_ms": 167250,
      "text": "当天就白费。",
      "token_start": 634,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 168170,
      "end_ms": 169110,
      "text": "整整两年，",
      "token_start": 639,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 169390,
      "end_ms": 172170,
      "text": "他每天顶着日头最毒的时候，",
      "token_start": 643,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 172230,
      "end_ms": 174130,
      "text": "泡在田里脊背，",
      "token_start": 655,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 174390,
      "end_ms": 175870,
      "text": "晒得层层脱皮，",
      "token_start": 661,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 176070,
      "end_ms": 178510,
      "text": "稻叶滑的满腿都是血口子，",
      "token_start": 667,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 178910,
      "end_ms": 180315,
      "text": "眼睛看花花了，",
      "token_start": 678,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 180550,
      "end_ms": 181350,
      "text": "看到流泪，",
      "token_start": 684,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 181690,
      "end_ms": 183190,
      "text": "看到肿的睁不开，",
      "token_start": 688,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 183490,
      "end_ms": 184890,
      "text": "就蹲在泥水里，",
      "token_start": 695,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 184890,
      "end_ms": 187585,
      "text": "用手指一朵一朵扒拉着摸着找。",
      "token_start": 701,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 189010,
      "end_ms": 190095,
      "text": "整整两年，",
      "token_start": 714,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 190580,
      "end_ms": 195560,
      "text": "他硬生生看遍了十四万株稻穗十四万次，",
      "token_start": 718,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 195560,
      "end_ms": 197575,
      "text": "低头十四万次失望。",
      "token_start": 735,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 198150,
      "end_ms": 198610,
      "text": "最后，",
      "token_start": 743,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 198930,
      "end_ms": 200090,
      "text": "偌大的田野里，",
      "token_start": 745,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 200090,
      "end_ms": 201245,
      "text": "只找到六株，",
      "token_start": 751,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 201540,
      "end_ms": 204035,
      "text": "就是这微不足道的六株小苗，",
      "token_start": 756,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 204690,
      "end_ms": 207025,
      "text": "后来推翻了全世界的定论，",
      "token_start": 768,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 207380,
      "end_ms": 211035,
      "text": "把亿万中国人从要饿死的边缘拉了回来。",
      "token_start": 779,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 211990,
      "end_ms": 215050,
      "text": "可你以为找到这六株就熬出头了，",
      "token_start": 796,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 215190,
      "end_ms": 217765,
      "text": "命运从来不会轻易放过一个人。",
      "token_start": 810,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 218370,
      "end_ms": 222255,
      "text": "就在他把这六株秧苗小心翼翼培育到七百多株，",
      "token_start": 823,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 222940,
      "end_ms": 226275,
      "text": "眼看着希望越来越大的时候出事了。",
      "token_start": 843,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 226890,
      "end_ms": 227870,
      "text": "那天清晨，",
      "token_start": 858,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 227870,
      "end_ms": 229030,
      "text": "他冲到试验田，",
      "token_start": 862,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 229090,
      "end_ms": 232555,
      "text": "整个人都僵住了七百多株秧苗啊，",
      "token_start": 868,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 232890,
      "end_ms": 236230,
      "text": "一夜之间被人连根拔光整片田，",
      "token_start": 882,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 236330,
      "end_ms": 238695,
      "text": "光秃秃的满地都是脚印，",
      "token_start": 895,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 239340,
      "end_ms": 240505,
      "text": "四年的心血，",
      "token_start": 905,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 240790,
      "end_ms": 241785,
      "text": "全部的数据，",
      "token_start": 910,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 242190,
      "end_ms": 244545,
      "text": "所有的希望一夜归零。",
      "token_start": 915,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 245450,
      "end_ms": 246915,
      "text": "四十岁的大男人，",
      "token_start": 924,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 247670,
      "end_ms": 249790,
      "text": "蹲在空无一人的田埂上，",
      "token_start": 931,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 249870,
      "end_ms": 251055,
      "text": "哭得撕心裂肺，",
      "token_start": 941,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 251420,
      "end_ms": 252220,
      "text": "没人道歉，",
      "token_start": 947,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 252500,
      "end_ms": 253460,
      "text": "没人追责，",
      "token_start": 951,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 253640,
      "end_ms": 254635,
      "text": "没人安慰，",
      "token_start": 955,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 255200,
      "end_ms": 257245,
      "text": "所有人都等着看他认输。",
      "token_start": 959,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 257550,
      "end_ms": 258405,
      "text": "看他倒下，",
      "token_start": 969,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 258790,
      "end_ms": 259470,
      "text": "他没有倒，",
      "token_start": 973,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 259670,
      "end_ms": 260775,
      "text": "也没有放弃，",
      "token_start": 977,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 261110,
      "end_ms": 262525,
      "text": "疯了一样的四处找，",
      "token_start": 982,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 263010,
      "end_ms": 264375,
      "text": "找了整整四天，",
      "token_start": 990,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 265000,
      "end_ms": 268345,
      "text": "最后在学校一口废弃的烂水井里，",
      "token_start": 996,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 268720,
      "end_ms": 271615,
      "text": "摸到了五株奄奄一息的秧苗，",
      "token_start": 1010,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 272120,
      "end_ms": 274600,
      "text": "就靠着这五株快要枯死的稻苗，",
      "token_start": 1022,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 275120,
      "end_ms": 276285,
      "text": "他擦干眼泪，",
      "token_start": 1035,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 276750,
      "end_ms": 277895,
      "text": "从头再来。",
      "token_start": 1040,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 278470,
      "end_ms": 278760,
      "text": "嗯，",
      "token_start": 1044,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 278970,
      "end_ms": 280615,
      "text": "这事到底是谁干的？",
      "token_start": 1045,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 281920,
      "end_ms": 282780,
      "text": "后来查了，",
      "token_start": 1053,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 282780,
      "end_ms": 284015,
      "text": "至今也没查出来，",
      "token_start": 1057,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 285230,
      "end_ms": 288255,
      "text": "干这件事儿的人到今天都没站出来。",
      "token_start": 1064,
      "token_end_exclusive": 1079
    },
    {
      "start_ms": 288960,
      "end_ms": 291495,
      "text": "像这样的事儿他一干就是十几年。",
      "token_start": 1079,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 292430,
      "end_ms": 294605,
      "text": "这十几年里他经历了什么？",
      "token_start": 1093,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 295570,
      "end_ms": 298345,
      "text": "中国人的饭碗到底是怎么端牢的？",
      "token_start": 1104,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 298880,
      "end_ms": 301645,
      "text": "点个关注点个赞。",
      "token_start": 1118,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 301970,
      "end_ms": 302245,
      "text": "嗯，",
      "token_start": 1125,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 302600,
      "end_ms": 303440,
      "text": "收藏起来，",
      "token_start": 1126,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 303700,
      "end_ms": 305465,
      "text": "转发给身边的亲人。",
      "token_start": 1130,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 306480,
      "end_ms": 308235,
      "text": "评论区留下一句元老，",
      "token_start": 1138,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 309260,
      "end_ms": 316385,
      "text": "我们记得您让更多人知道这五株秧苗背后的故事。",
      "token_start": 1147,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 316930,
      "end_ms": 318565,
      "text": "下集我接着讲。",
      "token_start": 1168,
      "token_end_exclusive": 1174
    }
  ],
