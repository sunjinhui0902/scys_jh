{
  "video_id": "v_cf0219a18522dec5",
  "duration_s": 494.678889,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_cf0219a18522dec5.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_cf0219a18522dec5.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 230,
      "end_ms": 730,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 730,
      "end_ms": 1430,
      "text": "咱们盘了，",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1430,
      "end_ms": 2790,
      "text": "第十到第六，",
      "token_start": 6,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3330,
      "end_ms": 5130,
      "text": "秦朝丢了五十万，",
      "token_start": 11,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5630,
      "end_ms": 7350,
      "text": "宋朝丢了一百万，",
      "token_start": 18,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 7890,
      "end_ms": 9790,
      "text": "宋朝丢了八十万，",
      "token_start": 25,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 10090,
      "end_ms": 11770,
      "text": "汉朝丢了两百万，",
      "token_start": 32,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 12210,
      "end_ms": 14530,
      "text": "西晋丢了两百五十万。",
      "token_start": 39,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 15150,
      "end_ms": 17390,
      "text": "好多朋友看完在评论区炒翻了。",
      "token_start": 48,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 17510,
      "end_ms": 19910,
      "text": "有人说唐朝呢明朝呢，",
      "token_start": 61,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 20050,
      "end_ms": 21350,
      "text": "清朝呢别急，",
      "token_start": 70,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 21710,
      "end_ms": 23850,
      "text": "今天这集就是第五道第一，",
      "token_start": 75,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 24050,
      "end_ms": 24990,
      "text": "一个比一个狠。",
      "token_start": 86,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25330,
      "end_ms": 27930,
      "text": "最后那个只统一了五十一年，",
      "token_start": 92,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 28290,
      "end_ms": 30000,
      "text": "就把整个北方丢光了，",
      "token_start": 104,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 30620,
      "end_ms": 32440,
      "text": "还让中国分裂了三百年。",
      "token_start": 113,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 32960,
      "end_ms": 33640,
      "text": "老规矩，",
      "token_start": 123,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 33740,
      "end_ms": 34600,
      "text": "开讲之前，",
      "token_start": 126,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 34760,
      "end_ms": 36640,
      "text": "麻烦您扣个一点个红心，",
      "token_start": 130,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 36940,
      "end_ms": 40220,
      "text": "让我看看都是谁在听第五名，",
      "token_start": 140,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 40480,
      "end_ms": 42260,
      "text": "清朝嘉庆年间，",
      "token_start": 152,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 42680,
      "end_ms": 46680,
      "text": "清朝疆域达到一千三百一十六万平方公里，",
      "token_start": 158,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 47080,
      "end_ms": 50160,
      "text": "是仅次于元朝的最大版图，",
      "token_start": 176,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 50740,
      "end_ms": 52560,
      "text": "可从一八五八年开始，",
      "token_start": 187,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 53100,
      "end_ms": 54400,
      "text": "沙俄趁火打劫，",
      "token_start": 196,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 54860,
      "end_ms": 57400,
      "text": "逼着清政府签了混条约，",
      "token_start": 202,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 57860,
      "end_ms": 60615,
      "text": "割走了黑龙江以北六十万平平方公里。",
      "token_start": 212,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 61170,
      "end_ms": 61915,
      "text": "两年后，",
      "token_start": 228,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 62330,
      "end_ms": 64580,
      "text": "北京条约又割走了。",
      "token_start": 231,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 64740,
      "end_ms": 68225,
      "text": "乌苏里江以东四十万平方公里，",
      "token_start": 239,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 68550,
      "end_ms": 69465,
      "text": "包括库叶岛，",
      "token_start": 252,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 70050,
      "end_ms": 72545,
      "text": "一八六四年堪分西北界约记。",
      "token_start": 257,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 73120,
      "end_ms": 76400,
      "text": "巴尔喀什湖以东以南四十四万平方公里，",
      "token_start": 269,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 76400,
      "end_ms": 76855,
      "text": "没了。",
      "token_start": 286,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 77400,
      "end_ms": 79535,
      "text": "从一八五八年到一九四六年，",
      "token_start": 288,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 80130,
      "end_ms": 84595,
      "text": "沙俄和苏联一共隔走了中国一百七十万平方公里，",
      "token_start": 300,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 85210,
      "end_ms": 87195,
      "text": "加上策动外蒙古独立，",
      "token_start": 321,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 87710,
      "end_ms": 90045,
      "text": "一共三百三十万平方公里，",
      "token_start": 330,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 90350,
      "end_ms": 91805,
      "text": "脱离了中国的怀抱，",
      "token_start": 341,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 92460,
      "end_ms": 95565,
      "text": "占清朝全盛时期领土的四分之一。",
      "token_start": 349,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 96400,
      "end_ms": 103480,
      "text": "可清朝丢的不只是沙俄、英国、法国、德国、日本都来咬一口，",
      "token_start": 363,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 103640,
      "end_ms": 105580,
      "text": "签了三百多个不平等条约，",
      "token_start": 386,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 105700,
      "end_ms": 106504,
      "text": "丢了台湾，",
      "token_start": 397,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 106780,
      "end_ms": 107525,
      "text": "丢了香港，",
      "token_start": 401,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 107750,
      "end_ms": 108315,
      "text": "丢了澳门。",
      "token_start": 405,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 108810,
      "end_ms": 110875,
      "text": "可为什么清朝只排第五？",
      "token_start": 409,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 111400,
      "end_ms": 113375,
      "text": "因为清朝虽然丢的多，",
      "token_start": 419,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 113790,
      "end_ms": 115460,
      "text": "但他的底子大丢了，",
      "token_start": 428,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 115460,
      "end_ms": 117365,
      "text": "三百多万还剩九百多万，",
      "token_start": 436,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 117910,
      "end_ms": 120950,
      "text": "不像有些朝代丢了就真的没了。",
      "token_start": 446,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 121030,
      "end_ms": 121755,
      "text": "第四名，",
      "token_start": 459,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 122030,
      "end_ms": 126495,
      "text": "元朝元朝是中国历史上疆域最大的朝代，",
      "token_start": 462,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 127400,
      "end_ms": 128380,
      "text": "鼎盛时期，",
      "token_start": 479,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 128560,
      "end_ms": 131345,
      "text": "一千三百七十五万平方公里，",
      "token_start": 483,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 131850,
      "end_ms": 133745,
      "text": "可元朝也是丢的最快的。",
      "token_start": 495,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 134150,
      "end_ms": 136235,
      "text": "从忽必烈死后的几十年里，",
      "token_start": 505,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 136650,
      "end_ms": 139195,
      "text": "元朝内部皇位争夺不断，",
      "token_start": 516,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 139570,
      "end_ms": 140445,
      "text": "不到四十年，",
      "token_start": 526,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 140710,
      "end_ms": 141870,
      "text": "换了九个皇帝，",
      "token_start": 531,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 141990,
      "end_ms": 143685,
      "text": "国力迅速衰落。",
      "token_start": 537,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 144670,
      "end_ms": 148505,
      "text": "中亚和西域的诸韩国逐渐脱离了元朝的控制，",
      "token_start": 543,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 149370,
      "end_ms": 152095,
      "text": "西部大片领土名存实亡。",
      "token_start": 562,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 153020,
      "end_ms": 153885,
      "text": "元朝末年，",
      "token_start": 572,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 154150,
      "end_ms": 155305,
      "text": "农民起义遍地，",
      "token_start": 576,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 156760,
      "end_ms": 159815,
      "text": "朱元璋北伐元顺帝逃回草原。",
      "token_start": 582,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 160230,
      "end_ms": 162250,
      "text": "元朝在全国的统治结束，",
      "token_start": 594,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 162650,
      "end_ms": 164265,
      "text": "从统一到灭亡，",
      "token_start": 604,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 164530,
      "end_ms": 165525,
      "text": "不到一百年，",
      "token_start": 610,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 165910,
      "end_ms": 168165,
      "text": "丢掉了将近四百万平方公里。",
      "token_start": 615,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 168520,
      "end_ms": 170395,
      "text": "您说这是大还是虚？",
      "token_start": 627,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 171000,
      "end_ms": 175875,
      "text": "我前阵子翻到一本叫中华文化常识一千问的书。",
      "token_start": 635,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 176710,
      "end_ms": 181180,
      "text": "这本书把中国历史上的文化常识分门别类，",
      "token_start": 655,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 181180,
      "end_ms": 182405,
      "text": "讲的清清楚楚。",
      "token_start": 673,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 182740,
      "end_ms": 184455,
      "text": "从三皇五帝到明清，",
      "token_start": 679,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 184860,
      "end_ms": 186960,
      "text": "从政治经济到科技文化，",
      "token_start": 687,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 187200,
      "end_ms": 189495,
      "text": "一千个问题一千个答案，",
      "token_start": 697,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 189720,
      "end_ms": 193005,
      "text": "咱们这几集讲的这些朝代丢了多少地，",
      "token_start": 707,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 193360,
      "end_ms": 194545,
      "text": "签了什么条约，",
      "token_start": 723,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 194900,
      "end_ms": 196905,
      "text": "为什么丢的书里都有？",
      "token_start": 729,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 197300,
      "end_ms": 199625,
      "text": "他不是那种干巴巴的教科书，",
      "token_start": 738,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 200040,
      "end_ms": 201915,
      "text": "是一问一答的形式。",
      "token_start": 750,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 202310,
      "end_ms": 203090,
      "text": "翻到哪页，",
      "token_start": 758,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 203090,
      "end_ms": 203765,
      "text": "看哪页，",
      "token_start": 762,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 204220,
      "end_ms": 205955,
      "text": "特别适合中老年朋友，",
      "token_start": 765,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 206480,
      "end_ms": 207755,
      "text": "每天翻两页。",
      "token_start": 774,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 208140,
      "end_ms": 208960,
      "text": "一年下来，",
      "token_start": 779,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 209180,
      "end_ms": 212635,
      "text": "中国历史的基本脉络心里全有谱了。",
      "token_start": 783,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 213010,
      "end_ms": 214165,
      "text": "我已经放下面了，",
      "token_start": 798,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 214320,
      "end_ms": 217445,
      "text": "点开就能看到喜欢历史的朋友，",
      "token_start": 805,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 217670,
      "end_ms": 219435,
      "text": "弄一本放床头，",
      "token_start": 818,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 219850,
      "end_ms": 222335,
      "text": "随手翻一页就是一段历史。",
      "token_start": 824,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 223010,
      "end_ms": 223645,
      "text": "第三名，",
      "token_start": 835,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 223970,
      "end_ms": 226290,
      "text": "唐朝安史之乱以前，",
      "token_start": 838,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 226750,
      "end_ms": 229975,
      "text": "唐朝是一千二百三十七万平方公里，",
      "token_start": 846,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 230520,
      "end_ms": 231720,
      "text": "安史之乱以后，",
      "token_start": 861,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 231940,
      "end_ms": 232875,
      "text": "一切都变了。",
      "token_start": 867,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 233150,
      "end_ms": 233965,
      "text": "为了评判，",
      "token_start": 872,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 234730,
      "end_ms": 239995,
      "text": "唐肃宗把河西弄右西域的精兵全部东掉，",
      "token_start": 876,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 240440,
      "end_ms": 242115,
      "text": "吐蕃趁虚而入，",
      "token_start": 893,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 242480,
      "end_ms": 243785,
      "text": "河西走廊丢了，",
      "token_start": 899,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 244040,
      "end_ms": 244805,
      "text": "龙又丢了。",
      "token_start": 905,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 245420,
      "end_ms": 248110,
      "text": "安溪四镇丢了吐蕃，",
      "token_start": 909,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 248110,
      "end_ms": 251180,
      "text": "统治敦煌整整七十年河西，",
      "token_start": 917,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 251180,
      "end_ms": 257085,
      "text": "五郡凉州甘州宿州瓜州沙洲一个一个陷落，",
      "token_start": 928,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 257940,
      "end_ms": 261265,
      "text": "史书上写此去安息万里江，",
      "token_start": 946,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 262090,
      "end_ms": 264045,
      "text": "如今边防在奉翔。",
      "token_start": 957,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 264360,
      "end_ms": 264995,
      "text": "什么意思？",
      "token_start": 964,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 265370,
      "end_ms": 268365,
      "text": "以前安西都护府在万里之外，",
      "token_start": 968,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 268880,
      "end_ms": 270555,
      "text": "现在边防退到了凤翔，",
      "token_start": 980,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 271060,
      "end_ms": 272285,
      "text": "离长安没多远了。",
      "token_start": 989,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 272700,
      "end_ms": 273980,
      "text": "唐朝中后期，",
      "token_start": 996,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 274280,
      "end_ms": 279395,
      "text": "西域、河西走廊、辽东大片领土相继丢失，",
      "token_start": 1001,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 280040,
      "end_ms": 282965,
      "text": "总湿地面积超过六百万平方公里。",
      "token_start": 1017,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 283630,
      "end_ms": 285395,
      "text": "一个万国来朝的大唐，",
      "token_start": 1031,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 285900,
      "end_ms": 289515,
      "text": "最后连自己的都城都被吐蕃攻陷过。",
      "token_start": 1040,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 290410,
      "end_ms": 293405,
      "text": "您说这是安史之乱还是盛极而衰？",
      "token_start": 1055,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 294740,
      "end_ms": 295285,
      "text": "第二名，",
      "token_start": 1069,
      "token_end_exclusive": 1072
    },
    {
      "start_ms": 296410,
      "end_ms": 298285,
      "text": "明朝永乐年间，",
      "token_start": 1072,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 298630,
      "end_ms": 300345,
      "text": "大明版图达到最大。",
      "token_start": 1078,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 301330,
      "end_ms": 303890,
      "text": "一千一百万平方公里，",
      "token_start": 1086,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 304830,
      "end_ms": 307250,
      "text": "可到了崇祯皇帝自杀的时候，",
      "token_start": 1095,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 307570,
      "end_ms": 312930,
      "text": "明朝实际控制的只剩汉地十八省四百多万平方公里，",
      "token_start": 1107,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 313370,
      "end_ms": 316210,
      "text": "丢掉了将近七百万平方公里。",
      "token_start": 1129,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 316510,
      "end_ms": 317350,
      "text": "怎么丢的？",
      "token_start": 1141,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 318150,
      "end_ms": 320230,
      "text": "朱棣为了打靖难之役，",
      "token_start": 1145,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 320610,
      "end_ms": 323470,
      "text": "把大明都司送给了蒙古人，",
      "token_start": 1154,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 323790,
      "end_ms": 326870,
      "text": "宣宗时期开平行内迁，",
      "token_start": 1165,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 327850,
      "end_ms": 337140,
      "text": "整个北平行都司放弃丢套到地区东胜位撤销门户大开关。",
      "token_start": 1174,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 337140,
      "end_ms": 344200,
      "text": "西七位哈密丢了七位百姓迁进嘉峪关土地全被吐鲁番汗国占了，",
      "token_start": 1198,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 344400,
      "end_ms": 345460,
      "text": "乌斯藏朵干，",
      "token_start": 1225,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 345880,
      "end_ms": 348840,
      "text": "青藏高原也丢了云南布政司。",
      "token_start": 1230,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 348840,
      "end_ms": 350240,
      "text": "下面的三圈六卫，",
      "token_start": 1242,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 350640,
      "end_ms": 352160,
      "text": "缅甸占了泰国，",
      "token_start": 1249,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 352160,
      "end_ms": 353420,
      "text": "占了明朝，",
      "token_start": 1255,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 353440,
      "end_ms": 354540,
      "text": "号称不和亲，",
      "token_start": 1259,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 354740,
      "end_ms": 355440,
      "text": "不纳贡，",
      "token_start": 1264,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 355660,
      "end_ms": 357240,
      "text": "不成臣不割地，",
      "token_start": 1267,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 357900,
      "end_ms": 360565,
      "text": "可实际上丢的地比谁都多。",
      "token_start": 1273,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 361160,
      "end_ms": 361725,
      "text": "第一名，",
      "token_start": 1284,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 362100,
      "end_ms": 363235,
      "text": "西晋等等，",
      "token_start": 1287,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 364270,
      "end_ms": 365975,
      "text": "西晋不是第六名吗？",
      "token_start": 1291,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 366340,
      "end_ms": 366685,
      "text": "对，",
      "token_start": 1299,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 367240,
      "end_ms": 371195,
      "text": "第六名是西晋丢掉的北方领土。",
      "token_start": 1300,
      "token_end_exclusive": 1313
    },
    {
      "start_ms": 371750,
      "end_ms": 375540,
      "text": "我说的第一名是西晋从统一到灭亡，",
      "token_start": 1313,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 375620,
      "end_ms": 377025,
      "text": "丢掉的全部领土。",
      "token_start": 1328,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 377680,
      "end_ms": 379555,
      "text": "西晋统一三国的时候，",
      "token_start": 1335,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 379930,
      "end_ms": 382605,
      "text": "疆域五百四十多万平方公里，",
      "token_start": 1344,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 383510,
      "end_ms": 387565,
      "text": "可西晋是历史上最短命的大一统王朝之一。",
      "token_start": 1356,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 388150,
      "end_ms": 389445,
      "text": "从统一到灭亡，",
      "token_start": 1374,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 389750,
      "end_ms": 390765,
      "text": "只用了五十一年，",
      "token_start": 1380,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 391260,
      "end_ms": 392695,
      "text": "八王之乱打了十六年，",
      "token_start": 1387,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 393540,
      "end_ms": 395395,
      "text": "把自己人打的精疲力尽。",
      "token_start": 1396,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 396390,
      "end_ms": 397365,
      "text": "北方的匈奴，",
      "token_start": 1406,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 397880,
      "end_ms": 400540,
      "text": "鲜卑节将五个少数民族，",
      "token_start": 1411,
      "token_end_exclusive": 1421
    },
    {
      "start_ms": 400540,
      "end_ms": 402955,
      "text": "趁乱南下永嘉之乱。",
      "token_start": 1421,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 403440,
      "end_ms": 404295,
      "text": "洛阳丢了，",
      "token_start": 1429,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 404640,
      "end_ms": 405580,
      "text": "长安丢了，",
      "token_start": 1433,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 405700,
      "end_ms": 406675,
      "text": "西晋灭亡，",
      "token_start": 1437,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 407030,
      "end_ms": 408395,
      "text": "北方全部沦陷。",
      "token_start": 1441,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 408940,
      "end_ms": 410415,
      "text": "东晋退到江南，",
      "token_start": 1447,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 410640,
      "end_ms": 412415,
      "text": "只剩三百来万平方公里。",
      "token_start": 1453,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 412960,
      "end_ms": 416355,
      "text": "西晋丢掉了北方将近两百五十万平方公里。",
      "token_start": 1463,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 417020,
      "end_ms": 419595,
      "text": "可惜晋丢掉的不只是土地，",
      "token_start": 1481,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 419990,
      "end_ms": 422025,
      "text": "是整个北方是中原，",
      "token_start": 1492,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 422650,
      "end_ms": 423375,
      "text": "是长安，",
      "token_start": 1500,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 423640,
      "end_ms": 424295,
      "text": "是洛阳，",
      "token_start": 1503,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 424660,
      "end_ms": 425360,
      "text": "是汉人。",
      "token_start": 1506,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 425400,
      "end_ms": 427305,
      "text": "几百年来经营的家底。",
      "token_start": 1509,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 427920,
      "end_ms": 428780,
      "text": "从此以后，",
      "token_start": 1518,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 428980,
      "end_ms": 431715,
      "text": "中国南北分裂了将近三百年，",
      "token_start": 1522,
      "token_end_exclusive": 1534
    },
    {
      "start_ms": 432250,
      "end_ms": 433795,
      "text": "别的朝代丢了地，",
      "token_start": 1534,
      "token_end_exclusive": 1541
    },
    {
      "start_ms": 434850,
      "end_ms": 436350,
      "text": "后来还收回来。",
      "token_start": 1541,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 436350,
      "end_ms": 438225,
      "text": "一些西晋丢了地，",
      "token_start": 1547,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 439070,
      "end_ms": 441245,
      "text": "直接导致了五胡乱华，",
      "token_start": 1554,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 441650,
      "end_ms": 442715,
      "text": "导致了南北朝，",
      "token_start": 1563,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 443450,
      "end_ms": 447635,
      "text": "导致了中国历史上最长的一段分裂时期。",
      "token_start": 1569,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 447900,
      "end_ms": 450145,
      "text": "您说这个第一名服不服？",
      "token_start": 1586,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 450490,
      "end_ms": 451525,
      "text": "您听出来了没有？",
      "token_start": 1596,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 452030,
      "end_ms": 458685,
      "text": "这十个朝代没有一个是因为弱才排上来的秦朝毁在统一太短，",
      "token_start": 1603,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 459210,
      "end_ms": 461305,
      "text": "隋朝败在操之过急，",
      "token_start": 1629,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 461820,
      "end_ms": 464445,
      "text": "宋朝栽在重文轻武，",
      "token_start": 1637,
      "token_end_exclusive": 1645
    },
    {
      "start_ms": 464750,
      "end_ms": 466715,
      "text": "汉朝坏在后期失控，",
      "token_start": 1645,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 467240,
      "end_ms": 469515,
      "text": "戚晋死在自家人打自家人，",
      "token_start": 1653,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 469980,
      "end_ms": 472945,
      "text": "清朝亏在签了三百多个不平等条约。",
      "token_start": 1664,
      "token_end_exclusive": 1679
    },
    {
      "start_ms": 473500,
      "end_ms": 475845,
      "text": "元朝乱在皇位争夺，",
      "token_start": 1679,
      "token_end_exclusive": 1687
    },
    {
      "start_ms": 476290,
      "end_ms": 478145,
      "text": "唐朝垮在安史之乱，",
      "token_start": 1687,
      "token_end_exclusive": 1695
    },
    {
      "start_ms": 478590,
      "end_ms": 480745,
      "text": "明朝错在主动放弃。",
      "token_start": 1695,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 481390,
      "end_ms": 481830,
      "text": "西晋，",
      "token_start": 1703,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 481830,
      "end_ms": 484890,
      "text": "痛在直接导致三百年分裂。",
      "token_start": 1705,
      "token_end_exclusive": 1716
    },
    {
      "start_ms": 485370,
      "end_ms": 489650,
      "text": "每一个朝代丢掉的领土都不只是一串数字，",
      "token_start": 1716,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 490030,
      "end_ms": 491090,
      "text": "是一段教训，",
      "token_start": 1734,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 491930,
      "end_ms": 492750,
      "text": "点个关注，",
      "token_start": 1739,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 492950,
      "end_ms": 494545,
      "text": "咱们下期接着聊。",
      "token_start": 1743,
      "token_end_exclusive": 1750
    }
  ],
