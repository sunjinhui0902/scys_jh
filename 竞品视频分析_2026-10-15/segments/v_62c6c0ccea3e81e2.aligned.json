  "segments": [
    {
      "start_ms": 1980,
      "end_ms": 3760,
      "text": "来这么晚只能吃剩菜了吧，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 4120,
      "end_ms": 6100,
      "text": "领导饭在哪儿我都能吃，",
      "token_start": 11,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 6460,
      "end_ms": 8500,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 21,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 8580,
      "end_ms": 10280,
      "text": "能赶上已经是我的运气了，",
      "token_start": 34,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12260,
      "end_ms": 13520,
      "text": "这藕是好藕啊，",
      "token_start": 45,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 13860,
      "end_ms": 15180,
      "text": "就是心眼太多了。",
      "token_start": 51,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 15840,
      "end_ms": 17700,
      "text": "领导藕虽然心眼多，",
      "token_start": 58,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 17780,
      "end_ms": 19020,
      "text": "但是您的下酒菜多，",
      "token_start": 66,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 22120,
      "end_ms": 22980,
      "text": "鱼是好鱼，",
      "token_start": 74,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 23100,
      "end_ms": 24220,
      "text": "可惜就是刺多。",
      "token_start": 78,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 24400,
      "end_ms": 24700,
      "text": "领导，",
      "token_start": 84,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 24700,
      "end_ms": 25060,
      "text": "您看，",
      "token_start": 86,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 25500,
      "end_ms": 26500,
      "text": "鱼虽然刺多，",
      "token_start": 88,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 26660,
      "end_ms": 30455,
      "text": "但主心骨只有一根心腹是没有刺的。",
      "token_start": 93,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 32200,
      "end_ms": 32640,
      "text": "小李，",
      "token_start": 108,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 32920,
      "end_ms": 34600,
      "text": "你这菜点的也太多了，",
      "token_start": 110,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 34880,
      "end_ms": 36520,
      "text": "领导菜点的再多，",
      "token_start": 119,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 36520,
      "end_ms": 38140,
      "text": "也比不上平时您对我的照顾。",
      "token_start": 126,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 38140,
      "end_ms": 39040,
      "text": "多这杯酒，",
      "token_start": 138,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 39040,
      "end_ms": 42860,
      "text": "我先敬您打这么多饭，",
      "token_start": 142,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 42860,
      "end_ms": 43520,
      "text": "你喂猪呢？",
      "token_start": 151,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 43880,
      "end_ms": 44240,
      "text": "领导，",
      "token_start": 155,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 44240,
      "end_ms": 44960,
      "text": "我哪敢啊？",
      "token_start": 157,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 45120,
      "end_ms": 47340,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 161,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 47500,
      "end_ms": 48960,
      "text": "都说宰相肚里能撑船，",
      "token_start": 177,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 49080,
      "end_ms": 50460,
      "text": "更何况只是一碗饭呢。",
      "token_start": 186,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 52200,
      "end_ms": 52440,
      "text": "哎，",
      "token_start": 195,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 52620,
      "end_ms": 53580,
      "text": "你什么意思啊？",
      "token_start": 196,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 53740,
      "end_ms": 55260,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 202,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 55400,
      "end_ms": 56620,
      "text": "领导美满美满，",
      "token_start": 213,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 56860,
      "end_ms": 57940,
      "text": "代表幸福美满，",
      "token_start": 219,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 58240,
      "end_ms": 59200,
      "text": "这辈子美满，",
      "token_start": 225,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 59340,
      "end_ms": 61265,
      "text": "就是一辈子美满啊。",
      "token_start": 230,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 63880,
      "end_ms": 65155,
      "text": "你酒量挺好的呀，",
      "token_start": 238,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 65520,
      "end_ms": 66980,
      "text": "领导您可抬举我了，",
      "token_start": 245,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 66980,
      "end_ms": 68245,
      "text": "我平时真不太能喝。",
      "token_start": 253,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 68540,
      "end_ms": 70020,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 261,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 70020,
      "end_ms": 70520,
      "text": "高兴啊，",
      "token_start": 272,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 70540,
      "end_ms": 72055,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 275,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 72430,
      "end_ms": 75585,
      "text": "哈哈哈哈哈哈哈不喝就是看不起我。",
      "token_start": 285,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 75770,
      "end_ms": 76185,
      "text": "领导，",
      "token_start": 300,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 76450,
      "end_ms": 77490,
      "text": "我不是看不起您，",
      "token_start": 302,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 77730,
      "end_ms": 78675,
      "text": "我是看不起病，",
      "token_start": 309,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 79060,
      "end_ms": 79590,
      "text": "哈哈哈。",
      "token_start": 315,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 80050,
      "end_ms": 80645,
      "text": "关注我，",
      "token_start": 318,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 80980,
      "end_ms": 82220,
      "text": "每天学点高情商，",
      "token_start": 321,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 82220,
      "end_ms": 83025,
      "text": "说话技巧，",
      "token_start": 328,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 83320,
      "end_ms": 84795,
      "text": "让你的路越走越宽。",
      "token_start": 332,
      "token_end_exclusive": 340
    }
  ],
