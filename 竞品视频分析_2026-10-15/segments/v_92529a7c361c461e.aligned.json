{
  "video_id": "v_92529a7c361c461e",
  "duration_s": 639.339002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_92529a7c361c461e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_92529a7c361c461e.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 4950,
      "text": "您知道中国历史上最有文化气息的名山都有哪些吗？",
      "token_start": 0,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5630,
      "end_ms": 6210,
      "text": "上集，",
      "token_start": 22,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6230,
      "end_ms": 12370,
      "text": "咱们聊了黄山、雁荡山、天台山、青城山、庐山这集，",
      "token_start": 24,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 12410,
      "end_ms": 13630,
      "text": "直接揭开谜底，",
      "token_start": 43,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 14010,
      "end_ms": 16430,
      "text": "看看前五名深厚到什么程度，",
      "token_start": 49,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 16830,
      "end_ms": 21270,
      "text": "尤其是排在榜首的那座没有皇帝仪仗的大气味，",
      "token_start": 61,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21670,
      "end_ms": 24030,
      "text": "也没有满山庙宇的香火味，",
      "token_start": 81,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 24090,
      "end_ms": 26670,
      "text": "却用一位大先生的学问，",
      "token_start": 92,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 26670,
      "end_ms": 30480,
      "text": "让山里一草一木都有了几摇头。",
      "token_start": 102,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 30880,
      "end_ms": 32800,
      "text": "老规矩开讲之前，",
      "token_start": 115,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 32820,
      "end_ms": 34840,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 122,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 35260,
      "end_ms": 36340,
      "text": "让我看看都是谁。",
      "token_start": 132,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 36340,
      "end_ms": 38900,
      "text": "在听第五名五台山，",
      "token_start": 139,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 39300,
      "end_ms": 41720,
      "text": "山西忻州五台山，",
      "token_start": 147,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 41720,
      "end_ms": 44720,
      "text": "您一定听过中国佛教四大名山。",
      "token_start": 154,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 44940,
      "end_ms": 47100,
      "text": "他排头一个五座台，",
      "token_start": 167,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 47100,
      "end_ms": 49380,
      "text": "顶平平的像五只，",
      "token_start": 175,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 49400,
      "end_ms": 50580,
      "text": "托着天的手掌，",
      "token_start": 182,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 51240,
      "end_ms": 54040,
      "text": "北台夜斗峰三千零六十一米，",
      "token_start": 188,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 54360,
      "end_ms": 55600,
      "text": "是华北屋脊，",
      "token_start": 200,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 56000,
      "end_ms": 58360,
      "text": "相传这里是文殊菩萨的道场。",
      "token_start": 205,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 58980,
      "end_ms": 60855,
      "text": "东汉就有人盖世，",
      "token_start": 217,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 61710,
      "end_ms": 63335,
      "text": "唐朝最盛的时候，",
      "token_start": 224,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 63680,
      "end_ms": 65455,
      "text": "山里三百多座寺院，",
      "token_start": 231,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 66070,
      "end_ms": 67675,
      "text": "今天还有四十多座。",
      "token_start": 239,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 68120,
      "end_ms": 71130,
      "text": "您夏天上山山下热的冒汗，",
      "token_start": 247,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 71470,
      "end_ms": 72310,
      "text": "到了台顶，",
      "token_start": 258,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 72450,
      "end_ms": 75275,
      "text": "凉风一吹才懂他为什么叫清凉山。",
      "token_start": 262,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 75650,
      "end_ms": 77135,
      "text": "山里的南禅寺，",
      "token_start": 276,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 77770,
      "end_ms": 79935,
      "text": "是一座唐朝的木头大殿，",
      "token_start": 282,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 80420,
      "end_ms": 81675,
      "text": "一千两百多年了，",
      "token_start": 292,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 82280,
      "end_ms": 85405,
      "text": "是中国现存最老的木结构建筑。",
      "token_start": 299,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 85870,
      "end_ms": 88775,
      "text": "别处的唐朝早成了书里的字，",
      "token_start": 312,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 89320,
      "end_ms": 91965,
      "text": "这儿的唐朝还稳稳立着，",
      "token_start": 324,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 92330,
      "end_ms": 92670,
      "text": "您说，",
      "token_start": 334,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 92670,
      "end_ms": 93955,
      "text": "这是不是活的历史？",
      "token_start": 336,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 94330,
      "end_ms": 94950,
      "text": "第四名，",
      "token_start": 344,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 95430,
      "end_ms": 97365,
      "text": "嵩山、河南郑州。",
      "token_start": 347,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 97840,
      "end_ms": 100525,
      "text": "很多人以为嵩山就是个练少林武功的地方。",
      "token_start": 353,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 100930,
      "end_ms": 104940,
      "text": "其实他真正厉害的底色是儒释道三家。",
      "token_start": 371,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 105200,
      "end_ms": 107415,
      "text": "在咱们中原府第扎下的老根，",
      "token_start": 387,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 107880,
      "end_ms": 111720,
      "text": "三十六亿年的石头帝制三千多年，",
      "token_start": 399,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 111820,
      "end_ms": 114015,
      "text": "历朝历代祭天的地方，",
      "token_start": 413,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 114460,
      "end_ms": 118845,
      "text": "全国最早的汉朝石阙砖塔全都在这立着。",
      "token_start": 422,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 119320,
      "end_ms": 123780,
      "text": "您要是站在中岳庙又大又红的宫墙和大柏树底下，",
      "token_start": 439,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 124120,
      "end_ms": 126490,
      "text": "脚踩的老砖头耳朵，",
      "token_start": 460,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 126530,
      "end_ms": 129365,
      "text": "听着少林寺远远传来的撞钟声，",
      "token_start": 468,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 129860,
      "end_ms": 133515,
      "text": "闭上眼就能摸到咱们老祖宗那股厚重的脉搏。",
      "token_start": 481,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 133990,
      "end_ms": 138640,
      "text": "少林寺在这开创了禅宗宋朝的大先生们，",
      "token_start": 500,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 138640,
      "end_ms": 141385,
      "text": "在松阳书院摆开桌子讲学，",
      "token_start": 517,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 142150,
      "end_ms": 143125,
      "text": "读书明理，",
      "token_start": 528,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 143520,
      "end_ms": 144540,
      "text": "修心修德，",
      "token_start": 532,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 144900,
      "end_ms": 147015,
      "text": "全在这磨合了上千年，",
      "token_start": 536,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 147800,
      "end_ms": 150660,
      "text": "成了天地当中最稳当的一座文化。",
      "token_start": 545,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 150740,
      "end_ms": 151495,
      "text": "大靠山，",
      "token_start": 559,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 151840,
      "end_ms": 152595,
      "text": "第三名，",
      "token_start": 562,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 152980,
      "end_ms": 154845,
      "text": "武当山湖北十堰。",
      "token_start": 565,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 155840,
      "end_ms": 157925,
      "text": "如果说嵩山是三家同住，",
      "token_start": 572,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 158570,
      "end_ms": 159170,
      "text": "武当山，",
      "token_start": 582,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 159170,
      "end_ms": 161425,
      "text": "就是把整座山修成一座道观。",
      "token_start": 585,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 161840,
      "end_ms": 162620,
      "text": "明朝永乐，",
      "token_start": 597,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 162620,
      "end_ms": 164845,
      "text": "十年朱棣一声令下，",
      "token_start": 601,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 165270,
      "end_ms": 166645,
      "text": "征调三十万人，",
      "token_start": 609,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 167040,
      "end_ms": 167940,
      "text": "修了十二年，",
      "token_start": 615,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 168200,
      "end_ms": 170875,
      "text": "在七十二封之间盖起九宫八卦。",
      "token_start": 620,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 171620,
      "end_ms": 172565,
      "text": "当年有句话，",
      "token_start": 633,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 172940,
      "end_ms": 175510,
      "text": "北建紫禁城难修，",
      "token_start": 638,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 175670,
      "end_ms": 178225,
      "text": "武当主封天柱峰，",
      "token_start": 645,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 178730,
      "end_ms": 182335,
      "text": "一千六百多米峰顶立的一座金殿，",
      "token_start": 652,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 182780,
      "end_ms": 186020,
      "text": "通体铜铸鎏金六百多年。",
      "token_start": 666,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 186020,
      "end_ms": 186575,
      "text": "过去，",
      "token_start": 676,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 187050,
      "end_ms": 190510,
      "text": "雷雨天常被雷火裹住变身，",
      "token_start": 678,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 190730,
      "end_ms": 192690,
      "text": "却一点没坏人们，",
      "token_start": 689,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 192690,
      "end_ms": 194155,
      "text": "叫他雷火练电。",
      "token_start": 696,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 194630,
      "end_ms": 197060,
      "text": "您顺着山路往上公关，",
      "token_start": 702,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 197120,
      "end_ms": 200695,
      "text": "一座接一座藏在悬崖和山坳里，",
      "token_start": 711,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 201060,
      "end_ms": 203225,
      "text": "跟山的形状严丝合缝。",
      "token_start": 724,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 203760,
      "end_ms": 207845,
      "text": "一座山被一个王朝拿国力雕成了一件作品，",
      "token_start": 733,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 208270,
      "end_ms": 211725,
      "text": "您说这气魄当不当得起文化二字？",
      "token_start": 751,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 212160,
      "end_ms": 212815,
      "text": "第二名，",
      "token_start": 765,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 213320,
      "end_ms": 215475,
      "text": "泰山山东泰安。",
      "token_start": 768,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 216250,
      "end_ms": 217205,
      "text": "论名气，",
      "token_start": 774,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 217530,
      "end_ms": 218195,
      "text": "论地位，",
      "token_start": 777,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 218910,
      "end_ms": 221025,
      "text": "很多人以为第一名非他莫属，",
      "token_start": 780,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 221510,
      "end_ms": 222470,
      "text": "五岳之首，",
      "token_start": 792,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 222750,
      "end_ms": 225045,
      "text": "海拔一千五百四十五米，",
      "token_start": 796,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 225390,
      "end_ms": 226245,
      "text": "不算最高。",
      "token_start": 806,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 226840,
      "end_ms": 230040,
      "text": "可从秦始皇开始一代代帝王，",
      "token_start": 810,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 230180,
      "end_ms": 233590,
      "text": "排着队上山封禅汉武帝去了，",
      "token_start": 822,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 233590,
      "end_ms": 235795,
      "text": "好几趟唐玄宗，",
      "token_start": 834,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 236160,
      "end_ms": 237925,
      "text": "宋真宗也都去了。",
      "token_start": 840,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 238360,
      "end_ms": 238940,
      "text": "孔子说，",
      "token_start": 847,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 238960,
      "end_ms": 240855,
      "text": "登太山而小天下。",
      "token_start": 850,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 241300,
      "end_ms": 242200,
      "text": "杜甫望着他，",
      "token_start": 857,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 242260,
      "end_ms": 243925,
      "text": "写下一览众山小，",
      "token_start": 862,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 244360,
      "end_ms": 246415,
      "text": "山上磨牙石刻一千多处，",
      "token_start": 869,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 247280,
      "end_ms": 248900,
      "text": "从山脚到山顶，",
      "token_start": 879,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 249220,
      "end_ms": 250565,
      "text": "六千多级台阶，",
      "token_start": 885,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 251410,
      "end_ms": 253095,
      "text": "您一步一步往上爬。",
      "token_start": 891,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 253850,
      "end_ms": 255145,
      "text": "腿酸的直打颤，",
      "token_start": 899,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 255720,
      "end_ms": 256755,
      "text": "爬到玉皇顶，",
      "token_start": 905,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 257170,
      "end_ms": 257975,
      "text": "日出一漏，",
      "token_start": 910,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 258420,
      "end_ms": 259365,
      "text": "什么泪都忘了，",
      "token_start": 914,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 259830,
      "end_ms": 261615,
      "text": "别的山是拿来看的。",
      "token_start": 920,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 261940,
      "end_ms": 263925,
      "text": "泰山是拿来托付的，",
      "token_start": 928,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 264620,
      "end_ms": 271155,
      "text": "历代人把对天对国、对自己的叛头一块块刻在了山石上。",
      "token_start": 936,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 271550,
      "end_ms": 275095,
      "text": "一座山成了一个民族的精神靠山，",
      "token_start": 959,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 275630,
      "end_ms": 277845,
      "text": "您说这分量重不重？",
      "token_start": 973,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 278280,
      "end_ms": 279955,
      "text": "那第一名到底是哪儿？",
      "token_start": 981,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 280220,
      "end_ms": 280955,
      "text": "先别急，",
      "token_start": 990,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 281630,
      "end_ms": 282355,
      "text": "聊到这儿，",
      "token_start": 993,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 282610,
      "end_ms": 284135,
      "text": "我先唠几句心里话。",
      "token_start": 997,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 284550,
      "end_ms": 287340,
      "text": "我发现经常有朋友留言说，",
      "token_start": 1005,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 287360,
      "end_ms": 288320,
      "text": "年轻时候忙，",
      "token_start": 1016,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 288660,
      "end_ms": 289735,
      "text": "没空出门，",
      "token_start": 1021,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 290300,
      "end_ms": 292100,
      "text": "现在退休有空了，",
      "token_start": 1025,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 292220,
      "end_ms": 293305,
      "text": "想去走走，",
      "token_start": 1032,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 293710,
      "end_ms": 295860,
      "text": "可不知道先去哪儿去了，",
      "token_start": 1036,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 295960,
      "end_ms": 296745,
      "text": "看什么。",
      "token_start": 1046,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 297160,
      "end_ms": 298945,
      "text": "还有朋友说年纪上来了，",
      "token_start": 1049,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 299390,
      "end_ms": 301935,
      "text": "泰山、黄山这样的台阶爬不动，",
      "token_start": 1059,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 302770,
      "end_ms": 304170,
      "text": "有没有不用费劲，",
      "token_start": 1071,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 304210,
      "end_ms": 306105,
      "text": "爬山也能看懂的名声。",
      "token_start": 1078,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 306610,
      "end_ms": 308290,
      "text": "还有带孙子孙女儿的，",
      "token_start": 1087,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 308490,
      "end_ms": 312130,
      "text": "想给孩子讲讲这些山水背后的古人典故，",
      "token_start": 1096,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 312810,
      "end_ms": 313990,
      "text": "可自己也说不全。",
      "token_start": 1113,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 314770,
      "end_ms": 316970,
      "text": "您看咱们这个年纪看景，",
      "token_start": 1120,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 316990,
      "end_ms": 318410,
      "text": "不光是图个热闹，",
      "token_start": 1130,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 318850,
      "end_ms": 321870,
      "text": "更想知道这背后有什么文化讲究。",
      "token_start": 1137,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 322350,
      "end_ms": 325470,
      "text": "可这些东西在手机上划完就忘上网，",
      "token_start": 1151,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 325530,
      "end_ms": 328190,
      "text": "查一堆乱七八糟的翻大部头，",
      "token_start": 1166,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 328190,
      "end_ms": 330070,
      "text": "史书又看的眼睛疼。",
      "token_start": 1178,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 330530,
      "end_ms": 332170,
      "text": "前阵子我翻到一本书，",
      "token_start": 1186,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 332590,
      "end_ms": 334090,
      "text": "正好解决这个问题，",
      "token_start": 1195,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 334410,
      "end_ms": 339500,
      "text": "叫大美中国人一生要去的一百零一个地方。",
      "token_start": 1203,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 339860,
      "end_ms": 344020,
      "text": "他把全中国最值得去的一百零一个地方挑出来，",
      "token_start": 1221,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 344560,
      "end_ms": 347080,
      "text": "分成五块自然奇观，",
      "token_start": 1241,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 347520,
      "end_ms": 349520,
      "text": "文明印记、烟火，",
      "token_start": 1249,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 349540,
      "end_ms": 350900,
      "text": "人间秘境，",
      "token_start": 1255,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 350940,
      "end_ms": 351440,
      "text": "寻踪，",
      "token_start": 1259,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 351740,
      "end_ms": 352600,
      "text": "人间天堂。",
      "token_start": 1261,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 352600,
      "end_ms": 356300,
      "text": "咱们今天聊的这些名山书里头，",
      "token_start": 1265,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 356300,
      "end_ms": 357900,
      "text": "一个地方接一个地方，",
      "token_start": 1278,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 357900,
      "end_ms": 359520,
      "text": "讲怎么来的，",
      "token_start": 1287,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 359520,
      "end_ms": 360800,
      "text": "有什么典故？",
      "token_start": 1292,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 360820,
      "end_ms": 363500,
      "text": "帝王在这儿干了什么？",
      "token_start": 1297,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 363900,
      "end_ms": 367285,
      "text": "文人墨客又在这儿寄托了什么心性，",
      "token_start": 1306,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 367840,
      "end_ms": 368500,
      "text": "几分钟，",
      "token_start": 1321,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 368580,
      "end_ms": 371115,
      "text": "一个地方讲的明明白白，",
      "token_start": 1324,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 371850,
      "end_ms": 373435,
      "text": "呼印的特别透亮。",
      "token_start": 1334,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 374100,
      "end_ms": 376545,
      "text": "一页翻开就是一幅大画，",
      "token_start": 1341,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 377070,
      "end_ms": 378425,
      "text": "我自己是这么用的，",
      "token_start": 1351,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 379100,
      "end_ms": 382820,
      "text": "能去的地方出门前翻一翻到了地方，",
      "token_start": 1359,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 382880,
      "end_ms": 383675,
      "text": "心里有底，",
      "token_start": 1374,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 384180,
      "end_ms": 385795,
      "text": "看的就不是冷石头，",
      "token_start": 1378,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 386260,
      "end_ms": 388995,
      "text": "是活故事暂时去不了的，",
      "token_start": 1386,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 389460,
      "end_ms": 391105,
      "text": "就着图文慢慢看，",
      "token_start": 1396,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 391420,
      "end_ms": 392545,
      "text": "也算去过了。",
      "token_start": 1403,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 393280,
      "end_ms": 394495,
      "text": "摆在茶几上，",
      "token_start": 1408,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 395020,
      "end_ms": 395860,
      "text": "孙辈来了，",
      "token_start": 1413,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 395860,
      "end_ms": 396560,
      "text": "翻两页，",
      "token_start": 1417,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 396820,
      "end_ms": 397980,
      "text": "长见识不说，",
      "token_start": 1420,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 398520,
      "end_ms": 400805,
      "text": "写作文也正好用得上。",
      "token_start": 1425,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 401200,
      "end_ms": 404030,
      "text": "老两口晚上翻翻商量，",
      "token_start": 1434,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 404110,
      "end_ms": 407415,
      "text": "明年去哪儿比刷手机舒坦多了，",
      "token_start": 1443,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 407820,
      "end_ms": 410055,
      "text": "房子会旧积蓄会花完。",
      "token_start": 1456,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 410520,
      "end_ms": 412895,
      "text": "可老祖宗留下来的文化底蕴，",
      "token_start": 1465,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 413250,
      "end_ms": 415505,
      "text": "传多少代都贬不了职，",
      "token_start": 1477,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 415950,
      "end_ms": 417375,
      "text": "这根脉一旦断了，",
      "token_start": 1486,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 417730,
      "end_ms": 418675,
      "text": "可就不好接了，",
      "token_start": 1493,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 419340,
      "end_ms": 421900,
      "text": "趁现在还能买到给自己，",
      "token_start": 1499,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 421960,
      "end_ms": 423905,
      "text": "也给下一代留一份儿，",
      "token_start": 1509,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 424550,
      "end_ms": 426225,
      "text": "说我搁商品橱窗了。",
      "token_start": 1518,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 426830,
      "end_ms": 429295,
      "text": "感兴趣的朋友点开我的头像，",
      "token_start": 1526,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 429580,
      "end_ms": 431115,
      "text": "进入主页进去看看，",
      "token_start": 1538,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 431630,
      "end_ms": 433235,
      "text": "暂时走不出去，",
      "token_start": 1546,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 434050,
      "end_ms": 436645,
      "text": "咱就把大好河山装进屋里，",
      "token_start": 1552,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 437030,
      "end_ms": 439730,
      "text": "好说回正题揭晓。",
      "token_start": 1563,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 439750,
      "end_ms": 440375,
      "text": "第一名，",
      "token_start": 1570,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 440800,
      "end_ms": 441535,
      "text": "武夷山，",
      "token_start": 1573,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 441970,
      "end_ms": 442875,
      "text": "福建南平，",
      "token_start": 1576,
      "token_end_exclusive": 1580
    },
    {
      "start_ms": 443710,
      "end_ms": 446635,
      "text": "为什么是他他不在五岳之列？",
      "token_start": 1580,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 447270,
      "end_ms": 450385,
      "text": "没有一位帝王在他头上封过禅，",
      "token_start": 1592,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 450930,
      "end_ms": 453885,
      "text": "可前面九座山各占一块的东西，",
      "token_start": 1605,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 454430,
      "end_ms": 457195,
      "text": "他一座山全装下了南宋。",
      "token_start": 1618,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 457590,
      "end_ms": 459505,
      "text": "一位叫朱熹的读书人，",
      "token_start": 1628,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 460270,
      "end_ms": 462775,
      "text": "在山里舞曲的大饮屏风下，",
      "token_start": 1637,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 463110,
      "end_ms": 465895,
      "text": "盖起武夷京社收徒讲学，",
      "token_start": 1648,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 466330,
      "end_ms": 468515,
      "text": "还写下十首五一诏歌。",
      "token_start": 1658,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 469080,
      "end_ms": 471605,
      "text": "他在这儿讲的学问就是理学。",
      "token_start": 1667,
      "token_end_exclusive": 1679
    },
    {
      "start_ms": 472020,
      "end_ms": 472460,
      "text": "后来，",
      "token_start": 1679,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 472520,
      "end_ms": 477475,
      "text": "他著的四叔从元朝起成了科举考场的标准，",
      "token_start": 1681,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 477950,
      "end_ms": 479125,
      "text": "一直管到清末，",
      "token_start": 1699,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 479590,
      "end_ms": 480565,
      "text": "将近六百年。",
      "token_start": 1705,
      "token_end_exclusive": 1710
    },
    {
      "start_ms": 481110,
      "end_ms": 484185,
      "text": "中国的读书人没有一个绕的过去。",
      "token_start": 1710,
      "token_end_exclusive": 1724
    },
    {
      "start_ms": 484670,
      "end_ms": 486815,
      "text": "可武夷山不只是书斋，",
      "token_start": 1724,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 487220,
      "end_ms": 495315,
      "text": "九曲溪绕着三十六封九十九颜留山崖上刻着四百多处古人留下的字，",
      "token_start": 1733,
      "token_end_exclusive": 1762
    },
    {
      "start_ms": 495910,
      "end_ms": 500825,
      "text": "宋朝、苏轼、范仲淹都写诗夸过他的茶。",
      "token_start": 1762,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 501290,
      "end_ms": 506325,
      "text": "元朝朝廷干脆在山里设了御茶园红茶的鼻祖，",
      "token_start": 1777,
      "token_end_exclusive": 1796
    },
    {
      "start_ms": 506640,
      "end_ms": 509405,
      "text": "正山小主也是从这山里出来的。",
      "token_start": 1796,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 509820,
      "end_ms": 510980,
      "text": "您坐上竹筏，",
      "token_start": 1809,
      "token_end_exclusive": 1814
    },
    {
      "start_ms": 511400,
      "end_ms": 513460,
      "text": "顺着九曲溪飘下来，",
      "token_start": 1814,
      "token_end_exclusive": 1822
    },
    {
      "start_ms": 513820,
      "end_ms": 514700,
      "text": "一边是山，",
      "token_start": 1822,
      "token_end_exclusive": 1826
    },
    {
      "start_ms": 515020,
      "end_ms": 516015,
      "text": "一边是水，",
      "token_start": 1826,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 516480,
      "end_ms": 518200,
      "text": "手里端着一杯颜茶，",
      "token_start": 1830,
      "token_end_exclusive": 1838
    },
    {
      "start_ms": 518600,
      "end_ms": 520065,
      "text": "抬头是食客。",
      "token_start": 1838,
      "token_end_exclusive": 1843
    },
    {
      "start_ms": 520410,
      "end_ms": 528990,
      "text": "耳边仿佛有人在念书、读书、喝茶、写诗、刻字看山不是一样一样，",
      "token_start": 1843,
      "token_end_exclusive": 1868
    },
    {
      "start_ms": 528990,
      "end_ms": 531475,
      "text": "摆的是全藏在了一起。",
      "token_start": 1868,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 532240,
      "end_ms": 533260,
      "text": "一九九九年，",
      "token_start": 1877,
      "token_end_exclusive": 1882
    },
    {
      "start_ms": 533620,
      "end_ms": 536795,
      "text": "他被列为世界文化与自然双遗产。",
      "token_start": 1882,
      "token_end_exclusive": 1896
    },
    {
      "start_ms": 537230,
      "end_ms": 538105,
      "text": "他排第一，",
      "token_start": 1896,
      "token_end_exclusive": 1900
    },
    {
      "start_ms": 538470,
      "end_ms": 540155,
      "text": "不是因为名气最大，",
      "token_start": 1900,
      "token_end_exclusive": 1908
    },
    {
      "start_ms": 540600,
      "end_ms": 542205,
      "text": "而是因为他最完整。",
      "token_start": 1908,
      "token_end_exclusive": 1916
    },
    {
      "start_ms": 543070,
      "end_ms": 544785,
      "text": "别的山是文化，",
      "token_start": 1916,
      "token_end_exclusive": 1922
    },
    {
      "start_ms": 545380,
      "end_ms": 546545,
      "text": "住进了山里，",
      "token_start": 1922,
      "token_end_exclusive": 1927
    },
    {
      "start_ms": 546840,
      "end_ms": 549215,
      "text": "武夷山是山和文化，",
      "token_start": 1927,
      "token_end_exclusive": 1935
    },
    {
      "start_ms": 549620,
      "end_ms": 551205,
      "text": "长成了彼此的样子。",
      "token_start": 1935,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 551580,
      "end_ms": 554350,
      "text": "从十座山讲完了黄山，",
      "token_start": 1943,
      "token_end_exclusive": 1952
    },
    {
      "start_ms": 554350,
      "end_ms": 556025,
      "text": "让画家拜他为师，",
      "token_start": 1952,
      "token_end_exclusive": 1959
    },
    {
      "start_ms": 556460,
      "end_ms": 559615,
      "text": "雁荡山被沈括读出了山水的道理，",
      "token_start": 1959,
      "token_end_exclusive": 1973
    },
    {
      "start_ms": 560160,
      "end_ms": 561860,
      "text": "天台山容下了佛道，",
      "token_start": 1973,
      "token_end_exclusive": 1981
    },
    {
      "start_ms": 561860,
      "end_ms": 566350,
      "text": "两家青城山把清净修成了安庐山，",
      "token_start": 1981,
      "token_end_exclusive": 1995
    },
    {
      "start_ms": 566370,
      "end_ms": 568445,
      "text": "一座山装了半部尸史。",
      "token_start": 1995,
      "token_end_exclusive": 2004
    },
    {
      "start_ms": 568830,
      "end_ms": 572620,
      "text": "五台山立的一千两百年的唐朝嵩山，",
      "token_start": 2004,
      "token_end_exclusive": 2019
    },
    {
      "start_ms": 572660,
      "end_ms": 575200,
      "text": "让佛道如同住武当山，",
      "token_start": 2019,
      "token_end_exclusive": 2028
    },
    {
      "start_ms": 575260,
      "end_ms": 576200,
      "text": "是一个王朝，",
      "token_start": 2028,
      "token_end_exclusive": 2033
    },
    {
      "start_ms": 576260,
      "end_ms": 578810,
      "text": "拿国力雕出来的泰山，",
      "token_start": 2033,
      "token_end_exclusive": 2042
    },
    {
      "start_ms": 578810,
      "end_ms": 581055,
      "text": "是一个民族的精神靠山，",
      "token_start": 2042,
      "token_end_exclusive": 2052
    },
    {
      "start_ms": 581470,
      "end_ms": 584095,
      "text": "可只有武夷山没有风扇，",
      "token_start": 2052,
      "token_end_exclusive": 2062
    },
    {
      "start_ms": 584860,
      "end_ms": 585975,
      "text": "不靠帝王，",
      "token_start": 2062,
      "token_end_exclusive": 2066
    },
    {
      "start_ms": 586450,
      "end_ms": 592275,
      "text": "确把理学、茶、诗文、石刻和山水包在了一起。",
      "token_start": 2066,
      "token_end_exclusive": 2083
    },
    {
      "start_ms": 592680,
      "end_ms": 596265,
      "text": "前面几座山比的是名气是四冠，",
      "token_start": 2083,
      "token_end_exclusive": 2096
    },
    {
      "start_ms": 596630,
      "end_ms": 597775,
      "text": "是谁来过？",
      "token_start": 2096,
      "token_end_exclusive": 2100
    },
    {
      "start_ms": 598110,
      "end_ms": 599425,
      "text": "他比的是文化，",
      "token_start": 2100,
      "token_end_exclusive": 2106
    },
    {
      "start_ms": 599860,
      "end_ms": 602045,
      "text": "有没有长进山的骨头里，",
      "token_start": 2106,
      "token_end_exclusive": 2116
    },
    {
      "start_ms": 602380,
      "end_ms": 604445,
      "text": "您说什么才叫文化气息？",
      "token_start": 2116,
      "token_end_exclusive": 2126
    },
    {
      "start_ms": 604920,
      "end_ms": 607505,
      "text": "山不是因为有名才有文化气息，",
      "token_start": 2126,
      "token_end_exclusive": 2139
    },
    {
      "start_ms": 607960,
      "end_ms": 611580,
      "text": "是因为有人把心安在了里山，",
      "token_start": 2139,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 611620,
      "end_ms": 613685,
      "text": "也把人养成了他的样子。",
      "token_start": 2151,
      "token_end_exclusive": 2161
    },
    {
      "start_ms": 614500,
      "end_ms": 615335,
      "text": "最后问问您，",
      "token_start": 2161,
      "token_end_exclusive": 2166
    },
    {
      "start_ms": 615930,
      "end_ms": 617295,
      "text": "这十座名山，",
      "token_start": 2166,
      "token_end_exclusive": 2171
    },
    {
      "start_ms": 617830,
      "end_ms": 619315,
      "text": "您去过哪几座？",
      "token_start": 2171,
      "token_end_exclusive": 2177
    },
    {
      "start_ms": 619880,
      "end_ms": 621715,
      "text": "最想去的是哪一座？",
      "token_start": 2177,
      "token_end_exclusive": 2185
    },
    {
      "start_ms": 622130,
      "end_ms": 623965,
      "text": "刚才说的那本大美中国，",
      "token_start": 2185,
      "token_end_exclusive": 2195
    },
    {
      "start_ms": 624340,
      "end_ms": 626025,
      "text": "我哥商品橱窗了，",
      "token_start": 2195,
      "token_end_exclusive": 2202
    },
    {
      "start_ms": 626360,
      "end_ms": 627620,
      "text": "点开我的头像，",
      "token_start": 2202,
      "token_end_exclusive": 2208
    },
    {
      "start_ms": 627880,
      "end_ms": 631735,
      "text": "进入主页里就能找到喜欢山水文化的朋友，",
      "token_start": 2208,
      "token_end_exclusive": 2226
    },
    {
      "start_ms": 631930,
      "end_ms": 632585,
      "text": "别错过。",
      "token_start": 2226,
      "token_end_exclusive": 2229
    },
    {
      "start_ms": 633040,
      "end_ms": 635995,
      "text": "想听更多藏在山水里的中国故事。",
      "token_start": 2229,
      "token_end_exclusive": 2243
    },
    {
      "start_ms": 636340,
      "end_ms": 637175,
      "text": "点个关注，",
      "token_start": 2243,
      "token_end_exclusive": 2247
    },
    {
      "start_ms": 637570,
      "end_ms": 639035,
      "text": "咱们下回接着聊。",
      "token_start": 2247,
      "token_end_exclusive": 2254
    }
  ],
