  "segments": [
    {
      "start_ms": 850,
      "end_ms": 1630,
      "text": "有句话说，",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1750,
      "end_ms": 4850,
      "text": "青年古都洛阳牡丹你知道吗？",
      "token_start": 4,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 5170,
      "end_ms": 8930,
      "text": "洛阳是中国建都时间最长、朝代最多的古都之一。",
      "token_start": 16,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 9470,
      "end_ms": 11630,
      "text": "先后有十三个朝代在这里建都，",
      "token_start": 36,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 12170,
      "end_ms": 15150,
      "text": "而洛阳和牡丹的缘分要从武则天说起。",
      "token_start": 49,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 15670,
      "end_ms": 18570,
      "text": "传说武则天冬日相里百花齐放。",
      "token_start": 65,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 19210,
      "end_ms": 21750,
      "text": "所独牡丹不从被贬到洛阳，",
      "token_start": 78,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 21930,
      "end_ms": 25290,
      "text": "结果牡丹到了洛阳反而开得更盛。",
      "token_start": 89,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 25610,
      "end_ms": 28770,
      "text": "于是有了洛阳牡丹家天下的美丽，",
      "token_start": 103,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 29310,
      "end_ms": 31040,
      "text": "所以每年四五月，",
      "token_start": 117,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 31200,
      "end_ms": 32880,
      "text": "洛阳满城牡丹盛开，",
      "token_start": 124,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 33160,
      "end_ms": 35280,
      "text": "那场面真是如花，",
      "token_start": 132,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 35380,
      "end_ms": 36540,
      "text": "如海人如潮。",
      "token_start": 139,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 36820,
      "end_ms": 37660,
      "text": "洛阳这座城，",
      "token_start": 144,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 37880,
      "end_ms": 39940,
      "text": "一边是十三朝古都的厚重，",
      "token_start": 149,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 40300,
      "end_ms": 42200,
      "text": "一边是国色天香的浪漫，",
      "token_start": 160,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 42560,
      "end_ms": 43580,
      "text": "想看中国历史，",
      "token_start": 170,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 43660,
      "end_ms": 45360,
      "text": "洛阳是一定要去的地方。",
      "token_start": 176,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 45860,
      "end_ms": 46500,
      "text": "关注我，",
      "token_start": 186,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 46740,
      "end_ms": 50275,
      "text": "带你看懂每一座历史名城独有的魅力。",
      "token_start": 189,
      "token_end_exclusive": 205
    }
  ],
