{
  "video_id": "v_0d39c6dc7d4087f4",
  "duration_s": 361.93,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_0d39c6dc7d4087f4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_0d39c6dc7d4087f4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 710,
      "text": "子君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1070,
      "end_ms": 3330,
      "text": "你知道中国哪里最有人情味吗？",
      "token_start": 2,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3510,
      "end_ms": 4710,
      "text": "每年农历七月，",
      "token_start": 15,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 4930,
      "end_ms": 6930,
      "text": "潮汕有一个特别震撼的场面，",
      "token_start": 21,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 7250,
      "end_ms": 11470,
      "text": "家家户户都会在门前摆满米饭、肉、山、水果等等祭品，",
      "token_start": 33,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 11650,
      "end_ms": 12370,
      "text": "这叫什么？",
      "token_start": 54,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12470,
      "end_ms": 13570,
      "text": "这叫师孤。",
      "token_start": 58,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 14110,
      "end_ms": 16309,
      "text": "师孤祭奠的并不是自己家的先祖，",
      "token_start": 62,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 16410,
      "end_ms": 18170,
      "text": "而是那些无主孤魂。",
      "token_start": 76,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 18590,
      "end_ms": 20810,
      "text": "他孤祭拜的是为国捐躯的战士，",
      "token_start": 84,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 20990,
      "end_ms": 21470,
      "text": "逃荒，",
      "token_start": 97,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 21490,
      "end_ms": 22310,
      "text": "饿死的百姓，",
      "token_start": 99,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 22510,
      "end_ms": 23850,
      "text": "客死他乡的游子，",
      "token_start": 104,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 24250,
      "end_ms": 26070,
      "text": "那些没有后代的人怎么办呢？",
      "token_start": 111,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 26290,
      "end_ms": 27990,
      "text": "没有人知道他们坟在哪里，",
      "token_start": 123,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 28050,
      "end_ms": 29130,
      "text": "没有儿女来祭。",
      "token_start": 134,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 29530,
      "end_ms": 30380,
      "text": "潮汕说，",
      "token_start": 140,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 30520,
      "end_ms": 31600,
      "text": "那我们来祭拜，",
      "token_start": 143,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 31900,
      "end_ms": 33040,
      "text": "我不知道你是谁，",
      "token_start": 149,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 33360,
      "end_ms": 34840,
      "text": "也不知道你从哪里来。",
      "token_start": 156,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 35060,
      "end_ms": 36400,
      "text": "但既然你和我一样，",
      "token_start": 165,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 36400,
      "end_ms": 37820,
      "text": "在人世间走过一遭，",
      "token_start": 173,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 38080,
      "end_ms": 39560,
      "text": "就不应该没有一口饭吃，",
      "token_start": 181,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 39760,
      "end_ms": 40760,
      "text": "没有一柱香火，",
      "token_start": 191,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 40940,
      "end_ms": 42620,
      "text": "所以我们给你留一份。",
      "token_start": 197,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 43000,
      "end_ms": 44060,
      "text": "你再看潮汕诗，",
      "token_start": 206,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 44060,
      "end_ms": 45240,
      "text": "故最后的贡品都去了，",
      "token_start": 212,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 45240,
      "end_ms": 49620,
      "text": "哪里都送给了当地贫穷的乡亲民失孤魂，",
      "token_start": 221,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 49760,
      "end_ms": 50760,
      "text": "暗失贫苦，",
      "token_start": 238,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 50980,
      "end_ms": 52240,
      "text": "这是封建迷信吗？",
      "token_start": 242,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 52340,
      "end_ms": 52840,
      "text": "不是，",
      "token_start": 249,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 53000,
      "end_ms": 55060,
      "text": "这是潮汕人的慈悲和大爱。",
      "token_start": 251,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 55220,
      "end_ms": 55720,
      "text": "这一刻，",
      "token_start": 262,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 55880,
      "end_ms": 56860,
      "text": "我敬潮汕。",
      "token_start": 265,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 57080,
      "end_ms": 58060,
      "text": "所谓人情味，",
      "token_start": 269,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 58240,
      "end_ms": 60555,
      "text": "就是哪怕你已经离开这个世界，",
      "token_start": 274,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 60820,
      "end_ms": 63405,
      "text": "我也希望这个世界还有人对你好一点。",
      "token_start": 287,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 63910,
      "end_ms": 65690,
      "text": "祭祖是不忘自己的来处，",
      "token_start": 303,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 65810,
      "end_ms": 69440,
      "text": "而师姑是不忍别人没有归处在。",
      "token_start": 313,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 69440,
      "end_ms": 71485,
      "text": "潮汕生者有所养，",
      "token_start": 326,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 71820,
      "end_ms": 73095,
      "text": "逝者有所念，",
      "token_start": 333,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 73400,
      "end_ms": 75470,
      "text": "孤折亦有所安都。",
      "token_start": 338,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 75470,
      "end_ms": 76610,
      "text": "说潮汕人迷信，",
      "token_start": 345,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 76610,
      "end_ms": 77370,
      "text": "不管走到哪里，",
      "token_start": 351,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 77370,
      "end_ms": 78790,
      "text": "都要拜老爷修祠堂，",
      "token_start": 357,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 79110,
      "end_ms": 82090,
      "text": "但真相能够让你起一身鸡皮疙瘩潮汕。",
      "token_start": 365,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 82090,
      "end_ms": 84315,
      "text": "很多祠堂门头上写着颍川世家，",
      "token_start": 381,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 84540,
      "end_ms": 85195,
      "text": "但你知道吗？",
      "token_start": 394,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 85480,
      "end_ms": 87105,
      "text": "颍川其实远在河南，",
      "token_start": 399,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 87590,
      "end_ms": 89510,
      "text": "而这些人在广东住了近千年，",
      "token_start": 407,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 89610,
      "end_ms": 91385,
      "text": "为什么把河南挂在门兜上？",
      "token_start": 419,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 91720,
      "end_ms": 94200,
      "text": "其实不止颖川去潮汕随便一座祠堂，",
      "token_start": 430,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 94200,
      "end_ms": 95160,
      "text": "抬头看到门头上，",
      "token_start": 445,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 95160,
      "end_ms": 96845,
      "text": "基本上写的是北方地名。",
      "token_start": 452,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 97210,
      "end_ms": 98515,
      "text": "汾河旧家是山鸡，",
      "token_start": 462,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 98790,
      "end_ms": 100050,
      "text": "陇西市驾是甘肃，",
      "token_start": 469,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 100230,
      "end_ms": 100710,
      "text": "江夏，",
      "token_start": 476,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 100770,
      "end_ms": 102855,
      "text": "是湖北琅琊市、山东等等。",
      "token_start": 478,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 103390,
      "end_ms": 103910,
      "text": "历史上，",
      "token_start": 488,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 103910,
      "end_ms": 105345,
      "text": "中原战乱和剃发令，",
      "token_start": 491,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 105610,
      "end_ms": 108015,
      "text": "他们的祖先一次次衣冠难度，",
      "token_start": 499,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 108240,
      "end_ms": 109360,
      "text": "背着祖宗的牌位，",
      "token_start": 511,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 109360,
      "end_ms": 110020,
      "text": "背着祖父，",
      "token_start": 518,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 110020,
      "end_ms": 111180,
      "text": "背着家乡的古音，",
      "token_start": 522,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 111380,
      "end_ms": 112685,
      "text": "躲进了这一方角落。",
      "token_start": 529,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 113000,
      "end_ms": 115375,
      "text": "他们在南方定居了几百年上千年，",
      "token_start": 537,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 115610,
      "end_ms": 118075,
      "text": "有的甚至漂洋过海去了南阳去了欧洲。",
      "token_start": 551,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 118720,
      "end_ms": 120040,
      "text": "但只要修祠堂，",
      "token_start": 567,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 120040,
      "end_ms": 123395,
      "text": "就一定会把老祖宗起家的地方刻在门头之上。",
      "token_start": 573,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 123650,
      "end_ms": 124545,
      "text": "这不是迷信，",
      "token_start": 592,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 124840,
      "end_ms": 126760,
      "text": "他们是太忘记自己从哪里来，",
      "token_start": 597,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 126860,
      "end_ms": 129210,
      "text": "害怕忘了这身血脉死亡。",
      "token_start": 609,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 129210,
      "end_ms": 129765,
      "text": "不可怕，",
      "token_start": 619,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 130070,
      "end_ms": 131065,
      "text": "遗忘才可怕。",
      "token_start": 622,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 131420,
      "end_ms": 131935,
      "text": "在潮汕，",
      "token_start": 627,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 132200,
      "end_ms": 133300,
      "text": "只要走进祠堂，",
      "token_start": 630,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 133400,
      "end_ms": 135410,
      "text": "你就知道你不是无名之辈，",
      "token_start": 636,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 135490,
      "end_ms": 137765,
      "text": "你身后站着千军万马的祖先。",
      "token_start": 647,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 138260,
      "end_ms": 139680,
      "text": "每年农历三月十九，",
      "token_start": 659,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 139780,
      "end_ms": 141555,
      "text": "潮汕人都要祭拜太阳宫。",
      "token_start": 667,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 141880,
      "end_ms": 145190,
      "text": "外地人不知道的是三月十九是明朝崇祯皇帝。",
      "token_start": 677,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 145190,
      "end_ms": 146515,
      "text": "在眉山自缢的日子，",
      "token_start": 696,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 146930,
      "end_ms": 147650,
      "text": "清军入关，",
      "token_start": 704,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 147650,
      "end_ms": 149530,
      "text": "不准汉人祭拜前朝大明。",
      "token_start": 708,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 149550,
      "end_ms": 152185,
      "text": "于是他们就把大明宫改叫太阳宫。",
      "token_start": 718,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 152430,
      "end_ms": 155350,
      "text": "他们祭奠的是那个风雨飘摇的汉家江山，",
      "token_start": 732,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 155490,
      "end_ms": 158065,
      "text": "而这一代就是三百年心照不宣。",
      "token_start": 749,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 158510,
      "end_ms": 161470,
      "text": "潮汕人跪下来的第一句就是风调雨顺，",
      "token_start": 762,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 161650,
      "end_ms": 162635,
      "text": "国泰民安。",
      "token_start": 778,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 163090,
      "end_ms": 164110,
      "text": "他们拜的不是神，",
      "token_start": 782,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 164430,
      "end_ms": 165130,
      "text": "是文化，",
      "token_start": 789,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 165290,
      "end_ms": 166765,
      "text": "是再也回不去的大名。",
      "token_start": 792,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 167250,
      "end_ms": 168990,
      "text": "还有潮汕老人去世入店的时候，",
      "token_start": 801,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 168990,
      "end_ms": 170625,
      "text": "绝对不能穿马褂和旗袍，",
      "token_start": 814,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 170870,
      "end_ms": 172465,
      "text": "必须穿明朝款式的衣服。",
      "token_start": 824,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 172850,
      "end_ms": 175180,
      "text": "大金山宽袖子活着，",
      "token_start": 834,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 175180,
      "end_ms": 177220,
      "text": "没有办法剃发易服做了顺明，",
      "token_start": 842,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 177220,
      "end_ms": 179400,
      "text": "但走的时候必须穿汉家衣冠，",
      "token_start": 854,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 179500,
      "end_ms": 180360,
      "text": "去见祖宗，",
      "token_start": 866,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 180520,
      "end_ms": 182855,
      "text": "死了也要堂堂正正做汉人。",
      "token_start": 870,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 183430,
      "end_ms": 185645,
      "text": "再看这个火遍全网的潮汕莺歌舞，",
      "token_start": 881,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 185990,
      "end_ms": 186895,
      "text": "这可不是乱跳。",
      "token_start": 895,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 187190,
      "end_ms": 189940,
      "text": "这其实是古代汉人军政的走为汉族人，",
      "token_start": 901,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 189940,
      "end_ms": 190680,
      "text": "放下锤子，",
      "token_start": 917,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 190680,
      "end_ms": 191200,
      "text": "是农民，",
      "token_start": 921,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 191280,
      "end_ms": 192765,
      "text": "拿起锤子能杀敌。",
      "token_start": 924,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 193080,
      "end_ms": 194140,
      "text": "这股的路见不平，",
      "token_start": 931,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 194140,
      "end_ms": 195040,
      "text": "一声吼的血腥，",
      "token_start": 938,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 195040,
      "end_ms": 197085,
      "text": "被潮汕人完完整整守了下来。",
      "token_start": 944,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 197550,
      "end_ms": 198390,
      "text": "脸涂油彩，",
      "token_start": 956,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 198390,
      "end_ms": 200915,
      "text": "手持双棍步伐踏的地动山腰。",
      "token_start": 960,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 201320,
      "end_ms": 202800,
      "text": "在电影给阿妈的情书里，",
      "token_start": 972,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 202820,
      "end_ms": 206460,
      "text": "男女主人公初相识的场景就是莺歌舞扛飙旗。",
      "token_start": 982,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 206500,
      "end_ms": 209590,
      "text": "尹老爷的画面都说五十六个民族五十五个，",
      "token_start": 1001,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 209590,
      "end_ms": 210110,
      "text": "能歌善，",
      "token_start": 1019,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 210170,
      "end_ms": 212065,
      "text": "唯独汉族人不能歌也不能舞。",
      "token_start": 1022,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 212340,
      "end_ms": 215405,
      "text": "其实莺歌舞就是我们汉族人自己的特色舞蹈。",
      "token_start": 1034,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 215810,
      "end_ms": 217550,
      "text": "莺歌舞燃的就是汉人，",
      "token_start": 1053,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 217550,
      "end_ms": 219225,
      "text": "骨子里那股不服输的劲儿，",
      "token_start": 1062,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 219420,
      "end_ms": 220120,
      "text": "没有退路，",
      "token_start": 1073,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 220180,
      "end_ms": 221240,
      "text": "只有向前冲。",
      "token_start": 1077,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 221560,
      "end_ms": 223625,
      "text": "潮汕人真的把信仰做到了极致，",
      "token_start": 1082,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 223930,
      "end_ms": 226130,
      "text": "就算是莺歌陆逊遇到台风、暴雨，",
      "token_start": 1095,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 226230,
      "end_ms": 228750,
      "text": "孩子们也是迎难而上整个村子。",
      "token_start": 1108,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 228750,
      "end_ms": 230815,
      "text": "少男少女发动全村来训练，",
      "token_start": 1121,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 231070,
      "end_ms": 231830,
      "text": "没有人缺席，",
      "token_start": 1132,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 231830,
      "end_ms": 232570,
      "text": "没有人推脱，",
      "token_start": 1137,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 232650,
      "end_ms": 234075,
      "text": "没有任何金钱报酬。",
      "token_start": 1142,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 234420,
      "end_ms": 237645,
      "text": "而今年潮汕揭阳新兵入也是莺歌舞开路，",
      "token_start": 1150,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 238060,
      "end_ms": 241925,
      "text": "潮汕宗祠在当地捐了许多免费的养老院和儿童福利院，",
      "token_start": 1167,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 242210,
      "end_ms": 244770,
      "text": "很多叔公阿姨在膳堂做了一辈子义工。",
      "token_start": 1190,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 244970,
      "end_ms": 245330,
      "text": "这一刻，",
      "token_start": 1206,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 245330,
      "end_ms": 245855,
      "text": "我相信，",
      "token_start": 1209,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 246150,
      "end_ms": 247650,
      "text": "如果世间有神明，",
      "token_start": 1212,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 247650,
      "end_ms": 248925,
      "text": "那一定在汕头。",
      "token_start": 1219,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 249220,
      "end_ms": 252740,
      "text": "你看这是潮汕的妈祖花灯巡游掉队的父子，",
      "token_start": 1225,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 252740,
      "end_ms": 255080,
      "text": "全场围观的都是善意的鼓励，",
      "token_start": 1243,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 255120,
      "end_ms": 256095,
      "text": "没有什么嘲讽。",
      "token_start": 1255,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 256510,
      "end_ms": 257930,
      "text": "爸爸全力抱起儿子，",
      "token_start": 1261,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 257930,
      "end_ms": 259335,
      "text": "最后冲刺进祠堂。",
      "token_start": 1269,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 259670,
      "end_ms": 263070,
      "text": "宗族对一个垫底的落后的弟子都那么爱护顾虑，",
      "token_start": 1276,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 263170,
      "end_ms": 265505,
      "text": "可想这样的宗族会一直强盛下去。",
      "token_start": 1296,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 265750,
      "end_ms": 267665,
      "text": "信仰的背后是人情味，",
      "token_start": 1310,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 267940,
      "end_ms": 270810,
      "text": "所以潮商很喜欢自己人帮自己人，",
      "token_start": 1319,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 270950,
      "end_ms": 272950,
      "text": "而你知道潮汕人有多牛吗？",
      "token_start": 1333,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 273070,
      "end_ms": 273750,
      "text": "香港首富，",
      "token_start": 1344,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 273750,
      "end_ms": 274250,
      "text": "李嘉诚，",
      "token_start": 1348,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 274330,
      "end_ms": 275510,
      "text": "泰国首富谢国民，",
      "token_start": 1351,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 275630,
      "end_ms": 278365,
      "text": "新加坡首富吴清亮、亚洲首富陈碧晨，",
      "token_start": 1358,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 278620,
      "end_ms": 281695,
      "text": "世界上最富有的十二大银行家都是潮汕人。",
      "token_start": 1373,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 282020,
      "end_ms": 283820,
      "text": "全球一百位华人首富当中，",
      "token_start": 1391,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 283900,
      "end_ms": 285425,
      "text": "潮汕人占了三分之一，",
      "token_start": 1402,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 285830,
      "end_ms": 288935,
      "text": "欧美各地的华人首富也全都是潮汕人，",
      "token_start": 1411,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 289230,
      "end_ms": 292475,
      "text": "就连泰国王室的祖先正姓大帝也是潮汕人，",
      "token_start": 1427,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 292650,
      "end_ms": 295025,
      "text": "是中国历史上第一位在海外称帝的华人。",
      "token_start": 1445,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 295410,
      "end_ms": 297030,
      "text": "泰国十大富豪有八位，",
      "token_start": 1462,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 297090,
      "end_ms": 298085,
      "text": "都是潮汕人，",
      "token_start": 1471,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 298430,
      "end_ms": 299610,
      "text": "有潮水的地方，",
      "token_start": 1476,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 299650,
      "end_ms": 300795,
      "text": "就有潮汕人。",
      "token_start": 1482,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 301290,
      "end_ms": 301690,
      "text": "诸君，",
      "token_start": 1487,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 301810,
      "end_ms": 302910,
      "text": "你知道民间哪里？",
      "token_start": 1489,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 302910,
      "end_ms": 303770,
      "text": "神仙最多吗？",
      "token_start": 1496,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 303810,
      "end_ms": 305650,
      "text": "当属潮汕天庭的收入，",
      "token_start": 1501,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 305650,
      "end_ms": 306890,
      "text": "据说一半靠潮汕。",
      "token_start": 1510,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 307290,
      "end_ms": 308810,
      "text": "若是见到天帝父母，",
      "token_start": 1517,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 308810,
      "end_ms": 309390,
      "text": "这样的标识，",
      "token_start": 1525,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 309410,
      "end_ms": 312930,
      "text": "拜的就是天宫玉皇大帝和他的妻子后土娘娘。",
      "token_start": 1530,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 313130,
      "end_ms": 315690,
      "text": "若是见到白脸红脸、黑脸一起出现，",
      "token_start": 1549,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 315750,
      "end_ms": 318250,
      "text": "就潮汕顶流老爷三山国王。",
      "token_start": 1563,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 318550,
      "end_ms": 319870,
      "text": "若是位于灶台之上，",
      "token_start": 1574,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 319870,
      "end_ms": 321370,
      "text": "则是最不能得罪的神明。",
      "token_start": 1582,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 321630,
      "end_ms": 323870,
      "text": "司命公张丹也被称之为灶神，",
      "token_start": 1592,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 323950,
      "end_ms": 324890,
      "text": "是百姓的家。",
      "token_start": 1604,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 324890,
      "end_ms": 328250,
      "text": "内神就是先谱圣庙风雨圣者升殿一事。",
      "token_start": 1609,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 328650,
      "end_ms": 330410,
      "text": "我一直以为我们没有汉文化，",
      "token_start": 1625,
      "token_end_exclusive": 1637
    },
    {
      "start_ms": 330450,
      "end_ms": 332580,
      "text": "没想到汉文话都在广东潮汕，",
      "token_start": 1637,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 332880,
      "end_ms": 334220,
      "text": "无论何时何地，",
      "token_start": 1649,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 334220,
      "end_ms": 335820,
      "text": "只要一句老要保侯，",
      "token_start": 1655,
      "token_end_exclusive": 1663
    },
    {
      "start_ms": 335900,
      "end_ms": 337500,
      "text": "就能给潮汕人注入力量，",
      "token_start": 1663,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 337700,
      "end_ms": 338400,
      "text": "你知道吗？",
      "token_start": 1673,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 338580,
      "end_ms": 341560,
      "text": "潮汕祭祖最重要的不是求祖先保佑我，",
      "token_start": 1677,
      "token_end_exclusive": 1693
    },
    {
      "start_ms": 341720,
      "end_ms": 342820,
      "text": "而是提醒自己，",
      "token_start": 1693,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 342860,
      "end_ms": 343960,
      "text": "别辜负祖先，",
      "token_start": 1699,
      "token_end_exclusive": 1704
    },
    {
      "start_ms": 344220,
      "end_ms": 345580,
      "text": "我不能给祖先丢人。",
      "token_start": 1704,
      "token_end_exclusive": 1712
    },
    {
      "start_ms": 345900,
      "end_ms": 347820,
      "text": "没有谁是真正的白手企业家，",
      "token_start": 1712,
      "token_end_exclusive": 1724
    },
    {
      "start_ms": 347920,
      "end_ms": 350420,
      "text": "你的起点就是祖辈几代人的终点。",
      "token_start": 1724,
      "token_end_exclusive": 1738
    },
    {
      "start_ms": 350740,
      "end_ms": 352160,
      "text": "一个家族最贵的遗产，",
      "token_start": 1738,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 352360,
      "end_ms": 353880,
      "text": "不是上一代留下多少钱，",
      "token_start": 1747,
      "token_end_exclusive": 1757
    },
    {
      "start_ms": 354280,
      "end_ms": 355120,
      "text": "而是下一代。",
      "token_start": 1757,
      "token_end_exclusive": 1762
    },
    {
      "start_ms": 355120,
      "end_ms": 356160,
      "text": "提起这个家族，",
      "token_start": 1762,
      "token_end_exclusive": 1768
    },
    {
      "start_ms": 356160,
      "end_ms": 356940,
      "text": "就会说一句，",
      "token_start": 1768,
      "token_end_exclusive": 1773
    },
    {
      "start_ms": 357200,
      "end_ms": 360120,
      "text": "我们家祖祖辈辈都是认真生活，",
      "token_start": 1773,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 360320,
      "end_ms": 361595,
      "text": "堂堂正正的人。",
      "token_start": 1786,
      "token_end_exclusive": 1792
    }
  ],
