      "token_end_exclusive": 15
    },
    {
      "start_ms": 3310,
      "end_ms": 5130,
      "text": "男戴观音女戴佛。",
      "token_start": 15,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5590,
      "end_ms": 7930,
      "text": "错是男戴官印女，",
      "token_start": 22,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 7950,
      "end_ms": 11050,
      "text": "戴福穷养儿子富养女儿。",
      "token_start": 29,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 11370,
      "end_ms": 16910,
      "text": "错是穷养儿至富养女德嫁鸡随鸡嫁狗随狗。",
      "token_start": 39,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 17230,
      "end_ms": 19010,
      "text": "错是嫁妻随起，",
      "token_start": 57,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 19450,
      "end_ms": 20570,
      "text": "嫁走随走，",
      "token_start": 63,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 21010,
      "end_ms": 22710,
      "text": "先成家后立业。",
      "token_start": 67,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 23170,
      "end_ms": 24690,
      "text": "错是育良人，",
      "token_start": 73,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 24990,
      "end_ms": 25770,
      "text": "先成家，",
      "token_start": 78,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 26110,
      "end_ms": 28170,
      "text": "遇贵人先立业，",
      "token_start": 81,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 28890,
      "end_ms": 29905,
      "text": "嫁小非君子，",
      "token_start": 87,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 30340,
      "end_ms": 31420,
      "text": "无毒不丈夫。",
      "token_start": 92,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 31860,
      "end_ms": 33400,
      "text": "错是量小非，",
      "token_start": 97,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 33400,
      "end_ms": 33860,
      "text": "君子，",
      "token_start": 102,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 34200,
      "end_ms": 34700,
      "text": "无度，",
      "token_start": 104,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 35180,
      "end_ms": 36020,
      "text": "不丈夫，",
      "token_start": 106,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 36500,
      "end_ms": 38400,
      "text": "人不为己天诛地灭。",
      "token_start": 109,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 38740,
      "end_ms": 42340,
      "text": "错是人不修为天地不容，",
      "token_start": 117,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 43240,
      "end_ms": 44315,
      "text": "连云都。",
