  "segments": [
    {
      "start_ms": 540,
      "end_ms": 1760,
      "text": "我真不怎么喜欢你，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2360,
      "end_ms": 4220,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 8,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 4220,
      "end_ms": 6080,
      "text": "我领导的格局值得我们学习。",
      "token_start": 21,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8399,
      "end_ms": 9660,
      "text": "这次项目多亏你了，",
      "token_start": 33,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 9740,
      "end_ms": 11460,
      "text": "以后公司还得靠你们年轻人。",
      "token_start": 41,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 12520,
      "end_ms": 12900,
      "text": "领导，",
      "token_start": 53,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 13060,
      "end_ms": 13860,
      "text": "您说笑了，",
      "token_start": 55,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 14120,
      "end_ms": 15460,
      "text": "我们年轻人再能闯，",
      "token_start": 59,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 15580,
      "end_ms": 17500,
      "text": "也得有您这样的老将挂帅才行。",
      "token_start": 67,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 17900,
      "end_ms": 19420,
      "text": "以后我就是您的左膀右臂，",
      "token_start": 80,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 21040,
      "end_ms": 22640,
      "text": "我和李总你更喜欢谁？",
      "token_start": 91,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 23660,
      "end_ms": 25460,
      "text": "对领导怎么能用喜欢呢？",
      "token_start": 100,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 25700,
      "end_ms": 27340,
      "text": "那得叫尊敬两位领导啊，",
      "token_start": 110,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 27340,
      "end_ms": 32910,
      "text": "我都很尊敬小李又升职了，",
      "token_start": 120,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 33050,
      "end_ms": 33870,
      "text": "有什么感想？",
      "token_start": 131,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 34510,
      "end_ms": 35830,
      "text": "感想就是站得越高，",
      "token_start": 136,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 35890,
      "end_ms": 36950,
      "text": "越觉得您不容易，",
      "token_start": 144,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 37270,
      "end_ms": 38430,
      "text": "以后还得跟您多学，",
      "token_start": 151,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 38610,
      "end_ms": 38910,
      "text": "争取，",
      "token_start": 159,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 38910,
      "end_ms": 40075,
      "text": "不给您丢脸。",
      "token_start": 161,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 42430,
      "end_ms": 42870,
      "text": "小李，",
      "token_start": 166,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 43750,
      "end_ms": 44410,
      "text": "辛苦了，",
      "token_start": 168,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 45050,
      "end_ms": 45490,
      "text": "领导，",
      "token_start": 171,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 45610,
      "end_ms": 46750,
      "text": "这是我应该做的。",
      "token_start": 173,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 46930,
      "end_ms": 48310,
      "text": "强将手下无弱兵嘛，",
      "token_start": 180,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 48330,
      "end_ms": 49490,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 188,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 52250,
      "end_ms": 53670,
      "text": "你干活怎么比乌龟还慢？",
      "token_start": 197,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 54510,
      "end_ms": 54930,
      "text": "领导，",
      "token_start": 207,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 55410,
      "end_ms": 56070,
      "text": "俗话说，",
      "token_start": 209,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 56090,
      "end_ms": 57150,
      "text": "慢工出细活，",
      "token_start": 212,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 57490,
      "end_ms": 59470,
      "text": "我细致的对待每一个工作项目，",
      "token_start": 217,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 59510,
      "end_ms": 62285,
      "text": "不就避免了以后出现什么质量问题吗？",
      "token_start": 230,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 63230,
      "end_ms": 64455,
      "text": "年轻就是好啊，",
      "token_start": 246,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 64940,
      "end_ms": 66245,
      "text": "年轻就是还不够沉稳，",
      "token_start": 252,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 66560,
      "end_ms": 67635,
      "text": "还要向您多学习，",
      "token_start": 261,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 67920,
      "end_ms": 69055,
      "text": "我们才能变得更优秀。",
      "token_start": 268,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 69470,
      "end_ms": 71705,
      "text": "哈哈哈哈哈小李呀，",
      "token_start": 277,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 72270,
      "end_ms": 74565,
      "text": "我看你最近是越来越精神了啊，",
      "token_start": 285,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 75060,
      "end_ms": 76020,
      "text": "那是因为沾了领导，",
      "token_start": 298,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 76020,
      "end_ms": 76500,
      "text": "您的光，",
      "token_start": 306,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 76760,
      "end_ms": 77680,
      "text": "跟着您干事儿，",
      "token_start": 309,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 77680,
      "end_ms": 78645,
      "text": "气色都不敢差。",
      "token_start": 315,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 79030,
      "end_ms": 81010,
      "text": "哈哈哈哈哈关注我，",
      "token_start": 321,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 81190,
      "end_ms": 82510,
      "text": "每天学点高情商，",
      "token_start": 329,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 82510,
      "end_ms": 83195,
      "text": "说话技巧，",
      "token_start": 336,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 83560,
      "end_ms": 85125,
      "text": "让你的路越走越宽。",
      "token_start": 340,
      "token_end_exclusive": 348
    }
  ],
