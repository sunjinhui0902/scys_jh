{
  "video_id": "v_d00cee56eff9e90d",
  "duration_s": 627.333991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_d00cee56eff9e90d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_d00cee56eff9e90d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 4410,
      "text": "您知道中国不可思议的长寿村都有哪些吗？",
      "token_start": 0,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 5030,
      "end_ms": 5610,
      "text": "上集，",
      "token_start": 18,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5630,
      "end_ms": 12250,
      "text": "咱们聊了长青村、三山岛村、石鼓坪村、漫水村、水坪村。",
      "token_start": 20,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 13030,
      "end_ms": 15130,
      "text": "这集直接揭开谜底，",
      "token_start": 41,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 15550,
      "end_ms": 18950,
      "text": "看看前五名不可思议到什么程度，",
      "token_start": 49,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 19330,
      "end_ms": 21530,
      "text": "尤其是排在榜首的那座。",
      "token_start": 63,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 22010,
      "end_ms": 23910,
      "text": "既没有江南的水汽，",
      "token_start": 73,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 24250,
      "end_ms": 26010,
      "text": "既没有山林的青绿，",
      "token_start": 81,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 26370,
      "end_ms": 30660,
      "text": "竟然顶着干旱风沙生活在大沙漠落的跟前。",
      "token_start": 89,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 31040,
      "end_ms": 31780,
      "text": "话不多说，",
      "token_start": 107,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 32020,
      "end_ms": 33220,
      "text": "茶给您沏好了，",
      "token_start": 111,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 33500,
      "end_ms": 35320,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 117,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 35600,
      "end_ms": 36640,
      "text": "咱们这就开讲。",
      "token_start": 127,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 36960,
      "end_ms": 37580,
      "text": "第五名，",
      "token_start": 133,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 37920,
      "end_ms": 43560,
      "text": "四川都江堰青秀村青城山路的川西临盘村子，",
      "token_start": 136,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 43560,
      "end_ms": 49440,
      "text": "背靠中年苍翠的青城山几百户农家散落在茂林修竹之间，",
      "token_start": 155,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 50200,
      "end_ms": 53440,
      "text": "八九十岁、耳聪目明的老人比比皆是。",
      "token_start": 179,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 53880,
      "end_ms": 58540,
      "text": "这里守着两千多年前李冰父子开凿的灌渠源头，",
      "token_start": 194,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 59300,
      "end_ms": 62025,
      "text": "水旱从人不知机锦，",
      "token_start": 214,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 62460,
      "end_ms": 63975,
      "text": "您要是挑个舞后。",
      "token_start": 222,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 64330,
      "end_ms": 66785,
      "text": "坐在青秀村的农家小院里，",
      "token_start": 229,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67280,
      "end_ms": 73075,
      "text": "门前是奔流不息的雪山融水耳边是风吹楠木的沙沙声。",
      "token_start": 240,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 73580,
      "end_ms": 77915,
      "text": "八十多岁的老大爷正悠哉悠哉的抿着盖碗茶，",
      "token_start": 263,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 78360,
      "end_ms": 80985,
      "text": "摆起龙门阵来能讲上大半天。",
      "token_start": 282,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 81620,
      "end_ms": 84285,
      "text": "天府之国的从容与松弛，",
      "token_start": 294,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 84870,
      "end_ms": 87565,
      "text": "全被他们泡进了一杯清茶里。",
      "token_start": 304,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 88270,
      "end_ms": 90365,
      "text": "天下最舒坦的寿数，",
      "token_start": 316,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 90760,
      "end_ms": 93055,
      "text": "莫过于这份骨子里的从容。",
      "token_start": 324,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 93360,
      "end_ms": 94055,
      "text": "第四名，",
      "token_start": 335,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 94520,
      "end_ms": 99265,
      "text": "浙江永嘉林坑村南西江源头的浙南古村，",
      "token_start": 338,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 99970,
      "end_ms": 102265,
      "text": "村子藏在深山峡谷里，",
      "token_start": 355,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 102850,
      "end_ms": 104555,
      "text": "整村只有几百口人。",
      "token_start": 364,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 105090,
      "end_ms": 110855,
      "text": "八九十岁的高寿长者就有几十位村史里百岁寿星代代有名。",
      "token_start": 372,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 111280,
      "end_ms": 113725,
      "text": "林坑人七百年来耕读传家。",
      "token_start": 397,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 114150,
      "end_ms": 117665,
      "text": "这里的长寿带着一种罕见的书卷气，",
      "token_start": 408,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 118120,
      "end_ms": 120825,
      "text": "您踩的卵石台阶登上半山腰，",
      "token_start": 423,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 121310,
      "end_ms": 123295,
      "text": "木窗里透出暖黄的光。",
      "token_start": 435,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 124080,
      "end_ms": 126555,
      "text": "八九十岁的老先生不戴老花镜，",
      "token_start": 444,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 127020,
      "end_ms": 127860,
      "text": "稳稳当当，",
      "token_start": 457,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 127860,
      "end_ms": 130095,
      "text": "握着毛笔给乡邻写对联儿，",
      "token_start": 461,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 130360,
      "end_ms": 132395,
      "text": "或者翻看着泛黄的古籍。",
      "token_start": 472,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 132840,
      "end_ms": 134565,
      "text": "他们吃着山泉野菜，",
      "token_start": 482,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 135020,
      "end_ms": 136295,
      "text": "走着陡峭山路，",
      "token_start": 490,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 136850,
      "end_ms": 138030,
      "text": "身子骨清瘦，",
      "token_start": 496,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 138230,
      "end_ms": 139095,
      "text": "却极硬朗，",
      "token_start": 501,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 139820,
      "end_ms": 141545,
      "text": "把日子过成了山水诗。",
      "token_start": 505,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 142140,
      "end_ms": 143385,
      "text": "这不仅是长寿，",
      "token_start": 514,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 143860,
      "end_ms": 146505,
      "text": "更是一种沁透风骨的人文雅致。",
      "token_start": 520,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 146930,
      "end_ms": 147595,
      "text": "第三名，",
      "token_start": 533,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 148110,
      "end_ms": 153385,
      "text": "河南夏邑彭楼村黄河顾道府地的中原村落，",
      "token_start": 536,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 154010,
      "end_ms": 156545,
      "text": "在这片厚重的中原大地上，",
      "token_start": 554,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 157030,
      "end_ms": 162085,
      "text": "全村千余口人、八九十岁的高瘦长者随处可见，",
      "token_start": 565,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 162630,
      "end_ms": 165035,
      "text": "是名扬中原的孝善之乡。",
      "token_start": 584,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 165450,
      "end_ms": 167095,
      "text": "这里没有奇山异水，",
      "token_start": 594,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 167520,
      "end_ms": 171815,
      "text": "千百年来靠着一犁一耙在黄土地里讨生活。",
      "token_start": 602,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 172300,
      "end_ms": 173400,
      "text": "您走在彭楼村，",
      "token_start": 620,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 173400,
      "end_ms": 174685,
      "text": "宽敞的水泥路上，",
      "token_start": 626,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 175560,
      "end_ms": 178355,
      "text": "正午的太阳暖融融的洒在砖墙上，",
      "token_start": 633,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 179070,
      "end_ms": 183015,
      "text": "年轻媳妇端着热腾腾的手擀面送到老人床前，",
      "token_start": 647,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 183660,
      "end_ms": 184920,
      "text": "街坊四邻路过，",
      "token_start": 666,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 185040,
      "end_ms": 186040,
      "text": "都要停下来，",
      "token_start": 672,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 186100,
      "end_ms": 186855,
      "text": "嘘寒问暖。",
      "token_start": 677,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 187300,
      "end_ms": 187855,
      "text": "在这里，",
      "token_start": 681,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 188220,
      "end_ms": 190275,
      "text": "谁家要是对老人不敬，",
      "token_start": 684,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 190680,
      "end_ms": 193795,
      "text": "连脊梁骨都会被全村人戳破。",
      "token_start": 693,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 194470,
      "end_ms": 196915,
      "text": "中原大地的敦厚家风，",
      "token_start": 705,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 197350,
      "end_ms": 202695,
      "text": "硬是把孝悌二字化成了老人心头最踏实的定心丸。",
      "token_start": 714,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 203050,
      "end_ms": 203715,
      "text": "第二名，",
      "token_start": 735,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 204240,
      "end_ms": 214275,
      "text": "广西河池巴马县贾转镇平安村八盘屯闻名中外的巴马核心长寿村盘阳河绕村而过，",
      "token_start": 738,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 214700,
      "end_ms": 220615,
      "text": "全屯五百多口人百岁健在的老人比例高居全国前列。",
      "token_start": 773,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 221030,
      "end_ms": 221955,
      "text": "几十年来，",
      "token_start": 795,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 222460,
      "end_ms": 225465,
      "text": "来自全国各地的探访者踏破了门槛，",
      "token_start": 799,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 226080,
      "end_ms": 232545,
      "text": "人们把这里的山泉水、空气甚至土壤都捧成了神话。",
      "token_start": 814,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 232980,
      "end_ms": 237015,
      "text": "您漫步在巴盘屯依山傍水的沿河栈道上，",
      "token_start": 835,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 237490,
      "end_ms": 240565,
      "text": "满眼是喀斯特地貌的秀丽风丛。",
      "token_start": 852,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 241130,
      "end_ms": 243615,
      "text": "百岁老人盘腿坐在竹席上，",
      "token_start": 865,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 244050,
      "end_ms": 247275,
      "text": "神态宁静的看着熙熙攘攘的游客。",
      "token_start": 876,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 247750,
      "end_ms": 249885,
      "text": "在几乎所有人的心里，",
      "token_start": 890,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 250220,
      "end_ms": 253565,
      "text": "巴马就是中国长寿村无可争议的天花板。",
      "token_start": 899,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 254350,
      "end_ms": 257725,
      "text": "可如果连名满天下的巴马都只能排在第二，",
      "token_start": 916,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 258210,
      "end_ms": 260875,
      "text": "那力压他的第一名到底长什么样？",
      "token_start": 934,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 261240,
      "end_ms": 261885,
      "text": "先别急，",
      "token_start": 948,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 262420,
      "end_ms": 263115,
      "text": "聊到这儿，",
      "token_start": 951,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 263500,
      "end_ms": 264925,
      "text": "我先唠几句心里话。",
      "token_start": 955,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 265710,
      "end_ms": 267495,
      "text": "前面看完了九个村子，",
      "token_start": 963,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 268020,
      "end_ms": 270285,
      "text": "其实大家心里真正在琢磨的，",
      "token_start": 972,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 270920,
      "end_ms": 273825,
      "text": "恐怕不是那些地方风景有多好，",
      "token_start": 984,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 274470,
      "end_ms": 277005,
      "text": "而是他们怎么能过得这么硬朗。",
      "token_start": 997,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 277450,
      "end_ms": 278490,
      "text": "看着视频里，",
      "token_start": 1010,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 278490,
      "end_ms": 282735,
      "text": "那些八九十岁的老太太挑着一担菜篮，",
      "token_start": 1015,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 283190,
      "end_ms": 285165,
      "text": "还能稳稳迈过门槛儿。",
      "token_start": 1031,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 285840,
      "end_ms": 288680,
      "text": "八十多岁的老汉站在海滩边，",
      "token_start": 1040,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 288700,
      "end_ms": 290975,
      "text": "拉网手脚照样麻利。",
      "token_start": 1052,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 291600,
      "end_ms": 294735,
      "text": "九十多岁的老阿婆坐在院儿里，",
      "token_start": 1060,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 294990,
      "end_ms": 296835,
      "text": "剥着花生手指头，",
      "token_start": 1073,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 297140,
      "end_ms": 298045,
      "text": "一点都不含糊。",
      "token_start": 1080,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 298730,
      "end_ms": 300095,
      "text": "到了咱们这个年岁。",
      "token_start": 1086,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 300530,
      "end_ms": 302450,
      "text": "心里其实比谁都清楚，",
      "token_start": 1094,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 302970,
      "end_ms": 304650,
      "text": "这哪是普通的劳作，",
      "token_start": 1103,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 305110,
      "end_ms": 306750,
      "text": "这是天大的福气，",
      "token_start": 1111,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 307310,
      "end_ms": 309030,
      "text": "更是实打实的硬朗。",
      "token_start": 1118,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 309630,
      "end_ms": 312890,
      "text": "可回过头来看看咱们自己走两步路，",
      "token_start": 1126,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 312890,
      "end_ms": 315810,
      "text": "容易觉得发沉有点重东西，",
      "token_start": 1141,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 315970,
      "end_ms": 316990,
      "text": "手腕使不上劲，",
      "token_start": 1152,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 317630,
      "end_ms": 319330,
      "text": "拎时蹲下去系个鞋带，",
      "token_start": 1158,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 319710,
      "end_ms": 321830,
      "text": "起身都得扶着膝盖缓上半天。",
      "token_start": 1167,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 321830,
      "end_ms": 323790,
      "text": "这真不是咱们偷懒。",
      "token_start": 1179,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 323790,
      "end_ms": 328350,
      "text": "这这半辈子来来哪一天不是在为工作操心，",
      "token_start": 1187,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 328710,
      "end_ms": 329790,
      "text": "为儿女忙活，",
      "token_start": 1205,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 330440,
      "end_ms": 333160,
      "text": "整天光顾着照顾全家老小，",
      "token_start": 1210,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 333620,
      "end_ms": 335940,
      "text": "唯独忘了顾一顾自个儿等。",
      "token_start": 1221,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 335960,
      "end_ms": 338060,
      "text": "好不容易能歇口气了，",
      "token_start": 1232,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 338400,
      "end_ms": 341300,
      "text": "才发觉身子骨早已不如当年了，",
      "token_start": 1241,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 341580,
      "end_ms": 346980,
      "text": "咱们不怕年岁见长净正怕的是往后日子里，",
      "token_start": 1254,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 347020,
      "end_ms": 348480,
      "text": "腿脚不听使唤，",
      "token_start": 1272,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 348980,
      "end_ms": 350760,
      "text": "样样都要人照应，",
      "token_start": 1278,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 351180,
      "end_ms": 353020,
      "text": "净给孩子们添负担。",
      "token_start": 1285,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 353740,
      "end_ms": 357220,
      "text": "前阵子我读到一本书叫超越百岁。",
      "token_start": 1293,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 357580,
      "end_ms": 358060,
      "text": "作者，",
      "token_start": 1307,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 358160,
      "end_ms": 360310,
      "text": "彼得阿提亚是一位长腿，",
      "token_start": 1309,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 360430,
      "end_ms": 363555,
      "text": "其深耕健康科学领域的研究者。",
      "token_start": 1319,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 363970,
      "end_ms": 366835,
      "text": "这本书不叫咱们怎么找好山好水，",
      "token_start": 1332,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 367340,
      "end_ms": 369135,
      "text": "他就讲明白一件事，",
      "token_start": 1346,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 369700,
      "end_ms": 371125,
      "text": "人上了岁数，",
      "token_start": 1354,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 371860,
      "end_ms": 376715,
      "text": "到底怎样才能踏踏实实守住自己生活自理的尊严。",
      "token_start": 1359,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 377170,
      "end_ms": 382465,
      "text": "作者在书里梳理出了一套非常实在的日常活动和起居方法。",
      "token_start": 1380,
      "token_end_exclusive": 1405
    },
    {
      "start_ms": 383060,
      "end_ms": 387875,
      "text": "教咱们怎么把力气和底子一点点打扎实。",
      "token_start": 1405,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 388300,
      "end_ms": 390635,
      "text": "前面九个村子的老人家，",
      "token_start": 1422,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 390960,
      "end_ms": 395375,
      "text": "那是祖祖辈辈在田间地头自然而然过出来的硬朗，",
      "token_start": 1432,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 395980,
      "end_ms": 399605,
      "text": "可咱们普通人没有那个环境到底该怎么做？",
      "token_start": 1453,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 400100,
      "end_ms": 403515,
      "text": "这本书里讲的也不是什么深奥的大道理，",
      "token_start": 1471,
      "token_end_exclusive": 1488
    },
    {
      "start_ms": 403910,
      "end_ms": 408095,
      "text": "而是一整套清清楚楚的日常生活指引。",
      "token_start": 1488,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 408960,
      "end_ms": 411865,
      "text": "从平时怎么把筋骨力道活动到位，",
      "token_start": 1504,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 412360,
      "end_ms": 415110,
      "text": "怎么吃的顺口到上了岁数，",
      "token_start": 1518,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 415150,
      "end_ms": 416775,
      "text": "怎么把心宽下来，",
      "token_start": 1529,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 417240,
      "end_ms": 418700,
      "text": "作者全给拆成了，",
      "token_start": 1536,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 418700,
      "end_ms": 421180,
      "text": "在家里就能照着做的明白。",
      "token_start": 1543,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 421220,
      "end_ms": 425755,
      "text": "步骤书里甚至列了一份晚年自理的对照清单，",
      "token_start": 1554,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 426450,
      "end_ms": 430075,
      "text": "让咱们对照着自己往后想保持的状态，",
      "token_start": 1573,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 430570,
      "end_ms": 433745,
      "text": "一步一步把平时的身体底子打扎实。",
      "token_start": 1589,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 434150,
      "end_ms": 436715,
      "text": "这本书我在商品橱窗也备了一份，",
      "token_start": 1604,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 437190,
      "end_ms": 439890,
      "text": "感兴趣的朋友点开我的头像，",
      "token_start": 1618,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 440050,
      "end_ms": 444235,
      "text": "进入主页进去看看咱们住不进长寿村，",
      "token_start": 1630,
      "token_end_exclusive": 1646
    },
    {
      "start_ms": 444660,
      "end_ms": 448305,
      "text": "但可以把那份硬朗活法装进自己的屋里。",
      "token_start": 1646,
      "token_end_exclusive": 1663
    },
    {
      "start_ms": 448700,
      "end_ms": 450235,
      "text": "好说回正题，",
      "token_start": 1663,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 450700,
      "end_ms": 455365,
      "text": "第一名新疆和田拉依苏村为什么是他？",
      "token_start": 1668,
      "token_end_exclusive": 1684
    },
    {
      "start_ms": 456050,
      "end_ms": 458115,
      "text": "因为在所有人的认知里，",
      "token_start": 1684,
      "token_end_exclusive": 1694
    },
    {
      "start_ms": 458450,
      "end_ms": 460845,
      "text": "长寿必须依山傍水，",
      "token_start": 1694,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 461170,
      "end_ms": 461945,
      "text": "气候宜人。",
      "token_start": 1702,
      "token_end_exclusive": 1706
    },
    {
      "start_ms": 462380,
      "end_ms": 469255,
      "text": "克拉伊苏村偏偏坐落在塔克拉玛干大沙漠南园昆仑山北路的风沙带上，",
      "token_start": 1706,
      "token_end_exclusive": 1736
    },
    {
      "start_ms": 469660,
      "end_ms": 470605,
      "text": "放眼望去，",
      "token_start": 1736,
      "token_end_exclusive": 1740
    },
    {
      "start_ms": 471030,
      "end_ms": 474175,
      "text": "四周全是连绵起伏的黄色沙丘，",
      "token_start": 1740,
      "token_end_exclusive": 1753
    },
    {
      "start_ms": 474890,
      "end_ms": 477035,
      "text": "年降水量不足四十毫米，",
      "token_start": 1753,
      "token_end_exclusive": 1763
    },
    {
      "start_ms": 477480,
      "end_ms": 480235,
      "text": "蒸发量却高达两千多毫米。",
      "token_start": 1763,
      "token_end_exclusive": 1774
    },
    {
      "start_ms": 480660,
      "end_ms": 483405,
      "text": "可就在这片极度干旱的土地上，",
      "token_start": 1774,
      "token_end_exclusive": 1787
    },
    {
      "start_ms": 484050,
      "end_ms": 487610,
      "text": "几十位年过九旬甚至百岁的老人，",
      "token_start": 1787,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 487670,
      "end_ms": 488875,
      "text": "不仅思维清晰，",
      "token_start": 1801,
      "token_end_exclusive": 1807
    },
    {
      "start_ms": 489170,
      "end_ms": 490195,
      "text": "还能下地劳作。",
      "token_start": 1807,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 490640,
      "end_ms": 494100,
      "text": "昆仑山的冰川融水穿过茫茫沙海，",
      "token_start": 1813,
      "token_end_exclusive": 1827
    },
    {
      "start_ms": 494180,
      "end_ms": 495665,
      "text": "滋养出这片绿洲。",
      "token_start": 1827,
      "token_end_exclusive": 1834
    },
    {
      "start_ms": 496260,
      "end_ms": 498660,
      "text": "老人们世代在低矮的生土，",
      "token_start": 1834,
      "token_end_exclusive": 1845
    },
    {
      "start_ms": 498660,
      "end_ms": 500205,
      "text": "屋前种植核桃，",
      "token_start": 1845,
      "token_end_exclusive": 1851
    },
    {
      "start_ms": 500630,
      "end_ms": 501625,
      "text": "打理葡萄，",
      "token_start": 1851,
      "token_end_exclusive": 1855
    },
    {
      "start_ms": 502020,
      "end_ms": 503740,
      "text": "您顶着大漠干燥的热浪，",
      "token_start": 1855,
      "token_end_exclusive": 1865
    },
    {
      "start_ms": 503740,
      "end_ms": 505105,
      "text": "走进村落深处，",
      "token_start": 1865,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 505580,
      "end_ms": 510045,
      "text": "几位蓄着白胡须的维吾尔族老汉正坐在老核桃树下，",
      "token_start": 1871,
      "token_end_exclusive": 1893
    },
    {
      "start_ms": 510510,
      "end_ms": 512865,
      "text": "手里弹拨着热瓦捕琴，",
      "token_start": 1893,
      "token_end_exclusive": 1902
    },
    {
      "start_ms": 513630,
      "end_ms": 516215,
      "text": "随性唱起欢快的大漠民谣，",
      "token_start": 1902,
      "token_end_exclusive": 1913
    },
    {
      "start_ms": 516730,
      "end_ms": 519935,
      "text": "甚至兴致一来还能踩到鼓点转上几个圈。",
      "token_start": 1913,
      "token_end_exclusive": 1930
    },
    {
      "start_ms": 520470,
      "end_ms": 522795,
      "text": "他们没有温润如春的气候，",
      "token_start": 1930,
      "token_end_exclusive": 1941
    },
    {
      "start_ms": 523140,
      "end_ms": 525245,
      "text": "也没有名贵药材的滋补，",
      "token_start": 1941,
      "token_end_exclusive": 1951
    },
    {
      "start_ms": 525910,
      "end_ms": 529690,
      "text": "靠着昆仑雪水和骨子里的乐观旷达，",
      "token_start": 1951,
      "token_end_exclusive": 1966
    },
    {
      "start_ms": 530090,
      "end_ms": 534535,
      "text": "在生命禁区的边缘活出了最顽强的奇迹。",
      "token_start": 1966,
      "token_end_exclusive": 1983
    },
    {
      "start_ms": 534990,
      "end_ms": 539865,
      "text": "他彻底击碎了长寿直属于江南水乡的偏见。",
      "token_start": 1983,
      "token_end_exclusive": 2001
    },
    {
      "start_ms": 540450,
      "end_ms": 543350,
      "text": "凭这份不可思议的生命韧劲，",
      "token_start": 2001,
      "token_end_exclusive": 2013
    },
    {
      "start_ms": 543570,
      "end_ms": 544610,
      "text": "他排在第一，",
      "token_start": 2013,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 544990,
      "end_ms": 545750,
      "text": "实至名归。",
      "token_start": 2018,
      "token_end_exclusive": 2022
    },
    {
      "start_ms": 546110,
      "end_ms": 548850,
      "text": "十座村庄讲完了长青村，",
      "token_start": 2022,
      "token_end_exclusive": 2032
    },
    {
      "start_ms": 548910,
      "end_ms": 551430,
      "text": "在平原上安居三山，",
      "token_start": 2032,
      "token_end_exclusive": 2040
    },
    {
      "start_ms": 551490,
      "end_ms": 552490,
      "text": "倒在海浪里，",
      "token_start": 2040,
      "token_end_exclusive": 2045
    },
    {
      "start_ms": 552490,
      "end_ms": 553290,
      "text": "打捞硬骨。",
      "token_start": 2045,
      "token_end_exclusive": 2049
    },
    {
      "start_ms": 553750,
      "end_ms": 556269,
      "text": "石鼓村在土楼中聚足而居，",
      "token_start": 2049,
      "token_end_exclusive": 2060
    },
    {
      "start_ms": 556790,
      "end_ms": 565610,
      "text": "漫水村把苗歌传了百年石坪村守着千年银杏与家风青秀村泡着盖碗茶享清闲。",
      "token_start": 2060,
      "token_end_exclusive": 2093
    },
    {
      "start_ms": 566270,
      "end_ms": 568990,
      "text": "林坑村把日子过成了山水诗。",
      "token_start": 2093,
      "token_end_exclusive": 2105
    },
    {
      "start_ms": 568990,
      "end_ms": 572760,
      "text": "彭州村用孝涕暖透了中原，",
      "token_start": 2105,
      "token_end_exclusive": 2116
    },
    {
      "start_ms": 572800,
      "end_ms": 576960,
      "text": "黄土巴马在秀丽山水间成就了传奇，",
      "token_start": 2116,
      "token_end_exclusive": 2131
    },
    {
      "start_ms": 577400,
      "end_ms": 581920,
      "text": "可只有新疆拉依苏村把家安在了漫天黄沙的边缘，",
      "token_start": 2131,
      "token_end_exclusive": 2152
    },
    {
      "start_ms": 582740,
      "end_ms": 587420,
      "text": "却用热瓦浦的琴声与昆仑雪水在干旱的大漠里，",
      "token_start": 2152,
      "token_end_exclusive": 2172
    },
    {
      "start_ms": 587540,
      "end_ms": 589100,
      "text": "活出了生命的倔强。",
      "token_start": 2172,
      "token_end_exclusive": 2180
    },
    {
      "start_ms": 589520,
      "end_ms": 590960,
      "text": "您说什么叫不可思议？",
      "token_start": 2180,
      "token_end_exclusive": 2189
    },
    {
      "start_ms": 591380,
      "end_ms": 592800,
      "text": "最不可思议的，",
      "token_start": 2189,
      "token_end_exclusive": 2195
    },
    {
      "start_ms": 593280,
      "end_ms": 596460,
      "text": "从来不是躲在风调雨顺的温室里，",
      "token_start": 2195,
      "token_end_exclusive": 2209
    },
    {
      "start_ms": 596820,
      "end_ms": 602590,
      "text": "而是在任何艰难的泥土上都能笑对风霜、向阳而生。",
      "token_start": 2209,
      "token_end_exclusive": 2230
    },
    {
      "start_ms": 603350,
      "end_ms": 604630,
      "text": "最后问您一句，",
      "token_start": 2230,
      "token_end_exclusive": 2236
    },
    {
      "start_ms": 605290,
      "end_ms": 610130,
      "text": "这十个长寿村您去过几个最想去哪一个？",
      "token_start": 2236,
      "token_end_exclusive": 2253
    },
    {
      "start_ms": 610830,
      "end_ms": 612230,
      "text": "评论区告诉我。",
      "token_start": 2253,
      "token_end_exclusive": 2259
    },
    {
      "start_ms": 612870,
      "end_ms": 615050,
      "text": "刚才说的那本超越百岁，",
      "token_start": 2259,
      "token_end_exclusive": 2269
    },
    {
      "start_ms": 615630,
      "end_ms": 617190,
      "text": "我搁商品橱窗了，",
      "token_start": 2269,
      "token_end_exclusive": 2276
    },
    {
      "start_ms": 617610,
      "end_ms": 618930,
      "text": "点开我的头像，",
      "token_start": 2276,
