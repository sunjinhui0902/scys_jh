  "segments": [
    {
      "start_ms": 190,
      "end_ms": 2610,
      "text": "人一定要和见得了自己好的人在一起，",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 2850,
      "end_ms": 4710,
      "text": "和有情有义的人在一起，",
      "token_start": 16,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5190,
      "end_ms": 6930,
      "text": "和彼此尊重的人在一起，",
      "token_start": 26,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 7210,
      "end_ms": 8950,
      "text": "和心疼你的人在一起，",
      "token_start": 36,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 9710,
      "end_ms": 11050,
      "text": "和喜欢的人在一起，",
      "token_start": 45,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 11150,
      "end_ms": 13510,
      "text": "是大补和快乐的人在一起，",
      "token_start": 53,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 13630,
      "end_ms": 16070,
      "text": "是养生和善良的人在一起，",
      "token_start": 64,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 16070,
      "end_ms": 16670,
      "text": "是养寿。",
      "token_start": 75,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 17030,
      "end_ms": 18530,
      "text": "和优雅的人在一起，",
      "token_start": 78,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 18930,
      "end_ms": 19670,
      "text": "是养德。",
      "token_start": 86,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 20610,
      "end_ms": 21870,
      "text": "因为人这一辈子啊，",
      "token_start": 89,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 21870,
      "end_ms": 23970,
      "text": "相处靠的一定不是技巧，",
      "token_start": 97,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 24250,
      "end_ms": 27390,
      "text": "而是真诚、善良和彼此的仰望。",
      "token_start": 107,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 28110,
      "end_ms": 29815,
      "text": "他们不会在你低谷时转生，",
      "token_start": 119,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 30220,
      "end_ms": 32000,
      "text": "更不会在你高光时失衡。",
      "token_start": 130,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 32280,
      "end_ms": 32660,
      "text": "你看，",
      "token_start": 140,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 32880,
      "end_ms": 34080,
      "text": "这份双向的真诚，",
      "token_start": 142,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 34380,
      "end_ms": 37625,
      "text": "才是人这一生最值得奔赴的关系。",
      "token_start": 149,
      "token_end_exclusive": 163
    }
