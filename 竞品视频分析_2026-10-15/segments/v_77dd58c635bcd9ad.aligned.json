{
  "video_id": "v_77dd58c635bcd9ad",
  "duration_s": 568.796009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_77dd58c635bcd9ad.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_77dd58c635bcd9ad.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 390,
      "end_ms": 1330,
      "text": "我爸妈说了，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 2210,
      "end_ms": 3510,
      "text": "结婚彩礼一口价，",
      "token_start": 5,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 3510,
      "end_ms": 4190,
      "text": "六十八万，",
      "token_start": 12,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 5090,
      "end_ms": 7790,
      "text": "市中心新房必须加上我的名字，",
      "token_start": 16,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 8310,
      "end_ms": 8890,
      "text": "少一样，",
      "token_start": 29,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 8890,
      "end_ms": 9870,
      "text": "这婚就结不成。",
      "token_start": 32,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 10650,
      "end_ms": 11070,
      "text": "姑娘，",
      "token_start": 38,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 11410,
      "end_ms": 14370,
      "text": "这这我们老两口一辈子攒的积蓄，",
      "token_start": 40,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 14630,
      "end_ms": 15150,
      "text": "撑死了，",
      "token_start": 54,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 15150,
      "end_ms": 15990,
      "text": "也就够个首付。",
      "token_start": 57,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 16330,
      "end_ms": 17930,
      "text": "彩礼能不能少点儿？",
      "token_start": 63,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 17930,
      "end_ms": 21290,
      "text": "给你们两个孩子留点过日子的钱，",
      "token_start": 71,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 21290,
      "end_ms": 22970,
      "text": "留着过日子。",
      "token_start": 85,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 22970,
      "end_ms": 23450,
      "text": "陈梦，",
      "token_start": 90,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 23450,
      "end_ms": 24550,
      "text": "没钱就别冲大头，",
      "token_start": 92,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 24550,
      "end_ms": 25210,
      "text": "娶媳妇儿，",
      "token_start": 99,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 25210,
      "end_ms": 26570,
      "text": "六十八万都拿不出来。",
      "token_start": 103,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 26570,
      "end_ms": 28550,
      "text": "你们家是打算空手套狼狼呢？",
      "token_start": 112,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 28550,
      "end_ms": 30560,
      "text": "真穷穷的可可唐伟，",
      "token_start": 124,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 31320,
      "end_ms": 33300,
      "text": "这是商量结婚不是做买卖，",
      "token_start": 132,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 33380,
      "end_ms": 35080,
      "text": "你非要在长辈面前这么逼人吗？",
      "token_start": 143,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 35140,
      "end_ms": 39000,
      "text": "商量没这个家底就别耽误我这婚谁爱结谁结，",
      "token_start": 156,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 39320,
      "end_ms": 40195,
      "text": "我先寒碜。",
      "token_start": 175,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 47020,
      "end_ms": 50185,
      "text": "小莫妈是不是做错事了？",
      "token_start": 179,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 53710,
      "end_ms": 54370,
      "text": "我听说了，",
      "token_start": 189,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 54710,
      "end_ms": 56405,
      "text": "真因为彩礼房子的事儿分了，",
      "token_start": 193,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 58570,
      "end_ms": 60515,
      "text": "张口就要六十八万加新房，",
      "token_start": 205,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 61230,
      "end_ms": 62715,
      "text": "把感情当买卖算账，",
      "token_start": 216,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 63280,
      "end_ms": 66835,
      "text": "谈下去也是灾难彻底分了分的好，",
      "token_start": 224,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 67300,
      "end_ms": 68405,
      "text": "三观不正走不远。",
      "token_start": 238,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 68860,
      "end_ms": 70760,
      "text": "我有个大学同学叫苏晴人，",
      "token_start": 245,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 70760,
      "end_ms": 71500,
      "text": "特别明事理，",
      "token_start": 256,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 71560,
      "end_ms": 72625,
      "text": "性格极其温和，",
      "token_start": 261,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 72890,
      "end_ms": 75695,
      "text": "介绍你俩认识一下算了。",
      "token_start": 267,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 76230,
      "end_ms": 77825,
      "text": "我现在真没心思应付相亲，",
      "token_start": 277,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 78230,
      "end_ms": 79825,
      "text": "就当普通朋友吃个工作餐，",
      "token_start": 288,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 80210,
      "end_ms": 81250,
      "text": "聊得来就处聊，",
      "token_start": 299,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 81250,
      "end_ms": 82655,
      "text": "不来多个人脉去见一面。",
      "token_start": 305,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 90730,
      "end_ms": 91010,
      "text": "你好，",
      "token_start": 315,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 91010,
      "end_ms": 91495,
      "text": "沉默，",
      "token_start": 317,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 92150,
      "end_ms": 92990,
      "text": "路上有点堵，",
      "token_start": 319,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 93050,
      "end_ms": 93995,
      "text": "没耽误你时间吧。",
      "token_start": 324,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 94390,
      "end_ms": 94770,
      "text": "没有，",
      "token_start": 331,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 95130,
      "end_ms": 95755,
      "text": "我也刚到，",
      "token_start": 333,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 96440,
      "end_ms": 98120,
      "text": "我看他们家菜量挺扎实的，",
      "token_start": 337,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 98180,
      "end_ms": 100540,
      "text": "我们两个人点两菜一汤就差不多了别浪费。",
      "token_start": 348,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 100720,
      "end_ms": 101740,
      "text": "等会儿要是不够，",
      "token_start": 366,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 101740,
      "end_ms": 108220,
      "text": "咱们再加澳洲和牛葱烧海参全点上出来吃饭，",
      "token_start": 373,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 108480,
      "end_ms": 110280,
      "text": "讲究的就是排场点，",
      "token_start": 392,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 110280,
      "end_ms": 111815,
      "text": "少了发朋友圈我都嫌丢人。",
      "token_start": 400,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 112680,
      "end_ms": 113235,
      "text": "怎么了？",
      "token_start": 411,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 113830,
      "end_ms": 114935,
      "text": "是有什么忌口吗？",
      "token_start": 414,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 115980,
      "end_ms": 116405,
      "text": "没有，",
      "token_start": 421,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 116750,
      "end_ms": 117655,
      "text": "这样点特别好。",
      "token_start": 423,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 119440,
      "end_ms": 120945,
      "text": "我能问个比较现实的问题吗？",
      "token_start": 429,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 121270,
      "end_ms": 124050,
      "text": "你对男方的彩礼和买房有什么硬性门槛吗？",
      "token_start": 441,
      "token_end_exclusive": 459
    },
    {
      "start_ms": 124150,
      "end_ms": 124930,
      "text": "人品端正，",
      "token_start": 459,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 125130,
      "end_ms": 126950,
      "text": "有份踏实的工作能养活自己，",
      "token_start": 463,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 127010,
      "end_ms": 128025,
      "text": "没有不良债务。",
      "token_start": 475,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 128410,
      "end_ms": 130150,
      "text": "至于房子车子有，",
      "token_start": 481,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 130150,
      "end_ms": 131085,
      "text": "当然是加分项，",
      "token_start": 488,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 131550,
      "end_ms": 131950,
      "text": "没有，",
      "token_start": 494,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 132010,
      "end_ms": 133070,
      "text": "就两个人一起努力，",
      "token_start": 496,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 133070,
      "end_ms": 134045,
      "text": "攒钱付首付，",
      "token_start": 504,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 134450,
      "end_ms": 136745,
      "text": "普通人不都是这么一步一步过来的吗？",
      "token_start": 509,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 138200,
      "end_ms": 138960,
      "text": "就这么简单。",
      "token_start": 525,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 139280,
      "end_ms": 140205,
      "text": "这可不简单，",
      "token_start": 530,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 140660,
      "end_ms": 141560,
      "text": "踏实有担当，",
      "token_start": 535,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 141640,
      "end_ms": 143255,
      "text": "比现成的东西难找多了。",
      "token_start": 540,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 143690,
      "end_ms": 145615,
      "text": "不过我自己的原则也不低，",
      "token_start": 550,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 146190,
      "end_ms": 148515,
      "text": "比如遇事多沟通不翻旧账。",
      "token_start": 561,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 148860,
      "end_ms": 149720,
      "text": "最关键的是，",
      "token_start": 572,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 149740,
      "end_ms": 150440,
      "text": "结婚以后，",
      "token_start": 577,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 150440,
      "end_ms": 152055,
      "text": "咱们是独立经营的小家庭，",
      "token_start": 581,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 152380,
      "end_ms": 152980,
      "text": "大事小情，",
      "token_start": 592,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 152980,
      "end_ms": 154360,
      "text": "两个人商量着拿主意，",
      "token_start": 596,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 154500,
      "end_ms": 155565,
      "text": "互为第一顺位，",
      "token_start": 605,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 155870,
      "end_ms": 157865,
      "text": "绝不能无原则的当传声筒。",
      "token_start": 611,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 159700,
      "end_ms": 160860,
      "text": "车开了挺多年了，",
      "token_start": 622,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 160880,
      "end_ms": 162365,
      "text": "有点旧别见怪。",
      "token_start": 629,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 163230,
      "end_ms": 165295,
      "text": "车就是个遮风挡雨的代步工具。",
      "token_start": 635,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 166120,
      "end_ms": 166980,
      "text": "底盘扎实，",
      "token_start": 648,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 166980,
      "end_ms": 168565,
      "text": "开着顺手比什么都重要。",
      "token_start": 652,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 173010,
      "end_ms": 177085,
      "text": "不过沉默你右边这个雨刮胶条好像老化翘起来了。",
      "token_start": 662,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 177540,
      "end_ms": 179300,
      "text": "这两天天气预报说有暴雨，",
      "token_start": 683,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 179440,
      "end_ms": 182010,
      "text": "记得下班顺路花几十块换一副雨天，",
      "token_start": 694,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 182010,
      "end_ms": 182590,
      "text": "视线不好，",
      "token_start": 709,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 182590,
      "end_ms": 182890,
      "text": "开车，",
      "token_start": 713,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 182890,
      "end_ms": 183675,
      "text": "太危险了，",
      "token_start": 715,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 186530,
      "end_ms": 189090,
      "text": "天开个破车接我停在我们公司楼下，",
      "token_start": 719,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 189090,
      "end_ms": 189835,
      "text": "我都嫌丢人。",
      "token_start": 734,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 190160,
      "end_ms": 191725,
      "text": "你到底什么时候换奔驰啊？",
      "token_start": 739,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 197010,
      "end_ms": 197870,
      "text": "不是提前说了，",
      "token_start": 750,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 197870,
      "end_ms": 198530,
      "text": "人来就行，",
      "token_start": 756,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 198530,
      "end_ms": 199415,
      "text": "不用破费吗？",
      "token_start": 760,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 199810,
      "end_ms": 202825,
      "text": "第一次登门拜访阿姨空着手多失礼，",
      "token_start": 765,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 203180,
      "end_ms": 203580,
      "text": "挑了点，",
      "token_start": 780,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 203580,
      "end_ms": 204735,
      "text": "您平时用得上的。",
      "token_start": 783,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 205210,
      "end_ms": 206675,
      "text": "你看我们家这条件普通，",
      "token_start": 790,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 207010,
      "end_ms": 210915,
      "text": "家里也没什么贵重东西招待你阿姨心里总觉得委屈了你。",
      "token_start": 800,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 211170,
      "end_ms": 211625,
      "text": "阿姨，",
      "token_start": 824,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 212000,
      "end_ms": 213155,
      "text": "您快别这么说，",
      "token_start": 826,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 213650,
      "end_ms": 215815,
      "text": "陈默常跟我提起您勤劳踏实。",
      "token_start": 832,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 216200,
      "end_ms": 218535,
      "text": "我今天一进门就觉得特别亲切温馨，",
      "token_start": 844,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 219290,
      "end_ms": 220855,
      "text": "一家人踏实过日子，",
      "token_start": 859,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 221180,
      "end_ms": 221880,
      "text": "比什么虚荣，",
      "token_start": 867,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 221880,
      "end_ms": 222955,
      "text": "排场都珍贵。",
      "token_start": 872,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 223330,
      "end_ms": 223965,
      "text": "小苏啊，",
      "token_start": 877,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 224440,
      "end_ms": 225625,
      "text": "阿姨也是直性子，",
      "token_start": 880,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 226030,
      "end_ms": 227010,
      "text": "现在外头结婚，",
      "token_start": 887,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 227110,
      "end_ms": 229735,
      "text": "动不动就要大几十万彩礼全款大平层。",
      "token_start": 893,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 230310,
      "end_ms": 231435,
      "text": "你看我们家这条件，",
      "token_start": 909,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 231690,
      "end_ms": 232870,
      "text": "你家里要是要求高，",
      "token_start": 917,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 232990,
      "end_ms": 234505,
      "text": "我真怕拖了沉默后腿。",
      "token_start": 925,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 235140,
      "end_ms": 237775,
      "text": "阿姨彩礼是对女方家庭的一份尊重，",
      "token_start": 934,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 238070,
      "end_ms": 239785,
      "text": "但绝不是拿来明码标价的买卖。",
      "token_start": 949,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 240120,
      "end_ms": 241280,
      "text": "两个踏实过日子的人，",
      "token_start": 962,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 241300,
      "end_ms": 242320,
      "text": "最重要的不是县城。",
      "token_start": 971,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 242320,
      "end_ms": 243125,
      "text": "有多少家底，",
      "token_start": 979,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 243360,
      "end_ms": 245120,
      "text": "而是两个人能不能同心协力，",
      "token_start": 984,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 245220,
      "end_ms": 246360,
      "text": "只要沉默有担当，",
      "token_start": 996,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 246400,
      "end_ms": 246960,
      "text": "心疼人，",
      "token_start": 1003,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 247220,
      "end_ms": 248340,
      "text": "我们两个人一起打拼，",
      "token_start": 1006,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 248340,
      "end_ms": 250815,
      "text": "攒的首付住起来比谁给的都踏实。",
      "token_start": 1015,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 251130,
      "end_ms": 252395,
      "text": "日子是过给自己的，",
      "token_start": 1029,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 252610,
      "end_ms": 253310,
      "text": "只要新奇，",
      "token_start": 1037,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 253490,
      "end_ms": 254190,
      "text": "别人有的，",
      "token_start": 1041,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 254250,
      "end_ms": 256190,
      "text": "我们迟早都会有听见。",
      "token_start": 1045,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 256190,
      "end_ms": 258380,
      "text": "没有儿子遇到小苏，",
      "token_start": 1054,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 258380,
      "end_ms": 260015,
      "text": "是咱们家天大的福气，",
      "token_start": 1062,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 261090,
      "end_ms": 262135,
      "text": "还是那个客厅，",
      "token_start": 1071,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 262640,
      "end_ms": 263625,
      "text": "还是那份拘谨，",
      "token_start": 1077,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 264260,
      "end_ms": 265905,
      "text": "可换了一个知书达理的人，",
      "token_start": 1083,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 266410,
      "end_ms": 274020,
      "text": "压在母亲心头大半年的石头终于被彻底放下了也不知道你爱吃什么，",
      "token_start": 1094,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 274180,
      "end_ms": 275780,
      "text": "阿姨就随便做了几个菜，",
      "token_start": 1123,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 276020,
      "end_ms": 278205,
      "text": "阿姨这还叫随便做啊。",
      "token_start": 1133,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 278520,
      "end_ms": 279440,
      "text": "这么一大桌子。",
      "token_start": 1142,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 279440,
      "end_ms": 280980,
      "text": "我刚进门就闻到香味儿了，",
      "token_start": 1148,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 282260,
      "end_ms": 283205,
      "text": "你尝尝这个。",
      "token_start": 1159,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 283850,
      "end_ms": 285290,
      "text": "不过阿姨不太会做饭，",
      "token_start": 1164,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 285510,
      "end_ms": 287585,
      "text": "做的肯定没有你妈妈做的好吃。",
      "token_start": 1173,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 288470,
      "end_ms": 288965,
      "text": "阿姨，",
      "token_start": 1186,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 289450,
      "end_ms": 290665,
      "text": "这还真没法比，",
      "token_start": 1188,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 291170,
      "end_ms": 293725,
      "text": "我妈做的是我从小吃到大的家的味道。",
      "token_start": 1194,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 294360,
      "end_ms": 297300,
      "text": "您今天这一桌是知道我要来特意准备的心意，",
      "token_start": 1210,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 297780,
      "end_ms": 298920,
      "text": "一个是家的味道，",
      "token_start": 1229,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 298940,
      "end_ms": 299980,
      "text": "一个是您的心意，",
      "token_start": 1236,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 300200,
      "end_ms": 301540,
      "text": "这哪能放在一起比啊。",
      "token_start": 1243,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 304240,
      "end_ms": 305980,
      "text": "你这姑娘还挺会说话，",
      "token_start": 1252,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 306160,
      "end_ms": 306860,
      "text": "不过阿姨，",
      "token_start": 1261,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 307140,
      "end_ms": 308660,
      "text": "您可别再给我夹菜了，",
      "token_start": 1265,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 309180,
      "end_ms": 310700,
      "text": "怎么不好吃？",
      "token_start": 1274,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 311500,
      "end_ms": 312260,
      "text": "哪能啊？",
      "token_start": 1279,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 312780,
      "end_ms": 314640,
      "text": "我是怕第一次来就吃三碗米，",
      "token_start": 1282,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 315080,
      "end_ms": 318500,
      "text": "下次您听说我要来还得提前多买两斤米，",
      "token_start": 1294,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 318500,
      "end_ms": 322560,
      "text": "还吃是福，",
      "token_start": 1311,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 322560,
      "end_ms": 324850,
      "text": "多吃点儿小苏啊。",
      "token_start": 1315,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 325590,
      "end_ms": 326710,
      "text": "阿姨随口问问，",
      "token_start": 1322,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 326710,
      "end_ms": 327410,
      "text": "你别多心，",
      "token_start": 1328,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 327950,
      "end_ms": 329750,
      "text": "以后要是你跟陈默真组了，",
      "token_start": 1332,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 329750,
      "end_ms": 332015,
      "text": "家庭在你们家谁说了算啊？",
      "token_start": 1343,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 334570,
      "end_ms": 336230,
      "text": "阿姨真成家了，",
      "token_start": 1354,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 336410,
      "end_ms": 336790,
      "text": "大事，",
      "token_start": 1360,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 336790,
      "end_ms": 337570,
      "text": "我肯定多听。",
      "token_start": 1362,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 337570,
      "end_ms": 339590,
      "text": "沉默的陈梦在外面有担当，",
      "token_start": 1367,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 339610,
      "end_ms": 340530,
      "text": "眼光宽大，",
      "token_start": 1378,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 340530,
      "end_ms": 340890,
      "text": "方向，",
      "token_start": 1382,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 340890,
      "end_ms": 341310,
      "text": "她把关，",
      "token_start": 1384,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 341310,
      "end_ms": 341850,
      "text": "我放心，",
      "token_start": 1387,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 342190,
      "end_ms": 343250,
      "text": "平时柴米油盐，",
      "token_start": 1390,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 343250,
      "end_ms": 345070,
      "text": "人情往来的琐事就由我来操心，",
      "token_start": 1396,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 345230,
      "end_ms": 345970,
      "text": "省得她分心。",
      "token_start": 1409,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 346470,
      "end_ms": 347110,
      "text": "但其实，",
      "token_start": 1414,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 347130,
      "end_ms": 348490,
      "text": "不管表面听谁的，",
      "token_start": 1417,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 348770,
      "end_ms": 349930,
      "text": "只要心往一处使，",
      "token_start": 1424,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 350310,
      "end_ms": 351710,
      "text": "把日子过敞亮了，",
      "token_start": 1431,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 351830,
      "end_ms": 353090,
      "text": "谁当家不都一样吗？",
      "token_start": 1438,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 353510,
      "end_ms": 355455,
      "text": "那阿姨再问你最后一个，",
      "token_start": 1446,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 356110,
      "end_ms": 358885,
      "text": "要是以后我和你之间有了分歧矛盾，",
      "token_start": 1456,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 359260,
      "end_ms": 360505,
      "text": "你希望沉默帮谁？",
      "token_start": 1471,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 363810,
      "end_ms": 364185,
      "text": "妈，",
      "token_start": 1478,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 364690,
      "end_ms": 367265,
      "text": "哪有第一次来家里问这个的阿姨，",
      "token_start": 1479,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 367690,
      "end_ms": 368885,
      "text": "真要是有不同意见，",
      "token_start": 1493,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 369140,
      "end_ms": 370965,
      "text": "那肯定得是沉默先帮着您啊。",
      "token_start": 1501,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 374190,
      "end_ms": 378485,
      "text": "您是长辈几十年的生活阅历在那儿真有分歧，",
      "token_start": 1513,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 378890,
      "end_ms": 381145,
      "text": "多半是我年轻考虑的不够周全。",
      "token_start": 1532,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 381640,
      "end_ms": 382265,
      "text": "再说了，",
      "token_start": 1545,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 382540,
      "end_ms": 383380,
      "text": "沉默要是连生，",
      "token_start": 1548,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 383380,
      "end_ms": 385270,
      "text": "他养他的亲妈都不护着我，",
      "token_start": 1554,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 385270,
      "end_ms": 387305,
      "text": "哪敢把自己的后半辈子放心交给他呀。",
      "token_start": 1565,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 387610,
      "end_ms": 388010,
      "text": "哎呀，",
      "token_start": 1581,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 388640,
      "end_ms": 389900,
      "text": "这姑娘真是心善，",
      "token_start": 1583,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 389920,
      "end_ms": 390560,
      "text": "懂事儿的，",
      "token_start": 1590,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 390560,
      "end_ms": 392035,
      "text": "让人心疼沉默。",
      "token_start": 1594,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 392310,
      "end_ms": 393565,
      "text": "你听听人家这格局，",
      "token_start": 1600,
      "token_end_exclusive": 1608
    },
    {
      "start_ms": 393870,
      "end_ms": 394150,
      "text": "以后，",
      "token_start": 1608,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 394150,
      "end_ms": 395190,
      "text": "你要是敢欺负小苏，",
      "token_start": 1610,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 395270,
      "end_ms": 396190,
      "text": "我第一个饶不了，",
      "token_start": 1618,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 396190,
      "end_ms": 403850,
      "text": "你快放下，",
      "token_start": 1625,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 403850,
      "end_ms": 404335,
      "text": "快放下。",
      "token_start": 1629,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 404640,
      "end_ms": 405845,
      "text": "第一次来是贵客，",
      "token_start": 1632,
      "token_end_exclusive": 1639
    },
    {
      "start_ms": 406180,
      "end_ms": 407245,
      "text": "哪能让你洗碗。",
      "token_start": 1639,
      "token_end_exclusive": 1645
    },
    {
      "start_ms": 408050,
      "end_ms": 408410,
      "text": "那行，",
      "token_start": 1645,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 408410,
      "end_ms": 408815,
      "text": "阿姨，",
      "token_start": 1647,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 409350,
      "end_ms": 410350,
      "text": "今天第一趟来，",
      "token_start": 1649,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 410590,
      "end_ms": 412255,
      "text": "我绝对服从长辈安排，",
      "token_start": 1655,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 412570,
      "end_ms": 414275,
      "text": "今天我负责常阿姨的大餐。",
      "token_start": 1664,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 414600,
      "end_ms": 414960,
      "text": "等以后，",
      "token_start": 1675,
      "token_end_exclusive": 1678
    },
    {
      "start_ms": 414960,
      "end_ms": 416180,
      "text": "我和陈默长回来了，",
      "token_start": 1678,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 416260,
      "end_ms": 419060,
      "text": "厨房里的油烟杂活全都交给我们俩您啊，",
      "token_start": 1686,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 419060,
      "end_ms": 421515,
      "text": "就踏踏实实坐沙发上看电视享清福。",
      "token_start": 1703,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 421920,
      "end_ms": 424950,
      "text": "哈哈哈呵好有你这句话，",
      "token_start": 1718,
      "token_end_exclusive": 1728
    },
    {
      "start_ms": 425170,
      "end_ms": 428260,
      "text": "阿姨心里比吃了蜜还甜啊。",
      "token_start": 1728,
      "token_end_exclusive": 1739
    },
    {
      "start_ms": 428990,
      "end_ms": 431330,
      "text": "以后每个周末都跟陈默回来，",
      "token_start": 1739,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 431510,
      "end_ms": 433525,
      "text": "阿姨随时给你做爱吃的。",
      "token_start": 1751,
      "token_end_exclusive": 1761
    },
    {
      "start_ms": 435980,
      "end_ms": 437225,
      "text": "我现在是真服你了，",
      "token_start": 1761,
      "token_end_exclusive": 1769
    },
    {
      "start_ms": 438650,
      "end_ms": 439175,
      "text": "怎么啦？",
      "token_start": 1769,
      "token_end_exclusive": 1772
    },
    {
      "start_ms": 439970,
      "end_ms": 441905,
      "text": "我妈一进门提到彩礼和房子，",
      "token_start": 1772,
      "token_end_exclusive": 1784
    },
    {
      "start_ms": 442200,
      "end_ms": 443615,
      "text": "一句话就把他说高兴了。",
      "token_start": 1784,
      "token_end_exclusive": 1794
    },
    {
      "start_ms": 444290,
      "end_ms": 444990,
      "text": "吃饭的时候，",
      "token_start": 1794,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 444990,
      "end_ms": 445690,
      "text": "他说做饭没，",
      "token_start": 1799,
      "token_end_exclusive": 1804
    },
    {
      "start_ms": 445690,
      "end_ms": 446505,
      "text": "你妈妈好吃，",
      "token_start": 1804,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 446940,
      "end_ms": 447420,
      "text": "换成我，",
      "token_start": 1809,
      "token_end_exclusive": 1812
    },
    {
      "start_ms": 447420,
      "end_ms": 448425,
      "text": "我都不知道怎么接。",
      "token_start": 1812,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 448700,
      "end_ms": 450580,
      "text": "后面又问你结婚以后谁说了算，",
      "token_start": 1820,
      "token_end_exclusive": 1833
    },
    {
      "start_ms": 450900,
      "end_ms": 452160,
      "text": "还问他跟你闹矛盾了，",
      "token_start": 1833,
      "token_end_exclusive": 1842
    },
    {
      "start_ms": 452160,
      "end_ms": 452995,
      "text": "我应该帮谁？",
      "token_start": 1842,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 453580,
      "end_ms": 455485,
      "text": "我坐旁边听着都替你紧张，",
      "token_start": 1847,
      "token_end_exclusive": 1858
    },
    {
      "start_ms": 458210,
      "end_ms": 459475,
      "text": "你到底是怎么练的？",
      "token_start": 1858,
      "token_end_exclusive": 1866
    },
    {
      "start_ms": 460440,
      "end_ms": 462100,
      "text": "为什么别人突然给你一句话，",
      "token_start": 1866,
      "token_end_exclusive": 1878
    },
    {
      "start_ms": 462100,
      "end_ms": 463515,
      "text": "你马上就知道该怎么接？",
      "token_start": 1878,
      "token_end_exclusive": 1888
    },
    {
      "start_ms": 463910,
      "end_ms": 465425,
      "text": "其实我以前跟你一样，",
      "token_start": 1888,
      "token_end_exclusive": 1897
    },
    {
      "start_ms": 465970,
      "end_ms": 466795,
      "text": "不爱说话，",
      "token_start": 1897,
      "token_end_exclusive": 1901
    },
    {
      "start_ms": 467270,
      "end_ms": 468585,
      "text": "也不知道怎么组织语言，",
      "token_start": 1901,
      "token_end_exclusive": 1911
    },
    {
      "start_ms": 469010,
      "end_ms": 471125,
      "text": "一到这种场合就不知道应该说什么。",
      "token_start": 1911,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 472160,
      "end_ms": 475455,
      "text": "后来我就经常看这本把话说的恰到好处。",
      "token_start": 1926,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 475870,
      "end_ms": 477210,
      "text": "它里面就是一个场景，",
      "token_start": 1943,
      "token_end_exclusive": 1952
    },
    {
      "start_ms": 477210,
      "end_ms": 478575,
      "text": "一个场景的告诉你，",
      "token_start": 1952,
      "token_end_exclusive": 1960
    },
    {
      "start_ms": 478930,
      "end_ms": 481555,
      "text": "遇到不同的人不同的话应该怎么接。",
      "token_start": 1960,
      "token_end_exclusive": 1975
    },
    {
      "start_ms": 482590,
      "end_ms": 484155,
      "text": "比如别人夸你优秀，",
      "token_start": 1975,
      "token_end_exclusive": 1983
    },
    {
      "start_ms": 484450,
      "end_ms": 485225,
      "text": "你可以回，",
      "token_start": 1983,
      "token_end_exclusive": 1987
    },
    {
      "start_ms": 485810,
      "end_ms": 487170,
      "text": "那是不优秀点儿，",
      "token_start": 1987,
      "token_end_exclusive": 1994
    },
    {
      "start_ms": 487170,
      "end_ms": 488535,
      "text": "怎么能和你做朋友呢？",
      "token_start": 1994,
      "token_end_exclusive": 2003
    },
    {
      "start_ms": 488810,
      "end_ms": 490090,
      "text": "当别人说你真聪明，",
      "token_start": 2003,
      "token_end_exclusive": 2011
    },
    {
      "start_ms": 490170,
      "end_ms": 491750,
      "text": "你就回近朱者赤，",
      "token_start": 2011,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 491890,
      "end_ms": 492870,
      "text": "和你在一起啊，",
      "token_start": 2018,
      "token_end_exclusive": 2024
    },
    {
      "start_ms": 492870,
      "end_ms": 495100,
      "text": "熏都熏出来了当领导跟你说，",
      "token_start": 2024,
      "token_end_exclusive": 2036
    },
    {
      "start_ms": 495100,
      "end_ms": 495685,
      "text": "辛苦了，",
      "token_start": 2036,
      "token_end_exclusive": 2039
    },
    {
      "start_ms": 495900,
      "end_ms": 496885,
      "text": "你就回领导，",
      "token_start": 2039,
      "token_end_exclusive": 2044
    },
    {
      "start_ms": 497240,
      "end_ms": 498555,
      "text": "这都是我应该做的。",
      "token_start": 2044,
      "token_end_exclusive": 2052
    },
    {
      "start_ms": 498890,
      "end_ms": 500130,
      "text": "强将手下无弱兵，",
      "token_start": 2052,
      "token_end_exclusive": 2059
    },
    {
      "start_ms": 500270,
      "end_ms": 501710,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 2059,
      "token_end_exclusive": 2068
    },
    {
      "start_ms": 501810,
      "end_ms": 503545,
      "text": "难怪你每次都能接的这么快，",
      "token_start": 2068,
      "token_end_exclusive": 2080
    },
    {
      "start_ms": 504170,
      "end_ms": 505715,
      "text": "这种东西不是天生的，",
      "token_start": 2080,
      "token_end_exclusive": 2089
    },
    {
      "start_ms": 506290,
      "end_ms": 507710,
      "text": "就是平时一个场景，",
      "token_start": 2089,
      "token_end_exclusive": 2097
    },
    {
      "start_ms": 507710,
      "end_ms": 508230,
      "text": "个场景的，",
      "token_start": 2097,
      "token_end_exclusive": 2101
    },
    {
      "start_ms": 508230,
      "end_ms": 509470,
      "text": "看一个场景，",
      "token_start": 2101,
      "token_end_exclusive": 2106
    },
    {
      "start_ms": 509470,
      "end_ms": 510315,
      "text": "一个场景的练。",
      "token_start": 2106,
      "token_end_exclusive": 2112
    },
    {
      "start_ms": 511010,
      "end_ms": 511985,
      "text": "每天看两页，",
      "token_start": 2112,
      "token_end_exclusive": 2117
    },
    {
      "start_ms": 512390,
      "end_ms": 514630,
      "text": "慢慢积累一些不同场景之下，",
      "token_start": 2117,
      "token_end_exclusive": 2129
    },
    {
      "start_ms": 514770,
      "end_ms": 515450,
      "text": "应该怎么说？",
      "token_start": 2129,
      "token_end_exclusive": 2134
    },
    {
      "start_ms": 515850,
      "end_ms": 517975,
      "text": "这里面还有很多生活里的场景，",
      "token_start": 2134,
      "token_end_exclusive": 2147
    },
    {
      "start_ms": 518310,
      "end_ms": 519390,
      "text": "比如对象给你发红包，",
      "token_start": 2147,
      "token_end_exclusive": 2156
    },
    {
      "start_ms": 519390,
      "end_ms": 522365,
      "text": "你可以回你是我致富道路上最大的功臣，",
      "token_start": 2156,
      "token_end_exclusive": 2173
    },
    {
      "start_ms": 522920,
      "end_ms": 523880,
      "text": "同事向你借钱，",
      "token_start": 2173,
      "token_end_exclusive": 2179
    },
    {
      "start_ms": 523980,
      "end_ms": 524855,
      "text": "你又不想借，",
      "token_start": 2179,
      "token_end_exclusive": 2184
    },
    {
      "start_ms": 525220,
      "end_ms": 525775,
      "text": "可以回，",
      "token_start": 2184,
      "token_end_exclusive": 2187
    },
    {
      "start_ms": 526460,
      "end_ms": 527715,
      "text": "大家都是一样的年纪，",
      "token_start": 2187,
      "token_end_exclusive": 2196
    },
    {
      "start_ms": 528070,
      "end_ms": 528755,
      "text": "你没有的，",
      "token_start": 2196,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 528980,
      "end_ms": 529660,
      "text": "我能有吗？",
      "token_start": 2200,
      "token_end_exclusive": 2204
    },
    {
      "start_ms": 529840,
      "end_ms": 532055,
      "text": "还有心仪的人跟你说我想你了，",
      "token_start": 2204,
      "token_end_exclusive": 2217
    },
    {
      "start_ms": 532290,
      "end_ms": 533890,
      "text": "你可以回随便想，",
      "token_start": 2217,
      "token_end_exclusive": 2224
    },
    {
      "start_ms": 534070,
      "end_ms": 535225,
      "text": "千万别跟我客气，",
      "token_start": 2224,
      "token_end_exclusive": 2231
    },
    {
      "start_ms": 535510,
      "end_ms": 536425,
      "text": "目前不收费。",
      "token_start": 2231,
      "token_end_exclusive": 2236
    },
    {
      "start_ms": 536760,
      "end_ms": 537030,
      "text": "嗯，",
      "token_start": 2236,
      "token_end_exclusive": 2237
    },
    {
      "start_ms": 537070,
      "end_ms": 538715,
      "text": "哈呵这个有意思，",
      "token_start": 2237,
      "token_end_exclusive": 2244
    },
    {
      "start_ms": 539010,
      "end_ms": 540390,
      "text": "我第一次读到这些的时候，",
      "token_start": 2244,
      "token_end_exclusive": 2255
    },
    {
      "start_ms": 540390,
      "end_ms": 541955,
      "text": "也有种豁然开朗的感觉。",
      "token_start": 2255,
      "token_end_exclusive": 2265
    },
    {
      "start_ms": 542350,
      "end_ms": 546190,
      "text": "这本书就是把工作、生活、人际交往里经常遇到的场景，",
      "token_start": 2265,
      "token_end_exclusive": 2287
    },
    {
      "start_ms": 546250,
      "end_ms": 547695,
      "text": "一个一个拆开给你看，",
      "token_start": 2287,
      "token_end_exclusive": 2296
    },
    {
      "start_ms": 548120,
      "end_ms": 548880,
      "text": "别人怎么说，",
      "token_start": 2296,
      "token_end_exclusive": 2301
    },
    {
      "start_ms": 549020,
      "end_ms": 549820,
      "text": "你可以怎么接，",
      "token_start": 2301,
      "token_end_exclusive": 2307
    },
    {
      "start_ms": 550060,
      "end_ms": 551395,
      "text": "都是一句一句给你举例。",
      "token_start": 2307,
      "token_end_exclusive": 2317
    },
    {
      "start_ms": 552150,
      "end_ms": 554295,
      "text": "所以你平时就是这么练的对啊，",
      "token_start": 2317,
      "token_end_exclusive": 2330
    },
    {
      "start_ms": 554710,
      "end_ms": 556430,
      "text": "每天不用看很多看两页，",
      "token_start": 2330,
      "token_end_exclusive": 2340
    },
    {
      "start_ms": 556430,
      "end_ms": 559580,
      "text": "碰到自己觉得有用的表达就记一记慢慢积累的多了。",
      "token_start": 2340,
      "token_end_exclusive": 2362
    },
    {
      "start_ms": 559700,
      "end_ms": 561605,
      "text": "工作和生活里再碰到类似的场景，",
      "token_start": 2362,
      "token_end_exclusive": 2376
    },
    {
      "start_ms": 561800,
      "end_ms": 562785,
      "text": "你就知道怎么接了。",
      "token_start": 2376,
      "token_end_exclusive": 2384
    },
    {
      "start_ms": 563130,
      "end_ms": 563590,
      "text": "这本先借，",
      "token_start": 2384,
      "token_end_exclusive": 2388
    },
    {
      "start_ms": 563590,
      "end_ms": 565750,
      "text": "我看看拿去吧，",
      "token_start": 2388,
      "token_end_exclusive": 2394
    },
    {
      "start_ms": 565770,
      "end_ms": 566545,
      "text": "回去慢慢看。",
      "token_start": 2394,
      "token_end_exclusive": 2399
    }
