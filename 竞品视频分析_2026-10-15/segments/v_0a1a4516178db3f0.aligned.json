{
  "video_id": "v_0a1a4516178db3f0",
  "duration_s": 175.518005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_0a1a4516178db3f0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_0a1a4516178db3f0.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 1710,
      "text": "当别人说你真漂亮，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2030,
      "end_ms": 5430,
      "text": "你就说我就喜欢跟你这种品味高的人打交道。",
      "token_start": 8,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 5510,
      "end_ms": 6810,
      "text": "别人又说认识你，",
      "token_start": 27,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 6810,
      "end_ms": 7530,
      "text": "很高兴，",
      "token_start": 34,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 7790,
      "end_ms": 8910,
      "text": "你就说放心吧，",
      "token_start": 37,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 9330,
      "end_ms": 11410,
      "text": "我会让你一直高兴下去的。",
      "token_start": 43,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 11410,
      "end_ms": 12490,
      "text": "和领导一起吃饭，",
      "token_start": 54,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 12610,
      "end_ms": 13690,
      "text": "领导笑眯眯的说，",
      "token_start": 61,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 14010,
      "end_ms": 14410,
      "text": "哎呀，",
      "token_start": 68,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 14430,
      "end_ms": 16030,
      "text": "和漂亮的女孩子吃饭呀，",
      "token_start": 70,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 16050,
      "end_ms": 17570,
      "text": "不用喝酒就已经醉了，",
      "token_start": 80,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 17730,
      "end_ms": 19430,
      "text": "这个时候你应该怎么回复呢？",
      "token_start": 89,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 19430,
      "end_ms": 20390,
      "text": "高情商的回复，",
      "token_start": 101,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 20550,
      "end_ms": 21310,
      "text": "你还没沾酒，",
      "token_start": 107,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 21310,
      "end_ms": 22310,
      "text": "我就先沾光了。",
      "token_start": 112,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 22630,
      "end_ms": 23770,
      "text": "超高情商怎么说？",
      "token_start": 118,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 24050,
      "end_ms": 25710,
      "text": "漂亮的女孩千篇一律，",
      "token_start": 125,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 25850,
      "end_ms": 27390,
      "text": "有趣的领导万里挑一。",
      "token_start": 134,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 27450,
      "end_ms": 29130,
      "text": "你去咖啡馆买了一杯咖啡，",
      "token_start": 143,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 29410,
      "end_ms": 30000,
      "text": "拿起手机，",
      "token_start": 154,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 30120,
      "end_ms": 31600,
      "text": "你拍了一张照片，",
      "token_start": 158,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 31600,
      "end_ms": 33880,
      "text": "结果呢被店员说没见过世面，",
      "token_start": 165,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 34000,
      "end_ms": 35320,
      "text": "喝杯咖啡还拍照，",
      "token_start": 177,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 35760,
      "end_ms": 36820,
      "text": "那你怎么怼回去呢？",
      "token_start": 184,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 37540,
      "end_ms": 39240,
      "text": "低情商的说怎么了？",
      "token_start": 192,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 39680,
      "end_ms": 40600,
      "text": "你有意见吗？",
      "token_start": 200,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 40680,
      "end_ms": 41780,
      "text": "高情商的回答，",
      "token_start": 205,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 42040,
      "end_ms": 43700,
      "text": "拍照是我的日常端，",
      "token_start": 211,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 43720,
      "end_ms": 44900,
      "text": "咖啡是你的生活。",
      "token_start": 219,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 45020,
      "end_ms": 47460,
      "text": "当别人问你一个月工资多少的时候，",
      "token_start": 226,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 47760,
      "end_ms": 49260,
      "text": "你就回比以前好多了。",
      "token_start": 241,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 49520,
      "end_ms": 50460,
      "text": "现在吃泡面，",
      "token_start": 250,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 50460,
      "end_ms": 51300,
      "text": "我敢放两根。",
      "token_start": 255,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 51300,
      "end_ms": 56020,
      "text": "长了当有人问领导a跟领导b你更喜欢谁的时候，",
      "token_start": 260,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 56020,
      "end_ms": 56500,
      "text": "你就回，",
      "token_start": 281,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 56840,
      "end_ms": 58420,
      "text": "对领导怎么能叫喜欢呢？",
      "token_start": 284,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 58420,
      "end_ms": 60190,
      "text": "那得叫尊敬两位领到，",
      "token_start": 294,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 60190,
      "end_ms": 61450,
      "text": "我都很尊敬领导，",
      "token_start": 303,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 61450,
      "end_ms": 62190,
      "text": "夸你能干，",
      "token_start": 310,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 62510,
      "end_ms": 63310,
      "text": "你怎么回呢？",
      "token_start": 314,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 63530,
      "end_ms": 65055,
      "text": "强将手下无弱兵嘛，",
      "token_start": 319,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 65380,
      "end_ms": 66580,
      "text": "都是您领导有方，",
      "token_start": 327,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 66920,
      "end_ms": 68305,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 334,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 68550,
      "end_ms": 70430,
      "text": "饭局上别人夸你酒量好，",
      "token_start": 343,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 70690,
      "end_ms": 72150,
      "text": "那你该怎么回呢？",
      "token_start": 353,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 72270,
      "end_ms": 74195,
      "text": "高情商的回复酒量好不好？",
      "token_start": 360,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 74420,
      "end_ms": 75445,
      "text": "那得看跟谁喝，",
      "token_start": 371,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 75900,
      "end_ms": 77280,
      "text": "今天跟您喝心情好，",
      "token_start": 377,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 77340,
      "end_ms": 78220,
      "text": "就多贪了两杯。",
      "token_start": 385,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 78220,
      "end_ms": 79220,
      "text": "你去看望领导，",
      "token_start": 391,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 79400,
      "end_ms": 80115,
      "text": "领导说呀，",
      "token_start": 397,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 80390,
      "end_ms": 81985,
      "text": "下次来千万别带礼物了，",
      "token_start": 401,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 82200,
      "end_ms": 82940,
      "text": "都不是外人。",
      "token_start": 411,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 83200,
      "end_ms": 85025,
      "text": "这个时候你该怎么回答呢？",
      "token_start": 416,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 85530,
      "end_ms": 86430,
      "text": "错误的回答是，",
      "token_start": 427,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 86550,
      "end_ms": 86910,
      "text": "好的，",
      "token_start": 433,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 86910,
      "end_ms": 87310,
      "text": "领导，",
      "token_start": 435,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 87310,
      "end_ms": 87950,
      "text": "我知道了。",
      "token_start": 437,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 87950,
      "end_ms": 89010,
      "text": "高情商的回答，",
      "token_start": 441,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 89010,
      "end_ms": 91030,
      "text": "您看您不仅是我的长辈，",
      "token_start": 447,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 91090,
      "end_ms": 91965,
      "text": "还是我的领导，",
      "token_start": 457,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 92250,
      "end_ms": 93425,
      "text": "这些啊不算是礼物，",
      "token_start": 463,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 93670,
      "end_ms": 94655,
      "text": "而是我的心意，",
      "token_start": 471,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 94980,
      "end_ms": 95920,
      "text": "也是我的祝福。",
      "token_start": 477,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 96060,
      "end_ms": 97920,
      "text": "领导在公司群里发了一万的红包，",
      "token_start": 483,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 97920,
      "end_ms": 98884,
      "text": "庆祝公司业绩。",
      "token_start": 497,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 99230,
      "end_ms": 99810,
      "text": "好家伙，",
      "token_start": 503,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 99810,
      "end_ms": 102110,
      "text": "你首庆最佳竟然抢了六千六百六十六。",
      "token_start": 506,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 102310,
      "end_ms": 103285,
      "text": "这个时候领导说了，",
      "token_start": 522,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 103460,
      "end_ms": 103980,
      "text": "小李啊，",
      "token_start": 530,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 104060,
      "end_ms": 104940,
      "text": "手气不错呀，",
      "token_start": 533,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 104940,
      "end_ms": 105880,
      "text": "你该怎么回呢？",
      "token_start": 538,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 105880,
      "end_ms": 107060,
      "text": "高情商的回复是，",
      "token_start": 544,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 107200,
      "end_ms": 109310,
      "text": "手气比不上您的大气超。",
      "token_start": 551,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 109310,
      "end_ms": 110355,
      "text": "高情商的回复是，",
      "token_start": 561,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 110620,
      "end_ms": 112995,
      "text": "领导您的大气成就了我的手气。",
      "token_start": 568,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 113500,
      "end_ms": 115840,
      "text": "有您这样的领导是大家的福气。",
      "token_start": 581,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 115980,
      "end_ms": 119475,
      "text": "这个世界上真的没有人会讨厌那些会说话、会来事儿的人。",
      "token_start": 594,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 119800,
      "end_ms": 120820,
      "text": "假如你不爱说话，",
      "token_start": 618,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 120840,
      "end_ms": 121480,
      "text": "不爱争辩，",
      "token_start": 625,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 121480,
      "end_ms": 122240,
      "text": "也不爱出门，",
      "token_start": 629,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 122360,
      "end_ms": 123565,
      "text": "甚至恐惧社交，",
      "token_start": 634,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 123930,
      "end_ms": 125910,
      "text": "推荐你读完这本闲谈高手，",
      "token_start": 640,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 125990,
      "end_ms": 128115,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 651,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 128400,
      "end_ms": 129460,
      "text": "你每天就看两页，",
      "token_start": 663,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 129640,
      "end_ms": 130940,
      "text": "每一个场景慢慢练，",
      "token_start": 670,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 131060,
      "end_ms": 133395,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 678,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 133730,
      "end_ms": 134650,
      "text": "在这本书里边，",
      "token_start": 693,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 134650,
      "end_ms": 135170,
      "text": "有一句话，",
      "token_start": 699,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 135170,
      "end_ms": 136010,
      "text": "我特别欣赏。",
      "token_start": 703,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 136070,
      "end_ms": 136410,
      "text": "他说，",
      "token_start": 708,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 136550,
      "end_ms": 137970,
      "text": "当对象给你发红包时，",
      "token_start": 710,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 137970,
      "end_ms": 138785,
      "text": "高情商回答，",
      "token_start": 719,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 139040,
      "end_ms": 140905,
      "text": "你是我致富道路上最大的功臣。",
      "token_start": 724,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 141160,
      "end_ms": 142160,
      "text": "当同事向你借钱，",
      "token_start": 737,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 142160,
      "end_ms": 142860,
      "text": "不想借时，",
      "token_start": 744,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 142920,
      "end_ms": 143380,
      "text": "你就回。",
      "token_start": 748,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 143580,
      "end_ms": 144855,
      "text": "大家都是同样的年纪，",
      "token_start": 751,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 145080,
      "end_ms": 145660,
      "text": "你没有的，",
      "token_start": 760,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 145680,
      "end_ms": 146360,
      "text": "我能有吗？",
      "token_start": 764,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 146440,
      "end_ms": 148420,
      "text": "当心仪的女生说我想你时，",
      "token_start": 768,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 148560,
      "end_ms": 149435,
      "text": "高情商回答，",
      "token_start": 779,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 149700,
      "end_ms": 150260,
      "text": "随便想，",
      "token_start": 784,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 150300,
      "end_ms": 151480,
      "text": "千万别跟我客气，",
      "token_start": 787,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 151580,
      "end_ms": 152505,
      "text": "目前不收费。",
      "token_start": 794,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 152900,
      "end_ms": 153900,
      "text": "我读到这段的时候，",
      "token_start": 799,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 153900,
      "end_ms": 156320,
      "text": "我觉得这个让我真是异解心开啊。",
      "token_start": 807,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 156460,
      "end_ms": 158845,
      "text": "每家的书架上不应该有一套这样的书吗？",
      "token_start": 821,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 159090,
      "end_ms": 162155,
      "text": "就是手把手的教我们不同的场景之下应该怎么说？",
