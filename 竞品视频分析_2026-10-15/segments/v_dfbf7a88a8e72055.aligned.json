{
  "video_id": "v_dfbf7a88a8e72055",
  "duration_s": 244.482993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_dfbf7a88a8e72055.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_dfbf7a88a8e72055.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 2730,
      "text": "独库公路十月八日晚上，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2810,
      "end_ms": 5370,
      "text": "八点正式封路了，",
      "token_start": 10,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 6290,
      "end_ms": 6990,
      "text": "这条路，",
      "token_start": 17,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 7230,
      "end_ms": 9670,
      "text": "一年只开放四五个月。",
      "token_start": 20,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 10550,
      "end_ms": 11770,
      "text": "但为了这几个月，",
      "token_start": 29,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 12010,
      "end_ms": 13330,
      "text": "有人用了一辈子。",
      "token_start": 36,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 14410,
      "end_ms": 15970,
      "text": "上世纪七十年代，",
      "token_start": 43,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 16350,
      "end_ms": 18110,
      "text": "为了打通天山南北，",
      "token_start": 50,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 18350,
      "end_ms": 21050,
      "text": "数万名官兵开进了天山深处，",
      "token_start": 58,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 21850,
      "end_ms": 23370,
      "text": "五百六十一公里，",
      "token_start": 70,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 23630,
      "end_ms": 27270,
      "text": "二百八十多公里在海拔二千米以上，",
      "token_start": 77,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 27610,
      "end_ms": 31420,
      "text": "三分之一是悬崖绝壁五分之一。",
      "token_start": 92,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 31440,
      "end_ms": 33160,
      "text": "处于高山永动层，",
      "token_start": 105,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 33940,
      "end_ms": 36280,
      "text": "有一段六公里的悬崖，",
      "token_start": 112,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 36700,
      "end_ms": 38920,
      "text": "测绘人员根本上不去，",
      "token_start": 121,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 39000,
      "end_ms": 40660,
      "text": "图纸上只能画虚线，",
      "token_start": 130,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 40880,
      "end_ms": 43180,
      "text": "叫飞线施工的时候，",
      "token_start": 138,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 43320,
      "end_ms": 44880,
      "text": "战士们先打一个洞，",
      "token_start": 146,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 45160,
      "end_ms": 46300,
      "text": "铆一根钢钎，",
      "token_start": 154,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 46600,
      "end_ms": 47920,
      "text": "吊一根安全绳，",
      "token_start": 159,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 48400,
      "end_ms": 51340,
      "text": "把炮手从悬崖上缓缓放下。",
      "token_start": 165,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 51880,
      "end_ms": 53380,
      "text": "他们身背封攥，",
      "token_start": 176,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 53800,
      "end_ms": 55120,
      "text": "腰缠炸药包，",
      "token_start": 182,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 55460,
      "end_ms": 60450,
      "text": "腰在半空中打眼放炮图纸上的虚线就是这样，",
      "token_start": 187,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 60470,
      "end_ms": 62135,
      "text": "一点一点变成了路。",
      "token_start": 206,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 63090,
      "end_ms": 64235,
      "text": "整整十年，",
      "token_start": 214,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 64620,
      "end_ms": 67945,
      "text": "一百六十八名官兵再也没有走出来。",
      "token_start": 218,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 68490,
      "end_ms": 76810,
      "text": "最小的十八岁最大的五十七岁副营长姚虎城为给大部队清除雪仗，",
      "token_start": 233,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 76830,
      "end_ms": 78255,
      "text": "被雪崩吞没。",
      "token_start": 261,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 78770,
      "end_ms": 82595,
      "text": "指导员李善国带着战士清理十方，",
      "token_start": 266,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 83040,
      "end_ms": 85715,
      "text": "被泥石流埋进了土里。",
      "token_start": 280,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 86620,
      "end_ms": 87900,
      "text": "在这些名字背后，",
      "token_start": 289,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 88160,
      "end_ms": 89165,
      "text": "有一个故事，",
      "token_start": 296,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 89570,
      "end_ms": 91365,
      "text": "我每次讲都会停顿。",
      "token_start": 301,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 91920,
      "end_ms": 93300,
      "text": "一九八零年四月，",
      "token_start": 309,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 93420,
      "end_ms": 95535,
      "text": "大雪封山部队断粮，",
      "token_start": 316,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 96680,
      "end_ms": 101575,
      "text": "班长郑明书带着三名战士下山送信求救。",
      "token_start": 324,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 102480,
      "end_ms": 105695,
      "text": "四个人在零下几十度的暴风雪里迷了路，",
      "token_start": 341,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 106130,
      "end_ms": 107125,
      "text": "干粮吃完了，",
      "token_start": 358,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 107370,
      "end_ms": 108790,
      "text": "只剩最后一个馒头，",
      "token_start": 363,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 108990,
      "end_ms": 109870,
      "text": "谁也不肯吃。",
      "token_start": 371,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 110170,
      "end_ms": 111290,
      "text": "因为大家都清楚，",
      "token_start": 376,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 111310,
      "end_ms": 112350,
      "text": "谁吃了这个馒头，",
      "token_start": 383,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 112550,
      "end_ms": 114070,
      "text": "谁就有可能活着出去。",
      "token_start": 390,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 114190,
      "end_ms": 116375,
      "text": "班长郑明书做出了决定。",
      "token_start": 399,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 116780,
      "end_ms": 118825,
      "text": "我和副班长是共产党员，",
      "token_start": 409,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 119210,
      "end_ms": 120410,
      "text": "陈卫星是老兵，",
      "token_start": 419,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 120790,
      "end_ms": 124720,
      "text": "陈俊贵最小馒头给他陈俊贵，",
      "token_start": 425,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 124720,
      "end_ms": 126005,
      "text": "含着眼泪不肯吃。",
      "token_start": 437,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 126900,
      "end_ms": 127845,
      "text": "班长急了，",
      "token_start": 444,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 128210,
      "end_ms": 128965,
      "text": "下了命令，",
      "token_start": 448,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 129310,
      "end_ms": 130210,
      "text": "咽下馒头。",
      "token_start": 452,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 130250,
      "end_ms": 131090,
      "text": "几个小时后，",
      "token_start": 456,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 131490,
      "end_ms": 134405,
      "text": "班长郑林殊昏倒在雪地里，",
      "token_start": 461,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 134770,
      "end_ms": 135785,
      "text": "再也没有醒来。",
      "token_start": 472,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 136700,
      "end_ms": 137300,
      "text": "临终前，",
      "token_start": 478,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 137300,
      "end_ms": 138660,
      "text": "他拉着陈军贵的手说，",
      "token_start": 481,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 139060,
      "end_ms": 142810,
      "text": "你要是能活着出去去我湖北老家看看，",
      "token_start": 490,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 142810,
      "end_ms": 144935,
      "text": "我父母陈俊贵活了下来。",
      "token_start": 506,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 145430,
      "end_ms": 146210,
      "text": "他复原后，",
      "token_start": 516,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 146490,
      "end_ms": 148210,
      "text": "在老家有份安稳工作，",
      "token_start": 520,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 148350,
      "end_ms": 152285,
      "text": "直到看了电影天山行银幕上的画面，",
      "token_start": 529,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 152630,
      "end_ms": 155975,
      "text": "和当年雪山上的绝境几乎重合。",
      "token_start": 544,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 156590,
      "end_ms": 157710,
      "text": "他彻夜难眠，",
      "token_start": 557,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 157770,
      "end_ms": 158865,
      "text": "我这安稳至子，",
      "token_start": 562,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 159250,
      "end_ms": 161235,
      "text": "是战友用命换来的。",
      "token_start": 568,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 161840,
      "end_ms": 165545,
      "text": "他带着妻子回到天山为班长守墓，",
      "token_start": 576,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 165960,
      "end_ms": 168555,
      "text": "这一首就是四十多年。",
      "token_start": 590,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 169660,
      "end_ms": 170485,
      "text": "有人问他，",
      "token_start": 599,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 171660,
      "end_ms": 174535,
      "text": "一个馒头的恩情要守一辈子吗？",
      "token_start": 603,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 175000,
      "end_ms": 177015,
      "text": "七十多岁的陈俊贵回答，",
      "token_start": 616,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 177400,
      "end_ms": 177905,
      "text": "孩子，",
      "token_start": 626,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 178240,
      "end_ms": 179500,
      "text": "你无法体会到，",
      "token_start": 628,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 179620,
      "end_ms": 180985,
      "text": "在生死关头，",
      "token_start": 634,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 181330,
      "end_ms": 182590,
      "text": "那不是一个馒头，",
      "token_start": 639,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 182770,
      "end_ms": 183465,
      "text": "是生命。",
      "token_start": 646,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 184060,
      "end_ms": 184500,
      "text": "今天，",
      "token_start": 649,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 184660,
      "end_ms": 189325,
      "text": "这条路从国防命脉变成了中国最美公路。",
      "token_start": 651,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 190060,
      "end_ms": 191840,
      "text": "二零二五年通行期间，",
      "token_start": 668,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 192160,
      "end_ms": 199845,
      "text": "全县累计交通量近三百七十万辆次人员流动量七百零七点三万人次。",
      "token_start": 677,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 200340,
      "end_ms": 203680,
      "text": "沿线牧民开启了民宿小村庄，",
      "token_start": 706,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 203720,
      "end_ms": 204915,
      "text": "变成了打卡地，",
      "token_start": 718,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 205430,
      "end_ms": 208665,
      "text": "明年魁独库高速公路正在建设中。",
      "token_start": 724,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 208990,
      "end_ms": 211225,
      "text": "预计二零三二年建成后，",
      "token_start": 738,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 211550,
      "end_ms": 215105,
      "text": "天山将实现全年全天候通行。",
      "token_start": 748,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 215690,
      "end_ms": 218255,
      "text": "那条曾经一年只开五个月的路，",
      "token_start": 760,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 219010,
      "end_ms": 220630,
      "text": "将永远不再封路。",
      "token_start": 773,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 220690,
      "end_ms": 225615,
      "text": "你现在看到的每一帧风景都是他们用命换来的。",
      "token_start": 780,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 226260,
      "end_ms": 227960,
      "text": "如果你也被这条路打动，",
      "token_start": 800,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 228260,
      "end_ms": 231915,
      "text": "请为乔尔玛的一百六十八位战友点个赞，",
      "token_start": 810,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 232420,
      "end_ms": 236115,
      "text": "让更多人看到这条路不止美在风景。",
      "token_start": 827,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 236640,
      "end_ms": 236980,
      "text": "更美，",
      "token_start": 842,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 236980,
      "end_ms": 239340,
      "text": "在有人用命守过评论区，",
      "token_start": 844,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 239340,
      "end_ms": 239820,
      "text": "打一句，",
      "token_start": 854,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 239820,
      "end_ms": 240495,
      "text": "明年见，",
      "token_start": 857,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 240850,
      "end_ms": 244385,
      "text": "转发给那个想和你一起走毒库的人。",
      "token_start": 860,
      "token_end_exclusive": 875
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
