  "segments": [
    {
      "start_ms": 110,
      "end_ms": 710,
      "text": "小姑娘，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 1030,
      "end_ms": 2190,
      "text": "你人踏实能干，",
      "token_start": 3,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2430,
      "end_ms": 3510,
      "text": "我儿子还单身，",
      "token_start": 9,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3790,
      "end_ms": 5250,
      "text": "要不你来当我儿媳妇？",
      "token_start": 15,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6230,
      "end_ms": 6690,
      "text": "领导，",
      "token_start": 24,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6810,
      "end_ms": 7930,
      "text": "您太抬举我了，",
      "token_start": 26,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 8170,
      "end_ms": 9190,
      "text": "能跟着您学习，",
      "token_start": 32,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 9330,
      "end_ms": 10390,
      "text": "已经是我的幸运。",
      "token_start": 38,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 10590,
      "end_ms": 11650,
      "text": "您儿子这么优秀，",
      "token_start": 45,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 12070,
      "end_ms": 13550,
      "text": "工作上我一定好好干，",
      "token_start": 52,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 13630,
      "end_ms": 14450,
      "text": "不给您丢脸。",
      "token_start": 61,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 15910,
      "end_ms": 16970,
      "text": "身上喷这么香，",
      "token_start": 66,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 17130,
      "end_ms": 18350,
      "text": "下班是需要约会吗？",
      "token_start": 72,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 19190,
      "end_ms": 21090,
      "text": "领导卖香水的说，",
      "token_start": 80,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 21090,
      "end_ms": 22710,
      "text": "喷这款香水会遇到贵人，",
      "token_start": 87,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 25590,
      "end_ms": 27410,
      "text": "我看你最近是越来越精神了啊，",
      "token_start": 97,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 27410,
      "end_ms": 29550,
      "text": "那是因为沾了领导，",
      "token_start": 110,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 29550,
      "end_ms": 30000,
      "text": "您的顾事，",
      "token_start": 118,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 30060,
      "end_ms": 31220,
      "text": "光跟着您干事，",
      "token_start": 122,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 31360,
      "end_ms": 32885,
      "text": "气色都不敢差。",
      "token_start": 128,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 35280,
      "end_ms": 36480,
      "text": "年轻就是好啊，",
      "token_start": 134,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 38100,
      "end_ms": 39660,
      "text": "年轻就是还不够沉稳，",
      "token_start": 140,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 40020,
      "end_ms": 41280,
      "text": "还要向您多学习，",
      "token_start": 149,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 41640,
      "end_ms": 42820,
      "text": "我们才能变得更优秀。",
      "token_start": 156,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 44080,
      "end_ms": 44800,
      "text": "小李啊，",
      "token_start": 165,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 45220,
      "end_ms": 46960,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 168,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 48060,
      "end_ms": 50300,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 178,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 50580,
      "end_ms": 52340,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 191,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 53780,
      "end_ms": 54260,
      "text": "小李，",
      "token_start": 204,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 54600,
      "end_ms": 56340,
      "text": "你这菜点的也太多了，",
      "token_start": 206,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 56740,
      "end_ms": 58320,
      "text": "领导菜点的再多，",
      "token_start": 215,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 58340,
      "end_ms": 60900,
      "text": "也比不上平时您对我的照顾多这杯酒。",
      "token_start": 222,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 60900,
      "end_ms": 62700,
      "text": "我先敬您啊，",
      "token_start": 238,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 63880,
      "end_ms": 65335,
      "text": "这藕是好藕啊，",
      "token_start": 243,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 65860,
      "end_ms": 67135,
      "text": "就是心眼儿太多了。",
      "token_start": 249,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 67840,
      "end_ms": 69480,
      "text": "领导藕虽然心眼多，",
      "token_start": 257,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 69480,
      "end_ms": 70725,
      "text": "但也是您的下酒菜呀。",
      "token_start": 265,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 71710,
      "end_ms": 72290,
      "text": "哈哈，",
      "token_start": 274,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 73530,
      "end_ms": 75135,
      "text": "这鸭子是好鸭子，",
      "token_start": 276,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 75540,
      "end_ms": 76365,
      "text": "就是嘴硬，",
      "token_start": 283,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 77360,
      "end_ms": 77740,
      "text": "嘴硬，",
      "token_start": 287,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 77740,
      "end_ms": 78835,
      "text": "才守得住秘密。",
      "token_start": 289,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 79210,
      "end_ms": 79790,
      "text": "哈哈哈，",
      "token_start": 295,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 81370,
      "end_ms": 82725,
      "text": "你酒量挺好的呀。",
      "token_start": 298,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 82980,
      "end_ms": 83360,
      "text": "领导，",
      "token_start": 305,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 83380,
      "end_ms": 84340,
      "text": "您可抬举我了，",
      "token_start": 307,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 84340,
      "end_ms": 85515,
      "text": "我平时真不太能喝。",
      "token_start": 313,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 85790,
      "end_ms": 87130,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 321,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 87130,
      "end_ms": 87705,
      "text": "高兴啊，",
      "token_start": 332,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 87920,
      "end_ms": 88860,
      "text": "这一高兴就多贪了。",
      "token_start": 335,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 88860,
      "end_ms": 93335,
      "text": "几杯不喝就是看不起我。",
      "token_start": 343,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 93780,
      "end_ms": 94285,
      "text": "领导，",
      "token_start": 353,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 94890,
      "end_ms": 96065,
      "text": "我不是看不起您，",
      "token_start": 355,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 96790,
      "end_ms": 97755,
      "text": "我是看不起病。",
      "token_start": 362,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 99660,
      "end_ms": 99860,
      "text": "嗯，",
      "token_start": 368,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 99860,
      "end_ms": 100220,
      "text": "哈哈，",
      "token_start": 369,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 101480,
      "end_ms": 102135,
      "text": "关注我，",
      "token_start": 371,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 102410,
      "end_ms": 103950,
      "text": "每天学点儿高情商，",
      "token_start": 374,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 103990,
      "end_ms": 104855,
      "text": "说话技巧，",
      "token_start": 382,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 105260,
      "end_ms": 107105,
      "text": "让你的路越走越宽。",
      "token_start": 386,
      "token_end_exclusive": 394
    }
  ],
