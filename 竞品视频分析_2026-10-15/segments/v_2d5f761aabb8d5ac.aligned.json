{
  "video_id": "v_2d5f761aabb8d5ac",
  "duration_s": 171.711905,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_2d5f761aabb8d5ac.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_2d5f761aabb8d5ac.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 710,
      "text": "朱君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 950,
      "end_ms": 1710,
      "text": "你相信吗？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1890,
      "end_ms": 2670,
      "text": "过劳者，",
      "token_start": 6,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2670,
      "end_ms": 3330,
      "text": "亡过，",
      "token_start": 9,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3330,
      "end_ms": 4170,
      "text": "惠者添收。",
      "token_start": 11,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 4630,
      "end_ms": 6930,
      "text": "人生最大的智慧在于知止。",
      "token_start": 15,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7590,
      "end_ms": 10630,
      "text": "我们将在八月二十三日迎来楚暑节气，",
      "token_start": 26,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 11210,
      "end_ms": 12910,
      "text": "楚就是止的意思。",
      "token_start": 42,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 13310,
      "end_ms": 15490,
      "text": "楚暑就是暑期至此，",
      "token_start": 49,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 15650,
      "end_ms": 16570,
      "text": "即将结暑，",
      "token_start": 57,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 17090,
      "end_ms": 19310,
      "text": "暑若不止秋则不至，",
      "token_start": 61,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 19910,
      "end_ms": 20630,
      "text": "你知道吗？",
      "token_start": 69,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 20770,
      "end_ms": 23550,
      "text": "李嘉诚之所以能够成为我身后的香港首富，",
      "token_start": 73,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 23830,
      "end_ms": 26190,
      "text": "是因为他的办公室后面挂了两个字。",
      "token_start": 91,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 26330,
      "end_ms": 27690,
      "text": "那就是知止。",
      "token_start": 106,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 28430,
      "end_ms": 31200,
      "text": "真正的强者从来不会站在山顶跳舞，",
      "token_start": 111,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 31300,
      "end_ms": 34300,
      "text": "而是在距离悬崖三步之时转身离开。",
      "token_start": 126,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 34800,
      "end_ms": 35980,
      "text": "什么叫知止啊？",
      "token_start": 141,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 36280,
      "end_ms": 38560,
      "text": "沉默成本不参与重大决策，",
      "token_start": 147,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 38580,
      "end_ms": 39340,
      "text": "已有损失，",
      "token_start": 158,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 39340,
      "end_ms": 40700,
      "text": "不影响当前角色。",
      "token_start": 162,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 41000,
      "end_ms": 43340,
      "text": "这句话不管放在什么地方都适合。",
      "token_start": 169,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 43700,
      "end_ms": 46160,
      "text": "比如你看电影看了中途觉得不好看了，",
      "token_start": 183,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 46320,
      "end_ms": 47400,
      "text": "那就立马离开。",
      "token_start": 199,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 47600,
      "end_ms": 49200,
      "text": "至于买电影票花了多少钱，",
      "token_start": 205,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 49240,
      "end_ms": 50580,
      "text": "打算花了多少钱等等，",
      "token_start": 216,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 50680,
      "end_ms": 52480,
      "text": "这些都不能影响你的角色。",
      "token_start": 225,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 52720,
      "end_ms": 53860,
      "text": "无论任何关系，",
      "token_start": 236,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 53980,
      "end_ms": 55420,
      "text": "当你决定离开时，",
      "token_start": 242,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 55460,
      "end_ms": 57280,
      "text": "就一定是当下最好的结果。",
      "token_start": 249,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 57520,
      "end_ms": 60795,
      "text": "不要因为可惜曾经的付出而委委曲求全。",
      "token_start": 260,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 61310,
      "end_ms": 62555,
      "text": "人活几个瞬间，",
      "token_start": 277,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 62740,
      "end_ms": 64355,
      "text": "但不能只活几个瞬间，",
      "token_start": 283,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 64740,
      "end_ms": 65700,
      "text": "明智的放弃，",
      "token_start": 292,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 65760,
      "end_ms": 66160,
      "text": "好过，",
      "token_start": 297,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 66240,
      "end_ms": 67125,
      "text": "盲目执着。",
      "token_start": 299,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 67510,
      "end_ms": 68785,
      "text": "楚楚节气有三后，",
      "token_start": 303,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 69080,
      "end_ms": 72020,
      "text": "一后应乃静鸟二后天地使速。",
      "token_start": 310,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 72200,
      "end_ms": 79345,
      "text": "三后何乃登天地始速意味着自然由繁盛转向收敛秩序开始重新出现。",
      "token_start": 322,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 79770,
      "end_ms": 82455,
      "text": "一个人的好运往往从清场开始，",
      "token_start": 351,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 82780,
      "end_ms": 83380,
      "text": "你知道吗？",
      "token_start": 364,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 83380,
      "end_ms": 85215,
      "text": "农历七月是交界的月，",
      "token_start": 368,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 85460,
      "end_ms": 86620,
      "text": "阳气开始收敛，",
      "token_start": 377,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 86760,
      "end_ms": 88040,
      "text": "阴气逐渐上升。",
      "token_start": 383,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 88240,
      "end_ms": 88820,
      "text": "国语说，",
      "token_start": 389,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 88960,
      "end_ms": 89995,
      "text": "七月流火，",
      "token_start": 392,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 90340,
      "end_ms": 93395,
      "text": "很多重要的日子都在这个月要多一分敬畏。",
      "token_start": 396,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 93770,
      "end_ms": 96350,
      "text": "从夏天的火运转到秋天的金运，",
      "token_start": 414,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 96390,
      "end_ms": 97855,
      "text": "一定要收敛神气。",
      "token_start": 427,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 98330,
      "end_ms": 99070,
      "text": "在传统文化，",
      "token_start": 434,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 99070,
      "end_ms": 102030,
      "text": "中秋对应的金代表着收敛裁决，",
      "token_start": 439,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 102290,
      "end_ms": 103625,
      "text": "所谓秋后算账，",
      "token_start": 452,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 104010,
      "end_ms": 105010,
      "text": "秋天的天时，",
      "token_start": 458,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 105130,
      "end_ms": 106435,
      "text": "就是让你做舍弃，",
      "token_start": 463,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 106760,
      "end_ms": 110725,
      "text": "不舍就不得有舍才有得这就是今生水。",
      "token_start": 470,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 111170,
      "end_ms": 113725,
      "text": "人们会在秋天砍掉果树没用的杈，",
      "token_start": 486,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 114020,
      "end_ms": 115485,
      "text": "这样来年才会丰收。",
      "token_start": 500,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 115920,
      "end_ms": 117780,
      "text": "秋天收了冬天才有的藏，",
      "token_start": 508,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 118100,
      "end_ms": 119855,
      "text": "来年春天才能生发。",
      "token_start": 518,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 120360,
      "end_ms": 121685,
      "text": "秋后就得算算账，",
      "token_start": 526,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 122010,
      "end_ms": 124970,
      "text": "消耗你的人要断低回报的事要清。",
      "token_start": 533,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 124970,
      "end_ms": 126770,
      "text": "一清攒了好久的塑料袋，",
      "token_start": 547,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 126830,
      "end_ms": 128930,
      "text": "多年不穿的旧衣服都扔一扔，",
      "token_start": 557,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 129090,
      "end_ms": 131370,
      "text": "大胆的扔离里数云散，",
      "token_start": 569,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 131610,
      "end_ms": 132975,
      "text": "袅袅凉风起，",
      "token_start": 578,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 133300,
      "end_ms": 135215,
      "text": "给人生设一个除暑吧。",
      "token_start": 583,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 135660,
      "end_ms": 138280,
      "text": "很多人真正的问题已经不是不够努力，",
      "token_start": 592,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 138380,
      "end_ms": 140265,
      "text": "而是不知道什么时候该停。",
      "token_start": 608,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 140810,
      "end_ms": 142350,
      "text": "明知一段关系没有回应，",
      "token_start": 619,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 142350,
      "end_ms": 143525,
      "text": "还在不停的付出。",
      "token_start": 629,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 143840,
      "end_ms": 144660,
      "text": "明知一件事，",
      "token_start": 636,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 144680,
      "end_ms": 146120,
      "text": "只剩沉默成本，",
      "token_start": 641,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 146260,
      "end_ms": 147655,
      "text": "还在不甘心的坚持。",
      "token_start": 647,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 147990,
      "end_ms": 149570,
      "text": "明知身体已经透支，",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 149570,
      "end_ms": 151605,
      "text": "还要用疲惫证明上进，",
      "token_start": 663,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 152080,
      "end_ms": 153500,
      "text": "不要等生活把你耗尽，",
      "token_start": 672,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 153580,
      "end_ms": 155660,
      "text": "才允许自己停下楚楚。",
      "token_start": 681,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 155660,
      "end_ms": 157795,
      "text": "最好的祝福是情绪有止，",
      "token_start": 690,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 158070,
      "end_ms": 158910,
      "text": "欲望有度，",
      "token_start": 700,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 159170,
      "end_ms": 160940,
      "text": "关系有界努力。",
      "token_start": 704,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 160940,
      "end_ms": 163440,
      "text": "有些愿你在季节的转身处，",
      "token_start": 710,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 163600,
      "end_ms": 165580,
      "text": "告别盛夏的燥热与疲惫，",
      "token_start": 721,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 165760,
      "end_ms": 167720,
      "text": "收获初秋的清爽与从容。",
      "token_start": 731,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 167960,
      "end_ms": 169080,
      "text": "愿你所念，",
      "token_start": 741,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 169200,
      "end_ms": 169800,
      "text": "皆如愿，",
      "token_start": 745,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 170080,
      "end_ms": 171535,
      "text": "所行皆坦途。",
      "token_start": 748,
      "token_end_exclusive": 753
    }
  ],
