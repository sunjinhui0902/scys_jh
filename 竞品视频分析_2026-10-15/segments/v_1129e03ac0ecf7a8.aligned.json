{
  "video_id": "v_1129e03ac0ecf7a8",
  "duration_s": 496.628005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1129e03ac0ecf7a8.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1129e03ac0ecf7a8.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 590,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 610,
      "end_ms": 6350,
      "text": "咱们说到清华校长梅宜奇穷到跟夫人摆地摊卖点心，",
      "token_start": 2,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6910,
      "end_ms": 9550,
      "text": "手里却管着千万清华基金。",
      "token_start": 24,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 10050,
      "end_ms": 12350,
      "text": "他那个从不离身的旧皮包，",
      "token_start": 35,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12730,
      "end_ms": 14750,
      "text": "谁也不知道里面装着什么。",
      "token_start": 46,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 15230,
      "end_ms": 17030,
      "text": "一九六二年五月十九日，",
      "token_start": 57,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 17710,
      "end_ms": 20730,
      "text": "梅遗奇在台北台大医院病逝。",
      "token_start": 67,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 21570,
      "end_ms": 22830,
      "text": "他病重期间，",
      "token_start": 79,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 23250,
      "end_ms": 25890,
      "text": "那个皮包一直锁在病床底下，",
      "token_start": 84,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 25890,
      "end_ms": 27390,
      "text": "谁也不让碰。",
      "token_start": 96,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 27390,
      "end_ms": 29310,
      "text": "去世之后，",
      "token_start": 101,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 29310,
      "end_ms": 32200,
      "text": "梅秘书当场把皮包家封，",
      "token_start": 105,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 32640,
      "end_ms": 37580,
      "text": "又组织专门的人在各方监督下起封查验包。",
      "token_start": 115,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 37640,
      "end_ms": 38660,
      "text": "打开的那一刻，",
      "token_start": 133,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 38960,
      "end_ms": 40340,
      "text": "所有人都愣住了，",
      "token_start": 139,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 40940,
      "end_ms": 41780,
      "text": "没有银票，",
      "token_start": 146,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 42000,
      "end_ms": 43280,
      "text": "没有贵重财物，",
      "token_start": 150,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 43400,
      "end_ms": 44300,
      "text": "没有存款，",
      "token_start": 156,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 44540,
      "end_ms": 46800,
      "text": "连一张私人的字据都没有，",
      "token_start": 160,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 47240,
      "end_ms": 51220,
      "text": "里面整整齐齐码着的全是清华基金的账本，",
      "token_start": 171,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 52000,
      "end_ms": 56020,
      "text": "一笔一笔从他一九三一年当校长开始，",
      "token_start": 189,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 56240,
      "end_ms": 59140,
      "text": "到一九六二年去世十几年的账，",
      "token_start": 205,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 59140,
      "end_ms": 61725,
      "text": "每一一笔钱什么时候到的，",
      "token_start": 218,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 62050,
      "end_ms": 63330,
      "text": "用在了什么地方，",
      "token_start": 229,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 63490,
      "end_ms": 64475,
      "text": "还剩多少，",
      "token_start": 236,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 64820,
      "end_ms": 65960,
      "text": "记得密密麻麻，",
      "token_start": 240,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 66180,
      "end_ms": 67165,
      "text": "清清爽爽，",
      "token_start": 246,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 67500,
      "end_ms": 68340,
      "text": "分毫不差。",
      "token_start": 250,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 68540,
      "end_ms": 72340,
      "text": "在场的人没有一个不掉眼泪的他，",
      "token_start": 254,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 72340,
      "end_ms": 74295,
      "text": "管了一辈子清华的钱。",
      "token_start": 268,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 75160,
      "end_ms": 76160,
      "text": "一九四九年，",
      "token_start": 277,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 76160,
      "end_ms": 78785,
      "text": "他到美国管理清华庚款基金，",
      "token_start": 282,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 79260,
      "end_ms": 81835,
      "text": "巨额资金从手上经过，",
      "token_start": 294,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 82290,
      "end_ms": 85755,
      "text": "当时在美留学生每人每月资助三百美元。",
      "token_start": 303,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 86160,
      "end_ms": 88760,
      "text": "他给自己定的月薪也是三百美元，",
      "token_start": 320,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 89600,
      "end_ms": 90485,
      "text": "一分不多拿。",
      "token_start": 334,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 90710,
      "end_ms": 91730,
      "text": "有人看不下去，",
      "token_start": 339,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 91950,
      "end_ms": 92915,
      "text": "说你是校长，",
      "token_start": 345,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 93670,
      "end_ms": 95365,
      "text": "怎么能跟学生拿一样多，",
      "token_start": 350,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 95950,
      "end_ms": 97650,
      "text": "要给他涨到一千五百元。",
      "token_start": 360,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 97790,
      "end_ms": 98555,
      "text": "他不同意，",
      "token_start": 370,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 99290,
      "end_ms": 100930,
      "text": "说薪水是我自己定的，",
      "token_start": 374,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 100930,
      "end_ms": 103820,
      "text": "我不情愿改他租的公寓，",
      "token_start": 383,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 103820,
      "end_ms": 106335,
      "text": "小到连一间单独的卧室都没有。",
      "token_start": 393,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 107130,
      "end_ms": 111445,
      "text": "他夫人韩永华呢六十二岁才开始在美国找工作，",
      "token_start": 406,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 112270,
      "end_ms": 115215,
      "text": "衣帽厂做过工首饰店卖过货，",
      "token_start": 426,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 115660,
      "end_ms": 116785,
      "text": "医院里做过护工，",
      "token_start": 438,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 117100,
      "end_ms": 119455,
      "text": "最后在一所盲童学校照料盲童，",
      "token_start": 445,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 119890,
      "end_ms": 121850,
      "text": "一直干到六十六岁才退休。",
      "token_start": 458,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 122550,
      "end_ms": 125570,
      "text": "他自己呢住院的时候连医药费都付不起，",
      "token_start": 469,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 125890,
      "end_ms": 130050,
      "text": "去世后丧葬费都是清华校友凑的这就是梅一期，",
      "token_start": 486,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 130290,
      "end_ms": 131170,
      "text": "他不是没钱，",
      "token_start": 506,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 131770,
      "end_ms": 133930,
      "text": "他是把钱全给了学校，",
      "token_start": 511,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 134210,
      "end_ms": 135010,
      "text": "给了学生，",
      "token_start": 520,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 135430,
      "end_ms": 137530,
      "text": "一分钱没往自己兜里装。",
      "token_start": 524,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 138330,
      "end_ms": 139490,
      "text": "再说他怎么用人，",
      "token_start": 534,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 139890,
      "end_ms": 142190,
      "text": "那才叫真正的不拘一格。",
      "token_start": 541,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 143730,
      "end_ms": 145690,
      "text": "华罗庚什么学历？",
      "token_start": 551,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 145690,
      "end_ms": 150480,
      "text": "初中毕业在江苏金坛老家的药费殿伙计，",
      "token_start": 558,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 150560,
      "end_ms": 152400,
      "text": "一边站柜台，",
      "token_start": 575,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 152400,
      "end_ms": 153960,
      "text": "一边自学数学。",
      "token_start": 580,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 153960,
      "end_ms": 155820,
      "text": "就这么一个人，",
      "token_start": 586,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 155820,
      "end_ms": 157720,
      "text": "梅一其看上了，",
      "token_start": 592,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 158220,
      "end_ms": 160340,
      "text": "先把他破格招进清华，",
      "token_start": 598,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 160880,
      "end_ms": 165200,
      "text": "又破格从一个系资料员直接升为助教，",
      "token_start": 607,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 165540,
      "end_ms": 167780,
      "text": "还允许他旁听大学课程，",
      "token_start": 623,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 168180,
      "end_ms": 171600,
      "text": "再破格送到英国剑桥大学深造。",
      "token_start": 633,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 171700,
      "end_ms": 172400,
      "text": "最后这一步，",
      "token_start": 646,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 172400,
      "end_ms": 177660,
      "text": "最难得跳过讲师副教授直接聘为正教授。",
      "token_start": 651,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 178140,
      "end_ms": 179575,
      "text": "一个初中毕业的店员，",
      "token_start": 668,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 180030,
      "end_ms": 184235,
      "text": "在每一期手里一步步变成了世界级的数学大师，",
      "token_start": 677,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 184740,
      "end_ms": 187540,
      "text": "还有陈寅恪留学多年，",
      "token_start": 697,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 187740,
      "end_ms": 188605,
      "text": "没有学位，",
      "token_start": 706,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 188890,
      "end_ms": 189695,
      "text": "没有著作，",
      "token_start": 710,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 190100,
      "end_ms": 192045,
      "text": "在国内也没什么名气，",
      "token_start": 714,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 192930,
      "end_ms": 195920,
      "text": "典型的三无学者没一齐主持。",
      "token_start": 723,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 195920,
      "end_ms": 197125,
      "text": "清华教务期间，",
      "token_start": 735,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 197900,
      "end_ms": 206500,
      "text": "陈寅恪被聘为清华国学研究院导师和王国维、梁启超、赵元任并称四大导师。",
      "token_start": 741,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 206720,
      "end_ms": 207100,
      "text": "后来，",
      "token_start": 772,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 207100,
      "end_ms": 209160,
      "text": "傅斯年评价陈寅恪说，",
      "token_start": 774,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 209160,
      "end_ms": 212165,
      "text": "他是近三百年来一人而已。",
      "token_start": 783,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 213040,
      "end_ms": 214755,
      "text": "每一期常说一句话，",
      "token_start": 794,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 215380,
      "end_ms": 216505,
      "text": "所谓大学者，",
      "token_start": 802,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 216850,
      "end_ms": 218390,
      "text": "非未有大楼之谓，",
      "token_start": 807,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 218390,
      "end_ms": 220575,
      "text": "也有大师之谓也。",
      "token_start": 814,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 221050,
      "end_ms": 223110,
      "text": "翻译过来就是一个大学，",
      "token_start": 821,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 223110,
      "end_ms": 223630,
      "text": "行不行？",
      "token_start": 831,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 223830,
      "end_ms": 225235,
      "text": "不看你楼盖多高，",
      "token_start": 834,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 225540,
      "end_ms": 226735,
      "text": "看你有没有好老师。",
      "token_start": 841,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 227540,
      "end_ms": 228580,
      "text": "他不光这么说，",
      "token_start": 849,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 228820,
      "end_ms": 229825,
      "text": "他真这么干。",
      "token_start": 855,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 230240,
      "end_ms": 231080,
      "text": "教授开会，",
      "token_start": 860,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 231280,
      "end_ms": 232865,
      "text": "他搬个凳子坐墙角，",
      "token_start": 864,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 233410,
      "end_ms": 233970,
      "text": "不说话，",
      "token_start": 872,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 234190,
      "end_ms": 235430,
      "text": "手里摆弄个烟斗，",
      "token_start": 875,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 235530,
      "end_ms": 236815,
      "text": "看谁茶杯空了，",
      "token_start": 882,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 237130,
      "end_ms": 238495,
      "text": "起身给人续上水。",
      "token_start": 888,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 239030,
      "end_ms": 241300,
      "text": "有人问他校长有什么指示，",
      "token_start": 895,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 241360,
      "end_ms": 243845,
      "text": "他摆摆手说你们都是专家，",
      "token_start": 906,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 244200,
      "end_ms": 246615,
      "text": "你们定的是我去办就完了，",
      "token_start": 917,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 247560,
      "end_ms": 250705,
      "text": "就这么一个给教授搬板凳的校长。",
      "token_start": 928,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 251490,
      "end_ms": 253735,
      "text": "在抗战最艰难的时候，",
      "token_start": 942,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 254780,
      "end_ms": 259130,
      "text": "带着清华北大南开三所学校一路南迁，",
      "token_start": 951,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 259310,
      "end_ms": 262385,
      "text": "到昆明组成了西南联合大学。",
      "token_start": 967,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 263110,
      "end_ms": 264745,
      "text": "那学校破到什么程度？",
      "token_start": 979,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 265080,
      "end_ms": 268595,
      "text": "请了梁思成林徽因来设计校舍，",
      "token_start": 988,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 268970,
      "end_ms": 271065,
      "text": "图纸改了一稿又一稿，",
      "token_start": 1001,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 271470,
      "end_ms": 272505,
      "text": "高楼改矮楼，",
      "token_start": 1010,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 272840,
      "end_ms": 273965,
      "text": "矮楼改平房，",
      "token_start": 1015,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 274320,
      "end_ms": 275665,
      "text": "砖墙改土墙。",
      "token_start": 1020,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 276080,
      "end_ms": 278420,
      "text": "最后建起来的是一排排茅草屋，",
      "token_start": 1025,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 278720,
      "end_ms": 280075,
      "text": "宿舍是茅草顶，",
      "token_start": 1038,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 280410,
      "end_ms": 281825,
      "text": "教室是铁皮顶。",
      "token_start": 1044,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 282120,
      "end_ms": 283165,
      "text": "昆明一下雨，",
      "token_start": 1050,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 283430,
      "end_ms": 284610,
      "text": "雨点打在铁皮上，",
      "token_start": 1055,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 284610,
      "end_ms": 287630,
      "text": "噼里啪啦老师在讲台上喊破嗓子，",
      "token_start": 1062,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 287850,
      "end_ms": 289315,
      "text": "学生一个字听不见。",
      "token_start": 1076,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 290160,
      "end_ms": 290720,
      "text": "有一次，",
      "token_start": 1084,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 290720,
      "end_ms": 292880,
      "text": "经济系教授陈戴孙上课，",
      "token_start": 1087,
      "token_end_exclusive": 1097
    },
    {
      "start_ms": 293360,
      "end_ms": 294320,
      "text": "暴雨突至，",
      "token_start": 1097,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 294600,
      "end_ms": 295945,
      "text": "什么都听不清了。",
      "token_start": 1101,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 296650,
      "end_ms": 300065,
      "text": "陈先生转过身在黑板上写了四个字，",
      "token_start": 1108,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 300870,
      "end_ms": 302495,
      "text": "停客赏语，",
      "token_start": 1123,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 303360,
      "end_ms": 305835,
      "text": "全班师生就这么静静的坐着。",
      "token_start": 1127,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 307090,
      "end_ms": 310510,
      "text": "听外面的雨声就是这么一所破破烂烂，",
      "token_start": 1139,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 310790,
      "end_ms": 313030,
      "text": "连个像样的教室都没有的大学，",
      "token_start": 1155,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 313110,
      "end_ms": 314810,
      "text": "只存在了短短八年，",
      "token_start": 1168,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 315090,
      "end_ms": 316490,
      "text": "创造了什么奇迹？",
      "token_start": 1176,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 317030,
      "end_ms": 324930,
      "text": "两位诺贝尔物理学奖得主杨振宁、李政道八位、两弹一星功勋奖章获得者、五位，",
      "token_start": 1183,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 324970,
      "end_ms": 330730,
      "text": "国家最高科学技术奖得主一百七十多位两院院士，",
      "token_start": 1215,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 331470,
      "end_ms": 338480,
      "text": "还有上百位人文社科大师汪曾祺许愿冲邓稼先。",
      "token_start": 1236,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 339340,
      "end_ms": 341360,
      "text": "一个个名字到今天，",
      "token_start": 1256,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 341400,
      "end_ms": 343520,
      "text": "念起来都沉甸甸的。",
      "token_start": 1264,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 344820,
      "end_ms": 349080,
      "text": "中国教育史上的珠穆朗玛峰是在茅草屋里，",
      "token_start": 1272,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 350180,
      "end_ms": 353940,
      "text": "铁皮顶下战乱中，",
      "token_start": 1290,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 353960,
      "end_ms": 357220,
      "text": "被梅一齐带着一群人扛起来的。",
      "token_start": 1297,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 358200,
      "end_ms": 359200,
      "text": "一九六一年，",
      "token_start": 1310,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 359960,
      "end_ms": 363980,
      "text": "梅一齐因为重病住进台大医院特二号病房，",
      "token_start": 1315,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 364800,
      "end_ms": 367285,
      "text": "隔壁特一号病房住的是谁？",
      "token_start": 1333,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 367650,
      "end_ms": 368150,
      "text": "胡适，",
      "token_start": 1344,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 368650,
      "end_ms": 370135,
      "text": "一个曾经主持北大，",
      "token_start": 1346,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 370380,
      "end_ms": 373535,
      "text": "一个长期主持清华两位老校长，",
      "token_start": 1354,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 374470,
      "end_ms": 378065,
      "text": "晚年住进了一墙之隔的两个病房。",
      "token_start": 1367,
      "token_end_exclusive": 1381
    },
    {
      "start_ms": 379020,
      "end_ms": 380480,
      "text": "一九六二年二月，",
      "token_start": 1381,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 380740,
      "end_ms": 383280,
      "text": "胡适先走了不到三个月，",
      "token_start": 1388,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 383500,
      "end_ms": 384525,
      "text": "五月十九日，",
      "token_start": 1398,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 384940,
      "end_ms": 386065,
      "text": "梅一起也走了。",
      "token_start": 1403,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 386460,
      "end_ms": 387385,
      "text": "他去世后，",
      "token_start": 1409,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 387750,
      "end_ms": 390395,
      "text": "两岸、清华各建了一座梅园。",
      "token_start": 1413,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 391070,
      "end_ms": 391970,
      "text": "每年冬天，",
      "token_start": 1424,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 392170,
      "end_ms": 393605,
      "text": "新竹的梅花开了，",
      "token_start": 1428,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 393940,
      "end_ms": 396865,
      "text": "北京的梅园里也常有师生驻足。",
      "token_start": 1435,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 397540,
      "end_ms": 400235,
      "text": "现在咱们的大学楼越盖越高，",
      "token_start": 1448,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 400530,
      "end_ms": 401735,
      "text": "设备越来越先进，",
      "token_start": 1460,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 402160,
      "end_ms": 404410,
      "text": "经费越来越多可。",
      "token_start": 1467,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 404410,
      "end_ms": 405395,
      "text": "有时候我就想，",
      "token_start": 1474,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 405950,
      "end_ms": 407325,
      "text": "我们到底缺什么，",
      "token_start": 1480,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 408120,
      "end_ms": 409755,
      "text": "我们缺的不是大楼，",
      "token_start": 1487,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 410340,
      "end_ms": 411265,
      "text": "不是经费，",
      "token_start": 1495,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 411910,
      "end_ms": 413950,
      "text": "是梅一齐身上那点东西，",
      "token_start": 1499,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 414230,
      "end_ms": 414670,
      "text": "那点儿，",
      "token_start": 1509,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 414670,
      "end_ms": 416545,
      "text": "把公家的钱当命看，",
      "token_start": 1512,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 416950,
      "end_ms": 418805,
      "text": "把自己的日子当草过，",
      "token_start": 1520,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 419310,
      "end_ms": 421435,
      "text": "把人才当天大的事儿，",
      "token_start": 1529,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 422290,
      "end_ms": 424415,
      "text": "把原则当命根子的劲儿。",
      "token_start": 1538,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 424730,
      "end_ms": 426535,
      "text": "他用一辈子告诉后人，",
      "token_start": 1548,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 426880,
      "end_ms": 428700,
      "text": "什么都可以向现实低头，",
      "token_start": 1557,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 428780,
      "end_ms": 430810,
      "text": "唯独读书人的风骨。",
      "token_start": 1567,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 430810,
      "end_ms": 431145,
      "text": "不能。",
      "token_start": 1575,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 431860,
      "end_ms": 434355,
      "text": "如果你也被梅校长的故事戳到了，",
      "token_start": 1577,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 434760,
      "end_ms": 438835,
      "text": "想知道那批读书人在战火里到底是怎么活过来，",
      "token_start": 1591,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 439240,
      "end_ms": 440675,
      "text": "怎么把书教下去的。",
      "token_start": 1611,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 441090,
      "end_ms": 442870,
      "text": "我真心推荐你看看。",
      "token_start": 1619,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 442870,
      "end_ms": 449195,
      "text": "南渡北归、这套书、梅一齐陈银雀、华罗庚、梁思成林徽因，",
      "token_start": 1627,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 449590,
      "end_ms": 451465,
      "text": "还有西南联大那批先生们，",
      "token_start": 1649,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 451920,
      "end_ms": 453915,
      "text": "书里写的比我讲的细多了。",
      "token_start": 1660,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 454460,
      "end_ms": 455985,
      "text": "那不是一个人的故事，",
      "token_start": 1671,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 456410,
      "end_ms": 461425,
      "text": "是整整一代中国读书人在乱世里的群像。",
      "token_start": 1680,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 462420,
      "end_ms": 463700,
      "text": "他们住茅草屋，",
      "token_start": 1697,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 463760,
      "end_ms": 465065,
      "text": "吃白饭拌辣椒，",
      "token_start": 1703,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 465350,
      "end_ms": 467125,
      "text": "可脊梁骨挺的比谁都直。",
      "token_start": 1709,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 467720,
      "end_ms": 468715,
      "text": "看完你就明白，",
      "token_start": 1719,
      "token_end_exclusive": 1725
    },
    {
      "start_ms": 469230,
      "end_ms": 473515,
      "text": "为什么那所破破烂烂的大学能走出那么多大师。",
      "token_start": 1725,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 474020,
      "end_ms": 476700,
      "text": "感兴趣的朋友们可以点左下角链接，",
      "token_start": 1745,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 476860,
      "end_ms": 477535,
      "text": "直接拍，",
      "token_start": 1760,
      "token_end_exclusive": 1763
    },
    {
      "start_ms": 478100,
      "end_ms": 478785,
      "text": "拿到手。",
      "token_start": 1763,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 479130,
      "end_ms": 481160,
      "text": "细细品读关注我，",
      "token_start": 1766,
      "token_end_exclusive": 1773
    },
    {
      "start_ms": 481320,
      "end_ms": 483975,
      "text": "带你看更多有骨气的中国人，",
      "token_start": 1773,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 484570,
      "end_ms": 487125,
      "text": "觉得梅校长值得被记住的点个赞。",
      "token_start": 1785,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 487460,
      "end_ms": 488225,
      "text": "收藏起来，",
      "token_start": 1799,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 488720,
      "end_ms": 489660,
      "text": "评论区告诉我，",
      "token_start": 1803,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 489660,
      "end_ms": 490875,
      "text": "你最佩服他哪一点，",
      "token_start": 1809,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 491330,
      "end_ms": 492390,
      "text": "再转发出去，",
      "token_start": 1817,
      "token_end_exclusive": 1822
    },
    {
      "start_ms": 492630,
      "end_ms": 496555,
      "text": "让更多人知道中国曾经有过这样的校长。",
      "token_start": 1822,
      "token_end_exclusive": 1839
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
    "timestamp_starts_monotonic": true,
