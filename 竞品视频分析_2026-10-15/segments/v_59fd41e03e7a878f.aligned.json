{
  "video_id": "v_59fd41e03e7a878f",
  "duration_s": 235.982948,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_59fd41e03e7a878f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_59fd41e03e7a878f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 460,
      "end_ms": 840,
      "text": "你好，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1120,
      "end_ms": 2080,
      "text": "你占了我的车位，",
      "token_start": 2,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2440,
      "end_ms": 3320,
      "text": "麻烦挪一下车，",
      "token_start": 9,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3900,
      "end_ms": 4920,
      "text": "我在开会呢，",
      "token_start": 15,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4940,
      "end_ms": 5845,
      "text": "晚点再说吧。",
      "token_start": 20,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 8630,
      "end_ms": 9010,
      "text": "你好，",
      "token_start": 25,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 9450,
      "end_ms": 11150,
      "text": "好像看到有人刮到你车了，",
      "token_start": 27,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 11170,
      "end_ms": 12570,
      "text": "赶紧来看看什么，",
      "token_start": 38,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12750,
      "end_ms": 13570,
      "text": "我马上下来，",
      "token_start": 45,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 13730,
      "end_ms": 14495,
      "text": "谢谢你啊。",
      "token_start": 50,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 17420,
      "end_ms": 18720,
      "text": "还有一道菜这么久没上，",
      "token_start": 54,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 18880,
      "end_ms": 19900,
      "text": "还没做就退了吧，",
      "token_start": 64,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 20000,
      "end_ms": 20620,
      "text": "不好意思，",
      "token_start": 71,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 20720,
      "end_ms": 21795,
      "text": "已经下锅做了。",
      "token_start": 75,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 23910,
      "end_ms": 24150,
      "text": "哎，",
      "token_start": 81,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 24570,
      "end_ms": 25090,
      "text": "好吧，",
      "token_start": 82,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 25690,
      "end_ms": 27830,
      "text": "我们的菜做了没没做的话，",
      "token_start": 84,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 28290,
      "end_ms": 29390,
      "text": "帮我换一道菜吧，",
      "token_start": 95,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 30110,
      "end_ms": 30930,
      "text": "还没做呢，",
      "token_start": 102,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 30950,
      "end_ms": 31770,
      "text": "我帮您改单，",
      "token_start": 106,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 32790,
      "end_ms": 33810,
      "text": "没做就退了吧。",
      "token_start": 111,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 33990,
      "end_ms": 35470,
      "text": "买单你好，",
      "token_start": 117,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 36110,
      "end_ms": 37450,
      "text": "我的卡被取款机吞了，",
      "token_start": 121,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 37510,
      "end_ms": 38850,
      "text": "麻烦赶紧过来处理一下，",
      "token_start": 130,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 40030,
      "end_ms": 41090,
      "text": "已帮您登记，",
      "token_start": 140,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 41630,
      "end_ms": 43665,
      "text": "七十二小时内会为您处理。",
      "token_start": 145,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 46110,
      "end_ms": 47450,
      "text": "你们取款机出问题了，",
      "token_start": 156,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 47990,
      "end_ms": 49130,
      "text": "一直在往外吐钱，",
      "token_start": 165,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 49450,
      "end_ms": 50190,
      "text": "我都不敢碰。",
      "token_start": 172,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 50870,
      "end_ms": 51270,
      "text": "什么？",
      "token_start": 177,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 51750,
      "end_ms": 52410,
      "text": "您稍等，",
      "token_start": 179,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 53010,
      "end_ms": 56230,
      "text": "我们马上派人过去充电宝和香水，",
      "token_start": 182,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 56530,
      "end_ms": 57610,
      "text": "不符合携带规定，",
      "token_start": 196,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 58290,
      "end_ms": 59270,
      "text": "可马上登机了，",
      "token_start": 203,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 59290,
      "end_ms": 60310,
      "text": "我能先放这儿吗？",
      "token_start": 209,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 60370,
      "end_ms": 60710,
      "text": "晚点，",
      "token_start": 216,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 60710,
      "end_ms": 61605,
      "text": "我让家人来取，",
      "token_start": 218,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 61980,
      "end_ms": 62445,
      "text": "抱歉，",
      "token_start": 224,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 62720,
      "end_ms": 63495,
      "text": "我们没法保管。",
      "token_start": 226,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 65540,
      "end_ms": 66165,
      "text": "那算了，",
      "token_start": 232,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 66410,
      "end_ms": 66915,
      "text": "丢了吧。",
      "token_start": 235,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 67220,
      "end_ms": 67560,
      "text": "你好，",
      "token_start": 238,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67760,
      "end_ms": 69280,
      "text": "我捡到了个充电宝和香水，",
      "token_start": 240,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 69420,
      "end_ms": 70100,
      "text": "找不着失主。",
      "token_start": 251,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 70180,
      "end_ms": 70460,
      "text": "好的，",
      "token_start": 256,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 70460,
      "end_ms": 71495,
      "text": "男士交给我们就行。",
      "token_start": 258,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 72450,
      "end_ms": 74410,
      "text": "我充电宝和香水放失物招认处了，",
      "token_start": 266,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 74490,
      "end_ms": 75765,
      "text": "你晚点来帮我取一下。",
      "token_start": 280,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 76110,
      "end_ms": 76635,
      "text": "领导，",
      "token_start": 289,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 77220,
      "end_ms": 79430,
      "text": "我家里有事想请假，",
      "token_start": 291,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 79430,
      "end_ms": 81600,
      "text": "一周回趟老家请假，",
      "token_start": 299,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 81600,
      "end_ms": 82585,
      "text": "一周太久了，",
      "token_start": 307,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 83390,
      "end_ms": 84585,
      "text": "项目正在关键期，",
      "token_start": 312,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 85240,
      "end_ms": 85740,
      "text": "你请假，",
      "token_start": 319,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 85740,
      "end_ms": 86820,
      "text": "我就只能换人了。",
      "token_start": 322,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 86960,
      "end_ms": 87535,
      "text": "领导，",
      "token_start": 329,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 88020,
      "end_ms": 88925,
      "text": "我家里有急事，",
      "token_start": 331,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 89260,
      "end_ms": 90595,
      "text": "原本需要请假一个月，",
      "token_start": 337,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 90900,
      "end_ms": 92525,
      "text": "但我考虑到项目正在关键期，",
      "token_start": 346,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 92980,
      "end_ms": 94525,
      "text": "所以我把请假压缩到了一周。",
      "token_start": 358,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 95690,
      "end_ms": 96090,
      "text": "不错，",
      "token_start": 370,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 96730,
      "end_ms": 97885,
      "text": "你快去快回吧。",
      "token_start": 372,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 98180,
      "end_ms": 98645,
      "text": "你好，",
      "token_start": 378,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 99360,
      "end_ms": 101345,
      "text": "我觉得你们房间里的香氛不错，",
      "token_start": 380,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 101880,
      "end_ms": 102715,
      "text": "想买点带回去，",
      "token_start": 393,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 103650,
      "end_ms": 104310,
      "text": "不好意思，",
      "token_start": 399,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 104310,
      "end_ms": 107175,
      "text": "男士房间里的物品概不出卖。",
      "token_start": 403,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 109100,
      "end_ms": 109445,
      "text": "哎，",
      "token_start": 415,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 109930,
      "end_ms": 110645,
      "text": "那算了吧。",
      "token_start": 416,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 111620,
      "end_ms": 112100,
      "text": "你好，",
      "token_start": 420,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 112700,
      "end_ms": 114675,
      "text": "我不小心把房间里的香氛摔坏了。",
      "token_start": 422,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 115080,
      "end_ms": 115440,
      "text": "抱歉，",
      "token_start": 436,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 115440,
      "end_ms": 118225,
      "text": "先生损坏房间物品要照价赔偿，",
      "token_start": 438,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 118730,
      "end_ms": 120095,
      "text": "香氛原价两百元，",
      "token_start": 451,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 120460,
      "end_ms": 122055,
      "text": "给你折扣赔款八十元。",
      "token_start": 458,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 122840,
      "end_ms": 123260,
      "text": "好的，",
      "token_start": 467,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 123400,
      "end_ms": 123965,
      "text": "没问题。",
      "token_start": 469,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 124250,
      "end_ms": 124590,
      "text": "你好，",
      "token_start": 472,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 124910,
      "end_ms": 128170,
      "text": "我刚才洗完头用房间里的吹风机吹一半就坏了，",
      "token_start": 474,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 128170,
      "end_ms": 129175,
      "text": "能给我换一个吗？",
      "token_start": 494,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 129870,
      "end_ms": 130230,
      "text": "抱歉，",
      "token_start": 501,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 130230,
      "end_ms": 130635,
      "text": "先生。",
      "token_start": 503,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 131040,
      "end_ms": 132100,
      "text": "根据酒店规定，",
      "token_start": 505,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 132240,
      "end_ms": 134185,
      "text": "损坏房间物品要照价赔偿。",
      "token_start": 511,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 137160,
      "end_ms": 139735,
      "text": "我要投诉房间吹风机质量太差，",
      "token_start": 522,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 140070,
      "end_ms": 141030,
      "text": "吹着头突然冒烟，",
      "token_start": 535,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 141050,
      "end_ms": 141785,
      "text": "吓死我了。",
      "token_start": 542,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 142180,
      "end_ms": 142500,
      "text": "抱歉，",
      "token_start": 546,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 142500,
      "end_ms": 142840,
      "text": "先生，",
      "token_start": 548,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 142840,
      "end_ms": 144100,
      "text": "我们马上给你处理房费，",
      "token_start": 550,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 144100,
      "end_ms": 144620,
      "text": "给你减免，",
      "token_start": 560,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 144700,
      "end_ms": 146020,
      "text": "并送你一份下午茶点心，",
      "token_start": 564,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 146080,
      "end_ms": 146775,
      "text": "请您消消气。",
      "token_start": 574,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 150490,
      "end_ms": 151115,
      "text": "好吧，",
      "token_start": 579,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 151260,
      "end_ms": 152065,
      "text": "这事儿就算了。",
      "token_start": 581,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 152430,
      "end_ms": 152830,
      "text": "你好，",
      "token_start": 587,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 153420,
      "end_ms": 155405,
      "text": "我老婆的钻戒好像落在酒店了，",
      "token_start": 589,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 155680,
      "end_ms": 156835,
      "text": "麻烦你们帮我找一下。",
      "token_start": 602,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 157870,
      "end_ms": 158615,
      "text": "不好意思，",
      "token_start": 611,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 158860,
      "end_ms": 159275,
      "text": "先生，",
      "token_start": 615,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 159590,
      "end_ms": 160425,
      "text": "我们没有看到，",
      "token_start": 617,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 160630,
      "end_ms": 161975,
      "text": "请你去其他地方问问。",
      "token_start": 623,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 164640,
      "end_ms": 165020,
      "text": "你好，",
      "token_start": 632,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 165340,
      "end_ms": 166280,
      "text": "你们打扫卫生时，",
      "token_start": 634,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 166280,
      "end_ms": 167685,
      "text": "把我老婆的钻戒搞丢了。",
      "token_start": 641,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 168360,
      "end_ms": 168780,
      "text": "好的，",
      "token_start": 651,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 169000,
      "end_ms": 169945,
      "text": "马上帮你核实。",
      "token_start": 653,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 172640,
      "end_ms": 173020,
      "text": "你好，",
      "token_start": 659,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 173240,
      "end_ms": 174455,
      "text": "确实捡到一枚钻戒，",
      "token_start": 661,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 174770,
      "end_ms": 176005,
      "text": "你看什么时候来取呢？",
      "token_start": 669,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 176510,
      "end_ms": 177415,
      "text": "我明天过来取，",
      "token_start": 678,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 177680,
      "end_ms": 180510,
      "text": "帮我收好牛啊，",
      "token_start": 684,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 180650,
      "end_ms": 181570,
      "text": "你怎么做到的？",
      "token_start": 690,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 182070,
      "end_ms": 183070,
      "text": "多亏了我父母，",
      "token_start": 696,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 183230,
      "end_ms": 185050,
      "text": "从小就让我看这本闲谈高手，",
      "token_start": 702,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 185270,
      "end_ms": 186790,
      "text": "才学会这套处事思路。",
      "token_start": 714,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 187250,
      "end_ms": 188930,
      "text": "如果你总感觉自己很老实，",
      "token_start": 723,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 189030,
      "end_ms": 189770,
      "text": "又没心眼，",
      "token_start": 734,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 189950,
      "end_ms": 191810,
      "text": "遇到事儿不知道怎么巧妙的处理。",
      "token_start": 738,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 192110,
      "end_ms": 193790,
      "text": "推荐你看看这本闲谈高手，",
      "token_start": 752,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 193930,
      "end_ms": 196590,
      "text": "他的所有能遇到的情况都给你一一列出来，",
      "token_start": 763,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 196770,
      "end_ms": 197790,
      "text": "让你轻松摆平。",
      "token_start": 781,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 197790,
      "end_ms": 200490,
      "text": "各种社交场合讲的全是怎么做人，",
      "token_start": 787,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 200570,
      "end_ms": 201870,
      "text": "怎么处事、怎么沟通，",
      "token_start": 801,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 201930,
      "end_ms": 202690,
      "text": "怎么去博弈，",
      "token_start": 809,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 202810,
      "end_ms": 203470,
      "text": "怎么防身，",
      "token_start": 814,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 203590,
      "end_ms": 204310,
      "text": "怎么化解，",
      "token_start": 818,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 204450,
      "end_ms": 205810,
      "text": "让你问答都有谋略。",
      "token_start": 822,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 206030,
      "end_ms": 207850,
      "text": "当遇到解决不了的麻烦事儿，",
      "token_start": 830,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 207930,
      "end_ms": 209345,
      "text": "不是你自己有多笨，",
      "token_start": 842,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 209740,
      "end_ms": 211040,
      "text": "而是你不知道该怎么说。",
      "token_start": 850,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 211740,
      "end_ms": 213480,
      "text": "如果你认真看完这本闲谈，",
      "token_start": 860,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 213480,
      "end_ms": 215060,
      "text": "高手还说没城府，",
      "token_start": 871,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 215340,
      "end_ms": 216800,
      "text": "不会巧妙的处理事情，",
      "token_start": 878,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 216920,
      "end_ms": 217860,
      "text": "这是不可能的。",
      "token_start": 887,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 217920,
      "end_ms": 220860,
      "text": "一句顶一万句的社交谋略话术尽在这套书中。",
      "token_start": 893,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 221200,
      "end_ms": 225220,
      "text": "这是一套教你如何在言谈举止中得握分寸、从容处事的指南。",
      "token_start": 912,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 225680,
      "end_ms": 226420,
      "text": "学了三分，",
      "token_start": 937,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 226660,
      "end_ms": 229000,
      "text": "你就能在工作和生活当中得心应手，",
      "token_start": 941,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 229080,
      "end_ms": 229760,
      "text": "事半功倍。",
      "token_start": 956,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 229940,
      "end_ms": 231560,
      "text": "平时总看这本闲谈高手，",
      "token_start": 960,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 231580,
      "end_ms": 233060,
      "text": "真是学到了很多的方法。",
      "token_start": 970,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 233200,
      "end_ms": 235280,
      "text": "行走江湖居之必备事，",
      "token_start": 980,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 235280,
      "end_ms": 235845,
      "text": "谈高手。",
      "token_start": 989,
      "token_end_exclusive": 992
    }
