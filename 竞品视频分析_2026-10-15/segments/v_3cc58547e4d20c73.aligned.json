{
  "video_id": "v_3cc58547e4d20c73",
  "duration_s": 426.724138,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_3cc58547e4d20c73.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_3cc58547e4d20c73.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 5010,
      "text": "王淦昌消失的那十七年家里发生了一件事儿，",
      "token_start": 0,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 5010,
      "end_ms": 8510,
      "text": "每次想起来都让人喘不过气。",
      "token_start": 19,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 8510,
      "end_ms": 11590,
      "text": "有一回他的妻子重病住院，",
      "token_start": 31,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 11730,
      "end_ms": 12590,
      "text": "生死未卜，",
      "token_start": 42,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12970,
      "end_ms": 14250,
      "text": "家里人急疯了，",
      "token_start": 46,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 14630,
      "end_ms": 16770,
      "text": "连发了好几封加急电报，",
      "token_start": 52,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 17110,
      "end_ms": 18390,
      "text": "催他赶紧回去。",
      "token_start": 62,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 18970,
      "end_ms": 24010,
      "text": "可那几天正赶上原子弹试验最要命的最后攻坚期，",
      "token_start": 68,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 24590,
      "end_ms": 26410,
      "text": "电报送到他手上的时候，",
      "token_start": 89,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 26590,
      "end_ms": 31780,
      "text": "他正在实验室里连把那封电报死死攥在手里。",
      "token_start": 99,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 32060,
      "end_ms": 36980,
      "text": "揉得皱巴巴的最后颤抖着揣进了怀里，",
      "token_start": 118,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 36980,
      "end_ms": 40100,
      "text": "转身又一头扎进了实验数据。",
      "token_start": 134,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 40700,
      "end_ms": 41480,
      "text": "那天晚上，",
      "token_start": 146,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 41800,
      "end_ms": 45540,
      "text": "有人在戈壁滩上看到他一个人坐在沙丘上，",
      "token_start": 150,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 45880,
      "end_ms": 47520,
      "text": "手里捏着那封电报，",
      "token_start": 168,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 48000,
      "end_ms": 50580,
      "text": "直勾勾的望着北京的方向，",
      "token_start": 176,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 51060,
      "end_ms": 52540,
      "text": "像一尊石像，",
      "token_start": 187,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 53040,
      "end_ms": 53920,
      "text": "一动不动，",
      "token_start": 192,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 54340,
      "end_ms": 56140,
      "text": "坐了整整两个小时。",
      "token_start": 196,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 56620,
      "end_ms": 59500,
      "text": "您想想那个画面漫天风沙，",
      "token_start": 204,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 60230,
      "end_ms": 63635,
      "text": "一个五十多岁的老人坐在沙丘上，",
      "token_start": 215,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 64020,
      "end_ms": 66435,
      "text": "手里攥着妻子病危的电报，",
      "token_start": 229,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67040,
      "end_ms": 68400,
      "text": "望着家的方向，",
      "token_start": 240,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 68520,
      "end_ms": 69705,
      "text": "他不能回去，",
      "token_start": 246,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 70340,
      "end_ms": 71275,
      "text": "他回不去。",
      "token_start": 251,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 71770,
      "end_ms": 74835,
      "text": "因为他手里攥着的不只是一个家的命，",
      "token_start": 255,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 75120,
      "end_ms": 76915,
      "text": "还有整个国家的命。",
      "token_start": 271,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 77470,
      "end_ms": 78925,
      "text": "后来试验成功了，",
      "token_start": 279,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 79310,
      "end_ms": 80905,
      "text": "他发疯似的赶回家。",
      "token_start": 286,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 81410,
      "end_ms": 82805,
      "text": "妻子刚出院不久，",
      "token_start": 294,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 83180,
      "end_ms": 84505,
      "text": "当妻子抬起头，",
      "token_start": 301,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 85020,
      "end_ms": 89575,
      "text": "看着面前这个晒的黢黑满脸深深的皱纹，",
      "token_start": 307,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 89940,
      "end_ms": 92885,
      "text": "头发白了大半的陌生男人时，",
      "token_start": 324,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 93370,
      "end_ms": 94690,
      "text": "半天没说出话，",
      "token_start": 336,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 95010,
      "end_ms": 98010,
      "text": "眼泪却像断了线的珠子一样，",
      "token_start": 342,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 98110,
      "end_ms": 101115,
      "text": "先掉了下来整整十七年了，",
      "token_start": 354,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 101700,
      "end_ms": 104455,
      "text": "他不知道他在哪不知道他在干什么，",
      "token_start": 365,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 104760,
      "end_ms": 107020,
      "text": "甚至不知道他是不是还活着。",
      "token_start": 380,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 107120,
      "end_ms": 110665,
      "text": "您说这十七年他是怎么熬过来的？",
      "token_start": 392,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 111690,
      "end_ms": 113230,
      "text": "在戈壁滩的那些年，",
      "token_start": 406,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 113470,
      "end_ms": 115825,
      "text": "王淦昌是技术总负责人，",
      "token_start": 414,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 116420,
      "end_ms": 119365,
      "text": "按说他完全可以坐在后方指挥，",
      "token_start": 424,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 119820,
      "end_ms": 121365,
      "text": "用不着去现场拼命。",
      "token_start": 437,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 122120,
      "end_ms": 124330,
      "text": "可他偏不戈壁滩，",
      "token_start": 445,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 124370,
      "end_ms": 125410,
      "text": "漫天风沙，",
      "token_start": 452,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 125630,
      "end_ms": 127890,
      "text": "大家永远能看到他蹲在地上，",
      "token_start": 456,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 128170,
      "end_ms": 130745,
      "text": "跟年轻人一起趴着调试设备，",
      "token_start": 468,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 131120,
      "end_ms": 132400,
      "text": "饿了就啃口，",
      "token_start": 480,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 132400,
      "end_ms": 132805,
      "text": "干粮，",
      "token_start": 485,
      "token_end_exclusive": 487
    },
    {
      "start_ms": 133120,
      "end_ms": 135675,
      "text": "困了就靠在土墙上打个盹。",
      "token_start": 487,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 136260,
      "end_ms": 137260,
      "text": "身边人劝他，",
      "token_start": 498,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 137420,
      "end_ms": 138805,
      "text": "您都这把年纪了，",
      "token_start": 503,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 139130,
      "end_ms": 141330,
      "text": "总这么熬也不是个事儿啊，",
      "token_start": 510,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 141330,
      "end_ms": 142145,
      "text": "歇一歇吧，",
      "token_start": 521,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 143280,
      "end_ms": 144425,
      "text": "他急得直摆手，",
      "token_start": 525,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 145310,
      "end_ms": 146655,
      "text": "这是国家的命脉，",
      "token_start": 531,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 147430,
      "end_ms": 149235,
      "text": "差一丝一毫都不行，",
      "token_start": 538,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 150110,
      "end_ms": 151565,
      "text": "哪怕熬断骨头，",
      "token_start": 546,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 152210,
      "end_ms": 153745,
      "text": "我也得亲自盯着。",
      "token_start": 552,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 155020,
      "end_ms": 158295,
      "text": "从一九六一年到一九六四年，",
      "token_start": 559,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 158810,
      "end_ms": 164730,
      "text": "他指导了上千次爆轰事宴第一颗原子弹的，",
      "token_start": 571,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 164730,
      "end_ms": 168075,
      "text": "每一个核心部件都经过了他的手，",
      "token_start": 589,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 168400,
      "end_ms": 170545,
      "text": "一个一个检测过来的。",
      "token_start": 603,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 172270,
      "end_ms": 174245,
      "text": "一九六四年十月十六日，",
      "token_start": 612,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 174500,
      "end_ms": 177365,
      "text": "罗布泊内一声惊天巨响，",
      "token_start": 622,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 177760,
      "end_ms": 180535,
      "text": "巨大的蘑菇云腾空升起，",
      "token_start": 632,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 180970,
      "end_ms": 182550,
      "text": "震惊了全世界。",
      "token_start": 642,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 182690,
      "end_ms": 187075,
      "text": "在所有欢呼雀跃、相拥而泣的人群里，",
      "token_start": 648,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 187480,
      "end_ms": 189675,
      "text": "他只能默默站在角落，",
      "token_start": 663,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 190050,
      "end_ms": 191615,
      "text": "看着漫天火光，",
      "token_start": 672,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 192140,
      "end_ms": 194555,
      "text": "双手控制不住的剧烈颤抖，",
      "token_start": 678,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 194920,
      "end_ms": 199325,
      "text": "没人知道这个戴着眼镜皮肤粗糙的老头，",
      "token_start": 689,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 199680,
      "end_ms": 202685,
      "text": "就是当年名震海外的物理学天才。",
      "token_start": 706,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 203410,
      "end_ms": 204245,
      "text": "没人知道，",
      "token_start": 720,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 204640,
      "end_ms": 206095,
      "text": "为了这一声巨响，",
      "token_start": 724,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 206430,
      "end_ms": 207590,
      "text": "他放弃了什么，",
      "token_start": 731,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 207770,
      "end_ms": 208830,
      "text": "亏欠了什么，",
      "token_start": 737,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 209030,
      "end_ms": 210390,
      "text": "又忍受了什么。",
      "token_start": 742,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 210730,
      "end_ms": 211450,
      "text": "三年后，",
      "token_start": 748,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 211710,
      "end_ms": 214215,
      "text": "中国的第一颗氢弹爆炸成功，",
      "token_start": 751,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 214770,
      "end_ms": 216175,
      "text": "从原子弹到氢弹，",
      "token_start": 763,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 216490,
      "end_ms": 218710,
      "text": "咱们只用了两年零八个月，",
      "token_start": 770,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 218790,
      "end_ms": 221155,
      "text": "全世界研制速度最快的国家，",
      "token_start": 781,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 221520,
      "end_ms": 227575,
      "text": "至今还一直保持着这个让世界胆寒的奇迹背后，",
      "token_start": 793,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 227950,
      "end_ms": 233360,
      "text": "是他和无数中国科研人员拿命熬出来的这十七年。",
      "token_start": 813,
      "token_end_exclusive": 834
    },
    {
      "start_ms": 233640,
      "end_ms": 236325,
      "text": "从五十四岁到七十一岁，",
      "token_start": 834,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 237130,
      "end_ms": 242345,
      "text": "他把一个科学家最宝贵的年华全部埋进了戈壁黄沙里。",
      "token_start": 844,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 243230,
      "end_ms": 244230,
      "text": "一九七八年，",
      "token_start": 867,
      "token_end_exclusive": 872
    },
    {
      "start_ms": 244430,
      "end_ms": 248175,
      "text": "他终于恢复了本名回到了北京。",
      "token_start": 872,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 249130,
      "end_ms": 253295,
      "text": "这时候的他已经是一个七十一岁的老人了。",
      "token_start": 885,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 254380,
      "end_ms": 255575,
      "text": "后来有人问他，",
      "token_start": 903,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 255920,
      "end_ms": 258380,
      "text": "放弃了所有的荣誉和光环，",
      "token_start": 909,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 258480,
      "end_ms": 261215,
      "text": "你感觉亏不亏后不后悔。",
      "token_start": 920,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 262140,
      "end_ms": 263640,
      "text": "他笑的云淡风轻，",
      "token_start": 930,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 264020,
      "end_ms": 264995,
      "text": "说了一句话，",
      "token_start": 937,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 265850,
      "end_ms": 268645,
      "text": "能让咱们国家不再受人欺负。",
      "token_start": 942,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 269370,
      "end_ms": 272175,
      "text": "别说十七年搭上一辈子，",
      "token_start": 954,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 273970,
      "end_ms": 274210,
      "text": "嗯，",
      "token_start": 964,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 275160,
      "end_ms": 278145,
      "text": "晚年的他住在简陋的老房子里，",
      "token_start": 965,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 278420,
      "end_ms": 278685,
      "text": "嗯，",
      "token_start": 978,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 278930,
      "end_ms": 281245,
      "text": "国家发的奖金他一分不留，",
      "token_start": 979,
      "token_end_exclusive": 990
    },
    {
      "start_ms": 281730,
      "end_ms": 284345,
      "text": "全捐给了科研事业和贫困学生，",
      "token_start": 990,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 284970,
      "end_ms": 288135,
      "text": "一件破旧的中山装穿了十几年。",
      "token_start": 1003,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 288730,
      "end_ms": 289595,
      "text": "一九九八年，",
      "token_start": 1016,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 290650,
      "end_ms": 291835,
      "text": "这位老人走了，",
      "token_start": 1021,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 292590,
      "end_ms": 294155,
      "text": "享年九十一岁。",
      "token_start": 1027,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 295030,
      "end_ms": 297450,
      "text": "家里没有一件像样的家具，",
      "token_start": 1033,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 297530,
      "end_ms": 300650,
      "text": "只留下了满满一屋子的科研资料。",
      "token_start": 1044,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 301550,
      "end_ms": 302625,
      "text": "九个月后，",
      "token_start": 1058,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 303130,
      "end_ms": 306985,
      "text": "国家追授他两弹一星功勋奖章。",
      "token_start": 1062,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 307900,
      "end_ms": 310020,
      "text": "可是他已经看不到了，",
      "token_start": 1075,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 311500,
      "end_ms": 315280,
      "text": "各位老朋友王老走了，",
      "token_start": 1084,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 315640,
      "end_ms": 318200,
      "text": "但他的故事不该就这么结束。",
      "token_start": 1093,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 318740,
      "end_ms": 319460,
      "text": "您想想，",
      "token_start": 1105,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 320000,
      "end_ms": 322279,
      "text": "他的妻子等了他十七年，",
      "token_start": 1108,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 322680,
      "end_ms": 325560,
      "text": "他的女儿十几年没有父亲，",
      "token_start": 1118,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 326520,
      "end_ms": 327420,
      "text": "可在中国，",
      "token_start": 1129,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 327800,
      "end_ms": 329160,
      "text": "像这样的家庭，",
      "token_start": 1133,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 329580,
      "end_ms": 332460,
      "text": "又何止他一个邓稼先的妻子？",
      "token_start": 1139,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 332460,
      "end_ms": 334720,
      "text": "许露西在丈夫消失后，",
      "token_start": 1151,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 334840,
      "end_ms": 336460,
      "text": "一个人拉扯两个孩子，",
      "token_start": 1160,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 336540,
      "end_ms": 338180,
      "text": "等了整整二十八年。",
      "token_start": 1169,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 338580,
      "end_ms": 341000,
      "text": "郭永怀飞机失世用，",
      "token_start": 1177,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 341060,
      "end_ms": 346350,
      "text": "身体互助绝密资料牺牲时才五十九岁前三强，",
      "token_start": 1185,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 346430,
      "end_ms": 348570,
      "text": "被称为中国原子弹之父，",
      "token_start": 1204,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 349230,
      "end_ms": 352870,
      "text": "却在最艰难的岁月里被下放到农村，",
      "token_start": 1214,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 353470,
      "end_ms": 357530,
      "text": "他们每一个人都把家字放在了国字后面。",
      "token_start": 1229,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 358070,
      "end_ms": 361010,
      "text": "这些人的故事不该只活在档案里。",
      "token_start": 1246,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 361730,
      "end_ms": 364350,
      "text": "他以我想给大伙推荐这套国之脊梁，",
      "token_start": 1260,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 365070,
      "end_ms": 367705,
      "text": "他是环球人物杂志社主编的，",
      "token_start": 1275,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 368270,
      "end_ms": 373950,
      "text": "里面收录了三十多位科学界功勋人物的真实人生。",
      "token_start": 1287,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 374030,
      "end_ms": 376755,
      "text": "从两弹一星到航天农业，",
      "token_start": 1308,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 377190,
      "end_ms": 379215,
      "text": "从钱学森到袁隆平，",
      "token_start": 1318,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 379720,
      "end_ms": 381845,
      "text": "一个比一个让人戳心。",
      "token_start": 1326,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 382630,
      "end_ms": 385130,
      "text": "书里有大量珍贵的历史老照片，",
      "token_start": 1335,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 385410,
      "end_ms": 387775,
      "text": "还有院士们的亲笔语录，",
      "token_start": 1348,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 388280,
      "end_ms": 390525,
      "text": "不是那种干巴巴的人物传记。",
      "token_start": 1358,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 390960,
      "end_ms": 392375,
      "text": "您翻开看两页，",
      "token_start": 1370,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 392660,
      "end_ms": 398150,
      "text": "就知道什么叫把一生交给国家的人自己读是一份敬意。",
      "token_start": 1376,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 398450,
      "end_ms": 400775,
      "text": "给孩子读是一种传承，",
      "token_start": 1399,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 401320,
      "end_ms": 405595,
      "text": "让咱们的孩子知道今天的好日子不是天上掉下来，",
      "token_start": 1408,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 405990,
      "end_ms": 407950,
      "text": "是有人拿命换的书。",
      "token_start": 1429,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 408030,
      "end_ms": 411290,
      "text": "就在视频左下角感兴趣的朋友带回去，",
      "token_start": 1437,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 411470,
      "end_ms": 412155,
      "text": "点个赞，",
      "token_start": 1453,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 412470,
      "end_ms": 413325,
      "text": "收藏起来，",
      "token_start": 1456,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 413630,
      "end_ms": 414715,
      "text": "评论区留一句，",
      "token_start": 1460,
      "token_end_exclusive": 1466
    },
    {
      "start_ms": 414990,
      "end_ms": 415435,
      "text": "王老，",
      "token_start": 1466,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 415740,
      "end_ms": 416760,
      "text": "我们记住您了，",
      "token_start": 1468,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 417020,
      "end_ms": 419395,
      "text": "再转发给身边的老朋友，",
      "token_start": 1474,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 419870,
      "end_ms": 420515,
      "text": "关注我，",
      "token_start": 1484,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 420950,
      "end_ms": 426565,
      "text": "下一期继续讲那些把名字藏进黄沙里的国之脊梁。",
      "token_start": 1487,
      "token_end_exclusive": 1508
    }
  ],
