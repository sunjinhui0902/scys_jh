{
  "video_id": "v_9e1d7750c78c69e8",
  "duration_s": 671.638005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_9e1d7750c78c69e8.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_9e1d7750c78c69e8.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 480,
      "end_ms": 880,
      "text": "周军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1140,
      "end_ms": 1840,
      "text": "你知道吗？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1980,
      "end_ms": 3920,
      "text": "我身后这里是中国的迪拜，",
      "token_start": 6,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4020,
      "end_ms": 5960,
      "text": "它曾经比深圳还要开放，",
      "token_start": 17,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 6200,
      "end_ms": 9360,
      "text": "但它将在五十年之后完全消失在沙漠里。",
      "token_start": 27,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 9580,
      "end_ms": 11340,
      "text": "这里不允许游客拍照，",
      "token_start": 44,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 11560,
      "end_ms": 14100,
      "text": "但它竟然是中国唯一没有差评的景点。",
      "token_start": 53,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 14400,
      "end_ms": 16480,
      "text": "这里的沙漠里居然还有红绿灯，",
      "token_start": 69,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 16580,
      "end_ms": 18160,
      "text": "而等红灯的不是汽车，",
      "token_start": 82,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 18320,
      "end_ms": 19540,
      "text": "竟然是骆驼。",
      "token_start": 91,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 20000,
      "end_ms": 22280,
      "text": "这里就是人生一定要来一次的地方。",
      "token_start": 96,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 22660,
      "end_ms": 23180,
      "text": "敦煌，",
      "token_start": 111,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 23840,
      "end_ms": 25640,
      "text": "你知道敦煌有多牛吗？",
      "token_start": 113,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 25680,
      "end_ms": 28280,
      "text": "它可是中国古代版的深圳、汉朝。",
      "token_start": 122,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 28320,
      "end_ms": 30015,
      "text": "改革开放的前沿阵地，",
      "token_start": 135,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 30310,
      "end_ms": 31670,
      "text": "相当于今天的上海，",
      "token_start": 144,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 31690,
      "end_ms": 32490,
      "text": "加上纽约，",
      "token_start": 152,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 32530,
      "end_ms": 33990,
      "text": "加上迪拜的综合体。",
      "token_start": 156,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 34310,
      "end_ms": 36090,
      "text": "敦煌是汉朝的西大门，",
      "token_start": 164,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 36290,
      "end_ms": 37390,
      "text": "向东是长安，",
      "token_start": 173,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 37390,
      "end_ms": 39050,
      "text": "洛阳继续向东延伸，",
      "token_start": 178,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 39050,
      "end_ms": 41430,
      "text": "可到朝鲜半岛、日本列岛向西，",
      "token_start": 186,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 41470,
      "end_ms": 42970,
      "text": "经过新疆的南北两道，",
      "token_start": 198,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 42990,
      "end_ms": 44110,
      "text": "翻过帕米尔高原，",
      "token_start": 207,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 44130,
      "end_ms": 44890,
      "text": "可达中亚。",
      "token_start": 214,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 45170,
      "end_ms": 45730,
      "text": "再往南，",
      "token_start": 218,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 45770,
      "end_ms": 46690,
      "text": "可以到印度，",
      "token_start": 221,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 46750,
      "end_ms": 50110,
      "text": "再往西可到波斯、两河流域、叙利亚、地中海世界，",
      "token_start": 226,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 50210,
      "end_ms": 51730,
      "text": "乃至古希腊和古埃及。",
      "token_start": 245,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 51990,
      "end_ms": 53810,
      "text": "从敦煌向北越过戈壁，",
      "token_start": 254,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 53830,
      "end_ms": 55610,
      "text": "又进入草原丝绸之路。",
      "token_start": 263,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 55890,
      "end_ms": 61985,
      "text": "敦煌是中原文明、印度文明、希腊文明、伊斯兰文明伟一的大规模教汇的土地。",
      "token_start": 272,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 62440,
      "end_ms": 64860,
      "text": "古代商人必须在敦煌申领过锁，",
      "token_start": 303,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 64900,
      "end_ms": 66200,
      "text": "也就是古代的通行证，",
      "token_start": 316,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 66340,
      "end_ms": 68990,
      "text": "才能够出关走玉门关阳关，",
      "token_start": 325,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 69290,
      "end_ms": 71470,
      "text": "才有了富的流油的丝绸之路。",
      "token_start": 336,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 71750,
      "end_ms": 73695,
      "text": "难怪这座城叫敦煌，",
      "token_start": 348,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 74160,
      "end_ms": 76975,
      "text": "蹲着大爷皇者盛宴，",
      "token_start": 356,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 77300,
      "end_ms": 78885,
      "text": "既博大又辉煌。",
      "token_start": 364,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 79160,
      "end_ms": 79540,
      "text": "敦煌，",
      "token_start": 370,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 79540,
      "end_ms": 81185,
      "text": "这两个字他配得上，",
      "token_start": 372,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 81660,
      "end_ms": 82660,
      "text": "但是你能想象吗？",
      "token_start": 380,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 82660,
      "end_ms": 83880,
      "text": "如此美好的敦煌，",
      "token_start": 387,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 84060,
      "end_ms": 86175,
      "text": "却是每一个中国人的伤心之地，",
      "token_start": 394,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 86470,
      "end_ms": 89335,
      "text": "没有人能笑着离开敦煌莫高窟。",
      "token_start": 407,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 89920,
      "end_ms": 91100,
      "text": "公元三六六年，",
      "token_start": 420,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 91280,
      "end_ms": 94085,
      "text": "僧人岳尊路经鸣沙山东路，",
      "token_start": 426,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 94380,
      "end_ms": 96995,
      "text": "忽然见到金光万耀如现万福。",
      "token_start": 437,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 97300,
      "end_ms": 99615,
      "text": "于是在岩壁上开凿了第一个洞窟。",
      "token_start": 449,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 99920,
      "end_ms": 101625,
      "text": "在之后的一千六百多年中，",
      "token_start": 463,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 101870,
      "end_ms": 105085,
      "text": "人们在高七十米长一千七百米的断崖之上，",
      "token_start": 474,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 105320,
      "end_ms": 107255,
      "text": "开辟了七百三十五个洞窟，",
      "token_start": 492,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 107510,
      "end_ms": 109550,
      "text": "画了四万五千多平米的壁画，",
      "token_start": 503,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 109730,
      "end_ms": 111665,
      "text": "还有两千四百多吨的彩塑。",
      "token_start": 515,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 112010,
      "end_ms": 113050,
      "text": "但在晚清时期，",
      "token_start": 526,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 113070,
      "end_ms": 115765,
      "text": "这些珍宝被西方列强大量骗取。",
      "token_start": 532,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 116200,
      "end_ms": 117100,
      "text": "一九零零年，",
      "token_start": 545,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 117240,
      "end_ms": 121025,
      "text": "英国人斯坦因带走了敦煌酒香经书图画刺绣。",
      "token_start": 550,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 121360,
      "end_ms": 122180,
      "text": "一九零七年，",
      "token_start": 569,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 122300,
      "end_ms": 127065,
      "text": "法国人伯希河带走敦煌藏经洞最精华的六千卷古书经文。",
      "token_start": 574,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 127400,
      "end_ms": 128260,
      "text": "一九二四年，",
      "token_start": 598,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 128400,
      "end_ms": 132865,
      "text": "美国人华尔纳到莫高窟玻璃的唐代精品壁画二十六块。",
      "token_start": 603,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 133280,
      "end_ms": 134440,
      "text": "如果你来到莫高窟，",
      "token_start": 626,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 134440,
      "end_ms": 136020,
      "text": "看到玻璃之后的壁画，",
      "token_start": 634,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 136040,
      "end_ms": 137380,
      "text": "一定会触目惊心，",
      "token_start": 643,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 137580,
      "end_ms": 138425,
      "text": "痛到泪目。",
      "token_start": 650,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 138810,
      "end_ms": 139250,
      "text": "如今，",
      "token_start": 654,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 139530,
      "end_ms": 143205,
      "text": "中国莫高窟的文物被收藏在全球各个地方的博物馆，",
      "token_start": 656,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 143520,
      "end_ms": 149350,
      "text": "在法国卢浮宫东京国立博物馆、俄国东方学研究所美国哈佛大学等等，",
      "token_start": 678,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 149530,
      "end_ms": 152295,
      "text": "唯独留在中国的寥寥少数。",
      "token_start": 707,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 152760,
      "end_ms": 153440,
      "text": "曾几何时，",
      "token_start": 718,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 153640,
      "end_ms": 155580,
      "text": "中国学者想要研究敦煌，",
      "token_start": 722,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 155740,
      "end_ms": 156520,
      "text": "还得屈辱，",
      "token_start": 732,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 156540,
      "end_ms": 158445,
      "text": "向外国购买胶卷和复印件。",
      "token_start": 736,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 158750,
      "end_ms": 160765,
      "text": "日本学者更是说了一句扎心的话。",
      "token_start": 747,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 161120,
      "end_ms": 165205,
      "text": "敦煌在中国敦煌穴在日本陈奕迅先生说，",
      "token_start": 761,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 165420,
      "end_ms": 166120,
      "text": "敦煌者，",
      "token_start": 778,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 166200,
      "end_ms": 168245,
      "text": "吴国学术之伤心实也。",
      "token_start": 781,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 168540,
      "end_ms": 169860,
      "text": "整整一百一十年前，",
      "token_start": 790,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 169940,
      "end_ms": 173040,
      "text": "一位叫常书红的年轻人在法国留学时，",
      "token_start": 798,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 173200,
      "end_ms": 174760,
      "text": "偶然发现一部敦煌画册，",
      "token_start": 814,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 174760,
      "end_ms": 176005,
      "text": "被他深深的震撼。",
      "token_start": 824,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 176330,
      "end_ms": 178250,
      "text": "我大老远来的欧洲学习艺术，",
      "token_start": 831,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 178410,
      "end_ms": 180210,
      "text": "才发现世界上最伟大的艺术，",
      "token_start": 843,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 180210,
      "end_ms": 182195,
      "text": "竟然就在中国在敦煌。",
      "token_start": 855,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 182540,
      "end_ms": 183780,
      "text": "他不顾所有人的反对，",
      "token_start": 864,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 183780,
      "end_ms": 185780,
      "text": "毅然回到了战火纷飞的祖国，",
      "token_start": 873,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 185920,
      "end_ms": 186660,
      "text": "要去保护，",
      "token_start": 885,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 186840,
      "end_ms": 193685,
      "text": "重现敦煌国宝种菜、种树、治沙、住破庙、吃咸菜、喝苦水，",
      "token_start": 889,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 194020,
      "end_ms": 196815,
      "text": "还要与各种企图掠夺敦煌宝藏的人周旋。",
      "token_start": 910,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 197240,
      "end_ms": 198000,
      "text": "张大千说，",
      "token_start": 927,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 198140,
      "end_ms": 199460,
      "text": "这里是无期徒刑，",
      "token_start": 931,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 199640,
      "end_ms": 200875,
      "text": "待了两年就走了。",
      "token_start": 938,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 201180,
      "end_ms": 201480,
      "text": "可是，",
      "token_start": 945,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 201480,
      "end_ms": 205775,
      "text": "常书红长沙那妇女竟然坚持了两万八千多个日夜，",
      "token_start": 947,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 206010,
      "end_ms": 208785,
      "text": "一起守护了数万届敦煌珍贵文物。",
      "token_start": 968,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 209200,
      "end_ms": 209720,
      "text": "不久前，",
      "token_start": 982,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 209780,
      "end_ms": 211380,
      "text": "长沙那奶奶来到敦煌，",
      "token_start": 985,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 211640,
      "end_ms": 213160,
      "text": "对着父亲常书红的墓，",
      "token_start": 994,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 213340,
      "end_ms": 214725,
      "text": "轻声呼唤着爸爸，",
      "token_start": 1003,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 214980,
      "end_ms": 217635,
      "text": "哽咽的回忆起守护敦煌的点点滴滴。",
      "token_start": 1010,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 217990,
      "end_ms": 219750,
      "text": "眼前这一幕是九十多岁的。",
      "token_start": 1025,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 219750,
      "end_ms": 224395,
      "text": "长沙的奶奶在敦煌与八十多岁的樊景诗奶奶牵手告别，",
      "token_start": 1036,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 224940,
      "end_ms": 226780,
      "text": "经几代人的接力守护，",
      "token_start": 1059,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 227040,
      "end_ms": 228960,
      "text": "从修复第一幅壁画开始，",
      "token_start": 1068,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 229080,
      "end_ms": 231665,
      "text": "到如今敦煌月牙泉的万人大合唱，",
      "token_start": 1078,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 231990,
      "end_ms": 235415,
      "text": "再到千万人携手把国旗升在鸣沙山。",
      "token_start": 1092,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 236080,
      "end_ms": 237165,
      "text": "所谓守护文明，",
      "token_start": 1107,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 237390,
      "end_ms": 239375,
      "text": "就是明知道时间不可战胜，",
      "token_start": 1113,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 239660,
      "end_ms": 242875,
      "text": "仍然有一些人愿意替后人多留住他一天。",
      "token_start": 1124,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 243330,
      "end_ms": 246705,
      "text": "但是朱军你知道莫高窟为什么坚决不让拍照吗？",
      "token_start": 1141,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 247190,
      "end_ms": 248570,
      "text": "敦煌一年一场，",
      "token_start": 1161,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 248570,
      "end_ms": 250170,
      "text": "风从春刮到冬，",
      "token_start": 1167,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 250370,
      "end_ms": 252435,
      "text": "而且最大风力可以达到十级。",
      "token_start": 1173,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 252900,
      "end_ms": 253140,
      "text": "所以，",
      "token_start": 1185,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 253140,
      "end_ms": 254340,
      "text": "在你我有生之年，",
      "token_start": 1187,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 254480,
      "end_ms": 258495,
      "text": "整个敦煌莫高窟可能将永远消失在黄沙中。",
      "token_start": 1194,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 258900,
      "end_ms": 260260,
      "text": "为了保护洞窟的壁画，",
      "token_start": 1212,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 260360,
      "end_ms": 263035,
      "text": "敦煌研究院对每个洞窟进行实时监测，",
      "token_start": 1221,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 263300,
      "end_ms": 264520,
      "text": "一旦有害物质超标，",
      "token_start": 1237,
      "token_end_exclusive": 1245
    },
    {
      "start_ms": 264640,
      "end_ms": 265975,
      "text": "洞窟会立刻关闭。",
      "token_start": 1245,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 266320,
      "end_ms": 267060,
      "text": "即便如此，",
      "token_start": 1252,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 267140,
      "end_ms": 270145,
      "text": "敦煌壁画仍然不可避免的褪色剥落，",
      "token_start": 1256,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 270550,
      "end_ms": 273315,
      "text": "而且游客呼出的二氧化碳和散发的热量，",
      "token_start": 1271,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 273570,
      "end_ms": 274835,
      "text": "还有打开的闪光灯，",
      "token_start": 1288,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 275050,
      "end_ms": 277215,
      "text": "对壁画的破坏都是不可逆的。",
      "token_start": 1296,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 277560,
      "end_ms": 282710,
      "text": "敦煌莫高窟这一生看一眼扫一眼敦煌最残酷的地方，",
      "token_start": 1308,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 282790,
      "end_ms": 285250,
      "text": "是你站在一千多年前的美面前，",
      "token_start": 1330,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 285390,
      "end_ms": 287855,
      "text": "却知道他正在一点点老去。",
      "token_start": 1343,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 288340,
      "end_ms": 290360,
      "text": "你知道敦煌人有多么不容易吗？",
      "token_start": 1354,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 290520,
      "end_ms": 291260,
      "text": "三年之前，",
      "token_start": 1367,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 291260,
      "end_ms": 294950,
      "text": "敦煌研究院考古编制的岗位有五六个人报名，",
      "token_start": 1371,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 294970,
      "end_ms": 296545,
      "text": "但最后全部缺考。",
      "token_start": 1390,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 296970,
      "end_ms": 305830,
      "text": "从一九四四年国立敦煌艺术研究所成立到今天七十多年里有上千名考古修复美术工作者扎根大漠。",
      "token_start": 1397,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 306010,
      "end_ms": 307750,
      "text": "很多人一辈子隐姓埋名，",
      "token_start": 1439,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 307930,
      "end_ms": 310030,
      "text": "每天趴在壁画上用几个月，",
      "token_start": 1449,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 310130,
      "end_ms": 314930,
      "text": "甚至几年修复一面墙和氧化苏减等病害赛跑，",
      "token_start": 1460,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 315310,
      "end_ms": 316790,
      "text": "择一世终一生。",
      "token_start": 1479,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 317010,
      "end_ms": 318770,
      "text": "他们把一生埋进黄沙，",
      "token_start": 1485,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 318970,
      "end_ms": 321630,
      "text": "只为了不让我们的文明也埋进黄沙。",
      "token_start": 1494,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 321910,
      "end_ms": 324030,
      "text": "经过中国几代学者的默默努力，",
      "token_start": 1509,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 324150,
      "end_ms": 326605,
      "text": "如今人们已经越来越重视保护敦煌。",
      "token_start": 1522,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 327020,
      "end_ms": 329420,
      "text": "当我们和外国人谈论文化艺术的时候，",
      "token_start": 1537,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 329480,
      "end_ms": 331520,
      "text": "终于可以腰杆挺直一点。",
      "token_start": 1553,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 331880,
      "end_ms": 332420,
      "text": "在这里，",
      "token_start": 1563,
      "token_end_exclusive": 1566
    },
    {
      "start_ms": 332420,
      "end_ms": 333920,
      "text": "你可以看到敦煌飞天，",
      "token_start": 1566,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 334080,
      "end_ms": 335160,
      "text": "有的抱着乐器，",
      "token_start": 1575,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 335260,
      "end_ms": 336000,
      "text": "有的撒花，",
      "token_start": 1581,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 336080,
      "end_ms": 337320,
      "text": "有的翩翩起舞。",
      "token_start": 1585,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 337460,
      "end_ms": 340020,
      "text": "看到世界上绝无仅有的反弹琵琶。",
      "token_start": 1591,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 340200,
      "end_ms": 341740,
      "text": "看到西域传入的葡萄，",
      "token_start": 1605,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 341860,
      "end_ms": 343840,
      "text": "看到唐代盛行的胡炫舞，",
      "token_start": 1614,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 344060,
      "end_ms": 346840,
      "text": "看到西道当风的衣带究竟什么样？",
      "token_start": 1624,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 347260,
      "end_ms": 349580,
      "text": "最美的是四十五窟的两尊菩萨像，",
      "token_start": 1638,
      "token_end_exclusive": 1652
    },
    {
      "start_ms": 349740,
      "end_ms": 351380,
      "text": "他们都梳着高高的发髻，",
      "token_start": 1652,
      "token_end_exclusive": 1662
    },
    {
      "start_ms": 351720,
      "end_ms": 352700,
      "text": "眉公弯弯，",
      "token_start": 1662,
      "token_end_exclusive": 1666
    },
    {
      "start_ms": 352760,
      "end_ms": 353720,
      "text": "表情祥和，",
      "token_start": 1666,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 353760,
      "end_ms": 354740,
      "text": "庄重慈悲，",
      "token_start": 1670,
      "token_end_exclusive": 1674
    },
    {
      "start_ms": 354900,
      "end_ms": 356385,
      "text": "嘴角微微翘起。",
      "token_start": 1674,
      "token_end_exclusive": 1680
    },
    {
      "start_ms": 356780,
      "end_ms": 357540,
      "text": "而你知道吗？",
      "token_start": 1680,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 357640,
      "end_ms": 361075,
      "text": "敦煌壁画像竟然藏着中国人自己的十二星座，",
      "token_start": 1685,
      "token_end_exclusive": 1704
    },
    {
      "start_ms": 361380,
      "end_ms": 365455,
      "text": "这就是敦煌莫高窟第六十一窟涌道的世圣光佛土，",
      "token_start": 1704,
      "token_end_exclusive": 1725
    },
    {
      "start_ms": 365810,
      "end_ms": 369110,
      "text": "上面绘制有代表着黄道十二宫的圆形装饰，",
      "token_start": 1725,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 369250,
      "end_ms": 370730,
      "text": "每一宫做一圆圈，",
      "token_start": 1743,
      "token_end_exclusive": 1750
    },
    {
      "start_ms": 370910,
      "end_ms": 375630,
      "text": "分别是双鱼宫、白羊宫、金牛宫、天秤宫、巨蟹宫等等，",
      "token_start": 1750,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 375730,
      "end_ms": 378395,
      "text": "和现代的十二星座图案几乎一模一样。",
      "token_start": 1770,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 378730,
      "end_ms": 381355,
      "text": "原来咱老祖宗这么早就开始研究星座了，",
      "token_start": 1786,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 381670,
      "end_ms": 386335,
      "text": "这千年的壁画让冰冷的石头洞窟一下子就了活的人间气儿。",
      "token_start": 1803,
      "token_end_exclusive": 1828
    },
    {
      "start_ms": 386670,
      "end_ms": 387115,
      "text": "如今，",
      "token_start": 1828,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 387410,
      "end_ms": 392245,
      "text": "敦煌藏经洞的文书简直是严重被低估的中古百科全书，",
      "token_start": 1830,
      "token_end_exclusive": 1853
    },
    {
      "start_ms": 392620,
      "end_ms": 395260,
      "text": "这里有世界现存最古老的全天星图。",
      "token_start": 1853,
      "token_end_exclusive": 1868
    },
    {
      "start_ms": 395440,
      "end_ms": 398455,
      "text": "敦煌星图绘制着一千三百多颗恒星，",
      "token_start": 1868,
      "token_end_exclusive": 1883
    },
    {
      "start_ms": 398690,
      "end_ms": 400975,
      "text": "比西方最早的星徒早了三百多年，",
      "token_start": 1883,
      "token_end_exclusive": 1897
    },
    {
      "start_ms": 401230,
      "end_ms": 404145,
      "text": "而这藏经洞封存的也是普通人的一生啊。",
      "token_start": 1897,
      "token_end_exclusive": 1914
    },
    {
      "start_ms": 404380,
      "end_ms": 405365,
      "text": "除了佛家典籍，",
      "token_start": 1914,
      "token_end_exclusive": 1920
    },
    {
      "start_ms": 405620,
      "end_ms": 406100,
      "text": "藏经洞，",
      "token_start": 1920,
      "token_end_exclusive": 1923
    },
    {
      "start_ms": 406100,
      "end_ms": 410170,
      "text": "百分之九十的文书都是真实的社会档案有户籍地契，",
      "token_start": 1923,
      "token_end_exclusive": 1945
    },
    {
      "start_ms": 410390,
      "end_ms": 413135,
      "text": "还有账本、酒单、故工合同等等。",
      "token_start": 1945,
      "token_end_exclusive": 1957
    },
    {
      "start_ms": 413430,
      "end_ms": 415490,
      "text": "有记载了上千个中医药方，",
      "token_start": 1957,
      "token_end_exclusive": 1968
    },
    {
      "start_ms": 415650,
      "end_ms": 419710,
      "text": "包括内科、外科、妇科、美容方、减肥方、香椿方，",
      "token_start": 1968,
      "token_end_exclusive": 1985
    },
    {
      "start_ms": 419810,
      "end_ms": 421145,
      "text": "甚至还有求子方。",
      "token_start": 1985,
      "token_end_exclusive": 1992
    },
    {
      "start_ms": 421530,
      "end_ms": 422350,
      "text": "最神奇的是，",
      "token_start": 1992,
      "token_end_exclusive": 1997
    },
    {
      "start_ms": 422410,
      "end_ms": 425135,
      "text": "竟然还有唐代最温柔的离婚协议书。",
      "token_start": 1997,
      "token_end_exclusive": 2012
    },
    {
      "start_ms": 425420,
      "end_ms": 428040,
      "text": "放妻书写着一别两宽，",
      "token_start": 2012,
      "token_end_exclusive": 2021
    },
    {
      "start_ms": 428220,
      "end_ms": 429215,
      "text": "各生欢喜。",
      "token_start": 2021,
      "token_end_exclusive": 2025
    },
    {
      "start_ms": 429550,
      "end_ms": 430570,
      "text": "这可不是修妻，",
      "token_start": 2025,
      "token_end_exclusive": 2031
    },
    {
      "start_ms": 430710,
      "end_ms": 432925,
      "text": "而是夫妻双方和平解约。",
      "token_start": 2031,
      "token_end_exclusive": 2041
    },
    {
      "start_ms": 433240,
      "end_ms": 434400,
      "text": "海底是老祖宗啊，",
      "token_start": 2041,
      "token_end_exclusive": 2048
    },
    {
      "start_ms": 434440,
      "end_ms": 435540,
      "text": "没有谩骂指责，",
      "token_start": 2048,
      "token_end_exclusive": 2054
    },
    {
      "start_ms": 435540,
      "end_ms": 436965,
      "text": "也没有撕破脸皮，",
      "token_start": 2054,
      "token_end_exclusive": 2061
    },
    {
      "start_ms": 437320,
      "end_ms": 440920,
      "text": "男方甚至还会一次性付清三年的医疗费用，",
      "token_start": 2061,
      "token_end_exclusive": 2079
    },
    {
      "start_ms": 441000,
      "end_ms": 442400,
      "text": "作为女方的生活补偿，",
      "token_start": 2079,
      "token_end_exclusive": 2088
    },
    {
      "start_ms": 442580,
      "end_ms": 445085,
      "text": "这就是唐代好聚好散的样本，",
      "token_start": 2088,
      "token_end_exclusive": 2100
    },
    {
      "start_ms": 445410,
      "end_ms": 447110,
      "text": "这就是敦煌最伟大的地方。",
      "token_start": 2100,
      "token_end_exclusive": 2111
    },
    {
      "start_ms": 447250,
      "end_ms": 449490,
      "text": "他记录了不仅是帝王将相的家谱，",
      "token_start": 2111,
      "token_end_exclusive": 2125
    },
    {
      "start_ms": 449650,
      "end_ms": 451925,
      "text": "更是普通人的喜怒哀乐。",
      "token_start": 2125,
      "token_end_exclusive": 2135
    },
    {
      "start_ms": 452590,
      "end_ms": 453035,
      "text": "如今，",
      "token_start": 2135,
      "token_end_exclusive": 2137
    },
    {
      "start_ms": 453340,
      "end_ms": 454900,
      "text": "如果你来到敦煌市的上空，",
      "token_start": 2137,
      "token_end_exclusive": 2148
    },
    {
      "start_ms": 455040,
      "end_ms": 458810,
      "text": "可以清晰的看到在茫茫沙漠戈壁中的一大片绿洲，",
      "token_start": 2148,
      "token_end_exclusive": 2169
    },
    {
      "start_ms": 458910,
      "end_ms": 461095,
      "text": "而敦煌就在这片绿洲中。",
      "token_start": 2169,
      "token_end_exclusive": 2179
    },
    {
      "start_ms": 461410,
      "end_ms": 462515,
      "text": "在敦煌式的背后，",
      "token_start": 2179,
      "token_end_exclusive": 2186
    },
    {
      "start_ms": 462830,
      "end_ms": 464610,
      "text": "祁连山二金山在此交汇，",
      "token_start": 2186,
      "token_end_exclusive": 2196
    },
    {
      "start_ms": 464790,
      "end_ms": 466110,
      "text": "发源于祁连山腹地。",
      "token_start": 2196,
      "token_end_exclusive": 2204
    },
    {
      "start_ms": 466110,
      "end_ms": 469850,
      "text": "青藏高原上的党河从两山之间穿流而过，",
      "token_start": 2204,
      "token_end_exclusive": 2221
    },
    {
      "start_ms": 470030,
      "end_ms": 472470,
      "text": "绕过鸣沙山流入敦煌绿洲，",
      "token_start": 2221,
      "token_end_exclusive": 2232
    },
    {
      "start_ms": 472630,
      "end_ms": 474145,
      "text": "滋养了这里上千年。",
      "token_start": 2232,
      "token_end_exclusive": 2240
    },
    {
      "start_ms": 474730,
      "end_ms": 475365,
      "text": "你知道吗？",
      "token_start": 2240,
      "token_end_exclusive": 2244
    },
    {
      "start_ms": 475630,
      "end_ms": 477255,
      "text": "原来敦煌还能撑多久，",
      "token_start": 2244,
      "token_end_exclusive": 2253
    },
    {
      "start_ms": 477510,
      "end_ms": 479735,
      "text": "答案就藏在祁连山的雪里。",
      "token_start": 2253,
      "token_end_exclusive": 2264
    },
    {
      "start_ms": 480110,
      "end_ms": 481890,
      "text": "一旦祁连山降雪减少，",
      "token_start": 2264,
      "token_end_exclusive": 2273
    },
    {
      "start_ms": 482030,
      "end_ms": 483550,
      "text": "或者河流改道断流，",
      "token_start": 2273,
      "token_end_exclusive": 2281
    },
    {
      "start_ms": 483710,
      "end_ms": 486015,
      "text": "敦煌就会迅速被沙漠吞没。",
      "token_start": 2281,
      "token_end_exclusive": 2292
    },
    {
      "start_ms": 486370,
      "end_ms": 488830,
      "text": "历史上曾经繁华一时的楼兰古城，",
      "token_start": 2292,
      "token_end_exclusive": 2306
    },
    {
      "start_ms": 489070,
      "end_ms": 490370,
      "text": "正是因为水源消失，",
      "token_start": 2306,
      "token_end_exclusive": 2314
    },
    {
      "start_ms": 490390,
      "end_ms": 492295,
      "text": "一夜之间被风沙掩埋。",
      "token_start": 2314,
      "token_end_exclusive": 2323
    },
    {
      "start_ms": 492580,
      "end_ms": 496095,
      "text": "而敦煌和楼兰的地理结构几乎一模一样，",
      "token_start": 2323,
      "token_end_exclusive": 2340
    },
    {
      "start_ms": 496430,
      "end_ms": 497970,
      "text": "同样依赖内陆河，",
      "token_start": 2340,
      "token_end_exclusive": 2347
    },
    {
      "start_ms": 498130,
      "end_ms": 499570,
      "text": "同样守在沙漠边缘。",
      "token_start": 2347,
      "token_end_exclusive": 2355
    },
    {
      "start_ms": 499750,
      "end_ms": 502135,
      "text": "同样没有稳定的外部水源补给，",
      "token_start": 2355,
      "token_end_exclusive": 2368
    },
    {
      "start_ms": 502400,
      "end_ms": 504815,
      "text": "唯一的区别是敦煌还没有断水。",
      "token_start": 2368,
      "token_end_exclusive": 2381
    },
    {
      "start_ms": 505150,
      "end_ms": 505865,
      "text": "但在今天，",
      "token_start": 2381,
      "token_end_exclusive": 2385
    },
    {
      "start_ms": 506120,
      "end_ms": 508240,
      "text": "随着气候变化和人类用水增加，",
      "token_start": 2385,
      "token_end_exclusive": 2398
    },
    {
      "start_ms": 508400,
      "end_ms": 510895,
      "text": "敦煌的水资源正在变得越来越紧张。",
      "token_start": 2398,
      "token_end_exclusive": 2413
    },
    {
      "start_ms": 511300,
      "end_ms": 512000,
      "text": "如果有一天，",
      "token_start": 2413,
      "token_end_exclusive": 2418
    },
    {
      "start_ms": 512180,
      "end_ms": 513605,
      "text": "河流真的撑不住了，",
      "token_start": 2418,
      "token_end_exclusive": 2426
    },
    {
      "start_ms": 513830,
      "end_ms": 514070,
      "text": "那么，",
      "token_start": 2426,
      "token_end_exclusive": 2428
    },
    {
      "start_ms": 514070,
      "end_ms": 516110,
      "text": "敦煌的命运会不会重演？",
      "token_start": 2428,
      "token_end_exclusive": 2438
    },
    {
      "start_ms": 516190,
      "end_ms": 518180,
      "text": "楼兰的结局你知道吗？",
      "token_start": 2438,
      "token_end_exclusive": 2447
    },
    {
      "start_ms": 518280,
      "end_ms": 520880,
      "text": "敦煌是我见过的最珍视游客的城市，",
      "token_start": 2447,
      "token_end_exclusive": 2462
    },
    {
      "start_ms": 520960,
      "end_ms": 522600,
      "text": "没有之一市容市吗？",
      "token_start": 2462,
      "token_end_exclusive": 2470
    },
    {
      "start_ms": 522600,
      "end_ms": 524400,
      "text": "竟然比很多一线城市还要好。",
      "token_start": 2470,
      "token_end_exclusive": 2482
    },
    {
      "start_ms": 524750,
      "end_ms": 526630,
      "text": "这里没有国内旅游城市的弊病，",
      "token_start": 2482,
      "token_end_exclusive": 2495
    },
    {
      "start_ms": 526770,
      "end_ms": 533975,
      "text": "比如脏乱差的街道、高频次的摆摊、叫卖、旅拍、拉人、出租车、套路、横冲直撞的汽车、电动车等等。",
      "token_start": 2495,
      "token_end_exclusive": 2532
    },
    {
      "start_ms": 534320,
      "end_ms": 535720,
      "text": "敦煌打车起步价，",
      "token_start": 2532,
      "token_end_exclusive": 2539
    },
    {
      "start_ms": 535720,
      "end_ms": 536425,
      "text": "只要六块钱，",
      "token_start": 2539,
      "token_end_exclusive": 2544
    },
    {
      "start_ms": 536710,
      "end_ms": 538070,
      "text": "从鸣沙山到夜市，",
      "token_start": 2544,
      "token_end_exclusive": 2551
    },
    {
      "start_ms": 538210,
      "end_ms": 540450,
      "text": "还有一辆接着一辆的免费接驳车。",
      "token_start": 2551,
      "token_end_exclusive": 2565
    },
    {
      "start_ms": 540770,
      "end_ms": 544170,
      "text": "这里的夜市可没有千篇一律的景区大鱿鱼臭豆腐，",
      "token_start": 2565,
      "token_end_exclusive": 2586
    },
    {
      "start_ms": 544330,
      "end_ms": 546450,
      "text": "全是地地道道的西北风味，",
      "token_start": 2586,
      "token_end_exclusive": 2597
    },
    {
      "start_ms": 546630,
      "end_ms": 547470,
      "text": "价格公道，",
      "token_start": 2597,
      "token_end_exclusive": 2601
    },
    {
      "start_ms": 547550,
      "end_ms": 548910,
      "text": "出品干净稳定。",
      "token_start": 2601,
      "token_end_exclusive": 2607
    },
    {
      "start_ms": 549270,
      "end_ms": 550350,
      "text": "甚至你能想象吗？",
      "token_start": 2607,
      "token_end_exclusive": 2614
    },
    {
      "start_ms": 550530,
      "end_ms": 552150,
      "text": "夜晚十二点的敦煌店，",
      "token_start": 2614,
      "token_end_exclusive": 2623
    },
    {
      "start_ms": 552150,
      "end_ms": 553290,
      "text": "还有理发店开门，",
      "token_start": 2623,
      "token_end_exclusive": 2630
    },
    {
      "start_ms": 553630,
      "end_ms": 556290,
      "text": "因为晚上很多从沙漠上下来的旅客，",
      "token_start": 2630,
      "token_end_exclusive": 2645
    },
    {
      "start_ms": 556510,
      "end_ms": 557430,
      "text": "一头沙子，",
      "token_start": 2645,
      "token_end_exclusive": 2649
    },
    {
      "start_ms": 557490,
      "end_ms": 559170,
      "text": "或者有妆发都比较难洗。",
      "token_start": 2649,
      "token_end_exclusive": 2659
    },
    {
      "start_ms": 559430,
      "end_ms": 560970,
      "text": "一天下来也比较累了，",
      "token_start": 2659,
      "token_end_exclusive": 2668
    },
    {
      "start_ms": 560970,
      "end_ms": 562470,
      "text": "自己洗又很麻烦，",
      "token_start": 2668,
      "token_end_exclusive": 2675
    },
    {
      "start_ms": 562470,
      "end_ms": 564750,
      "text": "所以他们开到晚上一点半左右，",
      "token_start": 2675,
      "token_end_exclusive": 2688
    },
    {
      "start_ms": 565070,
      "end_ms": 567120,
      "text": "真的是处处为游客着想，",
      "token_start": 2688,
      "token_end_exclusive": 2698
    },
    {
      "start_ms": 567300,
      "end_ms": 569860,
      "text": "吃住行都能给你安排的妥妥当当。",
      "token_start": 2698,
      "token_end_exclusive": 2712
    },
    {
      "start_ms": 570160,
      "end_ms": 571120,
      "text": "而且你知道吗？",
      "token_start": 2712,
      "token_end_exclusive": 2718
    },
    {
      "start_ms": 571240,
      "end_ms": 573560,
      "text": "月牙泉景区内竟然还有红绿灯，",
      "token_start": 2718,
      "token_end_exclusive": 2731
    },
    {
      "start_ms": 573860,
      "end_ms": 575780,
      "text": "第一次见到沙漠里的红绿灯，",
      "token_start": 2731,
      "token_end_exclusive": 2743
    },
    {
      "start_ms": 575980,
      "end_ms": 577340,
      "text": "你是不是会觉得很奇怪？",
      "token_start": 2743,
      "token_end_exclusive": 2753
    },
    {
      "start_ms": 577520,
      "end_ms": 581460,
      "text": "其实这红绿灯专门是给骆驼队修建的分流人和骆驼。",
      "token_start": 2753,
      "token_end_exclusive": 2775
    },
    {
      "start_ms": 581740,
      "end_ms": 582920,
      "text": "绿灯亮的时候呢，",
      "token_start": 2775,
      "token_end_exclusive": 2782
    },
    {
      "start_ms": 582920,
      "end_ms": 584200,
      "text": "骆驼就会自己行走，",
      "token_start": 2782,
      "token_end_exclusive": 2790
    },
    {
      "start_ms": 584280,
      "end_ms": 584920,
      "text": "红灯亮，",
      "token_start": 2790,
      "token_end_exclusive": 2793
    },
    {
      "start_ms": 584960,
      "end_ms": 587560,
      "text": "骆驼就会停到了旅游旺季的时候，",
      "token_start": 2793,
      "token_end_exclusive": 2807
    },
    {
      "start_ms": 587580,
      "end_ms": 589895,
      "text": "这里面还会出现堵骆驼的情况。",
      "token_start": 2807,
      "token_end_exclusive": 2820
    },
    {
      "start_ms": 590470,
      "end_ms": 591330,
      "text": "你能想象吗？",
      "token_start": 2820,
      "token_end_exclusive": 2825
    },
    {
      "start_ms": 591330,
      "end_ms": 593430,
      "text": "眼前这些柳树叫左公柳，",
      "token_start": 2825,
      "token_end_exclusive": 2835
    },
    {
      "start_ms": 593670,
      "end_ms": 598230,
      "text": "当年左宗棠下令从陕西到新疆的沿途广种柳树杨树，",
      "token_start": 2835,
      "token_end_exclusive": 2857
    },
    {
      "start_ms": 598550,
      "end_ms": 600850,
      "text": "至今在敦煌鸣沙山月牙泉畔，",
      "token_start": 2857,
      "token_end_exclusive": 2869
    },
    {
      "start_ms": 601070,
      "end_ms": 602610,
      "text": "仍存有他所植树林，",
      "token_start": 2869,
      "token_end_exclusive": 2877
    },
    {
      "start_ms": 602610,
      "end_ms": 605050,
      "text": "超过一百四十年的月泉古柳。",
      "token_start": 2877,
      "token_end_exclusive": 2889
    },
    {
      "start_ms": 605230,
      "end_ms": 606070,
      "text": "而你知道吗？",
      "token_start": 2889,
      "token_end_exclusive": 2894
    },
    {
      "start_ms": 606090,
      "end_ms": 610190,
      "text": "在敦煌找不到任何一根还在冒烟的火电厂烟囱，",
      "token_start": 2894,
      "token_end_exclusive": 2914
    },
    {
      "start_ms": 610510,
      "end_ms": 612590,
      "text": "中国人在敦煌造了一个太阳。",
      "token_start": 2914,
      "token_end_exclusive": 2926
    },
    {
      "start_ms": 613030,
      "end_ms": 614430,
      "text": "你在深夜熟睡时，",
      "token_start": 2926,
      "token_end_exclusive": 2933
    },
    {
      "start_ms": 614510,
      "end_ms": 617250,
      "text": "中国西北的荒漠正在挂着一颗人造太阳。",
      "token_start": 2933,
      "token_end_exclusive": 2950
    },
    {
      "start_ms": 617470,
      "end_ms": 619050,
      "text": "它不是科幻电影的道具，",
      "token_start": 2950,
      "token_end_exclusive": 2960
    },
    {
      "start_ms": 619190,
      "end_ms": 621940,
      "text": "而是一座真实月进行了超级电站。",
      "token_start": 2960,
      "token_end_exclusive": 2974
    },
    {
      "start_ms": 621940,
      "end_ms": 626320,
      "text": "敦煌已经成了全中国唯一一个百分之百绿电覆盖的城市。",
      "token_start": 2974,
      "token_end_exclusive": 2998
    },
    {
      "start_ms": 626600,
      "end_ms": 629740,
      "text": "而敦煌自己发的这些电跨越几千公里，",
      "token_start": 2998,
      "token_end_exclusive": 3014
    },
    {
      "start_ms": 629800,
      "end_ms": 630700,
      "text": "冲向湖南，",
      "token_start": 3014,
      "token_end_exclusive": 3018
    },
    {
      "start_ms": 630860,
      "end_ms": 632600,
      "text": "点亮上海的摩天大楼，",
      "token_start": 3018,
      "token_end_exclusive": 3027
    },
    {
      "start_ms": 632820,
      "end_ms": 636080,
      "text": "成为你手机屏幕上跳动的那个绿色电能，",
      "token_start": 3027,
      "token_end_exclusive": 3044
    },
    {
      "start_ms": 636280,
      "end_ms": 638000,
      "text": "这就是文明的浪漫。",
      "token_start": 3044,
      "token_end_exclusive": 3052
    },
    {
      "start_ms": 638460,
      "end_ms": 641760,
      "text": "如今我们今天花几个小时就能抵达的敦煌，",
      "token_start": 3052,
      "token_end_exclusive": 3070
    },
    {
      "start_ms": 641940,
      "end_ms": 644500,
      "text": "是古人用半生才能抵达的远方。",
      "token_start": 3070,
      "token_end_exclusive": 3083
    },
    {
      "start_ms": 644840,
      "end_ms": 646780,
      "text": "这里有王道士的无声叹息，",
      "token_start": 3083,
      "token_end_exclusive": 3094
    },
    {
      "start_ms": 647020,
      "end_ms": 649775,
      "text": "有常春红樊景师们的终身守护，",
      "token_start": 3094,
      "token_end_exclusive": 3107
    },
    {
      "start_ms": 650140,
      "end_ms": 652185,
      "text": "有春风不度玉门关的苍凉，",
      "token_start": 3107,
      "token_end_exclusive": 3118
    },
    {
      "start_ms": 652410,
      "end_ms": 654785,
      "text": "也有西出阳关无故人的怅然。",
      "token_start": 3118,
      "token_end_exclusive": 3130
    },
    {
      "start_ms": 655220,
      "end_ms": 657240,
      "text": "霍去病的马蹄声逐渐远去，",
      "token_start": 3130,
      "token_end_exclusive": 3141
    },
    {
      "start_ms": 657500,
      "end_ms": 659835,
      "text": "左宫柳还在月牙泉边摇曳，",
      "token_start": 3141,
      "token_end_exclusive": 3152
    },
    {
      "start_ms": 660190,
      "end_ms": 661235,
      "text": "我们终会老去，",
      "token_start": 3152,
      "token_end_exclusive": 3158
    },
    {
      "start_ms": 661510,
      "end_ms": 663755,
      "text": "但文明不能在我手里老去。",
      "token_start": 3158,
      "token_end_exclusive": 3169
    },
    {
      "start_ms": 664190,
      "end_ms": 668010,
      "text": "祖先们把一千年前的敦煌交给了我们我们，",
      "token_start": 3169,
      "token_end_exclusive": 3187
    },
    {
      "start_ms": 668010,
      "end_ms": 671405,
      "text": "又将把一个怎样敦煌交给下一个一千年。",
      "token_start": 3187,
      "token_end_exclusive": 3204
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
    "timestamps_in_range": true,
    "timestamp_starts_monotonic": true,
