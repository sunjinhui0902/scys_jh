{
  "video_id": "v_7967c21e0878bcb8",
  "duration_s": 394.970998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_7967c21e0878bcb8.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_7967c21e0878bcb8.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2490,
      "text": "一九七四年二月六日深夜，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3070,
      "end_ms": 8590,
      "text": "北京医院里一位八十四岁的老人已经虚弱的说不出话来，",
      "token_start": 11,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 9430,
      "end_ms": 13450,
      "text": "他颤抖着用手指在床头柜上比划，",
      "token_start": 35,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 13850,
      "end_ms": 15530,
      "text": "护士赶紧递上纸笔，",
      "token_start": 49,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 15950,
      "end_ms": 19370,
      "text": "老人用尽最后一丝力气歪歪扭扭，",
      "token_start": 57,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 19370,
      "end_ms": 20390,
      "text": "写下一行字。",
      "token_start": 71,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 20950,
      "end_ms": 23130,
      "text": "今天最高气温零下一度，",
      "token_start": 76,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 23470,
      "end_ms": 25170,
      "text": "最低气温零下七度，",
      "token_start": 86,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 25510,
      "end_ms": 26910,
      "text": "东风一至二级。",
      "token_start": 94,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 27390,
      "end_ms": 28410,
      "text": "晴转多云。",
      "token_start": 100,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 28810,
      "end_ms": 29310,
      "text": "写完，",
      "token_start": 104,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 29530,
      "end_ms": 31720,
      "text": "他放下往下笔闭上了眼睛。",
      "token_start": 106,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 32160,
      "end_ms": 32800,
      "text": "第二天，",
      "token_start": 117,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 33060,
      "end_ms": 33760,
      "text": "他走了，",
      "token_start": 120,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 34180,
      "end_ms": 37640,
      "text": "这是他留在人间的最后一行天气记录。",
      "token_start": 123,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 37760,
      "end_ms": 38960,
      "text": "而这样的记录，",
      "token_start": 139,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 39200,
      "end_ms": 41540,
      "text": "他整整写了三十八年，",
      "token_start": 145,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 42060,
      "end_ms": 44060,
      "text": "将近一万四千多天，",
      "token_start": 154,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 44900,
      "end_ms": 46260,
      "text": "一天都没断过。",
      "token_start": 162,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 47040,
      "end_ms": 48000,
      "text": "他叫朱可臻，",
      "token_start": 168,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 48400,
      "end_ms": 50880,
      "text": "中国近代气象学的奠基人。",
      "token_start": 173,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 52080,
      "end_ms": 57160,
      "text": "可今天十个人里能有一个说出他名字的就不错了。",
      "token_start": 184,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 58000,
      "end_ms": 60645,
      "text": "故事得从他十六岁那年说起。",
      "token_start": 205,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 61170,
      "end_ms": 61750,
      "text": "那一年，",
      "token_start": 217,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 61990,
      "end_ms": 63785,
      "text": "朱可臻在上海念书，",
      "token_start": 220,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 64220,
      "end_ms": 66625,
      "text": "有人当着他的面嘲笑中国人，",
      "token_start": 228,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 66980,
      "end_ms": 68500,
      "text": "你们连自己的风雨都测，",
      "token_start": 240,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 68500,
      "end_ms": 70675,
      "text": "不准拿什么跟洋人比？",
      "token_start": 250,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 70920,
      "end_ms": 74225,
      "text": "这句话像根刺扎进了少年心里。",
      "token_start": 259,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 74450,
      "end_ms": 76105,
      "text": "那时候的中国是什么样子？",
      "token_start": 272,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 76570,
      "end_ms": 77670,
      "text": "偌大一个国家，",
      "token_start": 283,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 77850,
      "end_ms": 81045,
      "text": "连一张自己的天气图都画不出来，",
      "token_start": 289,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 81720,
      "end_ms": 84415,
      "text": "东北的气象掌握在日本人手里，",
      "token_start": 303,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 84860,
      "end_ms": 88715,
      "text": "上海、香港的观测点被洋人把持着，",
      "token_start": 316,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 89110,
      "end_ms": 92165,
      "text": "连台风来了都得等别国通报。",
      "token_start": 330,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 92590,
      "end_ms": 94430,
      "text": "一个国家的气象命脉，",
      "token_start": 342,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 94630,
      "end_ms": 95905,
      "text": "攥在别人手里。",
      "token_start": 351,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 96580,
      "end_ms": 99925,
      "text": "那跟把家门钥匙交给外人有什么区别？",
      "token_start": 357,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 100440,
      "end_ms": 101565,
      "text": "二十岁那年，",
      "token_start": 373,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 102120,
      "end_ms": 104560,
      "text": "朱可臻考取公费留学后，",
      "token_start": 378,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 104920,
      "end_ms": 108685,
      "text": "进入了哈佛大学别的学生选热门专业，",
      "token_start": 388,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 109020,
      "end_ms": 114785,
      "text": "他偏偏选了气象学一个当时全中国几乎没人听说过的东西。",
      "token_start": 404,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 115720,
      "end_ms": 116420,
      "text": "同学问他，",
      "token_start": 429,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 116420,
      "end_ms": 116915,
      "text": "为啥，",
      "token_start": 433,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 117760,
      "end_ms": 118945,
      "text": "他只说了一句，",
      "token_start": 435,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 119400,
      "end_ms": 123485,
      "text": "中国的天空不能永远让别人管着。",
      "token_start": 441,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 125440,
      "end_ms": 128250,
      "text": "一九一八年博士学位刚拿到手，",
      "token_start": 455,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 128430,
      "end_ms": 129790,
      "text": "他一天都没多待，",
      "token_start": 468,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 130010,
      "end_ms": 131295,
      "text": "转头就回了国。",
      "token_start": 475,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 131890,
      "end_ms": 132670,
      "text": "可下了船，",
      "token_start": 481,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 132930,
      "end_ms": 133795,
      "text": "他愣住了，",
      "token_start": 485,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 134120,
      "end_ms": 135180,
      "text": "泱泱大国，",
      "token_start": 489,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 135600,
      "end_ms": 139715,
      "text": "四万万同胞居然没有一座自己的气象台。",
      "token_start": 493,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 140290,
      "end_ms": 143050,
      "text": "外国人在中国的土地上架着仪器，",
      "token_start": 510,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 143350,
      "end_ms": 145920,
      "text": "测着中国的风云数据。",
      "token_start": 524,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 145920,
      "end_ms": 147340,
      "text": "锁在人家保险柜里，",
      "token_start": 533,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 147340,
      "end_ms": 148460,
      "text": "中国人想看一眼，",
      "token_start": 541,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 148460,
      "end_ms": 149200,
      "text": "还得低头去。",
      "token_start": 548,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 149200,
      "end_ms": 151495,
      "text": "要从那一天起，",
      "token_start": 553,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 152200,
      "end_ms": 154425,
      "text": "朱可珍口袋里多了一只温度计。",
      "token_start": 559,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 155400,
      "end_ms": 156625,
      "text": "他走到哪儿寄到哪儿，",
      "token_start": 572,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 157640,
      "end_ms": 161985,
      "text": "候车室船上防空洞里，",
      "token_start": 581,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 162470,
      "end_ms": 163955,
      "text": "别人聊天说话。",
      "token_start": 590,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 164340,
      "end_ms": 166165,
      "text": "他掏出小本子写两笔，",
      "token_start": 596,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 167000,
      "end_ms": 169095,
      "text": "朋友都觉得这人魔怔啊，",
      "token_start": 605,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 169980,
      "end_ms": 171625,
      "text": "可就是这个魔怔的人。",
      "token_start": 615,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 172010,
      "end_ms": 177705,
      "text": "在南京高等师范学校一首建起了中国第一个气象学系。",
      "token_start": 624,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 178300,
      "end_ms": 180335,
      "text": "先给咱们自己培养人才。",
      "token_start": 647,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 181210,
      "end_ms": 184435,
      "text": "从一九二零年到一九三零年，",
      "token_start": 657,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 184750,
      "end_ms": 185770,
      "text": "整整十年，",
      "token_start": 669,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 185850,
      "end_ms": 187465,
      "text": "他带着人翻山越岭，",
      "token_start": 673,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 188080,
      "end_ms": 189895,
      "text": "从拉萨到峨眉山，",
      "token_start": 681,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 190160,
      "end_ms": 191800,
      "text": "从泰山到内陆，",
      "token_start": 688,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 191800,
      "end_ms": 194235,
      "text": "平原风餐露宿，",
      "token_start": 694,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 194620,
      "end_ms": 201185,
      "text": "一步一个脚印建起了四十多个气象站一百多个雨量观测点。",
      "token_start": 700,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 201820,
      "end_ms": 202800,
      "text": "一九二八年，",
      "token_start": 725,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 202940,
      "end_ms": 209664,
      "text": "他在南京北极阁建起了中国第一个由中国人自己掌管的气象研究所。",
      "token_start": 730,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 210610,
      "end_ms": 212225,
      "text": "一九三零年的元旦，",
      "token_start": 759,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 213310,
      "end_ms": 214535,
      "text": "天刚蒙蒙亮，",
      "token_start": 767,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 215390,
      "end_ms": 217245,
      "text": "朱可贞站在电报机前，",
      "token_start": 772,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 217720,
      "end_ms": 219000,
      "text": "手里攥着一沓，",
      "token_start": 781,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 219000,
      "end_ms": 221735,
      "text": "刚从全国各地传回的数据，",
      "token_start": 787,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 222210,
      "end_ms": 223430,
      "text": "他深吸一口气，",
      "token_start": 798,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 223510,
      "end_ms": 225305,
      "text": "在预报单上写下六个字，",
      "token_start": 804,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 225650,
      "end_ms": 228600,
      "text": "全国天气预报这六个字，",
      "token_start": 814,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 228840,
      "end_ms": 230385,
      "text": "中国人等了几十年。",
      "token_start": 824,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 231220,
      "end_ms": 232265,
      "text": "从这一天起，",
      "token_start": 832,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 232830,
      "end_ms": 237465,
      "text": "我们的阴晴雨雪终于不再有洋人说了算。",
      "token_start": 837,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 237920,
      "end_ms": 239135,
      "text": "你以为这就完了？",
      "token_start": 854,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 240660,
      "end_ms": 242320,
      "text": "没有没过几年，",
      "token_start": 861,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 242560,
      "end_ms": 243460,
      "text": "抗战爆发，",
      "token_start": 867,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 243700,
      "end_ms": 246160,
      "text": "南京告急研究所要撤退，",
      "token_start": 871,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 246960,
      "end_ms": 250280,
      "text": "别人收拾金银细软朱可珍呢。",
      "token_start": 881,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 250400,
      "end_ms": 256440,
      "text": "他把二十七箱气象仪器打包装箱温度仪湿度计，",
      "token_start": 893,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 256620,
      "end_ms": 259860,
      "text": "气压表一件都不能丢人。",
      "token_start": 913,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 259860,
      "end_ms": 260640,
      "text": "对学生们说，",
      "token_start": 923,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 260780,
      "end_ms": 264740,
      "text": "这些仪器就是我们手里的枪人。",
      "token_start": 928,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 264760,
      "end_ms": 268120,
      "text": "在仪器在一九三七年冬天，",
      "token_start": 941,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 268320,
      "end_ms": 269825,
      "text": "他们撤到武汉。",
      "token_start": 952,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 270450,
      "end_ms": 272510,
      "text": "日本的飞机在头顶盘旋，",
      "token_start": 958,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 272910,
      "end_ms": 274970,
      "text": "炸弹就在几百米外炸开，",
      "token_start": 968,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 275470,
      "end_ms": 277310,
      "text": "整座城都在摇晃，",
      "token_start": 978,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 277870,
      "end_ms": 281130,
      "text": "可朱可臻蹲在简陋的临时气象站里，",
      "token_start": 985,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 281610,
      "end_ms": 283170,
      "text": "一手扶着温度计，",
      "token_start": 1000,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 283410,
      "end_ms": 285270,
      "text": "一手在本子上记数据。",
      "token_start": 1007,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 285790,
      "end_ms": 286930,
      "text": "有人冲着他喊，",
      "token_start": 1016,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 287410,
      "end_ms": 289270,
      "text": "朱先生快跑啊，",
      "token_start": 1022,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 290490,
      "end_ms": 291430,
      "text": "他头也不抬。",
      "token_start": 1028,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 291610,
      "end_ms": 292210,
      "text": "再等等，",
      "token_start": 1033,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 293430,
      "end_ms": 295490,
      "text": "这个时间点的数据不能断。",
      "token_start": 1036,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 295950,
      "end_ms": 297410,
      "text": "就是在那样的日子里，",
      "token_start": 1047,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 297410,
      "end_ms": 300315,
      "text": "中国气象人的研究一天都没有停。",
      "token_start": 1056,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 300400,
      "end_ms": 300655,
      "text": "哎，",
      "token_start": 1070,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 301300,
      "end_ms": 302640,
      "text": "炮火连天中，",
      "token_start": 1071,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 302900,
      "end_ms": 306845,
      "text": "他们还在分析梅与规律研究季风走向。",
      "token_start": 1076,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 307510,
      "end_ms": 310490,
      "text": "这些数据后来被盟军用于飞行作战，",
      "token_start": 1092,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 311030,
      "end_ms": 312590,
      "text": "救了不知多少人的命。",
      "token_start": 1107,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 313190,
      "end_ms": 314370,
      "text": "抗战胜利后，",
      "token_start": 1116,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 314690,
      "end_ms": 320310,
      "text": "朱可臻带着完好无损的二十七箱仪器回到南京。",
      "token_start": 1121,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 321150,
      "end_ms": 322810,
      "text": "有人问他是怎么做到的？",
      "token_start": 1141,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 322930,
      "end_ms": 323770,
      "text": "他笑着说，",
      "token_start": 1151,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 324350,
      "end_ms": 327270,
      "text": "我是用命换故事，",
      "token_start": 1155,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 327270,
      "end_ms": 328090,
      "text": "讲到这儿，",
      "token_start": 1162,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 328450,
      "end_ms": 332870,
      "text": "你可能以为朱可臻就是个搞气象的错了。",
      "token_start": 1166,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 333470,
      "end_ms": 334910,
      "text": "他不光搞气象，",
      "token_start": 1183,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 335110,
      "end_ms": 336915,
      "text": "是一把好手办教育，",
      "token_start": 1189,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 337180,
      "end_ms": 339360,
      "text": "他也是民国四大校长之一。",
      "token_start": 1197,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 339820,
      "end_ms": 340980,
      "text": "一九三六年，",
      "token_start": 1208,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 341000,
      "end_ms": 342780,
      "text": "他接掌浙大的时候，",
      "token_start": 1213,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 343160,
      "end_ms": 344800,
      "text": "学校经费紧缺，",
      "token_start": 1221,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 345299,
      "end_ms": 346420,
      "text": "人心涣散。",
      "token_start": 1227,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 347020,
      "end_ms": 348880,
      "text": "校长换了一茬又一茬，",
      "token_start": 1231,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 349360,
      "end_ms": 351080,
      "text": "他上任之后干了什么？",
      "token_start": 1240,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 351500,
      "end_ms": 352640,
      "text": "在逃难路上，",
      "token_start": 1249,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 353080,
      "end_ms": 354320,
      "text": "他失去了儿子，",
      "token_start": 1254,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 354460,
      "end_ms": 355760,
      "text": "又失去了妻子，",
      "token_start": 1260,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 356140,
      "end_ms": 359460,
      "text": "却把一所烂校办成了中国顶尖。",
      "token_start": 1266,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 360420,
      "end_ms": 362220,
      "text": "他到底是怎么做到的？",
      "token_start": 1279,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 362280,
      "end_ms": 363140,
      "text": "下集告诉你，",
      "token_start": 1288,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 363140,
      "end_ms": 366925,
      "text": "看到这儿先别划走，",
      "token_start": 1293,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 368090,
      "end_ms": 368735,
      "text": "点个赞，",
      "token_start": 1301,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 369660,
      "end_ms": 373384,
      "text": "是对这位看了一辈子天的老人的敬意。",
      "token_start": 1304,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 373800,
      "end_ms": 374940,
      "text": "收藏起来讲，",
      "token_start": 1320,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 374960,
      "end_ms": 376055,
      "text": "给你的孩子听，",
      "token_start": 1325,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 376460,
      "end_ms": 379015,
      "text": "你今天打开手机能看天气预报，",
      "token_start": 1331,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 379380,
      "end_ms": 380905,
      "text": "是有人拿命换来的，",
      "token_start": 1344,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 381400,
      "end_ms": 382835,
      "text": "转发给更多人，",
      "token_start": 1352,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 383340,
      "end_ms": 386385,
      "text": "让朱可贞这个名字被更多人记住。",
      "token_start": 1358,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 387010,
      "end_ms": 387655,
      "text": "关注我，",
      "token_start": 1372,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 388010,
      "end_ms": 388865,
      "text": "夏季更狠，",
      "token_start": 1375,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 389510,
      "end_ms": 390310,
      "text": "儿子死了，",
      "token_start": 1379,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 390310,
      "end_ms": 391215,
      "text": "妻子死了，",
      "token_start": 1383,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 391480,
      "end_ms": 394875,
      "text": "他带着学校走了两千六百多公里。",
      "token_start": 1387,
      "token_end_exclusive": 1401
    }
  ],
