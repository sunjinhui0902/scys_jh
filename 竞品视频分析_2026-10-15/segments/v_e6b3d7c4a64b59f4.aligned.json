{
  "video_id": "v_e6b3d7c4a64b59f4",
  "duration_s": 547.805011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_e6b3d7c4a64b59f4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_e6b3d7c4a64b59f4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 620,
      "end_ms": 2400,
      "text": "明天李总那边有个项目要谈，",
      "token_start": 0,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 2400,
      "end_ms": 4300,
      "text": "你俩跟我一起去什么项目啊？",
      "token_start": 12,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 4300,
      "end_ms": 4680,
      "text": "王姐，",
      "token_start": 24,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6440,
      "end_ms": 9820,
      "text": "一千万这么大，",
      "token_start": 26,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 10040,
      "end_ms": 11620,
      "text": "这个项目李总很重视，",
      "token_start": 32,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 11940,
      "end_ms": 13300,
      "text": "你俩跟着我说话，",
      "token_start": 41,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 13300,
      "end_ms": 14540,
      "text": "做事都注意点，",
      "token_start": 48,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 14840,
      "end_ms": 15320,
      "text": "没问题。",
      "token_start": 54,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 15320,
      "end_ms": 15720,
      "text": "王姐，",
      "token_start": 57,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 15980,
      "end_ms": 16400,
      "text": "放心吧，",
      "token_start": 59,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 16400,
      "end_ms": 17705,
      "text": "王姐肯定不给你丢脸。",
      "token_start": 62,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 20680,
      "end_ms": 21420,
      "text": "李总久仰，",
      "token_start": 71,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 21420,
      "end_ms": 21700,
      "text": "久仰，",
      "token_start": 75,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 21700,
      "end_ms": 22300,
      "text": "王总客气了。",
      "token_start": 77,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 22300,
      "end_ms": 23900,
      "text": "关于这个季度的市场占有率，",
      "token_start": 82,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 23920,
      "end_ms": 25440,
      "text": "你们这边有什么具体的措施吗？",
      "token_start": 94,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 25460,
      "end_ms": 26580,
      "text": "我们做了充分的调研。",
      "token_start": 107,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 26760,
      "end_ms": 27880,
      "text": "根据目前的增长趋势，",
      "token_start": 116,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 27900,
      "end_ms": 29955,
      "text": "我们的核心竞争主要体现在三个方面。",
      "token_start": 125,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 32740,
      "end_ms": 33340,
      "text": "小张啊，",
      "token_start": 141,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 33940,
      "end_ms": 36980,
      "text": "你是第一个十来分钟就能把项目谈下来了的人，",
      "token_start": 144,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 37400,
      "end_ms": 38820,
      "text": "真是后生可畏啊，",
      "token_start": 164,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 39220,
      "end_ms": 41440,
      "text": "哪里哪里还是我们王姐厉害，",
      "token_start": 171,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 41680,
      "end_ms": 47090,
      "text": "我就是个打辅助的合同，",
      "token_start": 183,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 47090,
      "end_ms": 48150,
      "text": "今天先不着急签，",
      "token_start": 193,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 48670,
      "end_ms": 50310,
      "text": "李总还有什么问题吗？",
      "token_start": 200,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 50550,
      "end_ms": 52390,
      "text": "没什么这么大的项目，",
      "token_start": 209,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 52610,
      "end_ms": 53710,
      "text": "我再考虑考虑。",
      "token_start": 218,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 54010,
      "end_ms": 54409,
      "text": "李总，",
      "token_start": 224,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 54409,
      "end_ms": 56150,
      "text": "这正好明天晚上，",
      "token_start": 226,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 56150,
      "end_ms": 57470,
      "text": "我组了个局陈，",
      "token_start": 233,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 57470,
      "end_ms": 58290,
      "text": "总也会过来。",
      "token_start": 239,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 58450,
      "end_ms": 60215,
      "text": "王姐要是有时间一起吃个饭，",
      "token_start": 244,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 60870,
      "end_ms": 61650,
      "text": "李总邀请，",
      "token_start": 256,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 61730,
      "end_ms": 62835,
      "text": "那肯定有时间。",
      "token_start": 260,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 63200,
      "end_ms": 63565,
      "text": "行，",
      "token_start": 266,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 65190,
      "end_ms": 66050,
      "text": "那项目的事儿，",
      "token_start": 267,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 66050,
      "end_ms": 66815,
      "text": "咱们明天再聊。",
      "token_start": 273,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 72590,
      "end_ms": 73005,
      "text": "王姐，",
      "token_start": 279,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 75480,
      "end_ms": 77295,
      "text": "刚才项目不是都已经谈好了吗？",
      "token_start": 281,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 77630,
      "end_ms": 78805,
      "text": "合同都准备签了，",
      "token_start": 294,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 79250,
      "end_ms": 83080,
      "text": "李总怎么突然说要考虑你自己想想，",
      "token_start": 301,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 83080,
      "end_ms": 84060,
      "text": "刚才说什么了，",
      "token_start": 316,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 84140,
      "end_ms": 85205,
      "text": "我也没说什么啊。",
      "token_start": 322,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 85660,
      "end_ms": 86340,
      "text": "李总夸我，",
      "token_start": 329,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 86340,
      "end_ms": 87475,
      "text": "我就是谦虚了一下，",
      "token_start": 333,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 87910,
      "end_ms": 89030,
      "text": "总不能人家夸我两句，",
      "token_start": 341,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 89030,
      "end_ms": 90025,
      "text": "我还真认了吧。",
      "token_start": 350,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 90540,
      "end_ms": 93045,
      "text": "李总夸你是认可你的能力，",
      "token_start": 356,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 93390,
      "end_ms": 94295,
      "text": "结果你倒好，",
      "token_start": 367,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 94720,
      "end_ms": 95835,
      "text": "自己先告诉人家，",
      "token_start": 372,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 96120,
      "end_ms": 99220,
      "text": "你就是个打辅助的这句话有什么问题啊。",
      "token_start": 379,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 99220,
      "end_ms": 102305,
      "text": "一千万的项目你自己都不敢认自己的能力，",
      "token_start": 396,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 102510,
      "end_ms": 103595,
      "text": "你让客户怎么放心？",
      "token_start": 414,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 104090,
      "end_ms": 105185,
      "text": "就因为这一句话，",
      "token_start": 422,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 105580,
      "end_ms": 108745,
      "text": "很多时候人家看的不只是你会不会做事，",
      "token_start": 429,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 109090,
      "end_ms": 110955,
      "text": "也看你会不会跟人打交道。",
      "token_start": 446,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 112510,
      "end_ms": 114155,
      "text": "那这个项目是不是没戏了？",
      "token_start": 457,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 114440,
      "end_ms": 115145,
      "text": "还有机会，",
      "token_start": 468,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 115760,
      "end_ms": 117765,
      "text": "这个项目光提成都不止一百万。",
      "token_start": 472,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 118260,
      "end_ms": 119805,
      "text": "李总既然没有直接拒绝，",
      "token_start": 485,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 120270,
      "end_ms": 121510,
      "text": "还主动约了明天的贩案局，",
      "token_start": 495,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 121510,
      "end_ms": 122745,
      "text": "就说明事情还有转机，",
      "token_start": 506,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 123260,
      "end_ms": 124725,
      "text": "能不能把这个项目拿下来，",
      "token_start": 515,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 125530,
      "end_ms": 126935,
      "text": "就看你们两个明天的表现了。",
      "token_start": 526,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 131730,
      "end_ms": 133410,
      "text": "有王杰来了，",
      "token_start": 538,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 133610,
      "end_ms": 134415,
      "text": "快坐快坐。",
      "token_start": 543,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 135140,
      "end_ms": 135835,
      "text": "不好意思，",
      "token_start": 547,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 136210,
      "end_ms": 137390,
      "text": "让两位久等了。",
      "token_start": 551,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 137450,
      "end_ms": 139145,
      "text": "哪里哪里都是自己人。",
      "token_start": 557,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 146220,
      "end_ms": 146835,
      "text": "小张啊，",
      "token_start": 566,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 147230,
      "end_ms": 147890,
      "text": "今天高兴，",
      "token_start": 569,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 148070,
      "end_ms": 150250,
      "text": "刚好李总和陈总都在你来讲两句。",
      "token_start": 573,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 150250,
      "end_ms": 150670,
      "text": "好好，",
      "token_start": 587,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 150850,
      "end_ms": 152270,
      "text": "那祝大家吃好喝。",
      "token_start": 589,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 152270,
      "end_ms": 152510,
      "text": "好，",
      "token_start": 596,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 152590,
      "end_ms": 154775,
      "text": "我先干了啊。",
      "token_start": 597,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 154930,
      "end_ms": 155330,
      "text": "好好，",
      "token_start": 602,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 157760,
      "end_ms": 158265,
      "text": "王姐，",
      "token_start": 604,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 158590,
      "end_ms": 159975,
      "text": "那我也借这个机会说两句。",
      "token_start": 606,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 160190,
      "end_ms": 160430,
      "text": "好，",
      "token_start": 617,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 160470,
      "end_ms": 162785,
      "text": "你说非常感谢李总今天组的局，",
      "token_start": 618,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 163040,
      "end_ms": 164340,
      "text": "也感谢王姐带我们过来，",
      "token_start": 631,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 164340,
      "end_ms": 165655,
      "text": "让我先认识各位前辈，",
      "token_start": 641,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 165960,
      "end_ms": 166540,
      "text": "我叫玲玲。",
      "token_start": 650,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 166820,
      "end_ms": 167420,
      "text": "俗话说，",
      "token_start": 654,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 167600,
      "end_ms": 169055,
      "text": "相聚是一种缘分。",
      "token_start": 657,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 169380,
      "end_ms": 169900,
      "text": "此时此刻，",
      "token_start": 664,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 169900,
      "end_ms": 172025,
      "text": "我把对各位的祝福化作一杯美酒，",
      "token_start": 668,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 172280,
      "end_ms": 173700,
      "text": "祝各位扶摇直上。",
      "token_start": 682,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 173700,
      "end_ms": 175915,
      "text": "九万里事业长虹节节高。",
      "token_start": 689,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 176480,
      "end_ms": 177020,
      "text": "哈哈哈。",
      "token_start": 699,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 177220,
      "end_ms": 177635,
      "text": "好，",
      "token_start": 702,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 178260,
      "end_ms": 179385,
      "text": "这姑娘会说话，",
      "token_start": 703,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 186790,
      "end_ms": 187230,
      "text": "王姐，",
      "token_start": 709,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 187690,
      "end_ms": 188270,
      "text": "来这杯，",
      "token_start": 711,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 188270,
      "end_ms": 191970,
      "text": "我敬你陈总这杯，",
      "token_start": 714,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 191970,
      "end_ms": 192850,
      "text": "我替王姐敬您，",
      "token_start": 721,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 193770,
      "end_ms": 195130,
      "text": "我敬的是你们领导，",
      "token_start": 727,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 195870,
      "end_ms": 196690,
      "text": "你是领导吗？",
      "token_start": 735,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 197170,
      "end_ms": 198070,
      "text": "瞧您说的，",
      "token_start": 740,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 198390,
      "end_ms": 199490,
      "text": "您敬的是我领导，",
      "token_start": 744,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 199650,
      "end_ms": 200870,
      "text": "我同样敬的也领导，",
      "token_start": 751,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 201090,
      "end_ms": 202310,
      "text": "您敬领导是心意，",
      "token_start": 759,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 202450,
      "end_ms": 204330,
      "text": "我敬您是尊敬这杯，",
      "token_start": 766,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 204330,
      "end_ms": 205170,
      "text": "我敬的是生意，",
      "token_start": 774,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 205250,
      "end_ms": 205790,
      "text": "咱们随意，",
      "token_start": 780,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 205790,
      "end_ms": 207210,
      "text": "祝您生意一路长虹，",
      "token_start": 784,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 207310,
      "end_ms": 207990,
      "text": "万事顺利。",
      "token_start": 792,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 210670,
      "end_ms": 211930,
      "text": "这小姑娘会说话，",
      "token_start": 796,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 212150,
      "end_ms": 213670,
      "text": "琳琳刚才说的不错，",
      "token_start": 803,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 213750,
      "end_ms": 214750,
      "text": "来咱俩喝一个，",
      "token_start": 811,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 214750,
      "end_ms": 215465,
      "text": "谢谢李总。",
      "token_start": 817,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 218070,
      "end_ms": 218310,
      "text": "哎，",
      "token_start": 821,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 218850,
      "end_ms": 220410,
      "text": "怎么到我这就剩半杯了，",
      "token_start": 822,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 220930,
      "end_ms": 221670,
      "text": "瓶底酒，",
      "token_start": 832,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 221750,
      "end_ms": 222690,
      "text": "这叫发财酒，",
      "token_start": 835,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 222930,
      "end_ms": 224310,
      "text": "到底发财好事，",
      "token_start": 840,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 224310,
      "end_ms": 227110,
      "text": "再来好一个发财酒。",
      "token_start": 846,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 227290,
      "end_ms": 227710,
      "text": "琳琳，",
      "token_start": 854,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 228310,
      "end_ms": 229810,
      "text": "你这姑娘反应挺快，",
      "token_start": 856,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 230470,
      "end_ms": 233870,
      "text": "王姐手底下有你这样的员工省心啊。",
      "token_start": 864,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 234650,
      "end_ms": 235130,
      "text": "李总，",
      "token_start": 879,
      "token_end_exclusive": 881
    },
    {
      "start_ms": 235250,
      "end_ms": 236030,
      "text": "您过奖了，",
      "token_start": 881,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 236410,
      "end_ms": 239970,
      "text": "主要还是王姐平时带的好强将手下无若兵，",
      "token_start": 885,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 240250,
      "end_ms": 242215,
      "text": "我总不能给我们王姐丢脸呀。",
      "token_start": 903,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 242750,
      "end_ms": 244020,
      "text": "哈哈哈嗯，",
      "token_start": 915,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 244070,
      "end_ms": 244515,
      "text": "王姐，",
      "token_start": 919,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 245040,
      "end_ms": 246815,
      "text": "你手底下这个姑娘不错，",
      "token_start": 921,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 247760,
      "end_ms": 250165,
      "text": "年轻人还得多跟您学习。",
      "token_start": 931,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 250680,
      "end_ms": 251005,
      "text": "哎，",
      "token_start": 941,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 252810,
      "end_ms": 253970,
      "text": "王姐李总，",
      "token_start": 942,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 254050,
      "end_ms": 256985,
      "text": "您说昨天那个一千万的项目，",
      "token_start": 946,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 258530,
      "end_ms": 259325,
      "text": "我考虑好了，",
      "token_start": 958,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 260110,
      "end_ms": 261295,
      "text": "项目可以继续合作。",
      "token_start": 963,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 262220,
      "end_ms": 263065,
      "text": "不过我有个条件，",
      "token_start": 971,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 264020,
      "end_ms": 264460,
      "text": "李总，",
      "token_start": 978,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 264620,
      "end_ms": 267995,
      "text": "您说这个项目后面我希望让玲玲来负责。",
      "token_start": 980,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 269950,
      "end_ms": 270410,
      "text": "李总，",
      "token_start": 997,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 270530,
      "end_ms": 274125,
      "text": "我对小张的业务能力没问题，",
      "token_start": 999,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 274930,
      "end_ms": 276315,
      "text": "这一点昨天我就看出来了。",
      "token_start": 1011,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 276900,
      "end_ms": 280145,
      "text": "不过这么大的项目后面少不了跟各种人打交道。",
      "token_start": 1022,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 280390,
      "end_ms": 284110,
      "text": "今天晚上我也一直在观察你们两个这个项目交给琳琳，",
      "token_start": 1042,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 284110,
      "end_ms": 284805,
      "text": "我更放心，",
      "token_start": 1065,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 285980,
      "end_ms": 286925,
      "text": "谢谢李总信任，",
      "token_start": 1069,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 287430,
      "end_ms": 288905,
      "text": "也谢谢王姐给我这个机会。",
      "token_start": 1075,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 289390,
      "end_ms": 290930,
      "text": "后面有什么做的不到位的地方，",
      "token_start": 1086,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 291090,
      "end_ms": 292135,
      "text": "还得请两位多指点。",
      "token_start": 1099,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 292730,
      "end_ms": 293105,
      "text": "好，",
      "token_start": 1107,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 294000,
      "end_ms": 294855,
      "text": "那就这么定了。",
      "token_start": 1108,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 300580,
      "end_ms": 303440,
      "text": "琳琳李总那边合同已经确定了，",
      "token_start": 1114,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 303740,
      "end_ms": 305480,
      "text": "后面这个项目你来负责，",
      "token_start": 1127,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 306020,
      "end_ms": 306660,
      "text": "谢谢王姐，",
      "token_start": 1137,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 306700,
      "end_ms": 307420,
      "text": "我一定把它做好，",
      "token_start": 1141,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 307420,
      "end_ms": 308800,
      "text": "有不懂的地方随时问我，",
      "token_start": 1148,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 308920,
      "end_ms": 309215,
      "text": "嗯，",
      "token_start": 1158,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 312280,
      "end_ms": 314580,
      "text": "王姐怎么了？",
      "token_start": 1159,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 314840,
      "end_ms": 316920,
      "text": "这个项目前两天明明是我谈下来的，",
      "token_start": 1164,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 317360,
      "end_ms": 319480,
      "text": "李总问的那些业务问题也是我回答的，",
      "token_start": 1179,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 319840,
      "end_ms": 321920,
      "text": "为什么最后负责人却变成琳琳了？",
      "token_start": 1195,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 322400,
      "end_ms": 328440,
      "text": "你真不知道为什么业务上你不比玲玲差，",
      "token_start": 1209,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 328860,
      "end_ms": 330480,
      "text": "甚至前两天谈项目的时候，",
      "token_start": 1226,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 330480,
      "end_ms": 331440,
      "text": "你表现的很好，",
      "token_start": 1237,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 331820,
      "end_ms": 333840,
      "text": "可为什么都已经准备签合同了，",
      "token_start": 1243,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 333960,
      "end_ms": 335320,
      "text": "李总突然又不签了。",
      "token_start": 1256,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 336120,
      "end_ms": 337660,
      "text": "再想想昨天晚上的饭局，",
      "token_start": 1264,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 338260,
      "end_ms": 339580,
      "text": "我突然让你讲两句，",
      "token_start": 1274,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 339820,
      "end_ms": 340600,
      "text": "你说了什么？",
      "token_start": 1282,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 340760,
      "end_ms": 341540,
      "text": "大家吃好喝。",
      "token_start": 1287,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 341540,
      "end_ms": 341780,
      "text": "好，",
      "token_start": 1292,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 341840,
      "end_ms": 342499,
      "text": "我先干了。",
      "token_start": 1293,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 342900,
      "end_ms": 343760,
      "text": "陈总问玲玲，",
      "token_start": 1297,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 343760,
      "end_ms": 344660,
      "text": "你是领导吗？",
      "token_start": 1302,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 344840,
      "end_ms": 345620,
      "text": "如果换成你，",
      "token_start": 1307,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 345620,
      "end_ms": 346640,
      "text": "你知道怎么接吗？",
      "token_start": 1312,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 347540,
      "end_ms": 349140,
      "text": "陈总杯子里只倒了半杯酒。",
      "token_start": 1319,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 349300,
      "end_ms": 349980,
      "text": "如果是你，",
      "token_start": 1330,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 350220,
      "end_ms": 351480,
      "text": "你第一反应是什么？",
      "token_start": 1334,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 352360,
      "end_ms": 354540,
      "text": "可能先跟陈总道歉，",
      "token_start": 1342,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 354740,
      "end_ms": 355500,
      "text": "这就是区别。",
      "token_start": 1350,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 355760,
      "end_ms": 356890,
      "text": "你不是能力不行，",
      "token_start": 1355,
      "token_end_exclusive": 1362
    },
    {
      "start_ms": 357150,
      "end_ms": 358190,
      "text": "是这么大的项目，",
      "token_start": 1362,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 358210,
      "end_ms": 359210,
      "text": "除了把事情做好，",
      "token_start": 1369,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 359210,
      "end_ms": 360450,
      "text": "还要面对客户、合作方，",
      "token_start": 1376,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 360450,
      "end_ms": 361535,
      "text": "还有各种突发情况。",
      "token_start": 1385,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 361910,
      "end_ms": 363010,
      "text": "李总最后选琳琳，",
      "token_start": 1393,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 363090,
      "end_ms": 365005,
      "text": "不是因为她比你会说几句漂亮话，",
      "token_start": 1400,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 365350,
      "end_ms": 369165,
      "text": "是因为昨天晚上他都在看你们两个人遇到事情的时候怎么处理，",
      "token_start": 1414,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 370060,
      "end_ms": 371795,
      "text": "别光想着自己为什么没拿到，",
      "token_start": 1441,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 372220,
      "end_ms": 379980,
      "text": "好好想想琳琳为什么能拿到练练。",
      "token_start": 1453,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 380230,
      "end_ms": 381210,
      "text": "刚才我确实有点不服，",
      "token_start": 1467,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 381270,
      "end_ms": 381595,
      "text": "嗯，",
      "token_start": 1476,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 382120,
      "end_ms": 383660,
      "text": "毕竟这个项目签了那些业务问题，",
      "token_start": 1477,
      "token_end_exclusive": 1491
    },
    {
      "start_ms": 383660,
      "end_ms": 384505,
      "text": "也是我回答的。",
      "token_start": 1491,
      "token_end_exclusive": 1497
    },
    {
      "start_ms": 385070,
      "end_ms": 386090,
      "text": "但是王姐刚才说完，",
      "token_start": 1497,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 386090,
      "end_ms": 386965,
      "text": "我仔细想了想，",
      "token_start": 1505,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 387370,
      "end_ms": 389565,
      "text": "我好像明白李总为什么最后选你了，",
      "token_start": 1511,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 389800,
      "end_ms": 390425,
      "text": "为什么？",
      "token_start": 1526,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 390840,
      "end_ms": 391215,
      "text": "哎，",
      "token_start": 1529,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 391730,
      "end_ms": 393155,
      "text": "业务上的问题我会回答，",
      "token_start": 1530,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 393580,
      "end_ms": 394800,
      "text": "可一碰到这种突发情况，",
      "token_start": 1540,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 394800,
      "end_ms": 395440,
      "text": "我就嘴笨，",
      "token_start": 1550,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 395620,
      "end_ms": 396215,
      "text": "反应慢。",
      "token_start": 1554,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 397080,
      "end_ms": 399450,
      "text": "但有件事我还是没想明白什么。",
      "token_start": 1557,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 399590,
      "end_ms": 400650,
      "text": "李总夸我的时候，",
      "token_start": 1570,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 400650,
      "end_ms": 401650,
      "text": "我把功劳给了王姐。",
      "token_start": 1577,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 401770,
      "end_ms": 402950,
      "text": "后来李总夸你的时候，",
      "token_start": 1585,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 402950,
      "end_ms": 404095,
      "text": "你也把功劳给了王姐。",
      "token_start": 1594,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 404310,
      "end_ms": 404950,
      "text": "可我说完，",
      "token_start": 1603,
      "token_end_exclusive": 1607
    },
    {
      "start_ms": 405010,
      "end_ms": 406310,
      "text": "人家合同都不想签了，",
      "token_start": 1607,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 406350,
      "end_ms": 408305,
      "text": "你说完人家反而越来越认可你。",
      "token_start": 1616,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 408860,
      "end_ms": 411245,
      "text": "因为谦虚不等于否定自己啊，",
      "token_start": 1629,
      "token_end_exclusive": 1641
    },
    {
      "start_ms": 411680,
      "end_ms": 412780,
      "text": "你可以抬高别人，",
      "token_start": 1641,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 412920,
      "end_ms": 414385,
      "text": "但是没必要把自己压下去。",
      "token_start": 1648,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 414610,
      "end_ms": 415155,
      "text": "什么意思？",
      "token_start": 1659,
      "token_end_exclusive": 1663
    },
    {
      "start_ms": 415410,
      "end_ms": 416690,
      "text": "比如那天李总夸你，",
      "token_start": 1663,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 416690,
      "end_ms": 417515,
      "text": "后生可畏，",
      "token_start": 1671,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 417850,
      "end_ms": 419610,
      "text": "你完全可以说您过奖了。",
      "token_start": 1675,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 419770,
      "end_ms": 421215,
      "text": "要不是您愿意给机会，",
      "token_start": 1685,
      "token_end_exclusive": 1694
    },
    {
      "start_ms": 421510,
      "end_ms": 423430,
      "text": "我哪能跟您这么有魄力的人合作啊，",
      "token_start": 1694,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 423510,
      "end_ms": 425025,
      "text": "以后还得跟您多学呢。",
      "token_start": 1709,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 425420,
      "end_ms": 427680,
      "text": "这样既没有把功劳全揽到自己身上，",
      "token_start": 1718,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 427820,
      "end_ms": 429545,
      "text": "也没有把自己说的一文不值。",
      "token_start": 1733,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 429990,
      "end_ms": 430905,
      "text": "可是还有个问题，",
      "token_start": 1745,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 431540,
      "end_ms": 432745,
      "text": "昨天陈总突然问你，",
      "token_start": 1752,
      "token_end_exclusive": 1760
    },
    {
      "start_ms": 433100,
      "end_ms": 433935,
      "text": "你是领导吗？",
      "token_start": 1760,
      "token_end_exclusive": 1765
    },
    {
      "start_ms": 434270,
      "end_ms": 435745,
      "text": "还有倒酒突然只剩半杯，",
      "token_start": 1765,
      "token_end_exclusive": 1775
    },
    {
      "start_ms": 436440,
      "end_ms": 438025,
      "text": "这些又没人提前告诉你，",
      "token_start": 1775,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 438710,
      "end_ms": 440675,
      "text": "你为什么每次马上就知道怎么接。",
      "token_start": 1785,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 441550,
      "end_ms": 443535,
      "text": "你别告诉我这些全都是林常想的。",
      "token_start": 1799,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 443920,
      "end_ms": 444685,
      "text": "当然不是，",
      "token_start": 1813,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 445280,
      "end_ms": 446535,
      "text": "那你到底是怎么练的？",
      "token_start": 1817,
      "token_end_exclusive": 1826
    },
    {
      "start_ms": 447350,
      "end_ms": 448765,
      "text": "其实我以前跟你一样，",
      "token_start": 1826,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 449440,
      "end_ms": 450200,
      "text": "不爱说话，",
      "token_start": 1835,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 450260,
      "end_ms": 451085,
      "text": "不爱争辩，",
      "token_start": 1839,
      "token_end_exclusive": 1843
    },
    {
      "start_ms": 451870,
      "end_ms": 454495,
      "text": "一到这种场合就不知道应该说什么。",
      "token_start": 1843,
      "token_end_exclusive": 1858
    },
    {
      "start_ms": 455440,
      "end_ms": 458380,
      "text": "后来我就经常看这本把话说的恰到好处。",
      "token_start": 1858,
      "token_end_exclusive": 1875
    },
    {
      "start_ms": 458720,
      "end_ms": 460180,
      "text": "它里面就是一个场景，",
      "token_start": 1875,
      "token_end_exclusive": 1884
    },
    {
      "start_ms": 460180,
      "end_ms": 461420,
      "text": "一个场景的告诉你，",
      "token_start": 1884,
      "token_end_exclusive": 1892
    },
    {
      "start_ms": 461580,
      "end_ms": 463795,
      "text": "遇到不同的人不同的话应该怎么接。",
      "token_start": 1892,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 464800,
      "end_ms": 466700,
      "text": "比如别人夸你优秀，",
      "token_start": 1907,
      "token_end_exclusive": 1915
    },
    {
      "start_ms": 466840,
      "end_ms": 467605,
      "text": "你可以回，",
      "token_start": 1915,
      "token_end_exclusive": 1919
    },
    {
      "start_ms": 468080,
      "end_ms": 469260,
      "text": "那是不优秀点儿，",
      "token_start": 1919,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 469260,
      "end_ms": 470585,
      "text": "怎么能和你做朋友呢？",
      "token_start": 1926,
      "token_end_exclusive": 1935
    },
    {
      "start_ms": 470860,
      "end_ms": 472020,
      "text": "当别人说你真聪明，",
      "token_start": 1935,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 472160,
      "end_ms": 473680,
      "text": "你就回近朱者赤，",
      "token_start": 1943,
      "token_end_exclusive": 1950
    },
    {
      "start_ms": 473820,
      "end_ms": 474740,
      "text": "和你在一起啊，",
      "token_start": 1950,
      "token_end_exclusive": 1956
    },
    {
      "start_ms": 474740,
      "end_ms": 477570,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 1956,
      "token_end_exclusive": 1971
    },
    {
      "start_ms": 477750,
      "end_ms": 479100,
      "text": "你就回领导，",
      "token_start": 1971,
      "token_end_exclusive": 1976
    },
    {
      "start_ms": 479240,
      "end_ms": 480445,
      "text": "这都是我应该做的。",
      "token_start": 1976,
      "token_end_exclusive": 1984
    },
    {
      "start_ms": 480750,
      "end_ms": 482090,
      "text": "强将手下吴若冰，",
      "token_start": 1984,
      "token_end_exclusive": 1991
    },
    {
      "start_ms": 482230,
      "end_ms": 483635,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 1991,
      "token_end_exclusive": 2000
    },
    {
      "start_ms": 483890,
      "end_ms": 485485,
      "text": "难怪你每次都能借的这么快，",
      "token_start": 2000,
      "token_end_exclusive": 2012
    },
    {
      "start_ms": 485900,
      "end_ms": 487475,
      "text": "这种东西不是天生的，",
      "token_start": 2012,
      "token_end_exclusive": 2021
    },
    {
      "start_ms": 488210,
      "end_ms": 489390,
      "text": "就是平时一个场景，",
      "token_start": 2021,
      "token_end_exclusive": 2029
    },
    {
      "start_ms": 489390,
      "end_ms": 489950,
      "text": "一个场景的，",
      "token_start": 2029,
      "token_end_exclusive": 2034
    },
    {
      "start_ms": 489950,
      "end_ms": 490910,
      "text": "看一个场景，",
      "token_start": 2034,
      "token_end_exclusive": 2039
    },
    {
      "start_ms": 490910,
      "end_ms": 491675,
      "text": "一个场景的练。",
      "token_start": 2039,
      "token_end_exclusive": 2045
    },
    {
      "start_ms": 492450,
      "end_ms": 493375,
      "text": "每天看两页，",
      "token_start": 2045,
      "token_end_exclusive": 2050
    },
    {
      "start_ms": 493840,
      "end_ms": 495800,
      "text": "慢慢积累一些不同的场景之下，",
      "token_start": 2050,
      "token_end_exclusive": 2063
    },
    {
      "start_ms": 495800,
      "end_ms": 496500,
      "text": "应该怎么说？",
      "token_start": 2063,
      "token_end_exclusive": 2068
    },
    {
      "start_ms": 496840,
      "end_ms": 498695,
      "text": "这里面还有很多生活里的场景，",
      "token_start": 2068,
      "token_end_exclusive": 2081
    },
    {
      "start_ms": 499000,
      "end_ms": 500100,
      "text": "比如对象给你发红包，",
      "token_start": 2081,
      "token_end_exclusive": 2090
    },
    {
      "start_ms": 500100,
      "end_ms": 502935,
      "text": "你可以回你是我致富道路上最大的功臣，",
      "token_start": 2090,
      "token_end_exclusive": 2107
    },
    {
      "start_ms": 503360,
      "end_ms": 504320,
      "text": "同事向你借钱，",
      "token_start": 2107,
      "token_end_exclusive": 2113
    },
    {
      "start_ms": 504500,
      "end_ms": 505200,
      "text": "你又不想借，",
      "token_start": 2113,
      "token_end_exclusive": 2118
    },
    {
      "start_ms": 505280,
      "end_ms": 505700,
      "text": "可以回，",
      "token_start": 2118,
      "token_end_exclusive": 2121
    },
    {
      "start_ms": 505940,
      "end_ms": 507220,
      "text": "大家都是一样的年纪，",
      "token_start": 2121,
      "token_end_exclusive": 2130
    },
    {
      "start_ms": 507360,
      "end_ms": 508020,
      "text": "你没有的，",
      "token_start": 2130,
      "token_end_exclusive": 2134
    },
    {
      "start_ms": 508020,
      "end_ms": 508845,
      "text": "我能有吗？",
      "token_start": 2134,
      "token_end_exclusive": 2138
    },
    {
      "start_ms": 510000,
      "end_ms": 512065,
      "text": "还有心仪的人跟你说我想你了，",
      "token_start": 2138,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 512370,
      "end_ms": 514010,
      "text": "你可以回随便想，",
      "token_start": 2151,
      "token_end_exclusive": 2158
    },
    {
      "start_ms": 514210,
      "end_ms": 515405,
      "text": "千万别跟我客气，",
      "token_start": 2158,
      "token_end_exclusive": 2165
    },
    {
      "start_ms": 515620,
      "end_ms": 516305,
      "text": "目前不收费，",
      "token_start": 2165,
      "token_end_exclusive": 2170
    },
    {
      "start_ms": 517870,
      "end_ms": 518770,
      "text": "这个有意思。",
      "token_start": 2170,
      "token_end_exclusive": 2175
    },
    {
      "start_ms": 518850,
      "end_ms": 520170,
      "text": "我第一次读到这些的时候，",
      "token_start": 2175,
      "token_end_exclusive": 2186
    },
    {
      "start_ms": 520170,
      "end_ms": 521765,
      "text": "真的有种豁然开朗的感觉。",
      "token_start": 2186,
      "token_end_exclusive": 2197
    },
    {
      "start_ms": 522340,
      "end_ms": 525880,
      "text": "这本书就是把工作、生活、人际交往里经常遇到的场景，",
      "token_start": 2197,
      "token_end_exclusive": 2219
    },
    {
      "start_ms": 525940,
      "end_ms": 527180,
      "text": "一个一个拆开给你看，",
      "token_start": 2219,
      "token_end_exclusive": 2228
    },
    {
      "start_ms": 527460,
      "end_ms": 528220,
      "text": "别人怎么说，",
      "token_start": 2228,
      "token_end_exclusive": 2233
    },
    {
      "start_ms": 528360,
      "end_ms": 529140,
      "text": "你可以怎么接，",
      "token_start": 2233,
      "token_end_exclusive": 2239
    },
    {
      "start_ms": 529280,
      "end_ms": 530755,
      "text": "都是一句一句给你举例。",
      "token_start": 2239,
      "token_end_exclusive": 2249
    },
    {
      "start_ms": 531200,
      "end_ms": 533405,
      "text": "所以你平时就是这么练的对啊，",
      "token_start": 2249,
      "token_end_exclusive": 2262
    },
    {
      "start_ms": 533850,
      "end_ms": 535695,
      "text": "每天不用看很多看两页，",
      "token_start": 2262,
      "token_end_exclusive": 2272
    },
    {
      "start_ms": 536060,
      "end_ms": 539370,
      "text": "碰到自己觉得有用的表达就记一记慢慢积累的多了。",
      "token_start": 2272,
      "token_end_exclusive": 2294
    },
    {
      "start_ms": 539570,
      "end_ms": 541730,
      "text": "工作和生活里再碰到类似的场景，",
      "token_start": 2294,
      "token_end_exclusive": 2308
    },
    {
      "start_ms": 541790,
      "end_ms": 542845,
      "text": "你就知道怎么接了。",
      "token_start": 2308,
      "token_end_exclusive": 2316
    },
    {
      "start_ms": 544650,
      "end_ms": 545230,
      "text": "这本先借，",
      "token_start": 2316,
      "token_end_exclusive": 2320
    },
    {
      "start_ms": 545230,
      "end_ms": 546560,
      "text": "我看看拿去吧，",
      "token_start": 2320,
      "token_end_exclusive": 2326
    },
    {
      "start_ms": 546740,
      "end_ms": 547565,
      "text": "回去慢慢看。",
      "token_start": 2326,
      "token_end_exclusive": 2331
    }
  ],
