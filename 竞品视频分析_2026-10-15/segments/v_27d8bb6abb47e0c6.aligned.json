{
  "video_id": "v_27d8bb6abb47e0c6",
  "duration_s": 448.493991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_27d8bb6abb47e0c6.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_27d8bb6abb47e0c6.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 4710,
      "text": "您知道中国古代最有文人气的名亭都有哪些吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5170,
      "end_ms": 5730,
      "text": "上集，",
      "token_start": 20,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5810,
      "end_ms": 15370,
      "text": "咱们聊了真趣亭吹台放鹤亭风、乐亭沧浪亭那场直接揭开谜底，",
      "token_start": 22,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 15770,
      "end_ms": 18050,
      "text": "看看前五名文雅到什么程度，",
      "token_start": 48,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 18490,
      "end_ms": 20630,
      "text": "尤其是排在榜首的那座，",
      "token_start": 60,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 21050,
      "end_ms": 24450,
      "text": "哪怕亭子在历史上屡遭冰火损毁，",
      "token_start": 70,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 24970,
      "end_ms": 29875,
      "text": "哪要有人提笔沾墨那场流觞曲水的浩荡兰香，",
      "token_start": 84,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 30360,
      "end_ms": 32740,
      "text": "就立刻在字里行间活了过来。",
      "token_start": 103,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 33080,
      "end_ms": 33760,
      "text": "老规矩，",
      "token_start": 115,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 34040,
      "end_ms": 35020,
      "text": "开讲之前，",
      "token_start": 118,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 35080,
      "end_ms": 37760,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 122,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 38260,
      "end_ms": 41300,
      "text": "让我看看都是谁在听第五名，",
      "token_start": 132,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 41640,
      "end_ms": 42380,
      "text": "爱婉亭。",
      "token_start": 144,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 42880,
      "end_ms": 45840,
      "text": "在湖南长沙岳麓山的清风峡里，",
      "token_start": 147,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 46440,
      "end_ms": 48420,
      "text": "他修在清朝乾隆年间，",
      "token_start": 160,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 49060,
      "end_ms": 50700,
      "text": "原先叫红叶亭，",
      "token_start": 169,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 50980,
      "end_ms": 51720,
      "text": "高九米，",
      "token_start": 175,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 52200,
      "end_ms": 54520,
      "text": "顶上铺着绿油油的琉璃瓦，",
      "token_start": 178,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 55060,
      "end_ms": 56440,
      "text": "八根红大柱子，",
      "token_start": 189,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 56540,
      "end_ms": 58660,
      "text": "稳稳顶着四角飞檐。",
      "token_start": 195,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 59080,
      "end_ms": 64100,
      "text": "后来的关缘取杜牧停车坐爱枫林晚的名句，",
      "token_start": 203,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 64400,
      "end_ms": 65995,
      "text": "改名叫爱婉亭。",
      "token_start": 221,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 66450,
      "end_ms": 71340,
      "text": "您要是秋天去傍晚的光打在红叶上风一过，",
      "token_start": 227,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 71620,
      "end_ms": 73345,
      "text": "叶子落进亭子里。",
      "token_start": 245,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 73920,
      "end_ms": 77065,
      "text": "杜牧那句诗就在脑子里自己跑出来了。",
      "token_start": 252,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 77560,
      "end_ms": 78805,
      "text": "这不是背课文，",
      "token_start": 268,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 79290,
      "end_ms": 81765,
      "text": "这是脚踩进诗里的感觉。",
      "token_start": 274,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 82340,
      "end_ms": 85115,
      "text": "年轻世子在这儿指点江山，",
      "token_start": 284,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 85470,
      "end_ms": 86345,
      "text": "激扬文字，",
      "token_start": 295,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 86770,
      "end_ms": 87230,
      "text": "诗情，",
      "token_start": 299,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 87350,
      "end_ms": 88355,
      "text": "融进山水，",
      "token_start": 301,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 88830,
      "end_ms": 90745,
      "text": "文胆皆续文脉。",
      "token_start": 305,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 91150,
      "end_ms": 92985,
      "text": "在这站上一炷香的功夫，",
      "token_start": 311,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 93330,
      "end_ms": 96135,
      "text": "整个人都被书卷墨香浸透了。",
      "token_start": 321,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 96980,
      "end_ms": 98735,
      "text": "您说他能不流传千古吗？",
      "token_start": 333,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 99120,
      "end_ms": 99745,
      "text": "第四名，",
      "token_start": 343,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 100180,
      "end_ms": 103925,
      "text": "陶然亭在北京城南先农坛的西边，",
      "token_start": 346,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 104320,
      "end_ms": 105695,
      "text": "清朝康熙年间，",
      "token_start": 360,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 106220,
      "end_ms": 110815,
      "text": "一位管工程的官员江早在这盖了三间小草亭，",
      "token_start": 366,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 111220,
      "end_ms": 114775,
      "text": "借白居易共君一醉一桃然的诗句，",
      "token_start": 385,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 115140,
      "end_ms": 116255,
      "text": "给他起了名字。",
      "token_start": 399,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 116680,
      "end_ms": 118395,
      "text": "在整整两百多年里，",
      "token_start": 405,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 118750,
      "end_ms": 123845,
      "text": "各地进京赶考的举子文人只要科举落了榜，",
      "token_start": 413,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 124720,
      "end_ms": 127035,
      "text": "或者要卷铺盖离开京城，",
      "token_start": 431,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 127480,
      "end_ms": 129945,
      "text": "全都会跑到这儿来借酒浇愁。",
      "token_start": 441,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 130370,
      "end_ms": 131730,
      "text": "您说这样的地方，",
      "token_start": 453,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 131870,
      "end_ms": 133455,
      "text": "它哪里只是一座亭？",
      "token_start": 460,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 133910,
      "end_ms": 137045,
      "text": "他是北京文人两百年的出气口，",
      "token_start": 468,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 137460,
      "end_ms": 139455,
      "text": "落脚点散心的地方。",
      "token_start": 481,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 139810,
      "end_ms": 140645,
      "text": "第三名，",
      "token_start": 489,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 141080,
      "end_ms": 144065,
      "text": "湖心亭就站在西湖正中央。",
      "token_start": 492,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 144630,
      "end_ms": 145875,
      "text": "四面都是水，",
      "token_start": 503,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 146540,
      "end_ms": 147805,
      "text": "四面都是山，",
      "token_start": 508,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 148650,
      "end_ms": 150275,
      "text": "夏天来是热闹，",
      "token_start": 513,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 150680,
      "end_ms": 152045,
      "text": "冬天落了大雪，",
      "token_start": 519,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 152380,
      "end_ms": 154340,
      "text": "就是另一个世界张岱。",
      "token_start": 525,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 154340,
      "end_ms": 157480,
      "text": "在湖心亭看学里写过崇祯五年，",
      "token_start": 534,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 157560,
      "end_ms": 159025,
      "text": "大雪下了三天，",
      "token_start": 547,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 159750,
      "end_ms": 161850,
      "text": "他半夜一个人撑着小船，",
      "token_start": 553,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 161990,
      "end_ms": 164715,
      "text": "出门看雪山是白的，",
      "token_start": 563,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 165110,
      "end_ms": 166115,
      "text": "亭是白的，",
      "token_start": 571,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 166700,
      "end_ms": 168815,
      "text": "天地之间像是被抹平了。",
      "token_start": 575,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 169210,
      "end_ms": 170235,
      "text": "到了亭上，",
      "token_start": 585,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 170580,
      "end_ms": 171945,
      "text": "居然还有两个人，",
      "token_start": 589,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 172340,
      "end_ms": 173520,
      "text": "三个人围着炉子，",
      "token_start": 596,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 173520,
      "end_ms": 175755,
      "text": "把酒喝完各自散的，",
      "token_start": 603,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 176200,
      "end_ms": 177365,
      "text": "连名字都没留。",
      "token_start": 611,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 178050,
      "end_ms": 179685,
      "text": "这篇文章不到两百字，",
      "token_start": 617,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 180240,
      "end_ms": 187055,
      "text": "却是中国文学史上写孤独写的最干净的一篇张岱是在明朝亡了之后，",
      "token_start": 626,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 187620,
      "end_ms": 190070,
      "text": "借着旧日的雪重写，",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 190250,
      "end_ms": 192045,
      "text": "回不去的那个世界。",
      "token_start": 663,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 192810,
      "end_ms": 197175,
      "text": "湖心亭的文人气是孤独到极致，",
      "token_start": 671,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 197670,
      "end_ms": 199615,
      "text": "却又孤独的那么干净。",
      "token_start": 684,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 199950,
      "end_ms": 200570,
      "text": "第二名，",
      "token_start": 693,
      "token_end_exclusive": 696
    },
    {
      "start_ms": 200790,
      "end_ms": 204985,
      "text": "醉翁亭在安徽滁州的狼牙山腰上，",
      "token_start": 696,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 205760,
      "end_ms": 207275,
      "text": "北宋庆历年间，",
      "token_start": 710,
      "token_end_exclusive": 716
    },
    {
      "start_ms": 207770,
      "end_ms": 212655,
      "text": "琅牙寺的和尚特意为欧阳修盖了这座歇山小青瓦亭，",
      "token_start": 716,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 213410,
      "end_ms": 216470,
      "text": "远远看去就像一只展翅的大鸟，",
      "token_start": 738,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 216650,
      "end_ms": 218065,
      "text": "立在泉水边上。",
      "token_start": 751,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 218480,
      "end_ms": 219475,
      "text": "醉翁亭不大，",
      "token_start": 757,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 219990,
      "end_ms": 223310,
      "text": "在山边旁边有古树遮阴，",
      "token_start": 762,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 223610,
      "end_ms": 224905,
      "text": "一进去就凉。",
      "token_start": 772,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 225370,
      "end_ms": 227715,
      "text": "欧阳修在这儿不是一个人喝闷酒，",
      "token_start": 777,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 228270,
      "end_ms": 230175,
      "text": "他是带着老百姓一起来的。",
      "token_start": 791,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 230780,
      "end_ms": 234450,
      "text": "游山宴隐看、射、听音乐，",
      "token_start": 802,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 234810,
      "end_ms": 235575,
      "text": "热热闹闹，",
      "token_start": 811,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 235980,
      "end_ms": 238615,
      "text": "把被贬的日子过成了嘉年华。",
      "token_start": 815,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 239070,
      "end_ms": 241325,
      "text": "这种豁达不是装出来的，",
      "token_start": 827,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 241790,
      "end_ms": 244625,
      "text": "是他真的把与民同乐这四个字落了。",
      "token_start": 837,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 245320,
      "end_ms": 245760,
      "text": "后来，",
      "token_start": 852,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 245760,
      "end_ms": 249360,
      "text": "宋朝文人但凡提到贬官文化必提，",
      "token_start": 854,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 249420,
      "end_ms": 254325,
      "text": "欧阳修必提醉翁亭一篇记一座亭，",
      "token_start": 868,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 254840,
      "end_ms": 259035,
      "text": "让醉翁这两个字从贬义变成了境界。",
      "token_start": 882,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 259650,
      "end_ms": 262805,
      "text": "您说这样的亭子应不应该晋榜？",
      "token_start": 897,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 263200,
      "end_ms": 267200,
      "text": "可就算是醉翁亭在文人气这件事上，",
      "token_start": 910,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 267550,
      "end_ms": 270285,
      "text": "也还有一座亭子排在他前面。",
      "token_start": 925,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 270690,
      "end_ms": 271190,
      "text": "第一名，",
      "token_start": 937,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 271530,
      "end_ms": 275765,
      "text": "兰亭在浙江绍兴的兰竹山脚下，",
      "token_start": 940,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 276560,
      "end_ms": 282655,
      "text": "为什么是他在他面前所有的亭子都只能算后辈？",
      "token_start": 953,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 283090,
      "end_ms": 284970,
      "text": "公元三百五十三年三月初，",
      "token_start": 973,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 284970,
      "end_ms": 287375,
      "text": "三东晋永和九年，",
      "token_start": 984,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 287990,
      "end_ms": 297075,
      "text": "会稽内使王羲之邀集谢安孙绰等四十一位文人名士在兰主山下取水流觞。",
      "token_start": 991,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 297570,
      "end_ms": 298530,
      "text": "饮酒作诗，",
      "token_start": 1022,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 298950,
      "end_ms": 301410,
      "text": "王羲之带着微醺醉意，",
      "token_start": 1026,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 302110,
      "end_ms": 303330,
      "text": "拿起蜀虚笔，",
      "token_start": 1035,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 303370,
      "end_ms": 305770,
      "text": "在残简纸上一气呵成，",
      "token_start": 1040,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 306450,
      "end_ms": 311650,
      "text": "写下了被誉为天下第一行书的兰亭集序。",
      "token_start": 1049,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 312070,
      "end_ms": 313250,
      "text": "两千多年来，",
      "token_start": 1066,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 313630,
      "end_ms": 315350,
      "text": "任凭兵荒马乱，",
      "token_start": 1071,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 315670,
      "end_ms": 320070,
      "text": "朝代更迭多少殿堂楼阁化为灰烬。",
      "token_start": 1077,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 320810,
      "end_ms": 324150,
      "text": "兰亭园址也历经多次迁建，",
      "token_start": 1091,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 324610,
      "end_ms": 326130,
      "text": "可兰亭这两个字，",
      "token_start": 1102,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 326610,
      "end_ms": 334300,
      "text": "早就从从一座具体的江南牧亭化作了全体中国文人心头不灭的图腾。",
      "token_start": 1109,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 334760,
      "end_ms": 337160,
      "text": "您坐在兰亭的鹅池边上，",
      "token_start": 1138,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 337580,
      "end_ms": 339800,
      "text": "看着眼前蜿蜒的溪流，",
      "token_start": 1148,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 340220,
      "end_ms": 342540,
      "text": "听着竹林里的清风细雨。",
      "token_start": 1157,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 342920,
      "end_ms": 348180,
      "text": "当年那群魏晋风流名仕听对生死无常发出的喟叹，",
      "token_start": 1167,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 348500,
      "end_ms": 352240,
      "text": "至今依然顺着流水撞击在您的心口。",
      "token_start": 1188,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 352680,
      "end_ms": 353800,
      "text": "它排在榜首，",
      "token_start": 1203,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 354160,
      "end_ms": 356280,
      "text": "不是因为建筑有多宏伟，",
      "token_start": 1208,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 356280,
      "end_ms": 361185,
      "text": "而是是因为在这座亭子下诞生的风骨与墨香，",
      "token_start": 1218,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 361710,
      "end_ms": 365655,
      "text": "直接定义了中国传统文人的最高精神品格。",
      "token_start": 1237,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 366190,
      "end_ms": 368155,
      "text": "十座名亭全讲完了，",
      "token_start": 1255,
      "token_end_exclusive": 1263
    },
    {
      "start_ms": 368720,
      "end_ms": 371840,
      "text": "真趣亭带着江南的灵动吹台，",
      "token_start": 1263,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 371860,
      "end_ms": 374155,
      "text": "把湖光山色悄悄借走。",
      "token_start": 1275,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 374790,
      "end_ms": 377475,
      "text": "放鹤亭带人逃离官场牢笼。",
      "token_start": 1284,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 377990,
      "end_ms": 380445,
      "text": "丰乐亭装满了天下人的保暖。",
      "token_start": 1295,
      "token_end_exclusive": 1307
    },
    {
      "start_ms": 380930,
      "end_ms": 383635,
      "text": "沧浪亭立着不肯服软的骨气，",
      "token_start": 1307,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 384110,
      "end_ms": 386210,
      "text": "艾婉亭染透了书卷，",
      "token_start": 1319,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 386250,
      "end_ms": 390135,
      "text": "诗意陶然亭盛满了游子的心酸。",
      "token_start": 1327,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 390760,
      "end_ms": 393545,
      "text": "醉翁亭教人看淡人生的起落，",
      "token_start": 1340,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 394000,
      "end_ms": 394720,
      "text": "湖心亭，",
      "token_start": 1352,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 394820,
      "end_ms": 396695,
      "text": "守着血液里的一腔孤傲，",
      "token_start": 1355,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 397140,
      "end_ms": 400385,
      "text": "可只有兰亭不是一个人的故事，",
      "token_start": 1365,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 400850,
      "end_ms": 404225,
      "text": "而是四十一个人共同立下的一块碑。",
      "token_start": 1378,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 404800,
      "end_ms": 406375,
      "text": "他告诉所有文人，",
      "token_start": 1393,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 406730,
      "end_ms": 408455,
      "text": "什么叫真正的惧，",
      "token_start": 1400,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 408910,
      "end_ms": 410355,
      "text": "什么叫真正的雅？",
      "token_start": 1407,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 410870,
      "end_ms": 414845,
      "text": "什么叫把一个好日子过成往后一千年的标准？",
      "token_start": 1414,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 415520,
      "end_ms": 416905,
      "text": "您说什么叫文人气？",
      "token_start": 1433,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 417370,
      "end_ms": 418970,
      "text": "最顶级的文人气，",
      "token_start": 1441,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 419590,
      "end_ms": 421430,
      "text": "从来不是雕梁画栋，",
      "token_start": 1448,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 421610,
      "end_ms": 422810,
      "text": "修的有多气派，",
      "token_start": 1456,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 423510,
      "end_ms": 426150,
      "text": "而是即便肉身化作尘土，",
      "token_start": 1462,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 426570,
      "end_ms": 430410,
      "text": "那股寄情山水、超然物外的精神香火，",
      "token_start": 1472,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 430750,
      "end_ms": 433630,
      "text": "依然能在后人心中代代相传。",
      "token_start": 1487,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 434110,
      "end_ms": 435190,
      "text": "最后问您一句，",
      "token_start": 1499,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 435630,
      "end_ms": 436990,
      "text": "这十座亭子，",
      "token_start": 1505,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 437490,
      "end_ms": 441390,
      "text": "您去过哪几座哪一座最让您记得住，",
      "token_start": 1510,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 441770,
      "end_ms": 445070,
      "text": "想听更多中国古代的山水与文人。",
      "token_start": 1525,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 445370,
      "end_ms": 446150,
      "text": "点个关注，",
      "token_start": 1539,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 446470,
      "end_ms": 448255,
      "text": "咱们下回接着聊。",
      "token_start": 1543,
      "token_end_exclusive": 1550
    }
  ],
