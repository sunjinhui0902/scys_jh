{
  "video_id": "v_0be6e344334f9dd4",
  "duration_s": 514.043991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_0be6e344334f9dd4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_0be6e344334f9dd4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 710,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 930,
      "end_ms": 1730,
      "text": "咱们盘了，",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1730,
      "end_ms": 3150,
      "text": "第十五到第十一，",
      "token_start": 6,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3730,
      "end_ms": 6430,
      "text": "闽越国被汉武帝迁走，",
      "token_start": 13,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 6490,
      "end_ms": 9610,
      "text": "百姓夜郎国留下一个成语，",
      "token_start": 22,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 10090,
      "end_ms": 12770,
      "text": "八国消失在崇山峻岭，",
      "token_start": 33,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 13830,
      "end_ms": 16910,
      "text": "滇国靠金印重新被发现，",
      "token_start": 42,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 17330,
      "end_ms": 21150,
      "text": "齐国靠青铜器铭文证明自己存在过。",
      "token_start": 52,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 21910,
      "end_ms": 24030,
      "text": "好多朋友看完在评论区吵翻了。",
      "token_start": 67,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 24030,
      "end_ms": 28170,
      "text": "有人说曾国呢、中山国呢、西夏呢？",
      "token_start": 80,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 28230,
      "end_ms": 28810,
      "text": "别急，",
      "token_start": 93,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 28830,
      "end_ms": 30000,
      "text": "秦铜。",
      "token_start": 95,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 30060,
      "end_ms": 32920,
      "text": "今天这集就是第十到第六，",
      "token_start": 97,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 33500,
      "end_ms": 35080,
      "text": "一个比一个邪乎。",
      "token_start": 108,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 35720,
      "end_ms": 39260,
      "text": "最后那个史书上连一个字都没写过，",
      "token_start": 115,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 39580,
      "end_ms": 42920,
      "text": "全靠挖出来的东西才知道它存在过。",
      "token_start": 130,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 43000,
      "end_ms": 47220,
      "text": "老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 145,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 47520,
      "end_ms": 49140,
      "text": "让我看看都是谁。",
      "token_start": 162,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 49140,
      "end_ms": 51480,
      "text": "在听第十名，",
      "token_start": 169,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 51600,
      "end_ms": 53860,
      "text": "曾国开个国家，",
      "token_start": 174,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 55360,
      "end_ms": 57340,
      "text": "史书上连一个字都没写过，",
      "token_start": 180,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 57740,
      "end_ms": 58660,
      "text": "左传里没有，",
      "token_start": 191,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 58900,
      "end_ms": 60260,
      "text": "史记里也没有嗯。",
      "token_start": 196,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 60560,
      "end_ms": 61785,
      "text": "直到一九七八年，",
      "token_start": 203,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 62050,
      "end_ms": 65885,
      "text": "湖北随州擂古墩考古队挖开了一座墓，",
      "token_start": 210,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 66410,
      "end_ms": 70235,
      "text": "曾侯乙木一下子惊动了全世界，",
      "token_start": 226,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 70700,
      "end_ms": 72445,
      "text": "出土了一套编钟，",
      "token_start": 239,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 72910,
      "end_ms": 74945,
      "text": "六十五件青铜编钟。",
      "token_start": 246,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 75510,
      "end_ms": 77105,
      "text": "两千四百多年了，",
      "token_start": 254,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 77360,
      "end_ms": 82175,
      "text": "还能演奏音域跨五个半八度十二个半音齐全，",
      "token_start": 261,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 82550,
      "end_ms": 85055,
      "text": "只比现代钢琴少一个八度。",
      "token_start": 280,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 85740,
      "end_ms": 87320,
      "text": "这套编钟一出土，",
      "token_start": 291,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 87540,
      "end_ms": 88715,
      "text": "全世界都傻了，",
      "token_start": 298,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 89370,
      "end_ms": 94560,
      "text": "两千四百年前的中国人是怎么做到可最让人吃惊的？",
      "token_start": 304,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 94560,
      "end_ms": 95435,
      "text": "还不是编钟，",
      "token_start": 326,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 95740,
      "end_ms": 96945,
      "text": "是墓主人的身份。",
      "token_start": 331,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 97980,
      "end_ms": 102125,
      "text": "曾侯乙史书上从来没有记载过叫曾国的国家，",
      "token_start": 338,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 102920,
      "end_ms": 104875,
      "text": "这个曾国是从哪儿冒出来的？",
      "token_start": 357,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 105400,
      "end_ms": 105840,
      "text": "后来，",
      "token_start": 369,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 106020,
      "end_ms": 112795,
      "text": "考古队又挖了叶家山郭家庙文峰塔一系列曾国墓的，",
      "token_start": 371,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 113090,
      "end_ms": 115845,
      "text": "至少发现了十三位曾侯。",
      "token_start": 393,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 116760,
      "end_ms": 119380,
      "text": "一个被史书彻底遗忘的诸侯国，",
      "token_start": 403,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 119560,
      "end_ms": 120705,
      "text": "靠着青铜器，",
      "token_start": 416,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 121470,
      "end_ms": 124605,
      "text": "硬生生把自己从地底下挖了出来。",
      "token_start": 421,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 125750,
      "end_ms": 134375,
      "text": "第九名中商国战国时期有一个国家在燕国和赵国之间，",
      "token_start": 435,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 135810,
      "end_ms": 138185,
      "text": "把这两个大国夹在中间，",
      "token_start": 458,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 138840,
      "end_ms": 140325,
      "text": "居然撑了一百多年。",
      "token_start": 468,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 141170,
      "end_ms": 142255,
      "text": "他就是中山国。",
      "token_start": 476,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 143120,
      "end_ms": 147085,
      "text": "中山国是白帝人见不是华夏族，",
      "token_start": 482,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 147930,
      "end_ms": 149925,
      "text": "所以中原诸侯看不起他，",
      "token_start": 495,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 150890,
      "end_ms": 156575,
      "text": "可中山国偏偏很能打跟燕赵魏齐都交过手。",
      "token_start": 505,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 157350,
      "end_ms": 158865,
      "text": "公元前二百九十六年，",
      "token_start": 523,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 159510,
      "end_ms": 162340,
      "text": "赵武灵王的铁骑灭了中山国，",
      "token_start": 532,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 162720,
      "end_ms": 164995,
      "text": "从此淹没于历史。",
      "token_start": 544,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 165250,
      "end_ms": 170925,
      "text": "中山国的目的在河北平山县考古队挖开以后，",
      "token_start": 551,
      "token_end_exclusive": 570
    },
    {
      "start_ms": 171290,
      "end_ms": 173225,
      "text": "出土了大量精美文物，",
      "token_start": 570,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 173850,
      "end_ms": 175710,
      "text": "有错金银铜板。",
      "token_start": 579,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 175830,
      "end_ms": 179375,
      "text": "赵玉图是中国最早的建筑平面图，",
      "token_start": 585,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 179980,
      "end_ms": 183620,
      "text": "有双翼神兽造型诡异，",
      "token_start": 599,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 184200,
      "end_ms": 186160,
      "text": "有中山王铁足大。",
      "token_start": 608,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 186160,
      "end_ms": 190620,
      "text": "铜鼎明文里记载了中山国的历史，",
      "token_start": 615,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 191420,
      "end_ms": 193500,
      "text": "一个被赵国灭掉的国家，",
      "token_start": 629,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 194400,
      "end_ms": 196060,
      "text": "靠着自己的青铜器，",
      "token_start": 639,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 196560,
      "end_ms": 200060,
      "text": "把自己的故事讲给了两千年后的人听。",
      "token_start": 647,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 201140,
      "end_ms": 201800,
      "text": "第八名，",
      "token_start": 663,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 202800,
      "end_ms": 206720,
      "text": "大理国金庸、天龙八部里，",
      "token_start": 666,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 207960,
      "end_ms": 210810,
      "text": "段誉就是大大理国的王子。",
      "token_start": 676,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 210930,
      "end_ms": 215370,
      "text": "这不是编的历史上真有段誉叫段和誉，",
      "token_start": 687,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 215650,
      "end_ms": 218110,
      "text": "是大理国第十六代帝王。",
      "token_start": 703,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 218470,
      "end_ms": 220270,
      "text": "大理国是白族人建的，",
      "token_start": 713,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 220830,
      "end_ms": 222490,
      "text": "公元九百三十七年，",
      "token_start": 722,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 222530,
      "end_ms": 225290,
      "text": "建国定都扬阁灭城，",
      "token_start": 730,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 225890,
      "end_ms": 227270,
      "text": "就是今天的大理。",
      "token_start": 738,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 227730,
      "end_ms": 230270,
      "text": "大理国大力推行汉族文化，",
      "token_start": 745,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 230570,
      "end_ms": 233730,
      "text": "用汉字尊儒学、崇佛教，",
      "token_start": 756,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 234110,
      "end_ms": 235230,
      "text": "以儒治国，",
      "token_start": 765,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 235510,
      "end_ms": 236310,
      "text": "以佛治。",
      "token_start": 769,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 236310,
      "end_ms": 238470,
      "text": "新经济也很发达，",
      "token_start": 772,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 238670,
      "end_ms": 240905,
      "text": "地广人数、器械精良，",
      "token_start": 779,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 241550,
      "end_ms": 243655,
      "text": "农业水平跟中原差不多。",
      "token_start": 787,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 244070,
      "end_ms": 248305,
      "text": "可这个国家在公元一千二百五十三年被忽必烈灭了，",
      "token_start": 797,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 248500,
      "end_ms": 250335,
      "text": "大理国主断翅投降，",
      "token_start": 819,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 250830,
      "end_ms": 252855,
      "text": "被任命为世袭总管。",
      "token_start": 827,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 253490,
      "end_ms": 256675,
      "text": "原大理官员多受封为云南各地的土司，",
      "token_start": 835,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 257160,
      "end_ms": 258745,
      "text": "一个五百年的佛国，",
      "token_start": 851,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 259090,
      "end_ms": 261335,
      "text": "就这样融入了元朝版图，",
      "token_start": 859,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 262000,
      "end_ms": 263960,
      "text": "大理的壁画和木刻，",
      "token_start": 869,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 264200,
      "end_ms": 265345,
      "text": "现在还有遗存。",
      "token_start": 877,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 265860,
      "end_ms": 270835,
      "text": "昆明古状公园里的石状是大理国石雕仅存的硕果。",
      "token_start": 883,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 272110,
      "end_ms": 272715,
      "text": "第七名，",
      "token_start": 904,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 273030,
      "end_ms": 275975,
      "text": "西夏王朝公元一千零三十八年，",
      "token_start": 907,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 276420,
      "end_ms": 278085,
      "text": "党项人元昊称帝，",
      "token_start": 920,
      "token_end_exclusive": 927
    },
    {
      "start_ms": 278610,
      "end_ms": 279575,
      "text": "建立西夏。",
      "token_start": 927,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 279840,
      "end_ms": 282925,
      "text": "跟北宋辽金打了两百年，",
      "token_start": 931,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 283380,
      "end_ms": 285765,
      "text": "西夏有自己的文字西夏文，",
      "token_start": 941,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 286100,
      "end_ms": 288440,
      "text": "有自己完整的典章制度，",
      "token_start": 952,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 288640,
      "end_ms": 292400,
      "text": "有自己的帝陵九座地顶二百多座，",
      "token_start": 962,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 292400,
      "end_ms": 294925,
      "text": "陪葬墓在贺兰山下排开，",
      "token_start": 976,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 295730,
      "end_ms": 299240,
      "text": "规模一点不比中原王朝差可。",
      "token_start": 986,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 299240,
      "end_ms": 301045,
      "text": "公元一千二百二十七年，",
      "token_start": 998,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 301830,
      "end_ms": 304215,
      "text": "成吉思汗的铁骑灭了西夏。",
      "token_start": 1008,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 305130,
      "end_ms": 306970,
      "text": "蒙古军队占领西夏后，",
      "token_start": 1019,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 307170,
      "end_ms": 309970,
      "text": "进行了残酷的屠戮和焚烧，",
      "token_start": 1028,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 310750,
      "end_ms": 313430,
      "text": "城内十几万党项人全部被杀，",
      "token_start": 1039,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 313890,
      "end_ms": 316550,
      "text": "西夏从此灰飞烟灭。",
      "token_start": 1051,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 317510,
      "end_ms": 318950,
      "text": "元朝修史的时候，",
      "token_start": 1059,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 319330,
      "end_ms": 320850,
      "text": "辽史有金史，",
      "token_start": 1066,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 320850,
      "end_ms": 322050,
      "text": "有宋史有，",
      "token_start": 1071,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 322410,
      "end_ms": 324450,
      "text": "唯独没有西夏的砖史。",
      "token_start": 1075,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 324690,
      "end_ms": 327370,
      "text": "一个存在了近两百年的王朝，",
      "token_start": 1084,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 327850,
      "end_ms": 330070,
      "text": "被从历史记忆里抹掉了。",
      "token_start": 1096,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 330710,
      "end_ms": 337040,
      "text": "直到清朝学者张铎在甘肃武威发现了一块西夏文石碑，",
      "token_start": 1106,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 337860,
      "end_ms": 341720,
      "text": "这个消失的王朝才重新回到人们的视野。",
      "token_start": 1129,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 342140,
      "end_ms": 348420,
      "text": "上世纪俄国探险家在黑水城遗址挖出了八千多号西夏文献，",
      "token_start": 1146,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 348860,
      "end_ms": 353260,
      "text": "跟殷墟、甲骨文、居延汉简敦煌遗书，",
      "token_start": 1171,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 353300,
      "end_ms": 356300,
      "text": "并称二十世纪初重大考古发现，",
      "token_start": 1185,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 356860,
      "end_ms": 357560,
      "text": "第六名，",
      "token_start": 1198,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 357960,
      "end_ms": 358760,
      "text": "古蜀国。",
      "token_start": 1201,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 359320,
      "end_ms": 363980,
      "text": "李白写过蚕虫及鱼廓开国何茫然，",
      "token_start": 1204,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 364140,
      "end_ms": 367125,
      "text": "古蜀国的一历史比李白还茫然。",
      "token_start": 1218,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 368090,
      "end_ms": 371335,
      "text": "这个国家在四川盆地存在了一千五百多年，",
      "token_start": 1231,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 371960,
      "end_ms": 375565,
      "text": "从新石器时代晚期一直到商末周初，",
      "token_start": 1249,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 376370,
      "end_ms": 378245,
      "text": "可他就像出现的时候一样，",
      "token_start": 1264,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 378730,
      "end_ms": 379870,
      "text": "突然的消失了。",
      "token_start": 1275,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 379890,
      "end_ms": 380845,
      "text": "一九八六年，",
      "token_start": 1281,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 381170,
      "end_ms": 383895,
      "text": "三星堆两个祭祀坑被发现，",
      "token_start": 1286,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 384790,
      "end_ms": 386550,
      "text": "上千件稀世珍宝，",
      "token_start": 1297,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 386550,
      "end_ms": 389045,
      "text": "出土青铜神术，",
      "token_start": 1304,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 389760,
      "end_ms": 393825,
      "text": "青铜大力人纵木面具、黄金权杖。",
      "token_start": 1310,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 394280,
      "end_ms": 396335,
      "text": "每一件都在告诉世界，",
      "token_start": 1323,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 397280,
      "end_ms": 399935,
      "text": "这里曾经有一个高度发达的文明，",
      "token_start": 1332,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 400540,
      "end_ms": 403115,
      "text": "可这个文明为什么会突然消失？",
      "token_start": 1346,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 403390,
      "end_ms": 407405,
      "text": "水患说、战争说、瘟疫说、迁都说，",
      "token_start": 1359,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 407770,
      "end_ms": 409605,
      "text": "每一种说法都有道理，",
      "token_start": 1371,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 410050,
      "end_ms": 412115,
      "text": "每一种说法都证据不足。",
      "token_start": 1380,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 412970,
      "end_ms": 414530,
      "text": "最新的考古发现，",
      "token_start": 1390,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 414810,
      "end_ms": 419165,
      "text": "三星堆和金沙遗址的年代是紧密衔接的。",
      "token_start": 1397,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 419780,
      "end_ms": 420780,
      "text": "有学者认为，",
      "token_start": 1414,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 421020,
      "end_ms": 425125,
      "text": "三星堆的政治中心转移到了成都金沙，",
      "token_start": 1419,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 425870,
      "end_ms": 428215,
      "text": "可到底是迁都还是灭亡，",
      "token_start": 1435,
      "token_end_exclusive": 1445
    },
    {
      "start_ms": 428590,
      "end_ms": 430545,
      "text": "到现在也没个定论。",
      "token_start": 1445,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 431090,
      "end_ms": 433955,
      "text": "一个出土了这么多经世文物的文明，",
      "token_start": 1453,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 434520,
      "end_ms": 436765,
      "text": "我们连他叫什么名字都不知道。",
      "token_start": 1468,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 437270,
      "end_ms": 439185,
      "text": "从第十到第六，",
      "token_start": 1481,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 440210,
      "end_ms": 442855,
      "text": "曾国靠编钟把自己挖了出来。",
      "token_start": 1487,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 443030,
      "end_ms": 446555,
      "text": "中山国靠青铜器讲出了自己的故事，",
      "token_start": 1499,
      "token_end_exclusive": 1514
    },
    {
      "start_ms": 447460,
      "end_ms": 450125,
      "text": "大理国融进了元朝版图，",
      "token_start": 1514,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 450960,
      "end_ms": 453035,
      "text": "西夏被从史书里抹掉了。",
      "token_start": 1524,
      "token_end_exclusive": 1534
    },
    {
      "start_ms": 453820,
      "end_ms": 457125,
      "text": "古蜀国连自己叫什么名字都没留下，",
      "token_start": 1534,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 457670,
      "end_ms": 461435,
      "text": "可这五个还不是最邪乎的。",
      "token_start": 1549,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 461760,
      "end_ms": 463625,
      "text": "接下来第五道第一，",
      "token_start": 1560,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 464620,
      "end_ms": 466305,
      "text": "一个比一个震撼，",
      "token_start": 1568,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 467340,
      "end_ms": 469645,
      "text": "有一座三千人的小国，",
      "token_start": 1575,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 470150,
      "end_ms": 473935,
      "text": "留下一封求救信人没了。",
      "token_start": 1584,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 474230,
      "end_ms": 476825,
      "text": "有一座丝绸之路上的明珠，",
      "token_start": 1594,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 477380,
      "end_ms": 479315,
      "text": "被黄沙整个吞掉。",
      "token_start": 1605,
      "token_end_exclusive": 1612
    },
    {
      "start_ms": 479770,
      "end_ms": 481915,
      "text": "还有一座五千年的古城，",
      "token_start": 1612,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 482530,
      "end_ms": 483685,
      "text": "比夏朝还早。",
      "token_start": 1622,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 484030,
      "end_ms": 487005,
      "text": "有宫殿、有水坝、有玉器，",
      "token_start": 1627,
      "token_end_exclusive": 1636
    },
    {
      "start_ms": 488090,
      "end_ms": 490045,
      "text": "可他不在任何史书里，",
      "token_start": 1636,
      "token_end_exclusive": 1645
    },
    {
      "start_ms": 490900,
      "end_ms": 492785,
      "text": "司马迁都不知道他存在。",
      "token_start": 1645,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 493780,
      "end_ms": 495940,
      "text": "更有一个国家消失了，",
      "token_start": 1655,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 495940,
      "end_ms": 499355,
      "text": "三千年史书上就留了一句话，",
      "token_start": 1664,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 500230,
      "end_ms": 504045,
      "text": "全靠挖出来的青铜器才把他找回来。",
      "token_start": 1676,
      "token_end_exclusive": 1691
    },
    {
      "start_ms": 504610,
      "end_ms": 505285,
      "text": "他是谁？",
      "token_start": 1691,
      "token_end_exclusive": 1694
    },
    {
      "start_ms": 505620,
      "end_ms": 508565,
      "text": "他凭什么排第一下集马上更新，",
      "token_start": 1694,
      "token_end_exclusive": 1707
    },
    {
      "start_ms": 508950,
      "end_ms": 512535,
      "text": "您先点个关注点开头像别走丢。",
      "token_start": 1707,
      "token_end_exclusive": 1720
    }
  ],
