{
  "video_id": "v_b0c1a76023be08b1",
  "duration_s": 665.019002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b0c1a76023be08b1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b0c1a76023be08b1.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 350,
      "end_ms": 4530,
      "text": "您知道中国最绝美的秋日古村落是哪一个吗？",
      "token_start": 0,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 5350,
      "end_ms": 5970,
      "text": "上集，",
      "token_start": 19,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5990,
      "end_ms": 14230,
      "text": "咱们聊了指南村塔川赵兴洞寨大池村洪村这集直接揭开谜底，",
      "token_start": 21,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 14530,
      "end_ms": 16970,
      "text": "看看前五名绝美到什么程度。",
      "token_start": 47,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 17330,
      "end_ms": 21910,
      "text": "尤其是排在榜首的那座连绵的石头，",
      "token_start": 59,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 21910,
      "end_ms": 25470,
      "text": "雕楼依着万仞绝壁拔地而起。",
      "token_start": 74,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 25950,
      "end_ms": 32200,
      "text": "深秋漫山彩林与冰川雪峰在同第一个画面里同框绽放。",
      "token_start": 86,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 32640,
      "end_ms": 33400,
      "text": "话不多说，",
      "token_start": 109,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 33800,
      "end_ms": 35200,
      "text": "茶给您沏好了，",
      "token_start": 113,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 35600,
      "end_ms": 38000,
      "text": "劳烦您顺手点个小红心，",
      "token_start": 119,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 38360,
      "end_ms": 39500,
      "text": "咱们这就开讲。",
      "token_start": 129,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 39860,
      "end_ms": 40520,
      "text": "第五名，",
      "token_start": 135,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 40940,
      "end_ms": 46440,
      "text": "阿者柯村云南元阳从藏在哀牢山深处，",
      "token_start": 138,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 47140,
      "end_ms": 50700,
      "text": "是哈尼梯田核心区里的一座老村子。",
      "token_start": 154,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 51100,
      "end_ms": 52080,
      "text": "山有多高，",
      "token_start": 169,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 52620,
      "end_ms": 53680,
      "text": "田就有多高，",
      "token_start": 173,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 54360,
      "end_ms": 56560,
      "text": "从山脚一层一层盘上来，",
      "token_start": 178,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 56820,
      "end_ms": 58180,
      "text": "能数出几千级。",
      "token_start": 188,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 58840,
      "end_ms": 59500,
      "text": "哈尼人。",
      "token_start": 194,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 59500,
      "end_ms": 62585,
      "text": "在这片山里种了一千多年的稻子，",
      "token_start": 197,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 63310,
      "end_ms": 64385,
      "text": "二零一三年，",
      "token_start": 211,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 64860,
      "end_ms": 67975,
      "text": "这片梯田成了世界文化遗产，",
      "token_start": 216,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 68370,
      "end_ms": 70035,
      "text": "村里的房子是土墙，",
      "token_start": 228,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 70630,
      "end_ms": 71415,
      "text": "茅草顶，",
      "token_start": 236,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 72050,
      "end_ms": 73055,
      "text": "圆圆的屋顶，",
      "token_start": 239,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 73600,
      "end_ms": 77975,
      "text": "像一朵朵蘑菇趴在梯田中间到了秋天，",
      "token_start": 244,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 78370,
      "end_ms": 79225,
      "text": "稻谷黄了，",
      "token_start": 260,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 79700,
      "end_ms": 83335,
      "text": "几千级梯田一级一级全被染成金色。",
      "token_start": 264,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 84100,
      "end_ms": 84600,
      "text": "清晨，",
      "token_start": 279,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 84600,
      "end_ms": 85885,
      "text": "云海漫上来，",
      "token_start": 281,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 86210,
      "end_ms": 87590,
      "text": "把整座山都淹了。",
      "token_start": 286,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 88140,
      "end_ms": 90205,
      "text": "今天在云里时隐时现，",
      "token_start": 293,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 90720,
      "end_ms": 91925,
      "text": "这样的景象，",
      "token_start": 302,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 92350,
      "end_ms": 93895,
      "text": "不是谁设计出来的，",
      "token_start": 307,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 94260,
      "end_ms": 98355,
      "text": "是一代又一代人拿一辈子的汗水累出来的。",
      "token_start": 315,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 98800,
      "end_ms": 102765,
      "text": "您说这算不算大地写给人的一封情书？",
      "token_start": 333,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 103200,
      "end_ms": 104045,
      "text": "第四名，",
      "token_start": 349,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 104700,
      "end_ms": 105745,
      "text": "士林村，",
      "token_start": 352,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 106330,
      "end_ms": 107435,
      "text": "浙江余姚。",
      "token_start": 355,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 108220,
      "end_ms": 114515,
      "text": "他在四明山深处是一座靠古世数出名的浙东老村，",
      "token_start": 359,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 115390,
      "end_ms": 119025,
      "text": "全村有几百棵古市树最老的，",
      "token_start": 380,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 119350,
      "end_ms": 122135,
      "text": "据说有六百来年深秋一到，",
      "token_start": 392,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 122550,
      "end_ms": 124225,
      "text": "树叶落得差不多了，",
      "token_start": 403,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 124780,
      "end_ms": 132005,
      "text": "枝头却挂满了红彤彤的柿子一竖一竖像点的一盏盏红灯笼，",
      "token_start": 411,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 132880,
      "end_ms": 135705,
      "text": "青蛙十强、石板路，",
      "token_start": 436,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 136090,
      "end_ms": 142570,
      "text": "全被映的暖烘烘的村里人摘柿子晒柿饼、屋檐下，",
      "token_start": 443,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 142590,
      "end_ms": 144665,
      "text": "一串串挂的满满当当，",
      "token_start": 463,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 145160,
      "end_ms": 147435,
      "text": "日子过得又忙又踏实。",
      "token_start": 472,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 148090,
      "end_ms": 150575,
      "text": "世子在老话里还有个好彩头，",
      "token_start": 481,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 150970,
      "end_ms": 152475,
      "text": "叫事事如意。",
      "token_start": 493,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 152860,
      "end_ms": 153715,
      "text": "几百年了，",
      "token_start": 498,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 154320,
      "end_ms": 155865,
      "text": "老树年年挂果，",
      "token_start": 502,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 156360,
      "end_ms": 159625,
      "text": "村里的日子也跟着一年一年过下去。",
      "token_start": 508,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 160230,
      "end_ms": 161910,
      "text": "这样的秋天不惊艳，",
      "token_start": 523,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 162250,
      "end_ms": 164685,
      "text": "却一下子让人心里踏实了。",
      "token_start": 531,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 165350,
      "end_ms": 167945,
      "text": "您说这是不是最接地气的美？",
      "token_start": 542,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 168360,
      "end_ms": 169100,
      "text": "第三名，",
      "token_start": 554,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 169400,
      "end_ms": 175045,
      "text": "白哈巴村新疆阿勒泰走到祖国西北边陲的尽头。",
      "token_start": 557,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 175580,
      "end_ms": 184285,
      "text": "这处村落被誉为西北第一村一百多户图瓦人聚居的原始村落静静卧在阿尔泰山深处，",
      "token_start": 577,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 184770,
      "end_ms": 188415,
      "text": "被上万亩金黄的白桦林海温柔环抱，",
      "token_start": 613,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 188760,
      "end_ms": 191085,
      "text": "与邻国边境隔阂相望，",
      "token_start": 628,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 191570,
      "end_ms": 193905,
      "text": "图瓦人在这里世代以游牧为生，",
      "token_start": 637,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 194330,
      "end_ms": 195770,
      "text": "就地采伐阿尔泰。",
      "token_start": 650,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 195770,
      "end_ms": 201845,
      "text": "松木用粗立圆木垒砌出一件间尖顶木刻楞小木屋，",
      "token_start": 657,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 202450,
      "end_ms": 205355,
      "text": "千百年来与雪山长相厮守。",
      "token_start": 678,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 205790,
      "end_ms": 206745,
      "text": "九月深秋，",
      "token_start": 689,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 207130,
      "end_ms": 211925,
      "text": "白桦林一夜染尽纯金阿尔泰山初雪封顶。",
      "token_start": 693,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 212690,
      "end_ms": 213790,
      "text": "银白雪峰下，",
      "token_start": 710,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 213990,
      "end_ms": 216385,
      "text": "是一望无际的灿烂林海。",
      "token_start": 715,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 216890,
      "end_ms": 217370,
      "text": "清晨，",
      "token_start": 725,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 217490,
      "end_ms": 220065,
      "text": "木屋屋顶飘起淡蓝炊烟，",
      "token_start": 727,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 220680,
      "end_ms": 223545,
      "text": "牛羊慢悠悠穿过金黄草甸，",
      "token_start": 737,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 224040,
      "end_ms": 225975,
      "text": "那种辽阔与沉静，",
      "token_start": 748,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 226450,
      "end_ms": 230225,
      "text": "美的像一幅洗尽尘俗的旷远油画。",
      "token_start": 755,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 230850,
      "end_ms": 233965,
      "text": "您说这是不是最干净的一种美？",
      "token_start": 769,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 234330,
      "end_ms": 235025,
      "text": "第二名，",
      "token_start": 782,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 235500,
      "end_ms": 236075,
      "text": "黄陵，",
      "token_start": 785,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 236560,
      "end_ms": 237685,
      "text": "江西婺源，",
      "token_start": 787,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 238490,
      "end_ms": 241505,
      "text": "很多观众心中的秋日第一名，",
      "token_start": 791,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 242090,
      "end_ms": 245465,
      "text": "一定是这座名满天下的挂榜山村。",
      "token_start": 803,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 245990,
      "end_ms": 247765,
      "text": "他是徽派古村，",
      "token_start": 817,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 248360,
      "end_ms": 251715,
      "text": "整座村子贴的山坡盖儿层层叠叠，",
      "token_start": 823,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 252120,
      "end_ms": 254345,
      "text": "像是挂在山腰上的一幅画。",
      "token_start": 837,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 254900,
      "end_ms": 256175,
      "text": "山里缺平地，",
      "token_start": 848,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 256620,
      "end_ms": 258095,
      "text": "晒谷子摊不开，",
      "token_start": 853,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 258480,
      "end_ms": 261965,
      "text": "村里人就想了个办法晒到屋顶上去。",
      "token_start": 859,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 262360,
      "end_ms": 263305,
      "text": "每年深秋，",
      "token_start": 874,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 263770,
      "end_ms": 268760,
      "text": "家家户户把辣椒、玉米、稻谷、南瓜、菊花摆进，",
      "token_start": 878,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 268880,
      "end_ms": 271200,
      "text": "圆圆的竹扁搁在屋顶。",
      "token_start": 895,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 271440,
      "end_ms": 277600,
      "text": "窗台和晒架上红的、黄的、橙的在粉墙黛瓦之间铺开，",
      "token_start": 904,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 277900,
      "end_ms": 280065,
      "text": "背后是一山秋色。",
      "token_start": 925,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 280510,
      "end_ms": 283795,
      "text": "这个习俗有个专门的名字叫晒秋，",
      "token_start": 932,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 284740,
      "end_ms": 285925,
      "text": "晒了几百年。",
      "token_start": 946,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 286440,
      "end_ms": 287035,
      "text": "如今，",
      "token_start": 951,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 287460,
      "end_ms": 290905,
      "text": "他成了全中国人已想到秋天丰收，",
      "token_start": 953,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 291500,
      "end_ms": 294065,
      "text": "脑子里马上冒出来的那幅画。",
      "token_start": 967,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 294530,
      "end_ms": 295675,
      "text": "他不只是好看，",
      "token_start": 979,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 296450,
      "end_ms": 298485,
      "text": "更让人想起老家的屋顶，",
      "token_start": 985,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 299200,
      "end_ms": 300935,
      "text": "想起小时候的秋天。",
      "token_start": 995,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 301590,
      "end_ms": 303430,
      "text": "您说这样的美，",
      "token_start": 1003,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 303890,
      "end_ms": 305350,
      "text": "谁心里没有一份？",
      "token_start": 1009,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 305750,
      "end_ms": 307630,
      "text": "那第一名到底是哪儿？",
      "token_start": 1016,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 307910,
      "end_ms": 308590,
      "text": "先别急，",
      "token_start": 1025,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 308970,
      "end_ms": 309770,
      "text": "聊到这儿，",
      "token_start": 1028,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 309950,
      "end_ms": 311630,
      "text": "我先唠几句心里话，",
      "token_start": 1032,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 312110,
      "end_ms": 316110,
      "text": "盘完这九处留言区有个事特别一致。",
      "token_start": 1040,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 316730,
      "end_ms": 318510,
      "text": "好多朋友说年轻时候忙，",
      "token_start": 1055,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 318870,
      "end_ms": 319890,
      "text": "没空出门，",
      "token_start": 1065,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 320630,
      "end_ms": 323710,
      "text": "好多退休有空了想去走走，",
      "token_start": 1069,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 324270,
      "end_ms": 326410,
      "text": "可不知道先去哪儿去了。",
      "token_start": 1080,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 326410,
      "end_ms": 328870,
      "text": "看什么高海拔的地方，",
      "token_start": 1090,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 329330,
      "end_ms": 330370,
      "text": "太冷的地方，",
      "token_start": 1099,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 330730,
      "end_ms": 332060,
      "text": "身子去不了，",
      "token_start": 1104,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 332440,
      "end_ms": 334340,
      "text": "有没有不用跑那么远，",
      "token_start": 1109,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 334720,
      "end_ms": 336620,
      "text": "也能看明明白的。",
      "token_start": 1118,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 336620,
      "end_ms": 339740,
      "text": "还有带孙孙孙女的更愁。",
      "token_start": 1125,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 339740,
      "end_ms": 344060,
      "text": "孩子问咱这村子为什么叫这个名字？",
      "token_start": 1135,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 344060,
      "end_ms": 344660,
      "text": "老魏人，",
      "token_start": 1150,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 344660,
      "end_ms": 346640,
      "text": "当初为什么把房子盖成，",
      "token_start": 1153,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 346640,
      "end_ms": 350000,
      "text": "这样可自己也说不全。",
      "token_start": 1163,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 350000,
      "end_ms": 352300,
      "text": "您看咱们这个年纪看景，",
      "token_start": 1172,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 352380,
      "end_ms": 353800,
      "text": "不光是图个热闹，",
      "token_start": 1182,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 354220,
      "end_ms": 357280,
      "text": "更想知道这些老村子是怎么来的。",
      "token_start": 1189,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 357880,
      "end_ms": 360080,
      "text": "当初为什么选在这儿安家，",
      "token_start": 1203,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 360460,
      "end_ms": 364430,
      "text": "可这些东东西在手机上划完就忘上网，",
      "token_start": 1214,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 364450,
      "end_ms": 367250,
      "text": "查一堆乱七八糟的翻大布头，",
      "token_start": 1230,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 367430,
      "end_ms": 368855,
      "text": "又看的眼睛疼。",
      "token_start": 1242,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 369200,
      "end_ms": 371125,
      "text": "前阵子我翻到一本书，",
      "token_start": 1248,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 371800,
      "end_ms": 373215,
      "text": "正好解决这个问题，",
      "token_start": 1257,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 373720,
      "end_ms": 378485,
      "text": "叫大美中国人一生要去的一百零一个地方。",
      "token_start": 1265,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 378940,
      "end_ms": 383335,
      "text": "他把全中国最值得去的一百零一个地方挑出来，",
      "token_start": 1283,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 383840,
      "end_ms": 386615,
      "text": "分成五块自然奇观，",
      "token_start": 1303,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 387060,
      "end_ms": 390510,
      "text": "文明印记、烟火、人间秘境，",
      "token_start": 1311,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 390510,
      "end_ms": 391125,
      "text": "寻踪，",
      "token_start": 1321,
      "token_end_exclusive": 1323
    },
    {
      "start_ms": 391520,
      "end_ms": 392485,
      "text": "人间天堂。",
      "token_start": 1323,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 392880,
      "end_ms": 395735,
      "text": "咱们今天聊的这些自然也都在里头，",
      "token_start": 1327,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 396230,
      "end_ms": 398250,
      "text": "这些村子当初是怎么选？",
      "token_start": 1342,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 398250,
      "end_ms": 400810,
      "text": "在这儿的房子为什么盖成？",
      "token_start": 1352,
      "token_end_exclusive": 1363
    },
    {
      "start_ms": 400810,
      "end_ms": 407040,
      "text": "这样背后藏着什么讲究什么季节去最值去了，",
      "token_start": 1363,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 407040,
      "end_ms": 409530,
      "text": "该看哪几处几分钟，",
      "token_start": 1382,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 409530,
      "end_ms": 411515,
      "text": "一个地方讲的明明白白，",
      "token_start": 1390,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 411910,
      "end_ms": 413305,
      "text": "图印的特别漂亮。",
      "token_start": 1400,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 413970,
      "end_ms": 416165,
      "text": "一页翻开就是一幅画，",
      "token_start": 1407,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 416600,
      "end_ms": 417985,
      "text": "我自己是这么用的，",
      "token_start": 1416,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 418290,
      "end_ms": 421380,
      "text": "能去的地方出门前翻一翻到了地方，",
      "token_start": 1424,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 421380,
      "end_ms": 422155,
      "text": "心里有底，",
      "token_start": 1439,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 422660,
      "end_ms": 425235,
      "text": "看的就不只是一座座老房子，",
      "token_start": 1443,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 425540,
      "end_ms": 429685,
      "text": "而是老房子背后的蒋究就暂时去不了的，",
      "token_start": 1455,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 429960,
      "end_ms": 431140,
      "text": "就着图文慢慢看，",
      "token_start": 1472,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 431440,
      "end_ms": 432465,
      "text": "也算去过了。",
      "token_start": 1479,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 433090,
      "end_ms": 434215,
      "text": "摆在茶几上，",
      "token_start": 1484,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 434670,
      "end_ms": 435490,
      "text": "孙辈来了，",
      "token_start": 1489,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 435490,
      "end_ms": 436245,
      "text": "翻两页，",
      "token_start": 1493,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 436630,
      "end_ms": 437650,
      "text": "长见识不说，",
      "token_start": 1496,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 438070,
      "end_ms": 440245,
      "text": "写作文也正好用得上。",
      "token_start": 1501,
      "token_end_exclusive": 1510
    },
    {
      "start_ms": 440720,
      "end_ms": 444435,
      "text": "老两口晚上翻番商量明年去哪儿，",
      "token_start": 1510,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 444830,
      "end_ms": 446795,
      "text": "比刷手机舒坦多了，",
      "token_start": 1524,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 447450,
      "end_ms": 449985,
      "text": "房子会旧积蓄会花完。",
      "token_start": 1532,
      "token_end_exclusive": 1541
    },
    {
      "start_ms": 450720,
      "end_ms": 456755,
      "text": "可这些老祖宗留下来的文化根脉传几辈人都贬不了职，",
      "token_start": 1541,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 457240,
      "end_ms": 459740,
      "text": "趁现在还能买到给自己，",
      "token_start": 1564,
      "token_end_exclusive": 1574
    },
    {
      "start_ms": 459800,
      "end_ms": 462380,
      "text": "也给下一代备一份书。",
      "token_start": 1574,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 462780,
      "end_ms": 464825,
      "text": "就在左下角的商品里，",
      "token_start": 1583,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 465650,
      "end_ms": 467865,
      "text": "感兴趣的老朋友点进去看看，",
      "token_start": 1592,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 468340,
      "end_ms": 469675,
      "text": "人暂时走不出去，",
      "token_start": 1604,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 470160,
      "end_ms": 472335,
      "text": "咱先把大好河山装进屋里，",
      "token_start": 1611,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 472760,
      "end_ms": 474415,
      "text": "好说回正题，",
      "token_start": 1622,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 475170,
      "end_ms": 475835,
      "text": "第一名，",
      "token_start": 1627,
      "token_end_exclusive": 1630
    },
    {
      "start_ms": 476230,
      "end_ms": 479675,
      "text": "四川丹巴甲居藏寨为什么是他？",
      "token_start": 1630,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 480490,
      "end_ms": 481885,
      "text": "前面九个村子？",
      "token_start": 1643,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 482220,
      "end_ms": 483845,
      "text": "美的是一树红叶，",
      "token_start": 1649,
      "token_end_exclusive": 1656
    },
    {
      "start_ms": 484220,
      "end_ms": 485195,
      "text": "一池清水，",
      "token_start": 1656,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 485530,
      "end_ms": 486675,
      "text": "一片梯田，",
      "token_start": 1660,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 487230,
      "end_ms": 489465,
      "text": "可他美的是一整座山谷，",
      "token_start": 1664,
      "token_end_exclusive": 1674
    },
    {
      "start_ms": 490200,
      "end_ms": 495785,
      "text": "贾居藏寨在大渡河谷的山坡上加戎藏族人，",
      "token_start": 1674,
      "token_end_exclusive": 1692
    },
    {
      "start_ms": 496140,
      "end_ms": 499530,
      "text": "几百年来就这么住着房子，",
      "token_start": 1692,
      "token_end_exclusive": 1703
    },
    {
      "start_ms": 499670,
      "end_ms": 504275,
      "text": "一座接着一座顺着山势从河谷往上落，",
      "token_start": 1703,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 504740,
      "end_ms": 509495,
      "text": "红的、白的、黄的强色一层压着一层，",
      "token_start": 1719,
      "token_end_exclusive": 1733
    },
    {
      "start_ms": 509930,
      "end_ms": 511495,
      "text": "一直扑到雪山脚下，",
      "token_start": 1733,
      "token_end_exclusive": 1741
    },
    {
      "start_ms": 512150,
      "end_ms": 514775,
      "text": "房子都是石头垒的三层楼，",
      "token_start": 1741,
      "token_end_exclusive": 1752
    },
    {
      "start_ms": 515280,
      "end_ms": 519295,
      "text": "底层养生寇中间住人顶上晒粮食，",
      "token_start": 1752,
      "token_end_exclusive": 1766
    },
    {
      "start_ms": 519620,
      "end_ms": 523725,
      "text": "供神屋顶四个角各供着一块白石头。",
      "token_start": 1766,
      "token_end_exclusive": 1781
    },
    {
      "start_ms": 524150,
      "end_ms": 526965,
      "text": "丹巴还有个名号叫千雕之国，",
      "token_start": 1781,
      "token_end_exclusive": 1793
    },
    {
      "start_ms": 527740,
      "end_ms": 531220,
      "text": "山谷里至今立着不少骨雕像，",
      "token_start": 1793,
      "token_end_exclusive": 1805
    },
    {
      "start_ms": 531280,
      "end_ms": 533735,
      "text": "是替这片山谷站岗的老人。",
      "token_start": 1805,
      "token_end_exclusive": 1816
    },
    {
      "start_ms": 534290,
      "end_ms": 535195,
      "text": "到了深秋，",
      "token_start": 1816,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 535570,
      "end_ms": 536575,
      "text": "推开院门，",
      "token_start": 1820,
      "token_end_exclusive": 1824
    },
    {
      "start_ms": 537190,
      "end_ms": 540290,
      "text": "脚下是深谷谷底的果树，",
      "token_start": 1824,
      "token_end_exclusive": 1834
    },
    {
      "start_ms": 540370,
      "end_ms": 540925,
      "text": "黄了，",
      "token_start": 1834,
      "token_end_exclusive": 1836
    },
    {
      "start_ms": 541420,
      "end_ms": 543060,
      "text": "山腰的树林红了。",
      "token_start": 1836,
      "token_end_exclusive": 1843
    },
    {
      "start_ms": 543480,
      "end_ms": 546520,
      "text": "再往上是终年不化的雪峰，",
      "token_start": 1843,
      "token_end_exclusive": 1854
    },
    {
      "start_ms": 547180,
      "end_ms": 548440,
      "text": "抬头是秋天，",
      "token_start": 1854,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 549100,
      "end_ms": 550720,
      "text": "再抬头还是秋天，",
      "token_start": 1859,
      "token_end_exclusive": 1866
    },
    {
      "start_ms": 551280,
      "end_ms": 554200,
      "text": "最后一抬头已经是冬天了。",
      "token_start": 1866,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 554800,
      "end_ms": 557420,
      "text": "可面比的是哪一片秋色更好看。",
      "token_start": 1877,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 557900,
      "end_ms": 558980,
      "text": "可它比的是，",
      "token_start": 1890,
      "token_end_exclusive": 1895
    },
    {
      "start_ms": 559320,
      "end_ms": 560420,
      "text": "一座村子，",
      "token_start": 1895,
      "token_end_exclusive": 1899
    },
    {
      "start_ms": 560740,
      "end_ms": 570280,
      "text": "能不能把山和树房子白雪四季全装进同一面山坡里修，",
      "token_start": 1899,
      "token_end_exclusive": 1922
    },
    {
      "start_ms": 570380,
      "end_ms": 572050,
      "text": "他的人只想有个家。",
      "token_start": 1922,
      "token_end_exclusive": 1930
    },
    {
      "start_ms": 572790,
      "end_ms": 573950,
      "text": "可几百年后，",
      "token_start": 1930,
      "token_end_exclusive": 1935
    },
    {
      "start_ms": 574430,
      "end_ms": 579810,
      "text": "这个家把秋天盖成了一座立着的城十座古村落。",
      "token_start": 1935,
      "token_end_exclusive": 1955
    },
    {
      "start_ms": 579830,
      "end_ms": 581310,
      "text": "讲完了指南，",
      "token_start": 1955,
      "token_end_exclusive": 1960
    },
    {
      "start_ms": 581310,
      "end_ms": 584490,
      "text": "村把银杏和枫叶铺满了石板路，",
      "token_start": 1960,
      "token_end_exclusive": 1973
    },
    {
      "start_ms": 584950,
      "end_ms": 588070,
      "text": "塔川把整座山染成了调色盘。",
      "token_start": 1973,
      "token_end_exclusive": 1985
    },
    {
      "start_ms": 588690,
      "end_ms": 592090,
      "text": "赵兴洞寨的道浪涌到了古楼脚下，",
      "token_start": 1985,
      "token_end_exclusive": 1999
    },
    {
      "start_ms": 592590,
      "end_ms": 597350,
      "text": "太行山大渠村的红饰挂上了石崖洪村，",
      "token_start": 1999,
      "token_end_exclusive": 2015
    },
    {
      "start_ms": 597390,
      "end_ms": 600110,
      "text": "把秋天养进了一池水里，",
      "token_start": 2015,
      "token_end_exclusive": 2025
    },
    {
      "start_ms": 600470,
      "end_ms": 603805,
      "text": "把这棵把梯田铺了几千级。",
      "token_start": 2025,
      "token_end_exclusive": 2036
    },
    {
      "start_ms": 604390,
      "end_ms": 607110,
      "text": "士林村的老树点起了红灯笼，",
      "token_start": 2036,
      "token_end_exclusive": 2048
    },
    {
      "start_ms": 607570,
      "end_ms": 609090,
      "text": "白哈巴的白桦林，",
      "token_start": 2048,
      "token_end_exclusive": 2055
    },
    {
      "start_ms": 609510,
      "end_ms": 612430,
      "text": "守着国境线上的雪峰黄岭，",
      "token_start": 2055,
      "token_end_exclusive": 2066
    },
    {
      "start_ms": 612610,
      "end_ms": 614650,
      "text": "把丰收晒在了屋顶上，",
      "token_start": 2066,
      "token_end_exclusive": 2075
    },
    {
      "start_ms": 615370,
      "end_ms": 617470,
      "text": "可只有贾居藏寨，",
      "token_start": 2075,
      "token_end_exclusive": 2082
    },
    {
      "start_ms": 618090,
      "end_ms": 624650,
      "text": "而山和树房子和雪落成了一座立起来的村子。",
      "token_start": 2082,
      "token_end_exclusive": 2101
    },
    {
      "start_ms": 625410,
      "end_ms": 629610,
      "text": "原来最绝美的秋天不是一片叶子红了，",
      "token_start": 2101,
      "token_end_exclusive": 2117
    },
    {
      "start_ms": 629810,
      "end_ms": 632850,
      "text": "而是整座山一起入了秋。",
      "token_start": 2117,
      "token_end_exclusive": 2127
    },
    {
      "start_ms": 633290,
      "end_ms": 634200,
      "text": "最后问问你们，",
      "token_start": 2127,
      "token_end_exclusive": 2133
    },
    {
      "start_ms": 634260,
      "end_ms": 636280,
      "text": "您这十个古村落，",
      "token_start": 2133,
      "token_end_exclusive": 2140
    },
    {
      "start_ms": 636620,
      "end_ms": 640180,
      "text": "您去过几个最想去的是哪一个？",
      "token_start": 2140,
      "token_end_exclusive": 2153
    },
    {
      "start_ms": 640500,
      "end_ms": 649280,
      "text": "评论区告诉我刚才说的那本大美中国左下方商品的就有爱看大好河山的朋友别错过，",
      "token_start": 2153,
      "token_end_exclusive": 2189
    },
    {
      "start_ms": 649760,
      "end_ms": 651660,
      "text": "觉得这期让您长了见识，",
      "token_start": 2189,
      "token_end_exclusive": 2199
    },
    {
      "start_ms": 652020,
      "end_ms": 653900,
      "text": "就转给身边跟您一样。",
      "token_start": 2199,
      "token_end_exclusive": 2208
    },
    {
      "start_ms": 653900,
      "end_ms": 655440,
      "text": "爱看山河古村的人，",
      "token_start": 2208,
      "token_end_exclusive": 2216
    },
    {
      "start_ms": 655800,
      "end_ms": 661180,
      "text": "想看懂更多中国传统民居和地理人文的绝美秘密，",
      "token_start": 2216,
      "token_end_exclusive": 2237
    },
    {
      "start_ms": 661420,
      "end_ms": 662200,
      "text": "点个关注，",
      "token_start": 2237,
      "token_end_exclusive": 2241
    },
    {
      "start_ms": 662500,
      "end_ms": 664085,
      "text": "咱们下期接着聊。",
      "token_start": 2241,
      "token_end_exclusive": 2248
    }
