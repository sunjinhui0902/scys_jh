{
  "video_id": "v_183328bf0ee8b458",
  "duration_s": 240.370998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_183328bf0ee8b458.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_183328bf0ee8b458.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 2050,
      "text": "不喝就是看不起我，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2650,
      "end_ms": 3130,
      "text": "领导，",
      "token_start": 8,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3410,
      "end_ms": 4550,
      "text": "我不是看不起您，",
      "token_start": 10,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4990,
      "end_ms": 6895,
      "text": "我是看不起病，",
      "token_start": 17,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 9910,
      "end_ms": 11250,
      "text": "你酒量挺好的呀。",
      "token_start": 23,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 11470,
      "end_ms": 11910,
      "text": "领导，",
      "token_start": 30,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 12030,
      "end_ms": 13110,
      "text": "您可抬举我了，",
      "token_start": 32,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 13130,
      "end_ms": 14370,
      "text": "我平时真不太能喝，",
      "token_start": 38,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 14630,
      "end_ms": 16010,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 46,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 16010,
      "end_ms": 16570,
      "text": "高兴啊。",
      "token_start": 57,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 16730,
      "end_ms": 18310,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 60,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 19970,
      "end_ms": 21310,
      "text": "我真不怎么喜欢你，",
      "token_start": 70,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21590,
      "end_ms": 23750,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 78,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 23750,
      "end_ms": 26210,
      "text": "我领导的格局值得我们学习。",
      "token_start": 91,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 29030,
      "end_ms": 29930,
      "text": "鱼是好鱼，",
      "token_start": 103,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 30250,
      "end_ms": 31550,
      "text": "可惜就是刺多。",
      "token_start": 107,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 31810,
      "end_ms": 32090,
      "text": "领导，",
      "token_start": 113,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 32090,
      "end_ms": 33930,
      "text": "您看鱼虽然刺多，",
      "token_start": 115,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 33950,
      "end_ms": 35310,
      "text": "但主心骨只有一根，",
      "token_start": 122,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 35490,
      "end_ms": 39900,
      "text": "心腹是没有刺的鱼这么多饭，",
      "token_start": 130,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 39900,
      "end_ms": 40600,
      "text": "你喂猪呢？",
      "token_start": 142,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 40840,
      "end_ms": 41260,
      "text": "领导，",
      "token_start": 146,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 41260,
      "end_ms": 42060,
      "text": "我哪儿敢啊？",
      "token_start": 148,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 42200,
      "end_ms": 44500,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 153,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 44520,
      "end_ms": 46000,
      "text": "都说宰相肚里能撑船，",
      "token_start": 169,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 46020,
      "end_ms": 47240,
      "text": "更何况只是一碗饭呢。",
      "token_start": 178,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 49120,
      "end_ms": 49360,
      "text": "哎，",
      "token_start": 187,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 49640,
      "end_ms": 50540,
      "text": "你什么意思啊？",
      "token_start": 188,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 50760,
      "end_ms": 52140,
      "text": "怎么到我这就剩半杯了。",
      "token_start": 194,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 52280,
      "end_ms": 53280,
      "text": "领导美满美满，",
      "token_start": 204,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 53460,
      "end_ms": 54520,
      "text": "代表幸福美满，",
      "token_start": 210,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 54680,
      "end_ms": 56860,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 216,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 59300,
      "end_ms": 60755,
      "text": "这藕是好藕啊，",
      "token_start": 230,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 61150,
      "end_ms": 62315,
      "text": "就是心眼儿太多了。",
      "token_start": 236,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 63100,
      "end_ms": 65210,
      "text": "领导藕虽然心眼多，",
      "token_start": 244,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 65430,
      "end_ms": 66905,
      "text": "但也是您的下酒菜呀。",
      "token_start": 252,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 69850,
      "end_ms": 71155,
      "text": "这鸭子是好鸭子，",
      "token_start": 261,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 71740,
      "end_ms": 72655,
      "text": "就是嘴硬，",
      "token_start": 268,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 73860,
      "end_ms": 74320,
      "text": "嘴硬，",
      "token_start": 272,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 74320,
      "end_ms": 75295,
      "text": "才守得住秘密。",
      "token_start": 274,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 75850,
      "end_ms": 78850,
      "text": "呵呵呵这个哈哈哈啊啊，",
      "token_start": 280,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 79580,
      "end_ms": 80735,
      "text": "怎么你这一入职，",
      "token_start": 290,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 81210,
      "end_ms": 82575,
      "text": "我刚种的花就死了，",
      "token_start": 297,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 82910,
      "end_ms": 83950,
      "text": "花开富贵嘛，",
      "token_start": 305,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 84070,
      "end_ms": 84710,
      "text": "花开过了，",
      "token_start": 310,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 84710,
      "end_ms": 85525,
      "text": "就剩富贵了。",
      "token_start": 314,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 85760,
      "end_ms": 87555,
      "text": "看来领导您啊要发大财了。",
      "token_start": 319,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 88020,
      "end_ms": 89805,
      "text": "哈哈哈哈哈哈小图啊，",
      "token_start": 330,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 90090,
      "end_ms": 91490,
      "text": "你个子是真高比，",
      "token_start": 339,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 91490,
      "end_ms": 92425,
      "text": "我还高一头呢，",
      "token_start": 346,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 92720,
      "end_ms": 96735,
      "text": "各高是为了给领导探路走哪儿不还是得听领导指挥吗？",
      "token_start": 352,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 97140,
      "end_ms": 98895,
      "text": "哈哈哈哈哈小图啊，",
      "token_start": 375,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 99300,
      "end_ms": 101215,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 383,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 102100,
      "end_ms": 104555,
      "text": "思想上领导的高度望尘莫及，",
      "token_start": 393,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 104870,
      "end_ms": 106975,
      "text": "只能在e聘上找些自我安慰了。",
      "token_start": 405,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 107350,
      "end_ms": 108205,
      "text": "哈哈哈哈，",
      "token_start": 418,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 108450,
      "end_ms": 110645,
      "text": "来这么晚只能吃剩菜了吧。",
      "token_start": 422,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 111070,
      "end_ms": 112590,
      "text": "领导饭在哪儿我都能吃，",
      "token_start": 433,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 112750,
      "end_ms": 114590,
      "text": "但您这桌不是谁想做就能坐的，",
      "token_start": 443,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 114590,
      "end_ms": 116005,
      "text": "能赶上已经是我的运气了。",
      "token_start": 456,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 116960,
      "end_ms": 117415,
      "text": "哈哈哈，",
      "token_start": 467,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 118410,
      "end_ms": 119685,
      "text": "年轻就是好啊，",
      "token_start": 470,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 120030,
      "end_ms": 121590,
      "text": "年轻就是还不够沉稳，",
      "token_start": 476,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 121750,
      "end_ms": 122950,
      "text": "还要向您多学习，",
      "token_start": 485,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 123090,
      "end_ms": 124635,
      "text": "我们才能变得更优秀。",
      "token_start": 492,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 128350,
      "end_ms": 130450,
      "text": "小图今天让你破费了。",
      "token_start": 501,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 130630,
      "end_ms": 131050,
      "text": "领导，",
      "token_start": 510,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 131210,
      "end_ms": 132570,
      "text": "您说这些您能来，",
      "token_start": 512,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 132570,
      "end_ms": 133390,
      "text": "就是我的荣幸，",
      "token_start": 519,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 133630,
      "end_ms": 135470,
      "text": "以后还有很多地方向您请教，",
      "token_start": 525,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 135470,
      "end_ms": 139130,
      "text": "不是来就来，",
      "token_start": 537,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 139270,
      "end_ms": 140270,
      "text": "带什么礼物啊，",
      "token_start": 542,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 140350,
      "end_ms": 141170,
      "text": "都不是外人。",
      "token_start": 548,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 141530,
      "end_ms": 141950,
      "text": "领导，",
      "token_start": 553,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 142070,
      "end_ms": 142730,
      "text": "您都说了，",
      "token_start": 555,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 142730,
      "end_ms": 143330,
      "text": "不是外人，",
      "token_start": 559,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 143390,
      "end_ms": 144810,
      "text": "我一直都把您当长辈看，",
      "token_start": 563,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 144970,
      "end_ms": 146970,
      "text": "哪有晚辈看长辈空手来的道理啊。",
      "token_start": 573,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 148650,
      "end_ms": 149310,
      "text": "小图啊，",
      "token_start": 587,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 149610,
      "end_ms": 151270,
      "text": "你这菜点的也太多了，",
      "token_start": 590,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 151710,
      "end_ms": 153370,
      "text": "领导菜点的再多，",
      "token_start": 599,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 153370,
      "end_ms": 156130,
      "text": "也比不上平时您对我的照顾多这杯酒，",
      "token_start": 606,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 156130,
      "end_ms": 157385,
      "text": "我先敬您。",
      "token_start": 622,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 158630,
      "end_ms": 160170,
      "text": "小图最近表现不错啊，",
      "token_start": 626,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 160350,
      "end_ms": 162330,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 635,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 162450,
      "end_ms": 163730,
      "text": "我得提前敬你一杯。",
      "token_start": 648,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 163850,
      "end_ms": 164550,
      "text": "听这意思，",
      "token_start": 656,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 164590,
      "end_ms": 165690,
      "text": "领导是要高升了呀，",
      "token_start": 660,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 165690,
      "end_ms": 169210,
      "text": "我得提前敬领导一杯小图啊，",
      "token_start": 668,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 169450,
      "end_ms": 171130,
      "text": "你一开口就让人喜欢你，",
      "token_start": 680,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 171290,
      "end_ms": 172330,
      "text": "你是怎么做到的？",
      "token_start": 690,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 172490,
      "end_ms": 174649,
      "text": "因为我一直在看这本闲谈高手，",
      "token_start": 697,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 174850,
      "end_ms": 178590,
      "text": "这个世界上谁都不会拒绝那些会说话会来事的人。",
      "token_start": 710,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 178710,
      "end_ms": 179850,
      "text": "假如你不爱说话，",
      "token_start": 731,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 179930,
      "end_ms": 180690,
      "text": "不爱争辩，",
      "token_start": 738,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 180790,
      "end_ms": 181650,
      "text": "也不爱出门，",
      "token_start": 742,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 181730,
      "end_ms": 182965,
      "text": "甚至闲惧社交，",
      "token_start": 747,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 183290,
      "end_ms": 185245,
      "text": "推荐你读完这本闲谈高手，",
      "token_start": 753,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 185550,
      "end_ms": 187745,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 764,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 188060,
      "end_ms": 189220,
      "text": "你每天就看两页，",
      "token_start": 776,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 189400,
      "end_ms": 190795,
      "text": "每一个场景慢慢练，",
      "token_start": 783,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 191050,
      "end_ms": 193670,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 791,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 193810,
      "end_ms": 195170,
      "text": "在这本书里有一句话，",
      "token_start": 806,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 195230,
      "end_ms": 196095,
      "text": "我特别欣赏，",
      "token_start": 815,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 196420,
      "end_ms": 196560,
      "text": "他，",
      "token_start": 820,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 196560,
      "end_ms": 198620,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 821,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 198820,
      "end_ms": 199460,
      "text": "你可以回，",
      "token_start": 833,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 199940,
      "end_ms": 200940,
      "text": "那是不优秀点，",
      "token_start": 837,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 201020,
      "end_ms": 202385,
      "text": "怎么能和你做朋友呢？",
      "token_start": 843,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 202720,
      "end_ms": 204360,
      "text": "当有人说你真聪明，",
      "token_start": 852,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 204480,
      "end_ms": 206175,
      "text": "你就回近朱者赤，",
      "token_start": 860,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 206460,
      "end_ms": 207440,
      "text": "和你在一起啊，",
      "token_start": 867,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 207500,
      "end_ms": 210600,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 873,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 210680,
      "end_ms": 211840,
      "text": "你就回领导，",
      "token_start": 888,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 212040,
      "end_ms": 213345,
      "text": "这都是我应该做的。",
      "token_start": 893,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 213670,
      "end_ms": 215010,
      "text": "强将手下吴若冰，",
      "token_start": 901,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 215270,
      "end_ms": 216670,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 908,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 216870,
      "end_ms": 218270,
      "text": "当我看到这段的时候，",
      "token_start": 917,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 218290,
      "end_ms": 220195,
      "text": "这个真是让我一解心开啊。",
      "token_start": 926,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 220480,
      "end_ms": 221705,
      "text": "每一句都很有意思，",
      "token_start": 937,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 222030,
      "end_ms": 224490,
      "text": "就是手把手教我们在不同的场景之下，",
      "token_start": 945,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 224490,
      "end_ms": 225210,
      "text": "应该怎么说？",
      "token_start": 961,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 225450,
      "end_ms": 228115,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 966,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 228380,
      "end_ms": 229700,
      "text": "你就放心的拿回去看，",
      "token_start": 984,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 230040,
      "end_ms": 231515,
      "text": "就是一句一句的教你，",
      "token_start": 993,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 231770,
      "end_ms": 234175,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 1002,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 234500,
      "end_ms": 235580,
      "text": "但凡学会三分，",
      "token_start": 1014,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 235780,
      "end_ms": 238175,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 1020,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 238590,
      "end_ms": 240245,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 1034,
      "token_end_exclusive": 1046
    }
