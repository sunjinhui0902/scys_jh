{
  "video_id": "v_0a3c17f15ee2bfb2",
  "duration_s": 478.260998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_0a3c17f15ee2bfb2.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_0a3c17f15ee2bfb2.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 3470,
      "text": "消失二十八年回来只剩半条命，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 4010,
      "end_ms": 5510,
      "text": "妻子翻出他证件，",
      "token_start": 13,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5550,
      "end_ms": 6470,
      "text": "当场哭瘫。",
      "token_start": 20,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 6950,
      "end_ms": 9590,
      "text": "原来你是国家的人家人们，",
      "token_start": 24,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 9770,
      "end_ms": 11450,
      "text": "我先问大家一个问题，",
      "token_start": 35,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 11750,
      "end_ms": 17870,
      "text": "一个男人、妻子、父母、孩子全都不知道他在哪在干什么，",
      "token_start": 44,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 18290,
      "end_ms": 20570,
      "text": "一消失就是二十八年，",
      "token_start": 66,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 20570,
      "end_ms": 22490,
      "text": "他到底在为国家做什么？",
      "token_start": 75,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 22790,
      "end_ms": 23870,
      "text": "他叫邓稼先，",
      "token_start": 85,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 24290,
      "end_ms": 25550,
      "text": "三十四岁那年，",
      "token_start": 90,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 25570,
      "end_ms": 26330,
      "text": "接下任务，",
      "token_start": 96,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 26750,
      "end_ms": 28670,
      "text": "从此人间蒸发。",
      "token_start": 100,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 29350,
      "end_ms": 31480,
      "text": "等他再出出现在妻子面前时，",
      "token_start": 106,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 31960,
      "end_ms": 33160,
      "text": "只剩半条命，",
      "token_start": 118,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 33720,
      "end_ms": 35860,
      "text": "手里捏着一张皱巴巴的纸，",
      "token_start": 123,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 35940,
      "end_ms": 37100,
      "text": "上面写着一句话，",
      "token_start": 134,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 37980,
      "end_ms": 40280,
      "text": "不要让人家把我们落得太远。",
      "token_start": 141,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 41100,
      "end_ms": 47400,
      "text": "今天我把这个课本没讲完的故事给你讲完时间倒回。",
      "token_start": 153,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 47640,
      "end_ms": 48540,
      "text": "一九五八年，",
      "token_start": 175,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 50040,
      "end_ms": 53020,
      "text": "那时候的邓稼先才三十四岁，",
      "token_start": 180,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 53920,
      "end_ms": 55600,
      "text": "刚从美国留学回来，",
      "token_start": 192,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 55760,
      "end_ms": 58420,
      "text": "是国内顶尖的核物理专家。",
      "token_start": 200,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 59300,
      "end_ms": 60855,
      "text": "他有体面的工作，",
      "token_start": 211,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 61220,
      "end_ms": 62645,
      "text": "有贤惠的妻子，",
      "token_start": 218,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 63060,
      "end_ms": 64455,
      "text": "一双可爱的儿女，",
      "token_start": 224,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 64870,
      "end_ms": 66945,
      "text": "日子过得安稳又幸福。",
      "token_start": 231,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67520,
      "end_ms": 68645,
      "text": "可就在这一年，",
      "token_start": 240,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 68970,
      "end_ms": 70165,
      "text": "领导找他谈话，",
      "token_start": 246,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 70720,
      "end_ms": 71815,
      "text": "只说了一句话，",
      "token_start": 252,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 72680,
      "end_ms": 74380,
      "text": "国家要放一个大炮仗，",
      "token_start": 258,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 74420,
      "end_ms": 75465,
      "text": "需要你去做。",
      "token_start": 267,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 76500,
      "end_ms": 78345,
      "text": "邓稼先瞬间就懂了，",
      "token_start": 272,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 79360,
      "end_ms": 81605,
      "text": "这是国家最高级别的机密，",
      "token_start": 280,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 82510,
      "end_ms": 86105,
      "text": "这一去就意味着隐姓埋名，",
      "token_start": 291,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 87170,
      "end_ms": 88430,
      "text": "不能告诉任何人，",
      "token_start": 302,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 88430,
      "end_ms": 89255,
      "text": "自己去哪，",
      "token_start": 309,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 90960,
      "end_ms": 92455,
      "text": "连父母都不能说。",
      "token_start": 313,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 92890,
      "end_ms": 94005,
      "text": "那天晚上回家，",
      "token_start": 320,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 94270,
      "end_ms": 95735,
      "text": "他看着熟睡的孩子，",
      "token_start": 326,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 96160,
      "end_ms": 97945,
      "text": "看着忙前忙后的妻子，",
      "token_start": 334,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 98280,
      "end_ms": 99795,
      "text": "心里像刀割一样。",
      "token_start": 343,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 100600,
      "end_ms": 102235,
      "text": "他跟妻子许路熹说，",
      "token_start": 350,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 103080,
      "end_ms": 104565,
      "text": "我要调动工作了。",
      "token_start": 358,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 105170,
      "end_ms": 107360,
      "text": "去很远的地方以后，",
      "token_start": 365,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 107360,
      "end_ms": 110285,
      "text": "家里的事儿就都靠你了。",
      "token_start": 373,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 111300,
      "end_ms": 114585,
      "text": "妻子问他去哪去多久，",
      "token_start": 383,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 116400,
      "end_ms": 116940,
      "text": "做什么，",
      "token_start": 392,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 116940,
      "end_ms": 118075,
      "text": "他只能摇头，",
      "token_start": 395,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 118970,
      "end_ms": 122435,
      "text": "不能说你就当我死了都行。",
      "token_start": 400,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 123410,
      "end_ms": 124445,
      "text": "但你相信我，",
      "token_start": 411,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 125590,
      "end_ms": 129395,
      "text": "我做的这件事儿这辈子都值得。",
      "token_start": 416,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 130760,
      "end_ms": 131645,
      "text": "第二天一早，",
      "token_start": 429,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 132560,
      "end_ms": 134875,
      "text": "他拎着一个简单的行李箱，",
      "token_start": 434,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 135360,
      "end_ms": 136575,
      "text": "头也不回的走了。",
      "token_start": 445,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 137610,
      "end_ms": 141145,
      "text": "这一走就是整整二十八年。",
      "token_start": 452,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 142240,
      "end_ms": 144755,
      "text": "他去了荒无人烟的戈壁滩，",
      "token_start": 463,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 145690,
      "end_ms": 149035,
      "text": "去了连地图上都找不到的罗布泊，",
      "token_start": 474,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 150580,
      "end_ms": 151775,
      "text": "那地方有多酷？",
      "token_start": 488,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 152220,
      "end_ms": 154365,
      "text": "夏天地表温度四五十度，",
      "token_start": 494,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 154900,
      "end_ms": 156945,
      "text": "沙子烫的能烤熟鸡蛋。",
      "token_start": 504,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 157400,
      "end_ms": 160510,
      "text": "冬天零下三十多度飞沙走石，",
      "token_start": 513,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 160750,
      "end_ms": 162385,
      "text": "房子都能给你掀翻，",
      "token_start": 525,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 163180,
      "end_ms": 165265,
      "text": "吃的是夹着沙子的窝窝头，",
      "token_start": 533,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 165630,
      "end_ms": 167505,
      "text": "喝的是盐碱地的苦水，",
      "token_start": 544,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 168220,
      "end_ms": 170455,
      "text": "连口新鲜蔬菜都吃不上，",
      "token_start": 553,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 171200,
      "end_ms": 174335,
      "text": "比环境更苦的是技术上的难。",
      "token_start": 563,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 174800,
      "end_ms": 175680,
      "text": "外国人卡，",
      "token_start": 575,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 175700,
      "end_ms": 178025,
      "text": "我们脖子什么资料都不给，",
      "token_start": 579,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 178380,
      "end_ms": 179300,
      "text": "没有计算机，",
      "token_start": 590,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 179580,
      "end_ms": 183020,
      "text": "他们就用算盘算几拨人轮班倒，",
      "token_start": 595,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 183260,
      "end_ms": 184955,
      "text": "一天算十几个小时，",
      "token_start": 608,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 185440,
      "end_ms": 187865,
      "text": "算出来的草稿纸堆的比人都高，",
      "token_start": 616,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 188410,
      "end_ms": 191425,
      "text": "最难熬的是对家人的思念，",
      "token_start": 629,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 192050,
      "end_ms": 193290,
      "text": "他不能打电话，",
      "token_start": 640,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 193470,
      "end_ms": 194345,
      "text": "不能写信，",
      "token_start": 646,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 194820,
      "end_ms": 196720,
      "text": "连自己是死是活，",
      "token_start": 650,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 196940,
      "end_ms": 198295,
      "text": "家里人都不知道。",
      "token_start": 657,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 198580,
      "end_ms": 199000,
      "text": "有一次，",
      "token_start": 664,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 199000,
      "end_ms": 199805,
      "text": "母亲病重，",
      "token_start": 667,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 200100,
      "end_ms": 202215,
      "text": "家里连发十几封电报，",
      "token_start": 671,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 202500,
      "end_ms": 203285,
      "text": "催他回去。",
      "token_start": 680,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 203850,
      "end_ms": 205095,
      "text": "他攥着电报，",
      "token_start": 684,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 205300,
      "end_ms": 206220,
      "text": "在戈壁滩上，",
      "token_start": 689,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 206280,
      "end_ms": 208335,
      "text": "对着家的方向跪了很久，",
      "token_start": 694,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 208840,
      "end_ms": 210385,
      "text": "最后还是没回去，",
      "token_start": 704,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 211060,
      "end_ms": 213715,
      "text": "不是不想回是不能回啊。",
      "token_start": 711,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 214640,
      "end_ms": 217505,
      "text": "那时候正是原子弹研制最关键的时候，",
      "token_start": 721,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 217730,
      "end_ms": 218355,
      "text": "他走了，",
      "token_start": 737,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 218770,
      "end_ms": 220555,
      "text": "整个项目都要受影响，",
      "token_start": 740,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 220890,
      "end_ms": 222480,
      "text": "就这么熬啊熬。",
      "token_start": 749,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 222780,
      "end_ms": 223945,
      "text": "一九六四年，",
      "token_start": 755,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 224490,
      "end_ms": 227275,
      "text": "中国第一颗原子弹爆炸成功，",
      "token_start": 760,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 227940,
      "end_ms": 231455,
      "text": "一九六七年第一颗氢弹爆炸成功，",
      "token_start": 772,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 231930,
      "end_ms": 233510,
      "text": "整个世界都震惊了。",
      "token_start": 786,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 233510,
      "end_ms": 234655,
      "text": "可没有人知道，",
      "token_start": 794,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 235670,
      "end_ms": 238375,
      "text": "这背后有一个叫邓稼先的人，",
      "token_start": 800,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 239330,
      "end_ms": 244305,
      "text": "把自己的青春、健康甚至命都搭进去了。",
      "token_start": 812,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 245330,
      "end_ms": 250945,
      "text": "真正让他落下病根的是一九七九年的一次核实验。",
      "token_start": 828,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 251400,
      "end_ms": 251935,
      "text": "那天，",
      "token_start": 849,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 254430,
      "end_ms": 259205,
      "text": "一枚核弹从飞机上投下来降落伞突然出了故障，",
      "token_start": 851,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 259640,
      "end_ms": 261360,
      "text": "弹体直直砸在地上，",
      "token_start": 871,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 261580,
      "end_ms": 262265,
      "text": "摔碎了。",
      "token_start": 879,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 264810,
      "end_ms": 265355,
      "text": "家人们。",
      "token_start": 882,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 265830,
      "end_ms": 267005,
      "text": "核弹摔碎了，",
      "token_start": 885,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 269840,
      "end_ms": 270725,
      "text": "意味着什么？",
      "token_start": 890,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 271060,
      "end_ms": 273055,
      "text": "强辐射当场就散出来。",
      "token_start": 895,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 273720,
      "end_ms": 277075,
      "text": "现场所有人包括最专业的防化兵，",
      "token_start": 904,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 277450,
      "end_ms": 278890,
      "text": "都本能的往后退，",
      "token_start": 918,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 279050,
      "end_ms": 280945,
      "text": "只有一个人没有退。",
      "token_start": 925,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 281440,
      "end_ms": 283485,
      "text": "邓稼先甩开旁边拽他的手，",
      "token_start": 933,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 283810,
      "end_ms": 284905,
      "text": "一个人冲了上去，",
      "token_start": 944,
      "token_end_exclusive": 951
    },
    {
      "start_ms": 285370,
      "end_ms": 286195,
      "text": "有人喊他，",
      "token_start": 951,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 286560,
      "end_ms": 287075,
      "text": "邓院长，",
      "token_start": 955,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 287250,
      "end_ms": 287905,
      "text": "你不能去，",
      "token_start": 958,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 288190,
      "end_ms": 288935,
      "text": "你站远点，",
      "token_start": 962,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 289240,
      "end_ms": 290085,
      "text": "让年轻人去，",
      "token_start": 966,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 290790,
      "end_ms": 291735,
      "text": "他头也没回，",
      "token_start": 971,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 292140,
      "end_ms": 293100,
      "text": "只说了一句话，",
      "token_start": 976,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 293300,
      "end_ms": 294315,
      "text": "这是我负责的。",
      "token_start": 982,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 294830,
      "end_ms": 296250,
      "text": "我不去让谁去，",
      "token_start": 988,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 297210,
      "end_ms": 298230,
      "text": "他蹲在地上，",
      "token_start": 994,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 298550,
      "end_ms": 302430,
      "text": "亲手把那些粘着强辐射的碎片一块一块捧起来，",
      "token_start": 999,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 302790,
      "end_ms": 303670,
      "text": "仔细查看，",
      "token_start": 1019,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 304470,
      "end_ms": 306970,
      "text": "足足在里面待了几十分钟，",
      "token_start": 1023,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 307590,
      "end_ms": 309130,
      "text": "等他走出来的时候，",
      "token_start": 1034,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 309430,
      "end_ms": 310450,
      "text": "脸色煞白，",
      "token_start": 1042,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 310830,
      "end_ms": 311870,
      "text": "嘴唇发紫，",
      "token_start": 1046,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 311970,
      "end_ms": 313130,
      "text": "站都站不稳。",
      "token_start": 1050,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 313370,
      "end_ms": 316250,
      "text": "可他开口第一句话是问题站不了，",
      "token_start": 1055,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 316330,
      "end_ms": 317510,
      "text": "大家不用怕了，",
      "token_start": 1069,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 317750,
      "end_ms": 318990,
      "text": "就是那几十分钟，",
      "token_start": 1075,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 319230,
      "end_ms": 320970,
      "text": "核辐射像刀子一样，",
      "token_start": 1082,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 321230,
      "end_ms": 324540,
      "text": "一刀一刀刮走了他身体里最宝贵的东西。",
      "token_start": 1090,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 325400,
      "end_ms": 325600,
      "text": "起。",
      "token_start": 1107,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 325600,
      "end_ms": 326680,
      "text": "从那以后，",
      "token_start": 1108,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 326680,
      "end_ms": 329300,
      "text": "他的头发开始大把大把的掉，",
      "token_start": 1112,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 329320,
      "end_ms": 330840,
      "text": "经常变血，",
      "token_start": 1124,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 330880,
      "end_ms": 333080,
      "text": "免疫力全面崩塌，",
      "token_start": 1128,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 333080,
      "end_ms": 336800,
      "text": "可他谁也没告诉第二天照常上班，",
      "token_start": 1135,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 336800,
      "end_ms": 338600,
      "text": "照常开会，",
      "token_start": 1149,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 338600,
      "end_ms": 341340,
      "text": "照常往最危险的现场跑。",
      "token_start": 1153,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 341340,
      "end_ms": 343320,
      "text": "他是知道的。",
      "token_start": 1163,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 343340,
      "end_ms": 346740,
      "text": "他知道自己身体里埋着一颗倒计时的炸弹，",
      "token_start": 1168,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 346740,
      "end_ms": 349520,
      "text": "可他从来没跟任何人提起过，",
      "token_start": 1186,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 349520,
      "end_ms": 351040,
      "text": "他只在心里默默默想。",
      "token_start": 1198,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 351440,
      "end_ms": 352540,
      "text": "时间不多了，",
      "token_start": 1207,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 352820,
      "end_ms": 354305,
      "text": "那就再多干一点。",
      "token_start": 1212,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 354900,
      "end_ms": 356200,
      "text": "直到一九八六年，",
      "token_start": 1219,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 356380,
      "end_ms": 357715,
      "text": "他实在撑不住了，",
      "token_start": 1226,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 358200,
      "end_ms": 360455,
      "text": "才被强行送进医院。",
      "token_start": 1233,
      "token_end_exclusive": 1241
    },
    {
      "start_ms": 361310,
      "end_ms": 361985,
      "text": "这时候，",
      "token_start": 1241,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 362310,
      "end_ms": 365305,
      "text": "他的身份才终于对外公开。",
      "token_start": 1244,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 366310,
      "end_ms": 367390,
      "text": "妻子许路兮，",
      "token_start": 1255,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 367410,
      "end_ms": 368245,
      "text": "这才知道，",
      "token_start": 1260,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 368520,
      "end_ms": 370800,
      "text": "自己等了二十八年的丈夫。",
      "token_start": 1264,
      "token_end_exclusive": 1275
    },
    {
      "start_ms": 371120,
      "end_ms": 373455,
      "text": "原来是中国的两弹元勋，",
      "token_start": 1275,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 374000,
      "end_ms": 377005,
      "text": "是为国家立了天大功劳的人。",
      "token_start": 1285,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 377800,
      "end_ms": 379145,
      "text": "可一切都晚了，",
      "token_start": 1297,
      "token_end_exclusive": 1303
    },
    {
      "start_ms": 379660,
      "end_ms": 380395,
      "text": "医生说，",
      "token_start": 1303,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 380800,
      "end_ms": 386015,
      "text": "他的癌细胞已经扩散到了全身住院的最后那段日子。",
      "token_start": 1306,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 386680,
      "end_ms": 388925,
      "text": "他疼的整宿整宿睡不着觉，",
      "token_start": 1328,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 389780,
      "end_ms": 391035,
      "text": "可他从来不说疼，",
      "token_start": 1339,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 391660,
      "end_ms": 393515,
      "text": "还在跟同事讨论工作，",
      "token_start": 1346,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 393890,
      "end_ms": 395785,
      "text": "还在写后续的发展规划。",
      "token_start": 1355,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 397690,
      "end_ms": 398475,
      "text": "临终前，",
      "token_start": 1365,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 399070,
      "end_ms": 400165,
      "text": "他还是那句话，",
      "token_start": 1368,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 400660,
      "end_ms": 402695,
      "text": "不要让人家把我们落得太远。",
      "token_start": 1374,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 404090,
      "end_ms": 406225,
      "text": "一九八六年七月二十九日，",
      "token_start": 1386,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 406960,
      "end_ms": 409555,
      "text": "邓稼先永远的闭上了眼睛，",
      "token_start": 1397,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 410420,
      "end_ms": 412055,
      "text": "享年六十二岁。",
      "token_start": 1408,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 413450,
      "end_ms": 413975,
      "text": "家人们，",
      "token_start": 1414,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 414420,
      "end_ms": 417960,
      "text": "他本来可以留在美国过优渥的生活，",
      "token_start": 1417,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 418320,
      "end_ms": 420420,
      "text": "可他选择了隐姓埋名，",
      "token_start": 1432,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 420900,
      "end_ms": 422160,
      "text": "选择了戈壁滩。",
      "token_start": 1441,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 422700,
      "end_ms": 425620,
      "text": "把自己的一生藏在大漠深处，",
      "token_start": 1447,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 425740,
      "end_ms": 429080,
      "text": "连家人都不能告诉没有他这样的傻子，",
      "token_start": 1459,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 429500,
      "end_ms": 431900,
      "text": "哪有我们今天的安稳日子，",
      "token_start": 1475,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 432380,
      "end_ms": 437820,
      "text": "觉得邓老是真英雄的在评论区打上国事无双四个字，",
      "token_start": 1486,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 438320,
      "end_ms": 439800,
      "text": "让更多人记住他。",
      "token_start": 1508,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 440800,
      "end_ms": 443060,
      "text": "把这条视频转到家庭群，",
      "token_start": 1515,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 443060,
      "end_ms": 449590,
      "text": "让儿子、儿媳、孙子、孙女都看看什么才叫值得追的星。",
      "token_start": 1525,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 450510,
      "end_ms": 451630,
      "text": "记得点个收藏，",
      "token_start": 1546,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 451990,
      "end_ms": 453710,
      "text": "哪天孩子写作业累了，",
      "token_start": 1552,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 454130,
      "end_ms": 455090,
      "text": "不想学了，",
      "token_start": 1561,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 455330,
      "end_ms": 456710,
      "text": "翻出来放给他听，",
      "token_start": 1565,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 457250,
      "end_ms": 459470,
      "text": "比骂一百句都管用。",
      "token_start": 1572,
      "token_end_exclusive": 1580
    },
    {
      "start_ms": 460010,
      "end_ms": 460730,
      "text": "关注我，",
      "token_start": 1580,
      "token_end_exclusive": 1583
    },
    {
      "start_ms": 460930,
      "end_ms": 463650,
      "text": "明天继续讲下一位国之几两，",
      "token_start": 1583,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 463890,
      "end_ms": 466590,
      "text": "像邓稼先这样的故事书里，",
      "token_start": 1595,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 466590,
      "end_ms": 468070,
      "text": "还有整整四十位，",
      "token_start": 1606,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 468570,
      "end_ms": 470650,
      "text": "每一个都值得你读给孩子听。",
      "token_start": 1613,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 471250,
      "end_ms": 472950,
      "text": "这本书叫国之几两。",
      "token_start": 1625,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 472950,
      "end_ms": 474525,
      "text": "链接放在左下角小了，",
      "token_start": 1633,
      "token_end_exclusive": 1642
    },
    {
      "start_ms": 474940,
      "end_ms": 476480,
      "text": "感兴趣可以拍下来，",
      "token_start": 1642,
      "token_end_exclusive": 1650
    },
    {
      "start_ms": 476480,
      "end_ms": 477300,
      "text": "放在枕边，",
      "token_start": 1650,
      "token_end_exclusive": 1654
    },
    {
      "start_ms": 477400,
      "end_ms": 478145,
      "text": "细细品读。",
      "token_start": 1654,
      "token_end_exclusive": 1658
    }
  ],
