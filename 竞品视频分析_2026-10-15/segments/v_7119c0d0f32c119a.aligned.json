  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_7119c0d0f32c119a.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 340,
      "end_ms": 1560,
      "text": "谁学一声狗叫，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2220,
      "end_ms": 3615,
      "text": "我就给他一千块，",
      "token_start": 6,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 7310,
      "end_ms": 8430,
      "text": "祝领导家庭旺，",
      "token_start": 13,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 8530,
      "end_ms": 9870,
      "text": "事业旺以后日子旺，",
      "token_start": 19,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 9870,
      "end_ms": 10410,
      "text": "上家旺，",
      "token_start": 27,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 10450,
      "end_ms": 11670,
      "text": "一共四生四千块，",
      "token_start": 30,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 14390,
      "end_ms": 15970,
      "text": "这鸭子是好鸭子，",
      "token_start": 37,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 16890,
      "end_ms": 17710,
      "text": "就是嘴硬，",
      "token_start": 44,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 18570,
      "end_ms": 19090,
      "text": "嘴硬，",
      "token_start": 48,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 19090,
      "end_ms": 20050,
      "text": "才守得住秘密，",
      "token_start": 50,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 23330,
      "end_ms": 24590,
      "text": "你酒量挺好的呀。",
      "token_start": 56,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 25030,
      "end_ms": 25430,
      "text": "领导，",
      "token_start": 63,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 25510,
      "end_ms": 26470,
      "text": "您可抬举我了，",
      "token_start": 65,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 26470,
      "end_ms": 27710,
      "text": "我平时真不太能喝，",
      "token_start": 71,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 28070,
      "end_ms": 29450,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 79,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 29450,
      "end_ms": 29970,
      "text": "高兴啊，",
      "token_start": 90,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 30190,
      "end_ms": 32035,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 93,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 34440,
      "end_ms": 34880,
      "text": "小李，",
      "token_start": 103,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 34880,
      "end_ms": 35960,
      "text": "最近表现不错啊，",
      "token_start": 105,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 36260,
      "end_ms": 38220,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 112,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 38440,
      "end_ms": 39640,
      "text": "我得提前敬你一杯。",
      "token_start": 125,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 40160,
      "end_ms": 40900,
      "text": "听这意思，",
      "token_start": 133,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 41040,
      "end_ms": 42220,
      "text": "领导是要高升了呀，",
      "token_start": 137,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 42380,
      "end_ms": 43680,
      "text": "我得提前敬领导一杯。",
      "token_start": 145,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 46360,
      "end_ms": 46820,
      "text": "小王，",
      "token_start": 154,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 47380,
      "end_ms": 48860,
      "text": "今天让你破费了。",
      "token_start": 156,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 49120,
      "end_ms": 49520,
      "text": "领导，",
      "token_start": 163,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 49680,
      "end_ms": 51120,
      "text": "您说这些您能来，",
      "token_start": 165,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 51140,
      "end_ms": 51900,
      "text": "就是我的荣幸，",
      "token_start": 172,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 52240,
      "end_ms": 54925,
      "text": "以后还有很多地方要向您请教。",
      "token_start": 178,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 57610,
      "end_ms": 58950,
      "text": "这偶是好偶啊，",
      "token_start": 191,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 59350,
      "end_ms": 60675,
      "text": "就是心眼儿太多了。",
      "token_start": 197,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 61250,
      "end_ms": 63270,
      "text": "领导藕虽然心眼多，",
      "token_start": 205,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 63570,
      "end_ms": 64815,
      "text": "但也是您的下酒菜啊。",
      "token_start": 213,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 65360,
      "end_ms": 66120,
      "text": "哈哈哈哈，",
      "token_start": 222,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 68580,
      "end_ms": 70245,
      "text": "你这菜点的也太多了，",
      "token_start": 226,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 70890,
      "end_ms": 73010,
      "text": "领导菜点的再多，",
      "token_start": 235,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 73130,
      "end_ms": 74470,
      "text": "也比不上平时您对我的照顾。",
      "token_start": 242,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 74470,
      "end_ms": 75270,
      "text": "多这杯酒，",
      "token_start": 254,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 75270,
      "end_ms": 77420,
      "text": "我先敬您啊啊，",
      "token_start": 258,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 78600,
      "end_ms": 80260,
      "text": "你一开口就让人喜欢你，",
      "token_start": 264,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 80340,
      "end_ms": 81405,
      "text": "你是怎么做到的？",
      "token_start": 274,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 81590,
      "end_ms": 84185,
      "text": "因为我一直在看这本把话说的恰到好处，",
      "token_start": 281,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 84460,
      "end_ms": 86120,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 298,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 86140,
      "end_ms": 87840,
      "text": "那些会说话、会来事儿的人。",
      "token_start": 309,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 87900,
      "end_ms": 88860,
      "text": "假如你不爱说话，",
      "token_start": 320,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 88940,
      "end_ms": 89640,
      "text": "不爱争辩，",
      "token_start": 327,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 89720,
      "end_ms": 90720,
      "text": "甚至恐惧社交，",
      "token_start": 331,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 90940,
      "end_ms": 93340,
      "text": "推荐你读完这本把话说的恰到好处，",
      "token_start": 337,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 93520,
      "end_ms": 95440,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 352,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 95680,
      "end_ms": 96520,
      "text": "每天看两页，",
      "token_start": 364,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 96600,
      "end_ms": 97760,
      "text": "每一个场景慢慢练，",
      "token_start": 369,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 97860,
      "end_ms": 100754,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 377,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 101210,
      "end_ms": 102770,
      "text": "在这本书里有一句话，",
      "token_start": 392,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 102770,
      "end_ms": 103795,
      "text": "我特别欣赏，",
      "token_start": 401,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 104170,
      "end_ms": 104290,
      "text": "他，",
      "token_start": 406,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 104290,
      "end_ms": 106805,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 407,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 107070,
      "end_ms": 107725,
      "text": "你可以回，",
      "token_start": 419,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 108100,
      "end_ms": 109300,
      "text": "那是不优秀点儿，",
      "token_start": 423,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 109360,
      "end_ms": 110605,
      "text": "怎么能和你做朋友呢？",
      "token_start": 430,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 111410,
      "end_ms": 112970,
      "text": "当有人说你真聪明，",
      "token_start": 439,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 113130,
      "end_ms": 114955,
      "text": "你就回近朱者赤，",
      "token_start": 447,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 115360,
      "end_ms": 116320,
      "text": "和你在一起啊，",
      "token_start": 454,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 116460,
      "end_ms": 119890,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 460,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 119950,
      "end_ms": 121070,
      "text": "你就回领导，",
      "token_start": 475,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 121150,
      "end_ms": 122395,
      "text": "这都是我应该做的。",
      "token_start": 480,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 122690,
      "end_ms": 124110,
      "text": "强将手下无弱兵，",
      "token_start": 488,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 124310,
      "end_ms": 125865,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 495,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 126170,
      "end_ms": 127550,
      "text": "当我看到这段的时候，",
      "token_start": 504,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 127730,
      "end_ms": 129725,
      "text": "真是让我欲解心开啊。",
      "token_start": 513,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 130340,
      "end_ms": 131595,
      "text": "每一句都很有意思，",
      "token_start": 522,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 132040,
      "end_ms": 135700,
      "text": "就是手把手教我们在不同场景之下应该怎么说。",
      "token_start": 530,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 136060,
      "end_ms": 139105,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 550,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 139400,
      "end_ms": 140755,
      "text": "你就放心的拿回去看，",
      "token_start": 568,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 141300,
      "end_ms": 142845,
      "text": "就是一句一句的教你，",
      "token_start": 577,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 143440,
      "end_ms": 145785,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 586,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 146220,
      "end_ms": 147425,
      "text": "但凡学会三分，",
      "token_start": 598,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 147840,
      "end_ms": 150275,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 604,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 150760,
      "end_ms": 152865,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 618,
      "token_end_exclusive": 630
    }
  ],
