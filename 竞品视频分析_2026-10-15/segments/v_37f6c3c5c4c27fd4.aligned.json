{
  "video_id": "v_37f6c3c5c4c27fd4",
  "duration_s": 550.962993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_37f6c3c5c4c27fd4.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_37f6c3c5c4c27fd4.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 1350,
      "text": "第一次来啊，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1370,
      "end_ms": 2410,
      "text": "也没准备什么，",
      "token_start": 5,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2590,
      "end_ms": 4250,
      "text": "这个你拿着不多，",
      "token_start": 11,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4550,
      "end_ms": 5210,
      "text": "两千块，",
      "token_start": 18,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5490,
      "end_ms": 6210,
      "text": "你别嫌少，",
      "token_start": 21,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 7610,
      "end_ms": 10915,
      "text": "两千怎么了？",
      "token_start": 25,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 14040,
      "end_ms": 14880,
      "text": "你觉得不重要，",
      "token_start": 30,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 15040,
      "end_ms": 16065,
      "text": "本来就是个心意，",
      "token_start": 36,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 18710,
      "end_ms": 19870,
      "text": "那这新衣我不要了，",
      "token_start": 43,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 20410,
      "end_ms": 21435,
      "text": "你什么意思啊？",
      "token_start": 51,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 24410,
      "end_ms": 25670,
      "text": "今天真去周凯家，",
      "token_start": 57,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 27110,
      "end_ms": 27350,
      "text": "嗯，",
      "token_start": 64,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 28050,
      "end_ms": 29510,
      "text": "他爸妈说想见见我，",
      "token_start": 65,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 29990,
      "end_ms": 31050,
      "text": "第一次见家长，",
      "token_start": 73,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 31410,
      "end_ms": 32750,
      "text": "别光听他们嘴上怎么说，",
      "token_start": 79,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 33390,
      "end_ms": 35470,
      "text": "那看什么看他爸妈舍不舍得，",
      "token_start": 89,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 35830,
      "end_ms": 37030,
      "text": "头一次见儿媳妇，",
      "token_start": 101,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 37150,
      "end_ms": 38930,
      "text": "最能看出一个家庭对你的态度。",
      "token_start": 108,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 40250,
      "end_ms": 41205,
      "text": "我到楼下了，",
      "token_start": 121,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 43340,
      "end_ms": 43880,
      "text": "来的路上，",
      "token_start": 126,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 43880,
      "end_ms": 44600,
      "text": "你告诉我，",
      "token_start": 130,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 44620,
      "end_ms": 46340,
      "text": "你爸妈特别重视这次见面，",
      "token_start": 134,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 46740,
      "end_ms": 48600,
      "text": "可现在你又告诉我多少钱不重要，",
      "token_start": 145,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 48920,
      "end_ms": 51460,
      "text": "姑娘两千块还少吗？",
      "token_start": 159,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 52660,
      "end_ms": 53560,
      "text": "两千不少。",
      "token_start": 167,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 54460,
      "end_ms": 55960,
      "text": "可我要看的不是两千块，",
      "token_start": 171,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 56600,
      "end_ms": 58160,
      "text": "是你们到底有多重视我。",
      "token_start": 181,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 58480,
      "end_ms": 64980,
      "text": "所以你现在要因为两千块钱走你到现在都没听懂。",
      "token_start": 191,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 64980,
      "end_ms": 71345,
      "text": "我的意思是啊，",
      "token_start": 212,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 72490,
      "end_ms": 78825,
      "text": "这姑娘还没缓过来分了，",
      "token_start": 218,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 79910,
      "end_ms": 80070,
      "text": "真，",
      "token_start": 228,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 80070,
      "end_ms": 80815,
      "text": "因为那两千，",
      "token_start": 229,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 81360,
      "end_ms": 82000,
      "text": "他说不是钱，",
      "token_start": 234,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 82000,
      "end_ms": 82635,
      "text": "是态度。",
      "token_start": 239,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 83420,
      "end_ms": 84305,
      "text": "那我给你介绍一个，",
      "token_start": 242,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 84630,
      "end_ms": 87265,
      "text": "没兴趣就一起吃顿饭。",
      "token_start": 250,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 89480,
      "end_ms": 89795,
      "text": "行，",
      "token_start": 259,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 93770,
      "end_ms": 94290,
      "text": "不好意思，",
      "token_start": 260,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 94290,
      "end_ms": 95115,
      "text": "我没迟到吧。",
      "token_start": 264,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 95670,
      "end_ms": 95945,
      "text": "嗯，",
      "token_start": 269,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 96250,
      "end_ms": 100540,
      "text": "没有两个人，",
      "token_start": 270,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 100560,
      "end_ms": 101545,
      "text": "三个菜够了吧，",
      "token_start": 275,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 104100,
      "end_ms": 105305,
      "text": "再来一份澳洲牛排。",
      "token_start": 281,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 105800,
      "end_ms": 107205,
      "text": "你不是已经点牛排了吗？",
      "token_start": 289,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 107550,
      "end_ms": 111015,
      "text": "那个是你的怎么了？",
      "token_start": 299,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 112960,
      "end_ms": 114335,
      "text": "是没事儿，",
      "token_start": 307,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 117110,
      "end_ms": 118345,
      "text": "我问个比较现实的问题，",
      "token_start": 311,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 119210,
      "end_ms": 122390,
      "text": "你问你对男方经济条件有什么要求，",
      "token_start": 321,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 123370,
      "end_ms": 124270,
      "text": "工作稳定，",
      "token_start": 336,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 124630,
      "end_ms": 126790,
      "text": "别欠一屁股债房呢，",
      "token_start": 340,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 127870,
      "end_ms": 130910,
      "text": "有最好没有就一起挣车呢，",
      "token_start": 348,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 131710,
      "end_ms": 132470,
      "text": "能开就行。",
      "token_start": 359,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 133430,
      "end_ms": 135210,
      "text": "是不是觉得我要求太低了，",
      "token_start": 363,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 135990,
      "end_ms": 137850,
      "text": "有点儿我要求可不低。",
      "token_start": 374,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 138290,
      "end_ms": 140010,
      "text": "比如脾气不能太差，",
      "token_start": 383,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 140250,
      "end_ms": 140970,
      "text": "不能赌博，",
      "token_start": 391,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 141210,
      "end_ms": 141930,
      "text": "有事、别躲，",
      "token_start": 395,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 142970,
      "end_ms": 144110,
      "text": "还有最重要的一条。",
      "token_start": 399,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 144210,
      "end_ms": 147310,
      "text": "什么结婚以后自己的事儿自己做主，",
      "token_start": 407,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 147610,
      "end_ms": 149825,
      "text": "不能什么事儿都听爸妈的。",
      "token_start": 422,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 152150,
      "end_ms": 152390,
      "text": "嗯，",
      "token_start": 433,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 156290,
      "end_ms": 157430,
      "text": "阿姨给你留饭了。",
      "token_start": 434,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 158510,
      "end_ms": 158955,
      "text": "嗯，",
      "token_start": 441,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 161340,
      "end_ms": 162500,
      "text": "那你少吃点儿，",
      "token_start": 442,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 163620,
      "end_ms": 166480,
      "text": "为什么回去继续喝啊？",
      "token_start": 448,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 168160,
      "end_ms": 171315,
      "text": "你的车嗯挺好的，",
      "token_start": 457,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 173120,
      "end_ms": 175720,
      "text": "不嫌旧车不就是代步的吗？",
      "token_start": 464,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 176480,
      "end_ms": 179260,
      "text": "不过你这个右前轮气好像有点不足，",
      "token_start": 475,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 179260,
      "end_ms": 180000,
      "text": "赶紧补补，",
      "token_start": 490,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 180060,
      "end_ms": 181625,
      "text": "不然跑高速不是很安全。",
      "token_start": 494,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 182320,
      "end_ms": 184100,
      "text": "你们公司经理都换奔驰了，",
      "token_start": 504,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 184100,
      "end_ms": 189355,
      "text": "你怎么还开这个还能开能开跟拿不拿得出手是两回事儿，",
      "token_start": 515,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 195450,
      "end_ms": 196625,
      "text": "不是说不用买吗？",
      "token_start": 539,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 197030,
      "end_ms": 198230,
      "text": "第一次见叔叔阿姨，",
      "token_start": 546,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 198410,
      "end_ms": 199225,
      "text": "空手不好，",
      "token_start": 554,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 200440,
      "end_ms": 202025,
      "text": "多少钱一百多，",
      "token_start": 558,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 202520,
      "end_ms": 203745,
      "text": "怎么嫌便宜？",
      "token_start": 564,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 204070,
      "end_ms": 206795,
      "text": "不是进去吧。",
      "token_start": 569,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 208190,
      "end_ms": 209055,
      "text": "第一次来，",
      "token_start": 574,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 209780,
      "end_ms": 211980,
      "text": "阿姨也没准备什么一点心意，",
      "token_start": 578,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 211980,
      "end_ms": 215550,
      "text": "你拿着阿姨真不用拿着吧，",
      "token_start": 590,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 215550,
      "end_ms": 216675,
      "text": "也不多两千，",
      "token_start": 601,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 219780,
      "end_ms": 220595,
      "text": "谢谢阿姨，",
      "token_start": 606,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 220880,
      "end_ms": 222765,
      "text": "你不嫌少嫌少，",
      "token_start": 610,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 223280,
      "end_ms": 224785,
      "text": "见面里还有嫌少的吗？",
      "token_start": 616,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 225260,
      "end_ms": 226200,
      "text": "您愿意给我，",
      "token_start": 625,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 226400,
      "end_ms": 227985,
      "text": "就说明您欢迎我，",
      "token_start": 630,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 228440,
      "end_ms": 229475,
      "text": "这不就是心意吗？",
      "token_start": 637,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 232900,
      "end_ms": 233180,
      "text": "对了，",
      "token_start": 644,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 233180,
      "end_ms": 233575,
      "text": "阿姨，",
      "token_start": 646,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 233920,
      "end_ms": 235360,
      "text": "我也不知道你喜欢什么，",
      "token_start": 648,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 235540,
      "end_ms": 235940,
      "text": "就买了，",
      "token_start": 658,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 235940,
      "end_ms": 237950,
      "text": "点水果来就来了，",
      "token_start": 661,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 238130,
      "end_ms": 241260,
      "text": "还买什么东西第一次见面嘛，",
      "token_start": 668,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 241540,
      "end_ms": 242685,
      "text": "心意必须要到，",
      "token_start": 680,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 246040,
      "end_ms": 247000,
      "text": "还是那个红包，",
      "token_start": 686,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 247400,
      "end_ms": 248240,
      "text": "还是两千块。",
      "token_start": 692,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 248960,
      "end_ms": 249680,
      "text": "可这一次，",
      "token_start": 697,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 250200,
      "end_ms": 253295,
      "text": "我终于能笑着坐下来好好吃顿饭，",
      "token_start": 701,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 257000,
      "end_ms": 258520,
      "text": "也不知道你爱吃什么，",
      "token_start": 715,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 258820,
      "end_ms": 260380,
      "text": "阿姨就随便做了几个菜，",
      "token_start": 724,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 260720,
      "end_ms": 262780,
      "text": "阿姨这还叫随便做啊，",
      "token_start": 734,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 262880,
      "end_ms": 263920,
      "text": "这么一大桌子。",
      "token_start": 743,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 264000,
      "end_ms": 265640,
      "text": "我刚进门就闻到香味了，",
      "token_start": 749,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 265920,
      "end_ms": 267620,
      "text": "你尝尝这个个，",
      "token_start": 759,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 267620,
      "end_ms": 269340,
      "text": "不过阿姨不太会做饭，",
      "token_start": 765,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 269340,
      "end_ms": 271800,
      "text": "做的肯定没有你妈妈做的好吃。",
      "token_start": 774,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 271800,
      "end_ms": 274260,
      "text": "阿姨这还真没法比，",
      "token_start": 787,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 274260,
      "end_ms": 276780,
      "text": "我妈做的是我从小吃大的家的味道。",
      "token_start": 795,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 277200,
      "end_ms": 280360,
      "text": "您今天这一桌是知道我要来特意准备的心意，",
      "token_start": 810,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 280780,
      "end_ms": 282040,
      "text": "一个是家的味道，",
      "token_start": 829,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 282140,
      "end_ms": 283300,
      "text": "一个是您的心意，",
      "token_start": 836,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 283640,
      "end_ms": 285875,
      "text": "这哪能放在一起比呢？",
      "token_start": 843,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 287030,
      "end_ms": 288830,
      "text": "你这姑娘还挺会说话，",
      "token_start": 852,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 289110,
      "end_ms": 291450,
      "text": "不过阿姨您可别再给我夹菜了，",
      "token_start": 861,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 291610,
      "end_ms": 293130,
      "text": "怎么不好吃，",
      "token_start": 874,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 293890,
      "end_ms": 294630,
      "text": "哪能啊？",
      "token_start": 879,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 294810,
      "end_ms": 296710,
      "text": "我是怕第一次来就吃三碗饭，",
      "token_start": 882,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 297130,
      "end_ms": 299805,
      "text": "下次您听说我来还得提前多买两斤米，",
      "token_start": 894,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 300420,
      "end_ms": 300910,
      "text": "哈哈哈，",
      "token_start": 910,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 302110,
      "end_ms": 303090,
      "text": "能吃是福，",
      "token_start": 913,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 303410,
      "end_ms": 304035,
      "text": "多吃点儿。",
      "token_start": 917,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 306400,
      "end_ms": 307860,
      "text": "姑娘阿姨，",
      "token_start": 921,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 307860,
      "end_ms": 308600,
      "text": "问你个问题，",
      "token_start": 925,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 308660,
      "end_ms": 309560,
      "text": "你别介意啊。",
      "token_start": 930,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 310120,
      "end_ms": 311780,
      "text": "您问以后，",
      "token_start": 935,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 311780,
      "end_ms": 313580,
      "text": "你跟陈默要是真结婚了，",
      "token_start": 939,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 313760,
      "end_ms": 314880,
      "text": "你们家谁说了算？",
      "token_start": 949,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 316720,
      "end_ms": 318780,
      "text": "没问你我问人家姑娘呢？",
      "token_start": 956,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 319060,
      "end_ms": 319500,
      "text": "阿姨，",
      "token_start": 966,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 319740,
      "end_ms": 321060,
      "text": "我觉得谁说了都不算，",
      "token_start": 968,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 321340,
      "end_ms": 322260,
      "text": "那谁说了算，",
      "token_start": 977,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 322560,
      "end_ms": 323580,
      "text": "谁说的有道理，",
      "token_start": 982,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 323580,
      "end_ms": 324280,
      "text": "谁说了算？",
      "token_start": 988,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 324640,
      "end_ms": 325560,
      "text": "两个人过日子，",
      "token_start": 992,
      "token_end_exclusive": 998
    },
    {
      "start_ms": 325560,
      "end_ms": 327520,
      "text": "又不是争领导小事，",
      "token_start": 998,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 327540,
      "end_ms": 329320,
      "text": "互相让一步大事做下来，",
      "token_start": 1006,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 329320,
      "end_ms": 330080,
      "text": "一起商量，",
      "token_start": 1016,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 330440,
      "end_ms": 334040,
      "text": "非得分出谁听谁的那日子不就过成上下级了吗？",
      "token_start": 1020,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 335100,
      "end_ms": 336950,
      "text": "这话说的倒挺在理。",
      "token_start": 1040,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 337650,
      "end_ms": 337890,
      "text": "妈，",
      "token_start": 1048,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 338090,
      "end_ms": 340110,
      "text": "你今天这是吃饭还是面试啊？",
      "token_start": 1049,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 340410,
      "end_ms": 341010,
      "text": "你闭嘴，",
      "token_start": 1061,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 341710,
      "end_ms": 343630,
      "text": "人家姑娘比你会说多了。",
      "token_start": 1064,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 344570,
      "end_ms": 346130,
      "text": "那阿姨再问你最后一个，",
      "token_start": 1074,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 347030,
      "end_ms": 350150,
      "text": "您说以后你们两个真结婚了，",
      "token_start": 1084,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 350450,
      "end_ms": 352230,
      "text": "要是有一天我跟你闹矛盾了，",
      "token_start": 1096,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 352230,
      "end_ms": 356650,
      "text": "你希望她帮谁妈，",
      "token_start": 1108,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 356730,
      "end_ms": 358090,
      "text": "你怎么什么都问啊，",
      "token_start": 1115,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 358330,
      "end_ms": 359050,
      "text": "你别说话，",
      "token_start": 1123,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 360130,
      "end_ms": 362430,
      "text": "阿姨这个问题我可不能让他选，",
      "token_start": 1127,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 362910,
      "end_ms": 365925,
      "text": "为什么您是生他养他的妈妈？",
      "token_start": 1140,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 366250,
      "end_ms": 367710,
      "text": "我要是真跟他结婚了，",
      "token_start": 1152,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 368030,
      "end_ms": 370960,
      "text": "就是陪他过日子的人一个是亲情，",
      "token_start": 1161,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 371020,
      "end_ms": 371875,
      "text": "一个是爱情，",
      "token_start": 1175,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 372370,
      "end_ms": 374090,
      "text": "本来就没有谁输谁赢，",
      "token_start": 1180,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 374350,
      "end_ms": 375510,
      "text": "真有矛盾的时候，",
      "token_start": 1189,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 375570,
      "end_ms": 376925,
      "text": "谁有道理就听谁的。",
      "token_start": 1196,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 377360,
      "end_ms": 379260,
      "text": "要是我们两个非逼着他选一个，",
      "token_start": 1204,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 379320,
      "end_ms": 381075,
      "text": "那最后为难的不还是沉默吗？",
      "token_start": 1217,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 382480,
      "end_ms": 383775,
      "text": "你看看人家姑娘，",
      "token_start": 1229,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 384190,
      "end_ms": 385995,
      "text": "怎么每次最后还说的都是我，",
      "token_start": 1236,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 386290,
      "end_ms": 387475,
      "text": "谁让人家比你懂事。",
      "token_start": 1248,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 392150,
      "end_ms": 392510,
      "text": "阿姨，",
      "token_start": 1256,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 392570,
      "end_ms": 393390,
      "text": "我帮您收拾吧。",
      "token_start": 1258,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 393390,
      "end_ms": 393730,
      "text": "不用，",
      "token_start": 1264,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 393830,
      "end_ms": 395170,
      "text": "你第一次来是客人，",
      "token_start": 1266,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 395330,
      "end_ms": 396825,
      "text": "哪有让客人洗碗的道理。",
      "token_start": 1274,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 397950,
      "end_ms": 398370,
      "text": "那好，",
      "token_start": 1284,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 398710,
      "end_ms": 399865,
      "text": "今天我听您的，",
      "token_start": 1286,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 400250,
      "end_ms": 402050,
      "text": "等以后来的次数多了，",
      "token_start": 1292,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 402070,
      "end_ms": 403410,
      "text": "您不把我当客人了，",
      "token_start": 1301,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 403430,
      "end_ms": 405035,
      "text": "到时候可不能再拦着我。",
      "token_start": 1309,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 406550,
      "end_ms": 409165,
      "text": "你这姑娘第一次来就想着以后了，",
      "token_start": 1319,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 409890,
      "end_ms": 411210,
      "text": "您饭也让我吃了，",
      "token_start": 1333,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 411210,
      "end_ms": 412310,
      "text": "红包也让我收了，",
      "token_start": 1340,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 412350,
      "end_ms": 414055,
      "text": "我总不能吃完就不认账吧。",
      "token_start": 1347,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 414660,
      "end_ms": 416185,
      "text": "哈哈哈哈哈哈。",
      "token_start": 1358,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 417160,
      "end_ms": 417565,
      "text": "好，",
      "token_start": 1364,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 418060,
      "end_ms": 419335,
      "text": "以后有时间常来，",
      "token_start": 1365,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 421550,
      "end_ms": 422785,
      "text": "我现在是真服你了，",
      "token_start": 1372,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 423290,
      "end_ms": 423805,
      "text": "怎么了？",
      "token_start": 1380,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 424130,
      "end_ms": 425170,
      "text": "我妈给你两千块，",
      "token_start": 1383,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 425330,
      "end_ms": 426850,
      "text": "你一句话就把她说高兴了。",
      "token_start": 1390,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 427290,
      "end_ms": 428050,
      "text": "吃饭的时候，",
      "token_start": 1401,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 428050,
      "end_ms": 428710,
      "text": "她说做饭没，",
      "token_start": 1406,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 428710,
      "end_ms": 429430,
      "text": "你妈妈好吃，",
      "token_start": 1411,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 429570,
      "end_ms": 430030,
      "text": "换成我，",
      "token_start": 1416,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 430030,
      "end_ms": 430950,
      "text": "我都不知道怎么接。",
      "token_start": 1419,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 431210,
      "end_ms": 433130,
      "text": "后面又问你结婚以后谁说了算，",
      "token_start": 1427,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 433430,
      "end_ms": 434630,
      "text": "还问她跟你闹矛盾了，",
      "token_start": 1440,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 434630,
      "end_ms": 437610,
      "text": "我应该帮谁一坐，",
      "token_start": 1449,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 437610,
      "end_ms": 438930,
      "text": "旁边听着都替你紧张，",
      "token_start": 1456,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 440850,
      "end_ms": 442050,
      "text": "你到底是怎么练的？",
      "token_start": 1465,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 442690,
      "end_ms": 444490,
      "text": "为什么别人突然给你一句话，",
      "token_start": 1473,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 444490,
      "end_ms": 445850,
      "text": "你马上就知道该怎么接？",
      "token_start": 1485,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 446610,
      "end_ms": 447910,
      "text": "其实我以前跟你一样，",
      "token_start": 1495,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 448450,
      "end_ms": 449230,
      "text": "不爱说话，",
      "token_start": 1504,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 449950,
      "end_ms": 451170,
      "text": "也不知道怎么组织语言，",
      "token_start": 1508,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 451170,
      "end_ms": 454600,
      "text": "一到这种场合就不知道应该说说什么。",
      "token_start": 1518,
      "token_end_exclusive": 1534
    },
    {
      "start_ms": 455860,
      "end_ms": 458960,
      "text": "后来我就经常看这本把话说的恰到好处。",
      "token_start": 1534,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 459380,
      "end_ms": 460900,
      "text": "它里面就是一个场景，",
      "token_start": 1551,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 460900,
      "end_ms": 462080,
      "text": "一个场景的告诉你，",
      "token_start": 1560,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 462300,
      "end_ms": 465080,
      "text": "遇遇到不同的人不同的话应该怎么接。",
      "token_start": 1568,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 465440,
      "end_ms": 467300,
      "text": "比如别人夸你优秀，",
      "token_start": 1584,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 467840,
      "end_ms": 468460,
      "text": "你可以回，",
      "token_start": 1592,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 469140,
      "end_ms": 470380,
      "text": "那是不优秀点，",
      "token_start": 1596,
      "token_end_exclusive": 1602
    },
    {
      "start_ms": 470380,
      "end_ms": 471740,
      "text": "怎么能和你做朋友呢？",
      "token_start": 1602,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 471740,
      "end_ms": 473420,
      "text": "当别人说你真聪明，",
      "token_start": 1611,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 473420,
      "end_ms": 474980,
      "text": "你就回近朱者赤，",
      "token_start": 1619,
      "token_end_exclusive": 1626
    },
    {
      "start_ms": 474980,
      "end_ms": 476000,
      "text": "和你在一起啊，",
      "token_start": 1626,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 476000,
      "end_ms": 478500,
      "text": "熏都熏出来了当领导跟你说，",
      "token_start": 1632,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 478500,
      "end_ms": 479160,
      "text": "辛苦了，",
      "token_start": 1644,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 479160,
      "end_ms": 480540,
      "text": "你就回领导，",
      "token_start": 1647,
      "token_end_exclusive": 1652
    },
    {
      "start_ms": 480540,
      "end_ms": 481740,
      "text": "这都是我应该做的。",
      "token_start": 1652,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 481740,
      "end_ms": 483160,
      "text": "强将手下无弱兵，",
      "token_start": 1660,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 483160,
      "end_ms": 485090,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 1667,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 485390,
      "end_ms": 487090,
      "text": "难怪你每次都能接的这么快，",
      "token_start": 1676,
      "token_end_exclusive": 1688
    },
    {
      "start_ms": 487770,
      "end_ms": 489230,
      "text": "这种东西不是天生的，",
      "token_start": 1688,
      "token_end_exclusive": 1697
    },
    {
      "start_ms": 489530,
      "end_ms": 490970,
      "text": "就是平时一个场景，",
      "token_start": 1697,
      "token_end_exclusive": 1705
    },
    {
      "start_ms": 490970,
      "end_ms": 492610,
      "text": "一个场景的看一个场景，",
      "token_start": 1705,
      "token_end_exclusive": 1715
    },
    {
      "start_ms": 492610,
      "end_ms": 493450,
      "text": "一个场景的练。",
      "token_start": 1715,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 494270,
      "end_ms": 495350,
      "text": "每天看两页，",
      "token_start": 1721,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 495750,
      "end_ms": 498850,
      "text": "慢慢积累一些不同场景之下应该怎么说？",
      "token_start": 1726,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 499290,
      "end_ms": 501210,
      "text": "这里面还有很多生活里的场景，",
      "token_start": 1743,
      "token_end_exclusive": 1756
    },
    {
      "start_ms": 501430,
      "end_ms": 502770,
      "text": "比如对象给你发红包，",
      "token_start": 1756,
      "token_end_exclusive": 1765
    },
    {
      "start_ms": 502770,
      "end_ms": 505710,
      "text": "你可以回你是我支付道路上最大的功臣，",
      "token_start": 1765,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 506250,
      "end_ms": 507270,
      "text": "同时向你借钱，",
      "token_start": 1782,
      "token_end_exclusive": 1788
    },
    {
      "start_ms": 507290,
      "end_ms": 508050,
      "text": "你又不想借，",
      "token_start": 1788,
      "token_end_exclusive": 1793
    },
    {
      "start_ms": 508190,
      "end_ms": 508710,
      "text": "可以回，",
      "token_start": 1793,
      "token_end_exclusive": 1796
    },
    {
      "start_ms": 509010,
      "end_ms": 510330,
      "text": "大家都是一样的年纪，",
      "token_start": 1796,
      "token_end_exclusive": 1805
    },
    {
      "start_ms": 510350,
      "end_ms": 510950,
      "text": "你没有的，",
      "token_start": 1805,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 510950,
      "end_ms": 511590,
      "text": "我能有吗？",
      "token_start": 1809,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 511690,
      "end_ms": 512870,
      "text": "还有心仪的人跟你说，",
      "token_start": 1813,
      "token_end_exclusive": 1822
    },
    {
      "start_ms": 512870,
      "end_ms": 513865,
      "text": "我可你了，",
      "token_start": 1822,
      "token_end_exclusive": 1826
    },
    {
      "start_ms": 514080,
      "end_ms": 515740,
      "text": "你可以回随便想，",
      "token_start": 1826,
      "token_end_exclusive": 1833
    },
    {
      "start_ms": 515980,
      "end_ms": 517120,
      "text": "千万别跟我客气，",
      "token_start": 1833,
      "token_end_exclusive": 1840
    },
    {
      "start_ms": 517360,
      "end_ms": 518200,
      "text": "目前不收费，",
      "token_start": 1840,
      "token_end_exclusive": 1845
    },
    {
      "start_ms": 519640,
      "end_ms": 520480,
      "text": "这个有意思。",
      "token_start": 1845,
      "token_end_exclusive": 1850
    },
    {
      "start_ms": 520800,
      "end_ms": 522340,
      "text": "我第一次读到这些的时候，",
      "token_start": 1850,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 522340,
      "end_ms": 523760,
      "text": "也有种豁然开朗的感觉。",
      "token_start": 1861,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 524060,
      "end_ms": 527900,
      "text": "这本书就是把工作、生活、人际交往里经常遇到的场景，",
      "token_start": 1871,
      "token_end_exclusive": 1893
    },
    {
      "start_ms": 528060,
      "end_ms": 529460,
      "text": "一个一个拆开给你看，",
      "token_start": 1893,
      "token_end_exclusive": 1902
    },
    {
      "start_ms": 529740,
      "end_ms": 530560,
      "text": "别人怎么说，",
      "token_start": 1902,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 530760,
      "end_ms": 531540,
      "text": "你可以怎么接，",
      "token_start": 1907,
      "token_end_exclusive": 1913
    },
    {
      "start_ms": 531860,
      "end_ms": 533220,
      "text": "都是一句一句给你举例。",
      "token_start": 1913,
      "token_end_exclusive": 1923
    },
    {
      "start_ms": 533760,
      "end_ms": 535860,
      "text": "所以你平时就是这么练的对啊，",
      "token_start": 1923,
      "token_end_exclusive": 1936
    },
    {
      "start_ms": 536240,
      "end_ms": 538000,
      "text": "每天不用看很多看两页，",
      "token_start": 1936,
      "token_end_exclusive": 1946
    },
    {
      "start_ms": 538060,
      "end_ms": 541300,
      "text": "碰到自己觉得有用的表达就记一记慢慢积累的多了。",
      "token_start": 1946,
      "token_end_exclusive": 1968
    },
    {
      "start_ms": 541360,
      "end_ms": 543100,
      "text": "工作和生活里再碰到类似的场景，",
      "token_start": 1968,
      "token_end_exclusive": 1982
    },
    {
      "start_ms": 543100,
      "end_ms": 544490,
      "text": "你就知道怎么接接了。",
      "token_start": 1982,
      "token_end_exclusive": 1991
    },
    {
      "start_ms": 544910,
      "end_ms": 546090,
      "text": "这本先借我看看，",
      "token_start": 1991,
      "token_end_exclusive": 1998
    },
    {
      "start_ms": 546430,
      "end_ms": 546990,
      "text": "拿去吧，",
      "token_start": 1998,
      "token_end_exclusive": 2001
    },
    {
      "start_ms": 546990,
      "end_ms": 547815,
      "text": "回去慢慢看。",
      "token_start": 2001,
      "token_end_exclusive": 2006
    }
