{
  "video_id": "v_b9f5e9bc1128d82f",
  "duration_s": 223.036,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b9f5e9bc1128d82f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b9f5e9bc1128d82f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 400,
      "end_ms": 800,
      "text": "朱君，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1080,
      "end_ms": 1880,
      "text": "你相信吗？",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 2060,
      "end_ms": 3320,
      "text": "想改变人的一生，",
      "token_start": 6,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3320,
      "end_ms": 5460,
      "text": "就四个字物归原位，",
      "token_start": 13,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5840,
      "end_ms": 7860,
      "text": "这个好习惯一定要从小培养。",
      "token_start": 21,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8100,
      "end_ms": 9880,
      "text": "当你用完物品放回原处，",
      "token_start": 33,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 9900,
      "end_ms": 11800,
      "text": "可以减少你百分之九十的家务，",
      "token_start": 43,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 11940,
      "end_ms": 13000,
      "text": "这不是强迫症，",
      "token_start": 56,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 13060,
      "end_ms": 13880,
      "text": "这叫归位。",
      "token_start": 62,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 13880,
      "end_ms": 17240,
      "text": "习惯是把内耗降到最低的生活智慧，",
      "token_start": 66,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 17500,
      "end_ms": 18280,
      "text": "你能想象吗？",
      "token_start": 81,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 18280,
      "end_ms": 20540,
      "text": "如果一个人突然开始变得不讲卫生，",
      "token_start": 86,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 20720,
      "end_ms": 23400,
      "text": "家里乱糟糟的垃圾堆着懒得扔，",
      "token_start": 101,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 23520,
      "end_ms": 24900,
      "text": "东西也放的乱七八糟，",
      "token_start": 114,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 24900,
      "end_ms": 25620,
      "text": "不想收拾，",
      "token_start": 123,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 25900,
      "end_ms": 28260,
      "text": "并且无法自控的习惯性熬夜，",
      "token_start": 127,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 28480,
      "end_ms": 31930,
      "text": "那说明这个人很可能已经被心理问题快拖垮了。",
      "token_start": 139,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 32350,
      "end_ms": 35830,
      "text": "人在疲惫的时候会滋生出冷漠和暴躁。",
      "token_start": 159,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 36170,
      "end_ms": 37990,
      "text": "人在贫穷拮据的时候，",
      "token_start": 175,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 38050,
      "end_ms": 40070,
      "text": "就会变得狭隘和自私人，",
      "token_start": 184,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 40070,
      "end_ms": 41330,
      "text": "只有在快乐的时候，",
      "token_start": 194,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 41410,
      "end_ms": 43550,
      "text": "才会产生出包容和乐观。",
      "token_start": 202,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 43790,
      "end_ms": 45170,
      "text": "很多时候所谓的性格，",
      "token_start": 212,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 45270,
      "end_ms": 47250,
      "text": "其实并不是一个人的固定品格，",
      "token_start": 221,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 47410,
      "end_ms": 49230,
      "text": "而是他所处状态的外形。",
      "token_start": 234,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 49490,
      "end_ms": 51230,
      "text": "比如说我最近写稿子写不出来，",
      "token_start": 244,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 51230,
      "end_ms": 51930,
      "text": "特别烦躁，",
      "token_start": 257,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 52150,
      "end_ms": 54610,
      "text": "而我做的第一件事情就是收拾屋子，",
      "token_start": 261,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 54650,
      "end_ms": 55390,
      "text": "打扫卫生，",
      "token_start": 276,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 55590,
      "end_ms": 58050,
      "text": "先让我的生活恢复秩序垃圾，",
      "token_start": 280,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 58050,
      "end_ms": 58870,
      "text": "该扔的扔掉，",
      "token_start": 292,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 59030,
      "end_ms": 59885,
      "text": "闲置的东西，",
      "token_start": 297,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 60110,
      "end_ms": 61150,
      "text": "该处理的处理掉。",
      "token_start": 302,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 61230,
      "end_ms": 63865,
      "text": "我整个人心理状态会特别清爽舒服，",
      "token_start": 309,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 64280,
      "end_ms": 65240,
      "text": "你也可以试一下。",
      "token_start": 324,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 65320,
      "end_ms": 67660,
      "text": "当你内在的秩序无法维持的时候，",
      "token_start": 331,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 67720,
      "end_ms": 69465,
      "text": "可以尝试建立外在的秩序。",
      "token_start": 345,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 69810,
      "end_ms": 72330,
      "text": "通过外部的秩序来回馈到你的内心，",
      "token_start": 356,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 72450,
      "end_ms": 75105,
      "text": "让你重拾对生活、对自我的掌控感。",
      "token_start": 371,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 75510,
      "end_ms": 76295,
      "text": "你有没有想过，",
      "token_start": 385,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 76510,
      "end_ms": 79210,
      "text": "为什么有些人他的家里永远干净整洁，",
      "token_start": 391,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 79270,
      "end_ms": 80565,
      "text": "事业顺风顺水，",
      "token_start": 407,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 80880,
      "end_ms": 82420,
      "text": "而有些人明明很努力，",
      "token_start": 413,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 82500,
      "end_ms": 85255,
      "text": "却总感觉被一种看不见的力量拖着后腿，",
      "token_start": 422,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 85670,
      "end_ms": 86275,
      "text": "你知道吗？",
      "token_start": 439,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 86540,
      "end_ms": 87945,
      "text": "你家里的那些杂物，",
      "token_start": 443,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 88220,
      "end_ms": 89785,
      "text": "甚至冰箱里的过期食品，",
      "token_start": 451,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 90020,
      "end_ms": 92120,
      "text": "都在悄悄消耗着你的能量，",
      "token_start": 461,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 92240,
      "end_ms": 93925,
      "text": "影响着你人生的走向。",
      "token_start": 472,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 94370,
      "end_ms": 96750,
      "text": "如果你想真正掌控生活的秩序感，",
      "token_start": 481,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 96770,
      "end_ms": 97535,
      "text": "一定要记住哦。",
      "token_start": 495,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 97940,
      "end_ms": 101220,
      "text": "使用频次越高的东西越该选用好的，",
      "token_start": 501,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 101360,
      "end_ms": 103340,
      "text": "而每周使用不超过三次的物品，",
      "token_start": 516,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 103420,
      "end_ms": 104845,
      "text": "就尽量没必要买回家。",
      "token_start": 529,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 105200,
      "end_ms": 107545,
      "text": "越复杂的东西故障风险越高。",
      "token_start": 538,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 107890,
      "end_ms": 110615,
      "text": "越精致美观的东西便携性越差。",
      "token_start": 550,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 110990,
      "end_ms": 112465,
      "text": "集成度越高的东西，",
      "token_start": 563,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 112660,
      "end_ms": 113540,
      "text": "专业性越弱，",
      "token_start": 571,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 113660,
      "end_ms": 115725,
      "text": "这就是消费领域最为明智的法则。",
      "token_start": 576,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 116180,
      "end_ms": 118680,
      "text": "要明确你的核心需求在关键处，",
      "token_start": 590,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 118680,
      "end_ms": 120855,
      "text": "专注在冗余处舍弃。",
      "token_start": 603,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 121290,
      "end_ms": 122990,
      "text": "老话说秋后算账，",
      "token_start": 611,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 123250,
      "end_ms": 124770,
      "text": "其实人到秋天真的得算。",
      "token_start": 618,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 124770,
      "end_ms": 127160,
      "text": "一、算账消耗你的人要断，",
      "token_start": 628,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 127420,
      "end_ms": 128920,
      "text": "第一回报的事儿要清。",
      "token_start": 638,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 128920,
      "end_ms": 130950,
      "text": "一清攒了好久的塑料袋儿，",
      "token_start": 647,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 130950,
      "end_ms": 132445,
      "text": "多年不穿的旧衣服等等，",
      "token_start": 658,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 132620,
      "end_ms": 133215,
      "text": "都扔一扔，",
      "token_start": 668,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 133520,
      "end_ms": 135840,
      "text": "大胆的先很多人什么东西都攒着，",
      "token_start": 672,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 135840,
      "end_ms": 136855,
      "text": "什么都舍不得扔。",
      "token_start": 686,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 137180,
      "end_ms": 139680,
      "text": "辣酱瓶子、茶叶、罐子、月饼盒子，",
      "token_start": 693,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 139680,
      "end_ms": 140745,
      "text": "各种外卖袋子，",
      "token_start": 705,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 140950,
      "end_ms": 141615,
      "text": "什么都存，",
      "token_start": 711,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 141830,
      "end_ms": 142575,
      "text": "就是不存钱。",
      "token_start": 715,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 142850,
      "end_ms": 143710,
      "text": "但是你相信吗，",
      "token_start": 720,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 143850,
      "end_ms": 144950,
      "text": "你越扔东西，",
      "token_start": 726,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 144950,
      "end_ms": 146730,
      "text": "你就活得越好一个东西。",
      "token_start": 731,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 146730,
      "end_ms": 147790,
      "text": "如果长期不使用，",
      "token_start": 741,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 147790,
      "end_ms": 149130,
      "text": "你不和它发生联系，",
      "token_start": 748,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 149210,
      "end_ms": 151445,
      "text": "它还会偷偷吸走你的能量。",
      "token_start": 756,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 151980,
      "end_ms": 152480,
      "text": "古人说，",
      "token_start": 767,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 152620,
      "end_ms": 155580,
      "text": "秋收东藏每一年一到秋天，",
      "token_start": 770,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 155720,
      "end_ms": 157575,
      "text": "你可以扔几件没用的东西，",
      "token_start": 781,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 157850,
      "end_ms": 159485,
      "text": "扔掉讨厌的人就更好，",
      "token_start": 792,
      "token_end_exclusive": 801
    },
    {
      "start_ms": 159810,
      "end_ms": 161735,
      "text": "你会莫名其妙的变得幸运。",
      "token_start": 801,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 162160,
      "end_ms": 164240,
      "text": "传统文化中秋对应着金，",
      "token_start": 812,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 164460,
      "end_ms": 166105,
      "text": "代表着收敛裁决，",
      "token_start": 822,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 166410,
      "end_ms": 167430,
      "text": "所谓秋后算账。",
      "token_start": 829,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 167530,
      "end_ms": 168390,
      "text": "秋天的天时，",
      "token_start": 835,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 168390,
      "end_ms": 170460,
      "text": "就是让你舍弃不舍，",
      "token_start": 840,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 170520,
      "end_ms": 174025,
      "text": "就不得有舍才有得这就是今生水。",
      "token_start": 848,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 174670,
      "end_ms": 176190,
      "text": "你一定要相信大钱，",
      "token_start": 862,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 176230,
      "end_ms": 178005,
      "text": "喜欢空喜欢安静，",
      "token_start": 870,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 178350,
      "end_ms": 179475,
      "text": "越空越有钱。",
      "token_start": 877,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 179850,
      "end_ms": 181770,
      "text": "收起那些廉价的囤积欲，",
      "token_start": 882,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 181890,
      "end_ms": 183005,
      "text": "清空你的环境。",
      "token_start": 892,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 183380,
      "end_ms": 184140,
      "text": "空间越满，",
      "token_start": 898,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 184220,
      "end_ms": 185020,
      "text": "焦虑越重，",
      "token_start": 902,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 185060,
      "end_ms": 185780,
      "text": "欲望越多，",
      "token_start": 906,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 185940,
      "end_ms": 186955,
      "text": "判断越乱。",
      "token_start": 910,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 187220,
      "end_ms": 189330,
      "text": "而真正的清醒是清空环境，",
      "token_start": 914,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 189470,
      "end_ms": 190670,
      "text": "清空无效社交，",
      "token_start": 925,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 190810,
      "end_ms": 192115,
      "text": "清空廉价信息。",
      "token_start": 931,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 192760,
      "end_ms": 195260,
      "text": "有一种富有叫干净普通人的家，",
      "token_start": 937,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 195320,
      "end_ms": 196625,
      "text": "因为干净而富足，",
      "token_start": 950,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 196910,
      "end_ms": 197505,
      "text": "因为干净，",
      "token_start": 957,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 197730,
      "end_ms": 200515,
      "text": "所以心情舒畅自然会带来福气。",
      "token_start": 961,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 201100,
      "end_ms": 203125,
      "text": "究今夏天已经结束了，",
      "token_start": 974,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 203350,
      "end_ms": 203910,
      "text": "一转眼，",
      "token_start": 983,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 203930,
      "end_ms": 206725,
      "text": "二零二六年也只剩下三分之一。",
      "token_start": 986,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 207110,
      "end_ms": 209245,
      "text": "把时间献给最值得的人和事儿，",
      "token_start": 999,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 209470,
      "end_ms": 210710,
      "text": "扔掉那些很久不用，",
      "token_start": 1012,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 210710,
      "end_ms": 212115,
      "text": "以后也不会再用的东西，",
      "token_start": 1020,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 212430,
      "end_ms": 214625,
      "text": "扔掉你内心所有的抱怨和杂念，",
      "token_start": 1030,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 214860,
      "end_ms": 217015,
      "text": "扔掉所有让你不舒服的关系，",
      "token_start": 1043,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 217280,
      "end_ms": 219505,
      "text": "让自己轻盈轻装上阵。",
