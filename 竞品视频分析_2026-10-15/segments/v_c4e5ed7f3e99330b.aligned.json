{
  "video_id": "v_c4e5ed7f3e99330b",
  "duration_s": 460.758621,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c4e5ed7f3e99330b.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c4e5ed7f3e99330b.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 590,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 590,
      "end_ms": 4710,
      "text": "咱们说到叶启孙最得意的学生熊大枕去了前线，",
      "token_start": 2,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5270,
      "end_ms": 5970,
      "text": "师徒俩，",
      "token_start": 22,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 6010,
      "end_ms": 7710,
      "text": "一起造炸药打鬼子。",
      "token_start": 25,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 8090,
      "end_ms": 9850,
      "text": "可接下来发生的事儿，",
      "token_start": 33,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 9850,
      "end_ms": 12530,
      "text": "我每次想起来心里都堵的慌。",
      "token_start": 42,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 12570,
      "end_ms": 14070,
      "text": "一九三九年，",
      "token_start": 54,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 14070,
      "end_ms": 17330,
      "text": "熊大枕被人扣上了特务的帽子，",
      "token_start": 59,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 17370,
      "end_ms": 21230,
      "text": "含冤而死死的时候才二十六岁。",
      "token_start": 72,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 21270,
      "end_ms": 23690,
      "text": "叶启孙听到消息的时候，",
      "token_start": 85,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 23730,
      "end_ms": 25470,
      "text": "整个人都懵了，",
      "token_start": 95,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 25470,
      "end_ms": 28030,
      "text": "那是他最欣赏的学生啊，",
      "token_start": 101,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 28070,
      "end_ms": 29750,
      "text": "跟亲儿子一样，",
      "token_start": 111,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 29750,
      "end_ms": 33160,
      "text": "活活生生一个人说没就没了。",
      "token_start": 117,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 34180,
      "end_ms": 34960,
      "text": "从那以后，",
      "token_start": 129,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 35040,
      "end_ms": 37480,
      "text": "叶启孙就落下了一块心病。",
      "token_start": 133,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38199,
      "end_ms": 41000,
      "text": "他始终不相信自己的学生，",
      "token_start": 144,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 41280,
      "end_ms": 42080,
      "text": "是那种人，",
      "token_start": 155,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 43040,
      "end_ms": 47100,
      "text": "先后好几次通过正常渠道为熊大诊申诉。",
      "token_start": 159,
      "token_end_exclusive": 176
    },
    {
      "start_ms": 47680,
      "end_ms": 49320,
      "text": "可在那个特殊的年代，",
      "token_start": 176,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 49800,
      "end_ms": 51940,
      "text": "说真话是要付出代价的。",
      "token_start": 185,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 52860,
      "end_ms": 53980,
      "text": "一九六七年，",
      "token_start": 195,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 54820,
      "end_ms": 58120,
      "text": "六十九岁的叶启孙受到冲击，",
      "token_start": 200,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 58960,
      "end_ms": 61800,
      "text": "被关押停发工资，",
      "token_start": 212,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 62040,
      "end_ms": 63675,
      "text": "还被送进了劳改队。",
      "token_start": 219,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 64510,
      "end_ms": 66545,
      "text": "一个快七十岁的老人，",
      "token_start": 227,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 66960,
      "end_ms": 71445,
      "text": "哪里受得了这个他一度精神恍惚，",
      "token_start": 236,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 72340,
      "end_ms": 74825,
      "text": "总听见广播里说他是特务。",
      "token_start": 250,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 76900,
      "end_ms": 78360,
      "text": "一九六八年四月，",
      "token_start": 261,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 78380,
      "end_ms": 82015,
      "text": "七十岁的叶启孙因为熊大枕的案子受牵连，",
      "token_start": 268,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 82340,
      "end_ms": 83480,
      "text": "被正式逮捕，",
      "token_start": 286,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 83540,
      "end_ms": 85515,
      "text": "关押在里面。",
      "token_start": 291,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 85810,
      "end_ms": 87945,
      "text": "他受过八次连续提审，",
      "token_start": 296,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 88270,
      "end_ms": 89685,
      "text": "写过多次笔供，",
      "token_start": 305,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 90520,
      "end_ms": 94715,
      "text": "可他从头到尾始终不肯说一句违心的话。",
      "token_start": 311,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 95150,
      "end_ms": 96865,
      "text": "一九六九年十一月，",
      "token_start": 328,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 97220,
      "end_ms": 98515,
      "text": "因为查无实据，",
      "token_start": 336,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 98850,
      "end_ms": 100955,
      "text": "叶启孙被释放回北大。",
      "token_start": 342,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 101770,
      "end_ms": 103375,
      "text": "可教授待遇取消了，",
      "token_start": 351,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 103720,
      "end_ms": 106975,
      "text": "房子没收了每月只发五十元生活费，",
      "token_start": 359,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 107360,
      "end_ms": 109305,
      "text": "还继续被隔离审查。",
      "token_start": 374,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 109800,
      "end_ms": 113015,
      "text": "他住进了一间又黑又破的房子，",
      "token_start": 382,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 113880,
      "end_ms": 115000,
      "text": "照顾他的工友，",
      "token_start": 395,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 115180,
      "end_ms": 116180,
      "text": "也被遣返。",
      "token_start": 401,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 116340,
      "end_ms": 117265,
      "text": "从那以后，",
      "token_start": 405,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 117610,
      "end_ms": 121445,
      "text": "中关村一带很多人都见过那个穿破棉袄，",
      "token_start": 409,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 121730,
      "end_ms": 124545,
      "text": "弓着背的老人在街头徘徊，",
      "token_start": 426,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 125260,
      "end_ms": 129415,
      "text": "碰到熟识的学生才低着头轻声说一句，",
      "token_start": 437,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 130050,
      "end_ms": 132960,
      "text": "你有钱给我几个所求，",
      "token_start": 453,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 132960,
      "end_ms": 134025,
      "text": "不过三五块，",
      "token_start": 462,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 135020,
      "end_ms": 136925,
      "text": "最让人心疼的是什么？",
      "token_start": 467,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 137180,
      "end_ms": 139005,
      "text": "他故意躲着自己的学生。",
      "token_start": 476,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 139880,
      "end_ms": 140380,
      "text": "那时候，",
      "token_start": 486,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 140380,
      "end_ms": 144305,
      "text": "他的学生们都在参与国家最重要的科研项目，",
      "token_start": 489,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 144870,
      "end_ms": 148895,
      "text": "造原子弹、造导弹发射卫星，",
      "token_start": 508,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 149370,
      "end_ms": 151185,
      "text": "个个都是国家的宝贝。",
      "token_start": 519,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 151760,
      "end_ms": 154300,
      "text": "叶启孙怕自己的身份连累他们，",
      "token_start": 528,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 154340,
      "end_ms": 156685,
      "text": "每次远远看见学生的身影，",
      "token_start": 541,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 157150,
      "end_ms": 158165,
      "text": "赶紧低下头，",
      "token_start": 552,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 158680,
      "end_ms": 160185,
      "text": "拐进胡同里就走掉了。",
      "token_start": 557,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 160850,
      "end_ms": 162405,
      "text": "他宁肯自己苦着，",
      "token_start": 566,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 162810,
      "end_ms": 164925,
      "text": "也不愿意给学生添一点麻烦。",
      "token_start": 573,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 167480,
      "end_ms": 171845,
      "text": "有一次他的学生钱三强在中关村的马路上碰到了他。",
      "token_start": 585,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 172650,
      "end_ms": 173735,
      "text": "钱三强是谁？",
      "token_start": 607,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 174110,
      "end_ms": 175545,
      "text": "中国原子弹之父啊。",
      "token_start": 612,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 175920,
      "end_ms": 176220,
      "text": "那天，",
      "token_start": 620,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 176220,
      "end_ms": 177105,
      "text": "他走在路上，",
      "token_start": 622,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 177800,
      "end_ms": 180200,
      "text": "看见一个衣衫褴褛的老人，",
      "token_start": 627,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 180260,
      "end_ms": 182035,
      "text": "弓着背在前面慢慢走，",
      "token_start": 638,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 182540,
      "end_ms": 183575,
      "text": "走近了一看，",
      "token_start": 647,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 183870,
      "end_ms": 185525,
      "text": "浑身唰的一下就凉了，",
      "token_start": 652,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 186430,
      "end_ms": 187750,
      "text": "这不是自己的老师。",
      "token_start": 661,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 187750,
      "end_ms": 188670,
      "text": "叶启孙吗？",
      "token_start": 669,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 188770,
      "end_ms": 190715,
      "text": "前三强赶紧跑上去，",
      "token_start": 673,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 191070,
      "end_ms": 192165,
      "text": "拉住老师的手，",
      "token_start": 681,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 192500,
      "end_ms": 193585,
      "text": "声音都在发抖。",
      "token_start": 687,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 194070,
      "end_ms": 194635,
      "text": "先生，",
      "token_start": 693,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 195000,
      "end_ms": 195985,
      "text": "怎么是您呢？",
      "token_start": 695,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 196340,
      "end_ms": 198065,
      "text": "您怎么变成这个样子了？",
      "token_start": 700,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 198710,
      "end_ms": 201495,
      "text": "叶启孙听到声音猛的抬起头，",
      "token_start": 710,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 202030,
      "end_ms": 203675,
      "text": "看清是前三强之后，",
      "token_start": 722,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 204030,
      "end_ms": 205660,
      "text": "第一反应不是哭，",
      "token_start": 730,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 205860,
      "end_ms": 206635,
      "text": "不是诉苦，",
      "token_start": 737,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 206990,
      "end_ms": 208625,
      "text": "而是使劲推开他。",
      "token_start": 741,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 209030,
      "end_ms": 209995,
      "text": "压低声音说，",
      "token_start": 748,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 210560,
      "end_ms": 211720,
      "text": "你赶快离开我，",
      "token_start": 753,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 211940,
      "end_ms": 212895,
      "text": "赶快躲开，",
      "token_start": 759,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 213250,
      "end_ms": 214395,
      "text": "以后见到我，",
      "token_start": 763,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 214850,
      "end_ms": 215695,
      "text": "别打招呼。",
      "token_start": 768,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 216010,
      "end_ms": 218780,
      "text": "说完转身就往胡同深处走，",
      "token_start": 772,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 219000,
      "end_ms": 220135,
      "text": "一步都没回头。",
      "token_start": 783,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 221060,
      "end_ms": 222420,
      "text": "钱三强站在原地，",
      "token_start": 789,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 222500,
      "end_ms": 225765,
      "text": "看着老师佝偻的背影消失在巷子里，",
      "token_start": 796,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 226030,
      "end_ms": 227625,
      "text": "眼泪止不住的流。",
      "token_start": 811,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 228210,
      "end_ms": 232515,
      "text": "后来他每次跟人提起这件事都泪流满面的说，",
      "token_start": 818,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 232960,
      "end_ms": 234805,
      "text": "老师到最后都在保护我们，",
      "token_start": 837,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 235390,
      "end_ms": 238265,
      "text": "他是用自己最后的力气在护着我们啊。",
      "token_start": 848,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 239270,
      "end_ms": 241015,
      "text": "叶启孙一辈子没结婚，",
      "token_start": 864,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 241290,
      "end_ms": 242025,
      "text": "无儿无女，",
      "token_start": 873,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 242960,
      "end_ms": 245875,
      "text": "他把所有学生都当成自己的孩子。",
      "token_start": 877,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 246650,
      "end_ms": 247605,
      "text": "可到最后，",
      "token_start": 891,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 248180,
      "end_ms": 251425,
      "text": "他连一个给自己养老送终的人都没有。",
      "token_start": 895,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 251870,
      "end_ms": 253355,
      "text": "一九七二年五月，",
      "token_start": 911,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 253810,
      "end_ms": 258800,
      "text": "上面终于宣布对叶启孙按人民内部矛盾处理，",
      "token_start": 918,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 258820,
      "end_ms": 261005,
      "text": "恢复了教授待遇和工资。",
      "token_start": 937,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 261500,
      "end_ms": 262965,
      "text": "也分配了住房，",
      "token_start": 947,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 263630,
      "end_ms": 267525,
      "text": "可他的身体和精神已经被彻底摧垮。",
      "token_start": 953,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 268540,
      "end_ms": 270715,
      "text": "一九七七年一月十三日，",
      "token_start": 968,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 271110,
      "end_ms": 272745,
      "text": "一个寒冷的冬夜，",
      "token_start": 978,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 273450,
      "end_ms": 275130,
      "text": "叶启孙在医院去世，",
      "token_start": 985,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 275450,
      "end_ms": 276905,
      "text": "享年七十九岁。",
      "token_start": 993,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 277840,
      "end_ms": 278820,
      "text": "一九九二年，",
      "token_start": 999,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 279020,
      "end_ms": 286220,
      "text": "王淦昌、王大航、吴建雄等一百二十七位海内外知名学者联名上书，",
      "token_start": 1004,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 286600,
      "end_ms": 290125,
      "text": "呼吁清华大学为叶启孙建立铜像。",
      "token_start": 1031,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 290760,
      "end_ms": 294000,
      "text": "联悯者平均年龄高达七十多岁，",
      "token_start": 1045,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 294440,
      "end_ms": 297495,
      "text": "很多人都是坐着轮椅来签字的。",
      "token_start": 1058,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 298740,
      "end_ms": 299720,
      "text": "一九九五年，",
      "token_start": 1071,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 299920,
      "end_ms": 303100,
      "text": "叶启孙的铜像终于在清华大学落成，",
      "token_start": 1076,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 303600,
      "end_ms": 306735,
      "text": "可没有放在校园最显眼的地方。",
      "token_start": 1091,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 307270,
      "end_ms": 310370,
      "text": "而是放在了第三教室楼的门厅里。",
      "token_start": 1104,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 310990,
      "end_ms": 311870,
      "text": "节幕那天，",
      "token_start": 1118,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 312130,
      "end_ms": 316230,
      "text": "九十岁的王淦昌被人搀着走到铜像前，",
      "token_start": 1122,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 316890,
      "end_ms": 319350,
      "text": "伸出手抱住那冰冷的铜像，",
      "token_start": 1138,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 320110,
      "end_ms": 321690,
      "text": "很久很久没有说话，",
      "token_start": 1149,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 322590,
      "end_ms": 326950,
      "text": "在场许多白发苍苍的老科学家都红了眼眶。",
      "token_start": 1157,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 328010,
      "end_ms": 329350,
      "text": "叶启孙这一生，",
      "token_start": 1175,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 330070,
      "end_ms": 332870,
      "text": "没有亲手发射过一颗卫星，",
      "token_start": 1181,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 333230,
      "end_ms": 335930,
      "text": "没有亲手制造过一颗原子弹，",
      "token_start": 1192,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 336410,
      "end_ms": 339900,
      "text": "可后来撑起整个中国科技天空的那批人，",
      "token_start": 1204,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 340020,
      "end_ms": 344280,
      "text": "全都是被他一点一点一个一个托起来的。",
      "token_start": 1221,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 344960,
      "end_ms": 346780,
      "text": "他在荒漠里播下种子，",
      "token_start": 1238,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 347140,
      "end_ms": 349420,
      "text": "如今早已是巨树参天。",
      "token_start": 1247,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 350160,
      "end_ms": 351280,
      "text": "今天这个时代，",
      "token_start": 1256,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 351520,
      "end_ms": 353299,
      "text": "太多人追名逐利，",
      "token_start": 1262,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 353780,
      "end_ms": 356060,
      "text": "太多人想当网红赚快钱，",
      "token_start": 1269,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 356280,
      "end_ms": 358880,
      "text": "可真正撑起一个民族脊梁的，",
      "token_start": 1279,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 359160,
      "end_ms": 361560,
      "text": "从来都是叶启孙这样的人。",
      "token_start": 1291,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 361920,
      "end_ms": 362880,
      "text": "他们沉默，",
      "token_start": 1302,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 363160,
      "end_ms": 364140,
      "text": "他们付出，",
      "token_start": 1306,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 364400,
      "end_ms": 365460,
      "text": "他们被遗忘。",
      "token_start": 1310,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 365640,
      "end_ms": 367745,
      "text": "可他们从来没有后悔过。",
      "token_start": 1315,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 368210,
      "end_ms": 369010,
      "text": "如果有一天，",
      "token_start": 1325,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 369310,
      "end_ms": 373055,
      "text": "我们连叶启孙这样的名字都觉得陌生了，",
      "token_start": 1330,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 373630,
      "end_ms": 376550,
      "text": "那才是这个民族真正可怕的事情。",
      "token_start": 1347,
      "token_end_exclusive": 1361
    },
    {
      "start_ms": 376650,
      "end_ms": 382615,
      "text": "记住他叶启孙一个最不该被我们忘记的人说到这儿，",
      "token_start": 1361,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 382910,
      "end_ms": 385485,
      "text": "想起之前在朋友家翻看到这本书，",
      "token_start": 1383,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 386140,
      "end_ms": 387075,
      "text": "国之脊梁。",
      "token_start": 1397,
      "token_end_exclusive": 1401
    },
    {
      "start_ms": 387710,
      "end_ms": 393365,
      "text": "叶启孙的故事就在第一篇标题就叫大师的大师。",
      "token_start": 1401,
      "token_end_exclusive": 1421
    },
    {
      "start_ms": 394320,
      "end_ms": 396060,
      "text": "书里不光有叶启孙，",
      "token_start": 1421,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 396440,
      "end_ms": 401325,
      "text": "还有他的学生王赣昌、赵九章、钱三强、钱学森。",
      "token_start": 1429,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 402030,
      "end_ms": 404385,
      "text": "就是我前面讲过的那些大科学家，",
      "token_start": 1447,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 404990,
      "end_ms": 408185,
      "text": "一个不落全在里面，",
      "token_start": 1461,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 409100,
      "end_ms": 413420,
      "text": "每一位讲出来都看得热泪盈眶。",
      "token_start": 1469,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 413620,
      "end_ms": 414355,
      "text": "你想想，",
      "token_start": 1482,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 414650,
      "end_ms": 415930,
      "text": "当年条件那么苦，",
      "token_start": 1485,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 416090,
      "end_ms": 417075,
      "text": "啥都没有，",
      "token_start": 1492,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 417560,
      "end_ms": 419260,
      "text": "这些人硬是靠一股劲，",
      "token_start": 1496,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 419440,
      "end_ms": 421435,
      "text": "把中国的科学搞起来了。",
      "token_start": 1505,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 422110,
      "end_ms": 425695,
      "text": "现在的孩子天天抱着手机刷短视频，",
      "token_start": 1515,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 426310,
      "end_ms": 429555,
      "text": "真该让他们好好读读这些人的故事，",
      "token_start": 1530,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 430080,
      "end_ms": 433055,
      "text": "直到今天的好日子是怎么来的？",
      "token_start": 1545,
      "token_end_exclusive": 1558
    },
    {
      "start_ms": 433760,
      "end_ms": 434240,
      "text": "链接，",
      "token_start": 1558,
      "token_end_exclusive": 1560
    },
    {
      "start_ms": 434360,
      "end_ms": 436065,
      "text": "我放在视频左下角了，",
      "token_start": 1560,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 436480,
      "end_ms": 438845,
      "text": "感兴趣的朋友们可以去拍回家，",
      "token_start": 1569,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 439300,
      "end_ms": 440395,
      "text": "细细品读，",
      "token_start": 1582,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 441380,
      "end_ms": 444595,
      "text": "觉得这段历史值得被更多人知道的。",
      "token_start": 1586,
      "token_end_exclusive": 1601
    },
    {
      "start_ms": 445360,
      "end_ms": 446045,
      "text": "点个赞，",
      "token_start": 1601,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 446850,
      "end_ms": 447795,
      "text": "点个收藏，",
      "token_start": 1604,
      "token_end_exclusive": 1608
    },
    {
      "start_ms": 448760,
      "end_ms": 449900,
      "text": "评论区告诉我，",
      "token_start": 1608,
      "token_end_exclusive": 1614
    },
    {
      "start_ms": 449920,
      "end_ms": 451260,
      "text": "你看完是什么心情，",
      "token_start": 1614,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 451460,
      "end_ms": 453680,
      "text": "再转发给身边的亲戚朋友。",
      "token_start": 1622,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 453920,
      "end_ms": 455530,
      "text": "点个关注我，",
      "token_start": 1633,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 455530,
      "end_ms": 459045,
      "text": "后面继续给你讲那些被遗忘的大事故事。",
      "token_start": 1638,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 459430,
      "end_ms": 460575,
      "text": "一个比一个震撼。",
      "token_start": 1655,
      "token_end_exclusive": 1662
    }
  ],
