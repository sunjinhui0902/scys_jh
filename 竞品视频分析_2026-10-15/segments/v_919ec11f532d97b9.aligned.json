      "token_end_exclusive": 952
    },
    {
      "start_ms": 212170,
      "end_ms": 213155,
      "text": "得看怎么标价，",
      "token_start": 952,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 213530,
      "end_ms": 214630,
      "text": "您亲手倒的这杯，",
