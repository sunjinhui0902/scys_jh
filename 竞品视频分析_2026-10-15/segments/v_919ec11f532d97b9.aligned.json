      "token_end_exclusive": 1059
    },
    {
      "start_ms": 235140,
      "end_ms": 236195,
      "text": "好好好好好，",
      "token_start": 1059,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 236500,
      "end_ms": 237605,
      "text": "怎么你这一入职，",
