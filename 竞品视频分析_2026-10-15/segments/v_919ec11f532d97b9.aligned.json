      "token_end_exclusive": 836
    },
    {
      "start_ms": 188840,
      "end_ms": 189905,
      "text": "怎么我来迟了，",
      "token_start": 836,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 190230,
      "end_ms": 192770,
      "text": "你也不打个电话催催催您是给您压力，",
      "token_start": 842,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 192850,
      "end_ms": 195035,
      "text": "等您是给您尊重您来迟肯定有原因。",
      "token_start": 858,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 195310,
      "end_ms": 196650,
      "text": "我等的就是信任到了，",
      "token_start": 873,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 196650,
      "end_ms": 200090,
      "text": "就是圆满来就来带什么礼物啊，",
      "token_start": 882,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 200110,
      "end_ms": 200985,
      "text": "都不是外人。",
      "token_start": 895,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 201260,
      "end_ms": 201660,
      "text": "哎呀，",
      "token_start": 900,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 201760,
      "end_ms": 202300,
      "text": "您都说了，",
      "token_start": 902,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 202300,
      "end_ms": 202960,
      "text": "不是外人，",
      "token_start": 906,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 203080,
      "end_ms": 204445,
      "text": "我一直都把您当长辈看，",
