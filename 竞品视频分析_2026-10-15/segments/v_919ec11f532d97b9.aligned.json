      "token_end_exclusive": 969
    },
    {
      "start_ms": 215490,
      "end_ms": 216055,
      "text": "不讲价，",
      "token_start": 969,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 216330,
      "end_ms": 220085,
      "text": "和你这么漂亮的女孩吃饭不用喝就已经醉了。",
      "token_start": 972,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 220360,
      "end_ms": 220775,
      "text": "领导，",
      "token_start": 991,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 221080,
      "end_ms": 221875,
      "text": "您真幽默，",
      "token_start": 993,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 222180,
      "end_ms": 223020,
      "text": "您还没沾酒，",
      "token_start": 997,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 223020,
      "end_ms": 223995,
      "text": "就让我沾光了。",
      "token_start": 1002,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 224320,
      "end_ms": 225960,
      "text": "哈哈哈哈哈哈哈。",
      "token_start": 1008,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 226330,
      "end_ms": 226665,
      "text": "哎，",
      "token_start": 1015,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 227260,
      "end_ms": 228165,
      "text": "你什么意思啊？",
      "token_start": 1016,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 228510,
      "end_ms": 229810,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 1022,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 230030,
      "end_ms": 231130,
      "text": "领导美满，",
      "token_start": 1033,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 231130,
      "end_ms": 231510,
      "text": "美满，",
      "token_start": 1037,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 231610,
      "end_ms": 232575,
      "text": "代表幸福美满，",
      "token_start": 1039,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 232800,
      "end_ms": 233680,
      "text": "这一辈子没满，",
      "token_start": 1045,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 233680,
      "end_ms": 234845,
      "text": "就是一辈子没满啊。",
