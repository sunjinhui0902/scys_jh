      "token_end_exclusive": 1176
    },
    {
      "start_ms": 262930,
      "end_ms": 264110,
      "text": "气色当然不会差了。",
      "token_start": 1176,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 266090,
      "end_ms": 266750,
