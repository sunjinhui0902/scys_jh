      "token_end_exclusive": 1289
    },
    {
      "start_ms": 292250,
      "end_ms": 296715,
      "text": "这我懂小李最近表现不错啊。",
      "token_start": 1289,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 297090,
      "end_ms": 299090,
      "text": "我的这个位置马上就该你坐了，",
