      "token_end_exclusive": 1392
    },
    {
      "start_ms": 312370,
      "end_ms": 313130,
      "text": "无论结果如何，",
      "token_start": 1392,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 313130,
      "end_ms": 313690,
      "text": "都得感谢。",
      "token_start": 1398,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 313690,
      "end_ms": 314690,
      "text": "领导您的提携啊，",
      "token_start": 1402,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 315470,
      "end_ms": 317090,
      "text": "你一开口就让人喜欢你，",
      "token_start": 1409,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 317290,
      "end_ms": 318290,
      "text": "你是怎么做到的？",
      "token_start": 1419,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 318530,
      "end_ms": 320690,
      "text": "因为我一直在看这本闲谈高手，",
