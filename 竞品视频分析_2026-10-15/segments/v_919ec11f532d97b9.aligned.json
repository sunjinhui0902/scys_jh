{
  "video_id": "v_919ec11f532d97b9",
  "duration_s": 386.357007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_919ec11f532d97b9.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_919ec11f532d97b9.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 830,
      "text": "小王啊，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 1510,
      "end_ms": 3390,
      "text": "你个子是真高比，",
      "token_start": 3,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3390,
      "end_ms": 4470,
      "text": "我还高一头呢。",
      "token_start": 10,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4670,
      "end_ms": 8270,
      "text": "个高是为了给领导探路走哪儿不还是得听领导指挥吗？",
      "token_start": 16,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 10210,
      "end_ms": 10830,
      "text": "小王站，",
      "token_start": 39,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 10830,
      "end_ms": 14710,
      "text": "我旁边不怕把你照老了站您旁边哪会显老，",
      "token_start": 42,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 15010,
      "end_ms": 19210,
      "text": "只会显得我年纪轻轻站的挺对我，",
      "token_start": 60,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 19210,
      "end_ms": 20510,
      "text": "真不怎么喜欢你。",
      "token_start": 74,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21230,
      "end_ms": 23270,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 81,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 23270,
      "end_ms": 25470,
      "text": "我领导的格局值得我们学习。",
      "token_start": 94,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 28030,
      "end_ms": 29605,
      "text": "但这人脾气挺好，",
      "token_start": 106,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 30160,
      "end_ms": 31200,
      "text": "没见你发过火，",
      "token_start": 113,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 31660,
      "end_ms": 32060,
      "text": "发火，",
      "token_start": 119,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 32060,
      "end_ms": 33000,
      "text": "解决不了问题，",
      "token_start": 121,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 33460,
      "end_ms": 34740,
      "text": "您在前面顶着压力，",
      "token_start": 127,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 34740,
      "end_ms": 36300,
      "text": "我在后面添乱不合适。",
      "token_start": 135,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38119,
      "end_ms": 39220,
      "text": "年轻就是好啊，",
      "token_start": 144,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 39820,
      "end_ms": 41560,
      "text": "年轻就是还不够沉稳，",
      "token_start": 150,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 41860,
      "end_ms": 43000,
      "text": "还要向您多学习，",
      "token_start": 159,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 43120,
      "end_ms": 44260,
      "text": "我们才能变得更优秀。",
      "token_start": 166,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 46240,
      "end_ms": 46660,
      "text": "哎呀，",
      "token_start": 175,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 46980,
      "end_ms": 47860,
      "text": "我都老了，",
      "token_start": 177,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 48060,
      "end_ms": 49000,
      "text": "不中用了。",
      "token_start": 181,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 49140,
      "end_ms": 49380,
      "text": "哎，",
      "token_start": 185,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 49440,
      "end_ms": 49800,
      "text": "领导，",
      "token_start": 186,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 49800,
      "end_ms": 50840,
      "text": "您可千万别这么说，",
      "token_start": 188,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 51020,
      "end_ms": 52780,
      "text": "我们论能力、论经验论、资历多，",
      "token_start": 196,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 52780,
      "end_ms": 55320,
      "text": "不如这样的老前辈还得靠您带着我们进步啊。",
      "token_start": 208,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 55320,
      "end_ms": 57620,
      "text": "这鸭子是好鸭子，",
      "token_start": 227,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 57660,
      "end_ms": 59615,
      "text": "就是嘴硬，",
      "token_start": 234,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 61240,
      "end_ms": 61740,
      "text": "嘴硬，",
      "token_start": 238,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 61740,
      "end_ms": 62300,
      "text": "才守得住，",
      "token_start": 240,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 62300,
      "end_ms": 66120,
      "text": "秘密都吃到这个点儿了。",
      "token_start": 244,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 66120,
      "end_ms": 68800,
      "text": "你怎么还没敬我一杯敬您的人排着队呢？",
      "token_start": 254,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 68800,
      "end_ms": 70120,
      "text": "我最后一个敬前面的酒，",
      "token_start": 271,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 70120,
      "end_ms": 70880,
      "text": "您喝的是场面，",
      "token_start": 281,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 70880,
      "end_ms": 72000,
      "text": "我这杯您喝的是收尾，",
      "token_start": 287,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 72020,
      "end_ms": 73960,
      "text": "代表今天的事儿圆满啊。",
      "token_start": 296,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 75030,
      "end_ms": 76505,
      "text": "你酒量挺好的呀。",
      "token_start": 306,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 76820,
      "end_ms": 77200,
      "text": "领导，",
      "token_start": 313,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 77300,
      "end_ms": 78340,
      "text": "您可抬举我了，",
      "token_start": 315,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 78420,
      "end_ms": 79520,
      "text": "我平时真不太能喝，",
      "token_start": 321,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 79720,
      "end_ms": 81160,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 329,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 81160,
      "end_ms": 81760,
      "text": "高兴啊，",
      "token_start": 340,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 81780,
      "end_ms": 84945,
      "text": "这一高兴就多贪了几杯啊，",
      "token_start": 343,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 85080,
      "end_ms": 87135,
      "text": "你怎么就喝这点儿养鱼呢？",
      "token_start": 354,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 87550,
      "end_ms": 88330,
      "text": "我得留着量，",
      "token_start": 365,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 88450,
      "end_ms": 89470,
      "text": "万一您喝到位了，",
      "token_start": 370,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 89470,
      "end_ms": 91685,
      "text": "总得有个清醒的人负责掏您家门钥匙吧。",
      "token_start": 377,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 92730,
      "end_ms": 93090,
      "text": "爸爸，",
      "token_start": 394,
      "token_end_exclusive": 396
    },
    {
      "start_ms": 93110,
      "end_ms": 93885,
      "text": "哈哈好来好，",
      "token_start": 396,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 94970,
      "end_ms": 95990,
      "text": "今天让你破费了。",
      "token_start": 401,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 96010,
      "end_ms": 96475,
      "text": "领导，",
      "token_start": 408,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 96810,
      "end_ms": 98210,
      "text": "您说这些您能来，",
      "token_start": 410,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 98210,
      "end_ms": 99155,
      "text": "就是我的荣幸，",
      "token_start": 417,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 99460,
      "end_ms": 101140,
      "text": "以后还有很多地方向您请教。",
      "token_start": 423,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 101140,
      "end_ms": 103365,
      "text": "不是哈哈哈哈哈哈哈，",
      "token_start": 435,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 103920,
      "end_ms": 105795,
      "text": "你这敬酒的顺序是不是不对？",
      "token_start": 444,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 106110,
      "end_ms": 106990,
      "text": "怎么先敬别人，",
      "token_start": 456,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 107130,
      "end_ms": 108110,
      "text": "先把流程走完，",
      "token_start": 462,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 108250,
      "end_ms": 109110,
      "text": "最后踏踏实实，",
      "token_start": 468,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 109110,
      "end_ms": 109490,
      "text": "坐下来，",
      "token_start": 474,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 109490,
      "end_ms": 109730,
      "text": "陪您，",
      "token_start": 477,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 109730,
      "end_ms": 110630,
      "text": "慢慢喝好的，",
      "token_start": 479,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 110630,
      "end_ms": 111185,
      "text": "留到最后。",
      "token_start": 484,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 112300,
      "end_ms": 114750,
      "text": "哈哈哈哈哈哈打这么多饭，",
      "token_start": 488,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 114870,
      "end_ms": 115570,
      "text": "你喂猪呢，",
      "token_start": 499,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 115850,
      "end_ms": 116230,
      "text": "领导，",
      "token_start": 503,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 116310,
      "end_ms": 117070,
      "text": "我哪敢啊？",
      "token_start": 505,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 117210,
      "end_ms": 119215,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 509,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 119450,
      "end_ms": 120930,
      "text": "都说宰相肚里能撑船，",
      "token_start": 525,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 121130,
      "end_ms": 122475,
      "text": "更何况只是一碗饭呢。",
      "token_start": 534,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 122820,
      "end_ms": 123750,
      "text": "哈哈哈哈，",
      "token_start": 543,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 124000,
      "end_ms": 125180,
      "text": "怎么菜还没上齐，",
      "token_start": 547,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 125180,
      "end_ms": 125995,
      "text": "你就结账了，",
      "token_start": 554,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 126460,
      "end_ms": 127935,
      "text": "先结账是表明态度。",
      "token_start": 559,
      "token_end_exclusive": 567
    },
    {
      "start_ms": 128150,
      "end_ms": 129135,
      "text": "这顿饭我请定了，",
      "token_start": 567,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 129390,
      "end_ms": 130130,
      "text": "后面再加菜，",
      "token_start": 574,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 130130,
      "end_ms": 130790,
      "text": "您随便点，",
      "token_start": 579,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 130930,
      "end_ms": 131790,
      "text": "没有心理负担，",
      "token_start": 583,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 131790,
      "end_ms": 132575,
      "text": "吃了才尽兴。",
      "token_start": 589,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 133870,
      "end_ms": 135215,
      "text": "这藕是好藕啊，",
      "token_start": 594,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 135890,
      "end_ms": 137065,
      "text": "就是心眼儿太多了。",
      "token_start": 600,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 137670,
      "end_ms": 139350,
      "text": "领导藕虽然心耳多，",
      "token_start": 608,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 139350,
      "end_ms": 140595,
      "text": "但也是您的下酒菜啊。",
      "token_start": 616,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 141750,
      "end_ms": 144590,
      "text": "哈哈哈哈哈哈这鱼怎么点的这么赞。",
      "token_start": 625,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 144650,
      "end_ms": 147095,
      "text": "前面大鱼大肉最后来一口清淡的漱漱口，",
      "token_start": 640,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 147360,
      "end_ms": 149460,
      "text": "就像您听完汇报最后来一句总结，",
      "token_start": 657,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 149600,
      "end_ms": 150180,
      "text": "清清爽爽，",
      "token_start": 671,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 150180,
      "end_ms": 150665,
      "text": "散会，",
      "token_start": 675,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 151060,
      "end_ms": 151930,
      "text": "好好啊啊，",
      "token_start": 677,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 152040,
      "end_ms": 153005,
      "text": "鱼是好鱼，",
      "token_start": 681,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 153550,
      "end_ms": 155710,
      "text": "可惜就是次多领导。",
      "token_start": 685,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 155710,
      "end_ms": 156830,
      "text": "您看虽然刺多，",
      "token_start": 693,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 156830,
      "end_ms": 158530,
      "text": "但主心骨只有一根心腹，",
      "token_start": 699,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 158530,
      "end_ms": 162360,
      "text": "是没有刺的这酒开了，",
      "token_start": 709,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 162480,
      "end_ms": 163455,
      "text": "你不先给我倒，",
      "token_start": 718,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 163980,
      "end_ms": 164720,
      "text": "先到的是客，",
      "token_start": 724,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 164720,
      "end_ms": 165440,
      "text": "后到的是主。",
      "token_start": 729,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 165500,
      "end_ms": 166440,
      "text": "您是今天的主人，",
      "token_start": 734,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 166440,
      "end_ms": 167860,
      "text": "最后一杯满上代表压轴，",
      "token_start": 741,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 167940,
      "end_ms": 169755,
      "text": "全桌的福气都沉淀在您杯底。",
      "token_start": 751,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 171240,
      "end_ms": 171985,
      "text": "小王啊，",
      "token_start": 763,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 172300,
      "end_ms": 173825,
      "text": "你这菜点的也太多了，",
      "token_start": 766,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 174320,
      "end_ms": 176000,
      "text": "领导菜点的再多，",
      "token_start": 775,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 176000,
      "end_ms": 178220,
      "text": "也比不上平时您对我的照顾多这杯酒，",
      "token_start": 782,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 178300,
      "end_ms": 179055,
      "text": "我先敬您，",
      "token_start": 798,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 180610,
      "end_ms": 181850,
      "text": "你今天话怎么这么少？",
      "token_start": 802,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 182070,
      "end_ms": 182770,
      "text": "再听您说，",
      "token_start": 811,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 183030,
      "end_ms": 183490,
      "text": "酒桌上，",
      "token_start": 815,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 183490,
      "end_ms": 185305,
      "text": "您讲东西比开会时还有料，",
      "token_start": 818,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 185500,
      "end_ms": 186525,
      "text": "我舍不得打断你。",
