      "token_end_exclusive": 1367
    },
    {
      "start_ms": 308950,
      "end_ms": 309670,
      "text": "您说笑了，",
      "token_start": 1367,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 309770,
      "end_ms": 311090,
      "text": "这事儿能成是您的加持，",
