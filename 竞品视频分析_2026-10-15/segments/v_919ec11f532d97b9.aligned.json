      "token_end_exclusive": 1093
    },
    {
      "start_ms": 243070,
      "end_ms": 244850,
      "text": "看来领导您啊要发大财了，",
      "token_start": 1093,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 246390,
      "end_ms": 248730,
      "text": "怎么你一来我茶杯盖就摔碎了，",
