      "token_end_exclusive": 1566
    },
    {
      "start_ms": 345920,
      "end_ms": 346940,
      "text": "那是不优秀点，",
      "token_start": 1566,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 347000,
      "end_ms": 348320,
      "text": "怎么能和你做朋友呢？",
      "token_start": 1572,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 348660,
      "end_ms": 350340,
      "text": "当有人说你真聪明，",
      "token_start": 1581,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 350420,
      "end_ms": 352140,
      "text": "你就回近朱者赤，",
      "token_start": 1589,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 352360,
      "end_ms": 353340,
      "text": "和你在一起啊，",
