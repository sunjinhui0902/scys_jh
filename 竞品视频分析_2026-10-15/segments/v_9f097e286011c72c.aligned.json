{
  "video_id": "v_9f097e286011c72c",
  "duration_s": 407.301995,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_9f097e286011c72c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_9f097e286011c72c.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 830,
      "text": "你知道吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1050,
      "end_ms": 3690,
      "text": "咱们国家一百多座历史文化名城，",
      "token_start": 4,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4070,
      "end_ms": 6330,
      "text": "真正算得上依山傍水，",
      "token_start": 18,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 7050,
      "end_ms": 10150,
      "text": "又活了一千多年的挨着手指头数。",
      "token_start": 27,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 10450,
      "end_ms": 11530,
      "text": "也就那么十来座，",
      "token_start": 41,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 12130,
      "end_ms": 15170,
      "text": "有人说是凤凰沱江穿城而过，",
      "token_start": 48,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 15450,
      "end_ms": 17330,
      "text": "沈从文笔下的边城。",
      "token_start": 60,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 18130,
      "end_ms": 21810,
      "text": "有人说是镇远五阳河拐了一个太极湾。",
      "token_start": 68,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 22170,
      "end_ms": 25230,
      "text": "错真要论起依山傍水，",
      "token_start": 84,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 25250,
      "end_ms": 26010,
      "text": "这四个字，",
      "token_start": 93,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26410,
      "end_ms": 29635,
      "text": "凤凰和镇远连前山都进不去。",
      "token_start": 97,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 30380,
      "end_ms": 30860,
      "text": "今天，",
      "token_start": 109,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 31060,
      "end_ms": 36960,
      "text": "咱们就来盘点中国十大移山傍水的千年古城。",
      "token_start": 111,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 37660,
      "end_ms": 39880,
      "text": "先讲第十到第六，",
      "token_start": 130,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 40060,
      "end_ms": 42340,
      "text": "一座比一座有味道。",
      "token_start": 137,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 43200,
      "end_ms": 47540,
      "text": "老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 145,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 47720,
      "end_ms": 50540,
      "text": "让我看看都是谁在听。",
      "token_start": 162,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 51500,
      "end_ms": 52220,
      "text": "第十名。",
      "token_start": 171,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 52680,
      "end_ms": 59340,
      "text": "四川阆中古城在四川盆地北部嘉陵江环抱了这座城，",
      "token_start": 174,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 59700,
      "end_ms": 62300,
      "text": "两千三百多年古人，",
      "token_start": 196,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 62300,
      "end_ms": 64950,
      "text": "用八个字形容他山围，",
      "token_start": 204,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 65090,
      "end_ms": 68065,
      "text": "四面水绕三方什么意思？",
      "token_start": 213,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 68580,
      "end_ms": 70025,
      "text": "四面都是山，",
      "token_start": 223,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 70450,
      "end_ms": 71745,
      "text": "三面都是水，",
      "token_start": 228,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 72190,
      "end_ms": 74655,
      "text": "成就卧在山水中间，",
      "token_start": 233,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 75150,
      "end_ms": 77425,
      "text": "跟躺在太师椅上一样。",
      "token_start": 241,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 77930,
      "end_ms": 81215,
      "text": "阆中古城最绝的是他的格局，",
      "token_start": 250,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 81570,
      "end_ms": 85235,
      "text": "九十三条街巷全是井字形棋盘状，",
      "token_start": 262,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 85760,
      "end_ms": 88085,
      "text": "所有主阶宽度都是五到六米。",
      "token_start": 276,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 88520,
      "end_ms": 95015,
      "text": "这个宽度不是随便定的是顺着嘉陵江弯弯曲曲的地形一点点量出来，",
      "token_start": 288,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 95790,
      "end_ms": 96915,
      "text": "唐宋格局，",
      "token_start": 317,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 97330,
      "end_ms": 98285,
      "text": "明清风貌，",
      "token_start": 321,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 98660,
      "end_ms": 100565,
      "text": "两千三百年没变过。",
      "token_start": 325,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 101060,
      "end_ms": 103575,
      "text": "诗圣杜甫来过感叹了一句，",
      "token_start": 333,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 103960,
      "end_ms": 107165,
      "text": "阆州城南天下西一座城，",
      "token_start": 344,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 107480,
      "end_ms": 109620,
      "text": "把山水和日子过程了。",
      "token_start": 354,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 109620,
      "end_ms": 118270,
      "text": "一幅画第九名云南丽江古城在云南西北部玉龙雪山脚下建于，",
      "token_start": 363,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 118290,
      "end_ms": 120755,
      "text": "宋末元初八百多年了。",
      "token_start": 389,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 120940,
      "end_ms": 123465,
      "text": "这成最绝的是他没有城墙。",
      "token_start": 398,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 124360,
      "end_ms": 126380,
      "text": "您可能要问了一个古城，",
      "token_start": 409,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 126540,
      "end_ms": 127715,
      "text": "怎么能没有城墙？",
      "token_start": 419,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 128310,
      "end_ms": 130885,
      "text": "因为当年统治丽江的土司姓穆，",
      "token_start": 426,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 131410,
      "end_ms": 134735,
      "text": "木字外面加一个框就成了困子，",
      "token_start": 439,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 135050,
      "end_ms": 135655,
      "text": "不吉利，",
      "token_start": 452,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 136150,
      "end_ms": 137905,
      "text": "所以丽江古城不修墙，",
      "token_start": 455,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 138310,
      "end_ms": 140130,
      "text": "更觉得是他的水。",
      "token_start": 464,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 140150,
      "end_ms": 144050,
      "text": "玉龙雪山的冰雪融水从北边流下来，",
      "token_start": 471,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 144130,
      "end_ms": 145895,
      "text": "在城北分成了三股，",
      "token_start": 486,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 146470,
      "end_ms": 148410,
      "text": "再分成无数条细流，",
      "token_start": 494,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 148650,
      "end_ms": 152095,
      "text": "穿街过巷流进每家每户的门口。",
      "token_start": 502,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 152710,
      "end_ms": 155705,
      "text": "古城里三百多座石桥木桥，",
      "token_start": 515,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 156150,
      "end_ms": 158210,
      "text": "把整座城连成一片。",
      "token_start": 526,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 158390,
      "end_ms": 159085,
      "text": "您想想，",
      "token_start": 534,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 159540,
      "end_ms": 161460,
      "text": "水从雪山上下来，",
      "token_start": 537,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 161820,
      "end_ms": 163175,
      "text": "穿过整座城，",
      "token_start": 544,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 163500,
      "end_ms": 164385,
      "text": "再流出去，",
      "token_start": 549,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 164940,
      "end_ms": 166000,
      "text": "八百多年了。",
      "token_start": 553,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 166220,
      "end_ms": 167635,
      "text": "水还是那个路线，",
      "token_start": 558,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 167940,
      "end_ms": 168180,
      "text": "桥，",
      "token_start": 565,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 168240,
      "end_ms": 169265,
      "text": "还是那个位置，",
      "token_start": 566,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 169630,
      "end_ms": 170575,
      "text": "家家流水，",
      "token_start": 572,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 170870,
      "end_ms": 171915,
      "text": "户户垂杨。",
      "token_start": 576,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 172480,
      "end_ms": 174505,
      "text": "这城不是建在地上的，",
      "token_start": 580,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 174700,
      "end_ms": 175775,
      "text": "是长在水上。",
      "token_start": 589,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 176390,
      "end_ms": 176965,
      "text": "第八名，",
      "token_start": 594,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 177280,
      "end_ms": 183515,
      "text": "安徽徽州古城在黄山涉县始建于秦朝两千两百多年。",
      "token_start": 597,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 183950,
      "end_ms": 186405,
      "text": "这成最绝的就三个字，",
      "token_start": 619,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 186770,
      "end_ms": 189220,
      "text": "成套成怎么个套法？",
      "token_start": 628,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 189420,
      "end_ms": 190555,
      "text": "从唐代开始，",
      "token_start": 636,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 190830,
      "end_ms": 195165,
      "text": "这里是郡州府治所在地县制和府制，",
      "token_start": 641,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 195470,
      "end_ms": 197795,
      "text": "同在一座城里外面一个城，",
      "token_start": 656,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 198150,
      "end_ms": 199870,
      "text": "里面还有一个城府，",
      "token_start": 667,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 199890,
      "end_ms": 200795,
      "text": "衙在中间，",
      "token_start": 675,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 201330,
      "end_ms": 202465,
      "text": "县衙在旁边，",
      "token_start": 679,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 202930,
      "end_ms": 205195,
      "text": "一套就是一千四百多年，",
      "token_start": 684,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 205630,
      "end_ms": 208900,
      "text": "全国找不出第二座徽州古城，",
      "token_start": 694,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 208920,
      "end_ms": 213455,
      "text": "还有个别称叫没有屋顶的徽派文化艺术馆。",
      "token_start": 706,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 214350,
      "end_ms": 216490,
      "text": "舞风拱秀六水，",
      "token_start": 724,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 216550,
      "end_ms": 225490,
      "text": "回澜城里有古桥、古塔、牌坊、祠堂、民居、许国十法，",
      "token_start": 730,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 225730,
      "end_ms": 228335,
      "text": "是全国唯一一座八角牌坊，",
      "token_start": 749,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 228770,
      "end_ms": 229655,
      "text": "八根柱子，",
      "token_start": 760,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 229970,
      "end_ms": 232650,
      "text": "四面为和四百多年了，",
      "token_start": 764,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 232770,
      "end_ms": 234495,
      "text": "还立在洋河门外。",
      "token_start": 773,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 235210,
      "end_ms": 235985,
      "text": "您想想，",
      "token_start": 780,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 236560,
      "end_ms": 237640,
      "text": "山在城边，",
      "token_start": 783,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 238000,
      "end_ms": 239060,
      "text": "水在城下，",
      "token_start": 787,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 239280,
      "end_ms": 239520,
      "text": "城，",
      "token_start": 791,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 239580,
      "end_ms": 241265,
      "text": "在山水里头套着。",
      "token_start": 792,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 241650,
      "end_ms": 246825,
      "text": "这地方您去了就知道什么叫东南周鲁第七名。",
      "token_start": 799,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 247190,
      "end_ms": 249995,
      "text": "贵州镇远古城在贵州东部，",
      "token_start": 818,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 250290,
      "end_ms": 252125,
      "text": "五羊河呈s形，",
      "token_start": 829,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 252490,
      "end_ms": 253365,
      "text": "穿过古城，",
      "token_start": 835,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 253930,
      "end_ms": 255535,
      "text": "把城一分为二，",
      "token_start": 839,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 255890,
      "end_ms": 257095,
      "text": "北岸是旧府城，",
      "token_start": 845,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 257410,
      "end_ms": 257730,
      "text": "南岸，",
      "token_start": 851,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 257730,
      "end_ms": 258465,
      "text": "是就魏城。",
      "token_start": 853,
      "token_end_exclusive": 857
    },
    {
      "start_ms": 258820,
      "end_ms": 260805,
      "text": "您爬上石平山往下看，",
      "token_start": 857,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 261210,
      "end_ms": 263985,
      "text": "整座城就像一幅太极图。",
      "token_start": 866,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 264570,
      "end_ms": 267545,
      "text": "所以镇远又叫太极古镇，",
      "token_start": 876,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 268270,
      "end_ms": 271435,
      "text": "这座城有两千两百多年历史，",
      "token_start": 886,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 272210,
      "end_ms": 274565,
      "text": "从汉高祖五年设县开始，",
      "token_start": 898,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 275050,
      "end_ms": 278560,
      "text": "一直是连接中原和西南的军事重镇，",
      "token_start": 908,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 278740,
      "end_ms": 282085,
      "text": "号称颠除索要黔东门户。",
      "token_start": 923,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 282960,
      "end_ms": 284730,
      "text": "当年言传争流，",
      "token_start": 933,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 285030,
      "end_ms": 286245,
      "text": "商贾如云，",
      "token_start": 939,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 286670,
      "end_ms": 292525,
      "text": "被称为西南大都会城里的青龙洞贴在悬崖上，",
      "token_start": 943,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 292980,
      "end_ms": 294895,
      "text": "六百年了江西会馆。",
      "token_start": 962,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 295290,
      "end_ms": 298315,
      "text": "福建会馆八大会馆全在。",
      "token_start": 970,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 298730,
      "end_ms": 300330,
      "text": "您走在青石板路上，",
      "token_start": 980,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 301030,
      "end_ms": 303090,
      "text": "两岸都是几百年的老房子，",
      "token_start": 988,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 303830,
      "end_ms": 306090,
      "text": "河水从城中间穿过，",
      "token_start": 999,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 306090,
      "end_ms": 308490,
      "text": "去往东能到东一座城，",
      "token_start": 1007,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 308870,
      "end_ms": 309850,
      "text": "守着一条河，",
      "token_start": 1016,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 310210,
      "end_ms": 311410,
      "text": "守了两千多年。",
      "token_start": 1021,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 312550,
      "end_ms": 313210,
      "text": "第六名，",
      "token_start": 1027,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 314250,
      "end_ms": 318610,
      "text": "湖南凤凰古城在湘西沱江穿城而过，",
      "token_start": 1030,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 318790,
      "end_ms": 319970,
      "text": "汉代就建了县。",
      "token_start": 1045,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 320890,
      "end_ms": 322190,
      "text": "一千多年呐，",
      "token_start": 1051,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 322990,
      "end_ms": 325850,
      "text": "这城最绝的不是井是人。",
      "token_start": 1056,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 326510,
      "end_ms": 329800,
      "text": "沈从文从这走出去写了一本编程，",
      "token_start": 1066,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 330360,
      "end_ms": 333280,
      "text": "把凤凰写进了全中国人的心里。",
      "token_start": 1080,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 333760,
      "end_ms": 337680,
      "text": "黄永玉从这儿走出去成了大画家。",
      "token_start": 1093,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 337700,
      "end_ms": 340320,
      "text": "新西兰作家路易艾黎来过说，",
      "token_start": 1107,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 340320,
      "end_ms": 342760,
      "text": "这是中国最美丽的小城。",
      "token_start": 1119,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 342840,
      "end_ms": 344440,
      "text": "凤凰的吊脚楼，",
      "token_start": 1129,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 344440,
      "end_ms": 346540,
      "text": "一半架在岸上，",
      "token_start": 1135,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 346540,
      "end_ms": 348820,
      "text": "一半悬在沱江上，",
      "token_start": 1141,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 348820,
      "end_ms": 351340,
      "text": "木头柱子撑着几百年了，",
      "token_start": 1148,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 351680,
      "end_ms": 352120,
      "text": "不倒。",
      "token_start": 1158,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 352140,
      "end_ms": 353560,
      "text": "城里有苗族，",
      "token_start": 1160,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 353940,
      "end_ms": 355000,
      "text": "有土家族，",
      "token_start": 1165,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 355140,
      "end_ms": 355960,
      "text": "有银饰，",
      "token_start": 1169,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 356220,
      "end_ms": 357800,
      "text": "有蜡染、有苗鼓。",
      "token_start": 1172,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 359280,
      "end_ms": 359740,
      "text": "晚上，",
      "token_start": 1178,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 359760,
      "end_ms": 361595,
      "text": "沱江两岸灯火一亮，",
      "token_start": 1180,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 362480,
      "end_ms": 364665,
      "text": "吊脚楼的影子倒在水里。",
      "token_start": 1188,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 365190,
      "end_ms": 367315,
      "text": "您说这是成还是化？",
      "token_start": 1198,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 368090,
      "end_ms": 370055,
      "text": "从第十到第六，",
      "token_start": 1206,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 370470,
      "end_ms": 372255,
      "text": "浪中藏在山水里，",
      "token_start": 1212,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 373020,
      "end_ms": 374745,
      "text": "丽江长在水上，",
      "token_start": 1219,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 375290,
      "end_ms": 380835,
      "text": "徽州把城套在城里镇远守着太极图凤凰住在沱江上。",
      "token_start": 1225,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 381390,
      "end_ms": 383965,
      "text": "可这五座还不是最绝的，",
      "token_start": 1247,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 384740,
      "end_ms": 386220,
      "text": "接下来第五到第一，",
      "token_start": 1257,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 386420,
      "end_ms": 387785,
      "text": "一做比一做狠。",
      "token_start": 1265,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 388070,
      "end_ms": 391445,
      "text": "又一座城两千五百年没挪过窝。",
      "token_start": 1271,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 391910,
      "end_ms": 395185,
      "text": "有一座城九百年没被淹过，",
      "token_start": 1284,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 395630,
      "end_ms": 399095,
      "text": "还有一座被叫做华夏第一城池。",
      "token_start": 1295,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 399380,
      "end_ms": 399980,
      "text": "他是哪座？",
      "token_start": 1308,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 400480,
      "end_ms": 403495,
      "text": "他凭什么排第一下集马上更新。",
      "token_start": 1312,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 404000,
      "end_ms": 405800,
      "text": "您先点个关注点，",
      "token_start": 1325,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 405800,
      "end_ms": 407185,
      "text": "开头像别走丢。",
      "token_start": 1332,
      "token_end_exclusive": 1338
    }
  ],
