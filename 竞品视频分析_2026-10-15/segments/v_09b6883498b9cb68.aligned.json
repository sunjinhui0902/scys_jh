{
  "video_id": "v_09b6883498b9cb68",
  "duration_s": 500.205011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_09b6883498b9cb68.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_09b6883498b9cb68.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 710,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 990,
      "end_ms": 1750,
      "text": "咱们盘了。",
      "token_start": 2,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1750,
      "end_ms": 3330,
      "text": "第十到第六，",
      "token_start": 6,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 4510,
      "end_ms": 5910,
      "text": "流经五马鲜杯。",
      "token_start": 11,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 6010,
      "end_ms": 8670,
      "text": "文银壶封存了盛世的记忆。",
      "token_start": 17,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 9110,
      "end_ms": 12190,
      "text": "金缕玉衣封存了一个人的身体，",
      "token_start": 28,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 13210,
      "end_ms": 16470,
      "text": "镶金兽首玛瑙杯放出了石头里的兽，",
      "token_start": 41,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 16950,
      "end_ms": 20330,
      "text": "越王勾践剑打开了两千年的时光，",
      "token_start": 56,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 21010,
      "end_ms": 24030,
      "text": "曾侯乙编钟改写了世界音乐史。",
      "token_start": 70,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 24550,
      "end_ms": 27150,
      "text": "好多朋友看完在评论区炒翻了。",
      "token_start": 83,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 27430,
      "end_ms": 29570,
      "text": "有人说后母戊鼎呢？",
      "token_start": 96,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 30410,
      "end_ms": 33230,
      "text": "有人说四羊方尊呢别急，",
      "token_start": 104,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 33710,
      "end_ms": 37790,
      "text": "今天这集就是第五到第一一件，",
      "token_start": 114,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 37850,
      "end_ms": 39110,
      "text": "比一件震撼，",
      "token_start": 127,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 39330,
      "end_ms": 42510,
      "text": "最后那个是中国文化遗产的标志。",
      "token_start": 132,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 43010,
      "end_ms": 47170,
      "text": "老规矩开讲之前麻烦您扣个一点个红心，",
      "token_start": 146,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 47530,
      "end_ms": 49510,
      "text": "让我看看都是谁在听。",
      "token_start": 163,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 50490,
      "end_ms": 57890,
      "text": "第五名立这件青铜器藏在国家博物馆一九七六年出土于陕西，",
      "token_start": 172,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 57910,
      "end_ms": 60075,
      "text": "临潼高二十八厘米。",
      "token_start": 198,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 60470,
      "end_ms": 63885,
      "text": "袁父方座双耳看起来不起眼，",
      "token_start": 206,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 64210,
      "end_ms": 67605,
      "text": "可他肚子里刻着四行三十二个字的铭文。",
      "token_start": 218,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 68260,
      "end_ms": 71565,
      "text": "这三十三个字记录了一件事。",
      "token_start": 235,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 71900,
      "end_ms": 74655,
      "text": "武王伐纣铭文上写着，",
      "token_start": 247,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 74970,
      "end_ms": 79325,
      "text": "武王在甲子日清晨碎星正当空的时候，",
      "token_start": 256,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 79720,
      "end_ms": 81565,
      "text": "发动了对商纣王的进攻，",
      "token_start": 272,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 82150,
      "end_ms": 83895,
      "text": "一天之内就取得了胜利。",
      "token_start": 282,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 84760,
      "end_ms": 91325,
      "text": "这三十三个字让中国历史上最著名的一场战争有了确切的日期。",
      "token_start": 292,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 92110,
      "end_ms": 94475,
      "text": "公元前一四六年一月二十日，",
      "token_start": 319,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 94830,
      "end_ms": 97725,
      "text": "考古学家管他叫西周第一青铜器，",
      "token_start": 331,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 98620,
      "end_ms": 99715,
      "text": "一件青铜器，",
      "token_start": 345,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 99980,
      "end_ms": 104885,
      "text": "把三千年前改朝换代的那一天定在了时间轴上。",
      "token_start": 350,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 105160,
      "end_ms": 112150,
      "text": "第四名四羊方尊这件宝贝藏在国家博物馆一九三八年，",
      "token_start": 370,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 112170,
      "end_ms": 114145,
      "text": "出土于湖南宁乡，",
      "token_start": 393,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 114410,
      "end_ms": 116115,
      "text": "高五十八点六厘米，",
      "token_start": 400,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 116380,
      "end_ms": 118455,
      "text": "重三十四点五公斤。",
      "token_start": 408,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 119080,
      "end_ms": 124580,
      "text": "它的造型是四只羊背对背羊角卷曲扬身，",
      "token_start": 416,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 124620,
      "end_ms": 125465,
      "text": "连着气身，",
      "token_start": 433,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 125890,
      "end_ms": 128365,
      "text": "四只羊共同托起一个方针，",
      "token_start": 437,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 128820,
      "end_ms": 134505,
      "text": "羊的脚、耳朵、鼻子眼睛全都刻的清清楚楚。",
      "token_start": 448,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 134870,
      "end_ms": 136135,
      "text": "铸造这么一件东西，",
      "token_start": 465,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 136380,
      "end_ms": 137645,
      "text": "用的是分柱法，",
      "token_start": 473,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 138110,
      "end_ms": 140770,
      "text": "先把羊角和龙头单独住好，",
      "token_start": 479,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 141010,
      "end_ms": 145375,
      "text": "再嵌进外饭里浇筑器身让它们长在一起。",
      "token_start": 490,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 146380,
      "end_ms": 148825,
      "text": "商代的工匠没有精密仪器，",
      "token_start": 507,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 149170,
      "end_ms": 150685,
      "text": "全靠手感和经验，",
      "token_start": 518,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 151250,
      "end_ms": 157395,
      "text": "一键四羊方尊把青铜铸造的极限推到了天花板。",
      "token_start": 525,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 158210,
      "end_ms": 159365,
      "text": "他出土的时候，",
      "token_start": 545,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 159840,
      "end_ms": 162765,
      "text": "是被当地农民当成乌金挖出来的，",
      "token_start": 551,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 163580,
      "end_ms": 166965,
      "text": "后来在战乱中被炸成二十多块碎片，",
      "token_start": 565,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 167590,
      "end_ms": 169235,
      "text": "一九五二年才被修复。",
      "token_start": 580,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 169840,
      "end_ms": 170260,
      "text": "现在，",
      "token_start": 589,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 170400,
      "end_ms": 172415,
      "text": "他站在国家博物馆的展柜里，",
      "token_start": 591,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 172760,
      "end_ms": 176495,
      "text": "四只羊安安静静的看着每一个走过去的人。",
      "token_start": 603,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 177650,
      "end_ms": 185400,
      "text": "第三名清明上河图这幅画藏在故宫博物院卷本长五百二十八厘米，",
      "token_start": 621,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 185540,
      "end_ms": 187200,
      "text": "高二十四点八厘米。",
      "token_start": 649,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 187560,
      "end_ms": 190360,
      "text": "北宋画家张择端画的是汴景，",
      "token_start": 657,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 190440,
      "end_ms": 191800,
      "text": "也就是今天的开封。",
      "token_start": 669,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 192280,
      "end_ms": 194680,
      "text": "从城外到城内的景象，",
      "token_start": 677,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 195220,
      "end_ms": 198440,
      "text": "画上有八百多个人物八十多头，",
      "token_start": 686,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 198440,
      "end_ms": 203100,
      "text": "牲畜三十多栋房屋、二十多艘船二十多辆车轿。",
      "token_start": 699,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 203660,
      "end_ms": 205380,
      "text": "每个人都有自己的动作，",
      "token_start": 718,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 205740,
      "end_ms": 206760,
      "text": "有挑担的，",
      "token_start": 728,
      "token_end_exclusive": 732
    },
    {
      "start_ms": 206840,
      "end_ms": 207840,
      "text": "有推车的，",
      "token_start": 732,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 207900,
      "end_ms": 208920,
      "text": "有乘船的，",
      "token_start": 736,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 209080,
      "end_ms": 210550,
      "text": "有在桥上朝驾的，",
      "token_start": 740,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 210650,
      "end_ms": 213930,
      "text": "有在酒楼里吃饭的张择端画。",
      "token_start": 747,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 213930,
      "end_ms": 215110,
      "text": "这幅画的时候，",
      "token_start": 759,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 215450,
      "end_ms": 216550,
      "text": "北宋还没亡，",
      "token_start": 765,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 216790,
      "end_ms": 218830,
      "text": "他大概不知道他画的。",
      "token_start": 770,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 218830,
      "end_ms": 220570,
      "text": "这座城几十年后，",
      "token_start": 779,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 220810,
      "end_ms": 222430,
      "text": "就会被金兵攻破，",
      "token_start": 786,
      "token_end_exclusive": 793
    },
    {
      "start_ms": 222870,
      "end_ms": 223990,
      "text": "皇帝被掳走，",
      "token_start": 793,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 224350,
      "end_ms": 226090,
      "text": "百姓流离失所。",
      "token_start": 798,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 226250,
      "end_ms": 230710,
      "text": "这幅画是汴京留给后世的一座纸上都城。",
      "token_start": 804,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 231750,
      "end_ms": 232870,
      "text": "故宫的专家说。",
      "token_start": 821,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 233330,
      "end_ms": 237430,
      "text": "这幅画是域之广为早期绘画之最，",
      "token_start": 827,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 238170,
      "end_ms": 240615,
      "text": "一张画装下了一做成。",
      "token_start": 841,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 241240,
      "end_ms": 243050,
      "text": "讲了这么多评论区，",
      "token_start": 850,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 243050,
      "end_ms": 246505,
      "text": "好多朋友说这些国宝看着是真震撼，",
      "token_start": 858,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 246960,
      "end_ms": 249665,
      "text": "可咱们这年纪去不了那么多博物馆，",
      "token_start": 873,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 250050,
      "end_ms": 252500,
      "text": "腿脚也不好带孙子的时候，",
      "token_start": 888,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 252680,
      "end_ms": 254885,
      "text": "想讲讲这些宝贝背后的故事，",
      "token_start": 899,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 255520,
      "end_ms": 256545,
      "text": "自己也说不全。",
      "token_start": 911,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 257800,
      "end_ms": 262440,
      "text": "前阵子我翻到一本叫中华文化常识一千问的书，",
      "token_start": 917,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 262620,
      "end_ms": 263545,
      "text": "分门别类，",
      "token_start": 937,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 263910,
      "end_ms": 264775,
      "text": "一问一答，",
      "token_start": 941,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 265050,
      "end_ms": 268715,
      "text": "把中国历史上的文化常识讲的清清楚楚。",
      "token_start": 945,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 269470,
      "end_ms": 271285,
      "text": "这些国宝的来龙去脉，",
      "token_start": 962,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 271600,
      "end_ms": 272415,
      "text": "书里都有，",
      "token_start": 971,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 273040,
      "end_ms": 275065,
      "text": "特别适合中老年朋友，",
      "token_start": 975,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 275480,
      "end_ms": 276375,
      "text": "每天翻两页，",
      "token_start": 984,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 276800,
      "end_ms": 277785,
      "text": "心里全有谱。",
      "token_start": 989,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 278460,
      "end_ms": 279585,
      "text": "已经放下面了，",
      "token_start": 994,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 279910,
      "end_ms": 281115,
      "text": "点开就能看到，",
      "token_start": 1000,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 281450,
      "end_ms": 283435,
      "text": "喜欢历史的弄一本放床头，",
      "token_start": 1006,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 283890,
      "end_ms": 285885,
      "text": "随手翻一页就是一段历史。",
      "token_start": 1017,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 286220,
      "end_ms": 286915,
      "text": "第二名，",
      "token_start": 1028,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 287410,
      "end_ms": 288255,
      "text": "后母屋顶，",
      "token_start": 1031,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 288730,
      "end_ms": 291265,
      "text": "这座顶藏在国家博物馆。",
      "token_start": 1035,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 291750,
      "end_ms": 295405,
      "text": "一九三九年出土于河南安阳阴墟，",
      "token_start": 1045,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 295830,
      "end_ms": 297525,
      "text": "高一百三十三厘米，",
      "token_start": 1059,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 297620,
      "end_ms": 300275,
      "text": "重八百三十二点八四公斤。",
      "token_start": 1067,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 300720,
      "end_ms": 304465,
      "text": "他是全世界出土最大最重的青铜器，",
      "token_start": 1078,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 305200,
      "end_ms": 306595,
      "text": "铸造这么一座顶。",
      "token_start": 1093,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 307190,
      "end_ms": 308550,
      "text": "需要先做模型，",
      "token_start": 1100,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 308950,
      "end_ms": 309690,
      "text": "再翻饭，",
      "token_start": 1106,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 309870,
      "end_ms": 311550,
      "text": "再合饭再浇筑。",
      "token_start": 1109,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 312030,
      "end_ms": 315730,
      "text": "光融化铜水就需要几十座熔炉。",
      "token_start": 1115,
      "token_end_exclusive": 1128
    },
    {
      "start_ms": 316010,
      "end_ms": 317110,
      "text": "同时开工，",
      "token_start": 1128,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 317950,
      "end_ms": 319030,
      "text": "浇筑的时候，",
      "token_start": 1132,
      "token_end_exclusive": 1137
    },
    {
      "start_ms": 319310,
      "end_ms": 322670,
      "text": "桶水必须连续不断的灌进去，",
      "token_start": 1137,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 323390,
      "end_ms": 324350,
      "text": "中间一断，",
      "token_start": 1149,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 324550,
      "end_ms": 325850,
      "text": "整个鼎就废了。",
      "token_start": 1153,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 326070,
      "end_ms": 330810,
      "text": "商代的工匠是怎么组织几百人同时作业的？",
      "token_start": 1159,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 331490,
      "end_ms": 333450,
      "text": "到现在还是个谜，",
      "token_start": 1177,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 334410,
      "end_ms": 336805,
      "text": "更觉得是他出土的时候，",
      "token_start": 1184,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 338080,
      "end_ms": 339460,
      "text": "正值抗日战争，",
      "token_start": 1194,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 339600,
      "end_ms": 342160,
      "text": "日本人听说了开出高价要买，",
      "token_start": 1200,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 342380,
      "end_ms": 342820,
      "text": "村民，",
      "token_start": 1212,
      "token_end_exclusive": 1214
    },
    {
      "start_ms": 342860,
      "end_ms": 343840,
      "text": "怕他被抢走，",
      "token_start": 1214,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 344020,
      "end_ms": 345440,
      "text": "又把它埋回了地下，",
      "token_start": 1219,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 345680,
      "end_ms": 348500,
      "text": "直到抗战胜利才重新挖出来。",
      "token_start": 1227,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 349280,
      "end_ms": 352320,
      "text": "一座鼎扛过了三千年的岁月，",
      "token_start": 1239,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 352700,
      "end_ms": 354240,
      "text": "也扛过了一场战争。",
      "token_start": 1251,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 355580,
      "end_ms": 356160,
      "text": "第一名。",
      "token_start": 1259,
      "token_end_exclusive": 1262
    },
    {
      "start_ms": 356360,
      "end_ms": 361600,
      "text": "太阳神鸟金士这件宝贝藏在成都金沙遗址博物馆，",
      "token_start": 1262,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 362000,
      "end_ms": 362860,
      "text": "它有多小？",
      "token_start": 1283,
      "token_end_exclusive": 1287
    },
    {
      "start_ms": 363860,
      "end_ms": 364420,
      "text": "外径？",
      "token_start": 1287,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 364500,
      "end_ms": 365680,
      "text": "十二点五厘米，",
      "token_start": 1289,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 365940,
      "end_ms": 368325,
      "text": "厚度只有零点零二二厘米，",
      "token_start": 1295,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 368920,
      "end_ms": 370995,
      "text": "比一张纸厚不了多少，",
      "token_start": 1306,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 371440,
      "end_ms": 373885,
      "text": "含金量百分之九十四点二。",
      "token_start": 1315,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 374540,
      "end_ms": 377755,
      "text": "整件金饰的图案分内外两层，",
      "token_start": 1326,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 378130,
      "end_ms": 381195,
      "text": "外层是四肢首尾向前的飞鸟，",
      "token_start": 1338,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 381720,
      "end_ms": 382825,
      "text": "展翅盘旋。",
      "token_start": 1350,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 383290,
      "end_ms": 386165,
      "text": "内层是十二道弧形光芒，",
      "token_start": 1354,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 386640,
      "end_ms": 388375,
      "text": "向太阳放射出的光。",
      "token_start": 1364,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 388780,
      "end_ms": 392675,
      "text": "四只鸟可能代表四个季节或者四个方向，",
      "token_start": 1372,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 393170,
      "end_ms": 394185,
      "text": "十二道光芒，",
      "token_start": 1389,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 394500,
      "end_ms": 397395,
      "text": "可能代表十二个月份或者十二个时辰。",
      "token_start": 1394,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 398310,
      "end_ms": 400010,
      "text": "三千年前的古蜀人，",
      "token_start": 1410,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 400290,
      "end_ms": 405335,
      "text": "用一块金子把他们对天对地、对时间对生命的理解，",
      "token_start": 1418,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 405760,
      "end_ms": 408605,
      "text": "全部浓缩在了一个巴掌大的圆里。",
      "token_start": 1439,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 409540,
      "end_ms": 410245,
      "text": "二五年，",
      "token_start": 1453,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 410530,
      "end_ms": 413760,
      "text": "他被选为中国文化遗产标志，",
      "token_start": 1456,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 413980,
      "end_ms": 417645,
      "text": "神舟六号飞船带着他的复制品飞上了太空。",
      "token_start": 1468,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 418390,
      "end_ms": 422115,
      "text": "三千年前古蜀人仰望的那只太阳神鸟，",
      "token_start": 1486,
      "token_end_exclusive": 1502
    },
    {
      "start_ms": 422450,
      "end_ms": 423405,
      "text": "真的飞起来了。",
      "token_start": 1502,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 423940,
      "end_ms": 425555,
      "text": "这块小小的金箔，",
      "token_start": 1508,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 425950,
      "end_ms": 428435,
      "text": "是古蜀人留给所有中国人的一封。",
      "token_start": 1515,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 428820,
      "end_ms": 431695,
      "text": "三千年前的信信上说，",
      "token_start": 1529,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 432390,
      "end_ms": 433575,
      "text": "我们崇拜太阳，",
      "token_start": 1538,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 433810,
      "end_ms": 434835,
      "text": "我们向往光明。",
      "token_start": 1544,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 435320,
      "end_ms": 439595,
      "text": "我们相信我们的后代有一天会飞到天上，",
      "token_start": 1550,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 440370,
      "end_ms": 441345,
      "text": "他们做到了。",
      "token_start": 1567,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 441550,
      "end_ms": 442425,
      "text": "您发现没有？",
      "token_start": 1572,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 443460,
      "end_ms": 445535,
      "text": "这十件镇国之宝，",
      "token_start": 1577,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 445920,
      "end_ms": 454080,
      "text": "没有一件是单纯靠才智值钱的刘金午马贤碑文银壶记着盛世的记忆，",
      "token_start": 1584,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 454260,
      "end_ms": 457285,
      "text": "金缕玉衣封存着一个人的身体，",
      "token_start": 1613,
      "token_end_exclusive": 1626
    },
    {
      "start_ms": 457840,
      "end_ms": 459300,
      "text": "镶金兽首玛瑙杯，",
      "token_start": 1626,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 459520,
      "end_ms": 460965,
      "text": "放出了石头里的兽。",
      "token_start": 1633,
      "token_end_exclusive": 1641
    },
    {
      "start_ms": 461730,
      "end_ms": 464335,
      "text": "越王勾践剑连接着两千年的时光，",
      "token_start": 1641,
      "token_end_exclusive": 1655
    },
    {
      "start_ms": 464640,
      "end_ms": 470435,
      "text": "曾侯乙编钟改写的音乐史立肯盯住了改朝换代的那一天。",
      "token_start": 1655,
      "token_end_exclusive": 1679
    },
    {
      "start_ms": 471400,
      "end_ms": 477230,
      "text": "四羊方尊把青铜铸造推到了极限清明上河图，",
      "token_start": 1679,
      "token_end_exclusive": 1698
    },
    {
      "start_ms": 477550,
      "end_ms": 480485,
      "text": "装下了一座城后母屋顶，",
      "token_start": 1698,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 480860,
      "end_ms": 482255,
      "text": "扛过了一场战争。",
      "token_start": 1708,
      "token_end_exclusive": 1715
    },
    {
      "start_ms": 482850,
      "end_ms": 488080,
      "text": "太阳神鸟金氏把三千年前的信仰送上了太空，",
      "token_start": 1715,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 488760,
      "end_ms": 492560,
      "text": "每一件宝贝的厉害之处都不在它有多重，",
      "token_start": 1734,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 492700,
      "end_ms": 496660,
      "text": "在它里面锁着一段中国人不能忘记的记忆，",
      "token_start": 1751,
      "token_end_exclusive": 1769
    },
    {
      "start_ms": 497480,
      "end_ms": 498280,
      "text": "点个关注，",
      "token_start": 1769,
      "token_end_exclusive": 1773
    },
    {
      "start_ms": 498580,
      "end_ms": 500075,
      "text": "咱们下期接着聊。",
      "token_start": 1773,
      "token_end_exclusive": 1780
    }
  ],
