{
  "video_id": "v_f2b712193f42f6d1",
  "duration_s": 423.207007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f2b712193f42f6d1.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f2b712193f42f6d1.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 470,
      "end_ms": 5610,
      "text": "您知道中国最令人惊叹的峡谷秘境是哪一个吗？",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5990,
      "end_ms": 8770,
      "text": "有人说是雅鲁藏布大峡谷，",
      "token_start": 20,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 9310,
      "end_ms": 10510,
      "text": "五百多公里长，",
      "token_start": 31,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 11130,
      "end_ms": 12970,
      "text": "深度排世界第一。",
      "token_start": 37,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 13450,
      "end_ms": 17270,
      "text": "有人说是怒江大峡谷三百多公里，",
      "token_start": 44,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 17750,
      "end_ms": 20870,
      "text": "两岸的山比谷底高出两千多米。",
      "token_start": 58,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 21110,
      "end_ms": 21350,
      "text": "错，",
      "token_start": 71,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 22090,
      "end_ms": 23850,
      "text": "这两个都不是第一，",
      "token_start": 72,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 24370,
      "end_ms": 27210,
      "text": "真正排在榜首的那条峡谷。",
      "token_start": 80,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 27990,
      "end_ms": 28230,
      "text": "错，",
      "token_start": 91,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 28270,
      "end_ms": 29935,
      "text": "身边十个人问下来，",
      "token_start": 92,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 30620,
      "end_ms": 32680,
      "text": "九个半都没听过他的名字。",
      "token_start": 100,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 33060,
      "end_ms": 35680,
      "text": "真正排在榜首的那座秘境，",
      "token_start": 111,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 36380,
      "end_ms": 39740,
      "text": "藏在世界屋脊最隐秘的褶皱里。",
      "token_start": 122,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 40360,
      "end_ms": 42680,
      "text": "几十座雪峰与大冰川，",
      "token_start": 135,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 43340,
      "end_ms": 48140,
      "text": "把整条生谷严丝合缝的所在雪域尽头。",
      "token_start": 144,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 48580,
      "end_ms": 49040,
      "text": "今天，",
      "token_start": 160,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 49060,
      "end_ms": 53880,
      "text": "咱们就来盘点中国十大令人惊叹的峡谷秘境。",
      "token_start": 162,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 54380,
      "end_ms": 55260,
      "text": "第十名，",
      "token_start": 181,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 55980,
      "end_ms": 57180,
      "text": "金丝大峡谷，",
      "token_start": 184,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 57940,
      "end_ms": 62555,
      "text": "陕西商洛商南见他藏在秦岭南路，",
      "token_start": 189,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 63130,
      "end_ms": 67045,
      "text": "而秦岭东西横着一千六百多公里，",
      "token_start": 203,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 67500,
      "end_ms": 69995,
      "text": "是中国南北方的分界线。",
      "token_start": 217,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 70640,
      "end_ms": 72755,
      "text": "山里的溪水顺着岩缝，",
      "token_start": 227,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 73440,
      "end_ms": 74925,
      "text": "一年一年往下切，",
      "token_start": 236,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 75870,
      "end_ms": 77815,
      "text": "硬是切出一条峡谷。",
      "token_start": 243,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 78350,
      "end_ms": 80850,
      "text": "您要是从城里忙的脚不沾地，",
      "token_start": 251,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 80870,
      "end_ms": 82975,
      "text": "跑到这儿往鼓里一走，",
      "token_start": 263,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 83430,
      "end_ms": 85235,
      "text": "溪水绕着脚边流，",
      "token_start": 272,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 85650,
      "end_ms": 87485,
      "text": "两边是密密的林子，",
      "token_start": 279,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 87940,
      "end_ms": 89760,
      "text": "头顶是尖尖的奇风，",
      "token_start": 287,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 90100,
      "end_ms": 91875,
      "text": "耳朵里只剩水声，",
      "token_start": 295,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 92250,
      "end_ms": 94445,
      "text": "浑身的骨头都松下来了。",
      "token_start": 302,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 95040,
      "end_ms": 97245,
      "text": "别的峡谷靠险下人，",
      "token_start": 312,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 97680,
      "end_ms": 102955,
      "text": "他靠的是山水林岩一层叠一层，",
      "token_start": 320,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 103260,
      "end_ms": 105185,
      "text": "把您的脚步越走越慢。",
      "token_start": 333,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 105820,
      "end_ms": 107425,
      "text": "榜单从他开始，",
      "token_start": 342,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 107780,
      "end_ms": 110785,
      "text": "因为惊叹不一定是倒吸一口凉气，",
      "token_start": 348,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 111230,
      "end_ms": 112875,
      "text": "有时候是舍不得走，",
      "token_start": 362,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 113430,
      "end_ms": 116255,
      "text": "您说这算不算一种惊叹？",
      "token_start": 370,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 116720,
      "end_ms": 117535,
      "text": "第九名，",
      "token_start": 380,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 117950,
      "end_ms": 119130,
      "text": "巫山小三峡，",
      "token_start": 383,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 119710,
      "end_ms": 120585,
      "text": "重庆巫山，",
      "token_start": 388,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 121350,
      "end_ms": 123765,
      "text": "他是大宁河下游的三段峡谷，",
      "token_start": 392,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 124290,
      "end_ms": 130015,
      "text": "龙门峡八雾峡低翠峡一段接一段加起来几十公里。",
      "token_start": 404,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 130500,
      "end_ms": 132165,
      "text": "您往船上一坐，",
      "token_start": 425,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 132870,
      "end_ms": 135865,
      "text": "水清的能数出河底的石头，",
      "token_start": 431,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 136470,
      "end_ms": 140365,
      "text": "两边的绝壁仿佛要贴到船舷上。",
      "token_start": 442,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 140870,
      "end_ms": 143455,
      "text": "水面静的像一面镜子，",
      "token_start": 455,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 143860,
      "end_ms": 145575,
      "text": "言闭半山腰，",
      "token_start": 464,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 145990,
      "end_ms": 148865,
      "text": "还留着一排排方方正正的时空，",
      "token_start": 469,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 149530,
      "end_ms": 157245,
      "text": "那是古人当年凿出来的栈道孔牙缝里还摆着玄关一放就是两千来年，",
      "token_start": 482,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 157640,
      "end_ms": 158635,
      "text": "他不是最高的，",
      "token_start": 511,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 159020,
      "end_ms": 160205,
      "text": "也不是最险的。",
      "token_start": 517,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 160590,
      "end_ms": 163505,
      "text": "可中国人心里山水画该有的样子，",
      "token_start": 523,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 163870,
      "end_ms": 166045,
      "text": "山水州人他一样不少。",
      "token_start": 537,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 166490,
      "end_ms": 169005,
      "text": "您说这算不算最地道的东方意境？",
      "token_start": 546,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 169360,
      "end_ms": 170145,
      "text": "第八名，",
      "token_start": 560,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 170540,
      "end_ms": 171805,
      "text": "马岭河大峡谷，",
      "token_start": 563,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 172120,
      "end_ms": 173095,
      "text": "贵州兴义。",
      "token_start": 569,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 173430,
      "end_ms": 174055,
      "text": "您想想，",
      "token_start": 573,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 174340,
      "end_ms": 176445,
      "text": "一条峡谷里到处都是瀑布，",
      "token_start": 576,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 176740,
      "end_ms": 177460,
      "text": "会是什么样？",
      "token_start": 587,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 177620,
      "end_ms": 178555,
      "text": "他就是这个样，",
      "token_start": 592,
      "token_end_exclusive": 598
    },
    {
      "start_ms": 179120,
      "end_ms": 181540,
      "text": "峡谷长七十多公里，",
      "token_start": 598,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 182000,
      "end_ms": 184540,
      "text": "谷深一百多到两百来米。",
      "token_start": 606,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 185080,
      "end_ms": 188780,
      "text": "几十道瀑布从崖顶一路挂下来，",
      "token_start": 616,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 189240,
      "end_ms": 190340,
      "text": "您站在谷底，",
      "token_start": 629,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 190880,
      "end_ms": 195780,
      "text": "水汽扑的满脸都是凉丝丝的扑生在两面，",
      "token_start": 634,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 195840,
      "end_ms": 197460,
      "text": "崖壁之间来回撞，",
      "token_start": 651,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 198120,
      "end_ms": 200700,
      "text": "像有人在头顶不停的洗牌。",
      "token_start": 658,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 201340,
      "end_ms": 204160,
      "text": "这些瀑布不光会流还会长，",
      "token_start": 669,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 204960,
      "end_ms": 207580,
      "text": "山里的水带着碳酸钙，",
      "token_start": 680,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 208260,
      "end_ms": 210550,
      "text": "一年一年渗出在崖壁，",
      "token_start": 689,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 211170,
      "end_ms": 217130,
      "text": "长成一层又一层石帘子把整面崖壁都裹了起来。",
      "token_start": 698,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 217530,
      "end_ms": 219890,
      "text": "别的地方瀑布是一道井，",
      "token_start": 718,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 220430,
      "end_ms": 221090,
      "text": "在这儿，",
      "token_start": 728,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 221450,
      "end_ms": 223970,
      "text": "瀑布是整条峡谷的墙，",
      "token_start": 731,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 224550,
      "end_ms": 228530,
      "text": "您说这算不算一条挂在地缝里的瀑布？",
      "token_start": 740,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 228530,
      "end_ms": 228990,
      "text": "长廊，",
      "token_start": 756,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 229310,
      "end_ms": 230010,
      "text": "第七名，",
      "token_start": 758,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 230410,
      "end_ms": 232830,
      "text": "大渡河金口大峡谷，",
      "token_start": 761,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 233090,
      "end_ms": 234990,
      "text": "四川乐山金口河。",
      "token_start": 769,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 235850,
      "end_ms": 238650,
      "text": "如果说前面的峡谷讲究秀丽，",
      "token_start": 776,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 239190,
      "end_ms": 242875,
      "text": "这一条给给您的就是纯粹的视觉震撼。",
      "token_start": 788,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 243340,
      "end_ms": 244765,
      "text": "全长二十六公里，",
      "token_start": 804,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 245360,
      "end_ms": 247815,
      "text": "骨宽不过两三百米，",
      "token_start": 811,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 248440,
      "end_ms": 254285,
      "text": "但两岸山崖的最大垂直落差竟然达到了两千六百米。",
      "token_start": 819,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 254770,
      "end_ms": 257395,
      "text": "大渡河水像一把锋利的钢刀，",
      "token_start": 841,
      "token_end_exclusive": 853
    },
    {
      "start_ms": 257760,
      "end_ms": 259275,
      "text": "花了上千万年，",
      "token_start": 853,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 259600,
      "end_ms": 262755,
      "text": "硬生生劈开坚硬的玄武岩层，",
      "token_start": 859,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 263190,
      "end_ms": 266105,
      "text": "连阳光一天都照不进几个小时。",
      "token_start": 871,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 266540,
      "end_ms": 269240,
      "text": "您站在峡谷底下的窄轨铁道边，",
      "token_start": 884,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 269280,
      "end_ms": 269985,
      "text": "抬头看，",
      "token_start": 897,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 270510,
      "end_ms": 272230,
      "text": "两侧黑黝黝的巨壁，",
      "token_start": 900,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 272230,
      "end_ms": 273995,
      "text": "像要合拢砸下来一样，",
      "token_start": 908,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 274540,
      "end_ms": 276925,
      "text": "人在里头小的就像一粒沙子，",
      "token_start": 917,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 277310,
      "end_ms": 280465,
      "text": "这种能把人看傻的庞大尺度。",
      "token_start": 929,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 280850,
      "end_ms": 282095,
      "text": "您说震撼不震撼？",
      "token_start": 941,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 282500,
      "end_ms": 285375,
      "text": "第六名天山、神秘大峡谷，",
      "token_start": 948,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 285740,
      "end_ms": 286985,
      "text": "新疆库车，",
      "token_start": 958,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 287390,
      "end_ms": 291115,
      "text": "您是不是觉得峡谷就该是青山绿水？",
      "token_start": 962,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 291600,
      "end_ms": 295025,
      "text": "新疆这一条会直接改掉您的想象，",
      "token_start": 977,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 295590,
      "end_ms": 297975,
      "text": "当地人叫他克兹利亚，",
      "token_start": 991,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 298480,
      "end_ms": 301595,
      "text": "维吾尔语林就是红色的山崖，",
      "token_start": 1000,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 302140,
      "end_ms": 307065,
      "text": "整条峡谷全是红砂岩高的地方上百米。",
      "token_start": 1012,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 307570,
      "end_ms": 311290,
      "text": "窄的地方只够一个人侧着身子挤过去，",
      "token_start": 1028,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 312050,
      "end_ms": 317630,
      "text": "这些岩层是上亿年前一层层沉下来的。",
      "token_start": 1044,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 318050,
      "end_ms": 321530,
      "text": "后来山洪和缝像刻刀一样，",
      "token_start": 1060,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 321810,
      "end_ms": 323910,
      "text": "一年年飙成了这副模样。",
      "token_start": 1071,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 324490,
      "end_ms": 325470,
      "text": "您走进去，",
      "token_start": 1081,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 325670,
      "end_ms": 326970,
      "text": "脚下是干沙，",
      "token_start": 1085,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 327630,
      "end_ms": 329950,
      "text": "两边是烧红了似的岩壁，",
      "token_start": 1090,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 330670,
      "end_ms": 333070,
      "text": "您喊一嗓子回声，",
      "token_start": 1100,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 333130,
      "end_ms": 334770,
      "text": "顺着岩缝滚出去。",
      "token_start": 1107,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 334770,
      "end_ms": 335170,
      "text": "老远。",
      "token_start": 1114,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 335770,
      "end_ms": 337720,
      "text": "岩壁上一道道纹怒，",
      "token_start": 1116,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 337960,
      "end_ms": 339620,
      "text": "像火苗被冻住了。",
      "token_start": 1124,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 339920,
      "end_ms": 341360,
      "text": "别的峡谷是绿的，",
      "token_start": 1131,
      "token_end_exclusive": 1138
    },
    {
      "start_ms": 341480,
      "end_ms": 342260,
      "text": "它是红的，",
      "token_start": 1138,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 342860,
      "end_ms": 344240,
      "text": "别的峡谷靠水，",
      "token_start": 1142,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 344660,
      "end_ms": 345560,
      "text": "它靠石头。",
      "token_start": 1148,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 345920,
      "end_ms": 349860,
      "text": "您说这算不算长在地球上的火星？",
      "token_start": 1152,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 350620,
      "end_ms": 354420,
      "text": "从第十到第六名金丝大峡谷，",
      "token_start": 1166,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 354420,
      "end_ms": 355600,
      "text": "让人舍不得走。",
      "token_start": 1178,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 356240,
      "end_ms": 360160,
      "text": "巫山小三峡是一副能划着船走进去的山水画，",
      "token_start": 1184,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 360620,
      "end_ms": 363500,
      "text": "马岭河把几十道瀑布挂进了地缝。",
      "token_start": 1203,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 363940,
      "end_ms": 367245,
      "text": "大渡河金口大峡谷把天挤成了一条缝，",
      "token_start": 1217,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 367750,
      "end_ms": 371425,
      "text": "天山神秘大峡谷把大地染成了火星，",
      "token_start": 1233,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 372180,
      "end_ms": 374935,
      "text": "可他们还不是最令人惊叹的。",
      "token_start": 1248,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 375600,
      "end_ms": 377905,
      "text": "接下来第五道第一名更绝，",
      "token_start": 1260,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 378530,
      "end_ms": 379755,
      "text": "有一条深谷，",
      "token_start": 1271,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 380090,
      "end_ms": 385310,
      "text": "把绝壁、地缝、天坑全都揉在一块儿一根上。",
      "token_start": 1276,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 385330,
      "end_ms": 387690,
      "text": "百米高的石柱立在风雨里，",
      "token_start": 1293,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 387810,
      "end_ms": 388865,
      "text": "千万年不倒，",
      "token_start": 1304,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 389220,
      "end_ms": 390220,
      "text": "有一座雪山，",
      "token_start": 1309,
      "token_end_exclusive": 1314
    },
    {
      "start_ms": 390420,
      "end_ms": 395030,
      "text": "巨口吞下了整整一条翻滚的金沙江咆哮声。",
      "token_start": 1314,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 395050,
      "end_ms": 396455,
      "text": "能传出几里地，",
      "token_start": 1332,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 396840,
      "end_ms": 406235,
      "text": "可排在榜首的那座被几十条万年冰川与重重雪风严丝合缝的扣在雪域深处。",
      "token_start": 1338,
      "token_end_exclusive": 1370
    },
    {
      "start_ms": 406960,
      "end_ms": 413935,
      "text": "他凭什么排在大名鼎鼎的雅鲁藏布大峡谷前面下一集已经同步更新，",
      "token_start": 1370,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 414340,
      "end_ms": 415420,
      "text": "点开我的头像，",
      "token_start": 1399,
      "token_end_exclusive": 1405
    },
    {
      "start_ms": 415520,
      "end_ms": 418445,
      "text": "进入主页就能看到点个关注，",
      "token_start": 1405,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 418880,
      "end_ms": 422785,
      "text": "看看谁才是中国最令人惊叹的峡谷秘境。",
      "token_start": 1417,
      "token_end_exclusive": 1434
    }
  ],
