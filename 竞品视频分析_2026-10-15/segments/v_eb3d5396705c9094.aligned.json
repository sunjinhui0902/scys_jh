{
  "video_id": "v_eb3d5396705c9094",
  "duration_s": 402.75,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_eb3d5396705c9094.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_eb3d5396705c9094.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 4050,
      "text": "凌和从三反到兴学先锋，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 4770,
      "end_ms": 7450,
      "text": "他活成了一道不被定义的光。",
      "token_start": 10,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 8470,
      "end_ms": 14150,
      "text": "提到李银和很多人的第一反应是王晓波的妻子，",
      "token_start": 22,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 14910,
      "end_ms": 17010,
      "text": "但如果你只知道这个身份，",
      "token_start": 42,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 17590,
      "end_ms": 19110,
      "text": "就太小看她了。",
      "token_start": 53,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 20010,
      "end_ms": 21510,
      "text": "今天咱们不讲八卦，",
      "token_start": 59,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 21510,
      "end_ms": 25350,
      "text": "只聊这个女人的硬核人生。",
      "token_start": 67,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 25350,
      "end_ms": 27070,
      "text": "从一个特别的名字说起。",
      "token_start": 78,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 27070,
      "end_ms": 29050,
      "text": "一九五二年，",
      "token_start": 88,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 29050,
      "end_ms": 33540,
      "text": "这林和出生那会儿，",
      "token_start": 93,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 33540,
      "end_ms": 35520,
      "text": "全国正开展三反运动。",
      "token_start": 101,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 35980,
      "end_ms": 39520,
      "text": "他的父母是接受过新式教育的知识分子，",
      "token_start": 110,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 39520,
      "end_ms": 41740,
      "text": "干脆给女儿取了个小名叫三反。",
      "token_start": 127,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 42300,
      "end_ms": 43700,
      "text": "这名字听着有点怪，",
      "token_start": 140,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 44080,
      "end_ms": 45920,
      "text": "但背后藏的是态度，",
      "token_start": 148,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 46300,
      "end_ms": 48260,
      "text": "反的不只是运动对象，",
      "token_start": 156,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 48260,
      "end_ms": 50780,
      "text": "还有那些不合理的条条框框，",
      "token_start": 165,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 50780,
      "end_ms": 53820,
      "text": "更特别的是他们家的姓氏安排。",
      "token_start": 177,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 53820,
      "end_ms": 56960,
      "text": "几个姐姐随父亲姓林，",
      "token_start": 190,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 57000,
      "end_ms": 58880,
      "text": "李银和和三哥，",
      "token_start": 199,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 59060,
      "end_ms": 60345,
      "text": "却跟着母亲姓李。",
      "token_start": 205,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 61170,
      "end_ms": 65325,
      "text": "在那个重男轻女随复姓天经地义的年代，",
      "token_start": 212,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 65780,
      "end_ms": 69255,
      "text": "这种安排本身就是一种无声的反抗。",
      "token_start": 229,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 70010,
      "end_ms": 70510,
      "text": "可以说，",
      "token_start": 244,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 70790,
      "end_ms": 72230,
      "text": "李银河从出生起，",
      "token_start": 247,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 72510,
      "end_ms": 74730,
      "text": "就没打算活在别人的规矩里。",
      "token_start": 254,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 74790,
      "end_ms": 75610,
      "text": "七岁那年，",
      "token_start": 266,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 75830,
      "end_ms": 77225,
      "text": "他改名叫李银河，",
      "token_start": 270,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 77740,
      "end_ms": 78565,
      "text": "名字变了，",
      "token_start": 277,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 78960,
      "end_ms": 80155,
      "text": "骨子里的劲儿没变。",
      "token_start": 281,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 80730,
      "end_ms": 81405,
      "text": "十六岁，",
      "token_start": 289,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 81790,
      "end_ms": 83075,
      "text": "他去内蒙古插队，",
      "token_start": 292,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 83410,
      "end_ms": 85015,
      "text": "别人在那里熬日子，",
      "token_start": 299,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 85280,
      "end_ms": 87085,
      "text": "他却在草原上观察人，",
      "token_start": 307,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 87650,
      "end_ms": 89745,
      "text": "琢磨普通人在时代里的命运。",
      "token_start": 316,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 90210,
      "end_ms": 90730,
      "text": "那时候，",
      "token_start": 328,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 90730,
      "end_ms": 91585,
      "text": "他干农活，",
      "token_start": 331,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 91950,
      "end_ms": 92570,
      "text": "住土房，",
      "token_start": 335,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 92950,
      "end_ms": 93875,
      "text": "手磨出茧，",
      "token_start": 338,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 94730,
      "end_ms": 96605,
      "text": "但他最震撼的不是苦，",
      "token_start": 342,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 97100,
      "end_ms": 100905,
      "text": "而是看见人在巨大潮流里的渺小和挣扎。",
      "token_start": 351,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 101460,
      "end_ms": 102465,
      "text": "从那时起，",
      "token_start": 368,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 102800,
      "end_ms": 104535,
      "text": "他对人产生了兴趣。",
      "token_start": 372,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 105150,
      "end_ms": 105930,
      "text": "二十二岁，",
      "token_start": 380,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 106150,
      "end_ms": 107270,
      "text": "他考进大学，",
      "token_start": 384,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 107630,
      "end_ms": 109600,
      "text": "一开始读历史课堂上，",
      "token_start": 389,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 109600,
      "end_ms": 111215,
      "text": "老师讲朝代更替，",
      "token_start": 398,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 111680,
      "end_ms": 114255,
      "text": "他脑子里冒出的问题却越来越多。",
      "token_start": 405,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 115180,
      "end_ms": 119675,
      "text": "为什么有些群体会长时间陷入非理性狂热？",
      "token_start": 419,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 120270,
      "end_ms": 122710,
      "text": "一个人到底该怎么活才清醒？",
      "token_start": 437,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 123310,
      "end_ms": 124870,
      "text": "这些课本给不了答案。",
      "token_start": 449,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 125050,
      "end_ms": 128930,
      "text": "后来他做了一个让周围人看不懂的决定转去社会学。",
      "token_start": 458,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 129490,
      "end_ms": 131810,
      "text": "那时候社会学在国内刚刚起步，",
      "token_start": 480,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 132170,
      "end_ms": 133710,
      "text": "学科体系不完善。",
      "token_start": 493,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 134190,
      "end_ms": 135690,
      "text": "很多人觉得没前途，",
      "token_start": 500,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 136350,
      "end_ms": 137310,
      "text": "但他不在乎，",
      "token_start": 508,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 138270,
      "end_ms": 139530,
      "text": "毕业后进了报社。",
      "token_start": 513,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 140190,
      "end_ms": 144250,
      "text": "他偏偏研究起婚姻家庭和两性关系。",
      "token_start": 520,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 144470,
      "end_ms": 145930,
      "text": "上世纪七十年代，",
      "token_start": 535,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 146170,
      "end_ms": 147790,
      "text": "公开谈这些话题，",
      "token_start": 542,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 148390,
      "end_ms": 150700,
      "text": "光是开口都需要勇气，",
      "token_start": 549,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 151120,
      "end_ms": 153200,
      "text": "他却当成正经学问来做。",
      "token_start": 558,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 153860,
      "end_ms": 154880,
      "text": "就冲这一点，",
      "token_start": 568,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 155180,
      "end_ms": 157700,
      "text": "他已经比很多人超前了几十年。",
      "token_start": 573,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 158280,
      "end_ms": 158580,
      "text": "再说，",
      "token_start": 586,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 158580,
      "end_ms": 161340,
      "text": "他和王小波二十五岁那年，",
      "token_start": 588,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 161980,
      "end_ms": 166540,
      "text": "林和偶然读到一篇小说叫绿毛水怪，",
      "token_start": 599,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 167320,
      "end_ms": 169120,
      "text": "他一下被镇住了，",
      "token_start": 614,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 169540,
      "end_ms": 174260,
      "text": "说从来没看过有人能把故事写的这么有意思这么深。",
      "token_start": 621,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 174800,
      "end_ms": 176720,
      "text": "那会儿王小波还没什么名气，",
      "token_start": 643,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 177100,
      "end_ms": 177980,
      "text": "条件一般，",
      "token_start": 655,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 178200,
      "end_ms": 179895,
      "text": "长得也不符合主流审美，",
      "token_start": 659,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 180070,
      "end_ms": 182455,
      "text": "但李应和看的是他脑子里的东西。",
      "token_start": 669,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 183270,
      "end_ms": 184275,
      "text": "而王小波呢，",
      "token_start": 683,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 184580,
      "end_ms": 186655,
      "text": "别人觉得他研究两性是不正经，",
      "token_start": 688,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 187290,
      "end_ms": 188875,
      "text": "他却觉得这事很有价值，",
      "token_start": 701,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 189800,
      "end_ms": 191695,
      "text": "两人是奔着灵魂去的，",
      "token_start": 711,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 192220,
      "end_ms": 195735,
      "text": "不是奔着条件去结婚以后，",
      "token_start": 720,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 196180,
      "end_ms": 198635,
      "text": "他们的相处模式也很特别。",
      "token_start": 731,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 199580,
      "end_ms": 202365,
      "text": "李迎和三十岁那年想出国深造，",
      "token_start": 742,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 203120,
      "end_ms": 204935,
      "text": "王小波没有一句反对，",
      "token_start": 755,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 206050,
      "end_ms": 208470,
      "text": "直接说你去追你的学问，",
      "token_start": 764,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 208750,
      "end_ms": 210465,
      "text": "家里的事儿交给我。",
      "token_start": 774,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 210880,
      "end_ms": 212545,
      "text": "后来两个人在美国团聚，",
      "token_start": 782,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 212950,
      "end_ms": 214225,
      "text": "日子过得紧巴巴，",
      "token_start": 792,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 214660,
      "end_ms": 216480,
      "text": "家具都是二手淘来的，",
      "token_start": 799,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 216480,
      "end_ms": 219545,
      "text": "但周末泡图书馆假期到处走，",
      "token_start": 808,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 219970,
      "end_ms": 220990,
      "text": "一边看世界，",
      "token_start": 820,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 220990,
      "end_ms": 222145,
      "text": "一边聊学术。",
      "token_start": 825,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 222770,
      "end_ms": 224285,
      "text": "他们租的小房子，",
      "token_start": 830,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 224600,
      "end_ms": 225325,
      "text": "冬天冷，",
      "token_start": 837,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 225650,
      "end_ms": 226315,
      "text": "夏天热，",
      "token_start": 840,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 226770,
      "end_ms": 228670,
      "text": "但经常为了一本好书，",
      "token_start": 843,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 229010,
      "end_ms": 229845,
      "text": "聊到半夜。",
      "token_start": 852,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 230440,
      "end_ms": 231805,
      "text": "王小波写作时，",
      "token_start": 856,
      "token_end_exclusive": 862
    },
    {
      "start_ms": 232140,
      "end_ms": 233700,
      "text": "李迎河帮他查资料，",
      "token_start": 862,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 233920,
      "end_ms": 235085,
      "text": "李银河写论文。",
      "token_start": 870,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 235570,
      "end_ms": 242135,
      "text": "王小波帮他梳理逻辑最动人的一件事是林和研究同性恋群体时，",
      "token_start": 876,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 242700,
      "end_ms": 243715,
      "text": "资料特别难搞。",
      "token_start": 903,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 244040,
      "end_ms": 248865,
      "text": "王小波为了帮他主动去接触相关人群，",
      "token_start": 909,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 249300,
      "end_ms": 252525,
      "text": "甚至想办法以圈内人身份获取信息。",
      "token_start": 925,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 252770,
      "end_ms": 253435,
      "text": "那个年代，",
      "token_start": 940,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 253800,
      "end_ms": 255635,
      "text": "光提这个词都要被议论，",
      "token_start": 944,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 256520,
      "end_ms": 261345,
      "text": "他这么做纯粹是因为支持妻子的学术理想。",
      "token_start": 954,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 262320,
      "end_ms": 263235,
      "text": "回国以后，",
      "token_start": 972,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 263900,
      "end_ms": 266870,
      "text": "李迎和成了中国第一个文科，",
      "token_start": 976,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 266870,
      "end_ms": 269225,
      "text": "博士后导师是费孝通。",
      "token_start": 988,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 269630,
      "end_ms": 272495,
      "text": "他开题时一口气列了十个方向，",
      "token_start": 997,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 272950,
      "end_ms": 274495,
      "text": "全是婚前性行为，",
      "token_start": 1010,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 275230,
      "end_ms": 276695,
      "text": "婚外恋、单身，",
      "token_start": 1017,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 276990,
      "end_ms": 277790,
      "text": "不婚不育。",
      "token_start": 1022,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 277950,
      "end_ms": 280185,
      "text": "这些当时没人敢碰的题目，",
      "token_start": 1026,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 280920,
      "end_ms": 282195,
      "text": "费老不但没拦着，",
      "token_start": 1037,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 282730,
      "end_ms": 284855,
      "text": "还鼓励他直面真实。",
      "token_start": 1044,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 285730,
      "end_ms": 287925,
      "text": "他跑了很多城市和乡村，",
      "token_start": 1052,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 288840,
      "end_ms": 293490,
      "text": "跟不同年龄、不同职业的人面对面聊。",
      "token_start": 1062,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 293570,
      "end_ms": 294885,
      "text": "很多人不愿意开口，",
      "token_start": 1077,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 295190,
      "end_ms": 296825,
      "text": "他就一遍遍做工作。",
      "token_start": 1085,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 297590,
      "end_ms": 299610,
      "text": "最后拿到大量一手资料，",
      "token_start": 1093,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 299850,
      "end_ms": 303270,
      "text": "写出二十万字的中国人的性爱与婚姻。",
      "token_start": 1103,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 304250,
      "end_ms": 307390,
      "text": "第一次把这些禁忌话题摆到了桌面上，",
      "token_start": 1119,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 307750,
      "end_ms": 309010,
      "text": "他不光做学问，",
      "token_start": 1135,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 309210,
      "end_ms": 313190,
      "text": "还推动改变他参与婚姻法修订的讨论，",
      "token_start": 1141,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 313470,
      "end_ms": 319230,
      "text": "跟法学家一起为女性争取平等的财产权、离婚权等。",
      "token_start": 1157,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 319490,
      "end_ms": 320730,
      "text": "他写女性主义，",
      "token_start": 1178,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 321150,
      "end_ms": 322170,
      "text": "明确提出，",
      "token_start": 1184,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 322530,
      "end_ms": 326370,
      "text": "目标是在全人类实现男女平等，",
      "token_start": 1188,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 326730,
      "end_ms": 328320,
      "text": "反对搞对立，",
      "token_start": 1201,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 328680,
      "end_ms": 330280,
      "text": "主张两性合作。",
      "token_start": 1206,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 330340,
      "end_ms": 332380,
      "text": "他上奇葩大会做演讲，",
      "token_start": 1212,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 332780,
      "end_ms": 335380,
      "text": "专门聊那些别人躲着走的话题，",
      "token_start": 1221,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 335780,
      "end_ms": 340220,
      "text": "用数据和理性一点点拆掉大众的偏见。",
      "token_start": 1234,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 341020,
      "end_ms": 342080,
      "text": "个人生活上，",
      "token_start": 1250,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 342300,
      "end_ms": 344280,
      "text": "他同样不按常理出牌。",
      "token_start": 1255,
      "token_end_exclusive": 1264
    },
    {
      "start_ms": 344980,
      "end_ms": 346200,
      "text": "王晓波去世后，",
      "token_start": 1264,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 346360,
      "end_ms": 349200,
      "text": "他没有活成别人眼里的遗孀模板，",
      "token_start": 1270,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 349580,
      "end_ms": 352360,
      "text": "而是和一位叫大侠的伴侣走到了一起。",
      "token_start": 1284,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 352760,
      "end_ms": 354220,
      "text": "两人相伴二十多年，",
      "token_start": 1300,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 354980,
      "end_ms": 356320,
      "text": "两侠文化不算高，",
      "token_start": 1308,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 356720,
      "end_ms": 359205,
      "text": "但为人人真诚会照顾他，",
      "token_start": 1315,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 359570,
      "end_ms": 361035,
      "text": "也愿意听他聊学术。",
      "token_start": 1325,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 361650,
      "end_ms": 362915,
      "text": "外界议论很多。",
      "token_start": 1333,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 363320,
      "end_ms": 364440,
      "text": "他只说感情，",
      "token_start": 1339,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 364440,
      "end_ms": 365320,
      "text": "看的是灵魂，",
      "token_start": 1344,
      "token_end_exclusive": 1349
    },
    {
      "start_ms": 365320,
      "end_ms": 366020,
      "text": "合不合拍，",
      "token_start": 1349,
      "token_end_exclusive": 1353
    },
    {
      "start_ms": 366300,
      "end_ms": 367585,
      "text": "跟性别无关。",
      "token_start": 1353,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 368100,
      "end_ms": 369855,
      "text": "从三反到李营河，",
      "token_start": 1358,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 370220,
      "end_ms": 372655,
      "text": "从禁忌研究到性别平权，",
      "token_start": 1365,
      "token_end_exclusive": 1375
    },
    {
      "start_ms": 373260,
      "end_ms": 375720,
      "text": "他这一辈子都在做一件事，",
      "token_start": 1375,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 376140,
      "end_ms": 379370,
      "text": "把别人设的墙一堵一堵拆掉。",
      "token_start": 1386,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 379590,
      "end_ms": 380555,
      "text": "他告诉我们，",
      "token_start": 1398,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 380840,
      "end_ms": 383830,
      "text": "女人的价值不该由谁的妻子，",
      "token_start": 1403,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 383910,
      "end_ms": 385435,
      "text": "谁的母亲来定义，",
      "token_start": 1415,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 385990,
      "end_ms": 388205,
      "text": "你完全可以活成自己的光。",
      "token_start": 1422,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 388820,
      "end_ms": 391915,
      "text": "如果你也被这种不被定义的人生打动，",
      "token_start": 1433,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 392460,
      "end_ms": 393585,
      "text": "记得点个关注，",
      "token_start": 1449,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 394430,
      "end_ms": 398970,
      "text": "带你解锁更多被刻板印象掩盖的历史人物，",
      "token_start": 1455,
      "token_end_exclusive": 1473
    },
    {
      "start_ms": 398970,
      "end_ms": 402495,
      "text": "读懂他们藏在名气背后的真实人生。",
      "token_start": 1473,
      "token_end_exclusive": 1488
    }
