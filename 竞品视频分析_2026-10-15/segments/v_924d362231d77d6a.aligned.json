{
  "video_id": "v_924d362231d77d6a",
  "duration_s": 536.845011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_924d362231d77d6a.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_924d362231d77d6a.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 1680,
      "end_ms": 2585,
      "text": "跟大家说个事儿，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 4610,
      "end_ms": 6250,
      "text": "这个项目谁能最终拿下来，",
      "token_start": 7,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 6250,
      "end_ms": 8750,
      "text": "公司奖励一百万一百万。",
      "token_start": 18,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 9030,
      "end_ms": 9830,
      "text": "玲玲小张，",
      "token_start": 28,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 9910,
      "end_ms": 10950,
      "text": "你俩明天跟我一起去。",
      "token_start": 32,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 11210,
      "end_ms": 11550,
      "text": "好的，",
      "token_start": 41,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 11550,
      "end_ms": 12470,
      "text": "王姐没问题。",
      "token_start": 43,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 12470,
      "end_ms": 12870,
      "text": "王姐，",
      "token_start": 48,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 13290,
      "end_ms": 13710,
      "text": "对了，",
      "token_start": 50,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 14070,
      "end_ms": 15690,
      "text": "这个项目李总很重视，",
      "token_start": 52,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 15930,
      "end_ms": 17250,
      "text": "你俩跟着我说话，",
      "token_start": 61,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 17250,
      "end_ms": 18130,
      "text": "做事都注意点，",
      "token_start": 68,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 18310,
      "end_ms": 18770,
      "text": "没问题。",
      "token_start": 74,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 18770,
      "end_ms": 19190,
      "text": "王姐，",
      "token_start": 77,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 19410,
      "end_ms": 19870,
      "text": "放心吧，",
      "token_start": 79,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 19870,
      "end_ms": 20990,
      "text": "王姐肯定不给您。",
      "token_start": 82,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 20990,
      "end_ms": 26030,
      "text": "丢脸王总好久不见。",
      "token_start": 89,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26150,
      "end_ms": 26570,
      "text": "王姐，",
      "token_start": 97,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 26870,
      "end_ms": 27590,
      "text": "别来无恙。",
      "token_start": 99,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 27750,
      "end_ms": 28130,
      "text": "小张，",
      "token_start": 103,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 28850,
      "end_ms": 30170,
      "text": "你们这个方案我看过了，",
      "token_start": 105,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 30350,
      "end_ms": 31310,
      "text": "我问你几个问题，",
      "token_start": 115,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 31570,
      "end_ms": 32970,
      "text": "如果这个项目交给你们，",
      "token_start": 122,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 33270,
      "end_ms": 34290,
      "text": "多久能正式落地？",
      "token_start": 132,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 34690,
      "end_ms": 35330,
      "text": "正常情况下，",
      "token_start": 139,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 35330,
      "end_ms": 37990,
      "text": "两周前期准备我们已经做的差不多了。",
      "token_start": 144,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 38370,
      "end_ms": 39730,
      "text": "如果您这边时间比较紧，",
      "token_start": 160,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 39890,
      "end_ms": 41030,
      "text": "我们可以把周期压到十天。",
      "token_start": 170,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 41450,
      "end_ms": 42770,
      "text": "那中间要是出了问题呢，",
      "token_start": 181,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 43110,
      "end_ms": 45770,
      "text": "谁来负责这个项目？",
      "token_start": 191,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 45770,
      "end_ms": 46670,
      "text": "由我全程跟进，",
      "token_start": 199,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 47090,
      "end_ms": 47870,
      "text": "真出了问题，",
      "token_start": 205,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 48070,
      "end_ms": 51970,
      "text": "您不用找别人直接找我行。",
      "token_start": 210,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 52210,
      "end_ms": 53190,
      "text": "还有最后一个问题，",
      "token_start": 221,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 53710,
      "end_ms": 54690,
      "text": "这么大的项目，",
      "token_start": 229,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 55050,
      "end_ms": 56590,
      "text": "你凭什么觉得你们能做好？",
      "token_start": 235,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 57290,
      "end_ms": 57790,
      "text": "李总，",
      "token_start": 246,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 58290,
      "end_ms": 60410,
      "text": "我们不敢保证项目过程中一点问题都没有，",
      "token_start": 248,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 60410,
      "end_ms": 62125,
      "text": "但我能保证真出了问题，",
      "token_start": 266,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 62590,
      "end_ms": 64430,
      "text": "我们不会躲第一时间解决，",
      "token_start": 276,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 64490,
      "end_ms": 65465,
      "text": "绝不耽误您的进度。",
      "token_start": 287,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 66620,
      "end_ms": 67105,
      "text": "不错，",
      "token_start": 295,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 70850,
      "end_ms": 71615,
      "text": "小张啊，",
      "token_start": 297,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 72300,
      "end_ms": 75175,
      "text": "你是第一个十来分钟就能把项目谈下来的人，",
      "token_start": 300,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 75820,
      "end_ms": 77195,
      "text": "真是后生可畏啊，",
      "token_start": 319,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 77610,
      "end_ms": 79835,
      "text": "哪里哪里还是我们王姐厉害，",
      "token_start": 326,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 80310,
      "end_ms": 85600,
      "text": "我就是个打辅助的合同，",
      "token_start": 338,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 85600,
      "end_ms": 86735,
      "text": "今天先不着急签。",
      "token_start": 348,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 87650,
      "end_ms": 89105,
      "text": "李总还有什么问题吗？",
      "token_start": 355,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 89460,
      "end_ms": 91115,
      "text": "没什么这么大的项目，",
      "token_start": 364,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 91410,
      "end_ms": 92215,
      "text": "我再考虑考虑。",
      "token_start": 373,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 92750,
      "end_ms": 96250,
      "text": "李总这正好明天晚上我组了个局陈，",
      "token_start": 379,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 96250,
      "end_ms": 97045,
      "text": "总也会过来。",
      "token_start": 394,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 97780,
      "end_ms": 100335,
      "text": "王杰要是有时间一起吃个饭，",
      "token_start": 399,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 101470,
      "end_ms": 102250,
      "text": "李总邀请，",
      "token_start": 411,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 102350,
      "end_ms": 103345,
      "text": "那肯定有时间。",
      "token_start": 415,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 104790,
      "end_ms": 105175,
      "text": "行，",
      "token_start": 421,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 106100,
      "end_ms": 106985,
      "text": "那项目事儿，",
      "token_start": 422,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 107420,
      "end_ms": 110675,
      "text": "咱们明天再聊啊。",
      "token_start": 427,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 110900,
      "end_ms": 111285,
      "text": "王姐，",
      "token_start": 434,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 113030,
      "end_ms": 114995,
      "text": "刚才项目不是都已经谈好了吗？",
      "token_start": 436,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 115330,
      "end_ms": 116325,
      "text": "合同都准备签了，",
      "token_start": 449,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 116740,
      "end_ms": 120895,
      "text": "李总怎么突然又说要考虑你自己想想刚才说什么了，",
      "token_start": 456,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 121380,
      "end_ms": 122655,
      "text": "我也没说什么啊。",
      "token_start": 478,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 122970,
      "end_ms": 123690,
      "text": "李总夸我，",
      "token_start": 485,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 123690,
      "end_ms": 124765,
      "text": "我就是谦虚了一下，",
      "token_start": 489,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 125070,
      "end_ms": 126250,
      "text": "总不能人家夸我两句，",
      "token_start": 497,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 126250,
      "end_ms": 127125,
      "text": "我还真认了吧。",
      "token_start": 506,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 127410,
      "end_ms": 130085,
      "text": "李总夸你是认可你的能力，",
      "token_start": 512,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 130510,
      "end_ms": 131545,
      "text": "结果你倒好，",
      "token_start": 523,
      "token_end_exclusive": 528
    },
    {
      "start_ms": 131890,
      "end_ms": 132930,
      "text": "自己先告诉人家，",
      "token_start": 528,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 133090,
      "end_ms": 136165,
      "text": "你就是个打辅助的这句话有什么问题。",
      "token_start": 535,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 136650,
      "end_ms": 137830,
      "text": "一千万的项目，",
      "token_start": 551,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 137830,
      "end_ms": 139570,
      "text": "你自己都不敢认自己的能力，",
      "token_start": 557,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 139570,
      "end_ms": 140735,
      "text": "你让客户怎么放心？",
      "token_start": 569,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 142350,
      "end_ms": 143505,
      "text": "就因为这一句话，",
      "token_start": 577,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 144000,
      "end_ms": 146615,
      "text": "很多时候人家看的不只是你会不会做事，",
      "token_start": 584,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 147080,
      "end_ms": 148825,
      "text": "也看你会不会跟人打交道，",
      "token_start": 601,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 149680,
      "end_ms": 151200,
      "text": "那这个项目是不是没戏了？",
      "token_start": 612,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 151320,
      "end_ms": 151960,
      "text": "还有机会，",
      "token_start": 623,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 152080,
      "end_ms": 153705,
      "text": "李总既然没有直接拒绝，",
      "token_start": 627,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 154000,
      "end_ms": 155465,
      "text": "还主动约了明天的饭局，",
      "token_start": 637,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 155700,
      "end_ms": 157015,
      "text": "就说明事情还有转机。",
      "token_start": 647,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 157640,
      "end_ms": 159435,
      "text": "能不能把这个项目拿下来，",
      "token_start": 656,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 159840,
      "end_ms": 161345,
      "text": "就看你们两个明天的表现了。",
      "token_start": 667,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 164650,
      "end_ms": 165010,
      "text": "哎呀，",
      "token_start": 679,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 165010,
      "end_ms": 166010,
      "text": "这肯定迟到了呀。",
      "token_start": 681,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 166010,
      "end_ms": 167495,
      "text": "今天这场商务洽谈很重要，",
      "token_start": 688,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 167870,
      "end_ms": 168985,
      "text": "去晚了可咋办呀？",
      "token_start": 699,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 169410,
      "end_ms": 174565,
      "text": "急什么合作方那边能够理解路况堵车的啊，",
      "token_start": 706,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 175450,
      "end_ms": 176215,
      "text": "没关系，",
      "token_start": 724,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 176680,
      "end_ms": 178315,
      "text": "兵来将挡水来土掩，",
      "token_start": 727,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 178680,
      "end_ms": 180095,
      "text": "有王姐在怕啥？",
      "token_start": 735,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 180900,
      "end_ms": 183840,
      "text": "今天我当个观众能不能拿下这笔大业务，",
      "token_start": 741,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 183980,
      "end_ms": 186720,
      "text": "就看你俩的表现了哟。",
      "token_start": 758,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 187140,
      "end_ms": 188835,
      "text": "来这么晚只能吃剩饭了吧。",
      "token_start": 767,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 189110,
      "end_ms": 190155,
      "text": "王总真不好意思，",
      "token_start": 778,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 191010,
      "end_ms": 191970,
      "text": "路上太堵了。",
      "token_start": 785,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 191970,
      "end_ms": 193450,
      "text": "我们哎呀，",
      "token_start": 790,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 193450,
      "end_ms": 194710,
      "text": "王总饭在哪儿？",
      "token_start": 794,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 194710,
      "end_ms": 195390,
      "text": "我们都能吃，",
      "token_start": 800,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 195650,
      "end_ms": 198045,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 805,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 198370,
      "end_ms": 199995,
      "text": "能赶上已经是我们的运气了。",
      "token_start": 818,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 200240,
      "end_ms": 200765,
      "text": "哈哈哈，",
      "token_start": 830,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 201160,
      "end_ms": 201880,
      "text": "赶紧坐吧，",
      "token_start": 833,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 202060,
      "end_ms": 203425,
      "text": "位置都给你们留好了。",
      "token_start": 837,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 203750,
      "end_ms": 212460,
      "text": "哼各位领导，",
      "token_start": 846,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 212540,
      "end_ms": 213180,
      "text": "不好意思，",
      "token_start": 851,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 213180,
      "end_ms": 214040,
      "text": "今天迟到了，",
      "token_start": 855,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 214040,
      "end_ms": 215300,
      "text": "我们给大家敬一个来，",
      "token_start": 860,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 215300,
      "end_ms": 215695,
      "text": "小张，",
      "token_start": 869,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 215890,
      "end_ms": 216695,
      "text": "你来起个头吧，",
      "token_start": 871,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 219220,
      "end_ms": 220180,
      "text": "大家吃好喝。",
      "token_start": 877,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 220180,
      "end_ms": 220420,
      "text": "好，",
      "token_start": 882,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 220620,
      "end_ms": 221995,
      "text": "我干了领导们随意，",
      "token_start": 883,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 224790,
      "end_ms": 224955,
      "text": "嗯，",
      "token_start": 891,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 225250,
      "end_ms": 226005,
      "text": "这就完了。",
      "token_start": 892,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 227310,
      "end_ms": 227545,
      "text": "嗯，",
      "token_start": 896,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 227870,
      "end_ms": 228355,
      "text": "完了，",
      "token_start": 897,
      "token_end_exclusive": 899
    },
    {
      "start_ms": 229060,
      "end_ms": 229425,
      "text": "哎，",
      "token_start": 899,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 234660,
      "end_ms": 235295,
      "text": "来琳琳，",
      "token_start": 900,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 236010,
      "end_ms": 240830,
      "text": "你也给大家敬一个这俗话说跟着领导走，",
      "token_start": 903,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 241030,
      "end_ms": 242090,
      "text": "吃喝啥都有，",
      "token_start": 920,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 242410,
      "end_ms": 243530,
      "text": "跟着领导干呀，",
      "token_start": 925,
      "token_end_exclusive": 931
    },
    {
      "start_ms": 243650,
      "end_ms": 244970,
      "text": "年年赚个几百万。",
      "token_start": 931,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 245150,
      "end_ms": 246110,
      "text": "非常感谢李总。",
      "token_start": 938,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 246110,
      "end_ms": 246870,
      "text": "今天组的局，",
      "token_start": 944,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 247070,
      "end_ms": 248610,
      "text": "也感谢王姐带我们过来，",
      "token_start": 949,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 248630,
      "end_ms": 250210,
      "text": "让我们有幸认识各位前辈，",
      "token_start": 959,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 250230,
      "end_ms": 250870,
      "text": "我叫琳琳。",
      "token_start": 970,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 250990,
      "end_ms": 251530,
      "text": "俗话说，",
      "token_start": 974,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 251650,
      "end_ms": 252790,
      "text": "相聚是一种缘分。",
      "token_start": 977,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 253090,
      "end_ms": 253810,
      "text": "此时此刻，",
      "token_start": 984,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 253870,
      "end_ms": 256190,
      "text": "我把对各位的祝福化作一杯美酒，",
      "token_start": 988,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 256410,
      "end_ms": 257770,
      "text": "祝各位扶摇直上。",
      "token_start": 1002,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 257770,
      "end_ms": 258290,
      "text": "九万里，",
      "token_start": 1009,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 258550,
      "end_ms": 259870,
      "text": "事业长虹节节高。",
      "token_start": 1012,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 259870,
      "end_ms": 260110,
      "text": "好，",
      "token_start": 1019,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 262110,
      "end_ms": 263185,
      "text": "这姑娘会说话，",
      "token_start": 1020,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 269590,
      "end_ms": 270025,
      "text": "王姐，",
      "token_start": 1026,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 270370,
      "end_ms": 271030,
      "text": "来石杯，",
      "token_start": 1028,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 271030,
      "end_ms": 273370,
      "text": "我敬你陈总这杯，",
      "token_start": 1031,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 273370,
      "end_ms": 274225,
      "text": "我替王姐敬您，",
      "token_start": 1038,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 275520,
      "end_ms": 276725,
      "text": "我敬的是你们领导，",
      "token_start": 1044,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 277260,
      "end_ms": 278135,
      "text": "你是领导吗？",
      "token_start": 1052,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 278970,
      "end_ms": 279795,
      "text": "瞧您说的，",
      "token_start": 1057,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 280190,
      "end_ms": 281310,
      "text": "您敬的是我领导，",
      "token_start": 1061,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 281410,
      "end_ms": 283185,
      "text": "我同样敬的也是领导，",
      "token_start": 1068,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 283540,
      "end_ms": 284600,
      "text": "您敬领导是心意，",
      "token_start": 1077,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 284720,
      "end_ms": 286580,
      "text": "我敬您是尊敬这杯，",
      "token_start": 1084,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 286580,
      "end_ms": 287535,
      "text": "我敬的是生意，",
      "token_start": 1092,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 287940,
      "end_ms": 288600,
      "text": "咱们随意，",
      "token_start": 1098,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 288660,
      "end_ms": 289940,
      "text": "祝您生意一路长虹，",
      "token_start": 1102,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 290020,
      "end_ms": 291475,
      "text": "万事顺利，",
      "token_start": 1110,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 292660,
      "end_ms": 293920,
      "text": "这小姑娘会说话。",
      "token_start": 1114,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 294000,
      "end_ms": 295560,
      "text": "琳琳刚才说的不错，",
      "token_start": 1121,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 295560,
      "end_ms": 296340,
      "text": "来咱俩喝一个，",
      "token_start": 1129,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 296340,
      "end_ms": 296975,
      "text": "谢谢陈总。",
      "token_start": 1135,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 300050,
      "end_ms": 300290,
      "text": "哎，",
      "token_start": 1139,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 300730,
      "end_ms": 302550,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 1140,
      "token_end_exclusive": 1151
    },
    {
      "start_ms": 302550,
      "end_ms": 303550,
      "text": "陈总瓶底酒，",
      "token_start": 1151,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 303550,
      "end_ms": 305870,
      "text": "这要发财酒到底发财好事，",
      "token_start": 1156,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 305890,
      "end_ms": 308410,
      "text": "再来好一个发财酒。",
      "token_start": 1167,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 309150,
      "end_ms": 309665,
      "text": "琳琳。",
      "token_start": 1175,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 310580,
      "end_ms": 311600,
      "text": "我再问你个问题，",
      "token_start": 1177,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 312080,
      "end_ms": 314320,
      "text": "你觉得我和李总你更喜欢谁？",
      "token_start": 1184,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 314400,
      "end_ms": 315035,
      "text": "好好好，",
      "token_start": 1196,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 317160,
      "end_ms": 318620,
      "text": "领导怎么能用喜欢呢？",
      "token_start": 1199,
      "token_end_exclusive": 1208
    },
    {
      "start_ms": 318640,
      "end_ms": 320840,
      "text": "那得是尊敬两位领导，",
      "token_start": 1208,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 320840,
      "end_ms": 326980,
      "text": "我都尊敬这姑娘聪明琳琳，",
      "token_start": 1217,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 327760,
      "end_ms": 328760,
      "text": "这条鱼没怎么动，",
      "token_start": 1228,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 329320,
      "end_ms": 330080,
      "text": "都是自己人，",
      "token_start": 1235,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 330140,
      "end_ms": 330680,
      "text": "别嫌弃，",
      "token_start": 1240,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 331060,
      "end_ms": 331880,
      "text": "一会儿打包带回去，",
      "token_start": 1243,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 331880,
      "end_ms": 332240,
      "text": "吃吧，",
      "token_start": 1251,
      "token_end_exclusive": 1253
    },
    {
      "start_ms": 332320,
      "end_ms": 333200,
      "text": "还能补补身子。",
      "token_start": 1253,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 333940,
      "end_ms": 336060,
      "text": "琳琳陈总让你拿，",
      "token_start": 1259,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 336120,
      "end_ms": 336900,
      "text": "你就拿着呗，",
      "token_start": 1266,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 337820,
      "end_ms": 338880,
      "text": "太感谢陈总了，",
      "token_start": 1271,
      "token_end_exclusive": 1277
    },
    {
      "start_ms": 339060,
      "end_ms": 340780,
      "text": "但是一整条鱼我自己也吃不完。",
      "token_start": 1277,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 340900,
      "end_ms": 342459,
      "text": "我平时喜欢吃鱼尾，",
      "token_start": 1290,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 342700,
      "end_ms": 344440,
      "text": "上面这部分我给您打包带回去，",
      "token_start": 1298,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 344440,
      "end_ms": 345420,
      "text": "给嫂子也尝一下，",
      "token_start": 1311,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 345420,
      "end_ms": 346940,
      "text": "以后还希望您多多照顾。",
      "token_start": 1318,
      "token_end_exclusive": 1328
    },
    {
      "start_ms": 347920,
      "end_ms": 350505,
      "text": "看来今天这条鱼没白点，",
      "token_start": 1328,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 357820,
      "end_ms": 358720,
      "text": "李总刚来消息，",
      "token_start": 1338,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 358820,
      "end_ms": 359500,
      "text": "合同签了，",
      "token_start": 1344,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 359940,
      "end_ms": 361280,
      "text": "真的真的。",
      "token_start": 1348,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 361500,
      "end_ms": 363260,
      "text": "不过李总还特意提了一个要求，",
      "token_start": 1352,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 363500,
      "end_ms": 367180,
      "text": "什么要求这个一千万的项目后面让玲玲负责。",
      "token_start": 1365,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 367940,
      "end_ms": 372055,
      "text": "我对小张你的业务能力没问题。",
      "token_start": 1384,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 372380,
      "end_ms": 376315,
      "text": "但是李总说这么大的项目后面少不了跟各种人打交道，",
      "token_start": 1397,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 376780,
      "end_ms": 379105,
      "text": "所以这个项目他更希望琳琳来负责。",
      "token_start": 1420,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 379800,
      "end_ms": 380535,
      "text": "谢谢王姐，",
      "token_start": 1435,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 380920,
      "end_ms": 382260,
      "text": "我一定把这个项目做好。",
      "token_start": 1439,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 382420,
      "end_ms": 384360,
      "text": "还有我第一天说过，",
      "token_start": 1449,
      "token_end_exclusive": 1457
    },
    {
      "start_ms": 384600,
      "end_ms": 386120,
      "text": "谁能最终拿下这个项目，",
      "token_start": 1457,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 386120,
      "end_ms": 387260,
      "text": "公司奖励一百万，",
      "token_start": 1467,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 387500,
      "end_ms": 388400,
      "text": "现在项目签了，",
      "token_start": 1474,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 388560,
      "end_ms": 389935,
      "text": "李总又点名让你负责，",
      "token_start": 1480,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 390340,
      "end_ms": 394295,
      "text": "所以这一百万奖励是你的一百万给我。",
      "token_start": 1489,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 394620,
      "end_ms": 394905,
      "text": "对，",
      "token_start": 1505,
      "token_end_exclusive": 1506
    },
    {
      "start_ms": 395180,
      "end_ms": 396015,
      "text": "这是你应得的。",
      "token_start": 1506,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 396490,
      "end_ms": 397905,
      "text": "谢谢王姐琳琳，",
      "token_start": 1512,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 398160,
      "end_ms": 399260,
      "text": "我现在是真服你了，",
      "token_start": 1518,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 399260,
      "end_ms": 399740,
      "text": "怎么了？",
      "token_start": 1526,
      "token_end_exclusive": 1529
    },
    {
      "start_ms": 399880,
      "end_ms": 402170,
      "text": "这个项目明明是我先谈的业务问题，",
      "token_start": 1529,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 402170,
      "end_ms": 402965,
      "text": "也是我回答的。",
      "token_start": 1544,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 403410,
      "end_ms": 405370,
      "text": "刚才王姐说李总最后点名让你负责，",
      "token_start": 1550,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 405370,
      "end_ms": 406910,
      "text": "连一百万奖励都给你的时候，",
      "token_start": 1565,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 406910,
      "end_ms": 408475,
      "text": "我一开始还真有点想不明白，",
      "token_start": 1577,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 409270,
      "end_ms": 411470,
      "text": "可我一想到昨天饭桌上发生的那些事儿，",
      "token_start": 1589,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 411470,
      "end_ms": 412355,
      "text": "我就明白了。",
      "token_start": 1606,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 412590,
      "end_ms": 413390,
      "text": "昨天陈总说，",
      "token_start": 1611,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 413490,
      "end_ms": 414470,
      "text": "我敬的是你们领导，",
      "token_start": 1616,
      "token_end_exclusive": 1624
    },
    {
      "start_ms": 414470,
      "end_ms": 415270,
      "text": "你是领导吗？",
      "token_start": 1624,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 415270,
      "end_ms": 415690,
      "text": "换成我，",
      "token_start": 1629,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 415690,
      "end_ms": 417115,
      "text": "我当场就不知道该说什么了。",
      "token_start": 1632,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 417440,
      "end_ms": 418720,
      "text": "饭局上突然让你讲话，",
      "token_start": 1644,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 418940,
      "end_ms": 419740,
      "text": "给李总倒酒，",
      "token_start": 1653,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 419740,
      "end_ms": 420360,
      "text": "只剩半杯。",
      "token_start": 1658,
      "token_end_exclusive": 1662
    },
    {
      "start_ms": 420520,
      "end_ms": 421260,
      "text": "陈总又问你，",
      "token_start": 1662,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 421260,
      "end_ms": 422615,
      "text": "他和李总你更喜欢谁？",
      "token_start": 1667,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 422950,
      "end_ms": 423935,
      "text": "还有最后那条鱼，",
      "token_start": 1676,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 424500,
      "end_ms": 425520,
      "text": "我到现在才明白，",
      "token_start": 1683,
      "token_end_exclusive": 1690
    },
    {
      "start_ms": 425660,
      "end_ms": 427395,
      "text": "陈总说的根本就不只是鱼。",
      "token_start": 1690,
      "token_end_exclusive": 1701
    },
    {
      "start_ms": 428820,
      "end_ms": 432635,
      "text": "现在我算知道为什么李总最后会点名让你负责这个项目了。",
      "token_start": 1701,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 434010,
      "end_ms": 435610,
      "text": "为什么别人突然给你一句话，",
      "token_start": 1726,
      "token_end_exclusive": 1738
    },
    {
      "start_ms": 435950,
      "end_ms": 437275,
      "text": "你马上就知道该怎么接。",
      "token_start": 1738,
      "token_end_exclusive": 1748
    },
    {
      "start_ms": 437660,
      "end_ms": 438960,
      "text": "其实我以前跟你一样，",
      "token_start": 1748,
      "token_end_exclusive": 1757
    },
    {
      "start_ms": 439120,
      "end_ms": 439840,
      "text": "不爱说话，",
      "token_start": 1757,
      "token_end_exclusive": 1761
    },
    {
      "start_ms": 439980,
      "end_ms": 441320,
      "text": "也不知道怎么组织语言，",
      "token_start": 1761,
      "token_end_exclusive": 1771
    },
    {
      "start_ms": 441400,
      "end_ms": 443455,
      "text": "一到这种场合就不知道应该说什么。",
      "token_start": 1771,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 443910,
      "end_ms": 446805,
      "text": "后来我就经常看这本把话说的恰到好处。",
      "token_start": 1786,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 447450,
      "end_ms": 448970,
      "text": "它里面就是一个场景，",
      "token_start": 1803,
      "token_end_exclusive": 1812
    },
    {
      "start_ms": 448970,
      "end_ms": 450190,
      "text": "一个场景的告诉你，",
      "token_start": 1812,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 450210,
      "end_ms": 452390,
      "text": "遇到不同的人不同的话应该怎么接。",
      "token_start": 1820,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 452670,
      "end_ms": 454430,
      "text": "比如别人夸你优秀，",
      "token_start": 1835,
      "token_end_exclusive": 1843
    },
    {
      "start_ms": 454530,
      "end_ms": 455130,
      "text": "你可以回，",
      "token_start": 1843,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 455430,
      "end_ms": 456750,
      "text": "那是不优秀点儿，",
      "token_start": 1847,
      "token_end_exclusive": 1854
    },
    {
      "start_ms": 456750,
      "end_ms": 458245,
      "text": "怎么能和你做朋友呢？",
      "token_start": 1854,
      "token_end_exclusive": 1863
    },
    {
      "start_ms": 458720,
      "end_ms": 460160,
      "text": "当别人说你真聪明，",
      "token_start": 1863,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 460240,
      "end_ms": 462095,
      "text": "你就回近朱者赤，",
      "token_start": 1871,
      "token_end_exclusive": 1878
    },
    {
      "start_ms": 462400,
      "end_ms": 463320,
      "text": "和你在一起啊，",
      "token_start": 1878,
      "token_end_exclusive": 1884
    },
    {
      "start_ms": 463340,
      "end_ms": 465660,
      "text": "熏都熏出来了当领导跟你说，",
      "token_start": 1884,
      "token_end_exclusive": 1896
    },
    {
      "start_ms": 465660,
      "end_ms": 466200,
      "text": "辛苦了，",
      "token_start": 1896,
      "token_end_exclusive": 1899
    },
    {
      "start_ms": 466200,
      "end_ms": 467440,
      "text": "你就回领导，",
      "token_start": 1899,
      "token_end_exclusive": 1904
    },
    {
      "start_ms": 467540,
      "end_ms": 468705,
      "text": "这都是我应该做的。",
      "token_start": 1904,
      "token_end_exclusive": 1912
    },
    {
      "start_ms": 468950,
      "end_ms": 470190,
      "text": "强将手下无弱兵，",
      "token_start": 1912,
      "token_end_exclusive": 1919
    },
    {
      "start_ms": 470250,
      "end_ms": 471590,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 1919,
      "token_end_exclusive": 1928
    },
    {
      "start_ms": 471770,
      "end_ms": 473515,
      "text": "难怪你每次都能接的这么快，",
      "token_start": 1928,
      "token_end_exclusive": 1940
    },
    {
      "start_ms": 473880,
      "end_ms": 475405,
      "text": "这种东西不是天生的，",
      "token_start": 1940,
      "token_end_exclusive": 1949
    },
    {
      "start_ms": 476090,
      "end_ms": 477310,
      "text": "就是平时一个场景，",
      "token_start": 1949,
      "token_end_exclusive": 1957
    },
    {
      "start_ms": 477310,
      "end_ms": 478110,
      "text": "一个场景的看，",
      "token_start": 1957,
      "token_end_exclusive": 1963
    },
    {
      "start_ms": 478310,
      "end_ms": 478890,
      "text": "一个场景，",
      "token_start": 1963,
      "token_end_exclusive": 1967
    },
    {
      "start_ms": 478890,
      "end_ms": 479834,
      "text": "一个场景的练。",
      "token_start": 1967,
      "token_end_exclusive": 1973
    },
    {
      "start_ms": 480380,
      "end_ms": 481320,
      "text": "每天看两页，",
      "token_start": 1973,
      "token_end_exclusive": 1978
    },
    {
      "start_ms": 481560,
      "end_ms": 483760,
      "text": "慢慢积累一些不同的场景之下，",
      "token_start": 1978,
      "token_end_exclusive": 1991
    },
    {
      "start_ms": 483780,
      "end_ms": 484540,
      "text": "应该怎么说？",
      "token_start": 1991,
      "token_end_exclusive": 1996
    },
    {
      "start_ms": 484780,
      "end_ms": 486685,
      "text": "这里面还有很多生活里的场景，",
      "token_start": 1996,
      "token_end_exclusive": 2009
    },
    {
      "start_ms": 487000,
      "end_ms": 488320,
      "text": "比如对象给你发红包，",
      "token_start": 2009,
      "token_end_exclusive": 2018
    },
    {
      "start_ms": 488380,
      "end_ms": 491185,
      "text": "你可以回你是我致富道路上最大的功臣，",
      "token_start": 2018,
      "token_end_exclusive": 2035
    },
    {
      "start_ms": 491620,
      "end_ms": 492520,
      "text": "同事向你借钱，",
      "token_start": 2035,
      "token_end_exclusive": 2041
    },
    {
      "start_ms": 492660,
      "end_ms": 493400,
      "text": "你又不想借，",
      "token_start": 2041,
      "token_end_exclusive": 2046
    },
    {
      "start_ms": 493680,
      "end_ms": 494275,
      "text": "可以回，",
      "token_start": 2046,
      "token_end_exclusive": 2049
    },
    {
      "start_ms": 494620,
      "end_ms": 495980,
      "text": "大家都是一样的年纪，",
      "token_start": 2049,
      "token_end_exclusive": 2058
    },
    {
      "start_ms": 496100,
      "end_ms": 496800,
      "text": "你没有的，",
      "token_start": 2058,
      "token_end_exclusive": 2062
    },
    {
      "start_ms": 496880,
      "end_ms": 497640,
      "text": "我能有吗？",
      "token_start": 2062,
      "token_end_exclusive": 2066
    },
    {
      "start_ms": 497820,
      "end_ms": 500120,
      "text": "还有心仪的人跟你说我想你了，",
      "token_start": 2066,
      "token_end_exclusive": 2079
    },
    {
      "start_ms": 500140,
      "end_ms": 501820,
      "text": "你可以回随便想，",
      "token_start": 2079,
      "token_end_exclusive": 2086
    },
    {
      "start_ms": 501980,
      "end_ms": 503160,
      "text": "千万别跟我客气，",
      "token_start": 2086,
      "token_end_exclusive": 2093
    },
    {
      "start_ms": 503280,
      "end_ms": 504365,
      "text": "目前不收费。",
      "token_start": 2093,
      "token_end_exclusive": 2098
    },
    {
      "start_ms": 504840,
      "end_ms": 506585,
      "text": "呵呵呵呵这个有意思。",
      "token_start": 2098,
      "token_end_exclusive": 2107
    },
    {
      "start_ms": 506970,
      "end_ms": 508290,
      "text": "我第一次读到这些的时候，",
      "token_start": 2107,
      "token_end_exclusive": 2118
    },
    {
      "start_ms": 508290,
      "end_ms": 509885,
      "text": "真的有种豁然开朗的感觉。",
      "token_start": 2118,
      "token_end_exclusive": 2129
    },
    {
      "start_ms": 510400,
      "end_ms": 514040,
      "text": "这本书就是把工作、生活、人际交往里经常遇到的场景，",
      "token_start": 2129,
      "token_end_exclusive": 2151
    },
    {
      "start_ms": 514200,
      "end_ms": 515695,
      "text": "一个一个拆开给你看，",
      "token_start": 2151,
      "token_end_exclusive": 2160
    },
    {
      "start_ms": 516110,
      "end_ms": 516850,
      "text": "别人怎么说，",
      "token_start": 2160,
      "token_end_exclusive": 2165
    },
    {
      "start_ms": 516970,
      "end_ms": 517855,
      "text": "你可以怎么接，",
      "token_start": 2165,
      "token_end_exclusive": 2171
    },
    {
      "start_ms": 518190,
      "end_ms": 519535,
      "text": "都是一句一句给你举例。",
      "token_start": 2171,
      "token_end_exclusive": 2181
    },
    {
      "start_ms": 520290,
      "end_ms": 522405,
      "text": "所以你平时就是这么练的对呀，",
      "token_start": 2181,
      "token_end_exclusive": 2194
    },
    {
      "start_ms": 522900,
      "end_ms": 523480,
      "text": "每天不用看，",
      "token_start": 2194,
      "token_end_exclusive": 2199
    },
    {
      "start_ms": 523480,
      "end_ms": 524655,
      "text": "很多看两页，",
      "token_start": 2199,
      "token_end_exclusive": 2204
    },
    {
      "start_ms": 524960,
      "end_ms": 526955,
      "text": "碰到自己觉得有用的表达就记一记，",
      "token_start": 2204,
      "token_end_exclusive": 2219
    },
    {
      "start_ms": 527350,
      "end_ms": 528410,
      "text": "慢慢积累的多了。",
      "token_start": 2219,
      "token_end_exclusive": 2226
    },
    {
      "start_ms": 528670,
      "end_ms": 530765,
      "text": "工作和生活里再碰到类似的场景，",
      "token_start": 2226,
      "token_end_exclusive": 2240
    },
    {
      "start_ms": 531050,
      "end_ms": 532135,
      "text": "你就知道怎么接了。",
      "token_start": 2240,
      "token_end_exclusive": 2248
    },
    {
      "start_ms": 533430,
      "end_ms": 533990,
      "text": "这本先借，",
      "token_start": 2248,
      "token_end_exclusive": 2252
    },
    {
      "start_ms": 533990,
      "end_ms": 535650,
      "text": "我看看拿去吧，",
      "token_start": 2252,
      "token_end_exclusive": 2258
    },
    {
      "start_ms": 535750,
      "end_ms": 536565,
      "text": "回去慢慢看。",
      "token_start": 2258,
      "token_end_exclusive": 2263
    }
