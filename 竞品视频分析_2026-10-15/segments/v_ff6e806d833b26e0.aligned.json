{
  "video_id": "v_ff6e806d833b26e0",
  "duration_s": 359.91,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_ff6e806d833b26e0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_ff6e806d833b26e0.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 4530,
      "text": "您知道中国古代那些号称万夫莫开的逆天关隘，",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 5030,
      "end_ms": 8410,
      "text": "真正排第一的究竟是哪一座吗？",
      "token_start": 20,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 9010,
      "end_ms": 11530,
      "text": "有人说是山海关两下，",
      "token_start": 33,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 11610,
      "end_ms": 12130,
      "text": "第一关，",
      "token_start": 42,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12450,
      "end_ms": 13970,
      "text": "老龙头伸进海里。",
      "token_start": 45,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 14450,
      "end_ms": 18110,
      "text": "有人说是嘉峪关天下第一雄关，",
      "token_start": 52,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 18510,
      "end_ms": 21530,
      "text": "名长城最西端错了，",
      "token_start": 65,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 22190,
      "end_ms": 22830,
      "text": "第一名，",
      "token_start": 73,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 23190,
      "end_ms": 26670,
      "text": "被公认为中国关隘的终极天花板。",
      "token_start": 76,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 27430,
      "end_ms": 28710,
      "text": "两千多年来，",
      "token_start": 90,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 28970,
      "end_ms": 31060,
      "text": "谁想从他身上身上跨过去，",
      "token_start": 95,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 31520,
      "end_ms": 34360,
      "text": "都得先问问自己命够不够硬。",
      "token_start": 106,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 34960,
      "end_ms": 41720,
      "text": "今天咱们就来盘点盘点中国古代十大超级逆天关隘。",
      "token_start": 118,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 41820,
      "end_ms": 42440,
      "text": "老规矩，",
      "token_start": 140,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 42780,
      "end_ms": 43700,
      "text": "开讲之前，",
      "token_start": 143,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 43780,
      "end_ms": 46740,
      "text": "劳烦您顺手扣个一点颗红心，",
      "token_start": 147,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 47180,
      "end_ms": 49260,
      "text": "让我看看都是谁在听。",
      "token_start": 159,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 50380,
      "end_ms": 51060,
      "text": "第十名，",
      "token_start": 168,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 51440,
      "end_ms": 57460,
      "text": "娘子关在山西阳泉平定县、万里长城的第九关。",
      "token_start": 171,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 57940,
      "end_ms": 60865,
      "text": "这关最绝的是他的名字，",
      "token_start": 190,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 61840,
      "end_ms": 62725,
      "text": "一个关隘，",
      "token_start": 200,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 63600,
      "end_ms": 67045,
      "text": "用女人命名的全国找不出第二座。",
      "token_start": 204,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 67350,
      "end_ms": 68325,
      "text": "唐朝初年，",
      "token_start": 218,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 68630,
      "end_ms": 73615,
      "text": "李渊的三女儿平阳公主带着一支娘子军驻守在这里，",
      "token_start": 222,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 73940,
      "end_ms": 76130,
      "text": "平阳公主的部队打仗，",
      "token_start": 244,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 76130,
      "end_ms": 77025,
      "text": "比男人还狠。",
      "token_start": 253,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 77630,
      "end_ms": 78830,
      "text": "公主去世以后，",
      "token_start": 258,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 79030,
      "end_ms": 80410,
      "text": "老百姓为了纪念她，",
      "token_start": 264,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 80510,
      "end_ms": 81770,
      "text": "把这官叫娘子。",
      "token_start": 272,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 81770,
      "end_ms": 84195,
      "text": "官官城不大，",
      "token_start": 278,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 85020,
      "end_ms": 87120,
      "text": "箭在悬崖上牙，",
      "token_start": 283,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 87160,
      "end_ms": 88475,
      "text": "斗如刀削，",
      "token_start": 289,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 89250,
      "end_ms": 91395,
      "text": "东门南门两座关门，",
      "token_start": 293,
      "token_end_exclusive": 301
    },
    {
      "start_ms": 91720,
      "end_ms": 92580,
      "text": "六百五十米。",
      "token_start": 301,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 92580,
      "end_ms": 95080,
      "text": "城墙一边是桃核，",
      "token_start": 306,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 95340,
      "end_ms": 96505,
      "text": "一边是绝壁。",
      "token_start": 313,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 96970,
      "end_ms": 99475,
      "text": "您说这是官还是给一个女人立的碑？",
      "token_start": 318,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 100140,
      "end_ms": 100805,
      "text": "第九名，",
      "token_start": 333,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 101360,
      "end_ms": 104740,
      "text": "紫金关在河北保定易县太行，",
      "token_start": 336,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 104820,
      "end_ms": 107800,
      "text": "扒着你的第七头辅音，",
      "token_start": 348,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 108370,
      "end_ms": 112245,
      "text": "这官最绝的是他见证了一个王朝的崩塌。",
      "token_start": 357,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 112930,
      "end_ms": 117985,
      "text": "一四四九年土木之变明英宗被瓦剌俘虏，",
      "token_start": 374,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 118270,
      "end_ms": 119890,
      "text": "瓦剌大军压着皇帝，",
      "token_start": 391,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 120050,
      "end_ms": 123085,
      "text": "回头攻打紫荆关守关的明君，",
      "token_start": 399,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 123440,
      "end_ms": 124755,
      "text": "因为兵力太分散，",
      "token_start": 411,
      "token_end_exclusive": 418
    },
    {
      "start_ms": 125020,
      "end_ms": 125860,
      "text": "关口太多，",
      "token_start": 418,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 126080,
      "end_ms": 126895,
      "text": "守不过来。",
      "token_start": 422,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 127520,
      "end_ms": 129645,
      "text": "瓦剌人一冲就破了，",
      "token_start": 426,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 129960,
      "end_ms": 131025,
      "text": "紫荆关一破，",
      "token_start": 434,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 131400,
      "end_ms": 132695,
      "text": "北京门户大开，",
      "token_start": 439,
      "token_end_exclusive": 445
    },
    {
      "start_ms": 133150,
      "end_ms": 135975,
      "text": "才有了后来的北京保卫战。",
      "token_start": 445,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 136720,
      "end_ms": 138565,
      "text": "于谦临危受命，",
      "token_start": 456,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 138890,
      "end_ms": 141535,
      "text": "守住了北京可紫金官的教训。",
      "token_start": 462,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 141970,
      "end_ms": 143495,
      "text": "明朝记了两百年，",
      "token_start": 474,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 143950,
      "end_ms": 147315,
      "text": "您说这是关还是王朝的生死门？",
      "token_start": 481,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 147880,
      "end_ms": 148515,
      "text": "第八名，",
      "token_start": 494,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 148840,
      "end_ms": 154425,
      "text": "友谊关在广西凭祥中越边境上，",
      "token_start": 497,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 155220,
      "end_ms": 160560,
      "text": "这官最绝的是他打了一场让中国人扬眉吐气的仗。",
      "token_start": 510,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 160640,
      "end_ms": 161515,
      "text": "一八八五年。",
      "token_start": 531,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 161880,
      "end_ms": 163155,
      "text": "法国人打过来了，",
      "token_start": 536,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 163590,
      "end_ms": 165125,
      "text": "占领了镇南关。",
      "token_start": 543,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 165500,
      "end_ms": 169805,
      "text": "七十三岁的老将冯子才抬着棺材上阵，",
      "token_start": 549,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 170440,
      "end_ms": 172665,
      "text": "在关前筑起一道长墙。",
      "token_start": 565,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 173090,
      "end_ms": 177275,
      "text": "法军攻上来冯子才手持大刀冲在最前面，",
      "token_start": 574,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 177690,
      "end_ms": 179895,
      "text": "两个儿子跟着他一起冲。",
      "token_start": 591,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 180710,
      "end_ms": 181570,
      "text": "清军一看，",
      "token_start": 601,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 181850,
      "end_ms": 183510,
      "text": "老将军都拼命了，",
      "token_start": 605,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 183670,
      "end_ms": 184625,
      "text": "人人争先，",
      "token_start": 612,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 184990,
      "end_ms": 186005,
      "text": "法军被打退，",
      "token_start": 616,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 186330,
      "end_ms": 188585,
      "text": "冯子才追出关外几十里，",
      "token_start": 621,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 189060,
      "end_ms": 191175,
      "text": "歼灭法军两千多人。",
      "token_start": 631,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 192090,
      "end_ms": 193485,
      "text": "这是鸦片战争以后，",
      "token_start": 639,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 194170,
      "end_ms": 197015,
      "text": "中国人第一次打败西方列强，",
      "token_start": 647,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 198480,
      "end_ms": 201485,
      "text": "您说这是官还是中国人挺直的腰杆？",
      "token_start": 659,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 201760,
      "end_ms": 202295,
      "text": "第七名，",
      "token_start": 674,
      "token_end_exclusive": 677
    },
    {
      "start_ms": 203340,
      "end_ms": 209355,
      "text": "居庸关在北京昌平太行八十里的第八感。",
      "token_start": 677,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 209670,
      "end_ms": 213560,
      "text": "这关最绝的是他是北京城的北大门军官，",
      "token_start": 694,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 213640,
      "end_ms": 216045,
      "text": "一破北京就门户大开。",
      "token_start": 711,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 216840,
      "end_ms": 218265,
      "text": "所以从元朝开始，",
      "token_start": 720,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 218570,
      "end_ms": 220705,
      "text": "居庸关就修的跟铁桶一样，",
      "token_start": 727,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 221500,
      "end_ms": 227500,
      "text": "南北两个瓮城、城楼、笛、台、水门什么都有关。",
      "token_start": 738,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 227500,
      "end_ms": 230785,
      "text": "成修在一条四十里长的山谷中间，",
      "token_start": 755,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 231510,
      "end_ms": 233425,
      "text": "这条山谷叫关沟，",
      "token_start": 769,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 234010,
      "end_ms": 235425,
      "text": "两边全是悬崖，",
      "token_start": 776,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 235860,
      "end_ms": 241880,
      "text": "中间只有一条路人马只能排成一队走居庸关就卡在这条路上，",
      "token_start": 782,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 242980,
      "end_ms": 248240,
      "text": "关城后面还有上关下关几道防线，",
      "token_start": 808,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 248520,
      "end_ms": 249600,
      "text": "层层设防。",
      "token_start": 822,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 250540,
      "end_ms": 254280,
      "text": "关城中间还有一座云台汉白玉的石台。",
      "token_start": 826,
      "token_end_exclusive": 842
    },
    {
      "start_ms": 254600,
      "end_ms": 257440,
      "text": "元朝修的门洞里刻着四大天王，",
      "token_start": 842,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 257440,
      "end_ms": 259960,
      "text": "像还有六种文字的经文，",
      "token_start": 855,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 260760,
      "end_ms": 262460,
      "text": "您个门洞里六种文字，",
      "token_start": 865,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 263200,
      "end_ms": 265760,
      "text": "您说这是关还是北京的北大门？",
      "token_start": 874,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 266260,
      "end_ms": 267980,
      "text": "第六名剑门关，",
      "token_start": 887,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 269060,
      "end_ms": 279990,
      "text": "您四穿广元剑隔县大剑山中间这关最绝的是他一夫当关万夫莫开。",
      "token_start": 893,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 280190,
      "end_ms": 284310,
      "text": "这话就是从这儿来的李白写的剑阁峥嵘。",
      "token_start": 921,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 284390,
      "end_ms": 288770,
      "text": "而崔为一夫当关万夫莫开攻国的时候，",
      "token_start": 938,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 288770,
      "end_ms": 290270,
      "text": "诸葛亮在这修了官。",
      "token_start": 954,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 290270,
      "end_ms": 290630,
      "text": "后来，",
      "token_start": 962,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 290630,
      "end_ms": 294010,
      "text": "姜维带着五万人守建门关，",
      "token_start": 964,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 294030,
      "end_ms": 300065,
      "text": "钟会带着十万魏军来攻攻了几个月攻不下来，",
      "token_start": 975,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 300740,
      "end_ms": 302225,
      "text": "钟会都想撤军了。",
      "token_start": 994,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 303000,
      "end_ms": 306340,
      "text": "可惜邓艾从阴平小道绕过去了，",
      "token_start": 1001,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 306340,
      "end_ms": 307555,
      "text": "剑门关没破，",
      "token_start": 1014,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 307990,
      "end_ms": 309165,
      "text": "蜀汉还是王了，",
      "token_start": 1019,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 309540,
      "end_ms": 310805,
      "text": "可剑门关没破，",
      "token_start": 1025,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 311080,
      "end_ms": 312015,
      "text": "姜梅没输，",
      "token_start": 1031,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 312410,
      "end_ms": 315715,
      "text": "您说这是官还是蜀汉最后的骨气？",
      "token_start": 1035,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 316190,
      "end_ms": 317630,
      "text": "从第十到第六，",
      "token_start": 1049,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 317750,
      "end_ms": 319925,
      "text": "娘子关是女人立的碑。",
      "token_start": 1055,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 320610,
      "end_ms": 322635,
      "text": "紫荆关是王朝的生死门，",
      "token_start": 1064,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 323310,
      "end_ms": 326075,
      "text": "有一冠是中国人挺直的腰杆。",
      "token_start": 1074,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 326780,
      "end_ms": 329215,
      "text": "居庸关是北京的北大门，",
      "token_start": 1086,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 330070,
      "end_ms": 332605,
      "text": "剑门关是蜀汉最后的骨气，",
      "token_start": 1096,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 333070,
      "end_ms": 335765,
      "text": "可这五个还不是最逆天的。",
      "token_start": 1107,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 336310,
      "end_ms": 337835,
      "text": "接下来第五到第一，",
      "token_start": 1118,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 338250,
      "end_ms": 339265,
      "text": "一个比一个狠。",
      "token_start": 1126,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 339560,
      "end_ms": 340495,
      "text": "有一座关，",
      "token_start": 1132,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 340870,
      "end_ms": 342290,
      "text": "打了两千多年仗，",
      "token_start": 1136,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 342430,
      "end_ms": 344710,
      "text": "有一座官天下第一关，",
      "token_start": 1143,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 344930,
      "end_ms": 345925,
      "text": "还有一座关，",
      "token_start": 1152,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 346520,
      "end_ms": 348020,
      "text": "两千三百年来，",
      "token_start": 1157,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 348020,
      "end_ms": 351625,
      "text": "谁想从他身上过都得先留下一条命，",
      "token_start": 1163,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 352520,
      "end_ms": 353120,
      "text": "他是哪？",
      "token_start": 1178,
      "token_end_exclusive": 1181
    },
    {
      "start_ms": 353240,
      "end_ms": 354825,
      "text": "他凭什么排第一？",
      "token_start": 1181,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 355060,
      "end_ms": 356485,
      "text": "下集马上更新，",
      "token_start": 1188,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 356770,
      "end_ms": 359755,
      "text": "您先点个关注点开头像别走丢。",
      "token_start": 1194,
      "token_end_exclusive": 1207
    }
  ],
