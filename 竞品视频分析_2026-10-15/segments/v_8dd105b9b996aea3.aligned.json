{
  "video_id": "v_8dd105b9b996aea3",
  "duration_s": 607.737007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_8dd105b9b996aea3.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_8dd105b9b996aea3.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 4350,
      "text": "您知道中国十大令人惊叹的峡谷秘境都有哪些吗？",
      "token_start": 0,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 4710,
      "end_ms": 5250,
      "text": "上集，",
      "token_start": 21,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5270,
      "end_ms": 12130,
      "text": "咱们聊了金丝峡、巫山小三峡、马岭河、京口大峡谷和天山大峡谷。",
      "token_start": 23,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 12650,
      "end_ms": 14930,
      "text": "这一集直接揭开谜底，",
      "token_start": 49,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 15230,
      "end_ms": 18050,
      "text": "看看前五名惊叹到什么程度。",
      "token_start": 58,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 18570,
      "end_ms": 27030,
      "text": "尤其是排在榜首的那条雪山森林咆哮的大江全挤在一道谷里，",
      "token_start": 70,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 27290,
      "end_ms": 31140,
      "text": "他却一直活在一个更响亮的名字背后。",
      "token_start": 96,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 31480,
      "end_ms": 32200,
      "text": "第五名，",
      "token_start": 112,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 32560,
      "end_ms": 33940,
      "text": "恩师大峡谷，",
      "token_start": 115,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 34200,
      "end_ms": 40060,
      "text": "湖北恩师这一条您别当峡谷看它更像一口。",
      "token_start": 120,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 40060,
      "end_ms": 43280,
      "text": "把喀斯特奇观一股脑塞进去的大箱子，",
      "token_start": 138,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 43760,
      "end_ms": 47040,
      "text": "整条峡谷长一百零八公里，",
      "token_start": 154,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 47580,
      "end_ms": 49560,
      "text": "绝壁最高四百多米。",
      "token_start": 165,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 49820,
      "end_ms": 52140,
      "text": "您站在崖边对面，",
      "token_start": 173,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 52240,
      "end_ms": 53800,
      "text": "立着一根石柱子，",
      "token_start": 180,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 54000,
      "end_ms": 55780,
      "text": "拔地一百五十米，",
      "token_start": 187,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 55980,
      "end_ms": 59200,
      "text": "当地人叫他一柱香拔像，",
      "token_start": 194,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 59340,
      "end_ms": 61305,
      "text": "一柱香插在山上，",
      "token_start": 204,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 61790,
      "end_ms": 62825,
      "text": "再往里走。",
      "token_start": 211,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 63200,
      "end_ms": 67775,
      "text": "有一道地缝窄的两边岩壁几乎贴着肩膀，",
      "token_start": 215,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 68370,
      "end_ms": 69325,
      "text": "还有溶洞，",
      "token_start": 232,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 69690,
      "end_ms": 72075,
      "text": "天坑一个接一个冒出来。",
      "token_start": 236,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 72530,
      "end_ms": 78805,
      "text": "这些都是雨水顺着石灰岩的缝一点点融出来的别的峡谷是一道井，",
      "token_start": 246,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 79180,
      "end_ms": 81180,
      "text": "这是一整套自然奇观。",
      "token_start": 274,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 81320,
      "end_ms": 82925,
      "text": "同时摆在您面前。",
      "token_start": 283,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 83360,
      "end_ms": 84625,
      "text": "单拎出哪一样，",
      "token_start": 290,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 84930,
      "end_ms": 86225,
      "text": "别处都能当招牌，",
      "token_start": 296,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 86730,
      "end_ms": 88305,
      "text": "他偏偏全凑齐了，",
      "token_start": 303,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 88610,
      "end_ms": 89355,
      "text": "您说绝不绝。",
      "token_start": 310,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 89780,
      "end_ms": 90605,
      "text": "第四名，",
      "token_start": 315,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 91230,
      "end_ms": 92455,
      "text": "怒江大峡谷，",
      "token_start": 318,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 92990,
      "end_ms": 93985,
      "text": "云南怒江。",
      "token_start": 323,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 94540,
      "end_ms": 96235,
      "text": "他不像一个景区，",
      "token_start": 327,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 96910,
      "end_ms": 100555,
      "text": "更像以整个巨大的自然世界。",
      "token_start": 334,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 100960,
      "end_ms": 103675,
      "text": "怒江从青藏高原一路往南冲，",
      "token_start": 346,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 104300,
      "end_ms": 106565,
      "text": "夹在高黎贡山和怒山之间，",
      "token_start": 358,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 107140,
      "end_ms": 108545,
      "text": "峡谷三百来公里，",
      "token_start": 369,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 109030,
      "end_ms": 111655,
      "text": "两岸的山比谷底高出两千多米。",
      "token_start": 376,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 112090,
      "end_ms": 116190,
      "text": "你想想那种地方隔着江喊的硬话，",
      "token_start": 389,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 116410,
      "end_ms": 118065,
      "text": "走过去却要大半天。",
      "token_start": 403,
      "token_end_exclusive": 411
    },
    {
      "start_ms": 118490,
      "end_ms": 124360,
      "text": "所以这里的人过去是挂一根钢缆六过江去几十秒，",
      "token_start": 411,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 124520,
      "end_ms": 126300,
      "text": "就到对岸峡谷里，",
      "token_start": 432,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 126300,
      "end_ms": 130460,
      "text": "住着隶粟族、怒族、独龙族好几个民族。",
      "token_start": 439,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 131000,
      "end_ms": 134720,
      "text": "到了丙中洛藏传佛教的寺天主教堂，",
      "token_start": 454,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 134960,
      "end_ms": 136920,
      "text": "基督教堂挨着盖在一起，",
      "token_start": 469,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 137220,
      "end_ms": 138180,
      "text": "各过各的节，",
      "token_start": 479,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 138480,
      "end_ms": 139500,
      "text": "谁也不碍着谁。",
      "token_start": 484,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 140140,
      "end_ms": 143620,
      "text": "您说这算不算一个装得下山，",
      "token_start": 490,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 143940,
      "end_ms": 144880,
      "text": "装得下江，",
      "token_start": 502,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 145100,
      "end_ms": 148180,
      "text": "还装得下人间烟火的大世界。",
      "token_start": 506,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 148640,
      "end_ms": 149555,
      "text": "第三名，",
      "token_start": 518,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 150400,
      "end_ms": 151140,
      "text": "虎跳峡，",
      "token_start": 521,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 151780,
      "end_ms": 152920,
      "text": "云南金沙江。",
      "token_start": 524,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 153640,
      "end_ms": 154720,
      "text": "您想象一下，",
      "token_start": 529,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 155140,
      "end_ms": 158660,
      "text": "两座五千多米的雪山面对面站着，",
      "token_start": 534,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 159080,
      "end_ms": 160760,
      "text": "中间只留一道缝，",
      "token_start": 548,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 161380,
      "end_ms": 163760,
      "text": "金沙江被硬生生挤了进去。",
      "token_start": 555,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 164540,
      "end_ms": 166020,
      "text": "左边是玉龙雪山，",
      "token_start": 566,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 166520,
      "end_ms": 169620,
      "text": "右边是哈巴雪山峡谷，",
      "token_start": 573,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 169660,
      "end_ms": 171060,
      "text": "全长十六公里，",
      "token_start": 582,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 171460,
      "end_ms": 173140,
      "text": "江水一路往下摔，",
      "token_start": 588,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 173680,
      "end_ms": 175120,
      "text": "江差两百多米。",
      "token_start": 595,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 175460,
      "end_ms": 177760,
      "text": "十八处险滩接连进去，",
      "token_start": 601,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 178460,
      "end_ms": 180435,
      "text": "江心有一块大石石头，",
      "token_start": 610,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 181080,
      "end_ms": 184480,
      "text": "传说老虎就是踩着他跳过了。",
      "token_start": 619,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 184480,
      "end_ms": 189225,
      "text": "江江面最窄的地方也就三十来米。",
      "token_start": 631,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 189760,
      "end_ms": 192490,
      "text": "您站在江边轰鸣声，",
      "token_start": 645,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 192530,
      "end_ms": 196275,
      "text": "像一列火车从脚底碾过去，",
      "token_start": 653,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 196740,
      "end_ms": 199800,
      "text": "几里外都听得见雪山，",
      "token_start": 664,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 199800,
      "end_ms": 201475,
      "text": "压着大江顶的，",
      "token_start": 673,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 201810,
      "end_ms": 202585,
      "text": "谁也不肯让，",
      "token_start": 679,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 203200,
      "end_ms": 205615,
      "text": "就这么夹出了一条会吼的峡谷，",
      "token_start": 684,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 206380,
      "end_ms": 208205,
      "text": "可就是这样的虎跳匣，",
      "token_start": 697,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 208690,
      "end_ms": 210355,
      "text": "居然还进不了前二。",
      "token_start": 706,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 210810,
      "end_ms": 215005,
      "text": "很多人心里他就是当之无愧的峡谷之王。",
      "token_start": 714,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 215750,
      "end_ms": 217415,
      "text": "长达五百零四公里，",
      "token_start": 731,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 217960,
      "end_ms": 219945,
      "text": "最深处达六千零九米，",
      "token_start": 739,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 220410,
      "end_ms": 223395,
      "text": "环绕着七千七百多米的南加巴瓦峰，",
      "token_start": 748,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 223750,
      "end_ms": 226215,
      "text": "画出了一个惊天动地的大拐弯。",
      "token_start": 763,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 226710,
      "end_ms": 231435,
      "text": "印度洋暖湿气流顺着这条世界第一大峡谷逆流而上，",
      "token_start": 776,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 231880,
      "end_ms": 236345,
      "text": "在青藏高原东南原硬生生劈开了一条绿色通道，",
      "token_start": 798,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 236970,
      "end_ms": 242565,
      "text": "造就了从极地冰原到热带雨林的九个完整垂直自然带。",
      "token_start": 818,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 242960,
      "end_ms": 244825,
      "text": "您站在观景台上，",
      "token_start": 841,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 245360,
      "end_ms": 248145,
      "text": "脚下是奔涌咆哮的江水，",
      "token_start": 848,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 248820,
      "end_ms": 251740,
      "text": "眼前是直刺蓝天的雪山，",
      "token_start": 858,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 251780,
      "end_ms": 253895,
      "text": "雄风与茫茫林海，",
      "token_start": 868,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 254310,
      "end_ms": 258195,
      "text": "他的大足以装下整座自然博物馆。",
      "token_start": 875,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 258890,
      "end_ms": 264345,
      "text": "可正因为人人都知道他天下第一真正压轴的那条，",
      "token_start": 889,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 264670,
      "end_ms": 266815,
      "text": "才更让人倒吸一口凉气。",
      "token_start": 910,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 267280,
      "end_ms": 268695,
      "text": "那第一名到底是哪儿？",
      "token_start": 920,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 269180,
      "end_ms": 269975,
      "text": "先别急，",
      "token_start": 929,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 270540,
      "end_ms": 271255,
      "text": "聊到这儿，",
      "token_start": 932,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 271670,
      "end_ms": 273315,
      "text": "我先唠几句心里话。",
      "token_start": 936,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 273730,
      "end_ms": 276390,
      "text": "我发现经常有朋友留言说，",
      "token_start": 944,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 276450,
      "end_ms": 277555,
      "text": "年轻时候忙，",
      "token_start": 955,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 277930,
      "end_ms": 278715,
      "text": "没空出门，",
      "token_start": 960,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 279300,
      "end_ms": 281150,
      "text": "现在退休有空了，",
      "token_start": 964,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 281310,
      "end_ms": 282245,
      "text": "想去走走，",
      "token_start": 971,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 282670,
      "end_ms": 285130,
      "text": "可不知道先去哪儿去了，",
      "token_start": 975,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 285130,
      "end_ms": 285895,
      "text": "看什么。",
      "token_start": 985,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 286290,
      "end_ms": 287215,
      "text": "还有朋友说，",
      "token_start": 988,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 287580,
      "end_ms": 290845,
      "text": "这些大峡谷大多藏在偏远的深山里，",
      "token_start": 993,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 291230,
      "end_ms": 292975,
      "text": "海拔高路又远，",
      "token_start": 1008,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 293570,
      "end_ms": 296145,
      "text": "这辈子怕是没几处走得进去，",
      "token_start": 1014,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 296760,
      "end_ms": 299255,
      "text": "有没有不用针跋山涉水，",
      "token_start": 1026,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 299680,
      "end_ms": 301785,
      "text": "也能把他们看明白的办法？",
      "token_start": 1036,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 302230,
      "end_ms": 303870,
      "text": "还有带孙子孙女的，",
      "token_start": 1047,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 304250,
      "end_ms": 306190,
      "text": "想给孩子讲讲的江水，",
      "token_start": 1055,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 306430,
      "end_ms": 308290,
      "text": "是怎么把大山劈开的？",
      "token_start": 1064,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 308610,
      "end_ms": 311210,
      "text": "这些深谷到底是怎么长出来的？",
      "token_start": 1073,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 311530,
      "end_ms": 313310,
      "text": "可自己也说不太明白，",
      "token_start": 1086,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 313730,
      "end_ms": 316070,
      "text": "您看咱们这个年纪的翻，",
      "token_start": 1095,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 316170,
      "end_ms": 317490,
      "text": "不光是图个热闹，",
      "token_start": 1105,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 317970,
      "end_ms": 320970,
      "text": "更想知道这道深谷是怎么来的，",
      "token_start": 1112,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 321190,
      "end_ms": 322970,
      "text": "背后有什么讲究。",
      "token_start": 1125,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 322970,
      "end_ms": 327150,
      "text": "可这些东西在手机上划完就忘上网，",
      "token_start": 1132,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 327210,
      "end_ms": 330330,
      "text": "查一堆乱七八糟的翻大布头，",
      "token_start": 1147,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 330330,
      "end_ms": 331450,
      "text": "又看的眼睛疼。",
      "token_start": 1159,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 331450,
      "end_ms": 332820,
      "text": "又是前阵子，",
      "token_start": 1165,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 332820,
      "end_ms": 333900,
      "text": "我翻到一本书，",
      "token_start": 1170,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 334240,
      "end_ms": 335680,
      "text": "正好解决这个问题，",
      "token_start": 1176,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 336220,
      "end_ms": 341780,
      "text": "叫大美中国人一生要去的一百零一个地方。",
      "token_start": 1184,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 341780,
      "end_ms": 347140,
      "text": "他把全中国最值得去的一百零一个地方挑出来，",
      "token_start": 1202,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 347220,
      "end_ms": 349400,
      "text": "分成五块自然奇观，",
      "token_start": 1222,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 349400,
      "end_ms": 351560,
      "text": "文明印记、烟火，",
      "token_start": 1230,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 351600,
      "end_ms": 353000,
      "text": "人间秘境，",
      "token_start": 1236,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 353000,
      "end_ms": 353480,
      "text": "寻踪，",
      "token_start": 1240,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 353480,
      "end_ms": 354700,
      "text": "人间天堂。",
      "token_start": 1242,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 354700,
      "end_ms": 358520,
      "text": "咱们今天聊的这些大峡谷书里头，",
      "token_start": 1246,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 358520,
      "end_ms": 360040,
      "text": "一个地方接一个地方，",
      "token_start": 1260,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 360100,
      "end_ms": 366160,
      "text": "将这条生生谷是怎样怎么被江水一年一年切出来的山上的冰川，",
      "token_start": 1269,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 366160,
      "end_ms": 369330,
      "text": "又是怎么把谷底越拉越深的鼓里，",
      "token_start": 1296,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 369330,
      "end_ms": 372930,
      "text": "住着哪些人走着哪条古道几分钟，",
      "token_start": 1310,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 372930,
      "end_ms": 374955,
      "text": "一个地方讲的明明白白，",
      "token_start": 1324,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 375710,
      "end_ms": 377305,
      "text": "图印的特别透亮。",
      "token_start": 1334,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 377630,
      "end_ms": 380065,
      "text": "一页翻开就是一幅大画，",
      "token_start": 1341,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 380480,
      "end_ms": 381825,
      "text": "我自己是这么用的，",
      "token_start": 1351,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 382090,
      "end_ms": 384840,
      "text": "能去的地方出门前翻一翻到了地方，",
      "token_start": 1359,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 384840,
      "end_ms": 385605,
      "text": "心里有底，",
      "token_start": 1374,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 385890,
      "end_ms": 387795,
      "text": "看的就不只是一道深沟，",
      "token_start": 1378,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 388220,
      "end_ms": 391715,
      "text": "而是几千万年攒下来的一件大作品。",
      "token_start": 1388,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 392170,
      "end_ms": 393345,
      "text": "暂时去不了的，",
      "token_start": 1403,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 393670,
      "end_ms": 395515,
      "text": "就着图文慢慢看，",
      "token_start": 1409,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 395850,
      "end_ms": 396795,
      "text": "也算去过了。",
      "token_start": 1416,
      "token_end_exclusive": 1421
    },
    {
      "start_ms": 397580,
      "end_ms": 398855,
      "text": "摆在茶几上，",
      "token_start": 1421,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 399380,
      "end_ms": 400465,
      "text": "孙辈来了，",
      "token_start": 1426,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 400750,
      "end_ms": 401450,
      "text": "翻两页，",
      "token_start": 1430,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 401630,
      "end_ms": 402785,
      "text": "长见识不说，",
      "token_start": 1433,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 403160,
      "end_ms": 405275,
      "text": "写作文也正好用得上。",
      "token_start": 1438,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 405690,
      "end_ms": 407670,
      "text": "老两口晚上翻翻商量，",
      "token_start": 1447,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 407670,
      "end_ms": 410795,
      "text": "明年去哪儿比刷手机舒坦多了，",
      "token_start": 1456,
      "token_end_exclusive": 1469
    },
    {
      "start_ms": 411230,
      "end_ms": 413565,
      "text": "房子会旧积蓄会花完。",
      "token_start": 1469,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 414110,
      "end_ms": 416745,
      "text": "可这些大峡谷里记着的山河来历，",
      "token_start": 1478,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 417230,
      "end_ms": 419525,
      "text": "传多少代都贬不了职。",
      "token_start": 1492,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 419950,
      "end_ms": 423855,
      "text": "这是大自然和老祖宗一起给咱们攒下的家底，",
      "token_start": 1501,
      "token_end_exclusive": 1520
    },
    {
      "start_ms": 424390,
      "end_ms": 425375,
      "text": "一旦断了，",
      "token_start": 1520,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 425830,
      "end_ms": 426925,
      "text": "可就不好结了，",
      "token_start": 1524,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 427440,
      "end_ms": 429795,
      "text": "趁现在还能买到给自己，",
      "token_start": 1530,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 429960,
      "end_ms": 431275,
      "text": "也给下一代留一份，",
      "token_start": 1540,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 431700,
      "end_ms": 433225,
      "text": "说我搁商品橱窗了。",
      "token_start": 1548,
      "token_end_exclusive": 1556
    },
    {
      "start_ms": 433810,
      "end_ms": 436530,
      "text": "感兴趣的朋友点开我的头像，",
      "token_start": 1556,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 436550,
      "end_ms": 438225,
      "text": "进入主页进去看看，",
      "token_start": 1568,
      "token_end_exclusive": 1576
    },
    {
      "start_ms": 438600,
      "end_ms": 440005,
      "text": "暂时走不出去，",
      "token_start": 1576,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 440560,
      "end_ms": 444800,
      "text": "咱就把大好河山装进屋里好说。",
      "token_start": 1582,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 444800,
      "end_ms": 446620,
      "text": "回正题揭晓，",
      "token_start": 1595,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 446640,
      "end_ms": 453105,
      "text": "第一名帕龙藏布大峡谷为什么是他在几乎所有人的预料里，",
      "token_start": 1600,
      "token_end_exclusive": 1625
    },
    {
      "start_ms": 453540,
      "end_ms": 456675,
      "text": "雅鲁藏布大峡谷都是无法撼动的榜首。",
      "token_start": 1625,
      "token_end_exclusive": 1641
    },
    {
      "start_ms": 457430,
      "end_ms": 461415,
      "text": "可偏偏在很多真正走遍西藏的探险家眼里，",
      "token_start": 1641,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 461970,
      "end_ms": 464155,
      "text": "这条知名度极低的大峡谷，",
      "token_start": 1659,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 464680,
      "end_ms": 468075,
      "text": "才是全中国最不可思议的终极秘境。",
      "token_start": 1670,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 468470,
      "end_ms": 470065,
      "text": "它全长七十六公里，",
      "token_start": 1685,
      "token_end_exclusive": 1693
    },
    {
      "start_ms": 470610,
      "end_ms": 472805,
      "text": "平均深度超过四千米。",
      "token_start": 1693,
      "token_end_exclusive": 1702
    },
    {
      "start_ms": 473430,
      "end_ms": 474865,
      "text": "最核心的地方，",
      "token_start": 1702,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 475180,
      "end_ms": 479895,
      "text": "他就发源并横穿于中国最大的海洋性冰川发育区。",
      "token_start": 1708,
      "token_end_exclusive": 1729
    },
    {
      "start_ms": 480550,
      "end_ms": 482465,
      "text": "波密与冉吾一带，",
      "token_start": 1729,
      "token_end_exclusive": 1736
    },
    {
      "start_ms": 482850,
      "end_ms": 492275,
      "text": "在他的两岸密布着米堆冰川、弱果、冰川等数十条巨大兵蛇从皑皑雪峰上一路倾泻，",
      "token_start": 1736,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 492810,
      "end_ms": 494650,
      "text": "甚至直接插进谷底。",
      "token_start": 1770,
      "token_end_exclusive": 1778
    },
    {
      "start_ms": 494730,
      "end_ms": 497185,
      "text": "郁郁葱葱的原始云山林里，",
      "token_start": 1778,
      "token_end_exclusive": 1789
    },
    {
      "start_ms": 497560,
      "end_ms": 499795,
      "text": "高耸入云的极寒雪峰，",
      "token_start": 1789,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 500450,
      "end_ms": 505975,
      "text": "银白夺目的世纪冰川奔腾如脱缰野马的翡翠色急流，",
      "token_start": 1798,
      "token_end_exclusive": 1820
    },
    {
      "start_ms": 506440,
      "end_ms": 508945,
      "text": "加上浓得化不开的原始丛林，",
      "token_start": 1820,
      "token_end_exclusive": 1832
    },
    {
      "start_ms": 509340,
      "end_ms": 513245,
      "text": "在最紧凑的空间里撞出最极致的反差。",
      "token_start": 1832,
      "token_end_exclusive": 1848
    },
    {
      "start_ms": 513690,
      "end_ms": 515055,
      "text": "所以他排第一，",
      "token_start": 1848,
      "token_end_exclusive": 1854
    },
    {
      "start_ms": 515650,
      "end_ms": 516925,
      "text": "不是因为他最大，",
      "token_start": 1854,
      "token_end_exclusive": 1861
    },
    {
      "start_ms": 517400,
      "end_ms": 521795,
      "text": "而是因为他同时装下雪山、冰川、森林和大江。",
      "token_start": 1861,
      "token_end_exclusive": 1879
    },
    {
      "start_ms": 522570,
      "end_ms": 528695,
      "text": "他把世间最壮烈、最纯粹的雪山秘境感浓缩到了极致。",
      "token_start": 1879,
      "token_end_exclusive": 1901
    },
    {
      "start_ms": 529050,
      "end_ms": 531600,
      "text": "十座峡谷讲完了金丝霞，",
      "token_start": 1901,
      "token_end_exclusive": 1911
    },
    {
      "start_ms": 531620,
      "end_ms": 534730,
      "text": "把秦岭写成水墨小三峡，",
      "token_start": 1911,
      "token_end_exclusive": 1921
    },
    {
      "start_ms": 534770,
      "end_ms": 536285,
      "text": "流淌着巴楚失意，",
      "token_start": 1921,
      "token_end_exclusive": 1928
    },
    {
      "start_ms": 536890,
      "end_ms": 538715,
      "text": "马岭河百铺齐飞，",
      "token_start": 1928,
      "token_end_exclusive": 1935
    },
    {
      "start_ms": 539290,
      "end_ms": 540450,
      "text": "京口大峡谷，",
      "token_start": 1935,
      "token_end_exclusive": 1940
    },
    {
      "start_ms": 540470,
      "end_ms": 543910,
      "text": "绝壁千仞、天山红岩如烈火。",
      "token_start": 1940,
      "token_end_exclusive": 1951
    },
    {
      "start_ms": 544210,
      "end_ms": 546010,
      "text": "恩施、奇峰、耸入云。",
      "token_start": 1951,
      "token_end_exclusive": 1958
    },
    {
      "start_ms": 546490,
      "end_ms": 548290,
      "text": "怒江奔腾出洪荒，",
      "token_start": 1958,
      "token_end_exclusive": 1965
    },
    {
      "start_ms": 549010,
      "end_ms": 549790,
      "text": "虎跳峡，",
      "token_start": 1965,
      "token_end_exclusive": 1968
    },
    {
      "start_ms": 549850,
      "end_ms": 551750,
      "text": "在雪山下疯狂咆哮，",
      "token_start": 1968,
      "token_end_exclusive": 1976
    },
    {
      "start_ms": 552470,
      "end_ms": 555230,
      "text": "雅鲁藏布以六千米及深作用，",
      "token_start": 1976,
      "token_end_exclusive": 1988
    },
    {
      "start_ms": 555250,
      "end_ms": 560730,
      "text": "万物可只有帕龙藏布在冰川与密林的缝隙里，",
      "token_start": 1988,
      "token_end_exclusive": 2007
    },
    {
      "start_ms": 561210,
      "end_ms": 564510,
      "text": "守着大自然最原始的秘境尊严。",
      "token_start": 2007,
      "token_end_exclusive": 2020
    },
    {
      "start_ms": 564930,
      "end_ms": 566770,
      "text": "您说什么叫令人惊叹？",
      "token_start": 2020,
      "token_end_exclusive": 2029
    },
    {
      "start_ms": 567430,
      "end_ms": 570930,
      "text": "最惊叹的往往不是世人皆知的壮阔，",
      "token_start": 2029,
      "token_end_exclusive": 2044
    },
    {
      "start_ms": 570930,
      "end_ms": 574040,
      "text": "而而是那些藏在天地尽头，",
      "token_start": 2044,
      "token_end_exclusive": 2055
    },
    {
      "start_ms": 574660,
      "end_ms": 576800,
      "text": "哪怕没被俗世记住，",
      "token_start": 2055,
      "token_end_exclusive": 2063
    },
    {
      "start_ms": 577280,
      "end_ms": 580800,
      "text": "也依然美的惊心动魄的大地奇迹。",
      "token_start": 2063,
      "token_end_exclusive": 2077
    },
    {
      "start_ms": 581160,
      "end_ms": 582240,
      "text": "最后问您一句，",
      "token_start": 2077,
      "token_end_exclusive": 2083
    },
