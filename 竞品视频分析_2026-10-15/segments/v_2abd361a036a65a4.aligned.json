  "segments": [
    {
      "start_ms": 250,
      "end_ms": 1350,
      "text": "人过了五十岁啊，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1350,
      "end_ms": 2910,
      "text": "如果你想要活得舒心一点，",
      "token_start": 7,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 2990,
      "end_ms": 3990,
      "text": "以下这五句话，",
      "token_start": 18,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 4130,
      "end_ms": 5130,
      "text": "你一定要牢记。",
      "token_start": 24,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 5430,
      "end_ms": 5910,
      "text": "第一，",
      "token_start": 30,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 6350,
      "end_ms": 7450,
      "text": "人这一辈子啊，",
      "token_start": 32,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 7490,
      "end_ms": 8170,
      "text": "除了健康，",
      "token_start": 38,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 8490,
      "end_ms": 9730,
      "text": "什么都不是你的。",
      "token_start": 42,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 10030,
      "end_ms": 10690,
      "text": "少生气，",
      "token_start": 49,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 10910,
      "end_ms": 11650,
      "text": "少计较，",
      "token_start": 52,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 11850,
      "end_ms": 12490,
      "text": "多开心，",
      "token_start": 55,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12670,
      "end_ms": 13390,
      "text": "多干动，",
      "token_start": 58,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 13610,
      "end_ms": 14530,
      "text": "好好爱自己。",
      "token_start": 61,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 14770,
      "end_ms": 16910,
      "text": "有个好身体比什么都强。",
      "token_start": 66,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 17450,
      "end_ms": 17870,
      "text": "第二，",
      "token_start": 76,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 18310,
      "end_ms": 20150,
      "text": "只要是消耗你情绪的人和事，",
      "token_start": 78,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 20310,
      "end_ms": 22830,
      "text": "你就悄悄的把他请出你的世界。",
      "token_start": 90,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 23250,
      "end_ms": 25830,
      "text": "人活着就该敞亮点或打点，",
      "token_start": 103,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 25970,
      "end_ms": 27150,
      "text": "该干嘛就干嘛，",
      "token_start": 114,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 27350,
      "end_ms": 30480,
      "text": "不要让等待和内耗拖垮了你的身体。",
      "token_start": 120,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 30820,
      "end_ms": 31260,
      "text": "第三，",
      "token_start": 135,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 31740,
      "end_ms": 32560,
      "text": "管不了的人，",
      "token_start": 137,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 32680,
      "end_ms": 34780,
      "text": "你就放手控制不了的事情，",
      "token_start": 142,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 35000,
      "end_ms": 36220,
      "text": "你就随他而去，",
      "token_start": 153,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 36400,
      "end_ms": 38600,
      "text": "你啥都不用管管好自己就行。",
      "token_start": 159,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 38820,
      "end_ms": 40660,
      "text": "因为你管不了人生，",
      "token_start": 171,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 40660,
      "end_ms": 42500,
      "text": "本该就是顺其自然，",
      "token_start": 179,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 42800,
      "end_ms": 43760,
      "text": "随遇而安。",
      "token_start": 187,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 44440,
      "end_ms": 44900,
      "text": "第四，",
      "token_start": 191,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 45080,
      "end_ms": 47640,
      "text": "这个世间万物啊都是有定数的，",
      "token_start": 193,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 47820,
      "end_ms": 48960,
      "text": "得到的未必是福，",
      "token_start": 206,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 49300,
      "end_ms": 51300,
      "text": "失去的也未必是祸。",
      "token_start": 213,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 51980,
      "end_ms": 52500,
      "text": "第五，",
      "token_start": 221,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 52640,
      "end_ms": 54040,
      "text": "不要为往事过不去，",
      "token_start": 223,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 54280,
      "end_ms": 56080,
      "text": "因为他已经过去，",
      "token_start": 231,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 56480,
      "end_ms": 58000,
      "text": "也不要被现实过不去，",
      "token_start": 238,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 58300,
      "end_ms": 60735,
      "text": "因为你还要过大气。",
      "token_start": 247,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 60900,
      "end_ms": 62080,
      "text": "我在当下享受，",
      "token_start": 255,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 62080,
      "end_ms": 64215,
      "text": "现在就是最好的活法。",
      "token_start": 261,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 64780,
      "end_ms": 65440,
      "text": "看到这里，",
      "token_start": 270,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 65480,
      "end_ms": 67740,
      "text": "不妨在心中默念越来越好，",
      "token_start": 274,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 67920,
      "end_ms": 69455,
      "text": "一定要相信语言的力量。",
      "token_start": 285,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 69780,
      "end_ms": 73995,
      "text": "新城泽林最后也希望你越来越好。",
      "token_start": 295,
      "token_end_exclusive": 309
    }
  ],
