{
  "video_id": "v_ef0c4e61b567a541",
  "duration_s": 340.380998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_ef0c4e61b567a541.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_ef0c4e61b567a541.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 3030,
      "text": "一九四九年十月一号下午三点，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3890,
      "end_ms": 6030,
      "text": "天安门广场人山人海，",
      "token_start": 13,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 6370,
      "end_ms": 7290,
      "text": "锣鼓喧天。",
      "token_start": 22,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 8150,
      "end_ms": 10210,
      "text": "中华人民共和国成立了，",
      "token_start": 26,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 10570,
      "end_ms": 12850,
      "text": "那是全中国最荣耀的时刻，",
      "token_start": 36,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 13450,
      "end_ms": 14350,
      "text": "没有之一。",
      "token_start": 47,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 15070,
      "end_ms": 17750,
      "text": "就在几公里外的协和医院产房里，",
      "token_start": 51,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 18090,
      "end_ms": 22470,
      "text": "一个穿白大褂的女人安安静静的守着一个产妇，",
      "token_start": 65,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 22990,
      "end_ms": 24150,
      "text": "她叫林巧智。",
      "token_start": 85,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 24930,
      "end_ms": 25410,
      "text": "那天，",
      "token_start": 90,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25690,
      "end_ms": 29250,
      "text": "她其实收到了一张红底金字的请柬，",
      "token_start": 92,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 29670,
      "end_ms": 31900,
      "text": "开始开国大典观礼邀请函，",
      "token_start": 107,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 32200,
      "end_ms": 34780,
      "text": "多少人挤破脑袋都进不去的地方。",
      "token_start": 118,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 34780,
      "end_ms": 35960,
      "text": "他拿起来看了一眼，",
      "token_start": 132,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 36040,
      "end_ms": 36800,
      "text": "搁在桌上，",
      "token_start": 140,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 36960,
      "end_ms": 38480,
      "text": "转身进了产房。",
      "token_start": 144,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 39060,
      "end_ms": 41160,
      "text": "有人追着问林大夫，",
      "token_start": 150,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 41380,
      "end_ms": 42420,
      "text": "这么大的喜事，",
      "token_start": 158,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 42600,
      "end_ms": 43440,
      "text": "您怎么不去，",
      "token_start": 164,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 43920,
      "end_ms": 45060,
      "text": "他头也没回，",
      "token_start": 169,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 45300,
      "end_ms": 46060,
      "text": "我是大夫，",
      "token_start": 174,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 46560,
      "end_ms": 49420,
      "text": "产房里有产妇等着我去天安门干什么？",
      "token_start": 178,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 49720,
      "end_ms": 51820,
      "text": "他听听开国大典啊，",
      "token_start": 194,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 51880,
      "end_ms": 53320,
      "text": "对普通人来说，",
      "token_start": 202,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 53320,
      "end_ms": 55360,
      "text": "一辈子赶不上一回的事儿，",
      "token_start": 208,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 55660,
      "end_ms": 56980,
      "text": "他说不去就不去，",
      "token_start": 219,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 57460,
      "end_ms": 58060,
      "text": "他是谁。",
      "token_start": 226,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 58580,
      "end_ms": 61075,
      "text": "中国科学院第一位女院士，",
      "token_start": 229,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 61660,
      "end_ms": 63835,
      "text": "中国妇产科学的奠基人。",
      "token_start": 240,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 64210,
      "end_ms": 66360,
      "text": "一辈子没结婚没孩子，",
      "token_start": 250,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 66440,
      "end_ms": 69625,
      "text": "却亲手接生了五万多个新生命。",
      "token_start": 259,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 70570,
      "end_ms": 71555,
      "text": "五万多个，",
      "token_start": 272,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 71890,
      "end_ms": 74355,
      "text": "您住那小区可能都没这么多人，",
      "token_start": 276,
      "token_end_exclusive": 289
    },
    {
      "start_ms": 75450,
      "end_ms": 78180,
      "text": "这五万人里有一个，",
      "token_start": 289,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 78180,
      "end_ms": 81795,
      "text": "您肯定认识袁隆平，",
      "token_start": 297,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 82740,
      "end_ms": 83780,
      "text": "一九三零年，",
      "token_start": 305,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 84000,
      "end_ms": 91500,
      "text": "协和医院的出生档案上接生一生一栏写着三个英文单词KOG令，",
      "token_start": 310,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 92080,
      "end_ms": 99765,
      "text": "还有一位钟南山院士见着他还得规规矩矩喊一声姑婆。",
      "token_start": 336,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 100160,
      "end_ms": 103985,
      "text": "您说一个连院士都要喊姑婆的人，",
      "token_start": 359,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 104530,
      "end_ms": 107365,
      "text": "为什么偏偏一辈子守着产房？",
      "token_start": 373,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 108400,
      "end_ms": 109725,
      "text": "因为他五岁那年，",
      "token_start": 385,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 109990,
      "end_ms": 111055,
      "text": "母亲病逝了，",
      "token_start": 392,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 111480,
      "end_ms": 112615,
      "text": "他跪在床边，",
      "token_start": 397,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 113040,
      "end_ms": 115485,
      "text": "眼睁睁看着妈妈闭上眼睛，",
      "token_start": 402,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 115900,
      "end_ms": 117365,
      "text": "哭的撕心裂肺，",
      "token_start": 413,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 117820,
      "end_ms": 118985,
      "text": "却什么都做不了。",
      "token_start": 419,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 119970,
      "end_ms": 120770,
      "text": "从那天起，",
      "token_start": 426,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 120770,
      "end_ms": 121470,
      "text": "他就发誓，",
      "token_start": 430,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 122050,
      "end_ms": 123030,
      "text": "我要当医生，",
      "token_start": 434,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 123210,
      "end_ms": 126210,
      "text": "我要让别人的妈不再死。",
      "token_start": 439,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 127190,
      "end_ms": 128250,
      "text": "一九二一年，",
      "token_start": 449,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 128450,
      "end_ms": 130930,
      "text": "他考协和医学院百里挑一，",
      "token_start": 454,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 131270,
      "end_ms": 132790,
      "text": "考最后一门英语。",
      "token_start": 465,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 133170,
      "end_ms": 135590,
      "text": "考场里一个女生中暑晕倒了，",
      "token_start": 472,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 136190,
      "end_ms": 138110,
      "text": "别的考生都低头做题，",
      "token_start": 484,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 138690,
      "end_ms": 140150,
      "text": "只有他把笔一扔，",
      "token_start": 493,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 140490,
      "end_ms": 141470,
      "text": "冲过去救人。",
      "token_start": 500,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 142390,
      "end_ms": 143390,
      "text": "等他忙活完，",
      "token_start": 505,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 143550,
      "end_ms": 144810,
      "text": "考试也结束了，",
      "token_start": 510,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 144810,
      "end_ms": 146130,
      "text": "他以为自己落榜了，",
      "token_start": 516,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 146850,
      "end_ms": 147710,
      "text": "可一个月后，",
      "token_start": 524,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 147710,
      "end_ms": 149365,
      "text": "录取通知书到家了。",
      "token_start": 529,
      "token_end_exclusive": 537
    },
    {
      "start_ms": 149980,
      "end_ms": 150660,
      "text": "考官说，",
      "token_start": 537,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 151480,
      "end_ms": 153400,
      "text": "能在最要紧的关头，",
      "token_start": 540,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 153440,
      "end_ms": 155200,
      "text": "放下前程去救人，",
      "token_start": 548,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 156160,
      "end_ms": 157720,
      "text": "这就是当医生的料，",
      "token_start": 555,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 158600,
      "end_ms": 159800,
      "text": "分数可以补考，",
      "token_start": 563,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 160340,
      "end_ms": 161360,
      "text": "人品补不了。",
      "token_start": 569,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 161780,
      "end_ms": 162560,
      "text": "进了协和。",
      "token_start": 574,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 162860,
      "end_ms": 166320,
      "text": "他选了又脏又累的妇产科医院。",
      "token_start": 578,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 166320,
      "end_ms": 168960,
      "text": "有规定女医生结婚就得走人，",
      "token_start": 591,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 169260,
      "end_ms": 172420,
      "text": "他二话没说直接把自己嫁给了医院，",
      "token_start": 603,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 172980,
      "end_ms": 174160,
      "text": "一辈子没结婚，",
      "token_start": 618,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 175000,
      "end_ms": 176260,
      "text": "一辈问他后悔吗？",
      "token_start": 624,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 177200,
      "end_ms": 177640,
      "text": "他说，",
      "token_start": 631,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 178480,
      "end_ms": 180045,
      "text": "我最爱听的是东音，",
      "token_start": 633,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 180260,
      "end_ms": 183095,
      "text": "就是婴儿出生后的第一声啼哭。",
      "token_start": 641,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 184010,
      "end_ms": 185525,
      "text": "他给孕妇听台心前，",
      "token_start": 654,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 186140,
      "end_ms": 190705,
      "text": "总先把冰凉的听诊器贴在自己手心里热。",
      "token_start": 662,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 191310,
      "end_ms": 191790,
      "text": "他说，",
      "token_start": 679,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 192140,
      "end_ms": 193715,
      "text": "产妇已经在受罪了，",
      "token_start": 681,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 194140,
      "end_ms": 196605,
      "text": "能少一点粮就少一点粮。",
      "token_start": 689,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 197070,
      "end_ms": 198225,
      "text": "一九三九年，",
      "token_start": 699,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 198560,
      "end_ms": 199675,
      "text": "他去美国进修，",
      "token_start": 704,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 200160,
      "end_ms": 202100,
      "text": "美国顶级医院抢着流淌，",
      "token_start": 710,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 202400,
      "end_ms": 203755,
      "text": "条件开的特别高。",
      "token_start": 720,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 204210,
      "end_ms": 204675,
      "text": "他说，",
      "token_start": 727,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 205060,
      "end_ms": 206605,
      "text": "科学可以没有国界，",
      "token_start": 729,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 206940,
      "end_ms": 210790,
      "text": "一生不能没有祖国收拾了箱子回国。",
      "token_start": 737,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 210870,
      "end_ms": 211815,
      "text": "一九四一年，",
      "token_start": 752,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 212100,
      "end_ms": 212960,
      "text": "太平洋战争，",
      "token_start": 757,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 212960,
      "end_ms": 213345,
      "text": "爆发，",
      "token_start": 762,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 213770,
      "end_ms": 215365,
      "text": "协和医院被迫关门。",
      "token_start": 764,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 216020,
      "end_ms": 219095,
      "text": "他就在东塘子胡同开了间小诊所，",
      "token_start": 772,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 219840,
      "end_ms": 220760,
      "text": "穷人没钱，",
      "token_start": 786,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 220780,
      "end_ms": 221245,
      "text": "看病，",
      "token_start": 790,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 221530,
      "end_ms": 222405,
      "text": "还倒切鸡蛋，",
      "token_start": 792,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 224210,
      "end_ms": 224785,
      "text": "红糖，",
      "token_start": 797,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 225670,
      "end_ms": 227090,
      "text": "兵荒马乱的年月。",
      "token_start": 799,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 227330,
      "end_ms": 229115,
      "text": "他心里只有一个念头，",
      "token_start": 806,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 229920,
      "end_ms": 231580,
      "text": "大人孩子能活下来，",
      "token_start": 815,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 231740,
      "end_ms": 232755,
      "text": "比什么都强。",
      "token_start": 823,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 233700,
      "end_ms": 234740,
      "text": "一九四九年，",
      "token_start": 828,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 234760,
      "end_ms": 235835,
      "text": "解放前期，",
      "token_start": 833,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 236460,
      "end_ms": 241455,
      "text": "傅作义将军的夫人给他送来一张亲笔签名的机票，",
      "token_start": 837,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 242030,
      "end_ms": 243875,
      "text": "拿着他能去任何城市，",
      "token_start": 858,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 244520,
      "end_ms": 246525,
      "text": "多少人用金条都换不来，",
      "token_start": 867,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 247120,
      "end_ms": 248115,
      "text": "他却谢绝了。",
      "token_start": 877,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 249850,
      "end_ms": 251125,
      "text": "我的病人还在这儿，",
      "token_start": 882,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 252520,
      "end_ms": 253495,
      "text": "我哪儿也不去。",
      "token_start": 890,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 254680,
      "end_ms": 260765,
      "text": "所以开国大典那天他不去不是不爱这个国家，",
      "token_start": 896,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 261690,
      "end_ms": 262985,
      "text": "他心里有一杆秤，",
      "token_start": 915,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 264100,
      "end_ms": 268045,
      "text": "产房就是他的天安门娃娃的啼哭，",
      "token_start": 922,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 268430,
      "end_ms": 269815,
      "text": "就是他成功的礼炮。",
      "token_start": 936,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 270340,
      "end_ms": 272165,
      "text": "一九八三年四月二十二号，",
      "token_start": 944,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 272510,
      "end_ms": 274125,
      "text": "八十二岁的他走了，",
      "token_start": 955,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 274360,
      "end_ms": 275125,
      "text": "弥留之际，",
      "token_start": 963,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 275390,
      "end_ms": 280535,
      "text": "他断断续续喊的是快快拿产钱来。",
      "token_start": 967,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 281410,
      "end_ms": 282805,
      "text": "他留下一份遗嘱，",
      "token_start": 981,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 283590,
      "end_ms": 284815,
      "text": "三万元积蓄，",
      "token_start": 988,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 285210,
      "end_ms": 291575,
      "text": "全部捐给幼儿园、托儿所遗体捐给医学院做研究，",
      "token_start": 993,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 292150,
      "end_ms": 296065,
      "text": "骨灰洒回故乡鼓浪屿的海面。",
      "token_start": 1013,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 296970,
      "end_ms": 300765,
      "text": "他把最后一点东西都还给了医学。",
      "token_start": 1025,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 301780,
      "end_ms": 303325,
      "text": "什么是真正的体面？",
      "token_start": 1039,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 303930,
      "end_ms": 305645,
      "text": "不是顺境里的风光，",
      "token_start": 1047,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 306210,
      "end_ms": 308475,
      "text": "是绝境与还肯弯下腰。",
      "token_start": 1055,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 309060,
      "end_ms": 310485,
      "text": "什么叫国之脊梁？",
      "token_start": 1064,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 311110,
      "end_ms": 316665,
      "text": "就是那个在开国大典那天安安静静守在产房里的女人。",
      "token_start": 1071,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 316930,
      "end_ms": 318595,
      "text": "如果您也被他打动了，",
      "token_start": 1094,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 318900,
      "end_ms": 323205,
      "text": "点亮红心评论区打上致敬两个字，",
      "token_start": 1103,
      "token_end_exclusive": 1117
    },
    {
      "start_ms": 323810,
      "end_ms": 326910,
      "text": "把这条视频转发给家里的长辈，",
      "token_start": 1117,
      "token_end_exclusive": 1130
    },
    {
      "start_ms": 326990,
      "end_ms": 327455,
      "text": "看看，",
      "token_start": 1130,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 327900,
      "end_ms": 328755,
      "text": "收藏起来，",
      "token_start": 1132,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 329190,
      "end_ms": 332165,
      "text": "等孙辈放学讲给他们听听，",
      "token_start": 1136,
      "token_end_exclusive": 1147
    },
    {
      "start_ms": 332690,
      "end_ms": 333330,
      "text": "关注我，",
      "token_start": 1147,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 333510,
      "end_ms": 334725,
      "text": "下期给您讲述。",
      "token_start": 1150,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 335200,
      "end_ms": 336145,
      "text": "林巧志说，",
      "token_start": 1156,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 336510,
      "end_ms": 340215,
      "text": "民族的未来都在产妇的肚子里。",
      "token_start": 1160,
      "token_end_exclusive": 1173
    }
  ],
