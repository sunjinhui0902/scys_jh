{
  "video_id": "v_0ac04558a0b201d0",
  "duration_s": 395.068966,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_0ac04558a0b201d0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_0ac04558a0b201d0.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 2790,
      "text": "被低估的民国大女主徐广平，",
      "token_start": 0,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 3390,
      "end_ms": 5370,
      "text": "她从来不是鲁迅的配角，",
      "token_start": 12,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 5390,
      "end_ms": 7390,
      "text": "而是活出自我的大女主。",
      "token_start": 22,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 8109,
      "end_ms": 9130,
      "text": "说起徐广平，",
      "token_start": 32,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 9610,
      "end_ms": 12970,
      "text": "绝大多数人的第一印象都是鲁迅夫人，",
      "token_start": 37,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 13550,
      "end_ms": 16850,
      "text": "可如果只把她当成文豪身边的配角，",
      "token_start": 53,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 17370,
      "end_ms": 21530,
      "text": "那你真的太小看这位民国奇女子了。",
      "token_start": 68,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 22170,
      "end_ms": 26190,
      "text": "她的人生从一开始就拿着逆天改命的剧本，",
      "token_start": 83,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 26670,
      "end_ms": 29815,
      "text": "硬生生从封建礼教的牢笼里，",
      "token_start": 101,
      "token_end_exclusive": 113
    },
    {
      "start_ms": 30250,
      "end_ms": 32450,
      "text": "活成了自己人生的大女主。",
      "token_start": 113,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 33070,
      "end_ms": 34790,
      "text": "一千八百九十八年，",
      "token_start": 124,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 35170,
      "end_ms": 40250,
      "text": "许广平出生在广州番禺高地街的许家大院。",
      "token_start": 132,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 40370,
      "end_ms": 45470,
      "text": "这可不是普通人家许家从盐商发家世代官宦，",
      "token_start": 150,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 46070,
      "end_ms": 51230,
      "text": "祖上出过抗英领袖、浙江巡抚堂兄许重志，",
      "token_start": 169,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 51530,
      "end_ms": 53610,
      "text": "更是后来的越军总司令，",
      "token_start": 186,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 53850,
      "end_ms": 56970,
      "text": "是当地数一数二的名门望族。",
      "token_start": 196,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 57630,
      "end_ms": 58010,
      "text": "按说，",
      "token_start": 208,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 58010,
      "end_ms": 59190,
      "text": "生在这样的世家，",
      "token_start": 210,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 59490,
      "end_ms": 61640,
      "text": "他本该顺着旧时代的规矩，",
      "token_start": 217,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 61640,
      "end_ms": 63310,
      "text": "长大裹小脚，",
      "token_start": 228,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 63470,
      "end_ms": 64285,
      "text": "学女红，",
      "token_start": 233,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 64700,
      "end_ms": 65835,
      "text": "深居简出，",
      "token_start": 236,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 66390,
      "end_ms": 68275,
      "text": "等着家人安排婚事，",
      "token_start": 240,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 68640,
      "end_ms": 69825,
      "text": "安稳度过一生。",
      "token_start": 248,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 70660,
      "end_ms": 72445,
      "text": "可徐广平从懂事起，",
      "token_start": 254,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 73080,
      "end_ms": 75175,
      "text": "骨子里就刻着不服输的劲儿。",
      "token_start": 262,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 76150,
      "end_ms": 81025,
      "text": "他的命运枷锁来的比所有人都早出生刚三天。",
      "token_start": 274,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 81450,
      "end_ms": 86065,
      "text": "父亲徐炳飞在酒宴上与友人碰杯为婚，",
      "token_start": 293,
      "token_end_exclusive": 309
    },
    {
      "start_ms": 86590,
      "end_ms": 93500,
      "text": "随口就将尚在襁褓中的他许配给了香港一户马姓人家马甲，",
      "token_start": 309,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 93520,
      "end_ms": 95745,
      "text": "对外标榜读书首领，",
      "token_start": 334,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 96170,
      "end_ms": 97970,
      "text": "实则纵容子弟，",
      "token_start": 342,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 98070,
      "end_ms": 100425,
      "text": "横行乡里、拦路勒索，",
      "token_start": 348,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 100710,
      "end_ms": 103245,
      "text": "是远近闻名的劣身之家。",
      "token_start": 356,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 104090,
      "end_ms": 105490,
      "text": "等父亲反应过来，",
      "token_start": 366,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 105490,
      "end_ms": 106595,
      "text": "悔不当初时，",
      "token_start": 373,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 107080,
      "end_ms": 108195,
      "text": "聘礼一收，",
      "token_start": 378,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 108710,
      "end_ms": 109625,
      "text": "婚约已定，",
      "token_start": 382,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 109970,
      "end_ms": 113595,
      "text": "碍于脸面和世俗规矩根本无法反悔。",
      "token_start": 386,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 114140,
      "end_ms": 115745,
      "text": "这么荒唐的娃娃亲，",
      "token_start": 401,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 116100,
      "end_ms": 120455,
      "text": "就这样成了套在徐广平身上的第一道枷锁。",
      "token_start": 409,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 120710,
      "end_ms": 121645,
      "text": "十五岁那年，",
      "token_start": 427,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 122050,
      "end_ms": 126865,
      "text": "马家派人来商议婚妻徐广平直接站出来当面表态，",
      "token_start": 432,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 127280,
      "end_ms": 130400,
      "text": "明确拒绝这门婚事气的马家人，",
      "token_start": 453,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 130400,
      "end_ms": 132015,
      "text": "骂他是世家败类，",
      "token_start": 466,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 132480,
      "end_ms": 133935,
      "text": "可他半点不退让。",
      "token_start": 473,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 134560,
      "end_ms": 135895,
      "text": "等他渐渐长大，",
      "token_start": 480,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 136300,
      "end_ms": 137875,
      "text": "更是想的通透，",
      "token_start": 486,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 138250,
      "end_ms": 141450,
      "text": "哭和闹都换不来自由女人。",
      "token_start": 492,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 141470,
      "end_ms": 142945,
      "text": "只有自己能立足，",
      "token_start": 503,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 143250,
      "end_ms": 143935,
      "text": "能独立，",
      "token_start": 510,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 144350,
      "end_ms": 147115,
      "text": "才能真正掌握人生的主动权。",
      "token_start": 513,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 148770,
      "end_ms": 149615,
      "text": "八岁那年，",
      "token_start": 525,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 150100,
      "end_ms": 151280,
      "text": "家里按旧俗，",
      "token_start": 529,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 151380,
      "end_ms": 152555,
      "text": "要给他裹小脚，",
      "token_start": 534,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 153020,
      "end_ms": 156775,
      "text": "这是当时几乎所有女孩都逃不开的宿命。",
      "token_start": 540,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 157390,
      "end_ms": 159600,
      "text": "可徐广平拼死反抗，",
      "token_start": 557,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 159680,
      "end_ms": 160305,
      "text": "哭闹着，",
      "token_start": 565,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 160640,
      "end_ms": 161945,
      "text": "死活不肯缠足。",
      "token_start": 568,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 162560,
      "end_ms": 164895,
      "text": "幸好父亲思想相对开明，",
      "token_start": 574,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 165360,
      "end_ms": 166695,
      "text": "最终松了口。",
      "token_start": 584,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 167020,
      "end_ms": 169005,
      "text": "他才保住了一双自由的脚。",
      "token_start": 589,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 169780,
      "end_ms": 170815,
      "text": "后来他常说，",
      "token_start": 600,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 171280,
      "end_ms": 175600,
      "text": "自己这双脚是从旧礼教手里硬生生抢回来的。",
      "token_start": 605,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 176290,
      "end_ms": 177715,
      "text": "在读书这件事上，",
      "token_start": 624,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 178050,
      "end_ms": 179675,
      "text": "他更是逆着规矩来。",
      "token_start": 631,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 180720,
      "end_ms": 185040,
      "text": "清末的广东依旧信奉女子无才便是德。",
      "token_start": 639,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 185800,
      "end_ms": 187320,
      "text": "女孩家能识几个字，",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 187660,
      "end_ms": 189700,
      "text": "写封家书就足够了，",
      "token_start": 663,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 190060,
      "end_ms": 196580,
      "text": "可徐广平偏要和家中兄弟一起进私塾、读书、学官画读典籍，",
      "token_start": 671,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 196780,
      "end_ms": 198860,
      "text": "还偷偷找新式书报来看，",
      "token_start": 695,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 199700,
      "end_ms": 203400,
      "text": "早早接触到了民主与解放的新思想。",
      "token_start": 705,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 204080,
      "end_ms": 206520,
      "text": "在守旧沉闷的大家族里，",
      "token_start": 720,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 206680,
      "end_ms": 209960,
      "text": "他的一举一动都算得上离京。",
      "token_start": 730,
      "token_end_exclusive": 742
    },
    {
      "start_ms": 209960,
      "end_ms": 212350,
      "text": "叛到一九一七年，",
      "token_start": 742,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 212610,
      "end_ms": 213610,
      "text": "父亲病逝，",
      "token_start": 749,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 214130,
      "end_ms": 215350,
      "text": "马家没了顾忌，",
      "token_start": 753,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 215610,
      "end_ms": 217570,
      "text": "立刻上门步步紧逼，",
      "token_start": 759,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 217610,
      "end_ms": 218050,
      "text": "催婚。",
      "token_start": 767,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 218810,
      "end_ms": 220730,
      "text": "失去父亲庇护的徐广平，",
      "token_start": 769,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 221070,
      "end_ms": 222530,
      "text": "没有半分退缩，",
      "token_start": 779,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 222970,
      "end_ms": 225770,
      "text": "他在二哥的帮助下据理力争，",
      "token_start": 785,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 226330,
      "end_ms": 228810,
      "text": "最终彻底解除了这桩束缚。",
      "token_start": 797,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 228810,
      "end_ms": 230790,
      "text": "他近二十年的包办婚约，",
      "token_start": 808,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 231330,
      "end_ms": 233070,
      "text": "挣脱了婚姻的枷锁。",
      "token_start": 818,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 233490,
      "end_ms": 234850,
      "text": "他做了一个震惊，",
      "token_start": 826,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 234870,
      "end_ms": 235870,
      "text": "全家的决定，",
      "token_start": 833,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 235950,
      "end_ms": 238210,
      "text": "离开广东北上求学，",
      "token_start": 838,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 238450,
      "end_ms": 240245,
      "text": "去看更广阔的世界。",
      "token_start": 846,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 241150,
      "end_ms": 245660,
      "text": "他先是考入天津直隶第一女子师范学校苦读。",
      "token_start": 854,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 245660,
      "end_ms": 246315,
      "text": "多年后，",
      "token_start": 873,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 246620,
      "end_ms": 250025,
      "text": "又顺利考入北京女子高等师范学校。",
      "token_start": 876,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 250460,
      "end_ms": 252005,
      "text": "五四运动爆发时，",
      "token_start": 891,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 252340,
      "end_ms": 255285,
      "text": "他已经是学生运动的骨干领袖。",
      "token_start": 898,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 255630,
      "end_ms": 257855,
      "text": "上节演讲、创办刊物，",
      "token_start": 911,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 258260,
      "end_ms": 260485,
      "text": "还担任了刑事周刊的主编，",
      "token_start": 919,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 261100,
      "end_ms": 262180,
      "text": "提笔写文章，",
      "token_start": 930,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 262200,
      "end_ms": 264655,
      "text": "呼吁妇女解放思想自由。",
      "token_start": 935,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 265120,
      "end_ms": 267485,
      "text": "他从来不是躲在后面喊口号的人，",
      "token_start": 945,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 267990,
      "end_ms": 270395,
      "text": "每次学生运动都冲在最前面。",
      "token_start": 959,
      "token_end_exclusive": 971
    },
    {
      "start_ms": 270650,
      "end_ms": 271605,
      "text": "一九二五年，",
      "token_start": 971,
      "token_end_exclusive": 976
    },
    {
      "start_ms": 272260,
      "end_ms": 276515,
      "text": "北京女高师爆发轰动一时的屈阳风潮，",
      "token_start": 976,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 277410,
      "end_ms": 279590,
      "text": "校长杨殷于智孝装，",
      "token_start": 992,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 279590,
      "end_ms": 285295,
      "text": "横肆意压制学生思想激起的全校学生的反抗。",
      "token_start": 1000,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 285780,
      "end_ms": 291655,
      "text": "身为学生会总干事的徐广平和后来在三幺八惨案中牺牲的刘和珍一起，",
      "token_start": 1019,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 292110,
      "end_ms": 298005,
      "text": "带领同学们罢课请愿、发檄文和校方强硬对抗，",
      "token_start": 1049,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 298470,
      "end_ms": 300495,
      "text": "哪怕最终被学校开除，",
      "token_start": 1068,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 300950,
      "end_ms": 302585,
      "text": "他也始终挺直腰杆。",
      "token_start": 1077,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 303030,
      "end_ms": 304330,
      "text": "没有半分低头。",
      "token_start": 1085,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 305290,
      "end_ms": 307570,
      "text": "也正是在这段风波里，",
      "token_start": 1091,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 307630,
      "end_ms": 309850,
      "text": "他提笔给鲁迅写了第一封信，",
      "token_start": 1100,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 310410,
      "end_ms": 311990,
      "text": "开启了两人的缘分。",
      "token_start": 1112,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 312830,
      "end_ms": 316190,
      "text": "很多人觉得徐广平是崇拜鲁迅，",
      "token_start": 1120,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 316730,
      "end_ms": 318210,
      "text": "疑附鲁迅的小女生，",
      "token_start": 1133,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 318990,
      "end_ms": 320570,
      "text": "可回头看他走过的路，",
      "token_start": 1141,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 320570,
      "end_ms": 321330,
      "text": "就会明白，",
      "token_start": 1150,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 321810,
      "end_ms": 323130,
      "text": "在遇见鲁迅之前，",
      "token_start": 1154,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 323510,
      "end_ms": 331950,
      "text": "他早就已经是一个有思想、有胆识、敢和整个旧世界对抗的独立女性了。",
      "token_start": 1161,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 331950,
      "end_ms": 334400,
      "text": "她有自己的理想和战场，",
      "token_start": 1190,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 334720,
      "end_ms": 337760,
      "text": "有不输给任何人的勇气和棱角。",
      "token_start": 1200,
      "token_end_exclusive": 1213
    },
    {
      "start_ms": 338360,
      "end_ms": 340160,
      "text": "他敢于爱上鲁迅，",
      "token_start": 1213,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 340400,
      "end_ms": 342360,
      "text": "敢于冲破世俗偏见。",
      "token_start": 1220,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 342660,
      "end_ms": 343680,
      "text": "和他走到一起，",
      "token_start": 1228,
      "token_end_exclusive": 1234
    },
    {
      "start_ms": 343800,
      "end_ms": 345960,
      "text": "从来不是仰望式的义附，",
      "token_start": 1234,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 346120,
      "end_ms": 349240,
      "text": "而是两个独立灵魂的惺惺相惜。",
      "token_start": 1244,
      "token_end_exclusive": 1257
    },
    {
      "start_ms": 350160,
      "end_ms": 352900,
      "text": "从被定下娃娃亲的世家小姐，",
      "token_start": 1257,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 353240,
      "end_ms": 356300,
      "text": "到投身时代浪潮的新女性，",
      "token_start": 1269,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 356700,
      "end_ms": 359660,
      "text": "从挣脱封建礼教的叛逆者，",
      "token_start": 1280,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 360120,
      "end_ms": 362595,
      "text": "到守护鲁迅精神的践行者，",
      "token_start": 1291,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 362950,
      "end_ms": 364075,
      "text": "徐广平的一生，",
      "token_start": 1302,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 364500,
      "end_ms": 366335,
      "text": "从来都在为自己而活，",
      "token_start": 1308,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 366810,
      "end_ms": 368865,
      "text": "他不依附谁的光环，",
      "token_start": 1317,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 369340,
      "end_ms": 371175,
      "text": "不被谁的标签定义。",
      "token_start": 1325,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 371860,
      "end_ms": 375295,
      "text": "他就是他自己是敢和命运叫板，",
      "token_start": 1333,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 375650,
      "end_ms": 377625,
      "text": "敢为自己掌舵的徐广平。",
      "token_start": 1346,
      "token_end_exclusive": 1356
    },
    {
      "start_ms": 378220,
      "end_ms": 378610,
      "text": "好了，",
      "token_start": 1356,
      "token_end_exclusive": 1358
    },
    {
      "start_ms": 378720,
      "end_ms": 379955,
      "text": "今天的故事就到这里。",
      "token_start": 1358,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 380140,
      "end_ms": 382275,
      "text": "你印象里的徐广平是什么样的？",
      "token_start": 1367,
      "token_end_exclusive": 1380
    },
    {
      "start_ms": 383080,
      "end_ms": 384465,
      "text": "欢迎在评论区留言，",
      "token_start": 1380,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 384690,
      "end_ms": 385595,
      "text": "聊聊你的看法。",
      "token_start": 1388,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 386510,
      "end_ms": 388675,
      "text": "如果喜欢这样的传奇女性故事，",
      "token_start": 1394,
      "token_end_exclusive": 1407
    },
    {
      "start_ms": 388910,
      "end_ms": 390105,
      "text": "别忘了点赞关注，",
      "token_start": 1407,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 390410,
      "end_ms": 394965,
      "text": "下期继续带你解锁更多被历史低估的独立人生。",
      "token_start": 1414,
      "token_end_exclusive": 1434
    }
  ],
