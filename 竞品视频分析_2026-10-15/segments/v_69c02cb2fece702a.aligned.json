  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2330,
      "text": "这酒怎么喝到最后还有半瓶儿，",
      "token_start": 0,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 2330,
      "end_ms": 3510,
      "text": "半瓶留着下次喝，",
      "token_start": 13,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 3510,
      "end_ms": 4630,
      "text": "说明咱俩的局还没完。",
      "token_start": 20,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 4950,
      "end_ms": 5990,
      "text": "酒喝干了是散场，",
      "token_start": 29,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 6090,
      "end_ms": 7050,
      "text": "剩半瓶是续集。",
      "token_start": 36,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 7170,
      "end_ms": 8735,
      "text": "您下回还得来，",
      "token_start": 42,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 11930,
      "end_ms": 12750,
      "text": "你什么意思啊，",
      "token_start": 48,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 12750,
      "end_ms": 13150,
      "text": "怎么给我？",
      "token_start": 54,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 13150,
      "end_ms": 14050,
      "text": "这倒的这么满啊，",
      "token_start": 58,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 14110,
      "end_ms": 14810,
      "text": "酒满敬人，",
      "token_start": 65,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 14810,
      "end_ms": 16230,
      "text": "茶满七人给您倒满，",
      "token_start": 69,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 16230,
      "end_ms": 17150,
      "text": "是我对您的敬意。",
      "token_start": 77,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 17390,
      "end_ms": 18270,
      "text": "满到溢出来了，",
      "token_start": 84,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 20950,
      "end_ms": 21770,
      "text": "你什么意思？",
      "token_start": 90,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 22230,
      "end_ms": 23390,
      "text": "怎么最后一个敬我？",
      "token_start": 95,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 23810,
      "end_ms": 25070,
      "text": "第一个敬您是开场，",
      "token_start": 103,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 25230,
      "end_ms": 25830,
      "text": "最后一个敬，",
      "token_start": 111,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 25830,
      "end_ms": 27930,
      "text": "您是压轴开场热闹压轴值前，",
      "token_start": 116,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 28130,
      "end_ms": 29730,
      "text": "我把最值钱的位置留给自己了。",
      "token_start": 128,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 31230,
      "end_ms": 31710,
      "text": "小李，",
      "token_start": 141,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 32130,
      "end_ms": 33310,
      "text": "你这酒量不行啊，",
      "token_start": 143,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 33510,
      "end_ms": 34750,
      "text": "才几杯就上脸啊，",
      "token_start": 150,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 35490,
      "end_ms": 36490,
      "text": "酒量留给外人，",
      "token_start": 157,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 36730,
      "end_ms": 37630,
      "text": "真心留给您，",
      "token_start": 163,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 37990,
      "end_ms": 38530,
      "text": "跟您喝，",
      "token_start": 168,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 38750,
      "end_ms": 39310,
      "text": "不用装，",
      "token_start": 171,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 41290,
      "end_ms": 44120,
      "text": "怎么您你给自己倒的是茶茶陪酒，",
      "token_start": 174,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 44240,
      "end_ms": 45260,
      "text": "一个清醒一个醉，",
      "token_start": 188,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 45600,
      "end_ms": 46040,
      "text": "您醉了。",
      "token_start": 195,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 46040,
      "end_ms": 46120,
      "text": "有，",
      "token_start": 198,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 46120,
      "end_ms": 47140,
      "text": "我扶着我醉了，",
      "token_start": 199,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 47180,
      "end_ms": 48140,
      "text": "咱俩都趴桌上了。",
      "token_start": 205,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 48320,
      "end_ms": 52740,
      "text": "明早谁给您汇报这鱼，",
      "token_start": 212,
      "token_end_exclusive": 221
    },
    {
      "start_ms": 52740,
      "end_ms": 53900,
      "text": "你怎么点清蒸的呢？",
      "token_start": 221,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 53900,
      "end_ms": 55060,
      "text": "原汁原味才最鲜，",
      "token_start": 229,
      "token_end_exclusive": 236
    },
    {
      "start_ms": 55220,
      "end_ms": 55900,
      "text": "调料多了，",
      "token_start": 236,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 56000,
      "end_ms": 57260,
      "text": "盖住的都是食材本身。",
      "token_start": 240,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 57380,
      "end_ms": 58700,
      "text": "就像您看人一眼，",
      "token_start": 249,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 58700,
      "end_ms": 60175,
      "text": "到底不用包装，",
      "token_start": 256,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 61610,
      "end_ms": 63705,
      "text": "你怎么就喝这点儿养菊呢？",
      "token_start": 262,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 64280,
      "end_ms": 65080,
      "text": "我得留着量，",
      "token_start": 273,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 65180,
      "end_ms": 66280,
      "text": "万一您喝到位了，",
      "token_start": 278,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 66280,
      "end_ms": 68975,
      "text": "总得有个清醒的人负责掏您家门钥匙吧。",
      "token_start": 285,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 70920,
      "end_ms": 71255,
      "text": "哈哈，",
      "token_start": 302,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 71590,
      "end_ms": 71885,
      "text": "哎，",
      "token_start": 304,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 72190,
      "end_ms": 72990,
      "text": "你什么意思啊？",
      "token_start": 305,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 73110,
      "end_ms": 74595,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 311,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 74860,
      "end_ms": 75580,
      "text": "领导美满，",
      "token_start": 322,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 75580,
      "end_ms": 75915,
      "text": "美满，",
      "token_start": 326,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 76290,
      "end_ms": 77395,
      "text": "代表幸福美满，",
      "token_start": 328,
      "token_end_exclusive": 334
    },
    {
      "start_ms": 77620,
      "end_ms": 78440,
      "text": "这一辈子没满，",
      "token_start": 334,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 78440,
      "end_ms": 79695,
      "text": "就是一辈子没满啊。",
      "token_start": 340,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 82570,
      "end_ms": 83550,
      "text": "第一杯你不干掉，",
      "token_start": 348,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 83870,
      "end_ms": 84675,
      "text": "就是看不起我。",
      "token_start": 355,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 85230,
      "end_ms": 87690,
      "text": "领导第一杯干掉是规矩第二杯，",
      "token_start": 361,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 87690,
      "end_ms": 88635,
      "text": "慢慢品才是交情，",
      "token_start": 374,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 88860,
      "end_ms": 89620,
      "text": "把规矩做足，",
      "token_start": 381,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 89620,
      "end_ms": 91375,
      "text": "后面交情再慢慢聊。",
      "token_start": 386,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 92650,
      "end_ms": 93230,
      "text": "关注我，",
      "token_start": 394,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 93350,
      "end_ms": 94710,
      "text": "每天学点高情商，",
      "token_start": 397,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 94730,
      "end_ms": 95410,
      "text": "说话技巧，",
      "token_start": 404,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 95650,
      "end_ms": 97275,
      "text": "让你的路越走越宽。",
      "token_start": 408,
      "token_end_exclusive": 416
    }
  ],
