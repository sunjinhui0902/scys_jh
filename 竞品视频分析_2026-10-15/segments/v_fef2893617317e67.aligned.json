{
  "video_id": "v_fef2893617317e67",
  "duration_s": 446.827586,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_fef2893617317e67.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_fef2893617317e67.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 3090,
      "text": "你十四岁那年在干啥？",
      "token_start": 0,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 4230,
      "end_ms": 5970,
      "text": "是不是还在爹妈跟前撒娇，",
      "token_start": 9,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 6790,
      "end_ms": 7290,
      "text": "考试，",
      "token_start": 20,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 7330,
      "end_ms": 8710,
      "text": "考砸了怕挨揍。",
      "token_start": 22,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 9710,
      "end_ms": 14770,
      "text": "可一九零二年湖北黄冈有个十四岁的穷小子，",
      "token_start": 28,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 15230,
      "end_ms": 16129,
      "text": "干了一件事，",
      "token_start": 47,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 16510,
      "end_ms": 19190,
      "text": "把自己的名字填错了。",
      "token_start": 52,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 19850,
      "end_ms": 22290,
      "text": "这孩子叫李仲坎爹，",
      "token_start": 61,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 22310,
      "end_ms": 23550,
      "text": "是个穷教书匠，",
      "token_start": 69,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 24030,
      "end_ms": 25530,
      "text": "家里穷的叮当响，",
      "token_start": 75,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 25970,
      "end_ms": 30000,
      "text": "连去武昌赶考的路费都是东拼西凑几了，",
      "token_start": 82,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 30080,
      "end_ms": 30720,
      "text": "借来的。",
      "token_start": 99,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 31120,
      "end_ms": 32920,
      "text": "到了考场填报名表，",
      "token_start": 102,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 33280,
      "end_ms": 34300,
      "text": "他太紧张，",
      "token_start": 110,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 34300,
      "end_ms": 35500,
      "text": "了手一抖，",
      "token_start": 114,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 36020,
      "end_ms": 39560,
      "text": "把年龄十四两个字写进了姓名栏。",
      "token_start": 118,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 39620,
      "end_ms": 41360,
      "text": "等他回过神坏了，",
      "token_start": 132,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 41480,
      "end_ms": 42380,
      "text": "再买一张表，",
      "token_start": 139,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 43240,
      "end_ms": 45660,
      "text": "兜里的钱只够买这一张。",
      "token_start": 144,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 46480,
      "end_ms": 47760,
      "text": "你猜这孩子怎么办？",
      "token_start": 154,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 48660,
      "end_ms": 51520,
      "text": "他不慌盯着那个十字，",
      "token_start": 162,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 51520,
      "end_ms": 52240,
      "text": "看了半天，",
      "token_start": 171,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 53120,
      "end_ms": 55660,
      "text": "提笔添了几笔兴生生，",
      "token_start": 175,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 55700,
      "end_ms": 58160,
      "text": "把十改成了笔姓，",
      "token_start": 184,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 58240,
      "end_ms": 59080,
      "text": "有了名，",
      "token_start": 191,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 59080,
      "end_ms": 59855,
      "text": "还空着。",
      "token_start": 194,
      "token_end_exclusive": 197
    },
    {
      "start_ms": 60290,
      "end_ms": 61190,
      "text": "他一抬头，",
      "token_start": 197,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 61450,
      "end_ms": 63885,
      "text": "看见厅堂上方挂着一块匾，",
      "token_start": 201,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 64340,
      "end_ms": 67235,
      "text": "上写光背四表四个大字。",
      "token_start": 212,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 67800,
      "end_ms": 69655,
      "text": "他摘下最后一个光子，",
      "token_start": 222,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 70170,
      "end_ms": 74820,
      "text": "随手把自己的名字定成了李四光一张填错的表，",
      "token_start": 231,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 74920,
      "end_ms": 76905,
      "text": "一个将错就错的名字。",
      "token_start": 251,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 77710,
      "end_ms": 82615,
      "text": "谁能想到这个穷小子情急之下改的名字，",
      "token_start": 260,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 83170,
      "end_ms": 86735,
      "text": "日后会刻进新中国的史册，",
      "token_start": 277,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 87660,
      "end_ms": 88735,
      "text": "名字是错的。",
      "token_start": 288,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 89670,
      "end_ms": 92505,
      "text": "可他这辈子走的路一步都没走错。",
      "token_start": 293,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 93090,
      "end_ms": 95645,
      "text": "李四光小时候跟着爹念私塾，",
      "token_start": 307,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 96080,
      "end_ms": 97645,
      "text": "有一回在村口玩儿，",
      "token_start": 319,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 98020,
      "end_ms": 101405,
      "text": "看见一块孤零零的大石头比人还高。",
      "token_start": 327,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 102240,
      "end_ms": 103675,
      "text": "他就跑去问先生，",
      "token_start": 342,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 104270,
      "end_ms": 105795,
      "text": "这石头是从哪儿来的？",
      "token_start": 349,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 106150,
      "end_ms": 107230,
      "text": "先生答不上来，",
      "token_start": 358,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 107490,
      "end_ms": 108715,
      "text": "就这么一个问题。",
      "token_start": 364,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 109580,
      "end_ms": 112740,
      "text": "在他心里扎了根很多年后，",
      "token_start": 371,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 112920,
      "end_ms": 117255,
      "text": "他才明白自己这辈子就是想去回答一句话，",
      "token_start": 382,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 118000,
      "end_ms": 121925,
      "text": "脚下这片土地到底藏着什么？",
      "token_start": 400,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 122820,
      "end_ms": 127565,
      "text": "十五岁李四光公费去日本留学，",
      "token_start": 412,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 128790,
      "end_ms": 129645,
      "text": "学造船，",
      "token_start": 425,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 132040,
      "end_ms": 133115,
      "text": "为啥学造船？",
      "token_start": 428,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 133670,
      "end_ms": 134675,
      "text": "说出来扎心。",
      "token_start": 433,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 135200,
      "end_ms": 138195,
      "text": "那时候的中国海防烂得一塌糊涂，",
      "token_start": 438,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 138690,
      "end_ms": 141975,
      "text": "列强的军舰在长江里横冲直撞。",
      "token_start": 452,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 142320,
      "end_ms": 144225,
      "text": "跟逛自家后花园似的，",
      "token_start": 465,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 144910,
      "end_ms": 148145,
      "text": "一个十几岁的孩子心里憋着一口气，",
      "token_start": 474,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 149160,
      "end_ms": 151965,
      "text": "造船强国把海防守住。",
      "token_start": 489,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 152430,
      "end_ms": 153370,
      "text": "一九零五年，",
      "token_start": 498,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 153570,
      "end_ms": 156340,
      "text": "孙中山在东京筹建同盟会，",
      "token_start": 503,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 156420,
      "end_ms": 159160,
      "text": "李四光由孙中山亲自主盟，",
      "token_start": 514,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 159200,
      "end_ms": 162775,
      "text": "加入成了最年轻的创始会员之一。",
      "token_start": 525,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 163590,
      "end_ms": 164910,
      "text": "孙中山握着他的手，",
      "token_start": 539,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 165230,
      "end_ms": 166415,
      "text": "送了他八个字，",
      "token_start": 547,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 166800,
      "end_ms": 170890,
      "text": "努力向学未为国用这八个字，",
      "token_start": 553,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 171050,
      "end_ms": 175525,
      "text": "像烙铁一样烫进了他心里一趟就是一辈子。",
      "token_start": 565,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 176440,
      "end_ms": 178120,
      "text": "一九一零年毕业回国，",
      "token_start": 583,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 178440,
      "end_ms": 179955,
      "text": "辛亥革命一爆发，",
      "token_start": 592,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 180310,
      "end_ms": 184995,
      "text": "二十二岁的李四光当上了湖北军政府事业部部长。",
      "token_start": 599,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 185510,
      "end_ms": 186605,
      "text": "二十二岁呀，",
      "token_start": 620,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 186960,
      "end_ms": 187755,
      "text": "多大的官儿？",
      "token_start": 625,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 188630,
      "end_ms": 194010,
      "text": "搁今天那是省不级换做别人嗯，",
      "token_start": 630,
      "token_end_exclusive": 643
    },
    {
      "start_ms": 194210,
      "end_ms": 195270,
      "text": "少年得志，",
      "token_start": 643,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 195350,
      "end_ms": 196545,
      "text": "那还不得飘起来。",
      "token_start": 647,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 196930,
      "end_ms": 198370,
      "text": "可李四光干了没多久，",
      "token_start": 654,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 198710,
      "end_ms": 199755,
      "text": "心就凉了。",
      "token_start": 663,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 200390,
      "end_ms": 202755,
      "text": "民国初年的官场乌烟瘴气，",
      "token_start": 667,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 203100,
      "end_ms": 204235,
      "text": "他算看明白了，",
      "token_start": 678,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 204630,
      "end_ms": 207735,
      "text": "光靠造几艘船办几个工厂，",
      "token_start": 684,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 208180,
      "end_ms": 210715,
      "text": "救不了这个病入膏肓的国家。",
      "token_start": 695,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 211680,
      "end_ms": 212200,
      "text": "于是，",
      "token_start": 707,
      "token_end_exclusive": 709
    },
    {
      "start_ms": 212480,
      "end_ms": 215305,
      "text": "他做了一个让所有人都看不懂的决定，",
      "token_start": 709,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 216270,
      "end_ms": 217095,
      "text": "辞掉部长，",
      "token_start": 725,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 217930,
      "end_ms": 221185,
      "text": "一九一三年再去英国留学，",
      "token_start": 729,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 222080,
      "end_ms": 223665,
      "text": "放着好好的官不做，",
      "token_start": 740,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 224060,
      "end_ms": 225200,
      "text": "跑去洋人的地盘，",
      "token_start": 748,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 225220,
      "end_ms": 226940,
      "text": "从头学起屠杀。",
      "token_start": 755,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 227430,
      "end_ms": 229650,
      "text": "图的是国家缺什么？",
      "token_start": 761,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 229710,
      "end_ms": 230650,
      "text": "他就学什么？",
      "token_start": 769,
      "token_end_exclusive": 774
    },
    {
      "start_ms": 230670,
      "end_ms": 232250,
      "text": "到了英国伯明汉大学，",
      "token_start": 774,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 232570,
      "end_ms": 233815,
      "text": "他先学采矿，",
      "token_start": 783,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 234190,
      "end_ms": 236385,
      "text": "为啥中国地大物博，",
      "token_start": 788,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 236720,
      "end_ms": 238655,
      "text": "可怜钢铁都要靠进口，",
      "token_start": 796,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 239060,
      "end_ms": 239800,
      "text": "要强国，",
      "token_start": 805,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 240260,
      "end_ms": 242765,
      "text": "先得把地底下的矿挖出来。",
      "token_start": 808,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 244020,
      "end_ms": 245065,
      "text": "可学了一年，",
      "token_start": 819,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 245590,
      "end_ms": 247675,
      "text": "他又发现一个更要命的问题。",
      "token_start": 824,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 248730,
      "end_ms": 249365,
      "text": "矿在哪？",
      "token_start": 836,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 250410,
      "end_ms": 252525,
      "text": "地底下到底埋着什么，",
      "token_start": 839,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 253450,
      "end_ms": 254035,
      "text": "怎么找？",
      "token_start": 848,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 254960,
      "end_ms": 257815,
      "text": "要找矿得先懂地制。",
      "token_start": 851,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 259040,
      "end_ms": 264255,
      "text": "于是他第二次转向从采矿转到地址。",
      "token_start": 859,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 264760,
      "end_ms": 265785,
      "text": "你看他这几步，",
      "token_start": 874,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 266490,
      "end_ms": 269485,
      "text": "造船、采矿、地质，",
      "token_start": 880,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 269860,
      "end_ms": 271260,
      "text": "哪一步是为了自己，",
      "token_start": 886,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 271400,
      "end_ms": 272980,
      "text": "哪一步是哪个热门学，",
      "token_start": 894,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 272980,
      "end_ms": 274190,
      "text": "哪个没有，",
      "token_start": 903,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 274600,
      "end_ms": 276000,
      "text": "全是国家缺什么，",
      "token_start": 907,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 276080,
      "end_ms": 277485,
      "text": "他就扑上去学什么，",
      "token_start": 914,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 278010,
      "end_ms": 281025,
      "text": "一个少年的名字是填表填错的。",
      "token_start": 922,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 281630,
      "end_ms": 283305,
      "text": "可他这一生的志向，",
      "token_start": 935,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 283780,
      "end_ms": 284960,
      "text": "一次都没填，",
      "token_start": 943,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 284960,
      "end_ms": 285415,
      "text": "错过。",
      "token_start": 948,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 286270,
      "end_ms": 287310,
      "text": "拿到硕士后，",
      "token_start": 950,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 287510,
      "end_ms": 292680,
      "text": "应蔡元培之邀李四光到北京大学当地质系教授。",
      "token_start": 955,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 292980,
      "end_ms": 294245,
      "text": "后来做了系主任，",
      "token_start": 975,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 295080,
      "end_ms": 295695,
      "text": "在北大，",
      "token_start": 982,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 296160,
      "end_ms": 297325,
      "text": "他干了三件事，",
      "token_start": 985,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 297800,
      "end_ms": 298860,
      "text": "渐渐打脸。",
      "token_start": 991,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 298960,
      "end_ms": 307695,
      "text": "洋人第一件研究停科化石停是一种早就灭绝的微小生物外壳。",
      "token_start": 995,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 308110,
      "end_ms": 310690,
      "text": "像纺锤不同年代长得不一样，",
      "token_start": 1021,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 311310,
      "end_ms": 313970,
      "text": "李四光摸出一套鉴定方法，",
      "token_start": 1033,
      "token_end_exclusive": 1044
    },
    {
      "start_ms": 314710,
      "end_ms": 315830,
      "text": "至今还在用。",
      "token_start": 1044,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 316730,
      "end_ms": 317910,
      "text": "这东西有啥用？",
      "token_start": 1049,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 318290,
      "end_ms": 319650,
      "text": "找煤的指南针，",
      "token_start": 1055,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 320590,
      "end_ms": 323830,
      "text": "安徽一处煤矿眼看要踩空了，",
      "token_start": 1061,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 324250,
      "end_ms": 325810,
      "text": "他捡到一块停化石，",
      "token_start": 1073,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 325810,
      "end_ms": 327310,
      "text": "翻来覆去一看，",
      "token_start": 1081,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 327310,
      "end_ms": 328370,
      "text": "底下还有煤，",
      "token_start": 1087,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 328370,
      "end_ms": 331730,
      "text": "果然新煤田挖出来了。",
      "token_start": 1092,
      "token_end_exclusive": 1101
    },
    {
      "start_ms": 331730,
      "end_ms": 335610,
      "text": "第二件第四季冰川，",
      "token_start": 1101,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 335610,
      "end_ms": 339080,
      "text": "当时外国全民袁为一口咬定，",
      "token_start": 1109,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 339540,
      "end_ms": 341300,
      "text": "中国东部气候温暖，",
      "token_start": 1121,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 341480,
      "end_ms": 344820,
      "text": "不可能有冰川李四光偏不信这个邪。",
      "token_start": 1129,
      "token_end_exclusive": 1144
    },
    {
      "start_ms": 345240,
      "end_ms": 347280,
      "text": "带着学生翻山越岭，",
      "token_start": 1144,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 347460,
      "end_ms": 351660,
      "text": "太行山大统、黄山、庐山一路找过去，",
      "token_start": 1152,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 351900,
      "end_ms": 353860,
      "text": "硬是找到了冰川遗迹，",
      "token_start": 1166,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 354180,
      "end_ms": 357160,
      "text": "把洋人的定论翻了个底朝天。",
      "token_start": 1175,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 357720,
      "end_ms": 360080,
      "text": "第三件创立地质力学，",
      "token_start": 1187,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 360720,
      "end_ms": 362660,
      "text": "他把力学引进地质研究，",
      "token_start": 1196,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 363120,
      "end_ms": 364880,
      "text": "提出构造体系。",
      "token_start": 1206,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 365860,
      "end_ms": 368705,
      "text": "地壳上那些褶皱断裂，",
      "token_start": 1212,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 368980,
      "end_ms": 369955,
      "text": "不是乱常的，",
      "token_start": 1221,
      "token_end_exclusive": 1226
    },
    {
      "start_ms": 370550,
      "end_ms": 373135,
      "text": "是地底下应力挤压出来的。",
      "token_start": 1226,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 373740,
      "end_ms": 375035,
      "text": "既然是挤出来的，",
      "token_start": 1237,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 375240,
      "end_ms": 378850,
      "text": "就能算能推能预测这个想法，",
      "token_start": 1244,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 379030,
      "end_ms": 383655,
      "text": "后来成了中国找矿找由的一把总钥匙。",
      "token_start": 1256,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 384510,
      "end_ms": 385285,
      "text": "说到这儿，",
      "token_start": 1272,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 385930,
      "end_ms": 388730,
      "text": "李四光已经是国际知名的大学者，",
      "token_start": 1276,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 388730,
      "end_ms": 390745,
      "text": "在英国站稳了脚跟，",
      "token_start": 1290,
      "token_end_exclusive": 1298
    },
    {
      "start_ms": 391420,
      "end_ms": 393940,
      "text": "半生的研究手稿都整理好了，",
      "token_start": 1298,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 394100,
      "end_ms": 396435,
      "text": "就等出版人生到这儿，",
      "token_start": 1310,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 396760,
      "end_ms": 398035,
      "text": "似乎可以圆满了。",
      "token_start": 1319,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 398620,
      "end_ms": 399515,
      "text": "可就在这时，",
      "token_start": 1326,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 400120,
      "end_ms": 406085,
      "text": "一九四九年新中国成立的消息从大洋彼岸传来，",
      "token_start": 1331,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 406550,
      "end_ms": 408215,
      "text": "身在伦敦的李四光，",
      "token_start": 1351,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 408630,
      "end_ms": 411790,
      "text": "一下子站到了人生最大的悬崖边上，",
      "token_start": 1359,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 412650,
      "end_ms": 414435,
      "text": "国民党特务放出狠话。",
      "token_start": 1374,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 415070,
      "end_ms": 416090,
      "text": "不公开声明，",
      "token_start": 1383,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 416090,
      "end_ms": 423330,
      "text": "不回国就把你扣在海外留下来洋房稿费、国际地位要啥有啥，",
      "token_start": 1388,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 423570,
      "end_ms": 425650,
      "text": "回国去一个刚打完仗，",
      "token_start": 1413,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 425990,
      "end_ms": 428025,
      "text": "一穷二白的烂摊子，",
      "token_start": 1422,
      "token_end_exclusive": 1430
    },
    {
      "start_ms": 428360,
      "end_ms": 430640,
      "text": "一边是唾手可得的安稳，",
      "token_start": 1430,
      "token_end_exclusive": 1440
    },
    {
      "start_ms": 430920,
      "end_ms": 433625,
      "text": "一边是满目疮痍的故土，",
      "token_start": 1440,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 434070,
      "end_ms": 434910,
      "text": "换做是你，",
      "token_start": 1450,
      "token_end_exclusive": 1454
    },
    {
      "start_ms": 435210,
      "end_ms": 439155,
      "text": "你怎么选李四光的选择，",
      "token_start": 1454,
      "token_end_exclusive": 1464
    },
    {
      "start_ms": 439670,
      "end_ms": 444325,
      "text": "以及他回国后干出的那些惊天动地的大事。",
      "token_start": 1464,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 445080,
      "end_ms": 446695,
      "text": "咱们下集接着讲。",
      "token_start": 1482,
      "token_end_exclusive": 1489
    }
  ],
