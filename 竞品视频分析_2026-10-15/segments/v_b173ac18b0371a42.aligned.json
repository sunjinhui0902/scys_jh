{
  "video_id": "v_b173ac18b0371a42",
  "duration_s": 466.758621,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_b173ac18b0371a42.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_b173ac18b0371a42.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 90,
      "end_ms": 1530,
      "text": "一九五四年春天，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1810,
      "end_ms": 3210,
      "text": "北京四中校门口，",
      "token_start": 7,
      "token_end_exclusive": 14
    },
    {
      "start_ms": 3630,
      "end_ms": 6270,
      "text": "一个二十一岁的年轻人站在那里，",
      "token_start": 14,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 6570,
      "end_ms": 7990,
      "text": "手里攥着一张纸，",
      "token_start": 28,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 8490,
      "end_ms": 9970,
      "text": "纸上只有八个字，",
      "token_start": 35,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 10410,
      "end_ms": 12670,
      "text": "教学不力解除聘用。",
      "token_start": 42,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 13370,
      "end_ms": 14470,
      "text": "他叫陈景润，",
      "token_start": 50,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 14910,
      "end_ms": 17870,
      "text": "半年前刚从厦门大学数学系毕业，",
      "token_start": 55,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 18290,
      "end_ms": 22110,
      "text": "被分配到这所北京名校当数学老师。",
      "token_start": 69,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 22910,
      "end_ms": 28610,
      "text": "所有人都觉得名牌大学、高材生、教中学那还不是手到擒来，",
      "token_start": 84,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 28610,
      "end_ms": 31900,
      "text": "结果果第一堂课就翻了车。",
      "token_start": 108,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 32900,
      "end_ms": 35260,
      "text": "他是福建人口吟重的，",
      "token_start": 119,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 35260,
      "end_ms": 39620,
      "text": "像含着橄榄站在讲台上紧张的满脸通红，",
      "token_start": 128,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 40160,
      "end_ms": 42860,
      "text": "黑板上的公式写的工工整整，",
      "token_start": 145,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 43100,
      "end_ms": 44940,
      "text": "嘴里的话却结结巴巴。",
      "token_start": 157,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 45480,
      "end_ms": 48360,
      "text": "后排学生直接站起来喊老师，",
      "token_start": 166,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 48780,
      "end_ms": 50220,
      "text": "你能不能说清楚点。",
      "token_start": 178,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 50820,
      "end_ms": 51900,
      "text": "第一堂课下来，",
      "token_start": 186,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 52120,
      "end_ms": 53320,
      "text": "学生一头雾水，",
      "token_start": 192,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 54120,
      "end_ms": 55840,
      "text": "他自己出了一身大汗，",
      "token_start": 198,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 56800,
      "end_ms": 59640,
      "text": "家长投诉信像雪片一样飞进。",
      "token_start": 207,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 59640,
      "end_ms": 62220,
      "text": "学校叫他苦练了大半年，",
      "token_start": 219,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 62220,
      "end_ms": 63535,
      "text": "普通话没用，",
      "token_start": 229,
      "token_end_exclusive": 234
    },
    {
      "start_ms": 64080,
      "end_ms": 68515,
      "text": "最后学校把他辞退了一个名牌大学的高材生，",
      "token_start": 234,
      "token_end_exclusive": 253
    },
    {
      "start_ms": 68830,
      "end_ms": 70465,
      "text": "刚毕业就丢了饭碗，",
      "token_start": 253,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 71320,
      "end_ms": 73860,
      "text": "他卷着铺盖回了福州老家。",
      "token_start": 261,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 73960,
      "end_ms": 75465,
      "text": "街坊邻居指指点点，",
      "token_start": 272,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 75710,
      "end_ms": 76930,
      "text": "读了那么多年书，",
      "token_start": 280,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 77210,
      "end_ms": 79255,
      "text": "连个教书的活都干不明白。",
      "token_start": 287,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 80190,
      "end_ms": 81045,
      "text": "走投无路，",
      "token_start": 298,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 81720,
      "end_ms": 83915,
      "text": "他在福州街头摆了个小书摊儿，",
      "token_start": 302,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 84490,
      "end_ms": 87775,
      "text": "靠租书给路人看赚口饭吃。",
      "token_start": 315,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 88130,
      "end_ms": 89075,
      "text": "可谁能想到，",
      "token_start": 326,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 89550,
      "end_ms": 91330,
      "text": "就是这个被学生哄下台，",
      "token_start": 331,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 91690,
      "end_ms": 92870,
      "text": "被学校辞退，",
      "token_start": 341,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 93310,
      "end_ms": 95575,
      "text": "在街头摆书摊的失败者，",
      "token_start": 346,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 95980,
      "end_ms": 96915,
      "text": "十几年后，",
      "token_start": 356,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 97360,
      "end_ms": 102155,
      "text": "用挤麻袋草稿纸摘下了数学皇冠上的明珠，",
      "token_start": 360,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 102710,
      "end_ms": 105685,
      "text": "让整个欧美数学界集体闭嘴。",
      "token_start": 378,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 106620,
      "end_ms": 109195,
      "text": "今天咱们就讲讲陈景润，",
      "token_start": 390,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 110190,
      "end_ms": 112835,
      "text": "这个被全世界误解了一辈子的人。",
      "token_start": 400,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 113080,
      "end_ms": 114080,
      "text": "一九三三年，",
      "token_start": 414,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 114300,
      "end_ms": 117675,
      "text": "陈景润出生在福州一个普通职员家庭，",
      "token_start": 419,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 118250,
      "end_ms": 119630,
      "text": "家里兄弟姐妹多，",
      "token_start": 435,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 119850,
      "end_ms": 121510,
      "text": "日子紧巴巴他。",
      "token_start": 442,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 121510,
      "end_ms": 122530,
      "text": "十四岁那年，",
      "token_start": 448,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 122710,
      "end_ms": 123675,
      "text": "母亲走了，",
      "token_start": 453,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 123950,
      "end_ms": 124865,
      "text": "天塌了一半，",
      "token_start": 457,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 125440,
      "end_ms": 127160,
      "text": "从小他就体弱多病，",
      "token_start": 462,
      "token_end_exclusive": 470
    },
    {
      "start_ms": 127420,
      "end_ms": 128335,
      "text": "性格闷，",
      "token_start": 470,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 128640,
      "end_ms": 129535,
      "text": "不爱说话，",
      "token_start": 473,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 129990,
      "end_ms": 131665,
      "text": "别的孩子在外面疯跑，",
      "token_start": 477,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 132050,
      "end_ms": 133650,
      "text": "他一个人蹲在墙角，",
      "token_start": 486,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 133730,
      "end_ms": 134735,
      "text": "啃数学书。",
      "token_start": 494,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 135190,
      "end_ms": 136170,
      "text": "同学欺负他，",
      "token_start": 498,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 136390,
      "end_ms": 138225,
      "text": "把螃蟹搁他课桌上，",
      "token_start": 503,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 138720,
      "end_ms": 139740,
      "text": "老师查下来，",
      "token_start": 511,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 139980,
      "end_ms": 141380,
      "text": "大家都推到他头上，",
      "token_start": 516,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 141540,
      "end_ms": 142305,
      "text": "他嘴笨，",
      "token_start": 524,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 142620,
      "end_ms": 143420,
      "text": "不会辩解，",
      "token_start": 527,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 143720,
      "end_ms": 145080,
      "text": "白挨了多少冤枉，",
      "token_start": 531,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 145260,
      "end_ms": 146200,
      "text": "没人跟他玩，",
      "token_start": 538,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 146280,
      "end_ms": 149465,
      "text": "没人理解他只有那些冷冰冰的数字，",
      "token_start": 543,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 149880,
      "end_ms": 152145,
      "text": "是他灰暗童年里唯一的光。",
      "token_start": 558,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 152800,
      "end_ms": 153755,
      "text": "初三那年，",
      "token_start": 569,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 154150,
      "end_ms": 155805,
      "text": "学校来了个数学老师，",
      "token_start": 573,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 156470,
      "end_ms": 161290,
      "text": "叫沈原清华大学航空系毕业的有一回上课，",
      "token_start": 582,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 161550,
      "end_ms": 163285,
      "text": "沈源随口说了个故事，",
      "token_start": 600,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 163780,
      "end_ms": 167635,
      "text": "世界上有一道难题叫哥德巴赫猜想，",
      "token_start": 609,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 168010,
      "end_ms": 170985,
      "text": "困扰了全世界数学家两百多年，",
      "token_start": 624,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 171550,
      "end_ms": 174475,
      "text": "就像数学皇冠上一颗够不着的明珠，",
      "token_start": 637,
      "token_end_exclusive": 652
    },
    {
      "start_ms": 174900,
      "end_ms": 175760,
      "text": "谁摘下来，",
      "token_start": 652,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 176020,
      "end_ms": 177485,
      "text": "谁名垂青史，",
      "token_start": 656,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 178350,
      "end_ms": 180045,
      "text": "别的同学听完就忘了，",
      "token_start": 661,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 181240,
      "end_ms": 183575,
      "text": "可这句话像一颗火星子，",
      "token_start": 670,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 183960,
      "end_ms": 186135,
      "text": "啪的掉进了陈景润心里。",
      "token_start": 680,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 186400,
      "end_ms": 187635,
      "text": "他暗暗发誓，",
      "token_start": 690,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 188010,
      "end_ms": 191485,
      "text": "这辈子我非把这颗明珠摘下来不可。",
      "token_start": 695,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 192500,
      "end_ms": 193520,
      "text": "一九五零年，",
      "token_start": 710,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 193820,
      "end_ms": 197055,
      "text": "十七岁的陈景润高中都没毕业，",
      "token_start": 715,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 197730,
      "end_ms": 200695,
      "text": "就考上了厦门大学数学系，",
      "token_start": 728,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 201580,
      "end_ms": 202825,
      "text": "全班就四个人。",
      "token_start": 739,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 203690,
      "end_ms": 205515,
      "text": "他一头扎进书堆里，",
      "token_start": 745,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 206190,
      "end_ms": 207670,
      "text": "像饿了三天的人，",
      "token_start": 753,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 207710,
      "end_ms": 210055,
      "text": "扑在馒头上下大雨，",
      "token_start": 760,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 210440,
      "end_ms": 212375,
      "text": "同学都往屋檐下冲，",
      "token_start": 768,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 213090,
      "end_ms": 215450,
      "text": "就他一个人在校园里慢悠悠晃，",
      "token_start": 776,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 215750,
      "end_ms": 217285,
      "text": "脑子里全是公事，",
      "token_start": 789,
      "token_end_exclusive": 796
    },
    {
      "start_ms": 217690,
      "end_ms": 219805,
      "text": "浑身淋透了才反应过来哟。",
      "token_start": 796,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 221450,
      "end_ms": 222105,
      "text": "下雨了，",
      "token_start": 807,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 223310,
      "end_ms": 224805,
      "text": "在厦大读了几年，",
      "token_start": 810,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 225130,
      "end_ms": 228195,
      "text": "他连一街之隔的鼓浪屿都没去过，",
      "token_start": 817,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 228640,
      "end_ms": 230365,
      "text": "一场电影都没看过。",
      "token_start": 831,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 232040,
      "end_ms": 236025,
      "text": "一九五三年提前毕业分配到北京四中，",
      "token_start": 839,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 236490,
      "end_ms": 241130,
      "text": "然后就是开头那一幕被辞退摆书摊。",
      "token_start": 855,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 241650,
      "end_ms": 243690,
      "text": "就在他人生最黑的时候，",
      "token_start": 870,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 244090,
      "end_ms": 247710,
      "text": "厦门大学校长王亚楠听说了这事儿，",
      "token_start": 880,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 248150,
      "end_ms": 249070,
      "text": "王亚楠是谁？",
      "token_start": 895,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 249390,
      "end_ms": 251050,
      "text": "资本论的中文译者，",
      "token_start": 900,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 251470,
      "end_ms": 252550,
      "text": "大经济学家，",
      "token_start": 908,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 252910,
      "end_ms": 255850,
      "text": "他专门从厦门跑到福州，",
      "token_start": 913,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 256290,
      "end_ms": 258330,
      "text": "一个下着冷雨的夜里，",
      "token_start": 923,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 258330,
      "end_ms": 260030,
      "text": "敲开了陈景润家的门。",
      "token_start": 932,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 260430,
      "end_ms": 261290,
      "text": "就说了一句，",
      "token_start": 941,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 261770,
      "end_ms": 263490,
      "text": "厦大需要你这样的人，",
      "token_start": 946,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 264050,
      "end_ms": 265050,
      "text": "就这一句话，",
      "token_start": 955,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 265290,
      "end_ms": 267030,
      "text": "把他从泥里拉了出来。",
      "token_start": 960,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 267530,
      "end_ms": 270180,
      "text": "王亚楠知道他不是教书的料，",
      "token_start": 969,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 270920,
      "end_ms": 272620,
      "text": "根本不让他上讲台，",
      "token_start": 981,
      "token_end_exclusive": 989
    },
    {
      "start_ms": 272920,
      "end_ms": 276440,
      "text": "直接安排到数学系资料室整理图书。",
      "token_start": 989,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 277120,
      "end_ms": 278720,
      "text": "别人觉得这活枯燥，",
      "token_start": 1004,
      "token_end_exclusive": 1012
    },
    {
      "start_ms": 279140,
      "end_ms": 280700,
      "text": "在陈景润眼里，",
      "token_start": 1012,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 281120,
      "end_ms": 282000,
      "text": "这是天堂，",
      "token_start": 1018,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 282600,
      "end_ms": 283560,
      "text": "没人兜扰，",
      "token_start": 1022,
      "token_end_exclusive": 1026
    },
    {
      "start_ms": 283920,
      "end_ms": 286080,
      "text": "天天有最新的数学书看。",
      "token_start": 1026,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 286720,
      "end_ms": 287980,
      "text": "就在资料室里，",
      "token_start": 1036,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 288100,
      "end_ms": 290620,
      "text": "他翻到了华罗庚的堆垒粟，",
      "token_start": 1042,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 290720,
      "end_ms": 293660,
      "text": "数论那本书厚的像砖头。",
      "token_start": 1053,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 293680,
      "end_ms": 295840,
      "text": "他干脆一页一页拆下来，",
      "token_start": 1063,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 295840,
      "end_ms": 297460,
      "text": "揣在兜里，",
      "token_start": 1073,
      "token_end_exclusive": 1077
    },
    {
      "start_ms": 297460,
      "end_ms": 299955,
      "text": "走到哪儿读到哪儿，",
      "token_start": 1077,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 300690,
      "end_ms": 302875,
      "text": "前前后后读了三十多遍，",
      "token_start": 1085,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 303620,
      "end_ms": 305795,
      "text": "几乎整本背了下来。",
      "token_start": 1095,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 306870,
      "end_ms": 307510,
      "text": "没多久，",
      "token_start": 1103,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 307690,
      "end_ms": 308950,
      "text": "他写了篇论文，",
      "token_start": 1106,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 309470,
      "end_ms": 311690,
      "text": "直接改进了华罗庚的成果，",
      "token_start": 1112,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 312490,
      "end_ms": 313670,
      "text": "论文转到北京。",
      "token_start": 1123,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 314090,
      "end_ms": 316470,
      "text": "华罗庚本人看完又惊又喜。",
      "token_start": 1129,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 316990,
      "end_ms": 320255,
      "text": "厦门大学资料室里还藏着这么一号人物。",
      "token_start": 1140,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 322280,
      "end_ms": 323280,
      "text": "一九五七年，",
      "token_start": 1157,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 323760,
      "end_ms": 328500,
      "text": "二十四岁的陈景润被调入中国科学院数学研究所。",
      "token_start": 1162,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 329160,
      "end_ms": 331660,
      "text": "所有人都以为进了中科院，",
      "token_start": 1183,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 332040,
      "end_ms": 334420,
      "text": "总算能过上科学家的日子了，",
      "token_start": 1194,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 334480,
      "end_ms": 336320,
      "text": "可现实又给了他一圈，",
      "token_start": 1206,
      "token_end_exclusive": 1215
    },
    {
      "start_ms": 337080,
      "end_ms": 341000,
      "text": "给他安排的住处是一间旧厕所改的小屋，",
      "token_start": 1215,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 341860,
      "end_ms": 342620,
      "text": "六平米，",
      "token_start": 1232,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 342780,
      "end_ms": 343620,
      "text": "一张小床，",
      "token_start": 1235,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 343980,
      "end_ms": 345120,
      "text": "一张窄书桌，",
      "token_start": 1239,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 345800,
      "end_ms": 347640,
      "text": "床头就挨着马桶。",
      "token_start": 1244,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 348480,
      "end_ms": 349980,
      "text": "夏天闷得像蒸笼，",
      "token_start": 1251,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 350460,
      "end_ms": 352990,
      "text": "冬天寒风从墙缝缝里往里灌，",
      "token_start": 1258,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 353430,
      "end_ms": 354150,
      "text": "冻得手，",
      "token_start": 1270,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 354190,
      "end_ms": 355090,
      "text": "都握不住笔。",
      "token_start": 1273,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 355430,
      "end_ms": 356630,
      "text": "他根本不在乎。",
      "token_start": 1278,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 357170,
      "end_ms": 359390,
      "text": "每天清早打一壶开水，",
      "token_start": 1284,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 359750,
      "end_ms": 361790,
      "text": "几个馒头钻进小屋，",
      "token_start": 1293,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 361790,
      "end_ms": 364330,
      "text": "就是一整天门都很少出，",
      "token_start": 1301,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 364590,
      "end_ms": 367535,
      "text": "屋里堆的满满当当全是草稿纸。",
      "token_start": 1311,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 367850,
      "end_ms": 369810,
      "text": "前前后后攒了几麻袋，",
      "token_start": 1324,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 370210,
      "end_ms": 373090,
      "text": "每张纸上都密密麻麻写满了公式。",
      "token_start": 1333,
      "token_end_exclusive": 1347
    },
    {
      "start_ms": 373290,
      "end_ms": 374895,
      "text": "为了哥德巴赫猜想，",
      "token_start": 1347,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 375170,
      "end_ms": 377350,
      "text": "他把之前的结论推翻了，",
      "token_start": 1355,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 377350,
      "end_ms": 378025,
      "text": "重来，",
      "token_start": 1365,
      "token_end_exclusive": 1367
    },
    {
      "start_ms": 378460,
      "end_ms": 379645,
      "text": "重来又推翻，",
      "token_start": 1367,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 380000,
      "end_ms": 381075,
      "text": "不知道多少遍，",
      "token_start": 1372,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 381800,
      "end_ms": 383105,
      "text": "身体越来越差，",
      "token_start": 1378,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 383440,
      "end_ms": 385215,
      "text": "一年得住好几次院，",
      "token_start": 1384,
      "token_end_exclusive": 1392
    },
    {
      "start_ms": 385670,
      "end_ms": 386825,
      "text": "科比停不下来，",
      "token_start": 1392,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 387450,
      "end_ms": 388530,
      "text": "医生给他扎针，",
      "token_start": 1398,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 388690,
      "end_ms": 391060,
      "text": "他特意叮嘱别扎右手，",
      "token_start": 1404,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 391200,
      "end_ms": 392275,
      "text": "我还得写字。",
      "token_start": 1413,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 393120,
      "end_ms": 394140,
      "text": "一九六六年，",
      "token_start": 1418,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 394360,
      "end_ms": 396440,
      "text": "他在科学通报上宣布，",
      "token_start": 1423,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 396780,
      "end_ms": 398895,
      "text": "我证明了一加二，",
      "token_start": 1432,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 399900,
      "end_ms": 401725,
      "text": "可那是个特殊的年代，",
      "token_start": 1439,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 402140,
      "end_ms": 404915,
      "text": "没人在意一个数学家说了什么，",
      "token_start": 1448,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 405310,
      "end_ms": 408025,
      "text": "这个足以震动世界的成果，",
      "token_start": 1461,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 408430,
      "end_ms": 411010,
      "text": "就这么悄无声息的沉了下去。",
      "token_start": 1472,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 411130,
      "end_ms": 412185,
      "text": "整整七年，",
      "token_start": 1484,
      "token_end_exclusive": 1488
    },
    {
      "start_ms": 412610,
      "end_ms": 414310,
      "text": "他一个人在那间，",
      "token_start": 1488,
      "token_end_exclusive": 1495
    },
    {
      "start_ms": 414310,
      "end_ms": 417950,
      "text": "六平米的小屋里把证明一遍一遍，",
      "token_start": 1495,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 417970,
      "end_ms": 419335,
      "text": "验算完善，",
      "token_start": 1509,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 419880,
      "end_ms": 421545,
      "text": "没人知道他在干什么，",
      "token_start": 1513,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 421790,
      "end_ms": 423275,
      "text": "没人理解他图什么。",
      "token_start": 1522,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 424960,
      "end_ms": 426425,
      "text": "直到一九七三年，",
      "token_start": 1530,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 426860,
      "end_ms": 429860,
      "text": "他把完整的证明发表在中国科学上。",
      "token_start": 1537,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 430300,
      "end_ms": 430940,
      "text": "这一次，",
      "token_start": 1552,
      "token_end_exclusive": 1555
    },
    {
      "start_ms": 431240,
      "end_ms": 435240,
      "text": "全世界都听到了一个被学校辞退，",
      "token_start": 1555,
      "token_end_exclusive": 1569
    },
    {
      "start_ms": 435680,
      "end_ms": 438300,
      "text": "在街头摆书摊的年轻人，",
      "token_start": 1569,
      "token_end_exclusive": 1579
    },
    {
      "start_ms": 438680,
      "end_ms": 440880,
      "text": "用挤麻袋草稿纸，",
      "token_start": 1579,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 441460,
      "end_ms": 444100,
      "text": "让全世界对中国数学刮目相看。",
      "token_start": 1586,
      "token_end_exclusive": 1599
    },
    {
      "start_ms": 444780,
      "end_ms": 446800,
      "text": "如果你也被他的故事打动了，",
      "token_start": 1599,
      "token_end_exclusive": 1611
    },
    {
      "start_ms": 446960,
      "end_ms": 447880,
      "text": "麻烦点个赞，",
      "token_start": 1611,
      "token_end_exclusive": 1616
    },
    {
      "start_ms": 447900,
      "end_ms": 450800,
      "text": "在评论区留下一句致敬陈景润，",
      "token_start": 1616,
      "token_end_exclusive": 1629
    },
    {
      "start_ms": 451420,
      "end_ms": 453260,
      "text": "再转发给身边的朋友，",
      "token_start": 1629,
      "token_end_exclusive": 1638
    },
    {
      "start_ms": 453740,
      "end_ms": 456105,
      "text": "让更多人知道这个名字，",
      "token_start": 1638,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 456790,
      "end_ms": 457410,
      "text": "关注我。",
      "token_start": 1648,
      "token_end_exclusive": 1651
    },
    {
      "start_ms": 457710,
      "end_ms": 461770,
      "text": "下集接着讲他成名之后发生了什么，",
      "token_start": 1651,
      "token_end_exclusive": 1666
    },
    {
      "start_ms": 462210,
      "end_ms": 463790,
      "text": "以及他生命，",
      "token_start": 1666,
      "token_end_exclusive": 1671
    },
    {
      "start_ms": 463930,
      "end_ms": 466675,
      "text": "最后那些让人心疼的日子。",
      "token_start": 1671,
      "token_end_exclusive": 1682
    }
  ],
