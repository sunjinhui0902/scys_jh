{
  "video_id": "v_0aec66ddf2b372c0",
  "duration_s": 496.257846,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_0aec66ddf2b372c0.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_0aec66ddf2b372c0.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 4890,
      "text": "您知道中国历史上最有文人气的名楼是哪一座吗？",
      "token_start": 0,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5330,
      "end_ms": 6870,
      "text": "有人说是滕王阁，",
      "token_start": 21,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7770,
      "end_ms": 9550,
      "text": "王勃二十岁出头，",
      "token_start": 28,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 9730,
      "end_ms": 11590,
      "text": "写了篇七百多字的文章，",
      "token_start": 35,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12010,
      "end_ms": 13750,
      "text": "直接火了一千多年。",
      "token_start": 45,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 14130,
      "end_ms": 15470,
      "text": "有人说是黄鹤楼，",
      "token_start": 53,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 16010,
      "end_ms": 17810,
      "text": "李白去了都只能叹气，",
      "token_start": 60,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 17930,
      "end_ms": 18590,
      "text": "放下笔，",
      "token_start": 69,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 18950,
      "end_ms": 22050,
      "text": "引得后来的文人墨客写了一千多首诗，",
      "token_start": 72,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 22510,
      "end_ms": 25530,
      "text": "错滕王阁连前两名都进不去。",
      "token_start": 88,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 26330,
      "end_ms": 27750,
      "text": "黄鹤楼也不是第一，",
      "token_start": 100,
      "token_end_exclusive": 108
    },
    {
      "start_ms": 28170,
      "end_ms": 32780,
      "text": "真正排在榜首的那座楼名弃天下皆知，",
      "token_start": 108,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 33260,
      "end_ms": 36380,
      "text": "但给他写下千古名篇的那位大文人，",
      "token_start": 124,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 36660,
      "end_ms": 37440,
      "text": "一辈子，",
      "token_start": 139,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 37720,
      "end_ms": 40440,
      "text": "连他的楼梯都没踩过一步。",
      "token_start": 142,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 40840,
      "end_ms": 42540,
      "text": "他隔着几百里山水，",
      "token_start": 153,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 43120,
      "end_ms": 45720,
      "text": "只凭手上一张画一封信，",
      "token_start": 161,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 46200,
      "end_ms": 53800,
      "text": "就把一座遭贬官员翻修的普通城楼写成了天下读书人千年不变的硬骨头。",
      "token_start": 171,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 54220,
      "end_ms": 59615,
      "text": "今天咱们就来盘点中国历史上十大最有文人气的名楼。",
      "token_start": 202,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 60290,
      "end_ms": 62300,
      "text": "老规矩开讲之前，",
      "token_start": 225,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 62440,
      "end_ms": 65065,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 232,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 65440,
      "end_ms": 67000,
      "text": "让我看看都是谁。",
      "token_start": 242,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 67040,
      "end_ms": 68745,
      "text": "在听第十名，",
      "token_start": 249,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 69150,
      "end_ms": 71235,
      "text": "甲秀楼、贵州贵阳。",
      "token_start": 254,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 71820,
      "end_ms": 73245,
      "text": "如果光看名气，",
      "token_start": 261,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 73620,
      "end_ms": 75735,
      "text": "他在全国真不算最小，",
      "token_start": 267,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 76430,
      "end_ms": 79225,
      "text": "可要论边远地方的文人古气，",
      "token_start": 276,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 79640,
      "end_ms": 80700,
      "text": "他必须排在头。",
      "token_start": 288,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 80700,
      "end_ms": 85305,
      "text": "一个三层挑檐的大楼二十多米高，",
      "token_start": 294,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 86090,
      "end_ms": 90285,
      "text": "稳稳立在南明河正中间的一块大巨石上，",
      "token_start": 308,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 91080,
      "end_ms": 92575,
      "text": "四周全是回廊。",
      "token_start": 325,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 93000,
      "end_ms": 95295,
      "text": "四百多年前的明朝万历年间，",
      "token_start": 331,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 96120,
      "end_ms": 98055,
      "text": "巡抚江东之嫌，",
      "token_start": 343,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 98510,
      "end_ms": 99695,
      "text": "贵州太偏僻，",
      "token_start": 349,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 100190,
      "end_ms": 101555,
      "text": "当地读书人太少，",
      "token_start": 354,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 102230,
      "end_ms": 107200,
      "text": "特意在核心的大石头上盖的这座楼起名叫柯贾，",
      "token_start": 361,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 107220,
      "end_ms": 107865,
      "text": "挺秀，",
      "token_start": 381,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 108310,
      "end_ms": 112275,
      "text": "就是盼着自家地盘上也能考出治国的大才。",
      "token_start": 383,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 112760,
      "end_ms": 114275,
      "text": "结果娄刚建好不久，",
      "token_start": 401,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 114590,
      "end_ms": 118370,
      "text": "贵州破天荒考出了历史上第一位文状元。",
      "token_start": 409,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 118390,
      "end_ms": 123855,
      "text": "赵以炯彻底打破了西南边地出不了大文人的老说法。",
      "token_start": 426,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 124330,
      "end_ms": 127765,
      "text": "引得后来的读书人在上面刻了上百首诗，",
      "token_start": 448,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 128240,
      "end_ms": 129260,
      "text": "一座楼带，",
      "token_start": 465,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 129260,
      "end_ms": 131195,
      "text": "忘了一整省的文器。",
      "token_start": 469,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 131630,
      "end_ms": 135655,
      "text": "您说他算不算文人气象的第一块基石？",
      "token_start": 477,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 136000,
      "end_ms": 136795,
      "text": "第九名，",
      "token_start": 493,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 137230,
      "end_ms": 138005,
      "text": "望江楼，",
      "token_start": 496,
      "token_end_exclusive": 499
    },
    {
      "start_ms": 138550,
      "end_ms": 143975,
      "text": "四川成都别的名楼写的都是士大夫升官治国，",
      "token_start": 499,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 144530,
      "end_ms": 147680,
      "text": "可这座楼里藏着的是一个才华，",
      "token_start": 518,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 147700,
      "end_ms": 150095,
      "text": "极高却一辈子命苦的女人。",
      "token_start": 531,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 150620,
      "end_ms": 153075,
      "text": "三十九米高整整四层，",
      "token_start": 542,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 153830,
      "end_ms": 155435,
      "text": "底下两层八个角，",
      "token_start": 551,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 155830,
      "end_ms": 157475,
      "text": "上面两层四个角，",
      "token_start": 558,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 158110,
      "end_ms": 163195,
      "text": "远远看过去全被一片绿油油的竹林包在里头。",
      "token_start": 565,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 163920,
      "end_ms": 166515,
      "text": "清代文人为了纪念女诗人薛涛，",
      "token_start": 584,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 167280,
      "end_ms": 171415,
      "text": "专门盖了这座楼薛涛一辈子最喜欢竹子。",
      "token_start": 597,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 172140,
      "end_ms": 174615,
      "text": "当年他在这里亲手做信纸，",
      "token_start": 614,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 175040,
      "end_ms": 176675,
      "text": "写了五百多首好诗，",
      "token_start": 625,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 177200,
      "end_ms": 180275,
      "text": "跟白居易他们一起写诗喝酒聊天，",
      "token_start": 633,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 180660,
      "end_ms": 184020,
      "text": "可他空有一肚子惊人的才学身份，",
      "token_start": 647,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 184180,
      "end_ms": 186925,
      "text": "却只是个身不由己的卖艺女子，",
      "token_start": 661,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 187450,
      "end_ms": 189390,
      "text": "到老也是守着满院子，",
      "token_start": 674,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 189390,
      "end_ms": 194245,
      "text": "竹子一个人凄凄凉凉活到死楼修的再好看，",
      "token_start": 683,
      "token_end_exclusive": 701
    },
    {
      "start_ms": 194650,
      "end_ms": 195705,
      "text": "人早就没了，",
      "token_start": 701,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 196230,
      "end_ms": 198765,
      "text": "但性质上当年滴下的眼泪，",
      "token_start": 706,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 199190,
      "end_ms": 200905,
      "text": "到现在还让人揪心。",
      "token_start": 717,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 201380,
      "end_ms": 204255,
      "text": "这就是一代才女望不尽的委屈。",
      "token_start": 725,
      "token_end_exclusive": 738
    },
    {
      "start_ms": 204610,
      "end_ms": 205395,
      "text": "第八名，",
      "token_start": 738,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 205770,
      "end_ms": 206425,
      "text": "太白楼，",
      "token_start": 741,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 206810,
      "end_ms": 209280,
      "text": "山东济宁全天下，",
      "token_start": 744,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 209380,
      "end_ms": 211615,
      "text": "纪念诗仙的地方数都数不清。",
      "token_start": 751,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 212320,
      "end_ms": 218315,
      "text": "但这一座楼记录了李白最狂也最接地气的二十多年。",
      "token_start": 763,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 218780,
      "end_ms": 221395,
      "text": "青砖灰瓦两层大屋顶，",
      "token_start": 785,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 221880,
      "end_ms": 223075,
      "text": "屋里宽敞的很，",
      "token_start": 794,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 223780,
      "end_ms": 225345,
      "text": "看似平平常常，",
      "token_start": 800,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 225960,
      "end_ms": 228915,
      "text": "底下枕着的可是京杭大运河的河水。",
      "token_start": 806,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 229390,
      "end_ms": 231410,
      "text": "当年李白在济宁安家落户，",
      "token_start": 821,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 231470,
      "end_ms": 232255,
      "text": "二十多年，",
      "token_start": 832,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 232710,
      "end_ms": 234390,
      "text": "天天泡在这家小酒楼，",
      "token_start": 836,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 234390,
      "end_ms": 237450,
      "text": "里端着大海碗喝酒喝高了。",
      "token_start": 845,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 237450,
      "end_ms": 241535,
      "text": "就在墙上狂写诗写下了整整五十多首好诗，",
      "token_start": 856,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 241880,
      "end_ms": 245975,
      "text": "后来街坊邻居干脆把这家饭馆改名叫太白楼，",
      "token_start": 874,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 246370,
      "end_ms": 247585,
      "text": "一千多年来，",
      "token_start": 893,
      "token_end_exclusive": 898
    },
    {
      "start_ms": 247970,
      "end_ms": 249725,
      "text": "不知多少考不上功名，",
      "token_start": 898,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 250340,
      "end_ms": 254845,
      "text": "心里堵得慌的书生特意跑来打上一脚烈酒，",
      "token_start": 907,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 255230,
      "end_ms": 256985,
      "text": "靠着栏杆往前看，",
      "token_start": 925,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 257420,
      "end_ms": 258815,
      "text": "学李白的仙气，",
      "token_start": 932,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 259230,
      "end_ms": 261490,
      "text": "人走楼还在酒，",
      "token_start": 938,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 261610,
      "end_ms": 267905,
      "text": "喝完了诗还在能在柴米油盐的小酒铺里把胸膛挺向天地。",
      "token_start": 944,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 268450,
      "end_ms": 270450,
      "text": "您说这算不算最烈的？",
      "token_start": 968,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 270450,
      "end_ms": 271370,
      "text": "一抹文人？",
      "token_start": 977,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 271430,
      "end_ms": 272025,
      "text": "骨气，",
      "token_start": 981,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 272410,
      "end_ms": 273065,
      "text": "第七名，",
      "token_start": 983,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 273420,
      "end_ms": 275255,
      "text": "大观楼云南昆明，",
      "token_start": 986,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 275530,
      "end_ms": 278750,
      "text": "他就在滇池水边单看那两层木楼，",
      "token_start": 993,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 278910,
      "end_ms": 280565,
      "text": "其实算不上多宏大，",
      "token_start": 1007,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 281230,
      "end_ms": 284065,
      "text": "但他凭着一个穷书生写的一幅字，",
      "token_start": 1015,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 284550,
      "end_ms": 289485,
      "text": "硬生生撑起了天下第一长联三间宽的门面，",
      "token_start": 1029,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 290280,
      "end_ms": 291405,
      "text": "紧挨着水面。",
      "token_start": 1047,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 292030,
      "end_ms": 293730,
      "text": "盖四周全是柳树，",
      "token_start": 1052,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 294150,
      "end_ms": 298710,
      "text": "清朝乾隆年间一辈子没考上官的穷书生。",
      "token_start": 1059,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 298770,
      "end_ms": 300750,
      "text": "孙然翁走上楼，",
      "token_start": 1076,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 301410,
      "end_ms": 303670,
      "text": "看着五百里滇池浪打浪，",
      "token_start": 1082,
      "token_end_exclusive": 1092
    },
    {
      "start_ms": 304170,
      "end_ms": 308049,
      "text": "再回头想想千百年来历朝历代的兴衰变化，",
      "token_start": 1092,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 308590,
      "end_ms": 313030,
      "text": "一口气在墙上写下一百八十个字的大长联前，",
      "token_start": 1110,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 313070,
      "end_ms": 315050,
      "text": "半截写进了云南的大山，",
      "token_start": 1129,
      "token_end_exclusive": 1139
    },
    {
      "start_ms": 315050,
      "end_ms": 320190,
      "text": "大水后半截把汉唐宋元那些大关将军的下场全说明白了。",
      "token_start": 1139,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 320190,
      "end_ms": 323500,
      "text": "一个截的地峰应当想的布衣百姓，",
      "token_start": 1163,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 324140,
      "end_ms": 326020,
      "text": "单凭手里一杆毛笔，",
      "token_start": 1177,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 326480,
      "end_ms": 327040,
      "text": "文采，",
      "token_start": 1185,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 327060,
      "end_ms": 331400,
      "text": "就压过了历代王爷大官的奉承画名字，",
      "token_start": 1187,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 331500,
      "end_ms": 332300,
      "text": "只是大官，",
      "token_start": 1203,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 332840,
      "end_ms": 335720,
      "text": "胸膛里却装得下几百年历史，",
      "token_start": 1207,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 336440,
      "end_ms": 338700,
      "text": "这是何等的胸襟与做派。",
      "token_start": 1219,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 339120,
      "end_ms": 339900,
      "text": "第六名，",
      "token_start": 1229,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 340340,
      "end_ms": 341220,
      "text": "鹳雀楼，",
      "token_start": 1232,
      "token_end_exclusive": 1235
    },
    {
      "start_ms": 341580,
      "end_ms": 344400,
      "text": "山西永济讲到这里，",
      "token_start": 1235,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 344760,
      "end_ms": 347740,
      "text": "上级的分量就真正沉下来了。",
      "token_start": 1243,
      "token_end_exclusive": 1255
    },
    {
      "start_ms": 348140,
      "end_ms": 350980,
      "text": "整整三层高楼七十多米，",
      "token_start": 1255,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 350980,
      "end_ms": 352960,
      "text": "高高高高立在岸边，",
      "token_start": 1265,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 353300,
      "end_ms": 355855,
      "text": "直冲冲盯着底下翻滚的黄河。",
      "token_start": 1273,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 356340,
      "end_ms": 357825,
      "text": "一千三百多年前，",
      "token_start": 1285,
      "token_end_exclusive": 1292
    },
    {
      "start_ms": 358390,
      "end_ms": 361325,
      "text": "唐代诗人王之涣爬上这座楼，",
      "token_start": 1292,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 361820,
      "end_ms": 364815,
      "text": "看着天边的落日和滚滚黄河，",
      "token_start": 1304,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 365290,
      "end_ms": 367515,
      "text": "只用了二十个大白话字，",
      "token_start": 1316,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 368100,
      "end_ms": 369415,
      "text": "白日依山尽，",
      "token_start": 1326,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 369770,
      "end_ms": 370985,
      "text": "黄河入海流，",
      "token_start": 1331,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 371440,
      "end_ms": 372745,
      "text": "欲穷千里目，",
      "token_start": 1336,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 373220,
      "end_ms": 374385,
      "text": "更上一层楼。",
      "token_start": 1341,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 375050,
      "end_ms": 379495,
      "text": "就把中国文人登高望远的境界推到了顶峰。",
      "token_start": 1346,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 380050,
      "end_ms": 381265,
      "text": "后来的几百年里，",
      "token_start": 1364,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 381940,
      "end_ms": 383100,
      "text": "打仗的大火把，",
      "token_start": 1371,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 383100,
      "end_ms": 384245,
      "text": "它烧成焦土，",
      "token_start": 1377,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 384860,
      "end_ms": 386870,
      "text": "滔滔黄河水几回，",
      "token_start": 1382,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 386890,
      "end_ms": 388335,
      "text": "把地基冲的稀烂。",
      "token_start": 1389,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 388940,
      "end_ms": 391975,
      "text": "唐朝的那座老楼连块砖头都没剩下，",
      "token_start": 1396,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 392370,
      "end_ms": 394925,
      "text": "可哪怕楼没了整整七百年，",
      "token_start": 1411,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 395350,
      "end_ms": 396985,
      "text": "只要那二十个字还在，",
      "token_start": 1422,
      "token_end_exclusive": 1431
    },
    {
      "start_ms": 397610,
      "end_ms": 400365,
      "text": "每一个中国人路过黄河边，",
      "token_start": 1431,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 400780,
      "end_ms": 404035,
      "text": "脑子里就能立刻立起一座大唐的高楼。",
      "token_start": 1442,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 404450,
      "end_ms": 406595,
      "text": "木头盖的楼早晚会烧毁，",
      "token_start": 1458,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 407040,
      "end_ms": 410645,
      "text": "唯有文人写下的诗能在大地上活一万年。",
      "token_start": 1468,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 411050,
      "end_ms": 412890,
      "text": "您说这算不算最硬的？",
      "token_start": 1485,
      "token_end_exclusive": 1494
    },
    {
      "start_ms": 412930,
      "end_ms": 415955,
      "text": "文人一锤从第十到第六名，",
      "token_start": 1494,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 416340,
      "end_ms": 419325,
      "text": "甲秀楼点醒了贵州的读书苗子。",
      "token_start": 1505,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 419990,
      "end_ms": 423185,
      "text": "望江楼藏着才女一世的叹气，",
      "token_start": 1518,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 423870,
      "end_ms": 426925,
      "text": "太白楼灌饱了李白满肚子的烈酒。",
      "token_start": 1530,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 427500,
      "end_ms": 430785,
      "text": "大观楼用一百八十个字道破历史，",
      "token_start": 1544,
      "token_end_exclusive": 1558
    },
    {
      "start_ms": 431240,
      "end_ms": 431960,
      "text": "鹳雀楼，",
      "token_start": 1558,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 432000,
      "end_ms": 433755,
      "text": "哪怕被烧成焦土，",
      "token_start": 1561,
      "token_end_exclusive": 1568
    },
    {
      "start_ms": 434560,
      "end_ms": 438185,
      "text": "依然用二十个字撑起大唐门面，",
      "token_start": 1568,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 438820,
      "end_ms": 441655,
      "text": "可他们还不是最有文人气的。",
      "token_start": 1581,
      "token_end_exclusive": 1593
    },
    {
      "start_ms": 442200,
      "end_ms": 444605,
      "text": "接下来第五道第一名更不寻常。",
      "token_start": 1593,
      "token_end_exclusive": 1606
    },
    {
      "start_ms": 445180,
      "end_ms": 448725,
      "text": "有一座楼历史上被大火烧光，",
      "token_start": 1606,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 449140,
      "end_ms": 451215,
      "text": "又重建了整整二十九次。",
      "token_start": 1618,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 452050,
      "end_ms": 454975,
      "text": "王勃当年靠着柱子写下的绝唱，",
      "token_start": 1628,
      "token_end_exclusive": 1641
    },
    {
      "start_ms": 455580,
      "end_ms": 458595,
      "text": "今天连一根旧木料都没留下。",
      "token_start": 1641,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 459340,
      "end_ms": 460440,
      "text": "有一座江边，",
      "token_start": 1653,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 460480,
      "end_ms": 463690,
      "text": "鼓楼引来几百位顶尖文豪，",
      "token_start": 1658,
      "token_end_exclusive": 1669
    },
    {
      "start_ms": 463850,
      "end_ms": 466175,
      "text": "在大墙上斗了一千多年的诗，",
      "token_start": 1669,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 466900,
      "end_ms": 468875,
      "text": "连李白都不敢轻易动笔。",
      "token_start": 1681,
      "token_end_exclusive": 1691
    },
    {
      "start_ms": 469470,
      "end_ms": 473885,
      "text": "可排在榜首的那座写下千古名篇的大文豪，",
      "token_start": 1691,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 474230,
      "end_ms": 476730,
      "text": "一辈子连他的门槛都没迈过，",
      "token_start": 1709,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 476930,
      "end_ms": 477695,
      "text": "他是哪做？",
      "token_start": 1721,
      "token_end_exclusive": 1725
    },
    {
      "start_ms": 478130,
      "end_ms": 482065,
      "text": "他凭什么能排在黄鹤楼和滕门阁的前头？",
      "token_start": 1725,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 482480,
      "end_ms": 484545,
      "text": "下一集已经同步更新，",
      "token_start": 1742,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 485180,
      "end_ms": 486720,
      "text": "现在直接点开我的头像，",
      "token_start": 1751,
      "token_end_exclusive": 1761
    },
    {
      "start_ms": 486880,
      "end_ms": 487715,
      "text": "进入主页，",
      "token_start": 1761,
      "token_end_exclusive": 1765
    },
    {
      "start_ms": 488210,
      "end_ms": 491375,
      "text": "第一条视频就是下一集点个关注，",
      "token_start": 1765,
      "token_end_exclusive": 1779
    },
    {
      "start_ms": 491640,
      "end_ms": 495935,
      "text": "看看谁才是中国历史上最有文人气的名楼之首。",
      "token_start": 1779,
      "token_end_exclusive": 1799
    }
  ],
