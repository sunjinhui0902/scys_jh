{
  "video_id": "v_402b90550a5a3599",
  "duration_s": 305.272993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_402b90550a5a3599.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_402b90550a5a3599.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 440,
      "end_ms": 1140,
      "text": "你敢信吗？",
      "token_start": 0,
      "token_end_exclusive": 4
    },
    {
      "start_ms": 1260,
      "end_ms": 3940,
      "text": "九月三号汽车开始不需要人了。",
      "token_start": 4,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4180,
      "end_ms": 5900,
      "text": "特斯拉cyber cub在这一天，",
      "token_start": 17,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 6000,
      "end_ms": 7900,
      "text": "美国奥斯汀发布量产。",
      "token_start": 26,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 8280,
      "end_ms": 10060,
      "text": "它最疯狂的地方是什么？",
      "token_start": 35,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 10300,
      "end_ms": 11200,
      "text": "没有方向盘，",
      "token_start": 45,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 11380,
      "end_ms": 12160,
      "text": "没有油门，",
      "token_start": 50,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 12340,
      "end_ms": 13480,
      "text": "没有刹车踏板，",
      "token_start": 54,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 13660,
      "end_ms": 14920,
      "text": "但是比这个更疯狂的。",
      "token_start": 60,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 14920,
      "end_ms": 17240,
      "text": "是它还能每天替你挣钱。",
      "token_start": 69,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 17760,
      "end_ms": 18200,
      "text": "朱军，",
      "token_start": 79,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 18420,
      "end_ms": 21440,
      "text": "我们正在见证人类历史上最疯狂的一件事，",
      "token_start": 81,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 21840,
      "end_ms": 25060,
      "text": "汽车行业一百年来的逻辑全部要推倒重来。",
      "token_start": 99,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 25420,
      "end_ms": 27400,
      "text": "我在美国体验过这种FSD,",
      "token_start": 117,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 27600,
      "end_ms": 29200,
      "text": "从车库自己启动发车，",
      "token_start": 127,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 29320,
      "end_ms": 32310,
      "text": "从洛杉矶一直开到拉斯维加斯期间，",
      "token_start": 136,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 32310,
      "end_ms": 34070,
      "text": "穿过很多拥挤的人潮车流，",
      "token_start": 151,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 34250,
      "end_ms": 35150,
      "text": "走过小巷子，",
      "token_start": 162,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 35150,
      "end_ms": 36050,
      "text": "也走过高速，",
      "token_start": 167,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 36290,
      "end_ms": 38870,
      "text": "一直到最后自动泊车全过程。",
      "token_start": 172,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 38870,
      "end_ms": 40410,
      "text": "我没有碰方向盘一下，",
      "token_start": 184,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 40950,
      "end_ms": 44670,
      "text": "但是这个老板的车型还是可以手碰方向盘介入的。",
      "token_start": 193,
      "token_end_exclusive": 214
    },
    {
      "start_ms": 44790,
      "end_ms": 46570,
      "text": "而最新发布的cyer cub,",
      "token_start": 214,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 46690,
      "end_ms": 47470,
      "text": "你坐进去，",
      "token_start": 222,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 47670,
      "end_ms": 48850,
      "text": "想开都开不了。",
      "token_start": 226,
      "token_end_exclusive": 232
    },
    {
      "start_ms": 49290,
      "end_ms": 51970,
      "text": "其实一开始我特别担心这种自动驾驶的安全，",
      "token_start": 232,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 52090,
      "end_ms": 56150,
      "text": "但是后来我想为什么飞机早就可以高速的自动驾驶，",
      "token_start": 251,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 56290,
      "end_ms": 58850,
      "text": "我们却迟迟不敢接受汽车、无人驾驶？",
      "token_start": 273,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 59270,
      "end_ms": 59630,
      "text": "其实，",
      "token_start": 288,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 59630,
      "end_ms": 61600,
      "text": "我们真正舍不得的不是方向盘，",
      "token_start": 290,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 61680,
      "end_ms": 63925,
      "text": "而是我在掌控一切的幻觉。",
      "token_start": 303,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 64260,
      "end_ms": 67265,
      "text": "很多人就喜欢自己亲自开车的这种掌控感。",
      "token_start": 314,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 67810,
      "end_ms": 69570,
      "text": "其实这次啊有没有方向盘，",
      "token_start": 332,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 69570,
      "end_ms": 70965,
      "text": "并不是它真正的重点，",
      "token_start": 343,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 71300,
      "end_ms": 74325,
      "text": "它的重点其实是他可以自己出去挣钱了。",
      "token_start": 352,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 74740,
      "end_ms": 78504,
      "text": "它意味着未来的汽车商业模式可能发生根本性的变化。",
      "token_start": 369,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 78790,
      "end_ms": 80970,
      "text": "今天是人挣钱养车，",
      "token_start": 392,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 81170,
      "end_ms": 83745,
      "text": "而未来将是车出去挣钱养人。",
      "token_start": 400,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 84080,
      "end_ms": 84680,
      "text": "你睡觉，",
      "token_start": 412,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 84820,
      "end_ms": 85775,
      "text": "他出去接客，",
      "token_start": 415,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 86030,
      "end_ms": 87670,
      "text": "你上班他出去接客，",
      "token_start": 420,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 87790,
      "end_ms": 89010,
      "text": "你出差旅行一周，",
      "token_start": 428,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 89010,
      "end_ms": 89670,
      "text": "等你回来。",
      "token_start": 435,
      "token_end_exclusive": 439
    },
    {
      "start_ms": 89670,
      "end_ms": 91385,
      "text": "他不仅没有在停车场吃灰，",
      "token_start": 439,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 91630,
      "end_ms": 93675,
      "text": "可能已经替你跑了一个礼拜的生意。",
      "token_start": 450,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 94200,
      "end_ms": 95400,
      "text": "过去的一百多年里，",
      "token_start": 465,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 95400,
      "end_ms": 97355,
      "text": "汽车都是一件很奇怪的资产，",
      "token_start": 473,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 97680,
      "end_ms": 99080,
      "text": "你花了很多钱买它，",
      "token_start": 485,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 99360,
      "end_ms": 102015,
      "text": "然后它绝大多数时间什么都不干。",
      "token_start": 493,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 102550,
      "end_ms": 106685,
      "text": "但是这一次买车第一次从消费行为变成了投资行为，",
      "token_start": 507,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 106980,
      "end_ms": 108675,
      "text": "每天都给你这个现金流，",
      "token_start": 529,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 109030,
      "end_ms": 110690,
      "text": "甚至你贷款买了一辆车，",
      "token_start": 539,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 110870,
      "end_ms": 112870,
      "text": "然后让这辆车自己挣钱，",
      "token_start": 549,
      "token_end_exclusive": 559
    },
    {
      "start_ms": 112870,
      "end_ms": 113825,
      "text": "还自己的贷款。",
      "token_start": 559,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 114130,
      "end_ms": 114965,
      "text": "那问题就来了，",
      "token_start": 565,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 115250,
      "end_ms": 116815,
      "text": "如果买一辆车能够挣钱，",
      "token_start": 571,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 117110,
      "end_ms": 118870,
      "text": "那富人就可以买一百台，",
      "token_start": 581,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 118990,
      "end_ms": 119745,
      "text": "买一千台。",
      "token_start": 591,
      "token_end_exclusive": 595
    },
    {
      "start_ms": 120080,
      "end_ms": 123840,
      "text": "那么AI时代最大的贫富差距就不是人与人的能力差距，",
      "token_start": 595,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 123900,
      "end_ms": 126915,
      "text": "而是人与人拥有机器数量差距。",
      "token_start": 618,
      "token_end_exclusive": 631
    },
    {
      "start_ms": 127560,
      "end_ms": 128420,
      "text": "马斯克就认为，",
      "token_start": 631,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 128420,
      "end_ms": 134165,
      "text": "人类今天最大的浪费之一可能就是在停车场里面那几十亿辆一动不动的汽车，",
      "token_start": 637,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 134610,
      "end_ms": 136545,
      "text": "我们花好几十万买一台机器，",
      "token_start": 670,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 136850,
      "end_ms": 139705,
      "text": "结果他一生绝大多数时间都在睡觉，",
      "token_start": 682,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 140210,
      "end_ms": 142670,
      "text": "cyer cub.真正要改变的不是驾驶效率，",
      "token_start": 697,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 142670,
      "end_ms": 144015,
      "text": "而是资产利用率。",
      "token_start": 711,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 144610,
      "end_ms": 146070,
      "text": "他还专门提到cyer cub,",
      "token_start": 718,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 146070,
      "end_ms": 149515,
      "text": "连传统的充电插头都不需要采用感应式充电，",
      "token_start": 726,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 149780,
      "end_ms": 151565,
      "text": "汽车自己过去充电。",
      "token_start": 745,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 151850,
      "end_ms": 153195,
      "text": "你就想象一下这个画面啊，",
      "token_start": 753,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 153400,
      "end_ms": 155745,
      "text": "你买这辆车不需要专门跑的四s店，",
      "token_start": 764,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 156030,
      "end_ms": 157395,
      "text": "你在家用手机下单，",
      "token_start": 779,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 157670,
      "end_ms": 161205,
      "text": "这台车能够自己从工厂自己开到你家门口，",
      "token_start": 787,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 161540,
      "end_ms": 163175,
      "text": "他平常自己出去跑单，",
      "token_start": 805,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 163470,
      "end_ms": 164615,
      "text": "自己找地方充电，",
      "token_start": 814,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 164870,
      "end_ms": 165750,
      "text": "甚至车坏了，",
      "token_start": 821,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 165750,
      "end_ms": 166895,
      "text": "他自己开出去修，",
      "token_start": 826,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 167450,
      "end_ms": 169535,
      "text": "哪怕车就停在停车场里不动。",
      "token_start": 833,
      "token_end_exclusive": 845
    },
    {
      "start_ms": 169820,
      "end_ms": 172245,
      "text": "车上的AS算力还能够进入到全球网络，",
      "token_start": 845,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 172470,
      "end_ms": 174230,
      "text": "跑科学计算和渲染任务，",
      "token_start": 861,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 174350,
      "end_ms": 176225,
      "text": "停在车位上都能给你赚钱。",
      "token_start": 871,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 176540,
      "end_ms": 180945,
      "text": "车从贬值的负债瞬间变成了二十四小时给你打工的资产。",
      "token_start": 882,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 181290,
      "end_ms": 182290,
      "text": "而且你能想象吗？",
      "token_start": 906,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 182290,
      "end_ms": 185205,
      "text": "这辆车的成本直接低到打同行范围，",
      "token_start": 913,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 185580,
      "end_ms": 188680,
      "text": "当前量产成本大约只需要两万美元左右，",
      "token_start": 928,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 188760,
      "end_ms": 191025,
      "text": "远期目标压到一点八万美元，",
      "token_start": 945,
      "token_end_exclusive": 957
    },
    {
      "start_ms": 191240,
      "end_ms": 193015,
      "text": "折合人民币才十三万出头。",
      "token_start": 957,
      "token_end_exclusive": 968
    },
    {
      "start_ms": 193330,
      "end_ms": 194745,
      "text": "别人车上几个雷达的钱，",
      "token_start": 968,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 195170,
      "end_ms": 199385,
      "text": "而且这款车竟然是全球首款面向多行星设计的量产车。",
      "token_start": 978,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 199740,
      "end_ms": 201560,
      "text": "他设计一开始就考虑到以后，",
      "token_start": 1001,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 201700,
      "end_ms": 203400,
      "text": "火星基地建好运过去，",
      "token_start": 1013,
      "token_end_exclusive": 1022
    },
    {
      "start_ms": 203420,
      "end_ms": 204545,
      "text": "不用重新适配，",
      "token_start": 1022,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 204750,
      "end_ms": 206885,
      "text": "直接能在火星月球表面去跑。",
      "token_start": 1028,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 207160,
      "end_ms": 208960,
      "text": "因为这个车是纯视觉系统，",
      "token_start": 1040,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 209040,
      "end_ms": 209800,
      "text": "不靠雷达，",
      "token_start": 1051,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 209900,
      "end_ms": 210975,
      "text": "全靠摄像头。",
      "token_start": 1055,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 211350,
      "end_ms": 214035,
      "text": "但我觉得这恰恰是美国他们很矛盾的一点。",
      "token_start": 1060,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 214220,
      "end_ms": 214905,
      "text": "你有没有想过，",
      "token_start": 1078,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 215170,
      "end_ms": 216990,
      "text": "一个最怕摄像头的国家，",
      "token_start": 1084,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 217170,
      "end_ms": 219585,
      "text": "正在造一辆浑身都是摄像头的汽车？",
      "token_start": 1094,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 220140,
      "end_ms": 222520,
      "text": "美国很多公路今天都没有装摄像头，",
      "token_start": 1109,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 222660,
      "end_ms": 224635,
      "text": "理由就是保护公众隐私。",
      "token_start": 1124,
      "token_end_exclusive": 1134
    },
    {
      "start_ms": 224970,
      "end_ms": 228045,
      "text": "但是他们为什么却能够接受一辆浑身摄像头的汽车？",
      "token_start": 1134,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 228510,
      "end_ms": 232365,
      "text": "有人说啊这种自动驾驶我们早就有了有什么稀奇的朱晶，",
      "token_start": 1156,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 232740,
      "end_ms": 234245,
      "text": "我们要特别警惕一种心态。",
      "token_start": 1180,
      "token_end_exclusive": 1191
    },
    {
      "start_ms": 234620,
      "end_ms": 236300,
      "text": "一看到国外有什么新技术，",
      "token_start": 1191,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 236300,
      "end_ms": 237715,
      "text": "第一反应不是研究它，",
      "token_start": 1202,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 237910,
      "end_ms": 241130,
      "text": "而是赶紧证明我们早就有了这种情绪呢，",
      "token_start": 1211,
      "token_end_exclusive": 1228
    },
    {
      "start_ms": 241130,
      "end_ms": 242495,
      "text": "会把问题给聊窄了。",
      "token_start": 1228,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 242800,
      "end_ms": 243060,
      "text": "其实，",
      "token_start": 1236,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 243060,
      "end_ms": 246400,
      "text": "自动驾驶今年最大的瓶颈可能早已不是我们有没有，",
      "token_start": 1238,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 246560,
      "end_ms": 250630,
      "text": "而是一个社会敢不敢把方向盘交给算法截实。",
      "token_start": 1260,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 250630,
      "end_ms": 251270,
      "text": "截至目前，",
      "token_start": 1279,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 251290,
      "end_ms": 256750,
      "text": "特斯拉的FSD也只在美国、加拿大、澳大利亚、新西兰等等十几个国家和地区推出，",
      "token_start": 1283,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 256990,
      "end_ms": 259275,
      "text": "欧洲的大部分国家都是不允许的，",
      "token_start": 1315,
      "token_end_exclusive": 1329
    },
    {
      "start_ms": 259600,
      "end_ms": 260215,
      "text": "为什么呢？",
      "token_start": 1329,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 260610,
      "end_ms": 262655,
      "text": "为什么很多国家推进的这么谨慎呢？",
      "token_start": 1333,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 262910,
      "end_ms": 264310,
      "text": "自动驾驶最难解决的，",
      "token_start": 1348,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 264310,
      "end_ms": 268015,
      "text": "其实是出了事故算谁的这是最大的社会难题之一。",
      "token_start": 1357,
      "token_end_exclusive": 1378
    },
    {
      "start_ms": 268260,
      "end_ms": 269205,
      "text": "车主负责吗？",
      "token_start": 1378,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 269480,
      "end_ms": 270355,
      "text": "路人负责吗？",
      "token_start": 1383,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 270670,
      "end_ms": 271365,
      "text": "特斯拉负责，",
      "token_start": 1388,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 271790,
      "end_ms": 273045,
      "text": "软件工程师负责，",
      "token_start": 1393,
      "token_end_exclusive": 1400
    },
    {
      "start_ms": 273330,
      "end_ms": 274985,
      "text": "还是让保险公司负责？",
      "token_start": 1400,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 275350,
      "end_ms": 277790,
      "text": "这不是技术部门能够单独回答的问题，",
      "token_start": 1409,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 277870,
      "end_ms": 281760,
      "text": "而是整个法律体系都要重新定义无人驾驶。",
      "token_start": 1425,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 281760,
      "end_ms": 284460,
      "text": "真正需要升级的不只是汽车的操作系统，",
      "token_start": 1443,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 284500,
      "end_ms": 286055,
      "text": "还有整个社会的操作系统。",
      "token_start": 1460,
      "token_end_exclusive": 1471
    },
    {
      "start_ms": 286390,
      "end_ms": 288530,
      "text": "如今啊我们这一代人最大的震撼，",
      "token_start": 1471,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 288690,
      "end_ms": 290975,
      "text": "也许不是见证了多少新东西诞生，",
      "token_start": 1485,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 291260,
      "end_ms": 294070,
      "text": "而是不断亲眼看见童年时代，",
      "token_start": 1499,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 294070,
      "end_ms": 295975,
      "text": "坚信不会改变的那些东西，",
      "token_start": 1511,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 296270,
      "end_ms": 298125,
      "text": "一件一件成为过去的历史。",
      "token_start": 1522,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 298500,
      "end_ms": 300145,
      "text": "有一天你突然回头发现，",
      "token_start": 1533,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 300510,
      "end_ms": 301815,
      "text": "未来已经到了，",
      "token_start": 1543,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 302070,
      "end_ms": 304775,
      "text": "只不过我们的想象力还停留在昨天。",
      "token_start": 1549,
      "token_end_exclusive": 1564
    }
  ],
