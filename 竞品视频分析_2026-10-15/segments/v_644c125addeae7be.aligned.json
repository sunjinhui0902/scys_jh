  "segments": [
    {
      "start_ms": 280,
      "end_ms": 2440,
      "text": "为什么有些坏人很容易长寿，",
      "token_start": 0,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 2660,
      "end_ms": 4900,
      "text": "而好人他就不长寿呢？",
      "token_start": 12,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5440,
      "end_ms": 7180,
      "text": "其实啊这个很容易解释，",
      "token_start": 21,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 7440,
      "end_ms": 9500,
      "text": "因为坏人不内耗、不焦虑，",
      "token_start": 31,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 9500,
      "end_ms": 10940,
      "text": "不纠结、不伤心，",
      "token_start": 41,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 11340,
      "end_ms": 12380,
      "text": "更不会共情，",
      "token_start": 47,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 12980,
      "end_ms": 14060,
      "text": "承受心事就少，",
      "token_start": 52,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 14240,
      "end_ms": 15060,
      "text": "压力就小，",
      "token_start": 58,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 15300,
      "end_ms": 17160,
      "text": "身体气血就很好。",
      "token_start": 62,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 17520,
      "end_ms": 19440,
      "text": "而好人呢为人善良，",
      "token_start": 69,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 19780,
      "end_ms": 20580,
      "text": "责任心强，",
      "token_start": 77,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21020,
      "end_ms": 22540,
      "text": "凡事总替别人着想，",
      "token_start": 81,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 22920,
      "end_ms": 23980,
      "text": "多愁善感，",
      "token_start": 89,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 24260,
      "end_ms": 25120,
      "text": "郁郁寡欢，",
      "token_start": 93,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 25820,
      "end_ms": 27220,
      "text": "承受太多的压力，",
      "token_start": 97,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 27400,
      "end_ms": 29795,
      "text": "身体消耗自然也就不小。",
      "token_start": 104,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 30510,
      "end_ms": 32190,
      "text": "所以啊民间有句俗语，",
      "token_start": 114,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 32470,
      "end_ms": 33550,
      "text": "好人不长寿，",
      "token_start": 123,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 33930,
      "end_ms": 37545,
      "text": "坏人活千年。",
      "token_start": 128,
      "token_end_exclusive": 133
    }
