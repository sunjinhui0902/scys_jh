{
  "video_id": "v_546665fe45b7f450",
  "duration_s": 292.407007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_546665fe45b7f450.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_546665fe45b7f450.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 770,
      "text": "好好好，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 1430,
      "end_ms": 2530,
      "text": "谁学一声狗叫，",
      "token_start": 3,
      "token_end_exclusive": 9
    },
    {
      "start_ms": 2730,
      "end_ms": 4135,
      "text": "我就给谁一千块钱。",
      "token_start": 9,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 7120,
      "end_ms": 9440,
      "text": "今天有个业务要和供应商那边对接，",
      "token_start": 17,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 9980,
      "end_ms": 11160,
      "text": "我有别的事情要忙，",
      "token_start": 32,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 11200,
      "end_ms": 12600,
      "text": "你俩就替我去一趟吧。",
      "token_start": 40,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 12940,
      "end_ms": 13260,
      "text": "好的，",
      "token_start": 49,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 13260,
      "end_ms": 15040,
      "text": "王姐保证完成任务哦。",
      "token_start": 51,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 15400,
      "end_ms": 15640,
      "text": "哦，",
      "token_start": 60,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 15660,
      "end_ms": 16060,
      "text": "对了，",
      "token_start": 61,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 16680,
      "end_ms": 19160,
      "text": "供应商那边的陈姐可是个厉害角色，",
      "token_start": 63,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 19360,
      "end_ms": 20685,
      "text": "别被人家拿捏喽。",
      "token_start": 78,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 24760,
      "end_ms": 26140,
      "text": "师傅能不能快点啊，",
      "token_start": 85,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 26140,
      "end_ms": 27020,
      "text": "我们有急事儿，",
      "token_start": 93,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 27020,
      "end_ms": 27360,
      "text": "哎呀，",
      "token_start": 99,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 27380,
      "end_ms": 28720,
      "text": "慢点安全不差。",
      "token_start": 101,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 28720,
      "end_ms": 33370,
      "text": "这一会儿师傅麻烦快点，",
      "token_start": 107,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 33410,
      "end_ms": 34790,
      "text": "我早上吃坏了东西，",
      "token_start": 117,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 35570,
      "end_ms": 36870,
      "text": "感觉要憋不住了。",
      "token_start": 125,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 37290,
      "end_ms": 37710,
      "text": "哎呦，",
      "token_start": 132,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 38210,
      "end_ms": 38730,
      "text": "小姑娘，",
      "token_start": 134,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 38730,
      "end_ms": 39430,
      "text": "你忍住哈，",
      "token_start": 137,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 39690,
      "end_ms": 40510,
      "text": "马上就到了，",
      "token_start": 141,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 40530,
      "end_ms": 46900,
      "text": "马上到人家这儿拜访也不能空着手吧，",
      "token_start": 146,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 46920,
      "end_ms": 48220,
      "text": "走咱们看看去买点礼物。",
      "token_start": 162,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 48480,
      "end_ms": 48940,
      "text": "好的，",
      "token_start": 172,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 49020,
      "end_ms": 51860,
      "text": "我觉得也是听说这个陈姐爱打羽毛球，",
      "token_start": 174,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 52260,
      "end_ms": 53580,
      "text": "那这个球拍正合适，",
      "token_start": 190,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 53960,
      "end_ms": 55260,
      "text": "一千多块够档次。",
      "token_start": 198,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 56700,
      "end_ms": 58060,
      "text": "那我买盒羽毛球吧，",
      "token_start": 205,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 58140,
      "end_ms": 58900,
      "text": "也是一千多，",
      "token_start": 213,
      "token_end_exclusive": 218
    },
    {
      "start_ms": 59680,
      "end_ms": 62105,
      "text": "陈姐肯定喜欢我这个高档球拍，",
      "token_start": 218,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 62510,
      "end_ms": 63510,
      "text": "羽毛球买这么贵的，",
      "token_start": 231,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 63510,
      "end_ms": 64890,
      "text": "干啥不都一个样吗？",
      "token_start": 239,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 64910,
      "end_ms": 66950,
      "text": "哟感谢两位百忙中，",
      "token_start": 247,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 66950,
      "end_ms": 67610,
      "text": "来我们这儿，",
      "token_start": 255,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 67610,
      "end_ms": 69390,
      "text": "欢迎欢迎陈姐，",
      "token_start": 260,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 69530,
      "end_ms": 70365,
      "text": "您真客气，",
      "token_start": 266,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 70660,
      "end_ms": 72495,
      "text": "这我听说您爱打羽毛球，",
      "token_start": 270,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 72800,
      "end_ms": 74185,
      "text": "特意给您挑了个好球拍，",
      "token_start": 280,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 75080,
      "end_ms": 75845,
      "text": "破费了。",
      "token_start": 290,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 76170,
      "end_ms": 76565,
      "text": "陈姐，",
      "token_start": 293,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 76940,
      "end_ms": 78360,
      "text": "这是我给您买的羽毛球，",
      "token_start": 295,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 78720,
      "end_ms": 80040,
      "text": "听说是手工制作的，",
      "token_start": 305,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 80040,
      "end_ms": 80560,
      "text": "我也不懂，",
      "token_start": 313,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 80560,
      "end_ms": 81465,
      "text": "您凑合用吧。",
      "token_start": 317,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 82020,
      "end_ms": 84575,
      "text": "还有这球手感可棒了。",
      "token_start": 322,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 85000,
      "end_ms": 86180,
      "text": "小姑娘这么远过来，",
      "token_start": 331,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 86180,
      "end_ms": 86785,
      "text": "饿了吧，",
      "token_start": 339,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 87090,
      "end_ms": 87830,
      "text": "走走走包间，",
      "token_start": 342,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 87830,
      "end_ms": 88510,
      "text": "我都订好了，",
      "token_start": 347,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 88530,
      "end_ms": 89535,
      "text": "咱们边吃边聊。",
      "token_start": 352,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 91150,
      "end_ms": 92945,
      "text": "感谢陈姐和大家的宴请。",
      "token_start": 358,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 93600,
      "end_ms": 94685,
      "text": "这俗话说的好，",
      "token_start": 368,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 95150,
      "end_ms": 95870,
      "text": "酒杯一拿，",
      "token_start": 374,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 95910,
      "end_ms": 96630,
      "text": "事业发达，",
      "token_start": 378,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 96830,
      "end_ms": 97650,
      "text": "酒杯一台，",
      "token_start": 382,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 97750,
      "end_ms": 98590,
      "text": "升官发财，",
      "token_start": 386,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 98890,
      "end_ms": 99250,
      "text": "酒杯，",
      "token_start": 390,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 99250,
      "end_ms": 100635,
      "text": "一举鹏程万里。",
      "token_start": 392,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 100990,
      "end_ms": 102510,
      "text": "酒杯一碰黄金乱蹦，",
      "token_start": 398,
      "token_end_exclusive": 406
    },
    {
      "start_ms": 102670,
      "end_ms": 103370,
      "text": "酒杯一响，",
      "token_start": 406,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 103370,
      "end_ms": 104170,
      "text": "黄金万两，",
      "token_start": 410,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 104330,
      "end_ms": 105830,
      "text": "酒杯一干业绩翻番。",
      "token_start": 414,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 106090,
      "end_ms": 106330,
      "text": "来，",
      "token_start": 422,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 106390,
      "end_ms": 107785,
      "text": "我们一起举杯啊。",
      "token_start": 423,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 110430,
      "end_ms": 110945,
      "text": "陈姐，",
      "token_start": 430,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 111410,
      "end_ms": 112205,
      "text": "我敬你一杯，",
      "token_start": 432,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 112910,
      "end_ms": 114205,
      "text": "你凭什么敬我这一杯？",
      "token_start": 437,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 117160,
      "end_ms": 117755,
      "text": "陈姐，",
      "token_start": 446,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 118530,
      "end_ms": 119430,
      "text": "我们不图升官，",
      "token_start": 448,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 119450,
      "end_ms": 120275,
      "text": "也不图财，",
      "token_start": 454,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 120810,
      "end_ms": 122770,
      "text": "究竟您愿意看得起我们这些晚辈，",
      "token_start": 458,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 123090,
      "end_ms": 124965,
      "text": "很多东西花钱都买不到，",
      "token_start": 472,
      "token_end_exclusive": 482
    },
    {
      "start_ms": 125390,
      "end_ms": 127485,
      "text": "但您几句话就能把我们点透，",
      "token_start": 482,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 128070,
      "end_ms": 129365,
      "text": "真的得记一辈子。",
      "token_start": 494,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 129830,
      "end_ms": 130265,
      "text": "哈哈。",
      "token_start": 501,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 130790,
      "end_ms": 131880,
      "text": "好好好，",
      "token_start": 503,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 132060,
      "end_ms": 133635,
      "text": "这话我爱听干。",
      "token_start": 506,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 138530,
      "end_ms": 140345,
      "text": "今天这桌菜合不合你胃口啊，",
      "token_start": 512,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 141760,
      "end_ms": 143315,
      "text": "饭菜是填饱肚子的。",
      "token_start": 524,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 143860,
      "end_ms": 145915,
      "text": "您讲的话才是充实脑子的。",
      "token_start": 532,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 146180,
      "end_ms": 147595,
      "text": "今天这顿饭不重要，",
      "token_start": 543,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 147960,
      "end_ms": 148600,
      "text": "能坐在这儿，",
      "token_start": 551,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 148600,
      "end_ms": 151115,
      "text": "听您说话才是真的赚大了啊。",
      "token_start": 556,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 151330,
      "end_ms": 155705,
      "text": "哈哈哈哈听听都听听这姑娘会说话，",
      "token_start": 568,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 156150,
      "end_ms": 157030,
      "text": "棒棒棒棒。",
      "token_start": 583,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 157030,
      "end_ms": 157205,
      "text": "好，",
      "token_start": 587,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 158480,
      "end_ms": 159620,
      "text": "谁学一声狗叫，",
      "token_start": 588,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 159800,
      "end_ms": 161165,
      "text": "我就给谁一千块钱。",
      "token_start": 594,
      "token_end_exclusive": 602
    },
    {
      "start_ms": 163910,
      "end_ms": 164150,
      "text": "对，",
      "token_start": 602,
      "token_end_exclusive": 603
    },
    {
      "start_ms": 164550,
      "end_ms": 166050,
      "text": "祝陈姐家庭旺，",
      "token_start": 603,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 166070,
      "end_ms": 166630,
      "text": "事业旺，",
      "token_start": 609,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 166730,
      "end_ms": 167690,
      "text": "以后日子旺，",
      "token_start": 612,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 167690,
      "end_ms": 168290,
      "text": "上家旺，",
      "token_start": 617,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 168350,
      "end_ms": 169795,
      "text": "一共四生四千块，",
      "token_start": 620,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 170530,
      "end_ms": 171515,
      "text": "哈哈哈哈哈哈哈。",
      "token_start": 627,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 172210,
      "end_ms": 172435,
      "text": "好，",
      "token_start": 634,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 179080,
      "end_ms": 179720,
      "text": "这酒开了，",
      "token_start": 635,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 179720,
      "end_ms": 180695,
      "text": "怎么不先给我倒，",
      "token_start": 639,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 182210,
      "end_ms": 183050,
      "text": "先到的是客，",
      "token_start": 646,
      "token_end_exclusive": 651
    },
    {
      "start_ms": 183170,
      "end_ms": 184055,
      "text": "后到的是主。",
      "token_start": 651,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 184380,
      "end_ms": 185380,
      "text": "您是今天的主人，",
      "token_start": 656,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 185460,
      "end_ms": 186860,
      "text": "最后一杯满上代表压肘，",
      "token_start": 663,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 186920,
      "end_ms": 189120,
      "text": "全桌的福气都沉淀在您这杯里。",
      "token_start": 673,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 189720,
      "end_ms": 190260,
      "text": "说的好，",
      "token_start": 686,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 190340,
      "end_ms": 192000,
      "text": "这杯我干了让你跑这么远，",
      "token_start": 689,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 192000,
      "end_ms": 194200,
      "text": "送我耽误你俩工作了吧，",
      "token_start": 700,
      "token_end_exclusive": 710
    },
    {
      "start_ms": 194460,
      "end_ms": 197975,
      "text": "不耽误在办公室忙一天是把事儿做完，",
      "token_start": 710,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 198290,
      "end_ms": 199615,
      "text": "路上听您聊半个小时，",
      "token_start": 726,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 199920,
      "end_ms": 201040,
      "text": "是学怎么把事儿做好，",
      "token_start": 735,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 201440,
      "end_ms": 202360,
      "text": "这哪是耽误啊，",
      "token_start": 744,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 202360,
      "end_ms": 203065,
      "text": "这是赚了。",
      "token_start": 750,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 203490,
      "end_ms": 204135,
      "text": "哈哈哈哈。",
      "token_start": 754,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 204780,
      "end_ms": 206775,
      "text": "今天咱们两家公司谈的很开心，",
      "token_start": 758,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 207120,
      "end_ms": 209400,
      "text": "下批材料我给你们价格再低十点，",
      "token_start": 771,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 209540,
      "end_ms": 210365,
      "text": "让你多赚点儿，",
      "token_start": 785,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 210640,
      "end_ms": 211160,
      "text": "太感谢了。",
      "token_start": 791,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 211160,
      "end_ms": 212165,
      "text": "陈姐您慢走，",
      "token_start": 795,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 215290,
      "end_ms": 215650,
      "text": "琳琳，",
      "token_start": 800,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 215790,
      "end_ms": 216790,
      "text": "你太厉害了，",
      "token_start": 802,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 216790,
      "end_ms": 218330,
      "text": "今天这陈姐可太难对付了，",
      "token_start": 807,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 218390,
      "end_ms": 219485,
      "text": "没你我肯定完蛋。",
      "token_start": 818,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 219940,
      "end_ms": 221500,
      "text": "你这嘴皮子是咋练的呀？",
      "token_start": 825,
      "token_end_exclusive": 835
    },
    {
      "start_ms": 221680,
      "end_ms": 222560,
      "text": "我总是嘴笨，",
      "token_start": 835,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 222620,
      "end_ms": 223160,
      "text": "反应慢，",
      "token_start": 840,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 223220,
      "end_ms": 223540,
      "text": "一点儿，",
      "token_start": 843,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 223540,
      "end_ms": 224095,
      "text": "不会说。",
      "token_start": 846,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 224770,
      "end_ms": 228165,
      "text": "我父母从小就让我看这本把话说的恰到好处。",
      "token_start": 849,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 228460,
      "end_ms": 229520,
      "text": "假如你不爱说话，",
      "token_start": 868,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 229580,
      "end_ms": 230280,
      "text": "不爱争辩，",
      "token_start": 875,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 230300,
      "end_ms": 231120,
      "text": "也不爱出门，",
      "token_start": 879,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 231240,
      "end_ms": 235065,
      "text": "甚至恐惧社交推荐你读完这本把话说的恰到好处，",
      "token_start": 884,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 235390,
      "end_ms": 237375,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 905,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 237820,
      "end_ms": 239035,
      "text": "你每天就看两页，",
      "token_start": 917,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 239340,
      "end_ms": 240620,
      "text": "每一个场景慢慢练，",
      "token_start": 924,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 240860,
      "end_ms": 243280,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 932,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 243340,
      "end_ms": 244460,
      "text": "在这本书里有一句话，",
      "token_start": 947,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 244460,
      "end_ms": 245295,
      "text": "我特别欣赏，",
      "token_start": 956,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 245550,
      "end_ms": 245690,
      "text": "他，",
      "token_start": 961,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 245690,
      "end_ms": 247390,
      "text": "写的是面对别人夸你优秀，",
      "token_start": 962,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 247430,
      "end_ms": 248115,
      "text": "你可以回，",
      "token_start": 973,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 248400,
      "end_ms": 249415,
      "text": "那是不优秀点儿，",
      "token_start": 977,
      "token_end_exclusive": 984
    },
    {
      "start_ms": 249590,
      "end_ms": 250795,
      "text": "怎么能和你做朋友呢？",
      "token_start": 984,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 251140,
      "end_ms": 252400,
      "text": "当别人说你真聪明，",
      "token_start": 993,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 252460,
      "end_ms": 253880,
      "text": "你就回近朱者，",
      "token_start": 1001,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 253880,
      "end_ms": 255200,
      "text": "趁和你在一起啊，",
      "token_start": 1007,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 255220,
      "end_ms": 257780,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 1014,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 257780,
      "end_ms": 258960,
      "text": "你就回领导，",
      "token_start": 1029,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 259120,
      "end_ms": 260375,
      "text": "这都是我应该做的。",
      "token_start": 1034,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 260610,
      "end_ms": 261830,
      "text": "强将手下吴若兵，",
      "token_start": 1042,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 261970,
      "end_ms": 263255,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 1049,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 263620,
      "end_ms": 264860,
      "text": "当我看到这段的时候，",
      "token_start": 1058,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 264860,
      "end_ms": 266685,
      "text": "这个真是让我欲解心开啊。",
      "token_start": 1067,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 267010,
      "end_ms": 268290,
      "text": "每一句都很有意思，",
      "token_start": 1078,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 268350,
      "end_ms": 270970,
      "text": "就是手把手教我们在不同的场景之下，",
      "token_start": 1086,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 270970,
      "end_ms": 271775,
      "text": "应该怎么说。",
      "token_start": 1102,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 272200,
      "end_ms": 275080,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1107,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 275080,
      "end_ms": 276440,
      "text": "你就放心的拿回去看，",
      "token_start": 1125,
      "token_end_exclusive": 1134
    },
    {
      "start_ms": 276700,
      "end_ms": 278100,
      "text": "就是一句一句的教你，",
      "token_start": 1134,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 278240,
      "end_ms": 280300,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 1143,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 280420,
      "end_ms": 281500,
      "text": "还有配套书籍，",
      "token_start": 1155,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 281720,
      "end_ms": 283115,
      "text": "把事做的恰到好处，",
      "token_start": 1161,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 283620,
      "end_ms": 284760,
      "text": "但凡学会三分，",
      "token_start": 1169,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 284980,
      "end_ms": 287235,
      "text": "你就能把人际关系拿捏的死死的。",
      "token_start": 1175,
      "token_end_exclusive": 1189
    },
    {
      "start_ms": 287910,
      "end_ms": 291035,
      "text": "这套书真的可以帮助到你好的林姐，",
      "token_start": 1189,
      "token_end_exclusive": 1204
    },
    {
      "start_ms": 291330,
      "end_ms": 292205,
      "text": "我这就回去看。",
      "token_start": 1204,
      "token_end_exclusive": 1210
    }
