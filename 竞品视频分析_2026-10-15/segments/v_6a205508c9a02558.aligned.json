      "token_start": 56,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 17180,
      "end_ms": 18560,
      "text": "那叫宰相肚里能撑船，",
      "token_start": 61,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 18660,
      "end_ms": 19700,
      "text": "装的全是大事儿。",
      "token_start": 70,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 22140,
      "end_ms": 22580,
      "text": "小李，",
      "token_start": 77,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 23260,
      "end_ms": 24500,
      "text": "今天让你破费了。",
      "token_start": 79,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 24640,
      "end_ms": 25040,
      "text": "领导，",
      "token_start": 86,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 25200,
      "end_ms": 26760,
      "text": "您说这些您能来，",
      "token_start": 88,
      "token_end_exclusive": 95
    },
    {
