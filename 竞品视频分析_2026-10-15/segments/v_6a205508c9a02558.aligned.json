      "token_end_exclusive": 24
    },
    {
      "start_ms": 4990,
      "end_ms": 6050,
      "text": "代表幸福美满，",
      "token_start": 24,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 6350,
      "end_ms": 9535,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 30,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 12220,
      "end_ms": 12460,
      "text": "哎，",
      "token_start": 44,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 12840,
      "end_ms": 14500,
      "text": "我这肚子喝茶都能胖，",
      "token_start": 45,
      "token_end_exclusive": 54
    },
    {
      "start_ms": 15420,
      "end_ms": 15880,
      "text": "领导，",
