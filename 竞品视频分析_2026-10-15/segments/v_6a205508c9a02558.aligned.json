      "end_ms": 50310,
      "text": "哪有晚辈看长辈空手来的道理啊。",
      "token_start": 167,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 52230,
      "end_ms": 52670,
      "text": "小李，",
