      "end_ms": 34060,
      "text": "这鸭子是好鸭子，",
      "token_start": 114,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 34920,
      "end_ms": 35680,
      "text": "就是嘴硬，",
      "token_start": 121,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 36200,
      "end_ms": 36640,
      "text": "嘴硬，",
      "token_start": 125,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 36760,
      "end_ms": 42410,
      "text": "才守得住秘密来就来带什么礼物啊，",
      "token_start": 127,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 42550,
      "end_ms": 43430,
      "text": "都不是外人。",
      "token_start": 142,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 44290,
      "end_ms": 44750,
      "text": "领导，",
      "token_start": 147,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 44930,
      "end_ms": 45530,
      "text": "您都说了，",
