      "end_ms": 53830,
      "text": "最近表现不错啊，",
      "token_start": 183,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 54190,
      "end_ms": 56050,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 190,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 56270,
      "end_ms": 57590,
      "text": "我得提前敬你一杯。",
      "token_start": 203,
      "token_end_exclusive": 211
    },
    {
