  "segments": [
    {
      "start_ms": 150,
      "end_ms": 1230,
      "text": "怎么你这一入职，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1490,
      "end_ms": 2970,
      "text": "我刚种的花就死了，",
      "token_start": 7,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3370,
      "end_ms": 4410,
      "text": "花开富贵嘛，",
      "token_start": 15,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4450,
      "end_ms": 5890,
      "text": "花开过了就剩富贵了。",
      "token_start": 20,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 5950,
      "end_ms": 7690,
      "text": "看来领导您啊要发大财了，",
      "token_start": 29,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 9130,
      "end_ms": 10570,
      "text": "年轻就是好啊，",
      "token_start": 40,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 10850,
      "end_ms": 12410,
      "text": "年轻就是还不够沉稳，",
      "token_start": 46,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 12710,
      "end_ms": 13910,
      "text": "还要向您多学习，",
      "token_start": 55,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 14110,
      "end_ms": 15350,
      "text": "我们才能变得更优秀。",
      "token_start": 62,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 18210,
      "end_ms": 18830,
      "text": "思李啊，",
      "token_start": 71,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 19350,
      "end_ms": 21210,
      "text": "我看你穿衣品味不错嘛，",
      "token_start": 74,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 21730,
      "end_ms": 23750,
      "text": "思想上领导的高度我望尘莫及，",
      "token_start": 84,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 23930,
      "end_ms": 25830,
      "text": "只能在衣品上找些自我安慰了。",
      "token_start": 97,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 27070,
      "end_ms": 28410,
      "text": "这偶是好藕啊，",
      "token_start": 110,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 28770,
      "end_ms": 30000,
      "text": "就是心眼太多了。",
      "token_start": 116,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 31040,
      "end_ms": 32740,
      "text": "领导藕虽然心眼多，",
      "token_start": 123,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 32980,
      "end_ms": 34400,
      "text": "但也是您的下酒菜呀。",
      "token_start": 131,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 36180,
      "end_ms": 38360,
      "text": "来这么晚只能吃剩菜了吧。",
      "token_start": 140,
      "token_end_exclusive": 151
    },
    {
      "start_ms": 38560,
      "end_ms": 38960,
      "text": "领导，",
      "token_start": 151,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 39060,
      "end_ms": 40120,
      "text": "饭在哪儿我都能吃，",
      "token_start": 153,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 40320,
      "end_ms": 42260,
      "text": "但您这桌不是谁想做就能做的，",
      "token_start": 161,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 42400,
      "end_ms": 43340,
      "text": "能赶上已经是我的，",
      "token_start": 174,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 43340,
      "end_ms": 45680,
      "text": "运气了不喝，",
      "token_start": 182,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 46580,
      "end_ms": 47720,
      "text": "就是看不起我。",
      "token_start": 187,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 48460,
      "end_ms": 48860,
      "text": "领导，",
      "token_start": 193,
      "token_end_exclusive": 195
    },
    {
      "start_ms": 49320,
      "end_ms": 50520,
      "text": "我不是看不起您，",
      "token_start": 195,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 50780,
      "end_ms": 51780,
      "text": "我是看不起病，",
      "token_start": 202,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 53840,
      "end_ms": 55200,
      "text": "能酒量挺好的呀。",
      "token_start": 208,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 55460,
      "end_ms": 55820,
      "text": "领导，",
      "token_start": 215,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 55820,
      "end_ms": 56800,
      "text": "您可抬举我了，",
      "token_start": 217,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 56800,
      "end_ms": 57940,
      "text": "我平时真不太能喝，",
      "token_start": 223,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 58180,
      "end_ms": 58420,
      "text": "这不，",
      "token_start": 231,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 58420,
      "end_ms": 59620,
      "text": "今天和您在一起吃饭，",
      "token_start": 233,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 59620,
      "end_ms": 59915,
      "text": "高兴，",
      "token_start": 242,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 60230,
      "end_ms": 61425,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 244,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 61910,
      "end_ms": 62910,
      "text": "哈哈哈啊，",
      "token_start": 254,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 63030,
      "end_ms": 64355,
      "text": "我真不怎么喜欢你，",
      "token_start": 258,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 65050,
      "end_ms": 67050,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 266,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 67050,
      "end_ms": 69485,
      "text": "我领导的格局值得我们学习。",
      "token_start": 279,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 71700,
      "end_ms": 73180,
      "text": "来就来带什么礼物啊，",
      "token_start": 291,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 73180,
      "end_ms": 73920,
      "text": "都不是外人。",
      "token_start": 300,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 74040,
      "end_ms": 74460,
      "text": "领导，",
      "token_start": 305,
      "token_end_exclusive": 307
    },
    {
      "start_ms": 74580,
      "end_ms": 75180,
      "text": "您都说了，",
      "token_start": 307,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 75180,
      "end_ms": 75780,
      "text": "不是外人，",
      "token_start": 311,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 75900,
      "end_ms": 77260,
      "text": "我一直都把您当长辈看，",
      "token_start": 315,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 77340,
      "end_ms": 79545,
      "text": "哪有晚辈看长辈空手来的道理啊。",
      "token_start": 325,
      "token_end_exclusive": 339
    },
    {
      "start_ms": 80710,
      "end_ms": 81110,
      "text": "小李，",
      "token_start": 339,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 81110,
      "end_ms": 82315,
      "text": "最近表现不错啊，",
      "token_start": 341,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 82590,
      "end_ms": 84410,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 348,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 84450,
      "end_ms": 85690,
      "text": "我得提前敬你一杯，",
      "token_start": 361,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 85730,
      "end_ms": 86330,
      "text": "听这意思。",
      "token_start": 369,
      "token_end_exclusive": 373
    },
    {
      "start_ms": 86330,
      "end_ms": 87430,
      "text": "领导是要高升了呀，",
      "token_start": 373,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 87450,
      "end_ms": 90630,
      "text": "我得提前敬领导一杯关注我，",
      "token_start": 381,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 90850,
      "end_ms": 92290,
      "text": "每天学点儿高情商，",
      "token_start": 393,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 92290,
      "end_ms": 93085,
      "text": "说话技巧，",
      "token_start": 401,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 93430,
      "end_ms": 95115,
      "text": "让你的路越走越宽。",
      "token_start": 405,
      "token_end_exclusive": 413
    }
  ],
