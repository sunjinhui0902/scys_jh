  "segments": [
    {
      "start_ms": 430,
      "end_ms": 1410,
      "text": "无论发生什么，",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1490,
      "end_ms": 2370,
      "text": "把孩子养好，",
      "token_start": 6,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2490,
      "end_ms": 4950,
      "text": "一定是你当下最值得做的事情。",
      "token_start": 11,
      "token_end_exclusive": 24
    },
    {
      "start_ms": 5670,
      "end_ms": 7170,
      "text": "什么房子、车子、票子，",
      "token_start": 24,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 7310,
      "end_ms": 8650,
      "text": "这些都是身外之物。",
      "token_start": 32,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 9030,
      "end_ms": 12010,
      "text": "唯有这个意气风发的翩翩少年，",
      "token_start": 40,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 12570,
      "end_ms": 15250,
      "text": "才是上天赐予你最好的礼物。",
      "token_start": 53,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 15990,
      "end_ms": 17270,
      "text": "工作失利可以重来，",
      "token_start": 65,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 17510,
      "end_ms": 18350,
      "text": "钱财散尽，",
      "token_start": 73,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 18590,
      "end_ms": 21650,
      "text": "可以在这唯有孩子的成长和教育，",
      "token_start": 77,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 21670,
      "end_ms": 22830,
      "text": "一旦错过你，",
      "token_start": 91,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 22830,
      "end_ms": 24150,
      "text": "将再也无法弥补。",
      "token_start": 96,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 24950,
      "end_ms": 26190,
      "text": "他是出身的骄阳，",
      "token_start": 103,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 26550,
      "end_ms": 27990,
      "text": "是披荆斩棘的少年，",
      "token_start": 110,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 28170,
      "end_ms": 29250,
      "text": "是你唯一的偏爱，",
      "token_start": 118,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 29570,
      "end_ms": 32020,
      "text": "也是你此生最大的骄傲。",
      "token_start": 125,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 32940,
      "end_ms": 33520,
      "text": "所以啊，",
      "token_start": 135,
      "token_end_exclusive": 138
    },
    {
      "start_ms": 33680,
      "end_ms": 34940,
      "text": "无论你现在多苦，",
      "token_start": 138,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 34980,
      "end_ms": 35780,
      "text": "多忙多累，",
      "token_start": 145,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 36040,
      "end_ms": 37040,
      "text": "一定要把孩子养。",
      "token_start": 149,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 37040,
      "end_ms": 38340,
      "text": "好好好陪伴，",
      "token_start": 156,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 38680,
      "end_ms": 39540,
      "text": "用心引导，",
      "token_start": 161,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 39600,
      "end_ms": 40500,
      "text": "全力托起，",
      "token_start": 165,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 40900,
      "end_ms": 45305,
      "text": "才是人这一生最长久最值得的事业。",
      "token_start": 169,
      "token_end_exclusive": 184
    }
