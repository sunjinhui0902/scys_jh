  "segments": [
    {
      "start_ms": 190,
      "end_ms": 1290,
      "text": "有的人总是怕死，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1590,
      "end_ms": 4710,
      "text": "实际上六七十岁离开和八九十岁离开，",
      "token_start": 7,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5050,
      "end_ms": 6450,
      "text": "本质上没什么区别。",
      "token_start": 23,
      "token_end_exclusive": 31
    },
    {
      "start_ms": 7210,
      "end_ms": 8070,
      "text": "表面上看，",
      "token_start": 31,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 8170,
      "end_ms": 9790,
      "text": "有的人多活了二十多年，",
      "token_start": 35,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 10130,
      "end_ms": 11770,
      "text": "未必是多赚了多少光阴，",
      "token_start": 45,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 12070,
      "end_ms": 15230,
      "text": "有可能是增添了很多的病痛和烦恼。",
      "token_start": 55,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 16110,
      "end_ms": 17270,
      "text": "我们来到这个世界，",
      "token_start": 70,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 17450,
      "end_ms": 18230,
      "text": "不得不来。",
      "token_start": 78,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 18470,
      "end_ms": 19790,
      "text": "我们离开这个世界，",
      "token_start": 82,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 20010,
      "end_ms": 21110,
      "text": "也不得不走，",
      "token_start": 90,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 21590,
      "end_ms": 22350,
      "text": "活的长短，",
      "token_start": 95,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 22530,
      "end_ms": 24210,
      "text": "不过是年龄上的一个数字，",
      "token_start": 99,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 24390,
      "end_ms": 28590,
      "text": "活的轻重才是人生真正的成功嘛，",
      "token_start": 110,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 28690,
      "end_ms": 29845,
      "text": "从来不是活多久，",
      "token_start": 124,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 30180,
      "end_ms": 31000,
      "text": "有多风光，",
      "token_start": 131,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 31440,
      "end_ms": 33320,
      "text": "而是你来到这个世界上的体验，",
      "token_start": 135,
      "token_end_exclusive": 148
    },
    {
      "start_ms": 33600,
      "end_ms": 34820,
      "text": "能否让你活的心安，",
      "token_start": 148,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 35140,
      "end_ms": 37020,
      "text": "活得自在来过，",
      "token_start": 156,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 37360,
      "end_ms": 38640,
      "text": "爱过尽兴，",
      "token_start": 162,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 38700,
      "end_ms": 43475,
      "text": "过用自己喜欢的方式过好这一生。",
      "token_start": 166,
      "token_end_exclusive": 180
    }
