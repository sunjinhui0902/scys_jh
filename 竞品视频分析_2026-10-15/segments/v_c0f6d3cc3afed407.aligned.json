  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_c0f6d3cc3afed407.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_c0f6d3cc3afed407.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 290,
      "end_ms": 1550,
      "text": "今天谁学声狗叫，",
      "token_start": 0,
      "token_end_exclusive": 7
    },
    {
      "start_ms": 1650,
      "end_ms": 2730,
      "text": "我直接给一千。",
      "token_start": 7,
      "token_end_exclusive": 13
    },
    {
      "start_ms": 3010,
      "end_ms": 3450,
      "text": "领导，",
      "token_start": 13,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 3550,
      "end_ms": 5250,
      "text": "您看旺字就是狗叫的谐音，",
      "token_start": 15,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5330,
      "end_ms": 6350,
      "text": "我祝您家庭旺，",
      "token_start": 26,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 6350,
      "end_ms": 6830,
      "text": "事业旺，",
      "token_start": 32,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 6830,
      "end_ms": 7270,
      "text": "财运旺，",
      "token_start": 35,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 7270,
      "end_ms": 7830,
      "text": "身体旺，",
      "token_start": 38,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 7910,
      "end_ms": 8610,
      "text": "这四声旺，",
      "token_start": 41,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 8650,
      "end_ms": 9610,
      "text": "你得给四千吧，",
      "token_start": 45,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 9750,
      "end_ms": 11050,
      "text": "你酒量挺好的呀。",
      "token_start": 51,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 11070,
      "end_ms": 11470,
      "text": "领导，",
      "token_start": 58,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 11550,
      "end_ms": 12610,
      "text": "您可抬举我了，",
      "token_start": 60,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 12670,
      "end_ms": 13870,
      "text": "我平时真不太能喝，",
      "token_start": 66,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 14030,
      "end_ms": 14370,
      "text": "这不，",
      "token_start": 74,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 14370,
      "end_ms": 15530,
      "text": "今天和您在一起吃饭，",
      "token_start": 76,
      "token_end_exclusive": 85
    },
    {
      "start_ms": 15530,
      "end_ms": 16070,
      "text": "高兴啊。",
      "token_start": 85,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 16149,
      "end_ms": 17690,
      "text": "这一高兴就多贪了几杯，",
      "token_start": 88,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 17890,
      "end_ms": 19090,
      "text": "和你这么漂亮的女孩，",
      "token_start": 98,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 19090,
      "end_ms": 21230,
      "text": "吃饭不用喝就已经醉了。",
      "token_start": 107,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 21250,
      "end_ms": 21590,
      "text": "领导，",
      "token_start": 117,
      "token_end_exclusive": 119
    },
    {
      "start_ms": 21590,
      "end_ms": 22310,
      "text": "您真幽默，",
      "token_start": 119,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 22430,
      "end_ms": 23190,
      "text": "您还没沾酒，",
      "token_start": 123,
      "token_end_exclusive": 128
    },
    {
      "start_ms": 23190,
      "end_ms": 24150,
      "text": "就让我沾光了，",
      "token_start": 128,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 24230,
      "end_ms": 25530,
      "text": "我真不怎么喜欢你，",
      "token_start": 134,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 25670,
      "end_ms": 27630,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 142,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 27630,
      "end_ms": 29875,
      "text": "我领导的格局值得我们学习。",
      "token_start": 155,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 30200,
      "end_ms": 30440,
      "text": "哎，",
      "token_start": 167,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 30640,
      "end_ms": 32200,
      "text": "我这肚子喝茶都能胖。",
      "token_start": 168,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 32440,
      "end_ms": 32860,
      "text": "领导，",
      "token_start": 177,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 33060,
      "end_ms": 33940,
      "text": "你那不叫胖，",
      "token_start": 179,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 34280,
      "end_ms": 35980,
      "text": "那叫宰相肚里能撑船，",
      "token_start": 184,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 36220,
      "end_ms": 37420,
      "text": "装的全是大事儿，",
      "token_start": 193,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 37460,
      "end_ms": 39140,
      "text": "你干活怎么比乌龟还慢？",
      "token_start": 200,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 39220,
      "end_ms": 39560,
      "text": "领导，",
      "token_start": 210,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 39780,
      "end_ms": 40340,
      "text": "俗话说，",
      "token_start": 212,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 40360,
      "end_ms": 41360,
      "text": "慢工出细活，",
      "token_start": 215,
      "token_end_exclusive": 220
    },
    {
      "start_ms": 41540,
      "end_ms": 43580,
      "text": "我细致的对待每一个工作项目，",
      "token_start": 220,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 43760,
      "end_ms": 46200,
      "text": "不就避免了以后出现什么质量问题吗？",
      "token_start": 233,
      "token_end_exclusive": 249
    },
    {
      "start_ms": 46220,
      "end_ms": 46800,
      "text": "小王啊，",
      "token_start": 249,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 46880,
      "end_ms": 48420,
      "text": "你个子是真高比，",
      "token_start": 252,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 48420,
      "end_ms": 49500,
      "text": "我还高一头呢。",
      "token_start": 259,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 49520,
      "end_ms": 51360,
      "text": "个高是为了给领导探路，",
      "token_start": 265,
      "token_end_exclusive": 275
    },
    {
      "start_ms": 51680,
      "end_ms": 53920,
      "text": "走哪儿不还是得听领导指挥吗？",
      "token_start": 275,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 54020,
      "end_ms": 56020,
      "text": "不喝就是看不起我领导，",
      "token_start": 288,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 56280,
      "end_ms": 57400,
      "text": "我不是看不起您，",
      "token_start": 298,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 57500,
      "end_ms": 58420,
      "text": "我是看不起病。",
      "token_start": 305,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 58560,
      "end_ms": 60010,
      "text": "你这菜点的也太多了，",
      "token_start": 311,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 60210,
      "end_ms": 61760,
      "text": "领导菜点的再多，",
      "token_start": 320,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 61800,
      "end_ms": 64180,
      "text": "也比不上平时您对我的照顾多这杯酒，",
      "token_start": 327,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 64180,
      "end_ms": 64935,
      "text": "我先敬您，",
      "token_start": 343,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 65250,
      "end_ms": 66430,
      "text": "偶确实是好偶，",
      "token_start": 347,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 66590,
      "end_ms": 67990,
      "text": "就是心眼儿太多了。",
      "token_start": 353,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 67990,
      "end_ms": 69090,
      "text": "领导哦，",
      "token_start": 361,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 69090,
      "end_ms": 70050,
      "text": "虽然心眼多，",
      "token_start": 364,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 70350,
      "end_ms": 71790,
      "text": "也是您的下酒菜啊，",
      "token_start": 369,
      "token_end_exclusive": 377
    },
    {
      "start_ms": 71930,
      "end_ms": 74650,
      "text": "这个世界上真的没有人会讨厌那些会说话，",
      "token_start": 377,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 74650,
      "end_ms": 75530,
      "text": "会来事儿的人。",
      "token_start": 395,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 75630,
      "end_ms": 76770,
      "text": "假如你不爱说话，",
      "token_start": 401,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 76950,
      "end_ms": 77670,
      "text": "不爱争辩，",
      "token_start": 408,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 77770,
      "end_ms": 78745,
      "text": "也不爱出门，",
      "token_start": 412,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 79060,
      "end_ms": 83220,
      "text": "甚至恐惧社交推荐你读完这本把话说的恰到好处，",
      "token_start": 417,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 83460,
      "end_ms": 85535,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 438,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 85870,
      "end_ms": 86910,
      "text": "你每天就看两页，",
      "token_start": 450,
      "token_end_exclusive": 457
    },
    {
      "start_ms": 86990,
      "end_ms": 88245,
      "text": "每一个场景慢慢练，",
      "token_start": 457,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 88510,
      "end_ms": 90955,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 465,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 91330,
      "end_ms": 92150,
      "text": "在这本书里边，",
      "token_start": 480,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 92150,
      "end_ms": 92690,
      "text": "有一句话，",
      "token_start": 486,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 92690,
      "end_ms": 93510,
      "text": "我特别欣赏。",
      "token_start": 490,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 93650,
      "end_ms": 94050,
      "text": "他说，",
      "token_start": 495,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 94210,
      "end_ms": 95590,
      "text": "当对象给你发红包时，",
      "token_start": 497,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 95670,
      "end_ms": 96490,
      "text": "高情商回答，",
      "token_start": 506,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 96490,
      "end_ms": 98475,
      "text": "你是我致富道路上最大的功臣。",
      "token_start": 511,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 98830,
      "end_ms": 99750,
      "text": "当同事向你借钱，",
      "token_start": 524,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 99750,
      "end_ms": 100450,
      "text": "不想借时，",
      "token_start": 531,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 100450,
      "end_ms": 100910,
      "text": "你就回。",
      "token_start": 535,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 101190,
      "end_ms": 102415,
      "text": "大家都是同样的年纪，",
      "token_start": 538,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 102670,
      "end_ms": 103250,
      "text": "你没有的，",
      "token_start": 547,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 103250,
      "end_ms": 103910,
      "text": "我能有吗？",
      "token_start": 551,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 104130,
      "end_ms": 106050,
      "text": "当心仪的女生说我想你时，",
      "token_start": 555,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 106310,
      "end_ms": 107170,
      "text": "高情商回答，",
      "token_start": 566,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 107290,
      "end_ms": 107890,
      "text": "随便想，",
      "token_start": 571,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 107990,
      "end_ms": 109070,
      "text": "千万别跟我客气。",
      "token_start": 574,
      "token_end_exclusive": 581
    },
    {
      "start_ms": 109130,
      "end_ms": 110025,
      "text": "目前不收费。",
      "token_start": 581,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 110470,
      "end_ms": 111590,
      "text": "我读到这段的时候，",
      "token_start": 586,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 111590,
      "end_ms": 113890,
      "text": "我觉得这个让我真是一解心开啊。",
      "token_start": 594,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 114010,
      "end_ms": 116325,
      "text": "每家的书架上不应该有一套这样的书吗？",
      "token_start": 608,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 116570,
      "end_ms": 119755,
      "text": "就是手把手的教我们不同的场景之下应该怎么说？",
      "token_start": 625,
      "token_end_exclusive": 646
    },
    {
      "start_ms": 120180,
      "end_ms": 122820,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 646,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 122820,
      "end_ms": 123920,
      "text": "你就放心拿回去看，",
      "token_start": 664,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 124100,
      "end_ms": 127225,
      "text": "就是一句一句的教你我觉得这书适合所有人。",
      "token_start": 672,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 127510,
      "end_ms": 130040,
      "text": "所以强烈推荐你看看这套书这本书，",
      "token_start": 691,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 130040,
      "end_ms": 131240,
      "text": "真的可以帮助到大家，",
      "token_start": 706,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 131460,
      "end_ms": 132750,
      "text": "建议大家买回去看一看。",
      "token_start": 715,
      "token_end_exclusive": 725
    }
  ],
