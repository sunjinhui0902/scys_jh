{
  "video_id": "v_7895546933c47e17",
  "duration_s": 276.408889,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_7895546933c47e17.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_7895546933c47e17.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 2070,
      "text": "今天晚上李总组了个局陈，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2070,
      "end_ms": 2910,
      "text": "总也会过去。",
      "token_start": 11,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3070,
      "end_ms": 3750,
      "text": "琳琳小张，",
      "token_start": 16,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 3750,
      "end_ms": 4590,
      "text": "你俩跟我一起去。",
      "token_start": 20,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 4870,
      "end_ms": 5190,
      "text": "好的，",
      "token_start": 27,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 5190,
      "end_ms": 6390,
      "text": "王姐没问题。",
      "token_start": 29,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 6390,
      "end_ms": 6750,
      "text": "王姐，",
      "token_start": 34,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 6970,
      "end_ms": 7410,
      "text": "对了，",
      "token_start": 36,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 7910,
      "end_ms": 9490,
      "text": "今晚来的都是重要客户，",
      "token_start": 38,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 9850,
      "end_ms": 11170,
      "text": "说话做事都注意点，",
      "token_start": 48,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 11510,
      "end_ms": 11930,
      "text": "放心吧，",
      "token_start": 56,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 11930,
      "end_ms": 12270,
      "text": "王姐，",
      "token_start": 59,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 12270,
      "end_ms": 20570,
      "text": "我肯定不给您丢脸哟。",
      "token_start": 61,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 20870,
      "end_ms": 21730,
      "text": "王姐来了，",
      "token_start": 70,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 21770,
      "end_ms": 22490,
      "text": "快坐快坐。",
      "token_start": 74,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 23110,
      "end_ms": 23750,
      "text": "不好意思，",
      "token_start": 78,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 23910,
      "end_ms": 24870,
      "text": "让两位久等了，",
      "token_start": 82,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 25090,
      "end_ms": 26975,
      "text": "哪里哪里都是自己人。",
      "token_start": 88,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 32730,
      "end_ms": 33190,
      "text": "小张啊，",
      "token_start": 97,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 33190,
      "end_ms": 33810,
      "text": "今天高兴，",
      "token_start": 100,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 34030,
      "end_ms": 36255,
      "text": "刚好李总和陈总都在你来讲两句，",
      "token_start": 104,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 38220,
      "end_ms": 39320,
      "text": "那祝大家吃好喝。",
      "token_start": 118,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 39320,
      "end_ms": 39500,
      "text": "好，",
      "token_start": 125,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 39500,
      "end_ms": 45150,
      "text": "我先干了王姐，",
      "token_start": 126,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 45510,
      "end_ms": 46990,
      "text": "那我也借这个机会说两句。",
      "token_start": 132,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 47230,
      "end_ms": 47470,
      "text": "好，",
      "token_start": 143,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 47610,
      "end_ms": 49930,
      "text": "你说非常感谢李总今天组的局，",
      "token_start": 144,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 50050,
      "end_ms": 51230,
      "text": "也感谢王姐带我们过来，",
      "token_start": 157,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 51230,
      "end_ms": 52610,
      "text": "让我们有幸认识各位前辈，",
      "token_start": 167,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 52630,
      "end_ms": 53250,
      "text": "我叫琳琳。",
      "token_start": 178,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 53410,
      "end_ms": 53970,
      "text": "俗话说，",
      "token_start": 182,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 54210,
      "end_ms": 55350,
      "text": "相聚是一种缘分。",
      "token_start": 185,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 55570,
      "end_ms": 56250,
      "text": "此时此刻，",
      "token_start": 192,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 56330,
      "end_ms": 58390,
      "text": "我把对各位的祝福化作一杯美酒，",
      "token_start": 196,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 58590,
      "end_ms": 59730,
      "text": "祝各位扶摇直上，",
      "token_start": 210,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 59730,
      "end_ms": 61510,
      "text": "九万里事业长虹节节高。",
      "token_start": 217,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 62370,
      "end_ms": 62775,
      "text": "好，",
      "token_start": 227,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 63100,
      "end_ms": 63440,
      "text": "王姐，",
      "token_start": 228,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 63500,
      "end_ms": 64520,
      "text": "来这杯，",
      "token_start": 230,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 64520,
      "end_ms": 67230,
      "text": "我敬你陈总这杯，",
      "token_start": 233,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 67230,
      "end_ms": 68355,
      "text": "我替王姐敬您，",
      "token_start": 240,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 69170,
      "end_ms": 70525,
      "text": "我敬的是你们领导，",
      "token_start": 246,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 70810,
      "end_ms": 71645,
      "text": "你是领导吗？",
      "token_start": 254,
      "token_end_exclusive": 259
    },
    {
      "start_ms": 75350,
      "end_ms": 76175,
      "text": "瞧您说的，",
      "token_start": 259,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 76490,
      "end_ms": 77530,
      "text": "您敬的是我领导，",
      "token_start": 263,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 77730,
      "end_ms": 79045,
      "text": "我同样敬的也是领导，",
      "token_start": 270,
      "token_end_exclusive": 279
    },
    {
      "start_ms": 79320,
      "end_ms": 80560,
      "text": "您敬领导是心意，",
      "token_start": 279,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 80620,
      "end_ms": 82600,
      "text": "我敬您是尊敬这杯，",
      "token_start": 286,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 82600,
      "end_ms": 83480,
      "text": "我敬的是生意，",
      "token_start": 294,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 83660,
      "end_ms": 84320,
      "text": "咱们随意，",
      "token_start": 300,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 84320,
      "end_ms": 85660,
      "text": "祝您生意一路超红，",
      "token_start": 304,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 85780,
      "end_ms": 86615,
      "text": "万事顺畅。",
      "token_start": 312,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 87070,
      "end_ms": 90325,
      "text": "哈哈哈哈哈哈这小姑娘会说话。",
      "token_start": 316,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 90640,
      "end_ms": 92060,
      "text": "玲玲刚才说的不错，",
      "token_start": 329,
      "token_end_exclusive": 337
    },
    {
      "start_ms": 92120,
      "end_ms": 93000,
      "text": "来咱俩喝一个，",
      "token_start": 337,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 93000,
      "end_ms": 93665,
      "text": "谢谢李总。",
      "token_start": 343,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 93970,
      "end_ms": 94175,
      "text": "嗯，",
      "token_start": 347,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 96770,
      "end_ms": 97700,
      "text": "来怎么到？",
      "token_start": 348,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 97700,
      "end_ms": 98760,
      "text": "我这就剩半杯了，",
      "token_start": 352,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 98980,
      "end_ms": 99780,
      "text": "平底酒，",
      "token_start": 359,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 99780,
      "end_ms": 100660,
      "text": "这叫发财酒，",
      "token_start": 362,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 100800,
      "end_ms": 105465,
      "text": "到底发财好事再来好一个发财酒。",
      "token_start": 367,
      "token_end_exclusive": 381
    },
    {
      "start_ms": 105890,
      "end_ms": 106250,
      "text": "琳玲，",
      "token_start": 381,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 106830,
      "end_ms": 107855,
      "text": "我再问你个问题，",
      "token_start": 383,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 108620,
      "end_ms": 111105,
      "text": "你觉得我和李总你更喜欢谁？",
      "token_start": 390,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 112880,
      "end_ms": 114195,
      "text": "领导怎能用喜欢呢？",
      "token_start": 402,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 114430,
      "end_ms": 115980,
      "text": "那得是尊敬两位领导，",
      "token_start": 410,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 115980,
      "end_ms": 119120,
      "text": "我都尊敬啊。",
      "token_start": 419,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 119460,
      "end_ms": 120485,
      "text": "这姑娘聪明，",
      "token_start": 424,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 122050,
      "end_ms": 124295,
      "text": "玲莲这条鱼没怎么动，",
      "token_start": 429,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 124740,
      "end_ms": 125500,
      "text": "都是自己人，",
      "token_start": 438,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 125500,
      "end_ms": 126080,
      "text": "别嫌弃，",
      "token_start": 443,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 126160,
      "end_ms": 127400,
      "text": "一会儿打包带回吃吧，",
      "token_start": 446,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 127400,
      "end_ms": 128345,
      "text": "还能补补身子。",
      "token_start": 455,
      "token_end_exclusive": 461
    },
    {
      "start_ms": 128550,
      "end_ms": 130300,
      "text": "莲莲陈总让你拿，",
      "token_start": 461,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 130340,
      "end_ms": 131155,
      "text": "你就拿着呗，",
      "token_start": 468,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 131780,
      "end_ms": 132785,
      "text": "太感谢陈总了，",
      "token_start": 473,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 133120,
      "end_ms": 134695,
      "text": "但是一整条鱼我自己也吃不完。",
      "token_start": 479,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 135060,
      "end_ms": 136320,
      "text": "我平时喜欢吃鱼尾，",
      "token_start": 492,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 136480,
      "end_ms": 138955,
      "text": "上面这部分我给您打包带回去给嫂子也尝一下，",
      "token_start": 500,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 139210,
      "end_ms": 140565,
      "text": "以后还希望您多多照顾。",
      "token_start": 520,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 140980,
      "end_ms": 141575,
      "text": "哈哈哈。",
      "token_start": 530,
      "token_end_exclusive": 533
    },
    {
      "start_ms": 142080,
      "end_ms": 143845,
      "text": "看来今天这条鱼没白点。",
      "token_start": 533,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 146650,
      "end_ms": 148780,
      "text": "琳琳陈总那边刚来消息，",
      "token_start": 543,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 148880,
      "end_ms": 151285,
      "text": "昨天谈的那个项目确定跟咱们合作了，",
      "token_start": 553,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 151480,
      "end_ms": 152960,
      "text": "而且陈总还特意提了一句，",
      "token_start": 569,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 153020,
      "end_ms": 154245,
      "text": "后面让你负责对接，",
      "token_start": 580,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 154500,
      "end_ms": 155160,
      "text": "谢谢王姐，",
      "token_start": 588,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 155220,
      "end_ms": 156285,
      "text": "我一定把它做好。",
      "token_start": 592,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 158040,
      "end_ms": 158455,
      "text": "琳琳，",
      "token_start": 599,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 159130,
      "end_ms": 160425,
      "text": "我现在是真服你了，",
      "token_start": 601,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 161860,
      "end_ms": 162320,
      "text": "怎么了？",
      "token_start": 609,
      "token_end_exclusive": 612
    },
    {
      "start_ms": 162600,
      "end_ms": 163245,
      "text": "你想想啊。",
      "token_start": 612,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 163470,
      "end_ms": 165810,
      "text": "那天陈总说我敬的是你们领导，",
      "token_start": 616,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 165930,
      "end_ms": 166750,
      "text": "你是领导吗？",
      "token_start": 629,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 166830,
      "end_ms": 167290,
      "text": "换成我，",
      "token_start": 634,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 167290,
      "end_ms": 168750,
      "text": "我当场就不知道该说什么了。",
      "token_start": 637,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 168750,
      "end_ms": 170070,
      "text": "饭局上突然让你讲话，",
      "token_start": 649,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 170190,
      "end_ms": 170870,
      "text": "给李总倒酒，",
      "token_start": 658,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 170870,
      "end_ms": 171534,
      "text": "只剩半杯。",
      "token_start": 663,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 171790,
      "end_ms": 172410,
      "text": "陈总又问你，",
      "token_start": 667,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 172410,
      "end_ms": 173775,
      "text": "他和李总你更喜欢谁？",
      "token_start": 672,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 174650,
      "end_ms": 175525,
      "text": "还有最后那条鱼，",
      "token_start": 681,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 176020,
      "end_ms": 177100,
      "text": "我到现在才明白，",
      "token_start": 688,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 177220,
      "end_ms": 178705,
      "text": "陈总说的根本就不只是鱼，",
      "token_start": 695,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 179060,
      "end_ms": 180820,
      "text": "是你到底是怎么练的？",
      "token_start": 706,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 180960,
      "end_ms": 182460,
      "text": "为什么别人突然给你一句话，",
      "token_start": 715,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 182460,
      "end_ms": 183735,
      "text": "你马上就知道该怎么接。",
      "token_start": 727,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 184130,
      "end_ms": 185305,
      "text": "其实我以前跟你一样，",
      "token_start": 737,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 185710,
      "end_ms": 186390,
      "text": "不爱说话，",
      "token_start": 746,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 186650,
      "end_ms": 188050,
      "text": "也不知道怎么组织语言，",
      "token_start": 750,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 188270,
      "end_ms": 190345,
      "text": "一到这种场合就不知道应该说什么。",
      "token_start": 760,
      "token_end_exclusive": 775
    },
    {
      "start_ms": 190890,
      "end_ms": 192985,
      "text": "后来我就经常看这本闲谈高手，",
      "token_start": 775,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 193330,
      "end_ms": 195610,
      "text": "它里面就是一个场景的场景的告诉你，",
      "token_start": 788,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 195610,
      "end_ms": 197955,
      "text": "遇到不同的人不同的话应该怎么接。",
      "token_start": 804,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 198280,
      "end_ms": 199760,
      "text": "比如别人夸你优秀，",
      "token_start": 819,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 199880,
      "end_ms": 200480,
      "text": "你可以回，",
      "token_start": 827,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 200820,
      "end_ms": 201780,
      "text": "那是不优秀点，",
      "token_start": 831,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 201820,
      "end_ms": 203100,
      "text": "怎么能和你做朋友呢？",
      "token_start": 837,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 203240,
      "end_ms": 204520,
      "text": "当别人说你真聪明，",
      "token_start": 846,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 204540,
      "end_ms": 206060,
      "text": "你就回近朱者赤，",
      "token_start": 854,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 206220,
      "end_ms": 207180,
      "text": "和你在一起啊，",
      "token_start": 861,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 207180,
      "end_ms": 209875,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 867,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 210050,
      "end_ms": 211110,
      "text": "你就回领导，",
      "token_start": 882,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 211230,
      "end_ms": 212385,
      "text": "这都是我应该做的。",
      "token_start": 887,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 212620,
      "end_ms": 213740,
      "text": "强将手下吴若兵，",
      "token_start": 895,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 213880,
      "end_ms": 215200,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 902,
      "token_end_exclusive": 911
    },
    {
      "start_ms": 215300,
      "end_ms": 216945,
      "text": "难怪你每次都能接的这么快，",
      "token_start": 911,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 217370,
      "end_ms": 218765,
      "text": "这种东西不是天生的，",
      "token_start": 923,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 219180,
      "end_ms": 220120,
      "text": "就是平时一个场景，",
      "token_start": 932,
      "token_end_exclusive": 940
    },
    {
      "start_ms": 220120,
      "end_ms": 220680,
      "text": "一个场景的，",
      "token_start": 940,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 220680,
      "end_ms": 221520,
      "text": "看一个场景，",
      "token_start": 945,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 221520,
      "end_ms": 222305,
      "text": "一个场景的练。",
      "token_start": 950,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 222680,
      "end_ms": 223500,
      "text": "每天看两页，",
      "token_start": 956,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 223700,
      "end_ms": 225420,
      "text": "慢慢积累一些不同的场景之下，",
      "token_start": 961,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 225420,
      "end_ms": 226100,
      "text": "应该怎么说？",
      "token_start": 974,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 226380,
      "end_ms": 228235,
      "text": "这里面还有很多生活里的场景，",
      "token_start": 979,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 228510,
      "end_ms": 229670,
      "text": "比如对象给你发红包，",
      "token_start": 992,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 229670,
      "end_ms": 232385,
      "text": "你可以回你是我致富道路上最大的功臣。",
      "token_start": 1001,
      "token_end_exclusive": 1018
    },
    {
      "start_ms": 233010,
      "end_ms": 234070,
      "text": "同事向你借钱，",
      "token_start": 1018,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 234210,
      "end_ms": 235070,
      "text": "你又不想借，",
      "token_start": 1024,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 235150,
      "end_ms": 235765,
      "text": "可以回，",
      "token_start": 1029,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 236090,
      "end_ms": 237315,
      "text": "大家都是一样的年纪，",
      "token_start": 1032,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 237640,
      "end_ms": 238300,
      "text": "你没有的，",
      "token_start": 1041,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 238380,
      "end_ms": 239185,
      "text": "我能有吗？",
      "token_start": 1045,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 239460,
      "end_ms": 241740,
      "text": "还有心仪的人跟你说我想你了，",
      "token_start": 1049,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 241740,
      "end_ms": 243440,
      "text": "你可以回随便想，",
      "token_start": 1062,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 243700,
      "end_ms": 244845,
      "text": "千万别跟我客气，",
      "token_start": 1069,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 245080,
      "end_ms": 246025,
      "text": "目前不收费。",
      "token_start": 1076,
      "token_end_exclusive": 1081
    },
    {
      "start_ms": 246430,
      "end_ms": 248015,
      "text": "哈哈这个有意思，",
      "token_start": 1081,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 248540,
      "end_ms": 249900,
      "text": "我第一次读到这些的时候，",
      "token_start": 1088,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 249900,
      "end_ms": 251615,
      "text": "真的有种豁然开朗的感觉。",
      "token_start": 1099,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 252100,
      "end_ms": 255925,
      "text": "这本书就是把工作、生活、人际交往里经常遇到的场景，",
      "token_start": 1110,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 256160,
      "end_ms": 257545,
      "text": "一个一个拆开给你看，",
      "token_start": 1132,
      "token_end_exclusive": 1141
    },
    {
      "start_ms": 257910,
      "end_ms": 258650,
      "text": "别人怎么说，",
      "token_start": 1141,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 258730,
      "end_ms": 259545,
      "text": "你可以怎么接，",
      "token_start": 1146,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 259820,
      "end_ms": 261240,
      "text": "都是一句一句给你举例。",
      "token_start": 1152,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 261460,
      "end_ms": 263320,
      "text": "所以你平时就是这么练的对啊，",
      "token_start": 1162,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 263720,
      "end_ms": 265400,
      "text": "每天不用看很多看两页，",
      "token_start": 1175,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 265480,
      "end_ms": 268930,
      "text": "碰到自己觉得有用的表达就记一记慢慢积累的多了。",
      "token_start": 1185,
      "token_end_exclusive": 1207
    },
    {
      "start_ms": 269010,
      "end_ms": 271170,
      "text": "工作和生活里再碰到类似的场景，",
      "token_start": 1207,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 271190,
      "end_ms": 272315,
      "text": "你就知道怎么接了。",
      "token_start": 1221,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 273280,
      "end_ms": 273840,
      "text": "这本先借，",
      "token_start": 1229,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 273840,
      "end_ms": 275430,
      "text": "我看看拿去吧，",
      "token_start": 1233,
      "token_end_exclusive": 1239
    },
    {
      "start_ms": 275430,
      "end_ms": 276235,
      "text": "回去慢慢看。",
      "token_start": 1239,
      "token_end_exclusive": 1244
    }
