  "segments": [
    {
      "start_ms": 310,
      "end_ms": 1350,
      "text": "什么叫认知低？",
      "token_start": 0,
      "token_end_exclusive": 6
    },
    {
      "start_ms": 1510,
      "end_ms": 2910,
      "text": "今天看到一对夫妻聊天，",
      "token_start": 6,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3130,
      "end_ms": 4110,
      "text": "妻子的一番话，",
      "token_start": 16,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4350,
      "end_ms": 5670,
      "text": "瞬间点醒了丈夫。",
      "token_start": 22,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 6050,
      "end_ms": 6630,
      "text": "妻子说，",
      "token_start": 29,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 7230,
      "end_ms": 8470,
      "text": "我给你提个建议，",
      "token_start": 32,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 8930,
      "end_ms": 11590,
      "text": "你当做我在管你我只出问题。",
      "token_start": 39,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 11830,
      "end_ms": 14050,
      "text": "你当我在怪你我说个事实，",
      "token_start": 51,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 14590,
      "end_ms": 18470,
      "text": "你当我在否定你我给出了所有的解决方案，",
      "token_start": 62,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 18850,
      "end_ms": 20390,
      "text": "你又觉得我高高在上，",
      "token_start": 80,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 20750,
      "end_ms": 23310,
      "text": "在教你我和你讲个道理吧，",
      "token_start": 89,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 23730,
      "end_ms": 25110,
      "text": "你又觉得我带着偏见，",
      "token_start": 100,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 25530,
      "end_ms": 26310,
      "text": "针对你。",
      "token_start": 109,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 27030,
      "end_ms": 29635,
      "text": "最后妻子还说了一句扎心的话，",
      "token_start": 112,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 30200,
      "end_ms": 34000,
      "text": "我每天满脑子想的都是如何让我们变得越来越好，",
      "token_start": 125,
      "token_end_exclusive": 146
    },
    {
      "start_ms": 34460,
      "end_ms": 38060,
      "text": "而你满脑子想的都是怎么证明我没错。",
      "token_start": 146,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 38800,
      "end_ms": 40520,
      "text": "听完丈夫愣住了，",
      "token_start": 162,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 40760,
      "end_ms": 41360,
      "text": "这一刻，",
      "token_start": 169,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 41660,
      "end_ms": 43020,
      "text": "丈夫恍然大悟，",
      "token_start": 172,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 43520,
      "end_ms": 45420,
      "text": "原来认知低不是笨，",
      "token_start": 178,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 46060,
      "end_ms": 49840,
      "text": "而是把所有的善意都翻译成了攻击。",
      "token_start": 186,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 50800,
      "end_ms": 51220,
      "text": "朋友，",
      "token_start": 201,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 51400,
      "end_ms": 53735,
      "text": "不知道你身边有没有这样的人。",
      "token_start": 203,
      "token_end_exclusive": 216
    }
  ],
