{
  "video_id": "v_d8a71a2f9cff7170",
  "duration_s": 239.072993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_d8a71a2f9cff7170.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_d8a71a2f9cff7170.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 190,
      "end_ms": 830,
      "text": "小王啊，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 1250,
      "end_ms": 2850,
      "text": "你个子是真高比，",
      "token_start": 3,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2850,
      "end_ms": 3930,
      "text": "我还高一头呢。",
      "token_start": 10,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4350,
      "end_ms": 8370,
      "text": "个高是为了给领导探路走哪儿不还是得听领导指挥吗？",
      "token_start": 16,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 10170,
      "end_ms": 12830,
      "text": "你怎么就喝这点儿养鱼呢？",
      "token_start": 39,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 12830,
      "end_ms": 13730,
      "text": "我得留着量，",
      "token_start": 50,
      "token_end_exclusive": 55
    },
    {
      "start_ms": 13730,
      "end_ms": 14750,
      "text": "万一您喝到位了，",
      "token_start": 55,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 14750,
      "end_ms": 20170,
      "text": "总得有个清醒的人负责掏您家门钥匙吗？",
      "token_start": 62,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 20190,
      "end_ms": 20670,
      "text": "鱼好，",
      "token_start": 79,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 20670,
      "end_ms": 22830,
      "text": "鱼鱼惜惜是刺多。",
      "token_start": 81,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 23470,
      "end_ms": 23810,
      "text": "领导，",
      "token_start": 88,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 23810,
      "end_ms": 25350,
      "text": "您看虽然刺多，",
      "token_start": 90,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 25490,
      "end_ms": 29035,
      "text": "但主心骨只有一根心腹是没有刺的。",
      "token_start": 96,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 30310,
      "end_ms": 33950,
      "text": "我看你这丫头最近是越来越精神了啊，",
      "token_start": 111,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 34290,
      "end_ms": 35310,
      "text": "那是因为沾了领导，",
      "token_start": 127,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 35310,
      "end_ms": 36870,
      "text": "您的光跟着您干事儿，",
      "token_start": 135,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 36870,
      "end_ms": 38225,
      "text": "气色当然不会差了，",
      "token_start": 144,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 40310,
      "end_ms": 41450,
      "text": "今天让你破费了。",
      "token_start": 152,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 41750,
      "end_ms": 42170,
      "text": "领导，",
      "token_start": 159,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 42350,
      "end_ms": 43790,
      "text": "您说这些您能来，",
      "token_start": 161,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 43790,
      "end_ms": 44570,
      "text": "就是我的荣幸，",
      "token_start": 168,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 45030,
      "end_ms": 46650,
      "text": "以后还有很多地方向您请教。",
      "token_start": 174,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 46650,
      "end_ms": 47010,
      "text": "不是，",
      "token_start": 186,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 48810,
      "end_ms": 49290,
      "text": "哎呀，",
      "token_start": 188,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 49590,
      "end_ms": 51570,
      "text": "我都老了不中用了。",
      "token_start": 190,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 51730,
      "end_ms": 51970,
      "text": "哎，",
      "token_start": 198,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 52010,
      "end_ms": 52350,
      "text": "领导，",
      "token_start": 199,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 52350,
      "end_ms": 53410,
      "text": "您可千万别这么说，",
      "token_start": 201,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 53570,
      "end_ms": 57950,
      "text": "我们论能力、论经验论、资历都不如您这样的老前辈还得靠您带着我们进步啊，",
      "token_start": 209,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 59010,
      "end_ms": 60315,
      "text": "年轻就是好啊，",
      "token_start": 241,
      "token_end_exclusive": 247
    },
    {
      "start_ms": 61260,
      "end_ms": 62775,
      "text": "年轻就是还不够沉稳，",
      "token_start": 247,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 63290,
      "end_ms": 64405,
      "text": "还要向您多学习，",
      "token_start": 256,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 64670,
      "end_ms": 67840,
      "text": "我们才能变得更优秀哈。",
      "token_start": 263,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 68480,
      "end_ms": 68700,
      "text": "乔，",
      "token_start": 273,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 68700,
      "end_ms": 70285,
      "text": "你最近表现的不错啊，",
      "token_start": 274,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 70620,
      "end_ms": 72800,
      "text": "看来我的这个位置马上就该你坐了，",
      "token_start": 283,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 72880,
      "end_ms": 74140,
      "text": "我得提前敬你一杯。",
      "token_start": 298,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 74300,
      "end_ms": 75040,
      "text": "听您的意思，",
      "token_start": 306,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 75040,
      "end_ms": 76060,
      "text": "领导也是高升了呀，",
      "token_start": 311,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 76060,
      "end_ms": 77235,
      "text": "我也提前敬领导一杯。",
      "token_start": 319,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 77510,
      "end_ms": 79060,
      "text": "哈哈哈哈哈小王，",
      "token_start": 328,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 79420,
      "end_ms": 80975,
      "text": "你这菜点的太多了，",
      "token_start": 335,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 81540,
      "end_ms": 83250,
      "text": "领导菜点的再多，",
      "token_start": 343,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 83290,
      "end_ms": 84870,
      "text": "也比不上平时您对我的照顾，",
      "token_start": 350,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 84870,
      "end_ms": 86260,
      "text": "多这杯酒先敬您。",
      "token_start": 362,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 86500,
      "end_ms": 90405,
      "text": "哈哈哈哈哈你这衣服穿了好几年了吧，",
      "token_start": 369,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 91430,
      "end_ms": 92255,
      "text": "穿着舒服，",
      "token_start": 385,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 92670,
      "end_ms": 93530,
      "text": "跟您共事久了，",
      "token_start": 389,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 93530,
      "end_ms": 95585,
      "text": "人也实在了不讲究那些虚的。",
      "token_start": 395,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 96730,
      "end_ms": 97565,
      "text": "哈哈哈哈哈，",
      "token_start": 407,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 98300,
      "end_ms": 100140,
      "text": "和你这么漂亮的女孩的吃饭，",
      "token_start": 412,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 100400,
      "end_ms": 101975,
      "text": "不用喝就已经醉了。",
      "token_start": 424,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 102380,
      "end_ms": 102800,
      "text": "领导，",
      "token_start": 432,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 103040,
      "end_ms": 103835,
      "text": "您真幽默，",
      "token_start": 434,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 104180,
      "end_ms": 105865,
      "text": "您还没沾酒就让我沾光了。",
      "token_start": 438,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 106290,
      "end_ms": 107690,
      "text": "哈哈哈哈哈哈哈，",
      "token_start": 449,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 108420,
      "end_ms": 109665,
      "text": "你今天话怎么这么少？",
      "token_start": 456,
      "token_end_exclusive": 465
    },
    {
      "start_ms": 109980,
      "end_ms": 110640,
      "text": "再听您说，",
      "token_start": 465,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 110880,
      "end_ms": 113155,
      "text": "酒桌上您讲东西比开会时还有料，",
      "token_start": 469,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 113360,
      "end_ms": 117875,
      "text": "我舍不得打断你我怎么你这一入职，",
      "token_start": 483,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 118220,
      "end_ms": 119840,
      "text": "我刚种的花儿就死了，",
      "token_start": 498,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 120000,
      "end_ms": 120960,
      "text": "花开富贵嘛，",
      "token_start": 507,
      "token_end_exclusive": 512
    },
    {
      "start_ms": 120980,
      "end_ms": 122580,
      "text": "花开过了就剩富贵了。",
      "token_start": 512,
      "token_end_exclusive": 521
    },
    {
      "start_ms": 122640,
      "end_ms": 124420,
      "text": "看来领导您啊要发大财了。",
      "token_start": 521,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 125540,
      "end_ms": 126355,
      "text": "哈哈哈哈，",
      "token_start": 532,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 126710,
      "end_ms": 127850,
      "text": "怎么菜还没上齐，",
      "token_start": 536,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 127850,
      "end_ms": 128665,
      "text": "你就结账了，",
      "token_start": 543,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 129150,
      "end_ms": 130605,
      "text": "先结账是表明态度，",
      "token_start": 548,
      "token_end_exclusive": 556
    },
    {
      "start_ms": 130830,
      "end_ms": 131845,
      "text": "这顿饭我请定了，",
      "token_start": 556,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 132090,
      "end_ms": 132810,
      "text": "后面再加菜。",
      "token_start": 563,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 132810,
      "end_ms": 133490,
      "text": "您随便点，",
      "token_start": 568,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 133590,
      "end_ms": 134430,
      "text": "没有心理负担，",
      "token_start": 572,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 134450,
      "end_ms": 135190,
      "text": "吃的才尽兴。",
      "token_start": 578,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 136490,
      "end_ms": 136825,
      "text": "哎，",
      "token_start": 583,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 137120,
      "end_ms": 137885,
      "text": "你什么意思啊？",
      "token_start": 584,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 138100,
      "end_ms": 139520,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 590,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 139620,
      "end_ms": 141140,
      "text": "青岛美满美满，",
      "token_start": 601,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 141180,
      "end_ms": 142200,
      "text": "代表幸福美满，",
      "token_start": 607,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 142280,
      "end_ms": 144285,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 613,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 144600,
      "end_ms": 146125,
      "text": "哈哈哈哈哈哈哈哈，",
      "token_start": 627,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 146730,
      "end_ms": 147995,
      "text": "小王站我旁边，",
      "token_start": 635,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 148320,
      "end_ms": 149395,
      "text": "不怕把你照老了，",
      "token_start": 641,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 149890,
      "end_ms": 151255,
      "text": "站您旁边哪会显老，",
      "token_start": 648,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 151590,
      "end_ms": 153515,
      "text": "只会显得我年纪轻轻站的挺对。",
      "token_start": 656,
      "token_end_exclusive": 669
    },
    {
      "start_ms": 154060,
      "end_ms": 156575,
      "text": "哈哈哈哈哈梨我就先收下了，",
      "token_start": 669,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 156780,
      "end_ms": 157760,
      "text": "但事儿能不能办成，",
      "token_start": 681,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 157760,
      "end_ms": 158900,
      "text": "我可不敢打包票啊。",
      "token_start": 689,
      "token_end_exclusive": 697
    },
    {
      "start_ms": 158900,
      "end_ms": 159100,
      "text": "领导，",
      "token_start": 697,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 159100,
      "end_ms": 159815,
      "text": "您说笑了，",
      "token_start": 699,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 160040,
      "end_ms": 161320,
      "text": "这事儿能成是您的加持，",
      "token_start": 703,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 161320,
      "end_ms": 162600,
      "text": "不能成的话就是我的造化，",
      "token_start": 713,
      "token_end_exclusive": 724
    },
    {
      "start_ms": 162680,
      "end_ms": 163500,
      "text": "无论结果如何，",
      "token_start": 724,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 163500,
      "end_ms": 164040,
      "text": "都得感谢。",
      "token_start": 730,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 164040,
      "end_ms": 165335,
      "text": "领导您的提携啊，",
      "token_start": 734,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 165970,
      "end_ms": 167725,
      "text": "你一开口就让人喜欢你，",
      "token_start": 741,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 167930,
      "end_ms": 168885,
      "text": "你是怎么做到的？",
      "token_start": 751,
      "token_end_exclusive": 758
    },
    {
      "start_ms": 169280,
      "end_ms": 171735,
      "text": "因为我一直在看这本对答如流，",
      "token_start": 758,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 172110,
      "end_ms": 174130,
      "text": "这个世界上谁都不会拒绝，",
      "token_start": 771,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 174130,
      "end_ms": 174710,
      "text": "会说话，",
      "token_start": 782,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 174810,
      "end_ms": 175790,
      "text": "会来事儿的人。",
      "token_start": 785,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 175930,
      "end_ms": 177090,
      "text": "假如你不爱说话，",
      "token_start": 791,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 177170,
      "end_ms": 177870,
      "text": "不爱争辩，",
      "token_start": 798,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 177970,
      "end_ms": 179070,
      "text": "甚至恐惧社交，",
      "token_start": 802,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 179250,
      "end_ms": 181030,
      "text": "推荐你读完这本对答如流，",
      "token_start": 808,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 181290,
      "end_ms": 183290,
      "text": "让你轻松摆平各种社交场合，",
      "token_start": 819,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 183530,
      "end_ms": 184430,
      "text": "每天看两页，",
      "token_start": 831,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 184550,
      "end_ms": 185925,
      "text": "每一个场景慢慢练，",
      "token_start": 836,
      "token_end_exclusive": 844
    },
    {
      "start_ms": 186190,
      "end_ms": 189075,
      "text": "你就会变成一个会说话、懂交际的人。",
      "token_start": 844,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 189500,
      "end_ms": 190840,
      "text": "在这本书里有一句话，",
      "token_start": 859,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 190900,
      "end_ms": 191895,
      "text": "我特别欣赏，",
      "token_start": 868,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 192350,
      "end_ms": 192490,
      "text": "他，",
      "token_start": 873,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 192490,
      "end_ms": 194910,
      "text": "写的是面对别人夸你优秀时，",
      "token_start": 874,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 195130,
      "end_ms": 195810,
      "text": "你可以回，",
      "token_start": 886,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 196090,
      "end_ms": 197230,
      "text": "那是不优秀点，",
      "token_start": 890,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 197390,
      "end_ms": 198855,
      "text": "怎么能和你做朋友呢？",
      "token_start": 896,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 199400,
      "end_ms": 201135,
      "text": "当有人说你真聪明，",
      "token_start": 905,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 201430,
      "end_ms": 203370,
      "text": "你就回近朱者赤，",
      "token_start": 913,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 203630,
      "end_ms": 204650,
      "text": "和你在一起啊，",
      "token_start": 920,
      "token_end_exclusive": 926
    },
    {
      "start_ms": 204770,
      "end_ms": 207860,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 926,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 207900,
      "end_ms": 209160,
      "text": "你就回领导，",
      "token_start": 941,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 209340,
      "end_ms": 210815,
      "text": "这都是我应该做的。",
      "token_start": 946,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 211130,
      "end_ms": 212585,
      "text": "强将手下吴若兵，",
      "token_start": 954,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 213010,
      "end_ms": 214530,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 961,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 214710,
      "end_ms": 215950,
      "text": "当我看到这段的时候，",
      "token_start": 970,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 215950,
      "end_ms": 217730,
      "text": "真是让我欲解心开啊。",
      "token_start": 979,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 217890,
      "end_ms": 219295,
      "text": "每一句都很有意思，",
      "token_start": 988,
      "token_end_exclusive": 996
    },
    {
      "start_ms": 219730,
      "end_ms": 222950,
      "text": "就是手把手教我们在不同场景之下应该怎么说。",
      "token_start": 996,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 223270,
      "end_ms": 226385,
      "text": "书籍的内容和我现在展示的是一模一样的，",
      "token_start": 1016,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 226750,
      "end_ms": 228195,
      "text": "你就放心的拿回去看，",
      "token_start": 1034,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 228620,
      "end_ms": 230255,
      "text": "就是一句一句的教你，",
      "token_start": 1043,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 230680,
      "end_ms": 233000,
      "text": "让你轻松摆平各种社交场合。",
      "token_start": 1052,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 233240,
      "end_ms": 234420,
      "text": "但凡学会三分，",
      "token_start": 1064,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 234600,
      "end_ms": 236980,
      "text": "你就能把人际关系拿捏的死死的，",
      "token_start": 1070,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 237020,
      "end_ms": 238815,
      "text": "这本书真的可以帮助到大家。",
      "token_start": 1084,
      "token_end_exclusive": 1096
    }
