  "segments": [
    {
      "start_ms": 130,
      "end_ms": 710,
      "text": "小王啊，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 1410,
      "end_ms": 3270,
      "text": "你个子是真高比，",
      "token_start": 3,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 3270,
      "end_ms": 4350,
      "text": "我还高一头呢。",
      "token_start": 10,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4550,
      "end_ms": 10150,
      "text": "个高是为了给领导探路走哪儿不还是得听领导指挥吗？",
      "token_start": 16,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 10790,
      "end_ms": 11030,
      "text": "哎，",
      "token_start": 39,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 11030,
      "end_ms": 12210,
      "text": "你什么意思啊？",
      "token_start": 40,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12210,
      "end_ms": 13490,
      "text": "怎么到我这就剩半辈了。",
      "token_start": 46,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 13670,
      "end_ms": 15110,
      "text": "领导美满美满，",
      "token_start": 56,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 15210,
      "end_ms": 16190,
      "text": "代表幸福美满，",
      "token_start": 62,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 16309,
      "end_ms": 18390,
      "text": "这一辈子美满就是一辈子美满啊。",
      "token_start": 68,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 20030,
      "end_ms": 21570,
      "text": "我真不怎么喜欢你，",
      "token_start": 82,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 22250,
      "end_ms": 24330,
      "text": "但您从来没有在工作上为难过，",
      "token_start": 90,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 24330,
      "end_ms": 26490,
      "text": "我领导的格局值得我们学习。",
      "token_start": 103,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 28950,
      "end_ms": 29450,
      "text": "小王啊，",
      "token_start": 115,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 30060,
      "end_ms": 31600,
      "text": "你这菜点的也太多了，",
      "token_start": 118,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 32080,
      "end_ms": 33700,
      "text": "领导菜点的再多，",
      "token_start": 127,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 33700,
      "end_ms": 36040,
      "text": "也比不上平时您对我的照顾多这杯酒，",
      "token_start": 134,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 36100,
      "end_ms": 39280,
      "text": "我先敬您打这么多饭，",
      "token_start": 150,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 39420,
      "end_ms": 40180,
      "text": "你喂猪呢？",
      "token_start": 159,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 40400,
      "end_ms": 40840,
      "text": "领导，",
      "token_start": 163,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 40840,
      "end_ms": 41620,
      "text": "我哪敢啊？",
      "token_start": 165,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 41760,
      "end_ms": 43880,
      "text": "我还以为您的饭量和肚量是一样的呢，",
      "token_start": 169,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 43900,
      "end_ms": 45500,
      "text": "都说宰相肚里能撑船，",
      "token_start": 185,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 45660,
      "end_ms": 47000,
      "text": "更何况只是一碗饭呢。",
      "token_start": 194,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 48280,
      "end_ms": 48640,
      "text": "小李，",
      "token_start": 203,
      "token_end_exclusive": 205
    },
    {
      "start_ms": 48640,
      "end_ms": 49760,
      "text": "最近表现不错啊，",
      "token_start": 205,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 50040,
      "end_ms": 51840,
      "text": "我的这个位置马上就该你坐了，",
      "token_start": 212,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 51940,
      "end_ms": 53140,
      "text": "我得提前敬你一杯。",
      "token_start": 225,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 53300,
      "end_ms": 54000,
      "text": "听这意思，",
      "token_start": 233,
      "token_end_exclusive": 237
    },
    {
      "start_ms": 54040,
      "end_ms": 55280,
      "text": "领导也要高升了呀，",
      "token_start": 237,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 55280,
      "end_ms": 56640,
      "text": "我得提前敬领导一杯。",
      "token_start": 245,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 58400,
      "end_ms": 59520,
      "text": "怎么你这一入职，",
      "token_start": 254,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 60040,
      "end_ms": 61415,
      "text": "我刚种的花就死了，",
      "token_start": 261,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 62390,
      "end_ms": 63390,
      "text": "花开富贵嘛，",
      "token_start": 269,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 63430,
      "end_ms": 64875,
      "text": "花开过了就剩富贵了。",
      "token_start": 274,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 65130,
      "end_ms": 66765,
      "text": "看来领导您啊要发大财了。",
      "token_start": 283,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 67190,
      "end_ms": 70005,
      "text": "哈哈哈啊哈你酒量挺好的呀，",
      "token_start": 294,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 70360,
      "end_ms": 71880,
      "text": "领导您可抬举我了，",
      "token_start": 306,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 71960,
      "end_ms": 73060,
      "text": "我平时真不太能喝。",
      "token_start": 314,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 73260,
      "end_ms": 74700,
      "text": "这不今天和您在一起吃饭，",
      "token_start": 322,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 74700,
      "end_ms": 75320,
      "text": "高兴啊，",
      "token_start": 333,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 75320,
      "end_ms": 77425,
      "text": "这一高兴就多贪了几杯。",
      "token_start": 336,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 78490,
      "end_ms": 79045,
      "text": "关注我，",
      "token_start": 346,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 79380,
      "end_ms": 80980,
      "text": "每天学点儿高情商，",
      "token_start": 349,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 80980,
      "end_ms": 81695,
      "text": "说话技巧，",
      "token_start": 357,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 82000,
      "end_ms": 83875,
      "text": "让你的路越走越宽。",
      "token_start": 361,
      "token_end_exclusive": 369
    }
  ],
