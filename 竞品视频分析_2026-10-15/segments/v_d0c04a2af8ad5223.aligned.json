{
  "video_id": "v_d0c04a2af8ad5223",
  "duration_s": 532.015011,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_d0c04a2af8ad5223.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_d0c04a2af8ad5223.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 2670,
      "text": "上一集我们算了王成书三回，",
      "token_start": 0,
      "token_end_exclusive": 12
    },
    {
      "start_ms": 2690,
      "end_ms": 3630,
      "text": "我愿意的账，",
      "token_start": 12,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4150,
      "end_ms": 5550,
      "text": "四十六岁清零，",
      "token_start": 17,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 6010,
      "end_ms": 7410,
      "text": "四十九岁消失，",
      "token_start": 23,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 8130,
      "end_ms": 9730,
      "text": "把余生也交出去。",
      "token_start": 29,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 10410,
      "end_ms": 12850,
      "text": "很多女性观众看完留言说，",
      "token_start": 36,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 13170,
      "end_ms": 14230,
      "text": "太不容易了，",
      "token_start": 47,
      "token_end_exclusive": 52
    },
    {
      "start_ms": 14790,
      "end_ms": 19670,
      "text": "一个女人在全是男人的领域里得扛多少压力。",
      "token_start": 52,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 20130,
      "end_ms": 23030,
      "text": "今天这集我们就专门讲讲这个，",
      "token_start": 71,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 23570,
      "end_ms": 24690,
      "text": "我先问你个问题，",
      "token_start": 84,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 25010,
      "end_ms": 29550,
      "text": "中国第一颗原子弹团队里有没有女科学家？",
      "token_start": 91,
      "token_end_exclusive": 109
    },
    {
      "start_ms": 29690,
      "end_ms": 30940,
      "text": "大量大部分人摇头，",
      "token_start": 109,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 31440,
      "end_ms": 39570,
      "text": "再问邓稼先、钱学森、于敏这些名字后头有没有一个女人有。",
      "token_start": 117,
      "token_end_exclusive": 141
    },
    {
      "start_ms": 40790,
      "end_ms": 49690,
      "text": "而且在核燃料浓缩这个最关键的环节只有一位当年在甘肃兰州的武陵寺厂，",
      "token_start": 141,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 50430,
      "end_ms": 53390,
      "text": "中国第一座浓缩油工厂。",
      "token_start": 173,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 53910,
      "end_ms": 55490,
      "text": "那么多科研人员里，",
      "token_start": 183,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 55590,
      "end_ms": 56910,
      "text": "她是唯一的女性，",
      "token_start": 191,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 57350,
      "end_ms": 62705,
      "text": "把镜头拉远到整个中国的核武研制核心队伍，",
      "token_start": 198,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 63190,
      "end_ms": 66115,
      "text": "他也是极少数的女科学家之一。",
      "token_start": 217,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 66660,
      "end_ms": 70265,
      "text": "西方媒体给他起了个外号中国的居里夫人，",
      "token_start": 230,
      "token_end_exclusive": 248
    },
    {
      "start_ms": 70620,
      "end_ms": 73545,
      "text": "可居里夫人拿了两座诺贝尔奖，",
      "token_start": 248,
      "token_end_exclusive": 261
    },
    {
      "start_ms": 73930,
      "end_ms": 75385,
      "text": "名字刻遍全世界。",
      "token_start": 261,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 75650,
      "end_ms": 79895,
      "text": "这位中国的居里夫人名字被他自己亲手藏了三十年。",
      "token_start": 268,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 80400,
      "end_ms": 81735,
      "text": "藏到离世的那天，",
      "token_start": 290,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 82150,
      "end_ms": 84085,
      "text": "全国没几个人知道他是谁。",
      "token_start": 297,
      "token_end_exclusive": 308
    },
    {
      "start_ms": 84570,
      "end_ms": 85585,
      "text": "他叫王成书，",
      "token_start": 308,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 86660,
      "end_ms": 94065,
      "text": "今天这集讲讲这个用一辈子把谁说女子不如男的话烙印在骨子里的女人。",
      "token_start": 313,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 95250,
      "end_ms": 96155,
      "text": "一九一二年，",
      "token_start": 344,
      "token_end_exclusive": 349
    },
    {
      "start_ms": 96460,
      "end_ms": 97980,
      "text": "他生在上海一个诗书，",
      "token_start": 349,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 97980,
      "end_ms": 100825,
      "text": "人家名字取自尚书，",
      "token_start": 358,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 101370,
      "end_ms": 102585,
      "text": "家里四个姐妹，",
      "token_start": 366,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 102900,
      "end_ms": 103585,
      "text": "他排第二。",
      "token_start": 372,
      "token_end_exclusive": 376
    },
    {
      "start_ms": 104500,
      "end_ms": 108155,
      "text": "小时候家里凡是跟数字沾边的活，",
      "token_start": 376,
      "token_end_exclusive": 390
    },
    {
      "start_ms": 108610,
      "end_ms": 112035,
      "text": "全归他这姑娘的数学回回考第一。",
      "token_start": 390,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 112490,
      "end_ms": 114265,
      "text": "一九三零年十八岁，",
      "token_start": 404,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 114610,
      "end_ms": 116825,
      "text": "他考进燕京大学物理系。",
      "token_start": 412,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 117520,
      "end_ms": 120155,
      "text": "那届物理系只录取了十三个新生，",
      "token_start": 422,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 120940,
      "end_ms": 122905,
      "text": "其中女生就她一根独苗。",
      "token_start": 436,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 123460,
      "end_ms": 125305,
      "text": "那个年代的风言风语，",
      "token_start": 446,
      "token_end_exclusive": 455
    },
    {
      "start_ms": 125770,
      "end_ms": 132475,
      "text": "你闭着眼都能想到女孩子家读什么物理公式和仪器，",
      "token_start": 455,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 132760,
      "end_ms": 133965,
      "text": "那是女人玩的吗？",
      "token_start": 477,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 135250,
      "end_ms": 136350,
      "text": "王成书一句，",
      "token_start": 484,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 136370,
      "end_ms": 137045,
      "text": "不辩解，",
      "token_start": 489,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 138070,
      "end_ms": 139775,
      "text": "他的回应方式就一个字，",
      "token_start": 492,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 140360,
      "end_ms": 141400,
      "text": "考大一第一，",
      "token_start": 502,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 141400,
      "end_ms": 143315,
      "text": "大二、第一、大三还是第一。",
      "token_start": 507,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 144160,
      "end_ms": 145785,
      "text": "一九三四年毕业，",
      "token_start": 517,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 146270,
      "end_ms": 150390,
      "text": "那十三个人里能撑着拿到学位的只剩四个，",
      "token_start": 524,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 150390,
      "end_ms": 151485,
      "text": "他年年榜首，",
      "token_start": 542,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 151830,
      "end_ms": 156795,
      "text": "还领走了燕大给物理系学生的最高荣誉金钥匙奖。",
      "token_start": 547,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 157840,
      "end_ms": 161615,
      "text": "一九三六年拿到硕士学位留校任教，",
      "token_start": 568,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 162340,
      "end_ms": 163880,
      "text": "他把女生学不了理科。",
      "token_start": 583,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 163880,
      "end_ms": 167015,
      "text": "这句话从一九三零年考到一九三六年，",
      "token_start": 592,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 167810,
      "end_ms": 169335,
      "text": "考到没人敢再说，",
      "token_start": 608,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 170150,
      "end_ms": 171515,
      "text": "这是他第一次打脸。",
      "token_start": 615,
      "token_end_exclusive": 623
    },
    {
      "start_ms": 172700,
      "end_ms": 174135,
      "text": "可燕大的天花板，",
      "token_start": 623,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 174970,
      "end_ms": 176735,
      "text": "只是燕大的天花板，",
      "token_start": 630,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 178340,
      "end_ms": 179095,
      "text": "不是他的。",
      "token_start": 638,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 179590,
      "end_ms": 180765,
      "text": "一九三九年，",
      "token_start": 642,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 181110,
      "end_ms": 183155,
      "text": "他跟物理学家张文玉结婚，",
      "token_start": 647,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 183790,
      "end_ms": 186510,
      "text": "一九四一年夫妻俩双双赴美，",
      "token_start": 658,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 186510,
      "end_ms": 189250,
      "text": "他进了密歇根大学导师，",
      "token_start": 670,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 189310,
      "end_ms": 192755,
      "text": "是国际物理学权威人物呼伦贝克，",
      "token_start": 680,
      "token_end_exclusive": 694
    },
    {
      "start_ms": 193130,
      "end_ms": 194745,
      "text": "婚后女眷出国，",
      "token_start": 694,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 195460,
      "end_ms": 196760,
      "text": "那个年代有多难，",
      "token_start": 700,
      "token_end_exclusive": 707
    },
    {
      "start_ms": 196980,
      "end_ms": 197785,
      "text": "你自己品，",
      "token_start": 707,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 198260,
      "end_ms": 199255,
      "text": "他不但出去了，",
      "token_start": 711,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 199750,
      "end_ms": 200855,
      "text": "还出去就炸了。",
      "token_start": 717,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 202220,
      "end_ms": 204355,
      "text": "一九四四年拿到博士学位。",
      "token_start": 723,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 205230,
      "end_ms": 206195,
      "text": "一九五一年，",
      "token_start": 734,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 206570,
      "end_ms": 209860,
      "text": "他跟导师把气体分子运动论理一道，",
      "token_start": 739,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 209880,
      "end_ms": 212040,
      "text": "横贯国际学界的难题，",
      "token_start": 754,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 212180,
      "end_ms": 213890,
      "text": "解开了方程，",
      "token_start": 763,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 213890,
      "end_ms": 216575,
      "text": "直接以两人姓氏命名。",
      "token_start": 768,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 216930,
      "end_ms": 219325,
      "text": "王成书乌伦贝克方程，",
      "token_start": 777,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 219940,
      "end_ms": 221795,
      "text": "简称WCU方程，",
      "token_start": 786,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 222270,
      "end_ms": 225410,
      "text": "一经发表轰动世界物理学界，",
      "token_start": 791,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 225430,
      "end_ms": 228405,
      "text": "至今还是这个领域的经典工具。",
      "token_start": 803,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 228920,
      "end_ms": 230595,
      "text": "他顺手还干了件事儿，",
      "token_start": 816,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 231020,
      "end_ms": 237925,
      "text": "把查普曼考林那本权威教科书非均匀气体的数学理论里的系数错误，",
      "token_start": 825,
      "token_end_exclusive": 854
    },
    {
      "start_ms": 238500,
      "end_ms": 240345,
      "text": "当众纠正了过来。",
      "token_start": 854,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 241330,
      "end_ms": 243095,
      "text": "西方学术界炸了锅，",
      "token_start": 861,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 243580,
      "end_ms": 246435,
      "text": "搞出这一切的居然是个中国人，",
      "token_start": 869,
      "token_end_exclusive": 882
    },
    {
      "start_ms": 246920,
      "end_ms": 248305,
      "text": "而且还是个女人，",
      "token_start": 882,
      "token_end_exclusive": 889
    },
    {
      "start_ms": 248870,
      "end_ms": 253175,
      "text": "这颠覆了他们对中国人对女人的一切想象。",
      "token_start": 889,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 253670,
      "end_ms": 255125,
      "text": "导石乌伦贝克断言，",
      "token_start": 907,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 255430,
      "end_ms": 257235,
      "text": "这是不可多得的人才，",
      "token_start": 915,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 257880,
      "end_ms": 260990,
      "text": "留在美国诺贝尔奖只是时间问题，",
      "token_start": 924,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 261190,
      "end_ms": 262435,
      "text": "这是他第二次打脸。",
      "token_start": 938,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 263030,
      "end_ms": 265025,
      "text": "在西方人自己的主场，",
      "token_start": 946,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 265530,
      "end_ms": 269205,
      "text": "把诺奖级成果一个接一个掏出来。",
      "token_start": 955,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 270200,
      "end_ms": 275515,
      "text": "一个女人在美国人自己的地盘上要名有名，",
      "token_start": 969,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 276090,
      "end_ms": 276825,
      "text": "要利有利。",
      "token_start": 987,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 278080,
      "end_ms": 282045,
      "text": "普林斯顿高级研究所两度向他敞开大门，",
      "token_start": 991,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 282500,
      "end_ms": 283865,
      "text": "然后他不要了。",
      "token_start": 1008,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 285020,
      "end_ms": 286020,
      "text": "一九四九年，",
      "token_start": 1014,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 286020,
      "end_ms": 286935,
      "text": "新中国成立，",
      "token_start": 1019,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 287210,
      "end_ms": 290875,
      "text": "她跟丈夫第二天就把回国俩字焊在了心口上。",
      "token_start": 1024,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 291550,
      "end_ms": 293725,
      "text": "美国不许走朝鲜战争，",
      "token_start": 1043,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 294000,
      "end_ms": 294600,
      "text": "一开打，",
      "token_start": 1052,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 294700,
      "end_ms": 297380,
      "text": "直接下禁令监视传讯扣，",
      "token_start": 1055,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 297380,
      "end_ms": 299735,
      "text": "人一扣就是整整七年。",
      "token_start": 1065,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 300220,
      "end_ms": 301660,
      "text": "他把家产送人，",
      "token_start": 1074,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 301900,
      "end_ms": 303960,
      "text": "把资料分成三百多个邮包，",
      "token_start": 1080,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 303960,
      "end_ms": 308135,
      "text": "蚂蚁搬家一样寄回祖国一九五六年十月。",
      "token_start": 1091,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 308450,
      "end_ms": 311270,
      "text": "终于他们回到祖国回来之后，",
      "token_start": 1108,
      "token_end_exclusive": 1120
    },
    {
      "start_ms": 311530,
      "end_ms": 313970,
      "text": "老天爷给他安排了第三次考验，",
      "token_start": 1120,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 314470,
      "end_ms": 316050,
      "text": "专门试一个女人，",
      "token_start": 1133,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 316130,
      "end_ms": 317850,
      "text": "把国家看得有多重。",
      "token_start": 1140,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 318790,
      "end_ms": 319830,
      "text": "一九五八年，",
      "token_start": 1148,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 320330,
      "end_ms": 323830,
      "text": "钱三强请他转行搞热核巨变，",
      "token_start": 1153,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 324330,
      "end_ms": 326290,
      "text": "国内这方面还是一片空白。",
      "token_start": 1165,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 327190,
      "end_ms": 330950,
      "text": "四十六岁的他专业已经定型，",
      "token_start": 1176,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 331750,
      "end_ms": 333470,
      "text": "说作废就作废。",
      "token_start": 1188,
      "token_end_exclusive": 1194
    },
    {
      "start_ms": 333550,
      "end_ms": 340170,
      "text": "他说我愿意后来用了两年自学俄语，",
      "token_start": 1194,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 340670,
      "end_ms": 343290,
      "text": "在火车上七天七夜，",
      "token_start": 1209,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 343650,
      "end_ms": 345930,
      "text": "翻译俄语的学武德方案，",
      "token_start": 1217,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 346730,
      "end_ms": 350770,
      "text": "直接成了中国热核巨变研究的开创者。",
      "token_start": 1227,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 351370,
      "end_ms": 360570,
      "text": "一九六一年苏联专家全部卷图纸跑光何然料浓缩有卡脖子钱三强把话给他挑明了，",
      "token_start": 1243,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 360850,
      "end_ms": 361890,
      "text": "要绝对保密，",
      "token_start": 1278,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 362070,
      "end_ms": 362970,
      "text": "不能发论文，",
      "token_start": 1283,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 363090,
      "end_ms": 364950,
      "text": "不能开会去向，",
      "token_start": 1288,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 364990,
      "end_ms": 366355,
      "text": "连丈夫都不能讲。",
      "token_start": 1294,
      "token_end_exclusive": 1301
    },
    {
      "start_ms": 367020,
      "end_ms": 370015,
      "text": "王成书这个人等于从世界上抹除。",
      "token_start": 1301,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 370130,
      "end_ms": 370295,
      "text": "嗯，",
      "token_start": 1315,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 370750,
      "end_ms": 372065,
      "text": "他说我愿意。",
      "token_start": 1316,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 372330,
      "end_ms": 373235,
      "text": "一九六二年，",
      "token_start": 1321,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 373620,
      "end_ms": 376055,
      "text": "他悄悄去了兰州武林市场，",
      "token_start": 1326,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 376450,
      "end_ms": 377995,
      "text": "丈夫在外承担任务，",
      "token_start": 1337,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 378450,
      "end_ms": 379815,
      "text": "儿子独自住校，",
      "token_start": 1345,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 380210,
      "end_ms": 381875,
      "text": "一家三口天各一方，",
      "token_start": 1351,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 382810,
      "end_ms": 384685,
      "text": "全场那么多科研人员，",
      "token_start": 1359,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 385190,
      "end_ms": 386105,
      "text": "就他一个女的，",
      "token_start": 1368,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 387400,
      "end_ms": 388995,
      "text": "你能想象那个画面吗？",
      "token_start": 1374,
      "token_end_exclusive": 1383
    },
    {
      "start_ms": 389980,
      "end_ms": 395025,
      "text": "大西北戈壁滩边上的工厂全是男的，",
      "token_start": 1383,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 395970,
      "end_ms": 397645,
      "text": "就一个清瘦的女人，",
      "token_start": 1398,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 398690,
      "end_ms": 400865,
      "text": "每天后半夜去抢计算机，",
      "token_start": 1406,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 401320,
      "end_ms": 403775,
      "text": "手摇计算机算到手指发麻，",
      "token_start": 1416,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 404330,
      "end_ms": 407285,
      "text": "几十箱计算纸条堆的比人高，",
      "token_start": 1427,
      "token_end_exclusive": 1439
    },
    {
      "start_ms": 407860,
      "end_ms": 411515,
      "text": "他一头黑发就这么一根一根白了。",
      "token_start": 1439,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 411710,
      "end_ms": 413490,
      "text": "有一次领导来视察，",
      "token_start": 1453,
      "token_end_exclusive": 1461
    },
    {
      "start_ms": 413770,
      "end_ms": 415845,
      "text": "问他能不能按时完成任务，",
      "token_start": 1461,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 416690,
      "end_ms": 418390,
      "text": "他看着对方说了一句，",
      "token_start": 1472,
      "token_end_exclusive": 1481
    },
    {
      "start_ms": 418390,
      "end_ms": 420615,
      "text": "让在场所有人都红了眼的话。",
      "token_start": 1481,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 421490,
      "end_ms": 422545,
      "text": "在我的字典里，",
      "token_start": 1493,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 422850,
      "end_ms": 427075,
      "text": "除了对孩子的承诺没有兑现对国家的要求，",
      "token_start": 1499,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 427580,
      "end_ms": 428645,
      "text": "我全能兑现，",
      "token_start": 1517,
      "token_end_exclusive": 1522
    },
    {
      "start_ms": 429200,
      "end_ms": 430965,
      "text": "他对得起四万万孩子，",
      "token_start": 1522,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 431400,
      "end_ms": 432720,
      "text": "唯独对不起自己。",
      "token_start": 1531,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 432720,
      "end_ms": 433565,
      "text": "家那一个。",
      "token_start": 1538,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 434220,
      "end_ms": 436185,
      "text": "一九六四年一月十四日，",
      "token_start": 1542,
      "token_end_exclusive": 1552
    },
    {
      "start_ms": 436540,
      "end_ms": 441225,
      "text": "第一批风度百分之九十以上的合格核燃料下线，",
      "token_start": 1552,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 441910,
      "end_ms": 445810,
      "text": "中国成为世界第五个掌握这项技术的国家。",
      "token_start": 1572,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 446030,
      "end_ms": 447045,
      "text": "十月十六日，",
      "token_start": 1590,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 447660,
      "end_ms": 449555,
      "text": "罗布泊内一声巨响，",
      "token_start": 1595,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 450020,
      "end_ms": 451775,
      "text": "蘑菇云直接升腾。",
      "token_start": 1603,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 452340,
      "end_ms": 454655,
      "text": "聂荣臻把他的名字报给毛主席。",
      "token_start": 1610,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 455190,
      "end_ms": 455985,
      "text": "毛主席说，",
      "token_start": 1623,
      "token_end_exclusive": 1627
    },
    {
      "start_ms": 456370,
      "end_ms": 460265,
      "text": "这是中国第一颗原子弹爆炸的女功臣，",
      "token_start": 1627,
      "token_end_exclusive": 1643
    },
    {
      "start_ms": 460920,
      "end_ms": 461740,
      "text": "举国沸腾。",
      "token_start": 1643,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 461740,
      "end_ms": 464505,
      "text": "那天欢庆的人群里没有他，",
      "token_start": 1647,
      "token_end_exclusive": 1658
    },
    {
      "start_ms": 464950,
      "end_ms": 466150,
      "text": "因为他早就接了。",
      "token_start": 1658,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 466150,
      "end_ms": 469355,
      "text": "第三个任需要继续隐姓埋名，",
      "token_start": 1665,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 470290,
      "end_ms": 471805,
      "text": "这是他第三次打脸，",
      "token_start": 1677,
      "token_end_exclusive": 1685
    },
    {
      "start_ms": 472690,
      "end_ms": 475955,
      "text": "用消失三十年告诉所有人，",
      "token_start": 1685,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 476340,
      "end_ms": 478545,
      "text": "女人扛得起国家的使命。",
      "token_start": 1696,
      "token_end_exclusive": 1706
    },
    {
      "start_ms": 479090,
      "end_ms": 481055,
      "text": "他这一辈子十八岁，",
      "token_start": 1706,
      "token_end_exclusive": 1714
    },
    {
      "start_ms": 481380,
      "end_ms": 482555,
      "text": "用考分打脸，",
      "token_start": 1714,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 482900,
      "end_ms": 484280,
      "text": "女生读不了理科。",
      "token_start": 1719,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 484400,
      "end_ms": 485220,
      "text": "三十九岁，",
      "token_start": 1726,
      "token_end_exclusive": 1730
    },
    {
      "start_ms": 485240,
      "end_ms": 488295,
      "text": "用方程打脸中国人搞不了物理，",
      "token_start": 1730,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 488730,
      "end_ms": 493705,
      "text": "四十九岁用消失三十年打脸女人扛不起国家的使命。",
      "token_start": 1743,
      "token_end_exclusive": 1765
    },
    {
      "start_ms": 494240,
      "end_ms": 496655,
      "text": "西方叫他中国的居里夫人，",
      "token_start": 1765,
      "token_end_exclusive": 1776
    },
    {
      "start_ms": 497240,
      "end_ms": 497960,
      "text": "他摆摆手，",
      "token_start": 1776,
      "token_end_exclusive": 1780
    },
    {
      "start_ms": 497980,
      "end_ms": 498385,
      "text": "不要，",
      "token_start": 1780,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 498730,
      "end_ms": 498930,
      "text": "他，",
      "token_start": 1782,
      "token_end_exclusive": 1783
    },
    {
      "start_ms": 498930,
      "end_ms": 500465,
      "text": "只要国家需要时，",
      "token_start": 1783,
      "token_end_exclusive": 1790
    },
    {
      "start_ms": 500830,
      "end_ms": 502485,
      "text": "那三个字说得出口，",
      "token_start": 1790,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 503550,
      "end_ms": 504230,
      "text": "下一集。",
      "token_start": 1798,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 504430,
      "end_ms": 506235,
      "text": "王成书系列大结局，",
      "token_start": 1801,
      "token_end_exclusive": 1809
    },
    {
      "start_ms": 507020,
      "end_ms": 508120,
      "text": "一九九四年，",
      "token_start": 1809,
      "token_end_exclusive": 1814
    },
    {
      "start_ms": 508120,
      "end_ms": 508875,
      "text": "他走了，",
      "token_start": 1814,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 509300,
      "end_ms": 514050,
      "text": "留下三份遗嘱遗体手稿全部存款，",
      "token_start": 1817,
      "token_end_exclusive": 1831
    },
    {
      "start_ms": 514210,
      "end_ms": 514925,
      "text": "一样不剩，",
      "token_start": 1831,
      "token_end_exclusive": 1835
    },
    {
      "start_ms": 515270,
      "end_ms": 516235,
      "text": "全给了国家。",
      "token_start": 1835,
      "token_end_exclusive": 1840
    },
    {
      "start_ms": 516700,
      "end_ms": 518320,
      "text": "他把名字还给了时代，",
      "token_start": 1840,
      "token_end_exclusive": 1849
    },
    {
      "start_ms": 518440,
      "end_ms": 520320,
      "text": "把遗体还给了医学研究，",
      "token_start": 1849,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 520340,
      "end_ms": 522595,
      "text": "把积蓄还给了孩子，",
      "token_start": 1859,
      "token_end_exclusive": 1867
    },
    {
      "start_ms": 522930,
      "end_ms": 525605,
      "text": "唯独没给自己留一点私心，",
      "token_start": 1867,
      "token_end_exclusive": 1878
    },
    {
      "start_ms": 525910,
      "end_ms": 528445,
      "text": "点个红心收藏这条视频，",
      "token_start": 1878,
      "token_end_exclusive": 1888
    },
    {
      "start_ms": 528800,
      "end_ms": 529655,
      "text": "转发出去，",
      "token_start": 1888,
      "token_end_exclusive": 1892
    },
    {
      "start_ms": 530520,
      "end_ms": 531165,
      "text": "关注我，",
      "token_start": 1892,
      "token_end_exclusive": 1895
    },
    {
      "start_ms": 531380,
      "end_ms": 531945,
      "text": "大结局见。",
      "token_start": 1895,
      "token_end_exclusive": 1899
    }
  ],
