{
  "video_id": "v_dfc401eb3c58695b",
  "duration_s": 334.830998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_dfc401eb3c58695b.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_dfc401eb3c58695b.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 2130,
      "text": "二零零八年八月十五号，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 2790,
      "end_ms": 4930,
      "text": "北京奥运女排小组赛，",
      "token_start": 10,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 5550,
      "end_ms": 8650,
      "text": "中国队对美国队哨声一响，",
      "token_start": 19,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 9270,
      "end_ms": 11390,
      "text": "满场中国人喊的不是加油，",
      "token_start": 30,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 11630,
      "end_ms": 12290,
      "text": "是郎平。",
      "token_start": 41,
      "token_end_exclusive": 44
    },
    {
      "start_ms": 13290,
      "end_ms": 14310,
      "text": "你对得起谁？",
      "token_start": 44,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 14910,
      "end_ms": 17310,
      "text": "他站在对面教练席面无表情，",
      "token_start": 49,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 17310,
      "end_ms": 18870,
      "text": "最后美国队赢了。",
      "token_start": 61,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 18870,
      "end_ms": 20190,
      "text": "那天晚上，",
      "token_start": 68,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 20190,
      "end_ms": 23110,
      "text": "他手机炸说信一条，",
      "token_start": 72,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 23110,
      "end_ms": 24770,
      "text": "接一条全是骂他的，",
      "token_start": 80,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 24770,
      "end_ms": 26430,
      "text": "说他胳膊肘往外拐，",
      "token_start": 88,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 26430,
      "end_ms": 29130,
      "text": "说他忘了自己姓姓么么。",
      "token_start": 96,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 29270,
      "end_ms": 30640,
      "text": "他在在中国中国挣钱，",
      "token_start": 106,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 30640,
      "end_ms": 35020,
      "text": "在美国花最难听的直接骂他吃里扒外，",
      "token_start": 115,
      "token_end_exclusive": 131
    },
    {
      "start_ms": 35100,
      "end_ms": 36120,
      "text": "他一条一条，",
      "token_start": 131,
      "token_end_exclusive": 136
    },
    {
      "start_ms": 36120,
      "end_ms": 37280,
      "text": "看完没回，",
      "token_start": 136,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 38220,
      "end_ms": 39200,
      "text": "但你知道吗？",
      "token_start": 140,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 39820,
      "end_ms": 41000,
      "text": "就在三年前，",
      "token_start": 145,
      "token_end_exclusive": 150
    },
    {
      "start_ms": 41560,
      "end_ms": 43640,
      "text": "他刚做完一次大手术，",
      "token_start": 150,
      "token_end_exclusive": 159
    },
    {
      "start_ms": 44100,
      "end_ms": 46680,
      "text": "膝盖里的髌骨整个摘掉。",
      "token_start": 159,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 47920,
      "end_ms": 54220,
      "text": "医生说你这腿以后能正常走路就不错了。",
      "token_start": 169,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 54580,
      "end_ms": 58120,
      "text": "他偏不故事得从一九八一年说起。",
      "token_start": 186,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 58680,
      "end_ms": 59060,
      "text": "那年，",
      "token_start": 200,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 59060,
      "end_ms": 61555,
      "text": "郎平二十一岁东京体育馆，",
      "token_start": 202,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 61850,
      "end_ms": 65370,
      "text": "中国女排对日本全场日本观众嘘声。",
      "token_start": 213,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 65450,
      "end_ms": 65965,
      "text": "震天，",
      "token_start": 228,
      "token_end_exclusive": 230
    },
    {
      "start_ms": 66550,
      "end_ms": 70535,
      "text": "日本教练在场边做鬼脸主教练袁伟民。",
      "token_start": 230,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 70940,
      "end_ms": 72475,
      "text": "赛前只说了一句话，",
      "token_start": 246,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 72920,
      "end_ms": 74440,
      "text": "全国人民都看着了，",
      "token_start": 254,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 74520,
      "end_ms": 75255,
      "text": "拿不下来，",
      "token_start": 262,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 75640,
      "end_ms": 76715,
      "text": "后悔一辈子。",
      "token_start": 266,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 77410,
      "end_ms": 82995,
      "text": "第五局郎平跳起来一记中扣球砸在对方场地里。",
      "token_start": 271,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 83870,
      "end_ms": 86025,
      "text": "解说员宋师雄扯着嗓子喊，",
      "token_start": 291,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 86760,
      "end_ms": 87485,
      "text": "铁榔头，",
      "token_start": 302,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 87820,
      "end_ms": 90115,
      "text": "一锤一个雷霆三比二，",
      "token_start": 305,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 90520,
      "end_ms": 94725,
      "text": "中国队赢了中国三大球第一个世界冠军。",
      "token_start": 314,
      "token_end_exclusive": 331
    },
    {
      "start_ms": 95620,
      "end_ms": 96380,
      "text": "那天晚上，",
      "token_start": 331,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 96460,
      "end_ms": 98385,
      "text": "多少人家的收音机开着，",
      "token_start": 335,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 98730,
      "end_ms": 99765,
      "text": "多少人哭了，",
      "token_start": 345,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 100280,
      "end_ms": 101405,
      "text": "随后是五连冠，",
      "token_start": 350,
      "token_end_exclusive": 356
    },
    {
      "start_ms": 101850,
      "end_ms": 105055,
      "text": "中国女排成了一个时代的符号，",
      "token_start": 356,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 105620,
      "end_ms": 107045,
      "text": "可代价是什么？",
      "token_start": 369,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 108600,
      "end_ms": 109965,
      "text": "二十五岁的郎平，",
      "token_start": 375,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 110510,
      "end_ms": 113045,
      "text": "膝盖磨损的像七十岁的老人，",
      "token_start": 382,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 113650,
      "end_ms": 115345,
      "text": "髌骨软骨膜没了，",
      "token_start": 394,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 115660,
      "end_ms": 119550,
      "text": "脖子以下做过几十次手术训练的时候，",
      "token_start": 401,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 119710,
      "end_ms": 121525,
      "text": "木屑扎进掌心，",
      "token_start": 417,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 122260,
      "end_ms": 123695,
      "text": "他拿胶布一缠，",
      "token_start": 423,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 124230,
      "end_ms": 124725,
      "text": "接着练。",
      "token_start": 429,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 126500,
      "end_ms": 127545,
      "text": "一九八六年，",
      "token_start": 432,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 128420,
      "end_ms": 129375,
      "text": "他打不动了，",
      "token_start": 437,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 130490,
      "end_ms": 131165,
      "text": "退役，",
      "token_start": 442,
      "token_end_exclusive": 444
    },
    {
      "start_ms": 132290,
      "end_ms": 133105,
      "text": "按理说，",
      "token_start": 444,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 134690,
      "end_ms": 139850,
      "text": "五连冠的功臣安排个体委副主任的位置，",
      "token_start": 447,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 139910,
      "end_ms": 141950,
      "text": "舒舒服服过完后半辈子，",
      "token_start": 464,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 141950,
      "end_ms": 143345,
      "text": "没人说半个不字，",
      "token_start": 474,
      "token_end_exclusive": 481
    },
    {
      "start_ms": 143800,
      "end_ms": 145525,
      "text": "领导也确实找他谈了，",
      "token_start": 481,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 145870,
      "end_ms": 147085,
      "text": "官位都摆到桌上，",
      "token_start": 490,
      "token_end_exclusive": 497
    },
    {
      "start_ms": 147630,
      "end_ms": 148325,
      "text": "他拒绝了。",
      "token_start": 497,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 149300,
      "end_ms": 152415,
      "text": "他说我不是当官的料，",
      "token_start": 501,
      "token_end_exclusive": 510
    },
    {
      "start_ms": 152960,
      "end_ms": 154685,
      "text": "我想去学点真东西，",
      "token_start": 510,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 155210,
      "end_ms": 159195,
      "text": "一个人拎着箱子自费去美国留学。",
      "token_start": 518,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 160060,
      "end_ms": 162015,
      "text": "在国内她是国民女神，",
      "token_start": 532,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 162470,
      "end_ms": 164775,
      "text": "扣球动作印在邮票上，",
      "token_start": 541,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 165100,
      "end_ms": 167215,
      "text": "粉丝来信能堆满一屋子。",
      "token_start": 550,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 167770,
      "end_ms": 169845,
      "text": "到了美国没人认识他。",
      "token_start": 560,
      "token_end_exclusive": 569
    },
    {
      "start_ms": 170480,
      "end_ms": 171500,
      "text": "为了挣学费，",
      "token_start": 569,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 171680,
      "end_ms": 174760,
      "text": "他去排球夏令营哄小孩子打球，",
      "token_start": 574,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 174920,
      "end_ms": 176995,
      "text": "去小俱乐部打业余比赛。",
      "token_start": 587,
      "token_end_exclusive": 597
    },
    {
      "start_ms": 177660,
      "end_ms": 179345,
      "text": "有一次膝盖软骨碎了，",
      "token_start": 597,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 179840,
      "end_ms": 181280,
      "text": "关节里全是基叶，",
      "token_start": 606,
      "token_end_exclusive": 613
    },
    {
      "start_ms": 181740,
      "end_ms": 181980,
      "text": "腿，",
      "token_start": 613,
      "token_end_exclusive": 614
    },
    {
      "start_ms": 182000,
      "end_ms": 183080,
      "text": "弯都弯不下来，",
      "token_start": 614,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 183440,
      "end_ms": 184940,
      "text": "队医把基叶抽出来，",
      "token_start": 620,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 185100,
      "end_ms": 187420,
      "text": "他咬着牙上场打一局，",
      "token_start": 628,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 187420,
      "end_ms": 188900,
      "text": "抽一次就这么熬了。",
      "token_start": 637,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 188900,
      "end_ms": 189360,
      "text": "八年，",
      "token_start": 645,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 189780,
      "end_ms": 191260,
      "text": "在美国总算站稳了。",
      "token_start": 647,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 192120,
      "end_ms": 192720,
      "text": "大房子，",
      "token_start": 655,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 192720,
      "end_ms": 194320,
      "text": "有了工作，",
      "token_start": 658,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 194320,
      "end_ms": 194740,
      "text": "有了，",
      "token_start": 662,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 195420,
      "end_ms": 196660,
      "text": "女儿也五岁了。",
      "token_start": 664,
      "token_end_exclusive": 670
    },
    {
      "start_ms": 197620,
      "end_ms": 200660,
      "text": "后来一九九五年一个电话打过来，",
      "token_start": 670,
      "token_end_exclusive": 684
    },
    {
      "start_ms": 202120,
      "end_ms": 205520,
      "text": "中国女排跌到世界第八了，",
      "token_start": 684,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 206480,
      "end_ms": 208360,
      "text": "不是输几场球的事儿，",
      "token_start": 695,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 208360,
      "end_ms": 210050,
      "text": "是新金气。",
      "token_start": 704,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 210070,
      "end_ms": 212150,
      "text": "没了主力队员，",
      "token_start": 708,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 212150,
      "end_ms": 217330,
      "text": "年纪轻轻就想一队老领导袁伟民在电话里说，",
      "token_start": 714,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 217910,
      "end_ms": 219970,
      "text": "郎平祖国需要你，",
      "token_start": 733,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 220250,
      "end_ms": 221290,
      "text": "他握着话筒，",
      "token_start": 740,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 221430,
      "end_ms": 222610,
      "text": "沉默了三分钟，",
      "token_start": 745,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 222990,
      "end_ms": 224990,
      "text": "一边是美国的大房子，",
      "token_start": 751,
      "token_end_exclusive": 760
    },
    {
      "start_ms": 225270,
      "end_ms": 226850,
      "text": "年薪二十万美金。",
      "token_start": 760,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 227270,
      "end_ms": 231390,
      "text": "五岁的女儿另一边是国内十平米的宿舍，",
      "token_start": 767,
      "token_end_exclusive": 784
    },
    {
      "start_ms": 232010,
      "end_ms": 233490,
      "text": "一张单人铁床，",
      "token_start": 784,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 233970,
      "end_ms": 237750,
      "text": "一年工资加补贴六千两百七十块，",
      "token_start": 790,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 237750,
      "end_ms": 240780,
      "text": "连给女儿打长租长途电话都不够，",
      "token_start": 804,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 240940,
      "end_ms": 243625,
      "text": "回来是勤奋不回来，",
      "token_start": 818,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 243990,
      "end_ms": 245455,
      "text": "谁也挑不出毛病。",
      "token_start": 826,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 245900,
      "end_ms": 248555,
      "text": "他回来回国之前，",
      "token_start": 833,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 248920,
      "end_ms": 250445,
      "text": "她跟丈夫协议离婚，",
      "token_start": 840,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 250820,
      "end_ms": 253625,
      "text": "孩子房子全留给了男方。",
      "token_start": 848,
      "token_end_exclusive": 858
    },
    {
      "start_ms": 254500,
      "end_ms": 258005,
      "text": "他拎着一个箱子住进了十平米的宿舍。",
      "token_start": 858,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 258640,
      "end_ms": 259435,
      "text": "一年以后，",
      "token_start": 874,
      "token_end_exclusive": 878
    },
    {
      "start_ms": 259830,
      "end_ms": 266275,
      "text": "亚特兰大奥运会原本一盘散沙的中国女排小组赛五战全胜，",
      "token_start": 878,
      "token_end_exclusive": 903
    },
    {
      "start_ms": 266740,
      "end_ms": 268045,
      "text": "一路杀进决赛，",
      "token_start": 903,
      "token_end_exclusive": 909
    },
    {
      "start_ms": 268320,
      "end_ms": 269105,
      "text": "拿了银牌。",
      "token_start": 909,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 269730,
      "end_ms": 270495,
      "text": "姑娘们哭，",
      "token_start": 913,
      "token_end_exclusive": 917
    },
    {
      "start_ms": 270780,
      "end_ms": 271165,
      "text": "他说，",
      "token_start": 917,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 272320,
      "end_ms": 272865,
      "text": "别哭，",
      "token_start": 919,
      "token_end_exclusive": 921
    },
    {
      "start_ms": 273820,
      "end_ms": 276445,
      "text": "这块银牌比金牌还重，",
      "token_start": 921,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 277640,
      "end_ms": 278860,
      "text": "你以为这就完了？",
      "token_start": 930,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 278920,
      "end_ms": 280855,
      "text": "没有身体又垮了，",
      "token_start": 937,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 281200,
      "end_ms": 281965,
      "text": "只能离开。",
      "token_start": 944,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 282440,
      "end_ms": 283420,
      "text": "二零零五年，",
      "token_start": 948,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 283680,
      "end_ms": 287175,
      "text": "他接手美国女排三年时间，",
      "token_start": 953,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 287450,
      "end_ms": 290995,
      "text": "把世界第十的队伍带成了北京奥运银牌。",
      "token_start": 964,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 291570,
      "end_ms": 294480,
      "text": "然后就有了开头那一幕，",
      "token_start": 981,
      "token_end_exclusive": 991
    },
    {
      "start_ms": 294580,
      "end_ms": 297755,
      "text": "二零零八年他带美国队赢了中国队，",
      "token_start": 991,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 298650,
      "end_ms": 299565,
      "text": "被骂成那样。",
      "token_start": 1006,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 299900,
      "end_ms": 300840,
      "text": "他说了一句话，",
      "token_start": 1011,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 301260,
      "end_ms": 302880,
      "text": "排球没有国界，",
      "token_start": 1017,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 303160,
      "end_ms": 304540,
      "text": "但教练有祖国，",
      "token_start": 1023,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 305440,
      "end_ms": 306340,
      "text": "我挣美元，",
      "token_start": 1029,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 306660,
      "end_ms": 308600,
      "text": "不代表我忘了自己是谁。",
      "token_start": 1033,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 308740,
      "end_ms": 309680,
      "text": "故事讲到这，",
      "token_start": 1043,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 309800,
      "end_ms": 311580,
      "text": "你你可能会问，",
      "token_start": 1048,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 311600,
      "end_ms": 313260,
      "text": "被全中国骂成这样，",
      "token_start": 1054,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 313360,
      "end_ms": 314700,
      "text": "他还会再回来吗？",
      "token_start": 1062,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 315480,
      "end_ms": 316380,
      "text": "换做是你，",
      "token_start": 1069,
      "token_end_exclusive": 1073
    },
    {
      "start_ms": 316600,
      "end_ms": 317260,
      "text": "你会吗？",
      "token_start": 1073,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 318060,
      "end_ms": 320260,
      "text": "他的选择下集告诉你，",
      "token_start": 1076,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 321420,
      "end_ms": 323540,
      "text": "如果你也被这股劲打动了，",
      "token_start": 1085,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 323900,
      "end_ms": 324560,
      "text": "点个赞，",
      "token_start": 1096,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 326360,
      "end_ms": 327240,
      "text": "收藏起来，",
      "token_start": 1099,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 327460,
      "end_ms": 329395,
      "text": "转发给身边的老朋友。",
      "token_start": 1103,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 329730,
      "end_ms": 330250,
      "text": "关注我，",
      "token_start": 1112,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 330430,
      "end_ms": 331250,
      "text": "下集更狠，",
      "token_start": 1115,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 332130,
      "end_ms": 334725,
      "text": "他用一个冠军堵了所有人的嘴。",
      "token_start": 1119,
      "token_end_exclusive": 1132
    }
  ],
