{
  "video_id": "v_1ceae1131ac714ed",
  "duration_s": 641.965517,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1ceae1131ac714ed.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1ceae1131ac714ed.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 130,
      "end_ms": 1830,
      "text": "倒贴豪宅的富家女，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2050,
      "end_ms": 4290,
      "text": "培养出中国航天之父，",
      "token_start": 8,
      "token_end_exclusive": 17
    },
    {
      "start_ms": 4750,
      "end_ms": 5730,
      "text": "你敢信吗？",
      "token_start": 17,
      "token_end_exclusive": 21
    },
    {
      "start_ms": 5990,
      "end_ms": 9430,
      "text": "当年被全杭州戳着脊梁蛊骂，",
      "token_start": 21,
      "token_end_exclusive": 33
    },
    {
      "start_ms": 10230,
      "end_ms": 13210,
      "text": "倒贴败家的富家千金，",
      "token_start": 33,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 13530,
      "end_ms": 17870,
      "text": "拿三座豪宅万两白银下嫁穷书生，",
      "token_start": 42,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 18330,
      "end_ms": 21410,
      "text": "人人都等着看他哭着回娘家。",
      "token_start": 56,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 22050,
      "end_ms": 23130,
      "text": "可没人想到，",
      "token_start": 68,
      "token_end_exclusive": 73
    },
    {
      "start_ms": 23130,
      "end_ms": 24090,
      "text": "二十五年后，",
      "token_start": 73,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 24630,
      "end_ms": 25910,
      "text": "他养出的儿子，",
      "token_start": 78,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 25910,
      "end_ms": 29875,
      "text": "让整个西方世界都不敢小瞧中国。",
      "token_start": 84,
      "token_end_exclusive": 98
    },
    {
      "start_ms": 30500,
      "end_ms": 31600,
      "text": "一九零四年，",
      "token_start": 98,
      "token_end_exclusive": 103
    },
    {
      "start_ms": 32080,
      "end_ms": 41180,
      "text": "杭州富商十七岁的女儿嫁给一个穷书生陪嫁三处豪宅集上万两白银，",
      "token_start": 103,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 41440,
      "end_ms": 44120,
      "text": "街坊邻居都笑她倒贴家底。",
      "token_start": 132,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 44540,
      "end_ms": 45060,
      "text": "后来，",
      "token_start": 143,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 45400,
      "end_ms": 47280,
      "text": "穷书生当上厅长，",
      "token_start": 145,
      "token_end_exclusive": 152
    },
    {
      "start_ms": 47800,
      "end_ms": 49260,
      "text": "让众人闭了嘴，",
      "token_start": 152,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 50080,
      "end_ms": 53200,
      "text": "生下的儿子更是人人赞叹，",
      "token_start": 158,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 54080,
      "end_ms": 55360,
      "text": "后叫张兰娟。",
      "token_start": 169,
      "token_end_exclusive": 174
    },
    {
      "start_ms": 55860,
      "end_ms": 60530,
      "text": "杭州张家的嫡出大小姐父亲紧张了。",
      "token_start": 174,
      "token_end_exclusive": 189
    },
    {
      "start_ms": 60530,
      "end_ms": 63595,
      "text": "山是两广言韵史，",
      "token_start": 189,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 64090,
      "end_ms": 70355,
      "text": "也是江南数一数二的丝绸巨骨家底后的远近闻名，",
      "token_start": 196,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 70870,
      "end_ms": 72225,
      "text": "换做别家闺秀，",
      "token_start": 217,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 73040,
      "end_ms": 74845,
      "text": "早就养的娇生惯养，",
      "token_start": 223,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 75450,
      "end_ms": 78430,
      "text": "可张兰娟偏不十岁。",
      "token_start": 231,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 78430,
      "end_ms": 78830,
      "text": "那年，",
      "token_start": 239,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 79130,
      "end_ms": 80855,
      "text": "杭州闹饥荒，",
      "token_start": 241,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 81480,
      "end_ms": 84380,
      "text": "父亲开仓放粮赈灾，",
      "token_start": 246,
      "token_end_exclusive": 254
    },
    {
      "start_ms": 84640,
      "end_ms": 86765,
      "text": "他跟着在周彭帮忙，",
      "token_start": 254,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 87720,
      "end_ms": 88800,
      "text": "明明按规矩，",
      "token_start": 262,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 88840,
      "end_ms": 91655,
      "text": "每人只能领一碗西粥。",
      "token_start": 267,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 92170,
      "end_ms": 102075,
      "text": "他却偷偷望每个老人兜里塞一块糕点给门口蜷说的乞丐端饭时总在饭底下买两块肉。",
      "token_start": 276,
      "token_end_exclusive": 312
    },
    {
      "start_ms": 103220,
      "end_ms": 104800,
      "text": "账房先生告状说，",
      "token_start": 312,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 104800,
      "end_ms": 107435,
      "text": "他坏了规矩，",
      "token_start": 319,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 107940,
      "end_ms": 109125,
      "text": "父亲没骂他，",
      "token_start": 324,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 110170,
      "end_ms": 111975,
      "text": "只问他为什么这么做。",
      "token_start": 329,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 112840,
      "end_ms": 114175,
      "text": "他仰着头说，",
      "token_start": 338,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 115400,
      "end_ms": 117235,
      "text": "他们也是要脸面的人，",
      "token_start": 343,
      "token_end_exclusive": 352
    },
    {
      "start_ms": 117960,
      "end_ms": 118900,
      "text": "当着面给肉，",
      "token_start": 352,
      "token_end_exclusive": 357
    },
    {
      "start_ms": 119260,
      "end_ms": 120775,
      "text": "有人不好意思接。",
      "token_start": 357,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 121310,
      "end_ms": 123235,
      "text": "父亲当场感叹，",
      "token_start": 364,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 123920,
      "end_ms": 128770,
      "text": "我这女儿的眼界与心肠胜过家中十个儿郎。",
      "token_start": 370,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 128930,
      "end_ms": 131650,
      "text": "那句攒钱不如攒德留，",
      "token_start": 388,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 131690,
      "end_ms": 133229,
      "text": "才不如刘风谷，",
      "token_start": 397,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 133510,
      "end_ms": 137085,
      "text": "从此克尽了他的骨子里。",
      "token_start": 403,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 137390,
      "end_ms": 139625,
      "text": "转眼到了义亲的年纪，",
      "token_start": 413,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 140040,
      "end_ms": 143520,
      "text": "上门提亲的王孙公子名门望族，",
      "token_start": 422,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 143680,
      "end_ms": 144795,
      "text": "踏破了门槛，",
      "token_start": 435,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 145400,
      "end_ms": 146780,
      "text": "不是高官子弟，",
      "token_start": 440,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 146780,
      "end_ms": 148410,
      "text": "就是随便嫁，",
      "token_start": 446,
      "token_end_exclusive": 451
    },
    {
      "start_ms": 148410,
      "end_ms": 151335,
      "text": "一个都是想不尽的荣华富贵。",
      "token_start": 451,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 151730,
      "end_ms": 153685,
      "text": "可张兰娟一个都没应，",
      "token_start": 463,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 154050,
      "end_ms": 156445,
      "text": "偏偏选中了前军夫，",
      "token_start": 472,
      "token_end_exclusive": 480
    },
    {
      "start_ms": 157340,
      "end_ms": 160960,
      "text": "一个空有满腹学问语报国志向，",
      "token_start": 480,
      "token_end_exclusive": 493
    },
    {
      "start_ms": 161400,
      "end_ms": 163795,
      "text": "连私塾束修都凑不齐，",
      "token_start": 493,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 164340,
      "end_ms": 169600,
      "text": "连见像样的长山都做不起的寒门书生消息传开，",
      "token_start": 502,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 169760,
      "end_ms": 173470,
      "text": "整个杭州城都炸了茶室，",
      "token_start": 522,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 173550,
      "end_ms": 175520,
      "text": "酒楼里人人都笑，",
      "token_start": 532,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 175620,
      "end_ms": 179010,
      "text": "张家小姐傻放着少奶奶不当，",
      "token_start": 539,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 179330,
      "end_ms": 181065,
      "text": "非要往火坑里跳。",
      "token_start": 551,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 181980,
      "end_ms": 185210,
      "text": "本家亲戚轮番上门劝说，",
      "token_start": 558,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 185250,
      "end_ms": 186515,
      "text": "门不当户不对，",
      "token_start": 568,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 187070,
      "end_ms": 188085,
      "text": "迟早要后悔。",
      "token_start": 574,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 188740,
      "end_ms": 191475,
      "text": "面对满世界的闲言碎语，",
      "token_start": 579,
      "token_end_exclusive": 589
    },
    {
      "start_ms": 191830,
      "end_ms": 195550,
      "text": "张兰娟半句辩解都没有出嫁。",
      "token_start": 589,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 195550,
      "end_ms": 196130,
      "text": "前一天，",
      "token_start": 601,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 196430,
      "end_ms": 197825,
      "text": "他当着父亲的面，",
      "token_start": 604,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 198260,
      "end_ms": 199725,
      "text": "翻开陪嫁账本，",
      "token_start": 611,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 200020,
      "end_ms": 206825,
      "text": "杭州方古园老宅、上海御园洛阳楼、北京宣武门四合院，",
      "token_start": 617,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 207820,
      "end_ms": 210620,
      "text": "再加上万两白银压箱钱，",
      "token_start": 639,
      "token_end_exclusive": 649
    },
    {
      "start_ms": 210680,
      "end_ms": 212665,
      "text": "一笔笔清清楚楚。",
      "token_start": 649,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 213190,
      "end_ms": 214655,
      "text": "他只说了一句话，",
      "token_start": 656,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 215180,
      "end_ms": 217390,
      "text": "旁人嫁人图，",
      "token_start": 663,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 217490,
      "end_ms": 218785,
      "text": "眼前的富贵。",
      "token_start": 668,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 219310,
      "end_ms": 222125,
      "text": "我图的是他心里的家国，",
      "token_start": 673,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 222880,
      "end_ms": 225485,
      "text": "今日我陪出去的是家产，",
      "token_start": 683,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 226190,
      "end_ms": 229605,
      "text": "来日他能还给这个国家，",
      "token_start": 693,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 230010,
      "end_ms": 232305,
      "text": "定然比这值钱百倍。",
      "token_start": 703,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 233200,
      "end_ms": 234995,
      "text": "婚后没过几年，",
      "token_start": 711,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 235860,
      "end_ms": 236980,
      "text": "前军覆响，",
      "token_start": 717,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 237040,
      "end_ms": 239470,
      "text": "东渡日本留学，",
      "token_start": 721,
      "token_end_exclusive": 727
    },
    {
      "start_ms": 239950,
      "end_ms": 241705,
      "text": "寻找救国的路子，",
      "token_start": 727,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 242990,
      "end_ms": 244365,
      "text": "可凑来凑去，",
      "token_start": 734,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 244800,
      "end_ms": 246695,
      "text": "连船票都凑不齐。",
      "token_start": 739,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 247090,
      "end_ms": 248755,
      "text": "张兰娟二话不说，",
      "token_start": 746,
      "token_end_exclusive": 753
    },
    {
      "start_ms": 249260,
      "end_ms": 252515,
      "text": "直接从嫁妆里划出一笔银子，",
      "token_start": 753,
      "token_end_exclusive": 765
    },
    {
      "start_ms": 252880,
      "end_ms": 254725,
      "text": "连眉头都没皱一下。",
      "token_start": 765,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 255390,
      "end_ms": 257170,
      "text": "丈夫远走的那六年，",
      "token_start": 773,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 257370,
      "end_ms": 260805,
      "text": "她一个人撑起整个家上侍奉公婆，",
      "token_start": 781,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 261240,
      "end_ms": 262495,
      "text": "下打理产业，",
      "token_start": 795,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 262860,
      "end_ms": 264525,
      "text": "天不亮就起床对仗。",
      "token_start": 800,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 265300,
      "end_ms": 266600,
      "text": "珠算打的笔，",
      "token_start": 808,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 266640,
      "end_ms": 270445,
      "text": "做了一辈子的老账房，",
      "token_start": 813,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 270740,
      "end_ms": 271555,
      "text": "还利落。",
      "token_start": 822,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 273030,
      "end_ms": 274815,
      "text": "省里的珠算大赛，",
      "token_start": 825,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 275400,
      "end_ms": 277235,
      "text": "他连着拿了六年头名。",
      "token_start": 832,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 277720,
      "end_ms": 280925,
      "text": "旁人背地里说他守活寡，",
      "token_start": 841,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 281720,
      "end_ms": 282765,
      "text": "他全不在意。",
      "token_start": 851,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 283680,
      "end_ms": 285795,
      "text": "他守的从来不是空房，",
      "token_start": 856,
      "token_end_exclusive": 865
    },
    {
      "start_ms": 286230,
      "end_ms": 290115,
      "text": "是两个人共同的报国念想。",
      "token_start": 865,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 291760,
      "end_ms": 293720,
      "text": "前军夫学成回国后，",
      "token_start": 876,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 294260,
      "end_ms": 296120,
      "text": "想办一所新式学堂，",
      "token_start": 884,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 296220,
      "end_ms": 297980,
      "text": "培养能救国的年轻人，",
      "token_start": 892,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 298480,
      "end_ms": 301560,
      "text": "可四处筹款都凑不齐经费。",
      "token_start": 901,
      "token_end_exclusive": 912
    },
    {
      "start_ms": 301680,
      "end_ms": 303000,
      "text": "张兰娟知道后，",
      "token_start": 912,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 303280,
      "end_ms": 308340,
      "text": "转身就挂牌卖掉了上海的那处陪嫁洋楼，",
      "token_start": 918,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 308680,
      "end_ms": 311080,
      "text": "把全款交到丈夫手里，",
      "token_start": 935,
      "token_end_exclusive": 944
    },
    {
      "start_ms": 311580,
      "end_ms": 314140,
      "text": "你培养人才就是救国家，",
      "token_start": 944,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 314620,
      "end_ms": 317300,
      "text": "我这点房产算得了什么？",
      "token_start": 954,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 318620,
      "end_ms": 319880,
      "text": "在他的支持下，",
      "token_start": 964,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 320200,
      "end_ms": 322530,
      "text": "新式学堂手利一开办，",
      "token_start": 970,
      "token_end_exclusive": 979
    },
    {
      "start_ms": 322530,
      "end_ms": 325950,
      "text": "收留了不少家境贫寒的有志青年。",
      "token_start": 979,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 327030,
      "end_ms": 327410,
      "text": "你看，",
      "token_start": 993,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 327410,
      "end_ms": 328410,
      "text": "儿子钱学森，",
      "token_start": 995,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 329210,
      "end_ms": 333550,
      "text": "他更是把这份风骨课进了孩子的骨血里。",
      "token_start": 1000,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 333850,
      "end_ms": 336850,
      "text": "别家孩子还在牙牙学语，",
      "token_start": 1017,
      "token_end_exclusive": 1027
    },
    {
      "start_ms": 336950,
      "end_ms": 337850,
      "text": "背三字经。",
      "token_start": 1027,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 338430,
      "end_ms": 341450,
      "text": "他五岁就教儿子读满江红，",
      "token_start": 1031,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 341610,
      "end_ms": 342230,
      "text": "出师表，",
      "token_start": 1042,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 342370,
      "end_ms": 343890,
      "text": "不讲风花雪月，",
      "token_start": 1045,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 344330,
      "end_ms": 345990,
      "text": "只讲家国大义，",
      "token_start": 1051,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 346590,
      "end_ms": 348330,
      "text": "别家孩子摔碎，",
      "token_start": 1057,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 348350,
      "end_ms": 349710,
      "text": "东西要挨骂。",
      "token_start": 1063,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 350370,
      "end_ms": 354030,
      "text": "钱学森差摔坏了家里名贵的西洋中，",
      "token_start": 1068,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 354370,
      "end_ms": 357345,
      "text": "他反倒陪着孩子一起装回去。",
      "token_start": 1083,
      "token_end_exclusive": 1095
    },
    {
      "start_ms": 357930,
      "end_ms": 358530,
      "text": "跟他说，",
      "token_start": 1095,
      "token_end_exclusive": 1098
    },
    {
      "start_ms": 358570,
      "end_ms": 360965,
      "text": "拆的明白才能学的透彻，",
      "token_start": 1098,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 361460,
      "end_ms": 362680,
      "text": "将来要靠科学，",
      "token_start": 1108,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 362700,
      "end_ms": 364955,
      "text": "让咱们国家强起来。",
      "token_start": 1114,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 365430,
      "end_ms": 366565,
      "text": "寒冬腊月，",
      "token_start": 1122,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 366960,
      "end_ms": 368635,
      "text": "邻居家揭不开锅，",
      "token_start": 1126,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 369150,
      "end_ms": 372825,
      "text": "他总带着儿子一起送米送炭，",
      "token_start": 1133,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 373340,
      "end_ms": 375215,
      "text": "路上遇见逃难的人，",
      "token_start": 1145,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 375620,
      "end_ms": 378865,
      "text": "他照样在饭底下悄悄买肉。",
      "token_start": 1153,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 379520,
      "end_ms": 382670,
      "text": "年幼的钱学森问他帮得完吗？",
      "token_start": 1164,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 382810,
      "end_ms": 384545,
      "text": "他摸着儿子的头说，",
      "token_start": 1176,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 385060,
      "end_ms": 386185,
      "text": "帮一个是一个，",
      "token_start": 1184,
      "token_end_exclusive": 1190
    },
    {
      "start_ms": 387410,
      "end_ms": 388815,
      "text": "咱们自己过好了，",
      "token_start": 1190,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 389120,
      "end_ms": 391115,
      "text": "也要想着拉旁人一把。",
      "token_start": 1197,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 392000,
      "end_ms": 393180,
      "text": "一九三五年，",
      "token_start": 1206,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 393200,
      "end_ms": 397155,
      "text": "二十四岁的钱学森即将赴美留学，",
      "token_start": 1211,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 397850,
      "end_ms": 401105,
      "text": "那时张兰娟早已积劳成疾，",
      "token_start": 1225,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 401610,
      "end_ms": 403445,
      "text": "身子一天比一天差，",
      "token_start": 1236,
      "token_end_exclusive": 1244
    },
    {
      "start_ms": 404080,
      "end_ms": 408175,
      "text": "家里人都劝他把儿子留在身边尽孝，",
      "token_start": 1244,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 408790,
      "end_ms": 411995,
      "text": "可他硬是撑着病体收拾行李，",
      "token_start": 1259,
      "token_end_exclusive": 1271
    },
    {
      "start_ms": 412310,
      "end_ms": 415035,
      "text": "反复叮嘱的只有一句话，",
      "token_start": 1271,
      "token_end_exclusive": 1281
    },
    {
      "start_ms": 415840,
      "end_ms": 417125,
      "text": "出去好好学，",
      "token_start": 1281,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 417580,
      "end_ms": 418260,
      "text": "学成了，",
      "token_start": 1286,
      "token_end_exclusive": 1289
    },
    {
      "start_ms": 418260,
      "end_ms": 419315,
      "text": "一定要回来，",
      "token_start": 1289,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 419760,
      "end_ms": 421465,
      "text": "祖国需要你。",
      "token_start": 1294,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 422260,
      "end_ms": 424185,
      "text": "上海码头送别时，",
      "token_start": 1299,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 424530,
      "end_ms": 426870,
      "text": "他捂着胸口强牙咳嗽，",
      "token_start": 1306,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 427150,
      "end_ms": 428705,
      "text": "笑着跟儿子挥手，",
      "token_start": 1315,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 429130,
      "end_ms": 431425,
      "text": "直到轮船消失在天际，",
      "token_start": 1322,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 431740,
      "end_ms": 433765,
      "text": "才一口血磕在手帕上。",
      "token_start": 1331,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 434580,
      "end_ms": 435915,
      "text": "他怕儿子分心，",
      "token_start": 1340,
      "token_end_exclusive": 1346
    },
    {
      "start_ms": 436470,
      "end_ms": 439245,
      "text": "愣是把病情瞒得严严实实，",
      "token_start": 1346,
      "token_end_exclusive": 1357
    },
    {
      "start_ms": 440040,
      "end_ms": 442605,
      "text": "这一别竟是母子永绝。",
      "token_start": 1357,
      "token_end_exclusive": 1366
    },
    {
      "start_ms": 443300,
      "end_ms": 446955,
      "text": "大洋彼岸的钱爵森对着东方长贵不起。",
      "token_start": 1366,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 447570,
      "end_ms": 451685,
      "text": "父亲寄来的信里夹着母亲临终前的字条，",
      "token_start": 1382,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 452250,
      "end_ms": 453135,
      "text": "天快亮了，",
      "token_start": 1399,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 453730,
      "end_ms": 454995,
      "text": "生该回家了，",
      "token_start": 1403,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 457060,
      "end_ms": 460585,
      "text": "短短一句话成了他一辈子的执念。",
      "token_start": 1408,
      "token_end_exclusive": 1422
    },
    {
      "start_ms": 461820,
      "end_ms": 463905,
      "text": "后来的故事我们都知道了，",
      "token_start": 1422,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 464250,
      "end_ms": 468845,
      "text": "美国用五年软禁拦他用高官厚禄，",
      "token_start": 1433,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 469180,
      "end_ms": 470040,
      "text": "诱他说，",
      "token_start": 1447,
      "token_end_exclusive": 1450
    },
    {
      "start_ms": 470040,
      "end_ms": 472445,
      "text": "他一个人抵得上五个师。",
      "token_start": 1450,
      "token_end_exclusive": 1460
    },
    {
      "start_ms": 472800,
      "end_ms": 475460,
      "text": "可他始终记着母亲的话，",
      "token_start": 1460,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 475760,
      "end_ms": 477975,
      "text": "拼了命也要回到祖国。",
      "token_start": 1470,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 478570,
      "end_ms": 479765,
      "text": "一九六零年，",
      "token_start": 1479,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 480060,
      "end_ms": 481895,
      "text": "第一枚导弹腾空，",
      "token_start": 1484,
      "token_end_exclusive": 1491
    },
    {
      "start_ms": 483100,
      "end_ms": 484140,
      "text": "一九六四年，",
      "token_start": 1491,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 484160,
      "end_ms": 486615,
      "text": "罗布泊蘑菇云升起。",
      "token_start": 1496,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 487090,
      "end_ms": 488230,
      "text": "一九七零年，",
      "token_start": 1504,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 488350,
      "end_ms": 491185,
      "text": "东方红一号响彻太空。",
      "token_start": 1509,
      "token_end_exclusive": 1518
    },
    {
      "start_ms": 491830,
      "end_ms": 493070,
      "text": "那个在母亲身边，",
      "token_start": 1518,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 493150,
      "end_ms": 496035,
      "text": "听着家国故事长大的孩子，",
      "token_start": 1525,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 496550,
      "end_ms": 500025,
      "text": "真的让整个中国挺直了腰杆。",
      "token_start": 1536,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 500860,
      "end_ms": 501520,
      "text": "到这时，",
      "token_start": 1548,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 501560,
      "end_ms": 507805,
      "text": "世人才懂张兰娟当年哪里是倒贴，",
      "token_start": 1551,
      "token_end_exclusive": 1565
    },
    {
      "start_ms": 508390,
      "end_ms": 509995,
      "text": "哪里是糊涂。",
      "token_start": 1565,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 511050,
      "end_ms": 518635,
      "text": "他从十岁那年就活明白了万贯家财总有散尽的一天，",
      "token_start": 1570,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 519430,
      "end_ms": 522985,
      "text": "刻在骨学里的风骨与家国新，",
      "token_start": 1592,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 523430,
      "end_ms": 527525,
      "text": "才是一个家族、一个民族真正的底气。",
      "token_start": 1604,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 528200,
      "end_ms": 528840,
      "text": "多年后，",
      "token_start": 1619,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 528840,
      "end_ms": 537000,
      "text": "钱学森在回忆录里写我的母亲是个性格开朗、热情有教养的女性。",
      "token_start": 1622,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 537600,
      "end_ms": 542460,
      "text": "我的科学启蒙完全得益于她她教会我的，",
      "token_start": 1649,
      "token_end_exclusive": 1666
    },
    {
      "start_ms": 542460,
      "end_ms": 543340,
      "text": "不是知识，",
      "token_start": 1666,
      "token_end_exclusive": 1670
    },
    {
      "start_ms": 543700,
      "end_ms": 544900,
      "text": "是不怕拆开，",
      "token_start": 1670,
      "token_end_exclusive": 1675
    },
    {
      "start_ms": 545200,
      "end_ms": 546800,
      "text": "还能装回去的胆量。",
      "token_start": 1675,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 547400,
      "end_ms": 550580,
      "text": "当年杭州城里的街坊笑她倒贴，",
      "token_start": 1683,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 551080,
      "end_ms": 553980,
      "text": "却不知道她最值钱的陪嫁，",
      "token_start": 1696,
      "token_end_exclusive": 1707
    },
    {
      "start_ms": 554060,
      "end_ms": 557580,
      "text": "从来不是三处豪宅万两白银，",
      "token_start": 1707,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 558060,
      "end_ms": 561390,
      "text": "是她在煤油灯下算题时的背影，",
      "token_start": 1719,
      "token_end_exclusive": 1732
    },
    {
      "start_ms": 561770,
      "end_ms": 563250,
      "text": "是儿子拆钟时，",
      "token_start": 1732,
      "token_end_exclusive": 1738
    },
    {
      "start_ms": 563250,
      "end_ms": 565270,
      "text": "他稳稳递过去的扳手，",
      "token_start": 1738,
      "token_end_exclusive": 1747
    },
    {
      "start_ms": 565830,
      "end_ms": 567970,
      "text": "是丈夫穷困潦倒时，",
      "token_start": 1747,
      "token_end_exclusive": 1755
    },
    {
      "start_ms": 567990,
      "end_ms": 571850,
      "text": "那具家里有我那份嫁妆，",
      "token_start": 1755,
      "token_end_exclusive": 1765
    },
    {
      "start_ms": 572350,
      "end_ms": 575630,
      "text": "后来变成了一颗原子弹、一枚火箭，",
      "token_start": 1765,
      "token_end_exclusive": 1779
    },
    {
      "start_ms": 575870,
      "end_ms": 577470,
      "text": "一个民族的底气。",
      "token_start": 1779,
      "token_end_exclusive": 1786
    },
    {
      "start_ms": 578490,
      "end_ms": 579210,
      "text": "这笔账，",
      "token_start": 1786,
      "token_end_exclusive": 1789
    },
    {
      "start_ms": 579690,
      "end_ms": 582090,
      "text": "全中国都替他算清了。",
      "token_start": 1789,
      "token_end_exclusive": 1798
    },
    {
      "start_ms": 582870,
      "end_ms": 584230,
      "text": "他本普通无名，",
      "token_start": 1798,
      "token_end_exclusive": 1804
    },
    {
      "start_ms": 584530,
      "end_ms": 586150,
      "text": "为国家升一栋梁，",
      "token_start": 1804,
      "token_end_exclusive": 1811
    },
    {
      "start_ms": 587230,
      "end_ms": 588310,
      "text": "被宰史册。",
      "token_start": 1811,
      "token_end_exclusive": 1815
    },
    {
      "start_ms": 588830,
      "end_ms": 590765,
      "text": "每个中国人都感谢他。",
      "token_start": 1815,
      "token_end_exclusive": 1824
    },
    {
      "start_ms": 591780,
      "end_ms": 592500,
      "text": "老话说，",
      "token_start": 1824,
      "token_end_exclusive": 1827
    },
    {
      "start_ms": 592880,
      "end_ms": 597190,
      "text": "遗金满银不如易经传家留给孩子，",
      "token_start": 1827,
      "token_end_exclusive": 1841
    },
    {
      "start_ms": 597190,
      "end_ms": 599070,
      "text": "再多房产存款，",
      "token_start": 1841,
      "token_end_exclusive": 1847
    },
    {
      "start_ms": 599350,
      "end_ms": 600645,
      "text": "都不如交给他，",
      "token_start": 1847,
      "token_end_exclusive": 1853
    },
    {
      "start_ms": 601100,
      "end_ms": 602215,
      "text": "一身正气，",
