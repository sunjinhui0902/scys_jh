{
  "video_id": "v_2ad33b07cfad615d",
  "duration_s": 291.152993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_2ad33b07cfad615d.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_2ad33b07cfad615d.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 210,
      "end_ms": 2190,
      "text": "今天晚上李总组了个局陈，",
      "token_start": 0,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 2190,
      "end_ms": 3090,
      "text": "总也会过去。",
      "token_start": 11,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 3390,
      "end_ms": 4110,
      "text": "琳琳小张，",
      "token_start": 16,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4230,
      "end_ms": 5110,
      "text": "你俩跟我一起去。",
      "token_start": 20,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 5270,
      "end_ms": 5590,
      "text": "好的，",
      "token_start": 27,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 5590,
      "end_ms": 6630,
      "text": "王姐没问题。",
      "token_start": 29,
      "token_end_exclusive": 34
    },
    {
      "start_ms": 6630,
      "end_ms": 7030,
      "text": "王姐，",
      "token_start": 34,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8010,
      "end_ms": 8470,
      "text": "对了，",
      "token_start": 36,
      "token_end_exclusive": 38
    },
    {
      "start_ms": 8950,
      "end_ms": 10430,
      "text": "今晚来的都是重要客户，",
      "token_start": 38,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 10930,
      "end_ms": 12290,
      "text": "说话做事都注意点，",
      "token_start": 48,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 12730,
      "end_ms": 13190,
      "text": "放心吧，",
      "token_start": 56,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 13190,
      "end_ms": 13530,
      "text": "王姐，",
      "token_start": 59,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 13770,
      "end_ms": 18690,
      "text": "我肯定不给您丢人哟。",
      "token_start": 61,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 19130,
      "end_ms": 19970,
      "text": "王姐来了，",
      "token_start": 70,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 20170,
      "end_ms": 20970,
      "text": "快坐快坐。",
      "token_start": 74,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 21490,
      "end_ms": 22290,
      "text": "不好意思，",
      "token_start": 78,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 22590,
      "end_ms": 23710,
      "text": "让两位久等了，",
      "token_start": 82,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 23950,
      "end_ms": 26055,
      "text": "哪里哪里都是自己人。",
      "token_start": 88,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 28960,
      "end_ms": 29540,
      "text": "小张啊，",
      "token_start": 97,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 29940,
      "end_ms": 30680,
      "text": "今天高兴，",
      "token_start": 100,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 30860,
      "end_ms": 33280,
      "text": "刚好李总和陈总都在你来讲两句，",
      "token_start": 104,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 34680,
      "end_ms": 36020,
      "text": "那祝大家吃好喝。",
      "token_start": 118,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 36020,
      "end_ms": 36260,
      "text": "好，",
      "token_start": 125,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 36340,
      "end_ms": 47840,
      "text": "我先干了王姐，",
      "token_start": 126,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 48180,
      "end_ms": 49800,
      "text": "那我也借这个机会说两句。",
      "token_start": 132,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 50020,
      "end_ms": 50260,
      "text": "好，",
      "token_start": 143,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 50720,
      "end_ms": 53020,
      "text": "你说非常感谢李总今天组的局，",
      "token_start": 144,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 53080,
      "end_ms": 54440,
      "text": "也感谢王姐带我们过来，",
      "token_start": 157,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 54440,
      "end_ms": 55820,
      "text": "让我们有幸认识各位前辈，",
      "token_start": 167,
      "token_end_exclusive": 178
    },
    {
      "start_ms": 56080,
      "end_ms": 56760,
      "text": "我叫琳琳。",
      "token_start": 178,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 57020,
      "end_ms": 57600,
      "text": "俗话说，",
      "token_start": 182,
      "token_end_exclusive": 185
    },
    {
      "start_ms": 57680,
      "end_ms": 58800,
      "text": "相聚是一种缘分。",
      "token_start": 185,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 59020,
      "end_ms": 59875,
      "text": "此时此刻，",
      "token_start": 192,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 60170,
      "end_ms": 62230,
      "text": "我把对各位的祝福化作一杯美酒，",
      "token_start": 196,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 62490,
      "end_ms": 63670,
      "text": "祝各位扶摇直上。",
      "token_start": 210,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 63670,
      "end_ms": 65730,
      "text": "九万里事业长虹节节高。",
      "token_start": 217,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 66770,
      "end_ms": 67235,
      "text": "好，",
      "token_start": 227,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 67640,
      "end_ms": 68965,
      "text": "这姑娘聪明，",
      "token_start": 228,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 70580,
      "end_ms": 72100,
      "text": "王姐来这杯，",
      "token_start": 233,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 72100,
      "end_ms": 72585,
      "text": "我敬你。",
      "token_start": 238,
      "token_end_exclusive": 241
    },
    {
      "start_ms": 72990,
      "end_ms": 73205,
      "text": "哎，",
      "token_start": 241,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 73970,
      "end_ms": 75610,
      "text": "陈总这杯我替王姐敬您，",
      "token_start": 242,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 75830,
      "end_ms": 77030,
      "text": "我敬的是你们领导，",
      "token_start": 252,
      "token_end_exclusive": 260
    },
    {
      "start_ms": 77090,
      "end_ms": 77935,
      "text": "你是领导吗？",
      "token_start": 260,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 83570,
      "end_ms": 84385,
      "text": "瞧您说的，",
      "token_start": 265,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 84670,
      "end_ms": 85750,
      "text": "您敬的是我领导，",
      "token_start": 269,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 85950,
      "end_ms": 87385,
      "text": "我同样敬的也是领导，",
      "token_start": 276,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 87590,
      "end_ms": 88690,
      "text": "您敬领导是心意，",
      "token_start": 285,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 88730,
      "end_ms": 90530,
      "text": "我敬您是尊敬这杯，",
      "token_start": 292,
      "token_end_exclusive": 300
    },
    {
      "start_ms": 90650,
      "end_ms": 91755,
      "text": "我敬的是生意，",
      "token_start": 300,
      "token_end_exclusive": 306
    },
    {
      "start_ms": 92150,
      "end_ms": 92930,
      "text": "咱们随意，",
      "token_start": 306,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 93090,
      "end_ms": 94390,
      "text": "祝您生意一路昌宏，",
      "token_start": 310,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 94510,
      "end_ms": 95355,
      "text": "万事顺利。",
      "token_start": 318,
      "token_end_exclusive": 322
    },
    {
      "start_ms": 96510,
      "end_ms": 96995,
      "text": "哈哈哈，",
      "token_start": 322,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 97270,
      "end_ms": 98430,
      "text": "这小姑娘会说话。",
      "token_start": 325,
      "token_end_exclusive": 332
    },
    {
      "start_ms": 98490,
      "end_ms": 100080,
      "text": "琳琳刚才说的不错，",
      "token_start": 332,
      "token_end_exclusive": 340
    },
    {
      "start_ms": 100140,
      "end_ms": 101120,
      "text": "来咱俩喝一个，",
      "token_start": 340,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 101120,
      "end_ms": 101745,
      "text": "谢谢李总。",
      "token_start": 346,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 104380,
      "end_ms": 104705,
      "text": "哎，",
      "token_start": 350,
      "token_end_exclusive": 351
    },
    {
      "start_ms": 105020,
      "end_ms": 106500,
      "text": "怎么到我这儿就剩半杯了。",
      "token_start": 351,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 106680,
      "end_ms": 108120,
      "text": "李总瓶底酒，",
      "token_start": 362,
      "token_end_exclusive": 367
    },
    {
      "start_ms": 108140,
      "end_ms": 109000,
      "text": "这叫发财酒，",
      "token_start": 367,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 109140,
      "end_ms": 112005,
      "text": "到底发财好事再来哈哈哈哈哈，",
      "token_start": 372,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 112290,
      "end_ms": 113595,
      "text": "好一个发财酒。",
      "token_start": 385,
      "token_end_exclusive": 391
    },
    {
      "start_ms": 114600,
      "end_ms": 115055,
      "text": "琳玲，",
      "token_start": 391,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 115720,
      "end_ms": 116665,
      "text": "我再问你个问题，",
      "token_start": 393,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 117130,
      "end_ms": 119205,
      "text": "你觉得我和李总你更喜欢谁？",
      "token_start": 400,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 120760,
      "end_ms": 122280,
      "text": "领导怎么能用喜欢呢？",
      "token_start": 412,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 122460,
      "end_ms": 124300,
      "text": "那得是尊敬两位领导，",
      "token_start": 421,
      "token_end_exclusive": 430
    },
    {
      "start_ms": 124300,
      "end_ms": 131000,
      "text": "我都尊敬这姑娘聪明琳琳，",
      "token_start": 430,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 131420,
      "end_ms": 132620,
      "text": "这条鱼没怎么动，",
      "token_start": 441,
      "token_end_exclusive": 448
    },
    {
      "start_ms": 132920,
      "end_ms": 133740,
      "text": "都是自己人，",
      "token_start": 448,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 133780,
      "end_ms": 134400,
      "text": "别嫌弃，",
      "token_start": 453,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 134700,
      "end_ms": 135580,
      "text": "一会儿打包带回去，",
      "token_start": 456,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 135580,
      "end_ms": 136000,
      "text": "吃吧，",
      "token_start": 464,
      "token_end_exclusive": 466
    },
    {
      "start_ms": 136000,
      "end_ms": 136840,
      "text": "还能补身子。",
      "token_start": 466,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 137120,
      "end_ms": 138560,
      "text": "琳琳陈总让你拿，",
      "token_start": 471,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 138560,
      "end_ms": 139455,
      "text": "你就拿着呗，",
      "token_start": 478,
      "token_end_exclusive": 483
    },
    {
      "start_ms": 142020,
      "end_ms": 143100,
      "text": "太感谢陈总了，",
      "token_start": 483,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 143320,
      "end_ms": 145320,
      "text": "但是一整条鱼我自己也吃不完。",
      "token_start": 489,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 145540,
      "end_ms": 147640,
      "text": "我平时喜欢吃鱼尾上面这部分，",
      "token_start": 502,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 147640,
      "end_ms": 149600,
      "text": "我给您打包带回去给嫂子也尝一下，",
      "token_start": 515,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 149640,
      "end_ms": 151140,
      "text": "以后还希望您多多照顾，",
      "token_start": 530,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 154440,
      "end_ms": 156685,
      "text": "看来今天这条鱼没白点。",
      "token_start": 540,
      "token_end_exclusive": 550
    },
    {
      "start_ms": 158800,
      "end_ms": 159220,
      "text": "玲琳，",
      "token_start": 550,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 159940,
      "end_ms": 161500,
      "text": "陈总那边刚刚来消息，",
      "token_start": 552,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 161500,
      "end_ms": 164340,
      "text": "昨天谈的那个项目确定跟咱们合作了，",
      "token_start": 561,
      "token_end_exclusive": 577
    },
    {
      "start_ms": 164560,
      "end_ms": 166060,
      "text": "而且陈总还特意提了一句，",
      "token_start": 577,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 166220,
      "end_ms": 167360,
      "text": "后面让你负责对接，",
      "token_start": 588,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 167740,
      "end_ms": 168440,
      "text": "谢谢王姐，",
      "token_start": 596,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 168460,
      "end_ms": 169485,
      "text": "我一定把它做好。",
      "token_start": 600,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 171490,
      "end_ms": 171930,
      "text": "琳琳，",
      "token_start": 607,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 172650,
      "end_ms": 173950,
      "text": "我现在是真服你了，",
      "token_start": 609,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 174190,
      "end_ms": 174690,
      "text": "怎么了？",
      "token_start": 617,
      "token_end_exclusive": 620
    },
    {
      "start_ms": 175390,
      "end_ms": 176230,
      "text": "你想想啊。",
      "token_start": 620,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 176470,
      "end_ms": 177550,
      "text": "那天陈总说，",
      "token_start": 624,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 177710,
      "end_ms": 178850,
      "text": "我敬的是你们领导，",
      "token_start": 629,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 178850,
      "end_ms": 179690,
      "text": "你是领导吗？",
      "token_start": 637,
      "token_end_exclusive": 642
    },
    {
      "start_ms": 179790,
      "end_ms": 180290,
      "text": "换成我，",
      "token_start": 642,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 180290,
      "end_ms": 181850,
      "text": "我当场就不知道该说什么了。",
      "token_start": 645,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 181850,
      "end_ms": 183150,
      "text": "饭局上突然让你讲话，",
      "token_start": 657,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 183290,
      "end_ms": 183930,
      "text": "给李总倒酒，",
      "token_start": 666,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 183930,
      "end_ms": 184570,
      "text": "只剩半杯。",
      "token_start": 671,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 184710,
      "end_ms": 185310,
      "text": "陈总问你，",
      "token_start": 675,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 185310,
      "end_ms": 186755,
      "text": "他和李总你更喜欢谁？",
      "token_start": 679,
      "token_end_exclusive": 688
    },
    {
      "start_ms": 187030,
      "end_ms": 187935,
      "text": "还有最后那条鱼，",
      "token_start": 688,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 188530,
      "end_ms": 189565,
      "text": "我到现在才明白，",
      "token_start": 695,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 189940,
      "end_ms": 191525,
      "text": "陈总说的根本就不只是鱼，",
      "token_start": 702,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 192190,
      "end_ms": 193985,
      "text": "是你到底是怎么练的？",
      "token_start": 713,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 194320,
      "end_ms": 195540,
      "text": "为什么别人突然给你一句话，",
      "token_start": 722,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 195540,
      "end_ms": 196785,
      "text": "你马上就知道该怎么接。",
      "token_start": 734,
      "token_end_exclusive": 744
    },
    {
      "start_ms": 197720,
      "end_ms": 200160,
      "text": "其实我以前跟你一样不爱说话，",
      "token_start": 744,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 200300,
      "end_ms": 201700,
      "text": "也不知道怎么组织语言，",
      "token_start": 757,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 201860,
      "end_ms": 203875,
      "text": "一到这种场合就不知道应该说什么。",
      "token_start": 767,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 204400,
      "end_ms": 207735,
      "text": "后来我就经常看这本把话说的恰到好处。",
      "token_start": 782,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 208060,
      "end_ms": 209220,
      "text": "它里面就是一个场景，",
      "token_start": 799,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 209220,
      "end_ms": 210300,
      "text": "一个场景的告诉你，",
      "token_start": 808,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 210360,
      "end_ms": 212535,
      "text": "遇到不同的人不同的话应该怎么接。",
      "token_start": 816,
      "token_end_exclusive": 831
    },
    {
      "start_ms": 212890,
      "end_ms": 214470,
      "text": "比如别人夸你优秀，",
      "token_start": 831,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 214530,
      "end_ms": 215130,
      "text": "你可以回，",
      "token_start": 839,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 215450,
      "end_ms": 216550,
      "text": "那是不优秀点儿，",
      "token_start": 843,
      "token_end_exclusive": 850
    },
    {
      "start_ms": 216550,
      "end_ms": 217870,
      "text": "怎么能和你做朋友呢？",
      "token_start": 850,
      "token_end_exclusive": 859
    },
    {
      "start_ms": 217970,
      "end_ms": 219290,
      "text": "当别人说你真聪明，",
      "token_start": 859,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 219290,
      "end_ms": 220830,
      "text": "你就回近朱者赤，",
      "token_start": 867,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 220949,
      "end_ms": 221910,
      "text": "和你在一起啊，",
      "token_start": 874,
      "token_end_exclusive": 880
    },
    {
      "start_ms": 221930,
      "end_ms": 224605,
      "text": "熏都熏出来了当领导跟你说辛苦了，",
      "token_start": 880,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 224800,
      "end_ms": 225860,
      "text": "你就回领导，",
      "token_start": 895,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 225960,
      "end_ms": 227240,
      "text": "这都是我应该做的。",
      "token_start": 900,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 227280,
      "end_ms": 228480,
      "text": "强将手下吴若兵，",
      "token_start": 908,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 228580,
      "end_ms": 229960,
      "text": "我怎么能给您丢脸呢？",
      "token_start": 915,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 230040,
      "end_ms": 231560,
      "text": "难怪你每次都能接的这么快。",
      "token_start": 924,
      "token_end_exclusive": 936
    },
    {
      "start_ms": 231880,
      "end_ms": 233355,
      "text": "这种东西不是天生的，",
      "token_start": 936,
      "token_end_exclusive": 945
    },
    {
      "start_ms": 233740,
      "end_ms": 234940,
      "text": "就是平时一个场景，",
      "token_start": 945,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 234940,
      "end_ms": 236180,
      "text": "一个场景的看一个场景，",
      "token_start": 953,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 236180,
      "end_ms": 236915,
      "text": "一个场景的练，",
      "token_start": 963,
      "token_end_exclusive": 969
    },
    {
      "start_ms": 237290,
      "end_ms": 238150,
      "text": "每天看两页，",
      "token_start": 969,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 238310,
      "end_ms": 240170,
      "text": "慢慢积累一些不同的场景之下，",
      "token_start": 974,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 240170,
      "end_ms": 240870,
      "text": "应该怎么说？",
      "token_start": 987,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 241130,
      "end_ms": 242975,
      "text": "这里面还有很多生活里的场景，",
      "token_start": 992,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 243360,
      "end_ms": 244600,
      "text": "比如对象给你发红包，",
      "token_start": 1005,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 244660,
      "end_ms": 247705,
      "text": "你可以回你是我致富道路上最大的功臣。",
      "token_start": 1014,
      "token_end_exclusive": 1031
    },
    {
      "start_ms": 248130,
      "end_ms": 249110,
      "text": "同事向你借钱，",
      "token_start": 1031,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 249310,
      "end_ms": 250170,
      "text": "你又不想借，",
      "token_start": 1037,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 250270,
      "end_ms": 250750,
      "text": "可以回，",
      "token_start": 1042,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 250970,
      "end_ms": 252195,
      "text": "大家都是一样的年纪，",
      "token_start": 1045,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 252480,
      "end_ms": 253105,
      "text": "你没有的，",
      "token_start": 1054,
      "token_end_exclusive": 1058
    },
    {
      "start_ms": 253320,
      "end_ms": 254020,
      "text": "我能有吗？",
      "token_start": 1058,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 254220,
      "end_ms": 256520,
      "text": "还有心仪的人跟你说我想你了，",
      "token_start": 1062,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 256520,
      "end_ms": 258060,
      "text": "你可以回随便想，",
      "token_start": 1075,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 258180,
      "end_ms": 259300,
      "text": "千万别跟我客气，",
      "token_start": 1082,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 259340,
      "end_ms": 260585,
      "text": "目前不收费。",
      "token_start": 1089,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 261910,
      "end_ms": 262765,
      "text": "这个有意思。",
      "token_start": 1094,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 263280,
      "end_ms": 264620,
      "text": "我第一次读到这些的时候，",
      "token_start": 1099,
      "token_end_exclusive": 1110
    },
    {
      "start_ms": 264620,
      "end_ms": 266405,
      "text": "真的有种豁然开朗的感觉。",
      "token_start": 1110,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 266860,
      "end_ms": 270505,
      "text": "这本书就是把工作、生活、人际交往里经常遇到的场景，",
      "token_start": 1121,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 270800,
      "end_ms": 272255,
      "text": "一个一个拆开给你看，",
      "token_start": 1143,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 272660,
      "end_ms": 273380,
      "text": "别人怎么说，",
      "token_start": 1152,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 273500,
      "end_ms": 274300,
      "text": "你可以怎么接，",
      "token_start": 1157,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 274480,
      "end_ms": 275965,
      "text": "都是一句一句给你举例。",
      "token_start": 1163,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 276210,
      "end_ms": 278055,
      "text": "所以你平时就是这么练的对呀，",
      "token_start": 1173,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 278440,
      "end_ms": 280160,
      "text": "每天不用看很多看两页，",
      "token_start": 1186,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 280240,
      "end_ms": 283520,
      "text": "碰到自己觉得有用的表达就记一记慢慢积累的多了。",
      "token_start": 1196,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 283620,
      "end_ms": 285815,
      "text": "工作和生活里再碰到类似的场景，",
      "token_start": 1218,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 285990,
      "end_ms": 287065,
      "text": "你就知道怎么接了。",
      "token_start": 1232,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 288310,
      "end_ms": 289315,
      "text": "这本先借我看看，",
      "token_start": 1240,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 289660,
      "end_ms": 290220,
      "text": "拿去吧，",
      "token_start": 1247,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 290300,
      "end_ms": 291015,
      "text": "回去慢慢看。",
      "token_start": 1250,
      "token_end_exclusive": 1255
    }
