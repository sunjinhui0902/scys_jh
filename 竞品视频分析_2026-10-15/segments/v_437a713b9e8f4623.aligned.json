{
  "video_id": "v_437a713b9e8f4623",
  "duration_s": 367.432993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_437a713b9e8f4623.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_437a713b9e8f4623.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 150,
      "end_ms": 790,
      "text": "您知道，",
      "token_start": 0,
      "token_end_exclusive": 3
    },
    {
      "start_ms": 790,
      "end_ms": 8590,
      "text": "中国大地上老天爷亲手垒起来的最不可思议的名山究竟藏在哪一个角落吗？",
      "token_start": 3,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 9070,
      "end_ms": 14410,
      "text": "有人说是山东泰山五岳独尊皇帝都去封禅。",
      "token_start": 35,
      "token_end_exclusive": 53
    },
    {
      "start_ms": 14890,
      "end_ms": 19190,
      "text": "有人说是安徽黄山奇松怪石云海、温泉名，",
      "token_start": 53,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 19190,
      "end_ms": 20330,
      "text": "气压了五百年。",
      "token_start": 70,
      "token_end_exclusive": 76
    },
    {
      "start_ms": 20690,
      "end_ms": 22010,
      "text": "可您要是真信了，",
      "token_start": 76,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 22190,
      "end_ms": 23310,
      "text": "那就被忽悠了。",
      "token_start": 83,
      "token_end_exclusive": 89
    },
    {
      "start_ms": 23690,
      "end_ms": 26190,
      "text": "真正霸榜的那个一露脸，",
      "token_start": 89,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 26190,
      "end_ms": 27210,
      "text": "他们都得往后站。",
      "token_start": 99,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 27690,
      "end_ms": 31840,
      "text": "他被公认为中国名山名山的终极天花板，",
      "token_start": 106,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 32080,
      "end_ms": 34480,
      "text": "身上压着五千年的香火。",
      "token_start": 123,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 35740,
      "end_ms": 37240,
      "text": "这座山不是山，",
      "token_start": 133,
      "token_end_exclusive": 139
    },
    {
      "start_ms": 37660,
      "end_ms": 38900,
      "text": "是中国人的根。",
      "token_start": 139,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 39800,
      "end_ms": 44660,
      "text": "今天咱们就来盘点盘点中国十大名山，",
      "token_start": 145,
      "token_end_exclusive": 161
    },
    {
      "start_ms": 45540,
      "end_ms": 47940,
      "text": "可能您去过不少名山大川，",
      "token_start": 161,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 48420,
      "end_ms": 52020,
      "text": "可这种立在地球上几千万年的东西，",
      "token_start": 172,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 52440,
      "end_ms": 53620,
      "text": "看一回少一回。",
      "token_start": 187,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 54520,
      "end_ms": 55180,
      "text": "老规矩，",
      "token_start": 193,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 55620,
      "end_ms": 56440,
      "text": "开讲之前，",
      "token_start": 196,
      "token_end_exclusive": 200
    },
    {
      "start_ms": 56440,
      "end_ms": 59765,
      "text": "劳烦您顺手扣个一点颗红心，",
      "token_start": 200,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 60130,
      "end_ms": 63595,
      "text": "让我看看都是谁在听第十名。",
      "token_start": 212,
      "token_end_exclusive": 224
    },
    {
      "start_ms": 63950,
      "end_ms": 69795,
      "text": "山西衡山在山西大同浑源县五月里的北岳，",
      "token_start": 224,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 70540,
      "end_ms": 76365,
      "text": "这山最绝的是他像一条龙东西绵延五百多公里，",
      "token_start": 242,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 76890,
      "end_ms": 82975,
      "text": "一百零八座山峰像一百零八颗、龙牙、恒山的主峰天峰岭，",
      "token_start": 262,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 83340,
      "end_ms": 85055,
      "text": "海拔两千零一十六米，",
      "token_start": 285,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 85580,
      "end_ms": 87945,
      "text": "自古就是兵家必争之地，",
      "token_start": 294,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 88280,
      "end_ms": 89720,
      "text": "倒马关、紫金关，",
      "token_start": 304,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 89840,
      "end_ms": 92865,
      "text": "平行关全在衡山山脉上。",
      "token_start": 310,
      "token_end_exclusive": 320
    },
    {
      "start_ms": 93330,
      "end_ms": 94155,
      "text": "北宋年间，",
      "token_start": 320,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 94580,
      "end_ms": 100205,
      "text": "杨家将就在衡山一带镇守边关留下多少忠烈的故事。",
      "token_start": 324,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 101030,
      "end_ms": 105135,
      "text": "悬空寺就挂在衡山脚下的金龙峡，",
      "token_start": 346,
      "token_end_exclusive": 360
    },
    {
      "start_ms": 105560,
      "end_ms": 107845,
      "text": "一千五百年了不塌不歪，",
      "token_start": 360,
      "token_end_exclusive": 370
    },
    {
      "start_ms": 108360,
      "end_ms": 111125,
      "text": "您说这是山还是北方的屏障？",
      "token_start": 370,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 111720,
      "end_ms": 112385,
      "text": "第九名，",
      "token_start": 382,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 112710,
      "end_ms": 117005,
      "text": "湖南衡山在湖南衡阳五月里的南月，",
      "token_start": 385,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 117270,
      "end_ms": 120205,
      "text": "这山最绝的是它满山都是树，",
      "token_start": 400,
      "token_end_exclusive": 412
    },
    {
      "start_ms": 120910,
      "end_ms": 123365,
      "text": "森林覆盖率超过百分之九十，",
      "token_start": 412,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 124380,
      "end_ms": 127155,
      "text": "古树名木一千三百多种，",
      "token_start": 424,
      "token_end_exclusive": 434
    },
    {
      "start_ms": 128170,
      "end_ms": 133490,
      "text": "红豆杉、银杏、摇钱树泉有衡山，",
      "token_start": 434,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 133570,
      "end_ms": 135925,
      "text": "还有个外号叫受阅。",
      "token_start": 446,
      "token_end_exclusive": 454
    },
    {
      "start_ms": 136260,
      "end_ms": 137265,
      "text": "南岳衡山。",
      "token_start": 454,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 137640,
      "end_ms": 140275,
      "text": "寿比南山说的就是这座山。",
      "token_start": 458,
      "token_end_exclusive": 469
    },
    {
      "start_ms": 141150,
      "end_ms": 142395,
      "text": "从汉代开始，",
      "token_start": 469,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 142800,
      "end_ms": 145385,
      "text": "历代皇帝都来衡山祭祀，",
      "token_start": 474,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 146190,
      "end_ms": 147145,
      "text": "一年四季，",
      "token_start": 484,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 147460,
      "end_ms": 148520,
      "text": "春天看花，",
      "token_start": 488,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 148900,
      "end_ms": 150000,
      "text": "夏天避暑，",
      "token_start": 492,
      "token_end_exclusive": 496
    },
    {
      "start_ms": 150300,
      "end_ms": 151625,
      "text": "秋天看日出，",
      "token_start": 496,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 152240,
      "end_ms": 153155,
      "text": "冬天看雪。",
      "token_start": 501,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 153450,
      "end_ms": 156690,
      "text": "东天横山顶上悟感挂满树枝，",
      "token_start": 505,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 156890,
      "end_ms": 158025,
      "text": "跟冰雕一样，",
      "token_start": 517,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 158410,
      "end_ms": 159375,
      "text": "山下是绿的，",
      "token_start": 522,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 159570,
      "end_ms": 160695,
      "text": "山上是白的，",
      "token_start": 527,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 161040,
      "end_ms": 164155,
      "text": "您说这是山还是四季的舞台？",
      "token_start": 532,
      "token_end_exclusive": 544
    },
    {
      "start_ms": 164670,
      "end_ms": 165410,
      "text": "第八名，",
      "token_start": 544,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 165690,
      "end_ms": 169805,
      "text": "河南嵩山在河南登封五月里的中月。",
      "token_start": 547,
      "token_end_exclusive": 562
    },
    {
      "start_ms": 170210,
      "end_ms": 174205,
      "text": "这山最绝的是他脚底下踩着两个中国第一，",
      "token_start": 562,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 174850,
      "end_ms": 181605,
      "text": "中国第一座天门台登峰观星台郭守敬在这儿测出了授时力，",
      "token_start": 580,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 182040,
      "end_ms": 185475,
      "text": "一年三百六十五点二四二五天，",
      "token_start": 605,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 186210,
      "end_ms": 188175,
      "text": "跟现在功力几乎一样，",
      "token_start": 618,
      "token_end_exclusive": 627
    },
    {
      "start_ms": 189110,
      "end_ms": 191775,
      "text": "比欧洲早了整整三百年。",
      "token_start": 627,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 192260,
      "end_ms": 198465,
      "text": "中国第一座官办寺院白马寺就在嵩山脚下。",
      "token_start": 637,
      "token_end_exclusive": 655
    },
    {
      "start_ms": 199370,
      "end_ms": 201110,
      "text": "佛教传入中国以后，",
      "token_start": 655,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 201310,
      "end_ms": 203375,
      "text": "官方建的第一座寺院，",
      "token_start": 663,
      "token_end_exclusive": 672
    },
    {
      "start_ms": 203750,
      "end_ms": 207105,
      "text": "一座山踩着一个天门第一，",
      "token_start": 672,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 207430,
      "end_ms": 208605,
      "text": "一个佛教第一，",
      "token_start": 683,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 209440,
      "end_ms": 215325,
      "text": "少林寺也在嵩山达摩面壁九年创了禅宗，",
      "token_start": 689,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 215580,
      "end_ms": 219005,
      "text": "您说这是山还是中原文脉的根？",
      "token_start": 706,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 219890,
      "end_ms": 220585,
      "text": "第七名？",
      "token_start": 719,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 220960,
      "end_ms": 231725,
      "text": "吉林长白山在吉林延边中国最深的火珊瑚天池就在他头顶上最深处三百七十三米，",
      "token_start": 722,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 232280,
      "end_ms": 234785,
      "text": "水面海拔两千一百八十九米。",
      "token_start": 757,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 235330,
      "end_ms": 239210,
      "text": "这山最绝的是他藏在天上四周，",
      "token_start": 769,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 239230,
      "end_ms": 242530,
      "text": "十六座山峰围着向十六个卫士，",
      "token_start": 782,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 242670,
      "end_ms": 244855,
      "text": "把一池水端在半空中，",
      "token_start": 795,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 245790,
      "end_ms": 247965,
      "text": "天池的水只出不进，",
      "token_start": 804,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 248580,
      "end_ms": 249875,
      "text": "没有河流注入，",
      "token_start": 812,
      "token_end_exclusive": 818
    },
    {
      "start_ms": 250400,
      "end_ms": 252305,
      "text": "全靠雨水和地下水。",
      "token_start": 818,
      "token_end_exclusive": 826
    },
    {
      "start_ms": 253110,
      "end_ms": 257840,
      "text": "可水位几百年不变更邪乎的是天池，",
      "token_start": 826,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 257860,
      "end_ms": 259515,
      "text": "一年有三分之二的时间，",
      "token_start": 841,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 259910,
      "end_ms": 260825,
      "text": "云雾笼罩，",
      "token_start": 851,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 261170,
      "end_ms": 262585,
      "text": "很多人去了好几次，",
      "token_start": 855,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 262930,
      "end_ms": 264315,
      "text": "连湖面都没见着，",
      "token_start": 863,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 264840,
      "end_ms": 266865,
      "text": "能看见天池全貌的人，",
      "token_start": 870,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 267430,
      "end_ms": 268210,
      "text": "当地人说，",
      "token_start": 879,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 268470,
      "end_ms": 269485,
      "text": "那是有缘分，",
      "token_start": 883,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 269900,
      "end_ms": 273375,
      "text": "您说这是山还是老天爷搁在山顶上的一碗水？",
      "token_start": 888,
      "token_end_exclusive": 907
    },
    {
      "start_ms": 273970,
      "end_ms": 274635,
      "text": "第六名，",
      "token_start": 907,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 275610,
      "end_ms": 282365,
      "text": "江西庐山在江西九江这山最绝的不是是诗。",
      "token_start": 910,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 283230,
      "end_ms": 284675,
      "text": "庐山有多少诗？",
      "token_start": 928,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 285530,
      "end_ms": 286270,
      "text": "据统计，",
      "token_start": 934,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 286530,
      "end_ms": 291465,
      "text": "三千五百多位名人写下了一万六千多首诗歌。",
      "token_start": 937,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 292210,
      "end_ms": 293210,
      "text": "咏唱庐山，",
      "token_start": 956,
      "token_end_exclusive": 960
    },
    {
      "start_ms": 294050,
      "end_ms": 295590,
      "text": "李白来过五次，",
      "token_start": 960,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 296130,
      "end_ms": 301150,
      "text": "写了四十多篇一首望庐山瀑布飞流直下三千尺，",
      "token_start": 966,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 301550,
      "end_ms": 303610,
      "text": "疑是银河落九天。",
      "token_start": 986,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 304110,
      "end_ms": 305050,
      "text": "苏轼来了，",
      "token_start": 993,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 305210,
      "end_ms": 307250,
      "text": "写了一句不识庐山真面目，",
      "token_start": 997,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 307690,
      "end_ms": 309470,
      "text": "只缘身在此山中，",
      "token_start": 1008,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 309650,
      "end_ms": 310550,
      "text": "白居易来了，",
      "token_start": 1015,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 310850,
      "end_ms": 313130,
      "text": "写人间四月芳菲尽，",
      "token_start": 1020,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 313550,
      "end_ms": 315570,
      "text": "山寺桃花始盛开，",
      "token_start": 1028,
      "token_end_exclusive": 1035
    },
    {
      "start_ms": 316130,
      "end_ms": 317730,
      "text": "陶渊明住在山脚下，",
      "token_start": 1035,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 318210,
      "end_ms": 319590,
      "text": "采菊东篱下，",
      "token_start": 1043,
      "token_end_exclusive": 1048
    },
    {
      "start_ms": 319930,
      "end_ms": 321170,
      "text": "悠然见南山。",
      "token_start": 1048,
      "token_end_exclusive": 1053
    },
    {
      "start_ms": 321170,
      "end_ms": 325540,
      "text": "一座座山把中国最好的诗人全招来了，",
      "token_start": 1053,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 326280,
      "end_ms": 329080,
      "text": "您说这是山还是一本诗集？",
      "token_start": 1069,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 329900,
      "end_ms": 331280,
      "text": "从第十到第六，",
      "token_start": 1080,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 331580,
      "end_ms": 334040,
      "text": "衡山是北方的屏障，",
      "token_start": 1086,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 334640,
      "end_ms": 336800,
      "text": "衡山是四季的舞台，",
      "token_start": 1094,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 337160,
      "end_ms": 339600,
      "text": "嵩山是中原文脉的根，",
      "token_start": 1102,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 340320,
      "end_ms": 342600,
      "text": "长白山是老天爷的一碗水，",
      "token_start": 1111,
      "token_end_exclusive": 1122
    },
    {
      "start_ms": 342940,
      "end_ms": 344460,
      "text": "庐山是一本诗集，",
      "token_start": 1122,
      "token_end_exclusive": 1129
    },
    {
      "start_ms": 345200,
      "end_ms": 347920,
      "text": "可这五个还不是最震撼的。",
      "token_start": 1129,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 348740,
      "end_ms": 350140,
      "text": "接下来第五道第一，",
      "token_start": 1140,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 350320,
      "end_ms": 351545,
      "text": "一个比一个狠，",
      "token_start": 1148,
      "token_end_exclusive": 1154
    },
    {
      "start_ms": 352080,
      "end_ms": 352975,
      "text": "有一座山，",
      "token_start": 1154,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 353480,
      "end_ms": 355095,
      "text": "自古华山一条路，",
      "token_start": 1158,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 355470,
      "end_ms": 356315,
      "text": "有一座山，",
      "token_start": 1165,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 356660,
      "end_ms": 357675,
      "text": "金顶佛光，",
      "token_start": 1169,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 358120,
      "end_ms": 359040,
      "text": "还有一座山，",
      "token_start": 1173,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 359240,
      "end_ms": 361040,
      "text": "被叫做万山之祖。",
      "token_start": 1178,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 361180,
      "end_ms": 362545,
      "text": "它凭什么排第一？",
      "token_start": 1185,
      "token_end_exclusive": 1192
    },
    {
      "start_ms": 362880,
      "end_ms": 364095,
      "text": "下集马上更新，",
      "token_start": 1192,
      "token_end_exclusive": 1198
    },
    {
      "start_ms": 364450,
      "end_ms": 367325,
      "text": "您先点个关注点开头像别走丢。",
      "token_start": 1198,
      "token_end_exclusive": 1211
    }
