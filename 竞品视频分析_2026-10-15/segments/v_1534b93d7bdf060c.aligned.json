{
  "video_id": "v_1534b93d7bdf060c",
  "duration_s": 315.584,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_1534b93d7bdf060c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_1534b93d7bdf060c.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 400,
      "end_ms": 800,
      "text": "朱军，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 1060,
      "end_ms": 4380,
      "text": "你觉得无人驾驶和有人驾驶哪个更安全？",
      "token_start": 2,
      "token_end_exclusive": 19
    },
    {
      "start_ms": 4760,
      "end_ms": 5460,
      "text": "你相信吗？",
      "token_start": 19,
      "token_end_exclusive": 23
    },
    {
      "start_ms": 5580,
      "end_ms": 8160,
      "text": "机器人竟然能够看得懂镜子里的自己？",
      "token_start": 23,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 8600,
      "end_ms": 11980,
      "text": "今天我在美国哥伦比亚大学听了一堂hold普lison教授的课，",
      "token_start": 39,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 12240,
      "end_ms": 14360,
      "text": "他是人类三d打印技术的先驱。",
      "token_start": 62,
      "token_end_exclusive": 75
    },
    {
      "start_ms": 14480,
      "end_ms": 17860,
      "text": "而近几年重点研究AI从屏幕里走出来的自我模型，",
      "token_start": 75,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 17860,
      "end_ms": 19320,
      "text": "建设他的团队，",
      "token_start": 96,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 19500,
      "end_ms": 22080,
      "text": "让机器人已经开始学会照镜子，",
      "token_start": 102,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 22080,
      "end_ms": 22980,
      "text": "来认识自己，",
      "token_start": 115,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 23120,
      "end_ms": 25500,
      "text": "把这种能力叫做一种自我建模。",
      "token_start": 120,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 25840,
      "end_ms": 27540,
      "text": "机器人尝试着去理解、思考，",
      "token_start": 133,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 27540,
      "end_ms": 28320,
      "text": "我是谁？",
      "token_start": 144,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 28320,
      "end_ms": 29400,
      "text": "朱军，",
      "token_start": 147,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 29400,
      "end_ms": 32450,
      "text": "我们已经前总是安慰自己机器人有知识，",
      "token_start": 149,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 32450,
      "end_ms": 33710,
      "text": "但他没有情感。",
      "token_start": 166,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 33710,
      "end_ms": 36090,
      "text": "但是这个教授的团队做过一个机器人，",
      "token_start": 172,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 36090,
      "end_ms": 38170,
      "text": "他会观察人的面部变化，",
      "token_start": 188,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 38170,
      "end_ms": 41830,
      "text": "能够提前大约八百四十毫秒预测你即将微笑，",
      "token_start": 198,
      "token_end_exclusive": 217
    },
    {
      "start_ms": 41830,
      "end_ms": 43930,
      "text": "然后几乎和你同时笑出来。",
      "token_start": 217,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 44190,
      "end_ms": 46090,
      "text": "不是等你笑完他在模仿你，",
      "token_start": 228,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 46150,
      "end_ms": 47450,
      "text": "而是他提前预判，",
      "token_start": 239,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 47670,
      "end_ms": 48470,
      "text": "你要笑了，",
      "token_start": 246,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 48550,
      "end_ms": 49790,
      "text": "然后和你一起笑。",
      "token_start": 250,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 50050,
      "end_ms": 52050,
      "text": "你想想那个画面是不是挺恐怖的。",
      "token_start": 257,
      "token_end_exclusive": 271
    },
    {
      "start_ms": 52210,
      "end_ms": 54810,
      "text": "他们在培养AI机器人的本能和直觉。",
      "token_start": 271,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 55410,
      "end_ms": 58210,
      "text": "而第二件事情会让很多老司机不服气，",
      "token_start": 286,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 58590,
      "end_ms": 61460,
      "text": "他觉得很多论证在一些现实场景里面，",
      "token_start": 302,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 61460,
      "end_ms": 64645,
      "text": "自动驾驶现在已经完全比人类开的更安全。",
      "token_start": 318,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 65120,
      "end_ms": 66160,
      "text": "二十年以后的人，",
      "token_start": 336,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 66160,
      "end_ms": 68040,
      "text": "看今天的人还在亲自开着车，",
      "token_start": 343,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 68180,
      "end_ms": 70475,
      "text": "就像我们今天看别人在骑马骑驴，",
      "token_start": 355,
      "token_end_exclusive": 369
    },
    {
      "start_ms": 70980,
      "end_ms": 72460,
      "text": "起码最多只是个爱好，",
      "token_start": 369,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 72500,
      "end_ms": 74080,
      "text": "但它确实有危险啊，",
      "token_start": 378,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 74080,
      "end_ms": 76845,
      "text": "未来你自己开车也可能会变成类似的事情。",
      "token_start": 386,
      "token_end_exclusive": 404
    },
    {
      "start_ms": 77130,
      "end_ms": 78870,
      "text": "不是因为人类突然不会开车，",
      "token_start": 404,
      "token_end_exclusive": 416
    },
    {
      "start_ms": 79010,
      "end_ms": 81585,
      "text": "而是因为机器不允许你犯人的错误，",
      "token_start": 416,
      "token_end_exclusive": 431
    },
    {
      "start_ms": 81880,
      "end_ms": 83140,
      "text": "人会困有路，",
      "token_start": 431,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 83140,
      "end_ms": 84775,
      "text": "怒症会走神等等。",
      "token_start": 436,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 85180,
      "end_ms": 86260,
      "text": "而第三件事情，",
      "token_start": 443,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 86260,
      "end_ms": 88390,
      "text": "所有家长都必须听你，",
      "token_start": 449,
      "token_end_exclusive": 458
    },
    {
      "start_ms": 88390,
      "end_ms": 91875,
      "text": "孩子未来最喜欢的老师可能根本不是一个真的人。",
      "token_start": 458,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 92320,
      "end_ms": 94540,
      "text": "普lason教授课堂上直接放了一个数字，",
      "token_start": 479,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 94700,
      "end_ms": 97705,
      "text": "百分之八十三的学生更喜欢AI老师，",
      "token_start": 494,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 98050,
      "end_ms": 99490,
      "text": "因为AI更有耐心，",
      "token_start": 509,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 99670,
      "end_ms": 100650,
      "text": "他不会责怪你，",
      "token_start": 516,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 100670,
      "end_ms": 101825,
      "text": "也不会和你生气。",
      "token_start": 522,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 102290,
      "end_ms": 104165,
      "text": "人类老师最贵的东西是什么？",
      "token_start": 529,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 104410,
      "end_ms": 105150,
      "text": "不是知识，",
      "token_start": 541,
      "token_end_exclusive": 545
    },
    {
      "start_ms": 105210,
      "end_ms": 106155,
      "text": "是时间。",
      "token_start": 545,
      "token_end_exclusive": 548
    },
    {
      "start_ms": 106610,
      "end_ms": 109230,
      "text": "一个老师面对三十个孩子再负责任，",
      "token_start": 548,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 109230,
      "end_ms": 110830,
      "text": "也不可能每个人讲五十遍。",
      "token_start": 563,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 111050,
      "end_ms": 114050,
      "text": "但是AI可以你不会再讲一遍，",
      "token_start": 574,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 114230,
      "end_ms": 115670,
      "text": "还不会换一种方式，",
      "token_start": 586,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 115670,
      "end_ms": 118055,
      "text": "讲二十四小时永远在线。",
      "token_start": 594,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 118400,
      "end_ms": 123295,
      "text": " Ai第一次让每一个普通家庭也拥有一种过去只有极少数人买得起的东西，",
      "token_start": 604,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 123730,
      "end_ms": 125575,
      "text": "无限时的一对一教育。",
      "token_start": 635,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 125900,
      "end_ms": 126420,
      "text": "你想想，",
      "token_start": 644,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 126640,
      "end_ms": 128020,
      "text": "当一个永远不累，",
      "token_start": 647,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 128160,
      "end_ms": 128960,
      "text": "永远不烦，",
      "token_start": 654,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 129140,
      "end_ms": 130045,
      "text": "越来越懂你，",
      "token_start": 658,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 130260,
      "end_ms": 132605,
      "text": "而且只服你一个人的老师出现以后，",
      "token_start": 663,
      "token_end_exclusive": 678
    },
    {
      "start_ms": 132980,
      "end_ms": 135555,
      "text": "人类老师最不可替代的东西到底是什么？",
      "token_start": 678,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 135890,
      "end_ms": 137210,
      "text": "听到这里很多人会担心，",
      "token_start": 695,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 137370,
      "end_ms": 139050,
      "text": "那是不是以后老师就要失业了，",
      "token_start": 705,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 139150,
      "end_ms": 140285,
      "text": "司机就要失业了。",
      "token_start": 718,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 140560,
      "end_ms": 142075,
      "text": "但是教授反而提醒我们，",
      "token_start": 725,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 142360,
      "end_ms": 143300,
      "text": "真正的机会，",
      "token_start": 735,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 143320,
      "end_ms": 145905,
      "text": "恰恰可能比被替代的岗位要更多。",
      "token_start": 740,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 146290,
      "end_ms": 148785,
      "text": "这件事情其实每次技术革命都发生过，",
      "token_start": 754,
      "token_end_exclusive": 770
    },
    {
      "start_ms": 149090,
      "end_ms": 150390,
      "text": "当年汽车出来以后，",
      "token_start": 770,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 150450,
      "end_ms": 151795,
      "text": "马车夫确实少了，",
      "token_start": 778,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 152080,
      "end_ms": 155245,
      "text": "但是后来出现了很多以前根本不存在的职业。",
      "token_start": 785,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 155590,
      "end_ms": 161385,
      "text": "汽车设计师、维修工、高速公路、保险、加油站、物流网约车等等。",
      "token_start": 804,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 161820,
      "end_ms": 162080,
      "text": "所以，",
      "token_start": 828,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 162080,
      "end_ms": 163200,
      "text": "真正值得我们担心的，",
      "token_start": 830,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 163200,
      "end_ms": 164560,
      "text": "不是未来还有没有工作，",
      "token_start": 839,
      "token_end_exclusive": 849
    },
    {
      "start_ms": 164820,
      "end_ms": 167880,
      "text": "而是未来新增的工作里有没有你的位置。",
      "token_start": 849,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 167960,
      "end_ms": 169470,
      "text": "这两句话差别太大了。",
      "token_start": 866,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 170000,
      "end_ms": 172855,
      "text": "整堂课最让我觉得普通人兴奋的一件事情，",
      "token_start": 875,
      "token_end_exclusive": 893
    },
    {
      "start_ms": 173130,
      "end_ms": 174830,
      "text": "AI不是只会抢饭碗，",
      "token_start": 893,
      "token_end_exclusive": 901
    },
    {
      "start_ms": 174930,
      "end_ms": 178750,
      "text": "它会推动人类创造力真正转化为生产力的大爆发。",
      "token_start": 901,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 178750,
      "end_ms": 183680,
      "text": "时代教授在各大有个本科学生有一天突然跑过去问了一个问题，",
      "token_start": 922,
      "token_end_exclusive": 949
    },
    {
      "start_ms": 184100,
      "end_ms": 187040,
      "text": "怎么判断两个指纹是不是同一个人呢？",
      "token_start": 949,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 187300,
      "end_ms": 188100,
      "text": "你能想象吗？",
      "token_start": 965,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 188220,
      "end_ms": 190860,
      "text": "这个学生根本没有学过任何法医科学，",
      "token_start": 970,
      "token_end_exclusive": 986
    },
    {
      "start_ms": 191080,
      "end_ms": 194560,
      "text": "但是他和团队采集了六万多枚的指纹去训练AI,",
      "token_start": 986,
      "token_end_exclusive": 1006
    },
    {
      "start_ms": 194780,
      "end_ms": 196540,
      "text": "结果发现同一个人不同，",
      "token_start": 1006,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 196560,
      "end_ms": 197680,
      "text": "手指留下的指纹，",
      "token_start": 1016,
      "token_end_exclusive": 1023
    },
    {
      "start_ms": 197860,
      "end_ms": 200840,
      "text": "其实存在一种机器可以识别的相似性。",
      "token_start": 1023,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 201080,
      "end_ms": 203360,
      "text": "这项成果还发表在了科学杂志。",
      "token_start": 1039,
      "token_end_exclusive": 1052
    },
    {
      "start_ms": 203740,
      "end_ms": 204320,
      "text": "你想想，",
      "token_start": 1052,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 204580,
      "end_ms": 205940,
      "text": "一个外行的学生，",
      "token_start": 1055,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 206060,
      "end_ms": 207080,
      "text": "只要借助AI,",
      "token_start": 1062,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 207220,
      "end_ms": 209000,
      "text": "竟然可以闯进一个成熟的行业。",
      "token_start": 1067,
      "token_end_exclusive": 1080
    },
    {
      "start_ms": 209000,
      "end_ms": 210630,
      "text": "你干了二十多年，",
      "token_start": 1080,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 210810,
      "end_ms": 213630,
      "text": "未来有可能输给一个刚入行二十天的人。",
      "token_start": 1087,
      "token_end_exclusive": 1104
    },
    {
      "start_ms": 213970,
      "end_ms": 214770,
      "text": "下面这句话，",
      "token_start": 1104,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 214770,
      "end_ms": 217689,
      "text": "我建议所有靠脑子吃饭的人都牢牢记住，",
      "token_start": 1109,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 218190,
      "end_ms": 219970,
      "text": "你当下最值钱的本事，",
      "token_start": 1126,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 220190,
      "end_ms": 222730,
      "text": "会不会恰好是AI最便宜的功能。",
      "token_start": 1135,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 223130,
      "end_ms": 225470,
      "text": "你花了十几年去读书考试考证，",
      "token_start": 1148,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 225650,
      "end_ms": 227330,
      "text": "又花十几年累积经验，",
      "token_start": 1161,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 227470,
      "end_ms": 229550,
      "text": "终于成了别人嘴里的专业人士。",
      "token_start": 1170,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 229710,
      "end_ms": 231410,
      "text": "结果有一天你突然发现，",
      "token_start": 1183,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 231710,
      "end_ms": 233010,
      "text": "别人打开一个软件，",
      "token_start": 1193,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 233070,
      "end_ms": 235770,
      "text": "三十秒钟就能完成你过去大半天的工作。",
      "token_start": 1201,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 236050,
      "end_ms": 241145,
      "text": "那个时候真正残酷的问题是你除了AI也会东西还剩下什么？",
      "token_start": 1218,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 241410,
      "end_ms": 242230,
      "text": "这节课听下来，",
      "token_start": 1243,
      "token_end_exclusive": 1249
    },
    {
      "start_ms": 242230,
      "end_ms": 243230,
      "text": "我最大的感受是，",
      "token_start": 1249,
      "token_end_exclusive": 1256
    },
    {
      "start_ms": 243410,
      "end_ms": 246725,
      "text": "我们可能严重低估了AI接下来改变世界的速度。",
      "token_start": 1256,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 247240,
      "end_ms": 249725,
      "text": "我向教授问了一个对我自己特别重要的问题，",
      "token_start": 1276,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 249930,
      "end_ms": 251195,
      "text": "因为我是做新媒体的，",
      "token_start": 1295,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 251380,
      "end_ms": 253890,
      "text": "我就问他AI现在能够写文章，",
      "token_start": 1304,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 254030,
      "end_ms": 254770,
      "text": "会做视频，",
      "token_start": 1316,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 254910,
      "end_ms": 255850,
      "text": "会生成声音，",
      "token_start": 1320,
      "token_end_exclusive": 1325
    },
    {
      "start_ms": 255930,
      "end_ms": 258355,
      "text": "也能够生成一个和真人一模一样的主播。",
      "token_start": 1325,
      "token_end_exclusive": 1342
    },
    {
      "start_ms": 258730,
      "end_ms": 261510,
      "text": "那我们这些内容创作者到底靠什么去面对？",
      "token_start": 1342,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 261510,
      "end_ms": 262255,
      "text": "下一个时代，",
      "token_start": 1360,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 262850,
      "end_ms": 264090,
      "text": "他给我的答案特别短，",
      "token_start": 1365,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 264170,
      "end_ms": 268160,
      "text": "就因此真实感真正的去做真正的去爱，",
      "token_start": 1374,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 268420,
      "end_ms": 269520,
      "text": "真正的去表达，",
      "token_start": 1390,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 269680,
      "end_ms": 271295,
      "text": "真正的去成为你自己。",
      "token_start": 1396,
      "token_end_exclusive": 1405
    },
    {
      "start_ms": 271730,
      "end_ms": 272550,
      "text": "在AI时代，",
      "token_start": 1405,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 272550,
      "end_ms": 274190,
      "text": "最大的稀缺品不是聪明，",
      "token_start": 1409,
      "token_end_exclusive": 1419
    },
    {
      "start_ms": 274370,
      "end_ms": 275485,
      "text": "而是真实。",
      "token_start": 1419,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 275980,
      "end_ms": 277460,
      "text": "不要把自己活成一个内容，",
      "token_start": 1423,
      "token_end_exclusive": 1434
    },
    {
      "start_ms": 277460,
      "end_ms": 278200,
      "text": "生产机器，",
      "token_start": 1434,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 278420,
      "end_ms": 280100,
      "text": "多去读书旅行，",
      "token_start": 1438,
      "token_end_exclusive": 1444
    },
    {
      "start_ms": 280340,
      "end_ms": 282020,
      "text": "见人进入各种现场，",
      "token_start": 1444,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 282220,
      "end_ms": 283440,
      "text": "真正强的内容，",
      "token_start": 1452,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 283600,
      "end_ms": 285240,
      "text": "要说出人们早有的感受，",
      "token_start": 1458,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 285440,
      "end_ms": 287620,
      "text": "却一直没有能精准说出的那句话。",
      "token_start": 1468,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 287780,
      "end_ms": 291080,
      "text": "他说你要努力做到当某件事情发生的时候，",
      "token_start": 1482,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 291080,
      "end_ms": 293500,
      "text": "观众会主动想到哎这个问题，",
      "token_start": 1500,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 293640,
      "end_ms": 299160,
      "text": "我想听听赵建他会是怎么说的当机器越来越像人人最重要的事情，",
      "token_start": 1512,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 299160,
      "end_ms": 300855,
      "text": "就是别把自己活成机器。",
      "token_start": 1540,
      "token_end_exclusive": 1550
    },
    {
      "start_ms": 301190,
      "end_ms": 303230,
      "text": "因为在像机器这件事情上，",
      "token_start": 1550,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 303250,
      "end_ms": 304855,
      "text": "人类注定赢不了机器，",
      "token_start": 1561,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 305250,
      "end_ms": 307170,
      "text": "真正值得我们训练的是机器，",
      "token_start": 1570,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 307310,
      "end_ms": 308950,
      "text": "难以替代我们完成的东西。",
      "token_start": 1582,
      "token_end_exclusive": 1593
    },
    {
      "start_ms": 309090,
      "end_ms": 310490,
      "text": "去爱去冒险，",
      "token_start": 1593,
      "token_end_exclusive": 1598
    },
    {
      "start_ms": 310630,
      "end_ms": 311270,
      "text": "去现场，",
      "token_start": 1598,
      "token_end_exclusive": 1601
    },
    {
      "start_ms": 311410,
      "end_ms": 312105,
      "text": "去经历，",
      "token_start": 1601,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 312410,
      "end_ms": 313965,
      "text": "去犯错、去创造，",
      "token_start": 1604,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 314230,
      "end_ms": 315375,
      "text": "去成为你自己。",
      "token_start": 1610,
      "token_end_exclusive": 1616
    }
  ],
