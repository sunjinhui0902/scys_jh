  "segments": [
    {
      "start_ms": 490,
      "end_ms": 2210,
      "text": "上有天堂下有苏杭，",
      "token_start": 0,
      "token_end_exclusive": 8
    },
    {
      "start_ms": 2490,
      "end_ms": 4370,
      "text": "这句话大家从小听到的，",
      "token_start": 8,
      "token_end_exclusive": 18
    },
    {
      "start_ms": 4970,
      "end_ms": 7530,
      "text": "可你知道他为什么这么说吗？",
      "token_start": 18,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 8130,
      "end_ms": 9750,
      "text": "这句话最早出自南宋，",
      "token_start": 30,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 10110,
      "end_ms": 10490,
      "text": "说的，",
      "token_start": 39,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 10490,
      "end_ms": 14590,
      "text": "其实就是苏杭两座城市的赋者与美景。",
      "token_start": 41,
      "token_end_exclusive": 57
    },
    {
      "start_ms": 15630,
      "end_ms": 18190,
      "text": "苏州与园林为名，",
      "token_start": 57,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 18210,
      "end_ms": 19030,
      "text": "小桥流水，",
      "token_start": 64,
      "token_end_exclusive": 68
    },
    {
      "start_ms": 19170,
      "end_ms": 19930,
      "text": "一步一景，",
      "token_start": 68,
      "token_end_exclusive": 72
    },
    {
      "start_ms": 20190,
      "end_ms": 21710,
      "text": "是江南风雅的旗帜。",
      "token_start": 72,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 22210,
      "end_ms": 24170,
      "text": "杭州以西湖著称，",
      "token_start": 80,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 25790,
      "end_ms": 28190,
      "text": "苏体春晓、雷风西照，",
      "token_start": 87,
      "token_end_exclusive": 95
    },
    {
      "start_ms": 28370,
      "end_ms": 29450,
      "text": "处处是诗画。",
      "token_start": 95,
      "token_end_exclusive": 100
    },
    {
      "start_ms": 29750,
      "end_ms": 30135,
      "text": "更关。",
      "token_start": 100,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 30260,
      "end_ms": 31580,
      "text": "关键的是两座城市，",
      "token_start": 102,
      "token_end_exclusive": 110
    },
    {
      "start_ms": 31580,
      "end_ms": 33600,
      "text": "自古就是鱼米之乡，",
      "token_start": 110,
      "token_end_exclusive": 118
    },
    {
      "start_ms": 34140,
      "end_ms": 35040,
      "text": "物产丰饶，",
      "token_start": 118,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 35960,
      "end_ms": 38020,
      "text": "百姓生活安稳富足，",
      "token_start": 122,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 38460,
      "end_ms": 39520,
      "text": "在古人眼里，",
      "token_start": 130,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 39700,
      "end_ms": 42280,
      "text": "能在苏杭安居乐业。",
      "token_start": 135,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 42280,
      "end_ms": 44300,
      "text": "那可不就是神仙般的好日子吗？",
      "token_start": 143,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 44340,
      "end_ms": 49920,
      "text": "所以这句话其实寄托了中国人对美好生活的最朴素向往。",
      "token_start": 156,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 50200,
      "end_ms": 50760,
      "text": "关注我，",
      "token_start": 180,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 50880,
      "end_ms": 53515,
      "text": "带你看遍中国最美历史名称。",
      "token_start": 183,
      "token_end_exclusive": 195
    }
  ],
