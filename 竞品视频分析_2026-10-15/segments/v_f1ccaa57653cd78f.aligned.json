{
  "video_id": "v_f1ccaa57653cd78f",
  "duration_s": 485.62069,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\transcripts\\v_f1ccaa57653cd78f.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\segments\\v_f1ccaa57653cd78f.json",
  "alignment_method": "Transcription tokens (Chinese characters or ASCII alphanumeric runs) sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "segments": [
    {
      "start_ms": 110,
      "end_ms": 1130,
      "text": "一九五九年，",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1470,
      "end_ms": 2670,
      "text": "朱光亚消失了，",
      "token_start": 5,
      "token_end_exclusive": 11
    },
    {
      "start_ms": 3350,
      "end_ms": 5790,
      "text": "他去了青海湖边的戈壁滩，",
      "token_start": 11,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 6230,
      "end_ms": 7830,
      "text": "一个叫马兰的地方，",
      "token_start": 22,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 8650,
      "end_ms": 9730,
      "text": "那地方什么样？",
      "token_start": 30,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 10470,
      "end_ms": 11750,
      "text": "抬头是灰的，",
      "token_start": 36,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 11750,
      "end_ms": 12850,
      "text": "低头是灰的，",
      "token_start": 41,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 13010,
      "end_ms": 13250,
      "text": "风，",
      "token_start": 46,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 13330,
      "end_ms": 15550,
      "text": "刮在脸上像刀子割肉，",
      "token_start": 47,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 15930,
      "end_ms": 17930,
      "text": "冬天零下三十度哈，",
      "token_start": 56,
      "token_end_exclusive": 64
    },
    {
      "start_ms": 17930,
      "end_ms": 19010,
      "text": "口气都能结冰。",
      "token_start": 64,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 19430,
      "end_ms": 20330,
      "text": "没有城市，",
      "token_start": 70,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 20510,
      "end_ms": 21530,
      "text": "没有实验室，",
      "token_start": 74,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 21790,
      "end_ms": 23090,
      "text": "连路都得自己修。",
      "token_start": 79,
      "token_end_exclusive": 86
    },
    {
      "start_ms": 23670,
      "end_ms": 24810,
      "text": "就在这种地方，",
      "token_start": 86,
      "token_end_exclusive": 92
    },
    {
      "start_ms": 25110,
      "end_ms": 29310,
      "text": "朱光亚和他的同事们干了一件说出来你都不信的事。",
      "token_start": 92,
      "token_end_exclusive": 114
    },
    {
      "start_ms": 29670,
      "end_ms": 31540,
      "text": "一为用算盘算原子弹，",
      "token_start": 114,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 31680,
      "end_ms": 32500,
      "text": "你没听错，",
      "token_start": 123,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 32820,
      "end_ms": 36100,
      "text": "就是老祖宗传下来的那种算盘。",
      "token_start": 127,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 36260,
      "end_ms": 38300,
      "text": "几十个人三班倒人歇，",
      "token_start": 140,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 38380,
      "end_ms": 39200,
      "text": "算盘不歇，",
      "token_start": 149,
      "token_end_exclusive": 153
    },
    {
      "start_ms": 39500,
      "end_ms": 42980,
      "text": "噼里啪啦噼里啪啦一组数据要磕三个月，",
      "token_start": 153,
      "token_end_exclusive": 170
    },
    {
      "start_ms": 43540,
      "end_ms": 45000,
      "text": "好不容易算完了，",
      "token_start": 170,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 45300,
      "end_ms": 48720,
      "text": "发现小数点后第三位对不上怎么办？",
      "token_start": 177,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 49100,
      "end_ms": 50700,
      "text": "全组推倒重来，",
      "token_start": 192,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 51180,
      "end_ms": 52420,
      "text": "有人算到半夜，",
      "token_start": 198,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 52660,
      "end_ms": 53620,
      "text": "精神崩溃，",
      "token_start": 204,
      "token_end_exclusive": 208
    },
    {
      "start_ms": 54020,
      "end_ms": 55180,
      "text": "把算盘砸了。",
      "token_start": 208,
      "token_end_exclusive": 213
    },
    {
      "start_ms": 55660,
      "end_ms": 57040,
      "text": "有人算着算着，",
      "token_start": 213,
      "token_end_exclusive": 219
    },
    {
      "start_ms": 57180,
      "end_ms": 58660,
      "text": "瘫在地上不动了，",
      "token_start": 219,
      "token_end_exclusive": 226
    },
    {
      "start_ms": 58940,
      "end_ms": 61515,
      "text": "朱光雅始终都没掉过一滴泪。",
      "token_start": 226,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 62080,
      "end_ms": 63235,
      "text": "只说了一句话，",
      "token_start": 238,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 63980,
      "end_ms": 70325,
      "text": "数据必须准确到小数点后第八位第八位是什么概念？",
      "token_start": 244,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 70690,
      "end_ms": 74100,
      "text": "差之毫厘谬以千里原子弹，",
      "token_start": 266,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 74100,
      "end_ms": 78085,
      "text": "这东西错一个小数点就是几百条人命，",
      "token_start": 277,
      "token_end_exclusive": 293
    },
    {
      "start_ms": 78540,
      "end_ms": 79520,
      "text": "就这么一个树，",
      "token_start": 293,
      "token_end_exclusive": 299
    },
    {
      "start_ms": 79520,
      "end_ms": 82225,
      "text": "一个树死磕磕了整整十年。",
      "token_start": 299,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 83010,
      "end_ms": 83985,
      "text": "这十年里，",
      "token_start": 310,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 84240,
      "end_ms": 86015,
      "text": "朱光亚没回过几次家，",
      "token_start": 314,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 86580,
      "end_ms": 89025,
      "text": "没陪妻子过过一个像样的生日。",
      "token_start": 323,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 89910,
      "end_ms": 93835,
      "text": "北京的家里妻子许慧君一个人带着两个孩子，",
      "token_start": 336,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 94210,
      "end_ms": 95870,
      "text": "左手牵一个怀里，",
      "token_start": 355,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 95870,
      "end_ms": 96565,
      "text": "抱一个，",
      "token_start": 362,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 96970,
      "end_ms": 98145,
      "text": "半夜孩子发烧，",
      "token_start": 365,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 98650,
      "end_ms": 100095,
      "text": "他一个人往医院跑。",
      "token_start": 371,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 101400,
      "end_ms": 102300,
      "text": "邻居们怎么说？",
      "token_start": 379,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 102380,
      "end_ms": 104115,
      "text": "这男人抛妻弃子，",
      "token_start": 385,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 104490,
      "end_ms": 105805,
      "text": "怕是死在外面了。",
      "token_start": 392,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 106750,
      "end_ms": 108435,
      "text": "许慧君听着这些话，",
      "token_start": 399,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 108860,
      "end_ms": 111495,
      "text": "咬着牙一个字都没解释，",
      "token_start": 407,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 111940,
      "end_ms": 112925,
      "text": "他不能解释，",
      "token_start": 417,
      "token_end_exclusive": 422
    },
    {
      "start_ms": 113230,
      "end_ms": 114075,
      "text": "也解释不了，",
      "token_start": 422,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 114510,
      "end_ms": 116825,
      "text": "她自己都不知道丈夫在干什么，",
      "token_start": 427,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 117260,
      "end_ms": 119595,
      "text": "只知道他在干一件大事，",
      "token_start": 440,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 120360,
      "end_ms": 121380,
      "text": "你说这叫什么？",
      "token_start": 450,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 122280,
      "end_ms": 123600,
      "text": "这叫一个女人，",
      "token_start": 456,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 123960,
      "end_ms": 126060,
      "text": "用自己的名声和委屈，",
      "token_start": 462,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 126560,
      "end_ms": 129220,
      "text": "替丈夫守住了一个国家的秘密。",
      "token_start": 471,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 129820,
      "end_ms": 130900,
      "text": "一九六二年，",
      "token_start": 484,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 131400,
      "end_ms": 134380,
      "text": "朱光亚牵头拿出了方案定下目标，",
      "token_start": 489,
      "token_end_exclusive": 503
    },
    {
      "start_ms": 134680,
      "end_ms": 138020,
      "text": "争取两年左右让原子弹炸响。",
      "token_start": 503,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 138240,
      "end_ms": 139880,
      "text": "所有人都觉得她疯了。",
      "token_start": 515,
      "token_end_exclusive": 524
    },
    {
      "start_ms": 140780,
      "end_ms": 141800,
      "text": "苏联专家说，",
      "token_start": 524,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 141860,
      "end_ms": 143940,
      "text": "二十年都搞出来你两年，",
      "token_start": 529,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 144840,
      "end_ms": 146460,
      "text": "但朱光亚心里清楚，",
      "token_start": 539,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 146620,
      "end_ms": 147480,
      "text": "没有时间了，",
      "token_start": 547,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 148500,
      "end_ms": 149995,
      "text": "外面有人天天拿核弹，",
      "token_start": 552,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 150150,
      "end_ms": 153550,
      "text": "指着你晚一天就多一天的危险。",
      "token_start": 561,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 154150,
      "end_ms": 157450,
      "text": "一九六四年十月十六号下午三点，",
      "token_start": 574,
      "token_end_exclusive": 588
    },
    {
      "start_ms": 157790,
      "end_ms": 161450,
      "text": "罗布泊所有人都趴在观测点，",
      "token_start": 588,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 161830,
      "end_ms": 162890,
      "text": "屏住了呼吸，",
      "token_start": 600,
      "token_end_exclusive": 605
    },
    {
      "start_ms": 163950,
      "end_ms": 171870,
      "text": "朱光亚站在那里紧紧盯着倒计时三二一起报戈壁滩上空，",
      "token_start": 605,
      "token_end_exclusive": 629
    },
    {
      "start_ms": 172170,
      "end_ms": 174670,
      "text": "一道比太阳还亮的闪光炸开。",
      "token_start": 629,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 174770,
      "end_ms": 175450,
      "text": "紧接着，",
      "token_start": 641,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 175750,
      "end_ms": 179495,
      "text": "一朵巨大的蘑菇云腾空而起。",
      "token_start": 644,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 180100,
      "end_ms": 181075,
      "text": "为了这一刻，",
      "token_start": 656,
      "token_end_exclusive": 661
    },
    {
      "start_ms": 181830,
      "end_ms": 184885,
      "text": "从他二十一岁远赴美国算起，",
      "token_start": 661,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 185340,
      "end_ms": 187105,
      "text": "整整过了十八年，",
      "token_start": 673,
      "token_end_exclusive": 680
    },
    {
      "start_ms": 188310,
      "end_ms": 190515,
      "text": "平日里那个克制沉稳，",
      "token_start": 680,
      "token_end_exclusive": 689
    },
    {
      "start_ms": 191030,
      "end_ms": 194845,
      "text": "不苟言笑的朱光亚当场洒下了热泪。",
      "token_start": 689,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 195930,
      "end_ms": 196745,
      "text": "那天晚上，",
      "token_start": 704,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 197670,
      "end_ms": 198895,
      "text": "朱光亚喝醉了，",
      "token_start": 708,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 199780,
      "end_ms": 204985,
      "text": "这是他这辈子唯一一次喝醉所有的压力，",
      "token_start": 714,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 206080,
      "end_ms": 207305,
      "text": "所有的委屈，",
      "token_start": 731,
      "token_end_exclusive": 736
    },
    {
      "start_ms": 207770,
      "end_ms": 212145,
      "text": "所有的银人在那一刻像核弹一样释放了出来。",
      "token_start": 736,
      "token_end_exclusive": 755
    },
    {
      "start_ms": 212940,
      "end_ms": 214075,
      "text": "原子弹炸响了，",
      "token_start": 755,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 214710,
      "end_ms": 215945,
      "text": "但朱光雅没停。",
      "token_start": 761,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 216460,
      "end_ms": 217240,
      "text": "不到三年，",
      "token_start": 767,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 217380,
      "end_ms": 218500,
      "text": "一九六七年月，",
      "token_start": 771,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 218500,
      "end_ms": 219235,
      "text": "一七号，",
      "token_start": 777,
      "token_end_exclusive": 780
    },
    {
      "start_ms": 219710,
      "end_ms": 222285,
      "text": "中国第一颗氢弹爆炸成功。",
      "token_start": 780,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 223160,
      "end_ms": 224635,
      "text": "从原子弹到氢弹，",
      "token_start": 791,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 225130,
      "end_ms": 227245,
      "text": "美国用了七年三个月，",
      "token_start": 798,
      "token_end_exclusive": 807
    },
    {
      "start_ms": 227700,
      "end_ms": 230085,
      "text": "苏联用了六年三个月，",
      "token_start": 807,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 230910,
      "end_ms": 232600,
      "text": "中国用了多久不嗯，",
      "token_start": 816,
      "token_end_exclusive": 824
    },
    {
      "start_ms": 232750,
      "end_ms": 234295,
      "text": "两年零八个月，",
      "token_start": 824,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 234760,
      "end_ms": 237265,
      "text": "这个速度震惊了整个世界。",
      "token_start": 830,
      "token_end_exclusive": 841
    },
    {
      "start_ms": 237990,
      "end_ms": 243325,
      "text": "朱光亚这一生参与领导了中国全部四十五次核试验。",
      "token_start": 841,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 243820,
      "end_ms": 244905,
      "text": "他说过一句话，",
      "token_start": 863,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 245310,
      "end_ms": 247875,
      "text": "我这一辈子主要做的就这一件事，",
      "token_start": 869,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 248370,
      "end_ms": 249525,
      "text": "搞中国的核武器。",
      "token_start": 883,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 250700,
      "end_ms": 251715,
      "text": "就这一件事儿，",
      "token_start": 890,
      "token_end_exclusive": 896
    },
    {
      "start_ms": 252490,
      "end_ms": 253435,
      "text": "他干了一辈子，",
      "token_start": 896,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 255180,
      "end_ms": 256600,
      "text": "有人要给他写传记，",
      "token_start": 902,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 256700,
      "end_ms": 258145,
      "text": "他把稿件退了回去。",
      "token_start": 910,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 258850,
      "end_ms": 262685,
      "text": "有人在两弹一星元勋的名单里写上他的名字，",
      "token_start": 918,
      "token_end_exclusive": 937
    },
    {
      "start_ms": 263120,
      "end_ms": 264380,
      "text": "他拿笔划掉了，",
      "token_start": 937,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 264380,
      "end_ms": 272355,
      "text": "自己对他来说东西留下就好名字吗？",
      "token_start": 943,
      "token_end_exclusive": 958
    },
    {
      "start_ms": 272790,
      "end_ms": 273565,
      "text": "随他去吧。",
      "token_start": 958,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 274020,
      "end_ms": 275000,
      "text": "一九九四年，",
      "token_start": 962,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 275220,
      "end_ms": 279525,
      "text": "朱光亚全票当选中国工程院首任院长。",
      "token_start": 967,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 280400,
      "end_ms": 282605,
      "text": "一九九九年九月十八号，",
      "token_start": 983,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 283090,
      "end_ms": 287430,
      "text": "七十五岁的朱光亚终于从幕后走到了台前。",
      "token_start": 993,
      "token_end_exclusive": 1011
    },
    {
      "start_ms": 287990,
      "end_ms": 292900,
      "text": "他是二十三位两弹一星功勋奖章获得者中，",
      "token_start": 1011,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 293320,
      "end_ms": 298490,
      "text": "最后一个被解密的当卸下身上所有的重担。",
      "token_start": 1029,
      "token_end_exclusive": 1047
    },
    {
      "start_ms": 298550,
      "end_ms": 300485,
      "text": "那张延素了几十年的脸，",
      "token_start": 1047,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 301260,
      "end_ms": 303485,
      "text": "终于又一次笑了起来，",
      "token_start": 1057,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 304140,
      "end_ms": 305775,
      "text": "这发自内心的一笑，",
      "token_start": 1066,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 306420,
      "end_ms": 307335,
      "text": "一不小心。",
      "token_start": 1074,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 308150,
      "end_ms": 310210,
      "text": "就相隔了几十个年头，",
      "token_start": 1078,
      "token_end_exclusive": 1087
    },
    {
      "start_ms": 311290,
      "end_ms": 320810,
      "text": "二零零四年国际编号幺零三八八号的小行星被正式命名为朱光亚星。",
      "token_start": 1087,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 321590,
      "end_ms": 324290,
      "text": "他的名字永远挂在了天上。",
      "token_start": 1116,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 325250,
      "end_ms": 328890,
      "text": "二零一一年二月二十六号朱光亚走了，",
      "token_start": 1127,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 329190,
      "end_ms": 330690,
      "text": "享年八十七岁。",
      "token_start": 1143,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 331670,
      "end_ms": 332950,
      "text": "那天下着大雪，",
      "token_start": 1149,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 333490,
      "end_ms": 335410,
      "text": "好多人望着天上的雪说，",
      "token_start": 1155,
      "token_end_exclusive": 1165
    },
    {
      "start_ms": 335850,
      "end_ms": 337805,
      "text": "钱学森走的那天也下雪。",
      "token_start": 1165,
      "token_end_exclusive": 1175
    },
    {
      "start_ms": 338440,
      "end_ms": 338980,
      "text": "真巧，",
      "token_start": 1175,
      "token_end_exclusive": 1177
    },
    {
      "start_ms": 339260,
      "end_ms": 340160,
      "text": "其实不是巧，",
      "token_start": 1177,
      "token_end_exclusive": 1182
    },
    {
      "start_ms": 340240,
      "end_ms": 341180,
      "text": "是天在哭。",
      "token_start": 1182,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 342140,
      "end_ms": 347580,
      "text": "最后我想说被埋进黑暗里的不止朱光雅一个人。",
      "token_start": 1186,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 347880,
      "end_ms": 350640,
      "text": "二十三位两弹一星元勋，",
      "token_start": 1206,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 351040,
      "end_ms": 352740,
      "text": "郭永怀飞机失事，",
      "token_start": 1216,
      "token_end_exclusive": 1223
    },
    {
      "start_ms": 353260,
      "end_ms": 355420,
      "text": "用身体护住绝密文件，",
      "token_start": 1223,
      "token_end_exclusive": 1232
    },
    {
      "start_ms": 355960,
      "end_ms": 356920,
      "text": "烧成焦炭，",
      "token_start": 1232,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 357080,
      "end_ms": 357880,
      "text": "也没松手。",
      "token_start": 1236,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 358780,
      "end_ms": 361880,
      "text": "邓稼先因核辐射身患重症，",
      "token_start": 1240,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 362260,
      "end_ms": 367815,
      "text": "临死前说的最后一句话是不要让人家把我们落的太远。",
      "token_start": 1251,
      "token_end_exclusive": 1274
    },
    {
      "start_ms": 369000,
      "end_ms": 372955,
      "text": "这些人干的是惊天动地的事，",
      "token_start": 1274,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 373500,
      "end_ms": 375925,
      "text": "做的是隐姓埋名的人，",
      "token_start": 1286,
      "token_end_exclusive": 1295
    },
    {
      "start_ms": 376780,
      "end_ms": 379280,
      "text": "他们才是这个国家最硬的脊梁，",
      "token_start": 1295,
      "token_end_exclusive": 1308
    },
    {
      "start_ms": 379460,
      "end_ms": 381595,
      "text": "才是我们最该追的星。",
      "token_start": 1308,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 382300,
      "end_ms": 382920,
      "text": "说实话，",
      "token_start": 1317,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 383260,
      "end_ms": 384620,
      "text": "写朱光亚的时候，",
      "token_start": 1320,
      "token_end_exclusive": 1327
    },
    {
      "start_ms": 384840,
      "end_ms": 386485,
      "text": "我翻了大量的资料，",
      "token_start": 1327,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 386830,
      "end_ms": 387810,
      "text": "越翻越难受。",
      "token_start": 1335,
      "token_end_exclusive": 1340
    },
    {
      "start_ms": 388190,
      "end_ms": 390345,
      "text": "二十三位两弹一星元勋，",
      "token_start": 1340,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 390840,
      "end_ms": 394865,
      "text": "每一个人的故事单独拿出来都能让你掉眼泪。",
      "token_start": 1350,
      "token_end_exclusive": 1369
    },
    {
      "start_ms": 395940,
      "end_ms": 396825,
      "text": "但说实话，",
      "token_start": 1369,
      "token_end_exclusive": 1373
    },
    {
      "start_ms": 397610,
      "end_ms": 400845,
      "text": "大多数人的名字我们根本叫不上来，",
      "token_start": 1373,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 401230,
      "end_ms": 403465,
      "text": "他们把一生都给了国家，",
      "token_start": 1388,
      "token_end_exclusive": 1398
    },
    {
      "start_ms": 403920,
      "end_ms": 404580,
      "text": "走的时候，",
      "token_start": 1398,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 404580,
      "end_ms": 408115,
      "text": "安安静静连张照片都没留下几张。",
      "token_start": 1402,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 408580,
      "end_ms": 411315,
      "text": "后来我找到了这套国之脊梁，",
      "token_start": 1416,
      "token_end_exclusive": 1428
    },
    {
      "start_ms": 411860,
      "end_ms": 416120,
      "text": "里面写了四十多位中国科学家的真实人生，",
      "token_start": 1428,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 416340,
      "end_ms": 420235,
      "text": "钱学森、邓稼先、郭永怀、袁隆平。",
      "token_start": 1446,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 420630,
      "end_ms": 424395,
      "text": "一个一个全是我们这个民族的顶梁柱。",
      "token_start": 1458,
      "token_end_exclusive": 1474
    },
    {
      "start_ms": 424940,
      "end_ms": 427355,
      "text": "他不是那种干巴巴的人物简介，",
      "token_start": 1474,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 427700,
      "end_ms": 429675,
      "text": "是真写他们怎么吃苦，",
      "token_start": 1487,
      "token_end_exclusive": 1496
    },
    {
      "start_ms": 430170,
      "end_ms": 430955,
      "text": "怎么咬牙，",
      "token_start": 1496,
      "token_end_exclusive": 1500
    },
    {
      "start_ms": 431340,
      "end_ms": 432965,
      "text": "怎么把命豁出去的。",
      "token_start": 1500,
      "token_end_exclusive": 1508
    },
    {
      "start_ms": 433850,
      "end_ms": 434390,
      "text": "读的时候，",
      "token_start": 1508,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 434390,
      "end_ms": 437505,
      "text": "你会发现这些人不是天生的英雄，",
      "token_start": 1512,
      "token_end_exclusive": 1526
    },
    {
      "start_ms": 438360,
      "end_ms": 439545,
      "text": "他们也是丈夫，",
      "token_start": 1526,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 440000,
      "end_ms": 440725,
      "text": "是父亲，",
      "token_start": 1532,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 441170,
      "end_ms": 441925,
      "text": "是儿子。",
      "token_start": 1535,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 442710,
      "end_ms": 444805,
      "text": "只是在国家需要的时候，",
      "token_start": 1538,
      "token_end_exclusive": 1548
    },
    {
      "start_ms": 445320,
      "end_ms": 447185,
      "text": "选择了把自己藏起来。",
      "token_start": 1548,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 447990,
      "end_ms": 453200,
      "text": "我建议你买一套自己看也留给孩子看。",
      "token_start": 1557,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 453360,
      "end_ms": 455840,
      "text": "现在的孩子追着明星唱首歌，",
      "token_start": 1573,
      "token_end_exclusive": 1585
    },
    {
      "start_ms": 456040,
      "end_ms": 458005,
      "text": "拍个戏就被捧上天。",
      "token_start": 1585,
      "token_end_exclusive": 1593
    },
    {
      "start_ms": 458440,
      "end_ms": 461140,
      "text": "但真正该让孩子记住的是，",
      "token_start": 1593,
      "token_end_exclusive": 1604
    },
    {
      "start_ms": 461140,
      "end_ms": 463740,
      "text": "这些在戈壁滩上用算盘算。",
      "token_start": 1604,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 463780,
      "end_ms": 468725,
      "text": "原子弹的人是这些用身体互助绝密文件的人，",
      "token_start": 1615,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 469380,
      "end_ms": 474825,
      "text": "让孩子知道这个国家能有今天不是靠运气，",
      "token_start": 1634,
      "token_end_exclusive": 1652
    },
    {
      "start_ms": 475520,
      "end_ms": 478165,
      "text": "是靠一群人拿命换的，",
      "token_start": 1652,
      "token_end_exclusive": 1661
    },
    {
      "start_ms": 479070,
      "end_ms": 481025,
      "text": "这些人不该被遗忘，",
      "token_start": 1661,
      "token_end_exclusive": 1669
    },
    {
      "start_ms": 481880,
      "end_ms": 485415,
      "text": "这套书就是给他们立的一块碑。",
      "token_start": 1669,
      "token_end_exclusive": 1682
    }
  ],
