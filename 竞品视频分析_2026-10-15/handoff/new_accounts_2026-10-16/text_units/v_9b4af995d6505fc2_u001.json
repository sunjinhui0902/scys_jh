{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_9b4af995d6505fc2_u001",
  "video_id": "v_9b4af995d6505fc2",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 611.823787,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 3570,
      "text": "你知道中国流失到海外最珍贵的文物是哪一件吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4670,
      "end_ms": 9070,
      "text": "有人说是圆明园十二兽首十二个铜脑袋，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 10070,
      "end_ms": 11830,
      "text": "拍卖行叫价上亿。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 12950,
      "end_ms": 14750,
      "text": "有人说是敦煌壁画，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 15230,
      "end_ms": 17090,
      "text": "几千平方米的国宝，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 17290,
      "end_ms": 19490,
      "text": "被外国人一块一块切下来，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 19490,
      "end_ms": 21330,
      "text": "运走错了，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 22150,
      "end_ms": 23490,
      "text": "兽首排不上。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 23510,
      "end_ms": 23910,
      "text": "第一，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 24270,
      "end_ms": 26310,
      "text": "壁画连前五都进不了，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 27130,
      "end_ms": 29150,
      "text": "真正排在榜首的那件。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 29150,
      "end_ms": 36220,
      "text": "他不本来有二万二千九百三十七卷是明朝编的中国百科全书，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 36520,
      "end_ms": 38740,
      "text": "一千八百六十年被抢走，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 38740,
      "end_ms": 40060,
      "text": "烧毁大半儿，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 40120,
      "end_ms": 40740,
      "text": "到今天，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 40740,
      "end_ms": 43420,
      "text": "全世界只找回了八百多卷，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 43500,
      "end_ms": 46260,
      "text": "剩下的二万二卷，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 47340,
      "end_ms": 49200,
      "text": "不知道在谁家地下室里落灰。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 50360,
      "end_ms": 51720,
      "text": "可让人欣慰的是，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 52920,
      "end_ms": 58060,
      "text": "这些年咱们中国人一件一件往回买一件一件往回追，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 58600,
      "end_ms": 61785,
      "text": "已经追回了十五万件流失文物。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 62240,
      "end_ms": 62680,
      "text": "今天，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 62700,
      "end_ms": 67055,
      "text": "咱们就来盘点中国流失海外最珍贵的十大文物。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 67500,
      "end_ms": 69560,
      "text": "老规矩开讲之前，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 69780,
      "end_ms": 71775,
      "text": "劳烦您扣个一点个红心，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 72250,
      "end_ms": 73930,
      "text": "让我看看都是谁在听。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 73990,
      "end_ms": 74685,
      "text": "第十名，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 74970,
      "end_ms": 75210,
      "text": "唐，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 75230,
      "end_ms": 75790,
      "text": "三采，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 75810,
      "end_ms": 76845,
      "text": "骆驼宰乐俑，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 77830,
      "end_ms": 81365,
      "text": "唐朝现在在美国纽约大都会博物馆。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 82260,
      "end_ms": 82995,
      "text": "您想想，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 83580,
      "end_ms": 86860,
      "text": "一头骆驼背上驮着七个月，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 86860,
      "end_ms": 89565,
      "text": "手有吹笛子的，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 90030,
      "end_ms": 91025,
      "text": "有弹琵琶的，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 91530,
      "end_ms": 92590,
      "text": "还有个胡人。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 92590,
      "end_ms": 95675,
      "text": "在指挥一千三百多年前，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 96010,
      "end_ms": 101095,
      "text": "工匠把丝绸之路上的盛世繁华捏成了一尊陶俑。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 102150,
      "end_ms": 103975,
      "text": "这件东西是怎么出去？"
    },
    {
      "segment_id": "s000040",
      "start_ms": 104480,
      "end_ms": 105545,
      "text": "二十世纪初，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 106070,
      "end_ms": 109545,
      "text": "盗墓贼从洛阳的堂墓里挖出来，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 110360,
      "end_ms": 111505,
      "text": "几经转手。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 112170,
      "end_ms": 115910,
      "text": "一九二六年让一个美国收藏家买走了，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 115910,
      "end_ms": 117530,
      "text": "当时只花了几千美元，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 117590,
      "end_ms": 118425,
      "text": "您知道吗？"
    },
    {
      "segment_id": "s000046",
      "start_ms": 119330,
      "end_ms": 120365,
      "text": "二零一九年，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 121160,
      "end_ms": 126955,
      "text": "一尊类似的唐三彩骆驼俑在伦敦拍出了三百多万英镑，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 128060,
      "end_ms": 133535,
      "text": "当年几千美元买走的现在值三千多万人民币。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 134130,
      "end_ms": 137615,
      "text": "一尊陶俑驮着大唐的气派，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 137960,
      "end_ms": 139595,
      "text": "流落在万里之外，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 140370,
      "end_ms": 144355,
      "text": "让全世界看见了一千三百年前中国的盛世。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 145430,
      "end_ms": 147545,
      "text": "这够珍贵第九名，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 148570,
      "end_ms": 150835,
      "text": "昭陵六郡浮雕，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 151640,
      "end_ms": 159590,
      "text": "唐朝两郡现在在美国费城、宾夕法尼亚大学博物馆四郡在西安碑林博物馆，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 159730,
      "end_ms": 161195,
      "text": "您知道昭陵六郡吗？"
    },
    {
      "segment_id": "s000056",
      "start_ms": 162090,
      "end_ms": 166665,
      "text": "唐太宗李世民生前骑过的六匹战马打天下立的功，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 167120,
      "end_ms": 174865,
      "text": "死后让大书法家、欧阳询写字、大雕刻家阎立德刻成石雕守在陵墓前，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 175300,
      "end_ms": 177165,
      "text": "每一匹马身上都有箭伤，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 177670,
      "end_ms": 179475,
      "text": "每一道伤都是一场胜仗。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 180280,
      "end_ms": 181320,
      "text": "一九一四年，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 182080,
      "end_ms": 185400,
      "text": "古董商卢秦斋买通了陵墓守威，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 185820,
      "end_ms": 190560,
      "text": "连夜把六郡中的撒禄子和全卯嘎切割下来，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 191460,
      "end_ms": 193420,
      "text": "每块石头重一吨，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 193420,
      "end_ms": 195340,
      "text": "多用锯子锯成几块，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 196080,
      "end_ms": 197920,
      "text": "装箱偷运到美国。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 198680,
      "end_ms": 201400,
      "text": "您想想石雕被锯开，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 202020,
      "end_ms": 202780,
      "text": "那得多疼。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 203780,
      "end_ms": 208240,
      "text": "好在另外四郡当地人拼死保住了。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 209320,
      "end_ms": 211490,
      "text": "今天您去西安碑林博物馆，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 211850,
      "end_ms": 217590,
      "text": "还能看见唐太宗的四匹战马六匹战马四匹在故乡，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 217770,
      "end_ms": 218910,
      "text": "两匹在异国，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 219410,
      "end_ms": 222270,
      "text": "唐太宗的功勋被分成了两半，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 223190,
      "end_ms": 224590,
      "text": "这够让人叹息。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 225970,
      "end_ms": 228250,
      "text": "第八名女使贞图，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 228730,
      "end_ms": 232270,
      "text": "东晋顾恺之画的一千六百多年，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 232690,
      "end_ms": 236870,
      "text": "现在在英国大英博物馆顾恺之是谁？"
    },
    {
      "segment_id": "s000077",
      "start_ms": 237050,
      "end_ms": 243675,
      "text": "中国绘画史的祖师爷画胜他的真迹传世的只有这一卷，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 244520,
      "end_ms": 249080,
      "text": "画的是古代女子的德行规范人物译文，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 249100,
      "end_ms": 252735,
      "text": "细腻到每一根线条都流畅飘逸。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 253270,
      "end_ms": 255165,
      "text": "这幅画是怎么到英国的？"
    },
    {
      "segment_id": "s000081",
      "start_ms": 255360,
      "end_ms": 256755,
      "text": "一千八百六十年，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 257600,
      "end_ms": 260255,
      "text": "英法联军火烧圆明园，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 260870,
      "end_ms": 263615,
      "text": "一个英国军官顺手抢走的，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 264130,
      "end_ms": 265070,
      "text": "后来他缺钱，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 265070,
      "end_ms": 268570,
      "text": "花二十五英镑卖给了大英博物馆。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 268930,
      "end_ms": 271315,
      "text": "您知道二十五英镑什么概念吗？"
    },
    {
      "segment_id": "s000087",
      "start_ms": 272020,
      "end_ms": 273985,
      "text": "当时在伦敦购买一匹马，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 274580,
      "end_ms": 277100,
      "text": "一幅一千六百年的国宝真迹，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 277220,
      "end_ms": 278695,
      "text": "换了一匹马的价格。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 279640,
      "end_ms": 281305,
      "text": "更让人心疼的是，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 281970,
      "end_ms": 287245,
      "text": "大英博物馆的专家不懂中国画把它裱在硬纸板上，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 287940,
      "end_ms": 288805,
      "text": "差点毁掉。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 289800,
      "end_ms": 290420,
      "text": "后来，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 290620,
      "end_ms": 293365,
      "text": "中国专家去修复才保住。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 295620,
      "end_ms": 296625,
      "text": "二零一七年，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 296890,
      "end_ms": 298705,
      "text": "大英博物馆办了一场展览，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 299010,
      "end_ms": 301610,
      "text": "专门展出这幅画展，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 301670,
      "end_ms": 303135,
      "text": "厅里挤满了中国人。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 304020,
      "end_ms": 306940,
      "text": "隔着玻璃看自己的国宝一幅画，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 307600,
      "end_ms": 310640,
      "text": "见证了一千六百年的中国绘画记忆。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 310940,
      "end_ms": 312920,
      "text": "今天只能隔着玻璃，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 313220,
      "end_ms": 314000,
      "text": "隔着国界，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 314000,
      "end_ms": 316280,
      "text": "看这够遗憾。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 316340,
      "end_ms": 316980,
      "text": "第七名，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 317360,
      "end_ms": 320460,
      "text": "圆明园十二生肖兽首铜像，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 321080,
      "end_ms": 322380,
      "text": "清朝乾隆年间，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 322640,
      "end_ms": 325420,
      "text": "现在七个已回国五个下落不明。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 326160,
      "end_ms": 328200,
      "text": "圆明园海宴堂前的喷泉，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 328200,
      "end_ms": 329800,
      "text": "十二生肖兽首，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 329800,
      "end_ms": 332740,
      "text": "每个时辰喷一个正午，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 332740,
      "end_ms": 334270,
      "text": "十二个一千喷水，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 334870,
      "end_ms": 339430,
      "text": "是意大利传教士郎世宁设计的中国工匠，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 339790,
      "end_ms": 341170,
      "text": "用红铜铸造，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 341690,
      "end_ms": 343150,
      "text": "每一个都是艺术品。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 344290,
      "end_ms": 346090,
      "text": "一千八百六十年十月，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 346550,
      "end_ms": 348550,
      "text": "英法联军火烧圆明园，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 349030,
      "end_ms": 351130,
      "text": "这十二个铜脑袋被撬下来，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 351850,
      "end_ms": 353090,
      "text": "当战利品分了。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 353750,
      "end_ms": 356570,
      "text": "您知道这些年中国花了多少钱买回来吗？"
    },
    {
      "segment_id": "s000120",
      "start_ms": 356630,
      "end_ms": 357890,
      "text": "二零零零年，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 358130,
      "end_ms": 361310,
      "text": "牛首猴首虎首在香港拍卖，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 362010,
      "end_ms": 366485,
      "text": "企业家用三千多万港币买回来捐给国家。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 367460,
      "end_ms": 368635,
      "text": "二零零七年，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 369370,
      "end_ms": 373635,
      "text": "何鸿燊花了六千九百一十万港币，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 374140,
      "end_ms": 381655,
      "text": "拍回马首也捐了二零一九年法国一个收藏家去世。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 382550,
      "end_ms": 387915,
      "text": "他家人主动把熟首兔手归还中国，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 389490,
      "end_ms": 390135,
      "text": "没要钱，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 391640,
      "end_ms": 393020,
      "text": "自己的东西被抢走，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 393440,
      "end_ms": 394420,
      "text": "还要花天价，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 394460,
      "end_ms": 395075,
      "text": "买回来，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 396060,
      "end_ms": 396945,
      "text": "这是什么滋味？"
    },
    {
      "segment_id": "s000132",
      "start_ms": 397830,
      "end_ms": 398170,
      "text": "可好？"
    },
    {
      "segment_id": "s000133",
      "start_ms": 398170,
      "end_ms": 399560,
      "text": "在这些年，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 399680,
      "end_ms": 401860,
      "text": "越来越多人在帮中国追文物，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 401940,
      "end_ms": 403305,
      "text": "骑个兽首回家了，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 403650,
      "end_ms": 404470,
      "text": "剩下五个，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 404690,
      "end_ms": 407505,
      "text": "咱们还在找十二生肖七个回了家，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 407790,
      "end_ms": 408770,
      "text": "五个还在流浪，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 408850,
      "end_ms": 410470,
      "text": "但咱们一个都不会放弃，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 410690,
      "end_ms": 412065,
      "text": "这是中国人的决心。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 412580,
      "end_ms": 413155,
      "text": "第六名，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 415440,
      "end_ms": 419315,
      "text": "龙门石窟、佛像、头部、北魏到唐代，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 420120,
      "end_ms": 425625,
      "text": "现在分散在美国、日本、欧洲等地的博物馆和私人手里。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 428210,
      "end_ms": 429855,
      "text": "您去过龙门石窟吗？"
    },
    {
      "segment_id": "s000145",
      "start_ms": 430060,
      "end_ms": 434005,
      "text": "河南洛阳沂河两岸十万尊佛像，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 434910,
      "end_ms": 438895,
      "text": "从北魏到唐朝开凿了四百多年。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 440240,
      "end_ms": 441080,
      "text": "可您仔细看，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 441160,
      "end_ms": 442565,
      "text": "很多佛像没有透，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 443160,
      "end_ms": 443735,
      "text": "为什么？"
    },
    {
      "segment_id": "s000150",
      "start_ms": 444220,
      "end_ms": 446225,
      "text": "二十世纪初到三十年代，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 446500,
      "end_ms": 447795,
      "text": "倒卖文物成风，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 448250,
      "end_ms": 450865,
      "text": "龙门石窟的佛头成了抢手货。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 451390,
      "end_ms": 455195,
      "text": "盗贼用锯子爬上几十米高的悬崖，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 455730,
      "end_ms": 459195,
      "text": "把佛头一个一个聚下来，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 459750,
      "end_ms": 461545,
      "text": "卖给外国收藏家。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 462360,
      "end_ms": 468714,
      "text": "美国纽约大都会博物馆藏着一尊龙门观音菩萨头像，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 469480,
      "end_ms": 474445,
      "text": "是北魏的面容慈悲，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 474960,
      "end_ms": 479315,
      "text": "可他的身体还在龙门悬崖上一千五百年了，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 480340,
      "end_ms": 481285,
      "text": "身手分离。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 482160,
      "end_ms": 488455,
      "text": "日本东京国立博物馆藏着十几尊龙门佛头更让人无奈的是，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 488930,
      "end_ms": 491825,
      "text": "很多佛头在私人藏家手里，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 492400,
      "end_ms": 494000,
      "text": "根本不对外展示，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 494320,
      "end_ms": 495575,
      "text": "也不知道在哪。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 497060,
      "end_ms": 497705,
      "text": "这些年，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 499520,
      "end_ms": 505845,
      "text": "中国一直在追二零二零年一尊天龙山石窟佛手从日本回归。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 506420,
      "end_ms": 515665,
      "text": "二零二一年一尊龙门石窟佛手从美国回归十万尊佛像被盗的头，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 516080,
      "end_ms": 516535,
      "text": "嗯，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 517550,
      "end_ms": 519015,
      "text": "正在一个一个回家，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 519510,
      "end_ms": 521030,
      "text": "这是漫长的守候，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 521230,
      "end_ms": 522450,
      "text": "也是咱们的坚持。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 522910,
      "end_ms": 524410,
      "text": "从第十到第六名，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 524430,
      "end_ms": 527115,
      "text": "这五件文物都够让人心疼的。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 527790,
      "end_ms": 529430,
      "text": "唐三才驮着盛世，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 529430,
      "end_ms": 530355,
      "text": "流落纽约，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 531260,
      "end_ms": 534855,
      "text": "昭陵六郡被锯成几块运到美国。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 535570,
      "end_ms": 537335,
      "text": "女使贞图换了一匹马，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 538320,
      "end_ms": 542360,
      "text": "十二兽首买回了七个龙门石窟的佛头，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 542400,
      "end_ms": 544135,
      "text": "在一个一个回家，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 544750,
      "end_ms": 546390,
      "text": "可他们还不是最珍贵。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 547790,
      "end_ms": 550215,
      "text": "接下来第五道第一名更揪心。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 551060,
      "end_ms": 556815,
      "text": "有一批国宝敦煌藏经洞五万多卷经书，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 557360,
      "end_ms": 559535,
      "text": "让一个道士几块银元就卖了。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 560080,
      "end_ms": 562875,
      "text": "有一幅画被火烧成两截。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 563370,
      "end_ms": 565030,
      "text": "一节在杭州一节，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 565030,
      "end_ms": 567765,
      "text": "在台北隔着海峡望了七十年。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 568750,
      "end_ms": 570190,
      "text": "有一部百科全书，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 570510,
      "end_ms": 573605,
      "text": "清朝编的被撕成了散叶，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 574280,
      "end_ms": 575785,
      "text": "散落在世界各地，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 576670,
      "end_ms": 581990,
      "text": "可排在榜首的那件二万二千九百三。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 582010,
      "end_ms": 589510,
      "text": "十七卷是明朝人用六年时间编出来的中国文化总集被抢走烧毁，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 589870,
      "end_ms": 591535,
      "text": "只剩下八百卷，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 592050,
      "end_ms": 593770,
      "text": "剩下二万二千卷，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 593850,
      "end_ms": 594735,
      "text": "不知所踪。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 595390,
      "end_ms": 596165,
      "text": "他是哪谏？"
    },
    {
      "segment_id": "s000195",
      "start_ms": 596550,
      "end_ms": 597775,
      "text": "他到底有多珍贵？"
    },
    {
      "segment_id": "s000196",
      "start_ms": 598310,
      "end_ms": 600795,
      "text": "下一集已经同步更新，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 601620,
      "end_ms": 603685,
      "text": "现在直接点开我的头像，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 605100,
      "end_ms": 605900,
      "text": "进入主页，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 605980,
      "end_ms": 608505,
      "text": "第一条视频就是下一集点个关注，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 608770,
      "end_ms": 611715,
      "text": "看看谁才是中国流失海外最珍贵的文物。"
    }
  ],
  "source_transcript_sha256": "08425b99739137e27ae9396e81f99ca8af361da9b668dc62d32dfb2570383689"
}