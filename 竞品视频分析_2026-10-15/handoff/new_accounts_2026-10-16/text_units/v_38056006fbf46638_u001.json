{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_38056006fbf46638_u001",
  "video_id": "v_38056006fbf46638",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 344.236009,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 590,
      "end_ms": 1490,
      "text": "你敢相信吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1830,
      "end_ms": 5430,
      "text": "全世界最会赚钱的这群人居然来自同一个地方。"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5610,
      "end_ms": 6150,
      "text": "潮汕，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6530,
      "end_ms": 8370,
      "text": "他们被称作东方犹太人。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8570,
      "end_ms": 10750,
      "text": "全球五千万海外华人华侨中，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 10890,
      "end_ms": 12550,
      "text": "潮汕人占了约一千万。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 12710,
      "end_ms": 13450,
      "text": "泰国首富，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 13550,
      "end_ms": 14410,
      "text": "新加坡首富，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 14450,
      "end_ms": 19010,
      "text": "加拿大华人首富、欧洲华人首富、澳洲华人首富全是潮汕人。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 19690,
      "end_ms": 22310,
      "text": "他们从一个人多地少的穷地方走出来，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 22530,
      "end_ms": 25110,
      "text": "却把生意做到了全世界的每一个角落。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 25390,
      "end_ms": 26490,
      "text": "有潮水的地方，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 26490,
      "end_ms": 28710,
      "text": "就有潮汕人有钱赚的地方，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 28730,
      "end_ms": 29330,
      "text": "就有潮商。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 29330,
      "end_ms": 31540,
      "text": "经过五百多年的商业洗礼，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 31800,
      "end_ms": 35260,
      "text": "潮商已经成为中国势力最大、影响最深远。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 35520,
      "end_ms": 37240,
      "text": "唯一没有断代的大商帮。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 37280,
      "end_ms": 38780,
      "text": "从李嘉诚到零百兴，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 39140,
      "end_ms": 46560,
      "text": "从传统的米业纸业到今天的AI大模型激光雷达潮汕人始终站在商业浪潮的最前沿。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 46640,
      "end_ms": 47280,
      "text": "夸张点说，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 47580,
      "end_ms": 51820,
      "text": "目前国内站在新技术浪尖上的创始人一半都来自潮汕。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 52380,
      "end_ms": 53320,
      "text": "但问题来了，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 53800,
      "end_ms": 59280,
      "text": "他们凭什么有人说是地理环境逼出来的潮汕地区人多地少。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 59280,
      "end_ms": 60590,
      "text": "众必养不活，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 60590,
      "end_ms": 62535,
      "text": "一家人只能出海谋生。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 62960,
      "end_ms": 64020,
      "text": "有人说是运气好，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 64200,
      "end_ms": 65260,
      "text": "赶上了时代风口，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 65300,
      "end_ms": 66960,
      "text": "还有人说是抱团取暖，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 67180,
      "end_ms": 68275,
      "text": "老乡带老乡，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 68750,
      "end_ms": 69505,
      "text": "这些都对，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 69830,
      "end_ms": 70390,
      "text": "但都没收到。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 70390,
      "end_ms": 70995,
      "text": "根子上，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 71460,
      "end_ms": 74595,
      "text": "真正让潮汕人纵横商界五百年不败的秘密，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 74980,
      "end_ms": 77000,
      "text": "藏在一套独特的思维方式里。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 77120,
      "end_ms": 82060,
      "text": "这套思维方式让一个身上只有几十块钱的潮汕人敢直接去做老板，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 82140,
      "end_ms": 84760,
      "text": "让一个远渡重洋、语言不通的年轻人，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 84980,
      "end_ms": 87380,
      "text": "几年后就能在异国他乡站稳脚跟，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 87500,
      "end_ms": 91705,
      "text": "让一个看似不起眼的小生意一步步滚成跨国商业帝国。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 92410,
      "end_ms": 96475,
      "text": "这套思维过去只靠父传子师带徒口口相传，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 96850,
      "end_ms": 98350,
      "text": "外人根本摸不到门道。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 98430,
      "end_ms": 101425,
      "text": "但现在有人把他第一次完整的写了出来，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 101690,
      "end_ms": 103435,
      "text": "这本书叫潮汕思维。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 104060,
      "end_ms": 109435,
      "text": "他把潮汕人五百年积累的经商智慧、处事、哲学、人脉法则、财富认知，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 109840,
      "end_ms": 111860,
      "text": "第一次用普通人能读懂的语言，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 112100,
      "end_ms": 113605,
      "text": "系统化的讲清楚了。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 113950,
      "end_ms": 117245,
      "text": "你知道潮汕人为什么宁可睡地板也要当老板吗？"
    },
    {
      "segment_id": "s000047",
      "start_ms": 117810,
      "end_ms": 118965,
      "text": "因为在他们骨子里，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 119250,
      "end_ms": 120295,
      "text": "工字不出头，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 120680,
      "end_ms": 122125,
      "text": "打工永远只是手段，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 122470,
      "end_ms": 123735,
      "text": "创业才是归宿。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 123990,
      "end_ms": 125135,
      "text": "潮汕人不喜欢打工，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 125550,
      "end_ms": 126490,
      "text": "有了小小本钱，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 126610,
      "end_ms": 128065,
      "text": "就开始想自己做老板，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 128560,
      "end_ms": 129405,
      "text": "这不是冲动，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 129740,
      "end_ms": 131455,
      "text": "而是一种深入骨髓的认知，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 132270,
      "end_ms": 133650,
      "text": "只有自己掌控生意，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 133910,
      "end_ms": 135435,
      "text": "才能真正掌控命运。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 135970,
      "end_ms": 137230,
      "text": "你知道潮汕人谈生意，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 137230,
      "end_ms": 138765,
      "text": "为什么总是在喝茶吗？"
    },
    {
      "segment_id": "s000060",
      "start_ms": 139230,
      "end_ms": 142230,
      "text": "那杯功夫茶里藏着潮汕人最核心的人脉，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 142230,
      "end_ms": 144020,
      "text": "哲学算盘要打穿，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 144340,
      "end_ms": 145805,
      "text": "人情要留香。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 146310,
      "end_ms": 149385,
      "text": "潮汕人做生意从来不是冷冰冰的讨价还价，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 149750,
      "end_ms": 150930,
      "text": "而是先交朋友，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 150990,
      "end_ms": 151775,
      "text": "再谈买卖，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 152260,
      "end_ms": 152700,
      "text": "嘴甜，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 152700,
      "end_ms": 153415,
      "text": "三分利，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 153790,
      "end_ms": 155115,
      "text": "赚钱赚人气。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 155510,
      "end_ms": 157365,
      "text": "他们懂得赢得人心，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 157650,
      "end_ms": 159415,
      "text": "你赚到钱更值钱。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 160070,
      "end_ms": 162445,
      "text": "你知道潮汕人为什么能富过三代吗？"
    },
    {
      "segment_id": "s000072",
      "start_ms": 162760,
      "end_ms": 164640,
      "text": "因为他们信奉的不是一夜暴富，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 164940,
      "end_ms": 167380,
      "text": "而是铜钱出苦坑富贵。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 167380,
      "end_ms": 168040,
      "text": "在凶年，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 168100,
      "end_ms": 169395,
      "text": "从底层历练开始，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 169730,
      "end_ms": 170630,
      "text": "先做打工仔，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 170770,
      "end_ms": 171725,
      "text": "后当大老板，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 172150,
      "end_ms": 172710,
      "text": "靠打工，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 172810,
      "end_ms": 173745,
      "text": "积累创业资本。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 174040,
      "end_ms": 175225,
      "text": "他们不相信运气，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 175590,
      "end_ms": 177555,
      "text": "只相信爱拼才会赢。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 177900,
      "end_ms": 181055,
      "text": "这本书最厉害的地方在于它不是空洞的理论，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 181450,
      "end_ms": 184515,
      "text": "而是把潮汕人五百年来验证过的实战方法，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 184800,
      "end_ms": 186465,
      "text": "一条一条拆解给你看。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 186950,
      "end_ms": 188830,
      "text": "从选品定位到客源开拓，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 189110,
      "end_ms": 191125,
      "text": "从谈判成交到成本管控，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 191510,
      "end_ms": 193375,
      "text": "从引流获客到快速变现。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 193730,
      "end_ms": 195190,
      "text": "从同行竞争到风险，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 195190,
      "end_ms": 198520,
      "text": "规避潮汕人做生意遇到的每一个环节，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 198820,
      "end_ms": 201295,
      "text": "书里都有具体可操作的方法。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 201810,
      "end_ms": 202630,
      "text": "更难得的是，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 202790,
      "end_ms": 205185,
      "text": "他把潮汕人的软实力也讲透了，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 205500,
      "end_ms": 209255,
      "text": "比如潮汕、老辈人常说的样样能无样精，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 209760,
      "end_ms": 211975,
      "text": "那些看似门门懂、样样通的人，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 212230,
      "end_ms": 214825,
      "text": "往往因为浅尝辄止而难成大器。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 215220,
      "end_ms": 216360,
      "text": "真正的立身之本，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 216500,
      "end_ms": 218445,
      "text": "在于深挖一口井的深度。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 218940,
      "end_ms": 219505,
      "text": "再比如，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 219840,
      "end_ms": 220780,
      "text": "宁可跑断腿，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 220920,
      "end_ms": 222780,
      "text": "不把商机推潮汕人，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 222780,
      "end_ms": 225865,
      "text": "对商机的敏感和执着已经刻进了骨子里。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 226250,
      "end_ms": 228690,
      "text": "这本书的独特价值在于它的稀缺性。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 228850,
      "end_ms": 230705,
      "text": "市面上讲潮汕人的书不少，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 231230,
      "end_ms": 232550,
      "text": "但要么是学术研究，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 232690,
      "end_ms": 233725,
      "text": "离普通人太远，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 234130,
      "end_ms": 235470,
      "text": "要么是零散的故事集，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 235670,
      "end_ms": 236410,
      "text": "读完热闹，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 236430,
      "end_ms": 237405,
      "text": "但学不到东西。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 237730,
      "end_ms": 242305,
      "text": "而这本书第一次把潮汕思维从江湖经验拉进了系统认知，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 243010,
      "end_ms": 244245,
      "text": "有他学术深度的，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 244510,
      "end_ms": 245965,
      "text": "没有他实战接地气，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 246490,
      "end_ms": 247855,
      "text": "有他实战接地气的，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 248060,
      "end_ms": 249195,
      "text": "没有它系统完整。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 249420,
      "end_ms": 250060,
      "text": "他告诉你，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 250220,
      "end_ms": 252300,
      "text": "潮汕人的成功不是靠投机，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 252540,
      "end_ms": 253535,
      "text": "不是靠运气，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 253810,
      "end_ms": 257170,
      "text": "而是靠一套可以学习、可以复制的底层思维。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 257310,
      "end_ms": 258855,
      "text": "普通人为什么赚不到钱？"
    },
    {
      "segment_id": "s000119",
      "start_ms": 259280,
      "end_ms": 260225,
      "text": "不是不够努力，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 260530,
      "end_ms": 261885,
      "text": "而是思维没打开，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 262420,
      "end_ms": 263700,
      "text": "被打工思维困住，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 263860,
      "end_ms": 265065,
      "text": "被舒适区困住，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 265380,
      "end_ms": 266675,
      "text": "被怕失败困住。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 267130,
      "end_ms": 270135,
      "text": "而潮汕思维恰恰是打破这些枷锁的钥匙。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 270890,
      "end_ms": 272730,
      "text": "如果你厌倦了那些空洞的鸡汤，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 273050,
      "end_ms": 274895,
      "text": "不想再被伪成功学收割，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 275240,
      "end_ms": 278485,
      "text": "想踏踏实实学一套真正管用的赚钱思维，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 278930,
      "end_ms": 281425,
      "text": "这本书值得放在枕边反复读。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 281850,
      "end_ms": 284545,
      "text": "但如果你真的想彻底改变自己的商业认知，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 284950,
      "end_ms": 286710,
      "text": "光读一本潮汕思维还不够。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 287030,
      "end_ms": 290230,
      "text": "我强烈建议你把潮汕思维和时局控局破局，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 290250,
      "end_ms": 291170,
      "text": "搭配着一起读。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 291510,
      "end_ms": 297385,
      "text": "这套组合是目前市面上把认知升级和实战落地结合的最扎实的两本书。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 298070,
      "end_ms": 300865,
      "text": "潮汕思维解决的是想什么的问题，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 301220,
      "end_ms": 303595,
      "text": "帮你建立一套正确的商业底层认知，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 304010,
      "end_ms": 306375,
      "text": "让你看生意的眼光彻底不一样。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 307280,
      "end_ms": 310575,
      "text": "时局控局破局解决的是怎么做的问题，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 311120,
      "end_ms": 314985,
      "text": "教你在复杂的商业环境中识别局势、掌控节奏，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 315230,
      "end_ms": 316980,
      "text": "打破困局两本，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 316980,
      "end_ms": 317755,
      "text": "配合着读，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 318080,
      "end_ms": 319640,
      "text": "一套打通你的商业思维，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 319940,
      "end_ms": 320960,
      "text": "一套教你落地，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 320960,
      "end_ms": 322535,
      "text": "执行效果翻倍。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 323220,
      "end_ms": 324420,
      "text": "这两本书合在一起，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 324640,
      "end_ms": 326745,
      "text": "就是一套完整的赚钱方法论。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 327160,
      "end_ms": 328320,
      "text": "从思维到行动，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 328380,
      "end_ms": 329535,
      "text": "从认知到实战，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 329810,
      "end_ms": 331255,
      "text": "从想到到做到，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 331560,
      "end_ms": 336235,
      "text": "帮你真正把潮汕人五百年理解的商业智慧变成自己的东西。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 337090,
      "end_ms": 338315,
      "text": "链接就在下方，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 338720,
      "end_ms": 339565,
      "text": "翻开第一页，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 339800,
      "end_ms": 340785,
      "text": "你就能走上去。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 341230,
      "end_ms": 341990,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 342150,
      "end_ms": 343510,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 343510,
      "end_ms": 344145,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "764b60623b0306524dfe0d1f80b3f2c0818fca615c64179d3fd367ccc6f4ac2b"
}