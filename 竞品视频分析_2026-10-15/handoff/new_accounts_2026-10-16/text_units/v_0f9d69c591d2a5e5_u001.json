{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_0f9d69c591d2a5e5_u001",
  "video_id": "v_0f9d69c591d2a5e5",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 802.227007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 410,
      "end_ms": 3170,
      "text": "十一分钟讲解沈竹仍沈氏悬空学。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3550,
      "end_ms": 4670,
      "text": "今天我们来分享一本，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4670,
      "end_ms": 7190,
      "text": "你大概从没在书店畅销价上见过，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7330,
      "end_ms": 11030,
      "text": "但已经在学术界和文化研究领域被反复讨论了。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 11030,
      "end_ms": 13890,
      "text": "一百多年的书沈氏悬空学，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 14090,
      "end_ms": 16330,
      "text": "他被归在传统文化典籍的目录里，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16430,
      "end_ms": 19870,
      "text": "但说的全是关于时间空间变化与平衡。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 20150,
      "end_ms": 23450,
      "text": "这些人类思考的几千年也没完全想明白的事儿。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 23630,
      "end_ms": 24950,
      "text": "这本书的作者是沈竹，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 24950,
      "end_ms": 26510,
      "text": "仍原名沈少勋，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 26990,
      "end_ms": 28610,
      "text": "清末浙江钱塘人，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 28690,
      "end_ms": 29895,
      "text": "也就是今天的杭州。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 30220,
      "end_ms": 31680,
      "text": "他生于一八四九年，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 31900,
      "end_ms": 33240,
      "text": "卒于一九零六年，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 33700,
      "end_ms": 36600,
      "text": "出生于一个有着深厚家学传统的家族，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 36860,
      "end_ms": 38980,
      "text": "是北宋学者沈括的后裔。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 39480,
      "end_ms": 40900,
      "text": "他公诗文善说，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 40900,
      "end_ms": 44260,
      "text": "画一生中绝大部分精力都花在了一件事上，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 44680,
      "end_ms": 47240,
      "text": "研究时间和空间如何相互作用，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 47460,
      "end_ms": 50360,
      "text": "以及这种作用如何影响人所处的环境。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 50620,
      "end_ms": 51740,
      "text": "他写这本书的时候，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 51740,
      "end_ms": 53760,
      "text": "已经是清末国事衰微，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 54180,
      "end_ms": 56100,
      "text": "旧学与新学激烈碰撞。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 56240,
      "end_ms": 60430,
      "text": "他穷一生经历将历来秘而不宣的悬空学苦心研究究，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 60670,
      "end_ms": 62165,
      "text": "更不令传授予后人。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 62400,
      "end_ms": 64345,
      "text": "他生前并未完成全部书稿，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 64710,
      "end_ms": 65230,
      "text": "去世后，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 65230,
      "end_ms": 67210,
      "text": "由他的儿子沈祖棉及门生，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 67310,
      "end_ms": 72690,
      "text": "从笔记、书闸和往来信函中搜集整理编成沈氏悬空学，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 72730,
      "end_ms": 75205,
      "text": "四卷后再增骨为六卷，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 75460,
      "end_ms": 76660,
      "text": "更名为增广。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 76720,
      "end_ms": 77935,
      "text": "沈视悬空学。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 78370,
      "end_ms": 78865,
      "text": "说白了，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 79190,
      "end_ms": 82325,
      "text": "这本书不是沈竹仍正经危坐写出来的著作，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 82660,
      "end_ms": 84460,
      "text": "而是他一辈子的思考碎片，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 84480,
      "end_ms": 86580,
      "text": "被后人拼合出来的一幅地图。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 86840,
      "end_ms": 88135,
      "text": "全书共分六卷，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 88510,
      "end_ms": 91090,
      "text": "第一二卷为自得斋地理丛说，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 91330,
      "end_ms": 98470,
      "text": "包括缘起论、悬空论、天星论、罗经论、子白论、父母、子熙等三十六篇，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 98650,
      "end_ms": 100055,
      "text": "是沈竹人的遗稿，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 100480,
      "end_ms": 103040,
      "text": "集中说明了悬空学的理论及其应用，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 103200,
      "end_ms": 104875,
      "text": "也是全书最重要的部分。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 105320,
      "end_ms": 107425,
      "text": "所以你读的时候会有一种特别的感受，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 107780,
      "end_ms": 109465,
      "text": "它不像教科书那么规整，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 109870,
      "end_ms": 113710,
      "text": "倒像是一个人在深夜里断断续续跟你讲他悟到的东西。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 113730,
      "end_ms": 117295,
      "text": "所以你别以为它只是一本讲建筑和环境的古书。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 117590,
      "end_ms": 119905,
      "text": "他其实是在追问一个更根本的问题，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 120230,
      "end_ms": 123625,
      "text": "人所处的时空究竟遵循着什么样的秩序？"
    },
    {
      "segment_id": "s000049",
      "start_ms": 123820,
      "end_ms": 125500,
      "text": "那我们就从这本书的核心开始，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 125680,
      "end_ms": 128310,
      "text": "书里最关键的四个字叫悬空。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 128510,
      "end_ms": 129525,
      "text": "什么叫悬空？"
    },
    {
      "segment_id": "s000052",
      "start_ms": 129950,
      "end_ms": 132365,
      "text": "书里在论悬空一章中说的很清楚，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 132720,
      "end_ms": 134115,
      "text": "是悬空二字，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 134510,
      "end_ms": 136305,
      "text": "待一至九之未然，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 136850,
      "end_ms": 138330,
      "text": "一至九非定数，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 138330,
      "end_ms": 140240,
      "text": "也有错综参悟，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 140360,
      "end_ms": 141575,
      "text": "存乎于其间，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 142040,
      "end_ms": 143880,
      "text": "故意悬空二字代之。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 143900,
      "end_ms": 144845,
      "text": "你听听这句话，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 145230,
      "end_ms": 147415,
      "text": "悬空带指一到九，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 147900,
      "end_ms": 150355,
      "text": "但一到九又不是固定不变的数，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 150760,
      "end_ms": 154245,
      "text": "其中有错综复杂的变化和领悟存乎其间，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 155020,
      "end_ms": 155840,
      "text": "这是什么意思？"
    },
    {
      "segment_id": "s000064",
      "start_ms": 155980,
      "end_ms": 156680,
      "text": "简单的说，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 157020,
      "end_ms": 158860,
      "text": "悬就是时间空，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 158880,
      "end_ms": 160760,
      "text": "就是空间悬空，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 160840,
      "end_ms": 163180,
      "text": "就是时间和空间的演化组合。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 163380,
      "end_ms": 165045,
      "text": "它不是让你去背一堆口诀，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 165420,
      "end_ms": 166775,
      "text": "而是让你理解一件事。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 167250,
      "end_ms": 169475,
      "text": "世界上没有孤立存在的数字，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 169810,
      "end_ms": 171610,
      "text": "也没有孤立存在的事物。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 171630,
      "end_ms": 173055,
      "text": "一至九这九个数字，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 173420,
      "end_ms": 176400,
      "text": "他们之间的关系会随着时间推移而变化，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 176700,
      "end_ms": 178500,
      "text": "随着空间转移而重组，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 178820,
      "end_ms": 180940,
      "text": "这就是沈竹仁最核心的哲学观。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 181200,
      "end_ms": 182440,
      "text": "他所做的不是算命，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 182640,
      "end_ms": 184880,
      "text": "而是在寻找宇宙运行的节奏。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 184960,
      "end_ms": 188340,
      "text": "沈竹人把这套思想建立在洛输九宫的基础上洛，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 188340,
      "end_ms": 190680,
      "text": "殊是一个三阶患方一到九，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 190680,
      "end_ms": 192565,
      "text": "这九个数字填在九宫格里，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 192810,
      "end_ms": 200585,
      "text": "横竖斜相加都等于十五书中的九韵、哀心历程图起星图、二百一十六局等篇章，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 200920,
      "end_ms": 204820,
      "text": "就是试图用这套数理模型来描述时空的变化规律。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 204820,
      "end_ms": 206830,
      "text": "你看一个简单的九宫格，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 207030,
      "end_ms": 208740,
      "text": "九个数字组合起来，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 208740,
      "end_ms": 210985,
      "text": "却有二百一十六种变化格局。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 211310,
      "end_ms": 214675,
      "text": "这不就是沈主任说的一至九非定数也吗？"
    },
    {
      "segment_id": "s000087",
      "start_ms": 215230,
      "end_ms": 216355,
      "text": "数字是固定的，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 216540,
      "end_ms": 218795,
      "text": "但他们之间的排列组合是无穷的。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 219050,
      "end_ms": 220155,
      "text": "他借此想说的是，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 220560,
      "end_ms": 222075,
      "text": "世界的底层是秩序，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 222380,
      "end_ms": 224785,
      "text": "但秩序之中包含着无限的可能。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 224970,
      "end_ms": 226730,
      "text": "你以为你站在一个固定的位置上，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 226890,
      "end_ms": 229565,
      "text": "其实你站在一个不断流动的时空节点里。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 229830,
      "end_ms": 231515,
      "text": "然后我们来说三元九韵，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 232130,
      "end_ms": 234630,
      "text": "这是沈氏悬空学里最重要的时间框架。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 234750,
      "end_ms": 237350,
      "text": "沈竹仍将一百八十年划分为三个圆，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 237630,
      "end_ms": 240190,
      "text": "每个圆六十年再细分为三个运，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 240390,
      "end_ms": 243360,
      "text": "每个运二十年上缘是一白二，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 243360,
      "end_ms": 251050,
      "text": "黑三b中原是四绿五黄六白下缘是七赤八白九子九运走完，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 251290,
      "end_ms": 252170,
      "text": "再回到一运，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 252390,
      "end_ms": 253045,
      "text": "循环往，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 253560,
      "end_ms": 254300,
      "text": "永不停歇。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 254380,
      "end_ms": 255395,
      "text": "你听听这套框架，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 255740,
      "end_ms": 258080,
      "text": "是不是觉得他很像某种关于时间的隐喻？"
    },
    {
      "segment_id": "s000105",
      "start_ms": 258200,
      "end_ms": 260760,
      "text": "他在说时间不是一条直线，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 261060,
      "end_ms": 261820,
      "text": "而是一个圆。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 262100,
      "end_ms": 263715,
      "text": "每隔二十年有它的主题，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 264150,
      "end_ms": 265755,
      "text": "每隔六十年有他的气质，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 266210,
      "end_ms": 268485,
      "text": "每个一百八十年有它完整的故事。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 269060,
      "end_ms": 272305,
      "text": "沈竹荣用这套模型来理解事物兴衰的节奏。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 272670,
      "end_ms": 278270,
      "text": "他所做的是把变化这件事本身变成了一门可以观察、可以理解的学问。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 278390,
      "end_ms": 279315,
      "text": "他告诉我们，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 279640,
      "end_ms": 281990,
      "text": "变化不是混乱的变化，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 282110,
      "end_ms": 283065,
      "text": "有它的韵律。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 283830,
      "end_ms": 292260,
      "text": "书中最引人入胜的部分是关于九星的非福九颗星一白二黑三碧四绿，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 292500,
      "end_ms": 296385,
      "text": "五黄六白七赤八白九紫。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 296890,
      "end_ms": 298110,
      "text": "他们不是静止的，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 298310,
      "end_ms": 301230,
      "text": "而是在九宫格中按照特定的轨迹飞行，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 301350,
      "end_ms": 306910,
      "text": "每一运有一颗星、当令当令的星所在的位置被认为是当下时空的枢纽。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 307330,
      "end_ms": 310810,
      "text": "但沈竹人的深刻之处不在于告诉你哪颗星当令，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 311230,
      "end_ms": 315350,
      "text": "而在于他通过这套飞星体系表达了一个哲学判断，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 315850,
      "end_ms": 317090,
      "text": "没有任何一颗星，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 317130,
      "end_ms": 317990,
      "text": "永远当令，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 318250,
      "end_ms": 320550,
      "text": "没有任何一个位置永远正确。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 320670,
      "end_ms": 321990,
      "text": "一、白星当令的时候，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 322110,
      "end_ms": 323370,
      "text": "九子星在休息。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 323870,
      "end_ms": 325230,
      "text": "一子星当令的时候，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 325290,
      "end_ms": 326700,
      "text": "一白星退到了幕后，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 327040,
      "end_ms": 329220,
      "text": "这不就是我们每个人都会经历的事儿吗？"
    },
    {
      "segment_id": "s000130",
      "start_ms": 329360,
      "end_ms": 330760,
      "text": "你曾经站在舞台中央，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 331120,
      "end_ms": 332620,
      "text": "但总有人要接替你，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 333060,
      "end_ms": 335240,
      "text": "你曾经是角落里被忽略的那个人，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 335520,
      "end_ms": 337520,
      "text": "但时间会走到你面前。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 338060,
      "end_ms": 340280,
      "text": "沈竹荣不是在教你怎么选好位置，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 340560,
      "end_ms": 342160,
      "text": "他是在告诉你位置，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 342160,
      "end_ms": 343860,
      "text": "本身就是流动的。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 343880,
      "end_ms": 344580,
      "text": "说到这里，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 344580,
      "end_ms": 347440,
      "text": "就不得不提书里一个极富哲学意味的概念。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 347700,
      "end_ms": 349420,
      "text": "天心什么叫天心？"
    },
    {
      "segment_id": "s000140",
      "start_ms": 350120,
      "end_ms": 352360,
      "text": "沈竹荣在论天心一篇中写道，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 352720,
      "end_ms": 354940,
      "text": "九宫之中心为天心，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 355360,
      "end_ms": 356710,
      "text": "此二字由来已久。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 356970,
      "end_ms": 358935,
      "text": "伏羲法八级做八卦，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 359280,
      "end_ms": 359760,
      "text": "皇帝，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 359760,
      "end_ms": 360420,
      "text": "做九窍，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 360660,
      "end_ms": 361480,
      "text": "以定九宫，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 361760,
      "end_ms": 362280,
      "text": "此窍，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 362320,
      "end_ms": 364040,
      "text": "字即新字之意。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 364100,
      "end_ms": 365035,
      "text": "你听听这句话，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 365410,
      "end_ms": 367935,
      "text": "他把九宫格的正中央称为天心，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 368450,
      "end_ms": 370410,
      "text": "而且追溯到伏羲画八卦，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 370670,
      "end_ms": 371830,
      "text": "皇帝定九宫。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 371950,
      "end_ms": 374645,
      "text": "那么古老的源头上去天星是什么？"
    },
    {
      "segment_id": "s000154",
      "start_ms": 375050,
      "end_ms": 378290,
      "text": "这是当下这一运的忘气所凝聚的那个点，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 378610,
      "end_ms": 380910,
      "text": "是整个时空格局的枢纽所在。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 381050,
      "end_ms": 382965,
      "text": "但他又说了一句更关键的话，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 383510,
      "end_ms": 386255,
      "text": "悬空之法取八卦以配九宫，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 386730,
      "end_ms": 388185,
      "text": "其运用只重一卦，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 388660,
      "end_ms": 391765,
      "text": "此卦即偏星正运入中之卯字，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 392130,
      "end_ms": 395015,
      "text": "以及本运旺兴倒相之一卦事业。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 395290,
      "end_ms": 397590,
      "text": "意思是说八卦配九宫，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 397930,
      "end_ms": 400095,
      "text": "但真正起作用的只有一卦，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 400420,
      "end_ms": 402835,
      "text": "就是天心正运所落的那一卦。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 403140,
      "end_ms": 405625,
      "text": "这难道不是在说一个关于聚焦的道理吗？"
    },
    {
      "segment_id": "s000165",
      "start_ms": 405860,
      "end_ms": 406655,
      "text": "世界很复杂，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 407090,
      "end_ms": 409335,
      "text": "九宫八十一阁、二百一十六局。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 409760,
      "end_ms": 411995,
      "text": "但你不可能同时抓住所有的可能性，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 412220,
      "end_ms": 415460,
      "text": "你必须在某一个时刻找到那个真正的核心，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 415760,
      "end_ms": 417575,
      "text": "然后把注意力集中在那里。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 417820,
      "end_ms": 419135,
      "text": "偏心不是固定的，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 419410,
      "end_ms": 421050,
      "text": "它会随着原运而移动，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 421190,
      "end_ms": 423374,
      "text": "所以你也不能永远盯着同一个地方，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 423720,
      "end_ms": 425725,
      "text": "你必须学会在时间中辨认。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 426050,
      "end_ms": 427495,
      "text": "此刻的天星在哪里？"
    },
    {
      "segment_id": "s000175",
      "start_ms": 427980,
      "end_ms": 429680,
      "text": "书中还有一个非常重要的概念，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 429680,
      "end_ms": 431220,
      "text": "叫父母三般卦。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 431280,
      "end_ms": 433560,
      "text": "什么叫三般卦书中的飞星？"
    },
    {
      "segment_id": "s000178",
      "start_ms": 433560,
      "end_ms": 435925,
      "text": "体系里每个工位有三个数字，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 436270,
      "end_ms": 438595,
      "text": "运星山、星象星。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 439080,
      "end_ms": 444495,
      "text": "当这三个数字形成一四七二五八三六九这样的间隔组合时，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 444790,
      "end_ms": 446470,
      "text": "就构成了父母三般卦。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 446530,
      "end_ms": 451035,
      "text": "你听听这个结构一四七二五八三六九，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 451520,
      "end_ms": 452795,
      "text": "每组三个数字，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 453050,
      "end_ms": 456050,
      "text": "彼此间隔两位形成一种均匀的节奏。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 456190,
      "end_ms": 456990,
      "text": "沈仲荣认为，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 457270,
      "end_ms": 461820,
      "text": "这种格局能够沟通上中下三元之气是全局，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 461920,
      "end_ms": 463520,
      "text": "各卦互相通气儿，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 463520,
      "end_ms": 465620,
      "text": "即使不是望山望乡的格局，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 465900,
      "end_ms": 468355,
      "text": "也能产生望山望向的功效。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 468890,
      "end_ms": 470485,
      "text": "他为什么这么重视这个格局？"
    },
    {
      "segment_id": "s000191",
      "start_ms": 470870,
      "end_ms": 472855,
      "text": "因为三班挂皆是的一个道理，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 473290,
      "end_ms": 476695,
      "text": "真正有力量的结构不是某一个点特别强，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 476960,
      "end_ms": 479575,
      "text": "而是各点之间形成了均匀的张力。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 480010,
      "end_ms": 483210,
      "text": "一四七之间、二五八之间、三六九之间，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 483410,
      "end_ms": 484965,
      "text": "他们不是简单的堆叠，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 485250,
      "end_ms": 486895,
      "text": "而是一种有节奏的呼应。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 487340,
      "end_ms": 490080,
      "text": "这不就像我们生活中那些真正稳固的关系吗？"
    },
    {
      "segment_id": "s000198",
      "start_ms": 490100,
      "end_ms": 492095,
      "text": "不是靠某一个人撑起全部，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 492390,
      "end_ms": 495010,
      "text": "而是所有人之间都有一条看不见的线，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 495150,
      "end_ms": 496130,
      "text": "在互相牵引。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 496150,
      "end_ms": 497690,
      "text": "还有一个概念叫阴阳，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 497790,
      "end_ms": 499770,
      "text": "灵正沈竹仍在论。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 499810,
      "end_ms": 501190,
      "text": "阴阳灵正一篇中说，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 501810,
      "end_ms": 503170,
      "text": "灵正即阴阳，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 503590,
      "end_ms": 504490,
      "text": "当元之令，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 504490,
      "end_ms": 506730,
      "text": "神为正神与正神，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 506750,
      "end_ms": 508185,
      "text": "对待者为灵神，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 508430,
      "end_ms": 508890,
      "text": "正神，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 509050,
      "end_ms": 510370,
      "text": "即当元之旺，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 510390,
      "end_ms": 513430,
      "text": "神灵神即出元之衰神。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 513570,
      "end_ms": 514790,
      "text": "用最朴素的话说，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 515050,
      "end_ms": 517465,
      "text": "就是当运的那颗星是正神，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 517850,
      "end_ms": 520245,
      "text": "已经过了气的那颗心是灵神，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 520740,
      "end_ms": 522805,
      "text": "一孕的时候一白是正神，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 523090,
      "end_ms": 524075,
      "text": "九子是灵神，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 524420,
      "end_ms": 526460,
      "text": "九运的时候九子是正神，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 526600,
      "end_ms": 527620,
      "text": "一白成了灵神，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 527620,
      "end_ms": 528485,
      "text": "你发现了吗？"
    },
    {
      "segment_id": "s000219",
      "start_ms": 528990,
      "end_ms": 531490,
      "text": "今天坐在正位上的人一百八十年后，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 531570,
      "end_ms": 532845,
      "text": "可能就在角落里了。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 533330,
      "end_ms": 534510,
      "text": "零正不是对错，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 534750,
      "end_ms": 536440,
      "text": "而是十位沈竹阳。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 536440,
      "end_ms": 537155,
      "text": "想说的是，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 537470,
      "end_ms": 540005,
      "text": "没有任何一颗心可以永远当正神，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 540380,
      "end_ms": 541540,
      "text": "也没有任何一颗星，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 541560,
      "end_ms": 542720,
      "text": "注定当灵神，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 542940,
      "end_ms": 546155,
      "text": "正与灵不过是时间流转中的两个角色，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 546510,
      "end_ms": 547710,
      "text": "彼此互为镜像，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 547790,
      "end_ms": 548590,
      "text": "互为条件。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 548670,
      "end_ms": 550615,
      "text": "你今天觉得某件事毫无价值，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 550940,
      "end_ms": 554290,
      "text": "也许只是他还没有等到属于他的那个运书中，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 554290,
      "end_ms": 555970,
      "text": "还有一个非常关键的概念，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 556150,
      "end_ms": 558405,
      "text": "叫形鸾与理气的互补。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 559040,
      "end_ms": 562200,
      "text": "什么叫形鸾就是你眼睛能看到的地形，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 562520,
      "end_ms": 563020,
      "text": "山势，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 563340,
      "end_ms": 564580,
      "text": "水流建筑。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 564720,
      "end_ms": 565755,
      "text": "什么叫理器？"
    },
    {
      "segment_id": "s000238",
      "start_ms": 566130,
      "end_ms": 568175,
      "text": "就是时间带来的能量变化。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 568460,
      "end_ms": 568880,
      "text": "沈竹扔，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 568880,
      "end_ms": 570640,
      "text": "认为两者必须结合，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 570760,
      "end_ms": 572840,
      "text": "才能理解一个空间的真实状态。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 572900,
      "end_ms": 574555,
      "text": "你不能只看眼前的景象，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 574900,
      "end_ms": 576625,
      "text": "也不能只算抽象的数字。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 577080,
      "end_ms": 578300,
      "text": "你必须同时理解，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 578300,
      "end_ms": 580880,
      "text": "这里是什么样和现在是什么时候。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 581060,
      "end_ms": 582520,
      "text": "这个思想放到今天来看，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 582740,
      "end_ms": 583540,
      "text": "依然深刻。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 583620,
      "end_ms": 584465,
      "text": "他提醒我们，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 584750,
      "end_ms": 588215,
      "text": "任何判断都不能脱离具体的处境和具体的时间。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 588650,
      "end_ms": 590275,
      "text": "一个在春天正确的选择，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 590540,
      "end_ms": 592620,
      "text": "在冬天可能就完全错了。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 592620,
      "end_ms": 594080,
      "text": "一个对别人有效的方法，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 594320,
      "end_ms": 596005,
      "text": "对你可能毫无意义。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 596360,
      "end_ms": 598660,
      "text": "他还在书中特别重视向水的问题。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 598900,
      "end_ms": 599800,
      "text": "什么叫向水？"
    },
    {
      "segment_id": "s000256",
      "start_ms": 600240,
      "end_ms": 602960,
      "text": "就是建筑朝向与水流的配合关系，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 603080,
      "end_ms": 605845,
      "text": "他认为水是动态的、流动的。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 606150,
      "end_ms": 607190,
      "text": "承载变化的。"
    },
    {
      "segment_id": "s000259",
      "start_ms": 607350,
      "end_ms": 611750,
      "text": "而山是静态的、稳定的、承载恒长的一个空间，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 611750,
      "end_ms": 612750,
      "text": "要想达到平衡，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 613090,
      "end_ms": 616630,
      "text": "就必须让动与静变与不变之间形成对话。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 617010,
      "end_ms": 619270,
      "text": "这难道不是在讲一种生活的哲学吗？"
    },
    {
      "segment_id": "s000263",
      "start_ms": 619270,
      "end_ms": 620830,
      "text": "你的人生里需要有一座山，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 621150,
      "end_ms": 622910,
      "text": "那是你的根基和信念，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 623230,
      "end_ms": 624290,
      "text": "也需要有一条河，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 624750,
      "end_ms": 626690,
      "text": "那是你的适应力和变化力。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 626910,
      "end_ms": 628010,
      "text": "只有水没有山，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 628310,
      "end_ms": 629370,
      "text": "你活得太僵硬。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 629850,
      "end_ms": 630990,
      "text": "只有水没有山，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 631390,
      "end_ms": 632550,
      "text": "你活得太飘忽。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 632970,
      "end_ms": 633570,
      "text": "沈竹荣。"
    },
    {
      "segment_id": "s000272",
      "start_ms": 633690,
      "end_ms": 636840,
      "text": "用空间的语言说了一个关于做做人的道理。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 637040,
      "end_ms": 637880,
      "text": "有意思的是，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 638120,
      "end_ms": 640960,
      "text": "沈竹壤本人对这套学问的态度非常清醒。"
    },
    {
      "segment_id": "s000275",
      "start_ms": 641440,
      "end_ms": 643400,
      "text": "他在地理辩证绝药的序言中，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 643520,
      "end_ms": 644660,
      "text": "批评前人著书，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 645000,
      "end_ms": 646340,
      "text": "大帅皆扶词，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 646380,
      "end_ms": 646820,
      "text": "无语，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 647240,
      "end_ms": 648280,
      "text": "后人著本也。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 648280,
      "end_ms": 649940,
      "text": "大多以隐语式隐语，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 650160,
      "end_ms": 650940,
      "text": "愈演愈烦，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 651220,
      "end_ms": 652080,
      "text": "隐晦难明。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 652680,
      "end_ms": 656340,
      "text": "他明确表示自己力求浅白易懂披肝露胆，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 656620,
      "end_ms": 659320,
      "text": "要让人人皆知悬空学之真迹。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 659320,
      "end_ms": 660220,
      "text": "你听听这段话，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 660540,
      "end_ms": 661840,
      "text": "他的态度多么坦荡。"
    },
    {
      "segment_id": "s000287",
      "start_ms": 662300,
      "end_ms": 664060,
      "text": "学问是用来被理解的，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 664220,
      "end_ms": 665795,
      "text": "不是用来装神弄鬼的。"
    },
    {
      "segment_id": "s000289",
      "start_ms": 666060,
      "end_ms": 666405,
      "text": "当然，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 666670,
      "end_ms": 667415,
      "text": "我们也得承认，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 667660,
      "end_ms": 668760,
      "text": "这本书并非完美。"
    },
    {
      "segment_id": "s000292",
      "start_ms": 668760,
      "end_ms": 669825,
      "text": "后世学者指出，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 670210,
      "end_ms": 674910,
      "text": "沈竹榕的学问间接传自张仲山的儿孙并非正派嫡传，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 675110,
      "end_ms": 677050,
      "text": "难免有思意强解之处。"
    },
    {
      "segment_id": "s000295",
      "start_ms": 677150,
      "end_ms": 680085,
      "text": "他的著述多为笔记、书闸和弟子讲义，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 680400,
      "end_ms": 682665,
      "text": "系统性和完整性也不尽完美。"
    },
    {
      "segment_id": "s000297",
      "start_ms": 683230,
      "end_ms": 684490,
      "text": "但正是这些不完美，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 684690,
      "end_ms": 686845,
      "text": "让这本书有了另一种真实感。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 687180,
      "end_ms": 690295,
      "text": "他不是一个高高在上的权威在宣判真理，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 690690,
      "end_ms": 694470,
      "text": "而是一个终身求学的人在分享他的摸索和顿悟。"
    },
    {
      "segment_id": "s000301",
      "start_ms": 694570,
      "end_ms": 696965,
      "text": "那么这本书最终在告诉我们什么？"
    },
    {
      "segment_id": "s000302",
      "start_ms": 697320,
      "end_ms": 699685,
      "text": "他在说世界是有秩序的。"
    },
    {
      "segment_id": "s000303",
      "start_ms": 699990,
      "end_ms": 701715,
      "text": "一至九的变化不是随机的，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 701960,
      "end_ms": 703915,
      "text": "三元九韵的循环不是偶然的，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 704230,
      "end_ms": 707175,
      "text": "他们背后有一种可以被理解、被感知的规律。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 707440,
      "end_ms": 708215,
      "text": "他也在说，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 708650,
      "end_ms": 710595,
      "text": "秩序之中包含变化，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 711080,
      "end_ms": 712540,
      "text": "没有永恒不变的位置，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 712780,
      "end_ms": 714535,
      "text": "没有永远当令的星辰，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 714970,
      "end_ms": 717945,
      "text": "你必须学会在变化中找到自己的节奏。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 718530,
      "end_ms": 719305,
      "text": "他还在说，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 719760,
      "end_ms": 720540,
      "text": "理解世界，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 720540,
      "end_ms": 722815,
      "text": "需要同时关注空间和时间，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 723110,
      "end_ms": 724825,
      "text": "关注形势和气韵，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 725260,
      "end_ms": 731095,
      "text": "单独看任何一面都是片面的这难道不像一本写给被确定性困住的人的启示录吗？"
    },
    {
      "segment_id": "s000316",
      "start_ms": 731590,
      "end_ms": 733270,
      "text": "我们总想找一个固定的答案，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 733450,
      "end_ms": 734930,
      "text": "一个永远正确的方向，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 735270,
      "end_ms": 736705,
      "text": "一个不会改变的位置。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 737150,
      "end_ms": 739505,
      "text": "但沈主任用他毕生的研究告诉我们，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 739940,
      "end_ms": 741040,
      "text": "没有这样的答案，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 741040,
      "end_ms": 744005,
      "text": "真正的智慧不是找到一个永远安全的位置，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 744360,
      "end_ms": 746025,
      "text": "而是理解变化的规律，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 746320,
      "end_ms": 747585,
      "text": "然后与变化共舞。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 747880,
      "end_ms": 750615,
      "text": "沈氏悬空学出版至今已经一百多年了，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 750880,
      "end_ms": 751620,
      "text": "他没有过时。"
    },
    {
      "segment_id": "s000326",
      "start_ms": 751760,
      "end_ms": 753405,
      "text": "哪怕你读不懂那些飞行图，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 753690,
      "end_ms": 755615,
      "text": "哪怕你记不住那些九宫格局，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 756460,
      "end_ms": 759435,
      "text": "他最核心的那句话依然会轻轻触碰到你。"
    },
    {
      "segment_id": "s000329",
      "start_ms": 760740,
      "end_ms": 762345,
      "text": "世界的本质是变化的，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 762870,
      "end_ms": 765105,
      "text": "而变化本身是有秩序的。"
    },
    {
      "segment_id": "s000331",
      "start_ms": 765580,
      "end_ms": 767710,
      "text": "你要做的是理解这个秩序，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 767930,
      "end_ms": 770185,
      "text": "然后用自己的方式去回应他。"
    },
    {
      "segment_id": "s000333",
      "start_ms": 770650,
      "end_ms": 773045,
      "text": "别成为那个只盯着一个位置不放的人，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 773370,
      "end_ms": 775035,
      "text": "别成为那个拒绝变化的人，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 775370,
      "end_ms": 776950,
      "text": "也别成为那个随波逐流，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 777110,
      "end_ms": 778215,
      "text": "毫无根基的人。"
    },
    {
      "segment_id": "s000337",
      "start_ms": 778440,
      "end_ms": 781745,
      "text": "我们最终都得活成一个能在时间中安顿自己的人，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 782190,
      "end_ms": 785255,
      "text": "但我们心里应该保留一份对变化的敬畏，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 785600,
      "end_ms": 786745,
      "text": "哪怕一点点也好，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 787390,
      "end_ms": 789550,
      "text": "也欢迎你把这本书分享给你。"
    },
    {
      "segment_id": "s000341",
      "start_ms": 789550,
      "end_ms": 791925,
      "text": "生命中那个同样在寻找答案的人，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 792550,
      "end_ms": 794885,
      "text": "也许他就是能读懂你飞星盘的那个人。"
    },
    {
      "segment_id": "s000343",
      "start_ms": 795230,
      "end_ms": 798865,
      "text": "也许你曾是他某个时空节点里最亮的那颗星，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 799230,
      "end_ms": 799985,
      "text": "我是小海龟。"
    },
    {
      "segment_id": "s000345",
      "start_ms": 800280,
      "end_ms": 801440,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 801440,
      "end_ms": 802085,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "adde3cd1ab609cc533dd2b0197b98e58b8557a2ac8e636c9fe75e253d3c3b69c"
}