{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_45523d41084c1dfe_u001",
  "video_id": "v_45523d41084c1dfe",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 554.005986,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 70,
      "end_ms": 3690,
      "text": "您知道故宫里有一件东西是人做出来，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4570,
      "end_ms": 6450,
      "text": "但看着像老天爷做的吗？"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7230,
      "end_ms": 9450,
      "text": "不是那些天然形成的玉石，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 10170,
      "end_ms": 12570,
      "text": "也不是那些长了几百年的古树，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 12990,
      "end_ms": 19230,
      "text": "是人用一双手一刀一刀一针一线一层一层做出来的东西。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 19790,
      "end_ms": 22950,
      "text": "可您第一眼看到它的时候会愣住，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 23690,
      "end_ms": 26730,
      "text": "这东西人也能做出来。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 26990,
      "end_ms": 30540,
      "text": "今天咱们就来盘点故宫里十件人做的做出来，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 31300,
      "end_ms": 33400,
      "text": "但看着像老天爷做的宝贝，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 33900,
      "end_ms": 38119,
      "text": "每一件都代表了老祖宗手艺的极高水平，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 38280,
      "end_ms": 41600,
      "text": "每一件后人想仿很难仿到位。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 42260,
      "end_ms": 43920,
      "text": "老规矩开讲之前，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 43920,
      "end_ms": 45960,
      "text": "劳烦您扣个一点个红心，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 46540,
      "end_ms": 48020,
      "text": "让我看看都是谁。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 48020,
      "end_ms": 54760,
      "text": "在盘第十名章程造款雕漆云纹盘这件东西，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 55640,
      "end_ms": 59405,
      "text": "您第一眼看到他的时候会愣住，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 60020,
      "end_ms": 66725,
      "text": "这东西人也能做出来黑的发亮匀文圆润，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 67140,
      "end_ms": 68565,
      "text": "摸上去跟玉一样，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 69670,
      "end_ms": 71055,
      "text": "可它其实是木头做，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 71330,
      "end_ms": 71485,
      "text": "嗯，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 71710,
      "end_ms": 73550,
      "text": "外面刷了一层又一层的漆。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 74110,
      "end_ms": 76450,
      "text": "元代有一个叫张程的七七大使，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 76470,
      "end_ms": 77645,
      "text": "做涕洪出名。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 78660,
      "end_ms": 79505,
      "text": "什么叫涕红？"
    },
    {
      "segment_id": "s000025",
      "start_ms": 80340,
      "end_ms": 81940,
      "text": "就是在器物上刷红，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 81980,
      "end_ms": 84265,
      "text": "漆刷到足够厚，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 85040,
      "end_ms": 88065,
      "text": "再用刀一刀一刀把花纹剃出来，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 89190,
      "end_ms": 90465,
      "text": "您知道刷多少层吗？"
    },
    {
      "segment_id": "s000029",
      "start_ms": 91680,
      "end_ms": 92955,
      "text": "少则八九十层，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 93340,
      "end_ms": 94695,
      "text": "多则一二百层，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 95150,
      "end_ms": 98235,
      "text": "每一层都要等前一层干透了才能刷下一层。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 98990,
      "end_ms": 99990,
      "text": "刷完一百层，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 100330,
      "end_ms": 101775,
      "text": "少说也要几个月，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 102580,
      "end_ms": 104165,
      "text": "张程不光会剃红，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 104600,
      "end_ms": 106155,
      "text": "替西也是高手，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 106540,
      "end_ms": 108235,
      "text": "气息比提红更难，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 109120,
      "end_ms": 111980,
      "text": "要用两种颜色的漆交替着，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 111980,
      "end_ms": 114125,
      "text": "刷刷到足够厚，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 114820,
      "end_ms": 117765,
      "text": "再用刀剔出云门这件盘子，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 118430,
      "end_ms": 123050,
      "text": "刀口断面上露出了四道朱红色的漆线。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 123950,
      "end_ms": 126110,
      "text": "古籍里叫乌间朱线，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 126850,
      "end_ms": 128970,
      "text": "黑色的漆里夹着红色的线，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 129630,
      "end_ms": 130650,
      "text": "像一条红线，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 130770,
      "end_ms": 131610,
      "text": "藏在墨里，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 131970,
      "end_ms": 133770,
      "text": "张成做了一辈子漆漆。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 134430,
      "end_ms": 137590,
      "text": "这件盘子是他的传世代表作，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 138290,
      "end_ms": 141130,
      "text": "到现在专家尝试复刻。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 141830,
      "end_ms": 143510,
      "text": "雕出来的漆不是太软，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 143550,
      "end_ms": 144230,
      "text": "就是太脆，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 144990,
      "end_ms": 146930,
      "text": "雕出来的云纹不是太深，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 147030,
      "end_ms": 147710,
      "text": "就是太浅，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 148210,
      "end_ms": 151800,
      "text": "后人想仿仿不了第九名。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 152160,
      "end_ms": 153760,
      "text": "沈子幡深思，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 153760,
      "end_ms": 154380,
      "text": "梅雀图，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 155220,
      "end_ms": 157080,
      "text": "您知道什么叫万丝吗？"
    },
    {
      "segment_id": "s000056",
      "start_ms": 157080,
      "end_ms": 158860,
      "text": "就是通经断尾经线，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 158960,
      "end_ms": 161740,
      "text": "从头到尾是连贯的尾线，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 161740,
      "end_ms": 165840,
      "text": "是一段一段断开的织一朵花织朵花，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 165900,
      "end_ms": 171420,
      "text": "用一种颜色的纬线织完了就剪断换另一种颜色，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 171420,
      "end_ms": 173140,
      "text": "在织一根尾线，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 173160,
      "end_ms": 174260,
      "text": "只织一个颜色，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 174800,
      "end_ms": 177480,
      "text": "一幅画下来要剪几万根线。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 178280,
      "end_ms": 180330,
      "text": "南宋有个叫沈子幡的的人，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 180990,
      "end_ms": 183490,
      "text": "用这种手艺织了一幅梅雀图。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 184250,
      "end_ms": 186250,
      "text": "一只喜鹊站在梅枝上，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 186670,
      "end_ms": 188870,
      "text": "喜鹊的眼睛灵动鲜活，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 189370,
      "end_ms": 190310,
      "text": "换一个角度，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 190710,
      "end_ms": 192950,
      "text": "眼睛仿佛会发光。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 193170,
      "end_ms": 194130,
      "text": "您凑近看，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 194470,
      "end_ms": 197910,
      "text": "画面上的每一根丝线密度到了经线，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 197970,
      "end_ms": 199390,
      "text": "二十根一厘米，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 199570,
      "end_ms": 202870,
      "text": "尾线四十四到四十六根一厘米，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 203130,
      "end_ms": 203885,
      "text": "什么概念？"
    },
    {
      "segment_id": "s000074",
      "start_ms": 206070,
      "end_ms": 208830,
      "text": "一厘米里头排了四十几根线，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 209010,
      "end_ms": 210150,
      "text": "比头发丝还密。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 210470,
      "end_ms": 211110,
      "text": "古人说，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 211150,
      "end_ms": 212910,
      "text": "一寸嫩丝一寸金，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 213570,
      "end_ms": 216490,
      "text": "不是夸张一件恩丝作品。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 217250,
      "end_ms": 219610,
      "text": "匠人一做就是常年累月，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 220390,
      "end_ms": 222350,
      "text": "要是做一件恩丝衣物，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 222810,
      "end_ms": 224570,
      "text": "常常要花整整一年。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 225270,
      "end_ms": 229230,
      "text": "沈子帆一生完成了数十件选丝艺术品，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 229590,
      "end_ms": 231090,
      "text": "但标有他名字，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 231510,
      "end_ms": 235230,
      "text": "但明确注入的传世作品只有五件。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 235350,
      "end_ms": 237440,
      "text": "这件梅雀图就是其中之一。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 238120,
      "end_ms": 241175,
      "text": "一幅蓝瓷画作要耗费数年功夫。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 241900,
      "end_ms": 243300,
      "text": "等吃完人都好，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 243300,
      "end_ms": 245175,
      "text": "老第八名，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 246290,
      "end_ms": 247965,
      "text": "青玉、云龙文儒，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 248840,
      "end_ms": 250565,
      "text": "这是一件宋代的玉器。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 251000,
      "end_ms": 253015,
      "text": "您知道宋代玉器有多绝吗？"
    },
    {
      "segment_id": "s000092",
      "start_ms": 253730,
      "end_ms": 257075,
      "text": "宋人雕玉不追求个头大，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 257690,
      "end_ms": 258665,
      "text": "追求巧，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 259390,
      "end_ms": 262485,
      "text": "这件炉子高不到八厘米，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 263130,
      "end_ms": 264905,
      "text": "口径不到十三厘米，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 265580,
      "end_ms": 268820,
      "text": "一只手就能握住卢身上雕了。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 268820,
      "end_ms": 271635,
      "text": "一条龙龙在云里翻腾，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 272100,
      "end_ms": 274560,
      "text": "您拿放大镜看龙的鳞片，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 274800,
      "end_ms": 275680,
      "text": "一片一片，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 275780,
      "end_ms": 277425,
      "text": "每一片形态都不一样。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 278260,
      "end_ms": 279105,
      "text": "龙的爪子，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 279930,
      "end_ms": 280710,
      "text": "五个指头，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 280930,
      "end_ms": 282130,
      "text": "每一个指头都刻出，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 282130,
      "end_ms": 285025,
      "text": "指甲云纹一根一根，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 285880,
      "end_ms": 286920,
      "text": "粗细深浅，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 286920,
      "end_ms": 287835,
      "text": "全有变化，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 289010,
      "end_ms": 291275,
      "text": "宋人雕玉不用机器，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 291720,
      "end_ms": 296385,
      "text": "全靠砣具一点一点慢慢磨一件这么小的器物。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 297150,
      "end_ms": 298470,
      "text": "工匠要磨几个月，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 298650,
      "end_ms": 299970,
      "text": "甚至整整一年，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 300790,
      "end_ms": 304170,
      "text": "您想想一块原石拿在手里，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 304330,
      "end_ms": 308710,
      "text": "日复一日细细打磨细到龙的鳞片都清晰分明，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 309190,
      "end_ms": 312650,
      "text": "人的手能做到这个份上实在惊人。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 314050,
      "end_ms": 314750,
      "text": "第七名，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 314830,
      "end_ms": 315690,
      "text": "掐死珐郎，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 315690,
      "end_ms": 320490,
      "text": "缠之连纹象耳龙珐琅这门手艺做代，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 320790,
      "end_ms": 322110,
      "text": "从阿拉伯传入，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 322890,
      "end_ms": 324450,
      "text": "可中国人学过来之后，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 325210,
      "end_ms": 331420,
      "text": "做的比猿头还要精上这件炉子用的是掐丝珐琅工艺。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 331720,
      "end_ms": 332740,
      "text": "什么叫掐丝？"
    },
    {
      "segment_id": "s000121",
      "start_ms": 333240,
      "end_ms": 336620,
      "text": "就是用细铜丝在铜胎上掐出花纹，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 337100,
      "end_ms": 339260,
      "text": "掐好之后填上珐琅釉料，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 339600,
      "end_ms": 341060,
      "text": "再放进窑里烧制，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 341400,
      "end_ms": 344220,
      "text": "烧一遍不够要反复烧好几遍，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 344640,
      "end_ms": 347400,
      "text": "每烧一遍釉料就会收缩。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 348060,
      "end_ms": 349360,
      "text": "凹下去就要补釉，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 349660,
      "end_ms": 351220,
      "text": "填了再烧来回，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 351300,
      "end_ms": 351760,
      "text": "反复，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 351800,
      "end_ms": 355060,
      "text": "直到釉面和铜丝齐平为止。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 355760,
      "end_ms": 363495,
      "text": "您想想铜丝有多细一根铜丝比头发丝粗不了多少，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 364190,
      "end_ms": 367775,
      "text": "要在上面掐除蝉枝连门一朵花，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 368570,
      "end_ms": 374105,
      "text": "一片叶子一根藤蔓全靠铜丝弯折成型。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 374790,
      "end_ms": 375630,
      "text": "烧完之后，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 375890,
      "end_ms": 378255,
      "text": "铜丝和珐琅融为一体，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 379010,
      "end_ms": 380230,
      "text": "摸上去平整，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 380290,
      "end_ms": 380985,
      "text": "顺滑，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 381550,
      "end_ms": 382290,
      "text": "可细看，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 382350,
      "end_ms": 385485,
      "text": "每一根铜丝纹路都清清楚楚。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 386060,
      "end_ms": 388680,
      "text": "这种工艺后人仿了几百年，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 389060,
      "end_ms": 390215,
      "text": "总是差一口气。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 391220,
      "end_ms": 391845,
      "text": "第六名，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 392160,
      "end_ms": 393325,
      "text": "雅婿芳尊，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 394020,
      "end_ms": 396820,
      "text": "这是一件商代晚期的青铜器，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 396940,
      "end_ms": 398565,
      "text": "三千多年前的东西。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 398910,
      "end_ms": 400265,
      "text": "高四十五厘米，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 400480,
      "end_ms": 401555,
      "text": "重二十一公斤。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 402450,
      "end_ms": 405875,
      "text": "您知道商代人是怎么铸造青铜器的吗？"
    },
    {
      "segment_id": "s000148",
      "start_ms": 406700,
      "end_ms": 408035,
      "text": "用的是分柱法。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 409160,
      "end_ms": 410205,
      "text": "什么叫分柱？"
    },
    {
      "segment_id": "s000150",
      "start_ms": 410740,
      "end_ms": 413515,
      "text": "就是先单独筑好各个零件，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 413870,
      "end_ms": 415485,
      "text": "再把零件拼装在一起。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 416330,
      "end_ms": 419770,
      "text": "这件方尊的肩上四角各有一个相，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 419770,
      "end_ms": 423205,
      "text": "手相手和弃身是分开铸造，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 424030,
      "end_ms": 424870,
      "text": "筑好之后，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 425090,
      "end_ms": 427525,
      "text": "用榫卯结构套接上去，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 428010,
      "end_ms": 430445,
      "text": "能拆下来也能装回去。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 430960,
      "end_ms": 436120,
      "text": "三千多年前的工匠已经掌握了分段铸造榫卯拼接的技术。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 436200,
      "end_ms": 439415,
      "text": "您想想一个相手单独筑好，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 439760,
      "end_ms": 442535,
      "text": "再套到气身上严丝合缝，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 443030,
      "end_ms": 444565,
      "text": "拆下来还能装回去，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 445370,
      "end_ms": 446945,
      "text": "这不是简单浇筑。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 447400,
      "end_ms": 450420,
      "text": "这是古代的精密制造商代工匠，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 450480,
      "end_ms": 451460,
      "text": "没有精密机床，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 451520,
      "end_ms": 452575,
      "text": "没有现代工具，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 452950,
      "end_ms": 454435,
      "text": "全凭经验和手感。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 455370,
      "end_ms": 457730,
      "text": "这件方尊历经三千多年，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 457970,
      "end_ms": 459395,
      "text": "棱角依旧分明，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 459680,
      "end_ms": 460975,
      "text": "纹饰清晰完整，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 461750,
      "end_ms": 462730,
      "text": "后人想复刻，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 462730,
      "end_ms": 463195,
      "text": "很难。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 463650,
      "end_ms": 465285,
      "text": "当年那种无线代工具，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 465650,
      "end_ms": 467370,
      "text": "纯靠双手拿捏的极致，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 467370,
      "end_ms": 469390,
      "text": "手工水准很难再现。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 469530,
      "end_ms": 471175,
      "text": "从第十到第六名，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 471560,
      "end_ms": 473585,
      "text": "这五件东西都够绝。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 474080,
      "end_ms": 477065,
      "text": "章程的雕漆刷了上百层漆，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 477550,
      "end_ms": 478915,
      "text": "一刀一刀剃出来。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 479750,
      "end_ms": 483965,
      "text": "沈子藩的燕丝一根尾线只织一个颜色，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 484400,
      "end_ms": 486025,
      "text": "剪断几万根丝线。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 486450,
      "end_ms": 490935,
      "text": "宋代青玉云龙文奴掌心大小磨上好几个月，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 491740,
      "end_ms": 493485,
      "text": "元代掐死珐琅弩，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 493830,
      "end_ms": 501995,
      "text": "同丝细如发丝商代亚序方尊三千年前就实现了分铸榫卯工艺。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 502420,
      "end_ms": 503935,
      "text": "可他们还不是最绝的。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 504440,
      "end_ms": 505835,
      "text": "接下来第五到第一名，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 506370,
      "end_ms": 507490,
      "text": "水准还要震撼。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 507610,
      "end_ms": 508675,
      "text": "有一件东西，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 508970,
      "end_ms": 512105,
      "text": "工匠花五年时间造出一座能动的钟。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 512680,
      "end_ms": 514430,
      "text": "有一件几千个人，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 514430,
      "end_ms": 515375,
      "text": "耗时十年，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 515930,
      "end_ms": 518095,
      "text": "打磨出一座巨型玉山。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 518670,
      "end_ms": 522085,
      "text": "有一件乾隆亲自敲定图样，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 522470,
      "end_ms": 524155,
      "text": "全城督造的酒杯。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 524810,
      "end_ms": 527800,
      "text": "有一件窑工烧石窑，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 528040,
      "end_ms": 528880,
      "text": "能成一窑，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 528880,
      "end_ms": 529975,
      "text": "就算撞大运。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 530740,
      "end_ms": 532690,
      "text": "还有一件画家，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 532690,
      "end_ms": 535090,
      "text": "一笔一画一墨一色，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 535370,
      "end_ms": 535850,
      "text": "耗尽，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 535970,
      "end_ms": 538075,
      "text": "心血汇成的千古名画。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 538590,
      "end_ms": 540195,
      "text": "这几件到底是什么？"
    },
    {
      "segment_id": "s000201",
      "start_ms": 540550,
      "end_ms": 541875,
      "text": "到底有多震撼？"
    },
    {
      "segment_id": "s000202",
      "start_ms": 542520,
      "end_ms": 544720,
      "text": "下一集已经同步更新，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 545040,
      "end_ms": 546620,
      "text": "直接点开我的头像，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 546800,
      "end_ms": 547520,
      "text": "进入主页，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 547520,
      "end_ms": 550195,
      "text": "第一条视频就是下一集点个关注，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 550550,
      "end_ms": 553970,
      "text": "咱们好好看看中国工匠到底造出了什么。"
    }
  ],
  "source_transcript_sha256": "6e6719da7e76be4d5a95f2e2860c3fa8bf7eb0a2199f26ee3fa167c3351ef0c2"
}