{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_31abd177485f569a_u002",
  "video_id": "v_31abd177485f569a",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 953.992993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000364",
      "start_ms": 875080,
      "end_ms": 877120,
      "text": "有人惯于用知识掩盖无知。"
    },
    {
      "segment_id": "s000365",
      "start_ms": 877420,
      "end_ms": 879625,
      "text": "看见他并不意味着我完了，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 880010,
      "end_ms": 883315,
      "text": "而是给了自己一个可以开始真实旅程的起点。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 883720,
      "end_ms": 886995,
      "text": "如果把上帝之城当做一份人类心灵的群体地图，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 887310,
      "end_ms": 888890,
      "text": "而不是一份罪的判决书，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 889310,
      "end_ms": 890490,
      "text": "也许会敬畏很多。"
    },
    {
      "segment_id": "s000370",
      "start_ms": 890750,
      "end_ms": 892535,
      "text": "他不是来宣布谁已沉沦，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 893060,
      "end_ms": 894265,
      "text": "而是像一座灯塔，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 894630,
      "end_ms": 896370,
      "text": "让人在迷失痛苦。"
    },
    {
      "segment_id": "s000373",
      "start_ms": 896610,
      "end_ms": 898185,
      "text": "想要放弃自我的时候，"
    },
    {
      "segment_id": "s000374",
      "start_ms": 898440,
      "end_ms": 902205,
      "text": "稍微照一照人类心灵那共通的深渊与可能的高度，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 902550,
      "end_ms": 904135,
      "text": "看看是不是还有别的路径，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 904810,
      "end_ms": 907555,
      "text": "那些曾经以为只有自己才会深陷的泥沼。"
    },
    {
      "segment_id": "s000377",
      "start_ms": 907930,
      "end_ms": 908290,
      "text": "其实，"
    },
    {
      "segment_id": "s000378",
      "start_ms": 908290,
      "end_ms": 910110,
      "text": "千百年来的人都跋涉过，"
    },
    {
      "segment_id": "s000379",
      "start_ms": 910530,
      "end_ms": 917890,
      "text": "只是大多数人从来没机会如此系统如此勇敢的将这条幽暗而光荣的路径走通并讲述出来。"
    },
    {
      "segment_id": "s000380",
      "start_ms": 918990,
      "end_ms": 923330,
      "text": "愿每一个在生命路上跌跌撞撞的人都能慢慢理解一件事，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 924230,
      "end_ms": 927170,
      "text": "不是只有圣徒才配拥有内心的安宁，"
    },
    {
      "segment_id": "s000382",
      "start_ms": 927810,
      "end_ms": 930990,
      "text": "而是那些愿意不断深入自己复杂真相的人，"
    },
    {
      "segment_id": "s000383",
      "start_ms": 931390,
      "end_ms": 932910,
      "text": "更容易触碰到深刻，"
    },
    {
      "segment_id": "s000384",
      "start_ms": 933270,
      "end_ms": 936270,
      "text": "也更容易在无常中活得踏实一点。"
    },
    {
      "segment_id": "s000385",
      "start_ms": 936850,
      "end_ms": 940540,
      "text": "愿在照见自己所有的不堪矛盾与渴望之后，"
    },
    {
      "segment_id": "s000386",
      "start_ms": 940980,
      "end_ms": 942220,
      "text": "既有勇气说一句，"
    },
    {
      "segment_id": "s000387",
      "start_ms": 942560,
      "end_ms": 943880,
      "text": "这就是我走过的路，"
    },
    {
      "segment_id": "s000388",
      "start_ms": 944160,
      "end_ms": 944960,
      "text": "也有勇气。"
    },
    {
      "segment_id": "s000389",
      "start_ms": 945160,
      "end_ms": 947060,
      "text": "在忏悔之后继续相信，"
    },
    {
      "segment_id": "s000390",
      "start_ms": 947060,
      "end_ms": 949140,
      "text": "生命可以被更新光明，"
    },
    {
      "segment_id": "s000391",
      "start_ms": 949440,
      "end_ms": 950460,
      "text": "值得被仰望。"
    },
    {
      "segment_id": "s000392",
      "start_ms": 950720,
      "end_ms": 951520,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000393",
      "start_ms": 951820,
      "end_ms": 953260,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000394",
      "start_ms": 953260,
      "end_ms": 953885,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "0474aa0d2e897c31a4705f92d9ffb1252d3392dde998d50a6ce4ffbdecd1a626"
}