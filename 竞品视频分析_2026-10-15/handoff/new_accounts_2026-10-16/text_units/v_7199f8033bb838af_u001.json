{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_7199f8033bb838af_u001",
  "video_id": "v_7199f8033bb838af",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 711.390998,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 110,
      "end_ms": 5070,
      "text": "你知道最该带家人去一次的地方是哪儿吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 5070,
      "end_ms": 9630,
      "text": "有人说马尔代夫有人说日本马尔代夫确实好看，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 10330,
      "end_ms": 13410,
      "text": "下那地方适合小年轻拍照发朋友圈。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 13830,
      "end_ms": 20150,
      "text": "带着爸妈去老两口在沙滩上晒一天晒完了也不知道看了什么。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 20910,
      "end_ms": 22290,
      "text": "日本更不用说了，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 22690,
      "end_ms": 25410,
      "text": "带着家里老人坐飞机折腾大半天，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 26310,
      "end_ms": 27990,
      "text": "下了飞机一个字看不懂，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 28390,
      "end_ms": 31000,
      "text": "吃饭要蹲在榻榻米上面跪的膝盖疼，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 31420,
      "end_ms": 33040,
      "text": "逛个景点全是台阶，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 33060,
      "end_ms": 35240,
      "text": "腿脚不好的走半天就不想动了。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 36080,
      "end_ms": 38960,
      "text": "钱花了不少老人累得够呛，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 39760,
      "end_ms": 40240,
      "text": "回来问，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 40240,
      "end_ms": 40880,
      "text": "好玩吗？"
    },
    {
      "segment_id": "s000014",
      "start_ms": 41000,
      "end_ms": 41600,
      "text": "说还行，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 42500,
      "end_ms": 44220,
      "text": "这叫带家人旅游吗？"
    },
    {
      "segment_id": "s000016",
      "start_ms": 44960,
      "end_ms": 46560,
      "text": "这叫带家人受罪。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 46980,
      "end_ms": 48920,
      "text": "真正该带家人去的地方，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 48920,
      "end_ms": 49740,
      "text": "不用出国，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 50280,
      "end_ms": 52060,
      "text": "还在榜首的那个地方。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 52460,
      "end_ms": 56200,
      "text": "墙上的壁画正在以肉眼可见的速度消失。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 56680,
      "end_ms": 58420,
      "text": "据研究人员监测，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 58980,
      "end_ms": 62775,
      "text": "今年看到的颜色和十年后看到的已经不一样，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 63320,
      "end_ms": 65225,
      "text": "再不带家人去看一眼，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 65620,
      "end_ms": 67875,
      "text": "有些东西这辈子就真没了，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 68030,
      "end_ms": 68955,
      "text": "到底是哪儿？"
    },
    {
      "segment_id": "s000026",
      "start_ms": 69270,
      "end_ms": 71530,
      "text": "从第十个开始倒着讲讲，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 71530,
      "end_ms": 72845,
      "text": "到第一个您自己品，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 73100,
      "end_ms": 73680,
      "text": "还是咱们的。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 73680,
      "end_ms": 74235,
      "text": "老规矩。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 75010,
      "end_ms": 75630,
      "text": "开讲前，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 75630,
      "end_ms": 79850,
      "text": "劳烦各位老友顺手点亮红心评论区，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 79850,
      "end_ms": 84805,
      "text": "打个来了让我看看今天又有多少知音来捧场。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 86140,
      "end_ms": 86885,
      "text": "第十名，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 87210,
      "end_ms": 91880,
      "text": "青海湖青海省青海湖，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 91880,
      "end_ms": 94265,
      "text": "很多人觉得青海湖不就是个大湖吗？"
    },
    {
      "segment_id": "s000036",
      "start_ms": 96110,
      "end_ms": 97195,
      "text": "有什么好看的？"
    },
    {
      "segment_id": "s000037",
      "start_ms": 97470,
      "end_ms": 100355,
      "text": "八就是好看。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 101640,
      "end_ms": 102700,
      "text": "据公开资料，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 102720,
      "end_ms": 106400,
      "text": "青海湖是中国面积数一数二的湖水域，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 106420,
      "end_ms": 108345,
      "text": "面积四千多平方公里，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 108920,
      "end_ms": 110955,
      "text": "四千多平方公里是什么概念？"
    },
    {
      "segment_id": "s000042",
      "start_ms": 111580,
      "end_ms": 113820,
      "text": "站在湖边往对岸看看，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 113820,
      "end_ms": 117025,
      "text": "不到头跟站在海边一模一样。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 117570,
      "end_ms": 118810,
      "text": "可它不是海水，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 118870,
      "end_ms": 119505,
      "text": "是蓝的，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 120000,
      "end_ms": 121100,
      "text": "不是海水那种。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 121100,
      "end_ms": 123800,
      "text": "深蓝是一种从浅到深，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 124380,
      "end_ms": 125780,
      "text": "从绿到蓝，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 126020,
      "end_ms": 127700,
      "text": "慢慢过渡的颜色，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 128600,
      "end_ms": 129780,
      "text": "干净的不像话。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 130200,
      "end_ms": 134400,
      "text": "不少去过的人都说带家人去青海湖比较推荐。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 134400,
      "end_ms": 135800,
      "text": "七八月份那会儿，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 135800,
      "end_ms": 137440,
      "text": "环湖的油菜花全开，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 137540,
      "end_ms": 139660,
      "text": "金黄色的花田从脚底下，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 139860,
      "end_ms": 141020,
      "text": "一直铺到湖边，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 141920,
      "end_ms": 144440,
      "text": "花田尽头就是蓝色的湖水，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 145200,
      "end_ms": 146900,
      "text": "湖水上面是雪山，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 148000,
      "end_ms": 149080,
      "text": "黄蓝白。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 150190,
      "end_ms": 150430,
      "text": "唉，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 150450,
      "end_ms": 153150,
      "text": "三种颜色从近到远排开，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 153550,
      "end_ms": 155430,
      "text": "中间没有一根电线杆，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 155770,
      "end_ms": 157230,
      "text": "没有一栋楼挡着，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 157970,
      "end_ms": 158850,
      "text": "干干净净，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 158850,
      "end_ms": 160050,
      "text": "就是三条色带。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 160850,
      "end_ms": 163510,
      "text": "为什么说青海湖适合带家人？"
    },
    {
      "segment_id": "s000066",
      "start_ms": 164050,
      "end_ms": 165310,
      "text": "因为他不用爬山，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 166090,
      "end_ms": 167170,
      "text": "不用走台阶，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 167650,
      "end_ms": 168490,
      "text": "不用排队，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 169010,
      "end_ms": 170690,
      "text": "环湖公路是平的，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 171070,
      "end_ms": 172730,
      "text": "开着车走走停停，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 173030,
      "end_ms": 174510,
      "text": "哪好看就停下来。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 174890,
      "end_ms": 176790,
      "text": "老人小孩下车就能看，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 176950,
      "end_ms": 179245,
      "text": "湖边有大片的草地，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 179820,
      "end_ms": 180540,
      "text": "铺张毯子，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 180540,
      "end_ms": 181960,
      "text": "坐下来什么都不干，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 182500,
      "end_ms": 184120,
      "text": "光看着那个蓝色发呆，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 184260,
      "end_ms": 185800,
      "text": "一坐就是一下午，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 186500,
      "end_ms": 189320,
      "text": "很多景点是要费力气去征服的，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 189560,
      "end_ms": 190700,
      "text": "青海湖不用，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 191060,
      "end_ms": 192380,
      "text": "他就在那等着你，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 192700,
      "end_ms": 193920,
      "text": "平平整整的，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 194040,
      "end_ms": 194820,
      "text": "谁都能看，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 195060,
      "end_ms": 196020,
      "text": "谁都走得到。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 196380,
      "end_ms": 198240,
      "text": "带着腿脚不太好的爸妈，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 198560,
      "end_ms": 201580,
      "text": "带着跑不动的小孩往湖边一坐，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 202120,
      "end_ms": 202900,
      "text": "风一吹，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 203360,
      "end_ms": 204520,
      "text": "什么都看见了，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 205280,
      "end_ms": 206920,
      "text": "就冲这份不费劲，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 207640,
      "end_ms": 211240,
      "text": "他值得排第十第九名，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 211400,
      "end_ms": 212540,
      "text": "凤凰古城，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 212980,
      "end_ms": 220880,
      "text": "湖南湘西凤凰古城沈从文先生的老家就是写边城那位凤凰古城。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 220880,
      "end_ms": 222000,
      "text": "好看不是好看，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 222060,
      "end_ms": 223740,
      "text": "在白天是好看。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 223800,
      "end_ms": 227560,
      "text": "在傍晚太阳快落山的时候，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 227900,
      "end_ms": 230440,
      "text": "沱江的水变成一种暗金色，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 231040,
      "end_ms": 233180,
      "text": "两岸的吊脚楼亮起灯来，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 233500,
      "end_ms": 235400,
      "text": "灯光倒映在水面上。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 235580,
      "end_ms": 240865,
      "text": "一晃一晃的您带着家里人沿着江边的石板路漫慢走，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 241320,
      "end_ms": 242940,
      "text": "脚底下是老被人踩了，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 242940,
      "end_ms": 244695,
      "text": "不知道多少年的青是吧？"
    },
    {
      "segment_id": "s000101",
      "start_ms": 245030,
      "end_ms": 247170,
      "text": "旁边是一家挨一家的小店，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 247310,
      "end_ms": 249780,
      "text": "卖姜糖的、卖银饰的，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 249860,
      "end_ms": 250875,
      "text": "卖腊肉的，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 251400,
      "end_ms": 252940,
      "text": "空气里一会儿是甜的。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 252940,
      "end_ms": 253885,
      "text": "一会儿是咸的，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 254650,
      "end_ms": 255325,
      "text": "走累了，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 255510,
      "end_ms": 257030,
      "text": "就在江边找个馆子，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 257030,
      "end_ms": 260565,
      "text": "坐下来点一条沱江里的小鱼，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 261060,
      "end_ms": 263280,
      "text": "一碗酸汤一盘血，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 263340,
      "end_ms": 265610,
      "text": "把鸭花不了多少钱，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 265630,
      "end_ms": 267700,
      "text": "一桌菜吃着饭，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 267720,
      "end_ms": 270100,
      "text": "看着江上的乌篷船慢慢划过去，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 270540,
      "end_ms": 271445,
      "text": "凤凰不大。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 272420,
      "end_ms": 274255,
      "text": "据当地旅游资料介绍，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 274800,
      "end_ms": 277935,
      "text": "古城核心区走一圈也就两三公里，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 278870,
      "end_ms": 279870,
      "text": "可就这么巴掌，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 279870,
      "end_ms": 283550,
      "text": "大一个地方走哪儿都是弯弯绕绕的巷子，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 283610,
      "end_ms": 287005,
      "text": "走哪都有人坐在门口播花生聊天，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 287720,
      "end_ms": 289315,
      "text": "不敢路不打卡，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 290060,
      "end_ms": 291155,
      "text": "一家人慢慢逛，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 291470,
      "end_ms": 292810,
      "text": "饿了就吃累了，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 292810,
      "end_ms": 294845,
      "text": "就做天黑了看灯，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 295160,
      "end_ms": 296615,
      "text": "这才叫代家人出来。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 297110,
      "end_ms": 299690,
      "text": "沈从文先生写凤凰写了一辈子，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 300430,
      "end_ms": 302570,
      "text": "他常说自己就是个乡下人，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 303270,
      "end_ms": 305430,
      "text": "您带着家里人去凤凰走一趟，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 305430,
      "end_ms": 306590,
      "text": "就明白这句话了。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 306590,
      "end_ms": 308730,
      "text": "那个地方不让您觉得自己在旅游，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 309090,
      "end_ms": 311470,
      "text": "让您觉得自己在过日子。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 312430,
      "end_ms": 313210,
      "text": "第八名，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 313630,
      "end_ms": 314890,
      "text": "黄果树瀑布，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 315230,
      "end_ms": 317230,
      "text": "贵州安顺黄果树瀑布，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 317570,
      "end_ms": 319090,
      "text": "中国人说起瀑布来，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 319090,
      "end_ms": 321350,
      "text": "大多数人第一个想到的就是它。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 322010,
      "end_ms": 326310,
      "text": "黄果树瀑布据实测数据高将近七十八米，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 326840,
      "end_ms": 327960,
      "text": "宽超过一百米，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 328460,
      "end_ms": 332520,
      "text": "一百米宽的水帘从七十八米高的地方直直砸下来。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 332520,
      "end_ms": 333300,
      "text": "是什么感觉？"
    },
    {
      "segment_id": "s000139",
      "start_ms": 334300,
      "end_ms": 335860,
      "text": "您还没走到跟前，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 336900,
      "end_ms": 338980,
      "text": "先听见了轰隆隆的声音，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 339000,
      "end_ms": 341140,
      "text": "像打雷越走越响。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 341620,
      "end_ms": 343400,
      "text": "等走到观埔台的时候，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 343760,
      "end_ms": 348920,
      "text": "水砸到底下溅起来的雾气直接扑到脸上几分钟，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 348960,
      "end_ms": 349880,
      "text": "衣服就潮了。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 349900,
      "end_ms": 351720,
      "text": "黄果树为什么适合带家人？"
    },
    {
      "segment_id": "s000146",
      "start_ms": 352320,
      "end_ms": 353980,
      "text": "因为他是中国少有的，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 353980,
      "end_ms": 355740,
      "text": "不用受罪就能看到的。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 355740,
      "end_ms": 358805,
      "text": "大瀑布景区里面有扶梯，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 359350,
      "end_ms": 361455,
      "text": "有栈道、有观光车，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 362290,
      "end_ms": 363870,
      "text": "从入口到瀑布跟前，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 363870,
      "end_ms": 365365,
      "text": "基本不用爬什么台阶。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 365800,
      "end_ms": 367560,
      "text": "老人坐着观光车到了，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 367560,
      "end_ms": 368920,
      "text": "观瀑台下来，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 368920,
      "end_ms": 369825,
      "text": "站两分钟，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 370180,
      "end_ms": 371985,
      "text": "瀑布的水雾扑一脸，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 372620,
      "end_ms": 374145,
      "text": "那个冲击力够记一辈子，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 375050,
      "end_ms": 377070,
      "text": "走得动的还可以进水帘洞。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 377090,
      "end_ms": 379415,
      "text": "瀑布后面有一条天然的溶洞，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 379840,
      "end_ms": 381165,
      "text": "从洞里往外看，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 381620,
      "end_ms": 383280,
      "text": "水帘就挂在眼前，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 383500,
      "end_ms": 385065,
      "text": "伸手就能碰到水，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 385490,
      "end_ms": 388825,
      "text": "很多大瀑布要么在深山里进去费劲，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 389250,
      "end_ms": 390170,
      "text": "要么到了跟前，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 390190,
      "end_ms": 392870,
      "text": "只能远远看着黄果树，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 392870,
      "end_ms": 395130,
      "text": "是真的把您送到瀑布面前，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 395130,
      "end_ms": 396645,
      "text": "让您摸到水的那种。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 397240,
      "end_ms": 398960,
      "text": "带着一家人站在水屋里面，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 398960,
      "end_ms": 400115,
      "text": "头发全湿了，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 400600,
      "end_ms": 401720,
      "text": "小孩在那儿笑，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 402140,
      "end_ms": 403435,
      "text": "老人在那儿夺水，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 404250,
      "end_ms": 409595,
      "text": "这个画面比拍一百张照片都值第七名。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 411550,
      "end_ms": 416405,
      "text": "西安、陕西西安历史上公认的千年古都，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 417220,
      "end_ms": 423900,
      "text": "大家耳熟能详的景朝代周秦汉唐都在这儿建过都西安，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 423920,
      "end_ms": 424800,
      "text": "适合带家人。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 424800,
      "end_ms": 425060,
      "text": "不是，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 425060,
      "end_ms": 426120,
      "text": "因为他有多好看，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 426520,
      "end_ms": 429820,
      "text": "是因为它能让一家人找到共同话题，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 430560,
      "end_ms": 433060,
      "text": "带孩子去看兵马俑课本。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 433060,
      "end_ms": 435260,
      "text": "上学过的东西突然立在眼前了，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 435800,
      "end_ms": 437780,
      "text": "一个个跟真人一样大，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 438380,
      "end_ms": 440060,
      "text": "脸上的表情都不一样。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 440720,
      "end_ms": 441860,
      "text": "小孩蹲在那看，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 441860,
      "end_ms": 442800,
      "text": "半天不起来，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 443560,
      "end_ms": 444900,
      "text": "带爸妈上城墙。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 445440,
      "end_ms": 446520,
      "text": "据文献记载，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 446580,
      "end_ms": 449230,
      "text": "西安的城墙始建于明朝，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 450010,
      "end_ms": 451870,
      "text": "周长将近十四公里，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 452570,
      "end_ms": 454030,
      "text": "保存基本完整。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 454130,
      "end_ms": 455570,
      "text": "上面能骑自行车，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 456170,
      "end_ms": 458330,
      "text": "老两口租辆车慢慢骑，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 458830,
      "end_ms": 460430,
      "text": "一边骑一边往下看。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 461230,
      "end_ms": 464550,
      "text": "城墙底下就是老城区的街巷，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 465330,
      "end_ms": 466710,
      "text": "屋顶连着屋顶，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 467370,
      "end_ms": 468270,
      "text": "到了饭点，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 468310,
      "end_ms": 470130,
      "text": "一家人钻进回民街，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 470730,
      "end_ms": 472030,
      "text": "一碗羊肉泡馍，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 472030,
      "end_ms": 472630,
      "text": "掰半天，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 473370,
      "end_ms": 474670,
      "text": "小孩吃肉夹馍，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 475110,
      "end_ms": 476980,
      "text": "老人喝一碗高配酸梅汤，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 477850,
      "end_ms": 482095,
      "text": "吃完了接着逛大雁塔碑林。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 482880,
      "end_ms": 485990,
      "text": "陕西历史博物馆走到哪儿，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 485990,
      "end_ms": 487835,
      "text": "都是课本上念过的名字。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 488200,
      "end_ms": 490615,
      "text": "西安不需要您懂历史，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 491310,
      "end_ms": 493260,
      "text": "他自己会跟您说话，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 493360,
      "end_ms": 495625,
      "text": "带着家人在城墙上骑一圈车，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 496430,
      "end_ms": 498625,
      "text": "在博物馆里看一下午青铜器。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 499200,
      "end_ms": 501585,
      "text": "晚上在回民街吃到走不动道，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 502390,
      "end_ms": 505710,
      "text": "回来以后一家人能聊的东西多了好几个月的量。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 505770,
      "end_ms": 508265,
      "text": "这比去哪个网红景点拍个照管用。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 508750,
      "end_ms": 509370,
      "text": "第六名，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 509510,
      "end_ms": 510255,
      "text": "张家界，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 511390,
      "end_ms": 512645,
      "text": "湖南张家界。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 513400,
      "end_ms": 514865,
      "text": "据地质资料记载，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 515520,
      "end_ms": 518640,
      "text": "三千多根石柱从地里冒出来，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 519300,
      "end_ms": 520985,
      "text": "高的有三百多米，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 521490,
      "end_ms": 523175,
      "text": "每一根都是单独立着，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 523820,
      "end_ms": 525255,
      "text": "上面长满了树，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 525710,
      "end_ms": 528030,
      "text": "像一片从地里长出来的森林。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 528230,
      "end_ms": 529775,
      "text": "张家界好看在哪？"
    },
    {
      "segment_id": "s000220",
      "start_ms": 530130,
      "end_ms": 530590,
      "text": "好看？"
    },
    {
      "segment_id": "s000221",
      "start_ms": 530590,
      "end_ms": 532175,
      "text": "在站在高处往下看，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 532530,
      "end_ms": 535270,
      "text": "可带家人去张家界最怕一件事儿，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 535270,
      "end_ms": 537690,
      "text": "爬山三千多根石柱，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 537750,
      "end_ms": 540985,
      "text": "看着好看可要爬上去看不容易。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 541410,
      "end_ms": 543735,
      "text": "以前的张家界确实不太适合老人，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 544420,
      "end_ms": 545635,
      "text": "可现在不一样，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 546570,
      "end_ms": 548895,
      "text": "景区里有一部摆龙天梯。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 549720,
      "end_ms": 551355,
      "text": "据公开资料介绍，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 552060,
      "end_ms": 556695,
      "text": "这部电梯贴着悬崖修的落差超过三百米，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 556990,
      "end_ms": 557850,
      "text": "一分多钟，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 558070,
      "end_ms": 560085,
      "text": "从山脚直接升到山顶，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 560940,
      "end_ms": 563400,
      "text": "老人小孩一步台阶不用爬，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 563520,
      "end_ms": 565500,
      "text": "电梯门一开三千根，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 565520,
      "end_ms": 567025,
      "text": "石柱就在眼前了，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 568150,
      "end_ms": 570545,
      "text": "站在山顶的观景台上往下看，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 571320,
      "end_ms": 572780,
      "text": "石柱群从脚底下，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 572780,
      "end_ms": 573975,
      "text": "一直排到天边，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 574750,
      "end_ms": 580920,
      "text": "每一根之间隔着深谷谷底是白色的云雾起雾的时候，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 580920,
      "end_ms": 583345,
      "text": "石柱的上半截露在云上面，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 584110,
      "end_ms": 585995,
      "text": "下半截埋在云里面，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 586550,
      "end_ms": 590254,
      "text": "像是从棉花堆里长出来的一根根柱子，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 590710,
      "end_ms": 593005,
      "text": "张家界还有一座玻璃桥。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 593620,
      "end_ms": 594425,
      "text": "据介绍。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 594810,
      "end_ms": 596910,
      "text": "桥面长超过四百米，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 597290,
      "end_ms": 598890,
      "text": "悬在峡谷上空，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 599290,
      "end_ms": 600850,
      "text": "桥面是透明的，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 600850,
      "end_ms": 601890,
      "text": "往脚底下看，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 601910,
      "end_ms": 605050,
      "text": "就是深谷胆子大的走到桥中间，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 605230,
      "end_ms": 607690,
      "text": "胆子小的在桥头看一眼就够了。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 608550,
      "end_ms": 609670,
      "text": "不管敢不敢走，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 609850,
      "end_ms": 611050,
      "text": "一家人站在桥头，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 611050,
      "end_ms": 612190,
      "text": "那个表情就够那，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 612190,
      "end_ms": 613990,
      "text": "一路三千多根。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 613990,
      "end_ms": 618870,
      "text": "石柱不用爬山就能看不部电梯解决了腿脚的问题，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 619310,
      "end_ms": 621570,
      "text": "带着一家人站在山顶上，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 621890,
      "end_ms": 626220,
      "text": "三百六十度全是石柱和云海一起看一次。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 626220,
      "end_ms": 629980,
      "text": "这辈子忘不了先在评论区打出四个字，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 630160,
      "end_ms": 633740,
      "text": "带上家人打完了咱们接着讲前五名，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 633880,
      "end_ms": 635540,
      "text": "一个比一个让人心里发热。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 637220,
      "end_ms": 641660,
      "text": "今天讲的这五个您品品青海湖铺一张毯子，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 641660,
      "end_ms": 642540,
      "text": "往湖边一坐，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 642560,
      "end_ms": 643560,
      "text": "谁都不用费劲。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 644400,
      "end_ms": 647800,
      "text": "凤凰古城一家人在江边吃着小鱼看着乌篷船，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 647800,
      "end_ms": 648640,
      "text": "觉得不是旅游，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 648640,
      "end_ms": 650880,
      "text": "是过日子黄果树瀑布，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 650880,
      "end_ms": 652180,
      "text": "不用爬一记台阶，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 652180,
      "end_ms": 654185,
      "text": "就把您送到水帘洞跟前，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 654930,
      "end_ms": 656250,
      "text": "西安让一家人回来。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 656250,
      "end_ms": 657975,
      "text": "能多聊好几个月的话题，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 658650,
      "end_ms": 660110,
      "text": "张家界一部电梯，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 660130,
      "end_ms": 663035,
      "text": "直接把三千根石柱送到您眼前。"
    },
    {
      "segment_id": "s000272",
      "start_ms": 663650,
      "end_ms": 668625,
      "text": "可这五个加一块都比不过前五名里那个让人心里一紧的地方。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 669220,
      "end_ms": 671095,
      "text": "前五名里有一座岛，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 671370,
      "end_ms": 673270,
      "text": "带着家里人坐在沙滩上看，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 673270,
      "end_ms": 674070,
      "text": "日落的时候，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 674230,
      "end_ms": 676230,
      "text": "风是咸的浪声，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 676310,
      "end_ms": 678545,
      "text": "刚好能把手机里的消息盖住。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 679180,
      "end_ms": 681100,
      "text": "有一个地方带老人进去以后，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 681380,
      "end_ms": 683515,
      "text": "走着走着说话声自己就小了。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 683940,
      "end_ms": 684540,
      "text": "出来以后，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 684540,
      "end_ms": 686135,
      "text": "老人的眼眶是红的，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 686550,
      "end_ms": 687370,
      "text": "还有一个地方，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 687410,
      "end_ms": 689965,
      "text": "墙上的颜色正在一天一天的褪。"
    },
    {
      "segment_id": "s000284",
      "start_ms": 690430,
      "end_ms": 691875,
      "text": "据研究人员监测，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 692750,
      "end_ms": 693710,
      "text": "再过几十年，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 693710,
      "end_ms": 695730,
      "text": "有些画面可能就彻底看不清了。"
    },
    {
      "segment_id": "s000287",
      "start_ms": 695730,
      "end_ms": 697050,
      "text": "再不带家人去看一眼，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 697050,
      "end_ms": 698115,
      "text": "真的就没了。"
    },
    {
      "segment_id": "s000289",
      "start_ms": 699520,
      "end_ms": 703670,
      "text": "下一集已经同步更新了点，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 703690,
      "end_ms": 706735,
      "text": "我头像进主页第一条，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 707250,
      "end_ms": 711275,
      "text": "就是咱们接着接前五名。"
    }
  ],
  "source_transcript_sha256": "9842c6edb3bee907022e5922076bce5a37a0fc4b569afc9a61788b6451788583"
}