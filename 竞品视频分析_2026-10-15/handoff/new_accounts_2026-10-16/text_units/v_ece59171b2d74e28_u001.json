{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ece59171b2d74e28_u001",
  "video_id": "v_ece59171b2d74e28",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 655.477007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 430,
      "end_ms": 3090,
      "text": "十一分钟讲解哈耶克通往奴役之路，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3330,
      "end_ms": 9570,
      "text": "今天和大家一起深读哈耶克通往奴役之路的第十四章、物质条件和理想目标。"
    },
    {
      "segment_id": "s000003",
      "start_ms": 9690,
      "end_ms": 14950,
      "text": "这本书是哈耶克在一九四四年二战硝烟尚未散尽时写就的警示之作，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 15130,
      "end_ms": 19810,
      "text": "是他对当时弥漫于整个西方世界的计划经济崇拜的系统性批判。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 19890,
      "end_ms": 24910,
      "text": "这一章可以说是全书从经济分析转向道德哲学的关键一章。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 25130,
      "end_ms": 28570,
      "text": "他要回答一个让无数现代人感到困惑的终极问题。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 29010,
      "end_ms": 32780,
      "text": "当我们为了理想目标而放弃对经济力量的服从时，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 32920,
      "end_ms": 34340,
      "text": "我们到底在放弃什么？"
    },
    {
      "segment_id": "s000009",
      "start_ms": 34440,
      "end_ms": 37280,
      "text": "当我们以为自己在奔向更高的道德境界时，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 37480,
      "end_ms": 38700,
      "text": "为什么哈耶克却说，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 38960,
      "end_ms": 41280,
      "text": "这条路通向的恰恰是奴役？"
    },
    {
      "segment_id": "s000012",
      "start_ms": 41360,
      "end_ms": 43080,
      "text": "先看哈耶克开篇的立场，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 43620,
      "end_ms": 45760,
      "text": "把没有用任何模棱两可的措辞，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 46120,
      "end_ms": 48760,
      "text": "而是引用米尔顿的话作为这一章的题眼，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 48840,
      "end_ms": 53840,
      "text": "把那个被无数理想主义者当做天经地义的信念直接翻转了过来。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 53960,
      "end_ms": 56840,
      "text": "自由社会绝不能从属于某个单一目的。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 57360,
      "end_ms": 58820,
      "text": "这条规则的唯一例外，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 58820,
      "end_ms": 61230,
      "text": "就是战争和其他暂时性的灾难。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 61250,
      "end_ms": 62330,
      "text": "那时差不多，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 62330,
      "end_ms": 65095,
      "text": "任何事情都得服从眼前的迫切需要。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 65610,
      "end_ms": 67710,
      "text": "这就是我们为了从长远起见，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 67750,
      "end_ms": 70095,
      "text": "维护我们的自由所应付的代价。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 70450,
      "end_ms": 73250,
      "text": "这句话在今天听来依然振聋发聩，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 73490,
      "end_ms": 75025,
      "text": "甚至有些政治不正确。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 75300,
      "end_ms": 77035,
      "text": "我们从小被灌输的观念是什么？"
    },
    {
      "segment_id": "s000026",
      "start_ms": 77490,
      "end_ms": 78690,
      "text": "是为了崇高的目标，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 78950,
      "end_ms": 80385,
      "text": "个人应该服从集体，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 80650,
      "end_ms": 81690,
      "text": "是为了更大的善。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 81930,
      "end_ms": 83385,
      "text": "暂时的牺牲是必要的，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 83810,
      "end_ms": 86070,
      "text": "是为了理想的实现经济考量，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 86090,
      "end_ms": 88445,
      "text": "不应该成为阻碍这种信念。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 88720,
      "end_ms": 91035,
      "text": "从柏拉图理想国中的哲人王开始，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 91320,
      "end_ms": 92840,
      "text": "已经弥漫了两千多年。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 92940,
      "end_ms": 94245,
      "text": "但哈耶克告诉我们，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 94580,
      "end_ms": 97460,
      "text": "正是这种为了理想可以不计代价的态度，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 97680,
      "end_ms": 99940,
      "text": "恰恰是通往奴役之路的起点。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 100060,
      "end_ms": 100655,
      "text": "他写道，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 101220,
      "end_ms": 106100,
      "text": "我们这一代人绝不愿意为所谓的经济理由而牺牲自己的任何要求，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 106300,
      "end_ms": 110140,
      "text": "不能忍耐和容忍加在我们眼前目标之上的一切束缚，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 110240,
      "end_ms": 116265,
      "text": "并且拒绝承认任何障碍、任何可能有碍欲望之满足的与其他目标的冲突。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 116570,
      "end_ms": 118545,
      "text": "这就像你走进一座巨大的城市，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 118900,
      "end_ms": 120260,
      "text": "看到琳琅满目的商品，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 120440,
      "end_ms": 121615,
      "text": "熙熙攘攘的商业，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 121900,
      "end_ms": 123175,
      "text": "形形色色的选择，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 123800,
      "end_ms": 125000,
      "text": "你感到物欲横流，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 125220,
      "end_ms": 126000,
      "text": "人心不古。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 126000,
      "end_ms": 126575,
      "text": "你心想，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 126970,
      "end_ms": 129010,
      "text": "要是能回到那个朴素纯粹的时代，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 129010,
      "end_ms": 129665,
      "text": "该多好。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 130140,
      "end_ms": 131380,
      "text": "人人不为物质所累，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 131520,
      "end_ms": 133165,
      "text": "一心追求高尚的理想。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 133450,
      "end_ms": 134490,
      "text": "但突然在某个路口，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 134690,
      "end_ms": 135970,
      "text": "你停下来问了一句，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 136110,
      "end_ms": 136455,
      "text": "等等。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 136870,
      "end_ms": 139015,
      "text": "如果消灭了这些庸俗的经济活动，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 139290,
      "end_ms": 145205,
      "text": "那些我享受的便利、干净的饮水、可靠的药品、温暖的住所、便捷的通讯，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 145480,
      "end_ms": 149785,
      "text": "哪一样不是由这些低俗的经济活动创造和维持的这一问，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 150240,
      "end_ms": 152985,
      "text": "所有那些超越经济考量的浪漫想象，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 153310,
      "end_ms": 154910,
      "text": "瞬间都可能失去根基。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 155090,
      "end_ms": 158400,
      "text": "哈耶克的第十四章就是引导我们问出这一声。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 158560,
      "end_ms": 162735,
      "text": "哈耶克首先精准的指出了理想主义者最致命的思维误区。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 163250,
      "end_ms": 166825,
      "text": "他们把经济看作一种低级的、应该被超越的东西，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 167150,
      "end_ms": 169230,
      "text": "把理想看作一种高级的，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 169230,
      "end_ms": 171125,
      "text": "值得为之牺牲一切的东西。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 171370,
      "end_ms": 172145,
      "text": "按照这个逻辑，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 172430,
      "end_ms": 173530,
      "text": "为了伟大的目标，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 173730,
      "end_ms": 175250,
      "text": "一切代价都是值得的。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 175250,
      "end_ms": 176710,
      "text": "这个推理听起来很崇高，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 176730,
      "end_ms": 177215,
      "text": "对吧？"
    },
    {
      "segment_id": "s000070",
      "start_ms": 177620,
      "end_ms": 178895,
      "text": "但他的前提错了，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 179280,
      "end_ms": 179945,
      "text": "错在哪里？"
    },
    {
      "segment_id": "s000072",
      "start_ms": 180280,
      "end_ms": 184805,
      "text": "错在他假定理想目标可以脱离物质条件而独立存在。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 185190,
      "end_ms": 185975,
      "text": "哈杰克指出，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 186350,
      "end_ms": 188170,
      "text": "那些受到越来越少的尊重，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 188330,
      "end_ms": 190250,
      "text": "因而就变得更少见的美德，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 190570,
      "end_ms": 195450,
      "text": "恰恰是英国人理应引以为自豪的独立和自力更生。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 195810,
      "end_ms": 198290,
      "text": "个人的首创性和地方的自我负责，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 198730,
      "end_ms": 200515,
      "text": "成功的依靠、自愿的活动，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 200770,
      "end_ms": 202990,
      "text": "不干涉邻人事物和宽容异端，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 203330,
      "end_ms": 205245,
      "text": "尊重风俗习惯和传统，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 205530,
      "end_ms": 208050,
      "text": "以及对权力和权威的适度怀疑。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 208170,
      "end_ms": 209110,
      "text": "这句话怎么理解？"
    },
    {
      "segment_id": "s000083",
      "start_ms": 209330,
      "end_ms": 210285,
      "text": "杀伤力在哪儿？"
    },
    {
      "segment_id": "s000084",
      "start_ms": 210560,
      "end_ms": 215075,
      "text": "我们最大的思维误区之一就是把物质条件和理想目标对立起来，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 215410,
      "end_ms": 216830,
      "text": "仿佛前者是低级的，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 216910,
      "end_ms": 218035,
      "text": "后者是高级的，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 218240,
      "end_ms": 219100,
      "text": "前者是手段，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 219200,
      "end_ms": 220165,
      "text": "后者是目的，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 220500,
      "end_ms": 223445,
      "text": "但我们恰恰忘记了没有物质条件的支撑，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 223790,
      "end_ms": 226375,
      "text": "任何理想目标都不过是空中楼阁。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 227090,
      "end_ms": 228410,
      "text": "一个人口稀少的部落，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 228570,
      "end_ms": 229610,
      "text": "每个人都是通财，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 229930,
      "end_ms": 230610,
      "text": "既要打猎，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 230690,
      "end_ms": 231430,
      "text": "又要采集，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 231670,
      "end_ms": 232450,
      "text": "还要生火。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 232470,
      "end_ms": 233075,
      "text": "缝衣。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 233480,
      "end_ms": 234535,
      "text": "每个人都会一点儿，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 234680,
      "end_ms": 235495,
      "text": "但什么都不精。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 236130,
      "end_ms": 237990,
      "text": "但一个分工发达的现代社会，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 238230,
      "end_ms": 242295,
      "text": "出现了一个医生、一个教师、一个程序员、一个厨师。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 242830,
      "end_ms": 244230,
      "text": "这些职业之所以存在，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 244470,
      "end_ms": 247250,
      "text": "恰恰是因为物质条件的丰富提供了可能。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 247450,
      "end_ms": 249835,
      "text": "哈耶克在这里点出了一个深刻的悖论，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 250340,
      "end_ms": 252320,
      "text": "那些最珍视理想目标的人，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 252440,
      "end_ms": 256000,
      "text": "往往最热衷于摧毁产生这些理想的物质条件。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 256120,
      "end_ms": 258345,
      "text": "他们以为自己在追求更高的道德，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 258670,
      "end_ms": 261590,
      "text": "实际上却在摧毁道德赖以存在的根基。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 261810,
      "end_ms": 264850,
      "text": "哈耶克进一步把这一逻辑推向了一个更深的层次。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 264990,
      "end_ms": 265625,
      "text": "他写道，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 266130,
      "end_ms": 268795,
      "text": "道德不仅必定是个人行为的现象，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 269050,
      "end_ms": 271290,
      "text": "而且只能存在于一定范围之内。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 271410,
      "end_ms": 272290,
      "text": "在该范围内，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 272470,
      "end_ms": 274665,
      "text": "个人有为自己做出决定的自由，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 274910,
      "end_ms": 278930,
      "text": "而且被要求自愿牺牲个人利益来遵守一个道德规则。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 279010,
      "end_ms": 280470,
      "text": "在个人负责的范围以外，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 280730,
      "end_ms": 282740,
      "text": "就既没有善也没有恶。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 282820,
      "end_ms": 284040,
      "text": "这里出现了一个关键词，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 284360,
      "end_ms": 289640,
      "text": "个人负责哈耶克对道德的理解与那种集体主义道德的叙事完全不同。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 289840,
      "end_ms": 290505,
      "text": "他写道，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 290970,
      "end_ms": 293370,
      "text": "只有当我们对我们自己的利害关系负责，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 293510,
      "end_ms": 295355,
      "text": "并且有牺牲他们自由时，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 295700,
      "end_ms": 297485,
      "text": "我们的决定才有道德价值。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 297830,
      "end_ms": 302385,
      "text": "我们没有权利以他人的利益为代价来博取自己无私的美名。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 302780,
      "end_ms": 305560,
      "text": "而我们要是在没有选择自由的情况之下，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 305560,
      "end_ms": 306525,
      "text": "做到了无私，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 306870,
      "end_ms": 308725,
      "text": "在道德上也不足以称道。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 309130,
      "end_ms": 310070,
      "text": "这句话什么意思？"
    },
    {
      "segment_id": "s000128",
      "start_ms": 310490,
      "end_ms": 311570,
      "text": "它的核心意思是，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 311910,
      "end_ms": 313610,
      "text": "道德是自由的产物，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 313690,
      "end_ms": 315170,
      "text": "而不是强迫的产物。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 315250,
      "end_ms": 317290,
      "text": "这就像学游泳教练，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 317290,
      "end_ms": 317790,
      "text": "告诉你，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 317850,
      "end_ms": 320250,
      "text": "你要先憋气再蹬腿再滑手。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 320710,
      "end_ms": 322350,
      "text": "这些是可道的知识，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 322770,
      "end_ms": 325690,
      "text": "但你真正学会游泳是在你跳下水之后，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 325870,
      "end_ms": 328030,
      "text": "在无数次呛水和挣扎中，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 328250,
      "end_ms": 330130,
      "text": "身体获得了那份水感。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 330410,
      "end_ms": 331930,
      "text": "那是不可道的体征。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 331930,
      "end_ms": 333890,
      "text": "你读再多的道德哲学理论，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 334090,
      "end_ms": 337370,
      "text": "如果不去理解自由选择对于道德的本质意义，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 337550,
      "end_ms": 338900,
      "text": "那永远是别人的地图。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 339260,
      "end_ms": 341380,
      "text": "土不是你自己的生命领土。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 341380,
      "end_ms": 343300,
      "text": "如果社会成员每做一件好事，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 343300,
      "end_ms": 345200,
      "text": "都是别人使他去做的话，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 345200,
      "end_ms": 347040,
      "text": "他们是没有权利受到赞赏。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 347040,
      "end_ms": 352440,
      "text": "哈耶克这句话是对一切强迫人行善的乌托邦计划最致命的否定。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 352920,
      "end_ms": 353640,
      "text": "讲到这里，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 353740,
      "end_ms": 354480,
      "text": "你可能会问，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 354900,
      "end_ms": 355860,
      "text": "按照这个逻辑，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 356100,
      "end_ms": 356400,
      "text": "自由，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 356400,
      "end_ms": 358540,
      "text": "社会是不是就没有共同目标了？"
    },
    {
      "segment_id": "s000152",
      "start_ms": 358600,
      "end_ms": 360280,
      "text": "人们是不是只能各自为政，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 360280,
      "end_ms": 360920,
      "text": "互不关心？"
    },
    {
      "segment_id": "s000154",
      "start_ms": 361700,
      "end_ms": 363380,
      "text": "哈耶克的智慧正在于此，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 364120,
      "end_ms": 366420,
      "text": "他给出了一个极其审慎的回答。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 366980,
      "end_ms": 370690,
      "text": "这个回答与老子知持不带的智慧异曲同工。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 370770,
      "end_ms": 371070,
      "text": "自由。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 371070,
      "end_ms": 373950,
      "text": "社会中的共同利益概念或公共利益概念，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 374290,
      "end_ms": 378815,
      "text": "绝不可以被定义为应予实现的已知特定结果的总和，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 379280,
      "end_ms": 381740,
      "text": "而只能被定义为一种抽象的秩序。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 381960,
      "end_ms": 382545,
      "text": "换言之，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 382840,
      "end_ms": 384820,
      "text": "哈耶克区分了两种理想目标，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 384860,
      "end_ms": 387845,
      "text": "第一种是抽象秩序中的共同目标，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 388290,
      "end_ms": 391355,
      "text": "它由无数个体在自由选择中自发形成，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 391760,
      "end_ms": 393500,
      "text": "是扩展秩序的自然产物，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 393680,
      "end_ms": 396040,
      "text": "这种目标是文明进步的标志。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 396120,
      "end_ms": 399345,
      "text": "第二种是具体方案中的单一目标，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 399890,
      "end_ms": 402630,
      "text": "他有某个权威机构自上而下的规定，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 402750,
      "end_ms": 405040,
      "text": "要求所有人服从这种目标，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 405340,
      "end_ms": 407220,
      "text": "即使处于最善良的动机，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 407360,
      "end_ms": 408785,
      "text": "也必然走向奴役。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 409700,
      "end_ms": 410275,
      "text": "事实上，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 410600,
      "end_ms": 411860,
      "text": "正是在这一领域里，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 412100,
      "end_ms": 414425,
      "text": "充分就业这类含义模糊的，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 414610,
      "end_ms": 416510,
      "text": "但很吃香的词句的魅力，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 416670,
      "end_ms": 419490,
      "text": "才容易引致极端短见的行为措施。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 419630,
      "end_ms": 421570,
      "text": "并且在头脑简单的理想主义者，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 421570,
      "end_ms": 422970,
      "text": "必须不惜一切代价。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 422970,
      "end_ms": 425985,
      "text": "这种不分好歹不负责任的思想所风行之处，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 426310,
      "end_ms": 428055,
      "text": "很可能造成最大的危害。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 428420,
      "end_ms": 430765,
      "text": "这句话读来令人心惊。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 431150,
      "end_ms": 433810,
      "text": "哈耶克在这里不是在否定充分就业本身，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 433990,
      "end_ms": 436705,
      "text": "他是在陈述一个冷酷的进化论事实。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 437160,
      "end_ms": 440725,
      "text": "那些试图用单一目标取代自发秩序的群体，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 441030,
      "end_ms": 444910,
      "text": "在文明竞争中必然被那些尊重、扩展秩序的群体。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 444910,
      "end_ms": 445595,
      "text": "所取代，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 445940,
      "end_ms": 447565,
      "text": "不是因为前者更道德，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 447850,
      "end_ms": 450495,
      "text": "而是因为前者能养活更复杂的社会。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 451110,
      "end_ms": 453625,
      "text": "哈耶克把境界又提升了一个层次。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 453980,
      "end_ms": 454740,
      "text": "他告诉我们，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 454940,
      "end_ms": 456500,
      "text": "物质条件和理想目标，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 456840,
      "end_ms": 459060,
      "text": "此两者同出而异名，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 459200,
      "end_ms": 461405,
      "text": "他们都源于同一个终极的事实。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 461820,
      "end_ms": 464390,
      "text": "人类文明的进化在过去，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 464590,
      "end_ms": 466330,
      "text": "使文明能够成长壮大的，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 466330,
      "end_ms": 469065,
      "text": "正是人们对市场的非人为力量的服从。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 469530,
      "end_ms": 470390,
      "text": "没有这种服从，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 470610,
      "end_ms": 472175,
      "text": "文明就不可能得到发展。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 472720,
      "end_ms": 474075,
      "text": "正是通过这种服从，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 474430,
      "end_ms": 480625,
      "text": "我们才能够每天协力铸造某种比我们当中的任何人所能充分了解的还要伟大的东西。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 481100,
      "end_ms": 482345,
      "text": "这是一个什么样的过程？"
    },
    {
      "segment_id": "s000202",
      "start_ms": 482690,
      "end_ms": 484525,
      "text": "这是一个自催化的过程，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 485040,
      "end_ms": 487360,
      "text": "文明创造文明秩序，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 487540,
      "end_ms": 489930,
      "text": "扩展秩序就像一条河流，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 490290,
      "end_ms": 491110,
      "text": "水量越大，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 491330,
      "end_ms": 492070,
      "text": "河道越宽，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 492550,
      "end_ms": 493330,
      "text": "河道越宽，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 493590,
      "end_ms": 495310,
      "text": "能容纳的水量就越大。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 495550,
      "end_ms": 496930,
      "text": "这不是一个线性过程。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 497030,
      "end_ms": 498370,
      "text": "这是一个指数过程。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 498530,
      "end_ms": 498910,
      "text": "当然，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 499230,
      "end_ms": 500230,
      "text": "哈耶克也承认，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 500430,
      "end_ms": 502070,
      "text": "这个过程不会一帆风顺，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 502410,
      "end_ms": 504410,
      "text": "拒绝屈从于我们既不了解，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 504470,
      "end_ms": 507410,
      "text": "又不承认其为一个具有睿智的存在物。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 507410,
      "end_ms": 509150,
      "text": "有意识决定的那些力量，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 509430,
      "end_ms": 510930,
      "text": "就是一种不完全的，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 511030,
      "end_ms": 512230,
      "text": "因而也是错误的。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 512230,
      "end_ms": 514590,
      "text": "唯理主义的产物它是不完全的，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 514730,
      "end_ms": 515850,
      "text": "因为他没能理解。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 515930,
      "end_ms": 517410,
      "text": "在一个复杂的社会里，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 517430,
      "end_ms": 519640,
      "text": "若要协调多种多样的个人努力，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 519780,
      "end_ms": 523700,
      "text": "就必须考虑到单个的人不能完全观察到的各种事实。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 523960,
      "end_ms": 526640,
      "text": "这就是哈耶克所说的致命的自负，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 527020,
      "end_ms": 529440,
      "text": "那个不完全的唯理主义的产物。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 529960,
      "end_ms": 536320,
      "text": "而且他也没有看到对于服从那个非人为的和貌似不合理的市场力量的唯一替代选择，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 536520,
      "end_ms": 539800,
      "text": "就是服从另一些人的同样不能控制的，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 539880,
      "end_ms": 541480,
      "text": "因而是专断的权利。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 541800,
      "end_ms": 543860,
      "text": "除非要毁灭这个复杂的社会。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 544000,
      "end_ms": 544580,
      "text": "到这里，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 544700,
      "end_ms": 547400,
      "text": "哈耶克第十四章的核心思想我们就讲完了。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 547700,
      "end_ms": 550990,
      "text": "这一章指出了物质条件是理想的负担。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 551010,
      "end_ms": 552810,
      "text": "这一流行观念的局限性，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 553030,
      "end_ms": 557320,
      "text": "点出了物质条件与理想目标互为因果的辩证关系。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 557540,
      "end_ms": 562920,
      "text": "理想问题无法完全用超越经济考量这种浪漫的修辞来解答，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 563100,
      "end_ms": 566665,
      "text": "而需要一种动态的、进化的、非线性的视野。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 567160,
      "end_ms": 568045,
      "text": "真正的洞见，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 568320,
      "end_ms": 569065,
      "text": "就是认识到，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 569360,
      "end_ms": 571715,
      "text": "人不仅仅是理想的追求者，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 572020,
      "end_ms": 573805,
      "text": "人更是自由的践行者。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 574180,
      "end_ms": 575685,
      "text": "道德不仅仅是目标，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 575980,
      "end_ms": 576300,
      "text": "道德，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 576400,
      "end_ms": 578280,
      "text": "更是选择一个。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 578280,
      "end_ms": 582655,
      "text": "真正理解了哈耶克这一章的人是一个能够双向观看的人。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 583210,
      "end_ms": 587175,
      "text": "他既能看到追逐物质带来的庸俗竞争、焦虑，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 587520,
      "end_ms": 591460,
      "text": "也能看到物质丰富带来的自由选择尊严。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 591660,
      "end_ms": 593715,
      "text": "他既懂得计算理想的代价，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 594000,
      "end_ms": 599735,
      "text": "也懂得敬畏那个亿万人在千万年间形成的不可完全理解的扩展秩序。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 600340,
      "end_ms": 603875,
      "text": "如果你能开始用这个视角看待物质与理想这个问题，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 604280,
      "end_ms": 606920,
      "text": "哪怕只是在你下次抱怨世风日下，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 607080,
      "end_ms": 609295,
      "text": "物欲横流的时候多问一句。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 609540,
      "end_ms": 611780,
      "text": "但如果没有这些庸俗的经济活动，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 611980,
      "end_ms": 614735,
      "text": "我现在享受的这一切自由还有吗？"
    },
    {
      "segment_id": "s000254",
      "start_ms": 615280,
      "end_ms": 618040,
      "text": "你就已经开始触摸到哈耶克思想的核心。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 618240,
      "end_ms": 622075,
      "text": "你就正在叩响那扇名为自由社会的众妙之门。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 622480,
      "end_ms": 628115,
      "text": "下一期我们将深入解读通往奴役之路的第十五章、国际秩序的展望。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 628560,
      "end_ms": 631935,
      "text": "哈耶克将带领我们直面一个更为棘手的问题。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 632310,
      "end_ms": 635295,
      "text": "那些看起来超越国界的国际主义理想，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 635640,
      "end_ms": 639420,
      "text": "为什么在通向奴役的道路上扮演着推波助澜的角色？"
    },
    {
      "segment_id": "s000260",
      "start_ms": 639560,
      "end_ms": 644115,
      "text": "当现代理想主义者幻想用一个世界组织来实现永久和平的时候，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 644420,
      "end_ms": 647785,
      "text": "哈耶克会如何发出冷静而深刻的提醒？"
    },
    {
      "segment_id": "s000262",
      "start_ms": 648320,
      "end_ms": 652064,
      "text": "有些和平恰恰需要分散的权利来守护。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 652440,
      "end_ms": 653080,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 653320,
      "end_ms": 655325,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "abf2f1ff67079acd3c72eee73b10e6d5c77722584814a32be39cca6dfefd108e"
}