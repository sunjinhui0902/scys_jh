{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_76b65d4cc4baa4f7_u001",
  "video_id": "v_76b65d4cc4baa4f7",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 853.961927,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 330,
      "end_ms": 4670,
      "text": "十五分钟讲解维特根斯坦逻辑哲学论有一本书只有七十五页，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4990,
      "end_ms": 7430,
      "text": "全球销量却被译成数十种语言，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7770,
      "end_ms": 9230,
      "text": "被整个二十世纪分析，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9230,
      "end_ms": 10350,
      "text": "哲学奉为圣经。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 10670,
      "end_ms": 13530,
      "text": "他在中文世界的书店里静静躺着封面，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 13530,
      "end_ms": 16090,
      "text": "印着一个你大概率没听过的奥地利人名。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16190,
      "end_ms": 17350,
      "text": "不是因为他太重要，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17590,
      "end_ms": 19030,
      "text": "而是因为他太锋利，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 19310,
      "end_ms": 21790,
      "text": "锋利到能让每一个还相信哲学。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 21790,
      "end_ms": 23430,
      "text": "能告诉你人生意义的人，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23750,
      "end_ms": 27710,
      "text": "发现自己一直在用一把不存在的钥匙开一把不存在的锁。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 28070,
      "end_ms": 30760,
      "text": "这本书叫逻辑哲学论作者，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 30760,
      "end_ms": 32840,
      "text": "路德维希、维特根斯坦出身，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 32840,
      "end_ms": 34920,
      "text": "维也纳最富有的工业家族之一，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 35020,
      "end_ms": 36120,
      "text": "父亲是钢铁巨头，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 36340,
      "end_ms": 39820,
      "text": "家里定期出入的是勃拉姆斯马勒这个级别的音乐家。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 40000,
      "end_ms": 42700,
      "text": "但这个含着金汤匙出生的人干了什么？"
    },
    {
      "segment_id": "s000018",
      "start_ms": 43060,
      "end_ms": 45140,
      "text": "他跑到剑桥跟罗素学逻辑，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 45260,
      "end_ms": 46660,
      "text": "第一次世界大战爆发后，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 46660,
      "end_ms": 47360,
      "text": "主动参军，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 47700,
      "end_ms": 48560,
      "text": "在战壕里，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 48580,
      "end_ms": 51320,
      "text": "在战俘营里写完了这本七十五页的书。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 51660,
      "end_ms": 55380,
      "text": "然后他宣布哲学问题已经被我全部解决了。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 55420,
      "end_ms": 56760,
      "text": "然后他真的走了。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 57040,
      "end_ms": 59040,
      "text": "去奥地利乡下当小学老师，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 59420,
      "end_ms": 59935,
      "text": "在修道，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 60090,
      "end_ms": 62390,
      "text": "愿当园丁去给姐姐设计房子，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 62390,
      "end_ms": 64205,
      "text": "人们宁考把它当成一个疯子，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 64490,
      "end_ms": 66225,
      "text": "也不愿面对一个可怕的真相。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 66700,
      "end_ms": 67945,
      "text": "不是哲学太难，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 68350,
      "end_ms": 70270,
      "text": "是你一直在问错误的问题。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 70410,
      "end_ms": 74545,
      "text": "今天这条文字我会拆出这本书里最颠覆的七个底层认知。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 75140,
      "end_ms": 76080,
      "text": "但我要提前警告，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 76080,
      "end_ms": 77260,
      "text": "你看完后，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 77400,
      "end_ms": 81740,
      "text": "你可能会对自己过去所有的思考人生产生根本性的怀疑。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 81760,
      "end_ms": 83160,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 83280,
      "end_ms": 84460,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 84539,
      "end_ms": 85655,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 85890,
      "end_ms": 87050,
      "text": "那我们开始进入正题。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 87250,
      "end_ms": 90445,
      "text": "第一层颠覆世界不是由东西组成的，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 90680,
      "end_ms": 91905,
      "text": "是由事情组成的。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 92330,
      "end_ms": 94795,
      "text": "你从小被教育世界是物质的，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 95170,
      "end_ms": 95590,
      "text": "物质，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 95590,
      "end_ms": 96550,
      "text": "由原子构成，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 96830,
      "end_ms": 98210,
      "text": "原子由夸克构成。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 98350,
      "end_ms": 99390,
      "text": "你看到一张桌子，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 99470,
      "end_ms": 101470,
      "text": "你告诉自己这是一张桌子，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 101650,
      "end_ms": 102425,
      "text": "一个东西，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 102690,
      "end_ms": 103270,
      "text": "一个名词。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 103490,
      "end_ms": 106654,
      "text": "维特根斯坦开篇第一句话就把这套观念碾碎了。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 107190,
      "end_ms": 110545,
      "text": "他说世界是事实的总和，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 110960,
      "end_ms": 112215,
      "text": "不是事物的总和。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 112730,
      "end_ms": 113245,
      "text": "什么意思？"
    },
    {
      "segment_id": "s000054",
      "start_ms": 113790,
      "end_ms": 116225,
      "text": "你眼前那张桌子不是一个东西，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 116600,
      "end_ms": 117595,
      "text": "它是一个事实。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 118200,
      "end_ms": 119980,
      "text": "木头被切割、被组装，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 120180,
      "end_ms": 121795,
      "text": "被放置在这个房间里，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 122060,
      "end_ms": 123755,
      "text": "此刻承受着你的手臂。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 124280,
      "end_ms": 127715,
      "text": "这一整组事情的发生才是世界的真正单位。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 128200,
      "end_ms": 130395,
      "text": "你把世界理解成东西的堆叠，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 130940,
      "end_ms": 133500,
      "text": "就像把电影理解成屏幕上的像素点，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 133560,
      "end_ms": 134975,
      "text": "你看到了正确的材料，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 135340,
      "end_ms": 137545,
      "text": "却完全错过了正在发生的东西。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 138320,
      "end_ms": 139625,
      "text": "这个区分为什么重要？"
    },
    {
      "segment_id": "s000065",
      "start_ms": 140290,
      "end_ms": 143495,
      "text": "因为它意味着你所追问的人生意义，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 143870,
      "end_ms": 146750,
      "text": "从来不是某个东西可以承载意义，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 146750,
      "end_ms": 148930,
      "text": "不在任何一张桌子、一份工作。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 149110,
      "end_ms": 153215,
      "text": "一段关系的内部意义是一个事实的结构，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 153540,
      "end_ms": 155855,
      "text": "是事情与事情之间的逻辑关系。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 156340,
      "end_ms": 157405,
      "text": "你找错了地方，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 157880,
      "end_ms": 159235,
      "text": "你不是在找一个答案，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 159610,
      "end_ms": 161775,
      "text": "你是在找一种发声的方式。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 162580,
      "end_ms": 163020,
      "text": "第二层，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 163020,
      "end_ms": 165635,
      "text": "颠覆你脑子里的每一个想法，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 165910,
      "end_ms": 167475,
      "text": "本质上都是一张地图，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 167890,
      "end_ms": 169695,
      "text": "而地图不是领土。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 170330,
      "end_ms": 178010,
      "text": "维特根斯坦提出的核心理论叫图像论命题是现实的图像思想是事实的逻辑。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 178010,
      "end_ms": 178585,
      "text": "图像。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 179330,
      "end_ms": 183670,
      "text": "你觉得你的想法是自由的天马行空、无拘无束不，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 184010,
      "end_ms": 185870,
      "text": "你的每一个有意义的想法，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 186050,
      "end_ms": 187395,
      "text": "都在做同一件事，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 187760,
      "end_ms": 190620,
      "text": "为某个可能的事态画一张逻辑地图。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 190820,
      "end_ms": 192005,
      "text": "你想明天会下雨，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 192450,
      "end_ms": 196150,
      "text": "这张地图上画的是明天和下雨两个坐标点的连接。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 196290,
      "end_ms": 199075,
      "text": "你不可能想一个在地图上根本不存在的东西，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 199300,
      "end_ms": 201645,
      "text": "就像你不可能画一个没有形状的图形，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 202040,
      "end_ms": 202885,
      "text": "这不是限制。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 203250,
      "end_ms": 205865,
      "text": "这是你的思想之所以有意义的条件，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 206430,
      "end_ms": 208070,
      "text": "一个没有逻辑结构的想法，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 208270,
      "end_ms": 209550,
      "text": "不是深刻的洞见，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 209770,
      "end_ms": 210815,
      "text": "是一串噪音。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 211250,
      "end_ms": 212925,
      "text": "维特根斯坦说的很清楚，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 213370,
      "end_ms": 214945,
      "text": "只有命题才有意义，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 215430,
      "end_ms": 216890,
      "text": "只有在命题的关联中，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 217110,
      "end_ms": 218730,
      "text": "一个名字才有意味。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 218810,
      "end_ms": 220090,
      "text": "你以为你在思考人生，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 220430,
      "end_ms": 222675,
      "text": "其实你只是在重复几个孤立的词，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 223190,
      "end_ms": 225390,
      "text": "爱意义自由，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 225670,
      "end_ms": 228550,
      "text": "把他们当做有内容的东西来把玩他们。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 228550,
      "end_ms": 229105,
      "text": "不是，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 229870,
      "end_ms": 232185,
      "text": "他们只是地图上还没有连成线的点，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 232890,
      "end_ms": 235110,
      "text": "你从来没有真正走过那张地图。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 235250,
      "end_ms": 238605,
      "text": "第三层颠覆你被语言欺骗了一辈子，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 239110,
      "end_ms": 239810,
      "text": "而欺骗你的，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 239810,
      "end_ms": 240645,
      "text": "不是谎言，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 240940,
      "end_ms": 241580,
      "text": "是语法。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 241620,
      "end_ms": 243105,
      "text": "你相信我这个词，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 243540,
      "end_ms": 244960,
      "text": "你每天说我饿了，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 245000,
      "end_ms": 245740,
      "text": "我累了，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 245740,
      "end_ms": 246800,
      "text": "我觉得他不爱我。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 246820,
      "end_ms": 248460,
      "text": "你以为我只像一个东西，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 248700,
      "end_ms": 250745,
      "text": "一个在你身体里坐着的小人儿，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 250970,
      "end_ms": 251690,
      "text": "一个灵魂，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 251910,
      "end_ms": 252725,
      "text": "一个自我。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 253300,
      "end_ms": 254405,
      "text": "维特根斯坦说，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 254840,
      "end_ms": 256545,
      "text": "你看看语言是怎么工作的，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 257080,
      "end_ms": 260465,
      "text": "我这个词和桌子这个词用法完全不同。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 260780,
      "end_ms": 264600,
      "text": "这张桌子可以指向一个可以被看见被触摸的对象。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 264880,
      "end_ms": 267375,
      "text": "我呢你从来没有看见过我，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 267740,
      "end_ms": 270380,
      "text": "你看见的是手脚一个身体。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 270500,
      "end_ms": 273695,
      "text": "你从来没有在经验中找到那个叫做我的东西，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 274320,
      "end_ms": 275585,
      "text": "他不是被找到的，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 275860,
      "end_ms": 277665,
      "text": "他是被语法制造出来的。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 277850,
      "end_ms": 279210,
      "text": "就像他在下雨了，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 279210,
      "end_ms": 281725,
      "text": "这句话里并不指向任何一个东西。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 282250,
      "end_ms": 284610,
      "text": "下雨了不等于某个东西在下雨。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 284810,
      "end_ms": 289685,
      "text": "同样我觉得疼不等于有一个叫做我的东西正在经历疼。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 290300,
      "end_ms": 292340,
      "text": "你以为你在过一种内在生活，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 292600,
      "end_ms": 295055,
      "text": "其实你只是在按照语言的语法习惯，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 295290,
      "end_ms": 296365,
      "text": "把自己切成两半。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 296820,
      "end_ms": 299055,
      "text": "一个我和一个我的经历，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 299450,
      "end_ms": 300890,
      "text": "这个切割不是真实的，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 301130,
      "end_ms": 302575,
      "text": "是语法的副产品，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 303150,
      "end_ms": 304745,
      "text": "你不是被谎言骗了。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 305350,
      "end_ms": 307410,
      "text": "你是被自己说话的方式骗了。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 307750,
      "end_ms": 310650,
      "text": "第四层颠覆因果关系不存在，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 310970,
      "end_ms": 311910,
      "text": "这不是一个比喻，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 312330,
      "end_ms": 314350,
      "text": "这是一字不差的逻辑结论。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 314370,
      "end_ms": 315970,
      "text": "你相信种瓜得瓜，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 316130,
      "end_ms": 317050,
      "text": "种豆得豆，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 317350,
      "end_ms": 319210,
      "text": "你相信努力就会成功。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 319750,
      "end_ms": 322430,
      "text": "你相信因为所以维特根兹坦说，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 323090,
      "end_ms": 326210,
      "text": "停下来看一下你所谓的因果到底是什么？"
    },
    {
      "segment_id": "s000144",
      "start_ms": 326490,
      "end_ms": 328470,
      "text": "原子事实是彼此独立的。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 328930,
      "end_ms": 331050,
      "text": "从一个原子事实的存在与否，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 331230,
      "end_ms": 333750,
      "text": "推论不出另一个原子事实是否存在。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 334010,
      "end_ms": 336940,
      "text": "这意味着在世界的基本构成层面上，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 337080,
      "end_ms": 339880,
      "text": "没有任何东西迫使另一个东西发生。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 340000,
      "end_ms": 343640,
      "text": "你看到的a导致b永远只是a发生了，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 343820,
      "end_ms": 345860,
      "text": "然后b发生了顺序，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 346120,
      "end_ms": 346940,
      "text": "仅此而已，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 347520,
      "end_ms": 350060,
      "text": "没有任何逻辑力量把两者绑在一起。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 350320,
      "end_ms": 351960,
      "text": "你问那科学定律呢？"
    },
    {
      "segment_id": "s000154",
      "start_ms": 352300,
      "end_ms": 353280,
      "text": "物理定律呢？"
    },
    {
      "segment_id": "s000155",
      "start_ms": 353460,
      "end_ms": 355920,
      "text": "维特根斯坦的回答会让物理学家发抖。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 356240,
      "end_ms": 358420,
      "text": "科学定律不是对世界的描述，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 358820,
      "end_ms": 361180,
      "text": "是对描述世界的方式的规定。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 361640,
      "end_ms": 362980,
      "text": "它是一张许可地图，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 363600,
      "end_ms": 365850,
      "text": "告诉你哪些命题可以你写上去，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 366050,
      "end_ms": 367035,
      "text": "哪些不可以。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 367670,
      "end_ms": 369305,
      "text": "它不是世界本身的结构，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 369550,
      "end_ms": 372115,
      "text": "是你用来组织事实的语法规则。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 372680,
      "end_ms": 375640,
      "text": "所以当你问为什么我这么努力却还是失败？"
    },
    {
      "segment_id": "s000164",
      "start_ms": 375840,
      "end_ms": 377655,
      "text": "你不是在问一个世界的问题，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 377940,
      "end_ms": 379625,
      "text": "你是在问一个语法的问题，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 380390,
      "end_ms": 381110,
      "text": "你在要求一个，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 381110,
      "end_ms": 383765,
      "text": "因为但因为只是一个连接词，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 384120,
      "end_ms": 385715,
      "text": "不是世界中的一个环节。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 386040,
      "end_ms": 387425,
      "text": "世界不说因为所以，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 388030,
      "end_ms": 389650,
      "text": "世界只是发生第五层，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 389650,
      "end_ms": 391820,
      "text": "颠覆你的所有价值判断，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 392040,
      "end_ms": 395855,
      "text": "善与恶、美与丑、人生的意义都是无意义的，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 396030,
      "end_ms": 396835,
      "text": "不是错的，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 397120,
      "end_ms": 398440,
      "text": "不是有待商榷的，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 398540,
      "end_ms": 401955,
      "text": "是无意义的这句话听起来像虚无主义，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 402180,
      "end_ms": 403955,
      "text": "但维特根斯坦说的恰恰相反。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 404250,
      "end_ms": 404650,
      "text": "他说，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 405360,
      "end_ms": 410055,
      "text": "伦理学的命题、美学的命题、宗教的命题都是无意义的，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 410640,
      "end_ms": 413145,
      "text": "因为他们试图表达超越世界的东西。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 413500,
      "end_ms": 414720,
      "text": "善不在世界中，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 415040,
      "end_ms": 417285,
      "text": "你找不到一个善的原子事实，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 417560,
      "end_ms": 419140,
      "text": "你找不到一个美的例子，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 419220,
      "end_ms": 421765,
      "text": "你找不到一个叫做人生意义的事态，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 422070,
      "end_ms": 423785,
      "text": "可以用命题去描述它。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 424010,
      "end_ms": 425175,
      "text": "他们不是不真实，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 425520,
      "end_ms": 427495,
      "text": "他们是不在可说之域内。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 427920,
      "end_ms": 430480,
      "text": "但注意维特根斯坦接着说了一句，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 430480,
      "end_ms": 433465,
      "text": "让所有逻辑实证主义者都坐立不安的话，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 434020,
      "end_ms": 435715,
      "text": "世界是由事实决定的。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 435960,
      "end_ms": 438620,
      "text": "但人生问题根本不触及这些事实，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 438780,
      "end_ms": 441425,
      "text": "即使一切可能的科学问题都得到解答。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 441740,
      "end_ms": 444395,
      "text": "人生问题依然完全没有被触及，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 444680,
      "end_ms": 445445,
      "text": "这意味着什么？"
    },
    {
      "segment_id": "s000194",
      "start_ms": 445780,
      "end_ms": 448275,
      "text": "意味着你一直在错误的地方寻找意义。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 449040,
      "end_ms": 450880,
      "text": "你试图用科学回答人生，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 451160,
      "end_ms": 452720,
      "text": "用逻辑论证道德，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 452900,
      "end_ms": 454645,
      "text": "用事实推导价值。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 454900,
      "end_ms": 458555,
      "text": "这就像你试图用一张地图导航到一个不在地图上的地方，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 458970,
      "end_ms": 460890,
      "text": "人生意义不在世界的内部，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 460950,
      "end_ms": 462425,
      "text": "它不在事实之中。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 462780,
      "end_ms": 464125,
      "text": "他在世界的边界上，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 464340,
      "end_ms": 467195,
      "text": "那个边界本身才是意义出没的地方。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 467930,
      "end_ms": 469410,
      "text": "你不能说他是什么，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 469490,
      "end_ms": 472180,
      "text": "你只能感到他第六层颠覆你，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 472180,
      "end_ms": 473485,
      "text": "不是世界的观察者，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 473750,
      "end_ms": 475185,
      "text": "你是世界的一个界限，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 475440,
      "end_ms": 478320,
      "text": "而界限本身不属于他划定的领域。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 478400,
      "end_ms": 482445,
      "text": "维特根斯坦在书中说出了一句让整个哲学史颤抖的话，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 482960,
      "end_ms": 485175,
      "text": "世界的界限就是语言的界限。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 485600,
      "end_ms": 488420,
      "text": "你一直以为你在世界之中看着世界，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 488580,
      "end_ms": 489445,
      "text": "思考世界，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 489960,
      "end_ms": 492130,
      "text": "维特根斯坦说错了，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 492540,
      "end_ms": 495455,
      "text": "你不在世界中你是世界的界限。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 495680,
      "end_ms": 496675,
      "text": "想想你的眼睛，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 497340,
      "end_ms": 499755,
      "text": "你能看见房间里的一切桌子，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 500020,
      "end_ms": 501465,
      "text": "意字窗外的树，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 501890,
      "end_ms": 503325,
      "text": "你能看见你的眼睛吗？"
    },
    {
      "segment_id": "s000218",
      "start_ms": 503830,
      "end_ms": 505410,
      "text": "你不能你的眼睛，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 505470,
      "end_ms": 509215,
      "text": "就是那个看见本身他就是视野的边界。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 509720,
      "end_ms": 511460,
      "text": "同样你作为一个主体，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 511580,
      "end_ms": 513000,
      "text": "不在世界的任何地方，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 513120,
      "end_ms": 515475,
      "text": "世界中的每一个事实都可以被描述。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 515770,
      "end_ms": 519850,
      "text": "但那个正在描述的你永远不会出现在被描述的内容中。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 519990,
      "end_ms": 522495,
      "text": "哲学史上把这个叫做鲜艳主体，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 522810,
      "end_ms": 524120,
      "text": "听起来很悬戴，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 524120,
      "end_ms": 525555,
      "text": "维特根斯坦说的很朴素。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 525970,
      "end_ms": 527470,
      "text": "当你在读这句话的时候，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 527510,
      "end_ms": 529975,
      "text": "那个正在读的你不在句子里，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 530450,
      "end_ms": 533695,
      "text": "你不可能在句子中找到它它是句子的边界。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 534540,
      "end_ms": 537405,
      "text": "所以你怎么可能找到一个叫做自我的东西，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 537740,
      "end_ms": 539455,
      "text": "你不可能在世界中找到他。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 539850,
      "end_ms": 542135,
      "text": "因为它根本不是世界中的一个东西。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 542700,
      "end_ms": 545745,
      "text": "他是世界之所以成为一个世界的那个条件，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 546380,
      "end_ms": 547985,
      "text": "你不是在寻找你自己，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 548730,
      "end_ms": 549890,
      "text": "你一直在用的那个，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 549890,
      "end_ms": 554105,
      "text": "你本身就是寻找得以发生的那个空间。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 554750,
      "end_ms": 555655,
      "text": "第七层颠覆，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 556270,
      "end_ms": 557535,
      "text": "对于不可说的东西，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 557800,
      "end_ms": 558825,
      "text": "必须保持沉默，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 559430,
      "end_ms": 560455,
      "text": "但这不是放弃，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 560920,
      "end_ms": 562525,
      "text": "这是唯一诚实的姿态。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 562830,
      "end_ms": 564315,
      "text": "这是全书最后一句，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 564940,
      "end_ms": 567790,
      "text": "也是被误解最深的一句保持沉默，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 567870,
      "end_ms": 569095,
      "text": "听起来像投降，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 569560,
      "end_ms": 570445,
      "text": "像承认失败，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 571020,
      "end_ms": 572535,
      "text": "向哲学说我不行了。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 572960,
      "end_ms": 573640,
      "text": "但你如果这样，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 573640,
      "end_ms": 576415,
      "text": "读你就错过了维特根斯坦的整个意图。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 576740,
      "end_ms": 577480,
      "text": "他的意思是，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 577700,
      "end_ms": 585435,
      "text": "当你发现你一直试图说出的东西、意义、价值、自我、世界的整体根本不可能被说出来时，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 585920,
      "end_ms": 588235,
      "text": "你才第一次真正的站在了他面前。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 588570,
      "end_ms": 590155,
      "text": "你不再用语言去抓他。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 590440,
      "end_ms": 591840,
      "text": "因为你知道语言抓不住，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 591960,
      "end_ms": 593775,
      "text": "你不再用概念去包装它。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 594100,
      "end_ms": 595680,
      "text": "因为你知道概念会漏你，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 595680,
      "end_ms": 598290,
      "text": "只是在那里沉默，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 598290,
      "end_ms": 599185,
      "text": "不是空无。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 599860,
      "end_ms": 600260,
      "text": "沉默，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 600260,
      "end_ms": 601660,
      "text": "是你终于停止，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 601660,
      "end_ms": 604830,
      "text": "用谈论代替面对维特根斯坦，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 604850,
      "end_ms": 606555,
      "text": "把这本书比作一架梯子，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 607060,
      "end_ms": 607845,
      "text": "你爬上去。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 608210,
      "end_ms": 611150,
      "text": "然后扔掉它书中的每一个命题，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 611330,
      "end_ms": 612730,
      "text": "包括这七个基本命题，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 612730,
      "end_ms": 614810,
      "text": "本身都是梯子的横档。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 615530,
      "end_ms": 616890,
      "text": "当你真正理解了他们，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 617050,
      "end_ms": 619350,
      "text": "你会发现他们都是无意义的。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 619770,
      "end_ms": 621090,
      "text": "不是因为他们错了，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 621610,
      "end_ms": 623710,
      "text": "你那种他们已经完成了他们的工作，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 623890,
      "end_ms": 625870,
      "text": "把你送到了梯子的顶端。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 626170,
      "end_ms": 628510,
      "text": "然后你不再需要梯子，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 629110,
      "end_ms": 630230,
      "text": "你不再需要梯子，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 630890,
      "end_ms": 632030,
      "text": "你只需要活着，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 632330,
      "end_ms": 635510,
      "text": "以那种你以前从未尝试过的方式活着，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 636090,
      "end_ms": 638660,
      "text": "不再用一个解释去替换一个发生，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 639200,
      "end_ms": 641400,
      "text": "不再用一个意义去覆盖一个事实。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 641660,
      "end_ms": 643740,
      "text": "老维特根斯坦在他八十岁的时候，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 643880,
      "end_ms": 644280,
      "text": "好吧，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 644280,
      "end_ms": 645580,
      "text": "他其实只活到六十二岁。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 645900,
      "end_ms": 648460,
      "text": "但让我们借用那个老卡尔八十岁的话说，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 649020,
      "end_ms": 649960,
      "text": "如果有人问他，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 650480,
      "end_ms": 652760,
      "text": "你为你写了逻辑哲学论而骄傲吗？"
    },
    {
      "segment_id": "s000283",
      "start_ms": 652860,
      "end_ms": 653600,
      "text": "我想他会说，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 654080,
      "end_ms": 659380,
      "text": "不我骄傲的是我终于不再需要用七十五页来证明什么了。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 659780,
      "end_ms": 662480,
      "text": "我骄傲的是当我在挪威的小屋里，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 662480,
      "end_ms": 663600,
      "text": "独自度过那个冬天。"
    },
    {
      "segment_id": "s000287",
      "start_ms": 664200,
      "end_ms": 665460,
      "text": "我看着峡湾的冰面，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 666000,
      "end_ms": 666960,
      "text": "我没有对自己说，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 666960,
      "end_ms": 667645,
      "text": "这很美，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 668140,
      "end_ms": 668980,
      "text": "没有对自己说，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 669120,
      "end_ms": 669915,
      "text": "这有意义。"
    },
    {
      "segment_id": "s000292",
      "start_ms": 670450,
      "end_ms": 672035,
      "text": "我只是看着那一刻，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 672440,
      "end_ms": 673695,
      "text": "梯子已经被扔掉了，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 674260,
      "end_ms": 678470,
      "text": "这才是我从一九一八年的战壕里一直在做的事。"
    },
    {
      "segment_id": "s000295",
      "start_ms": 678550,
      "end_ms": 679310,
      "text": "如果你读到这里，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 679310,
      "end_ms": 680045,
      "text": "还没划走，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 680350,
      "end_ms": 681245,
      "text": "那我不再绕弯，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 681780,
      "end_ms": 683585,
      "text": "我把这本书正式放到你面前。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 684010,
      "end_ms": 686220,
      "text": "逻辑哲学论不是解读，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 686520,
      "end_ms": 687315,
      "text": "不是导论，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 687730,
      "end_ms": 689590,
      "text": "不是十分钟读懂维特根斯坦，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 689710,
      "end_ms": 691130,
      "text": "是那本只有七十五页，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 691290,
      "end_ms": 692995,
      "text": "像一块冰一样的原著，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 693400,
      "end_ms": 694700,
      "text": "你可以在一个下午翻完，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 695000,
      "end_ms": 696240,
      "text": "但你不会真的翻完。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 696320,
      "end_ms": 699340,
      "text": "你会停在某一页发现自己过去三十年说的话，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 699540,
      "end_ms": 701955,
      "text": "原来都在绕着一个不存在的中心打转，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 702510,
      "end_ms": 704290,
      "text": "这就是他值得被推荐的原因。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 704350,
      "end_ms": 705285,
      "text": "他不给你答案，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 705750,
      "end_ms": 707405,
      "text": "他拆掉你提问的方式。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 708080,
      "end_ms": 710160,
      "text": "市面上所有哲学普及书都在说，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 710280,
      "end_ms": 711875,
      "text": "哲学能让你更智慧。"
    },
    {
      "segment_id": "s000313",
      "start_ms": 712220,
      "end_ms": 713055,
      "text": "这本书说，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 713670,
      "end_ms": 714875,
      "text": "哲学不是智慧，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 715550,
      "end_ms": 717990,
      "text": "哲学是治疗他治的，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 717990,
      "end_ms": 718965,
      "text": "不是你的无知，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 719610,
      "end_ms": 720825,
      "text": "是你的语言病。"
    },
    {
      "segment_id": "s000318",
      "start_ms": 721250,
      "end_ms": 723255,
      "text": "你不停问人生的意义是什么？"
    },
    {
      "segment_id": "s000319",
      "start_ms": 723630,
      "end_ms": 726345,
      "text": "就像一个人不停问左边的左边在哪里，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 726820,
      "end_ms": 727780,
      "text": "不是问题太深，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 728100,
      "end_ms": 729295,
      "text": "是问法坏了，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 730050,
      "end_ms": 731765,
      "text": "维特根斯坦不给你新答案，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 732060,
      "end_ms": 733330,
      "text": "他让你看见你，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 733330,
      "end_ms": 734655,
      "text": "根本不需要那个答案。"
    },
    {
      "segment_id": "s000325",
      "start_ms": 735400,
      "end_ms": 739185,
      "text": "你需要的是停止用错误的语法折磨自己。"
    },
    {
      "segment_id": "s000326",
      "start_ms": 739780,
      "end_ms": 742635,
      "text": "它薄便宜、密度高，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 743260,
      "end_ms": 743725,
      "text": "危险。"
    },
    {
      "segment_id": "s000328",
      "start_ms": 743850,
      "end_ms": 745655,
      "text": "如他不需要哲学系背景，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 746040,
      "end_ms": 747345,
      "text": "只需要你愿意承认，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 747650,
      "end_ms": 750015,
      "text": "你可能一直活在一张画错的地图里，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 750320,
      "end_ms": 752170,
      "text": "第一遍读不懂正常，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 752590,
      "end_ms": 752970,
      "text": "第二遍，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 752970,
      "end_ms": 754340,
      "text": "读不懂也正常。"
    },
    {
      "segment_id": "s000334",
      "start_ms": 754560,
      "end_ms": 755525,
      "text": "第三遍开始，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 755890,
      "end_ms": 758475,
      "text": "你会突然在某一行停住后背发凉。"
    },
    {
      "segment_id": "s000336",
      "start_ms": 758990,
      "end_ms": 760085,
      "text": "不是因为你懂吗？"
    },
    {
      "segment_id": "s000337",
      "start_ms": 760370,
      "end_ms": 763125,
      "text": "是因为你发现自己以前根本没在问真问题。"
    },
    {
      "segment_id": "s000338",
      "start_ms": 763370,
      "end_ms": 764690,
      "text": "不要从二手解读开始，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 764930,
      "end_ms": 766225,
      "text": "先让原文撞你，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 766640,
      "end_ms": 767605,
      "text": "准备一支铅笔，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 768050,
      "end_ms": 770010,
      "text": "在页边写这里。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 770110,
      "end_ms": 771145,
      "text": "我在骗自己吗？"
    },
    {
      "segment_id": "s000343",
      "start_ms": 771810,
      "end_ms": 772510,
      "text": "七个命题，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 772750,
      "end_ms": 773845,
      "text": "向七面墙，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 774310,
      "end_ms": 775305,
      "text": "把你逼到沉默，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 776150,
      "end_ms": 777345,
      "text": "但沉默不是空，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 777920,
      "end_ms": 779165,
      "text": "是你终于闭嘴。"
    },
    {
      "segment_id": "s000348",
      "start_ms": 779720,
      "end_ms": 781040,
      "text": "开始看这本书，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 781040,
      "end_ms": 781775,
      "text": "不适合谁，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 782720,
      "end_ms": 784085,
      "text": "不适合想找安慰的人，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 784580,
      "end_ms": 786040,
      "text": "不适合想发朋友圈的人，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 786060,
      "end_ms": 786880,
      "text": "不适合想用。"
    },
    {
      "segment_id": "s000353",
      "start_ms": 786880,
      "end_ms": 787820,
      "text": "维特根斯坦说，"
    },
    {
      "segment_id": "s000354",
      "start_ms": 787840,
      "end_ms": 793115,
      "text": "装点门面的人不适合想靠一本书解决孩子成绩、夫妻关系、职场晋升的人，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 793590,
      "end_ms": 794665,
      "text": "他不提供那些，"
    },
    {
      "segment_id": "s000356",
      "start_ms": 795450,
      "end_ms": 796805,
      "text": "他甚至不提供意义，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 797400,
      "end_ms": 799475,
      "text": "他只提供一次彻底的清理，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 800080,
      "end_ms": 802920,
      "text": "适合谁适合那个深夜睡不着，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 803280,
      "end_ms": 805360,
      "text": "觉得所有道理都听过却依然过。"
    },
    {
      "segment_id": "s000360",
      "start_ms": 805360,
      "end_ms": 806015,
      "text": "不好的人，"
    },
    {
      "segment_id": "s000361",
      "start_ms": 806270,
      "end_ms": 809290,
      "text": "适合被原生家庭底层逻辑认知升级，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 809310,
      "end_ms": 811875,
      "text": "味道反胃的人适和终于怀疑，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 812160,
      "end_ms": 814595,
      "text": "是不是我一直在回答一个没人问的问题，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 815110,
      "end_ms": 816555,
      "text": "这本书不会让你成功，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 817180,
      "end_ms": 818215,
      "text": "他会让你安静，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 818540,
      "end_ms": 819760,
      "text": "他不会让你更会说话。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 819820,
      "end_ms": 821395,
      "text": "他会让你少说废话，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 821890,
      "end_ms": 822995,
      "text": "他不会给你意义，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 823610,
      "end_ms": 825215,
      "text": "他会拿走你伪造的意义。"
    },
    {
      "segment_id": "s000370",
      "start_ms": 825520,
      "end_ms": 829600,
      "text": "然后你第一次看见世界就在那里不多不少。"
    },
    {
      "segment_id": "s000371",
      "start_ms": 829840,
      "end_ms": 832265,
      "text": "如果你只买一本哲学书买它。"
    },
    {
      "segment_id": "s000372",
      "start_ms": 832810,
      "end_ms": 835625,
      "text": "如果你只读一句哲学读最后一句，"
    },
    {
      "segment_id": "s000373",
      "start_ms": 836240,
      "end_ms": 837505,
      "text": "但不要只读最后一句，"
    },
    {
      "segment_id": "s000374",
      "start_ms": 838210,
      "end_ms": 841815,
      "text": "因为最后一句的沉默是前面七层颠覆换来的，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 842670,
      "end_ms": 843845,
      "text": "对于不可说的，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 844120,
      "end_ms": 845415,
      "text": "必须保持沉默。"
    },
    {
      "segment_id": "s000377",
      "start_ms": 845870,
      "end_ms": 848255,
      "text": "但对于该赌的不要再沉默。"
    },
    {
      "segment_id": "s000378",
      "start_ms": 848660,
      "end_ms": 850715,
      "text": "现在去读逻辑哲学论，"
    },
    {
      "segment_id": "s000379",
      "start_ms": 850980,
      "end_ms": 851665,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000380",
      "start_ms": 852010,
      "end_ms": 853835,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "4e2c5b22415122f8d9d726b907f7ed24b1a04de092121367f2759dfab11ae301"
}