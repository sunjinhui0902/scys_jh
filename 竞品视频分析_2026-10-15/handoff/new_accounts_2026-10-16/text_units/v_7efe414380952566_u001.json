{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_7efe414380952566_u001",
  "video_id": "v_7efe414380952566",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 877.831995,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 70,
      "end_ms": 490,
      "text": "上集，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 490,
      "end_ms": 3990,
      "text": "咱们聊了泸沽湖赛里木湖净博湖，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4290,
      "end_ms": 6810,
      "text": "鄱阳湖纳木错这集，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7110,
      "end_ms": 8490,
      "text": "直接揭开谜底，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8730,
      "end_ms": 11410,
      "text": "看看前五名到底神秘在哪。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12110,
      "end_ms": 14390,
      "text": "尤其是排在榜首的那一座，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 14810,
      "end_ms": 16430,
      "text": "它已经干了几十年了，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 16550,
      "end_ms": 17690,
      "text": "一滴水都没有，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 18270,
      "end_ms": 19550,
      "text": "他没人敢进去。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 20390,
      "end_ms": 21050,
      "text": "老规矩，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 21170,
      "end_ms": 21950,
      "text": "开讲之前，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 21950,
      "end_ms": 25350,
      "text": "劳烦您扣个一点个红心第五名。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 25590,
      "end_ms": 27810,
      "text": "铜山湖在河南驻马店，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 28490,
      "end_ms": 30000,
      "text": "这个湖不是天然的，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 30460,
      "end_ms": 33860,
      "text": "是上世纪六十年代人工修的水库，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 34400,
      "end_ms": 35960,
      "text": "可就是这么一座人工湖。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 36120,
      "end_ms": 37640,
      "text": "据说从八十年代开始，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 37780,
      "end_ms": 39840,
      "text": "不断有人看见水里有怪东西。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 40100,
      "end_ms": 41580,
      "text": "据密阳县志记载，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 41880,
      "end_ms": 43140,
      "text": "清代康熙五年，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 43400,
      "end_ms": 45220,
      "text": "公元一千六百六十六年，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 45380,
      "end_ms": 47680,
      "text": "就有斗大的动物从天而降，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 47940,
      "end_ms": 50320,
      "text": "模样像一条蛟龙的记录。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 50880,
      "end_ms": 55160,
      "text": "乾隆五十六年也有渔民在河中水潭遭遇巨兽，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 55640,
      "end_ms": 57740,
      "text": "掀起狂风的详细描述。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 58640,
      "end_ms": 61255,
      "text": "到了一九八五年九月的一天晚上，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 61710,
      "end_ms": 66085,
      "text": "湖区水产队职工马海丽驾船返回驻地，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 66500,
      "end_ms": 69060,
      "text": "行驶到湖心道潜水去时。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 69140,
      "end_ms": 70295,
      "text": "据他后来回忆，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 71370,
      "end_ms": 74565,
      "text": "忽然发现一个庞然大物趴在岸边。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 75490,
      "end_ms": 77125,
      "text": "据马海里本人描述，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 77490,
      "end_ms": 79655,
      "text": "这东西头有牛头般大小，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 80470,
      "end_ms": 81190,
      "text": "状如蛇，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 81190,
      "end_ms": 83625,
      "text": "手长有两只短脚，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 84100,
      "end_ms": 86265,
      "text": "身上有铜钱大的灰色鳞片，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 86670,
      "end_ms": 88725,
      "text": "露出的前躯有两只爪子，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 89230,
      "end_ms": 91785,
      "text": "露出水面的部分约有四五米长。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 92260,
      "end_ms": 94000,
      "text": "他当时吓得大病一场，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 94160,
      "end_ms": 95875,
      "text": "后来申请调离了库区。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 96450,
      "end_ms": 97485,
      "text": "需要说明的是，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 98340,
      "end_ms": 104925,
      "text": "这些描述来自目击者的个人陈述至今没有获得任何实体证据。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 106020,
      "end_ms": 110500,
      "text": "红珊瑚的这个东西到底是目击者在夜间光线下的错觉，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 110780,
      "end_ms": 114140,
      "text": "是一种我们还不认识的大型水生动物，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 114280,
      "end_ms": 115405,
      "text": "还是别的什么？"
    },
    {
      "segment_id": "s000045",
      "start_ms": 115720,
      "end_ms": 117995,
      "text": "目前只能说科学没有给出答案，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 118430,
      "end_ms": 120505,
      "text": "但科学也没有关上大门，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 121350,
      "end_ms": 124605,
      "text": "一座人工修的湖地方治理，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 124890,
      "end_ms": 125850,
      "text": "却记着蛟龙，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 126150,
      "end_ms": 127065,
      "text": "这够神秘。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 127990,
      "end_ms": 128650,
      "text": "第四名，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 128890,
      "end_ms": 135200,
      "text": "长白山天池在吉林长白山天池，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 135200,
      "end_ms": 139380,
      "text": "咱们在神秘的山那期聊过那期讲的是他怎么来的？"
    },
    {
      "segment_id": "s000053",
      "start_ms": 139380,
      "end_ms": 143280,
      "text": "火山炸出来的这期咱们讲另一件事，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 143280,
      "end_ms": 144635,
      "text": "这个湖里有东西。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 145060,
      "end_ms": 146695,
      "text": "一九八零年十月九日，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 147080,
      "end_ms": 148835,
      "text": "光明日报刊登了一篇文章，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 149270,
      "end_ms": 152255,
      "text": "题目叫天池怪兽目击记。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 153100,
      "end_ms": 153595,
      "text": "作者说，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 154000,
      "end_ms": 157665,
      "text": "一九八零年八月二十一日早上四点多钟，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 158190,
      "end_ms": 160585,
      "text": "他在长白山天池顶部看日出，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 161130,
      "end_ms": 164010,
      "text": "突然发现在远处的水面上，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 164150,
      "end_ms": 167710,
      "text": "有一个物体体大如牛头，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 167710,
      "end_ms": 168445,
      "text": "大如盆，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 168990,
      "end_ms": 169965,
      "text": "游动极快，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 170490,
      "end_ms": 173815,
      "text": "身后还拖着一条长长的喇叭型划水线。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 174270,
      "end_ms": 176735,
      "text": "这篇文章一登出来引发了广泛关注。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 177860,
      "end_ms": 178560,
      "text": "从那以后，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 178640,
      "end_ms": 180375,
      "text": "目击报告越来越多。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 180990,
      "end_ms": 182685,
      "text": "据新华社等媒体报道，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 183090,
      "end_ms": 188725,
      "text": "仅见朱记载的就有三四十次目击者多达数千人次。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 189590,
      "end_ms": 191075,
      "text": "据一些目击者描述，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 191530,
      "end_ms": 194585,
      "text": "有人曾看到水面上出现过多头怪物。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 194990,
      "end_ms": 195805,
      "text": "可问题是，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 196140,
      "end_ms": 198525,
      "text": "长白山天池是一个火山口湖，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 199000,
      "end_ms": 200035,
      "text": "山高水冷，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 200400,
      "end_ms": 203545,
      "text": "一年有近八个月被冰雪覆盖，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 204110,
      "end_ms": 205510,
      "text": "即使盛夏正午，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 205730,
      "end_ms": 208175,
      "text": "水温也不过十一摄氏度左右。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 208590,
      "end_ms": 211095,
      "text": "有关部门曾对天池做过考察，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 211480,
      "end_ms": 211960,
      "text": "结论是，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 211960,
      "end_ms": 213055,
      "text": "这里没有脊椎动物，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 214030,
      "end_ms": 215030,
      "text": "没有脊椎动物，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 215030,
      "end_ms": 216305,
      "text": "哪来的怪兽？"
    },
    {
      "segment_id": "s000084",
      "start_ms": 217090,
      "end_ms": 219515,
      "text": "那些目击者看到的到底是什么？"
    },
    {
      "segment_id": "s000085",
      "start_ms": 219810,
      "end_ms": 221390,
      "text": "是某种未知的生物，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 221630,
      "end_ms": 224255,
      "text": "还是光线和水面造成的视觉误差，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 225060,
      "end_ms": 227225,
      "text": "科学至今没有给出定论。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 227770,
      "end_ms": 230990,
      "text": "一座火山炸出来的珊瑚水温，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 230990,
      "end_ms": 232195,
      "text": "常年只有几度，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 232580,
      "end_ms": 235255,
      "text": "却有人看见怪物在水面出没，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 235490,
      "end_ms": 236155,
      "text": "这够神秘。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 237110,
      "end_ms": 237775,
      "text": "第三名，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 238780,
      "end_ms": 240770,
      "text": "青海湖在青海，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 241810,
      "end_ms": 244350,
      "text": "青海湖是中国最大的咸水湖。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 244710,
      "end_ms": 245670,
      "text": "关于它的神秘，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 245890,
      "end_ms": 246870,
      "text": "有两个传说，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 247570,
      "end_ms": 250450,
      "text": "第一个传说在湖心底下，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 250570,
      "end_ms": 252190,
      "text": "当地流传着一个说法。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 252630,
      "end_ms": 256370,
      "text": "青海湖的湖心底部有一个无底的大黑洞，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 257130,
      "end_ms": 259550,
      "text": "这个洞跟北面的黑海相通，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 259970,
      "end_ms": 262430,
      "text": "湖水不停的向黑海流过去，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 262930,
      "end_ms": 265470,
      "text": "黝黑的水怪就住在这个黑洞里，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 265610,
      "end_ms": 269455,
      "text": "游走在青海湖和黑海之间的通道上。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 270080,
      "end_ms": 271600,
      "text": "这个说法没有科学证实，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 272200,
      "end_ms": 274000,
      "text": "但当地人世代相传。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 274800,
      "end_ms": 279140,
      "text": "曾经有一个年轻藏民被这个传说深深吸引，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 279840,
      "end_ms": 282140,
      "text": "孤身一人踏冰来到湖心，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 282960,
      "end_ms": 286380,
      "text": "在冰面上找了很久没有找到黑洞，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 286420,
      "end_ms": 289440,
      "text": "却在一处水下发现了庞大的漩涡，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 289940,
      "end_ms": 291820,
      "text": "把水搅的飞旋乱转。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 292300,
      "end_ms": 293040,
      "text": "回去以后，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 293200,
      "end_ms": 295895,
      "text": "他把看到的一切告诉了村里人。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 296510,
      "end_ms": 297310,
      "text": "从那以后，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 297470,
      "end_ms": 302390,
      "text": "大家更加相信漩涡底下可能真的存在黑洞和通道。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 303290,
      "end_ms": 304250,
      "text": "第二个传说，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 305050,
      "end_ms": 305990,
      "text": "在水面上，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 306890,
      "end_ms": 315870,
      "text": "青海湖水怪的目击记录最早可以追溯到一九五五年六月一九八二年五月二十三日下午，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 316550,
      "end_ms": 320890,
      "text": "青海湖农场五大队的渔船之工再次目击到水怪。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 321630,
      "end_ms": 322390,
      "text": "据描述，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 322410,
      "end_ms": 324010,
      "text": "那天下午天气闷热，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 324150,
      "end_ms": 327300,
      "text": "一个巨大的黑黄色怪物在水面面上一动不动，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 327580,
      "end_ms": 328740,
      "text": "比渔船稍大，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 328860,
      "end_ms": 329640,
      "text": "不露头尾，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 330220,
      "end_ms": 331980,
      "text": "大约有十三四米长。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 332840,
      "end_ms": 334900,
      "text": "可能由于渔船声音太大，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 335760,
      "end_ms": 336580,
      "text": "惊动了它，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 337060,
      "end_ms": 338740,
      "text": "怪物马上潜下水去。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 339160,
      "end_ms": 340040,
      "text": "有人推测，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 340040,
      "end_ms": 343820,
      "text": "青海湖水怪可能是蛇颈龙之类的远古爬行生物。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 344480,
      "end_ms": 345500,
      "text": "但专家指出，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 345840,
      "end_ms": 348140,
      "text": "蛇颈龙一般生活在海洋里，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 348540,
      "end_ms": 354560,
      "text": "没有证据显示这种生物曾在淡水里生存过一座湖底，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 354600,
      "end_ms": 356705,
      "text": "下有个通黑海的黑移动，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 357250,
      "end_ms": 359250,
      "text": "上面游着十几米的怪物，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 359270,
      "end_ms": 360065,
      "text": "这够神秘。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 361880,
      "end_ms": 371635,
      "text": "第二名喀纳斯湖在新疆阿勒泰喀纳斯湖是中国最深的冰川堰塞湖，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 371900,
      "end_ms": 372015,
      "text": "嗯，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 372530,
      "end_ms": 375325,
      "text": "湖水最深处将近两百米。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 377120,
      "end_ms": 378040,
      "text": "关于他的水怪，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 378040,
      "end_ms": 381215,
      "text": "传说已经流传了四百多年。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 382020,
      "end_ms": 382980,
      "text": "当地牧民说，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 383240,
      "end_ms": 385245,
      "text": "湖里有巨型水怪，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 385690,
      "end_ms": 389435,
      "text": "常常把在湖边饮水的马匹拖入水中。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 390130,
      "end_ms": 395735,
      "text": "一九八零年和一九八五年科考队两次到喀纳斯湖不老，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 396310,
      "end_ms": 398275,
      "text": "发现湖里主要有八种鱼，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 398870,
      "end_ms": 400435,
      "text": "通过反复比较，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 400690,
      "end_ms": 403150,
      "text": "专家们把注意力集中到了一种鱼身上。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 403230,
      "end_ms": 405255,
      "text": "折罗龟当地人叫大红鱼，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 405660,
      "end_ms": 406260,
      "text": "折罗圭，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 406380,
      "end_ms": 408895,
      "text": "是大型肉食性凶猛鱼类，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 409280,
      "end_ms": 410360,
      "text": "在繁殖季节，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 410360,
      "end_ms": 411885,
      "text": "皮肤呈红褐色。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 412300,
      "end_ms": 413715,
      "text": "中科院专家推测，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 414180,
      "end_ms": 417275,
      "text": "喀纳斯水怪应该就是大型折罗龟。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 417830,
      "end_ms": 418695,
      "text": "可问题来了，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 419660,
      "end_ms": 420845,
      "text": "据科考记录，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 421620,
      "end_ms": 422520,
      "text": "迄今为止，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 422680,
      "end_ms": 428125,
      "text": "从喀纳斯湖中捕捉到的折罗圭长度还没有超过三米的，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 429020,
      "end_ms": 435020,
      "text": "而目击者声称看到的水中影子长约十米三米的鱼，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 435260,
      "end_ms": 437045,
      "text": "怎么能产生十米的影子？"
    },
    {
      "segment_id": "s000161",
      "start_ms": 437940,
      "end_ms": 438450,
      "text": "另外，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 439100,
      "end_ms": 441420,
      "text": "折罗龟属于龟壳鱼类，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 441420,
      "end_ms": 443460,
      "text": "龟壳鱼类有一个重要特性，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 443460,
      "end_ms": 444955,
      "text": "繁殖季节要回游。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 445430,
      "end_ms": 447445,
      "text": "而喀纳斯湖是一个过江湖泊，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 447920,
      "end_ms": 450180,
      "text": "上下游河道都比较狭窄，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 450400,
      "end_ms": 452355,
      "text": "尤其是和湖区相连的部分，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 452950,
      "end_ms": 454775,
      "text": "大多是一些乱石浅滩，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 455600,
      "end_ms": 457325,
      "text": "一条十米长的大鱼，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 458010,
      "end_ms": 460015,
      "text": "是怎么通过那些浅贪的？"
    },
    {
      "segment_id": "s000171",
      "start_ms": 460740,
      "end_ms": 461535,
      "text": "这些疑问，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 462230,
      "end_ms": 463865,
      "text": "到今天都没有答案。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 464790,
      "end_ms": 471160,
      "text": "一座四百多年传说水怪的湖科考队来了又走走的时候，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 471360,
      "end_ms": 472825,
      "text": "比来的时候更糊涂，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 473140,
      "end_ms": 473805,
      "text": "这够神秘。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 474680,
      "end_ms": 475325,
      "text": "讲到这儿，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 477590,
      "end_ms": 480070,
      "text": "我想起上期讲神秘的山的时候，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 480090,
      "end_ms": 481810,
      "text": "评论区有几条留言，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 482590,
      "end_ms": 484150,
      "text": "我看了心里酸酸的。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 485030,
      "end_ms": 486050,
      "text": "有一位朋友说，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 486790,
      "end_ms": 488870,
      "text": "现在已有一甲子的年纪了，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 489470,
      "end_ms": 490850,
      "text": "有心而无力，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 491550,
      "end_ms": 492830,
      "text": "年忆神往之。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 493830,
      "end_ms": 497250,
      "text": "还有一位朋友说听主播讲解如霍，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 497250,
      "end_ms": 498030,
      "text": "梦醒一般。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 498310,
      "end_ms": 500650,
      "text": "得知这十座神山太神奇了。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 501250,
      "end_ms": 502410,
      "text": "可惜这十座神山，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 502410,
      "end_ms": 507035,
      "text": "我一个都没去年一古稀没这个福分了。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 508080,
      "end_ms": 509020,
      "text": "这两条留言，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 509380,
      "end_ms": 510380,
      "text": "我一直记着，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 510780,
      "end_ms": 512660,
      "text": "您说咱们年轻的时候忙工作，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 512660,
      "end_ms": 514640,
      "text": "忙家庭没时间出去走一走，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 514640,
      "end_ms": 515280,
      "text": "等退休了，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 515280,
      "end_ms": 515880,
      "text": "有空了，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 516260,
      "end_ms": 517140,
      "text": "不是不想去，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 517440,
      "end_ms": 518820,
      "text": "而是有心无力了。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 519200,
      "end_ms": 520160,
      "text": "腿脚好的时候，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 520160,
      "end_ms": 521640,
      "text": "没时间有时间了，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 521640,
      "end_ms": 522580,
      "text": "腿脚又不行了，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 522880,
      "end_ms": 526180,
      "text": "还有带孙子孙女的孩子问爷爷，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 526180,
      "end_ms": 526960,
      "text": "这是什么湖？"
    },
    {
      "segment_id": "s000202",
      "start_ms": 527500,
      "end_ms": 529880,
      "text": "您翻半天手机也讲不明白，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 530560,
      "end_ms": 533660,
      "text": "您看咱们这个年纪看山看水，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 533680,
      "end_ms": 534860,
      "text": "不光是看个风景，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 535340,
      "end_ms": 538495,
      "text": "是想知道这山这水有什么情讲究，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 539100,
      "end_ms": 540040,
      "text": "有什么故事。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 540540,
      "end_ms": 544000,
      "text": "可这些东西手机上刷完就忘上网，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 544000,
      "end_ms": 546890,
      "text": "查一堆乱七八糟的翻大部头，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 546890,
      "end_ms": 547890,
      "text": "又看的眼睛疼。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 548010,
      "end_ms": 549765,
      "text": "前阵子我翻到一本书，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 550180,
      "end_ms": 551785,
      "text": "正好解决这个问题，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 552470,
      "end_ms": 557115,
      "text": "叫大美中国人一生要去的一百零一个地方。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 557670,
      "end_ms": 562385,
      "text": "这本书是北方妇女儿童出版社出的木子编的，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 562690,
      "end_ms": 566055,
      "text": "他把全中国最值得去的一百零一个地方挑出来，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 566370,
      "end_ms": 570825,
      "text": "涵盖了自然风光、历史、文化、民族风情好几个方面。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 572100,
      "end_ms": 581525,
      "text": "咱们今天聊的这些湖青海湖喀纳斯湖书里头都有一个地方一个地方的讲怎么来的，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 581770,
      "end_ms": 582650,
      "text": "有什么典故，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 582790,
      "end_ms": 584525,
      "text": "哪个诗人在这儿写过什么，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 584760,
      "end_ms": 586355,
      "text": "哪个皇帝在这儿干过甚，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 586780,
      "end_ms": 587480,
      "text": "几分钟，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 587500,
      "end_ms": 589615,
      "text": "一个地方讲的明明白白。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 590260,
      "end_ms": 592280,
      "text": "图也印的漂亮一页，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 592280,
      "end_ms": 593760,
      "text": "翻开就是一幅大画，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 594180,
      "end_ms": 595560,
      "text": "我自己是这么用的，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 596140,
      "end_ms": 599700,
      "text": "能去的地方出门前先翻一翻到了地方，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 599700,
      "end_ms": 600460,
      "text": "心里有底，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 600660,
      "end_ms": 601720,
      "text": "看的就不是水，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 601720,
      "end_ms": 603720,
      "text": "是故事去不了的地方。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 603720,
      "end_ms": 604540,
      "text": "翻翻书看看。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 604540,
      "end_ms": 605600,
      "text": "图也算去过，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 605940,
      "end_ms": 608380,
      "text": "放茶几上孙子，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 608380,
      "end_ms": 609020,
      "text": "孙女来了，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 609020,
      "end_ms": 611240,
      "text": "翻两页长知识，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 611240,
      "end_ms": 611600,
      "text": "不说，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 611960,
      "end_ms": 613380,
      "text": "写作文都用得上，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 614420,
      "end_ms": 615900,
      "text": "老两口晚上翻翻，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 615940,
      "end_ms": 617340,
      "text": "商量明年去哪。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 617340,
      "end_ms": 619465,
      "text": "比刷手机有意思多了，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 620050,
      "end_ms": 620910,
      "text": "房子会旧，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 620910,
      "end_ms": 621970,
      "text": "存款会花完，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 622530,
      "end_ms": 624370,
      "text": "可千年文化替他植入。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 625090,
      "end_ms": 625750,
      "text": "这个东西，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 625750,
      "end_ms": 627290,
      "text": "传多少代都不会贬值，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 628090,
      "end_ms": 630530,
      "text": "守住咱们中国人的文化根脉。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 631090,
      "end_ms": 632330,
      "text": "这根一旦断了，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 632330,
      "end_ms": 633630,
      "text": "就再也接不回来了。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 634310,
      "end_ms": 637650,
      "text": "好兴趣的朋友下方小黄车点进去看看，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 638090,
      "end_ms": 639510,
      "text": "暂时走不出去。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 639690,
      "end_ms": 642190,
      "text": "咱就把祖国大好河山装进屋里，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 642490,
      "end_ms": 643810,
      "text": "好说回正题，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 644910,
      "end_ms": 649655,
      "text": "第一名罗布泊在新疆东南部，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 651200,
      "end_ms": 651760,
      "text": "罗布泊，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 652000,
      "end_ms": 654360,
      "text": "蒙古语的意思是多水汇集之湖，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 654640,
      "end_ms": 656285,
      "text": "可他现在一滴水都没有。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 657460,
      "end_ms": 658435,
      "text": "一九七二年，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 659010,
      "end_ms": 660825,
      "text": "罗布泊完全干涸，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 661570,
      "end_ms": 665585,
      "text": "只留下一片严格覆盖的湖盆卫星。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 665960,
      "end_ms": 667315,
      "text": "从天上拍下来，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 668440,
      "end_ms": 669775,
      "text": "这片湖盆的形状，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 670260,
      "end_ms": 671765,
      "text": "像一只巨大的耳朵，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 672490,
      "end_ms": 674535,
      "text": "不但有耳轮、有耳垂，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 674960,
      "end_ms": 675965,
      "text": "甚至还有耳孔，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 676780,
      "end_ms": 678595,
      "text": "所以人们管它叫地球之二。"
    },
    {
      "segment_id": "s000264",
      "start_ms": 679450,
      "end_ms": 684385,
      "text": "可罗布泊真正让人害怕的不是它的形状，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 684720,
      "end_ms": 685260,
      "text": "是进去的。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 685260,
      "end_ms": 686835,
      "text": "人据公开报道，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 687150,
      "end_ms": 688915,
      "text": "一九八零年六月十七日，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 689160,
      "end_ms": 693240,
      "text": "著名科学家彭加木带领科考队进入罗布泊考察。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 693280,
      "end_ms": 695135,
      "text": "在库姆库都克附近，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 695820,
      "end_ms": 698025,
      "text": "考察队的汽油和水都快用完了，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 698920,
      "end_ms": 700525,
      "text": "彭家木留下了一张纸条，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 701280,
      "end_ms": 703735,
      "text": "上面写着我往东去找水井，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 704590,
      "end_ms": 706705,
      "text": "然后一个人走进了沙漠。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 707230,
      "end_ms": 708015,
      "text": "从那以后，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 708390,
      "end_ms": 709665,
      "text": "再也没有人见过他。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 710320,
      "end_ms": 714985,
      "text": "国家出动了飞机、军队、警犬进行了地毯式搜索，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 715210,
      "end_ms": 715925,
      "text": "一无所获。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 716780,
      "end_ms": 718245,
      "text": "一九九六年六月，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 718640,
      "end_ms": 721765,
      "text": "探险家、余纯顺、徒步穿越罗布泊，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 722180,
      "end_ms": 723255,
      "text": "他是有准备的，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 724270,
      "end_ms": 726905,
      "text": "提前买好了水和食物。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 727870,
      "end_ms": 729290,
      "text": "可他走错了方向，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 729430,
      "end_ms": 730625,
      "text": "偏了十几公里。"
    },
    {
      "segment_id": "s000284",
      "start_ms": 731500,
      "end_ms": 733705,
      "text": "当搜救人员找到他的时候，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 734140,
      "end_ms": 735135,
      "text": "他已经遇难了，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 735980,
      "end_ms": 738775,
      "text": "距离他买水的地方只有十几公里。"
    },
    {
      "segment_id": "s000287",
      "start_ms": 739720,
      "end_ms": 741275,
      "text": "更早的一九四九年，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 741680,
      "end_ms": 744205,
      "text": "一架飞机坠毁在罗布泊，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 744760,
      "end_ms": 746235,
      "text": "机上人员全部遇难。"
    },
    {
      "segment_id": "s000290",
      "start_ms": 747130,
      "end_ms": 748890,
      "text": "至于他为什么会飞到那里，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 748890,
      "end_ms": 750865,
      "text": "至今没有明确的解释。"
    },
    {
      "segment_id": "s000292",
      "start_ms": 751580,
      "end_ms": 757495,
      "text": "您想想一片干涸的湖盆卫星拍下来像一只耳朵。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 757920,
      "end_ms": 759935,
      "text": "科学家进去找水再也没出来，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 760450,
      "end_ms": 761550,
      "text": "探险家走错了，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 761550,
      "end_ms": 763350,
      "text": "十几公里就倒在了沙漠里，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 763350,
      "end_ms": 765015,
      "text": "飞机飞进去就坠毁了。"
    },
    {
      "segment_id": "s000297",
      "start_ms": 765790,
      "end_ms": 770205,
      "text": "这地方到底有什么罗布泊，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 770510,
      "end_ms": 771655,
      "text": "凭什么排第一？"
    },
    {
      "segment_id": "s000299",
      "start_ms": 772520,
      "end_ms": 773020,
      "text": "第一，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 773750,
      "end_ms": 775285,
      "text": "别的壶是水做的，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 775960,
      "end_ms": 777595,
      "text": "罗布泊是空座的。"
    },
    {
      "segment_id": "s000302",
      "start_ms": 778730,
      "end_ms": 779485,
      "text": "他没有水，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 780110,
      "end_ms": 783290,
      "text": "却比任何一座湖都吓人一片，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 783310,
      "end_ms": 785650,
      "text": "什么都没有的地方让人害怕，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 786050,
      "end_ms": 788385,
      "text": "那才是真正的神秘。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 789220,
      "end_ms": 789670,
      "text": "第二，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 790140,
      "end_ms": 794415,
      "text": "他吞进去的东西从来没有吐出来过。"
    },
    {
      "segment_id": "s000308",
      "start_ms": 795000,
      "end_ms": 796655,
      "text": "彭加木失踪四十多年，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 797380,
      "end_ms": 805070,
      "text": "飞机残骸科考队员的遗体大多没有找到一片干涸的湖畔，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 805150,
      "end_ms": 806825,
      "text": "像一个巨大的黑洞，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 807240,
      "end_ms": 808785,
      "text": "进去的东西就消失了。"
    },
    {
      "segment_id": "s000312",
      "start_ms": 809230,
      "end_ms": 809695,
      "text": "第三，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 809880,
      "end_ms": 813765,
      "text": "他到今天还是禁取罗布泊的核心区域，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 814070,
      "end_ms": 815485,
      "text": "普通人根本不让进，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 816520,
      "end_ms": 818530,
      "text": "您想去看看不到，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 818610,
      "end_ms": 819390,
      "text": "您想去找，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 819470,
      "end_ms": 821000,
      "text": "找不着一座湖，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 821400,
      "end_ms": 823365,
      "text": "连看一眼的资格都不给您，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 823900,
      "end_ms": 825635,
      "text": "这才叫真正的神秘。"
    },
    {
      "segment_id": "s000320",
      "start_ms": 826510,
      "end_ms": 827965,
      "text": "从第五到第一名，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 828800,
      "end_ms": 832290,
      "text": "桐珊湖地方治理记者蛟龙长白山天池，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 832290,
      "end_ms": 834225,
      "text": "有人看见怪物在水面出没，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 834640,
      "end_ms": 837155,
      "text": "青海湖底下有个通黑海的黑洞。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 837630,
      "end_ms": 840530,
      "text": "喀纳斯湖里三米的鱼产生十米的影子，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 840610,
      "end_ms": 843610,
      "text": "罗布泊吞了科学家、探险家和飞机，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 843790,
      "end_ms": 845045,
      "text": "什么都没吐出来。"
    },
    {
      "segment_id": "s000327",
      "start_ms": 845320,
      "end_ms": 845485,
      "text": "嗯，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 845780,
      "end_ms": 848485,
      "text": "这十座湖有的是水太深，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 848780,
      "end_ms": 849835,
      "text": "有的是水太冷，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 850080,
      "end_ms": 851255,
      "text": "有的是水太毒，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 851970,
      "end_ms": 854665,
      "text": "可只有罗布婆连水都没有了，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 855040,
      "end_ms": 856475,
      "text": "还是没人敢进去。"
    },
    {
      "segment_id": "s000333",
      "start_ms": 857250,
      "end_ms": 858030,
      "text": "最后问问您，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 858170,
      "end_ms": 858970,
      "text": "这十座湖，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 859230,
      "end_ms": 862995,
      "text": "您去过几座最想去的是哪一座？"
    },
    {
      "segment_id": "s000336",
      "start_ms": 864130,
      "end_ms": 865065,
      "text": "评论区告诉我，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 866010,
      "end_ms": 869555,
      "text": "刚才说的那本大美中国橱窗和小黄车都有，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 869950,
      "end_ms": 871955,
      "text": "喜欢看山看水的朋友别错过，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 872330,
      "end_ms": 873930,
      "text": "觉得这期涨知识的点个赞，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 873930,
      "end_ms": 874570,
      "text": "点个收藏，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 874690,
      "end_ms": 875770,
      "text": "想看更多老故事，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 875770,
      "end_ms": 876390,
      "text": "点个关注，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 876530,
      "end_ms": 877800,
      "text": "咱们下回接着聊。"
    }
  ],
  "source_transcript_sha256": "fb6007259139222f62bddc3d65136969e2899f69d1333afcb93a5dad0922aabc"
}