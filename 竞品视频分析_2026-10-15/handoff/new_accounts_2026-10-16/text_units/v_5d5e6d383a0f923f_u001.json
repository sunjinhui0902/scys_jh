{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_5d5e6d383a0f923f_u001",
  "video_id": "v_5d5e6d383a0f923f",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 487.387007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 370,
      "end_ms": 5590,
      "text": "本视频八分钟讲解钱目中国历代政治得失中十个核心观点，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 5750,
      "end_ms": 7210,
      "text": "建议先收藏再观看。"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7750,
      "end_ms": 9110,
      "text": "你有没有过这样的时刻，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9590,
      "end_ms": 10610,
      "text": "翻开历史课本，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 11030,
      "end_ms": 13130,
      "text": "只觉得皇帝更替、制度变迁，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 13490,
      "end_ms": 14870,
      "text": "像一锅煮糊的粥，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 15530,
      "end_ms": 18510,
      "text": "看不清哪个朝代真正改变了中国人的命运。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18710,
      "end_ms": 22350,
      "text": "我们背了那么多科举制、郡县制、三省六部制，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 22650,
      "end_ms": 25930,
      "text": "却不知道这些制度背后藏着怎样的挣扎与妥协。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 26550,
      "end_ms": 28510,
      "text": "你明明对传统文化有敬畏，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 28750,
      "end_ms": 34820,
      "text": "却一不小心被五千年专制黑暗的论断裹挟那种状态叫历史失语，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 35240,
      "end_ms": 36500,
      "text": "但你自己都没察觉。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 37020,
      "end_ms": 41640,
      "text": "钱穆先生的中国历代政治得失就是一把劈开历史迷雾的刀。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 42240,
      "end_ms": 45120,
      "text": "这位被誉为最后一位通儒的国学大师，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 45380,
      "end_ms": 49540,
      "text": "在一九五二年用五次演讲炸翻了当时主流的历史观。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 50080,
      "end_ms": 50500,
      "text": "他说，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 50980,
      "end_ms": 54260,
      "text": "中国政治不是一句封建专制就能概括的，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 54680,
      "end_ms": 56960,
      "text": "每个制度诞生时都充满理想，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 57180,
      "end_ms": 59000,
      "text": "都试图解决当下的困境。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 59060,
      "end_ms": 63175,
      "text": "今天我们就来解如这本宝宝小书里藏着的十大核心观点。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 63400,
      "end_ms": 64065,
      "text": "观点一，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 64500,
      "end_ms": 65895,
      "text": "制度是长出来的，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 66110,
      "end_ms": 67135,
      "text": "不是画出来的。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 67620,
      "end_ms": 70015,
      "text": "钱穆开篇就甩出一个颠覆性认知，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 70380,
      "end_ms": 73695,
      "text": "中国历代政治制度从来不是某个天才设计的，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 73970,
      "end_ms": 75910,
      "text": "而是从土壤里生长出来的。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 75950,
      "end_ms": 77090,
      "text": "汉朝搞郡县制，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 77210,
      "end_ms": 79105,
      "text": "是因为周朝分封制玩崩了。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 79610,
      "end_ms": 82920,
      "text": "唐朝用科举制是因为贵族集团尾大不掉，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 83000,
      "end_ms": 84920,
      "text": "每个制度在诞生时都是解药，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 85160,
      "end_ms": 87165,
      "text": "只是时间久了变成新病灶。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 87930,
      "end_ms": 91000,
      "text": "就像你家里那张传了三代的木头桌子边，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 91000,
      "end_ms": 91825,
      "text": "角膜亮了，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 92120,
      "end_ms": 93075,
      "text": "笋头松动了，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 93400,
      "end_ms": 95700,
      "text": "但每道痕迹都是生活的见证，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 95880,
      "end_ms": 96880,
      "text": "制度也会包浆，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 97160,
      "end_ms": 97985,
      "text": "也会开裂，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 98270,
      "end_ms": 99525,
      "text": "但不能因为他救了。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 99680,
      "end_ms": 100575,
      "text": "就骂他是废品。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 101140,
      "end_ms": 101745,
      "text": "观点二，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 102130,
      "end_ms": 105880,
      "text": "黄泉与象泉的千年拔河最精彩的解读。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 105940,
      "end_ms": 108340,
      "text": "在汉代宰相制钱穆说，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 108560,
      "end_ms": 111335,
      "text": "汉代宰相是秘书处长错，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 111790,
      "end_ms": 114670,
      "text": "那是真正的一人之下万人之上。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 114750,
      "end_ms": 116050,
      "text": "皇帝诏书没有宰相，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 116050,
      "end_ms": 117085,
      "text": "附属就是废纸。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 117520,
      "end_ms": 118945,
      "text": "宰相不仅有行政权，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 119230,
      "end_ms": 120635,
      "text": "才能封驳皇帝意见，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 120980,
      "end_ms": 122720,
      "text": "直到汉武帝搞内朝夺权，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 123080,
      "end_ms": 125255,
      "text": "宰相才慢慢变成磕头大臣。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 125830,
      "end_ms": 128295,
      "text": "这就像公司CEO和董事会的关系，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 128750,
      "end_ms": 133270,
      "text": "最初董事会能制约CEO.后来CEO把自己的助理提拔成高管，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 133490,
      "end_ms": 134810,
      "text": "慢慢架空了董事会。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 134950,
      "end_ms": 136825,
      "text": "这场权力博弈持续千年，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 137150,
      "end_ms": 142945,
      "text": "直到明朝朱元璋彻底废除宰相制观点单科举不是八股文的锅，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 143410,
      "end_ms": 144450,
      "text": "提到科举就骂，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 144450,
      "end_ms": 146345,
      "text": "八股文前目冷笑。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 146860,
      "end_ms": 148340,
      "text": "唐代科举考诗赋，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 148640,
      "end_ms": 149700,
      "text": "宋代考精益，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 149940,
      "end_ms": 151505,
      "text": "明代才定型为八股。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 152010,
      "end_ms": 153425,
      "text": "在门阀世袭的年代，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 153760,
      "end_ms": 156495,
      "text": "科举让寒门子弟能靠着读书改命，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 156860,
      "end_ms": 158815,
      "text": "这简直是颠覆性的社会革命。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 159120,
      "end_ms": 160835,
      "text": "就像现在高考再被诟病，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 161090,
      "end_ms": 163495,
      "text": "仍是底层跨越阶层最公平的路径。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 164300,
      "end_ms": 167515,
      "text": "唐代有人唱着太宗皇帝珍长册，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 167840,
      "end_ms": 169785,
      "text": "赚得英雄尽白头，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 170430,
      "end_ms": 173715,
      "text": "皇帝用考试这把锁链拴住天下聪明人，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 174000,
      "end_ms": 175880,
      "text": "但也给了他们向上的阶梯。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 176000,
      "end_ms": 176695,
      "text": "观点四，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 177330,
      "end_ms": 179770,
      "text": "赋税制度是王朝的呼吸节奏，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 180050,
      "end_ms": 182885,
      "text": "租庸调制两税法一条编法。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 183240,
      "end_ms": 187025,
      "text": "这些枯燥名词被钱穆讲成了王朝的生命体征报告。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 187630,
      "end_ms": 191885,
      "text": "唐代租庸调向现代个税每人交定量的两步。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 192350,
      "end_ms": 192870,
      "text": "不劳役，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 192990,
      "end_ms": 194365,
      "text": "但随着土地兼并严重，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 194610,
      "end_ms": 195490,
      "text": "安史之乱后，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 195530,
      "end_ms": 196310,
      "text": "不得不改行。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 196350,
      "end_ms": 199775,
      "text": "两税法从按人收费变成按财产收费。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 200210,
      "end_ms": 202625,
      "text": "最震撼的是明朝一条编法，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 203040,
      "end_ms": 205640,
      "text": "张居正把田赋徭役杂税，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 205780,
      "end_ms": 206880,
      "text": "折成银两征收，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 207000,
      "end_ms": 208140,
      "text": "看似简化税制，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 208240,
      "end_ms": 209615,
      "text": "却埋下致命隐患。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 210030,
      "end_ms": 212010,
      "text": "农民要卖粮、换银交税，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 212250,
      "end_ms": 215460,
      "text": "中间被商人盘剥一层白银流通不足时，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 215600,
      "end_ms": 216825,
      "text": "甚至要卖儿卖女。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 217200,
      "end_ms": 220420,
      "text": "一个好处衷如何一步步变成百姓的枷索。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 220540,
      "end_ms": 221345,
      "text": "观点五，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 221760,
      "end_ms": 223985,
      "text": "军队是王朝的免疫系统，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 224410,
      "end_ms": 226755,
      "text": "府兵制牧兵制位所制。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 227380,
      "end_ms": 230345,
      "text": "每个军事制度都是王朝的免疫系统重建。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 230780,
      "end_ms": 233240,
      "text": "唐代府兵制最精妙士兵，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 233240,
      "end_ms": 236980,
      "text": "平时种地战时自备武器出征国家省了军费，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 237080,
      "end_ms": 238515,
      "text": "还避免了军阀割据。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 239000,
      "end_ms": 240140,
      "text": "但随着战争延长，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 240420,
      "end_ms": 241560,
      "text": "农民不堪重负，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 241800,
      "end_ms": 242620,
      "text": "终于崩溃。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 242840,
      "end_ms": 245355,
      "text": "宋朝的杯酒释兵权看似聪明，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 245590,
      "end_ms": 247005,
      "text": "却导致军事积弱。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 247450,
      "end_ms": 248755,
      "text": "钱穆痛心疾首，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 249280,
      "end_ms": 252000,
      "text": "赵匡胤为防军阀割禁绝武将掌权，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 252300,
      "end_ms": 253685,
      "text": "结果文人带兵打仗，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 253910,
      "end_ms": 255490,
      "text": "对外战争胜率不到三成，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 255670,
      "end_ms": 259155,
      "text": "过度防御的免疫系统反而让王朝死于并发症。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 259500,
      "end_ms": 260020,
      "text": "观点六，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 260380,
      "end_ms": 262265,
      "text": "地方政府的三明治困境，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 262640,
      "end_ms": 265900,
      "text": "钱穆用央帝关系解构历代王朝死穴。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 266040,
      "end_ms": 270925,
      "text": "汉代郡守能自主辟暑疗蜀唐代刺史甚至有就地处决权。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 271510,
      "end_ms": 272210,
      "text": "到明清时，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 272450,
      "end_ms": 274970,
      "text": "县令连修个桥都要上报地方，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 274970,
      "end_ms": 276390,
      "text": "活力被层层掐灭。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 276490,
      "end_ms": 278470,
      "text": "这就像大公司病创业期，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 278530,
      "end_ms": 280070,
      "text": "各地分公司大胆创新，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 280370,
      "end_ms": 280950,
      "text": "壮大后，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 280970,
      "end_ms": 282265,
      "text": "总部拼命收权，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 282610,
      "end_ms": 284810,
      "text": "最后所有决策都要等红头文件，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 284930,
      "end_ms": 286895,
      "text": "明朝县令薪资低到要饿死，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 287260,
      "end_ms": 289640,
      "text": "清官海瑞母亲过寿才能买两斤肉。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 289940,
      "end_ms": 290965,
      "text": "如何不贪污？"
    },
    {
      "segment_id": "s000121",
      "start_ms": 291400,
      "end_ms": 294115,
      "text": "关键七、历史的眼镜不能反着戴。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 294550,
      "end_ms": 297605,
      "text": "钱穆最狠批驳是历史倒视镜现象，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 297910,
      "end_ms": 300615,
      "text": "拿着现代民主标准去审判古代制度，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 300930,
      "end_ms": 301790,
      "text": "就像骂古人，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 301810,
      "end_ms": 302830,
      "text": "为什么不用手机？"
    },
    {
      "segment_id": "s000126",
      "start_ms": 303110,
      "end_ms": 304905,
      "text": "郡县制在秦朝是进步，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 305280,
      "end_ms": 306785,
      "text": "科举在隋唐是革命。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 307170,
      "end_ms": 308910,
      "text": "不能因为他们后来僵化了，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 308910,
      "end_ms": 309930,
      "text": "就否定全部。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 310570,
      "end_ms": 311250,
      "text": "他比喻说，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 311570,
      "end_ms": 316090,
      "text": "我们不能因为长大穿了四十三码鞋就骂童年穿的布鞋是废物，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 316190,
      "end_ms": 319090,
      "text": "每个制度都曾是与时代搏斗的智慧结晶。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 319650,
      "end_ms": 319990,
      "text": "观点。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 319990,
      "end_ms": 321790,
      "text": "八、制度疲倦症，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 322390,
      "end_ms": 324710,
      "text": "每个王朝都死于代谢衰竭，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 325210,
      "end_ms": 326810,
      "text": "钱穆提出惊人冻见。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 327170,
      "end_ms": 330270,
      "text": "每个制度执行到后期都会出现制度疲倦，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 330830,
      "end_ms": 332430,
      "text": "好比新官上任三把火，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 332750,
      "end_ms": 334170,
      "text": "三个月后开始摸鱼。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 334330,
      "end_ms": 336230,
      "text": "明代锦衣卫最初是监察精英，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 336230,
      "end_ms": 338160,
      "text": "后其变成特务组织。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 338540,
      "end_ms": 340800,
      "text": "清代八骑兵入关时骁勇善战，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 341040,
      "end_ms": 342700,
      "text": "百年后连马都骑不上。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 342980,
      "end_ms": 344080,
      "text": "这不是道德滑坡，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 344360,
      "end_ms": 345940,
      "text": "而是制度性代谢衰竭，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 346260,
      "end_ms": 347680,
      "text": "缺乏自我更新机制，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 347900,
      "end_ms": 349660,
      "text": "就像人体衰老不可避免。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 350280,
      "end_ms": 350860,
      "text": "观点九，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 351460,
      "end_ms": 354460,
      "text": "谁在给历史化妆最刺骨的观点？"
    },
    {
      "segment_id": "s000150",
      "start_ms": 354520,
      "end_ms": 356500,
      "text": "关于历史书写钱穆说，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 356860,
      "end_ms": 359140,
      "text": "二十四史是胜利者的日记，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 359500,
      "end_ms": 361600,
      "text": "但失败者未必没有道理。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 362260,
      "end_ms": 363640,
      "text": "秦始皇焚书坑儒，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 363840,
      "end_ms": 365500,
      "text": "却统一了文字、度量衡。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 366160,
      "end_ms": 367550,
      "text": "武则天篡堂自立，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 367730,
      "end_ms": 369105,
      "text": "却打破门阀垄断。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 369550,
      "end_ms": 372305,
      "text": "我们要看清历史化妆术下的真容颜。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 372790,
      "end_ms": 373590,
      "text": "他比喻历史，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 373650,
      "end_ms": 375465,
      "text": "像被反复涂改的羊皮卷，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 375940,
      "end_ms": 377720,
      "text": "我们需要用刀刮开表层，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 378040,
      "end_ms": 379805,
      "text": "看见那些被覆盖的笔记。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 380220,
      "end_ms": 380795,
      "text": "观点时，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 381190,
      "end_ms": 383385,
      "text": "中国政治的血脉从未断绝。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 383700,
      "end_ms": 385865,
      "text": "终极观点落在文化延续性上。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 386650,
      "end_ms": 389385,
      "text": "钱穆反对满清误国三百年的论调。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 390010,
      "end_ms": 393340,
      "text": "满清继承明志明继承元志元，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 393340,
      "end_ms": 394225,
      "text": "继承宋治，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 394560,
      "end_ms": 397000,
      "text": "每个朝代都在前朝基础上修修补补。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 397280,
      "end_ms": 399465,
      "text": "中华政治有着惊人的延续性，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 399870,
      "end_ms": 401570,
      "text": "就像长江流经各省段，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 401590,
      "end_ms": 402210,
      "text": "名字不同，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 402470,
      "end_ms": 404135,
      "text": "但水脉从未断绝。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 404510,
      "end_ms": 405950,
      "text": "这种延续性不是守旧，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 406190,
      "end_ms": 407575,
      "text": "而是文明的韧性。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 408110,
      "end_ms": 409585,
      "text": "钱穆在书末写道，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 410090,
      "end_ms": 413105,
      "text": "任何一制度绝不会绝对有利而无弊，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 413410,
      "end_ms": 415395,
      "text": "也不会绝对有弊而无利。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 415700,
      "end_ms": 416440,
      "text": "我们读历史，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 416640,
      "end_ms": 417805,
      "text": "不是为了骂祖宗，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 418150,
      "end_ms": 420110,
      "text": "而是理解每个选择背后的艰难。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 420130,
      "end_ms": 420615,
      "text": "权衡。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 420950,
      "end_ms": 423085,
      "text": "这本书写于一九五二年的香港，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 423450,
      "end_ms": 425105,
      "text": "当时钱穆流亡海外，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 425380,
      "end_ms": 427085,
      "text": "在新亚书院毕露蓝旅。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 428080,
      "end_ms": 433005,
      "text": "他目睹中国传统文化被全盘否定痛心疾首的写下这些演讲，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 433380,
      "end_ms": 436385,
      "text": "试图唤回国人对历史的温情与敬意。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 437010,
      "end_ms": 439365,
      "text": "如果你觉得自己活在制度的夹缝中，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 439730,
      "end_ms": 443395,
      "text": "不妨看看历代官员如何在与制度的博弈中寻找空间。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 444110,
      "end_ms": 445325,
      "text": "如果你对现实失望，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 445620,
      "end_ms": 447935,
      "text": "不妨看看那些曾经努力过的改革者。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 448660,
      "end_ms": 449475,
      "text": "商鞅车裂，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 449730,
      "end_ms": 454915,
      "text": "王安石罢相张居正掘坟改变制度从来是九死一生，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 455360,
      "end_ms": 458340,
      "text": "最终极的启示或许是没有完美的制度，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 458500,
      "end_ms": 460760,
      "text": "只有不断自省和调整的智慧。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 460920,
      "end_ms": 461715,
      "text": "制度会老，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 462010,
      "end_ms": 463595,
      "text": "但革新可以重生，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 464470,
      "end_ms": 466635,
      "text": "就像那棵生长千年的银杏树，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 467040,
      "end_ms": 468740,
      "text": "树干中空了树梢，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 468820,
      "end_ms": 469875,
      "text": "还会发出新芽。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 470640,
      "end_ms": 471360,
      "text": "今天的我们，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 471420,
      "end_ms": 472905,
      "text": "站在历史链条的末端，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 473240,
      "end_ms": 474915,
      "text": "也站在新链条的起点。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 475730,
      "end_ms": 476810,
      "text": "你准备如何理解？"
    },
    {
      "segment_id": "s000204",
      "start_ms": 476810,
      "end_ms": 480535,
      "text": "你身处的制度又将在其中扮演怎样的角色？"
    },
    {
      "segment_id": "s000205",
      "start_ms": 481340,
      "end_ms": 482055,
      "text": "感谢聆听，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 482770,
      "end_ms": 483625,
      "text": "我是小海龟。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 484400,
      "end_ms": 487105,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "9dcff3685445519c745932c927d9980b93c0e88692c9a9c32a281d9d8c3bec4e"
}