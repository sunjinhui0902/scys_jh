{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_3b5e02e2296f859a_u001",
  "video_id": "v_3b5e02e2296f859a",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 427.270998,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 340,
      "end_ms": 2340,
      "text": "萨特为什么越想做自己，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2540,
      "end_ms": 3600,
      "text": "越容易被定义？"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4220,
      "end_ms": 7080,
      "text": "用诺贝尔奖换你一辈子被这个头衔绑架，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7300,
      "end_ms": 7980,
      "text": "你换吗？"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8520,
      "end_ms": 9340,
      "text": "一九六四年，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 9660,
      "end_ms": 10960,
      "text": "萨特给出的答案是，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 11140,
      "end_ms": 13660,
      "text": "不他公开去领诺贝尔文学奖，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 13960,
      "end_ms": 14920,
      "text": "并在声明里说，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 15380,
      "end_ms": 18020,
      "text": "作家应该拒绝让自己转变成一个机构。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 18400,
      "end_ms": 19160,
      "text": "在他看来，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 19460,
      "end_ms": 20240,
      "text": "一旦接受，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 20320,
      "end_ms": 21860,
      "text": "他就不再是自由的萨特，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 22160,
      "end_ms": 24000,
      "text": "而会被固定成一个公共标签，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 24300,
      "end_ms": 25980,
      "text": "任由大众打量和评判。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 26340,
      "end_ms": 27240,
      "text": "但六年过去，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 27460,
      "end_ms": 29545,
      "text": "他却亲手利用了这件事。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 30090,
      "end_ms": 30450,
      "text": "那时，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 30770,
      "end_ms": 32470,
      "text": "一份激进报纸遭到查禁，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 32950,
      "end_ms": 35550,
      "text": "两任主编先后被捕萨特，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 35550,
      "end_ms": 40610,
      "text": "主动把自己的名字印在报纸上上街散发明摆着等着被捕。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 40910,
      "end_ms": 42130,
      "text": "警察确实抓了他，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 42370,
      "end_ms": 44090,
      "text": "但一小时后又乖乖放人。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 44590,
      "end_ms": 45750,
      "text": "因为所有人都知道，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 46169,
      "end_ms": 47970,
      "text": "无名小卒可以随便关押，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 48310,
      "end_ms": 50070,
      "text": "但大名鼎鼎的萨特不行，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 50490,
      "end_ms": 51810,
      "text": "曾经拒斥标签的人，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 52190,
      "end_ms": 54250,
      "text": "此刻却把他当成免死金牌。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 55070,
      "end_ms": 57310,
      "text": "这种矛盾逼出了一个现实的困境，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 58050,
      "end_ms": 59945,
      "text": "不管你多想做纯粹的自己，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 60240,
      "end_ms": 61755,
      "text": "那个被社会盖章的身份，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 62040,
      "end_ms": 64685,
      "text": "早就成了你无法单方面取消的实体。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 65480,
      "end_ms": 66845,
      "text": "萨特对此早有体会。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 67290,
      "end_ms": 67970,
      "text": "七岁那年，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 68270,
      "end_ms": 70515,
      "text": "外祖父剪掉了她漂亮的金色卷发，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 71080,
      "end_ms": 73885,
      "text": "一个右眼斜视的丑孩子暴露在镜子前。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 74320,
      "end_ms": 77125,
      "text": "母亲看见他的新模样躲进房间大哭。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 77580,
      "end_ms": 78215,
      "text": "多年后，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 78500,
      "end_ms": 79155,
      "text": "他写道，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 79710,
      "end_ms": 82265,
      "text": "我甚至无法判断这张脸是美是丑。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 82880,
      "end_ms": 85685,
      "text": "我想他丑是因为别人这么对我说，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 86260,
      "end_ms": 89215,
      "text": "我们最早的自我认知往往来自他人的评价。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 89590,
      "end_ms": 92955,
      "text": "聪明迟钝、懂事、叛逆。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 93870,
      "end_ms": 94050,
      "text": "人，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 94050,
      "end_ms": 97165,
      "text": "总喜欢用别人怎么看我不重要来安慰自己。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 97630,
      "end_ms": 98565,
      "text": "可萨特发现，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 98950,
      "end_ms": 101305,
      "text": "他人的目光已永远无法抹去。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 102360,
      "end_ms": 104555,
      "text": "他在存在与虚无里设计过一个场景，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 105100,
      "end_ms": 106095,
      "text": "你正趴在门上，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 106390,
      "end_ms": 108465,
      "text": "全神贯注的从钥匙孔往里偷看，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 109080,
      "end_ms": 110805,
      "text": "就是你根本没想自己是谁，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 111280,
      "end_ms": 112655,
      "text": "忽然背后传来脚步声，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 112910,
      "end_ms": 114955,
      "text": "你猛的回头那一瞬，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 115390,
      "end_ms": 120565,
      "text": "你在别人的目光里看见了一个自己那个正在偷窥的可耻的自己，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 121040,
      "end_ms": 121985,
      "text": "这没有冤枉你，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 122320,
      "end_ms": 123395,
      "text": "你确实在偷看，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 124300,
      "end_ms": 127040,
      "text": "可他也不是你的全部麻烦，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 127040,
      "end_ms": 129020,
      "text": "在于别人眼里的那个。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 129020,
      "end_ms": 130625,
      "text": "你一旦出现，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 131080,
      "end_ms": 131945,
      "text": "便由不得你，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 132490,
      "end_ms": 134635,
      "text": "就像无意中看到聚会丑照里的自己，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 135050,
      "end_ms": 135810,
      "text": "脚趾抠地，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 135970,
      "end_ms": 136905,
      "text": "却无法辩解。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 137600,
      "end_ms": 138715,
      "text": "这就是萨特说的，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 139160,
      "end_ms": 140275,
      "text": "他人及地狱。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 140830,
      "end_ms": 143995,
      "text": "他人的目光总是有一种剥夺人自由的魔力，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 144400,
      "end_ms": 145620,
      "text": "他把你定在标签上，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 145900,
      "end_ms": 147855,
      "text": "把你变成一个任由平判的物体。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 148240,
      "end_ms": 150365,
      "text": "我们从来不是只活在自己的眼睛里，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 150870,
      "end_ms": 151730,
      "text": "但奇怪的是，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 151970,
      "end_ms": 153335,
      "text": "我们害怕被定义，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 153670,
      "end_ms": 156345,
      "text": "却又极度渴望找到一个定义来安放自己。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 156860,
      "end_ms": 158385,
      "text": "萨特观察过一个服务员，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 158880,
      "end_ms": 161225,
      "text": "他走路转身端盘子，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 161790,
      "end_ms": 164365,
      "text": "每一下都在拼命扮演完美服务员，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 164770,
      "end_ms": 166615,
      "text": "就像小孩拼命装成大人。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 166980,
      "end_ms": 168285,
      "text": "他对此很是好奇，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 168860,
      "end_ms": 171975,
      "text": "为什么人们会如此渴望扮演一个既定的角色？"
    },
    {
      "segment_id": "s000078",
      "start_ms": 172440,
      "end_ms": 173620,
      "text": "就像做完人格测试，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 174080,
      "end_ms": 175155,
      "text": "跳出四个字母，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 175480,
      "end_ms": 176895,
      "text": "很多人如释重负，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 177510,
      "end_ms": 178615,
      "text": "原来我是爱人，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 179020,
      "end_ms": 180175,
      "text": "原来我是回避型，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 180830,
      "end_ms": 182235,
      "text": "难怪我以前会那样。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 182670,
      "end_ms": 184685,
      "text": "萨特把这种状态叫做自欺。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 185440,
      "end_ms": 186500,
      "text": "我们之所以这样做，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 186940,
      "end_ms": 189135,
      "text": "恰恰是因为做人太累了，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 189800,
      "end_ms": 193395,
      "text": "每时每刻都要面对无限选择并承担后果，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 193840,
      "end_ms": 196175,
      "text": "但标签可以替你的未来免责，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 196590,
      "end_ms": 197375,
      "text": "我就是内向，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 197590,
      "end_ms": 198605,
      "text": "做不到也正常。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 199100,
      "end_ms": 199685,
      "text": "慢慢的，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 199990,
      "end_ms": 202175,
      "text": "我们主动把自己冻结成一个物体，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 202540,
      "end_ms": 204725,
      "text": "由此便能逃避自由的重担。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 205850,
      "end_ms": 207355,
      "text": "但标签都是牢笼吗？"
    },
    {
      "segment_id": "s000095",
      "start_ms": 207990,
      "end_ms": 208755,
      "text": "这可未必。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 209200,
      "end_ms": 212455,
      "text": "日本作家村田沙耶香在便利店工作了十八年，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 213020,
      "end_ms": 214790,
      "text": "他说穿上制服，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 215130,
      "end_ms": 216695,
      "text": "按手册微笑收银，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 217140,
      "end_ms": 218680,
      "text": "反而让他暂时摆脱了。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 218680,
      "end_ms": 219600,
      "text": "作为一个女人，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 219640,
      "end_ms": 221375,
      "text": "该是什么样的沉重期待。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 221850,
      "end_ms": 223425,
      "text": "外卖诗人王继斌也承认，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 223830,
      "end_ms": 225310,
      "text": "外卖员这个标签装不下，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 225310,
      "end_ms": 228075,
      "text": "他却让他在无数写作者中被看见，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 228430,
      "end_ms": 229855,
      "text": "甚至对他恩重如山。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 230430,
      "end_ms": 230810,
      "text": "所以，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 231100,
      "end_ms": 232725,
      "text": "标签本身并无恶意，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 233170,
      "end_ms": 237235,
      "text": "真正的危险是某一种标签开始垄断对你的全部解释。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 237620,
      "end_ms": 242510,
      "text": "比如玛丽莲梦露诺马剪被制片厂包装成金发有物，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 242930,
      "end_ms": 245030,
      "text": "这个标签让他被全世界看见，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 245390,
      "end_ms": 247650,
      "text": "也让他再也不能被当成一个普通演员。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 247930,
      "end_ms": 249330,
      "text": "他成立自己的制片公司，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 249630,
      "end_ms": 251190,
      "text": "跑去演员工作室学表演，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 251490,
      "end_ms": 253870,
      "text": "想拿梦露这块招牌去争取一点自由。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 254390,
      "end_ms": 256870,
      "text": "可观众和资本只认那个金发符号，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 257570,
      "end_ms": 259170,
      "text": "他越想挣脱标签，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 259170,
      "end_ms": 259870,
      "text": "越像铁笼，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 260470,
      "end_ms": 261670,
      "text": "标签能给人位置，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 261970,
      "end_ms": 263630,
      "text": "也能把人锁死在位置上，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 264170,
      "end_ms": 266330,
      "text": "但标签还有更冷酷的一面。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 266410,
      "end_ms": 267170,
      "text": "在文学里，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 267290,
      "end_ms": 268810,
      "text": "外卖员是王继斌的勋章，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 268810,
      "end_ms": 270680,
      "text": "可一但进入平台，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 270960,
      "end_ms": 274800,
      "text": "这三个字就成了由单量和好评拼凑的数据系统。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 274800,
      "end_ms": 276060,
      "text": "不关心他写不写诗，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 276380,
      "end_ms": 277560,
      "text": "只关心这个位置上，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 277560,
      "end_ms": 280120,
      "text": "有没有人能送单一个骑手下线，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 280300,
      "end_ms": 281980,
      "text": "另一个瞬间补上系统。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 281980,
      "end_ms": 282880,
      "text": "为了高效运转，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 283100,
      "end_ms": 286160,
      "text": "必须把极其复杂的人降维成可替换的编号。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 286660,
      "end_ms": 287240,
      "text": "在这里，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 287360,
      "end_ms": 288860,
      "text": "萨特的追问开始转变，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 289220,
      "end_ms": 290780,
      "text": "从标签怎样解释，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 290780,
      "end_ms": 292260,
      "text": "我变成了身份，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 292360,
      "end_ms": 293280,
      "text": "怎样安排我。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 293600,
      "end_ms": 295680,
      "text": "他百年描述过一群等公交的人，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 296240,
      "end_ms": 297180,
      "text": "他们站在一起，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 297600,
      "end_ms": 298680,
      "text": "看似是个群体，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 298920,
      "end_ms": 299725,
      "text": "却彼此陌生。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 299830,
      "end_ms": 300070,
      "text": "嗯，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 300350,
      "end_ms": 301470,
      "text": "甚至因为座位有限，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 301610,
      "end_ms": 302525,
      "text": "互为竞争者，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 302860,
      "end_ms": 305175,
      "text": "一个人上去就会把另一个人挤下来，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 305790,
      "end_ms": 307065,
      "text": "把他们捆绑在一起的，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 307300,
      "end_ms": 309475,
      "text": "只有线路时刻表和座位数。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 309890,
      "end_ms": 311170,
      "text": "这说明人离得再近，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 311430,
      "end_ms": 313570,
      "text": "也只是同一个系统里的不同零件。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 314090,
      "end_ms": 316210,
      "text": "就像今天员工互不相识，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 316510,
      "end_ms": 318050,
      "text": "却在同一套技校里厮杀，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 318290,
      "end_ms": 319850,
      "text": "几十万考生从未谋面，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 320070,
      "end_ms": 322190,
      "text": "却被同一条分数线死死绑定。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 322310,
      "end_ms": 324650,
      "text": "没有谁在刻意把你变成编号系统。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 324650,
      "end_ms": 326850,
      "text": "为了运行本来就指认编号。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 327230,
      "end_ms": 331990,
      "text": "萨特用实践惰性概括了这种异化最初人发明指标衡量工作，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 332410,
      "end_ms": 334270,
      "text": "后来却为了指标表演工作，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 334950,
      "end_ms": 336550,
      "text": "昨天的人造出了规则，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 336910,
      "end_ms": 339245,
      "text": "今天的人沦为规则的囚徒。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 339960,
      "end_ms": 340360,
      "text": "这时，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 340500,
      "end_ms": 344240,
      "text": "现代人的困境就不再只是我是不是太在意别人的目光。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 344720,
      "end_ms": 348420,
      "text": "因为真正的限制已经变成了制度指标和算法。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 349260,
      "end_ms": 350340,
      "text": "你再怎么默念，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 350480,
      "end_ms": 351720,
      "text": "我不等于这个标签。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 351980,
      "end_ms": 353280,
      "text": "我拥有丰富的灵魂，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 353600,
      "end_ms": 355839,
      "text": "也无法让既定的规则为你让路，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 356100,
      "end_ms": 358720,
      "text": "更无法让鸿蒙系统为你停留片刻。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 358800,
      "end_ms": 359140,
      "text": "所以，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 359320,
      "end_ms": 361120,
      "text": "真正困难的问题终于出现，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 361420,
      "end_ms": 363600,
      "text": "如果这些限制都是真的自由，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 363600,
      "end_ms": 364560,
      "text": "到底还有什么用？"
    },
    {
      "segment_id": "s000170",
      "start_ms": 365000,
      "end_ms": 367280,
      "text": "一九七零年的萨特给出了一种回答，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 367680,
      "end_ms": 369710,
      "text": "他明白萨特已是继承事。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 369790,
      "end_ms": 372645,
      "text": "十、于是拿起这块招牌去保护普通人。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 373220,
      "end_ms": 375445,
      "text": "所以自由如果还有意义，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 375770,
      "end_ms": 377910,
      "text": "他绝不是只要我内心不认同，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 378150,
      "end_ms": 378570,
      "text": "现实，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 378570,
      "end_ms": 379625,
      "text": "就奈何不了我。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 380050,
      "end_ms": 382050,
      "text": "出身过去制度，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 382050,
      "end_ms": 384210,
      "text": "这些冰冷的条件不会凭空消失，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 384370,
      "end_ms": 386855,
      "text": "自由只能发生在限制之中。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 387250,
      "end_ms": 388745,
      "text": "看你还能拿他们做点什么，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 389230,
      "end_ms": 391435,
      "text": "但这其中有一道必须守住的边界，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 391940,
      "end_ms": 394115,
      "text": "我有权重新使用自己的身份，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 394500,
      "end_ms": 396720,
      "text": "却无权替别人决定他是谁。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 396840,
      "end_ms": 397180,
      "text": "此前，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 397500,
      "end_ms": 399500,
      "text": "萨特善意的为黑人诗歌作序，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 399840,
      "end_ms": 402865,
      "text": "将其定义为走向普遍解放的一个阶段。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 403190,
      "end_ms": 406075,
      "text": "哲学家法农却用萨特的理论反过来批评他。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 406610,
      "end_ms": 408650,
      "text": "萨特一生教人挣脱定义，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 408790,
      "end_ms": 411005,
      "text": "却险些替别人写死结局。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 411460,
      "end_ms": 412320,
      "text": "别人眼里的你，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 412320,
      "end_ms": 413200,
      "text": "不是你的全部。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 413560,
      "end_ms": 414020,
      "text": "同样，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 414220,
      "end_ms": 418110,
      "text": "你眼里的别人也不是所有的标签与打量，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 418310,
      "end_ms": 420315,
      "text": "充其量只能总结你的过去，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 420640,
      "end_ms": 421980,
      "text": "但没有任何一种定义，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 422140,
      "end_ms": 423945,
      "text": "能为你提前写好结局。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 424340,
      "end_ms": 425040,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 425280,
      "end_ms": 426560,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 426560,
      "end_ms": 427135,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "2810b4c979204b8a93c8d68368e0a702e67fd4bd97c6793a0161ba12840fc989"
}