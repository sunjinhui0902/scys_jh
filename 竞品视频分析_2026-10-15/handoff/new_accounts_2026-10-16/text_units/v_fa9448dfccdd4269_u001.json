{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_fa9448dfccdd4269_u001",
  "video_id": "v_fa9448dfccdd4269",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 481.327007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 310,
      "end_ms": 1110,
      "text": "八分钟讲解，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1110,
      "end_ms": 2350,
      "text": "余春台穷通宝剑，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 2430,
      "end_ms": 3310,
      "text": "你敢相信吗？"
    },
    {
      "segment_id": "s000004",
      "start_ms": 3550,
      "end_ms": 6190,
      "text": "余春台晚年做过一件非常奇怪的事情，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 6330,
      "end_ms": 8630,
      "text": "直到今天依然被无数人误解。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 8870,
      "end_ms": 9290,
      "text": "原来，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 9490,
      "end_ms": 12230,
      "text": "他不仅精通诗词、文学、术术命理，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 12510,
      "end_ms": 15970,
      "text": "还悄悄的干了一件让整个命理学界都闭嘴的事儿。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 16290,
      "end_ms": 20610,
      "text": "他用清代学者的方式去打碎江湖命师千年不传的秘密。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 20950,
      "end_ms": 22890,
      "text": "而帮他完成这项秘密任务的人，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 22890,
      "end_ms": 27490,
      "text": "就叫徐乐无一位浙江武元东海出身的世家子弟，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 27670,
      "end_ms": 28590,
      "text": "清朝光绪年间，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 28590,
      "end_ms": 32960,
      "text": "余春台在楚鲁南得到了一本江湖救籍蓝江网。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 33300,
      "end_ms": 35960,
      "text": "这本书相传为明代江湖命师所传，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 36240,
      "end_ms": 38220,
      "text": "是江湖人士压箱底的秘本。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 38540,
      "end_ms": 39240,
      "text": "数百年来，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 39260,
      "end_ms": 40740,
      "text": "由于传抄错误甚多，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 40940,
      "end_ms": 42060,
      "text": "早已面目全非。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 42700,
      "end_ms": 44040,
      "text": "有人向他推荐此书，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 44240,
      "end_ms": 45820,
      "text": "建议他为此书做著书，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 46140,
      "end_ms": 49720,
      "text": "填补子平命理学在调后论命法上的一块空白。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 50060,
      "end_ms": 51080,
      "text": "余春台批阅后，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 51080,
      "end_ms": 51440,
      "text": "发现，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 51740,
      "end_ms": 53180,
      "text": "此书论述精细，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 53360,
      "end_ms": 54200,
      "text": "取舍得当，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 54440,
      "end_ms": 56660,
      "text": "便以毕生经历反复研读，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 56900,
      "end_ms": 58520,
      "text": "潜心挖掘其中奥义。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 58940,
      "end_ms": 59895,
      "text": "他删繁就简，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 60150,
      "end_ms": 61850,
      "text": "细加编辑重新命名，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 61850,
      "end_ms": 63445,
      "text": "为琼通宝剑，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 63980,
      "end_ms": 66660,
      "text": "终结了这本书数百年的手抄本历史。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 66780,
      "end_ms": 68380,
      "text": "当时全中国没几个人，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 68380,
      "end_ms": 69945,
      "text": "能看懂这本江湖秘本，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 70190,
      "end_ms": 71555,
      "text": "但徐乐无看懂了。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 72070,
      "end_ms": 72790,
      "text": "民国时期，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 73010,
      "end_ms": 74870,
      "text": "徐乐武反复研读此书，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 75050,
      "end_ms": 76410,
      "text": "不禁岿然而叹。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 76610,
      "end_ms": 78010,
      "text": "斯书毅力深邃，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 78230,
      "end_ms": 80600,
      "text": "因文字拙陋为世所倾，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 80940,
      "end_ms": 81905,
      "text": "甚为可惜，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 82260,
      "end_ms": 83620,
      "text": "声恐淹没失传。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 84060,
      "end_ms": 85120,
      "text": "勉为评著，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 85320,
      "end_ms": 89740,
      "text": "他将实战经验结合推命法则添补加注逻辑清晰，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 89960,
      "end_ms": 91205,
      "text": "哲学思想浓厚，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 91510,
      "end_ms": 94135,
      "text": "将书名改为造化原药瓶注。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 94460,
      "end_ms": 94805,
      "text": "从此，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 95110,
      "end_ms": 99190,
      "text": "穷通宝剑与三命通会滴天髓子凭真权，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 99390,
      "end_ms": 101335,
      "text": "并称为命学四书，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 101730,
      "end_ms": 102470,
      "text": "成为命理学。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 102470,
      "end_ms": 104530,
      "text": "史上一座难以超越的方碑，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 104730,
      "end_ms": 107055,
      "text": "余春台和徐乐无究竟做了什么？"
    },
    {
      "segment_id": "s000052",
      "start_ms": 107520,
      "end_ms": 111795,
      "text": "他们把千年江湖秘传第一次拉进了学术殿堂。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 112070,
      "end_ms": 114290,
      "text": "这本书以月令气候为基准，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 114450,
      "end_ms": 116275,
      "text": "构建调后论命法，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 116650,
      "end_ms": 118855,
      "text": "通过五行生克调后寒暖，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 119270,
      "end_ms": 121070,
      "text": "提出食干实物说，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 121370,
      "end_ms": 125195,
      "text": "形成甲庚丁、循环系统等五大技术框架。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 125670,
      "end_ms": 126095,
      "text": "其中，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 126220,
      "end_ms": 129780,
      "text": "甲庚丁三干之间存在非丁不以造庚，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 130060,
      "end_ms": 132220,
      "text": "非庚不能造假的循环，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 132240,
      "end_ms": 132980,
      "text": "生刻关系，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 133140,
      "end_ms": 133965,
      "text": "缺一不可。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 134310,
      "end_ms": 136290,
      "text": "全书以阴阳五行为经，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 136570,
      "end_ms": 137705,
      "text": "以月令为伪，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 138020,
      "end_ms": 138900,
      "text": "辅以寒暖，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 138920,
      "end_ms": 139475,
      "text": "调厚。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 139810,
      "end_ms": 140650,
      "text": "以官为首，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 140870,
      "end_ms": 141830,
      "text": "以财为次，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 142030,
      "end_ms": 142945,
      "text": "独树一帜。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 143460,
      "end_ms": 145960,
      "text": "他的论述模式具有查字典式的特点，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 146100,
      "end_ms": 147885,
      "text": "被称为子平之模范。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 148210,
      "end_ms": 152905,
      "text": "将八字五十二万种变化简化为特定季节干支配伍规则，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 153370,
      "end_ms": 158475,
      "text": "形成某日干生于某月干透或支藏某某物的论断形式。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 158870,
      "end_ms": 159990,
      "text": "更令人震撼的是，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 160090,
      "end_ms": 163410,
      "text": "这本书首次提出调后这一独特的论明。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 163410,
      "end_ms": 168585,
      "text": "方法论命的主要依据是立足每月的实际气候与日主之间的关系，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 169010,
      "end_ms": 175730,
      "text": "依实际天时气候情况优先于月令秉兽之正五行来论述命局春木虚火，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 175730,
      "end_ms": 178270,
      "text": "暖夏木耐水润秋木，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 178330,
      "end_ms": 180855,
      "text": "用金雕冬木借火驱寒。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 181340,
      "end_ms": 186795,
      "text": "其核心在于通过月令气候与日主关系分析天干原相的造化机理，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 187110,
      "end_ms": 189390,
      "text": "强调调后用神的动态平衡。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 189590,
      "end_ms": 190530,
      "text": "徐乐武曾说，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 190990,
      "end_ms": 191950,
      "text": "此书看法，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 192130,
      "end_ms": 193970,
      "text": "尽托旧事命书之槽，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 193970,
      "end_ms": 195670,
      "text": "旧四正四篇，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 195970,
      "end_ms": 198575,
      "text": "吉凶神煞盖型平除，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 199000,
      "end_ms": 202040,
      "text": "专从实干性情理气进退配合，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 202040,
      "end_ms": 203140,
      "text": "喜记而定，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 203160,
      "end_ms": 204195,
      "text": "格局之高下。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 204730,
      "end_ms": 205825,
      "text": "洗法出于经验，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 206060,
      "end_ms": 207515,
      "text": "发钱人所未发。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 208070,
      "end_ms": 208520,
      "text": "然而，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 208640,
      "end_ms": 210035,
      "text": "这条路走的并不容易，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 210290,
      "end_ms": 212070,
      "text": "余春台生平已不可考，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 212430,
      "end_ms": 214930,
      "text": "现存文献只有徐乐无在叙中说，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 215190,
      "end_ms": 217070,
      "text": "他是光绪年间的楚南人，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 217250,
      "end_ms": 220130,
      "text": "我们只知道他热衷于诗词、文学和术数。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 220130,
      "end_ms": 222190,
      "text": "命理在得到兰江网后，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 222330,
      "end_ms": 224545,
      "text": "以毕生经历反复研读，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 224850,
      "end_ms": 225670,
      "text": "潜心挖掘。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 225670,
      "end_ms": 227490,
      "text": "其中奥义细加编卷，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 227730,
      "end_ms": 228635,
      "text": "删繁就简，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 228920,
      "end_ms": 230320,
      "text": "最终编撰成书。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 230520,
      "end_ms": 231920,
      "text": "此书去粗取精，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 232120,
      "end_ms": 232980,
      "text": "言简意明，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 233140,
      "end_ms": 233920,
      "text": "层次分明，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 234100,
      "end_ms": 234995,
      "text": "井然有序。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 235290,
      "end_ms": 238895,
      "text": "但当时的命理学界充斥着各种江湖术士和假丹师，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 239310,
      "end_ms": 241030,
      "text": "一本来自江湖秘本的书。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 241310,
      "end_ms": 242965,
      "text": "要想被正统学界接受，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 243260,
      "end_ms": 244175,
      "text": "谈何容易。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 244690,
      "end_ms": 245810,
      "text": "于春台一介书生，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 246010,
      "end_ms": 246955,
      "text": "断人饭碗，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 247280,
      "end_ms": 248420,
      "text": "江湖上有人骂他，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 248580,
      "end_ms": 249505,
      "text": "有人威胁他。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 249740,
      "end_ms": 250605,
      "text": "但他没有放弃。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 251230,
      "end_ms": 257755,
      "text": "他将四十年的治学心血全部押进了这本最通俗、最严谨、最正统的命理经典。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 258110,
      "end_ms": 258850,
      "text": "民国时期，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 259090,
      "end_ms": 261425,
      "text": "徐乐无接过余春台的衣波。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 261940,
      "end_ms": 263500,
      "text": "这位出身氏族的学者，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 263580,
      "end_ms": 265340,
      "text": "早年从政后居上海，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 265420,
      "end_ms": 267625,
      "text": "专研命理从事职业算命。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 267960,
      "end_ms": 271000,
      "text": "四十年代曾南下香港常住高级酒店，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 271000,
      "end_ms": 272330,
      "text": "为人算命局势，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 272390,
      "end_ms": 277540,
      "text": "是近代子平命理家中书房派的代表对子评古籍用功甚深，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 277860,
      "end_ms": 281040,
      "text": "并整理订正完善子评古典理论。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 281120,
      "end_ms": 283660,
      "text": "他自评八字断自己死于戊子，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 283660,
      "end_ms": 286170,
      "text": "年后果然足于戊子年。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 286330,
      "end_ms": 288670,
      "text": "民国时与袁术山为千里，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 288670,
      "end_ms": 289155,
      "text": "齐名，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 289470,
      "end_ms": 290550,
      "text": "为近代命理学。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 290550,
      "end_ms": 293930,
      "text": "大家徐乐无在评注琼通宝剑时，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 294190,
      "end_ms": 297890,
      "text": "将实战经验结合推命法则添补加注，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 298050,
      "end_ms": 298895,
      "text": "逻辑清晰，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 299260,
      "end_ms": 300405,
      "text": "哲学思想浓厚，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 300900,
      "end_ms": 302885,
      "text": "书后附有增补乐坛赋。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 303290,
      "end_ms": 306670,
      "text": "四书子平两篇皆征验平断之法。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 306770,
      "end_ms": 307450,
      "text": "民国以来，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 307670,
      "end_ms": 310690,
      "text": "本书一直被视子平命理学必读经典。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 310770,
      "end_ms": 314510,
      "text": "但真正让人动容的是这本书背后的传承精神。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 314890,
      "end_ms": 317210,
      "text": "余春台和徐乐无两代学者，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 317390,
      "end_ms": 321210,
      "text": "用毕生心血守护着中华命理学的正统脉络。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 321550,
      "end_ms": 323190,
      "text": "他们没有把知识藏在深山，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 323490,
      "end_ms": 325410,
      "text": "没有用玄虚来收割信徒，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 325750,
      "end_ms": 329050,
      "text": "而是把千年秘传写成普通人能读懂的文字。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 329190,
      "end_ms": 333005,
      "text": "琼通宝剑是诸多命理著作中内容最易懂的一部古籍。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 333580,
      "end_ms": 334420,
      "text": "更重要的是，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 334580,
      "end_ms": 338180,
      "text": "他首次提出调后这一独特的论命方法。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 338620,
      "end_ms": 341900,
      "text": "他让命理学从江湖迷信走向学术殿堂，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 342200,
      "end_ms": 345060,
      "text": "让普通人也能接触到正统的命理知识。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 345100,
      "end_ms": 347100,
      "text": "现代学者对此书的评价极高。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 347520,
      "end_ms": 348360,
      "text": "有学者指出，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 348680,
      "end_ms": 354640,
      "text": "琼通宝剑的用神调后论是以反映人类生活的四柱八字为五行生克的方式，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 354960,
      "end_ms": 357200,
      "text": "指向了阴阳平衡的中和境界，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 357420,
      "end_ms": 360620,
      "text": "从而能够造成生态主义的可待续生活的余地。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 360760,
      "end_ms": 362300,
      "text": "若以治学眼光视之，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 362620,
      "end_ms": 364490,
      "text": "渊海子平偏于法式，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 364490,
      "end_ms": 364945,
      "text": "纲目，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 365320,
      "end_ms": 366900,
      "text": "低天水偏于毅力，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 366900,
      "end_ms": 369045,
      "text": "提炼琼通宝剑，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 369300,
      "end_ms": 373385,
      "text": "则更着重时令气候与调后配合之操作层面，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 373690,
      "end_ms": 379705,
      "text": "故在子贫学发展史上具有承前启后、由格局而进入气候论的枢纽意义。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 380340,
      "end_ms": 382175,
      "text": "中国命理学界有一句老话，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 382760,
      "end_ms": 384240,
      "text": "论命者为八字，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 384240,
      "end_ms": 386000,
      "text": "有服役格局，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 386340,
      "end_ms": 388325,
      "text": "那英调后诸说，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 388840,
      "end_ms": 391000,
      "text": "而以此书为调后之学。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 391140,
      "end_ms": 396665,
      "text": "民间另有抄本、造化、玄耀与此书当属同一来源而颇有异同。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 397140,
      "end_ms": 399080,
      "text": "但余春台和徐乐无的贡献，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 399260,
      "end_ms": 400885,
      "text": "不仅仅是学术上的，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 401240,
      "end_ms": 402080,
      "text": "他们的精神，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 402220,
      "end_ms": 404375,
      "text": "是一种对中华文明的守护。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 404700,
      "end_ms": 407660,
      "text": "他们把千年秘传从江湖迷信中拉出来，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 407820,
      "end_ms": 410700,
      "text": "把断裂的命理脉络一根一根接回去，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 410940,
      "end_ms": 413020,
      "text": "把真正的学问留给后人。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 413140,
      "end_ms": 414785,
      "text": "他们用最通俗的语言，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 415110,
      "end_ms": 416470,
      "text": "讲最严谨的道理，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 416630,
      "end_ms": 419370,
      "text": "让普通人有机会接触到正统的命理学，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 419630,
      "end_ms": 421415,
      "text": "而不是被江湖神棍收割。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 421680,
      "end_ms": 423185,
      "text": "不是被劣质白话欺骗，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 423430,
      "end_ms": 424595,
      "text": "不是越修越偏。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 425200,
      "end_ms": 427725,
      "text": "这本书的价值不在于它能预测什么，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 427990,
      "end_ms": 429910,
      "text": "而在于他教会你如何思考。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 430110,
      "end_ms": 430790,
      "text": "他告诉你，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 431010,
      "end_ms": 432625,
      "text": "命理学的根源在哪里，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 432870,
      "end_ms": 433705,
      "text": "脉络怎么走，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 433940,
      "end_ms": 434800,
      "text": "逻辑是什么，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 434820,
      "end_ms": 435745,
      "text": "误区在哪里？"
    },
    {
      "segment_id": "s000189",
      "start_ms": 435930,
      "end_ms": 436805,
      "text": "他没有迷信，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 437170,
      "end_ms": 438085,
      "text": "没有玄虚，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 438580,
      "end_ms": 441340,
      "text": "只有一位清代学者和一位民国学者，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 441400,
      "end_ms": 443720,
      "text": "把道学的根源单道的脉络。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 443900,
      "end_ms": 444840,
      "text": "内丹的逻辑，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 444960,
      "end_ms": 445885,
      "text": "历史的误区，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 446160,
      "end_ms": 448165,
      "text": "用大白话讲的明明白白。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 448530,
      "end_ms": 449230,
      "text": "在这个领域，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 449430,
      "end_ms": 450565,
      "text": "有学术地位的，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 450760,
      "end_ms": 452735,
      "text": "没有余春台那般江湖实证，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 453140,
      "end_ms": 454275,
      "text": "有江湖实证的，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 454470,
      "end_ms": 458155,
      "text": "没有徐乐无那般科学严谨、有科学严谨的，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 458490,
      "end_ms": 460970,
      "text": "没有穷通宝剑那般正统道统。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 461170,
      "end_ms": 462630,
      "text": "如果你厌倦了江湖骗术，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 462650,
      "end_ms": 463830,
      "text": "不想被伪学收割，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 464090,
      "end_ms": 465965,
      "text": "想踏踏实实亲近命理学，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 466280,
      "end_ms": 468945,
      "text": "那这本书值得放在枕边相伴一生，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 469600,
      "end_ms": 471140,
      "text": "余春台和徐乐无花了。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 471140,
      "end_ms": 472520,
      "text": "两代人跨越，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 472560,
      "end_ms": 473280,
      "text": "清末明初，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 473500,
      "end_ms": 474735,
      "text": "为你开了一条路。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 475220,
      "end_ms": 477830,
      "text": "你只需要翻开第一页就能走上去。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 477990,
      "end_ms": 478745,
      "text": "我是小海龟。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 479040,
      "end_ms": 480550,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 480550,
      "end_ms": 481205,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "f3c8ed770effb5226bb97d6abddfa98e38336590a73a9327007e66ba6b1478ec"
}