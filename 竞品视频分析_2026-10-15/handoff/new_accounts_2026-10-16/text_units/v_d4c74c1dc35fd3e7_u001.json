{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_d4c74c1dc35fd3e7_u001",
  "video_id": "v_d4c74c1dc35fd3e7",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 782.861995,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 70,
      "end_ms": 530,
      "text": "上集，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 530,
      "end_ms": 6690,
      "text": "咱们聊了钟南山、武当山、峨眉山、梅里雪山、神农架这集，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6990,
      "end_ms": 8370,
      "text": "直接揭开谜底，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 8770,
      "end_ms": 11230,
      "text": "看看前五名到底神秘到什么程度。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 11970,
      "end_ms": 16610,
      "text": "尤其是排在榜首的那一座两千多年前的古籍里就记载了他。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 17410,
      "end_ms": 18410,
      "text": "可直到今天，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 18810,
      "end_ms": 20570,
      "text": "学界对古昆仑究竟在哪，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 20790,
      "end_ms": 22230,
      "text": "依旧没有统一说法。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 23070,
      "end_ms": 24710,
      "text": "老规矩开讲之前，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 24710,
      "end_ms": 26850,
      "text": "劳烦您扣个一点个红心。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 28490,
      "end_ms": 29030,
      "text": "第五名。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 29030,
      "end_ms": 32200,
      "text": "三千多青山在江西这座山，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 32200,
      "end_ms": 32980,
      "text": "奇特之处，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 32980,
      "end_ms": 37020,
      "text": "就在它的奇石一根石柱从山体拔地而起。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 37800,
      "end_ms": 39480,
      "text": "据地质勘测资料，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 39880,
      "end_ms": 41760,
      "text": "石柱高达一百二十八米，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 42040,
      "end_ms": 44040,
      "text": "孤零零矗立在悬崖边上，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 44380,
      "end_ms": 47580,
      "text": "像一条昂首玉冲向天际的巨蟒，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 48040,
      "end_ms": 49620,
      "text": "当地人叫她巨蟒出山，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 49920,
      "end_ms": 51480,
      "text": "旁边还有一块巨石，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 51960,
      "end_ms": 53520,
      "text": "形似端坐的女神，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 53740,
      "end_ms": 54840,
      "text": "便是东方女神。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 55340,
      "end_ms": 56400,
      "text": "地质学家解释，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 56840,
      "end_ms": 61395,
      "text": "巨蟒出山是在两组不同方向的岩石结理基础上，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 61810,
      "end_ms": 64885,
      "text": "经过冰冻裂解寒冻风化，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 65560,
      "end_ms": 72665,
      "text": "从山体风墙分离出来的巨型花岗岩石柱历经三亿多年地质演化才形成。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 73470,
      "end_ms": 75940,
      "text": "可您站在山下抬头仰望风，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 75940,
      "end_ms": 77240,
      "text": "身上分布好几道，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 77240,
      "end_ms": 81275,
      "text": "横向裂痕最细的地方直径只有约七米，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 81710,
      "end_ms": 82745,
      "text": "却稳稳屹立，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 83170,
      "end_ms": 86055,
      "text": "难免让人感叹大自然的神奇。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 86530,
      "end_ms": 88435,
      "text": "三清山的名字也很有讲究。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 88690,
      "end_ms": 101295,
      "text": "御精、御虚、御华三座主峰山体排布形态和道教三位至高神盾的元始天尊、灵宝天尊、道德天尊的形象相呼应，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 102080,
      "end_ms": 106595,
      "text": "古人便以此取名叫它三清山一座山，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 107440,
      "end_ms": 110075,
      "text": "山形气和道教三清的意向。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 110740,
      "end_ms": 114495,
      "text": "这份自然与人文的巧合足够神秘。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 115330,
      "end_ms": 116025,
      "text": "第四名，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 116950,
      "end_ms": 121940,
      "text": "港仁波齐在西藏阿里这座山，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 121940,
      "end_ms": 124435,
      "text": "海拔六千六百五十六米，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 124880,
      "end_ms": 127035,
      "text": "虽不是青藏高原最高的山峰，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 127350,
      "end_ms": 132785,
      "text": "却是全球少有被多个宗教共同尊奉为神山的山峰。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 133600,
      "end_ms": 141005,
      "text": "佛教印度教本教对应的教内教都将港仁波齐视作世界的中心，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 141490,
      "end_ms": 144135,
      "text": "山体外形也十分独特，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 144760,
      "end_ms": 146640,
      "text": "四面近乎对称，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 146720,
      "end_ms": 150705,
      "text": "如同巨大的金字塔山顶终年积雪，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 151070,
      "end_ms": 154485,
      "text": "阳光洒落在峰顶金光流转，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 155150,
      "end_ms": 157345,
      "text": "仿佛通往天界的阶梯。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 158240,
      "end_ms": 159825,
      "text": "网上流传一种说法，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 160370,
      "end_ms": 165820,
      "text": "他和周边几座著名高峰之间的距离存在整数倍的关联，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 165900,
      "end_ms": 169000,
      "text": "究竟是纯粹巧合还是另有缘由？"
    },
    {
      "segment_id": "s000051",
      "start_ms": 169140,
      "end_ms": 170505,
      "text": "至今没有定论。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 171270,
      "end_ms": 176195,
      "text": "每年无数信徒从印度、尼泊尔藏区各地赶来，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 176580,
      "end_ms": 177600,
      "text": "绕着港人波起，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 177600,
      "end_ms": 180885,
      "text": "转山完整转山一圈五十二公里，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 181560,
      "end_ms": 185400,
      "text": "途中最高要翻越五千六百多米的山口，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 185480,
      "end_ms": 188055,
      "text": "不少信徒会反复转山，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 188460,
      "end_ms": 190615,
      "text": "用脚步丈量心中的信仰。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 191420,
      "end_ms": 192095,
      "text": "您想想，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 192330,
      "end_ms": 193175,
      "text": "一座山峰，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 193540,
      "end_ms": 197115,
      "text": "能被四种不同的宗教共同奉为圣地，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 198310,
      "end_ms": 200965,
      "text": "这份文化分量十分难得。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 202400,
      "end_ms": 203005,
      "text": "第三名，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 204220,
      "end_ms": 208315,
      "text": "武陵山在重庆和贵州交界。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 209230,
      "end_ms": 215665,
      "text": "武陵山里有一座大名鼎鼎的梵净山，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 216570,
      "end_ms": 218175,
      "text": "山上有两块奇景，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 220440,
      "end_ms": 221340,
      "text": "红云金顶，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 221500,
      "end_ms": 222315,
      "text": "一座孤峰，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 222550,
      "end_ms": 223845,
      "text": "从中间一分为二，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 224220,
      "end_ms": 227510,
      "text": "仿佛被巨腐从天劈开两半。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 227530,
      "end_ms": 228305,
      "text": "封顶之间，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 228800,
      "end_ms": 230760,
      "text": "仅靠一座石桥相连，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 230780,
      "end_ms": 232875,
      "text": "桥下便是万丈深渊。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 233550,
      "end_ms": 234870,
      "text": "站在桥上往下看，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 235070,
      "end_ms": 236535,
      "text": "难免心惊腿软。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 237430,
      "end_ms": 239460,
      "text": "最让人惊叹的是，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 239480,
      "end_ms": 241315,
      "text": "金鼎之上的两座庙宇，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 242010,
      "end_ms": 243475,
      "text": "一边供奉释迦佛，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 243860,
      "end_ms": 245260,
      "text": "一边供奉弥勒佛，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 245600,
      "end_ms": 247405,
      "text": "中间石桥相连。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 247860,
      "end_ms": 249105,
      "text": "建筑学者介绍，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 250080,
      "end_ms": 252735,
      "text": "古人利用山顶狭小的平台，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 253200,
      "end_ms": 256895,
      "text": "依托食材与木料逐步修建而成。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 257910,
      "end_ms": 260630,
      "text": "可我们站在桥上俯瞰悬崖的时候，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 261030,
      "end_ms": 262825,
      "text": "依旧会心生疑惑。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 263430,
      "end_ms": 264275,
      "text": "当年的工匠，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 264640,
      "end_ms": 268260,
      "text": "究竟是怎样把砖马木料运上这险峻封顶？"
    },
    {
      "segment_id": "s000087",
      "start_ms": 268380,
      "end_ms": 271655,
      "text": "明代朝廷曾下旨誓赐山中寺院，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 272370,
      "end_ms": 273125,
      "text": "梵净山，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 273450,
      "end_ms": 275390,
      "text": "由此成为知名佛教道场。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 276070,
      "end_ms": 281685,
      "text": "一座高山在觉险之巅建成佛殿流传千年，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 282450,
      "end_ms": 283450,
      "text": "足够传奇。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 283970,
      "end_ms": 284630,
      "text": "第二名，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 284870,
      "end_ms": 287825,
      "text": "秦岭在陕西南部，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 288560,
      "end_ms": 291200,
      "text": "秦岭不是一座孤峰二十一条，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 291260,
      "end_ms": 292505,
      "text": "绵延的山脉，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 293300,
      "end_ms": 295415,
      "text": "东西长达一千五百公里，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 296290,
      "end_ms": 299345,
      "text": "天然划分出中国南方与北方。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 299850,
      "end_ms": 304050,
      "text": "而他最引人遐想的地方不在山岭之上。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 304290,
      "end_ms": 305670,
      "text": "而在山脚下，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 306930,
      "end_ms": 309670,
      "text": "秦始皇陵就坐落于秦岭脚下。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 310210,
      "end_ms": 311290,
      "text": "据史记记载，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 311690,
      "end_ms": 315350,
      "text": "秦始皇从即位之初便开始修建陵寝，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 315990,
      "end_ms": 319010,
      "text": "前后历时三十九年修建工程，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 319070,
      "end_ms": 321350,
      "text": "动用劳工七十余万人。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 321690,
      "end_ms": 322770,
      "text": "史书中描述，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 322850,
      "end_ms": 325290,
      "text": "地宫以水营为百川，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 325330,
      "end_ms": 326950,
      "text": "江河大海上。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 327030,
      "end_ms": 331420,
      "text": "据天文下聚地陵现代物探探测发现，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 332120,
      "end_ms": 337660,
      "text": "秦陵风土核心区域的汞含量高出周边土壤七十多倍，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 338120,
      "end_ms": 341180,
      "text": "印证了史书关于水银江河的记载，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 341200,
      "end_ms": 346680,
      "text": "并非单纯文学想象七十余万人三十九年的浩大工程，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 347140,
      "end_ms": 348840,
      "text": "地宫规模可想而知。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 349520,
      "end_ms": 349880,
      "text": "但是，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 349880,
      "end_ms": 350580,
      "text": "直到今天，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 351180,
      "end_ms": 355180,
      "text": "国家都没有发掘秦始皇陵为什么不发掘？"
    },
    {
      "segment_id": "s000116",
      "start_ms": 355420,
      "end_ms": 358600,
      "text": "核心原因是文物保护技术尚有局限，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 359120,
      "end_ms": 360225,
      "text": "贸然开挖，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 361100,
      "end_ms": 363145,
      "text": "地宫密闭环境被打破。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 363860,
      "end_ms": 369045,
      "text": "丝帛、木器漆器彩绘这类脆弱有机质文物，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 369460,
      "end_ms": 372930,
      "text": "很容易瞬间氧化损毁文物。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 372930,
      "end_ms": 374885,
      "text": "修复专家吴永奇曾说，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 375380,
      "end_ms": 377100,
      "text": "如果我们有先进技术，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 377520,
      "end_ms": 381860,
      "text": "能够在地面不打开陵墓的条件下了解里面的东西，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 381880,
      "end_ms": 383160,
      "text": "而不去打扰这个。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 383460,
      "end_ms": 387400,
      "text": "睡了两千年的老人以后也不要动一座山脉，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 387480,
      "end_ms": 390825,
      "text": "脚下埋藏着一座封存两千年，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 391150,
      "end_ms": 392985,
      "text": "暂不发掘的庞大帝宫，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 393340,
      "end_ms": 393580,
      "text": "嗯，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 394140,
      "end_ms": 396565,
      "text": "自带一层厚重的神秘色彩。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 397100,
      "end_ms": 397780,
      "text": "说到这儿，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 397780,
      "end_ms": 399865,
      "text": "我得跟一部分朋友说句实在话，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 400330,
      "end_ms": 403695,
      "text": "咱们这个年纪有些地方是真去不了了。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 404100,
      "end_ms": 408295,
      "text": "华山长空栈道年轻人上去都腿软，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 408860,
      "end_ms": 409900,
      "text": "咱们就别逞强，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 409940,
      "end_ms": 414320,
      "text": "梅里雪山就连专业登山队都难以登顶，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 414340,
      "end_ms": 416280,
      "text": "咱们就在心里竞争可去不了，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 416280,
      "end_ms": 417165,
      "text": "不代表看不了。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 418220,
      "end_ms": 423015,
      "text": "我手边这本大美中国人一生要去的一百零一个地方，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 423670,
      "end_ms": 427450,
      "text": "把咱们国内值得游览的山水圣地一一收录。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 427450,
      "end_ms": 427785,
      "text": "其中。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 428690,
      "end_ms": 430850,
      "text": "书籍配图精美翻开，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 430850,
      "end_ms": 432605,
      "text": "就是大幅风光插画。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 433370,
      "end_ms": 435695,
      "text": "您坐在家里泡上一杯茶，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 436120,
      "end_ms": 437525,
      "text": "随手翻几页，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 438250,
      "end_ms": 440435,
      "text": "就如同亲身游历一般。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 441680,
      "end_ms": 443185,
      "text": "书中内容详实，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 443590,
      "end_ms": 447715,
      "text": "不少知识点比普通导游介绍的更丰富。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 448380,
      "end_ms": 450560,
      "text": "哪个诗人在此留下名篇？"
    },
    {
      "segment_id": "s000149",
      "start_ms": 450760,
      "end_ms": 453280,
      "text": "哪位帝王在此留下故事？"
    },
    {
      "segment_id": "s000150",
      "start_ms": 453460,
      "end_ms": 454415,
      "text": "一触一景，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 454660,
      "end_ms": 455925,
      "text": "讲的明明白白，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 456370,
      "end_ms": 460925,
      "text": "有机会出行的朋友可以出门前翻一翻到了目的地。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 461350,
      "end_ms": 463635,
      "text": "看懂背后的山水故事，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 464030,
      "end_ms": 465535,
      "text": "暂时没办法远行，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 465970,
      "end_ms": 467565,
      "text": "翻翻书看看插图，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 468000,
      "end_ms": 469675,
      "text": "也算云游大好河山。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 470570,
      "end_ms": 473755,
      "text": "感兴趣的朋友下方小黄车可以进去看看，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 474530,
      "end_ms": 475955,
      "text": "大家按需选购，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 477140,
      "end_ms": 478305,
      "text": "暂时走不出去，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 478740,
      "end_ms": 480325,
      "text": "咱就把祖国装进屋里。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 481310,
      "end_ms": 481625,
      "text": "好，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 481900,
      "end_ms": 482625,
      "text": "社会政体，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 483470,
      "end_ms": 483985,
      "text": "第一名，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 485140,
      "end_ms": 485815,
      "text": "昆仑山。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 486880,
      "end_ms": 488420,
      "text": "昆仑山不是一座山峰，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 488440,
      "end_ms": 490085,
      "text": "而是一条庞大山脉。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 490450,
      "end_ms": 492875,
      "text": "从新疆一直延伸到青海，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 493340,
      "end_ms": 494955,
      "text": "全长两千五百公里。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 495850,
      "end_ms": 499445,
      "text": "它最特别的地方不在于绵延的体谅，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 500110,
      "end_ms": 503555,
      "text": "而在于他是刻在中国人文化记忆里的神山。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 504150,
      "end_ms": 505225,
      "text": "山海经记载，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 505620,
      "end_ms": 506540,
      "text": "西海之南，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 506760,
      "end_ms": 508720,
      "text": "流沙之滨赤水之后，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 508960,
      "end_ms": 511050,
      "text": "黑水之前有大山，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 511370,
      "end_ms": 512895,
      "text": "名曰昆仑之秋。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 513730,
      "end_ms": 514370,
      "text": "古籍说，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 514510,
      "end_ms": 515870,
      "text": "昆仑山是天地的，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 515870,
      "end_ms": 517785,
      "text": "下都是西王母的居所，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 518210,
      "end_ms": 519630,
      "text": "是众神之乡，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 520230,
      "end_ms": 521470,
      "text": "万山之祖。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 521870,
      "end_ms": 530045,
      "text": "夸父追日、共工处不周山、西王母、不死药、后羿射日、嫦娥奔月、女娲补天。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 530770,
      "end_ms": 533310,
      "text": "这些华夏最古老的神话传说，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 533930,
      "end_ms": 536255,
      "text": "全都和昆仑山紧紧相连。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 537110,
      "end_ms": 538655,
      "text": "但有一个千古谜题，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 539140,
      "end_ms": 540515,
      "text": "古籍里记载的古昆仑，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 540870,
      "end_ms": 542775,
      "text": "确切的点至今没有定论。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 543480,
      "end_ms": 546195,
      "text": "有人认为就是今天这座昆仑山脉，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 546650,
      "end_ms": 547450,
      "text": "也有人认为，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 547450,
      "end_ms": 549875,
      "text": "古昆仑是古人想象之中的神山，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 550310,
      "end_ms": 554985,
      "text": "是远古人心目中西方最高凡人难以抵达的大山。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 555900,
      "end_ms": 558725,
      "text": "这个争论从汉代延续至今，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 559110,
      "end_ms": 561550,
      "text": "学术界依旧没有统一答案。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 561650,
      "end_ms": 562270,
      "text": "一座山，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 562490,
      "end_ms": 567170,
      "text": "它的原型位置两千年一直争论不休，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 567510,
      "end_ms": 569465,
      "text": "这本身就充满神秘感。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 570230,
      "end_ms": 571805,
      "text": "如今的昆仑山脉里，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 572120,
      "end_ms": 574145,
      "text": "有一处呢棱格勒峡谷，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 574840,
      "end_ms": 577425,
      "text": "当地牧民叫他地狱之门。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 577850,
      "end_ms": 578670,
      "text": "羊群靠近，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 578670,
      "end_ms": 580345,
      "text": "这里常会掉头折返，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 580740,
      "end_ms": 583085,
      "text": "宁愿挨饿也不愿进入古中密室。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 583910,
      "end_ms": 584870,
      "text": "一九八三年，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 584870,
      "end_ms": 586815,
      "text": "科考队进入峡谷考察，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 587420,
      "end_ms": 589640,
      "text": "发现谷地埋藏大量强磁性，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 589640,
      "end_ms": 593145,
      "text": "玄武岩存在明显强词异常，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 593740,
      "end_ms": 598075,
      "text": "磁场强度可达一千三千高斯远超普通地磁。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 598900,
      "end_ms": 602840,
      "text": "指南针进入谷内就会疯狂旋转地质。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 602840,
      "end_ms": 603585,
      "text": "研究表明。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 604010,
      "end_ms": 606830,
      "text": "强磁场会促进云层放电，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 607430,
      "end_ms": 609230,
      "text": "让这里成为高频雷暴区，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 609450,
      "end_ms": 611690,
      "text": "奔跑的动物容易遭到雷击。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 612130,
      "end_ms": 614310,
      "text": "一九八三年夏季科考期间，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 614770,
      "end_ms": 616890,
      "text": "科考队遭遇突发雷暴，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 617470,
      "end_ms": 621610,
      "text": "出现人员受伤、马群被雷击烧焦的情况。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 622550,
      "end_ms": 625210,
      "text": "当地牧民中还流传着一个说法，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 625570,
      "end_ms": 629390,
      "text": "早年有牧民禁谷寻找丢失的马匹，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 630090,
      "end_ms": 631070,
      "text": "再也没有出来。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 631930,
      "end_ms": 636000,
      "text": "后来人们发现他的时候以不完好神情惊恐。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 636520,
      "end_ms": 640440,
      "text": "这个故事仅为民间口述传说没有官方记载，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 640740,
      "end_ms": 643780,
      "text": "但那棱格勒峡谷环境凶险是客观事实。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 644180,
      "end_ms": 647140,
      "text": "那棱格勒峡谷这片区域属于管控区域，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 647560,
      "end_ms": 649820,
      "text": "不允许普通人随意进入。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 650180,
      "end_ms": 650780,
      "text": "昆仑山，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 650780,
      "end_ms": 651800,
      "text": "凭什么排第一？"
    },
    {
      "segment_id": "s000225",
      "start_ms": 652460,
      "end_ms": 652940,
      "text": "第一？"
    },
    {
      "segment_id": "s000226",
      "start_ms": 653220,
      "end_ms": 655060,
      "text": "别的山看得见摸得着。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 655280,
      "end_ms": 657600,
      "text": "昆仑山却不只是地理上的山脉，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 658020,
      "end_ms": 659800,
      "text": "更是中国人集体文化。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 659800,
      "end_ms": 660960,
      "text": "想象里的神山，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 661520,
      "end_ms": 664390,
      "text": "是华夏众多古老神话的源头。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 664570,
      "end_ms": 670405,
      "text": "我们从小听到的嫦娥奔月、女娲补天、后羿射日都和他有关。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 671190,
      "end_ms": 671785,
      "text": "第二，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 672110,
      "end_ms": 673310,
      "text": "华夏古籍山海经，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 673310,
      "end_ms": 674205,
      "text": "专门记述它。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 675180,
      "end_ms": 675940,
      "text": "传说中，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 675940,
      "end_ms": 677345,
      "text": "西王母居于此处，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 677780,
      "end_ms": 680065,
      "text": "古代帝王也有相关祭祀。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 680850,
      "end_ms": 682050,
      "text": "两千多年来，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 682210,
      "end_ms": 683595,
      "text": "中国人提起神山，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 684020,
      "end_ms": 686915,
      "text": "最先想到的往往就是昆仑山。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 687770,
      "end_ms": 688250,
      "text": "第三，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 688820,
      "end_ms": 691680,
      "text": "峡谷区域存在强磁场多发，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 691720,
      "end_ms": 693925,
      "text": "雷暴等奇特自然现象，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 694450,
      "end_ms": 695270,
      "text": "不少现象，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 695290,
      "end_ms": 697755,
      "text": "可以用地址、气象科学解释。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 698640,
      "end_ms": 702675,
      "text": "但峡谷的凶险依旧让人对大自然心生敬畏，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 703520,
      "end_ms": 705960,
      "text": "一半扎根在古老神话之中，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 706180,
      "end_ms": 708525,
      "text": "一半藏着凶险的自然秘境，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 709460,
      "end_ms": 712105,
      "text": "这便是昆仑山独有的神秘感。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 713630,
      "end_ms": 715155,
      "text": "从第五到第一名，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 715580,
      "end_ms": 716305,
      "text": "三清山，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 716860,
      "end_ms": 718825,
      "text": "其实与道教文化相应，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 719180,
      "end_ms": 723260,
      "text": "港仁波齐被多宗教共同尊为神山。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 723440,
      "end_ms": 726945,
      "text": "梵净山险峰之上留存古寺。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 727690,
      "end_ms": 733065,
      "text": "秦岭脚下藏着封存两千年的秦陵帝宫，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 733550,
      "end_ms": 737945,
      "text": "昆仑山承载着华夏数千年的神话传说。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 738990,
      "end_ms": 741275,
      "text": "这十座山有的险峻难登，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 741620,
      "end_ms": 742780,
      "text": "有的地处偏远，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 742900,
      "end_ms": 744325,
      "text": "有的环境凶险，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 744620,
      "end_ms": 746075,
      "text": "让人望而却步。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 746560,
      "end_ms": 747685,
      "text": "可唯有昆仑山，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 747990,
      "end_ms": 750565,
      "text": "就连古籍记载的古昆仑究竟在哪？"
    },
    {
      "segment_id": "s000263",
      "start_ms": 752240,
      "end_ms": 755375,
      "text": "两千年以来一直存在争议。"
    },
    {
      "segment_id": "s000264",
      "start_ms": 756440,
      "end_ms": 758690,
      "text": "最后问问你这十座山，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 758690,
      "end_ms": 761915,
      "text": "您去过几座最想去的是哪一座？"
    },
    {
      "segment_id": "s000266",
      "start_ms": 762660,
      "end_ms": 763665,
      "text": "评论区告诉我，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 764710,
      "end_ms": 770040,
      "text": "刚才和大家聊的这本大美中国人一生要去的一百零一个地方橱窗，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 770040,
      "end_ms": 775040,
      "text": "可以找到喜欢山水人文故事的朋友可以按需选购。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 775220,
      "end_ms": 776520,
      "text": "觉得这期长知识了，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 776640,
      "end_ms": 777240,
      "text": "点个赞，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 777340,
      "end_ms": 778000,
      "text": "点个收藏，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 778300,
      "end_ms": 779855,
      "text": "想看更多人文老故事，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 780340,
      "end_ms": 781120,
      "text": "点个关注，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 781300,
      "end_ms": 782785,
      "text": "咱们下回接着聊。"
    }
  ],
  "source_transcript_sha256": "73b015404eff34aee1e6aaf44875b935505ae619fba260773886ac646403d2f4"
}