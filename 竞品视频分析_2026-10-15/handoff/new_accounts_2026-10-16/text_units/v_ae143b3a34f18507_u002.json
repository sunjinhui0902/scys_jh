{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ae143b3a34f18507_u002",
  "video_id": "v_ae143b3a34f18507",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 1033.87,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000345",
      "start_ms": 867790,
      "end_ms": 869110,
      "text": "但会有长久的余因。"
    },
    {
      "segment_id": "s000346",
      "start_ms": 869530,
      "end_ms": 871910,
      "text": "一、理性最诚实的时刻，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 872070,
      "end_ms": 873830,
      "text": "不是他证明了一切的时候，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 874110,
      "end_ms": 875270,
      "text": "而是他终于知道，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 875310,
      "end_ms": 877050,
      "text": "有些事情他证明不了，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 877290,
      "end_ms": 879150,
      "text": "却依然值得被认真谈论。"
    },
    {
      "segment_id": "s000351",
      "start_ms": 879510,
      "end_ms": 881430,
      "text": "二、最沉重的启示，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 881670,
      "end_ms": 883650,
      "text": "不是那些被大声宣告的真理，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 883910,
      "end_ms": 887380,
      "text": "而是那些让理性沉默却从未消失的在场。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 887680,
      "end_ms": 890860,
      "text": "三、当一个人被困在逻辑的方寸之地，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 891140,
      "end_ms": 894560,
      "text": "他却用追问为自己赢得了整个思想史的纵深。"
    },
    {
      "segment_id": "s000356",
      "start_ms": 894660,
      "end_ms": 897140,
      "text": "最后我想认真推荐一次这本书，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 897160,
      "end_ms": 898820,
      "text": "为什么你应该拥有这本书？"
    },
    {
      "segment_id": "s000358",
      "start_ms": 899280,
      "end_ms": 901860,
      "text": "如果你是一个对思想本身感兴趣的人，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 901980,
      "end_ms": 903900,
      "text": "不是对正确答案感兴趣，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 904240,
      "end_ms": 907240,
      "text": "而是对问题为什么是问题感兴趣？"
    },
    {
      "segment_id": "s000361",
      "start_ms": 907860,
      "end_ms": 910900,
      "text": "这本书会是你书架上最耐用的一件工具。"
    },
    {
      "segment_id": "s000362",
      "start_ms": 911060,
      "end_ms": 911500,
      "text": "第一，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 911920,
      "end_ms": 913800,
      "text": "它是西方思想史的一把钥匙。"
    },
    {
      "segment_id": "s000364",
      "start_ms": 913800,
      "end_ms": 917070,
      "text": "你想理解为什么现代世界会变成今天这个样子，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 917270,
      "end_ms": 920630,
      "text": "就必须理解那些被埋在地层深处的思想争论。"
    },
    {
      "segment_id": "s000366",
      "start_ms": 920690,
      "end_ms": 922335,
      "text": "从奥古斯丁到阿奎纳。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 922730,
      "end_ms": 924690,
      "text": "从宗教改革到启蒙运动，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 924950,
      "end_ms": 927510,
      "text": "从巴特到后现代麦格拉斯，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 927510,
      "end_ms": 930030,
      "text": "用一条清晰的线索把它们串了起来。"
    },
    {
      "segment_id": "s000370",
      "start_ms": 930710,
      "end_ms": 931510,
      "text": "读完这本书，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 931750,
      "end_ms": 935530,
      "text": "你看新闻、看电影、看任何关于现代性的讨论，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 935730,
      "end_ms": 937750,
      "text": "都会多一层别人看不见的纵深。"
    },
    {
      "segment_id": "s000373",
      "start_ms": 937890,
      "end_ms": 938230,
      "text": "第二，"
    },
    {
      "segment_id": "s000374",
      "start_ms": 938450,
      "end_ms": 942410,
      "text": "他教你如何在边界上思考我们这个时代最大的认知疾病，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 942590,
      "end_ms": 945330,
      "text": "是很多人以为所有问题都有确定的答案，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 945510,
      "end_ms": 947490,
      "text": "或者所有问题都不值得追问。"
    },
    {
      "segment_id": "s000377",
      "start_ms": 947930,
      "end_ms": 949890,
      "text": "这本书展示的是第三条路，"
    },
    {
      "segment_id": "s000378",
      "start_ms": 950210,
      "end_ms": 951650,
      "text": "诚实的说我不知道，"
    },
    {
      "segment_id": "s000379",
      "start_ms": 951650,
      "end_ms": 953640,
      "text": "但一自然严肃的追问，"
    },
    {
      "segment_id": "s000380",
      "start_ms": 953800,
      "end_ms": 954760,
      "text": "这种思维方式，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 954920,
      "end_ms": 956620,
      "text": "无论你面对的是工作困境，"
    },
    {
      "segment_id": "s000382",
      "start_ms": 956680,
      "end_ms": 957460,
      "text": "人生选择，"
    },
    {
      "segment_id": "s000383",
      "start_ms": 957800,
      "end_ms": 960240,
      "text": "还是一个你无法理解的人都用得上。"
    },
    {
      "segment_id": "s000384",
      "start_ms": 960340,
      "end_ms": 960740,
      "text": "第三，"
    },
    {
      "segment_id": "s000385",
      "start_ms": 961040,
      "end_ms": 963140,
      "text": "他的写法本身就是一种享受。"
    },
    {
      "segment_id": "s000386",
      "start_ms": 963640,
      "end_ms": 966320,
      "text": "麦格拉斯受过分子生物物理学的训练，"
    },
    {
      "segment_id": "s000387",
      "start_ms": 966500,
      "end_ms": 967920,
      "text": "他的头脑极其精确，"
    },
    {
      "segment_id": "s000388",
      "start_ms": 968100,
      "end_ms": 969060,
      "text": "但从不冰冷。"
    },
    {
      "segment_id": "s000389",
      "start_ms": 969440,
      "end_ms": 970620,
      "text": "他写复杂的东西，"
    },
    {
      "segment_id": "s000390",
      "start_ms": 970760,
      "end_ms": 971640,
      "text": "用的是短句，"
    },
    {
      "segment_id": "s000391",
      "start_ms": 971900,
      "end_ms": 973260,
      "text": "用的是清晰的结构，"
    },
    {
      "segment_id": "s000392",
      "start_ms": 973440,
      "end_ms": 975100,
      "text": "用的是你能跟上的节奏。"
    },
    {
      "segment_id": "s000393",
      "start_ms": 975540,
      "end_ms": 977080,
      "text": "你不需要任何预备知识，"
    },
    {
      "segment_id": "s000394",
      "start_ms": 977400,
      "end_ms": 979300,
      "text": "只需要好奇心和耐心。"
    },
    {
      "segment_id": "s000395",
      "start_ms": 979700,
      "end_ms": 980140,
      "text": "第四，"
    },
    {
      "segment_id": "s000396",
      "start_ms": 980580,
      "end_ms": 982385,
      "text": "这是一本你会反复使用的书。"
    },
    {
      "segment_id": "s000397",
      "start_ms": 982730,
      "end_ms": 982880,
      "text": "嗯，"
    },
    {
      "segment_id": "s000398",
      "start_ms": 983090,
      "end_ms": 984650,
      "text": "它不是读完就搁置的那种书，"
    },
    {
      "segment_id": "s000399",
      "start_ms": 984710,
      "end_ms": 986125,
      "text": "你可以把它当参考手册。"
    },
    {
      "segment_id": "s000400",
      "start_ms": 986490,
      "end_ms": 987790,
      "text": "遇到思想上的困惑时，"
    },
    {
      "segment_id": "s000401",
      "start_ms": 987790,
      "end_ms": 990540,
      "text": "翻到相关章节可以每隔几年重读一遍。"
    },
    {
      "segment_id": "s000402",
      "start_ms": 990660,
      "end_ms": 991300,
      "text": "你会发现，"
    },
    {
      "segment_id": "s000403",
      "start_ms": 991340,
      "end_ms": 992840,
      "text": "随着你自己的认知生长，"
    },
    {
      "segment_id": "s000404",
      "start_ms": 993020,
      "end_ms": 993560,
      "text": "这本书里，"
    },
    {
      "segment_id": "s000405",
      "start_ms": 993560,
      "end_ms": 995305,
      "text": "很多话的重量也在变化。"
    },
    {
      "segment_id": "s000406",
      "start_ms": 995810,
      "end_ms": 997745,
      "text": "第五也是最重要的，"
    },
    {
      "segment_id": "s000407",
      "start_ms": 998030,
      "end_ms": 999645,
      "text": "他不会给你虚假的安慰，"
    },
    {
      "segment_id": "s000408",
      "start_ms": 1000090,
      "end_ms": 1000970,
      "text": "他不会告诉你，"
    },
    {
      "segment_id": "s000409",
      "start_ms": 1000990,
      "end_ms": 1002335,
      "text": "一切都会好起来的，"
    },
    {
      "segment_id": "s000410",
      "start_ms": 1002630,
      "end_ms": 1003550,
      "text": "也不会告诉你，"
    },
    {
      "segment_id": "s000411",
      "start_ms": 1003650,
      "end_ms": 1004885,
      "text": "一切都没有意义。"
    },
    {
      "segment_id": "s000412",
      "start_ms": 1005440,
      "end_ms": 1007365,
      "text": "他做的是更艰难的事儿，"
    },
    {
      "segment_id": "s000413",
      "start_ms": 1007720,
      "end_ms": 1010210,
      "text": "他让你看见在理性止步的地方，"
    },
    {
      "segment_id": "s000414",
      "start_ms": 1010470,
      "end_ms": 1012565,
      "text": "人类从来没有停止过追问，"
    },
    {
      "segment_id": "s000415",
      "start_ms": 1013030,
      "end_ms": 1014430,
      "text": "在答案缺席的时候，"
    },
    {
      "segment_id": "s000416",
      "start_ms": 1014690,
      "end_ms": 1016725,
      "text": "追问本身就有尊严。"
    },
    {
      "segment_id": "s000417",
      "start_ms": 1017080,
      "end_ms": 1019275,
      "text": "这本书的第五版五百四十四页，"
    },
    {
      "segment_id": "s000418",
      "start_ms": 1019570,
      "end_ms": 1022035,
      "text": "牛津大学神学教授几十年的心得。"
    },
    {
      "segment_id": "s000419",
      "start_ms": 1022680,
      "end_ms": 1025280,
      "text": "如果你只买一本关于西方思想根基的书，"
    },
    {
      "segment_id": "s000420",
      "start_ms": 1025480,
      "end_ms": 1027520,
      "text": "就是这本点击下方链接，"
    },
    {
      "segment_id": "s000421",
      "start_ms": 1027740,
      "end_ms": 1028645,
      "text": "把它带回家，"
    },
    {
      "segment_id": "s000422",
      "start_ms": 1029170,
      "end_ms": 1030115,
      "text": "你不会后悔的。"
    },
    {
      "segment_id": "s000423",
      "start_ms": 1030570,
      "end_ms": 1031415,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000424",
      "start_ms": 1031770,
      "end_ms": 1033030,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000425",
      "start_ms": 1033030,
      "end_ms": 1033695,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "c5f0aef8b05cf57efceb96b0d99d91a7aee8465eee7c69756ec8463409330b1e"
}