{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_b133ac8fb205de0d_u001",
  "video_id": "v_b133ac8fb205de0d",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 767.629977,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 90,
      "end_ms": 2910,
      "text": "上一集咱们盘了中国十大秋水秘境，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3690,
      "end_ms": 5430,
      "text": "从第十名如情湖，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5470,
      "end_ms": 6870,
      "text": "一路讲到第六名，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6990,
      "end_ms": 8050,
      "text": "闻献天池。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 9130,
      "end_ms": 10690,
      "text": "有朋友在评论区说，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 10970,
      "end_ms": 16309,
      "text": "闻县天池那种陇南深山里一池安静的水已经够让人心动了。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16770,
      "end_ms": 17690,
      "text": "可我跟您说，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18230,
      "end_ms": 21350,
      "text": "闻献天池排第六前五名，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21390,
      "end_ms": 22590,
      "text": "随便拿一个出来，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 22590,
      "end_ms": 24990,
      "text": "都能把它压住榜首，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 25050,
      "end_ms": 31600,
      "text": "那个地方一年只有十几天的秋色窗口去早了没变色，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 32100,
      "end_ms": 32340,
      "text": "去，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 32440,
      "end_ms": 33460,
      "text": "晚了全落光。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 34340,
      "end_ms": 35540,
      "text": "那十几天里，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 35540,
      "end_ms": 37900,
      "text": "湖水的颜色能从蓝变到绿，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 37900,
      "end_ms": 38720,
      "text": "再变回蓝，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 38860,
      "end_ms": 39920,
      "text": "像活的一样，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 40040,
      "end_ms": 40740,
      "text": "还是咱们的。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 40740,
      "end_ms": 41300,
      "text": "老规矩。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 41620,
      "end_ms": 42300,
      "text": "开讲前，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 42300,
      "end_ms": 44580,
      "text": "劳烦各位老友顺手点亮红心。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 44820,
      "end_ms": 50160,
      "text": "评论区打个来了让我看看今天又有多少知音来捧场。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 50620,
      "end_ms": 51760,
      "text": "从第五名开始，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 52980,
      "end_ms": 53680,
      "text": "第五名，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 54180,
      "end_ms": 62145,
      "text": "四川李塘错谱湖措谱湖藏在四川甘孜州、巴塘和礼堂之间的大山深处。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 62960,
      "end_ms": 64245,
      "text": "海拔四千多米，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 65640,
      "end_ms": 66595,
      "text": "这个壶不大，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 67010,
      "end_ms": 69650,
      "text": "但四周的环境好到不像真的。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 69650,
      "end_ms": 71705,
      "text": "三面是五千多米的雪山，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 72460,
      "end_ms": 75000,
      "text": "一面是连绵的高山草甸，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 75140,
      "end_ms": 77805,
      "text": "湖边长着一圈密密的云山和冷山。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 78570,
      "end_ms": 79495,
      "text": "秋天一到，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 80140,
      "end_ms": 80660,
      "text": "草甸，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 80740,
      "end_ms": 81305,
      "text": "先皇，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 82020,
      "end_ms": 84070,
      "text": "然后是湖边的灌木，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 84090,
      "end_ms": 85105,
      "text": "从绿变红，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 85860,
      "end_ms": 87905,
      "text": "云山保持墨绿不动。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 88560,
      "end_ms": 92785,
      "text": "三种颜色裹着一汪蓝绿色的湖水层层分明。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 93640,
      "end_ms": 95255,
      "text": "清晨没有风的时候，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 95800,
      "end_ms": 99745,
      "text": "湖面把雪山、彩云蓝天全部倒映在水里，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 100370,
      "end_ms": 102230,
      "text": "倒影清晰到分不出哪边？"
    },
    {
      "segment_id": "s000042",
      "start_ms": 102230,
      "end_ms": 108435,
      "text": "是真的错谱湖最特别的一点是湖里有一种不怕人的高原萝莉，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 108890,
      "end_ms": 110275,
      "text": "您往湖边一蹲，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 110700,
      "end_ms": 112320,
      "text": "鱼群会自己游过来，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 112320,
      "end_ms": 113080,
      "text": "围在脚边。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 113240,
      "end_ms": 115920,
      "text": "当地藏族人从来不捕这些鱼，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 116320,
      "end_ms": 117745,
      "text": "管他们叫神鱼，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 118140,
      "end_ms": 119465,
      "text": "说虎有灵气，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 119850,
      "end_ms": 120930,
      "text": "鱼也有灵气，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 121410,
      "end_ms": 122775,
      "text": "一汪高原湖泊，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 123100,
      "end_ms": 124265,
      "text": "雪山贴着水面，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 124560,
      "end_ms": 125345,
      "text": "鱼不怕人。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 125890,
      "end_ms": 129405,
      "text": "秋天的颜色从山顶一直铺到湖底，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 129910,
      "end_ms": 132855,
      "text": "这个地方连导航都不太找得准，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 133740,
      "end_ms": 135945,
      "text": "去过的人少之又少。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 136600,
      "end_ms": 137375,
      "text": "第四名，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 138630,
      "end_ms": 146165,
      "text": "西藏然、芜湖然芜湖在西藏昌都八宿县三百十八国道边上。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 146570,
      "end_ms": 148775,
      "text": "很多人走川藏线的时候会路过他，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 149740,
      "end_ms": 152100,
      "text": "可大部分人只是停下来拍张照就走，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 152180,
      "end_ms": 153995,
      "text": "没有在秋天专程去过，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 154320,
      "end_ms": 155595,
      "text": "然后是堰塞湖，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 156060,
      "end_ms": 158560,
      "text": "湖水的颜色随季节变夏天，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 158560,
      "end_ms": 159815,
      "text": "冰川融水量大，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 160070,
      "end_ms": 162225,
      "text": "湖水是浑的灰蓝色，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 162780,
      "end_ms": 165565,
      "text": "可一到秋天融水变少，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 165990,
      "end_ms": 168005,
      "text": "湖水慢慢沉淀下来，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 168900,
      "end_ms": 171755,
      "text": "变成一种安安静静的碧绿色。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 172850,
      "end_ms": 176015,
      "text": "湖的两岸是秘密的原始森林。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 176830,
      "end_ms": 177390,
      "text": "秋天，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 177430,
      "end_ms": 181945,
      "text": "树叶变黄变红和碧绿的湖水配在一起，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 182540,
      "end_ms": 187845,
      "text": "头顶是雪山燃芜湖最动人的时候是清晨，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 188710,
      "end_ms": 190815,
      "text": "太阳还没翻过东边的山，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 191520,
      "end_ms": 193680,
      "text": "湖面上浮着一层薄雾，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 193740,
      "end_ms": 195675,
      "text": "雾气贴着水面慢慢移动，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 196060,
      "end_ms": 199210,
      "text": "远处的雪山只露出山间湖边。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 199430,
      "end_ms": 201425,
      "text": "有几户藏族人家的房子，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 201850,
      "end_ms": 203375,
      "text": "屋顶上冒着炊烟，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 203920,
      "end_ms": 205700,
      "text": "炊烟和晨雾搅在一起，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 205700,
      "end_ms": 209645,
      "text": "分不清哪个是哪个那个画面安静到什么程度呢？"
    },
    {
      "segment_id": "s000080",
      "start_ms": 210000,
      "end_ms": 211965,
      "text": "连鸟叫都显得多余。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 212760,
      "end_ms": 218080,
      "text": "一个堰塞湖夏天浑秋天清清下来之后，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 218080,
      "end_ms": 226025,
      "text": "碧绿碧绿的配着雪山和城雾向谁在高原上打翻了一碟子绿墨水。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 227170,
      "end_ms": 227775,
      "text": "第三名，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 228960,
      "end_ms": 232325,
      "text": "四川松潘黄龙五彩池，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 233250,
      "end_ms": 239495,
      "text": "黄龙五彩池在四川阿坝州松潘县海拔三千五百多米。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 240460,
      "end_ms": 243300,
      "text": "很多人知道九寨沟的五彩池，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 243680,
      "end_ms": 246700,
      "text": "可黄龙的五彩池跟九寨沟不是一回事。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 247540,
      "end_ms": 250260,
      "text": "黄龙的五彩池是六百多个钙化，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 250260,
      "end_ms": 252040,
      "text": "彩池挤在一片山坡，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 252040,
      "end_ms": 253740,
      "text": "上大的像澡盆，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 253740,
      "end_ms": 254620,
      "text": "小的像脸盆，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 254680,
      "end_ms": 258080,
      "text": "一个挨一个密密麻麻的排着每个池子的水。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 258140,
      "end_ms": 259400,
      "text": "因为深浅不同，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 259680,
      "end_ms": 260960,
      "text": "钙化程度不同，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 261200,
      "end_ms": 262660,
      "text": "呈现出不一样的颜色。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 262660,
      "end_ms": 263600,
      "text": "有的是浅蓝，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 264180,
      "end_ms": 265260,
      "text": "有的是翠绿，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 265660,
      "end_ms": 266580,
      "text": "有的是鹅黄，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 266900,
      "end_ms": 267900,
      "text": "有的是乳白，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 268320,
      "end_ms": 269100,
      "text": "挨在一起，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 269100,
      "end_ms": 271070,
      "text": "像一块被打调色板。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 271210,
      "end_ms": 272630,
      "text": "秋天去五彩池，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 272630,
      "end_ms": 274190,
      "text": "跟其他季节完全不同，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 274730,
      "end_ms": 277530,
      "text": "周围山坡上的彩铃红了黄了，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 277930,
      "end_ms": 284950,
      "text": "倒映在那些小池子里面池水本身的蓝绿色和彩铃的红黄色搅在一起，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 285390,
      "end_ms": 288590,
      "text": "六百多个池子每一个的颜色都不重样，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 289330,
      "end_ms": 291950,
      "text": "往山坡上面一站俯瞰下去，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 292730,
      "end_ms": 296115,
      "text": "就像有人在山坡上摆了几百叠子颜料。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 296900,
      "end_ms": 298000,
      "text": "叠叠不同色，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 298460,
      "end_ms": 299640,
      "text": "可黄龙有个问题，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 299640,
      "end_ms": 302500,
      "text": "海拔高从停车场走到五彩池，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 302800,
      "end_ms": 304520,
      "text": "要爬三四公里的山路，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 304900,
      "end_ms": 307700,
      "text": "海拔从三千米爬到三千五百米，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 307780,
      "end_ms": 309920,
      "text": "很多人走到半路就喘不上来了，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 309940,
      "end_ms": 312020,
      "text": "到不了顶到了顶的人回来，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 312020,
      "end_ms": 313100,
      "text": "都说同一句话，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 314080,
      "end_ms": 319520,
      "text": "值六百多个池子六百多种颜色铺在三千五百米的山坡上。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 319880,
      "end_ms": 322460,
      "text": "秋天彩铃一映池子，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 322460,
      "end_ms": 324380,
      "text": "里面又多了几百种颜色。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 324740,
      "end_ms": 325400,
      "text": "第二名，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 326300,
      "end_ms": 335530,
      "text": "内蒙蒙古阿尔山天池、阿尔山天池在内蒙古兴安盟阿尔山市藏在大兴安岭的林海深处。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 336010,
      "end_ms": 338890,
      "text": "这个天池是火山口积水形成的，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 339190,
      "end_ms": 340930,
      "text": "海拔一千三百多米，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 340990,
      "end_ms": 341770,
      "text": "面积不大，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 342010,
      "end_ms": 343490,
      "text": "大概也就几个足球场。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 343490,
      "end_ms": 346250,
      "text": "那么大可面积不大不要紧，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 346650,
      "end_ms": 353310,
      "text": "它剩在四周的林子、阿尔山天池的四面全是白桦林和落叶松。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 353870,
      "end_ms": 354750,
      "text": "秋天一到，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 355050,
      "end_ms": 357215,
      "text": "白桦叶子变成金黄色，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 357660,
      "end_ms": 360380,
      "text": "落叶松变成橘黄色两种，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 360400,
      "end_ms": 363495,
      "text": "黄色裹着中间一汪蓝得发深的湖水，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 364370,
      "end_ms": 365805,
      "text": "从高处往下看，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 366180,
      "end_ms": 369485,
      "text": "就像一块蓝宝石镶在一圈金子里面。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 370020,
      "end_ms": 372440,
      "text": "阿尔山天池还有一个说不清的地方。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 372460,
      "end_ms": 373700,
      "text": "这个湖没有入水口，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 373700,
      "end_ms": 374700,
      "text": "也没有出水口，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 374760,
      "end_ms": 376060,
      "text": "不管旱年涝，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 376060,
      "end_ms": 377200,
      "text": "年水位不升，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 377220,
      "end_ms": 379305,
      "text": "不降始终保持那么多。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 380060,
      "end_ms": 382145,
      "text": "有人说底下连着地下暗河，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 382660,
      "end_ms": 385305,
      "text": "有人说是火山口的地质结构特殊，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 385690,
      "end_ms": 388860,
      "text": "到今天也没有一个完全确定的解释，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 389420,
      "end_ms": 390560,
      "text": "一个没有进水，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 390580,
      "end_ms": 392570,
      "text": "没有出水的湖水，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 392590,
      "end_ms": 394595,
      "text": "不多不少呆了不知道多少年。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 395500,
      "end_ms": 397240,
      "text": "秋天去阿尔山天池，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 397260,
      "end_ms": 400525,
      "text": "最好的时间是九月中旬到十月初。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 401460,
      "end_ms": 403725,
      "text": "那个时候林子的颜色最浓，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 404260,
      "end_ms": 406305,
      "text": "早晨湖面会起一层薄雾，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 407110,
      "end_ms": 409770,
      "text": "金色的林子在雾后面若隐若现。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 409810,
      "end_ms": 411825,
      "text": "太阳出来雾一散，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 412240,
      "end_ms": 415865,
      "text": "蓝色的湖水和金色的树林同时亮起来，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 416270,
      "end_ms": 419665,
      "text": "那个瞬间干净的向世界刚被洗过一遍，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 420560,
      "end_ms": 424965,
      "text": "大兴安岭林海深处一汪不升不降的蓝水，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 425470,
      "end_ms": 429165,
      "text": "四面裹着金色的林子安安静静待在那儿，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 429740,
      "end_ms": 430925,
      "text": "不知道待了多少年。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 432080,
      "end_ms": 432480,
      "text": "好了，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 433210,
      "end_ms": 434445,
      "text": "前面九个讲完了，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 435180,
      "end_ms": 436575,
      "text": "该截第一名了，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 437630,
      "end_ms": 439455,
      "text": "可在接之前跟您聊几句。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 439880,
      "end_ms": 440340,
      "text": "评论区，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 440340,
      "end_ms": 442765,
      "text": "不少朋友说看完上集就想出发了。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 443230,
      "end_ms": 445450,
      "text": "可一查发现这些地方要么在高原，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 445450,
      "end_ms": 446850,
      "text": "要么在深山路线，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 446870,
      "end_ms": 451085,
      "text": "不好找到了也不知道该在哪看什么时间看最好。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 451920,
      "end_ms": 452460,
      "text": "确实，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 453380,
      "end_ms": 456285,
      "text": "秋水秘境跟热门景区不一样，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 457170,
      "end_ms": 458330,
      "text": "不是买张门票，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 458370,
      "end_ms": 461775,
      "text": "站在观景台上就能看到最美的那个画面，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 462230,
      "end_ms": 464545,
      "text": "什么时候去站在哪个角度，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 464880,
      "end_ms": 466775,
      "text": "早晨几点钟到湖边，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 467100,
      "end_ms": 467700,
      "text": "差一点，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 467700,
      "end_ms": 468995,
      "text": "效果就差一截。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 470070,
      "end_ms": 473305,
      "text": "后来有朋友给我推荐了一本书叫大美中国，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 473680,
      "end_ms": 477225,
      "text": "说是把咱们国家这些值得去的地方全整理了一遍，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 477840,
      "end_ms": 478520,
      "text": "有路线，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 478540,
      "end_ms": 479420,
      "text": "有实拍的图，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 479420,
      "end_ms": 481140,
      "text": "有当地的风土人情。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 481220,
      "end_ms": 481920,
      "text": "看得出来，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 481920,
      "end_ms": 483885,
      "text": "编书的人自己跑过这些地方，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 484380,
      "end_ms": 485060,
      "text": "放在家里，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 485060,
      "end_ms": 485800,
      "text": "平时翻番，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 485820,
      "end_ms": 486555,
      "text": "长见识，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 486850,
      "end_ms": 488390,
      "text": "真要出发了当参考，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 488590,
      "end_ms": 489445,
      "text": "也用得上，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 490320,
      "end_ms": 493225,
      "text": "比到了地方两眼一摸黑瞎转强太多。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 493760,
      "end_ms": 494745,
      "text": "想要的朋友。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 494990,
      "end_ms": 497150,
      "text": "点左下角头像进橱窗，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 497470,
      "end_ms": 501135,
      "text": "认准大美中国几十块钱的事儿。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 502130,
      "end_ms": 503615,
      "text": "好书先说到这儿，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 503830,
      "end_ms": 505525,
      "text": "咱们收回来接最后一个。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 506710,
      "end_ms": 509095,
      "text": "先在评论区打出四个字，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 509480,
      "end_ms": 513875,
      "text": "秋水之音打完回来听最后一个第一名。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 514350,
      "end_ms": 518610,
      "text": "新疆喀纳斯湖阿勒泰喀纳斯这个名字您可能听过，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 518910,
      "end_ms": 521345,
      "text": "可秋天的喀纳斯跟您想的不一样。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 521850,
      "end_ms": 525945,
      "text": "喀纳斯湖是冰川融水汇成的高山湖泊，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 526460,
      "end_ms": 528405,
      "text": "湖面海拔一千三百多米，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 528740,
      "end_ms": 530905,
      "text": "南北长将近二十五公里，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 531600,
      "end_ms": 533680,
      "text": "这个湖本身就会变色。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 533760,
      "end_ms": 536155,
      "text": "春天灰绿夏天深绿，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 536520,
      "end_ms": 539340,
      "text": "秋天变成一种说不上来的蓝绿色，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 539880,
      "end_ms": 541320,
      "text": "像一块老翡翠，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 541480,
      "end_ms": 542280,
      "text": "化成了水，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 542720,
      "end_ms": 545200,
      "text": "可光湖水变色不算什么，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 545900,
      "end_ms": 548800,
      "text": "真正把人看住的是湖两岸的林子。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 548880,
      "end_ms": 550120,
      "text": "喀纳斯的秋天。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 550140,
      "end_ms": 551900,
      "text": "大概从九月下旬开始，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 552280,
      "end_ms": 554120,
      "text": "白桦林最先变色，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 554500,
      "end_ms": 556580,
      "text": "叶子从绿变到金黄，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 556620,
      "end_ms": 557580,
      "text": "只要三四天，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 558120,
      "end_ms": 561060,
      "text": "然后是落叶松变成橘红色。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 561920,
      "end_ms": 563520,
      "text": "云山和冷杉不变，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 564020,
      "end_ms": 566370,
      "text": "始终是墨绿的三种颜色，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 566450,
      "end_ms": 568670,
      "text": "颜色交叉着铺满两岸的山坡，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 568670,
      "end_ms": 569770,
      "text": "金黄橘红，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 569850,
      "end_ms": 572510,
      "text": "墨绿一层一层的叠着，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 572830,
      "end_ms": 574970,
      "text": "从山脚一直叠到山腰，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 575670,
      "end_ms": 577810,
      "text": "湖面把这些颜色全部接住，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 577810,
      "end_ms": 578730,
      "text": "倒映在水里，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 579190,
      "end_ms": 583110,
      "text": "水底的蓝绿和岸上的惊红搅在一起，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 583550,
      "end_ms": 585190,
      "text": "浓烈到不像真的。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 585210,
      "end_ms": 588185,
      "text": "喀纳斯最出名的秋景在神仙湾。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 588910,
      "end_ms": 590790,
      "text": "清晨八九点钟的时候，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 591150,
      "end_ms": 593670,
      "text": "河面上会升起一层白雾，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 594470,
      "end_ms": 597330,
      "text": "雾气贴着水面缓缓飘，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 598350,
      "end_ms": 602230,
      "text": "两岸的金色白桦林在雾后面若隐若现。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 602670,
      "end_ms": 604690,
      "text": "太阳从山背后升起来，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 605090,
      "end_ms": 607310,
      "text": "光线穿过雾气和树梢。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 607790,
      "end_ms": 608870,
      "text": "到了秋面，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 609010,
      "end_ms": 611450,
      "text": "像有人在空气里撒了一把金粉，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 612170,
      "end_ms": 613090,
      "text": "当地牧民说，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 613090,
      "end_ms": 614610,
      "text": "这是神仙珠的地方。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 615010,
      "end_ms": 615830,
      "text": "到了秋天，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 615830,
      "end_ms": 617190,
      "text": "连神仙都舍不得走，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 617610,
      "end_ms": 620080,
      "text": "可这份好看只有十几天的窗口。"
    },
    {
      "segment_id": "s000236",
      "start_ms": 620800,
      "end_ms": 622480,
      "text": "九月下旬开始变色，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 622600,
      "end_ms": 624100,
      "text": "十月上旬最盛，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 624320,
      "end_ms": 626500,
      "text": "十月中旬叶子就开始落了。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 626900,
      "end_ms": 627520,
      "text": "去早了，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 627520,
      "end_ms": 628500,
      "text": "林子还是绿的，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 628500,
      "end_ms": 629360,
      "text": "看不出什么。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 629640,
      "end_ms": 631040,
      "text": "去晚的叶子落光，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 631080,
      "end_ms": 632540,
      "text": "只剩光秃秃的枝干，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 633100,
      "end_ms": 636240,
      "text": "湖水的颜色也会因为降温慢慢变暗，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 636760,
      "end_ms": 639780,
      "text": "只有中间的十几天颜色是满的，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 640100,
      "end_ms": 641340,
      "text": "光线是暖的，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 641780,
      "end_ms": 642940,
      "text": "光气是清的，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 643380,
      "end_ms": 645640,
      "text": "所有的东西刚刚好碰在一起。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 646440,
      "end_ms": 648610,
      "text": "有人为了堵着十几天的窗口，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 648650,
      "end_ms": 649550,
      "text": "从广东飞过，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 649550,
      "end_ms": 650820,
      "text": "来到了一看，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 650820,
      "end_ms": 652640,
      "text": "赶上连续阴天颜色出不来，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 652780,
      "end_ms": 654700,
      "text": "只能在湖边等等了三天。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 654720,
      "end_ms": 656185,
      "text": "第四天早上放晴了，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 656940,
      "end_ms": 658320,
      "text": "雾散开的那一刻，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 658320,
      "end_ms": 659685,
      "text": "整个湖面亮了，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 660500,
      "end_ms": 662265,
      "text": "那个人蹲在湖边哭了，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 663090,
      "end_ms": 663955,
      "text": "不是难过，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 664600,
      "end_ms": 666765,
      "text": "是这辈子没见过这么干净的。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 666920,
      "end_ms": 669005,
      "text": "是十几天的窗口，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 669380,
      "end_ms": 670905,
      "text": "一年只给一次，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 671680,
      "end_ms": 673255,
      "text": "错过了再等一年。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 674110,
      "end_ms": 676500,
      "text": "这就是喀纳斯排第一的原因。"
    },
    {
      "segment_id": "s000264",
      "start_ms": 676500,
      "end_ms": 676800,
      "text": "不是，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 676800,
      "end_ms": 678340,
      "text": "他比别的湖更蓝，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 678400,
      "end_ms": 679635,
      "text": "更大更有名，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 680120,
      "end_ms": 684730,
      "text": "是他把最好的自己只拿出来十几天给你看看，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 684810,
      "end_ms": 685630,
      "text": "不看得到，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 685830,
      "end_ms": 686905,
      "text": "全凭运气。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 687910,
      "end_ms": 689910,
      "text": "十个秋水秘境讲完了，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 689950,
      "end_ms": 690965,
      "text": "您回头想想，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 691410,
      "end_ms": 692750,
      "text": "如情湖是山间，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 692830,
      "end_ms": 694595,
      "text": "琴音轻轻响了一声，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 695030,
      "end_ms": 696450,
      "text": "还龙湖是江湾，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 696450,
      "end_ms": 697875,
      "text": "红叶输了一地，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 698440,
      "end_ms": 699800,
      "text": "卧龙潭是幽谷，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 699800,
      "end_ms": 700780,
      "text": "里藏了一面。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 700820,
      "end_ms": 703480,
      "text": "玉镜抚仙湖是天光，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 703540,
      "end_ms": 707050,
      "text": "洗了一壶净水闻县天池是陇南，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 707050,
      "end_ms": 709970,
      "text": "深山里落了一滴蓝墨错谱。"
    },
    {
      "segment_id": "s000281",
      "start_ms": 709970,
      "end_ms": 711390,
      "text": "湖是雪山脚下，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 711410,
      "end_ms": 713385,
      "text": "蹲了一汪不怕人的陵水。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 714110,
      "end_ms": 718650,
      "text": "然芜湖是高原上打翻了一叠绿墨五彩池，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 718650,
      "end_ms": 721195,
      "text": "是山坡上摆了几百叠颜料。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 721730,
      "end_ms": 724110,
      "text": "阿尔山天池是灵海里，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 724150,
      "end_ms": 725675,
      "text": "镶了一块蓝宝石。"
    },
    {
      "segment_id": "s000287",
      "start_ms": 726270,
      "end_ms": 729650,
      "text": "喀纳斯是老天爷用十几天的时间烧了一场金色的火，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 729650,
      "end_ms": 732715,
      "text": "然后一夜收走这十王秋水加一块儿。"
    },
    {
      "segment_id": "s000289",
      "start_ms": 733540,
      "end_ms": 735215,
      "text": "您说最动人的是什么？"
    },
    {
      "segment_id": "s000290",
      "start_ms": 736070,
      "end_ms": 739585,
      "text": "我觉得最动人的不是哪汪水最蓝、最青最好看，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 740240,
      "end_ms": 744080,
      "text": "而是这些水安安静静在那儿等了几百年几千年，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 744100,
      "end_ms": 745095,
      "text": "甚至几亿年，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 745680,
      "end_ms": 747320,
      "text": "等的就是秋天那几天，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 747320,
      "end_ms": 748160,
      "text": "光线对了，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 748160,
      "end_ms": 748920,
      "text": "颜色对了，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 748920,
      "end_ms": 749700,
      "text": "雾气对了。"
    },
    {
      "segment_id": "s000297",
      "start_ms": 749900,
      "end_ms": 751240,
      "text": "有个人站在湖边，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 751240,
      "end_ms": 752995,
      "text": "看到了水不说话，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 753390,
      "end_ms": 754270,
      "text": "可秋天到了，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 754270,
      "end_ms": 755535,
      "text": "他什么都告诉您了，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 755870,
      "end_ms": 761680,
      "text": "想出发之前先把这些地方看明白的那本大美中国的链接，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 761680,
      "end_ms": 762860,
      "text": "我放在左下角，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 762960,
      "end_ms": 764120,
      "text": "觉得有意思的话，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 764120,
      "end_ms": 764900,
      "text": "帮忙点个赞，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 764900,
      "end_ms": 765485,
      "text": "转个发，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 766020,
      "end_ms": 767565,
      "text": "咱们下一期接着聊。"
    }
  ],
  "source_transcript_sha256": "24626082817ec3a365ec4e0d3ddf70ac84155a71cd0bf1e88928661107d3200a"
}