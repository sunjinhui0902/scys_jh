{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_f4a8f176c6f73910_u002",
  "video_id": "v_f4a8f176c6f73910",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 962.073991,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000403",
      "start_ms": 870290,
      "end_ms": 871365,
      "text": "上帝不是重点。"
    },
    {
      "segment_id": "s000404",
      "start_ms": 871630,
      "end_ms": 873315,
      "text": "两座城的比喻不是重点，"
    },
    {
      "segment_id": "s000405",
      "start_ms": 873570,
      "end_ms": 876575,
      "text": "重点是那个在公元四一零年罗马陷落时，"
    },
    {
      "segment_id": "s000406",
      "start_ms": 876890,
      "end_ms": 879685,
      "text": "面对全世界都在说文明完蛋了的声音。"
    },
    {
      "segment_id": "s000407",
      "start_ms": 880340,
      "end_ms": 883580,
      "text": "一个人在书房里用二十年时间写了一部书说，"
    },
    {
      "segment_id": "s000408",
      "start_ms": 883600,
      "end_ms": 885020,
      "text": "不有两座城，"
    },
    {
      "segment_id": "s000409",
      "start_ms": 885420,
      "end_ms": 886360,
      "text": "一座在崩塌，"
    },
    {
      "segment_id": "s000410",
      "start_ms": 886720,
      "end_ms": 887805,
      "text": "一座在生长。"
    },
    {
      "segment_id": "s000411",
      "start_ms": 888290,
      "end_ms": 889510,
      "text": "而你有权利选择，"
    },
    {
      "segment_id": "s000412",
      "start_ms": 889510,
      "end_ms": 890455,
      "text": "站在哪一边，"
    },
    {
      "segment_id": "s000413",
      "start_ms": 890990,
      "end_ms": 892055,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000414",
      "start_ms": 892790,
      "end_ms": 895290,
      "text": "他看见人的困境不是缺乏知识，"
    },
    {
      "segment_id": "s000415",
      "start_ms": 895570,
      "end_ms": 896765,
      "text": "是爱的失去。"
    },
    {
      "segment_id": "s000416",
      "start_ms": 897130,
      "end_ms": 897490,
      "text": "他看见，"
    },
    {
      "segment_id": "s000417",
      "start_ms": 897490,
      "end_ms": 899190,
      "text": "人的痛苦不是缺乏资源，"
    },
    {
      "segment_id": "s000418",
      "start_ms": 899390,
      "end_ms": 900845,
      "text": "是注意力被撕裂。"
    },
    {
      "segment_id": "s000419",
      "start_ms": 901340,
      "end_ms": 903680,
      "text": "他看见人的悲剧不是命运不公，"
    },
    {
      "segment_id": "s000420",
      "start_ms": 903980,
      "end_ms": 906400,
      "text": "是把有限的东西当成了无限来爱。"
    },
    {
      "segment_id": "s000421",
      "start_ms": 906760,
      "end_ms": 908920,
      "text": "而这些看见一千六百年后，"
    },
    {
      "segment_id": "s000422",
      "start_ms": 909160,
      "end_ms": 912665,
      "text": "每一条都在现代人的崩溃中被精确验证。"
    },
    {
      "segment_id": "s000423",
      "start_ms": 913160,
      "end_ms": 915165,
      "text": "你不需要是基督徒才能读懂他，"
    },
    {
      "segment_id": "s000424",
      "start_ms": 915760,
      "end_ms": 918285,
      "text": "你只需要是一个想要好好活着，"
    },
    {
      "segment_id": "s000425",
      "start_ms": 918540,
      "end_ms": 920245,
      "text": "却总觉得哪里不对劲的人。"
    },
    {
      "segment_id": "s000426",
      "start_ms": 920670,
      "end_ms": 925755,
      "text": "这本书最后有一段话是奥古斯丁在上帝之城第十九卷的结尾写的，"
    },
    {
      "segment_id": "s000427",
      "start_ms": 926320,
      "end_ms": 927385,
      "text": "我想把它留给你。"
    },
    {
      "segment_id": "s000428",
      "start_ms": 928630,
      "end_ms": 929430,
      "text": "世俗之城，"
    },
    {
      "segment_id": "s000429",
      "start_ms": 929770,
      "end_ms": 931215,
      "text": "追求世俗的和平，"
    },
    {
      "segment_id": "s000430",
      "start_ms": 931930,
      "end_ms": 933525,
      "text": "他用权力划定边界，"
    },
    {
      "segment_id": "s000431",
      "start_ms": 933900,
      "end_ms": 935485,
      "text": "用法律维持秩序，"
    },
    {
      "segment_id": "s000432",
      "start_ms": 935890,
      "end_ms": 937275,
      "text": "用利益组织合作。"
    },
    {
      "segment_id": "s000433",
      "start_ms": 937670,
      "end_ms": 939355,
      "text": "这在人间的层面是合理的，"
    },
    {
      "segment_id": "s000434",
      "start_ms": 939570,
      "end_ms": 940505,
      "text": "甚至是必须的。"
    },
    {
      "segment_id": "s000435",
      "start_ms": 940920,
      "end_ms": 943515,
      "text": "但如果你把终极的安宁寄托在这上面，"
    },
    {
      "segment_id": "s000436",
      "start_ms": 943860,
      "end_ms": 947825,
      "text": "你就把你的灵魂压在了一根随时可能断裂的弦上。"
    },
    {
      "segment_id": "s000437",
      "start_ms": 948610,
      "end_ms": 950985,
      "text": "只有当你不再指望世界给你安宁，"
    },
    {
      "segment_id": "s000438",
      "start_ms": 951310,
      "end_ms": 953590,
      "text": "你才有可能在世界中活得安宁。"
    },
    {
      "segment_id": "s000439",
      "start_ms": 953790,
      "end_ms": 958645,
      "text": "这段话是一个见过罗马陷落的人从废墟中站起来说的，"
    },
    {
      "segment_id": "s000440",
      "start_ms": 959220,
      "end_ms": 959920,
      "text": "我是小海龟。"
    },
    {
      "segment_id": "s000441",
      "start_ms": 960160,
      "end_ms": 961320,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000442",
      "start_ms": 961320,
      "end_ms": 961955,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "dd3b0882de80c143462a7d2c965c0d1c5bc7adf079e0980b95abf295ba827900"
}