{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_3a5a0b8253b7fd6f_u001",
  "video_id": "v_3a5a0b8253b7fd6f",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 591.39,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 510,
      "end_ms": 1310,
      "text": "卡尔荣格，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1670,
      "end_ms": 3090,
      "text": "你之所以放不下一个人，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 3410,
      "end_ms": 6150,
      "text": "是因为你在他身上埋葬了一部分自己。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6570,
      "end_ms": 8109,
      "text": "你有没有经历过这样的时刻？"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8770,
      "end_ms": 10810,
      "text": "一段感情明明已经结束了，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 11230,
      "end_ms": 12430,
      "text": "你却无法走出来，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 12870,
      "end_ms": 14210,
      "text": "明知道对方不值得，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 14510,
      "end_ms": 15510,
      "text": "你却还是忍不住。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 15510,
      "end_ms": 18290,
      "text": "想他已经删除了所有联系方式，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 18570,
      "end_ms": 20970,
      "text": "你却还是会在深夜偷偷看他的动态。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 21190,
      "end_ms": 23070,
      "text": "别人说放下吧，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 23450,
      "end_ms": 24150,
      "text": "不值得，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 24770,
      "end_ms": 26850,
      "text": "你也告诉自己放下吧，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 27150,
      "end_ms": 28050,
      "text": "该翻篇了，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 28530,
      "end_ms": 29755,
      "text": "但你就是做不到，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 30120,
      "end_ms": 31600,
      "text": "不是因为你不想放下，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 31980,
      "end_ms": 34660,
      "text": "而是因为你根本不知道自己在执着什么。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 35080,
      "end_ms": 36780,
      "text": "你以为你放不下的是那个人，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 37580,
      "end_ms": 38300,
      "text": "你错了，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 38560,
      "end_ms": 42260,
      "text": "你放不下的是你埋葬在那个人身上的一部分自己。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 43020,
      "end_ms": 44780,
      "text": "荣格揭示的放不下真相。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 45260,
      "end_ms": 50040,
      "text": "心理学宗师卡尔荣格在研究了无数无法走出情商的案例后，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 50460,
      "end_ms": 51960,
      "text": "发现了一个惊人的规律。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 52280,
      "end_ms": 54100,
      "text": "一个人越是放不下一段感情，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 54520,
      "end_ms": 57280,
      "text": "说明他在那段感情中丢失的自己越多，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 57960,
      "end_ms": 58840,
      "text": "这是什么意思？"
    },
    {
      "segment_id": "s000027",
      "start_ms": 59220,
      "end_ms": 59915,
      "text": "荣格发现，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 60030,
      "end_ms": 60225,
      "text": "嗯，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 60480,
      "end_ms": 61980,
      "text": "当我们深爱一个人的时候，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 62240,
      "end_ms": 63905,
      "text": "我们不只是在爱对方，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 64460,
      "end_ms": 67385,
      "text": "我们把自己的一部分存放在对方身上。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 67820,
      "end_ms": 69785,
      "text": "你把你的希望存放在他身上，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 70160,
      "end_ms": 71560,
      "text": "你想象着和他的未来，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 71920,
      "end_ms": 73495,
      "text": "你规划着和他的生活。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 73800,
      "end_ms": 77225,
      "text": "你把所有对美好的期待都寄托在这段关系里。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 77630,
      "end_ms": 79675,
      "text": "你把你的价值感存放在他身上，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 80020,
      "end_ms": 80720,
      "text": "他爱你，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 80900,
      "end_ms": 82545,
      "text": "你就觉得自己值得被爱。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 82990,
      "end_ms": 83855,
      "text": "他认可你，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 84100,
      "end_ms": 85445,
      "text": "你就觉得自己有价值，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 85910,
      "end_ms": 88755,
      "text": "他的眼光成了你衡量自己的唯一标准。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 89190,
      "end_ms": 91285,
      "text": "你把你的生命力存放在他身上，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 91660,
      "end_ms": 92740,
      "text": "和他在一起的时候，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 92780,
      "end_ms": 93735,
      "text": "你感到活着。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 94110,
      "end_ms": 97015,
      "text": "它的存在让你的生命有了意义和色彩。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 97510,
      "end_ms": 100305,
      "text": "问题是当这段感情结束的时候，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 100770,
      "end_ms": 103025,
      "text": "这些被你存放在对方身上的部分，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 103280,
      "end_ms": 104755,
      "text": "并没有回到你身上。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 105160,
      "end_ms": 107655,
      "text": "他们被留在了那里被遗弃了，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 108230,
      "end_ms": 109015,
      "text": "被埋葬了。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 109560,
      "end_ms": 110805,
      "text": "所以你感到空虚，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 111260,
      "end_ms": 112155,
      "text": "感到残缺，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 112620,
      "end_ms": 113875,
      "text": "感到自己丢了一块儿。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 114390,
      "end_ms": 115965,
      "text": "你以为你在想念那个人，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 116400,
      "end_ms": 118445,
      "text": "其实你在想念那个丢失的自己。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 119120,
      "end_ms": 120965,
      "text": "为什么时间无法治愈一切？"
    },
    {
      "segment_id": "s000057",
      "start_ms": 121730,
      "end_ms": 124345,
      "text": "很多人说时间会治愈一切，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 124810,
      "end_ms": 125765,
      "text": "忠哥却说，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 126340,
      "end_ms": 127325,
      "text": "这是最大的谎言。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 127940,
      "end_ms": 129725,
      "text": "如果你只是等待时间流逝，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 130020,
      "end_ms": 131945,
      "text": "而不去找回那些丢失的部分，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 132420,
      "end_ms": 134045,
      "text": "你永远不会真正痊愈，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 134580,
      "end_ms": 135575,
      "text": "你只会麻木，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 135920,
      "end_ms": 136515,
      "text": "会遗忘，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 136860,
      "end_ms": 138585,
      "text": "会在表面上看起来好吗？"
    },
    {
      "segment_id": "s000066",
      "start_ms": 139070,
      "end_ms": 141715,
      "text": "但内心深处永远有一个空洞，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 142060,
      "end_ms": 143760,
      "text": "然后当你遇到下一个人的时候，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 143960,
      "end_ms": 146955,
      "text": "你会再次把自己的一部分存放在对方身上，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 147370,
      "end_ms": 148110,
      "text": "再次丢失，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 148530,
      "end_ms": 149290,
      "text": "再次空虚，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 149690,
      "end_ms": 150645,
      "text": "再次放不下。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 151060,
      "end_ms": 153700,
      "text": "这就是为什么有些人谈了无数次恋爱，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 153960,
      "end_ms": 155205,
      "text": "受了无数次伤，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 155560,
      "end_ms": 157365,
      "text": "却从来没有真正成长过。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 157810,
      "end_ms": 160425,
      "text": "因为他们从来没有找回那些丢失的自己，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 161010,
      "end_ms": 165095,
      "text": "他们只是不断的把自己分割存放在一个又一个人身上。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 165690,
      "end_ms": 169740,
      "text": "最后他们已经不知道完整的自己是什么样子了。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 169740,
      "end_ms": 170880,
      "text": "龙格的亲身经历，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 171080,
      "end_ms": 172865,
      "text": "找回丢失的灵魂碎片。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 173350,
      "end_ms": 174270,
      "text": "鲜少有人知道，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 174490,
      "end_ms": 178370,
      "text": "荣格本人也曾经历过一段让他几乎崩溃的情感创伤。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 178450,
      "end_ms": 180050,
      "text": "当他与弗洛伊德决裂之后，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 180250,
      "end_ms": 182485,
      "text": "他陷入了长达六年的精神危机。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 183080,
      "end_ms": 185215,
      "text": "这不只是一段师徒关系的结束，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 185800,
      "end_ms": 189635,
      "text": "荣哥发现他把太多的自己存放在了弗洛伊德身上。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 189990,
      "end_ms": 192245,
      "text": "他的学术认同他的职业方向，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 192650,
      "end_ms": 196355,
      "text": "他对自己价值的判断都与弗洛伊德紧紧绑定。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 196740,
      "end_ms": 197280,
      "text": "这段关系。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 197280,
      "end_ms": 198080,
      "text": "结束的时候，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 198260,
      "end_ms": 200015,
      "text": "荣格感到自己被撕裂了。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 200620,
      "end_ms": 201700,
      "text": "他在日记中写道，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 202160,
      "end_ms": 204595,
      "text": "我感到自己的灵魂被分成了碎片，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 205370,
      "end_ms": 207525,
      "text": "散落在我走过的每一段关系里。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 208020,
      "end_ms": 209320,
      "text": "正是这段痛苦的经历，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 209500,
      "end_ms": 212245,
      "text": "让荣格开始了他一生中最重要的探索。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 212710,
      "end_ms": 215030,
      "text": "如何找回那些丢失的灵魂碎片。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 215170,
      "end_ms": 217355,
      "text": "他把这个过程记录在了红书里，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 217700,
      "end_ms": 218980,
      "text": "他用了整整十六年，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 219260,
      "end_ms": 221635,
      "text": "走完了灵魂碎片回收的三个步骤。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 221840,
      "end_ms": 222555,
      "text": "在红书中，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 222890,
      "end_ms": 225955,
      "text": "荣格详细描述了找回丢失自我的完整路径。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 226450,
      "end_ms": 227075,
      "text": "第一步，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 227450,
      "end_ms": 228350,
      "text": "轻点丢失。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 228670,
      "end_ms": 230655,
      "text": "首先你要诚实的面对自己。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 231040,
      "end_ms": 231965,
      "text": "在那段感情中，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 232260,
      "end_ms": 234605,
      "text": "你到底把什么存放在了对方身上？"
    },
    {
      "segment_id": "s000107",
      "start_ms": 234980,
      "end_ms": 236005,
      "text": "是你的安全感，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 236340,
      "end_ms": 240635,
      "text": "你的价值感、你的希望、你的生命力、你对未来的想象，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 241210,
      "end_ms": 242475,
      "text": "把它们一一列出来。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 242960,
      "end_ms": 244245,
      "text": "这个过程会很痛苦，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 244680,
      "end_ms": 248175,
      "text": "因为你会发现你丢失的比你以为的多得多。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 248810,
      "end_ms": 249325,
      "text": "第二步，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 249700,
      "end_ms": 252800,
      "text": "切断连接那些被你存放在对方身上的部分，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 253040,
      "end_ms": 255995,
      "text": "现在还通过一根无形的线与对方连接着。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 256440,
      "end_ms": 258995,
      "text": "这就是为什么你总是忍不住想他，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 259520,
      "end_ms": 260945,
      "text": "总是忍不住关注他，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 261400,
      "end_ms": 262545,
      "text": "不是因为你爱他，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 263040,
      "end_ms": 265385,
      "text": "是因为你的一部分还在他那里。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 266050,
      "end_ms": 268705,
      "text": "你需要在意识层面把这根线切断，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 269320,
      "end_ms": 271505,
      "text": "告诉自己那些东西是我的，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 271800,
      "end_ms": 272525,
      "text": "不是他的，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 273030,
      "end_ms": 274845,
      "text": "我现在要把它们拿回来。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 275450,
      "end_ms": 276030,
      "text": "第三步，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 276450,
      "end_ms": 277485,
      "text": "重新整合，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 278260,
      "end_ms": 281360,
      "text": "把那些丢失的部分一一放回你自己内心。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 281500,
      "end_ms": 284125,
      "text": "你的希望不再寄托在任何人身上，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 284700,
      "end_ms": 286725,
      "text": "而是安放在你自己的生命里。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 287040,
      "end_ms": 289325,
      "text": "你的价值不再由任何人定义，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 289860,
      "end_ms": 291075,
      "text": "而是由你自己确认。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 291380,
      "end_ms": 294035,
      "text": "你的生命力不再依附于任何关系，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 294430,
      "end_ms": 296305,
      "text": "而是从你自己内心涌出。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 296730,
      "end_ms": 299225,
      "text": "当所有碎片都回到你身上的那一刻，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 299650,
      "end_ms": 300635,
      "text": "你就完整了。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 301180,
      "end_ms": 303805,
      "text": "你会发现你不再想念那个人了。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 304190,
      "end_ms": 305635,
      "text": "不是因为你忘记了，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 306080,
      "end_ms": 309575,
      "text": "而是因为你已经没有任何东西留在他那里了。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 310240,
      "end_ms": 311860,
      "text": "你收回了全部的自己，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 312280,
      "end_ms": 313900,
      "text": "我见过一个叫阿唐的姑娘，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 314220,
      "end_ms": 315820,
      "text": "她就是这样把自己弄丢的。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 316000,
      "end_ms": 316640,
      "text": "分手以后，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 316860,
      "end_ms": 318680,
      "text": "他删了前任所有的联系方式，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 319160,
      "end_ms": 321320,
      "text": "却还是每晚反复搜索他的账号。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 321780,
      "end_ms": 324480,
      "text": "他说我不是还爱他在，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 324480,
      "end_ms": 325880,
      "text": "只是觉得心里空了一块。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 326360,
      "end_ms": 327860,
      "text": "后来他去做清点，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 327860,
      "end_ms": 328260,
      "text": "丢失，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 328980,
      "end_ms": 331240,
      "text": "他才发现在那段关系里，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 331420,
      "end_ms": 333040,
      "text": "他存放了太多东西。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 333280,
      "end_ms": 335820,
      "text": "他把自己的价值存放在他的评价里，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 335820,
      "end_ms": 337440,
      "text": "他夸他懂事儿，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 337440,
      "end_ms": 338620,
      "text": "他才觉得自己好。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 338620,
      "end_ms": 340390,
      "text": "他皱一下画没，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 340750,
      "end_ms": 342050,
      "text": "他就觉得自己错了。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 342470,
      "end_ms": 344930,
      "text": "他把自己的未来存放在他的城市里，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 345390,
      "end_ms": 347030,
      "text": "为了他辞职搬家，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 347350,
      "end_ms": 348150,
      "text": "放弃画画，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 348470,
      "end_ms": 350250,
      "text": "把全部生活都围着他转。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 350870,
      "end_ms": 353670,
      "text": "他把自己的安全感存放在他的回复里，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 354170,
      "end_ms": 354850,
      "text": "他秒回，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 355290,
      "end_ms": 355930,
      "text": "他安心，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 356590,
      "end_ms": 357250,
      "text": "他沉默，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 357790,
      "end_ms": 358450,
      "text": "他崩溃，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 358690,
      "end_ms": 360130,
      "text": "分手带走的不是一个人，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 360570,
      "end_ms": 362050,
      "text": "而是他整个人的重心。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 362570,
      "end_ms": 363590,
      "text": "他按着三步走，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 364270,
      "end_ms": 366350,
      "text": "他一条一条写下丢失的东西，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 366970,
      "end_ms": 368390,
      "text": "剪断那根无形的线，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 368930,
      "end_ms": 371295,
      "text": "告诉自己我的价值。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 371810,
      "end_ms": 376655,
      "text": "我的未来我的安全感不是他的是我的。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 377140,
      "end_ms": 378435,
      "text": "他重新拿起画笔，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 378840,
      "end_ms": 379755,
      "text": "重新工作，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 380280,
      "end_ms": 381795,
      "text": "重新建立自己的生活。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 382520,
      "end_ms": 383155,
      "text": "有一天，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 383520,
      "end_ms": 384655,
      "text": "他刷到他的动态，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 385160,
      "end_ms": 386265,
      "text": "心里居然没有波澜。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 387040,
      "end_ms": 391385,
      "text": "他没有忘记他他只是终于没有东西留在他那里了，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 392330,
      "end_ms": 393355,
      "text": "他找回了自己，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 393740,
      "end_ms": 395115,
      "text": "这不是一本普通的书。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 395980,
      "end_ms": 400985,
      "text": "荣格用十六年时间亲手书写亲手绘制的灵魂重整日记。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 401360,
      "end_ms": 402100,
      "text": "在这本书里，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 402100,
      "end_ms": 406015,
      "text": "你会学到如何识别你在每段关系中丢失了什么？"
    },
    {
      "segment_id": "s000182",
      "start_ms": 406470,
      "end_ms": 407865,
      "text": "那些让你放不下的人，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 408350,
      "end_ms": 410375,
      "text": "身上都承载着你的什么？"
    },
    {
      "segment_id": "s000184",
      "start_ms": 411190,
      "end_ms": 412570,
      "text": "如何把它们看清楚，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 412590,
      "end_ms": 414775,
      "text": "如何切断与过去的能量连接？"
    },
    {
      "segment_id": "s000186",
      "start_ms": 415280,
      "end_ms": 416260,
      "text": "那些无形的线，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 416540,
      "end_ms": 418285,
      "text": "如何一根一根的剪断，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 418780,
      "end_ms": 420240,
      "text": "如何让自己真正自由？"
    },
    {
      "segment_id": "s000189",
      "start_ms": 420480,
      "end_ms": 422320,
      "text": "如何把丢失的碎片重新整合，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 422640,
      "end_ms": 424005,
      "text": "散落在各处的自己，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 424270,
      "end_ms": 426015,
      "text": "如何一片一片的找回来，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 426540,
      "end_ms": 428625,
      "text": "如何重新拼成一个完整的你？"
    },
    {
      "segment_id": "s000193",
      "start_ms": 429220,
      "end_ms": 431460,
      "text": "如何在未来的关系中不再丢失自己？"
    },
    {
      "segment_id": "s000194",
      "start_ms": 431580,
      "end_ms": 432575,
      "text": "如何爱一个人，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 432890,
      "end_ms": 434790,
      "text": "却不把自己存放在对方身上？"
    },
    {
      "segment_id": "s000196",
      "start_ms": 435030,
      "end_ms": 437325,
      "text": "如何建立真正健康的亲密关系？"
    },
    {
      "segment_id": "s000197",
      "start_ms": 437830,
      "end_ms": 438935,
      "text": "两种人生道路，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 439360,
      "end_ms": 440865,
      "text": "旧模式相爱，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 441080,
      "end_ms": 442645,
      "text": "把自己存放在对方身上，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 443080,
      "end_ms": 443800,
      "text": "感情结束，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 444000,
      "end_ms": 444800,
      "text": "丢失一部分，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 444800,
      "end_ms": 447310,
      "text": "自己空虚痛苦遇到下，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 447310,
      "end_ms": 449135,
      "text": "一个人再次存放，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 449720,
      "end_ms": 452185,
      "text": "再次丢失越来越残缺。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 452980,
      "end_ms": 454435,
      "text": "最后不知道自己是谁。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 454890,
      "end_ms": 457085,
      "text": "新模式探亲丢失，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 457470,
      "end_ms": 461035,
      "text": "切断连接、回收碎片重新完整，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 461400,
      "end_ms": 462565,
      "text": "从完整中去爱，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 463120,
      "end_ms": 464195,
      "text": "不再丢失自己，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 464800,
      "end_ms": 466365,
      "text": "建立真正平等的关系。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 466750,
      "end_ms": 467565,
      "text": "第一条路，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 468000,
      "end_ms": 469415,
      "text": "你可能已经走了很多年，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 470100,
      "end_ms": 473825,
      "text": "他带给你的只有一次又一次的残缺和迷失。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 474230,
      "end_ms": 477365,
      "text": "第二条路是荣格用一生验证过的路，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 478070,
      "end_ms": 481255,
      "text": "他通向真正的完整自由和爱。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 481630,
      "end_ms": 483465,
      "text": "如果你现在还放不下一个人，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 484030,
      "end_ms": 484795,
      "text": "请记住，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 485440,
      "end_ms": 486795,
      "text": "你想念的不是他，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 487470,
      "end_ms": 489450,
      "text": "你想念的是你自己。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 489570,
      "end_ms": 492595,
      "text": "那个你以为只有和他在一起才能感受到的快乐，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 492950,
      "end_ms": 494795,
      "text": "其实是你自己的快乐。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 495190,
      "end_ms": 497665,
      "text": "那个你以为只有他才能给你的安全感，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 498080,
      "end_ms": 500295,
      "text": "其实是你自己的安全感。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 500720,
      "end_ms": 503555,
      "text": "那个你以为只有在他眼中才能看到的价值，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 503900,
      "end_ms": 505235,
      "text": "其实是你自己的价值，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 505780,
      "end_ms": 507165,
      "text": "他们从来都是你的，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 507750,
      "end_ms": 510325,
      "text": "只是你错误的把他们存放在了他那里，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 511200,
      "end_ms": 513945,
      "text": "现在是时候把他们拿回来了。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 514680,
      "end_ms": 515895,
      "text": "不是为了报复他，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 516300,
      "end_ms": 518165,
      "text": "不是为了证明你可以过得更好，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 518730,
      "end_ms": 519755,
      "text": "是为了你自己，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 520160,
      "end_ms": 525495,
      "text": "为了那个被你遗忘在别人身上的残缺的渴望回家的自己。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 526000,
      "end_ms": 526560,
      "text": "荣格说，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 527120,
      "end_ms": 529025,
      "text": "你无法放下的不是那个人，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 529400,
      "end_ms": 531665,
      "text": "而是你存放在那个人身上的自己。"
    },
    {
      "segment_id": "s000236",
      "start_ms": 531910,
      "end_ms": 534515,
      "text": "你已经在那段感情的废墟里徘徊了太久。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 534910,
      "end_ms": 536830,
      "text": "你在想念一个不值得的人身上，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 536850,
      "end_ms": 538185,
      "text": "浪费了太多时间。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 538780,
      "end_ms": 542035,
      "text": "那些丢失的碎片在别人那里流浪了太久，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 542830,
      "end_ms": 545445,
      "text": "现在是时候把他们带回家了。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 546010,
      "end_ms": 549575,
      "text": "红书会成为你这段回收之旅最忠实的向导，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 550610,
      "end_ms": 552970,
      "text": "他会帮你找到每一片丢失的碎片。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 553070,
      "end_ms": 555910,
      "text": "他教你如何把它们重新拼成一个完整的你。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 556330,
      "end_ms": 557050,
      "text": "他告诉你，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 557530,
      "end_ms": 559730,
      "text": "你从来不需要任何人来让你完整。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 560330,
      "end_ms": 561910,
      "text": "因为你本来就是完整的。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 562530,
      "end_ms": 563630,
      "text": "如果你准备好了，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 564170,
      "end_ms": 564690,
      "text": "准备好，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 564690,
      "end_ms": 566130,
      "text": "停止在回忆里徘徊，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 566790,
      "end_ms": 568650,
      "text": "把那些丢失的自己找回来。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 569250,
      "end_ms": 572610,
      "text": "从一个残缺的思念者蜕变为完整的自己，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 573470,
      "end_ms": 576310,
      "text": "请在评论区留下碎片回收四个字。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 576850,
      "end_ms": 578670,
      "text": "我知道你已经准备好，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 578670,
      "end_ms": 581000,
      "text": "开始这场最重要的回家之旅。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 581900,
      "end_ms": 582800,
      "text": "你值得完整。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 583640,
      "end_ms": 587440,
      "text": "那些散落在别人身上的碎片已经等你太久了，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 588500,
      "end_ms": 591255,
      "text": "现在是时候把他们带回家了。"
    }
  ],
  "source_transcript_sha256": "8f0a873a87271b1530cfed084093fe7519446b44d9f20bfab6921fc4d25a817b"
}