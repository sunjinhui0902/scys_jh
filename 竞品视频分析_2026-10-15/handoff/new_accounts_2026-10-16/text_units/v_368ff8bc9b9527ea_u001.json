{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_368ff8bc9b9527ea_u001",
  "video_id": "v_368ff8bc9b9527ea",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 726.925011,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 70,
      "end_ms": 5250,
      "text": "上一集讲了后五名北海一千块房租配十来块的花蟹，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 5730,
      "end_ms": 7230,
      "text": "崇左七八百块钱，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7230,
      "end_ms": 8830,
      "text": "在山水里骑电动车，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9330,
      "end_ms": 13390,
      "text": "建水五毛钱一块的烤豆腐配一千二百年的古城。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 14030,
      "end_ms": 17210,
      "text": "攀枝花穿着衬衫在四川过都忙市，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 17250,
      "end_ms": 17930,
      "text": "七八百块，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 17950,
      "end_ms": 18710,
      "text": "住在边境，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18790,
      "end_ms": 20870,
      "text": "吃一个月不重样的热带水果，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21350,
      "end_ms": 24570,
      "text": "可这五个加一块都比不过前五名。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 25030,
      "end_ms": 27810,
      "text": "前五名里有一个海南的小城，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 27850,
      "end_ms": 29845,
      "text": "房租是三亚的三分之一，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 30580,
      "end_ms": 32120,
      "text": "有一个福建的城市，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 32180,
      "end_ms": 34100,
      "text": "烟火气比厦门浓十倍，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 34140,
      "end_ms": 38940,
      "text": "还有一个地方一千块钱能泡一整个冬天的野温泉到底是哪？"
    },
    {
      "segment_id": "s000015",
      "start_ms": 40100,
      "end_ms": 41300,
      "text": "从第五名开始，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 41300,
      "end_ms": 43260,
      "text": "接着讲第五名，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 44460,
      "end_ms": 51760,
      "text": "桂西、靖西、广西、百色的静西这个地方十个人里九个没听过。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 52420,
      "end_ms": 54800,
      "text": "可要是说桂林山水甲天下，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 55380,
      "end_ms": 57840,
      "text": "您就知道喀斯特山水长什么样了。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 57840,
      "end_ms": 60290,
      "text": "靖西的山水跟桂林是同一个类型，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 60310,
      "end_ms": 63345,
      "text": "行可静西比桂林安静的多。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 64150,
      "end_ms": 66135,
      "text": "靖西在广西的最西边，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 67000,
      "end_ms": 70000,
      "text": "冬天气温在十度到二十度之间，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 70020,
      "end_ms": 70815,
      "text": "不冷不热。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 71280,
      "end_ms": 71475,
      "text": "嗯，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 72780,
      "end_ms": 74860,
      "text": "靖西城边有一条鹅泉，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 74860,
      "end_ms": 80180,
      "text": "河水是碧绿色的清到能看见河底的水草，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 80260,
      "end_ms": 81325,
      "text": "一根一根的摆。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 81790,
      "end_ms": 83965,
      "text": "河面上常年飘着薄雾，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 84660,
      "end_ms": 87915,
      "text": "两岸是一座一座的喀斯特小山，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 88380,
      "end_ms": 89020,
      "text": "山不高，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 89100,
      "end_ms": 90535,
      "text": "但形状各异，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 90990,
      "end_ms": 92295,
      "text": "倒影在水里面，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 92610,
      "end_ms": 94235,
      "text": "一座一座排过去。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 95000,
      "end_ms": 98285,
      "text": "靖西人吃米粉跟桂林米粉不一样。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 98980,
      "end_ms": 102860,
      "text": "靖西的米粉是酸甜口的汤底，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 102880,
      "end_ms": 109585,
      "text": "用番茄和酸笋熬的粉是手工压的原粉滑溜溜的上面盖一勺卤肉，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 110000,
      "end_ms": 111360,
      "text": "一碗粉六七块钱。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 111440,
      "end_ms": 115425,
      "text": "早上坐在街边的粉店里端一碗粉慢慢说，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 115880,
      "end_ms": 117215,
      "text": "对面就是山。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 118080,
      "end_ms": 120405,
      "text": "靖西的物价低到什么地步呢？"
    },
    {
      "segment_id": "s000042",
      "start_ms": 121110,
      "end_ms": 123135,
      "text": "租房一个月六七百块，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 123830,
      "end_ms": 124290,
      "text": "吃饭，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 124290,
      "end_ms": 125210,
      "text": "一天二十块钱，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 125230,
      "end_ms": 126175,
      "text": "顿顿有肉，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 126640,
      "end_ms": 130415,
      "text": "菜市场的蔬菜水果比崇左还便宜一点，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 130880,
      "end_ms": 131645,
      "text": "城里不大，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 132120,
      "end_ms": 133540,
      "text": "骑个电动车十分钟，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 133540,
      "end_ms": 136745,
      "text": "从这头到那头六七百块的房租，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 137060,
      "end_ms": 138925,
      "text": "六七块钱一碗的酸粉，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 139370,
      "end_ms": 141730,
      "text": "窗外是桂林同款的山水，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 141730,
      "end_ms": 145190,
      "text": "可街上没有一个游客静西排。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 145190,
      "end_ms": 145735,
      "text": "第五，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 146910,
      "end_ms": 147630,
      "text": "不是他不够，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 147630,
      "end_ms": 149985,
      "text": "好是后面那几个各有各的本事。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 150940,
      "end_ms": 151685,
      "text": "第四名，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 152030,
      "end_ms": 156790,
      "text": "海南万宁说到海南过冬所有人，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 156790,
      "end_ms": 158225,
      "text": "第一反应是三亚，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 159070,
      "end_ms": 161810,
      "text": "可三亚这些年冬天的房租您也看见了，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 161810,
      "end_ms": 163030,
      "text": "稍微好点的房子，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 163030,
      "end_ms": 164445,
      "text": "一个月五六千打底，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 164900,
      "end_ms": 166225,
      "text": "海滩上人挤人，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 167080,
      "end_ms": 169385,
      "text": "菜市场的菜价跟着游客一块涨，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 170250,
      "end_ms": 172615,
      "text": "海南岛东南边有个城市叫万宁，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 173490,
      "end_ms": 175755,
      "text": "冬天的军温跟三亚几乎一样，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 176870,
      "end_ms": 177845,
      "text": "二十度左右，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 178280,
      "end_ms": 180865,
      "text": "可房租只有三亚的三分之一。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 181840,
      "end_ms": 186740,
      "text": "万宁老城区一个月一千五到两千就能租到带阳台的两居室，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 186840,
      "end_ms": 188785,
      "text": "走路十分钟到海边。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 189230,
      "end_ms": 191625,
      "text": "万宁的海跟三亚的海不一样，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 192020,
      "end_ms": 195215,
      "text": "三亚的海边全是酒店和度假村。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 195800,
      "end_ms": 197055,
      "text": "沙滩上人多。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 197520,
      "end_ms": 199655,
      "text": "万宁有一段海叫石梅湾，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 200150,
      "end_ms": 202630,
      "text": "沿着海岸有一大片野生青，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 202630,
      "end_ms": 203940,
      "text": "毗林树，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 204000,
      "end_ms": 205375,
      "text": "长在沙滩边上，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 205810,
      "end_ms": 207895,
      "text": "树荫底下铺着细沙。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 208680,
      "end_ms": 210775,
      "text": "您搬把椅子坐在树下面，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 211500,
      "end_ms": 212340,
      "text": "前面是海，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 212380,
      "end_ms": 213465,
      "text": "后面是林子，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 214040,
      "end_ms": 216345,
      "text": "安安静静晒一个下午的太阳，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 216900,
      "end_ms": 218820,
      "text": "身边走过的不是游客，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 218820,
      "end_ms": 220085,
      "text": "是赶海的渔民。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 220990,
      "end_ms": 222610,
      "text": "万宁还有一样东西，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 222630,
      "end_ms": 225570,
      "text": "三亚比不了兴隆的咖啡和温泉，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 225730,
      "end_ms": 228455,
      "text": "兴隆是归国华侨聚居的地方。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 228880,
      "end_ms": 230680,
      "text": "老一辈从东南亚带回来了，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 230680,
      "end_ms": 231915,
      "text": "种咖啡的手艺，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 232400,
      "end_ms": 237365,
      "text": "兴隆的咖啡馆遍地都是一杯现磨咖啡十来块钱，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 237850,
      "end_ms": 238935,
      "text": "泡温泉也不贵，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 239310,
      "end_ms": 240530,
      "text": "几十块钱能跑一个。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 240530,
      "end_ms": 240905,
      "text": "下午，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 241430,
      "end_ms": 243395,
      "text": "房租是三亚的三分之一。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 243870,
      "end_ms": 244790,
      "text": "海边没人，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 245030,
      "end_ms": 246010,
      "text": "咖啡十块钱，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 246170,
      "end_ms": 247275,
      "text": "温泉几十块。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 247940,
      "end_ms": 250745,
      "text": "万宁过冬过的是三亚该有的样子。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 251200,
      "end_ms": 252015,
      "text": "第三名，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 253840,
      "end_ms": 257410,
      "text": "福建漳州一提福建过冬，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 257790,
      "end_ms": 259734,
      "text": "所有人想到的是厦门，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 260590,
      "end_ms": 263330,
      "text": "可厦门鼓浪屿的船票都排不上号。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 263410,
      "end_ms": 265110,
      "text": "中山路挤的走不动道，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 265470,
      "end_ms": 267695,
      "text": "一碗沙茶面二三十块钱。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 268160,
      "end_ms": 271365,
      "text": "漳州在厦门旁边高铁半个小时，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 272110,
      "end_ms": 273650,
      "text": "可物价跟厦门比，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 273650,
      "end_ms": 274870,
      "text": "像两个省的，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 274870,
      "end_ms": 276515,
      "text": "同样一碗沙茶面，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 276980,
      "end_ms": 278205,
      "text": "漳州十来块钱。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 278620,
      "end_ms": 279405,
      "text": "同样的，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 279710,
      "end_ms": 280630,
      "text": "闽南古绰，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 280970,
      "end_ms": 283520,
      "text": "漳州的古城里走一圈棋，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 283520,
      "end_ms": 286455,
      "text": "楼底下全是本地人开的老铺子，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 287050,
      "end_ms": 289465,
      "text": "卖卤面的、卖四果汤的，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 289740,
      "end_ms": 291215,
      "text": "卖手工麻糍的，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 291710,
      "end_ms": 294465,
      "text": "十块钱能从街头吃到街尾。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 295390,
      "end_ms": 298350,
      "text": "漳州冬天的气温在十度到二十度之间，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 298570,
      "end_ms": 299890,
      "text": "跟北海差不多，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 299930,
      "end_ms": 302655,
      "text": "可漳州比北海多一样东西厚度。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 303560,
      "end_ms": 306825,
      "text": "漳州古城有一千三百多年的历史。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 307630,
      "end_ms": 309350,
      "text": "城里的明清石牌坊，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 309850,
      "end_ms": 314390,
      "text": "闽南骑楼红砖古着一条街走下来，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 314550,
      "end_ms": 317070,
      "text": "几百年的房子混着几十年的老店，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 317630,
      "end_ms": 319470,
      "text": "头顶上挂着红灯笼，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 319730,
      "end_ms": 321570,
      "text": "脚底下踩着青石板。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 322290,
      "end_ms": 325090,
      "text": "漳州边上还有一个地方叫东山岛，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 325530,
      "end_ms": 326950,
      "text": "开车一个多小时。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 327810,
      "end_ms": 330410,
      "text": "东山岛是福建第二大海岛，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 330730,
      "end_ms": 332450,
      "text": "冬天游客少的可怜。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 333110,
      "end_ms": 334130,
      "text": "漳州沙滩，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 334210,
      "end_ms": 335150,
      "text": "就您一个人。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 336150,
      "end_ms": 338820,
      "text": "岛上有一一条环岛公路，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 338900,
      "end_ms": 339660,
      "text": "一边是海，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 339700,
      "end_ms": 342360,
      "text": "一边是风车骑个电动车，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 342380,
      "end_ms": 343620,
      "text": "沿着公路转一圈，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 344040,
      "end_ms": 345200,
      "text": "海风吹着脸，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 345200,
      "end_ms": 348580,
      "text": "太阳晒着背十来块钱一碗的沙茶面。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 349120,
      "end_ms": 352240,
      "text": "一千三百年的古城一个多小时，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 352240,
      "end_ms": 354740,
      "text": "车城外还有一整座没人的海岛。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 355500,
      "end_ms": 356760,
      "text": "漳州排第三，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 357680,
      "end_ms": 368745,
      "text": "闽南的烟火气在这儿不在厦门、闽二名烟西、厦门、厦门在广西的东北角，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 369190,
      "end_ms": 370685,
      "text": "挨着广东和湖南，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 371790,
      "end_ms": 373275,
      "text": "这个城市名气不大，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 374200,
      "end_ms": 375260,
      "text": "可有一个数据，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 375260,
      "end_ms": 376320,
      "text": "很多人不知道，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 376320,
      "end_ms": 379460,
      "text": "贺州是中国有名的长寿之城，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 379540,
      "end_ms": 381985,
      "text": "百岁老人的比例在全国数得着。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 382360,
      "end_ms": 385715,
      "text": "贺州凭什么长寿空气？"
    },
    {
      "segment_id": "s000148",
      "start_ms": 386050,
      "end_ms": 389215,
      "text": "贺州的森林覆盖率超过百分之七十二，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 389790,
      "end_ms": 397655,
      "text": "空气里的负氧离子含量常年在每立方厘米三千到五千个山里面的村子能到一万以上。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 398570,
      "end_ms": 399430,
      "text": "什么概念呢？"
    },
    {
      "segment_id": "s000151",
      "start_ms": 399450,
      "end_ms": 400970,
      "text": "一般城市是几百个，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 401190,
      "end_ms": 403715,
      "text": "您在贺州的街上走深吸一口气，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 404410,
      "end_ms": 406590,
      "text": "能明显感觉空气是甜的，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 406590,
      "end_ms": 408250,
      "text": "不是形容是真，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 408350,
      "end_ms": 409745,
      "text": "有一点甜味，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 410580,
      "end_ms": 412345,
      "text": "那是植物释放出来。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 413390,
      "end_ms": 417910,
      "text": "贺州冬天的气温在五度到十八度之间，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 417970,
      "end_ms": 421560,
      "text": "比前面几个城市稍微凉一点可贺。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 421580,
      "end_ms": 423160,
      "text": "州的冬天是干冷，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 423160,
      "end_ms": 423885,
      "text": "不是湿冷，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 424640,
      "end_ms": 426125,
      "text": "太阳出来就暖慌了。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 426840,
      "end_ms": 428435,
      "text": "穿件薄棉服就够。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 429650,
      "end_ms": 431685,
      "text": "早上起来推开窗户，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 432160,
      "end_ms": 433135,
      "text": "外面是山，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 433530,
      "end_ms": 436930,
      "text": "山上是雾雾散了以后天蓝道，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 436930,
      "end_ms": 438410,
      "text": "您想拿手机拍一张，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 438410,
      "end_ms": 439775,
      "text": "可又觉得拍不出来。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 440500,
      "end_ms": 443045,
      "text": "贺州的物价跟静西差不多，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 443510,
      "end_ms": 443990,
      "text": "租房，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 444010,
      "end_ms": 445900,
      "text": "一个月七八百吃饭，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 445900,
      "end_ms": 446925,
      "text": "一天二三十。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 447480,
      "end_ms": 449795,
      "text": "贺州还有一个黄窑古镇，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 450330,
      "end_ms": 451810,
      "text": "比凤凰古城小一号，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 451810,
      "end_ms": 452865,
      "text": "但商业化少一半。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 454250,
      "end_ms": 456165,
      "text": "青石板路、小桥流水，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 456720,
      "end_ms": 457655,
      "text": "老榕树。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 458530,
      "end_ms": 460945,
      "text": "冬天的黄窑几乎没有游客，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 461750,
      "end_ms": 466035,
      "text": "整个镇子安安静静的七八百的房租，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 466730,
      "end_ms": 467590,
      "text": "每天醒来，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 467590,
      "end_ms": 469115,
      "text": "第一件事是深呼吸，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 470130,
      "end_ms": 472115,
      "text": "贺州过冬过的不是暖和，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 472510,
      "end_ms": 473225,
      "text": "是干净。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 473810,
      "end_ms": 474050,
      "text": "好，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 474210,
      "end_ms": 475130,
      "text": "咱们接着接榜。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 475130,
      "end_ms": 480330,
      "text": "首先把评论区那四个字打了过度秘境第一名。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 480570,
      "end_ms": 481635,
      "text": "云南腾冲，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 482370,
      "end_ms": 486465,
      "text": "腾冲在云南的最西边保山市代管的一个县级市。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 486930,
      "end_ms": 490310,
      "text": "大部分人知道腾冲是因为滇西抗战的历史，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 490310,
      "end_ms": 492650,
      "text": "可真正在腾冲住过一个冬天的人，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 492650,
      "end_ms": 495090,
      "text": "会告诉你这地方过冬，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 495970,
      "end_ms": 499410,
      "text": "在全中国都很难找出能比得过它。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 500550,
      "end_ms": 503470,
      "text": "腾冲冬天的气温在五度到二十度之间，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 503950,
      "end_ms": 505090,
      "text": "跟贺州差不多。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 505530,
      "end_ms": 507550,
      "text": "可腾冲有一样别的过冬，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 507550,
      "end_ms": 509290,
      "text": "小城很少有的东西。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 509310,
      "end_ms": 510170,
      "text": "火山温泉。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 511030,
      "end_ms": 514730,
      "text": "腾冲是中国非常年轻的火山群所在地，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 515210,
      "end_ms": 516350,
      "text": "地底下的热量，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 516370,
      "end_ms": 518040,
      "text": "把地下水煮成了温泉，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 518500,
      "end_ms": 522180,
      "text": "整个腾冲周围大大小小的温泉有几十处，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 522920,
      "end_ms": 525220,
      "text": "最出名的是热海，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 525300,
      "end_ms": 529600,
      "text": "景区里面有一个大滚锅泉眼的水温，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 529680,
      "end_ms": 531500,
      "text": "常年在九十七度左右，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 532340,
      "end_ms": 534440,
      "text": "水从地底下翻滚着，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 534440,
      "end_ms": 541260,
      "text": "冒上来蒸气腾腾的当地人直接拿草绳拴着鸡蛋丢进去，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 541860,
      "end_ms": 543480,
      "text": "十几分钟就煮熟了。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 544620,
      "end_ms": 546565,
      "text": "可您去泡的不是大滚锅，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 547090,
      "end_ms": 549970,
      "text": "是旁边引过去的温泉池子，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 550750,
      "end_ms": 552490,
      "text": "水温调到四十度左右，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 552490,
      "end_ms": 556270,
      "text": "刚好腾冲的野温泉更有意思，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 556670,
      "end_ms": 559970,
      "text": "城外的山里面散落着不少野温泉眼，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 560690,
      "end_ms": 566070,
      "text": "当地人在泉眼旁边砌了简单的石头池子不收门票，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 566190,
      "end_ms": 568050,
      "text": "最多收个十来块钱的管理费。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 568490,
      "end_ms": 570310,
      "text": "您冬天的下午什么都不干，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 570670,
      "end_ms": 573550,
      "text": "骑个电动车到山里找一个野温泉泡着，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 574010,
      "end_ms": 575710,
      "text": "头顶上是蓝天白云，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 576030,
      "end_ms": 580220,
      "text": "周围是到田和远山热水从脚底下冒上来，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 580440,
      "end_ms": 581920,
      "text": "泡到全身发软了，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 581920,
      "end_ms": 583020,
      "text": "爬上来吹吹风，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 583720,
      "end_ms": 585300,
      "text": "再泡腾冲过冬，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 585400,
      "end_ms": 588160,
      "text": "还有一个很难被比过的景银杏村，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 589020,
      "end_ms": 592300,
      "text": "腾冲过冬镇有一个江东银杏村，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 592760,
      "end_ms": 595700,
      "text": "村子里有三千多棵古银杏树，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 596420,
      "end_ms": 598820,
      "text": "最老的有一千三百多年。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 599220,
      "end_ms": 600435,
      "text": "每年十一月。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 600690,
      "end_ms": 601550,
      "text": "到十二月，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 601590,
      "end_ms": 603450,
      "text": "银杏叶黄了落下来，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 603690,
      "end_ms": 606510,
      "text": "整个村子的地面铺了一层金色，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 606950,
      "end_ms": 608670,
      "text": "屋顶上是金色的，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 608870,
      "end_ms": 610150,
      "text": "院子里是金色，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 610610,
      "end_ms": 611770,
      "text": "路上是金色，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 612310,
      "end_ms": 617090,
      "text": "连晒在外面的辣椒和玉米上面都落满了金色的叶子。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 617650,
      "end_ms": 619970,
      "text": "您走在银杏村的小路上，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 620350,
      "end_ms": 622310,
      "text": "头顶上的叶子还没落完，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 622970,
      "end_ms": 626190,
      "text": "脚底下的叶子已经铺了厚厚一层，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 626630,
      "end_ms": 627990,
      "text": "踩上去沙沙响，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 628610,
      "end_ms": 632960,
      "text": "阳光从还没落完的叶子缝缝隙里漏下来，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 632980,
      "end_ms": 634780,
      "text": "整个人泡在金色里，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 635580,
      "end_ms": 637420,
      "text": "腾冲的物价也不贵。"
    },
    {
      "segment_id": "s000240",
      "start_ms": 637580,
      "end_ms": 641480,
      "text": "老城区一个月一千出头的房租吃饭，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 641580,
      "end_ms": 642920,
      "text": "一天二三十块钱，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 643280,
      "end_ms": 645560,
      "text": "泡一次野温泉十来块，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 646100,
      "end_ms": 648720,
      "text": "一个月的开销加起来不到三千块钱。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 648720,
      "end_ms": 654040,
      "text": "这个钱在三亚连半个月的房租都不够一千块的房租，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 654940,
      "end_ms": 656440,
      "text": "十来块钱的野温泉，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 656780,
      "end_ms": 660095,
      "text": "一千三百年的银杏树铺了一地金子，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 660680,
      "end_ms": 661825,
      "text": "腾冲排第一。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 662590,
      "end_ms": 664095,
      "text": "不是因为他最暖和，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 664690,
      "end_ms": 667750,
      "text": "是因为他把过冬这件事变成了一种享受。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 667770,
      "end_ms": 669895,
      "text": "不是躲冬是过度。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 671640,
      "end_ms": 672480,
      "text": "这十个城市，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 672480,
      "end_ms": 673720,
      "text": "咱们从头捋一遍，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 673820,
      "end_ms": 674955,
      "text": "北海的花蟹，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 675420,
      "end_ms": 678895,
      "text": "崇左的山水、建水的烤豆腐，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 679290,
      "end_ms": 682425,
      "text": "攀枝花的日照、盲市的水果，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 682830,
      "end_ms": 684125,
      "text": "静息的酸粉，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 684450,
      "end_ms": 685385,
      "text": "万宁的海，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 685920,
      "end_ms": 690330,
      "text": "漳州的古城、贺州的空气、腾冲的温泉，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 690630,
      "end_ms": 692325,
      "text": "十个地方十种活法。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 692850,
      "end_ms": 694825,
      "text": "没有一个需要您花大钱。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 695300,
      "end_ms": 700490,
      "text": "没有一个需要您跟人挤过冬这件事儿花多少钱不重要，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 700830,
      "end_ms": 702725,
      "text": "身边安不安静才重要。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 703250,
      "end_ms": 706085,
      "text": "三亚的海在蓝挤满了人，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 706400,
      "end_ms": 707575,
      "text": "就不是您的海了。"
    },
    {
      "segment_id": "s000265",
      "start_ms": 707750,
      "end_ms": 709210,
      "text": "这十个地方还安静，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 709390,
      "end_ms": 710670,
      "text": "趁着知道的人不多，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 710830,
      "end_ms": 713150,
      "text": "赶紧去转给您。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 713150,
      "end_ms": 717565,
      "text": "那位每年冬天都窝在家里不愿出门的老伙计，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 718340,
      "end_ms": 719105,
      "text": "就跟他说，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 719940,
      "end_ms": 720765,
      "text": "别窝着了，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 721680,
      "end_ms": 724355,
      "text": "这十个地方一千块钱住一个月，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 724960,
      "end_ms": 726845,
      "text": "比你在家开暖气还舒坦。"
    }
  ],
  "source_transcript_sha256": "2a9396ce8ee30e2bb1e99162ce05131ba64bd0accb14981f706be3ed5e7dd326"
}