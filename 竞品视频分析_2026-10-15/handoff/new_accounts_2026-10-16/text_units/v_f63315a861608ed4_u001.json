{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_f63315a861608ed4_u001",
  "video_id": "v_f63315a861608ed4",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 260.807007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 560,
      "end_ms": 2260,
      "text": "尤本昌的女儿尤思涵说，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2860,
      "end_ms": 5260,
      "text": "父亲最后两三天自己不吃不喝，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5800,
      "end_ms": 7000,
      "text": "我们也没有应喂他，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7180,
      "end_ms": 8419,
      "text": "也没有送医院抢救，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8900,
      "end_ms": 11480,
      "text": "就想让他在熟悉安心的家里离开，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 11840,
      "end_ms": 14000,
      "text": "我们还问他是不是快要走了，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 14420,
      "end_ms": 16260,
      "text": "我们会全力尊重配合他，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 16640,
      "end_ms": 18540,
      "text": "尽量不去打扰他最后的时光。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 18960,
      "end_ms": 21120,
      "text": "尤本昌并不是在医院离世的，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 21740,
      "end_ms": 22780,
      "text": "是在家走的，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23080,
      "end_ms": 24520,
      "text": "也不是突发什么疾病，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 24980,
      "end_ms": 27220,
      "text": "就是身体各个器官慢慢衰竭，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 27940,
      "end_ms": 29975,
      "text": "他自己好像也有所预感，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 30370,
      "end_ms": 31490,
      "text": "吃不下任何东西，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 31950,
      "end_ms": 33950,
      "text": "平静的等待生命走到终点。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 34410,
      "end_ms": 35150,
      "text": "临走之前，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 35510,
      "end_ms": 36770,
      "text": "他说自己很舒服，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 37130,
      "end_ms": 37850,
      "text": "很幸福，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 38509,
      "end_ms": 40650,
      "text": "这也是他和这个世界最后的告别。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 41150,
      "end_ms": 42090,
      "text": "要是送到医院，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 42510,
      "end_ms": 45150,
      "text": "靠着仪器或许还能多维持一段时间。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 45250,
      "end_ms": 46530,
      "text": "但是这种没有质量，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 46530,
      "end_ms": 47710,
      "text": "没有自由的生命，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 48050,
      "end_ms": 49690,
      "text": "并不是游本昌想要的。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 49950,
      "end_ms": 52030,
      "text": "其实很早游本昌就看淡生死，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 52290,
      "end_ms": 53330,
      "text": "跟家人交代过，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 53510,
      "end_ms": 55070,
      "text": "不要做没有意义的抢救，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 55470,
      "end_ms": 57230,
      "text": "到时候顺其自然就好。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 57850,
      "end_ms": 58850,
      "text": "他曾对女儿说，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 59270,
      "end_ms": 60925,
      "text": "绝不做侵入性并抢救，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 61290,
      "end_ms": 62635,
      "text": "就让我平静的走。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 63960,
      "end_ms": 65655,
      "text": "家人也遵从了他的意愿，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 65990,
      "end_ms": 67525,
      "text": "安安静静陪在身旁，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 68060,
      "end_ms": 70530,
      "text": "让老人走的没有牵挂一个人。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 70530,
      "end_ms": 72145,
      "text": "如何面对衰老与告别？"
    },
    {
      "segment_id": "s000036",
      "start_ms": 72600,
      "end_ms": 74900,
      "text": "比他如何面对镜头更见底色。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 75160,
      "end_ms": 77945,
      "text": "女儿尤思涵没有大家想象中的悲痛欲绝。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 78440,
      "end_ms": 78860,
      "text": "他说，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 79630,
      "end_ms": 81445,
      "text": "一个人寿终正寝的离去，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 81850,
      "end_ms": 86615,
      "text": "完全可以是一种自主的、平静的、不慌不忙的圆满自由。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 87110,
      "end_ms": 88165,
      "text": "在最后的日子里，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 88570,
      "end_ms": 90550,
      "text": "家人只是在他嘴唇干了的时候，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 90790,
      "end_ms": 92715,
      "text": "用湿棉签轻轻润一润，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 93170,
      "end_ms": 94825,
      "text": "他还能配合的抿一抿嘴。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 95290,
      "end_ms": 96315,
      "text": "在两三天里，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 96720,
      "end_ms": 98765,
      "text": "家人问过他是不是要走了，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 99320,
      "end_ms": 101915,
      "text": "告诉他一切都会尊重他的意愿，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 102220,
      "end_ms": 103815,
      "text": "不去打扰他最后的时光，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 104570,
      "end_ms": 106430,
      "text": "他就那样安静的等候。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 106450,
      "end_ms": 107185,
      "text": "生命落幕，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 107860,
      "end_ms": 108735,
      "text": "没有挣扎，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 109410,
      "end_ms": 110105,
      "text": "没有恐惧。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 110710,
      "end_ms": 112645,
      "text": "他留下的最后一句话是四个字，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 113240,
      "end_ms": 114175,
      "text": "我很舒服。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 114440,
      "end_ms": 116290,
      "text": "这位老人很多人认识，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 116290,
      "end_ms": 119915,
      "text": "他是从一九八五年那个摇着破蒲扇的济公开始的。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 120100,
      "end_ms": 121635,
      "text": "那年他五十二岁，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 122050,
      "end_ms": 122795,
      "text": "在这之前，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 123150,
      "end_ms": 127840,
      "text": "他已经在话剧舞台上跑了将近三十年的龙套七十九个角色里，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 127860,
      "end_ms": 129265,
      "text": "七十七个都是配角。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 130360,
      "end_ms": 132880,
      "text": "他曾给自己取了个外号叫佐料，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 132880,
      "end_ms": 135965,
      "text": "演员不是鱼头、海参那样的大菜，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 136300,
      "end_ms": 137835,
      "text": "而是提味的葱姜蒜，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 138310,
      "end_ms": 139030,
      "text": "没有佐料。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 139390,
      "end_ms": 140270,
      "text": "这菜也不行。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 140350,
      "end_ms": 140690,
      "text": "后来，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 141090,
      "end_ms": 143795,
      "text": "九十岁的他又在繁花里成了爷叔，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 144150,
      "end_ms": 145815,
      "text": "让新一代观众记住了他，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 146490,
      "end_ms": 147090,
      "text": "舞台上，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 147150,
      "end_ms": 148095,
      "text": "他从容潇洒，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 148610,
      "end_ms": 149570,
      "text": "可她自己却说，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 150010,
      "end_ms": 152585,
      "text": "生活中她是个稀里糊涂的丈夫，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 152860,
      "end_ms": 155455,
      "text": "父亲对家人有太多亏欠，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 156150,
      "end_ms": 159435,
      "text": "直到一场重病让他从死亡线上被拉了回来，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 159900,
      "end_ms": 162160,
      "text": "他才真正开始补人生。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 162200,
      "end_ms": 162745,
      "text": "这一刻，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 163680,
      "end_ms": 166395,
      "text": "如果您被尤老这份豁达和真诚所触动，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 166750,
      "end_ms": 175065,
      "text": "不妨翻开他亲口讲述的自传补拙剂由本昌自传这本书由由本昌口述天津人民出版社出版。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 175910,
      "end_ms": 178255,
      "text": "从七十九个龙套角色的默默坚守，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 178590,
      "end_ms": 180815,
      "text": "写到五十二岁济公的一夜成名，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 181260,
      "end_ms": 184755,
      "text": "再到年近九十以繁花耶书再度绽放，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 185290,
      "end_ms": 187575,
      "text": "记录了他九十余年的人生轨迹，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 188180,
      "end_ms": 189225,
      "text": "捕捉二字，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 189770,
      "end_ms": 191525,
      "text": "正是他对这一生的回答。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 192590,
      "end_ms": 195545,
      "text": "书中最打动人的不是那些高光时刻，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 196020,
      "end_ms": 200205,
      "text": "而是一位老人坦诚回望一生时的温柔与通透。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 200630,
      "end_ms": 203215,
      "text": "他毫不掩饰的剖析了自己对家庭的亏欠，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 203560,
      "end_ms": 205185,
      "text": "与儿子几十年的隔阂，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 205630,
      "end_ms": 207255,
      "text": "以及晚年那场大病之后，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 207570,
      "end_ms": 209765,
      "text": "一家人坐下来摊开所有心结，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 210150,
      "end_ms": 211935,
      "text": "终于完成和解的过程。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 213470,
      "end_ms": 216665,
      "text": "书中还首次公开了大量珍贵照片与手稿，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 217030,
      "end_ms": 219715,
      "text": "包括济公花絮照和繁花拍摄日记，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 220130,
      "end_ms": 223395,
      "text": "并收录了妻子、儿子、女儿的深度访谈。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 223950,
      "end_ms": 225675,
      "text": "一位读者读完这样感慨，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 226900,
      "end_ms": 231195,
      "text": "像是一位老人坐下来慢慢讲完自己的一生，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 231830,
      "end_ms": 233155,
      "text": "把故事交代清楚，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 233560,
      "end_ms": 238455,
      "text": "也有人说书里的每一个字都是岁月沉淀下来的通透。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 239060,
      "end_ms": 239755,
      "text": "他说，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 240120,
      "end_ms": 241215,
      "text": "勤能补拙，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 241900,
      "end_ms": 242660,
      "text": "哪怕失败了，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 242660,
      "end_ms": 243385,
      "text": "也不丢脸，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 243920,
      "end_ms": 244805,
      "text": "虽败犹荣。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 245470,
      "end_ms": 246255,
      "text": "读这本书，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 246640,
      "end_ms": 248615,
      "text": "不只是读一位老艺术家的故事，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 249310,
      "end_ms": 250570,
      "text": "也是读一个普通人，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 250730,
      "end_ms": 253560,
      "text": "如何用一辈子的时间慢慢补上。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 253560,
      "end_ms": 258325,
      "text": "那些曾经来不及的爱捕捉、记游本昌自传，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 258650,
      "end_ms": 260675,
      "text": "值得放在手边慢慢读。"
    }
  ],
  "source_transcript_sha256": "af8362ffc57c44773bba7855f072cfe6bf4bf9945e918e9b6583e84a23edfb38"
}