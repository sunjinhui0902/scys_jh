{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ebbf44d69331baee_u001",
  "video_id": "v_ebbf44d69331baee",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 987.894875,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 340,
      "end_ms": 2400,
      "text": "十六分钟讲解奥古斯丁忏悔录，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2480,
      "end_ms": 6420,
      "text": "有一本书被公认为西方文化史上最具影响力的著作之一，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6620,
      "end_ms": 8160,
      "text": "被译成数十种语言，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 8260,
      "end_ms": 9940,
      "text": "影响了从蒙恬到卢梭。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 10140,
      "end_ms": 13120,
      "text": "从海德格尔到德里达的整个西方宗想传统，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 13440,
      "end_ms": 16220,
      "text": "却在中文世界的公共知识讨论里几乎隐形，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16420,
      "end_ms": 17600,
      "text": "不是因为它不重要，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17660,
      "end_ms": 19160,
      "text": "而是因为他被贴了一个传统。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 19520,
      "end_ms": 21380,
      "text": "人们以为它是一本宗教读物，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 21440,
      "end_ms": 24000,
      "text": "于是把它从哲学讨论的房间里赶了出去，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 24220,
      "end_ms": 25920,
      "text": "然后嘲笑房间里没有哲学。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 26240,
      "end_ms": 27660,
      "text": "这本书叫忏悔录。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 28100,
      "end_ms": 28460,
      "text": "作者，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 28460,
      "end_ms": 31390,
      "text": "奥古斯丁生活在公园四到五世纪的北非，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 31610,
      "end_ms": 33730,
      "text": "但比这个年代更值得注意的是，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 33730,
      "end_ms": 35110,
      "text": "他在这本书里做的事情，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 35510,
      "end_ms": 36830,
      "text": "他第一次用第一人称，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 36830,
      "end_ms": 39350,
      "text": "我进行了一场彻底的哲学探索。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 39790,
      "end_ms": 41210,
      "text": "不是忏悔罪的清单，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 41370,
      "end_ms": 42410,
      "text": "不是道德说教，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 42730,
      "end_ms": 46910,
      "text": "是对记忆、时间、自我意志和怀疑的认知。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 46910,
      "end_ms": 50990,
      "text": "解剖一个在罗马帝国晚期受过最好的修辞学训练的人，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 51070,
      "end_ms": 54370,
      "text": "转身去追问人类两千年来最难回答的问题，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 54670,
      "end_ms": 55330,
      "text": "我是谁？"
    },
    {
      "segment_id": "s000025",
      "start_ms": 55750,
      "end_ms": 56770,
      "text": "时间是什么？"
    },
    {
      "segment_id": "s000026",
      "start_ms": 57050,
      "end_ms": 58030,
      "text": "我凭什么知道？"
    },
    {
      "segment_id": "s000027",
      "start_ms": 58030,
      "end_ms": 59735,
      "text": "我存在离谱的是，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 60080,
      "end_ms": 62545,
      "text": "奥古斯丁写完之后遭遇的不是追捧，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 63030,
      "end_ms": 64290,
      "text": "是来自两个阵营的。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 64290,
      "end_ms": 64730,
      "text": "同时，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 64750,
      "end_ms": 69315,
      "text": "武士哲学家嫌他太文学、文学家嫌他太哲学。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 70000,
      "end_ms": 72140,
      "text": "人们宁可相信一本忏悔之作，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 72180,
      "end_ms": 75455,
      "text": "只是宗教文献也不愿面对一个可怕的真相。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 75940,
      "end_ms": 79320,
      "text": "你对自我和时间的认知从根上就错了。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 79340,
      "end_ms": 80200,
      "text": "今天这条文字，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 80200,
      "end_ms": 83295,
      "text": "我会拆出这本书里最颠覆的五个底层认知。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 83850,
      "end_ms": 84830,
      "text": "但我要提前警告，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 84830,
      "end_ms": 85890,
      "text": "你看完后，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 86070,
      "end_ms": 90650,
      "text": "你可能会推翻过去二十年、三十年氛围归孽的哲学与文学，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 90950,
      "end_ms": 92670,
      "text": "理性与情感的二分法。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 92750,
      "end_ms": 94030,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 94290,
      "end_ms": 95535,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 96020,
      "end_ms": 97135,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 97330,
      "end_ms": 98470,
      "text": "那我们开始进入正题。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 98670,
      "end_ms": 101605,
      "text": "第一层颠覆记忆不是一个功能，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 101900,
      "end_ms": 102860,
      "text": "是心灵本身。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 103060,
      "end_ms": 104285,
      "text": "你有没有听过这句话？"
    },
    {
      "segment_id": "s000048",
      "start_ms": 104630,
      "end_ms": 108370,
      "text": "记忆就是过去事情的仓库和思考没多大关系。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 108490,
      "end_ms": 110190,
      "text": "忏悔录第十卷的第一个动作，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 110270,
      "end_ms": 111695,
      "text": "就把这套认知判了死刑。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 111950,
      "end_ms": 115710,
      "text": "奥古斯丁在书里做了一件在公元四世纪绝无先例的事。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 115870,
      "end_ms": 118885,
      "text": "他不把记忆当做心灵的一个功能或能力，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 119170,
      "end_ms": 123625,
      "text": "而是把它等同于心灵本身、记忆理者意志。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 124080,
      "end_ms": 126345,
      "text": "这三样东西不是并列的三个抽屉，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 126680,
      "end_ms": 129475,
      "text": "而是同一个心灵在不同活动中的展现。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 129950,
      "end_ms": 131450,
      "text": "注意不是一个器官，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 131450,
      "end_ms": 132405,
      "text": "附带一个功能，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 132770,
      "end_ms": 138475,
      "text": "是一种存在方式和理性意志、情感并列的存在方式。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 138960,
      "end_ms": 141295,
      "text": "他做的事情超越了保存过去。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 141710,
      "end_ms": 143835,
      "text": "他同时承载着当下的现实，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 144190,
      "end_ms": 146085,
      "text": "甚至预示未来的可能。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 146920,
      "end_ms": 148315,
      "text": "这听上去像是常识，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 148980,
      "end_ms": 150105,
      "text": "但你仔细想想，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 150590,
      "end_ms": 152970,
      "text": "我们这代人从小被灌输的是记忆，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 152970,
      "end_ms": 154175,
      "text": "就是信息存储，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 154480,
      "end_ms": 155505,
      "text": "大脑就是硬盘。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 156070,
      "end_ms": 156750,
      "text": "言下之意，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 156970,
      "end_ms": 158450,
      "text": "记忆只需要被读取，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 158630,
      "end_ms": 159685,
      "text": "不需要被理解。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 159910,
      "end_ms": 161610,
      "text": "这套话语的隐蔽暴力在于，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 161810,
      "end_ms": 164865,
      "text": "他先把记忆从认知讨论的房间里赶出去，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 165200,
      "end_ms": 166955,
      "text": "然后嘲笑房间里没有认知。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 167370,
      "end_ms": 168325,
      "text": "奥古斯丁说，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 168680,
      "end_ms": 174365,
      "text": "嗯他在忏悔录第十卷中花了整整半卷的篇幅来搜索自己的记忆。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 174700,
      "end_ms": 176585,
      "text": "他不是在回忆某件具体的事，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 176930,
      "end_ms": 180355,
      "text": "他是在追问记忆到底是一个什么样的存在？"
    },
    {
      "segment_id": "s000077",
      "start_ms": 180750,
      "end_ms": 183010,
      "text": "他为什么能同时装下悲伤和快乐？"
    },
    {
      "segment_id": "s000078",
      "start_ms": 183170,
      "end_ms": 185235,
      "text": "过去和现在已知和未知。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 186380,
      "end_ms": 188355,
      "text": "他说了一句极其现代的话，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 188860,
      "end_ms": 191805,
      "text": "我去到记忆的田野和广阔的内殿，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 192350,
      "end_ms": 194510,
      "text": "那里储存着无数事物的影像，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 194910,
      "end_ms": 195835,
      "text": "这不是修辞，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 196450,
      "end_ms": 198225,
      "text": "这是现象学分析的雏形，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 198590,
      "end_ms": 199410,
      "text": "比胡塞尔早了。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 199410,
      "end_ms": 200325,
      "text": "一千五百年。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 200980,
      "end_ms": 202160,
      "text": "记忆不是仓库，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 202400,
      "end_ms": 203855,
      "text": "是心灵的工作台。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 204550,
      "end_ms": 205710,
      "text": "他把过去的碎片，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 205910,
      "end_ms": 206890,
      "text": "当下的注意力，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 207050,
      "end_ms": 208130,
      "text": "对未来的期待，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 208150,
      "end_ms": 210325,
      "text": "编织成一条流动的自我叙事。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 210980,
      "end_ms": 212375,
      "text": "你不是先有一个自我，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 212710,
      "end_ms": 214185,
      "text": "然后记忆来储存它。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 215000,
      "end_ms": 218445,
      "text": "你的自我就是记忆在时间中的持续编织。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 219380,
      "end_ms": 220905,
      "text": "理解不等于接受，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 221450,
      "end_ms": 222695,
      "text": "你可以理解这个论证，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 222910,
      "end_ms": 223755,
      "text": "同时拒绝他。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 223990,
      "end_ms": 226165,
      "text": "就像你可以理解修罗的因果怀疑论，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 226420,
      "end_ms": 227780,
      "text": "同时继续相信因果。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 227960,
      "end_ms": 229780,
      "text": "你可以理解尼采的视角主义，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 229900,
      "end_ms": 231460,
      "text": "同时不成为相对主义者。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 231460,
      "end_ms": 232545,
      "text": "奥古斯丁也一样，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 233060,
      "end_ms": 234635,
      "text": "他首先是一个认知对象，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 234990,
      "end_ms": 236715,
      "text": "然后才是一个立场选择。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 237130,
      "end_ms": 237570,
      "text": "第二层，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 237570,
      "end_ms": 240165,
      "text": "颠覆时间不存在于钟表里，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 240480,
      "end_ms": 241845,
      "text": "存在于你的意识中。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 242260,
      "end_ms": 245375,
      "text": "我们这代人从小被灌输时间是客观的，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 245750,
      "end_ms": 246930,
      "text": "钟表在测量它，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 247210,
      "end_ms": 248230,
      "text": "日历在记录它，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 248470,
      "end_ms": 249795,
      "text": "宇宙学在计算它。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 250240,
      "end_ms": 253375,
      "text": "所以当一个人说时间是一种心理体验时，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 253730,
      "end_ms": 256135,
      "text": "大家会下意识觉得他在说主观感受。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 256640,
      "end_ms": 259760,
      "text": "但忏悔录第十一卷用一整套现象学分析，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 259780,
      "end_ms": 260940,
      "text": "砸碎了这套常识，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 261060,
      "end_ms": 263555,
      "text": "奥古斯丁问了一个让所有人愣住的问题，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 263860,
      "end_ms": 264825,
      "text": "如果没有人，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 265240,
      "end_ms": 266360,
      "text": "时间还存在吗？"
    },
    {
      "segment_id": "s000119",
      "start_ms": 266360,
      "end_ms": 267500,
      "text": "过去已经不存在，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 267720,
      "end_ms": 268945,
      "text": "未来还没有到来。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 269300,
      "end_ms": 270760,
      "text": "当下如果有一个长度，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 270960,
      "end_ms": 273715,
      "text": "那他在被测量的瞬间就已经变成了过去，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 274150,
      "end_ms": 275445,
      "text": "那时间到底在哪里？"
    },
    {
      "segment_id": "s000124",
      "start_ms": 275800,
      "end_ms": 276380,
      "text": "他的答案，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 276380,
      "end_ms": 280695,
      "text": "惊世骇俗时间不是被客观测量的东西，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 281040,
      "end_ms": 282595,
      "text": "他是心灵活动本身，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 283080,
      "end_ms": 286220,
      "text": "是记忆、注意和期待的三重结构。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 286300,
      "end_ms": 288115,
      "text": "过去表现为心灵的回忆，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 288500,
      "end_ms": 290900,
      "text": "现在表现为心灵的注意未来，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 290900,
      "end_ms": 292295,
      "text": "表现为心灵的期待。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 292910,
      "end_ms": 294470,
      "text": "时间不是外面的河流，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 294710,
      "end_ms": 296375,
      "text": "是心灵内部的延展。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 296890,
      "end_ms": 297525,
      "text": "什么意思？"
    },
    {
      "segment_id": "s000134",
      "start_ms": 297840,
      "end_ms": 299180,
      "text": "你无法用钟表证明，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 299200,
      "end_ms": 300665,
      "text": "刚才那五分钟过得很慢。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 301080,
      "end_ms": 302240,
      "text": "但你不是因为这个原因，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 302240,
      "end_ms": 303600,
      "text": "就不相信自己的体验，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 303660,
      "end_ms": 307695,
      "text": "你的时间感知建立在注意记忆和期待的累积之上。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 308110,
      "end_ms": 309490,
      "text": "这是另一种认知模式，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 309590,
      "end_ms": 312690,
      "text": "不比你做物理测量更低级奥古斯丁。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 312690,
      "end_ms": 313270,
      "text": "进一步说，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 313830,
      "end_ms": 315130,
      "text": "所有认知行为，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 315370,
      "end_ms": 320210,
      "text": "包括科学认知都建立在某些无法被感官证实的前提上。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 320530,
      "end_ms": 322850,
      "text": "物理学家假设时间是均匀的，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 322990,
      "end_ms": 324690,
      "text": "可测量的、线性的。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 325010,
      "end_ms": 327210,
      "text": "这些假设本身无法被实验证明，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 327450,
      "end_ms": 329670,
      "text": "但他们是物理学能够运作的前提。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 330630,
      "end_ms": 335530,
      "text": "你信仰时间可以被客观测量和你信仰时间本质上是心灵的延展。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 335710,
      "end_ms": 337745,
      "text": "在认知结构上没有本质区别，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 338240,
      "end_ms": 341680,
      "text": "区别只在于后者把问题推到了更深的层面。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 342360,
      "end_ms": 343840,
      "text": "这句话可能会刺痛你，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 344500,
      "end_ms": 346960,
      "text": "你总说时间对每个人都是公平的。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 347380,
      "end_ms": 348400,
      "text": "可你有没有想过，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 348660,
      "end_ms": 350700,
      "text": "你凭什么知道时间是什么？"
    },
    {
      "segment_id": "s000155",
      "start_ms": 350700,
      "end_ms": 352000,
      "text": "你知道时间在流逝，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 352140,
      "end_ms": 353380,
      "text": "是因为你注意到它，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 353680,
      "end_ms": 356260,
      "text": "你注意到它是因为你记得它刚刚在，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 356660,
      "end_ms": 360280,
      "text": "你记得它刚刚在是因为你期待它继续在这个循环，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 360280,
      "end_ms": 361480,
      "text": "不是认知的耻辱，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 361720,
      "end_ms": 363820,
      "text": "这是所有时间意识的起点。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 364340,
      "end_ms": 366100,
      "text": "奥古斯丁不是要否定钟表，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 366300,
      "end_ms": 368410,
      "text": "他是要告诉你钟表没有认知，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 368410,
      "end_ms": 368905,
      "text": "前提，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 369290,
      "end_ms": 370390,
      "text": "只是它不叫前提，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 370590,
      "end_ms": 371715,
      "text": "叫操作定义。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 371980,
      "end_ms": 375570,
      "text": "而哲学要做的是把这些前提也拿到桌面上。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 375650,
      "end_ms": 376355,
      "text": "问一句，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 376640,
      "end_ms": 377655,
      "text": "他们为什么成立？"
    },
    {
      "segment_id": "s000169",
      "start_ms": 378040,
      "end_ms": 379120,
      "text": "他们能承受多少？"
    },
    {
      "segment_id": "s000170",
      "start_ms": 379120,
      "end_ms": 379520,
      "text": "追问，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 379520,
      "end_ms": 383260,
      "text": "海德格尔在存在与时间里把奥古斯丁的时间分析作为起点，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 383500,
      "end_ms": 387560,
      "text": "提出了死在的战出性时间化时间不是一条线，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 387880,
      "end_ms": 389495,
      "text": "是人向未来的伸展。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 389760,
      "end_ms": 390740,
      "text": "如果没有奥古斯丁，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 391000,
      "end_ms": 393575,
      "text": "海德格尔最核心的概念可能根本不会出现。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 394090,
      "end_ms": 395025,
      "text": "第三层颠覆。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 395410,
      "end_ms": 396995,
      "text": "怀疑不是虚无的深渊，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 397320,
      "end_ms": 398725,
      "text": "是确定性的起点。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 399210,
      "end_ms": 400250,
      "text": "主流认知告诉你，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 400250,
      "end_ms": 401290,
      "text": "怀疑是危险的，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 401390,
      "end_ms": 402705,
      "text": "他让你什么都不相信，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 402990,
      "end_ms": 404615,
      "text": "让你陷入相对主义的泥潭。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 405040,
      "end_ms": 406435,
      "text": "这套模式的潜台词是，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 406780,
      "end_ms": 407460,
      "text": "确定性，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 407540,
      "end_ms": 410510,
      "text": "只在信仰或权威中才有怀疑的人，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 410510,
      "end_ms": 412615,
      "text": "根本得不到任何确定的东西。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 413130,
      "end_ms": 414050,
      "text": "但奥古斯丁说，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 414410,
      "end_ms": 415295,
      "text": "这是错的。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 416100,
      "end_ms": 419864,
      "text": "他建立了一套被称为反怀疑论论证的方法论框架，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 420240,
      "end_ms": 422085,
      "text": "彻底扭转了怀疑的位置。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 422690,
      "end_ms": 425215,
      "text": "什么叫如果我被欺骗了那么我存在？"
    },
    {
      "segment_id": "s000192",
      "start_ms": 425690,
      "end_ms": 426230,
      "text": "简单说，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 426530,
      "end_ms": 427890,
      "text": "无论你如何怀疑，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 428110,
      "end_ms": 430425,
      "text": "怀疑这件事本身无法被怀疑，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 430920,
      "end_ms": 432100,
      "text": "因为如果你不存在，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 432300,
      "end_ms": 434485,
      "text": "你就不可能被任何事物所蒙蔽。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 434830,
      "end_ms": 435150,
      "text": "注意，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 435360,
      "end_ms": 436535,
      "text": "这不是一个逻辑游戏，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 436790,
      "end_ms": 438025,
      "text": "而是一个认知结构，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 438310,
      "end_ms": 441715,
      "text": "让怀疑的行为本身就预设了怀疑者的存在。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 442260,
      "end_ms": 443640,
      "text": "你越是彻底的怀疑，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 443760,
      "end_ms": 451805,
      "text": "你越是确认了正在进行怀疑的那个东西是存在的这套方法的核心是你不能因为一个认知不完美就把它扔掉，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 452170,
      "end_ms": 453270,
      "text": "也不能因为它有用，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 453290,
      "end_ms": 454270,
      "text": "就把它绝对化。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 454450,
      "end_ms": 456105,
      "text": "每一次认知都是后验的，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 456410,
      "end_ms": 458075,
      "text": "先怀疑再确认。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 458300,
      "end_ms": 460040,
      "text": "根据追问调整立场，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 460060,
      "end_ms": 461915,
      "text": "奥古斯丁反对两种极端，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 462360,
      "end_ms": 463800,
      "text": "一是独断论的傲慢，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 464000,
      "end_ms": 466035,
      "text": "以为自己的判断就是绝对真理。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 466360,
      "end_ms": 467875,
      "text": "二是怀疑论的投降，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 468240,
      "end_ms": 470400,
      "text": "以为没有任何判断比另一种更好。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 470620,
      "end_ms": 471995,
      "text": "他走的是第三条路，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 472410,
      "end_ms": 473295,
      "text": "认真的追问，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 473710,
      "end_ms": 479330,
      "text": "同时知道你追问的起点本身已经是某种确定这套逻辑彻底取消了。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 479330,
      "end_ms": 480635,
      "text": "怀疑的人没立场，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 480970,
      "end_ms": 482230,
      "text": "确信的人才有答案。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 482230,
      "end_ms": 483265,
      "text": "这个伪选择题，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 483500,
      "end_ms": 484135,
      "text": "你仔细想，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 484510,
      "end_ms": 487295,
      "text": "这其实也是哲学认识论里炒了几百年的问题。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 488270,
      "end_ms": 490090,
      "text": "笛卡尔说我思故我在，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 490630,
      "end_ms": 492610,
      "text": "但他自己在给朋友的信中承认，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 492870,
      "end_ms": 495850,
      "text": "奥古斯丁已经先于他提出了类似的论证，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 496110,
      "end_ms": 499510,
      "text": "区别在于笛卡尔用这个论证来重建整个知识。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 499510,
      "end_ms": 503090,
      "text": "大厦奥古斯丁只是用它来回应怀疑论证明，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 503090,
      "end_ms": 504870,
      "text": "哪怕在最极端的怀疑中，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 505030,
      "end_ms": 506850,
      "text": "某些认知也依然成立。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 506970,
      "end_ms": 508950,
      "text": "你不需要用怀疑来摧毁一切，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 509230,
      "end_ms": 512890,
      "text": "你可以用怀疑来找到那个连怀疑都无法动摇的支点。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 512970,
      "end_ms": 515890,
      "text": "第四层颠覆意志不是一个统一的力量，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 516010,
      "end_ms": 517410,
      "text": "他自身就是分裂的。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 517410,
      "end_ms": 519740,
      "text": "市面像关于自我和选择的讨论，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 519900,
      "end_ms": 523160,
      "text": "百分之九十九都假设意志是一个统一的力量。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 523760,
      "end_ms": 525020,
      "text": "你要么有意志力，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 525160,
      "end_ms": 526260,
      "text": "要么没有意志力，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 526860,
      "end_ms": 527700,
      "text": "你做了决定，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 527740,
      "end_ms": 528540,
      "text": "那就去执行。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 528880,
      "end_ms": 529680,
      "text": "你没执行，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 529900,
      "end_ms": 531060,
      "text": "那就是你不够坚定。"
    },
    {
      "segment_id": "s000240",
      "start_ms": 531300,
      "end_ms": 535360,
      "text": "这套模式的潜台词是意志是简单的、可量化的，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 535440,
      "end_ms": 536680,
      "text": "应该有统一性。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 537240,
      "end_ms": 537940,
      "text": "忏悔录说，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 538180,
      "end_ms": 538920,
      "text": "你错了。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 538920,
      "end_ms": 541520,
      "text": "阿古斯丁在书里做了一个惊人的自我分析，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 541820,
      "end_ms": 545060,
      "text": "他描述了在决定改变生活方式时的极端痛苦。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 545320,
      "end_ms": 547545,
      "text": "我既愿意又不愿意，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 548060,
      "end_ms": 549455,
      "text": "既不是完全愿意，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 549800,
      "end_ms": 551385,
      "text": "也不是完全不愿意。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 551690,
      "end_ms": 552555,
      "text": "他说了一句话，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 552870,
      "end_ms": 556205,
      "text": "是整个西方思想史上最诚实的自我描述之一，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 556820,
      "end_ms": 560495,
      "text": "没有比这个半是愿意半是不愿意的东西更可恶的了，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 561310,
      "end_ms": 563410,
      "text": "他称之为心灵的疾病。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 563510,
      "end_ms": 563955,
      "text": "注意，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 564160,
      "end_ms": 565240,
      "text": "这不是一个道德问题，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 565360,
      "end_ms": 566595,
      "text": "是一个认知问题。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 567080,
      "end_ms": 569160,
      "text": "奥古斯丁发现了一个现代心理学，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 569180,
      "end_ms": 571965,
      "text": "花了一千五百年才重新发现的事实。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 572410,
      "end_ms": 577475,
      "text": "意志不是单一的力抑志内部有结构、有分裂、有张力。"
    },
    {
      "segment_id": "s000259",
      "start_ms": 578360,
      "end_ms": 580460,
      "text": "你之所以知道该做什么却做不到，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 580700,
      "end_ms": 581760,
      "text": "不是因为软弱，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 582000,
      "end_ms": 584440,
      "text": "而是因为你从来就不是一个统一的。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 584440,
      "end_ms": 584675,
      "text": "你。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 585230,
      "end_ms": 588245,
      "text": "他把意志的这种分裂放在了一个更深的框架里。"
    },
    {
      "segment_id": "s000264",
      "start_ms": 588620,
      "end_ms": 590815,
      "text": "意志的分散不是偶然的失误，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 591090,
      "end_ms": 593390,
      "text": "是人的认知状态本身的一部分。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 593450,
      "end_ms": 597845,
      "text": "我们总是在多个方向上被拉扯习惯的引烈期待的牵引，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 598240,
      "end_ms": 599145,
      "text": "当下的犹豫，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 600120,
      "end_ms": 602475,
      "text": "你不能用更努力来解决意志的分裂。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 602730,
      "end_ms": 605810,
      "text": "就像你不能用更用力来解决一个结构性问题。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 606130,
      "end_ms": 610145,
      "text": "这套分析把意志力从一个道德问题变成了一个哲学问题。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 611050,
      "end_ms": 612705,
      "text": "他问的和你以为的不一样，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 613080,
      "end_ms": 614500,
      "text": "不是你为什么不够强，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 615120,
      "end_ms": 615585,
      "text": "而是。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 615910,
      "end_ms": 618610,
      "text": "你以为自己是一个统一的选择者？"
    },
    {
      "segment_id": "s000275",
      "start_ms": 618770,
      "end_ms": 620750,
      "text": "这个假设本身成立吗？"
    },
    {
      "segment_id": "s000276",
      "start_ms": 621390,
      "end_ms": 621970,
      "text": "第五层，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 621970,
      "end_ms": 625090,
      "text": "颠覆真正的认知转向不是向外追求，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 625090,
      "end_ms": 625490,
      "text": "客观，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 625690,
      "end_ms": 627230,
      "text": "是向内发现深度。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 627610,
      "end_ms": 628170,
      "text": "读到这里，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 628170,
      "end_ms": 628850,
      "text": "你可能想问，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 629070,
      "end_ms": 630650,
      "text": "说了这么多最终目标，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 630650,
      "end_ms": 632870,
      "text": "不还是让人获得某种心灵安慰吗？"
    },
    {
      "segment_id": "s000284",
      "start_ms": 633210,
      "end_ms": 637010,
      "text": "奥古斯丁自己在书里做的不就是一套内在的自我探索吗？"
    },
    {
      "segment_id": "s000285",
      "start_ms": 637110,
      "end_ms": 637730,
      "text": "如果你这样，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 637730,
      "end_ms": 639250,
      "text": "想你就掉进了这本书，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 639250,
      "end_ms": 640790,
      "text": "埋了一千六百年的陷阱。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 641450,
      "end_ms": 644290,
      "text": "奥古斯丁用一生证明的不是向内看，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 644290,
      "end_ms": 646460,
      "text": "可以找到平静这个连接下的口号，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 646960,
      "end_ms": 648820,
      "text": "而是向外和向内的对立，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 648820,
      "end_ms": 651540,
      "text": "本身就是一个被制造出来的叙事。"
    },
    {
      "segment_id": "s000292",
      "start_ms": 652020,
      "end_ms": 653700,
      "text": "它最大的颠覆不是立场，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 653960,
      "end_ms": 654640,
      "text": "是方法。"
    },
    {
      "segment_id": "s000294",
      "start_ms": 654920,
      "end_ms": 656320,
      "text": "他在书里反复强调，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 656500,
      "end_ms": 658840,
      "text": "我不是在告诉你应该看到什么，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 659080,
      "end_ms": 662420,
      "text": "我是在告诉你如何看到它的核心方法，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 662500,
      "end_ms": 663680,
      "text": "被称为内在性，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 663700,
      "end_ms": 667160,
      "text": "转向不要向外在世界寻找真理的根基。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 667560,
      "end_ms": 668600,
      "text": "要转向内在，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 669000,
      "end_ms": 670760,
      "text": "但转向内在不是为了逃避。"
    },
    {
      "segment_id": "s000301",
      "start_ms": 670760,
      "end_ms": 675325,
      "text": "世界是为了在更深的层面上理解你在世界中看到的一切。"
    },
    {
      "segment_id": "s000302",
      "start_ms": 675820,
      "end_ms": 678195,
      "text": " B这个内在不是心理学的内省，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 678580,
      "end_ms": 679960,
      "text": "而是认识盾的结构，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 680020,
      "end_ms": 681140,
      "text": "你的所有经验，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 681320,
      "end_ms": 682160,
      "text": "所有判断，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 682260,
      "end_ms": 683760,
      "text": "所有对外部世界的认知，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 684020,
      "end_ms": 687245,
      "text": "都经过了一个你从未完全审视过的中介。"
    },
    {
      "segment_id": "s000308",
      "start_ms": 687590,
      "end_ms": 689225,
      "text": "你自己的心灵结构，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 689780,
      "end_ms": 693150,
      "text": "奥古斯丁把两千年的哲学辩论史拆开来给你看。"
    },
    {
      "segment_id": "s000310",
      "start_ms": 693150,
      "end_ms": 694430,
      "text": "每一个论证的骨骼，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 694770,
      "end_ms": 697115,
      "text": "谁在什么处境下提出了什么观点，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 697400,
      "end_ms": 698860,
      "text": "这个观点的弱点在哪里？"
    },
    {
      "segment_id": "s000313",
      "start_ms": 698940,
      "end_ms": 700555,
      "text": "他的对手又是怎么回应的？"
    },
    {
      "segment_id": "s000314",
      "start_ms": 700890,
      "end_ms": 704535,
      "text": "然后他退后一步说你自己判断为什么？"
    },
    {
      "segment_id": "s000315",
      "start_ms": 704890,
      "end_ms": 705945,
      "text": "因为他太清楚。"
    },
    {
      "segment_id": "s000316",
      "start_ms": 706240,
      "end_ms": 707600,
      "text": "在关于自我的辩论中，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 707800,
      "end_ms": 709325,
      "text": "最稀缺的不是答案，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 709670,
      "end_ms": 711355,
      "text": "是问出好问题的能力。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 712410,
      "end_ms": 716154,
      "text": "你不需要在向外追求和向内探索之间做选择。"
    },
    {
      "segment_id": "s000320",
      "start_ms": 716630,
      "end_ms": 719705,
      "text": "你需要先搞清楚你选择的是什么？"
    },
    {
      "segment_id": "s000321",
      "start_ms": 720150,
      "end_ms": 722455,
      "text": "是那个被通俗心理学简化的内省。"
    },
    {
      "segment_id": "s000322",
      "start_ms": 722840,
      "end_ms": 724995,
      "text": "是那个被成功学滥用的自我觉察，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 725580,
      "end_ms": 729260,
      "text": "还是一个有严格的哲学传统支撑的复杂认知体系。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 729340,
      "end_ms": 730385,
      "text": "奥古斯丁写道，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 730850,
      "end_ms": 732850,
      "text": "人们到处去赞叹山的高峻，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 733130,
      "end_ms": 735180,
      "text": "海的辽阔、河流的悠长，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 735500,
      "end_ms": 737845,
      "text": "大洋的浩瀚星辰的运行，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 738270,
      "end_ms": 739490,
      "text": "却忽略了他们自己。"
    },
    {
      "segment_id": "s000329",
      "start_ms": 739550,
      "end_ms": 743770,
      "text": "所以你看这本书最惊世骇俗的答案藏在这里读。"
    },
    {
      "segment_id": "s000330",
      "start_ms": 743770,
      "end_ms": 746990,
      "text": "忏悔录最大的收获不是获得了一种世界观，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 747070,
      "end_ms": 750365,
      "text": "而是获得了一种在复杂问题面前不慌张的能力。"
    },
    {
      "segment_id": "s000332",
      "start_ms": 750520,
      "end_ms": 751595,
      "text": "你不必急于表态，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 751910,
      "end_ms": 753835,
      "text": "你有能力理解一个论证的质地，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 754120,
      "end_ms": 756125,
      "text": "你有耐心等待思考的成熟。"
    },
    {
      "segment_id": "s000335",
      "start_ms": 756450,
      "end_ms": 758045,
      "text": "你不需要被所有人说服，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 758490,
      "end_ms": 761305,
      "text": "你只需要在独处时对自己的判断负责。"
    },
    {
      "segment_id": "s000337",
      "start_ms": 761850,
      "end_ms": 762650,
      "text": "读完忏悔录，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 762710,
      "end_ms": 764225,
      "text": "你可能发现书名起错了。"
    },
    {
      "segment_id": "s000339",
      "start_ms": 764780,
      "end_ms": 766120,
      "text": "这不是一本心灵告白，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 766420,
      "end_ms": 768700,
      "text": "是一本关于人如何在时间中，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 768940,
      "end_ms": 769820,
      "text": "在记忆中，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 770000,
      "end_ms": 772800,
      "text": "在意志的分裂中认识自己的哲学手记。"
    },
    {
      "segment_id": "s000343",
      "start_ms": 772880,
      "end_ms": 773700,
      "text": "更重要的是，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 773800,
      "end_ms": 775380,
      "text": "那个在公元四世纪的人，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 775620,
      "end_ms": 778660,
      "text": "面对一个被哲学世界判了不够严格的领域，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 778740,
      "end_ms": 781175,
      "text": "说我不服从学科的边界，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 781590,
      "end_ms": 783755,
      "text": "我只服从我看见的复杂性。"
    },
    {
      "segment_id": "s000348",
      "start_ms": 784550,
      "end_ms": 785605,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000349",
      "start_ms": 786180,
      "end_ms": 788615,
      "text": "他看见自我不是科学的敌人，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 788890,
      "end_ms": 790050,
      "text": "不是文学的附庸，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 790390,
      "end_ms": 793065,
      "text": "不是需要被解释或还原的对象。"
    },
    {
      "segment_id": "s000352",
      "start_ms": 793380,
      "end_ms": 794405,
      "text": "他是一面镜子，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 794810,
      "end_ms": 797410,
      "text": "映照出人类在宇宙中最根本的处境。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 797570,
      "end_ms": 798765,
      "text": "我们知道一些东西，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 799170,
      "end_ms": 800605,
      "text": "我们不知道更多东西，"
    },
    {
      "segment_id": "s000356",
      "start_ms": 801150,
      "end_ms": 803475,
      "text": "而我们必须在不知道中做出决定。"
    },
    {
      "segment_id": "s000357",
      "start_ms": 803740,
      "end_ms": 803950,
      "text": "嗯，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 804010,
      "end_ms": 805070,
      "text": "这本书里有一段话，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 805270,
      "end_ms": 807730,
      "text": "是奥古斯丁在第十卷开头写的，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 807810,
      "end_ms": 809680,
      "text": "我想把它留给你我转向。"
    },
    {
      "segment_id": "s000361",
      "start_ms": 809680,
      "end_ms": 811125,
      "text": "我自己问自己，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 811410,
      "end_ms": 812075,
      "text": "你是谁？"
    },
    {
      "segment_id": "s000363",
      "start_ms": 812480,
      "end_ms": 817455,
      "text": "我自己回答一个在追问的人我走到记忆的广阔田野里，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 817740,
      "end_ms": 820575,
      "text": "发现他比我以为的要深得多大得多。"
    },
    {
      "segment_id": "s000365",
      "start_ms": 821030,
      "end_ms": 822115,
      "text": "我看见了什么呢？"
    },
    {
      "segment_id": "s000366",
      "start_ms": 822770,
      "end_ms": 823690,
      "text": "我看见了时间，"
    },
    {
      "segment_id": "s000367",
      "start_ms": 823690,
      "end_ms": 824755,
      "text": "不在钟表里，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 825030,
      "end_ms": 826495,
      "text": "在心灵的延展中，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 826880,
      "end_ms": 828740,
      "text": "我看见了怀疑不在虚无里。"
    },
    {
      "segment_id": "s000370",
      "start_ms": 828920,
      "end_ms": 830545,
      "text": "在确定性的起点上，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 831030,
      "end_ms": 831950,
      "text": "我看见了意志，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 831950,
      "end_ms": 832915,
      "text": "不在力量里。"
    },
    {
      "segment_id": "s000373",
      "start_ms": 833190,
      "end_ms": 834515,
      "text": "在分裂的结构中，"
    },
    {
      "segment_id": "s000374",
      "start_ms": 835030,
      "end_ms": 835810,
      "text": "我看见了自我，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 835810,
      "end_ms": 836805,
      "text": "不在答案里。"
    },
    {
      "segment_id": "s000376",
      "start_ms": 837230,
      "end_ms": 838645,
      "text": "在提问的勇气里，"
    },
    {
      "segment_id": "s000377",
      "start_ms": 839450,
      "end_ms": 845705,
      "text": "我骄傲的是我学会了在别人以为已经有答案的地方保持提问的勇气。"
    },
    {
      "segment_id": "s000378",
      "start_ms": 846310,
      "end_ms": 849055,
      "text": "最后我想认真推荐一次这本书。"
    }
  ],
  "source_transcript_sha256": "f285754cd9eb5a0a6ee4d4533adb089087a0b4053c64c51c139501683271cf12"
}