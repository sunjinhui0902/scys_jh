{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_73fe295c18ecf289_u001",
  "video_id": "v_73fe295c18ecf289",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 1226.689002,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 410,
      "end_ms": 2450,
      "text": "二十分钟讲解残雪黄泥街。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2670,
      "end_ms": 4070,
      "text": "如果一定要说有一本书，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4470,
      "end_ms": 7370,
      "text": "是每一个曾经在压抑的环境里喘不过气。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7670,
      "end_ms": 9510,
      "text": "在荒诞的生活中感到麻木，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 9830,
      "end_ms": 11290,
      "text": "在看不见出口的日子里，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 11290,
      "end_ms": 12150,
      "text": "反复问自己，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 12150,
      "end_ms": 18930,
      "text": "这一切到底有什么意义的人都应该静下心来读一读的那大概就是残雪写的黄泥街名字。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18930,
      "end_ms": 21070,
      "text": "听起来像是某个城乡结合部的地名，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21190,
      "end_ms": 22090,
      "text": "甚至有点土气，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 22450,
      "end_ms": 23870,
      "text": "真正读进去才会发现，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 24010,
      "end_ms": 27890,
      "text": "他其实是在把那层你每天都在经历却不敢细看的东西。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 27950,
      "end_ms": 29530,
      "text": "那些弥漫在空气里的焦虑，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 29530,
      "end_ms": 32040,
      "text": "藏在在人心里不敢说出口的冷漠。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 32240,
      "end_ms": 35760,
      "text": "人与人之间那种又互相窥探又互相消耗的疲惫，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 36100,
      "end_ms": 38380,
      "text": "一层一层揭开放在你面前，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 38380,
      "end_ms": 39220,
      "text": "让你看清楚。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 39540,
      "end_ms": 39960,
      "text": "为什么？"
    },
    {
      "segment_id": "s000018",
      "start_ms": 39960,
      "end_ms": 41200,
      "text": "明明身边都是人，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 41520,
      "end_ms": 43120,
      "text": "却觉得比一个人还孤独。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 43600,
      "end_ms": 45800,
      "text": "为什么你拼了命想离开某种生活，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 46040,
      "end_ms": 48020,
      "text": "却发现兜了一大圈还在原地？"
    },
    {
      "segment_id": "s000022",
      "start_ms": 48260,
      "end_ms": 51020,
      "text": "为什么有的人在极端环境里不但没有垮掉，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 51320,
      "end_ms": 54300,
      "text": "反而以一种让人毛骨悚然的方式活了下来，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 54600,
      "end_ms": 57540,
      "text": "以及那些真正看懂了自己处境的人，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 57780,
      "end_ms": 63235,
      "text": "却怎么在一片混沌中辨认出方想找到那条极其狭窄的突围之路的？"
    },
    {
      "segment_id": "s000026",
      "start_ms": 63580,
      "end_ms": 65000,
      "text": "很多人都有过这种感受，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 65280,
      "end_ms": 67805,
      "text": "在单位里日复一日做着毫无意义的事，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 68120,
      "end_ms": 68960,
      "text": "说不上讨厌，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 69080,
      "end_ms": 70445,
      "text": "但绝对谈不上喜欢。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 70880,
      "end_ms": 73320,
      "text": "每天早上醒来的第一个念头是又得去，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 73520,
      "end_ms": 76545,
      "text": "在家庭里应付着各种说不清道不明的关系。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 76910,
      "end_ms": 77890,
      "text": "明明是一家人，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 77950,
      "end_ms": 80290,
      "text": "却总觉得隔着什么想亲近，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 80290,
      "end_ms": 81535,
      "text": "又不知道怎么开口。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 82560,
      "end_ms": 84400,
      "text": "在内心深处偶尔冒出一个声音，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 84400,
      "end_ms": 84940,
      "text": "问自己，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 85040,
      "end_ms": 86565,
      "text": "我这辈子就这样了吗？"
    },
    {
      "segment_id": "s000038",
      "start_ms": 86890,
      "end_ms": 89425,
      "text": "但马上又被下一个代办事项淹没了。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 89930,
      "end_ms": 94565,
      "text": "黄泥街做的事情就是把这种你以为只有自己才会有的窒息感，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 94870,
      "end_ms": 97385,
      "text": "用一个极其荒诞的故事呈现出来，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 97670,
      "end_ms": 100530,
      "text": "让你看到这背后不是单纯的个人问题，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 100790,
      "end_ms": 103030,
      "text": "而是某种更根本的生存困境。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 103190,
      "end_ms": 104750,
      "text": "在每个人身上的投射，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 104990,
      "end_ms": 106395,
      "text": "你不是一个人在窒息，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 106820,
      "end_ms": 108260,
      "text": "所有人都在这条街上。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 108460,
      "end_ms": 109800,
      "text": "在正式讲这本书之前，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 109980,
      "end_ms": 112400,
      "text": "可以先抛出一个其中非常扎心的观点，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 112640,
      "end_ms": 114195,
      "text": "用自己的话转述出来，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 114610,
      "end_ms": 115975,
      "text": "大概是这样一句意思，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 116560,
      "end_ms": 118045,
      "text": "一个人能不能活得清醒，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 118380,
      "end_ms": 121595,
      "text": "很大程度上不取决于他有多聪明、多努力，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 122070,
      "end_ms": 124290,
      "text": "而取决于他是否愿意直面自己。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 124290,
      "end_ms": 125505,
      "text": "所处环境的真相，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 126030,
      "end_ms": 128705,
      "text": "是否敢于在所有人都选择麻木的时候，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 128980,
      "end_ms": 130875,
      "text": "保持那份不舒服的知觉。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 131430,
      "end_ms": 134625,
      "text": "人们在日常生活中花大量时间应付外界的要求，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 134980,
      "end_ms": 136785,
      "text": "完成工作、维持关系，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 137100,
      "end_ms": 137800,
      "text": "扮演角色，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 137880,
      "end_ms": 139560,
      "text": "却几乎没有人认真停下来。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 139560,
      "end_ms": 140550,
      "text": "问过我，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 140550,
      "end_ms": 142685,
      "text": "生活的这个环境到底是什么样的？"
    },
    {
      "segment_id": "s000062",
      "start_ms": 142910,
      "end_ms": 144465,
      "text": "他对我的精神做了什么？"
    },
    {
      "segment_id": "s000063",
      "start_ms": 144820,
      "end_ms": 150025,
      "text": "那些习以为常的东西、重复的劳作、无效的社交、强撑的体面，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 150380,
      "end_ms": 151360,
      "text": "他们是真的必要，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 151660,
      "end_ms": 153780,
      "text": "还是我只是在延续一种惯性。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 153880,
      "end_ms": 158020,
      "text": "结果就是很多人一边在具体的任务上表现的勤勤恳恳，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 158280,
      "end_ms": 160580,
      "text": "一边在面对自己真实的生存状态时，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 160620,
      "end_ms": 163045,
      "text": "迟钝的像一台被设定好程序的机器，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 163300,
      "end_ms": 164915,
      "text": "全凭习惯凭惯性，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 165170,
      "end_ms": 167275,
      "text": "凭别人也在这样做来麻痹自己。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 167890,
      "end_ms": 170750,
      "text": "这一点一旦想通很多对自己不够成功，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 170770,
      "end_ms": 171930,
      "text": "不够幸福的自责，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 172210,
      "end_ms": 173245,
      "text": "其实会轻一点，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 173680,
      "end_ms": 176415,
      "text": "活的憋屈不等于你这个人就注定如此，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 176870,
      "end_ms": 179390,
      "text": "只能说明在最根本的生存功课上，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 179490,
      "end_ms": 181050,
      "text": "大家几乎都没有人教过。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 181150,
      "end_ms": 186335,
      "text": "那黄泥坚想做的就是把从我怎么看清自己身处什么样的环境，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 186690,
      "end_ms": 190655,
      "text": "到我怎么在荒诞中保持清醒这一整条精神链，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 191010,
      "end_ms": 192270,
      "text": "从最初的麻木不决，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 192590,
      "end_ms": 193990,
      "text": "到后来的隐约不安，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 194490,
      "end_ms": 195770,
      "text": "再到最终的觉醒，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 195950,
      "end_ms": 199235,
      "text": "或者沉沦一段一段拆开给人看。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 200160,
      "end_ms": 203355,
      "text": "先来说说人为什么一定要读这样不舒服的书。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 203780,
      "end_ms": 206980,
      "text": "很多人觉得读残血的小说是一种折磨，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 207340,
      "end_ms": 209510,
      "text": "通篇脏兮兮的又是死猫，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 209510,
      "end_ms": 209970,
      "text": "死狗，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 210010,
      "end_ms": 211275,
      "text": "又是苍蝇驱虫，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 211660,
      "end_ms": 212880,
      "text": "读完了心情沉重，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 213100,
      "end_ms": 214005,
      "text": "何必自找苦吃。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 214760,
      "end_ms": 216545,
      "text": "这种小说的起点恰恰相反，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 217090,
      "end_ms": 218645,
      "text": "他不是来让你难受的，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 219020,
      "end_ms": 220415,
      "text": "他是来让你醒过来的。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 220960,
      "end_ms": 223805,
      "text": "一个人如果长期活在对自己处境的误判里，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 224060,
      "end_ms": 225585,
      "text": "把麻木当成平静，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 225950,
      "end_ms": 227310,
      "text": "把习惯当成正常，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 227610,
      "end_ms": 228950,
      "text": "把大家都是这样过，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 228990,
      "end_ms": 231055,
      "text": "当成生活本来就是这样，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 231480,
      "end_ms": 233405,
      "text": "大概率会像黄泥街上的人一样，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 233690,
      "end_ms": 235770,
      "text": "在一种温水煮青蛙的状态里，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 235770,
      "end_ms": 237425,
      "text": "慢慢失去所有可能性。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 237710,
      "end_ms": 238255,
      "text": "反过来，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 238600,
      "end_ms": 241575,
      "text": "如果能够看清那些隐藏在日常下面的荒诞，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 241870,
      "end_ms": 243765,
      "text": "那些被习以为常掩盖的真相，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 244530,
      "end_ms": 246285,
      "text": "就算外在条件没有变化，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 246590,
      "end_ms": 248235,
      "text": "内心也会多一层通透，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 248670,
      "end_ms": 249475,
      "text": "不是自虐，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 249820,
      "end_ms": 250500,
      "text": "而是活着。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 250500,
      "end_ms": 253105,
      "text": "这件事本身就需要一份清醒。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 253460,
      "end_ms": 254225,
      "text": "时代在变，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 254520,
      "end_ms": 255855,
      "text": "环境的形态在变，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 256190,
      "end_ms": 258775,
      "text": "但人被环境塑造的方式没变。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 259130,
      "end_ms": 260410,
      "text": "过去很长一段时间里，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 260490,
      "end_ms": 262495,
      "text": "人们的生活轨迹是相对固定的，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 263060,
      "end_ms": 265200,
      "text": "出生在一个地方就大概率在那里过。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 265200,
      "end_ms": 267790,
      "text": "一辈子干什么工作、跟谁结婚，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 268110,
      "end_ms": 269210,
      "text": "什么时候做什么事，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 269350,
      "end_ms": 270625,
      "text": "都有明确的规矩，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 270930,
      "end_ms": 272310,
      "text": "那样的生活未必自由。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 272550,
      "end_ms": 275310,
      "text": "但至少你知道自己在哪个格子里爱的情况。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 275410,
      "end_ms": 276265,
      "text": "刚好反过来，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 276720,
      "end_ms": 277840,
      "text": "大家流动性大了，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 277860,
      "end_ms": 278655,
      "text": "选择多了，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 278970,
      "end_ms": 279770,
      "text": "可以换城市，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 279910,
      "end_ms": 281255,
      "text": "换工作、换伴侣。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 281620,
      "end_ms": 283315,
      "text": "但很多人反而更迷茫了。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 283700,
      "end_ms": 284420,
      "text": "机会多了，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 284600,
      "end_ms": 285605,
      "text": "焦虑也多了，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 286040,
      "end_ms": 286820,
      "text": "自由大了，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 286900,
      "end_ms": 288005,
      "text": "方向感也淡了，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 288480,
      "end_ms": 290985,
      "text": "这正是黄泥街最让人感同身受的地方。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 291230,
      "end_ms": 294740,
      "text": "表面上黄泥街上的人被困在这条脏兮兮的街上，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 294740,
      "end_ms": 295325,
      "text": "出不去。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 295640,
      "end_ms": 296485,
      "text": "但如果仔细看，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 296740,
      "end_ms": 298755,
      "text": "他们并不是被物理的墙围住的，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 299070,
      "end_ms": 300775,
      "text": "而是被一种看不见的力量。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 301070,
      "end_ms": 302450,
      "text": "一种让人放弃思考，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 302550,
      "end_ms": 303535,
      "text": "放弃选择，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 303800,
      "end_ms": 305840,
      "text": "放弃想象另一种生活的力量，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 306000,
      "end_ms": 307105,
      "text": "牢牢锁住的。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 307660,
      "end_ms": 309580,
      "text": "那条街上的灰尘从来不会停，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 309940,
      "end_ms": 311500,
      "text": "垃圾永远扫不干净。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 311820,
      "end_ms": 313360,
      "text": "水果一上市就烂掉。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 313840,
      "end_ms": 314860,
      "text": "这些不是天灾，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 315180,
      "end_ms": 317720,
      "text": "而是某种系统性的东西在反复运转。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 318200,
      "end_ms": 319360,
      "text": "你我生活的城市里，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 319360,
      "end_ms": 321380,
      "text": "没有黄泥街那么夸张的肮脏。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 321780,
      "end_ms": 323280,
      "text": "但那种日子在过，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 323420,
      "end_ms": 325320,
      "text": "但不知道在往哪儿过的感觉，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 325620,
      "end_ms": 327000,
      "text": "是不是也有几分相似。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 327080,
      "end_ms": 328200,
      "text": "说完为什么值得读？"
    },
    {
      "segment_id": "s000151",
      "start_ms": 328480,
      "end_ms": 330280,
      "text": "再说说这本书到底写了什么？"
    },
    {
      "segment_id": "s000152",
      "start_ms": 330540,
      "end_ms": 333780,
      "text": "黄泥街是残血的长篇处女作初稿，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 333780,
      "end_ms": 335860,
      "text": "完成于一九八三年那年，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 335880,
      "end_ms": 337115,
      "text": "他刚满三十岁，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 337530,
      "end_ms": 339950,
      "text": "伏在缝纫机上利用做裁缝的间隙，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 340030,
      "end_ms": 342070,
      "text": "一字一句写出来的小说。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 342070,
      "end_ms": 344810,
      "text": "一九八六年十一月才在丁玲的支持下，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 344870,
      "end_ms": 346770,
      "text": "发表于中国杂志中间，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 346770,
      "end_ms": 347210,
      "text": "被退稿，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 347210,
      "end_ms": 348350,
      "text": "多次残雪，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 348350,
      "end_ms": 349350,
      "text": "本名邓小华，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 349750,
      "end_ms": 356350,
      "text": "做过洗工、装配工、赤脚医生、裁缝这些经历和文学看起来毫无关系，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 356470,
      "end_ms": 359110,
      "text": "但他后来以黄泥街、山上的小屋等作品，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 359230,
      "end_ms": 361790,
      "text": "成为中国先锋文学最重要的作家之一，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 361990,
      "end_ms": 366230,
      "text": "也是近年来诺贝尔文学奖赔率榜上的热门人选读。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 366230,
      "end_ms": 368800,
      "text": "黄泥街之前有一个最基本的认知，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 368800,
      "end_ms": 370700,
      "text": "需要建立这部小说，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 370920,
      "end_ms": 372885,
      "text": "没有传统意义上的主人公，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 373400,
      "end_ms": 375205,
      "text": "没有一条清晰的情节线，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 375500,
      "end_ms": 377795,
      "text": "甚至很难说他在讲一个故事，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 378310,
      "end_ms": 381575,
      "text": "他写的是一条街上的一群人的生存状态。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 382050,
      "end_ms": 382835,
      "text": "你可能会问，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 383180,
      "end_ms": 384980,
      "text": "没有主人公没有情节，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 385160,
      "end_ms": 387255,
      "text": "那读什么这个问题问的好，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 387760,
      "end_ms": 388725,
      "text": "残雪自己说过，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 389040,
      "end_ms": 392345,
      "text": "他的作品根本就不是反映或反思现实的。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 392780,
      "end_ms": 394445,
      "text": "即使采用了现实的材料，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 394690,
      "end_ms": 395795,
      "text": "那也是另有用途。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 396380,
      "end_ms": 396760,
      "text": "他认为，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 396760,
      "end_ms": 398860,
      "text": "实验小说的任务不是反映现实，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 399140,
      "end_ms": 403005,
      "text": "而是逐步建立起个人的乃至全人类的生命王国，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 403370,
      "end_ms": 405455,
      "text": "开拓发展出一片新天地。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 406000,
      "end_ms": 406420,
      "text": "所以，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 406780,
      "end_ms": 409485,
      "text": "黄泥街不是一本告诉你发生了什么的书，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 409930,
      "end_ms": 413350,
      "text": "而是一本让你感受活着是什么感觉的书。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 413490,
      "end_ms": 415310,
      "text": "在正式进入这本书的细节之前，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 415670,
      "end_ms": 417670,
      "text": "先说黄泥街到底长什么样，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 417849,
      "end_ms": 421090,
      "text": "那条街上一年四季都在落灰黑色的灰尘，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 421090,
      "end_ms": 422190,
      "text": "不知道从哪里来。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 422450,
      "end_ms": 424935,
      "text": "把天空染成灰中带黄的颜色，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 425280,
      "end_ms": 426905,
      "text": "连雨水都是灰黑色，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 427230,
      "end_ms": 428750,
      "text": "街上的人大多有红眼病，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 428970,
      "end_ms": 430310,
      "text": "一年四季都在咳嗽。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 430750,
      "end_ms": 432770,
      "text": "他们从来没有见过日出和日落。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 433110,
      "end_ms": 435270,
      "text": "太阳在他们眼里只是一个小小的黄球，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 435610,
      "end_ms": 437090,
      "text": "一会儿出现一会儿消失，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 437470,
      "end_ms": 438030,
      "text": "有他没，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 438030,
      "end_ms": 439170,
      "text": "他好像都无所谓，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 439570,
      "end_ms": 440910,
      "text": "街上到处是死猪。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 441210,
      "end_ms": 441750,
      "text": "死猫，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 442110,
      "end_ms": 443310,
      "text": "烂肉、驱虫，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 443550,
      "end_ms": 446530,
      "text": "苍蝇蚊子街上偶遇还会钓死鱼。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 447110,
      "end_ms": 453650,
      "text": "黄泥街爱卖烂果子烂苹果烂梨子烂橘子、烂桃子有什么卖什么？"
    },
    {
      "segment_id": "s000204",
      "start_ms": 454010,
      "end_ms": 455590,
      "text": "街上终年飘着烂果子，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 455590,
      "end_ms": 457005,
      "text": "甜腻腻的腐败香味，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 457680,
      "end_ms": 459220,
      "text": "但黄泥街人一般吃不起，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 459220,
      "end_ms": 461520,
      "text": "水果虽是烂的也吃不起，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 462000,
      "end_ms": 464460,
      "text": "当家里的小孩嚷着要吃时大，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 464460,
      "end_ms": 466600,
      "text": "人们就吓唬他烂果子吃了。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 466600,
      "end_ms": 468820,
      "text": "要得癌症的这些意向放在一起，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 468960,
      "end_ms": 470980,
      "text": "构成了一个极其压抑的画面。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 471360,
      "end_ms": 472700,
      "text": "但残血写这些东西，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 472900,
      "end_ms": 474200,
      "text": "不是为了恶心读者，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 474320,
      "end_ms": 476060,
      "text": "而是在构建一个隐喻空间。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 476240,
      "end_ms": 481080,
      "text": "黑色的灰尘是从火葬场的烟囱里飘来的死猪烂肉。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 481200,
      "end_ms": 484260,
      "text": "蛆虫象征的是精神和身体的全面腐烂，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 484700,
      "end_ms": 486200,
      "text": "永远卖不掉的烂果子。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 486200,
      "end_ms": 489070,
      "text": "象征的是在一个已经坏掉的环境里，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 489230,
      "end_ms": 491350,
      "text": "连好的东西都维持不住，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 491870,
      "end_ms": 494110,
      "text": "一切从一出现就开始腐败。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 494670,
      "end_ms": 498530,
      "text": "而红眼病和咳嗽则是环境对人身体的直接烙印。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 499010,
      "end_ms": 500750,
      "text": "你生活在什么样的空气里，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 500910,
      "end_ms": 503490,
      "text": "你的身体就会以什么方式做出反应。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 503630,
      "end_ms": 504390,
      "text": "进入这条街，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 504650,
      "end_ms": 506310,
      "text": "你会遇到一群什么样的人呢？"
    },
    {
      "segment_id": "s000226",
      "start_ms": 506450,
      "end_ms": 509550,
      "text": "胡三老头是其中一个让人过目难忘的角色，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 509750,
      "end_ms": 511690,
      "text": "他的女儿对他恶劣到了极点。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 511890,
      "end_ms": 512410,
      "text": "有一天，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 512430,
      "end_ms": 513190,
      "text": "端起一便盆，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 513190,
      "end_ms": 514810,
      "text": "尿朝他颈窝里倒下去，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 515150,
      "end_ms": 519340,
      "text": "倒过之后还怨恨的啐了他一口胡三老头被女儿嫌弃，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 519340,
      "end_ms": 520040,
      "text": "活得太久，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 520600,
      "end_ms": 522500,
      "text": "感到湿冷阴暗的棚子里住。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 522860,
      "end_ms": 527580,
      "text": "于是他专门做梦借睡梦来逃避身体的疼痛和人类的冷漠。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 527960,
      "end_ms": 531840,
      "text": "但有意思的是当王紫光的阴魂出现在黄泥街之后，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 532140,
      "end_ms": 534060,
      "text": "这个老头忽然脱掉了身上。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 534060,
      "end_ms": 535780,
      "text": "那件污迹斑斑的烂棉袄，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 536080,
      "end_ms": 537100,
      "text": "打起赤膊来，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 537340,
      "end_ms": 538480,
      "text": "变得双目生光，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 538560,
      "end_ms": 539360,
      "text": "精神抖擞，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 539420,
      "end_ms": 540200,
      "text": "仪表堂堂。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 540880,
      "end_ms": 543140,
      "text": "一个被女儿用尿泼声的老头，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 543520,
      "end_ms": 546645,
      "text": "因为一个虚无缥缈的希望就焕然一新。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 547190,
      "end_ms": 548190,
      "text": "这到底说明什么？"
    },
    {
      "segment_id": "s000245",
      "start_ms": 548210,
      "end_ms": 551250,
      "text": "说明人的精神韧性远比肉体想象的要强，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 551770,
      "end_ms": 554870,
      "text": "但也说明这种韧性有时候是靠幻觉来维持的。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 554870,
      "end_ms": 556630,
      "text": "还有一个贯穿全书的关键词，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 556930,
      "end_ms": 558070,
      "text": "叫王子光。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 558270,
      "end_ms": 559030,
      "text": "故事的开端，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 559050,
      "end_ms": 561830,
      "text": "是有人在梦里说出了一个叫王子光的名字。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 562190,
      "end_ms": 562610,
      "text": "从此，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 562690,
      "end_ms": 565010,
      "text": "黄泥街人的生活发生了显著变化。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 565350,
      "end_ms": 568250,
      "text": "王子光是什么没有人说的清楚，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 569070,
      "end_ms": 571770,
      "text": "有人说他是改变生活态度的大事情。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 572190,
      "end_ms": 574230,
      "text": "有人说他是黄泥街人的理字。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 574670,
      "end_ms": 575150,
      "text": "有人说，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 575150,
      "end_ms": 576090,
      "text": "王子光的出现，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 576150,
      "end_ms": 578160,
      "text": "关系到我的生死存亡问题，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 578260,
      "end_ms": 579280,
      "text": "人们争论他，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 579540,
      "end_ms": 580240,
      "text": "期待他，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 580380,
      "end_ms": 581140,
      "text": "恐惧他，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 581480,
      "end_ms": 583300,
      "text": "但没有一个人真正见过他。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 583500,
      "end_ms": 584760,
      "text": "王子光自始至终，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 584760,
      "end_ms": 588320,
      "text": "通过黄泥街人一系列的死亡事件暗示着他的存在。"
    },
    {
      "segment_id": "s000265",
      "start_ms": 588780,
      "end_ms": 590000,
      "text": "他的形象变幻，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 590020,
      "end_ms": 591500,
      "text": "万端极神秘，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 591720,
      "end_ms": 592460,
      "text": "极晦涩，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 592700,
      "end_ms": 594260,
      "text": "绝对抓不住他。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 594260,
      "end_ms": 595200,
      "text": "可以是任何人，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 595560,
      "end_ms": 596820,
      "text": "也可以什么都不是，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 597120,
      "end_ms": 597960,
      "text": "他是理想，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 598160,
      "end_ms": 598860,
      "text": "是希望，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 599040,
      "end_ms": 599760,
      "text": "是恐惧，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 600300,
      "end_ms": 601900,
      "text": "是一个所有人都在谈论，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 601900,
      "end_ms": 604000,
      "text": "但没有一个人真正了解的东西。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 604160,
      "end_ms": 606220,
      "text": "黄泥街上的死亡更是荒诞的，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 606220,
      "end_ms": 608025,
      "text": "让人不知道该哭还是该笑。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 609080,
      "end_ms": 610040,
      "text": "死亡登记表上，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 610040,
      "end_ms": 612520,
      "text": "记录的死因有饮食过度致死，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 612940,
      "end_ms": 615520,
      "text": "有自愿吞玻璃死法，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 615540,
      "end_ms": 616180,
      "text": "五花八门，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 616340,
      "end_ms": 618380,
      "text": "但都被一本正经的登记造册。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 618580,
      "end_ms": 619640,
      "text": "满街的死猪，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 619880,
      "end_ms": 622880,
      "text": "烂肉、驱虫、苍蝇臭气冲天。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 623220,
      "end_ms": 627060,
      "text": "街上的人就在这臭气里活着忙着说着闲话。"
    },
    {
      "segment_id": "s000286",
      "start_ms": 627180,
      "end_ms": 627960,
      "text": "有评论指出，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 628260,
      "end_ms": 631020,
      "text": "残血通过构建恐怖的非自然空间，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 631100,
      "end_ms": 632700,
      "text": "凸显了人的生存困境。"
    },
    {
      "segment_id": "s000289",
      "start_ms": 632780,
      "end_ms": 634720,
      "text": "通过塑造变态的非自然心理，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 634760,
      "end_ms": 636340,
      "text": "折射了人的精神困境。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 636520,
      "end_ms": 638645,
      "text": "通过采用梦一般的非自然叙述，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 638830,
      "end_ms": 640310,
      "text": "反映了人的表达困境。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 641310,
      "end_ms": 643130,
      "text": "这三个困境层层递进，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 643310,
      "end_ms": 644210,
      "text": "从外到内，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 644290,
      "end_ms": 645650,
      "text": "从身体到精神，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 645650,
      "end_ms": 646310,
      "text": "到语言，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 646670,
      "end_ms": 648450,
      "text": "构成了一张密不透风的网。"
    },
    {
      "segment_id": "s000298",
      "start_ms": 648950,
      "end_ms": 650490,
      "text": "那这本书到底在写什么？"
    },
    {
      "segment_id": "s000299",
      "start_ms": 651030,
      "end_ms": 654450,
      "text": "如果要说一个核心主题就是人的存在困境。"
    },
    {
      "segment_id": "s000300",
      "start_ms": 654470,
      "end_ms": 656110,
      "text": "黄泥街上的人被困住了，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 656350,
      "end_ms": 658090,
      "text": "但他们自己并不完全知道。"
    },
    {
      "segment_id": "s000302",
      "start_ms": 658570,
      "end_ms": 659830,
      "text": "他们知道日子不好过，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 660110,
      "end_ms": 661450,
      "text": "知道环境脏乱差。"
    },
    {
      "segment_id": "s000304",
      "start_ms": 661750,
      "end_ms": 662930,
      "text": "但他们不知道的是，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 663210,
      "end_ms": 666470,
      "text": "这些东西正在一点一点吞噬他们作为人的可能性，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 666570,
      "end_ms": 667850,
      "text": "每个人都无所事事，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 668030,
      "end_ms": 669005,
      "text": "做着白日梦哦，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 669400,
      "end_ms": 670785,
      "text": "大热天也裹着棉袄，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 671190,
      "end_ms": 672350,
      "text": "大家都在说梦话，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 672410,
      "end_ms": 672810,
      "text": "造谣，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 673170,
      "end_ms": 673770,
      "text": "吓着别人，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 673770,
      "end_ms": 674590,
      "text": "也吓着自己。"
    },
    {
      "segment_id": "s000313",
      "start_ms": 674610,
      "end_ms": 676065,
      "text": "黄泥街永远在清扫，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 676400,
      "end_ms": 678360,
      "text": "扫掉污泥死老鼠腐烂，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 678360,
      "end_ms": 679670,
      "text": "菜叶可垃圾，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 679670,
      "end_ms": 681155,
      "text": "第二天又原样冒出来，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 681370,
      "end_ms": 683210,
      "text": "人们开没完没了的会说，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 683230,
      "end_ms": 684145,
      "text": "没完没了的话，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 684520,
      "end_ms": 685805,
      "text": "但一切都没有变化，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 686190,
      "end_ms": 687970,
      "text": "这种状态有没有觉得眼熟？"
    },
    {
      "segment_id": "s000321",
      "start_ms": 687970,
      "end_ms": 688905,
      "text": "当然，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 689320,
      "end_ms": 692025,
      "text": "黄泥街的故事有它特定的历史语境。"
    },
    {
      "segment_id": "s000323",
      "start_ms": 692450,
      "end_ms": 694265,
      "text": "小说以文革时期为背景，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 694550,
      "end_ms": 697735,
      "text": "但它的意义远不止于对某一段历史的控诉。"
    },
    {
      "segment_id": "s000325",
      "start_ms": 698200,
      "end_ms": 699435,
      "text": "它更像是一面镜子，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 699740,
      "end_ms": 703340,
      "text": "照出的是人在任何一种被异化的环境中的普遍状态。"
    },
    {
      "segment_id": "s000327",
      "start_ms": 703400,
      "end_ms": 705420,
      "text": "当一个人每天重复同样的劳动，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 705420,
      "end_ms": 706440,
      "text": "却看不到意义。"
    },
    {
      "segment_id": "s000329",
      "start_ms": 706520,
      "end_ms": 708400,
      "text": "当所有人都在谈论同一个话题，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 708400,
      "end_ms": 710045,
      "text": "但没有一个人真正理解。"
    },
    {
      "segment_id": "s000331",
      "start_ms": 710340,
      "end_ms": 711560,
      "text": "当你知道哪里不对劲，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 711560,
      "end_ms": 712440,
      "text": "但已经习惯了，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 712440,
      "end_ms": 713195,
      "text": "不去追问，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 713630,
      "end_ms": 716600,
      "text": "你就已经住在黄泥街上残雪，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 716600,
      "end_ms": 720115,
      "text": "自己说过他的哲学观与文学观后来有所发展。"
    },
    {
      "segment_id": "s000336",
      "start_ms": 720930,
      "end_ms": 723090,
      "text": "他早期提出的精神自传的提罚，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 723270,
      "end_ms": 727875,
      "text": "后来被他本人修正为生命历程及灵肉合一的自传。"
    },
    {
      "segment_id": "s000338",
      "start_ms": 728280,
      "end_ms": 730340,
      "text": "他的写作关注的是人的精神世界，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 730340,
      "end_ms": 733005,
      "text": "本身是灵魂的挣扎与突围。"
    },
    {
      "segment_id": "s000340",
      "start_ms": 733560,
      "end_ms": 734755,
      "text": "从黄泥街开始，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 735090,
      "end_ms": 736285,
      "text": "他就在做一件事情，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 736550,
      "end_ms": 738655,
      "text": "把人放在一个极端的环境里，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 739010,
      "end_ms": 740235,
      "text": "看他会变成什么样子。"
    },
    {
      "segment_id": "s000344",
      "start_ms": 740780,
      "end_ms": 741355,
      "text": "答案是，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 741780,
      "end_ms": 744695,
      "text": "既让人绝望又让人肃然起敬的。"
    },
    {
      "segment_id": "s000346",
      "start_ms": 745330,
      "end_ms": 746155,
      "text": "绝望在于，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 746550,
      "end_ms": 748890,
      "text": "绝大多数人选择了麻木、自欺，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 749190,
      "end_ms": 750155,
      "text": "随波逐流。"
    },
    {
      "segment_id": "s000349",
      "start_ms": 750620,
      "end_ms": 751735,
      "text": "令人起敬在于，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 752110,
      "end_ms": 753935,
      "text": "即便在最肮脏的环境里，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 754210,
      "end_ms": 756550,
      "text": "人的精神依然有闪光的瞬间。"
    },
    {
      "segment_id": "s000352",
      "start_ms": 756690,
      "end_ms": 757605,
      "text": "有学者指出，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 757980,
      "end_ms": 762700,
      "text": "黄泥街探讨了人物不甘沉沦的闪光的人性和强韧的生命力，"
    },
    {
      "segment_id": "s000354",
      "start_ms": 762880,
      "end_ms": 764445,
      "text": "人性在黑暗中闪光，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 764790,
      "end_ms": 766775,
      "text": "在地狱中温柔的发现自我，"
    },
    {
      "segment_id": "s000356",
      "start_ms": 767090,
      "end_ms": 768255,
      "text": "并进行自我欺骗。"
    },
    {
      "segment_id": "s000357",
      "start_ms": 768840,
      "end_ms": 774415,
      "text": "这种自欺恰恰是作品要展示的人性的自我超越和自我否定之间的矛盾。"
    },
    {
      "segment_id": "s000358",
      "start_ms": 774750,
      "end_ms": 775390,
      "text": "说到自欺，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 775770,
      "end_ms": 777470,
      "text": "这是理解黄泥街的一把钥匙，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 777670,
      "end_ms": 780090,
      "text": "黄泥街上的人几乎都活在自欺之中。"
    },
    {
      "segment_id": "s000361",
      "start_ms": 780210,
      "end_ms": 781470,
      "text": "他们知道环境糟糕，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 781750,
      "end_ms": 783815,
      "text": "但告诉自己大家都是这样过的。"
    },
    {
      "segment_id": "s000363",
      "start_ms": 784390,
      "end_ms": 786735,
      "text": "他们知道王子光可能只是一个幻觉，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 787060,
      "end_ms": 788835,
      "text": "但告诉自己他一定会来。"
    },
    {
      "segment_id": "s000365",
      "start_ms": 789340,
      "end_ms": 791295,
      "text": "他们知道死亡随时可能降临，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 791690,
      "end_ms": 793490,
      "text": "但告诉自己那是别人的事儿。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 793630,
      "end_ms": 795205,
      "text": "这种自欺不是愚蠢，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 795500,
      "end_ms": 798005,
      "text": "而是一种在极端环境中的生存本能。"
    },
    {
      "segment_id": "s000369",
      "start_ms": 798460,
      "end_ms": 800280,
      "text": "如果完全清醒的面对一切，"
    },
    {
      "segment_id": "s000370",
      "start_ms": 800540,
      "end_ms": 801540,
      "text": "人可能会疯掉，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 801700,
      "end_ms": 802420,
      "text": "但问题是，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 802740,
      "end_ms": 806055,
      "text": "长期的自欺会让人彻底丧失行动的能力，"
    },
    {
      "segment_id": "s000373",
      "start_ms": 806370,
      "end_ms": 807950,
      "text": "最终变成环境的一部分。"
    },
    {
      "segment_id": "s000374",
      "start_ms": 808050,
      "end_ms": 810065,
      "text": "残学把这种矛盾写到了极致，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 810390,
      "end_ms": 812585,
      "text": "让你在阅读的过程中不断的问自己，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 812830,
      "end_ms": 814905,
      "text": "我是不是也在某件事情上自欺，"
    },
    {
      "segment_id": "s000377",
      "start_ms": 815450,
      "end_ms": 816470,
      "text": "我是不是也在用？"
    },
    {
      "segment_id": "s000378",
      "start_ms": 816570,
      "end_ms": 818130,
      "text": "大家都是这样来安慰自己，"
    },
    {
      "segment_id": "s000379",
      "start_ms": 818130,
      "end_ms": 818855,
      "text": "不去改变。"
    },
    {
      "segment_id": "s000380",
      "start_ms": 819060,
      "end_ms": 820445,
      "text": "再说说这本书的写法，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 820880,
      "end_ms": 823900,
      "text": "读黄泥街的体验和读大多数小说完全不同，"
    },
    {
      "segment_id": "s000382",
      "start_ms": 824060,
      "end_ms": 825825,
      "text": "它没有一条清晰的时间线，"
    },
    {
      "segment_id": "s000383",
      "start_ms": 826220,
      "end_ms": 827940,
      "text": "没有因果分明的逻辑链条。"
    },
    {
      "segment_id": "s000384",
      "start_ms": 828460,
      "end_ms": 832600,
      "text": "事件和事件之间的关系是断裂的、跳跃的甚至矛盾的。"
    }
  ],
  "source_transcript_sha256": "9a2ad10e94b829b9c417cd2f841ed4157dbc866dc39d894c2c1499dc1bb5cb26"
}