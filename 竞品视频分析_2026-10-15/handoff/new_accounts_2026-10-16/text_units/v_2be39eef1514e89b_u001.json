{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_2be39eef1514e89b_u001",
  "video_id": "v_2be39eef1514e89b",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 749.077007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 430,
      "text": "上集，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 430,
      "end_ms": 9210,
      "text": "咱们聊了雕漆盘严丝徒、玉龙炉、珐琅炉青铜尊这集直接揭开谜底，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 9690,
      "end_ms": 12550,
      "text": "看看前五名到底绝到什么程度。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 13810,
      "end_ms": 15730,
      "text": "老规矩开讲之前，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 15910,
      "end_ms": 18310,
      "text": "劳烦您扣个一点个红心，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 18610,
      "end_ms": 20110,
      "text": "让我看看都是谁。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 20110,
      "end_ms": 22190,
      "text": "在听第五名，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 23070,
      "end_ms": 24890,
      "text": "彩漆描金楼阁式，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 24970,
      "end_ms": 25550,
      "text": "自开门，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 25590,
      "end_ms": 26030,
      "text": "群仙，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 26130,
      "end_ms": 27290,
      "text": "祝寿玉制。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 27290,
      "end_ms": 29750,
      "text": "钟您见过一座钟，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 30380,
      "end_ms": 34960,
      "text": "每到整点楼阁大门会自己打开，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 35380,
      "end_ms": 39620,
      "text": "里面走出一对小人敲钟的敲钟，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 41020,
      "end_ms": 42440,
      "text": "奏乐的奏乐嘛。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 42480,
      "end_ms": 46319,
      "text": "故宫里就有这么一座高一百八十五厘米，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 46500,
      "end_ms": 47400,
      "text": "将近两米，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 47720,
      "end_ms": 49680,
      "text": "里面藏了七套机械系统，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 50040,
      "end_ms": 53860,
      "text": "分别控制走时报时开门打乐，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 54140,
      "end_ms": 55060,
      "text": "小人走动，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 55500,
      "end_ms": 57700,
      "text": "水法流动船只航行。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 58360,
      "end_ms": 61485,
      "text": "每到整点楼哥的门自动打开，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 61870,
      "end_ms": 63470,
      "text": "小人缓缓走动，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 63770,
      "end_ms": 68795,
      "text": "乐声响起水法转动小船仿佛在水面航行。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 69320,
      "end_ms": 72735,
      "text": "就连国外瑞士钟表专家看过都感叹，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 73170,
      "end_ms": 75085,
      "text": "就算放到西洋钟表里，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 75620,
      "end_ms": 78005,
      "text": "这也是工艺极为复杂的珍品。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 78840,
      "end_ms": 82520,
      "text": "这座钟从乾隆八年十二月接旨设计，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 82520,
      "end_ms": 84825,
      "text": "到乾隆十四年正月完工，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 85210,
      "end_ms": 85950,
      "text": "历时五年。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 85950,
      "end_ms": 87230,
      "text": "多可。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 87230,
      "end_ms": 89685,
      "text": "您知道修复这座钟的人是谁吗？"
    },
    {
      "segment_id": "s000033",
      "start_ms": 90440,
      "end_ms": 93995,
      "text": "叫王金在故宫修了四十多年钟表。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 94390,
      "end_ms": 94625,
      "text": "嗯，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 94950,
      "end_ms": 97130,
      "text": "他第一次见到这座钟的时候，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 97430,
      "end_ms": 98935,
      "text": "器物残破不堪，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 99460,
      "end_ms": 101245,
      "text": "上千个零件散落一地，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 101690,
      "end_ms": 102875,
      "text": "没有原厂图纸，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 103090,
      "end_ms": 104405,
      "text": "没有现成配件，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 104900,
      "end_ms": 106935,
      "text": "坏一件就得亲手重做。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 107480,
      "end_ms": 108995,
      "text": "他打磨一个齿轮，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 109400,
      "end_ms": 112425,
      "text": "光用锉刀锉就花了整整一个星期，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 112960,
      "end_ms": 114575,
      "text": "一点点校准尺距，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 114900,
      "end_ms": 117825,
      "text": "让新零件和元件严丝合缝。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 118610,
      "end_ms": 119470,
      "text": "全部修好。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 119470,
      "end_ms": 120010,
      "text": "那一刻，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 120110,
      "end_ms": 121010,
      "text": "音乐响起，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 121230,
      "end_ms": 122550,
      "text": "大门缓缓打开，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 122910,
      "end_ms": 123790,
      "text": "小人迈步，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 124050,
      "end_ms": 125105,
      "text": "水法流转。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 125650,
      "end_ms": 126455,
      "text": "王晶说，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 126820,
      "end_ms": 127360,
      "text": "那一刻，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 127580,
      "end_ms": 129425,
      "text": "心里的欢喜难以形容，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 130180,
      "end_ms": 132235,
      "text": "这座钟两百多年了，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 132440,
      "end_ms": 134705,
      "text": "上了发条依旧可以运转。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 135230,
      "end_ms": 136950,
      "text": "靠着后人一双巧手，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 137410,
      "end_ms": 140645,
      "text": "让两百多年前的机械再次活了过来。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 141690,
      "end_ms": 144880,
      "text": "第四名青遇大禹治水图，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 144880,
      "end_ms": 147215,
      "text": "山子这件东西，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 149670,
      "end_ms": 152755,
      "text": "您第一眼看到他的时候会愣住，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 153800,
      "end_ms": 157110,
      "text": "这东西人也能做出来。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 157190,
      "end_ms": 162310,
      "text": "高两米二四重约五千三百公斤，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 162330,
      "end_ms": 165025,
      "text": "是中国现存体量极大的玉雕。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 166030,
      "end_ms": 172250,
      "text": "这么大一块玉料采自新疆和田的弥勒塔山开采出来之后，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 172430,
      "end_ms": 173730,
      "text": "先要运到北京，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 173970,
      "end_ms": 176975,
      "text": "再从北京转运到扬州雕刻。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 177390,
      "end_ms": 180525,
      "text": "您想想几千公里的路途，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 181220,
      "end_ms": 182560,
      "text": "那时候没有火车，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 182840,
      "end_ms": 183855,
      "text": "没有汽车，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 184300,
      "end_ms": 185905,
      "text": "全靠人拉马坨，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 186660,
      "end_ms": 190605,
      "text": "光是运送这块玉石路上就耗费好几年。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 191840,
      "end_ms": 194835,
      "text": "到了扬州顶尖御宫正式开工，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 195380,
      "end_ms": 197605,
      "text": "数百名工匠耗时六年，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 198490,
      "end_ms": 200485,
      "text": "足足十五万个工作日，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 201260,
      "end_ms": 205435,
      "text": "才把一块冰冷巨石雕琢成一座会讲故事的山，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 206160,
      "end_ms": 208905,
      "text": "雕刻的是大禹治水的故事，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 209730,
      "end_ms": 211590,
      "text": "山峦、激流人物，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 211850,
      "end_ms": 213850,
      "text": "树木层层叠叠，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 213890,
      "end_ms": 214855,
      "text": "深浅错落。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 215590,
      "end_ms": 216715,
      "text": "您站在他面前，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 217620,
      "end_ms": 219525,
      "text": "不会觉得眼前只是一块玉，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 219970,
      "end_ms": 222535,
      "text": "仿佛真的站在一座大山跟前。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 223490,
      "end_ms": 226310,
      "text": "从深山采玉到雕琢，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 226330,
      "end_ms": 226865,
      "text": "完工，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 227590,
      "end_ms": 229235,
      "text": "前后整整十年，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 230090,
      "end_ms": 230610,
      "text": "十年，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 230710,
      "end_ms": 236215,
      "text": "光阴数千人的心血全都倾注在这一块玉石上。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 236630,
      "end_ms": 237695,
      "text": "完工之后，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 238050,
      "end_ms": 241030,
      "text": "乾隆十分看重亲笔题诗，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 241530,
      "end_ms": 247630,
      "text": "让人刻在玉山背面第三名金欧永固杯。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 248530,
      "end_ms": 253010,
      "text": "您知道乾隆皇帝每年大年初一早上起来做的第一件事是什么吗？"
    },
    {
      "segment_id": "s000092",
      "start_ms": 253970,
      "end_ms": 258870,
      "text": "用这只杯子喝一杯酒举行开笔仪式。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 259530,
      "end_ms": 262330,
      "text": "这只杯子叫金欧永固纯金，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 262430,
      "end_ms": 265330,
      "text": "打造杯身上镶嵌珍珠。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 265590,
      "end_ms": 269800,
      "text": "红宝石蓝宝石碧玺一共三十六颗。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 270720,
      "end_ms": 273800,
      "text": "刻杯子两侧是龙形双耳底部，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 273820,
      "end_ms": 277919,
      "text": "三条腿做成象首造型龙头嵌珍珠，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 278340,
      "end_ms": 279480,
      "text": "象首的额头，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 279740,
      "end_ms": 281880,
      "text": "眼睛也都嵌满宝石，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 282740,
      "end_ms": 285100,
      "text": "花纹之间还用了点翠工艺，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 285120,
      "end_ms": 287800,
      "text": "把翠鸟羽毛贴在黄金之上，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 288100,
      "end_ms": 289660,
      "text": "蓝的鲜亮夺目。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 290460,
      "end_ms": 292460,
      "text": "乾隆对这只杯子极为重视，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 293060,
      "end_ms": 295845,
      "text": "从内务府挑选最好的黄金。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 296570,
      "end_ms": 300350,
      "text": "珍珠宝石反复敲定图样，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 300790,
      "end_ms": 301210,
      "text": "制作，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 301210,
      "end_ms": 302630,
      "text": "图中一改再改，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 303290,
      "end_ms": 304610,
      "text": "直到满意为止。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 305450,
      "end_ms": 310650,
      "text": "清代一共制作了四支金欧永固碑故宫，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 310650,
      "end_ms": 313530,
      "text": "现存这一只一直留在紫禁城，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 313810,
      "end_ms": 319930,
      "text": "还有一只收藏在台北故宫博物院另外一只铜鎏金款，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 320110,
      "end_ms": 321170,
      "text": "一只纯金款。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 321630,
      "end_ms": 324830,
      "text": "一千八百六十年圆明园遭劫掠时，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 324870,
      "end_ms": 326300,
      "text": "被英法联军带走，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 326540,
      "end_ms": 327620,
      "text": "几经辗转，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 327860,
      "end_ms": 333120,
      "text": "如今藏在英国伦敦华莱士收藏馆一只小小的杯子，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 333300,
      "end_ms": 335140,
      "text": "乾隆反复修改打磨，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 335560,
      "end_ms": 337420,
      "text": "他哪里只是在做杯子。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 338400,
      "end_ms": 340540,
      "text": "这金鸥永固四个字，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 340880,
      "end_ms": 348020,
      "text": "寓意着江山永固第二名琅琊红釉穿戴之口瓶。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 348880,
      "end_ms": 351960,
      "text": "这件东西您第一眼望过去，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 352200,
      "end_ms": 354520,
      "text": "会以为瓶身敷了一层红宝石，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 354520,
      "end_ms": 355560,
      "text": "研磨的粉墨，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 355860,
      "end_ms": 356825,
      "text": "红的发亮，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 357370,
      "end_ms": 358225,
      "text": "红的通透，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 358530,
      "end_ms": 360155,
      "text": "像刚刚凝固的牛血。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 361000,
      "end_ms": 362620,
      "text": "这种红釉叫琅窑，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 362620,
      "end_ms": 368485,
      "text": "红是康熙年间江西巡抚郎亭即主持景德镇御窑厂时，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 368990,
      "end_ms": 370655,
      "text": "窑工们烧制出来。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 371630,
      "end_ms": 373515,
      "text": "郎瑶红有一句口诀，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 374250,
      "end_ms": 376170,
      "text": "脱口垂足狼不留，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 376370,
      "end_ms": 377105,
      "text": "什么意思？"
    },
    {
      "segment_id": "s000133",
      "start_ms": 377450,
      "end_ms": 381045,
      "text": "哥又料高温下会往下流淌，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 381340,
      "end_ms": 381580,
      "text": "口，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 381600,
      "end_ms": 382900,
      "text": "沿处又流走，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 383180,
      "end_ms": 384620,
      "text": "露出白色胎体，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 384880,
      "end_ms": 388445,
      "text": "叫脱口瓶底的釉堆积变厚，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 388870,
      "end_ms": 389770,
      "text": "颜色更深，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 390030,
      "end_ms": 391015,
      "text": "叫垂足。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 391680,
      "end_ms": 394700,
      "text": "工匠特意在砥足做出二层台，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 395100,
      "end_ms": 396565,
      "text": "拦住流淌的釉，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 396950,
      "end_ms": 398545,
      "text": "不让他漫到圈组底部。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 399300,
      "end_ms": 400645,
      "text": "这就是狼不留。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 401480,
      "end_ms": 403420,
      "text": "您知道琅窑红有多难烧吗？"
    },
    {
      "segment_id": "s000145",
      "start_ms": 403440,
      "end_ms": 406675,
      "text": "窑内温度差一点点发色就完全不对，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 407430,
      "end_ms": 409350,
      "text": "烧石窑能成功，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 409350,
      "end_ms": 410745,
      "text": "一窑就算运气。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 411470,
      "end_ms": 412555,
      "text": "民间老话讲，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 413010,
      "end_ms": 414695,
      "text": "要想穷烧狼红，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 415030,
      "end_ms": 418690,
      "text": "很多窑姑烧一辈子能出几件合格，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 418690,
      "end_ms": 420670,
      "text": "琅窑红就已经是万幸。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 421530,
      "end_ms": 424010,
      "text": "这件瓶子历经两百多年，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 424270,
      "end_ms": 425810,
      "text": "红色依旧鲜亮，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 426090,
      "end_ms": 426590,
      "text": "光彩，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 426590,
      "end_ms": 426950,
      "text": "不减，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 427930,
      "end_ms": 431090,
      "text": "第一名黄公望富春山居图。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 431570,
      "end_ms": 432710,
      "text": "您知道有一幅画，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 433350,
      "end_ms": 436610,
      "text": "画家耗尽半生心血才画成吗？"
    },
    {
      "segment_id": "s000159",
      "start_ms": 437430,
      "end_ms": 443330,
      "text": "元代画家黄公望五十岁左右才潜心学画七十九岁，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 443350,
      "end_ms": 446700,
      "text": "那年动笔绘制富春山居图，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 447480,
      "end_ms": 448680,
      "text": "前后画了四年。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 449280,
      "end_ms": 452580,
      "text": "画完他还提字阅三四载，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 452640,
      "end_ms": 453580,
      "text": "未得完备。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 454340,
      "end_ms": 456520,
      "text": "意思是画了三四年，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 456820,
      "end_ms": 459040,
      "text": "依旧觉得没有完全画到位。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 459520,
      "end_ms": 461720,
      "text": "这幅画画的是富春江两岸，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 461740,
      "end_ms": 463940,
      "text": "山水山不算巍峨，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 464000,
      "end_ms": 465080,
      "text": "水不算汹涌，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 465640,
      "end_ms": 467180,
      "text": "可您静心盯着看，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 467580,
      "end_ms": 469080,
      "text": "会感觉山势在动，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 469540,
      "end_ms": 472500,
      "text": "水似在流云气悠悠飘荡。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 472960,
      "end_ms": 476550,
      "text": "黄公望用笔极淡淡到几几乎，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 476610,
      "end_ms": 477490,
      "text": "若有若无，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 478170,
      "end_ms": 482470,
      "text": "但每一笔都落在恰到好处的位置。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 482610,
      "end_ms": 484249,
      "text": "明代董其昌看过之后，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 484249,
      "end_ms": 485150,
      "text": "盛赞这幅画，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 485630,
      "end_ms": 487130,
      "text": "称他应接不暇，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 487410,
      "end_ms": 488450,
      "text": "是意林飞仙。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 489230,
      "end_ms": 491850,
      "text": "可您知道这幅画后来的坎坷命运吗？"
    },
    {
      "segment_id": "s000180",
      "start_ms": 492470,
      "end_ms": 493350,
      "text": "明朝末年，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 493670,
      "end_ms": 496710,
      "text": "收藏家吴鸿玉对这幅画爱到极致，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 497090,
      "end_ms": 498970,
      "text": "临死前打算把画烧掉，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 499830,
      "end_ms": 500890,
      "text": "给自己殉葬。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 501610,
      "end_ms": 504910,
      "text": "他的侄子急忙从烈火中将画抢救出来，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 505570,
      "end_ms": 506320,
      "text": "可画就卷，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 506320,
      "end_ms": 511460,
      "text": "已经烧成两段短的一段叫圣山图收藏。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 511460,
      "end_ms": 514800,
      "text": "在浙江博物馆长的一段叫吴用，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 514900,
      "end_ms": 517560,
      "text": "诗卷藏在台北故宫博物院，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 517660,
      "end_ms": 518220,
      "text": "一幅画，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 518540,
      "end_ms": 519840,
      "text": "生生断成两半，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 520200,
      "end_ms": 521320,
      "text": "一半在浙江，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 521560,
      "end_ms": 522640,
      "text": "一半在台北。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 523300,
      "end_ms": 525400,
      "text": "可当您欣赏这两段画卷，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 525780,
      "end_ms": 527980,
      "text": "山水气韵依旧相连，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 528700,
      "end_ms": 530600,
      "text": "山接着水水映着，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 530600,
      "end_ms": 533360,
      "text": "山仿佛从来不曾被大火分开。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 533760,
      "end_ms": 535100,
      "text": "从第五到第一名，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 535620,
      "end_ms": 538230,
      "text": "玉制中内置七套机械系统，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 538350,
      "end_ms": 540510,
      "text": "两百多年后依旧可以运转。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 541350,
      "end_ms": 543690,
      "text": "大禹治水玉山十年，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 543750,
      "end_ms": 548050,
      "text": "雕琢一块五千多公斤的巨石金欧永固碑。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 548470,
      "end_ms": 549790,
      "text": "乾隆反复修改，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 550110,
      "end_ms": 551750,
      "text": "镶嵌三十六颗珍宝，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 552530,
      "end_ms": 553850,
      "text": "琅窑红石窑，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 554270,
      "end_ms": 555290,
      "text": "南城亦窑，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 555450,
      "end_ms": 556430,
      "text": "烧至极险，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 556850,
      "end_ms": 559410,
      "text": "富春山居途黄公望，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 559450,
      "end_ms": 560310,
      "text": "晚年落笔，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 560530,
      "end_ms": 561450,
      "text": "烧至极险，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 561830,
      "end_ms": 563850,
      "text": "山水气韵不曾断绝。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 564350,
      "end_ms": 565470,
      "text": "这十件国宝，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 565730,
      "end_ms": 567700,
      "text": "有的刷上百层大旗，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 568060,
      "end_ms": 569980,
      "text": "有的剪断数万根丝线，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 570480,
      "end_ms": 572020,
      "text": "有的耗费十年打磨，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 572300,
      "end_ms": 573480,
      "text": "有的一摇摇，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 573480,
      "end_ms": 574340,
      "text": "反复试烧。"
    },
    {
      "segment_id": "s000217",
      "start_ms": 574900,
      "end_ms": 576380,
      "text": "但他们有一个共同点，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 576660,
      "end_ms": 577600,
      "text": "全是中国人。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 577600,
      "end_ms": 578400,
      "text": "凭着一双手，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 578760,
      "end_ms": 582780,
      "text": "一刀一刀一针一线一层一层亲手做出来。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 583240,
      "end_ms": 585220,
      "text": "当年那些匠人制作的时候，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 585340,
      "end_ms": 588040,
      "text": "未必想着要做出惊世绝品，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 588760,
      "end_ms": 589920,
      "text": "心里只想着一件事，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 589920,
      "end_ms": 592420,
      "text": "这活儿要做到足够好。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 593180,
      "end_ms": 595695,
      "text": "您知道这些宝贝如今在哪儿吗？"
    },
    {
      "segment_id": "s000226",
      "start_ms": 596230,
      "end_ms": 600225,
      "text": "雕漆盘在漆器馆严词图在直绣馆。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 601040,
      "end_ms": 602980,
      "text": "玉制钟在钟表馆，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 603520,
      "end_ms": 604540,
      "text": "大禹治水，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 604560,
      "end_ms": 606160,
      "text": "玉山在珍宝馆，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 606700,
      "end_ms": 608140,
      "text": "可您就算去到故宫，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 608320,
      "end_ms": 610580,
      "text": "也未必能一次性全部看到。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 611320,
      "end_ms": 613160,
      "text": "有的常年不对外展出，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 613560,
      "end_ms": 614480,
      "text": "就算展出。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 614740,
      "end_ms": 616100,
      "text": "隔着厚厚的玻璃，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 616500,
      "end_ms": 618300,
      "text": "匆匆看几眼就过去了。"
    },
    {
      "segment_id": "s000236",
      "start_ms": 618520,
      "end_ms": 621540,
      "text": "您还记得那只金杯嵌了多少宝石吗？"
    },
    {
      "segment_id": "s000237",
      "start_ms": 622240,
      "end_ms": 626200,
      "text": "那座古钟里面有几套机械安思，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 626300,
      "end_ms": 628780,
      "text": "凭什么一寸真丝一寸金？"
    },
    {
      "segment_id": "s000239",
      "start_ms": 628960,
      "end_ms": 629620,
      "text": "前一阵子，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 629620,
      "end_ms": 631270,
      "text": "我翻到一本故宫日历，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 631830,
      "end_ms": 635810,
      "text": "他从故宫一百八十六万件文物里挑选精品，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 636030,
      "end_ms": 638630,
      "text": "一天一件展现在眼前。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 639430,
      "end_ms": 641310,
      "text": "二零二七年是羊年，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 641750,
      "end_ms": 646530,
      "text": "这本生肖日历收录九十件洋主题文物，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 646889,
      "end_ms": 652810,
      "text": "还有七十五件皇帝触寻文物、两百八十多件江南盛景文物。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 653790,
      "end_ms": 655670,
      "text": "咱们今天聊的这十件宝贝，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 656070,
      "end_ms": 658670,
      "text": "书里一件一件讲的清清楚楚，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 659070,
      "end_ms": 662245,
      "text": "您随手翻一页就能遇见一件国宝。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 662930,
      "end_ms": 664990,
      "text": "您要是计划去故宫出门前，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 664990,
      "end_ms": 665590,
      "text": "先翻一翻，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 665590,
      "end_ms": 667755,
      "text": "这本日历到了展厅，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 668130,
      "end_ms": 670745,
      "text": "您看的就不再是冷冰冰的石头、木桶，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 671220,
      "end_ms": 672745,
      "text": "而是老祖宗的智慧，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 673090,
      "end_ms": 676755,
      "text": "暂时没法去故宫的在家翻书看图，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 677270,
      "end_ms": 680410,
      "text": "也算足不出户一睹国宝风采。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 680670,
      "end_ms": 681745,
      "text": "放在茶几上，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 682210,
      "end_ms": 683310,
      "text": "孙子孙女来了，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 683310,
      "end_ms": 684355,
      "text": "随手翻两页，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 684930,
      "end_ms": 686250,
      "text": "既能长见识，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 686350,
      "end_ms": 687825,
      "text": "写作文都能用上。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 688240,
      "end_ms": 690005,
      "text": "老两口晚上一起翻一翻，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 690460,
      "end_ms": 693385,
      "text": "聊聊历史商量明年去哪游玩，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 693850,
      "end_ms": 696485,
      "text": "比一直刷手机有意思的多。"
    },
    {
      "segment_id": "s000264",
      "start_ms": 697690,
      "end_ms": 700075,
      "text": "一个家最珍贵的不是房子，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 700450,
      "end_ms": 701310,
      "text": "不是存款，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 701470,
      "end_ms": 702375,
      "text": "而是家底。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 703210,
      "end_ms": 704275,
      "text": "家底是什么？"
    },
    {
      "segment_id": "s000268",
      "start_ms": 704900,
      "end_ms": 707715,
      "text": "就是清楚咱们这个民族从哪里来？"
    },
    {
      "segment_id": "s000269",
      "start_ms": 708490,
      "end_ms": 712165,
      "text": "知道先辈曾经创下何等了不起的手艺，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 712660,
      "end_ms": 716130,
      "text": "这本书收录的就是咱们中国人的家底，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 716250,
      "end_ms": 718650,
      "text": "把他留下来下一代。"
    },
    {
      "segment_id": "s000272",
      "start_ms": 718650,
      "end_ms": 722375,
      "text": "翻开更明白自己身为中国人的根脉在哪里。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 723590,
      "end_ms": 727405,
      "text": "感兴趣的朋友下方小黄车点进去看一看，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 728220,
      "end_ms": 729565,
      "text": "暂时走不出去，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 730380,
      "end_ms": 732005,
      "text": "咱就把故宫搬进家里。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 733040,
      "end_ms": 734125,
      "text": "最后问您一句，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 735310,
      "end_ms": 740055,
      "text": "这十件东西您听说过几件最想去看哪一件？"
    },
    {
      "segment_id": "s000278",
      "start_ms": 740290,
      "end_ms": 741255,
      "text": "评论区告诉我，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 741500,
      "end_ms": 743020,
      "text": "觉得这期长见识了，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 743060,
      "end_ms": 743775,
      "text": "点个赞，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 744040,
      "end_ms": 744680,
      "text": "点个收藏，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 745000,
      "end_ms": 746460,
      "text": "想看更多故宫的故事，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 746460,
      "end_ms": 747285,
      "text": "点个关注，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 747650,
      "end_ms": 749015,
      "text": "咱们下回接着聊。"
    }
  ],
  "source_transcript_sha256": "fc812e9774eac8dd85b88bb689dd18d766e622a16f4a157f33cdd0fcb64c06cb"
}