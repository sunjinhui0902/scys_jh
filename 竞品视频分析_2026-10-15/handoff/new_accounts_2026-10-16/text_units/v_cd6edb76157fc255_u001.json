{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_cd6edb76157fc255_u001",
  "video_id": "v_cd6edb76157fc255",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 785.37,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 590,
      "text": "老朋友，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2270,
      "end_ms": 3930,
      "text": "咱们接着上一集的话题，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5090,
      "end_ms": 9550,
      "text": "上次咱们盘点国内藏在水边的十大人间仙境。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 10510,
      "end_ms": 12490,
      "text": "从第十讲到第六，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 13690,
      "end_ms": 18190,
      "text": "好多朋友看完视频在评论区跟我聊，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 18670,
      "end_ms": 18910,
      "text": "说，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 18950,
      "end_ms": 20350,
      "text": "千岛湖水下沉了，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 20350,
      "end_ms": 21290,
      "text": "两座古城，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21910,
      "end_ms": 23630,
      "text": "自己去游玩好几趟，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 24270,
      "end_ms": 26610,
      "text": "完全不知道还有这么一段往事。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 27050,
      "end_ms": 29190,
      "text": "我今天跟大伙儿掏心窝子，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 29190,
      "end_ms": 35140,
      "text": "说榜单剩下的前五名一处胜过一处，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 35680,
      "end_ms": 38140,
      "text": "特别是排在第一名的秘境，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 38560,
      "end_ms": 40880,
      "text": "去过的老游客回来跟我描述，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 40940,
      "end_ms": 42860,
      "text": "那湖水不是咱们常见的蓝，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 43160,
      "end_ms": 44840,
      "text": "也不是普通草木的绿，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 45080,
      "end_ms": 46560,
      "text": "是翡翠的颜色，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 46920,
      "end_ms": 48840,
      "text": "而且不是单单一块翡翠，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 49020,
      "end_ms": 49920,
      "text": "一片水洼，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 50100,
      "end_ms": 53980,
      "text": "一块一个颜色好几块翡翠铺在大地上。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 54600,
      "end_ms": 56680,
      "text": "十多年前这个地方路很难走，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 57360,
      "end_ms": 59495,
      "text": "普通车子根本不好进去。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 60100,
      "end_ms": 60985,
      "text": "直到今天，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 61690,
      "end_ms": 64445,
      "text": "还有很多朋友从来没听过这个地名，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 65560,
      "end_ms": 66835,
      "text": "咱们慢慢往下说，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 67570,
      "end_ms": 69345,
      "text": "看看这地方到底是哪里。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 69780,
      "end_ms": 71530,
      "text": "第五名嗯，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 71840,
      "end_ms": 73535,
      "text": "长白山天池，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 75180,
      "end_ms": 77460,
      "text": "吉林延边的长白山，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 77600,
      "end_ms": 78945,
      "text": "大伙儿都听过长白山，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 79850,
      "end_ms": 81215,
      "text": "冬天大雪纷飞，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 81690,
      "end_ms": 83765,
      "text": "山里还有温热的温泉，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 84240,
      "end_ms": 85280,
      "text": "可他能上榜，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 85420,
      "end_ms": 88200,
      "text": "最动人的就是山顶。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 88200,
      "end_ms": 89285,
      "text": "那汪天池，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 90260,
      "end_ms": 94825,
      "text": "天池是火山喷发之后留下的大坑，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 95230,
      "end_ms": 99300,
      "text": "积攒雨水融雪形成的湖两千多米，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 99300,
      "end_ms": 101230,
      "text": "高山顶上一圈，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 101510,
      "end_ms": 102410,
      "text": "灰黑色，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 102430,
      "end_ms": 105150,
      "text": "火山岩石团团围住，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 105150,
      "end_ms": 108255,
      "text": "湖水就好像大山睁开的眼睛。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 109150,
      "end_ms": 111555,
      "text": "天池的地方性子孤傲，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 111880,
      "end_ms": 113720,
      "text": "一年里头大半时间，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 113760,
      "end_ms": 114595,
      "text": "云雾缭绕，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 114880,
      "end_ms": 117660,
      "text": "能清清楚楚看见整个湖面的日子，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 117660,
      "end_ms": 118480,
      "text": "不多不少。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 118500,
      "end_ms": 120495,
      "text": "朋友攒了很久的心愿，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 121150,
      "end_ms": 123225,
      "text": "千里迢迢坐车爬山，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 123960,
      "end_ms": 125625,
      "text": "好不容易到山顶，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 126180,
      "end_ms": 127960,
      "text": "眼前白茫茫一片，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 127960,
      "end_ms": 128685,
      "text": "大雾，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 129260,
      "end_ms": 130435,
      "text": "啥都看不见，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 131140,
      "end_ms": 132645,
      "text": "只能遗憾下山。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 133710,
      "end_ms": 134970,
      "text": "可老天爷赏脸，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 135350,
      "end_ms": 136330,
      "text": "云雾散开，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 136330,
      "end_ms": 136850,
      "text": "那一刻，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 137210,
      "end_ms": 139135,
      "text": "谁看了都会心头一震。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 139690,
      "end_ms": 141875,
      "text": "那湖水蓝的温润又深邃，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 142360,
      "end_ms": 143120,
      "text": "不是大海，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 143120,
      "end_ms": 144405,
      "text": "那种开阔的蓝，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 144940,
      "end_ms": 147575,
      "text": "是像把整块蓝宝石融化，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 148110,
      "end_ms": 150105,
      "text": "静静的沉在火山口里，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 150670,
      "end_ms": 152030,
      "text": "周围光秃秃岩壁，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 152030,
      "end_ms": 153025,
      "text": "没有一棵树，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 153520,
      "end_ms": 157245,
      "text": "简简单单反倒衬得湖水干净安宁。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 158320,
      "end_ms": 160555,
      "text": "看着看着心里都安静下来，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 161400,
      "end_ms": 162505,
      "text": "想看天池，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 162900,
      "end_ms": 163925,
      "text": "全靠缘分。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 164890,
      "end_ms": 166265,
      "text": "有幸见过一次。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 167070,
      "end_ms": 168965,
      "text": "很多人多少年过去，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 169520,
      "end_ms": 173095,
      "text": "还记得那一幕火山造就大坑，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 173940,
      "end_ms": 175380,
      "text": "盛满一池蓝宝石，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 175840,
      "end_ms": 177735,
      "text": "常年云雾遮挡，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 178030,
      "end_ms": 179365,
      "text": "不愿轻易示人。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 180240,
      "end_ms": 180900,
      "text": "第四名，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 181140,
      "end_ms": 182260,
      "text": "荔波小七孔，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 182580,
      "end_ms": 187780,
      "text": "贵州黔南荔波县听名字带个小字，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 187960,
      "end_ms": 188960,
      "text": "可千万别小看。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 188960,
      "end_ms": 197880,
      "text": "这小七孔名字来自一座清代道光年间修建的七孔古石桥，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 198760,
      "end_ms": 199620,
      "text": "七个桥洞，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 200140,
      "end_ms": 201780,
      "text": "静静立在水上。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 201880,
      "end_ms": 205180,
      "text": "桥下的水是温润的翡翠绿，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 205840,
      "end_ms": 207460,
      "text": "阳光照进水里，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 207800,
      "end_ms": 212630,
      "text": "水底石头都泛着淡淡的绿光小七孔。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 212630,
      "end_ms": 214970,
      "text": "真正的美不在这座小桥，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 215930,
      "end_ms": 217610,
      "text": "走进景区深处，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 218150,
      "end_ms": 220910,
      "text": "一路都是层层叠叠的叠水瀑布，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 221450,
      "end_ms": 222210,
      "text": "千万年，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 222210,
      "end_ms": 223170,
      "text": "流水冲刷，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 223250,
      "end_ms": 230050,
      "text": "石灰岩冲出一级一级天然台阶水流顺着台阶一层层往下落，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 230470,
      "end_ms": 231910,
      "text": "形态各不相同。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 232450,
      "end_ms": 235070,
      "text": "有的像一整片白莲垂落，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 235610,
      "end_ms": 237830,
      "text": "有的散成无数细水珠。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 238550,
      "end_ms": 240400,
      "text": "台阶长满青青台，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 240420,
      "end_ms": 244530,
      "text": "小草流水从绿色植物之间穿过，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 244610,
      "end_ms": 246170,
      "text": "白色水花落在青苔，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 246170,
      "end_ms": 249875,
      "text": "上面沿着木质栈道往前走，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 250500,
      "end_ms": 252180,
      "text": "左右都是流水，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 252240,
      "end_ms": 252665,
      "text": "瀑布，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 252990,
      "end_ms": 254505,
      "text": "水汽扑面而来，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 255090,
      "end_ms": 260090,
      "text": "脸上一直润润的水流奔腾喧嚣，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 260350,
      "end_ms": 261210,
      "text": "流进水潭，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 261730,
      "end_ms": 263675,
      "text": "一下子就安静下来，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 264620,
      "end_ms": 266555,
      "text": "水潭颜色各不相同，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 267210,
      "end_ms": 269330,
      "text": "显处翠绿深处，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 269390,
      "end_ms": 269885,
      "text": "墨绿，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 270190,
      "end_ms": 271605,
      "text": "阳光洒落水面，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 272130,
      "end_ms": 273775,
      "text": "还会泛一层金光。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 274610,
      "end_ms": 278905,
      "text": "景区里面卧龙潭更是一绝，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 279270,
      "end_ms": 280830,
      "text": "湖水是淡淡的乳，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 280830,
      "end_ms": 281575,
      "text": "蓝色，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 282140,
      "end_ms": 283120,
      "text": "水面平滑，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 283500,
      "end_ms": 284815,
      "text": "几乎没有波纹。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 285260,
      "end_ms": 287240,
      "text": "看着就像凝固的蓝色果冻，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 287380,
      "end_ms": 290435,
      "text": "一座古桥连着层层瀑布，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 290750,
      "end_ms": 293425,
      "text": "一潭又一潭色彩不一样的碧水。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 294220,
      "end_ms": 296025,
      "text": "第三名九寨沟。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 296790,
      "end_ms": 298330,
      "text": "不少老朋友会疑惑，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 298650,
      "end_ms": 301270,
      "text": "九寨沟旺季到处都是游客，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 301750,
      "end_ms": 302770,
      "text": "怎么还排第三？"
    },
    {
      "segment_id": "s000121",
      "start_ms": 303270,
      "end_ms": 303890,
      "text": "实话讲，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 304230,
      "end_ms": 308390,
      "text": "暑假国庆九寨沟人确实多，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 309070,
      "end_ms": 310550,
      "text": "但九寨沟上榜，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 310590,
      "end_ms": 313050,
      "text": "比拼的不是清静，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 313350,
      "end_ms": 314130,
      "text": "是湖水。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 314950,
      "end_ms": 316350,
      "text": "国内这么多水景，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 317130,
      "end_ms": 318090,
      "text": "很多风光，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 318110,
      "end_ms": 320710,
      "text": "摄影师都说论水的色彩，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 321070,
      "end_ms": 322450,
      "text": "很难找到对手，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 322850,
      "end_ms": 325090,
      "text": "山谷里散落上百个海子。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 325570,
      "end_ms": 328220,
      "text": "海子就是当当地人对湖泊的叫法。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 328340,
      "end_ms": 330260,
      "text": "湖水通透见底，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 330360,
      "end_ms": 331340,
      "text": "颜色丰富，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 331900,
      "end_ms": 333200,
      "text": "五花海最出名，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 333560,
      "end_ms": 336240,
      "text": "站在高处往下望湖面，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 336380,
      "end_ms": 339240,
      "text": "就像大自然亲手调出来的调色盘，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 339740,
      "end_ms": 341520,
      "text": "蓝绿鹅黄，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 341860,
      "end_ms": 343600,
      "text": "深棕交错在一起。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 344040,
      "end_ms": 345820,
      "text": "之所以色彩这么丰富，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 346100,
      "end_ms": 348160,
      "text": "是湖底概化沉积物，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 348820,
      "end_ms": 350000,
      "text": "还有各式各样，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 350040,
      "end_ms": 353180,
      "text": "水草、藻类共同造就水深。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 353260,
      "end_ms": 354320,
      "text": "水浅不一样，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 354640,
      "end_ms": 356265,
      "text": "颜色就跟着变化，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 357620,
      "end_ms": 360115,
      "text": "九寨沟还有一样难得的景致。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 360570,
      "end_ms": 361470,
      "text": "水中倒影，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 361510,
      "end_ms": 362570,
      "text": "群山环抱，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 362570,
      "end_ms": 365245,
      "text": "海子风很难吹进来，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 365910,
      "end_ms": 368170,
      "text": "水面常年安稳平静。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 368330,
      "end_ms": 369285,
      "text": "等到秋天，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 369750,
      "end_ms": 371610,
      "text": "山上树叶变红变黄，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 371870,
      "end_ms": 374115,
      "text": "山林的色彩完整倒映水面，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 374850,
      "end_ms": 377110,
      "text": "水底的蓝绿叠加水面，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 377110,
      "end_ms": 380975,
      "text": "红黄秋色一汪湖水装下万千色彩。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 381600,
      "end_ms": 384015,
      "text": "为啥九寨沟水色这么好看，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 384480,
      "end_ms": 385965,
      "text": "属于盖华地貌，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 386810,
      "end_ms": 388445,
      "text": "水里溶解碳酸钙，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 389190,
      "end_ms": 390925,
      "text": "常年沉积湖底，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 391280,
      "end_ms": 393295,
      "text": "铺成一层乳白色底板，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 394000,
      "end_ms": 395545,
      "text": "光线穿过清水，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 395950,
      "end_ms": 401135,
      "text": "打在白色底板反射回来水色变得鲜亮梦幻。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 401660,
      "end_ms": 406700,
      "text": "咱们可以避开暑假国庆高峰挑担，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 406820,
      "end_ms": 409640,
      "text": "既来坐上观光车，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 409780,
      "end_ms": 411425,
      "text": "找一处人少的湖边，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 411900,
      "end_ms": 413835,
      "text": "静静看看水底光影，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 414280,
      "end_ms": 417205,
      "text": "这份景色值得一趟远行。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 417970,
      "end_ms": 421920,
      "text": "一条山谷百个海子湖湖，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 422000,
      "end_ms": 422965,
      "text": "色彩不一样，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 423810,
      "end_ms": 424945,
      "text": "独一份的美，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 425400,
      "end_ms": 426945,
      "text": "别处很难寻。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 428030,
      "end_ms": 428655,
      "text": "第二名，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 429450,
      "end_ms": 435280,
      "text": "杨卓雍错西藏山南杨卓雍错藏语，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 435280,
      "end_ms": 438735,
      "text": "意思是碧玉湖单单碧玉两个字，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 439030,
      "end_ms": 440785,
      "text": "还不足以形容他的美。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 442320,
      "end_ms": 443385,
      "text": "从拉萨出发，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 443900,
      "end_ms": 445385,
      "text": "翻过冈巴拉山口，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 445880,
      "end_ms": 447975,
      "text": "站在山顶往下望去，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 448440,
      "end_ms": 450880,
      "text": "大片湖水静静铺展。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 450920,
      "end_ms": 451875,
      "text": "山谷之间，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 452890,
      "end_ms": 453750,
      "text": "湖水浓郁，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 453770,
      "end_ms": 455235,
      "text": "带着淡淡的绿意，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 456130,
      "end_ms": 457235,
      "text": "微风拂过，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 457830,
      "end_ms": 459405,
      "text": "细碎波纹闪动，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 460110,
      "end_ms": 461335,
      "text": "蓝绿交替，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 462170,
      "end_ms": 465135,
      "text": "像柔软绸缎轻轻抖动。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 466020,
      "end_ms": 470285,
      "text": "最奇妙的湖水颜色会变，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 471320,
      "end_ms": 472285,
      "text": "不同时辰，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 474000,
      "end_ms": 476585,
      "text": "不同天气站在不同位置，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 477320,
      "end_ms": 479885,
      "text": "看到的湖水色彩完全不一样。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 480780,
      "end_ms": 485005,
      "text": "清晨偏深蓝正午转为翠绿，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 485540,
      "end_ms": 486100,
      "text": "阴天，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 486280,
      "end_ms": 487500,
      "text": "整片湖面，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 487520,
      "end_ms": 492465,
      "text": "灰蓝云层裂开缝隙阳光落下去，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 492900,
      "end_ms": 496235,
      "text": "被光照到那片湖水瞬间变成宝石蓝，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 497040,
      "end_ms": 501490,
      "text": "其余地方依旧暗沉扬捉雍措，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 501550,
      "end_ms": 502610,
      "text": "海拔四千多，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 502770,
      "end_ms": 503670,
      "text": "湖面广阔，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 503930,
      "end_ms": 505370,
      "text": "湖岸线弯弯曲曲，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 505370,
      "end_ms": 506375,
      "text": "缠绕群山，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 506890,
      "end_ms": 508305,
      "text": "换一个观景位置，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 508590,
      "end_ms": 510205,
      "text": "湖泊模样就变了。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 510500,
      "end_ms": 513060,
      "text": "他不像茶卡盐湖是镜面，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 513120,
      "end_ms": 517315,
      "text": "天地也不像九寨沟是静止的调色盘，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 518150,
      "end_ms": 519950,
      "text": "长期住在西藏的老乡，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 519950,
      "end_ms": 520190,
      "text": "说，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 520570,
      "end_ms": 522935,
      "text": "羊湖是一块活着的宝石，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 523490,
      "end_ms": 525775,
      "text": "色彩跟着光线天气流转，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 526530,
      "end_ms": 529085,
      "text": "你在山口静静站上一小时，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 529570,
      "end_ms": 532145,
      "text": "就能看见好几种不一样的蓝，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 533130,
      "end_ms": 534310,
      "text": "静静看着，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 534590,
      "end_ms": 536825,
      "text": "心里什么烦恼都放下了。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 537740,
      "end_ms": 540640,
      "text": "四千多米高原湖水灵动，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 541320,
      "end_ms": 543020,
      "text": "光影时时变化，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 543240,
      "end_ms": 544960,
      "text": "评论区打出四个字，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 545360,
      "end_ms": 546845,
      "text": "水边仙境。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 547690,
      "end_ms": 549125,
      "text": "咱们揭晓榜首，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 549810,
      "end_ms": 552915,
      "text": "就是开篇说的早年无路，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 553670,
      "end_ms": 555935,
      "text": "很多人从没听过的秘境。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 557040,
      "end_ms": 557775,
      "text": "第一名，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 559110,
      "end_ms": 561185,
      "text": "大柴蛋翡翠湖，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 561680,
      "end_ms": 567885,
      "text": "青海海西大柴蛋地名朴素藏在戈壁滩上。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 568690,
      "end_ms": 572374,
      "text": "翡翠湖原本是开采矿物的化工盐湖，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 573140,
      "end_ms": 574445,
      "text": "当年是矿区，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 575200,
      "end_ms": 576495,
      "text": "不是旅游景点。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 578050,
      "end_ms": 579350,
      "text": "矿产开采之后，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 579790,
      "end_ms": 584735,
      "text": "留下大大小小矿坑雨水积雪慢慢积在坑中，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 585220,
      "end_ms": 586555,
      "text": "造就这片奇景。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 587210,
      "end_ms": 587450,
      "text": "嗯，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 587720,
      "end_ms": 591070,
      "text": "翡翠湖不是单独一个湖戈壁滩，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 591110,
      "end_ms": 591695,
      "text": "散落，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 591960,
      "end_ms": 593195,
      "text": "大大小小水洼，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 593540,
      "end_ms": 596435,
      "text": "每个水洼矿物质成分浓度不一样，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 596960,
      "end_ms": 600445,
      "text": "一池一个颜色翠绿湛蓝，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 600840,
      "end_ms": 601280,
      "text": "墨绿，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 601540,
      "end_ms": 602040,
      "text": "乳白，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 602380,
      "end_ms": 603465,
      "text": "蓝绿交织。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 604290,
      "end_ms": 605070,
      "text": "十多年前，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 605070,
      "end_ms": 606490,
      "text": "这里只有矿区土路，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 606850,
      "end_ms": 608590,
      "text": "普通轿车很难通行，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 609450,
      "end_ms": 610630,
      "text": "游客稀少，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 611350,
      "end_ms": 612670,
      "text": "道路修好之后，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 613170,
      "end_ms": 615010,
      "text": "美景才慢慢传开。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 615990,
      "end_ms": 617890,
      "text": "翡翠湖最美的时刻，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 618130,
      "end_ms": 619190,
      "text": "无风傍晚，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 619630,
      "end_ms": 620690,
      "text": "夕阳下沉，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 621650,
      "end_ms": 623870,
      "text": "金色柔光铺满大地，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 624490,
      "end_ms": 626390,
      "text": "各色水洼闪闪发亮。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 627050,
      "end_ms": 631010,
      "text": "远处隔壁荒原雪山遥遥伫立。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 631910,
      "end_ms": 633450,
      "text": "很多到访的朋友说，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 633550,
      "end_ms": 634420,
      "text": "站在这这里，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 634540,
      "end_ms": 637760,
      "text": "恍惚之间不像身在人间，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 638520,
      "end_ms": 640880,
      "text": "但翡翠湖最触动我的，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 641280,
      "end_ms": 642900,
      "text": "不是惊艳的水色，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 643400,
      "end_ms": 644640,
      "text": "而是它的故事。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 645600,
      "end_ms": 648660,
      "text": "这片美景不是大自然。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 648680,
      "end_ms": 650319,
      "text": "亿万年精心雕琢，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 650860,
      "end_ms": 652480,
      "text": "是人采矿结束，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 652520,
      "end_ms": 653260,
      "text": "离开之后，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 653560,
      "end_ms": 655480,
      "text": "大自然慢慢孕育出来。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 655720,
      "end_ms": 658280,
      "text": "矿坑是人玩积水，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 658400,
      "end_ms": 659180,
      "text": "是雨雪，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 659220,
      "end_ms": 659720,
      "text": "汇集，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 660420,
      "end_ms": 662780,
      "text": "缤纷色彩是矿物，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 662780,
      "end_ms": 663915,
      "text": "只遇上阳光，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 664050,
      "end_ms": 667130,
      "text": "能造就当地老矿工。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 667150,
      "end_ms": 668935,
      "text": "回忆开采年代，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 669510,
      "end_ms": 671190,
      "text": "这里只是一片荒滩。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 671250,
      "end_ms": 673255,
      "text": "矿坑没人觉得好看，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 674100,
      "end_ms": 676595,
      "text": "等到矿亭人走岁月流转，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 677140,
      "end_ms": 677860,
      "text": "坑中水，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 678100,
      "end_ms": 681420,
      "text": "慢慢长成翡翠人撤去水，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 681480,
      "end_ms": 683425,
      "text": "会集美景自生。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 683800,
      "end_ms": 687755,
      "text": "废弃矿坑化作戈壁滩上的水边仙境。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 688720,
      "end_ms": 689400,
      "text": "十个地方，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 689620,
      "end_ms": 690735,
      "text": "咱们全部讲完。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 691090,
      "end_ms": 693110,
      "text": "霞浦贪涂岸边，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 693190,
      "end_ms": 697105,
      "text": "看日出就是天然画卷茶卡盐湖。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 697510,
      "end_ms": 698455,
      "text": "走到深处，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 698770,
      "end_ms": 700525,
      "text": "天地融为一体，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 701220,
      "end_ms": 702905,
      "text": "千岛湖碧波之下，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 703380,
      "end_ms": 706235,
      "text": "沉睡着两座古城泸沽湖。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 706620,
      "end_ms": 709925,
      "text": "水质纯净水里能开出鲜花，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 710530,
      "end_ms": 714455,
      "text": "恩施、平山、峡谷、清水拖着小船，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 714950,
      "end_ms": 718150,
      "text": "仿佛悬浮空中长白山天池云雾，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 718190,
      "end_ms": 722465,
      "text": "守护一池蓝宝石、荔波、小溪、孔古桥之后，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 723100,
      "end_ms": 724200,
      "text": "层层瀑布，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 724260,
      "end_ms": 725205,
      "text": "绵延不绝。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 726040,
      "end_ms": 727735,
      "text": "九寨沟摆个海子，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 728100,
      "end_ms": 729575,
      "text": "色彩各有千秋，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 730200,
      "end_ms": 731440,
      "text": "阳卓拥错，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 731600,
      "end_ms": 732805,
      "text": "湖水灵动，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 733210,
      "end_ms": 735175,
      "text": "随时变换色彩。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 736080,
      "end_ms": 738375,
      "text": "翡翠湖矿场废弃之后，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 738770,
      "end_ms": 740815,
      "text": "大自然绘就的翡翠秘境，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 741700,
      "end_ms": 745335,
      "text": "这十处美景全都以水而生，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 746250,
      "end_ms": 749985,
      "text": "有的人一辈子都不知道他们的存在，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 750450,
      "end_ms": 752005,
      "text": "有的人千里奔赴，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 752350,
      "end_ms": 753130,
      "text": "遇上大雾，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 753150,
      "end_ms": 754015,
      "text": "空手而归。"
    },
    {
      "segment_id": "s000300",
      "start_ms": 754320,
      "end_ms": 755805,
      "text": "也有人猜准时节，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 756100,
      "end_ms": 757520,
      "text": "站在最合适的地点，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 757520,
      "end_ms": 758515,
      "text": "望着水面，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 758970,
      "end_ms": 762175,
      "text": "安安静静一句话都说不出来。"
    },
    {
      "segment_id": "s000304",
      "start_ms": 763260,
      "end_ms": 766235,
      "text": "这条视频转发给你的老伙计，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 767030,
      "end_ms": 770290,
      "text": "就是总念叨退休之后不知道去哪游玩的。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 770290,
      "end_ms": 772135,
      "text": "老朋友跟他说，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 772590,
      "end_ms": 774635,
      "text": "别总愁没有好去处。"
    },
    {
      "segment_id": "s000308",
      "start_ms": 775210,
      "end_ms": 778050,
      "text": "十个地方挑一处带上老伴出发，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 778470,
      "end_ms": 781455,
      "text": "单单坐在水边静静发呆一阵子，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 781800,
      "end_ms": 785295,
      "text": "这趟旅途就直了。"
    }
  ],
  "source_transcript_sha256": "4bed94078f07e942ee7a73f24db807e8e994b12698d259937ceb0bbf295a6048"
}