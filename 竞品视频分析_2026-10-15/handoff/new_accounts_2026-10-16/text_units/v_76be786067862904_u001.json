{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_76be786067862904_u001",
  "video_id": "v_76be786067862904",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 455.691995,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 250,
      "end_ms": 1130,
      "text": "你敢相信吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1650,
      "end_ms": 4050,
      "text": "中国道学文化史上有一本入门书，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4270,
      "end_ms": 5850,
      "text": "他背后站着的不是道士，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6010,
      "end_ms": 7050,
      "text": "不是风水先生，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 7270,
      "end_ms": 8650,
      "text": "而是一位造导弹的人。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 8970,
      "end_ms": 14050,
      "text": "中国航天之父两弹一星元勋钱学森钱老没有亲手写这本书，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 14310,
      "end_ms": 14950,
      "text": "但可以说，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 15310,
      "end_ms": 18770,
      "text": "这本书的第一页是钱学森用一封信写下的，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 18830,
      "end_ms": 20290,
      "text": "没有那封信就没有。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 20290,
      "end_ms": 21950,
      "text": "后来三十年的江湖调研，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 22330,
      "end_ms": 23610,
      "text": "没有那三十年调研，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 23770,
      "end_ms": 25890,
      "text": "就没有胡福琛的道学入门。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 26030,
      "end_ms": 28410,
      "text": "你遇到的每一个认真讲道学的人，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 28470,
      "end_ms": 29330,
      "text": "不管他承不承认，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 29330,
      "end_ms": 30500,
      "text": "都让放不开。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 30520,
      "end_ms": 33460,
      "text": "钱老当年那个嘱托为人体科学，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 33820,
      "end_ms": 37540,
      "text": "去把佛道二教的修持法诀调研清楚。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 37960,
      "end_ms": 38860,
      "text": "一九八零年，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 39100,
      "end_ms": 42260,
      "text": "钱学森院士把一项特殊任务交给了一位年轻人，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 42500,
      "end_ms": 44180,
      "text": "这个年轻人叫胡福琛，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 44480,
      "end_ms": 46380,
      "text": "一九四五年生于河北吴桥，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 46840,
      "end_ms": 49380,
      "text": "一九六九年毕业于南开大学化学系，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 49480,
      "end_ms": 51180,
      "text": "当过中医干过行政，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 51400,
      "end_ms": 58540,
      "text": "后来成为中国社科院哲学所研究员、博士生导师、全国老子道学文化研究会创会会长。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 59000,
      "end_ms": 61465,
      "text": "钱老看中他不是因为他会算命，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 61800,
      "end_ms": 63080,
      "text": "而是因为他懂化学，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 63220,
      "end_ms": 65165,
      "text": "懂中医、懂自然科学，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 65530,
      "end_ms": 69255,
      "text": "能用现代科学语言去碰道穴里最硬的那块骨头。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 70010,
      "end_ms": 71045,
      "text": "钱老在信里说，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 71530,
      "end_ms": 73210,
      "text": "您学过自然科学的化学，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 73510,
      "end_ms": 74390,
      "text": "又当过中医，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 74610,
      "end_ms": 75985,
      "text": "还干过行政工作。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 76480,
      "end_ms": 79875,
      "text": "这样的经历对研究周易参铜器是有帮助的。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 80340,
      "end_ms": 80760,
      "text": "后来，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 80840,
      "end_ms": 82220,
      "text": "胡福琛遇到压力钱，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 82220,
      "end_ms": 83395,
      "text": "老又写信鼓励他，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 83820,
      "end_ms": 84500,
      "text": "我敢干。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 84680,
      "end_ms": 86500,
      "text": "这是因为我是已退休的人，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 86620,
      "end_ms": 87615,
      "text": "无牵无挂，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 88230,
      "end_ms": 89845,
      "text": "您与我处境不同。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 90450,
      "end_ms": 91555,
      "text": "但话又说回来，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 91840,
      "end_ms": 93145,
      "text": "您现在是五十岁，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 93620,
      "end_ms": 95915,
      "text": "我五十岁时是一九六一年。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 96380,
      "end_ms": 98585,
      "text": "那时我就敢接受导弹任务，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 98860,
      "end_ms": 99680,
      "text": "也是不怕死，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 99680,
      "end_ms": 103140,
      "text": "磕一位造导弹的人用造导弹的勇气，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 103360,
      "end_ms": 106465,
      "text": "鼓励一位读书人去干一件同样需要勇气的事，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 106810,
      "end_ms": 109765,
      "text": "把道穴从玄虚和迷信里拽出来，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 110050,
      "end_ms": 112215,
      "text": "放回学术和科学的框架里。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 112520,
      "end_ms": 112900,
      "text": "于是，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 113430,
      "end_ms": 115670,
      "text": "胡福琛跋涉江湖遍迹，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 115690,
      "end_ms": 116910,
      "text": "山林倾覆，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 116990,
      "end_ms": 118715,
      "text": "康葬出入禅秘。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 119090,
      "end_ms": 120310,
      "text": "历时三十余年，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 120570,
      "end_ms": 122210,
      "text": "字号资金十三万元，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 122550,
      "end_ms": 125075,
      "text": "终于完成了钱老嘱托的调研任务。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 125500,
      "end_ms": 126420,
      "text": "而道学入门，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 126620,
      "end_ms": 131360,
      "text": "就是这条路上最清晰、最通俗、最适合普通人走进去的一扇门。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 131440,
      "end_ms": 133980,
      "text": "如果说钱学森是这项事业的总设计师，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 134300,
      "end_ms": 136045,
      "text": "胡福琛就是总工程师。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 136360,
      "end_ms": 138855,
      "text": "而倒学入门就是那张施工图。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 139250,
      "end_ms": 141595,
      "text": "钱老晚年为什么反复关注内丹？"
    },
    {
      "segment_id": "s000063",
      "start_ms": 142200,
      "end_ms": 145100,
      "text": "因为他想在道学里找到人体科学的入口。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 145240,
      "end_ms": 146665,
      "text": "胡福琛没有辜负他，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 147400,
      "end_ms": 149505,
      "text": "这本书不是从固纸堆里抄出来的，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 149690,
      "end_ms": 151610,
      "text": "是拿三十年命换回来的。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 151610,
      "end_ms": 155890,
      "text": "吴富琛做的第一件事是为道学证明道学不是烧香，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 155890,
      "end_ms": 158435,
      "text": "画符不是江湖术士的谋生手段，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 158710,
      "end_ms": 159565,
      "text": "更不是迷信。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 159840,
      "end_ms": 161985,
      "text": "道学文化是中华文化的根底，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 162350,
      "end_ms": 163410,
      "text": "融汇诸子百家，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 163410,
      "end_ms": 168515,
      "text": "学术涵盖哲学思想、治国、用兵、养生、修炼民俗术术。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 169160,
      "end_ms": 170905,
      "text": "钱学森要的是人体科学，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 171280,
      "end_ms": 174135,
      "text": "胡福琛给的是一整套道学体系。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 174950,
      "end_ms": 177485,
      "text": "这本书从道学的文化渊源讲起，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 177830,
      "end_ms": 181535,
      "text": "梳理道家学术在春秋战国哲学的突破中的诞生，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 181880,
      "end_ms": 184000,
      "text": "解析道家学术的形成与演变。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 184280,
      "end_ms": 186260,
      "text": "讲道论中和之德，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 186600,
      "end_ms": 187945,
      "text": "破除常见误解，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 188200,
      "end_ms": 193895,
      "text": "皆是肠道药义、汤、衣界、黄兴川叶秀山、三位先生分别作序。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 194320,
      "end_ms": 197660,
      "text": "这分量不是市面上那些三天学会看风水的书，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 197660,
      "end_ms": 198920,
      "text": "能比的不负称做的。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 198920,
      "end_ms": 202955,
      "text": "第二件事是把道学的实操体系完整立了起来。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 203490,
      "end_ms": 205450,
      "text": "这本书不只讲道的哲学，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 205770,
      "end_ms": 207275,
      "text": "更讲度的方法，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 207690,
      "end_ms": 208810,
      "text": "单道入门怎么走？"
    },
    {
      "segment_id": "s000087",
      "start_ms": 209070,
      "end_ms": 210930,
      "text": "读书和求师有什么讲究？"
    },
    {
      "segment_id": "s000088",
      "start_ms": 211070,
      "end_ms": 212255,
      "text": "内丹的功效是什么？"
    },
    {
      "segment_id": "s000089",
      "start_ms": 212620,
      "end_ms": 214865,
      "text": "修持单弓有什么年龄和条件？"
    },
    {
      "segment_id": "s000090",
      "start_ms": 215240,
      "end_ms": 217115,
      "text": "入室行宫的要领是什么？"
    },
    {
      "segment_id": "s000091",
      "start_ms": 217680,
      "end_ms": 219940,
      "text": "这些旧时代靠师徒口耳相传，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 220220,
      "end_ms": 222265,
      "text": "外人根本摸不到门路的东西。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 222590,
      "end_ms": 224695,
      "text": "胡福琛一条一条写了出来，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 225250,
      "end_ms": 227505,
      "text": "从单道原理到补亏阵法，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 227800,
      "end_ms": 230025,
      "text": "从辟谷胎西到行宫宇药，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 230420,
      "end_ms": 232580,
      "text": "从单道助基到方便法门，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 232880,
      "end_ms": 235260,
      "text": "从清净丹绝到女丹传真，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 235440,
      "end_ms": 237905,
      "text": "再到开悟、禅定和双修漫谈。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 238350,
      "end_ms": 239330,
      "text": "十四讲下来，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 239330,
      "end_ms": 242505,
      "text": "一座完整的道学羞耻体系就立起来了。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 243490,
      "end_ms": 244485,
      "text": "你不需要拜师，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 244860,
      "end_ms": 246305,
      "text": "不需要加入任何组织，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 246600,
      "end_ms": 248895,
      "text": "不需要在论坛上被各路大师带偏。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 249220,
      "end_ms": 250560,
      "text": "你只需要打开第一页，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 250740,
      "end_ms": 252760,
      "text": "就能沿着胡福琛铺下的那条路，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 252980,
      "end_ms": 254475,
      "text": "一步一步走进去。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 254840,
      "end_ms": 256360,
      "text": "胡福琛做的第三件事，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 256500,
      "end_ms": 257340,
      "text": "也是最关键的，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 257340,
      "end_ms": 257695,
      "text": "一件，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 258060,
      "end_ms": 261075,
      "text": "是用现代科学的视角重新审视道学，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 261390,
      "end_ms": 263055,
      "text": "这不是一本故弄玄虚的书。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 263790,
      "end_ms": 265470,
      "text": "胡富琛是化学专业出身，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 265670,
      "end_ms": 267975,
      "text": "他懂得什么是可验证可推演。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 268250,
      "end_ms": 271495,
      "text": "他在书中专设道学文化的新科学观，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 271960,
      "end_ms": 274215,
      "text": "讨论二十一世纪科学革命的思考，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 274590,
      "end_ms": 277925,
      "text": "探讨两重天地理论在单道学中的应用。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 278370,
      "end_ms": 281945,
      "text": "这种跨学科视野正是钱学森当年看中他的原因，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 282350,
      "end_ms": 286195,
      "text": "也是这本书区别于市面上所有道学读物的根本所在。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 286660,
      "end_ms": 288060,
      "text": "这部书分五大板块，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 288160,
      "end_ms": 288900,
      "text": "结构清晰，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 289020,
      "end_ms": 289860,
      "text": "层层递进。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 289940,
      "end_ms": 290500,
      "text": "道学篇，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 290580,
      "end_ms": 294680,
      "text": "讲文化渊源、道家、学术演变核心思想道教篇，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 294700,
      "end_ms": 296000,
      "text": "讲道教发展史，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 296220,
      "end_ms": 297020,
      "text": "宗派流变，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 297240,
      "end_ms": 298680,
      "text": "戒律禁忌方术篇，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 298760,
      "end_ms": 300300,
      "text": "讲术数、存思，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 300520,
      "end_ms": 301020,
      "text": "导引，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 301300,
      "end_ms": 304155,
      "text": "辟谷、福气外丹、黄白术。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 304430,
      "end_ms": 307930,
      "text": "单道篇讲内丹学源流、各派单法要诀，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 308130,
      "end_ms": 309130,
      "text": "修持次第，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 309170,
      "end_ms": 310630,
      "text": "从宇宙观到方法论，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 310790,
      "end_ms": 312670,
      "text": "从理论框架到实修口诀，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 312990,
      "end_ms": 315530,
      "text": "一座完整的道学大厦就立起来了。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 315630,
      "end_ms": 316010,
      "text": "当然，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 316330,
      "end_ms": 317750,
      "text": "胡福琛也有他的自觉，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 318150,
      "end_ms": 319250,
      "text": "但做的是普及，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 319450,
      "end_ms": 320090,
      "text": "是入门，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 320390,
      "end_ms": 323910,
      "text": "是把道学从晦涩古文和江湖口诀里拉出来，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 324050,
      "end_ms": 325650,
      "text": "用现代汉语讲清楚。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 325670,
      "end_ms": 326790,
      "text": "他不是单经大全，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 327170,
      "end_ms": 330610,
      "text": "但他是你走进单经之前最该先读的那本书，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 330650,
      "end_ms": 331990,
      "text": "后来的单道法诀。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 331990,
      "end_ms": 332590,
      "text": "十二讲，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 332830,
      "end_ms": 335020,
      "text": "把内丹修持经典雕细琢，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 335320,
      "end_ms": 337700,
      "text": "把各家单法推向实操高度，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 338180,
      "end_ms": 339920,
      "text": "把三十年调研做到极致。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 340100,
      "end_ms": 343040,
      "text": "他们都是站在道学入门的肩膀上往前走的，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 343120,
      "end_ms": 344040,
      "text": "没有这个清晰，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 344040,
      "end_ms": 345120,
      "text": "但扎实的起点，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 345280,
      "end_ms": 346680,
      "text": "后面的路无从谈起。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 347200,
      "end_ms": 349440,
      "text": "但胡福琛的故事到这里并没有结束。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 350020,
      "end_ms": 351820,
      "text": "因为在道学文化推广的路上，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 352000,
      "end_ms": 354280,
      "text": "普通读者面对的困境依然存在，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 354400,
      "end_ms": 356620,
      "text": "市面上充斥着各种道学入门书，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 356820,
      "end_ms": 357800,
      "text": "有的堆砌古文，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 357840,
      "end_ms": 358760,
      "text": "让人望而生畏。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 359040,
      "end_ms": 360260,
      "text": "有的过度神秘化，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 360320,
      "end_ms": 361520,
      "text": "把读者引入歧途，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 361840,
      "end_ms": 364770,
      "text": "有的干脆打着道学旗号推销养生保健品，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 364910,
      "end_ms": 367195,
      "text": "真正的方法论藏在固纸堆里。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 367500,
      "end_ms": 370760,
      "text": "最核心的道学思想体系术术演变脉络，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 370960,
      "end_ms": 372355,
      "text": "单道修持次第，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 372630,
      "end_ms": 373690,
      "text": "反而被各种花哨。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 373690,
      "end_ms": 375665,
      "text": "包装和营销话术掩盖了，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 376140,
      "end_ms": 379160,
      "text": "于是有一条路被重新铺了出来，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 379280,
      "end_ms": 380640,
      "text": "以道学入门为根基，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 380940,
      "end_ms": 383560,
      "text": "一条从道学证明到术数应用，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 383780,
      "end_ms": 388425,
      "text": "从单道实修到科学创新的完整路径被清晰呈现。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 389140,
      "end_ms": 390525,
      "text": "这本书值得放在枕边，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 390890,
      "end_ms": 392315,
      "text": "不是因为他能让你得到，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 392610,
      "end_ms": 396710,
      "text": "而是因为它能让你在面对浩如烟海的道学文化时，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 397070,
      "end_ms": 399330,
      "text": "心里有一张清清楚楚的地图。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 399530,
      "end_ms": 402455,
      "text": "如果你想顺着钱学森当年的嘱托往下走，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 402780,
      "end_ms": 406400,
      "text": "如果你想看懂胡福琛三十年调研到底带回了什么。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 406480,
      "end_ms": 409620,
      "text": "如果你不想再被那些秘传真诀割韭菜，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 409920,
      "end_ms": 412175,
      "text": "这本道学入门值得你翻看。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 412510,
      "end_ms": 414070,
      "text": "如果你只买一本先读它，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 414270,
      "end_ms": 415610,
      "text": "如果你想完整走一遍，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 415610,
      "end_ms": 418135,
      "text": "从钱老一封信到单到实修的路，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 418390,
      "end_ms": 425075,
      "text": "建议直接入手道学入门加单道法学精妙组合套装三卷本八十万字，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 425520,
      "end_ms": 426975,
      "text": "扉页上郑重写着，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 427460,
      "end_ms": 435390,
      "text": "仅以此书献给中国两弹一星元勋、钱学森院士三本入门套装深严两套书放在一起，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 435630,
      "end_ms": 438530,
      "text": "就是一条从入门到进阶的完整路径，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 438730,
      "end_ms": 439830,
      "text": "点击下方商品卡，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 440070,
      "end_ms": 441355,
      "text": "把这张地图带回家。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 441710,
      "end_ms": 442415,
      "text": "四十年前，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 442770,
      "end_ms": 445295,
      "text": "钱学森在信里鼓励胡福称不怕死。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 445940,
      "end_ms": 446665,
      "text": "四十年后，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 446950,
      "end_ms": 449970,
      "text": "胡富琛把钱老的嘱托变成了百万字的著作，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 450130,
      "end_ms": 452470,
      "text": "你只需要翻开第一页就能走上去。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 452570,
      "end_ms": 453310,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 453450,
      "end_ms": 455535,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "4de75c1973a1bf011b14527f041d5f938535c8697691f73dfe832898b3bfa0ea"
}