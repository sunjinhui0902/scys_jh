{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_2f0e25053eef097c_u001",
  "video_id": "v_2f0e25053eef097c",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 446.310998,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 500,
      "end_ms": 1380,
      "text": "你敢相信吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1960,
      "end_ms": 6820,
      "text": "全世界最会赚钱的潮汕人最厉害的本事不是长大后才学的，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7040,
      "end_ms": 9560,
      "text": "而是从小孩子时候就种进脑子里的。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9580,
      "end_ms": 12560,
      "text": "很多人以为潮汕人天生会做生意错了，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 12960,
      "end_ms": 14900,
      "text": "他们只是从小听从小看，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 15080,
      "end_ms": 17880,
      "text": "从小练别人家孩子背唐诗潮汕，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 17880,
      "end_ms": 20160,
      "text": "孩子在茶盘边听大人谈生意。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 20600,
      "end_ms": 21840,
      "text": "别人家孩子刷奥数，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 22120,
      "end_ms": 22500,
      "text": "潮汕，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 22500,
      "end_ms": 23860,
      "text": "孩子在铺头里学算账。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23960,
      "end_ms": 25780,
      "text": "别人家孩子伸手要零花钱，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 26200,
      "end_ms": 27640,
      "text": "潮汕孩子已经在想，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 27780,
      "end_ms": 29100,
      "text": "这包辣条怎么转手？"
    },
    {
      "segment_id": "s000014",
      "start_ms": 29100,
      "end_ms": 31910,
      "text": "卖出去这套东西过去不外传，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 32390,
      "end_ms": 34430,
      "text": "现在有人把它写成了一本书，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 34730,
      "end_ms": 36230,
      "text": "叫潮汕思维。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 36330,
      "end_ms": 38570,
      "text": "但我今天要把话说透这本书，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 38950,
      "end_ms": 40290,
      "text": "最该读的不是老板，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 40470,
      "end_ms": 41430,
      "text": "不是创业者，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 41650,
      "end_ms": 42630,
      "text": "不是成年人，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 42930,
      "end_ms": 44010,
      "text": "而是小孩子。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 44330,
      "end_ms": 45330,
      "text": "对你没听错，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 45370,
      "end_ms": 46290,
      "text": "就是小孩子。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 46530,
      "end_ms": 48850,
      "text": "如果你家里有三岁到十五岁的孩子，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 48990,
      "end_ms": 50650,
      "text": "尤其六到十二岁的小学生，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 51010,
      "end_ms": 53150,
      "text": "你一定要让他从小接触这套思维。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 53630,
      "end_ms": 55010,
      "text": "因为学校教知识，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 55290,
      "end_ms": 56090,
      "text": "不教赚钱，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 56650,
      "end_ms": 58850,
      "text": "老师教考试不教生存。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 59570,
      "end_ms": 62280,
      "text": "你社会这所大学迟早会考他，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 62380,
      "end_ms": 63320,
      "text": "等到他大学毕业，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 63320,
      "end_ms": 65065,
      "text": "才学财商已经晚了，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 65650,
      "end_ms": 66790,
      "text": "等到他被社会毒打，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 66870,
      "end_ms": 67850,
      "text": "才懂人情世故，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 68010,
      "end_ms": 68905,
      "text": "代价太大，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 69190,
      "end_ms": 70435,
      "text": "潮汕人为什么厉害？"
    },
    {
      "segment_id": "s000037",
      "start_ms": 70910,
      "end_ms": 72815,
      "text": "因为他们把财商教育提前了，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 73320,
      "end_ms": 74375,
      "text": "提前到饭桌上，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 74670,
      "end_ms": 75630,
      "text": "提前到茶盘边，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 75910,
      "end_ms": 77685,
      "text": "提前到小孩子的眼睛里。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 78010,
      "end_ms": 80495,
      "text": "一个潮汕小孩儿可能还没认全字儿，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 80670,
      "end_ms": 82075,
      "text": "就知道钱不能乱花，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 82450,
      "end_ms": 83750,
      "text": "要知道钱从哪里来，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 84150,
      "end_ms": 85655,
      "text": "要算钱到哪里去。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 86040,
      "end_ms": 88340,
      "text": "一个潮汕小孩可能还在读小学，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 88580,
      "end_ms": 90605,
      "text": "就被大人带着去市场看行情，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 90940,
      "end_ms": 91980,
      "text": "去店铺看人流，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 92300,
      "end_ms": 93675,
      "text": "去和陌生人打招呼。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 94190,
      "end_ms": 100795,
      "text": "一个潮汕小孩可能十几岁就敢在暑假摆摊进货、算账、找零招呼客人。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 101690,
      "end_ms": 103465,
      "text": "这不是穷人的孩子早当家，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 103860,
      "end_ms": 107070,
      "text": "这是潮汕人的孩子早开窍潮汕思维。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 107070,
      "end_ms": 111500,
      "text": "这本书第一次把这套从小开窍的方法用小孩子也能听懂的。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 111500,
      "end_ms": 112865,
      "text": "大白话写了出来，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 113070,
      "end_ms": 114295,
      "text": "他没有玄乎的理论，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 114620,
      "end_ms": 115705,
      "text": "没有吓人的术语，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 116040,
      "end_ms": 117605,
      "text": "没有只给大人看的成功学。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 117960,
      "end_ms": 122215,
      "text": "他讲的是怎么让孩子明白钱不是天上掉下来的，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 122610,
      "end_ms": 125985,
      "text": "怎么让孩子知道便宜货和好生意区别在哪儿？"
    },
    {
      "segment_id": "s000059",
      "start_ms": 126420,
      "end_ms": 128675,
      "text": "怎么让孩子学会先做人再做事？"
    },
    {
      "segment_id": "s000060",
      "start_ms": 129040,
      "end_ms": 130895,
      "text": "怎么让孩子遇到困难不哭鼻子，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 131110,
      "end_ms": 132045,
      "text": "而是想办法。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 132480,
      "end_ms": 134580,
      "text": "怎么让孩子从小有老板思维，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 134660,
      "end_ms": 136415,
      "text": "而不是一辈子打工思维？"
    },
    {
      "segment_id": "s000064",
      "start_ms": 137090,
      "end_ms": 138005,
      "text": "书里有一句话，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 138380,
      "end_ms": 140450,
      "text": "特别适合给孩子看工字，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 140550,
      "end_ms": 141335,
      "text": "不出头，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 141830,
      "end_ms": 142630,
      "text": "打工不是错，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 142890,
      "end_ms": 146090,
      "text": "但只会打工一辈子被人拿捏潮汕人，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 146090,
      "end_ms": 148145,
      "text": "宁可睡地板也要当老板，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 148820,
      "end_ms": 150085,
      "text": "不是因为他们爱吃苦，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 150610,
      "end_ms": 154120,
      "text": "而是他们从小就知道命运要握在自己手里。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 154200,
      "end_ms": 155025,
      "text": "还有一句话，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 155360,
      "end_ms": 156975,
      "text": "父母一定要替孩子记住，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 157440,
      "end_ms": 158180,
      "text": "算盘要打，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 158180,
      "end_ms": 160200,
      "text": "穿人情要留香，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 160400,
      "end_ms": 161380,
      "text": "孩子成绩再好，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 161620,
      "end_ms": 162500,
      "text": "如果不会做人，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 162760,
      "end_ms": 163605,
      "text": "不会合作，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 163900,
      "end_ms": 164760,
      "text": "不会交朋友，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 165000,
      "end_ms": 166515,
      "text": "长大照样吃大亏。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 166810,
      "end_ms": 167710,
      "text": "潮汕人谈生意，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 167710,
      "end_ms": 170320,
      "text": "为什么爱喝茶那杯茶不是茶，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 170560,
      "end_ms": 171260,
      "text": "是人情，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 171440,
      "end_ms": 172135,
      "text": "是分寸，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 172480,
      "end_ms": 173700,
      "text": "是给别人留余地，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 173860,
      "end_ms": 175180,
      "text": "也是给自己留后路。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 175560,
      "end_ms": 177225,
      "text": "小孩子从小懂这些，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 177560,
      "end_ms": 179185,
      "text": "长大少走十年弯路，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 179840,
      "end_ms": 182260,
      "text": "你知道潮汕人为什么能富过三代吗？"
    },
    {
      "segment_id": "s000090",
      "start_ms": 182620,
      "end_ms": 184540,
      "text": "因为他们不教孩子一夜暴富，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 184920,
      "end_ms": 187300,
      "text": "只教孩子铜钱出苦坑，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 187660,
      "end_ms": 188780,
      "text": "富贵在凶冕，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 188860,
      "end_ms": 190640,
      "text": "让孩子知道钱难赚，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 190880,
      "end_ms": 193340,
      "text": "才懂得珍惜生意有起落，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 193700,
      "end_ms": 194660,
      "text": "才学会扛试。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 194820,
      "end_ms": 196440,
      "text": "从小听过这些话的孩子，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 196760,
      "end_ms": 198060,
      "text": "骨子里就多一根筋，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 198460,
      "end_ms": 199080,
      "text": "不怕慢，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 199480,
      "end_ms": 200100,
      "text": "就怕战，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 200480,
      "end_ms": 201060,
      "text": "不怕穷，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 201360,
      "end_ms": 203040,
      "text": "就怕懒不怕输，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 203260,
      "end_ms": 204100,
      "text": "就怕不敢试。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 204580,
      "end_ms": 209020,
      "text": "这本书最厉害的地方是他把潮汕人五百年验证过的实战方法，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 209200,
      "end_ms": 210150,
      "text": "一天条一条，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 210150,
      "end_ms": 212630,
      "text": "拆开变成小孩子也能用的东西。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 213050,
      "end_ms": 215390,
      "text": "比如怎么让孩子学会记账，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 215650,
      "end_ms": 217010,
      "text": "不是逼他写流水账，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 217310,
      "end_ms": 219330,
      "text": "而是让他管一周家庭买菜，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 219330,
      "end_ms": 221190,
      "text": "钱超支了自己想办法。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 221510,
      "end_ms": 221970,
      "text": "比如，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 222470,
      "end_ms": 223950,
      "text": "怎么让孩子学会谈判，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 224610,
      "end_ms": 225670,
      "text": "而是教他吵架，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 226030,
      "end_ms": 227590,
      "text": "而是让他去市场问价，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 227770,
      "end_ms": 229090,
      "text": "比价砍价。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 229710,
      "end_ms": 230170,
      "text": "比如，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 230590,
      "end_ms": 232430,
      "text": "怎么让孩子学会发现商机，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 233270,
      "end_ms": 234710,
      "text": "不是让他天天刷手机，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 235190,
      "end_ms": 238750,
      "text": "而是带他观察学校门口为什么这家店排队，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 238750,
      "end_ms": 240265,
      "text": "那家有点没人。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 240540,
      "end_ms": 240955,
      "text": "比如，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 241360,
      "end_ms": 242985,
      "text": "怎么让孩子学会承担风险，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 243630,
      "end_ms": 245225,
      "text": "不是给他一大笔钱乱花，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 245540,
      "end_ms": 246895,
      "text": "而是给他五十块本钱，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 247230,
      "end_ms": 249795,
      "text": "让他自己决定进什么货卖什么价，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 250020,
      "end_ms": 250725,
      "text": "亏了怎么办？"
    },
    {
      "segment_id": "s000126",
      "start_ms": 251180,
      "end_ms": 253025,
      "text": "这些方法书里都有，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 253420,
      "end_ms": 254120,
      "text": "不是空话，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 254320,
      "end_ms": 255380,
      "text": "是能直接用的。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 255440,
      "end_ms": 257440,
      "text": "如果你家孩子现在只会伸手要钱，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 257820,
      "end_ms": 258860,
      "text": "不知道钱怎么来，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 259240,
      "end_ms": 260535,
      "text": "你一定要给他读。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 261020,
      "end_ms": 262460,
      "text": "如果你家孩子成绩很好，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 262700,
      "end_ms": 264215,
      "text": "但一遇到陌生人就躲，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 264760,
      "end_ms": 265885,
      "text": "你一定要给他读。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 266410,
      "end_ms": 268135,
      "text": "如果你家孩子被保护的太好，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 268480,
      "end_ms": 270380,
      "text": "一点委屈都受不了你，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 270380,
      "end_ms": 271125,
      "text": "一定要给他。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 272100,
      "end_ms": 273885,
      "text": "如果你家孩子整天抱着手机，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 274240,
      "end_ms": 275925,
      "text": "不知道现实世界怎么运转，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 276300,
      "end_ms": 277375,
      "text": "你一定要给他读。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 278190,
      "end_ms": 279850,
      "text": "如果你不想让孩子长大以后，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 280050,
      "end_ms": 281630,
      "text": "只会刷题考试，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 281830,
      "end_ms": 283945,
      "text": "投简历被老板挑来挑去，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 284350,
      "end_ms": 285465,
      "text": "你更要给他读。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 286190,
      "end_ms": 287725,
      "text": "为什么一定要是小孩子？"
    },
    {
      "segment_id": "s000146",
      "start_ms": 288520,
      "end_ms": 290415,
      "text": "因为成年人的思维已经定型，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 290790,
      "end_ms": 291845,
      "text": "改起来像拔牙。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 292340,
      "end_ms": 294365,
      "text": "小孩子的脑子像一张白纸，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 294790,
      "end_ms": 296065,
      "text": "画什么就是什么。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 296430,
      "end_ms": 298110,
      "text": "你从小给他种下打工思维，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 298310,
      "end_ms": 299735,
      "text": "他长大就只会等工资。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 300410,
      "end_ms": 302230,
      "text": "你从小给他种下老板思维，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 302450,
      "end_ms": 304150,
      "text": "他长大就敢看机会，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 304330,
      "end_ms": 305230,
      "text": "敢算成本，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 305370,
      "end_ms": 306310,
      "text": "敢找人合作，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 306510,
      "end_ms": 307510,
      "text": "敢为自己负责。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 307910,
      "end_ms": 310250,
      "text": "潮汕思维不是让孩子变成小财迷，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 310570,
      "end_ms": 311990,
      "text": "他是让孩子从小明白，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 312290,
      "end_ms": 313190,
      "text": "钱是工具，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 313470,
      "end_ms": 314270,
      "text": "不是目的，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 314670,
      "end_ms": 315690,
      "text": "生意是游戏，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 315970,
      "end_ms": 316770,
      "text": "也是修行。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 317290,
      "end_ms": 318390,
      "text": "做人要厚道，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 318570,
      "end_ms": 319650,
      "text": "做事要精明，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 319770,
      "end_ms": 321750,
      "text": "他给孩子的不只是赚钱的方法，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 322070,
      "end_ms": 323290,
      "text": "更是一套看世界，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 323450,
      "end_ms": 324130,
      "text": "看人性，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 324390,
      "end_ms": 325930,
      "text": "看自己的底层思维。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 326250,
      "end_ms": 327790,
      "text": "但我要说一句更狠的话，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 328610,
      "end_ms": 331820,
      "text": "光给孩子读一本潮汕思维还不够，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 332660,
      "end_ms": 334040,
      "text": "因为小孩子学思维，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 334340,
      "end_ms": 335540,
      "text": "父母要学破局，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 336200,
      "end_ms": 337280,
      "text": "孩子负责开窍，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 337760,
      "end_ms": 338940,
      "text": "父母负责铺路，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 339540,
      "end_ms": 340560,
      "text": "孩子学怎么想？"
    },
    {
      "segment_id": "s000176",
      "start_ms": 341260,
      "end_ms": 342360,
      "text": "父母学怎么做？"
    },
    {
      "segment_id": "s000177",
      "start_ms": 342400,
      "end_ms": 347260,
      "text": "所以我强烈建议你把潮汕思维和时局控局破局一起带回家，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 347500,
      "end_ms": 349960,
      "text": "组成一套亲子财商共读套装。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 351060,
      "end_ms": 352760,
      "text": "潮汕思维给孩子打底，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 353260,
      "end_ms": 356960,
      "text": "从小建立正确的金钱观生意观、人情观。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 358200,
      "end_ms": 361165,
      "text": "时局控局破局给父母升级，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 361810,
      "end_ms": 365495,
      "text": "教你在复杂环境里看局控局破局，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 365830,
      "end_ms": 367635,
      "text": "给孩子撑起更大的空间。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 368070,
      "end_ms": 369230,
      "text": "孩子读潮汕思维，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 369570,
      "end_ms": 370775,
      "text": "知道以后怎么走。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 371200,
      "end_ms": 373580,
      "text": "父母读十局控局破局，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 373940,
      "end_ms": 376565,
      "text": "直到现在怎么带两本一起读？"
    },
    {
      "segment_id": "s000188",
      "start_ms": 376970,
      "end_ms": 378185,
      "text": "孩子少走弯路，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 378570,
      "end_ms": 379585,
      "text": "父母少踩坑，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 380100,
      "end_ms": 380735,
      "text": "一套书，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 381070,
      "end_ms": 383065,
      "text": "两代人一起开窍。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 384180,
      "end_ms": 385295,
      "text": "这本书适合谁？"
    },
    {
      "segment_id": "s000193",
      "start_ms": 386150,
      "end_ms": 387310,
      "text": "适合三到十五岁？"
    },
    {
      "segment_id": "s000194",
      "start_ms": 387310,
      "end_ms": 391985,
      "text": "孩子的父母适合幼儿园大班、小学生、初中生，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 392410,
      "end_ms": 394555,
      "text": "适合想给孩子做财商启蒙的家庭，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 394920,
      "end_ms": 398225,
      "text": "适合不想让孩子长大后被社会毒打才醒悟的父母。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 398570,
      "end_ms": 400555,
      "text": "哪怕孩子现在只认识几百个字，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 401030,
      "end_ms": 401995,
      "text": "你读给他听，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 402310,
      "end_ms": 403205,
      "text": "他也能听懂。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 403900,
      "end_ms": 405325,
      "text": "哪怕你自己不懂生意，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 405580,
      "end_ms": 407140,
      "text": "你照着书里的方法陪他练，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 407460,
      "end_ms": 409005,
      "text": "他也能一点点开窍。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 410180,
      "end_ms": 411245,
      "text": "链接就在下方，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 412010,
      "end_ms": 413525,
      "text": "别等孩子长大才后悔。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 414010,
      "end_ms": 415575,
      "text": "别等社会替你教育他，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 416030,
      "end_ms": 417085,
      "text": "你给孩子留钱，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 417510,
      "end_ms": 419130,
      "text": "不如给孩子留一颗会赚钱。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 419350,
      "end_ms": 419970,
      "text": "会做人，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 420170,
      "end_ms": 422735,
      "text": "会破局的脑子钱会花完，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 423210,
      "end_ms": 425475,
      "text": "房子会救车子会贬值，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 426300,
      "end_ms": 428675,
      "text": "但从小装进脑子里的潮汕思维，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 429130,
      "end_ms": 431250,
      "text": "谁也抢不走一辈子，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 431250,
      "end_ms": 431955,
      "text": "跟着他，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 432390,
      "end_ms": 433015,
      "text": "护着他，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 433580,
      "end_ms": 434295,
      "text": "成全他，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 435330,
      "end_ms": 436235,
      "text": "翻开第一页，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 436750,
      "end_ms": 437805,
      "text": "你就能走上去。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 438420,
      "end_ms": 438995,
      "text": "这一次，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 439560,
      "end_ms": 442235,
      "text": "我是为你自己是为你的孩子。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 442460,
      "end_ms": 442690,
      "text": "嗯，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 442990,
      "end_ms": 443765,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 444260,
      "end_ms": 445580,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 445580,
      "end_ms": 446185,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "853fc0ee741c2efbb1f4a79956387b2288d221c0f0c1be9d2c9021fb1e27fc94"
}