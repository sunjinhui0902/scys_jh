{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ca16a281f181b54b_u002",
  "video_id": "v_ca16a281f181b54b",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 969.503991,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000379",
      "start_ms": 845970,
      "end_ms": 849435,
      "text": "萨特把枪口对准了一个更根本更顽固的靶子，"
    },
    {
      "segment_id": "s000380",
      "start_ms": 849900,
      "end_ms": 853375,
      "text": "你本能里对虚无的蔑视和对本质的依赖，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 853610,
      "end_ms": 854415,
      "text": "这就太有意思了。"
    },
    {
      "segment_id": "s000382",
      "start_ms": 854900,
      "end_ms": 859760,
      "text": "所以后面我可能会回过头去把第二卷自维的存在和第三卷为他重新捋一遍。"
    },
    {
      "segment_id": "s000383",
      "start_ms": 859760,
      "end_ms": 862895,
      "text": "尤其是第二卷中关于时间性和超越性的讨论，"
    },
    {
      "segment_id": "s000384",
      "start_ms": 863150,
      "end_ms": 866210,
      "text": "以及第三卷中关于注释和他人存在的分析，"
    },
    {
      "segment_id": "s000385",
      "start_ms": 866390,
      "end_ms": 867745,
      "text": "跟大家聊的更细一些。"
    },
    {
      "segment_id": "s000386",
      "start_ms": 867950,
      "end_ms": 868765,
      "text": "但在那之前，"
    },
    {
      "segment_id": "s000387",
      "start_ms": 869150,
      "end_ms": 871670,
      "text": "我想先跟真正听到心里的朋友说一句，"
    },
    {
      "segment_id": "s000388",
      "start_ms": 871770,
      "end_ms": 875705,
      "text": "如果你刚才听到虚无自欺焦虑这些词的时候，"
    },
    {
      "segment_id": "s000389",
      "start_ms": 875950,
      "end_ms": 876975,
      "text": "心里咯噔了一下，"
    },
    {
      "segment_id": "s000390",
      "start_ms": 877320,
      "end_ms": 881455,
      "text": "那说明你已经感觉到了存在这东西不只是活着，"
    },
    {
      "segment_id": "s000391",
      "start_ms": 881750,
      "end_ms": 882965,
      "text": "他还是一种重负。"
    },
    {
      "segment_id": "s000392",
      "start_ms": 883800,
      "end_ms": 885340,
      "text": "视频能帮你看见深渊。"
    },
    {
      "segment_id": "s000393",
      "start_ms": 885540,
      "end_ms": 886800,
      "text": "但面对深渊的勇气，"
    },
    {
      "segment_id": "s000394",
      "start_ms": 887000,
      "end_ms": 890305,
      "text": "在原著里我建议你直接去读存在与虚无，"
    },
    {
      "segment_id": "s000395",
      "start_ms": 890570,
      "end_ms": 892495,
      "text": "尤其是第一卷虚无的问题，"
    },
    {
      "segment_id": "s000396",
      "start_ms": 892810,
      "end_ms": 894230,
      "text": "别买那些把萨特嚼碎了，"
    },
    {
      "segment_id": "s000397",
      "start_ms": 894230,
      "end_ms": 896010,
      "text": "喂给你的解读版就买原著。"
    },
    {
      "segment_id": "s000398",
      "start_ms": 896070,
      "end_ms": 900290,
      "text": "感兴趣的朋友可以自己找陈玄良的修订译本或者hazel burars的音译。"
    },
    {
      "segment_id": "s000399",
      "start_ms": 900290,
      "end_ms": 901130,
      "text": "本对照着读，"
    },
    {
      "segment_id": "s000400",
      "start_ms": 901230,
      "end_ms": 901790,
      "text": "不用急，"
    },
    {
      "segment_id": "s000401",
      "start_ms": 902090,
      "end_ms": 903045,
      "text": "也不用跟风。"
    },
    {
      "segment_id": "s000402",
      "start_ms": 903490,
      "end_ms": 904875,
      "text": "你只需要问自己一句，"
    },
    {
      "segment_id": "s000403",
      "start_ms": 905300,
      "end_ms": 907200,
      "text": "我是不是也受够了被人用，"
    },
    {
      "segment_id": "s000404",
      "start_ms": 907400,
      "end_ms": 908500,
      "text": "你就是这样的人，"
    },
    {
      "segment_id": "s000405",
      "start_ms": 908540,
      "end_ms": 909800,
      "text": "这句话牵着鼻子走。"
    },
    {
      "segment_id": "s000406",
      "start_ms": 909900,
      "end_ms": 910460,
      "text": "如果是，"
    },
    {
      "segment_id": "s000407",
      "start_ms": 910660,
      "end_ms": 912235,
      "text": "那这本书就是给你准备的。"
    },
    {
      "segment_id": "s000408",
      "start_ms": 912660,
      "end_ms": 915525,
      "text": "你会在书里看到更多我视频里没法展开的细节，"
    },
    {
      "segment_id": "s000409",
      "start_ms": 915830,
      "end_ms": 916735,
      "text": "也会突然明白，"
    },
    {
      "segment_id": "s000410",
      "start_ms": 917060,
      "end_ms": 921240,
      "text": "原来你脑子里很多关于我是谁的判断都是被人悄悄塞进来的。"
    },
    {
      "segment_id": "s000411",
      "start_ms": 921240,
      "end_ms": 923025,
      "text": "它不是那种读一遍就扔的书。"
    },
    {
      "segment_id": "s000412",
      "start_ms": 923400,
      "end_ms": 925895,
      "text": "它是你每隔一段时间都要翻一番的解毒剂，"
    },
    {
      "segment_id": "s000413",
      "start_ms": 926360,
      "end_ms": 927575,
      "text": "你不需要一次读懂，"
    },
    {
      "segment_id": "s000414",
      "start_ms": 927910,
      "end_ms": 931230,
      "text": "你只需要在下次有人说你天生就不是那块料，"
    },
    {
      "segment_id": "s000415",
      "start_ms": 931470,
      "end_ms": 932350,
      "text": "现实一点吧，"
    },
    {
      "segment_id": "s000416",
      "start_ms": 932410,
      "end_ms": 934670,
      "text": "人都是这样的时候能停半秒，"
    },
    {
      "segment_id": "s000417",
      "start_ms": 935030,
      "end_ms": 935715,
      "text": "问一句，"
    },
    {
      "segment_id": "s000418",
      "start_ms": 936050,
      "end_ms": 938735,
      "text": "谁定义的那块料谁的现实，"
    },
    {
      "segment_id": "s000419",
      "start_ms": 939160,
      "end_ms": 940765,
      "text": "谁说的人都是这样，"
    },
    {
      "segment_id": "s000420",
      "start_ms": 941110,
      "end_ms": 943230,
      "text": "这半秒就是你自由的开始。"
    },
    {
      "segment_id": "s000421",
      "start_ms": 943310,
      "end_ms": 943745,
      "text": "总之，"
    },
    {
      "segment_id": "s000422",
      "start_ms": 944170,
      "end_ms": 946970,
      "text": "萨特作为法国存在主义最重要的思想家，"
    },
    {
      "segment_id": "s000423",
      "start_ms": 947170,
      "end_ms": 952090,
      "text": "他在存在与虚无第一卷中对虚无、否定、自欺和焦虑的分析，"
    },
    {
      "segment_id": "s000424",
      "start_ms": 952090,
      "end_ms": 953230,
      "text": "还有太多可以聊，"
    },
    {
      "segment_id": "s000425",
      "start_ms": 953570,
      "end_ms": 955090,
      "text": "后续我打算继续解读。"
    },
    {
      "segment_id": "s000426",
      "start_ms": 955090,
      "end_ms": 958840,
      "text": "另一位对理解萨特极有帮助的思想家梅落旁地，"
    },
    {
      "segment_id": "s000427",
      "start_ms": 959060,
      "end_ms": 961745,
      "text": "他的知觉、现象学和辩证法的冒险，"
    },
    {
      "segment_id": "s000428",
      "start_ms": 962140,
      "end_ms": 966440,
      "text": "对理解意识的身体性和自由的处境维度是一个极好的补充。"
    },
    {
      "segment_id": "s000429",
      "start_ms": 966640,
      "end_ms": 967340,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000430",
      "start_ms": 967500,
      "end_ms": 968820,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000431",
      "start_ms": 968820,
      "end_ms": 969445,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "0c273ed29451264c9ccac56e10d20b298b334977cb105180fd4fb239bdc10b7e"
}