{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_17f0c21059230af2_u001",
  "video_id": "v_17f0c21059230af2",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 788.76,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 360,
      "end_ms": 2300,
      "text": "十三分钟讲解残雪黄泥街。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2560,
      "end_ms": 6740,
      "text": "今天我们来看看中国先锋文学里那座最让人喘不过气儿的迷宫，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7140,
      "end_ms": 9840,
      "text": "残雪的黄泥街这部书有多牛？"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9900,
      "end_ms": 10500,
      "text": "这么说吧，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 10740,
      "end_ms": 12780,
      "text": "残雪正是凭着这部处女作，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12920,
      "end_ms": 14700,
      "text": "从一个缝纫机旁的裁缝，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 14860,
      "end_ms": 17800,
      "text": "一路杀进了诺贝尔文学奖赔率榜的榜首。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18260,
      "end_ms": 20860,
      "text": "美国作家苏珊桑塔格读了他的作品后，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 20880,
      "end_ms": 21000,
      "text": "说，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 21000,
      "end_ms": 22600,
      "text": "他是中国最好的作家。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23000,
      "end_ms": 25940,
      "text": "瑞典汉学家马跃然称他为中国的卡夫卡。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 26280,
      "end_ms": 29240,
      "text": "一本让你读完觉得浑身发痒、坐立难安的书，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 29520,
      "end_ms": 30450,
      "text": "你见过剧本？"
    },
    {
      "segment_id": "s000014",
      "start_ms": 30730,
      "end_ms": 31370,
      "text": "话不多说，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 31410,
      "end_ms": 33870,
      "text": "我们现在就开始我们的主人公残雪，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 34050,
      "end_ms": 35070,
      "text": "本名邓小华。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 35410,
      "end_ms": 37410,
      "text": "一九五三年生于湖南长沙，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 37550,
      "end_ms": 39250,
      "text": "他不是什么科班出身的文人，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 39530,
      "end_ms": 42010,
      "text": "做过洗工、装配工赤脚医生，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 42410,
      "end_ms": 44590,
      "text": "后来和丈夫一起开了个裁缝店谋生。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 44890,
      "end_ms": 45670,
      "text": "一九八三年，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 45810,
      "end_ms": 46790,
      "text": "他刚满三十岁，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 47230,
      "end_ms": 48650,
      "text": "白天在店里接待顾客，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 48830,
      "end_ms": 50510,
      "text": "晚上还要陪四岁的奇子。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 50770,
      "end_ms": 52250,
      "text": "就趁着这些零碎的时间，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 52330,
      "end_ms": 53250,
      "text": "坐在缝纫机旁，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 53350,
      "end_ms": 55290,
      "text": "一笔一划的写写出了一部，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 55290,
      "end_ms": 58110,
      "text": "让整个文坛都不知道该怎么归类的奇书。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 58250,
      "end_ms": 59130,
      "text": "那么问题来了，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 59350,
      "end_ms": 60935,
      "text": "残雪到你写了什么？"
    },
    {
      "segment_id": "s000031",
      "start_ms": 61630,
      "end_ms": 62695,
      "text": "他写了一条街，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 63200,
      "end_ms": 63640,
      "text": "这条街，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 63640,
      "end_ms": 63960,
      "text": "肮脏，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 63960,
      "end_ms": 64380,
      "text": "不堪，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 64660,
      "end_ms": 65680,
      "text": "到处是死猪。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 65900,
      "end_ms": 67185,
      "text": "死猫烂肉，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 67530,
      "end_ms": 68470,
      "text": "蛆虫、苍蝇，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 68470,
      "end_ms": 69390,
      "text": "蚊子满天飞，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 69690,
      "end_ms": 70870,
      "text": "大便小便横流，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 71110,
      "end_ms": 72435,
      "text": "天上还会钓死鱼。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 72730,
      "end_ms": 73250,
      "text": "大热天，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 73330,
      "end_ms": 74390,
      "text": "大家都裹着棉袄，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 74590,
      "end_ms": 75870,
      "text": "每个人都无所事事，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 76150,
      "end_ms": 76870,
      "text": "说着梦话，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 77010,
      "end_ms": 77710,
      "text": "造着谣言，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 78070,
      "end_ms": 78770,
      "text": "吓着别人，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 78770,
      "end_ms": 79695,
      "text": "也吓着自己。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 79980,
      "end_ms": 80765,
      "text": "更离谱的是，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 81040,
      "end_ms": 82300,
      "text": "有人因为饮食过度，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 82300,
      "end_ms": 83955,
      "text": "被一只瘟鸡吃死了，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 84240,
      "end_ms": 85855,
      "text": "有人自愿吞玻璃身亡。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 86280,
      "end_ms": 87400,
      "text": "这些荒诞的死因，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 87420,
      "end_ms": 90580,
      "text": "居然被一本正经的登记在死亡原因登记表上。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 90640,
      "end_ms": 91115,
      "text": "你想想，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 91460,
      "end_ms": 94955,
      "text": "一个人把死亡登记表写成了一份荒诞文学清单。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 95280,
      "end_ms": 98380,
      "text": "那这条街上活着的人过的还是人过的日子嘛。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 98380,
      "end_ms": 101260,
      "text": "但你不要以为残雪只是在那里堆砌恶心和恐怖。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 101400,
      "end_ms": 102635,
      "text": "他写这些脏东西，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 102890,
      "end_ms": 103975,
      "text": "不是为了吓唬你，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 104220,
      "end_ms": 106595,
      "text": "而是在撕开一层又一层的困境。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 107060,
      "end_ms": 108035,
      "text": "学者研究发现，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 108340,
      "end_ms": 110480,
      "text": "残雪用非自然叙事的手法，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 110560,
      "end_ms": 112920,
      "text": "构建了三种层层递进的困境，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 113020,
      "end_ms": 115355,
      "text": "恐怖的空间凸显了人的生存困境。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 115680,
      "end_ms": 116520,
      "text": "变态的心理，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 116540,
      "end_ms": 118005,
      "text": "折射了人的精神困境。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 118370,
      "end_ms": 121135,
      "text": "梦一般的叙述则反映了人的表达困境。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 121410,
      "end_ms": 121925,
      "text": "说白了，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 122200,
      "end_ms": 123765,
      "text": "黄泥街就是一面镜子，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 124150,
      "end_ms": 126130,
      "text": "你看到的那些垃圾和死鱼，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 126430,
      "end_ms": 128490,
      "text": "其实是人心里装不下的腐烂。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 128650,
      "end_ms": 129835,
      "text": "先说生存困境，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 130430,
      "end_ms": 134005,
      "text": "黄泥街上的房子被灰尘、恶臭和腐败侵蚀，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 134520,
      "end_ms": 136120,
      "text": "家本该是最安全的地方，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 136260,
      "end_ms": 137840,
      "text": "却变成了最恐怖的空间。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 137980,
      "end_ms": 139680,
      "text": "居民们躲进阁楼衣柜，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 139840,
      "end_ms": 141800,
      "text": "厨房不是因为舒服，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 142120,
      "end_ms": 144700,
      "text": "是因为怕书中有个叫江水英的女人，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 144780,
      "end_ms": 146055,
      "text": "被丈夫关进笼子里，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 146310,
      "end_ms": 148315,
      "text": "因为它长着一双像鸡爪一样的脚，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 148790,
      "end_ms": 150090,
      "text": "一个人被关进笼子，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 150210,
      "end_ms": 151395,
      "text": "活得像一只动物。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 151700,
      "end_ms": 152925,
      "text": "这不是荒诞是什么？"
    },
    {
      "segment_id": "s000084",
      "start_ms": 153180,
      "end_ms": 158965,
      "text": "但更荒诞的是你读着读着会突然觉得我们每个人是不是也住在自己的笼子里，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 159330,
      "end_ms": 161410,
      "text": "只不过我们的笼子更体面一些，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 161610,
      "end_ms": 162370,
      "text": "是格子间，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 162550,
      "end_ms": 163190,
      "text": "是房贷，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 163390,
      "end_ms": 166045,
      "text": "是朋友圈里精心修饰过的那张脸。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 166580,
      "end_ms": 167615,
      "text": "再说精神困境，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 168180,
      "end_ms": 171505,
      "text": "黄泥街的人集体患上了红眼病和长期咳嗽，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 171980,
      "end_ms": 173000,
      "text": "身体上病着，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 173220,
      "end_ms": 174545,
      "text": "精神上更病着，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 174940,
      "end_ms": 176320,
      "text": "有人像猪一样哼哼，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 176520,
      "end_ms": 177495,
      "text": "有人吃苍蝇。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 177930,
      "end_ms": 180275,
      "text": "有人陷入永久的昏睡或恍惚中，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 180580,
      "end_ms": 183045,
      "text": "像活着的死人一样在街上游荡。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 183490,
      "end_ms": 184455,
      "text": "学者研究指出，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 184740,
      "end_ms": 186540,
      "text": "这些人物身体怪异的变形，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 186780,
      "end_ms": 188075,
      "text": "精神彻底麻木，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 188410,
      "end_ms": 190755,
      "text": "说明末日不是从外面打进来的，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 191000,
      "end_ms": 193585,
      "text": "而是从里面一点一点烂出来的。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 193990,
      "end_ms": 194475,
      "text": "你想想，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 194870,
      "end_ms": 196425,
      "text": "一个人精神上先死了，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 196680,
      "end_ms": 198215,
      "text": "身体还在街上走着，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 198460,
      "end_ms": 199785,
      "text": "嘴里还在说着梦话，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 200220,
      "end_ms": 202295,
      "text": "这比肉体的死亡可怕一万倍。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 202540,
      "end_ms": 203720,
      "text": "最后说表达困境。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 203800,
      "end_ms": 204940,
      "text": "黄泥街的人说的话，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 204940,
      "end_ms": 205920,
      "text": "全都是梦话，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 206040,
      "end_ms": 207100,
      "text": "谣言和闲话，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 207400,
      "end_ms": 208600,
      "text": "没有一句是真话，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 208840,
      "end_ms": 211035,
      "text": "没有一句能传达真实的痛苦。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 211480,
      "end_ms": 212620,
      "text": "不是他们不想说，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 212880,
      "end_ms": 214405,
      "text": "是他们已经不会说了，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 215040,
      "end_ms": 218000,
      "text": "语言在这条街上变成了一堆废弃的空壳，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 218500,
      "end_ms": 220860,
      "text": "就像那些从天上掉下来的死鱼一样，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 220940,
      "end_ms": 222995,
      "text": "张着嘴却发不出任何声音。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 223250,
      "end_ms": 223490,
      "text": "好，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 223550,
      "end_ms": 225110,
      "text": "我们现在来说一个关键问题，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 225210,
      "end_ms": 227154,
      "text": "黄泥街上到底有没有希望？"
    },
    {
      "segment_id": "s000121",
      "start_ms": 227710,
      "end_ms": 229735,
      "text": "答案藏在一个神秘的名字里。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 230050,
      "end_ms": 233760,
      "text": "王子光这个名字在整个小说里反复出现，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 233900,
      "end_ms": 236080,
      "text": "但从来没有人说清楚他到底是谁，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 236200,
      "end_ms": 236960,
      "text": "他做了什么，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 236960,
      "end_ms": 237915,
      "text": "他长什么样子，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 238170,
      "end_ms": 239705,
      "text": "他就是街上的一个传说，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 240230,
      "end_ms": 241495,
      "text": "一个幽灵般的存在。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 242540,
      "end_ms": 243300,
      "text": "学者解读说，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 243640,
      "end_ms": 247075,
      "text": "王子光代表的是一种向死而生的生存态度，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 247450,
      "end_ms": 250395,
      "text": "是黄泥街人摆脱沉沦境地的唯一契机。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 250880,
      "end_ms": 251800,
      "text": "从这个角度来说，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 252080,
      "end_ms": 253825,
      "text": "王子光是什么并不重要，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 254190,
      "end_ms": 256505,
      "text": "重要的是他那种形而上的引领。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 256950,
      "end_ms": 260475,
      "text": "他令黄泥街人开始逐步摆脱沉沦的在世状况。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 260920,
      "end_ms": 261380,
      "text": "打个比方，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 261380,
      "end_ms": 261955,
      "text": "你就懂了。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 262330,
      "end_ms": 264345,
      "text": "一个人被困在黑暗的洞穴里，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 264610,
      "end_ms": 265865,
      "text": "他已经习惯了黑暗，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 266150,
      "end_ms": 268155,
      "text": "甚至觉得黑暗就是世界的全部。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 268540,
      "end_ms": 269260,
      "text": "忽然有一天，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 269540,
      "end_ms": 271365,
      "text": "他听到头顶传来一个声音，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 271890,
      "end_ms": 273055,
      "text": "他不知道那是什么？"
    },
    {
      "segment_id": "s000143",
      "start_ms": 273310,
      "end_ms": 274425,
      "text": "不知道来自哪里。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 274790,
      "end_ms": 275950,
      "text": "但那个声音告诉他，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 276090,
      "end_ms": 277005,
      "text": "上面有光，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 277610,
      "end_ms": 279230,
      "text": "你可以说那个声音是个幻觉。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 279490,
      "end_ms": 281130,
      "text": "但正是因为有了这个幻觉，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 281390,
      "end_ms": 284375,
      "text": "那个人才第一次意识到自己正呆在洞穴里。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 284690,
      "end_ms": 286495,
      "text": "王子光就是那道声音，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 287090,
      "end_ms": 289275,
      "text": "残雪没有告诉我们他能带来什么？"
    },
    {
      "segment_id": "s000151",
      "start_ms": 289630,
      "end_ms": 292835,
      "text": "他只是让这条死气沉沉烂到根子里的街道上，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 293170,
      "end_ms": 296085,
      "text": "始终悬着一个说不清道不明的东西，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 296890,
      "end_ms": 297925,
      "text": "你觉得他不存在？"
    },
    {
      "segment_id": "s000154",
      "start_ms": 298230,
      "end_ms": 299930,
      "text": "但你又没法证明它不存在，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 300470,
      "end_ms": 301550,
      "text": "而这种不确定，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 301910,
      "end_ms": 304010,
      "text": "恰恰就是希望最朴素的样子。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 304350,
      "end_ms": 305510,
      "text": "正如评论者所说，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 305730,
      "end_ms": 312090,
      "text": "这种死中求活的生存态度为黄泥街阴暗的存在场景注入了人类追求永生的光芒。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 312770,
      "end_ms": 314350,
      "text": "残雪是怎么写出来的？"
    },
    {
      "segment_id": "s000160",
      "start_ms": 314710,
      "end_ms": 315850,
      "text": "他自己说过一句话，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 316150,
      "end_ms": 316570,
      "text": "他说，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 316970,
      "end_ms": 318430,
      "text": "我发现我在写小说时，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 318450,
      "end_ms": 320570,
      "text": "不需要事先思考情节与结构，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 321010,
      "end_ms": 323690,
      "text": "不论是很短的还是较长的作品都一样，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 323730,
      "end_ms": 325270,
      "text": "我只要一坐下来就可以写，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 325470,
      "end_ms": 329060,
      "text": "从来不考虑如何写这种写作方式，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 329060,
      "end_ms": 330420,
      "text": "它称为自动写作，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 330560,
      "end_ms": 331980,
      "text": "不做构思、不修改，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 332220,
      "end_ms": 333360,
      "text": "只凭原始冲动，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 333360,
      "end_ms": 334800,
      "text": "让潜意识自然流淌。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 335660,
      "end_ms": 337740,
      "text": "评论家给这种写作起了个名字，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 337880,
      "end_ms": 339760,
      "text": "叫黑暗灵魂的舞蹈。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 339760,
      "end_ms": 343120,
      "text": "你读了之后会发现整本书没有清晰的时间顺序，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 343180,
      "end_ms": 344680,
      "text": "没有完整的故事情节，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 344960,
      "end_ms": 347120,
      "text": "更像一场你在高烧中做的噩梦。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 347300,
      "end_ms": 347840,
      "text": "说到这儿，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 347840,
      "end_ms": 349700,
      "text": "你可能马上就联想到卡夫卡了。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 350060,
      "end_ms": 350480,
      "text": "没错，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 350700,
      "end_ms": 353000,
      "text": "残血的叙事确实有卡夫卡的影子，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 353100,
      "end_ms": 354660,
      "text": "但比卡夫卡更潮湿，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 354820,
      "end_ms": 355560,
      "text": "更粘稠，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 355880,
      "end_ms": 358595,
      "text": "更让你觉得什么东西正从字缝里往外爬。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 359190,
      "end_ms": 359950,
      "text": "有意思的是，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 360250,
      "end_ms": 363135,
      "text": "残血的文字里藏着大量的隐喻和象征。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 363720,
      "end_ms": 364625,
      "text": "评论家指出，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 364900,
      "end_ms": 367600,
      "text": "他在创造这个阴冷但也光明潮湿，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 367600,
      "end_ms": 368895,
      "text": "但也爽朗的世界时，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 369200,
      "end_ms": 371305,
      "text": "并不运用传统的预言方式，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 371650,
      "end_ms": 375995,
      "text": "更多的是诉诸个人的经验、直觉、感受和记忆。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 376630,
      "end_ms": 378450,
      "text": "这就意味着你读他的书，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 378630,
      "end_ms": 380145,
      "text": "不能用脑子去分析，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 380530,
      "end_ms": 381890,
      "text": "得用身体去感受。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 382010,
      "end_ms": 382765,
      "text": "那问题来了，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 383440,
      "end_ms": 385395,
      "text": "残雪为什么要写这些东西？"
    },
    {
      "segment_id": "s000195",
      "start_ms": 385920,
      "end_ms": 387325,
      "text": "他的目的到底是什么？"
    },
    {
      "segment_id": "s000196",
      "start_ms": 387930,
      "end_ms": 390370,
      "text": "这就要说到他的一个核心写作理念了。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 390370,
      "end_ms": 391215,
      "text": "你可能会觉得，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 391530,
      "end_ms": 392550,
      "text": "一个写脏东西，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 392550,
      "end_ms": 393650,
      "text": "写了几十年的人，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 393770,
      "end_ms": 396675,
      "text": "一定是个阴暗、愤怒、苦大仇深的人。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 397190,
      "end_ms": 397885,
      "text": "恰恰相反，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 398360,
      "end_ms": 399095,
      "text": "残雪说，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 399490,
      "end_ms": 402165,
      "text": "我的日常生活给我的表演生活提供能量，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 402500,
      "end_ms": 405125,
      "text": "我的表演生活给我的日常生活赋予意义。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 405740,
      "end_ms": 407095,
      "text": "他把写作称为表演，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 407480,
      "end_ms": 410230,
      "text": "而且他说他写小说是一种快乐啊，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 410430,
      "end_ms": 411445,
      "text": "我多么快乐。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 411830,
      "end_ms": 414090,
      "text": "你看一个描写地狱的人，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 414270,
      "end_ms": 416145,
      "text": "自己却在地狱里找到了光明。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 416790,
      "end_ms": 418445,
      "text": "这正是他最了不起的地方。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 418900,
      "end_ms": 420145,
      "text": "他不是在恐吓你，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 420460,
      "end_ms": 424245,
      "text": "他是在告诉你你身上那些不敢面对的阴暗和恐惧，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 424590,
      "end_ms": 426215,
      "text": "其实都可以变成一种力量。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 426680,
      "end_ms": 428735,
      "text": "他把文学当做一种精神实验，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 429040,
      "end_ms": 432755,
      "text": "在灵与肉精神与物质的矛盾互动中展开叙事。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 433170,
      "end_ms": 434955,
      "text": "不是为了让你做一个舒服的梦，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 435250,
      "end_ms": 437230,
      "text": "而是为了让你在最不舒服的地方，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 437290,
      "end_ms": 439335,
      "text": "忽然触碰到真实的自我。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 439570,
      "end_ms": 441465,
      "text": "这就引出我们今天要思考的核心了。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 441860,
      "end_ms": 442565,
      "text": "你可能会问，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 443080,
      "end_ms": 444560,
      "text": "残血费这么大劲儿，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 444560,
      "end_ms": 446540,
      "text": "写一条脏的让人作呕的街，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 446780,
      "end_ms": 448555,
      "text": "写一群活的不像人的人。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 448870,
      "end_ms": 451290,
      "text": "这些东西跟我们今天的生活到底有什么关系？"
    },
    {
      "segment_id": "s000225",
      "start_ms": 451490,
      "end_ms": 453490,
      "text": "我们又不是住在黄泥街上的居民，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 453650,
      "end_ms": 454570,
      "text": "每天也得挤地铁，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 454570,
      "end_ms": 455030,
      "text": "上班，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 455170,
      "end_ms": 456315,
      "text": "月底还得还花呗，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 456610,
      "end_ms": 459895,
      "text": "哪有功夫去琢磨什么非自然叙事和存在主义荒诞。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 460150,
      "end_ms": 461015,
      "text": "这个问题问的好，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 461480,
      "end_ms": 462355,
      "text": "让我们来想一想，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 462700,
      "end_ms": 465135,
      "text": "残雪写黄泥街的那个脏字，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 465620,
      "end_ms": 469475,
      "text": "究竟给我们这些正常世界的普通人开出了什么样的药方？"
    },
    {
      "segment_id": "s000234",
      "start_ms": 469950,
      "end_ms": 470415,
      "text": "你看，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 470860,
      "end_ms": 472955,
      "text": "黄泥街上有一种病叫红眼儿病，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 473270,
      "end_ms": 474485,
      "text": "不是真的眼睛发炎，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 474870,
      "end_ms": 476770,
      "text": "而是一种精神上的嫉妒和怨。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 476770,
      "end_ms": 479585,
      "text": "妒街上的每个人都在盯着别人的生活，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 479910,
      "end_ms": 480650,
      "text": "别人分了房子，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 480650,
      "end_ms": 482530,
      "text": "他眼红别人孩子考了大学，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 482530,
      "end_ms": 484540,
      "text": "他嫉妒别人家亲戚送了礼，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 484540,
      "end_ms": 485060,
      "text": "他没收到，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 485060,
      "end_ms": 486220,
      "text": "就翻来覆去睡不着。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 486580,
      "end_ms": 488585,
      "text": "这不就是我们朋友圈里的日常吗？"
    },
    {
      "segment_id": "s000245",
      "start_ms": 489170,
      "end_ms": 490470,
      "text": "今天看到同学升了职，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 490750,
      "end_ms": 491950,
      "text": "明天看到闺蜜买了包，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 492150,
      "end_ms": 493850,
      "text": "后天看到前同事晒了新房，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 494090,
      "end_ms": 495050,
      "text": "你嘴上说着恭喜，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 495050,
      "end_ms": 496290,
      "text": "心里泛着酸水儿。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 496850,
      "end_ms": 499350,
      "text": "你已经在自己的黄泥街上住了很久了，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 499370,
      "end_ms": 503195,
      "text": "只是你不敢承认黄泥街上还有一种病叫说梦话，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 503720,
      "end_ms": 505760,
      "text": "所有人都在造谣传谣，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 505960,
      "end_ms": 506580,
      "text": "吓唬别人，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 506580,
      "end_ms": 508170,
      "text": "也吓着自己说的话，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 508170,
      "end_ms": 511375,
      "text": "没有一句是有意义的这不就是我们的微信群和朋友圈吗？"
    },
    {
      "segment_id": "s000256",
      "start_ms": 511940,
      "end_ms": 513635,
      "text": "你转发一条没核实的消息，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 513920,
      "end_ms": 515835,
      "text": "你给一条营销号的标题点了赞。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 516070,
      "end_ms": 518145,
      "text": "你在评论区里跟陌生人吵了一架，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 518530,
      "end_ms": 519490,
      "text": "这些都是梦话，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 519710,
      "end_ms": 521245,
      "text": "不是你真正的心里话。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 521660,
      "end_ms": 524245,
      "text": "至于黄泥街上那些荒诞的死亡登记表，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 524570,
      "end_ms": 526105,
      "text": "那些莫名其妙的死因，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 526580,
      "end_ms": 529135,
      "text": "你不觉得像极了我们每天看到的新闻吗？"
    },
    {
      "segment_id": "s000264",
      "start_ms": 529460,
      "end_ms": 530560,
      "text": "一个人过劳死了，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 530740,
      "end_ms": 532435,
      "text": "官方说是突发心梗。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 532830,
      "end_ms": 534235,
      "text": "一个人被压力压垮了，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 534470,
      "end_ms": 536015,
      "text": "所有人说他是心态不好。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 536380,
      "end_ms": 538480,
      "text": "我们其实也在用各种各样的登记表，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 538640,
      "end_ms": 541255,
      "text": "把荒诞的现实写的看上去很正常。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 541820,
      "end_ms": 544785,
      "text": "所以残血的书不是只写给文学评论家看的，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 545480,
      "end_ms": 546875,
      "text": "他写的是一种普通的，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 547130,
      "end_ms": 549235,
      "text": "每个人都可能陷入的精神状态。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 549680,
      "end_ms": 550985,
      "text": "你住在哪里不重要，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 551360,
      "end_ms": 554035,
      "text": "重要的是你的心里有没有一条黄泥街。"
    },
    {
      "segment_id": "s000275",
      "start_ms": 554500,
      "end_ms": 555720,
      "text": "你每天说梦话，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 555940,
      "end_ms": 558225,
      "text": "造谣言吓别人也吓自己。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 558670,
      "end_ms": 559950,
      "text": "大热天裹着棉袄，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 560030,
      "end_ms": 561735,
      "text": "不敢把真实的自己露出来，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 561970,
      "end_ms": 563550,
      "text": "见到王紫光的影子就害怕，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 563550,
      "end_ms": 565425,
      "text": "却又忍不住想看看他到底是谁。"
    },
    {
      "segment_id": "s000281",
      "start_ms": 566000,
      "end_ms": 569795,
      "text": "你的人生被一堆腐烂的垃圾和到处乱跑的死鱼包围着，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 570120,
      "end_ms": 571060,
      "text": "你觉得这就是生活。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 571060,
      "end_ms": 572005,
      "text": "本来的样子，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 572410,
      "end_ms": 573455,
      "text": "但残雪告诉你，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 573640,
      "end_ms": 574175,
      "text": "不是的，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 574730,
      "end_ms": 576625,
      "text": "你只是忘了自己住在笼子里，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 576820,
      "end_ms": 578725,
      "text": "你只是把笼子当成了家，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 579140,
      "end_ms": 579955,
      "text": "那怎么办呢？"
    },
    {
      "segment_id": "s000289",
      "start_ms": 580530,
      "end_ms": 582295,
      "text": "残雪没有给出一个标准答案，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 582600,
      "end_ms": 584665,
      "text": "他没有告诉你应该怎样生活。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 585250,
      "end_ms": 587325,
      "text": "他只是把这个笼子打开了一条缝，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 587710,
      "end_ms": 589495,
      "text": "让你自己闻到外面的空气。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 589800,
      "end_ms": 592500,
      "text": "他让你在读到江水鹰钻进笼子不出来时，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 592780,
      "end_ms": 594785,
      "text": "突然意识到自己也有一双鸡爪。"
    },
    {
      "segment_id": "s000295",
      "start_ms": 595290,
      "end_ms": 596710,
      "text": "那个你拼命藏起来，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 596830,
      "end_ms": 598750,
      "text": "怕被人看见的真实的自己。"
    },
    {
      "segment_id": "s000297",
      "start_ms": 598990,
      "end_ms": 601030,
      "text": "他让你在读到天上钓死鱼时，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 601310,
      "end_ms": 604270,
      "text": "突然想起自己那些被压抑的腐烂掉的，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 604270,
      "end_ms": 605750,
      "text": "从不敢表达的情绪。"
    },
    {
      "segment_id": "s000300",
      "start_ms": 605970,
      "end_ms": 608150,
      "text": "他让你在读到王子光这个名字时，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 608450,
      "end_ms": 610550,
      "text": "在心里某个角落升起一个疑问，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 611149,
      "end_ms": 613650,
      "text": "也许我的生活不应该是现在这个样子。"
    },
    {
      "segment_id": "s000303",
      "start_ms": 613730,
      "end_ms": 614610,
      "text": "故事讲到这里，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 614730,
      "end_ms": 615590,
      "text": "我想跟你说一句，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 615590,
      "end_ms": 616590,
      "text": "掏心窝子的话，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 616810,
      "end_ms": 620710,
      "text": "残雪在一九八三年伏在缝纫机上写下这部小说的时候，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 620730,
      "end_ms": 621790,
      "text": "一定不会想到，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 622130,
      "end_ms": 622810,
      "text": "四十年后，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 622870,
      "end_ms": 626780,
      "text": "他会被全世界的读者捧上诺贝尔文学奖赔率榜的首位。"
    },
    {
      "segment_id": "s000310",
      "start_ms": 627140,
      "end_ms": 628220,
      "text": "截至二零二三年，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 628580,
      "end_ms": 634140,
      "text": "他有近九十本作品被翻译成英语、法语、德语、日语瑞典语等多种语言。"
    },
    {
      "segment_id": "s000312",
      "start_ms": 634540,
      "end_ms": 639600,
      "text": "他的小说入选哈佛大学、康奈尔大学、哥伦比亚大学等海外高校的教材。"
    },
    {
      "segment_id": "s000313",
      "start_ms": 640020,
      "end_ms": 643240,
      "text": "她获得了美国最佳翻译图书奖和美国文学奖，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 643480,
      "end_ms": 645580,
      "text": "是首位获此殊荣的中国作家。"
    },
    {
      "segment_id": "s000315",
      "start_ms": 645980,
      "end_ms": 647960,
      "text": "一个从裁缝铺里走出来的女人，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 648160,
      "end_ms": 653540,
      "text": "用一台缝纫机旁边的零碎时间写出了一部让全世界都为之侧目的作品。"
    },
    {
      "segment_id": "s000317",
      "start_ms": 653920,
      "end_ms": 656395,
      "text": "这本身就是一个关于王子光的故事。"
    },
    {
      "segment_id": "s000318",
      "start_ms": 656950,
      "end_ms": 659545,
      "text": "你不必等到生活变好了才开始活着。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 659980,
      "end_ms": 661820,
      "text": "你可以在最糟糕的环境里，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 661940,
      "end_ms": 664200,
      "text": "依然发出属于你自己的声音。"
    },
    {
      "segment_id": "s000321",
      "start_ms": 664320,
      "end_ms": 667040,
      "text": "黄泥街一九八三年写成一九八六年，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 667040,
      "end_ms": 669015,
      "text": "在丁玲的帮助下才得以发表，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 669450,
      "end_ms": 672830,
      "text": "但他一出来就撕开了当时主流写作的既定框架。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 672950,
      "end_ms": 674070,
      "text": "三十多年过去了，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 674190,
      "end_ms": 676475,
      "text": "这条街上的垃圾和死鱼没有减少，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 676830,
      "end_ms": 679465,
      "text": "反而越来越多的出现在我们每个人的生活里。"
    },
    {
      "segment_id": "s000327",
      "start_ms": 679990,
      "end_ms": 680790,
      "text": "你刷着手机，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 680810,
      "end_ms": 681690,
      "text": "看到别人的生活，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 681690,
      "end_ms": 682430,
      "text": "光鲜亮丽，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 682610,
      "end_ms": 684505,
      "text": "心里翻涌着酸楚和焦虑。"
    },
    {
      "segment_id": "s000331",
      "start_ms": 684930,
      "end_ms": 686370,
      "text": "你在深夜里辗转反侧，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 686690,
      "end_ms": 688845,
      "text": "想着明天的早会和老板的脸色。"
    },
    {
      "segment_id": "s000333",
      "start_ms": 689100,
      "end_ms": 690565,
      "text": "你在人群中挤来挤去，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 690880,
      "end_ms": 692595,
      "text": "却始终觉得自己是一个人。"
    },
    {
      "segment_id": "s000335",
      "start_ms": 692980,
      "end_ms": 695785,
      "text": "这个时候你需要的不是一碗鸡汤，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 696330,
      "end_ms": 697305,
      "text": "而是一面镜子，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 697910,
      "end_ms": 699935,
      "text": "残血能给你这面镜子。"
    },
    {
      "segment_id": "s000338",
      "start_ms": 700260,
      "end_ms": 702205,
      "text": "所以我今天要特别推荐这本书给你，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 702400,
      "end_ms": 703895,
      "text": "它不是一本轻松的读物，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 704250,
      "end_ms": 705145,
      "text": "但它是值得的。"
    },
    {
      "segment_id": "s000341",
      "start_ms": 705630,
      "end_ms": 708375,
      "text": "你不需要去理解他所有的隐喻和象征。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 708930,
      "end_ms": 711050,
      "text": "你只需要让残血的文字带着你走，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 711450,
      "end_ms": 714690,
      "text": "让那些看似荒诞的描写敲开你心里某扇。"
    },
    {
      "segment_id": "s000344",
      "start_ms": 714690,
      "end_ms": 716585,
      "text": "你已经很久没有打开过的门，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 717150,
      "end_ms": 719805,
      "text": "你会在江水鹰的笼子里看到自己的恐惧。"
    },
    {
      "segment_id": "s000346",
      "start_ms": 720200,
      "end_ms": 722935,
      "text": "在王四麻子的异语里听到自己的声音，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 723370,
      "end_ms": 725770,
      "text": "在黄泥间漫天的死鱼和垃圾中，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 726050,
      "end_ms": 727870,
      "text": "辨认出你每天都在经历，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 727870,
      "end_ms": 729595,
      "text": "却从不敢承认的荒诞。"
    },
    {
      "segment_id": "s000350",
      "start_ms": 730130,
      "end_ms": 733825,
      "text": "但你也一定会在王子光这个名字里找到一丝光亮。"
    },
    {
      "segment_id": "s000351",
      "start_ms": 734300,
      "end_ms": 735895,
      "text": "那光亮不是别人给你的，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 736400,
      "end_ms": 739585,
      "text": "是你自己在泥泞中挣扎着站起来的勇气。"
    },
    {
      "segment_id": "s000353",
      "start_ms": 739880,
      "end_ms": 740700,
      "text": "读完黄泥街，"
    },
    {
      "segment_id": "s000354",
      "start_ms": 741160,
      "end_ms": 744295,
      "text": "希望你在每一个觉得自己困在笼子里的日子里，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 744720,
      "end_ms": 746635,
      "text": "心里都能想起残雪的那句话，"
    },
    {
      "segment_id": "s000356",
      "start_ms": 747020,
      "end_ms": 748735,
      "text": "我过着一种双重的生活，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 749350,
      "end_ms": 752125,
      "text": "我的日常生活给我的表演生活提供能量，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 752500,
      "end_ms": 755325,
      "text": "我的表演生活给我的日常生活赋予意义，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 755900,
      "end_ms": 757795,
      "text": "世界自有它的荒诞和腐烂。"
    },
    {
      "segment_id": "s000360",
      "start_ms": 758230,
      "end_ms": 761275,
      "text": "我们能做的不是在垃圾堆里麻木的等死，"
    },
    {
      "segment_id": "s000361",
      "start_ms": 761760,
      "end_ms": 763835,
      "text": "而是像一个清醒的王子光一样，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 764140,
      "end_ms": 768575,
      "text": "在最肮脏的街上依然保留一份向光而行的本能，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 769010,
      "end_ms": 772620,
      "text": "毕竟能在一条被死鱼和粪便覆盖的街上，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 772800,
      "end_ms": 774560,
      "text": "把每一天过得热气腾腾，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 774640,
      "end_ms": 775785,
      "text": "活得有滋有味，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 776100,
      "end_ms": 778385,
      "text": "这本身就是一种极高明的智慧。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 778810,
      "end_ms": 781315,
      "text": "这本残血的作品集就在下面的链接里，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 781630,
      "end_ms": 784425,
      "text": "如果你也想看看自己的黄泥街到底长什么样，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 784730,
      "end_ms": 785725,
      "text": "不妨把他带回家。"
    },
    {
      "segment_id": "s000370",
      "start_ms": 786010,
      "end_ms": 786710,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 786830,
      "end_ms": 788030,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 788030,
      "end_ms": 788655,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "68778092828b81a5d15d0fa21d6763db71e8dac33fe2c04cfadd0f4f2aa7880b"
}