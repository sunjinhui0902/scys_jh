{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_4be8e3025bc509bf_u001",
  "video_id": "v_4be8e3025bc509bf",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 483.973991,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 110,
      "end_ms": 3270,
      "text": "你知道故宫最不可思议的秘密是什么吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4090,
      "end_ms": 7450,
      "text": "有人说是九千九百九十九间半房子，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7870,
      "end_ms": 10270,
      "text": "有人说是里面数不清的宝贝。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 11190,
      "end_ms": 11430,
      "text": "错，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 12030,
      "end_ms": 16790,
      "text": "这些连前五都排不进真正排第一的那个秘密。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 17130,
      "end_ms": 18110,
      "text": "二零一二年，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 18150,
      "end_ms": 21170,
      "text": "北京发了六十年一遇的大暴雨，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 21850,
      "end_ms": 23370,
      "text": "全程泡在水里，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 23970,
      "end_ms": 24690,
      "text": "车淹了，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 25410,
      "end_ms": 26490,
      "text": "地铁灌了。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 27230,
      "end_ms": 32860,
      "text": "可六百年的故宫里面干干净净的一滴水没存到底，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 32880,
      "end_ms": 34960,
      "text": "靠的什么没人猜得到。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 36120,
      "end_ms": 38660,
      "text": "咱们从第十个秘密开始倒着讲讲到。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 38660,
      "end_ms": 39200,
      "text": "第一个，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 39240,
      "end_ms": 40280,
      "text": "您自己品品，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 41180,
      "end_ms": 42560,
      "text": "还是咱们的老规矩。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 43360,
      "end_ms": 44120,
      "text": "开讲前，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 44220,
      "end_ms": 46800,
      "text": "劳烦各位老友顺手点亮红心。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 47160,
      "end_ms": 53140,
      "text": "评论区打个来了让我看看今天又有多少知音来捧场，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 53560,
      "end_ms": 57340,
      "text": "第十个秘密开宫里没有厕所，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 57640,
      "end_ms": 58420,
      "text": "您没听错，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 59300,
      "end_ms": 61935,
      "text": "整个故共七十多万平方米，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 62780,
      "end_ms": 66855,
      "text": "九千多间房子一个厕所都没有，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 67950,
      "end_ms": 76545,
      "text": "皇帝妃子太监宫女几千号人住在里面上哪方便呢？"
    },
    {
      "segment_id": "s000025",
      "start_ms": 76780,
      "end_ms": 79240,
      "text": "用便盆宫里管这个叫官房，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 79440,
      "end_ms": 84325,
      "text": "就是一个木头盒子里面铺上炭灰和香料，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 85080,
      "end_ms": 87705,
      "text": "用完太监马上端走处理掉。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 88030,
      "end_ms": 89215,
      "text": "为什么不修厕所？"
    },
    {
      "segment_id": "s000029",
      "start_ms": 90150,
      "end_ms": 90925,
      "text": "两个原因，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 91640,
      "end_ms": 93085,
      "text": "第一怕味道，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 94780,
      "end_ms": 96535,
      "text": "故宫的宫殿挨得很近。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 97000,
      "end_ms": 100580,
      "text": "北京的夏天三十七八度要是修了厕所，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 100580,
      "end_ms": 102785,
      "text": "那味道能挑半个紫禁城。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 103160,
      "end_ms": 103500,
      "text": "第二，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 103960,
      "end_ms": 104740,
      "text": "怕渗漏，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 104820,
      "end_ms": 105775,
      "text": "污染地下水。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 106820,
      "end_ms": 111010,
      "text": "故宫的地下水系是整套设计好的厕所的污水，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 111010,
      "end_ms": 112205,
      "text": "一旦渗进去，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 112980,
      "end_ms": 114295,
      "text": "整个系统就废了。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 114750,
      "end_ms": 116910,
      "text": "所以宁可用最笨的办法认断，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 116990,
      "end_ms": 118355,
      "text": "也不修一个厕所。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 118970,
      "end_ms": 119675,
      "text": "您想想，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 120070,
      "end_ms": 123030,
      "text": "堂堂大清皇帝上厕所也得用便盆，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 123850,
      "end_ms": 126490,
      "text": "太监在门口候着完事儿了，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 126490,
      "end_ms": 130170,
      "text": "端走这排场跟您想的不太一样吧。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 130630,
      "end_ms": 131590,
      "text": "第九个秘密，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 132590,
      "end_ms": 134770,
      "text": "故宫的地砖比黄金还贵。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 135550,
      "end_ms": 138530,
      "text": "故宫太和殿里铺的那种方砖叫金砖，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 139330,
      "end_ms": 140690,
      "text": "可它不是金子砖，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 141590,
      "end_ms": 142910,
      "text": "为什么叫金砖呢？"
    },
    {
      "segment_id": "s000051",
      "start_ms": 143650,
      "end_ms": 145490,
      "text": "因为造价比金子还高，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 146070,
      "end_ms": 153220,
      "text": "这种砖子苏州用的是阳城湖底底下下的泥光选泥就要挑三年，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 153300,
      "end_ms": 156700,
      "text": "挖出来的泥得在露天放一整年让它风化，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 156820,
      "end_ms": 158600,
      "text": "然后泡水里再放一年，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 158780,
      "end_ms": 159500,
      "text": "再晾米，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 159800,
      "end_ms": 163340,
      "text": "三年之后才能泥选好了开始烧，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 164140,
      "end_ms": 166380,
      "text": "再用糠草火熏一个月，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 167000,
      "end_ms": 168900,
      "text": "再用片柴烧一个月，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 169640,
      "end_ms": 171440,
      "text": "接着用颗柴烧一个月，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 171800,
      "end_ms": 174220,
      "text": "最后用松脂烧四十天，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 175240,
      "end_ms": 177520,
      "text": "前后烧制药七百二十天，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 178060,
      "end_ms": 179200,
      "text": "将近两年。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 179320,
      "end_ms": 181050,
      "text": "烧出来的砖敲上去，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 181050,
      "end_ms": 182930,
      "text": "声音跟敲磬一样清脆，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 183530,
      "end_ms": 186530,
      "text": "掰开了里面的纹理跟石头一样细密。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 187050,
      "end_ms": 189750,
      "text": "一块金砖从选泥到出窑，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 189870,
      "end_ms": 193530,
      "text": "要花将近五年每一块的造价，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 193670,
      "end_ms": 198790,
      "text": "在当时折合白银好几两抵得上一个普通人家半年的口粮钱。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 199330,
      "end_ms": 201490,
      "text": "太和殿里铺了四千七百多块，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 202090,
      "end_ms": 204050,
      "text": "光地砖就花了这么多银子，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 204450,
      "end_ms": 207410,
      "text": "您走在上面可能觉得就是块灰色的方砖，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 207910,
      "end_ms": 211720,
      "text": "可能是五年烧出来第八个秘密，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 212640,
      "end_ms": 216640,
      "text": "故宫的房间数不是九千九百九十九间半，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 217600,
      "end_ms": 220340,
      "text": "故宫有九千九百九十九间半，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 220420,
      "end_ms": 221060,
      "text": "这个说法，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 221060,
      "end_ms": 222320,
      "text": "流传了几百年了，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 222680,
      "end_ms": 225480,
      "text": "说是天上的玉皇大帝有一万间房，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 226340,
      "end_ms": 228740,
      "text": "故间的皇帝不敢跟老天比，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 228740,
      "end_ms": 229860,
      "text": "就少了半间，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 230080,
      "end_ms": 231060,
      "text": "以示尊敬。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 232060,
      "end_ms": 234520,
      "text": "故事讲的好故是假的。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 235440,
      "end_ms": 236440,
      "text": "二零一零年，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 236460,
      "end_ms": 238660,
      "text": "故宫博物院做过一次全面测量，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 239080,
      "end_ms": 241275,
      "text": "结果是八千七百零七件，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 241860,
      "end_ms": 243480,
      "text": "既不是九千九百九十九，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 243480,
      "end_ms": 244245,
      "text": "也不是一万，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 244740,
      "end_ms": 246285,
      "text": "就是八千七百零七。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 247290,
      "end_ms": 249225,
      "text": "那个半间的说法怎么来的呢？"
    },
    {
      "segment_id": "s000089",
      "start_ms": 250100,
      "end_ms": 251420,
      "text": "有人说是文渊阁，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 251420,
      "end_ms": 251940,
      "text": "楼梯间，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 251940,
      "end_ms": 255035,
      "text": "只有别的房间一半大算半间。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 255350,
      "end_ms": 256805,
      "text": "可按古建筑的算法，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 257250,
      "end_ms": 259675,
      "text": "肩是两根柱子之间的空间，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 260110,
      "end_ms": 261715,
      "text": "不管大小都算一间，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 262070,
      "end_ms": 263510,
      "text": "没有半间这个说法，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 263630,
      "end_ms": 265690,
      "text": "一个流传了几百年的数字，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 266150,
      "end_ms": 267275,
      "text": "其实是错的。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 267680,
      "end_ms": 271305,
      "text": "可到今天还有导游在讲九千九百九十九间半，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 271900,
      "end_ms": 273020,
      "text": "您下次去了，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 273020,
      "end_ms": 276555,
      "text": "可以纠正他第七个秘密，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 277040,
      "end_ms": 278660,
      "text": "故宫里养了几百只猫。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 278880,
      "end_ms": 280440,
      "text": "您要是去故宫逛过，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 280620,
      "end_ms": 283060,
      "text": "可能见过院子里趴着晒太阳的猫。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 283720,
      "end_ms": 285500,
      "text": "这些猫不是流浪猫，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 285700,
      "end_ms": 289070,
      "text": "是故宫的编制内员工有名字，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 289270,
      "end_ms": 290010,
      "text": "有人位，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 290270,
      "end_ms": 291345,
      "text": "有固定的窝。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 292140,
      "end_ms": 294505,
      "text": "故宫现在常年有两百多只猫，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 295160,
      "end_ms": 296385,
      "text": "工作人员管他们叫。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 296710,
      "end_ms": 300070,
      "text": "故宫猫这些猫从什么时候开始养的呢？"
    },
    {
      "segment_id": "s000111",
      "start_ms": 300810,
      "end_ms": 304150,
      "text": "明朝故宫的建筑大量使用木头，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 304910,
      "end_ms": 308410,
      "text": "最怕的就是老鼠啃木梁被啃了，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 308410,
      "end_ms": 309590,
      "text": "建筑会出问题，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 309930,
      "end_ms": 310990,
      "text": "字画被啃了，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 310990,
      "end_ms": 311930,
      "text": "文物就毁了。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 312470,
      "end_ms": 313710,
      "text": "所以从明朝开始，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 313710,
      "end_ms": 314530,
      "text": "宫里就养猫，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 314530,
      "end_ms": 316890,
      "text": "抓老鼠一养就是六百年。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 317370,
      "end_ms": 319390,
      "text": "现在这些猫虽然不用抓老鼠，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 319710,
      "end_ms": 321610,
      "text": "但故宫方面一直养着，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 321790,
      "end_ms": 324490,
      "text": "每只猫都做了绝育和防疫，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 325010,
      "end_ms": 326315,
      "text": "有专门的猫舍。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 326940,
      "end_ms": 329500,
      "text": "六百年前的猫跟今天的猫当然不是一波。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 329640,
      "end_ms": 331960,
      "text": "可故宫养猫这件事传了六百年，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 331960,
      "end_ms": 333980,
      "text": "没断过故宫里的木头，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 334120,
      "end_ms": 335660,
      "text": "靠猫守了六百年，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 335960,
      "end_ms": 337760,
      "text": "这也算一种文物保护吧。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 338780,
      "end_ms": 339720,
      "text": "第六个秘密，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 340720,
      "end_ms": 342420,
      "text": "故宫的角楼没有图纸，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 342739,
      "end_ms": 345360,
      "text": "故宫四个角上各有一座一角，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 345840,
      "end_ms": 349420,
      "text": "三重岩七十二条戟二十八个一角。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 350220,
      "end_ms": 351460,
      "text": "从哪个方向看，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 351680,
      "end_ms": 354340,
      "text": "都是对称的、精美的，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 354340,
      "end_ms": 355080,
      "text": "不像征的。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 355080,
      "end_ms": 359175,
      "text": "可这座楼的设计图纸到底是谁画的？"
    },
    {
      "segment_id": "s000136",
      "start_ms": 359680,
      "end_ms": 360805,
      "text": "至今是个谜。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 361820,
      "end_ms": 363235,
      "text": "民间传说是这样，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 364150,
      "end_ms": 365650,
      "text": "当年修故宫的时候，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 365650,
      "end_ms": 368350,
      "text": "工匠们怎么都设计不出角楼的样子，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 368350,
      "end_ms": 369245,
      "text": "急得要命。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 370530,
      "end_ms": 371090,
      "text": "有一天，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 371110,
      "end_ms": 375435,
      "text": "一个老木匠在街上看到一个卖蝈蝈笼的老头，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 376220,
      "end_ms": 379155,
      "text": "那蝈蝈龙的结构上下穿插，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 379630,
      "end_ms": 380695,
      "text": "层层叠叠，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 381540,
      "end_ms": 382955,
      "text": "他拿回去一琢磨，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 383460,
      "end_ms": 386215,
      "text": "照着郭国荣的原理设计出了角楼。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 386740,
      "end_ms": 387840,
      "text": "这个故事好听，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 388240,
      "end_ms": 389715,
      "text": "可没有史料证实，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 390330,
      "end_ms": 394945,
      "text": "实际情况是故宫的营建档案在明代就丢了大半。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 395770,
      "end_ms": 399015,
      "text": "清代的档案里也没有角楼设计图的记录。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 399500,
      "end_ms": 402435,
      "text": "这么一座结构极其复杂的建筑，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 402850,
      "end_ms": 404575,
      "text": "到底是谁设计的，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 404840,
      "end_ms": 406060,
      "text": "依据什么原理？"
    },
    {
      "segment_id": "s000154",
      "start_ms": 406080,
      "end_ms": 407665,
      "text": "设计的真的说不清楚，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 408310,
      "end_ms": 410550,
      "text": "只知道四座角楼。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 410690,
      "end_ms": 413625,
      "text": "从明朝永乐年间建成到今天，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 414210,
      "end_ms": 415070,
      "text": "六百年了，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 415070,
      "end_ms": 417285,
      "text": "一根木头都没换过主结构，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 417910,
      "end_ms": 421305,
      "text": "一座没有图纸的楼立了六百年。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 422540,
      "end_ms": 424545,
      "text": "今天讲的这五个您品品，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 425450,
      "end_ms": 428535,
      "text": "堂堂皇帝上厕所也得用便盆。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 429550,
      "end_ms": 431430,
      "text": "一块地砖烧五年，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 431450,
      "end_ms": 432725,
      "text": "比黄金还贵，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 433630,
      "end_ms": 436265,
      "text": "流传了几百年的房间数是错的。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 436610,
      "end_ms": 439465,
      "text": "猫在故宫上了六百年的班，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 440140,
      "end_ms": 441180,
      "text": "四座角楼，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 441220,
      "end_ms": 442040,
      "text": "精美绝伦，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 442040,
      "end_ms": 443845,
      "text": "可没人知道是谁设计的。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 444540,
      "end_ms": 450065,
      "text": "可这五个加一块都比不过前五个秘密的最离谱的那一个。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 450880,
      "end_ms": 454385,
      "text": "前五个里有一条河拐了个弯儿，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 455180,
      "end_ms": 456305,
      "text": "不是为了好看，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 457010,
      "end_ms": 458295,
      "text": "是为了防刺客。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 459170,
      "end_ms": 460050,
      "text": "有一面墙，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 460130,
      "end_ms": 462015,
      "text": "里面藏了一个机关，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 462470,
      "end_ms": 463590,
      "text": "皇帝一拍桌子，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 463590,
      "end_ms": 465545,
      "text": "外面的侍卫马上就能听见，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 466460,
      "end_ms": 469080,
      "text": "还有一套排水系统六百年了，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 469080,
      "end_ms": 469760,
      "text": "暴雨来了，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 469760,
      "end_ms": 470655,
      "text": "跟他没关系，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 471420,
      "end_ms": 473305,
      "text": "水从哪儿进就从哪出，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 473820,
      "end_ms": 474645,
      "text": "干干净净，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 475210,
      "end_ms": 478030,
      "text": "下一集已经同步更新了点。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 478030,
      "end_ms": 479650,
      "text": "我头像进主页第一条，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 479670,
      "end_ms": 483865,
      "text": "就是咱们接着接前五个秘密。"
    }
  ],
  "source_transcript_sha256": "01340b1d93006cffbd6c5475b3364c8d8dad52502a578ed4496ba125cd4601e2"
}