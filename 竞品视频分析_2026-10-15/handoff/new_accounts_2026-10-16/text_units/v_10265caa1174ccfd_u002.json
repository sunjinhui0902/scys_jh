{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_10265caa1174ccfd_u002",
  "video_id": "v_10265caa1174ccfd",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 1024.302993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000378",
      "start_ms": 855930,
      "end_ms": 857515,
      "text": "是把你送到他面前，"
    },
    {
      "segment_id": "s000379",
      "start_ms": 857840,
      "end_ms": 858555,
      "text": "然后闭嘴。"
    },
    {
      "segment_id": "s000380",
      "start_ms": 859050,
      "end_ms": 860075,
      "text": "由于平台规则，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 860330,
      "end_ms": 863005,
      "text": "有些细节无法展开哪些细节，"
    },
    {
      "segment_id": "s000382",
      "start_ms": 863430,
      "end_ms": 864830,
      "text": "比如某些历史争论，"
    },
    {
      "segment_id": "s000383",
      "start_ms": 864850,
      "end_ms": 866645,
      "text": "为什么会在某个时间点爆发？"
    },
    {
      "segment_id": "s000384",
      "start_ms": 867170,
      "end_ms": 868010,
      "text": "比如某些概念，"
    },
    {
      "segment_id": "s000385",
      "start_ms": 868010,
      "end_ms": 870065,
      "text": "在原文里差一个字就换了意思。"
    },
    {
      "segment_id": "s000386",
      "start_ms": 870390,
      "end_ms": 872525,
      "text": "比如某些论证的对手到底是谁？"
    },
    {
      "segment_id": "s000387",
      "start_ms": 873020,
      "end_ms": 875935,
      "text": "比如麦格拉斯为什么要在认识论上花那么多篇幅？"
    },
    {
      "segment_id": "s000388",
      "start_ms": 876400,
      "end_ms": 877520,
      "text": "这些东西一旦展开，"
    },
    {
      "segment_id": "s000389",
      "start_ms": 877680,
      "end_ms": 879305,
      "text": "这条内容大概率火不过今晚。"
    },
    {
      "segment_id": "s000390",
      "start_ms": 879540,
      "end_ms": 883040,
      "text": "所以你在屏幕上看到的是删掉三层铺垫，"
    },
    {
      "segment_id": "s000391",
      "start_ms": 883180,
      "end_ms": 884260,
      "text": "砍掉五处例，"
    },
    {
      "segment_id": "s000392",
      "start_ms": 884260,
      "end_ms": 886440,
      "text": "正要开四个不能碰的词之后，"
    },
    {
      "segment_id": "s000393",
      "start_ms": 886720,
      "end_ms": 888305,
      "text": "仍然能留下来的股价。"
    },
    {
      "segment_id": "s000394",
      "start_ms": 888770,
      "end_ms": 890625,
      "text": "真正的血肉在书里，"
    },
    {
      "segment_id": "s000395",
      "start_ms": 891150,
      "end_ms": 892755,
      "text": "平台能限制一段文案，"
    },
    {
      "segment_id": "s000396",
      "start_ms": 893130,
      "end_ms": 894665,
      "text": "限制不了一本书的厚度。"
    },
    {
      "segment_id": "s000397",
      "start_ms": 895150,
      "end_ms": 896445,
      "text": "这本书适合三种人。"
    },
    {
      "segment_id": "s000398",
      "start_ms": 896910,
      "end_ms": 901250,
      "text": "第一种是被科学VS宗教这个伪命题夹在中间的人，"
    },
    {
      "segment_id": "s000399",
      "start_ms": 901250,
      "end_ms": 902410,
      "text": "你既不想盲目性，"
    },
    {
      "segment_id": "s000400",
      "start_ms": 902490,
      "end_ms": 903730,
      "text": "也不想傲慢的否定，"
    },
    {
      "segment_id": "s000401",
      "start_ms": 904070,
      "end_ms": 906225,
      "text": "但你没有语言描述自己的位置，"
    },
    {
      "segment_id": "s000402",
      "start_ms": 906790,
      "end_ms": 908235,
      "text": "这本书给你语言。"
    },
    {
      "segment_id": "s000403",
      "start_ms": 908690,
      "end_ms": 910810,
      "text": "第二种是想训练思维的人。"
    },
    {
      "segment_id": "s000404",
      "start_ms": 911070,
      "end_ms": 912490,
      "text": "你以为神学是教条，"
    },
    {
      "segment_id": "s000405",
      "start_ms": 912890,
      "end_ms": 913930,
      "text": "他其实是论证。"
    },
    {
      "segment_id": "s000406",
      "start_ms": 914230,
      "end_ms": 915730,
      "text": "你以为信仰是跳跃，"
    },
    {
      "segment_id": "s000407",
      "start_ms": 915990,
      "end_ms": 917270,
      "text": "他其实是认识论。"
    },
    {
      "segment_id": "s000408",
      "start_ms": 917510,
      "end_ms": 920210,
      "text": "第三种是对思想史好奇的人。"
    },
    {
      "segment_id": "s000409",
      "start_ms": 920510,
      "end_ms": 927150,
      "text": "你想知道人类两千年里最聪明的头脑如何在一个无法被实验证明的问题上反复推演，"
    },
    {
      "segment_id": "s000410",
      "start_ms": 927330,
      "end_ms": 930130,
      "text": "争论修正这本书给你地图，"
    },
    {
      "segment_id": "s000411",
      "start_ms": 931030,
      "end_ms": 932230,
      "text": "它不适合三种人，"
    },
    {
      "segment_id": "s000412",
      "start_ms": 932890,
      "end_ms": 934990,
      "text": "想找简单答案的人别读。"
    },
    {
      "segment_id": "s000413",
      "start_ms": 935670,
      "end_ms": 938075,
      "text": "想找战队材料的人别读，"
    },
    {
      "segment_id": "s000414",
      "start_ms": 938560,
      "end_ms": 940460,
      "text": "想找心灵鸡汤的人别读，"
    },
    {
      "segment_id": "s000415",
      "start_ms": 940640,
      "end_ms": 941840,
      "text": "他不负责安慰你，"
    },
    {
      "segment_id": "s000416",
      "start_ms": 942020,
      "end_ms": 943280,
      "text": "他负责让你不舒服，"
    },
    {
      "segment_id": "s000417",
      "start_ms": 944600,
      "end_ms": 945560,
      "text": "他不会告诉你，"
    },
    {
      "segment_id": "s000418",
      "start_ms": 945620,
      "end_ms": 947760,
      "text": "信就对了也不会告诉你，"
    },
    {
      "segment_id": "s000419",
      "start_ms": 947860,
      "end_ms": 949080,
      "text": "不信就清醒了。"
    },
    {
      "segment_id": "s000420",
      "start_ms": 949500,
      "end_ms": 950880,
      "text": "他会把你的问题拆开，"
    },
    {
      "segment_id": "s000421",
      "start_ms": 951180,
      "end_ms": 951800,
      "text": "让你看见，"
    },
    {
      "segment_id": "s000422",
      "start_ms": 951800,
      "end_ms": 955060,
      "text": "里面还有多少你从未问过的问题怎么读？"
    },
    {
      "segment_id": "s000423",
      "start_ms": 955980,
      "end_ms": 957580,
      "text": "不要从头到尾跪着读，"
    },
    {
      "segment_id": "s000424",
      "start_ms": 957820,
      "end_ms": 959740,
      "text": "也不要从头到尾审判着读，"
    },
    {
      "segment_id": "s000425",
      "start_ms": 959820,
      "end_ms": 960460,
      "text": "带一支笔，"
    },
    {
      "segment_id": "s000426",
      "start_ms": 960980,
      "end_ms": 963080,
      "text": "先读认识论部分问自己，"
    },
    {
      "segment_id": "s000427",
      "start_ms": 963340,
      "end_ms": 967600,
      "text": "我凭什么相信我每天相信的东西再读历史部分问自己，"
    },
    {
      "segment_id": "s000428",
      "start_ms": 967600,
      "end_ms": 971485,
      "text": "不些我已以为早就盖棺定论的事真的定论了吗？"
    },
    {
      "segment_id": "s000429",
      "start_ms": 972030,
      "end_ms": 972410,
      "text": "最后，"
    },
    {
      "segment_id": "s000430",
      "start_ms": 972410,
      "end_ms": 973995,
      "text": "读方法部分问自己，"
    },
    {
      "segment_id": "s000431",
      "start_ms": 974490,
      "end_ms": 978365,
      "text": "我能不能在不确定中仍然做出负责任的判断。"
    },
    {
      "segment_id": "s000432",
      "start_ms": 978950,
      "end_ms": 981545,
      "text": "如果只打算从这条内容里带走一个动作，"
    },
    {
      "segment_id": "s000433",
      "start_ms": 981880,
      "end_ms": 984330,
      "text": "我希望是去找这本书来读。"
    },
    {
      "segment_id": "s000434",
      "start_ms": 984470,
      "end_ms": 985295,
      "text": "不是点赞，"
    },
    {
      "segment_id": "s000435",
      "start_ms": 985550,
      "end_ms": 986265,
      "text": "不是收藏，"
    },
    {
      "segment_id": "s000436",
      "start_ms": 986670,
      "end_ms": 987345,
      "text": "是毒。"
    },
    {
      "segment_id": "s000437",
      "start_ms": 987970,
      "end_ms": 988995,
      "text": "不是读我的文案，"
    },
    {
      "segment_id": "s000438",
      "start_ms": 989440,
      "end_ms": 990535,
      "text": "是读麦格拉斯。"
    },
    {
      "segment_id": "s000439",
      "start_ms": 991210,
      "end_ms": 993535,
      "text": "不是读结论是读论证，"
    },
    {
      "segment_id": "s000440",
      "start_ms": 993930,
      "end_ms": 995105,
      "text": "不是赌谁赢了，"
    },
    {
      "segment_id": "s000441",
      "start_ms": 995420,
      "end_ms": 1000050,
      "text": "是读他们怎么炒的平台能删掉一段文案删不掉。"
    },
    {
      "segment_id": "s000442",
      "start_ms": 1000050,
      "end_ms": 1001725,
      "text": "你翻开书之后的那几个小时，"
    },
    {
      "segment_id": "s000443",
      "start_ms": 1001980,
      "end_ms": 1006365,
      "text": "你们看的这个版本已经是第五版前四版死在草稿箱里。"
    },
    {
      "segment_id": "s000444",
      "start_ms": 1006940,
      "end_ms": 1008140,
      "text": "这一版能活下来，"
    },
    {
      "segment_id": "s000445",
      "start_ms": 1008260,
      "end_ms": 1009340,
      "text": "是因为他学会了，"
    },
    {
      "segment_id": "s000446",
      "start_ms": 1009340,
      "end_ms": 1010345,
      "text": "不说太多，"
    },
    {
      "segment_id": "s000447",
      "start_ms": 1010900,
      "end_ms": 1013335,
      "text": "但书不会书里什么都说了，"
    },
    {
      "segment_id": "s000448",
      "start_ms": 1014000,
      "end_ms": 1015865,
      "text": "剩下的你自己去看，"
    },
    {
      "segment_id": "s000449",
      "start_ms": 1016290,
      "end_ms": 1018845,
      "text": "这才是我把这条文案改了五遍，"
    },
    {
      "segment_id": "s000450",
      "start_ms": 1019130,
      "end_ms": 1021065,
      "text": "仍然要把他推到你面前的原因。"
    },
    {
      "segment_id": "s000451",
      "start_ms": 1021290,
      "end_ms": 1022005,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000452",
      "start_ms": 1022350,
      "end_ms": 1024185,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "f927b5bcf4fde102127cd3c10ae1ffb1c14ac831528177a4d8f98ef766e4756c"
}