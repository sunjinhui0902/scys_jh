{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_7bc646162220f8e7_u002",
  "video_id": "v_7bc646162220f8e7",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 941.082993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000369",
      "start_ms": 832510,
      "end_ms": 835145,
      "text": "第三种是对思想史好奇的人。"
    },
    {
      "segment_id": "s000370",
      "start_ms": 835340,
      "end_ms": 838225,
      "text": "你想知道一个经历过喂玛崩溃的犹太学者，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 838500,
      "end_ms": 842585,
      "text": "如何在柏拉图的文本里找到理解二十世纪政治灾难的钥匙？"
    },
    {
      "segment_id": "s000372",
      "start_ms": 843120,
      "end_ms": 844205,
      "text": "他不适合三种人，"
    },
    {
      "segment_id": "s000373",
      "start_ms": 844730,
      "end_ms": 846630,
      "text": "想找柏拉图到底说了什么的。"
    },
    {
      "segment_id": "s000374",
      "start_ms": 846630,
      "end_ms": 848635,
      "text": "标准答案的人别赌，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 849060,
      "end_ms": 851060,
      "text": "想找战队材料的人别读，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 851500,
      "end_ms": 853340,
      "text": "想找心灵鸡汤的人别读，"
    },
    {
      "segment_id": "s000377",
      "start_ms": 853500,
      "end_ms": 854660,
      "text": "他不负责安慰你，"
    },
    {
      "segment_id": "s000378",
      "start_ms": 854840,
      "end_ms": 856100,
      "text": "他负责让你不舒服。"
    },
    {
      "segment_id": "s000379",
      "start_ms": 857020,
      "end_ms": 858020,
      "text": "他不会告诉你，"
    },
    {
      "segment_id": "s000380",
      "start_ms": 858020,
      "end_ms": 859440,
      "text": "哲学应该介入政治，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 859660,
      "end_ms": 862140,
      "text": "也不会告诉你哲学应该远离政治。"
    },
    {
      "segment_id": "s000382",
      "start_ms": 862200,
      "end_ms": 863520,
      "text": "他会把你的问题拆开，"
    },
    {
      "segment_id": "s000383",
      "start_ms": 863880,
      "end_ms": 864480,
      "text": "让你看见，"
    },
    {
      "segment_id": "s000384",
      "start_ms": 864480,
      "end_ms": 867400,
      "text": "里面还有多少你从未问过的问题怎么读？"
    },
    {
      "segment_id": "s000385",
      "start_ms": 868040,
      "end_ms": 869620,
      "text": "不要从头到尾跪着读，"
    },
    {
      "segment_id": "s000386",
      "start_ms": 869760,
      "end_ms": 871660,
      "text": "也不要从头到尾审判着读，"
    },
    {
      "segment_id": "s000387",
      "start_ms": 871940,
      "end_ms": 872600,
      "text": "带一支笔。"
    },
    {
      "segment_id": "s000388",
      "start_ms": 873280,
      "end_ms": 876860,
      "text": "先读施特劳斯对王治第一卷的解读问自己，"
    },
    {
      "segment_id": "s000389",
      "start_ms": 876920,
      "end_ms": 880670,
      "text": "我凭什么认为苏格拉底对拉旭马霍斯的反驳是成立的？"
    },
    {
      "segment_id": "s000390",
      "start_ms": 880730,
      "end_ms": 882650,
      "text": "带读他对共产制讨论的分析，"
    },
    {
      "segment_id": "s000391",
      "start_ms": 882810,
      "end_ms": 883430,
      "text": "问自己，"
    },
    {
      "segment_id": "s000392",
      "start_ms": 883610,
      "end_ms": 887450,
      "text": "那些我以为早就盖棺定论的政治理想真的定论了吗？"
    },
    {
      "segment_id": "s000393",
      "start_ms": 887470,
      "end_ms": 887810,
      "text": "最后，"
    },
    {
      "segment_id": "s000394",
      "start_ms": 887810,
      "end_ms": 889590,
      "text": "读他对哲学本性的讨论，"
    },
    {
      "segment_id": "s000395",
      "start_ms": 889730,
      "end_ms": 890310,
      "text": "问自己，"
    },
    {
      "segment_id": "s000396",
      "start_ms": 890530,
      "end_ms": 894930,
      "text": "我能不能在追问和行动之间找到一种得体的生活方式？"
    },
    {
      "segment_id": "s000397",
      "start_ms": 895069,
      "end_ms": 897390,
      "text": "如果只打算从这条内容里带走一个动作，"
    },
    {
      "segment_id": "s000398",
      "start_ms": 897510,
      "end_ms": 899730,
      "text": "我希望是去找这本书来读。"
    },
    {
      "segment_id": "s000399",
      "start_ms": 899830,
      "end_ms": 900510,
      "text": "不是点赞，"
    },
    {
      "segment_id": "s000400",
      "start_ms": 900810,
      "end_ms": 901470,
      "text": "不是收藏，"
    },
    {
      "segment_id": "s000401",
      "start_ms": 901870,
      "end_ms": 903450,
      "text": "是读不是读。"
    },
    {
      "segment_id": "s000402",
      "start_ms": 903450,
      "end_ms": 906450,
      "text": "我的文案是读施特劳斯讲书原文，"
    },
    {
      "segment_id": "s000403",
      "start_ms": 906870,
      "end_ms": 907770,
      "text": "不是读结论，"
    },
    {
      "segment_id": "s000404",
      "start_ms": 908230,
      "end_ms": 911780,
      "text": "我读阅读的方法不是读谁赢了试读，"
    },
    {
      "segment_id": "s000405",
      "start_ms": 911940,
      "end_ms": 915940,
      "text": "他怎么读平台能删掉一段文案删不掉。"
    },
    {
      "segment_id": "s000406",
      "start_ms": 915940,
      "end_ms": 917885,
      "text": "你翻开书之后的那十五讲，"
    },
    {
      "segment_id": "s000407",
      "start_ms": 918250,
      "end_ms": 922515,
      "text": "你们看的这个版本已经是第五版前四版死在草稿箱里。"
    },
    {
      "segment_id": "s000408",
      "start_ms": 922920,
      "end_ms": 924100,
      "text": "这一版能活下来，"
    },
    {
      "segment_id": "s000409",
      "start_ms": 924280,
      "end_ms": 926275,
      "text": "是因为他学会了不说太多。"
    },
    {
      "segment_id": "s000410",
      "start_ms": 926930,
      "end_ms": 930405,
      "text": "但书不会书里什么都说了，"
    },
    {
      "segment_id": "s000411",
      "start_ms": 931020,
      "end_ms": 932995,
      "text": "剩下的你自己去看，"
    },
    {
      "segment_id": "s000412",
      "start_ms": 933380,
      "end_ms": 935775,
      "text": "这才是我把这条文案改了五遍，"
    },
    {
      "segment_id": "s000413",
      "start_ms": 936130,
      "end_ms": 938095,
      "text": "仍然要把它推到你面前的原因。"
    },
    {
      "segment_id": "s000414",
      "start_ms": 938370,
      "end_ms": 939010,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000415",
      "start_ms": 939130,
      "end_ms": 940955,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "c03d78f7f01cf3491053e1ae89979838308be167a15030cef950cee28479621e"
}