{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_73fe295c18ecf289_u002",
  "video_id": "v_73fe295c18ecf289",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 1226.689002,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000385",
      "start_ms": 832600,
      "end_ms": 834955,
      "text": "有学者专门研究过这部小说的叙述法，"
    },
    {
      "segment_id": "s000386",
      "start_ms": 835290,
      "end_ms": 842730,
      "text": "认为残血的叙述者总是一个完全缺少历史性和个性的、无私无情的、纯粹的内部世界。"
    },
    {
      "segment_id": "s000387",
      "start_ms": 842730,
      "end_ms": 846100,
      "text": "观察者这种观察者和被观察的自我对象，"
    },
    {
      "segment_id": "s000388",
      "start_ms": 846160,
      "end_ms": 848820,
      "text": "正像我们做梦时那样是彻底分开的。"
    },
    {
      "segment_id": "s000389",
      "start_ms": 848920,
      "end_ms": 853205,
      "text": "残雪通过创造这种观察者和观察对象之间的惊人距离，"
    },
    {
      "segment_id": "s000390",
      "start_ms": 853510,
      "end_ms": 856515,
      "text": "在给读者留下做梦似的不可思议感的同时，"
    },
    {
      "segment_id": "s000391",
      "start_ms": 856880,
      "end_ms": 858835,
      "text": "留下了对自我的观察记录。"
    },
    {
      "segment_id": "s000392",
      "start_ms": 859190,
      "end_ms": 859810,
      "text": "换句话说，"
    },
    {
      "segment_id": "s000393",
      "start_ms": 860050,
      "end_ms": 861505,
      "text": "他不是在讲故事，"
    },
    {
      "segment_id": "s000394",
      "start_ms": 861850,
      "end_ms": 864405,
      "text": "他是在用文字营造一种梦境体验。"
    },
    {
      "segment_id": "s000395",
      "start_ms": 864800,
      "end_ms": 866995,
      "text": "你读着读着会产生一种恍惚感，"
    },
    {
      "segment_id": "s000396",
      "start_ms": 867360,
      "end_ms": 869105,
      "text": "分不清哪些是真实发生的，"
    },
    {
      "segment_id": "s000397",
      "start_ms": 869350,
      "end_ms": 870630,
      "text": "哪些是某个人的幻觉，"
    },
    {
      "segment_id": "s000398",
      "start_ms": 870810,
      "end_ms": 872175,
      "text": "哪些是作者的叙述。"
    },
    {
      "segment_id": "s000399",
      "start_ms": 872650,
      "end_ms": 874995,
      "text": "这种阅读体验本身就是一种黄泥街。"
    },
    {
      "segment_id": "s000400",
      "start_ms": 875690,
      "end_ms": 877045,
      "text": "你会像街上的人一样，"
    },
    {
      "segment_id": "s000401",
      "start_ms": 877260,
      "end_ms": 879005,
      "text": "在真假之间失去判断，"
    },
    {
      "segment_id": "s000402",
      "start_ms": 879280,
      "end_ms": 881640,
      "text": "在确定与不确定之间反复摇摆。"
    },
    {
      "segment_id": "s000403",
      "start_ms": 881700,
      "end_ms": 882240,
      "text": "有评论，"
    },
    {
      "segment_id": "s000404",
      "start_ms": 882300,
      "end_ms": 885105,
      "text": "将这种风格称为黑暗灵魂的舞蹈，"
    },
    {
      "segment_id": "s000405",
      "start_ms": 885620,
      "end_ms": 888215,
      "text": "还有一个很重要的维度是关于出路的。"
    },
    {
      "segment_id": "s000406",
      "start_ms": 888510,
      "end_ms": 890945,
      "text": "黄泥坚并没有给读者一个温暖的结局，"
    },
    {
      "segment_id": "s000407",
      "start_ms": 891350,
      "end_ms": 893050,
      "text": "没有英雄人物横空出世，"
    },
    {
      "segment_id": "s000408",
      "start_ms": 893070,
      "end_ms": 893775,
      "text": "打破黑暗，"
    },
    {
      "segment_id": "s000409",
      "start_ms": 894180,
      "end_ms": 896975,
      "text": "也没有一个明确的出路在故事尽头等待。"
    },
    {
      "segment_id": "s000410",
      "start_ms": 897330,
      "end_ms": 899875,
      "text": "但它的价值恰恰在于这种诚实，"
    },
    {
      "segment_id": "s000411",
      "start_ms": 900630,
      "end_ms": 901995,
      "text": "他不给你廉价的希望，"
    },
    {
      "segment_id": "s000412",
      "start_ms": 902300,
      "end_ms": 905060,
      "text": "而是把困境原原本本的摆在你面前，"
    },
    {
      "segment_id": "s000413",
      "start_ms": 905240,
      "end_ms": 906420,
      "text": "让你自己去决定。"
    },
    {
      "segment_id": "s000414",
      "start_ms": 906720,
      "end_ms": 909755,
      "text": "是像黄泥街上大多数人那样继续自欺下去，"
    },
    {
      "segment_id": "s000415",
      "start_ms": 910090,
      "end_ms": 911505,
      "text": "还是在看清一切之后。"
    },
    {
      "segment_id": "s000416",
      "start_ms": 911810,
      "end_ms": 913190,
      "text": "仍然选择向前走。"
    },
    {
      "segment_id": "s000417",
      "start_ms": 913210,
      "end_ms": 915270,
      "text": "有学者从存在主义的角度分析，"
    },
    {
      "segment_id": "s000418",
      "start_ms": 915270,
      "end_ms": 916530,
      "text": "这部作品指出，"
    },
    {
      "segment_id": "s000419",
      "start_ms": 916750,
      "end_ms": 920550,
      "text": "残雪通过荒诞叙事展现了现实社会的精神危机，"
    },
    {
      "segment_id": "s000420",
      "start_ms": 920870,
      "end_ms": 924130,
      "text": "同时探讨了人性在极端环境中的自我超越。"
    },
    {
      "segment_id": "s000421",
      "start_ms": 925090,
      "end_ms": 926590,
      "text": "书中那些死亡的描写，"
    },
    {
      "segment_id": "s000422",
      "start_ms": 926830,
      "end_ms": 928510,
      "text": "吞玻璃饮食过度，"
    },
    {
      "segment_id": "s000423",
      "start_ms": 928750,
      "end_ms": 929650,
      "text": "看似荒诞，"
    },
    {
      "segment_id": "s000424",
      "start_ms": 930330,
      "end_ms": 931990,
      "text": "但如果放到隐喻的层面看，"
    },
    {
      "segment_id": "s000425",
      "start_ms": 932250,
      "end_ms": 934910,
      "text": "每一种死法都对应着一种精神状态。"
    },
    {
      "segment_id": "s000426",
      "start_ms": 935090,
      "end_ms": 938630,
      "text": "吞玻璃是一种以伤害自身来对抗环境的方式。"
    },
    {
      "segment_id": "s000427",
      "start_ms": 938990,
      "end_ms": 943420,
      "text": "饮食过度是一种用虚假的满足来填补精神空洞的方式，"
    },
    {
      "segment_id": "s000428",
      "start_ms": 943620,
      "end_ms": 944920,
      "text": "这些不是随便写的。"
    },
    {
      "segment_id": "s000429",
      "start_ms": 945140,
      "end_ms": 947860,
      "text": "残雪在每一个荒诞的细节里都藏了暗示。"
    },
    {
      "segment_id": "s000430",
      "start_ms": 948360,
      "end_ms": 949600,
      "text": "从文学史的角度看，"
    },
    {
      "segment_id": "s000431",
      "start_ms": 949739,
      "end_ms": 951980,
      "text": "黄泥街的意义也需要被认真对待。"
    },
    {
      "segment_id": "s000432",
      "start_ms": 952300,
      "end_ms": 953780,
      "text": "他发表于一九八六年，"
    },
    {
      "segment_id": "s000433",
      "start_ms": 954040,
      "end_ms": 956760,
      "text": "当时中国文坛正处于先锋文学的爆发期。"
    },
    {
      "segment_id": "s000434",
      "start_ms": 957200,
      "end_ms": 965020,
      "text": "残雪以这部处女作和同时期的马原余华格飞等人一起打破了传统现实主义写作的既定框架。"
    },
    {
      "segment_id": "s000435",
      "start_ms": 965160,
      "end_ms": 965980,
      "text": "有学者指出，"
    },
    {
      "segment_id": "s000436",
      "start_ms": 966200,
      "end_ms": 970660,
      "text": "残雪的小说始终以主观叙事来处理空洞错乱的日常事件。"
    },
    {
      "segment_id": "s000437",
      "start_ms": 970720,
      "end_ms": 973250,
      "text": "黄泥街描述了一个意识形态化的社群，"
    },
    {
      "segment_id": "s000438",
      "start_ms": 973290,
      "end_ms": 976230,
      "text": "如何生存于华丽而虚拟的主流话语中，"
    },
    {
      "segment_id": "s000439",
      "start_ms": 976470,
      "end_ms": 977670,
      "text": "在反讽的向度上，"
    },
    {
      "segment_id": "s000440",
      "start_ms": 977670,
      "end_ms": 980595,
      "text": "有力的揭示了宏大话语与现实的错位，"
    },
    {
      "segment_id": "s000441",
      "start_ms": 980950,
      "end_ms": 983510,
      "text": "从而凸显了个人与群体的交往困境。"
    },
    {
      "segment_id": "s000442",
      "start_ms": 983630,
      "end_ms": 984390,
      "text": "这也就是说，"
    },
    {
      "segment_id": "s000443",
      "start_ms": 984710,
      "end_ms": 986495,
      "text": "残雪不是不关心现实，"
    },
    {
      "segment_id": "s000444",
      "start_ms": 986880,
      "end_ms": 990720,
      "text": "而是用一种比现实主义更现实的方式在关心现实。"
    },
    {
      "segment_id": "s000445",
      "start_ms": 990880,
      "end_ms": 991900,
      "text": "传统的现实主义，"
    },
    {
      "segment_id": "s000446",
      "start_ms": 991900,
      "end_ms": 994485,
      "text": "把现实当成可以直接呈现的东西。"
    },
    {
      "segment_id": "s000447",
      "start_ms": 994900,
      "end_ms": 995760,
      "text": "但残雪认为，"
    },
    {
      "segment_id": "s000448",
      "start_ms": 996000,
      "end_ms": 1000675,
      "text": "真正的现实是被话语、意识形态集体无意识、层层包裹的。"
    },
    {
      "segment_id": "s000449",
      "start_ms": 1001220,
      "end_ms": 1002700,
      "text": "你要拨开这些包裹，"
    },
    {
      "segment_id": "s000450",
      "start_ms": 1002860,
      "end_ms": 1004240,
      "text": "才能看到底下的东西。"
    },
    {
      "segment_id": "s000451",
      "start_ms": 1004380,
      "end_ms": 1005040,
      "text": "这就解释了，"
    },
    {
      "segment_id": "s000452",
      "start_ms": 1005040,
      "end_ms": 1006955,
      "text": "为什么黄泥街读起来那么荒诞，"
    },
    {
      "segment_id": "s000453",
      "start_ms": 1007190,
      "end_ms": 1008090,
      "text": "但你仔细一想，"
    },
    {
      "segment_id": "s000454",
      "start_ms": 1008170,
      "end_ms": 1009150,
      "text": "又觉得那么真实。"
    },
    {
      "segment_id": "s000455",
      "start_ms": 1009490,
      "end_ms": 1010930,
      "text": "再说一个容易被忽略的点，"
    },
    {
      "segment_id": "s000456",
      "start_ms": 1010950,
      "end_ms": 1013005,
      "text": "就是黄泥街上的人际关系。"
    },
    {
      "segment_id": "s000457",
      "start_ms": 1013300,
      "end_ms": 1014340,
      "text": "有评论者分析过，"
    },
    {
      "segment_id": "s000458",
      "start_ms": 1014620,
      "end_ms": 1017415,
      "text": "残血笔下人性的丑陋呈现一种梯度，"
    },
    {
      "segment_id": "s000459",
      "start_ms": 1017780,
      "end_ms": 1020400,
      "text": "首先是普通人之间的相互窥视和敌意，"
    },
    {
      "segment_id": "s000460",
      "start_ms": 1020700,
      "end_ms": 1023315,
      "text": "其次是亲人之间的猜忌和背叛。"
    },
    {
      "segment_id": "s000461",
      "start_ms": 1023740,
      "end_ms": 1026280,
      "text": "最后是个体对自我的深刻怀疑，"
    },
    {
      "segment_id": "s000462",
      "start_ms": 1026280,
      "end_ms": 1029995,
      "text": "甚至否定这个梯度在黄泥阶里体现的淋漓尽致。"
    },
    {
      "segment_id": "s000463",
      "start_ms": 1030460,
      "end_ms": 1031980,
      "text": "邻里之间因为活得不舒服，"
    },
    {
      "segment_id": "s000464",
      "start_ms": 1031980,
      "end_ms": 1032860,
      "text": "就相互骂仗，"
    },
    {
      "segment_id": "s000465",
      "start_ms": 1032980,
      "end_ms": 1034875,
      "text": "隔着马路隔着黄水对骂。"
    },
    {
      "segment_id": "s000466",
      "start_ms": 1035110,
      "end_ms": 1037490,
      "text": "胡三老头的女儿对父亲的态度恶劣。"
    },
    {
      "segment_id": "s000467",
      "start_ms": 1037490,
      "end_ms": 1038250,
      "text": "到了极点，"
    },
    {
      "segment_id": "s000468",
      "start_ms": 1038350,
      "end_ms": 1039750,
      "text": "人们在背后议论别人，"
    },
    {
      "segment_id": "s000469",
      "start_ms": 1039790,
      "end_ms": 1041050,
      "text": "当面又装作客气。"
    },
    {
      "segment_id": "s000470",
      "start_ms": 1041150,
      "end_ms": 1042910,
      "text": "每个人都在窥探别人的生活，"
    },
    {
      "segment_id": "s000471",
      "start_ms": 1043150,
      "end_ms": 1044690,
      "text": "同时又害怕自己的生活，"
    },
    {
      "segment_id": "s000472",
      "start_ms": 1044690,
      "end_ms": 1047250,
      "text": "被别人窥探这种关系的模式。"
    },
    {
      "segment_id": "s000473",
      "start_ms": 1047530,
      "end_ms": 1049755,
      "text": "表面上看是道德品质的问题，"
    },
    {
      "segment_id": "s000474",
      "start_ms": 1050030,
      "end_ms": 1051200,
      "text": "但本质上当。"
    },
    {
      "segment_id": "s000475",
      "start_ms": 1051200,
      "end_ms": 1054025,
      "text": "一个人连自己的基本生存都感到吃力的时候，"
    },
    {
      "segment_id": "s000476",
      "start_ms": 1054330,
      "end_ms": 1056010,
      "text": "他对别人的善意是奢侈的，"
    },
    {
      "segment_id": "s000477",
      "start_ms": 1056190,
      "end_ms": 1057365,
      "text": "信任是危险的。"
    },
    {
      "segment_id": "s000478",
      "start_ms": 1058130,
      "end_ms": 1060355,
      "text": "黄泥街上人和人之间的敌意，"
    },
    {
      "segment_id": "s000479",
      "start_ms": 1060660,
      "end_ms": 1062115,
      "text": "不是因为他们是坏人，"
    },
    {
      "segment_id": "s000480",
      "start_ms": 1062370,
      "end_ms": 1064935,
      "text": "而是因为他们是穷途末路的人。"
    },
    {
      "segment_id": "s000481",
      "start_ms": 1065400,
      "end_ms": 1067655,
      "text": "那这本书对今天的读者意味着什么？"
    },
    {
      "segment_id": "s000482",
      "start_ms": 1068240,
      "end_ms": 1071645,
      "text": "也许最重要的提醒不是关于某个特定的历史时期，"
    },
    {
      "segment_id": "s000483",
      "start_ms": 1072190,
      "end_ms": 1074950,
      "text": "而是关于被环境困住这件事儿。"
    },
    {
      "segment_id": "s000484",
      "start_ms": 1074950,
      "end_ms": 1078520,
      "text": "本身每个人一生中都有可能经历某种黄泥街，"
    },
    {
      "segment_id": "s000485",
      "start_ms": 1078520,
      "end_ms": 1081810,
      "text": "时刻处在一个让你觉得窒息的环境里，"
    },
    {
      "segment_id": "s000486",
      "start_ms": 1082010,
      "end_ms": 1085730,
      "text": "做着让你觉得没有意义的事情和让你觉得疲惫的人打交道。"
    },
    {
      "segment_id": "s000487",
      "start_ms": 1085810,
      "end_ms": 1088255,
      "text": "但你就是找不到离开的理由和勇气，"
    },
    {
      "segment_id": "s000488",
      "start_ms": 1088640,
      "end_ms": 1090000,
      "text": "可能是经济上的依赖，"
    },
    {
      "segment_id": "s000489",
      "start_ms": 1090280,
      "end_ms": 1091755,
      "text": "可能是情感上的牵绊，"
    },
    {
      "segment_id": "s000490",
      "start_ms": 1092510,
      "end_ms": 1093925,
      "text": "可能是对未知的恐惧，"
    },
    {
      "segment_id": "s000491",
      "start_ms": 1094290,
      "end_ms": 1095795,
      "text": "也可能是最简单的原因。"
    },
    {
      "segment_id": "s000492",
      "start_ms": 1096130,
      "end_ms": 1097105,
      "text": "你已经习惯了，"
    },
    {
      "segment_id": "s000493",
      "start_ms": 1097300,
      "end_ms": 1098060,
      "text": "习惯了到，"
    },
    {
      "segment_id": "s000494",
      "start_ms": 1098060,
      "end_ms": 1099300,
      "text": "即使有机会改变，"
    },
    {
      "segment_id": "s000495",
      "start_ms": 1099360,
      "end_ms": 1101055,
      "text": "也不相信改变是可能的。"
    },
    {
      "segment_id": "s000496",
      "start_ms": 1101590,
      "end_ms": 1102550,
      "text": "黄泥街上的人，"
    },
    {
      "segment_id": "s000497",
      "start_ms": 1102570,
      "end_ms": 1103945,
      "text": "虽然生活条件艰苦，"
    },
    {
      "segment_id": "s000498",
      "start_ms": 1104270,
      "end_ms": 1105910,
      "text": "却没有一个人想走出这里。"
    },
    {
      "segment_id": "s000499",
      "start_ms": 1105910,
      "end_ms": 1107175,
      "text": "有人可能曾经想过，"
    },
    {
      "segment_id": "s000500",
      "start_ms": 1107520,
      "end_ms": 1108680,
      "text": "但发现根本走不出去，"
    },
    {
      "segment_id": "s000501",
      "start_ms": 1108960,
      "end_ms": 1110185,
      "text": "于是选择了放弃。"
    },
    {
      "segment_id": "s000502",
      "start_ms": 1110480,
      "end_ms": 1113755,
      "text": "这个细节比任何血腥的描写都让人心寒，"
    },
    {
      "segment_id": "s000503",
      "start_ms": 1114170,
      "end_ms": 1116065,
      "text": "不是因为走不出去而绝望，"
    },
    {
      "segment_id": "s000504",
      "start_ms": 1116420,
      "end_ms": 1119845,
      "text": "而是因为放弃了出去的念头而绝望。"
    },
    {
      "segment_id": "s000505",
      "start_ms": 1120190,
      "end_ms": 1122050,
      "text": "如果把黄泥街当做一面镜子，"
    },
    {
      "segment_id": "s000506",
      "start_ms": 1122150,
      "end_ms": 1123585,
      "text": "而不是一份判决书，"
    },
    {
      "segment_id": "s000507",
      "start_ms": 1123940,
      "end_ms": 1124955,
      "text": "也许会好受一些。"
    },
    {
      "segment_id": "s000508",
      "start_ms": 1125550,
      "end_ms": 1127630,
      "text": "他不是来告诉你这个世界有多糟糕，"
    },
    {
      "segment_id": "s000509",
      "start_ms": 1127870,
      "end_ms": 1129195,
      "text": "人性有多阴暗的，"
    },
    {
      "segment_id": "s000510",
      "start_ms": 1130070,
      "end_ms": 1132505,
      "text": "他更像是在你面前摆了一张地图，"
    },
    {
      "segment_id": "s000511",
      "start_ms": 1132950,
      "end_ms": 1133870,
      "text": "上面画着你。"
    },
    {
      "segment_id": "s000512",
      "start_ms": 1133870,
      "end_ms": 1138075,
      "text": "在困境中可能经过的每一条路可能落入的每一个陷阱，"
    },
    {
      "segment_id": "s000513",
      "start_ms": 1138390,
      "end_ms": 1139995,
      "text": "可能做出的每一种选择。"
    },
    {
      "segment_id": "s000514",
      "start_ms": 1140390,
      "end_ms": 1143185,
      "text": "那些曾经以为只有自己才会碰上的绝望感。"
    },
    {
      "segment_id": "s000515",
      "start_ms": 1143510,
      "end_ms": 1145050,
      "text": "其实从有人类文明以来，"
    },
    {
      "segment_id": "s000516",
      "start_ms": 1145350,
      "end_ms": 1146735,
      "text": "无数人都经历过，"
    },
    {
      "segment_id": "s000517",
      "start_ms": 1147170,
      "end_ms": 1152150,
      "text": "只是大多数人从来没有机会系统的审视一下自己在困境中到底发生了什么。"
    },
    {
      "segment_id": "s000518",
      "start_ms": 1152170,
      "end_ms": 1152805,
      "text": "说到底，"
    },
    {
      "segment_id": "s000519",
      "start_ms": 1153120,
      "end_ms": 1153940,
      "text": "人这一辈子，"
    },
    {
      "segment_id": "s000520",
      "start_ms": 1154160,
      "end_ms": 1159760,
      "text": "其实就是不断的和各种环境、各种关系、各种诱惑、各种恐惧、打交道，"
    },
    {
      "segment_id": "s000521",
      "start_ms": 1159940,
      "end_ms": 1161045,
      "text": "逃避是本能，"
    },
    {
      "segment_id": "s000522",
      "start_ms": 1161410,
      "end_ms": 1163330,
      "text": "但能不能在想要逃避的时候，"
    },
    {
      "segment_id": "s000523",
      "start_ms": 1163410,
      "end_ms": 1164595,
      "text": "多给自己几分钟，"
    },
    {
      "segment_id": "s000524",
      "start_ms": 1164970,
      "end_ms": 1166710,
      "text": "看一看自己到底在逃什么，"
    },
    {
      "segment_id": "s000525",
      "start_ms": 1166730,
      "end_ms": 1169245,
      "text": "往哪里逃逃了之后又能怎样。"
    },
    {
      "segment_id": "s000526",
      "start_ms": 1169650,
      "end_ms": 1171505,
      "text": "这是一门需要慢慢练的功课。"
    },
    {
      "segment_id": "s000527",
      "start_ms": 1172140,
      "end_ms": 1173985,
      "text": "每个人心里都有一块黄泥街，"
    },
    {
      "segment_id": "s000528",
      "start_ms": 1174410,
      "end_ms": 1175715,
      "text": "有落不完的黑灰，"
    },
    {
      "segment_id": "s000529",
      "start_ms": 1176200,
      "end_ms": 1177355,
      "text": "扫不干净的垃圾，"
    },
    {
      "segment_id": "s000530",
      "start_ms": 1177850,
      "end_ms": 1178770,
      "text": "卖不掉的烂果。"
    },
    {
      "segment_id": "s000531",
      "start_ms": 1179440,
      "end_ms": 1181750,
      "text": "看到这一点并不意味着完了，"
    },
    {
      "segment_id": "s000532",
      "start_ms": 1181810,
      "end_ms": 1183115,
      "text": "我注定被困在这里，"
    },
    {
      "segment_id": "s000533",
      "start_ms": 1183470,
      "end_ms": 1185425,
      "text": "而是给了自己一个选择的机会。"
    },
    {
      "segment_id": "s000534",
      "start_ms": 1185650,
      "end_ms": 1187715,
      "text": "是继续假装那些垃圾不存在，"
    },
    {
      "segment_id": "s000535",
      "start_ms": 1188050,
      "end_ms": 1189510,
      "text": "还是承认他们的存在，"
    },
    {
      "segment_id": "s000536",
      "start_ms": 1189710,
      "end_ms": 1191505,
      "text": "然后想办法走出去。"
    },
    {
      "segment_id": "s000537",
      "start_ms": 1192190,
      "end_ms": 1197265,
      "text": "愿每一个在生活的泥泞中挣扎前行的人都能慢慢理解一件事儿，"
    },
    {
      "segment_id": "s000538",
      "start_ms": 1198100,
      "end_ms": 1199840,
      "text": "不是只有生活一帆风顺，"
    },
    {
      "segment_id": "s000539",
      "start_ms": 1200140,
      "end_ms": 1203545,
      "text": "从来没有受过伤害的人才配拥有好的日子，"
    },
    {
      "segment_id": "s000540",
      "start_ms": 1204010,
      "end_ms": 1206330,
      "text": "而是那些愿意在黑暗中保持清醒，"
    },
    {
      "segment_id": "s000541",
      "start_ms": 1206610,
      "end_ms": 1209285,
      "text": "在绝望中不肯放弃追问的人，"
    },
    {
      "segment_id": "s000542",
      "start_ms": 1209710,
      "end_ms": 1211535,
      "text": "更容易找到属于自己的出口。"
    },
    {
      "segment_id": "s000543",
      "start_ms": 1211840,
      "end_ms": 1215530,
      "text": "也更容易在这复杂的人世间活的没那么憋屈。"
    },
    {
      "segment_id": "s000544",
      "start_ms": 1215730,
      "end_ms": 1218855,
      "text": "愿我们都有勇气看清那些不愿意看的东西，"
    },
    {
      "segment_id": "s000545",
      "start_ms": 1219200,
      "end_ms": 1223315,
      "text": "也有勇气在看清之后仍然决定继续走下去。"
    },
    {
      "segment_id": "s000546",
      "start_ms": 1223770,
      "end_ms": 1224510,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000547",
      "start_ms": 1224710,
      "end_ms": 1226605,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "9a2ad10e94b829b9c417cd2f841ed4157dbc866dc39d894c2c1499dc1bb5cb26"
}