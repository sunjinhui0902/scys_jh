{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_33f1e4063c99a716_u002",
  "video_id": "v_33f1e4063c99a716",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 926.593991,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000375",
      "start_ms": 860930,
      "end_ms": 864720,
      "text": "而我们必须在失去中重新学会倾听这本书。"
    },
    {
      "segment_id": "s000376",
      "start_ms": 864720,
      "end_ms": 867485,
      "text": "最后有一段话是韩炳哲在结尾写的，"
    },
    {
      "segment_id": "s000377",
      "start_ms": 867830,
      "end_ms": 868905,
      "text": "我想把它留给你。"
    },
    {
      "segment_id": "s000378",
      "start_ms": 869650,
      "end_ms": 871915,
      "text": "真正的看见需要慢下来。"
    },
    {
      "segment_id": "s000379",
      "start_ms": 872400,
      "end_ms": 873320,
      "text": "在巴黎读书时，"
    },
    {
      "segment_id": "s000380",
      "start_ms": 873580,
      "end_ms": 876045,
      "text": "我会在博物馆里长时间凝视一幅画。"
    },
    {
      "segment_id": "s000381",
      "start_ms": 876540,
      "end_ms": 877605,
      "text": "不是要理解他，"
    },
    {
      "segment_id": "s000382",
      "start_ms": 878000,
      "end_ms": 880710,
      "text": "只是看这种不追求效率的，"
    },
    {
      "segment_id": "s000383",
      "start_ms": 880750,
      "end_ms": 881685,
      "text": "纯粹的看，"
    },
    {
      "segment_id": "s000384",
      "start_ms": 882050,
      "end_ms": 883665,
      "text": "是抵抗识别的开始。"
    },
    {
      "segment_id": "s000385",
      "start_ms": 884170,
      "end_ms": 885130,
      "text": "而真正的存在，"
    },
    {
      "segment_id": "s000386",
      "start_ms": 885410,
      "end_ms": 885730,
      "text": "需要，"
    },
    {
      "segment_id": "s000387",
      "start_ms": 885730,
      "end_ms": 887245,
      "text": "偶尔从积极中退场，"
    },
    {
      "segment_id": "s000388",
      "start_ms": 887580,
      "end_ms": 888940,
      "text": "允许自己无所为，"
    },
    {
      "segment_id": "s000389",
      "start_ms": 889320,
      "end_ms": 890725,
      "text": "不为产出而读书，"
    },
    {
      "segment_id": "s000390",
      "start_ms": 891010,
      "end_ms": 891570,
      "text": "不为分享。"
    },
    {
      "segment_id": "s000391",
      "start_ms": 891570,
      "end_ms": 893210,
      "text": "而旅行不为证明，"
    },
    {
      "segment_id": "s000392",
      "start_ms": 893210,
      "end_ms": 895890,
      "text": "而生活这些无用的时刻，"
    },
    {
      "segment_id": "s000393",
      "start_ms": 896170,
      "end_ms": 898365,
      "text": "恰恰是他者可能到来的间隙。"
    },
    {
      "segment_id": "s000394",
      "start_ms": 899110,
      "end_ms": 899490,
      "text": "最后，"
    },
    {
      "segment_id": "s000395",
      "start_ms": 899690,
      "end_ms": 901525,
      "text": "我想认真推荐一次这本书。"
    },
    {
      "segment_id": "s000396",
      "start_ms": 902380,
      "end_ms": 904020,
      "text": "如果你看到这里还没有划走，"
    },
    {
      "segment_id": "s000397",
      "start_ms": 904200,
      "end_ms": 906560,
      "text": "说明你心里有一个问题一直没有被回答。"
    },
    {
      "segment_id": "s000398",
      "start_ms": 906700,
      "end_ms": 908000,
      "text": "我们到底该怎么面对？"
    },
    {
      "segment_id": "s000399",
      "start_ms": 908000,
      "end_ms": 913345,
      "text": "那些被算法过滤掉的被同质化抹平的被连接叙事遮蔽的真实，"
    },
    {
      "segment_id": "s000400",
      "start_ms": 913850,
      "end_ms": 916385,
      "text": "他者的消失就是为这个问题写的。"
    },
    {
      "segment_id": "s000401",
      "start_ms": 917000,
      "end_ms": 918445,
      "text": "他不是让你拒绝什么，"
    },
    {
      "segment_id": "s000402",
      "start_ms": 918810,
      "end_ms": 923660,
      "text": "他是让你看见连接和自由之间那片被我们粗暴踩屏的地带。"
    },
    {
      "segment_id": "s000403",
      "start_ms": 923780,
      "end_ms": 924480,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000404",
      "start_ms": 924620,
      "end_ms": 925900,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000405",
      "start_ms": 925900,
      "end_ms": 926495,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "408be67c5d997813614e9edcde856960ecc76f17c616ef1089f484bbc2b06c53"
}