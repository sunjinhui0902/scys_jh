{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_b503588bf897195f_u001",
  "video_id": "v_b503588bf897195f",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 812.652993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 190,
      "end_ms": 1290,
      "text": "本视频十五分钟，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1450,
      "end_ms": 3810,
      "text": "党解钱目中国历代政治得失，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4030,
      "end_ms": 5490,
      "text": "建议先收藏再观看。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 5870,
      "end_ms": 8430,
      "text": "我一直觉得读历史最无力的时候，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8530,
      "end_ms": 10210,
      "text": "不是你记不住年代事件，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 10590,
      "end_ms": 12310,
      "text": "也不是搞不清谁输谁赢，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 12510,
      "end_ms": 14430,
      "text": "而是你明明知道几千年来，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 14430,
      "end_ms": 16309,
      "text": "中国人就在这套系统里活着，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 16490,
      "end_ms": 18470,
      "text": "却说不清他到底是怎么运转的，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 18630,
      "end_ms": 20990,
      "text": "却说不清他和我们今天到底有什么关系。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 21370,
      "end_ms": 22710,
      "text": "你说你想理解中国，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 23130,
      "end_ms": 24570,
      "text": "可当真正翻开史书，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 24910,
      "end_ms": 26190,
      "text": "看到那么多制度，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 26230,
      "end_ms": 29370,
      "text": "官明变法党争反而头晕了。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 29470,
      "end_ms": 30480,
      "text": "这个时候哦，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 30480,
      "end_ms": 33820,
      "text": "有没有一本书能帮你把政治背后的逻辑理清楚，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 34080,
      "end_ms": 37240,
      "text": "有没有一种讲法能让你在看懂古代的同时，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 37480,
      "end_ms": 42260,
      "text": "也看清现在有的钱穆的中国历代政治得失。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 42720,
      "end_ms": 43400,
      "text": "但说实话，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 43740,
      "end_ms": 47280,
      "text": "大多数人听到这个书名第一反应是厚重兼深，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 47740,
      "end_ms": 50820,
      "text": "觉得又是讲皇帝官僚朝代兴衰的老套路。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 51280,
      "end_ms": 54460,
      "text": "那是因为我们平时接触的历史多是故事，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 54660,
      "end_ms": 55600,
      "text": "而不是制度。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 55980,
      "end_ms": 57100,
      "text": "可钱穆这本书，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 57340,
      "end_ms": 59765,
      "text": "它不是讲谁杀了谁谁夺了位，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 60270,
      "end_ms": 66495,
      "text": "而是带你去看汉、唐宋、明清五个朝代到底是怎么管起来的，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 67050,
      "end_ms": 67775,
      "text": "怎么收税，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 68150,
      "end_ms": 68770,
      "text": "怎么选官，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 69090,
      "end_ms": 69710,
      "text": "怎么打仗，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 70050,
      "end_ms": 70765,
      "text": "怎么治理。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 71570,
      "end_ms": 72870,
      "text": "书里没有堆砌事件，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 72970,
      "end_ms": 75770,
      "text": "只有一个通透的史家穿过层层标签，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 76050,
      "end_ms": 78895,
      "text": "带你看清中国政治背后的德与失。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 79910,
      "end_ms": 81010,
      "text": "钱穆是少数，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 81010,
      "end_ms": 83495,
      "text": "能跳出专治黑暗四字咒语的人，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 84370,
      "end_ms": 86770,
      "text": "他不认同当时流行的全盘西化思潮，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 87030,
      "end_ms": 88510,
      "text": "也反对用封建落后。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 88510,
      "end_ms": 89010,
      "text": "一句话，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 89030,
      "end_ms": 90235,
      "text": "否定整个传统，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 90560,
      "end_ms": 91320,
      "text": "他不是守旧，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 91540,
      "end_ms": 92415,
      "text": "而是清醒。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 92840,
      "end_ms": 94175,
      "text": "他要我们别急着骂，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 94450,
      "end_ms": 96070,
      "text": "先看明白这本书，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 96070,
      "end_ms": 97950,
      "text": "原是他一九五二年的讲课笔记，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 98110,
      "end_ms": 99185,
      "text": "后来整理成书，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 99650,
      "end_ms": 100790,
      "text": "写法极其清爽，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 100990,
      "end_ms": 101570,
      "text": "没有学术，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 101570,
      "end_ms": 102790,
      "text": "黑化不掉书袋，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 102810,
      "end_ms": 104595,
      "text": "就像一位老先生端着一杯茶，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 104930,
      "end_ms": 108025,
      "text": "把两千年的制度变迁轻轻铺开在你面前。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 108360,
      "end_ms": 109720,
      "text": "他从汉代的察举制，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 109720,
      "end_ms": 111145,
      "text": "讲到唐代的租庸调，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 111450,
      "end_ms": 114210,
      "text": "从宋代的重文轻武讲到明清的皇权，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 114210,
      "end_ms": 115930,
      "text": "独揽每一个朝代，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 116110,
      "end_ms": 117865,
      "text": "他都讲四项根本大法，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 118360,
      "end_ms": 119700,
      "text": "政府组织科举，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 119700,
      "end_ms": 122245,
      "text": "选官赋税、经济兵役、国防。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 122750,
      "end_ms": 123915,
      "text": "他不是罗列知识，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 124240,
      "end_ms": 125480,
      "text": "而是带你看变化，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 125660,
      "end_ms": 126385,
      "text": "看因果，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 126620,
      "end_ms": 127345,
      "text": "看人心。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 127810,
      "end_ms": 128090,
      "text": "比如，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 128090,
      "end_ms": 129620,
      "text": "他讲汉代指出，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 129620,
      "end_ms": 131775,
      "text": "这是中国官僚制度的奠基期。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 132190,
      "end_ms": 134535,
      "text": "其制度设计充满开创性智慧。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 135380,
      "end_ms": 136340,
      "text": "政府组织方面，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 136500,
      "end_ms": 138280,
      "text": "汉代建立了三公九卿制，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 138580,
      "end_ms": 141060,
      "text": "丞相、太尉、御史大夫分长，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 141120,
      "end_ms": 142720,
      "text": "行政、军事监察，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 143040,
      "end_ms": 144285,
      "text": "形成权力制衡。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 144720,
      "end_ms": 145760,
      "text": "特别值得注意的是，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 145920,
      "end_ms": 147455,
      "text": "汉代丞像权力很大，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 147960,
      "end_ms": 148860,
      "text": "皇帝下诏书，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 149020,
      "end_ms": 151480,
      "text": "丞相不同意时可以封还诏书。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 151660,
      "end_ms": 155005,
      "text": "这体现了汉代君臣之间某种程度的共治关系。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 155670,
      "end_ms": 157410,
      "text": "科举制度虽未正式确立，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 157650,
      "end_ms": 161115,
      "text": "但汉代的察举制开创了制度化、选官的先河。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 162160,
      "end_ms": 163720,
      "text": "通过举笑廉等方式，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 163920,
      "end_ms": 165895,
      "text": "地方优秀人才得以进入中央，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 166200,
      "end_ms": 169830,
      "text": "打破了世卿世禄的贵族垄断赋税制度上，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 169990,
      "end_ms": 171870,
      "text": "汉代实行轻徭薄赋，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 172170,
      "end_ms": 175190,
      "text": "文景之治时期税率低至三十税一。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 175390,
      "end_ms": 179125,
      "text": "这种休养生息的政策促进了经济快速恢复和发展。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 179590,
      "end_ms": 180330,
      "text": "国防方面，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 180550,
      "end_ms": 182230,
      "text": "汉代既保持中央军力，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 182370,
      "end_ms": 183670,
      "text": "又发展地方民兵，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 183890,
      "end_ms": 185630,
      "text": "形成多层次的防御体系，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 185630,
      "end_ms": 189395,
      "text": "特别是对匈奴的战争奠定了中国的基本疆域格局。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 190050,
      "end_ms": 191590,
      "text": "钱穆评价汉代制度，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 191650,
      "end_ms": 192915,
      "text": "简易而宏大，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 193350,
      "end_ms": 195070,
      "text": "既有规矩又不失灵活，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 195310,
      "end_ms": 196795,
      "text": "为后世确立了典范。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 197490,
      "end_ms": 197790,
      "text": "他讲，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 197790,
      "end_ms": 199010,
      "text": "唐代指出，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 199210,
      "end_ms": 200985,
      "text": "这是中国制度的成熟期，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 201370,
      "end_ms": 202575,
      "text": "各方面都趋于完善，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 203210,
      "end_ms": 206555,
      "text": "但也正是在这种完善中埋下了衰落的种子。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 206980,
      "end_ms": 207780,
      "text": "政府组织上，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 207960,
      "end_ms": 211190,
      "text": "唐代实行三省六部制、中书省决策，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 211350,
      "end_ms": 212310,
      "text": "门下省审核，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 212570,
      "end_ms": 213550,
      "text": "上书省执行，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 213870,
      "end_ms": 215685,
      "text": "形成科学的分权制衡。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 216310,
      "end_ms": 217590,
      "text": "但到唐代中后期，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 218070,
      "end_ms": 219765,
      "text": "使值差遣制度盛行，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 220150,
      "end_ms": 221410,
      "text": "正规官制被绕过，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 221630,
      "end_ms": 222650,
      "text": "导致机构臃肿，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 222750,
      "end_ms": 223470,
      "text": "效率低下。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 223610,
      "end_ms": 225815,
      "text": "科举制度在唐代真正成熟，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 226090,
      "end_ms": 227805,
      "text": "成为选拔人才的主要途径，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 228630,
      "end_ms": 229750,
      "text": "朝为田舍郎，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 229950,
      "end_ms": 231805,
      "text": "暮登天子堂成为可能，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 232190,
      "end_ms": 233905,
      "text": "社会流动性大大增强。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 234390,
      "end_ms": 238025,
      "text": "但科举也导致文人治国五倍见持的问题。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 238650,
      "end_ms": 241035,
      "text": "赋税制度前期实行租庸调制，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 241310,
      "end_ms": 244495,
      "text": "建立在均田制基础上税负公平合理，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 244780,
      "end_ms": 246160,
      "text": "但随着土地兼并严重，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 246300,
      "end_ms": 247305,
      "text": "均田制瓦解，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 247680,
      "end_ms": 249540,
      "text": "唐朝改行两税法开，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 249540,
      "end_ms": 250600,
      "text": "是以货币征税，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 250780,
      "end_ms": 251985,
      "text": "加重了农民负担。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 252400,
      "end_ms": 253165,
      "text": "军事制度上，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 253530,
      "end_ms": 255310,
      "text": "府兵制前期效果显著，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 255590,
      "end_ms": 257510,
      "text": "士兵于农既保障兵源，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 257570,
      "end_ms": 258470,
      "text": "又节约军费，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 258610,
      "end_ms": 260070,
      "text": "但后期改为募兵制，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 260290,
      "end_ms": 262570,
      "text": "导致藩镇做大中央集权削弱，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 262790,
      "end_ms": 264215,
      "text": "最终引发安史之乱。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 264690,
      "end_ms": 265435,
      "text": "钱穆指出，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 265750,
      "end_ms": 267190,
      "text": "唐代制度的教训是，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 267510,
      "end_ms": 270055,
      "text": "再好的制度也需要随时代调整，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 270400,
      "end_ms": 272605,
      "text": "固守惩罚必然导致衰落。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 273130,
      "end_ms": 273430,
      "text": "他讲，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 273430,
      "end_ms": 274590,
      "text": "宋代指出，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 274590,
      "end_ms": 275990,
      "text": "这是中国文化的高峰，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 276250,
      "end_ms": 278095,
      "text": "但也是军事上的弱势期。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 278600,
      "end_ms": 280040,
      "text": "这种矛盾深深烙印。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 280040,
      "end_ms": 281335,
      "text": "在其制度设计中，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 281580,
      "end_ms": 282340,
      "text": "政府组织上，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 282560,
      "end_ms": 284420,
      "text": "宋代极度强化中央集权，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 284780,
      "end_ms": 289835,
      "text": "通过杯酒释兵权、文官、知州等措施彻底解决藩镇割据问题，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 290450,
      "end_ms": 294690,
      "text": "但过度分权导致援官援兵、援费问题严重，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 294930,
      "end_ms": 297260,
      "text": "行政效率低下科举制度。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 297260,
      "end_ms": 298620,
      "text": "在宋代达到极盛，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 298980,
      "end_ms": 302775,
      "text": "录取人数大大增加科举成为入世主要途径。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 303040,
      "end_ms": 304720,
      "text": "湖名、藤路等制度，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 304720,
      "end_ms": 305700,
      "text": "确保考试公平。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 305960,
      "end_ms": 309345,
      "text": "但也导致科举越来越城市化抑制创新思维。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 309630,
      "end_ms": 310510,
      "text": "赋税制度上，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 310710,
      "end_ms": 312170,
      "text": "宋代商品经济发达，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 312410,
      "end_ms": 314570,
      "text": "工商税收首次超过农业税，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 315050,
      "end_ms": 316070,
      "text": "但税负过重，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 316150,
      "end_ms": 319290,
      "text": "导致民怨沸腾王安石变法试图革新。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 319550,
      "end_ms": 321690,
      "text": "但因触动既得利益集团而失败。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 321730,
      "end_ms": 324030,
      "text": "军事制度是宋代最大的痛点。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 324450,
      "end_ms": 328330,
      "text": "强干弱支兵将分离的政策虽然防止了军阀割据，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 328550,
      "end_ms": 330370,
      "text": "但也导致军队战斗力下降，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 330630,
      "end_ms": 332270,
      "text": "对外战争屡战屡败。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 332790,
      "end_ms": 333530,
      "text": "钱穆认为，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 333910,
      "end_ms": 335810,
      "text": "宋代制度的得失告诉我们，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 336110,
      "end_ms": 340620,
      "text": "矫枉过正会导致新的问题强衡最关键。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 340620,
      "end_ms": 340980,
      "text": "他讲，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 340980,
      "end_ms": 341960,
      "text": "明代指出，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 341960,
      "end_ms": 344280,
      "text": "这是中央集权极度强化的时期，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 344700,
      "end_ms": 347160,
      "text": "皇权专制达到前所未有的高度。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 347280,
      "end_ms": 348120,
      "text": "政府组织上，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 348300,
      "end_ms": 351640,
      "text": "朱元璋废除丞相制皇帝直接领导六部，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 351820,
      "end_ms": 353200,
      "text": "皇权空前强化，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 353360,
      "end_ms": 354400,
      "text": "后来设立内阁，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 354660,
      "end_ms": 356660,
      "text": "但内阁大学士只有票拟权，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 356960,
      "end_ms": 359060,
      "text": "最终决策权仍在皇帝手中。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 359200,
      "end_ms": 361220,
      "text": "科举制度发展到八股取势，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 361320,
      "end_ms": 362120,
      "text": "形势僵化，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 362200,
      "end_ms": 362940,
      "text": "内容空洞，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 363180,
      "end_ms": 364680,
      "text": "严重束缚思想创新。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 365220,
      "end_ms": 365400,
      "text": "范。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 365400,
      "end_ms": 366720,
      "text": "晋中举的悲剧背后，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 366920,
      "end_ms": 369265,
      "text": "是整个人才选拔制度的异化。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 369630,
      "end_ms": 370210,
      "text": "税制度上，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 370450,
      "end_ms": 373410,
      "text": "明代的一条编法将徭役折银征收，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 373570,
      "end_ms": 374490,
      "text": "简化了税制，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 374650,
      "end_ms": 376145,
      "text": "促进了货币经济发展。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 376490,
      "end_ms": 379135,
      "text": "但后期加征三饷加重农民负担，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 379380,
      "end_ms": 382240,
      "text": "导致民变风起军事制度实行尉所制，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 382600,
      "end_ms": 384915,
      "text": "士兵于农类似唐代府兵制。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 385330,
      "end_ms": 388435,
      "text": "但后期未锁制度腐败均户大量逃亡，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 388770,
      "end_ms": 390310,
      "text": "军队战斗力严重下降。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 390410,
      "end_ms": 391090,
      "text": "钱穆指出，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 391370,
      "end_ms": 394070,
      "text": "明代制度的根本问题是信任缺失，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 394350,
      "end_ms": 395730,
      "text": "皇帝不信任大臣，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 395910,
      "end_ms": 397230,
      "text": "中央不信任地方，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 397530,
      "end_ms": 399610,
      "text": "结果就是制度越来越僵化，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 399790,
      "end_ms": 401050,
      "text": "活力逐渐丧失。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 401250,
      "end_ms": 401610,
      "text": "他讲，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 401610,
      "end_ms": 403950,
      "text": "清代作为少数民族建立的政权，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 404130,
      "end_ms": 406035,
      "text": "其制度设计具有双重性，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 406410,
      "end_ms": 407710,
      "text": "一方面沿袭明志，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 407890,
      "end_ms": 409670,
      "text": "另一方面保持满族特权。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 409830,
      "end_ms": 410690,
      "text": "政府组织上，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 410930,
      "end_ms": 413010,
      "text": "清代沿袭明治不设丞相，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 413190,
      "end_ms": 414250,
      "text": "但设立军机处，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 414549,
      "end_ms": 416525,
      "text": "使皇权专制达到顶峰。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 416960,
      "end_ms": 419080,
      "text": "大臣彻底成为皇帝的奴才，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 419260,
      "end_ms": 420280,
      "text": "毫无自主权。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 420440,
      "end_ms": 422100,
      "text": "科举制度虽然继续实行，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 422360,
      "end_ms": 423955,
      "text": "但满汉区别对待，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 424350,
      "end_ms": 425090,
      "text": "买人做官，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 425130,
      "end_ms": 425850,
      "text": "多靠特权，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 426210,
      "end_ms": 428145,
      "text": "科举的公平性大打折扣。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 428440,
      "end_ms": 429135,
      "text": "赋税制度上，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 429410,
      "end_ms": 431050,
      "text": "清代实行摊丁入亩，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 431270,
      "end_ms": 433030,
      "text": "将人头税并入土地税，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 433170,
      "end_ms": 434290,
      "text": "减轻了平民负担，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 434470,
      "end_ms": 435550,
      "text": "促进了人口增长。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 435630,
      "end_ms": 437870,
      "text": "军事制度保持八旗绿营制，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 438170,
      "end_ms": 439970,
      "text": "但八旗兵逐渐腐化，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 440150,
      "end_ms": 441470,
      "text": "战斗力严重下降。"
    },
    {
      "segment_id": "s000217",
      "start_ms": 442230,
      "end_ms": 443210,
      "text": "钱穆特别指出，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 443510,
      "end_ms": 446370,
      "text": "清代政治的最大特点是部族政权，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 446770,
      "end_ms": 450150,
      "text": "一切制度设计都要首先保障满族特权，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 450530,
      "end_ms": 453730,
      "text": "这是清代制度与之前历代根本不同之处。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 454350,
      "end_ms": 457330,
      "text": "钱穆写书的方法和主流史学家完全不同，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 457830,
      "end_ms": 459185,
      "text": "一、不迷信客观规律，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 459480,
      "end_ms": 460760,
      "text": "也不把人当其子。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 461160,
      "end_ms": 461540,
      "text": "他说，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 461880,
      "end_ms": 463640,
      "text": "制度背后都是人的选择，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 464000,
      "end_ms": 466760,
      "text": "而人的选择又受制于时代处境。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 467300,
      "end_ms": 468480,
      "text": "没有完美的制度，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 468700,
      "end_ms": 470280,
      "text": "只有不得已的权衡。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 470640,
      "end_ms": 472620,
      "text": "这本书横跨两千年中国史，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 472900,
      "end_ms": 474300,
      "text": "但只有短短几万字。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 474680,
      "end_ms": 475960,
      "text": "钱穆不写细节，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 476200,
      "end_ms": 476980,
      "text": "只抓关键。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 477500,
      "end_ms": 479740,
      "text": "他用最少的字说最透的话。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 480040,
      "end_ms": 481720,
      "text": "比如他讲明代废除宰相，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 481940,
      "end_ms": 482600,
      "text": "直接点出，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 482680,
      "end_ms": 485420,
      "text": "这是明清皇权专制走向极端的开端。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 486020,
      "end_ms": 488080,
      "text": "讲清代部族政权直言，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 488080,
      "end_ms": 491575,
      "text": "满汉双轨制是蜻蜓最大的心结与局限。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 492050,
      "end_ms": 493645,
      "text": "他不是在写历史教科书，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 494030,
      "end_ms": 496870,
      "text": "而是在写一部中国政治制度的诊断报告，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 496970,
      "end_ms": 498530,
      "text": "每一章都向医生看病，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 498770,
      "end_ms": 500550,
      "text": "望闻问切指出，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 500550,
      "end_ms": 501850,
      "text": "这个朝代何以强？"
    },
    {
      "segment_id": "s000244",
      "start_ms": 502130,
      "end_ms": 502730,
      "text": "何以衰？"
    },
    {
      "segment_id": "s000245",
      "start_ms": 503150,
      "end_ms": 504895,
      "text": "何以得何以失。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 505350,
      "end_ms": 506750,
      "text": "而这本书的现实意义，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 506930,
      "end_ms": 508925,
      "text": "在今天我们格外能听懂。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 509350,
      "end_ms": 512305,
      "text": "当人人都在说中国自古以来的时候，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 512950,
      "end_ms": 514925,
      "text": "钱穆提供了一种冷静的声音。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 515540,
      "end_ms": 516480,
      "text": "不要笼统的说，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 516480,
      "end_ms": 519055,
      "text": "古代汉唐不同于宋明，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 519470,
      "end_ms": 521275,
      "text": "每个朝代都有自己的逻辑，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 521670,
      "end_ms": 523165,
      "text": "也不要简单的骂专制。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 523590,
      "end_ms": 527215,
      "text": "要看清楚专制的背后有多少是制度设计，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 527490,
      "end_ms": 529385,
      "text": "有多少是人性使然。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 529830,
      "end_ms": 530395,
      "text": "他说，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 530950,
      "end_ms": 533145,
      "text": "政治制度从来不是天上掉下来的，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 533510,
      "end_ms": 534895,
      "text": "也不是圣人设计的，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 535340,
      "end_ms": 537065,
      "text": "它是一步步长出来的，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 537580,
      "end_ms": 538875,
      "text": "长在人的需要里，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 539190,
      "end_ms": 540810,
      "text": "也长在人的局限里。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 540830,
      "end_ms": 546245,
      "text": "所以如果你曾经想问中国古代到底是不是专制科举是不是公平？"
    },
    {
      "segment_id": "s000263",
      "start_ms": 546680,
      "end_ms": 548000,
      "text": "清朝到底差在哪儿？"
    },
    {
      "segment_id": "s000264",
      "start_ms": 548000,
      "end_ms": 551165,
      "text": "但这本书或许就是你在等的那次讲解。"
    },
    {
      "segment_id": "s000265",
      "start_ms": 551590,
      "end_ms": 553225,
      "text": "钱的讲法极其平和，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 553700,
      "end_ms": 554575,
      "text": "没有火药味，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 554920,
      "end_ms": 556785,
      "text": "但背后自有一股底气。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 557290,
      "end_ms": 558695,
      "text": "他不是为帝王辩护，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 559110,
      "end_ms": 560345,
      "text": "而是为理解辩护。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 560930,
      "end_ms": 562630,
      "text": "他要我们别用今天的眼光，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 562750,
      "end_ms": 564190,
      "text": "轻率的判古人的罪，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 564710,
      "end_ms": 566215,
      "text": "而要回到历史现场，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 566520,
      "end_ms": 568160,
      "text": "看他们当时有什么选项，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 568480,
      "end_ms": 569605,
      "text": "有什么难处。"
    },
    {
      "segment_id": "s000275",
      "start_ms": 570030,
      "end_ms": 572945,
      "text": "他讲汉代察举制不是一句落后就完了，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 573320,
      "end_ms": 576755,
      "text": "而是说那是当时条件下最不坏的选择。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 577660,
      "end_ms": 579285,
      "text": "他批评宋代积贫积弱，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 579580,
      "end_ms": 582135,
      "text": "但也肯定其文化开放、政治宽容。"
    },
    {
      "segment_id": "s000279",
      "start_ms": 582530,
      "end_ms": 583070,
      "text": "他指出，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 583130,
      "end_ms": 584865,
      "text": "明清皇权独揽的弊病，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 585220,
      "end_ms": 585900,
      "text": "但也会说，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 586300,
      "end_ms": 589045,
      "text": "那是从前朝失败中吸取教训的后果，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 589430,
      "end_ms": 590530,
      "text": "只是教训。"
    },
    {
      "segment_id": "s000284",
      "start_ms": 590530,
      "end_ms": 591235,
      "text": "学歪了，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 591790,
      "end_ms": 592770,
      "text": "他不是和稀泥，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 593130,
      "end_ms": 595215,
      "text": "而是教你一种读史的态度，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 595640,
      "end_ms": 598235,
      "text": "同情的理解、批判的思考。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 598900,
      "end_ms": 602520,
      "text": "这本书最特别的地方是他不煽情不简化，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 602740,
      "end_ms": 603505,
      "text": "不站队。"
    },
    {
      "segment_id": "s000290",
      "start_ms": 604560,
      "end_ms": 605500,
      "text": "钱穆写政治，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 606060,
      "end_ms": 607240,
      "text": "但写的都是人性，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 607900,
      "end_ms": 608740,
      "text": "他写制度，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 609140,
      "end_ms": 610360,
      "text": "但写的都是选择。"
    },
    {
      "segment_id": "s000294",
      "start_ms": 610960,
      "end_ms": 612160,
      "text": "他写朝代兴亡，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 612520,
      "end_ms": 614600,
      "text": "但写的都是因果链条，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 615060,
      "end_ms": 617900,
      "text": "你读完后不一定同意他的每一个观点。"
    },
    {
      "segment_id": "s000297",
      "start_ms": 618220,
      "end_ms": 618800,
      "text": "事实上，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 618960,
      "end_ms": 621300,
      "text": "很多学者也批评他过于理想化。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 621320,
      "end_ms": 623940,
      "text": "诗人政治对专制批判不够，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 624520,
      "end_ms": 626020,
      "text": "但你一定会更明白，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 626380,
      "end_ms": 628420,
      "text": "中国历史不是黑白的，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 628800,
      "end_ms": 629920,
      "text": "而是灰度的，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 630540,
      "end_ms": 631600,
      "text": "不是静态的，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 632020,
      "end_ms": 633160,
      "text": "而是流动的。"
    },
    {
      "segment_id": "s000305",
      "start_ms": 633640,
      "end_ms": 635990,
      "text": "他不会直接告诉你今天该怎么投票，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 636190,
      "end_ms": 636830,
      "text": "怎么维权，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 637070,
      "end_ms": 637730,
      "text": "怎么爱国。"
    },
    {
      "segment_id": "s000308",
      "start_ms": 637990,
      "end_ms": 639110,
      "text": "但它会让你明白，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 639330,
      "end_ms": 642510,
      "text": "我们今天的种种观念、习惯困境，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 642790,
      "end_ms": 644850,
      "text": "其实都活在一张历史的大网里。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 645690,
      "end_ms": 647850,
      "text": "比如你看完汉代赋税制度，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 648050,
      "end_ms": 651850,
      "text": "会更理解农民负担这四个字背后的千年之重。"
    },
    {
      "segment_id": "s000313",
      "start_ms": 652390,
      "end_ms": 653070,
      "text": "看完科举，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 653070,
      "end_ms": 657890,
      "text": "选官会更明白考试改变命运这句话在中国人血液里的分量。"
    },
    {
      "segment_id": "s000315",
      "start_ms": 658010,
      "end_ms": 659090,
      "text": "看完明清皇权，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 659430,
      "end_ms": 662090,
      "text": "会更看懂某些权力运作的深层逻辑。"
    },
    {
      "segment_id": "s000317",
      "start_ms": 663370,
      "end_ms": 664705,
      "text": "前目没有含口口号，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 665140,
      "end_ms": 667035,
      "text": "但他通篇都在传递一个信念。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 667980,
      "end_ms": 669775,
      "text": "读史不是为了复古，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 670160,
      "end_ms": 671245,
      "text": "而是为了解放，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 671810,
      "end_ms": 672990,
      "text": "从标签中解放，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 673230,
      "end_ms": 674535,
      "text": "从偏见中解放，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 674810,
      "end_ms": 676075,
      "text": "从短视中解放。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 676570,
      "end_ms": 677010,
      "text": "他说，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 677570,
      "end_ms": 680095,
      "text": "我们要温情与敬意的对待传统，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 680450,
      "end_ms": 682045,
      "text": "但不是无条件的崇拜，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 682490,
      "end_ms": 684590,
      "text": "而是先读懂再评判，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 684590,
      "end_ms": 686115,
      "text": "哪怕最后评判是批评，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 686430,
      "end_ms": 687670,
      "text": "那也是站得住的批评。"
    },
    {
      "segment_id": "s000330",
      "start_ms": 687670,
      "end_ms": 689945,
      "text": "所以这不是一本答案之书，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 690280,
      "end_ms": 691235,
      "text": "而是一把钥匙。"
    },
    {
      "segment_id": "s000332",
      "start_ms": 691860,
      "end_ms": 693155,
      "text": "他帮你打开一扇门，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 693530,
      "end_ms": 695285,
      "text": "让你自己走进历史深处，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 695730,
      "end_ms": 697515,
      "text": "然后再带着李解回来。"
    },
    {
      "segment_id": "s000335",
      "start_ms": 697950,
      "end_ms": 702185,
      "text": "如果你曾经对历史失望、对政治厌倦、对中国困惑，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 702810,
      "end_ms": 705465,
      "text": "这本书或许能让你重新升起兴趣。"
    },
    {
      "segment_id": "s000337",
      "start_ms": 705980,
      "end_ms": 707635,
      "text": "他不是厚重的学术著作，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 707950,
      "end_ms": 710415,
      "text": "而是一次清晰而深沉的对话。"
    },
    {
      "segment_id": "s000339",
      "start_ms": 710990,
      "end_ms": 711945,
      "text": "钱穆不是神，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 712380,
      "end_ms": 714415,
      "text": "他只是一位诚恳的誓实者。"
    },
    {
      "segment_id": "s000341",
      "start_ms": 714880,
      "end_ms": 715655,
      "text": "他最后说，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 716240,
      "end_ms": 718195,
      "text": "政治制度根本是现实的，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 718700,
      "end_ms": 720380,
      "text": "每一制度都要针对现实，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 720700,
      "end_ms": 722705,
      "text": "时时刻刻求变动适应，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 723120,
      "end_ms": 724525,
      "text": "没有万世不变之法，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 724860,
      "end_ms": 726835,
      "text": "也没有放置四海皆准之理。"
    },
    {
      "segment_id": "s000347",
      "start_ms": 727890,
      "end_ms": 728745,
      "text": "我们读历史，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 729150,
      "end_ms": 730205,
      "text": "读的不是过去，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 730740,
      "end_ms": 732675,
      "text": "而是我们为何成为我们。"
    },
    {
      "segment_id": "s000350",
      "start_ms": 733230,
      "end_ms": 735225,
      "text": "也许今天没有人像钱穆那样，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 735480,
      "end_ms": 737665,
      "text": "用五堂课讲清五朝政治，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 738060,
      "end_ms": 740250,
      "text": "也没有人像他那样既通古籍，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 740410,
      "end_ms": 741585,
      "text": "又怀现实关怀。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 742330,
      "end_ms": 744505,
      "text": "但我们依然可以在自己的时代里问，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 745020,
      "end_ms": 745805,
      "text": "什么是德，"
    },
    {
      "segment_id": "s000356",
      "start_ms": 746280,
      "end_ms": 747005,
      "text": "什么是诗？"
    },
    {
      "segment_id": "s000357",
      "start_ms": 747530,
      "end_ms": 748555,
      "text": "我们从哪里来，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 749090,
      "end_ms": 750115,
      "text": "可能往哪里去。"
    },
    {
      "segment_id": "s000359",
      "start_ms": 750640,
      "end_ms": 754465,
      "text": "这本书最动人的地方就是他平静语气下的那股热血。"
    },
    {
      "segment_id": "s000360",
      "start_ms": 755060,
      "end_ms": 755960,
      "text": "他不煽动你，"
    },
    {
      "segment_id": "s000361",
      "start_ms": 756260,
      "end_ms": 758255,
      "text": "却让你读完沉默良久。"
    },
    {
      "segment_id": "s000362",
      "start_ms": 758790,
      "end_ms": 759570,
      "text": "他让你明白，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 759970,
      "end_ms": 760990,
      "text": "制度是死的，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 761270,
      "end_ms": 762285,
      "text": "人是活的，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 762740,
      "end_ms": 763875,
      "text": "历史是过去的，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 764070,
      "end_ms": 766025,
      "text": "但理解历史是现在的。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 766710,
      "end_ms": 768600,
      "text": "最终我们读政治得失，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 768860,
      "end_ms": 770295,
      "text": "不是为了评价古人，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 770890,
      "end_ms": 772135,
      "text": "而是为了理解自己，"
    },
    {
      "segment_id": "s000370",
      "start_ms": 772990,
      "end_ms": 774505,
      "text": "理解我们脚下的土地，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 775010,
      "end_ms": 776465,
      "text": "理解我们心中的纠结，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 776890,
      "end_ms": 780145,
      "text": "理解我们这个民族的来路与可能去的方向。"
    },
    {
      "segment_id": "s000373",
      "start_ms": 780760,
      "end_ms": 783095,
      "text": "如果你今天也在思考中国是什么样的，"
    },
    {
      "segment_id": "s000374",
      "start_ms": 783280,
      "end_ms": 784445,
      "text": "中国人该怎么活？"
    },
    {
      "segment_id": "s000375",
      "start_ms": 784890,
      "end_ms": 785545,
      "text": "那没关系，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 786050,
      "end_ms": 787050,
      "text": "先翻开这本书，"
    },
    {
      "segment_id": "s000377",
      "start_ms": 787410,
      "end_ms": 789345,
      "text": "或者哪怕只是看完这个视频，"
    },
    {
      "segment_id": "s000378",
      "start_ms": 789870,
      "end_ms": 791455,
      "text": "让思想慢慢打开，"
    },
    {
      "segment_id": "s000379",
      "start_ms": 791850,
      "end_ms": 794065,
      "text": "让历史的灰度一点点呈现。"
    },
    {
      "segment_id": "s000380",
      "start_ms": 794610,
      "end_ms": 795510,
      "text": "我们终其一生，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 795810,
      "end_ms": 797565,
      "text": "其实就是在练习一个能力，"
    },
    {
      "segment_id": "s000382",
      "start_ms": 798010,
      "end_ms": 799035,
      "text": "不轻易否定，"
    },
    {
      "segment_id": "s000383",
      "start_ms": 799510,
      "end_ms": 800465,
      "text": "不盲目赞美，"
    },
    {
      "segment_id": "s000384",
      "start_ms": 800920,
      "end_ms": 803955,
      "text": "而是试着看清复杂承担理解的重任。"
    },
    {
      "segment_id": "s000385",
      "start_ms": 804400,
      "end_ms": 806200,
      "text": "然后说我明白了，"
    },
    {
      "segment_id": "s000386",
      "start_ms": 806560,
      "end_ms": 807535,
      "text": "我继续努力，"
    },
    {
      "segment_id": "s000387",
      "start_ms": 808120,
      "end_ms": 808895,
      "text": "感谢聆听，"
    },
    {
      "segment_id": "s000388",
      "start_ms": 809200,
      "end_ms": 809915,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000389",
      "start_ms": 810250,
      "end_ms": 812325,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "06caef5b814bc04bbc978e841f0d498290a52d6699a9e0a887b2ba1e257d0603"
}