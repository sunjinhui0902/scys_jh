{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_7c8bdf178c13ccee_u001",
  "video_id": "v_7c8bdf178c13ccee",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 314.607007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 270,
      "end_ms": 1190,
      "text": "你敢相信吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1670,
      "end_ms": 3870,
      "text": "钱老晚年做过一件非常奇怪的事情，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4290,
      "end_ms": 6330,
      "text": "直到他先逝后才被解密公开。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6550,
      "end_ms": 8670,
      "text": "原来他不仅研究导弹火箭，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8890,
      "end_ms": 12070,
      "text": "还悄悄的干了一件让整个科学界都闭嘴的事儿。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12290,
      "end_ms": 16070,
      "text": "他用现代科学去打碎华夏丹道千年不传的秘密，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16450,
      "end_ms": 18310,
      "text": "而帮他执行这项秘密任务的人，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18330,
      "end_ms": 19250,
      "text": "就叫胡福琛。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 19710,
      "end_ms": 22070,
      "text": "一位南开大学化学系毕业的学者。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 22610,
      "end_ms": 23490,
      "text": "一九八零年，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23810,
      "end_ms": 26250,
      "text": "胡福琛在中山大学发表了一篇论文。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 26690,
      "end_ms": 28710,
      "text": "他用化学方程式和物理逻辑，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 28890,
      "end_ms": 32680,
      "text": "把号称天书的周易参铜器拆解的体无完肤。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 32920,
      "end_ms": 34840,
      "text": "当时全中国没几个人能看懂。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 35100,
      "end_ms": 36460,
      "text": "但钱学森看懂了，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 36920,
      "end_ms": 38380,
      "text": "钱老读完拍案叫绝，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 38600,
      "end_ms": 40280,
      "text": "当即亲笔写了一封信。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 40560,
      "end_ms": 41120,
      "text": "信中说，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 41520,
      "end_ms": 43880,
      "text": "你的化学物理加哲学背景，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 43980,
      "end_ms": 45320,
      "text": "举国只有你一人，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 45340,
      "end_ms": 46380,
      "text": "你必须停下来，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 46420,
      "end_ms": 49800,
      "text": "一切由我安排去系统研究单道和内丹学，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 50100,
      "end_ms": 51000,
      "text": "这不是迷信。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 51220,
      "end_ms": 54040,
      "text": "这是中华民族最珍贵的生命科学遗产。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 54220,
      "end_ms": 54760,
      "text": "那一年，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 55020,
      "end_ms": 56320,
      "text": "胡福琛三十五岁。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 56860,
      "end_ms": 57760,
      "text": "他看完信以后，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 57880,
      "end_ms": 59675,
      "text": "将所有研究报告撕了，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 60020,
      "end_ms": 62235,
      "text": "连同报告被撕毁的还有他的前途。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 62650,
      "end_ms": 63825,
      "text": "他接下了这封密令，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 64110,
      "end_ms": 66605,
      "text": "从此开始了一场长达二十六年的潜伏。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 67230,
      "end_ms": 68510,
      "text": "他走遍名山大川，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 68790,
      "end_ms": 70085,
      "text": "深入康藏秘境，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 70390,
      "end_ms": 71550,
      "text": "出入禅秘丛林，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 71730,
      "end_ms": 74290,
      "text": "反高道寻觅点验证单绝。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 74570,
      "end_ms": 75530,
      "text": "他吃过闭门羹，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 75750,
      "end_ms": 77155,
      "text": "被江湖术士威胁过，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 77390,
      "end_ms": 78925,
      "text": "被贾丹诗诽谤过，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 79160,
      "end_ms": 80215,
      "text": "家人也受牵连。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 80600,
      "end_ms": 82295,
      "text": "他钻深山住破庙，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 82630,
      "end_ms": 84780,
      "text": "与饮者同吃同住用命。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 85000,
      "end_ms": 86260,
      "text": "换一句真口诀，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 86500,
      "end_ms": 88040,
      "text": "他校刊千卷到藏，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 88160,
      "end_ms": 89515,
      "text": "收集民间残卷，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 89880,
      "end_ms": 93280,
      "text": "把断裂千年的单道脉络一根一根接回去，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 93420,
      "end_ms": 94460,
      "text": "一边科学拆解，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 94500,
      "end_ms": 95715,
      "text": "一边亲身实证，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 96050,
      "end_ms": 98390,
      "text": "最终将三家四派全部摸清。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 98650,
      "end_ms": 99830,
      "text": "江湖上有人骂他，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 99830,
      "end_ms": 100510,
      "text": "一介书生，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 100610,
      "end_ms": 101375,
      "text": "断人饭碗，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 102010,
      "end_ms": 104680,
      "text": "他一度动摇想放弃钱学森。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 104680,
      "end_ms": 104920,
      "text": "再次，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 104920,
      "end_ms": 105615,
      "text": "来信说，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 106030,
      "end_ms": 107710,
      "text": "我五十岁赶接导弹任务，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 107810,
      "end_ms": 108945,
      "text": "生死置之度外，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 109170,
      "end_ms": 110330,
      "text": "你现在也五十岁。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 110490,
      "end_ms": 111545,
      "text": "该有这份担当，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 111850,
      "end_ms": 113505,
      "text": "为民族把真相留下来，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 113760,
      "end_ms": 115000,
      "text": "别让后人走弯路。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 115160,
      "end_ms": 116055,
      "text": "二零零六年，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 116360,
      "end_ms": 119005,
      "text": "胡福琛完成了这项国家文化科考任务。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 119470,
      "end_ms": 123195,
      "text": "他第一次把单道从江湖迷信拉进学术殿堂。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 123560,
      "end_ms": 127120,
      "text": "第一次把内丹体系完整化、科学化、系统化。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 127340,
      "end_ms": 131105,
      "text": "第一次把千年秘传写成普通人能读懂的文字。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 131320,
      "end_ms": 137390,
      "text": "他主编的中华道教大词典成为道学界的四库全书单道法诀十二讲首发，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 137590,
      "end_ms": 139315,
      "text": "被誉为现代丹晶。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 139760,
      "end_ms": 143545,
      "text": "他把四十四封钱学森亲笔信全部捐给了钱学森图书馆，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 144080,
      "end_ms": 147060,
      "text": "这是两代大师守护中华文明的铁证。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 147260,
      "end_ms": 148265,
      "text": "但胡福琛说，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 148760,
      "end_ms": 150435,
      "text": "这些都不是给普通人看的，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 151080,
      "end_ms": 155960,
      "text": "普通人读不懂古文被劣质白话片爱好者被江湖神棍收割，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 156200,
      "end_ms": 157165,
      "text": "越修越偏，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 157720,
      "end_ms": 159520,
      "text": "真正的单绝藏在深山，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 159760,
      "end_ms": 160605,
      "text": "濒临失传。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 161180,
      "end_ms": 163495,
      "text": "他研究一辈子不是为了当大师，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 163890,
      "end_ms": 168450,
      "text": "是为给后人留一条不走弯路、不被骗、不迷信的入门正路。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 168690,
      "end_ms": 170045,
      "text": "我给你讲一个真实的事儿，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 170290,
      "end_ms": 174090,
      "text": "北京某高校的一位博士生搞了六年材料科学实验做不出来，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 174270,
      "end_ms": 175515,
      "text": "导师催同门卷，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 175950,
      "end_ms": 177090,
      "text": "整个人焦虑到失眠。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 177230,
      "end_ms": 179745,
      "text": "偶然在图书馆看到这本道学入门，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 180140,
      "end_ms": 181345,
      "text": "本来只是随手翻翻，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 181660,
      "end_ms": 183585,
      "text": "结果读到单道非秘术，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 183870,
      "end_ms": 185590,
      "text": "乃身心同条之法。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 185590,
      "end_ms": 186050,
      "text": "那一夜，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 186270,
      "end_ms": 187070,
      "text": "他愣住了，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 187170,
      "end_ms": 187470,
      "text": "他说，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 187470,
      "end_ms": 187810,
      "text": "那一刻，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 187810,
      "end_ms": 188550,
      "text": "忽然明白，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 188850,
      "end_ms": 190175,
      "text": "自己不是不够努力，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 190440,
      "end_ms": 191525,
      "text": "而是节奏乱了。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 191870,
      "end_ms": 192390,
      "text": "书里讲，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 192510,
      "end_ms": 194875,
      "text": "数学为静养生为用，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 195240,
      "end_ms": 198475,
      "text": "把十二时辰对应脏腑契机拆的清清楚楚。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 198810,
      "end_ms": 200350,
      "text": "他照着书里的导引方法，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 200350,
      "end_ms": 203240,
      "text": "试了三分钟叩齿燕睛、舌底生津，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 203500,
      "end_ms": 204335,
      "text": "耳根微热，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 204810,
      "end_ms": 206870,
      "text": "那种久违的清醒感回来了。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 206870,
      "end_ms": 208335,
      "text": "他把书借回去读完了，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 208740,
      "end_ms": 209600,
      "text": "后来跟朋友说，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 209880,
      "end_ms": 211560,
      "text": "这本书没教他炼丹修仙，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 211820,
      "end_ms": 214460,
      "text": "但教他重新认识了自己的身体和节奏。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 214640,
      "end_ms": 216685,
      "text": "像这样的读者不是一个两个。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 217260,
      "end_ms": 218035,
      "text": "有读者说，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 218390,
      "end_ms": 219245,
      "text": "翻开这本书，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 219570,
      "end_ms": 220310,
      "text": "没有玄虚，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 220310,
      "end_ms": 221075,
      "text": "术语堆砌，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 221480,
      "end_ms": 222785,
      "text": "像一位沉稳的老友。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 223040,
      "end_ms": 224935,
      "text": "在你翻页时悄然点一句，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 225400,
      "end_ms": 226780,
      "text": "这里慢一点看。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 226800,
      "end_ms": 227325,
      "text": "于是，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 227870,
      "end_ms": 231570,
      "text": "胡福琛把四十年治学二十六年潜伏一生，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 231610,
      "end_ms": 232135,
      "text": "实政，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 232530,
      "end_ms": 237230,
      "text": "全部押进了一本最通俗、最严谨、最正统、最安全的书。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 237370,
      "end_ms": 239445,
      "text": "书名就叫道学入门，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 239840,
      "end_ms": 240460,
      "text": "没有迷信，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 240720,
      "end_ms": 241525,
      "text": "没有玄虚，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 241920,
      "end_ms": 247830,
      "text": "只有一位顶级学者把道学根源、单道脉络、内丹逻辑、历史误区，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 248030,
      "end_ms": 250090,
      "text": "用大白话讲的明明白白。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 250250,
      "end_ms": 252495,
      "text": "这个领域有他学术地位的，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 252710,
      "end_ms": 253805,
      "text": "没他江湖实证，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 254120,
      "end_ms": 255400,
      "text": "有他江湖实证的，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 255460,
      "end_ms": 256645,
      "text": "没他科学严谨，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 256990,
      "end_ms": 258195,
      "text": "有他科学严谨的，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 258420,
      "end_ms": 259580,
      "text": "没他正统道统。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 259640,
      "end_ms": 261160,
      "text": "如果你厌倦了江湖骗术，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 261240,
      "end_ms": 262545,
      "text": "不想被伪学收割，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 262850,
      "end_ms": 264595,
      "text": "想踏踏实实亲近道学，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 264950,
      "end_ms": 268390,
      "text": "那这本书值得放在枕边相伴一生链接在下方，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 268670,
      "end_ms": 272005,
      "text": "钱学森和胡富琛花了二十六年为你开了一条路，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 272370,
      "end_ms": 274610,
      "text": "你只需要翻开第一页就能走上去。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 274690,
      "end_ms": 277445,
      "text": "如果你只是想先看看道学到底是怎么回事儿，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 277800,
      "end_ms": 280740,
      "text": "单本道学入门足够你入门一本，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 280740,
      "end_ms": 283600,
      "text": "翻完道学根源单道脉络内，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 283600,
      "end_ms": 285080,
      "text": "单逻辑全在里头，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 285140,
      "end_ms": 286035,
      "text": "不走弯路。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 286600,
      "end_ms": 288225,
      "text": "但如果你想真正沉下来，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 288460,
      "end_ms": 290745,
      "text": "把道穴的骨架和血肉都摸透，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 291130,
      "end_ms": 295030,
      "text": "可以看看搭配胡福琛先生单道法诀十二讲的组合套装。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 295510,
      "end_ms": 298425,
      "text": "那套书是钱老生前最后审阅的稿子，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 298830,
      "end_ms": 302435,
      "text": "是胡福琛用命换来的三家四派完整脉络，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 303160,
      "end_ms": 305320,
      "text": "两本对着读入门有门路，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 305600,
      "end_ms": 306735,
      "text": "深入有根基，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 307140,
      "end_ms": 308465,
      "text": "给自己选一条踏实路，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 308770,
      "end_ms": 310270,
      "text": "也给家里人留一本不走。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 310270,
      "end_ms": 311170,
      "text": "偏的正经书，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 311370,
      "end_ms": 312135,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 312720,
      "end_ms": 314475,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "a056b70edf1e889435d4e17e7c0bec271afa9486ff98e830c9786ada02a0bfbe"
}