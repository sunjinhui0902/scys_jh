{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_e55cdcc6396cb15e_u001",
  "video_id": "v_e55cdcc6396cb15e",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 611.892993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 3630,
      "text": "你知道我国最适合过冬的十座小城是哪儿吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3970,
      "end_ms": 4550,
      "text": "有人说，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4550,
      "end_ms": 5010,
      "text": "三亚，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 5210,
      "end_ms": 8470,
      "text": "有人说海口不是三亚过冬，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8470,
      "end_ms": 9270,
      "text": "一个月光，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 9310,
      "end_ms": 10450,
      "text": "房租就五六千，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 10830,
      "end_ms": 13210,
      "text": "吃碗米粉都比老家贵一倍。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 13650,
      "end_ms": 15130,
      "text": "海滩上人挤人，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 15170,
      "end_ms": 19870,
      "text": "连个安静晒太阳的地方都找不着海口好一点。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 20510,
      "end_ms": 22070,
      "text": "可每年一到冬天，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 22150,
      "end_ms": 27030,
      "text": "全国的老人往那扎堆儿菜市场跟赶庙会似的，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 27510,
      "end_ms": 29785,
      "text": "真正排榜首的那个小城。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 30120,
      "end_ms": 31780,
      "text": "冬天均温十几度，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 32060,
      "end_ms": 33700,
      "text": "满城的银杏黄了，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 33700,
      "end_ms": 35020,
      "text": "像铺了一地金子，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 35100,
      "end_ms": 37340,
      "text": "泡一次野温泉十来块钱。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 37840,
      "end_ms": 41480,
      "text": "菜市场的蔬菜水果新鲜到您不想回家。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 41900,
      "end_ms": 44940,
      "text": "关键是一个月的房租一千出头，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 45240,
      "end_ms": 46319,
      "text": "到底是哪儿？"
    },
    {
      "segment_id": "s000020",
      "start_ms": 46900,
      "end_ms": 49740,
      "text": "从第十名开始倒着讲讲，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 49740,
      "end_ms": 51840,
      "text": "到最后您自己盘算盘算，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 52140,
      "end_ms": 53520,
      "text": "还是咱们的老规矩。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 53880,
      "end_ms": 54520,
      "text": "开奖前，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 54580,
      "end_ms": 57040,
      "text": "劳烦各位老友顺手点亮红心。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 57300,
      "end_ms": 58840,
      "text": "评论区打个来了，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 59180,
      "end_ms": 62595,
      "text": "讲我看看今天又有多少知音来捧场。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 63020,
      "end_ms": 63800,
      "text": "第十名。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 64040,
      "end_ms": 67260,
      "text": "广西北海北海很多人听过，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 67320,
      "end_ms": 69885,
      "text": "可真正去住过一个冬天的人不多。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 70320,
      "end_ms": 73485,
      "text": "大部分人对北海的印象就是银滩，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 74130,
      "end_ms": 75525,
      "text": "觉得是个旅游城市，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 75760,
      "end_ms": 76245,
      "text": "住不了。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 76810,
      "end_ms": 77290,
      "text": "其实，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 77310,
      "end_ms": 80405,
      "text": "北海的老城区跟旅游区是两个世界，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 80870,
      "end_ms": 84470,
      "text": "老城区里有一条百年老街棋楼，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 84470,
      "end_ms": 85515,
      "text": "一排排的立着，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 85790,
      "end_ms": 87410,
      "text": "底下是卖早餐的，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 87450,
      "end_ms": 88435,
      "text": "卖糖水的，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 88660,
      "end_ms": 89220,
      "text": "卖海鲜，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 89220,
      "end_ms": 89865,
      "text": "干货的，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 90300,
      "end_ms": 91680,
      "text": "生活气息浓得很。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 91880,
      "end_ms": 92280,
      "text": "冬天，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 92360,
      "end_ms": 95115,
      "text": "北海的气温在十度到二十度之间，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 95570,
      "end_ms": 96490,
      "text": "不用开暖气，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 96630,
      "end_ms": 97970,
      "text": "也不用穿羽绒服，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 98250,
      "end_ms": 99990,
      "text": "一件薄外套就够了。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 100010,
      "end_ms": 103415,
      "text": "北海过冬最舒服的事儿是吃海鲜。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 103920,
      "end_ms": 107145,
      "text": "冬天是北部湾海鲜最肥的时候，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 107560,
      "end_ms": 109720,
      "text": "早上去市场买一斤花蟹，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 109760,
      "end_ms": 110655,
      "text": "十来块钱，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 111110,
      "end_ms": 112795,
      "text": "大虾二十来块一斤，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 113250,
      "end_ms": 114505,
      "text": "回来自己蒸着吃，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 114820,
      "end_ms": 116745,
      "text": "比在老家下馆子便宜，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 117340,
      "end_ms": 117980,
      "text": "吃完了，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 117980,
      "end_ms": 119200,
      "text": "沿着海边走走。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 119440,
      "end_ms": 125060,
      "text": "冬天的银滩人少了大半儿海风不冷太阳暖暖的走一个，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 125060,
      "end_ms": 126605,
      "text": "来回出一身微汗。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 127120,
      "end_ms": 128105,
      "text": "租房的话，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 128540,
      "end_ms": 131060,
      "text": "老城区一个月一千来块钱，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 131260,
      "end_ms": 133685,
      "text": "能租到带厨房的一居室，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 134600,
      "end_ms": 137240,
      "text": "一千块房租十来块的花蟹，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 137360,
      "end_ms": 138865,
      "text": "冬天穿薄外套，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 139300,
      "end_ms": 140520,
      "text": "北海排第十。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 140640,
      "end_ms": 141520,
      "text": "不是它不好，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 141840,
      "end_ms": 143700,
      "text": "是后面的更便宜，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 143800,
      "end_ms": 144535,
      "text": "更安静。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 145510,
      "end_ms": 146130,
      "text": "第九名，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 146350,
      "end_ms": 147525,
      "text": "广西崇左，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 148150,
      "end_ms": 151520,
      "text": "崇左在广西的西南角挨着越南，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 151580,
      "end_ms": 153555,
      "text": "大部分人没听过这个名字。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 153970,
      "end_ms": 155550,
      "text": "可要是说德天瀑布，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 155570,
      "end_ms": 156910,
      "text": "您可能有点印象。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 156990,
      "end_ms": 159255,
      "text": "德天瀑布就在崇左境内，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 159780,
      "end_ms": 164935,
      "text": "崇左冬天的气温跟北海差不多十度到二十度之间，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 165390,
      "end_ms": 168215,
      "text": "可崇左比北海安静十倍。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 168690,
      "end_ms": 171445,
      "text": "这个城市不大街上没什么游客，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 171970,
      "end_ms": 174325,
      "text": "生活节奏慢到什么程度呢？"
    },
    {
      "segment_id": "s000078",
      "start_ms": 174930,
      "end_ms": 176270,
      "text": "下午两三点钟，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 176350,
      "end_ms": 178535,
      "text": "您去老城区的茶馆坐着，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 179050,
      "end_ms": 182975,
      "text": "周围全是本地老人在喝茶聊天下象棋，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 183460,
      "end_ms": 185565,
      "text": "茶是几块钱一壶的那种，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 186140,
      "end_ms": 187735,
      "text": "坐一下午没人赶你。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 188850,
      "end_ms": 191215,
      "text": "崇左的物价低到什么程度呢？"
    },
    {
      "segment_id": "s000084",
      "start_ms": 191560,
      "end_ms": 194245,
      "text": "菜市场的青菜一块多钱一斤，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 194650,
      "end_ms": 195735,
      "text": "猪肉十来块，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 196550,
      "end_ms": 203395,
      "text": "越南进来的热带水果、火龙果、百香果、芒果比别的地方便宜将近一半儿，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 203710,
      "end_ms": 204970,
      "text": "租房更便宜，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 205050,
      "end_ms": 209045,
      "text": "老城区一个月七八百就能租到不错的宜居室。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 209620,
      "end_ms": 213630,
      "text": "崇左边儿上还有个名仕田园喀斯特的山，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 213830,
      "end_ms": 216145,
      "text": "一座一座立在稻田边儿上。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 216590,
      "end_ms": 217090,
      "text": "冬天，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 217230,
      "end_ms": 219230,
      "text": "水稻收完了田里，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 219230,
      "end_ms": 222170,
      "text": "空着远处的山在薄雾里面，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 222390,
      "end_ms": 223675,
      "text": "安安静静的。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 224140,
      "end_ms": 225380,
      "text": "您租个电动车，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 225560,
      "end_ms": 227520,
      "text": "沿着田间小路骑一圈，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 228090,
      "end_ms": 228910,
      "text": "前面是山，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 228970,
      "end_ms": 232605,
      "text": "后面是山路上没人七八百的房租，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 233080,
      "end_ms": 238670,
      "text": "几块钱的茶骑着电动车在山水里面转崇左过冬，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 238990,
      "end_ms": 240370,
      "text": "花的是最少的钱，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 240530,
      "end_ms": 243035,
      "text": "住的是最安静的地方。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 243690,
      "end_ms": 244430,
      "text": "第八名，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 244610,
      "end_ms": 252305,
      "text": "云南建水建水在云南红河州是一座有一千二百多年历史的古城，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 253000,
      "end_ms": 254975,
      "text": "可跟大理、丽江比起来，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 255390,
      "end_ms": 258375,
      "text": "建水的名气小到几乎没人提。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 258900,
      "end_ms": 262875,
      "text": "建水冬天的气温在七度到二十度之间，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 263340,
      "end_ms": 264840,
      "text": "白天晒着太阳能，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 264860,
      "end_ms": 265625,
      "text": "穿单衣，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 265960,
      "end_ms": 267585,
      "text": "早晚加件外套，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 268050,
      "end_ms": 269865,
      "text": "这个温度不算最暖，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 270250,
      "end_ms": 272685,
      "text": "可见水剩在另一样东西吃。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 273280,
      "end_ms": 276500,
      "text": "建水最出名的是烤豆腐古城，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 276520,
      "end_ms": 278665,
      "text": "西门外有一条烧烤街，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 279130,
      "end_ms": 281895,
      "text": "街两边全是烤豆腐的摊子，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 282220,
      "end_ms": 286040,
      "text": "用炭火烤的小方块豆腐外面焦脆，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 286120,
      "end_ms": 290245,
      "text": "里面嫩蘸着当地的蘸水吃五毛钱一块儿。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 290570,
      "end_ms": 292870,
      "text": "您坐在摊子边儿上的小板凳上，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 293030,
      "end_ms": 294130,
      "text": "老板一边烤，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 294270,
      "end_ms": 297510,
      "text": "一边用小石子在您面前计数吃一块，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 297610,
      "end_ms": 298765,
      "text": "放一颗石子，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 299160,
      "end_ms": 301075,
      "text": "吃完了数十子算钱，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 301650,
      "end_ms": 303405,
      "text": "十块钱能吃到撑。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 303950,
      "end_ms": 306370,
      "text": "建水还有一条米鬼小火车，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 306850,
      "end_ms": 309850,
      "text": "轨距只有普通铁路的一半儿，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 309910,
      "end_ms": 314470,
      "text": "是法国人一百多年前修的滇越铁路的一段小火车。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 314670,
      "end_ms": 317350,
      "text": "从建水古城开到团山村，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 317770,
      "end_ms": 320090,
      "text": "沿途穿过田野和村庄，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 320570,
      "end_ms": 321470,
      "text": "速度很慢，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 322030,
      "end_ms": 324290,
      "text": "窗外的风慢慢吹进来。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 324630,
      "end_ms": 326070,
      "text": "坐一趟几十块钱，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 326370,
      "end_ms": 327570,
      "text": "不赶时间的话，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 327750,
      "end_ms": 331570,
      "text": "来回能做一个下午一千二百年的古城，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 331830,
      "end_ms": 333570,
      "text": "五毛钱一块的烤豆腐，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 334220,
      "end_ms": 335900,
      "text": "一百多年的小火车，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 336560,
      "end_ms": 339260,
      "text": "建水过冬过的不是暖和，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 339660,
      "end_ms": 342360,
      "text": "是一种旧旧的慢慢的日子。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 342840,
      "end_ms": 343800,
      "text": "第七名，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 344400,
      "end_ms": 350100,
      "text": "四川攀枝花四川攀枝花这个名字一说出来，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 350120,
      "end_ms": 354280,
      "text": "很多人第一反应是四川冬天不冷吗？"
    },
    {
      "segment_id": "s000140",
      "start_ms": 354400,
      "end_ms": 354880,
      "text": "不冷。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 355660,
      "end_ms": 358640,
      "text": "攀枝花是中国非常特殊的一座城市，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 358640,
      "end_ms": 364135,
      "text": "它在四川最南端金沙江边上属于干热河谷期气候，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 364780,
      "end_ms": 368185,
      "text": "冬天的日均气温在十度到二十度之间，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 368610,
      "end_ms": 371105,
      "text": "日照时间跟三亚不相上下，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 371570,
      "end_ms": 374655,
      "text": "全年日照将近两千七百个小时。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 375220,
      "end_ms": 377440,
      "text": "您在成都冬天缩在屋里，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 377440,
      "end_ms": 378680,
      "text": "不想出门的时候，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 378900,
      "end_ms": 382415,
      "text": "同一个省的攀枝花正穿着短袖晒太阳，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 382910,
      "end_ms": 385890,
      "text": "攀枝花过冬最出名的是水果，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 386130,
      "end_ms": 390410,
      "text": "冬天正是攀枝花芒果的尾季和枇杷的旺季，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 390790,
      "end_ms": 392715,
      "text": "草莓也大量上市。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 393150,
      "end_ms": 393930,
      "text": "菜市场里，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 393950,
      "end_ms": 397490,
      "text": "冬天的水果品种比很多城市夏天还多，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 397850,
      "end_ms": 398930,
      "text": "而且便宜。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 398930,
      "end_ms": 400435,
      "text": "芒果几块钱一斤，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 400950,
      "end_ms": 402135,
      "text": "琵琶十来块，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 402700,
      "end_ms": 404235,
      "text": "草莓不到二十，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 404910,
      "end_ms": 407110,
      "text": "攀枝花还有一个别的过冬，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 407130,
      "end_ms": 408650,
      "text": "城市没有的东西，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 408670,
      "end_ms": 412145,
      "text": "阳光冬天走在攀枝花的街上，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 412500,
      "end_ms": 414815,
      "text": "阳光是直直照下来的，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 415350,
      "end_ms": 416190,
      "text": "晒在身上，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 416270,
      "end_ms": 417225,
      "text": "暖到骨头里，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 417550,
      "end_ms": 418985,
      "text": "干燥不潮湿。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 419710,
      "end_ms": 420530,
      "text": "当地人说，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 420550,
      "end_ms": 422950,
      "text": "攀枝花的冬天不穿棉袄，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 423110,
      "end_ms": 425055,
      "text": "穿衬衫不是吹牛，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 425460,
      "end_ms": 426235,
      "text": "是实话，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 426640,
      "end_ms": 427755,
      "text": "房租也不贵。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 428100,
      "end_ms": 430220,
      "text": "城区一个月一千出头，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 430560,
      "end_ms": 431760,
      "text": "一千块的房租，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 432060,
      "end_ms": 433380,
      "text": "穿衬衫的冬天，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 433660,
      "end_ms": 435220,
      "text": "几块钱一斤的芒果，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 435520,
      "end_ms": 438380,
      "text": "同一个四川成都和攀枝花，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 438700,
      "end_ms": 440205,
      "text": "简直是两个季节。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 441060,
      "end_ms": 441740,
      "text": "第六名，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 442040,
      "end_ms": 446320,
      "text": "云南盲氏、云南德宏州的州府盲市。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 446720,
      "end_ms": 448460,
      "text": "这个名字很多人没听过，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 448580,
      "end_ms": 450240,
      "text": "可要是说中缅边境，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 450260,
      "end_ms": 452045,
      "text": "您可能就有点方向感了。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 452430,
      "end_ms": 454715,
      "text": "芒市在云南的最西边，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 455140,
      "end_ms": 456380,
      "text": "离国境线不远。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 456600,
      "end_ms": 460580,
      "text": "芒市冬天的气温在十度到二十五度之间，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 460780,
      "end_ms": 463830,
      "text": "跟春天似的可忙市过冬。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 463970,
      "end_ms": 465930,
      "text": "最让人上瘾的不是温度，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 466170,
      "end_ms": 469070,
      "text": "是市场芒市的菜市场，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 469190,
      "end_ms": 471035,
      "text": "热闹的超出您想象。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 471470,
      "end_ms": 473900,
      "text": "因为靠近边境市场里面，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 473900,
      "end_ms": 475940,
      "text": "除了本地的蔬菜水果，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 476160,
      "end_ms": 482230,
      "text": "还有大量从境外过来的热带水果和香料、牛油果、山竹世家。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 482270,
      "end_ms": 487990,
      "text": "菠萝蜜品种多到您在别的城市很少能见着价格呢。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 488010,
      "end_ms": 489230,
      "text": "菠萝蜜十来块钱，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 489230,
      "end_ms": 490510,
      "text": "一大个牛油果，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 490550,
      "end_ms": 491290,
      "text": "三四块钱，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 491290,
      "end_ms": 493895,
      "text": "一个山竹五六块钱一斤。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 494290,
      "end_ms": 495735,
      "text": "您要是喜欢做饭，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 496030,
      "end_ms": 497310,
      "text": "芒市的菜市场，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 497370,
      "end_ms": 500785,
      "text": "能让您每天变着花样做一个月不重样。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 501200,
      "end_ms": 505655,
      "text": "王氏还有傣族的泼水广场、金塔、佛寺，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 506030,
      "end_ms": 510325,
      "text": "冬天街上到处是开的正旺的三角梅和凤凰花，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 510890,
      "end_ms": 518370,
      "text": "走在街上能听到傣语、缅语、普通话三种话交杂着烟火气浓的化不开。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 518790,
      "end_ms": 521175,
      "text": "租房一个月七八百到一千，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 521700,
      "end_ms": 523760,
      "text": "吃饭一天二三十块钱，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 523840,
      "end_ms": 524700,
      "text": "能吃的很好。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 524940,
      "end_ms": 525180,
      "text": "忙。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 525180,
      "end_ms": 527680,
      "text": "市过冬过的是一种边境小城，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 527800,
      "end_ms": 528620,
      "text": "特有的热闹，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 528640,
      "end_ms": 529875,
      "text": "不是游客的热闹，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 530160,
      "end_ms": 532460,
      "text": "是本地人过日子的那种热闹。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 532880,
      "end_ms": 535900,
      "text": "先在评论区打出四个字过冬，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 535940,
      "end_ms": 537410,
      "text": "秘境打完了，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 537410,
      "end_ms": 538845,
      "text": "咱们接着讲前五名，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 539240,
      "end_ms": 541340,
      "text": "一个比一个让人想直接订票。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 541840,
      "end_ms": 543480,
      "text": "今天讲的这五个城市，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 543500,
      "end_ms": 545860,
      "text": "您品品北海一千块房租，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 545940,
      "end_ms": 547355,
      "text": "加十来块的花蟹，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 547840,
      "end_ms": 549400,
      "text": "重做七八百的房租，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 549520,
      "end_ms": 551485,
      "text": "在山水里骑电动车，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 552210,
      "end_ms": 556610,
      "text": "建水五毛钱一块的烤豆腐配一千二百年的古城。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 556750,
      "end_ms": 561150,
      "text": "攀枝花穿着衬衫在四川过冬忙市七八百块钱，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 561250,
      "end_ms": 562090,
      "text": "住在边境，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 562110,
      "end_ms": 564485,
      "text": "吃一个月不重样的热带水果。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 564810,
      "end_ms": 567010,
      "text": "可这五个加一块儿都比不过，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 567010,
      "end_ms": 570370,
      "text": "前五名里那个一千块钱能泡一个冬天。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 570430,
      "end_ms": 571625,
      "text": "野温泉的地方，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 572080,
      "end_ms": 574775,
      "text": "前五名里有一个海南的小城，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 575310,
      "end_ms": 577725,
      "text": "房租是三亚的三分之一。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 578330,
      "end_ms": 579130,
      "text": "海滩上，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 579330,
      "end_ms": 583305,
      "text": "一个游客都没有有一个福建的城市，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 583930,
      "end_ms": 587190,
      "text": "闽南的烟火气比厦门浓十倍，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 587370,
      "end_ms": 589475,
      "text": "物价只有厦门的一半儿。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 589940,
      "end_ms": 592160,
      "text": "有一个地方冬天的空气好，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 592160,
      "end_ms": 593420,
      "text": "到您每天醒来。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 593420,
      "end_ms": 595325,
      "text": "第一件事儿是深呼吸，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 595830,
      "end_ms": 597445,
      "text": "还有一个边境小城，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 598070,
      "end_ms": 600250,
      "text": "山水比桂林安静十倍。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 600510,
      "end_ms": 602605,
      "text": "米粉比桂林还好吃，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 603260,
      "end_ms": 606250,
      "text": "下一集已经同步更新了点，"
    },
    {
      "segment_id": "s000239",
