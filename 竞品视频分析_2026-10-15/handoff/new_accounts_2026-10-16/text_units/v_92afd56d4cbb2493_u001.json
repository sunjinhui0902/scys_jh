{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_92afd56d4cbb2493_u001",
  "video_id": "v_92afd56d4cbb2493",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 751.862993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 1710,
      "text": "上一集咱们聊了诛文，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1750,
      "end_ms": 9190,
      "text": "陶钵玉朱龙跪坐、玉人器型、博画、云纹铜镜从第十数到第六，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 9490,
      "end_ms": 11110,
      "text": "每一件都够诡异了，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 12190,
      "end_ms": 14470,
      "text": "可跟接下来的前五名笔，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 14910,
      "end_ms": 17170,
      "text": "那些真的只是开胃菜。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 18030,
      "end_ms": 19550,
      "text": "这集直接解绑，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 20030,
      "end_ms": 22070,
      "text": "尤其是排在第一的那件。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 22070,
      "end_ms": 22570,
      "text": "看一眼，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 22570,
      "end_ms": 23230,
      "text": "您就会说，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 23230,
      "end_ms": 24990,
      "text": "这不可能是古代的东西，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 25710,
      "end_ms": 28170,
      "text": "他跟你家喝水的玻璃杯一模一样，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 28430,
      "end_ms": 30000,
      "text": "可他是排千多年前的，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 31660,
      "end_ms": 35560,
      "text": "咱们从第五名开始往上数第五名。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 35660,
      "end_ms": 44060,
      "text": "曾侯乙鉴骨底座湖北随州一九七八年曾侯乙墓出土了一万五千多件东西。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 44240,
      "end_ms": 45600,
      "text": "编钟最出名，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 46100,
      "end_ms": 49080,
      "text": "可有一件东西被编钟的光芒盖住，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 49720,
      "end_ms": 55840,
      "text": "很多人不知道剑骨底座用来架骨的底盘，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 56780,
      "end_ms": 60010,
      "text": "青铜铸的一百九十二公斤，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 60030,
      "end_ms": 62365,
      "text": "亲将近四百斤。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 63520,
      "end_ms": 64735,
      "text": "这东西长什么样？"
    },
    {
      "segment_id": "s000021",
      "start_ms": 66550,
      "end_ms": 70400,
      "text": "八队大龙十六条龙身体互相缠绕，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 70720,
      "end_ms": 72145,
      "text": "穿插盘旋，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 72600,
      "end_ms": 73320,
      "text": "你中有我，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 73320,
      "end_ms": 74085,
      "text": "我中有你，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 74380,
      "end_ms": 75885,
      "text": "密密麻麻纠缠在一起。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 76260,
      "end_ms": 78320,
      "text": "每条龙的身体还是镂空的龙，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 78320,
      "end_ms": 80745,
      "text": "身上还爬着无数条小蛇，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 81650,
      "end_ms": 85354,
      "text": "整件东西就是一团铜铸的龙舌纠缠体。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 86170,
      "end_ms": 88805,
      "text": "可每一条龙的走向都清清楚楚，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 89280,
      "end_ms": 90455,
      "text": "没有一条断掉，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 90870,
      "end_ms": 92165,
      "text": "没有一条并措。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 92810,
      "end_ms": 99030,
      "text": "一百九十二公斤十六条龙加上数不清的小蛇缠在一起，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 99050,
      "end_ms": 100365,
      "text": "还能条条分明，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 101230,
      "end_ms": 104835,
      "text": "这怎么住的吵到现在没有定论。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 105700,
      "end_ms": 107235,
      "text": "有人说是施蜡法，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 107660,
      "end_ms": 109645,
      "text": "有人说是分住在汉街的，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 110160,
      "end_ms": 111760,
      "text": "双方各有证据，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 112100,
      "end_ms": 113455,
      "text": "谁也说服不了谁。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 114320,
      "end_ms": 116355,
      "text": "两千四百多年前的一个古作，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 116880,
      "end_ms": 119920,
      "text": "把当代最顶尖的青铜研究专家难住，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 119980,
      "end_ms": 122485,
      "text": "光是他怎么做出来的这一个问题，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 122880,
      "end_ms": 124535,
      "text": "就发了上百篇论文，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 125500,
      "end_ms": 128105,
      "text": "还没炒完一个架骨的底盘，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 128930,
      "end_ms": 132770,
      "text": "一百九十二公斤十六条龙缠在一起，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 132770,
      "end_ms": 133745,
      "text": "条条分明，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 134280,
      "end_ms": 136105,
      "text": "做法炒了几十年没定论，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 136590,
      "end_ms": 137915,
      "text": "您说这诡异不诡异？"
    },
    {
      "segment_id": "s000048",
      "start_ms": 138440,
      "end_ms": 149910,
      "text": "第四名秦朝同车马陕西西安、一九八零年秦始皇陵旁边出土了两辆青铜马车编号一号车和二号车。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 150250,
      "end_ms": 151715,
      "text": "二号车最震撼。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 152200,
      "end_ms": 156110,
      "text": "通常三点一七米是真车的一半大小。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 156190,
      "end_ms": 158375,
      "text": "四匹马拉着一辆带棚的车，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 159050,
      "end_ms": 160410,
      "text": "车上坐着一个铜人，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 160410,
      "end_ms": 163595,
      "text": "御手这辆车一共三千多个零件，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 164350,
      "end_ms": 166115,
      "text": "每一个零件都能拆下来。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 166420,
      "end_ms": 167860,
      "text": "车轮能转车门，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 167860,
      "end_ms": 170235,
      "text": "能开车窗能推嗯，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 170570,
      "end_ms": 171190,
      "text": "窗户上，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 171190,
      "end_ms": 173170,
      "text": "还有镂空的菱形花纹。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 173170,
      "end_ms": 174650,
      "text": "当纱窗透气，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 174770,
      "end_ms": 179540,
      "text": "用马身上的配膀是金银铸的缰绳，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 179600,
      "end_ms": 182295,
      "text": "是一节一节的铜环串起来的，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 182670,
      "end_ms": 184095,
      "text": "每一节都能活动。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 184590,
      "end_ms": 187675,
      "text": "车盖是一整块青铜版，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 188470,
      "end_ms": 190765,
      "text": "面积二点三平方米，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 191620,
      "end_ms": 194035,
      "text": "最薄的地方只有一毫米，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 194820,
      "end_ms": 195820,
      "text": "可弧度均匀，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 195900,
      "end_ms": 197065,
      "text": "没有一道裂纹。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 198110,
      "end_ms": 199570,
      "text": "两千两百多年前，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 199570,
      "end_ms": 200635,
      "text": "没有冲压机，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 201410,
      "end_ms": 202750,
      "text": "这么大一块铜板，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 202830,
      "end_ms": 204655,
      "text": "怎么垂出这个弧度的，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 205300,
      "end_ms": 206395,
      "text": "没人说得清。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 207320,
      "end_ms": 208540,
      "text": "更诡异的是，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 208580,
      "end_ms": 209265,
      "text": "细节，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 210150,
      "end_ms": 213505,
      "text": "您看马嘴里的咸口舌头是能动的。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 214260,
      "end_ms": 215420,
      "text": "马脖子上的鬃毛，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 215460,
      "end_ms": 217315,
      "text": "一根一根排列整齐，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 218150,
      "end_ms": 220615,
      "text": "铜人玉手的指甲盖都刻出来，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 221420,
      "end_ms": 223905,
      "text": "手指关节的褶皱都能看见。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 225000,
      "end_ms": 226485,
      "text": "两千两百多年前，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 226920,
      "end_ms": 230585,
      "text": "秦朝工匠造了一辆等比缩小的模型车，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 231190,
      "end_ms": 232510,
      "text": "三千多个零件，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 232590,
      "end_ms": 235910,
      "text": "能拆能装精细到指甲盖上的纹路，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 235930,
      "end_ms": 236965,
      "text": "这不是工艺品。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 237600,
      "end_ms": 241315,
      "text": "这是一辆两千两百年前的工业样机，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 242160,
      "end_ms": 245495,
      "text": "一辆青铜车三千多个零件，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 246240,
      "end_ms": 247480,
      "text": "车窗能推马嘴，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 247480,
      "end_ms": 248025,
      "text": "能动，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 248850,
      "end_ms": 250055,
      "text": "指甲盖儿都刻出来。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 250520,
      "end_ms": 254244,
      "text": "两千两百年前的人到底在认真到什么程度？"
    },
    {
      "segment_id": "s000091",
      "start_ms": 255190,
      "end_ms": 255855,
      "text": "第三名，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 256860,
      "end_ms": 263735,
      "text": "蛋壳黑桃杯山东日照这件东西的年代比前面所有文物都老，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 264840,
      "end_ms": 270475,
      "text": "距今四千多年新石器时代龙山文化一只高脚杯，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 271170,
      "end_ms": 272305,
      "text": "通体漆黑，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 272990,
      "end_ms": 275410,
      "text": "表面光滑的向上了釉，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 276270,
      "end_ms": 277310,
      "text": "可它没有上釉，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 277390,
      "end_ms": 279385,
      "text": "那层光泽是烧出来的，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 280210,
      "end_ms": 281505,
      "text": "他诡异在哪儿？"
    },
    {
      "segment_id": "s000099",
      "start_ms": 282790,
      "end_ms": 286554,
      "text": "薄杯壁最薄的地方只有零点二毫米，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 287090,
      "end_ms": 288370,
      "text": "您拿一张a货纸，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 288370,
      "end_ms": 292965,
      "text": "比a four纸的厚度大概是零点一毫米。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 293420,
      "end_ms": 296255,
      "text": "这只杯子只比两张纸厚一点。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 297110,
      "end_ms": 299210,
      "text": "整只杯子拿在手里，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 299230,
      "end_ms": 300410,
      "text": "几乎没有重量，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 301190,
      "end_ms": 304070,
      "text": "轻轻一弹嗡的一声，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 304790,
      "end_ms": 306390,
      "text": "跟金属似的能响。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 307870,
      "end_ms": 309810,
      "text": "四千多年前没有拉皮机，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 310210,
      "end_ms": 311070,
      "text": "没有电窑，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 311350,
      "end_ms": 313690,
      "text": "陶土是手工一点一点捏的，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 314010,
      "end_ms": 316430,
      "text": "烧窑是柴火烧的温度，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 316430,
      "end_ms": 317890,
      "text": "全凭经验控制。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 317950,
      "end_ms": 319210,
      "text": "在这种条件下，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 319590,
      "end_ms": 323030,
      "text": "把一只杯子的壁做到零点二毫米，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 323790,
      "end_ms": 325310,
      "text": "烧的时候还不能塌，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 326050,
      "end_ms": 326715,
      "text": "不能裂，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 327440,
      "end_ms": 328380,
      "text": "不能变形。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 329380,
      "end_ms": 330880,
      "text": "您想想这有多难。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 331840,
      "end_ms": 340220,
      "text": "后来有人试过用现代设备复制专业的陶艺师用现代拉坯机烧了很多次，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 340860,
      "end_ms": 345440,
      "text": "能做到零点五毫米就已经是极限了零点二毫米，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 345440,
      "end_ms": 348940,
      "text": "做不到四千年前的人用手搓出来的东西，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 349500,
      "end_ms": 351040,
      "text": "现代机器复制不了，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 352000,
      "end_ms": 353260,
      "text": "这句话听着离谱，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 354060,
      "end_ms": 355835,
      "text": "可事实就是这样。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 356540,
      "end_ms": 357600,
      "text": "更诡异的是，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 357720,
      "end_ms": 363845,
      "text": "这种极薄的黑陶杯在龙山文化里不是一件两件好几个遗址都出过，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 364130,
      "end_ms": 367715,
      "text": "说明这不是某一个天才工匠的偶然杰作，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 368150,
      "end_ms": 370375,
      "text": "而是当时的一种成熟工艺。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 370930,
      "end_ms": 372895,
      "text": "后来这种工艺彻底失传了，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 373190,
      "end_ms": 377115,
      "text": "再也没出现过一只四千年前的杯子。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 377550,
      "end_ms": 379635,
      "text": "壁薄零点二毫米，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 380370,
      "end_ms": 384700,
      "text": "现代机器复制不了公艺失传了。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 384700,
      "end_ms": 385325,
      "text": "四千年，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 385760,
      "end_ms": 387180,
      "text": "您说这叫诡异，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 387420,
      "end_ms": 389080,
      "text": "还是叫恐怖？"
    },
    {
      "segment_id": "s000135",
      "start_ms": 390190,
      "end_ms": 390765,
      "text": "第二名，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 392440,
      "end_ms": 393785,
      "text": "青铜卡尺，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 395180,
      "end_ms": 396105,
      "text": "江苏淳江。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 397940,
      "end_ms": 399000,
      "text": "一九九二年，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 399120,
      "end_ms": 402565,
      "text": "江苏沁江一座汉墓出土了一件小铜器，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 403230,
      "end_ms": 405590,
      "text": "考古人员第一眼看见他的时候，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 405590,
      "end_ms": 406545,
      "text": "以为搞错了。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 407420,
      "end_ms": 411125,
      "text": "这东西长十三点三厘米一根固定尺，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 411670,
      "end_ms": 412825,
      "text": "一根活动尺，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 413060,
      "end_ms": 416900,
      "text": "活动尺可以左右滑动尺上有刻度合起来，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 416900,
      "end_ms": 417640,
      "text": "能量外径，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 417800,
      "end_ms": 418580,
      "text": "张开能量，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 418580,
      "end_ms": 420135,
      "text": "内径还能量深度，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 420470,
      "end_ms": 421495,
      "text": "您听着耳熟吧。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 422510,
      "end_ms": 423995,
      "text": "这就是游标卡尺，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 424390,
      "end_ms": 426675,
      "text": "您去五金店花十几块钱买一把，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 427000,
      "end_ms": 429145,
      "text": "跟它的结构几乎一模一样，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 430080,
      "end_ms": 432095,
      "text": "可这件东西是稀罕的。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 433310,
      "end_ms": 436885,
      "text": "距今两千多年同样原理的测量工具，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 437580,
      "end_ms": 440185,
      "text": "欧洲人到了十七世纪才发明出来。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 440890,
      "end_ms": 445500,
      "text": "法国人约尼埃在一千六百三十一年造出了第一把游镖。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 445500,
      "end_ms": 449825,
      "text": "卡尺比这件铜卡尺晚了将近一千八百年，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 450340,
      "end_ms": 453615,
      "text": "两千多年前的汉朝人拿这把尺子量什么，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 454390,
      "end_ms": 454975,
      "text": "不知道，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 456020,
      "end_ms": 457965,
      "text": "墓里没有留下任何说明，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 458850,
      "end_ms": 465695,
      "text": "可光看这把尺子的结构固定尺游标尺、滑动机构刻度线，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 466640,
      "end_ms": 469335,
      "text": "每一个要素跟现代的都能对上。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 470190,
      "end_ms": 474100,
      "text": "这是目前世界上已知最早的卡尺型测量工具，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 474180,
      "end_ms": 476430,
      "text": "没有之一一把。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 476510,
      "end_ms": 483305,
      "text": "二零零零年前的铜尺子跟现代游标卡尺结构一模一样，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 484180,
      "end_ms": 486595,
      "text": "比欧洲早了一千八百年。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 487880,
      "end_ms": 489535,
      "text": "您说这要怎么解释？"
    },
    {
      "segment_id": "s000167",
      "start_ms": 490470,
      "end_ms": 492230,
      "text": "先在评论区打出四个字，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 492430,
      "end_ms": 493315,
      "text": "细思极恐。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 493780,
      "end_ms": 496055,
      "text": "打完了看看第一名到底是什么？"
    },
    {
      "segment_id": "s000170",
      "start_ms": 496910,
      "end_ms": 497575,
      "text": "第一名，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 498590,
      "end_ms": 499945,
      "text": "战国水晶杯，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 500930,
      "end_ms": 507730,
      "text": "浙江杭州一九九零年杭州半山镇一座战国墓葬。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 507750,
      "end_ms": 511665,
      "text": "发掘考古人员打开棺椁，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 512090,
      "end_ms": 515145,
      "text": "在一堆随葬品中间看见了一个东西，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 516020,
      "end_ms": 520950,
      "text": "所有人第一反应都是谁把现代的玻璃杯吊进去。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 521110,
      "end_ms": 522830,
      "text": "这只杯子通体透明，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 523150,
      "end_ms": 524115,
      "text": "微微发黄，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 524510,
      "end_ms": 528735,
      "text": "敞口直筒圆底高十五点四厘米，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 529160,
      "end_ms": 530585,
      "text": "口径七点八厘。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 531380,
      "end_ms": 532660,
      "text": " B面光滑，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 532860,
      "end_ms": 533580,
      "text": "没有花纹，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 534010,
      "end_ms": 534710,
      "text": "没有装饰，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 534890,
      "end_ms": 536835,
      "text": "就是一只干干净净的杯子。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 537470,
      "end_ms": 539430,
      "text": "您把它放在宜家的货架上，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 539490,
      "end_ms": 541905,
      "text": "没有任何人会看出它有什么特别的，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 542260,
      "end_ms": 544065,
      "text": "就是一只普通的玻璃杯，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 544720,
      "end_ms": 545820,
      "text": "可它不是玻璃，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 546020,
      "end_ms": 551795,
      "text": "是水晶的整块天然水晶掏出来不是拼的，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 552020,
      "end_ms": 554060,
      "text": "不是粘的一整块。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 554080,
      "end_ms": 557420,
      "text": "水晶从外面一点一点掏空，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 557560,
      "end_ms": 559505,
      "text": "掏成了一只杯子的形状，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 559970,
      "end_ms": 561755,
      "text": "内壁打磨的光滑透亮，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 562310,
      "end_ms": 564565,
      "text": "看不见一道工具的划痕。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 565480,
      "end_ms": 568255,
      "text": "水晶的硬度是漆比钢还硬。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 569190,
      "end_ms": 571715,
      "text": "两千多年前没有金刚石工具，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 572180,
      "end_ms": 573695,
      "text": "没有电动打磨机。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 574110,
      "end_ms": 575630,
      "text": "战国时期的工匠，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 575650,
      "end_ms": 580815,
      "text": "是用什么东西把一块比钢还硬的石头掏成了一只薄壁杯子，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 582050,
      "end_ms": 582725,
      "text": "解释不了。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 583900,
      "end_ms": 584500,
      "text": "有人猜，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 584500,
      "end_ms": 586565,
      "text": "是用解玉砂一点一点磨的，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 587010,
      "end_ms": 588210,
      "text": "可磨到内壁，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 588210,
      "end_ms": 592655,
      "text": "这么光滑看不见痕迹需要多长时间？"
    },
    {
      "segment_id": "s000204",
      "start_ms": 593070,
      "end_ms": 594230,
      "text": "没人算得出来。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 594270,
      "end_ms": 596285,
      "text": "更让人说不清的是他的造型。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 597050,
      "end_ms": 598970,
      "text": "您见过的所有古代器皿，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 599090,
      "end_ms": 601810,
      "text": "多多少少都有那个年代的风格，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 601850,
      "end_ms": 604960,
      "text": "花纹兽首铭纹图案。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 605910,
      "end_ms": 607370,
      "text": "可这只杯子什么都没有，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 607710,
      "end_ms": 608570,
      "text": "素面朝天，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 609010,
      "end_ms": 610190,
      "text": "简洁到了极点，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 610550,
      "end_ms": 614430,
      "text": "简洁到跟两千多年后的现代审美完全一致。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 615310,
      "end_ms": 618870,
      "text": "两千多年前的一个战国人不知道用什么办法，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 619590,
      "end_ms": 622630,
      "text": "从一块天然水晶里掏出了一只杯子，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 623190,
      "end_ms": 627050,
      "text": "这只杯子的造型放在今天的商场里毫无尾痕。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 627110,
      "end_ms": 631250,
      "text": "他现在在杭州博物馆单独一个展柜，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 632090,
      "end_ms": 634010,
      "text": "常年有保安站在旁边。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 634870,
      "end_ms": 636140,
      "text": "从零零二年，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 636740,
      "end_ms": 641280,
      "text": "他被列入首批禁止出国展览文物名单。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 642840,
      "end_ms": 646060,
      "text": "全中国只有这一件战国水晶杯，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 646300,
      "end_ms": 647440,
      "text": "为什么排第一？"
    },
    {
      "segment_id": "s000222",
      "start_ms": 648000,
      "end_ms": 649480,
      "text": "因为前面九件，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 650180,
      "end_ms": 651400,
      "text": "不管多诡异，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 652020,
      "end_ms": 654080,
      "text": "您都能说古人手艺好，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 654120,
      "end_ms": 655820,
      "text": "四个字糊弄过去，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 656780,
      "end_ms": 657940,
      "text": "可这只杯子不行，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 658160,
      "end_ms": 660000,
      "text": "它不是手艺好不好的问题。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 660360,
      "end_ms": 661200,
      "text": "它的造型，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 661600,
      "end_ms": 662640,
      "text": "它的光洁度，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 662960,
      "end_ms": 665460,
      "text": "它的审美全方位的，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 665460,
      "end_ms": 668670,
      "text": "不像一件两千多年前的东西，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 668670,
      "end_ms": 670055,
      "text": "他站在那个展柜里，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 670430,
      "end_ms": 672575,
      "text": "像是从未来掉进了过去。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 673730,
      "end_ms": 675115,
      "text": "实践文物讲完了，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 675970,
      "end_ms": 677270,
      "text": "七千年前的猪，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 677450,
      "end_ms": 678725,
      "text": "长得像表情包，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 679380,
      "end_ms": 681360,
      "text": "五千年前的龙长得像猪，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 681740,
      "end_ms": 684675,
      "text": "三千年前的发型跟今天一模一样。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 685240,
      "end_ms": 686500,
      "text": "两千一百年前，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 686500,
      "end_ms": 690100,
      "text": "一块博画画了三个世界两千五百年前，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 690120,
      "end_ms": 693145,
      "text": "一张铜桌子镂空到向三d打印。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 693770,
      "end_ms": 695210,
      "text": "两千四百年前，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 695210,
      "end_ms": 697530,
      "text": "一个古座十六条龙缠在一起，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 697550,
      "end_ms": 700160,
      "text": "做法到现在还在炒两千两。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 700160,
      "end_ms": 700780,
      "text": "百年前，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 700780,
      "end_ms": 706980,
      "text": "一辆童车三千多个零件能拆能装四千年前一只杯子薄到零点二毫米。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 706980,
      "end_ms": 708375,
      "text": "现代机器复制不了，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 708820,
      "end_ms": 710120,
      "text": "二零零零年前，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 710140,
      "end_ms": 713135,
      "text": "一把尺子比欧洲早了一千八百年，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 714110,
      "end_ms": 719615,
      "text": "可压在所有人头顶上的是一只从水晶里掏出来的杯子，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 720270,
      "end_ms": 721350,
      "text": "放在商场里。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 721350,
      "end_ms": 724095,
      "text": "你分不出它是古代的还是现代的？"
    },
    {
      "segment_id": "s000253",
      "start_ms": 725010,
      "end_ms": 726070,
      "text": "评论区告诉我，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 726710,
      "end_ms": 730450,
      "text": "这十件文物哪一件最让您觉得细思极恐，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 730970,
      "end_ms": 732170,
      "text": "觉得长知识了，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 732290,
      "end_ms": 732889,
      "text": "点个赞，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 733230,
      "end_ms": 734090,
      "text": "点个收藏，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 734990,
      "end_ms": 738770,
      "text": "转给您身边那位最爱刷手机的老伙计，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 738830,
      "end_ms": 739770,
      "text": "就跟他说一句，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 740890,
      "end_ms": 742290,
      "text": "别光刷段子了，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 743010,
      "end_ms": 744510,
      "text": "看看老祖宗干的活，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 745170,
      "end_ms": 747790,
      "text": "想看更多让人说不清的老物家，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 748470,
      "end_ms": 749290,
      "text": "点个关注，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 750030,
      "end_ms": 751775,
      "text": "咱们下回接着聊。"
    }
  ],
  "source_transcript_sha256": "188e17ecaacea33f66b56702f7be56ce39ec5c12052212500caf5ba37e511195"
}