{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_9914a4b5d84ec970_u001",
  "video_id": "v_9914a4b5d84ec970",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 321.572993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 310,
      "end_ms": 1830,
      "text": "为什么夺回目光的主权，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1890,
      "end_ms": 4110,
      "text": "是挣脱他人地狱的唯一出路？"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4130,
      "end_ms": 6930,
      "text": "萨特在禁闭中提出了一个令人窒息的洞见，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7330,
      "end_ms": 10690,
      "text": "我们终其一生都在他人的凝视中被悄然改写，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 10930,
      "end_ms": 12190,
      "text": "却对此浑然不觉。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12510,
      "end_ms": 13210,
      "text": "萨特指出，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 13450,
      "end_ms": 17690,
      "text": "在与他人的共存状态下人总是不可避免的陷入客体化的牢笼。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18050,
      "end_ms": 20630,
      "text": "我们顺从于他人目光所铺设的轨道。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 20850,
      "end_ms": 22970,
      "text": "按照别人眼中的我去表演，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 23090,
      "end_ms": 23790,
      "text": "去讨好，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23970,
      "end_ms": 25650,
      "text": "去维持一个体面的面具，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 25730,
      "end_ms": 27210,
      "text": "以为自己在自由的生活。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 27530,
      "end_ms": 28230,
      "text": "但实际上，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 28290,
      "end_ms": 31180,
      "text": "我们只是把自己活成了一个被他人评价体系，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 31360,
      "end_ms": 33160,
      "text": "精密操控的提现木偶。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 33480,
      "end_ms": 35500,
      "text": "我们用大家都是这么看的，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 35500,
      "end_ms": 36460,
      "text": "来麻痹自己，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 36820,
      "end_ms": 40100,
      "text": "把独一无二的主体性稀释成了一场毫无风险，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 40320,
      "end_ms": 43160,
      "text": "却也毫无灵魂的他人目光的傀儡室，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 43940,
      "end_ms": 47220,
      "text": "而让人彻底陷入这种客体化泥潭的根本原因，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 47820,
      "end_ms": 51240,
      "text": "正是我们对他人凝视的系统性、屈服与迎合。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 51640,
      "end_ms": 53380,
      "text": "在萨特的独墓剧禁闭中，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 53640,
      "end_ms": 56260,
      "text": "三个鬼魂被关进一间没有镜子的密室，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 56720,
      "end_ms": 58060,
      "text": "他们本应各自安息，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 58340,
      "end_ms": 61695,
      "text": "却在地狱中上演了一场永无终点的相互折磨。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 62000,
      "end_ms": 64560,
      "text": "加尔森竭力想让他人相信自己是英雄，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 64780,
      "end_ms": 66935,
      "text": "实际上是个临阵脱逃的胆小鬼。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 67360,
      "end_ms": 69820,
      "text": "伊内斯试图用锐利的目光刺穿一切，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 69820,
      "end_ms": 71260,
      "text": "伪装艾斯，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 71260,
      "end_ms": 74625,
      "text": "戴尔则不断用色情引诱来填补空洞的自我。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 74960,
      "end_ms": 76005,
      "text": "他们彼此追问，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 76240,
      "end_ms": 76920,
      "text": "彼此审判，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 77120,
      "end_ms": 77895,
      "text": "彼此定罪。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 78460,
      "end_ms": 81715,
      "text": "每个人都把对方当做确认自我存在的唯一镜子，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 82210,
      "end_ms": 85475,
      "text": "却在对方的注视中一步步失去了最后的自由。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 85810,
      "end_ms": 88305,
      "text": "萨特揭穿了这种人际关系的防御机制，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 88940,
      "end_ms": 91420,
      "text": "他人的目光被我们悄悄降格为一面，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 91420,
      "end_ms": 93115,
      "text": "可以随意操控的镜子。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 93490,
      "end_ms": 94865,
      "text": "我只要表演的足够好，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 95190,
      "end_ms": 96295,
      "text": "别人就会认可我，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 96540,
      "end_ms": 98420,
      "text": "我只要把对方贬低自己，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 98420,
      "end_ms": 99325,
      "text": "就显得高贵。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 99680,
      "end_ms": 103020,
      "text": "正是这种他人之眼可以被驯服的虚妄幻觉，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 103300,
      "end_ms": 105935,
      "text": "让人陷入了不可逆的自我异化之中。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 106460,
      "end_ms": 109655,
      "text": "因为你潜意识里觉得他人的目光是可以被操纵的，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 110180,
      "end_ms": 113095,
      "text": "所以你敢于在阿谀奉承中出卖真实的感受，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 113600,
      "end_ms": 116160,
      "text": "敢于在社交表演中耗尽生命的真诚。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 116500,
      "end_ms": 119685,
      "text": "敢于把别人会怎么看我奉为最高法庭，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 120210,
      "end_ms": 122705,
      "text": "而将自己真正的欲望无限期关押。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 123050,
      "end_ms": 125335,
      "text": "恰特在存在与虚无中进一步指出，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 125930,
      "end_ms": 128565,
      "text": "他人的注视具有一种根本性的暴力。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 128910,
      "end_ms": 130065,
      "text": "当他人看我时，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 130690,
      "end_ms": 135005,
      "text": "我从一个自由的主体瞬间被凝固为一个被审视的客体。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 135440,
      "end_ms": 136885,
      "text": "我的可能性被剥夺，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 137210,
      "end_ms": 140080,
      "text": "我成为他人意识中的一个物我。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 140080,
      "end_ms": 141520,
      "text": "原本是自维的存在，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 141720,
      "end_ms": 143000,
      "text": "是不断超越自身，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 143180,
      "end_ms": 144505,
      "text": "创造自身的存在。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 144820,
      "end_ms": 145925,
      "text": "但在他人的注视下，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 146170,
      "end_ms": 148265,
      "text": "我被降格为自在的存在，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 148620,
      "end_ms": 151565,
      "text": "一个将死的被定义了的存在物。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 151980,
      "end_ms": 154295,
      "text": "这正是他人及地狱的深层含义，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 154610,
      "end_ms": 156505,
      "text": "并非他人本身是邪恶的，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 156900,
      "end_ms": 158520,
      "text": "而是他人对我的客体化。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 158740,
      "end_ms": 161480,
      "text": "将我困在了一个我无法选择的身份之中。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 161600,
      "end_ms": 165115,
      "text": "萨特鲜明的表达了他者是冲突的根源的思想。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 165580,
      "end_ms": 167435,
      "text": "因为自我和他人都是主体，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 167730,
      "end_ms": 169610,
      "text": "都渴望成为凝视的发出者，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 169610,
      "end_ms": 170585,
      "text": "而非承受者。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 171280,
      "end_ms": 174560,
      "text": "双方通过凝视来实现把别人当成意识的对象，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 174700,
      "end_ms": 176905,
      "text": "甚至把别人虚化为一个存在物。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 177310,
      "end_ms": 178530,
      "text": "这种主体性的争夺，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 178710,
      "end_ms": 183230,
      "text": "使人与人的关系在本质上成为一种无休止的相互对象化循环。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 183430,
      "end_ms": 183830,
      "text": "然而，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 184010,
      "end_ms": 186295,
      "text": "萨特并非一个绝望的悲观主义者，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 186630,
      "end_ms": 187410,
      "text": "他同时指出，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 187690,
      "end_ms": 190510,
      "text": "他人是我与自我之间不可互缺的中介。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 190590,
      "end_ms": 191590,
      "text": "没有他人的目光，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 191710,
      "end_ms": 193490,
      "text": "我甚至无法认识自己是谁。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 193870,
      "end_ms": 195110,
      "text": "我通过他人的眼睛，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 195210,
      "end_ms": 196350,
      "text": "看到自己的面貌，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 196530,
      "end_ms": 197590,
      "text": "通过他人的评价，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 197590,
      "end_ms": 198655,
      "text": "理解自己的价值，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 199170,
      "end_ms": 201400,
      "text": "这意味着他人既是我的地域，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 201540,
      "end_ms": 203425,
      "text": "也是我自我认知的条件。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 203850,
      "end_ms": 205735,
      "text": "问题的关键不在于消灭他人，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 206000,
      "end_ms": 208455,
      "text": "而在于我如何面对他人的凝视，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 208760,
      "end_ms": 211375,
      "text": "还是坚决夺回自己作为主体的目光。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 212000,
      "end_ms": 212700,
      "text": "萨特所说，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 212960,
      "end_ms": 213940,
      "text": "他人就是地狱，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 214240,
      "end_ms": 215840,
      "text": "并非指人与人的关系，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 215840,
      "end_ms": 216865,
      "text": "总是敌对的，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 217480,
      "end_ms": 219955,
      "text": "他人是对一个人自由的限制或否定。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 220250,
      "end_ms": 220815,
      "text": "但同时，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 221200,
      "end_ms": 223240,
      "text": "他人对一个人的自由既是限制，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 223240,
      "end_ms": 223995,
      "text": "又是条件，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 224470,
      "end_ms": 225250,
      "text": "既是否定，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 225290,
      "end_ms": 228125,
      "text": "又是否定之否定及更高层次的肯定。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 228510,
      "end_ms": 230190,
      "text": "如果我们居于他人的注视，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 230410,
      "end_ms": 231905,
      "text": "过于注重别人的评论，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 232190,
      "end_ms": 233785,
      "text": "那就会成为别人的受害者。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 234090,
      "end_ms": 235085,
      "text": "他人就是地狱。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 235680,
      "end_ms": 238155,
      "text": "但如果我们能够打碎他人注视的威胁，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 238420,
      "end_ms": 240720,
      "text": "去争取自身的解放他人，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 240720,
      "end_ms": 243445,
      "text": "就仅仅是一个我可以自由选择的处境。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 243980,
      "end_ms": 244720,
      "text": "挣脱他人。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 244720,
      "end_ms": 247515,
      "text": "地狱从来不是对他人的逃避或憎恨，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 247820,
      "end_ms": 250295,
      "text": "而是对客体化命运最激烈的反抗。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 251130,
      "end_ms": 253205,
      "text": "当别人怎么看的焦虑悬于头顶，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 253520,
      "end_ms": 256820,
      "text": "所有外界强加给你的标签、虚荣的胜负欲，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 256980,
      "end_ms": 258600,
      "text": "以及对被否定的恐惧，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 258740,
      "end_ms": 261215,
      "text": "都会在瞬间被剥落的一干二净。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 261600,
      "end_ms": 264080,
      "text": "你不再有余力去迎合所有人的期待，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 264280,
      "end_ms": 268205,
      "text": "不再有时间去为他人评价中的一丝波动而辗转反侧。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 268800,
      "end_ms": 270415,
      "text": "他人的凝视是不可避免的，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 270630,
      "end_ms": 273845,
      "text": "但这并不意味着我必须成为一个被凝视的囚徒，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 274250,
      "end_ms": 277470,
      "text": "关键在于我是否能够在被凝视的同时，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 277890,
      "end_ms": 280205,
      "text": "始终保持自己凝视他人的能力。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 280700,
      "end_ms": 284185,
      "text": "我是否能够拒绝成为他人眼中的那个固定的物，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 284680,
      "end_ms": 288055,
      "text": "始终坚持自己作为自为的存在的无限可能。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 288600,
      "end_ms": 292545,
      "text": "他人及地狱的本质是对自身主体性的遗忘与放弃。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 293250,
      "end_ms": 294305,
      "text": "而本真的活着，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 294480,
      "end_ms": 296360,
      "text": "是带着我即自由的清醒，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 296640,
      "end_ms": 298595,
      "text": "夺回你对自身目光的主权，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 299090,
      "end_ms": 301535,
      "text": "不要等到被他人的评判彻底淹没，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 301820,
      "end_ms": 302800,
      "text": "才去懊悔自己。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 302800,
      "end_ms": 304355,
      "text": "从未真正做过自己，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 305000,
      "end_ms": 305755,
      "text": "从此刻起，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 306120,
      "end_ms": 308125,
      "text": "直面那些无处不在的注释。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 308820,
      "end_ms": 310395,
      "text": "当你不再畏惧他人的目光，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 310660,
      "end_ms": 313095,
      "text": "你才算真正挣脱了客体化的枷锁。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 313600,
      "end_ms": 314740,
      "text": "在众目睽睽之下，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 314880,
      "end_ms": 318235,
      "text": "活出属于你自己的绝对清醒与自由。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 318690,
      "end_ms": 319390,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 319530,
      "end_ms": 320790,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 320790,
      "end_ms": 321455,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "c3d29ce93387fa0f68cfd07da1935e8124617a2c1bce8463be1a3a17eab1a5e2"
}