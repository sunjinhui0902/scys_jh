{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ebbf44d69331baee_u002",
  "video_id": "v_ebbf44d69331baee",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 987.894875,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000379",
      "start_ms": 849520,
      "end_ms": 851235,
      "text": "如果你看到这里还没有划走，"
    },
    {
      "segment_id": "s000380",
      "start_ms": 851550,
      "end_ms": 852890,
      "text": "说明你心里有一个问题，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 852930,
      "end_ms": 854010,
      "text": "一直没有被回答，"
    },
    {
      "segment_id": "s000382",
      "start_ms": 854290,
      "end_ms": 855490,
      "text": "我们到底该怎么面对？"
    },
    {
      "segment_id": "s000383",
      "start_ms": 855490,
      "end_ms": 859605,
      "text": "那些无法被简单归类却又无法被轻易否定的事情。"
    },
    {
      "segment_id": "s000384",
      "start_ms": 859950,
      "end_ms": 861725,
      "text": "忏悔录就是为这个问题写的，"
    },
    {
      "segment_id": "s000385",
      "start_ms": 862060,
      "end_ms": 863365,
      "text": "他不是让你姓什么，"
    },
    {
      "segment_id": "s000386",
      "start_ms": 863790,
      "end_ms": 868635,
      "text": "它是让你看见向内和向外之间那片被我们粗暴踩平的地带。"
    },
    {
      "segment_id": "s000387",
      "start_ms": 869120,
      "end_ms": 870325,
      "text": "这本书适合三种人，"
    },
    {
      "segment_id": "s000388",
      "start_ms": 870680,
      "end_ms": 873860,
      "text": "第一种是被哲学VS文学这个伪命题。"
    },
    {
      "segment_id": "s000389",
      "start_ms": 873880,
      "end_ms": 874680,
      "text": "夹在中间的人，"
    },
    {
      "segment_id": "s000390",
      "start_ms": 874680,
      "end_ms": 876935,
      "text": "你既不想把一本书当成纯粹的自传，"
    },
    {
      "segment_id": "s000391",
      "start_ms": 877220,
      "end_ms": 879105,
      "text": "也不想把它当成冷冰冰的理论。"
    },
    {
      "segment_id": "s000392",
      "start_ms": 879520,
      "end_ms": 881500,
      "text": "但你没有语言描述自己的位置，"
    },
    {
      "segment_id": "s000393",
      "start_ms": 881880,
      "end_ms": 883220,
      "text": "这本书给你语言。"
    },
    {
      "segment_id": "s000394",
      "start_ms": 883340,
      "end_ms": 885475,
      "text": "第二种是想训练思维的人，"
    },
    {
      "segment_id": "s000395",
      "start_ms": 886010,
      "end_ms": 887665,
      "text": "你以为自传就是讲故事，"
    },
    {
      "segment_id": "s000396",
      "start_ms": 888000,
      "end_ms": 889145,
      "text": "他其实是认识论。"
    },
    {
      "segment_id": "s000397",
      "start_ms": 889660,
      "end_ms": 891195,
      "text": "你以为怀疑就是动摇，"
    },
    {
      "segment_id": "s000398",
      "start_ms": 891510,
      "end_ms": 891650,
      "text": "他，"
    },
    {
      "segment_id": "s000399",
      "start_ms": 891650,
      "end_ms": 893335,
      "text": "其实是找到支点的方式。"
    },
    {
      "segment_id": "s000400",
      "start_ms": 893800,
      "end_ms": 896480,
      "text": "第三种是对思想史好奇的人。"
    },
    {
      "segment_id": "s000401",
      "start_ms": 896620,
      "end_ms": 904145,
      "text": "你想知道人类两千年里最聪明的头脑如何在一个无法被简单实证的问题上反复推演、争论、修正。"
    },
    {
      "segment_id": "s000402",
      "start_ms": 904610,
      "end_ms": 905615,
      "text": "这本书给你地图，"
    },
    {
      "segment_id": "s000403",
      "start_ms": 906410,
      "end_ms": 907525,
      "text": "他不适合三种人，"
    },
    {
      "segment_id": "s000404",
      "start_ms": 908410,
      "end_ms": 910395,
      "text": "想找简单答案的人别读。"
    },
    {
      "segment_id": "s000405",
      "start_ms": 910980,
      "end_ms": 913225,
      "text": "想找战队材料的人别赌，"
    },
    {
      "segment_id": "s000406",
      "start_ms": 913840,
      "end_ms": 915875,
      "text": "想找心灵鸡汤的人解赌，"
    },
    {
      "segment_id": "s000407",
      "start_ms": 916290,
      "end_ms": 917495,
      "text": "他不负责安慰你，"
    },
    {
      "segment_id": "s000408",
      "start_ms": 917840,
      "end_ms": 919005,
      "text": "他负责让你不舒服，"
    },
    {
      "segment_id": "s000409",
      "start_ms": 919870,
      "end_ms": 920870,
      "text": "他不会告诉你，"
    },
    {
      "segment_id": "s000410",
      "start_ms": 920870,
      "end_ms": 921450,
      "text": "向内看，"
    },
    {
      "segment_id": "s000411",
      "start_ms": 921450,
      "end_ms": 923340,
      "text": "就对了也不会告诉你，"
    },
    {
      "segment_id": "s000412",
      "start_ms": 923340,
      "end_ms": 924825,
      "text": "向外追就清醒了。"
    },
    {
      "segment_id": "s000413",
      "start_ms": 925450,
      "end_ms": 926830,
      "text": "他会把你的问题拆开，"
    },
    {
      "segment_id": "s000414",
      "start_ms": 927130,
      "end_ms": 927690,
      "text": "让你看见，"
    },
    {
      "segment_id": "s000415",
      "start_ms": 927690,
      "end_ms": 931450,
      "text": "里面还有多少你从未问过的问题怎么读？"
    },
    {
      "segment_id": "s000416",
      "start_ms": 931930,
      "end_ms": 933670,
      "text": "不要从头到尾跪着读，"
    },
    {
      "segment_id": "s000417",
      "start_ms": 933890,
      "end_ms": 935830,
      "text": "也不要从头到尾审判着读，"
    },
    {
      "segment_id": "s000418",
      "start_ms": 936310,
      "end_ms": 937010,
      "text": "带一支笔，"
    },
    {
      "segment_id": "s000419",
      "start_ms": 937610,
      "end_ms": 938510,
      "text": "先读第十卷。"
    },
    {
      "segment_id": "s000420",
      "start_ms": 938870,
      "end_ms": 939530,
      "text": "问自己，"
    },
    {
      "segment_id": "s000421",
      "start_ms": 939890,
      "end_ms": 941750,
      "text": "我凭什么相信我的记忆，"
    },
    {
      "segment_id": "s000422",
      "start_ms": 942150,
      "end_ms": 943250,
      "text": "再读第十一卷，"
    },
    {
      "segment_id": "s000423",
      "start_ms": 943490,
      "end_ms": 944090,
      "text": "问自己，"
    },
    {
      "segment_id": "s000424",
      "start_ms": 944390,
      "end_ms": 946610,
      "text": "我凭什么相信我拥有时间，"
    },
    {
      "segment_id": "s000425",
      "start_ms": 947070,
      "end_ms": 948510,
      "text": "再读关于意志的部分？"
    },
    {
      "segment_id": "s000426",
      "start_ms": 948710,
      "end_ms": 949290,
      "text": "问自己，"
    },
    {
      "segment_id": "s000427",
      "start_ms": 949570,
      "end_ms": 953310,
      "text": "我能不能在不确定中仍然做出负责任的判断。"
    },
    {
      "segment_id": "s000428",
      "start_ms": 953690,
      "end_ms": 956180,
      "text": "如果只打算从这条内容里带走一个动作，"
    },
    {
      "segment_id": "s000429",
      "start_ms": 956360,
      "end_ms": 958760,
      "text": "我希望是去找这本书来读。"
    },
    {
      "segment_id": "s000430",
      "start_ms": 959300,
      "end_ms": 960020,
      "text": "不是点赞，"
    },
    {
      "segment_id": "s000431",
      "start_ms": 960460,
      "end_ms": 961220,
      "text": "不是收藏，"
    },
    {
      "segment_id": "s000432",
      "start_ms": 961760,
      "end_ms": 964260,
      "text": "是读不是读我的文案，"
    },
    {
      "segment_id": "s000433",
      "start_ms": 964740,
      "end_ms": 966180,
      "text": "是读奥古斯丁。"
    },
    {
      "segment_id": "s000434",
      "start_ms": 967100,
      "end_ms": 968040,
      "text": "不是读结论，"
    },
    {
      "segment_id": "s000435",
      "start_ms": 968580,
      "end_ms": 969420,
      "text": "是读论证。"
    },
    {
      "segment_id": "s000436",
      "start_ms": 970000,
      "end_ms": 971340,
      "text": "不是读谁赢了，"
    },
    {
      "segment_id": "s000437",
      "start_ms": 971580,
      "end_ms": 973780,
      "text": "是读他怎么想的，"
    },
    {
      "segment_id": "s000438",
      "start_ms": 974220,
      "end_ms": 975880,
      "text": "平台能删掉一段文案，"
    },
    {
      "segment_id": "s000439",
      "start_ms": 976320,
      "end_ms": 976840,
      "text": "删不掉。"
    },
    {
      "segment_id": "s000440",
      "start_ms": 976840,
      "end_ms": 978520,
      "text": "你翻开书之后的那几个小时，"
    },
    {
      "segment_id": "s000441",
      "start_ms": 979580,
      "end_ms": 981840,
      "text": "这才是我把这条文案改了。"
    },
    {
      "segment_id": "s000442",
      "start_ms": 981840,
      "end_ms": 984860,
      "text": "五遍仍然要把它推到你面前的原因。"
    },
    {
      "segment_id": "s000443",
      "start_ms": 984920,
      "end_ms": 985770,
      "text": "我是想海龟，"
    },
    {
      "segment_id": "s000444",
      "start_ms": 985910,
      "end_ms": 987775,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "f285754cd9eb5a0a6ee4d4533adb089087a0b4053c64c51c139501683271cf12"
}