{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_8064b34009bba1d8_u001",
  "video_id": "v_8064b34009bba1d8",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 647.977007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 6230,
      "text": "您知道中国从古至今流传故事里最富神秘感的一座山是哪一座吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 7070,
      "end_ms": 9750,
      "text": "有人说是武当山相传，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 9810,
      "end_ms": 11550,
      "text": "张三丰曾在那儿悟道。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 12150,
      "end_ms": 15750,
      "text": "有人说是长白山火山孕育出天池，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 15750,
      "end_ms": 20110,
      "text": "清代曾对这里长期封山两百多年，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 20110,
      "end_ms": 21470,
      "text": "禁止不同人进山。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 21470,
      "end_ms": 26630,
      "text": "但要说民间传说里最神秘的这两座都排不到榜首，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 26630,
      "end_ms": 28890,
      "text": "长白山甚至进不了前五。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 28890,
      "end_ms": 34160,
      "text": "这是在古籍记载里排在榜首的这座山山海经中，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 34160,
      "end_ms": 35680,
      "text": "称它为天地的夏都。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 36520,
      "end_ms": 40580,
      "text": "自古流传着有人进山之后再也没能出来的传说，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 41060,
      "end_ms": 42680,
      "text": "还有人拍下照片。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 43120,
      "end_ms": 45960,
      "text": "照片里的景象引发很多讨论，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 46440,
      "end_ms": 47340,
      "text": "直到今天，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 47580,
      "end_ms": 50100,
      "text": "它还有部分区域划定为保护区，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 50400,
      "end_ms": 51360,
      "text": "不对外开放，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 51640,
      "end_ms": 53440,
      "text": "普通人不能随意进入，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 53680,
      "end_ms": 54580,
      "text": "它是哪一座？"
    },
    {
      "segment_id": "s000019",
      "start_ms": 55380,
      "end_ms": 60930,
      "text": "今天咱们就来盘点在中国大地流传千年传说多里的十座，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 61230,
      "end_ms": 64195,
      "text": "富有神秘色彩的山脉分两级。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 65120,
      "end_ms": 70110,
      "text": "这一集咱们先说第十名到第六名老规矩开讲之前，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 70110,
      "end_ms": 72545,
      "text": "劳烦您扣个一点个红心，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 72860,
      "end_ms": 74245,
      "text": "让我看看都是谁在听。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 75220,
      "end_ms": 75905,
      "text": "第十名，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 76220,
      "end_ms": 78855,
      "text": "终南山在陕西西安，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 79780,
      "end_ms": 82460,
      "text": "这座山离西安城只有一小时车程，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 82760,
      "end_ms": 84340,
      "text": "深山之中嗯，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 84470,
      "end_ms": 86765,
      "text": "一直流传着隐士修行的故事。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 87480,
      "end_ms": 92685,
      "text": "据多家纪实媒体多年走访钟南山的报不完全统计，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 93400,
      "end_ms": 97765,
      "text": "长期在山中定居隐休的人大约有四五百人。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 98170,
      "end_ms": 100585,
      "text": "短期进山体验修行生活的人，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 101220,
      "end_ms": 103120,
      "text": "高峰期能达到数千年，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 103240,
      "end_ms": 105385,
      "text": "里面有僧人、道士，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 105700,
      "end_ms": 108315,
      "text": "也有大学教授放下生意的商人，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 109060,
      "end_ms": 110920,
      "text": "他们搭建简易茅棚，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 111200,
      "end_ms": 112000,
      "text": "自给自足，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 112240,
      "end_ms": 112660,
      "text": "种菜，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 112660,
      "end_ms": 115645,
      "text": "生活一住就是几年甚至十几年。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 115990,
      "end_ms": 118515,
      "text": "冬天山里气温低到零下十几度，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 119010,
      "end_ms": 121655,
      "text": "就靠着棉被柴火过多，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 122420,
      "end_ms": 124660,
      "text": "钟南山隐居的传统由来已久。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 124980,
      "end_ms": 127970,
      "text": "相传西周的姜子牙出山，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 127990,
      "end_ms": 131805,
      "text": "辅佐武王伐纣之前就在终南山一带隐居。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 132390,
      "end_ms": 133030,
      "text": "还有传说，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 133030,
      "end_ms": 135315,
      "text": "老子骑青牛途经函谷关，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 135810,
      "end_ms": 138370,
      "text": "曾在钟南山附近写下道德经，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 138510,
      "end_ms": 143385,
      "text": "从远古传说里的先贤到如今进山修行的不同人。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 144010,
      "end_ms": 144895,
      "text": "三千年间，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 145250,
      "end_ms": 147055,
      "text": "不断有人走进这座大山。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 148000,
      "end_ms": 149785,
      "text": "为什么大家向往终南山？"
    },
    {
      "segment_id": "s000051",
      "start_ms": 150810,
      "end_ms": 151855,
      "text": "自古有说法，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 152260,
      "end_ms": 153245,
      "text": "天下修道，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 153580,
      "end_ms": 154605,
      "text": "终南为冠。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 155330,
      "end_ms": 156545,
      "text": "可咱们不妨想一想，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 157030,
      "end_ms": 160210,
      "text": "一个大学教授放着城市安稳的生活，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 160550,
      "end_ms": 162170,
      "text": "跑到山里搭建茅棚，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 162430,
      "end_ms": 163435,
      "text": "他追求的是什么？"
    },
    {
      "segment_id": "s000058",
      "start_ms": 164480,
      "end_ms": 165965,
      "text": "每一位山中隐居者，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 166430,
      "end_ms": 167905,
      "text": "答案也各不相同。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 169300,
      "end_ms": 170085,
      "text": "第九名，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 171180,
      "end_ms": 174575,
      "text": "武当山在湖北十堰，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 177740,
      "end_ms": 181865,
      "text": "武当山最让人惊叹的要数金殿里长明的油灯。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 182160,
      "end_ms": 184935,
      "text": "武当山金殿整体为铜柱构建，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 185660,
      "end_ms": 190185,
      "text": "当年在北京铸造完成之后再运到武当山顶组装。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 191180,
      "end_ms": 192575,
      "text": "在明代永乐年间，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 193050,
      "end_ms": 196200,
      "text": "没有现代启动设备几十吨。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 196200,
      "end_ms": 200110,
      "text": "重的铜构件是如何运上千米？"
    },
    {
      "segment_id": "s000068",
      "start_ms": 200110,
      "end_ms": 207185,
      "text": "高山又在悬崖边组装完成的相关工程的详细施工记录，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 207830,
      "end_ms": 209530,
      "text": "并没有完整保存。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 209630,
      "end_ms": 210405,
      "text": "流传下来，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 210940,
      "end_ms": 214100,
      "text": "武当山古石名叫太和山民间传说，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 214280,
      "end_ms": 215760,
      "text": "道教里的真武大帝，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 215840,
      "end_ms": 217180,
      "text": "在此得道飞升取，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 217180,
      "end_ms": 217820,
      "text": "非真武，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 217820,
      "end_ms": 219045,
      "text": "不足以当知之意，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 219780,
      "end_ms": 221345,
      "text": "后来改名为武当山。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 222070,
      "end_ms": 223375,
      "text": "明朝永乐年间，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 223890,
      "end_ms": 228280,
      "text": "朱棣调集三十万军民上山修建宫馆攻城，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 228280,
      "end_ms": 230045,
      "text": "前后持续十二年，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 230390,
      "end_ms": 234065,
      "text": "动用如此巨大人力为一座山修建道观，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 234430,
      "end_ms": 236245,
      "text": "在国内历史上十分少见。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 236830,
      "end_ms": 239405,
      "text": "相传张三丰曾在此开创武当派，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 239890,
      "end_ms": 242610,
      "text": "直到今天清晨登上武当山，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 243130,
      "end_ms": 245790,
      "text": "还能听见道士早课的诵经声，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 246570,
      "end_ms": 248290,
      "text": "钟声漫过山谷，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 248970,
      "end_ms": 251530,
      "text": "整座山都安静下来。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 252870,
      "end_ms": 253570,
      "text": "第八名。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 253610,
      "end_ms": 259550,
      "text": "峨眉山在四川峨眉山有一处著名的自然奇观。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 260270,
      "end_ms": 261230,
      "text": "金顶之上，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 261530,
      "end_ms": 262490,
      "text": "每到晴天，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 262530,
      "end_ms": 263790,
      "text": "午后阳光，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 263870,
      "end_ms": 265830,
      "text": "从人身后方照射过来。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 266210,
      "end_ms": 268230,
      "text": "站在崖边向下望去，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 268670,
      "end_ms": 271600,
      "text": "云层间会浮现一圈巨大的彩色光环。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 272000,
      "end_ms": 275440,
      "text": "光环中间会出现自己的影子人，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 275460,
      "end_ms": 276720,
      "text": "抬手影子，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 276720,
      "end_ms": 279920,
      "text": "跟着抬手人一动影子也跟着移动。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 280360,
      "end_ms": 282440,
      "text": "当地人把这个景象叫做佛光，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 282920,
      "end_ms": 284720,
      "text": "古人不了解光学原理，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 284920,
      "end_ms": 286580,
      "text": "以为是菩萨显灵，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 287040,
      "end_ms": 288900,
      "text": "现代科学已经解释清楚，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 288920,
      "end_ms": 289860,
      "text": "这就是峨眉宝。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 289860,
      "end_ms": 293520,
      "text": "光是阳光穿过云雾里的小水滴，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 293940,
      "end_ms": 297460,
      "text": "经过反射衍射形成的自然光学现象，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 298300,
      "end_ms": 300260,
      "text": "就算明白了背后原理，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 300370,
      "end_ms": 301825,
      "text": "亲身站在崖边，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 302330,
      "end_ms": 303490,
      "text": "看见自己的身影，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 303490,
      "end_ms": 305175,
      "text": "被彩虹光环环绕，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 305550,
      "end_ms": 306785,
      "text": "依旧会觉得震撼。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 307610,
      "end_ms": 310050,
      "text": "还有万年寺内的普贤铜像，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 310850,
      "end_ms": 314670,
      "text": "重六十二吨铸造于一千多年前。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 315690,
      "end_ms": 318130,
      "text": "在没有大型起重工具的古代，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 318550,
      "end_ms": 326510,
      "text": "这么重的铜像是如何运上山完成铸造安放的这件事的详细运输、安装记录。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 327650,
      "end_ms": 329390,
      "text": "同样没有完整留存。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 330150,
      "end_ms": 331710,
      "text": "站在铜像下方，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 331810,
      "end_ms": 334770,
      "text": "抬头仰望千年前的古人，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 335070,
      "end_ms": 336390,
      "text": "依靠原始工具，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 336850,
      "end_ms": 341740,
      "text": "将数十吨的青铜送上高山安放殿中，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 342260,
      "end_ms": 343120,
      "text": "历经千年，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 343420,
      "end_ms": 346520,
      "text": "依旧完好矗立第七名。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 347320,
      "end_ms": 351500,
      "text": "梅里雪山在云南和西藏交界地带，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 352180,
      "end_ms": 361200,
      "text": "它是国内唯一由地方人大决议永久禁止攀登的雪山主峰喀瓦格勃，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 361200,
      "end_ms": 363160,
      "text": "海拔六千七百四十米，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 363780,
      "end_ms": 365360,
      "text": "比珠穆朗玛峰低。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 365680,
      "end_ms": 370190,
      "text": "两千多米珠峰已有数千人成功登顶。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 370190,
      "end_ms": 375350,
      "text": "而卡瓦格伯至今没有人类成功登顶的记录，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 375530,
      "end_ms": 377305,
      "text": "不是没有人尝试嗯。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 377690,
      "end_ms": 379095,
      "text": "一九九一年一月，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 379760,
      "end_ms": 383315,
      "text": "中日联合登山队向卡瓦格伯发起攀登。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 383910,
      "end_ms": 384670,
      "text": "出发之前，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 385090,
      "end_ms": 387990,
      "text": "当地藏族群众跪在雪地诵经，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 388290,
      "end_ms": 389945,
      "text": "祈求山神护佑，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 390470,
      "end_ms": 395705,
      "text": "不希望登山者登顶登山队依旧继续向上攀登。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 396560,
      "end_ms": 397245,
      "text": "一月四日，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 397800,
      "end_ms": 402935,
      "text": "十七名队员在三号营地遭遇特大雪崩全部遇难，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 403790,
      "end_ms": 407315,
      "text": "这也是人类登山史上重大山难之一。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 407800,
      "end_ms": 410260,
      "text": "搜救队伍持续寻找数月。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 410340,
      "end_ms": 411435,
      "text": "没有找到遇难者。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 412710,
      "end_ms": 413995,
      "text": "直到一九九八年，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 414300,
      "end_ms": 416105,
      "text": "距离山难七年之后，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 416500,
      "end_ms": 419840,
      "text": "明永村村民在冰川上发现了遇难者的遗骸。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 419840,
      "end_ms": 423095,
      "text": "与遗物后续多年持续搜寻，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 423620,
      "end_ms": 426945,
      "text": "目前已经找到十六位遇难者遗体。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 427720,
      "end_ms": 431025,
      "text": "最后一位遇难者遗骸至今仍未发现，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 431830,
      "end_ms": 433345,
      "text": "这次重大山南之后，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 433610,
      "end_ms": 437065,
      "text": "二零零一年云南德清县人大通过决议，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 437510,
      "end_ms": 440075,
      "text": "永久禁止攀登卡瓦格波峰。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 440650,
      "end_ms": 442265,
      "text": "在当地藏族文化里，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 442640,
      "end_ms": 446040,
      "text": "卡瓦格博是藏传佛教四大神山之一，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 446040,
      "end_ms": 447520,
      "text": "山顶是神山居所，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 447620,
      "end_ms": 448815,
      "text": "凡人不可登临。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 449200,
      "end_ms": 451095,
      "text": "我们尊重当地民族的信仰。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 451620,
      "end_ms": 452040,
      "text": "同时，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 452040,
      "end_ms": 455125,
      "text": "这场惨烈的山难也提醒着所有人，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 455610,
      "end_ms": 456910,
      "text": "面对巍峨雪山，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 457110,
      "end_ms": 458605,
      "text": "应当心怀敬畏。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 459220,
      "end_ms": 459840,
      "text": "第六名。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 460100,
      "end_ms": 466785,
      "text": "神农架在湖北西部神农架的野人传说从战国时期流传至今，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 467710,
      "end_ms": 478815,
      "text": "屈原、九歌、山鬼很多后人解读认为诗中山鬼的原型和当地流传的人形异兽传说有关。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 480080,
      "end_ms": 486405,
      "text": "明代李时珍编写本草纲目书中也记录过神农架一带关于人形动物的传闻。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 487320,
      "end_ms": 488980,
      "text": "从一九七四年开始，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 489300,
      "end_ms": 493420,
      "text": "神农架地区陆续出现目击者的口述记录。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 494260,
      "end_ms": 495260,
      "text": "一九七六年，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 495620,
      "end_ms": 503400,
      "text": "神农驾林区五位干部和一名司机夜间行车在路上偶遇一个红棕色长矛的人形生物，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 504100,
      "end_ms": 505260,
      "text": "站在道路中间，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 506080,
      "end_ms": 507120,
      "text": "众人受惊，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 507820,
      "end_ms": 509340,
      "text": "迅速驾车离开。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 509920,
      "end_ms": 510520,
      "text": "这件事。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 510620,
      "end_ms": 511420,
      "text": "上报之后，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 511680,
      "end_ms": 515500,
      "text": "一千九百七十四至一九八一年间，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 515800,
      "end_ms": 521510,
      "text": "中国科学院组组织了三次大规模野外科考一百多人的专家队伍，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 521810,
      "end_ms": 526950,
      "text": "踏查一千五百平方公里林区发现大量疑似大型动物脚印，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 527630,
      "end_ms": 529830,
      "text": "最长脚印足有四十八厘米，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 530410,
      "end_ms": 532990,
      "text": "还收集到毛发粪便样本。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 533189,
      "end_ms": 535090,
      "text": "后续样本鉴定显示，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 535670,
      "end_ms": 539070,
      "text": "收集到的毛发大多属于雄猴子等。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 539070,
      "end_ms": 543530,
      "text": "已知野生动物部分样本存在人为伪造情况，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 544910,
      "end_ms": 548700,
      "text": "三次科考没有找到野人存在的实体标本。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 549460,
      "end_ms": 550440,
      "text": "一九九九年，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 550660,
      "end_ms": 553380,
      "text": "中国野生动物保护协会的研讨会上，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 553820,
      "end_ms": 555400,
      "text": "专家形成共识，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 555540,
      "end_ms": 558820,
      "text": "没有证据证明神农架存在野人这一物种。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 559580,
      "end_ms": 562760,
      "text": "虽然科学界没有找到野人存在的实证，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 563520,
      "end_ms": 565400,
      "text": "但当年目击者的口述，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 566120,
      "end_ms": 569120,
      "text": "那些巨大脚印一直被大家讨论。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 569520,
      "end_ms": 572100,
      "text": "神农架身处广袤原始森林，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 572260,
      "end_ms": 575160,
      "text": "还有很多未知的动植物等待探索。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 576080,
      "end_ms": 578050,
      "text": "第十到第六名就讲到这里，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 578330,
      "end_ms": 580630,
      "text": "钟南山的饮食故事代代相传，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 580990,
      "end_ms": 583330,
      "text": "武当山金殿古灯静静伫立，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 583810,
      "end_ms": 586910,
      "text": "峨眉山的佛光依旧等待有缘人，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 586950,
      "end_ms": 590870,
      "text": "遇见梅里雪山依旧禁止攀登。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 590890,
      "end_ms": 593250,
      "text": "神农架野人传说流传至今。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 593730,
      "end_ms": 596030,
      "text": "可这几座还不是传说里，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 596030,
      "end_ms": 596850,
      "text": "最神秘的，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 597110,
      "end_ms": 598350,
      "text": "剩下这五座山。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 598390,
      "end_ms": 601870,
      "text": "其中一座有帝王耗费数十年，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 602210,
      "end_ms": 603190,
      "text": "营建陵寝，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 603650,
      "end_ms": 605530,
      "text": "处于文物保护等考量，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 605990,
      "end_ms": 608235,
      "text": "目前暂不具备发掘条件。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 609090,
      "end_ms": 611390,
      "text": "还有一座两千多年前，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 611450,
      "end_ms": 612635,
      "text": "古籍就有记载，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 613120,
      "end_ms": 616995,
      "text": "但他确切的地理位置至今仍有学术争议，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 617430,
      "end_ms": 619825,
      "text": "尤其是排在榜首的这座山，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 620660,
      "end_ms": 622860,
      "text": "部分区域化为保护区，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 623060,
      "end_ms": 623940,
      "text": "不对外开放，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 623940,
      "end_ms": 625855,
      "text": "普通人不能随意进入。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 626590,
      "end_ms": 627805,
      "text": "他究竟是哪一座？"
    },
    {
      "segment_id": "s000209",
      "start_ms": 628610,
      "end_ms": 629690,
      "text": "下一集已经更新，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 629950,
      "end_ms": 631150,
      "text": "您点开我的头像，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 631170,
      "end_ms": 632450,
      "text": "进主页置顶，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 632450,
      "end_ms": 634175,
      "text": "第一条就是下集，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 635210,
      "end_ms": 635915,
      "text": "点个关注，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 636260,
      "end_ms": 641225,
      "text": "咱们一起看看哪一座才是古籍传说里最神秘的大山。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 642110,
      "end_ms": 643290,
      "text": "觉得故事有意思，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 643490,
      "end_ms": 644955,
      "text": "欢迎评论区聊聊。"
    },
    {
      "segment_id": "s000217",
      "start_ms": 646280,
      "end_ms": 647895,
      "text": "你听过哪座山的传说？"
    }
  ],
  "source_transcript_sha256": "9af2142f1e353aebb7e927e583b983cb2117d65cec939b687d78610ccea1e725"
}