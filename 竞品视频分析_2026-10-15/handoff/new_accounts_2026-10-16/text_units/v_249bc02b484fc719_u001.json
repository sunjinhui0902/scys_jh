{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_249bc02b484fc719_u001",
  "video_id": "v_249bc02b484fc719",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 591.227007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 70,
      "end_ms": 3590,
      "text": "你知道我国一生必须去一次的十个地方是哪儿吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4370,
      "end_ms": 5550,
      "text": "有人说是三亚，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6270,
      "end_ms": 8490,
      "text": "有人说是丽江错，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9370,
      "end_ms": 12850,
      "text": "三亚连前十都排不进丽江，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 12930,
      "end_ms": 15850,
      "text": "更不是真正排榜首的那个地方，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 15930,
      "end_ms": 17690,
      "text": "全世界都知道他的名字，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 18490,
      "end_ms": 22930,
      "text": "可百分之九十九的中国人去的都是最没意思的那一段。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 24030,
      "end_ms": 26010,
      "text": "真正值得去的那一段。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 26410,
      "end_ms": 27330,
      "text": "没有游客，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 27650,
      "end_ms": 28590,
      "text": "没有缆车，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 29310,
      "end_ms": 31260,
      "text": "乘专车上的剑痕和刀疤，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 31260,
      "end_ms": 33580,
      "text": "还在六百多年了，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 33640,
      "end_ms": 34540,
      "text": "没人修过，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 34660,
      "end_ms": 36400,
      "text": "踩上去咯吱咯吱响，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 36780,
      "end_ms": 41240,
      "text": "脚底丈量的才是真正的明朝到底是哪？"
    },
    {
      "segment_id": "s000016",
      "start_ms": 42280,
      "end_ms": 47220,
      "text": "咱们从第十个开始倒着讲讲到第一个您自己品品，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 47420,
      "end_ms": 48840,
      "text": "还是咱们的老规矩。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 49260,
      "end_ms": 49920,
      "text": "开讲前，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 49920,
      "end_ms": 52620,
      "text": "劳烦各位老友顺手点亮红心，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 53160,
      "end_ms": 58060,
      "text": "评论区打个来了让我看看今天又有多少知音来捧场，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 58360,
      "end_ms": 59855,
      "text": "咱们正式开始。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 61680,
      "end_ms": 62400,
      "text": "第十名，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 62740,
      "end_ms": 65435,
      "text": "西湖浙江杭州西湖。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 66520,
      "end_ms": 69700,
      "text": "很多人觉得西湖不就是个城市公园里的湖吗？"
    },
    {
      "segment_id": "s000025",
      "start_ms": 69780,
      "end_ms": 72235,
      "text": "值得排进一生必去嘛。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 73310,
      "end_ms": 73810,
      "text": "值得。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 74760,
      "end_ms": 77585,
      "text": "可大部分人去西湖的方式是错的。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 78450,
      "end_ms": 79810,
      "text": "西湖最好的时间，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 79830,
      "end_ms": 80595,
      "text": "不是白天，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 80830,
      "end_ms": 81525,
      "text": "是清晨，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 82760,
      "end_ms": 86715,
      "text": "早上五六点钟雾还没散，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 87280,
      "end_ms": 88415,
      "text": "苏堤上没什么人，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 89180,
      "end_ms": 91885,
      "text": "两边的湖面上飘着一层薄雾，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 92630,
      "end_ms": 94145,
      "text": "您一个人走在堤上，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 94980,
      "end_ms": 96240,
      "text": "左边是里西湖，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 96540,
      "end_ms": 97905,
      "text": "右边是外西湖。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 98720,
      "end_ms": 103265,
      "text": "远处的雷峰塔和宝连体塔在雾里面只剩一个轮廓，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 103730,
      "end_ms": 105895,
      "text": "走到压低桥上往下看，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 106740,
      "end_ms": 110460,
      "text": "湖水是青灰色的荷叶，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 110680,
      "end_ms": 111480,
      "text": "贴着水面。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 111480,
      "end_ms": 112940,
      "text": "偶尔一条鱼翻个身，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 113220,
      "end_ms": 114985,
      "text": "水面漾一下又平了。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 115820,
      "end_ms": 122095,
      "text": "苏东坡九百多年前在杭州当官亲手主持修了苏堤。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 122900,
      "end_ms": 124360,
      "text": "九百多年过去了，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 124560,
      "end_ms": 125715,
      "text": "苏堤还在，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 126130,
      "end_ms": 126370,
      "text": "湖，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 126410,
      "end_ms": 126995,
      "text": "还在，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 127700,
      "end_ms": 131225,
      "text": "早晨的雾还在您走的那条堤。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 131730,
      "end_ms": 134370,
      "text": "苏东坡也走过西湖，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 134370,
      "end_ms": 136685,
      "text": "不大周长也就十来公里，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 137520,
      "end_ms": 139035,
      "text": "可这么小一个湖。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 139960,
      "end_ms": 145815,
      "text": "从白居易到苏东坡到乾隆写他的诗词加起来几千首，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 146550,
      "end_ms": 148305,
      "text": "没有哪个虎有这个待遇。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 149260,
      "end_ms": 151820,
      "text": "一个城市里的湖九百多年来，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 151820,
      "end_ms": 153125,
      "text": "每天早上都有雾，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 153680,
      "end_ms": 154855,
      "text": "每天早上都好看，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 155340,
      "end_ms": 156235,
      "text": "不要门票，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 156790,
      "end_ms": 157985,
      "text": "四季都能去，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 158740,
      "end_ms": 159920,
      "text": "什么时候想起来，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 159920,
      "end_ms": 161890,
      "text": "什么时候去就冲，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 161890,
      "end_ms": 163800,
      "text": "这一点他值得排。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 163800,
      "end_ms": 173135,
      "text": "第十第九名桂林山水广西桂林小学课本上就学过一句话叫桂林山水甲天下。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 173610,
      "end_ms": 174870,
      "text": "可真正到了桂林，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 174870,
      "end_ms": 177505,
      "text": "您就会发现课本只教了您一句话，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 177860,
      "end_ms": 180085,
      "text": "没教您桂林到底好看的在哪？"
    },
    {
      "segment_id": "s000066",
      "start_ms": 181260,
      "end_ms": 183200,
      "text": "桂林山水好看不是好看，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 183200,
      "end_ms": 184900,
      "text": "在桂林市区是好看。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 184960,
      "end_ms": 185945,
      "text": "在漓江上，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 186790,
      "end_ms": 191295,
      "text": "从桂林坐船到阳朔八十多公里的水路，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 192030,
      "end_ms": 194255,
      "text": "两岸全是石灰岩的山，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 195170,
      "end_ms": 196445,
      "text": "这些山不高，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 197060,
      "end_ms": 198485,
      "text": "大多一两百米，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 199120,
      "end_ms": 201895,
      "text": "但每一座都是单独立在那儿，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 202380,
      "end_ms": 207515,
      "text": "跟旁边的山不连着一座一座像从地里长出来的竹笋，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 208040,
      "end_ms": 211265,
      "text": "山上全是绿的山脚下泡在漓江里，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 211650,
      "end_ms": 213730,
      "text": "水面把山倒过来映了一遍，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 214050,
      "end_ms": 215630,
      "text": "分不清哪个是真山，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 215630,
      "end_ms": 218500,
      "text": "哪个是水里最出名的画面，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 218500,
      "end_ms": 220740,
      "text": "是二十元人民币的背面。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 220880,
      "end_ms": 223115,
      "text": "您把一张拿出来翻过去，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 223520,
      "end_ms": 225060,
      "text": "上面那个山水的图案，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 225060,
      "end_ms": 227235,
      "text": "就是漓江边上的新平段。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 228060,
      "end_ms": 228980,
      "text": "到了那个地方，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 229000,
      "end_ms": 230040,
      "text": "您把钱拿出来。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 230040,
      "end_ms": 232575,
      "text": "对着看一模一样，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 232970,
      "end_ms": 239165,
      "text": "连山的角度都对得上八十多公里的漓江、水路两岸几百座山。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 239740,
      "end_ms": 241585,
      "text": "每一座的形状都不一样。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 242460,
      "end_ms": 244985,
      "text": "这条水路中国人走了一千多年了，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 245440,
      "end_ms": 247780,
      "text": "到今天山还是那些山水，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 247900,
      "end_ms": 251730,
      "text": "还是那个水课本上那句桂林山水甲天下，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 251730,
      "end_ms": 252365,
      "text": "不是夸张，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 253060,
      "end_ms": 253900,
      "text": "是大实话。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 253940,
      "end_ms": 258920,
      "text": "第八名黄山安徽黄山有句老话叫五岳，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 258920,
      "end_ms": 259860,
      "text": "归来不看山，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 260180,
      "end_ms": 261815,
      "text": "黄山归来不看岳。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 262300,
      "end_ms": 264020,
      "text": "意思是看过黄山之后，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 264260,
      "end_ms": 266075,
      "text": "连五岳都不想看了。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 267100,
      "end_ms": 268700,
      "text": "这话是明朝旅行家。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 268700,
      "end_ms": 269735,
      "text": "徐霞客说，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 270300,
      "end_ms": 273305,
      "text": "徐霞客一辈子走遍了大半个中国，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 274190,
      "end_ms": 275510,
      "text": "什么山没见过。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 275790,
      "end_ms": 277865,
      "text": "到了黄山说出这么一句话，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 278350,
      "end_ms": 281395,
      "text": "您想想黄山得好看成什么样？"
    },
    {
      "segment_id": "s000104",
      "start_ms": 282370,
      "end_ms": 284395,
      "text": "黄山好看在四个字，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 284780,
      "end_ms": 287855,
      "text": "奇松、怪石、云海、温泉。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 288380,
      "end_ms": 289460,
      "text": "可最绝的是，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 289460,
      "end_ms": 291220,
      "text": "前三样加在一起的时候，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 291320,
      "end_ms": 295165,
      "text": "一棵松树从绝壁的石缝里横着长出来，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 295610,
      "end_ms": 299025,
      "text": "树干弯成了一个弧形树冠，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 299360,
      "end_ms": 301135,
      "text": "全朝一个方向展开，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 301520,
      "end_ms": 304355,
      "text": "像一只手伸出去要接什么东西，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 304970,
      "end_ms": 306665,
      "text": "这就是迎客松。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 307090,
      "end_ms": 308310,
      "text": "黄山的标志，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 309110,
      "end_ms": 311550,
      "text": "可黄山不只有一棵迎客松，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 311950,
      "end_ms": 317050,
      "text": "整座山上这种从石头缝里长出来的松树到处都是，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 317530,
      "end_ms": 319510,
      "text": "每一棵的姿态都不一样，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 319850,
      "end_ms": 323870,
      "text": "每一棵都是在石头上硬挤出来的，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 324690,
      "end_ms": 325970,
      "text": "然后是云海。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 326970,
      "end_ms": 329750,
      "text": "黄山一年有两百多天有雾，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 329830,
      "end_ms": 331010,
      "text": "赶上云海的时候，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 331010,
      "end_ms": 332430,
      "text": "站在山顶往下看，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 332970,
      "end_ms": 334850,
      "text": "脚底下全是白色的云，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 335570,
      "end_ms": 337420,
      "text": "松树和怪石时，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 337420,
      "end_ms": 338980,
      "text": "从云里面冒出来，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 339740,
      "end_ms": 342280,
      "text": "就像站在天上往下看人间。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 343240,
      "end_ms": 346160,
      "text": "徐霞客四百多年前看到的迎客松，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 346740,
      "end_ms": 350120,
      "text": "今天还在四百多年前的云海，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 350780,
      "end_ms": 354360,
      "text": "今天早上可能也有第七名。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 354800,
      "end_ms": 356100,
      "text": "呼伦贝尔大草原，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 357020,
      "end_ms": 358500,
      "text": "内蒙古呼伦贝尔，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 360100,
      "end_ms": 364720,
      "text": "中国面积最大的草原十万平方公里，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 364980,
      "end_ms": 366910,
      "text": "十万平方公里是个什么概念呢？"
    },
    {
      "segment_id": "s000133",
      "start_ms": 367210,
      "end_ms": 368390,
      "text": "差不多是六个北京，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 368390,
      "end_ms": 371910,
      "text": "那么大全是草地平的，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 372010,
      "end_ms": 373615,
      "text": "站在上面往四周看，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 374400,
      "end_ms": 376545,
      "text": "三百六十度全是绿色，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 377450,
      "end_ms": 378555,
      "text": "绿到天边，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 379480,
      "end_ms": 381075,
      "text": "天边就是地平线，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 381800,
      "end_ms": 383675,
      "text": "地平线上面就是天。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 384170,
      "end_ms": 385735,
      "text": "很多人说呼伦贝尔好看，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 386540,
      "end_ms": 388005,
      "text": "可到底好看在哪儿呢？"
    },
    {
      "segment_id": "s000142",
      "start_ms": 388600,
      "end_ms": 392250,
      "text": "好看在空城市里面走一百米，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 392250,
      "end_ms": 393010,
      "text": "就有一栋楼，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 393350,
      "end_ms": 395030,
      "text": "一个路口就有一个红绿灯，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 395250,
      "end_ms": 397345,
      "text": "眼睛看到的东西太多了，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 397890,
      "end_ms": 399315,
      "text": "看什么都挤在一起。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 399780,
      "end_ms": 400840,
      "text": "到了呼伦贝尔，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 400840,
      "end_ms": 402140,
      "text": "反过来什么都没有，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 402300,
      "end_ms": 403605,
      "text": "草天云，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 404030,
      "end_ms": 406035,
      "text": "偶尔远处有一群牛羊，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 406490,
      "end_ms": 409125,
      "text": "在远处有几顶白色的蒙古包，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 409730,
      "end_ms": 412195,
      "text": "您开车走在草原上的公路上，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 412580,
      "end_ms": 413380,
      "text": "两个小时，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 413380,
      "end_ms": 415385,
      "text": "窗外的景色可能都没变过，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 415760,
      "end_ms": 416360,
      "text": "没变过，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 416360,
      "end_ms": 417065,
      "text": "不是无聊，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 417350,
      "end_ms": 417965,
      "text": "是干净，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 418630,
      "end_ms": 420450,
      "text": "脑子里那些乱七八糟的东西，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 420450,
      "end_ms": 422314,
      "text": "到了草原上自己就停了，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 422720,
      "end_ms": 424105,
      "text": "因为眼前什么都没有，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 424310,
      "end_ms": 425295,
      "text": "脑子里就不转了。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 425770,
      "end_ms": 428795,
      "text": "十万平方公里的空不是荒凉，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 429100,
      "end_ms": 429665,
      "text": "是干净。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 430130,
      "end_ms": 433070,
      "text": "这种体验在城市里花多少钱都买不到。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 433090,
      "end_ms": 433874,
      "text": "第六名，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 434340,
      "end_ms": 444090,
      "text": "壶口瀑布、山西和陕西交界的地方黄河、湖口瀑布、黄河从上游一路流下，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 444090,
      "end_ms": 445920,
      "text": "来到了湖口。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 445940,
      "end_ms": 449995,
      "text": "这个地方河道突然从几百米宽收窄成几十米，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 450520,
      "end_ms": 452415,
      "text": "所有的水挤在一起往下灌，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 453330,
      "end_ms": 454915,
      "text": "落差将近二十米，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 455940,
      "end_ms": 457415,
      "text": "几十米宽的口子，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 458220,
      "end_ms": 459880,
      "text": "几百米宽的水量。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 460160,
      "end_ms": 460725,
      "text": "汪灌，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 461800,
      "end_ms": 462940,
      "text": "您站在岸边，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 463040,
      "end_ms": 464360,
      "text": "听到的不是水声，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 464540,
      "end_ms": 465445,
      "text": "是雷声。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 465950,
      "end_ms": 467210,
      "text": "那个轰隆隆的震动，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 467210,
      "end_ms": 468755,
      "text": "从脚底下往上传，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 469240,
      "end_ms": 471540,
      "text": "胸腔都跟着颤水砸到底，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 471540,
      "end_ms": 474555,
      "text": "下溅起来的水雾能飘到几十米高，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 475490,
      "end_ms": 476610,
      "text": "站静了一分钟，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 476610,
      "end_ms": 477625,
      "text": "衣服就湿透了。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 478720,
      "end_ms": 481515,
      "text": "壶口瀑布最出名的画面是冬天，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 482530,
      "end_ms": 483985,
      "text": "冬天水量小一些，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 484510,
      "end_ms": 487455,
      "text": "可瀑布两边的岩壁上会结满冰挂。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 488290,
      "end_ms": 491190,
      "text": "黄色的河水从白色的冰挂中间，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 491290,
      "end_ms": 492785,
      "text": "轰隆隆的砸下去，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 493530,
      "end_ms": 495390,
      "text": "黄白两色撞在一起。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 495690,
      "end_ms": 498135,
      "text": "水雾在阳光里变成了彩虹，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 498770,
      "end_ms": 500955,
      "text": "黄河是中国人的母亲河。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 501810,
      "end_ms": 504795,
      "text": "这句话听了一百遍可能没什么感觉，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 505630,
      "end_ms": 508390,
      "text": "可您到湖口站一次脚底下的震动，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 508450,
      "end_ms": 509990,
      "text": "传上来的那一瞬间，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 510150,
      "end_ms": 512005,
      "text": "您就明白这条河的脾气了，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 512550,
      "end_ms": 514415,
      "text": "不是温柔的那种母亲，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 514770,
      "end_ms": 516465,
      "text": "是能扛事的那步。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 517260,
      "end_ms": 518820,
      "text": "现在评论区打出四个字，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 519240,
      "end_ms": 521720,
      "text": "一生必去打。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 521720,
      "end_ms": 523455,
      "text": "完了咱们接着讲前五名，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 524290,
      "end_ms": 525725,
      "text": "一个比一个压不住。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 526510,
      "end_ms": 527790,
      "text": "今天讲的这五个，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 527790,
      "end_ms": 530480,
      "text": "您品品一个城市里的湖，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 530560,
      "end_ms": 531980,
      "text": "安安静静好看了。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 531980,
      "end_ms": 533880,
      "text": "九百多年一条，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 533880,
      "end_ms": 535160,
      "text": "江两岸几百座，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 535160,
      "end_ms": 536755,
      "text": "山长得跟竹笋似的。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 537440,
      "end_ms": 540420,
      "text": "一座山的松树从石头缝里挤出来，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 540420,
      "end_ms": 541540,
      "text": "挤了四百多年，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 541620,
      "end_ms": 543400,
      "text": "十万平方公里的草原空道，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 543400,
      "end_ms": 545545,
      "text": "能把脑子里的杂念洗干净，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 546080,
      "end_ms": 549080,
      "text": "一条黄河收成几十米的口子砸下去，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 549080,
      "end_ms": 550175,
      "text": "脚底下都在抖，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 551170,
      "end_ms": 554690,
      "text": "可这五个加一块儿都比不过前五名里，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 554690,
      "end_ms": 560470,
      "text": "最让人说不出话的那一个前物明理有一个湖湖水，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 560550,
      "end_ms": 561725,
      "text": "难道不像真的？"
    },
    {
      "segment_id": "s000216",
      "start_ms": 562560,
      "end_ms": 563340,
      "text": "当地人说，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 563360,
      "end_ms": 564675,
      "text": "水底住着女神？"
    },
    {
      "segment_id": "s000218",
      "start_ms": 565480,
      "end_ms": 571470,
      "text": "有一座宫殿修在海拔三千七百米的山上修了一千三百多年了，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 571470,
      "end_ms": 575340,
      "text": "到今天还有人住在里面还有一个地方。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 575400,
      "end_ms": 579205,
      "text": "墙上的壁画正在以肉眼可见的速度消失。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 579920,
      "end_ms": 582125,
      "text": "再不去可能真的看不到，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 583160,
      "end_ms": 587020,
      "text": "下一集已经同步更新了点。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 587020,
      "end_ms": 588760,
      "text": "我头像进主页第一条，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 588760,
      "end_ms": 591105,
      "text": "就是咱们接着接前五名。"
    }
  ],
  "source_transcript_sha256": "96956bdff20d60925f4984f87c0069143021f8814462178d0adfd5e16e82ae56"
}