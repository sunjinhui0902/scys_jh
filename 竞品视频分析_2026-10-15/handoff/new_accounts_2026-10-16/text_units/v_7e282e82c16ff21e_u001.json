{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_7e282e82c16ff21e_u001",
  "video_id": "v_7e282e82c16ff21e",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 553.772993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 210,
      "end_ms": 1070,
      "text": "你敢相信吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1350,
      "end_ms": 2910,
      "text": "在中国命理学史上，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 2910,
      "end_ms": 3810,
      "text": "有这样一本书，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 4270,
      "end_ms": 5610,
      "text": "作者不是算命先生，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 5710,
      "end_ms": 8830,
      "text": "而是一位很可能从未替自己算过命的读书人。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 8830,
      "end_ms": 10510,
      "text": "可正是他编成了这本书，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 10750,
      "end_ms": 14590,
      "text": "让此后八百年的算命江湖几乎全都改姓徐。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 15290,
      "end_ms": 16070,
      "text": "直到今天，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 16390,
      "end_ms": 18230,
      "text": "你遇到的每一位八字师傅，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 18470,
      "end_ms": 19970,
      "text": "无论嘴上承认与否，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 20210,
      "end_ms": 22430,
      "text": "用的仍是这本书定下的规矩。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 23110,
      "end_ms": 24330,
      "text": "他以一己之力，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 24470,
      "end_ms": 27810,
      "text": "把华夏命理从神仙鬼怪的泥潭里拽了出来，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 27970,
      "end_ms": 29905,
      "text": "放进阴阳五行的逻辑框架。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 30160,
      "end_ms": 33220,
      "text": "完成这件事儿的人叫徐大生，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 33220,
      "end_ms": 35920,
      "text": "南宋钱唐书生号东斋。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 35920,
      "end_ms": 37320,
      "text": "公元一二五三年前后，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 37480,
      "end_ms": 38560,
      "text": "徐大生做了一件，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 38560,
      "end_ms": 40860,
      "text": "在当时看来极其出格的事儿。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 40860,
      "end_ms": 44320,
      "text": "他把五代末年以来徐子平一脉流传的论命心得，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 44580,
      "end_ms": 48520,
      "text": "连同当时诸多命理名儒的文集一并汇集起来，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 48700,
      "end_ms": 49540,
      "text": "编成一部书，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 49860,
      "end_ms": 53260,
      "text": "取名渊海子平渊海二字，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 53500,
      "end_ms": 54880,
      "text": "本就是汇聚之意，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 55220,
      "end_ms": 56380,
      "text": "取的是渊深，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 56400,
      "end_ms": 58060,
      "text": "海阔包罗万象。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 58360,
      "end_ms": 61875,
      "text": "当时全国真正懂这套方法的人屈指可数。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 62220,
      "end_ms": 63735,
      "text": "而徐大生看懂了，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 64050,
      "end_ms": 65705,
      "text": "他在定争论中写的明白。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 66130,
      "end_ms": 67050,
      "text": "人命贵贱。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 67250,
      "end_ms": 69550,
      "text": "仙官月令以日干为主，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 69550,
      "end_ms": 71270,
      "text": "本三元要成格局，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 71550,
      "end_ms": 73170,
      "text": "四柱喜见财官。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 73330,
      "end_ms": 74275,
      "text": "这不是迷信，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 74640,
      "end_ms": 80465,
      "text": "而是中华民族第一次尝试把人的命运放进一套可推演可验证的系统里去认知。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 80730,
      "end_ms": 81250,
      "text": "那一年，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 81510,
      "end_ms": 84350,
      "text": "命理学仍处在那英论命的旧时代，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 84350,
      "end_ms": 91400,
      "text": "人们算命靠的是鬼谷子先师传下的那英法六十甲子配五行一段生死吉凶。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 91660,
      "end_ms": 93480,
      "text": "这套方法自有灵验之处，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 93640,
      "end_ms": 95955,
      "text": "却有一个致命短板太粗，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 96400,
      "end_ms": 97340,
      "text": "他只能告诉你，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 97540,
      "end_ms": 98400,
      "text": "此人命硬，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 98480,
      "end_ms": 100940,
      "text": "那人命薄却说不清为什么硬，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 101020,
      "end_ms": 101835,
      "text": "为什么薄，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 102150,
      "end_ms": 102730,
      "text": "更说不清。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 102730,
      "end_ms": 103925,
      "text": "同一年出生的人，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 104160,
      "end_ms": 105875,
      "text": "命运为何天差地别？"
    },
    {
      "segment_id": "s000048",
      "start_ms": 106530,
      "end_ms": 108195,
      "text": "徐大生接下了这个难题，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 108760,
      "end_ms": 111095,
      "text": "他不再满足于那英法的笼统判断，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 111450,
      "end_ms": 114575,
      "text": "而是把徐子平的财官、格局法系统化，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 115090,
      "end_ms": 124260,
      "text": "将一个人出生的年月日时四柱八字拆解为天干地支、阴阳五行、食神格局一层一层。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 124260,
      "end_ms": 125125,
      "text": "剥开来看，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 125570,
      "end_ms": 129334,
      "text": "他做的第一件事儿是把食神体系完整立起来。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 129520,
      "end_ms": 130355,
      "text": "什么是食神？"
    },
    {
      "segment_id": "s000055",
      "start_ms": 130940,
      "end_ms": 132665,
      "text": "就是以日干为中心，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 133020,
      "end_ms": 139430,
      "text": "把天干与日干之间的深刻关系、阴阳配合关系转化为十种人事语言。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 139610,
      "end_ms": 140970,
      "text": "正观偏官，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 141350,
      "end_ms": 143720,
      "text": "正印偏印正财，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 143760,
      "end_ms": 144240,
      "text": "偏财，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 144540,
      "end_ms": 145080,
      "text": "食神，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 145380,
      "end_ms": 147555,
      "text": "商官比肩劫财，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 147970,
      "end_ms": 148995,
      "text": "正官是贵气，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 149300,
      "end_ms": 150300,
      "text": "七杀是压力。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 150520,
      "end_ms": 151600,
      "text": "正应是庇护，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 151780,
      "end_ms": 152895,
      "text": "食神是福气，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 153230,
      "end_ms": 154270,
      "text": "商官是才华，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 154490,
      "end_ms": 155170,
      "text": "也是锋芒。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 155370,
      "end_ms": 159490,
      "text": "徐大生用这套体系第一次让命里从看命转向，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 159490,
      "end_ms": 161310,
      "text": "看人一个人是什么性情，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 161530,
      "end_ms": 163270,
      "text": "适合走什么路、何时该进，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 163290,
      "end_ms": 164075,
      "text": "何时该退，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 164390,
      "end_ms": 167005,
      "text": "都能在这十个概念的交错中找到线索。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 167880,
      "end_ms": 169460,
      "text": "后世所有八字师傅，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 169640,
      "end_ms": 170875,
      "text": "无论哪门哪派，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 171170,
      "end_ms": 171690,
      "text": "一开口，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 171690,
      "end_ms": 178245,
      "text": "就是你这个八字正官格官心透干源头都在渊海紫平。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 178670,
      "end_ms": 183915,
      "text": "他做的第二件事是把格局从模糊的经验变成清晰的分类。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 184400,
      "end_ms": 185400,
      "text": "在渊海紫坪中，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 185620,
      "end_ms": 189280,
      "text": "徐大生将格局分为内十八阁和外十八阁，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 189360,
      "end_ms": 199230,
      "text": "内十八阁包括正官阁月上偏官阁、时尚偏财阁、映寿阁、杂器财官阁等是常规命局的主流判断框架。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 199310,
      "end_ms": 207054,
      "text": "外十八格则包括沿上格润、下格、从格格、曲直、格、架、色格等特殊格局，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 207450,
      "end_ms": 211795,
      "text": "处理的是五行偏枯却反而大富大贵的极端情况。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 212200,
      "end_ms": 217040,
      "text": "这套分类法把命理学从口诀式经验推向体系化推演，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 217100,
      "end_ms": 217980,
      "text": "拿到一个八字，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 218180,
      "end_ms": 219060,
      "text": "先看月令，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 219280,
      "end_ms": 220480,
      "text": "月令决定格局，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 220620,
      "end_ms": 223775,
      "text": "格局决定用神用神决定吉凶。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 224240,
      "end_ms": 225560,
      "text": "这条链条一旦建立，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 225800,
      "end_ms": 227475,
      "text": "算命就不再是猜，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 227890,
      "end_ms": 229490,
      "text": "而是算他做的。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 229490,
      "end_ms": 233345,
      "text": "第三件事是把命理判断的逻辑链条完整写了出来。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 233910,
      "end_ms": 234810,
      "text": "在祭善篇中，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 234890,
      "end_ms": 235475,
      "text": "他写道，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 235960,
      "end_ms": 242380,
      "text": "欲知贵贱相官月令奶皮缸刺断吉凶专用日干为主，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 242380,
      "end_ms": 244590,
      "text": "本三元要成格局，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 244910,
      "end_ms": 246350,
      "text": "四柱喜建财，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 246350,
      "end_ms": 247360,
      "text": "官用，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 247360,
      "end_ms": 248665,
      "text": "神不可损伤，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 249050,
      "end_ms": 250555,
      "text": "日主最宜剑忘。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 250760,
      "end_ms": 254605,
      "text": "这段话就是整部渊海子平的方法论总纲。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 255520,
      "end_ms": 256960,
      "text": "月令是刚日，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 256980,
      "end_ms": 257735,
      "text": "刚是主，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 258110,
      "end_ms": 259015,
      "text": "格局是框架，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 259320,
      "end_ms": 260495,
      "text": "用神是核心，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 260930,
      "end_ms": 262595,
      "text": "日主健忘是底线。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 263070,
      "end_ms": 264390,
      "text": "任何一个八字拿到手，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 264570,
      "end_ms": 265955,
      "text": "先看月令是什么？"
    },
    {
      "segment_id": "s000108",
      "start_ms": 266180,
      "end_ms": 267340,
      "text": "再看日干强不强，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 267620,
      "end_ms": 269000,
      "text": "再看格局成不成。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 269200,
      "end_ms": 271045,
      "text": "再看用神有没有受伤，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 271590,
      "end_ms": 272290,
      "text": "这套逻辑，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 272310,
      "end_ms": 273150,
      "text": "环环相扣，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 273310,
      "end_ms": 274355,
      "text": "没有一处含糊。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 274930,
      "end_ms": 279235,
      "text": "这也是为什么后世盲人师傅能整本背诵渊海子平。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 279600,
      "end_ms": 282000,
      "text": "因为书中的每一个判断都有依据，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 282200,
      "end_ms": 285825,
      "text": "每一个依据都能回溯到阴阳五行的基本关系上。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 286240,
      "end_ms": 287840,
      "text": "但徐大生最狠的一招，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 287960,
      "end_ms": 290255,
      "text": "还不在于他把理论建的有多完整，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 290600,
      "end_ms": 292095,
      "text": "而在于他做了一个决定。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 292450,
      "end_ms": 295330,
      "text": "把密传公开在他之前，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 295550,
      "end_ms": 298930,
      "text": "命理学的核心技法大多掌握在少数术士手里，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 299410,
      "end_ms": 300190,
      "text": "师徒之间，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 300210,
      "end_ms": 300970,
      "text": "口耳相传，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 301190,
      "end_ms": 302810,
      "text": "外人根本摸不到门路。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 303490,
      "end_ms": 306130,
      "text": "徐大生却选择集诸儒之意。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 306130,
      "end_ms": 310950,
      "text": "传部把当时能收集到的命理论述汇编成书公之于世。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 311250,
      "end_ms": 313290,
      "text": "他放弃的是秘传的优势，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 313790,
      "end_ms": 316090,
      "text": "换来的却是一门学问的生存。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 316550,
      "end_ms": 320710,
      "text": "这个决定让渊海子平成为八字命理学的宗祖之作，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 321050,
      "end_ms": 324200,
      "text": "也成为此后所有有命理著作绕不开的起点。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 324260,
      "end_ms": 325100,
      "text": "没有这本书，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 325260,
      "end_ms": 326900,
      "text": "就没有后来的三命通会，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 327200,
      "end_ms": 328280,
      "text": "没有子凭真全。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 328600,
      "end_ms": 329480,
      "text": "没有滴天髓。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 329680,
      "end_ms": 332660,
      "text": "后世命理学的繁荣几乎都建立在徐大生。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 332660,
      "end_ms": 333840,
      "text": "这一次公开之上。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 334200,
      "end_ms": 335580,
      "text": "这部书共分五卷，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 335880,
      "end_ms": 336640,
      "text": "结构清晰，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 336840,
      "end_ms": 337720,
      "text": "层层递进。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 338040,
      "end_ms": 339220,
      "text": "第一卷讲基础，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 339500,
      "end_ms": 340780,
      "text": "五行所生之始，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 341040,
      "end_ms": 342760,
      "text": "天干地支所出天。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 342760,
      "end_ms": 344600,
      "text": "十甲子纳阴天干，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 344640,
      "end_ms": 345500,
      "text": "生旺死绝。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 345740,
      "end_ms": 348860,
      "text": "各种神煞以及起大运小运的方法，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 349140,
      "end_ms": 350360,
      "text": "这是全书的地基。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 351020,
      "end_ms": 352155,
      "text": "第二卷讲核心，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 352780,
      "end_ms": 355480,
      "text": "以祭善篇和看命入世为纲领，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 355640,
      "end_ms": 365575,
      "text": "详细论述正官、偏官欺杀、硬瘦、正财、偏财、食神、商官、劫财、洋刃等食神的用法，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 365900,
      "end_ms": 368015,
      "text": "以及各种格局的取法和判断。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 368420,
      "end_ms": 369595,
      "text": "这是全书的心脏。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 370220,
      "end_ms": 372870,
      "text": "第三卷讲六亲与人伦论，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 372870,
      "end_ms": 379755,
      "text": "父母七世、兄弟姐妹、子熙、女命、小儿庞及性情与疾病，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 380140,
      "end_ms": 381460,
      "text": "这是全书的血肉。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 381520,
      "end_ms": 387440,
      "text": "第四卷论人剑和十二月剑猴第五卷收尸诀是实战经验的精华，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 387440,
      "end_ms": 389210,
      "text": "集结五卷下来，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 389290,
      "end_ms": 390850,
      "text": "从宇宙观到方法论，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 391010,
      "end_ms": 393135,
      "text": "从理论框架到实战口诀，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 393460,
      "end_ms": 396255,
      "text": "一座完整的命理学大厦便立了起来。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 396730,
      "end_ms": 397110,
      "text": "当然，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 397470,
      "end_ms": 398975,
      "text": "徐大生也有他的局限，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 399510,
      "end_ms": 400745,
      "text": "他把话说得很明白，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 401210,
      "end_ms": 403555,
      "text": "这本书的方法简要而实用，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 403870,
      "end_ms": 404970,
      "text": "但分类不明，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 405250,
      "end_ms": 406275,
      "text": "论述粗略，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 407050,
      "end_ms": 407955,
      "text": "这不是谦虚，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 408310,
      "end_ms": 409085,
      "text": "而是事实。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 409960,
      "end_ms": 411400,
      "text": "作为第一部系统著作，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 411560,
      "end_ms": 414205,
      "text": "它的价值在于开创在于奠基，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 414550,
      "end_ms": 415490,
      "text": "而不在于精威。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 415550,
      "end_ms": 417770,
      "text": "后来的紫平真权把格局论命，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 417830,
      "end_ms": 419760,
      "text": "精雕细琢、地天髓，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 419920,
      "end_ms": 422260,
      "text": "把五行深刻推向哲学高度，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 422420,
      "end_ms": 425305,
      "text": "三命通会把资料汇编做到极致，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 425720,
      "end_ms": 428060,
      "text": "他们都是站在渊海紫平的肩膀上，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 428080,
      "end_ms": 429175,
      "text": "继续往前走的，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 429410,
      "end_ms": 431395,
      "text": "没有这个粗糙却坚实的起点，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 431690,
      "end_ms": 433205,
      "text": "后面的路无从谈起。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 433870,
      "end_ms": 436155,
      "text": "但徐大生的故事并未就此结束，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 436660,
      "end_ms": 438015,
      "text": "因为渊海紫平之后，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 438290,
      "end_ms": 441055,
      "text": "命理学又走过八百年八百年里，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 441370,
      "end_ms": 448900,
      "text": "江湖上出现了无数自称秘传真爵的算命师傅出现了无数让人越读越糊涂的白话译本，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 448900,
      "end_ms": 451340,
      "text": "也出现了无数把命理包装成玄学，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 451600,
      "end_ms": 454075,
      "text": "再把玄学包装成迷信的生意人。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 454400,
      "end_ms": 455700,
      "text": "普通人读不懂古文，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 455960,
      "end_ms": 459260,
      "text": "被劣质白话片爱好者被江湖神棍收割，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 459380,
      "end_ms": 460220,
      "text": "越修越偏。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 460400,
      "end_ms": 462485,
      "text": "真正的方法论藏在固纸堆里。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 462880,
      "end_ms": 465285,
      "text": "最核心的食神体系与格局框架，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 465640,
      "end_ms": 468885,
      "text": "反而被各种花里胡哨的神煞和口诀掩盖了。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 469300,
      "end_ms": 472275,
      "text": "于是有一条路被重新铺了出来。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 472830,
      "end_ms": 474970,
      "text": "一本以渊海子平为根基，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 475210,
      "end_ms": 481135,
      "text": "把整个子平命理体系用现代汉语重新讲透的书被推到普通人面前。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 481410,
      "end_ms": 482250,
      "text": "他没有迷信，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 482470,
      "end_ms": 483375,
      "text": "没有玄虚，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 483860,
      "end_ms": 485565,
      "text": "只有一位严谨的整理者。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 485800,
      "end_ms": 488260,
      "text": "把从徐子平到徐大生的命理脉络，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 488420,
      "end_ms": 490725,
      "text": "从食神到格局的内在逻辑，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 491040,
      "end_ms": 494160,
      "text": "从月令取用到岁运判断的完整链条，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 494420,
      "end_ms": 496805,
      "text": "用大白话一条一条拆开来讲，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 497220,
      "end_ms": 498205,
      "text": "你不需要背古文，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 498440,
      "end_ms": 499345,
      "text": "不需要拜师傅，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 499630,
      "end_ms": 501490,
      "text": "不需要在论坛上被大师们带偏。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 501830,
      "end_ms": 503055,
      "text": "你只需打开第一页，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 503360,
      "end_ms": 506305,
      "text": "就能沿着八百年前徐大生铺下的那条路，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 506610,
      "end_ms": 507930,
      "text": "一步一步走进去。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 508130,
      "end_ms": 511665,
      "text": "徐大生用一辈子把命理从密传变成公开。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 512160,
      "end_ms": 516515,
      "text": "后来真正要做的是把公开的命理从混乱变回清晰。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 517160,
      "end_ms": 517840,
      "text": "可说到底，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 518220,
      "end_ms": 521525,
      "text": "这条路的源头还是那本渊海紫平，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 522030,
      "end_ms": 523175,
      "text": "他直得放在枕边，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 523550,
      "end_ms": 524935,
      "text": "不是因为他能算准，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 525360,
      "end_ms": 528360,
      "text": "而是因为它能让你在遇到任何一个八字时，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 528620,
      "end_ms": 531305,
      "text": "心里有一张清清楚楚的地图。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 531780,
      "end_ms": 532535,
      "text": "八百年前，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 532900,
      "end_ms": 535215,
      "text": "徐大生在钱塘的某个书斋里，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 535520,
      "end_ms": 536280,
      "text": "一笔一笔，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 536280,
      "end_ms": 538735,
      "text": "把零散的命理口诀整理成章。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 539390,
      "end_ms": 540715,
      "text": "他没有算过自己的命，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 541110,
      "end_ms": 543225,
      "text": "却为后来者铺好了一条路，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 543710,
      "end_ms": 546255,
      "text": "你只是翻开第一页就能走上去。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 546720,
      "end_ms": 547475,
      "text": "而那一夜，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 548090,
      "end_ms": 550590,
      "text": "不妨就从渊海紫坪翻开，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 550850,
      "end_ms": 551645,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 551910,
      "end_ms": 553655,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "2bad85b5e56c3386ca6e241e77a844f4e945ab3e00595d32a593e5234f2e222e"
}