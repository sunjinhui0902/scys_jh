{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_3e3873deeb6c8d7e_u001",
  "video_id": "v_3e3873deeb6c8d7e",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 317.069002,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 4150,
      "text": "你知道中国有哪些地方水美到你怀疑自己的眼睛吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4890,
      "end_ms": 8270,
      "text": "有人说是九寨沟水蓝的不真实。"
    },
    {
      "segment_id": "s000003",
      "start_ms": 8750,
      "end_ms": 10010,
      "text": "有人说是西湖，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 10270,
      "end_ms": 12090,
      "text": "淡妆浓抹总相宜，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 12410,
      "end_ms": 15890,
      "text": "错真正最绝的那片水不在四川，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 15890,
      "end_ms": 16710,
      "text": "也不在浙江。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16710,
      "end_ms": 20230,
      "text": "它在沙漠里一片湖水被沙山包围，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 20230,
      "end_ms": 21310,
      "text": "千年不干。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21310,
      "end_ms": 25730,
      "text": "今天咱们就来盘点中国十五大水做的仙境，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 25730,
      "end_ms": 29250,
      "text": "每一处都美到让你想立刻收拾行李。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 29250,
      "end_ms": 31620,
      "text": "这么觉得有意思的朋友，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 31620,
      "end_ms": 32620,
      "text": "可以先收藏，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 33200,
      "end_ms": 35620,
      "text": "免得刷着刷着找不到第十五名。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 35800,
      "end_ms": 36700,
      "text": "杭州西湖，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 37480,
      "end_ms": 39200,
      "text": "你见过雨天的西湖吗？"
    },
    {
      "segment_id": "s000016",
      "start_ms": 39760,
      "end_ms": 41120,
      "text": "不是那种毛毛雨，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 41260,
      "end_ms": 44700,
      "text": "是那种细细密密斜斜织下来的江南雨。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 45440,
      "end_ms": 46740,
      "text": "你站在断桥上，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 47080,
      "end_ms": 49560,
      "text": "湖面上浮起一层薄薄的水汽，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 50060,
      "end_ms": 52080,
      "text": "远处的孤山薄撇塔，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 52320,
      "end_ms": 53920,
      "text": "只剩一个淡淡的轮廓，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 54420,
      "end_ms": 56380,
      "text": "像谁用毛笔沾了淡墨，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 56820,
      "end_ms": 59020,
      "text": "在宣纸上轻轻扫了一下，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 59680,
      "end_ms": 61185,
      "text": "雨点便落在湖面上，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 61610,
      "end_ms": 62990,
      "text": "密密麻麻的小圈，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 63070,
      "end_ms": 64355,
      "text": "一个接一个的荡开。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 64750,
      "end_ms": 66005,
      "text": "你听得见雨声，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 66450,
      "end_ms": 67725,
      "text": "但看不见雨丝。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 68430,
      "end_ms": 69030,
      "text": "苏轼说，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 69050,
      "end_ms": 70610,
      "text": "水光潋滟晴方好，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 70710,
      "end_ms": 72265,
      "text": "山色空蒙雨亦奇，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 72650,
      "end_ms": 75210,
      "text": "可他没告诉我晴天的西湖，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 75210,
      "end_ms": 76335,
      "text": "你看到的是人头，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 76830,
      "end_ms": 77730,
      "text": "雨天的西湖，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 77730,
      "end_ms": 79155,
      "text": "你看到的才是江南。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 80020,
      "end_ms": 81480,
      "text": "你站在雨里伞，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 81480,
      "end_ms": 82485,
      "text": "盐上滴着水，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 82860,
      "end_ms": 84280,
      "text": "脚底的石板路，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 84540,
      "end_ms": 86035,
      "text": "湿漉漉的反着光。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 86610,
      "end_ms": 87070,
      "text": "那一刻，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 87070,
      "end_ms": 94955,
      "text": "你会觉得西湖等这场雨等了一千年第十四名，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 96870,
      "end_ms": 104625,
      "text": "浙江千岛湖千岛湖在浙江崇安湖中有一千零七十八个岛屿。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 105240,
      "end_ms": 106560,
      "text": "你坐船出去，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 106920,
      "end_ms": 108435,
      "text": "水是碧绿的，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 109000,
      "end_ms": 109420,
      "text": "绿的，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 109420,
      "end_ms": 111180,
      "text": "像一块温润的玉，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 111280,
      "end_ms": 116835,
      "text": "船桨划过去水面像被切开的绸缎一样缓缓合拢。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 117630,
      "end_ms": 126220,
      "text": "但千岛湖最让人心里一颤的是水底下一九五九年新安江水库蓄水两座千年，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 126220,
      "end_ms": 129005,
      "text": "古城狮城和鹤城沉入了水底。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 129640,
      "end_ms": 132410,
      "text": "你在湖面上看到的是一座座岛岛，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 132410,
      "end_ms": 136930,
      "text": "下面是完整的明清街道牌坊民居。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 137210,
      "end_ms": 139780,
      "text": "水草在屋檐上飘鱼，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 139780,
      "end_ms": 142390,
      "text": "在窗棂间游晴天的时候，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 142390,
      "end_ms": 144275,
      "text": "湖水能见度超过七米。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 144590,
      "end_ms": 145615,
      "text": "你低头看水，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 146010,
      "end_ms": 149550,
      "text": "隐隐约约能看见一个沉在水底的旧世界，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 149630,
      "end_ms": 150565,
      "text": "第十三名。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 150950,
      "end_ms": 152525,
      "text": "湖南洞庭湖，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 153040,
      "end_ms": 154260,
      "text": "你站在岳阳楼上，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 154480,
      "end_ms": 156255,
      "text": "眼前是八百里洞庭。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 156810,
      "end_ms": 157630,
      "text": "秋天的时候，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 157630,
      "end_ms": 158635,
      "text": "湖水退去，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 159110,
      "end_ms": 161265,
      "text": "露出大片大片的芦苇荡，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 161640,
      "end_ms": 162485,
      "text": "如花开了，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 162870,
      "end_ms": 163535,
      "text": "风一吹，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 164140,
      "end_ms": 166045,
      "text": "白色的花絮漫天飞舞，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 166420,
      "end_ms": 168785,
      "text": "像下了一场不会融化的雪。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 169530,
      "end_ms": 172455,
      "text": "远处的君山岛在薄雾里若隐若现。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 173190,
      "end_ms": 173770,
      "text": "湖面上，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 173770,
      "end_ms": 178575,
      "text": "渔船点点船上的灯火在暮色里一盏一盏亮起来。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 178890,
      "end_ms": 182605,
      "text": "范仲淹就是在这里写下了先天下之忧而忧，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 183240,
      "end_ms": 185020,
      "text": "后天下之乐而乐。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 185200,
      "end_ms": 186225,
      "text": "你扶着栏杆，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 186590,
      "end_ms": 187795,
      "text": "胡风灌满衣袖，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 188230,
      "end_ms": 190885,
      "text": "你会觉得这片水看过太多兴亡，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 191150,
      "end_ms": 192065,
      "text": "所以他不说话。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 192980,
      "end_ms": 193720,
      "text": "第十二名，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 193960,
      "end_ms": 194820,
      "text": "广西桂林，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 194820,
      "end_ms": 197005,
      "text": "漓江天还没亮。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 197460,
      "end_ms": 198615,
      "text": "你坐在竹筏上，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 199060,
      "end_ms": 201495,
      "text": "江面上飘着一层白色的薄雾，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 201950,
      "end_ms": 204545,
      "text": "像有人把整条浆泡在了牛奶里，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 205030,
      "end_ms": 207775,
      "text": "两岸的喀斯特山峰从雾里探出头来，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 208120,
      "end_ms": 209200,
      "text": "一座接一座，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 209420,
      "end_ms": 210415,
      "text": "有的像比价，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 210840,
      "end_ms": 211845,
      "text": "有的像骆驼，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 212110,
      "end_ms": 214030,
      "text": "有的像老人惩罚人。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 214030,
      "end_ms": 214945,
      "text": "一杆子下去，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 215550,
      "end_ms": 218930,
      "text": "竹竿入水的声音清脆的像敲了一下瓷器。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 219110,
      "end_ms": 221095,
      "text": "水面上荡开一圈涟漪，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 222000,
      "end_ms": 225215,
      "text": "你把手伸进江里水是凉的，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 225480,
      "end_ms": 226185,
      "text": "滑滑的，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 226610,
      "end_ms": 229425,
      "text": "像在摸一块被溪水冲了几千年的石头。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 230220,
      "end_ms": 232075,
      "text": "漓江的美不是壮阔，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 232480,
      "end_ms": 233235,
      "text": "是安静，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 233720,
      "end_ms": 235755,
      "text": "安静到你不敢大声说话，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 236090,
      "end_ms": 238765,
      "text": "怕吵醒什么第十一名。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 239730,
      "end_ms": 241095,
      "text": "云南大理洱海，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 241770,
      "end_ms": 244505,
      "text": "你见过洱海的蓝调石刻吗？"
    },
    {
      "segment_id": "s000100",
      "start_ms": 245320,
      "end_ms": 247185,
      "text": "天色将暗未暗，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 248000,
      "end_ms": 250825,
      "text": "天边还剩一抹淡淡的蓝，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 251300,
      "end_ms": 254815,
      "text": "苍山的轮廓变成一道深色的剪影。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 255730,
      "end_ms": 258875,
      "text": "湖面上忽然亮起点点渔灯，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 259380,
      "end_ms": 262120,
      "text": "暖黄色的光落在水面上，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 262160,
      "end_ms": 264295,
      "text": "拉出一道一道细长的光柱。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 264780,
      "end_ms": 266845,
      "text": "随着水波轻轻摇晃，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 267360,
      "end_ms": 273635,
      "text": "蓝的天光、暖的雨、火暗的山野三种颜色在水面上交织。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 274540,
      "end_ms": 275965,
      "text": "你站在洱海边，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 276480,
      "end_ms": 278625,
      "text": "风从苍山那边吹过来，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 279060,
      "end_ms": 281175,
      "text": "带着松脂和湖水的气息，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 281570,
      "end_ms": 283370,
      "text": "你会分不清哪边是天，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 283510,
      "end_ms": 284370,
      "text": "哪边是水，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 284570,
      "end_ms": 285605,
      "text": "哪边是梦。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 286440,
      "end_ms": 290310,
      "text": "接下来第十到第六名有一个湖，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 290710,
      "end_ms": 293480,
      "text": "每年只每二十天有一个湖，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 293640,
      "end_ms": 295260,
      "text": "全年只有大约五十天，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 295260,
      "end_ms": 296235,
      "text": "能看到阵容，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 296920,
      "end_ms": 300480,
      "text": "还有一个湖的湖水会在夏天自己变红。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 300640,
      "end_ms": 304455,
