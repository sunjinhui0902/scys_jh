{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_f5f330e99bb6bcd1_u002",
  "video_id": "v_f5f330e99bb6bcd1",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 962.26,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000375",
      "start_ms": 814180,
      "end_ms": 816280,
      "text": "比如元慧运势的具体卦象配法，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 816280,
      "end_ms": 818265,
      "text": "为什么会在某些朝代产生争议？"
    },
    {
      "segment_id": "s000377",
      "start_ms": 818710,
      "end_ms": 822645,
      "text": "比如邵雍的先天图和后天图在传承中到底经历了怎样的变形。"
    },
    {
      "segment_id": "s000378",
      "start_ms": 823270,
      "end_ms": 825470,
      "text": "比如以物观物和庄子的，"
    },
    {
      "segment_id": "s000379",
      "start_ms": 825470,
      "end_ms": 829370,
      "text": "其物论之间那种微妙而危险的关系这些东西一旦展开，"
    },
    {
      "segment_id": "s000380",
      "start_ms": 829710,
      "end_ms": 831209,
      "text": "这条内容大概率活不过今晚。"
    },
    {
      "segment_id": "s000381",
      "start_ms": 831230,
      "end_ms": 834120,
      "text": "所以你在屏幕上看到的是删掉三层铺垫，"
    },
    {
      "segment_id": "s000382",
      "start_ms": 834180,
      "end_ms": 835420,
      "text": "砍掉五处引正，"
    },
    {
      "segment_id": "s000383",
      "start_ms": 835540,
      "end_ms": 837200,
      "text": "绕开四个不能碰的词儿之后，"
    },
    {
      "segment_id": "s000384",
      "start_ms": 837400,
      "end_ms": 838915,
      "text": "仍然能留下来的骨架。"
    },
    {
      "segment_id": "s000385",
      "start_ms": 839360,
      "end_ms": 841225,
      "text": "真正的血肉在书里，"
    },
    {
      "segment_id": "s000386",
      "start_ms": 841790,
      "end_ms": 843330,
      "text": "平台能限制一段文案，"
    },
    {
      "segment_id": "s000387",
      "start_ms": 843570,
      "end_ms": 844995,
      "text": "限制不了一本书的厚度。"
    },
    {
      "segment_id": "s000388",
      "start_ms": 845470,
      "end_ms": 846625,
      "text": "这本书适合三种人，"
    },
    {
      "segment_id": "s000389",
      "start_ms": 847050,
      "end_ms": 850670,
      "text": "第一种是被橡树VSE里这个伪命题夹在中间的人，"
    },
    {
      "segment_id": "s000390",
      "start_ms": 850670,
      "end_ms": 851870,
      "text": "你既不想盲目否定，"
    },
    {
      "segment_id": "s000391",
      "start_ms": 852010,
      "end_ms": 853285,
      "text": "也不想傲慢的迷信，"
    },
    {
      "segment_id": "s000392",
      "start_ms": 853670,
      "end_ms": 855635,
      "text": "但你没有语言描述自己的位置。"
    },
    {
      "segment_id": "s000393",
      "start_ms": 856130,
      "end_ms": 857150,
      "text": "这本书给你语言。"
    },
    {
      "segment_id": "s000394",
      "start_ms": 857330,
      "end_ms": 859095,
      "text": "第二种是想训练思维的人，"
    },
    {
      "segment_id": "s000395",
      "start_ms": 859290,
      "end_ms": 860635,
      "text": "你以为橡树是算命，"
    },
    {
      "segment_id": "s000396",
      "start_ms": 860940,
      "end_ms": 862195,
      "text": "它其实是数理推演。"
    },
    {
      "segment_id": "s000397",
      "start_ms": 862710,
      "end_ms": 864725,
      "text": "你以为袁慧运势是神秘主义，"
    },
    {
      "segment_id": "s000398",
      "start_ms": 865040,
      "end_ms": 866325,
      "text": "它其实是历史哲学。"
    },
    {
      "segment_id": "s000399",
      "start_ms": 866600,
      "end_ms": 868880,
      "text": "第三种是对思想史好奇的人。"
    },
    {
      "segment_id": "s000400",
      "start_ms": 868960,
      "end_ms": 871560,
      "text": "你想知道中国十一世纪最聪明的头脑之一，"
    },
    {
      "segment_id": "s000401",
      "start_ms": 871800,
      "end_ms": 876645,
      "text": "如何在一个无法被短期经验验证的问题上反复推演、建构修正？"
    },
    {
      "segment_id": "s000402",
      "start_ms": 877140,
      "end_ms": 878035,
      "text": "这本书给你地图，"
    },
    {
      "segment_id": "s000403",
      "start_ms": 878280,
      "end_ms": 879385,
      "text": "他不适合三种人，"
    },
    {
      "segment_id": "s000404",
      "start_ms": 879990,
      "end_ms": 881960,
      "text": "想找简单答案的人别赌。"
    },
    {
      "segment_id": "s000405",
      "start_ms": 882340,
      "end_ms": 884340,
      "text": "想找战队材料的人别赌，"
    },
    {
      "segment_id": "s000406",
      "start_ms": 884640,
      "end_ms": 886675,
      "text": "想找心灵鸡汤的人别赌，"
    },
    {
      "segment_id": "s000407",
      "start_ms": 886850,
      "end_ms": 887955,
      "text": "他不负责安慰你，"
    },
    {
      "segment_id": "s000408",
      "start_ms": 888320,
      "end_ms": 889595,
      "text": "他负责让你不舒服，"
    },
    {
      "segment_id": "s000409",
      "start_ms": 889940,
      "end_ms": 890740,
      "text": "他不会告诉你，"
    },
    {
      "segment_id": "s000410",
      "start_ms": 890760,
      "end_ms": 892740,
      "text": "信就对了也不会告诉你，"
    },
    {
      "segment_id": "s000411",
      "start_ms": 892760,
      "end_ms": 893940,
      "text": "不信就清醒了。"
    },
    {
      "segment_id": "s000412",
      "start_ms": 893940,
      "end_ms": 895240,
      "text": "他会把你的问题拆开，"
    },
    {
      "segment_id": "s000413",
      "start_ms": 895500,
      "end_ms": 896000,
      "text": "让你看见，"
    },
    {
      "segment_id": "s000414",
      "start_ms": 896000,
      "end_ms": 898585,
      "text": "里面还有多少你从未问过的问题怎么读？"
    },
    {
      "segment_id": "s000415",
      "start_ms": 899270,
      "end_ms": 900775,
      "text": "不要从头到尾跪着读，"
    },
    {
      "segment_id": "s000416",
      "start_ms": 901030,
      "end_ms": 902610,
      "text": "也不要从头到尾审判着读，"
    },
    {
      "segment_id": "s000417",
      "start_ms": 902610,
      "end_ms": 905585,
      "text": "带一支笔先读观物那篇问自己，"
    },
    {
      "segment_id": "s000418",
      "start_ms": 905950,
      "end_ms": 908070,
      "text": "我凭什么相信我每天相信的东西？"
    },
    {
      "segment_id": "s000419",
      "start_ms": 908210,
      "end_ms": 910175,
      "text": "在读历史年表部分问自己，"
    },
    {
      "segment_id": "s000420",
      "start_ms": 910500,
      "end_ms": 914075,
      "text": "那些我以为早就盖棺定论的历史判断真的定论了吗？"
    },
    {
      "segment_id": "s000421",
      "start_ms": 914470,
      "end_ms": 914870,
      "text": "最后，"
    },
    {
      "segment_id": "s000422",
      "start_ms": 914930,
      "end_ms": 916485,
      "text": "读推演方法问自己，"
    },
    {
      "segment_id": "s000423",
      "start_ms": 916730,
      "end_ms": 920515,
      "text": "我能不能在不确定中仍然做出负责任的判断？"
    },
    {
      "segment_id": "s000424",
      "start_ms": 920840,
      "end_ms": 923000,
      "text": "如果只打算从这条内容里带走一个动作，"
    },
    {
      "segment_id": "s000425",
      "start_ms": 923120,
      "end_ms": 925120,
      "text": "我希望是去找这本书来读。"
    },
    {
      "segment_id": "s000426",
      "start_ms": 925200,
      "end_ms": 925925,
      "text": "不是点赞，"
    },
    {
      "segment_id": "s000427",
      "start_ms": 926230,
      "end_ms": 926870,
      "text": "不是收藏，"
    },
    {
      "segment_id": "s000428",
      "start_ms": 927190,
      "end_ms": 927925,
      "text": "是毒。"
    },
    {
      "segment_id": "s000429",
      "start_ms": 928370,
      "end_ms": 929295,
      "text": "不是读我的文案，"
    },
    {
      "segment_id": "s000430",
      "start_ms": 929590,
      "end_ms": 930425,
      "text": "适度邵雍。"
    },
    {
      "segment_id": "s000431",
      "start_ms": 930810,
      "end_ms": 931670,
      "text": "不是读结论，"
    },
    {
      "segment_id": "s000432",
      "start_ms": 931910,
      "end_ms": 932765,
      "text": "是读推演。"
    },
    {
      "segment_id": "s000433",
      "start_ms": 933110,
      "end_ms": 933950,
      "text": "不是赌他算的准，"
    },
    {
      "segment_id": "s000434",
      "start_ms": 933950,
      "end_ms": 935450,
      "text": "不准是读他。"
    },
    {
      "segment_id": "s000435",
      "start_ms": 935450,
      "end_ms": 939290,
      "text": "为什么这样想平台能删掉一段文案删不掉。"
    },
    {
      "segment_id": "s000436",
      "start_ms": 939290,
      "end_ms": 940875,
      "text": "你翻开书之后的那几个小时，"
    },
    {
      "segment_id": "s000437",
      "start_ms": 941490,
      "end_ms": 945420,
      "text": "你们看的这个版本已经是第五版前四版死在草稿箱里。"
    },
    {
      "segment_id": "s000438",
      "start_ms": 945600,
      "end_ms": 946505,
      "text": "这版能活下来，"
    },
    {
      "segment_id": "s000439",
      "start_ms": 946670,
      "end_ms": 947490,
      "text": "是因为他学会了，"
    },
    {
      "segment_id": "s000440",
      "start_ms": 947490,
      "end_ms": 948255,
      "text": "不说太多，"
    },
    {
      "segment_id": "s000441",
      "start_ms": 948650,
      "end_ms": 948930,
      "text": "看书，"
    },
    {
      "segment_id": "s000442",
      "start_ms": 948930,
      "end_ms": 950955,
      "text": "不会书里什么都说了，"
    },
    {
      "segment_id": "s000443",
      "start_ms": 951580,
      "end_ms": 953405,
      "text": "剩下的你自己去看，"
    },
    {
      "segment_id": "s000444",
      "start_ms": 953920,
      "end_ms": 954880,
      "text": "这才是。"
    },
    {
      "segment_id": "s000445",
      "start_ms": 954880,
      "end_ms": 956465,
      "text": "我把这条文案改了五遍，"
    },
    {
      "segment_id": "s000446",
      "start_ms": 956800,
      "end_ms": 958765,
      "text": "仍然要把他推到你面前的原因。"
    },
    {
      "segment_id": "s000447",
      "start_ms": 959050,
      "end_ms": 959730,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000448",
      "start_ms": 959890,
      "end_ms": 961305,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000449",
      "start_ms": 961590,
      "end_ms": 962115,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "c87fd7645398ac67201dc94c7828d23a1912a1a3cfbc0c31f11b0b63cb922bd2"
}