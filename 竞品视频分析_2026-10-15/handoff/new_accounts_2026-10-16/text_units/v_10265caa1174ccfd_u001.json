{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_10265caa1174ccfd_u001",
  "video_id": "v_10265caa1174ccfd",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 1024.302993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 310,
      "end_ms": 3870,
      "text": "十七分钟讲解麦格拉斯基督教神学导论有一本书，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3950,
      "end_ms": 9130,
      "text": "在全球神学院与大学课堂被使用了超过三十年被译成十余种语言，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 9530,
      "end_ms": 12490,
      "text": "却在中文世界的公共知识讨论里几乎隐形，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 12630,
      "end_ms": 13930,
      "text": "不是因为它不重要，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 14090,
      "end_ms": 15530,
      "text": "而是因为它太危险。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 16129,
      "end_ms": 16790,
      "text": "危险到会，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16790,
      "end_ms": 19790,
      "text": "让三代中国知识分子信奉的那套宗教，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 19830,
      "end_ms": 21470,
      "text": "等于迷信信仰，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21470,
      "end_ms": 23190,
      "text": "等于反理性的认知框架。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 23290,
      "end_ms": 24510,
      "text": "发生七级地震。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 24750,
      "end_ms": 27990,
      "text": "这本书叫基督教神学导论作者，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 28010,
      "end_ms": 31540,
      "text": "阿里斯特麦格拉斯是牛津大大学的历史神学教授。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 31620,
      "end_ms": 33820,
      "text": "但比这个头衔更值得注意的是，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 33820,
      "end_ms": 35740,
      "text": "他成为神学家之前的身份，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 36060,
      "end_ms": 38900,
      "text": "一个分子生物物理学家二十二岁，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 39040,
      "end_ms": 41600,
      "text": "他在牛津大学拿到生物化学博士学位。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 41740,
      "end_ms": 42320,
      "text": "两年后，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 42460,
      "end_ms": 45300,
      "text": "他又在同一个地方拿到了神学博士学位。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 45440,
      "end_ms": 48560,
      "text": "一个能用电子显微镜观察蛋白质结构的人，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 48780,
      "end_ms": 52540,
      "text": "转身去研究人类两千年最复杂的认知传统之一。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 53260,
      "end_ms": 55000,
      "text": "邻居们或许觉得他疯了。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 55220,
      "end_ms": 55900,
      "text": "离谱的是，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 56220,
      "end_ms": 59160,
      "text": "麦格拉斯把这种双重身份的思考写成书之后，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 59160,
      "end_ms": 60830,
      "text": "遭遇的不是追捧，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 60930,
      "end_ms": 64600,
      "text": "是来自两个阵营的同时围攻无神论者，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 64600,
      "end_ms": 66115,
      "text": "说他是科学家的叛徒，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 66510,
      "end_ms": 69225,
      "text": "保守派嫌他把信仰变成了哲学思辨。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 69800,
      "end_ms": 70740,
      "text": "人们宁可相信，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 70740,
      "end_ms": 71420,
      "text": "一个科学家，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 71420,
      "end_ms": 73275,
      "text": "信教是某种精神失常，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 73800,
      "end_ms": 75425,
      "text": "也不愿面对一个可怕的真相。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 75920,
      "end_ms": 77885,
      "text": "你对信仰和理性的认知，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 78320,
      "end_ms": 79600,
      "text": "从根儿上就错了。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 79680,
      "end_ms": 83560,
      "text": "今天这条文字我会拆出这本书里最颠覆的五个底层认知。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 83720,
      "end_ms": 84700,
      "text": "但我要提前警告，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 84700,
      "end_ms": 86080,
      "text": "你看完后，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 86220,
      "end_ms": 91580,
      "text": "你可能会推翻过去二十年、三十年奉为归孽的科学VS宗教二元论。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 91640,
      "end_ms": 92880,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 93080,
      "end_ms": 94320,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 94340,
      "end_ms": 95500,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 95620,
      "end_ms": 96935,
      "text": "那我们开始进入正题。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 97310,
      "end_ms": 100750,
      "text": "第一层颠覆神学不是信仰的说明书，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 100930,
      "end_ms": 102110,
      "text": "是一种认知方式。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 102230,
      "end_ms": 103375,
      "text": "你有没有听过这句话？"
    },
    {
      "segment_id": "s000045",
      "start_ms": 103840,
      "end_ms": 107825,
      "text": "神学就是把宗教、教条、系统化和哲学没多大关系。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 108170,
      "end_ms": 111965,
      "text": "基督教神学导论开篇第一个动作就把这套认知判了死刑。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 112240,
      "end_ms": 114215,
      "text": "麦格拉斯给神学下了一个定义，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 114570,
      "end_ms": 117405,
      "text": "神学是对信仰的理性反思。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 117860,
      "end_ms": 118260,
      "text": "注意，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 118440,
      "end_ms": 119080,
      "text": "不是背诵，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 119200,
      "end_ms": 119935,
      "text": "不是呼叫，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 120170,
      "end_ms": 121765,
      "text": "不是把教义装订成册，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 122030,
      "end_ms": 127150,
      "text": "是一种认知方式和物理学历史学、社会学并列的认知方式，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 127210,
      "end_ms": 133275,
      "text": "它使用和其他学科相同的理性工具、逻辑论证、证据、评估、批判性反思。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 134130,
      "end_ms": 135605,
      "text": "这听上去像是常识，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 136140,
      "end_ms": 137075,
      "text": "但你仔细想想，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 137560,
      "end_ms": 140500,
      "text": "我们这代人从小被灌输的是科学讲证据，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 140640,
      "end_ms": 141885,
      "text": "宗教讲信仰。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 142370,
      "end_ms": 143090,
      "text": "言下之意，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 143250,
      "end_ms": 144650,
      "text": "前者需要动脑子，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 144810,
      "end_ms": 146190,
      "text": "后者只需要跪下。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 146290,
      "end_ms": 148030,
      "text": "这套话语的隐蔽暴力在于，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 148310,
      "end_ms": 151395,
      "text": "他先把神学从理性讨论的房间里赶出去，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 151740,
      "end_ms": 153520,
      "text": "然后嘲笑房间里没有神学。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 153600,
      "end_ms": 154515,
      "text": "麦格拉斯说，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 154830,
      "end_ms": 157885,
      "text": "不他在牛津教了十多年神学导论，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 158130,
      "end_ms": 159595,
      "text": "他的学生里有未来的牧师，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 159930,
      "end_ms": 161155,
      "text": "也有未来的无神论者。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 161500,
      "end_ms": 164025,
      "text": "他教的第一件事儿不是你应该信什么，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 164300,
      "end_ms": 167275,
      "text": "而是你如何评估一个论证是好还是坏。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 167960,
      "end_ms": 169860,
      "text": "神学不是让你放弃思考，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 170120,
      "end_ms": 172665,
      "text": "是让你用一种更严格的方式思考。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 172930,
      "end_ms": 174970,
      "text": "他问的问题和哲学一样古老，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 175310,
      "end_ms": 176475,
      "text": "什么是真实的？"
    },
    {
      "segment_id": "s000075",
      "start_ms": 176850,
      "end_ms": 177830,
      "text": "我们如何知道？"
    },
    {
      "segment_id": "s000076",
      "start_ms": 178210,
      "end_ms": 181755,
      "text": "我们如何知道自己知道这不是贩卖理性主义，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 182050,
      "end_ms": 183570,
      "text": "这是一个分子生物学家。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 183570,
      "end_ms": 184990,
      "text": "用他受过训练的思维，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 185210,
      "end_ms": 188670,
      "text": "重新审视一个被启蒙运动驱逐出理性领地。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 188670,
      "end_ms": 192955,
      "text": "两千年的学科神学不要求你先跪下，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 193510,
      "end_ms": 194835,
      "text": "他要求你先坐下，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 195420,
      "end_ms": 196685,
      "text": "他不要求你同意，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 197150,
      "end_ms": 198295,
      "text": "他要求你理解。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 198730,
      "end_ms": 200015,
      "text": "理解不等于接受。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 200510,
      "end_ms": 201830,
      "text": "你可以理解一个论证，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 201950,
      "end_ms": 202915,
      "text": "同时拒绝他。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 203500,
      "end_ms": 205320,
      "text": "就像你可以理解康德的义务论，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 205540,
      "end_ms": 207095,
      "text": "同时不做康德主义者。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 207490,
      "end_ms": 209170,
      "text": "你可以理解尼采的谱系学，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 209370,
      "end_ms": 211045,
      "text": "同时不成为尼采的门徒。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 211600,
      "end_ms": 212645,
      "text": "神学也一样，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 213220,
      "end_ms": 214975,
      "text": "他首先是一个认知对象，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 215370,
      "end_ms": 217225,
      "text": "然后才是一个立场选择。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 217680,
      "end_ms": 218100,
      "text": "第二层，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 218100,
      "end_ms": 220580,
      "text": "颠覆信仰不是理性的反面，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 220780,
      "end_ms": 222000,
      "text": "是理性的一部分。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 222080,
      "end_ms": 225875,
      "text": "我们这代人从小被灌输理性和信仰是对立的，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 226400,
      "end_ms": 227480,
      "text": "理性讲证据，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 227620,
      "end_ms": 228755,
      "text": "信仰讲跳跃。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 229450,
      "end_ms": 230970,
      "text": "所以当一个人说我信时，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 231130,
      "end_ms": 233295,
      "text": "大家会下意识觉得他放弃了思考。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 233890,
      "end_ms": 238045,
      "text": "基督教神学导论用一整套认识论分析砸碎了这套二元论。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 238420,
      "end_ms": 239365,
      "text": "麦格拉斯说，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 239880,
      "end_ms": 241740,
      "text": "所谓信仰与理性的对立，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 241920,
      "end_ms": 244740,
      "text": "本身就是一个需要被审视的哲学立场，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 245040,
      "end_ms": 246720,
      "text": "而不是一个自明的真理。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 247140,
      "end_ms": 249580,
      "text": "你把信仰和理性放在天平两端，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 250020,
      "end_ms": 252400,
      "text": "但你从来没有问过这两样东西，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 252560,
      "end_ms": 254320,
      "text": "真的在同一个层面上吗？"
    },
    {
      "segment_id": "s000110",
      "start_ms": 254800,
      "end_ms": 258920,
      "text": "他提出了一个关键区分信仰不是理性的替代品，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 259440,
      "end_ms": 262340,
      "text": "信仰是理性在认知边界上的延伸。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 262360,
      "end_ms": 262920,
      "text": "什么意思？"
    },
    {
      "segment_id": "s000113",
      "start_ms": 263400,
      "end_ms": 265860,
      "text": "你无法用实验证明我妻子爱我，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 266160,
      "end_ms": 267360,
      "text": "但你不是因为这个原因，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 267360,
      "end_ms": 269340,
      "text": "就不相信你的信任，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 269340,
      "end_ms": 272470,
      "text": "建立在经验关系理解的累积之上，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 273070,
      "end_ms": 274510,
      "text": "这是另一种认知模式。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 274790,
      "end_ms": 276090,
      "text": "不比你做化学实验，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 276090,
      "end_ms": 277410,
      "text": "更低级麦格拉斯。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 277410,
      "end_ms": 277970,
      "text": "进一步说，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 278570,
      "end_ms": 283910,
      "text": "所有认知行为包括科学认知都建立在某些无法被证明的先决。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 283930,
      "end_ms": 284510,
      "text": "假设上。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 284870,
      "end_ms": 288810,
      "text": "科学家假设宇宙是有秩序的、可理解的规律的。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 289110,
      "end_ms": 291390,
      "text": "这些假设本身无法被实验证明，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 291630,
      "end_ms": 293950,
      "text": "但他们是科学能够运作的前提。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 294690,
      "end_ms": 295530,
      "text": "你信仰宇宙，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 295530,
      "end_ms": 298610,
      "text": "可理解和你信仰存在一个可理解。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 298610,
      "end_ms": 302140,
      "text": "宇宙的来源在认知结构上没有本质区别，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 302480,
      "end_ms": 306055,
      "text": "区别只在于后者把问题推到了更深的层面。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 307030,
      "end_ms": 308370,
      "text": "这句话可能会刺痛你，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 309110,
      "end_ms": 310950,
      "text": "你总说我只相信科学，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 311610,
      "end_ms": 314610,
      "text": "可你有没有想过你凭什么相信科学？"
    },
    {
      "segment_id": "s000133",
      "start_ms": 314950,
      "end_ms": 315870,
      "text": "你相信科学，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 316050,
      "end_ms": 317890,
      "text": "是因为你相信宇宙有规律。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 318170,
      "end_ms": 319510,
      "text": "你相信宇宙有规律，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 319630,
      "end_ms": 322030,
      "text": "是因为你观察到他似乎有规律。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 322250,
      "end_ms": 324110,
      "text": "你观察到他似乎有规律，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 324250,
      "end_ms": 327050,
      "text": "是因为你用有规律的方式去观察它。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 327450,
      "end_ms": 329370,
      "text": "这个循环不是科学家的耻辱，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 329690,
      "end_ms": 331410,
      "text": "这是所有认知的起点。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 331910,
      "end_ms": 333690,
      "text": "麦格拉斯不是要否定科学，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 334010,
      "end_ms": 336685,
      "text": "他是要告诉你科学也有信仰，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 336860,
      "end_ms": 337260,
      "text": "前提，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 337660,
      "end_ms": 338860,
      "text": "只是它不叫信仰，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 339120,
      "end_ms": 340660,
      "text": "叫方法论假设。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 341060,
      "end_ms": 344620,
      "text": "而神学要做的是把这些假设也拿到桌面上，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 344620,
      "end_ms": 345160,
      "text": "问一句，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 345460,
      "end_ms": 346700,
      "text": "他们为什么成立？"
    },
    {
      "segment_id": "s000149",
      "start_ms": 347120,
      "end_ms": 348360,
      "text": "他们能承受多少？"
    },
    {
      "segment_id": "s000150",
      "start_ms": 348360,
      "end_ms": 351800,
      "text": "追问第三层颠覆神学的工具不是灌输，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 352040,
      "end_ms": 353460,
      "text": "是批判实在论。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 353680,
      "end_ms": 354000,
      "text": "主流。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 354000,
      "end_ms": 354760,
      "text": "认知告诉你，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 354760,
      "end_ms": 355320,
      "text": "要么信，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 355420,
      "end_ms": 356100,
      "text": "要么不信，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 356440,
      "end_ms": 357480,
      "text": "信就是盲从，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 357740,
      "end_ms": 358980,
      "text": "不信就是清醒。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 359400,
      "end_ms": 360820,
      "text": "这套模式的潜台词是，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 361160,
      "end_ms": 363700,
      "text": "神学只在信的前提下才有意义，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 364020,
      "end_ms": 366395,
      "text": "不信的人根本不需要了解他。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 366720,
      "end_ms": 367520,
      "text": "但麦格拉斯说，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 367800,
      "end_ms": 368555,
      "text": "这是错的。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 369130,
      "end_ms": 372625,
      "text": "他建立了一套被称为批判实在论的方法论框架，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 372980,
      "end_ms": 375165,
      "text": "彻底扭转了神学讨论的方式。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 375590,
      "end_ms": 377035,
      "text": "什么叫批判实在论？"
    },
    {
      "segment_id": "s000166",
      "start_ms": 377410,
      "end_ms": 377970,
      "text": "简单说，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 378250,
      "end_ms": 381535,
      "text": "存在一个真实的独立于我们认知之外的世界，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 382060,
      "end_ms": 384615,
      "text": "但我们无法完全精确的捕捉它，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 385120,
      "end_ms": 386995,
      "text": "所有的认知都是近似的。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 387520,
      "end_ms": 389120,
      "text": "我们尽力描述真实，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 389360,
      "end_ms": 392820,
      "text": "但永远知道自己描述的是有限的不同学科，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 392820,
      "end_ms": 394615,
      "text": "负责描述真实的不同层次。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 395180,
      "end_ms": 396740,
      "text": "物理学描述物质层面，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 396920,
      "end_ms": 398580,
      "text": "生物学描述生命层面，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 398820,
      "end_ms": 401135,
      "text": "神学描述终极意义层面，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 401480,
      "end_ms": 404275,
      "text": "没有哪个学科能垄断对真实的解释权。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 404790,
      "end_ms": 409015,
      "text": "这套方法的核心是你不能因为一个认知不完美就把它扔掉，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 409320,
      "end_ms": 410480,
      "text": "也不能因为它有用，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 410560,
      "end_ms": 411565,
      "text": "就把它绝对化。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 412110,
      "end_ms": 413795,
      "text": "每一次认知都是后验的，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 414090,
      "end_ms": 415545,
      "text": "先观察再理解，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 415810,
      "end_ms": 417215,
      "text": "根据证据调整立场，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 417660,
      "end_ms": 419945,
      "text": "这和科学方法在逻辑上是一致的。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 420270,
      "end_ms": 423435,
      "text": "提出假设检验修正再检验。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 423980,
      "end_ms": 425615,
      "text": "麦格拉斯反对两种极端，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 425970,
      "end_ms": 427385,
      "text": "一是实在论的傲慢，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 427910,
      "end_ms": 430075,
      "text": "以为自己的描述就是绝对真理。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 430420,
      "end_ms": 431995,
      "text": "二是相对主义的投降，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 432360,
      "end_ms": 435250,
      "text": "以为没有一种描述比另一种更好批判。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 435250,
      "end_ms": 436795,
      "text": "实战论走的是第三条路，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 437190,
      "end_ms": 438195,
      "text": "认真的相信，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 438520,
      "end_ms": 441810,
      "text": "同时谦卑的知道自己是近似的这套逻辑，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 441810,
      "end_ms": 443935,
      "text": "彻底取消了信的人没脑子，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 444140,
      "end_ms": 445460,
      "text": "不信的人才有理性。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 445600,
      "end_ms": 446695,
      "text": "这个伪选择题，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 447400,
      "end_ms": 448095,
      "text": "你仔细想，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 448470,
      "end_ms": 451295,
      "text": "这其实也是科学哲学里吵了几十年的问题。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 451900,
      "end_ms": 452580,
      "text": "波普尔说，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 452660,
      "end_ms": 453985,
      "text": "科学是可证伪的。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 454360,
      "end_ms": 454980,
      "text": "库恩说，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 455040,
      "end_ms": 456475,
      "text": "科学是范式转换。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 456870,
      "end_ms": 457570,
      "text": "波兰尼说，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 457670,
      "end_ms": 459415,
      "text": "科学包含个人知识，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 459810,
      "end_ms": 462755,
      "text": "麦格拉斯把同样的认识论工具用在神学上。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 463260,
      "end_ms": 465200,
      "text": "神学语言不是数学语言，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 465280,
      "end_ms": 466315,
      "text": "不是实验报告，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 466710,
      "end_ms": 470125,
      "text": "它包含隐喻、类比、叙事象征，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 470460,
      "end_ms": 471355,
      "text": "但这不是缺陷，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 471710,
      "end_ms": 473650,
      "text": "这是面对终极问题时的认知。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 473650,
      "end_ms": 474150,
      "text": "诚实，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 474390,
      "end_ms": 476985,
      "text": "你不能用测量温度的方式测量意义。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 477320,
      "end_ms": 481000,
      "text": "但你也不能因为温度计测不出异议就说意义不存在。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 481140,
      "end_ms": 482780,
      "text": "第四层颠覆神学，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 482860,
      "end_ms": 484045,
      "text": "不是私人体验，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 484250,
      "end_ms": 485190,
      "text": "是公共知识。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 485370,
      "end_ms": 486790,
      "text": "市面上关于宗教的讨论，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 486790,
      "end_ms": 489565,
      "text": "百分之九十九都集中在个人体验层面。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 489960,
      "end_ms": 490580,
      "text": "你信不信？"
    },
    {
      "segment_id": "s000219",
      "start_ms": 490700,
      "end_ms": 491735,
      "text": "那是你自己的事儿，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 492010,
      "end_ms": 493815,
      "text": "别人信不信和你没关系。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 494250,
      "end_ms": 495825,
      "text": "这套模式的潜台词是，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 496200,
      "end_ms": 497460,
      "text": "信仰是主观的，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 497560,
      "end_ms": 499995,
      "text": "不需要也不应该被理性审视。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 500370,
      "end_ms": 501610,
      "text": "基督教神学导论说，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 501890,
      "end_ms": 502665,
      "text": "你错了，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 503030,
      "end_ms": 505090,
      "text": "神学从来不是私人事物，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 505170,
      "end_ms": 508255,
      "text": "它涉及的是一系列可以被公开讨论的命题。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 508750,
      "end_ms": 510035,
      "text": "宇宙是否有意义？"
    },
    {
      "segment_id": "s000229",
      "start_ms": 510370,
      "end_ms": 511725,
      "text": "人的尊严来自哪里？"
    },
    {
      "segment_id": "s000230",
      "start_ms": 512110,
      "end_ms": 514370,
      "text": "苦难是否可以解释这些问题，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 514370,
      "end_ms": 515665,
      "text": "和你信不信无关，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 516000,
      "end_ms": 517885,
      "text": "他们是人类共同面对的问题。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 518180,
      "end_ms": 520645,
      "text": "麦格拉斯把神学放回公共讨论的领域，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 520950,
      "end_ms": 522470,
      "text": "他是在两千年的历史中，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 522630,
      "end_ms": 527075,
      "text": "无数人用理性经验和对话积累起来的认知传统。"
    },
    {
      "segment_id": "s000236",
      "start_ms": 527470,
      "end_ms": 530805,
      "text": "他花了大量篇幅梳理基督教神学的历史脉络，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 531200,
      "end_ms": 533080,
      "text": "从教父时期到中世纪，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 533120,
      "end_ms": 533880,
      "text": "到宗教改革，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 533880,
      "end_ms": 534625,
      "text": "到现代，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 535030,
      "end_ms": 538045,
      "text": "每一个时代的认知框架都被清晰的呈现出来。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 538570,
      "end_ms": 540075,
      "text": "他不是让你接受什么，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 540460,
      "end_ms": 541820,
      "text": "他是让你理解什么，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 541820,
      "end_ms": 543915,
      "text": "理解一个思想传统如何形成，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 544280,
      "end_ms": 545725,
      "text": "如何在争论中演变，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 546000,
      "end_ms": 548795,
      "text": "如何在不同的文化处境中提出不同的方案。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 549170,
      "end_ms": 552585,
      "text": "这套方法论把神学从私人信仰的抽屉里拿出来，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 552840,
      "end_ms": 554545,
      "text": "放在公共知识的长桌上。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 554810,
      "end_ms": 555385,
      "text": "他写道，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 555930,
      "end_ms": 558855,
      "text": "神学不是把信仰装进一个封闭的盒子，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 559320,
      "end_ms": 560240,
      "text": "是打开一扇窗，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 560620,
      "end_ms": 562925,
      "text": "让你看见你从未看见过的风景。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 563220,
      "end_ms": 567335,
      "text": "这句话的深层含义是你不必是基督徒才能理解神学，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 567700,
      "end_ms": 570285,
      "text": "就像你不必是物理学家才能理解相对论，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 570700,
      "end_ms": 573145,
      "text": "你需要的只是好奇心和思考的意愿。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 573830,
      "end_ms": 575690,
      "text": "公共知识不等于强制共识，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 576070,
      "end_ms": 580050,
      "text": "它意味着可讨论、可批评、可修正神学。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 580050,
      "end_ms": 580870,
      "text": "在公共领域，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 580870,
      "end_ms": 585055,
      "text": "要接受哲学、历史、科学伦理的交叉检验。"
    },
    {
      "segment_id": "s000259",
      "start_ms": 585290,
      "end_ms": 587845,
      "text": "他不能躲在这是信仰后面拒绝提问，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 588130,
      "end_ms": 589410,
      "text": "也不能因为被提问，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 589410,
      "end_ms": 590590,
      "text": "就觉得自己被冒犯。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 590730,
      "end_ms": 594545,
      "text": "麦格拉斯的态度是来问把最难的问题拿来。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 595130,
      "end_ms": 597150,
      "text": "如果这套传统连问题都经不起，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 597310,
      "end_ms": 598890,
      "text": "他就不配被称为传统。"
    },
    {
      "segment_id": "s000265",
      "start_ms": 599050,
      "end_ms": 600190,
      "text": "如果他经得起他，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 600190,
      "end_ms": 602410,
      "text": "就不需要靠禁止提问来存活。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 602570,
      "end_ms": 603150,
      "text": "第五层，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 603150,
      "end_ms": 604850,
      "text": "颠覆学会神学，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 604950,
      "end_ms": 607010,
      "text": "唯一的终点是让你离开，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 607050,
      "end_ms": 608810,
      "text": "信不信这个伪命题。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 608830,
      "end_ms": 609270,
      "text": "读到这里，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 609270,
      "end_ms": 609930,
      "text": "你可能想问，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 610070,
      "end_ms": 613165,
      "text": "说了这么多最终目标不还是让人信教吗？"
    },
    {
      "segment_id": "s000274",
      "start_ms": 613500,
      "end_ms": 614965,
      "text": "麦格拉斯自己是基督徒？"
    },
    {
      "segment_id": "s000275",
      "start_ms": 615330,
      "end_ms": 616850,
      "text": "他写书不就是在传教，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 617210,
      "end_ms": 617870,
      "text": "如果你这样，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 617870,
      "end_ms": 619370,
      "text": "想你就掉进了这本书，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 619370,
      "end_ms": 620690,
      "text": "埋了三十年的陷阱。"
    },
    {
      "segment_id": "s000279",
      "start_ms": 620870,
      "end_ms": 623970,
      "text": "麦格拉斯用一生证明的不是科学和宗教，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 623990,
      "end_ms": 626130,
      "text": "可以共存这个廉价的和解口号，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 626610,
      "end_ms": 628530,
      "text": "而是科学和宗教的冲突，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 628570,
      "end_ms": 631329,
      "text": "本身就是一个被制造出来的叙事。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 631990,
      "end_ms": 633730,
      "text": "他最大的颠覆不是立场，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 633930,
      "end_ms": 634570,
      "text": "是方法。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 634870,
      "end_ms": 636130,
      "text": "他在书里反复强调，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 636390,
      "end_ms": 637690,
      "text": "我写的是一本导论，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 637930,
      "end_ms": 638990,
      "text": "不是一本辩护。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 639070,
      "end_ms": 641210,
      "text": "我的任务不是让你同意某个结论，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 641330,
      "end_ms": 643670,
      "text": "是让你有能力评估所有结论。"
    },
    {
      "segment_id": "s000290",
      "start_ms": 644030,
      "end_ms": 651240,
      "text": "他把两千年的神学辩论是拆开来给你看每一个论证的骨骼谁在什么处境下提出了什么观点，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 651460,
      "end_ms": 653080,
      "text": "这个观点的弱点在哪里，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 653160,
      "end_ms": 654880,
      "text": "他的对手又是怎么回应的。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 655260,
      "end_ms": 657700,
      "text": "然后他退后一步说你自己判断，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 658060,
      "end_ms": 658660,
      "text": "为什么？"
    },
    {
      "segment_id": "s000295",
      "start_ms": 659160,
      "end_ms": 660280,
      "text": "因为他太清楚。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 660540,
      "end_ms": 661820,
      "text": "在信仰的辩论中，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 662020,
      "end_ms": 663560,
      "text": "最稀缺的不是答案，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 663800,
      "end_ms": 665600,
      "text": "是问出好问题的能力。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 665680,
      "end_ms": 668120,
      "text": "你不需要在信和不信之间做选择，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 668500,
      "end_ms": 670920,
      "text": "你需要先搞清楚你选择的是什么。"
    },
    {
      "segment_id": "s000301",
      "start_ms": 670920,
      "end_ms": 673080,
      "text": "是那个被无神论者批判的稻草人，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 673500,
      "end_ms": 676030,
      "text": "是那个被原教旨主义者简化的教条，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 676270,
      "end_ms": 680705,
      "text": "还是一个有两千年理性传统支撑的复杂认知体系？"
    },
    {
      "segment_id": "s000304",
      "start_ms": 680880,
      "end_ms": 681745,
      "text": "麦格拉斯写道，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 682170,
      "end_ms": 684905,
      "text": "好的导论不给你答案给你地图。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 685680,
      "end_ms": 688205,
      "text": "地图的价值不在于告诉你该去哪里，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 688480,
      "end_ms": 690405,
      "text": "而在于让你知道你站在哪里。"
    },
    {
      "segment_id": "s000308",
      "start_ms": 690570,
      "end_ms": 693805,
      "text": "所以你看这本书最惊世骇俗的答案藏在这里。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 694250,
      "end_ms": 697805,
      "text": "学习神学最大的收获不是获得了某种信仰立场，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 698120,
      "end_ms": 701335,
      "text": "而是获得了一种在复杂问题面前不慌张的能力。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 701600,
      "end_ms": 702580,
      "text": "你不必急于表态，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 702800,
      "end_ms": 704905,
      "text": "你有能力理解一个论证的质地，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 705190,
      "end_ms": 707245,
      "text": "你有耐心等待思考的成熟。"
    },
    {
      "segment_id": "s000314",
      "start_ms": 707700,
      "end_ms": 709375,
      "text": "你不需要被所有人说服，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 709730,
      "end_ms": 712435,
      "text": "你只需要在独处时对自己的判断负责。"
    },
    {
      "segment_id": "s000316",
      "start_ms": 712980,
      "end_ms": 714380,
      "text": "读完基督教神学导论，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 714460,
      "end_ms": 716345,
      "text": "你可能发现书名起错了。"
    },
    {
      "segment_id": "s000318",
      "start_ms": 716940,
      "end_ms": 717920,
      "text": "这不是一本信仰。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 717920,
      "end_ms": 718535,
      "text": "入门书，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 718920,
      "end_ms": 723575,
      "text": "是一本关于人如何在理性与未知之间安身立命的哲学手记。"
    },
    {
      "segment_id": "s000321",
      "start_ms": 724060,
      "end_ms": 725340,
      "text": "科学博士不是重点，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 725400,
      "end_ms": 726675,
      "text": "牛津教授不是重点，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 726970,
      "end_ms": 727870,
      "text": "批判实在论，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 727910,
      "end_ms": 728755,
      "text": "也不是重点。"
    },
    {
      "segment_id": "s000325",
      "start_ms": 728990,
      "end_ms": 731935,
      "text": "重点是那个从分子生物学转行的学者，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 732200,
      "end_ms": 735305,
      "text": "面对一个被学术世界判了认知死刑的领域，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 735560,
      "end_ms": 737505,
      "text": "说我不服从偏见，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 737840,
      "end_ms": 740085,
      "text": "我只服从我看见的复杂性。"
    },
    {
      "segment_id": "s000329",
      "start_ms": 740680,
      "end_ms": 741705,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000330",
      "start_ms": 742460,
      "end_ms": 744805,
      "text": "他看见神学不是科学的敌人，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 745100,
      "end_ms": 746360,
      "text": "不是哲学的附庸，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 746640,
      "end_ms": 749105,
      "text": "不是需要被拯救或抛弃的遗产。"
    },
    {
      "segment_id": "s000333",
      "start_ms": 749820,
      "end_ms": 750965,
      "text": "它是一面镜子，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 751360,
      "end_ms": 754055,
      "text": "映照出人类在宇宙中最根本的处境。"
    },
    {
      "segment_id": "s000335",
      "start_ms": 754490,
      "end_ms": 755715,
      "text": "我们知道一些东西，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 756130,
      "end_ms": 757605,
      "text": "我们不知道更多东西，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 758150,
      "end_ms": 760805,
      "text": "而我们必须在不知道中做出决定。"
    },
    {
      "segment_id": "s000338",
      "start_ms": 761170,
      "end_ms": 764975,
      "text": "这本书最后有一段话是麦格拉斯在导论结尾写的，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 765330,
      "end_ms": 766335,
      "text": "我想把它留给你。"
    },
    {
      "segment_id": "s000340",
      "start_ms": 766710,
      "end_ms": 767390,
      "text": "人们问我，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 767610,
      "end_ms": 769290,
      "text": "你从科学转向神学，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 769590,
      "end_ms": 770810,
      "text": "是不是背叛了理性？"
    },
    {
      "segment_id": "s000343",
      "start_ms": 771050,
      "end_ms": 773180,
      "text": "我说不是我骄傲的，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 773180,
      "end_ms": 775935,
      "text": "是我在实验室里学会了一件重要的事。"
    },
    {
      "segment_id": "s000345",
      "start_ms": 776420,
      "end_ms": 778260,
      "text": "面对未知最好的态度，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 778260,
      "end_ms": 779715,
      "text": "不是假装没有未知，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 780060,
      "end_ms": 782055,
      "text": "不是用标签把位置打发掉，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 782500,
      "end_ms": 785635,
      "text": "最好的态度是坐下来认真看，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 786010,
      "end_ms": 786685,
      "text": "慢慢想，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 787360,
      "end_ms": 788760,
      "text": "愿意接受自己的假设，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 789000,
      "end_ms": 789995,
      "text": "可能是错的。"
    },
    {
      "segment_id": "s000352",
      "start_ms": 790420,
      "end_ms": 795985,
      "text": "我骄傲的是我学会了在别人以为已经有答案的地方保持提问的勇气。"
    },
    {
      "segment_id": "s000353",
      "start_ms": 796390,
      "end_ms": 799635,
      "text": "这才是我从二十二岁拿到博士学位那年开始，"
    },
    {
      "segment_id": "s000354",
      "start_ms": 799990,
      "end_ms": 801275,
      "text": "每一天都在做的事。"
    },
    {
      "segment_id": "s000355",
      "start_ms": 801800,
      "end_ms": 804515,
      "text": "最后我想认真推荐一次这本书。"
    },
    {
      "segment_id": "s000356",
      "start_ms": 804970,
      "end_ms": 806530,
      "text": "如果你看到这里还没有划走，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 806890,
      "end_ms": 808310,
      "text": "说明你心里有一个问题，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 808310,
      "end_ms": 809455,
      "text": "一直没有被回答。"
    },
    {
      "segment_id": "s000359",
      "start_ms": 809770,
      "end_ms": 813070,
      "text": "我们到底该怎么面对那些理性无法完全证明，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 813250,
      "end_ms": 815355,
      "text": "却又无法被简单否定的事情？"
    },
    {
      "segment_id": "s000361",
      "start_ms": 815940,
      "end_ms": 818475,
      "text": "基督教神学导论就是为这个问题写的，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 818710,
      "end_ms": 820095,
      "text": "他不是让你信什么，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 820450,
      "end_ms": 825035,
      "text": "他是让你看见信和不信之间那片被我们粗暴踩平的地带。"
    },
    {
      "segment_id": "s000364",
      "start_ms": 825510,
      "end_ms": 826870,
      "text": "你们看的这个版本的解读，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 827090,
      "end_ms": 829680,
      "text": "文案优化了不下五次第一版，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 829880,
      "end_ms": 831800,
      "text": "我试图把每一个论证都摊开，"
    },
    {
      "segment_id": "s000367",
      "start_ms": 832240,
      "end_ms": 834475,
      "text": "结果像论文没人看得下去。"
    },
    {
      "segment_id": "s000368",
      "start_ms": 834860,
      "end_ms": 835420,
      "text": "第二版，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 835540,
      "end_ms": 837440,
      "text": "我试图把每一个争议都绕开，"
    },
    {
      "segment_id": "s000370",
      "start_ms": 837600,
      "end_ms": 838440,
      "text": "结果像鸡汤，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 838580,
      "end_ms": 840185,
      "text": "对不起这本书第三版，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 840490,
      "end_ms": 842285,
      "text": "我试图用科学压神学，"
    },
    {
      "segment_id": "s000373",
      "start_ms": 842630,
      "end_ms": 846175,
      "text": "结果发现自己连科学方法的哲学前提都没讲清第四版。"
    },
    {
      "segment_id": "s000374",
      "start_ms": 846490,
      "end_ms": 848355,
      "text": "我试图用神学压科学，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 848630,
      "end_ms": 851605,
      "text": "结果又踩进了另一个不能碰的坑到第五版。"
    },
    {
      "segment_id": "s000376",
      "start_ms": 852010,
      "end_ms": 852765,
      "text": "我才明白，"
    },
    {
      "segment_id": "s000377",
      "start_ms": 853250,
      "end_ms": 855590,
      "text": "真正的解读不是替这本书说话，"
    }
  ],
  "source_transcript_sha256": "f927b5bcf4fde102127cd3c10ae1ffb1c14ac831528177a4d8f98ef766e4756c"
}