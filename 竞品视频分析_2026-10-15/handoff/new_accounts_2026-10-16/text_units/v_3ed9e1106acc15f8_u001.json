{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_3ed9e1106acc15f8_u001",
  "video_id": "v_3ed9e1106acc15f8",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 365.227007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 490,
      "end_ms": 6010,
      "text": "你知道北京故宫里头老祖宗手艺登峰造极的宝贝都有哪些吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 6750,
      "end_ms": 10550,
      "text": "很多人第一反应想到翠玉白菜毛公鼎，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 11110,
      "end_ms": 14090,
      "text": "可这两件文物并不收藏在北京故宫，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 14450,
      "end_ms": 16770,
      "text": "而是藏于台北故宫博物院。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 17490,
      "end_ms": 18630,
      "text": "有一件国宝，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 19050,
      "end_ms": 21450,
      "text": "几乎每个中国人都听过它的名字，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 21450,
      "end_ms": 24270,
      "text": "却很少有人亲眼见过实物。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 24270,
      "end_ms": 26530,
      "text": "它历经五次劫难，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 26530,
      "end_ms": 28150,
      "text": "四次流离宫外，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 28150,
      "end_ms": 29410,
      "text": "几经辗转，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 29410,
      "end_ms": 34720,
      "text": "最最后竟然是在一堆被视作赝品的古画之中被重新发现。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 35580,
      "end_ms": 36040,
      "text": "今天，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 36380,
      "end_ms": 41060,
      "text": "我们就一起来盘点故宫十件巧夺天工的传世国宝，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 41620,
      "end_ms": 45360,
      "text": "每一件都承载一段险些失传的往事，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 46139,
      "end_ms": 48660,
      "text": "排在第十名的就是象牙席。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 49640,
      "end_ms": 51360,
      "text": "倘若不曾亲眼见过，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 51660,
      "end_ms": 57040,
      "text": "很难想象夏日纳凉的凉席居然是用整根象牙编织而成，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 57460,
      "end_ms": 62705,
      "text": "这是何等高超的古代记艺象牙质地坚硬又脆，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 63070,
      "end_ms": 64410,
      "text": "普通人很难想象，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 64550,
      "end_ms": 69510,
      "text": "他能被劈成细软面条编织成席清代宫廷匠人，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 69610,
      "end_ms": 70965,
      "text": "掌握独门工艺，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 71290,
      "end_ms": 71710,
      "text": "用药，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 71710,
      "end_ms": 72410,
      "text": "水软化，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 72410,
      "end_ms": 75045,
      "text": "象牙披成薄如纱线的细面，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 75540,
      "end_ms": 77025,
      "text": "编织为人字纹样，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 77710,
      "end_ms": 79290,
      "text": "睡上去温润清凉，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 79570,
      "end_ms": 81070,
      "text": "还能如同绸缎一般，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 81170,
      "end_ms": 82275,
      "text": "随意卷收，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 83210,
      "end_ms": 86955,
      "text": "可这般绝顶手艺却被一纸圣旨叫停。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 87510,
      "end_ms": 90710,
      "text": "雍正皇帝、体恤物力耗费巨大下，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 90730,
      "end_ms": 92765,
      "text": "旨禁止在制作象牙席。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 93390,
      "end_ms": 94465,
      "text": "这道诏令一出，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 94740,
      "end_ms": 97560,
      "text": "民间再也不敢制作这项技艺，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 97680,
      "end_ms": 99345,
      "text": "就此彻底失传。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 100200,
      "end_ms": 101105,
      "text": "时至今日，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 101450,
      "end_ms": 106880,
      "text": "全世界留存下来的象牙席仅有三张故宫这件两米多长，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 107140,
      "end_ms": 108420,
      "text": "历经两百余年，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 108420,
      "end_ms": 109760,
      "text": "岁月席上，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 109760,
      "end_ms": 111135,
      "text": "面条完好无损，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 112110,
      "end_ms": 113535,
      "text": "匠人早已远去，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 114040,
      "end_ms": 117180,
      "text": "但这份巧夺天工的手艺得以留存。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 117240,
      "end_ms": 121275,
      "text": "后世排在第九位的金嵌珍珠天球仪，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 121700,
      "end_ms": 125845,
      "text": "可以说真正做到以器物描摹浩瀚星河。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 126780,
      "end_ms": 128985,
      "text": "这件器物诞生于乾隆时期，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 129490,
      "end_ms": 131370,
      "text": "通体以纯金打造球体，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 131690,
      "end_ms": 134090,
      "text": "上面镶嵌数千颗珍珠标记，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 134110,
      "end_ms": 135770,
      "text": "星辰位置完整，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 135790,
      "end_ms": 136595,
      "text": "复刻星象，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 137370,
      "end_ms": 139105,
      "text": "没有现代天文设备，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 139510,
      "end_ms": 142275,
      "text": "古代匠人仅凭一代代观测积累，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 142520,
      "end_ms": 145805,
      "text": "把整片星空浓缩在一只金球之上。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 146250,
      "end_ms": 148850,
      "text": "九条金龙托起球体工艺，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 148950,
      "end_ms": 151935,
      "text": "繁复精美两百多年，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 152350,
      "end_ms": 154765,
      "text": "他一直安放在紫禁城之中。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 155200,
      "end_ms": 156825,
      "text": "今天到故宫珍宝馆，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 157140,
      "end_ms": 158495,
      "text": "站在这件文物面前，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 158780,
      "end_ms": 161835,
      "text": "就如同将漫天银河捧于掌心。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 162350,
      "end_ms": 164070,
      "text": "这份古人独有的浪漫，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 164270,
      "end_ms": 165905,
      "text": "令人心生感叹。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 166760,
      "end_ms": 169535,
      "text": "第八件就是大名鼎鼎的慈母，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 169940,
      "end_ms": 171405,
      "text": "各种釉彩大屏。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 172200,
      "end_ms": 173455,
      "text": "为什么叫慈母？"
    },
    {
      "segment_id": "s000063",
      "start_ms": 174230,
      "end_ms": 175010,
      "text": "乾隆时期，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 175010,
      "end_ms": 180945,
      "text": "工匠把十几种截然不同的釉材集中烧制在一只大型瓷瓶之上。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 181550,
      "end_ms": 184555,
      "text": "青花、粉彩、窑变鸽釉，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 185120,
      "end_ms": 186360,
      "text": "每一种釉料烧制，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 186360,
      "end_ms": 188055,
      "text": "温度都各不相同，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 188510,
      "end_ms": 191095,
      "text": "要在同一件器物上全部烧成功，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 191410,
      "end_ms": 193405,
      "text": "难度堪称登天之难。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 194310,
      "end_ms": 195275,
      "text": "稍有温差，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 195620,
      "end_ms": 197725,
      "text": "整件器物就直接报废，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 198360,
      "end_ms": 199945,
      "text": "存世仅此一件，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 200580,
      "end_ms": 201395,
      "text": "一只瓶子，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 201730,
      "end_ms": 204675,
      "text": "几乎极其古代陶瓷的万千风华，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 205140,
      "end_ms": 207545,
      "text": "称得上一部立体的陶瓷史书。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 208310,
      "end_ms": 209135,
      "text": "第七名，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 209660,
      "end_ms": 213105,
      "text": "金发塔藏着一代帝王的孝心。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 214010,
      "end_ms": 217045,
      "text": "乾隆的生母重庆皇太后过世之后，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 217390,
      "end_ms": 219650,
      "text": "乾隆为安放母亲遗留的发丝，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 219970,
      "end_ms": 222145,
      "text": "下令打造这座鎏金宝塔。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 222730,
      "end_ms": 226150,
      "text": "塔身耗费数千两黄金镶嵌无数，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 226250,
      "end_ms": 229955,
      "text": "珠宝塔不大却重于百斤，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 230470,
      "end_ms": 232015,
      "text": "世间珍宝无数。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 232540,
      "end_ms": 236785,
      "text": "但这一座金塔承载的是帝王对母亲的思念，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 237570,
      "end_ms": 240690,
      "text": "真正珍贵的从不是黄金珠宝，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 241050,
      "end_ms": 243135,
      "text": "而是这份人间亲情。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 244160,
      "end_ms": 247065,
      "text": "第六件乾隆田黄三联印，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 247460,
      "end_ms": 248845,
      "text": "命运最为跌宕，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 249740,
      "end_ms": 251460,
      "text": "自古便有一两田黄。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 251520,
      "end_ms": 252755,
      "text": "十、两斤的说法，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 253310,
      "end_ms": 256410,
      "text": "整块名贵田黄石不拆分做印章，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 256690,
      "end_ms": 257950,
      "text": "而是一体漏雕，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 258350,
      "end_ms": 259730,
      "text": "做出三方印章，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 259890,
      "end_ms": 261535,
      "text": "还保留相连的石链，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 261880,
      "end_ms": 262840,
      "text": "环环相扣，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 262980,
      "end_ms": 264325,
      "text": "没有一丝拼接，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 264930,
      "end_ms": 265735,
      "text": "稍有不慎，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 265980,
      "end_ms": 268675,
      "text": "整块西式石料便彻底损毁。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 269500,
      "end_ms": 270380,
      "text": "一九二四年，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 270400,
      "end_ms": 271840,
      "text": "溥仪被赶出紫禁城，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 272260,
      "end_ms": 274005,
      "text": "无数珍宝来不及带走，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 274250,
      "end_ms": 275675,
      "text": "唯独这枚三联印，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 275950,
      "end_ms": 278835,
      "text": "被他缝进棉衣夹层贴身保管，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 279670,
      "end_ms": 281485,
      "text": "辗转天津东北，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 281830,
      "end_ms": 284165,
      "text": "哪怕深陷抚顺战犯管理所。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 284570,
      "end_ms": 286825,
      "text": "这枚印章一直贴身携带。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 287090,
      "end_ms": 288425,
      "text": "整整二十六年，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 288960,
      "end_ms": 290200,
      "text": "直到一九五零年，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 290380,
      "end_ms": 296285,
      "text": "溥仪才将这件国宝上交国家末代皇帝弄丢了万里江山。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 296710,
      "end_ms": 299950,
      "text": "却拼尽全力保住这件绝世国宝。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 300470,
      "end_ms": 301750,
      "text": "以上五件国宝，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 301930,
      "end_ms": 303670,
      "text": "每一件都写满传奇，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 304710,
      "end_ms": 306770,
      "text": "象牙席一道圣旨，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 306810,
      "end_ms": 308030,
      "text": "断绝一门绝技。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 308410,
      "end_ms": 311690,
      "text": "天球仪把漫天星辰收进金球，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 312230,
      "end_ms": 314850,
      "text": "慈母集万千瓷艺于一身，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 315350,
      "end_ms": 317850,
      "text": "金发塔藏着帝王的孝心。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 318410,
      "end_ms": 319410,
      "text": "田皇三联映，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 319630,
      "end_ms": 320470,
      "text": "历经战火，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 320630,
      "end_ms": 322450,
      "text": "被贴身守护二十六年。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 323270,
      "end_ms": 325330,
      "text": "而故宫国宝榜单前五，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 325710,
      "end_ms": 327220,
      "text": "同样各格个震撼，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 327740,
      "end_ms": 330200,
      "text": "有的是耗费重金从海外购回。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 330580,
      "end_ms": 331400,
      "text": "归来之时，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 331580,
      "end_ms": 333080,
      "text": "器物满身残破，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 333620,
      "end_ms": 334920,
      "text": "有的存世稀少，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 335180,
      "end_ms": 338280,
      "text": "国内大半馆藏都藏在北京故宫，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 338960,
      "end_ms": 340620,
      "text": "还有一件重达数吨，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 340920,
      "end_ms": 342340,
      "text": "从新疆一路跋涉，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 342400,
      "end_ms": 344260,
      "text": "三年才运抵京城。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 345100,
      "end_ms": 346120,
      "text": "至于那一件，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 346620,
      "end_ms": 349340,
      "text": "历经五次琉璃四次流出宫外，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 349700,
      "end_ms": 354980,
      "text": "最终于一堆尾作古画中重见天日的国宝究竟是什么？"
    },
    {
      "segment_id": "s000134",
      "start_ms": 355840,
      "end_ms": 358315,
      "text": "最迎在评论区聊聊你的猜想。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 359110,
      "end_ms": 364945,
      "text": "下一期我们接着盘点故宫五大国宝揭晓这件传奇文物的故事。"
    }
  ],
  "source_transcript_sha256": "9a17888fc1e615aa3777dd5dbc03ecae82e9c5af47fee517486d07121487049e"
}