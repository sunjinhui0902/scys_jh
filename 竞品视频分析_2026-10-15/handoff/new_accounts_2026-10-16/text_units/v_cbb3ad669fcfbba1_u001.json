{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_cbb3ad669fcfbba1_u001",
  "video_id": "v_cbb3ad669fcfbba1",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 742.296961,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 2730,
      "text": "你去博物馆的时候有没有过这种经历？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3270,
      "end_ms": 5430,
      "text": "你本来是去接受文化熏陶的，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5970,
      "end_ms": 7210,
      "text": "结果逛着逛着，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 8029,
      "end_ms": 9730,
      "text": "突然被一件文物逗笑，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 11070,
      "end_ms": 12190,
      "text": "你站在他面前，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12710,
      "end_ms": 15770,
      "text": "忍不住想掏出手机拍下来发给朋友。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16370,
      "end_ms": 17870,
      "text": "他们不是镇馆之宝，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17990,
      "end_ms": 19050,
      "text": "不是最贵的，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 19130,
      "end_ms": 20430,
      "text": "不是最古老的，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 21090,
      "end_ms": 23190,
      "text": "但他们有一个共同的名字，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23210,
      "end_ms": 23850,
      "text": "显眼包。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 24270,
      "end_ms": 26130,
      "text": "央视纪录片馆藏显眼包，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 26130,
      "end_ms": 28170,
      "text": "专门为他们拍了一整季。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 28170,
      "end_ms": 31960,
      "text": "聚焦各大文博物馆中形态生动，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 32060,
      "end_ms": 33340,
      "text": "富有喜感的文物，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 33640,
      "end_ms": 37340,
      "text": "用简短明快的解说讲述他们的前世今生。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 38080,
      "end_ms": 41540,
      "text": "今天咱们就来盘点中国十大博物馆里的显眼包。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 42540,
      "end_ms": 45120,
      "text": "上集先看五件表情管理失败了。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 45380,
      "end_ms": 49680,
      "text": "第一件山东博物馆雅丑乐，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 50520,
      "end_ms": 51460,
      "text": "你去看他的脸。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 52660,
      "end_ms": 55540,
      "text": "方脸圆睁的双目，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 56620,
      "end_ms": 57520,
      "text": "嘴角上扬，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 58380,
      "end_ms": 60010,
      "text": "翻出两排整整齐齐。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 60070,
      "end_ms": 61455,
      "text": "鸡的牙齿不是普通的牙，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 62510,
      "end_ms": 64625,
      "text": "是城墙垛口一样的形状。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 65070,
      "end_ms": 68005,
      "text": "他在笑笑的非常生动，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 68730,
      "end_ms": 70575,
      "text": "但你别被这张脸骗了，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 70740,
      "end_ms": 71515,
      "text": "他是一把鱼。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 72040,
      "end_ms": 74075,
      "text": "越是什么在殷商时代，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 74370,
      "end_ms": 76415,
      "text": "越是战场上的杀伐利器，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 76990,
      "end_ms": 79585,
      "text": "也是王权与君权的至高象征。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 80080,
      "end_ms": 84585,
      "text": "甲骨文里的王字就是府乐的象形尚书。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 84990,
      "end_ms": 85230,
      "text": "墓。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 85290,
      "end_ms": 85995,
      "text": "事记载，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 86670,
      "end_ms": 89390,
      "text": "周王左杖黄越右柄，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 89510,
      "end_ms": 93695,
      "text": "白火以辉以月号令诸侯决胜牧野。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 94470,
      "end_ms": 95490,
      "text": "三千多年前，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 95770,
      "end_ms": 97010,
      "text": "谁手里握着月，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 97190,
      "end_ms": 98335,
      "text": "谁就握着天下。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 98850,
      "end_ms": 99750,
      "text": "一九六五年，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 99970,
      "end_ms": 104095,
      "text": "考古学者在青州苏布屯发现了一座商代大墓，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 104690,
      "end_ms": 116585,
      "text": "是迄今为止除安阳阴墟以外规模最大、规格最高的商代墓葬亚丑月出土于一号墓牧师北壁靠近北墓道口的田土中，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 117200,
      "end_ms": 118865,
      "text": "通常三十二点七厘米，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 119320,
      "end_ms": 119560,
      "text": "刃，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 119620,
      "end_ms": 121385,
      "text": "宽三十四点五厘米，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 121770,
      "end_ms": 123915,
      "text": "肩宽二十三点三厘米，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 124300,
      "end_ms": 127315,
      "text": "两侧对称飞棱线条刚毅，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 127890,
      "end_ms": 130750,
      "text": "在人面门口部两侧刻着雅行。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 130770,
      "end_ms": 133355,
      "text": "外框和丑字组成的铭文。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 134150,
      "end_ms": 135525,
      "text": "学界普遍认为，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 135960,
      "end_ms": 138120,
      "text": "亚子情况代表特殊身份，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 138120,
      "end_ms": 140770,
      "text": "地位很可能是武官的身份。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 140770,
      "end_ms": 145990,
      "text": "灰烬丑则是商代东方某个方国或显赫家族的祖号。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 146150,
      "end_ms": 153985,
      "text": "这方铭文为宋代以来备受关注的亚丑青铜器群提供了明确的出土地点，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 154730,
      "end_ms": 160835,
      "text": "证实了青州一带是商代亚丑族群的核心活动区。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 161470,
      "end_ms": 162830,
      "text": "你站在他面前，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 162970,
      "end_ms": 165935,
      "text": "看着那张凝丽中透着天真的笑脸，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 166350,
      "end_ms": 171320,
      "text": "会忍不住想三千年前的人铸造这把月的时候，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 171500,
      "end_ms": 172615,
      "text": "心里在想什么？"
    },
    {
      "segment_id": "s000060",
      "start_ms": 173920,
      "end_ms": 174565,
      "text": "是敬畏，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 175090,
      "end_ms": 180295,
      "text": "还是也感受到了他传递出的那种属于远古的原始的力量。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 181310,
      "end_ms": 185800,
      "text": "第二件甘肃省博物馆红奔马，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 185920,
      "end_ms": 188435,
      "text": "你从小就在旅游标志上见过他。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 189060,
      "end_ms": 191260,
      "text": "侧面看一匹骏马，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 191260,
      "end_ms": 194455,
      "text": "三足腾空彝足踏在飞鸟背上，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 194780,
      "end_ms": 195800,
      "text": "昂首嘶鸣，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 196080,
      "end_ms": 197105,
      "text": "气势磅礴。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 198000,
      "end_ms": 201724,
      "text": "一九六九年出土于甘肃武威擂台汉墓，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 202040,
      "end_ms": 204085,
      "text": "马高三十四点五厘米，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 204690,
      "end_ms": 206325,
      "text": "长四十四点五厘米，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 206900,
      "end_ms": 208555,
      "text": "重七点一五千克。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 209380,
      "end_ms": 210225,
      "text": "一九八三年，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 211100,
      "end_ms": 214375,
      "text": "同奔马形象被确定为中国旅游标志。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 215250,
      "end_ms": 218335,
      "text": "但是你绕到正面看一下，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 218790,
      "end_ms": 220365,
      "text": "参观者绕到正面，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 220850,
      "end_ms": 223170,
      "text": "便会看到一个意想不到的画面。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 223190,
      "end_ms": 224470,
      "text": "骏马歪着脑袋，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 224470,
      "end_ms": 225975,
      "text": "嘴巴撇向一侧，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 226750,
      "end_ms": 229815,
      "text": "袁征的双眼透出几分天然的呆萌，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 230830,
      "end_ms": 234875,
      "text": "正面的憨态与侧面的英姿判若两木。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 235840,
      "end_ms": 236360,
      "text": "网友说，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 236360,
      "end_ms": 237815,
      "text": "他如果不是来搞笑的，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 238100,
      "end_ms": 241200,
      "text": "那就一定是内心住着一个顽皮的小孩。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 241880,
      "end_ms": 245915,
      "text": "甘肃省博物馆把它的正面照做成了绿马玩偶，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 246250,
      "end_ms": 248385,
      "text": "在文创展厅里很受欢迎，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 248810,
      "end_ms": 253455,
      "text": "但同奔马真正的厉害之处藏在他的力学设计里。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 254020,
      "end_ms": 257465,
      "text": "马身着了一点集中于超聂飞鸟的一族之上，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 258260,
      "end_ms": 262200,
      "text": "飞鸟的躯体以及展开的双翅扩大了着地面积，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 262220,
      "end_ms": 263275,
      "text": "稳定了重心，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 263740,
      "end_ms": 267165,
      "text": "其造型完全符合现代力学的平衡原理。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 268000,
      "end_ms": 269680,
      "text": "经过科学仪器检测，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 270220,
      "end_ms": 275600,
      "text": "铸造工艺为陶犯铸造铸接法工匠先驻马身，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 275820,
      "end_ms": 280845,
      "text": "再与马尾马腿提下飞鸟等部件分别组合。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 281310,
      "end_ms": 281750,
      "text": "同时，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 282010,
      "end_ms": 285710,
      "text": "在马腿内夹入专门制作的铁心骨之后，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 285930,
      "end_ms": 288495,
      "text": "浇铸铜业铸成铁骨铜腿。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 289840,
      "end_ms": 293575,
      "text": "两千年前的工匠用逃饭和铁心，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 294040,
      "end_ms": 296740,
      "text": "让一匹奔腾的马稳稳站立了。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 296740,
      "end_ms": 298620,
      "text": "两千年至今，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 298620,
      "end_ms": 301440,
      "text": "其右前蹄底还可见残留的锈蚀。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 301440,
      "end_ms": 301840,
      "text": "铁鞋，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 302000,
      "end_ms": 303465,
      "text": "你站在他正面。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 304180,
      "end_ms": 306500,
      "text": "看着他歪头咧嘴的样子，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 307280,
      "end_ms": 311120,
      "text": "会想起生活中那些明明很严肃的场合，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 311120,
      "end_ms": 313320,
      "text": "表情却不受控制的瞬间。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 314940,
      "end_ms": 319300,
      "text": "两千年前的工匠把这种真实感凝固了下来。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 320740,
      "end_ms": 321400,
      "text": "第三件，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 322520,
      "end_ms": 326600,
      "text": "河南博物院绿釉立兹陶狗。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 327260,
      "end_ms": 331880,
      "text": "它的原型是中华田园犬双耳前顷，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 333420,
      "end_ms": 334375,
      "text": "双目元征，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 336410,
      "end_ms": 337610,
      "text": "颈下系着铃铛，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 338070,
      "end_ms": 339530,
      "text": "四肢矫健有力，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 339830,
      "end_ms": 343850,
      "text": "背上甚至贴心的设计了便于抓握的拱形扉。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 344470,
      "end_ms": 348330,
      "text": "一九七七年出土于河南周口项城蛤蟆寨汉墓群，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 348470,
      "end_ms": 350370,
      "text": "高三十二点五厘米，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 350610,
      "end_ms": 351850,
      "text": "长二十八厘米，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 352010,
      "end_ms": 353110,
      "text": "宽十六厘米，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 353390,
      "end_ms": 354550,
      "text": "通体石绿釉，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 354810,
      "end_ms": 355990,
      "text": "现藏河南博物院。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 356550,
      "end_ms": 360770,
      "text": "东汉工匠显然是照着身边那只活生生的大黄捏的，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 361170,
      "end_ms": 365265,
      "text": "连尾巴卷曲的弧度都拿捏的恰到好处。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 365950,
      "end_ms": 369575,
      "text": "他身上的绿釉以同为着色剂烧成，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 369970,
      "end_ms": 371075,
      "text": "用今天的话说，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 371570,
      "end_ms": 374255,
      "text": "古人给他染了一身纯天然绿毛，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 374770,
      "end_ms": 378605,
      "text": "可别小看这抹绿作为随葬名器，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 379410,
      "end_ms": 384400,
      "text": "绿柚荔枝、桃狗承载着古人视死如是生的生死观。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 384440,
      "end_ms": 386540,
      "text": "主人希望到了另一个世界，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 386840,
      "end_ms": 388220,
      "text": "那只看家护院，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 388320,
      "end_ms": 391405,
      "text": "朝夕相伴的忠犬依然守在身边。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 392160,
      "end_ms": 393060,
      "text": "正因如此，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 393400,
      "end_ms": 395480,
      "text": "他不卑不亢的保持着立姿，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 395480,
      "end_ms": 397825,
      "text": "像一个警惕又可靠的卫士，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 398380,
      "end_ms": 400985,
      "text": "目光跨越千年依然坚定。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 401460,
      "end_ms": 406515,
      "text": "但很多观众看到他的第一反应是和我家旺财一模一样。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 407240,
      "end_ms": 408875,
      "text": "他被做成了毛绒玩具，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 409170,
      "end_ms": 409925,
      "text": "很受欢迎。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 410910,
      "end_ms": 413765,
      "text": "河南博物院管他叫汉代旺财，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 414180,
      "end_ms": 416605,
      "text": "你看着他那双圆睁的眼睛，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 417260,
      "end_ms": 420020,
      "text": "会觉得他下一秒就要冲你摇尾巴。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 420100,
      "end_ms": 420795,
      "text": "第四件，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 421210,
      "end_ms": 423915,
      "text": "中国国家博物馆击鼓说唱咏，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 424740,
      "end_ms": 425685,
      "text": "你看他的样子。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 426070,
      "end_ms": 427790,
      "text": "咧嘴嬉笑塌腰，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 427790,
      "end_ms": 428285,
      "text": "扭胯，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 428690,
      "end_ms": 429665,
      "text": "左臂环抱，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 429960,
      "end_ms": 430895,
      "text": "一面贬鼓，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 431290,
      "end_ms": 432905,
      "text": "右手举着鼓槌，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 433280,
      "end_ms": 434295,
      "text": "一只脚还翘着。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 434750,
      "end_ms": 437175,
      "text": "这是一个正在表演的瞬间。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 438150,
      "end_ms": 440995,
      "text": "东汉文物高五十六厘米，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 441720,
      "end_ms": 444200,
      "text": "一九五七年出土于四川成都，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 444220,
      "end_ms": 447655,
      "text": "天回山献葬中国国家博物馆。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 448460,
      "end_ms": 450095,
      "text": "他叫改为其忧。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 450670,
      "end_ms": 452945,
      "text": "还有在春秋战国时期已经出现，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 453380,
      "end_ms": 457640,
      "text": "他们侍奉君主以逗笑的方式为君主排遣无聊。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 457780,
      "end_ms": 458965,
      "text": "在宫廷宴会上，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 459410,
      "end_ms": 459850,
      "text": "筛优，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 460010,
      "end_ms": 461255,
      "text": "往往是灵魂人物，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 461570,
      "end_ms": 464025,
      "text": "以幽默的话语、滑稽的表演，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 464250,
      "end_ms": 465635,
      "text": "我的宾客的欢笑，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 466270,
      "end_ms": 467190,
      "text": "有些GDU,"
    },
    {
      "segment_id": "s000162",
      "start_ms": 467370,
      "end_ms": 469130,
      "text": "也利用他们的特殊身份，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 469270,
      "end_ms": 470935,
      "text": "依靠口舌之力。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 471460,
      "end_ms": 474090,
      "text": "正话反说反话，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 474090,
      "end_ms": 477565,
      "text": "正说在取悦君主的同时，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 478210,
      "end_ms": 481285,
      "text": "也对君主一些错误的想法进行封建。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 482260,
      "end_ms": 485745,
      "text": "秦始皇时期有一个著名的改西攸叫幽。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 486800,
      "end_ms": 489970,
      "text": "秦始皇曾计划大兴怨忧幽枕，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 489970,
      "end_ms": 490310,
      "text": "便说，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 490310,
      "end_ms": 491665,
      "text": "皇上的想法很好，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 492070,
      "end_ms": 494675,
      "text": "原有修好后放进许多禽兽，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 495120,
      "end_ms": 497560,
      "text": "敌人从东方进攻放出麋鹿，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 497560,
      "end_ms": 499285,
      "text": "用脚就能把他们顶回去。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 499770,
      "end_ms": 501585,
      "text": "秦始皇听了就打消了念头。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 502270,
      "end_ms": 503205,
      "text": "到了汉代，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 503980,
      "end_ms": 508715,
      "text": "担忧大致以调学滑稽、讽刺的表演为主，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 509020,
      "end_ms": 513275,
      "text": "皇室贵族豪富大力蓄养师忧之风甚盛。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 513960,
      "end_ms": 515920,
      "text": "汉武帝蚩尤诛儒之孝，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 516720,
      "end_ms": 521765,
      "text": "不乏于前丞相田庚爱唱优巧匠之术。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 522570,
      "end_ms": 525995,
      "text": "东汉工匠把一个人逗笑全场的瞬间，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 526530,
      "end_ms": 528595,
      "text": "用陶土凝固了下来。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 529270,
      "end_ms": 530485,
      "text": "你站在他面前，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 530830,
      "end_ms": 535330,
      "text": "会忍不住想两千年前他逗笑过多少人，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 535390,
      "end_ms": 538515,
      "text": "那些人笑的时候是什么样子？"
    },
    {
      "segment_id": "s000185",
      "start_ms": 539280,
      "end_ms": 544665,
      "text": "第五件三星堆博物馆青铜粽木面具，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 544980,
      "end_ms": 546455,
      "text": "他的眼睛是凸出来的，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 547410,
      "end_ms": 550125,
      "text": "突出多少十六厘米，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 551310,
      "end_ms": 555075,
      "text": "耳朵大的像翅膀向两侧展开六十八厘米。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 555890,
      "end_ms": 559515,
      "text": "一九八六年出土于三星堆遗址二号祭祀坑，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 560000,
      "end_ms": 561645,
      "text": "通高六十六厘米，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 561910,
      "end_ms": 563505,
      "text": "宽一百三十八厘米，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 564160,
      "end_ms": 568275,
      "text": "被誉为面具之王献葬三星堆博物馆。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 573980,
      "end_ms": 574500,
      "text": "网友说，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 574500,
      "end_ms": 575560,
      "text": "他眼球暴凸，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 575580,
      "end_ms": 579310,
      "text": "顺风耳是古蜀人眼里的外星偶像，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 579390,
      "end_ms": 583105,
      "text": "但CT断层扫描显示了一个令人震惊的事实。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 583510,
      "end_ms": 586195,
      "text": "他突出的眼球并非整体浇筑，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 586530,
      "end_ms": 590345,
      "text": "而是由十六组微型榫卯构件嵌套而成，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 590970,
      "end_ms": 593295,
      "text": "瞳孔处是有放射状太阳纹。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 593830,
      "end_ms": 599150,
      "text": "三千多年前的古蜀人用分体铸造和榫卯嵌套的工艺，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 599310,
      "end_ms": 602555,
      "text": "做出了一个眼睛能伸出十六厘米的面具。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 603340,
      "end_ms": 607675,
      "text": "面具的造型特征与华阳国志记载的蚕虫纵目传说吻合，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 608190,
      "end_ms": 613455,
      "text": "学界推测他可能是第一代蜀王禅从的神像突出的双眼。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 613850,
      "end_ms": 615310,
      "text": "是对太阳的崇拜。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 616230,
      "end_ms": 617230,
      "text": "古蜀人认为，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 617610,
      "end_ms": 620110,
      "text": "看得远的人离神更近，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 620890,
      "end_ms": 626330,
      "text": "他们把对神明的想象铸成了一副凡人无法拥有的面孔。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 626750,
      "end_ms": 628910,
      "text": "三星堆文明本身就是一个谜，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 629610,
      "end_ms": 631710,
      "text": "它和中原文明同时存在，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 632010,
      "end_ms": 633570,
      "text": "但风格完全不同，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 634230,
      "end_ms": 640750,
      "text": "它和青铜面具、青铜神树黄金权杖都带着一种不属于中原的美。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 641110,
      "end_ms": 643465,
      "text": "它证明了一件事儿中，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 643660,
      "end_ms": 645560,
      "text": "中华文明不是一条河，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 646180,
      "end_ms": 647060,
      "text": "是一片海。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 648340,
      "end_ms": 649940,
      "text": "你站在他面前，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 650220,
      "end_ms": 652500,
      "text": "仰头看那双突出的眼睛，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 652980,
      "end_ms": 656340,
      "text": "会觉得他真的在看着很远很远的地方。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 657260,
      "end_ms": 658020,
      "text": "说到这儿，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 658300,
      "end_ms": 659380,
      "text": "我想停一下，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 661160,
      "end_ms": 662500,
      "text": "你有没有发现一件事，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 663800,
      "end_ms": 669440,
      "text": "这五件显眼包没有一件是随便长压丑越的笑脸，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 669740,
      "end_ms": 673215,
      "text": "是权力与威严的另一种表达。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 674220,
      "end_ms": 676265,
      "text": "同奔马正面的憨态，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 676630,
      "end_ms": 680405,
      "text": "是汉代工匠对力学和动态的极致掌控。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 680950,
      "end_ms": 682525,
      "text": "绿柚讨狗的认真，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 682880,
      "end_ms": 685555,
      "text": "是东汉人对陪伴的理解。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 686500,
      "end_ms": 688200,
      "text": "击鼓说唱咏的夸张，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 688260,
      "end_ms": 691335,
      "text": "是两千年前中国喜剧的起点。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 692260,
      "end_ms": 694025,
      "text": "重木面具的怪异，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 694490,
      "end_ms": 697145,
      "text": "是古蜀人对太阳的崇拜，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 697800,
      "end_ms": 700055,
      "text": "古人比我们想象的有趣的多。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 700540,
      "end_ms": 703195,
      "text": "他们不是只会板着脸做李器，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 703800,
      "end_ms": 705625,
      "text": "他们会笑、会玩儿，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 705920,
      "end_ms": 708145,
      "text": "会把生活里最生动的瞬间，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 708600,
      "end_ms": 709360,
      "text": "用青铜，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 709640,
      "end_ms": 712505,
      "text": "用陶土用玉凝固下来，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 713200,
      "end_ms": 715590,
      "text": "留给我们下集。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 715810,
      "end_ms": 718415,
      "text": "咱们来看另外五件显眼包，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 718850,
      "end_ms": 719995,
      "text": "他们不靠表情，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 720420,
      "end_ms": 721205,
      "text": "靠造型，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 721990,
      "end_ms": 723675,
      "text": "有一件长得像路游器，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 724270,
      "end_ms": 727030,
      "text": "有一件向开会时集体罚站的姿势，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 727190,
      "end_ms": 728685,
      "text": "还有一件圆滚滚的，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 729650,
      "end_ms": 730725,
      "text": "你猜他是什么？"
    },
    {
      "segment_id": "s000245",
      "start_ms": 731610,
      "end_ms": 733785,
      "text": "下一集已经同步更新，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 734550,
      "end_ms": 735670,
      "text": "点开我的头像，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 735690,
      "end_ms": 736455,
      "text": "进入主页，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 737340,
      "end_ms": 739295,
      "text": "第一条视频就是下一集，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 740220,
      "end_ms": 742195,
      "text": "感兴趣的朋友可以关注后续。"
    }
  ],
