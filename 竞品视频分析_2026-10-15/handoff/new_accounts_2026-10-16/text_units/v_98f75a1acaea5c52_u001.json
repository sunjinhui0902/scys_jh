{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_98f75a1acaea5c52_u001",
  "video_id": "v_98f75a1acaea5c52",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 823.125011,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 290,
      "end_ms": 6570,
      "text": "十四分钟讲解奥地利学派经济学简史有一本书出版后被主流经济学界集体沉默。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 6590,
      "end_ms": 11410,
      "text": "以对作者本人在美国二十四年没有一所大学愿意付他一分钱薪水。"
    },
    {
      "segment_id": "s000003",
      "start_ms": 11570,
      "end_ms": 14590,
      "text": "他的学说被凯恩斯主义的光环彻底碾碎。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 14910,
      "end_ms": 19310,
      "text": "被贴上过时偏执意识形态的标签扔进学术边缘。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 19670,
      "end_ms": 22310,
      "text": "可就在二零零八年全球金融危机爆发后，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 22590,
      "end_ms": 25050,
      "text": "这本书被无数人从固纸堆里翻出来。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 25110,
      "end_ms": 26190,
      "text": "人们惊恐的发现，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 26430,
      "end_ms": 30780,
      "text": "里面写的每一个字都在几十年前精准预告了这场灾难。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 30980,
      "end_ms": 33640,
      "text": "这本书叫奥地利学派经济学简史。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 33800,
      "end_ms": 35340,
      "text": "米塞斯的视角作者，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 35340,
      "end_ms": 39560,
      "text": "路德维西冯米塞斯一八八一年出生在奥匈帝国的莱姆堡，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 39820,
      "end_ms": 41540,
      "text": "也就是今天的乌克兰利沃夫。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 41880,
      "end_ms": 43760,
      "text": "一九零零年进入维也纳大学，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 44020,
      "end_ms": 47160,
      "text": "师从奥地利学派创始人卡尔蒙戈尔的思想传统，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 47560,
      "end_ms": 50340,
      "text": "一九零六年获法学与经济学博士学位。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 50740,
      "end_ms": 52900,
      "text": "他后来被誉为奥地利学派的院长，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 53460,
      "end_ms": 55900,
      "text": "但他的学术生涯却是一部被排斥，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 56060,
      "end_ms": 56740,
      "text": "被忽视，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 56900,
      "end_ms": 57940,
      "text": "被遗忘的历史。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 58280,
      "end_ms": 60290,
      "text": "一九四零年为朵蜜娜粹，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 60290,
      "end_ms": 61155,
      "text": "他移民美国。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 61520,
      "end_ms": 62880,
      "text": "从一九四五年开始，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 62920,
      "end_ms": 64760,
      "text": "在纽约大学担任客座教授，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 64840,
      "end_ms": 66385,
      "text": "直到一九六九年退休。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 66830,
      "end_ms": 68150,
      "text": "整整二十四年，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 68290,
      "end_ms": 70595,
      "text": "纽约大学没有付给他一分钱薪水，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 70900,
      "end_ms": 73320,
      "text": "他的生计全靠赏识他的商人资助。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 73520,
      "end_ms": 74620,
      "text": "他没有终身教职，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 74860,
      "end_ms": 76000,
      "text": "没有体面的待遇，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 76160,
      "end_ms": 77715,
      "text": "没有主流学界的承认，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 78240,
      "end_ms": 79505,
      "text": "但他交出了哈耶克。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 79840,
      "end_ms": 80660,
      "text": "一九七四年，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 80660,
      "end_ms": 86425,
      "text": "诺贝尔经济学奖得主以及罗斯巴德、科兹纳等一整代改变经济学地图的人，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 86610,
      "end_ms": 90535,
      "text": "而他自己的理论被主流经济学界无视了整整半个世纪。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 91010,
      "end_ms": 93895,
      "text": "这本书的遭遇比曼昆那本更具戏剧性，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 94230,
      "end_ms": 96030,
      "text": "曼昆至少赚了钱出了名，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 96270,
      "end_ms": 97745,
      "text": "被六千所大学使用。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 98100,
      "end_ms": 99105,
      "text": "米赛斯的书呢，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 99620,
      "end_ms": 104645,
      "text": "他的代表作人的行动被罗斯巴德称为文明人必读的经济学圣经。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 105040,
      "end_ms": 106575,
      "text": "但在主流经济系的课堂上，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 106810,
      "end_ms": 108345,
      "text": "你几乎听不到这个名字，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 109020,
      "end_ms": 110065,
      "text": "不是因为他不好，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 110470,
      "end_ms": 111895,
      "text": "而是因为他太危险。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 112610,
      "end_ms": 113270,
      "text": "危险到会，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 113270,
      "end_ms": 116715,
      "text": "让你过去二三十年对经济这两个字的全部理解，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 116990,
      "end_ms": 118315,
      "text": "发生结构性坍塌。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 118820,
      "end_ms": 122925,
      "text": "今天这篇文字我会拆出这本书里最颠覆的五个底层认知。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 123550,
      "end_ms": 124290,
      "text": "但我提前警告，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 124290,
      "end_ms": 125560,
      "text": "你看完后，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 125700,
      "end_ms": 126580,
      "text": "你可能会推翻。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 126580,
      "end_ms": 126980,
      "text": "过去。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 127000,
      "end_ms": 128340,
      "text": "二十年、三十年，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 128360,
      "end_ms": 132025,
      "text": "对市场中心化力量繁荣的全部信条。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 132780,
      "end_ms": 134020,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 134180,
      "end_ms": 135295,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 135780,
      "end_ms": 136815,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 137200,
      "end_ms": 138405,
      "text": "那我们开始进入正题。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 138940,
      "end_ms": 139815,
      "text": "第一层颠覆，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 140300,
      "end_ms": 142160,
      "text": "你以为经济是数字和模型，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 142540,
      "end_ms": 144660,
      "text": "其实它是一个活的过程。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 144660,
      "end_ms": 146405,
      "text": "你学过的经济学是什么样子的？"
    },
    {
      "segment_id": "s000062",
      "start_ms": 147110,
      "end_ms": 149210,
      "text": "供给曲线需求曲线均衡，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 149210,
      "end_ms": 150455,
      "text": "价格GDP公式，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 150790,
      "end_ms": 153210,
      "text": "一整套精密的像物理学的数学模型，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 153490,
      "end_ms": 155525,
      "text": "把人的行为塞进坐标系里，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 155760,
      "end_ms": 157645,
      "text": "用方程式推导出最优解。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 158110,
      "end_ms": 160975,
      "text": "米塞斯在书里用一句话砸碎了这套幻觉。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 161320,
      "end_ms": 164275,
      "text": "他说市场不是一个均衡状态，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 164600,
      "end_ms": 165420,
      "text": "是一个过程，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 165540,
      "end_ms": 166125,
      "text": "什么意思？"
    },
    {
      "segment_id": "s000071",
      "start_ms": 166370,
      "end_ms": 167475,
      "text": "你打开手机点外卖，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 167700,
      "end_ms": 169825,
      "text": "你觉得价格是平台算出来的？"
    },
    {
      "segment_id": "s000073",
      "start_ms": 170070,
      "end_ms": 170590,
      "text": "米塞斯说，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 170590,
      "end_ms": 171670,
      "text": "不是价格，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 171930,
      "end_ms": 173750,
      "text": "是无数个像你一样的人，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 173950,
      "end_ms": 175710,
      "text": "在无数个具体场景里，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 175870,
      "end_ms": 179405,
      "text": "用自己的判断和行动一点一点碰出来的。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 179620,
      "end_ms": 181740,
      "text": "没有任何一个人、任何一个算法，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 181900,
      "end_ms": 184755,
      "text": "任何一个政府机构能够知道所有这些信息。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 185090,
      "end_ms": 189375,
      "text": "经济学家哈耶克后来把这个洞见发展成他著名的知识分散论。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 189780,
      "end_ms": 191495,
      "text": "关于资源配置的全部信息，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 191780,
      "end_ms": 195145,
      "text": "从来不是集中存在于任何一个人或机构手里的。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 195520,
      "end_ms": 197620,
      "text": "他分散在千百万人的头脑中，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 198100,
      "end_ms": 201625,
      "text": "只有市场价格机制才能把这些分散的信息协调起来。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 202220,
      "end_ms": 205105,
      "text": "这就是奥地利学派经济学最根本的颠覆。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 205650,
      "end_ms": 210075,
      "text": "经济活动不是一堆可以被规划、被计算、被调控的数字。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 210480,
      "end_ms": 212935,
      "text": "他是活生生的、不可预测的，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 213190,
      "end_ms": 216190,
      "text": "由无数个体的选择构成的动态过程。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 216530,
      "end_ms": 218875,
      "text": "而米赛斯在书里用了一个更狠的说法。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 219240,
      "end_ms": 219725,
      "text": "他说，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 220140,
      "end_ms": 226925,
      "text": "试图用中央计划取代市场过程不是效率高低的问题是逻辑上就不可能的问题，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 227290,
      "end_ms": 231615,
      "text": "因为计划者根本无法获得做出正确决策所需要的全部信息。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 232400,
      "end_ms": 237725,
      "text": "这就是一九二零年他发表的社会主义国家中的经济计算一文所提出的核心论点，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 238070,
      "end_ms": 241775,
      "text": "由此引发了与兰格等社会主义经济学家的著名大论战。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 242060,
      "end_ms": 242795,
      "text": "你可能会想，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 243240,
      "end_ms": 244365,
      "text": "这跟我有什么关系？"
    },
    {
      "segment_id": "s000097",
      "start_ms": 244870,
      "end_ms": 245565,
      "text": "关系大了。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 246260,
      "end_ms": 247300,
      "text": "下次有人告诉你，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 247300,
      "end_ms": 248540,
      "text": "专家已经算好了，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 248640,
      "end_ms": 249895,
      "text": "上面已经规划好了。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 250080,
      "end_ms": 251335,
      "text": "你应该问自己一个问题，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 251680,
      "end_ms": 258200,
      "text": "这些专家和规划者真的可能掌握所有人所有场景、所有时刻的真实信息吗？"
    },
    {
      "segment_id": "s000103",
      "start_ms": 258280,
      "end_ms": 258760,
      "text": "第二层，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 258760,
      "end_ms": 261660,
      "text": "颠覆繁荣不是被创造的，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 261740,
      "end_ms": 263620,
      "text": "是被信号引导出来的。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 263640,
      "end_ms": 265560,
      "text": "我们这代人从小被灌输一种观念，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 265800,
      "end_ms": 267205,
      "text": "经济需要管理，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 267690,
      "end_ms": 268450,
      "text": "经济不好了，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 268470,
      "end_ms": 270180,
      "text": "要刺激经济过热了，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 270180,
      "end_ms": 270795,
      "text": "要降温。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 271280,
      "end_ms": 273420,
      "text": "中心化调控者像司机经济，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 273420,
      "end_ms": 275140,
      "text": "像汽车油门刹车，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 275180,
      "end_ms": 276730,
      "text": "随时踩米塞斯，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 276730,
      "end_ms": 279170,
      "text": "用一本书证明的不是中心化力量，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 279170,
      "end_ms": 280230,
      "text": "该不该管经济，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 280470,
      "end_ms": 281890,
      "text": "而是中心化调控者，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 281990,
      "end_ms": 285255,
      "text": "根本不知道自己踩下油门之后会发生什么。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 285620,
      "end_ms": 288520,
      "text": "他在一九一二年的著作货币与信用理论中，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 288540,
      "end_ms": 291355,
      "text": "提出了一个让所有人背脊发凉的理论。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 291850,
      "end_ms": 293455,
      "text": "后来被哈杰克发展完善，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 293760,
      "end_ms": 296915,
      "text": "被称为米塞斯哈耶克商业周期理论。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 297330,
      "end_ms": 301960,
      "text": "这个理论的核心逻辑是这样的当中央银行人为的压低利率增加。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 301960,
      "end_ms": 302840,
      "text": "货币供给时，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 303020,
      "end_ms": 305080,
      "text": "企业家会误以为储蓄增加了，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 305160,
      "end_ms": 306065,
      "text": "资本充裕了，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 306360,
      "end_ms": 308215,
      "text": "于是大量投资长期项目。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 308570,
      "end_ms": 310850,
      "text": "建工厂搞研发、扩产能，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 311190,
      "end_ms": 312650,
      "text": "经济看起来一片繁荣。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 313010,
      "end_ms": 313730,
      "text": "但问题是，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 313970,
      "end_ms": 316610,
      "text": "这些投资的基础不是真实的储蓄，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 316830,
      "end_ms": 320010,
      "text": "而是被扭曲的利率信号当真相暴露，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 320290,
      "end_ms": 321030,
      "text": "利率回升，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 321250,
      "end_ms": 322050,
      "text": "货币收紧，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 322510,
      "end_ms": 325630,
      "text": "一些建立在虚假信号上的投资全部崩塌，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 326050,
      "end_ms": 327430,
      "text": "经济进入萧条。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 327870,
      "end_ms": 328690,
      "text": "一九二四年，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 328930,
      "end_ms": 332630,
      "text": "米塞斯就预言了奥地利最大银行信贷银行即将破产，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 332890,
      "end_ms": 335810,
      "text": "由此引发的世界性经济危机迫在眉睫。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 336290,
      "end_ms": 337070,
      "text": "一九二八年，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 337270,
      "end_ms": 338840,
      "text": "他在论文中公开警告，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 339020,
      "end_ms": 341100,
      "text": "经济危机迟早在所难免。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 341440,
      "end_ms": 342300,
      "text": "一九二九年初，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 342560,
      "end_ms": 345260,
      "text": "他的学生华耶克连续发表文章预测，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 345260,
      "end_ms": 346800,
      "text": "美国繁荣即将崩溃，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 347120,
      "end_ms": 348640,
      "text": "同年华尔街崩盘。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 348780,
      "end_ms": 353800,
      "text": "而当时的主流经济学家费雪在股灾前还在宣称经济将永续、繁荣，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 354200,
      "end_ms": 354800,
      "text": "崩盘后，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 354880,
      "end_ms": 356240,
      "text": "仍然建议投资股票。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 356300,
      "end_ms": 358460,
      "text": "你看最有趣的事情发生了，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 358820,
      "end_ms": 360560,
      "text": "说对了的人被无视了，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 360720,
      "end_ms": 362340,
      "text": "说错了的人成了主流。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 362820,
      "end_ms": 363740,
      "text": "米赛斯的理论。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 363740,
      "end_ms": 364560,
      "text": "之所以危险，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 364740,
      "end_ms": 367700,
      "text": "是因为他揭穿了一个所有政客都不愿承认的真相。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 367700,
      "end_ms": 369530,
      "text": "你想受的每一分繁荣，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 369810,
      "end_ms": 372545,
      "text": "可能只是被扭曲的信号催生的幻觉，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 372910,
      "end_ms": 376365,
      "text": "而每一次调控都在制造下一场崩盘的条件。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 376940,
      "end_ms": 379535,
      "text": "第三层颠覆你不是在做选择，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 379920,
      "end_ms": 381715,
      "text": "你是在不确定性中下注。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 382350,
      "end_ms": 386185,
      "text": "你可能觉得经济学是教你怎么做正确决策的。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 386970,
      "end_ms": 387965,
      "text": "米塞斯说不对，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 388430,
      "end_ms": 392085,
      "text": "经济学首先告诉你的是你永远不可能正确，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 392590,
      "end_ms": 395340,
      "text": "因为未来永远不确定人的行动。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 395340,
      "end_ms": 400145,
      "text": "开篇就提出了这个让所有信奉理性人假设的人目瞪口呆的命题。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 400600,
      "end_ms": 403725,
      "text": "人的行动本身就意味着未来是不确定的。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 404170,
      "end_ms": 405275,
      "text": "如果未来是确定的，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 405470,
      "end_ms": 406735,
      "text": "你就不需要行动了。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 407310,
      "end_ms": 410995,
      "text": "行动和不确定性是同一件事的两种说法。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 411190,
      "end_ms": 411725,
      "text": "什么意思？"
    },
    {
      "segment_id": "s000170",
      "start_ms": 412420,
      "end_ms": 414675,
      "text": "你以为你做决策是在理性计算？"
    },
    {
      "segment_id": "s000171",
      "start_ms": 415140,
      "end_ms": 415955,
      "text": "米赛斯说，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 416500,
      "end_ms": 417420,
      "text": "那只是幻觉。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 417500,
      "end_ms": 418180,
      "text": "你做决策，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 418340,
      "end_ms": 422430,
      "text": "本质上是在一个你不可能完全了解的世界里下了一个赌注。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 422450,
      "end_ms": 426910,
      "text": "那些做出正确预估的人是成功的行动人或成功的企业家。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 427230,
      "end_ms": 428630,
      "text": "而那些判断错误的人，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 428670,
      "end_ms": 429590,
      "text": "会承担损失，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 429810,
      "end_ms": 433045,
      "text": "这就是奥地利学派经济学的企业家精神概念。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 433560,
      "end_ms": 435025,
      "text": "企业家不是一种职业，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 435340,
      "end_ms": 436220,
      "text": "是一种状态，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 436360,
      "end_ms": 438240,
      "text": "任何在不确定性中做出判断，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 438260,
      "end_ms": 440140,
      "text": "采取行动的人都是企业家。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 440220,
      "end_ms": 440860,
      "text": "你换工作，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 441040,
      "end_ms": 441640,
      "text": "你创业，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 441700,
      "end_ms": 442240,
      "text": "你投资，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 442240,
      "end_ms": 442940,
      "text": "你选专业，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 443180,
      "end_ms": 444645,
      "text": "全都是企业家行为。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 445170,
      "end_ms": 446655,
      "text": "你没有最优解可以算，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 446980,
      "end_ms": 449040,
      "text": "你只有判断可以做比塞斯用。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 449040,
      "end_ms": 450405,
      "text": "一句话把这事儿说透了，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 450820,
      "end_ms": 452415,
      "text": "你在这个世界上赚不到钱，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 452670,
      "end_ms": 453010,
      "text": "做不对。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 453010,
      "end_ms": 455090,
      "text": "决策不是因为你不够聪明，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 455210,
      "end_ms": 458495,
      "text": "是因为你误以为有一个正确答案等着你去发现。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 458920,
      "end_ms": 459825,
      "text": "而真相是，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 460200,
      "end_ms": 461080,
      "text": "根本没有，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 461340,
      "end_ms": 465415,
      "text": "只有一个你永远无法完全预知的世界等着你去下注。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 465900,
      "end_ms": 466925,
      "text": "第四层颠覆。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 467540,
      "end_ms": 469075,
      "text": "你以为是在追求效率，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 469600,
      "end_ms": 474425,
      "text": "其实是在杀死发现我们这代人被训练成效率的信徒，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 475120,
      "end_ms": 476235,
      "text": "做任何事都要问，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 476610,
      "end_ms": 477765,
      "text": "最快的方法是什么？"
    },
    {
      "segment_id": "s000203",
      "start_ms": 478110,
      "end_ms": 479525,
      "text": "最省钱的方式是什么？"
    },
    {
      "segment_id": "s000204",
      "start_ms": 479830,
      "end_ms": 480950,
      "text": "有没有最优路径？"
    },
    {
      "segment_id": "s000205",
      "start_ms": 480970,
      "end_ms": 484575,
      "text": "奥地利学派经济学用一个概念砸碎了这套效率崇拜。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 485090,
      "end_ms": 485965,
      "text": "米赛斯说，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 486400,
      "end_ms": 488505,
      "text": "市场最大的价值不是效率，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 488810,
      "end_ms": 492890,
      "text": "是发现后来他的学生科兹娜把这个洞见发展成企业家，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 492890,
      "end_ms": 493590,
      "text": "发现理论。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 493590,
      "end_ms": 494775,
      "text": "市场过程的本质，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 495110,
      "end_ms": 498770,
      "text": "是企业家不断发现那些此前不为人知的利润机会。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 498770,
      "end_ms": 500665,
      "text": "你今天觉得理所当然的很多东西，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 501070,
      "end_ms": 504935,
      "text": "外卖、网约车、短视频在十年前根本不存在，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 505250,
      "end_ms": 506905,
      "text": "他们不是被规划出来的，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 507140,
      "end_ms": 515550,
      "text": "是被某一个在不确定性中判断行动的人发现出来的这就是奥地利学派经济学对效率概念最根本的颠覆。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 515850,
      "end_ms": 518075,
      "text": "你把一切路径都优化到极致，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 518370,
      "end_ms": 520265,
      "text": "你就关掉了所有意外的门。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 520840,
      "end_ms": 524285,
      "text": "真正的进步从来不是从更有效率的地方来的。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 524620,
      "end_ms": 527385,
      "text": "是从发现了新东西的地方来的。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 527790,
      "end_ms": 532175,
      "text": "米塞斯的学生哈耶克后来把这种自发秩序命名为catelexy,"
    },
    {
      "segment_id": "s000221",
      "start_ms": 532500,
      "end_ms": 535595,
      "text": "一个由无数个体自由交换和互动形成，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 535940,
      "end_ms": 538840,
      "text": "而非有某个中心设计或控制的秩序。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 539040,
      "end_ms": 540560,
      "text": "价格是信号的集合，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 540900,
      "end_ms": 542425,
      "text": "利润是方向的提示，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 542800,
      "end_ms": 544485,
      "text": "竞争是发现的引擎。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 545050,
      "end_ms": 546705,
      "text": "企业家不是被计划出来的，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 546950,
      "end_ms": 548985,
      "text": "是在自由市场中涌现出来的。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 549630,
      "end_ms": 551065,
      "text": "这段话可能会刺痛你，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 551840,
      "end_ms": 553835,
      "text": "你拼命追求的那个最优解，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 554380,
      "end_ms": 557135,
      "text": "可能正是你通往平庸的最短路径，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 557480,
      "end_ms": 558885,
      "text": "你越追求确定性，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 559180,
      "end_ms": 560855,
      "text": "你就越不可能发现新东西。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 561380,
      "end_ms": 564955,
      "text": "而这个世界真正的机会永远藏在你看不见的地方。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 565660,
      "end_ms": 567600,
      "text": "第五层颠覆经济学，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 567600,
      "end_ms": 568780,
      "text": "不是告诉你怎么做，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 569080,
      "end_ms": 571120,
      "text": "是告诉你世界怎么运转。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 571120,
      "end_ms": 572300,
      "text": "读到这里你可能想问，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 572380,
      "end_ms": 574675,
      "text": "说了这么多理论跟我的生活有什么关系？"
    },
    {
      "segment_id": "s000239",
      "start_ms": 575610,
      "end_ms": 576870,
      "text": "如果你这样想你，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 576870,
      "end_ms": 580030,
      "text": "就错过了米塞斯埋在这本书里最珍贵的遗产。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 580110,
      "end_ms": 582530,
      "text": "米赛斯用一本书证明的不是经济学，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 582530,
      "end_ms": 583495,
      "text": "可以教你赚钱，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 583940,
      "end_ms": 587795,
      "text": "而是经济学可以让你看清自己到底活在什么样的世界里。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 588350,
      "end_ms": 590095,
      "text": "他最大的颠覆不是方法，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 590450,
      "end_ms": 591175,
      "text": "是视角。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 591840,
      "end_ms": 593060,
      "text": "他在书里反复强调，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 593060,
      "end_ms": 596625,
      "text": "一个让所有信奉计划和调控的人不舒服的命题。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 597000,
      "end_ms": 599340,
      "text": "经济学不是一堆可以拿来应用的工具，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 599600,
      "end_ms": 602255,
      "text": "是一门关于人如何行动的科学。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 602780,
      "end_ms": 604560,
      "text": "他的研究对象不是GDP,"
    },
    {
      "segment_id": "s000251",
      "start_ms": 604700,
      "end_ms": 605860,
      "text": "不是通货膨胀率，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 605860,
      "end_ms": 606880,
      "text": "不是失业数据，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 607100,
      "end_ms": 608775,
      "text": "是一个一个活生生的人。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 609190,
      "end_ms": 611850,
      "text": "在资源有限、未来不确定的世界里，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 611970,
      "end_ms": 614130,
      "text": "如何做出选择承担后果？"
    },
    {
      "segment_id": "s000256",
      "start_ms": 614810,
      "end_ms": 618910,
      "text": "米塞斯在方法论上提出了一个在当时惊世骇俗的主张。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 619550,
      "end_ms": 630110,
      "text": "经济学的所有理论都可以从人的行动这一条先验公理中演绎出来人是有目的的行动的这不需要用数据去验证。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 630470,
      "end_ms": 632370,
      "text": "因为你在试图验证他的那一刻，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 632550,
      "end_ms": 634050,
      "text": "就已经在行动了。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 634810,
      "end_ms": 637050,
      "text": "这套方法论被称为行动学，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 637450,
      "end_ms": 641740,
      "text": "是奥地利学派区别于所有其他经济学流派最根本的特征。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 642480,
      "end_ms": 645820,
      "text": "他拒绝把经济学变成一门用数据做实验的科学。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 646300,
      "end_ms": 647480,
      "text": "因为他研究的对象，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 647680,
      "end_ms": 648500,
      "text": "人的行动，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 648820,
      "end_ms": 650120,
      "text": "本质上不可实验，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 650220,
      "end_ms": 651020,
      "text": "不可量化，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 651040,
      "end_ms": 653020,
      "text": "不可重复主流。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 653020,
      "end_ms": 654140,
      "text": "经济学界怎么回应？"
    },
    {
      "segment_id": "s000269",
      "start_ms": 654620,
      "end_ms": 659640,
      "text": "无视批评者说行动学依赖、先验推理、拒绝实证方法，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 660000,
      "end_ms": 662860,
      "text": "限制了他检验和验证经济理论的能力。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 662980,
      "end_ms": 665260,
      "text": "奥地利学派因为不肯融入定量方法，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 665440,
      "end_ms": 667180,
      "text": "被主流经济学边缘化了。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 667460,
      "end_ms": 668260,
      "text": "有人甚至说，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 668560,
      "end_ms": 672675,
      "text": "奥地利学派仍然被学术界认为是落伍时代的错误。"
    },
    {
      "segment_id": "s000275",
      "start_ms": 673040,
      "end_ms": 674860,
      "text": "但二零零八年金融危机之后，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 675120,
      "end_ms": 675885,
      "text": "事情变了，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 676490,
      "end_ms": 679770,
      "text": "人们开始重新审视这个被冷落了半个世纪的学派，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 679910,
      "end_ms": 681870,
      "text": "发现他关于商业周期的理论，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 682010,
      "end_ms": 685550,
      "text": "比任何数学模型都更准确的解释了危机的成因。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 685690,
      "end_ms": 689850,
      "text": "奥地利学派所强调的自由市场理念和对政府干预的警惕，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 690030,
      "end_ms": 692505,
      "text": "在公共领域赢得了一大批新读者。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 692820,
      "end_ms": 694120,
      "text": "米塞斯在书里写过一段，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 694120,
      "end_ms": 695465,
      "text": "让我沉默很久的话。"
    },
    {
      "segment_id": "s000284",
      "start_ms": 696050,
      "end_ms": 696675,
      "text": "他说，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 697180,
      "end_ms": 699700,
      "text": "经济学不是告诉人们应该怎么做的，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 699700,
      "end_ms": 704555,
      "text": "说明书是告诉人们世界实际上怎么运转的地图，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 705150,
      "end_ms": 707315,
      "text": "地图不会告诉你往哪儿走是对的。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 707560,
      "end_ms": 708425,
      "text": "他只会告诉你，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 708660,
      "end_ms": 709340,
      "text": "如果你往东，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 709640,
      "end_ms": 710525,
      "text": "你会遇到山。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 710910,
      "end_ms": 711650,
      "text": "如果你往西，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 711970,
      "end_ms": 712865,
      "text": "你会遇到河，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 713450,
      "end_ms": 714570,
      "text": "至于你选哪条路，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 714790,
      "end_ms": 715750,
      "text": "那是你的事儿。"
    },
    {
      "segment_id": "s000295",
      "start_ms": 715770,
      "end_ms": 718795,
      "text": "这段话让我明白了这本书最惊世骇俗的答案。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 719130,
      "end_ms": 721765,
      "text": "经济学最大的价值不是让你变有钱，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 722330,
      "end_ms": 723930,
      "text": "是让你在做一个决策时，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 724230,
      "end_ms": 727070,
      "text": "清楚的知道自己在一个什么样的世界里行动，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 727330,
      "end_ms": 728870,
      "text": "被什么样的信号引导，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 729090,
      "end_ms": 731605,
      "text": "以及最终要为这个选择承担什么。"
    },
    {
      "segment_id": "s000301",
      "start_ms": 731900,
      "end_ms": 733555,
      "text": "它不会让你的人生变容易，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 733860,
      "end_ms": 735540,
      "text": "但它会让你的人生变清醒。"
    },
    {
      "segment_id": "s000303",
      "start_ms": 735700,
      "end_ms": 737560,
      "text": "读完奥地利学派经济学简史，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 737740,
      "end_ms": 739425,
      "text": "你可能发现书名起错了。"
    },
    {
      "segment_id": "s000305",
      "start_ms": 739790,
      "end_ms": 741775,
      "text": "这不是一本教你经济学的入门书，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 742550,
      "end_ms": 745805,
      "text": "是一本关于人如何在不确定性中行动，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 746160,
      "end_ms": 748770,
      "text": "市场如何在自由中运转繁荣，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 748790,
      "end_ms": 750130,
      "text": "如何在信号中诞生，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 750370,
      "end_ms": 753055,
      "text": "又如何在扭曲中崩塌的生存指南。"
    },
    {
      "segment_id": "s000310",
      "start_ms": 753790,
      "end_ms": 758990,
      "text": "这本书收录了米塞斯关于奥地利学派历史背景的几乎所有著作演讲与文章。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 759130,
      "end_ms": 761425,
      "text": "从他一九六九年写下的经典长文，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 761730,
      "end_ms": 764915,
      "text": "到关于卡尔蒙格尔与德国历史学派冲突的论述，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 765250,
      "end_ms": 768375,
      "text": "再到对奥地利学派思想当代影响的系统梳理。"
    },
    {
      "segment_id": "s000314",
      "start_ms": 768790,
      "end_ms": 770370,
      "text": "它的价值不在于告诉你，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 770370,
      "end_ms": 771410,
      "text": "一个学派的兴衰。"
    },
    {
      "segment_id": "s000316",
      "start_ms": 771410,
      "end_ms": 774410,
      "text": "故事在于他让你看清一件事，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 774470,
      "end_ms": 775830,
      "text": "有一个被主流驱逐，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 775970,
      "end_ms": 777095,
      "text": "被学界沉默。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 777380,
      "end_ms": 779965,
      "text": "二十四年没拿过一分钱薪水的学者，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 780310,
      "end_ms": 784790,
      "text": "面对一个被凯恩斯主义、被数学建模、被宏观调控主导的世界，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 785010,
      "end_ms": 785250,
      "text": "说，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 785610,
      "end_ms": 786835,
      "text": "我不服从权利，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 787060,
      "end_ms": 788315,
      "text": "我只服从逻辑。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 788730,
      "end_ms": 789745,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000325",
      "start_ms": 790370,
      "end_ms": 793005,
      "text": "他看见每一个价格都是一次发现，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 793510,
      "end_ms": 796055,
      "text": "每一个泡沫都是一次信号的扭曲。"
    },
    {
      "segment_id": "s000327",
      "start_ms": 796590,
      "end_ms": 799795,
      "text": "每一个自由行动的人都是市场过程的参与者，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 800170,
      "end_ms": 802715,
      "text": "而你有幸可以学会看懂这一切。"
    },
    {
      "segment_id": "s000329",
      "start_ms": 803370,
      "end_ms": 805095,
      "text": "这本书推荐序里有一句话，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 805550,
      "end_ms": 806575,
      "text": "我想把它留给你。"
    },
    {
      "segment_id": "s000331",
      "start_ms": 807030,
      "end_ms": 809265,
      "text": "奥地利学派经济学的知识和精神，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 809550,
      "end_ms": 811010,
      "text": "不仅是一种学术传统，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 811390,
      "end_ms": 813305,
      "text": "更是一种理解世界的方式。"
    },
    {
      "segment_id": "s000334",
      "start_ms": 813660,
      "end_ms": 816695,
      "text": "他让你在面对任何权威宣称的唯一真理时，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 817030,
      "end_ms": 818295,
      "text": "都有能力问一句，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 818670,
      "end_ms": 819830,
      "text": "你凭什么这么说？"
    },
    {
      "segment_id": "s000337",
      "start_ms": 820110,
      "end_ms": 820850,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 821030,
      "end_ms": 822995,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "8e71d1e9a3ae4e94b7ca775a26bad78e90268c0b76238ea0ee157931b5fcca9c"
}