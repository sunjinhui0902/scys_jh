{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ad944b26480f2d8b_u001",
  "video_id": "v_ad944b26480f2d8b",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 984.341995,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 3870,
      "text": "你知道中国流失海外最珍贵的文物都有哪些吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4950,
      "end_ms": 5510,
      "text": "上集，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5510,
      "end_ms": 6210,
      "text": "咱们聊了，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6470,
      "end_ms": 6710,
      "text": "唐，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 6810,
      "end_ms": 7350,
      "text": "三采，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 7350,
      "end_ms": 8890,
      "text": "骆驼载乐俑，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 10010,
      "end_ms": 17270,
      "text": "昭陵六郡女史贞图二二生肖兽首龙门石窟佛头。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17670,
      "end_ms": 19430,
      "text": "这集直接揭开谜底，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 19730,
      "end_ms": 22530,
      "text": "看看前五名到底珍贵到什么程度，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 23070,
      "end_ms": 27510,
      "text": "尤其是排在榜首的那件二万二千九百三十七卷，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 27690,
      "end_ms": 31180,
      "text": "只找回了八百卷剩下的二万二千卷，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 31380,
      "end_ms": 32260,
      "text": "不知所踪。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 32940,
      "end_ms": 34660,
      "text": "老规矩开讲之前，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 34660,
      "end_ms": 36680,
      "text": "劳烦您扣个六点个红心，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 37220,
      "end_ms": 38640,
      "text": "让我看看都是谁。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 38640,
      "end_ms": 45520,
      "text": "在听第五名敦煌藏经动京卷唐宋时期，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 45820,
      "end_ms": 50440,
      "text": "现在分散在英国、法国、俄国、日本等十几个国家。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 50440,
      "end_ms": 52520,
      "text": "一九零零年中，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 54810,
      "end_ms": 60525,
      "text": "敦煌莫高窟、道士王元盖清理洞窟。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 60960,
      "end_ms": 62055,
      "text": "墙皮掉了，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 62310,
      "end_ms": 63375,
      "text": "露出一个密室，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 63850,
      "end_ms": 67105,
      "text": "里面堆满了经卷佛画文殊。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 67410,
      "end_ms": 69025,
      "text": "从晋朝到宋朝，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 69410,
      "end_ms": 70390,
      "text": "封了九百年，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 70650,
      "end_ms": 71905,
      "text": "整整五万多件，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 72950,
      "end_ms": 74555,
      "text": "您知道这是什么概念吗？"
    },
    {
      "segment_id": "s000027",
      "start_ms": 74920,
      "end_ms": 76765,
      "text": "这是一座地下图书馆，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 77620,
      "end_ms": 80205,
      "text": "是中国文化的时间胶囊。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 81850,
      "end_ms": 84010,
      "text": "王道士不懂上报给甘肃，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 84030,
      "end_ms": 87150,
      "text": "官府官府贤运费贵说，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 87150,
      "end_ms": 92065,
      "text": "你先看着一九零七年英国人斯坦因来了，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 92540,
      "end_ms": 97705,
      "text": "花了两百两银子拉走了二十四箱经卷七千多件，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 99870,
      "end_ms": 100815,
      "text": "一九零八年，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 101760,
      "end_ms": 103305,
      "text": "法国人薄希和来了。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 104140,
      "end_ms": 105025,
      "text": "他懂中文，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 106240,
      "end_ms": 107545,
      "text": "专挑最好的，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 108440,
      "end_ms": 122740,
      "text": "拿走了六千多卷俄国人日本人美国人一波一波来，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 123120,
      "end_ms": 125680,
      "text": "等到一九一零年北京反应过来，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 125940,
      "end_ms": 127660,
      "text": "派人去运路上，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 127940,
      "end_ms": 130100,
      "text": "又被地方官克扣到北京，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 130120,
      "end_ms": 131360,
      "text": "只剩八千多件。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 132220,
      "end_ms": 137340,
      "text": "今天您想看最好的敦煌经卷得去伦敦大英图书馆，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 138020,
      "end_ms": 139860,
      "text": "去巴黎国家图书馆，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 140560,
      "end_ms": 142260,
      "text": "去东京国立图书馆。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 143520,
      "end_ms": 145100,
      "text": "可让人欣慰的是，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 145600,
      "end_ms": 148720,
      "text": "这些年敦煌研究院跟各国合作，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 149040,
      "end_ms": 153050,
      "text": "把这些经卷数字化做成了数字敦煌。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 153810,
      "end_ms": 158190,
      "text": "全世界的人都能在网上看到文物的身体，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 158190,
      "end_ms": 159150,
      "text": "虽然散了，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 159590,
      "end_ms": 167770,
      "text": "他的灵魂通过数字技术又回来五万卷国宝四分之三流落海外，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 167790,
      "end_ms": 172070,
      "text": "可中国人用另一种方式把他们的价值传承下来。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 172790,
      "end_ms": 175430,
      "text": "这是智慧第四名，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 176590,
      "end_ms": 180015,
      "text": "富春山居图元代皇宫万画的，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 180940,
      "end_ms": 184125,
      "text": "现在一半在浙江省博物馆，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 184610,
      "end_ms": 186965,
      "text": "一半在台北故宫博物院。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 187740,
      "end_ms": 188480,
      "text": "严格说，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 188480,
      "end_ms": 190005,
      "text": "这幅画没有流失海外，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 190660,
      "end_ms": 192125,
      "text": "可他被一分为二，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 192790,
      "end_ms": 193675,
      "text": "隔着海峡，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 194030,
      "end_ms": 195945,
      "text": "这本身就是最大的遗憾。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 196960,
      "end_ms": 199225,
      "text": "黄公旺是元代四大家之首，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 199670,
      "end_ms": 203050,
      "text": "他七十九岁开始画这幅画画了三年多。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 203330,
      "end_ms": 205130,
      "text": "画的是富春江的秋景，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 205130,
      "end_ms": 207155,
      "text": "被誉为画中之兰亭，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 207750,
      "end_ms": 209705,
      "text": "是中国山水画的巅峰。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 210690,
      "end_ms": 211665,
      "text": "明朝末年，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 212430,
      "end_ms": 216525,
      "text": "收藏家吴鸿玉临死前要把这幅画烧掉陪葬。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 217350,
      "end_ms": 219195,
      "text": "他侄子从火里抢出来，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 219600,
      "end_ms": 221345,
      "text": "话已经烧成两截，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 221940,
      "end_ms": 224145,
      "text": "前半段叫圣山图，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 224470,
      "end_ms": 225775,
      "text": "只剩五十一厘米，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 226490,
      "end_ms": 227825,
      "text": "在浙江省博物馆，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 228380,
      "end_ms": 230785,
      "text": "后半段叫无用诗卷，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 231570,
      "end_ms": 233435,
      "text": "长六百三十六厘米，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 234150,
      "end_ms": 237815,
      "text": "在台北故宫博物院两岸分隔六十多年，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 238770,
      "end_ms": 241865,
      "text": "这幅画一半在大陆一半。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 242210,
      "end_ms": 245660,
      "text": "在台湾二零一一年六月，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 245780,
      "end_ms": 248405,
      "text": "两段话在台北合璧展出。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 249090,
      "end_ms": 253300,
      "text": "这是三百六十年来第一次团圆展览，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 253360,
      "end_ms": 254555,
      "text": "只办了三个月，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 255380,
      "end_ms": 258515,
      "text": "两岸同胞排了几个小时的队哦，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 259010,
      "end_ms": 262730,
      "text": "就为了看一眼完整富春山居图，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 263010,
      "end_ms": 264090,
      "text": "展览结束，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 264430,
      "end_ms": 266345,
      "text": "两段话又分开了。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 267020,
      "end_ms": 267700,
      "text": "可那一次，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 267700,
      "end_ms": 271005,
      "text": "何必让所有中国人看到了希望，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 271770,
      "end_ms": 272835,
      "text": "再远的距离，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 273190,
      "end_ms": 275890,
      "text": "文化能把咱们连在一起。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 276450,
      "end_ms": 279475,
      "text": "一幅画被火烧成两截，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 279930,
      "end_ms": 281975,
      "text": "被海峡隔成两岸，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 282480,
      "end_ms": 284885,
      "text": "可他终究会再团圆，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 285730,
      "end_ms": 287690,
      "text": "这是所有中国人的期待。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 287710,
      "end_ms": 288475,
      "text": "第三名，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 289730,
      "end_ms": 291675,
      "text": "四库全书散卡卷。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 292710,
      "end_ms": 297150,
      "text": "清朝乾隆年间编的部分流失海外，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 297950,
      "end_ms": 301690,
      "text": "现在分散在美国、日本、欧洲等地。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 302910,
      "end_ms": 303850,
      "text": "四库全书。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 303870,
      "end_ms": 304990,
      "text": "您肯定听过。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 305450,
      "end_ms": 308030,
      "text": "乾隆动用了三百六十多位学者，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 308210,
      "end_ms": 312170,
      "text": "花了十年抄录了三千四百多种书，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 312970,
      "end_ms": 314610,
      "text": "七万九千多卷，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 315030,
      "end_ms": 317430,
      "text": "分装成三万六千多册，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 317930,
      "end_ms": 322500,
      "text": "是中国历史上最大的一部动书乾。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 322560,
      "end_ms": 324040,
      "text": "乾隆一共抄了七套，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 324800,
      "end_ms": 325300,
      "text": "分藏，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 325300,
      "end_ms": 329320,
      "text": "在北京、扬州、镇江、杭州等地。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 330340,
      "end_ms": 333500,
      "text": "可后来呢太平天国英法联军，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 333640,
      "end_ms": 334460,
      "text": "八国联军，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 335500,
      "end_ms": 338000,
      "text": "军阀混战很套书，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 338180,
      "end_ms": 339180,
      "text": "毁了三套半。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 339900,
      "end_ms": 341340,
      "text": "一千八百六十年，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 342100,
      "end_ms": 349100,
      "text": "英法联军火烧圆明园文元阁的一套四库全书军饷被烧散，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 349180,
      "end_ms": 349900,
      "text": "k了不少，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 350260,
      "end_ms": 352325,
      "text": "很多散册流落海外。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 352590,
      "end_ms": 360085,
      "text": "美国国会图书馆、哈佛大学图书馆、日本东京大学图书馆都藏着四库全书的散本。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 360910,
      "end_ms": 362410,
      "text": "更让人心疼的是，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 362850,
      "end_ms": 364345,
      "text": "很多珍贵的孤本，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 364730,
      "end_ms": 367445,
      "text": "当年只收录在四库全书里，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 368310,
      "end_ms": 369870,
      "text": "原书已经失传了，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 369910,
      "end_ms": 371535,
      "text": "四库全书也残了，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 371940,
      "end_ms": 373725,
      "text": "那些书就彻底消失了。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 374500,
      "end_ms": 375580,
      "text": "可让人欣慰的，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 375580,
      "end_ms": 378205,
      "text": "是从二零零五年开始，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 378590,
      "end_ms": 380665,
      "text": "中国跟海外的图书馆合作，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 381390,
      "end_ms": 385975,
      "text": "把这些散刊的四库全书影印出版做成数字版。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 386410,
      "end_ms": 387650,
      "text": "虽然袁术回不来，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 387790,
      "end_ms": 395350,
      "text": "他的内容容保住了二零一九年一套完整的文经阁。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 395350,
      "end_ms": 397095,
      "text": "四库全书影印本出版，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 397940,
      "end_ms": 401445,
      "text": "全世界的学者都能看到完整的四库全书了。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 401860,
      "end_ms": 407575,
      "text": "一部百科全书记录了中国几千年的文虽然散了，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 408580,
      "end_ms": 410305,
      "text": "可咱们用技术让他活下来。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 411320,
      "end_ms": 413915,
      "text": "这是传承第二名。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 414270,
      "end_ms": 415985,
      "text": "西周青铜重器，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 416930,
      "end_ms": 420755,
      "text": "西周时期部分流失海外，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 421710,
      "end_ms": 424525,
      "text": "现在主要在美国、日本的博物馆。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 424790,
      "end_ms": 427375,
      "text": "您知道青铜器对中国有多重要吗？"
    },
    {
      "segment_id": "s000137",
      "start_ms": 428250,
      "end_ms": 432155,
      "text": "商周时期的青铜器是国之重器，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 432990,
      "end_ms": 440755,
      "text": "只有天子诸侯才能用每一件器物上的铭文都是一段真实的历史。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 441700,
      "end_ms": 446665,
      "text": "纽约大都会博物馆藏着一套西周的青铜编钟，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 447060,
      "end_ms": 454095,
      "text": "是一九三零年代从中国买走日本全无博古馆藏着几十件中国商周青铜器，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 454790,
      "end_ms": 456675,
      "text": "其中不少是盗墓得来的。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 457660,
      "end_ms": 461165,
      "text": "一九二零年代古董商如秦斋，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 461930,
      "end_ms": 464775,
      "text": "专门倒卖中国文物到欧美，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 465170,
      "end_ms": 467455,
      "text": "他经手的青铜器数以百计。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 467920,
      "end_ms": 468925,
      "text": "二零一九年，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 469230,
      "end_ms": 475870,
      "text": "一件西周青铜器虎棺在英国拍卖中国国家文物局得到消息，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 476130,
      "end_ms": 477735,
      "text": "立刻联系英国政府，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 478160,
      "end_ms": 480755,
      "text": "最后收藏家主动撤拍。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 481250,
      "end_ms": 483505,
      "text": "把虎车捐赠给中国，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 483850,
      "end_ms": 490135,
      "text": "无偿规划二零二零年流失英国二十五年的六十八件文物，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 490490,
      "end_ms": 495205,
      "text": "包括多件商周青竹器被成功追索回国。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 496050,
      "end_ms": 504095,
      "text": "二零二一年流失日本的八件青铜器被中国买家买回来捐给国家。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 504750,
      "end_ms": 509500,
      "text": "您看这些年越来越多的流失文物，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 509500,
      "end_ms": 512485,
      "text": "再回家有花钱买回来的，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 513230,
      "end_ms": 515285,
      "text": "有外国人主动捐的，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 516120,
      "end_ms": 519025,
      "text": "还有国家通过法律手段追回来，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 519600,
      "end_ms": 521095,
      "text": "一件青铜器，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 521660,
      "end_ms": 523800,
      "text": "刻着三千年前的历史。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 524280,
      "end_ms": 525965,
      "text": "他们流落异国，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 526500,
      "end_ms": 530025,
      "text": "可中国人从未放弃一件一件往回追，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 530870,
      "end_ms": 531905,
      "text": "这是咱们的坚持。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 532960,
      "end_ms": 533720,
      "text": "聊到这儿，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 534380,
      "end_ms": 535860,
      "text": "我突然想起一件事，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 536800,
      "end_ms": 539660,
      "text": "讲了这么多流失文物评论区，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 539660,
      "end_ms": 542640,
      "text": "好多朋友都在问老师，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 543120,
      "end_ms": 543840,
      "text": "这些文物，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 543840,
      "end_ms": 546480,
      "text": "我们普通人去哪能看到孩子？"
    },
    {
      "segment_id": "s000168",
      "start_ms": 546480,
      "end_ms": 547480,
      "text": "问起来怎么讲？"
    },
    {
      "segment_id": "s000169",
      "start_ms": 548260,
      "end_ms": 551060,
      "text": "您说的对文物流失了让人心疼，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 551920,
      "end_ms": 553700,
      "text": "可更让人心疼的是，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 553940,
      "end_ms": 557100,
      "text": "咱们自己连这些国宝长什么样都不认识，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 557580,
      "end_ms": 559260,
      "text": "我自己也有这个困扰。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 559600,
      "end_ms": 561780,
      "text": "想了解文物又没时间，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 561800,
      "end_ms": 564690,
      "text": "天天跑博物管看书吧专业书，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 564690,
      "end_ms": 566710,
      "text": "太枯燥看不下去。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 566710,
      "end_ms": 567390,
      "text": "直到去年，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 567750,
      "end_ms": 569950,
      "text": "我朋友送了我一本故宫日历，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 570490,
      "end_ms": 571550,
      "text": "翻开那一刻，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 571790,
      "end_ms": 575130,
      "text": "我才发现原来认识国宝可以这么简单。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 575590,
      "end_ms": 578310,
      "text": "这本日历不是普通的日期本，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 578530,
      "end_ms": 582185,
      "text": "它每一天都配一件故宫的文物照片。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 582830,
      "end_ms": 583970,
      "text": "高清大图，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 584290,
      "end_ms": 587850,
      "text": "您能看清楚青铜器上的每一个纹路，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 588550,
      "end_ms": 590610,
      "text": "瓷器上的每一笔釉色，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 591090,
      "end_ms": 595990,
      "text": "下面写着文物的名字、年代背后的故事，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 597310,
      "end_ms": 599570,
      "text": "三五十个字讲的清清楚楚，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 599730,
      "end_ms": 600890,
      "text": "不用啃大布头，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 601250,
      "end_ms": 603950,
      "text": "每天一分钟就认识一件国宝。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 604550,
      "end_ms": 606030,
      "text": "我自己现在是这么用，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 606630,
      "end_ms": 609390,
      "text": "每天早上翻一页看一件文物，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 609830,
      "end_ms": 615040,
      "text": "一年三百六十五天下来就认识了三百六十五件国宝，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 615400,
      "end_ms": 618460,
      "text": "不知不觉就把中国文化史捋了一遍，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 619240,
      "end_ms": 621140,
      "text": "比看书轻松多了。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 621880,
      "end_ms": 623120,
      "text": "孩子问起历史，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 623860,
      "end_ms": 625100,
      "text": "我也有底气了。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 626180,
      "end_ms": 627260,
      "text": "这是干巴巴的，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 627260,
      "end_ms": 628380,
      "text": "说咱们要爱国，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 628919,
      "end_ms": 630960,
      "text": "而是指着日历上的文物说，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 631860,
      "end_ms": 636280,
      "text": "你看这件青铜器流失了一百年，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 636540,
      "end_ms": 637900,
      "text": "去年才回来的，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 637960,
      "end_ms": 639580,
      "text": "这叫有血有肉。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 639760,
      "end_ms": 641580,
      "text": "孩子听得懂也记得住，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 641820,
      "end_ms": 642970,
      "text": "放在书中桌上，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 643010,
      "end_ms": 643995,
      "text": "每天看一眼，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 644330,
      "end_ms": 645495,
      "text": "也是提醒自己，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 645860,
      "end_ms": 647545,
      "text": "咱们的文化这么灿烂。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 647960,
      "end_ms": 649560,
      "text": "守护他传承。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 649620,
      "end_ms": 652510,
      "text": "他是每个中国人的责任书，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 652610,
      "end_ms": 655365,
      "text": "已经在主页橱窗随缘带走，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 656030,
      "end_ms": 657215,
      "text": "每天涨知识，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 657990,
      "end_ms": 658805,
      "text": "送长辈，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 659300,
      "end_ms": 660185,
      "text": "有面子，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 660520,
      "end_ms": 661385,
      "text": "有内涵，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 661950,
      "end_ms": 665455,
      "text": "送孩子从小培养文化底蕴，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 665900,
      "end_ms": 667335,
      "text": "怎么送都合适。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 667750,
      "end_ms": 673875,
      "text": "一本日历三百六十五件国宝三百六十五个故事，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 675730,
      "end_ms": 676530,
      "text": "一年下来，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 676630,
      "end_ms": 678535,
      "text": "您就是半个文物专家了。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 679670,
      "end_ms": 680075,
      "text": "好，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 680570,
      "end_ms": 681695,
      "text": "咱们收回正题，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 682440,
      "end_ms": 686675,
      "text": "看看排在榜首的到底是哪件文物。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 687610,
      "end_ms": 690425,
      "text": "第一名永乐大典，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 692880,
      "end_ms": 697255,
      "text": "明朝永乐年间编的全世界只找回了八百多卷，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 697640,
      "end_ms": 699480,
      "text": "剩下二万二千多卷，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 699480,
      "end_ms": 700355,
      "text": "下落不明。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 700720,
      "end_ms": 701745,
      "text": "为什么排第一？"
    },
    {
      "segment_id": "s000227",
      "start_ms": 702390,
      "end_ms": 702830,
      "text": "第一，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 703050,
      "end_ms": 705825,
      "text": "它是中国历史上最大的百科全书。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 706580,
      "end_ms": 707845,
      "text": "明朝永乐三年，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 708380,
      "end_ms": 715280,
      "text": "永乐皇帝朱棣下令召集两千一百六十九位学者编一部包罗万象的大书。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 715540,
      "end_ms": 716965,
      "text": "他们花了六年时间，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 717450,
      "end_ms": 722515,
      "text": "把八千多种古籍全部抄录下来分类整理，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 722810,
      "end_ms": 724435,
      "text": "编成了永乐大典。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 725480,
      "end_ms": 726545,
      "text": "这本书有多大？"
    },
    {
      "segment_id": "s000235",
      "start_ms": 727920,
      "end_ms": 734915,
      "text": "二万二千九百三十七卷装成一万一千零九十五册三点七亿字，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 735580,
      "end_ms": 737615,
      "text": "是大英百科全书的四倍。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 738450,
      "end_ms": 740915,
      "text": "从经史子集到天文地理，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 741380,
      "end_ms": 743635,
      "text": "从医药工艺到戏曲小说，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 744340,
      "end_ms": 749200,
      "text": "把中国从先秦到明朝的文化全都收进去。"
    },
    {
      "segment_id": "s000240",
      "start_ms": 750390,
      "end_ms": 750810,
      "text": "第二，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 751240,
      "end_ms": 753705,
      "text": "他保存了大量失传的古籍，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 755000,
      "end_ms": 755840,
      "text": "很多书，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 756120,
      "end_ms": 757385,
      "text": "宋元时期还在，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 757990,
      "end_ms": 760115,
      "text": "明朝以后就失传了，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 760920,
      "end_ms": 764510,
      "text": "只有永乐大典里还保留着清朝学者。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 764510,
      "end_ms": 769155,
      "text": "从永乐大典里及档出来的书有三百八十五种。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 769560,
      "end_ms": 770320,
      "text": "也就是说，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 770660,
      "end_ms": 772405,
      "text": "如果没有永乐大典，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 772690,
      "end_ms": 775935,
      "text": "这三百八十五种书就彻底消失了。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 776850,
      "end_ms": 777290,
      "text": "第三，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 777680,
      "end_ms": 779295,
      "text": "他的命运太悲惨。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 779900,
      "end_ms": 781615,
      "text": "永乐大典抄了两部，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 782190,
      "end_ms": 782650,
      "text": "正本，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 782710,
      "end_ms": 784295,
      "text": "在明朝就不知去向。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 784720,
      "end_ms": 787010,
      "text": "副本藏在北京皇宫。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 787250,
      "end_ms": 788765,
      "text": "一千八百六十年，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 789560,
      "end_ms": 792140,
      "text": "英法联军火烧圆明园，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 792440,
      "end_ms": 794820,
      "text": "永乐大典的副本被抢走，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 794820,
      "end_ms": 796115,
      "text": "被烧毁一大半。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 797410,
      "end_ms": 798385,
      "text": "一九零零年，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 798630,
      "end_ms": 800175,
      "text": "八国联军进北京，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 800740,
      "end_ms": 803495,
      "text": "剩下的永乐大典又被抢了一轮。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 804550,
      "end_ms": 812075,
      "text": "英国、法国、德国、俄国、日本到处都有永乐大典的零散册业。"
    },
    {
      "segment_id": "s000264",
      "start_ms": 812560,
      "end_ms": 812980,
      "text": "今天，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 813060,
      "end_ms": 816335,
      "text": "全世界找到的永乐大典只剩八百多卷，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 816630,
      "end_ms": 818335,
      "text": "不到原书的百分之四，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 819120,
      "end_ms": 821175,
      "text": "剩下二万二千多卷，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 821430,
      "end_ms": 822725,
      "text": "不知道是被烧了，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 823050,
      "end_ms": 825185,
      "text": "还是在某个私人藏家手里。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 825630,
      "end_ms": 826110,
      "text": "第四，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 826600,
      "end_ms": 828825,
      "text": "中国人从未放弃寻找。"
    },
    {
      "segment_id": "s000272",
      "start_ms": 830300,
      "end_ms": 830840,
      "text": "这些年，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 830860,
      "end_ms": 835425,
      "text": "国家文物局一直在全世界找永乐大典的下落。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 836000,
      "end_ms": 836855,
      "text": "二零零七年，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 837310,
      "end_ms": 840070,
      "text": "美国一个私人收藏家主动联系中国，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 840330,
      "end_ms": 842055,
      "text": "归还了一册永乐大典。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 842640,
      "end_ms": 843640,
      "text": "二零二零年，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 843860,
      "end_ms": 847620,
      "text": "一位旅日华侨花高价从日本拍卖行买回一册，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 847620,
      "end_ms": 849355,
      "text": "永乐大典捐给国家，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 849880,
      "end_ms": 852140,
      "text": "二零二二年又有一册，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 852140,
      "end_ms": 854105,
      "text": "永乐大典从海外回归。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 854620,
      "end_ms": 857155,
      "text": "虽然还有二万二千卷没找到，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 857680,
      "end_ms": 859660,
      "text": "可只要有一册在外面，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 859920,
      "end_ms": 861925,
      "text": "咱们就会一直找下去。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 863460,
      "end_ms": 865140,
      "text": "永乐大典边城的时候，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 865140,
      "end_ms": 867735,
      "text": "是明朝国力最强盛的时候，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 868340,
      "end_ms": 872375,
      "text": "一部书代表的是一个民族的文化自信。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 873350,
      "end_ms": 873870,
      "text": "今天，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 874670,
      "end_ms": 877450,
      "text": "咱们用另一种方式守护这份自信，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 878390,
      "end_ms": 880810,
      "text": "找回文物、传承文化，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 881050,
      "end_ms": 883850,
      "text": "让后代知道咱们的根有多深。"
    },
    {
      "segment_id": "s000292",
      "start_ms": 884090,
      "end_ms": 885890,
      "text": "咱们的文明有多灿烂？"
    },
    {
      "segment_id": "s000293",
      "start_ms": 886910,
      "end_ms": 890670,
      "text": "十件文物讲完了唐三彩驮着圣世，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 890730,
      "end_ms": 895830,
      "text": "流落纽约昭陵六郡被聚成几块女史。"
    },
    {
      "segment_id": "s000295",
      "start_ms": 895850,
      "end_ms": 897670,
      "text": "贞图换了一匹马的价格，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 898030,
      "end_ms": 902430,
      "text": "十二兽首买回了七个龙门石窟的佛头，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 902430,
      "end_ms": 903920,
      "text": "在一个个一个回家。"
    },
    {
      "segment_id": "s000298",
      "start_ms": 904040,
      "end_ms": 906980,
      "text": "敦煌藏经洞的经卷被数字化了，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 907600,
      "end_ms": 913080,
      "text": "富春山居图何必展出过一次四库全书被影印出版，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 913880,
      "end_ms": 917160,
      "text": "西周青铜器再一件件追回来，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 917980,
      "end_ms": 923860,
      "text": "剩只有永乐大典二万二千九百三十七卷只找回八百卷，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 924660,
      "end_ms": 926420,
      "text": "剩下二万二千卷。"
    },
    {
      "segment_id": "s000303",
      "start_ms": 926520,
      "end_ms": 928400,
      "text": "还在找您，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 928400,
      "end_ms": 932595,
      "text": "说什么叫文化文万不是几件文物，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 933040,
      "end_ms": 934955,
      "text": "而是一个民族的记忆。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 935380,
      "end_ms": 939755,
      "text": "这些流失的文物带走的不只是器物本身，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 940410,
      "end_ms": 942050,
      "text": "带走的是咱们的历史。"
    },
    {
      "segment_id": "s000308",
      "start_ms": 942150,
      "end_ms": 942955,
      "text": "咱们的根。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 945220,
      "end_ms": 946465,
      "text": "可让人欣慰的是，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 947310,
      "end_ms": 955645,
      "text": "这些年中国人一直在努力，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 956500,
      "end_ms": 959095,
      "text": "有钱的出钱有力的出力，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 959430,
      "end_ms": 961605,
      "text": "十五万件刘氏文物已经回家，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 964220,
      "end_ms": 965745,
      "text": "还有更多的在路上。"
    },
    {
      "segment_id": "s000314",
      "start_ms": 966190,
      "end_ms": 967105,
      "text": "最后问问您，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 967480,
      "end_ms": 968445,
      "text": "这十件文物，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 968720,
      "end_ms": 970035,
      "text": "您最心疼哪一件？"
    },
    {
      "segment_id": "s000317",
      "start_ms": 970470,
      "end_ms": 972765,
      "text": "您觉得哪一件最应该追回来？"
    },
    {
      "segment_id": "s000318",
      "start_ms": 973680,
      "end_ms": 974725,
      "text": "评论区告诉我，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 975620,
      "end_ms": 976955,
      "text": "觉得这七党知识了，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 977610,
      "end_ms": 978195,
      "text": "点个赞，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 979200,
      "end_ms": 979975,
      "text": "点个收藏，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 980390,
      "end_ms": 981995,
      "text": "想看更多文物的故事，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 982230,
      "end_ms": 982895,
      "text": "点个关注，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 983140,
      "end_ms": 984285,
      "text": "咱们下回接着聊。"
    }
  ],
  "source_transcript_sha256": "c92f22116ae599ccb02a817531c3984e108697f39e7017cc4c02b70c582a0ea7"
}