{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_30ab5bb2ea001aea_u001",
  "video_id": "v_30ab5bb2ea001aea",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 439.299002,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 2370,
      "text": "上期咱们聊了西湖、千岛湖这些，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2670,
      "end_ms": 3590,
      "text": "这期接着聊。"
    },
    {
      "segment_id": "s000003",
      "start_ms": 3590,
      "end_ms": 4770,
      "text": "第十到第六名。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 5350,
      "end_ms": 7270,
      "text": "这五个里面有一个湖，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 7310,
      "end_ms": 9850,
      "text": "每年只每二十天有一个湖，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 9930,
      "end_ms": 11730,
      "text": "全年只有大约五十天，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 11730,
      "end_ms": 13370,
      "text": "能看到湛蓝的真容。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 13930,
      "end_ms": 16490,
      "text": "还有一个湖的湖水会在夏天自己变红，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 17190,
      "end_ms": 18990,
      "text": "觉得有意思的可以先收藏，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 19030,
      "end_ms": 19590,
      "text": "慢慢看，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 20370,
      "end_ms": 23130,
      "text": "咱们接着聊第十名。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 23430,
      "end_ms": 26430,
      "text": "内蒙古额济纳湖杨林倒影。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 26830,
      "end_ms": 27770,
      "text": "你想象一下，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 27770,
      "end_ms": 28830,
      "text": "你站在居安海边，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 28830,
      "end_ms": 32040,
      "text": "清晨的你的冷空气钻进鼻子里，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 32040,
      "end_ms": 34660,
      "text": "带着一丝沙土和枯草的味道。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 35500,
      "end_ms": 37820,
      "text": "太阳刚从地平线上升起来，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 38600,
      "end_ms": 41900,
      "text": "金色的光斜斜的打在对岸的胡杨林上，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 42880,
      "end_ms": 45180,
      "text": "整片林子像被点燃了，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 45580,
      "end_ms": 47400,
      "text": "每一片叶子都在发光，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 48200,
      "end_ms": 50280,
      "text": "湖面没有一丝波纹，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 51060,
      "end_ms": 53800,
      "text": "把整片金林倒映在水里，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 54620,
      "end_ms": 59555,
      "text": "天上一个金色的世里水里一个金色的世界，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 61050,
      "end_ms": 64045,
      "text": "你站在中间分不清哪个是真的。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 64800,
      "end_ms": 67965,
      "text": "但额济纳的观赏期全周期约二十二天，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 68430,
      "end_ms": 70915,
      "text": "最佳观赏期只有十一天左右。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 71270,
      "end_ms": 71510,
      "text": "嗯，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 72060,
      "end_ms": 72500,
      "text": "来早了，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 72500,
      "end_ms": 73160,
      "text": "叶子没黄，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 73260,
      "end_ms": 73800,
      "text": "来晚了，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 73800,
      "end_ms": 74435,
      "text": "全掉了。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 75190,
      "end_ms": 76390,
      "text": "现实营业的美，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 76650,
      "end_ms": 79805,
      "text": "错过就是一年第九名。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 80120,
      "end_ms": 81745,
      "text": "吉林长白山天池，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 82690,
      "end_ms": 83790,
      "text": "你坐着越野车，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 83810,
      "end_ms": 85185,
      "text": "一路蹒跚上去，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 85560,
      "end_ms": 87335,
      "text": "海拔两千一百八十九米，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 87650,
      "end_ms": 88630,
      "text": "风越来越大，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 88810,
      "end_ms": 90025,
      "text": "温度越来越低。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 90360,
      "end_ms": 93285,
      "text": "你国警外套踩着栈道往上走，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 93580,
      "end_ms": 94700,
      "text": "心里一直在打鼓，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 94700,
      "end_ms": 95705,
      "text": "今天能看到吗？"
    },
    {
      "segment_id": "s000043",
      "start_ms": 96080,
      "end_ms": 99205,
      "text": "因为天池全年有二百多天被云雾笼罩，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 99680,
      "end_ms": 102805,
      "text": "能看到全貌的概率大约只有三成，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 103610,
      "end_ms": 106890,
      "text": "全年能看到清澈湖面的天数只有五十多天。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 107030,
      "end_ms": 109945,
      "text": "你走到观景台边缘往下看。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 110510,
      "end_ms": 111490,
      "text": "如果运气好，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 111670,
      "end_ms": 113095,
      "text": "云雾正好散开，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 113730,
      "end_ms": 117285,
      "text": "一池碧蓝的湖水嵌在十六座山峰中间，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 118110,
      "end_ms": 120905,
      "text": "男的像一块落在火山口里的宝石，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 121360,
      "end_ms": 122800,
      "text": "安静冷冽，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 123080,
      "end_ms": 124225,
      "text": "一言不发。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 125070,
      "end_ms": 125895,
      "text": "你站在那里，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 126220,
      "end_ms": 128180,
      "text": "风从耳边呼啸而过，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 128460,
      "end_ms": 129595,
      "text": "你会忽然明白，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 129860,
      "end_ms": 130300,
      "text": "为什么？"
    },
    {
      "segment_id": "s000057",
      "start_ms": 130300,
      "end_ms": 131040,
      "text": "当地人说，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 131060,
      "end_ms": 132825,
      "text": "不是你选择看天池，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 133290,
      "end_ms": 134030,
      "text": "是天池，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 134070,
      "end_ms": 136580,
      "text": "选择让你看到第八名。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 136800,
      "end_ms": 138275,
      "text": "山西运城盐湖，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 139170,
      "end_ms": 140345,
      "text": "你站在盐湖边，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 140750,
      "end_ms": 143610,
      "text": "夏天的热风从湖面上吹过来，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 143610,
      "end_ms": 146065,
      "text": "空气里有一股淡淡的咸味儿，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 146830,
      "end_ms": 149795,
      "text": "平时这片湖水是普通的青蓝色。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 150090,
      "end_ms": 151910,
      "text": "但每年六到七月，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 152170,
      "end_ms": 154865,
      "text": "湖里的杜氏盐藻大量繁殖，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 155330,
      "end_ms": 158165,
      "text": "湖水从清澈变成绯红色。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 158660,
      "end_ms": 160285,
      "text": "你从空中往下看，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 160940,
      "end_ms": 164950,
      "text": "红蓝绿黄白各种颜色，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 164950,
      "end_ms": 166250,
      "text": "在岩池上交错，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 166530,
      "end_ms": 168685,
      "text": "像一块被打翻的调色盘。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 169410,
      "end_ms": 171405,
      "text": "当地人管这叫限定红装，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 172210,
      "end_ms": 174625,
      "text": "一年只有夏天的两个月能看到，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 175070,
      "end_ms": 179105,
      "text": "错过了就得等明年第七名。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 180650,
      "end_ms": 184630,
      "text": "云南泸沽湖清晨七点，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 184630,
      "end_ms": 187310,
      "text": "你坐着珠草船从岸边出发，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 187830,
      "end_ms": 189950,
      "text": "湖面上飘着一层薄薄的雾，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 190670,
      "end_ms": 195750,
      "text": "摩梭船夫站在船尾一桨一桨的划船慢慢驶尽。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 195770,
      "end_ms": 196230,
      "text": "湖心，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 196470,
      "end_ms": 197550,
      "text": "你低头看水，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 197610,
      "end_ms": 199510,
      "text": "水面上开满了白色的小花，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 199930,
      "end_ms": 201850,
      "text": "花瓣薄的近乎透明，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 202430,
      "end_ms": 204550,
      "text": "黄色的花蕊浮在水面上，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 204910,
      "end_ms": 208130,
      "text": "一朵挨着一朵铺满了整片湖面。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 208870,
      "end_ms": 210770,
      "text": "黄地人叫它水性杨花，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 211130,
      "end_ms": 212590,
      "text": "学名海菜花花，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 213560,
      "end_ms": 216480,
      "text": "只在水质极好的湖里才能生长。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 216840,
      "end_ms": 218260,
      "text": "清晨七点到十点，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 218260,
      "end_ms": 219060,
      "text": "花开最盛，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 219420,
      "end_ms": 221260,
      "text": "船在花海里慢慢走，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 221280,
      "end_ms": 223780,
      "text": "你伸手就能碰到水面上的花瓣，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 224400,
      "end_ms": 226400,
      "text": "凉凉的滑滑的。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 227160,
      "end_ms": 228680,
      "text": "除了水声和桨声，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 229240,
      "end_ms": 231920,
      "text": "四周安静的向世界还没醒。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 232960,
      "end_ms": 233600,
      "text": "第六名，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 234860,
      "end_ms": 236640,
      "text": "浙江钱塘江大潮，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 237180,
      "end_ms": 238860,
      "text": "农历八月十八前后，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 239220,
      "end_ms": 241645,
      "text": "你站在钱塘江边的堤坝上，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 242040,
      "end_ms": 243765,
      "text": "人群挤得满满当当。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 244570,
      "end_ms": 247710,
      "text": "远处江面上一条细细的白线，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 247790,
      "end_ms": 251785,
      "text": "出现那条白线越来越粗越来越近，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 252570,
      "end_ms": 255010,
      "text": "像有人把整条江立起来，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 255170,
      "end_ms": 256125,
      "text": "推着往前走。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 257020,
      "end_ms": 258160,
      "text": "几秒钟之内，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 258640,
      "end_ms": 261640,
      "text": "白线变成一堵数米高的水墙，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 261760,
      "end_ms": 263960,
      "text": "带着轰隆隆的声音碾压过来，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 264300,
      "end_ms": 264980,
      "text": "像打雷，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 265180,
      "end_ms": 266400,
      "text": "像千军万马，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 266700,
      "end_ms": 267780,
      "text": "像大地在吼，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 268120,
      "end_ms": 269740,
      "text": "潮水拍在堤坝上，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 270080,
      "end_ms": 271300,
      "text": "浪花溅起几米，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 271300,
      "end_ms": 273365,
      "text": "高水雾扑面而来。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 274880,
      "end_ms": 276115,
      "text": "你脸上湿了，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 276520,
      "end_ms": 277520,
      "text": "嘴里是咸的，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 277660,
      "end_ms": 279365,
      "text": "整个过程只有几分钟，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 280150,
      "end_ms": 281365,
      "text": "潮水过去了，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 281680,
      "end_ms": 282980,
      "text": "江面恢复平静，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 283420,
      "end_ms": 285360,
      "text": "一年之中只有那几天，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 285360,
      "end_ms": 286785,
      "text": "潮水最大最猛，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 287660,
      "end_ms": 290645,
      "text": "其他时候的钱塘江安静的不像话。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 291830,
      "end_ms": 292390,
      "text": "说到这儿，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 292390,
      "end_ms": 292915,
      "text": "停一下，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 293690,
      "end_ms": 295185,
      "text": "咱们聊了额济娜。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 296430,
      "end_ms": 298510,
      "text": "天池盐湖，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 298910,
      "end_ms": 302890,
      "text": "这些你有没有发现一件事儿？"
    },
    {
      "segment_id": "s000127",
      "start_ms": 302890,
      "end_ms": 304630,
      "text": "这些地方美是美，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 304690,
      "end_ms": 306830,
      "text": "但它们都有一个共同点。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 306970,
      "end_ms": 311250,
      "text": "现实鹅济纳的胡杨只美二十天，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 311290,
      "end_ms": 313630,
      "text": "天池一年只漏五十多天，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 313690,
      "end_ms": 315950,
      "text": "盐湖只在夏天变红。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 315950,
      "end_ms": 318910,
      "text": "泸沽湖的花只开两三个月，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 318930,
      "end_ms": 321310,
      "text": "你刷到视频的时候觉得好美，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 321370,
      "end_ms": 324550,
      "text": "但真要去的时候什么时候去怎么走，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 324550,
      "end_ms": 326170,
      "text": "看什么避什么坑，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 326170,
      "end_ms": 326480,
      "text": "观光，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 326480,
      "end_ms": 329240,
      "text": "靠短视频根本记不住时间差。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 329240,
      "end_ms": 331500,
      "text": "一周你看到的就不是仙境，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 331700,
      "end_ms": 332760,
      "text": "是普通湖泊。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 333140,
      "end_ms": 337240,
      "text": "我手边这本大美中国人一生要去的一百零一个地方，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 337500,
      "end_ms": 339700,
      "text": "它不是简单的仙境罗列。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 340080,
      "end_ms": 345320,
      "text": "这本书涵盖了自然风光、历史、文化、民族风情等多个方面。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 345760,
      "end_ms": 349560,
      "text": "从桂城的巍峨壮丽到黄山的仙境奇观。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 350120,
      "end_ms": 353640,
      "text": "从桂林的山水甲天下到九寨沟的人间奇境，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 354140,
      "end_ms": 359015,
      "text": "详细列举了人生中不可错不过的一百零一个绝美景点，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 359370,
      "end_ms": 363655,
      "text": "每一处都配有精美图片和通俗优美的文字描述。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 364130,
      "end_ms": 367700,
      "text": "翻到哪页就知道那个地方长什么样，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 367820,
      "end_ms": 368580,
      "text": "什么季节去，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 368580,
      "end_ms": 369855,
      "text": "最好有什么故事，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 370610,
      "end_ms": 373210,
      "text": "带着孩子翻翻到哪儿，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 373210,
      "end_ms": 376685,
      "text": "讲到哪告诉他这是咱们中国的湖，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 377480,
      "end_ms": 378905,
      "text": "这是咱们中国的山，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 379620,
      "end_ms": 383115,
      "text": "自己翻翻到哪页就想去哪页。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 383570,
      "end_ms": 384225,
      "text": "书不贵。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 384670,
      "end_ms": 388405,
      "text": "一杯奶茶的钱放在家里是一本中国旅行清单，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 388780,
      "end_ms": 393440,
      "text": "也是一本可以跟孩子一起翻的画册链接放在橱窗了。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 393660,
      "end_ms": 395620,
      "text": "喜欢旅行的朋友入一本放手，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 395620,
      "end_ms": 396725,
      "text": "边做个参考。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 397350,
      "end_ms": 397550,
      "text": "好，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 397550,
      "end_ms": 398225,
      "text": "回到正题，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 399500,
      "end_ms": 401585,
      "text": "接下来第五到第一名里，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 402480,
      "end_ms": 403685,
      "text": "有一个瀑布，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 404050,
      "end_ms": 406430,
      "text": "从悬崖上分成三级砸下来，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 406430,
      "end_ms": 407510,
      "text": "水雾升起的时候，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 407510,
      "end_ms": 410355,
      "text": "整个瀑布会消失在一片白茫茫。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 410940,
      "end_ms": 413355,
      "text": "有一个地方的水律的不像水，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 413640,
      "end_ms": 415015,
      "text": "像液态的翡翠，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 415440,
      "end_ms": 417875,
      "text": "还有一个地方的湖水难道不真实？"
    },
    {
      "segment_id": "s000169",
      "start_ms": 418480,
      "end_ms": 419440,
      "text": "你站在湖边，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 419440,
      "end_ms": 423325,
      "text": "会怀疑自己的眼睛可排在榜首的那个水井。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 423960,
      "end_ms": 426675,
      "text": "你走进去的第一反应不是好美，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 427140,
      "end_ms": 428875,
      "text": "是这地方不应该存在。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 429900,
      "end_ms": 432025,
      "text": "下一集已经同步更新，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 432470,
      "end_ms": 433790,
      "text": "现在直接点开我的头像，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 433810,
      "end_ms": 434515,
      "text": "进入主页，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 435430,
      "end_ms": 436875,
      "text": "第一条视频就是下一集，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 437240,
      "end_ms": 439075,
      "text": "感兴趣的朋友可以关注后续。"
    }
  ],
  "source_transcript_sha256": "9c30699e9b70c59b1588b9fd446d2908c6ab791443afc3893c856db35e297ea0"
}