{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ca16a281f181b54b_u001",
  "video_id": "v_ca16a281f181b54b",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 969.503991,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 310,
      "end_ms": 6530,
      "text": "十六分钟讲解萨特存在与虚无第一卷萨特存在与虚无第一卷虚无的问题是，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 6530,
      "end_ms": 8470,
      "text": "全书最具挑衅性的开篇，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 8590,
      "end_ms": 15810,
      "text": "也是整个存在主义哲学最容易被误读的思想进化虚无虚无就是什么都没有讨论，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 15810,
      "end_ms": 17270,
      "text": "什么都没有有什么意义？"
    },
    {
      "segment_id": "s000005",
      "start_ms": 17550,
      "end_ms": 18710,
      "text": "这句话你听过多少遍？"
    },
    {
      "segment_id": "s000006",
      "start_ms": 18770,
      "end_ms": 19730,
      "text": "分析哲学家说，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 19950,
      "end_ms": 21710,
      "text": "虚无是一个伪概念，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 22190,
      "end_ms": 24370,
      "text": "日常思维说不存在的东西，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 24370,
      "end_ms": 25230,
      "text": "有什么好说的。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 25390,
      "end_ms": 28230,
      "text": "宗教信仰者说虚无是恶的深渊，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 28390,
      "end_ms": 29330,
      "text": "你应该远离他。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 29330,
      "end_ms": 33760,
      "text": "萨侧把枪口对准的正是这个看似不证自明的常识。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 34040,
      "end_ms": 34420,
      "text": "他说，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 34980,
      "end_ms": 37120,
      "text": "虚无根本不是什么都没有，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 37480,
      "end_ms": 39440,
      "text": "虚无是一种真实的力量，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 39800,
      "end_ms": 41900,
      "text": "一种在你每一次说不的时候，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 42140,
      "end_ms": 43820,
      "text": "每一次期待落空的时候，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 43960,
      "end_ms": 46260,
      "text": "每一次意识到自己不是什么的时候，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 46380,
      "end_ms": 48660,
      "text": "就悄悄渗透到世界中来的力量。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 49020,
      "end_ms": 49980,
      "text": "搞懂了这句话，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 50140,
      "end_ms": 55600,
      "text": "你对虚无、否定自欺这些词的盲目恐惧或轻蔑就会开始松动。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 55620,
      "end_ms": 56740,
      "text": "我们前面反复讲过，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 56740,
      "end_ms": 57940,
      "text": "什么是现象学方法，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 58360,
      "end_ms": 60690,
      "text": "现象学方法就是搁置一切预设，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 60810,
      "end_ms": 65420,
      "text": "回到事情本身去看意识如何面对对象如何显现自身。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 65560,
      "end_ms": 68255,
      "text": "萨特用的第一个靶子是传统本体论。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 68850,
      "end_ms": 69830,
      "text": "传统本体论说，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 70050,
      "end_ms": 71465,
      "text": "存在是一切的基础，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 71860,
      "end_ms": 73795,
      "text": "虚无只是存在的缺席。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 74320,
      "end_ms": 75680,
      "text": "这个逻辑听起来无懈可击，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 75820,
      "end_ms": 76155,
      "text": "对吧？"
    },
    {
      "segment_id": "s000032",
      "start_ms": 76510,
      "end_ms": 77090,
      "text": "沙特说，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 77350,
      "end_ms": 80050,
      "text": "他的致命错误在于传统本体论，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 80050,
      "end_ms": 82610,
      "text": "把虚无当成了一个被动的派，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 82650,
      "end_ms": 83490,
      "text": "生性的无。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 83670,
      "end_ms": 87230,
      "text": "你想想说一个杯子不在这里和说一张桌子，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 87230,
      "end_ms": 89035,
      "text": "不是鸟是一回事吗？"
    },
    {
      "segment_id": "s000038",
      "start_ms": 89240,
      "end_ms": 89845,
      "text": "当然不是。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 90260,
      "end_ms": 93335,
      "text": "一个杯子的不在这里是一种真实的体验。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 93810,
      "end_ms": 95295,
      "text": "你去咖啡馆找皮埃尔，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 95630,
      "end_ms": 98045,
      "text": "满眼都是桌子、椅子、杯子和人。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 98390,
      "end_ms": 99885,
      "text": "但皮埃尔不在这里，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 100340,
      "end_ms": 105210,
      "text": "整个咖啡馆被一种不在场笼罩着咖啡馆的色彩、声响，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 105390,
      "end_ms": 108640,
      "text": "光线都因这个不在场而被重新着色。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 108760,
      "end_ms": 114685,
      "text": "萨特在存在与虚无第一卷第一章中用了大量篇幅来描述这个著名的咖啡馆例子。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 114960,
      "end_ms": 116235,
      "text": "他期待看见皮埃尔，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 116420,
      "end_ms": 117445,
      "text": "结果PL不在。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 117770,
      "end_ms": 118330,
      "text": "萨特说，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 118670,
      "end_ms": 122525,
      "text": "皮埃尔的不在场不是通过否定判断进入事物之中的。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 122800,
      "end_ms": 123525,
      "text": "恰恰相反，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 123880,
      "end_ms": 127455,
      "text": "正是否定判断受到非存在的制约和支持。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 127860,
      "end_ms": 132485,
      "text": "我的期待使得皮埃尔的不在场成为与这座咖啡馆相关的实在事件。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 132700,
      "end_ms": 135375,
      "text": "现在我发现了这种不在场是一个客观事实。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 135780,
      "end_ms": 135940,
      "text": "当然，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 135940,
      "end_ms": 136660,
      "text": "我们也可以说，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 136800,
      "end_ms": 138720,
      "text": "任何一个不相干的人不在咖啡馆，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 138860,
      "end_ms": 140285,
      "text": "但这只有抽象的意义，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 140540,
      "end_ms": 142580,
      "text": "只是纯粹运用了否定的原则，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 142660,
      "end_ms": 144595,
      "text": "而无实在和有效的基础。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 145060,
      "end_ms": 145945,
      "text": "你听明白了吗？"
    },
    {
      "segment_id": "s000061",
      "start_ms": 146660,
      "end_ms": 148400,
      "text": "虚无不是判断的产物。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 148560,
      "end_ms": 151140,
      "text": "虚无是被体验到的非存在，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 151140,
      "end_ms": 155635,
      "text": "永远在我们心中和在我们之外在场虚无纠缠着存在，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 155910,
      "end_ms": 158225,
      "text": "这是我们能够说出不的必要条件。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 158480,
      "end_ms": 160525,
      "text": "第二个叫否定的起源。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 161150,
      "end_ms": 163030,
      "text": "萨特在第一章否定的起源中，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 163110,
      "end_ms": 164330,
      "text": "从拷问开始，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 164450,
      "end_ms": 165270,
      "text": "一步步推进。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 165350,
      "end_ms": 166135,
      "text": "什么是拷问？"
    },
    {
      "segment_id": "s000070",
      "start_ms": 166710,
      "end_ms": 167690,
      "text": "你向世界提问，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 167770,
      "end_ms": 168755,
      "text": "你期待一个答案，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 169000,
      "end_ms": 170080,
      "text": "但答案还没有来，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 170360,
      "end_ms": 171260,
      "text": "这个还没有来，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 171780,
      "end_ms": 172915,
      "text": "就是一种虚无。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 173730,
      "end_ms": 174990,
      "text": "你等待朋友来赴约，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 175290,
      "end_ms": 176590,
      "text": "四点到了他没来。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 176770,
      "end_ms": 177735,
      "text": "你环顾大厅，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 178080,
      "end_ms": 179540,
      "text": "每一张桌子都坐着人，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 179680,
      "end_ms": 181085,
      "text": "唯独那张桌子空着，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 181530,
      "end_ms": 182670,
      "text": "那张空着的桌子，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 182710,
      "end_ms": 184845,
      "text": "恰恰是被你的期待点亮的，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 185240,
      "end_ms": 186140,
      "text": "没有你的期待，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 186260,
      "end_ms": 187625,
      "text": "他不过是又一张桌子。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 187840,
      "end_ms": 188440,
      "text": "萨特说，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 188860,
      "end_ms": 191735,
      "text": "人是使虚无来到世界上的存在，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 192080,
      "end_ms": 192880,
      "text": "这句话什么意思？"
    },
    {
      "segment_id": "s000087",
      "start_ms": 192880,
      "end_ms": 193395,
      "text": "你想想，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 193690,
      "end_ms": 197005,
      "text": "一块石头不会期待什么一棵树不会失望，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 197330,
      "end_ms": 199170,
      "text": "一只猫不会因为明天还没到。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 199170,
      "end_ms": 199945,
      "text": "而焦虑，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 200340,
      "end_ms": 203915,
      "text": "只有人总是在上位和不在之间活着。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 204400,
      "end_ms": 205220,
      "text": "你回顾过去，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 205480,
      "end_ms": 206360,
      "text": "你展望未来，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 206680,
      "end_ms": 209320,
      "text": "你在每一个当下都同时携带着，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 209380,
      "end_ms": 211960,
      "text": "已经不是的过去和还不是的。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 211960,
      "end_ms": 215230,
      "text": "未来这种不适的结构就是虚无。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 215370,
      "end_ms": 216310,
      "text": "帕特进一步说，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 216590,
      "end_ms": 219535,
      "text": "这种虚无不是从外面强加给意识的，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 219910,
      "end_ms": 222465,
      "text": "虚无是意识的本体论结构，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 223210,
      "end_ms": 225475,
      "text": "自为的存在是其所不适，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 225810,
      "end_ms": 227195,
      "text": "又不是其琐事。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 227740,
      "end_ms": 229375,
      "text": "你跟你的过去的关系是什么？"
    },
    {
      "segment_id": "s000103",
      "start_ms": 229820,
      "end_ms": 231195,
      "text": "你不是你的过去，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 231640,
      "end_ms": 233460,
      "text": "因为如果你完全等同于过去，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 233580,
      "end_ms": 235275,
      "text": "你就没有任何变化的可能了。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 235490,
      "end_ms": 236845,
      "text": "你跟你的未来是什么关系？"
    },
    {
      "segment_id": "s000107",
      "start_ms": 237250,
      "end_ms": 238725,
      "text": "你还不是你的未来。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 239140,
      "end_ms": 242035,
      "text": "因为如果未来已经是你那就不需要去选择了。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 242510,
      "end_ms": 245455,
      "text": "所以人就是这样一种奇特的存在，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 245870,
      "end_ms": 248915,
      "text": "他永远不能安安静静的试一个东西，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 249310,
      "end_ms": 251155,
      "text": "逝者不能是逝者。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 251560,
      "end_ms": 254745,
      "text": "如果说逝者把自己完全等同于逝者这个角色，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 255000,
      "end_ms": 256980,
      "text": "他的每一个动作都精确到位，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 257060,
      "end_ms": 258875,
      "text": "每一个微笑都恰到好处，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 259130,
      "end_ms": 261485,
      "text": "每一个步伐都过分快了一点点。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 261800,
      "end_ms": 262480,
      "text": "那萨特说，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 262740,
      "end_ms": 263820,
      "text": "他就是在自欺，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 263980,
      "end_ms": 264875,
      "text": "你可能会笑。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 265400,
      "end_ms": 266365,
      "text": "但想想你自己，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 266960,
      "end_ms": 270420,
      "text": "你有没有在某个时刻把自己完全等同于你的职业，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 270620,
      "end_ms": 272585,
      "text": "你的身份、你的社交角色，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 273080,
      "end_ms": 273840,
      "text": "然后忘了，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 273840,
      "end_ms": 275300,
      "text": "你本来可以不是这些。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 275400,
      "end_ms": 276075,
      "text": "萨特说，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 276430,
      "end_ms": 278815,
      "text": "超越性是意识的构造性结构，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 279250,
      "end_ms": 283150,
      "text": "意识生来就支撑在一个并非意识自身的存在之上。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 283210,
      "end_ms": 284390,
      "text": "当面对一个对象时，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 284650,
      "end_ms": 287305,
      "text": "意识不得不将自身确立为不是对象，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 287660,
      "end_ms": 290425,
      "text": "这意味着超越性是意识的内在结构，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 290750,
      "end_ms": 293750,
      "text": "意识必须不是他的对象才能意识到对象。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 293830,
      "end_ms": 297455,
      "text": "第三个叫虚无的辩证法概念与现象学概念。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 298000,
      "end_ms": 301020,
      "text": "萨特在第一章中并列讨论了两种虚无概念。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 301180,
      "end_ms": 303365,
      "text": "辩证法的虚无以黑格尔为代表，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 303690,
      "end_ms": 305850,
      "text": "认为存在与虚无是对立的两极，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 306110,
      "end_ms": 306910,
      "text": "相互转化，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 306990,
      "end_ms": 307865,
      "text": "相互扬气。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 308190,
      "end_ms": 308715,
      "text": "沙特说。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 309090,
      "end_ms": 312950,
      "text": "这个框架的错误在于把虚无和存在当成了逻辑上。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 312950,
      "end_ms": 314030,
      "text": "同时代的东西。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 314170,
      "end_ms": 314830,
      "text": "黑格尔说，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 314990,
      "end_ms": 317310,
      "text": "纯存在和纯虚无是一回事，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 317610,
      "end_ms": 319830,
      "text": "因为他们都是无规定的直接性。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 320030,
      "end_ms": 320730,
      "text": "但萨特说，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 321070,
      "end_ms": 322830,
      "text": "如果虚无需要存在，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 322830,
      "end_ms": 324430,
      "text": "作为他的对偶才能存在，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 324670,
      "end_ms": 327370,
      "text": "那他就仍然寄生在存在的框架里。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 327390,
      "end_ms": 332330,
      "text": "萨特要做的是把虚无从存在的逻辑对立面中解放出来，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 332470,
      "end_ms": 335030,
      "text": "变成一种现象学上可体验的东西。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 335290,
      "end_ms": 337430,
      "text": "他在虚无的现象学概念一节里说，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 337910,
      "end_ms": 340440,
      "text": "虚空的意向是一种否定的意识，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 340820,
      "end_ms": 345360,
      "text": "它超越自身而趋向被设定为不在场或非实体的对象。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 345360,
      "end_ms": 348760,
      "text": "不论是我预期钱包里有一千五百法郎的非存在，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 348960,
      "end_ms": 350440,
      "text": "还是皮埃尔的不在场。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 350520,
      "end_ms": 353100,
      "text": "首先都是人的一种浅反思的存在，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 353100,
      "end_ms": 356120,
      "text": "体验是意识对对象的一种直接体验，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 356300,
      "end_ms": 357920,
      "text": "是一种对虚无的体验。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 358180,
      "end_ms": 363420,
      "text": "这种体验产生的根源就在于意识在浅反思的层面上总是与自身有间隔的，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 363520,
      "end_ms": 366320,
      "text": "它视其所不是不视其所示的，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 366320,
      "end_ms": 369815,
      "text": "自身逃逸的结构成为了否定的永恒源泉。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 370350,
      "end_ms": 372430,
      "text": "这是人的自由的最根本来源，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 372430,
      "end_ms": 376830,
      "text": "也是人通过虚无化行为创造一切可能的本体论基础。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 376850,
      "end_ms": 378905,
      "text": "纳特说了一句极其漂亮的话，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 379370,
      "end_ms": 381755,
      "text": "虚无使世界形貌纷纭，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 382100,
      "end_ms": 383380,
      "text": "使事物丰富多彩。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 383440,
      "end_ms": 387155,
      "text": "你听着可能觉得矛盾虚无怎么会使世界丰富多彩？"
    },
    {
      "segment_id": "s000166",
      "start_ms": 387550,
      "end_ms": 388065,
      "text": "想想看，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 388390,
      "end_ms": 389550,
      "text": "如果你生活的世界里，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 389550,
      "end_ms": 390855,
      "text": "一切都已经被决定了，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 391140,
      "end_ms": 392580,
      "text": "一切都已经是了。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 392660,
      "end_ms": 394060,
      "text": "没有不是的可能性，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 394140,
      "end_ms": 395360,
      "text": "没有上位的空间，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 395620,
      "end_ms": 397315,
      "text": "那这个世界就是一潭死水。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 397740,
      "end_ms": 398800,
      "text": "正因为有虚无，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 399120,
      "end_ms": 404615,
      "text": "你才能在咖啡馆里感受到皮埃尔不在而带来的那一整片颜色和光线的改变。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 404890,
      "end_ms": 405990,
      "text": "正因为有虚无，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 406210,
      "end_ms": 408355,
      "text": "你才能看到希望、遗憾，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 408700,
      "end_ms": 409705,
      "text": "期待焦虑。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 410030,
      "end_ms": 415530,
      "text": "这些情绪全都是还没有发生或已经不可能发生的东西在你身上留下的印记。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 415590,
      "end_ms": 417510,
      "text": "第四个叫虚无的起源，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 417870,
      "end_ms": 419710,
      "text": "这是第一卷第一章的压轴一节。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 419810,
      "end_ms": 420395,
      "text": "萨特问，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 420840,
      "end_ms": 422085,
      "text": "虚无从哪儿来？"
    },
    {
      "segment_id": "s000183",
      "start_ms": 422590,
      "end_ms": 426470,
      "text": "如果虚无不是从存在中派生出来的那他从哪里来？"
    },
    {
      "segment_id": "s000184",
      "start_ms": 426570,
      "end_ms": 427530,
      "text": "萨特的回答是，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 427770,
      "end_ms": 430980,
      "text": "虚无来自人人在拷问中，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 431040,
      "end_ms": 432720,
      "text": "把自己投入到虚无之中。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 432920,
      "end_ms": 433645,
      "text": "萨特说，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 434040,
      "end_ms": 436765,
      "text": "人是使虚无来到世界上的存在。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 437130,
      "end_ms": 438635,
      "text": "这句话听起来像是一句诗，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 439080,
      "end_ms": 441015,
      "text": "但他有严格的本体论含义。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 441270,
      "end_ms": 446855,
      "text": "一块石头不会烤问一棵树不会期待一只猫不会因为明天的死亡而焦虑。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 447480,
      "end_ms": 451345,
      "text": "只有人能够把不是和上尉带到世界中。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 451750,
      "end_ms": 453075,
      "text": "你问这是不是真的，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 453310,
      "end_ms": 455525,
      "text": "你就已经预设了假的可能性，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 456020,
      "end_ms": 457785,
      "text": "你问他是不是来了，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 458070,
      "end_ms": 460445,
      "text": "你就已经预设了没来的可能性。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 460780,
      "end_ms": 463495,
      "text": "拷问本身就是一种虚无化的活动。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 463970,
      "end_ms": 466560,
      "text": "沙特还分析了毁坏一场地震，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 466560,
      "end_ms": 467675,
      "text": "摧毁了一座城市。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 468010,
      "end_ms": 468990,
      "text": "从本体论上看，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 469190,
      "end_ms": 471495,
      "text": "这不过是一些存在物的重新分布，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 471810,
      "end_ms": 472865,
      "text": "没有什么减少了。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 473140,
      "end_ms": 477855,
      "text": "只有另一种东西是人类意识把这种重新分布命名为毁坏，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 478200,
      "end_ms": 481005,
      "text": "把重新分布后的状态体验为缺失，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 481550,
      "end_ms": 482450,
      "text": "没有人的世界，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 482470,
      "end_ms": 483295,
      "text": "没有废墟。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 483980,
      "end_ms": 486760,
      "text": "第五个叫自欺第一卷，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 486760,
      "end_ms": 490865,
      "text": "第二章字七是整个第一卷最让读者不寒而栗的一章。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 491280,
      "end_ms": 494055,
      "text": "萨特在这一章里区分了自欺和说谎。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 494540,
      "end_ms": 497210,
      "text": "说谎是什么说谎者知道真相，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 497410,
      "end_ms": 498965,
      "text": "但向别人隐瞒真相。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 499340,
      "end_ms": 500375,
      "text": "自欺是什么？"
    },
    {
      "segment_id": "s000213",
      "start_ms": 500890,
      "end_ms": 503470,
      "text": "自欺是你向自己隐瞒真相。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 503750,
      "end_ms": 505470,
      "text": "萨特举了著名的逝者例子，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 505570,
      "end_ms": 506330,
      "text": "一个咖啡馆，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 506330,
      "end_ms": 507550,
      "text": "逝者动作太快，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 507590,
      "end_ms": 508835,
      "text": "太精确、太热情，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 509080,
      "end_ms": 510600,
      "text": "他的每个动作都在告诉自己，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 510600,
      "end_ms": 511600,
      "text": "我是一个逝者。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 511660,
      "end_ms": 512180,
      "text": "巴特说，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 512620,
      "end_ms": 514100,
      "text": "问题不在于他做逝者。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 514100,
      "end_ms": 515820,
      "text": "这份工作问题在于，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 515820,
      "end_ms": 518815,
      "text": "他把逝者这个角色当成了自己的本质。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 519150,
      "end_ms": 521275,
      "text": "他假装自己不能不是逝者，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 521650,
      "end_ms": 523975,
      "text": "假装自己被这个身份牢牢锁住了，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 524320,
      "end_ms": 525500,
      "text": "这就是子欺人，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 525500,
      "end_ms": 527445,
      "text": "主动逃避自由选择的焦虑，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 527750,
      "end_ms": 530230,
      "text": "顺从社会家庭预设的人生剧本，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 530390,
      "end_ms": 533785,
      "text": "把自己活成一套可复制、可量化的标准程序。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 534140,
      "end_ms": 535535,
      "text": "萨特还举了另一个例子，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 535880,
      "end_ms": 537205,
      "text": "一个被引诱的女性，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 537780,
      "end_ms": 538835,
      "text": "他坐在男人对面，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 539260,
      "end_ms": 540980,
      "text": "男人的手已经搭上了他的手，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 541140,
      "end_ms": 541960,
      "text": "他不想拒绝，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 542080,
      "end_ms": 544220,
      "text": "但他也不想面对自己欲望的责任，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 544300,
      "end_ms": 546445,
      "text": "于是他放任自己的手留在那里，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 546750,
      "end_ms": 548295,
      "text": "仿佛那只手不是他的手，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 548560,
      "end_ms": 549940,
      "text": "仿佛他不知道发生了什么。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 549940,
      "end_ms": 550645,
      "text": "巴特说，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 550990,
      "end_ms": 553585,
      "text": "他把自己的身体当成了一个自带的物，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 553940,
      "end_ms": 554920,
      "text": "一个没有意识，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 554980,
      "end_ms": 556135,
      "text": "没有选择的物，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 556370,
      "end_ms": 557965,
      "text": "这就是自吸的核心结构。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 558390,
      "end_ms": 560285,
      "text": "人假装自己是一样东西，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 560640,
      "end_ms": 562185,
      "text": "假装自己没有选择，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 562560,
      "end_ms": 564660,
      "text": "假装自己是某个固定的东西，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 564800,
      "end_ms": 565260,
      "text": "自欺。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 565280,
      "end_ms": 565680,
      "text": "为什么？"
    },
    {
      "segment_id": "s000249",
      "start_ms": 565680,
      "end_ms": 569955,
      "text": "可能因为人本来就是一种既是又不是的存在。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 570400,
      "end_ms": 571740,
      "text": "如果人完全是一个物，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 571900,
      "end_ms": 572975,
      "text": "他不需要自欺。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 573460,
      "end_ms": 575015,
      "text": "如果人完全是一个自由，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 575280,
      "end_ms": 576455,
      "text": "他也无法自弃，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 577020,
      "end_ms": 580075,
      "text": "恰恰因为人同时拥有事实性和超越性。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 580480,
      "end_ms": 582340,
      "text": "你有一个身体一段历史，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 582560,
      "end_ms": 583455,
      "text": "一个处境，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 583750,
      "end_ms": 585555,
      "text": "但你又永远不限于这些，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 585940,
      "end_ms": 587285,
      "text": "你才有自欺的空间。"
    },
    {
      "segment_id": "s000259",
      "start_ms": 587540,
      "end_ms": 588105,
      "text": "萨特说，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 588520,
      "end_ms": 592065,
      "text": "自欺永远摇摆于真诚和犬儒主义之间。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 592550,
      "end_ms": 595175,
      "text": "你既不能完全真诚的是一个东西，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 595440,
      "end_ms": 596975,
      "text": "因为那等于放弃了自由。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 597360,
      "end_ms": 599620,
      "text": "你也不能完全拒绝一切身份，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 599900,
      "end_ms": 602120,
      "text": "因为那等于放弃了事实性自欺，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 602400,
      "end_ms": 605700,
      "text": "就是在这两者之间的暧昧地带里逃避选择。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 605840,
      "end_ms": 607020,
      "text": "第六个叫焦虑。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 607220,
      "end_ms": 610835,
      "text": "第一卷第一章对虚无的分析直接导向了焦虑的问题。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 611440,
      "end_ms": 612200,
      "text": "什么是焦虑？"
    },
    {
      "segment_id": "s000269",
      "start_ms": 612360,
      "end_ms": 612955,
      "text": "萨特说。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 613410,
      "end_ms": 614730,
      "text": "焦虑不是恐惧，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 614910,
      "end_ms": 617430,
      "text": "恐惧是对某个具体的东西的恐惧。"
    },
    {
      "segment_id": "s000272",
      "start_ms": 617690,
      "end_ms": 618870,
      "text": "你怕一只狗咬你，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 619150,
      "end_ms": 620310,
      "text": "你怕考试不及格，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 620690,
      "end_ms": 622930,
      "text": "你怕飞机失事焦虑呢？"
    },
    {
      "segment_id": "s000275",
      "start_ms": 623510,
      "end_ms": 625870,
      "text": "焦虑是对自己的自由的意识。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 626290,
      "end_ms": 628210,
      "text": "你走在一条没有护栏的山路上，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 628290,
      "end_ms": 629390,
      "text": "你怕自己掉下去，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 629570,
      "end_ms": 630290,
      "text": "这是恐惧。"
    },
    {
      "segment_id": "s000279",
      "start_ms": 630530,
      "end_ms": 631670,
      "text": "但你同时意识到，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 631750,
      "end_ms": 633170,
      "text": "我完全可以跳下去，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 633690,
      "end_ms": 636710,
      "text": "这个完全可以跳下去的意识就是焦虑。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 637170,
      "end_ms": 638790,
      "text": "焦虑既是对自由的把握，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 638890,
      "end_ms": 640230,
      "text": "也是对虚无的把握。"
    },
    {
      "segment_id": "s000284",
      "start_ms": 640230,
      "end_ms": 641790,
      "text": "你在面对一个选择的时候，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 641850,
      "end_ms": 644040,
      "text": "焦虑的是这个选则是我的，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 644320,
      "end_ms": 645760,
      "text": "没有任何人能替我选，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 646160,
      "end_ms": 647800,
      "text": "没有任何东西能保证我选。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 647800,
      "end_ms": 649480,
      "text": "对自由意识的原始结构，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 649620,
      "end_ms": 653120,
      "text": "恰是在焦虑中得到揭示的焦虑不可消除，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 653380,
      "end_ms": 654200,
      "text": "只能逃避，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 654400,
      "end_ms": 655400,
      "text": "从而走向自欺，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 655940,
      "end_ms": 657620,
      "text": "背离自由的存在处境。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 657860,
      "end_ms": 658100,
      "text": "好，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 658280,
      "end_ms": 665880,
      "text": "现在我们把这六个层面连起来否定的起源、虚无的现象学概念、虚无的起源、自欺焦虑，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 666100,
      "end_ms": 669520,
      "text": "以及贯穿其中的自在与自为的本体论区分。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 669720,
      "end_ms": 671800,
      "text": "他们分别揭示了虚无的来源，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 672100,
      "end_ms": 675090,
      "text": "虚无的体验方式是虚无与自由的关系，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 675310,
      "end_ms": 677630,
      "text": "以及人如何逃避虚无的真相。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 677630,
      "end_ms": 678435,
      "text": "你发现没有？"
    },
    {
      "segment_id": "s000300",
      "start_ms": 678780,
      "end_ms": 683525,
      "text": "这六样东西几乎涵盖了萨特第一卷虚无的问题的全部论证链条。"
    },
    {
      "segment_id": "s000301",
      "start_ms": 684080,
      "end_ms": 685840,
      "text": "而萨特这一卷就是要告诉你，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 685840,
      "end_ms": 689315,
      "text": "朋友别以为虚无是一个空洞的哲学概念，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 689790,
      "end_ms": 691610,
      "text": "它是一种你每天都在经历的。"
    },
    {
      "segment_id": "s000304",
      "start_ms": 691610,
      "end_ms": 693530,
      "text": "实在你以为你活得很实在，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 693530,
      "end_ms": 694170,
      "text": "很充实，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 694190,
      "end_ms": 694915,
      "text": "很有目标。"
    },
    {
      "segment_id": "s000307",
      "start_ms": 695280,
      "end_ms": 695920,
      "text": "但萨特说，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 696180,
      "end_ms": 698700,
      "text": "你恰恰在用充实来逃避焦虑。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 698760,
      "end_ms": 703495,
      "text": "你越是把自己填满填满日程、填满社交、填满身份标签儿，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 703720,
      "end_ms": 705885,
      "text": "你越是在逃避那个根本的事实，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 706260,
      "end_ms": 707875,
      "text": "你是一种不适的存在，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 708240,
      "end_ms": 711055,
      "text": "你永远不能安安静静的是任何东西。"
    },
    {
      "segment_id": "s000313",
      "start_ms": 711770,
      "end_ms": 712885,
      "text": "沙特说的很清楚，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 713260,
      "end_ms": 715405,
      "text": "人的存在先于人的本质。"
    },
    {
      "segment_id": "s000315",
      "start_ms": 715680,
      "end_ms": 716920,
      "text": "你不是先有一个本质，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 716920,
      "end_ms": 717685,
      "text": "然后去活，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 718030,
      "end_ms": 719015,
      "text": "你是先活着，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 719310,
      "end_ms": 721505,
      "text": "然后在每一个选择中定义自己。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 722160,
      "end_ms": 723995,
      "text": "这意味着你没有任何借口，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 724430,
      "end_ms": 728840,
      "text": "你的懦弱、你的懒惰、你的从众都不是你的本质决定的，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 728960,
      "end_ms": 730375,
      "text": "而是你选择的。"
    },
    {
      "segment_id": "s000322",
      "start_ms": 730960,
      "end_ms": 732320,
      "text": "你选择不选择，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 732540,
      "end_ms": 733685,
      "text": "你也是在选择。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 734160,
      "end_ms": 735970,
      "text": "你可能会说照这么说，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 736150,
      "end_ms": 737705,
      "text": "那我们还能不能讨论自由了？"
    },
    {
      "segment_id": "s000326",
      "start_ms": 738230,
      "end_ms": 740665,
      "text": "这不成了让人陷入无限焦虑的深渊吗？"
    },
    {
      "segment_id": "s000327",
      "start_ms": 741230,
      "end_ms": 741485,
      "text": "错，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 741910,
      "end_ms": 743015,
      "text": "大错特错。"
    },
    {
      "segment_id": "s000329",
      "start_ms": 743470,
      "end_ms": 747495,
      "text": "这恰恰是让你看清真相之后重新获得自由的起点。"
    },
    {
      "segment_id": "s000330",
      "start_ms": 748120,
      "end_ms": 750505,
      "text": "萨特不是让你放弃对确定性的追求，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 750770,
      "end_ms": 753895,
      "text": "不是让你变成一个怀疑一切拒绝一切承诺的人。"
    },
    {
      "segment_id": "s000332",
      "start_ms": 754150,
      "end_ms": 755190,
      "text": "他恰恰是告诉你，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 755410,
      "end_ms": 756430,
      "text": "因为我是自由的，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 756430,
      "end_ms": 757965,
      "text": "这个事实自带重量，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 758300,
      "end_ms": 760440,
      "text": "所以你更应该直面他承担。"
    },
    {
      "segment_id": "s000336",
      "start_ms": 760440,
      "end_ms": 762450,
      "text": "他在每一次逃避的时候，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 762450,
      "end_ms": 763370,
      "text": "停下来问一句，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 763590,
      "end_ms": 764965,
      "text": "我是在做选择，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 765480,
      "end_ms": 767640,
      "text": "还是在假装自己没有选择？"
    },
    {
      "segment_id": "s000340",
      "start_ms": 767640,
      "end_ms": 770205,
      "text": "这就是萨特说的自欺的真正含义。"
    },
    {
      "segment_id": "s000341",
      "start_ms": 770580,
      "end_ms": 776295,
      "text": "当你能以一个审视者的眼光看待你每一个我不得不和我没办法的时刻时，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 776610,
      "end_ms": 778285,
      "text": "你会发现你自由了，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 778530,
      "end_ms": 779950,
      "text": "不再被这是我的性格，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 779970,
      "end_ms": 780650,
      "text": "这是我的命。"
    },
    {
      "segment_id": "s000345",
      "start_ms": 780850,
      "end_ms": 782970,
      "text": "这是社会要求这些说法吓住了。"
    },
    {
      "segment_id": "s000346",
      "start_ms": 782990,
      "end_ms": 784690,
      "text": "因为你知道这些说法的本质，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 784930,
      "end_ms": 787295,
      "text": "就是把自为伪装成自在，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 787620,
      "end_ms": 789320,
      "text": "就是把自由伪装成物，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 789380,
      "end_ms": 790805,
      "text": "你也不再害怕焦虑了。"
    },
    {
      "segment_id": "s000350",
      "start_ms": 791040,
      "end_ms": 793325,
      "text": "因为你知道焦虑恰恰是你自由的证据。"
    },
    {
      "segment_id": "s000351",
      "start_ms": 793670,
      "end_ms": 795415,
      "text": "如果一件事真的无法选择，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 795760,
      "end_ms": 796655,
      "text": "你就不会焦虑，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 796870,
      "end_ms": 797705,
      "text": "你只会恐惧。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 798060,
      "end_ms": 799895,
      "text": "焦虑是自由的眩晕，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 800440,
      "end_ms": 801820,
      "text": "这才是虚无的问题。"
    },
    {
      "segment_id": "s000356",
      "start_ms": 801820,
      "end_ms": 803185,
      "text": "这一卷真正的力量，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 803420,
      "end_ms": 805015,
      "text": "他不是让你陷入虚无主义，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 805200,
      "end_ms": 807040,
      "text": "不是让你觉得一切都没有意义，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 807060,
      "end_ms": 809460,
      "text": "而是让你在每一个被这就是现实。"
    },
    {
      "segment_id": "s000360",
      "start_ms": 809520,
      "end_ms": 811640,
      "text": "你改变不了人都是这样的说法，"
    },
    {
      "segment_id": "s000361",
      "start_ms": 811640,
      "end_ms": 813725,
      "text": "压住的时候保持清醒。"
    },
    {
      "segment_id": "s000362",
      "start_ms": 814160,
      "end_ms": 818480,
      "text": "因为只有当你不再被那些貌似理所当然的本质吓住的时候，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 818620,
      "end_ms": 821460,
      "text": "你才能真正的用自己的判断力去思考，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 821740,
      "end_ms": 822340,
      "text": "去说话，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 822560,
      "end_ms": 823240,
      "text": "去行动。"
    },
    {
      "segment_id": "s000366",
      "start_ms": 823420,
      "end_ms": 824915,
      "text": "这才是真正的自由，"
    },
    {
      "segment_id": "s000367",
      "start_ms": 825520,
      "end_ms": 826240,
      "text": "活得清醒，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 826520,
      "end_ms": 827275,
      "text": "活得明白，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 827670,
      "end_ms": 828790,
      "text": "活的不再被人用。"
    },
    {
      "segment_id": "s000370",
      "start_ms": 828950,
      "end_ms": 830270,
      "text": "你的本质就是这样。"
    },
    {
      "segment_id": "s000371",
      "start_ms": 830270,
      "end_ms": 831510,
      "text": "这句话牵着鼻子走，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 831690,
      "end_ms": 834125,
      "text": "萨特这一卷给我的启发实在太大了。"
    },
    {
      "segment_id": "s000373",
      "start_ms": 834380,
      "end_ms": 835600,
      "text": "之前讲恶心的时候，"
    },
    {
      "segment_id": "s000374",
      "start_ms": 835600,
      "end_ms": 837040,
      "text": "很多朋友说很有收获。"
    },
    {
      "segment_id": "s000375",
      "start_ms": 837360,
      "end_ms": 838100,
      "text": "但说实话，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 838320,
      "end_ms": 840540,
      "text": "那部小说讲的是体验层面的东西，"
    },
    {
      "segment_id": "s000377",
      "start_ms": 840680,
      "end_ms": 843820,
      "text": "是在揭露世界如何以荒诞的面目向意识显现。"
    },
    {
      "segment_id": "s000378",
      "start_ms": 844080,
      "end_ms": 845675,
      "text": "到了存在与虚无第一卷，"
    }
  ],
  "source_transcript_sha256": "0c273ed29451264c9ccac56e10d20b298b334977cb105180fd4fb239bdc10b7e"
}