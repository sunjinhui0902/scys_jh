{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_fe586626fea2b1e4_u001",
  "video_id": "v_fe586626fea2b1e4",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 377.278005,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 3210,
      "text": "您知道我国最动人的十大秋水秘境在哪吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4110,
      "end_ms": 5710,
      "text": "有人提名九寨沟，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6370,
      "end_ms": 8290,
      "text": "有人想到抚仙湖，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9150,
      "end_ms": 10830,
      "text": "对不住抚仙湖，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 10830,
      "end_ms": 12890,
      "text": "这类寻常环湖湖泊，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12950,
      "end_ms": 17330,
      "text": "排不进前五就连九寨沟也不是榜首。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 18050,
      "end_ms": 20190,
      "text": "真正排在榜首的那一处。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 20850,
      "end_ms": 22050,
      "text": "雪山环抱，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 22270,
      "end_ms": 22770,
      "text": "白桦，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 22870,
      "end_ms": 26550,
      "text": "环湖一汪湖水随光影变幻，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 26550,
      "end_ms": 31060,
      "text": "蓝绿一年只有十几天的黄山黄金秋色。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 31540,
      "end_ms": 33460,
      "text": "晨雾漫过水面的时候，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 33860,
      "end_ms": 37280,
      "text": "您说这是不是秋天留给人间的一汪温柔？"
    },
    {
      "segment_id": "s000014",
      "start_ms": 37420,
      "end_ms": 37820,
      "text": "今天，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 37980,
      "end_ms": 41240,
      "text": "咱们就来盘点中国十大秋水秘境，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 42120,
      "end_ms": 45900,
      "text": "倒着数从第十名一路讲到第一名。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 46800,
      "end_ms": 49320,
      "text": "老规矩开讲前，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 49340,
      "end_ms": 52240,
      "text": "劳烦各位老友顺手点亮红心。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 52700,
      "end_ms": 59225,
      "text": "评论区打个来了让我看看今天又有多少知音来捧场。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 60080,
      "end_ms": 60780,
      "text": "第十名，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 61020,
      "end_ms": 62020,
      "text": "江西庐山，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 62160,
      "end_ms": 62840,
      "text": "如情湖，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 63140,
      "end_ms": 64075,
      "text": "您没听错，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 64770,
      "end_ms": 67805,
      "text": "如情湖放在第十庐山，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 68140,
      "end_ms": 74165,
      "text": "韩铁岭镇上的一汪平湖形状像一把握在山间的古琴。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 74940,
      "end_ms": 75935,
      "text": "每到十月，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 76710,
      "end_ms": 80434,
      "text": "环湖的枫树乌气慢慢染成红黄色，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 81130,
      "end_ms": 83235,
      "text": "环湖步道平缓好走，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 83690,
      "end_ms": 84815,
      "text": "不用爬陡坡，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 85130,
      "end_ms": 86745,
      "text": "慢慢散步很舒心。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 87670,
      "end_ms": 88450,
      "text": "可您知道，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 88570,
      "end_ms": 91085,
      "text": "如情湖为什么只排第十吗？"
    },
    {
      "segment_id": "s000033",
      "start_ms": 92030,
      "end_ms": 92805,
      "text": "名气大，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 93290,
      "end_ms": 94035,
      "text": "游客多，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 94580,
      "end_ms": 97155,
      "text": "湖边想安安静静待一会儿，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 97410,
      "end_ms": 99035,
      "text": "耳边常常人声不断。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 99910,
      "end_ms": 100890,
      "text": "但话说回来，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 101050,
      "end_ms": 104665,
      "text": "如情湖是很多人初识秋水的地方，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 105190,
      "end_ms": 108535,
      "text": "多少人第一次看见彩灵映在湖面，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 109030,
      "end_ms": 109795,
      "text": "就是在这里，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 112470,
      "end_ms": 115205,
      "text": "您说这算不算秋水秘境的第一课？"
    },
    {
      "segment_id": "s000042",
      "start_ms": 116160,
      "end_ms": 117600,
      "text": "如琴湖排第十，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 117620,
      "end_ms": 118785,
      "text": "不是湖水不美，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 119030,
      "end_ms": 123445,
      "text": "是离我们太近近到常常忽略湖山相伴的清净。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 124020,
      "end_ms": 124700,
      "text": "第九名。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 124960,
      "end_ms": 129090,
      "text": "辽宁还龙湖还龙湖藏在辽宁还人，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 129090,
      "end_ms": 131945,
      "text": "舞女山脚下魂将汇聚而成。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 132390,
      "end_ms": 134295,
      "text": "湖面蜿蜒曲折，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 134710,
      "end_ms": 135450,
      "text": "秋天一到，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 135790,
      "end_ms": 138315,
      "text": "沿岸枫林一层层变红，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 138940,
      "end_ms": 141355,
      "text": "倒影沉在碧绿的湖水里面，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 141730,
      "end_ms": 147445,
      "text": "可以坐船行在湖上看两岸层林铺展江风缓缓吹过来。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 148400,
      "end_ms": 152725,
      "text": "他没有高山海子那种经验的蓝胜在开阔舒展，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 154340,
      "end_ms": 155355,
      "text": "江水绵长。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 157040,
      "end_ms": 158000,
      "text": "最佳观赏期。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 158000,
      "end_ms": 159460,
      "text": "九月底到十月中旬，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 159560,
      "end_ms": 161205,
      "text": "北方的秋意来的干脆，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 161850,
      "end_ms": 163800,
      "text": "红叶碧水，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 164460,
      "end_ms": 165040,
      "text": "远山，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 165140,
      "end_ms": 167465,
      "text": "简简单单大气耐看。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 168410,
      "end_ms": 169155,
      "text": "第八名，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 170620,
      "end_ms": 172745,
      "text": "贵州荔波小七孔卧龙潭，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 175750,
      "end_ms": 178295,
      "text": "卧龙潭藏在小七孔峡谷深处，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 178800,
      "end_ms": 184240,
      "text": "一潭翡翠色的净水上游有细铺青落秋来，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 184240,
      "end_ms": 186405,
      "text": "两岸林木深浅交错，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 186930,
      "end_ms": 188535,
      "text": "树叶有绿有黄。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 189170,
      "end_ms": 194050,
      "text": "潭水常年保持温润的蓝绿色潭面，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 194050,
      "end_ms": 196350,
      "text": "很静风不大的时候，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 196610,
      "end_ms": 201315,
      "text": "像一面打磨光滑的玉镜和汹涌的瀑布不一样，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 201850,
      "end_ms": 204170,
      "text": "卧龙潭的秋水是内敛的，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 204230,
      "end_ms": 206195,
      "text": "藏在山谷里不张扬。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 207010,
      "end_ms": 209675,
      "text": "沿着潭边木栈道慢行，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 210560,
      "end_ms": 211455,
      "text": "听水声，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 211810,
      "end_ms": 212665,
      "text": "看水色，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 213270,
      "end_ms": 214830,
      "text": "适合慢慢静下心来，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 215010,
      "end_ms": 217975,
      "text": "感受山水第七名。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 219100,
      "end_ms": 225875,
      "text": "云南抚仙湖抚香湖在云南玉溪是国内深水大湖，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 226520,
      "end_ms": 227380,
      "text": "湖水透亮，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 227420,
      "end_ms": 227985,
      "text": "清澈，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 228440,
      "end_ms": 229600,
      "text": "晴天的时候，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 229860,
      "end_ms": 233945,
      "text": "由岸边的浅绿慢慢过渡到湖心的深蓝。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 234780,
      "end_ms": 236910,
      "text": "秋天云南不冷环湖，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 236930,
      "end_ms": 238190,
      "text": "时光占道平坦，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 238230,
      "end_ms": 238735,
      "text": "绵长，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 239260,
      "end_ms": 239920,
      "text": "走累了，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 239920,
      "end_ms": 242965,
      "text": "随时能坐下看落日扑在水面。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 243410,
      "end_ms": 244350,
      "text": "他没有彩铃，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 244390,
      "end_ms": 247675,
      "text": "紧紧环抱胜在湖水本身的通透。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 248490,
      "end_ms": 250335,
      "text": "别处秋水看倒影，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 250910,
      "end_ms": 252975,
      "text": "抚仙湖看的是水的本色，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 253860,
      "end_ms": 255315,
      "text": "天光落在湖面，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 255930,
      "end_ms": 257310,
      "text": "干净的能洗去，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 257330,
      "end_ms": 258245,
      "text": "心头浮躁。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 258530,
      "end_ms": 260105,
      "text": "我们会第六名。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 261000,
      "end_ms": 265685,
      "text": "甘肃闻县天池闻县天池藏在陇南深山，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 266100,
      "end_ms": 268045,
      "text": "被叫做陇上小九寨。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 268720,
      "end_ms": 270855,
      "text": "群山围成天然的湖盆，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 271350,
      "end_ms": 274050,
      "text": "湖水晴蓝阴没变换，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 274110,
      "end_ms": 275110,
      "text": "不一样的色调。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 275950,
      "end_ms": 278065,
      "text": "环湖修了平缓栈道，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 278520,
      "end_ms": 280040,
      "text": "不用高强度登山，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 280480,
      "end_ms": 281460,
      "text": "慢慢绕行，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 281740,
      "end_ms": 284045,
      "text": "就能看遍湖山秋色。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 284750,
      "end_ms": 287310,
      "text": "秋实山林彩叶环绕，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 287330,
      "end_ms": 288790,
      "text": "湖面深山人少，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 289030,
      "end_ms": 289965,
      "text": "十分清静。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 290490,
      "end_ms": 292015,
      "text": "没有拥挤的人流，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 292380,
      "end_ms": 295595,
      "text": "只有山峰、鸟鸣和一池净水，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 296020,
      "end_ms": 299425,
      "text": "是藏在西北不为人知的秋水秘境。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 300760,
      "end_ms": 303035,
      "text": "从第十名到第六名。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 303510,
      "end_ms": 305430,
      "text": "如晴湖是山间晴湖，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 305690,
      "end_ms": 306930,
      "text": "还龙湖是江湾，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 306950,
      "end_ms": 307410,
      "text": "红叶，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 307690,
      "end_ms": 309510,
      "text": "卧龙潭是幽谷玉潭，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 309930,
      "end_ms": 312670,
      "text": "抚仙湖是天光净水文献，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 312770,
      "end_ms": 314230,
      "text": "天池是陇南山湖。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 315090,
      "end_ms": 316990,
      "text": "可咱们还没讲到最绝的，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 317370,
      "end_ms": 319730,
      "text": "接下来第五道第一名更了不得。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 320130,
      "end_ms": 323210,
      "text": "有一处高原圣湖彩铃，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 323270,
      "end_ms": 326070,
      "text": "沿着湖岸一路扑向雪山。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 326190,
      "end_ms": 329430,
      "text": "有一处藏地绿宝石净水，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 329510,
      "end_ms": 330870,
      "text": "映着湖心古寺。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 331570,
      "end_ms": 337960,
      "text": "有一片川西海子彩林净水草甸融为一体。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 338700,
      "end_ms": 340660,
      "text": "有一弯阿尔山天池，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 341520,
      "end_ms": 344480,
      "text": "林海包裹着蓝宝石一样的湖面，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 345020,
      "end_ms": 346880,
      "text": "可排在榜首的那一处。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 347280,
      "end_ms": 348500,
      "text": "雪山环抱，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 349240,
      "end_ms": 353880,
      "text": "白桦环湖一汪湖水随光影变幻，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 354060,
      "end_ms": 357880,
      "text": "蓝绿一年只有十几天的黄金秋色。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 358800,
      "end_ms": 359620,
      "text": "它是哪里？"
    },
    {
      "segment_id": "s000131",
      "start_ms": 360900,
      "end_ms": 363125,
      "text": "它凭什么排在九寨沟前面，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 363470,
      "end_ms": 365595,
      "text": "下一集已经同步更新，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 366090,
      "end_ms": 367690,
      "text": "现在直接点开我的头像，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 367710,
      "end_ms": 368390,
      "text": "进入主页，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 368390,
      "end_ms": 371850,
      "text": "第一条视频就是下一集点个关注，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 371950,
      "end_ms": 377225,
      "text": "咱们接着看谁才是秋水秘境真正的天花板。"
    }
  ],
  "source_transcript_sha256": "768dc0eefe876594f63781ebe3feb89cfb333750fec95c4c8e8501e1be195695"
}