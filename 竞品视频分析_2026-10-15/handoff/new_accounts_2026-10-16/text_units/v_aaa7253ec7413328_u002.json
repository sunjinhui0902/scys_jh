{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_aaa7253ec7413328_u002",
  "video_id": "v_aaa7253ec7413328",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 893.342993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000334",
      "start_ms": 810380,
      "end_ms": 812060,
      "text": "你以为鲜艳宫里是迷信，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 812300,
      "end_ms": 814025,
      "text": "它其实是认识论的起点。"
    },
    {
      "segment_id": "s000336",
      "start_ms": 814470,
      "end_ms": 817540,
      "text": "第三种是对二十世纪思想史好奇的人。"
    },
    {
      "segment_id": "s000337",
      "start_ms": 817680,
      "end_ms": 821320,
      "text": "你想知道一个在耶鲁大学出版社都拒绝出版他著作的人，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 821520,
      "end_ms": 825880,
      "text": "如何在孤独中建构出一套被哈耶克、罗斯巴德继承的体系。"
    },
    {
      "segment_id": "s000339",
      "start_ms": 826120,
      "end_ms": 827255,
      "text": "它不适合三种人，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 827830,
      "end_ms": 829150,
      "text": "想找简单答案的人，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 829230,
      "end_ms": 829875,
      "text": "别读。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 830240,
      "end_ms": 832100,
      "text": "想找战队材料的人别读，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 832460,
      "end_ms": 834455,
      "text": "想找心灵鸡汤的人别读，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 834810,
      "end_ms": 835910,
      "text": "他不负责安慰你，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 836150,
      "end_ms": 838835,
      "text": "他负责让你不舒服怎么读，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 839450,
      "end_ms": 841130,
      "text": "不要从头到尾跪着读，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 841270,
      "end_ms": 843335,
      "text": "也不要从头到尾审判着读，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 843680,
      "end_ms": 844355,
      "text": "带一支笔，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 844800,
      "end_ms": 847045,
      "text": "先读认识论部分问自己，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 847500,
      "end_ms": 850505,
      "text": "我凭什么相信我每天相信的经济规律？"
    },
    {
      "segment_id": "s000351",
      "start_ms": 850740,
      "end_ms": 851940,
      "text": "在读市场过程部分，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 851960,
      "end_ms": 852575,
      "text": "问自己，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 852870,
      "end_ms": 855070,
      "text": "价格真的是东西贵还是信号？"
    },
    {
      "segment_id": "s000354",
      "start_ms": 855090,
      "end_ms": 857575,
      "text": "最后读干预主义部分问自己，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 857880,
      "end_ms": 863120,
      "text": "我能不能在好心办坏事和坏心办好事之间做出负责任的判断。"
    },
    {
      "segment_id": "s000356",
      "start_ms": 863200,
      "end_ms": 865585,
      "text": "如果只打算从这条内容里带走一个动作，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 865830,
      "end_ms": 868045,
      "text": "我希望是去找这本书来读。"
    },
    {
      "segment_id": "s000358",
      "start_ms": 868410,
      "end_ms": 869085,
      "text": "不是点赞，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 869430,
      "end_ms": 870215,
      "text": "不是收藏，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 870600,
      "end_ms": 871315,
      "text": "是毒。"
    },
    {
      "segment_id": "s000361",
      "start_ms": 872260,
      "end_ms": 873255,
      "text": "不是读我的文案，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 873550,
      "end_ms": 875545,
      "text": "试读米赛斯不是读结论，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 875860,
      "end_ms": 878915,
      "text": "是读推理平台能删掉一段文案，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 879310,
      "end_ms": 879750,
      "text": "删不掉。"
    },
    {
      "segment_id": "s000365",
      "start_ms": 879750,
      "end_ms": 881545,
      "text": "你翻开书之后的那几个小时，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 882260,
      "end_ms": 883915,
      "text": "剩下的你自己去看。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 884830,
      "end_ms": 887425,
      "text": "这才是我把这条文案改了五遍，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 887740,
      "end_ms": 889895,
      "text": "仍然要把他推到你面前的原因。"
    },
    {
      "segment_id": "s000369",
      "start_ms": 890110,
      "end_ms": 890975,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000370",
      "start_ms": 891420,
      "end_ms": 892620,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 892620,
      "end_ms": 893225,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "8e1fe535e2b2c0d55fb5ccd9e7547f1112814a133b5e4fc87bc5ef532079e6b0"
}