{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_4f4d5d796acb8bf2_u001",
  "video_id": "v_4f4d5d796acb8bf2",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 603.998005,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 410,
      "text": "上集，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 410,
      "end_ms": 3270,
      "text": "咱们看了五件表情管理失败的显眼包，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 3690,
      "end_ms": 5350,
      "text": "这一集咱们来看另外五件，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6290,
      "end_ms": 8029,
      "text": "他们不靠脸靠造型，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8750,
      "end_ms": 10030,
      "text": "他们最想说的是，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 10030,
      "end_ms": 11430,
      "text": "你猜我是干什么用的？"
    },
    {
      "segment_id": "s000007",
      "start_ms": 11690,
      "end_ms": 16850,
      "text": "第一件安徽博物院云纹铜五柱器。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 16850,
      "end_ms": 20490,
      "text": "它的造型是一个方形的底座，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 20490,
      "end_ms": 23590,
      "text": "上面竖着五根等高的柱子。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 23590,
      "end_ms": 26110,
      "text": "你第一眼看到它，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 26110,
      "end_ms": 29210,
      "text": "会觉得它像一台路由器。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 29210,
      "end_ms": 32440,
      "text": "瓦子网友就是这么叫它的青铜路由器。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 33060,
      "end_ms": 39820,
      "text": "西周青铜器一九五九年出土于安徽屯溪义齐献葬安徽博物院。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 40600,
      "end_ms": 42260,
      "text": "但它到底是什么？"
    },
    {
      "segment_id": "s000015",
      "start_ms": 42920,
      "end_ms": 43880,
      "text": "没有人知道，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 44600,
      "end_ms": 46800,
      "text": "安徽博物院官网明确写着，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 47460,
      "end_ms": 49020,
      "text": "不见于朱家住路，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 49400,
      "end_ms": 50340,
      "text": "用途待考，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 51100,
      "end_ms": 52540,
      "text": "通高三十一厘米，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 52900,
      "end_ms": 55240,
      "text": "其中筑高十六点五厘米，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 55900,
      "end_ms": 57820,
      "text": "重五点二五公斤。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 58700,
      "end_ms": 69070,
      "text": "器上有五五根原助分裂于长方形的脊级上距离户等下围空腔方坐四角，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 69110,
      "end_ms": 69590,
      "text": "非圆，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 69610,
      "end_ms": 70230,
      "text": "无棱鱼，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 70530,
      "end_ms": 71465,
      "text": "四壁微谷。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 71840,
      "end_ms": 74970,
      "text": "安徽博物院副院长黎志说过一段话，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 75050,
      "end_ms": 77485,
      "text": "文物的定名都是有相关规范的。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 77880,
      "end_ms": 79825,
      "text": "这件文物没有正式定名，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 80430,
      "end_ms": 82390,
      "text": "就是因为他一没有铭文，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 82610,
      "end_ms": 83990,
      "text": "二没有文献记载。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 84230,
      "end_ms": 86305,
      "text": "三没有类似文物做参考。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 86740,
      "end_ms": 88505,
      "text": "之所以称为捂助器，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 88980,
      "end_ms": 92860,
      "text": "就是因为不清楚它的功能不得已，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 92940,
      "end_ms": 95345,
      "text": "才依据器型、外表和纹饰特征。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 95640,
      "end_ms": 97185,
      "text": "取一个临时名称，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 98190,
      "end_ms": 102400,
      "text": "考古工作者曾对他做过事敲测音五柱，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 102480,
      "end_ms": 103955,
      "text": "发音各不相同，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 104480,
      "end_ms": 106335,
      "text": "或与古乐五音有关，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 106910,
      "end_ms": 109450,
      "text": "每处不同部位也有不同声音。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 109570,
      "end_ms": 109930,
      "text": "发掘。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 109930,
      "end_ms": 110530,
      "text": "报告认为，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 110670,
      "end_ms": 115555,
      "text": "这件铜器可能与音律和校正音高有密切关系。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 116250,
      "end_ms": 122305,
      "text": "但由于发掘时没有见到附近有管乐器的腐朽残迹为之佐证，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 122860,
      "end_ms": 125095,
      "text": "因此也不能肯定这是一件乐器。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 125990,
      "end_ms": 129634,
      "text": "有学者从他的形状向甲骨文的纸质推测，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 130110,
      "end_ms": 132875,
      "text": "可能与古人的生育繁衍观念有关。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 134150,
      "end_ms": 135395,
      "text": "三千年过去了，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 135770,
      "end_ms": 139495,
      "text": "这件青铜器仍然在问每一个站在他面前的人，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 139950,
      "end_ms": 141405,
      "text": "你猜我是干什么用？"
    },
    {
      "segment_id": "s000050",
      "start_ms": 142480,
      "end_ms": 144800,
      "text": "如果说捂住器是个猜不透的谜，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 145120,
      "end_ms": 149655,
      "text": "那下面这件姿势更让人摸不着头脑。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 150460,
      "end_ms": 151145,
      "text": "第二件，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 152120,
      "end_ms": 155535,
      "text": "安徽博物院青铜贵的勇，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 156400,
      "end_ms": 158215,
      "text": "他们是一组青铜小人。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 159540,
      "end_ms": 160540,
      "text": "一九六五年，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 160560,
      "end_ms": 163925,
      "text": "出土于安徽屯溪一起土墩墓，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 164290,
      "end_ms": 166075,
      "text": "通高约十五厘米，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 166870,
      "end_ms": 169055,
      "text": "同仁作答疑作状，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 169540,
      "end_ms": 171320,
      "text": "双手上举袁氏，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 171660,
      "end_ms": 174225,
      "text": "托举物间身材脚矮，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 174710,
      "end_ms": 175985,
      "text": "且裸体无事。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 176590,
      "end_ms": 178535,
      "text": "四是古代男人的习俗，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 179220,
      "end_ms": 181475,
      "text": "他们的姿势高度统一，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 181910,
      "end_ms": 182855,
      "text": "双膝跪地，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 183300,
      "end_ms": 184275,
      "text": "双臂举起，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 184550,
      "end_ms": 185415,
      "text": "腰部挺直，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 185720,
      "end_ms": 187825,
      "text": "表情虔诚一组四件，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 188170,
      "end_ms": 191150,
      "text": "出土时分布在土墩木四角王佑管，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 191150,
      "end_ms": 192605,
      "text": "这叫集体行为艺术。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 192970,
      "end_ms": 194435,
      "text": "但他们不是行为艺术。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 194880,
      "end_ms": 196115,
      "text": "研究人员推测，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 196570,
      "end_ms": 199205,
      "text": "他们可能是大型李器的附属构建，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 199830,
      "end_ms": 204785,
      "text": "是研究先秦时期祭祀等礼仪活动的重要食物遗存。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 205360,
      "end_ms": 206965,
      "text": "他们跪了两千多年了，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 207330,
      "end_ms": 208655,
      "text": "他们不是在等领导，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 209020,
      "end_ms": 209985,
      "text": "他们是在等神，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 210690,
      "end_ms": 212030,
      "text": "你站在他们面前，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 212230,
      "end_ms": 214235,
      "text": "看着那一排排跪着的背影，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 214660,
      "end_ms": 217585,
      "text": "会感受到一种庄重的仪式感。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 218080,
      "end_ms": 226690,
      "text": "第三件安徽博物院守门暗遁武士陶俑，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 226770,
      "end_ms": 229830,
      "text": "他们是一对一个张口古墓，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 230190,
      "end_ms": 232875,
      "text": "面带笑容一个树木怒市，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 233420,
      "end_ms": 234515,
      "text": "表情严厉，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 235070,
      "end_ms": 236010,
      "text": "一个负责喜，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 236510,
      "end_ms": 237350,
      "text": "一个负责怒。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 237570,
      "end_ms": 239125,
      "text": "他们的工作是守门，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 239660,
      "end_ms": 245415,
      "text": "一个笑着手一个怒着手分工明确隋代文物。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 245720,
      "end_ms": 248660,
      "text": "一九七三年出土于安徽合肥郊区，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 248680,
      "end_ms": 249895,
      "text": "隋开皇六年末，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 250620,
      "end_ms": 251975,
      "text": "高五十厘米。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 252640,
      "end_ms": 256575,
      "text": "献葬安徽博物院用陶俑陪葬。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 257010,
      "end_ms": 259875,
      "text": "在秦至唐代贵族墓葬中叫流行，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 260400,
      "end_ms": 263420,
      "text": "主要根据各时期官吏的形象雕塑而成，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 263440,
      "end_ms": 266725,
      "text": "以显示死者生前显赫的地位。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 267350,
      "end_ms": 269760,
      "text": "这两件守门武是有以手按顿，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 269880,
      "end_ms": 271360,
      "text": "以手执兵器所执，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 271360,
      "end_ms": 272365,
      "text": "兵器已脱落。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 272790,
      "end_ms": 274820,
      "text": "出土时分布在墓中，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 275360,
      "end_ms": 278205,
      "text": "该墓共出土了近四十件桃塑，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 278650,
      "end_ms": 283405,
      "text": "为研究隋代的墓葬习俗和陶塑艺术提供了宝贵的实物资料。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 283950,
      "end_ms": 285110,
      "text": "你站在他们面前，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 285310,
      "end_ms": 289755,
      "text": "会忍不住想一千四百年前他们守的是哪扇门？"
    },
    {
      "segment_id": "s000103",
      "start_ms": 290350,
      "end_ms": 293515,
      "text": "那扇门后面住着什么人？"
    },
    {
      "segment_id": "s000104",
      "start_ms": 293820,
      "end_ms": 295665,
      "text": "第四届南京博物院。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 296980,
      "end_ms": 298020,
      "text": "珠形陶罐，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 298240,
      "end_ms": 299620,
      "text": "它们是一组陶罐，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 299740,
      "end_ms": 302080,
      "text": "用陶泥制作大小不一，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 302740,
      "end_ms": 304240,
      "text": "造型是珠的样子。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 304380,
      "end_ms": 309620,
      "text": "来自高邮龙求装遗址新石器时代文物九只，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 309920,
      "end_ms": 313980,
      "text": "憨态可掬的小猪最大一只长十六厘米，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 314340,
      "end_ms": 316200,
      "text": "最小仅六点五厘米，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 316560,
      "end_ms": 318480,
      "text": "从大到小依次排列，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 318640,
      "end_ms": 320160,
      "text": "有的抿嘴拱鼻，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 320460,
      "end_ms": 321580,
      "text": "有的笑的眯眼，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 321760,
      "end_ms": 322720,
      "text": "还有的皱着眉。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 323180,
      "end_ms": 325060,
      "text": "它们的背部设有注水口，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 325220,
      "end_ms": 326375,
      "text": "肚子是空的，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 326770,
      "end_ms": 327490,
      "text": "可以装水。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 328350,
      "end_ms": 331430,
      "text": "这组文物兼具艺术性和实用性，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 331990,
      "end_ms": 334130,
      "text": "它的背部有注水口，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 334730,
      "end_ms": 337050,
      "text": "能用作盛水器装水，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 337150,
      "end_ms": 338790,
      "text": "别以为它们只是摆设。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 339690,
      "end_ms": 343810,
      "text": "猪形陶罐的造型与当时家猪饲养业发达有关，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 344570,
      "end_ms": 348190,
      "text": "它们的体型虽然与野猪仍有些近似，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 348630,
      "end_ms": 350930,
      "text": "但头部已经明显变短，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 351350,
      "end_ms": 354110,
      "text": "应是人工饲养驯化的结果。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 354470,
      "end_ms": 356905,
      "text": "距今约六千至七千年前钱，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 357180,
      "end_ms": 358740,
      "text": "中国人已经开始养猪，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 358980,
      "end_ms": 360580,
      "text": "还把猪做成了罐子。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 360740,
      "end_ms": 368475,
      "text": "这些猪形陶罐是江南地区新石器时代、稻作农业和家畜饲养业发达的一个缩影。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 368950,
      "end_ms": 371065,
      "text": "你看着他们圆滚滚的肚子，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 371550,
      "end_ms": 374110,
      "text": "会想起小时候用的存钱罐。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 374230,
      "end_ms": 374830,
      "text": "第五件，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 375010,
      "end_ms": 376010,
      "text": "南京博物院，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 376130,
      "end_ms": 377665,
      "text": "南唐人首余深勇。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 378180,
      "end_ms": 380935,
      "text": "它的造型是一个人的头，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 381590,
      "end_ms": 383445,
      "text": "接在一条鱼的身体上，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 384180,
      "end_ms": 385140,
      "text": "人脸安详，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 385440,
      "end_ms": 387915,
      "text": "余身有鳞尾巴翘起，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 388440,
      "end_ms": 390060,
      "text": "他是人还是鱼，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 390260,
      "end_ms": 391905,
      "text": "他是神还是怪？"
    },
    {
      "segment_id": "s000142",
      "start_ms": 392530,
      "end_ms": 395250,
      "text": "南唐文物出土于南唐开国皇帝，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 395510,
      "end_ms": 396445,
      "text": "李清龄，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 396820,
      "end_ms": 398225,
      "text": "通高十五厘米，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 398480,
      "end_ms": 399685,
      "text": "长三十五厘米，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 400030,
      "end_ms": 401785,
      "text": "献葬南京博物院。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 402320,
      "end_ms": 406655,
      "text": "他属于唐宋墓葬中随葬器物的一种，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 407290,
      "end_ms": 409235,
      "text": "也被称作夷鱼，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 409670,
      "end_ms": 412630,
      "text": "主要作用是振木、辟邪、吉祥压。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 412630,
      "end_ms": 416430,
      "text": "盛山海经中描述海神人面，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 416430,
      "end_ms": 421485,
      "text": "而鱼身无足人手于神勇的造型可能来源于此。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 422400,
      "end_ms": 425265,
      "text": "而南唐是五代十国时期的一个王朝，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 425770,
      "end_ms": 427250,
      "text": "只有三十八年历史，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 427330,
      "end_ms": 430805,
      "text": "但留下了中国文学史上最璀璨的词。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 431570,
      "end_ms": 434025,
      "text": "李煜就是南唐最后一位君主，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 434460,
      "end_ms": 436015,
      "text": "这件人手于身勇，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 436880,
      "end_ms": 438100,
      "text": "有学者推测，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 438200,
      "end_ms": 440980,
      "text": "可能是南唐人对死后世界的一种想象。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 441000,
      "end_ms": 444805,
      "text": "仁死变成鱼游向另一个世界。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 445220,
      "end_ms": 447620,
      "text": "你看着他安详的人脸和鱼的身体，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 447620,
      "end_ms": 450485,
      "text": "会想起山海经里那些奇奇怪怪的生物。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 451350,
      "end_ms": 451975,
      "text": "说到这儿，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 452170,
      "end_ms": 453345,
      "text": "我想再停一下，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 454240,
      "end_ms": 455135,
      "text": "你发现了吗？"
    },
    {
      "segment_id": "s000165",
      "start_ms": 456030,
      "end_ms": 457610,
      "text": "下集这五件显眼包，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 457850,
      "end_ms": 460745,
      "text": "每一件都在问我们同一个问题，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 461170,
      "end_ms": 462435,
      "text": "你猜我是干什么用的？"
    },
    {
      "segment_id": "s000168",
      "start_ms": 462790,
      "end_ms": 468775,
      "text": "云文铜五注器出土六十多年了无数青铜器研究专家对他进行研究，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 469310,
      "end_ms": 472245,
      "text": "至今仍停留在推理的空间内。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 472690,
      "end_ms": 475260,
      "text": "青铜贵喜有跪了。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 475260,
      "end_ms": 478720,
      "text": "两千多年分布在土墩木四角，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 479740,
      "end_ms": 481180,
      "text": "不知道在守护什么。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 481240,
      "end_ms": 482260,
      "text": "守门武士勇，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 482440,
      "end_ms": 483280,
      "text": "一个笑一个，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 483280,
      "end_ms": 483520,
      "text": "怒，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 483660,
      "end_ms": 484460,
      "text": "分工明确，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 484460,
      "end_ms": 486020,
      "text": "但不知道守的是哪扇门。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 486880,
      "end_ms": 489560,
      "text": "珠形陶罐装水的，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 489640,
      "end_ms": 497580,
      "text": "但长得像猪镇人鱼身勇人的头鱼的身体、震目、辟邪的遗鱼。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 498480,
      "end_ms": 500640,
      "text": "这些显眼包不只是有趣，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 500880,
      "end_ms": 502180,
      "text": "他们是有趣的泥。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 502600,
      "end_ms": 507150,
      "text": "他们让我们看到古人的世界比我们想象的复杂的多。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 507810,
      "end_ms": 508670,
      "text": "他们有礼器，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 509130,
      "end_ms": 510830,
      "text": "有兵器、有乐器，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 511130,
      "end_ms": 512450,
      "text": "但他们也有疑问，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 512590,
      "end_ms": 514190,
      "text": "有想象、有幽默。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 514730,
      "end_ms": 517950,
      "text": "他们会把一个陶罐做成猪的样子，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 518010,
      "end_ms": 520290,
      "text": "会把一个人做成鱼的身体，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 521010,
      "end_ms": 523750,
      "text": "会做一个五根柱子的青铜器，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 523770,
      "end_ms": 525790,
      "text": "然后不告诉后人他是干什么。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 526670,
      "end_ms": 531110,
      "text": "这些谜散落在全国的博物馆里，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 531510,
      "end_ms": 532870,
      "text": "你去了安徽博物院，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 533330,
      "end_ms": 535330,
      "text": "能看到跪列俑和守门武士。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 535330,
      "end_ms": 537660,
      "text": "你去了南京博物院，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 537840,
      "end_ms": 540660,
      "text": "能看到猪型陶罐和人首余申勇，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 541420,
      "end_ms": 542520,
      "text": "但你到了现场，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 542900,
      "end_ms": 544265,
      "text": "可能只看到了他们，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 544650,
      "end_ms": 547795,
      "text": "却不知道他们背后的年代用途。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 548150,
      "end_ms": 548945,
      "text": "出土背景，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 549740,
      "end_ms": 551200,
      "text": "你不知道那件五铸器，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 551200,
      "end_ms": 553060,
      "text": "为什么没有人知道它的用途？"
    },
    {
      "segment_id": "s000202",
      "start_ms": 553060,
      "end_ms": 554860,
      "text": "你不知道那件人手于神俑，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 554860,
      "end_ms": 558805,
      "text": "为什么出现在南唐开国皇帝的零目的？"
    },
    {
      "segment_id": "s000204",
      "start_ms": 559850,
      "end_ms": 560290,
      "text": "最后，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 560850,
      "end_ms": 562005,
      "text": "我想问你一个问题，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 562950,
      "end_ms": 565455,
      "text": "上集的显眼包靠表情，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 566110,
      "end_ms": 568235,
      "text": "下集的显眼包靠造型，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 568640,
      "end_ms": 569825,
      "text": "亚丑越的笑容，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 570510,
      "end_ms": 573735,
      "text": "铜奔马的呆萌绿幼讨狗的忠诚，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 574110,
      "end_ms": 578070,
      "text": "击鼓说唱咏的生动纵木面具的神秘。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 578070,
      "end_ms": 579310,
      "text": "每一件显眼包，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 579350,
      "end_ms": 579850,
      "text": "背后，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 580110,
      "end_ms": 582865,
      "text": "都是古人对生活的观察和表达。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 583230,
      "end_ms": 589965,
      "text": "云纹同捂助器像路由器柜台俑在举行仪式首门武士在履行守卫职责。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 590730,
      "end_ms": 594020,
      "text": "猪形陶罐在装可爱人手于神勇。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 594060,
      "end_ms": 595325,
      "text": "在问你他是什么？"
    },
    {
      "segment_id": "s000217",
      "start_ms": 596200,
      "end_ms": 599975,
      "text": "如果让你从这十件显眼包里选一件带回家，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 600380,
      "end_ms": 600960,
      "text": "你选哪个？"
    },
    {
      "segment_id": "s000219",
      "start_ms": 600960,
      "end_ms": 601845,
      "text": "评论区聊聊，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 603540,
      "end_ms": 603970,
      "text": "我等你。"
    }
  ],
  "source_transcript_sha256": "44e181d9c576a08256a440af69263a6fdbd91b9a9d301cb34c4eff63f6bbe5a7"
}