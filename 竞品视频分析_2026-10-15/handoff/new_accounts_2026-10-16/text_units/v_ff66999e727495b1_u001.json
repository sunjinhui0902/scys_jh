{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ff66999e727495b1_u001",
  "video_id": "v_ff66999e727495b1",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 558.300998,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 770,
      "text": "接着上集，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1150,
      "end_ms": 3550,
      "text": "咱们继续聊故宫里十件皇帝，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 3550,
      "end_ms": 5490,
      "text": "每天都用的日常器物，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 5950,
      "end_ms": 8050,
      "text": "上一集讲了第十道第六名，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8650,
      "end_ms": 11410,
      "text": "成化鸡纲杯拍出二点八亿。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12930,
      "end_ms": 15410,
      "text": "雍正批奏折劈的跟聊天一样，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 15750,
      "end_ms": 17270,
      "text": "康熙的眼镜丢了，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17270,
      "end_ms": 18010,
      "text": "比丢了，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 18010,
      "end_ms": 18830,
      "text": "玉玺还急。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 19710,
      "end_ms": 23070,
      "text": "乾隆的多宝阁藏了一百零八件小玩意儿。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23830,
      "end_ms": 27090,
      "text": "慈禧的指甲套掉一个赏一百两银子，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 27970,
      "end_ms": 30000,
      "text": "可这五件还不是最特别的。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 30480,
      "end_ms": 34805,
      "text": "接下来第五道第一名更能看出皇帝的真性情。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 36980,
      "end_ms": 38080,
      "text": "有一件东西，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 38240,
      "end_ms": 40300,
      "text": "康熙一支笔用了几十年，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 40660,
      "end_ms": 42380,
      "text": "笔杆都磨出包浆了，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 42660,
      "end_ms": 46700,
      "text": "有一件皇帝每天睡觉前都要闻一闻，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 46840,
      "end_ms": 47600,
      "text": "才能入睡。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 48000,
      "end_ms": 49800,
      "text": "有一件乾隆，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 49900,
      "end_ms": 52900,
      "text": "每天吃饭前都要看一眼才动筷子。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 53380,
      "end_ms": 59615,
      "text": "有一件皇帝每天带在身上丢了就睡不着觉。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 60280,
      "end_ms": 64085,
      "text": "还有一件皇帝临死前抱着不撒手，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 64480,
      "end_ms": 65435,
      "text": "带进了棺材。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 66530,
      "end_ms": 67225,
      "text": "第五名，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 68260,
      "end_ms": 69335,
      "text": "康熙的御笔，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 70540,
      "end_ms": 73965,
      "text": "这是一支毛笔普普通通的狼嚎笔，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 74370,
      "end_ms": 75785,
      "text": "笔杆是竹子做的，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 76070,
      "end_ms": 77455,
      "text": "没有相金相银，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 77780,
      "end_ms": 78700,
      "text": "也没有刻字。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 78880,
      "end_ms": 82495,
      "text": "康熙用这支笔批奏折写字，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 83360,
      "end_ms": 85405,
      "text": "画画一用就是几十年，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 86210,
      "end_ms": 89285,
      "text": "您知道用了几十年的毛笔是什么样吗？"
    },
    {
      "segment_id": "s000033",
      "start_ms": 90120,
      "end_ms": 92265,
      "text": "笔杆被守汉浸透了，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 92660,
      "end_ms": 94255,
      "text": "颜色变深了，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 94660,
      "end_ms": 96585,
      "text": "表面磨的光滑发亮，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 97080,
      "end_ms": 98445,
      "text": "像涂了一层油，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 98850,
      "end_ms": 99665,
      "text": "这叫褒浆，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 100790,
      "end_ms": 102245,
      "text": "比豪模短了，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 102810,
      "end_ms": 104345,
      "text": "康熙也舍不得换，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 105040,
      "end_ms": 105805,
      "text": "还接着用。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 106800,
      "end_ms": 112235,
      "text": "传说康熙晚年有一次比吊地上笔杆裂了一道缝，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 112940,
      "end_ms": 114345,
      "text": "康熙心疼的不行，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 114910,
      "end_ms": 116635,
      "text": "让人拿金丝缠上，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 117320,
      "end_ms": 120075,
      "text": "接着用大臣劝他换支新笔。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 121160,
      "end_ms": 121820,
      "text": "康熙说，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 121920,
      "end_ms": 123735,
      "text": "这支笔跟了我几十年，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 124230,
      "end_ms": 126445,
      "text": "比有些大臣跟我的时间还长，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 126990,
      "end_ms": 129700,
      "text": "怎么能说换就换一支毛笔，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 130020,
      "end_ms": 132120,
      "text": "用到笔杆裂了还舍不得扔。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 132380,
      "end_ms": 134645,
      "text": "您说这是节俭还是念旧？"
    },
    {
      "segment_id": "s000051",
      "start_ms": 135050,
      "end_ms": 136975,
      "text": "第四名皇帝的香囊？"
    },
    {
      "segment_id": "s000052",
      "start_ms": 137850,
      "end_ms": 138975,
      "text": "这是一个小袋子，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 139240,
      "end_ms": 142565,
      "text": "巴掌大丝绸做的里头装着香料，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 143160,
      "end_ms": 146105,
      "text": "皇帝每天睡觉前都要闻一闻才能入睡。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 146880,
      "end_ms": 149135,
      "text": "您知道皇帝为什么要闻香吗？"
    },
    {
      "segment_id": "s000056",
      "start_ms": 149680,
      "end_ms": 150655,
      "text": "不是为了相，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 151550,
      "end_ms": 152665,
      "text": "是为了安神。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 153820,
      "end_ms": 155095,
      "text": "古代皇帝压力大，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 155590,
      "end_ms": 156770,
      "text": "每天处理朝政，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 156830,
      "end_ms": 158010,
      "text": "担心有人造反，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 158090,
      "end_ms": 159485,
      "text": "担心天灾人祸，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 159940,
      "end_ms": 161095,
      "text": "晚上睡不着觉，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 161890,
      "end_ms": 163945,
      "text": "太医就配了安神香，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 164650,
      "end_ms": 170815,
      "text": "用檀香、沉香、艾草、薰衣草混在一起，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 171660,
      "end_ms": 172975,
      "text": "装在香囊里，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 174530,
      "end_ms": 175755,
      "text": "睡前闻一闻，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 176260,
      "end_ms": 177575,
      "text": "能静下心来。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 178000,
      "end_ms": 182990,
      "text": "乾隆有个香囊里头装的是他母亲生前用过的香料。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 183770,
      "end_ms": 185730,
      "text": "乾隆每天睡前闻一闻，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 186390,
      "end_ms": 186630,
      "text": "说，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 186710,
      "end_ms": 187829,
      "text": "闻着这个味儿，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 187890,
      "end_ms": 190050,
      "text": "就像母亲还在身边一样。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 190410,
      "end_ms": 192150,
      "text": "传说乾隆去世前，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 192910,
      "end_ms": 194790,
      "text": "把这个香囊传给了嘉庆，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 195650,
      "end_ms": 196950,
      "text": "嘉庆打开一闻，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 197370,
      "end_ms": 199390,
      "text": "把这个香味早就散了。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 199390,
      "end_ms": 201930,
      "text": "可他还是每天带着一个香囊，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 202210,
      "end_ms": 203430,
      "text": "装的不是香料，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 203610,
      "end_ms": 204450,
      "text": "是思念。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 204830,
      "end_ms": 206630,
      "text": "您说这是器物还是情感？"
    },
    {
      "segment_id": "s000081",
      "start_ms": 206630,
      "end_ms": 209005,
      "text": "第三名，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 209940,
      "end_ms": 211540,
      "text": "乾隆的三喜堂法帖，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 212400,
      "end_ms": 214300,
      "text": "这是三件稀世珍宝。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 214660,
      "end_ms": 216520,
      "text": "王羲之的快雪诗请帖，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 216660,
      "end_ms": 219560,
      "text": "王献之的中秋帖王孔的博元帖。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 220000,
      "end_ms": 223580,
      "text": "乾隆把他们收藏在养心殿的一间小屋里，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 224040,
      "end_ms": 225660,
      "text": "起名叫三喜堂。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 226600,
      "end_ms": 229800,
      "text": "乾隆每天吃饭前都要去三喜堂看一眼，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 229880,
      "end_ms": 232620,
      "text": "这三件法帖看完了才去吃饭。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 233420,
      "end_ms": 235420,
      "text": "您知道乾隆为什么这么宝贝？"
    },
    {
      "segment_id": "s000091",
      "start_ms": 235420,
      "end_ms": 236620,
      "text": "这三件帖子嘛，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 236680,
      "end_ms": 238760,
      "text": "因为这是王羲之家族的真迹，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 240020,
      "end_ms": 243120,
      "text": "一千多年前的东西流传到现在，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 243360,
      "end_ms": 244620,
      "text": "全国就这三件，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 245460,
      "end_ms": 248140,
      "text": "乾隆一辈子收藏了几万件文物，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 248720,
      "end_ms": 251140,
      "text": "可他最宝贝的就是这三件，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 251520,
      "end_ms": 254060,
      "text": "每一件上面都盖满了他的印章，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 254300,
      "end_ms": 255440,
      "text": "还亲笔提拔。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 256260,
      "end_ms": 258080,
      "text": "传说乾隆有一次生病，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 258280,
      "end_ms": 259520,
      "text": "躺在床上起不来。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 259900,
      "end_ms": 263040,
      "text": "传说太监把三七堂的帖子抬到床前，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 263560,
      "end_ms": 266540,
      "text": "他看着帖子病就好了，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 266540,
      "end_ms": 269245,
      "text": "一半三件法帖。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 270060,
      "end_ms": 271240,
      "text": "乾隆看了几十年，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 272200,
      "end_ms": 274180,
      "text": "您说这是收藏还是信仰？"
    },
    {
      "segment_id": "s000106",
      "start_ms": 274280,
      "end_ms": 274960,
      "text": "聊到这儿，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 275060,
      "end_ms": 277400,
      "text": "先在评论区打出四个字，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 277799,
      "end_ms": 281460,
      "text": "皇家真情打完我接着往下讲。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 282560,
      "end_ms": 286520,
      "text": "接下来这两件一件皇帝天天带，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 286520,
      "end_ms": 289300,
      "text": "身上丢了睡不着，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 290520,
      "end_ms": 295715,
      "text": "还有一件皇帝临死前抱着不撒手第二名。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 296410,
      "end_ms": 298290,
      "text": "皇帝的玉扳指，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 299070,
      "end_ms": 304110,
      "text": "这是一个小玉环套在大拇指上打猎，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 304410,
      "end_ms": 304950,
      "text": "射箭，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 305010,
      "end_ms": 308350,
      "text": "用满清皇帝都是骑马打猎出身，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 308710,
      "end_ms": 310630,
      "text": "扳指是他们的贴身之物。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 311470,
      "end_ms": 313290,
      "text": "康熙有一个白玉扳指，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 313910,
      "end_ms": 316850,
      "text": "温润如指戴了一辈子。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 316910,
      "end_ms": 318590,
      "text": "这个扳指不是最贵的，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 319390,
      "end_ms": 321570,
      "text": "康熙的宝库里有更好的玉，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 322490,
      "end_ms": 323970,
      "text": "可他就喜欢这一个，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 324850,
      "end_ms": 327260,
      "text": "因为这是他父亲顺传给给他。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 328160,
      "end_ms": 329560,
      "text": "康熙八岁登基，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 330360,
      "end_ms": 332860,
      "text": "顺治去世前把扳指摘下来，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 332900,
      "end_ms": 334040,
      "text": "套在康熙手上，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 334440,
      "end_ms": 336920,
      "text": "说以后你就是大清的皇帝了，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 337020,
      "end_ms": 341040,
      "text": "这个扳指你带着就当爹还在你身边。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 341520,
      "end_ms": 344280,
      "text": "康熙每天都带着这个扳指上朝，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 344300,
      "end_ms": 345720,
      "text": "带着披奏折，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 345720,
      "end_ms": 353960,
      "text": "带着睡觉都带着传说康熙有一次去打猎扳指掉在草丛里了。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 353960,
      "end_ms": 355760,
      "text": "康熙急得当场就哭了，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 356550,
      "end_ms": 361045,
      "text": "几百个侍卫找了三天才找到一个玉扳指。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 361330,
      "end_ms": 362905,
      "text": "康熙待了六十多年，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 363520,
      "end_ms": 367805,
      "text": "您说这是班指还是父亲第一名？"
    },
    {
      "segment_id": "s000135",
      "start_ms": 368240,
      "end_ms": 370160,
      "text": "乾隆的田皇三连章，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 370300,
      "end_ms": 371485,
      "text": "这是三枚印章。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 371890,
      "end_ms": 374795,
      "text": "田黄时刻的每一枚都有鸡蛋的大小，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 375100,
      "end_ms": 376735,
      "text": "三枚连在一起，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 377300,
      "end_ms": 378840,
      "text": "刻着乾隆御览之宝。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 378860,
      "end_ms": 380240,
      "text": "乾隆鉴赏三夕堂，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 380300,
      "end_ms": 381015,
      "text": "今见喜。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 381360,
      "end_ms": 383805,
      "text": "田黄石是时钟之王，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 384400,
      "end_ms": 385875,
      "text": "比黄金还贵。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 386840,
      "end_ms": 387500,
      "text": "古人说，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 387740,
      "end_ms": 389655,
      "text": "一两田黄三两金，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 390430,
      "end_ms": 392510,
      "text": "乾隆用着三枚印章，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 392590,
      "end_ms": 395170,
      "text": "在他收藏的每一件文物上盖章，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 395210,
      "end_ms": 396245,
      "text": "盖了几十年，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 396580,
      "end_ms": 397975,
      "text": "盖了几万个章。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 398950,
      "end_ms": 400830,
      "text": "您知道乾隆有多宝贝？"
    },
    {
      "segment_id": "s000151",
      "start_ms": 400830,
      "end_ms": 401915,
      "text": "这三枚章吗？"
    },
    {
      "segment_id": "s000152",
      "start_ms": 402720,
      "end_ms": 403520,
      "text": "他走到哪儿，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 403520,
      "end_ms": 404245,
      "text": "带到哪儿，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 404690,
      "end_ms": 406675,
      "text": "每天都要拿出来摸一摸。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 407910,
      "end_ms": 409525,
      "text": "传说乾隆去世前，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 410090,
      "end_ms": 411210,
      "text": "躺在病床上，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 411330,
      "end_ms": 413085,
      "text": "手里还握着这三枚章，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 413940,
      "end_ms": 414925,
      "text": "太监想拿走。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 415840,
      "end_ms": 416555,
      "text": "乾隆说，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 417420,
      "end_ms": 417905,
      "text": "别动，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 418840,
      "end_ms": 419775,
      "text": "让我再摸摸。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 420650,
      "end_ms": 421935,
      "text": "乾隆死的时候，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 422830,
      "end_ms": 424655,
      "text": "这三枚章就握在手里。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 425710,
      "end_ms": 428245,
      "text": "后来嘉庆从他手里掰出来，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 428810,
      "end_ms": 430985,
      "text": "才放进了库房三枚印章，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 431830,
      "end_ms": 433705,
      "text": "乾隆带进了棺材边缘。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 434500,
      "end_ms": 437300,
      "text": "您说这是印章还是一生的执念？"
    },
    {
      "segment_id": "s000168",
      "start_ms": 437440,
      "end_ms": 438895,
      "text": "从第五到第一名，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 439220,
      "end_ms": 440875,
      "text": "这五件东西更特别。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 441730,
      "end_ms": 444335,
      "text": "康熙的御笔用了几十年，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 445090,
      "end_ms": 446050,
      "text": "笔杆裂了，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 446050,
      "end_ms": 448910,
      "text": "还舍不得扔皇帝的香囊。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 449210,
      "end_ms": 450335,
      "text": "睡前闻一闻，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 450860,
      "end_ms": 451780,
      "text": "闻的不是香，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 451860,
      "end_ms": 454855,
      "text": "是思念乾隆的三七堂法帖，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 455230,
      "end_ms": 457085,
      "text": "每天吃饭前都要看一眼。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 457330,
      "end_ms": 458365,
      "text": "看了几十年，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 458820,
      "end_ms": 461685,
      "text": "康熙的玉扳指是父亲传的，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 461950,
      "end_ms": 462270,
      "text": "丢了，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 462270,
      "end_ms": 463105,
      "text": "当场就哭。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 463590,
      "end_ms": 467905,
      "text": "乾隆的田黄三连章临死前握在手里不撒手，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 468710,
      "end_ms": 470335,
      "text": "十件东西讲完了，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 470900,
      "end_ms": 471885,
      "text": "您发现没有？"
    },
    {
      "segment_id": "s000184",
      "start_ms": 472580,
      "end_ms": 474700,
      "text": "皇帝每天用的不是金碗，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 474720,
      "end_ms": 475460,
      "text": "不是龙椅，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 475520,
      "end_ms": 476635,
      "text": "是这些小物件，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 477760,
      "end_ms": 481985,
      "text": "一只小酒杯、一支毛笔、一个香囊，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 482420,
      "end_ms": 485085,
      "text": "一个扳指、三枚印章。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 485880,
      "end_ms": 487375,
      "text": "这些东西不是最贵的，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 488370,
      "end_ms": 489935,
      "text": "可皇帝最离不开。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 493430,
      "end_ms": 495115,
      "text": "因为这些东西上面有感情。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 495730,
      "end_ms": 497270,
      "text": "成化摔碎纪刚杯，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 497270,
      "end_ms": 498165,
      "text": "心疼的重烧，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 498930,
      "end_ms": 500470,
      "text": "康熙的笔用到裂了，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 500470,
      "end_ms": 501315,
      "text": "还舍不得扔。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 502320,
      "end_ms": 505155,
      "text": "乾隆的香囊装的是母亲的味道，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 505790,
      "end_ms": 508055,
      "text": "康熙的扳指是父亲传的，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 508790,
      "end_ms": 511975,
      "text": "乾隆的印章临死前还握在手里，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 512810,
      "end_ms": 514005,
      "text": "皇帝也是人，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 514360,
      "end_ms": 515700,
      "text": "也有七情六欲，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 516120,
      "end_ms": 517060,
      "text": "也会念旧，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 517200,
      "end_ms": 518175,
      "text": "也会思念，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 518510,
      "end_ms": 520090,
      "text": "也会心疼一件东西。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 520860,
      "end_ms": 522800,
      "text": "老祖宗留给咱们的，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 522800,
      "end_ms": 523980,
      "text": "不只是这些器物，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 524260,
      "end_ms": 527470,
      "text": "是告诉咱们真正珍贵的东西，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 527470,
      "end_ms": 529025,
      "text": "不是用钱能买到，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 529580,
      "end_ms": 531095,
      "text": "是那些承载的感情，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 531570,
      "end_ms": 533170,
      "text": "陪伴了岁月的东西。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 534070,
      "end_ms": 536425,
      "text": "您手里有没有这样一件东西？"
    },
    {
      "segment_id": "s000211",
      "start_ms": 536770,
      "end_ms": 537790,
      "text": "用了很多年，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 538090,
      "end_ms": 538910,
      "text": "舍不得扔。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 539270,
      "end_ms": 540565,
      "text": "评论区告诉我，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 541470,
      "end_ms": 542535,
      "text": "最后问你一句，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 543350,
      "end_ms": 546960,
      "text": "这十件器物您最想看哪一件去故宫？"
    },
    {
      "segment_id": "s000216",
      "start_ms": 547240,
      "end_ms": 548815,
      "text": "一定要去珍宝馆，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 549220,
      "end_ms": 551485,
      "text": "有些就在那儿点个关注。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 551830,
      "end_ms": 554990,
      "text": "下次咱们聊聊故宫里那些皇后妃子，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 554990,
      "end_ms": 558195,
      "text": "每天用的东西比皇帝的更有意思。"
    }
  ],
  "source_transcript_sha256": "9c8ca3d564ce1efae9d831f124605088c788474297d2ba9391ba253dae2706ff"
}