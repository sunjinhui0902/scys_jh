{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_33f1e4063c99a716_u001",
  "video_id": "v_33f1e4063c99a716",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 926.593991,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 380,
      "end_ms": 2800,
      "text": "十五分钟讲解韩炳哲他者的消失。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2980,
      "end_ms": 9560,
      "text": "有一本书在全球哲学系与文化研究课堂被讨论了超过十年被译成十几种语言，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 9860,
      "end_ms": 12680,
      "text": "却在中文世界的公共知识讨论里几乎隐形。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 13060,
      "end_ms": 14180,
      "text": "不是因为他不重要，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 14280,
      "end_ms": 15540,
      "text": "而是因为他太危险。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 16040,
      "end_ms": 16720,
      "text": "危险到会，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16720,
      "end_ms": 19800,
      "text": "让你对自我自由连接的全部认知。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 19840,
      "end_ms": 21000,
      "text": "发生七级地震。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21240,
      "end_ms": 23020,
      "text": "这本书叫他者的消失。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 23700,
      "end_ms": 24100,
      "text": "作者，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 24100,
      "end_ms": 26620,
      "text": "韩炳哲是柏林艺术大学的哲学教授，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 26760,
      "end_ms": 28900,
      "text": "但比这个头衔更值得注意的是，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 28900,
      "end_ms": 30910,
      "text": "他成为哲学家之前的身份，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 31210,
      "end_ms": 33410,
      "text": "一个冶金学专业的工科生。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 33850,
      "end_ms": 36410,
      "text": "一九五九年生于首尔八十年代，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 36410,
      "end_ms": 38950,
      "text": "在高利大学学习冶金学之后，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 38950,
      "end_ms": 40290,
      "text": "远渡重洋到德国，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 40450,
      "end_ms": 44730,
      "text": "先后在弗莱堡和慕尼黑学习哲学、德国文学和天主教神学。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 44970,
      "end_ms": 45810,
      "text": "一九九四年，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 45850,
      "end_ms": 47410,
      "text": "已研究海德格尔的论文，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 47450,
      "end_ms": 49210,
      "text": "获得弗莱堡大学博士学位。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 49690,
      "end_ms": 51190,
      "text": "一个曾经拆卸拼接，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 51250,
      "end_ms": 52670,
      "text": "做化学实验的技术控，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 52930,
      "end_ms": 56090,
      "text": "转身去研究人类最复杂的认知传统之一。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 56410,
      "end_ms": 58010,
      "text": "邻居们或许觉得他疯了。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 58570,
      "end_ms": 59270,
      "text": "离谱的是，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 59550,
      "end_ms": 62815,
      "text": "韩炳哲和把这种双重身份的思考写成书之后，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 63130,
      "end_ms": 64230,
      "text": "遭遇的不是追捧，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 64390,
      "end_ms": 67300,
      "text": "是来自两个阵营的同时围攻技术。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 67300,
      "end_ms": 67900,
      "text": "乐观派说，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 67900,
      "end_ms": 69140,
      "text": "他否定数字进步，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 69280,
      "end_ms": 71825,
      "text": "保守派嫌他把哲学变成了文化批评。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 72290,
      "end_ms": 76675,
      "text": "人们宁可相信一个工科生转行哲学是某种浪漫主义的任性，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 77120,
      "end_ms": 78855,
      "text": "也不愿面对一个可怕的真相。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 79240,
      "end_ms": 82865,
      "text": "你对连接和自由的认知从根儿上就错了。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 83110,
      "end_ms": 87475,
      "text": "今天这条文字我会拆出这本书里最颠覆的五个底层认知。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 88110,
      "end_ms": 89030,
      "text": "但我要提前警告，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 89030,
      "end_ms": 94820,
      "text": "你看完后你可能会推翻过去二十年、三十年奉为归孽的连接，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 94840,
      "end_ms": 97940,
      "text": "等于幸福表达等于自由的认知框架。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 98020,
      "end_ms": 99420,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 99720,
      "end_ms": 101040,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 101100,
      "end_ms": 102305,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 102510,
      "end_ms": 103705,
      "text": "那我们开始进入正题，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 103960,
      "end_ms": 105630,
      "text": "第一层颠覆他者，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 105630,
      "end_ms": 106435,
      "text": "不是别人，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 106860,
      "end_ms": 107380,
      "text": "是一种你，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 107380,
      "end_ms": 109140,
      "text": "正在失去的认知器观。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 109260,
      "end_ms": 110320,
      "text": "你有没有听过这句话，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 110480,
      "end_ms": 111640,
      "text": "现在通讯这么发达，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 111780,
      "end_ms": 113385,
      "text": "人和人的距离反而更远了，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 114230,
      "end_ms": 116005,
      "text": "你把它当成一句文青的感慨，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 116560,
      "end_ms": 117400,
      "text": "他者的消失。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 117420,
      "end_ms": 120375,
      "text": "开篇第一个动作就把这套认知判了死刑。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 121150,
      "end_ms": 123045,
      "text": "韩敏哲给他者下了一个定义，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 123420,
      "end_ms": 124635,
      "text": "他者不是别人，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 124900,
      "end_ms": 125835,
      "text": "不是另一个我，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 126240,
      "end_ms": 128285,
      "text": "而是一种绝对他意性，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 128710,
      "end_ms": 131565,
      "text": "一个无法被自我完全同化的存在。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 131920,
      "end_ms": 132320,
      "text": "注意，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 132630,
      "end_ms": 133355,
      "text": "不是朋友，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 133630,
      "end_ms": 134425,
      "text": "不是敌人，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 134650,
      "end_ms": 135455,
      "text": "不是陌生人，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 135940,
      "end_ms": 138480,
      "text": "是一种具有否定性的抑志存在。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 138520,
      "end_ms": 140445,
      "text": "他拒绝被你的认知框架消化，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 140790,
      "end_ms": 142555,
      "text": "拒绝被你的算法推荐归类，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 142860,
      "end_ms": 143180,
      "text": "拒绝，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 143180,
      "end_ms": 144765,
      "text": "被你用一个标签打发掉。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 145070,
      "end_ms": 147135,
      "text": "这听上去像是哲学家的故弄玄虚。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 147540,
      "end_ms": 148405,
      "text": "但你仔细想想，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 148770,
      "end_ms": 151470,
      "text": "你上一次遇到一个真正让你不舒服的观点是，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 151470,
      "end_ms": 153800,
      "text": "什么时候你上一次被一本书，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 154000,
      "end_ms": 155780,
      "text": "一个人一句话逼到，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 155780,
      "end_ms": 157580,
      "text": "不得不重新思考自己是谁，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 157840,
      "end_ms": 158655,
      "text": "是什么时候，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 159080,
      "end_ms": 162355,
      "text": "大概率你想不起来不是因为你聪明了，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 162610,
      "end_ms": 166810,
      "text": "而是因为你的信息环境已经精密到可以把你保护的密不透风。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 167030,
      "end_ms": 167750,
      "text": "韩秉哲说，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 168090,
      "end_ms": 172530,
      "text": "数字化的全联网和全交际并未使我们更容易遇见他者。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 172610,
      "end_ms": 173005,
      "text": "相反，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 173270,
      "end_ms": 176930,
      "text": "他恰恰更便于我们从陌生者和存在者身边经过，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 177010,
      "end_ms": 178135,
      "text": "不是他们的存在，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 178420,
      "end_ms": 180315,
      "text": "寻找同者、志同道合者，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 180720,
      "end_ms": 183255,
      "text": "从而导致我们的经验视野日渐狭窄。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 183570,
      "end_ms": 185150,
      "text": "这套话语的隐蔽暴力在于，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 185310,
      "end_ms": 187805,
      "text": "他先把你关进一个只有回声的房间，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 188220,
      "end_ms": 189940,
      "text": "然后告诉你这是自由。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 190020,
      "end_ms": 191600,
      "text": "韩敏哲在书中反复强调，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 191600,
      "end_ms": 194595,
      "text": "一个判断他者的时代已然逝去。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 195020,
      "end_ms": 199460,
      "text": "那朋友似的地狱般的神秘的诱惑的爱欲的他者，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 199600,
      "end_ms": 200820,
      "text": "以让位于同者，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 201120,
      "end_ms": 205355,
      "text": "使社会体害病的不是异化、退隐禁令和压制，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 205690,
      "end_ms": 209815,
      "text": "而是过度交际、过度信息、过度生产和过度消费。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 210220,
      "end_ms": 211705,
      "text": "这不是贩卖怀旧主义，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 212200,
      "end_ms": 214940,
      "text": "这是一个工科生用他受过训练的思维，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 215180,
      "end_ms": 219515,
      "text": "重新审视一个被数字乌托邦叙事遮蔽的认知灾难。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 219990,
      "end_ms": 223875,
      "text": "他者不要求你喜欢他他要求你承认他的存在，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 224430,
      "end_ms": 226955,
      "text": "你可以承认一个与你截然不同的人的存在，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 227200,
      "end_ms": 228705,
      "text": "同时拒绝他的立场。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 229250,
      "end_ms": 231785,
      "text": "就像你可以承认一种你不理解的生活方式，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 232110,
      "end_ms": 235675,
      "text": "同时不选择他他者首先是一个认知对象，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 236040,
      "end_ms": 238015,
      "text": "然后才是一个立场选择。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 238300,
      "end_ms": 240910,
      "text": "第二重颠覆同质化的暴力，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 241050,
      "end_ms": 242590,
      "text": "是一种你看不见的暴力。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 243050,
      "end_ms": 244630,
      "text": "我们这代人从小被灌输，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 244810,
      "end_ms": 245290,
      "text": "暴力，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 245290,
      "end_ms": 245950,
      "text": "就是压制，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 246210,
      "end_ms": 247030,
      "text": "就是禁止，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 247290,
      "end_ms": 248630,
      "text": "就是有人不让你说话。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 248730,
      "end_ms": 250910,
      "text": "所以当一个人说我觉得很自由时，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 251250,
      "end_ms": 253430,
      "text": "大家会下意识觉得他真的自由了。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 253450,
      "end_ms": 254250,
      "text": "八者的消失，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 254330,
      "end_ms": 257870,
      "text": "用一整套社会并理学分析砸碎了这套二元论。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 257870,
      "end_ms": 258510,
      "text": "韩敏哲说，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 259110,
      "end_ms": 261130,
      "text": "所谓压迫与自由的二元对立，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 261310,
      "end_ms": 264010,
      "text": "本身就是一个需要被审视的哲学立场，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 264250,
      "end_ms": 265810,
      "text": "而不是一个自明的真理。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 266270,
      "end_ms": 268330,
      "text": "你把压制和自由放在天平两端，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 268330,
      "end_ms": 272780,
      "text": "但你从来没有我问过这两样东西真的在同一个层面上吗？"
    },
    {
      "segment_id": "s000119",
      "start_ms": 273120,
      "end_ms": 276260,
      "text": "他提出了一个关键区分同质化的暴力，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 276400,
      "end_ms": 278880,
      "text": "因其肯定性而不可见什么意思？"
    },
    {
      "segment_id": "s000121",
      "start_ms": 279180,
      "end_ms": 281160,
      "text": "来自他者的暴力是可见的。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 281340,
      "end_ms": 284400,
      "text": "他表现为禁令压制否定他，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 284400,
      "end_ms": 285940,
      "text": "不感觉到他在压迫你。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 285980,
      "end_ms": 287140,
      "text": "所以你知道要反抗，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 287580,
      "end_ms": 289360,
      "text": "但同质化的暴力完全不同。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 289720,
      "end_ms": 290740,
      "text": "他不否迫你，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 290960,
      "end_ms": 291920,
      "text": "他迎合你，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 292340,
      "end_ms": 293360,
      "text": "他不禁止你，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 293660,
      "end_ms": 294620,
      "text": "他诱惑你，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 295100,
      "end_ms": 296120,
      "text": "他不否定你，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 296300,
      "end_ms": 297260,
      "text": "他迎合你，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 297320,
      "end_ms": 299970,
      "text": "他让你觉得一切都在你自己的选择之中，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 300270,
      "end_ms": 302695,
      "text": "一切都在朝着你喜欢的方向发展。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 302900,
      "end_ms": 303940,
      "text": "韩炳哲进一步说，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 304480,
      "end_ms": 306745,
      "text": "同者的扩散形成病理变化。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 307130,
      "end_ms": 308670,
      "text": "对社会体造成侵害，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 309190,
      "end_ms": 311310,
      "text": "自某一特定的点开始生产，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 311330,
      "end_ms": 312490,
      "text": "不再是创造性的，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 312490,
      "end_ms": 313530,
      "text": "而是破坏性的。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 314050,
      "end_ms": 316030,
      "text": "信息不再是有启发性的，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 316130,
      "end_ms": 316850,
      "text": "而是扭曲。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 316850,
      "end_ms": 317530,
      "text": "变形的。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 317930,
      "end_ms": 319210,
      "text": "交流不再是沟通，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 319450,
      "end_ms": 321550,
      "text": "而仅仅是言语的堆积而已。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 322710,
      "end_ms": 324110,
      "text": "这句话可能会刺痛你，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 324590,
      "end_ms": 326330,
      "text": "你总说我在做自己，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 326810,
      "end_ms": 330870,
      "text": "可你有没有想过你的自己有多少是算法推荐的结果？"
    },
    {
      "segment_id": "s000148",
      "start_ms": 330870,
      "end_ms": 335430,
      "text": "你喜欢的东西有多少是平台根据你的行为数据预测出来的。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 335430,
      "end_ms": 336805,
      "text": "你以为你在自由选择，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 337140,
      "end_ms": 340300,
      "text": "其实你只是在确认一个已经被计算好的答案。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 340660,
      "end_ms": 342400,
      "text": "韩敏哲不是要否定个性，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 342840,
      "end_ms": 343840,
      "text": "他是要告诉你，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 343980,
      "end_ms": 345680,
      "text": "当所有他者都被清除。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 346160,
      "end_ms": 347960,
      "text": "当所有否定性都被过滤。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 348400,
      "end_ms": 349820,
      "text": "你以为你在做自己，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 350180,
      "end_ms": 353340,
      "text": "其实你只是在无限循环的遇见同一个自己。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 354040,
      "end_ms": 355860,
      "text": "这种循环不是自由的胜利，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 356280,
      "end_ms": 358240,
      "text": "这是所有自我认知的终点。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 359520,
      "end_ms": 360700,
      "text": "你信仰做自己，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 360920,
      "end_ms": 362260,
      "text": "和你信仰算法。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 362280,
      "end_ms": 365080,
      "text": "懂我在认知结构上没有本质区别，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 365540,
      "end_ms": 369015,
      "text": "区别只在于后者把问题推到了更深的层面。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 369350,
      "end_ms": 373210,
      "text": "谁在定义自己第三层颠覆他者的消失，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 373390,
      "end_ms": 374550,
      "text": "触发的不是孤独，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 374690,
      "end_ms": 375845,
      "text": "是自我毁灭。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 376700,
      "end_ms": 377840,
      "text": "主流认知告诉你，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 377920,
      "end_ms": 379175,
      "text": "孤独是没人陪，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 379610,
      "end_ms": 381880,
      "text": "连接是简要这套模式的。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 381880,
      "end_ms": 382705,
      "text": "潜台词是，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 383130,
      "end_ms": 384390,
      "text": "只要社交够多，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 384670,
      "end_ms": 385905,
      "text": "孤独就不存在。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 386280,
      "end_ms": 387265,
      "text": "但韩炳哲说，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 387850,
      "end_ms": 388535,
      "text": "这是错的。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 389000,
      "end_ms": 392235,
      "text": "他建立了一套被称为暴力辩证法的分析框架，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 392560,
      "end_ms": 395525,
      "text": "彻底扭转了我们对孤独和连接的认知。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 395940,
      "end_ms": 397245,
      "text": "什么叫暴力辩证法？"
    },
    {
      "segment_id": "s000177",
      "start_ms": 397770,
      "end_ms": 398355,
      "text": "简单说，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 398780,
      "end_ms": 403325,
      "text": "拒绝他者否定性的体系会引发自我毁灭动向，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 403830,
      "end_ms": 405615,
      "text": "所有的认知都是近似的。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 405930,
      "end_ms": 407330,
      "text": "我们尽力描述真实，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 407530,
      "end_ms": 409775,
      "text": "但永远知道自己描述的是有限的。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 410350,
      "end_ms": 412490,
      "text": "当你把所有的他者都驱逐出去。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 412710,
      "end_ms": 414810,
      "text": "当你把所有的否定性都消解掉，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 415130,
      "end_ms": 417605,
      "text": "剩下的只有同者的无限增值。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 418110,
      "end_ms": 422195,
      "text": "这套方法的核心是你不能因为一个认知不完美就把它扔掉，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 422550,
      "end_ms": 423710,
      "text": "也不能因为它有用，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 423790,
      "end_ms": 424825,
      "text": "就把它绝对化。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 425350,
      "end_ms": 427055,
      "text": "产品者反对两种极端，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 427600,
      "end_ms": 429655,
      "text": "一是连接万能论的傲慢，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 430140,
      "end_ms": 432075,
      "text": "以为社交越多就越幸福。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 432510,
      "end_ms": 433950,
      "text": "二是孤独可耻。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 433950,
      "end_ms": 434645,
      "text": "论的投降，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 435150,
      "end_ms": 437775,
      "text": "以为独处是一种需要被治愈的病症。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 438250,
      "end_ms": 440375,
      "text": "暴力辩证法走的是第三条路，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 440830,
      "end_ms": 444225,
      "text": "在肯定性的海洋中保留否定性的岛屿。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 444670,
      "end_ms": 445485,
      "text": "韩炳哲写道，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 446050,
      "end_ms": 447130,
      "text": "如今的病态时代，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 447130,
      "end_ms": 448615,
      "text": "标志不是压制，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 448890,
      "end_ms": 449735,
      "text": "而是抑郁，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 450210,
      "end_ms": 451410,
      "text": "具有毁灭性的压力，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 451410,
      "end_ms": 452715,
      "text": "并非来自他人，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 453070,
      "end_ms": 454215,
      "text": "而是来自内心。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 454820,
      "end_ms": 455920,
      "text": "抑郁的功能主体，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 456020,
      "end_ms": 458005,
      "text": "仿佛被自己打死或扼杀，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 458540,
      "end_ms": 461135,
      "text": "具有毁灭性的不仅仅是他者的暴力。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 461690,
      "end_ms": 467360,
      "text": "他者的消失触发了另外一个全然不同的毁灭过程及自我毁灭，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 467560,
      "end_ms": 470715,
      "text": "这其实也是当代精神健康领域炒了几十年的问题。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 471140,
      "end_ms": 471980,
      "text": "弗洛伊德说，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 472200,
      "end_ms": 473975,
      "text": "抑郁是向内的攻击性。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 474360,
      "end_ms": 475080,
      "text": "科胡特说，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 475200,
      "end_ms": 477415,
      "text": "自恋的障碍源于共情的缺失。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 477850,
      "end_ms": 479650,
      "text": "韩炳哲把同样的分析工具，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 479710,
      "end_ms": 481675,
      "text": "用在数字时代的自我诊断上，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 481950,
      "end_ms": 483815,
      "text": "不断在社交媒体上展示自己，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 484080,
      "end_ms": 485800,
      "text": "不断追求点赞和认可，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 486020,
      "end_ms": 487400,
      "text": "不断优化那个人设。"
    },
    {
      "segment_id": "s000217",
      "start_ms": 487640,
      "end_ms": 489265,
      "text": "但你不是在连接他人，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 489600,
      "end_ms": 490720,
      "text": "你是在自我喂养，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 490760,
      "end_ms": 492080,
      "text": "你消费的每一条内容，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 492080,
      "end_ms": 493805,
      "text": "都在确认你已有的观点。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 494160,
      "end_ms": 497060,
      "text": "你遇到的每一个人都在尽向你已有的偏好。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 497320,
      "end_ms": 498985,
      "text": "在一个没有他者的世界里，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 499220,
      "end_ms": 500880,
      "text": "你的自我不是被压制了，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 500960,
      "end_ms": 502180,
      "text": "而是被撑大了，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 502280,
      "end_ms": 503120,
      "text": "撑到梗死。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 503220,
      "end_ms": 505555,
      "text": "你看到的每一条信息都是你喜欢的。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 505830,
      "end_ms": 508135,
      "text": "你听到的每一个声音都是你同意的，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 508390,
      "end_ms": 510730,
      "text": "你遇见的每一个人都是像你的。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 511070,
      "end_ms": 512565,
      "text": "在这种完美的同治中，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 512810,
      "end_ms": 515385,
      "text": "你没有变得完整、易变得空洞，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 515900,
      "end_ms": 519340,
      "text": "抑郁便是源于自我性力的自恋式机制。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 519420,
      "end_ms": 521780,
      "text": "你不能用测量流量的方式测量意义。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 522040,
      "end_ms": 524040,
      "text": "但你也不能因为流量数据漂亮，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 524120,
      "end_ms": 525240,
      "text": "就说意义存在。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 525380,
      "end_ms": 527220,
      "text": "第四层颠覆恐怖主义，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 527220,
      "end_ms": 528400,
      "text": "不是他者的暴力，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 528540,
      "end_ms": 531425,
      "text": "是全球化的同质暴力逼出的反抗。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 531820,
      "end_ms": 533440,
      "text": "市面上关于全球化的讨论，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 533540,
      "end_ms": 536325,
      "text": "美百分之九十九都集中在经济效率层面。"
    },
    {
      "segment_id": "s000240",
      "start_ms": 536810,
      "end_ms": 540235,
      "text": "全球化好不好看GDP看贸易额、看供应链。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 540660,
      "end_ms": 543150,
      "text": "这套模式的潜台词是同质化，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 543210,
      "end_ms": 544365,
      "text": "是效率的代价，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 544650,
      "end_ms": 545185,
      "text": "值得。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 545670,
      "end_ms": 546525,
      "text": "韩炳哲说，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 547040,
      "end_ms": 547680,
      "text": "你错了。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 547780,
      "end_ms": 549860,
      "text": "他把全球化放回暴利的领域，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 550000,
      "end_ms": 551875,
      "text": "全球化中蕴含着一种暴力。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 552160,
      "end_ms": 555070,
      "text": "他使一切都变得可交换全球化的暴力，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 555070,
      "end_ms": 556555,
      "text": "也就是同质化的暴力。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 556880,
      "end_ms": 564920,
      "text": "他摧毁他者独特性以及不可比较之物的否定性这一否定性妨碍信息交际和资本的循环。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 565100,
      "end_ms": 567480,
      "text": "恐怖活动是同质化暴力的一个恶果，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 567740,
      "end_ms": 569080,
      "text": "是以独特性的恐怖，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 569180,
      "end_ms": 570755,
      "text": "对抗全球化的恐怖。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 571140,
      "end_ms": 572180,
      "text": "他画了大量篇幅，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 572180,
      "end_ms": 575995,
      "text": "梳理恐惧、全球化、恐怖主义之间的内在逻辑，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 576480,
      "end_ms": 579685,
      "text": "每一个时代的认知框架都被清晰的呈现出来。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 580380,
      "end_ms": 582115,
      "text": "他不是让你理解恐怖分子，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 582680,
      "end_ms": 586890,
      "text": "它是让你理解一个被全球化叙事遮蔽的真相当，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 586890,
      "end_ms": 589225,
      "text": "你把所有东西都变成可交换的商品。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 589590,
      "end_ms": 592415,
      "text": "当所有文化都被同质化为消费选择。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 592780,
      "end_ms": 595285,
      "text": "当所有差异都被抹平为数据点，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 595810,
      "end_ms": 597110,
      "text": "你消除的不是冲突，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 597450,
      "end_ms": 599645,
      "text": "你消除的是冲突的前提。"
    },
    {
      "segment_id": "s000264",
      "start_ms": 600420,
      "end_ms": 602580,
      "text": "而冲突的前提一旦被消除，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 603020,
      "end_ms": 604240,
      "text": "剩下的不是和平，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 604660,
      "end_ms": 606015,
      "text": "是更深的绝望。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 606490,
      "end_ms": 607115,
      "text": "你写道，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 607710,
      "end_ms": 609830,
      "text": "恐怖活动不是对他者的反抗，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 610150,
      "end_ms": 612845,
      "text": "是对被同质化到窒息的最后挣扎。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 613170,
      "end_ms": 617410,
      "text": "这句话的深层含义是你不必是哲学家才能理解全球化，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 617650,
      "end_ms": 620230,
      "text": "就像你不必是心理学家才能理解抑郁，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 620230,
      "end_ms": 622490,
      "text": "你需要的只是诚实的面对一个事实，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 622890,
      "end_ms": 625250,
      "text": "同质化的扩散不是和平的到来。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 625510,
      "end_ms": 627570,
      "text": "它可能是另一种暴力的开始，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 628150,
      "end_ms": 630090,
      "text": "公共知识不等于强制检验，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 630470,
      "end_ms": 633510,
      "text": "它意味着可讨论、可批评、可修正。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 633950,
      "end_ms": 638770,
      "text": "全球化叙事在公共领域要接受文化伦理心理的交叉检验，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 639310,
      "end_ms": 642010,
      "text": "它不能躲在这是效率后面拒绝提问，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 642210,
      "end_ms": 644780,
      "text": "也不能因为被提问就觉得自己被冒犯。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 645380,
      "end_ms": 648260,
      "text": "第五层颠覆真正的出路，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 648360,
      "end_ms": 649580,
      "text": "不是更多的表达，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 649960,
      "end_ms": 651500,
      "text": "是重新学会倾听。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 651600,
      "end_ms": 652080,
      "text": "读到这里，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 652080,
      "end_ms": 652800,
      "text": "你可能想问，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 652980,
      "end_ms": 657240,
      "text": "说了这么多最终目标不还是让人放弃社交媒体回到前现代码，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 657560,
      "end_ms": 659560,
      "text": "而是你这样想你就掉进了这本书，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 659560,
      "end_ms": 660640,
      "text": "埋了十年的陷阱。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 661240,
      "end_ms": 665960,
      "text": "韩秉哲用一生证明的不是数字技术有害这个廉价的反技术口号，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 666520,
      "end_ms": 668960,
      "text": "而是把连接等同于交流，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 669340,
      "end_ms": 672080,
      "text": "本身就是一种被制造出来的叙事。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 672500,
      "end_ms": 674210,
      "text": "他最大他的颠覆不是立场，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 674410,
      "end_ms": 675205,
      "text": "是方法。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 675490,
      "end_ms": 676715,
      "text": "他在书里反复强调，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 677100,
      "end_ms": 678395,
      "text": "我写的是一本诊断，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 678670,
      "end_ms": 679595,
      "text": "不是一张药方。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 680030,
      "end_ms": 681955,
      "text": "我的任务不是让你拒绝手机，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 682290,
      "end_ms": 683690,
      "text": "是让你有能力识别。"
    },
    {
      "segment_id": "s000298",
      "start_ms": 683710,
      "end_ms": 685230,
      "text": "什么时候你在连接，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 685490,
      "end_ms": 687155,
      "text": "什么时候你在自欺。"
    },
    {
      "segment_id": "s000300",
      "start_ms": 687550,
      "end_ms": 695955,
      "text": "他把恐惧、全球化、恐怖主义、自恋、抑郁这几个社会症候拆开来给你看每一个现象背后的骨骼，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 696590,
      "end_ms": 698490,
      "text": "谁在什么处境下生产了他们，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 698570,
      "end_ms": 699605,
      "text": "他们如何运作，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 699840,
      "end_ms": 701225,
      "text": "他们的对手又是什么。"
    },
    {
      "segment_id": "s000304",
      "start_ms": 701510,
      "end_ms": 705305,
      "text": "然后他退后一步说你自己判断为什么？"
    },
    {
      "segment_id": "s000305",
      "start_ms": 705770,
      "end_ms": 706955,
      "text": "因为他太清楚。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 707340,
      "end_ms": 708820,
      "text": "在数字时代的困境中，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 709040,
      "end_ms": 710755,
      "text": "最稀缺的不是表达，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 711160,
      "end_ms": 712340,
      "text": "是倾听的能力。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 712440,
      "end_ms": 713375,
      "text": "韩敏哲指出，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 713800,
      "end_ms": 716005,
      "text": "数字化媒体是去身体化的，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 716460,
      "end_ms": 717920,
      "text": "他遮蔽了目光的交流，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 718140,
      "end_ms": 719645,
      "text": "夺走了声音的纹理，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 719980,
      "end_ms": 721200,
      "text": "是他者之语言，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 721460,
      "end_ms": 722475,
      "text": "他者之思想，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 722810,
      "end_ms": 723290,
      "text": "他者之，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 723290,
      "end_ms": 725215,
      "text": "时间纷纷销声匿迹。"
    },
    {
      "segment_id": "s000317",
      "start_ms": 725530,
      "end_ms": 725930,
      "text": "如今，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 726070,
      "end_ms": 727230,
      "text": "众生喧哗的倦怠，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 727230,
      "end_ms": 728955,
      "text": "社会里没有倾听可言，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 729310,
      "end_ms": 732330,
      "text": "而未来的社会或可称为倾听者的社会，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 732450,
      "end_ms": 733930,
      "text": "人们需要一场时间革命，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 734190,
      "end_ms": 736155,
      "text": "开启一种完全不同的时间，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 736450,
      "end_ms": 738825,
      "text": "一种容纳他者的神圣世界。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 739330,
      "end_ms": 740605,
      "text": "倾听不是被动，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 740910,
      "end_ms": 741695,
      "text": "不是沉默，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 742180,
      "end_ms": 743060,
      "text": "不是等待对方。"
    },
    {
      "segment_id": "s000327",
      "start_ms": 743060,
      "end_ms": 743640,
      "text": "说完好，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 743640,
      "end_ms": 744615,
      "text": "轮到自己说，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 745530,
      "end_ms": 746765,
      "text": "倾听是一种能力，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 747250,
      "end_ms": 748750,
      "text": "承受他者的否定性，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 749030,
      "end_ms": 750350,
      "text": "允许自己被质疑，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 750590,
      "end_ms": 752335,
      "text": "在对话中真正被改变。"
    },
    {
      "segment_id": "s000333",
      "start_ms": 753280,
      "end_ms": 756085,
      "text": "你不需要在线上和线下之间做选择。"
    },
    {
      "segment_id": "s000334",
      "start_ms": 756600,
      "end_ms": 759465,
      "text": "你需要先搞清楚你选择的是什么？"
    },
    {
      "segment_id": "s000335",
      "start_ms": 759820,
      "end_ms": 761580,
      "text": "是那个被算法投喂的回声士，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 761840,
      "end_ms": 763935,
      "text": "是那个被点赞确认的自恋镜像，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 764440,
      "end_ms": 768475,
      "text": "还是一个需要通过承受否定性才能确立的真实自我。"
    },
    {
      "segment_id": "s000338",
      "start_ms": 769400,
      "end_ms": 771980,
      "text": "韩炳哲的写作本身就在践行他所说的，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 771980,
      "end_ms": 773550,
      "text": "倾听他的书，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 773550,
      "end_ms": 774535,
      "text": "不求你我点赞，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 774900,
      "end_ms": 776060,
      "text": "只求警醒世人。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 776120,
      "end_ms": 780975,
      "text": "韩秉哲用他的文章和书籍开辟了一条横穿当代文学之林的甬道。"
    },
    {
      "segment_id": "s000343",
      "start_ms": 781510,
      "end_ms": 782195,
      "text": "他写道，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 782700,
      "end_ms": 784960,
      "text": "真正的经验是不断推翻自己，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 785200,
      "end_ms": 786615,
      "text": "重塑自身的过程，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 787080,
      "end_ms": 788580,
      "text": "其本质是痛楚。"
    },
    {
      "segment_id": "s000347",
      "start_ms": 788720,
      "end_ms": 792025,
      "text": "所以你看这本书最惊世骇俗的答案藏在这里，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 792430,
      "end_ms": 794190,
      "text": "学会理解他者的消失。"
    },
    {
      "segment_id": "s000349",
      "start_ms": 794390,
      "end_ms": 797715,
      "text": "最大的收获不是获得了某种抵抗数字生活的技巧，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 798030,
      "end_ms": 801125,
      "text": "而是获得了一种在复杂问题面前不慌张的能力。"
    },
    {
      "segment_id": "s000351",
      "start_ms": 801350,
      "end_ms": 802330,
      "text": "你不必急于表态，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 802550,
      "end_ms": 804655,
      "text": "你有能力理解一个论证的质地，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 805010,
      "end_ms": 806990,
      "text": "你有耐心等待思考的成熟。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 807050,
      "end_ms": 808345,
      "text": "你不必急于反驳，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 808800,
      "end_ms": 815350,
      "text": "你有能力允许一个他者在你的认知世界里暂时不被消化、不被归类、不被标签化，"
    },
    {
      "segment_id": "s000356",
      "start_ms": 815670,
      "end_ms": 816690,
      "text": "读完他者的消失。"
    },
    {
      "segment_id": "s000357",
      "start_ms": 816770,
      "end_ms": 818675,
      "text": "你可能发现书名起错了，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 819630,
      "end_ms": 821815,
      "text": "这不是一本数字时代的批判手册，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 822250,
      "end_ms": 826905,
      "text": "是一本关于人如何在连接与孤独之间安身立命的哲学手记。"
    },
    {
      "segment_id": "s000360",
      "start_ms": 827360,
      "end_ms": 828520,
      "text": "冶金学不是重点，"
    },
    {
      "segment_id": "s000361",
      "start_ms": 828760,
      "end_ms": 830040,
      "text": "海德格尔不是重点，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 830200,
      "end_ms": 831935,
      "text": "暴力辩证法也不是重点。"
    },
    {
      "segment_id": "s000363",
      "start_ms": 832630,
      "end_ms": 835475,
      "text": "重点是那个从冶金专业转行的学者，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 835800,
      "end_ms": 838940,
      "text": "面对一个被技术乌托邦叙事占领的认知领域，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 839020,
      "end_ms": 841115,
      "text": "说我不服从效率，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 841370,
      "end_ms": 843225,
      "text": "我只服从我看见的复杂性。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 843810,
      "end_ms": 844905,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000368",
      "start_ms": 845600,
      "end_ms": 847865,
      "text": "他看见他者不是自我的敌人，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 848180,
      "end_ms": 849905,
      "text": "不是需要被克服的障碍，"
    },
    {
      "segment_id": "s000370",
      "start_ms": 850220,
      "end_ms": 852035,
      "text": "不是需要被同化的差异。"
    },
    {
      "segment_id": "s000371",
      "start_ms": 852450,
      "end_ms": 853565,
      "text": "它是一面镜子，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 853890,
      "end_ms": 857025,
      "text": "映照出人类在数字宇宙中最根本的处境。"
    },
    {
      "segment_id": "s000373",
      "start_ms": 857360,
      "end_ms": 858705,
      "text": "我们连接了一些东西，"
    },
    {
      "segment_id": "s000374",
      "start_ms": 859090,
      "end_ms": 860475,
      "text": "我们失去了更多东西，"
    }
  ],
  "source_transcript_sha256": "408be67c5d997813614e9edcde856960ecc76f17c616ef1089f484bbc2b06c53"
}