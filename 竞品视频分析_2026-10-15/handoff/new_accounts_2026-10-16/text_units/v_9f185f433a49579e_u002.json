{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_9f185f433a49579e_u002",
  "video_id": "v_9f185f433a49579e",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 1112.539002,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000400",
      "start_ms": 893030,
      "end_ms": 895615,
      "text": "但如果你把终极的安宁寄托在这上面，"
    },
    {
      "segment_id": "s000401",
      "start_ms": 895920,
      "end_ms": 899855,
      "text": "你就把你的灵魂压在了一根随时可能断裂的弦上。"
    },
    {
      "segment_id": "s000402",
      "start_ms": 900170,
      "end_ms": 902425,
      "text": "只有当你不再指望世界给你安宁，"
    },
    {
      "segment_id": "s000403",
      "start_ms": 902870,
      "end_ms": 905055,
      "text": "你才有可能在世界中活的安宁。"
    },
    {
      "segment_id": "s000404",
      "start_ms": 905640,
      "end_ms": 910725,
      "text": "这段话是一个见过罗马陷落的人从废墟中站起来说的。"
    },
    {
      "segment_id": "s000405",
      "start_ms": 911170,
      "end_ms": 911570,
      "text": "最后。"
    },
    {
      "segment_id": "s000406",
      "start_ms": 911890,
      "end_ms": 913710,
      "text": "我想认真推荐一次这本书。"
    },
    {
      "segment_id": "s000407",
      "start_ms": 914530,
      "end_ms": 916170,
      "text": "如果你看到这里还没有划走，"
    },
    {
      "segment_id": "s000408",
      "start_ms": 916550,
      "end_ms": 919170,
      "text": "说明你心里有一个问题一直没有被回答。"
    },
    {
      "segment_id": "s000409",
      "start_ms": 919290,
      "end_ms": 920650,
      "text": "我们到底该怎么面对？"
    },
    {
      "segment_id": "s000410",
      "start_ms": 920650,
      "end_ms": 922750,
      "text": "那些理性无法完全证明，"
    },
    {
      "segment_id": "s000411",
      "start_ms": 922990,
      "end_ms": 925150,
      "text": "却又无法被简单否定的地情。"
    },
    {
      "segment_id": "s000412",
      "start_ms": 925370,
      "end_ms": 927470,
      "text": "上帝之城就是为这个问题写的，"
    },
    {
      "segment_id": "s000413",
      "start_ms": 927610,
      "end_ms": 929030,
      "text": "它不是让你信什么，"
    },
    {
      "segment_id": "s000414",
      "start_ms": 929250,
      "end_ms": 933510,
      "text": "它是让你看见信和不信之间那片被我们粗暴踩平的地带。"
    },
    {
      "segment_id": "s000415",
      "start_ms": 934010,
      "end_ms": 935070,
      "text": "这个版本的解读，"
    },
    {
      "segment_id": "s000416",
      "start_ms": 935230,
      "end_ms": 937550,
      "text": "文案优化了不下五次前，"
    },
    {
      "segment_id": "s000417",
      "start_ms": 937550,
      "end_ms": 938970,
      "text": "四版死在草稿箱里，"
    },
    {
      "segment_id": "s000418",
      "start_ms": 939210,
      "end_ms": 940610,
      "text": "像论文像鸡汤，"
    },
    {
      "segment_id": "s000419",
      "start_ms": 940610,
      "end_ms": 943020,
      "text": "或用政治学压神学，"
    },
    {
      "segment_id": "s000420",
      "start_ms": 943360,
      "end_ms": 946020,
      "text": "或用神学压政治学到第五版。"
    },
    {
      "segment_id": "s000421",
      "start_ms": 946020,
      "end_ms": 946720,
      "text": "我才明白，"
    },
    {
      "segment_id": "s000422",
      "start_ms": 947100,
      "end_ms": 949420,
      "text": "真正的解读不是替这本书说话，"
    },
    {
      "segment_id": "s000423",
      "start_ms": 949760,
      "end_ms": 951140,
      "text": "是把你送到他面前，"
    },
    {
      "segment_id": "s000424",
      "start_ms": 951480,
      "end_ms": 952220,
      "text": "然后闭嘴。"
    },
    {
      "segment_id": "s000425",
      "start_ms": 952740,
      "end_ms": 955220,
      "text": "由于平台规则有些细节无法展开，"
    },
    {
      "segment_id": "s000426",
      "start_ms": 955680,
      "end_ms": 959400,
      "text": "比如奥古斯丁为什么要在地上的和平上画那么多篇幅？"
    },
    {
      "segment_id": "s000427",
      "start_ms": 959760,
      "end_ms": 961500,
      "text": "比如第三座城的争论，"
    },
    {
      "segment_id": "s000428",
      "start_ms": 961520,
      "end_ms": 962940,
      "text": "为什么持续了一百年？"
    },
    {
      "segment_id": "s000429",
      "start_ms": 963100,
      "end_ms": 967240,
      "text": "比如摩尼教二元论和奥古斯丁两成说之间的隐秘继承关系。"
    },
    {
      "segment_id": "s000430",
      "start_ms": 967840,
      "end_ms": 970980,
      "text": "比如奥古斯丁对罗马德性的批判到底有多锋利？"
    },
    {
      "segment_id": "s000431",
      "start_ms": 970980,
      "end_ms": 973640,
      "text": "这些东就是一旦展开这条内容，"
    },
    {
      "segment_id": "s000432",
      "start_ms": 973640,
      "end_ms": 974745,
      "text": "大概率活不过今晚。"
    },
    {
      "segment_id": "s000433",
      "start_ms": 975000,
      "end_ms": 977905,
      "text": "所以你在屏幕上看到的是删掉三层铺垫，"
    },
    {
      "segment_id": "s000434",
      "start_ms": 978140,
      "end_ms": 979260,
      "text": "砍掉五处例证，"
    },
    {
      "segment_id": "s000435",
      "start_ms": 979420,
      "end_ms": 981080,
      "text": "绕开四个不能碰的词之后，"
    },
    {
      "segment_id": "s000436",
      "start_ms": 981200,
      "end_ms": 982735,
      "text": "仍然能留下来的股价。"
    },
    {
      "segment_id": "s000437",
      "start_ms": 983200,
      "end_ms": 984925,
      "text": "真正的血肉在书里，"
    },
    {
      "segment_id": "s000438",
      "start_ms": 985450,
      "end_ms": 987010,
      "text": "平台能限制一段文案，"
    },
    {
      "segment_id": "s000439",
      "start_ms": 987310,
      "end_ms": 988885,
      "text": "限制不了一本书的厚度。"
    },
    {
      "segment_id": "s000440",
      "start_ms": 989250,
      "end_ms": 990425,
      "text": "这本书适合三种人，"
    },
    {
      "segment_id": "s000441",
      "start_ms": 990720,
      "end_ms": 994780,
      "text": "第一种是被信与不信这个伪选择题夹在中间的人，"
    },
    {
      "segment_id": "s000442",
      "start_ms": 994800,
      "end_ms": 995780,
      "text": "你既不想盲从，"
    },
    {
      "segment_id": "s000443",
      "start_ms": 996040,
      "end_ms": 997005,
      "text": "也不想傲慢，"
    },
    {
      "segment_id": "s000444",
      "start_ms": 997410,
      "end_ms": 999705,
      "text": "但你没有语言描述自己的位置。"
    },
    {
      "segment_id": "s000445",
      "start_ms": 1000200,
      "end_ms": 1001475,
      "text": "这本书给你语言。"
    },
    {
      "segment_id": "s000446",
      "start_ms": 1001730,
      "end_ms": 1004115,
      "text": "第二种是想训练历史思维的人。"
    },
    {
      "segment_id": "s000447",
      "start_ms": 1004260,
      "end_ms": 1006115,
      "text": "你以为历史是事实的堆砌，"
    },
    {
      "segment_id": "s000448",
      "start_ms": 1006410,
      "end_ms": 1008035,
      "text": "他其实是解释的竞争。"
    },
    {
      "segment_id": "s000449",
      "start_ms": 1008600,
      "end_ms": 1010495,
      "text": "你以为政治是权力的游戏，"
    },
    {
      "segment_id": "s000450",
      "start_ms": 1010870,
      "end_ms": 1012670,
      "text": "他其实是爱的秩序的争夺。"
    },
    {
      "segment_id": "s000451",
      "start_ms": 1012770,
      "end_ms": 1015410,
      "text": "第三种是对思想史好奇的人。"
    },
    {
      "segment_id": "s000452",
      "start_ms": 1015490,
      "end_ms": 1018750,
      "text": "你想知道人类两千年里最聪明的头脑如何，"
    },
    {
      "segment_id": "s000453",
      "start_ms": 1018750,
      "end_ms": 1021865,
      "text": "在一个无法被实验证明的问题上反复推演，"
    },
    {
      "segment_id": "s000454",
      "start_ms": 1022150,
      "end_ms": 1025235,
      "text": "争论修正这本书给你地图，"
    },
    {
      "segment_id": "s000455",
      "start_ms": 1026100,
      "end_ms": 1027275,
      "text": "他不适合三种人，"
    },
    {
      "segment_id": "s000456",
      "start_ms": 1027950,
      "end_ms": 1030225,
      "text": "想找简单答案的人别赌。"
    },
    {
      "segment_id": "s000457",
      "start_ms": 1030650,
      "end_ms": 1033085,
      "text": "想找战队材料的人别赌，"
    },
    {
      "segment_id": "s000458",
      "start_ms": 1033440,
      "end_ms": 1035715,
      "text": "想找心灵鸡汤的人别赌，"
    },
    {
      "segment_id": "s000459",
      "start_ms": 1035910,
      "end_ms": 1037045,
      "text": "他不负责安慰你，"
    },
    {
      "segment_id": "s000460",
      "start_ms": 1037340,
      "end_ms": 1038635,
      "text": "他负责让你不舒服，"
    },
    {
      "segment_id": "s000461",
      "start_ms": 1038890,
      "end_ms": 1039750,
      "text": "他不会告诉你，"
    },
    {
      "segment_id": "s000462",
      "start_ms": 1039870,
      "end_ms": 1041980,
      "text": "信就对了也不会告诉你，"
    },
    {
      "segment_id": "s000463",
      "start_ms": 1042000,
      "end_ms": 1043285,
      "text": "不信就清醒了。"
    },
    {
      "segment_id": "s000464",
      "start_ms": 1043760,
      "end_ms": 1045145,
      "text": "他会把你的问题拆开，"
    },
    {
      "segment_id": "s000465",
      "start_ms": 1045520,
      "end_ms": 1046040,
      "text": "让你看见，"
    },
    {
      "segment_id": "s000466",
      "start_ms": 1046040,
      "end_ms": 1049755,
      "text": "里面还有多少你从未问过的问题怎么读？"
    },
    {
      "segment_id": "s000467",
      "start_ms": 1050250,
      "end_ms": 1051705,
      "text": "不要从头到尾跪着读，"
    },
    {
      "segment_id": "s000468",
      "start_ms": 1052040,
      "end_ms": 1053685,
      "text": "也不要从头到尾审判着读，"
    },
    {
      "segment_id": "s000469",
      "start_ms": 1054100,
      "end_ms": 1054735,
      "text": "带一支笔，"
    },
    {
      "segment_id": "s000470",
      "start_ms": 1055220,
      "end_ms": 1056935,
      "text": "先读前十卷问自己，"
    },
    {
      "segment_id": "s000471",
      "start_ms": 1057220,
      "end_ms": 1058420,
      "text": "我凭什么相信我？"
    },
    {
      "segment_id": "s000472",
      "start_ms": 1058420,
      "end_ms": 1059855,
      "text": "所处的文明是进步的，"
    },
    {
      "segment_id": "s000473",
      "start_ms": 1060150,
      "end_ms": 1062005,
      "text": "再读后十二卷问自己，"
    },
    {
      "segment_id": "s000474",
      "start_ms": 1062630,
      "end_ms": 1064805,
      "text": "那些我以为早就盖棺定论的事，"
    },
    {
      "segment_id": "s000475",
      "start_ms": 1065140,
      "end_ms": 1066025,
      "text": "真的定论了吗？"
    },
    {
      "segment_id": "s000476",
      "start_ms": 1066810,
      "end_ms": 1067130,
      "text": "最后，"
    },
    {
      "segment_id": "s000477",
      "start_ms": 1067130,
      "end_ms": 1068745,
      "text": "读结尾部分问自己，"
    },
    {
      "segment_id": "s000478",
      "start_ms": 1068990,
      "end_ms": 1072655,
      "text": "我能不能在不确定中仍然做出负责任的判断。"
    },
    {
      "segment_id": "s000479",
      "start_ms": 1073230,
      "end_ms": 1075625,
      "text": "如果只打算从这条内容里带走一个动作，"
    },
    {
      "segment_id": "s000480",
      "start_ms": 1075850,
      "end_ms": 1078205,
      "text": "我希望是去找这本书来读。"
    },
    {
      "segment_id": "s000481",
      "start_ms": 1078550,
      "end_ms": 1079215,
      "text": "不是点赞，"
    },
    {
      "segment_id": "s000482",
      "start_ms": 1079510,
      "end_ms": 1080265,
      "text": "不是收藏，"
    },
    {
      "segment_id": "s000483",
      "start_ms": 1080670,
      "end_ms": 1081285,
      "text": "是毒。"
    },
    {
      "segment_id": "s000484",
      "start_ms": 1081780,
      "end_ms": 1082805,
      "text": "不是读我的文案，"
    },
    {
      "segment_id": "s000485",
      "start_ms": 1083100,
      "end_ms": 1083380,
      "text": "试读，"
    },
    {
      "segment_id": "s000486",
      "start_ms": 1083380,
      "end_ms": 1085605,
      "text": "奥古斯丁不是读结论，"
    },
    {
      "segment_id": "s000487",
      "start_ms": 1085900,
      "end_ms": 1086775,
      "text": "适度论证，"
    },
    {
      "segment_id": "s000488",
      "start_ms": 1087200,
      "end_ms": 1088275,
      "text": "不是赌谁赢了，"
    },
    {
      "segment_id": "s000489",
      "start_ms": 1088650,
      "end_ms": 1089945,
      "text": "是读他们怎么吵的，"
    },
    {
      "segment_id": "s000490",
      "start_ms": 1090510,
      "end_ms": 1091970,
      "text": "平台能删掉一段文案，"
    },
    {
      "segment_id": "s000491",
      "start_ms": 1092250,
      "end_ms": 1092730,
      "text": "删不掉。"
    },
    {
      "segment_id": "s000492",
      "start_ms": 1092730,
      "end_ms": 1094415,
      "text": "你翻开书之后的那几个小时，"
    },
    {
      "segment_id": "s000493",
      "start_ms": 1095210,
      "end_ms": 1096290,
      "text": "这一版能活下来，"
    },
    {
      "segment_id": "s000494",
      "start_ms": 1096410,
      "end_ms": 1098285,
      "text": "是因为他学会了不说太多，"
    },
    {
      "segment_id": "s000495",
      "start_ms": 1098800,
      "end_ms": 1101055,
      "text": "但书不会书里什么都说了，"
    },
    {
      "segment_id": "s000496",
      "start_ms": 1101350,
      "end_ms": 1103155,
      "text": "剩下的你自己去看，"
    },
    {
      "segment_id": "s000497",
      "start_ms": 1103670,
      "end_ms": 1106110,
      "text": "这才是我把这条文案改了五遍，"
    },
    {
      "segment_id": "s000498",
      "start_ms": 1106430,
      "end_ms": 1108375,
      "text": "仍然要把它推到你面前的原因。"
    },
    {
      "segment_id": "s000499",
      "start_ms": 1108930,
      "end_ms": 1109785,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000500",
      "start_ms": 1110470,
      "end_ms": 1111690,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000501",
      "start_ms": 1111690,
      "end_ms": 1112355,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "81cd0ca424ef6fb0f28644d1f5a3d37c8f11410e9b125bd3b10b58c5c9cd37dd"
}