{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_5cbbc93d14301400_u001",
  "video_id": "v_5cbbc93d14301400",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 882.847007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 310,
      "end_ms": 2850,
      "text": "十四分钟讲解奥地利学派经济学简史。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3050,
      "end_ms": 4470,
      "text": "如果一定要说有一本书，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4790,
      "end_ms": 7230,
      "text": "是每一个想在这个专家满天飞，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7310,
      "end_ms": 9550,
      "text": "预测天天错的时代里活得更清醒。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 9830,
      "end_ms": 11510,
      "text": "在财富与决策的博弈中，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 11510,
      "end_ms": 23610,
      "text": "少踩坑的人都应该静下心来读一读的那大概就是这本米塞斯写的奥地利学派经济学简史名字听起来像是一本讲老古董、经济学、派系斗争、满篇专业术语的学术文献。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 23850,
      "end_ms": 25230,
      "text": "真正读进去才会发现，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 25470,
      "end_ms": 29750,
      "text": "它其实是在把市场运行最底层的那些逻辑价格信号背后，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 29750,
      "end_ms": 31080,
      "text": "看看不见的博弈线，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 31280,
      "end_ms": 33300,
      "text": "一根一根拆开给人看。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 33800,
      "end_ms": 36480,
      "text": "为什么有的国家照搬了最优经济方案，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 36660,
      "end_ms": 37980,
      "text": "结果却一塌糊涂？"
    },
    {
      "segment_id": "s000013",
      "start_ms": 38380,
      "end_ms": 41400,
      "text": "为什么明明是好心出台的政策落实下去，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 41400,
      "end_ms": 42480,
      "text": "却推高了物价，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 42520,
      "end_ms": 43440,
      "text": "扭曲了资源，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 43520,
      "end_ms": 44580,
      "text": "坑了最穷的人？"
    },
    {
      "segment_id": "s000017",
      "start_ms": 44780,
      "end_ms": 48260,
      "text": "为什么有的经济学家顶着诺奖光环给出的药方，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 48260,
      "end_ms": 52540,
      "text": "却一次次把经济体推向更大的泡沫和更惨烈的崩溃，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 52840,
      "end_ms": 59500,
      "text": "以及那些真正看懂了经济规律的人是怎么在市场一片狂热时嗅到危机的味道。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 59680,
      "end_ms": 61110,
      "text": "在所有人恐慌时，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 61170,
      "end_ms": 63985,
      "text": "看到机会的很多人都有过这种感受，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 64420,
      "end_ms": 65420,
      "text": "辛辛苦苦攒钱，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 65680,
      "end_ms": 67085,
      "text": "一放水就被稀释，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 67520,
      "end_ms": 69860,
      "text": "看着别人炒股炒房赚的盆满钵满，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 70040,
      "end_ms": 71484,
      "text": "自己一进场就套牢。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 72050,
      "end_ms": 73290,
      "text": "明明听了专家的建议，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 73290,
      "end_ms": 74350,
      "text": "做了正确的选择，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 74590,
      "end_ms": 77320,
      "text": "结果总是踩在坑里憋屈的时候，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 77540,
      "end_ms": 79165,
      "text": "心里隐隐觉得哪里不对劲，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 79540,
      "end_ms": 80420,
      "text": "但又说不清楚。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 80420,
      "end_ms": 81585,
      "text": "问题到底出在哪儿？"
    },
    {
      "segment_id": "s000032",
      "start_ms": 82150,
      "end_ms": 82890,
      "text": "表面上看，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 82970,
      "end_ms": 84315,
      "text": "这好像是运气问题，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 84640,
      "end_ms": 86280,
      "text": "好像是你入场时机不对，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 86360,
      "end_ms": 88575,
      "text": "信息不够灵通圈子不够高端。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 88990,
      "end_ms": 94085,
      "text": "但米塞斯这本书做的事情是把这些你以为只有自己才会碰上的糟心事儿，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 94330,
      "end_ms": 95875,
      "text": "一个一个剥离出来，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 96250,
      "end_ms": 96975,
      "text": "让你看到。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 97370,
      "end_ms": 99105,
      "text": "这背后不是单纯的运气好坏，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 99390,
      "end_ms": 102330,
      "text": "而是几十年来被主流经济学刻意忽略，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 102390,
      "end_ms": 106365,
      "text": "甚至打压的关于人的行为和市场本质的恒定法则。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 106950,
      "end_ms": 108455,
      "text": "你不是一个人在踩坑。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 108990,
      "end_ms": 111825,
      "text": "所有不懂这套逻辑的人都在同一个局里。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 112320,
      "end_ms": 113640,
      "text": "在正式讲这本书之前，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 113840,
      "end_ms": 116505,
      "text": "可以先抛出一个其中非常扎心的观点，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 116870,
      "end_ms": 120045,
      "text": "用自己的话转述出来大概是这样一句意思。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 120420,
      "end_ms": 122505,
      "text": "一个社会的经济繁荣或崩溃，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 122910,
      "end_ms": 125975,
      "text": "很大程度上不取决于他的领导人有多聪明。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 126350,
      "end_ms": 127705,
      "text": "规划者有多勤勉，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 128030,
      "end_ms": 129485,
      "text": "统计数据有多漂亮，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 129740,
      "end_ms": 133160,
      "text": "而取决于他是否尊重私有产权和价格信号。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 133160,
      "end_ms": 134035,
      "text": "这两样东西，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 134510,
      "end_ms": 138170,
      "text": "人们在学校里花十几年学数学、学金融模型，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 138490,
      "end_ms": 139950,
      "text": "学各种曲线和公式，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 140190,
      "end_ms": 141910,
      "text": "却几乎没有人认真教过。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 142130,
      "end_ms": 143825,
      "text": "价格是怎么形成的？"
    },
    {
      "segment_id": "s000057",
      "start_ms": 144200,
      "end_ms": 145820,
      "text": "财富是怎么被创造，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 145860,
      "end_ms": 147125,
      "text": "又被悄悄没收的？"
    },
    {
      "segment_id": "s000059",
      "start_ms": 147490,
      "end_ms": 150565,
      "text": "经济周期的波动到底是谁在幕后操纵？"
    },
    {
      "segment_id": "s000060",
      "start_ms": 150950,
      "end_ms": 151575,
      "text": "结果就是，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 151870,
      "end_ms": 154395,
      "text": "很多人一边在专业领域表现的聪明能干，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 154660,
      "end_ms": 157180,
      "text": "一边在面对经济政策和社会趋势时，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 157200,
      "end_ms": 158385,
      "text": "幼稚得像个孩子，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 158710,
      "end_ms": 161985,
      "text": "全凭新闻联播和短视频里的专家解读横冲直撞。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 162260,
      "end_ms": 163200,
      "text": "这一点一旦想通，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 163520,
      "end_ms": 165940,
      "text": "很多对自己总是错过机会的自责，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 166180,
      "end_ms": 167240,
      "text": "其实会轻一点。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 167300,
      "end_ms": 170065,
      "text": "投资亏了钱不等于你这个人就一无是处。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 170410,
      "end_ms": 172745,
      "text": "只能说明在最重要的经济功课上，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 172980,
      "end_ms": 175085,
      "text": "大家几乎都没有受过真正的教育。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 175770,
      "end_ms": 180860,
      "text": "米赛斯这本书想做的就是把从经济到底是怎么运转的到政策，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 180860,
      "end_ms": 182520,
      "text": "为什么总是好心办坏事？"
    },
    {
      "segment_id": "s000073",
      "start_ms": 182540,
      "end_ms": 183785,
      "text": "这一整条逻辑链，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 184550,
      "end_ms": 186145,
      "text": "从最开始的边际革命，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 186430,
      "end_ms": 188205,
      "text": "到后来的经济计算、大论战，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 188550,
      "end_ms": 191815,
      "text": "再到商业周期理论和学术传承的跌宕起伏。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 192180,
      "end_ms": 193965,
      "text": "一段一段拆开给人看，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 194720,
      "end_ms": 197840,
      "text": "先来说说人为什么一定要懂这些经济学原理。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 197940,
      "end_ms": 198825,
      "text": "很多人觉得，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 199030,
      "end_ms": 201705,
      "text": "学奥地利学派经济学是把人学的冷血，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 202030,
      "end_ms": 203135,
      "text": "会变得斤斤计较，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 203390,
      "end_ms": 204770,
      "text": "反对一切政府干预，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 204830,
      "end_ms": 207690,
      "text": "满脑子自由市场原教旨主义这本书，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 207690,
      "end_ms": 209455,
      "text": "真正的起点恰恰相反。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 209730,
      "end_ms": 210925,
      "text": "他不是教人冷血，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 211330,
      "end_ms": 213990,
      "text": "而是教人不要被善意蒙蔽双眼。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 214010,
      "end_ms": 215710,
      "text": "一个人如果长期活在政府，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 215710,
      "end_ms": 216610,
      "text": "会管好一切，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 216730,
      "end_ms": 218630,
      "text": "专家会替我们做最优选择。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 218910,
      "end_ms": 219990,
      "text": "只要出发点好，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 220010,
      "end_ms": 221665,
      "text": "结果就不会差的幻觉里，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 221990,
      "end_ms": 223850,
      "text": "大概率会被现实反复教训。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 223870,
      "end_ms": 224395,
      "text": "反过来，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 224730,
      "end_ms": 229695,
      "text": "如果能看懂那些隐藏的利益机制、价格的信号、功能干预的连锁反应。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 229980,
      "end_ms": 231860,
      "text": "就算你不是经济学家看新闻，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 231860,
      "end_ms": 232620,
      "text": "做判断时，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 232660,
      "end_ms": 233520,
      "text": "内心也会清醒。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 233520,
      "end_ms": 235185,
      "text": "很多不是事故，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 235520,
      "end_ms": 236560,
      "text": "而是社会的运行，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 236560,
      "end_ms": 238560,
      "text": "就是这么设计的时代。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 238560,
      "end_ms": 240045,
      "text": "在变人性不变。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 240560,
      "end_ms": 241920,
      "text": "过去很长一段时间里，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 242100,
      "end_ms": 243215,
      "text": "经济相对封闭，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 243540,
      "end_ms": 249020,
      "text": "大家的预期也简单找份工作、存钱等退休那样的环境未必富裕，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 249160,
      "end_ms": 251435,
      "text": "但至少不容易被复杂政策绕进去。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 251700,
      "end_ms": 253215,
      "text": "现在情况刚好反过来，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 253630,
      "end_ms": 254850,
      "text": "金融工具越来越多。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 254990,
      "end_ms": 256430,
      "text": "货币政策越来越频繁，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 256710,
      "end_ms": 257930,
      "text": "信息铺天盖地，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 258090,
      "end_ms": 260070,
      "text": "噪音也比信号多正。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 260070,
      "end_ms": 260715,
      "text": "因为如此，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 261020,
      "end_ms": 263625,
      "text": "经济学的智慧才更需要被好好理解，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 263900,
      "end_ms": 266500,
      "text": "而不是完全交给运气或者交给专家。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 266600,
      "end_ms": 268705,
      "text": "先说这本书最核心的思想源头。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 269200,
      "end_ms": 270000,
      "text": "一八七一年，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 270260,
      "end_ms": 272260,
      "text": "一个叫卡尔蒙戈尔的奥地利人，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 272280,
      "end_ms": 275335,
      "text": "出版了一本薄薄的小书国民经济学原理，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 275720,
      "end_ms": 278635,
      "text": "掀起了经济学史上著名的边际革命。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 279070,
      "end_ms": 284505,
      "text": "他跟英国的杰文斯、法国的瓦尔拉斯几乎同时发现了边际效用这个概念。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 284940,
      "end_ms": 286765,
      "text": "但蒙格尔走的比他们更彻底。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 287070,
      "end_ms": 290495,
      "text": "蒙格尔确立了一个在当时看来简直离经叛道的观点。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 291050,
      "end_ms": 293550,
      "text": "价值不是由劳动成本决定的，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 293570,
      "end_ms": 295265,
      "text": "不是由客观属性决定的，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 295610,
      "end_ms": 299125,
      "text": "而是由个体对需求满足的主观预期决定的。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 299500,
      "end_ms": 300095,
      "text": "什么意思？"
    },
    {
      "segment_id": "s000126",
      "start_ms": 300360,
      "end_ms": 301340,
      "text": "钻石比水贵，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 301480,
      "end_ms": 302920,
      "text": "不是因为挖钻石更费力，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 302920,
      "end_ms": 304790,
      "text": "而而是因为在具体情境下，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 304790,
      "end_ms": 308995,
      "text": "有人们认为最后一块钻石带来的满足远大于最后一杯水。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 309450,
      "end_ms": 311970,
      "text": "但如果把你扔到沙漠里水的价值，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 312090,
      "end_ms": 313410,
      "text": "立刻碾压钻石，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 313690,
      "end_ms": 316350,
      "text": "价值从来不是刻在物品上的标签，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 316810,
      "end_ms": 318610,
      "text": "而是刻在人心里的判断。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 318950,
      "end_ms": 322990,
      "text": "蒙格尔的继承者维塞尔提出了机会成本和边际效用。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 322990,
      "end_ms": 326650,
      "text": "这两个概念庞巴维克则提出了迂回生产和利息。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 326650,
      "end_ms": 330290,
      "text": "时差理论用边际效用论代替劳动价值论，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 330510,
      "end_ms": 333090,
      "text": "以利息时差论否定剩余价值论。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 333110,
      "end_ms": 336150,
      "text": "庞巴维克解释了为什么实际利率必须是正数，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 336430,
      "end_ms": 340320,
      "text": "提出了生产的时间、结构、理论和货币的时时间价值理论，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 340380,
      "end_ms": 344380,
      "text": "为后来米塞斯和哈耶克发展商业周期理论奠定了基础。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 344800,
      "end_ms": 348080,
      "text": "这三位奠基者蒙格尔维塞尔、庞巴维克，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 348320,
      "end_ms": 350120,
      "text": "构成了奥地利学派的第一代。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 350920,
      "end_ms": 353300,
      "text": "他们的核心贡献可以用一句话概括，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 353720,
      "end_ms": 357240,
      "text": "把经济学从物的逻辑拉回到人的逻辑。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 357600,
      "end_ms": 358860,
      "text": "到了米塞斯这一代，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 359040,
      "end_ms": 360660,
      "text": "事情发生了根本性的变化。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 361140,
      "end_ms": 364300,
      "text": "米塞斯在一九一二年发表了他第一部重要论著。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 364480,
      "end_ms": 365860,
      "text": "货币与信用理论，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 365880,
      "end_ms": 369155,
      "text": "把货币理论、银行信贷和资本结构整合在一起，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 369590,
      "end_ms": 370770,
      "text": "揭示了货币扩张。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 370810,
      "end_ms": 376050,
      "text": "如何扭曲生产结构、制造虚假繁荣这个理论后来被称为米塞斯。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 376210,
      "end_ms": 381825,
      "text": "哈耶克商业周期理论是奥地利学派对经济学最独特的贡献之一，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 382230,
      "end_ms": 384075,
      "text": "他的核心洞察其实并不复杂。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 384590,
      "end_ms": 388170,
      "text": "当中央银行仍为压低利率大量注入货币的时候，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 388310,
      "end_ms": 390970,
      "text": "企业家会被便宜的资金误导去投资。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 390970,
      "end_ms": 394545,
      "text": "那些在真实利率下根本不可能盈利的长期项目，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 395020,
      "end_ms": 396500,
      "text": "看起来经济一片繁荣。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 396660,
      "end_ms": 397440,
      "text": "工厂开工，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 397520,
      "end_ms": 398315,
      "text": "股市暴涨，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 398590,
      "end_ms": 400070,
      "text": "人人觉得自己变富了，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 400110,
      "end_ms": 401525,
      "text": "但这种繁荣是假的，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 401850,
      "end_ms": 403910,
      "text": "是货币幻觉堆起来的沙堡。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 403970,
      "end_ms": 405510,
      "text": "当利率最终被迫回升，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 405690,
      "end_ms": 406690,
      "text": "信贷开始收缩，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 407030,
      "end_ms": 409845,
      "text": "那些建立在便宜资金上的项目就崩塌了，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 410150,
      "end_ms": 411830,
      "text": "繁荣迅速转为萧条。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 411950,
      "end_ms": 415690,
      "text": "米塞斯在二十世纪二十年代美国经济烈火烹油之时，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 415690,
      "end_ms": 417765,
      "text": "就成功预测了大萧条的到来。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 418140,
      "end_ms": 420605,
      "text": "这一预测后来被哈耶克继承和发展。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 421030,
      "end_ms": 426470,
      "text": "哈耶克正是凭借货币理论和商业周期理论摘取了一九七四年诺贝尔经济学奖。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 426570,
      "end_ms": 432605,
      "text": "书中还花了大量篇幅讲述那场改变了经济学走向的大论战、社会主义经济计算问题。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 433040,
      "end_ms": 433780,
      "text": "一九二零年，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 433980,
      "end_ms": 437960,
      "text": "米塞斯发表了一篇题为社会主义国家的经济计算的短文，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 438060,
      "end_ms": 444155,
      "text": "从根本上质疑乃至彻底否定在中央计划中实行经济计算和合理配置资源的可能性。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 444490,
      "end_ms": 445650,
      "text": "这篇文章篇幅不长，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 445970,
      "end_ms": 451765,
      "text": "却引发了二十世纪二十到三十年代在世界范围进行的关于社会主义经济可行性的大论战。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 451960,
      "end_ms": 453685,
      "text": "米塞斯的论证其实很简单，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 454050,
      "end_ms": 456530,
      "text": "在私有制经济中合理的经济计算，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 456550,
      "end_ms": 461495,
      "text": "之所以可能是因为用货币表现的价格构成了这种计算的必要条件。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 461980,
      "end_ms": 462895,
      "text": "价格是什么？"
    },
    {
      "segment_id": "s000181",
      "start_ms": 463310,
      "end_ms": 465085,
      "text": "价格不是谁拍脑袋定出来的，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 465500,
      "end_ms": 469895,
      "text": "而是千百万人在市场中通过买卖行为不断博弈出来的一个信号。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 470220,
      "end_ms": 471100,
      "text": "他告诉生产者，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 471100,
      "end_ms": 472220,
      "text": "消费者需要什么，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 472220,
      "end_ms": 472920,
      "text": "需要多少，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 473140,
      "end_ms": 474185,
      "text": "愿意出多少钱。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 474700,
      "end_ms": 477945,
      "text": "而在没有私有产权、没有真正市场交换的制度下，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 478230,
      "end_ms": 484140,
      "text": "各种生产要素的价格根本无法用货币计量经济计算中货币实际上起不了什么作用。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 484280,
      "end_ms": 486580,
      "text": "中央计划者没有价格信号可以参考，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 486720,
      "end_ms": 488320,
      "text": "就只能在黑暗中摸索，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 488400,
      "end_ms": 490455,
      "text": "搞不清楚某种产品到底需不需要，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 490720,
      "end_ms": 492240,
      "text": "也不知道生产它的过程中，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 492260,
      "end_ms": 494175,
      "text": "劳动和原材料有没有被浪费。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 494930,
      "end_ms": 497165,
      "text": "后来哈杰克进一步深化了这个论证，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 497390,
      "end_ms": 499115,
      "text": "把它提炼成一个知识问题。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 499380,
      "end_ms": 503344,
      "text": "经济运行所依赖的知识是分散在每个人头脑中的局部知识。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 503720,
      "end_ms": 508800,
      "text": "这些知识是任何中央计划机关都不可能集中收集起来的价格体系，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 508900,
      "end_ms": 510935,
      "text": "恰恰是一种信息交流机制。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 511250,
      "end_ms": 513585,
      "text": "他把分散的知识浓缩成一个数字，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 513840,
      "end_ms": 515640,
      "text": "让每个人不需要知道全局，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 515700,
      "end_ms": 517295,
      "text": "也能做出理性的决策。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 517590,
      "end_ms": 524055,
      "text": "米塞斯和哈耶克的论战对手是奥斯卡兰格兰格提出用试错法来模拟市场机制。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 524490,
      "end_ms": 526250,
      "text": "但米塞斯一针见血的指出，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 526550,
      "end_ms": 528870,
      "text": "要把市场和它的价格形成功能，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 529070,
      "end_ms": 532390,
      "text": "同以生产资料私有制为基础的社会分离开来。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 532710,
      "end_ms": 535490,
      "text": "就如同一个有三角的四方形的观念一样，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 535490,
      "end_ms": 536475,
      "text": "是自相矛盾的。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 536960,
      "end_ms": 538465,
      "text": "这里有一个常被误会的点，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 538800,
      "end_ms": 542800,
      "text": "就是很多人把奥地利学派等同于什么都不管的自由放人主义。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 542880,
      "end_ms": 544935,
      "text": "其实这本书里米塞斯讲的很清楚，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 545360,
      "end_ms": 547255,
      "text": "奥地利学派反对的不是管理，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 547500,
      "end_ms": 551280,
      "text": "而是反对那些破坏价格信号扭曲资源配置的干预。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 551340,
      "end_ms": 553505,
      "text": "米塞斯为了贯彻主观价值论，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 553770,
      "end_ms": 555710,
      "text": "坚决反对将经济学数学化，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 555790,
      "end_ms": 559865,
      "text": "认为经济学的任务不是告诉行为中的个人应该怎样做，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 560150,
      "end_ms": 563035,
      "text": "而是厘清价格利率这些概念的本质，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 563360,
      "end_ms": 565615,
      "text": "他们不是任何人刻意设定的结果，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 565860,
      "end_ms": 570160,
      "text": "而是无数个人各自进行有目的的行为而得出的无意识后果。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 570280,
      "end_ms": 571300,
      "text": "市场外部的力量，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 571300,
      "end_ms": 575460,
      "text": "如政府针对个人的选择过程或结果进行干预和限制，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 575540,
      "end_ms": 576900,
      "text": "都会扭曲人的行为，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 577080,
      "end_ms": 578740,
      "text": "从而产生错误和混乱。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 578880,
      "end_ms": 582455,
      "text": "哈杰克后来把这层洞见发展成自发秩序的概念。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 582740,
      "end_ms": 584995,
      "text": "他说的是一个极其反直觉的道理，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 585310,
      "end_ms": 587890,
      "text": "最好的秩序往往不是被设计出来的，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 587990,
      "end_ms": 591325,
      "text": "而是在无数人自由互动中自发生长出来的。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 591820,
      "end_ms": 592100,
      "text": "书中，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 592100,
      "end_ms": 595720,
      "text": "还非常诚实的讲了奥地利学派在学术圈里的尴尬处境。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 595820,
      "end_ms": 597560,
      "text": "奥地利学派从诞生之初，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 597620,
      "end_ms": 598340,
      "text": "直至现在，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 598620,
      "end_ms": 601135,
      "text": "始终陷入与其他学派的争论当中，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 601460,
      "end_ms": 604040,
      "text": "而且争论的焦点很多不在具体问题上。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 604180,
      "end_ms": 605460,
      "text": "而在方法论层面，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 605600,
      "end_ms": 608225,
      "text": "他们反对用均衡式的静态分析方法。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 608530,
      "end_ms": 612450,
      "text": "反对运用数学模型来模拟真实实践过程中的人类行为。"
    },
    {
      "segment_id": "s000236",
      "start_ms": 612730,
      "end_ms": 613070,
      "text": "然而，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 613070,
      "end_ms": 615330,
      "text": "自己又很难突破均衡理论的窠臼，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 615330,
      "end_ms": 617350,
      "text": "来独创一门非均衡的科学。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 617670,
      "end_ms": 622810,
      "text": "以至于奥地利学派的经济学家经常被人称为方法论学者或者哲学家。"
    },
    {
      "segment_id": "s000240",
      "start_ms": 622990,
      "end_ms": 624590,
      "text": "而不是正经的经济学家。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 624870,
      "end_ms": 626150,
      "text": "这种边缘化的处境，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 626330,
      "end_ms": 629390,
      "text": "加上米塞斯本人不媚俗、不妥协的性格，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 629630,
      "end_ms": 631530,
      "text": "让他在学术界的日子并不好过。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 631910,
      "end_ms": 634650,
      "text": "他在维也纳大学做了二十一年的编外讲师，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 634930,
      "end_ms": 635670,
      "text": "没有薪水，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 635930,
      "end_ms": 637730,
      "text": "全靠学生在底下口口相传，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 637730,
      "end_ms": 643960,
      "text": "但他主持的私人研讨班却走出了哈耶克、科兹纳等一批影响深远的经济学家。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 644080,
      "end_ms": 644440,
      "text": "后来，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 644580,
      "end_ms": 646460,
      "text": "他因躲避纳粹而离开欧洲，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 646760,
      "end_ms": 647600,
      "text": "先去了瑞士。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 647960,
      "end_ms": 649460,
      "text": "一九四零年移居美国，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 649740,
      "end_ms": 652220,
      "text": "在纽约大学做了二十多年客座教授，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 652400,
      "end_ms": 653820,
      "text": "直到一九六九年退休。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 654320,
      "end_ms": 655920,
      "text": "正是在美国的那些年里，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 656120,
      "end_ms": 661420,
      "text": "他把蒙格尔开创的方法论、个人主义和主观主义拓展到了整个经济学领域，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 661700,
      "end_ms": 664240,
      "text": "写成了那本集大成的人的行为。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 664780,
      "end_ms": 666660,
      "text": "以人的行动是有目的的，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 666660,
      "end_ms": 667620,
      "text": "作为先验功理，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 667620,
      "end_ms": 672075,
      "text": "一步步推导出人类社会经济的种种安排和运作原理，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 672400,
      "end_ms": 673920,
      "text": "开创出人的行动。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 673920,
      "end_ms": 677360,
      "text": "学书中在谈到奥地利学派与其他学派的争论时，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 677560,
      "end_ms": 679705,
      "text": "给了一个不那么简单粗暴的视角。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 680670,
      "end_ms": 684010,
      "text": "很多人看到主流经济学和奥地利学派吵得不可开交，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 684270,
      "end_ms": 686535,
      "text": "第一反应就是到底谁对谁错，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 687120,
      "end_ms": 689105,
      "text": "书里并没有替任何一方洗白，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 689450,
      "end_ms": 692435,
      "text": "而是强调这些争论之所以持续百年，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 692810,
      "end_ms": 696485,
      "text": "恰恰说明经济学远没有到达可以定论的阶段。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 696940,
      "end_ms": 699200,
      "text": "米塞斯本人在回忆录里批评维塞尔，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 699200,
      "end_ms": 701220,
      "text": "没有真正掌握主观主义的核心，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 701360,
      "end_ms": 703715,
      "text": "认为他造成的损害甚至大于善行。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 704160,
      "end_ms": 706435,
      "text": "这种尖锐的学术批评也引发了争议。"
    },
    {
      "segment_id": "s000272",
      "start_ms": 707250,
      "end_ms": 709085,
      "text": "但正如后来的学者所指出的，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 709370,
      "end_ms": 711450,
      "text": "维塞尔首次提出了边际效用。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 711450,
      "end_ms": 716505,
      "text": "这个概念在社会价值中对归属理论的推导非常具有原创性。"
    },
    {
      "segment_id": "s000275",
      "start_ms": 716860,
      "end_ms": 719865,
      "text": "这些贡献是不可否认的这提醒我们，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 720190,
      "end_ms": 721545,
      "text": "任何一个学派的发展，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 721800,
      "end_ms": 724175,
      "text": "都不是某个天才、一个人包打天下，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 724550,
      "end_ms": 728275,
      "text": "而是几代人不断争论、修正、传承的过程。"
    },
    {
      "segment_id": "s000279",
      "start_ms": 728730,
      "end_ms": 730335,
      "text": "米塞斯对此看得很清楚，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 730750,
      "end_ms": 735270,
      "text": "他在一九六二年纽约大学的演讲中专门讲述了他主持的私人研讨班，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 735550,
      "end_ms": 740415,
      "text": "强调非官方的学术交流和跨国合作对奥地利学派传承的重要性。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 740740,
      "end_ms": 741080,
      "text": "当然，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 741280,
      "end_ms": 744100,
      "text": "这本书也并不是在说奥地利学派永远正确，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 744300,
      "end_ms": 745960,
      "text": "其他经济学派全是错的。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 745960,
      "end_ms": 749785,
      "text": "他给我们的其实不是一套教人如何精准预测市场的技巧，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 750200,
      "end_ms": 753675,
      "text": "而是几句看起来很朴素但影响深远的提醒。"
    },
    {
      "segment_id": "s000287",
      "start_ms": 754340,
      "end_ms": 755020,
      "text": "人这一生，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 755200,
      "end_ms": 757140,
      "text": "无论你做什么工作赚多少钱，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 757300,
      "end_ms": 758405,
      "text": "生活在哪个国家，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 758690,
      "end_ms": 760845,
      "text": "你都无法逃避经济规律的影响。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 761170,
      "end_ms": 762190,
      "text": "价格会涨会跌，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 762450,
      "end_ms": 763190,
      "text": "政策会收，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 763190,
      "end_ms": 764460,
      "text": "会放繁荣。"
    },
    {
      "segment_id": "s000294",
      "start_ms": 764460,
      "end_ms": 765870,
      "text": "来了会走危机，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 765870,
      "end_ms": 767085,
      "text": "走了还会来。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 767350,
      "end_ms": 768690,
      "text": "不是在跟某一个政府，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 768690,
      "end_ms": 770055,
      "text": "某一个央行打交道，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 770360,
      "end_ms": 772560,
      "text": "你是在跟人性本身打交道，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 772660,
      "end_ms": 774780,
      "text": "看到这一点并不意味着完了，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 774780,
      "end_ms": 775900,
      "text": "我什么都改变不了，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 776260,
      "end_ms": 780080,
      "text": "而是给了自己一个可以选择更清醒的做决策的机会。"
    },
    {
      "segment_id": "s000302",
      "start_ms": 780200,
      "end_ms": 783420,
      "text": "如果把奥地利学派经济学简史当做一本工具书，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 783560,
      "end_ms": 784920,
      "text": "而不是一本审判书。"
    },
    {
      "segment_id": "s000304",
      "start_ms": 785080,
      "end_ms": 786295,
      "text": "也许会轻松很多，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 786650,
      "end_ms": 788350,
      "text": "他不是来告诉你谁好谁坏，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 788450,
      "end_ms": 789865,
      "text": "哪个制度对哪个制度错，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 790300,
      "end_ms": 791595,
      "text": "而是像一只手电筒，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 791970,
      "end_ms": 793530,
      "text": "让人在迷茫受挫，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 793850,
      "end_ms": 796270,
      "text": "觉得自己怎么总是被时代甩下的时候，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 796430,
      "end_ms": 799370,
      "text": "稍微照一照那些你从来没注意过的经济规律，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 799610,
      "end_ms": 801450,
      "text": "看看是不是还有别的路可以走。"
    }
  ],
  "source_transcript_sha256": "51a78d79bb01c8d13c6d460058d70a82f8f73eb3125ad4d369895a56037d495b"
}