{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_b27db8ad24d44b64_u001",
  "video_id": "v_b27db8ad24d44b64",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 802.227007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 2730,
      "text": "你知道中国最美的地方藏在哪儿吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3330,
      "end_ms": 4230,
      "text": "不在山顶，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4930,
      "end_ms": 5850,
      "text": "不在草原，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6510,
      "end_ms": 11650,
      "text": "不在沙漠中国真正美到让人说不出话的地方，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 12410,
      "end_ms": 15850,
      "text": "大多数都在水边全人说九寨沟。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 16030,
      "end_ms": 24110,
      "text": "有人说西湖、九寨沟确实美可九寨沟是明心全中国谁都知道它旺季的时候，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 24110,
      "end_ms": 25410,
      "text": "栈道上人挤人，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 25810,
      "end_ms": 26650,
      "text": "拍张照片，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 26650,
      "end_ms": 27990,
      "text": "背景全是后脑勺。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 28550,
      "end_ms": 29935,
      "text": "西湖更不用说了，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 30380,
      "end_ms": 33160,
      "text": "断桥上的人比水里的鱼还多。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 33620,
      "end_ms": 34900,
      "text": "走一圈下来，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 34920,
      "end_ms": 36160,
      "text": "记住的不是风景，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 36160,
      "end_ms": 36820,
      "text": "是人墙。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 37100,
      "end_ms": 39500,
      "text": "真正排在榜首的那个地方，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 40260,
      "end_ms": 41720,
      "text": "水面像一面镜子，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 42000,
      "end_ms": 43520,
      "text": "据去过的人描述，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 44300,
      "end_ms": 46580,
      "text": "天和地同时倒映在里面，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 46740,
      "end_ms": 48120,
      "text": "分不清哪边是天，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 48140,
      "end_ms": 50280,
      "text": "哪边是水人站在中间，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 50300,
      "end_ms": 51900,
      "text": "像悬浮在空气里，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 52380,
      "end_ms": 55240,
      "text": "可这个地方大部分人连名字都没停过，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 55600,
      "end_ms": 56440,
      "text": "到底是哪？"
    },
    {
      "segment_id": "s000024",
      "start_ms": 56780,
      "end_ms": 59200,
      "text": "从第十名开始倒着讲讲，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 59200,
      "end_ms": 62295,
      "text": "到最后您自极品还是咱们的老规矩。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 62700,
      "end_ms": 63380,
      "text": "开讲前，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 63420,
      "end_ms": 66045,
      "text": "劳烦各位老友顺手点亮红心。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 66690,
      "end_ms": 71550,
      "text": "评论区打个来了让我看看今天又有多少知音来捧场。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 71650,
      "end_ms": 72415,
      "text": "第十名，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 73210,
      "end_ms": 80885,
      "text": "霞浦滩涂、福建宁德、霞浦县这个地方很少出现在热门旅游榜单上。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 81720,
      "end_ms": 84795,
      "text": "搜福建旅游前几页不太容易找到他，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 85830,
      "end_ms": 87235,
      "text": "可在摄影圈里。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 87720,
      "end_ms": 89520,
      "text": "据不少风光摄影师反映，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 89780,
      "end_ms": 92925,
      "text": "霞浦是一个提起来大家都认的名字。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 93780,
      "end_ms": 94905,
      "text": "霞浦美在哪？"
    },
    {
      "segment_id": "s000036",
      "start_ms": 95690,
      "end_ms": 98640,
      "text": "美在贪图退潮以后，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 98940,
      "end_ms": 102595,
      "text": "海水退下去露出大片大片的贪土。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 103170,
      "end_ms": 107175,
      "text": "滩涂上插满了洋子菜和海带的竹竿，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 107800,
      "end_ms": 111820,
      "text": "一排一排的从岸边一直延伸到海里，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 111860,
      "end_ms": 113235,
      "text": "远处有渔船，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 113740,
      "end_ms": 115265,
      "text": "更远处是天际线，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 115950,
      "end_ms": 118085,
      "text": "这个画面本身不算什么，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 118410,
      "end_ms": 120290,
      "text": "可一旦太阳升起来，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 120530,
      "end_ms": 122045,
      "text": "所有东西都变了。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 122450,
      "end_ms": 123310,
      "text": "日出的时候，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 123310,
      "end_ms": 125705,
      "text": "阳光从海面上平射过来，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 126210,
      "end_ms": 129785,
      "text": "滩涂上那层薄薄的海水变成了一面镜子。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 130640,
      "end_ms": 132765,
      "text": "天上的云彩倒映在水里，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 133240,
      "end_ms": 134160,
      "text": "竹竿的影子，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 134160,
      "end_ms": 137935,
      "text": "拉的长长的渔船的剪影贴在水面上，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 138440,
      "end_ms": 142140,
      "text": "整片贪涂变成了一块巨大的调色盘。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 142160,
      "end_ms": 148170,
      "text": "金色、橙色、粉色、紫色颜色每一分钟都在变，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 148250,
      "end_ms": 150070,
      "text": "因为太阳每升高一点，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 150170,
      "end_ms": 151965,
      "text": "光线的角度就不一样。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 152840,
      "end_ms": 154560,
      "text": "霞浦最让人意外的是，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 154720,
      "end_ms": 155735,
      "text": "他不挑季节。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 156640,
      "end_ms": 159215,
      "text": "据当地摄影协会的经验总结，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 160040,
      "end_ms": 162345,
      "text": "春天拍海带收割，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 162820,
      "end_ms": 164535,
      "text": "夏天拍台风前的云，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 164950,
      "end_ms": 166630,
      "text": "秋天拍紫菜干的倒影。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 166730,
      "end_ms": 168375,
      "text": "冬天拍渔船归港，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 168700,
      "end_ms": 170165,
      "text": "四季都有东西拍，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 170810,
      "end_ms": 172925,
      "text": "可每一季的颜色完全不同。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 173800,
      "end_ms": 175320,
      "text": "大部分人到了霞浦以后，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 175320,
      "end_ms": 176360,
      "text": "会发现一件事，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 176360,
      "end_ms": 179915,
      "text": "手机拍出来的跟眼睛看到的差距没有想象中那么大。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 180500,
      "end_ms": 181880,
      "text": "不是手机变好了，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 181940,
      "end_ms": 183240,
      "text": "是霞浦的光线，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 183340,
      "end_ms": 186275,
      "text": "本身就是成片的一片贪涂。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 186700,
      "end_ms": 187425,
      "text": "不用爬山，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 188210,
      "end_ms": 189370,
      "text": "站在岸边看，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 189410,
      "end_ms": 190845,
      "text": "太阳升起来就够了。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 191850,
      "end_ms": 192695,
      "text": "第九名，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 193720,
      "end_ms": 194720,
      "text": "茶卡盐湖，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 195140,
      "end_ms": 197225,
      "text": "青海海西茶卡镇。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 197760,
      "end_ms": 201730,
      "text": "这几年短视频上有一个词刷屏，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 201890,
      "end_ms": 202790,
      "text": "刷的很猛，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 202890,
      "end_ms": 205985,
      "text": "天空之境说的就是这个地方，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 206840,
      "end_ms": 210265,
      "text": "可很多人到了茶卡盐湖以后会失望，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 211420,
      "end_ms": 213005,
      "text": "觉得跟视频里不一样。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 213500,
      "end_ms": 215085,
      "text": "水面上全是脚印，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 215470,
      "end_ms": 218210,
      "text": "旁边全是拍照的人风一吹，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 218230,
      "end_ms": 219050,
      "text": "水面皱了，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 219050,
      "end_ms": 219975,
      "text": "镜子碎了，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 220220,
      "end_ms": 221975,
      "text": "那是因为去的时间不对，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 222290,
      "end_ms": 223345,
      "text": "走的位置不对。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 224210,
      "end_ms": 227735,
      "text": "茶卡盐湖的总面积超过一百平方公里，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 228660,
      "end_ms": 235350,
      "text": "大部分游客挤在入口那一小片区域可真正出天空之境效果的地方，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 235350,
      "end_ms": 239370,
      "text": "在深处坐小火车往里走人越来越少，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 239650,
      "end_ms": 241035,
      "text": "水面越来越平。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 241640,
      "end_ms": 242780,
      "text": "走到尽头的时候，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 242780,
      "end_ms": 244055,
      "text": "据去过的人描述，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 244540,
      "end_ms": 253530,
      "text": "脚下是一层不到脚踝深的盐水轻的能看见底下白色的盐晶水面纹丝不动。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 253670,
      "end_ms": 254675,
      "text": "天上的云，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 255020,
      "end_ms": 255935,
      "text": "远处的山，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 256420,
      "end_ms": 259235,
      "text": "自己的倒影全都印在脚底下，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 259780,
      "end_ms": 260800,
      "text": "往哪个方向看，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 260860,
      "end_ms": 261640,
      "text": "都分不清。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 261640,
      "end_ms": 265680,
      "text": "上面和下面这种感觉不是好看两个字，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 265680,
      "end_ms": 270355,
      "text": "能概括的是整个人的方向感被打乱。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 271030,
      "end_ms": 271770,
      "text": "站在那儿，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 271770,
      "end_ms": 273590,
      "text": "不知道自己是踩在地上，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 273590,
      "end_ms": 274790,
      "text": "还是飘在天上。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 275390,
      "end_ms": 279275,
      "text": "茶卡盐湖还有一样别的地方给不了的东西呀。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 279770,
      "end_ms": 283985,
      "text": "湖面上结着一层一层的盐壳白的发光。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 284690,
      "end_ms": 286265,
      "text": "据地质资料记载，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 286850,
      "end_ms": 292025,
      "text": "这些盐的沉积历史已有几千年走在上面咯吱咯吱响，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 292480,
      "end_ms": 295905,
      "text": "脚底下是几千年一层一层攒出来的白色结晶。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 296550,
      "end_ms": 298490,
      "text": "头顶上是高原的蓝天，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 298850,
      "end_ms": 304170,
      "text": "中间只有您自己一面几千年攒出来的镜子走到里面去，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 304409,
      "end_ms": 305970,
      "text": "天地就剩您一个人。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 306690,
      "end_ms": 307530,
      "text": "第八名，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 308030,
      "end_ms": 308790,
      "text": "千岛湖，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 309050,
      "end_ms": 312370,
      "text": "浙江杭州淳安县千岛湖。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 312670,
      "end_ms": 317390,
      "text": "很多人觉得千岛湖就是一个普通的水库景区坐坐游船，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 317510,
      "end_ms": 320450,
      "text": "看看小岛半天就逛完了，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 320570,
      "end_ms": 321470,
      "text": "没什么特别。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 321510,
      "end_ms": 324710,
      "text": "可千岛湖底下藏着一个秘密。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 324710,
      "end_ms": 327480,
      "text": "千岛湖的前身是是新安江水库。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 327940,
      "end_ms": 331500,
      "text": "上世纪五十年代修新安江水电站的时候，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 331620,
      "end_ms": 335140,
      "text": "蓄水形成的人工水蓄起来之后，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 335280,
      "end_ms": 338620,
      "text": "原来山谷里的两座古县城合成和石城，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 339140,
      "end_ms": 340820,
      "text": "整个沉到了水底下。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 341200,
      "end_ms": 348560,
      "text": "整座完整的古县城、城墙、牌坊、老宅、石板路全部泡在水里面。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 349280,
      "end_ms": 351240,
      "text": "据当地现制资料记载，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 351640,
      "end_ms": 353760,
      "text": "距今已经泡了六十多年，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 354300,
      "end_ms": 356765,
      "text": "后来有潜水团队下去探不过，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 357610,
      "end_ms": 359930,
      "text": "据参与探测的人员描述，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 360070,
      "end_ms": 362075,
      "text": "水下二十多米深的地方，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 362490,
      "end_ms": 366565,
      "text": "城墙还立着牌坊上的石雕还看得清。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 366970,
      "end_ms": 368935,
      "text": "有些老宅的门板还没烂，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 369590,
      "end_ms": 370550,
      "text": "木头门槛，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 370550,
      "end_ms": 372245,
      "text": "上面长满了水藻，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 372680,
      "end_ms": 377610,
      "text": "鱼从窗户里游进游出一座几百年的古城，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 377710,
      "end_ms": 380145,
      "text": "安安静静的泡在水底下。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 380590,
      "end_ms": 381705,
      "text": "房子还是房子，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 382130,
      "end_ms": 383345,
      "text": "街道还是街道。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 383610,
      "end_ms": 383740,
      "text": "嗯，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 384120,
      "end_ms": 386055,
      "text": "可住的人早就搬走了。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 386760,
      "end_ms": 389300,
      "text": "您坐在千岛湖的游船上喝茶，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 389360,
      "end_ms": 390655,
      "text": "看风景的时候，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 391220,
      "end_ms": 393540,
      "text": "脚底下二十多米就是一座古城。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 394020,
      "end_ms": 395420,
      "text": "城里的石板路上，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 395420,
      "end_ms": 397215,
      "text": "现在走的不是人是鱼。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 397960,
      "end_ms": 400955,
      "text": "现在有些区域开放了水下观光项目，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 401350,
      "end_ms": 402650,
      "text": "透过特制的玻璃，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 402650,
      "end_ms": 404735,
      "text": "可以看到水底的建筑轮廓，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 405210,
      "end_ms": 407525,
      "text": "也有专业的潜水体验项目，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 407760,
      "end_ms": 411525,
      "text": "可以近距离看到水下的排坊和城墙，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 412110,
      "end_ms": 415515,
      "text": "不过大部分游客还是选择在水面上坐船，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 416370,
      "end_ms": 418930,
      "text": "因为光是知道脚底下有一座古城，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 418950,
      "end_ms": 422830,
      "text": "这件事本身就够让人想很久了。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 423950,
      "end_ms": 425570,
      "text": "千岛湖的水有多好？"
    },
    {
      "segment_id": "s000154",
      "start_ms": 426010,
      "end_ms": 428630,
      "text": "据环境监测部门公开数据，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 429210,
      "end_ms": 433110,
      "text": "千岛湖的水质常年保持在很高的等级，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 433310,
      "end_ms": 437370,
      "text": "使周边多个城市的饮用水源地之一。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 438230,
      "end_ms": 442210,
      "text": "您喝着矿泉水瓶上可能就写着千岛湖水源，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 442810,
      "end_ms": 443530,
      "text": "可您不知道，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 443530,
      "end_ms": 445850,
      "text": "这水是从一座沉在水底，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 446140,
      "end_ms": 447800,
      "text": "你的古城上面流过来，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 448500,
      "end_ms": 451400,
      "text": "一个水库底下藏着两座古城，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 451800,
      "end_ms": 453280,
      "text": "上面留着您喝的水。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 454279,
      "end_ms": 460260,
      "text": "第七名、泸沽湖、云南丽江和四川盐源交界的地方。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 461020,
      "end_ms": 462380,
      "text": "据地理资料记载，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 462380,
      "end_ms": 465820,
      "text": "海拔两千多米的山里藏着一个湖，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 465900,
      "end_ms": 467140,
      "text": "叫泸沽湖。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 467800,
      "end_ms": 471680,
      "text": "很多人对泸沽湖的印象停留在女儿国三个字，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 471680,
      "end_ms": 475935,
      "text": "上学的就是一个有少数民族风情的旅游景点。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 476560,
      "end_ms": 479480,
      "text": "可真正到了泸沽湖边上的人都会说，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 479480,
      "end_ms": 480160,
      "text": "同一句话，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 480180,
      "end_ms": 481320,
      "text": "水太干净了。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 482180,
      "end_ms": 484160,
      "text": "泸沽湖的水干净到什么程度？"
    },
    {
      "segment_id": "s000173",
      "start_ms": 484479,
      "end_ms": 485960,
      "text": "据去过的人描述，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 486640,
      "end_ms": 489620,
      "text": "船划到湖中间往水里看，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 490160,
      "end_ms": 492720,
      "text": "能看到好几米深的地方，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 493500,
      "end_ms": 494640,
      "text": "湖底的水草，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 494820,
      "end_ms": 499480,
      "text": "一根一根的石头上的纹路清清楚楚，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 500020,
      "end_ms": 501380,
      "text": "水草在水底下，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 501380,
      "end_ms": 502780,
      "text": "随着水流慢慢摆，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 503200,
      "end_ms": 504940,
      "text": "像一片水下的草原。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 505700,
      "end_ms": 507250,
      "text": "据当地居民介绍，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 507690,
      "end_ms": 508730,
      "text": "每年夏天，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 508790,
      "end_ms": 510710,
      "text": "泸沽湖里会开一种花，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 510810,
      "end_ms": 512690,
      "text": "当地人叫水性杨花。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 513490,
      "end_ms": 515190,
      "text": "据植物学资料介绍，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 515530,
      "end_ms": 521190,
      "text": "学名叫波叶海菜花根扎在湖底茎很长，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 521630,
      "end_ms": 523170,
      "text": "花飘在水面上，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 523510,
      "end_ms": 526510,
      "text": "白色的小花一朵一朵的铺满湖面。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 527230,
      "end_ms": 530870,
      "text": "这种花只在水质特别好的湖里才能存活，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 531410,
      "end_ms": 533330,
      "text": "水稍微混一点就长不了。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 533670,
      "end_ms": 535550,
      "text": "泸沽湖边住着摩梭人，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 535990,
      "end_ms": 539335,
      "text": "摩梭人至今保留着母系家庭的传统，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 539750,
      "end_ms": 541955,
      "text": "家里的事情由女性做主。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 542540,
      "end_ms": 544880,
      "text": "据民俗学者实地调查记录，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 545240,
      "end_ms": 548300,
      "text": "湖边的木笼房是老辈人一根一根木头，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 548300,
      "end_ms": 548860,
      "text": "搭起来，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 548900,
      "end_ms": 550625,
      "text": "据说不用一颗钉子。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 551240,
      "end_ms": 553645,
      "text": "早上太阳刚升起来的时候，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 554070,
      "end_ms": 556005,
      "text": "湖面上飘着一层薄雾，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 556520,
      "end_ms": 558875,
      "text": "朱槽船从雾里慢慢滑出来，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 559400,
      "end_ms": 562835,
      "text": "船头坐着穿民族服装的摩梭阿妈，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 563290,
      "end_ms": 565585,
      "text": "手里的桨一下一下滑的很慢，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 566290,
      "end_ms": 570155,
      "text": "水面上的花被船头分开又在船尾合拢。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 570960,
      "end_ms": 575200,
      "text": "这个画面不是旅游宣传片里摆拍的据，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 575260,
      "end_ms": 577855,
      "text": "常年住在湖边的居民说，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 578370,
      "end_ms": 579745,
      "text": "每天早上都是这样。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 580730,
      "end_ms": 583730,
      "text": "泸沽湖不是那种看一眼拍张照就走的地方。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 583850,
      "end_ms": 585570,
      "text": "据不少去过的游客反馈，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 585750,
      "end_ms": 587065,
      "text": "住上两三天，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 587520,
      "end_ms": 589980,
      "text": "每天早上起来到湖边坐一会儿，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 589980,
      "end_ms": 590785,
      "text": "什么都不干，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 591610,
      "end_ms": 596035,
      "text": "光看着水和化合物回来以后很长时间心里都是静。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 596830,
      "end_ms": 599700,
      "text": "一个湖干净到能长花，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 600020,
      "end_ms": 603355,
      "text": "一种花只在特别干净的水里才肯开。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 604310,
      "end_ms": 604910,
      "text": "第六名，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 605130,
      "end_ms": 606510,
      "text": "恩施平山峡谷，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 606590,
      "end_ms": 609510,
      "text": "湖北恩施鹤峰县平山峡谷。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 610270,
      "end_ms": 612970,
      "text": "这个地方前几年在短视频上报过一次，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 613210,
      "end_ms": 615190,
      "text": "一条木船飘在水面上，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 615550,
      "end_ms": 618190,
      "text": "可船底下的水清的像没有水一样，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 618230,
      "end_ms": 621530,
      "text": "船像是悬浮在半空中底下的石头，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 621830,
      "end_ms": 623450,
      "text": "水草看得一清二楚，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 623830,
      "end_ms": 626750,
      "text": "船的影子直接投在河底的石头上。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 627490,
      "end_ms": 629430,
      "text": "很多人第一次看到这个画面，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 629430,
      "end_ms": 630390,
      "text": "都以为是特效，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 630990,
      "end_ms": 631770,
      "text": "不是特效，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 632270,
      "end_ms": 636060,
      "text": "平山峡谷的水就是这么清清到肉眼，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 636060,
      "end_ms": 637420,
      "text": "看不出水面在哪里，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 637600,
      "end_ms": 638500,
      "text": "为什么这么清？"
    },
    {
      "segment_id": "s000230",
      "start_ms": 638920,
      "end_ms": 641620,
      "text": "平山峡谷是典型的喀斯特地貌，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 641900,
      "end_ms": 645800,
      "text": "两边是垂直的石灰岩峭壁最窄的地方。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 645800,
      "end_ms": 647960,
      "text": "距景区实测数据不到几米宽，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 648760,
      "end_ms": 651620,
      "text": "光谷底部的水是地下河涌上来，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 651640,
      "end_ms": 653540,
      "text": "经过层层石灰岩过滤，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 653900,
      "end_ms": 655860,
      "text": "杂质被滤得干干净净，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 656100,
      "end_ms": 660540,
      "text": "加上峡谷两边的峭壁挡住了大部分风水面，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 660600,
      "end_ms": 661740,
      "text": "常年平静，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 661840,
      "end_ms": 662700,
      "text": "没有波纹，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 663260,
      "end_ms": 665865,
      "text": "光线直直直得穿下去打在河底上，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 666320,
      "end_ms": 668950,
      "text": "所以看起来像是没有水平。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 668950,
      "end_ms": 670550,
      "text": "山峡谷还有一样东西，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 670550,
      "end_ms": 671945,
      "text": "很少有人提到声音。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 672500,
      "end_ms": 674020,
      "text": "据去过的人描述，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 674320,
      "end_ms": 675255,
      "text": "峡谷很窄，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 675670,
      "end_ms": 679760,
      "text": "两边是几十米高的石壁人在船上说句话，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 679760,
      "end_ms": 683295,
      "text": "声音会在两边弹来弹去回声叠着回声。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 684230,
      "end_ms": 685650,
      "text": "可如果谁都不说话，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 685750,
      "end_ms": 688310,
      "text": "整个峡谷安静的只剩水滴，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 688490,
      "end_ms": 691825,
      "text": "从石壁上落下来的声音啪嗒一声，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 692360,
      "end_ms": 695135,
      "text": "然后是一圈儿一圈儿的涟漪。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 696160,
      "end_ms": 700095,
      "text": "大部分人去恩师只知道大峡谷和玻璃栈道，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 700620,
      "end_ms": 705075,
      "text": "不知道旁边还藏着一个水清道让船悬浮的峡谷。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 705930,
      "end_ms": 708205,
      "text": "据当地旅游部门的数据统计，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 708670,
      "end_ms": 711835,
      "text": "平山峡谷这几年游客量在快速增长，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 712510,
      "end_ms": 716345,
      "text": "但跟大峡谷比还是少得多想去的趁早。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 716760,
      "end_ms": 719380,
      "text": "人少的时候那种安静和清透是人多了，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 719380,
      "end_ms": 724915,
      "text": "以后给不了一条峡谷水清道让船悬浮，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 725830,
      "end_ms": 726645,
      "text": "不是特效，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 727220,
      "end_ms": 728195,
      "text": "不是滤镜。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 729020,
      "end_ms": 730815,
      "text": "据地质学者分析，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 731600,
      "end_ms": 733000,
      "text": "是喀斯特石灰岩，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 733080,
      "end_ms": 735320,
      "text": "经过漫长的地质年代，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 735440,
      "end_ms": 736825,
      "text": "替您把水滤干净。"
    },
    {
      "segment_id": "s000264",
      "start_ms": 737450,
      "end_ms": 739805,
      "text": "先在评论区打出四个字，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 740300,
      "end_ms": 743020,
      "text": "水边仙境打完了，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 743020,
      "end_ms": 744385,
      "text": "咱们接着讲前五名，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 744720,
      "end_ms": 746280,
      "text": "一个比一个让人不敢相信。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 746300,
      "end_ms": 749470,
      "text": "这是在中国今天讲的这五个，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 749470,
      "end_ms": 752180,
      "text": "您品品峡浦滩涂不用爬山，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 752220,
      "end_ms": 752940,
      "text": "站在岸边，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 752960,
      "end_ms": 754385,
      "text": "看日出就是一幅画。"
    },
    {
      "segment_id": "s000272",
      "start_ms": 755350,
      "end_ms": 757210,
      "text": "茶卡盐湖走到深处，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 757250,
      "end_ms": 758870,
      "text": "天地只剩您一个人。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 758890,
      "end_ms": 761795,
      "text": "千岛湖上面和茶下面泡着两座古城，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 762600,
      "end_ms": 764840,
      "text": "泸沽湖干净到能开花，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 764860,
      "end_ms": 770815,
      "text": "只有特别干净的水才配恩施平山峡谷水清道船直接悬浮。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 771760,
      "end_ms": 776430,
      "text": "可这五个加一块儿都比不过排在榜首的那个地方，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 776430,
      "end_ms": 780165,
      "text": "去去过的人描述水面像一面镜子，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 780830,
      "end_ms": 783605,
      "text": "天和地同时倒映在里面，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 784390,
      "end_ms": 785570,
      "text": "人站在中间，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 785570,
      "end_ms": 786950,
      "text": "连方向感都没了，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 787410,
      "end_ms": 789410,
      "text": "不知道自己是站在地上，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 789410,
      "end_ms": 790650,
      "text": "还是飘在天上。"
    },
    {
      "segment_id": "s000284",
      "start_ms": 791430,
      "end_ms": 794350,
      "text": "可这个地方大部分人连名字都没停过，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 794470,
      "end_ms": 797530,
      "text": "下一集已经同步更新了点，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 797570,
      "end_ms": 799250,
      "text": "我头像进主页第一条，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 799530,
      "end_ms": 802125,
      "text": "就是咱们接着接。"
    }
  ],
  "source_transcript_sha256": "5bf418d77fa7c3a2121931efd182fffe2a24d75d0f29e5544681b0ca9ec6c3b6"
}