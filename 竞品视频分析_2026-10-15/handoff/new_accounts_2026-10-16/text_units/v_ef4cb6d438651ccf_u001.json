{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ef4cb6d438651ccf_u001",
  "video_id": "v_ef4cb6d438651ccf",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 480.468005,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 2730,
      "text": "您知道故宫里皇帝每天用的是什么吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2950,
      "end_ms": 5490,
      "text": "有人说是今晚金光闪闪，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5670,
      "end_ms": 6630,
      "text": "吃饭用的。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6930,
      "end_ms": 8050,
      "text": "有人说是龙椅，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8410,
      "end_ms": 9230,
      "text": "九条金，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 9250,
      "end_ms": 14770,
      "text": "龙盘着坐上去享威风错了皇帝吃饭不用，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 14810,
      "end_ms": 17570,
      "text": "今晚今晚倒热快烫嘴。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18010,
      "end_ms": 20690,
      "text": "真正用的是成化斗彩鸡缸杯。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21050,
      "end_ms": 23490,
      "text": "二零一四年拍卖拍出二点八亿，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 24050,
      "end_ms": 25950,
      "text": "皇帝也不天天坐龙椅，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 26330,
      "end_ms": 27990,
      "text": "龙椅是上朝用的。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 28730,
      "end_ms": 31780,
      "text": "真正每天离不开开的是乾隆的夺宝阁，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 32720,
      "end_ms": 35020,
      "text": "藏了一百零八件小玩意儿，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 35800,
      "end_ms": 36820,
      "text": "每天摆弄。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 36980,
      "end_ms": 41060,
      "text": "今天咱们就来盘点故宫里十件皇帝每天都用，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 41460,
      "end_ms": 44040,
      "text": "但您从没注意过的日常器物，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 44760,
      "end_ms": 47700,
      "text": "每一件都藏着皇帝的真性情。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 48420,
      "end_ms": 52600,
      "text": "每一件比今晚隆椅更能看出皇帝是个什么人。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 53020,
      "end_ms": 53800,
      "text": "第十名，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 55040,
      "end_ms": 56800,
      "text": "盛化斗彩鸡缸杯，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 57620,
      "end_ms": 58960,
      "text": "这是一只小酒杯，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 59560,
      "end_ms": 61035,
      "text": "高不到八厘米，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 61750,
      "end_ms": 63245,
      "text": "口径八厘米多。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 64070,
      "end_ms": 70330,
      "text": "您一只手就能握住明朝成化年间烧的杯，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 70330,
      "end_ms": 72675,
      "text": "身上画着公鸡母鸡带小鸡，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 73200,
      "end_ms": 76940,
      "text": "六只小鸡跟在鸡妈妈后面画的活灵活现。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 77120,
      "end_ms": 79105,
      "text": "您知道这只杯子有多绝吗？"
    },
    {
      "segment_id": "s000028",
      "start_ms": 80110,
      "end_ms": 85265,
      "text": "斗彩工艺先用青花勾线烧一遍，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 86020,
      "end_ms": 89095,
      "text": "在田采釉又烧一遍，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 89500,
      "end_ms": 92645,
      "text": "两次烧制温度差一点，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 94240,
      "end_ms": 95325,
      "text": "颜色就不对，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 95760,
      "end_ms": 96980,
      "text": "石窑能成一窑，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 96980,
      "end_ms": 97975,
      "text": "就算撞大运。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 98540,
      "end_ms": 100120,
      "text": "成化皇帝喜欢喝酒，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 100460,
      "end_ms": 102505,
      "text": "每次喝酒就用这只杯子，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 102760,
      "end_ms": 104710,
      "text": "杯子小一口一杯，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 105050,
      "end_ms": 106645,
      "text": "喝的慢不容易醉。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 107530,
      "end_ms": 109535,
      "text": "传说成化皇帝有一次喝多了，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 109950,
      "end_ms": 111645,
      "text": "摔碎了一只鸡缸杯，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 112320,
      "end_ms": 113645,
      "text": "第二天酒醒了，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 114270,
      "end_ms": 115250,
      "text": "心疼的不行，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 115550,
      "end_ms": 116855,
      "text": "让人重烧，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 117550,
      "end_ms": 119590,
      "text": "可怎么都烧不出那个味儿了。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 119590,
      "end_ms": 120575,
      "text": "二零一四年，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 120990,
      "end_ms": 123965,
      "text": "一只鸡缸杯在香港苏富比拍卖，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 124630,
      "end_ms": 126805,
      "text": "拍出二点八亿港币。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 127550,
      "end_ms": 131765,
      "text": "一只巴掌大的酒杯能买北京三环的一套房，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 132520,
      "end_ms": 134685,
      "text": "您说这是杯子还是传家宝？"
    },
    {
      "segment_id": "s000049",
      "start_ms": 135280,
      "end_ms": 135895,
      "text": "聊到这儿，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 136850,
      "end_ms": 138675,
      "text": "先在评论区打出四个字，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 139210,
      "end_ms": 142585,
      "text": "皇家日常打完我接着往下讲。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 143600,
      "end_ms": 147975,
      "text": "这时件里头有一件皇帝天天戴在身上，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 149080,
      "end_ms": 150225,
      "text": "丢了就睡不着觉。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 150640,
      "end_ms": 151455,
      "text": "第九名，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 151850,
      "end_ms": 153655,
      "text": "雍正的奏折猪皮，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 154610,
      "end_ms": 157045,
      "text": "您知道雍正皇帝每天干什么吗？"
    },
    {
      "segment_id": "s000057",
      "start_ms": 158330,
      "end_ms": 162575,
      "text": "批奏者早上起来披到晚上一天能批几十份，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 163240,
      "end_ms": 164485,
      "text": "一年批几千份，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 165380,
      "end_ms": 166355,
      "text": "批了十几年。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 167310,
      "end_ms": 169115,
      "text": "雍正的猪皮特别有意思，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 169960,
      "end_ms": 171805,
      "text": "不像康熙那么正经八百，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 172650,
      "end_ms": 174155,
      "text": "他p的跟聊天一样，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 174610,
      "end_ms": 175825,
      "text": "大臣说臣病了，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 176560,
      "end_ms": 178515,
      "text": "雍正批你要保重身体啊。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 179330,
      "end_ms": 181025,
      "text": "大臣说今年收成不好。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 181650,
      "end_ms": 183095,
      "text": "雍正批朕知道了，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 183800,
      "end_ms": 185665,
      "text": "已经派人去赈灾了。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 186710,
      "end_ms": 188730,
      "text": "最有名的一句是朕就是这样。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 188730,
      "end_ms": 190810,
      "text": "汉字大臣说他脾气大，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 190910,
      "end_ms": 191835,
      "text": "他也不生气，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 192390,
      "end_ms": 193150,
      "text": "直接批。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 193150,
      "end_ms": 193790,
      "text": "正就是这样。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 193790,
      "end_ms": 195395,
      "text": "汉字就是这样秉性，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 195800,
      "end_ms": 199415,
      "text": "就是这样皇帝雍正一辈子批了几万份奏折。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 199830,
      "end_ms": 201115,
      "text": "每一份都是亲笔，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 201730,
      "end_ms": 206195,
      "text": "从来不让太监代兵传说雍正睡觉都放心不下，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 206690,
      "end_ms": 207470,
      "text": "半夜醒了，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 207470,
      "end_ms": 208290,
      "text": "还要爬起来，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 208290,
      "end_ms": 209835,
      "text": "披几份才能睡。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 210760,
      "end_ms": 215790,
      "text": "一个皇帝把批奏折当成每天必须干的活儿。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 216710,
      "end_ms": 219095,
      "text": "您说这是行政还是工作狂？"
    },
    {
      "segment_id": "s000082",
      "start_ms": 220740,
      "end_ms": 221515,
      "text": "第八名，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 222860,
      "end_ms": 224065,
      "text": "康熙的眼镜，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 224600,
      "end_ms": 226575,
      "text": "您知道康熙皇帝戴眼镜吗？"
    },
    {
      "segment_id": "s000085",
      "start_ms": 226970,
      "end_ms": 231515,
      "text": "康熙晚年眼睛花了看不清奏折上的小字，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 232230,
      "end_ms": 234790,
      "text": "传教士进贡了一副西洋眼镜。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 234830,
      "end_ms": 235970,
      "text": "康熙戴上一试，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 236210,
      "end_ms": 237165,
      "text": "能看清了，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 237510,
      "end_ms": 238385,
      "text": "高兴的不得了。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 239120,
      "end_ms": 241520,
      "text": "这副眼镜是玻璃镜片配铜框，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 241740,
      "end_ms": 243175,
      "text": "两个镜腿能折叠，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 243630,
      "end_ms": 245475,
      "text": "跟现在的眼镜差不多。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 246140,
      "end_ms": 249100,
      "text": "康熙每天批奏折都带着他不戴，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 249240,
      "end_ms": 252030,
      "text": "就看不清传说。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 252050,
      "end_ms": 254755,
      "text": "康熙有一次把眼镜落在御花园了，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 255550,
      "end_ms": 257375,
      "text": "太监找了半天才找到。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 258070,
      "end_ms": 258855,
      "text": "康熙说，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 259730,
      "end_ms": 261645,
      "text": "这玩意儿比玉玺都重要，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 262940,
      "end_ms": 263840,
      "text": "玉玺丢了，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 263840,
      "end_ms": 264935,
      "text": "朕还是皇帝，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 265310,
      "end_ms": 266190,
      "text": "眼镜丢了，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 266190,
      "end_ms": 267195,
      "text": "朕就是瞎子，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 267540,
      "end_ms": 268520,
      "text": "一副眼镜，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 268780,
      "end_ms": 271335,
      "text": "让皇帝批了十几年奏折，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 271880,
      "end_ms": 274080,
      "text": "您说这是眼镜还是办公工具？"
    },
    {
      "segment_id": "s000106",
      "start_ms": 274120,
      "end_ms": 276255,
      "text": "第七名无佛，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 276580,
      "end_ms": 278005,
      "text": "乾隆的夺宝阁，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 278990,
      "end_ms": 281395,
      "text": "这是一个小柜子十几层，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 281860,
      "end_ms": 283635,
      "text": "每一层都有小格子，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 284130,
      "end_ms": 286515,
      "text": "每个格子里放一件小玩意儿，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 287440,
      "end_ms": 295425,
      "text": "玉的、瓷的、铜的一共一百零八件。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 296360,
      "end_ms": 299295,
      "text": "乾隆每天吃完饭就拿出来摆弄。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 300150,
      "end_ms": 301730,
      "text": "今天看看这个玉佩，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 302090,
      "end_ms": 304010,
      "text": "明天摸摸那个小瓷瓶，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 304410,
      "end_ms": 306050,
      "text": "一摆弄就是大半天。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 307450,
      "end_ms": 310050,
      "text": "乾隆喜欢收藏一辈子，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 310050,
      "end_ms": 311430,
      "text": "收了几万件文物，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 311770,
      "end_ms": 315870,
      "text": "可他最宝贝的就是这一百零八件放在多宝阁里，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 316230,
      "end_ms": 317550,
      "text": "走到哪儿带到哪。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 317650,
      "end_ms": 321710,
      "text": "传说乾隆去世前把多宝阁传给了嘉庆，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 322270,
      "end_ms": 323630,
      "text": "嘉庆打开一看，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 324130,
      "end_ms": 327590,
      "text": "每一件上面都有乾隆亲笔题的诗，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 327990,
      "end_ms": 329625,
      "text": "一共一百零八首诗，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 330160,
      "end_ms": 333780,
      "text": "写满了他这一辈子的喜怒哀乐，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 334400,
      "end_ms": 337440,
      "text": "一个柜子藏着一个皇帝的一生。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 338140,
      "end_ms": 340300,
      "text": "您说这是收藏还是日记？"
    },
    {
      "segment_id": "s000127",
      "start_ms": 341120,
      "end_ms": 341800,
      "text": "第六名，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 342700,
      "end_ms": 347000,
      "text": "慈禧的指甲套慈禧太后有个癖好，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 347760,
      "end_ms": 351980,
      "text": "刘长指甲最长的能有十几厘米，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 352400,
      "end_ms": 353880,
      "text": "指甲长了容易套，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 354500,
      "end_ms": 358680,
      "text": "她就让人做了十个指甲套纯金打的，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 358720,
      "end_ms": 360635,
      "text": "上面镶着珍珠珠宝石。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 361410,
      "end_ms": 362490,
      "text": "每天早上起来，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 362810,
      "end_ms": 364610,
      "text": "太监帮他一个一个套上去，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 364890,
      "end_ms": 367565,
      "text": "金光闪闪的像十根金手指。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 368080,
      "end_ms": 372685,
      "text": "慈禧带着指甲套吃饭、写字批奏折，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 374070,
      "end_ms": 374995,
      "text": "什么都不耽误。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 376010,
      "end_ms": 376490,
      "text": "传说。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 376530,
      "end_ms": 380310,
      "text": "慈禧有一次指甲套掉了一个宫里，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 380350,
      "end_ms": 384640,
      "text": "上上下下找了三天才找到找到的太监，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 384660,
      "end_ms": 386095,
      "text": "赏了一百两银子，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 386560,
      "end_ms": 390915,
      "text": "一套指甲套比有些人一辈子挣的钱都多。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 391530,
      "end_ms": 393795,
      "text": "您说这是首饰还是身份？"
    },
    {
      "segment_id": "s000144",
      "start_ms": 394480,
      "end_ms": 395855,
      "text": "从第十到第六名，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 396820,
      "end_ms": 402545,
      "text": "这五件东西都够特别成化鸡缸杯一只小酒杯拍出二点八亿。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 402960,
      "end_ms": 405795,
      "text": "雍正批奏折p的跟聊天一样，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 406100,
      "end_ms": 407305,
      "text": "一年批几千份。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 408060,
      "end_ms": 410365,
      "text": "康熙戴眼镜待了十几年，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 410610,
      "end_ms": 412115,
      "text": "丢了比丢玉玺还急。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 412630,
      "end_ms": 416745,
      "text": "乾隆的多宝阁藏了一百零八件小玩意儿，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 417510,
      "end_ms": 419485,
      "text": "每一件都提了诗，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 420250,
      "end_ms": 426155,
      "text": "慈禧的指甲套纯金镶珠吊一个赏一百两银子，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 426940,
      "end_ms": 428765,
      "text": "可他们还不是最特别的。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 429230,
      "end_ms": 434605,
      "text": "接下来第五道第一名更能看出皇帝的真性情。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 435630,
      "end_ms": 436745,
      "text": "有一件东西，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 437020,
      "end_ms": 440185,
      "text": "皇帝每天带在身上丢了就睡不着觉。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 441070,
      "end_ms": 442920,
      "text": "有一件康熙一支笔，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 442920,
      "end_ms": 443895,
      "text": "用了几十年，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 444650,
      "end_ms": 446285,
      "text": "笔杆都磨出包浆了。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 447040,
      "end_ms": 449300,
      "text": "有一件皇帝，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 449300,
      "end_ms": 451000,
      "text": "每天睡觉前都要闻一闻，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 451000,
      "end_ms": 451775,
      "text": "才能入睡。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 452250,
      "end_ms": 453660,
      "text": "有一件乾隆，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 453680,
      "end_ms": 456175,
      "text": "每天吃饭前都要看一眼才动筷子。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 456560,
      "end_ms": 460020,
      "text": "还有一件皇帝临死前抱着不撒手，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 460460,
      "end_ms": 461555,
      "text": "带进了棺材。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 461930,
      "end_ms": 463405,
      "text": "这几件到底是什么？"
    },
    {
      "segment_id": "s000168",
      "start_ms": 463790,
      "end_ms": 464975,
      "text": "到底有多特别？"
    },
    {
      "segment_id": "s000169",
      "start_ms": 465460,
      "end_ms": 467705,
      "text": "下一集已经同步更新，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 468540,
      "end_ms": 470000,
      "text": "直接点开我的头像，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 470040,
      "end_ms": 470815,
      "text": "进入主页。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 471720,
      "end_ms": 475710,
      "text": "第一条视频就是下一集点个关注，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 475730,
      "end_ms": 480385,
      "text": "咱们好好看看皇帝每天用的东西到底藏着什么秘密。"
    }
  ],
  "source_transcript_sha256": "abed48e8386ab8cac2c0f00e5306077c4fb30ad707892f5178efd69147dd20d8"
}