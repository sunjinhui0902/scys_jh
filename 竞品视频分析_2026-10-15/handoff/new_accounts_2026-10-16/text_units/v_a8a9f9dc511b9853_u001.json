{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_a8a9f9dc511b9853_u001",
  "video_id": "v_a8a9f9dc511b9853",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 627.706009,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 330,
      "end_ms": 3330,
      "text": "十分钟讲解凯恩斯就业利息和货币通论。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3390,
      "end_ms": 6210,
      "text": "你是否曾在经济的潮起潮落中感到无力？"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6510,
      "end_ms": 7590,
      "text": "仿佛个人的努力，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7590,
      "end_ms": 11590,
      "text": "在时代的巨浪前微不足道或翻开八十多年前的救助，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 11890,
      "end_ms": 15410,
      "text": "却惊觉那些对萧条与失业的追问依然在叩。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 15410,
      "end_ms": 16610,
      "text": "打着今日的困局，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16910,
      "end_ms": 19550,
      "text": "凯恩斯的就业利息和货币通论。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 19650,
      "end_ms": 21470,
      "text": "正是这样一部划时代的杰作，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21870,
      "end_ms": 24270,
      "text": "他以颠覆性的洞察、冷峻的笔触，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 24550,
      "end_ms": 26430,
      "text": "将市场自动均衡的神话，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 26450,
      "end_ms": 32920,
      "text": "层层拨开揭示了一个被传统经济学遮蔽的真像经济并非总能自我修复，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 33220,
      "end_ms": 35260,
      "text": "失业也并非自愿的选择。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 35500,
      "end_ms": 38140,
      "text": "他要为每一个在萧条中挣扎的普通人，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 38380,
      "end_ms": 42200,
      "text": "找回那种能够解释困境、指引出路的经济智慧。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 42200,
      "end_ms": 43400,
      "text": "从萨伊定律的破产，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 43500,
      "end_ms": 45240,
      "text": "到有效需求原理的登场，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 45580,
      "end_ms": 49140,
      "text": "从乘数效应的放大机制到流动性偏好的心理深渊。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 49360,
      "end_ms": 49740,
      "text": "他说，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 50180,
      "end_ms": 52780,
      "text": "经济学的真正使命不是粉饰太平，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 53180,
      "end_ms": 56620,
      "text": "而是让你看清繁荣维和中断失业。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 56720,
      "end_ms": 58180,
      "text": "维和持续今天，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 58400,
      "end_ms": 61830,
      "text": "就让我们在八分钟里越八十余年的思想风云，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 62090,
      "end_ms": 64845,
      "text": "走进八个层层超声的理解境界。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 65260,
      "end_ms": 65940,
      "text": "你会发现，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 66120,
      "end_ms": 68220,
      "text": "那些看似晦涩的经济学概念，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 68420,
      "end_ms": 71020,
      "text": "恰恰能回答你最切身的生活困惑。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 71060,
      "end_ms": 73400,
      "text": "八个思想主题如同八重境界，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 73620,
      "end_ms": 78415,
      "text": "引领我们步步行生最终叩问经济运行的真相与人的处境。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 79070,
      "end_ms": 79755,
      "text": "主题一，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 80250,
      "end_ms": 81870,
      "text": "经济学不再描述均衡，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 82090,
      "end_ms": 83170,
      "text": "而在解释失衡。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 83390,
      "end_ms": 88160,
      "text": "凯恩斯之前的古典经济学坚信萨伊定律供给自动创造需求，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 88520,
      "end_ms": 90545,
      "text": "市场永远趋向充分就业，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 90890,
      "end_ms": 93225,
      "text": "但大萧条的现实击碎了这一信条。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 93570,
      "end_ms": 98125,
      "text": "通论自始就关注非自愿失业的成因与有效需求的不足，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 98490,
      "end_ms": 100465,
      "text": "而非市场如何自动出清？"
    },
    {
      "segment_id": "s000037",
      "start_ms": 100910,
      "end_ms": 101695,
      "text": "凯恩斯指出，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 101990,
      "end_ms": 106110,
      "text": "消费倾向资本边际效率与流动性偏好三大心理规律，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 106310,
      "end_ms": 109535,
      "text": "无一不是导致有效需求系统性不足的根源，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 109900,
      "end_ms": 114015,
      "text": "这与古典经济学重均衡上自动调节的传统大不相同。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 114270,
      "end_ms": 115510,
      "text": "凯恩斯更关心的是，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 115530,
      "end_ms": 118530,
      "text": "经济为何卡在小于充分就业的均衡中，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 118750,
      "end_ms": 120485,
      "text": "而不是何为理想状态？"
    },
    {
      "segment_id": "s000044",
      "start_ms": 120820,
      "end_ms": 121615,
      "text": "正如他所言，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 121980,
      "end_ms": 123305,
      "text": "充分就业只是特例，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 123630,
      "end_ms": 126095,
      "text": "小于充分就业的均衡才是常态。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 126540,
      "end_ms": 126940,
      "text": "这提醒，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 126940,
      "end_ms": 132030,
      "text": "我们在繁荣的喧嚣中更需正视那些被看不见的手遮蔽的裂缝，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 132250,
      "end_ms": 133045,
      "text": "一次失业，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 133260,
      "end_ms": 134035,
      "text": "一场萧条，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 134330,
      "end_ms": 137560,
      "text": "一个被遗忘的工人都是经济失衡的真实面孔，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 137580,
      "end_ms": 140420,
      "text": "经济的健康终究来自于总需求的充足，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 140620,
      "end_ms": 142380,
      "text": "而非信条的坚定主题。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 142380,
      "end_ms": 146650,
      "text": "二、有效需求四重奏从消费到投资的层层递进。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 146790,
      "end_ms": 149305,
      "text": "凯恩斯提出著名的有效需求框架，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 149680,
      "end_ms": 149920,
      "text": "说，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 149940,
      "end_ms": 156285,
      "text": "消费需求、投资需求、乘数效应与就业水平消费需求取决于边际消费倾向，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 156710,
      "end_ms": 158975,
      "text": "收入增加时消费增量却递减，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 159450,
      "end_ms": 160170,
      "text": "富人越富，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 160390,
      "end_ms": 161590,
      "text": "消费占比却越低。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 161690,
      "end_ms": 165205,
      "text": "投资需求取决于资本边际效率与利率的对比，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 165460,
      "end_ms": 166760,
      "text": "投资回报预期越低，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 166980,
      "end_ms": 168000,
      "text": "借贷成本越高，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 168220,
      "end_ms": 169440,
      "text": "投资越受抑制，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 169540,
      "end_ms": 175095,
      "text": "乘数效应则让每一笔新增投资像投入水中的石子涟漪层层扩散，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 175430,
      "end_ms": 178470,
      "text": "最终带来数倍于初始投入的国民收入增长。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 178750,
      "end_ms": 181845,
      "text": "就业水平则最终由有效需求的总量决定。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 182280,
      "end_ms": 182980,
      "text": "需求不足，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 183100,
      "end_ms": 185045,
      "text": "则非自愿失业必然出现。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 185380,
      "end_ms": 186500,
      "text": "这不是独立的变量，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 186640,
      "end_ms": 187800,
      "text": "而是因果的链条。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 187980,
      "end_ms": 190875,
      "text": "我们可能在不同时刻感受到不同环节的紧绷。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 191130,
      "end_ms": 194610,
      "text": "但经济学的目标是帮助我们看清这条链条的全貌，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 194930,
      "end_ms": 197165,
      "text": "比如一笔政府修路的支出，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 197460,
      "end_ms": 199325,
      "text": "可以只为创造短期岗位，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 199630,
      "end_ms": 202205,
      "text": "也可以视为撬动民间投资的杠杆，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 202660,
      "end_ms": 206315,
      "text": "更可理解为对有效需求缺口的系统性填补。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 206930,
      "end_ms": 208310,
      "text": "这个学说让我们意识到，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 208610,
      "end_ms": 210810,
      "text": "经济的意义不在于钱多钱少，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 211190,
      "end_ms": 212830,
      "text": "而在于钱是否在流动，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 213050,
      "end_ms": 214270,
      "text": "是否在创造就业。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 214490,
      "end_ms": 215450,
      "text": "我们可常自问，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 215750,
      "end_ms": 220620,
      "text": "此刻我所在的经济体有效需求是充盈还是干涸主题？"
    },
    {
      "segment_id": "s000084",
      "start_ms": 220620,
      "end_ms": 224070,
      "text": "三乘数是一种自我强化的动态过程。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 224210,
      "end_ms": 225430,
      "text": "而非静态的算术，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 225510,
      "end_ms": 227710,
      "text": "很多人误以为乘数就是简单的倍数，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 227710,
      "end_ms": 229000,
      "text": "放大投资，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 229000,
      "end_ms": 229820,
      "text": "增加一百亿，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 229900,
      "end_ms": 231220,
      "text": "收入就增加四百亿，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 231340,
      "end_ms": 232725,
      "text": "仿佛一个固定的公式。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 233100,
      "end_ms": 234185,
      "text": "但凯恩斯澄清，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 234510,
      "end_ms": 237705,
      "text": "成熟的真正精神是收入的循环流转，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 238030,
      "end_ms": 242175,
      "text": "是在每一消费中上一轮的收入转化为下一轮的需求，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 242510,
      "end_ms": 245155,
      "text": "如同水波在池塘中一圈圈扩散。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 245570,
      "end_ms": 247465,
      "text": "每一圈都比上一圈衰减，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 247720,
      "end_ms": 248920,
      "text": "边际消费倾向越高，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 249180,
      "end_ms": 250365,
      "text": "水波衰减越慢，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 250570,
      "end_ms": 251295,
      "text": "乘数越大，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 251690,
      "end_ms": 252810,
      "text": "储蓄倾向越高，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 253010,
      "end_ms": 254110,
      "text": "水波消散越快，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 254290,
      "end_ms": 255225,
      "text": "层数越小。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 255900,
      "end_ms": 258290,
      "text": "这是一种高明的动态分析要求。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 258290,
      "end_ms": 260030,
      "text": "人既看到初始的冲击，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 260290,
      "end_ms": 261750,
      "text": "也看到后续的传导。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 261930,
      "end_ms": 263950,
      "text": "这启发我们真正理解乘数，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 264070,
      "end_ms": 265270,
      "text": "不是记住一个数字，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 265490,
      "end_ms": 268575,
      "text": "而是在消费与储蓄之间保持清醒的洞察。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 268910,
      "end_ms": 271665,
      "text": "在面对刺激还是紧缩的政策选择时，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 272010,
      "end_ms": 273935,
      "text": "不求其素而求其序。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 274340,
      "end_ms": 274925,
      "text": "主题四，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 275420,
      "end_ms": 276620,
      "text": "节俭不是美德，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 276820,
      "end_ms": 278345,
      "text": "而是合成谬误。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 278630,
      "end_ms": 281065,
      "text": "古典经济学将储蓄视为美德，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 281420,
      "end_ms": 284300,
      "text": "认为节俭积累资本、资本推动增长。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 284380,
      "end_ms": 285445,
      "text": "但凯恩斯解析，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 285810,
      "end_ms": 287550,
      "text": "在总需求不足的萧条中，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 287790,
      "end_ms": 289445,
      "text": "节俭悖论恰恰成立，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 289760,
      "end_ms": 292200,
      "text": "每个人试图多储蓄社会总收入，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 292220,
      "end_ms": 293795,
      "text": "却因消费萎缩而下降，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 294080,
      "end_ms": 296000,
      "text": "最终储蓄总量不升反降。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 296400,
      "end_ms": 299885,
      "text": "个人层面的理性汇集成集体层面的非理性。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 300290,
      "end_ms": 302135,
      "text": "凯恩斯批判的不是节俭本身，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 302480,
      "end_ms": 305640,
      "text": "而是将微观逻辑直接套用于宏观整体的谬误。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 305760,
      "end_ms": 307685,
      "text": "道家讲反者道之动。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 308150,
      "end_ms": 311290,
      "text": "凯恩斯的经济学同样揭示了一种反向的辩证。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 311770,
      "end_ms": 312790,
      "text": "你越想安全，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 312990,
      "end_ms": 313870,
      "text": "越不安全。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 314290,
      "end_ms": 315310,
      "text": "你越想储蓄，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 315550,
      "end_ms": 316490,
      "text": "越储蓄不了。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 316790,
      "end_ms": 321650,
      "text": "这在今日仍极具启示我们是否被现金为王的焦虑绑架，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 321930,
      "end_ms": 325050,
      "text": "而忘了货币只有在流通中才能创造价值。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 325290,
      "end_ms": 327030,
      "text": "真正的审慎不是囤积，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 327450,
      "end_ms": 329370,
      "text": "而是在萧条中敢于支出，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 329610,
      "end_ms": 331570,
      "text": "在恐慌中保持远见。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 331770,
      "end_ms": 332990,
      "text": "主题五名，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 333010,
      "end_ms": 336130,
      "text": "与时之辩预期无法被精确计量。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 336730,
      "end_ms": 340340,
      "text": "凯恩斯早已关注不确定性对经济行为的根本影响，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 341120,
      "end_ms": 343400,
      "text": "它区分了风险与不确定性，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 344100,
      "end_ms": 345800,
      "text": "风险可以用概率计算，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 346160,
      "end_ms": 348660,
      "text": "不确定性则连概率都无从得知。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 349660,
      "end_ms": 352560,
      "text": "投资决策所依赖的不是精确的期望值，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 352840,
      "end_ms": 354700,
      "text": "而是一种模糊的信心状态。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 354840,
      "end_ms": 356020,
      "text": "一种动物精神。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 356040,
      "end_ms": 360140,
      "text": "古典经济学假设理性经济人能对未来做出无偏估计，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 360640,
      "end_ms": 361760,
      "text": "凯恩斯则指出，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 362060,
      "end_ms": 363560,
      "text": "面对根本的不确定性，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 363820,
      "end_ms": 369055,
      "text": "人们的预期受制于情绪惯例与群体心理远非精确计算。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 369430,
      "end_ms": 370590,
      "text": "凯恩斯借此强调，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 370610,
      "end_ms": 372255,
      "text": "不可将守均衡概念，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 372580,
      "end_ms": 374720,
      "text": "而要看到预期背后的心理实相。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 374980,
      "end_ms": 376255,
      "text": "我们今天的许多争论，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 376580,
      "end_ms": 377840,
      "text": "其实是纠缠于模型，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 378020,
      "end_ms": 378985,
      "text": "却忘了现实。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 379460,
      "end_ms": 379880,
      "text": "比如，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 380020,
      "end_ms": 381525,
      "text": "争论市场是否有效，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 381860,
      "end_ms": 386155,
      "text": "却忘了追问在不确定性面前信心如何形成与崩塌。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 386580,
      "end_ms": 391405,
      "text": "这教导我们保持思维的弹性与开放性模型只是指月之指，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 391710,
      "end_ms": 393510,
      "text": "而非月亮本身主题。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 393510,
      "end_ms": 397445,
      "text": "六、经济学中的知与行理论与政策的合一，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 398180,
      "end_ms": 402335,
      "text": "凯恩斯特别梳理了知与行这一贯穿通论的核心线索。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 402670,
      "end_ms": 404405,
      "text": "他不是一个书斋里的理论家，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 404710,
      "end_ms": 407035,
      "text": "而是一个呼吁行动的政策设计者。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 407440,
      "end_ms": 407800,
      "text": "他说，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 408120,
      "end_ms": 410300,
      "text": "若经济学家只在抽象模型中打，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 410300,
      "end_ms": 413465,
      "text": "转而不将分析转化为可执行的干预方案，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 413730,
      "end_ms": 417110,
      "text": "便不算真正理解经济有效需求理论的意义，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 417250,
      "end_ms": 420305,
      "text": "最终体现在财政政策与货币政策的操作上。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 420850,
      "end_ms": 421870,
      "text": "增加公共开支，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 422090,
      "end_ms": 423235,
      "text": "实行赤字预算，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 423540,
      "end_ms": 424220,
      "text": "降低利率，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 424220,
      "end_ms": 425105,
      "text": "以刺激投资。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 425530,
      "end_ms": 427445,
      "text": "这并非简单的理论联系实际，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 427780,
      "end_ms": 430760,
      "text": "而是指出经济知识与社会行动不可分割，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 430880,
      "end_ms": 434615,
      "text": "真正的经济智慧必须在政策实践中被检验和完成。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 435020,
      "end_ms": 439025,
      "text": "这强烈批判了那种将经济学视为纯粹智力游戏的观念。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 439370,
      "end_ms": 441810,
      "text": "你若未在萧条中采取行动扩大需求，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 442070,
      "end_ms": 444005,
      "text": "便不算真知有效需求。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 444490,
      "end_ms": 446050,
      "text": "若被在危机中果断干预，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 446210,
      "end_ms": 450245,
      "text": "便不算明白凯恩斯这给予现代人一记清醒的叩问。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 450850,
      "end_ms": 452590,
      "text": "我们学习了那么多经济道理，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 452730,
      "end_ms": 454730,
      "text": "是否真的理解了行动的必要？"
    },
    {
      "segment_id": "s000182",
      "start_ms": 454990,
      "end_ms": 456750,
      "text": "知与行之间的巨大缝隙，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 457050,
      "end_ms": 460055,
      "text": "或许正是我们面对危机时无力感的根源。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 460600,
      "end_ms": 461315,
      "text": "主题七，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 461650,
      "end_ms": 464315,
      "text": "动物精神超越理性计算的维度。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 465120,
      "end_ms": 466220,
      "text": "凯恩斯特别指出，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 466300,
      "end_ms": 468995,
      "text": "动物精神对投资波动的深远影响。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 469560,
      "end_ms": 470155,
      "text": "他指出，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 470540,
      "end_ms": 473065,
      "text": "投资决策无法仅仅依赖理性计算，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 473450,
      "end_ms": 476155,
      "text": "因为关于未来的知识基础没有多大的意义，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 476380,
      "end_ms": 477365,
      "text": "甚至毫无意义。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 477870,
      "end_ms": 481005,
      "text": "真正驱动投资的是一种自发的行动冲动，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 481330,
      "end_ms": 483855,
      "text": "一种在不确定中依然前行的信心，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 484250,
      "end_ms": 485255,
      "text": "这不是反理性，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 485560,
      "end_ms": 486640,
      "text": "而是承认理性，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 486700,
      "end_ms": 488935,
      "text": "在根本不确定性面前的局限，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 489440,
      "end_ms": 491415,
      "text": "如人饮水冷暖自知，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 491960,
      "end_ms": 494675,
      "text": "再多的模型不如一次果断的投资。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 495180,
      "end_ms": 496315,
      "text": "在信息过载的今天，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 496690,
      "end_ms": 498185,
      "text": "这段话尤其珍贵。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 498810,
      "end_ms": 500170,
      "text": "我们往往计算太多，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 500470,
      "end_ms": 501735,
      "text": "却决断太少。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 502350,
      "end_ms": 504890,
      "text": "凯恩斯的智慧教我们偶尔放下精算，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 505070,
      "end_ms": 505570,
      "text": "静心，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 505570,
      "end_ms": 508435,
      "text": "感受在市场的悲观与乐观之间。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 508820,
      "end_ms": 509995,
      "text": "动物精神的掌落，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 510230,
      "end_ms": 513395,
      "text": "本身就是经济周期的一部分主题吧。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 513980,
      "end_ms": 515385,
      "text": "经济学的根本精神，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 515760,
      "end_ms": 518140,
      "text": "既解释又改变凯恩斯，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 518320,
      "end_ms": 520500,
      "text": "以既解释世界又改变世界。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 520520,
      "end_ms": 521705,
      "text": "概括通论的理想。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 522150,
      "end_ms": 524470,
      "text": "经济学家的使命不在于脱离现实，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 524550,
      "end_ms": 525495,
      "text": "构建巫婆帮，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 525900,
      "end_ms": 528545,
      "text": "而在于在承认市场失灵的前提下，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 528890,
      "end_ms": 531745,
      "text": "以政策行动填补有效需求的缺口。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 532170,
      "end_ms": 535210,
      "text": "他主张政府干预不是对市场的否定，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 535450,
      "end_ms": 537345,
      "text": "而是对市场局限的补救。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 538270,
      "end_ms": 540865,
      "text": "这或是最能呼应现代人处境的一点，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 541300,
      "end_ms": 544845,
      "text": "我们不必在市场万能与政府万能之间选边站队，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 545140,
      "end_ms": 547785,
      "text": "而是要在两者之间找到动态的平衡。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 548280,
      "end_ms": 549930,
      "text": "做事业、勇于投资，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 550090,
      "end_ms": 552425,
      "text": "却不盲目赌注处关系，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 552760,
      "end_ms": 554795,
      "text": "用心付出却不执着回报，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 555400,
      "end_ms": 556095,
      "text": "活于当下，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 556380,
      "end_ms": 557595,
      "text": "却心怀长远。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 558600,
      "end_ms": 560255,
      "text": "职场的有效性固然重要，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 560520,
      "end_ms": 563525,
      "text": "但政府的有效性同样是经济稳定的支柱。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 563940,
      "end_ms": 564340,
      "text": "最后，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 564720,
      "end_ms": 566105,
      "text": "小海龟要告诉朋友们，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 566470,
      "end_ms": 569270,
      "text": "当你不再仅用公式去算、用模型去推，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 569610,
      "end_ms": 573095,
      "text": "而是以整个时代去体察和印证这些智慧时，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 573600,
      "end_ms": 575405,
      "text": "你已理解了凯恩斯的深意。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 575930,
      "end_ms": 578255,
      "text": "经济学不是冷冰冰的数字系统，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 578620,
      "end_ms": 580385,
      "text": "而是关于人的处境之学。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 581180,
      "end_ms": 582565,
      "text": "他不提供标准答案，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 582870,
      "end_ms": 585725,
      "text": "却照亮了千百年来人类共同的困境。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 586450,
      "end_ms": 588290,
      "text": "繁荣为何中断失业？"
    },
    {
      "segment_id": "s000238",
      "start_ms": 588330,
      "end_ms": 590160,
      "text": "为何持续信心？"
    },
    {
      "segment_id": "s000239",
      "start_ms": 590260,
      "end_ms": 591105,
      "text": "为何崩塌？"
    },
    {
      "segment_id": "s000240",
      "start_ms": 591790,
      "end_ms": 594265,
      "text": "如何让一个社会重新运转起来？"
    },
    {
      "segment_id": "s000241",
      "start_ms": 595120,
      "end_ms": 596220,
      "text": "正如凯恩斯所说，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 596700,
      "end_ms": 598935,
      "text": "困难之处并不在于新思想，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 599330,
      "end_ms": 600845,
      "text": "而在于旧学说。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 601410,
      "end_ms": 602730,
      "text": "真正的经济学修行，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 603070,
      "end_ms": 603910,
      "text": "始于理论，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 604210,
      "end_ms": 604630,
      "text": "终于，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 604630,
      "end_ms": 605205,
      "text": "现实，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 605700,
      "end_ms": 606520,
      "text": "始于言传，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 606940,
      "end_ms": 607975,
      "text": "忠于行动。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 608390,
      "end_ms": 610375,
      "text": "你既能在模型中看清逻辑，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 610680,
      "end_ms": 612575,
      "text": "就能在现实中推动改变。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 612990,
      "end_ms": 614150,
      "text": "因为经济学的边界，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 614270,
      "end_ms": 615455,
      "text": "正是生活的边界，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 615830,
      "end_ms": 618715,
      "text": "也是每一个普通人可抵达的清醒之境。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 619310,
      "end_ms": 619795,
      "text": "早安，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 620120,
      "end_ms": 620605,
      "text": "请记得，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 621010,
      "end_ms": 624245,
      "text": "最高的经济智慧就在最平凡的生计之中。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 624520,
      "end_ms": 625220,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 625460,
      "end_ms": 626980,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 626980,
      "end_ms": 627565,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "308dfc50afdc84af67d5ad76a1119c5aa3d7e1efc18ec9bcab788c1c88ef7849"
}