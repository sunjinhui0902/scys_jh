{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_f47a13f215121591_u001",
  "video_id": "v_f47a13f215121591",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 529.439002,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 410,
      "end_ms": 2670,
      "text": "为什么理性在追问终极问题时，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2750,
      "end_ms": 4170,
      "text": "必然陷入自相矛盾？"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4690,
      "end_ms": 8290,
      "text": "康德在纯粹理性批判中揭示了一个令人不安的真相。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 8810,
      "end_ms": 11770,
      "text": "人类理性一旦试图超越经验的边界，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 11770,
      "end_ms": 13150,
      "text": "去把握世界的整体，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 13430,
      "end_ms": 16490,
      "text": "就会无可挽回的坠入与自身冲突的深渊。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16910,
      "end_ms": 17630,
      "text": "康德指出，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17890,
      "end_ms": 19370,
      "text": "在日常的认识活动中，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 19610,
      "end_ms": 20090,
      "text": "知性，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 20210,
      "end_ms": 21470,
      "text": "凭借先验范畴，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 21530,
      "end_ms": 24030,
      "text": "将感性材料综合为确定的知识，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 24290,
      "end_ms": 25350,
      "text": "一切井然有序。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 25690,
      "end_ms": 26130,
      "text": "然而，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 26330,
      "end_ms": 29665,
      "text": "当理性不满足于有条件的局部的知识，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 30060,
      "end_ms": 33700,
      "text": "执意去追问那无条件的绝对完整的世界整体时，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 34100,
      "end_ms": 37000,
      "text": "灾难便降临了理性所依赖的范畴。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 37260,
      "end_ms": 39500,
      "text": "原本只适用于经验之内的现象，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 39640,
      "end_ms": 43820,
      "text": "此刻却被强行用于规定那超越一切经验的宇宙理念。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 44140,
      "end_ms": 44600,
      "text": "于是，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 44880,
      "end_ms": 45900,
      "text": "同一个对象上，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 46200,
      "end_ms": 48540,
      "text": "两个各自依据、普遍承认的原则，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 48780,
      "end_ms": 51300,
      "text": "各自拥有同等有效的证明的命题，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 51660,
      "end_ms": 52840,
      "text": "竟然同时成立，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 53020,
      "end_ms": 54100,
      "text": "却又彼此否定，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 54460,
      "end_ms": 56500,
      "text": "这不是任何人故意制造的诡辩，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 56760,
      "end_ms": 57460,
      "text": "而是理性。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 57520,
      "end_ms": 64470,
      "text": "在越界使用时必然爆发的鲜艳幻想康德称之为人类理性最奇特的现象。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 64630,
      "end_ms": 66425,
      "text": "无论正题还是反题，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 66800,
      "end_ms": 70315,
      "text": "都能通过同样清楚不可抗拒的论证得到证明，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 71030,
      "end_ms": 73990,
      "text": "而让人彻底陷入这种矛盾困境的根本原因，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 74390,
      "end_ms": 77905,
      "text": "正是理性对自身界限的系统性、遗忘与僭越。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 78260,
      "end_ms": 80365,
      "text": "在康德列出的四组二绿被反中，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 80660,
      "end_ms": 84925,
      "text": "第一组便以最尖锐的方式撕裂了理性对世界的整体想象。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 85240,
      "end_ms": 85940,
      "text": "正题断言，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 86200,
      "end_ms": 88240,
      "text": "世界在时间上有一个开端，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 88500,
      "end_ms": 90195,
      "text": "在空间上也有界限，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 90670,
      "end_ms": 93890,
      "text": "反题则同样有力的宣称世界没有开端，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 94030,
      "end_ms": 96265,
      "text": "在时间和空间上都是无限的。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 96610,
      "end_ms": 97430,
      "text": "正题的证明，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 97430,
      "end_ms": 99475,
      "text": "诉诸无限回溯的不可能性。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 99900,
      "end_ms": 101120,
      "text": "如果事件没有开端，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 101440,
      "end_ms": 103600,
      "text": "那么到达任何一个给定的时间点，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 103760,
      "end_ms": 106905,
      "text": "都必须已经度过了一段无限的时间序列，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 107230,
      "end_ms": 109355,
      "text": "而无线是不可能被镀完的。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 109860,
      "end_ms": 111135,
      "text": "反题的证明则指出，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 111480,
      "end_ms": 113045,
      "text": "如果世界有一个开端，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 113350,
      "end_ms": 116505,
      "text": "那么在这个开端之前必然存在一段空的时间，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 116910,
      "end_ms": 119865,
      "text": "但空的时间中不可能有任何事物开始存在，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 120270,
      "end_ms": 122925,
      "text": "因为每一时刻与其他时刻并无差别，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 123320,
      "end_ms": 126805,
      "text": "没有任何理由让存在在某一刻而非另一刻涌现。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 127350,
      "end_ms": 128875,
      "text": "两个论证都无懈可击，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 129250,
      "end_ms": 132495,
      "text": "理性被迫同时接受两个互相否定的结论。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 132950,
      "end_ms": 136625,
      "text": "第二组二氯被反将矛头指向了物质世界的构成结构。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 137230,
      "end_ms": 137970,
      "text": "正题声称，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 138290,
      "end_ms": 141770,
      "text": "世界上的每一个复合实体都由单纯的部分构成，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 142010,
      "end_ms": 145255,
      "text": "因此归根结底存在着不可再分的单元。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 145630,
      "end_ms": 146605,
      "text": "反提则反驳，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 146950,
      "end_ms": 148845,
      "text": "世界上没有任何单纯的东西，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 149160,
      "end_ms": 150720,
      "text": "一切事物都是复合的，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 150740,
      "end_ms": 151715,
      "text": "无限可分的。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 152330,
      "end_ms": 155985,
      "text": "正题的论证依赖于复合这一概念本身的逻辑预设。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 156360,
      "end_ms": 157520,
      "text": "如果复合物存在，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 157700,
      "end_ms": 160785,
      "text": "那么构成它的部分便不可能仍然是复合的，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 161190,
      "end_ms": 163185,
      "text": "否则复合将永远无法完成。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 163600,
      "end_ms": 164985,
      "text": "反题的论证则指出，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 165260,
      "end_ms": 167800,
      "text": "如果一切复合物都由单纯部分构成，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 168060,
      "end_ms": 171715,
      "text": "那么每一个单纯部分必然占据空间中的某个位置。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 172040,
      "end_ms": 173540,
      "text": "而任何占据空间的东西，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 173540,
      "end_ms": 175015,
      "text": "都必然是可分的，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 175380,
      "end_ms": 179300,
      "text": "于是单纯与空间性之间产生了不可调和的矛盾，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 179320,
      "end_ms": 183120,
      "text": "理性再次被钉在了一根永远无法拔出的双头钉上。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 183400,
      "end_ms": 183840,
      "text": "然而，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 184140,
      "end_ms": 188280,
      "text": "真正将二律被反从宇宙论的思辨领域拉入人的存在，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 188280,
      "end_ms": 190445,
      "text": "本身的是第三组冲突。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 190980,
      "end_ms": 191420,
      "text": "正题，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 191500,
      "end_ms": 192320,
      "text": "庄严宣告，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 192540,
      "end_ms": 196020,
      "text": "世界上存在一种出于自由的因果性世界，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 196020,
      "end_ms": 198315,
      "text": "并非完全被自然法则所决定，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 198720,
      "end_ms": 200355,
      "text": "反题则冷酷的坚持，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 200760,
      "end_ms": 201720,
      "text": "不存在自由。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 201940,
      "end_ms": 204415,
      "text": "世界上的一切都按照自然法则发生，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 204680,
      "end_ms": 207660,
      "text": "每一个事件都被先前的原因所必然的规定。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 207860,
      "end_ms": 208920,
      "text": "正题的理由在于，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 209180,
      "end_ms": 210605,
      "text": "如果一切皆必然，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 210850,
      "end_ms": 212990,
      "text": "那么因果序列将永远无法完成。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 213150,
      "end_ms": 215950,
      "text": "因为每一次回溯都要求一个更早的原因，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 216270,
      "end_ms": 220575,
      "text": "而一个无穷的因果链条本身仍然是一个未被解释的序列，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 220980,
      "end_ms": 222645,
      "text": "反提的理由则更为强硬。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 222980,
      "end_ms": 226375,
      "text": "如果引入一种不受任何先前原因决定的自由音，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 226690,
      "end_ms": 228345,
      "text": "那么它就是一个绝对的开端。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 228670,
      "end_ms": 229890,
      "text": "而一个绝对的开端，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 229910,
      "end_ms": 231590,
      "text": "意味着从无中产生，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 231590,
      "end_ms": 234395,
      "text": "有这违背了因果律的普遍有效性。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 234880,
      "end_ms": 237000,
      "text": "这一组二律被反之所以至关重要，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 237140,
      "end_ms": 241845,
      "text": "是因为他直接关涉人是否能够为自己的行为承担道德责任。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 242480,
      "end_ms": 244680,
      "text": "如果一切都被自然因果所决定，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 244860,
      "end_ms": 248745,
      "text": "那么善恶功过便只是因果链条上的一个必然环节。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 249080,
      "end_ms": 251200,
      "text": "道德judgment失去了最终的根基。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 251400,
      "end_ms": 254695,
      "text": "第四组二律被反将追问推向了最终极的层面。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 255140,
      "end_ms": 255900,
      "text": "正题断言，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 256100,
      "end_ms": 260120,
      "text": "在世界的原因系列中存在着一个绝对必然的存在者，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 260180,
      "end_ms": 262495,
      "text": "他作为世界的最高原因而存在。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 262960,
      "end_ms": 263905,
      "text": "反提则否认，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 264190,
      "end_ms": 266550,
      "text": "在这个系列中没有任何必然的东西，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 266690,
      "end_ms": 268030,
      "text": "一切都是偶然的，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 268030,
      "end_ms": 269295,
      "text": "有条件的存在，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 269700,
      "end_ms": 270560,
      "text": "正题的论证，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 270580,
      "end_ms": 272685,
      "text": "诉诸充足理由率的彻底贯彻。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 273000,
      "end_ms": 274800,
      "text": "如果一切都是有条件的，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 274880,
      "end_ms": 277725,
      "text": "那么整个系列就缺乏一个无条件的根基。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 278160,
      "end_ms": 282895,
      "text": "而理性的本性不允许他停留在一个永远无法封闭的序列之中。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 283300,
      "end_ms": 284440,
      "text": "反题的论证则指出，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 284440,
      "end_ms": 288040,
      "text": "如如果将某种绝对必然的东西置于世界之内，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 288200,
      "end_ms": 290115,
      "text": "他就必须服从自然因果律，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 290350,
      "end_ms": 292425,
      "text": "从而成为有条件序列中的一员。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 292740,
      "end_ms": 295055,
      "text": "这与其绝对必然的规定相矛盾。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 295500,
      "end_ms": 296915,
      "text": "如果将他置于世界之外。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 297210,
      "end_ms": 297450,
      "text": "那么，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 297450,
      "end_ms": 301690,
      "text": "他便不再是世界原因系列的一部分正题所要求的，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 301690,
      "end_ms": 304750,
      "text": "在世界之中的必然存在者便无从成立。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 305209,
      "end_ms": 306910,
      "text": "这四组二律被反的破坏力，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 306910,
      "end_ms": 308870,
      "text": "不在于他们各自论证的精巧。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 309290,
      "end_ms": 312270,
      "text": "而在于他们共同揭示了一个令人不安的事实，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 312630,
      "end_ms": 314670,
      "text": "理性在追问终极问题时，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 315090,
      "end_ms": 319510,
      "text": "其最严肃、最严格的运用竟然会导向自身内部的分裂。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 320110,
      "end_ms": 321550,
      "text": "康德对此的诊断是，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 321810,
      "end_ms": 323950,
      "text": "前两组二律被反之所以产生，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 324190,
      "end_ms": 327520,
      "text": "是因为理性混淆了现象与自在之之物，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 327740,
      "end_ms": 330740,
      "text": "将只适用于经验现象的量与质范畴。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 331020,
      "end_ms": 332240,
      "text": "非法的应用于，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 332240,
      "end_ms": 334940,
      "text": "那并非经验对象的世界整体。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 335120,
      "end_ms": 335880,
      "text": "对于这两组，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 336080,
      "end_ms": 339420,
      "text": "康德的解决方式是宣布正题与反题同时为假，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 340020,
      "end_ms": 343600,
      "text": "因为世界整体本身并非一个可以给定的经验对象。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 344060,
      "end_ms": 346240,
      "text": "追问它是有限还是无限？"
    },
    {
      "segment_id": "s000136",
      "start_ms": 346520,
      "end_ms": 348220,
      "text": "就如同追问一个圆的方，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 348340,
      "end_ms": 350060,
      "text": "是红色还是蓝色一样，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 350100,
      "end_ms": 353000,
      "text": "问题本身便建立在概念的误用之上，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 353660,
      "end_ms": 356260,
      "text": "后两组二律被反则呈现出不同的性质。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 356260,
      "end_ms": 357690,
      "text": "在第三组中，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 357970,
      "end_ms": 361915,
      "text": "自然因果性与自由因果性并非在同一层面上对立。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 362330,
      "end_ms": 364325,
      "text": "自然因果性支配着现象界，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 364750,
      "end_ms": 367550,
      "text": "而自由因果性则属于本体界人。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 367670,
      "end_ms": 369010,
      "text": "作为现象界的一员，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 369270,
      "end_ms": 371810,
      "text": "其一切行为都被自然法则所规定。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 372010,
      "end_ms": 374305,
      "text": "但人同时作为本体界的存在者，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 374560,
      "end_ms": 377495,
      "text": "拥有一种独立于自然因果的鲜艳自由，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 377830,
      "end_ms": 380925,
      "text": "这种自由正是道德法则得以可能的根据。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 381240,
      "end_ms": 382060,
      "text": "在第四组中，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 382380,
      "end_ms": 387860,
      "text": "绝对必然的存在者同样可以被理解为不属于现象序列的本体性根据，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 387940,
      "end_ms": 391540,
      "text": "从而与反题所坚持的现象序列的偶然性并行不悖。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 391680,
      "end_ms": 397015,
      "text": "康德由此将二律被反从一场理性的溃败转化为一场理性的自我认识。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 397540,
      "end_ms": 398800,
      "text": "李信终于认识到，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 398820,
      "end_ms": 400675,
      "text": "他的范畴只能用于经验。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 400970,
      "end_ms": 404550,
      "text": "而他所追问的那些终极理念与实践理性的领域，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 404750,
      "end_ms": 408640,
      "text": "只能通过道德法则来接近二律被反的哲学意义，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 408640,
      "end_ms": 410620,
      "text": "远超一次纯粹的逻辑诊断。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 410820,
      "end_ms": 413715,
      "text": "他宣告了传统形而上学独断论的破产。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 414100,
      "end_ms": 420725,
      "text": "那些自以为能够通过纯粹概念来证明世界有限或无限灵魂不朽或上帝存在的论证，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 421100,
      "end_ms": 423595,
      "text": "在二绿被反面前暴露了自身的虚望。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 424390,
      "end_ms": 425190,
      "text": "但与此同时，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 425470,
      "end_ms": 428610,
      "text": "二律被反也为理性的另一种运用开辟了道路。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 428810,
      "end_ms": 431410,
      "text": "当思辨、理性在终极问题上陷入僵局，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 431750,
      "end_ms": 432550,
      "text": "实践理性，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 432610,
      "end_ms": 439130,
      "text": "却能够在道德法则中为自由灵魂和上帝重新赢得一种实践的实在性。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 439310,
      "end_ms": 441590,
      "text": "理性之所以在追问中陷入矛盾，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 441850,
      "end_ms": 444510,
      "text": "恰恰因为它不满足于有条件的知识，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 444530,
      "end_ms": 446995,
      "text": "非要触及那无条件的绝对的东西。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 447300,
      "end_ms": 451440,
      "text": "这种冲动本身便是人作为一种既属于现象界，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 451520,
      "end_ms": 453795,
      "text": "又属于本体界的存在者的命运。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 454160,
      "end_ms": 455980,
      "text": "二律被反不是理性的耻辱，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 456180,
      "end_ms": 457545,
      "text": "而是理性的成熟。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 457960,
      "end_ms": 460060,
      "text": "他迫使理性承认自己的界限，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 460320,
      "end_ms": 461480,
      "text": "并在这界限之外，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 461680,
      "end_ms": 465460,
      "text": "为信仰、道德和自由留下了不可侵犯的位置。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 465540,
      "end_ms": 468500,
      "text": "不要以为这些冲突只是哲学史上的抽象争论，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 468680,
      "end_ms": 473820,
      "text": "每一个人在追问我是否有真正的自由、我的存在是否有终极的意义时，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 474040,
      "end_ms": 477880,
      "text": "都在以自己的方式重演着理性最深处的二律倍伐。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 477960,
      "end_ms": 480545,
      "text": "当你感受到自己被因果链条牢牢捆绑，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 480970,
      "end_ms": 485195,
      "text": "却又在内心深处确信自己能够做出真正属于自己的选择时，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 485720,
      "end_ms": 488885,
      "text": "你所体验的这是第三组二氯倍反的灼热。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 489150,
      "end_ms": 492005,
      "text": "当你渴望为生命找到一个不可动摇的根基，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 492360,
      "end_ms": 494800,
      "text": "却发现一切似乎都只是偶然。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 494840,
      "end_ms": 496395,
      "text": "与有条件的存在时，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 496870,
      "end_ms": 498490,
      "text": "你便已经站在了第四组。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 498490,
      "end_ms": 499695,
      "text": "二律被反的门槛上，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 499990,
      "end_ms": 502425,
      "text": "康德的洞见不在于消除这些冲突，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 502710,
      "end_ms": 506315,
      "text": "而在于告诉你理性在这些冲突中的自我撕裂，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 506720,
      "end_ms": 510260,
      "text": "恰恰是他超越自身通向更高秩序的起点，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 510360,
      "end_ms": 512880,
      "text": "从此刻起承认理性的界限。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 513020,
      "end_ms": 513880,
      "text": "但不要畏惧，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 513880,
      "end_ms": 515925,
      "text": "在界限之处依然去追问。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 516370,
      "end_ms": 518110,
      "text": "因为正是这种追问，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 518190,
      "end_ms": 520165,
      "text": "将你从独断的沉睡中唤醒，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 520510,
      "end_ms": 523350,
      "text": "让你在有限的认识与无限的向往之间，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 523550,
      "end_ms": 526070,
      "text": "活出属于你自己的清醒与自由。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 526230,
      "end_ms": 527115,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 527380,
      "end_ms": 528640,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 528640,
      "end_ms": 529305,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "8b10db0106e9783ef58af9a6217f7180be504a828db3821dc48e1374fb6c6a3e"
}