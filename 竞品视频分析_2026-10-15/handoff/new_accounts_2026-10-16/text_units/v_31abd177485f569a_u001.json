{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_31abd177485f569a_u001",
  "video_id": "v_31abd177485f569a",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 953.992993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 340,
      "end_ms": 2620,
      "text": "十五分钟讲解奥古斯丁上帝之城。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2940,
      "end_ms": 4120,
      "text": "如果一定要说一本，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4140,
      "end_ms": 8100,
      "text": "大多数人在追问社会为何如此之前都该读一读的书。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 8420,
      "end_ms": 11380,
      "text": "可以说就是奥古斯丁写的上帝之城名字，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 11380,
      "end_ms": 14000,
      "text": "听起来像一份关于遥远天国的蓝图。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 14640,
      "end_ms": 15600,
      "text": "翻开才发现，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 15680,
      "end_ms": 19980,
      "text": "它其实是在把人类群体生活的底层逻辑彻底剖开给人看。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 20300,
      "end_ms": 22780,
      "text": "为什么一个文明会兴盛又衰亡？"
    },
    {
      "segment_id": "s000009",
      "start_ms": 23200,
      "end_ms": 25720,
      "text": "为什么人们聚在一起却彼此撕裂？"
    },
    {
      "segment_id": "s000010",
      "start_ms": 25860,
      "end_ms": 28000,
      "text": "为什么对和平的渴望如此真切，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 28240,
      "end_ms": 31970,
      "text": "而通往和平的道路却总是被暴力与傲慢截断，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 32250,
      "end_ms": 35990,
      "text": "以及一个人究竟要穿越多少关于进步和秩序的幻觉，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 36350,
      "end_ms": 37910,
      "text": "才能触碰到一点真实。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 38049,
      "end_ms": 39450,
      "text": "很多人都有过这样的瞬间，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 39810,
      "end_ms": 43350,
      "text": "看着新闻里远方的战火感到一种荒诞的无力感。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 43730,
      "end_ms": 45310,
      "text": "在拥挤的人群中行走，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 45690,
      "end_ms": 47470,
      "text": "却觉得每个人都像一座孤岛，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 47590,
      "end_ms": 48730,
      "text": "参与某个集体行动，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 48730,
      "end_ms": 49690,
      "text": "是热血沸腾，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 50030,
      "end_ms": 53390,
      "text": "散场后却隐约怀疑自己到底在为什么而激动。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 53970,
      "end_ms": 54890,
      "text": "我们告诉自己，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 55070,
      "end_ms": 56450,
      "text": "这是因为制度不完善，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 56710,
      "end_ms": 57650,
      "text": "因为资源有限，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 57910,
      "end_ms": 59090,
      "text": "因为人性本恶，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 59530,
      "end_ms": 62155,
      "text": "表面看看起来像是政治问题或经济问题，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 62490,
      "end_ms": 63890,
      "text": "好像只要换一套规则，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 63910,
      "end_ms": 64590,
      "text": "换一批人，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 64690,
      "end_ms": 66095,
      "text": "换一种资源分配方式，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 66410,
      "end_ms": 68185,
      "text": "人类就能迎来持久的安宁。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 68970,
      "end_ms": 74010,
      "text": "但上帝之城做的事情是把这些以为只是时代或体质的病症。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 74230,
      "end_ms": 76235,
      "text": "一层一层剥开给人看，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 76670,
      "end_ms": 79355,
      "text": "让人知道这并不是某一个时代的失败，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 79690,
      "end_ms": 84855,
      "text": "而是作为人这种存在聚集在一起时与生俱来的精神地形。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 85540,
      "end_ms": 86920,
      "text": "在正式进入这本书之前，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 87220,
      "end_ms": 89995,
      "text": "可以先抛出一个其中极具颠覆性的观点。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 90280,
      "end_ms": 93195,
      "text": "用自己的话转述出来大概是这样一句意思。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 93640,
      "end_ms": 96655,
      "text": "人的真正困境往往不在于缺乏秩序，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 97050,
      "end_ms": 102105,
      "text": "而在于用错误的东西去填补那个本应属于更高秩序的位置。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 102550,
      "end_ms": 104470,
      "text": "我们花了半生去追逐权力，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 104730,
      "end_ms": 107725,
      "text": "财富荣耀会被历史记住的感觉，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 108430,
      "end_ms": 109915,
      "text": "却几乎不曾安静下来。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 110180,
      "end_ms": 110780,
      "text": "问问内心，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 110780,
      "end_ms": 111720,
      "text": "那个一直不满，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 111840,
      "end_ms": 116385,
      "text": "一直催促我们去占有更多的欲望本身到底在渴求什么？"
    },
    {
      "segment_id": "s000045",
      "start_ms": 116920,
      "end_ms": 120365,
      "text": "结果就是很多人一边在外部世界构建帝国，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 120660,
      "end_ms": 126280,
      "text": "一边在内心世界里流离失所、靠征服、靠积累、靠一个接一个的新目标，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 126500,
      "end_ms": 128875,
      "text": "跌跌撞撞的逃避与自己的对话。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 129190,
      "end_ms": 130190,
      "text": "这一点一旦想通，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 130470,
      "end_ms": 131910,
      "text": "许多关于文明的焦虑，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 131990,
      "end_ms": 133450,
      "text": "其实会稍微清晰一点。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 133530,
      "end_ms": 136185,
      "text": "活的混乱不等于人类整体毫无希望，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 136600,
      "end_ms": 141985,
      "text": "只能说明大多数人在最核心的自我认识这门功课上几乎完全是文盲。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 142430,
      "end_ms": 147650,
      "text": "那这本书想做的就是把人类群体的命运当成一条蜿蜒曲折的河流。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 147770,
      "end_ms": 149430,
      "text": "从最早的亲密社群之泉，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 149810,
      "end_ms": 151775,
      "text": "到帝国扩张的汹涌波涛，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 152140,
      "end_ms": 154305,
      "text": "再到思想追寻中的重重迷雾，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 155010,
      "end_ms": 158875,
      "text": "最后抵达某种超越尘市得失的宁静与成名。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 159370,
      "end_ms": 161335,
      "text": "一段一段溯源给人看，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 161820,
      "end_ms": 166020,
      "text": "先来说说人为什么需要这样赤裸的审视自己所处的城。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 166280,
      "end_ms": 166940,
      "text": "很多人以为，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 166940,
      "end_ms": 169040,
      "text": "思考社会问题是为了找到解决方案，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 169300,
      "end_ms": 170805,
      "text": "是为了让世界变得更好。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 171450,
      "end_ms": 173500,
      "text": "奥古斯丁提醒的是人，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 173500,
      "end_ms": 178335,
      "text": "需要靠理解自己在何种爱中来获得对自身处境的清醒。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 178570,
      "end_ms": 181335,
      "text": "这是一种写在群体生活结构里的需要。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 181770,
      "end_ms": 183715,
      "text": "当一个人在历史的深渊中打捞，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 184000,
      "end_ms": 187740,
      "text": "将那些散落的、矛盾的、甚至不堪的集体记忆，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 187940,
      "end_ms": 190180,
      "text": "用语言连贯的呈现出来时，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 190320,
      "end_ms": 193335,
      "text": "他就不再是被时代情绪被动驱动的奴隶，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 193600,
      "end_ms": 196620,
      "text": "而成了自己所处历史的叙述者与理解者，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 196660,
      "end_ms": 197620,
      "text": "不是自我否定，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 198000,
      "end_ms": 199040,
      "text": "而是人的意识，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 199080,
      "end_ms": 200235,
      "text": "就是这么设计的。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 200660,
      "end_ms": 203360,
      "text": "未被言说的永远在黑暗中控制，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 203360,
      "end_ms": 206580,
      "text": "你被清晰照见的才能被安置，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 206860,
      "end_ms": 208305,
      "text": "时代也发生了变化。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 208700,
      "end_ms": 210785,
      "text": "奥古斯丁所处的罗马帝国晚期，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 211200,
      "end_ms": 213125,
      "text": "旧有的共和理想已然坍塌，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 213520,
      "end_ms": 215415,
      "text": "新的秩序尚未深入人心。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 215870,
      "end_ms": 219680,
      "text": "精神世界一片喧嚣与虚空那种感觉很像。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 219680,
      "end_ms": 220165,
      "text": "今天，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 220540,
      "end_ms": 224610,
      "text": "传统的价值框架松动、层出不穷的新思潮、新活法，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 224690,
      "end_ms": 225755,
      "text": "让人眼花缭乱。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 226680,
      "end_ms": 228985,
      "text": "个人被抛入一种前所未有的自由，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 229310,
      "end_ms": 231310,
      "text": "却也陷入更深的再线。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 231310,
      "end_ms": 233235,
      "text": "孤独选择越多，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 233610,
      "end_ms": 234515,
      "text": "方向越模糊，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 234960,
      "end_ms": 236585,
      "text": "漂泊感也就越强烈。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 237000,
      "end_ms": 237885,
      "text": "正因为如此，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 238270,
      "end_ms": 241790,
      "text": "向内探寻的勇气才比任何时候都更为迫切，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 242050,
      "end_ms": 244730,
      "text": "而不是完全交给外部的潮流与定义。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 244890,
      "end_ms": 245210,
      "text": "说完，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 245210,
      "end_ms": 246290,
      "text": "为什么需要审视？"
    },
    {
      "segment_id": "s000094",
      "start_ms": 246530,
      "end_ms": 246850,
      "text": "再说，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 246850,
      "end_ms": 248250,
      "text": "迷失是怎么开始的。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 248270,
      "end_ms": 248990,
      "text": "很多人都以为，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 248990,
      "end_ms": 251010,
      "text": "社会进步是一个不断积累的过程，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 251050,
      "end_ms": 253470,
      "text": "积累财富、积累知识、积累制度。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 253610,
      "end_ms": 255969,
      "text": "但上帝之城在层层剖析里发现，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 256250,
      "end_ms": 256990,
      "text": "人的迷失，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 257310,
      "end_ms": 260050,
      "text": "恰恰始于一次次的获得却不满。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 260490,
      "end_ms": 263270,
      "text": "罗马的扩张是那个时代最宏大的叙事，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 263470,
      "end_ms": 268070,
      "text": "但奥古斯丁反复追问一个以征服和荣耀为最高目标的社会，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 268270,
      "end_ms": 270320,
      "text": "他内部真正在享受什么？"
    },
    {
      "segment_id": "s000105",
      "start_ms": 270680,
      "end_ms": 271560,
      "text": "他的结论是，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 272020,
      "end_ms": 274680,
      "text": "享受的是支配本身的快感，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 275120,
      "end_ms": 277380,
      "text": "是凌驾于他人之上的优越感，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 277760,
      "end_ms": 279940,
      "text": "是证明自己拥有力量的幻觉。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 280680,
      "end_ms": 286760,
      "text": "一个人如果从未深入审视过自己行为背后那种晦暗非理性的驱动力，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 287040,
      "end_ms": 291560,
      "text": "那么所有的自由选择都可能只是另一种更隐蔽的奴役。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 291920,
      "end_ms": 293220,
      "text": "在迷失的最初阶段，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 293460,
      "end_ms": 295800,
      "text": "权利和荣耀确实占不小比重。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 296460,
      "end_ms": 298440,
      "text": "这一点奥古斯丁讲的非常诚实，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 298680,
      "end_ms": 299605,
      "text": "帝国的威移，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 299990,
      "end_ms": 300850,
      "text": "凯旋的游行，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 301130,
      "end_ms": 303630,
      "text": "史书的记载像一股强大的洪流，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 303870,
      "end_ms": 305135,
      "text": "卷着人顺流而下。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 306060,
      "end_ms": 310500,
      "text": "这也是为什么那么多人会对自己的权利欲有强烈的羞耻或恐惧，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 310940,
      "end_ms": 313480,
      "text": "觉得沉迷于某种低级的支配快感，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 313620,
      "end_ms": 315280,
      "text": "就标志着灵魂的堕落。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 315940,
      "end_ms": 316240,
      "text": "可是，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 316240,
      "end_ms": 317260,
      "text": "如果继续往下看，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 317500,
      "end_ms": 321380,
      "text": "会发现权力的满足多半只提供短暂的眩晕，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 321820,
      "end_ms": 324080,
      "text": "而真正让人陷入持久空洞的，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 324220,
      "end_ms": 326240,
      "text": "是与更高秩序的分离感。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 326660,
      "end_ms": 328920,
      "text": "那种与生命本源断裂的漂泊，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 329240,
      "end_ms": 330900,
      "text": "是再强烈的征服快感，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 330900,
      "end_ms": 331980,
      "text": "也填补不了的。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 332720,
      "end_ms": 334680,
      "text": "就像他用尽比喻所描述的，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 335040,
      "end_ms": 337630,
      "text": "我们的心是为某种安宁而造，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 338170,
      "end_ms": 338830,
      "text": "除非安息，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 338830,
      "end_ms": 340030,
      "text": "在正确的秩序中，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 340510,
      "end_ms": 342070,
      "text": "否则永远躁动不安。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 342550,
      "end_ms": 343330,
      "text": "除了权利，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 343550,
      "end_ms": 345050,
      "text": "还有一个常被误会的点，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 345210,
      "end_ms": 347150,
      "text": "就是所谓制度与理性。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 347290,
      "end_ms": 348330,
      "text": "很多人特别相信，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 348330,
      "end_ms": 351290,
      "text": "理性设计与制度安排能带来持久的和平，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 351630,
      "end_ms": 354510,
      "text": "认为只要构建出足够精密的规则体系，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 354590,
      "end_ms": 355530,
      "text": "就能获得安宁。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 355630,
      "end_ms": 356550,
      "text": "听起来很合理，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 357050,
      "end_ms": 361570,
      "text": "但奥古斯丁用自己皈依前近十年沉迷于各种哲学体系的经历，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 361570,
      "end_ms": 363790,
      "text": "一再提醒纯粹。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 363810,
      "end_ms": 364630,
      "text": "理性的设计，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 364810,
      "end_ms": 366780,
      "text": "若没有对人敬幽暗的谦卑，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 366800,
      "end_ms": 369195,
      "text": "承认与对更高秩序的敬畏，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 369570,
      "end_ms": 371955,
      "text": "很容易变成另一种骄傲的堡垒。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 372620,
      "end_ms": 373820,
      "text": "他让你精于计算，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 373980,
      "end_ms": 375005,
      "text": "让你逻辑自洽，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 375340,
      "end_ms": 379760,
      "text": "却可能让你离那个需要跃入而非推论的安宁越来越远。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 379860,
      "end_ms": 381860,
      "text": "智力上的探索可以点亮道路，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 382000,
      "end_ms": 384960,
      "text": "但心灵的正位才决定能否真正回家。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 385140,
      "end_ms": 387640,
      "text": "等一个人开始真正向内看故事，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 387740,
      "end_ms": 389645,
      "text": "往往才进入最艰难的篇章。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 390070,
      "end_ms": 391065,
      "text": "在追寻的初期，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 391360,
      "end_ms": 393400,
      "text": "很多人都有一种理性自负期。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 393580,
      "end_ms": 394335,
      "text": "在这个阶段，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 394580,
      "end_ms": 395640,
      "text": "人们倾向于相信，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 395700,
      "end_ms": 398605,
      "text": "靠自己的思想力量就能攀上真理的高峰，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 399020,
      "end_ms": 401505,
      "text": "把内心的不安紧紧归为修行不够，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 401800,
      "end_ms": 405085,
      "text": "把那些需要交付的软弱视为有待克服的缺陷。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 405650,
      "end_ms": 406705,
      "text": "这不能说是假，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 407220,
      "end_ms": 408620,
      "text": "而是觉醒的冲动，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 408680,
      "end_ms": 411000,
      "text": "天然自带的一层英雄主义滤镜。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 411180,
      "end_ms": 411900,
      "text": "问题在于，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 412180,
      "end_ms": 413320,
      "text": "如果在这段时间里，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 413500,
      "end_ms": 416655,
      "text": "脑子里同时装了很多关于自我救赎的神话，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 417030,
      "end_ms": 420095,
      "text": "但这层滤镜很容易变成后面绝望的诱因。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 420510,
      "end_ms": 420925,
      "text": "比如，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 421180,
      "end_ms": 422900,
      "text": "有的人坚信意志是绝对的，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 422900,
      "end_ms": 425060,
      "text": "王觉得我想要变好的念头，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 425060,
      "end_ms": 425700,
      "text": "一旦产生，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 425900,
      "end_ms": 428380,
      "text": "就理应能克服一切惰性与惯性。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 428580,
      "end_ms": 429740,
      "text": "那些反复的失败，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 430060,
      "end_ms": 431025,
      "text": "软弱的回溯，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 431320,
      "end_ms": 433765,
      "text": "慢慢就会在心里酿成对自己的憎恶。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 434230,
      "end_ms": 435150,
      "text": "还有的人觉得，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 435190,
      "end_ms": 436550,
      "text": "只要逻辑足够清晰，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 436730,
      "end_ms": 438295,
      "text": "就能看破一切迷雾。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 438690,
      "end_ms": 438910,
      "text": "于是，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 438910,
      "end_ms": 443985,
      "text": "对非理性的情感、记忆的创伤、身体的惯性都刻意视而不见，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 444430,
      "end_ms": 446085,
      "text": "等内心冲突总爆发时，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 446440,
      "end_ms": 448105,
      "text": "往往已经自我撕裂太久。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 448610,
      "end_ms": 449145,
      "text": "再比如，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 449480,
      "end_ms": 451675,
      "text": "有的人坚信过去应该被彻底割断，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 452070,
      "end_ms": 453710,
      "text": "所以一旦想起不堪的往事，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 453830,
      "end_ms": 455490,
      "text": "就开始否定现在的自己，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 455550,
      "end_ms": 459105,
      "text": "反而失去了通过理解过去来整合当下的机会。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 459670,
      "end_ms": 463485,
      "text": "上帝之城花了极大篇幅在讲一个看似很简单的道理，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 464020,
      "end_ms": 464995,
      "text": "灵魂的治愈，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 465280,
      "end_ms": 466975,
      "text": "关键不在于否定救我，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 467330,
      "end_ms": 468530,
      "text": "而在于重塑。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 468610,
      "end_ms": 470255,
      "text": "故事觉悟是起点，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 470560,
      "end_ms": 473715,
      "text": "但接纳与重构才是那条回家的路。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 474170,
      "end_ms": 475765,
      "text": "很多人以为自己在反省，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 476120,
      "end_ms": 479265,
      "text": "其实只是在轮流进行自我控诉与自我开脱。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 479730,
      "end_ms": 482030,
      "text": "有的人一内省就是定罪式的开场，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 482350,
      "end_ms": 483750,
      "text": "我怎么会如此邪恶？"
    },
    {
      "segment_id": "s000199",
      "start_ms": 483950,
      "end_ms": 487545,
      "text": "我真是个无可救药的人听得自己自然开始防御，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 487800,
      "end_ms": 488560,
      "text": "没那么严重，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 488660,
      "end_ms": 490880,
      "text": "别人也这样反思的内容还没展开，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 491160,
      "end_ms": 494315,
      "text": "内心就已经陷入一种内耗与压抑的僵局。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 494970,
      "end_ms": 497835,
      "text": "书里反复展现的是一种截然不同的路径，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 498350,
      "end_ms": 503425,
      "text": "把目光从我是什么的审判转向我经历了什么的探查，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 503860,
      "end_ms": 505460,
      "text": "听上去只是焦点的转换，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 505700,
      "end_ms": 507780,
      "text": "却会让灵魂的防御大大降低，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 507940,
      "end_ms": 509345,
      "text": "让理解得以可能。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 510410,
      "end_ms": 511930,
      "text": "还有一个极其重要的维度，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 511990,
      "end_ms": 513705,
      "text": "是关于时间与历史的。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 514150,
      "end_ms": 516710,
      "text": "我们总以为过去已是未来未至，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 516910,
      "end_ms": 518155,
      "text": "只有现在真实。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 518560,
      "end_ms": 521445,
      "text": "但奥古斯丁以惊人的哲学洞察揭示，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 521990,
      "end_ms": 524830,
      "text": "过去并非不存在它存在于记忆。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 524850,
      "end_ms": 526345,
      "text": "这个当下的影像中，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 526810,
      "end_ms": 528565,
      "text": "未来也并非不存在，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 528930,
      "end_ms": 530110,
      "text": "它存在于期待。"
    },
    {
      "segment_id": "s000217",
      "start_ms": 530110,
      "end_ms": 534230,
      "text": "这个当下的指向中人之所以被过去折磨，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 534450,
      "end_ms": 535465,
      "text": "被未来焦虑，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 535840,
      "end_ms": 540815,
      "text": "正是因为我们的现在永远背负着记忆的重担与期盼的引力。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 541700,
      "end_ms": 542680,
      "text": "与其简单的命令，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 542680,
      "end_ms": 543715,
      "text": "自己活在当下，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 544050,
      "end_ms": 547690,
      "text": "不如看清自己意识的结构与时间达成和解。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 547850,
      "end_ms": 548295,
      "text": "同样，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 548580,
      "end_ms": 552065,
      "text": "一个文明之所以被历史的重负与未来的恐惧所困，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 552330,
      "end_ms": 557350,
      "text": "也正是因为他的现在从未真正面对过自己的记忆与期待。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 557350,
      "end_ms": 558935,
      "text": "无论个人的历史是哪一种，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 559340,
      "end_ms": 562305,
      "text": "一段心灵之旅里总会有激烈的内在冲突。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 562530,
      "end_ms": 563750,
      "text": "冲突本身不是问题，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 563970,
      "end_ms": 566945,
      "text": "甚至有时候是灵魂开始认真对话的契机，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 567490,
      "end_ms": 571800,
      "text": "真正会把一个人慢慢耗尽的是一些看起来不那么爆裂，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 571960,
      "end_ms": 574275,
      "text": "但侵视力极强的思维习惯。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 574850,
      "end_ms": 575290,
      "text": "比如，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 575510,
      "end_ms": 578285,
      "text": "用理性的思辨来逃避情感的痛楚，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 578740,
      "end_ms": 581335,
      "text": "把一切感受都化为可以讨论的议题。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 582000,
      "end_ms": 582515,
      "text": "比如，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 582650,
      "end_ms": 584330,
      "text": "永远站在理想的制高点上，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 584370,
      "end_ms": 585685,
      "text": "鄙视现实的自己，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 586200,
      "end_ms": 587800,
      "text": "把自己放在应然的位置，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 587860,
      "end_ms": 589305,
      "text": "审判实然的存在。"
    },
    {
      "segment_id": "s000240",
      "start_ms": 589890,
      "end_ms": 590370,
      "text": "再比如，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 590370,
      "end_ms": 591350,
      "text": "遇到内心的黑暗，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 591350,
      "end_ms": 592885,
      "text": "就选择麻木或转移，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 593240,
      "end_ms": 596065,
      "text": "用忙碌、娱乐或新的求知欲来覆盖，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 596440,
      "end_ms": 599205,
      "text": "让真正的伤口在无尽的忽略中溃烂。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 599700,
      "end_ms": 600900,
      "text": "一次放纵的悔恨，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 601020,
      "end_ms": 602355,
      "text": "可以随时间淡去，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 602770,
      "end_ms": 605055,
      "text": "但长期的自我梳离与不诚实，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 605350,
      "end_ms": 607435,
      "text": "会让灵魂慢慢失去生机。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 607990,
      "end_ms": 609330,
      "text": "在这样的内在消耗下，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 609610,
      "end_ms": 613050,
      "text": "许多对意义的追寻就开始慢慢朝虚无划去。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 613590,
      "end_ms": 616690,
      "text": "一开始追寻对灵魂来说是太美了，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 616870,
      "end_ms": 617650,
      "text": "真理之光，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 618250,
      "end_ms": 620950,
      "text": "慢慢变成为什么我始终触碰不到。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 621550,
      "end_ms": 622210,
      "text": "再后来，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 622390,
      "end_ms": 625070,
      "text": "很多人心里冒出来的是那句特别绝望的话，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 625430,
      "end_ms": 626930,
      "text": "或许根本没有意义。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 627290,
      "end_ms": 628190,
      "text": "追求智慧，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 628310,
      "end_ms": 629250,
      "text": "却更觉无知，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 629830,
      "end_ms": 630750,
      "text": "渴望纯洁，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 630990,
      "end_ms": 632310,
      "text": "却更深陷欲望，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 632750,
      "end_ms": 633570,
      "text": "寻求安宁，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 633810,
      "end_ms": 634950,
      "text": "却更感动荡。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 635610,
      "end_ms": 638580,
      "text": "这些困境如果长期得不到照料和疏导，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 638840,
      "end_ms": 640540,
      "text": "无力感就会越积越厚。"
    },
    {
      "segment_id": "s000265",
      "start_ms": 640800,
      "end_ms": 643060,
      "text": "上帝之城在谈到转向的时刻，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 643200,
      "end_ms": 645220,
      "text": "也给了一个不那么戏剧化的视角。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 645560,
      "end_ms": 648980,
      "text": "很多人想象根本性的转变是天上突然降下霹雳，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 649160,
      "end_ms": 650360,
      "text": "瞬间焕然一新。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 651060,
      "end_ms": 652340,
      "text": "二、古斯丁的叙述里，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 652340,
      "end_ms": 653340,
      "text": "并没有这种神话，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 653860,
      "end_ms": 656700,
      "text": "他描绘的是一次精疲力竭后的崩溃，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 657060,
      "end_ms": 659740,
      "text": "是在被此刻的无力感彻底击垮后，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 660000,
      "end_ms": 662020,
      "text": "偶然遇到一个外界契机，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 662280,
      "end_ms": 664360,
      "text": "于是目光落在一段文字上，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 665080,
      "end_ms": 666700,
      "text": "那一刻的平静与确信，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 666980,
      "end_ms": 668895,
      "text": "于不是凭空而来的神迹，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 669360,
      "end_ms": 671740,
      "text": "而是长期挣扎、长期思考，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 671920,
      "end_ms": 673245,
      "text": "长期渴望之后，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 673610,
      "end_ms": 675575,
      "text": "加上一个偶然的外界契机，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 675920,
      "end_ms": 677720,
      "text": "最后瓜熟蒂落的结果。"
    },
    {
      "segment_id": "s000281",
      "start_ms": 677860,
      "end_ms": 678740,
      "text": "从这个角度看，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 679020,
      "end_ms": 682055,
      "text": "转向并不只是某一个瞬间的玄妙体验，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 682500,
      "end_ms": 684360,
      "text": "而是灵魂在很长一段时间里，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 684360,
      "end_ms": 685820,
      "text": "经历了所有歧路，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 685960,
      "end_ms": 690400,
      "text": "耗尽了所有自欺之后终于准备就绪的一个自然表现。"
    },
    {
      "segment_id": "s000286",
      "start_ms": 690480,
      "end_ms": 690905,
      "text": "当然，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 691170,
      "end_ms": 693365,
      "text": "这并不意味着之前的痛苦没有价值，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 693700,
      "end_ms": 696595,
      "text": "而是提醒人们在抵达这个顿悟之前，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 697010,
      "end_ms": 699365,
      "text": "所有的建物都是必要的铺垫。"
    },
    {
      "segment_id": "s000290",
      "start_ms": 699820,
      "end_ms": 700220,
      "text": "那么，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 700720,
      "end_ms": 701940,
      "text": "灵魂走到绝境，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 702280,
      "end_ms": 703755,
      "text": "到底该如何转向？"
    },
    {
      "segment_id": "s000293",
      "start_ms": 704260,
      "end_ms": 706725,
      "text": "书中并没有提供一套标准的修行手册，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 707030,
      "end_ms": 709395,
      "text": "而是展现了几条可以窥见的路径。"
    },
    {
      "segment_id": "s000295",
      "start_ms": 709770,
      "end_ms": 711670,
      "text": "首先是诚实的绝对性。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 712010,
      "end_ms": 713990,
      "text": "有些灵魂之所以能走向光明，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 714230,
      "end_ms": 717725,
      "text": "是因为当事人终于放弃了最后一点美化与辩捷。"
    },
    {
      "segment_id": "s000298",
      "start_ms": 718570,
      "end_ms": 724055,
      "text": "愿意承认我就是那个贪慕虚荣的人我就是那个将支配置于爱之上的人。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 724760,
      "end_ms": 727125,
      "text": "正是这种对真相不折不扣的直面，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 727460,
      "end_ms": 729200,
      "text": "让他在面对至高存在时，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 729420,
      "end_ms": 730585,
      "text": "不再试图遮掩，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 730920,
      "end_ms": 732075,
      "text": "而是愿意跪下，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 732550,
      "end_ms": 733950,
      "text": "哪怕内心千疮百孔，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 734150,
      "end_ms": 735765,
      "text": "仍然愿意开口诉说。"
    },
    {
      "segment_id": "s000305",
      "start_ms": 736360,
      "end_ms": 737845,
      "text": "其次是秩序的视角，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 738830,
      "end_ms": 739910,
      "text": "有的人努力改变，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 739990,
      "end_ms": 742745,
      "text": "是出于我要成为更好的人的骄傲。"
    },
    {
      "segment_id": "s000308",
      "start_ms": 743290,
      "end_ms": 745555,
      "text": "结果在更好的标杆前跌的更惨。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 746410,
      "end_ms": 750995,
      "text": "奥古斯丁最终领悟的世人无法凭一己之力将自己拉出泥潭，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 751440,
      "end_ms": 753640,
      "text": "但可以向秩序敞开接受。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 753640,
      "end_ms": 755165,
      "text": "那自上而下的牵引，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 756160,
      "end_ms": 757095,
      "text": "这不是被动，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 757400,
      "end_ms": 761705,
      "text": "而是主动的选择选择停止靠自我意志的蛮力挣扎。"
    },
    {
      "segment_id": "s000314",
      "start_ms": 762120,
      "end_ms": 764460,
      "text": "选择相信有一种大于自己的力量，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 764460,
      "end_ms": 767040,
      "text": "可以依靠真正的转变，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 767280,
      "end_ms": 768160,
      "text": "始于承认，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 768240,
      "end_ms": 769095,
      "text": "我做不到，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 769420,
      "end_ms": 771300,
      "text": "然后说请你来做。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 771480,
      "end_ms": 774345,
      "text": "很多人以为灵性成长靠的是宏大的神迹，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 774740,
      "end_ms": 775700,
      "text": "彻夜的祷告，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 775800,
      "end_ms": 777035,
      "text": "严苛的苦修。"
    },
    {
      "segment_id": "s000322",
      "start_ms": 777920,
      "end_ms": 779520,
      "text": "奥古斯丁却一再暗示，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 779780,
      "end_ms": 783285,
      "text": "是那些日常中记忆的梳理、时间的沉思，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 783660,
      "end_ms": 785285,
      "text": "日常事物之美的惊叹，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 785630,
      "end_ms": 787765,
      "text": "在慢慢重塑灵魂的质地，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 788800,
      "end_ms": 790645,
      "text": "一次对童年哭泣的追忆，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 791000,
      "end_ms": 792685,
      "text": "一段对友谊逝去的哀悼，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 793020,
      "end_ms": 795345,
      "text": "一场对时间本质的惊奇探索。"
    },
    {
      "segment_id": "s000329",
      "start_ms": 795950,
      "end_ms": 797535,
      "text": "这些看似抽象的瞬间，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 797820,
      "end_ms": 801185,
      "text": "都是在给灵魂一点一点灌注理解的侵权。"
    },
    {
      "segment_id": "s000331",
      "start_ms": 801700,
      "end_ms": 802240,
      "text": "一个生命。"
    },
    {
      "segment_id": "s000332",
      "start_ms": 802240,
      "end_ms": 805695,
      "text": "如果在日常里完全没有这些静观于反思的片刻，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 806000,
      "end_ms": 808405,
      "text": "只剩下功力的计算与感官的应对。"
    },
    {
      "segment_id": "s000334",
      "start_ms": 808760,
      "end_ms": 810320,
      "text": "即使外表看上去成功，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 810560,
      "end_ms": 812105,
      "text": "内在多半也是荒芜的。"
    },
    {
      "segment_id": "s000336",
      "start_ms": 812540,
      "end_ms": 812920,
      "text": "当然，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 813160,
      "end_ms": 815795,
      "text": "也有一些旧的自我是不适合再修补的。"
    },
    {
      "segment_id": "s000338",
      "start_ms": 816050,
      "end_ms": 817970,
      "text": "上帝之城并不浪漫的鼓励人，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 817970,
      "end_ms": 819155,
      "text": "坚守所有过去，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 819460,
      "end_ms": 820255,
      "text": "而是提醒，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 820640,
      "end_ms": 822970,
      "text": "有时告别一种旧的活法。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 823210,
      "end_ms": 826110,
      "text": "旧的身份认同本身就是一种新生，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 826290,
      "end_ms": 828575,
      "text": "当自我欺骗已经远远超过真诚，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 828860,
      "end_ms": 831295,
      "text": "当内心的对话只剩下互相指控，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 831770,
      "end_ms": 832830,
      "text": "但无论怎么努力，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 832830,
      "end_ms": 834855,
      "text": "都找不到与真实连接的感觉。"
    },
    {
      "segment_id": "s000347",
      "start_ms": 835210,
      "end_ms": 837645,
      "text": "彻底的放手与转向不是失败，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 837970,
      "end_ms": 840315,
      "text": "而是一种对灵魂本身的忠诚。"
    },
    {
      "segment_id": "s000349",
      "start_ms": 841540,
      "end_ms": 846285,
      "text": "这本书最后想传递的其实不是一套教人如何构建理想国的政治方案，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 846670,
      "end_ms": 848430,
      "text": "而是几句穿越千年，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 848530,
      "end_ms": 850005,
      "text": "依然灼烫的提醒。"
    },
    {
      "segment_id": "s000352",
      "start_ms": 851330,
      "end_ms": 852585,
      "text": "认识你所处的城，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 852990,
      "end_ms": 854615,
      "text": "是一场最勇敢的探险，"
    },
    {
      "segment_id": "s000354",
      "start_ms": 855080,
      "end_ms": 857035,
      "text": "不是你足够坏才需要审事，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 857280,
      "end_ms": 859000,
      "text": "也不是你足够好才配备。"
    },
    {
      "segment_id": "s000356",
      "start_ms": 859000,
      "end_ms": 861965,
      "text": "爱迷茫与挣扎是本能，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 862470,
      "end_ms": 864315,
      "text": "如何在迷茫中不失去方向，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 864610,
      "end_ms": 866010,
      "text": "在挣扎中不放弃。"
    },
    {
      "segment_id": "s000359",
      "start_ms": 866010,
      "end_ms": 866505,
      "text": "追问，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 866800,
      "end_ms": 868900,
      "text": "是需要一点一点修炼的智慧。"
    },
    {
      "segment_id": "s000361",
      "start_ms": 869040,
      "end_ms": 871585,
      "text": "每个人都有自己与生俱来的脆弱与倾向，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 872170,
      "end_ms": 873225,
      "text": "有人甘于支配，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 873590,
      "end_ms": 874585,
      "text": "有人困于骄傲，"
    }
  ],
  "source_transcript_sha256": "0474aa0d2e897c31a4705f92d9ffb1252d3392dde998d50a6ce4ffbdecd1a626"
}