{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_ff3ea70e28828a27_u001",
  "video_id": "v_ff3ea70e28828a27",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 852.568005,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 360,
      "end_ms": 2660,
      "text": "十四分钟讲解正同相术有一本书，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2720,
      "end_ms": 6140,
      "text": "在一千三百卷的古代百科全书里被完整保存，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6400,
      "end_ms": 9660,
      "text": "被清代最庞大的知识工程收录为独立门类，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9920,
      "end_ms": 13020,
      "text": "却在当代中文世界的公共讨论里几乎隐形。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 13300,
      "end_ms": 14500,
      "text": "不是因为它不存在，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 14860,
      "end_ms": 16240,
      "text": "而是因为它太刺眼。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16800,
      "end_ms": 17560,
      "text": "刺眼到会，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17560,
      "end_ms": 20680,
      "text": "让几代中国知识分子信奉的那套相术，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 20760,
      "end_ms": 26000,
      "text": "等于迷信看相等于江湖骗术的认知框架发生七级地震，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 26220,
      "end_ms": 28520,
      "text": "这本书叫相术点。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 28520,
      "end_ms": 29140,
      "text": "教者正同，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 29140,
      "end_ms": 33630,
      "text": "是中央民民族大学哲学与宗教学学院的客座教授研究员。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 34530,
      "end_ms": 36810,
      "text": "但比这个头衔更值得注意的是，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 36810,
      "end_ms": 38290,
      "text": "他过去二十年做的事，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 38950,
      "end_ms": 44950,
      "text": "一个人一间工作室把古今图书集成里被遗忘的术数文献一卷，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 44970,
      "end_ms": 45370,
      "text": "一卷，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 45410,
      "end_ms": 46790,
      "text": "从古籍堆里捞出来，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 47270,
      "end_ms": 49310,
      "text": "简体横排教刊注释，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 49750,
      "end_ms": 53130,
      "text": "让他们第一次以现代书籍的形态进入公共视野。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 53970,
      "end_ms": 57210,
      "text": "邻居们或许觉得他疯了离谱的是，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 57530,
      "end_ms": 60640,
      "text": "正统把这种学术抢救的工作做成出之后，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 60880,
      "end_ms": 62165,
      "text": "遭遇的不是追捧，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 62780,
      "end_ms": 64020,
      "text": "是来自两个阵营的。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 64020,
      "end_ms": 64460,
      "text": "同时，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 64480,
      "end_ms": 68055,
      "text": "武士科学主义者嫌他给迷信续命，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 68530,
      "end_ms": 72455,
      "text": "传统文化爱好者嫌他把秘传变成了公开的学术文本。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 72850,
      "end_ms": 76545,
      "text": "人们宁可相信相术研究是某种学术上的不务正业，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 76790,
      "end_ms": 76955,
      "text": "嗯，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 77140,
      "end_ms": 78905,
      "text": "也不愿面对一个可怕的真相。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 79410,
      "end_ms": 83065,
      "text": "你对相数和认知的认知从根儿上就错了。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 83250,
      "end_ms": 87065,
      "text": "今天这条文字我会拆出这本书里最颠覆的五个底层认知。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 87660,
      "end_ms": 88540,
      "text": "但我要提前警告，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 88540,
      "end_ms": 89800,
      "text": "你看完后，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 89980,
      "end_ms": 95640,
      "text": "你可能会推翻过去二十年、三十年奉为归孽的科学VS迷信二元论。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 95720,
      "end_ms": 97060,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 97240,
      "end_ms": 98615,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000037",
      "start_ms": 98960,
      "end_ms": 99985,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 100160,
      "end_ms": 101320,
      "text": "那我们开始进入正题。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 101460,
      "end_ms": 104220,
      "text": "第一层颠覆相术不是算命，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 104460,
      "end_ms": 106300,
      "text": "是一种身体认知系统。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 106300,
      "end_ms": 107360,
      "text": "你有没有听过这句话？"
    },
    {
      "segment_id": "s000042",
      "start_ms": 107540,
      "end_ms": 108940,
      "text": "相术就是看脸猜，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 108940,
      "end_ms": 110905,
      "text": "命运和科学没半点关系。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 111450,
      "end_ms": 114555,
      "text": "上述整本书第一个动作就把这套认知判了死刑。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 115140,
      "end_ms": 121245,
      "text": "重同点相的这本橡术以清代古今图书集成艺术点所收橡术文献为底本，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 121520,
      "end_ms": 128045,
      "text": "收录相而经神像全边等经典涵盖面相、骨相体相等理论体系。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 128340,
      "end_ms": 129785,
      "text": "他不是一本算命指南，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 130170,
      "end_ms": 134445,
      "text": "是一套关于人如何通过身体读取信息的认知系统。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 134850,
      "end_ms": 136335,
      "text": "注意不是跳大神，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 136640,
      "end_ms": 137500,
      "text": "不是故弄玄虚，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 137640,
      "end_ms": 141250,
      "text": "是把人体的五官、骨骼、气色当做一套，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 141270,
      "end_ms": 144335,
      "text": "可谓观察分类解释的符号体系。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 145330,
      "end_ms": 149130,
      "text": "这和现代人看体检报告、读面部表情分析、体态语言，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 149330,
      "end_ms": 152135,
      "text": "在认知结构上共享同一个底层逻辑，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 152620,
      "end_ms": 154555,
      "text": "身体是信息的载体。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 155380,
      "end_ms": 156825,
      "text": "这听上去像是常识。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 157430,
      "end_ms": 158465,
      "text": "那你仔细想想，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 158940,
      "end_ms": 161440,
      "text": "我们这代人从小被灌输的是橡树，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 161440,
      "end_ms": 162380,
      "text": "是封建糟粕，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 162540,
      "end_ms": 163625,
      "text": "科学才是真理。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 164150,
      "end_ms": 164810,
      "text": "言下之意，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 164950,
      "end_ms": 166055,
      "text": "前者是骗人的，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 166300,
      "end_ms": 167305,
      "text": "后者才是真的。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 167530,
      "end_ms": 169170,
      "text": "这套话语的隐蔽暴力在于，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 169450,
      "end_ms": 172725,
      "text": "他先把橡树从认知讨论的房间里赶出去，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 173020,
      "end_ms": 177230,
      "text": "然后嘲笑房间里没有认知正统做的第一件事，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 177290,
      "end_ms": 178955,
      "text": "不是你应该信相术，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 179290,
      "end_ms": 180255,
      "text": "而是让你看见。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 180560,
      "end_ms": 190955,
      "text": "这套系统曾经被帝国最高级别的知识工程郑重收录被二十四卷的篇幅系统梳理被两千年的实践者反复检验和修正。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 191680,
      "end_ms": 193430,
      "text": "他不要求你先信他，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 193430,
      "end_ms": 195780,
      "text": "要求你先看看它的结构，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 196020,
      "end_ms": 196965,
      "text": "看它的逻辑，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 197280,
      "end_ms": 199100,
      "text": "看他如何从观察出发，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 199300,
      "end_ms": 202835,
      "text": "建立起一套关于身体与命运的关联推理。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 203150,
      "end_ms": 204470,
      "text": "你可以理解一套系统，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 204650,
      "end_ms": 205645,
      "text": "同时拒绝他。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 205910,
      "end_ms": 208315,
      "text": "就像你可以理解占星术的符号逻辑，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 208590,
      "end_ms": 210305,
      "text": "同时不成为占星师。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 210920,
      "end_ms": 213540,
      "text": "第二层颠覆像素的认知方式，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 213680,
      "end_ms": 214780,
      "text": "不是反理性，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 215080,
      "end_ms": 216285,
      "text": "是另一种理性。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 216530,
      "end_ms": 220475,
      "text": "我们这代人从小被灌输理性和迷信是对立的。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 220880,
      "end_ms": 221915,
      "text": "理性讲证据，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 222260,
      "end_ms": 223385,
      "text": "迷信讲玄学。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 223640,
      "end_ms": 223800,
      "text": "所以，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 223800,
      "end_ms": 226135,
      "text": "当一个人对着镜子端详自己的五官时，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 226460,
      "end_ms": 228655,
      "text": "大家会下意识觉得他在自我催眠。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 229020,
      "end_ms": 233040,
      "text": "橡树用一整卷橡树会考砸碎了这套二元论。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 233200,
      "end_ms": 244220,
      "text": "这本书的内容涉及橡树会考、象树、名流、列传、橡树译文、橡树记事、象树杂录等是一套完整的知识编纂体例正同在。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 244220,
      "end_ms": 246055,
      "text": "点教时呈现的核心逻辑是，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 246470,
      "end_ms": 248330,
      "text": "所谓相术与理性对立，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 248530,
      "end_ms": 251135,
      "text": "本身就是一个需要被审视的哲学立场，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 251370,
      "end_ms": 252945,
      "text": "而不是一个自明的真理。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 253540,
      "end_ms": 255980,
      "text": "你把相术和理性放在天平两端，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 256200,
      "end_ms": 265435,
      "text": "但你从来没有问过像述所使用的观察、分类推理模式和医学诊断所使用的模式真的在同一个层面上对立吗？"
    },
    {
      "segment_id": "s000096",
      "start_ms": 265940,
      "end_ms": 268560,
      "text": "医者看气色判断健康相者，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 268560,
      "end_ms": 270125,
      "text": "看气色判断命运，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 270640,
      "end_ms": 272140,
      "text": "前者被尊为科学，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 272480,
      "end_ms": 274080,
      "text": "后者被视为迷信，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 274140,
      "end_ms": 275795,
      "text": "但两者的起点是一样的。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 276140,
      "end_ms": 277885,
      "text": "从可见推断不可见，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 278250,
      "end_ms": 283150,
      "text": "区别只在于医学把推断链条收束在生理层面相术，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 283250,
      "end_ms": 285615,
      "text": "把推断链条延伸到了人生层面。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 286050,
      "end_ms": 287435,
      "text": "这句话可能会刺痛你，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 287730,
      "end_ms": 289475,
      "text": "你总说我只相信科学，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 289850,
      "end_ms": 294330,
      "text": "可你有没有想过科学诊断也建立在一套身体符号学之上，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 294710,
      "end_ms": 296345,
      "text": "你相信化验单上的数字。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 296590,
      "end_ms": 297590,
      "text": "因为有人告诉你，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 297590,
      "end_ms": 299595,
      "text": "这些数字对应身体的真实状态，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 300020,
      "end_ms": 302140,
      "text": "橡树使用者相信面部的纹路，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 302420,
      "end_ms": 303800,
      "text": "因为有一整套传统，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 303840,
      "end_ms": 306120,
      "text": "告诉他这些纹路对应命运的走向，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 306780,
      "end_ms": 308140,
      "text": "这不是替橡树辩护。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 308420,
      "end_ms": 309185,
      "text": "这是告诉你。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 309530,
      "end_ms": 313830,
      "text": "认知的起点从来不是证明是信任某种符号系统。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 314250,
      "end_ms": 317890,
      "text": "而像数要做的是把这套符号系统拿到桌面上。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 318150,
      "end_ms": 318730,
      "text": "问一句，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 318990,
      "end_ms": 320530,
      "text": "它的分类逻辑是什么？"
    },
    {
      "segment_id": "s000119",
      "start_ms": 320750,
      "end_ms": 322270,
      "text": "它的推演规则是什么？"
    },
    {
      "segment_id": "s000120",
      "start_ms": 322330,
      "end_ms": 323650,
      "text": "它的边界在哪里？"
    },
    {
      "segment_id": "s000121",
      "start_ms": 323870,
      "end_ms": 326810,
      "text": "第三层颠覆项数的工具不是预测，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 326990,
      "end_ms": 328250,
      "text": "是关联思维。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 328810,
      "end_ms": 329930,
      "text": "主流认知告诉你，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 329950,
      "end_ms": 330970,
      "text": "像数就是预测，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 330970,
      "end_ms": 333450,
      "text": "命运准就是灵不准就是骗。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 334010,
      "end_ms": 335430,
      "text": "这套模式的潜台词是，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 335730,
      "end_ms": 338210,
      "text": "项数只在灵验的前提下才有讨论，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 338210,
      "end_ms": 341320,
      "text": "价值不灵的东西根本不值得了解。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 341660,
      "end_ms": 344680,
      "text": "但像数呈现的是一个更复杂的途径。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 345340,
      "end_ms": 349460,
      "text": "术数认知的基本特征包括认知与评价相融合，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 349860,
      "end_ms": 351680,
      "text": "认知与行动相统一，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 352020,
      "end_ms": 353120,
      "text": "思维的关联性。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 353240,
      "end_ms": 356580,
      "text": "相应的功能上表现为实用而非求真。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 356900,
      "end_ms": 357600,
      "text": "什么意思啊？"
    },
    {
      "segment_id": "s000135",
      "start_ms": 357960,
      "end_ms": 360460,
      "text": "像数不是在做科学意义上的预测，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 360940,
      "end_ms": 363160,
      "text": "它是在做一套关联推理，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 363760,
      "end_ms": 366720,
      "text": "把身体特征和人生境遇建立对应关系。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 366720,
      "end_ms": 370125,
      "text": "目的不是为了求真什为了决嫌疑，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 370800,
      "end_ms": 372240,
      "text": "古人面对不确定的人生，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 372520,
      "end_ms": 376035,
      "text": "需要一套语言来描述一套框架来安放、焦虑。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 376680,
      "end_ms": 380360,
      "text": "书中收录的十二宫十三部位五官论流年，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 380360,
      "end_ms": 380860,
      "text": "运气图，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 381180,
      "end_ms": 383925,
      "text": "构成了一张人体与时间的对应网格。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 384590,
      "end_ms": 388475,
      "text": "额头对应少年眼对应中年下巴对应晚年，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 388960,
      "end_ms": 390915,
      "text": "这不是在做精确的时间预测，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 391270,
      "end_ms": 394465,
      "text": "是在用空间化的方式呈现生命的阶段性。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 394970,
      "end_ms": 395545,
      "text": "你仔细想，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 395880,
      "end_ms": 399300,
      "text": "这其实和现代心理学用人格发展阶段来描述人生，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 399540,
      "end_ms": 401525,
      "text": "在认知功能上有相似之处，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 402230,
      "end_ms": 403255,
      "text": "像素的不准，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 403700,
      "end_ms": 405635,
      "text": "恰恰是他的认知诚实。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 406200,
      "end_ms": 406720,
      "text": "他承认，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 406720,
      "end_ms": 407855,
      "text": "人生有不确定性，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 408180,
      "end_ms": 411420,
      "text": "然后用一套符号系统来管理这种不确定性。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 411620,
      "end_ms": 413340,
      "text": "第四层颠覆橡树，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 413360,
      "end_ms": 414360,
      "text": "不是私人迷信，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 414520,
      "end_ms": 415900,
      "text": "是公共知识遗产。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 416020,
      "end_ms": 417520,
      "text": "市面上关于相数的讨论，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 417540,
      "end_ms": 420045,
      "text": "百分之九十九都集中在零不灵层面。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 420450,
      "end_ms": 421030,
      "text": "你信不信？"
    },
    {
      "segment_id": "s000161",
      "start_ms": 421130,
      "end_ms": 422125,
      "text": "那是你自己的事儿，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 422310,
      "end_ms": 423875,
      "text": "别人信不信和你没关系。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 424190,
      "end_ms": 425610,
      "text": "这套模式的潜台词是，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 425930,
      "end_ms": 427295,
      "text": "橡术是主观的，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 427500,
      "end_ms": 429655,
      "text": "不需要也不应该被严肃对待。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 430030,
      "end_ms": 430570,
      "text": "橡树说，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 430750,
      "end_ms": 431395,
      "text": "你错了。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 431700,
      "end_ms": 432920,
      "text": "这本书收录的文献，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 432920,
      "end_ms": 437085,
      "text": "绝大部分是四库全书子部数数类所未曾收录的，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 437480,
      "end_ms": 439885,
      "text": "现在看来更具特殊的研究价值。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 440340,
      "end_ms": 444465,
      "text": "郑彤做的事是把橡树从民间秘传的抽屉里拿出来，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 444770,
      "end_ms": 446470,
      "text": "放在公共知识的长桌上。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 446590,
      "end_ms": 449455,
      "text": "它涉及的是一系列可以被公开讨论的问题。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 449810,
      "end_ms": 452265,
      "text": "古人如何理解身体与命运的关系？"
    },
    {
      "segment_id": "s000175",
      "start_ms": 452670,
      "end_ms": 454650,
      "text": "这种理解如何随时代变化？"
    },
    {
      "segment_id": "s000176",
      "start_ms": 454650,
      "end_ms": 456275,
      "text": "它在什么条件下被建构？"
    },
    {
      "segment_id": "s000177",
      "start_ms": 456460,
      "end_ms": 457985,
      "text": "又在什么条件下被批判？"
    },
    {
      "segment_id": "s000178",
      "start_ms": 458440,
      "end_ms": 460800,
      "text": "荀子在非相片中专门批判，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 460800,
      "end_ms": 461255,
      "text": "相术，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 461540,
      "end_ms": 463620,
      "text": "提出象形不如论心，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 464000,
      "end_ms": 465755,
      "text": "论心不如择数。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 466240,
      "end_ms": 470165,
      "text": "这个批判本身就是橡树作为公共知识存在的证据，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 470670,
      "end_ms": 472605,
      "text": "如果橡树只是私人迷信，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 472940,
      "end_ms": 475400,
      "text": "荀子何必写一整篇文章来反驳？"
    },
    {
      "segment_id": "s000185",
      "start_ms": 475400,
      "end_ms": 477595,
      "text": "他能被反驳的思想，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 477830,
      "end_ms": 479385,
      "text": "就是值得被讨论的思想。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 480030,
      "end_ms": 482370,
      "text": "正同的相术不是让你接受什么，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 482490,
      "end_ms": 483850,
      "text": "是让你理解什么，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 483890,
      "end_ms": 488210,
      "text": "理解一套认知系统如何在两千年的争论中形成演变，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 488410,
      "end_ms": 489890,
      "text": "被质疑、被修正，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 490090,
      "end_ms": 492655,
      "text": "他不能躲在这是传统后面拒绝提问，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 492980,
      "end_ms": 495365,
      "text": "也不能因为被提问就觉得自己被冒犯。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 495820,
      "end_ms": 496895,
      "text": "第五层颠覆，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 497300,
      "end_ms": 498140,
      "text": "学会像树，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 498180,
      "end_ms": 500200,
      "text": "唯一的终点是让你离开，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 500300,
      "end_ms": 502125,
      "text": "信不信这个伪命题。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 502580,
      "end_ms": 503160,
      "text": "读到这里，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 503160,
      "end_ms": 503860,
      "text": "你可能想问，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 504000,
      "end_ms": 507445,
      "text": "说了这么多最终目标不还是让人相信相树吗？"
    },
    {
      "segment_id": "s000200",
      "start_ms": 507960,
      "end_ms": 509675,
      "text": "正同自己是术数研究者，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 510010,
      "end_ms": 512370,
      "text": "他点笑这些书不就是在推广书书。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 512570,
      "end_ms": 513130,
      "text": "如果你这样，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 513130,
      "end_ms": 514690,
      "text": "想你就掉进了这本书，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 514690,
      "end_ms": 515955,
      "text": "埋了二十年的陷阱。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 516400,
      "end_ms": 521515,
      "text": "郑彤用二十年证明的不是相术和科学可以共存这个廉价的和解口号，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 521990,
      "end_ms": 523730,
      "text": "而是科学与迷信的冲突，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 523730,
      "end_ms": 526725,
      "text": "本身就是一个被制造出来的叙事。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 527060,
      "end_ms": 528520,
      "text": "他最大的贡献不是立场，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 528720,
      "end_ms": 529485,
      "text": "是方法。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 529950,
      "end_ms": 533005,
      "text": "他主持点教出版术数类古籍三十余种，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 533380,
      "end_ms": 535220,
      "text": "从古今图书集成数数，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 535220,
      "end_ms": 537220,
      "text": "从刊到四库全书数数，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 537220,
      "end_ms": 538600,
      "text": "从刊再到故宫，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 538600,
      "end_ms": 539905,
      "text": "真本数数从刊。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 540210,
      "end_ms": 545570,
      "text": "他的任务不是让你相信相树是让你有能力评估所有关于橡树的论断。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 545750,
      "end_ms": 548610,
      "text": "他把两千年橡树文献的骨骼拆开来给你看，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 548690,
      "end_ms": 551285,
      "text": "谁在什么处境下提出了什么分类框架，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 551650,
      "end_ms": 553190,
      "text": "这个框架的弱点在哪里？"
    },
    {
      "segment_id": "s000219",
      "start_ms": 553190,
      "end_ms": 554845,
      "text": "他的对手又是怎么回应的？"
    },
    {
      "segment_id": "s000220",
      "start_ms": 555260,
      "end_ms": 559225,
      "text": "然后他退后一步说你自己判断为什么？"
    },
    {
      "segment_id": "s000221",
      "start_ms": 559660,
      "end_ms": 560775,
      "text": "因为他太清楚。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 561160,
      "end_ms": 562820,
      "text": "在迷信与科学的辩论中，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 563040,
      "end_ms": 564625,
      "text": "最稀缺的不是答案，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 564990,
      "end_ms": 566615,
      "text": "是问出好问题的能力。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 567490,
      "end_ms": 570115,
      "text": "你不需要在信和不信之间做选择，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 570570,
      "end_ms": 573645,
      "text": "你需要先搞清楚你选择的是什么？"
    },
    {
      "segment_id": "s000227",
      "start_ms": 574000,
      "end_ms": 576180,
      "text": "是那个被科学主义者批判的稻草人。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 576480,
      "end_ms": 578840,
      "text": "是那个被江湖术士滥用的简化版本，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 578900,
      "end_ms": 583465,
      "text": "还是一个有两千年文献传统支撑的复杂认知体系。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 583700,
      "end_ms": 586885,
      "text": "所以你看这本书最惊世骇俗的答案藏在这里。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 587250,
      "end_ms": 590805,
      "text": "学习像素最大的收获不是获得了某种预测能力，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 591130,
      "end_ms": 595130,
      "text": "而是获得了一种在复杂符号系统面前不慌张的能力。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 595250,
      "end_ms": 596310,
      "text": "你不必急于表态，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 596510,
      "end_ms": 599225,
      "text": "你有能力理解一套关联推理的质地。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 599480,
      "end_ms": 601645,
      "text": "你有耐心等待思考的成熟。"
    },
    {
      "segment_id": "s000236",
      "start_ms": 602060,
      "end_ms": 602700,
      "text": "读完橡树，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 602820,
      "end_ms": 604520,
      "text": "你可能发现书名起错了，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 604600,
      "end_ms": 606385,
      "text": "这不是一本橡树入门书，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 606790,
      "end_ms": 610065,
      "text": "是一本关于人如何用身体理解命运，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 610350,
      "end_ms": 614145,
      "text": "又如何用理性审视这种理解的认知文献集。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 614660,
      "end_ms": 616360,
      "text": "正同的教授身份不是重点，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 616460,
      "end_ms": 618040,
      "text": "点校的规模不是重点，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 618220,
      "end_ms": 620620,
      "text": "十二宫十三部位也不是重点，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 621040,
      "end_ms": 622000,
      "text": "重点是那个人。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 622380,
      "end_ms": 625580,
      "text": "面对一个被主流话语判了认知死刑的领域，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 625840,
      "end_ms": 627680,
      "text": "说我不服从偏见，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 627960,
      "end_ms": 629820,
      "text": "我只服从我看见的文献。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 630320,
      "end_ms": 631420,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000249",
      "start_ms": 631920,
      "end_ms": 634140,
      "text": "他看见橡树不是科学的敌人，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 634420,
      "end_ms": 636880,
      "text": "不是需要被拯救或抛弃的遗产。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 637300,
      "end_ms": 638440,
      "text": "它是一面镜子，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 638700,
      "end_ms": 641800,
      "text": "映照出人类在不确定中寻找确定的本能。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 642380,
      "end_ms": 643600,
      "text": "我们知道一些东西，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 643860,
      "end_ms": 645490,
      "text": "我们不知道更多东西，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 645890,
      "end_ms": 649010,
      "text": "而我们必须在不知道中安放自己的焦虑。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 649490,
      "end_ms": 652070,
      "text": "最后我想认真推荐一次这本书。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 652710,
      "end_ms": 654270,
      "text": "如果你看到这里还没有划走，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 654510,
      "end_ms": 656970,
      "text": "说明你心里有一个问题一直没有被回答。"
    },
    {
      "segment_id": "s000259",
      "start_ms": 657490,
      "end_ms": 658890,
      "text": "我们到底该怎么面对？"
    },
    {
      "segment_id": "s000260",
      "start_ms": 658890,
      "end_ms": 663430,
      "text": "那些科学无法完全证实却又无法被简单否定的人类经验？"
    },
    {
      "segment_id": "s000261",
      "start_ms": 664010,
      "end_ms": 666070,
      "text": "像术就是被这个问题写的，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 666310,
      "end_ms": 669830,
      "text": "你们看的这个版本文案优化了不下五次第一版，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 670010,
      "end_ms": 671930,
      "text": "我试图把每一卷目录都摊开，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 672070,
      "end_ms": 674115,
      "text": "结果像论文没人看得下去。"
    },
    {
      "segment_id": "s000265",
      "start_ms": 674660,
      "end_ms": 675240,
      "text": "第二版，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 675380,
      "end_ms": 677120,
      "text": "我试图绕开所有争议，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 677320,
      "end_ms": 678295,
      "text": "结果像鸡汤，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 678690,
      "end_ms": 680455,
      "text": "对不起这本书第三版，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 680720,
      "end_ms": 682320,
      "text": "我试图用科学压橡树，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 682480,
      "end_ms": 686395,
      "text": "结果发现自己连科学方法的哲学前提都没讲清第四版。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 686650,
      "end_ms": 688355,
      "text": "我试图用橡树压科学，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 688690,
      "end_ms": 691855,
      "text": "结果又踩进了另一个不能碰的坑到第五版。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 692070,
      "end_ms": 692665,
      "text": "我才明白，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 693200,
      "end_ms": 695315,
      "text": "真正的解读不是替这本书说话，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 695620,
      "end_ms": 696965,
      "text": "是把你送到他面前，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 697320,
      "end_ms": 697975,
      "text": "然后闭嘴。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 698530,
      "end_ms": 699555,
      "text": "由于平台规则，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 699810,
      "end_ms": 702455,
      "text": "有些细节无法展开哪些细节，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 702790,
      "end_ms": 707125,
      "text": "比如相术与黄帝内经望诊法之间那条被刻意抹掉的传承线，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 707640,
      "end_ms": 710745,
      "text": "比如古代画家如何在创作中隐藏相学密码？"
    },
    {
      "segment_id": "s000281",
      "start_ms": 711250,
      "end_ms": 712410,
      "text": "比如荀子的批判，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 712430,
      "end_ms": 716275,
      "text": "为什么恰恰证明了相术在战国时代的广泛影响力？"
    },
    {
      "segment_id": "s000283",
      "start_ms": 716790,
      "end_ms": 717930,
      "text": "这些东西一旦展开，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 718230,
      "end_ms": 719865,
      "text": "这条内容大概率活不过进来。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 720130,
      "end_ms": 723360,
      "text": "所以你在屏幕上看到的是删掉三层铺垫，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 723420,
      "end_ms": 724880,
      "text": "砍掉五处例证之后，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 725120,
      "end_ms": 726775,
      "text": "仍然能留下来的骨架。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 727240,
      "end_ms": 729085,
      "text": "真正的血肉在书里，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 729450,
      "end_ms": 731055,
      "text": "平台能限制一段文案，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 731410,
      "end_ms": 732865,
      "text": "限制不了一本书的厚度。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 733470,
      "end_ms": 734735,
      "text": "这本书适合三种人，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 735010,
      "end_ms": 738280,
      "text": "第一种是被科学VS迷信这个伪命题。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 738280,
      "end_ms": 739180,
      "text": "夹在中间的人，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 739200,
      "end_ms": 740445,
      "text": "你既不想盲目信，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 740780,
      "end_ms": 742065,
      "text": "也不想傲慢的否定，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 742450,
      "end_ms": 744315,
      "text": "但你没有语言描述自己的位置，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 745190,
      "end_ms": 746255,
      "text": "这本书给你语言。"
    },
    {
      "segment_id": "s000298",
      "start_ms": 746490,
      "end_ms": 748345,
      "text": "第二种是想训练思维的人。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 748790,
      "end_ms": 750130,
      "text": "你以为像术是教条，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 750390,
      "end_ms": 751705,
      "text": "它其实是认知史。"
    },
    {
      "segment_id": "s000301",
      "start_ms": 752000,
      "end_ms": 753280,
      "text": "你以为面向是迷信，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 753540,
      "end_ms": 756505,
      "text": "它其实是一套需要被严肃拆解的知识体系。"
    },
    {
      "segment_id": "s000303",
      "start_ms": 757070,
      "end_ms": 759875,
      "text": "第三种是对中国思想史好奇的人。"
    },
    {
      "segment_id": "s000304",
      "start_ms": 760110,
      "end_ms": 762780,
      "text": "你想知道两千年来最聪明的头脑如何，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 762780,
      "end_ms": 765860,
      "text": "在一个无法被实验证明的领域里反复推演，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 766020,
      "end_ms": 768805,
      "text": "争论、修正它不适合三种人，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 769430,
      "end_ms": 771565,
      "text": "想找简单答案的人解堵。"
    },
    {
      "segment_id": "s000308",
      "start_ms": 771990,
      "end_ms": 773860,
      "text": "想找战队材料的人别赌。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 774410,
      "end_ms": 776410,
      "text": "想找心灵鸡汤的人别赌，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 776550,
      "end_ms": 777785,
      "text": "他不负责安慰你，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 778060,
      "end_ms": 780085,
      "text": "他负责让你不舒服怎么读，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 780870,
      "end_ms": 782435,
      "text": "不要从头到尾跪着读，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 782750,
      "end_ms": 784415,
      "text": "也不要从头到尾审判着读，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 784800,
      "end_ms": 785485,
      "text": "带一支笔，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 786070,
      "end_ms": 791025,
      "text": "先读像数会考部分问自己这套分类体系的逻辑是什么？"
    },
    {
      "segment_id": "s000316",
      "start_ms": 791250,
      "end_ms": 792270,
      "text": "再读记事部分，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 792450,
      "end_ms": 793145,
      "text": "问自己，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 793460,
      "end_ms": 797480,
      "text": "那些被记录下来的案例和今天的幸存者偏差有什么关系？"
    },
    {
      "segment_id": "s000319",
      "start_ms": 797560,
      "end_ms": 797820,
      "text": "最后，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 797820,
      "end_ms": 799645,
      "text": "读文献本身问自己，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 799980,
      "end_ms": 801960,
      "text": "我能不能在不相信的前提下，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 802120,
      "end_ms": 803105,
      "text": "仍然理解他？"
    },
    {
      "segment_id": "s000323",
      "start_ms": 803310,
      "end_ms": 805610,
      "text": "如果只打算从这条内容里带走一个动作，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 805770,
      "end_ms": 808265,
      "text": "我希望是去找这本书来读。"
    },
    {
      "segment_id": "s000325",
      "start_ms": 808810,
      "end_ms": 809855,
      "text": "不是读我的文案，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 810170,
      "end_ms": 812005,
      "text": "是读正统典校的原文。"
    },
    {
      "segment_id": "s000327",
      "start_ms": 812560,
      "end_ms": 814555,
      "text": "不是读结论是读文献，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 815000,
      "end_ms": 816990,
      "text": "不是读谁赢了试读，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 817070,
      "end_ms": 820320,
      "text": "他们怎么说的平台能删掉一段文案，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 820640,
      "end_ms": 821160,
      "text": "删不掉。"
    },
    {
      "segment_id": "s000331",
      "start_ms": 821160,
      "end_ms": 822945,
      "text": "你翻开书之后的那几个小时，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 823700,
      "end_ms": 827925,
      "text": "你们看的这个版本已经是第五版前四百死在草稿箱里。"
    },
    {
      "segment_id": "s000333",
      "start_ms": 828420,
      "end_ms": 829655,
      "text": "这一版能活下来，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 829900,
      "end_ms": 831795,
      "text": "是因为他学会了不说太多，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 832230,
      "end_ms": 835045,
      "text": "但书不会书里什么都说了。"
    },
    {
      "segment_id": "s000336",
      "start_ms": 835450,
      "end_ms": 841555,
      "text": "二十四卷三百九十九页六种述数文献中的一种两千年的认知遗产。"
    },
    {
      "segment_id": "s000337",
      "start_ms": 842220,
      "end_ms": 844045,
      "text": "剩下的你自己去看，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 844420,
      "end_ms": 846775,
      "text": "这才是我把这条文案改了五遍，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 847130,
      "end_ms": 849155,
      "text": "仍然要把它推到你面前的原因。"
    },
    {
      "segment_id": "s000340",
      "start_ms": 849500,
      "end_ms": 850165,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 850390,
      "end_ms": 852435,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "bc4805fc62e52985648b5b4b1e40017fdba99800f5d41e6d1ad9a522c554934e"
}