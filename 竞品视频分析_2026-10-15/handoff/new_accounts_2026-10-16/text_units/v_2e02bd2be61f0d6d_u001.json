{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_2e02bd2be61f0d6d_u001",
  "video_id": "v_2e02bd2be61f0d6d",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 532.109002,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 3690,
      "text": "您知道中国从古至今极神秘的湖是哪一座吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4410,
      "end_ms": 8950,
      "text": "有人说是长白山天池火山炸出来的深湖，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 9610,
      "end_ms": 11650,
      "text": "一年有大半年冰封，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 12310,
      "end_ms": 17270,
      "text": "据说水怪目击记录从一九零三年一直排到今天。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 17750,
      "end_ms": 19190,
      "text": "有人说是青海湖，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 19570,
      "end_ms": 21530,
      "text": "湖心底下有个无底黑洞，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 21890,
      "end_ms": 23510,
      "text": "据说跟黑海相通，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 23950,
      "end_ms": 25470,
      "text": "水怪就住在里面。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 26190,
      "end_ms": 27450,
      "text": "但要说极神秘，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 27650,
      "end_ms": 29010,
      "text": "这两座都排不上。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 29130,
      "end_ms": 32530,
      "text": "第一是青海湖连前五都进不了，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 32850,
      "end_ms": 34990,
      "text": "真正排在榜首的那座湖，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 35190,
      "end_ms": 36730,
      "text": "它已经干了几十年了，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 37030,
      "end_ms": 38170,
      "text": "一滴水都没有。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 38470,
      "end_ms": 42530,
      "text": "可就是这样一片干涸的湖盆卫星从天上拍下来，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 42770,
      "end_ms": 44390,
      "text": "它像一只巨大的耳朵。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 45050,
      "end_ms": 45810,
      "text": "有人进去，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 45810,
      "end_ms": 47610,
      "text": "找水再也没出来。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 47790,
      "end_ms": 50250,
      "text": "有人徒步穿越倒在了半路上，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 50410,
      "end_ms": 53050,
      "text": "到今天它的核心区域还是禁区，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 53630,
      "end_ms": 55510,
      "text": "普通人根本不让进，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 55670,
      "end_ms": 56470,
      "text": "它是哪一座？"
    },
    {
      "segment_id": "s000023",
      "start_ms": 57330,
      "end_ms": 57750,
      "text": "今天，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 57750,
      "end_ms": 59290,
      "text": "咱们就来盘点中国，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 59410,
      "end_ms": 62325,
      "text": "从古至至今极神秘的石座湖。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 62800,
      "end_ms": 63505,
      "text": "老规矩，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 63760,
      "end_ms": 64600,
      "text": "开讲之前，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 64680,
      "end_ms": 66665,
      "text": "劳烦您扣个一点个红心，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 66970,
      "end_ms": 70425,
      "text": "让我看看都是谁在听第十名。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 71380,
      "end_ms": 75785,
      "text": "泸沽虎在云南和四川交界，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 76630,
      "end_ms": 80250,
      "text": "这座湖的水轻到什么程度？"
    },
    {
      "segment_id": "s000032",
      "start_ms": 80430,
      "end_ms": 81645,
      "text": "能见度十二米，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 83310,
      "end_ms": 84615,
      "text": "站在船上往下看，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 85000,
      "end_ms": 85920,
      "text": "水底的水草，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 86020,
      "end_ms": 87345,
      "text": "一根一根数得清。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 88050,
      "end_ms": 91535,
      "text": "可泸沽湖真正神秘的不在水里，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 92240,
      "end_ms": 95685,
      "text": "在岸上湖边住着摩梭人，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 96350,
      "end_ms": 101455,
      "text": "到今天还保留着男不娶女不嫁的走婚习俗。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 101900,
      "end_ms": 103635,
      "text": "成年姑娘都有自己的花篓，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 103960,
      "end_ms": 105880,
      "text": "小伙子晚上到花楼来，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 105880,
      "end_ms": 107775,
      "text": "天不亮就回自己母亲家。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 108230,
      "end_ms": 110275,
      "text": "两个人只凭感情在一起，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 110730,
      "end_ms": 111685,
      "text": "感情不在了，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 112190,
      "end_ms": 113615,
      "text": "关系就自然结束，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 114250,
      "end_ms": 115465,
      "text": "没有财产纠纷，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 115780,
      "end_ms": 116995,
      "text": "没有抚养权争夺。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 117590,
      "end_ms": 121265,
      "text": "这是中国罕见地还在延续的母系氏族社会，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 121720,
      "end_ms": 125544,
      "text": "被学者称为人类家庭史的活化石。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 126290,
      "end_ms": 131765,
      "text": "摩梭民歌里唱阿哥阿哥月亮才到西山头，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 132500,
      "end_ms": 135480,
      "text": "你何须慌慌的走一座湖，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 135860,
      "end_ms": 137485,
      "text": "养育了一个民族，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 138010,
      "end_ms": 138710,
      "text": "一个民族，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 138730,
      "end_ms": 139715,
      "text": "守着一座湖，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 140690,
      "end_ms": 141630,
      "text": "守了几千年，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 141650,
      "end_ms": 144465,
      "text": "这够神秘第九名，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 144890,
      "end_ms": 147205,
      "text": "赛里木湖在新疆伯乐，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 148130,
      "end_ms": 151465,
      "text": "这座湖被称为大西洋最后一滴眼泪。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 152380,
      "end_ms": 152905,
      "text": "为什么？"
    },
    {
      "segment_id": "s000059",
      "start_ms": 153840,
      "end_ms": 158225,
      "text": "因为它是大西洋暖湿气流能到达的最东端，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 158800,
      "end_ms": 161245,
      "text": "再往东气流就过不去了。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 161620,
      "end_ms": 163890,
      "text": "一滴来自大西洋的雨落，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 163890,
      "end_ms": 168465,
      "text": "在这片海拔两千多米的高山盆地攒成了一座湖。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 169040,
      "end_ms": 170375,
      "text": "二零零七年六月，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 170790,
      "end_ms": 175455,
      "text": "新疆首届环赛李木湖自行车赛正在进行。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 176100,
      "end_ms": 177800,
      "text": "据多名车手描述，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 177920,
      "end_ms": 179440,
      "text": "离岸一百米左右的湖面上，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 179440,
      "end_ms": 180620,
      "text": "有一个庞大的东西，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 180620,
      "end_ms": 181245,
      "text": "在游动，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 181650,
      "end_ms": 183155,
      "text": "目测长约十米。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 183360,
      "end_ms": 185065,
      "text": "这一幕被记者拍了下来。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 185890,
      "end_ms": 186290,
      "text": "后来，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 186290,
      "end_ms": 189445,
      "text": "央视地理中国专门去做了一期调查，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 189880,
      "end_ms": 190360,
      "text": "专家，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 190360,
      "end_ms": 192640,
      "text": "在湖里找到一种珍稀物种，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 192660,
      "end_ms": 193535,
      "text": "叫北蟾。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 194060,
      "end_ms": 196615,
      "text": "可北辰不适合在湖里生长。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 197210,
      "end_ms": 199355,
      "text": "那水怪到底是什么？"
    },
    {
      "segment_id": "s000078",
      "start_ms": 200170,
      "end_ms": 202850,
      "text": "有人说是湖里的一种珍贵鱼种。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 202850,
      "end_ms": 206665,
      "text": "高白龟可一条鱼能长到十米吗？"
    },
    {
      "segment_id": "s000080",
      "start_ms": 207570,
      "end_ms": 209185,
      "text": "至今没有定论。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 210070,
      "end_ms": 212710,
      "text": "一座大西洋的雨展成的湖，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 212850,
      "end_ms": 215305,
      "text": "里面藏着一个十米长的影子。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 215680,
      "end_ms": 216445,
      "text": "这够神秘。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 217470,
      "end_ms": 218175,
      "text": "第八名，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 219200,
      "end_ms": 222865,
      "text": "靖泊湖在黑龙江牡丹江，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 223650,
      "end_ms": 226075,
      "text": "这是中国最大的高山堰塞湖。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 227000,
      "end_ms": 228785,
      "text": "一万年前火山喷发，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 229290,
      "end_ms": 232410,
      "text": "容颜堵住了牡丹江江水，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 232430,
      "end_ms": 233395,
      "text": "积成了这座湖。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 233800,
      "end_ms": 235665,
      "text": "从二十世纪七十年代起，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 236010,
      "end_ms": 238745,
      "text": "就不断有人在这座湖里看到怪东西。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 239440,
      "end_ms": 240560,
      "text": "据目击者描述，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 240840,
      "end_ms": 245905,
      "text": "一九七九年看到的两三名二零零零年看到的七八米。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 246560,
      "end_ms": 248560,
      "text": "二零零六年七月五日，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 248640,
      "end_ms": 252155,
      "text": "六名目击者在距岸边约四十米处，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 252530,
      "end_ms": 256005,
      "text": "看见一只约二十米长的生物在湖中游动，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 256390,
      "end_ms": 259085,
      "text": "其中一人用DV机录了下来。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 259940,
      "end_ms": 263980,
      "text": "这些目击记录至今没有得到官方可考证实。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 264500,
      "end_ms": 265815,
      "text": "目击者描述，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 266530,
      "end_ms": 267590,
      "text": "这东西像蛇，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 267610,
      "end_ms": 268370,
      "text": "但不是蛇。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 268710,
      "end_ms": 270390,
      "text": "行动时不是左右摆动，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 270810,
      "end_ms": 272190,
      "text": "而是上下潜游。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 272490,
      "end_ms": 273810,
      "text": "像传说中的龙。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 274090,
      "end_ms": 275170,
      "text": "但没有鳍和爪。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 276130,
      "end_ms": 280550,
      "text": "当地水产研究所的人说有鳍的应该是鱼类。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 280710,
      "end_ms": 282685,
      "text": "但鱼类不可能长这么大，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 283340,
      "end_ms": 286880,
      "text": "即使是目前已知最大的淡水鱼达市，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 286940,
      "end_ms": 288325,
      "text": "最长也不过十米，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 288600,
      "end_ms": 292410,
      "text": "而且主要分布在黑龙江流域靖国湖里，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 292410,
      "end_ms": 293455,
      "text": "并没有这种鱼。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 294210,
      "end_ms": 296260,
      "text": "那目击者看到的到底是什么？"
    },
    {
      "segment_id": "s000113",
      "start_ms": 296430,
      "end_ms": 298010,
      "text": "到今天还是个谜。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 298510,
      "end_ms": 300410,
      "text": "当地还有一个传说说，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 300430,
      "end_ms": 310550,
      "text": "湖里的巨兽是为了守护一位叫红罗女的人的棺材而生的一座火山堵出来的湖湖底藏着一个没有鳍没有爪的龙。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 311030,
      "end_ms": 314630,
      "text": "这够神秘第七名，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 314990,
      "end_ms": 321350,
      "text": "鄱阳湖在江西读唱淮阳湖是中国最大的淡水湖，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 321410,
      "end_ms": 325070,
      "text": "可它最出名的地方不在湖有多大？"
    },
    {
      "segment_id": "s000119",
      "start_ms": 325770,
      "end_ms": 330210,
      "text": "在湖的北端有一片水域叫老爷庙水域，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 330850,
      "end_ms": 333270,
      "text": "当地人管它叫中国百慕大，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 334070,
      "end_ms": 335830,
      "text": "这片水域有多邪？"
    },
    {
      "segment_id": "s000122",
      "start_ms": 336590,
      "end_ms": 337570,
      "text": "据公开报道，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 337950,
      "end_ms": 340690,
      "text": "从上世纪六十年代到八十年代，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 340890,
      "end_ms": 345470,
      "text": "有一百多艘船在这片水域沉没或失踪。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 346330,
      "end_ms": 347690,
      "text": "关于老爷庙水域，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 347970,
      "end_ms": 352600,
      "text": "当地流传最广的一个故事发生在一九四五年。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 353140,
      "end_ms": 358910,
      "text": "相传一艘叫神户号的日军运输船装着掠夺来的财宝，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 358910,
      "end_ms": 360330,
      "text": "在经过这片水域时，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 360350,
      "end_ms": 361415,
      "text": "突然沉默了。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 362370,
      "end_ms": 364645,
      "text": "这个故事后来被写进了报告文学，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 365490,
      "end_ms": 366695,
      "text": "流传很广，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 367290,
      "end_ms": 369675,
      "text": "但他更像是一个民间传说。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 370980,
      "end_ms": 375355,
      "text": "真实的历史记录是这片水域确实事故频发，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 375800,
      "end_ms": 377595,
      "text": "仅一九八五年一年，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 378080,
      "end_ms": 380375,
      "text": "就有二十多条船在此沉没。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 381120,
      "end_ms": 382845,
      "text": "后来有专家研究发现，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 383230,
      "end_ms": 387075,
      "text": "老爷庙水域的平均两天就有一天是大风日，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 387570,
      "end_ms": 389775,
      "text": "湖底还存在一个巨大的沙坝，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 390540,
      "end_ms": 392385,
      "text": "阻挡水流形成漩涡。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 392950,
      "end_ms": 398300,
      "text": "可那些沉船哪上千吨的货船沉在这片只有十八米深的水域，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 398380,
      "end_ms": 400925,
      "text": "任凭怎么打捞船骸就是找不到。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 401250,
      "end_ms": 404230,
      "text": "您说一片浅水怎么就能吞了？"
    },
    {
      "segment_id": "s000143",
      "start_ms": 404230,
      "end_ms": 405070,
      "text": "上百条船，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 405350,
      "end_ms": 406545,
      "text": "连残骸都不留，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 406920,
      "end_ms": 407615,
      "text": "这够神秘。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 409000,
      "end_ms": 409565,
      "text": "第六名，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 409850,
      "end_ms": 413395,
      "text": "纳木错在西藏拉萨以北。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 413820,
      "end_ms": 416715,
      "text": "纳木错是西藏三大圣湖之一，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 417240,
      "end_ms": 418635,
      "text": "藏语里叫天胡。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 419360,
      "end_ms": 421915,
      "text": "在当地藏族同胞的传统里，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 422200,
      "end_ms": 423545,
      "text": "这座湖是神圣，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 424340,
      "end_ms": 425415,
      "text": "湖水不能碰，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 425750,
      "end_ms": 427075,
      "text": "不能在湖里洗手，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 427510,
      "end_ms": 429675,
      "text": "不能再湖边大小便，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 430130,
      "end_ms": 431865,
      "text": "更不能下湖捕鱼，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 432540,
      "end_ms": 435660,
      "text": "因为这些行为被视为对神的冒犯。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 435800,
      "end_ms": 440920,
      "text": "纳木错在藏传佛教里还有欲卜凶吉祸福的传统传说，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 441220,
      "end_ms": 443540,
      "text": "命大的人登上湖边的山丘，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 443760,
      "end_ms": 446105,
      "text": "就能看到湖中的灵异现象。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 446900,
      "end_ms": 447320,
      "text": "过去，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 447320,
      "end_ms": 451515,
      "text": "这里常常为藏传佛教进行元光补的场所，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 451890,
      "end_ms": 456175,
      "text": "还有传说纳木错的湖底跟北面的黑海相通，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 456790,
      "end_ms": 459295,
      "text": "湖水不停的向黑海流过去。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 459770,
      "end_ms": 464025,
      "text": "有人曾在湖心的冰面上发现水下有庞大的漩涡，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 464410,
      "end_ms": 466975,
      "text": "把水搅的飞旋乱转。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 467830,
      "end_ms": 471870,
      "text": "一座湖承载了一个民族的信仰和敬畏，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 471870,
      "end_ms": 473955,
      "text": "高僧还要靠他来看吉凶。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 474750,
      "end_ms": 478325,
      "text": "一座湖承担了信仰和生死两件事。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 479130,
      "end_ms": 482000,
      "text": "这够神秘前十道第六，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 482240,
      "end_ms": 484945,
      "text": "泸沽湖养了一个母系氏族，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 485640,
      "end_ms": 488480,
      "text": "赛里木湖藏着十米的影子镜。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 488520,
      "end_ms": 493030,
      "text": "博湖里有条没有骑的龙鄱阳湖吞了上百条船，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 493050,
      "end_ms": 494025,
      "text": "不留残骸，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 494520,
      "end_ms": 497155,
      "text": "纳木错活着的人不敢碰他的水，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 497790,
      "end_ms": 499525,
      "text": "可他们还不是最神秘的。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 500890,
      "end_ms": 504080,
      "text": "接下来这五座湖有一座地方治理，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 504080,
      "end_ms": 504740,
      "text": "记着蛟龙，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 505000,
      "end_ms": 506360,
      "text": "有一座湖里的东西，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 506360,
      "end_ms": 507580,
      "text": "可能有十几米长，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 507760,
      "end_ms": 509780,
      "text": "有一座它已经干了几十年了，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 509820,
      "end_ms": 510944,
      "text": "可没人敢进去，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 511350,
      "end_ms": 512390,
      "text": "尤其是榜首，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 512390,
      "end_ms": 514295,
      "text": "那一座一滴水都没有，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 514550,
      "end_ms": 516695,
      "text": "却比任何一座湖都吓人。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 517350,
      "end_ms": 521315,
      "text": "他是哪下一集已经同步更新，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 521850,
      "end_ms": 522790,
      "text": "点开我的头像，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 522790,
      "end_ms": 523555,
      "text": "进入主页，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 524330,
      "end_ms": 527775,
      "text": "第一条视频就是下一集点个关注，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 528290,
      "end_ms": 531925,
      "text": "看看谁才是中国从古至今极神秘的那座湖。"
    }
  ],
  "source_transcript_sha256": "c85555b04b9a7214471d8e30dad2c66645d7c0545a65eeea018dc105a9aba742"
}