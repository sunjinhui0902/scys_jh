{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_cc8397da3c3f0c8a_u001",
  "video_id": "v_cc8397da3c3f0c8a",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 656.94,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 3450,
      "text": "你知道中国最离奇经历的十件国宝是哪一件吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4390,
      "end_ms": 5030,
      "text": "有人说，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5030,
      "end_ms": 7870,
      "text": "富春山居图被主人扔进火里，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7870,
      "end_ms": 8830,
      "text": "要烧了殉葬，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 9570,
      "end_ms": 11050,
      "text": "不子拿命去抢，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12010,
      "end_ms": 13150,
      "text": "烧成了两半。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 13570,
      "end_ms": 14230,
      "text": "有人说，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 14270,
      "end_ms": 17290,
      "text": "圆明园的兽首被一把火烧没了，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 17290,
      "end_ms": 19430,
      "text": "流落海外错了，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 19690,
      "end_ms": 22470,
      "text": "富春山居图好歹抢出来了。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 22910,
      "end_ms": 28470,
      "text": "兽首好歹找回来几个有正最倒霉的那件国宝，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 28870,
      "end_ms": 30000,
      "text": "不是差点毁了，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 30280,
      "end_ms": 31380,
      "text": "是真的没了，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 31560,
      "end_ms": 32220,
      "text": "消失了。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 32220,
      "end_ms": 35040,
      "text": "八十多年全世界都在找到，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 35040,
      "end_ms": 36740,
      "text": "今天一点线索都没有，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 36740,
      "end_ms": 37560,
      "text": "活不见物，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 37560,
      "end_ms": 39200,
      "text": "死不见归他是谁？"
    },
    {
      "segment_id": "s000019",
      "start_ms": 39760,
      "end_ms": 40220,
      "text": "今天，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 40220,
      "end_ms": 42140,
      "text": "咱们就来盘点中国实践，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 42360,
      "end_ms": 43880,
      "text": "差点被毁掉的国宝。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 44720,
      "end_ms": 45440,
      "text": "老规矩，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 45620,
      "end_ms": 46440,
      "text": "开讲之前，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 46660,
      "end_ms": 48120,
      "text": "劳烦您点个红心，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 48420,
      "end_ms": 51300,
      "text": "让我看看都是谁在听第十名。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 51580,
      "end_ms": 56320,
      "text": "马踏飞燕甘肃无畏这件国宝的诞生够传奇，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 56640,
      "end_ms": 58660,
      "text": "可它出土之后的遭遇更离谱。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 58960,
      "end_ms": 59915,
      "text": "一九六九年，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 60360,
      "end_ms": 63395,
      "text": "武威擂台一群农民挖房攻洞，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 63860,
      "end_ms": 65895,
      "text": "挖进了一座东汉古墓，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 66540,
      "end_ms": 72190,
      "text": "里面出了一大批同马同车同人两百多件。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 72290,
      "end_ms": 74405,
      "text": "当时没有专业考古人员在场，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 74770,
      "end_ms": 76350,
      "text": "这批东西被搬出来，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 76350,
      "end_ms": 77805,
      "text": "堆在公社库房里，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 78400,
      "end_ms": 80935,
      "text": "没人知道里面有什么了不得的东西，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 81720,
      "end_ms": 82725,
      "text": "就那么扔着，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 83140,
      "end_ms": 85435,
      "text": "跟一堆废铜烂铁搁在一起，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 86000,
      "end_ms": 87905,
      "text": "这一扔就是好几年。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 88880,
      "end_ms": 90015,
      "text": "一九七一年，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 90310,
      "end_ms": 92715,
      "text": "郭沫若陪外宾到甘肃访问，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 93530,
      "end_ms": 95055,
      "text": "有人跟他提了一嘴，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 95780,
      "end_ms": 97605,
      "text": "说武威出了一批铜器，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 98570,
      "end_ms": 102695,
      "text": "要不要看看郭沫若一看，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 103270,
      "end_ms": 108165,
      "text": "在那堆东西里一眼就盯上了一批踩着飞鸟的铜马，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 109230,
      "end_ms": 109890,
      "text": "当场说，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 109910,
      "end_ms": 110590,
      "text": "这个不得了，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 110670,
      "end_ms": 113575,
      "text": "这匹马才从废铜堆里被认出来。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 114170,
      "end_ms": 114935,
      "text": "您想想，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 115610,
      "end_ms": 116710,
      "text": "要不是郭沫若，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 116710,
      "end_ms": 118115,
      "text": "正好来了甘肃，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 118750,
      "end_ms": 120455,
      "text": "正好有人提了一嘴，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 121270,
      "end_ms": 123185,
      "text": "正好他愿意去看一眼。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 124100,
      "end_ms": 127355,
      "text": "这匹马还不知道要在库房里吃多少年灰。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 127870,
      "end_ms": 129925,
      "text": "后来他成了中国旅游标志，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 130400,
      "end_ms": 132095,
      "text": "代言了中国四十多年，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 132810,
      "end_ms": 134305,
      "text": "可当年差一步，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 134840,
      "end_ms": 137715,
      "text": "他可能就被当成废铜回炉话了。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 138770,
      "end_ms": 141325,
      "text": "四十多年的中国旅游标志就没了。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 141790,
      "end_ms": 144460,
      "text": "一匹铜马出土之后，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 144460,
      "end_ms": 146435,
      "text": "在废铜堆里扔了好几年，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 147200,
      "end_ms": 148900,
      "text": "被一个人的遗眼救了，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 148900,
      "end_ms": 150335,
      "text": "您说这算不算命大？"
    },
    {
      "segment_id": "s000063",
      "start_ms": 151940,
      "end_ms": 152785,
      "text": "第九名，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 153770,
      "end_ms": 156695,
      "text": "太阳神鸟金氏四川成都，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 157750,
      "end_ms": 162995,
      "text": "二零零一年成都金沙遗址推土机在平整工地。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 163860,
      "end_ms": 165660,
      "text": "司机看见翻出来的图里，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 165660,
      "end_ms": 166875,
      "text": "有个东西反光，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 167360,
      "end_ms": 168105,
      "text": "喊了一声，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 168500,
      "end_ms": 171970,
      "text": "考古队的人跑过来扒开腿一看一小团。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 171990,
      "end_ms": 174455,
      "text": "皱巴巴的东西跟泥疙瘩粘在一起，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 174820,
      "end_ms": 177085,
      "text": "灰扑扑的看不出是什么，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 178770,
      "end_ms": 181540,
      "text": "差一点真的就差那么一铲子。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 182260,
      "end_ms": 184100,
      "text": "推土机再往前推一下，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 184340,
      "end_ms": 188700,
      "text": "这东西就被碾进土里运到渣土厂爆掉了，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 188740,
      "end_ms": 191940,
      "text": "拿回实验室清理一点一点展开，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 192940,
      "end_ms": 194440,
      "text": "所有人都不说话了。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 195160,
      "end_ms": 199840,
      "text": "一张薄如蝉翼的金箔厚度只有零点零二厘米，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 199840,
      "end_ms": 201640,
      "text": "比一张纸还薄，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 201640,
      "end_ms": 205280,
      "text": "上面镂空刻着太阳和四只飞鸟。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 205280,
      "end_ms": 208080,
      "text": "三千年前的古蜀人做的，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 208080,
      "end_ms": 212110,
      "text": "后来他他被选为中国文化遗产标志，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 212970,
      "end_ms": 219190,
      "text": "全中国所有跟文化遗产有关的官方场合用的都是这个图案。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 219630,
      "end_ms": 221050,
      "text": "可您回过头想想，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 221770,
      "end_ms": 225070,
      "text": "这件东西是从推土机底下捡回来的，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 225930,
      "end_ms": 227170,
      "text": "工地上那么多土，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 227230,
      "end_ms": 228130,
      "text": "那么多石头，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 228290,
      "end_ms": 230390,
      "text": "司机要是没看见那一下反光，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 231010,
      "end_ms": 233090,
      "text": "要是那天阴天没有太阳，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 233490,
      "end_ms": 237170,
      "text": "这片金箔就跟渣土一起被倒进了垃圾场，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 238350,
      "end_ms": 243055,
      "text": "中国文化遗产的标志差点被当建筑垃圾埋了。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 243650,
      "end_ms": 244775,
      "text": "您说后不后怕？"
    },
    {
      "segment_id": "s000092",
      "start_ms": 245730,
      "end_ms": 246445,
      "text": "第八名，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 247460,
      "end_ms": 252395,
      "text": "兵马俑陕西西安兵马俑没被毁掉，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 253220,
      "end_ms": 256135,
      "text": "几千个陶俑好好的站在坑里，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 257280,
      "end_ms": 258960,
      "text": "可他失去了一样东西，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 259360,
      "end_ms": 261080,
      "text": "永远找不回来的颜色。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 261860,
      "end_ms": 264715,
      "text": "一九七四年兵马俑刚出土的时候，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 265100,
      "end_ms": 268760,
      "text": "不是您今天在博物馆里看到的灰扑扑的土色。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 268840,
      "end_ms": 271950,
      "text": "它们是带颜色的红的袍子，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 272110,
      "end_ms": 274415,
      "text": "绿的裤子、纸的铠甲，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 274730,
      "end_ms": 275335,
      "text": "粉的脸，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 275810,
      "end_ms": 278205,
      "text": "一个个跟真人似的花花绿绿，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 279190,
      "end_ms": 281150,
      "text": "可陶俑从土里挖出来，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 281450,
      "end_ms": 284360,
      "text": "接触了空气表面的彩绘涂层，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 284400,
      "end_ms": 286720,
      "text": "迅速氧化几分钟，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 287060,
      "end_ms": 289000,
      "text": "颜色就没了一片，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 289060,
      "end_ms": 290285,
      "text": "一片往下脱落，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 290630,
      "end_ms": 291605,
      "text": "拦都拦不住。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 292430,
      "end_ms": 297305,
      "text": "考古人员眼睁睁看着一个彩色的将军俑变成了灰色的泥人，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 297810,
      "end_ms": 298615,
      "text": "什么都做不了。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 299480,
      "end_ms": 301115,
      "text": "后来技术改进了，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 302170,
      "end_ms": 303350,
      "text": "新挖出来的蛹，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 303390,
      "end_ms": 304810,
      "text": "能做一些保护处理。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 304830,
      "end_ms": 306615,
      "text": "可早期出土的那批。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 307520,
      "end_ms": 309540,
      "text": "颜色已经永远回不来了。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 310300,
      "end_ms": 312540,
      "text": "您今天去西安看兵马俑，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 312920,
      "end_ms": 315100,
      "text": "看到的是一支灰色的军队，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 316000,
      "end_ms": 317680,
      "text": "可两千两百年前，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 318000,
      "end_ms": 319560,
      "text": "他们是一支彩色的军，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 320060,
      "end_ms": 321220,
      "text": "红红绿绿，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 321440,
      "end_ms": 322460,
      "text": "威风凛凛。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 322940,
      "end_ms": 325220,
      "text": "这些颜色等了两千两百年，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 325520,
      "end_ms": 327440,
      "text": "重见天日的那一刻，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 328140,
      "end_ms": 329460,
      "text": "几分钟就消失。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 330540,
      "end_ms": 332040,
      "text": "兵马俑没有被毁，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 333000,
      "end_ms": 334980,
      "text": "可他最惊艳的那一面，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 335440,
      "end_ms": 341290,
      "text": "我们永远看不到一支两千两百年前的彩色军队，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 341630,
      "end_ms": 343690,
      "text": "重见天日的那一刻，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 343890,
      "end_ms": 345530,
      "text": "失去了所有颜色。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 345690,
      "end_ms": 347990,
      "text": "您说这算不算另一种毁掉？"
    },
    {
      "segment_id": "s000131",
      "start_ms": 349350,
      "end_ms": 350090,
      "text": "第七名，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 350550,
      "end_ms": 351650,
      "text": "四羊方尊，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 352850,
      "end_ms": 353930,
      "text": "湖南宁乡，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 354930,
      "end_ms": 355950,
      "text": "一九三八年，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 356130,
      "end_ms": 360150,
      "text": "湖南宁乡一个农民在山坡上种红薯刨出来。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 361450,
      "end_ms": 362410,
      "text": "三千年前，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 362470,
      "end_ms": 363730,
      "text": "商朝的青铜器，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 364230,
      "end_ms": 366785,
      "text": "四个羊头从弃身探出来，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 367180,
      "end_ms": 368085,
      "text": "一次浇筑，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 368430,
      "end_ms": 369485,
      "text": "精美绝伦。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 370060,
      "end_ms": 372605,
      "text": "可他刚出土就赶上了日本人打仗，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 373340,
      "end_ms": 374645,
      "text": "当地人把它藏着，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 374940,
      "end_ms": 376275,
      "text": "转移了好几个地方。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 376730,
      "end_ms": 379335,
      "text": "后来存放在长沙一个银行的仓库里，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 380120,
      "end_ms": 382990,
      "text": "日军轰炸长沙一颗炸弹落下来，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 383010,
      "end_ms": 387570,
      "text": "仓库炸四阳方尊被炸成了二十多块，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 387570,
      "end_ms": 389735,
      "text": "碎片碎了一地。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 390510,
      "end_ms": 396045,
      "text": "这一岁就是好几年碎片散落在不同的人手里，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 396870,
      "end_ms": 398165,
      "text": "有的被捡走了，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 398610,
      "end_ms": 399805,
      "text": "有的混在废墟里，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 400290,
      "end_ms": 403130,
      "text": "一直到后来文物部门费了很大力气，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 403130,
      "end_ms": 404755,
      "text": "把碎片一块一块找回来。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 405460,
      "end_ms": 407295,
      "text": "请修复师一块一块对，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 407660,
      "end_ms": 408520,
      "text": "一块一块拼，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 408800,
      "end_ms": 409795,
      "text": "一块一块焊，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 410290,
      "end_ms": 412205,
      "text": "拼了很长时间才复原。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 413070,
      "end_ms": 416575,
      "text": "您今天在国家博物馆看到的四羊方尊，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 417510,
      "end_ms": 418230,
      "text": "仔细看，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 418230,
      "end_ms": 420070,
      "text": "还能看到修复的痕迹。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 420290,
      "end_ms": 421190,
      "text": "三千年前，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 421250,
      "end_ms": 423805,
      "text": "商朝工匠一次铸成的东西，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 424400,
      "end_ms": 426765,
      "text": "扛过了三千年的风风雨雨，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 427230,
      "end_ms": 429850,
      "text": "最后差点毁在一颗炸弹底下。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 430870,
      "end_ms": 434470,
      "text": "一件三千年前的青铜器种红薯，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 434530,
      "end_ms": 437330,
      "text": "刨出来的被炸弹炸成了二十多块，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 437570,
      "end_ms": 439070,
      "text": "又一块一块拼回来。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 439810,
      "end_ms": 441390,
      "text": "您说这东西命硬不硬？"
    },
    {
      "segment_id": "s000168",
      "start_ms": 442270,
      "end_ms": 450090,
      "text": "第六名清明上河图北京故宫博物院这幅画您听过太多次了，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 450350,
      "end_ms": 453210,
      "text": "可您未必知道他这九百年是怎么活。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 453210,
      "end_ms": 453610,
      "text": "下来。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 454630,
      "end_ms": 456935,
      "text": "张择端画完之后献给了宋徽宗，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 457180,
      "end_ms": 459140,
      "text": "宋徽宗在上面盖了章，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 459600,
      "end_ms": 460520,
      "text": "写了题签，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 461320,
      "end_ms": 465620,
      "text": "然后靖康之变金兵打进汴京，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 466260,
      "end_ms": 468960,
      "text": "皇宫里的东西被抢了个精光，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 469740,
      "end_ms": 472740,
      "text": "清明上河图就此流落民间。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 473260,
      "end_ms": 474060,
      "text": "从那以后，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 474480,
      "end_ms": 477880,
      "text": "这幅画就开始了他九百年的颠沛流离。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 478300,
      "end_ms": 479380,
      "text": "元朝的时候，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 479560,
      "end_ms": 480940,
      "text": "他在民间辗转，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 481300,
      "end_ms": 482740,
      "text": "有人偷偷藏着，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 482740,
      "end_ms": 483680,
      "text": "不敢拿出来，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 483940,
      "end_ms": 485780,
      "text": "有人高价转首倒卖。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 486280,
      "end_ms": 488490,
      "text": "有一个庄稼表将拿到了这幅画，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 489310,
      "end_ms": 490310,
      "text": "偷偷临摹了，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 490310,
      "end_ms": 491070,
      "text": "一幅赝品，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 491870,
      "end_ms": 493890,
      "text": "把真画换下来卖了。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 494050,
      "end_ms": 496570,
      "text": "这幅画差点就此下落不明，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 496750,
      "end_ms": 498670,
      "text": "明朝的时候更凶险。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 498950,
      "end_ms": 501890,
      "text": "大奸臣严嵩父子搜刮天下名画，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 502250,
      "end_ms": 508450,
      "text": "把清明上河图弄到了手严嵩倒台之后被抄家画被收进了，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 508450,
      "end_ms": 508890,
      "text": "皇宫，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 509190,
      "end_ms": 510570,
      "text": "算是暂时安全。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 511290,
      "end_ms": 512730,
      "text": "可到了清朝末年，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 513650,
      "end_ms": 514530,
      "text": "溥仪退位，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 515250,
      "end_ms": 519880,
      "text": "他把宫里一批最值前的书画偷偷带出了紫禁城，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 520800,
      "end_ms": 522940,
      "text": "夹在行李里运到了天津。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 523780,
      "end_ms": 526160,
      "text": "后来又带到了东北、长春，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 526700,
      "end_ms": 530780,
      "text": "日本战败伪满洲国的皇宫乱成一团。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 531180,
      "end_ms": 535620,
      "text": "溥仪跑了手下的人开始哄抢宫里的东西，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 535660,
      "end_ms": 540160,
      "text": "清明上河图差点就在这场混乱中被撕烂或者丢掉。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 540720,
      "end_ms": 542260,
      "text": "后来几经周折，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 542640,
      "end_ms": 544840,
      "text": "才被找回来送进了故宫博物院。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 546140,
      "end_ms": 548630,
      "text": "九百年换了几十个主人，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 548990,
      "end_ms": 553910,
      "text": "经历了灭国、战乱、抄家偷盗、哄抢，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 554290,
      "end_ms": 556550,
      "text": "好几次都是在最后一刻。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 556550,
      "end_ms": 557610,
      "text": "被抢救回来，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 557930,
      "end_ms": 559190,
      "text": "您说他是命硬，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 559190,
      "end_ms": 560310,
      "text": "还是老天爷舍不得，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 560310,
      "end_ms": 563090,
      "text": "让他没先在评论区打出四个字，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 563090,
      "end_ms": 564010,
      "text": "命悬一线，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 564910,
      "end_ms": 566190,
      "text": "打完了咱们接着讲，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 566190,
      "end_ms": 569330,
      "text": "因为接下来的前五名才是真正让人心疼的。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 570230,
      "end_ms": 571790,
      "text": "从第十到第六，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 572330,
      "end_ms": 577620,
      "text": "马踏飞燕在废铜堆里差点回炉太阳神灵鸟，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 577620,
      "end_ms": 579240,
      "text": "差点被推土机碾成，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 579260,
      "end_ms": 581900,
      "text": "渣土兵马俑几分钟丢了，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 581900,
      "end_ms": 583860,
      "text": "等了两千两百年的颜色。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 584700,
      "end_ms": 587440,
      "text": "四、阳方尊被炸弹炸成了二十多块，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 587440,
      "end_ms": 588940,
      "text": "又一块块拼回来。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 589780,
      "end_ms": 591760,
      "text": "清明上河图九百年死了，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 591760,
      "end_ms": 592760,
      "text": "好几回又活了，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 592760,
      "end_ms": 594640,
      "text": "好几回够惊险了吧。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 595540,
      "end_ms": 599100,
      "text": "可跟前五名比这些算运气好的，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 599780,
      "end_ms": 601080,
      "text": "起码东西还在。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 602240,
      "end_ms": 606440,
      "text": "接下来有一件国宝被人用锯子锯成了好几块，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 606440,
      "end_ms": 608690,
      "text": "卖到了外国，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 608710,
      "end_ms": 610750,
      "text": "到今天没回来。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 610750,
      "end_ms": 614650,
      "text": "有一部书原本一万一千多册，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 615490,
      "end_ms": 617830,
      "text": "今天全世界只剩四百多册，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 619410,
      "end_ms": 623930,
      "text": "有一个洞窟壁画被外国人整面整面接走了。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 624870,
      "end_ms": 625710,
      "text": "有一幅画，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 626450,
      "end_ms": 629810,
      "text": "主人临死前要把它扔进火里烧了，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 629810,
      "end_ms": 630330,
      "text": "殉葬，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 631090,
      "end_ms": 632890,
      "text": "可排在第一的那件，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 634390,
      "end_ms": 635590,
      "text": "不是差点毁，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 635770,
      "end_ms": 636935,
      "text": "是真的没了，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 637520,
      "end_ms": 638100,
      "text": "消失了。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 638100,
      "end_ms": 641960,
      "text": "八十多年全世界都在找活不见物，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 641980,
      "end_ms": 642660,
      "text": "死不见灰。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 643460,
