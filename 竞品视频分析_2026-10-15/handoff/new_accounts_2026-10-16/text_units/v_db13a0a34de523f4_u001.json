{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_db13a0a34de523f4_u001",
  "video_id": "v_db13a0a34de523f4",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 985.456803,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 70,
      "end_ms": 4590,
      "text": "你知道北京故宫里头老祖宗手艺最绝的宝贝是哪一件吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 5670,
      "end_ms": 6290,
      "text": "上集，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6290,
      "end_ms": 14830,
      "text": "咱们聊了象牙玺天球仪慈母金发塔三联印这一集直接揭开谜底，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 15270,
      "end_ms": 17870,
      "text": "看看前五名到底绝到什么程度，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 18270,
      "end_ms": 22490,
      "text": "尤其是榜首内谏全中国人都知道名字，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 22650,
      "end_ms": 23690,
      "text": "九成人没见过。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 23690,
      "end_ms": 24630,
      "text": "真的老规矩，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 24990,
      "end_ms": 25930,
      "text": "开讲之前，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 25930,
      "end_ms": 28050,
      "text": "劳烦您扣个一点个红心，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 28710,
      "end_ms": 30000,
      "text": "让我看看都是谁的。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 30060,
      "end_ms": 30480,
      "text": "在听。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 32000,
      "end_ms": 34480,
      "text": "排在第五名的是唐朝宰相，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 34520,
      "end_ms": 35620,
      "text": "含画的五牛图，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 35800,
      "end_ms": 36820,
      "text": "您敢信吗？"
    },
    {
      "segment_id": "s000015",
      "start_ms": 37100,
      "end_ms": 38199,
      "text": "大唐盛世，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 38240,
      "end_ms": 39460,
      "text": "人人画骏马，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 39460,
      "end_ms": 40180,
      "text": "画贵妇，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 40800,
      "end_ms": 42320,
      "text": "堂堂一位宰相，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 42820,
      "end_ms": 45800,
      "text": "偏偏趴在田埂上画了五头牛。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 46380,
      "end_ms": 49980,
      "text": "就这么一张看似平平常常的黄麻纸，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 50560,
      "end_ms": 53640,
      "text": "整整熬过了一千两百年的风霜，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 54420,
      "end_ms": 57660,
      "text": "是全中国现存最早的一幅纸本画。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 58200,
      "end_ms": 59020,
      "text": "更神的是，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 59200,
      "end_ms": 61365,
      "text": "五头牛没每一头姿态相同，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 61790,
      "end_ms": 63315,
      "text": "有埋头啃草的，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 63670,
      "end_ms": 65565,
      "text": "有扭过脖子舔鼻尖的。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 66120,
      "end_ms": 71885,
      "text": "最绝的是中间那一头居然拿一双大眼珠子直勾勾瞪着你。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 72720,
      "end_ms": 73540,
      "text": "离近了瞧，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 73680,
      "end_ms": 75475,
      "text": "牛毛细的跟真的一样，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 75850,
      "end_ms": 77655,
      "text": "眼眶里一向泛着泪光，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 78310,
      "end_ms": 80645,
      "text": "可您猜怎么着画的这么活，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 81240,
      "end_ms": 83925,
      "text": "他的命却比黄连还苦。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 84830,
      "end_ms": 85890,
      "text": "一九零零年，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 85910,
      "end_ms": 87975,
      "text": "八国联军杀进紫禁城，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 88490,
      "end_ms": 92354,
      "text": "一把将他掳走这一丢就是整整半个世纪。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 93160,
      "end_ms": 94595,
      "text": "直到一九五零年，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 94940,
      "end_ms": 96865,
      "text": "他突然现身香港地界，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 97810,
      "end_ms": 99085,
      "text": "周总理得到消息，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 99470,
      "end_ms": 101595,
      "text": "毫不犹豫特批巨资，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 102120,
      "end_ms": 104515,
      "text": "硬是从洋人手里抢救了回来。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 104830,
      "end_ms": 105070,
      "text": "嗯，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 105340,
      "end_ms": 106900,
      "text": "可箱子运回北京。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 106900,
      "end_ms": 111115,
      "text": "一揭开老专家们眼泪当场就掉下来，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 111560,
      "end_ms": 114180,
      "text": "整幅画被蛀虫啃成了蜂窝煤，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 114320,
      "end_ms": 117435,
      "text": "牛身上到处是大大小小的窟窿眼，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 118240,
      "end_ms": 119635,
      "text": "要是您看着心疼，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 120010,
      "end_ms": 120930,
      "text": "劳烦点个赞，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 121050,
      "end_ms": 122430,
      "text": "给老国宝提提气。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 123290,
      "end_ms": 125490,
      "text": "故宫顶尖的装裱大将，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 125910,
      "end_ms": 128050,
      "text": "硬是屏着呼吸一针，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 128069,
      "end_ms": 129370,
      "text": "一缕一个洞，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 129450,
      "end_ms": 131590,
      "text": "一个洞的补了整整八个月，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 132430,
      "end_ms": 135650,
      "text": "您才让老祖宗的牛重新活过来。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 136510,
      "end_ms": 138470,
      "text": "如今他深藏大内，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 139390,
      "end_ms": 139970,
      "text": "几年，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 140090,
      "end_ms": 141230,
      "text": "难得一露面，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 142090,
      "end_ms": 145590,
      "text": "一张老只能历经浩劫起死回生。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 146170,
      "end_ms": 148110,
      "text": "您说这是不是造化弄生？"
    },
    {
      "segment_id": "s000059",
      "start_ms": 149010,
      "end_ms": 151080,
      "text": "这还只是是第五名，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 151460,
      "end_ms": 154860,
      "text": "第四名一亮相就更邪乎了。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 154860,
      "end_ms": 156520,
      "text": "北宋汝窑天青釉，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 156600,
      "end_ms": 161060,
      "text": "大家都以为皇宫里的宝贝非金祭银雕龙画凤，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 161780,
      "end_ms": 165260,
      "text": "可这件瓷器全身光溜溜，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 165500,
      "end_ms": 168180,
      "text": "连一朵花一条纹路都不化，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 168860,
      "end_ms": 172180,
      "text": "却稳坐宋代五大官窑的头把交椅。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 172740,
      "end_ms": 176140,
      "text": "古人管它那个颜色叫雨过天晴，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 176140,
      "end_ms": 179555,
      "text": "云破处天上下完暴雨，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 179970,
      "end_ms": 181330,
      "text": "乌云刚刚裂开，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 181330,
      "end_ms": 183070,
      "text": "一条缝透出来。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 183070,
      "end_ms": 190230,
      "text": "那一汪水灵灵的青天就是它传说当年烧灶，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 190670,
      "end_ms": 191790,
      "text": "窑工狠心，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 191890,
      "end_ms": 194670,
      "text": "把价值连城的玛瑙磨成粉末，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 194870,
      "end_ms": 195870,
      "text": "倒进了釉里。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 196590,
      "end_ms": 199390,
      "text": "可老天爷像是嫉妒这门手艺，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 199470,
      "end_ms": 202270,
      "text": "汝窑统共就烧了二十来年，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 202610,
      "end_ms": 206570,
      "text": "金兵南下一破汴梁窑火瞬间熄灭，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 206850,
      "end_ms": 209745,
      "text": "这门秘方就此在人间彻底失传。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 210520,
      "end_ms": 212180,
      "text": "如今一千年过去了，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 212420,
      "end_ms": 215900,
      "text": "普天之下存下来的珍品连一百件都不到。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 216340,
      "end_ms": 219180,
      "text": "故宫有幸收藏了不到二十件。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 220000,
      "end_ms": 222600,
      "text": "后世多少朝代的皇帝想仿造，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 223160,
      "end_ms": 225360,
      "text": "连乾隆爷砸进国库，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 225580,
      "end_ms": 227340,
      "text": "都仿不出那一抹天青。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 228360,
      "end_ms": 233440,
      "text": "在故宫陶瓷馆里摆着一个不算大的天青釉三足尊，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 233860,
      "end_ms": 236260,
      "text": "就那么安安静静呆在玻璃罩。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 236360,
      "end_ms": 238760,
      "text": "懂行的老先生走到他跟前，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 239400,
      "end_ms": 241885,
      "text": "两条腿就像被盯住了一样，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 242310,
      "end_ms": 243265,
      "text": "挪都挪不动，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 243720,
      "end_ms": 248820,
      "text": "就凭一抹颜色让全天下的匠人苦苦追赶，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 248880,
      "end_ms": 250115,
      "text": "参悟了一千年，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 250860,
      "end_ms": 252945,
      "text": "这得是多通天的造诣。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 253870,
      "end_ms": 255335,
      "text": "要是这还不够震颤，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 256260,
      "end_ms": 258740,
      "text": "排第三名的这尊神物，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 258920,
      "end_ms": 261420,
      "text": "光是重量就能把人吓一跳。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 261460,
      "end_ms": 266665,
      "text": "大禹治水图玉山乾隆爷当年的手笔有多大？"
    },
    {
      "segment_id": "s000096",
      "start_ms": 267090,
      "end_ms": 268625,
      "text": "他不是雕一件玉器，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 269200,
      "end_ms": 273480,
      "text": "他是把西域的一整座玉石大山给搬进了北京城。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 273740,
      "end_ms": 279095,
      "text": "整块和田青白玉高两米二重达五吨多，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 279790,
      "end_ms": 282595,
      "text": "换算成斤两就是一万多斤不。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 283190,
      "end_ms": 284930,
      "text": "玉山上密密麻麻，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 284950,
      "end_ms": 286235,
      "text": "雕着几百号人，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 286950,
      "end_ms": 287790,
      "text": "跟着大雨，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 287890,
      "end_ms": 289125,
      "text": "劈山倒水，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 289570,
      "end_ms": 291415,
      "text": "抡巨锤的肌肉紧绷，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 291820,
      "end_ms": 293655,
      "text": "推巨石的咬牙切齿，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 294040,
      "end_ms": 295740,
      "text": "更有绳子绑在腰上，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 295780,
      "end_ms": 299165,
      "text": "悬在悬崖峭壁半空凿石头的。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 300140,
      "end_ms": 302240,
      "text": "但您知道最吓人的是什么吗？"
    },
    {
      "segment_id": "s000109",
      "start_ms": 302540,
      "end_ms": 306860,
      "text": "这块巨石埋在新疆和田雪山万仞绝壁之上，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 307620,
      "end_ms": 310240,
      "text": "当年光是往北京运就走了。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 310240,
      "end_ms": 311400,
      "text": "整整三年多。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 312320,
      "end_ms": 315060,
      "text": "几百匹骏马在前面拉盛夏，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 315100,
      "end_ms": 316120,
      "text": "酷暑走不了，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 316500,
      "end_ms": 319240,
      "text": "偏得等三九寒天往路上泼水。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 319320,
      "end_ms": 319720,
      "text": "结冰，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 320320,
      "end_ms": 323840,
      "text": "靠着一条万里冰道一点一点划进。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 323860,
      "end_ms": 326420,
      "text": "关内运到紫禁城后，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 326760,
      "end_ms": 329715,
      "text": "乾隆爷按宋朝古画钦定画稿，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 330130,
      "end_ms": 332550,
      "text": "又千里迢迢转运扬州，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 332970,
      "end_ms": 335670,
      "text": "召集天下最顶级的玉匠，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 336030,
      "end_ms": 337710,
      "text": "日夜雕琢了六年，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 338630,
      "end_ms": 341050,
      "text": "前前后后折腾了十来年，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 341550,
      "end_ms": 343870,
      "text": "才终于大功告成。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 344950,
      "end_ms": 349010,
      "text": "自从摆进明寿宫乐寿堂整整两百多年，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 349290,
      "end_ms": 351230,
      "text": "谁都没挪动过他半寸，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 352070,
      "end_ms": 354810,
      "text": "为什么根本没人抬得动，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 354990,
      "end_ms": 356910,
      "text": "也没人担得起这个闪失。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 357090,
      "end_ms": 359940,
      "text": "一整块山石万里跋山，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 359980,
      "end_ms": 362155,
      "text": "发设十年刀斧，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 362970,
      "end_ms": 363910,
      "text": "这等气魄，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 363950,
      "end_ms": 365395,
      "text": "除了咱们老祖宗，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 365970,
      "end_ms": 368195,
      "text": "天下还有谁能办得到？"
    },
    {
      "segment_id": "s000133",
      "start_ms": 369920,
      "end_ms": 371535,
      "text": "您先别急着咂舌，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 372670,
      "end_ms": 376990,
      "text": "排第二名的这位反转大到让人脊背发凉。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 377050,
      "end_ms": 381245,
      "text": "北宋王羲孟的千里江山图按常理讲，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 381640,
      "end_ms": 384385,
      "text": "能画出这种震古烁金长卷，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 385190,
      "end_ms": 388295,
      "text": "怎么也得是个白发苍苍的画坛泰斗啊，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 388730,
      "end_ms": 389675,
      "text": "大错特错。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 390110,
      "end_ms": 393455,
      "text": "画这幅画的孩子当年只有十八岁，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 393950,
      "end_ms": 394755,
      "text": "你没听错，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 395140,
      "end_ms": 396165,
      "text": "真真切切，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 396440,
      "end_ms": 398320,
      "text": "就只是个十八岁的少年了。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 398400,
      "end_ms": 402025,
      "text": "他拿出一批将近十二米长的整幅升卷，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 402380,
      "end_ms": 403565,
      "text": "挥毫泼墨，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 404050,
      "end_ms": 407335,
      "text": "把大宋的如画江山全装了进去。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 408220,
      "end_ms": 409380,
      "text": "层峦叠嶂，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 409540,
      "end_ms": 410620,
      "text": "烟波浩渺，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 410840,
      "end_ms": 416855,
      "text": "水村茅舍飞桥游人笔法密得连风都穿不过去。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 417370,
      "end_ms": 423555,
      "text": "画上的颜色全是用昂贵的孔雀石蓝铜矿磨成细粉敷上去，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 424060,
      "end_ms": 426155,
      "text": "哪怕九百年光阴冲刷，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 426490,
      "end_ms": 428850,
      "text": "那些青翠之色依然鲜艳的，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 428850,
      "end_ms": 430365,
      "text": "像昨天刚画好一样，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 430830,
      "end_ms": 432165,
      "text": "可老天爷太残酷。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 433220,
      "end_ms": 434885,
      "text": "画完这卷画没几年，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 435660,
      "end_ms": 436700,
      "text": "少年刚过，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 436820,
      "end_ms": 438880,
      "text": "弱冠之年就撒手人寰，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 439000,
      "end_ms": 442255,
      "text": "短短一生就给世间留下了这么一幅独妙。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 443310,
      "end_ms": 447025,
      "text": "更让人揪心的是因为矿物颜料实在太厚。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 447720,
      "end_ms": 450300,
      "text": "这幅画展出一回就剥落，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 450300,
      "end_ms": 450700,
      "text": "一层，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 450920,
      "end_ms": 453180,
      "text": "斩一次就得锁进库房，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 453200,
      "end_ms": 454175,
      "text": "静养好几年。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 454670,
      "end_ms": 455650,
      "text": "二零一七年，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 455650,
      "end_ms": 458770,
      "text": "故宫好不容易展出一次宫门，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 458830,
      "end_ms": 461585,
      "text": "刚开几千号人撒腿狂奔，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 462110,
      "end_ms": 463010,
      "text": "鞋跑掉了，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 463010,
      "end_ms": 463805,
      "text": "都顾不上一件，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 464270,
      "end_ms": 466625,
      "text": "就为隔着玻璃看了少年一眼。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 467220,
      "end_ms": 474685,
      "text": "一个十八岁的孩子凭一己之力压倒了后头九百年所有的青绿山水，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 475080,
      "end_ms": 476880,
      "text": "可惜英雄短命，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 477040,
      "end_ms": 478725,
      "text": "让人怎能不叹息？"
    },
    {
      "segment_id": "s000172",
      "start_ms": 479520,
      "end_ms": 481400,
      "text": "那第一名到底是哪件？"
    },
    {
      "segment_id": "s000173",
      "start_ms": 482240,
      "end_ms": 483000,
      "text": "先别急，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 483300,
      "end_ms": 483920,
      "text": "聊到这儿，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 483920,
      "end_ms": 485140,
      "text": "我跟您说点别的。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 486160,
      "end_ms": 487040,
      "text": "讲到这儿，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 487240,
      "end_ms": 488180,
      "text": "九剑呢，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 488360,
      "end_ms": 491500,
      "text": "您发现没有？"
    },
    {
      "segment_id": "s000179",
      "start_ms": 491500,
      "end_ms": 492440,
      "text": "这九件宝贝，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 492860,
      "end_ms": 497360,
      "text": "哪一件是安安稳稳在宫里待着的象牙旗的首一段呢？"
    },
    {
      "segment_id": "s000181",
      "start_ms": 498140,
      "end_ms": 501240,
      "text": "五牛图被虫啃成筛子，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 501720,
      "end_ms": 505440,
      "text": "三联印缝在棉衣里颠簸了二十六年。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 506740,
      "end_ms": 508240,
      "text": "他们能留到今天，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 508740,
      "end_ms": 510640,
      "text": "靠的是一代一代人，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 511000,
      "end_ms": 512260,
      "text": "有花钱买的，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 512440,
      "end_ms": 514000,
      "text": "有一针一针补的，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 514180,
      "end_ms": 515360,
      "text": "有拿命护的。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 516120,
      "end_ms": 517520,
      "text": "可您再往深想，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 517620,
      "end_ms": 519220,
      "text": "一层东西是守住了，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 519220,
      "end_ms": 521030,
      "text": "咱们老百姓真见过几件吗？"
    },
    {
      "segment_id": "s000191",
      "start_ms": 521130,
      "end_ms": 523590,
      "text": "母牛图几年不露一回，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 524030,
      "end_ms": 527710,
      "text": "千里江山徒展一次歇好几年。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 528070,
      "end_ms": 529510,
      "text": "待会儿要讲的第一名，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 529610,
      "end_ms": 531430,
      "text": "一辈子能排上一回队，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 531850,
      "end_ms": 533930,
      "text": "就算有福气守下来了，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 534190,
      "end_ms": 535490,
      "text": "锁进库房了。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 535790,
      "end_ms": 536450,
      "text": "然后呢，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 536570,
      "end_ms": 540625,
      "text": "大多数人一辈子就在课本上见过个小方块，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 541350,
      "end_ms": 543305,
      "text": "您说这算不算令人看不见？"
    },
    {
      "segment_id": "s000200",
      "start_ms": 543740,
      "end_ms": 546635,
      "text": "所以今天我想跟各位老朋友说一样东西。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 547140,
      "end_ms": 553015,
      "text": "二零二七年的故宫日历书画版这本日历有来历，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 553370,
      "end_ms": 556475,
      "text": "头一回出是一九三三年什么年头？"
    },
    {
      "segment_id": "s000203",
      "start_ms": 556800,
      "end_ms": 561705,
      "text": "日本人刚占的东北故宫的文物正装箱子往南运，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 562520,
      "end_ms": 564005,
      "text": "国家都快保不住了。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 564800,
      "end_ms": 567155,
      "text": "故宫还是一年印一本日历，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 567930,
      "end_ms": 570930,
      "text": "一天一幅宫里的书画那会儿，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 570930,
      "end_ms": 571530,
      "text": "没电视，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 571610,
      "end_ms": 572285,
      "text": "没展览，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 572620,
      "end_ms": 574520,
      "text": "老百姓想看一眼宫里的画，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 574680,
      "end_ms": 575395,
      "text": "就靠他。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 576270,
      "end_ms": 577650,
      "text": "后来仗打大了，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 577670,
      "end_ms": 578650,
      "text": "停了几十年，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 578930,
      "end_ms": 580065,
      "text": "好在又接上了，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 580690,
      "end_ms": 582415,
      "text": "到今年连着出了十八年，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 582750,
      "end_ms": 584335,
      "text": "卖了一千多万本。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 584680,
      "end_ms": 590980,
      "text": "故宫出版社出的陈丽华主编可以认准这个明年是丁未羊年这本书。"
    },
    {
      "segment_id": "s000217",
      "start_ms": 590980,
      "end_ms": 594155,
      "text": "画板从故宫藏画里挑了三百多幅，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 594570,
      "end_ms": 601055,
      "text": "分四个篇章、诗意山水、文人花鸟、宫廷、山水、宫廷人物。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 601390,
      "end_ms": 604050,
      "text": "文人画和宫廷画搁以一块对着看你，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 604050,
      "end_ms": 606830,
      "text": "一天一翻一页。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 606870,
      "end_ms": 607610,
      "text": "一年下来，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 607850,
      "end_ms": 610410,
      "text": "中国画是怎么一路走过来的，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 610790,
      "end_ms": 612030,
      "text": "心里就有数了。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 612830,
      "end_ms": 615670,
      "text": "底下几行字把来龙去脉说清楚，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 616330,
      "end_ms": 617110,
      "text": "字够大，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 617690,
      "end_ms": 618610,
      "text": "不用眯眼，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 619470,
      "end_ms": 620630,
      "text": "他还有个巧思，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 621110,
      "end_ms": 622310,
      "text": "春夏秋冬，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 622350,
      "end_ms": 624630,
      "text": "四季用的是四种老颜色，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 625050,
      "end_ms": 629130,
      "text": "海棠红、鸭头、绿秋香色鸭圣紫纸立，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 629130,
      "end_ms": 629930,
      "text": "还藏着味儿。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 629930,
      "end_ms": 631680,
      "text": "春天是夏香草，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 632000,
      "end_ms": 633100,
      "text": "夏天是西瓜，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 633540,
      "end_ms": 634660,
      "text": "秋天是葡萄，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 634980,
      "end_ms": 636160,
      "text": "冬天是檀香。"
    },
    {
      "segment_id": "s000236",
      "start_ms": 636700,
      "end_ms": 637780,
      "text": "翻到那一页，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 638120,
      "end_ms": 639680,
      "text": "香味自己飘出来。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 640400,
      "end_ms": 643700,
      "text": "您说一本日历能看能闻能当画册，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 643700,
      "end_ms": 644660,
      "text": "放茶几上，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 645200,
      "end_ms": 647060,
      "text": "这像一个小型书画展。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 647600,
      "end_ms": 651300,
      "text": "我这个链接的套装里还配的手工盖章和书签。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 652160,
      "end_ms": 653100,
      "text": "这些赠品，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 653140,
      "end_ms": 655660,
      "text": "具体您点左下角小黄车看看，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 656360,
      "end_ms": 658060,
      "text": "您想想排队几个钟头，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 658580,
      "end_ms": 659520,
      "text": "看几分钟的话，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 659520,
      "end_ms": 661425,
      "text": "摆您床头一天一副不？"
    },
    {
      "segment_id": "s000247",
      "start_ms": 661650,
      "end_ms": 664840,
      "text": "一年三百多副自己翻是个念想，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 664880,
      "end_ms": 667370,
      "text": "孙子孙女藩是个根国宝，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 667410,
      "end_ms": 668105,
      "text": "手下来了，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 668420,
      "end_ms": 669720,
      "text": "总得有人接着看。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 669760,
      "end_ms": 670295,
      "text": "接着讲，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 670560,
      "end_ms": 671495,
      "text": "点进去看看，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 672000,
      "end_ms": 674140,
      "text": "别等年根底下受完了，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 674140,
      "end_ms": 675985,
      "text": "再找日历的事先放一放。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 676640,
      "end_ms": 677480,
      "text": "听完第一名，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 677620,
      "end_ms": 682720,
      "text": "您就明白为什么这些话一天都不该从咱们眼前断好说。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 682720,
      "end_ms": 683395,
      "text": "回正题，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 684220,
      "end_ms": 685160,
      "text": "力压群雄，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 685220,
      "end_ms": 686045,
      "text": "排在第一名，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 686300,
      "end_ms": 689280,
      "text": "被十四亿人刻在骨子里的瑰宝。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 689280,
      "end_ms": 691645,
      "text": "北宋张择端的清明上河图，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 692080,
      "end_ms": 692580,
      "text": "五米，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 692640,
      "end_ms": 694015,
      "text": "二十八的长卷，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 695070,
      "end_ms": 696310,
      "text": "二十四厘米宽，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 696430,
      "end_ms": 698365,
      "text": "看似不过一尺见方，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 698780,
      "end_ms": 705905,
      "text": "却把整整九百年前汴梁东京城的一天全给活生生冻结在了绢帛上。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 706510,
      "end_ms": 711215,
      "text": "画面里整整挤了八百二十多个有名有姓般的人物，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 711710,
      "end_ms": 713515,
      "text": "挑扁担擦汗的脚夫，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 714050,
      "end_ms": 718245,
      "text": "赶着毛驴的小贩、路边摆摊摸骨的神算子。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 718950,
      "end_ms": 727055,
      "text": "酒楼里划拳行令的酒客桥头平栏看热闹的百姓八百多张面孔，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 727470,
      "end_ms": 729685,
      "text": "每一个神态举止都不一样，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 730500,
      "end_ms": 732320,
      "text": "拿放大镜贴上去，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 732320,
      "end_ms": 736040,
      "text": "端详曹船接缝处的小铁钉酒家，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 736060,
      "end_ms": 738695,
      "text": "挑着的昭皇晃条上的字迹，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 739280,
      "end_ms": 740260,
      "text": "丝丝缕缕，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 740360,
      "end_ms": 753010,
      "text": "毫发碧显整幅画最让人屏住呼吸的反转高潮就是那座木结构的辩河虹桥一艘满载池水极深的大木船，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 753070,
      "end_ms": 754695,
      "text": "顺江急飘而下，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 755310,
      "end_ms": 757515,
      "text": "偏偏桅杆放倒慢了半拍，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 757970,
      "end_ms": 760290,
      "text": "眼瞅着就要轰然撞毁。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 760350,
      "end_ms": 762850,
      "text": "在桥洞上船头上，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 762850,
      "end_ms": 764350,
      "text": "汉子们青筋抱起，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 764390,
      "end_ms": 767150,
      "text": "拼命称高桥梁上两旁百姓，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 767190,
      "end_ms": 768490,
      "text": "吓得探出半个身子，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 768490,
      "end_ms": 769270,
      "text": "大喊大叫，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 769270,
      "end_ms": 770075,
      "text": "挥舞手臂。"
    },
    {
      "segment_id": "s000286",
      "start_ms": 770610,
      "end_ms": 772090,
      "text": "您站在这话前，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 772290,
      "end_ms": 773130,
      "text": "隔着绢步，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 773130,
      "end_ms": 778230,
      "text": "都能听见那震耳欲聋的呼救与江水拍击声一人一笔，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 778570,
      "end_ms": 783185,
      "text": "硬生生把一座王朝最繁华的喧闹给留到了今天。"
    },
    {
      "segment_id": "s000290",
      "start_ms": 784050,
      "end_ms": 786875,
      "text": "可您知道他这九百年是怎么活下来的吗？"
    },
    {
      "segment_id": "s000291",
      "start_ms": 787160,
      "end_ms": 791210,
      "text": "他过的日子比哪件国宝都惊心动魄。"
    },
    {
      "segment_id": "s000292",
      "start_ms": 791730,
      "end_ms": 792350,
      "text": "历史上，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 792590,
      "end_ms": 794190,
      "text": "五次被迎进深宫，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 794470,
      "end_ms": 796685,
      "text": "四次被盗贼流落江湖，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 797120,
      "end_ms": 800525,
      "text": "最后一次差点彻底从地球上消失。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 801220,
      "end_ms": 802120,
      "text": "一九二二年，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 802140,
      "end_ms": 804145,
      "text": "溥仪被赶出皇宫前夕，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 804660,
      "end_ms": 807085,
      "text": "借着赏赐弟弟溥杰的名义，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 807500,
      "end_ms": 809255,
      "text": "把他偷偷裹带出宫，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 809690,
      "end_ms": 811985,
      "text": "一路辗转天津租界，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 812580,
      "end_ms": 814860,
      "text": "藏进了长春伪满皇宫。"
    },
    {
      "segment_id": "s000302",
      "start_ms": 815040,
      "end_ms": 816040,
      "text": "一九四五年，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 816060,
      "end_ms": 818530,
      "text": "日本战败投降伪皇宫，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 818590,
      "end_ms": 819410,
      "text": "乱作一团，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 819730,
      "end_ms": 821375,
      "text": "守军哄抢珍宝。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 821760,
      "end_ms": 824115,
      "text": "这卷绳座顿时不知所踪。"
    },
    {
      "segment_id": "s000307",
      "start_ms": 824880,
      "end_ms": 826185,
      "text": "到了一九五零年，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 826580,
      "end_ms": 834550,
      "text": "东北博物馆的杨仁凯先生清理民间收缴回来的杂物字画在一堆被当成粗劣赝品，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 834710,
      "end_ms": 838910,
      "text": "差点要当破烂处理的旧化堆里缓缓展开。"
    },
    {
      "segment_id": "s000310",
      "start_ms": 838950,
      "end_ms": 840330,
      "text": "一轴残破的画卷。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 840330,
      "end_ms": 842115,
      "text": "老先生定睛一看，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 842550,
      "end_ms": 844175,
      "text": "整个人当场僵住，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 844580,
      "end_ms": 846235,
      "text": "双手抖得不成样子，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 846660,
      "end_ms": 852300,
      "text": "大伙都以为早已在战火硝烟里烧成灰烬的张择端真迹，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 852340,
      "end_ms": 855335,
      "text": "居然就这么静静躺在废纸堆里。"
    },
    {
      "segment_id": "s000316",
      "start_ms": 855880,
      "end_ms": 856820,
      "text": "一九五三年，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 856820,
      "end_ms": 858120,
      "text": "他终于风风光光，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 858160,
      "end_ms": 859115,
      "text": "重回紫禁城。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 859680,
      "end_ms": 860640,
      "text": "二零一五年，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 860660,
      "end_ms": 874205,
      "text": "故宫难得展出一次全中国的书画爱好者排队长达六个钟头大门一开几千人撒腿飞奔故宫跑这个词就是这么来的，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 875000,
      "end_ms": 877145,
      "text": "您在民间见到的无数版本，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 877570,
      "end_ms": 879475,
      "text": "全都是后人的房本，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 880410,
      "end_ms": 882265,
      "text": "世间真正的真迹。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 882750,
      "end_ms": 885085,
      "text": "九百年仅此一卷，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 885990,
      "end_ms": 888705,
      "text": "他凭什么当之无愧排榜首？"
    },
    {
      "segment_id": "s000326",
      "start_ms": 890030,
      "end_ms": 890490,
      "text": "第一，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 890510,
      "end_ms": 892225,
      "text": "记忆登峰造极，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 892610,
      "end_ms": 894155,
      "text": "八百多人无一雷同，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 894580,
      "end_ms": 897895,
      "text": "后世九百年无人能临摹出其神韵。"
    },
    {
      "segment_id": "s000330",
      "start_ms": 898390,
      "end_ms": 898790,
      "text": "第二，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 899210,
      "end_ms": 901905,
      "text": "历尽人间浩劫武尽思出，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 902370,
      "end_ms": 904290,
      "text": "最后从垃圾堆里死里逃生，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 904290,
      "end_ms": 905275,
      "text": "捡回一条命。"
    },
    {
      "segment_id": "s000334",
      "start_ms": 906040,
      "end_ms": 906435,
      "text": "第三。"
    },
    {
      "segment_id": "s000335",
      "start_ms": 906750,
      "end_ms": 908210,
      "text": "承载民族记忆，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 908670,
      "end_ms": 910330,
      "text": "天下无人不知，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 910330,
      "end_ms": 912770,
      "text": "其名却九成人无缘。"
    },
    {
      "segment_id": "s000338",
      "start_ms": 912930,
      "end_ms": 916710,
      "text": "亲眼得见一座九百年前的繁华梦，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 916850,
      "end_ms": 918030,
      "text": "全凭他活着，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 918150,
      "end_ms": 920790,
      "text": "这才是真正的巧夺天工。"
    },
    {
      "segment_id": "s000341",
      "start_ms": 921330,
      "end_ms": 922809,
      "text": "从第五道第一名，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 923290,
      "end_ms": 927070,
      "text": "无牛图被从垦成筛子又捕回来。"
    },
    {
      "segment_id": "s000343",
      "start_ms": 927090,
      "end_ms": 929690,
      "text": "汝窑一个颜色让人追了一千年，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 930390,
      "end_ms": 931970,
      "text": "遇山走了万里路，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 932490,
      "end_ms": 935510,
      "text": "雕了十年千里江山图。"
    },
    {
      "segment_id": "s000346",
      "start_ms": 936170,
      "end_ms": 938520,
      "text": "一这十八岁的孩子画完就走了，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 939280,
      "end_ms": 942720,
      "text": "清明上河图五进四出在仓库里捡回来。"
    },
    {
      "segment_id": "s000348",
      "start_ms": 943220,
      "end_ms": 945160,
      "text": "这十件有的是手艺断了，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 945360,
      "end_ms": 946540,
      "text": "有的是人没了，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 946640,
      "end_ms": 947980,
      "text": "有的是差点丢了，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 948620,
      "end_ms": 953720,
      "text": "可他们都还在在故宫在咱们自己手里。"
    },
    {
      "segment_id": "s000352",
      "start_ms": 953940,
      "end_ms": 955820,
      "text": "老祖宗的手艺留下来了，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 956200,
      "end_ms": 957300,
      "text": "就得有人接着看。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 958380,
      "end_ms": 961080,
      "text": "最后问问你这十件宝贝，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 962020,
      "end_ms": 963660,
      "text": "您亲眼见过几件，"
    },
    {
      "segment_id": "s000356",
      "start_ms": 964740,
      "end_ms": 967070,
      "text": "最想亲眼看看哪哪一件？"
    },
    {
      "segment_id": "s000357",
      "start_ms": 967210,
      "end_ms": 968285,
      "text": "评论区告诉我，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 968840,
      "end_ms": 973315,
      "text": "刚才说的故宫日历、书画板橱筐和小黄车都有，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 973680,
      "end_ms": 976020,
      "text": "喜欢看画看宝贝的朋友别错过，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 976440,
      "end_ms": 978005,
      "text": "觉得这期涨知识了。"
    },
    {
      "segment_id": "s000361",
      "start_ms": 978280,
      "end_ms": 978885,
      "text": "点个赞，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 979310,
      "end_ms": 980065,
      "text": "点一个收藏，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 981880,
      "end_ms": 983020,
      "text": "想看更多老故事，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 983020,
      "end_ms": 983700,
      "text": "点个关注，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 983820,
      "end_ms": 985395,
      "text": "咱们下回接着聊。"
    }
