{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_2306120bb0b29be4_u001",
  "video_id": "v_2306120bb0b29be4",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 858.327007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 370,
      "end_ms": 3050,
      "text": "十四分钟讲解曼昆经济学原理有一本书，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3330,
      "end_ms": 5090,
      "text": "全球销量突破一百万册，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5370,
      "end_ms": 6890,
      "text": "被译成二十余种语言，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7030,
      "end_ms": 9810,
      "text": "被哈佛、耶鲁等六百余所大学用作教材，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 10130,
      "end_ms": 13590,
      "text": "却在中文世界的经济学书单里争议从未断过，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 13690,
      "end_ms": 14650,
      "text": "不是因为它不好，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 15190,
      "end_ms": 16690,
      "text": "而是因为他太危险。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17250,
      "end_ms": 18010,
      "text": "危险到会，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 18010,
      "end_ms": 24410,
      "text": "让你过去二三十年信奉的那套关于金钱、工作和人生的认知发生一场七级地震，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 24790,
      "end_ms": 26510,
      "text": "这本书叫经济学原理。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 27090,
      "end_ms": 27530,
      "text": "作者，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 27550,
      "end_ms": 28490,
      "text": "格里高利曼昆，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 28930,
      "end_ms": 29955,
      "text": "一九五八年出生，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 30300,
      "end_ms": 31440,
      "text": "乌克兰移民后代，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 31620,
      "end_ms": 32760,
      "text": "父母都没上过大学，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 32940,
      "end_ms": 33600,
      "text": "二十六岁，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 33600,
      "end_ms": 36300,
      "text": "获麻省理工经济学博士二十九岁，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 36320,
      "end_ms": 39940,
      "text": "成为哈佛大学历史上最年轻的经济学终身教授之一。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 40220,
      "end_ms": 41020,
      "text": "一九九五年，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 41240,
      "end_ms": 45740,
      "text": "一家出版社以一百四十万美元公开招标一本通俗经济学读物，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 46100,
      "end_ms": 48800,
      "text": "当时名牌大学教授年薪不过八万美元，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 49060,
      "end_ms": 50360,
      "text": "曼昆中标稿费，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 50380,
      "end_ms": 52040,
      "text": "最终加到两百五十万美元。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 52440,
      "end_ms": 53280,
      "text": "一九九八年，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 53300,
      "end_ms": 55260,
      "text": "该书首版出印二十万册，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 55420,
      "end_ms": 58020,
      "text": "曼昆凭借一本书赚了四千两百万美元。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 58340,
      "end_ms": 59460,
      "text": "后来因为卖的太好，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 59460,
      "end_ms": 60450,
      "text": "引发学生不满，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 60690,
      "end_ms": 62645,
      "text": "不得不把版税全部捐出去。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 62880,
      "end_ms": 63505,
      "text": "离谱的是，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 63870,
      "end_ms": 67055,
      "text": "这本席卷全球的教科书遭遇的远不止赞美，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 67620,
      "end_ms": 68840,
      "text": "被指立场偏颇，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 69140,
      "end_ms": 70420,
      "text": "被批回避危机，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 70660,
      "end_ms": 72615,
      "text": "被学生集体退课抗议。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 73470,
      "end_ms": 74430,
      "text": "人们宁可相信，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 74430,
      "end_ms": 76605,
      "text": "这是一本被高估的入门读物，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 76960,
      "end_ms": 78745,
      "text": "也不愿面对一个可怕的真相。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 79450,
      "end_ms": 81050,
      "text": "你在这个世界上赚不到钱，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 81230,
      "end_ms": 82170,
      "text": "做不对决策，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 82350,
      "end_ms": 83345,
      "text": "看不清趋势，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 83730,
      "end_ms": 85265,
      "text": "不是输带智商或运气，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 85560,
      "end_ms": 87520,
      "text": "是你对经济这两个字的认知，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 87520,
      "end_ms": 88760,
      "text": "从根儿上就错了。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 88760,
      "end_ms": 89600,
      "text": "今天这篇文字，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 89660,
      "end_ms": 92500,
      "text": "我会拆出这本书里最颠覆的六个底层认知。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 92600,
      "end_ms": 93460,
      "text": "但我提前警告，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 93460,
      "end_ms": 94710,
      "text": "你看完后，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 94770,
      "end_ms": 98905,
      "text": "你可能会推翻过去二十年、三十年奉为归孽的人生信条。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 99330,
      "end_ms": 100610,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 100890,
      "end_ms": 102045,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 102890,
      "end_ms": 104005,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 104390,
      "end_ms": 105595,
      "text": "那我们开始进入正题，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 105850,
      "end_ms": 110570,
      "text": "第一层颠覆你做的每一个选择都在杀死另一种可能性。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 110610,
      "end_ms": 111755,
      "text": "你有没有听过这句话，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 112200,
      "end_ms": 113480,
      "text": "先别想那么多干了。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 113480,
      "end_ms": 113840,
      "text": "再说。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 113960,
      "end_ms": 116660,
      "text": "经济学原理开篇第一句话就判了这套观念。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 116660,
      "end_ms": 118355,
      "text": "死刑曼坤说，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 118710,
      "end_ms": 120290,
      "text": "人们面临权衡取舍，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 120350,
      "end_ms": 121595,
      "text": "你以为这句话谁不知道？"
    },
    {
      "segment_id": "s000061",
      "start_ms": 121850,
      "end_ms": 124645,
      "text": "但曼昆问了一个让所有人哑口无言的问题。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 125160,
      "end_ms": 127095,
      "text": "你参加期中考试前一夜去聚会，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 127410,
      "end_ms": 129515,
      "text": "你失去的仅仅是一晚复习时间吗？"
    },
    {
      "segment_id": "s000064",
      "start_ms": 129780,
      "end_ms": 130780,
      "text": "你选择读大学，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 130780,
      "end_ms": 131875,
      "text": "而不是直接工作。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 132170,
      "end_ms": 134115,
      "text": "你放弃的仅仅是四年工资吗？"
    },
    {
      "segment_id": "s000067",
      "start_ms": 134520,
      "end_ms": 135560,
      "text": "你选择买一辆车，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 135600,
      "end_ms": 136600,
      "text": "而不是投资理财。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 136980,
      "end_ms": 139335,
      "text": "你亏的仅仅是那笔购车款吗？"
    },
    {
      "segment_id": "s000070",
      "start_ms": 139810,
      "end_ms": 140430,
      "text": "曼昆说，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 140710,
      "end_ms": 142935,
      "text": "都不是你失去的，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 143160,
      "end_ms": 146785,
      "text": "是被你放弃的那个选项中价值最高的那一个。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 147190,
      "end_ms": 150075,
      "text": "他给这个东西取了个名字叫机会成本。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 150630,
      "end_ms": 151885,
      "text": "这听上去像废话，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 152710,
      "end_ms": 154305,
      "text": "但请你停下来想三秒。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 154990,
      "end_ms": 156735,
      "text": "你上一次做重大决策时，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 157100,
      "end_ms": 160925,
      "text": "认认真真计算过被放弃的那个选项值多少钱吗？"
    },
    {
      "segment_id": "s000078",
      "start_ms": 161600,
      "end_ms": 164430,
      "text": "绝大多数人没有绝大多数人做决策，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 164430,
      "end_ms": 165795,
      "text": "只看我要什么，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 166020,
      "end_ms": 167955,
      "text": "从来不看我烧掉了什么。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 168510,
      "end_ms": 170235,
      "text": "而经济学冷酷的告诉你，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 170540,
      "end_ms": 174265,
      "text": "你做的每一个选择都在杀死另一种可能性。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 174860,
      "end_ms": 177000,
      "text": "你选择留在一段消耗你的关系里，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 177100,
      "end_ms": 179795,
      "text": "你烧掉的是重新开始的资格。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 180470,
      "end_ms": 182455,
      "text": "你选择把时间刷在短视频上，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 182740,
      "end_ms": 185895,
      "text": "你烧掉的是十年后那个更值钱的自己。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 186570,
      "end_ms": 187650,
      "text": "你选择一份安稳，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 187650,
      "end_ms": 188890,
      "text": "但毫无成长的工作，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 189090,
      "end_ms": 192325,
      "text": "你烧掉的是未来所有的可能性溢价。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 192730,
      "end_ms": 193310,
      "text": "曼昆说，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 193370,
      "end_ms": 194475,
      "text": "这不是贩卖焦虑，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 194850,
      "end_ms": 196485,
      "text": "这是稀缺性的铁律。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 196880,
      "end_ms": 197660,
      "text": "资源有限，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 198000,
      "end_ms": 198875,
      "text": "欲望无限，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 199300,
      "end_ms": 201015,
      "text": "你永远不可能拥有一切。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 201790,
      "end_ms": 204785,
      "text": "承认取舍是成年人理性的起点。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 205260,
      "end_ms": 207000,
      "text": "那些告诉你全都要的人，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 207100,
      "end_ms": 209084,
      "text": "不是在安慰你是在骗你。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 209460,
      "end_ms": 212040,
      "text": "第二层颠覆成本不是钱，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 212400,
      "end_ms": 214375,
      "text": "是你再也回不去的那个路口。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 214790,
      "end_ms": 217415,
      "text": "我们这代人从小被灌输算账嘛，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 217740,
      "end_ms": 219525,
      "text": "花了多少钱就是多少成本。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 219890,
      "end_ms": 221315,
      "text": "所以当一笔投资亏了，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 221620,
      "end_ms": 222545,
      "text": "你说亏了十万，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 223110,
      "end_ms": 224325,
      "text": "读了个没用的学位，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 224660,
      "end_ms": 227590,
      "text": "你说浪费了几年时间选错了行业，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 227850,
      "end_ms": 229195,
      "text": "你说少赚了多少钱？"
    },
    {
      "segment_id": "s000108",
      "start_ms": 229520,
      "end_ms": 232600,
      "text": "经济学原理用一个概念砸碎了这套会计思维。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 232760,
      "end_ms": 233525,
      "text": "曼昆说，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 234110,
      "end_ms": 237415,
      "text": "某种东西的成本是为了得到他所放弃的东西。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 237950,
      "end_ms": 238615,
      "text": "什么意思？"
    },
    {
      "segment_id": "s000112",
      "start_ms": 239020,
      "end_ms": 239720,
      "text": "书里有个例子，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 239720,
      "end_ms": 240955,
      "text": "我读的时候愣了一下。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 241200,
      "end_ms": 245135,
      "text": "曼昆在篮球巨星乔丹修剪自家草坪的成本是多少？"
    },
    {
      "segment_id": "s000115",
      "start_ms": 245350,
      "end_ms": 246090,
      "text": "按你的算法，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 246250,
      "end_ms": 249055,
      "text": "就是请园丁的钱或者他自己花的时间。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 249510,
      "end_ms": 250555,
      "text": "但曼坤说不对，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 251020,
      "end_ms": 255340,
      "text": "乔丹用两小时修剪草坪这两小时如果用来拍广告能赚一万美元，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 255420,
      "end_ms": 257120,
      "text": "所以他修剪草坪的真实成本，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 257120,
      "end_ms": 259605,
      "text": "不是那点时间是一万美元，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 260130,
      "end_ms": 261375,
      "text": "这就是机会成本。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 261830,
      "end_ms": 265005,
      "text": "真正的成本从来不是账面上那个数字，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 265560,
      "end_ms": 269415,
      "text": "是你为了做这件事儿而牺牲掉的那条路上的最好风景。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 269880,
      "end_ms": 272325,
      "text": "这套逻辑让无数人背脊发凉。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 272790,
      "end_ms": 275705,
      "text": "你算过自己每天刷手机三小时的机会成本吗？"
    },
    {
      "segment_id": "s000126",
      "start_ms": 275880,
      "end_ms": 277065,
      "text": "不是三小时时间，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 277400,
      "end_ms": 280065,
      "text": "是你本可以用这三小时学会一门技能，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 280280,
      "end_ms": 282385,
      "text": "三年后月入过万的那笔收入，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 282800,
      "end_ms": 285020,
      "text": "你算过自己留在一份不喜欢的工作里，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 285060,
      "end_ms": 287125,
      "text": "稳定了五年的机会成本吗？"
    },
    {
      "segment_id": "s000131",
      "start_ms": 287410,
      "end_ms": 288310,
      "text": "不是五年工资，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 288790,
      "end_ms": 292425,
      "text": "是你本可以去尝试的那个行业里可能爆发的一切。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 293420,
      "end_ms": 295405,
      "text": "曼昆用一句话把这事儿说透了，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 295750,
      "end_ms": 297765,
      "text": "人们不会对看得见的成本麻木，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 298140,
      "end_ms": 300220,
      "text": "只会对看不见的成本迟钝。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 300500,
      "end_ms": 301845,
      "text": "你以为你精打细算？"
    },
    {
      "segment_id": "s000137",
      "start_ms": 302350,
      "end_ms": 303290,
      "text": "你只是算对了，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 303290,
      "end_ms": 304230,
      "text": "明面上的钱，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 304690,
      "end_ms": 305270,
      "text": "算漏了，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 305270,
      "end_ms": 306690,
      "text": "暗地里溜走的人生。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 306890,
      "end_ms": 307470,
      "text": "第三层，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 307490,
      "end_ms": 310870,
      "text": "颠覆你做决策的致命错误是只看总分，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 311030,
      "end_ms": 311890,
      "text": "不看边际。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 312230,
      "end_ms": 312870,
      "text": "主流思维，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 312870,
      "end_ms": 314110,
      "text": "教你要算总账。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 314670,
      "end_ms": 315790,
      "text": "买房算总价，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 316010,
      "end_ms": 317390,
      "text": "跳槽算总年薪，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 317870,
      "end_ms": 319490,
      "text": "谈恋爱算综合条件。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 319970,
      "end_ms": 321410,
      "text": "这套模式的潜台词是，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 321670,
      "end_ms": 322190,
      "text": "决策，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 322250,
      "end_ms": 325470,
      "text": "就是把所有选项的总收益摆在一起比大小。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 326010,
      "end_ms": 326790,
      "text": "但曼坤说，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 327270,
      "end_ms": 328110,
      "text": "这是错的。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 329010,
      "end_ms": 331435,
      "text": "理性的人考虑边际量。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 332160,
      "end_ms": 333040,
      "text": "什么叫编际量？"
    },
    {
      "segment_id": "s000156",
      "start_ms": 333760,
      "end_ms": 336520,
      "text": "就是再多一个单位带来的变化。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 337100,
      "end_ms": 338500,
      "text": "书里讲了一个经典案例，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 339000,
      "end_ms": 346440,
      "text": "一个小镇有一万美元预算装红绿灯安装后致命交通事故风险从百分之一点六降到百分之一点一。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 346960,
      "end_ms": 351180,
      "text": "你按总账思维会想你降零点五个百分点不值。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 351800,
      "end_ms": 353040,
      "text": "但经济学家会问，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 353660,
      "end_ms": 354880,
      "text": "再多花一块钱，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 354900,
      "end_ms": 357460,
      "text": "在这个红绿灯上能多救几条命？"
    },
    {
      "segment_id": "s000163",
      "start_ms": 357920,
      "end_ms": 359980,
      "text": "如果编际收益大于编际成本，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 360020,
      "end_ms": 362720,
      "text": "就应该继续装这套逻辑，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 362720,
      "end_ms": 364795,
      "text": "彻底翻转了你做决策的方式，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 365340,
      "end_ms": 367505,
      "text": "你不会因为一顿饭总价贵就不吃，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 367990,
      "end_ms": 371055,
      "text": "你只会因为再多吃一口会撑死而停下。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 371720,
      "end_ms": 373445,
      "text": "后者就是编辑思维，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 373870,
      "end_ms": 376395,
      "text": "你不会因为一份工作总年薪高就去，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 376760,
      "end_ms": 378630,
      "text": "你应该问再多干一年，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 378970,
      "end_ms": 380265,
      "text": "我还能得到什么，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 380610,
      "end_ms": 381275,
      "text": "失去什么？"
    },
    {
      "segment_id": "s000173",
      "start_ms": 381930,
      "end_ms": 385050,
      "text": "如果边际收益递减到零就该走人了。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 385050,
      "end_ms": 385795,
      "text": "汉坤说，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 386270,
      "end_ms": 387895,
      "text": "绝大多数人做决策失败，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 388180,
      "end_ms": 389625,
      "text": "不是因为算不清总数，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 389960,
      "end_ms": 392485,
      "text": "是因为看不见下一个单位的价值变化。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 393020,
      "end_ms": 394735,
      "text": "你在一段关系里耗了五年，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 395140,
      "end_ms": 396015,
      "text": "舍不得分手。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 396530,
      "end_ms": 400650,
      "text": "因为你盯着已经投入的五年不放经济学管，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 400650,
      "end_ms": 401905,
      "text": "这叫沉默成本。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 402300,
      "end_ms": 402995,
      "text": "他告诉你，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 403380,
      "end_ms": 404865,
      "text": "过去的已经回不来了。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 405380,
      "end_ms": 409755,
      "text": "你应该看的只有再多待一天的边际收益和边际成本，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 410140,
      "end_ms": 411585,
      "text": "这句话可能会刺痛你。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 412130,
      "end_ms": 413690,
      "text": "你坚持不放手的东西，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 413890,
      "end_ms": 415255,
      "text": "不是因为它值得，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 415640,
      "end_ms": 419370,
      "text": "只是因为你不敢承认自己当初选错了第四层。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 419370,
      "end_ms": 421995,
      "text": "颠覆激励是看不见的手，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 422670,
      "end_ms": 423790,
      "text": "你在被他推着走，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 423910,
      "end_ms": 424755,
      "text": "却不自知。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 425270,
      "end_ms": 427075,
      "text": "我们这代人喜欢讨论人性，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 427550,
      "end_ms": 430505,
      "text": "贪懒、自私短视，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 431040,
      "end_ms": 432620,
      "text": "一切行为都用人性。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 432720,
      "end_ms": 436900,
      "text": "就这样来解释这套话语的潜台词是人是不变的。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 437040,
      "end_ms": 438505,
      "text": "所以你不用研究行为，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 438770,
      "end_ms": 440960,
      "text": "你只需要接受经济学原理，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 440960,
      "end_ms": 443205,
      "text": "用一个概念砸碎了这套宿命论。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 443680,
      "end_ms": 444335,
      "text": "曼坤说，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 444700,
      "end_ms": 446445,
      "text": "人们会对激励做出反应，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 447040,
      "end_ms": 447935,
      "text": "激励是什么？"
    },
    {
      "segment_id": "s000202",
      "start_ms": 448440,
      "end_ms": 451450,
      "text": "是让你想做某件事的推力涨价了，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 451450,
      "end_ms": 453060,
      "text": "你就少买降价了，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 453060,
      "end_ms": 454520,
      "text": "你就多买罚款了，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 454520,
      "end_ms": 456420,
      "text": "你就不敢违章奖励了。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 456420,
      "end_ms": 457625,
      "text": "你就有动力加班，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 457950,
      "end_ms": 459335,
      "text": "听起来简单到可笑。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 459740,
      "end_ms": 460605,
      "text": "但曼坤说，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 461170,
      "end_ms": 464435,
      "text": "这个简单的道理是经济学最强大的武器。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 464920,
      "end_ms": 468015,
      "text": "因为百分之九十的人看不懂自己为什么做某件事儿，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 468250,
      "end_ms": 470375,
      "text": "更看不懂别人为什么做某件事。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 470820,
      "end_ms": 472725,
      "text": "书里有一个让人不寒而栗的案例。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 473400,
      "end_ms": 475590,
      "text": "安全带被发明后按理说，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 475710,
      "end_ms": 477265,
      "text": "车祸死亡率应该下降，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 477890,
      "end_ms": 480795,
      "text": "但事实是车祸次数增加了。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 481100,
      "end_ms": 481705,
      "text": "为什么？"
    },
    {
      "segment_id": "s000217",
      "start_ms": 482160,
      "end_ms": 484420,
      "text": "因为安全带让司机觉得更安全了，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 484660,
      "end_ms": 486840,
      "text": "于是开的更快更records,"
    },
    {
      "segment_id": "s000219",
      "start_ms": 487280,
      "end_ms": 488080,
      "text": "激励变了，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 488240,
      "end_ms": 489160,
      "text": "行为变了，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 489220,
      "end_ms": 490720,
      "text": "结果完全反了，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 491140,
      "end_ms": 491920,
      "text": "这就是曼坤。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 491920,
      "end_ms": 494420,
      "text": "想告诉你的你不是自由的，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 494940,
      "end_ms": 497120,
      "text": "不是一架被激励推着走的机器，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 497720,
      "end_ms": 500520,
      "text": "只是你自己不知道你加班到深夜。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 500700,
      "end_ms": 502200,
      "text": "不是因为你热爱工作，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 502500,
      "end_ms": 504320,
      "text": "是因为公司设置了不加班，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 504320,
      "end_ms": 505660,
      "text": "就没有晋升的激励。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 506080,
      "end_ms": 507340,
      "text": "你刷手机停不下来。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 507740,
      "end_ms": 509320,
      "text": "不是因为你有毅力问题，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 509600,
      "end_ms": 511680,
      "text": "是因为产品经理用算法设置了，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 511680,
      "end_ms": 513470,
      "text": "你无法抵抗的激励，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 514070,
      "end_ms": 515930,
      "text": "你买了一件根本不需要的东西。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 516210,
      "end_ms": 516490,
      "text": "不是，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 516490,
      "end_ms": 517310,
      "text": "因为你需要，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 517310,
      "end_ms": 523470,
      "text": "它是因为满减限时折扣设置了让你觉得不买就亏了的激励这套逻辑。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 523470,
      "end_ms": 524730,
      "text": "最残忍的地方在于，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 525270,
      "end_ms": 526750,
      "text": "你以为你在做选择，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 527430,
      "end_ms": 530410,
      "text": "其实你只是在响应刺激你，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 530410,
      "end_ms": 531130,
      "text": "不是主人，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 531610,
      "end_ms": 532750,
      "text": "你是提现木偶，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 533270,
      "end_ms": 535370,
      "text": "现在激励手里第五层，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 535390,
      "end_ms": 537410,
      "text": "颠覆你值多少钱，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 537870,
      "end_ms": 539390,
      "text": "不由你多努力决定，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 539830,
      "end_ms": 541575,
      "text": "而由替代品决定。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 542430,
      "end_ms": 543830,
      "text": "你有没有被这句话骗过，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 544430,
      "end_ms": 545570,
      "text": "只要足够努力，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 545910,
      "end_ms": 547310,
      "text": "就一定会被看见。"
    },
    {
      "segment_id": "s000249",
      "start_ms": 547430,
      "end_ms": 553590,
      "text": "经济学原理用供给与需求比较优势和贸易这几张把这句话按在地上摩擦。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 554010,
      "end_ms": 554670,
      "text": "曼坤说，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 555330,
      "end_ms": 557430,
      "text": "贸易能使每个人状况更好。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 557830,
      "end_ms": 559630,
      "text": "但这句话反过来更残酷，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 560350,
      "end_ms": 561730,
      "text": "市场不奖励辛苦，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 562370,
      "end_ms": 563590,
      "text": "市场奖励稀缺。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 563690,
      "end_ms": 566690,
      "text": "你的价格不是由你流了多少汗决定的，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 567010,
      "end_ms": 569510,
      "text": "是由有多少人能替代你决定的。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 569790,
      "end_ms": 570950,
      "text": "你之所以工资低，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 571350,
      "end_ms": 572600,
      "text": "不是因为你不够拼，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 573080,
      "end_ms": 575640,
      "text": "是因为你身后站着一万个和你一样拼，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 575880,
      "end_ms": 577380,
      "text": "甚至比你更便宜的人。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 577980,
      "end_ms": 579220,
      "text": "你以为世界是零和，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 579600,
      "end_ms": 581620,
      "text": "别人赚了你就亏了？"
    },
    {
      "segment_id": "s000263",
      "start_ms": 582040,
      "end_ms": 582640,
      "text": "曼坤说，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 583240,
      "end_ms": 585160,
      "text": "不是交易，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 585200,
      "end_ms": 586180,
      "text": "不是抢蛋糕，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 586580,
      "end_ms": 587740,
      "text": "是把蛋糕做大。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 588200,
      "end_ms": 590300,
      "text": "你不需要在每件事上都比别人强。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 590840,
      "end_ms": 592940,
      "text": "你只需要找到自己的比较优势，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 593780,
      "end_ms": 595380,
      "text": "哪怕你样样不如别人，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 595900,
      "end_ms": 598200,
      "text": "只要做你相对更擅长的那件事，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 598360,
      "end_ms": 599340,
      "text": "再和别人交换，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 599620,
      "end_ms": 601105,
      "text": "你也能过得更好。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 601930,
      "end_ms": 604310,
      "text": "真正可怕的不是别人比你强，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 605070,
      "end_ms": 609290,
      "text": "是你非要在别人最强的赛道上拿自己最弱的地方去卷。"
    },
    {
      "segment_id": "s000275",
      "start_ms": 609850,
      "end_ms": 612390,
      "text": "这层认知会掀翻你的努力观。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 612950,
      "end_ms": 613890,
      "text": "你拼命加班，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 614210,
      "end_ms": 616830,
      "text": "可能只是在给一个供给过剩的岗位压价。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 617470,
      "end_ms": 618610,
      "text": "你拼命补短板，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 618910,
      "end_ms": 621790,
      "text": "可能只是在把自己修成一个昂贵的平庸品。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 621870,
      "end_ms": 624350,
      "text": "你拼命证明自己可能只是没看懂。"
    },
    {
      "segment_id": "s000281",
      "start_ms": 624730,
      "end_ms": 626810,
      "text": "市场从来不为苦劳买单，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 627110,
      "end_ms": 628910,
      "text": "只为不可替代性定价。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 628930,
      "end_ms": 630170,
      "text": "万坤没有叫你辩富。"
    },
    {
      "segment_id": "s000284",
      "start_ms": 630510,
      "end_ms": 631250,
      "text": "但他告诉你，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 631250,
      "end_ms": 632540,
      "text": "一个冷冰冰的规则，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 633000,
      "end_ms": 635040,
      "text": "你不是在跟自己的极限竞争，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 635440,
      "end_ms": 637680,
      "text": "你是在跟所有替代方案竞争，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 638060,
      "end_ms": 638880,
      "text": "你赚不到钱，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 639180,
      "end_ms": 640360,
      "text": "不一定是你不努力，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 640880,
      "end_ms": 642520,
      "text": "是你把自己放错了市场。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 642880,
      "end_ms": 644520,
      "text": "第六层颠覆市场，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 644520,
      "end_ms": 645160,
      "text": "不是工具，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 645460,
      "end_ms": 647840,
      "text": "是你永远逃不掉的底层代码。"
    },
    {
      "segment_id": "s000294",
      "start_ms": 648140,
      "end_ms": 649460,
      "text": "读到这里你可能想问，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 650060,
      "end_ms": 653360,
      "text": "说了这么多个人决策跟宏观世界有什么关系？"
    },
    {
      "segment_id": "s000296",
      "start_ms": 653440,
      "end_ms": 655320,
      "text": "经济学不就是研究怎么赚钱，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 655340,
      "end_ms": 656220,
      "text": "怎么投资吗？"
    },
    {
      "segment_id": "s000298",
      "start_ms": 656580,
      "end_ms": 657240,
      "text": "如果你这样，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 657240,
      "end_ms": 659060,
      "text": "想你就错过了这本书，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 659060,
      "end_ms": 660200,
      "text": "埋了二十年的陷阱。"
    },
    {
      "segment_id": "s000301",
      "start_ms": 660200,
      "end_ms": 663390,
      "text": "曼昆用一本书证明的不是经济学，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 663390,
      "end_ms": 664310,
      "text": "可以教你赚钱，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 664710,
      "end_ms": 669185,
      "text": "而是经济学可以让你看清自己到底活在什么样的世界里。"
    },
    {
      "segment_id": "s000304",
      "start_ms": 669670,
      "end_ms": 671535,
      "text": "他最大的颠覆不是方法，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 671820,
      "end_ms": 672485,
      "text": "是视角。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 672890,
      "end_ms": 674050,
      "text": "他在书里反复强调，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 674050,
      "end_ms": 675115,
      "text": "三个宏观原理，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 675560,
      "end_ms": 679240,
      "text": "一国的生活水平取决于他生产物品与劳务的能力。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 679340,
      "end_ms": 681765,
      "text": "当政府发行太多货币、物价上升，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 682130,
      "end_ms": 685715,
      "text": "社会在短期面临通货膨胀与失业的权衡取舍。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 686190,
      "end_ms": 688455,
      "text": "这三句话在今天听来像常识，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 688940,
      "end_ms": 689720,
      "text": "但曼昆说，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 689980,
      "end_ms": 693040,
      "text": "他们揭穿了一个所有政客都不愿承认的真相，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 693100,
      "end_ms": 694245,
      "text": "没有免费的增长，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 694520,
      "end_ms": 695595,
      "text": "没有无痛的调控，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 695970,
      "end_ms": 699255,
      "text": "你享受的每一分繁荣背后都有人在承担代价。"
    },
    {
      "segment_id": "s000317",
      "start_ms": 699770,
      "end_ms": 701270,
      "text": "二零零八年金融危机后，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 701570,
      "end_ms": 705035,
      "text": "七十名哈佛学生集体退出曼昆的经济学原理课堂，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 705480,
      "end_ms": 706380,
      "text": "抗议他的教材，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 706580,
      "end_ms": 708675,
      "text": "把经济危机的可能性边缘化。"
    },
    {
      "segment_id": "s000321",
      "start_ms": 709080,
      "end_ms": 709875,
      "text": "学生们说，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 710450,
      "end_ms": 713150,
      "text": "你这门课对于美国问题重重的低效，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 713150,
      "end_ms": 715925,
      "text": "经济是一种特殊且有限的看法。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 716350,
      "end_ms": 717065,
      "text": "曼昆回应，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 717410,
      "end_ms": 719250,
      "text": "一c一零的目的不是为了站队，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 719430,
      "end_ms": 721635,
      "text": "是为了介绍更广泛的经济思想。"
    },
    {
      "segment_id": "s000327",
      "start_ms": 722010,
      "end_ms": 724205,
      "text": "你看最有趣的事情发生了，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 724720,
      "end_ms": 727320,
      "text": "连教经济学的人都被自己的学生质疑，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 727500,
      "end_ms": 729640,
      "text": "你教的只是其中一种真相。"
    },
    {
      "segment_id": "s000330",
      "start_ms": 729760,
      "end_ms": 732735,
      "text": "曼昆被人批评为新古典经济学的妥协派，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 733100,
      "end_ms": 733200,
      "text": "说，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 733200,
      "end_ms": 735085,
      "text": "他否认大萧条的基本教训，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 735470,
      "end_ms": 736625,
      "text": "也有人被他鸣冤，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 737010,
      "end_ms": 739690,
      "text": "说把金融危机归咎于一堂大一入门课，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 739810,
      "end_ms": 740925,
      "text": "比斗娥还冤。"
    },
    {
      "segment_id": "s000336",
      "start_ms": 741290,
      "end_ms": 743205,
      "text": "但曼昆在书里早就写了一段话，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 743520,
      "end_ms": 745665,
      "text": "我觉得是他留给世界最珍贵的遗产。"
    },
    {
      "segment_id": "s000338",
      "start_ms": 746190,
      "end_ms": 746590,
      "text": "他说，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 747140,
      "end_ms": 749520,
      "text": "经济学不是告诉你应该怎么做的，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 749520,
      "end_ms": 753795,
      "text": "说明书是告诉你世界实际上怎么运转的地图，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 754570,
      "end_ms": 756735,
      "text": "地图不会告诉你往哪儿走是对的，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 757060,
      "end_ms": 757925,
      "text": "他只会告诉你，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 758230,
      "end_ms": 758970,
      "text": "如果你往东，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 759270,
      "end_ms": 760215,
      "text": "你会遇到山。"
    },
    {
      "segment_id": "s000345",
      "start_ms": 760800,
      "end_ms": 761540,
      "text": "如果你往西，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 761960,
      "end_ms": 762755,
      "text": "你会遇到河，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 763600,
      "end_ms": 764725,
      "text": "至于你选哪条路，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 765150,
      "end_ms": 765905,
      "text": "那是你的事儿。"
    },
    {
      "segment_id": "s000349",
      "start_ms": 766400,
      "end_ms": 769775,
      "text": "这段话让我明白了这本书最惊世骇俗的答案。"
    },
    {
      "segment_id": "s000350",
      "start_ms": 770200,
      "end_ms": 772875,
      "text": "经济学最大的价值不是让你变有钱，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 773290,
      "end_ms": 777100,
      "text": "是让你在做一个决策时清楚的知道自己放弃了什么，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 777300,
      "end_ms": 778515,
      "text": "将被什么推着走，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 778810,
      "end_ms": 781275,
      "text": "以及最终要为这个选择承担什么。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 781750,
      "end_ms": 783370,
      "text": "它不会让你的人生变容易，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 783830,
      "end_ms": 786010,
      "text": "但它会让你的人生变清醒。"
    },
    {
      "segment_id": "s000356",
      "start_ms": 786430,
      "end_ms": 787570,
      "text": "读完经济学原理，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 787810,
      "end_ms": 789830,
      "text": "你可能发现书名起错了。"
    },
    {
      "segment_id": "s000358",
      "start_ms": 790310,
      "end_ms": 792170,
      "text": "这不是一本教你赚钱的手册，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 792830,
      "end_ms": 797370,
      "text": "是一本关于人如何在这个稀缺的世界里做选择的生存指南。"
    },
    {
      "segment_id": "s000360",
      "start_ms": 797750,
      "end_ms": 799170,
      "text": "权衡取舍不是重点，"
    },
    {
      "segment_id": "s000361",
      "start_ms": 799410,
      "end_ms": 800730,
      "text": "机会成本不是重点，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 801010,
      "end_ms": 802290,
      "text": "替际量不是重点，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 802470,
      "end_ms": 803490,
      "text": "激励不是重点，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 803790,
      "end_ms": 805030,
      "text": "替代品不是重点，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 805270,
      "end_ms": 806470,
      "text": "市场不是重点，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 807070,
      "end_ms": 811265,
      "text": "重点是那个二十九岁就成为哈佛教授的乌克兰移民后代。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 811600,
      "end_ms": 815060,
      "text": "面对一个充满不确定性资源永远不够用的世界，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 815300,
      "end_ms": 815540,
      "text": "说，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 816040,
      "end_ms": 817340,
      "text": "我不服从直觉，"
    },
    {
      "segment_id": "s000370",
      "start_ms": 817600,
      "end_ms": 818900,
      "text": "我只服从逻辑。"
    },
    {
      "segment_id": "s000371",
      "start_ms": 819380,
      "end_ms": 820440,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000372",
      "start_ms": 820940,
      "end_ms": 823140,
      "text": "他看见每一个选择都是一次放弃。"
    },
    {
      "segment_id": "s000373",
      "start_ms": 823440,
      "end_ms": 825360,
      "text": "每一个激励都在塑造行为，"
    },
    {
      "segment_id": "s000374",
      "start_ms": 825560,
      "end_ms": 827440,
      "text": "每一个市场都在分配代价，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 827859,
      "end_ms": 830140,
      "text": "每一个价格背后都占着替代品，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 830580,
      "end_ms": 833440,
      "text": "而你有幸可以学会看懂这一切。"
    },
    {
      "segment_id": "s000377",
      "start_ms": 833960,
      "end_ms": 837800,
      "text": "这本书最后有一句话是曼昆在第一章结束时写的，"
    },
    {
      "segment_id": "s000378",
      "start_ms": 838400,
      "end_ms": 843210,
      "text": "我想把它留给你学习经济学人不会让你变得富有，"
    },
    {
      "segment_id": "s000379",
      "start_ms": 843890,
      "end_ms": 848050,
      "text": "让你变富有的是你的天赋、勤奋和运气。"
    },
    {
      "segment_id": "s000380",
      "start_ms": 848770,
      "end_ms": 852150,
      "text": "但学习经济学可以让你少犯一种错误那种，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 852150,
      "end_ms": 855030,
      "text": "因为你不知道自己在做什么而犯的错误。"
    },
    {
      "segment_id": "s000382",
      "start_ms": 855310,
      "end_ms": 856110,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000383",
      "start_ms": 856230,
      "end_ms": 858175,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "317165452428d1bfbeb2f80cbe5666ee806e74f2e311283e23370a1cb2f01236"
}