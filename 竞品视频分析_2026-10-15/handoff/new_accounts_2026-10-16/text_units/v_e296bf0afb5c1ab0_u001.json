{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_e296bf0afb5c1ab0_u001",
  "video_id": "v_e296bf0afb5c1ab0",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 701.778005,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 50,
      "end_ms": 3370,
      "text": "你知道中国最适合过冬的小城在哪儿吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3410,
      "end_ms": 5190,
      "text": "上一季我讲了十个，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5190,
      "end_ms": 8050,
      "text": "好多朋友看完直接订了票，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 8050,
      "end_ms": 11150,
      "text": "可评论区里有一句话让我愣了下去啊，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 11270,
      "end_ms": 12750,
      "text": "人多了，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12810,
      "end_ms": 15890,
      "text": "确实好地方一旦被知道了，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16129,
      "end_ms": 17030,
      "text": "人就来了。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17870,
      "end_ms": 22470,
      "text": "所以今天这十个比上一季更冷门，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 23230,
      "end_ms": 24750,
      "text": "冷门到什么程度呢？"
    },
    {
      "segment_id": "s000010",
      "start_ms": 25910,
      "end_ms": 29090,
      "text": "排第一的是一个县级市城，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 29130,
      "end_ms": 31300,
      "text": "里面有反法国风情的酒庄，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 31780,
      "end_ms": 32740,
      "text": "有野温泉，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 33120,
      "end_ms": 34480,
      "text": "还有一片红土地。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 34960,
      "end_ms": 37240,
      "text": "可您身边随便问一圈，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 37260,
      "end_ms": 40220,
      "text": "大部分人连他的名字都说不出来，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 40960,
      "end_ms": 41840,
      "text": "到底是哪？"
    },
    {
      "segment_id": "s000017",
      "start_ms": 42940,
      "end_ms": 43640,
      "text": "老规矩，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 44360,
      "end_ms": 47220,
      "text": "从第十名开始倒着讲讲，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 47220,
      "end_ms": 51960,
      "text": "到最后您自个儿盘算盘算开讲之前还是那句话，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 52440,
      "end_ms": 55660,
      "text": "劳烦老友们顺手点亮小红心。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 56080,
      "end_ms": 60975,
      "text": "评论区打个来了让我看看今天有多少老朋朋友捧场。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 62000,
      "end_ms": 62725,
      "text": "第十名，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 63640,
      "end_ms": 68225,
      "text": "广东湛江湛江在广东的最西南角，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 68730,
      "end_ms": 69670,
      "text": "三面环海，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 69670,
      "end_ms": 71335,
      "text": "对面就是海南岛。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 72210,
      "end_ms": 75910,
      "text": "好多人去海南坐轮渡都从湛江过，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 75990,
      "end_ms": 76790,
      "text": "可就是过了，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 76890,
      "end_ms": 77815,
      "text": "没停下来。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 78750,
      "end_ms": 80395,
      "text": "湛江冬天什么概念呢？"
    },
    {
      "segment_id": "s000030",
      "start_ms": 80720,
      "end_ms": 84615,
      "text": "羽绒服用不上一件薄外套就够了，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 85260,
      "end_ms": 87245,
      "text": "跟北海的体感差不多。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 87960,
      "end_ms": 89460,
      "text": "可湛江有一样东西，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 89460,
      "end_ms": 90855,
      "text": "北海比不了生蚝。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 91290,
      "end_ms": 93330,
      "text": "湛江是中国有名的生蚝，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 93330,
      "end_ms": 96380,
      "text": "产地全国好多地方吃的生蚝，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 96380,
      "end_ms": 98505,
      "text": "其实都是从湛江运过去，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 99480,
      "end_ms": 103000,
      "text": "可到了湛江本地价格便宜到您不敢信。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 103040,
      "end_ms": 105210,
      "text": "同样的声号运到外地，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 105230,
      "end_ms": 106845,
      "text": "价格能翻好几倍。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 107290,
      "end_ms": 110590,
      "text": "路边烧烤摊上的炭烤生蚝，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 110790,
      "end_ms": 111650,
      "text": "个头大的，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 111650,
      "end_ms": 113155,
      "text": "比成年人的巴掌还宽，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 113520,
      "end_ms": 115185,
      "text": "一口下去全是汁水。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 115800,
      "end_ms": 119000,
      "text": "您要是去市场自己买一麻袋扛回来，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 119000,
      "end_ms": 120095,
      "text": "撬开了蒸着吃，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 120900,
      "end_ms": 121660,
      "text": "煮汤吃，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 122000,
      "end_ms": 123865,
      "text": "生吃随便造，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 124410,
      "end_ms": 125455,
      "text": "花不了多少钱。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 126420,
      "end_ms": 127540,
      "text": "湛江还有一个地方，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 127540,
      "end_ms": 133250,
      "text": "很多人不知道胡光堰那是一个火山口形成的湖水，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 133410,
      "end_ms": 134715,
      "text": "是碧绿色的，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 134970,
      "end_ms": 137585,
      "text": "安安静静地躺在火山口里面，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 138070,
      "end_ms": 139285,
      "text": "周围全是树，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 139760,
      "end_ms": 141505,
      "text": "冬天去湖边走一圈儿，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 141730,
      "end_ms": 142625,
      "text": "没什么游客，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 143440,
      "end_ms": 145080,
      "text": "风从湖面上吹过来，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 145080,
      "end_ms": 147300,
      "text": "带着一股潮湿的草木味道，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 147380,
      "end_ms": 150155,
      "text": "冬天穿着薄外套在海边溜达，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 150580,
      "end_ms": 152345,
      "text": "吹着不冷不热的海风。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 153200,
      "end_ms": 155365,
      "text": "这日子搁北方想都不敢想，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 156190,
      "end_ms": 157310,
      "text": "湛江排第十，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 157310,
      "end_ms": 158155,
      "text": "不是他不好，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 158550,
      "end_ms": 159990,
      "text": "是后面的更冷门，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 159990,
      "end_ms": 160805,
      "text": "更安静。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 161400,
      "end_ms": 162020,
      "text": "第九名，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 162320,
      "end_ms": 163265,
      "text": "云南蒙自，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 164130,
      "end_ms": 167745,
      "text": "蒙自在云南红河州这个名字好多人没听说过，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 168520,
      "end_ms": 169680,
      "text": "可以有一样东西，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 169680,
      "end_ms": 171435,
      "text": "您一定吃过过桥米线。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 172380,
      "end_ms": 176535,
      "text": "过桥米线就是从蒙自来的这是公认的发源地，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 177480,
      "end_ms": 182085,
      "text": "可您在别的城市吃的过桥米线跟蒙自本地的比差得远了。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 182560,
      "end_ms": 184995,
      "text": "蒙自的过桥米线讲究的是汤，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 185440,
      "end_ms": 189165,
      "text": "那个汤是用老母鸡和筒子骨熬出来的，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 189540,
      "end_ms": 191705,
      "text": "上面飘着厚厚一层机油，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 192110,
      "end_ms": 193495,
      "text": "把热气封在里面，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 193970,
      "end_ms": 194850,
      "text": "端上来的时候，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 194850,
      "end_ms": 195995,
      "text": "汤看着不冒烟。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 196830,
      "end_ms": 199035,
      "text": "可您把生肉片丢进去，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 199710,
      "end_ms": 201445,
      "text": "几秒钟就烫手了。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 201950,
      "end_ms": 205215,
      "text": "米线是细圆粉滑溜溜的，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 206200,
      "end_ms": 207400,
      "text": "从汤里捞起来，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 207400,
      "end_ms": 208695,
      "text": "裹着一层浓汤，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 209110,
      "end_ms": 210890,
      "text": "连汤带粉吸进嘴里，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 211110,
      "end_ms": 212795,
      "text": "鲜到眉毛都跟着动。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 213470,
      "end_ms": 218535,
      "text": "同样一碗过桥米线在猛自吃和在外面城市吃，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 219310,
      "end_ms": 220930,
      "text": "价格能差出两三倍，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 221010,
      "end_ms": 222330,
      "text": "味道更是差。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 222330,
      "end_ms": 224990,
      "text": "出十条街蒙自的冬天，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 225030,
      "end_ms": 226895,
      "text": "白天太阳出来暖洋洋的，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 227340,
      "end_ms": 228925,
      "text": "穿件薄毛衣就行，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 229440,
      "end_ms": 230440,
      "text": "早晚凉一点。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 230440,
      "end_ms": 231265,
      "text": "加件外套。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 232020,
      "end_ms": 234890,
      "text": "蒙自城边有个南湖湖不大，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 234930,
      "end_ms": 236045,
      "text": "但水很清。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 236540,
      "end_ms": 237020,
      "text": "冬天，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 237040,
      "end_ms": 238785,
      "text": "湖边的柳树还是绿的，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 239420,
      "end_ms": 241860,
      "text": "当地人早上在湖边打太极，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 242260,
      "end_ms": 243485,
      "text": "遛鸟下棋，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 244190,
      "end_ms": 245510,
      "text": "您端一碗米线，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 245650,
      "end_ms": 247175,
      "text": "坐在湖边的石凳上，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 247620,
      "end_ms": 249265,
      "text": "一边吃一边晒太阳，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 249930,
      "end_ms": 251770,
      "text": "吃完了沿着湖走一圈，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 251790,
      "end_ms": 252585,
      "text": "消消食。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 253130,
      "end_ms": 256680,
      "text": "猛自的物价比上一集讲的建水还低一点，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 256780,
      "end_ms": 257760,
      "text": "租房便宜，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 257860,
      "end_ms": 258995,
      "text": "吃饭更便宜。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 259330,
      "end_ms": 260410,
      "text": "早上一碗米线，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 260410,
      "end_ms": 261490,
      "text": "中午一碗卷粉，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 261530,
      "end_ms": 263990,
      "text": "晚上一碗凉米线三顿下来，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 263990,
      "end_ms": 265045,
      "text": "花不了多少钱，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 265790,
      "end_ms": 266795,
      "text": "房租不贵，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 267220,
      "end_ms": 268405,
      "text": "米线正宗。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 268970,
      "end_ms": 270590,
      "text": "全中国只有这个地方，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 270610,
      "end_ms": 273065,
      "text": "吃的是最地道的过桥米线，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 273590,
      "end_ms": 274570,
      "text": "猛自过冬，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 274870,
      "end_ms": 276415,
      "text": "冲这碗米线就值了。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 276670,
      "end_ms": 278060,
      "text": "我第八名，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 278320,
      "end_ms": 282815,
      "text": "广西、防城港、防城港在广西的最南边，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 283490,
      "end_ms": 286335,
      "text": "面朝北部湾跟北海是邻居，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 286980,
      "end_ms": 289495,
      "text": "可名气只有北海的十分之一。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 289910,
      "end_ms": 292570,
      "text": "防城港的冬天跟北海体感差不多，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 292670,
      "end_ms": 294495,
      "text": "穿件薄外套就行，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 295290,
      "end_ms": 297930,
      "text": "可防城港比北海多了一样东西。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 297930,
      "end_ms": 298415,
      "text": "赶海。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 299230,
      "end_ms": 300345,
      "text": "什么叫赶海呢？"
    },
    {
      "segment_id": "s000126",
      "start_ms": 300670,
      "end_ms": 303065,
      "text": "就是退潮的时候海水退下去。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 303570,
      "end_ms": 305850,
      "text": "礁石和沙滩露出来，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 306250,
      "end_ms": 308730,
      "text": "藏在里面的海鲜全暴露。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 309710,
      "end_ms": 318170,
      "text": "螃蟹、海螺、生蚝、沙虫、海胆卷起裤腿拎个桶下去捡就行了。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 318910,
      "end_ms": 322730,
      "text": "防城港的海岸线长礁石多，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 323630,
      "end_ms": 332210,
      "text": "冬天正好是大潮期退潮退的远漏出来的滩涂大能捡的东西多一个下午，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 332210,
      "end_ms": 334560,
      "text": "弯着腰在滩滩土上翻石头，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 334560,
      "end_ms": 338080,
      "text": "挖沙虫桶装满了回去洗干净直接下锅。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 338380,
      "end_ms": 339040,
      "text": "您想想，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 339240,
      "end_ms": 341320,
      "text": "自己从海里捡回来的海鲜，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 341499,
      "end_ms": 343980,
      "text": "不花一分钱拿回去煮着吃，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 343980,
      "end_ms": 344520,
      "text": "蒸着吃，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 344520,
      "end_ms": 345100,
      "text": "炒着吃。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 345540,
      "end_ms": 348280,
      "text": "那个鲜味跟市场买的不是一回事。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 349180,
      "end_ms": 352180,
      "text": "防城港还有一点别的海边城市少见，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 352180,
      "end_ms": 353500,
      "text": "它是边境城市，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 354360,
      "end_ms": 356440,
      "text": "城里有一条边贸街，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 357360,
      "end_ms": 361420,
      "text": "越南的零食咖啡水果便宜的很，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 361860,
      "end_ms": 363155,
      "text": "日常物价也低，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 363650,
      "end_ms": 365505,
      "text": "租房比北海便宜，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 365930,
      "end_ms": 369350,
      "text": "菜市场的海鲜价格也比北海低一截，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 369450,
      "end_ms": 370350,
      "text": "房租不贵，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 370550,
      "end_ms": 371610,
      "text": "赶海不花钱，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 371870,
      "end_ms": 373295,
      "text": "越南水果当零嘴。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 374110,
      "end_ms": 377090,
      "text": "防城港过冬过的是一种赶海的乐趣，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 377090,
      "end_ms": 378145,
      "text": "不是去买海鲜，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 378370,
      "end_ms": 381240,
      "text": "是自己去捡第七名。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 381580,
      "end_ms": 385935,
      "text": "四川西昌又是四川上一集讲了攀枝花，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 386330,
      "end_ms": 389705,
      "text": "好多朋友说没想到四川还有冬天不冷的地方。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 390460,
      "end_ms": 394375,
      "text": "其实四川南边还藏着一个就是西昌，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 395160,
      "end_ms": 396675,
      "text": "西昌在凉山州，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 397220,
      "end_ms": 398675,
      "text": "当地人叫他越城，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 399140,
      "end_ms": 400585,
      "text": "也有人叫太阳城，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 400920,
      "end_ms": 401585,
      "text": "为什么呢？"
    },
    {
      "segment_id": "s000160",
      "start_ms": 401910,
      "end_ms": 405190,
      "text": "因为西昌一年到头大部分日子都是晴天，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 405270,
      "end_ms": 406715,
      "text": "冬天也不例外。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 407660,
      "end_ms": 410435,
      "text": "别的地方冬天阴沉沉的看不见太阳。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 411010,
      "end_ms": 412495,
      "text": "西昌的天是蓝的，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 412960,
      "end_ms": 413975,
      "text": "太阳是暖的，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 414750,
      "end_ms": 416715,
      "text": "走在街上身上热乎乎的。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 417630,
      "end_ms": 420885,
      "text": "西昌冬天的体感跟攀枝花差不多，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 421430,
      "end_ms": 424095,
      "text": "穿件薄外套晒着太阳刚刚好，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 424550,
      "end_ms": 426930,
      "text": "可西昌比攀枝花多了一样东西。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 426950,
      "end_ms": 430935,
      "text": "白死海翟四海是四川数得着的大湖，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 431530,
      "end_ms": 433125,
      "text": "就在西昌城边上，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 433410,
      "end_ms": 434415,
      "text": "走路就能到。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 434880,
      "end_ms": 437825,
      "text": "冬天的白黑海水面开阔，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 438520,
      "end_ms": 439405,
      "text": "对岸是山，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 440180,
      "end_ms": 442325,
      "text": "山上偶尔飘着一点雾，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 443260,
      "end_ms": 446480,
      "text": "湖边修了一条环湖步道，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 446620,
      "end_ms": 448045,
      "text": "全长几十公里，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 448320,
      "end_ms": 449605,
      "text": "您不用全走完，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 450060,
      "end_ms": 450780,
      "text": "挑一段，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 450980,
      "end_ms": 453025,
      "text": "沿着湖边慢慢溜达，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 453920,
      "end_ms": 454880,
      "text": "左边是湖，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 454980,
      "end_ms": 456125,
      "text": "右边是湿地。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 456990,
      "end_ms": 458410,
      "text": "冬天的湿地里，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 458490,
      "end_ms": 462980,
      "text": "有从北方飞来过冬的候鸟白鹭、海鸥，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 463200,
      "end_ms": 466640,
      "text": "一群一群的在水面上飞西昌。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 466640,
      "end_ms": 467600,
      "text": "还有一个好处，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 467700,
      "end_ms": 468775,
      "text": "火盆烧烤，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 469630,
      "end_ms": 472085,
      "text": "西昌的烧烤在四川是出了名的，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 472710,
      "end_ms": 474975,
      "text": "用一个铁盆装着炭火，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 475430,
      "end_ms": 478775,
      "text": "上面架一张铁网、烤小猪肉，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 479370,
      "end_ms": 480255,
      "text": "考洋芋，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 480820,
      "end_ms": 481945,
      "text": "靠包浆豆腐，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 482640,
      "end_ms": 484255,
      "text": "蘸着当地的辣椒面吃。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 485310,
      "end_ms": 486390,
      "text": "冬天的晚上，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 486590,
      "end_ms": 488570,
      "text": "坐在街边的烧烤摊上，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 488650,
      "end_ms": 489775,
      "text": "炭火烤着脸，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 490190,
      "end_ms": 491945,
      "text": "手里拿着一串小猪肉，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 492380,
      "end_ms": 494060,
      "text": "旁边的人操着四川话，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 494120,
      "end_ms": 495905,
      "text": "幺五喝六热闹的很，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 496290,
      "end_ms": 497335,
      "text": "租房也不贵，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 497990,
      "end_ms": 500030,
      "text": "跟攀枝花差不多的价钱。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 500230,
      "end_ms": 501850,
      "text": "白天湖边晒太阳，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 501890,
      "end_ms": 502565,
      "text": "看候鸟，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 503010,
      "end_ms": 504395,
      "text": "晚上吃火盆烧烤。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 505720,
      "end_ms": 508245,
      "text": "上一季的攀枝花赢在水果，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 508910,
      "end_ms": 513085,
      "text": "这一季的西昌赢在那个湖第六名，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 514780,
      "end_ms": 516700,
      "text": "贵州兴义嗯嗯，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 517970,
      "end_ms": 524400,
      "text": "兴义在贵州的西南角属于黔西南州这个城市，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 524400,
      "end_ms": 526140,
      "text": "很多人没来过也没听过，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 526560,
      "end_ms": 530720,
      "text": "可它藏着一个在中国都排得上号的风景。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 530740,
      "end_ms": 531525,
      "text": "万枫林，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 531770,
      "end_ms": 533175,
      "text": "什么叫万峰林呢？"
    },
    {
      "segment_id": "s000212",
      "start_ms": 533490,
      "end_ms": 535955,
      "text": "就是山峰密密麻麻多到数不过来，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 536350,
      "end_ms": 537150,
      "text": "一座挨着，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 537150,
      "end_ms": 538255,
      "text": "一座排在那里。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 539170,
      "end_ms": 540890,
      "text": "这些山是喀斯特地貌，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 541230,
      "end_ms": 542550,
      "text": "每一座都不高，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 542570,
      "end_ms": 543995,
      "text": "但形状各异，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 544360,
      "end_ms": 545160,
      "text": "像馒头，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 545480,
      "end_ms": 546280,
      "text": "像宝塔，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 546580,
      "end_ms": 547455,
      "text": "像笔尖，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 547940,
      "end_ms": 549300,
      "text": "一直排到天边，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 549380,
      "end_ms": 550265,
      "text": "看不到头。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 550760,
      "end_ms": 554300,
      "text": "山下面是一片一片的田田，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 554300,
      "end_ms": 556285,
      "text": "里面有弯弯曲曲的河，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 556730,
      "end_ms": 557935,
      "text": "河边有村庄，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 558720,
      "end_ms": 559160,
      "text": "冬天，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 559160,
      "end_ms": 561585,
      "text": "稻子收完了田是空的。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 561840,
      "end_ms": 563460,
      "text": "山是清的雾，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 563520,
      "end_ms": 565520,
      "text": "从山脚底下慢慢往上爬，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 565900,
      "end_ms": 568185,
      "text": "整个画面像一幅水墨，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 568830,
      "end_ms": 570290,
      "text": "您在兴义租个房子，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 570290,
      "end_ms": 571470,
      "text": "推开窗户往外看，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 571470,
      "end_ms": 573350,
      "text": "满眼全是山峰排在眼前。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 573550,
      "end_ms": 577015,
      "text": "这种待遇在别的城市花多少钱都买不来。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 577870,
      "end_ms": 581125,
      "text": "兴义冬天比前面几个城市凉一点，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 581500,
      "end_ms": 582440,
      "text": "可他是干冷，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 582440,
      "end_ms": 583255,
      "text": "不是湿冷，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 584020,
      "end_ms": 585555,
      "text": "太阳一出来就暖了，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 586200,
      "end_ms": 588475,
      "text": "而且新意的空气特别干净，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 588930,
      "end_ms": 589690,
      "text": "吸一口气，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 589710,
      "end_ms": 593445,
      "text": "清清爽爽的跟城市里的空气完全不是一回事。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 594290,
      "end_ms": 599060,
      "text": "兴义的物价是这十个城市里最低一档租房便宜，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 599260,
      "end_ms": 600515,
      "text": "吃饭更便宜。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 601010,
      "end_ms": 602745,
      "text": "当地有一种羊肉粉，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 603180,
      "end_ms": 605200,
      "text": "冬天早上来一碗汤，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 605340,
      "end_ms": 606875,
      "text": "是羊骨头熬的。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 607330,
      "end_ms": 609110,
      "text": "粉是手工切的宽粉，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 609230,
      "end_ms": 610970,
      "text": "上面盖着大片的羊肉，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 611390,
      "end_ms": 612350,
      "text": "撒一把葱花，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 612370,
      "end_ms": 613430,
      "text": "浇一勺辣椒油，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 613910,
      "end_ms": 615090,
      "text": "热乎乎的下肚，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 615430,
      "end_ms": 618270,
      "text": "整个人从胃暖到脚底板，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 619150,
      "end_ms": 620190,
      "text": "花不了多少钱，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 620510,
      "end_ms": 622150,
      "text": "管一上午的饱和，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 622150,
      "end_ms": 623950,
      "text": "暖房租便宜，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 624210,
      "end_ms": 625210,
      "text": "羊肉粉管饱。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 625210,
      "end_ms": 627070,
      "text": "又管暖推开窗户，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 627090,
      "end_ms": 627850,
      "text": "满眼是山，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 628630,
      "end_ms": 629750,
      "text": "兴意排第六。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 630550,
      "end_ms": 630950,
      "text": "不是，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 630950,
      "end_ms": 631490,
      "text": "它不够，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 631490,
      "end_ms": 634610,
      "text": "好是前面五个各有各的绝活。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 635610,
      "end_ms": 639000,
      "text": "先在评论区打出四个字过冬，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 639040,
      "end_ms": 640160,
      "text": "秘境打完了，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 640160,
      "end_ms": 641580,
      "text": "咱们接着讲前五名，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 641900,
      "end_ms": 644340,
      "text": "一个比一个让人想直接订票。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 645300,
      "end_ms": 647020,
      "text": "今天讲的这五个城市，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 647020,
      "end_ms": 650380,
      "text": "您品品湛江的碳烤生蚝便宜到不敢信。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 650860,
      "end_ms": 652420,
      "text": "蒙自的过桥米线，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 652500,
      "end_ms": 655960,
      "text": "正宗到别处没法比防城港退潮了，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 655960,
      "end_ms": 657680,
      "text": "自己去捡不花钱的海鲜。"
    },
    {
      "segment_id": "s000272",
      "start_ms": 658360,
      "end_ms": 659900,
      "text": "西昌湖边晒太阳，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 659900,
      "end_ms": 662140,
      "text": "看候鸟轻易推开窗户，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 662140,
      "end_ms": 663060,
      "text": "满眼全是山。"
    },
    {
      "segment_id": "s000275",
      "start_ms": 663720,
      "end_ms": 666985,
      "text": "可这五个加一块都比不过前五。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 667110,
      "end_ms": 670055,
      "text": "武鸣里的那个小城跟三亚共用一片海，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 670950,
      "end_ms": 673595,
      "text": "房租比三亚便宜太多了。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 674030,
      "end_ms": 676325,
      "text": "冬天的海滩上愣是看不见几个人，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 677190,
      "end_ms": 679395,
      "text": "前五名里还有一个客家古城，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 680200,
      "end_ms": 682200,
      "text": "光早餐就能换着花样吃，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 682200,
      "end_ms": 683160,
      "text": "一个月不重样。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 683180,
      "end_ms": 683940,
      "text": "有一个地方。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 683940,
      "end_ms": 685845,
      "text": "冬天的海滩整片都是你的，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 686350,
      "end_ms": 688255,
      "text": "夏天花钱都挤不进去，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 689020,
      "end_ms": 692975,
      "text": "还有一座茶城坐下来能喝一下午的古树茶，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 693930,
      "end_ms": 697060,
      "text": "下一集已经同步更新点，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 697060,
      "end_ms": 698040,
      "text": "我头像进主页，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 698040,
      "end_ms": 701725,
      "text": "第一条就是咱们接着接前五名。"
    }
  ],
  "source_transcript_sha256": "73109c20f5e1c519d343488e1bba0a03a1eeea2c9edc8034112e8824daaf3019"
}