{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_7ace1d24442d99c9_u001",
  "video_id": "v_7ace1d24442d99c9",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 574.95,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 350,
      "end_ms": 3190,
      "text": "十分钟讲解阿里斯特基督教神学导论。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3430,
      "end_ms": 7030,
      "text": "今天我们来看看牛津大学那位最不务正业的跨界奇人。"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7290,
      "end_ms": 11390,
      "text": "阿里斯特麦格拉斯的基督教神学导论这部书有多牛？"
    },
    {
      "segment_id": "s000004",
      "start_ms": 11870,
      "end_ms": 12470,
      "text": "这么说吧，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 12870,
      "end_ms": 14030,
      "text": "豆瓣评分九点一，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 14250,
      "end_ms": 17670,
      "text": "被誉为神学领域普遍适用的教材佳作，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 18150,
      "end_ms": 20790,
      "text": "一本教科书级别的著作能拿到这个分数。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 20870,
      "end_ms": 21690,
      "text": "你见过几本？"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21850,
      "end_ms": 22530,
      "text": "话不多说，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 22550,
      "end_ms": 26110,
      "text": "我们现在就开始我们的主人公阿里斯特麦格拉斯，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 26290,
      "end_ms": 29170,
      "text": "一九五三年出生在北爱尔兰贝尔法斯特，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 29230,
      "end_ms": 33860,
      "text": "后来获得牛津大学神学、文学和分子生物物理学三个博士学位。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 33920,
      "end_ms": 36020,
      "text": "他早年是个彻头彻尾的无神论者，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 36240,
      "end_ms": 38700,
      "text": "还在大学里倾心于某种社会批判理论，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 39000,
      "end_ms": 40980,
      "text": "觉得凡是科学回答不了的问题，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 41000,
      "end_ms": 42360,
      "text": "都不值得认真对待。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 42420,
      "end_ms": 44220,
      "text": "可就在牛津读化学的那些年，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 44360,
      "end_ms": 45820,
      "text": "他的人生拐了一个大弯，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 46000,
      "end_ms": 48460,
      "text": "他开始重新思考一个最根本的问题。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 48720,
      "end_ms": 51640,
      "text": "这世界上除了可以被测量、被计算的东西之外，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 51760,
      "end_ms": 53660,
      "text": "到底还有没有另一种真实？"
    },
    {
      "segment_id": "s000022",
      "start_ms": 54220,
      "end_ms": 55760,
      "text": "这个问题一旦钻进脑子，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 55900,
      "end_ms": 57080,
      "text": "就再也拔不出来了。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 57600,
      "end_ms": 58040,
      "text": "于是，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 58120,
      "end_ms": 60775,
      "text": "他一边在实验室里研究分子生物物理，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 61090,
      "end_ms": 64005,
      "text": "一边开始啃那些积满灰尘的思想史典籍。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 64380,
      "end_ms": 67200,
      "text": "最终在二十二岁拿到分子生物学博士学位。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 67200,
      "end_ms": 69700,
      "text": "之后又转向了思想的深水区，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 69920,
      "end_ms": 71635,
      "text": "拿下了神学博士学位。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 71970,
      "end_ms": 74030,
      "text": "他后来在牛津大学教了几十年书，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 74230,
      "end_ms": 77765,
      "text": "把毕生所学浓缩成了一部基督教神学导论。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 78290,
      "end_ms": 80975,
      "text": "这部书的写法跟一般的入门读物完全不同。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 81330,
      "end_ms": 83245,
      "text": "他不急着告诉你结论是什么，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 83570,
      "end_ms": 85535,
      "text": "而是像一个经验老道的侦探，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 85860,
      "end_ms": 89020,
      "text": "把几千年思想史上那些最聪明的大脑怎么炒，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 89300,
      "end_ms": 89885,
      "text": "怎么变，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 90180,
      "end_ms": 92480,
      "text": "怎么推翻对方又重新建立的过程，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 92760,
      "end_ms": 94240,
      "text": "一层一层给你剥开。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 94320,
      "end_ms": 95255,
      "text": "那么问题来了，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 95490,
      "end_ms": 97925,
      "text": "这部书到底是怎么把思想史看透的呢？"
    },
    {
      "segment_id": "s000041",
      "start_ms": 98330,
      "end_ms": 100015,
      "text": "这就要从书的结构说起。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 100310,
      "end_ms": 101650,
      "text": "全书分三大部分，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 101850,
      "end_ms": 103195,
      "text": "第一部分追踪历史，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 103480,
      "end_ms": 105920,
      "text": "从最早的教父时期一路讲到现代。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 106060,
      "end_ms": 107880,
      "text": "第二部分探讨来源和方法，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 108080,
      "end_ms": 109620,
      "text": "也就是理性经验。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 109740,
      "end_ms": 111260,
      "text": "传统这些工具怎么用？"
    },
    {
      "segment_id": "s000048",
      "start_ms": 111320,
      "end_ms": 114100,
      "text": "第三部分才进入核心主题的逐一切磋。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 114220,
      "end_ms": 115040,
      "text": "你注意到没有？"
    },
    {
      "segment_id": "s000050",
      "start_ms": 115260,
      "end_ms": 116620,
      "text": "它不像一般的教科书那样，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 116620,
      "end_ms": 117615,
      "text": "先给你灌概念，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 117880,
      "end_ms": 119300,
      "text": "而是先带你走一遍历史。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 119420,
      "end_ms": 119995,
      "text": "为什么？"
    },
    {
      "segment_id": "s000054",
      "start_ms": 120410,
      "end_ms": 121705,
      "text": "因为他太清楚了，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 121990,
      "end_ms": 123965,
      "text": "思想不是从天上掉下来的，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 124250,
      "end_ms": 128845,
      "text": "每一个看起来理所当然的结论背后都有一场你死我活的辩论道。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 129130,
      "end_ms": 131435,
      "text": "我们现在来讲这部书最核心的一个问题，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 131770,
      "end_ms": 133465,
      "text": "理性与信仰的关系。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 133780,
      "end_ms": 135080,
      "text": "我换个说法你就明白了。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 135080,
      "end_ms": 138620,
      "text": "麦格拉斯就像是一个在两座山头之间架桥的工程师，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 138700,
      "end_ms": 139635,
      "text": "这头是理性，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 139970,
      "end_ms": 141115,
      "text": "那一头是信仰。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 141320,
      "end_ms": 143035,
      "text": "很多人以为这两座山是对立的，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 143310,
      "end_ms": 146075,
      "text": "要么你站理信那边把信仰当成迷信扔掉。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 146410,
      "end_ms": 149685,
      "text": "要么你在信仰这边把理性当成了傲慢的僭越。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 150070,
      "end_ms": 151255,
      "text": "可麦德拉斯告诉你，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 151490,
      "end_ms": 152485,
      "text": "事情没这么简单，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 153190,
      "end_ms": 156050,
      "text": "他在书里专门写了一章叫哲学与神学。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 156350,
      "end_ms": 157490,
      "text": "对话与争辩。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 157630,
      "end_ms": 158875,
      "text": "这一章讲的是什么？"
    },
    {
      "segment_id": "s000071",
      "start_ms": 159300,
      "end_ms": 163780,
      "text": "讲的是两千多年来哲学和思想之间那些精彩的过招。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 163920,
      "end_ms": 166785,
      "text": "从古希腊的苏格拉底到中世纪的经院哲学，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 167180,
      "end_ms": 170180,
      "text": "从启蒙运动的理性主义到现代的存在主义，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 170240,
      "end_ms": 172680,
      "text": "每一个时代的思想家都在问同一个问题，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 172940,
      "end_ms": 175179,
      "text": "我到底能不能靠自己的脑子？"
    },
    {
      "segment_id": "s000076",
      "start_ms": 175200,
      "end_ms": 176705,
      "text": "想明白终极的问题。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 176930,
      "end_ms": 179155,
      "text": "如果能那还需要别的什么吗？"
    },
    {
      "segment_id": "s000078",
      "start_ms": 179450,
      "end_ms": 180210,
      "text": "如果不能，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 180490,
      "end_ms": 183110,
      "text": "那我凭什么相信那些超越我理解的东西？"
    },
    {
      "segment_id": "s000080",
      "start_ms": 183270,
      "end_ms": 184975,
      "text": "麦格拉斯的态度很有意思，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 185250,
      "end_ms": 187375,
      "text": "他本身受过严格的自然科学训练，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 187680,
      "end_ms": 189075,
      "text": "深知科学的威力。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 189530,
      "end_ms": 191365,
      "text": "但他也清醒的意识到一个界限，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 191660,
      "end_ms": 194555,
      "text": "科学处理的是可以被经验检验的问题。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 195010,
      "end_ms": 195950,
      "text": "而有些问题，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 196090,
      "end_ms": 197730,
      "text": "比如人为什么活着，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 197930,
      "end_ms": 199150,
      "text": "苦难有没有意义？"
    },
    {
      "segment_id": "s000088",
      "start_ms": 199310,
      "end_ms": 200625,
      "text": "死亡之后是什么？"
    },
    {
      "segment_id": "s000089",
      "start_ms": 200890,
      "end_ms": 203335,
      "text": "根本就不在科学的方法论射程之内。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 203670,
      "end_ms": 204890,
      "text": "你说这些问题不重要，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 205130,
      "end_ms": 208145,
      "text": "那你就等于说人生中最重要的那些时刻都不重要。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 208900,
      "end_ms": 212800,
      "text": "这就是全书的第一把密钥叫理性与信仰的张力。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 212920,
      "end_ms": 213860,
      "text": "麦格拉斯发现，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 214160,
      "end_ms": 216145,
      "text": "思想史上最伟大的那些头脑，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 216400,
      "end_ms": 219085,
      "text": "从来不是在理性和信仰之间二选一，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 219430,
      "end_ms": 222430,
      "text": "而是在两者的张力中找到了更深的洞见。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 222430,
      "end_ms": 224005,
      "text": "李性像一把锋利的刀，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 224270,
      "end_ms": 225450,
      "text": "他帮你切开迷雾，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 225610,
      "end_ms": 227025,
      "text": "看清逻辑的纹理，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 227580,
      "end_ms": 229120,
      "text": "信仰像一片辽阔的天。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 229460,
      "end_ms": 230780,
      "text": "他给你一个立足之处，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 231000,
      "end_ms": 232920,
      "text": "让你不至于在切完一切之后，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 232980,
      "end_ms": 234460,
      "text": "发现自己站在虚空之上。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 234700,
      "end_ms": 235805,
      "text": "两者不是敌人，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 236120,
      "end_ms": 238105,
      "text": "而是一对互相成全的老搭档。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 238470,
      "end_ms": 239750,
      "text": "你以为你只能选一个，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 239910,
      "end_ms": 242195,
      "text": "其实你每一步都在同时使用它们，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 242990,
      "end_ms": 245205,
      "text": "可光是理性和信仰的张力还不够。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 245800,
      "end_ms": 246525,
      "text": "有人会问了，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 246760,
      "end_ms": 247460,
      "text": "你说了半天，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 247460,
      "end_ms": 250955,
      "text": "思想史这些古代人的争论跟我们今天有什么关系？"
    },
    {
      "segment_id": "s000112",
      "start_ms": 251520,
      "end_ms": 254340,
      "text": "这个问题问的好麦格拉斯在书里反复强调，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 254340,
      "end_ms": 254925,
      "text": "一个观点，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 255350,
      "end_ms": 260365,
      "text": "现时代的一切思想都建基于历史之上抽离开思想的历史。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 260630,
      "end_ms": 263605,
      "text": "你根本无法理解今天的人为什么这样想问题？"
    },
    {
      "segment_id": "s000116",
      "start_ms": 263880,
      "end_ms": 267050,
      "text": "这就是第二把密钥叫历史与真理的追问。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 267110,
      "end_ms": 270515,
      "text": "麦格拉斯在书的第一部分专门梳理了四个大时代。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 270940,
      "end_ms": 274680,
      "text": "教父时期中世纪与文艺复兴改革时期，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 274880,
      "end_ms": 275700,
      "text": "现代时期，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 275760,
      "end_ms": 278805,
      "text": "每一个时代都有它的核心焦虑和核心答案。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 279090,
      "end_ms": 280325,
      "text": "教父时期的人在问，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 280630,
      "end_ms": 283970,
      "text": "这个新兴的思想体系跟古希腊哲学到底什么关系？"
    },
    {
      "segment_id": "s000123",
      "start_ms": 284030,
      "end_ms": 285175,
      "text": "中世纪的人在问，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 285400,
      "end_ms": 287425,
      "text": "理性和启示能不能共存？"
    },
    {
      "segment_id": "s000125",
      "start_ms": 287750,
      "end_ms": 288910,
      "text": "改革时期的人在问，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 289210,
      "end_ms": 291145,
      "text": "传统和原点谁说了算？"
    },
    {
      "segment_id": "s000127",
      "start_ms": 291550,
      "end_ms": 294760,
      "text": "现代时期的人在问当一切都可以被怀疑的时候，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 294840,
      "end_ms": 295755,
      "text": "还剩什么？"
    },
    {
      "segment_id": "s000129",
      "start_ms": 296270,
      "end_ms": 297085,
      "text": "你发现没有？"
    },
    {
      "segment_id": "s000130",
      "start_ms": 297420,
      "end_ms": 298895,
      "text": "这些问题换了一副面孔。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 299290,
      "end_ms": 300930,
      "text": "但内核从来没有变过。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 301010,
      "end_ms": 303450,
      "text": "我们今天在社交媒体上争论的那些话题，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 303870,
      "end_ms": 306090,
      "text": "传统该不该保留权威，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 306110,
      "end_ms": 308710,
      "text": "能不能质疑个人经验算不算数？"
    },
    {
      "segment_id": "s000135",
      "start_ms": 308890,
      "end_ms": 313630,
      "text": "本质上都是几百年前那些思想家用毕生精力在辩论的问题的翻版。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 313810,
      "end_ms": 314470,
      "text": "麦格拉斯，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 314470,
      "end_ms": 316730,
      "text": "把这些辩论的历史脉络给你理清楚，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 317030,
      "end_ms": 320030,
      "text": "你再看今天的事儿就不会觉得那么晕头转向了。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 320150,
      "end_ms": 322650,
      "text": "那这部书到底还有没有更具体的硬货？"
    },
    {
      "segment_id": "s000140",
      "start_ms": 322950,
      "end_ms": 326010,
      "text": "当然有你翻到第二部分来源与方法。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 326510,
      "end_ms": 328430,
      "text": "麦格拉斯干了一件特别漂亮的事儿，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 328430,
      "end_ms": 332140,
      "text": "他把思想史上用来判断真伪的那几把尺子，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 332440,
      "end_ms": 334120,
      "text": "一把一把摆在你面前，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 334320,
      "end_ms": 335260,
      "text": "让你自己去量。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 335400,
      "end_ms": 336700,
      "text": "第一把尺子是文本，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 336980,
      "end_ms": 339380,
      "text": "就是那些被反复引用的原始文献，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 339720,
      "end_ms": 341240,
      "text": "他们是思想的源代码。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 341480,
      "end_ms": 342860,
      "text": "第二把尺子是理性，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 343160,
      "end_ms": 345060,
      "text": "就是逻辑和推论的能力。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 345360,
      "end_ms": 346860,
      "text": "他负责检验一套说法，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 346860,
      "end_ms": 348060,
      "text": "在内部是否自洽。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 348200,
      "end_ms": 348540,
      "text": "第三，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 348540,
      "end_ms": 349680,
      "text": "把尺子是传统，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 350020,
      "end_ms": 352480,
      "text": "就是历代积累下来的共识和争论。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 352840,
      "end_ms": 355300,
      "text": "他告诉你哪些路前人已经走过了，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 355340,
      "end_ms": 355900,
      "text": "哪些坑，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 355980,
      "end_ms": 357100,
      "text": "前人也踩过了。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 357180,
      "end_ms": 357520,
      "text": "第四，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 357520,
      "end_ms": 358440,
      "text": "把尺子是经验，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 358440,
      "end_ms": 360590,
      "text": "就是你作为一个活生生的人，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 360890,
      "end_ms": 362890,
      "text": "在实际生活里感受到的东西。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 362970,
      "end_ms": 364150,
      "text": "麦格拉斯没有告诉你，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 364150,
      "end_ms": 365325,
      "text": "哪把尺子最好用。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 365730,
      "end_ms": 367285,
      "text": "他把四把尺子都递给你，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 367490,
      "end_ms": 369025,
      "text": "然后说你自己掂量，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 369590,
      "end_ms": 371155,
      "text": "这是一种特别高级的写法，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 371600,
      "end_ms": 374300,
      "text": "他不告诉你怎么想他让你自己学会。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 374300,
      "end_ms": 375505,
      "text": "想你可能会问了，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 375940,
      "end_ms": 379815,
      "text": "麦格拉斯这些跨学科的背景到底给了他什么不一样的东西？"
    },
    {
      "segment_id": "s000170",
      "start_ms": 380220,
      "end_ms": 380895,
      "text": "我告诉你，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 381180,
      "end_ms": 382035,
      "text": "太不一样了。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 382440,
      "end_ms": 383700,
      "text": "一个只懂思想的人，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 383700,
      "end_ms": 385845,
      "text": "写思想史容易飘在半空中。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 386280,
      "end_ms": 387480,
      "text": "一个只懂科学的人，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 387480,
      "end_ms": 388235,
      "text": "写思想史，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 388520,
      "end_ms": 390395,
      "text": "容易把一切都简化成公式。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 390690,
      "end_ms": 393335,
      "text": "而麦格拉斯两只脚踩在两个世界里，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 393680,
      "end_ms": 395880,
      "text": "他的写法有一种罕见的清醒，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 396040,
      "end_ms": 398140,
      "text": "他既不会被漂亮的理论忽悠住，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 398380,
      "end_ms": 401000,
      "text": "也不会因为一个论证不符合科学规范，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 401000,
      "end_ms": 402200,
      "text": "就把他一棒子打死。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 402320,
      "end_ms": 404180,
      "text": "他在科学与思想的交界地带，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 404180,
      "end_ms": 405025,
      "text": "走来走去，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 405290,
      "end_ms": 406575,
      "text": "哪边的风景都看过，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 406840,
      "end_ms": 408395,
      "text": "所以哪边的话他都能听懂。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 408950,
      "end_ms": 409690,
      "text": "这就是第三，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 409690,
      "end_ms": 412130,
      "text": "把密钥叫跨界者的清醒。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 412330,
      "end_ms": 413150,
      "text": "他自己说过，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 413290,
      "end_ms": 413970,
      "text": "科学史上，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 413970,
      "end_ms": 416915,
      "text": "每一代科学家都在推翻上一代人的结论。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 417250,
      "end_ms": 420595,
      "text": "即使那些结论在当时被坚信为绝对正确，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 420880,
      "end_ms": 422475,
      "text": "这句话背后的意思太深了，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 422980,
      "end_ms": 425935,
      "text": "连科学本身都不是铁板一块的真理，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 426200,
      "end_ms": 428600,
      "text": "你凭什么觉得你手里那个绝对正确的答案，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 428600,
      "end_ms": 429655,
      "text": "就一定是终点，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 429910,
      "end_ms": 431390,
      "text": "让我们回到全书的起点？"
    },
    {
      "segment_id": "s000197",
      "start_ms": 431390,
      "end_ms": 432345,
      "text": "再想一个问题，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 432640,
      "end_ms": 434265,
      "text": "麦格拉斯为什么要写这本书？"
    },
    {
      "segment_id": "s000199",
      "start_ms": 434870,
      "end_ms": 437330,
      "text": "他本可以只写一本高深的学术著作，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 437450,
      "end_ms": 438565,
      "text": "只给圈内人看。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 439110,
      "end_ms": 441215,
      "text": "可他偏偏选择了导论的形式，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 441480,
      "end_ms": 444875,
      "text": "一部让没有任何基础的人也能进入的入门书。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 445330,
      "end_ms": 445875,
      "text": "为什么？"
    },
    {
      "segment_id": "s000204",
      "start_ms": 446160,
      "end_ms": 446915,
      "text": "因为他相信，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 447190,
      "end_ms": 449145,
      "text": "那些看似遥远的思想辩论，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 449410,
      "end_ms": 451845,
      "text": "其实关乎每一个人实实在在的生活。"
    },
    {
      "segment_id": "s000207",
      "start_ms": 452090,
      "end_ms": 453390,
      "text": "你不去想这些问题，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 453550,
      "end_ms": 454845,
      "text": "不代表他们不存在。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 455220,
      "end_ms": 456040,
      "text": "你想不清楚，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 456300,
      "end_ms": 460685,
      "text": "不代表他们不会在你人生最脆弱的时刻突然冒出来让你手足无措。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 461190,
      "end_ms": 462875,
      "text": "那这部书到底给了我们什么？"
    },
    {
      "segment_id": "s000212",
      "start_ms": 463450,
      "end_ms": 465795,
      "text": "他给的不是一套让你拿去炫耀的知识，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 466200,
      "end_ms": 467455,
      "text": "而是一种思维方式，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 467880,
      "end_ms": 470925,
      "text": "一种在众说纷纭中保持清醒的能力。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 471630,
      "end_ms": 473505,
      "text": "当你面对一个复杂问题的时候，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 473760,
      "end_ms": 476625,
      "text": "你能不能像麦格拉斯那样先退后一步，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 476940,
      "end_ms": 479045,
      "text": "看看这个问题在历史上是怎么来的，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 479370,
      "end_ms": 480465,
      "text": "别人是怎么答的。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 480810,
      "end_ms": 483330,
      "text": "每种打法各有什么长处和短处，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 483530,
      "end_ms": 484510,
      "text": "你能做到这一点，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 484610,
      "end_ms": 486830,
      "text": "你就不会被那些听起来很有道理，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 486830,
      "end_ms": 489415,
      "text": "但其实经不起推敲的说法牵着鼻子走，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 489840,
      "end_ms": 491640,
      "text": "你就是一个真正会思考的人。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 491720,
      "end_ms": 492580,
      "text": "故事讲到这里，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 492740,
      "end_ms": 493940,
      "text": "我想让你记住一件事。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 494100,
      "end_ms": 495780,
      "text": "麦格拉斯在书里说过一段话，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 496100,
      "end_ms": 496975,
      "text": "大意是说，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 497420,
      "end_ms": 500275,
      "text": "知识性的梳理只是思想在历史中的效应，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 500690,
      "end_ms": 504390,
      "text": "真正的思考永远比知识体系更丰富、更鲜活。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 504750,
      "end_ms": 508670,
      "text": "这句话什么意思意思是说你不要以为读完一本导论，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 508670,
      "end_ms": 509610,
      "text": "就什么都懂了，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 509950,
      "end_ms": 511565,
      "text": "导论只是给你一把钥匙，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 512050,
      "end_ms": 514005,
      "text": "真正的门要你自己去推。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 514350,
      "end_ms": 515130,
      "text": "但反过来说，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 515430,
      "end_ms": 516390,
      "text": "没有这把钥匙，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 516570,
      "end_ms": 518410,
      "text": "你可能连门在哪里都找不到。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 518550,
      "end_ms": 520010,
      "text": "读完基督教神学导论。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 520270,
      "end_ms": 523855,
      "text": "希望我们在每一次面对那些说不清道不明的困惑时，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 524340,
      "end_ms": 527605,
      "text": "心里都能想起麦格拉斯在牛津讲台上的那句话。"
    },
    {
      "segment_id": "s000240",
      "start_ms": 528120,
      "end_ms": 529300,
      "text": "先别急着下结论，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 529620,
      "end_ms": 531415,
      "text": "让我把这段历史讲给你听。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 531980,
      "end_ms": 533935,
      "text": "世界从来不是非黑即白的，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 534310,
      "end_ms": 536475,
      "text": "不是在浮躁的争论里固执的战队，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 536820,
      "end_ms": 539975,
      "text": "而是安安静静的做一个清醒的追问者。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 540250,
      "end_ms": 543625,
      "text": "毕竟能在这么多声音同时响起的时代里，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 543930,
      "end_ms": 545870,
      "text": "找到一种属于自己的思考方式。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 546050,
      "end_ms": 548735,
      "text": "这本身就是一种极高明的智慧。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 549030,
      "end_ms": 551975,
      "text": "如果你也想拥有这样一台思想界的x光机，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 552380,
      "end_ms": 555415,
      "text": "今天就把这本基督教神学导论带回家。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 556360,
      "end_ms": 559165,
      "text": "它不是那种翻一遍就放在书架上吃灰的书，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 559620,
      "end_ms": 562975,
      "text": "它是那种你每隔一段时间就想拿出来翻一翻的书，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 563780,
      "end_ms": 566730,
      "text": "因为你每成长一步读出来的东西都不一样。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 566930,
      "end_ms": 568350,
      "text": "经典之所以是经典，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 568610,
      "end_ms": 571395,
      "text": "就是因为它永远比你以为的更深一层。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 571890,
      "end_ms": 572705,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 573080,
      "end_ms": 574825,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "a07fa7e5fa321b57d46eac95aca24ae0a79f0cfce6069d8943079de788a6aa43"
}