{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_fc3786ad66dc77e3_u002",
  "video_id": "v_fc3786ad66dc77e3",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 1003.033991,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000445",
      "start_ms": 894760,
      "end_ms": 896820,
      "text": "他更像一把钝刀慢慢磨。"
    },
    {
      "segment_id": "s000446",
      "start_ms": 897540,
      "end_ms": 897960,
      "text": "第二，"
    },
    {
      "segment_id": "s000447",
      "start_ms": 898340,
      "end_ms": 900540,
      "text": "海德格尔的个人历史有严重污点。"
    },
    {
      "segment_id": "s000448",
      "start_ms": 901020,
      "end_ms": 903080,
      "text": "他曾加入纳粹这段历史，"
    },
    {
      "segment_id": "s000449",
      "start_ms": 903080,
      "end_ms": 903760,
      "text": "无法回避，"
    },
    {
      "segment_id": "s000450",
      "start_ms": 904120,
      "end_ms": 905260,
      "text": "你可以读他的哲学，"
    },
    {
      "segment_id": "s000451",
      "start_ms": 905500,
      "end_ms": 907780,
      "text": "但不能因为哲学深刻就替他洗白。"
    },
    {
      "segment_id": "s000452",
      "start_ms": 908460,
      "end_ms": 910880,
      "text": "思想伟大不等于人格无瑕，"
    },
    {
      "segment_id": "s000453",
      "start_ms": 911160,
      "end_ms": 913400,
      "text": "一个人可以问出极深的存在问题，"
    },
    {
      "segment_id": "s000454",
      "start_ms": 913700,
      "end_ms": 916400,
      "text": "也可以在现实中做出极坏的政治选择。"
    },
    {
      "segment_id": "s000455",
      "start_ms": 917000,
      "end_ms": 919580,
      "text": "这两件事同时存在才是真实的人。"
    },
    {
      "segment_id": "s000456",
      "start_ms": 920120,
      "end_ms": 920580,
      "text": "第三，"
    },
    {
      "segment_id": "s000457",
      "start_ms": 921080,
      "end_ms": 924510,
      "text": "海德格尔对常人沉沦的批评容易被读成经验。"
    },
    {
      "segment_id": "s000458",
      "start_ms": 924630,
      "end_ms": 925550,
      "text": "新主义，"
    },
    {
      "segment_id": "s000459",
      "start_ms": 925550,
      "end_ms": 927370,
      "text": "好像只有少数人能本真，"
    },
    {
      "segment_id": "s000460",
      "start_ms": 927670,
      "end_ms": 928810,
      "text": "普通人就是麻木。"
    },
    {
      "segment_id": "s000461",
      "start_ms": 929110,
      "end_ms": 929890,
      "text": "可现实里，"
    },
    {
      "segment_id": "s000462",
      "start_ms": 930110,
      "end_ms": 931270,
      "text": "很多常人的活法，"
    },
    {
      "segment_id": "s000463",
      "start_ms": 931430,
      "end_ms": 934070,
      "text": "恰恰是普通人在有限条件下的互相支撑，"
    },
    {
      "segment_id": "s000464",
      "start_ms": 934170,
      "end_ms": 935930,
      "text": "不是每个人都必须向死而生，"
    },
    {
      "segment_id": "s000465",
      "start_ms": 936390,
      "end_ms": 938090,
      "text": "有时候能好好吃饭，"
    },
    {
      "segment_id": "s000466",
      "start_ms": 938390,
      "end_ms": 939590,
      "text": "上班养家，"
    },
    {
      "segment_id": "s000467",
      "start_ms": 939850,
      "end_ms": 944190,
      "text": "爱人本身就是一种承担海德格尔的框架很有力量，"
    },
    {
      "segment_id": "s000468",
      "start_ms": 944590,
      "end_ms": 945810,
      "text": "但不能把它当锤子，"
    },
    {
      "segment_id": "s000469",
      "start_ms": 945850,
      "end_ms": 946650,
      "text": "见谁敲谁。"
    },
    {
      "segment_id": "s000470",
      "start_ms": 946930,
      "end_ms": 947310,
      "text": "所以，"
    },
    {
      "segment_id": "s000471",
      "start_ms": 947690,
      "end_ms": 951810,
      "text": "读存在与时间真正值得带走的不是一堆吓人的术语，"
    },
    {
      "segment_id": "s000472",
      "start_ms": 951810,
      "end_ms": 954005,
      "text": "而是几个能拆解日常的螺丝刀。"
    },
    {
      "segment_id": "s000473",
      "start_ms": 954520,
      "end_ms": 955320,
      "text": "存在论差异，"
    },
    {
      "segment_id": "s000474",
      "start_ms": 955460,
      "end_ms": 958145,
      "text": "让你别把标签当自己再是存在，"
    },
    {
      "segment_id": "s000475",
      "start_ms": 958380,
      "end_ms": 960240,
      "text": "让你别把自己从世界里孤立出来，"
    },
    {
      "segment_id": "s000476",
      "start_ms": 960280,
      "end_ms": 961355,
      "text": "放手与在手，"
    },
    {
      "segment_id": "s000477",
      "start_ms": 961660,
      "end_ms": 963435,
      "text": "让你别把生活全变成对象，"
    },
    {
      "segment_id": "s000478",
      "start_ms": 963710,
      "end_ms": 965200,
      "text": "常人让你警惕。"
    },
    {
      "segment_id": "s000479",
      "start_ms": 965280,
      "end_ms": 966845,
      "text": "大家都这样喂，"
    },
    {
      "segment_id": "s000480",
      "start_ms": 967270,
      "end_ms": 968835,
      "text": "让你别急着盖住不安，"
    },
    {
      "segment_id": "s000481",
      "start_ms": 969250,
      "end_ms": 970035,
      "text": "向死而生。"
    },
    {
      "segment_id": "s000482",
      "start_ms": 970320,
      "end_ms": 972995,
      "text": "让你把以后拉回现在时间性，"
    },
    {
      "segment_id": "s000483",
      "start_ms": 973320,
      "end_ms": 975305,
      "text": "让你知道你不是钟表上的一个点。"
    },
    {
      "segment_id": "s000484",
      "start_ms": 976420,
      "end_ms": 977380,
      "text": "如果你读到这里，"
    },
    {
      "segment_id": "s000485",
      "start_ms": 977560,
      "end_ms": 978865,
      "text": "还没被这些词吓跑，"
    },
    {
      "segment_id": "s000486",
      "start_ms": 979250,
      "end_ms": 980845,
      "text": "我反而想委婉的说一句，"
    },
    {
      "segment_id": "s000487",
      "start_ms": 981520,
      "end_ms": 983965,
      "text": "也许你可以找一本存在与时间来翻翻，"
    },
    {
      "segment_id": "s000488",
      "start_ms": 984230,
      "end_ms": 985365,
      "text": "不用从第一页硬啃。"
    },
    {
      "segment_id": "s000489",
      "start_ms": 985780,
      "end_ms": 987835,
      "text": "先读导论再读此带分析，"
    },
    {
      "segment_id": "s000490",
      "start_ms": 988250,
      "end_ms": 989775,
      "text": "配合一本靠谱的导读书，"
    },
    {
      "segment_id": "s000491",
      "start_ms": 990350,
      "end_ms": 992015,
      "text": "他不会让你立刻升职加薪，"
    },
    {
      "segment_id": "s000492",
      "start_ms": 992500,
      "end_ms": 994285,
      "text": "也不会让你从此不焦虑。"
    },
    {
      "segment_id": "s000493",
      "start_ms": 994890,
      "end_ms": 998045,
      "text": "但他可能让你在某个深夜第一次认真问自己，"
    },
    {
      "segment_id": "s000494",
      "start_ms": 998460,
      "end_ms": 999335,
      "text": "我到底是谁，"
    },
    {
      "segment_id": "s000495",
      "start_ms": 999770,
      "end_ms": 1001390,
      "text": "我到底再怎么活？"
    },
    {
      "segment_id": "s000496",
      "start_ms": 1001510,
      "end_ms": 1002190,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000497",
      "start_ms": 1002270,
      "end_ms": 1002975,
      "text": "我们下本书。"
    }
  ],
  "source_transcript_sha256": "c7db2f699fe4b710a55e6b31994f89597d937e716c658e0d507c25a671dee1c8"
}