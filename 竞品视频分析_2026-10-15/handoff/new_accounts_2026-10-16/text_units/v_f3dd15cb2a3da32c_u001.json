{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_f3dd15cb2a3da32c_u001",
  "video_id": "v_f3dd15cb2a3da32c",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 574.416009,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 190,
      "end_ms": 5610,
      "text": "本视频九分钟讲透冯友兰中国哲学简史中八个核心主题思想，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 5810,
      "end_ms": 6690,
      "text": "建议先收藏，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6750,
      "end_ms": 12850,
      "text": "再观看你是否曾在喧嚣日常中蓦然驻足思考生命真正的意义何在？"
    },
    {
      "segment_id": "s000004",
      "start_ms": 13230,
      "end_ms": 14770,
      "text": "或翻阅千年前的古籍，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 15250,
      "end_ms": 18890,
      "text": "却惊奇发现那些智慧依然照亮今日的迷惘。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 19350,
      "end_ms": 22650,
      "text": "冯友兰的中国哲学简史正是这样一部杰作，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 23370,
      "end_ms": 25830,
      "text": "他以世界性的视野、通彻的笔触，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 26150,
      "end_ms": 28950,
      "text": "将中国哲学的千年脉络娓娓道来。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 29350,
      "end_ms": 29905,
      "text": "他追问，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 30420,
      "end_ms": 31720,
      "text": "人应当怎样生活，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 32080,
      "end_ms": 34180,
      "text": "又如何抵达精神的至高境界。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 34660,
      "end_ms": 36880,
      "text": "他要为我们每一个迷茫的现代人，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 37240,
      "end_ms": 39200,
      "text": "找回那种能够安顿自己，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 39480,
      "end_ms": 41360,
      "text": "照亮现实的生命智慧。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 41760,
      "end_ms": 45000,
      "text": "从儒家的事业承担到道家的精神自由。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 45580,
      "end_ms": 46660,
      "text": "从禅宗的顿悟，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 46660,
      "end_ms": 47100,
      "text": "见性，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 47380,
      "end_ms": 49260,
      "text": "到宋明理学的通天彻地。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 49860,
      "end_ms": 50280,
      "text": "他说，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 50840,
      "end_ms": 53860,
      "text": "中国哲学的真正使命不是改变世界，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 54400,
      "end_ms": 55900,
      "text": "而是改变你的活法。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 55980,
      "end_ms": 59885,
      "text": "今天就让我们在八分钟里穿越两千年的风雨彻云，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 60050,
      "end_ms": 60320,
      "text": "嗯，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 60380,
      "end_ms": 63055,
      "text": "走进八个层层超声的人生境界。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 63400,
      "end_ms": 64025,
      "text": "你会发现，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 64430,
      "end_ms": 65775,
      "text": "那些最古老的智慧，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 66110,
      "end_ms": 68395,
      "text": "恰恰能回答你最现代的困惑。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 68780,
      "end_ms": 71275,
      "text": "八个思想主题如同八重境界，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 71600,
      "end_ms": 73220,
      "text": "引领我们步步行深，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 73520,
      "end_ms": 75100,
      "text": "最终叩问人生的意义。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 75100,
      "end_ms": 76905,
      "text": "与高度主题一，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 77530,
      "end_ms": 79255,
      "text": "哲学不再改变世界。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 79660,
      "end_ms": 80795,
      "text": "而在改变人心，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 81230,
      "end_ms": 86565,
      "text": "中国哲学自始就关注生命实践与心性修养而非纯粹思辨。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 87180,
      "end_ms": 88155,
      "text": "冯友兰指出，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 88640,
      "end_ms": 90060,
      "text": "儒家讲修齐，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 90200,
      "end_ms": 91700,
      "text": "治评道家谈，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 91840,
      "end_ms": 92825,
      "text": "返璞归真。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 93240,
      "end_ms": 93800,
      "text": "佛家说，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 93880,
      "end_ms": 94865,
      "text": "明心见性，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 95360,
      "end_ms": 99005,
      "text": "无一不是以人格完成和心灵转化为最终目的，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 99490,
      "end_ms": 103245,
      "text": "这与西方哲学重逻辑上自然的传统大不相同。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 104430,
      "end_ms": 106965,
      "text": "中国哲人更关心的是如何做人，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 107270,
      "end_ms": 108765,
      "text": "而不是何谓真实。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 109760,
      "end_ms": 111025,
      "text": "正如孔子所言，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 111470,
      "end_ms": 112655,
      "text": "古之学者为己，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 113300,
      "end_ms": 114160,
      "text": "真正的学问，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 114280,
      "end_ms": 115435,
      "text": "是向内用心，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 115860,
      "end_ms": 118355,
      "text": "成就一个更完整、更清醒的自我。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 119230,
      "end_ms": 121850,
      "text": "这提醒我们在功力喧嚣的时代，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 122050,
      "end_ms": 123805,
      "text": "更需回归内在的修养。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 124070,
      "end_ms": 124915,
      "text": "一段静坐，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 125260,
      "end_ms": 126015,
      "text": "一丝反思，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 126470,
      "end_ms": 129050,
      "text": "一个善念都是哲学的生活实践，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 129130,
      "end_ms": 131890,
      "text": "人生的质量终究来自于心灵的境界，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 132090,
      "end_ms": 134200,
      "text": "而非外在的占有主题。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 134200,
      "end_ms": 135915,
      "text": "二人生似境界，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 136270,
      "end_ms": 137655,
      "text": "从自然到天地。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 138450,
      "end_ms": 146405,
      "text": "冯友兰提出著名的人生四镜解说自然境界、功力境界、道德境界天地境界。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 147090,
      "end_ms": 148850,
      "text": "人最初寻本能行事，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 149190,
      "end_ms": 150910,
      "text": "进而追求利益与效率。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 151290,
      "end_ms": 154215,
      "text": "再往上能遵从道德关怀社会，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 154620,
      "end_ms": 157595,
      "text": "最终则可参赞天地与万物一体。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 158610,
      "end_ms": 159905,
      "text": "这不是严格的阶层，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 160360,
      "end_ms": 162165,
      "text": "而是心灵开放的次第。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 163150,
      "end_ms": 165615,
      "text": "我们可能在不同时刻处于不同境界，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 166340,
      "end_ms": 169855,
      "text": "但哲学的目标是帮助我们不断向上超生，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 170300,
      "end_ms": 172265,
      "text": "比如做同一件事，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 172630,
      "end_ms": 173725,
      "text": "可以只为谋生，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 174130,
      "end_ms": 175255,
      "text": "也可以为助人，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 175760,
      "end_ms": 177480,
      "text": "更可视为宇宙运行之一。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 177480,
      "end_ms": 180040,
      "text": "环这个学说让我们意识到，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 180440,
      "end_ms": 182605,
      "text": "生命的意义不在于做什么，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 182940,
      "end_ms": 185645,
      "text": "而在于以何种精神高度去做。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 185970,
      "end_ms": 186955,
      "text": "我们可尝自问，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 187310,
      "end_ms": 189705,
      "text": "此刻我正活在哪个境界？"
    },
    {
      "segment_id": "s000077",
      "start_ms": 190640,
      "end_ms": 191275,
      "text": "主题三，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 191880,
      "end_ms": 193900,
      "text": "中庸是一种动态的平衡，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 194200,
      "end_ms": 195285,
      "text": "而非平庸。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 195860,
      "end_ms": 197900,
      "text": "很多人误以为中庸就是妥协，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 197940,
      "end_ms": 200040,
      "text": "躺平不出头也不落后。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 200140,
      "end_ms": 204365,
      "text": "但冯友兰澄清中庸的真正精神是恰如其分，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 204860,
      "end_ms": 206500,
      "text": "是在变动不居的环境中，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 206720,
      "end_ms": 208780,
      "text": "始终找到最适合的那个点，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 208860,
      "end_ms": 211740,
      "text": "如同烹饪调火候、治国量、刑罚。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 212080,
      "end_ms": 214740,
      "text": "做人知进退中多强调时，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 214780,
      "end_ms": 216900,
      "text": "终及因时制宜，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 217040,
      "end_ms": 217995,
      "text": "不拘定法。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 218520,
      "end_ms": 220320,
      "text": "这是一种高明的实践智慧，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 220740,
      "end_ms": 222520,
      "text": "要求人既恪守原则，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 222740,
      "end_ms": 224085,
      "text": "又能灵活应对。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 224860,
      "end_ms": 228945,
      "text": "这启发我们真正的中庸不是灰蒙蒙的中间路线，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 229600,
      "end_ms": 233085,
      "text": "而是在极端之间保持清醒和平衡。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 233680,
      "end_ms": 236265,
      "text": "在面对压力选择或冲突时，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 236680,
      "end_ms": 239025,
      "text": "不求其强而求何宜。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 239650,
      "end_ms": 242495,
      "text": "主题四道家不是反文明，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 242870,
      "end_ms": 244255,
      "text": "而是反归本真。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 244840,
      "end_ms": 245775,
      "text": "冯友栏解析，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 246250,
      "end_ms": 247615,
      "text": "老子所说的无为，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 247970,
      "end_ms": 249075,
      "text": "并非什么都不做，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 249530,
      "end_ms": 251885,
      "text": "而是不强为不妄为，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 252380,
      "end_ms": 253985,
      "text": "遵循事物的内在规律，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 254280,
      "end_ms": 255695,
      "text": "而非强加人意。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 256230,
      "end_ms": 257570,
      "text": "庄子追求的逍遥，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 257770,
      "end_ms": 259050,
      "text": "也不是逃避社会，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 259390,
      "end_ms": 261350,
      "text": "而是心灵不被外物束缚，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 261570,
      "end_ms": 262905,
      "text": "达到精神自由。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 263930,
      "end_ms": 267995,
      "text": "道家思想批判的是过度人为搅视和控制，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 268500,
      "end_ms": 270260,
      "text": "呼吁回归自然和朴素。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 270480,
      "end_ms": 275915,
      "text": "这在今日仍极具启示我们是否被制度、标签和欲望绑架。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 276240,
      "end_ms": 277585,
      "text": "而忘了本心的声音。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 278110,
      "end_ms": 280765,
      "text": "真正的自由是从内在解除枷锁，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 281390,
      "end_ms": 282585,
      "text": "不必离群所居，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 283030,
      "end_ms": 284635,
      "text": "但可常常心理杂念，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 284980,
      "end_ms": 285860,
      "text": "减少造作，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 286200,
      "end_ms": 288760,
      "text": "活出真实、简单与从容。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 289060,
      "end_ms": 289400,
      "text": "主题。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 289400,
      "end_ms": 291045,
      "text": "五名实之辩，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 291570,
      "end_ms": 293865,
      "text": "语言无法完全捕捉真实。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 294260,
      "end_ms": 297205,
      "text": "中国哲学早已关注语言与世界的关系。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 297680,
      "end_ms": 299680,
      "text": "先秦的名时之辩就指出，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 300120,
      "end_ms": 303530,
      "text": "名并不等于实语言是工具，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 303690,
      "end_ms": 304625,
      "text": "而非实体。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 305040,
      "end_ms": 305600,
      "text": "儒家说，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 306000,
      "end_ms": 307515,
      "text": "名不正则言不顺。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 308060,
      "end_ms": 311460,
      "text": "提醒名时应统一道家则更彻底。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 311840,
      "end_ms": 316260,
      "text": "道可道非常道认为最高真理不可言说。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 316740,
      "end_ms": 319780,
      "text": "冯友兰借此强调不可将守概念，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 320220,
      "end_ms": 321940,
      "text": "而要看到背后的实相。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 322720,
      "end_ms": 324079,
      "text": "我们今天的许多争论，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 324340,
      "end_ms": 325760,
      "text": "其实是纠缠于名，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 326180,
      "end_ms": 326900,
      "text": "却忘了实。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 328120,
      "end_ms": 330020,
      "text": "比如争论怎样才算成功，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 330580,
      "end_ms": 332580,
      "text": "却忘了追问对我而言，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 332740,
      "end_ms": 334080,
      "text": "什么是丰盛的人生？"
    },
    {
      "segment_id": "s000136",
      "start_ms": 334440,
      "end_ms": 338620,
      "text": "这教导我们保持思维的弹性与开放性语言，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 338820,
      "end_ms": 340040,
      "text": "只是指月知止，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 340280,
      "end_ms": 341420,
      "text": "而非月亮本身。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 342160,
      "end_ms": 342500,
      "text": "主题。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 342500,
      "end_ms": 344840,
      "text": "六、中国哲学中的知与行，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 345220,
      "end_ms": 346920,
      "text": "本体与功夫的合一。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 346980,
      "end_ms": 351700,
      "text": "冯友兰特别梳理了知与行这一贯穿中国哲学史的核心线索。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 352620,
      "end_ms": 354340,
      "text": "儒家讲知行合一，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 354920,
      "end_ms": 357960,
      "text": "王阳明说知是行知史行，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 358060,
      "end_ms": 358900,
      "text": "是知之成，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 359660,
      "end_ms": 360160,
      "text": "真知，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 360240,
      "end_ms": 361340,
      "text": "必能付诸行动，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 361760,
      "end_ms": 363520,
      "text": "行动本身才是知的。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 363520,
      "end_ms": 366800,
      "text": "完成这并非简单的理论联系实际，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 367260,
      "end_ms": 371995,
      "text": "而是指出人的知识、道德与存在方式不可分割，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 372510,
      "end_ms": 376345,
      "text": "真正的智慧必须在生命实践中体证和完成。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 376720,
      "end_ms": 380835,
      "text": "这强烈批判了那种将哲学视为纯粹智力游戏的观念。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 382020,
      "end_ms": 383000,
      "text": "中国哲人认为，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 383320,
      "end_ms": 385685,
      "text": "你若未在行为上表现出仁爱，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 386010,
      "end_ms": 386890,
      "text": "便不算真知。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 386890,
      "end_ms": 389545,
      "text": "人若未在生活中体会到，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 389990,
      "end_ms": 394515,
      "text": "便不算明白到这给予现代人一记清醒的叩问。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 395200,
      "end_ms": 396765,
      "text": "我们学习了那么多道理，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 397090,
      "end_ms": 401105,
      "text": "是否真的活出了他们知与行之间的巨大缝隙？"
    },
    {
      "segment_id": "s000160",
      "start_ms": 401490,
      "end_ms": 403925,
      "text": "或许正是我们焦虑与无力的根源，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 404250,
      "end_ms": 410190,
      "text": "真正的改变始于将每一个知转化为一个微小的行主题。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 410190,
      "end_ms": 413655,
      "text": "七、禅宗顿悟超越言语思辩。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 414110,
      "end_ms": 415230,
      "text": "冯友兰特别指出，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 415550,
      "end_ms": 417765,
      "text": "禅宗对中国精神的深远影响，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 418720,
      "end_ms": 420675,
      "text": "禅宗主张不利文字，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 421020,
      "end_ms": 421925,
      "text": "轿外别传，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 422550,
      "end_ms": 425150,
      "text": "认为真理无法经由文字完全传递，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 425390,
      "end_ms": 427050,
      "text": "而需靠直觉体认，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 427350,
      "end_ms": 428245,
      "text": "瞬间顿悟。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 428770,
      "end_ms": 429825,
      "text": "这并不是反制，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 430290,
      "end_ms": 431850,
      "text": "而是超越逻辑的局限，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 432150,
      "end_ms": 433510,
      "text": "直抵生命本身，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 433670,
      "end_ms": 435645,
      "text": "如人饮水冷暖自知，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 436350,
      "end_ms": 438735,
      "text": "再多的描述不如自己喝一口。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 439650,
      "end_ms": 440975,
      "text": "在信息过载的今天，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 441350,
      "end_ms": 442615,
      "text": "这段话尤其珍贵。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 443360,
      "end_ms": 444755,
      "text": "我们往往知道太多，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 445200,
      "end_ms": 446365,
      "text": "却体会太少。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 447480,
      "end_ms": 451145,
      "text": "禅的智慧将我们偶尔放下分析、静心感受，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 451610,
      "end_ms": 456595,
      "text": "在平常生活中见到吃茶、扫地、看云，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 457130,
      "end_ms": 460435,
      "text": "无一不是修心悟道之时主题吧。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 460810,
      "end_ms": 462345,
      "text": "中国哲学的根本精神，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 462710,
      "end_ms": 464335,
      "text": "既入世又出世。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 465260,
      "end_ms": 470175,
      "text": "冯友兰以既入世又出世概括中国哲学的理想人格。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 470720,
      "end_ms": 472985,
      "text": "圣人的人格不在于脱离世俗，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 473530,
      "end_ms": 475555,
      "text": "而是在人事中履行责任，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 475970,
      "end_ms": 478025,
      "text": "同时保持精神上的超越性。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 478920,
      "end_ms": 480855,
      "text": "儒家主张内胜外亡。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 481310,
      "end_ms": 483325,
      "text": "道家践行和光同尘，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 483930,
      "end_ms": 485855,
      "text": "禅宗讲平常新世道，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 486260,
      "end_ms": 489565,
      "text": "皆是在日常生活中成就最高的精神境界。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 490620,
      "end_ms": 493305,
      "text": "这或是最能呼应现代人处境的一点，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 493840,
      "end_ms": 495220,
      "text": "我们不必出家求道，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 495580,
      "end_ms": 498625,
      "text": "而是要在红尘中修一颗初始之心，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 499570,
      "end_ms": 502170,
      "text": "做事业尽责任却不焦虑，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 502170,
      "end_ms": 506675,
      "text": "结果处关系用心付出却不执着回报，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 507260,
      "end_ms": 508175,
      "text": "活于当下，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 508710,
      "end_ms": 509955,
      "text": "却心怀高远。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 510910,
      "end_ms": 511370,
      "text": "最后，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 511830,
      "end_ms": 513285,
      "text": "小海龟要告诉朋友们，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 513890,
      "end_ms": 516930,
      "text": "当你不再仅用耳朵去听用头脑去变，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 517270,
      "end_ms": 520725,
      "text": "而是以整个生命去体察和印证这些智慧时，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 521240,
      "end_ms": 523045,
      "text": "你已理解了冯友兰的深意。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 523440,
      "end_ms": 525385,
      "text": "中国哲学不是知识系统，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 525780,
      "end_ms": 526995,
      "text": "而是生命之血。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 527760,
      "end_ms": 529080,
      "text": "他不提供标准答案，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 529360,
      "end_ms": 531975,
      "text": "却照亮千百年来人类共同的困惑，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 532540,
      "end_ms": 533365,
      "text": "如何活着，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 533890,
      "end_ms": 534635,
      "text": "如何安心，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 535200,
      "end_ms": 536695,
      "text": "如何成为一个更好的人。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 537720,
      "end_ms": 539035,
      "text": "正如冯友兰所说，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 539690,
      "end_ms": 541645,
      "text": "人必须先说很多话，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 542160,
      "end_ms": 543395,
      "text": "然后保持静默。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 544160,
      "end_ms": 545345,
      "text": "真正的哲学修行，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 545790,
      "end_ms": 546675,
      "text": "始于经典，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 547120,
      "end_ms": 547975,
      "text": "忠于生活，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 548610,
      "end_ms": 549565,
      "text": "始于言传，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 550100,
      "end_ms": 551020,
      "text": "忠于心悟。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 551140,
      "end_ms": 553200,
      "text": "那你既能在现实中积极作为，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 553500,
      "end_ms": 555695,
      "text": "又能在精神上自带超脱，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 556530,
      "end_ms": 559625,
      "text": "因为中国哲学的边界正是生活的边界，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 560220,
      "end_ms": 563525,
      "text": "也是每一个平凡人可抵达的圣贤之境。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 564010,
      "end_ms": 564465,
      "text": "晚安，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 564950,
      "end_ms": 568745,
      "text": "请记得最高的刀就在最平凡的日子里。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 569620,
      "end_ms": 570375,
      "text": "感谢聆听，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 570860,
      "end_ms": 571775,
      "text": "我是小海龟。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 572260,
      "end_ms": 574390,
      "text": "欢迎持续关注我们下辈。"
    }
  ],
  "source_transcript_sha256": "0ebf64958e0c12b833df2d2572da43101ffa2f55950e8f8d32e7e49091fe560c"
}