{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_255ca28b37185f92_u001",
  "video_id": "v_255ca28b37185f92",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 982.786009,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 330,
      "end_ms": 5190,
      "text": "今天我们来讲二零二六年诺贝尔文学奖得主安妮卡森的代表作，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 5230,
      "end_ms": 6810,
      "text": "红的自传丈夫之美。"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7010,
      "end_ms": 8950,
      "text": "有些书不是为了让人愉快的阅读，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9330,
      "end_ms": 13150,
      "text": "而是为了让人不得不重新审视文学这个词儿本身。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 13630,
      "end_ms": 15710,
      "text": "安妮卡森的这两部作品就是那样的书。"
    },
    {
      "segment_id": "s000006",
      "start_ms": 15970,
      "end_ms": 17990,
      "text": "他们没有传统小说的线性叙事，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 18070,
      "end_ms": 19730,
      "text": "没有清晰的情节高潮，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 20090,
      "end_ms": 24990,
      "text": "却能让人读完后感到一种致实上的眩晕和情感上的震荡。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 25070,
      "end_ms": 26190,
      "text": "不是因为故事离奇，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 26630,
      "end_ms": 31840,
      "text": "而是因为他写下的是那些被神话被历史被体面所掩埋的真实。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 32160,
      "end_ms": 33760,
      "text": "当一个人被定义为怪物，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 33840,
      "end_ms": 36640,
      "text": "当一段婚姻在谎言与背叛中缓慢解体，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 36800,
      "end_ms": 40040,
      "text": "整个文学传统选择用沉默或美化来回应，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 40060,
      "end_ms": 42260,
      "text": "那种沉默比悲剧更令人不安。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 42620,
      "end_ms": 44080,
      "text": "卡森写下红的自传时，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 44080,
      "end_ms": 45020,
      "text": "已经四十八岁，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 45200,
      "end_ms": 48000,
      "text": "距离他获得古典学博士学位已过去十余年。"
    },
    {
      "segment_id": "s000018",
      "start_ms": 48200,
      "end_ms": 48480,
      "text": "他说，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 48480,
      "end_ms": 53380,
      "text": "自己从古希腊诗人斯特西克洛斯的紫砂草碎片中找到了格律翁的声音，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 53620,
      "end_ms": 55780,
      "text": "一个被英雄杀死的怪物，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 55900,
      "end_ms": 57760,
      "text": "却在碎片中留下了自己的名字，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 57960,
      "end_ms": 59280,
      "text": "那不是一次学术翻译，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 59280,
      "end_ms": 61815,
      "text": "而是一场跨越两千五百年的对话，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 62170,
      "end_ms": 63330,
      "text": "对神话的对话，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 63470,
      "end_ms": 65115,
      "text": "对英雄叙事的对话，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 65350,
      "end_ms": 66905,
      "text": "也是对沉默本身的对话。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 67300,
      "end_ms": 68420,
      "text": "他写的不是史诗，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 68700,
      "end_ms": 70865,
      "text": "而是一份被历史删除的证词，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 71220,
      "end_ms": 73575,
      "text": "一种必须被重新说出的存在。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 73830,
      "end_ms": 75870,
      "text": "他用一句话概括自己的写作冲动。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 76010,
      "end_ms": 77765,
      "text": "假如散文是一座房子，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 78550,
      "end_ms": 81805,
      "text": "师哥就是那火燎全身飞速穿堂而过的人。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 82020,
      "end_ms": 84800,
      "text": "安妮卡森一九五零年出生于加拿大多伦多，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 85000,
      "end_ms": 86160,
      "text": "父亲是银行职员。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 86300,
      "end_ms": 86640,
      "text": "同年，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 86660,
      "end_ms": 89345,
      "text": "随着家人频繁迁居安大略省多个小城，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 89590,
      "end_ms": 91690,
      "text": "他不是巴黎或纽约文学圈的天才，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 91970,
      "end_ms": 93375,
      "text": "也没有失忆的童年。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 93710,
      "end_ms": 95770,
      "text": "他成长在一个不断移动的世界里，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 95870,
      "end_ms": 97790,
      "text": "书籍成了唯一恒定的坐标。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 98090,
      "end_ms": 98990,
      "text": "高中时期，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 99250,
      "end_ms": 102055,
      "text": "一位拉丁语教师引导他接触到古希腊文学，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 102300,
      "end_ms": 106750,
      "text": "那些两千多年前的蚊子击中了他他考入多伦多大学攻读古典学，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 106910,
      "end_ms": 107870,
      "text": "一路读到博士，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 108030,
      "end_ms": 110670,
      "text": "博士期间将全部精力投入对萨弗的研究。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 110810,
      "end_ms": 113645,
      "text": "他不是从诗歌出发走向古典学的诗人，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 113890,
      "end_ms": 116775,
      "text": "而是从古典学出发走向诗歌的学者。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 116960,
      "end_ms": 118365,
      "text": "也正因为这种出身，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 118960,
      "end_ms": 121065,
      "text": "他的文字里几乎没有浪漫的抒情，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 121430,
      "end_ms": 125435,
      "text": "只有冷静锐利、毫不妥协的智信真实。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 125760,
      "end_ms": 127940,
      "text": "他靠学术在古典学领域立足，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 128060,
      "end_ms": 129635,
      "text": "成为纽约大学的住校诗人。"
    },
    {
      "segment_id": "s000053",
      "start_ms": 130010,
      "end_ms": 131090,
      "text": "可他很快发现，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 131230,
      "end_ms": 135445,
      "text": "那些古希腊文本中的情感、爱玉的苦甜、身体的脆弱，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 135720,
      "end_ms": 137985,
      "text": "存在的孤独从未真正消失，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 138300,
      "end_ms": 140060,
      "text": "只是被现代人的语言遮蔽了。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 140240,
      "end_ms": 142805,
      "text": "他在博士论文基础上出版的爱欲的苦甜，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 143250,
      "end_ms": 145965,
      "text": "提出了后来主导其全部创作的核心观念，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 146230,
      "end_ms": 147555,
      "text": "欲望产生于距离。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 147920,
      "end_ms": 149260,
      "text": "正因为对方不是自己，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 149440,
      "end_ms": 151585,
      "text": "正因为我们无法彻底抵达对方，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 151850,
      "end_ms": 154435,
      "text": "爱情才会同时包含甜蜜与痛苦，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 154730,
      "end_ms": 156865,
      "text": "这个观念成了他一生的写作支点。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 157410,
      "end_ms": 160330,
      "text": "一个女人在神话与历史的夹缝中，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 160330,
      "end_ms": 161470,
      "text": "被定义为怪物，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 161470,
      "end_ms": 163070,
      "text": "被剥夺叙述权的处境。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 163330,
      "end_ms": 164875,
      "text": "她曾以为那只属于古代，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 165150,
      "end_ms": 166790,
      "text": "却发现他一直在语言里，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 166910,
      "end_ms": 167785,
      "text": "在记忆里，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 168040,
      "end_ms": 169385,
      "text": "在他写下的每个句子里。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 169660,
      "end_ms": 170040,
      "text": "于是，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 170240,
      "end_ms": 172160,
      "text": "当他终于决定写红的自传时，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 172360,
      "end_ms": 173755,
      "text": "他不是在翻译神话，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 174120,
      "end_ms": 176760,
      "text": "而是在救赎一个被神话杀死的人。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 176880,
      "end_ms": 178600,
      "text": "这本书是一部尸体小说，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 179080,
      "end_ms": 183140,
      "text": "却被誉为当代英语文学中最具革命性的作品之一。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 183140,
      "end_ms": 184860,
      "text": "它不使用传统的章节结构，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 184860,
      "end_ms": 185905,
      "text": "不渲染情绪，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 186230,
      "end_ms": 187705,
      "text": "几乎像一份考古报告，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 188060,
      "end_ms": 190465,
      "text": "清晰、冷静、无比精确。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 190770,
      "end_ms": 192170,
      "text": "他拒绝任何多余的修辞，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 192410,
      "end_ms": 193410,
      "text": "因为他要的不是美，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 193610,
      "end_ms": 194190,
      "text": "而是真。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 194330,
      "end_ms": 196750,
      "text": "他把自己放在古典学家的显微镜下，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 196750,
      "end_ms": 199785,
      "text": "像一个研究者那样剖析神话与自我的关系。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 200070,
      "end_ms": 200390,
      "text": "他说，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 200650,
      "end_ms": 202090,
      "text": "我写作不是为了抒情，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 202370,
      "end_ms": 205970,
      "text": "而是为了让被删除的声音重新存在这种写法。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 206090,
      "end_ms": 209510,
      "text": "后来被称为跨媒介叙事或题材杂糅写作。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 209650,
      "end_ms": 211230,
      "text": "卡森不是写格律翁的故事，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 211650,
      "end_ms": 216610,
      "text": "而是通过格律翁去揭开整个西方文学传统中英雄杀死怪物。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 216750,
      "end_ms": 218735,
      "text": "这一叙事模式的暴力本质。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 219160,
      "end_ms": 221425,
      "text": "他的书总是从古典碎片出发，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 221670,
      "end_ms": 224030,
      "text": "却最终抵达当代人的情感困境。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 224130,
      "end_ms": 226510,
      "text": "从爱欲的苦甜红的自传，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 226750,
      "end_ms": 228125,
      "text": "丈夫之美到夜，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 228650,
      "end_ms": 232610,
      "text": "他几乎是在为所有被主流叙事忽略的声音留下档案。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 232650,
      "end_ms": 234210,
      "text": "他的冷静是他的愤怒，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 234370,
      "end_ms": 235990,
      "text": "他的简洁是他的控诉。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 236270,
      "end_ms": 238295,
      "text": "红的自传出版于一九九八年，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 238590,
      "end_ms": 241550,
      "text": "但其构思可以追溯到他在古典学研究中。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 241570,
      "end_ms": 244205,
      "text": "第一次读到斯特希克洛斯残篇的时刻，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 244420,
      "end_ms": 249205,
      "text": "他说自己那是终于能用不会崩溃的语言去写一个怪物的内心。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 249490,
      "end_ms": 253450,
      "text": "他等到足够远远到可以冷静的面对英雄叙事的暴力，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 253570,
      "end_ms": 255310,
      "text": "才敢靠近那种距离感，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 255310,
      "end_ms": 256725,
      "text": "成了他文字的锋芒。"
    },
    {
      "segment_id": "s000107",
      "start_ms": 257030,
      "end_ms": 257925,
      "text": "他没有怨恨，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 258270,
      "end_ms": 259030,
      "text": "也没有眼泪，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 259290,
      "end_ms": 261610,
      "text": "只有一句句像手术刀一样的事实。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 261850,
      "end_ms": 262850,
      "text": "正是这种克制，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 263030,
      "end_ms": 264410,
      "text": "让这本书的力量更深。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 264590,
      "end_ms": 265110,
      "text": "出版后，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 265150,
      "end_ms": 267750,
      "text": "红的自传在英语世界引起巨大反响。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 268010,
      "end_ms": 269830,
      "text": "评论界震惊于他的勇气，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 270030,
      "end_ms": 271535,
      "text": "也惊讶于他的冷静。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 271930,
      "end_ms": 272810,
      "text": "丰达杰评价，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 272810,
      "end_ms": 275110,
      "text": "该作为一部精彩的杂糅之作，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 275330,
      "end_ms": 281030,
      "text": "是架在古典文本与当代自传诗之间一座雄心勃勃的奇特桥梁。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 281290,
      "end_ms": 283110,
      "text": "爱丽丝门罗读完后感叹道。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 283270,
      "end_ms": 284095,
      "text": "多年来，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 284530,
      "end_ms": 287415,
      "text": "我未发现其他任何作品能如此令人惊叹，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 287730,
      "end_ms": 290130,
      "text": "他的存在让我感到十分幸福。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 290310,
      "end_ms": 292035,
      "text": "有人说他写的是酷儿之爱，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 292350,
      "end_ms": 296675,
      "text": "其实他写的是所有被主流叙事定义为他者的人的处境，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 296910,
      "end_ms": 300035,
      "text": "是人性在英雄叙事暴力下的形状。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 300490,
      "end_ms": 301310,
      "text": "他没有喊冤，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 301610,
      "end_ms": 302430,
      "text": "没有乞怜，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 302830,
      "end_ms": 307290,
      "text": "只是把一个红色翅膀男孩的孤独放进整个西方文学传统的背景下，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 307370,
      "end_ms": 309130,
      "text": "让人看清那些看不见的枷锁。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 309470,
      "end_ms": 312730,
      "text": "二零二六年安妮卡森获得诺贝尔文学奖，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 312910,
      "end_ms": 317150,
      "text": "评委会给出的理由是以表彰他大胆而富有创造力的作品。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 317410,
      "end_ms": 320270,
      "text": "这些作品以与古典传统的嬉戏对话，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 320570,
      "end_ms": 322470,
      "text": "创造了当代文学的新形式。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 322590,
      "end_ms": 326130,
      "text": "这句话几乎是为红的自传丈夫之美量身定做的。"
    },
    {
      "segment_id": "s000135",
      "start_ms": 326170,
      "end_ms": 327630,
      "text": "他用自己的古典学训练，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 327830,
      "end_ms": 330720,
      "text": "完成了一次跨越两千五百年的表表达，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 330800,
      "end_ms": 332080,
      "text": "用诗歌代替沉默，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 332380,
      "end_ms": 334000,
      "text": "用拼贴替代被遗忘。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 334220,
      "end_ms": 336100,
      "text": "这本书没有宏大的史诗主题，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 336460,
      "end_ms": 338020,
      "text": "却有直击灵魂的真实。"
    },
    {
      "segment_id": "s000141",
      "start_ms": 338220,
      "end_ms": 339200,
      "text": "他讲一个怪物，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 339340,
      "end_ms": 341600,
      "text": "也讲所有在沉默中被忽略的人。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 341820,
      "end_ms": 342860,
      "text": "他让人意识到，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 343060,
      "end_ms": 345200,
      "text": "真正的勇气不是去对抗神话，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 345420,
      "end_ms": 347880,
      "text": "而是有一天敢于重新讲述神话。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 348180,
      "end_ms": 348720,
      "text": "接下来，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 348920,
      "end_ms": 351540,
      "text": "让我们走进那段平静却精心的记忆。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 351780,
      "end_ms": 353380,
      "text": "看一个红色翅膀的男孩，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 353980,
      "end_ms": 356880,
      "text": "如何在英雄叙事的暴力中逼迫自己，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 356880,
      "end_ms": 358600,
      "text": "活成一个能说出真相的人。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 358620,
      "end_ms": 360890,
      "text": "故事从一个怪物的童年开始，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 361090,
      "end_ms": 363430,
      "text": "格律翁是一个长着红色翅膀的男孩儿，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 363780,
      "end_ms": 364945,
      "text": "他的身体是红色的，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 365320,
      "end_ms": 367705,
      "text": "一切与红色有关的事物都与它相连。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 367950,
      "end_ms": 369265,
      "text": "他有一个漠不关心的母亲，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 369840,
      "end_ms": 371175,
      "text": "一个侵犯他的兄长，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 371470,
      "end_ms": 372710,
      "text": "它的红色不是装饰，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 372990,
      "end_ms": 373710,
      "text": "而是烙印。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 373910,
      "end_ms": 375910,
      "text": "那是他被定义为他者的标记，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 376190,
      "end_ms": 378525,
      "text": "是他在人类世界中被排斥的理由。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 378740,
      "end_ms": 380055,
      "text": "他遇到了赫拉克勒斯，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 380440,
      "end_ms": 381940,
      "text": "一个充满魅力的年轻人，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 382060,
      "end_ms": 385320,
      "text": "身上有一种古典英雄特有的自信与漫不经心。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 385520,
      "end_ms": 386580,
      "text": "在传统神话里，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 386740,
      "end_ms": 389465,
      "text": "赫拉克勒斯是来完成第十项伟业的，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 389730,
      "end_ms": 390670,
      "text": "杀死格律翁，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 390950,
      "end_ms": 392005,
      "text": "夺取他的红牛。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 392340,
      "end_ms": 393515,
      "text": "但在卡森的改写中，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 393790,
      "end_ms": 395155,
      "text": "赫拉克勒斯没有杀死他，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 395450,
      "end_ms": 396970,
      "text": "而是偷走了他脆弱的心。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 397170,
      "end_ms": 399085,
      "text": "格律翁爱上了赫拉克勒斯，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 399380,
      "end_ms": 400580,
      "text": "那不是一场对等的爱，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 400660,
      "end_ms": 401665,
      "text": "而是一种迷恋，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 401970,
      "end_ms": 404445,
      "text": "一种被英雄光芒笼罩的眩晕。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 404900,
      "end_ms": 406120,
      "text": "他以为那是亲近，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 406440,
      "end_ms": 408505,
      "text": "是爱情该有的自然延伸。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 408930,
      "end_ms": 410370,
      "text": "可当赫拉克勒斯离开时，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 410630,
      "end_ms": 411550,
      "text": "他才慢慢意识到，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 411550,
      "end_ms": 415130,
      "text": "自己正站在一条被英雄叙事所定义的界限上。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 415190,
      "end_ms": 416310,
      "text": "在这条界限的一边，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 416710,
      "end_ms": 417415,
      "text": "他是怪物，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 417710,
      "end_ms": 421500,
      "text": "在另一边它是被利用的被遗弃的赫拉克勒斯。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 421500,
      "end_ms": 424040,
      "text": "后来在飞机上趁他的新伴侣熟睡时，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 424340,
      "end_ms": 426360,
      "text": "对格律翁做出了性的举动。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 426500,
      "end_ms": 427020,
      "text": "那一刻，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 427220,
      "end_ms": 429065,
      "text": "格律翁明白自己不是被爱的，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 429280,
      "end_ms": 430185,
      "text": "而是被消费的，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 430390,
      "end_ms": 432975,
      "text": "他的身体成了英雄旅途中的一个注脚，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 433240,
      "end_ms": 435180,
      "text": "一段可以被随时翻过的插曲。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 435360,
      "end_ms": 436935,
      "text": "格律翁没有可以倾诉的人，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 437250,
      "end_ms": 438170,
      "text": "母亲太遥远，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 438330,
      "end_ms": 439835,
      "text": "兄长是伤害的来源，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 440160,
      "end_ms": 441120,
      "text": "那是一个怪物，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 441120,
      "end_ms": 443000,
      "text": "不能公开谈论爱情的年代。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 443140,
      "end_ms": 445780,
      "text": "社会没有为他者准备任何保护与理解，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 445920,
      "end_ms": 447995,
      "text": "只有定义、排斥和遗忘。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 448240,
      "end_ms": 450125,
      "text": "他拿起相机开始拍摄照片，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 450410,
      "end_ms": 452590,
      "text": "他无法用语言讲述自己的生命，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 452790,
      "end_ms": 453830,
      "text": "于是选择了图像。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 454070,
      "end_ms": 456410,
      "text": "卡森在这里做了一件极其大胆的事，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 456530,
      "end_ms": 458170,
      "text": "他让格律翁成为一个摄影师，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 458389,
      "end_ms": 459455,
      "text": "而不是一个诗人。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 459710,
      "end_ms": 460695,
      "text": "他拍摄火山，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 461140,
      "end_ms": 462325,
      "text": "拍摄红色的事物，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 462570,
      "end_ms": 464745,
      "text": "拍摄那些无法被语言捕捉的瞬间，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 465020,
      "end_ms": 466120,
      "text": "照片成了他的自传，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 466280,
      "end_ms": 467815,
      "text": "他的红色成了他的语言。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 468130,
      "end_ms": 468370,
      "text": "后来，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 468370,
      "end_ms": 469405,
      "text": "他遇到安卡什，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 469840,
      "end_ms": 472680,
      "text": "一个在秘鲁记录火山声音的人登卡什的出现，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 472680,
      "end_ms": 474645,
      "text": "为叙事带来了另一层开放性。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 474920,
      "end_ms": 476665,
      "text": "他不是赫拉克勒斯那样的英雄，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 476980,
      "end_ms": 478060,
      "text": "他是一个倾听者，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 478300,
      "end_ms": 479235,
      "text": "一个记录者。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 479570,
      "end_ms": 480330,
      "text": "从那一刻起，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 480610,
      "end_ms": 482635,
      "text": "格律翁开始了漫长的自我重建，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 483140,
      "end_ms": 485125,
      "text": "他不再是被英雄杀死的怪物，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 485400,
      "end_ms": 487060,
      "text": "也不再是被爱人遗弃的男孩。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 487530,
      "end_ms": 488690,
      "text": "他成了一个观看者，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 488910,
      "end_ms": 489775,
      "text": "一个记录者，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 490070,
      "end_ms": 492935,
      "text": "一个用自己的方式重新讲述自己生命的人，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 493410,
      "end_ms": 495370,
      "text": "每一天都是一场与记忆的搏斗。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 495670,
      "end_ms": 496725,
      "text": "他要假装正常，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 497040,
      "end_ms": 498875,
      "text": "假装赫拉克勒斯从未存在过。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 499290,
      "end_ms": 500770,
      "text": "他的内心像一座火山，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 501070,
      "end_ms": 502670,
      "text": "表面平静深处，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 502730,
      "end_ms": 504265,
      "text": "是持续涌动的容颜。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 504780,
      "end_ms": 506680,
      "text": "他多么希望有人能看出他的痛苦，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 506840,
      "end_ms": 507645,
      "text": "拉他一把，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 507990,
      "end_ms": 509145,
      "text": "但没有人伸手。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 509640,
      "end_ms": 510560,
      "text": "他看着身边的人，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 510560,
      "end_ms": 511280,
      "text": "谈论爱情，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 511500,
      "end_ms": 512305,
      "text": "谈论未来，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 512800,
      "end_ms": 515420,
      "text": "而他只能一个人数着那些被遗弃的照片。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 515540,
      "end_ms": 516440,
      "text": "每当夜深人静，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 516580,
      "end_ms": 517825,
      "text": "他对自己低声说，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 518230,
      "end_ms": 519045,
      "text": "不能被定义，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 519360,
      "end_ms": 522435,
      "text": "绝对不能这句话成了他的生存规则。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 522790,
      "end_ms": 526830,
      "text": "他开始用相机记录一切火山鹦鹉红色的天空，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 527230,
      "end_ms": 528190,
      "text": "每次按下快门，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 528450,
      "end_ms": 530265,
      "text": "他都在经历一次重新命名，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 531520,
      "end_ms": 532060,
      "text": "迪金森。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 532060,
      "end_ms": 532980,
      "text": "关于火山的诗，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 533040,
      "end_ms": 534315,
      "text": "成了他的精神坐标。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 535010,
      "end_ms": 536850,
      "text": "里克特正极既无上限，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 536930,
      "end_ms": 537725,
      "text": "也无下限，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 538350,
      "end_ms": 540230,
      "text": "一切取决于地动仪的敏感度。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 540310,
      "end_ms": 541170,
      "text": "每个人的遭遇，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 541430,
      "end_ms": 544205,
      "text": "情欲、暗流都是火山深处的容颜，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 544530,
      "end_ms": 545810,
      "text": "不轻易为外人所知，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 546050,
      "end_ms": 547895,
      "text": "但地震仪会记录下一切。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 548310,
      "end_ms": 550385,
      "text": "格律翁的相机就是他的地震仪，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 551180,
      "end_ms": 552260,
      "text": "他后来去了布伊诺斯，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 552260,
      "end_ms": 554035,
      "text": "爱丽斯与赫拉克勒斯重逢，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 554500,
      "end_ms": 557395,
      "text": "赫拉克勒斯正在拍摄一部关于艾美丽迪金森的纪录片。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 557670,
      "end_ms": 559610,
      "text": "那是英雄与怪物的最后一次相遇，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 559810,
      "end_ms": 560510,
      "text": "也是格律翁。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 560510,
      "end_ms": 562325,
      "text": "最后一次试图理解那段关系，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 562800,
      "end_ms": 563465,
      "text": "他问自己，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 563880,
      "end_ms": 565520,
      "text": "赫拉克勒斯为什么要那样对我？"
    },
    {
      "segment_id": "s000261",
      "start_ms": 565740,
      "end_ms": 566995,
      "text": "他给出了几种答案，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 567420,
      "end_ms": 568425,
      "text": "也许只是暴力，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 568720,
      "end_ms": 571185,
      "text": "也许赫拉克勒斯以为杀死他就能永远占有他。"
    },
    {
      "segment_id": "s000264",
      "start_ms": 571650,
      "end_ms": 573405,
      "text": "也许赫拉克勒斯害怕他，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 573800,
      "end_ms": 575585,
      "text": "当他离开布伊诺斯爱丽丝时，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 575890,
      "end_ms": 576965,
      "text": "他知道一切结束，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 577800,
      "end_ms": 579125,
      "text": "他感觉自己像是空了。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 579470,
      "end_ms": 580855,
      "text": "被掏空的不仅是身体，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 581140,
      "end_ms": 583740,
      "text": "还有信任和清纯那种空的感觉，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 583820,
      "end_ms": 585080,
      "text": "从此在他心里生根。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 585400,
      "end_ms": 586245,
      "text": "照片还在，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 586640,
      "end_ms": 588455,
      "text": "但照片里的人已经不在了，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 588940,
      "end_ms": 590205,
      "text": "这就是红的象征。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 590550,
      "end_ms": 591355,
      "text": "红色还在，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 591640,
      "end_ms": 594920,
      "text": "但红色所代表的那个人已经被英雄叙事抹去了。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 594920,
      "end_ms": 595940,
      "text": "回到正常生活后，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 596120,
      "end_ms": 597285,
      "text": "他必须继续活着，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 597750,
      "end_ms": 599165,
      "text": "他像什么都没发生一样，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 599510,
      "end_ms": 601585,
      "text": "拍照、旅行与人交谈，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 601950,
      "end_ms": 604325,
      "text": "可他知道自己再也回不到过去的自己了。"
    },
    {
      "segment_id": "s000281",
      "start_ms": 604760,
      "end_ms": 607235,
      "text": "那种经历让他明白世界从未公平过。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 607850,
      "end_ms": 610390,
      "text": "他成了那个知道太多的人太清楚，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 610470,
      "end_ms": 612850,
      "text": "英雄叙事的暴力也太清楚，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 612930,
      "end_ms": 613870,
      "text": "沉默的代价。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 614070,
      "end_ms": 615709,
      "text": "他后来试着写下那段经历，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 615830,
      "end_ms": 618170,
      "text": "却发现文字无法承受那种真实。"
    },
    {
      "segment_id": "s000287",
      "start_ms": 618590,
      "end_ms": 620990,
      "text": "他写一句就停下来删掉，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 621150,
      "end_ms": 623030,
      "text": "又重写几十年过去，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 623450,
      "end_ms": 624330,
      "text": "他成了摄影师，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 624810,
      "end_ms": 627030,
      "text": "却始终没有勇气完整记录那一段。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 627690,
      "end_ms": 630690,
      "text": "直到卡森在纸砂草碎片中找到了他的名字，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 630950,
      "end_ms": 632110,
      "text": "于是有了红的自传。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 632670,
      "end_ms": 633250,
      "text": "在书中，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 633410,
      "end_ms": 634810,
      "text": "卡森没有用情绪渲染，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 634930,
      "end_ms": 636250,
      "text": "也没有为格律翁辩解。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 636590,
      "end_ms": 638740,
      "text": "他只是冷静的写一个男孩，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 639140,
      "end_ms": 641420,
      "text": "一段迷恋一个英雄的暴力。"
    },
    {
      "segment_id": "s000298",
      "start_ms": 641740,
      "end_ms": 644720,
      "text": "他用近乎临床式的语言记录下每一个细节。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 645260,
      "end_ms": 646140,
      "text": "红色的翅膀，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 646340,
      "end_ms": 647220,
      "text": "飞机的轰鸣，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 647460,
      "end_ms": 648360,
      "text": "火山的沉默，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 648660,
      "end_ms": 649680,
      "text": "迪金森的诗句，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 649980,
      "end_ms": 650940,
      "text": "正是这种冷静，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 651180,
      "end_ms": 652560,
      "text": "让文字更具穿透力。"
    },
    {
      "segment_id": "s000305",
      "start_ms": 653220,
      "end_ms": 654940,
      "text": "他拒绝让读者同情格律翁，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 655060,
      "end_ms": 656680,
      "text": "而是逼着读者去理解他。"
    },
    {
      "segment_id": "s000307",
      "start_ms": 657100,
      "end_ms": 658720,
      "text": "这不是一个关于爱情的故事，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 658720,
      "end_ms": 660740,
      "text": "也不是关于惩罚或救赎的故事。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 660980,
      "end_ms": 663800,
      "text": "这是一段关于被定义与自我命名的故事。"
    },
    {
      "segment_id": "s000310",
      "start_ms": 664200,
      "end_ms": 667095,
      "text": "那个红色的男孩在痛苦中失去了天真，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 667420,
      "end_ms": 670305,
      "text": "也因此看清了英雄叙事的真实面目。"
    },
    {
      "segment_id": "s000312",
      "start_ms": 670700,
      "end_ms": 672460,
      "text": "他发现仍可以被剥夺，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 672460,
      "end_ms": 675125,
      "text": "一切却依然能用图像去抵抗。"
    },
    {
      "segment_id": "s000314",
      "start_ms": 675590,
      "end_ms": 675910,
      "text": "卡森。"
    },
    {
      "segment_id": "s000315",
      "start_ms": 675910,
      "end_ms": 676795,
      "text": "后来回忆说，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 677240,
      "end_ms": 677740,
      "text": "那一刻，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 677840,
      "end_ms": 678655,
      "text": "我明白了，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 679160,
      "end_ms": 682215,
      "text": "格律翁的生命从此与我的写作捆绑在一起。"
    },
    {
      "segment_id": "s000319",
      "start_ms": 682720,
      "end_ms": 683895,
      "text": "因为只有写出来，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 684190,
      "end_ms": 685275,
      "text": "他才能活下去。"
    },
    {
      "segment_id": "s000321",
      "start_ms": 685630,
      "end_ms": 688270,
      "text": "红的自传的力量就在于这种写出来的行为。"
    },
    {
      "segment_id": "s000322",
      "start_ms": 688450,
      "end_ms": 689630,
      "text": "它不仅仅是翻译，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 689810,
      "end_ms": 692245,
      "text": "而是一种重新夺回叙述权的行为。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 692760,
      "end_ms": 693505,
      "text": "在神话中，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 693770,
      "end_ms": 695005,
      "text": "格律翁被迫沉默。"
    },
    {
      "segment_id": "s000326",
      "start_ms": 695380,
      "end_ms": 695780,
      "text": "如今，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 696000,
      "end_ms": 697875,
      "text": "卡森用诗歌打破沉默，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 698240,
      "end_ms": 699675,
      "text": "那是一种缓慢的复原，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 699950,
      "end_ms": 702400,
      "text": "一种迟来的正义故事。"
    },
    {
      "segment_id": "s000330",
      "start_ms": 702460,
      "end_ms": 703280,
      "text": "在书的最后，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 703280,
      "end_ms": 704405,
      "text": "收的极其安静，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 704890,
      "end_ms": 706015,
      "text": "没有宏大的结尾，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 706390,
      "end_ms": 709830,
      "text": "没有宣泄式的哭喊隔离公收拾起那些照片，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 710170,
      "end_ms": 711915,
      "text": "折叠好放回原处，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 712330,
      "end_ms": 713310,
      "text": "仿佛什么都没发生，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 713310,
      "end_ms": 715515,
      "text": "过却又什么都无法抹去。"
    },
    {
      "segment_id": "s000337",
      "start_ms": 715820,
      "end_ms": 717975,
      "text": "那种红的象征贯穿整部作品，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 718430,
      "end_ms": 720775,
      "text": "他代表失去羞耻、遗忘，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 721100,
      "end_ms": 723005,
      "text": "也代表重新获得自我的开始。"
    },
    {
      "segment_id": "s000340",
      "start_ms": 723450,
      "end_ms": 724710,
      "text": "当读者读完最后一页，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 724810,
      "end_ms": 726190,
      "text": "脑海中回荡的不是剧情，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 726410,
      "end_ms": 727785,
      "text": "而是那种无声的力量。"
    },
    {
      "segment_id": "s000343",
      "start_ms": 728190,
      "end_ms": 730945,
      "text": "一个人如何在英雄叙事的盲区中活下来？"
    },
    {
      "segment_id": "s000344",
      "start_ms": 731180,
      "end_ms": 733855,
      "text": "又如何用图像为自己留下存在的痕迹？"
    },
    {
      "segment_id": "s000345",
      "start_ms": 734410,
      "end_ms": 735925,
      "text": "他的冷静不是冷漠，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 736340,
      "end_ms": 738215,
      "text": "而是一种深到骨子里的清醒。"
    },
    {
      "segment_id": "s000347",
      "start_ms": 738730,
      "end_ms": 740755,
      "text": "红的自传写成于一九九八年，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 741110,
      "end_ms": 743845,
      "text": "但格律翁的故事可以追溯到两千五百年前。"
    },
    {
      "segment_id": "s000349",
      "start_ms": 744320,
      "end_ms": 745715,
      "text": "卡森花了那么长时间，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 746040,
      "end_ms": 747340,
      "text": "从博士论文到尸体，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 747340,
      "end_ms": 747740,
      "text": "小说，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 748100,
      "end_ms": 750725,
      "text": "才让这个被英雄杀死的怪物重新说话，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 751230,
      "end_ms": 753390,
      "text": "那种距离感成了他文字的芳芒。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 753470,
      "end_ms": 756690,
      "text": "如果说红的自传是在用神话讲被定义的痛苦，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 756830,
      "end_ms": 760850,
      "text": "那么丈夫之美则直接进入了成年人亲密关系中的另一种暴力。"
    },
    {
      "segment_id": "s000356",
      "start_ms": 760930,
      "end_ms": 764810,
      "text": "这本副标题为a fical SA in twenty nine tangers的作品，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 764990,
      "end_ms": 769410,
      "text": "以二十九只戈组成一段关于婚姻欲望与背叛的复杂叙事。"
    },
    {
      "segment_id": "s000358",
      "start_ms": 769430,
      "end_ms": 772465,
      "text": "卡森在每一诗篇前都摘引了一句祭词的诗文，"
    },
    {
      "segment_id": "s000359",
      "start_ms": 772790,
      "end_ms": 778075,
      "text": "将祭祀的浪漫主义语言与一个妻子面对丈夫反复背叛时的冷静观察并置在一起。"
    },
    {
      "segment_id": "s000360",
      "start_ms": 778400,
      "end_ms": 782080,
      "text": "主人公那个虚构的妻子对丈夫的美没有抵抗力，"
    },
    {
      "segment_id": "s000361",
      "start_ms": 782320,
      "end_ms": 784200,
      "text": "她必须忍受对方一次次出轨，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 784280,
      "end_ms": 785160,
      "text": "一次次谎言，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 785340,
      "end_ms": 787085,
      "text": "一次次以美为名的伤害。"
    },
    {
      "segment_id": "s000364",
      "start_ms": 787620,
      "end_ms": 788440,
      "text": "他没有哭喊，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 788620,
      "end_ms": 789320,
      "text": "没有控诉，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 789600,
      "end_ms": 790700,
      "text": "只是冷静的记录。"
    },
    {
      "segment_id": "s000367",
      "start_ms": 791020,
      "end_ms": 793400,
      "text": "他像在跳一只探戈进退之间，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 793440,
      "end_ms": 794720,
      "text": "诠是节奏的精确，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 795080,
      "end_ms": 796920,
      "text": "每一步都踩在伤口的边缘。"
    },
    {
      "segment_id": "s000370",
      "start_ms": 797100,
      "end_ms": 802200,
      "text": "卡森将祭词、乔治、巴塔耶和贝克特等人的作品片段重新拼贴组合，"
    }
  ],
  "source_transcript_sha256": "f4dba9a9673fbb1ba71f90e6b65cb71582868e9ec050e5cec7e0c89c6125d0f3"
}