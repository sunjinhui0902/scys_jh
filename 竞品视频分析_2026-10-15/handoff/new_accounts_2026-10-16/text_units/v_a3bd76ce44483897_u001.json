{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_a3bd76ce44483897_u001",
  "video_id": "v_a3bd76ce44483897",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 782.537007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 390,
      "end_ms": 2030,
      "text": "十三分钟讲解萨特恶心。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2250,
      "end_ms": 5510,
      "text": "今天我们要讲的是一本名字很怪内容更怪的书，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5910,
      "end_ms": 7010,
      "text": "萨特的恶心。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7410,
      "end_ms": 8430,
      "text": "你听听这两个字，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 8890,
      "end_ms": 11490,
      "text": "恶心不是生理上的反胃，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 11650,
      "end_ms": 12750,
      "text": "不是吃坏了东西。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 13170,
      "end_ms": 13770,
      "text": "但是某天，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 13770,
      "end_ms": 15010,
      "text": "你突然盯着自己的手，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 15010,
      "end_ms": 16330,
      "text": "看看着看着，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 16570,
      "end_ms": 18190,
      "text": "觉得这团肉怎么这么怪，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 18710,
      "end_ms": 20110,
      "text": "为什么他长在我身上，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 20250,
      "end_ms": 21430,
      "text": "他到底在干什么？"
    },
    {
      "segment_id": "s000013",
      "start_ms": 21690,
      "end_ms": 22490,
      "text": "你没有生病，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 22690,
      "end_ms": 23390,
      "text": "没有发烧，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 23630,
      "end_ms": 24350,
      "text": "没有失恋，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 24770,
      "end_ms": 27530,
      "text": "但你就是觉得眼前的一切都不对劲，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 28070,
      "end_ms": 29570,
      "text": "一种说不清的腻味，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 29570,
      "end_ms": 30740,
      "text": "从胃里往上涌，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 30980,
      "end_ms": 33060,
      "text": "涌到喉咙口涌进脑子里。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 33460,
      "end_ms": 34320,
      "text": "你会问自己，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 34880,
      "end_ms": 35940,
      "text": "我是不是疯了？"
    },
    {
      "segment_id": "s000022",
      "start_ms": 36360,
      "end_ms": 37800,
      "text": "可你心里又隐隐知道，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 37920,
      "end_ms": 40240,
      "text": "你可能是这辈子第一次真正醒了。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 40740,
      "end_ms": 43000,
      "text": "萨特把这个问题写成了一个人的日记。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 43480,
      "end_ms": 44260,
      "text": "不是故事，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 44480,
      "end_ms": 45200,
      "text": "不是小说，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 45560,
      "end_ms": 46940,
      "text": "就是一个人的日记。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 47380,
      "end_ms": 53720,
      "text": "一页一页一天一天记录着他是怎么从正常滑进恶心里的。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 53880,
      "end_ms": 55140,
      "text": "在翻开这本日记之前，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 55400,
      "end_ms": 59725,
      "text": "先说两句萨特萨特是二十世纪法国最特殊的存在之一。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 60140,
      "end_ms": 63115,
      "text": "他不是那种坐在书房里写写抽象概念的哲学家，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 63580,
      "end_ms": 65320,
      "text": "他是一个把人扔进生活里。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 65420,
      "end_ms": 67625,
      "text": "在逼你面对生活有多荒谬的人。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 68370,
      "end_ms": 69990,
      "text": "他出生在一个知识分子家庭，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 70210,
      "end_ms": 71675,
      "text": "从小泡在书堆里长大，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 72130,
      "end_ms": 74570,
      "text": "按理说可以走一条稳稳当当的学者路线，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 74710,
      "end_ms": 78035,
      "text": "可他的人生几乎从头到尾都在往反方向跑。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 78310,
      "end_ms": 79895,
      "text": "他拒绝领诺贝尔文学奖，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 80170,
      "end_ms": 81210,
      "text": "拒绝一切体制，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 81210,
      "end_ms": 82575,
      "text": "给他的头衔和身份，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 83070,
      "end_ms": 86105,
      "text": "拒绝承认你生下来是什么人就该是什么人。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 86670,
      "end_ms": 87350,
      "text": "他写小说，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 87610,
      "end_ms": 88230,
      "text": "写戏剧，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 88390,
      "end_ms": 90150,
      "text": "写哲学一辈子。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 90150,
      "end_ms": 91465,
      "text": "都在追问一个问题，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 92020,
      "end_ms": 93975,
      "text": "人活着到底有没有理由？"
    },
    {
      "segment_id": "s000047",
      "start_ms": 94530,
      "end_ms": 95490,
      "text": "如果没有理由，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 95670,
      "end_ms": 96615,
      "text": "那你还活不活？"
    },
    {
      "segment_id": "s000049",
      "start_ms": 96870,
      "end_ms": 99910,
      "text": "恶心就是他第一次把这个问题写成文学的地方，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 100210,
      "end_ms": 102555,
      "text": "也是他存在主义哲学的第一次亮相。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 102870,
      "end_ms": 103775,
      "text": "回到那本日记，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 104190,
      "end_ms": 108915,
      "text": "日记的主人叫安东娜洛根丁一个三十来岁的法国知识分子，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 109330,
      "end_ms": 113145,
      "text": "他用了好几年时间在中欧、北非远东到处旅行。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 113600,
      "end_ms": 114380,
      "text": "回到法国后，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 114380,
      "end_ms": 116405,
      "text": "在海滨城市布维尔定居下来。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 117000,
      "end_ms": 118015,
      "text": "他为什么要来这里？"
    },
    {
      "segment_id": "s000057",
      "start_ms": 118300,
      "end_ms": 119895,
      "text": "表面上是为了做研究，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 120240,
      "end_ms": 123755,
      "text": "他要写一篇关于十八世纪冒险家罗尔邦侯爵的论文。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 124360,
      "end_ms": 127095,
      "text": "他住在一家旅行推销员常住的旅馆里，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 127460,
      "end_ms": 129335,
      "text": "每天去市立图书馆查资料，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 129670,
      "end_ms": 132070,
      "text": "晚上去铁路员工、俱乐部坐着听，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 132070,
      "end_ms": 135575,
      "text": "同一张爵士乐唱片反复听一遍又一遍。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 135830,
      "end_ms": 137390,
      "text": "他的生活看起来很有规律，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 137470,
      "end_ms": 138235,
      "text": "很有目的，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 138470,
      "end_ms": 139095,
      "text": "很有学问，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 139510,
      "end_ms": 140535,
      "text": "但他自己知道，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 140890,
      "end_ms": 145660,
      "text": "他是在用这些填满时间填满一个越来越大的空洞变化，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 146100,
      "end_ms": 147665,
      "text": "是从一些小事开始的。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 148330,
      "end_ms": 148850,
      "text": "有一天，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 148910,
      "end_ms": 150255,
      "text": "他伸手去捡一张纸，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 150820,
      "end_ms": 151885,
      "text": "纸掉在地上，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 152200,
      "end_ms": 153125,
      "text": "他弯腰去捡，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 153600,
      "end_ms": 154935,
      "text": "突然觉得手不对劲儿，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 155360,
      "end_ms": 156445,
      "text": "不是手有问题，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 156740,
      "end_ms": 159145,
      "text": "是手这个存在本身有问题。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 159460,
      "end_ms": 160455,
      "text": "他盯着自己的手，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 160740,
      "end_ms": 162515,
      "text": "觉得它像一只肥大的虫子，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 162760,
      "end_ms": 163605,
      "text": "趴在桌面上，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 163940,
      "end_ms": 165385,
      "text": "他认不出那是自己的手。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 165810,
      "end_ms": 166330,
      "text": "另一次，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 166330,
      "end_ms": 168835,
      "text": "他在咖啡馆里看着面前的啤酒杯，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 169300,
      "end_ms": 171405,
      "text": "杯子的表面有一层薄薄的光，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 171890,
      "end_ms": 174735,
      "text": "他忽然觉得那层光不像是杯子的属性，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 175110,
      "end_ms": 178795,
      "text": "而像是杯子自己在往外冒什么粘稠的东西，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 179620,
      "end_ms": 182975,
      "text": "他形容那种感觉就像有什么东西在渗出来。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 183380,
      "end_ms": 185300,
      "text": "从物件的表皮底下渗出来，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 185420,
      "end_ms": 187995,
      "text": "黏糊糊的赖在身上洗不掉，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 188440,
      "end_ms": 189525,
      "text": "然后恶心就来了。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 189920,
      "end_ms": 190860,
      "text": "萨特自己说过，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 191260,
      "end_ms": 193760,
      "text": "恶心最初的名字叫偶然性，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 193760,
      "end_ms": 196520,
      "text": "变他十八九岁的时候就开始琢磨这个东西。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 196600,
      "end_ms": 198685,
      "text": "偶然性这个词听起来很学术，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 198930,
      "end_ms": 200185,
      "text": "但他的意思特别简单，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 200600,
      "end_ms": 203360,
      "text": "存在是没有理由的这张桌子在这儿，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 203360,
      "end_ms": 204780,
      "text": "不是因为宇宙需要它，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 204980,
      "end_ms": 207160,
      "text": "不是因为有人需要它才造了它。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 207300,
      "end_ms": 209745,
      "text": "他只是在了没有任何理由，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 210120,
      "end_ms": 211025,
      "text": "没有任何目的，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 211260,
      "end_ms": 213005,
      "text": "没有任何应该在里面。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 213420,
      "end_ms": 214685,
      "text": "他就是掉在这儿了，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 215070,
      "end_ms": 216930,
      "text": "你也是你的存在，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 216930,
      "end_ms": 218785,
      "text": "没有任何事先写好的剧本，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 219050,
      "end_ms": 221690,
      "text": "没有任何你生来就是要做某某事的蓝图，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 221890,
      "end_ms": 223465,
      "text": "你就这么被扔进了这个世界，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 223730,
      "end_ms": 225135,
      "text": "然后你得自己想办法活。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 225770,
      "end_ms": 227885,
      "text": "洛根丁不是突然得出这个结论的，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 228370,
      "end_ms": 230695,
      "text": "他是慢慢被这个结论击穿的。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 231480,
      "end_ms": 234215,
      "text": "他之前一直以为自己活着是有意义的，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 234500,
      "end_ms": 235140,
      "text": "他旅行，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 235400,
      "end_ms": 236060,
      "text": "他读书，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 236200,
      "end_ms": 237025,
      "text": "他写论文，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 237390,
      "end_ms": 239330,
      "text": "他以为这些活动能给他一个身份，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 239590,
      "end_ms": 243005,
      "text": "能让他成为一个正在研究罗尔邦侯爵的历史学家。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 243460,
      "end_ms": 244525,
      "text": "可他越来越觉得，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 244880,
      "end_ms": 246955,
      "text": "这些身份都像纸糊的面具，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 247280,
      "end_ms": 248760,
      "text": "贴在脸上底下，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 248760,
      "end_ms": 249475,
      "text": "什么也没有。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 249840,
      "end_ms": 252480,
      "text": "他去图书馆面对那些书那些字，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 252800,
      "end_ms": 257905,
      "text": "他忽然发现字和物之间是脱节的一个词叫椅子。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 258240,
      "end_ms": 259835,
      "text": "当你看着那把椅子的时候，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 260110,
      "end_ms": 262125,
      "text": "椅子并不在告诉你它是椅子，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 262560,
      "end_ms": 264075,
      "text": "他只是一团东西在那儿，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 264280,
      "end_ms": 266080,
      "text": "颜色、形状、硬度，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 266200,
      "end_ms": 267115,
      "text": "但没有意义。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 267680,
      "end_ms": 269060,
      "text": " E是你加上去的，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 269140,
      "end_ms": 270180,
      "text": "是你叫他椅子，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 270180,
      "end_ms": 271295,
      "text": "他才是椅子。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 271690,
      "end_ms": 273875,
      "text": "如果你不叫他他什么也不是，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 274180,
      "end_ms": 275055,
      "text": "就是一坨东西。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 275560,
      "end_ms": 276140,
      "text": "萨特说，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 276200,
      "end_ms": 279685,
      "text": "他写作的手法就是隔离词与物之间的习惯，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 280030,
      "end_ms": 282615,
      "text": "把语言和事物的那层粘合撕开，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 282950,
      "end_ms": 284915,
      "text": "让你看到底下赤裸裸的存在。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 285260,
      "end_ms": 286985,
      "text": "洛根丁继续往下掉，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 287520,
      "end_ms": 290060,
      "text": "他开始害怕人大人们说的话，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 290280,
      "end_ms": 292240,
      "text": "做的事都是那么有理由。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 292300,
      "end_ms": 293890,
      "text": "那么说得通可，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 293890,
      "end_ms": 295235,
      "text": "他觉得全都是在演戏，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 295810,
      "end_ms": 297960,
      "text": "他们在扮演父亲职员，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 298180,
      "end_ms": 299785,
      "text": "正派人有身份的人，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 300120,
      "end_ms": 301400,
      "text": "每个人都有一个角色，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 301960,
      "end_ms": 303360,
      "text": "每个人都演的那么投入，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 303520,
      "end_ms": 305255,
      "text": "好像那些角色就是他们本身。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 306050,
      "end_ms": 309250,
      "text": "可洛根丁看穿了那些角色是假的，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 309630,
      "end_ms": 310870,
      "text": "底下什么也没有。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 311530,
      "end_ms": 312250,
      "text": "他用了一个词，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 312250,
      "end_ms": 315090,
      "text": "来形容这件事儿叫做自欺萨特。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 315090,
      "end_ms": 317750,
      "text": "后来在存在与虚无里把这个概念讲透了。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 318070,
      "end_ms": 320270,
      "text": "人明明知道自己是自由的人，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 320270,
      "end_ms": 322470,
      "text": "明知道自己可以选择另一种活法，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 322890,
      "end_ms": 324810,
      "text": "但为了逃避自由带来的焦虑，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 324930,
      "end_ms": 328930,
      "text": "人们假装自己没有选择假装自己就是一个教师，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 329210,
      "end_ms": 330970,
      "text": "一个丈夫、一个老实人。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 331310,
      "end_ms": 334210,
      "text": "好像这些身份是天生就长在身上的一样，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 334690,
      "end_ms": 335735,
      "text": "自欺是舒服。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 336400,
      "end_ms": 337520,
      "text": "因为一旦你相信了，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 337520,
      "end_ms": 338540,
      "text": "我只能这样，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 338780,
      "end_ms": 340520,
      "text": "你就不用为任何事负责了。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 340820,
      "end_ms": 342020,
      "text": "可洛根丁做不到，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 342560,
      "end_ms": 343280,
      "text": "他试过，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 343640,
      "end_ms": 346320,
      "text": "他试图相信自己是那个研究历史的学者，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 346520,
      "end_ms": 350160,
      "text": "是那个每天去图书馆的人是那个和老板娘调情的人。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 350440,
      "end_ms": 352360,
      "text": "但他每一次都看见那层伪装，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 352360,
      "end_ms": 353800,
      "text": "从自己脸上滑下来。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 354380,
      "end_ms": 355180,
      "text": "中间有一段，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 355320,
      "end_ms": 357520,
      "text": "他以前的情人安妮给他来信了，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 357820,
      "end_ms": 359300,
      "text": "他以为自己看到了希望。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 359900,
      "end_ms": 362540,
      "text": "安妮曾经是一个追求完满时刻的女人。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 362660,
      "end_ms": 364940,
      "text": "他想要抓住生命中那些完美的瞬间，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 365160,
      "end_ms": 366445,
      "text": "把他们变成永恒。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 367030,
      "end_ms": 368345,
      "text": "可等他见到安妮，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 368820,
      "end_ms": 371510,
      "text": "发现他已经放弃了安妮，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 371590,
      "end_ms": 374745,
      "text": "变成了一个肥胖疲惫、认命的妇人。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 375340,
      "end_ms": 376545,
      "text": "他不再追求完满，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 376840,
      "end_ms": 377805,
      "text": "他只是活着，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 378080,
      "end_ms": 379155,
      "text": "被生活推着走。"
    },
    {
      "segment_id": "s000177",
      "start_ms": 380420,
      "end_ms": 382775,
      "text": "洛根丁从他身上看到了自己的未来，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 383300,
      "end_ms": 385145,
      "text": "一个放弃追问的人的未来。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 385700,
      "end_ms": 386815,
      "text": "你不再恶心了，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 387220,
      "end_ms": 388515,
      "text": "因为你已经不再在乎了，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 388750,
      "end_ms": 391725,
      "text": "但真正把它击穿的是公园里的那棵栎树。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 392120,
      "end_ms": 392500,
      "text": "那天，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 392640,
      "end_ms": 394295,
      "text": "他坐在公园的长椅上，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 394710,
      "end_ms": 396705,
      "text": "低着头看着栎树的根，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 397320,
      "end_ms": 402605,
      "text": "那些根深深扎进土里黑黑的球曲的纠缠在一起，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 402920,
      "end_ms": 404125,
      "text": "像一堆蠕动的蛇。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 404780,
      "end_ms": 407010,
      "text": "他盯着那个树根看看着，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 407010,
      "end_ms": 410425,
      "text": "看着突然之间所有的词儿都消失了。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 410980,
      "end_ms": 412240,
      "text": "树根不再是树根，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 412420,
      "end_ms": 413575,
      "text": "不再是黑色的，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 413840,
      "end_ms": 415165,
      "text": "不再是扎在土里的，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 415790,
      "end_ms": 417850,
      "text": "它变成了一个赤裸裸的存在物，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 418070,
      "end_ms": 421765,
      "text": "一个黝黑多节的完全野性的庞然大物，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 422250,
      "end_ms": 423730,
      "text": "他就那么存在在那里，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 423730,
      "end_ms": 424815,
      "text": "没有任何理由，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 425060,
      "end_ms": 426015,
      "text": "没有任何解释。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 426670,
      "end_ms": 432025,
      "text": "然后他明白了那个存在本身那个让万物在的东西，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 432510,
      "end_ms": 434805,
      "text": "原来是这样一种让人窒息的东西。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 435460,
      "end_ms": 437095,
      "text": "它不是抽象的哲学概念，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 437360,
      "end_ms": 438620,
      "text": "它是一种可以看见，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 438840,
      "end_ms": 439735,
      "text": "可以触摸，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 439990,
      "end_ms": 441405,
      "text": "可以让你想吐的东西。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 442080,
      "end_ms": 444485,
      "text": "他说恶心从未离开我，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 445110,
      "end_ms": 446995,
      "text": "我看他也不会很快离开我，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 447720,
      "end_ms": 451170,
      "text": "但是我不再忍受他他不再是疾病或症。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 451170,
      "end_ms": 451555,
      "text": "咳，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 452250,
      "end_ms": 452905,
      "text": "他是我，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 453480,
      "end_ms": 455295,
      "text": "这就是恶心最核心的东西。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 455810,
      "end_ms": 456830,
      "text": "恶心不是一种病，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 457150,
      "end_ms": 458225,
      "text": "不是一种症状。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 458860,
      "end_ms": 462265,
      "text": "恶心就是你意识到存在本身的那一刻，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 462860,
      "end_ms": 464360,
      "text": "你平时感觉不到存在，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 464640,
      "end_ms": 469655,
      "text": "因为你被词、被概念、被身份、被日常生活的惯性包裹着。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 470850,
      "end_ms": 471785,
      "text": "你走在街上，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 472070,
      "end_ms": 476015,
      "text": "你看到的全是商店、行人、红绿灯、手机屏幕。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 476630,
      "end_ms": 478170,
      "text": "你没有再看那些东西本身，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 478370,
      "end_ms": 479650,
      "text": "你把它们分门别类，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 479850,
      "end_ms": 480590,
      "text": "贴上标签，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 480810,
      "end_ms": 481575,
      "text": "放进抽屉，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 482130,
      "end_ms": 486515,
      "text": "然后你就忘了他们可某一天那个标签突然掉了，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 487030,
      "end_ms": 488290,
      "text": "你看到的不是树根，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 488530,
      "end_ms": 492115,
      "text": "而是那个东西本身赤裸裸的偶然的，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 492480,
      "end_ms": 493305,
      "text": "多余的，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 493780,
      "end_ms": 495440,
      "text": "他不是应该在这里的，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 495660,
      "end_ms": 496945,
      "text": "他只是在这里。"
    },
    {
      "segment_id": "s000226",
      "start_ms": 497570,
      "end_ms": 501305,
      "text": "你也是嗯洛根丁后来去见了那个自学者，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 501630,
      "end_ms": 504305,
      "text": "一个在图书馆里按字母顺序读书的男人。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 504890,
      "end_ms": 507110,
      "text": "这个自学者相信人性是善的，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 507310,
      "end_ms": 508890,
      "text": "相信知识可以拯救人，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 509090,
      "end_ms": 511385,
      "text": "相信世界有一个可以理解的秩序。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 511680,
      "end_ms": 512785,
      "text": "洛根丁看着他，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 513140,
      "end_ms": 514105,
      "text": "觉得他可怜，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 514500,
      "end_ms": 515425,
      "text": "也觉得他可怕。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 515960,
      "end_ms": 518045,
      "text": "因为自学者也是一个自欺者，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 518590,
      "end_ms": 521575,
      "text": "他用人性本善这个信念把自己包起来，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 521840,
      "end_ms": 524395,
      "text": "让自己不用去面对那个赤裸裸的存在。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 525020,
      "end_ms": 525340,
      "text": "最后，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 525340,
      "end_ms": 527680,
      "text": "自学者因为对小男孩做了什么不体面的事，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 527680,
      "end_ms": 528700,
      "text": "被赶出了图书馆，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 528900,
      "end_ms": 530235,
      "text": "他的信念碎了一地。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 530550,
      "end_ms": 533225,
      "text": "洛根丁看着他离开没有说什么，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 533750,
      "end_ms": 536290,
      "text": "他知道那个人以后要么会找到另一层壳，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 536290,
      "end_ms": 537255,
      "text": "把自己包起来，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 537540,
      "end_ms": 538965,
      "text": "要么就会开始恶心。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 539720,
      "end_ms": 541400,
      "text": "这本书的结局不是重生，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 541780,
      "end_ms": 542635,
      "text": "不是和解，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 542940,
      "end_ms": 544225,
      "text": "也不是彻底的绝望。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 545070,
      "end_ms": 546975,
      "text": "洛根丁最后决定离开布韦尔，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 547860,
      "end_ms": 548975,
      "text": "他坐在咖啡馆里，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 549300,
      "end_ms": 551925,
      "text": "听着那张他听过无数遍的爵士乐唱片，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 552510,
      "end_ms": 553345,
      "text": "他突然想到，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 554040,
      "end_ms": 556095,
      "text": "也许他可以不写那篇历史论文吗？"
    },
    {
      "segment_id": "s000253",
      "start_ms": 556610,
      "end_ms": 557990,
      "text": "也许他可以写一个故事，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 558210,
      "end_ms": 559890,
      "text": "写一个不会存在的故事，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 560070,
      "end_ms": 561665,
      "text": "一个纯粹的想象物。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 562520,
      "end_ms": 564365,
      "text": "那张唱片里的旋律是存在的，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 564620,
      "end_ms": 567085,
      "text": "但它不像是树根那样多余的存在，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 567650,
      "end_ms": 568875,
      "text": "他像是一种必然，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 569340,
      "end_ms": 573235,
      "text": "每一个音符都在他该在的地方组成一个完整的东西。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 573880,
      "end_ms": 575645,
      "text": "也许艺术可以做到这件事，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 575990,
      "end_ms": 577655,
      "text": "创造一种不恶心的存在。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 578280,
      "end_ms": 579700,
      "text": "洛根丁不知道能不能成，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 579980,
      "end_ms": 581085,
      "text": "但他决定试一次，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 581700,
      "end_ms": 583385,
      "text": "这就是恶心特别残酷，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 583670,
      "end_ms": 584805,
      "text": "也特别诚实的地方。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 585390,
      "end_ms": 587495,
      "text": "萨特没有告诉你怎么克服恶心，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 587880,
      "end_ms": 589670,
      "text": "他告诉你的是恶心，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 589670,
      "end_ms": 590885,
      "text": "是你醒来的证据。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 591360,
      "end_ms": 592380,
      "text": "你之所以恶心，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 592560,
      "end_ms": 594165,
      "text": "是因为你曾经自欺过，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 594620,
      "end_ms": 596625,
      "text": "而你终于不肯再骗自己了。"
    },
    {
      "segment_id": "s000272",
      "start_ms": 597070,
      "end_ms": 597975,
      "text": "你没有生病，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 598320,
      "end_ms": 599275,
      "text": "你只是看见了，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 600160,
      "end_ms": 600760,
      "text": "你看见了，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 600760,
      "end_ms": 602605,
      "text": "你一直假装看不见的东西。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 603010,
      "end_ms": 604410,
      "text": "你的存在没有理由，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 604610,
      "end_ms": 605990,
      "text": "你做的事情没有理由，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 606010,
      "end_ms": 607975,
      "text": "你给自己贴的那些标签没有理由。"
    },
    {
      "segment_id": "s000279",
      "start_ms": 608410,
      "end_ms": 609790,
      "text": "你可以在恶心里崩溃，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 610210,
      "end_ms": 612070,
      "text": "你也可以在恶心里做一个选择。"
    },
    {
      "segment_id": "s000281",
      "start_ms": 613270,
      "end_ms": 616130,
      "text": "萨特后来把这叫做存在先于本质。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 616850,
      "end_ms": 618290,
      "text": "你不是先有一个本质，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 618450,
      "end_ms": 621170,
      "text": "一个天生的身份使命性格，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 621450,
      "end_ms": 622610,
      "text": "然后才存在的。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 623330,
      "end_ms": 624690,
      "text": "你是先存在着，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 625190,
      "end_ms": 627210,
      "text": "赤裸裸的偶然的，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 627430,
      "end_ms": 629190,
      "text": "没有任何理由的存在着，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 629550,
      "end_ms": 631330,
      "text": "然后你才通过你的选择，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 631650,
      "end_ms": 633910,
      "text": "一点一点的造出你自己是谁？"
    },
    {
      "segment_id": "s000290",
      "start_ms": 634570,
      "end_ms": 636490,
      "text": "洛根丁在公园里说了一句话，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 636910,
      "end_ms": 637170,
      "text": "他说，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 637170,
      "end_ms": 639800,
      "text": "既既然所有的存在都相像，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 640260,
      "end_ms": 644360,
      "text": "那么所有的存在都是多余的这句话听起来很绝望。"
    },
    {
      "segment_id": "s000294",
      "start_ms": 644780,
      "end_ms": 645860,
      "text": "但他的另一面是，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 646440,
      "end_ms": 647520,
      "text": "既然没有理由，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 647740,
      "end_ms": 649320,
      "text": "那就意味着什么都可以。"
    },
    {
      "segment_id": "s000297",
      "start_ms": 649720,
      "end_ms": 651480,
      "text": "你可以选择继续演你的角色，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 651820,
      "end_ms": 652920,
      "text": "你也可以选择不演。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 653400,
      "end_ms": 655060,
      "text": "你可以选择当一个正常人，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 655260,
      "end_ms": 657880,
      "text": "你也可以选择当一个被恶心击穿的人。"
    },
    {
      "segment_id": "s000301",
      "start_ms": 658180,
      "end_ms": 659200,
      "text": "恶心不会消失，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 659740,
      "end_ms": 661220,
      "text": "但你可以学会带着他活，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 662120,
      "end_ms": 663380,
      "text": "不是因为他变好了，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 663800,
      "end_ms": 665720,
      "text": "而是因为你不再逃跑。"
    },
    {
      "segment_id": "s000305",
      "start_ms": 666160,
      "end_ms": 668875,
      "text": "为什么这么多年了恶心还是能能打中人？"
    },
    {
      "segment_id": "s000306",
      "start_ms": 669400,
      "end_ms": 671700,
      "text": "因为我们大多数人没有洛根丁那么极端，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 672000,
      "end_ms": 674135,
      "text": "却都多多少少懂一点他的感觉。"
    },
    {
      "segment_id": "s000308",
      "start_ms": 674840,
      "end_ms": 675985,
      "text": "你不是每天恶心，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 676390,
      "end_ms": 677835,
      "text": "但你可能有过那种时刻，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 678240,
      "end_ms": 678935,
      "text": "你在开会，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 679510,
      "end_ms": 680695,
      "text": "所有人都在说话，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 681100,
      "end_ms": 683045,
      "text": "你忽然觉得这一切都好奇怪，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 683550,
      "end_ms": 684670,
      "text": "这些人在干什么？"
    },
    {
      "segment_id": "s000314",
      "start_ms": 684750,
      "end_ms": 685975,
      "text": "我为什么租在这里？"
    },
    {
      "segment_id": "s000315",
      "start_ms": 686330,
      "end_ms": 687550,
      "text": "这些词是什么意思？"
    },
    {
      "segment_id": "s000316",
      "start_ms": 687750,
      "end_ms": 689755,
      "text": "你在刷手机刷着刷着，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 690020,
      "end_ms": 692145,
      "text": "忽然觉得屏幕上的东西离你好远，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 692480,
      "end_ms": 693205,
      "text": "你再看，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 693520,
      "end_ms": 694870,
      "text": "但你没有在看你，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 694870,
      "end_ms": 696005,
      "text": "只是让手指在动。"
    },
    {
      "segment_id": "s000321",
      "start_ms": 696460,
      "end_ms": 699485,
      "text": "你在和人聊天儿笑着附和着，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 700040,
      "end_ms": 701985,
      "text": "心里却像隔了一层玻璃。"
    },
    {
      "segment_id": "s000323",
      "start_ms": 702380,
      "end_ms": 703735,
      "text": "这些瞬间拉长了看，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 704080,
      "end_ms": 706065,
      "text": "就是一种对存在的隐隐不安。"
    },
    {
      "segment_id": "s000325",
      "start_ms": 706460,
      "end_ms": 707315,
      "text": "你不想承认，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 707620,
      "end_ms": 708320,
      "text": "因为承认了，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 708320,
      "end_ms": 709535,
      "text": "你就得面对那个问题。"
    },
    {
      "segment_id": "s000328",
      "start_ms": 709840,
      "end_ms": 711220,
      "text": "如果这一切都没有理由，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 711560,
      "end_ms": 712725,
      "text": "那我到底在干嘛？"
    },
    {
      "segment_id": "s000330",
      "start_ms": 713270,
      "end_ms": 714525,
      "text": "沙特不是来救你的，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 715080,
      "end_ms": 717125,
      "text": "他也不是来告诉你活着真好的。"
    },
    {
      "segment_id": "s000332",
      "start_ms": 717390,
      "end_ms": 719155,
      "text": "他做的事情和太宰治有一点像，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 719780,
      "end_ms": 721320,
      "text": "他把最不体面的感觉，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 721560,
      "end_ms": 722800,
      "text": "最没有答案的问题，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 723160,
      "end_ms": 724695,
      "text": "赤裸裸的摊在你面前，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 725180,
      "end_ms": 726985,
      "text": "但他比太宰治多走了一步。"
    },
    {
      "segment_id": "s000337",
      "start_ms": 727490,
      "end_ms": 728830,
      "text": "太宰治的业藏最后说，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 729050,
      "end_ms": 730735,
      "text": "我已经丧失做人资格，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 731060,
      "end_ms": 731860,
      "text": "然后消失了，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 731900,
      "end_ms": 733195,
      "text": "肉根丁没有消失，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 733530,
      "end_ms": 734665,
      "text": "他决定写一个故事。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 735450,
      "end_ms": 737175,
      "text": "你可以说那个故事微不足道，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 737630,
      "end_ms": 739125,
      "text": "你也可以说那是一种逃避。"
    },
    {
      "segment_id": "s000344",
      "start_ms": 739820,
      "end_ms": 743205,
      "text": "但萨特想说的是在一切都多余的世界里。"
    },
    {
      "segment_id": "s000345",
      "start_ms": 743610,
      "end_ms": 746805,
      "text": "你选择做什么这件事本身不是多余的，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 747450,
      "end_ms": 748545,
      "text": "因为他是你选的。"
    },
    {
      "segment_id": "s000347",
      "start_ms": 749130,
      "end_ms": 753335,
      "text": "也许这本书对我们最大的意义就在于让你知道恶心不是终点，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 754490,
      "end_ms": 757145,
      "text": "恶心是你第一次真正面对自己的存在。"
    },
    {
      "segment_id": "s000349",
      "start_ms": 758440,
      "end_ms": 759645,
      "text": "你以前一直在跑，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 760360,
      "end_ms": 760905,
      "text": "在演，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 761180,
      "end_ms": 761935,
      "text": "在假装，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 762760,
      "end_ms": 763965,
      "text": "现在你停下来了，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 764970,
      "end_ms": 766125,
      "text": "停下来很难受。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 766780,
      "end_ms": 767860,
      "text": "但停下来的时候，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 768060,
      "end_ms": 770365,
      "text": "你终于可以问自己一个真正的问题。"
    },
    {
      "segment_id": "s000356",
      "start_ms": 771170,
      "end_ms": 772415,
      "text": "既然没有理由，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 772810,
      "end_ms": 773855,
      "text": "那我想要什么，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 774280,
      "end_ms": 775575,
      "text": "你不一定会找到答案。"
    },
    {
      "segment_id": "s000359",
      "start_ms": 775930,
      "end_ms": 777370,
      "text": "但你至少不再假装自己，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 777370,
      "end_ms": 778885,
      "text": "不需要问这个问题了。"
    },
    {
      "segment_id": "s000361",
      "start_ms": 779310,
      "end_ms": 780105,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 780430,
      "end_ms": 782385,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "f9794b72b8bce5c2895fb2232c9d1c4f1b46208ed8ede81b6bda66ab6c97f5b4"
}