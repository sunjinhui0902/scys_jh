{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_7bc646162220f8e7_u001",
  "video_id": "v_7bc646162220f8e7",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 941.082993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 310,
      "end_ms": 3870,
      "text": "十六分钟讲解利奥施特劳斯哲学与城邦有一本书，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4190,
      "end_ms": 6570,
      "text": "在芝加哥大学的课堂上被讲了三次，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 7030,
      "end_ms": 9010,
      "text": "被整理成十五讲逐字稿，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9290,
      "end_ms": 12310,
      "text": "却在中文世界的政治哲学讨论里几乎隐形。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 12510,
      "end_ms": 13750,
      "text": "不是因为它不重要，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 13930,
      "end_ms": 15290,
      "text": "而是因为它太危险。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 15830,
      "end_ms": 16610,
      "text": "危险到会，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 16610,
      "end_ms": 19550,
      "text": "让三代中国学人信奉的那套哲学，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 19610,
      "end_ms": 20690,
      "text": "就是追求真理。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 20990,
      "end_ms": 22290,
      "text": "真理越辩越明，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 22710,
      "end_ms": 26190,
      "text": "思想应该公共化的认知框架发生七级地震。"
    },
    {
      "segment_id": "s000012",
      "start_ms": 26390,
      "end_ms": 31100,
      "text": "这本书叫哲学与城邦柏拉图、王志讲书作者，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 31100,
      "end_ms": 34000,
      "text": "列奥施特劳斯是芝加哥大学政治系教授。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 34080,
      "end_ms": 36280,
      "text": "但比这个头衔更值得注意的是，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 36280,
      "end_ms": 37440,
      "text": "他成为政治哲任。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 37440,
      "end_ms": 38360,
      "text": "之前的身份，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 38660,
      "end_ms": 41420,
      "text": "一个从德国流亡到美国的犹太学者，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 41860,
      "end_ms": 45320,
      "text": "他亲眼看着魏玛共和国如何在理性辩论中解体，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 45640,
      "end_ms": 48960,
      "text": "看着海德格尔如何在哲学的最高殿堂里走向纳粹。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 49640,
      "end_ms": 52680,
      "text": "一个经历过哲学与政治同时崩溃的人，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 52940,
      "end_ms": 54280,
      "text": "回过头去读柏拉图。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 54500,
      "end_ms": 56380,
      "text": "他看到的不是理想国的蓝图，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 56660,
      "end_ms": 60530,
      "text": "是一份关于哲学如何在城邦中活下来的生存手册。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 60670,
      "end_ms": 61310,
      "text": "离谱的是，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 61630,
      "end_ms": 63850,
      "text": "施特劳斯把这份手册讲出来之后，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 63950,
      "end_ms": 65145,
      "text": "遭遇的不是追捧，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 65550,
      "end_ms": 67745,
      "text": "是来自两个阵营的同时围攻。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 68270,
      "end_ms": 68770,
      "text": "自由派。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 68770,
      "end_ms": 69570,
      "text": "说他反民主，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 69790,
      "end_ms": 71385,
      "text": "保守派嫌他太精英，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 71850,
      "end_ms": 74290,
      "text": "人们宁可相信施特劳斯在故弄玄虚，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 74550,
      "end_ms": 76425,
      "text": "也不愿面对一个可怕的真相。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 76880,
      "end_ms": 78740,
      "text": "你对哲学和政治的认知，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 78940,
      "end_ms": 80220,
      "text": "从根儿上就错了。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 80340,
      "end_ms": 84885,
      "text": "今天这条文字我会拆出这本书里最颠覆的五个底层认知。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 85350,
      "end_ms": 86270,
      "text": "但我要提前警告，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 86270,
      "end_ms": 87270,
      "text": "你看完后，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 87470,
      "end_ms": 91590,
      "text": "你可能会推翻过去二十年、三十年奉为归孽的哲学，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 91610,
      "end_ms": 93670,
      "text": "追求真理、政治追求权利。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 93750,
      "end_ms": 95390,
      "text": "这个二分法如果没准备好，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 95390,
      "end_ms": 95990,
      "text": "被冒犯，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 96150,
      "end_ms": 97435,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 97770,
      "end_ms": 98855,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 99060,
      "end_ms": 100200,
      "text": "那我们开始进入正题。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 100340,
      "end_ms": 103090,
      "text": "第一层颠覆哲人与城邦之间，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 103090,
      "end_ms": 104305,
      "text": "不是合作关系，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 104550,
      "end_ms": 105650,
      "text": "是永恒冲突。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 105670,
      "end_ms": 106775,
      "text": "你有没有听过这句话？"
    },
    {
      "segment_id": "s000049",
      "start_ms": 107210,
      "end_ms": 108955,
      "text": "哲学应该走出象牙塔，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 109270,
      "end_ms": 110290,
      "text": "参与公共讨论，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 110490,
      "end_ms": 112105,
      "text": "为社会发展贡献智慧。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 112540,
      "end_ms": 114040,
      "text": "哲学与城邦第一个动作，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 114100,
      "end_ms": 115555,
      "text": "就把这套认知判了死刑。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 115790,
      "end_ms": 118855,
      "text": "施特劳斯在解读王志时提出了一个核心命题，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 119280,
      "end_ms": 122745,
      "text": "哲学与城邦在本性上朝向相反的方向。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 123770,
      "end_ms": 126225,
      "text": "哲学追求的是关于整全的知识。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 126730,
      "end_ms": 128290,
      "text": "他要追问的是什么？"
    },
    {
      "segment_id": "s000058",
      "start_ms": 128290,
      "end_ms": 129250,
      "text": "是正义本身，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 129570,
      "end_ms": 130790,
      "text": "什么是善本身？"
    },
    {
      "segment_id": "s000060",
      "start_ms": 130810,
      "end_ms": 132865,
      "text": "但城邦不是靠知识运作的，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 133230,
      "end_ms": 134535,
      "text": "城邦靠的是意见。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 134890,
      "end_ms": 136570,
      "text": "那些被多数人接受为真，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 136770,
      "end_ms": 137530,
      "text": "但实际上，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 137530,
      "end_ms": 141595,
      "text": "未经检验的信念、城邦的根基是祖传的习俗，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 141920,
      "end_ms": 144200,
      "text": "神圣的律法共同体的共识。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 144600,
      "end_ms": 146320,
      "text": "哲学一旦追问这些根基，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 146360,
      "end_ms": 149495,
      "text": "凭什么城邦的粘合剂就开始溶解？"
    },
    {
      "segment_id": "s000068",
      "start_ms": 149820,
      "end_ms": 151715,
      "text": "这不是施特劳斯在制造对立，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 151990,
      "end_ms": 156345,
      "text": "他是在描述一个被启蒙运动遮蔽了两千年的结构性事实。"
    },
    {
      "segment_id": "s000070",
      "start_ms": 156830,
      "end_ms": 158455,
      "text": "苏格拉底为什么被判死刑？"
    },
    {
      "segment_id": "s000071",
      "start_ms": 158840,
      "end_ms": 160445,
      "text": "不是因为他教坏了青年，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 160810,
      "end_ms": 162465,
      "text": "不是因为他亵渎了神灵，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 162950,
      "end_ms": 164935,
      "text": "是因为他把哲学带进了市场，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 165220,
      "end_ms": 167685,
      "text": "让城邦看见了自己根基上的裂缝。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 168090,
      "end_ms": 169085,
      "text": "施特劳斯说，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 169500,
      "end_ms": 171615,
      "text": "苏格拉里之死不是一场冤案，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 171960,
      "end_ms": 175640,
      "text": "是哲学与城邦永恒冲突的悲剧性表征。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 175940,
      "end_ms": 180365,
      "text": "这套话语的隐蔽暴力在于他逼你面对一个你不愿承认的问题。"
    },
    {
      "segment_id": "s000079",
      "start_ms": 180740,
      "end_ms": 183000,
      "text": "哲学如果以启蒙大众为目标，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 183160,
      "end_ms": 184385,
      "text": "它就不再是哲学，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 184690,
      "end_ms": 185410,
      "text": "而是另一种。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 185410,
      "end_ms": 186090,
      "text": "政治宣传。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 186190,
      "end_ms": 186970,
      "text": "施特劳斯说，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 187250,
      "end_ms": 189735,
      "text": "哲学家不统治也不能统治，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 190180,
      "end_ms": 192295,
      "text": "这不是因为哲学家道德上不够格，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 192640,
      "end_ms": 196460,
      "text": "是因为哲学的追问本身会瓦解统治所需要的那种。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 196460,
      "end_ms": 198940,
      "text": "确信你在追问什么是正义的时候，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 199100,
      "end_ms": 200240,
      "text": "城邦需要的是，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 200380,
      "end_ms": 201705,
      "text": "这就是正义的答案。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 202060,
      "end_ms": 203175,
      "text": "追问和答案之间，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 203480,
      "end_ms": 205440,
      "text": "隔着一整个政治生活的深渊。"
    },
    {
      "segment_id": "s000092",
      "start_ms": 205760,
      "end_ms": 206240,
      "text": "第二层，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 206240,
      "end_ms": 207440,
      "text": "颠覆隐微，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 207440,
      "end_ms": 207840,
      "text": "写作，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 207840,
      "end_ms": 208560,
      "text": "不是胆怯，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 208840,
      "end_ms": 210040,
      "text": "是思想的责任。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 210060,
      "end_ms": 212940,
      "text": "我们这代人从小被灌输好的思想应该公开。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 213140,
      "end_ms": 214765,
      "text": "透明人人可懂。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 215350,
      "end_ms": 218365,
      "text": "所以当一个人说这篇文章有言外之意时，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 218700,
      "end_ms": 221600,
      "text": "大家会下意识觉得他在故弄玄虚施特劳斯。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 221680,
      "end_ms": 222420,
      "text": "在讲述中，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 222420,
      "end_ms": 225305,
      "text": "反复展示了一个被现代学术遗忘的事实。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 225900,
      "end_ms": 228300,
      "text": "古典哲人写作是分层的显摆，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 228300,
      "end_ms": 229340,
      "text": "教会面向城邦，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 229600,
      "end_ms": 231600,
      "text": "用城邦能听懂的语言说话，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 231820,
      "end_ms": 233075,
      "text": "尊重城邦的意见，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 233500,
      "end_ms": 235100,
      "text": "引威教会面向少数，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 235100,
      "end_ms": 236555,
      "text": "能够承受追问的人，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 236850,
      "end_ms": 239035,
      "text": "在字里行间传递真正的思考。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 239410,
      "end_ms": 242835,
      "text": "为什么施特劳斯给出的理由不是哲人怕死？"
    },
    {
      "segment_id": "s000111",
      "start_ms": 243470,
      "end_ms": 245370,
      "text": "虽然迫害确实是真实的历史，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 245370,
      "end_ms": 250660,
      "text": "条件更深的理由是哲学真理对城邦具有腐蚀性。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 250880,
      "end_ms": 252380,
      "text": "如果一个社会的全部共识，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 252380,
      "end_ms": 255480,
      "text": "在一天之内被追问为未经检验的意见，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 255779,
      "end_ms": 257735,
      "text": "这个社会不会因此变得更自由，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 258050,
      "end_ms": 258835,
      "text": "他会崩溃。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 259170,
      "end_ms": 263795,
      "text": "施特劳斯亲眼见过魏玛共和国在理性辩论中被极端主义吞噬。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 264190,
      "end_ms": 265065,
      "text": "他太清楚，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 265420,
      "end_ms": 267415,
      "text": "真理不是对所有人都有意义的。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 267640,
      "end_ms": 269745,
      "text": "隐微写作的核心技术是得体。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 270140,
      "end_ms": 271300,
      "text": "什么该说什么，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 271300,
      "end_ms": 271840,
      "text": "不该说，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 272100,
      "end_ms": 274040,
      "text": "什么时候说对谁说，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 274180,
      "end_ms": 275095,
      "text": "这不是说谎。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 276090,
      "end_ms": 278975,
      "text": "哲学家在显摆层面说的每一句话都是真的，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 279330,
      "end_ms": 281145,
      "text": "只是他没有说出全部的真。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 281770,
      "end_ms": 284690,
      "text": "苏格拉底在王志里建构了一个言辞中的城邦，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 284850,
      "end_ms": 286555,
      "text": "但他自己并不打算住进去。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 286840,
      "end_ms": 287540,
      "text": "他告诉格劳，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 287540,
      "end_ms": 290775,
      "text": "孔和和阿德曼托斯一个完美的城邦应该是什么样，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 291060,
      "end_ms": 292980,
      "text": "但他没有说这个城邦可以实现。"
    },
    {
      "segment_id": "s000132",
      "start_ms": 293220,
      "end_ms": 293780,
      "text": "施特劳斯，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 293780,
      "end_ms": 295120,
      "text": "提醒我们注意苏格拉底。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 295120,
      "end_ms": 296840,
      "text": "在讲完共产主义城邦之后，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 297120,
      "end_ms": 299185,
      "text": "很快就转入了对灵魂的讨论。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 299970,
      "end_ms": 302330,
      "text": "城邦的讨论是为了灵魂的讨论，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 302330,
      "end_ms": 304130,
      "text": "铺路不是为了城邦本身。"
    },
    {
      "segment_id": "s000138",
      "start_ms": 304530,
      "end_ms": 305475,
      "text": "这意味着什么？"
    },
    {
      "segment_id": "s000139",
      "start_ms": 306120,
      "end_ms": 308540,
      "text": "意味着你以为施特劳斯在讲政治，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 308740,
      "end_ms": 310460,
      "text": "他其实在讲认知的界限，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 310600,
      "end_ms": 312140,
      "text": "你以为他在教你怎么治国？"
    },
    {
      "segment_id": "s000142",
      "start_ms": 312580,
      "end_ms": 315780,
      "text": "他在教你怎么在不说出全部真相的情况下，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 316020,
      "end_ms": 318000,
      "text": "仍然说出足够多的真相。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 318360,
      "end_ms": 320280,
      "text": "第三层颠覆为佳。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 320280,
      "end_ms": 321340,
      "text": "政治不是理想，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 321520,
      "end_ms": 322840,
      "text": "是一个界限概念。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 322960,
      "end_ms": 324100,
      "text": "主流认知告诉你，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 324120,
      "end_ms": 326200,
      "text": "柏拉图王治描绘了一个理想国，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 326360,
      "end_ms": 327740,
      "text": "一个完美社会的蓝图。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 328380,
      "end_ms": 329200,
      "text": "施特劳斯说，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 329660,
      "end_ms": 338110,
      "text": "你读反了王治里的那个美好城邦哲人王统治、卫世共产男女平等儿童共有施特劳底，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 338110,
      "end_ms": 340410,
      "text": "仔细分析了苏格拉底的每一处论证，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 340590,
      "end_ms": 341550,
      "text": "得出的结论是，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 341830,
      "end_ms": 343890,
      "text": "这个城邦在言辞中建构，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 344030,
      "end_ms": 346450,
      "text": "但苏格拉底从来没有说它可以实现。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 346890,
      "end_ms": 347590,
      "text": "恰恰相反，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 348110,
      "end_ms": 350710,
      "text": "苏格拉底自己指出了几处根本性的障碍。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 350830,
      "end_ms": 351250,
      "text": "他说，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 351430,
      "end_ms": 353150,
      "text": "共产制需要废除家庭，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 353350,
      "end_ms": 354470,
      "text": "但施特劳斯指出，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 354770,
      "end_ms": 356390,
      "text": "苏格拉底在讨论这个问题时，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 356490,
      "end_ms": 359310,
      "text": "明确的抽象掉了两性在生育上的差异。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 359750,
      "end_ms": 360450,
      "text": "也就是说，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 360890,
      "end_ms": 363690,
      "text": "苏格拉底绕开了身体自然需求这个障碍。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 364230,
      "end_ms": 365070,
      "text": "更关键的是，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 365230,
      "end_ms": 367805,
      "text": "苏格拉底后来干脆放弃了共产制的讨论。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 368410,
      "end_ms": 369390,
      "text": "施特劳斯认为，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 369610,
      "end_ms": 372630,
      "text": "这意味着苏格拉底对美好城邦的可能性，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 372630,
      "end_ms": 374150,
      "text": "这个问题悬而未决。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 374330,
      "end_ms": 375050,
      "text": "换句话说，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 375330,
      "end_ms": 376670,
      "text": "那个完美城邦的功能，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 376670,
      "end_ms": 378715,
      "text": "不是告诉你应该往哪里走，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 379000,
      "end_ms": 381345,
      "text": "是告诉你政治的界限在哪里。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 381610,
      "end_ms": 382430,
      "text": "施特劳斯说，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 382710,
      "end_ms": 385365,
      "text": "苏格拉底展示的是政治生活的限度，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 385800,
      "end_ms": 388260,
      "text": "最佳政治自然的存在于言辞中，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 388460,
      "end_ms": 391005,
      "text": "但在行动中既不可能也不自然，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 391220,
      "end_ms": 392960,
      "text": "它的价值不在于可操作性，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 393240,
      "end_ms": 394585,
      "text": "在于它像一个极点，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 394910,
      "end_ms": 397585,
      "text": "让你知道现实政治永远无法抵达，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 397940,
      "end_ms": 399520,
      "text": "但你可以用它来判断方向。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 399720,
      "end_ms": 403945,
      "text": "这套逻辑彻底取消了理想主义VS现实主义这个伪选择题，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 404380,
      "end_ms": 406975,
      "text": "你既不必因为理想无法实现而犬儒，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 407300,
      "end_ms": 409520,
      "text": "也不必因为现实不完美而狂怒。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 409740,
      "end_ms": 413135,
      "text": "施特劳斯教你的是一种在界限内思考的能力，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 413500,
      "end_ms": 414580,
      "text": "知道什么不可能，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 414860,
      "end_ms": 416785,
      "text": "同时知道什么值得追求。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 417270,
      "end_ms": 419950,
      "text": "第四层颠覆哲学家不统治，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 420210,
      "end_ms": 423390,
      "text": "也不应该统治市面上关于知识分子的讨论。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 423430,
      "end_ms": 426830,
      "text": "百分之九十九集中在知识分子该不该参政这个层面。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 426890,
      "end_ms": 427290,
      "text": "有人说，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 427290,
      "end_ms": 429804,
      "text": "应该因为专业知识可以改善治理。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 430260,
      "end_ms": 430660,
      "text": "有人说，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 430660,
      "end_ms": 433025,
      "text": "不该因为权力会腐蚀思想，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 433470,
      "end_ms": 434450,
      "text": "哲学与城邦说，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 434770,
      "end_ms": 435815,
      "text": "你把问题问错了。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 436140,
      "end_ms": 438135,
      "text": "施特劳斯最令人不安的论断是，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 438470,
      "end_ms": 441910,
      "text": "哲学家对城邦没有义务哲学的生活方式，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 442130,
      "end_ms": 444685,
      "text": "沉思的生活本身是自足的。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 445240,
      "end_ms": 446640,
      "text": "在王治的核心段落里，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 446780,
      "end_ms": 448575,
      "text": "苏格拉里讨论哲学时指出，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 449070,
      "end_ms": 451015,
      "text": "只有哲学家是真正正义的，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 451230,
      "end_ms": 454720,
      "text": "因为只有在他身上灵魂中最好的部分理性，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 455040,
      "end_ms": 456225,
      "text": "才在好好工作，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 456610,
      "end_ms": 459735,
      "text": "也只有在哲学中正义和幸福才重合。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 460240,
      "end_ms": 460965,
      "text": "但紧接着，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 461270,
      "end_ms": 463190,
      "text": "施特劳斯注意到一个关键细节，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 463510,
      "end_ms": 465235,
      "text": "哲学家拒绝统治。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 465690,
      "end_ms": 466730,
      "text": "在最佳城邦里，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 466810,
      "end_ms": 468185,
      "text": "哲学家不愿意统治。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 468450,
      "end_ms": 469510,
      "text": "在任何城邦里，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 469630,
      "end_ms": 471085,
      "text": "哲学家都不愿意统治。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 471680,
      "end_ms": 472465,
      "text": "这不是傲慢，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 472840,
      "end_ms": 476160,
      "text": "这是对哲学生活本性的忠实统治。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 476180,
      "end_ms": 477505,
      "text": "需要关注具体事物，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 477780,
      "end_ms": 479340,
      "text": "需要做出不完美的决定，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 479520,
      "end_ms": 484575,
      "text": "需要在信息不完整的情况下行动哲学需要的是闲暇追问，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 484860,
      "end_ms": 485825,
      "text": "不给予结论。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 486450,
      "end_ms": 488650,
      "text": "两者在灵魂层面就是不同的取向。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 489070,
      "end_ms": 491670,
      "text": "施特劳斯不是在说哲学家比政治家高贵。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 491970,
      "end_ms": 496555,
      "text": "他是在说你以为哲学家应该用思想服务社会？"
    },
    {
      "segment_id": "s000222",
      "start_ms": 496960,
      "end_ms": 500665,
      "text": "这个要求本身就来自一种对哲学本性的误解。"
    },
    {
      "segment_id": "s000223",
      "start_ms": 501180,
      "end_ms": 502815,
      "text": "哲学不服务任何东西，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 503220,
      "end_ms": 504895,
      "text": "哲学就是他自己的目的。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 505170,
      "end_ms": 507965,
      "text": "你当然可以要求一个知识分子参与公共事务，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 508240,
      "end_ms": 510175,
      "text": "但你不能要求哲学参与。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 510640,
      "end_ms": 512600,
      "text": "当哲学被要求有用的时候，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 512680,
      "end_ms": 514140,
      "text": "他要么变成意识形态，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 514220,
      "end_ms": 515345,
      "text": "要么变成技术，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 515690,
      "end_ms": 517375,
      "text": "两条路都通不到真理。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 517570,
      "end_ms": 521570,
      "text": "第五层颠覆学习王志唯一的终点是让你离开，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 521670,
      "end_ms": 523735,
      "text": "信不信柏拉图这个伪命题？"
    },
    {
      "segment_id": "s000233",
      "start_ms": 524100,
      "end_ms": 524600,
      "text": "读到这里，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 524600,
      "end_ms": 525335,
      "text": "你可能想问，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 525750,
      "end_ms": 530290,
      "text": "说了这么多最终目标不还是让人接受施特劳斯对柏拉图的理解吗？"
    },
    {
      "segment_id": "s000236",
      "start_ms": 530370,
      "end_ms": 533205,
      "text": "施特劳斯自己就是施特劳斯学派的创始人，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 533560,
      "end_ms": 534180,
      "text": "他讲书，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 534180,
      "end_ms": 536980,
      "text": "王志不就是在建立一套正统解读吗？"
    },
    {
      "segment_id": "s000239",
      "start_ms": 537000,
      "end_ms": 537620,
      "text": "如果你这样，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 537620,
      "end_ms": 539150,
      "text": "想你就掉进了这本书，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 539150,
      "end_ms": 540395,
      "text": "埋了六十年的陷阱。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 540650,
      "end_ms": 545825,
      "text": "施特劳斯在一九五七年芝加哥大学的课堂上面对的是美国最好的研究生，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 546110,
      "end_ms": 547190,
      "text": "他讲的不是柏拉图，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 547190,
      "end_ms": 547875,
      "text": "说了什么，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 548150,
      "end_ms": 550725,
      "text": "是你如何在阅读一个古典文本时，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 550990,
      "end_ms": 553885,
      "text": "不把自己的现代假设塞进古人的嘴里？"
    },
    {
      "segment_id": "s000247",
      "start_ms": 554150,
      "end_ms": 557665,
      "text": "他反复使用的词是得体阅读的得体，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 558040,
      "end_ms": 558915,
      "text": "理解的得体，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 559310,
      "end_ms": 560215,
      "text": "体问的得体。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 560780,
      "end_ms": 561700,
      "text": "他教的第一件事，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 561720,
      "end_ms": 563905,
      "text": "不是你应该认为柏拉图是对的，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 564170,
      "end_ms": 567365,
      "text": "而是你如何判断一个解读是否得体，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 567780,
      "end_ms": 568345,
      "text": "为什么？"
    },
    {
      "segment_id": "s000254",
      "start_ms": 568700,
      "end_ms": 569740,
      "text": "因为他太清楚，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 570040,
      "end_ms": 571100,
      "text": "在经典阅读中，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 571280,
      "end_ms": 575760,
      "text": "最稀缺的不是结论是nice.你有能力把一个文本读慢，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 576040,
      "end_ms": 577740,
      "text": "有能力注意到作者在哪里，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 577740,
      "end_ms": 578800,
      "text": "停顿在哪里，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 578800,
      "end_ms": 580200,
      "text": "转移话题在哪里，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 580200,
      "end_ms": 580920,
      "text": "用一个词，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 581000,
      "end_ms": 582175,
      "text": "而不用另一个词。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 582780,
      "end_ms": 586105,
      "text": "有能力在别人以为已经有答案的地方停下来。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 587140,
      "end_ms": 589580,
      "text": "施特劳斯在讲书中经常做一件事，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 590030,
      "end_ms": 590430,
      "text": "指出，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 590430,
      "end_ms": 594210,
      "text": "柏拉图在某个关键段落里没有说什么苏格拉底，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 594210,
      "end_ms": 595650,
      "text": "没有证明共产制可行。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 596090,
      "end_ms": 599100,
      "text": "苏格拉底没有说哲学家应该统治苏格拉底，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 599100,
      "end_ms": 600895,
      "text": "没有说那个城邦可以实现。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 601380,
      "end_ms": 603425,
      "text": "沉默是文本的一部分。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 603980,
      "end_ms": 605075,
      "text": "施特劳斯写道，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 605440,
      "end_ms": 606160,
      "text": "好的阅读，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 606240,
      "end_ms": 607105,
      "text": "不给你答案，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 607480,
      "end_ms": 608835,
      "text": "给你对问题的敏感。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 609250,
      "end_ms": 610730,
      "text": "你需要的能力不是记住，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 610730,
      "end_ms": 612090,
      "text": "柏拉图是理念论者，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 612290,
      "end_ms": 615330,
      "text": "是能够在面对一个论证时分辨他的前提。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 615490,
      "end_ms": 617890,
      "text": "他的边界他没有说出来的东西。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 618270,
      "end_ms": 619390,
      "text": "读完哲学与城邦，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 619450,
      "end_ms": 621190,
      "text": "你可能发现书名起错了。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 621550,
      "end_ms": 623110,
      "text": "这不是一本柏拉图解读，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 623470,
      "end_ms": 627950,
      "text": "是一本关于人如何在追问与行动之间安身立命的练习册。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 628610,
      "end_ms": 630350,
      "text": "芝加哥大学教授不是重点，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 630670,
      "end_ms": 632250,
      "text": "隐威写作不是重点，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 632410,
      "end_ms": 635010,
      "text": "哲学与城邦的冲突也不是重点，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 635370,
      "end_ms": 638010,
      "text": "重点是那个从德国流亡到美国的学者，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 638230,
      "end_ms": 640960,
      "text": "面对是个个现代学术判了过时的领域，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 640980,
      "end_ms": 643360,
      "text": "说我不服从进步叙事，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 643660,
      "end_ms": 647080,
      "text": "我只服从我在古典文本中看见的结构性真相，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 647680,
      "end_ms": 648740,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000290",
      "start_ms": 648980,
      "end_ms": 651920,
      "text": "他看见哲学不是政治的指导者，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 652180,
      "end_ms": 653360,
      "text": "不是政治的附庸，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 653600,
      "end_ms": 656100,
      "text": "不是需要被应用到现实中的工具箱，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 656640,
      "end_ms": 657780,
      "text": "它是一面镜子，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 657980,
      "end_ms": 660000,
      "text": "映照出人类最根本的处境。"
    },
    {
      "segment_id": "s000295",
      "start_ms": 660480,
      "end_ms": 661800,
      "text": "我们知道一些东西，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 661960,
      "end_ms": 663520,
      "text": "我们不知道更多东西，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 663700,
      "end_ms": 666400,
      "text": "而我们必须在不知道中决定如何生活，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 666620,
      "end_ms": 667900,
      "text": "如何与城邦相处。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 668400,
      "end_ms": 668760,
      "text": "这本书。"
    },
    {
      "segment_id": "s000300",
      "start_ms": 668760,
      "end_ms": 671650,
      "text": "最最后有一段话是施特劳斯在讲书，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 671670,
      "end_ms": 674095,
      "text": "末尾对学生我想把它留给你。"
    },
    {
      "segment_id": "s000302",
      "start_ms": 674750,
      "end_ms": 677410,
      "text": "你们问我读了王志之后应该怎么做？"
    },
    {
      "segment_id": "s000303",
      "start_ms": 677490,
      "end_ms": 678995,
      "text": "我应该成为一个哲学家，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 679280,
      "end_ms": 680195,
      "text": "还是一个政治家？"
    },
    {
      "segment_id": "s000305",
      "start_ms": 680390,
      "end_ms": 682445,
      "text": "我的回答是你问错了，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 682740,
      "end_ms": 684675,
      "text": "苏格拉底没有告诉你成为什么。"
    },
    {
      "segment_id": "s000307",
      "start_ms": 684950,
      "end_ms": 687650,
      "text": "他告诉你的是在你成为任何东西之前，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 687890,
      "end_ms": 690475,
      "text": "先搞清楚你正在追问的是什么。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 690910,
      "end_ms": 693025,
      "text": "哲学生活不是一种职业选择，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 693340,
      "end_ms": 695135,
      "text": "是一种对整全的欲求。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 695430,
      "end_ms": 698225,
      "text": "这种欲求会让你和城邦之间产生张力，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 698910,
      "end_ms": 700330,
      "text": "这种张力不会消失，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 700510,
      "end_ms": 703225,
      "text": "你只能在张力中学会得体的生活，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 703720,
      "end_ms": 706795,
      "text": "这才是我从一九五七年春天开始，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 707140,
      "end_ms": 708795,
      "text": "每一堂课都在做的事。"
    },
    {
      "segment_id": "s000316",
      "start_ms": 709280,
      "end_ms": 711635,
      "text": "最后我想认真推荐一次这本书。"
    },
    {
      "segment_id": "s000317",
      "start_ms": 712410,
      "end_ms": 713970,
      "text": "如果你看到这里还没有划走，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 714170,
      "end_ms": 715390,
      "text": "说明你心里有一个问题，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 715390,
      "end_ms": 717170,
      "text": "一直没有被回答我，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 717170,
      "end_ms": 720285,
      "text": "到底该怎么面对思考和行动之间的裂缝。"
    },
    {
      "segment_id": "s000321",
      "start_ms": 721050,
      "end_ms": 723315,
      "text": "哲学与城邦就是为这个问题写的。"
    },
    {
      "segment_id": "s000322",
      "start_ms": 723830,
      "end_ms": 725335,
      "text": "他不是让你信柏拉图，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 725860,
      "end_ms": 731100,
      "text": "它是让你看见信和不信之间那篇被我们粗暴彩屏的阅读地带。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 731280,
      "end_ms": 732720,
      "text": "你们看的这个版本的解读，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 732960,
      "end_ms": 735215,
      "text": "文案优化了不下五次第一版，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 735490,
      "end_ms": 738070,
      "text": "我试图把十五讲的每一层论证都摊开，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 738310,
      "end_ms": 740325,
      "text": "结果像教科书没人读得下去。"
    },
    {
      "segment_id": "s000328",
      "start_ms": 740770,
      "end_ms": 741345,
      "text": "第二版，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 741670,
      "end_ms": 744015,
      "text": "我试图把尹微写作讲成一个阴谋论，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 744330,
      "end_ms": 745395,
      "text": "结果像地摊文学，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 745700,
      "end_ms": 747605,
      "text": "对不起石特老斯第三版。"
    },
    {
      "segment_id": "s000332",
      "start_ms": 747960,
      "end_ms": 750680,
      "text": "我试图用民主VS精英来框住这本书，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 750820,
      "end_ms": 754295,
      "text": "结果发现自己连施特劳斯对民主的真正态度都没搞清楚。"
    },
    {
      "segment_id": "s000334",
      "start_ms": 754740,
      "end_ms": 755275,
      "text": "第四版。"
    },
    {
      "segment_id": "s000335",
      "start_ms": 755500,
      "end_ms": 758460,
      "text": "我试图绕开那些不能碰的政治哲学争议结果，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 758460,
      "end_ms": 761240,
      "text": "只剩下一些不痛不痒的阅读技巧到第五版。"
    },
    {
      "segment_id": "s000337",
      "start_ms": 761300,
      "end_ms": 762105,
      "text": "我才明白，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 762600,
      "end_ms": 764995,
      "text": "真正的解读不是替施特劳斯说话，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 765350,
      "end_ms": 767510,
      "text": "是把你送到那十五讲的课堂门口，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 767830,
      "end_ms": 768835,
      "text": "然后退后一步。"
    },
    {
      "segment_id": "s000341",
      "start_ms": 769080,
      "end_ms": 770040,
      "text": "由于平台规则，"
    },
    {
      "segment_id": "s000342",
      "start_ms": 770240,
      "end_ms": 772815,
      "text": "有些细节无法展开哪些细节？"
    },
    {
      "segment_id": "s000343",
      "start_ms": 773230,
      "end_ms": 778045,
      "text": "比如施特劳斯在讲述中对修西底德的穿插引用意味着什么？"
    },
    {
      "segment_id": "s000344",
      "start_ms": 778430,
      "end_ms": 780500,
      "text": "比如自然权利和自然法，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 780740,
      "end_ms": 784275,
      "text": "在施特劳斯那里差一个字就换了整个论证的方向。"
    },
    {
      "segment_id": "s000346",
      "start_ms": 784660,
      "end_ms": 788035,
      "text": "比如他为什么要在讲王志的时候反复提到阿里斯托芬？"
    },
    {
      "segment_id": "s000347",
      "start_ms": 788390,
      "end_ms": 790945,
      "text": "比如他对海德格尔的沉默到底是什么意思？"
    },
    {
      "segment_id": "s000348",
      "start_ms": 791350,
      "end_ms": 793330,
      "text": "这些东西一旦展开这条内容，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 793330,
      "end_ms": 794390,
      "text": "大概率活不过今晚。"
    },
    {
      "segment_id": "s000350",
      "start_ms": 794470,
      "end_ms": 798275,
      "text": "所以你在屏幕上看到的是删掉三层学术脉络，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 798590,
      "end_ms": 800155,
      "text": "砍掉五处历史例证，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 800450,
      "end_ms": 802350,
      "text": "绕开四个不能碰的概念之后，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 802590,
      "end_ms": 804334,
      "text": "仍然能留下来的股价。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 804750,
      "end_ms": 806685,
      "text": "真正的血肉在书里，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 807060,
      "end_ms": 808665,
      "text": "平台能限制一段文案，"
    },
    {
      "segment_id": "s000356",
      "start_ms": 809010,
      "end_ms": 810470,
      "text": "限制不了一本书的厚度。"
    },
    {
      "segment_id": "s000357",
      "start_ms": 810550,
      "end_ms": 811975,
      "text": "这本书适合三种人，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 812250,
      "end_ms": 815210,
      "text": "第一种是被理想VS现实这个伪命题。"
    },
    {
      "segment_id": "s000359",
      "start_ms": 815210,
      "end_ms": 816070,
      "text": "夹在中间的人，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 816070,
      "end_ms": 817070,
      "text": "你既不想犬儒，"
    },
    {
      "segment_id": "s000361",
      "start_ms": 817350,
      "end_ms": 818385,
      "text": "也不想天真，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 818850,
      "end_ms": 820855,
      "text": "但你没有语言描述自己的位置，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 821410,
      "end_ms": 822910,
      "text": "施图劳斯给你语言。"
    },
    {
      "segment_id": "s000364",
      "start_ms": 822990,
      "end_ms": 825175,
      "text": "第二种是想训练阅读能力的人。"
    },
    {
      "segment_id": "s000365",
      "start_ms": 825330,
      "end_ms": 827605,
      "text": "你以为读经典是理解作者的意思。"
    },
    {
      "segment_id": "s000366",
      "start_ms": 828000,
      "end_ms": 829095,
      "text": "赤特劳斯告诉你，"
    },
    {
      "segment_id": "s000367",
      "start_ms": 829330,
      "end_ms": 831490,
      "text": "读经典是理解作者为什么这样写，"
    },
    {
      "segment_id": "s000368",
      "start_ms": 831570,
      "end_ms": 832430,
      "text": "而不是那样写。"
    }
  ],
  "source_transcript_sha256": "c03d78f7f01cf3491053e1ae89979838308be167a15030cef950cee28479621e"
}