{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_9ca608cbe701f27c_u001",
  "video_id": "v_9ca608cbe701f27c",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 785.740998,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 70,
      "end_ms": 3810,
      "text": "上一集咱们讲了我国十个医生必去一次的地方。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4210,
      "end_ms": 10630,
      "text": "从第十个一路讲到了第六个有人在评论区说壶口瀑布那个震动，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 10650,
      "end_ms": 12130,
      "text": "隔着屏幕都能感觉到。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 12550,
      "end_ms": 13510,
      "text": "可我跟您说，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 13770,
      "end_ms": 16250,
      "text": "壶口排第六前五名，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 16290,
      "end_ms": 18770,
      "text": "一个比一个压不住榜首，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 18770,
      "end_ms": 21530,
      "text": "那个地方全世界都知道他的名字，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 22010,
      "end_ms": 25950,
      "text": "可百分之九十九的中国人去的都不是最该去的那一段，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 26490,
      "end_ms": 27350,
      "text": "还是咱们的。"
    },
    {
      "segment_id": "s000010",
      "start_ms": 27350,
      "end_ms": 27990,
      "text": "老规矩，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 28830,
      "end_ms": 30000,
      "text": "开讲前老返口，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 30060,
      "end_ms": 32740,
      "text": "各位老友顺手点亮红心评论区，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 32740,
      "end_ms": 35980,
      "text": "打个来了让我看看今天又有多少知音来捧场。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 36980,
      "end_ms": 37700,
      "text": "第五名，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 38480,
      "end_ms": 44300,
      "text": "泸沽湖、云南和四川交界的地方有一个湖叫泸沽湖，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 45000,
      "end_ms": 47100,
      "text": "海拔两千六百多米。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 47400,
      "end_ms": 49020,
      "text": "这个湖面积不算大，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 49640,
      "end_ms": 50940,
      "text": "五十多平方公里，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 51180,
      "end_ms": 53800,
      "text": "可它有一个别的湖比不了的东西，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 53800,
      "end_ms": 54580,
      "text": "水的颜色，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 55480,
      "end_ms": 60615,
      "text": "泸沽湖的水能见度最高能到十二米十二米是什么概念呢？"
    },
    {
      "segment_id": "s000022",
      "start_ms": 61000,
      "end_ms": 63360,
      "text": "就是您站在船上往水里看，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 63580,
      "end_ms": 69675,
      "text": "能直接看到十二米深的湖底、石头、水草、鱼看得清清楚楚，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 70100,
      "end_ms": 72425,
      "text": "湖水的颜色也不是固定的。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 73190,
      "end_ms": 76090,
      "text": "早上是深蓝的中午，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 76190,
      "end_ms": 78545,
      "text": "阳光直射变成翡翠绿。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 79350,
      "end_ms": 80670,
      "text": "傍晚太阳低了，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 80670,
      "end_ms": 82315,
      "text": "又变成一种灰蓝色，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 82880,
      "end_ms": 86615,
      "text": "一天之内三种颜色每种都干净的不像话。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 87300,
      "end_ms": 89335,
      "text": "泸沽湖边住着摩梭人，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 90150,
      "end_ms": 91615,
      "text": "摩梭人有一个传统，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 92220,
      "end_ms": 97555,
      "text": "到了天亮之前最安静的时候会划着诛曹船到湖中间去，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 97910,
      "end_ms": 98575,
      "text": "船不大，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 99130,
      "end_ms": 100785,
      "text": "一个人刚好坐进去。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 101180,
      "end_ms": 102355,
      "text": "湖面上没有风，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 102940,
      "end_ms": 105240,
      "text": "水面平的像一块镜子，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 105300,
      "end_ms": 107355,
      "text": "船划过去留下一道纹路，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 107730,
      "end_ms": 108550,
      "text": "慢慢散开，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 108970,
      "end_ms": 112090,
      "text": "然后又平了摩梭人管。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 112150,
      "end_ms": 115160,
      "text": "泸沽湖叫母亲湖传说，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 115260,
      "end_ms": 116860,
      "text": "湖底住着一位女神，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 117360,
      "end_ms": 120675,
      "text": "守着这片水传说归传说。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 121130,
      "end_ms": 126115,
      "text": "可这个湖确实安静到让人觉得水底真有什么东西在看着你。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 126940,
      "end_ms": 131595,
      "text": "一个湖水干净到能看见十二米深的湖底，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 132370,
      "end_ms": 134010,
      "text": "住了几百年的人，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 134010,
      "end_ms": 134910,
      "text": "管他叫母亲。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 135450,
      "end_ms": 147030,
      "text": "第四名布达拉宫西藏拉萨布达拉宫修在红山上面，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 147070,
      "end_ms": 148725,
      "text": "海拔三千七百多米，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 149470,
      "end_ms": 151855,
      "text": "到今天已经一千三百多年了。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 152400,
      "end_ms": 155175,
      "text": "布达拉宫主体高一百一十七米，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 155980,
      "end_ms": 157700,
      "text": "从山脚到宫殿顶，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 157740,
      "end_ms": 158815,
      "text": "一共十三层，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 159800,
      "end_ms": 161975,
      "text": "这个高度放在今天不算什么。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 162370,
      "end_ms": 163225,
      "text": "可您想想，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 163750,
      "end_ms": 165845,
      "text": "这是一千三百多年前修的，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 166190,
      "end_ms": 166890,
      "text": "没有钢筋，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 166890,
      "end_ms": 167470,
      "text": "没有水泥，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 167470,
      "end_ms": 168205,
      "text": "没有吊车，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 168720,
      "end_ms": 172305,
      "text": "一块一块石头从山脚背上去垒起来。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 173390,
      "end_ms": 176245,
      "text": "宫殿的墙体最后的地方有五米，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 176750,
      "end_ms": 178745,
      "text": "底部的石墙里面灌着铁汁，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 179570,
      "end_ms": 181190,
      "text": "所以站了一千三百多年。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 181190,
      "end_ms": 183190,
      "text": "到今天地震都没把它荒塌。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 183330,
      "end_ms": 187035,
      "text": "布达拉宫里面有大大小小一千多间房，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 187490,
      "end_ms": 191225,
      "text": "供奉着几百尊佛像和大量的经文典籍。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 191700,
      "end_ms": 193840,
      "text": "可最让人震撼的不是佛像，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 193840,
      "end_ms": 194595,
      "text": "不是经文，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 195010,
      "end_ms": 197270,
      "text": "是走进去之后的那种感觉。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 197310,
      "end_ms": 199435,
      "text": "酥油灯的光是暗黄色，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 199980,
      "end_ms": 203745,
      "text": "空气里有一股酥油和藏香混在一起的味道。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 204330,
      "end_ms": 213285,
      "text": "脚底下的地板被刻长头的人用身体蹭了几百年光滑的反光转经筒在走廊里一排一排的立着，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 213920,
      "end_ms": 215540,
      "text": "有人一个一个的转过去，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 215560,
      "end_ms": 217775,
      "text": "嘴里念着什么表情很平，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 218410,
      "end_ms": 219930,
      "text": "您不需要信什么，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 220090,
      "end_ms": 221490,
      "text": "可走在里面的时候，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 221490,
      "end_ms": 223155,
      "text": "脚步会自己慢下来，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 223470,
      "end_ms": 225435,
      "text": "说话声音会自己小下去。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 226070,
      "end_ms": 228965,
      "text": "一千三百多年的地方有这个本事，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 229420,
      "end_ms": 230685,
      "text": "不用跟你讲道理，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 230970,
      "end_ms": 232145,
      "text": "他就让你安静了。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 232760,
      "end_ms": 235235,
      "text": "修在三千七百米的山顶上，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 235570,
      "end_ms": 237385,
      "text": "一千三百多年没他过，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 237930,
      "end_ms": 240255,
      "text": "里面的苏油灯不知道续了多少代了，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 240640,
      "end_ms": 242295,
      "text": "到今天还亮着。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 242770,
      "end_ms": 243465,
      "text": "第三名，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 245070,
      "end_ms": 246195,
      "text": "敦煌莫高窟，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 247490,
      "end_ms": 253740,
      "text": "甘肃敦煌莫高窟这个地方排第三，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 253740,
      "end_ms": 255760,
      "text": "不是因为它好看好看的地方，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 255780,
      "end_ms": 258360,
      "text": "前面讲了好几个莫高窟排第三，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 258360,
      "end_ms": 259975,
      "text": "是因为它正在消失。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 260530,
      "end_ms": 265495,
      "text": "莫高窟开凿于公元三百六十六年到今天将近一千七百年，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 265980,
      "end_ms": 269125,
      "text": "一千七百年里前前后后开了七百多个洞，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 269620,
      "end_ms": 272555,
      "text": "保存到今天的有四百九十二个，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 273250,
      "end_ms": 278155,
      "text": "里面有四万五千多平方米的壁画和两千多尊彩塑。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 279080,
      "end_ms": 282205,
      "text": "四万五千平方米的壁画是什么概念呢？"
    },
    {
      "segment_id": "s000096",
      "start_ms": 282700,
      "end_ms": 285560,
      "text": "如果把这些壁画一幅一幅排成一排，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 285920,
      "end_ms": 288265,
      "text": "能排将近二十五公里长。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 288910,
      "end_ms": 289795,
      "text": "可问题是，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 290400,
      "end_ms": 292520,
      "text": "这些壁画在消失，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 292800,
      "end_ms": 294795,
      "text": "敦煌的气候是干燥的，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 295480,
      "end_ms": 296215,
      "text": "风沙大。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 296750,
      "end_ms": 297910,
      "text": "昼夜温差大，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 298710,
      "end_ms": 300250,
      "text": "壁画画在泥壁上，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 300750,
      "end_ms": 305530,
      "text": "颜料是矿物质的一千多年下来氧化干裂，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 305650,
      "end_ms": 306650,
      "text": "其甲脱落，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 307190,
      "end_ms": 308510,
      "text": "每一天都在变，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 308970,
      "end_ms": 310510,
      "text": "加上游客进去之后，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 310510,
      "end_ms": 312210,
      "text": "呼出的二氧化碳和水汽，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 312530,
      "end_ms": 314430,
      "text": "改变洞窟内的微环境，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 315290,
      "end_ms": 317010,
      "text": "壁画的退化在加速。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 317970,
      "end_ms": 322390,
      "text": "加在莫高窟每天限流六千人进去之前，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 322490,
      "end_ms": 324250,
      "text": "要先看两部数字电影，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 324270,
      "end_ms": 325030,
      "text": "了解背景，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 325450,
      "end_ms": 328760,
      "text": "然后由讲解员带着进洞窟，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 329220,
      "end_ms": 331700,
      "text": "每个窟停留时间有限制，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 331720,
      "end_ms": 333800,
      "text": "不是景区故意为难，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 333800,
      "end_ms": 335700,
      "text": "人是真的扛不住了。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 336640,
      "end_ms": 339240,
      "text": "有些洞窟已经永久关闭了，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 339960,
      "end_ms": 343060,
      "text": "里面的壁画只能看数字化的复制品。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 343980,
      "end_ms": 348160,
      "text": "您今天去看到的莫高窟和十年前去看到的已经不一样了，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 348500,
      "end_ms": 351440,
      "text": "十年后去看到的还会再变，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 352120,
      "end_ms": 355340,
      "text": "这是一个每一天都在少一点的地方。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 356060,
      "end_ms": 358730,
      "text": "所以说莫高窟不是想去就去的地方，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 358970,
      "end_ms": 361105,
      "text": "是再不去就晚了的地方。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 361690,
      "end_ms": 365470,
      "text": "一千七百年的壁画正在一天一天的消失。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 365650,
      "end_ms": 366450,
      "text": "等到某一天，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 366450,
      "end_ms": 367995,
      "text": "那些颜色彻底褪完了，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 368250,
      "end_ms": 369255,
      "text": "谁都看不到了。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 370080,
      "end_ms": 374285,
      "text": "第二名故宫北京故宫，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 375150,
      "end_ms": 376845,
      "text": "您可能觉得故宫谁没去过，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 377780,
      "end_ms": 378220,
      "text": "排什么，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 378220,
      "end_ms": 379920,
      "text": "一生必去故宫，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 379960,
      "end_ms": 381055,
      "text": "确实谁都去过。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 381900,
      "end_ms": 383820,
      "text": "可大部分人去故宫的方式，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 383820,
      "end_ms": 385060,
      "text": "是从午门进去，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 385480,
      "end_ms": 387315,
      "text": "沿着中轴线走，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 388170,
      "end_ms": 392885,
      "text": "太和殿看看乾清宫看看御花园看看，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 393860,
      "end_ms": 396015,
      "text": "然后从神武门出来，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 396600,
      "end_ms": 397560,
      "text": "一路走下来，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 397560,
      "end_ms": 398560,
      "text": "拍了一堆照片，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 398740,
      "end_ms": 400345,
      "text": "回去也说不清看了什么。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 400860,
      "end_ms": 403660,
      "text": "这种走法只走了故宫的十分之一。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 403760,
      "end_ms": 406595,
      "text": "故宫一共有九千多间房，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 407310,
      "end_ms": 410955,
      "text": "开放面积占总面积的百分之八十左右。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 411840,
      "end_ms": 415405,
      "text": "中轴线上的三大殿只是最显眼的部分。"
    },
    {
      "segment_id": "s000146",
      "start_ms": 416220,
      "end_ms": 418700,
      "text": "真正有意思的东西全在两边。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 418700,
      "end_ms": 425010,
      "text": "西六沽东六宫、慈宁宫花园、文华殿、武英殿、珍宝馆，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 425190,
      "end_ms": 425995,
      "text": "钟表馆。"
    },
    {
      "segment_id": "s000149",
      "start_ms": 426870,
      "end_ms": 430565,
      "text": "光是钟表馆里面的清代钟表就够看一个小时的，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 430830,
      "end_ms": 432905,
      "text": "有一座中高将近六米，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 433390,
      "end_ms": 435115,
      "text": "上面有一千多个零件，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 436020,
      "end_ms": 437265,
      "text": "到今天还能走。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 438220,
      "end_ms": 439700,
      "text": "故宫最好看的时候，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 439740,
      "end_ms": 441780,
      "text": "不是白天游客挤着的时候，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 441780,
      "end_ms": 442955,
      "text": "是下雪的时候，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 444270,
      "end_ms": 445225,
      "text": "北京一下雪。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 445610,
      "end_ms": 448295,
      "text": "故宫的红墙黄瓦上面盖一层白雪，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 449140,
      "end_ms": 449680,
      "text": "太和殿，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 449680,
      "end_ms": 451505,
      "text": "前面的广场白茫茫一片，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 452340,
      "end_ms": 453935,
      "text": "铜缸上面顶着血帽子，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 454760,
      "end_ms": 457090,
      "text": "角楼倒映在护城河里。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 457090,
      "end_ms": 458795,
      "text": "六百年的宫殿配上雪，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 459370,
      "end_ms": 461125,
      "text": "那个画面是老天爷给的，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 461370,
      "end_ms": 462455,
      "text": "谁也复制不了。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 463430,
      "end_ms": 465965,
      "text": "六百年的宫殿九千多间房，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 466680,
      "end_ms": 469720,
      "text": "您上次去走了几件第一名。"
    },
    {
      "segment_id": "s000167",
      "start_ms": 469720,
      "end_ms": 470495,
      "text": "先别急，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 471290,
      "end_ms": 475465,
      "text": "在接之前跟您聊几句评论区有不少朋友说，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 475880,
      "end_ms": 477240,
      "text": "这些地方一直想去，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 477240,
      "end_ms": 478760,
      "text": "可总也下不了决心，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 478840,
      "end_ms": 479965,
      "text": "要么觉得太远，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 480760,
      "end_ms": 481620,
      "text": "要么怕去了，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 481620,
      "end_ms": 482625,
      "text": "不知道看什么。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 483570,
      "end_ms": 487540,
      "text": "确实很多地方不是到了就能看明白的。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 487540,
      "end_ms": 489180,
      "text": "莫高窟的壁画不看背景，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 489180,
      "end_ms": 491420,
      "text": "根本看不懂布达拉宫的历史，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 491420,
      "end_ms": 491880,
      "text": "不了解，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 491880,
      "end_ms": 493385,
      "text": "就只能看个热闹。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 494340,
      "end_ms": 496000,
      "text": "故宫不提前做功课，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 496000,
      "end_ms": 498355,
      "text": "就只能在中轴线上挤着走。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 499300,
      "end_ms": 501480,
      "text": "后来有朋友给我推荐了一本书，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 501540,
      "end_ms": 502865,
      "text": "叫大美中国，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 503410,
      "end_ms": 509345,
      "text": "说是里面把这些地方的历史背景、文化细节和值得看的重点全整理好了，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 510160,
      "end_ms": 511180,
      "text": "还有实拍的图，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 511420,
      "end_ms": 512280,
      "text": "我翻了一下，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 512280,
      "end_ms": 513415,
      "text": "确实挺实在的，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 514150,
      "end_ms": 517255,
      "text": "不是网上那种东拼西凑的攻略，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 518090,
      "end_ms": 521005,
      "text": "是一个地方一个地方认真写的。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 521970,
      "end_ms": 523505,
      "text": "出发之前翻一遍，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 524490,
      "end_ms": 526325,
      "text": "到了那儿知道看什么，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 526700,
      "end_ms": 528285,
      "text": "看完了回来再翻一遍，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 528600,
      "end_ms": 530295,
      "text": "感受完全不一样。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 531170,
      "end_ms": 533890,
      "text": "想要的朋友点左下角头像进橱窗，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 534290,
      "end_ms": 538180,
      "text": "认准大美中国这本书去一趟莫高窟，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 538180,
      "end_ms": 539380,
      "text": "光门票加住宿，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 539380,
      "end_ms": 541830,
      "text": "就得好几百花几十块钱。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 541850,
      "end_ms": 542530,
      "text": "先搞明白，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 542530,
      "end_ms": 545825,
      "text": "看什么怎么都划算。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 547230,
      "end_ms": 549630,
      "text": "好书先说到这儿，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 549630,
      "end_ms": 555035,
      "text": "咱们收回来接最后一个第一名长城。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 556150,
      "end_ms": 557665,
      "text": "可能有人一听就笑了，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 559080,
      "end_ms": 560275,
      "text": "长城八达岭，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 561350,
      "end_ms": 563285,
      "text": "那不就是人挤人拍照吗？"
    },
    {
      "segment_id": "s000204",
      "start_ms": 564970,
      "end_ms": 566525,
      "text": "如果您去的是八达岭，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 566980,
      "end_ms": 568300,
      "text": "确实是八达岭，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 568300,
      "end_ms": 569145,
      "text": "是修缮过，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 569530,
      "end_ms": 570470,
      "text": "路面平整，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 570590,
      "end_ms": 571655,
      "text": "两边有栏杆，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 572060,
      "end_ms": 572880,
      "text": "游客多的时候，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 572880,
      "end_ms": 573985,
      "text": "台阶上全是人，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 574360,
      "end_ms": 575420,
      "text": "前面的人不走，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 575420,
      "end_ms": 576205,
      "text": "你也走不了。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 576540,
      "end_ms": 578405,
      "text": "那个地方看的是到此一游，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 578930,
      "end_ms": 580115,
      "text": "不是长城。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 581240,
      "end_ms": 590535,
      "text": "真正值得去的长城不在八达岭在建寇建寇长城在北京怀柔区没有修缮过，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 590910,
      "end_ms": 593355,
      "text": "保持着明朝修建时的原样。"
    },
    {
      "segment_id": "s000217",
      "start_ms": 594240,
      "end_ms": 597530,
      "text": "城砖上的建痕还在墙体，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 597550,
      "end_ms": 598995,
      "text": "有的地方塌了半边，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 599440,
      "end_ms": 602780,
      "text": "有的地方长满了荒草和灌木台阶，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 602880,
      "end_ms": 603785,
      "text": "高矮不一。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 604250,
      "end_ms": 609850,
      "text": "有几段抖到要手脚并用才能爬上去走在上面。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 609870,
      "end_ms": 611650,
      "text": "脚底下的城砖是松的，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 612029,
      "end_ms": 615050,
      "text": "踩上去咯吱咯吱响箭扣。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 615070,
      "end_ms": 619070,
      "text": "最出名的一段叫莺飞荡仰往墙，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 619210,
      "end_ms": 623430,
      "text": "沿着山脊走到一个接近垂直的悬崖边上，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 624130,
      "end_ms": 626910,
      "text": "城墙一路向下陡降。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 627090,
      "end_ms": 627650,
      "text": "往上看，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 627650,
      "end_ms": 629770,
      "text": "长城像一条灰色的龙脊，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 629790,
      "end_ms": 631390,
      "text": "顺着山势往天上爬。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 632050,
      "end_ms": 632770,
      "text": "往下看，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 632870,
      "end_ms": 634360,
      "text": "脚底下就是悬崖呀，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 634800,
      "end_ms": 636620,
      "text": "山谷里面什么声音都没有。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 636960,
      "end_ms": 640040,
      "text": "您站在箭扣长城上面往两边看，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 640520,
      "end_ms": 642660,
      "text": "没有游客没有小贩，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 642900,
      "end_ms": 643800,
      "text": "没有缆车，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 644180,
      "end_ms": 645000,
      "text": "什么都没有，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 645780,
      "end_ms": 649600,
      "text": "不是城墙山天六百多年前的砖，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 650040,
      "end_ms": 651520,
      "text": "六百多年前的城墙，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 651880,
      "end_ms": 653560,
      "text": "六百多年前的台阶，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 654180,
      "end_ms": 658100,
      "text": "连砖缝里长出来的草都像是长了很久了。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 659080,
      "end_ms": 660380,
      "text": "这才是长城，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 661580,
      "end_ms": 662540,
      "text": "不是景区。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 662540,
      "end_ms": 665510,
      "text": "那个长城是六百多年前修来打仗的。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 665510,
      "end_ms": 668500,
      "text": "那个长城站在上面的感觉，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 668500,
      "end_ms": 669895,
      "text": "不是我来旅游了，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 670310,
      "end_ms": 672325,
      "text": "是我站在六百年前了。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 672990,
      "end_ms": 675010,
      "text": "那种安静不是没有声音的，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 675010,
      "end_ms": 677535,
      "text": "安静是时间停了的安静，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 677990,
      "end_ms": 686325,
      "text": "全世界都知道长城的名字可真正踩过六百年前那些砖的人没几个先在评论区打出四个字，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 686730,
      "end_ms": 691845,
      "text": "一生必去打完回来听最后一段十个地方讲完。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 692810,
      "end_ms": 693995,
      "text": "您回头想想，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 695000,
      "end_ms": 696320,
      "text": "一个城市里的湖，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 696500,
      "end_ms": 698260,
      "text": "安安静静好看了。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 698260,
      "end_ms": 702180,
      "text": "九百多年一条江两岸几百座山被课本写成了，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 702180,
      "end_ms": 702680,
      "text": "一句话，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 702740,
      "end_ms": 703755,
      "text": "传了几十年。"
    },
    {
      "segment_id": "s000257",
      "start_ms": 704260,
      "end_ms": 707765,
      "text": "四百多年前的松树还从石头缝里伸着手，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 708670,
      "end_ms": 716680,
      "text": "十万平方公里的草原空到脑子里一个念头都存不住黄河收成几十米的口子砸下去，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 716720,
      "end_ms": 717885,
      "text": "脚底都在抖，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 718420,
      "end_ms": 722395,
      "text": "一个湖的水干净到能看见十二米深的湖底。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 723010,
      "end_ms": 727465,
      "text": "一座宫殿蹲在三千七百米的山上蹲了一千三百年。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 728260,
      "end_ms": 731935,
      "text": "一千七百年的壁画正在一天一天的消失。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 732620,
      "end_ms": 734360,
      "text": "六百年的宫殿下了雪，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 734360,
      "end_ms": 735940,
      "text": "谁也复制不了那个画面。"
    },
    {
      "segment_id": "s000265",
      "start_ms": 736020,
      "end_ms": 738080,
      "text": "六百年前修来打仗的城墙，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 738120,
      "end_ms": 739440,
      "text": "今天还站在山脊上，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 739440,
      "end_ms": 742915,
      "text": "没有人修他这十个地方加一块儿。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 743580,
      "end_ms": 745525,
      "text": "您说最值得去的是什么？"
    },
    {
      "segment_id": "s000269",
      "start_ms": 746360,
      "end_ms": 748915,
      "text": "我觉得不是哪个地方最好看、最有名，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 749490,
      "end_ms": 751785,
      "text": "而是这些地方都不等人。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 752140,
      "end_ms": 753360,
      "text": "壁画在褪色，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 753660,
      "end_ms": 756130,
      "text": "城砖在风化苏油灯，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 756210,
      "end_ms": 758560,
      "text": "不知道还能续几代云海，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 758560,
      "end_ms": 762000,
      "text": "不知道明天早上还有没有这些东西，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 762020,
      "end_ms": 762400,
      "text": "不会，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 762420,
      "end_ms": 764935,
      "text": "因为您还没去就停在那等着，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 765320,
      "end_ms": 766495,
      "text": "趁还走得动，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 767190,
      "end_ms": 769110,
      "text": "趁想去的时候腿脚还利索，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 769130,
      "end_ms": 770165,
      "text": "别光收藏了，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 771210,
      "end_ms": 776550,
      "text": "想出发之前先把这些地方看明白的那本大美中国的链接，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 776550,
      "end_ms": 777995,
      "text": "我放在左下角了，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 778740,
      "end_ms": 779720,
      "text": "觉得有意思的话，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 779720,
      "end_ms": 781000,
      "text": "帮忙点个赞同时，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 781000,
      "end_ms": 781620,
      "text": "转发给你，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 781620,
      "end_ms": 783635,
      "text": "想一起去看看风景的那个人。"
    },
    {
      "segment_id": "s000286",
      "start_ms": 784220,
      "end_ms": 785685,
      "text": "咱们下一期接着聊。"
    }
  ],
  "source_transcript_sha256": "880d0057819c07639f3f2f42ca3a64b76434fdb34a51fd7e5159d3b7f7993ee2"
}