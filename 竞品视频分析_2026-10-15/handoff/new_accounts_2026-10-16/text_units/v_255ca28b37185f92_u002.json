{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_255ca28b37185f92_u002",
  "video_id": "v_255ca28b37185f92",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 982.786009,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000371",
      "start_ms": 802520,
      "end_ms": 805960,
      "text": "创造出一部兼有致实锋芒与情感暗涌的准自传。"
    },
    {
      "segment_id": "s000372",
      "start_ms": 806140,
      "end_ms": 807820,
      "text": "他记录了他第一段失败的婚姻，"
    },
    {
      "segment_id": "s000373",
      "start_ms": 808060,
      "end_ms": 809320,
      "text": "但又不是简单的自传，"
    },
    {
      "segment_id": "s000374",
      "start_ms": 809640,
      "end_ms": 811040,
      "text": "他是一篇虚构的论文，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 811320,
      "end_ms": 813440,
      "text": "一次用文学碎片进行的自我解剖，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 813800,
      "end_ms": 816680,
      "text": "正是这部长诗为他赢得了TS艾略特诗歌奖。"
    },
    {
      "segment_id": "s000377",
      "start_ms": 816960,
      "end_ms": 822330,
      "text": "他成为该奖项设立以来第一位获此殊荣的女诗人丈夫之美的力量在于她的冷静。"
    },
    {
      "segment_id": "s000378",
      "start_ms": 822790,
      "end_ms": 823770,
      "text": "卡森没有控诉，"
    },
    {
      "segment_id": "s000379",
      "start_ms": 823890,
      "end_ms": 825190,
      "text": "也没有试图博取怜悯。"
    },
    {
      "segment_id": "s000380",
      "start_ms": 825590,
      "end_ms": 826690,
      "text": "她只是冷静的写，"
    },
    {
      "segment_id": "s000381",
      "start_ms": 826950,
      "end_ms": 829870,
      "text": "把一个人的婚姻经历变成整个亲密关系的景象。"
    },
    {
      "segment_id": "s000382",
      "start_ms": 830010,
      "end_ms": 832670,
      "text": "这本书最核心的主题是美与伤害的共谋。"
    },
    {
      "segment_id": "s000383",
      "start_ms": 833130,
      "end_ms": 834590,
      "text": "丈夫的美是真实的，"
    },
    {
      "segment_id": "s000384",
      "start_ms": 834830,
      "end_ms": 836210,
      "text": "伤害也是真实的。"
    },
    {
      "segment_id": "s000385",
      "start_ms": 836630,
      "end_ms": 837770,
      "text": "他们不是对立的，"
    },
    {
      "segment_id": "s000386",
      "start_ms": 837810,
      "end_ms": 839270,
      "text": "而是同一件事的两面，"
    },
    {
      "segment_id": "s000387",
      "start_ms": 839470,
      "end_ms": 841770,
      "text": "在一个将美视为最高价值的关系中，"
    },
    {
      "segment_id": "s000388",
      "start_ms": 842030,
      "end_ms": 843690,
      "text": "伤害成了美的代价。"
    },
    {
      "segment_id": "s000389",
      "start_ms": 844290,
      "end_ms": 845490,
      "text": "主人公不是不知道，"
    },
    {
      "segment_id": "s000390",
      "start_ms": 845610,
      "end_ms": 846590,
      "text": "他只是无法抵抗，"
    },
    {
      "segment_id": "s000391",
      "start_ms": 846590,
      "end_ms": 848055,
      "text": "而几十年后，"
    },
    {
      "segment_id": "s000392",
      "start_ms": 848380,
      "end_ms": 850020,
      "text": "卡森选择写下这段往事。"
    },
    {
      "segment_id": "s000393",
      "start_ms": 850280,
      "end_ms": 851435,
      "text": "他不是想被原谅，"
    },
    {
      "segment_id": "s000394",
      "start_ms": 851720,
      "end_ms": 853435,
      "text": "而是想让这种共谋被看见。"
    },
    {
      "segment_id": "s000395",
      "start_ms": 853890,
      "end_ms": 856925,
      "text": "他把个人的隐痛变成一份对美这一概念的证词，"
    },
    {
      "segment_id": "s000396",
      "start_ms": 857280,
      "end_ms": 859025,
      "text": "这也是丈夫之美的力量所在，"
    },
    {
      "segment_id": "s000397",
      "start_ms": 859350,
      "end_ms": 859990,
      "text": "告诉我们，"
    },
    {
      "segment_id": "s000398",
      "start_ms": 860130,
      "end_ms": 861430,
      "text": "真正能压垮人的，"
    },
    {
      "segment_id": "s000399",
      "start_ms": 861430,
      "end_ms": 862755,
      "text": "从来不是一次背叛，"
    },
    {
      "segment_id": "s000400",
      "start_ms": 863020,
      "end_ms": 864660,
      "text": "而是当你被美所迷惑时，"
    },
    {
      "segment_id": "s000401",
      "start_ms": 864900,
      "end_ms": 866260,
      "text": "世界的集体沉默。"
    },
    {
      "segment_id": "s000402",
      "start_ms": 866280,
      "end_ms": 867585,
      "text": "卡森笔下没有怒气，"
    },
    {
      "segment_id": "s000403",
      "start_ms": 867920,
      "end_ms": 868615,
      "text": "只有事实。"
    },
    {
      "segment_id": "s000404",
      "start_ms": 869140,
      "end_ms": 869980,
      "text": "丈夫的谎言，"
    },
    {
      "segment_id": "s000405",
      "start_ms": 870200,
      "end_ms": 871045,
      "text": "妻子的隐忍，"
    },
    {
      "segment_id": "s000406",
      "start_ms": 871340,
      "end_ms": 873955,
      "text": "那些被重新拼贴的文学碎片之间的裂隙，"
    },
    {
      "segment_id": "s000407",
      "start_ms": 874340,
      "end_ms": 875845,
      "text": "他不喊冤、不反抗，"
    },
    {
      "segment_id": "s000408",
      "start_ms": 876230,
      "end_ms": 877425,
      "text": "只让蚊子自己说话。"
    },
    {
      "segment_id": "s000409",
      "start_ms": 877790,
      "end_ms": 878910,
      "text": "越是平静的叙述，"
    },
    {
      "segment_id": "s000410",
      "start_ms": 878990,
      "end_ms": 880935,
      "text": "越显出那种孤立无援的重量。"
    },
    {
      "segment_id": "s000411",
      "start_ms": 881350,
      "end_ms": 883755,
      "text": "书中反复出现的贪戈意象成了象征。"
    },
    {
      "segment_id": "s000412",
      "start_ms": 884180,
      "end_ms": 885385,
      "text": "潘戈尔是两个人的舞蹈，"
    },
    {
      "segment_id": "s000413",
      "start_ms": 885620,
      "end_ms": 887860,
      "text": "却充满了权力控制与屈从，"
    },
    {
      "segment_id": "s000414",
      "start_ms": 887920,
      "end_ms": 889880,
      "text": "它代表被美所奴役的关系，"
    },
    {
      "segment_id": "s000415",
      "start_ms": 890160,
      "end_ms": 891655,
      "text": "代表无法逃离的节奏，"
    },
    {
      "segment_id": "s000416",
      "start_ms": 891950,
      "end_ms": 894290,
      "text": "也代表在伤害中依然前进的勇气。"
    },
    {
      "segment_id": "s000417",
      "start_ms": 894550,
      "end_ms": 895275,
      "text": "他跳着，"
    },
    {
      "segment_id": "s000418",
      "start_ms": 895520,
      "end_ms": 897595,
      "text": "但那舞蹈本身就是一种存在。"
    },
    {
      "segment_id": "s000419",
      "start_ms": 897970,
      "end_ms": 899715,
      "text": "卡森的写作风格也值得细品。"
    },
    {
      "segment_id": "s000420",
      "start_ms": 900020,
      "end_ms": 901240,
      "text": "他拒绝文学的装饰，"
    },
    {
      "segment_id": "s000421",
      "start_ms": 901400,
      "end_ms": 902385,
      "text": "拒绝感动人。"
    },
    {
      "segment_id": "s000422",
      "start_ms": 902730,
      "end_ms": 904725,
      "text": "他让蚊子干净的近乎冷酷。"
    },
    {
      "segment_id": "s000423",
      "start_ms": 905220,
      "end_ms": 906525,
      "text": "这种冷不是距离感，"
    },
    {
      "segment_id": "s000424",
      "start_ms": 906870,
      "end_ms": 907875,
      "text": "而是一种尊重，"
    },
    {
      "segment_id": "s000425",
      "start_ms": 908270,
      "end_ms": 909295,
      "text": "对事实的尊重。"
    },
    {
      "segment_id": "s000426",
      "start_ms": 909550,
      "end_ms": 910630,
      "text": "对读者的尊重，"
    },
    {
      "segment_id": "s000427",
      "start_ms": 911210,
      "end_ms": 912170,
      "text": "他不替你流泪，"
    },
    {
      "segment_id": "s000428",
      "start_ms": 912410,
      "end_ms": 913490,
      "text": "只逼你去思考。"
    },
    {
      "segment_id": "s000429",
      "start_ms": 913850,
      "end_ms": 914990,
      "text": "从更深的层面看，"
    },
    {
      "segment_id": "s000430",
      "start_ms": 915270,
      "end_ms": 917510,
      "text": "丈夫之美是关于自我夺回的书。"
    },
    {
      "segment_id": "s000431",
      "start_ms": 917830,
      "end_ms": 919470,
      "text": "年轻的她被美所定义，"
    },
    {
      "segment_id": "s000432",
      "start_ms": 919610,
      "end_ms": 920550,
      "text": "被欲望压制，"
    },
    {
      "segment_id": "s000433",
      "start_ms": 920630,
      "end_ms": 921570,
      "text": "被现实困住。"
    },
    {
      "segment_id": "s000434",
      "start_ms": 921930,
      "end_ms": 924990,
      "text": "而年长的她通过写作重新掌控了叙述权，"
    },
    {
      "segment_id": "s000435",
      "start_ms": 925150,
      "end_ms": 926710,
      "text": "他不再是贪戈中的被动者，"
    },
    {
      "segment_id": "s000436",
      "start_ms": 926830,
      "end_ms": 927970,
      "text": "而是成为编舞者，"
    },
    {
      "segment_id": "s000437",
      "start_ms": 928310,
      "end_ms": 929770,
      "text": "这是卡森最重要的转变。"
    },
    {
      "segment_id": "s000438",
      "start_ms": 930050,
      "end_ms": 932450,
      "text": "他用写作重新夺回了自己的名字。"
    },
    {
      "segment_id": "s000439",
      "start_ms": 932730,
      "end_ms": 934190,
      "text": "这本书没有温暖的结尾，"
    },
    {
      "segment_id": "s000440",
      "start_ms": 934310,
      "end_ms": 936230,
      "text": "却让人感到一种更深的平静。"
    },
    {
      "segment_id": "s000441",
      "start_ms": 936410,
      "end_ms": 937250,
      "text": "他不是和解，"
    },
    {
      "segment_id": "s000442",
      "start_ms": 937430,
      "end_ms": 938330,
      "text": "而是一种确认。"
    },
    {
      "segment_id": "s000443",
      "start_ms": 938650,
      "end_ms": 939285,
      "text": "有些事，"
    },
    {
      "segment_id": "s000444",
      "start_ms": 939560,
      "end_ms": 940340,
      "text": "不会被忘记，"
    },
    {
      "segment_id": "s000445",
      "start_ms": 940560,
      "end_ms": 941640,
      "text": "也不该被忘记。"
    },
    {
      "segment_id": "s000446",
      "start_ms": 942060,
      "end_ms": 943680,
      "text": "文学的意义或许就在于此，"
    },
    {
      "segment_id": "s000447",
      "start_ms": 944020,
      "end_ms": 945840,
      "text": "让那些被美所掩盖的伤害，"
    },
    {
      "segment_id": "s000448",
      "start_ms": 945940,
      "end_ms": 947960,
      "text": "重新呼吸红的自传。"
    },
    {
      "segment_id": "s000449",
      "start_ms": 947960,
      "end_ms": 949360,
      "text": "丈夫之美之所以动人，"
    },
    {
      "segment_id": "s000450",
      "start_ms": 949480,
      "end_ms": 951340,
      "text": "不是因为他讲了两个悲伤的故事，"
    },
    {
      "segment_id": "s000451",
      "start_ms": 951680,
      "end_ms": 954100,
      "text": "而是因为他让读者看到一种真实。"
    },
    {
      "segment_id": "s000452",
      "start_ms": 954520,
      "end_ms": 956240,
      "text": "每个时代都有人被迫沉默，"
    },
    {
      "segment_id": "s000453",
      "start_ms": 956500,
      "end_ms": 960500,
      "text": "而有人选择用古典学的精确和诗歌的锐利打破沉默。"
    },
    {
      "segment_id": "s000454",
      "start_ms": 961040,
      "end_ms": 964880,
      "text": "卡森从博士论文到诺讲用几十年的时间告诉我们，"
    },
    {
      "segment_id": "s000455",
      "start_ms": 964960,
      "end_ms": 966180,
      "text": "讲述不是软弱，"
    },
    {
      "segment_id": "s000456",
      "start_ms": 966360,
      "end_ms": 967320,
      "text": "而是一种抵抗。"
    },
    {
      "segment_id": "s000457",
      "start_ms": 967440,
      "end_ms": 970450,
      "text": "这两本书最终写给的不只是格律翁和那个妻子，"
    },
    {
      "segment_id": "s000458",
      "start_ms": 970590,
      "end_ms": 973710,
      "text": "也是所有被误解、被定义、被美所困的人。"
    },
    {
      "segment_id": "s000459",
      "start_ms": 973750,
      "end_ms": 974910,
      "text": "他用最冷静的语气，"
    },
    {
      "segment_id": "s000460",
      "start_ms": 974930,
      "end_ms": 976325,
      "text": "说出了最尖锐的真相，"
    },
    {
      "segment_id": "s000461",
      "start_ms": 976810,
      "end_ms": 978445,
      "text": "有些痛不需要哭出来，"
    },
    {
      "segment_id": "s000462",
      "start_ms": 978790,
      "end_ms": 979930,
      "text": "他们只需要被看见。"
    },
    {
      "segment_id": "s000463",
      "start_ms": 979950,
      "end_ms": 980650,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000464",
      "start_ms": 980770,
      "end_ms": 982050,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000465",
      "start_ms": 982050,
      "end_ms": 982645,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "f4dba9a9673fbb1ba71f90e6b65cb71582868e9ec050e5cec7e0c89c6125d0f3"
}