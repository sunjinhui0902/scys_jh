{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_5e4bd31ad730ff67_u001",
  "video_id": "v_5e4bd31ad730ff67",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 629.470952,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 330,
      "end_ms": 2490,
      "text": "十分钟讲解亚里士多德形而上学。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2690,
      "end_ms": 4770,
      "text": "今天我们要讲的是一本名字很硬，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4930,
      "end_ms": 6570,
      "text": "内容也硬的格牙的书，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6970,
      "end_ms": 8850,
      "text": "亚里士多德的形而上学。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 9090,
      "end_ms": 11430,
      "text": "那么什么是形而上学？"
    },
    {
      "segment_id": "s000006",
      "start_ms": 11670,
      "end_ms": 13370,
      "text": "你有没有觉得这个词很别扭，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 13470,
      "end_ms": 14990,
      "text": "扭像被人当面去理解它，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 14990,
      "end_ms": 15570,
      "text": "含含义。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 15570,
      "end_ms": 16250,
      "text": "但因因你，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 16250,
      "end_ms": 17730,
      "text": "你可能从开始就读错了，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 18090,
      "end_ms": 18990,
      "text": "很像正们熟悉，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 18990,
      "end_ms": 20990,
      "text": "是形而字学，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 21630,
      "end_ms": 24330,
      "text": "就和我们熟悉的物理学数学学一样，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 24350,
      "end_ms": 26390,
      "text": "专专门研究形而上的学问。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 26410,
      "end_ms": 28110,
      "text": "但看形而上学这四个字，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 28130,
      "end_ms": 29450,
      "text": "就像被人当面扔过来，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 29450,
      "end_ms": 30440,
      "text": "一句判觉，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 30700,
      "end_ms": 32500,
      "text": "去研究那些看不见、摸不着，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 32700,
      "end_ms": 33840,
      "text": "跟你今天吃什么，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 33840,
      "end_ms": 35620,
      "text": "明天干什么毫无关系的东西，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 36220,
      "end_ms": 37360,
      "text": "谁会干这种事儿。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 37620,
      "end_ms": 38960,
      "text": "一个不愁吃穿的贵族，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 39340,
      "end_ms": 41300,
      "text": "一个把求知当饭吃的怪人，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 41600,
      "end_ms": 43640,
      "text": "还是一个在别人眼里活得挺正常，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 43840,
      "end_ms": 45380,
      "text": "却总觉得世界底下藏着。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 45380,
      "end_ms": 46380,
      "text": "另一层东西的人，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 46640,
      "end_ms": 49620,
      "text": "亚里士多德把这个问题写成了一整套追问，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 49640,
      "end_ms": 51060,
      "text": "不是从几张照片开始，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 51180,
      "end_ms": 52480,
      "text": "而是从一句话开始，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 53040,
      "end_ms": 55000,
      "text": "求知是所有人的本性。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 55200,
      "end_ms": 56740,
      "text": "这句话听起来像在夸人，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 57020,
      "end_ms": 58660,
      "text": "其实是一句很重的判断。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 59140,
      "end_ms": 60735,
      "text": "他等于说你活着，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 61030,
      "end_ms": 62150,
      "text": "你就想知道点什么。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 62150,
      "end_ms": 63875,
      "text": "你不光想知道明天的天气，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 64140,
      "end_ms": 65785,
      "text": "你还想知道为什么会有明天，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 66100,
      "end_ms": 67800,
      "text": "为什么会有为什么这个东西。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 67880,
      "end_ms": 68800,
      "text": "亚里士多德说，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 69120,
      "end_ms": 70280,
      "text": "对感觉的喜爱，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 70280,
      "end_ms": 73170,
      "text": "就是证明人们甚至离开实用而喜爱。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 73170,
      "end_ms": 76470,
      "text": "感觉本身喜爱视觉尤胜于其他，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 76550,
      "end_ms": 78015,
      "text": "不仅是在实际活动中，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 78350,
      "end_ms": 80330,
      "text": "就在并不打算做什么的时候，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 80350,
      "end_ms": 83240,
      "text": "我们也更愿意观看这段话放到今天。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 83380,
      "end_ms": 85535,
      "text": "就像一个人刷手机刷到凌晨三点，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 85880,
      "end_ms": 87705,
      "text": "他并没有在找什么具体的东西，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 87960,
      "end_ms": 88915,
      "text": "他只是停不下来。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 89570,
      "end_ms": 90650,
      "text": "求知这件事儿，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 90650,
      "end_ms": 92865,
      "text": "有时候确实像一种停不下来的东西。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 93250,
      "end_ms": 95090,
      "text": "在翻开那十四卷的正文之前，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 95450,
      "end_ms": 96490,
      "text": "先说两句作者，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 96490,
      "end_ms": 97170,
      "text": "亚里士多德，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 97250,
      "end_ms": 99815,
      "text": "他是古希腊哲学里一个极特殊的存在。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 100190,
      "end_ms": 101495,
      "text": "出生在斯塔吉拉，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 101800,
      "end_ms": 104115,
      "text": "父亲是马其顿国王的宫廷医师，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 104570,
      "end_ms": 108325,
      "text": "十八岁到雅典进入柏拉图的学员一呆就是二十年。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 108670,
      "end_ms": 109190,
      "text": "按理说，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 109510,
      "end_ms": 112365,
      "text": "他应该走一条稳妥的柏拉图弟子路线，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 112740,
      "end_ms": 113855,
      "text": "继承老师的思想，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 114170,
      "end_ms": 114970,
      "text": "写写对话录，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 115170,
      "end_ms": 116690,
      "text": "做一个温和的追随者。"
    },
    {
      "segment_id": "s000062",
      "start_ms": 116750,
      "end_ms": 118710,
      "text": "可他的人生几乎从中间开始，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 118730,
      "end_ms": 119970,
      "text": "就在往反方向跑。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 120010,
      "end_ms": 120970,
      "text": "柏拉图逝世后，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 121110,
      "end_ms": 122225,
      "text": "他离开了学园，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 122560,
      "end_ms": 124425,
      "text": "后来甚至做了亚历山大的老师，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 124920,
      "end_ms": 127725,
      "text": "他回来之后创办了自己的学员叫吕克昂。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 128140,
      "end_ms": 130335,
      "text": "每天带着学生在廊下边走边讲，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 130850,
      "end_ms": 135195,
      "text": "他什么都写逻辑学、物理学、生物学、伦理学、政治学，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 135510,
      "end_ms": 137015,
      "text": "还有这本形而上学。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 137390,
      "end_ms": 138330,
      "text": "他留下的著作，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 138410,
      "end_ms": 141775,
      "text": "像是把一个人能想到的所有问题都摊在桌子上。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 142090,
      "end_ms": 143655,
      "text": "一个一个拆开来看，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 143940,
      "end_ms": 146275,
      "text": "他不像柏拉图那样写戏剧性的对话。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 146640,
      "end_ms": 149300,
      "text": "他的语气更干、更硬、更直接，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 149720,
      "end_ms": 152920,
      "text": "像是一个人在对着墙壁反复推敲自己的困惑。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 152940,
      "end_ms": 153755,
      "text": "读他的书，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 154090,
      "end_ms": 154530,
      "text": "像在看，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 154530,
      "end_ms": 157545,
      "text": "一个人把世界的骨架一根一根拆下来，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 157780,
      "end_ms": 158905,
      "text": "再试着装回去，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 159170,
      "end_ms": 160005,
      "text": "不是为了炫耀，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 160400,
      "end_ms": 164810,
      "text": "而是因为他实在忍不住想知道这些东西到底是怎么连在一起的。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 164890,
      "end_ms": 167870,
      "text": "形而上学不是一本从头到尾一气呵成的书，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 167970,
      "end_ms": 172575,
      "text": "它更像是亚里士多德在不同时期写下的十几组杂记的汇编。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 173130,
      "end_ms": 174890,
      "text": "古代编者把他们凑在一起，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 175050,
      "end_ms": 176130,
      "text": "凑出了十四卷。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 176190,
      "end_ms": 179955,
      "text": "第一卷回顾以前的哲学家关于世界本源问题的看法，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 180350,
      "end_ms": 183710,
      "text": "指出探究事物存在和发展原因的重要性。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 183770,
      "end_ms": 186635,
      "text": "第三卷提出了十四个有待解决的哲学难题，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 186950,
      "end_ms": 188010,
      "text": "被称为难题。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 188010,
      "end_ms": 189310,
      "text": "卷第七卷解释，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 189330,
      "end_ms": 190130,
      "text": "实体学说。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 190330,
      "end_ms": 195320,
      "text": "第八九卷讨论质量和形式、潜能和现实的范畴及其辩证关系。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 195460,
      "end_ms": 198785,
      "text": "第十二卷讲宇宙的总因提出了神学思想，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 199080,
      "end_ms": 201255,
      "text": "整本书没有一条从头顺到尾的线。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 201540,
      "end_ms": 204490,
      "text": "那你读下去会发现所有那些散开的追问，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 204610,
      "end_ms": 206305,
      "text": "最后都指向同一个问题，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 206890,
      "end_ms": 208330,
      "text": "存在之为存在，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 208610,
      "end_ms": 209470,
      "text": "到底是什么？"
    },
    {
      "segment_id": "s000100",
      "start_ms": 209470,
      "end_ms": 211085,
      "text": "回到亚里士多德自己的追问，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 211430,
      "end_ms": 213210,
      "text": "他一开始做的事儿是回头看，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 213350,
      "end_ms": 217430,
      "text": "他在第一卷里把从泰勒斯到柏拉图的前人全部过了一遍，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 217630,
      "end_ms": 218590,
      "text": "像一个后来者，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 218590,
      "end_ms": 221750,
      "text": "站在前人搭好的架子旁边一个一个检查，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 221750,
      "end_ms": 222925,
      "text": "那些架子牢不牢。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 223570,
      "end_ms": 224565,
      "text": "他发现一个问题，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 225170,
      "end_ms": 227190,
      "text": "以前的哲学家都在找本源，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 227610,
      "end_ms": 229265,
      "text": "找万物由什么构成？"
    },
    {
      "segment_id": "s000109",
      "start_ms": 229810,
      "end_ms": 231925,
      "text": "有人说水有人说气，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 232370,
      "end_ms": 233070,
      "text": "有人说火，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 233390,
      "end_ms": 234070,
      "text": "有人说树，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 234270,
      "end_ms": 234890,
      "text": "但亚里士多，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 234890,
      "end_ms": 235585,
      "text": "觉得这不够。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 235970,
      "end_ms": 237575,
      "text": "你说水是万物的本源，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 237950,
      "end_ms": 239650,
      "text": "那水为什么能变成桌子，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 239650,
      "end_ms": 240230,
      "text": "变成人，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 240310,
      "end_ms": 241525,
      "text": "变成天上的星星？"
    },
    {
      "segment_id": "s000118",
      "start_ms": 241910,
      "end_ms": 244255,
      "text": "光有一个东西解释不了变化。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 244660,
      "end_ms": 245060,
      "text": "于是，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 245180,
      "end_ms": 247425,
      "text": "他提出了一个更完整的答案框架。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 247830,
      "end_ms": 248745,
      "text": "四英说，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 249130,
      "end_ms": 252985,
      "text": "一个事物之所以成为他背后有四样东西在起作用。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 253520,
      "end_ms": 259130,
      "text": "治疗音是它由什么做成形式音是它是什么动力音，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 259330,
      "end_ms": 260575,
      "text": "是什么让它开始？"
    },
    {
      "segment_id": "s000125",
      "start_ms": 261090,
      "end_ms": 262870,
      "text": "目的因是他为了什么？"
    },
    {
      "segment_id": "s000126",
      "start_ms": 262890,
      "end_ms": 264165,
      "text": "拿一张桌子来说，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 264590,
      "end_ms": 265865,
      "text": "木头是治疗音，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 266280,
      "end_ms": 268905,
      "text": "桌子的形状和结构是形式音，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 269270,
      "end_ms": 270645,
      "text": "木匠是动力音，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 271020,
      "end_ms": 271860,
      "text": "用来放东西，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 272020,
      "end_ms": 274210,
      "text": "写字吃饭是目的音，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 274310,
      "end_ms": 275850,
      "text": "听起来简单的像废话。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 276070,
      "end_ms": 277865,
      "text": "但亚里士多德真正的意思是，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 278210,
      "end_ms": 280650,
      "text": "这四样东西里前两样是一对儿，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 280650,
      "end_ms": 281945,
      "text": "后两样是一对儿。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 282260,
      "end_ms": 285180,
      "text": "质量和形式的关系才是他要说的核心。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 285320,
      "end_ms": 287195,
      "text": "木头是潜在的桌子，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 287500,
      "end_ms": 288425,
      "text": "他还不是桌子，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 288700,
      "end_ms": 290460,
      "text": "但他有成为桌子的可能性。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 290540,
      "end_ms": 292600,
      "text": "当木匠把形式加在木头上，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 292920,
      "end_ms": 295180,
      "text": "木头就从潜能变成了现实。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 295540,
      "end_ms": 297200,
      "text": "种子是树的潜能，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 297600,
      "end_ms": 299120,
      "text": "树是种子的现实。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 299320,
      "end_ms": 303235,
      "text": "一块大理石在米开朗基罗动手之前只是石头。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 303690,
      "end_ms": 305450,
      "text": "大卫象已经在石头里了，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 305550,
      "end_ms": 306590,
      "text": "只是还没有出来。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 306630,
      "end_ms": 308870,
      "text": "这就是亚里士多德对变化的解释。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 309130,
      "end_ms": 310850,
      "text": "变化不是从无到有，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 311130,
      "end_ms": 312990,
      "text": "而是从潜能到现实，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 313190,
      "end_ms": 315630,
      "text": "一个东西成为他本该成为的样子。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 315850,
      "end_ms": 318450,
      "text": "这个过程它叫做引得来西，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 318910,
      "end_ms": 321730,
      "text": "也就是实现这个框架听起来很温和，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 321970,
      "end_ms": 322930,
      "text": "甚至有点乐观。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 323050,
      "end_ms": 326230,
      "text": "他好像在说万物都有一个内在的方向，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 326570,
      "end_ms": 327590,
      "text": "只要给他条件，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 327750,
      "end_ms": 329210,
      "text": "他就会朝着那个方向长。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 329350,
      "end_ms": 332150,
      "text": "但亚里士多德把这个框架推到极致的时候，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 332370,
      "end_ms": 333960,
      "text": "结论就变得很不安。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 333960,
      "end_ms": 336540,
      "text": "如果一切运动都是从潜能到现实，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 336800,
      "end_ms": 338460,
      "text": "那么运动的源头是什么？"
    },
    {
      "segment_id": "s000161",
      "start_ms": 338680,
      "end_ms": 340800,
      "text": "现实不可能来自于纯粹的潜能，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 341080,
      "end_ms": 342880,
      "text": "因为潜能本身不会自己动，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 343000,
      "end_ms": 344080,
      "text": "一定有一个东西，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 344180,
      "end_ms": 345880,
      "text": "它已经是纯粹的现实，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 346120,
      "end_ms": 348560,
      "text": "它不包含任何未实现的可能性。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 348900,
      "end_ms": 349460,
      "text": "他不动，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 349840,
      "end_ms": 351140,
      "text": "但它让别的东西动，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 351240,
      "end_ms": 353420,
      "text": "这就是第十二卷里那个著名的概念，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 353560,
      "end_ms": 354800,
      "text": "不动的推动者。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 355100,
      "end_ms": 357900,
      "text": "亚里士多德把这个不动的推动者称为神，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 358420,
      "end_ms": 361260,
      "text": "但他的神不是圣经里的那个创造者。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 361780,
      "end_ms": 363325,
      "text": "这个神不创造世界，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 363570,
      "end_ms": 364570,
      "text": "不关心世界，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 364650,
      "end_ms": 365570,
      "text": "不爱世界。"
    },
    {
      "segment_id": "s000175",
      "start_ms": 365570,
      "end_ms": 367250,
      "text": "他只是作为一个最终的目的，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 367250,
      "end_ms": 368870,
      "text": "因在吸引着一切，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 369190,
      "end_ms": 370610,
      "text": "像一个永远够不到，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 370690,
      "end_ms": 372630,
      "text": "但永远在牵引着你的东西，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 372770,
      "end_ms": 374350,
      "text": "万物都在朝着它运动，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 374630,
      "end_ms": 377165,
      "text": "像被爱着的对象吸引着爱者一样。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 377410,
      "end_ms": 378550,
      "text": "这个画面非常奇怪，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 378750,
      "end_ms": 379485,
      "text": "也非常冷。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 379840,
      "end_ms": 382805,
      "text": "一个完美的自足的不动的东西，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 383090,
      "end_ms": 385075,
      "text": "让整个宇宙在它周围旋转。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 385390,
      "end_ms": 387650,
      "text": "亚里士多德自己也知道这个说法有多极端，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 387910,
      "end_ms": 388695,
      "text": "但他认为，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 388980,
      "end_ms": 392620,
      "text": "如果一切都在运动而运动的链条不能无限倒退，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 392820,
      "end_ms": 394700,
      "text": "就必须有一个不动的起点。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 395040,
      "end_ms": 397039,
      "text": "这个起点不是时间上的第一秒，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 397320,
      "end_ms": 398880,
      "text": "而是逻辑上的第一个。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 398880,
      "end_ms": 399840,
      "text": "如果只看概念，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 399920,
      "end_ms": 402880,
      "text": "会觉得亚里士多德是一个冷静的系统建造者。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 402940,
      "end_ms": 404885,
      "text": "但如果你想一想他追问的方式，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 405150,
      "end_ms": 407855,
      "text": "你会发现它的底色是一种很深的惊奇。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 408400,
      "end_ms": 408740,
      "text": "他问，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 408740,
      "end_ms": 409725,
      "text": "存在是什么？"
    },
    {
      "segment_id": "s000197",
      "start_ms": 410030,
      "end_ms": 411475,
      "text": "不是因为他已经有了答案，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 411810,
      "end_ms": 414825,
      "text": "而是因为他真的不明白为什么会有东西存在，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 415080,
      "end_ms": 416345,
      "text": "而不是什么都没有。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 416850,
      "end_ms": 417570,
      "text": "他问一个东西，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 417570,
      "end_ms": 420195,
      "text": "为什么是他不是因为他觉得这理所当然，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 420510,
      "end_ms": 422490,
      "text": "而是因为他觉得这极其奇怪。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 422490,
      "end_ms": 424090,
      "text": "世界上有桌子、有树，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 424450,
      "end_ms": 425955,
      "text": "有人有星星，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 426470,
      "end_ms": 427910,
      "text": "这些东西凭什么存在？"
    },
    {
      "segment_id": "s000206",
      "start_ms": 428070,
      "end_ms": 429150,
      "text": "凭什么是这个样子，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 429150,
      "end_ms": 430145,
      "text": "而不是另一个样子？"
    },
    {
      "segment_id": "s000208",
      "start_ms": 430650,
      "end_ms": 434070,
      "text": "这些问题没有一个能靠日常经验回答日常经验，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 434070,
      "end_ms": 437760,
      "text": "只告诉你有不告诉你为什么有亚里士多德做的事儿，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 437760,
      "end_ms": 440205,
      "text": "就是在这个有的底下继续往下挖。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 440620,
      "end_ms": 442185,
      "text": "这种追问的代价是什么？"
    },
    {
      "segment_id": "s000212",
      "start_ms": 442570,
      "end_ms": 444915,
      "text": "是你一旦开始问存在是什么，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 445230,
      "end_ms": 447890,
      "text": "你就很难再回到只管过日子的状态。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 447930,
      "end_ms": 449710,
      "text": "你会在看到一张桌子的时候，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 449870,
      "end_ms": 451505,
      "text": "想到木头和形式，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 451890,
      "end_ms": 454695,
      "text": "看到一棵树的时候想到潜能和现实。"
    },
    {
      "segment_id": "s000217",
      "start_ms": 455050,
      "end_ms": 457685,
      "text": "看到一个人想到实体和属性，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 458100,
      "end_ms": 459285,
      "text": "世界的表面还在，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 459550,
      "end_ms": 460470,
      "text": "但底下多了一层。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 460470,
      "end_ms": 461565,
      "text": "你拆不掉的东西，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 462210,
      "end_ms": 464895,
      "text": "亚里士多德自己大概也感受到了这种负担。"
    },
    {
      "segment_id": "s000222",
      "start_ms": 465200,
      "end_ms": 467875,
      "text": "他在形而上学第三卷里列出十四个难题，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 468240,
      "end_ms": 469260,
      "text": "有些他回答了，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 469280,
      "end_ms": 470865,
      "text": "有些他自己也没完全解决。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 471650,
      "end_ms": 472550,
      "text": "整本书读下来，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 472550,
      "end_ms": 475155,
      "text": "你会觉得这个人不是在给你一个封闭的体系，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 475500,
      "end_ms": 477840,
      "text": "而是在给你一个开放的追问方式。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 477980,
      "end_ms": 479345,
      "text": "他教你的不是结论，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 479720,
      "end_ms": 484185,
      "text": "而是怎么在一件事上一直往下问问到不能再问为止。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 484520,
      "end_ms": 486540,
      "text": "为什么两千多年后还有人读这本书？"
    },
    {
      "segment_id": "s000231",
      "start_ms": 486680,
      "end_ms": 489340,
      "text": "因为我们大多数人不会像亚里士多德那样极端，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 489700,
      "end_ms": 491960,
      "text": "却都多少懂一点他的那种感觉。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 492080,
      "end_ms": 493560,
      "text": "你有时候会突然停下来，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 493580,
      "end_ms": 494760,
      "text": "看着手里的杯子，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 494840,
      "end_ms": 495865,
      "text": "或者窗外的树，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 496140,
      "end_ms": 497300,
      "text": "或者对面坐着的人，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 497560,
      "end_ms": 499565,
      "text": "心里冒出一个毫无用处的念头。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 500060,
      "end_ms": 501325,
      "text": "这个东西到底是什么？"
    },
    {
      "segment_id": "s000239",
      "start_ms": 501750,
      "end_ms": 502865,
      "text": "我到底是什么？"
    },
    {
      "segment_id": "s000240",
      "start_ms": 503100,
      "end_ms": 504800,
      "text": "这种感觉持续不了几秒钟，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 504980,
      "end_ms": 506645,
      "text": "你就被下一件事推走了。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 506940,
      "end_ms": 508160,
      "text": "但亚里士多德没有走，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 508420,
      "end_ms": 511995,
      "text": "他坐在那里把这个虽而上学里没有故事，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 512370,
      "end_ms": 513235,
      "text": "没有人物，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 513620,
      "end_ms": 514495,
      "text": "没有情节。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 515100,
      "end_ms": 518675,
      "text": "他有的只是一连串的追问和一个不肯停下来的人，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 519160,
      "end_ms": 520440,
      "text": "他不教你如何成功，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 520660,
      "end_ms": 521835,
      "text": "不教你怎么幸福，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 522150,
      "end_ms": 523555,
      "text": "甚至不教你怎么做人。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 524180,
      "end_ms": 529440,
      "text": "他做的事是另一件把最抽象、最不实用、最不体面的困惑，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 529700,
      "end_ms": 531215,
      "text": "赤裸裸的摊在桌子上，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 531540,
      "end_ms": 535205,
      "text": "让你看见一个人是如何在一件事上一点一点往下挖的。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 536060,
      "end_ms": 536995,
      "text": "而奇怪的是，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 537420,
      "end_ms": 538740,
      "text": "很多人在堵到这里时，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 539100,
      "end_ms": 541335,
      "text": "反而会生出一点微妙的安慰。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 541930,
      "end_ms": 546035,
      "text": "因为你发现原来不是只有你在某些时刻觉得这个世界不对劲，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 546470,
      "end_ms": 548675,
      "text": "觉得存在这件事儿本身就很奇怪，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 549170,
      "end_ms": 550345,
      "text": "有人比你更极端，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 550710,
      "end_ms": 551335,
      "text": "更固执，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 551750,
      "end_ms": 552755,
      "text": "更不放过自己。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 553920,
      "end_ms": 555515,
      "text": "但他把这些东西写出来了，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 556100,
      "end_ms": 559085,
      "text": "你在他的追问里反而看到了自己还在好奇，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 559390,
      "end_ms": 560165,
      "text": "还在发问，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 560460,
      "end_ms": 562945,
      "text": "还没有完全被日常吞掉的那一部分，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 563490,
      "end_ms": 565945,
      "text": "你不一定会走到追问存在这一步。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 566430,
      "end_ms": 568485,
      "text": "但你大概在某些时刻问过自己，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 568800,
      "end_ms": 570320,
      "text": "这一切到底是怎么回事？"
    },
    {
      "segment_id": "s000268",
      "start_ms": 570520,
      "end_ms": 572345,
      "text": "我到底知不知道我在说什么？"
    },
    {
      "segment_id": "s000269",
      "start_ms": 572840,
      "end_ms": 574805,
      "text": "形而上学不是来替你回答的，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 575090,
      "end_ms": 576775,
      "text": "也不是来教你怎么活的。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 577290,
      "end_ms": 579125,
      "text": "它更像一面很硬的镜子，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 579700,
      "end_ms": 582175,
      "text": "照出来的不是你最想给别人看的样子，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 582940,
      "end_ms": 587665,
      "text": "而是你有时候偷偷躲着不想面对的那一面困惑不安。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 588080,
      "end_ms": 589385,
      "text": "对为什么的执念？"
    },
    {
      "segment_id": "s000275",
      "start_ms": 589980,
      "end_ms": 593065,
      "text": "但看到他并不代表你就已经是个哲学家了，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 593590,
      "end_ms": 595390,
      "text": "反而说明你还有力气。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 595510,
      "end_ms": 597145,
      "text": "对世界诚实一小会儿，"
    },
    {
      "segment_id": "s000278",
      "start_ms": 597570,
      "end_ms": 601410,
      "text": "亚里士多德没有学会停止追问他在最极端的思辨里，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 601410,
      "end_ms": 603865,
      "text": "把这件事交代完就离开了这个世界。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 604190,
      "end_ms": 607760,
      "text": "而你还在这个世界上还在和日常的琐事，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 608040,
      "end_ms": 610505,
      "text": "别人的期待、生活的重担周旋。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 611020,
      "end_ms": 613915,
      "text": "也许这本书对我们最大的意义就在于让你知道，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 614360,
      "end_ms": 615595,
      "text": "哪怕你不那么实用，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 615950,
      "end_ms": 619495,
      "text": "你也仍然有资格在人间里一边做着手上该做的事，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 620060,
      "end_ms": 623425,
      "text": "一边在某个安静的瞬间继续试着问一句，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 624230,
      "end_ms": 625665,
      "text": "这到底是怎么回事？"
    },
    {
      "segment_id": "s000287",
      "start_ms": 626080,
      "end_ms": 626845,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 627170,
      "end_ms": 629325,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "41f895d8791320379520fe329d9040a56239aab232709920f294d49c3ab80eee"
}