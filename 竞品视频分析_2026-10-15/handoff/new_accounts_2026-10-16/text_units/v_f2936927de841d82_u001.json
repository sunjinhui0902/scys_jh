{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_f2936927de841d82_u001",
  "video_id": "v_f2936927de841d82",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 750.865011,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 290,
      "end_ms": 4350,
      "text": "十三分钟讲解米塞斯人的行为有一本书全球销量突破，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 4370,
      "end_ms": 6750,
      "text": "五十万册被译成十六种语言，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6950,
      "end_ms": 11950,
      "text": "被哈耶克罗斯巴德等整整三代奥地利学派学者奉为圣经作，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 11950,
      "end_ms": 15050,
      "text": "在主流经济学殿堂里被冷藏了半个多世纪。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 15350,
      "end_ms": 16610,
      "text": "不是因为它不够深刻，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 16930,
      "end_ms": 18230,
      "text": "而是因为它太危险，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 18850,
      "end_ms": 19550,
      "text": "危险到会，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 19550,
      "end_ms": 21690,
      "text": "让你过去二三十年信奉的那套。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 21710,
      "end_ms": 25590,
      "text": "关于政府市场和公平的认知发生八级地震，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 25770,
      "end_ms": 27510,
      "text": "这本书叫人的行为。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 28090,
      "end_ms": 28530,
      "text": "作者，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 28610,
      "end_ms": 34020,
      "text": "路德维希冯米塞斯一八八一年出生于奥匈帝国的莱姆堡，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 34300,
      "end_ms": 35640,
      "text": "经乌克兰利沃夫，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 35860,
      "end_ms": 39060,
      "text": "他在维也纳大学获得法学与经济学博士学位，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 39360,
      "end_ms": 42720,
      "text": "师承奥地利学派创始人卡尔门格尔的思想传统。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 42920,
      "end_ms": 43740,
      "text": "二十九岁时，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 43960,
      "end_ms": 46500,
      "text": "他已经是维也纳商会最年轻的经济学家，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 46600,
      "end_ms": 49020,
      "text": "后来创办了奥地利商业周期研究所，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 49360,
      "end_ms": 52320,
      "text": "并把所长之位交给了一个叫哈耶克的年轻人。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 52640,
      "end_ms": 54660,
      "text": "此人后来拿了诺贝尔经济学奖。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 54840,
      "end_ms": 55680,
      "text": "一九四零年，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 55940,
      "end_ms": 57900,
      "text": "米塞斯为躲避纳粹移居美国，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 58220,
      "end_ms": 60490,
      "text": "写了一本他认为这辈子最重要放的书。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 60730,
      "end_ms": 61665,
      "text": "一九四九年，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 61990,
      "end_ms": 66570,
      "text": "耶鲁大学出版社在多数学术委员反对的情况下出版了人的行为。"
    },
    {
      "segment_id": "s000026",
      "start_ms": 66650,
      "end_ms": 67510,
      "text": "反对的理由是，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 67870,
      "end_ms": 71235,
      "text": "米塞斯在美国找不到任何一所大学的正式教职。"
    },
    {
      "segment_id": "s000028",
      "start_ms": 71850,
      "end_ms": 72935,
      "text": "但出人意料的是，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 73280,
      "end_ms": 76520,
      "text": "这本不合时宜又昂贵的大部头热销一空。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 76820,
      "end_ms": 77520,
      "text": "五十年后，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 77740,
      "end_ms": 80825,
      "text": "学者版重新发行再度迅速售罄。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 81180,
      "end_ms": 84365,
      "text": "耶鲁出版社的宣传部门当年在内部备忘录里写道，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 84760,
      "end_ms": 87760,
      "text": "他们完全无法理解一本如此艰深的书，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 88000,
      "end_ms": 89175,
      "text": "怎么能卖的这么快。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 89650,
      "end_ms": 90325,
      "text": "离谱的是，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 90700,
      "end_ms": 95195,
      "text": "这本奠定奥地利学派理论基石的巨著遭遇的远不止冷遇，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 95610,
      "end_ms": 97110,
      "text": "被指过时、被劈，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 97110,
      "end_ms": 98145,
      "text": "意识形态偏执，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 98450,
      "end_ms": 100155,
      "text": "被主流学界集体沉默。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 100740,
      "end_ms": 101700,
      "text": "人们宁可相信，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 101780,
      "end_ms": 104055,
      "text": "这是一本不合时宜的又一读物，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 104360,
      "end_ms": 106215,
      "text": "也不愿面对一个可怕的真相。"
    },
    {
      "segment_id": "s000043",
      "start_ms": 106670,
      "end_ms": 109250,
      "text": "你在这个世界上看不懂政策看不透，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 109250,
      "end_ms": 110540,
      "text": "周期看不清，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 110540,
      "end_ms": 113405,
      "text": "繁荣背后的代价不是输在信息差，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 113840,
      "end_ms": 115820,
      "text": "是你对经济这两个字的认知。"
    },
    {
      "segment_id": "s000047",
      "start_ms": 116040,
      "end_ms": 118950,
      "text": "从根儿上就反了今天这篇文字，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 119070,
      "end_ms": 122245,
      "text": "我会拆出这本书里最颠覆的五个底层认知。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 122720,
      "end_ms": 123480,
      "text": "但我提前警告，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 123480,
      "end_ms": 124685,
      "text": "你看完后，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 124960,
      "end_ms": 129015,
      "text": "你可能会推翻过去二十年、三十年奉为归孽的经济信条。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 129570,
      "end_ms": 130875,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 131280,
      "end_ms": 132485,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 132970,
      "end_ms": 134095,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000055",
      "start_ms": 134370,
      "end_ms": 135605,
      "text": "那我们开始进入正题，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 135870,
      "end_ms": 136705,
      "text": "第一层颠覆。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 137290,
      "end_ms": 138625,
      "text": "你以为你在思考，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 139010,
      "end_ms": 140410,
      "text": "其实你每天都在做一件，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 140410,
      "end_ms": 142205,
      "text": "你自己都没意识到的事儿。"
    },
    {
      "segment_id": "s000060",
      "start_ms": 142470,
      "end_ms": 143510,
      "text": "你有没有听过这句话，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 143770,
      "end_ms": 145550,
      "text": "人是理性的这句话，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 145550,
      "end_ms": 147310,
      "text": "被经济学教授讲了两百年，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 147510,
      "end_ms": 149625,
      "text": "被商学院写进了每一本教材。"
    },
    {
      "segment_id": "s000064",
      "start_ms": 150080,
      "end_ms": 152965,
      "text": "但米塞斯问了一个让所有人哑口无言的问题。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 153360,
      "end_ms": 155585,
      "text": "你早上起来先刷牙还是先洗脸，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 155890,
      "end_ms": 157170,
      "text": "你出门左转还是右转，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 157350,
      "end_ms": 159285,
      "text": "你拿起手机打开微信还是抖音，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 159560,
      "end_ms": 161415,
      "text": "你凭什么说这些是理性的？"
    },
    {
      "segment_id": "s000069",
      "start_ms": 161590,
      "end_ms": 162345,
      "text": "米塞斯说，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 162790,
      "end_ms": 165810,
      "text": "这些跟理性不理性无关人做的每一件事儿，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 165810,
      "end_ms": 167190,
      "text": "本质上都是一次行动。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 167330,
      "end_ms": 174525,
      "text": "而行动的定义是为了从一种不太满意的状态换到一种比较满意的状态而有意采取的行为。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 174920,
      "end_ms": 176125,
      "text": "这听上去像废话，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 176430,
      "end_ms": 177915,
      "text": "但请你停下来想三秒。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 178290,
      "end_ms": 180875,
      "text": "你上一次无意识的刷了两个小时手机，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 181230,
      "end_ms": 182785,
      "text": "你在追求什么满意状态？"
    },
    {
      "segment_id": "s000077",
      "start_ms": 183260,
      "end_ms": 185420,
      "text": "米赛斯用一部八百多页的巨著，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 185420,
      "end_ms": 186025,
      "text": "告诉你，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 186540,
      "end_ms": 189615,
      "text": "人不是在理性和非理性之间做选择。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 190160,
      "end_ms": 192785,
      "text": "人是在用行动本身来定义自己。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 193110,
      "end_ms": 195345,
      "text": "你选择躺着不动是一种行动。"
    },
    {
      "segment_id": "s000082",
      "start_ms": 195760,
      "end_ms": 198640,
      "text": "你选择焦虑的翻来覆去也是一种行动。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 198680,
      "end_ms": 200540,
      "text": "你不是先想好了才去行动，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 200840,
      "end_ms": 202920,
      "text": "你的行动本身就在告诉世界，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 203040,
      "end_ms": 204565,
      "text": "你真正想要的是什么？"
    },
    {
      "segment_id": "s000086",
      "start_ms": 204890,
      "end_ms": 207085,
      "text": "米塞斯把这套逻辑推到了极致。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 207540,
      "end_ms": 210395,
      "text": "他说人的行动有一个鲜艳的公理，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 210820,
      "end_ms": 212715,
      "text": "人是有目的的行动的。"
    },
    {
      "segment_id": "s000089",
      "start_ms": 213070,
      "end_ms": 214435,
      "text": "这个公理不需要证明。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 214820,
      "end_ms": 216680,
      "text": "因为连你试图反驳他的时候，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 216820,
      "end_ms": 218275,
      "text": "你已经在行动了，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 218690,
      "end_ms": 220090,
      "text": "你再选择去反驳，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 220390,
      "end_ms": 222565,
      "text": "这本身就是一次有目的的行动。"
    },
    {
      "segment_id": "s000094",
      "start_ms": 223400,
      "end_ms": 225380,
      "text": "你不能一边说人没有目的，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 225500,
      "end_ms": 228005,
      "text": "一边认真的写一篇论文来证明这件事。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 228410,
      "end_ms": 230125,
      "text": "你的行为已经出卖了你，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 230820,
      "end_ms": 233415,
      "text": "这就是米塞斯最惊世骇俗的起点。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 234050,
      "end_ms": 241365,
      "text": "经济学不是从理性人假设出发的数学游戏是一门关于真实的人如何行动的演绎科学。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 241840,
      "end_ms": 244215,
      "text": "你不需要问人应该怎么行动，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 244590,
      "end_ms": 246835,
      "text": "你只需要观察他是怎么行动的，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 247190,
      "end_ms": 250690,
      "text": "然后追问他为什么总是行动的结果和意图。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 250690,
      "end_ms": 251175,
      "text": "相反，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 251660,
      "end_ms": 253640,
      "text": "第二层颠覆你不是消费者，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 253800,
      "end_ms": 254575,
      "text": "你是老板，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 254890,
      "end_ms": 255855,
      "text": "但你自己不知道。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 256330,
      "end_ms": 259190,
      "text": "我们这代人从小被灌输资本家剥削工人，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 259290,
      "end_ms": 260790,
      "text": "所以当老板克扣你工资。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 260970,
      "end_ms": 264055,
      "text": "你说资本家的本性当物价上涨了，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 264320,
      "end_ms": 266035,
      "text": "你说商家在割韭菜，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 266410,
      "end_ms": 267390,
      "text": "当大公司裁员。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 267650,
      "end_ms": 269870,
      "text": "你说资本主义的残酷人的行为，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 269870,
      "end_ms": 272635,
      "text": "用一个概念砸碎了这套受害者叙事。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 272990,
      "end_ms": 273590,
      "text": "米塞斯说，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 274010,
      "end_ms": 274810,
      "text": "在市场里，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 274950,
      "end_ms": 276655,
      "text": "真正的老板不是资本家，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 276920,
      "end_ms": 278980,
      "text": "是消费者什么意思？"
    },
    {
      "segment_id": "s000117",
      "start_ms": 279040,
      "end_ms": 280320,
      "text": "米塞斯在书里写了一段，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 280320,
      "end_ms": 281715,
      "text": "我读的时候愣了一下的话，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 282580,
      "end_ms": 283145,
      "text": "他说，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 283730,
      "end_ms": 287220,
      "text": "资本家、企业家和农场主都不能决定，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 287220,
      "end_ms": 288415,
      "text": "必须生产什么，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 288770,
      "end_ms": 290245,
      "text": "这是由消费者决定的。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 290770,
      "end_ms": 293230,
      "text": "生产者从事生产不是为了自己消费，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 293410,
      "end_ms": 294310,
      "text": "而是为了市场。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 294450,
      "end_ms": 297270,
      "text": "消费者最终决定的不仅仅是消费品的价格，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 297510,
      "end_ms": 299635,
      "text": "而是所有生产要素的价格。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 299930,
      "end_ms": 302590,
      "text": "他们还决定市场经济中每一个成员的收入，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 303510,
      "end_ms": 304850,
      "text": "这就是消费者主权，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 305470,
      "end_ms": 307075,
      "text": "你不是被剥削的对象。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 307670,
      "end_ms": 309910,
      "text": "你是那个真正发号施令的人，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 310550,
      "end_ms": 312790,
      "text": "每一分钱都是一张选票，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 313270,
      "end_ms": 314350,
      "text": "这听起来像鸡汤。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 314750,
      "end_ms": 317270,
      "text": "但米赛斯说这句话时的语气是冰冷的，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 317590,
      "end_ms": 318530,
      "text": "他继续推演，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 318990,
      "end_ms": 320990,
      "text": "如果一家企业生产的东西没人买，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 321410,
      "end_ms": 322130,
      "text": "他会倒闭。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 322850,
      "end_ms": 324930,
      "text": "如果一家企业给工人的工资太高，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 325030,
      "end_ms": 326190,
      "text": "导致产品太贵，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 326550,
      "end_ms": 329130,
      "text": "消费者会转身去买更便宜的替代品。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 329630,
      "end_ms": 331570,
      "text": "资本家不是想给你低工资，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 331930,
      "end_ms": 333910,
      "text": "是他被迫要给你低工资，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 334510,
      "end_ms": 338720,
      "text": "因为消费者不打算满足任何人的骄傲、自得和自我陶醉，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 339120,
      "end_ms": 341600,
      "text": "他们需要的是最便宜的服务。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 341700,
      "end_ms": 344400,
      "text": "米赛斯用一句话把这事儿说透了，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 344400,
      "end_ms": 346580,
      "text": "消费者才是真正的独裁者，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 346580,
      "end_ms": 349180,
      "text": "而资本家只是消费者意志的执行者。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 349180,
      "end_ms": 350660,
      "text": "你以为你在被剥削？"
    },
    {
      "segment_id": "s000148",
      "start_ms": 350660,
      "end_ms": 352500,
      "text": "其实你每天都在用你的购买行为，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 352500,
      "end_ms": 354440,
      "text": "投票决定谁该被淘汰，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 354680,
      "end_ms": 355640,
      "text": "谁该活下去？"
    },
    {
      "segment_id": "s000151",
      "start_ms": 355780,
      "end_ms": 357360,
      "text": "你以为资本家想压榨你？"
    },
    {
      "segment_id": "s000152",
      "start_ms": 357580,
      "end_ms": 360160,
      "text": "但如果消费者愿意为更贵的产品买单，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 360380,
      "end_ms": 362380,
      "text": "资本家比谁都乐意给你涨工资。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 362600,
      "end_ms": 363980,
      "text": "这句话可能会刺痛你，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 364200,
      "end_ms": 365420,
      "text": "你抱怨自己收入低，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 365660,
      "end_ms": 366700,
      "text": "不是资本家的错，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 366920,
      "end_ms": 369445,
      "text": "是消费者对你的服务的评价不够高。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 369870,
      "end_ms": 370865,
      "text": "但米塞斯说，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 371200,
      "end_ms": 372035,
      "text": "这不是冷酷，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 372310,
      "end_ms": 373095,
      "text": "这是自由。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 373680,
      "end_ms": 375705,
      "text": "在一个没有消费者主权的世界里，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 375950,
      "end_ms": 378205,
      "text": "决定你收入的人不是匿名的市场，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 378540,
      "end_ms": 380040,
      "text": "而是一个有名字的官员。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 380120,
      "end_ms": 382330,
      "text": "第三层颠覆没有价格，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 382630,
      "end_ms": 383750,
      "text": "人就是瞎子。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 383790,
      "end_ms": 386410,
      "text": "主流思维教你国家应该调控经济，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 386470,
      "end_ms": 387575,
      "text": "防止市场失灵。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 388120,
      "end_ms": 388900,
      "text": "金融VC来了，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 388900,
      "end_ms": 389480,
      "text": "要救市，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 389640,
      "end_ms": 390835,
      "text": "物价涨了要限价，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 391030,
      "end_ms": 392215,
      "text": "失业高了要刺激。"
    },
    {
      "segment_id": "s000172",
      "start_ms": 392480,
      "end_ms": 393855,
      "text": "这套模式的潜台词是，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 394250,
      "end_ms": 395490,
      "text": "市场是一台机器，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 395670,
      "end_ms": 396390,
      "text": "出了问题，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 396410,
      "end_ms": 397670,
      "text": "需要工程师来修理。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 397910,
      "end_ms": 398985,
      "text": "但米塞斯说，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 399360,
      "end_ms": 400165,
      "text": "这是错的，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 400590,
      "end_ms": 406305,
      "text": "没有市场价格人根本不知道自己在做什么什么叫不知道自己在做什么。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 406720,
      "end_ms": 407635,
      "text": "书里有一个论证，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 407890,
      "end_ms": 409170,
      "text": "我读的时候背脊发凉。"
    },
    {
      "segment_id": "s000181",
      "start_ms": 409310,
      "end_ms": 410010,
      "text": "米塞斯说，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 410350,
      "end_ms": 411670,
      "text": "假设没有私有产权，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 411790,
      "end_ms": 412845,
      "text": "没有市场价格，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 413170,
      "end_ms": 417105,
      "text": "一个中央计划者要决定用这块地种小麦还是建工厂，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 417460,
      "end_ms": 419700,
      "text": "用这批钢造汽车还是造自行车，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 419840,
      "end_ms": 420600,
      "text": "谁来种地，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 420680,
      "end_ms": 421360,
      "text": "谁来造车？"
    },
    {
      "segment_id": "s000188",
      "start_ms": 421560,
      "end_ms": 424095,
      "text": "进化者可以算出一吨钢需要多少工时，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 424480,
      "end_ms": 425700,
      "text": "但他永远算不出来。"
    },
    {
      "segment_id": "s000190",
      "start_ms": 425780,
      "end_ms": 426120,
      "text": "同样，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 426120,
      "end_ms": 427540,
      "text": "这批钢用来造汽车，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 427860,
      "end_ms": 429135,
      "text": "消费者愿意付多少钱？"
    },
    {
      "segment_id": "s000193",
      "start_ms": 429720,
      "end_ms": 430620,
      "text": "用来造自行车，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 430880,
      "end_ms": 432345,
      "text": "消费者又愿意付多少钱？"
    },
    {
      "segment_id": "s000195",
      "start_ms": 433090,
      "end_ms": 434875,
      "text": "这就是经济计算问题。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 435620,
      "end_ms": 436835,
      "text": "价格不是标签，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 437220,
      "end_ms": 438215,
      "text": "价格是信号。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 438830,
      "end_ms": 439595,
      "text": "他告诉你，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 439870,
      "end_ms": 441210,
      "text": "这个资源放在这里用，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 441230,
      "end_ms": 442755,
      "text": "比放在那里用更值。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 443160,
      "end_ms": 444015,
      "text": "没有价格。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 444360,
      "end_ms": 445795,
      "text": "你就像在黑暗中开车，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 446250,
      "end_ms": 448415,
      "text": "不知道前方是悬崖还是坦途。"
    },
    {
      "segment_id": "s000204",
      "start_ms": 448640,
      "end_ms": 449905,
      "text": "米塞斯说的很直接，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 450360,
      "end_ms": 453360,
      "text": "中央计划体制下不可能实行经济计算，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 453440,
      "end_ms": 455320,
      "text": "不是因为计划经济没有效率，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 455500,
      "end_ms": 458324,
      "text": "是因为它连效率本身都不知道该怎么定义。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 458800,
      "end_ms": 461795,
      "text": "这套逻辑彻底翻转了你对市场失灵的理解，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 462350,
      "end_ms": 463465,
      "text": "市场不会失灵，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 463920,
      "end_ms": 465820,
      "text": "市场在告诉你哪里出了问题。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 465980,
      "end_ms": 466845,
      "text": "价格涨了，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 467140,
      "end_ms": 468225,
      "text": "不是市场坏了，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 468560,
      "end_ms": 471925,
      "text": "是市场在说这个东西现在比过去更稀缺了，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 472210,
      "end_ms": 473270,
      "text": "你该少用一点，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 473330,
      "end_ms": 474870,
      "text": "你强行把价格压下去。"
    },
    {
      "segment_id": "s000216",
      "start_ms": 475090,
      "end_ms": 476290,
      "text": "你以为你在帮忙，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 476490,
      "end_ms": 477970,
      "text": "其实你在关掉信号灯，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 478110,
      "end_ms": 479985,
      "text": "让所有人继续往悬崖开。"
    },
    {
      "segment_id": "s000219",
      "start_ms": 480450,
      "end_ms": 481345,
      "text": "米塞斯说，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 481790,
      "end_ms": 484090,
      "text": "经济学不是告诉你应该怎么做的。"
    },
    {
      "segment_id": "s000221",
      "start_ms": 484090,
      "end_ms": 485820,
      "text": "说明书是告诉你，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 485940,
      "end_ms": 488620,
      "text": "如果你这么做会发生什么的地图，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 488760,
      "end_ms": 490580,
      "text": "地图不会阻止你往悬崖走。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 490820,
      "end_ms": 491820,
      "text": "他只会告诉你，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 492040,
      "end_ms": 493015,
      "text": "往东是山，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 493370,
      "end_ms": 494130,
      "text": "往西是河，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 494610,
      "end_ms": 495710,
      "text": "至于你选哪条路，"
    },
    {
      "segment_id": "s000228",
      "start_ms": 495930,
      "end_ms": 496765,
      "text": "那是你的事儿。"
    },
    {
      "segment_id": "s000229",
      "start_ms": 497190,
      "end_ms": 500455,
      "text": "第四层颠覆干预不是解决方案，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 500750,
      "end_ms": 501705,
      "text": "是问题的开始。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 502230,
      "end_ms": 502790,
      "text": "读到这里，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 502790,
      "end_ms": 503495,
      "text": "你可能想问，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 504010,
      "end_ms": 506155,
      "text": "政府管一管总比不管好吧，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 506870,
      "end_ms": 511705,
      "text": "涨房租限价、加息控通胀、发补贴、促消费难道不行吗？"
    },
    {
      "segment_id": "s000235",
      "start_ms": 512260,
      "end_ms": 512760,
      "text": "如果你这样，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 512760,
      "end_ms": 514530,
      "text": "想你就错过了这本书，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 514530,
      "end_ms": 516015,
      "text": "埋了七十年的陷阱。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 516550,
      "end_ms": 518270,
      "text": "米塞斯用一个论证证明的，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 518350,
      "end_ms": 519110,
      "text": "不是干预，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 519130,
      "end_ms": 520045,
      "text": "有时会失败，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 520470,
      "end_ms": 521470,
      "text": "而是干预主义，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 521470,
      "end_ms": 523495,
      "text": "在逻辑上就是自我矛盾的。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 523900,
      "end_ms": 525975,
      "text": "他称之为干预主义的悖论。"
    },
    {
      "segment_id": "s000244",
      "start_ms": 526460,
      "end_ms": 528685,
      "text": "通过干预市场以达到某个目的，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 528980,
      "end_ms": 531440,
      "text": "但干预的结果恰恰与目的相反，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 531520,
      "end_ms": 533200,
      "text": "于是国家被迫进一步干预，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 533360,
      "end_ms": 534395,
      "text": "然后再次失败。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 534660,
      "end_ms": 535305,
      "text": "再干预，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 535590,
      "end_ms": 537635,
      "text": "直到经济变成中央计划体制，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 538570,
      "end_ms": 540635,
      "text": "书里有一个让人不寒而栗的案例。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 541290,
      "end_ms": 541810,
      "text": "有人说，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 542170,
      "end_ms": 543275,
      "text": "我们要保护穷人。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 543570,
      "end_ms": 545895,
      "text": "所以现房租米塞斯说好，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 546230,
      "end_ms": 547125,
      "text": "那会发生什么？"
    },
    {
      "segment_id": "s000255",
      "start_ms": 547840,
      "end_ms": 548955,
      "text": "房租被压低了，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 549210,
      "end_ms": 550445,
      "text": "房东不愿意修房子了，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 550660,
      "end_ms": 552135,
      "text": "因为修了也收不回成本，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 552710,
      "end_ms": 554215,
      "text": "新建的租赁房更少了，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 554520,
      "end_ms": 555640,
      "text": "因为见了赚不到钱，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 555780,
      "end_ms": 557400,
      "text": "于是住房供给减少，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 557540,
      "end_ms": 558295,
      "text": "需求不变，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 558520,
      "end_ms": 560580,
      "text": "最终穷人租不到房了，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 560580,
      "end_ms": 561465,
      "text": "看到这个结果，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 561740,
      "end_ms": 564260,
      "text": "只能被迫实行租金管制、排队分配，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 564440,
      "end_ms": 565615,
      "text": "甚至直接盖房，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 565990,
      "end_ms": 567975,
      "text": "一步一步市场被取代了。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 568230,
      "end_ms": 568950,
      "text": "这就是米赛斯。"
    },
    {
      "segment_id": "s000268",
      "start_ms": 568950,
      "end_ms": 570470,
      "text": "想告诉你的干预，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 570550,
      "end_ms": 571890,
      "text": "不是解决问题的工具，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 572130,
      "end_ms": 573670,
      "text": "是通往奴役的阶梯。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 573810,
      "end_ms": 575175,
      "text": "你以为你在修一条路，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 575540,
      "end_ms": 576940,
      "text": "其实你在拆一座桥，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 577240,
      "end_ms": 579370,
      "text": "你享受的每一分保护背后，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 579370,
      "end_ms": 581435,
      "text": "都有人在承担你看不见的代价。"
    },
    {
      "segment_id": "s000275",
      "start_ms": 581950,
      "end_ms": 583390,
      "text": "二零零八年金融危机后，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 583530,
      "end_ms": 586105,
      "text": "主流媒体把危机归咎于市场失灵。"
    },
    {
      "segment_id": "s000277",
      "start_ms": 586600,
      "end_ms": 590920,
      "text": "但米塞斯的追随者翻出了他早在一九一二年就写下的商业周期。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 590920,
      "end_ms": 593000,
      "text": "理论危机的根源不是市场，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 593200,
      "end_ms": 594260,
      "text": "是信贷扩张。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 594340,
      "end_ms": 597175,
      "text": "当中央银行把利率压低到市场水平以下，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 597550,
      "end_ms": 598545,
      "text": "企业家被误导，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 598860,
      "end_ms": 601745,
      "text": "以为有足够多的储蓄来支持长期投资。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 602080,
      "end_ms": 602380,
      "text": "于是，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 602380,
      "end_ms": 604455,
      "text": "大量资源被投入错误的地方，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 604840,
      "end_ms": 606340,
      "text": "让利率最终不得不回升，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 606680,
      "end_ms": 607545,
      "text": "泡沫破裂，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 607830,
      "end_ms": 608475,
      "text": "危机爆发。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 608670,
      "end_ms": 610250,
      "text": "不是市场制造了危机，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 610450,
      "end_ms": 612830,
      "text": "是政府干预扭曲了市场的信号，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 613110,
      "end_ms": 615650,
      "text": "然后市场被迫承受纠正的代价。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 616030,
      "end_ms": 617030,
      "text": "第五层反转。"
    },
    {
      "segment_id": "s000292",
      "start_ms": 617510,
      "end_ms": 619170,
      "text": "你以为你在选择治理者，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 619430,
      "end_ms": 621150,
      "text": "其实是治理者在选择。"
    },
    {
      "segment_id": "s000294",
      "start_ms": 621150,
      "end_ms": 622290,
      "text": "你读到这里，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 622290,
      "end_ms": 623010,
      "text": "你可能想问，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 623210,
      "end_ms": 623930,
      "text": "说了这么多，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 624110,
      "end_ms": 625750,
      "text": "这位学者到底想告诉我们什么？"
    },
    {
      "segment_id": "s000298",
      "start_ms": 626470,
      "end_ms": 629470,
      "text": "如果你以为这部著作是一本否定治理机构的书，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 629630,
      "end_ms": 631310,
      "text": "你就错过了他最深的一层。"
    },
    {
      "segment_id": "s000300",
      "start_ms": 631690,
      "end_ms": 633550,
      "text": "这位学者用一部书证明的，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 633550,
      "end_ms": 634570,
      "text": "不是治理机构，"
    },
    {
      "segment_id": "s000302",
      "start_ms": 634570,
      "end_ms": 635690,
      "text": "并非不可或缺，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 636030,
      "end_ms": 637430,
      "text": "而是自由，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 637510,
      "end_ms": 638505,
      "text": "不是一种恩赐，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 639040,
      "end_ms": 640040,
      "text": "是一种能力。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 640540,
      "end_ms": 641520,
      "text": "他最大的突破，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 641600,
      "end_ms": 642360,
      "text": "不是方法，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 642640,
      "end_ms": 643320,
      "text": "是姿态。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 643800,
      "end_ms": 645720,
      "text": "他在这本书的第一章里写了一段话，"
    },
    {
      "segment_id": "s000310",
      "start_ms": 645840,
      "end_ms": 648040,
      "text": "我觉得是他留给世界最珍贵的遗产。"
    },
    {
      "segment_id": "s000311",
      "start_ms": 648200,
      "end_ms": 648580,
      "text": "他说，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 649040,
      "end_ms": 652780,
      "text": "当今大多数大学里以经济学为名所传授的东西，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 652900,
      "end_ms": 654680,
      "text": "实际上是在否定经济学，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 654780,
      "end_ms": 656840,
      "text": "经济学绝不该遭到降格关。"
    },
    {
      "segment_id": "s000315",
      "start_ms": 656840,
      "end_ms": 658340,
      "text": "在教室和统计室里，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 658540,
      "end_ms": 660520,
      "text": "也绝不该留在少数人的圈子里。"
    },
    {
      "segment_id": "s000317",
      "start_ms": 660520,
      "end_ms": 660920,
      "text": "逆传，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 661040,
      "end_ms": 662940,
      "text": "它是人生和行为的哲学，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 663240,
      "end_ms": 665220,
      "text": "关系到每个人和每件事情。"
    },
    {
      "segment_id": "s000320",
      "start_ms": 665860,
      "end_ms": 669125,
      "text": "这段话让我明白了这本书最惊世骇俗的答案。"
    },
    {
      "segment_id": "s000321",
      "start_ms": 669570,
      "end_ms": 672375,
      "text": "经济学最大的价值不是让你变有钱，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 672790,
      "end_ms": 677355,
      "text": "是让你在做任何决策时清楚的知道自己正在响应谁的激励，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 677590,
      "end_ms": 678595,
      "text": "放弃什么代价，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 678880,
      "end_ms": 681145,
      "text": "最终要为这个选择承担什么，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 681470,
      "end_ms": 683175,
      "text": "它不会让你的人生变容易，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 683440,
      "end_ms": 685275,
      "text": "但他会让你的人生变清醒。"
    },
    {
      "segment_id": "s000327",
      "start_ms": 685640,
      "end_ms": 686845,
      "text": "但米赛斯自己呢，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 687580,
      "end_ms": 690565,
      "text": "他是在纽约大学当了二十四年访问教授的人，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 691000,
      "end_ms": 692145,
      "text": "所谓访问教授，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 692420,
      "end_ms": 694360,
      "text": "这是学校不给他一分钱工资，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 694620,
      "end_ms": 697075,
      "text": "他的薪水由一个私人基金会支付。"
    },
    {
      "segment_id": "s000332",
      "start_ms": 697440,
      "end_ms": 699125,
      "text": "因为大学觉得让他上课可以，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 699350,
      "end_ms": 700735,
      "text": "但要花钱不行。"
    },
    {
      "segment_id": "s000334",
      "start_ms": 701300,
      "end_ms": 703975,
      "text": "他在美国学术界被边缘化了整整一生，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 704390,
      "end_ms": 705865,
      "text": "不是因为他的理论错了，"
    },
    {
      "segment_id": "s000336",
      "start_ms": 706390,
      "end_ms": 708435,
      "text": "恰恰是因为他的理论太对了。"
    },
    {
      "segment_id": "s000337",
      "start_ms": 708750,
      "end_ms": 711695,
      "text": "对到让所有信奉凯恩斯主义的人不舒服，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 712120,
      "end_ms": 713195,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000339",
      "start_ms": 713660,
      "end_ms": 716405,
      "text": "他看见每一个价格都是信息的载体。"
    },
    {
      "segment_id": "s000340",
      "start_ms": 716860,
      "end_ms": 719300,
      "text": "每一次干预都在制造连锁反应，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 719360,
      "end_ms": 724335,
      "text": "每一个市场都在用利润和亏损告诉人们谁在为他人创造价值。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 724640,
      "end_ms": 727100,
      "text": "而你有幸可以学会看懂这一切。"
    },
    {
      "segment_id": "s000343",
      "start_ms": 727320,
      "end_ms": 730895,
      "text": "这本书最后有一句话是米赛斯在全书结尾写下的，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 731420,
      "end_ms": 732495,
      "text": "我想把它留给你。"
    },
    {
      "segment_id": "s000345",
      "start_ms": 732850,
      "end_ms": 734605,
      "text": "面对不可避免的巨大灾难，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 735150,
      "end_ms": 736455,
      "text": "人们将会怎样生活？"
    },
    {
      "segment_id": "s000347",
      "start_ms": 736850,
      "end_ms": 737965,
      "text": "不要向邪恶低头，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 738270,
      "end_ms": 739470,
      "text": "鼓起更大的勇气，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 739750,
      "end_ms": 741045,
      "text": "继续与之对抗。"
    },
    {
      "segment_id": "s000350",
      "start_ms": 741420,
      "end_ms": 743355,
      "text": "米赛斯不是让你去对抗某个人，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 743910,
      "end_ms": 746140,
      "text": "他让你对抗的是你脑子里那套，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 746140,
      "end_ms": 747785,
      "text": "让你看不懂世界的认知。"
    },
    {
      "segment_id": "s000353",
      "start_ms": 748060,
      "end_ms": 748685,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000354",
      "start_ms": 748960,
      "end_ms": 750200,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 750200,
      "end_ms": 750735,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "54e5fcc06a6f1da10eb3ae16b8ec53c54057f7128dfa46f8bc9409d0e4265458"
}