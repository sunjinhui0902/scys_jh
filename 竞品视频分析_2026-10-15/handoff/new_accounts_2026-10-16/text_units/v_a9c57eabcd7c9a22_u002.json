{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_a9c57eabcd7c9a22_u002",
  "video_id": "v_a9c57eabcd7c9a22",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 1002.105011,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000392",
      "start_ms": 788850,
      "end_ms": 792165,
      "text": "真正的自我保护始于承认个人能力存在局限，"
    },
    {
      "segment_id": "s000393",
      "start_ms": 792450,
      "end_ms": 794070,
      "text": "然后主动去了解规则，"
    },
    {
      "segment_id": "s000394",
      "start_ms": 794230,
      "end_ms": 795070,
      "text": "善用规则。"
    },
    {
      "segment_id": "s000395",
      "start_ms": 795270,
      "end_ms": 795845,
      "text": "第三，"
    },
    {
      "segment_id": "s000396",
      "start_ms": 796320,
      "end_ms": 799020,
      "text": "法律的守护藏在日常细碎的选择当中，"
    },
    {
      "segment_id": "s000397",
      "start_ms": 799080,
      "end_ms": 802420,
      "text": "不是只有重大变故才需要民法典一次合同的阅读，"
    },
    {
      "segment_id": "s000398",
      "start_ms": 802700,
      "end_ms": 803780,
      "text": "一次证据的留存，"
    },
    {
      "segment_id": "s000399",
      "start_ms": 804200,
      "end_ms": 806115,
      "text": "一次对个人信息泄露的警惕。"
    },
    {
      "segment_id": "s000400",
      "start_ms": 806490,
      "end_ms": 808650,
      "text": "一次邻里之间厘清权责的沟通，"
    },
    {
      "segment_id": "s000401",
      "start_ms": 808990,
      "end_ms": 810455,
      "text": "一份提前规划的遗嘱。"
    },
    {
      "segment_id": "s000402",
      "start_ms": 810770,
      "end_ms": 812475,
      "text": "这些看似平淡的日常选择，"
    },
    {
      "segment_id": "s000403",
      "start_ms": 812760,
      "end_ms": 815045,
      "text": "一点点构筑起我们生活的防护网。"
    },
    {
      "segment_id": "s000404",
      "start_ms": 815830,
      "end_ms": 818170,
      "text": "一个人的生活如果完全漠视规则，"
    },
    {
      "segment_id": "s000405",
      "start_ms": 818330,
      "end_ms": 819825,
      "text": "只依靠人情与运气，"
    },
    {
      "segment_id": "s000406",
      "start_ms": 820250,
      "end_ms": 821570,
      "text": "哪怕表面看起来风光，"
    },
    {
      "segment_id": "s000407",
      "start_ms": 821850,
      "end_ms": 822930,
      "text": "内在的生活根基，"
    },
    {
      "segment_id": "s000408",
      "start_ms": 823170,
      "end_ms": 824610,
      "text": "实则处处充满漏洞。"
    },
    {
      "segment_id": "s000409",
      "start_ms": 824610,
      "end_ms": 824975,
      "text": "当然，"
    },
    {
      "segment_id": "s000410",
      "start_ms": 825280,
      "end_ms": 827740,
      "text": "也有一些旧的处事观念需要我们主动告别。"
    },
    {
      "segment_id": "s000411",
      "start_ms": 827820,
      "end_ms": 829635,
      "text": "回答点并不教我们试试算计，"
    },
    {
      "segment_id": "s000412",
      "start_ms": 829850,
      "end_ms": 831170,
      "text": "处处提防身边所有人，"
    },
    {
      "segment_id": "s000413",
      "start_ms": 831190,
      "end_ms": 832075,
      "text": "而是提醒我们，"
    },
    {
      "segment_id": "s000414",
      "start_ms": 832320,
      "end_ms": 833800,
      "text": "当人情与利益交织，"
    },
    {
      "segment_id": "s000415",
      "start_ms": 834060,
      "end_ms": 835885,
      "text": "当重大的厉害摆在面前，"
    },
    {
      "segment_id": "s000416",
      "start_ms": 836200,
      "end_ms": 838340,
      "text": "一味回避规则并不是宽厚，"
    },
    {
      "segment_id": "s000417",
      "start_ms": 838580,
      "end_ms": 841535,
      "text": "而是给自己和身边人埋下冲突的引线。"
    },
    {
      "segment_id": "s000418",
      "start_ms": 842400,
      "end_ms": 845100,
      "text": "当旧的处事方式一次次让你陷入被动，"
    },
    {
      "segment_id": "s000419",
      "start_ms": 845440,
      "end_ms": 848085,
      "text": "那么主动更新、认知独懂权利的边界，"
    },
    {
      "segment_id": "s000420",
      "start_ms": 848420,
      "end_ms": 849185,
      "text": "不是事故，"
    },
    {
      "segment_id": "s000421",
      "start_ms": 849490,
      "end_ms": 851505,
      "text": "而是对自己人生最大的忠诚。"
    },
    {
      "segment_id": "s000422",
      "start_ms": 851730,
      "end_ms": 855070,
      "text": "这本书最终传递的并不是一套教人打官司的技巧，"
    },
    {
      "segment_id": "s000423",
      "start_ms": 855330,
      "end_ms": 856750,
      "text": "而是穿越纷繁现实，"
    },
    {
      "segment_id": "s000424",
      "start_ms": 856790,
      "end_ms": 858070,
      "text": "依旧滚烫的提醒，"
    },
    {
      "segment_id": "s000425",
      "start_ms": 858450,
      "end_ms": 859690,
      "text": "认清自己的权利，"
    },
    {
      "segment_id": "s000426",
      "start_ms": 859830,
      "end_ms": 861950,
      "text": "是成年人一场无比重要的修行。"
    },
    {
      "segment_id": "s000427",
      "start_ms": 862330,
      "end_ms": 863350,
      "text": "不是你足够倒霉，"
    },
    {
      "segment_id": "s000428",
      "start_ms": 863350,
      "end_ms": 864350,
      "text": "才需要法律保护，"
    },
    {
      "segment_id": "s000429",
      "start_ms": 864610,
      "end_ms": 866510,
      "text": "也不是只有惹上官司才要读懂。"
    },
    {
      "segment_id": "s000430",
      "start_ms": 866510,
      "end_ms": 868830,
      "text": "法律遭遇伤害是事实的风险。"
    },
    {
      "segment_id": "s000431",
      "start_ms": 869190,
      "end_ms": 870210,
      "text": "懂得保护自己，"
    },
    {
      "segment_id": "s000432",
      "start_ms": 870390,
      "end_ms": 872070,
      "text": "是需要慢慢习得的智慧。"
    },
    {
      "segment_id": "s000433",
      "start_ms": 872390,
      "end_ms": 875290,
      "text": "每一个普通人都有着自己的软肋与处境。"
    },
    {
      "segment_id": "s000434",
      "start_ms": 875610,
      "end_ms": 876910,
      "text": "有人困于财产纠纷，"
    },
    {
      "segment_id": "s000435",
      "start_ms": 877190,
      "end_ms": 878650,
      "text": "有人受困于名誉侵扰，"
    },
    {
      "segment_id": "s000436",
      "start_ms": 879070,
      "end_ms": 880570,
      "text": "有人挣扎于家庭矛盾，"
    },
    {
      "segment_id": "s000437",
      "start_ms": 880590,
      "end_ms": 883280,
      "text": "看见这些风险不等于人生就此灰暗，"
    },
    {
      "segment_id": "s000438",
      "start_ms": 883640,
      "end_ms": 886580,
      "text": "而是给自己开启真实、从容生活的起点。"
    },
    {
      "segment_id": "s000439",
      "start_ms": 886880,
      "end_ms": 889100,
      "text": "把民法典当做普通人的生活地图，"
    },
    {
      "segment_id": "s000440",
      "start_ms": 889440,
      "end_ms": 891240,
      "text": "而不是一本单纯的诉讼手册，"
    },
    {
      "segment_id": "s000441",
      "start_ms": 891600,
      "end_ms": 892860,
      "text": "你就会心生敬畏。"
    },
    {
      "segment_id": "s000442",
      "start_ms": 893140,
      "end_ms": 895080,
      "text": "它不是用来判定谁大奸大恶，"
    },
    {
      "segment_id": "s000443",
      "start_ms": 895540,
      "end_ms": 897880,
      "text": "它更像一座矗立在烟火人间的灯塔。"
    },
    {
      "segment_id": "s000444",
      "start_ms": 898280,
      "end_ms": 901540,
      "text": "当我们吃亏、迷茫、手足无措的时候，"
    },
    {
      "segment_id": "s000445",
      "start_ms": 901880,
      "end_ms": 902500,
      "text": "翻开它，"
    },
    {
      "segment_id": "s000446",
      "start_ms": 902800,
      "end_ms": 905480,
      "text": "看清千千万万人都曾经遭遇过的处境，"
    },
    {
      "segment_id": "s000447",
      "start_ms": 905540,
      "end_ms": 907100,
      "text": "看清我们可以依靠的边界，"
    },
    {
      "segment_id": "s000448",
      "start_ms": 907360,
      "end_ms": 909260,
      "text": "找到另一种解决问题的路径。"
    },
    {
      "segment_id": "s000449",
      "start_ms": 909780,
      "end_ms": 913090,
      "text": "那些你以为只有自己才遇到他的委屈困境？"
    },
    {
      "segment_id": "s000450",
      "start_ms": 913490,
      "end_ms": 914130,
      "text": "古往今来，"
    },
    {
      "segment_id": "s000451",
      "start_ms": 914130,
      "end_ms": 915175,
      "text": "无数人都经历过。"
    },
    {
      "segment_id": "s000452",
      "start_ms": 915550,
      "end_ms": 916830,
      "text": "一代代人的生活经验，"
    },
    {
      "segment_id": "s000453",
      "start_ms": 917010,
      "end_ms": 920910,
      "text": "沉淀成这一千两百六十条条文系统完整的记录下来，"
    },
    {
      "segment_id": "s000454",
      "start_ms": 921130,
      "end_ms": 922770,
      "text": "守护每一个普通人的一生。"
    },
    {
      "segment_id": "s000455",
      "start_ms": 923110,
      "end_ms": 927490,
      "text": "愿每一个在现实里跌跌撞撞前行的人都能够慢慢懂得一件事，"
    },
    {
      "segment_id": "s000456",
      "start_ms": 927830,
      "end_ms": 929110,
      "text": "不是只有遭遇官司，"
    },
    {
      "segment_id": "s000457",
      "start_ms": 929190,
      "end_ms": 930230,
      "text": "才需要了解法律。"
    },
    {
      "segment_id": "s000458",
      "start_ms": 930610,
      "end_ms": 932210,
      "text": "每一个认真生活的普通人，"
    },
    {
      "segment_id": "s000459",
      "start_ms": 932390,
      "end_ms": 934310,
      "text": "都值得拥有规则带来的底气，"
    },
    {
      "segment_id": "s000460",
      "start_ms": 934630,
      "end_ms": 936110,
      "text": "看清自己全部的处境。"
    },
    {
      "segment_id": "s000461",
      "start_ms": 936290,
      "end_ms": 937710,
      "text": "权利与局限之后，"
    },
    {
      "segment_id": "s000462",
      "start_ms": 937930,
      "end_ms": 939810,
      "text": "既有勇气直面现实的复杂，"
    },
    {
      "segment_id": "s000463",
      "start_ms": 939870,
      "end_ms": 942090,
      "text": "也有底气守护好自己与家人，"
    },
    {
      "segment_id": "s000464",
      "start_ms": 942250,
      "end_ms": 944010,
      "text": "相信生活可以安稳前行，"
    },
    {
      "segment_id": "s000465",
      "start_ms": 944310,
      "end_ms": 945115,
      "text": "相信规则，"
    },
    {
      "segment_id": "s000466",
      "start_ms": 945400,
      "end_ms": 946780,
      "text": "以托举普通人的幸福。"
    },
    {
      "segment_id": "s000467",
      "start_ms": 946860,
      "end_ms": 949200,
      "text": "很多人总觉得法典是遥远枯燥的。"
    },
    {
      "segment_id": "s000468",
      "start_ms": 949200,
      "end_ms": 951220,
      "text": "官方文本离自己的日常很远，"
    },
    {
      "segment_id": "s000469",
      "start_ms": 951280,
      "end_ms": 956660,
      "text": "但这本中华人民共和国民法典是真正陪伴我们从出生到离世的生活宝典，"
    },
    {
      "segment_id": "s000470",
      "start_ms": 957300,
      "end_ms": 959420,
      "text": "它不只是法律从业者的专业读物，"
    },
    {
      "segment_id": "s000471",
      "start_ms": 959640,
      "end_ms": 962340,
      "text": "更是每一户家庭都应该备上的工具书，"
    },
    {
      "segment_id": "s000472",
      "start_ms": 962920,
      "end_ms": 964380,
      "text": "生活不会提前通知我们，"
    },
    {
      "segment_id": "s000473",
      "start_ms": 964420,
      "end_ms": 965400,
      "text": "风险何时降临，"
    },
    {
      "segment_id": "s000474",
      "start_ms": 965900,
      "end_ms": 967480,
      "text": "纠纷常常来的猝不及防，"
    },
    {
      "segment_id": "s000475",
      "start_ms": 968060,
      "end_ms": 969040,
      "text": "等到矛盾爆发，"
    },
    {
      "segment_id": "s000476",
      "start_ms": 969040,
      "end_ms": 969840,
      "text": "在临时寻找，"
    },
    {
      "segment_id": "s000477",
      "start_ms": 969840,
      "end_ms": 970180,
      "text": "答案，"
    },
    {
      "segment_id": "s000478",
      "start_ms": 970400,
      "end_ms": 972040,
      "text": "往往已经错失最佳时机。"
    },
    {
      "segment_id": "s000479",
      "start_ms": 972340,
      "end_ms": 973900,
      "text": "家中常备这一本民法典，"
    },
    {
      "segment_id": "s000480",
      "start_ms": 974140,
      "end_ms": 975245,
      "text": "闲暇时随手翻阅，"
    },
    {
      "segment_id": "s000481",
      "start_ms": 975510,
      "end_ms": 975800,
      "text": "嗯，"
    },
    {
      "segment_id": "s000482",
      "start_ms": 975830,
      "end_ms": 977275,
      "text": "遇到困惑拿来查阅，"
    },
    {
      "segment_id": "s000483",
      "start_ms": 977620,
      "end_ms": 979260,
      "text": "把权力的认知融入日常，"
    },
    {
      "segment_id": "s000484",
      "start_ms": 979560,
      "end_ms": 982635,
      "text": "就是给自己和家人筑起一道坚实的防护墙。"
    },
    {
      "segment_id": "s000485",
      "start_ms": 983060,
      "end_ms": 984240,
      "text": "不必精通所有法条，"
    },
    {
      "segment_id": "s000486",
      "start_ms": 984600,
      "end_ms": 986565,
      "text": "但一定要建立基础的权利认知。"
    },
    {
      "segment_id": "s000487",
      "start_ms": 986890,
      "end_ms": 988995,
      "text": "如果你想要拥有直面现实的底气，"
    },
    {
      "segment_id": "s000488",
      "start_ms": 989300,
      "end_ms": 990660,
      "text": "想要少踩生活的坑，"
    },
    {
      "segment_id": "s000489",
      "start_ms": 990880,
      "end_ms": 993995,
      "text": "守护自己与家人的财产、尊严与幸福。"
    },
    {
      "segment_id": "s000490",
      "start_ms": 994770,
      "end_ms": 996630,
      "text": "这本中华人民共和国民法典，"
    },
    {
      "segment_id": "s000491",
      "start_ms": 996830,
      "end_ms": 997895,
      "text": "值得你带回家。"
    },
    {
      "segment_id": "s000492",
      "start_ms": 998170,
      "end_ms": 998925,
      "text": "细细品度，"
    },
    {
      "segment_id": "s000493",
      "start_ms": 999330,
      "end_ms": 1000055,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000494",
      "start_ms": 1000370,
      "end_ms": 1001965,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "63337d93b12d228c660c08ede07cbea9c74ad4fbc41fa56b1885d05411b0cc07"
}