{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_aaa7253ec7413328_u001",
  "video_id": "v_aaa7253ec7413328",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 893.342993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 310,
      "end_ms": 2430,
      "text": "十三分钟讲解米塞斯人的行为。"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2810,
      "end_ms": 3750,
      "text": "米赛斯揭示，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 4030,
      "end_ms": 6570,
      "text": "人类社会之所以屡屡坠入灾难的深渊，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6850,
      "end_ms": 8950,
      "text": "不是因为人类缺乏行动的能力，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 9190,
      "end_ms": 12550,
      "text": "而是你一直在用你那自以为可以计算一切的理性，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 12710,
      "end_ms": 14810,
      "text": "去扼杀那个真正在行动的人。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 14850,
      "end_ms": 17690,
      "text": "奥地利学派第三代领军人物米塞斯曾说过，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18090,
      "end_ms": 19850,
      "text": "人的行为是有目的的。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 20130,
      "end_ms": 21290,
      "text": "人之所以行为，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 21430,
      "end_ms": 24990,
      "text": "是因为他想以较满意的情况代替较不满意的情况。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 25650,
      "end_ms": 27270,
      "text": "这个命题是鲜艳的，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 27290,
      "end_ms": 28290,
      "text": "不正自明的。"
    },
    {
      "segment_id": "s000013",
      "start_ms": 28970,
      "end_ms": 30840,
      "text": "你是否也有这样的时刻，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 31160,
      "end_ms": 35080,
      "text": "你每天在心里盘算这个行业该有一个总体的生产目标，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 35480,
      "end_ms": 37540,
      "text": "那个资源该由中央统一调配，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 37900,
      "end_ms": 38660,
      "text": "社会财富，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 38740,
      "end_ms": 40940,
      "text": "该按某种科学的方式重新分配，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 40960,
      "end_ms": 41780,
      "text": "你开始焦虑。"
    },
    {
      "segment_id": "s000019",
      "start_ms": 42300,
      "end_ms": 45460,
      "text": "你听到无数个体在市场里各自为政的做决定时，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 45460,
      "end_ms": 46440,
      "text": "觉得不够协调。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 46820,
      "end_ms": 47700,
      "text": "你开始担心，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 48100,
      "end_ms": 51360,
      "text": "你听说隔壁国家已经用五年计划实现了工业化。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 51720,
      "end_ms": 52540,
      "text": "你开始恐慌，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 52840,
      "end_ms": 54820,
      "text": "你问自己是不是哪里没做对，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 55080,
      "end_ms": 56740,
      "text": "是不是该加大干预力度，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 56820,
      "end_ms": 58420,
      "text": "还是得把价格也管起来。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 58800,
      "end_ms": 60435,
      "text": "你试过了所有的方方法，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 60760,
      "end_ms": 63755,
      "text": "计划、配额、价格、管制、产业政策，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 64080,
      "end_ms": 67965,
      "text": "甚至在深夜召集专家组反复论证有用吗？"
    },
    {
      "segment_id": "s000030",
      "start_ms": 68270,
      "end_ms": 68935,
      "text": "有一点儿，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 69250,
      "end_ms": 70030,
      "text": "但你也发现，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 70270,
      "end_ms": 72170,
      "text": "你越努力替社会做决定。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 72450,
      "end_ms": 73890,
      "text": "社会的活力越枯萎，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 74190,
      "end_ms": 75390,
      "text": "你越害怕无序，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 75610,
      "end_ms": 77315,
      "text": "越制造出更大的无序。"
    },
    {
      "segment_id": "s000036",
      "start_ms": 77660,
      "end_ms": 79640,
      "text": "你设计的越精细的生产目标，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 79820,
      "end_ms": 81775,
      "text": "执行起来越偏离现实。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 82630,
      "end_ms": 83410,
      "text": "你越焦虑，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 83710,
      "end_ms": 84805,
      "text": "系统越僵化。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 85320,
      "end_ms": 86625,
      "text": "你制定的规则越多，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 86920,
      "end_ms": 88885,
      "text": "企业家发现机会的空间越小。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 89230,
      "end_ms": 89855,
      "text": "你问自己，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 90200,
      "end_ms": 92325,
      "text": "我是不是给不了社会真正的繁荣？"
    },
    {
      "segment_id": "s000044",
      "start_ms": 92980,
      "end_ms": 94655,
      "text": "听你不是给不了，"
    },
    {
      "segment_id": "s000045",
      "start_ms": 95020,
      "end_ms": 95140,
      "text": "你，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 95140,
      "end_ms": 96860,
      "text": "只是从来没有人告诉过你，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 97000,
      "end_ms": 102100,
      "text": "你一直在用一个无所不知的规划者假设去取代那个有血有肉。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 102240,
      "end_ms": 105825,
      "text": "有目的会选择会犯错的行动者的人。"
    },
    {
      "segment_id": "s000049",
      "start_ms": 106570,
      "end_ms": 108915,
      "text": "你像一个站在中央控制台前的工程师，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 109270,
      "end_ms": 110690,
      "text": "以为掌握了所有数据，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 110690,
      "end_ms": 112715,
      "text": "就能操纵每一个齿轮的转速，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 113050,
      "end_ms": 115435,
      "text": "试图让整台机器按照你的图纸运转，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 115920,
      "end_ms": 118335,
      "text": "但你自己根本不知道那些数据是否真实。"
    },
    {
      "segment_id": "s000054",
      "start_ms": 118650,
      "end_ms": 121365,
      "text": "最后运转的只是一台没有灵魂的机械。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 121760,
      "end_ms": 122865,
      "text": "你以为这是科学？"
    },
    {
      "segment_id": "s000056",
      "start_ms": 123240,
      "end_ms": 124495,
      "text": "但这其实是健忘，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 125110,
      "end_ms": 125790,
      "text": "而健忘，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 125950,
      "end_ms": 128125,
      "text": "永远造不出有生命力的繁荣。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 128580,
      "end_ms": 129815,
      "text": "主流经济学怎么教你？"
    },
    {
      "segment_id": "s000060",
      "start_ms": 130280,
      "end_ms": 130840,
      "text": "他们会说，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 131080,
      "end_ms": 132475,
      "text": "你要收集更多数据，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 132750,
      "end_ms": 134705,
      "text": "你要建立更完善的计量模型。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 135050,
      "end_ms": 137450,
      "text": "你要提高宏观调控的精细化程度，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 137530,
      "end_ms": 138330,
      "text": "听起来很合理，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 138330,
      "end_ms": 138775,
      "text": "对不对？"
    },
    {
      "segment_id": "s000066",
      "start_ms": 139130,
      "end_ms": 139915,
      "text": "但你试过了，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 140240,
      "end_ms": 142840,
      "text": "你收集的数据永远滞后于真实变化。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 143100,
      "end_ms": 148795,
      "text": "你的模型永远忽略了那些无法量化的、分散在无数个体头脑中的主观判断。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 149240,
      "end_ms": 151810,
      "text": "你越是试图精确调控系统，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 151810,
      "end_ms": 153745,
      "text": "越是丧失自发调整的能力。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 154220,
      "end_ms": 160960,
      "text": "主流经济学在做的事情是教你如何更精巧的用数学模型去遮蔽那个真实行动者的人。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 161220,
      "end_ms": 162765,
      "text": "但米赛斯要告诉你的是，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 163100,
      "end_ms": 165860,
      "text": "如果你希望你的社会成为一个能够不断进化，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 165920,
      "end_ms": 168965,
      "text": "从容应对、未知变化、繁荣富足的有机整体，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 169290,
      "end_ms": 173210,
      "text": "你需要彻底放弃用一个全知视角来操纵人类行为。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 173230,
      "end_ms": 174410,
      "text": "这个致命的健忘。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 174690,
      "end_ms": 180575,
      "text": "以下是基于米赛斯人的行为整理出的理解人类行动与文明演进的四个核心洞见。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 181100,
      "end_ms": 183660,
      "text": "每一个都会让你觉得这怎么可能做到，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 183960,
      "end_ms": 187095,
      "text": "但每一个都是通往真正繁荣的必经之路。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 187570,
      "end_ms": 188235,
      "text": "第一原则，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 188750,
      "end_ms": 190290,
      "text": "行动是有目的的，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 190410,
      "end_ms": 192250,
      "text": "做行动逻辑的洞察者，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 192310,
      "end_ms": 193875,
      "text": "而非目的的主宰者。"
    },
    {
      "segment_id": "s000084",
      "start_ms": 194350,
      "end_ms": 198125,
      "text": "米塞斯在人的行为的开篇就提出了一个不可否认的功力。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 198510,
      "end_ms": 200070,
      "text": "人的行为是有目的的，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 200070,
      "end_ms": 206000,
      "text": "行为是人为了以较满意的情况代替较不满意的情况而做出的有意识的调整。"
    },
    {
      "segment_id": "s000087",
      "start_ms": 206200,
      "end_ms": 207980,
      "text": "这个命题之所以是鲜艳的，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 207980,
      "end_ms": 208915,
      "text": "不正自明的，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 209190,
      "end_ms": 211390,
      "text": "是因为任何试图否定他的行为，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 211390,
      "end_ms": 214025,
      "text": "本身就已经是一种有目的的行为。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 214330,
      "end_ms": 216110,
      "text": "说人不能有目的的行动，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 216110,
      "end_ms": 218955,
      "text": "这句话本身就是一个有目的的行动。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 219340,
      "end_ms": 220715,
      "text": "你听到这里一定在说，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 221230,
      "end_ms": 222255,
      "text": "这和我有什么关系，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 222530,
      "end_ms": 224325,
      "text": "我就是在替社会做规划呀。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 224670,
      "end_ms": 227190,
      "text": "我的目的就是让所有人过上更好的生活。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 227190,
      "end_ms": 228665,
      "text": "那米塞斯的逻辑很简单，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 229030,
      "end_ms": 231110,
      "text": "你的每一次替他人设定目标，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 231370,
      "end_ms": 235330,
      "text": "都在否认那个人自己判断什么是更满意的情况的能力。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 235470,
      "end_ms": 238430,
      "text": "你越频繁的用自己的目的去替换无数个体，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 238430,
      "end_ms": 239295,
      "text": "各自的目的，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 239610,
      "end_ms": 243070,
      "text": "社会就越会被训练成一群只会等待指令的被动。"
    },
    {
      "segment_id": "s000103",
      "start_ms": 243070,
      "end_ms": 243494,
      "text": "个体。"
    },
    {
      "segment_id": "s000104",
      "start_ms": 243840,
      "end_ms": 244875,
      "text": "一旦指令消失，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 245140,
      "end_ms": 247305,
      "text": "他们将失去一切自主行动的能力。"
    },
    {
      "segment_id": "s000106",
      "start_ms": 247640,
      "end_ms": 248335,
      "text": "传统做法，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 248620,
      "end_ms": 250800,
      "text": "我们要为每一个行业设定发展目标。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 251040,
      "end_ms": 253540,
      "text": "我们要规定每一家企业应该生产什么，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 253540,
      "end_ms": 254295,
      "text": "生产多少。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 254640,
      "end_ms": 257615,
      "text": "我们要给整个社会制定一个统一的幸福标准。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 258000,
      "end_ms": 259800,
      "text": "米赛斯的做法承认，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 259800,
      "end_ms": 263375,
      "text": "每个人行为的目的和达成目的的手段都具有个性。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 263850,
      "end_ms": 265335,
      "text": "这种个性因人而异，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 265740,
      "end_ms": 267540,
      "text": "即使给定相同的外部条件，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 267760,
      "end_ms": 269835,
      "text": "不同的人的选择也会不同。"
    },
    {
      "segment_id": "s000116",
      "start_ms": 270290,
      "end_ms": 272570,
      "text": "人的行为的决定因素是人的心智，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 272750,
      "end_ms": 274090,
      "text": "而非物理性的外力。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 274170,
      "end_ms": 275015,
      "text": "米塞斯说，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 275390,
      "end_ms": 278755,
      "text": "人的行为学所关心的不是人们应该追求什么目的，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 279000,
      "end_ms": 282785,
      "text": "而是人们如何运用手段去实现他们自己选择的目的。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 283100,
      "end_ms": 286115,
      "text": "行为学对于目的的内容保持严格的中立，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 287000,
      "end_ms": 289215,
      "text": "通过指令建立的秩序是脆弱的。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 289490,
      "end_ms": 293130,
      "text": "因为他的前提是规划者比所有人都更了解什么。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 293130,
      "end_ms": 293310,
      "text": "对，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 293310,
      "end_ms": 293905,
      "text": "每个人好。"
    },
    {
      "segment_id": "s000126",
      "start_ms": 294370,
      "end_ms": 296210,
      "text": "而这恰恰是最不可能成立的。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 296210,
      "end_ms": 296590,
      "text": "假设，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 296690,
      "end_ms": 300750,
      "text": "通过承认个体目的多样性而建立的秩序才是稳固的当。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 300750,
      "end_ms": 303230,
      "text": "每个人知道自己的选择是被尊重的，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 303450,
      "end_ms": 305630,
      "text": "他才会真正为自己的决定负责，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 305990,
      "end_ms": 309690,
      "text": "才会认真运用他所掌握的特定时空环境下的知识，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 309890,
      "end_ms": 311310,
      "text": "去改善自己的处境，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 311490,
      "end_ms": 313170,
      "text": "这就是社会繁荣的根基。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 313670,
      "end_ms": 316870,
      "text": "如果你总是在每一个选择面前替别人做决定，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 317110,
      "end_ms": 319490,
      "text": "那个被替做决定的人永远学不会。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 319490,
      "end_ms": 320650,
      "text": "如何为自己负责？"
    },
    {
      "segment_id": "s000137",
      "start_ms": 320910,
      "end_ms": 321270,
      "text": "第二，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 321270,
      "end_ms": 321610,
      "text": "原则，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 321990,
      "end_ms": 323370,
      "text": "经济计算需要价格，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 323370,
      "end_ms": 324820,
      "text": "没有价格信号，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 324880,
      "end_ms": 325700,
      "text": "就没有理性，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 325980,
      "end_ms": 327620,
      "text": "尊重市场及理性。"
    },
    {
      "segment_id": "s000143",
      "start_ms": 327680,
      "end_ms": 328700,
      "text": "在米赛斯看来，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 328880,
      "end_ms": 331460,
      "text": "社会中最关键的治理工具是经济计算，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 331940,
      "end_ms": 336780,
      "text": "但经济计算之所以可能是因为用货币计量单位所表现的价格，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 336860,
      "end_ms": 338580,
      "text": "构成了这种计算的必要条件。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 338780,
      "end_ms": 339720,
      "text": "没有自由市场，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 339880,
      "end_ms": 341440,
      "text": "就没有真正的价格机制，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 341800,
      "end_ms": 342760,
      "text": "没有价格机制，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 342900,
      "end_ms": 344380,
      "text": "也就谈不上经济计算。"
    },
    {
      "segment_id": "s000151",
      "start_ms": 344720,
      "end_ms": 350180,
      "text": "这是米塞斯在一九二零年代那场社会主义经济核算大论战中提出的核心论点。"
    },
    {
      "segment_id": "s000152",
      "start_ms": 350680,
      "end_ms": 355405,
      "text": "而这场论战至今仍然是理解计划经济为何失败带的最深刻的分析。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 355760,
      "end_ms": 358735,
      "text": "你不需要知道一部手机的供应链上有多少个环节，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 359060,
      "end_ms": 361555,
      "text": "你甚至不需要知道手机是怎么造出来的。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 361880,
      "end_ms": 363565,
      "text": "你只需要看到那个价格，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 363830,
      "end_ms": 364855,
      "text": "他就告诉你一切。"
    },
    {
      "segment_id": "s000157",
      "start_ms": 365310,
      "end_ms": 366750,
      "text": "但如果你消灭了价格，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 366910,
      "end_ms": 368955,
      "text": "如果你让中央计划机构来定价，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 369230,
      "end_ms": 371995,
      "text": "那么计划者面对的是一个不可能完成的任务。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 372520,
      "end_ms": 374875,
      "text": "他无法确定某一种产品是否需要，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 375120,
      "end_ms": 377060,
      "text": "也不能确定生产它的过程中，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 377060,
      "end_ms": 379055,
      "text": "劳动和原材料是否有浪费。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 379560,
      "end_ms": 382835,
      "text": "由于中央计划者没有市场经济调整的价格信号，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 383170,
      "end_ms": 386325,
      "text": "也就没有能凭以做计划的经济计算手段，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 386780,
      "end_ms": 390680,
      "text": "因而只能采取一种在黑暗中摸索的试错办法。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 390760,
      "end_ms": 393965,
      "text": "大多数干预主义者毁掉了市场自我调节的能力，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 394260,
      "end_ms": 397200,
      "text": "因为他们在价格还没有传递出真实信号的时候，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 397260,
      "end_ms": 398705,
      "text": "就急于去纠正它。"
    },
    {
      "segment_id": "s000169",
      "start_ms": 399060,
      "end_ms": 399720,
      "text": "米塞斯说，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 400040,
      "end_ms": 402055,
      "text": "如果价格管制导致了短缺，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 402410,
      "end_ms": 403995,
      "text": "不要急着去责怪市场，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 404400,
      "end_ms": 405765,
      "text": "让他去体验后果。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 406010,
      "end_ms": 406910,
      "text": "如果配给制度，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 406910,
      "end_ms": 407750,
      "text": "一次次失败，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 407950,
      "end_ms": 409255,
      "text": "不要替他感到绝望。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 409630,
      "end_ms": 414610,
      "text": "因为真正的失败是根本没有让价格系统自由运转过市场的美丽之处在于，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 414790,
      "end_ms": 417050,
      "text": "它不需要任何人掌握全部信息，"
    },
    {
      "segment_id": "s000178",
      "start_ms": 417130,
      "end_ms": 418910,
      "text": "就能协调千百万人的行动。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 419030,
      "end_ms": 421615,
      "text": "你不需要知道所有生产要素的替代方案，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 421890,
      "end_ms": 424025,
      "text": "你只需要看到要素价格的变化，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 424250,
      "end_ms": 426650,
      "text": "他就会引导你做出调整价格。"
    },
    {
      "segment_id": "s000182",
      "start_ms": 426650,
      "end_ms": 428665,
      "text": "系统是一个沟通信息的机制。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 429040,
      "end_ms": 432220,
      "text": "他把分散在无数个体头脑中的知识汇聚起来，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 432420,
      "end_ms": 433725,
      "text": "协调人类的活动。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 434140,
      "end_ms": 436615,
      "text": "一旦社会体验过这种没有中央定价，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 436860,
      "end_ms": 439315,
      "text": "却能够自行运转的秩序并活了下来，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 439630,
      "end_ms": 441485,
      "text": "那么他就建立了抗脆弱性。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 441830,
      "end_ms": 444265,
      "text": "他知道了没有什么是真正的致命打击。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 444660,
      "end_ms": 445980,
      "text": "只要价格信号还在，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 445980,
      "end_ms": 449415,
      "text": "自由传递资源就会找到他最需要去的地方。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 449630,
      "end_ms": 450375,
      "text": "第三原则，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 450790,
      "end_ms": 452050,
      "text": "市场是一个过程，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 452230,
      "end_ms": 453955,
      "text": "不是一张均衡的方程。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 454470,
      "end_ms": 456630,
      "text": "时间与不确定性是行为的。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 456630,
      "end_ms": 457950,
      "text": "圆范米塞斯认为，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 458230,
      "end_ms": 461710,
      "text": "古典经济学家和主流均衡理论的根本错误在于，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 461990,
      "end_ms": 466335,
      "text": "他们把市场当做一个可以达到均衡状态的静态系统来分析。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 466670,
      "end_ms": 467595,
      "text": "但米塞斯指出，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 467990,
      "end_ms": 469325,
      "text": "时间是一个缘分，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 469700,
      "end_ms": 471975,
      "text": "是人的行为中固有的基本要素。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 472490,
      "end_ms": 473770,
      "text": "行为的目的在于变，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 473970,
      "end_ms": 476610,
      "text": "所以行为是在时间的程序中进行的，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 476630,
      "end_ms": 479165,
      "text": "每一行动都是在不确定性中做出的，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 479470,
      "end_ms": 481405,
      "text": "因为未来本质上不可预测。"
    },
    {
      "segment_id": "s000205",
      "start_ms": 481800,
      "end_ms": 483545,
      "text": "米赛斯区分了两种秩序，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 483940,
      "end_ms": 487740,
      "text": "一种是市场中由无数个体各自行动所产生的结果，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 487900,
      "end_ms": 489280,
      "text": "没有特定的统一目标，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 489540,
      "end_ms": 492560,
      "text": "只有自发形成的价格和利润亏损信号。"
    },
    {
      "segment_id": "s000209",
      "start_ms": 492620,
      "end_ms": 494900,
      "text": "另一种是组织内部的命令体系，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 495120,
      "end_ms": 496800,
      "text": "所有人服从同一个目标。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 497100,
      "end_ms": 498300,
      "text": "在一个自由社会中，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 498540,
      "end_ms": 500125,
      "text": "最重要的秩序是前者。"
    },
    {
      "segment_id": "s000213",
      "start_ms": 500460,
      "end_ms": 503345,
      "text": "因为他不需要所有人对同一目标达成共识，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 503670,
      "end_ms": 508485,
      "text": "只需要价格信号再传递信息、利润和亏损再奖惩决策，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 508970,
      "end_ms": 511350,
      "text": "不同的人可以追求各自不同的目的，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 511490,
      "end_ms": 513030,
      "text": "各自发挥各自的天赋。"
    },
    {
      "segment_id": "s000217",
      "start_ms": 513150,
      "end_ms": 517155,
      "text": "而如果你试图把统一步调的规划规则推广到整个社会，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 517470,
      "end_ms": 519395,
      "text": "要求所有人朝着同一个方向，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 519680,
      "end_ms": 520960,
      "text": "遵循同一个标准，"
    },
    {
      "segment_id": "s000220",
      "start_ms": 521140,
      "end_ms": 522920,
      "text": "追逐同一个意义上的成功，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 522940,
      "end_ms": 524300,
      "text": "你就会消灭多样性，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 524500,
      "end_ms": 525620,
      "text": "消灭个体差异，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 525840,
      "end_ms": 529180,
      "text": "消灭那些无法被标准化衡量的独特判断力。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 529320,
      "end_ms": 531095,
      "text": "在这个充满不确定性的时代，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 531440,
      "end_ms": 534570,
      "text": "单一的成功定义、产量、排名、GDP增速，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 534870,
      "end_ms": 536835,
      "text": "这些都会被新的维度所取代。"
    },
    {
      "segment_id": "s000227",
      "start_ms": 537130,
      "end_ms": 540640,
      "text": "真正有价值的是适应复杂变化的企业家判断力。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 540800,
      "end_ms": 541580,
      "text": "米塞斯认为，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 541720,
      "end_ms": 544705,
      "text": "利润的最终来源总归是对未来的洞见，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 545050,
      "end_ms": 546655,
      "text": "而洞见是不可计划的。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 546960,
      "end_ms": 548560,
      "text": "如果你想拥有长期繁荣，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 548780,
      "end_ms": 552655,
      "text": "就要停止用一张静态的方程去替代那个动态的过程，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 553030,
      "end_ms": 556310,
      "text": "开始尊重每一个行动者在时间中做出的判断。"
    },
    {
      "segment_id": "s000234",
      "start_ms": 556410,
      "end_ms": 556770,
      "text": "第四，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 556770,
      "end_ms": 557235,
      "text": "原则，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 557670,
      "end_ms": 559175,
      "text": "方法论的个人主义。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 559770,
      "end_ms": 563600,
      "text": "一切社会现象都要追溯到个人的行动秩序，"
    },
    {
      "segment_id": "s000238",
      "start_ms": 563680,
      "end_ms": 566445,
      "text": "不需要中央程序员米赛斯反复强调，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 566700,
      "end_ms": 569225,
      "text": "社会现象必须通过个体行为来理解。"
    },
    {
      "segment_id": "s000240",
      "start_ms": 569550,
      "end_ms": 571950,
      "text": "方法论的个人主义不是一种价值立场，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 572210,
      "end_ms": 573905,
      "text": "而是一种认识论的要求。"
    },
    {
      "segment_id": "s000242",
      "start_ms": 574400,
      "end_ms": 575800,
      "text": "因为所有集体概念，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 575960,
      "end_ms": 578335,
      "text": "如国家、阶级社会，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 578740,
      "end_ms": 580785,
      "text": "最终都是由个人的行动构成的，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 581010,
      "end_ms": 582410,
      "text": "没有可看得见的国民，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 582670,
      "end_ms": 584190,
      "text": "就没有可看得见的国。"
    },
    {
      "segment_id": "s000247",
      "start_ms": 584370,
      "end_ms": 585305,
      "text": "米塞斯指出，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 585620,
      "end_ms": 587600,
      "text": "以往的经济学研究受到物理学，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 587800,
      "end_ms": 589320,
      "text": "特别是牛顿力学的影响，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 589380,
      "end_ms": 595060,
      "text": "把经济学当做一个没有灵魂的机械来分析那个机械被一些不可再分析的力量，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 595060,
      "end_ms": 596160,
      "text": "神秘的驱使着。"
    },
    {
      "segment_id": "s000252",
      "start_ms": 596240,
      "end_ms": 600380,
      "text": "但人的行为与石头原子基因的运动截然不同。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 600579,
      "end_ms": 602895,
      "text": "人的行为是个体的、理性的。"
    },
    {
      "segment_id": "s000254",
      "start_ms": 603460,
      "end_ms": 605980,
      "text": "这个理性不是指选择正确的目的，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 606280,
      "end_ms": 610360,
      "text": "而是指有意识的选择手段来实现自己选择的目的。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 610520,
      "end_ms": 614780,
      "text": "那些试图用科学的设计去替代无数个体自发协作的做法，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 615020,
      "end_ms": 616060,
      "text": "才是最致命的。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 616060,
      "end_ms": 616460,
      "text": "健忘。"
    },
    {
      "segment_id": "s000259",
      "start_ms": 616480,
      "end_ms": 617180,
      "text": "米塞斯说，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 617560,
      "end_ms": 621060,
      "text": "经济学对于有权利的人的妄自尊大是一个挑战。"
    },
    {
      "segment_id": "s000261",
      "start_ms": 621520,
      "end_ms": 623100,
      "text": "如果你没有注意到这个事实，"
    },
    {
      "segment_id": "s000262",
      "start_ms": 623280,
      "end_ms": 625260,
      "text": "你就不可能懂得经济思想史。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 625280,
      "end_ms": 627940,
      "text": "人类的心智本身就是社会演化的产物，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 628080,
      "end_ms": 629800,
      "text": "它不是社会演化的向导。"
    },
    {
      "segment_id": "s000265",
      "start_ms": 629940,
      "end_ms": 635030,
      "text": "承认这一点意味着你要放下对每一个社会成员行为目的的控制欲，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 635390,
      "end_ms": 639230,
      "text": "意味着你要眼睁睁看着市场走弯路而不去插手。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 639470,
      "end_ms": 640850,
      "text": "只要不是致命的危险，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 641270,
      "end_ms": 644370,
      "text": "意味着你要接受经济在某个阶段的不如意，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 644670,
      "end_ms": 647130,
      "text": "但那是他找到自己方向的必经之路。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 647210,
      "end_ms": 648570,
      "text": "但回报是巨大的，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 648850,
      "end_ms": 651010,
      "text": "你会得到一个不需要你操心的社会，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 651250,
      "end_ms": 654730,
      "text": "一个能够独立思考、独立判断、独立应对变化，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 654790,
      "end_ms": 656510,
      "text": "独立创造繁荣的整体。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 656830,
      "end_ms": 658310,
      "text": "而这本超越米赛斯，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 658610,
      "end_ms": 661250,
      "text": "就是专门为你这种已经意识到问题，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 661590,
      "end_ms": 663865,
      "text": "只想成为行动逻辑的洞察者，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 664100,
      "end_ms": 667075,
      "text": "而非他人命运的主宰者的思考者而写的。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 667460,
      "end_ms": 670855,
      "text": "它不是一本教你如何更高效的管理社会的技术手册，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 671250,
      "end_ms": 672915,
      "text": "那样只会加重你的肩膀。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 673200,
      "end_ms": 676655,
      "text": "他是一本告诉你如何放下中央计算的全知幻觉，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 677050,
      "end_ms": 678555,
      "text": "如何停止过度干预，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 678840,
      "end_ms": 682895,
      "text": "如何从焦虑的控制者变成平静的观察者的完整地图。"
    },
    {
      "segment_id": "s000283",
      "start_ms": 683350,
      "end_ms": 684150,
      "text": "在这本书里，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 684330,
      "end_ms": 686330,
      "text": "没有五步实现社会最优配置。"
    },
    {
      "segment_id": "s000285",
      "start_ms": 686330,
      "end_ms": 688135,
      "text": "这种虚假的快速解决方案，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 688460,
      "end_ms": 691980,
      "text": "有的是你的控制欲从哪里来和如何先疗愈。"
    },
    {
      "segment_id": "s000287",
      "start_ms": 691980,
      "end_ms": 695120,
      "text": "你那自以为可以计算一切的理性的深度自省。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 695200,
      "end_ms": 697760,
      "text": "没有如何让社会不怕波动的空洞鸡汤，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 698060,
      "end_ms": 704800,
      "text": "有的是如何在市场调整时保持镇定和如何让他在试错中学习却不被摧毁的陪伴方法。"
    },
    {
      "segment_id": "s000290",
      "start_ms": 704880,
      "end_ms": 707500,
      "text": "没有如何缔造一个完美运行的经济体。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 707520,
      "end_ms": 709025,
      "text": "这种不负责任的承诺，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 709620,
      "end_ms": 714600,
      "text": "有的是如何放下对均衡的执念和如何帮助你手中的社会，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 714600,
      "end_ms": 716900,
      "text": "找到属于他自己的秩序的实操心法。"
    },
    {
      "segment_id": "s000294",
      "start_ms": 716980,
      "end_ms": 717920,
      "text": "读完人的行为，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 718040,
      "end_ms": 719695,
      "text": "你可能发现书名起错了。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 720030,
      "end_ms": 721510,
      "text": "这不是一本经济学教材，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 721510,
      "end_ms": 724765,
      "text": "是一本关于人如何在不确定性中行动，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 725060,
      "end_ms": 729445,
      "text": "以及当无数人的行动汇聚在一起时会发生什么的哲学手记。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 729890,
      "end_ms": 731610,
      "text": "米赛斯在书最后有一段话，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 731830,
      "end_ms": 732905,
      "text": "我想把它留给你。"
    },
    {
      "segment_id": "s000301",
      "start_ms": 733760,
      "end_ms": 737655,
      "text": "经济学所处理的是实在的人的一些实在的行为。"
    },
    {
      "segment_id": "s000302",
      "start_ms": 738220,
      "end_ms": 741025,
      "text": "他的定理既不涉及理想的或完全的人，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 741330,
      "end_ms": 743415,
      "text": "也不涉及荒唐无稽的经纪人，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 743820,
      "end_ms": 748785,
      "text": "这才是他从写作第一天到最后一天每一天都在做的事儿。"
    },
    {
      "segment_id": "s000305",
      "start_ms": 749470,
      "end_ms": 752105,
      "text": "最后我想认真推荐一次这本书。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 752560,
      "end_ms": 754035,
      "text": "如果你看到这里还没有划走，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 754370,
      "end_ms": 755610,
      "text": "说明你心里有一个问题，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 755610,
      "end_ms": 756705,
      "text": "一直没有被回答。"
    },
    {
      "segment_id": "s000309",
      "start_ms": 757200,
      "end_ms": 758400,
      "text": "我们到底该怎么理解？"
    },
    {
      "segment_id": "s000310",
      "start_ms": 758400,
      "end_ms": 759920,
      "text": "那些我们每天都在参与，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 760160,
      "end_ms": 762300,
      "text": "却从未真正理解的经济现象。"
    },
    {
      "segment_id": "s000312",
      "start_ms": 762460,
      "end_ms": 764825,
      "text": "人的行为就是为这个问题写的，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 765430,
      "end_ms": 766725,
      "text": "他不是让你姓什么，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 767080,
      "end_ms": 771955,
      "text": "它是让你看见市场和计划之间那片被我们粗暴踩平的地带。"
    },
    {
      "segment_id": "s000315",
      "start_ms": 772320,
      "end_ms": 773285,
      "text": "由于平台规则，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 773540,
      "end_ms": 776095,
      "text": "有些细节无法展开哪些细节，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 776460,
      "end_ms": 779195,
      "text": "比如经济计算论证的完整逻辑链条，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 779650,
      "end_ms": 781905,
      "text": "比如干预主义动力学的历史案例，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 782300,
      "end_ms": 785500,
      "text": "比如米赛斯为什么要在认识论上花那么多篇幅？"
    },
    {
      "segment_id": "s000320",
      "start_ms": 785680,
      "end_ms": 786740,
      "text": "这些东西一旦展开，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 787080,
      "end_ms": 787640,
      "text": "这条内容，"
    },
    {
      "segment_id": "s000322",
      "start_ms": 787640,
      "end_ms": 788220,
      "text": "大概率活。"
    },
    {
      "segment_id": "s000323",
      "start_ms": 788220,
      "end_ms": 788480,
      "text": "不过，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 788480,
      "end_ms": 790755,
      "text": "今晚这本书适合三种人，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 791240,
      "end_ms": 794590,
      "text": "第一种是被市场VS政府这个伪命题。"
    },
    {
      "segment_id": "s000326",
      "start_ms": 794590,
      "end_ms": 795485,
      "text": "夹在中间的人，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 795770,
      "end_ms": 797010,
      "text": "既不想盲目崇拜市场，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 797360,
      "end_ms": 798955,
      "text": "也不想天真的信任计划，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 799330,
      "end_ms": 801365,
      "text": "但你没有语言描述自己的位置。"
    },
    {
      "segment_id": "s000330",
      "start_ms": 801770,
      "end_ms": 803165,
      "text": "这本书给你语言，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 803670,
      "end_ms": 805855,
      "text": "第二种是想训练思维的人。"
    },
    {
      "segment_id": "s000332",
      "start_ms": 806100,
      "end_ms": 808140,
      "text": "你以为经济学是公式和图表，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 808540,
      "end_ms": 809975,
      "text": "它其实是逻辑推理。"
    }
  ],
  "source_transcript_sha256": "8e1fe535e2b2c0d55fb5ccd9e7547f1112814a133b5e4fc87bc5ef532079e6b0"
}