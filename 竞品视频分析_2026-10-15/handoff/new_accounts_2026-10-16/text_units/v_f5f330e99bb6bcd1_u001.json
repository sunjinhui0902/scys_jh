{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_f5f330e99bb6bcd1_u001",
  "video_id": "v_f5f330e99bb6bcd1",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 2,
  "duration_s": 962.26,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 400,
      "end_ms": 3040,
      "text": "十五分钟讲解邵雍黄籍金世书，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 3120,
      "end_ms": 3700,
      "text": "有一本书，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 3960,
      "end_ms": 8840,
      "text": "在中国思想史的殿堂与东亚易学研究的案头被供奉了将近一千年，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 9180,
      "end_ms": 12920,
      "text": "被朱熹称为自缢以后无人做得遗物如此整齐，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 13100,
      "end_ms": 13940,
      "text": "包括得进，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 14020,
      "end_ms": 16400,
      "text": "却在现代中文世界的公共知识讨论里，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16400,
      "end_ms": 18720,
      "text": "几乎隐形不是因为他太重险，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 18860,
      "end_ms": 20040,
      "text": "而是因为他太危险。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 20420,
      "end_ms": 21120,
      "text": "危险到会，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 21120,
      "end_ms": 23920,
      "text": "让几代中国知识分子信奉的那套象术，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23940,
      "end_ms": 25240,
      "text": "等于算命易学，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 25260,
      "end_ms": 26680,
      "text": "等于迷信邵雍，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 26700,
      "end_ms": 29200,
      "text": "等于术士的认知框架发生七级地震。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 29400,
      "end_ms": 32350,
      "text": "这本书叫黄集经世书作者，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 32350,
      "end_ms": 34010,
      "text": "邵雍是北宋五子之一，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 34370,
      "end_ms": 39510,
      "text": "但你几乎从没在任何一本主流中国哲学史教材里看到过关于他的完整章节。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 39530,
      "end_ms": 40710,
      "text": "更值得注意的是，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 40710,
      "end_ms": 42510,
      "text": "他成为哲学家之前的身份，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 42750,
      "end_ms": 46690,
      "text": "一个用三十年时间反复观察天地自然消长的隐士。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 46750,
      "end_ms": 50110,
      "text": "他师从李知才学习河图洛书与伏羲八卦，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 50330,
      "end_ms": 52870,
      "text": "构建出独特的先天象数学体系。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 53350,
      "end_ms": 56870,
      "text": "他在洛阳的居所叫安乐窝字号安乐先生。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 57090,
      "end_ms": 60080,
      "text": "邻居们或许觉得他不过是个过着闲适生活的读书。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 60120,
      "end_ms": 61165,
      "text": "突然离谱的是，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 61540,
      "end_ms": 64155,
      "text": "邵雍把这种官务的思考写成书之后，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 64430,
      "end_ms": 65615,
      "text": "遭遇的不是追捧，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 66100,
      "end_ms": 70715,
      "text": "是来自两个阵营的同时围攻正统儒家嫌他涉于牵强，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 71080,
      "end_ms": 72200,
      "text": "把它归入术数家。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 72200,
      "end_ms": 75555,
      "text": "一类术术家则把他书中的卦象配术拿去算命，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 75840,
      "end_ms": 77535,
      "text": "完全无视他的哲学意图。"
    },
    {
      "segment_id": "s000031",
      "start_ms": 78100,
      "end_ms": 81895,
      "text": "人们宁可相信一个儒者研究相术是某种神秘主义倾向，"
    },
    {
      "segment_id": "s000032",
      "start_ms": 82220,
      "end_ms": 83875,
      "text": "也不愿面对一个可怕的真相。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 84330,
      "end_ms": 87510,
      "text": "你对相树和理性的认知从根儿上就错了。"
    },
    {
      "segment_id": "s000034",
      "start_ms": 87610,
      "end_ms": 91515,
      "text": "今天这条文字我会拆出这本书里最颠覆的五个底层认知。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 91960,
      "end_ms": 92720,
      "text": "但我要提前警告，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 92720,
      "end_ms": 93790,
      "text": "你看完后，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 93910,
      "end_ms": 98890,
      "text": "你可能会推翻过去二十年、三十年奉为归孽的橡树VSE理二元论，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 98890,
      "end_ms": 100190,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 100330,
      "end_ms": 101670,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 101730,
      "end_ms": 102815,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 102970,
      "end_ms": 104050,
      "text": "那我们开始进入正题。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 104130,
      "end_ms": 107130,
      "text": "第一层颠覆橡树不是迷信的工具，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 107370,
      "end_ms": 108490,
      "text": "是一种认知方式。"
    },
    {
      "segment_id": "s000044",
      "start_ms": 108490,
      "end_ms": 109605,
      "text": "你有没有听过这句话？"
    },
    {
      "segment_id": "s000045",
      "start_ms": 110000,
      "end_ms": 112835,
      "text": "相术就是算命和哲学没多大关系。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 113060,
      "end_ms": 116960,
      "text": "黄籍金世书开篇第一个动作就把这套认知判了死刑邵雍，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 117040,
      "end_ms": 121615,
      "text": "用元会运势四个概念推演历史演变于兴衰，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 122000,
      "end_ms": 123235,
      "text": "起于地窑甲城，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 123680,
      "end_ms": 125120,
      "text": "至后周显得六年。"
    },
    {
      "segment_id": "s000050",
      "start_ms": 125140,
      "end_ms": 126235,
      "text": "几位注意，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 126470,
      "end_ms": 127110,
      "text": "不是占卜，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 127270,
      "end_ms": 127990,
      "text": "不是预言，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 128210,
      "end_ms": 129650,
      "text": "不是用卦象给人算命，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 129850,
      "end_ms": 132010,
      "text": "是一种认知方式和立法。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 132210,
      "end_ms": 134810,
      "text": "天文学、历史学并列的认知方式，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 134930,
      "end_ms": 138460,
      "text": "它使用和其他学科相同的理性工具观察推演，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 138600,
      "end_ms": 139765,
      "text": "验证、系统化。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 140030,
      "end_ms": 141315,
      "text": "这听上去像是常识，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 141640,
      "end_ms": 142545,
      "text": "但你仔细想想，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 142910,
      "end_ms": 145070,
      "text": "我们这代人从小被灌输的是象术，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 145070,
      "end_ms": 145670,
      "text": "是迷信，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 145910,
      "end_ms": 147085,
      "text": "毅力才是哲学。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 147450,
      "end_ms": 148130,
      "text": "言下之意，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 148230,
      "end_ms": 149750,
      "text": "前者只需要掐指一算，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 149930,
      "end_ms": 151250,
      "text": "后者才需要动脑子。"
    },
    {
      "segment_id": "s000066",
      "start_ms": 151250,
      "end_ms": 155955,
      "text": "这套话语的隐蔽暴力在于他先把项数学从理性讨论的房间里赶出去，"
    },
    {
      "segment_id": "s000067",
      "start_ms": 156210,
      "end_ms": 158135,
      "text": "然后嘲笑房间里没有橡树。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 158520,
      "end_ms": 161140,
      "text": "邵庸说不他的黄籍经世书，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 161300,
      "end_ms": 163345,
      "text": "以元金会以汇京韵，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 163590,
      "end_ms": 164305,
      "text": "以蕴惊世。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 164650,
      "end_ms": 166785,
      "text": "它使用的是一种严格的数学体系。"
    },
    {
      "segment_id": "s000072",
      "start_ms": 167160,
      "end_ms": 168320,
      "text": "一元捅十二会，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 168520,
      "end_ms": 170490,
      "text": "一会捅三十运一运统，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 170490,
      "end_ms": 172375,
      "text": "十二式一世统三十年，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 172690,
      "end_ms": 175335,
      "text": "一元之数为十二万九千六百年。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 175570,
      "end_ms": 176985,
      "text": "这不是随口编造的数字，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 177300,
      "end_ms": 180660,
      "text": "而是取法一年十二月一月三十日一日，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 180660,
      "end_ms": 182120,
      "text": "十二时辰的自然节律，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 182200,
      "end_ms": 185405,
      "text": "用天文历法的逻辑建构人类历史的认知框架。"
    },
    {
      "segment_id": "s000080",
      "start_ms": 185680,
      "end_ms": 187555,
      "text": "这是一个隐居三十年的观察者，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 187790,
      "end_ms": 189150,
      "text": "用他受过训练的思维，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 189290,
      "end_ms": 192630,
      "text": "重新审视一个被儒家正统驱逐出理性领地。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 192650,
      "end_ms": 196480,
      "text": "近千年的学科像素不要求你先信他，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 196480,
      "end_ms": 197375,
      "text": "要求你先算，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 197960,
      "end_ms": 199345,
      "text": "他不要求你接受结论，"
    },
    {
      "segment_id": "s000086",
      "start_ms": 199600,
      "end_ms": 201275,
      "text": "他要求你理解推演，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 201730,
      "end_ms": 202755,
      "text": "理解不等于认同。"
    },
    {
      "segment_id": "s000088",
      "start_ms": 203170,
      "end_ms": 204630,
      "text": "你可以理解一个推演体系，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 204730,
      "end_ms": 206105,
      "text": "同时拒绝他的结论。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 206570,
      "end_ms": 207530,
      "text": "像数学也一样，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 207770,
      "end_ms": 209495,
      "text": "它首先是一个认知对象，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 209830,
      "end_ms": 211585,
      "text": "然后才是一个立场选择。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 211930,
      "end_ms": 212350,
      "text": "第二层，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 212350,
      "end_ms": 213680,
      "text": "颠覆历史，"
    },
    {
      "segment_id": "s000095",
      "start_ms": 213680,
      "end_ms": 215080,
      "text": "不是偶然事件的堆积，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 215360,
      "end_ms": 217285,
      "text": "是有周期节律的认知对象。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 217680,
      "end_ms": 219460,
      "text": "我们这代人从小被灌输历史，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 219460,
      "end_ms": 220265,
      "text": "是偶然的，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 220530,
      "end_ms": 222775,
      "text": "是英雄和事件编织的随机叙事。"
    },
    {
      "segment_id": "s000100",
      "start_ms": 223490,
      "end_ms": 224590,
      "text": "所谓历史周期率，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 224670,
      "end_ms": 226255,
      "text": "不过是事后总结的复会。"
    },
    {
      "segment_id": "s000102",
      "start_ms": 227020,
      "end_ms": 227240,
      "text": "所以，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 227240,
      "end_ms": 229260,
      "text": "当一个人说缘会运势时，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 229400,
      "end_ms": 235160,
      "text": "大家会下意识觉得他在算命黄籍经世书用一整套数理体系砸碎了这套认知。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 235380,
      "end_ms": 235995,
      "text": "邵雍说，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 236400,
      "end_ms": 237680,
      "text": "所谓历史无规律，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 237840,
      "end_ms": 240340,
      "text": "本身就是一个需要被审视的哲学立场，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 240440,
      "end_ms": 241935,
      "text": "而不是一个自明的真理。"
    },
    {
      "segment_id": "s000109",
      "start_ms": 242270,
      "end_ms": 244250,
      "text": "你把偶然和必然放在天平两端，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 244510,
      "end_ms": 247925,
      "text": "但你从来没有问过这两个东西真的在同一个层面上吗？"
    },
    {
      "segment_id": "s000111",
      "start_ms": 248440,
      "end_ms": 249935,
      "text": "他提出了一个关键区分，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 250370,
      "end_ms": 252545,
      "text": "缘会运势不是历史的预言，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 252900,
      "end_ms": 253960,
      "text": "是历史的标尺。"
    },
    {
      "segment_id": "s000114",
      "start_ms": 254080,
      "end_ms": 256805,
      "text": "你无法用一根尺子去证明这条河流向东方。"
    },
    {
      "segment_id": "s000115",
      "start_ms": 257070,
      "end_ms": 258210,
      "text": "但你不是因为这个原因，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 258210,
      "end_ms": 259415,
      "text": "就说尺子没有意义。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 259760,
      "end_ms": 262205,
      "text": "尺子的价值不在于决定河流的走向，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 262590,
      "end_ms": 265170,
      "text": "而在于让你知道河流在哪里走了多远，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 265430,
      "end_ms": 267600,
      "text": "还剩多长元会。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 267600,
      "end_ms": 270200,
      "text": "运势的意义不在于预测朝代何时灭亡，"
    },
    {
      "segment_id": "s000121",
      "start_ms": 270520,
      "end_ms": 274100,
      "text": "而在于为人类历史提供一个可比较可参照的时间。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 274100,
      "end_ms": 275560,
      "text": "坐标邵雍进一步说，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 275880,
      "end_ms": 276880,
      "text": "所有历史认知，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 277000,
      "end_ms": 281330,
      "text": "包括现代历史学都建立在某些无法被完全证明的先决。"
    },
    {
      "segment_id": "s000125",
      "start_ms": 281350,
      "end_ms": 284370,
      "text": "假设上历史学家假设人类行为有模式可循，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 284710,
      "end_ms": 286475,
      "text": "假设因果关系可以被追溯，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 286720,
      "end_ms": 288660,
      "text": "假设证据的可靠性可以被评估。"
    },
    {
      "segment_id": "s000128",
      "start_ms": 288900,
      "end_ms": 290805,
      "text": "这些假设本身无法被实验证明，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 291040,
      "end_ms": 293295,
      "text": "但他们是历史学能够运作的前提。"
    },
    {
      "segment_id": "s000130",
      "start_ms": 293780,
      "end_ms": 294520,
      "text": "你信仰历史，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 294520,
      "end_ms": 297285,
      "text": "可以理解和你信仰历史有数立节律，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 297510,
      "end_ms": 299275,
      "text": "在认知结构上没有本质区别。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 299690,
      "end_ms": 302830,
      "text": "区别只在于后者把问题推到了更深的层面。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 302890,
      "end_ms": 304390,
      "text": "你总说历史是偶然的，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 304430,
      "end_ms": 305290,
      "text": "可你凭什么？"
    },
    {
      "segment_id": "s000136",
      "start_ms": 305290,
      "end_ms": 307070,
      "text": "你观察到某些事件无法预测，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 307170,
      "end_ms": 308810,
      "text": "是因为你用的是短期尺度，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 309030,
      "end_ms": 310310,
      "text": "用短期尺度观察，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 310350,
      "end_ms": 311870,
      "text": "自然看不到长期节律。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 312290,
      "end_ms": 314430,
      "text": "这个循环不是历史学家的耻辱，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 314670,
      "end_ms": 316410,
      "text": "而是所有认知的起点。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 316990,
      "end_ms": 319050,
      "text": "邵雍不是要否定历史的复杂性，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 319370,
      "end_ms": 320310,
      "text": "他是要告诉你，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 320470,
      "end_ms": 322270,
      "text": "历史学也有认知前提，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 322570,
      "end_ms": 323650,
      "text": "只是它不叫信仰，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 323770,
      "end_ms": 324570,
      "text": "叫方法论。"
    },
    {
      "segment_id": "s000147",
      "start_ms": 324570,
      "end_ms": 324970,
      "text": "假设。"
    },
    {
      "segment_id": "s000148",
      "start_ms": 325310,
      "end_ms": 328930,
      "text": "而黄籍经世书要做的是把这些假设也拿到桌面上，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 328990,
      "end_ms": 329435,
      "text": "问一句，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 329820,
      "end_ms": 330920,
      "text": "他们为什么成立？"
    },
    {
      "segment_id": "s000151",
      "start_ms": 331160,
      "end_ms": 332440,
      "text": "他们能承受多少？"
    },
    {
      "segment_id": "s000152",
      "start_ms": 332440,
      "end_ms": 336560,
      "text": "追问第三层颠覆观物的工具不是主观体验，"
    },
    {
      "segment_id": "s000153",
      "start_ms": 336740,
      "end_ms": 338720,
      "text": "是以物观物主流认知。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 338720,
      "end_ms": 339140,
      "text": "告诉你，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 339140,
      "end_ms": 339600,
      "text": "要么信，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 339620,
      "end_ms": 341220,
      "text": "要么不信信就是盲从，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 341360,
      "end_ms": 342360,
      "text": "不信就是清醒。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 343400,
      "end_ms": 344760,
      "text": "彻套模式的潜台词是，"
    },
    {
      "segment_id": "s000159",
      "start_ms": 345060,
      "end_ms": 347680,
      "text": "像数学只在迷信的前提下才有意义，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 347960,
      "end_ms": 349780,
      "text": "理性的人根本不需要了解他，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 350140,
      "end_ms": 352240,
      "text": "但邵雍说这是错的。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 352860,
      "end_ms": 355880,
      "text": "他建立了一套被称为以物观物的认识论框架，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 356160,
      "end_ms": 357800,
      "text": "彻底扭转了认知的方式。"
    },
    {
      "segment_id": "s000164",
      "start_ms": 358400,
      "end_ms": 359790,
      "text": "观物片里有一段对话话，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 360150,
      "end_ms": 361115,
      "text": "愚者问巧者，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 361520,
      "end_ms": 363605,
      "text": "子之观天地万物之道乎，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 364230,
      "end_ms": 366325,
      "text": "然后给出了一个石破天惊的定义。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 366870,
      "end_ms": 368450,
      "text": "夫所以谓之观务者，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 368690,
      "end_ms": 370135,
      "text": "非以木观之也，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 370570,
      "end_ms": 371550,
      "text": "非观之以目，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 371610,
      "end_ms": 373095,
      "text": "而观之以心也，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 373540,
      "end_ms": 374460,
      "text": "非观之以心，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 374680,
      "end_ms": 376205,
      "text": "而观之以礼也。"
    },
    {
      "segment_id": "s000174",
      "start_ms": 376610,
      "end_ms": 377845,
      "text": "什么叫以物观物？"
    },
    {
      "segment_id": "s000175",
      "start_ms": 378260,
      "end_ms": 378760,
      "text": "简单说，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 379000,
      "end_ms": 382500,
      "text": "存在一个真实的独立于我们主观成见之外的世界，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 382600,
      "end_ms": 387255,
      "text": "但我们无法完全精确的捕捉它所有的认知都是反观的。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 387700,
      "end_ms": 389100,
      "text": "我们尽力描述真实，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 389380,
      "end_ms": 391545,
      "text": "但永远知道自己描述的是有限的。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 392030,
      "end_ms": 393530,
      "text": "以目观之见表象，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 393750,
      "end_ms": 394850,
      "text": "以心观之一，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 394850,
      "end_ms": 395310,
      "text": "扭曲。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 395550,
      "end_ms": 396430,
      "text": "以礼观之，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 396590,
      "end_ms": 397505,
      "text": "尽本真。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 397990,
      "end_ms": 400015,
      "text": "邵雍走了一条更彻底的路。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 400310,
      "end_ms": 400835,
      "text": "他说，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 401250,
      "end_ms": 402495,
      "text": "不以我观物者。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 402860,
      "end_ms": 404365,
      "text": "以物观物之谓也，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 404780,
      "end_ms": 405860,
      "text": "既能以物观物，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 406180,
      "end_ms": 408305,
      "text": "又安有我于其间哉。"
    },
    {
      "segment_id": "s000191",
      "start_ms": 409170,
      "end_ms": 410885,
      "text": "然后他给出了一个关键区分，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 411320,
      "end_ms": 415465,
      "text": "以物观物性也以我观物情也。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 416060,
      "end_ms": 417480,
      "text": "信公而明情，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 417540,
      "end_ms": 418385,
      "text": "偏而暗。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 418770,
      "end_ms": 420450,
      "text": "以自己的主观立场去观察，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 420710,
      "end_ms": 423015,
      "text": "看到的是扭曲的、偏暗的画面。"
    },
    {
      "segment_id": "s000197",
      "start_ms": 423430,
      "end_ms": 425270,
      "text": "从事物本身的逻辑出发去观察，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 425530,
      "end_ms": 428165,
      "text": "看到的才是公正的、明亮的真相。"
    },
    {
      "segment_id": "s000199",
      "start_ms": 428620,
      "end_ms": 432465,
      "text": "这套方法的核心是你不能因为一个认知不完美就把它扔掉，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 432740,
      "end_ms": 433900,
      "text": "也不能因为它有用，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 433900,
      "end_ms": 434925,
      "text": "就把它绝对化。"
    },
    {
      "segment_id": "s000202",
      "start_ms": 435500,
      "end_ms": 436985,
      "text": "每一次认知都是后验的，"
    },
    {
      "segment_id": "s000203",
      "start_ms": 437520,
      "end_ms": 438965,
      "text": "先观察再理解，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 439210,
      "end_ms": 440475,
      "text": "根据证据调整立场，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 441140,
      "end_ms": 443155,
      "text": "这和科学方法在逻辑上是一致的。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 443370,
      "end_ms": 445425,
      "text": "提出假设观察、修正，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 445650,
      "end_ms": 448245,
      "text": "再观察邵庸反对两种极端，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 448720,
      "end_ms": 450535,
      "text": "一是以我观物的傲慢，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 451000,
      "end_ms": 453015,
      "text": "以为自己的立场就是绝对真理。"
    },
    {
      "segment_id": "s000210",
      "start_ms": 453420,
      "end_ms": 454925,
      "text": "二是相对主义的投降，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 455320,
      "end_ms": 457425,
      "text": "以为没有一种描述比另一种更好。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 458090,
      "end_ms": 459995,
      "text": "以物观物走的是第三条路，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 460330,
      "end_ms": 461190,
      "text": "认真的观察。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 461450,
      "end_ms": 461750,
      "text": "同时，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 461750,
      "end_ms": 464690,
      "text": "谦卑的知道自己的视角是有限的这套逻辑，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 464690,
      "end_ms": 466630,
      "text": "彻底取消了信的人没脑子，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 466630,
      "end_ms": 467750,
      "text": "不信的人才有理性。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 467750,
      "end_ms": 468715,
      "text": "这个伪选择题，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 469280,
      "end_ms": 471380,
      "text": "邵雍把认识论工具用在历史哲学。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 471380,
      "end_ms": 473480,
      "text": "上元慧运势的语言不是数学语言，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 473480,
      "end_ms": 474365,
      "text": "不是实验报告，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 474690,
      "end_ms": 476875,
      "text": "它包含类比象中推演，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 477190,
      "end_ms": 478055,
      "text": "但这不是缺陷，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 478420,
      "end_ms": 480540,
      "text": "这是面对超长时段历史时的认知。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 480540,
      "end_ms": 481000,
      "text": "诚实，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 481200,
      "end_ms": 482980,
      "text": "你不能用测量一天温度的方式，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 482980,
      "end_ms": 484495,
      "text": "测量一百年的气候变迁。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 484870,
      "end_ms": 487375,
      "text": "但你也不能因为温度计测不出一百年的气候，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 487600,
      "end_ms": 488615,
      "text": "就说气候不存在。"
    },
    {
      "segment_id": "s000230",
      "start_ms": 489320,
      "end_ms": 491060,
      "text": "第四层颠覆橡术，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 491100,
      "end_ms": 492255,
      "text": "不是术士的私产，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 492470,
      "end_ms": 493435,
      "text": "是公共知识。"
    },
    {
      "segment_id": "s000233",
      "start_ms": 493900,
      "end_ms": 495340,
      "text": "市面上关于邵雍的讨论，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 495360,
      "end_ms": 498055,
      "text": "百分之九十九都集中在他算的准不准这个层面，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 498420,
      "end_ms": 498820,
      "text": "你信不信？"
    },
    {
      "segment_id": "s000236",
      "start_ms": 498820,
      "end_ms": 499735,
      "text": "那是你自己的事儿，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 499960,
      "end_ms": 501565,
      "text": "别人信不信和你没关系。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 502430,
      "end_ms": 503735,
      "text": "这套模式的潜台词是，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 504080,
      "end_ms": 505460,
      "text": "像数学是主观的，"
    },
    {
      "segment_id": "s000240",
      "start_ms": 505480,
      "end_ms": 507635,
      "text": "不需要也不应该被理性审视。"
    },
    {
      "segment_id": "s000241",
      "start_ms": 507980,
      "end_ms": 508920,
      "text": "黄吉金师叔说，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 509260,
      "end_ms": 509945,
      "text": "你错了。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 510580,
      "end_ms": 512560,
      "text": "项数学从来不是私人事务，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 512660,
      "end_ms": 515485,
      "text": "它涉及的是一系列可以被公开讨论的命题。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 515820,
      "end_ms": 517025,
      "text": "历史是否有方向？"
    },
    {
      "segment_id": "s000246",
      "start_ms": 517380,
      "end_ms": 518975,
      "text": "文明的兴衰是否有节律？"
    },
    {
      "segment_id": "s000247",
      "start_ms": 519260,
      "end_ms": 521455,
      "text": "人类在宇宙中的位置是否有结构？"
    },
    {
      "segment_id": "s000248",
      "start_ms": 521800,
      "end_ms": 523735,
      "text": "这些问题和你信不信无关，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 524080,
      "end_ms": 525905,
      "text": "他们是人类共同面对的问题。"
    },
    {
      "segment_id": "s000250",
      "start_ms": 526320,
      "end_ms": 528995,
      "text": "邵雍把项数学放回公共讨论的领域，"
    },
    {
      "segment_id": "s000251",
      "start_ms": 529400,
      "end_ms": 530740,
      "text": "他是在漫长的历史中，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 530940,
      "end_ms": 535020,
      "text": "无数人用观察、推演和对话积累起来的认知传统。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 535020,
      "end_ms": 538205,
      "text": "他建构了从帝窑到五代的完整历史年表，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 538500,
      "end_ms": 541235,
      "text": "将每个时代的兴衰纳入可比较的框架。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 541730,
      "end_ms": 543275,
      "text": "他不是让你接受什么，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 543550,
      "end_ms": 544935,
      "text": "他是让你理解什么，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 545160,
      "end_ms": 546860,
      "text": "理解一个认知体系如何形成，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 547140,
      "end_ms": 548520,
      "text": "如何在推演中演变，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 548740,
      "end_ms": 551045,
      "text": "如何在不同的时代提出不同的解释。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 551490,
      "end_ms": 554855,
      "text": "这套方法论把项数学从竖式的抽屉里拿出来，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 555090,
      "end_ms": 556670,
      "text": "放在公共知识的长桌上。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 556730,
      "end_ms": 558995,
      "text": "你不必是橡数学的信奉者才能理解他。"
    },
    {
      "segment_id": "s000263",
      "start_ms": 559220,
      "end_ms": 561535,
      "text": "就像你不必是物理学家才能理解相对论，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 561930,
      "end_ms": 564405,
      "text": "你需要的只是好奇心和思考的意愿。"
    },
    {
      "segment_id": "s000265",
      "start_ms": 564980,
      "end_ms": 566975,
      "text": "公共知识不等于强制共识，"
    },
    {
      "segment_id": "s000266",
      "start_ms": 567360,
      "end_ms": 569990,
      "text": "它意味着可讨论、可批评、可修正。"
    },
    {
      "segment_id": "s000267",
      "start_ms": 570330,
      "end_ms": 571770,
      "text": "像数学在公共领域，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 571790,
      "end_ms": 575710,
      "text": "要接受历史学、天文学、哲学、伦理学的交叉检验。"
    },
    {
      "segment_id": "s000269",
      "start_ms": 575790,
      "end_ms": 577450,
      "text": "它不能躲在这是术数后面，"
    },
    {
      "segment_id": "s000270",
      "start_ms": 577450,
      "end_ms": 578145,
      "text": "拒绝提问，"
    },
    {
      "segment_id": "s000271",
      "start_ms": 578400,
      "end_ms": 579540,
      "text": "也不能因为被提问，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 579540,
      "end_ms": 580625,
      "text": "就觉得自己被冒犯。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 581070,
      "end_ms": 584395,
      "text": "邵雍的态度是来问把最难的问题拿来。"
    },
    {
      "segment_id": "s000274",
      "start_ms": 584810,
      "end_ms": 586675,
      "text": "如果这套传统连问题都经不起，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 586910,
      "end_ms": 588315,
      "text": "他就不配被称为传统。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 588900,
      "end_ms": 590080,
      "text": "如果他经得起他，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 590080,
      "end_ms": 592195,
      "text": "就不需要靠不可追问来存活。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 592440,
      "end_ms": 592900,
      "text": "第五层，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 592900,
      "end_ms": 597040,
      "text": "颠覆学会黄籍经事书唯一的终点是让你离开，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 597140,
      "end_ms": 598845,
      "text": "信不信这个伪命题。"
    },
    {
      "segment_id": "s000281",
      "start_ms": 599200,
      "end_ms": 599700,
      "text": "读到这里，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 599700,
      "end_ms": 600355,
      "text": "你可能想问，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 600820,
      "end_ms": 604195,
      "text": "说了这么多最终目标不还是让人相信像数学吗？"
    },
    {
      "segment_id": "s000284",
      "start_ms": 604980,
      "end_ms": 606440,
      "text": "邵雍自己就是相书家，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 606500,
      "end_ms": 608015,
      "text": "他写书不就是在传教。"
    },
    {
      "segment_id": "s000286",
      "start_ms": 608330,
      "end_ms": 608910,
      "text": "如果你这样，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 608910,
      "end_ms": 610210,
      "text": "想你就掉进了这本书，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 610210,
      "end_ms": 611410,
      "text": "埋了一千年的陷阱。"
    },
    {
      "segment_id": "s000289",
      "start_ms": 611790,
      "end_ms": 616490,
      "text": "邵雍用一生证明的不是相术和义理可以共存这个廉价的和解口号，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 617090,
      "end_ms": 618950,
      "text": "而是相术和义理的冲突，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 618990,
      "end_ms": 621770,
      "text": "本身就是一个被制造出来的叙事。"
    },
    {
      "segment_id": "s000292",
      "start_ms": 622530,
      "end_ms": 624030,
      "text": "他最大的颠覆不是立场，"
    },
    {
      "segment_id": "s000293",
      "start_ms": 624250,
      "end_ms": 624930,
      "text": "是方法。"
    },
    {
      "segment_id": "s000294",
      "start_ms": 625410,
      "end_ms": 628710,
      "text": "他在书里反复展示的是我写的是一套推演体系，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 628850,
      "end_ms": 630150,
      "text": "不是一套信仰告白。"
    },
    {
      "segment_id": "s000296",
      "start_ms": 630410,
      "end_ms": 632530,
      "text": "我的任务不是让你同意某个结论，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 632750,
      "end_ms": 634990,
      "text": "是让你有能力评估所有结论。"
    },
    {
      "segment_id": "s000298",
      "start_ms": 635090,
      "end_ms": 637270,
      "text": "他把从帝窑到五代的兴衰拆开，"
    },
    {
      "segment_id": "s000299",
      "start_ms": 637570,
      "end_ms": 639080,
      "text": "让你看每个判断的骨骼。"
    },
    {
      "segment_id": "s000300",
      "start_ms": 639660,
      "end_ms": 642200,
      "text": "然后他退后一步说你自己判断，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 642620,
      "end_ms": 643640,
      "text": "因为他太清楚。"
    },
    {
      "segment_id": "s000302",
      "start_ms": 643880,
      "end_ms": 645020,
      "text": "在历史的认知中，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 645200,
      "end_ms": 646640,
      "text": "最稀缺的不是答案，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 646820,
      "end_ms": 648480,
      "text": "是问出好问题的能力。"
    },
    {
      "segment_id": "s000305",
      "start_ms": 648740,
      "end_ms": 651180,
      "text": "你不需要在信和不信之间做选择，"
    },
    {
      "segment_id": "s000306",
      "start_ms": 651480,
      "end_ms": 654040,
      "text": "你需要先搞清楚你选择的是什么？"
    },
    {
      "segment_id": "s000307",
      "start_ms": 654500,
      "end_ms": 656500,
      "text": "是那个被正统儒家批判的术数，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 657040,
      "end_ms": 658960,
      "text": "是那个被术士简化的算命工具，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 659160,
      "end_ms": 662660,
      "text": "还是一个有严密树立推演支撑的复杂认知体系？"
    },
    {
      "segment_id": "s000310",
      "start_ms": 663100,
      "end_ms": 667280,
      "text": "邵雍实际上在说好的体系不给你答案给你地图，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 667580,
      "end_ms": 669970,
      "text": "地图的价值不在于告诉你该去哪里，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 670170,
      "end_ms": 671845,
      "text": "而在于让你知道你站在哪里。"
    },
    {
      "segment_id": "s000313",
      "start_ms": 672270,
      "end_ms": 679690,
      "text": "所以你看这本书最惊世骇俗的答案藏在这里学习黄籍经十书最大的收获不是获得了某种预测能力，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 679830,
      "end_ms": 682995,
      "text": "而是获得了一种在复杂问题面前不慌张的能力。"
    },
    {
      "segment_id": "s000315",
      "start_ms": 683440,
      "end_ms": 684400,
      "text": "你不必急于表态，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 684720,
      "end_ms": 686965,
      "text": "你有能力理解一个推演体系的质地。"
    },
    {
      "segment_id": "s000317",
      "start_ms": 687180,
      "end_ms": 689035,
      "text": "你有耐心等待认知的成熟。"
    },
    {
      "segment_id": "s000318",
      "start_ms": 689440,
      "end_ms": 690905,
      "text": "你不需要被所有人说服，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 691160,
      "end_ms": 693505,
      "text": "你只需要在独处时对自己的判断负责。"
    },
    {
      "segment_id": "s000320",
      "start_ms": 693890,
      "end_ms": 694990,
      "text": "读完黄记经世书，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 695190,
      "end_ms": 697105,
      "text": "你可能发现书名起错了。"
    },
    {
      "segment_id": "s000322",
      "start_ms": 697840,
      "end_ms": 699000,
      "text": "这不是一本预言书，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 699300,
      "end_ms": 702020,
      "text": "是一本关于人如何在有限的生命中，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 702120,
      "end_ms": 704275,
      "text": "面对无限的时间的哲学手记。"
    },
    {
      "segment_id": "s000325",
      "start_ms": 704630,
      "end_ms": 706355,
      "text": "邵雍的影视身份不是重点，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 706580,
      "end_ms": 708385,
      "text": "北宋武子的头衔不是重点，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 708610,
      "end_ms": 710970,
      "text": "元会运势的数字也不是重点，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 711110,
      "end_ms": 714170,
      "text": "重点是那个在洛阳安乐窝里做了三十年的观察者，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 714450,
      "end_ms": 717295,
      "text": "面对一个被学术世界判了认知死刑的领域，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 717600,
      "end_ms": 719285,
      "text": "说我不服从偏见，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 719610,
      "end_ms": 721315,
      "text": "我只服从我看见的秩序。"
    },
    {
      "segment_id": "s000332",
      "start_ms": 721610,
      "end_ms": 722475,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000333",
      "start_ms": 722990,
      "end_ms": 725245,
      "text": "他看见橡数学不是毅力的敌人，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 725480,
      "end_ms": 726700,
      "text": "不是术士的私产，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 726900,
      "end_ms": 729120,
      "text": "不是需要被拯救或抛弃的遗产。"
    },
    {
      "segment_id": "s000336",
      "start_ms": 729180,
      "end_ms": 730175,
      "text": "它是一面镜子，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 730470,
      "end_ms": 733125,
      "text": "映照出人类在时间中最根本的处境。"
    },
    {
      "segment_id": "s000338",
      "start_ms": 733570,
      "end_ms": 734765,
      "text": "我们活在一个瞬间，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 735150,
      "end_ms": 736475,
      "text": "我们试图理解永恒，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 736870,
      "end_ms": 738995,
      "text": "而我们必须在短暂中做出判断。"
    },
    {
      "segment_id": "s000341",
      "start_ms": 739340,
      "end_ms": 743795,
      "text": "这本书最后有一段话是邵雍在观物篇中借愚者之口说的。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 744530,
      "end_ms": 745495,
      "text": "我想把它留给你，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 746380,
      "end_ms": 750000,
      "text": "六物惧而得余者人也俱六物。"
    },
    {
      "segment_id": "s000344",
      "start_ms": 750020,
      "end_ms": 753600,
      "text": "而所以得余者非人也是之六，"
    },
    {
      "segment_id": "s000345",
      "start_ms": 753600,
      "end_ms": 756360,
      "text": "恶者人也得与与，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 756360,
      "end_ms": 758210,
      "text": "不得与者天眼。"
    },
    {
      "segment_id": "s000347",
      "start_ms": 758650,
      "end_ms": 760095,
      "text": "你把六样工具都准备好了，"
    },
    {
      "segment_id": "s000348",
      "start_ms": 760450,
      "end_ms": 761330,
      "text": "能不能钓到鱼，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 761470,
      "end_ms": 762725,
      "text": "不全是你能决定的。"
    },
    {
      "segment_id": "s000350",
      "start_ms": 763350,
      "end_ms": 765105,
      "text": "但如果你六样工具都没准备好，"
    },
    {
      "segment_id": "s000351",
      "start_ms": 765400,
      "end_ms": 767040,
      "text": "你连钓到鱼的可能性都没有。"
    },
    {
      "segment_id": "s000352",
      "start_ms": 767180,
      "end_ms": 768880,
      "text": "六样工具是你的认知框架，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 769080,
      "end_ms": 770360,
      "text": "鱼是历史的真相，"
    },
    {
      "segment_id": "s000354",
      "start_ms": 770440,
      "end_ms": 771435,
      "text": "你准备好框架，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 771820,
      "end_ms": 773845,
      "text": "真相可能来可能不来。"
    },
    {
      "segment_id": "s000356",
      "start_ms": 774280,
      "end_ms": 775315,
      "text": "但你不准备框架，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 775720,
      "end_ms": 776940,
      "text": "真相永远不会来。"
    },
    {
      "segment_id": "s000358",
      "start_ms": 777100,
      "end_ms": 779180,
      "text": "最后我想认真推荐一次这本书。"
    },
    {
      "segment_id": "s000359",
      "start_ms": 779200,
      "end_ms": 780655,
      "text": "如果你看到这里还没有划走，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 780970,
      "end_ms": 783130,
      "text": "说明你心里有一个问题一直没有被回答。"
    },
    {
      "segment_id": "s000361",
      "start_ms": 783270,
      "end_ms": 786530,
      "text": "我们到底该怎么面对那些理性无法完全推演，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 786690,
      "end_ms": 788790,
      "text": "却又无法被简单否定的事情？"
    },
    {
      "segment_id": "s000363",
      "start_ms": 788810,
      "end_ms": 791145,
      "text": "黄集金世书就是为这个问题写的，"
    },
    {
      "segment_id": "s000364",
      "start_ms": 791290,
      "end_ms": 792455,
      "text": "他不是让你信什么，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 792850,
      "end_ms": 797035,
      "text": "它是让你看见橡树和一里之间那片被我们粗暴踩平的地带。"
    },
    {
      "segment_id": "s000366",
      "start_ms": 797390,
      "end_ms": 798610,
      "text": "你们看到这个版本的解读，"
    },
    {
      "segment_id": "s000367",
      "start_ms": 798830,
      "end_ms": 800265,
      "text": "文案优化了不下五次。"
    },
    {
      "segment_id": "s000368",
      "start_ms": 800520,
      "end_ms": 801940,
      "text": "第一版像论文第二版，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 801940,
      "end_ms": 803250,
      "text": "像鸡汤第三版，"
    },
    {
      "segment_id": "s000370",
      "start_ms": 803250,
      "end_ms": 805020,
      "text": "用科学压象树第四版，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 805020,
      "end_ms": 807400,
      "text": "用橡素压科学到第五版才明白，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 807500,
      "end_ms": 809460,
      "text": "真正的解读是把你送到书面前，"
    },
    {
      "segment_id": "s000373",
      "start_ms": 809580,
      "end_ms": 810295,
      "text": "然后闭嘴。"
    },
    {
      "segment_id": "s000374",
      "start_ms": 810670,
      "end_ms": 814100,
      "text": "由于平台规则有些细节无法展开哪些细节，"
    }
  ],
  "source_transcript_sha256": "c87fd7645398ac67201dc94c7828d23a1912a1a3cfbc0c31f11b0b63cb922bd2"
}