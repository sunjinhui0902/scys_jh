{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_535debe3daf9d6d8_u001",
  "video_id": "v_535debe3daf9d6d8",
  "account": "闲不住De宝",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 557.14,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 70,
      "end_ms": 2870,
      "text": "您知道故宫里最震撼人的是什么吗？"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2910,
      "end_ms": 6210,
      "text": "有人说是清明上河图五米多长，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6210,
      "end_ms": 7830,
      "text": "画了八百多个人。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7830,
      "end_ms": 9770,
      "text": "有人说是翠玉白菜雕的，"
    },
    {
      "segment_id": "s000005",
      "start_ms": 9770,
      "end_ms": 11350,
      "text": "跟真白菜一样，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 11490,
      "end_ms": 13250,
      "text": "虫子都能骗过去。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 13290,
      "end_ms": 14030,
      "text": "错了，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 14070,
      "end_ms": 16550,
      "text": "清明上河图只是画的细。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 16610,
      "end_ms": 19550,
      "text": "翠玉白菜不过是块巧雕的玉，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 20110,
      "end_ms": 22970,
      "text": "真正震撼的是那些人做出来，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 23510,
      "end_ms": 26090,
      "text": "但看着像老天爷做的东西，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 26090,
      "end_ms": 28310,
      "text": "一层漆刷上百遍，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 28310,
      "end_ms": 32260,
      "text": "但完要去要几个月一幅画织三年，"
    },
    {
      "segment_id": "s000014",
      "start_ms": 33220,
      "end_ms": 34600,
      "text": "织完人都老了。"
    },
    {
      "segment_id": "s000015",
      "start_ms": 34680,
      "end_ms": 38180,
      "text": "三千年前的青铜器拆了还能装回去。"
    },
    {
      "segment_id": "s000016",
      "start_ms": 38780,
      "end_ms": 42080,
      "text": "今天咱们就来盘点故宫里十件人做出来，"
    },
    {
      "segment_id": "s000017",
      "start_ms": 42560,
      "end_ms": 44640,
      "text": "但看着像老天爷做的宝贝，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 45240,
      "end_ms": 48780,
      "text": "每一件都代表了老祖宗手艺的天花板，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 49200,
      "end_ms": 53320,
      "text": "每一件后人想仿很难仿到位。"
    },
    {
      "segment_id": "s000020",
      "start_ms": 54300,
      "end_ms": 59315,
      "text": "每十名章程造款雕漆云纹盘。"
    },
    {
      "segment_id": "s000021",
      "start_ms": 60240,
      "end_ms": 63195,
      "text": "元代有一个叫张程的七七大师，"
    },
    {
      "segment_id": "s000022",
      "start_ms": 63940,
      "end_ms": 65525,
      "text": "做涕宏出名。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 66990,
      "end_ms": 67935,
      "text": "什么叫涕红？"
    },
    {
      "segment_id": "s000024",
      "start_ms": 68400,
      "end_ms": 69700,
      "text": "就是在木头上刷红，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 69700,
      "end_ms": 71715,
      "text": "漆刷到足够厚，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 72510,
      "end_ms": 75350,
      "text": "再用刀一刀一刀把花纹踢出来，"
    },
    {
      "segment_id": "s000027",
      "start_ms": 75410,
      "end_ms": 77005,
      "text": "您知道要刷多少层吗？"
    },
    {
      "segment_id": "s000028",
      "start_ms": 77690,
      "end_ms": 79110,
      "text": "少则八九十层，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 79330,
      "end_ms": 80385,
      "text": "多则上百层，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 80830,
      "end_ms": 82370,
      "text": "每一层都要等前一层，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 82370,
      "end_ms": 84215,
      "text": "干透了才能刷下一层。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 84980,
      "end_ms": 88025,
      "text": "刷完一百层少说也要几个月。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 88530,
      "end_ms": 91185,
      "text": "章程有一件传世的剃息盘，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 91990,
      "end_ms": 95945,
      "text": "刀口断面上露出了四道朱红色的漆限，"
    },
    {
      "segment_id": "s000035",
      "start_ms": 96810,
      "end_ms": 98745,
      "text": "古籍里叫无间诛县，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 99390,
      "end_ms": 101755,
      "text": "黑色的漆里夹着红色的线，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 102430,
      "end_ms": 104645,
      "text": "像墨里藏了一条红丝带。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 105240,
      "end_ms": 107685,
      "text": "传说张成晚年眼睛不太好使了，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 108050,
      "end_ms": 110405,
      "text": "徒弟问他怎么还能标的这么准。"
    },
    {
      "segment_id": "s000040",
      "start_ms": 111330,
      "end_ms": 112410,
      "text": "他摸着盘子说，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 112510,
      "end_ms": 113625,
      "text": "手比眼睛准，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 114610,
      "end_ms": 116070,
      "text": "这辈子摸过几万，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 116070,
      "end_ms": 117210,
      "text": "刀闭着眼，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 117210,
      "end_ms": 118675,
      "text": "都知道该往哪儿走。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 119210,
      "end_ms": 122140,
      "text": "刀一件盘子刷上百层，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 122140,
      "end_ms": 123715,
      "text": "漆雕上千刀，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 124050,
      "end_ms": 125385,
      "text": "您说这手艺绝不绝。"
    },
    {
      "segment_id": "s000048",
      "start_ms": 127220,
      "end_ms": 128055,
      "text": "聊到这儿，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 128430,
      "end_ms": 130455,
      "text": "先在评论区打出四个字，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 130850,
      "end_ms": 132065,
      "text": "巧夺天工，"
    },
    {
      "segment_id": "s000051",
      "start_ms": 132470,
      "end_ms": 133895,
      "text": "打完我接着往下讲。"
    },
    {
      "segment_id": "s000052",
      "start_ms": 134380,
      "end_ms": 138465,
      "text": "这十件里头有一件到今天都仿不出来，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 139910,
      "end_ms": 143395,
      "text": "第九名沈子藩万丝眉雀图，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 143860,
      "end_ms": 145605,
      "text": "您知道什么叫文思吗？"
    },
    {
      "segment_id": "s000055",
      "start_ms": 146390,
      "end_ms": 148490,
      "text": "就是通经断尾经线，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 148610,
      "end_ms": 150555,
      "text": "从头到尾是连贯的。"
    },
    {
      "segment_id": "s000057",
      "start_ms": 150850,
      "end_ms": 153985,
      "text": "纬线是一段一段断开织一朵花。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 154870,
      "end_ms": 161080,
      "text": "这朵花用一种颜色的纬线织完了就剪断换另一种颜色，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 161080,
      "end_ms": 164915,
      "text": "在之一根纬线只织一个颜色，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 165700,
      "end_ms": 168335,
      "text": "衣服画下来要剪几万根线。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 168850,
      "end_ms": 170595,
      "text": "南宋有个叫沈子藩的人，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 171040,
      "end_ms": 173375,
      "text": "用人丝织的一幅梅雀图，"
    },
    {
      "segment_id": "s000063",
      "start_ms": 173830,
      "end_ms": 175875,
      "text": "一只喜鹊站在梅枝上，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 176230,
      "end_ms": 178405,
      "text": "喜鹊的眼睛灵动鲜活，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 178790,
      "end_ms": 179615,
      "text": "换个角度，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 179930,
      "end_ms": 181310,
      "text": "眼睛仿佛会发光。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 181870,
      "end_ms": 183050,
      "text": "您凑近看，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 183730,
      "end_ms": 188670,
      "text": "画面上每根丝线的密度经线二十来根一厘米，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 189150,
      "end_ms": 191970,
      "text": "尾线四十几根一厘米，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 192890,
      "end_ms": 194250,
      "text": "比头发丝还密。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 194350,
      "end_ms": 195030,
      "text": "古人说，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 195050,
      "end_ms": 196890,
      "text": "一寸烟丝一寸金，"
    },
    {
      "segment_id": "s000073",
      "start_ms": 197130,
      "end_ms": 198090,
      "text": "不是夸张。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 198830,
      "end_ms": 203190,
      "text": "沈子帆织这幅梅雀图据说用了整整三年，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 204050,
      "end_ms": 204930,
      "text": "织完那天，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 205150,
      "end_ms": 206050,
      "text": "他五十多岁，"
    },
    {
      "segment_id": "s000077",
      "start_ms": 206630,
      "end_ms": 208390,
      "text": "眼睛几乎看不清了。"
    },
    {
      "segment_id": "s000078",
      "start_ms": 208890,
      "end_ms": 210180,
      "text": "织弟问他值不值值，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 210520,
      "end_ms": 210960,
      "text": "他说，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 211300,
      "end_ms": 215260,
      "text": "一根线织一个颜色剪断几万根线，"
    },
    {
      "segment_id": "s000081",
      "start_ms": 215980,
      "end_ms": 217660,
      "text": "这辈子就做这一件事，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 218460,
      "end_ms": 221420,
      "text": "做到眼睛瞎了也值。"
    },
    {
      "segment_id": "s000083",
      "start_ms": 221760,
      "end_ms": 222980,
      "text": "一幅单丝画，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 223880,
      "end_ms": 226200,
      "text": "耗尽一个人的眼睛和青春，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 226820,
      "end_ms": 228780,
      "text": "您说这是手艺还是命？"
    },
    {
      "segment_id": "s000086",
      "start_ms": 230220,
      "end_ms": 230940,
      "text": "第八名？"
    },
    {
      "segment_id": "s000087",
      "start_ms": 232720,
      "end_ms": 234640,
      "text": "宋代青玉云龙纹奴，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 235800,
      "end_ms": 238000,
      "text": "您知道宋代玉器有多绝吗？"
    },
    {
      "segment_id": "s000089",
      "start_ms": 238060,
      "end_ms": 240490,
      "text": "宋人雕玉不追求个头大，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 240650,
      "end_ms": 241310,
      "text": "追求巧，"
    },
    {
      "segment_id": "s000091",
      "start_ms": 242090,
      "end_ms": 244730,
      "text": "这件炉子高不到八厘米，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 244890,
      "end_ms": 246530,
      "text": "口径不到十三厘米，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 246790,
      "end_ms": 248990,
      "text": "一只手就能握住炉，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 249050,
      "end_ms": 250070,
      "text": "身上雕了。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 250070,
      "end_ms": 252630,
      "text": "一条龙龙在云里翻腾，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 253050,
      "end_ms": 255430,
      "text": "您拿放大镜看龙的鳞片，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 255630,
      "end_ms": 256450,
      "text": "一片一片，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 256810,
      "end_ms": 258490,
      "text": "每一片形态都不一样。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 258770,
      "end_ms": 260230,
      "text": "龙的爪子五个指头，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 260610,
      "end_ms": 261910,
      "text": "每个指头都刻出了，"
    },
    {
      "segment_id": "s000101",
      "start_ms": 261910,
      "end_ms": 264590,
      "text": "指甲云纹一根一根，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 265530,
      "end_ms": 267470,
      "text": "粗细深浅全有变化，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 268430,
      "end_ms": 270620,
      "text": "宋人雕玉不用，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 270660,
      "end_ms": 279280,
      "text": "机器全靠砣具一点一点慢慢磨一件这么小的器物工匠要磨几个月，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 279520,
      "end_ms": 280780,
      "text": "甚至整整一年，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 281700,
      "end_ms": 283940,
      "text": "传说有个玉匠磨了一辈子，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 283940,
      "end_ms": 286580,
      "text": "玉磨到老了手都变形了。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 287260,
      "end_ms": 289140,
      "text": "徒弟问他为什么不歇歇，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 289840,
      "end_ms": 292380,
      "text": "他说欲认人，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 292980,
      "end_ms": 293700,
      "text": "你停了，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 294360,
      "end_ms": 295765,
      "text": "他就不认你了。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 296450,
      "end_ms": 297470,
      "text": "一块原石，"
    },
    {
      "segment_id": "s000113",
      "start_ms": 297930,
      "end_ms": 302210,
      "text": "日复一日细细打磨磨到龙鳞片片，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 302250,
      "end_ms": 305030,
      "text": "分明您说这耐心哪来的？"
    },
    {
      "segment_id": "s000115",
      "start_ms": 306130,
      "end_ms": 306890,
      "text": "第七名，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 307990,
      "end_ms": 311510,
      "text": "掐丝珐琅缠织连门向耳炉珐琅。"
    },
    {
      "segment_id": "s000117",
      "start_ms": 311510,
      "end_ms": 314690,
      "text": "这门手艺元代从阿拉伯传入，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 314990,
      "end_ms": 316430,
      "text": "可中国人学过来之后，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 316710,
      "end_ms": 318530,
      "text": "做的比圆头还要精湛。"
    },
    {
      "segment_id": "s000120",
      "start_ms": 318650,
      "end_ms": 322070,
      "text": "这件炉子用的是掐丝珐琅工艺。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 322790,
      "end_ms": 323750,
      "text": "什么叫掐丝？"
    },
    {
      "segment_id": "s000122",
      "start_ms": 324130,
      "end_ms": 326960,
      "text": "就是用细铜丝在铜胎上掐出出花纹，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 327700,
      "end_ms": 330020,
      "text": "掐好之后填上珐琅釉料，"
    },
    {
      "segment_id": "s000124",
      "start_ms": 330860,
      "end_ms": 332860,
      "text": "再放进窑里烧烧，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 332960,
      "end_ms": 335260,
      "text": "一遍不够要反复烧七八遍，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 335500,
      "end_ms": 337780,
      "text": "每烧一遍釉料就会收缩，"
    },
    {
      "segment_id": "s000127",
      "start_ms": 337920,
      "end_ms": 339160,
      "text": "熬下去就要补用，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 339880,
      "end_ms": 341520,
      "text": "要了再烧来回，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 341520,
      "end_ms": 342020,
      "text": "反复，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 342260,
      "end_ms": 344480,
      "text": "直到釉面和铜丝齐平。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 344940,
      "end_ms": 345620,
      "text": "您想想，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 345980,
      "end_ms": 347240,
      "text": "铜丝有多细，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 348060,
      "end_ms": 350160,
      "text": "比头发丝粗不了多少，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 351080,
      "end_ms": 354540,
      "text": "要在上面掐出蝉枝莲纹一朵花，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 354580,
      "end_ms": 355740,
      "text": "一片叶子一根，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 355740,
      "end_ms": 358955,
      "text": "藤蔓全靠铜丝弯折成型。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 359710,
      "end_ms": 360805,
      "text": "烧完之后，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 361170,
      "end_ms": 363405,
      "text": "铜丝和珐琅融为一体，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 363920,
      "end_ms": 366035,
      "text": "摸上去平整顺滑。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 366460,
      "end_ms": 366610,
      "text": "嗯，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 366650,
      "end_ms": 367330,
      "text": "可细看，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 367410,
      "end_ms": 370145,
      "text": "每一根铜丝纹路都清清楚楚，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 370610,
      "end_ms": 374570,
      "text": "一根细如发丝的铜丝掐出一朵花。"
    },
    {
      "segment_id": "s000144",
      "start_ms": 374870,
      "end_ms": 376895,
      "text": "您说这是人手还是神手？"
    },
    {
      "segment_id": "s000145",
      "start_ms": 378030,
      "end_ms": 378635,
      "text": "第六名，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 379600,
      "end_ms": 381055,
      "text": "商代亚丑方尊，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 381820,
      "end_ms": 384635,
      "text": "这是一件商代晚期的青铜器，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 385470,
      "end_ms": 389175,
      "text": "三千多年前的东西高四十多厘米，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 389560,
      "end_ms": 391020,
      "text": "重二十来公斤。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 391300,
      "end_ms": 394705,
      "text": "您知道商代人是怎么铸造青铜器的吗？"
    },
    {
      "segment_id": "s000151",
      "start_ms": 395060,
      "end_ms": 396455,
      "text": "用的是分柱法，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 397250,
      "end_ms": 398510,
      "text": "什么叫分铸就？"
    },
    {
      "segment_id": "s000153",
      "start_ms": 398510,
      "end_ms": 400775,
      "text": "是先单独筑好各个零件，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 401330,
      "end_ms": 403175,
      "text": "再把零件拼装在一起。"
    },
    {
      "segment_id": "s000155",
      "start_ms": 404010,
      "end_ms": 412245,
      "text": "这件方尊的肩上四脚各有一个相手相手和器身是分开铸造，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 413190,
      "end_ms": 414090,
      "text": "筑好之后，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 414330,
      "end_ms": 416925,
      "text": "用榫卯结构套接上去，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 417550,
      "end_ms": 420375,
      "text": "能拆下来也能装回去。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 421290,
      "end_ms": 428355,
      "text": "三千多年前的工匠已经掌握了分段铸造榫卯拼接的技术。"
    },
    {
      "segment_id": "s000160",
      "start_ms": 429040,
      "end_ms": 433215,
      "text": "您想想一个相手单独住好，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 434370,
      "end_ms": 437060,
      "text": "再套到其身上严丝合缝，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 437360,
      "end_ms": 438965,
      "text": "拆了还能装回去。"
    },
    {
      "segment_id": "s000163",
      "start_ms": 439380,
      "end_ms": 442560,
      "text": "传说商代铸铜第一次浇筑失败，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 442580,
      "end_ms": 444585,
      "text": "工头就跳进桶水里训迹，"
    },
    {
      "segment_id": "s000165",
      "start_ms": 445060,
      "end_ms": 446460,
      "text": "说是要用命来换。"
    },
    {
      "segment_id": "s000166",
      "start_ms": 446540,
      "end_ms": 449595,
      "text": "这一如同这件方尊，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 449960,
      "end_ms": 451335,
      "text": "历经三千多年，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 451770,
      "end_ms": 453675,
      "text": "棱角依旧分明，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 454370,
      "end_ms": 456035,
      "text": "纹饰清晰完整。"
    },
    {
      "segment_id": "s000170",
      "start_ms": 456920,
      "end_ms": 458620,
      "text": "三千年前没有机床，"
    },
    {
      "segment_id": "s000171",
      "start_ms": 458640,
      "end_ms": 459405,
      "text": "没有图纸，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 459800,
      "end_ms": 461105,
      "text": "全凭手感拿捏。"
    },
    {
      "segment_id": "s000173",
      "start_ms": 461560,
      "end_ms": 463405,
      "text": "您说这是技术还是神技？"
    },
    {
      "segment_id": "s000174",
      "start_ms": 464230,
      "end_ms": 465830,
      "text": "从第十到第六名，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 466110,
      "end_ms": 467945,
      "text": "这五件东西都够绝。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 468900,
      "end_ms": 472155,
      "text": "章程的雕漆刷了上百层，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 472490,
      "end_ms": 474155,
      "text": "一刀一刀剔出云门。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 474580,
      "end_ms": 477275,
      "text": "沈子藩的严丝织了三年，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 478070,
      "end_ms": 479355,
      "text": "治完眼睛都瞎了。"
    },
    {
      "segment_id": "s000180",
      "start_ms": 480220,
      "end_ms": 484345,
      "text": "宋代青玉炉掌心大小磨上一年，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 484840,
      "end_ms": 486505,
      "text": "元代掐死珐琅奴，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 487020,
      "end_ms": 488620,
      "text": "铜丝细如发丝，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 488860,
      "end_ms": 492295,
      "text": "烧七八遍才成商代方尊。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 492660,
      "end_ms": 494855,
      "text": "三千年前就能拆了装回去，"
    },
    {
      "segment_id": "s000185",
      "start_ms": 495720,
      "end_ms": 497365,
      "text": "可他们还不是最绝的。"
    },
    {
      "segment_id": "s000186",
      "start_ms": 497860,
      "end_ms": 501505,
      "text": "接下来第五道第一名水准还要震撼。"
    },
    {
      "segment_id": "s000187",
      "start_ms": 502530,
      "end_ms": 503525,
      "text": "有一件东西，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 504360,
      "end_ms": 507845,
      "text": "工匠花五年时间造出一座能动的钟。"
    },
    {
      "segment_id": "s000189",
      "start_ms": 508600,
      "end_ms": 511145,
      "text": "有一件几千个人，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 511460,
      "end_ms": 512575,
      "text": "耗时十年，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 513330,
      "end_ms": 515705,
      "text": "打磨出一座巨型玉山。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 516240,
      "end_ms": 521290,
      "text": "有一件乾隆亲自敲定涂样，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 521350,
      "end_ms": 522985,
      "text": "全城都造的酒杯。"
    },
    {
      "segment_id": "s000194",
      "start_ms": 523790,
      "end_ms": 527670,
      "text": "有一件窑工烧石窑，"
    },
    {
      "segment_id": "s000195",
      "start_ms": 527830,
      "end_ms": 528730,
      "text": "能成一窑，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 528730,
      "end_ms": 529730,
      "text": "就算撞大运，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 529830,
      "end_ms": 531380,
      "text": "还有一件画家，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 531420,
      "end_ms": 533100,
      "text": "一笔一画一墨一色，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 533400,
      "end_ms": 533860,
      "text": "耗尽，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 533980,
      "end_ms": 536145,
      "text": "心血汇成的千古名画。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 536890,
      "end_ms": 538510,
      "text": "这几件到底是什么？"
    },
    {
      "segment_id": "s000202",
      "start_ms": 538810,
      "end_ms": 540315,
      "text": "到底有多震撼？"
    },
    {
      "segment_id": "s000203",
      "start_ms": 541180,
      "end_ms": 543865,
      "text": "下一集已经同步更新，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 544390,
      "end_ms": 545830,
      "text": "直接点开我的头像，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 545830,
      "end_ms": 546605,
      "text": "进入主页。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 546970,
      "end_ms": 549555,
      "text": "第一条视频就是下一集点个关注，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 549850,
      "end_ms": 555315,
      "text": "咱们好好看看老祖宗把一辈子的手艺压在一件东西上，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 555770,
      "end_ms": 557035,
      "text": "到底能做出什么？"
    }
  ],
  "source_transcript_sha256": "12bbadcd8e299b160b6c78b85220b109f4ee43dc4f5e3a1369ff98d426b1f921"
}