{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_c110f20742e7bf64_u001",
  "video_id": "v_c110f20742e7bf64",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 762.568005,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 550,
      "end_ms": 2310,
      "text": "如果有人白送你一个孩子，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 2510,
      "end_ms": 4830,
      "text": "你该不该要不是养不起，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 5010,
      "end_ms": 6210,
      "text": "也不是不喜欢小孩。"
    },
    {
      "segment_id": "s000004",
      "start_ms": 6650,
      "end_ms": 8770,
      "text": "可你给出的理由可能特别反常识。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 9070,
      "end_ms": 9550,
      "text": "大家好，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 9830,
      "end_ms": 10690,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000007",
      "start_ms": 11070,
      "end_ms": 13150,
      "text": "用经典好书帮你看懂钱。"
    },
    {
      "segment_id": "s000008",
      "start_ms": 13410,
      "end_ms": 18230,
      "text": "今天我们解读人口与日本经济这本书吉春阳这本小册子。"
    },
    {
      "segment_id": "s000009",
      "start_ms": 18330,
      "end_ms": 19070,
      "text": "很多人一听，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 19190,
      "end_ms": 20030,
      "text": "人口减少，"
    },
    {
      "segment_id": "s000011",
      "start_ms": 20190,
      "end_ms": 21470,
      "text": "老龄化就想叹气，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 22050,
      "end_ms": 24210,
      "text": "但我今天偏不按悲观叙事讲，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 24490,
      "end_ms": 26910,
      "text": "别背什么人口红利、少子化危机了。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 27070,
      "end_ms": 28650,
      "text": "咱们直接做九道判断题，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 28990,
      "end_ms": 31140,
      "text": "看看关于人口和经济这件事儿，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 31140,
      "end_ms": 33780,
      "text": "你的直觉到底能撑过几题？"
    },
    {
      "segment_id": "s000017",
      "start_ms": 33780,
      "end_ms": 35440,
      "text": "咱们回到开头的问题，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 35440,
      "end_ms": 38020,
      "text": "白送的孩子为什么不该随便要？"
    },
    {
      "segment_id": "s000019",
      "start_ms": 38020,
      "end_ms": 38460,
      "text": "第一题，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 38860,
      "end_ms": 39640,
      "text": "人口减少，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 39860,
      "end_ms": 41380,
      "text": "经济就一定衰退吗？"
    },
    {
      "segment_id": "s000022",
      "start_ms": 41840,
      "end_ms": 45440,
      "text": "假设日本人口从一点二八亿掉到一点一九亿，"
    },
    {
      "segment_id": "s000023",
      "start_ms": 45700,
      "end_ms": 47000,
      "text": "少了快一千万人。"
    },
    {
      "segment_id": "s000024",
      "start_ms": 47420,
      "end_ms": 49280,
      "text": "你会说人少了，"
    },
    {
      "segment_id": "s000025",
      "start_ms": 49480,
      "end_ms": 50640,
      "text": "干活的人少了，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 50660,
      "end_ms": 51780,
      "text": "经济肯定完蛋。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 52260,
      "end_ms": 53760,
      "text": "错吉春阳说，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 54100,
      "end_ms": 55300,
      "text": "从长期数据看，"
    },
    {
      "segment_id": "s000029",
      "start_ms": 55600,
      "end_ms": 59200,
      "text": "人口增加率和经济增长率之间没有明显的关系。"
    },
    {
      "segment_id": "s000030",
      "start_ms": 59500,
      "end_ms": 62265,
      "text": "决定发发达国家经济增长的不是人口，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 62510,
      "end_ms": 63210,
      "text": "是创新。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 63430,
      "end_ms": 64645,
      "text": "他画了一条趋势线。"
    },
    {
      "segment_id": "s000033",
      "start_ms": 65030,
      "end_ms": 67445,
      "text": "日本的GDP在人口减少的这些年里，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 67720,
      "end_ms": 69975,
      "text": "并没有跟着人口曲线一起塌下去。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 70500,
      "end_ms": 71165,
      "text": "举个例子，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 71680,
      "end_ms": 74935,
      "text": "日本二零零九年人口达到峰值之后一路下滑，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 75630,
      "end_ms": 78405,
      "text": "但日本人均GDP并没有同比例下降。"
    },
    {
      "segment_id": "s000038",
      "start_ms": 78770,
      "end_ms": 80350,
      "text": "因为劳动生产率在上升，"
    },
    {
      "segment_id": "s000039",
      "start_ms": 80670,
      "end_ms": 82190,
      "text": "一个人干出三个人的活，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 82310,
      "end_ms": 84980,
      "text": "GDP就不一定掉吉川洋馆，"
    },
    {
      "segment_id": "s000041",
      "start_ms": 84980,
      "end_ms": 86865,
      "text": "这叫劳动生产率成长。"
    },
    {
      "segment_id": "s000042",
      "start_ms": 87370,
      "end_ms": 87730,
      "text": "他说，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 87970,
      "end_ms": 91625,
      "text": "GDP的成长率不是单凭劳动人口的增加率决定的，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 92210,
      "end_ms": 95835,
      "text": "劳动生产率的成长大约相当于每人所得的成长。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 96090,
      "end_ms": 98105,
      "text": "人口减少不等于经济衰退，"
    },
    {
      "segment_id": "s000046",
      "start_ms": 98670,
      "end_ms": 100435,
      "text": "真正的问题不是人少了，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 100710,
      "end_ms": 102775,
      "text": "是人均产出有没有上去？"
    },
    {
      "segment_id": "s000048",
      "start_ms": 103190,
      "end_ms": 103755,
      "text": "第二题，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 104210,
      "end_ms": 105055,
      "text": "人口少了，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 105390,
      "end_ms": 106485,
      "text": "创新就少了吗？"
    },
    {
      "segment_id": "s000051",
      "start_ms": 107380,
      "end_ms": 109335,
      "text": "正常直觉人越多，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 109630,
      "end_ms": 110385,
      "text": "脑子越多，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 110720,
      "end_ms": 113165,
      "text": "发明创造就越多人少了，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 113500,
      "end_ms": 114975,
      "text": "创新的种子也就少了。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 115520,
      "end_ms": 116525,
      "text": "吉川阳不这么看，"
    },
    {
      "segment_id": "s000056",
      "start_ms": 116990,
      "end_ms": 117430,
      "text": "他说，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 117870,
      "end_ms": 119395,
      "text": "创新从来是微观的，"
    },
    {
      "segment_id": "s000058",
      "start_ms": 119740,
      "end_ms": 121895,
      "text": "跟宏观人口动态没有直接关系。"
    },
    {
      "segment_id": "s000059",
      "start_ms": 122630,
      "end_ms": 125295,
      "text": "提出创新理论的经济学家熊彼特强调，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 125710,
      "end_ms": 130070,
      "text": "推动创新的人不是把人口大幅增长考虑在内才去创新的。"
    },
    {
      "segment_id": "s000061",
      "start_ms": 130150,
      "end_ms": 130845,
      "text": "举个例子，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 131300,
      "end_ms": 135565,
      "text": "日本成人纸尿裤的销量在二零一二年就超过了婴儿纸尿裤。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 136010,
      "end_ms": 137705,
      "text": "按理说婴儿少了，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 137950,
      "end_ms": 139485,
      "text": "纸尿裤市场应该萎缩。"
    },
    {
      "segment_id": "s000065",
      "start_ms": 139910,
      "end_ms": 141945,
      "text": "但企业转头开发了成人纸尿裤，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 142250,
      "end_ms": 143885,
      "text": "开拓了一个全新的市场。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 144350,
      "end_ms": 145575,
      "text": "这不是因为人多了，"
    },
    {
      "segment_id": "s000068",
      "start_ms": 145840,
      "end_ms": 148875,
      "text": "是因为有人看到了新需求做了一个新产品。"
    },
    {
      "segment_id": "s000069",
      "start_ms": 149270,
      "end_ms": 151190,
      "text": "创新不是人口的数量，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 151190,
      "end_ms": 154365,
      "text": "游戏是需求的发现游戏人少了，"
    },
    {
      "segment_id": "s000071",
      "start_ms": 154580,
      "end_ms": 155215,
      "text": "需求变了，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 155420,
      "end_ms": 156580,
      "text": "但需求不会消失。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 156820,
      "end_ms": 157975,
      "text": "他只是换了张脸。"
    },
    {
      "segment_id": "s000074",
      "start_ms": 158370,
      "end_ms": 159005,
      "text": "第三题，"
    },
    {
      "segment_id": "s000075",
      "start_ms": 159380,
      "end_ms": 160345,
      "text": "需求饱和了，"
    },
    {
      "segment_id": "s000076",
      "start_ms": 160620,
      "end_ms": 161580,
      "text": "经济就完了吗？"
    },
    {
      "segment_id": "s000077",
      "start_ms": 161600,
      "end_ms": 163885,
      "text": "正常直觉该买的都买了，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 164140,
      "end_ms": 165180,
      "text": "该用的都用了，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 165240,
      "end_ms": 166360,
      "text": "没人再消费了，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 166400,
      "end_ms": 167565,
      "text": "经济就停滞了。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 167930,
      "end_ms": 168590,
      "text": "吉春阳说，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 168910,
      "end_ms": 171725,
      "text": "不他引用凯恩斯的观点，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 172100,
      "end_ms": 174960,
      "text": "经济萧条的原因在于有效需求的不足，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 175380,
      "end_ms": 177065,
      "text": "但需求不会永远饱和，"
    },
    {
      "segment_id": "s000085",
      "start_ms": 177560,
      "end_ms": 180120,
      "text": "因为创新会不断创造出新需求。"
    },
    {
      "segment_id": "s000086",
      "start_ms": 180300,
      "end_ms": 180965,
      "text": "举个例子，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 181540,
      "end_ms": 182680,
      "text": "智能手机出来之前，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 182960,
      "end_ms": 186420,
      "text": "谁会觉得自己需要一部能拍照、能上网、能付钱的手机？"
    },
    {
      "segment_id": "s000089",
      "start_ms": 186500,
      "end_ms": 188740,
      "text": "诺基亚时代的人觉得手机能打电话，"
    },
    {
      "segment_id": "s000090",
      "start_ms": 188740,
      "end_ms": 189785,
      "text": "发短信就够了。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 190200,
      "end_ms": 191300,
      "text": "但iphone一出来，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 191480,
      "end_ms": 193535,
      "text": "需求被凭空创造了出来。"
    },
    {
      "segment_id": "s000093",
      "start_ms": 194320,
      "end_ms": 194980,
      "text": "纪川阳说，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 195440,
      "end_ms": 197580,
      "text": "经济增长靠的就是这种需求。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 197600,
      "end_ms": 201500,
      "text": "创造型创新用新产品打破旧需求的饱和点。"
    },
    {
      "segment_id": "s000096",
      "start_ms": 201500,
      "end_ms": 203520,
      "text": "所以不是需求没了，"
    },
    {
      "segment_id": "s000097",
      "start_ms": 203580,
      "end_ms": 206125,
      "text": "是你还没找到下一个让人想要的东西。"
    },
    {
      "segment_id": "s000098",
      "start_ms": 206370,
      "end_ms": 206975,
      "text": "第四题，"
    },
    {
      "segment_id": "s000099",
      "start_ms": 207470,
      "end_ms": 209900,
      "text": "老龄化是负担还是新市场？"
    },
    {
      "segment_id": "s000100",
      "start_ms": 210080,
      "end_ms": 210420,
      "text": "正常？"
    },
    {
      "segment_id": "s000101",
      "start_ms": 210420,
      "end_ms": 211955,
      "text": "直觉老人多了，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 212160,
      "end_ms": 213020,
      "text": "养老金压力大，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 213160,
      "end_ms": 213960,
      "text": "医疗开支高，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 214140,
      "end_ms": 215075,
      "text": "社会养不起。"
    },
    {
      "segment_id": "s000105",
      "start_ms": 215790,
      "end_ms": 216470,
      "text": "吉川阳说，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 216930,
      "end_ms": 217955,
      "text": "换一个角度看，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 218500,
      "end_ms": 220885,
      "text": "日本每四个人里就有一个是老年人，"
    },
    {
      "segment_id": "s000108",
      "start_ms": 221510,
      "end_ms": 222470,
      "text": "听起来是灾难，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 222530,
      "end_ms": 225270,
      "text": "但老年人口本身就是一个巨大的消费市场。"
    },
    {
      "segment_id": "s000110",
      "start_ms": 225390,
      "end_ms": 226330,
      "text": "吉春阳举例说，"
    },
    {
      "segment_id": "s000111",
      "start_ms": 226590,
      "end_ms": 230475,
      "text": "成人纸尿裤的出口量在二零一二年就超过了婴儿纸尿裤。"
    },
    {
      "segment_id": "s000112",
      "start_ms": 230960,
      "end_ms": 233300,
      "text": "老年人的需求催生了一个全新的产业。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 233420,
      "end_ms": 233985,
      "text": "再比如，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 234290,
      "end_ms": 236255,
      "text": "日本企业开发了护理机器人，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 236530,
      "end_ms": 239205,
      "text": "老年人专用食品无障碍住宅改造，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 240040,
      "end_ms": 241000,
      "text": "这些不是慈善，"
    },
    {
      "segment_id": "s000117",
      "start_ms": 241260,
      "end_ms": 241960,
      "text": "是生意。"
    },
    {
      "segment_id": "s000118",
      "start_ms": 242040,
      "end_ms": 242740,
      "text": "吉川阳说，"
    },
    {
      "segment_id": "s000119",
      "start_ms": 243200,
      "end_ms": 245260,
      "text": "老龄化不是经济衰退的原因，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 245540,
      "end_ms": 247240,
      "text": "而是创新的触发条件。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 247320,
      "end_ms": 248840,
      "text": "等老了需求变了，"
    },
    {
      "segment_id": "s000122",
      "start_ms": 249080,
      "end_ms": 251720,
      "text": "企业跟着变经济增长点就出来了。"
    },
    {
      "segment_id": "s000123",
      "start_ms": 252440,
      "end_ms": 253760,
      "text": "老龄化是负担吗？"
    },
    {
      "segment_id": "s000124",
      "start_ms": 254100,
      "end_ms": 254340,
      "text": "是，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 255060,
      "end_ms": 256980,
      "text": "但它同时也是一张入场券，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 257460,
      "end_ms": 259740,
      "text": "看你能不能找到下一个需求入口。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 260060,
      "end_ms": 260640,
      "text": "第五题，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 261000,
      "end_ms": 261900,
      "text": "AI来了，"
    },
    {
      "segment_id": "s000129",
      "start_ms": 262020,
      "end_ms": 263500,
      "text": "人是不是就没用了？"
    },
    {
      "segment_id": "s000130",
      "start_ms": 263600,
      "end_ms": 267640,
      "text": "正常直觉机器取代人工人失业经济完蛋。"
    },
    {
      "segment_id": "s000131",
      "start_ms": 267960,
      "end_ms": 268660,
      "text": "吉川阳说，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 269040,
      "end_ms": 270970,
      "text": "回顾历史恰恰相反，"
    },
    {
      "segment_id": "s000133",
      "start_ms": 271430,
      "end_ms": 273710,
      "text": "机械化确实让某些工种消失了。"
    },
    {
      "segment_id": "s000134",
      "start_ms": 274150,
      "end_ms": 275150,
      "text": "但吉川阳指出，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 275530,
      "end_ms": 279030,
      "text": "机械化造成某些职场某些特定工作的雇佣需求消失，"
    },
    {
      "segment_id": "s000136",
      "start_ms": 279330,
      "end_ms": 282750,
      "text": "与根绝人类劳动的需要是完全不同的两回事。"
    },
    {
      "segment_id": "s000137",
      "start_ms": 283470,
      "end_ms": 284190,
      "text": "举顾历史，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 284430,
      "end_ms": 286210,
      "text": "结果并非人类被炒鱿鱼，"
    },
    {
      "segment_id": "s000139",
      "start_ms": 286510,
      "end_ms": 288190,
      "text": "反而提升了劳动生产率，"
    },
    {
      "segment_id": "s000140",
      "start_ms": 288350,
      "end_ms": 289270,
      "text": "调整了薪资，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 289870,
      "end_ms": 292070,
      "text": "人们因为机器而变得更富裕了。"
    },
    {
      "segment_id": "s000142",
      "start_ms": 292610,
      "end_ms": 293270,
      "text": "举个例子，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 293790,
      "end_ms": 295190,
      "text": "ATM机出来的时候，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 295310,
      "end_ms": 297470,
      "text": "很多人说银行柜员要失业，"
    },
    {
      "segment_id": "s000145",
      "start_ms": 298130,
      "end_ms": 300100,
      "text": "结果呢柜员没少，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 300450,
      "end_ms": 303310,
      "text": "但他们的工作从数钞票变成了卖理财，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 303470,
      "end_ms": 304455,
      "text": "做客户服务，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 305270,
      "end_ms": 306530,
      "text": "机器干了重复劳动，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 306810,
      "end_ms": 308345,
      "text": "人干了机器干不了的活。"
    },
    {
      "segment_id": "s000150",
      "start_ms": 309150,
      "end_ms": 310030,
      "text": " Ai也一样，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 310690,
      "end_ms": 312890,
      "text": "它替代的是任务不是人，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 313370,
      "end_ms": 317089,
      "text": "但前提是你得有本事去干AI干不了的事儿。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 317089,
      "end_ms": 317670,
      "text": "第六题，"
    },
    {
      "segment_id": "s000154",
      "start_ms": 318010,
      "end_ms": 319230,
      "text": "马尔萨斯错了吗？"
    },
    {
      "segment_id": "s000155",
      "start_ms": 319750,
      "end_ms": 321270,
      "text": "正常直觉人多，"
    },
    {
      "segment_id": "s000156",
      "start_ms": 321390,
      "end_ms": 322170,
      "text": "资源不够分，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 322270,
      "end_ms": 322950,
      "text": "大家就穷。"
    },
    {
      "segment_id": "s000158",
      "start_ms": 323250,
      "end_ms": 325330,
      "text": "这是马尔萨斯两百多年前的结论。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 325690,
      "end_ms": 326410,
      "text": "吉川阳说，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 326790,
      "end_ms": 328630,
      "text": "这个结论从根儿上就有问题。"
    },
    {
      "segment_id": "s000161",
      "start_ms": 328770,
      "end_ms": 329770,
      "text": "马尔萨斯认为，"
    },
    {
      "segment_id": "s000162",
      "start_ms": 330010,
      "end_ms": 331870,
      "text": "人口按几何级数增长，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 332010,
      "end_ms": 333830,
      "text": "食物按算术级数增长，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 334110,
      "end_ms": 336230,
      "text": "所以人口增长必然导致贫困。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 336350,
      "end_ms": 337370,
      "text": "但吉川阳认为，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 337670,
      "end_ms": 341280,
      "text": "过去两百年发达国家人均收入在增加的同时，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 341520,
      "end_ms": 343500,
      "text": "人口增长率反而在下降，"
    },
    {
      "segment_id": "s000168",
      "start_ms": 343660,
      "end_ms": 344400,
      "text": "收入越高，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 344640,
      "end_ms": 345480,
      "text": "生孩子越少，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 346220,
      "end_ms": 348100,
      "text": "这跟马尔萨斯的预测正好相反。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 348400,
      "end_ms": 348940,
      "text": "为什么？"
    },
    {
      "segment_id": "s000172",
      "start_ms": 349160,
      "end_ms": 350320,
      "text": "因为人富了之后，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 350560,
      "end_ms": 352180,
      "text": "时间变成最贵的东西，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 352460,
      "end_ms": 354400,
      "text": "养孩子的机会成本太高了，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 354600,
      "end_ms": 356180,
      "text": "你花在带孩子上的时间。"
    },
    {
      "segment_id": "s000176",
      "start_ms": 356360,
      "end_ms": 358280,
      "text": "本来可以用来赚钱旅行，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 358580,
      "end_ms": 359360,
      "text": "提升自己。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 359540,
      "end_ms": 360260,
      "text": "纪川阳说，"
    },
    {
      "segment_id": "s000179",
      "start_ms": 360560,
      "end_ms": 362400,
      "text": "人们为了保持高水准的生活，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 362580,
      "end_ms": 364020,
      "text": "于是抑制生育人数，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 364220,
      "end_ms": 365580,
      "text": "所以不是资源不够，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 365800,
      "end_ms": 367140,
      "text": "是人的选择变了。"
    },
    {
      "segment_id": "s000183",
      "start_ms": 367260,
      "end_ms": 370085,
      "text": "马尔萨斯看的是粮食和人口的赛跑。"
    },
    {
      "segment_id": "s000184",
      "start_ms": 370570,
      "end_ms": 373270,
      "text": "吉川阳看的是收入和选择的关系。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 373410,
      "end_ms": 374105,
      "text": "第七题，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 374590,
      "end_ms": 376415,
      "text": "长寿是经济的负担吗？"
    },
    {
      "segment_id": "s000187",
      "start_ms": 376850,
      "end_ms": 377605,
      "text": "正常直觉，"
    },
    {
      "segment_id": "s000188",
      "start_ms": 377950,
      "end_ms": 378810,
      "text": "人活的越久，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 379030,
      "end_ms": 380110,
      "text": "养老金发的越多，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 380370,
      "end_ms": 381350,
      "text": "医疗花的越多，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 381590,
      "end_ms": 382410,
      "text": "财政撑不住。"
    },
    {
      "segment_id": "s000192",
      "start_ms": 382490,
      "end_ms": 383305,
      "text": "季川阳说，"
    },
    {
      "segment_id": "s000193",
      "start_ms": 383700,
      "end_ms": 385035,
      "text": "长寿是机会，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 385410,
      "end_ms": 387510,
      "text": "日本是世界上最长寿的国家之一。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 387630,
      "end_ms": 388330,
      "text": "吉川阳说，"
    },
    {
      "segment_id": "s000196",
      "start_ms": 388670,
      "end_ms": 390795,
      "text": "日本是世界有树的长寿国，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 391120,
      "end_ms": 392225,
      "text": "这本身就是机会。"
    },
    {
      "segment_id": "s000198",
      "start_ms": 392700,
      "end_ms": 393265,
      "text": "为什么？"
    },
    {
      "segment_id": "s000199",
      "start_ms": 393670,
      "end_ms": 398140,
      "text": "因为长寿意味着一个人有更长的工作年限、更长的消费周期，"
    },
    {
      "segment_id": "s000200",
      "start_ms": 398400,
      "end_ms": 399715,
      "text": "更长的学习时间。"
    },
    {
      "segment_id": "s000201",
      "start_ms": 399950,
      "end_ms": 401410,
      "text": "想象一个六十岁退休的人，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 401490,
      "end_ms": 403525,
      "text": "他可能还有二十五到三十年的寿命。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 404360,
      "end_ms": 405735,
      "text": "这三十年不是等死，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 406100,
      "end_ms": 406760,
      "text": "而是第三，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 406780,
      "end_ms": 410520,
      "text": "人生可以在工作在学习、在消费。"
    },
    {
      "segment_id": "s000206",
      "start_ms": 410600,
      "end_ms": 411515,
      "text": "季川阳说，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 411910,
      "end_ms": 414575,
      "text": "超高老龄社会需要的创新是存在的，"
    },
    {
      "segment_id": "s000208",
      "start_ms": 414910,
      "end_ms": 417765,
      "text": "日本应该构建一个支持长寿经济的模型，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 418190,
      "end_ms": 419050,
      "text": "在这个过程里，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 419070,
      "end_ms": 420325,
      "text": "生产率也会上升。"
    },
    {
      "segment_id": "s000211",
      "start_ms": 420680,
      "end_ms": 422585,
      "text": "长寿是负债还是资产，"
    },
    {
      "segment_id": "s000212",
      "start_ms": 423050,
      "end_ms": 424675,
      "text": "取决于你把它当成负担，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 424920,
      "end_ms": 426780,
      "text": "还是当成一个尚未开发的市场。"
    },
    {
      "segment_id": "s000214",
      "start_ms": 426920,
      "end_ms": 427645,
      "text": "第八题，"
    },
    {
      "segment_id": "s000215",
      "start_ms": 428000,
      "end_ms": 428955,
      "text": "gdp增长了，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 429210,
      "end_ms": 430055,
      "text": "你就变富了吗？"
    },
    {
      "segment_id": "s000217",
      "start_ms": 430590,
      "end_ms": 432495,
      "text": "正常直觉GDP涨了，"
    },
    {
      "segment_id": "s000218",
      "start_ms": 432710,
      "end_ms": 433695,
      "text": "说明大家赚的多了，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 433930,
      "end_ms": 434790,
      "text": "当然变富了。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 434790,
      "end_ms": 435615,
      "text": "季川阳说，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 435960,
      "end_ms": 436375,
      "text": "不一定，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 436930,
      "end_ms": 441270,
      "text": "GDP是一个国家一年内生产的所有东西的价格总和人口增加，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 441410,
      "end_ms": 442895,
      "text": "GDP总量自然增加，"
    },
    {
      "segment_id": "s000224",
      "start_ms": 443150,
      "end_ms": 444850,
      "text": "但人均GDP可能没变。"
    },
    {
      "segment_id": "s000225",
      "start_ms": 444990,
      "end_ms": 445690,
      "text": "吉春阳说，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 446030,
      "end_ms": 448410,
      "text": "GDP作为衡量富足程度的尺度，"
    },
    {
      "segment_id": "s000227",
      "start_ms": 448450,
      "end_ms": 449455,
      "text": "本身就不够用。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 449690,
      "end_ms": 450255,
      "text": "举个例子，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 450690,
      "end_ms": 451995,
      "text": "一个村子有十个人，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 452250,
      "end_ms": 453365,
      "text": "每人每年赚一万，"
    },
    {
      "segment_id": "s000231",
      "start_ms": 453580,
      "end_ms": 454535,
      "text": "GDP是十万。"
    },
    {
      "segment_id": "s000232",
      "start_ms": 454760,
      "end_ms": 455240,
      "text": "第二年，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 455320,
      "end_ms": 456645,
      "text": "村子来了十个新人，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 457060,
      "end_ms": 457700,
      "text": "二十个人，"
    },
    {
      "segment_id": "s000235",
      "start_ms": 457700,
      "end_ms": 460475,
      "text": "每人还是赚一万GDP变成二十万，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 460840,
      "end_ms": 461875,
      "text": "GDP翻倍了。"
    },
    {
      "segment_id": "s000237",
      "start_ms": 462320,
      "end_ms": 463255,
      "text": "但你变富了吗？"
    },
    {
      "segment_id": "s000238",
      "start_ms": 463790,
      "end_ms": 465395,
      "text": "没有你还是赚一万。"
    },
    {
      "segment_id": "s000239",
      "start_ms": 465580,
      "end_ms": 468075,
      "text": "吉春阳真正关心的是人均GDP,"
    },
    {
      "segment_id": "s000240",
      "start_ms": 468430,
      "end_ms": 470065,
      "text": "每个人创造了多少价值？"
    },
    {
      "segment_id": "s000241",
      "start_ms": 470320,
      "end_ms": 471705,
      "text": " Gdp总量是尺子，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 472070,
      "end_ms": 474895,
      "text": "人均GDP才是你真正能买到的东西。"
    },
    {
      "segment_id": "s000243",
      "start_ms": 475330,
      "end_ms": 476255,
      "text": "尺子变长了，"
    },
    {
      "segment_id": "s000244",
      "start_ms": 476530,
      "end_ms": 477405,
      "text": "数字变大了，"
    },
    {
      "segment_id": "s000245",
      "start_ms": 477680,
      "end_ms": 478795,
      "text": "不等于你长高了。"
    },
    {
      "segment_id": "s000246",
      "start_ms": 479200,
      "end_ms": 479820,
      "text": "第九题，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 480320,
      "end_ms": 481480,
      "text": "经济不增长了，"
    },
    {
      "segment_id": "s000248",
      "start_ms": 481680,
      "end_ms": 482880,
      "text": "社会就崩溃了吗？"
    },
    {
      "segment_id": "s000249",
      "start_ms": 483240,
      "end_ms": 485990,
      "text": "正常直觉GDP必须永远增长，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 486070,
      "end_ms": 487170,
      "text": "否则社会就完了。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 487430,
      "end_ms": 488130,
      "text": "吉川阳说，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 488410,
      "end_ms": 489065,
      "text": "不一定。"
    },
    {
      "segment_id": "s000253",
      "start_ms": 489520,
      "end_ms": 491005,
      "text": "他在书里讨论了一个概念，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 491350,
      "end_ms": 492330,
      "text": "零增长社会，"
    },
    {
      "segment_id": "s000255",
      "start_ms": 492350,
      "end_ms": 493510,
      "text": "如果人口在减少，"
    },
    {
      "segment_id": "s000256",
      "start_ms": 493770,
      "end_ms": 495050,
      "text": "GDP总量不增长，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 495290,
      "end_ms": 496890,
      "text": "但人均GDP在增长，"
    },
    {
      "segment_id": "s000258",
      "start_ms": 497050,
      "end_ms": 498145,
      "text": "这算不算好经济？"
    },
    {
      "segment_id": "s000259",
      "start_ms": 498370,
      "end_ms": 499130,
      "text": "纪春阳认为，"
    },
    {
      "segment_id": "s000260",
      "start_ms": 499330,
      "end_ms": 500490,
      "text": "在零增长时代，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 500570,
      "end_ms": 503235,
      "text": "分配平等成为经济发展的核心任务。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 503480,
      "end_ms": 504195,
      "text": "换句话说，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 504580,
      "end_ms": 505740,
      "text": "蛋糕不做大了，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 505820,
      "end_ms": 506340,
      "text": "怎么分，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 506360,
      "end_ms": 508000,
      "text": "蛋糕就变得更重要了。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 508060,
      "end_ms": 509540,
      "text": "如果人均产出在提高，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 509700,
      "end_ms": 512125,
      "text": "但增长的果实全被少数人拿走，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 512400,
      "end_ms": 514620,
      "text": "那大多数人感受到的就不是变富，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 514920,
      "end_ms": 515825,
      "text": "而是被落下。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 516360,
      "end_ms": 517775,
      "text": "纪川阳不反对增长。"
    },
    {
      "segment_id": "s000271",
      "start_ms": 518050,
      "end_ms": 518885,
      "text": "但他提醒我们，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 519130,
      "end_ms": 520625,
      "text": "增长不是唯一的目标，"
    },
    {
      "segment_id": "s000273",
      "start_ms": 521030,
      "end_ms": 524300,
      "text": "公平、尊严、社会信任这些东西，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 524300,
      "end_ms": 525575,
      "text": "不进GDP的公式，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 525990,
      "end_ms": 528350,
      "text": "但他们竟生活九道、判断题，"
    },
    {
      "segment_id": "s000276",
      "start_ms": 528350,
      "end_ms": 528875,
      "text": "做完了，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 529080,
      "end_ms": 530275,
      "text": "你的答案都对了吗？"
    },
    {
      "segment_id": "s000278",
      "start_ms": 530770,
      "end_ms": 534265,
      "text": "吉春阳的人口与日本经济之所以在日本成为畅销书，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 534640,
      "end_ms": 536560,
      "text": "不是因为他给了你一个乐观的答案，"
    },
    {
      "segment_id": "s000280",
      "start_ms": 536620,
      "end_ms": 539420,
      "text": "是因为他把人口减少等于经济衰退。"
    },
    {
      "segment_id": "s000281",
      "start_ms": 539420,
      "end_ms": 541785,
      "text": "这个思维定式拆开给你看了。"
    },
    {
      "segment_id": "s000282",
      "start_ms": 542020,
      "end_ms": 542600,
      "text": "他告诉你，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 542720,
      "end_ms": 543815,
      "text": "人口是变量，"
    },
    {
      "segment_id": "s000284",
      "start_ms": 544080,
      "end_ms": 544795,
      "text": "不是宿命，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 545190,
      "end_ms": 551820,
      "text": "创新需求、生产率分配这些东西比人头数量更能决定你过得好不好。"
    },
    {
      "segment_id": "s000286",
      "start_ms": 552160,
      "end_ms": 553560,
      "text": "但既然是阅问时刻，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 553680,
      "end_ms": 554340,
      "text": "老规矩，"
    },
    {
      "segment_id": "s000288",
      "start_ms": 554520,
      "end_ms": 556080,
      "text": "尽信输不如无书。"
    },
    {
      "segment_id": "s000289",
      "start_ms": 556760,
      "end_ms": 558280,
      "text": "这本书至少有三个地方，"
    },
    {
      "segment_id": "s000290",
      "start_ms": 558340,
      "end_ms": 559780,
      "text": "我觉得必须泼点冷水。"
    },
    {
      "segment_id": "s000291",
      "start_ms": 560080,
      "end_ms": 560500,
      "text": "第一，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 561020,
      "end_ms": 563960,
      "text": "吉川阳的创新万能论有它的逻辑缺口。"
    },
    {
      "segment_id": "s000293",
      "start_ms": 564260,
      "end_ms": 565340,
      "text": "吉川阳反复说，"
    },
    {
      "segment_id": "s000294",
      "start_ms": 565700,
      "end_ms": 567020,
      "text": "创新能打破需求，"
    },
    {
      "segment_id": "s000295",
      "start_ms": 567020,
      "end_ms": 567380,
      "text": "饱和，"
    },
    {
      "segment_id": "s000296",
      "start_ms": 567800,
      "end_ms": 568220,
      "text": "创新，"
    },
    {
      "segment_id": "s000297",
      "start_ms": 568220,
      "end_ms": 570200,
      "text": "能提升人均GDP创新，"
    },
    {
      "segment_id": "s000298",
      "start_ms": 570200,
      "end_ms": 572040,
      "text": "能拯救人口减少的经济。"
    },
    {
      "segment_id": "s000299",
      "start_ms": 572580,
      "end_ms": 573600,
      "text": "但批评者指出，"
    },
    {
      "segment_id": "s000300",
      "start_ms": 573860,
      "end_ms": 576060,
      "text": "这本书的经验证据过于薄弱，"
    },
    {
      "segment_id": "s000301",
      "start_ms": 576520,
      "end_ms": 582370,
      "text": "仅仅绘制人口规模与经济计总量的趋势曲线不足以验证人口对经济影响有限。"
    },
    {
      "segment_id": "s000302",
      "start_ms": 582390,
      "end_ms": 585530,
      "text": "这个命题人口有着丰富的内涵，"
    },
    {
      "segment_id": "s000303",
      "start_ms": 585890,
      "end_ms": 591330,
      "text": "劳动人口数量、比例、年龄结构这些东西的变化比人口总量复杂的多，"
    },
    {
      "segment_id": "s000304",
      "start_ms": 591810,
      "end_ms": 592650,
      "text": "更关键的是，"
    },
    {
      "segment_id": "s000305",
      "start_ms": 592970,
      "end_ms": 595390,
      "text": "创新和人口不是孤立的两件事。"
    },
    {
      "segment_id": "s000306",
      "start_ms": 595430,
      "end_ms": 596390,
      "text": "人口增长驱动，"
    },
    {
      "segment_id": "s000307",
      "start_ms": 596390,
      "end_ms": 597950,
      "text": "税基扩大消费市场，"
    },
    {
      "segment_id": "s000308",
      "start_ms": 597950,
      "end_ms": 599190,
      "text": "扩大产业规模，"
    },
    {
      "segment_id": "s000309",
      "start_ms": 599190,
      "end_ms": 599465,
      "text": "扩大。"
    },
    {
      "segment_id": "s000310",
      "start_ms": 599850,
      "end_ms": 602530,
      "text": "这些从供需两端都对创新产生影响，"
    },
    {
      "segment_id": "s000311",
      "start_ms": 602770,
      "end_ms": 604790,
      "text": "假设普通人群的创新概率不变，"
    },
    {
      "segment_id": "s000312",
      "start_ms": 605090,
      "end_ms": 608090,
      "text": "绝对人口规模的增长也会增加创新总量。"
    },
    {
      "segment_id": "s000313",
      "start_ms": 608970,
      "end_ms": 609770,
      "text": "吉川阳说，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 609910,
      "end_ms": 611330,
      "text": "人口减少不是问题，"
    },
    {
      "segment_id": "s000315",
      "start_ms": 611690,
      "end_ms": 612470,
      "text": "但问题是，"
    },
    {
      "segment_id": "s000316",
      "start_ms": 612870,
      "end_ms": 614450,
      "text": "创新的哪儿来？"
    },
    {
      "segment_id": "s000317",
      "start_ms": 614450,
      "end_ms": 618850,
      "text": "如果创新本身就需要一定的人口基数和市场规模来支撑，"
    },
    {
      "segment_id": "s000318",
      "start_ms": 618850,
      "end_ms": 620990,
      "text": "那人少了创新的土壤，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 620990,
      "end_ms": 622790,
      "text": "是不是也在变薄？"
    },
    {
      "segment_id": "s000320",
      "start_ms": 622790,
      "end_ms": 623510,
      "text": "第二，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 623510,
      "end_ms": 627490,
      "text": "这本书默认了一个乐观的日本吉川阳书里的例子。"
    },
    {
      "segment_id": "s000322",
      "start_ms": 627710,
      "end_ms": 630020,
      "text": "数据制度背景来来日本，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 630020,
      "end_ms": 635460,
      "text": "但日本的劳动力市场、社保体系、企业治理和很多国家的情况已经完全不同。"
    },
    {
      "segment_id": "s000324",
      "start_ms": 636300,
      "end_ms": 636900,
      "text": "书里说，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 637220,
      "end_ms": 638440,
      "text": "老龄化是机会，"
    },
    {
      "segment_id": "s000326",
      "start_ms": 638660,
      "end_ms": 639760,
      "text": "长寿是资产，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 640440,
      "end_ms": 642340,
      "text": "这个逻辑在日本可能成立。"
    },
    {
      "segment_id": "s000328",
      "start_ms": 642740,
      "end_ms": 646640,
      "text": "因为日本有相对完善的护理保险制度和企业研发能力，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 647300,
      "end_ms": 650840,
      "text": "但在一个养老金覆盖率低、企业创新能力弱的国家，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 651100,
      "end_ms": 652860,
      "text": "老龄化可能真的就是负担。"
    },
    {
      "segment_id": "s000331",
      "start_ms": 653180,
      "end_ms": 655260,
      "text": "吉川阳没有否认老龄化的压力，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 655560,
      "end_ms": 657060,
      "text": "他认可问题的严重性，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 657300,
      "end_ms": 661475,
      "text": "但他对人口减少悲观论的驳斥建立在一个隐含前提上，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 661870,
      "end_ms": 665290,
      "text": "这个经济体有能力把挑战转化成创新。"
    },
    {
      "segment_id": "s000335",
      "start_ms": 665390,
      "end_ms": 666885,
      "text": "如果这个能力不存在呢？"
    },
    {
      "segment_id": "s000336",
      "start_ms": 667230,
      "end_ms": 668650,
      "text": "如果企业只顾着裁员，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 668730,
      "end_ms": 670070,
      "text": "不愿意投资研发呢？"
    },
    {
      "segment_id": "s000338",
      "start_ms": 670130,
      "end_ms": 671550,
      "text": "如果政府只顾着发债，"
    },
    {
      "segment_id": "s000339",
      "start_ms": 671730,
      "end_ms": 672995,
      "text": "不愿意改革社保呢？"
    },
    {
      "segment_id": "s000340",
      "start_ms": 673210,
      "end_ms": 675435,
      "text": "吉春阳的模型是一个有用的起点，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 675700,
      "end_ms": 676385,
      "text": "不是终点。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 676890,
      "end_ms": 677290,
      "text": "第三，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 677750,
      "end_ms": 679590,
      "text": "吉川阳用经济学逻辑分析，"
    },
    {
      "segment_id": "s000344",
      "start_ms": 679590,
      "end_ms": 681770,
      "text": "长寿社会回避了分配问题。"
    },
    {
      "segment_id": "s000345",
      "start_ms": 681830,
      "end_ms": 682710,
      "text": "从效率角度，"
    },
    {
      "segment_id": "s000346",
      "start_ms": 682730,
      "end_ms": 684670,
      "text": "长寿确实能延长消费周期，"
    },
    {
      "segment_id": "s000347",
      "start_ms": 684910,
      "end_ms": 686255,
      "text": "增加人力资本积累。"
    },
    {
      "segment_id": "s000348",
      "start_ms": 686450,
      "end_ms": 687795,
      "text": "但吉川阳自己也承认，"
    },
    {
      "segment_id": "s000349",
      "start_ms": 688080,
      "end_ms": 689120,
      "text": "在零增长时代，"
    },
    {
      "segment_id": "s000350",
      "start_ms": 689220,
      "end_ms": 691265,
      "text": "分配平等才是核心任务。"
    },
    {
      "segment_id": "s000351",
      "start_ms": 691630,
      "end_ms": 692270,
      "text": "问题在于，"
    },
    {
      "segment_id": "s000352",
      "start_ms": 692570,
      "end_ms": 695590,
      "text": "他对分配的讨论远不如对创新的讨论，"
    },
    {
      "segment_id": "s000353",
      "start_ms": 695590,
      "end_ms": 696310,
      "text": "那么有信心。"
    },
    {
      "segment_id": "s000354",
      "start_ms": 696510,
      "end_ms": 697150,
      "text": "一个社会，"
    },
    {
      "segment_id": "s000355",
      "start_ms": 697150,
      "end_ms": 698715,
      "text": "如果人均GDP在涨，"
    },
    {
      "segment_id": "s000356",
      "start_ms": 699030,
      "end_ms": 700865,
      "text": "但涨的部分全被资本拿走，"
    },
    {
      "segment_id": "s000357",
      "start_ms": 701240,
      "end_ms": 702865,
      "text": "普通人的工资十年不涨，"
    },
    {
      "segment_id": "s000358",
      "start_ms": 703270,
      "end_ms": 707085,
      "text": "那人均GDP增长对普通人来说只是一个统计数字。"
    },
    {
      "segment_id": "s000359",
      "start_ms": 707900,
      "end_ms": 708655,
      "text": "吉春阳说，"
    },
    {
      "segment_id": "s000360",
      "start_ms": 709060,
      "end_ms": 710795,
      "text": "创新能提升每人所得，"
    },
    {
      "segment_id": "s000361",
      "start_ms": 711230,
      "end_ms": 713645,
      "text": "但每人所得是一个平均值，"
    },
    {
      "segment_id": "s000362",
      "start_ms": 714230,
      "end_ms": 715105,
      "text": "平均值上涨，"
    },
    {
      "segment_id": "s000363",
      "start_ms": 715370,
      "end_ms": 716645,
      "text": "不代表每个人都涨。"
    },
    {
      "segment_id": "s000364",
      "start_ms": 717070,
      "end_ms": 717990,
      "text": "有评论者指出，"
    },
    {
      "segment_id": "s000365",
      "start_ms": 718250,
      "end_ms": 720955,
      "text": "本书仅考虑生产侧而不考虑消费侧，"
    },
    {
      "segment_id": "s000366",
      "start_ms": 721420,
      "end_ms": 722960,
      "text": "创新可以提升生产力，"
    },
    {
      "segment_id": "s000367",
      "start_ms": 723000,
      "end_ms": 723980,
      "text": "促进经济增长。"
    },
    {
      "segment_id": "s000368",
      "start_ms": 724080,
      "end_ms": 726335,
      "text": "但如果人口减少导致消费力不足，"
    },
    {
      "segment_id": "s000369",
      "start_ms": 726650,
      "end_ms": 729950,
      "text": "生产力再高也无法提振经济效率。"
    },
    {
      "segment_id": "s000370",
      "start_ms": 730070,
      "end_ms": 735480,
      "text": "不是唯一的尺度、公平、尊严、社会信任这些东西，"
    },
    {
      "segment_id": "s000371",
      "start_ms": 735620,
      "end_ms": 736935,
      "text": "不尽击穿杨的公式，"
    },
    {
      "segment_id": "s000372",
      "start_ms": 737500,
      "end_ms": 738500,
      "text": "但他们竟生活。"
    },
    {
      "segment_id": "s000373",
      "start_ms": 738580,
      "end_ms": 743780,
      "text": "所以毒鸡川杨人口与日本经济真正值得带走的是思维工具。"
    },
    {
      "segment_id": "s000374",
      "start_ms": 744060,
      "end_ms": 745345,
      "text": "不是政策处方，"
    },
    {
      "segment_id": "s000375",
      "start_ms": 746360,
      "end_ms": 747545,
      "text": "人口不是宿命，"
    },
    {
      "segment_id": "s000376",
      "start_ms": 747870,
      "end_ms": 749145,
      "text": "创新创造需求，"
    },
    {
      "segment_id": "s000377",
      "start_ms": 749470,
      "end_ms": 750795,
      "text": "人均比总量重要，"
    },
    {
      "segment_id": "s000378",
      "start_ms": 751040,
      "end_ms": 752645,
      "text": "分配比增长更根本。"
    },
    {
      "segment_id": "s000379",
      "start_ms": 753150,
      "end_ms": 756695,
      "text": "这四个词是你可以拿去拆解日常焦虑的螺丝刀，"
    },
    {
      "segment_id": "s000380",
      "start_ms": 757100,
      "end_ms": 758855,
      "text": "但别把螺丝刀当锤子用。"
    },
    {
      "segment_id": "s000381",
      "start_ms": 759360,
      "end_ms": 760145,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000382",
      "start_ms": 760450,
      "end_ms": 762435,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "71d572d3501cbd6d402c701728f460b4d97f0828e8b41ce5ea7b66ff4b1cae02"
}