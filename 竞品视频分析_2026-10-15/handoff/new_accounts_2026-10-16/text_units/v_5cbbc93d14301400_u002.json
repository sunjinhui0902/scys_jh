{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_5cbbc93d14301400_u002",
  "video_id": "v_5cbbc93d14301400",
  "account": "失去壳的海龟",
  "unit_index": 2,
  "unit_count": 2,
  "duration_s": 882.847007,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000312",
      "start_ms": 801530,
      "end_ms": 803815,
      "text": "米塞斯是那个时代唯一正确的人，"
    },
    {
      "segment_id": "s000313",
      "start_ms": 804110,
      "end_ms": 805285,
      "text": "有人这样评价他，"
    },
    {
      "segment_id": "s000314",
      "start_ms": 805630,
      "end_ms": 808565,
      "text": "而这本书也替他说出了最朴素的心声。"
    },
    {
      "segment_id": "s000315",
      "start_ms": 808950,
      "end_ms": 811375,
      "text": "他一生写了数十本书和几百篇文章。"
    },
    {
      "segment_id": "s000316",
      "start_ms": 811710,
      "end_ms": 812615,
      "text": "凭着这些成果，"
    },
    {
      "segment_id": "s000317",
      "start_ms": 812820,
      "end_ms": 817995,
      "text": "他在经济学、历史学、科学、哲学和社会哲学领域都有开创性贡献。"
    },
    {
      "segment_id": "s000318",
      "start_ms": 818370,
      "end_ms": 819130,
      "text": "在他的晚年，"
    },
    {
      "segment_id": "s000319",
      "start_ms": 819470,
      "end_ms": 822425,
      "text": "眼看着自己坚持了一辈子的思想被边缘化，"
    },
    {
      "segment_id": "s000320",
      "start_ms": 822780,
      "end_ms": 825845,
      "text": "眼看着干预主义和通货膨胀在全世界蔓延，"
    },
    {
      "segment_id": "s000321",
      "start_ms": 826220,
      "end_ms": 827475,
      "text": "他仍然没有妥协。"
    },
    {
      "segment_id": "s000322",
      "start_ms": 828020,
      "end_ms": 831700,
      "text": "一九六二年已经八十一岁的他在纽约大学的演讲中，"
    },
    {
      "segment_id": "s000323",
      "start_ms": 831940,
      "end_ms": 834140,
      "text": "平静的回顾奥地利学派的历史，"
    },
    {
      "segment_id": "s000324",
      "start_ms": 834220,
      "end_ms": 836395,
      "text": "回顾那些曾经并肩战斗的同仁，"
    },
    {
      "segment_id": "s000325",
      "start_ms": 836700,
      "end_ms": 839845,
      "text": "回顾那些被误解、被冷落、被遗忘的岁月。"
    },
    {
      "segment_id": "s000326",
      "start_ms": 840410,
      "end_ms": 841270,
      "text": "他没有愤怒，"
    },
    {
      "segment_id": "s000327",
      "start_ms": 841510,
      "end_ms": 842305,
      "text": "没有怨恨，"
    },
    {
      "segment_id": "s000328",
      "start_ms": 842800,
      "end_ms": 846080,
      "text": "只是继续讲着那些他认为必须被讲清楚的道理，"
    },
    {
      "segment_id": "s000329",
      "start_ms": 846160,
      "end_ms": 850715,
      "text": "愿每一个在信息洪流中试图看清真相的人都能慢慢理解一件事，"
    },
    {
      "segment_id": "s000330",
      "start_ms": 851280,
      "end_ms": 852560,
      "text": "不是只有科班出身，"
    },
    {
      "segment_id": "s000331",
      "start_ms": 852600,
      "end_ms": 854735,
      "text": "拿过诺奖的人才配谈经济，"
    },
    {
      "segment_id": "s000332",
      "start_ms": 855110,
      "end_ms": 856690,
      "text": "而是那些愿意不断学习，"
    },
    {
      "segment_id": "s000333",
      "start_ms": 857010,
      "end_ms": 858895,
      "text": "愿意承认自己以前想错了，"
    },
    {
      "segment_id": "s000334",
      "start_ms": 859170,
      "end_ms": 861345,
      "text": "愿意在实践中修正判断的人，"
    },
    {
      "segment_id": "s000335",
      "start_ms": 861670,
      "end_ms": 864785,
      "text": "更容易在这个复杂的经济世界里活得不那么糊涂。"
    },
    {
      "segment_id": "s000336",
      "start_ms": 865190,
      "end_ms": 870265,
      "text": "因为我们在看见自己那些曾经被忽悠、被收割、被焦虑裹挟的样子之后，"
    },
    {
      "segment_id": "s000337",
      "start_ms": 870670,
      "end_ms": 871810,
      "text": "既有勇气说一句，"
    },
    {
      "segment_id": "s000338",
      "start_ms": 872050,
      "end_ms": 873505,
      "text": "确实以前太天真了。"
    },
    {
      "segment_id": "s000339",
      "start_ms": 874030,
      "end_ms": 874750,
      "text": "也有勇气，"
    },
    {
      "segment_id": "s000340",
      "start_ms": 874750,
      "end_ms": 875910,
      "text": "在学会这些之后，"
    },
    {
      "segment_id": "s000341",
      "start_ms": 875910,
      "end_ms": 879745,
      "text": "继续相信清醒本身就是一种力量。"
    },
    {
      "segment_id": "s000342",
      "start_ms": 880020,
      "end_ms": 880765,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000343",
      "start_ms": 881070,
      "end_ms": 882725,
      "text": "欢迎持续关注我们下本书见。"
    }
  ],
  "source_transcript_sha256": "51a78d79bb01c8d13c6d460058d70a82f8f73eb3125ad4d369895a56037d495b"
}