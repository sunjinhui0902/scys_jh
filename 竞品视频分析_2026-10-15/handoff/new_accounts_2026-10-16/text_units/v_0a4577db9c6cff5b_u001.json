{
  "schema_version": "text-unit-1.0",
  "unit_id": "v_0a4577db9c6cff5b_u001",
  "video_id": "v_0a4577db9c6cff5b",
  "account": "失去壳的海龟",
  "unit_index": 1,
  "unit_count": 1,
  "duration_s": 754.672993,
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "full_read_required": true,
  "segments": [
    {
      "segment_id": "s000001",
      "start_ms": 250,
      "end_ms": 830,
      "text": "有一本书，"
    },
    {
      "segment_id": "s000002",
      "start_ms": 1050,
      "end_ms": 5610,
      "text": "它是由一位改变中国命运的科学家钱学森院士亲自点题，"
    },
    {
      "segment_id": "s000003",
      "start_ms": 6050,
      "end_ms": 7790,
      "text": "一位化学家放弃实验室，"
    },
    {
      "segment_id": "s000004",
      "start_ms": 7790,
      "end_ms": 10630,
      "text": "前途用三十多年行走江湖完成的。"
    },
    {
      "segment_id": "s000005",
      "start_ms": 11110,
      "end_ms": 13150,
      "text": "他在学术圈内部被反复讨论，"
    },
    {
      "segment_id": "s000006",
      "start_ms": 13330,
      "end_ms": 15710,
      "text": "却在普通读者的书架上几乎缺席。"
    },
    {
      "segment_id": "s000007",
      "start_ms": 16010,
      "end_ms": 16970,
      "text": "不是因为它不好，"
    },
    {
      "segment_id": "s000008",
      "start_ms": 17470,
      "end_ms": 19310,
      "text": "而是因为他太反常识，"
    },
    {
      "segment_id": "s000009",
      "start_ms": 19550,
      "end_ms": 20470,
      "text": "反常识到会，"
    },
    {
      "segment_id": "s000010",
      "start_ms": 20470,
      "end_ms": 25170,
      "text": "让你过去二三十年对道这个字的理解发生一场彻底的坍塌。"
    },
    {
      "segment_id": "s000011",
      "start_ms": 25650,
      "end_ms": 26010,
      "text": "作者，"
    },
    {
      "segment_id": "s000012",
      "start_ms": 26010,
      "end_ms": 30340,
      "text": "胡福琛是中国社会科学院哲学研究所研究员、博士生导师，"
    },
    {
      "segment_id": "s000013",
      "start_ms": 30620,
      "end_ms": 33520,
      "text": "全国老子道学文化研究会创会会长。"
    },
    {
      "segment_id": "s000014",
      "start_ms": 33920,
      "end_ms": 37400,
      "text": "但就是这个享受国务院政府特殊津贴的体制内学者，"
    },
    {
      "segment_id": "s000015",
      "start_ms": 37620,
      "end_ms": 39520,
      "text": "用他化学系出身的理科生，"
    },
    {
      "segment_id": "s000016",
      "start_ms": 39520,
      "end_ms": 43340,
      "text": "大脑做了一件让整个中文学术圈坐立不安的事。"
    },
    {
      "segment_id": "s000017",
      "start_ms": 43780,
      "end_ms": 46500,
      "text": "他把道学从江湖术士的挂摊上，"
    },
    {
      "segment_id": "s000018",
      "start_ms": 46700,
      "end_ms": 48420,
      "text": "从假道学的固纸堆里，"
    },
    {
      "segment_id": "s000019",
      "start_ms": 48600,
      "end_ms": 54100,
      "text": "从西方哲学坐标系下的东方神秘主义标签中硬生生拽了出来，"
    },
    {
      "segment_id": "s000020",
      "start_ms": 54180,
      "end_ms": 55500,
      "text": "拍在桌上说，"
    },
    {
      "segment_id": "s000021",
      "start_ms": 55820,
      "end_ms": 57400,
      "text": "你们全都看错了。"
    },
    {
      "segment_id": "s000022",
      "start_ms": 57420,
      "end_ms": 61810,
      "text": "今天这条文字我会拆出这本书里最颠覆的五个底层认知。"
    },
    {
      "segment_id": "s000023",
      "start_ms": 61990,
      "end_ms": 62870,
      "text": "但我要提前警告，"
    },
    {
      "segment_id": "s000024",
      "start_ms": 62870,
      "end_ms": 69090,
      "text": "你看完后你可能会推翻过去二十年、三十年对中国传统文化奉为归孽的理解。"
    },
    {
      "segment_id": "s000025",
      "start_ms": 69150,
      "end_ms": 70565,
      "text": "如果没准备好被冒犯，"
    },
    {
      "segment_id": "s000026",
      "start_ms": 70830,
      "end_ms": 72005,
      "text": "现在划走还来得及。"
    },
    {
      "segment_id": "s000027",
      "start_ms": 72400,
      "end_ms": 73515,
      "text": "如果你选择留下来，"
    },
    {
      "segment_id": "s000028",
      "start_ms": 73670,
      "end_ms": 74925,
      "text": "那我们开始进入正题。"
    },
    {
      "segment_id": "s000029",
      "start_ms": 75160,
      "end_ms": 78005,
      "text": "第一层颠覆道学不是道家，"
    },
    {
      "segment_id": "s000030",
      "start_ms": 78340,
      "end_ms": 79160,
      "text": "更不是道叫，"
    },
    {
      "segment_id": "s000031",
      "start_ms": 79480,
      "end_ms": 80820,
      "text": "你连名字都叫错了。"
    },
    {
      "segment_id": "s000032",
      "start_ms": 80820,
      "end_ms": 82425,
      "text": "你有没有发现一个诡异的现象，"
    },
    {
      "segment_id": "s000033",
      "start_ms": 82780,
      "end_ms": 85525,
      "text": "所有中国人都能说两句道可道非常道，"
    },
    {
      "segment_id": "s000034",
      "start_ms": 85980,
      "end_ms": 88465,
      "text": "但没人能说清楚道学到底是什么。"
    },
    {
      "segment_id": "s000035",
      "start_ms": 88810,
      "end_ms": 90090,
      "text": "中小学课本告诉你，"
    },
    {
      "segment_id": "s000036",
      "start_ms": 90170,
      "end_ms": 91910,
      "text": "道家是诸子百家之一，"
    },
    {
      "segment_id": "s000037",
      "start_ms": 92050,
      "end_ms": 93750,
      "text": "代表人物老子庄子，"
    },
    {
      "segment_id": "s000038",
      "start_ms": 93930,
      "end_ms": 95395,
      "text": "主张清净无为。"
    },
    {
      "segment_id": "s000039",
      "start_ms": 95870,
      "end_ms": 97195,
      "text": "大学哲学系告诉你，"
    },
    {
      "segment_id": "s000040",
      "start_ms": 97520,
      "end_ms": 99900,
      "text": "道教是中国本土宗教东汉。"
    },
    {
      "segment_id": "s000041",
      "start_ms": 99900,
      "end_ms": 103690,
      "text": "张道林创立讲究炼丹修仙这两句话，"
    },
    {
      "segment_id": "s000042",
      "start_ms": 103870,
      "end_ms": 105430,
      "text": "把道学切成了一句，"
    },
    {
      "segment_id": "s000043",
      "start_ms": 105430,
      "end_ms": 106190,
      "text": "只有骨架，"
    },
    {
      "segment_id": "s000044",
      "start_ms": 106190,
      "end_ms": 107370,
      "text": "没有蟹肉的标本。"
    },
    {
      "segment_id": "s000045",
      "start_ms": 107510,
      "end_ms": 110914,
      "text": "吴富琛在道学入门开篇就砸碎了这套分类。"
    },
    {
      "segment_id": "s000046",
      "start_ms": 111370,
      "end_ms": 111945,
      "text": "他指出，"
    },
    {
      "segment_id": "s000047",
      "start_ms": 112300,
      "end_ms": 115075,
      "text": "道学之名始建于隋书经籍制，"
    },
    {
      "segment_id": "s000048",
      "start_ms": 115450,
      "end_ms": 117790,
      "text": "原指老子创立的有关道的学说，"
    },
    {
      "segment_id": "s000049",
      "start_ms": 117990,
      "end_ms": 120460,
      "text": "涵盖哲学的道家、宗教学的道教，"
    },
    {
      "segment_id": "s000050",
      "start_ms": 120560,
      "end_ms": 123215,
      "text": "以及属于人体生命科学范围的内丹学。"
    },
    {
      "segment_id": "s000051",
      "start_ms": 123570,
      "end_ms": 125610,
      "text": "这三个东西从来不是并列关系，"
    },
    {
      "segment_id": "s000052",
      "start_ms": 125810,
      "end_ms": 127965,
      "text": "是一个根系上的三棵枝干，"
    },
    {
      "segment_id": "s000053",
      "start_ms": 128310,
      "end_ms": 130995,
      "text": "你砍掉任何一棵整棵树都活不成，"
    },
    {
      "segment_id": "s000054",
      "start_ms": 131450,
      "end_ms": 133835,
      "text": "更狠的是他对假道学的清算。"
    },
    {
      "segment_id": "s000055",
      "start_ms": 134390,
      "end_ms": 139275,
      "text": "元代托托把周敦颐二城朱熹塞进宋史道学传。"
    },
    {
      "segment_id": "s000056",
      "start_ms": 139690,
      "end_ms": 140090,
      "text": "从此，"
    },
    {
      "segment_id": "s000057",
      "start_ms": 140170,
      "end_ms": 143895,
      "text": "程朱理学鸠占雀巢成了道学的正统代言。"
    },
    {
      "segment_id": "s000058",
      "start_ms": 144770,
      "end_ms": 146365,
      "text": "胡富琛毫不客气的指出，"
    },
    {
      "segment_id": "s000059",
      "start_ms": 146690,
      "end_ms": 149450,
      "text": "自明代李治至清末皆有人揭露，"
    },
    {
      "segment_id": "s000060",
      "start_ms": 149470,
      "end_ms": 151975,
      "text": "将宋明理学称作道学之伪，"
    },
    {
      "segment_id": "s000061",
      "start_ms": 152420,
      "end_ms": 152800,
      "text": "指出，"
    },
    {
      "segment_id": "s000062",
      "start_ms": 152800,
      "end_ms": 155695,
      "text": "仅有老子庄子的学说才是真道学。"
    },
    {
      "segment_id": "s000063",
      "start_ms": 156090,
      "end_ms": 158690,
      "text": "你今天在国学班上背的存天理，"
    },
    {
      "segment_id": "s000064",
      "start_ms": 158690,
      "end_ms": 159290,
      "text": "灭人欲，"
    },
    {
      "segment_id": "s000065",
      "start_ms": 159530,
      "end_ms": 161270,
      "text": "跟老子道法自然，"
    },
    {
      "segment_id": "s000066",
      "start_ms": 161310,
      "end_ms": 162570,
      "text": "压根儿不是一回事。"
    },
    {
      "segment_id": "s000067",
      "start_ms": 162630,
      "end_ms": 165070,
      "text": "一个是给皇权递刀子的伦理枷锁。"
    },
    {
      "segment_id": "s000068",
      "start_ms": 165330,
      "end_ms": 168410,
      "text": "一个是教你在天地间站着做人的生命哲学，"
    },
    {
      "segment_id": "s000069",
      "start_ms": 168670,
      "end_ms": 170445,
      "text": "这听上去像学术考据，"
    },
    {
      "segment_id": "s000070",
      "start_ms": 170820,
      "end_ms": 173085,
      "text": "但他的杀伤力远超你的想象。"
    },
    {
      "segment_id": "s000071",
      "start_ms": 173490,
      "end_ms": 176255,
      "text": "当你把程朱理学误认作道学正统，"
    },
    {
      "segment_id": "s000072",
      "start_ms": 176600,
      "end_ms": 179245,
      "text": "你整个文化坐标系的原点就偏了。"
    },
    {
      "segment_id": "s000073",
      "start_ms": 179810,
      "end_ms": 181150,
      "text": "你以为是儒道互补，"
    },
    {
      "segment_id": "s000074",
      "start_ms": 181550,
      "end_ms": 183970,
      "text": "其实你一直被伪道学喂养了。"
    },
    {
      "segment_id": "s000075",
      "start_ms": 183970,
      "end_ms": 184570,
      "text": "七百年。"
    },
    {
      "segment_id": "s000076",
      "start_ms": 185450,
      "end_ms": 186250,
      "text": "胡富琛说。"
    },
    {
      "segment_id": "s000077",
      "start_ms": 186550,
      "end_ms": 187450,
      "text": "他写这本书，"
    },
    {
      "segment_id": "s000078",
      "start_ms": 187570,
      "end_ms": 188990,
      "text": "就是为了为道学，"
    },
    {
      "segment_id": "s000079",
      "start_ms": 189070,
      "end_ms": 191510,
      "text": "证明不是争一个学术标签，"
    },
    {
      "segment_id": "s000080",
      "start_ms": 191890,
      "end_ms": 195290,
      "text": "是要把被篡改的文明源代码重新翻出来。"
    },
    {
      "segment_id": "s000081",
      "start_ms": 195310,
      "end_ms": 195790,
      "text": "第二层，"
    },
    {
      "segment_id": "s000082",
      "start_ms": 195790,
      "end_ms": 196950,
      "text": "颠覆道学，"
    },
    {
      "segment_id": "s000083",
      "start_ms": 197030,
      "end_ms": 198270,
      "text": "不是弱者的哲学，"
    },
    {
      "segment_id": "s000084",
      "start_ms": 198490,
      "end_ms": 200250,
      "text": "是真正强者的哲学。"
    },
    {
      "segment_id": "s000085",
      "start_ms": 200310,
      "end_ms": 202330,
      "text": "你脑子里是不是自动蹦出了一幅画面？"
    },
    {
      "segment_id": "s000086",
      "start_ms": 202750,
      "end_ms": 204670,
      "text": "深山老林白发老道，"
    },
    {
      "segment_id": "s000087",
      "start_ms": 204870,
      "end_ms": 205810,
      "text": "打坐冥想，"
    },
    {
      "segment_id": "s000088",
      "start_ms": 205950,
      "end_ms": 206770,
      "text": "不问世事，"
    },
    {
      "segment_id": "s000089",
      "start_ms": 207330,
      "end_ms": 210020,
      "text": "这就是主流叙事给你植入的道学形象。"
    },
    {
      "segment_id": "s000090",
      "start_ms": 210460,
      "end_ms": 213020,
      "text": "胡福琛用一句话把这张图撕了。"
    },
    {
      "segment_id": "s000091",
      "start_ms": 213220,
      "end_ms": 215300,
      "text": "道学不是消极的哲学，"
    },
    {
      "segment_id": "s000092",
      "start_ms": 215300,
      "end_ms": 216920,
      "text": "而是积极的哲学，"
    },
    {
      "segment_id": "s000093",
      "start_ms": 216920,
      "end_ms": 218840,
      "text": "不是弱者的哲学，"
    },
    {
      "segment_id": "s000094",
      "start_ms": 218840,
      "end_ms": 221180,
      "text": "而是真正强者的哲学。"
    },
    {
      "segment_id": "s000095",
      "start_ms": 221180,
      "end_ms": 223080,
      "text": "他在书里做了一个惊人的概念，"
    },
    {
      "segment_id": "s000096",
      "start_ms": 223080,
      "end_ms": 231860,
      "text": "翻转道学的核心思想是建构一个模拟自然界或者人体生命的自组织自调节的最优的自动化系统。"
    },
    {
      "segment_id": "s000097",
      "start_ms": 232400,
      "end_ms": 235460,
      "text": "这个系统几乎天地人之道，"
    },
    {
      "segment_id": "s000098",
      "start_ms": 235820,
      "end_ms": 237920,
      "text": "无亲无疏大功。"
    },
    {
      "segment_id": "s000099",
      "start_ms": 238000,
      "end_ms": 240070,
      "text": "大慈是一种万物，"
    },
    {
      "segment_id": "s000100",
      "start_ms": 240130,
      "end_ms": 242735,
      "text": "将自化的自然之治的社会。"
    },
    {
      "segment_id": "s000101",
      "start_ms": 243430,
      "end_ms": 244545,
      "text": "你读三遍这句话，"
    },
    {
      "segment_id": "s000102",
      "start_ms": 244860,
      "end_ms": 246965,
      "text": "再想想清静无为四个字，"
    },
    {
      "segment_id": "s000103",
      "start_ms": 247390,
      "end_ms": 250150,
      "text": "你会发现无为根本不是不作为，"
    },
    {
      "segment_id": "s000104",
      "start_ms": 250450,
      "end_ms": 252530,
      "text": "是不妄为不强为，"
    },
    {
      "segment_id": "s000105",
      "start_ms": 252770,
      "end_ms": 254365,
      "text": "不逆规律而为，"
    },
    {
      "segment_id": "s000106",
      "start_ms": 254770,
      "end_ms": 256430,
      "text": "这是最高级的战略思维，"
    },
    {
      "segment_id": "s000107",
      "start_ms": 256550,
      "end_ms": 257455,
      "text": "不是躺平。"
    },
    {
      "segment_id": "s000108",
      "start_ms": 257980,
      "end_ms": 273170,
      "text": "胡福琛把道学拆解为八大支柱人行道、哲学、政治、管理学、文艺、审美学、医药、养生学、宗教、伦理学、自然生态学、单道性命、学方技术、数学、八根柱子，"
    },
    {
      "segment_id": "s000109",
      "start_ms": 273170,
      "end_ms": 275840,
      "text": "撑起来的是一座完整的文明殿堂，"
    },
    {
      "segment_id": "s000110",
      "start_ms": 276120,
      "end_ms": 279665,
      "text": "涵盖哲学、治国、养生、民俗科技。"
    },
    {
      "segment_id": "s000111",
      "start_ms": 279980,
      "end_ms": 281415,
      "text": "你告诉我这叫消极，"
    },
    {
      "segment_id": "s000112",
      "start_ms": 282240,
      "end_ms": 288075,
      "text": "这是把宇宙社会生命当做一个整体来经营的顶级的系统论。"
    },
    {
      "segment_id": "s000113",
      "start_ms": 288540,
      "end_ms": 291040,
      "text": "你总说传统文化博大精深，"
    },
    {
      "segment_id": "s000114",
      "start_ms": 291460,
      "end_ms": 292455,
      "text": "可你有没有想过，"
    },
    {
      "segment_id": "s000115",
      "start_ms": 292750,
      "end_ms": 297870,
      "text": "你所谓的博大到底是被切割成旅游景点和养生鸡汤之后的残渣，"
    },
    {
      "segment_id": "s000116",
      "start_ms": 298010,
      "end_ms": 301055,
      "text": "还是本来那个贯通天地人的完整体系？"
    },
    {
      "segment_id": "s000117",
      "start_ms": 301460,
      "end_ms": 302895,
      "text": "胡福琛的答案很明确，"
    },
    {
      "segment_id": "s000118",
      "start_ms": 303440,
      "end_ms": 308945,
      "text": "道学是参天地藏化玉贯中西通古今的大学问。"
    },
    {
      "segment_id": "s000119",
      "start_ms": 309430,
      "end_ms": 310870,
      "text": "你把最硬的骨头丢了，"
    },
    {
      "segment_id": "s000120",
      "start_ms": 311030,
      "end_ms": 312150,
      "text": "只剪了顺其自然。"
    },
    {
      "segment_id": "s000121",
      "start_ms": 312150,
      "end_ms": 313630,
      "text": "这根软刺当安慰剂。"
    },
    {
      "segment_id": "s000122",
      "start_ms": 313870,
      "end_ms": 316750,
      "text": "第三层颠覆西方哲学的主课二分，"
    },
    {
      "segment_id": "s000123",
      "start_ms": 316850,
      "end_ms": 318470,
      "text": "在道学面前碎了一地。"
    },
    {
      "segment_id": "s000124",
      "start_ms": 318790,
      "end_ms": 322850,
      "text": "你从小被教育唯物主义和唯心主义是哲学的两大阵营，"
    },
    {
      "segment_id": "s000125",
      "start_ms": 323230,
      "end_ms": 324390,
      "text": "物质决定意识，"
    },
    {
      "segment_id": "s000126",
      "start_ms": 324590,
      "end_ms": 326250,
      "text": "意识反作用于物质。"
    },
    {
      "segment_id": "s000127",
      "start_ms": 326970,
      "end_ms": 332770,
      "text": "这套框架让你觉得所有哲学问题最终都能归到谁决定谁的战队上不负琛，"
    },
    {
      "segment_id": "s000128",
      "start_ms": 332850,
      "end_ms": 337090,
      "text": "用化学背景和系统科学思维捅破了这层窗户纸。"
    },
    {
      "segment_id": "s000129",
      "start_ms": 337250,
      "end_ms": 337630,
      "text": "他说，"
    },
    {
      "segment_id": "s000130",
      "start_ms": 337990,
      "end_ms": 342740,
      "text": "西方哲学自苏格拉底到黑格尔都以罗格斯中心论创立体系，"
    },
    {
      "segment_id": "s000131",
      "start_ms": 343060,
      "end_ms": 345620,
      "text": "主克二分的思维模式被牢固确立，"
    },
    {
      "segment_id": "s000132",
      "start_ms": 346140,
      "end_ms": 349680,
      "text": "但中国哲学是一种究天人之际的学说。"
    },
    {
      "segment_id": "s000133",
      "start_ms": 350060,
      "end_ms": 352080,
      "text": "即使是将天地的内容，"
    },
    {
      "segment_id": "s000134",
      "start_ms": 352080,
      "end_ms": 353820,
      "text": "包括在一起的自然之天，"
    },
    {
      "segment_id": "s000135",
      "start_ms": 354200,
      "end_ms": 356320,
      "text": "也和西方哲学中的自然界不一样。"
    },
    {
      "segment_id": "s000136",
      "start_ms": 356680,
      "end_ms": 358600,
      "text": "中国哲学家为自然之天，"
    },
    {
      "segment_id": "s000137",
      "start_ms": 358680,
      "end_ms": 361100,
      "text": "也是有灵性有意志的人，"
    },
    {
      "segment_id": "s000138",
      "start_ms": 361160,
      "end_ms": 362360,
      "text": "不能逆天而行。"
    },
    {
      "segment_id": "s000139",
      "start_ms": 362540,
      "end_ms": 366680,
      "text": "他提出了一个让物理学界都得侧目的框架两重世界。"
    },
    {
      "segment_id": "s000140",
      "start_ms": 366900,
      "end_ms": 368400,
      "text": "四个阴阳宇宙中，"
    },
    {
      "segment_id": "s000141",
      "start_ms": 368400,
      "end_ms": 373765,
      "text": "除了我们这个有形有相有质可观察、可测量的现实世界之外，"
    },
    {
      "segment_id": "s000142",
      "start_ms": 374280,
      "end_ms": 376700,
      "text": "还有一个无形、无相、无质，"
    },
    {
      "segment_id": "s000143",
      "start_ms": 376860,
      "end_ms": 380645,
      "text": "无法观察、难以测量的虚无、空灵的世界，"
    },
    {
      "segment_id": "s000144",
      "start_ms": 381210,
      "end_ms": 383245,
      "text": "两重世界都是关系的实在。"
    },
    {
      "segment_id": "s000145",
      "start_ms": 383560,
      "end_ms": 385020,
      "text": "但前一虫为实体，"
    },
    {
      "segment_id": "s000146",
      "start_ms": 385240,
      "end_ms": 386655,
      "text": "后一虫为虚体，"
    },
    {
      "segment_id": "s000147",
      "start_ms": 387170,
      "end_ms": 388765,
      "text": "人体是一个小宇宙，"
    },
    {
      "segment_id": "s000148",
      "start_ms": 389290,
      "end_ms": 390810,
      "text": "先天的人体称作法，"
    },
    {
      "segment_id": "s000149",
      "start_ms": 390830,
      "end_ms": 393505,
      "text": "身后天的人体称作色参，"
    },
    {
      "segment_id": "s000150",
      "start_ms": 394060,
      "end_ms": 396775,
      "text": "先天世界和后天世界都由阴阳组成，"
    },
    {
      "segment_id": "s000151",
      "start_ms": 397070,
      "end_ms": 398290,
      "text": "这就是四个阴阳，"
    },
    {
      "segment_id": "s000152",
      "start_ms": 398570,
      "end_ms": 399530,
      "text": "这不是玄学。"
    },
    {
      "segment_id": "s000153",
      "start_ms": 399690,
      "end_ms": 404965,
      "text": "胡富琛用信息论、系统科学和现代物理学做了严格的数学推演。"
    },
    {
      "segment_id": "s000154",
      "start_ms": 405350,
      "end_ms": 410165,
      "text": "宇宙中的信息能量物质可以按一定数学关系相互转化，"
    },
    {
      "segment_id": "s000155",
      "start_ms": 410460,
      "end_ms": 411840,
      "text": "在孤立系统中守恒。"
    },
    {
      "segment_id": "s000156",
      "start_ms": 412200,
      "end_ms": 414040,
      "text": "基本粒子同时具有波动性，"
    },
    {
      "segment_id": "s000157",
      "start_ms": 414200,
      "end_ms": 417010,
      "text": "粒子性选择性选择性，"
    },
    {
      "segment_id": "s000158",
      "start_ms": 417010,
      "end_ms": 418785,
      "text": "本质上是一种心灵特征。"
    },
    {
      "segment_id": "s000159",
      "start_ms": 419460,
      "end_ms": 420940,
      "text": "宇宙小致基本粒子，"
    },
    {
      "segment_id": "s000160",
      "start_ms": 420960,
      "end_ms": 423320,
      "text": "大智银河系自创生起，"
    },
    {
      "segment_id": "s000161",
      "start_ms": 423400,
      "end_ms": 425415,
      "text": "就有核目的性的选择趋势。"
    },
    {
      "segment_id": "s000162",
      "start_ms": 425690,
      "end_ms": 426345,
      "text": "换句话说，"
    },
    {
      "segment_id": "s000163",
      "start_ms": 426730,
      "end_ms": 428490,
      "text": "你以为道学在讲玄虚，"
    },
    {
      "segment_id": "s000164",
      "start_ms": 428850,
      "end_ms": 432835,
      "text": "其实他在讲一套连现代科学都还没消化完的宇宙模型。"
    },
    {
      "segment_id": "s000165",
      "start_ms": 433420,
      "end_ms": 435200,
      "text": "你嘲笑阴阳五行是迷信，"
    },
    {
      "segment_id": "s000166",
      "start_ms": 435400,
      "end_ms": 436285,
      "text": "你有没有想过，"
    },
    {
      "segment_id": "s000167",
      "start_ms": 436650,
      "end_ms": 443390,
      "text": "可能是你的科学观太窄窄到容不下一套比笛卡尔早了两千年的心物依缘。"
    },
    {
      "segment_id": "s000168",
      "start_ms": 443390,
      "end_ms": 445170,
      "text": "论第四层颠覆单道，"
    },
    {
      "segment_id": "s000169",
      "start_ms": 445190,
      "end_ms": 445985,
      "text": "不是修仙，"
    },
    {
      "segment_id": "s000170",
      "start_ms": 446300,
      "end_ms": 450105,
      "text": "是被江湖和伟学联手封杀的顶级生命科学。"
    },
    {
      "segment_id": "s000171",
      "start_ms": 450840,
      "end_ms": 452760,
      "text": "市面上所有讲单道的书，"
    },
    {
      "segment_id": "s000172",
      "start_ms": 452800,
      "end_ms": 454120,
      "text": "要么是秘传口诀，"
    },
    {
      "segment_id": "s000173",
      "start_ms": 454120,
      "end_ms": 455265,
      "text": "大公开的猎奇，"
    },
    {
      "segment_id": "s000174",
      "start_ms": 455670,
      "end_ms": 458690,
      "text": "要么是三天结单七天出神的江湖骗术，"
    },
    {
      "segment_id": "s000175",
      "start_ms": 458750,
      "end_ms": 460710,
      "text": "你被这两种东西夹击了几十年，"
    },
    {
      "segment_id": "s000176",
      "start_ms": 460910,
      "end_ms": 461890,
      "text": "结论只有一个，"
    },
    {
      "segment_id": "s000177",
      "start_ms": 462190,
      "end_ms": 463175,
      "text": "单道是假的。"
    },
    {
      "segment_id": "s000178",
      "start_ms": 463750,
      "end_ms": 466175,
      "text": "胡福琛做了一件前无古人的事儿。"
    },
    {
      "segment_id": "s000179",
      "start_ms": 466810,
      "end_ms": 467670,
      "text": "一九八零年，"
    },
    {
      "segment_id": "s000180",
      "start_ms": 467750,
      "end_ms": 469490,
      "text": "他接受钱学森院士的委托，"
    },
    {
      "segment_id": "s000181",
      "start_ms": 469770,
      "end_ms": 471295,
      "text": "为人体科学做贡献，"
    },
    {
      "segment_id": "s000182",
      "start_ms": 471690,
      "end_ms": 473130,
      "text": "跋涉江湖遍迹，"
    },
    {
      "segment_id": "s000183",
      "start_ms": 473130,
      "end_ms": 474710,
      "text": "山林倾覆康葬，"
    },
    {
      "segment_id": "s000184",
      "start_ms": 474930,
      "end_ms": 475825,
      "text": "出入禅秘。"
    },
    {
      "segment_id": "s000185",
      "start_ms": 476150,
      "end_ms": 477250,
      "text": "历时二十六年，"
    },
    {
      "segment_id": "s000186",
      "start_ms": 477450,
      "end_ms": 482210,
      "text": "以现代科学和中西哲学精神分析学、中西医学的视角，"
    },
    {
      "segment_id": "s000187",
      "start_ms": 482250,
      "end_ms": 483690,
      "text": "破译内丹学的奥秘。"
    },
    {
      "segment_id": "s000188",
      "start_ms": 483770,
      "end_ms": 485530,
      "text": "一个南开化学系毕业的人，"
    },
    {
      "segment_id": "s000189",
      "start_ms": 485710,
      "end_ms": 489960,
      "text": "把丹金当化学实验记录来读考证文献源流，"
    },
    {
      "segment_id": "s000190",
      "start_ms": 490200,
      "end_ms": 491500,
      "text": "辨别后世赋会，"
    },
    {
      "segment_id": "s000191",
      "start_ms": 491760,
      "end_ms": 494035,
      "text": "运用信息论与系统科学思想，"
    },
    {
      "segment_id": "s000192",
      "start_ms": 494290,
      "end_ms": 497565,
      "text": "将散乱如碎片的单晶概念进行逻辑归类。"
    },
    {
      "segment_id": "s000193",
      "start_ms": 498630,
      "end_ms": 508085,
      "text": "他出版了单道法诀十二讲分数自身阴阳清净单法、虚空阴阳丹、法西派单法等三家四派修炼体系，"
    },
    {
      "segment_id": "s000194",
      "start_ms": 508450,
      "end_ms": 511385,
      "text": "归纳南宗北宗等九派单法要诀。"
    },
    {
      "segment_id": "s000195",
      "start_ms": 511810,
      "end_ms": 513825,
      "text": "但他做这件事的代价是巨大的。"
    },
    {
      "segment_id": "s000196",
      "start_ms": 514570,
      "end_ms": 515350,
      "text": "学术界说，"
    },
    {
      "segment_id": "s000197",
      "start_ms": 515430,
      "end_ms": 518540,
      "text": "他把学术搞成了玄学修行界说，"
    },
    {
      "segment_id": "s000198",
      "start_ms": 518540,
      "end_ms": 520425,
      "text": "他把秘传泄露给了凡人，"
    },
    {
      "segment_id": "s000199",
      "start_ms": 520840,
      "end_ms": 522340,
      "text": "两边都不认他有人拿。"
    },
    {
      "segment_id": "s000200",
      "start_ms": 522340,
      "end_ms": 524180,
      "text": "他和张志顺道长比较说，"
    },
    {
      "segment_id": "s000201",
      "start_ms": 524180,
      "end_ms": 525120,
      "text": "他修炼几十年，"
    },
    {
      "segment_id": "s000202",
      "start_ms": 525140,
      "end_ms": 526515,
      "text": "精神状态还不如普通人。"
    },
    {
      "segment_id": "s000203",
      "start_ms": 527020,
      "end_ms": 528175,
      "text": "胡福琛自己说，"
    },
    {
      "segment_id": "s000204",
      "start_ms": 528540,
      "end_ms": 529855,
      "text": "他干冒诸多诽谤，"
    },
    {
      "segment_id": "s000205",
      "start_ms": 530160,
      "end_ms": 532825,
      "text": "将单道绝学从天上搬到人间，"
    },
    {
      "segment_id": "s000206",
      "start_ms": 533110,
      "end_ms": 534510,
      "text": "从江湖文化改造，"
    },
    {
      "segment_id": "s000207",
      "start_ms": 534510,
      "end_ms": 536610,
      "text": "为学术文化更无意忘传。"
    },
    {
      "segment_id": "s000208",
      "start_ms": 536630,
      "end_ms": 538030,
      "text": "匪人使之得法后，"
    },
    {
      "segment_id": "s000209",
      "start_ms": 538090,
      "end_ms": 540050,
      "text": "以邪教或是邪道骗财，"
    },
    {
      "segment_id": "s000210",
      "start_ms": 540450,
      "end_ms": 543450,
      "text": "而是要借此培养和成就一批道学人才，"
    },
    {
      "segment_id": "s000211",
      "start_ms": 543750,
      "end_ms": 546145,
      "text": "将新道学文化推向全世界。"
    },
    {
      "segment_id": "s000212",
      "start_ms": 546700,
      "end_ms": 547100,
      "text": "这段话，"
    },
    {
      "segment_id": "s000213",
      "start_ms": 547100,
      "end_ms": 547835,
      "text": "你仔细读，"
    },
    {
      "segment_id": "s000214",
      "start_ms": 548110,
      "end_ms": 550715,
      "text": "会发现他根本不是要证明单道灵不灵。"
    },
    {
      "segment_id": "s000215",
      "start_ms": 551090,
      "end_ms": 555045,
      "text": "他要证明的是一个被江湖骗子糟蹋了两千年的东西，"
    },
    {
      "segment_id": "s000216",
      "start_ms": 555330,
      "end_ms": 558455,
      "text": "能不能用现代学术的方法论把它抢救回来，"
    },
    {
      "segment_id": "s000217",
      "start_ms": 558710,
      "end_ms": 561270,
      "text": "让他从迷信变成可研究的对象。"
    },
    {
      "segment_id": "s000218",
      "start_ms": 561390,
      "end_ms": 562470,
      "text": "你骂他是迷信，"
    },
    {
      "segment_id": "s000219",
      "start_ms": 562670,
      "end_ms": 565370,
      "text": "你根本没给他被认真对待的机会。"
    },
    {
      "segment_id": "s000220",
      "start_ms": 565550,
      "end_ms": 566110,
      "text": "第五层，"
    },
    {
      "segment_id": "s000221",
      "start_ms": 566110,
      "end_ms": 567640,
      "text": "颠覆道学，"
    },
    {
      "segment_id": "s000222",
      "start_ms": 567720,
      "end_ms": 568580,
      "text": "不是中国的，"
    },
    {
      "segment_id": "s000223",
      "start_ms": 568720,
      "end_ms": 570460,
      "text": "是全人类的文化战略。"
    },
    {
      "segment_id": "s000224",
      "start_ms": 570460,
      "end_ms": 571235,
      "text": "你可能会问，"
    },
    {
      "segment_id": "s000225",
      "start_ms": 571670,
      "end_ms": 572270,
      "text": "说来说去，"
    },
    {
      "segment_id": "s000226",
      "start_ms": 572270,
      "end_ms": 574305,
      "text": "不还是弘扬传统文化那一套吗？"
    },
    {
      "segment_id": "s000227",
      "start_ms": 574860,
      "end_ms": 576815,
      "text": "胡福琛的答案比这狠十倍。"
    },
    {
      "segment_id": "s000228",
      "start_ms": 577060,
      "end_ms": 577525,
      "text": "他说，"
    },
    {
      "segment_id": "s000229",
      "start_ms": 578020,
      "end_ms": 578960,
      "text": "创立新道学，"
    },
    {
      "segment_id": "s000230",
      "start_ms": 579100,
      "end_ms": 585295,
      "text": "是中华民族在世界历史潮流中审时度势、应变、自强的唯一可行的文化战略。"
    },
    {
      "segment_id": "s000231",
      "start_ms": 585670,
      "end_ms": 586110,
      "text": "注意，"
    },
    {
      "segment_id": "s000232",
      "start_ms": 586290,
      "end_ms": 588285,
      "text": "他用的词是唯一可行，"
    },
    {
      "segment_id": "s000233",
      "start_ms": 588750,
      "end_ms": 590205,
      "text": "这不是文化自信的口号，"
    },
    {
      "segment_id": "s000234",
      "start_ms": 590520,
      "end_ms": 592895,
      "text": "是一个学者对文明存亡的判断。"
    },
    {
      "segment_id": "s000235",
      "start_ms": 593470,
      "end_ms": 596790,
      "text": "他把新道学定义为中国文化的第三次重构，"
    },
    {
      "segment_id": "s000236",
      "start_ms": 597210,
      "end_ms": 603350,
      "text": "以对道学这一全人类共同的原生态文化进行综合创新和现代诠释为基础，"
    },
    {
      "segment_id": "s000237",
      "start_ms": 603890,
      "end_ms": 606225,
      "text": "吸收儒学佛学中的合理因素。"
    },
    {
      "segment_id": "s000238",
      "start_ms": 606530,
      "end_ms": 609010,
      "text": "将西方现代文明的精华吸收进来，"
    },
    {
      "segment_id": "s000239",
      "start_ms": 609210,
      "end_ms": 614110,
      "text": "与中华文明融合为有机整体创立及古今中外文明之精华。"
    },
    {
      "segment_id": "s000240",
      "start_ms": 614310,
      "end_ms": 616190,
      "text": "有时代精神的新道学，"
    },
    {
      "segment_id": "s000241",
      "start_ms": 616290,
      "end_ms": 617090,
      "text": "普世文明，"
    },
    {
      "segment_id": "s000242",
      "start_ms": 617390,
      "end_ms": 619790,
      "text": "以解决全世界共同面对的问题，"
    },
    {
      "segment_id": "s000243",
      "start_ms": 620370,
      "end_ms": 621290,
      "text": "你听出来了吗？"
    },
    {
      "segment_id": "s000244",
      "start_ms": 621530,
      "end_ms": 623610,
      "text": "他说的不是中国要输出文化。"
    },
    {
      "segment_id": "s000245",
      "start_ms": 624090,
      "end_ms": 624810,
      "text": "他说的是，"
    },
    {
      "segment_id": "s000246",
      "start_ms": 625110,
      "end_ms": 627050,
      "text": "人类只有这一条路，"
    },
    {
      "segment_id": "s000247",
      "start_ms": 627050,
      "end_ms": 633850,
      "text": "可以走生态危机、精神危机、文明冲突、西方主客二分的思维模式制造了这些问题。"
    },
    {
      "segment_id": "s000248",
      "start_ms": 634230,
      "end_ms": 636940,
      "text": "而道学的天人合一、两重世界，"
    },
    {
      "segment_id": "s000249",
      "start_ms": 637080,
      "end_ms": 637900,
      "text": "自然之治，"
    },
    {
      "segment_id": "s000250",
      "start_ms": 638120,
      "end_ms": 641240,
      "text": "是唯一能提供系统性解决方案的思想资源。"
    },
    {
      "segment_id": "s000251",
      "start_ms": 641320,
      "end_ms": 642320,
      "text": "胡富琛还指出，"
    },
    {
      "segment_id": "s000252",
      "start_ms": 642680,
      "end_ms": 648000,
      "text": "道学文化的新科学观必将为二十一世纪的新科学革命指明方向，"
    },
    {
      "segment_id": "s000253",
      "start_ms": 648220,
      "end_ms": 650820,
      "text": "使科学和哲学、宗教相统一，"
    },
    {
      "segment_id": "s000254",
      "start_ms": 651040,
      "end_ms": 653140,
      "text": "成为大家可以广泛了解的学问。"
    },
    {
      "segment_id": "s000255",
      "start_ms": 653220,
      "end_ms": 657820,
      "text": "他把道学从地方性知识提升到了普适性方案的高度。"
    },
    {
      "segment_id": "s000256",
      "start_ms": 658120,
      "end_ms": 660860,
      "text": "你还在争论国学该不该进课堂的时候，"
    },
    {
      "segment_id": "s000257",
      "start_ms": 661000,
      "end_ms": 664820,
      "text": "他已经把道学放到了整个人类文明演化的棋盘上。"
    },
    {
      "segment_id": "s000258",
      "start_ms": 664880,
      "end_ms": 665780,
      "text": "读完道学入门，"
    },
    {
      "segment_id": "s000259",
      "start_ms": 666040,
      "end_ms": 668245,
      "text": "你可能发现书名起的太朴素了。"
    },
    {
      "segment_id": "s000260",
      "start_ms": 668770,
      "end_ms": 670050,
      "text": "这不是一本入门读物，"
    },
    {
      "segment_id": "s000261",
      "start_ms": 670310,
      "end_ms": 676075,
      "text": "是一本关于人如何在一个被规律支配的世界里看清自己位置的生存手册。"
    },
    {
      "segment_id": "s000262",
      "start_ms": 676380,
      "end_ms": 677460,
      "text": "无为不是重点，"
    },
    {
      "segment_id": "s000263",
      "start_ms": 677620,
      "end_ms": 678975,
      "text": "八大支柱不是重点，"
    },
    {
      "segment_id": "s000264",
      "start_ms": 679340,
      "end_ms": 680920,
      "text": "升国同构不是重点，"
    },
    {
      "segment_id": "s000265",
      "start_ms": 681020,
      "end_ms": 684745,
      "text": "重点是那个从化学系转身走向江湖的学者。"
    },
    {
      "segment_id": "s000266",
      "start_ms": 685190,
      "end_ms": 687540,
      "text": "在钱学森四十年的注视下面，"
    },
    {
      "segment_id": "s000267",
      "start_ms": 687540,
      "end_ms": 692285,
      "text": "对一个充斥着伪气功、假道学和认知混乱的世界说，"
    },
    {
      "segment_id": "s000268",
      "start_ms": 692740,
      "end_ms": 693935,
      "text": "我不服从标签，"
    },
    {
      "segment_id": "s000269",
      "start_ms": 694260,
      "end_ms": 695315,
      "text": "我只服从事实。"
    },
    {
      "segment_id": "s000270",
      "start_ms": 695980,
      "end_ms": 697005,
      "text": "他看见了什么呢？"
    },
    {
      "segment_id": "s000271",
      "start_ms": 697680,
      "end_ms": 699240,
      "text": "他看见每一个顺其自然，"
    },
    {
      "segment_id": "s000272",
      "start_ms": 699240,
      "end_ms": 701670,
      "text": "背后都藏着不敢面对的怯懦。"
    },
    {
      "segment_id": "s000273",
      "start_ms": 701710,
      "end_ms": 702750,
      "text": "每一个想开点，"
    },
    {
      "segment_id": "s000274",
      "start_ms": 702750,
      "end_ms": 703150,
      "text": "背后，"
    },
    {
      "segment_id": "s000275",
      "start_ms": 703330,
      "end_ms": 705170,
      "text": "都藏着不愿深究的懒惰。"
    },
    {
      "segment_id": "s000276",
      "start_ms": 705270,
      "end_ms": 709495,
      "text": "每一个个人选择背后都藏着一套你从未看清的规律，"
    },
    {
      "segment_id": "s000277",
      "start_ms": 709830,
      "end_ms": 712295,
      "text": "而你有幸可以学会看懂这一切。"
    },
    {
      "segment_id": "s000278",
      "start_ms": 712920,
      "end_ms": 717465,
      "text": "这本书里有一句话是胡福琛在阐述道学核心思想时写的，"
    },
    {
      "segment_id": "s000279",
      "start_ms": 717780,
      "end_ms": 718775,
      "text": "我想把它送给你。"
    },
    {
      "segment_id": "s000280",
      "start_ms": 719080,
      "end_ms": 721345,
      "text": "道学不是让你变得超凡脱俗，"
    },
    {
      "segment_id": "s000281",
      "start_ms": 721810,
      "end_ms": 724935,
      "text": "让你超凡脱俗的是你的修行和悟性，"
    },
    {
      "segment_id": "s000282",
      "start_ms": 725500,
      "end_ms": 728850,
      "text": "但倒学可以让你少犯一种错误那种，"
    },
    {
      "segment_id": "s000283",
      "start_ms": 728850,
      "end_ms": 732334,
      "text": "因为你不知道自己在被什么推着走而犯的错误。"
    },
    {
      "segment_id": "s000284",
      "start_ms": 733270,
      "end_ms": 734935,
      "text": "如果你读到这里还没有划走，"
    },
    {
      "segment_id": "s000285",
      "start_ms": 735300,
      "end_ms": 738425,
      "text": "如果你隐约觉得过去对道的理解可能出了问题，"
    },
    {
      "segment_id": "s000286",
      "start_ms": 739000,
      "end_ms": 743855,
      "text": "如果你愿意给自己一个机会去重新认识这套被误解了几千年的认知系统，"
    },
    {
      "segment_id": "s000287",
      "start_ms": 744250,
      "end_ms": 747065,
      "text": "那么这本道学入门值得你带回家。"
    },
    {
      "segment_id": "s000288",
      "start_ms": 747480,
      "end_ms": 749095,
      "text": "它不是一本让你舒服的书，"
    },
    {
      "segment_id": "s000289",
      "start_ms": 749410,
      "end_ms": 751295,
      "text": "但它可能是一本让你清醒的书。"
    },
    {
      "segment_id": "s000290",
      "start_ms": 751600,
      "end_ms": 752300,
      "text": "我是小海龟，"
    },
    {
      "segment_id": "s000291",
      "start_ms": 752480,
      "end_ms": 753940,
      "text": "欢迎持续关注我们，"
    },
    {
      "segment_id": "s000292",
      "start_ms": 753940,
      "end_ms": 754545,
      "text": "下本书见。"
    }
  ],
  "source_transcript_sha256": "e7f120dd902e945c08b1b2192c3d95e0eb892e47a2809f100a2486c1fd2b2c7b"
}