{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-video full-text semantic analysis",
  "type": "object",
  "required": [
    "schema_version",
    "video_id",
    "account",
    "input_mode",
    "source_sha256",
    "started_at",
    "finished_at",
    "coverage",
    "fields",
    "evidence",
    "limitations",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "new-account-text-1.0"
    },
    "video_id": {
      "type": "string",
      "pattern": "^v_[0-9a-f]{16}$"
    },
    "account": {
      "enum": [
        "失去壳的海龟",
        "闲不住De宝"
      ]
    },
    "input_mode": {
      "const": "text_only"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "required": [
        "read_all_units",
        "unit_ids",
        "first_segment_id",
        "last_segment_id",
        "missing_ranges"
      ],
      "properties": {
        "read_all_units": {
          "type": "boolean"
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "first_segment_id": {
          "type": "string"
        },
        "last_segment_id": {
          "type": "string"
        },
        "missing_ranges": {
          "type": "array"
        }
      }
    },
    "fields": {
      "type": "object",
      "required": [
        "theme",
        "category",
        "story_points",
        "book_relations",
        "hook",
        "bridge",
        "cta",
        "reusable_method",
        "original_topic_angles"
      ],
      "properties": {
        "theme": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "story_points": {
          "type": "array"
        },
        "book_relations": {
          "type": "array"
        },
        "hook": {
          "type": "object"
        },
        "bridge": {
          "type": "object"
        },
        "cta": {
          "type": "object"
        },
        "reusable_method": {
          "type": "string"
        },
        "original_topic_angles": {
          "type": "array"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "quote",
          "supports"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "supports": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "AI_OK",
        "AI_REVIEW",
        "AI_PENDING"
      ]
    }
  }
}