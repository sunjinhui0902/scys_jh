  "duration_s": 319.416667,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "剑桥抢着请他美国天价年薪流，他他写下八个字，扭头回国家。人们上一篇讲了华罗庚，一个初中生，靠一篇论文进了清华，从打杂的助理员干起，硬是自学成了让清华教授都服气的人。今天这篇讲，他最扬眉吐气，也最让人泪目的一段。一九三六年，华罗庚去了英国剑桥大学，全世界的这数学家挤破头的地方到了剑桥，他干了一件让所有人都看不懂的事，别人都是奔着拿学位去的。他说，我来是学本事的，不是来要文凭的，学位我不要了。他同时修七八门课，天天泡在图书馆，跟时间赛跑，两年时间写出了二十篇论文，一篇比一篇硬核。他提出的华氏定理直接改进了当十世界顶尖数学家的结论。整个欧洲数学界都震动了这个中国人是谁？一查，初中毕业自学成才，那两年，华罗庚的名字成了中国数学的一张名片。剑桥想流淌说，只要他愿意，前程不可限量。可一九三八年抗战爆发，他收拾行李回国了，有人不理解，人家挤破头想留在剑桥，你倒好，说走就走花。罗庚说，我的根在中国回国以后，他在西南联大教书。那时候昆明物价飞涨，他穷的叮当响，一家人挤在城外的小屋子里。楼上是人，楼下是牛，就是在这样的环境里，他写出了数学巨著、堆垒素数论，后来成了国际数学界的经典。可命运又给了他一次选择。一九四六年，华罗庚应邀去美国讲学，美国给了他终身教授的职位，年薪高的惊人研究条件，全世界最好全家人都跟着他搬了过去，日子过得体体面面。家人们，那可是一九四六年，中国刚打完仗，百废待兴，要啥没啥。美国全世界最有钱的国家，搁一般人就在美国待着了。华罗庚待了四年。一九五零年，新中国刚刚成立一穷二白，他做了个让所有美国人没想到的决定回国。他在给全体留美学生的公开信里写下八个字。良缘虽好，非久居之下，归去来兮家人们。良缘虽好，非久居之乡。别人家再好，也不是自己家归去来兮，回来吧。回自己的国家去，他带着全家登上了回国的轮船。有人劝他，你再想想回去了，可什么都没有。他说，正因为什么都没有，才需要我们回去。回国以后，他白天教书，晚上著书，把堆垒素数论写成了国际经典，带出了一大批院士、学生、中科院数学所成立。他当了第一任所长。有人问他，你放弃美国那么好的条件后悔吗？他说，我这一辈子做的每一个选择都不后悔。家人们，你想想，一九五零年的中国什么都没有，可就是有华罗庚这样的人放着高薪，不要放着洋房不住，偏要回来把自己的命跟这个国家的命捆在一起。他还培养了一个年轻人叫陈景润。后来的故事大家都知道了，陈景润攻下了震惊世界的数学难题，成了名震天下的数学家。华罗庚不仅自己是脊梁，还给中国又撑起了一根脊梁。什么叫脊梁？这就是脊梁，觉得话痨了不起的评论区，打归去来兮四个字，致敬。这些义无反顾回国的人，转发出去，让年轻人看看，有些东西比钱值钱。梁园虽好，非久居之乡家人们。这八个字花落庚不是写出来的，是拿一辈子活出来的这是华罗庚三部曲的第二篇。最后一篇讲，他的晚年功成名就，本可以享清福，他却拖着一条残腿，跑遍全国，二十多个省关注。我看大结局。",
  "segments": [
    {
      "segment_id": "v_c126307886cf0805_s00001",
      "start_ms": 130,
      "end_ms": 3270,
      "text": "剑桥抢着请他美国天价年薪流，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00002",
      "start_ms": 3270,
      "end_ms": 5010,
      "text": "他他写下八个字，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00003",
      "start_ms": 5250,
      "end_ms": 7770,
      "text": "扭头回国家。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00004",
      "start_ms": 7770,
      "end_ms": 11530,
      "text": "人们上一篇讲了华罗庚，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00005",
      "start_ms": 11570,
      "end_ms": 12490,
      "text": "一个初中生，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00006",
      "start_ms": 12690,
      "end_ms": 14530,
      "text": "靠一篇论文进了清华，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00007",
      "start_ms": 15070,
      "end_ms": 16970,
      "text": "从打杂的助理员干起，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00008",
      "start_ms": 17270,
      "end_ms": 20250,
      "text": "硬是自学成了让清华教授都服气的人。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00009",
      "start_ms": 20730,
      "end_ms": 22050,
      "text": "今天这篇讲，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00010",
      "start_ms": 22050,
      "end_ms": 23250,
      "text": "他最扬眉吐气，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00011",
      "start_ms": 23450,
      "end_ms": 24830,
      "text": "也最让人泪目的一段。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00012",
      "start_ms": 24830,
      "end_ms": 26670,
      "text": "一九三六年，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00013",
      "start_ms": 26670,
      "end_ms": 28710,
      "text": "华罗庚去了英国剑桥大学，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00014",
      "start_ms": 28710,
      "end_ms": 33400,
      "text": "全世界的这数学家挤破头的地方到了剑桥，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00015",
      "start_ms": 33820,
      "end_ms": 36700,
      "text": "他干了一件让所有人都看不懂的事，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00016",
      "start_ms": 36740,
      "end_ms": 39380,
      "text": "别人都是奔着拿学位去的。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00017",
      "start_ms": 39560,
      "end_ms": 39980,
      "text": "他说，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00018",
      "start_ms": 40280,
      "end_ms": 41900,
      "text": "我来是学本事的，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00019",
      "start_ms": 41940,
      "end_ms": 43340,
      "text": "不是来要文凭的，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00020",
      "start_ms": 43500,
      "end_ms": 44640,
      "text": "学位我不要了。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00021",
      "start_ms": 45340,
      "end_ms": 46920,
      "text": "他同时修七八门课，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00022",
      "start_ms": 47400,
      "end_ms": 48780,
      "text": "天天泡在图书馆，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00023",
      "start_ms": 49180,
      "end_ms": 50340,
      "text": "跟时间赛跑，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00024",
      "start_ms": 50680,
      "end_ms": 53560,
      "text": "两年时间写出了二十篇论文，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00025",
      "start_ms": 53920,
      "end_ms": 55480,
      "text": "一篇比一篇硬核。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00026",
      "start_ms": 55940,
      "end_ms": 62865,
      "text": "他提出的华氏定理直接改进了当十世界顶尖数学家的结论。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00027",
      "start_ms": 63690,
      "end_ms": 69655,
      "text": "整个欧洲数学界都震动了这个中国人是谁？"
    },
    {
      "segment_id": "v_c126307886cf0805_s00028",
      "start_ms": 70050,
      "end_ms": 70615,
      "text": "一查，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00029",
      "start_ms": 71650,
      "end_ms": 73835,
      "text": "初中毕业自学成才，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00030",
      "start_ms": 76110,
      "end_ms": 76730,
      "text": "那两年，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00031",
      "start_ms": 76850,
      "end_ms": 80685,
      "text": "华罗庚的名字成了中国数学的一张名片。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00032",
      "start_ms": 81370,
      "end_ms": 83140,
      "text": "剑桥想流淌说，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00033",
      "start_ms": 83140,
      "end_ms": 84135,
      "text": "只要他愿意，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00034",
      "start_ms": 84460,
      "end_ms": 85785,
      "text": "前程不可限量。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00035",
      "start_ms": 86550,
      "end_ms": 89265,
      "text": "可一九三八年抗战爆发，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00036",
      "start_ms": 89700,
      "end_ms": 91855,
      "text": "他收拾行李回国了，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00037",
      "start_ms": 92350,
      "end_ms": 93335,
      "text": "有人不理解，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00038",
      "start_ms": 93680,
      "end_ms": 95845,
      "text": "人家挤破头想留在剑桥，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00039",
      "start_ms": 96210,
      "end_ms": 96770,
      "text": "你倒好，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00040",
      "start_ms": 96990,
      "end_ms": 98610,
      "text": "说走就走花。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00041",
      "start_ms": 98610,
      "end_ms": 99285,
      "text": "罗庚说，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00042",
      "start_ms": 99720,
      "end_ms": 103010,
      "text": "我的根在中国回国以后，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00043",
      "start_ms": 103290,
      "end_ms": 105395,
      "text": "他在西南联大教书。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00044",
      "start_ms": 105930,
      "end_ms": 107565,
      "text": "那时候昆明物价飞涨，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00045",
      "start_ms": 108040,
      "end_ms": 109345,
      "text": "他穷的叮当响，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00046",
      "start_ms": 110380,
      "end_ms": 113000,
      "text": "一家人挤在城外的小屋子里。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00047",
      "start_ms": 113060,
      "end_ms": 114145,
      "text": "楼上是人，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00048",
      "start_ms": 114560,
      "end_ms": 115465,
      "text": "楼下是牛，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00049",
      "start_ms": 116020,
      "end_ms": 117655,
      "text": "就是在这样的环境里，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00050",
      "start_ms": 117920,
      "end_ms": 121415,
      "text": "他写出了数学巨著、堆垒素数论，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00051",
      "start_ms": 121940,
      "end_ms": 124125,
      "text": "后来成了国际数学界的经典。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00052",
      "start_ms": 124610,
      "end_ms": 127305,
      "text": "可命运又给了他一次选择。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00053",
      "start_ms": 127880,
      "end_ms": 128985,
      "text": "一九四六年，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00054",
      "start_ms": 129270,
      "end_ms": 131735,
      "text": "华罗庚应邀去美国讲学，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00055",
      "start_ms": 132600,
      "end_ms": 135205,
      "text": "美国给了他终身教授的职位，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00056",
      "start_ms": 135680,
      "end_ms": 138750,
      "text": "年薪高的惊人研究条件，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00057",
      "start_ms": 138830,
      "end_ms": 142865,
      "text": "全世界最好全家人都跟着他搬了过去，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00058",
      "start_ms": 143460,
      "end_ms": 145035,
      "text": "日子过得体体面面。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00059",
      "start_ms": 146300,
      "end_ms": 146885,
      "text": "家人们，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00060",
      "start_ms": 147270,
      "end_ms": 149105,
      "text": "那可是一九四六年，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00061",
      "start_ms": 150520,
      "end_ms": 151800,
      "text": "中国刚打完仗，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00062",
      "start_ms": 151920,
      "end_ms": 153065,
      "text": "百废待兴，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00063",
      "start_ms": 153470,
      "end_ms": 154295,
      "text": "要啥没啥。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00064",
      "start_ms": 154830,
      "end_ms": 157505,
      "text": "美国全世界最有钱的国家，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00065",
      "start_ms": 157910,
      "end_ms": 160075,
      "text": "搁一般人就在美国待着了。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00066",
      "start_ms": 160640,
      "end_ms": 162195,
      "text": "华罗庚待了四年。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00067",
      "start_ms": 162900,
      "end_ms": 163820,
      "text": "一九五零年，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00068",
      "start_ms": 164040,
      "end_ms": 166810,
      "text": "新中国刚刚成立一穷二白，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00069",
      "start_ms": 167090,
      "end_ms": 171585,
      "text": "他做了个让所有美国人没想到的决定回国。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00070",
      "start_ms": 172540,
      "end_ms": 176945,
      "text": "他在给全体留美学生的公开信里写下八个字。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00071",
      "start_ms": 177500,
      "end_ms": 178695,
      "text": "良缘虽好，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00072",
      "start_ms": 179040,
      "end_ms": 180275,
      "text": "非久居之下，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00073",
      "start_ms": 180810,
      "end_ms": 182570,
      "text": "归去来兮家人们。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00074",
      "start_ms": 182610,
      "end_ms": 183630,
      "text": "良缘虽好，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00075",
      "start_ms": 183730,
      "end_ms": 184985,
      "text": "非久居之乡。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00076",
      "start_ms": 185580,
      "end_ms": 186600,
      "text": "别人家再好，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00077",
      "start_ms": 186800,
      "end_ms": 189045,
      "text": "也不是自己家归去来兮，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00078",
      "start_ms": 189410,
      "end_ms": 190035,
      "text": "回来吧。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00079",
      "start_ms": 190260,
      "end_ms": 191465,
      "text": "回自己的国家去，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00080",
      "start_ms": 191920,
      "end_ms": 195185,
      "text": "他带着全家登上了回国的轮船。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00081",
      "start_ms": 195710,
      "end_ms": 196685,
      "text": "有人劝他，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00082",
      "start_ms": 196950,
      "end_ms": 198885,
      "text": "你再想想回去了，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00083",
      "start_ms": 199130,
      "end_ms": 200015,
      "text": "可什么都没有。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00084",
      "start_ms": 200390,
      "end_ms": 200985,
      "text": "他说，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00085",
      "start_ms": 201440,
      "end_ms": 202860,
      "text": "正因为什么都没有，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00086",
      "start_ms": 203060,
      "end_ms": 204405,
      "text": "才需要我们回去。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00087",
      "start_ms": 205310,
      "end_ms": 206115,
      "text": "回国以后，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00088",
      "start_ms": 206390,
      "end_ms": 207345,
      "text": "他白天教书，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00089",
      "start_ms": 207680,
      "end_ms": 208535,
      "text": "晚上著书，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00090",
      "start_ms": 208880,
      "end_ms": 211915,
      "text": "把堆垒素数论写成了国际经典，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00091",
      "start_ms": 212710,
      "end_ms": 217095,
      "text": "带出了一大批院士、学生、中科院数学所成立。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00092",
      "start_ms": 217350,
      "end_ms": 218705,
      "text": "他当了第一任所长。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00093",
      "start_ms": 219470,
      "end_ms": 220295,
      "text": "有人问他，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00094",
      "start_ms": 222240,
      "end_ms": 225095,
      "text": "你放弃美国那么好的条件后悔吗？"
    },
    {
      "segment_id": "v_c126307886cf0805_s00095",
      "start_ms": 226320,
      "end_ms": 226705,
      "text": "他说，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00096",
      "start_ms": 227880,
      "end_ms": 232285,
      "text": "我这一辈子做的每一个选择都不后悔。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00097",
      "start_ms": 233060,
      "end_ms": 233605,
      "text": "家人们，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00098",
      "start_ms": 234070,
      "end_ms": 234845,
      "text": "你想想，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00099",
      "start_ms": 235240,
      "end_ms": 237945,
      "text": "一九五零年的中国什么都没有，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00100",
      "start_ms": 239150,
      "end_ms": 242760,
      "text": "可就是有华罗庚这样的人放着高薪，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00101",
      "start_ms": 242780,
      "end_ms": 244795,
      "text": "不要放着洋房不住，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00102",
      "start_ms": 245170,
      "end_ms": 250515,
      "text": "偏要回来把自己的命跟这个国家的命捆在一起。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00103",
      "start_ms": 251100,
      "end_ms": 254805,
      "text": "他还培养了一个年轻人叫陈景润。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00104",
      "start_ms": 255400,
      "end_ms": 257805,
      "text": "后来的故事大家都知道了，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00105",
      "start_ms": 258810,
      "end_ms": 263055,
      "text": "陈景润攻下了震惊世界的数学难题，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00106",
      "start_ms": 263890,
      "end_ms": 266740,
      "text": "成了名震天下的数学家。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00107",
      "start_ms": 266880,
      "end_ms": 269095,
      "text": "华罗庚不仅自己是脊梁，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00108",
      "start_ms": 269470,
      "end_ms": 272025,
      "text": "还给中国又撑起了一根脊梁。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00109",
      "start_ms": 272910,
      "end_ms": 273885,
      "text": "什么叫脊梁？"
    },
    {
      "segment_id": "v_c126307886cf0805_s00110",
      "start_ms": 274130,
      "end_ms": 274945,
      "text": "这就是脊梁，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00111",
      "start_ms": 276120,
      "end_ms": 279330,
      "text": "觉得话痨了不起的评论区，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00112",
      "start_ms": 279350,
      "end_ms": 281125,
      "text": "打归去来兮四个字，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00113",
      "start_ms": 281590,
      "end_ms": 282090,
      "text": "致敬。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00114",
      "start_ms": 282150,
      "end_ms": 284745,
      "text": "这些义无反顾回国的人，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00115",
      "start_ms": 285020,
      "end_ms": 285935,
      "text": "转发出去，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00116",
      "start_ms": 286420,
      "end_ms": 287705,
      "text": "让年轻人看看，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00117",
      "start_ms": 288150,
      "end_ms": 290385,
      "text": "有些东西比钱值钱。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00118",
      "start_ms": 291120,
      "end_ms": 292100,
      "text": "梁园虽好，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00119",
      "start_ms": 292360,
      "end_ms": 295885,
      "text": "非久居之乡家人们。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00120",
      "start_ms": 297540,
      "end_ms": 300545,
      "text": "这八个字花落庚不是写出来的，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00121",
      "start_ms": 300780,
      "end_ms": 305385,
      "text": "是拿一辈子活出来的这是华罗庚三部曲的第二篇。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00122",
      "start_ms": 305600,
      "end_ms": 306850,
      "text": "最后一篇讲，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00123",
      "start_ms": 306850,
      "end_ms": 309685,
      "text": "他的晚年功成名就，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00124",
      "start_ms": 309990,
      "end_ms": 311255,
      "text": "本可以享清福，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00125",
      "start_ms": 312040,
      "end_ms": 313795,
      "text": "他却拖着一条残腿，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00126",
      "start_ms": 314230,
      "end_ms": 315330,
      "text": "跑遍全国，"
    },
    {
      "segment_id": "v_c126307886cf0805_s00127",
      "start_ms": 315410,
      "end_ms": 317790,
      "text": "二十多个省关注。"
    },
    {
      "segment_id": "v_c126307886cf0805_s00128",
      "start_ms": 317790,
      "end_ms": 319285,
      "text": "我看大结局。"
    }
  ],
