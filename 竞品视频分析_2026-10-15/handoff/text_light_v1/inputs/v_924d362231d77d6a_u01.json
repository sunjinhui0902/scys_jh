    },
    {
      "segment_id": "v_924d362231d77d6a_s00004",
      "start_ms": 9030,
      "end_ms": 9830,
      "text": "玲玲小张，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00005",
      "start_ms": 9910,
      "end_ms": 10950,
      "text": "你俩明天跟我一起去。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00006",
      "start_ms": 11210,
      "end_ms": 11550,
      "text": "好的，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00007",
      "start_ms": 11550,
      "end_ms": 12470,
      "text": "王姐没问题。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00008",
      "start_ms": 12470,
      "end_ms": 12870,
      "text": "王姐，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00009",
      "start_ms": 13290,
      "end_ms": 13710,
      "text": "对了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00010",
      "start_ms": 14070,
      "end_ms": 15690,
      "text": "这个项目李总很重视，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00011",
      "start_ms": 15930,
      "end_ms": 17250,
      "text": "你俩跟着我说话，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00012",
      "start_ms": 17250,
      "end_ms": 18130,
      "text": "做事都注意点，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00013",
      "start_ms": 18310,
      "end_ms": 18770,
      "text": "没问题。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00014",
      "start_ms": 18770,
      "end_ms": 19190,
      "text": "王姐，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00015",
      "start_ms": 19410,
      "end_ms": 19870,
      "text": "放心吧，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00016",
      "start_ms": 19870,
      "end_ms": 20990,
      "text": "王姐肯定不给您。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00017",
      "start_ms": 20990,
      "end_ms": 26030,
      "text": "丢脸王总好久不见。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00018",
      "start_ms": 26150,
      "end_ms": 26570,
      "text": "王姐，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00019",
      "start_ms": 26870,
      "end_ms": 27590,
      "text": "别来无恙。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00020",
      "start_ms": 27750,
      "end_ms": 28130,
      "text": "小张，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00021",
      "start_ms": 28850,
      "end_ms": 30170,
      "text": "你们这个方案我看过了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00022",
      "start_ms": 30350,
      "end_ms": 31310,
      "text": "我问你几个问题，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00023",
      "start_ms": 31570,
      "end_ms": 32970,
      "text": "如果这个项目交给你们，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00024",
      "start_ms": 33270,
      "end_ms": 34290,
      "text": "多久能正式落地？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00025",
      "start_ms": 34690,
      "end_ms": 35330,
      "text": "正常情况下，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00026",
      "start_ms": 35330,
      "end_ms": 37990,
      "text": "两周前期准备我们已经做的差不多了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00027",
      "start_ms": 38370,
      "end_ms": 39730,
      "text": "如果您这边时间比较紧，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00028",
      "start_ms": 39890,
      "end_ms": 41030,
      "text": "我们可以把周期压到十天。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00029",
      "start_ms": 41450,
      "end_ms": 42770,
      "text": "那中间要是出了问题呢，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00030",
      "start_ms": 43110,
      "end_ms": 45770,
      "text": "谁来负责这个项目？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00031",
      "start_ms": 45770,
      "end_ms": 46670,
      "text": "由我全程跟进，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00032",
      "start_ms": 47090,
      "end_ms": 47870,
      "text": "真出了问题，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00033",
      "start_ms": 48070,
      "end_ms": 51970,
      "text": "您不用找别人直接找我行。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00034",
      "start_ms": 52210,
      "end_ms": 53190,
      "text": "还有最后一个问题，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00035",
      "start_ms": 53710,
      "end_ms": 54690,
      "text": "这么大的项目，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00036",
      "start_ms": 55050,
      "end_ms": 56590,
      "text": "你凭什么觉得你们能做好？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00037",
      "start_ms": 57290,
      "end_ms": 57790,
      "text": "李总，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00038",
      "start_ms": 58290,
      "end_ms": 60410,
      "text": "我们不敢保证项目过程中一点问题都没有，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00039",
      "start_ms": 60410,
      "end_ms": 62125,
      "text": "但我能保证真出了问题，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00040",
      "start_ms": 62590,
      "end_ms": 64430,
      "text": "我们不会躲第一时间解决，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00041",
      "start_ms": 64490,
      "end_ms": 65465,
      "text": "绝不耽误您的进度。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00042",
      "start_ms": 66620,
      "end_ms": 67105,
      "text": "不错，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00043",
      "start_ms": 70850,
      "end_ms": 71615,
      "text": "小张啊，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00044",
      "start_ms": 72300,
      "end_ms": 75175,
      "text": "你是第一个十来分钟就能把项目谈下来的人，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00045",
      "start_ms": 75820,
      "end_ms": 77195,
      "text": "真是后生可畏啊，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00046",
      "start_ms": 77610,
      "end_ms": 79835,
      "text": "哪里哪里还是我们王姐厉害，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00047",
      "start_ms": 80310,
      "end_ms": 85600,
      "text": "我就是个打辅助的合同，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00048",
      "start_ms": 85600,
      "end_ms": 86735,
      "text": "今天先不着急签。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00049",
      "start_ms": 87650,
      "end_ms": 89105,
      "text": "李总还有什么问题吗？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00050",
      "start_ms": 89460,
      "end_ms": 91115,
      "text": "没什么这么大的项目，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00051",
      "start_ms": 91410,
      "end_ms": 92215,
      "text": "我再考虑考虑。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00052",
      "start_ms": 92750,
      "end_ms": 96250,
      "text": "李总这正好明天晚上我组了个局陈，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00053",
      "start_ms": 96250,
      "end_ms": 97045,
      "text": "总也会过来。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00054",
      "start_ms": 97780,
      "end_ms": 100335,
      "text": "王杰要是有时间一起吃个饭，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00055",
      "start_ms": 101470,
      "end_ms": 102250,
      "text": "李总邀请，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00056",
      "start_ms": 102350,
      "end_ms": 103345,
      "text": "那肯定有时间。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00057",
      "start_ms": 104790,
      "end_ms": 105175,
      "text": "行，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00058",
      "start_ms": 106100,
      "end_ms": 106985,
      "text": "那项目事儿，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00059",
      "start_ms": 107420,
      "end_ms": 110675,
      "text": "咱们明天再聊啊。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00060",
      "start_ms": 110900,
      "end_ms": 111285,
      "text": "王姐，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00061",
      "start_ms": 113030,
      "end_ms": 114995,
      "text": "刚才项目不是都已经谈好了吗？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00062",
      "start_ms": 115330,
      "end_ms": 116325,
      "text": "合同都准备签了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00063",
      "start_ms": 116740,
      "end_ms": 120895,
      "text": "李总怎么突然又说要考虑你自己想想刚才说什么了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00064",
      "start_ms": 121380,
      "end_ms": 122655,
      "text": "我也没说什么啊。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00065",
      "start_ms": 122970,
      "end_ms": 123690,
      "text": "李总夸我，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00066",
      "start_ms": 123690,
      "end_ms": 124765,
      "text": "我就是谦虚了一下，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00067",
      "start_ms": 125070,
      "end_ms": 126250,
      "text": "总不能人家夸我两句，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00068",
      "start_ms": 126250,
      "end_ms": 127125,
      "text": "我还真认了吧。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00069",
      "start_ms": 127410,
      "end_ms": 130085,
      "text": "李总夸你是认可你的能力，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00070",
      "start_ms": 130510,
      "end_ms": 131545,
      "text": "结果你倒好，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00071",
      "start_ms": 131890,
      "end_ms": 132930,
      "text": "自己先告诉人家，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00072",
      "start_ms": 133090,
      "end_ms": 136165,
      "text": "你就是个打辅助的这句话有什么问题。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00073",
      "start_ms": 136650,
      "end_ms": 137830,
      "text": "一千万的项目，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00074",
      "start_ms": 137830,
      "end_ms": 139570,
      "text": "你自己都不敢认自己的能力，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00075",
      "start_ms": 139570,
      "end_ms": 140735,
      "text": "你让客户怎么放心？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00076",
      "start_ms": 142350,
      "end_ms": 143505,
      "text": "就因为这一句话，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00077",
      "start_ms": 144000,
      "end_ms": 146615,
      "text": "很多时候人家看的不只是你会不会做事，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00078",
      "start_ms": 147080,
      "end_ms": 148825,
      "text": "也看你会不会跟人打交道，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00079",
      "start_ms": 149680,
      "end_ms": 151200,
      "text": "那这个项目是不是没戏了？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00080",
      "start_ms": 151320,
      "end_ms": 151960,
      "text": "还有机会，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00081",
      "start_ms": 152080,
      "end_ms": 153705,
      "text": "李总既然没有直接拒绝，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00082",
      "start_ms": 154000,
      "end_ms": 155465,
      "text": "还主动约了明天的饭局，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00083",
      "start_ms": 155700,
      "end_ms": 157015,
      "text": "就说明事情还有转机。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00084",
      "start_ms": 157640,
      "end_ms": 159435,
      "text": "能不能把这个项目拿下来，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00085",
      "start_ms": 159840,
      "end_ms": 161345,
      "text": "就看你们两个明天的表现了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00086",
      "start_ms": 164650,
      "end_ms": 165010,
      "text": "哎呀，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00087",
      "start_ms": 165010,
      "end_ms": 166010,
      "text": "这肯定迟到了呀。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00088",
      "start_ms": 166010,
      "end_ms": 167495,
      "text": "今天这场商务洽谈很重要，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00089",
      "start_ms": 167870,
      "end_ms": 168985,
      "text": "去晚了可咋办呀？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00090",
      "start_ms": 169410,
      "end_ms": 174565,
      "text": "急什么合作方那边能够理解路况堵车的啊，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00091",
      "start_ms": 175450,
      "end_ms": 176215,
      "text": "没关系，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00092",
      "start_ms": 176680,
      "end_ms": 178315,
      "text": "兵来将挡水来土掩，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00093",
      "start_ms": 178680,
      "end_ms": 180095,
      "text": "有王姐在怕啥？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00094",
      "start_ms": 180900,
      "end_ms": 183840,
      "text": "今天我当个观众能不能拿下这笔大业务，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00095",
      "start_ms": 183980,
      "end_ms": 186720,
      "text": "就看你俩的表现了哟。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00096",
      "start_ms": 187140,
      "end_ms": 188835,
      "text": "来这么晚只能吃剩饭了吧。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00097",
      "start_ms": 189110,
      "end_ms": 190155,
      "text": "王总真不好意思，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00098",
      "start_ms": 191010,
      "end_ms": 191970,
      "text": "路上太堵了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00099",
      "start_ms": 191970,
      "end_ms": 193450,
      "text": "我们哎呀，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00100",
      "start_ms": 193450,
      "end_ms": 194710,
      "text": "王总饭在哪儿？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00101",
      "start_ms": 194710,
      "end_ms": 195390,
      "text": "我们都能吃，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00102",
      "start_ms": 195650,
      "end_ms": 198045,
      "text": "但您这桌不是谁想做就能做的，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00103",
      "start_ms": 198370,
      "end_ms": 199995,
      "text": "能赶上已经是我们的运气了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00104",
      "start_ms": 200240,
      "end_ms": 200765,
      "text": "哈哈哈，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00105",
      "start_ms": 201160,
      "end_ms": 201880,
      "text": "赶紧坐吧，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00106",
      "start_ms": 202060,
      "end_ms": 203425,
      "text": "位置都给你们留好了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00107",
      "start_ms": 203750,
      "end_ms": 212460,
      "text": "哼各位领导，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00108",
      "start_ms": 212540,
      "end_ms": 213180,
      "text": "不好意思，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00109",
      "start_ms": 213180,
      "end_ms": 214040,
      "text": "今天迟到了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00110",
      "start_ms": 214040,
      "end_ms": 215300,
      "text": "我们给大家敬一个来，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00111",
      "start_ms": 215300,
      "end_ms": 215695,
      "text": "小张，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00112",
      "start_ms": 215890,
      "end_ms": 216695,
      "text": "你来起个头吧，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00113",
      "start_ms": 219220,
      "end_ms": 220180,
      "text": "大家吃好喝。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00114",
      "start_ms": 220180,
      "end_ms": 220420,
      "text": "好，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00115",
      "start_ms": 220620,
      "end_ms": 221995,
      "text": "我干了领导们随意，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00116",
      "start_ms": 224790,
      "end_ms": 224955,
      "text": "嗯，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00117",
      "start_ms": 225250,
      "end_ms": 226005,
      "text": "这就完了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00118",
      "start_ms": 227310,
      "end_ms": 227545,
      "text": "嗯，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00119",
      "start_ms": 227870,
      "end_ms": 228355,
      "text": "完了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00120",
      "start_ms": 229060,
      "end_ms": 229425,
      "text": "哎，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00121",
      "start_ms": 234660,
      "end_ms": 235295,
      "text": "来琳琳，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00122",
      "start_ms": 236010,
      "end_ms": 240830,
      "text": "你也给大家敬一个这俗话说跟着领导走，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00123",
      "start_ms": 241030,
      "end_ms": 242090,
      "text": "吃喝啥都有，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00124",
      "start_ms": 242410,
      "end_ms": 243530,
      "text": "跟着领导干呀，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00125",
      "start_ms": 243650,
      "end_ms": 244970,
      "text": "年年赚个几百万。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00126",
      "start_ms": 245150,
      "end_ms": 246110,
      "text": "非常感谢李总。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00127",
      "start_ms": 246110,
      "end_ms": 246870,
      "text": "今天组的局，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00128",
      "start_ms": 247070,
      "end_ms": 248610,
      "text": "也感谢王姐带我们过来，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00129",
      "start_ms": 248630,
      "end_ms": 250210,
      "text": "让我们有幸认识各位前辈，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00130",
      "start_ms": 250230,
      "end_ms": 250870,
      "text": "我叫琳琳。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00131",
      "start_ms": 250990,
      "end_ms": 251530,
      "text": "俗话说，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00132",
      "start_ms": 251650,
      "end_ms": 252790,
      "text": "相聚是一种缘分。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00133",
      "start_ms": 253090,
      "end_ms": 253810,
      "text": "此时此刻，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00134",
      "start_ms": 253870,
      "end_ms": 256190,
      "text": "我把对各位的祝福化作一杯美酒，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00135",
      "start_ms": 256410,
      "end_ms": 257770,
      "text": "祝各位扶摇直上。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00136",
      "start_ms": 257770,
      "end_ms": 258290,
      "text": "九万里，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00137",
      "start_ms": 258550,
      "end_ms": 259870,
      "text": "事业长虹节节高。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00138",
      "start_ms": 259870,
      "end_ms": 260110,
      "text": "好，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00139",
      "start_ms": 262110,
      "end_ms": 263185,
      "text": "这姑娘会说话，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00140",
      "start_ms": 269590,
      "end_ms": 270025,
      "text": "王姐，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00141",
      "start_ms": 270370,
      "end_ms": 271030,
      "text": "来石杯，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00142",
      "start_ms": 271030,
      "end_ms": 273370,
      "text": "我敬你陈总这杯，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00143",
      "start_ms": 273370,
      "end_ms": 274225,
      "text": "我替王姐敬您，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00144",
      "start_ms": 275520,
      "end_ms": 276725,
      "text": "我敬的是你们领导，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00145",
      "start_ms": 277260,
      "end_ms": 278135,
      "text": "你是领导吗？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00146",
      "start_ms": 278970,
      "end_ms": 279795,
      "text": "瞧您说的，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00147",
      "start_ms": 280190,
      "end_ms": 281310,
      "text": "您敬的是我领导，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00148",
      "start_ms": 281410,
      "end_ms": 283185,
      "text": "我同样敬的也是领导，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00149",
      "start_ms": 283540,
      "end_ms": 284600,
      "text": "您敬领导是心意，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00150",
      "start_ms": 284720,
      "end_ms": 286580,
      "text": "我敬您是尊敬这杯，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00151",
      "start_ms": 286580,
      "end_ms": 287535,
      "text": "我敬的是生意，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00152",
      "start_ms": 287940,
      "end_ms": 288600,
      "text": "咱们随意，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00153",
      "start_ms": 288660,
      "end_ms": 289940,
      "text": "祝您生意一路长虹，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00154",
      "start_ms": 290020,
      "end_ms": 291475,
      "text": "万事顺利，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00155",
      "start_ms": 292660,
      "end_ms": 293920,
      "text": "这小姑娘会说话。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00156",
      "start_ms": 294000,
      "end_ms": 295560,
      "text": "琳琳刚才说的不错，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00157",
      "start_ms": 295560,
      "end_ms": 296340,
      "text": "来咱俩喝一个，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00158",
      "start_ms": 296340,
      "end_ms": 296975,
      "text": "谢谢陈总。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00159",
      "start_ms": 300050,
      "end_ms": 300290,
      "text": "哎，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00160",
      "start_ms": 300730,
      "end_ms": 302550,
      "text": "怎么到我这儿就剩半杯了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00161",
      "start_ms": 302550,
      "end_ms": 303550,
      "text": "陈总瓶底酒，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00162",
      "start_ms": 303550,
      "end_ms": 305870,
      "text": "这要发财酒到底发财好事，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00163",
      "start_ms": 305890,
      "end_ms": 308410,
      "text": "再来好一个发财酒。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00164",
      "start_ms": 309150,
      "end_ms": 309665,
      "text": "琳琳。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00165",
      "start_ms": 310580,
      "end_ms": 311600,
      "text": "我再问你个问题，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00166",
      "start_ms": 312080,
      "end_ms": 314320,
      "text": "你觉得我和李总你更喜欢谁？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00167",
      "start_ms": 314400,
      "end_ms": 315035,
      "text": "好好好，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00168",
      "start_ms": 317160,
      "end_ms": 318620,
      "text": "领导怎么能用喜欢呢？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00169",
      "start_ms": 318640,
      "end_ms": 320840,
      "text": "那得是尊敬两位领导，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00170",
      "start_ms": 320840,
      "end_ms": 326980,
      "text": "我都尊敬这姑娘聪明琳琳，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00171",
      "start_ms": 327760,
      "end_ms": 328760,
      "text": "这条鱼没怎么动，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00172",
      "start_ms": 329320,
      "end_ms": 330080,
      "text": "都是自己人，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00173",
      "start_ms": 330140,
      "end_ms": 330680,
      "text": "别嫌弃，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00174",
      "start_ms": 331060,
      "end_ms": 331880,
      "text": "一会儿打包带回去，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00175",
      "start_ms": 331880,
      "end_ms": 332240,
      "text": "吃吧，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00176",
      "start_ms": 332320,
      "end_ms": 333200,
      "text": "还能补补身子。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00177",
      "start_ms": 333940,
      "end_ms": 336060,
      "text": "琳琳陈总让你拿，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00178",
      "start_ms": 336120,
      "end_ms": 336900,
      "text": "你就拿着呗，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00179",
      "start_ms": 337820,
      "end_ms": 338880,
      "text": "太感谢陈总了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00180",
      "start_ms": 339060,
      "end_ms": 340780,
      "text": "但是一整条鱼我自己也吃不完。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00181",
      "start_ms": 340900,
      "end_ms": 342459,
      "text": "我平时喜欢吃鱼尾，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00182",
      "start_ms": 342700,
      "end_ms": 344440,
      "text": "上面这部分我给您打包带回去，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00183",
      "start_ms": 344440,
      "end_ms": 345420,
      "text": "给嫂子也尝一下，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00184",
      "start_ms": 345420,
      "end_ms": 346940,
      "text": "以后还希望您多多照顾。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00185",
      "start_ms": 347920,
      "end_ms": 350505,
      "text": "看来今天这条鱼没白点，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00186",
      "start_ms": 357820,
      "end_ms": 358720,
      "text": "李总刚来消息，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00187",
      "start_ms": 358820,
      "end_ms": 359500,
      "text": "合同签了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00188",
      "start_ms": 359940,
      "end_ms": 361280,
      "text": "真的真的。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00189",
      "start_ms": 361500,
      "end_ms": 363260,
      "text": "不过李总还特意提了一个要求，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00190",
      "start_ms": 363500,
      "end_ms": 367180,
      "text": "什么要求这个一千万的项目后面让玲玲负责。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00191",
      "start_ms": 367940,
      "end_ms": 372055,
      "text": "我对小张你的业务能力没问题。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00192",
      "start_ms": 372380,
      "end_ms": 376315,
      "text": "但是李总说这么大的项目后面少不了跟各种人打交道，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00193",
      "start_ms": 376780,
      "end_ms": 379105,
      "text": "所以这个项目他更希望琳琳来负责。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00194",
      "start_ms": 379800,
      "end_ms": 380535,
      "text": "谢谢王姐，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00195",
      "start_ms": 380920,
      "end_ms": 382260,
      "text": "我一定把这个项目做好。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00196",
      "start_ms": 382420,
      "end_ms": 384360,
      "text": "还有我第一天说过，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00197",
      "start_ms": 384600,
      "end_ms": 386120,
      "text": "谁能最终拿下这个项目，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00198",
      "start_ms": 386120,
      "end_ms": 387260,
      "text": "公司奖励一百万，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00199",
      "start_ms": 387500,
      "end_ms": 388400,
      "text": "现在项目签了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00200",
      "start_ms": 388560,
      "end_ms": 389935,
      "text": "李总又点名让你负责，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00201",
      "start_ms": 390340,
      "end_ms": 394295,
      "text": "所以这一百万奖励是你的一百万给我。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00202",
      "start_ms": 394620,
      "end_ms": 394905,
      "text": "对，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00203",
      "start_ms": 395180,
      "end_ms": 396015,
      "text": "这是你应得的。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00204",
      "start_ms": 396490,
      "end_ms": 397905,
      "text": "谢谢王姐琳琳，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00205",
      "start_ms": 398160,
      "end_ms": 399260,
      "text": "我现在是真服你了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00206",
      "start_ms": 399260,
      "end_ms": 399740,
      "text": "怎么了？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00207",
      "start_ms": 399880,
      "end_ms": 402170,
      "text": "这个项目明明是我先谈的业务问题，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00208",
      "start_ms": 402170,
      "end_ms": 402965,
      "text": "也是我回答的。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00209",
      "start_ms": 403410,
      "end_ms": 405370,
      "text": "刚才王姐说李总最后点名让你负责，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00210",
      "start_ms": 405370,
      "end_ms": 406910,
      "text": "连一百万奖励都给你的时候，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00211",
      "start_ms": 406910,
      "end_ms": 408475,
      "text": "我一开始还真有点想不明白，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00212",
      "start_ms": 409270,
      "end_ms": 411470,
      "text": "可我一想到昨天饭桌上发生的那些事儿，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00213",
      "start_ms": 411470,
      "end_ms": 412355,
      "text": "我就明白了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00214",
      "start_ms": 412590,
      "end_ms": 413390,
      "text": "昨天陈总说，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00215",
      "start_ms": 413490,
      "end_ms": 414470,
      "text": "我敬的是你们领导，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00216",
      "start_ms": 414470,
      "end_ms": 415270,
      "text": "你是领导吗？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00217",
      "start_ms": 415270,
      "end_ms": 415690,
      "text": "换成我，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00218",
      "start_ms": 415690,
      "end_ms": 417115,
      "text": "我当场就不知道该说什么了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00219",
      "start_ms": 417440,
      "end_ms": 418720,
      "text": "饭局上突然让你讲话，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00220",
      "start_ms": 418940,
      "end_ms": 419740,
      "text": "给李总倒酒，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00221",
      "start_ms": 419740,
      "end_ms": 420360,
      "text": "只剩半杯。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00222",
      "start_ms": 420520,
      "end_ms": 421260,
      "text": "陈总又问你，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00223",
      "start_ms": 421260,
      "end_ms": 422615,
      "text": "他和李总你更喜欢谁？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00224",
      "start_ms": 422950,
      "end_ms": 423935,
      "text": "还有最后那条鱼，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00225",
      "start_ms": 424500,
      "end_ms": 425520,
      "text": "我到现在才明白，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00226",
      "start_ms": 425660,
      "end_ms": 427395,
      "text": "陈总说的根本就不只是鱼。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00227",
      "start_ms": 428820,
      "end_ms": 432635,
      "text": "现在我算知道为什么李总最后会点名让你负责这个项目了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00228",
      "start_ms": 434010,
      "end_ms": 435610,
      "text": "为什么别人突然给你一句话，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00229",
      "start_ms": 435950,
      "end_ms": 437275,
      "text": "你马上就知道该怎么接。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00230",
      "start_ms": 437660,
      "end_ms": 438960,
      "text": "其实我以前跟你一样，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00231",
      "start_ms": 439120,
      "end_ms": 439840,
      "text": "不爱说话，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00232",
      "start_ms": 439980,
      "end_ms": 441320,
      "text": "也不知道怎么组织语言，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00233",
      "start_ms": 441400,
      "end_ms": 443455,
      "text": "一到这种场合就不知道应该说什么。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00234",
      "start_ms": 443910,
      "end_ms": 446805,
      "text": "后来我就经常看这本把话说的恰到好处。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00235",
      "start_ms": 447450,
      "end_ms": 448970,
      "text": "它里面就是一个场景，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00236",
      "start_ms": 448970,
      "end_ms": 450190,
      "text": "一个场景的告诉你，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00237",
      "start_ms": 450210,
      "end_ms": 452390,
      "text": "遇到不同的人不同的话应该怎么接。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00238",
      "start_ms": 452670,
      "end_ms": 454430,
      "text": "比如别人夸你优秀，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00239",
      "start_ms": 454530,
      "end_ms": 455130,
      "text": "你可以回，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00240",
      "start_ms": 455430,
      "end_ms": 456750,
      "text": "那是不优秀点儿，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00241",
      "start_ms": 456750,
      "end_ms": 458245,
      "text": "怎么能和你做朋友呢？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00242",
      "start_ms": 458720,
      "end_ms": 460160,
      "text": "当别人说你真聪明，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00243",
      "start_ms": 460240,
      "end_ms": 462095,
      "text": "你就回近朱者赤，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00244",
      "start_ms": 462400,
      "end_ms": 463320,
      "text": "和你在一起啊，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00245",
      "start_ms": 463340,
      "end_ms": 465660,
      "text": "熏都熏出来了当领导跟你说，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00246",
      "start_ms": 465660,
      "end_ms": 466200,
      "text": "辛苦了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00247",
      "start_ms": 466200,
      "end_ms": 467440,
      "text": "你就回领导，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00248",
      "start_ms": 467540,
      "end_ms": 468705,
      "text": "这都是我应该做的。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00249",
      "start_ms": 468950,
      "end_ms": 470190,
      "text": "强将手下无弱兵，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00250",
      "start_ms": 470250,
      "end_ms": 471590,
      "text": "我怎么能给您丢脸呢？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00251",
      "start_ms": 471770,
      "end_ms": 473515,
      "text": "难怪你每次都能接的这么快，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00252",
      "start_ms": 473880,
      "end_ms": 475405,
      "text": "这种东西不是天生的，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00253",
      "start_ms": 476090,
      "end_ms": 477310,
      "text": "就是平时一个场景，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00254",
      "start_ms": 477310,
      "end_ms": 478110,
      "text": "一个场景的看，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00255",
      "start_ms": 478310,
      "end_ms": 478890,
      "text": "一个场景，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00256",
      "start_ms": 478890,
      "end_ms": 479834,
      "text": "一个场景的练。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00257",
      "start_ms": 480380,
      "end_ms": 481320,
      "text": "每天看两页，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00258",
      "start_ms": 481560,
      "end_ms": 483760,
      "text": "慢慢积累一些不同的场景之下，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00259",
      "start_ms": 483780,
      "end_ms": 484540,
      "text": "应该怎么说？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00260",
      "start_ms": 484780,
      "end_ms": 486685,
      "text": "这里面还有很多生活里的场景，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00261",
      "start_ms": 487000,
      "end_ms": 488320,
      "text": "比如对象给你发红包，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00262",
      "start_ms": 488380,
      "end_ms": 491185,
      "text": "你可以回你是我致富道路上最大的功臣，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00263",
      "start_ms": 491620,
      "end_ms": 492520,
      "text": "同事向你借钱，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00264",
      "start_ms": 492660,
      "end_ms": 493400,
      "text": "你又不想借，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00265",
      "start_ms": 493680,
      "end_ms": 494275,
      "text": "可以回，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00266",
      "start_ms": 494620,
      "end_ms": 495980,
      "text": "大家都是一样的年纪，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00267",
      "start_ms": 496100,
      "end_ms": 496800,
      "text": "你没有的，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00268",
      "start_ms": 496880,
      "end_ms": 497640,
      "text": "我能有吗？"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00269",
      "start_ms": 497820,
      "end_ms": 500120,
      "text": "还有心仪的人跟你说我想你了，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00270",
      "start_ms": 500140,
      "end_ms": 501820,
      "text": "你可以回随便想，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00271",
      "start_ms": 501980,
      "end_ms": 503160,
      "text": "千万别跟我客气，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00272",
      "start_ms": 503280,
      "end_ms": 504365,
      "text": "目前不收费。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00273",
      "start_ms": 504840,
      "end_ms": 506585,
      "text": "呵呵呵呵这个有意思。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00274",
      "start_ms": 506970,
      "end_ms": 508290,
      "text": "我第一次读到这些的时候，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00275",
      "start_ms": 508290,
      "end_ms": 509885,
      "text": "真的有种豁然开朗的感觉。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00276",
      "start_ms": 510400,
      "end_ms": 514040,
      "text": "这本书就是把工作、生活、人际交往里经常遇到的场景，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00277",
      "start_ms": 514200,
      "end_ms": 515695,
      "text": "一个一个拆开给你看，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00278",
      "start_ms": 516110,
      "end_ms": 516850,
      "text": "别人怎么说，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00279",
      "start_ms": 516970,
      "end_ms": 517855,
      "text": "你可以怎么接，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00280",
      "start_ms": 518190,
      "end_ms": 519535,
      "text": "都是一句一句给你举例。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00281",
      "start_ms": 520290,
      "end_ms": 522405,
      "text": "所以你平时就是这么练的对呀，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00282",
      "start_ms": 522900,
      "end_ms": 523480,
      "text": "每天不用看，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00283",
      "start_ms": 523480,
      "end_ms": 524655,
      "text": "很多看两页，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00284",
      "start_ms": 524960,
      "end_ms": 526955,
      "text": "碰到自己觉得有用的表达就记一记，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00285",
      "start_ms": 527350,
      "end_ms": 528410,
      "text": "慢慢积累的多了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00286",
      "start_ms": 528670,
      "end_ms": 530765,
      "text": "工作和生活里再碰到类似的场景，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00287",
      "start_ms": 531050,
      "end_ms": 532135,
      "text": "你就知道怎么接了。"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00288",
      "start_ms": 533430,
      "end_ms": 533990,
      "text": "这本先借，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00289",
      "start_ms": 533990,
      "end_ms": 535650,
      "text": "我看看拿去吧，"
    },
    {
      "segment_id": "v_924d362231d77d6a_s00290",
      "start_ms": 535750,
      "end_ms": 536565,
      "text": "回去慢慢看。"
    }
  ],
