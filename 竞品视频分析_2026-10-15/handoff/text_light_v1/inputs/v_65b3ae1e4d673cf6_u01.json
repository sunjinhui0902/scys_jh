{
  "schema_version": "text-light-input-1.0",
  "unit_id": "v_65b3ae1e4d673cf6_u01",
  "video_id": "v_65b3ae1e4d673cf6",
  "account": "赵健的读书日记",
  "source_title": "你知道为什么有些人特别害怕别人笑话吗，因为他们最喜欢笑话别人。诸君，请你一定要记住，如果一个侮辱能让你崩溃，一个掌声能让你膨胀，你的心智就不属于你自己，你是任何开口之人的一名奴隶。#心不受力 #秋天 #治愈力 #幸福",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
  "status": "AI_PENDING",
  "unit_index": 1,
  "unit_count": 1,
  "all_video_unit_ids": [
    "v_65b3ae1e4d673cf6_u01"
  ],
  "duration_s": 167.113991,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "你知道为什么有些人特别害怕别人笑话吗？因为他们最喜欢笑话，别人朱君，请你一定要记住。如果一个侮辱能够让你崩溃，一个掌声能让你膨胀，你的心智就不属于你自己。你是任何开口之人的一名奴隶。为什么说在这个焦虑的时代，四多个主义哲学值得每一个人学习？别人一句无心的评价，就能让你低落。一整晚一条没有回复的消息，就能让你脑补一整夜，一点，不确定就能让你反复内行。其实压垮你的的不是生活，是你的控制欲，你想控制别人，怎么看你控制事情的结果，控制关系的走向，甚至控制未来，按照你预期去发生。斯洛克主义说，世界只分两件事儿，一件事，你能控制的一件事，你怎么折腾，你都控制不了的。而大多数人一辈子都在干一件蠢事，放弃掌控自己，却拼命去掌控别人。你所有的焦虑本质都是在试图掌控一个不属于你的世界。庄子早在两千多年前就已经告告诉我们，心别受力、掌声和嘘声本质上都是噪声。比如我是做自媒体，就会面对很多人对我的种种评价。而孟子有一句话，说有不渝之欲，有求全之慧，什么叫不逾之欲？就是意料之外的过分的赞美。别人说你真厉害啊，实际上你心里清楚，并没有这么厉害。既然你接受了这么多不愉之语，那你也应该接受那些求全智慧。你在别人口中的好坏，其实和你本身没有太大关系。朱军人在过得很好的时候，就会原谅很多事情，因为自己的内心有了力量，就懒得跟外界较劲儿。你看，山顶的风永远不与谷底的尘埃作战，所以精神海拔决定了包容的半径。人强大到能自我满足时，别人的冒犯就变成了蚊虫叮咬。你来我欢迎你走，我不送别人说的话可以听见，却不必句句收藏。生活带来的情绪可以感受，却不必让他们长期居住。心不受力，不是冷漠，不是麻木，也不是假装什么都不在乎，而是你可以接受建议，却不接受审判，可以经历失去，却不否定自己，可以在秋天多愁善感，却不让一阵风替你决定整个人生。每每到了秋天，树木会把养分从叶片收回根部，人也要把散落在外界的注意力收回来。从别人的评价里收回来，该落的意让他落，该走的人让他走，该来的风让他来树不追，夜山不留云。真正有根的人，也不必向每一阵风去解释自己。这个秋天，让风负责吹，让夜负责落，而你只负责站稳，总有人会喜欢那个真实的你，一定要相信我。如果没有请告诉我，我喜欢你。",
  "segments": [
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00001",
      "start_ms": 110,
      "end_ms": 2910,
      "text": "你知道为什么有些人特别害怕别人笑话吗？"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00002",
      "start_ms": 3150,
      "end_ms": 4550,
      "text": "因为他们最喜欢笑话，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00003",
      "start_ms": 4550,
      "end_ms": 5910,
      "text": "别人朱君，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00004",
      "start_ms": 6110,
      "end_ms": 7110,
      "text": "请你一定要记住。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00005",
      "start_ms": 7310,
      "end_ms": 9190,
      "text": "如果一个侮辱能够让你崩溃，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00006",
      "start_ms": 9330,
      "end_ms": 10990,
      "text": "一个掌声能让你膨胀，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00007",
      "start_ms": 11270,
      "end_ms": 13210,
      "text": "你的心智就不属于你自己。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00008",
      "start_ms": 13410,
      "end_ms": 15850,
      "text": "你是任何开口之人的一名奴隶。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00009",
      "start_ms": 16050,
      "end_ms": 17650,
      "text": "为什么说在这个焦虑的时代，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00010",
      "start_ms": 17650,
      "end_ms": 19910,
      "text": "四多个主义哲学值得每一个人学习？"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00011",
      "start_ms": 20310,
      "end_ms": 21770,
      "text": "别人一句无心的评价，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00012",
      "start_ms": 21790,
      "end_ms": 22730,
      "text": "就能让你低落。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00013",
      "start_ms": 22730,
      "end_ms": 24930,
      "text": "一整晚一条没有回复的消息，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00014",
      "start_ms": 24930,
      "end_ms": 26250,
      "text": "就能让你脑补一整夜，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00015",
      "start_ms": 26630,
      "end_ms": 27030,
      "text": "一点，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00016",
      "start_ms": 27030,
      "end_ms": 28890,
      "text": "不确定就能让你反复内行。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00017",
      "start_ms": 29130,
      "end_ms": 30820,
      "text": "其实压垮你的的不是生活，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00018",
      "start_ms": 31040,
      "end_ms": 32140,
      "text": "是你的控制欲，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00019",
      "start_ms": 32480,
      "end_ms": 33520,
      "text": "你想控制别人，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00020",
      "start_ms": 33520,
      "end_ms": 35440,
      "text": "怎么看你控制事情的结果，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00021",
      "start_ms": 35560,
      "end_ms": 36740,
      "text": "控制关系的走向，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00022",
      "start_ms": 36920,
      "end_ms": 38199,
      "text": "甚至控制未来，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00023",
      "start_ms": 38199,
      "end_ms": 39560,
      "text": "按照你预期去发生。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00024",
      "start_ms": 39960,
      "end_ms": 40880,
      "text": "斯洛克主义说，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00025",
      "start_ms": 41080,
      "end_ms": 43000,
      "text": "世界只分两件事儿，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00026",
      "start_ms": 43000,
      "end_ms": 43560,
      "text": "一件事，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00027",
      "start_ms": 43560,
      "end_ms": 45160,
      "text": "你能控制的一件事，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00028",
      "start_ms": 45240,
      "end_ms": 46060,
      "text": "你怎么折腾，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00029",
      "start_ms": 46060,
      "end_ms": 47080,
      "text": "你都控制不了的。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00030",
      "start_ms": 47380,
      "end_ms": 49820,
      "text": "而大多数人一辈子都在干一件蠢事，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00031",
      "start_ms": 50160,
      "end_ms": 51460,
      "text": "放弃掌控自己，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00032",
      "start_ms": 51520,
      "end_ms": 52900,
      "text": "却拼命去掌控别人。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00033",
      "start_ms": 53220,
      "end_ms": 56920,
      "text": "你所有的焦虑本质都是在试图掌控一个不属于你的世界。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00034",
      "start_ms": 56920,
      "end_ms": 60590,
      "text": "庄子早在两千多年前就已经告告诉我们，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00035",
      "start_ms": 60690,
      "end_ms": 64755,
      "text": "心别受力、掌声和嘘声本质上都是噪声。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00036",
      "start_ms": 65110,
      "end_ms": 66165,
      "text": "比如我是做自媒体，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00037",
      "start_ms": 66410,
      "end_ms": 68755,
      "text": "就会面对很多人对我的种种评价。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00038",
      "start_ms": 69040,
      "end_ms": 69960,
      "text": "而孟子有一句话，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00039",
      "start_ms": 69960,
      "end_ms": 71560,
      "text": "说有不渝之欲，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00040",
      "start_ms": 71640,
      "end_ms": 72795,
      "text": "有求全之慧，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00041",
      "start_ms": 73150,
      "end_ms": 74205,
      "text": "什么叫不逾之欲？"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00042",
      "start_ms": 74430,
      "end_ms": 76535,
      "text": "就是意料之外的过分的赞美。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00043",
      "start_ms": 76780,
      "end_ms": 78100,
      "text": "别人说你真厉害啊，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00044",
      "start_ms": 78100,
      "end_ms": 79140,
      "text": "实际上你心里清楚，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00045",
      "start_ms": 79140,
      "end_ms": 80020,
      "text": "并没有这么厉害。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00046",
      "start_ms": 80120,
      "end_ms": 82065,
      "text": "既然你接受了这么多不愉之语，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00047",
      "start_ms": 82320,
      "end_ms": 84495,
      "text": "那你也应该接受那些求全智慧。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00048",
      "start_ms": 84840,
      "end_ms": 86240,
      "text": "你在别人口中的好坏，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00049",
      "start_ms": 86260,
      "end_ms": 88085,
      "text": "其实和你本身没有太大关系。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00050",
      "start_ms": 88360,
      "end_ms": 90520,
      "text": "朱军人在过得很好的时候，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00051",
      "start_ms": 90520,
      "end_ms": 91855,
      "text": "就会原谅很多事情，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00052",
      "start_ms": 92140,
      "end_ms": 93915,
      "text": "因为自己的内心有了力量，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00053",
      "start_ms": 94150,
      "end_ms": 95765,
      "text": "就懒得跟外界较劲儿。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00054",
      "start_ms": 95980,
      "end_ms": 96220,
      "text": "你看，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00055",
      "start_ms": 96220,
      "end_ms": 99075,
      "text": "山顶的风永远不与谷底的尘埃作战，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00056",
      "start_ms": 99450,
      "end_ms": 102515,
      "text": "所以精神海拔决定了包容的半径。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00057",
      "start_ms": 103060,
      "end_ms": 104980,
      "text": "人强大到能自我满足时，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00058",
      "start_ms": 105020,
      "end_ms": 107305,
      "text": "别人的冒犯就变成了蚊虫叮咬。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00059",
      "start_ms": 107810,
      "end_ms": 109630,
      "text": "你来我欢迎你走，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00060",
      "start_ms": 109710,
      "end_ms": 112155,
      "text": "我不送别人说的话可以听见，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00061",
      "start_ms": 112420,
      "end_ms": 113720,
      "text": "却不必句句收藏。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00062",
      "start_ms": 114020,
      "end_ms": 116015,
      "text": "生活带来的情绪可以感受，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00063",
      "start_ms": 116260,
      "end_ms": 118125,
      "text": "却不必让他们长期居住。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00064",
      "start_ms": 118600,
      "end_ms": 119600,
      "text": "心不受力，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00065",
      "start_ms": 119700,
      "end_ms": 120480,
      "text": "不是冷漠，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00066",
      "start_ms": 120500,
      "end_ms": 121260,
      "text": "不是麻木，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00067",
      "start_ms": 121320,
      "end_ms": 123075,
      "text": "也不是假装什么都不在乎，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00068",
      "start_ms": 123290,
      "end_ms": 124910,
      "text": "而是你可以接受建议，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00069",
      "start_ms": 125030,
      "end_ms": 126175,
      "text": "却不接受审判，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00070",
      "start_ms": 126520,
      "end_ms": 127620,
      "text": "可以经历失去，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00071",
      "start_ms": 127740,
      "end_ms": 128805,
      "text": "却不否定自己，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00072",
      "start_ms": 129120,
      "end_ms": 130860,
      "text": "可以在秋天多愁善感，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00073",
      "start_ms": 130940,
      "end_ms": 133495,
      "text": "却不让一阵风替你决定整个人生。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00074",
      "start_ms": 134200,
      "end_ms": 135140,
      "text": "每每到了秋天，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00075",
      "start_ms": 135220,
      "end_ms": 137735,
      "text": "树木会把养分从叶片收回根部，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00076",
      "start_ms": 138060,
      "end_ms": 141155,
      "text": "人也要把散落在外界的注意力收回来。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00077",
      "start_ms": 141370,
      "end_ms": 143015,
      "text": "从别人的评价里收回来，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00078",
      "start_ms": 143370,
      "end_ms": 145125,
      "text": "该落的意让他落，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00079",
      "start_ms": 145500,
      "end_ms": 147025,
      "text": "该走的人让他走，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00080",
      "start_ms": 147340,
      "end_ms": 150110,
      "text": "该来的风让他来树不追，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00081",
      "start_ms": 150110,
      "end_ms": 151565,
      "text": "夜山不留云。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00082",
      "start_ms": 151860,
      "end_ms": 152660,
      "text": "真正有根的人，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00083",
      "start_ms": 152660,
      "end_ms": 154835,
      "text": "也不必向每一阵风去解释自己。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00084",
      "start_ms": 155170,
      "end_ms": 155830,
      "text": "这个秋天，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00085",
      "start_ms": 156050,
      "end_ms": 157195,
      "text": "让风负责吹，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00086",
      "start_ms": 157500,
      "end_ms": 158900,
      "text": "让夜负责落，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00087",
      "start_ms": 159160,
      "end_ms": 160845,
      "text": "而你只负责站稳，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00088",
      "start_ms": 161150,
      "end_ms": 162905,
      "text": "总有人会喜欢那个真实的你，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00089",
      "start_ms": 163250,
      "end_ms": 164005,
      "text": "一定要相信我。"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00090",
      "start_ms": 164340,
      "end_ms": 165615,
      "text": "如果没有请告诉我，"
    },
    {
      "segment_id": "v_65b3ae1e4d673cf6_s00091",
      "start_ms": 165990,
      "end_ms": 166735,
      "text": "我喜欢你。"
    }
  ],
