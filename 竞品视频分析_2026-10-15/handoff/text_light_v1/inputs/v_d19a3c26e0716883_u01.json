      "segment_id": "v_d19a3c26e0716883_s00031",
      "start_ms": 85720,
      "end_ms": 86125,
      "text": "是水。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00032",
      "start_ms": 86940,
      "end_ms": 89310,
      "text": "怒江七十二拐一条路，"
