      "segment_id": "v_d19a3c26e0716883_s00061",
      "start_ms": 182230,
      "end_ms": 183990,
      "text": "全长三百六十公里。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00062",
      "start_ms": 184470,
      "end_ms": 188530,
      "text": "这条路最绝的是它围着中国最大的内陆湖。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00063",
      "start_ms": 188530,
      "end_ms": 192190,
      "text": "转青海湖四千五百多平方公里。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00064",
      "start_ms": 192630,
      "end_ms": 193510,
      "text": "跟海一样，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00065",
      "start_ms": 193510,
      "end_ms": 196270,
      "text": "大公路就从湖边上过，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00066",
      "start_ms": 196650,
      "end_ms": 197570,
      "text": "一边是湖，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00067",
      "start_ms": 197890,
      "end_ms": 198890,
      "text": "一边是草原。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00068",
      "start_ms": 199450,
      "end_ms": 200990,
      "text": "夏天油菜花开了，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00069",
      "start_ms": 201110,
      "end_ms": 203990,
      "text": "金黄金黄的一片连着一片。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00070",
      "start_ms": 204350,
      "end_ms": 206970,
      "text": "从路边一直铺到山脚下，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00071",
      "start_ms": 207750,
      "end_ms": 209970,
      "text": "再往外是祁连山山顶，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00072",
      "start_ms": 210120,
      "end_ms": 212560,
      "text": "还带着雪湖是蓝的，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00073",
      "start_ms": 212760,
      "end_ms": 213880,
      "text": "花是黄的，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00074",
      "start_ms": 214080,
      "end_ms": 215200,
      "text": "山是白的，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00075",
      "start_ms": 215560,
      "end_ms": 216520,
      "text": "天是青的，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00076",
      "start_ms": 216880,
      "end_ms": 218680,
      "text": "四种颜色排成一条线。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00077",
      "start_ms": 219160,
      "end_ms": 221960,
      "text": "从车窗看出去就是一幅油画，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00078",
      "start_ms": 222700,
      "end_ms": 224420,
      "text": "您开一段停一段，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00079",
      "start_ms": 224600,
      "end_ms": 228180,
      "text": "拍一段三百六十公里能开一整天。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00080",
      "start_ms": 228780,
      "end_ms": 233880,
      "text": "中国国家地理西部最美公路环湖公路排在前头。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00081",
      "start_ms": 234420,
      "end_ms": 239080,
      "text": "我前阵子翻到一本叫三百六十五日走遍中国的日历书，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00082",
      "start_ms": 239260,
      "end_ms": 242290,
      "text": "左边一页是每个地方的实景大图，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00083",
      "start_ms": 242290,
      "end_ms": 245425,
      "text": "加一段五十来个字的冷知识，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00084",
      "start_ms": 246020,
      "end_ms": 247865,
      "text": "右边是日期记事夜，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00085",
      "start_ms": 248360,
      "end_ms": 250235,
      "text": "什么季节去哪座小城，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00086",
      "start_ms": 250710,
      "end_ms": 251490,
      "text": "走哪条路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00087",
      "start_ms": 251490,
      "end_ms": 253045,
      "text": "看什么风景最合适，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00088",
      "start_ms": 253610,
      "end_ms": 254965,
      "text": "都给你安排好了。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00089",
      "start_ms": 255240,
      "end_ms": 258165,
      "text": "不是那种千篇一律的景点介绍，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00090",
      "start_ms": 258540,
      "end_ms": 259985,
      "text": "是帮你挑日子。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00091",
      "start_ms": 260610,
      "end_ms": 262355,
      "text": "今天翻到独库公路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00092",
      "start_ms": 262670,
      "end_ms": 264415,
      "text": "明天翻到环湖公路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00093",
      "start_ms": 264720,
      "end_ms": 266795,
      "text": "后天翻到盘龙古道，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00094",
      "start_ms": 267230,
      "end_ms": 268030,
      "text": "翻到哪页，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00095",
      "start_ms": 268030,
      "end_ms": 273505,
      "text": "就觉得那个地方在喊你我自己的习惯是每天早起翻一页当个消遣，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00096",
      "start_ms": 273920,
      "end_ms": 276180,
      "text": "翻到一个从来没听说过的小地方，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00097",
      "start_ms": 276280,
      "end_ms": 278075,
      "text": "就去网上搜搜照片，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00098",
      "start_ms": 278550,
      "end_ms": 279910,
      "text": "搜完就想订票。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00099",
      "start_ms": 280130,
      "end_ms": 281425,
      "text": "我已经放下面了，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00100",
      "start_ms": 281890,
      "end_ms": 283325,
      "text": "点开就能看到。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00101",
      "start_ms": 283720,
      "end_ms": 285320,
      "text": "喜欢到处走走的朋友，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00102",
      "start_ms": 285480,
      "end_ms": 286800,
      "text": "弄一本放茶几，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00103",
      "start_ms": 286800,
      "end_ms": 288635,
      "text": "上一年下来，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00104",
      "start_ms": 289080,
      "end_ms": 290880,
      "text": "整个中国哪儿值得去，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00105",
      "start_ms": 290880,
      "end_ms": 293275,
      "text": "哪个乐曲心里全有谱了。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00106",
      "start_ms": 293720,
      "end_ms": 294295,
      "text": "第二名，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00107",
      "start_ms": 294690,
      "end_ms": 298305,
      "text": "新疆盘龙古道在帕米尔高原上。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00108",
      "start_ms": 298770,
      "end_ms": 301530,
      "text": "从塔什库尔干到瓦恰乡，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00109",
      "start_ms": 301830,
      "end_ms": 303330,
      "text": "全长三十六公里，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00110",
      "start_ms": 303990,
      "end_ms": 309730,
      "text": "这条路最绝的是它弯到多到吓人三十多公里的路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00111",
      "start_ms": 310170,
      "end_ms": 311770,
      "text": "六百多个s弯，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00112",
      "start_ms": 312150,
      "end_ms": 314590,
      "text": "平均每五十米就有一个弯。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00113",
      "start_ms": 314670,
      "end_ms": 315950,
      "text": "从山顶往下看，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00114",
      "start_ms": 316290,
      "end_ms": 319790,
      "text": "整条路像一条巨龙盘在山脊上，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00115",
      "start_ms": 319950,
      "end_ms": 320870,
      "text": "弯弯绕绕，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00116",
      "start_ms": 321190,
      "end_ms": 322350,
      "text": "一层叠着一层，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00117",
      "start_ms": 322790,
      "end_ms": 324570,
      "text": "从海拔四千二百米，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00118",
      "start_ms": 324710,
      "end_ms": 326190,
      "text": "一路降到三千米，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00119",
      "start_ms": 326430,
      "end_ms": 329040,
      "text": "落差一千多米全是弯。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00120",
      "start_ms": 330980,
      "end_ms": 331960,
      "text": "您坐在车里，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00121",
      "start_ms": 332880,
      "end_ms": 334060,
      "text": "方向盘还没回，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00122",
      "start_ms": 334060,
      "end_ms": 336280,
      "text": "正下一个弯就到了。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00123",
      "start_ms": 337300,
      "end_ms": 337980,
      "text": "当地人。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00124",
      "start_ms": 337980,
      "end_ms": 339300,
      "text": "有句话叫，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00125",
      "start_ms": 339360,
      "end_ms": 342020,
      "text": "今日走过了人生所有的弯路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00126",
      "start_ms": 342920,
      "end_ms": 345140,
      "text": "从此人生尽是坦途。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00127",
      "start_ms": 345760,
      "end_ms": 347940,
      "text": "这条路本来是给牧民走的，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00128",
      "start_ms": 348400,
      "end_ms": 350040,
      "text": "后来修成了柏油路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00129",
      "start_ms": 350480,
      "end_ms": 351720,
      "text": "自驾的人来了，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00130",
      "start_ms": 352440,
      "end_ms": 354820,
      "text": "拍了照片发到网上火了。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00131",
      "start_ms": 354980,
      "end_ms": 355840,
      "text": "帕米尔高原，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00132",
      "start_ms": 356260,
      "end_ms": 357880,
      "text": "祖国最西边的地方，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00133",
      "start_ms": 358100,
      "end_ms": 359295,
      "text": "天蓝难得发黑，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00134",
      "start_ms": 359670,
      "end_ms": 360715,
      "text": "云白的刺眼，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00135",
      "start_ms": 361140,
      "end_ms": 362415,
      "text": "雪山就在路边，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00136",
      "start_ms": 362780,
      "end_ms": 364475,
      "text": "一条路六百个弯。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00137",
      "start_ms": 364870,
      "end_ms": 365250,
      "text": "您说，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00138",
      "start_ms": 365250,
      "end_ms": 367915,
      "text": "这是公路还是大自然的过山车？"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00139",
      "start_ms": 368580,
      "end_ms": 369115,
      "text": "第一名，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00140",
      "start_ms": 369510,
      "end_ms": 373575,
      "text": "青藏公路从青海格尔木到西藏拉萨，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00141",
      "start_ms": 373920,
      "end_ms": 375795,
      "text": "全长一千一百多公里。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00142",
      "start_ms": 376710,
      "end_ms": 379765,
      "text": "这条路最绝的是他修在天上，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00143",
      "start_ms": 380140,
      "end_ms": 382275,
      "text": "平均海拔四千多米，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00144",
      "start_ms": 382840,
      "end_ms": 383905,
      "text": "翻过昆仑山，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00145",
      "start_ms": 384210,
      "end_ms": 385335,
      "text": "穿过可可西里，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00146",
      "start_ms": 385720,
      "end_ms": 386925,
      "text": "跨过唐古拉山，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00147",
      "start_ms": 387300,
      "end_ms": 389515,
      "text": "一路都在云端上走，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00148",
      "start_ms": 390000,
      "end_ms": 392555,
      "text": "路边能看到藏羚羊，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00149",
      "start_ms": 392840,
      "end_ms": 395465,
      "text": "一群一群的在草原上跑，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00150",
      "start_ms": 395780,
      "end_ms": 396815,
      "text": "能看到雪山，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00151",
      "start_ms": 397410,
      "end_ms": 399985,
      "text": "一座连着一座白的晃眼，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00152",
      "start_ms": 400370,
      "end_ms": 407455,
      "text": "能看到草原无边无际的绿到天边可可西里、世界屋脊上的净土。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00153",
      "start_ms": 407960,
      "end_ms": 411015,
      "text": "青藏高原世界四大超禁区之一，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00154",
      "start_ms": 411450,
      "end_ms": 413005,
      "text": "天空蓝的不像话，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00155",
      "start_ms": 413350,
      "end_ms": 416220,
      "text": "云低的伸手就能摘这条路。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00156",
      "start_ms": 416220,
      "end_ms": 417300,
      "text": "修了四年多，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00157",
      "start_ms": 417560,
      "end_ms": 419740,
      "text": "三千多人牺牲在路上，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00158",
      "start_ms": 419960,
      "end_ms": 422695,
      "text": "平均每公里埋着一个修路人，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00159",
      "start_ms": 423290,
      "end_ms": 424505,
      "text": "别的路美在风景，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00160",
      "start_ms": 425030,
      "end_ms": 425870,
      "text": "青藏公路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00161",
      "start_ms": 425870,
      "end_ms": 427540,
      "text": "美在他是用命，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00162",
      "start_ms": 427800,
      "end_ms": 431105,
      "text": "从戈壁滩上一步一步拖到天上的。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00163",
      "start_ms": 431300,
      "end_ms": 432820,
      "text": "您说这条路排第一，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00164",
      "start_ms": 433040,
      "end_ms": 433845,
      "text": "服不服？"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00165",
      "start_ms": 434160,
      "end_ms": 435305,
      "text": "您听出来了没有？"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00166",
      "start_ms": 435780,
      "end_ms": 442100,
      "text": "这十条公路没有一条是光靠好看出名的郭亮挂壁公路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00167",
      "start_ms": 442200,
      "end_ms": 444570,
      "text": "靠的是天窗画框河，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00168",
      "start_ms": 444570,
      "end_ms": 447505,
      "text": "那高速靠的是穿行在枫林里，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00169",
      "start_ms": 448400,
      "end_ms": 449260,
      "text": "永无公路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00170",
      "start_ms": 449500,
      "end_ms": 450480,
      "text": "靠的是夏天。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00171",
      "start_ms": 450480,
      "end_ms": 451165,
      "text": "在水里，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00172",
      "start_ms": 451890,
      "end_ms": 452790,
      "text": "草原天路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00173",
      "start_ms": 452950,
      "end_ms": 454545,
      "text": "靠的是老百姓的眼睛。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00174",
      "start_ms": 455460,
      "end_ms": 459365,
      "text": "塔里木沙漠公路靠的是跟沙漠打了一仗，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00175",
      "start_ms": 459760,
      "end_ms": 463735,
      "text": "川藏线靠的是用命铺出来的景观大道，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00176",
      "start_ms": 464450,
      "end_ms": 467145,
      "text": "独库公路靠的是一天过四季，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00177",
      "start_ms": 467700,
      "end_ms": 468720,
      "text": "环湖公路，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00178",
      "start_ms": 468840,
      "end_ms": 471260,
      "text": "靠的是围着青海湖转一圈。"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00179",
      "start_ms": 471480,
      "end_ms": 473760,
      "text": "盘龙古道靠的是六百个弯儿，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00180",
      "start_ms": 474170,
      "end_ms": 477155,
      "text": "青藏公路靠的是从戈壁拖到天上，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00181",
      "start_ms": 477640,
      "end_ms": 480735,
      "text": "每一条路的厉害之处都不在它有多长，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00182",
      "start_ms": 481110,
      "end_ms": 482135,
      "text": "在他有多好看，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00183",
      "start_ms": 482430,
      "end_ms": 483255,
      "text": "点个关注，"
    },
    {
      "segment_id": "v_d19a3c26e0716883_s00184",
      "start_ms": 483760,
      "end_ms": 485375,
      "text": "咱们下期接着聊。"
    }
  ],
