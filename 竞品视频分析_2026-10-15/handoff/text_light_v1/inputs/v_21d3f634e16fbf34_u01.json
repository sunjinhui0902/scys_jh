  ],
  "duration_s": 85.285011,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "我真不怎么喜欢你，但您从来没有在工作上为难过，我领导的格局值得我们学习。这次项目多亏你了，以后公司还得靠你们年轻人。领导，您说笑了，我们年轻人再能闯，也得有您这样的老将挂帅才行。以后我就是您的左膀右臂，我和李总你更喜欢谁？对领导怎么能用喜欢呢？那得叫尊敬两位领导啊，我都很尊敬小李又升职了，有什么感想？感想就是站得越高，越觉得您不容易，以后还得跟您多学，争取，不给您丢脸。小李，辛苦了，领导，这是我应该做的。强将手下无弱兵嘛，我怎么能给您丢脸呢？你干活怎么比乌龟还慢？领导，俗话说，慢工出细活，我细致的对待每一个工作项目，不就避免了以后出现什么质量问题吗？年轻就是好啊，年轻就是还不够沉稳，还要向您多学习，我们才能变得更优秀。哈哈哈哈哈小李呀，我看你最近是越来越精神了啊，那是因为沾了领导，您的光，跟着您干事儿，气色都不敢差。哈哈哈哈哈关注我，每天学点高情商，说话技巧，让你的路越走越宽。",
  "segments": [
    {
      "segment_id": "v_21d3f634e16fbf34_s00001",
      "start_ms": 540,
      "end_ms": 1760,
      "text": "我真不怎么喜欢你，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00002",
      "start_ms": 2360,
      "end_ms": 4220,
      "text": "但您从来没有在工作上为难过，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00003",
      "start_ms": 4220,
      "end_ms": 6080,
      "text": "我领导的格局值得我们学习。"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00004",
      "start_ms": 8399,
      "end_ms": 9660,
      "text": "这次项目多亏你了，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00005",
      "start_ms": 9740,
      "end_ms": 11460,
      "text": "以后公司还得靠你们年轻人。"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00006",
      "start_ms": 12520,
      "end_ms": 12900,
      "text": "领导，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00007",
      "start_ms": 13060,
      "end_ms": 13860,
      "text": "您说笑了，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00008",
      "start_ms": 14120,
      "end_ms": 15460,
      "text": "我们年轻人再能闯，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00009",
      "start_ms": 15580,
      "end_ms": 17500,
      "text": "也得有您这样的老将挂帅才行。"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00010",
      "start_ms": 17900,
      "end_ms": 19420,
      "text": "以后我就是您的左膀右臂，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00011",
      "start_ms": 21040,
      "end_ms": 22640,
      "text": "我和李总你更喜欢谁？"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00012",
      "start_ms": 23660,
      "end_ms": 25460,
      "text": "对领导怎么能用喜欢呢？"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00013",
      "start_ms": 25700,
      "end_ms": 27340,
      "text": "那得叫尊敬两位领导啊，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00014",
      "start_ms": 27340,
      "end_ms": 32910,
      "text": "我都很尊敬小李又升职了，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00015",
      "start_ms": 33050,
      "end_ms": 33870,
      "text": "有什么感想？"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00016",
      "start_ms": 34510,
      "end_ms": 35830,
      "text": "感想就是站得越高，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00017",
      "start_ms": 35890,
      "end_ms": 36950,
      "text": "越觉得您不容易，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00018",
      "start_ms": 37270,
      "end_ms": 38430,
      "text": "以后还得跟您多学，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00019",
      "start_ms": 38610,
      "end_ms": 38910,
      "text": "争取，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00020",
      "start_ms": 38910,
      "end_ms": 40075,
      "text": "不给您丢脸。"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00021",
      "start_ms": 42430,
      "end_ms": 42870,
      "text": "小李，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00022",
      "start_ms": 43750,
      "end_ms": 44410,
      "text": "辛苦了，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00023",
      "start_ms": 45050,
      "end_ms": 45490,
      "text": "领导，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00024",
      "start_ms": 45610,
      "end_ms": 46750,
      "text": "这是我应该做的。"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00025",
      "start_ms": 46930,
      "end_ms": 48310,
      "text": "强将手下无弱兵嘛，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00026",
      "start_ms": 48330,
      "end_ms": 49490,
      "text": "我怎么能给您丢脸呢？"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00027",
      "start_ms": 52250,
      "end_ms": 53670,
      "text": "你干活怎么比乌龟还慢？"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00028",
      "start_ms": 54510,
      "end_ms": 54930,
      "text": "领导，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00029",
      "start_ms": 55410,
      "end_ms": 56070,
      "text": "俗话说，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00030",
      "start_ms": 56090,
      "end_ms": 57150,
      "text": "慢工出细活，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00031",
      "start_ms": 57490,
      "end_ms": 59470,
      "text": "我细致的对待每一个工作项目，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00032",
      "start_ms": 59510,
      "end_ms": 62285,
      "text": "不就避免了以后出现什么质量问题吗？"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00033",
      "start_ms": 63230,
      "end_ms": 64455,
      "text": "年轻就是好啊，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00034",
      "start_ms": 64940,
      "end_ms": 66245,
      "text": "年轻就是还不够沉稳，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00035",
      "start_ms": 66560,
      "end_ms": 67635,
      "text": "还要向您多学习，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00036",
      "start_ms": 67920,
      "end_ms": 69055,
      "text": "我们才能变得更优秀。"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00037",
      "start_ms": 69470,
      "end_ms": 71705,
      "text": "哈哈哈哈哈小李呀，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00038",
      "start_ms": 72270,
      "end_ms": 74565,
      "text": "我看你最近是越来越精神了啊，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00039",
      "start_ms": 75060,
      "end_ms": 76020,
      "text": "那是因为沾了领导，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00040",
      "start_ms": 76020,
      "end_ms": 76500,
      "text": "您的光，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00041",
      "start_ms": 76760,
      "end_ms": 77680,
      "text": "跟着您干事儿，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00042",
      "start_ms": 77680,
      "end_ms": 78645,
      "text": "气色都不敢差。"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00043",
      "start_ms": 79030,
      "end_ms": 81010,
      "text": "哈哈哈哈哈关注我，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00044",
      "start_ms": 81190,
      "end_ms": 82510,
      "text": "每天学点高情商，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00045",
      "start_ms": 82510,
      "end_ms": 83195,
      "text": "说话技巧，"
    },
    {
      "segment_id": "v_21d3f634e16fbf34_s00046",
      "start_ms": 83560,
      "end_ms": 85125,
      "text": "让你的路越走越宽。"
    }
  ],
