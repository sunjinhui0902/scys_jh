  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "今天被一篇文章狠狠的共情了，值得分享。给孩子和屏幕前的你。文章的题目叫做妈妈怕了你一辈子。怀孕时妈妈怕你畸形。出生时，妈妈怕你生病，到了幼儿园，妈妈怕你受欺负。小学时，妈妈怕你跟不上。到了初中了，妈妈怕你叛逆。高中时，妈妈怕你早恋。大学时，妈妈怕你堕落，步入社会，会了，妈妈怕你受委屈。结婚时，妈妈怕你不幸福妈妈，老了怕给你添麻烦。妈妈走了，怕你孤单的牵妈想妈妈，而是你一辈子。最放心不下的牵挂。",
  "segments": [
    {
      "segment_id": "v_292f228ab1734fe8_s00001",
      "start_ms": 210,
      "end_ms": 2310,
      "text": "今天被一篇文章狠狠的共情了，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00002",
      "start_ms": 2450,
      "end_ms": 3030,
      "text": "值得分享。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00003",
      "start_ms": 3030,
      "end_ms": 5010,
      "text": "给孩子和屏幕前的你。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00004",
      "start_ms": 5550,
      "end_ms": 8950,
      "text": "文章的题目叫做妈妈怕了你一辈子。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00005",
      "start_ms": 9530,
      "end_ms": 11710,
      "text": "怀孕时妈妈怕你畸形。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00006",
      "start_ms": 12090,
      "end_ms": 12730,
      "text": "出生时，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00007",
      "start_ms": 13290,
      "end_ms": 14470,
      "text": "妈妈怕你生病，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00008",
      "start_ms": 15070,
      "end_ms": 15950,
      "text": "到了幼儿园，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00009",
      "start_ms": 16250,
      "end_ms": 17690,
      "text": "妈妈怕你受欺负。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00010",
      "start_ms": 18190,
      "end_ms": 18890,
      "text": "小学时，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00011",
      "start_ms": 19330,
      "end_ms": 20630,
      "text": "妈妈怕你跟不上。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00012",
      "start_ms": 21270,
      "end_ms": 22250,
      "text": "到了初中了，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00013",
      "start_ms": 22410,
      "end_ms": 23550,
      "text": "妈妈怕你叛逆。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00014",
      "start_ms": 23830,
      "end_ms": 24450,
      "text": "高中时，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00015",
      "start_ms": 24970,
      "end_ms": 26190,
      "text": "妈妈怕你早恋。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00016",
      "start_ms": 26810,
      "end_ms": 27510,
      "text": "大学时，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00017",
      "start_ms": 27790,
      "end_ms": 29010,
      "text": "妈妈怕你堕落，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00018",
      "start_ms": 29350,
      "end_ms": 30000,
      "text": "步入社会，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00019",
      "start_ms": 30220,
      "end_ms": 31060,
      "text": "会了，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00020",
      "start_ms": 31060,
      "end_ms": 33020,
      "text": "妈妈怕你受委屈。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00021",
      "start_ms": 33020,
      "end_ms": 34240,
      "text": "结婚时，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00022",
      "start_ms": 34240,
      "end_ms": 37020,
      "text": "妈妈怕你不幸福妈妈，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00023",
      "start_ms": 37820,
      "end_ms": 40260,
      "text": "老了怕给你添麻烦。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00024",
      "start_ms": 40480,
      "end_ms": 42180,
      "text": "妈妈走了，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00025",
      "start_ms": 42180,
      "end_ms": 47380,
      "text": "怕你孤单的牵妈想妈妈，"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00026",
      "start_ms": 47380,
      "end_ms": 53040,
      "text": "而是你一辈子。"
    },
    {
      "segment_id": "v_292f228ab1734fe8_s00027",
      "start_ms": 54360,
      "end_ms": 57360,
      "text": "最放心不下的牵挂。"
    }
  ],
