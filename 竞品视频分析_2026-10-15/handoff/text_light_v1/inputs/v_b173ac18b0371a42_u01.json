  "source_title": "陈景润 他被学校辞退，后来让全世界闭嘴\n#陈景润 #国之脊梁 #读书感悟 #读书心得\n#数学家 #文字共鸣 #情感共鸣",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
  "status": "AI_PENDING",
