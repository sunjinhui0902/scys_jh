    "v_2abd361a036a65a4_u01"
  ],
  "duration_s": 76.724138,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "人过了五十岁啊，如果你想要活得舒心一点，以下这五句话，你一定要牢记。第一，人这一辈子啊，除了健康，什么都不是你的。少生气，少计较，多开心，多干动，好好爱自己。有个好身体比什么都强。第二，只要是消耗你情绪的人和事，你就悄悄的把他请出你的世界。人活着就该敞亮点或打点，该干嘛就干嘛，不要让等待和内耗拖垮了你的身体。第三，管不了的人，你就放手控制不了的事情，你就随他而去，你啥都不用管管好自己就行。因为你管不了人生，本该就是顺其自然，随遇而安。第四，这个世间万物啊都是有定数的，得到的未必是福，失去的也未必是祸。第五，不要为往事过不去，因为他已经过去，也不要被现实过不去，因为你还要过大气。我在当下享受，现在就是最好的活法。看到这里，不妨在心中默念越来越好，一定要相信语言的力量。新城泽林最后也希望你越来越好。",
  "segments": [
    {
      "segment_id": "v_2abd361a036a65a4_s00001",
      "start_ms": 250,
      "end_ms": 1350,
      "text": "人过了五十岁啊，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00002",
      "start_ms": 1350,
      "end_ms": 2910,
      "text": "如果你想要活得舒心一点，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00003",
      "start_ms": 2990,
      "end_ms": 3990,
      "text": "以下这五句话，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00004",
      "start_ms": 4130,
      "end_ms": 5130,
      "text": "你一定要牢记。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00005",
      "start_ms": 5430,
      "end_ms": 5910,
      "text": "第一，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00006",
      "start_ms": 6350,
      "end_ms": 7450,
      "text": "人这一辈子啊，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00007",
      "start_ms": 7490,
      "end_ms": 8170,
      "text": "除了健康，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00008",
      "start_ms": 8490,
      "end_ms": 9730,
      "text": "什么都不是你的。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00009",
      "start_ms": 10030,
      "end_ms": 10690,
      "text": "少生气，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00010",
      "start_ms": 10910,
      "end_ms": 11650,
      "text": "少计较，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00011",
      "start_ms": 11850,
      "end_ms": 12490,
      "text": "多开心，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00012",
      "start_ms": 12670,
      "end_ms": 13390,
      "text": "多干动，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00013",
      "start_ms": 13610,
      "end_ms": 14530,
      "text": "好好爱自己。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00014",
      "start_ms": 14770,
      "end_ms": 16910,
      "text": "有个好身体比什么都强。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00015",
      "start_ms": 17450,
      "end_ms": 17870,
      "text": "第二，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00016",
      "start_ms": 18310,
      "end_ms": 20150,
      "text": "只要是消耗你情绪的人和事，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00017",
      "start_ms": 20310,
      "end_ms": 22830,
      "text": "你就悄悄的把他请出你的世界。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00018",
      "start_ms": 23250,
      "end_ms": 25830,
      "text": "人活着就该敞亮点或打点，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00019",
      "start_ms": 25970,
      "end_ms": 27150,
      "text": "该干嘛就干嘛，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00020",
      "start_ms": 27350,
      "end_ms": 30480,
      "text": "不要让等待和内耗拖垮了你的身体。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00021",
      "start_ms": 30820,
      "end_ms": 31260,
      "text": "第三，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00022",
      "start_ms": 31740,
      "end_ms": 32560,
      "text": "管不了的人，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00023",
      "start_ms": 32680,
      "end_ms": 34780,
      "text": "你就放手控制不了的事情，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00024",
      "start_ms": 35000,
      "end_ms": 36220,
      "text": "你就随他而去，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00025",
      "start_ms": 36400,
      "end_ms": 38600,
      "text": "你啥都不用管管好自己就行。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00026",
      "start_ms": 38820,
      "end_ms": 40660,
      "text": "因为你管不了人生，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00027",
      "start_ms": 40660,
      "end_ms": 42500,
      "text": "本该就是顺其自然，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00028",
      "start_ms": 42800,
      "end_ms": 43760,
      "text": "随遇而安。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00029",
      "start_ms": 44440,
      "end_ms": 44900,
      "text": "第四，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00030",
      "start_ms": 45080,
      "end_ms": 47640,
      "text": "这个世间万物啊都是有定数的，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00031",
      "start_ms": 47820,
      "end_ms": 48960,
      "text": "得到的未必是福，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00032",
      "start_ms": 49300,
      "end_ms": 51300,
      "text": "失去的也未必是祸。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00033",
      "start_ms": 51980,
      "end_ms": 52500,
      "text": "第五，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00034",
      "start_ms": 52640,
      "end_ms": 54040,
      "text": "不要为往事过不去，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00035",
      "start_ms": 54280,
      "end_ms": 56080,
      "text": "因为他已经过去，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00036",
      "start_ms": 56480,
      "end_ms": 58000,
      "text": "也不要被现实过不去，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00037",
      "start_ms": 58300,
      "end_ms": 60735,
      "text": "因为你还要过大气。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00038",
      "start_ms": 60900,
      "end_ms": 62080,
      "text": "我在当下享受，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00039",
      "start_ms": 62080,
      "end_ms": 64215,
      "text": "现在就是最好的活法。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00040",
      "start_ms": 64780,
      "end_ms": 65440,
      "text": "看到这里，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00041",
      "start_ms": 65480,
      "end_ms": 67740,
      "text": "不妨在心中默念越来越好，"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00042",
      "start_ms": 67920,
      "end_ms": 69455,
      "text": "一定要相信语言的力量。"
    },
    {
      "segment_id": "v_2abd361a036a65a4_s00043",
      "start_ms": 69780,
      "end_ms": 73995,
      "text": "新城泽林最后也希望你越来越好。"
    }
  ],
