  "unit_index": 1,
  "unit_count": 1,
  "all_video_unit_ids": [
    "v_3c6e3ef7c207a723_u01"
  ],
  "duration_s": 410.297007,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "您知道中国最不可思议的长寿村是哪一个吗？有人说是广西巴马八盘屯全同五百多人巅峰时，同时健在的百岁寿星，就有整整七位名扬海内外。有人说是湖北钟祥水平村，明朝皇帝亲自下旨嘉奖的长寿福地，全村一千多口人，八九十岁以上的老寿星就有几十号，对不住了水平村连前五都挤不进名气最大的巴马也不是第一，真正排在榜首的那座村子根本不在温润水乡，也不在深山老林，它紧挨着大漠的风沙边缘，年降水量甚至不足四十毫米。今天，咱们就来盘点中国十大最不可思议的长寿村话。不多说，茶给您沏好了，老麻烦您顺手点个小红心，咱们这就开讲。第十名，江苏如皋长青村江淮平原腹地。在很多人的印象里，能出长寿村的地方，怎么也得是崇山峻岭。可如皋这片土地一马平川，海拔只有几米高，村里八九十岁的老人随处可见，这里不靠高山阻隔城市，靠的是世代相传的水土与慢节奏。您清晨走到长青村的田埂上，放眼望去，全是齐整的麦田与菜畦。七八十岁的老人提着菜篮在石桥边拉家常，脚步轻快的像一阵风平原，没有险丰的灵气，却有踏踏实实的烟火气，一马平川，也能孕育漫长岁月。您说这算不算打破了常理？第九名，山东莱州三山岛村胶东半岛的海滨渔村，有人总觉得长寿是南方温暖水乡的专属。北方天寒地冻，养不住高寿。可三山岛村坐落在渤海湾畔，两千多口人的渔村，八十岁以上的老渔民有一百多号人，这里冬天，海风呼啸，滴水成冰，老人们却是在弦涩的海浪声里摸爬滚打了一辈子。您要是迎着海风走进村口，就能瞧见八十多岁的老汉，光着膀子在岸边修捕渔网，手指粗糙的像老树皮，拉起几米长的麻绳，依旧稳稳当当严寒，没有冻住生机，反而淬炼出硬朗的筋骨。谁说北方海边不养兽第八名？广东大埔石鼓坪村粤东高山地带的客家古村，整座村子隐在千米高山之上，全村几百口人八九十岁的高寿长者就有几十号百岁老人生日，五世同堂拜寿的场面并不稀奇。客家人南迁数百年，整整一个家族都聚居在巨大的圆形土楼里。您站在维吾天井中央，八十多岁的老阿婆脚步生风，还能挑着菜篮麻利的跨过石门槛。九十多岁的老族长端坐在中堂，全村的大小事物都得请他定夺。这里的长寿不是孤零零的熬日子，而是身前身后都簇拥着几代人的烟火。宗族相守的温情，才是长寿最暖的底色。第七名，湖南麻阳漫水村武陵山脉余脉深处的苗寨，这里藏在锦江两岸的崇山峻岭之中，是盘户文化世代浸润的古老村落。村里九十岁以上的高龄老人多达几十位千百年间苗，民们移山结寨，晨起看山间，云雾日，落枕着流水入眠。您要是顺着青石板路踏进苗寨，迎面就能撞见挽着青布头帕的九旬阿婆，一边手脚麻利的编着竹篓，一边哼唱着古老的苗歌。他们敬畏自然，顺应天时。几百年来，从不把得失放在心上，知足常乐的山民性情，把日子过成了神仙般的悠长。您说不可思议，不第六名。湖北钟祥客店镇水平村坐拥千年古树群的荆楚古村落。水坪村拥有上百棵数百年甚至上千年的参天古银杏，而村里八九十岁的老寿星更是数不胜数，这里自古文风昌盛，明清以来的宗祠与石碑上，密密麻麻刻满了相邻敬老的族规家训。您漫步在铺满金色银杏树叶的青石古道上，三百年树龄的大树遮天蔽日，八九十岁的老寿星们正坐在石磨旁围炉煮茶，谈笑间，神采奕奕。几百年风雨过去，战乱毁掉了无数亭台楼阁，但水平村敬老养老的家风一代也没断过，古树长青、仁义长寿，这是荆楚大地最深沉的岁月回响。从第十到第六名长青村，让平原打破了高山神话。三山岛村，让北方海边活出了硬朗筋骨。石鼓坪村用土楼围拢起四世同堂漫水村，把苗歌唱进了百岁岁月水平村在千年古树下守住了敬老风谷。可他们还不是最不可思议的。接下来第五道第一名更让人惊叹，有一座村庄把长寿过成了溪流，茶香里的神仙日子，还有一座天下闻名的神仙福地，被所有人当成了终极答案，可排在榜首的那座村子不在山清水秀之地，反而深嵌在大漠狂风的边缘。他是哪座？他凭什么排在广西巴马前面，下一集已经同步更新，点开我的头像，进入主页就能看到点个关注，看看谁才是中国最不可思议的长寿村。",
  "segments": [
    {
      "segment_id": "v_3c6e3ef7c207a723_s00001",
      "start_ms": 290,
      "end_ms": 4170,
      "text": "您知道中国最不可思议的长寿村是哪一个吗？"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00002",
      "start_ms": 4750,
      "end_ms": 11050,
      "text": "有人说是广西巴马八盘屯全同五百多人巅峰时，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00003",
      "start_ms": 11150,
      "end_ms": 13450,
      "text": "同时健在的百岁寿星，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00004",
      "start_ms": 13770,
      "end_ms": 17030,
      "text": "就有整整七位名扬海内外。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00005",
      "start_ms": 17390,
      "end_ms": 19730,
      "text": "有人说是湖北钟祥水平村，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00006",
      "start_ms": 20510,
      "end_ms": 24330,
      "text": "明朝皇帝亲自下旨嘉奖的长寿福地，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00007",
      "start_ms": 24990,
      "end_ms": 26610,
      "text": "全村一千多口人，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00008",
      "start_ms": 27150,
      "end_ms": 29845,
      "text": "八九十岁以上的老寿星就有几十号，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00009",
      "start_ms": 30200,
      "end_ms": 37240,
      "text": "对不住了水平村连前五都挤不进名气最大的巴马也不是第一，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00010",
      "start_ms": 37880,
      "end_ms": 42740,
      "text": "真正排在榜首的那座村子根本不在温润水乡，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00011",
      "start_ms": 43420,
      "end_ms": 45200,
      "text": "也不在深山老林，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00012",
      "start_ms": 45560,
      "end_ms": 47940,
      "text": "它紧挨着大漠的风沙边缘，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00013",
      "start_ms": 48420,
      "end_ms": 51240,
      "text": "年降水量甚至不足四十毫米。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00014",
      "start_ms": 51800,
      "end_ms": 52220,
      "text": "今天，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00015",
      "start_ms": 52220,
      "end_ms": 56980,
      "text": "咱们就来盘点中国十大最不可思议的长寿村话。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00016",
      "start_ms": 56980,
      "end_ms": 57520,
      "text": "不多说，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00017",
      "start_ms": 57920,
      "end_ms": 59260,
      "text": "茶给您沏好了，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00018",
      "start_ms": 59700,
      "end_ms": 62265,
      "text": "老麻烦您顺手点个小红心，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00019",
      "start_ms": 62630,
      "end_ms": 63745,
      "text": "咱们这就开讲。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00020",
      "start_ms": 64180,
      "end_ms": 65025,
      "text": "第十名，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00021",
      "start_ms": 65540,
      "end_ms": 69625,
      "text": "江苏如皋长青村江淮平原腹地。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00022",
      "start_ms": 70350,
      "end_ms": 71945,
      "text": "在很多人的印象里，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00023",
      "start_ms": 72370,
      "end_ms": 74215,
      "text": "能出长寿村的地方，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00024",
      "start_ms": 74580,
      "end_ms": 76395,
      "text": "怎么也得是崇山峻岭。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00025",
      "start_ms": 76840,
      "end_ms": 79225,
      "text": "可如皋这片土地一马平川，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00026",
      "start_ms": 79750,
      "end_ms": 81385,
      "text": "海拔只有几米高，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00027",
      "start_ms": 81760,
      "end_ms": 84375,
      "text": "村里八九十岁的老人随处可见，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00028",
      "start_ms": 84830,
      "end_ms": 87195,
      "text": "这里不靠高山阻隔城市，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00029",
      "start_ms": 87620,
      "end_ms": 90485,
      "text": "靠的是世代相传的水土与慢节奏。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00030",
      "start_ms": 90930,
      "end_ms": 93695,
      "text": "您清晨走到长青村的田埂上，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00031",
      "start_ms": 94260,
      "end_ms": 95180,
      "text": "放眼望去，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00032",
      "start_ms": 95240,
      "end_ms": 97485,
      "text": "全是齐整的麦田与菜畦。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00033",
      "start_ms": 98190,
      "end_ms": 101745,
      "text": "七八十岁的老人提着菜篮在石桥边拉家常，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00034",
      "start_ms": 102460,
      "end_ms": 105260,
      "text": "脚步轻快的像一阵风平原，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00035",
      "start_ms": 105340,
      "end_ms": 106875,
      "text": "没有险丰的灵气，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00036",
      "start_ms": 107360,
      "end_ms": 109635,
      "text": "却有踏踏实实的烟火气，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00037",
      "start_ms": 110090,
      "end_ms": 111090,
      "text": "一马平川，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00038",
      "start_ms": 111370,
      "end_ms": 113385,
      "text": "也能孕育漫长岁月。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00039",
      "start_ms": 113960,
      "end_ms": 115955,
      "text": "您说这算不算打破了常理？"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00040",
      "start_ms": 116330,
      "end_ms": 117015,
      "text": "第九名，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00041",
      "start_ms": 117740,
      "end_ms": 123145,
      "text": "山东莱州三山岛村胶东半岛的海滨渔村，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00042",
      "start_ms": 124020,
      "end_ms": 128455,
      "text": "有人总觉得长寿是南方温暖水乡的专属。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00043",
      "start_ms": 129130,
      "end_ms": 130630,
      "text": "北方天寒地冻，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00044",
      "start_ms": 130790,
      "end_ms": 132025,
      "text": "养不住高寿。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00045",
      "start_ms": 132380,
      "end_ms": 135865,
      "text": "可三山岛村坐落在渤海湾畔，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00046",
      "start_ms": 136470,
      "end_ms": 138575,
      "text": "两千多口人的渔村，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00047",
      "start_ms": 139460,
      "end_ms": 142605,
      "text": "八十岁以上的老渔民有一百多号人，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00048",
      "start_ms": 143060,
      "end_ms": 143880,
      "text": "这里冬天，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00049",
      "start_ms": 144020,
      "end_ms": 145065,
      "text": "海风呼啸，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00050",
      "start_ms": 145520,
      "end_ms": 146525,
      "text": "滴水成冰，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00051",
      "start_ms": 147070,
      "end_ms": 152005,
      "text": "老人们却是在弦涩的海浪声里摸爬滚打了一辈子。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00052",
      "start_ms": 152430,
      "end_ms": 154815,
      "text": "您要是迎着海风走进村口，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00053",
      "start_ms": 155300,
      "end_ms": 157620,
      "text": "就能瞧见八十多岁的老汉，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00054",
      "start_ms": 157720,
      "end_ms": 160155,
      "text": "光着膀子在岸边修捕渔网，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00055",
      "start_ms": 160740,
      "end_ms": 162915,
      "text": "手指粗糙的像老树皮，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00056",
      "start_ms": 163570,
      "end_ms": 165350,
      "text": "拉起几米长的麻绳，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00057",
      "start_ms": 165470,
      "end_ms": 167760,
      "text": "依旧稳稳当当严寒，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00058",
      "start_ms": 167780,
      "end_ms": 168880,
      "text": "没有冻住生机，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00059",
      "start_ms": 169180,
      "end_ms": 171565,
      "text": "反而淬炼出硬朗的筋骨。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00060",
      "start_ms": 172010,
      "end_ms": 175030,
      "text": "谁说北方海边不养兽第八名？"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00061",
      "start_ms": 175310,
      "end_ms": 180135,
      "text": "广东大埔石鼓坪村粤东高山地带的客家古村，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00062",
      "start_ms": 180590,
      "end_ms": 183595,
      "text": "整座村子隐在千米高山之上，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00063",
      "start_ms": 184130,
      "end_ms": 191395,
      "text": "全村几百口人八九十岁的高寿长者就有几十号百岁老人生日，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00064",
      "start_ms": 191740,
      "end_ms": 195795,
      "text": "五世同堂拜寿的场面并不稀奇。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00065",
      "start_ms": 196210,
      "end_ms": 198255,
      "text": "客家人南迁数百年，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00066",
      "start_ms": 198780,
      "end_ms": 203205,
      "text": "整整一个家族都聚居在巨大的圆形土楼里。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00067",
      "start_ms": 203640,
      "end_ms": 205805,
      "text": "您站在维吾天井中央，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00068",
      "start_ms": 206480,
      "end_ms": 209105,
      "text": "八十多岁的老阿婆脚步生风，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00069",
      "start_ms": 209800,
      "end_ms": 212840,
      "text": "还能挑着菜篮麻利的跨过石门槛。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00070",
      "start_ms": 213660,
      "end_ms": 216665,
      "text": "九十多岁的老族长端坐在中堂，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00071",
      "start_ms": 217330,
      "end_ms": 220095,
      "text": "全村的大小事物都得请他定夺。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00072",
      "start_ms": 220520,
      "end_ms": 223295,
      "text": "这里的长寿不是孤零零的熬日子，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00073",
      "start_ms": 223750,
      "end_ms": 228095,
      "text": "而是身前身后都簇拥着几代人的烟火。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00074",
      "start_ms": 228600,
      "end_ms": 230325,
      "text": "宗族相守的温情，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00075",
      "start_ms": 230920,
      "end_ms": 233355,
      "text": "才是长寿最暖的底色。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00076",
      "start_ms": 233690,
      "end_ms": 234375,
      "text": "第七名，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00077",
      "start_ms": 234760,
      "end_ms": 239135,
      "text": "湖南麻阳漫水村武陵山脉余脉深处的苗寨，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00078",
      "start_ms": 239650,
      "end_ms": 242995,
      "text": "这里藏在锦江两岸的崇山峻岭之中，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00079",
      "start_ms": 243470,
      "end_ms": 246655,
      "text": "是盘户文化世代浸润的古老村落。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00080",
      "start_ms": 247110,
      "end_ms": 252550,
      "text": "村里九十岁以上的高龄老人多达几十位千百年间苗，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00081",
      "start_ms": 252550,
      "end_ms": 254165,
      "text": "民们移山结寨，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00082",
      "start_ms": 254620,
      "end_ms": 255940,
      "text": "晨起看山间，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00083",
      "start_ms": 256020,
      "end_ms": 257170,
      "text": "云雾日，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00084",
      "start_ms": 257170,
      "end_ms": 259435,
      "text": "落枕着流水入眠。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00085",
      "start_ms": 259880,
      "end_ms": 262625,
      "text": "您要是顺着青石板路踏进苗寨，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00086",
      "start_ms": 263170,
      "end_ms": 266985,
      "text": "迎面就能撞见挽着青布头帕的九旬阿婆，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00087",
      "start_ms": 267830,
      "end_ms": 270275,
      "text": "一边手脚麻利的编着竹篓，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00088",
      "start_ms": 270700,
      "end_ms": 272995,
      "text": "一边哼唱着古老的苗歌。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00089",
      "start_ms": 273380,
      "end_ms": 274655,
      "text": "他们敬畏自然，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00090",
      "start_ms": 274990,
      "end_ms": 276175,
      "text": "顺应天时。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00091",
      "start_ms": 276870,
      "end_ms": 277750,
      "text": "几百年来，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00092",
      "start_ms": 278150,
      "end_ms": 280614,
      "text": "从不把得失放在心上，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00093",
      "start_ms": 280980,
      "end_ms": 283715,
      "text": "知足常乐的山民性情，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00094",
      "start_ms": 284350,
      "end_ms": 287195,
      "text": "把日子过成了神仙般的悠长。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00095",
      "start_ms": 287790,
      "end_ms": 289010,
      "text": "您说不可思议，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00096",
      "start_ms": 289010,
      "end_ms": 290175,
      "text": "不第六名。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00097",
      "start_ms": 291010,
      "end_ms": 297290,
      "text": "湖北钟祥客店镇水平村坐拥千年古树群的荆楚古村落。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00098",
      "start_ms": 297990,
      "end_ms": 303690,
      "text": "水坪村拥有上百棵数百年甚至上千年的参天古银杏，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00099",
      "start_ms": 304470,
      "end_ms": 308410,
      "text": "而村里八九十岁的老寿星更是数不胜数，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00100",
      "start_ms": 308910,
      "end_ms": 310570,
      "text": "这里自古文风昌盛，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00101",
      "start_ms": 311470,
      "end_ms": 313810,
      "text": "明清以来的宗祠与石碑上，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00102",
      "start_ms": 314290,
      "end_ms": 317810,
      "text": "密密麻麻刻满了相邻敬老的族规家训。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00103",
      "start_ms": 318190,
      "end_ms": 322500,
      "text": "您漫步在铺满金色银杏树叶的青石古道上，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00104",
      "start_ms": 323080,
      "end_ms": 326100,
      "text": "三百年树龄的大树遮天蔽日，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00105",
      "start_ms": 326580,
      "end_ms": 331000,
      "text": "八九十岁的老寿星们正坐在石磨旁围炉煮茶，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00106",
      "start_ms": 331420,
      "end_ms": 332260,
      "text": "谈笑间，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00107",
      "start_ms": 332540,
      "end_ms": 333520,
      "text": "神采奕奕。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00108",
      "start_ms": 333840,
      "end_ms": 335380,
      "text": "几百年风雨过去，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00109",
      "start_ms": 335980,
      "end_ms": 338540,
      "text": "战乱毁掉了无数亭台楼阁，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00110",
      "start_ms": 339100,
      "end_ms": 342660,
      "text": "但水平村敬老养老的家风一代也没断过，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00111",
      "start_ms": 343280,
      "end_ms": 345900,
      "text": "古树长青、仁义长寿，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00112",
      "start_ms": 346520,
      "end_ms": 349975,
      "text": "这是荆楚大地最深沉的岁月回响。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00113",
      "start_ms": 350320,
      "end_ms": 352620,
      "text": "从第十到第六名长青村，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00114",
      "start_ms": 352640,
      "end_ms": 354705,
      "text": "让平原打破了高山神话。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00115",
      "start_ms": 355180,
      "end_ms": 356060,
      "text": "三山岛村，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00116",
      "start_ms": 356060,
      "end_ms": 358345,
      "text": "让北方海边活出了硬朗筋骨。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00117",
      "start_ms": 358880,
      "end_ms": 363050,
      "text": "石鼓坪村用土楼围拢起四世同堂漫水村，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00118",
      "start_ms": 363050,
      "end_ms": 368885,
      "text": "把苗歌唱进了百岁岁月水平村在千年古树下守住了敬老风谷。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00119",
      "start_ms": 369710,
      "end_ms": 372045,
      "text": "可他们还不是最不可思议的。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00120",
      "start_ms": 372450,
      "end_ms": 374745,
      "text": "接下来第五道第一名更让人惊叹，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00121",
      "start_ms": 375330,
      "end_ms": 377890,
      "text": "有一座村庄把长寿过成了溪流，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00122",
      "start_ms": 377890,
      "end_ms": 379475,
      "text": "茶香里的神仙日子，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00123",
      "start_ms": 379830,
      "end_ms": 382155,
      "text": "还有一座天下闻名的神仙福地，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00124",
      "start_ms": 382440,
      "end_ms": 384485,
      "text": "被所有人当成了终极答案，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00125",
      "start_ms": 384880,
      "end_ms": 389335,
      "text": "可排在榜首的那座村子不在山清水秀之地，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00126",
      "start_ms": 389850,
      "end_ms": 392995,
      "text": "反而深嵌在大漠狂风的边缘。"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00127",
      "start_ms": 393540,
      "end_ms": 394395,
      "text": "他是哪座？"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00128",
      "start_ms": 394830,
      "end_ms": 397415,
      "text": "他凭什么排在广西巴马前面，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00129",
      "start_ms": 397860,
      "end_ms": 399945,
      "text": "下一集已经同步更新，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00130",
      "start_ms": 400740,
      "end_ms": 401980,
      "text": "点开我的头像，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00131",
      "start_ms": 402020,
      "end_ms": 405495,
      "text": "进入主页就能看到点个关注，"
    },
    {
      "segment_id": "v_3c6e3ef7c207a723_s00132",
      "start_ms": 405960,
      "end_ms": 409955,
      "text": "看看谁才是中国最不可思议的长寿村。"
    }
  ],
