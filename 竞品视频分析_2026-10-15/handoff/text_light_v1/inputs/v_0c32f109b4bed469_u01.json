      "start_ms": 35600,
      "end_ms": 36640,
      "text": "保养五脏六腑，"
    },
    {
      "segment_id": "v_0c32f109b4bed469_s00021",
      "start_ms": 36960,
      "end_ms": 39395,
      "text": "延长寿命最好的方式。"
    }
