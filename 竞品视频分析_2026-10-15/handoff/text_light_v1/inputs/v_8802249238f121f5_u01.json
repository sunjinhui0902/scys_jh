  "duration_s": 463.241379,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "蒋英赌命，传信唤回中国航天，未来举国皆知。钱学森奠基中国航天，却极少有人知晓，拯救这位科学巨匠，成全我国航天事业的，是他身后看似温柔的蒋英，这段尘封的往事，没有激昂的赞歌，只有一场精心动炼动魄的生死营救，读懂他的无畏与坚守，才算真正读懂何谓大国风骨女性担当。整整五年，一家人深陷一国软禁的绝境，想回国，想为祖国做事，却连踏出家门一步的权利都没有。美方层层设防，严密监控，彻底锁住了钱学森的人身自由与科研之路。这位享誉全球的顶尖航天科学家，昔日意气风发，深耕科研，彼时却万般无奈，只能日日凝望祖国版图满心结是归乡，执念却寸步难行。电话被监听，出门，有人跟踪信件，全部拆开检查，特务二十四小时盯着他们，一家人滴水不漏。所有人都觉得钱学森这辈子可能再也回不来了，但只有讲英从来没有放弃。她看着丈夫日渐憔悴，报国无门的模样，心里比谁都清楚，耗下去，困住的不只是一个钱学森，更是中国未来几十年的航天。希望绝境之中，他想出了一个玩命的办法。蒋英有个妹妹定居比利时。他决定把求救信息藏进继王比利时的家书里，经由海外，辗转送回祖国。但这一步步步是死局，一旦被美方识破，不仅信送不出去，夫妻俩轻则永久监禁，重则再也没有活路。为了骗过严密审查，蒋莹铤而走险，他特意找来一张孩子的作业本纸，刻意模仿稚嫩的儿童笔记，通篇只写家常琐事，看似平平，无奇人畜无害。可就在普通的字里行间，他悄悄藏下了最关键的求救信号。我们渴望回国，却被美方无理软禁，恳请祖国相助，字字轻柔，句句千钧。趁着特务松懈的间隙，他强压着心跳，把这张救命纸条悄悄塞进包裹。那几天的蒋英，整夜不敢熟睡，疑点，风吹草动都让他心惊肉跳。他赌上了自己的性命，赌一家人的未来，只为给祖国留住一个钱学森。万幸，苍天不负有心人，这封跨越山海的密信，成功躲过层层审查，辗转半个地球，稳稳送到了北京祖国，收到讯息，立刻全力开展外交斡旋。最终，我国以释放十一名美国飞行员战俘为代价，换回了钱学森一家的归国资格。当拿到回国签证的那一刻，隐忍了五年的蒋英，终于抱着钱学森失声痛哭，五年屈辱五年煎熬五年坚守，他们终于可以回家了，可危险从来没有真正消散。登上归国轮船的那一刻，特务依旧暗中尾随，杀鸡暗藏整趟行城蒋英，全程神经紧绷，无论散步、吃饭。休息，他永远下意识挡在钱学森身前。有人问他，你不怕死吗？蒋莹的回答震撼人心。国家可以少一个音乐家，但绝对不能少一个钱学森。我能为他做的就是替他挡子弹。这不是情话，是一个中国人最深的家国大义。当轮船驶入中国领海，看见五星红旗迎风飘扬的那一刻，夫妻俩红了双眼，阔别多年历尽磨难，他们终于踏上了故土。彼时的钱学森行李箱空空如也。数十年心血的论文手稿研究资料全被美国赶到，扣押掠夺，但他毫无遗憾，底气十足。嗯，他们拿走了我的手稿，却拿不走我的大脑更拿不走我让同胞挺直腰杆体面生活的初心。归国之后，钱学森不负众望，白手起家，搭建起新中国第一支火箭导弹研究团队，撑起了中国航天的半壁江山。而本该站上世界顶级舞台，光芒万丈的蒋英，彻底收敛了所有锋芒。他褪去光环，引入幕后，走进中央音乐学院，教书育人。别人问他是否后悔放弃巅峰事业，他只是淡然一笑，钱学森为国铸剑，我便为他守家育人家。国两全此生无憾。世人皆知，钱学森伟大，却鲜有。人知是蒋英以温柔之躯，扛住风雨，以一己之勇托举起中国航天的未来。这样的女性值得我们永远铭记，永远致敬。你们觉得若无讲阴，何来两弹一星？评论区留下一句致敬。巾帼英雄蒋英，下期带你解锁更多历史名人背后的故事。",
  "segments": [
    {
      "segment_id": "v_8802249238f121f5_s00001",
      "start_ms": 130,
      "end_ms": 1230,
      "text": "蒋英赌命，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00002",
      "start_ms": 1390,
      "end_ms": 3870,
      "text": "传信唤回中国航天，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00003",
      "start_ms": 3890,
      "end_ms": 6510,
      "text": "未来举国皆知。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00004",
      "start_ms": 6830,
      "end_ms": 9310,
      "text": "钱学森奠基中国航天，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00005",
      "start_ms": 9950,
      "end_ms": 12190,
      "text": "却极少有人知晓，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00006",
      "start_ms": 13390,
      "end_ms": 15670,
      "text": "拯救这位科学巨匠，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00007",
      "start_ms": 16010,
      "end_ms": 18410,
      "text": "成全我国航天事业的，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00008",
      "start_ms": 18970,
      "end_ms": 22010,
      "text": "是他身后看似温柔的蒋英，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00009",
      "start_ms": 22970,
      "end_ms": 24750,
      "text": "这段尘封的往事，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00010",
      "start_ms": 25250,
      "end_ms": 26970,
      "text": "没有激昂的赞歌，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00011",
      "start_ms": 27730,
      "end_ms": 31780,
      "text": "只有一场精心动炼动魄的生死营救，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00012",
      "start_ms": 32300,
      "end_ms": 34540,
      "text": "读懂他的无畏与坚守，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00013",
      "start_ms": 35040,
      "end_ms": 40520,
      "text": "才算真正读懂何谓大国风骨女性担当。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00014",
      "start_ms": 41020,
      "end_ms": 42140,
      "text": "整整五年，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00015",
      "start_ms": 42740,
      "end_ms": 47220,
      "text": "一家人深陷一国软禁的绝境，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00016",
      "start_ms": 47720,
      "end_ms": 48480,
      "text": "想回国，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00017",
      "start_ms": 48720,
      "end_ms": 50160,
      "text": "想为祖国做事，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00018",
      "start_ms": 50760,
      "end_ms": 54040,
      "text": "却连踏出家门一步的权利都没有。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00019",
      "start_ms": 55080,
      "end_ms": 56920,
      "text": "美方层层设防，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00020",
      "start_ms": 57520,
      "end_ms": 58660,
      "text": "严密监控，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00021",
      "start_ms": 59260,
      "end_ms": 63735,
      "text": "彻底锁住了钱学森的人身自由与科研之路。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00022",
      "start_ms": 64460,
      "end_ms": 68365,
      "text": "这位享誉全球的顶尖航天科学家，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00023",
      "start_ms": 69000,
      "end_ms": 71000,
      "text": "昔日意气风发，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00024",
      "start_ms": 71460,
      "end_ms": 72865,
      "text": "深耕科研，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00025",
      "start_ms": 73710,
      "end_ms": 76155,
      "text": "彼时却万般无奈，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00026",
      "start_ms": 76650,
      "end_ms": 82170,
      "text": "只能日日凝望祖国版图满心结是归乡，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00027",
      "start_ms": 82270,
      "end_ms": 85585,
      "text": "执念却寸步难行。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00028",
      "start_ms": 86360,
      "end_ms": 87465,
      "text": "电话被监听，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00029",
      "start_ms": 87940,
      "end_ms": 88440,
      "text": "出门，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00030",
      "start_ms": 88720,
      "end_ms": 90820,
      "text": "有人跟踪信件，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00031",
      "start_ms": 90900,
      "end_ms": 92105,
      "text": "全部拆开检查，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00032",
      "start_ms": 92910,
      "end_ms": 95520,
      "text": "特务二十四小时盯着他们，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00033",
      "start_ms": 95520,
      "end_ms": 97075,
      "text": "一家人滴水不漏。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00034",
      "start_ms": 97840,
      "end_ms": 102955,
      "text": "所有人都觉得钱学森这辈子可能再也回不来了，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00035",
      "start_ms": 103730,
      "end_ms": 107185,
      "text": "但只有讲英从来没有放弃。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00036",
      "start_ms": 108220,
      "end_ms": 111475,
      "text": "她看着丈夫日渐憔悴，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00037",
      "start_ms": 112010,
      "end_ms": 113925,
      "text": "报国无门的模样，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00038",
      "start_ms": 114550,
      "end_ms": 116295,
      "text": "心里比谁都清楚，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00039",
      "start_ms": 116860,
      "end_ms": 117775,
      "text": "耗下去，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00040",
      "start_ms": 118340,
      "end_ms": 121665,
      "text": "困住的不只是一个钱学森，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00041",
      "start_ms": 122240,
      "end_ms": 125160,
      "text": "更是中国未来几十年的航天。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00042",
      "start_ms": 125300,
      "end_ms": 127615,
      "text": "希望绝境之中，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00043",
      "start_ms": 128070,
      "end_ms": 130095,
      "text": "他想出了一个玩命的办法。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00044",
      "start_ms": 131220,
      "end_ms": 133905,
      "text": "蒋英有个妹妹定居比利时。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00045",
      "start_ms": 134530,
      "end_ms": 140940,
      "text": "他决定把求救信息藏进继王比利时的家书里，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00046",
      "start_ms": 140960,
      "end_ms": 141940,
      "text": "经由海外，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00047",
      "start_ms": 142040,
      "end_ms": 144585,
      "text": "辗转送回祖国。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00048",
      "start_ms": 145470,
      "end_ms": 149205,
      "text": "但这一步步步是死局，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00049",
      "start_ms": 150250,
      "end_ms": 152055,
      "text": "一旦被美方识破，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00050",
      "start_ms": 152500,
      "end_ms": 154165,
      "text": "不仅信送不出去，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00051",
      "start_ms": 154590,
      "end_ms": 157915,
      "text": "夫妻俩轻则永久监禁，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00052",
      "start_ms": 158810,
      "end_ms": 161195,
      "text": "重则再也没有活路。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00053",
      "start_ms": 161820,
      "end_ms": 163700,
      "text": "为了骗过严密审查，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00054",
      "start_ms": 164160,
      "end_ms": 165895,
      "text": "蒋莹铤而走险，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00055",
      "start_ms": 166450,
      "end_ms": 170055,
      "text": "他特意找来一张孩子的作业本纸，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00056",
      "start_ms": 170750,
      "end_ms": 174345,
      "text": "刻意模仿稚嫩的儿童笔记，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00057",
      "start_ms": 174950,
      "end_ms": 177805,
      "text": "通篇只写家常琐事，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00058",
      "start_ms": 178690,
      "end_ms": 179910,
      "text": "看似平平，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00059",
      "start_ms": 179990,
      "end_ms": 182575,
      "text": "无奇人畜无害。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00060",
      "start_ms": 183180,
      "end_ms": 185755,
      "text": "可就在普通的字里行间，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00061",
      "start_ms": 186200,
      "end_ms": 190830,
      "text": "他悄悄藏下了最关键的求救信号。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00062",
      "start_ms": 190910,
      "end_ms": 192425,
      "text": "我们渴望回国，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00063",
      "start_ms": 192990,
      "end_ms": 195145,
      "text": "却被美方无理软禁，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00064",
      "start_ms": 195590,
      "end_ms": 197405,
      "text": "恳请祖国相助，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00065",
      "start_ms": 197970,
      "end_ms": 199145,
      "text": "字字轻柔，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00066",
      "start_ms": 199540,
      "end_ms": 200635,
      "text": "句句千钧。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00067",
      "start_ms": 201580,
      "end_ms": 204025,
      "text": "趁着特务松懈的间隙，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00068",
      "start_ms": 204510,
      "end_ms": 205985,
      "text": "他强压着心跳，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00069",
      "start_ms": 206720,
      "end_ms": 210315,
      "text": "把这张救命纸条悄悄塞进包裹。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00070",
      "start_ms": 211280,
      "end_ms": 212635,
      "text": "那几天的蒋英，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00071",
      "start_ms": 213050,
      "end_ms": 214695,
      "text": "整夜不敢熟睡，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00072",
      "start_ms": 215310,
      "end_ms": 215870,
      "text": "疑点，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00073",
      "start_ms": 216030,
      "end_ms": 219805,
      "text": "风吹草动都让他心惊肉跳。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00074",
      "start_ms": 220360,
      "end_ms": 222355,
      "text": "他赌上了自己的性命，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00075",
      "start_ms": 223090,
      "end_ms": 224710,
      "text": "赌一家人的未来，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00076",
      "start_ms": 225210,
      "end_ms": 228535,
      "text": "只为给祖国留住一个钱学森。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00077",
      "start_ms": 229240,
      "end_ms": 230085,
      "text": "万幸，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00078",
      "start_ms": 230690,
      "end_ms": 232785,
      "text": "苍天不负有心人，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00079",
      "start_ms": 233760,
      "end_ms": 235875,
      "text": "这封跨越山海的密信，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00080",
      "start_ms": 236430,
      "end_ms": 238730,
      "text": "成功躲过层层审查，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00081",
      "start_ms": 238950,
      "end_ms": 240655,
      "text": "辗转半个地球，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00082",
      "start_ms": 241170,
      "end_ms": 244510,
      "text": "稳稳送到了北京祖国，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00083",
      "start_ms": 244510,
      "end_ms": 245595,
      "text": "收到讯息，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00084",
      "start_ms": 246020,
      "end_ms": 248655,
      "text": "立刻全力开展外交斡旋。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00085",
      "start_ms": 249660,
      "end_ms": 250175,
      "text": "最终，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00086",
      "start_ms": 250430,
      "end_ms": 254715,
      "text": "我国以释放十一名美国飞行员战俘为代价，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00087",
      "start_ms": 255370,
      "end_ms": 258435,
      "text": "换回了钱学森一家的归国资格。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00088",
      "start_ms": 259620,
      "end_ms": 262405,
      "text": "当拿到回国签证的那一刻，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00089",
      "start_ms": 262910,
      "end_ms": 265355,
      "text": "隐忍了五年的蒋英，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00090",
      "start_ms": 265890,
      "end_ms": 269265,
      "text": "终于抱着钱学森失声痛哭，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00091",
      "start_ms": 270040,
      "end_ms": 274755,
      "text": "五年屈辱五年煎熬五年坚守，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00092",
      "start_ms": 275080,
      "end_ms": 276875,
      "text": "他们终于可以回家了，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00093",
      "start_ms": 277860,
      "end_ms": 281155,
      "text": "可危险从来没有真正消散。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00094",
      "start_ms": 281430,
      "end_ms": 283965,
      "text": "登上归国轮船的那一刻，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00095",
      "start_ms": 284490,
      "end_ms": 287075,
      "text": "特务依旧暗中尾随，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00096",
      "start_ms": 287540,
      "end_ms": 291470,
      "text": "杀鸡暗藏整趟行城蒋英，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00097",
      "start_ms": 291510,
      "end_ms": 293295,
      "text": "全程神经紧绷，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00098",
      "start_ms": 293900,
      "end_ms": 295895,
      "text": "无论散步、吃饭。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00099",
      "start_ms": 296430,
      "end_ms": 296990,
      "text": "休息，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00100",
      "start_ms": 297610,
      "end_ms": 300570,
      "text": "他永远下意识挡在钱学森身前。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00101",
      "start_ms": 301410,
      "end_ms": 302310,
      "text": "有人问他，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00102",
      "start_ms": 302750,
      "end_ms": 303910,
      "text": "你不怕死吗？"
    },
    {
      "segment_id": "v_8802249238f121f5_s00103",
      "start_ms": 304930,
      "end_ms": 308110,
      "text": "蒋莹的回答震撼人心。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00104",
      "start_ms": 309190,
      "end_ms": 311470,
      "text": "国家可以少一个音乐家，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00105",
      "start_ms": 311750,
      "end_ms": 314150,
      "text": "但绝对不能少一个钱学森。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00106",
      "start_ms": 315230,
      "end_ms": 318330,
      "text": "我能为他做的就是替他挡子弹。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00107",
      "start_ms": 319050,
      "end_ms": 320130,
      "text": "这不是情话，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00108",
      "start_ms": 320670,
      "end_ms": 325375,
      "text": "是一个中国人最深的家国大义。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00109",
      "start_ms": 326180,
      "end_ms": 329140,
      "text": "当轮船驶入中国领海，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00110",
      "start_ms": 329280,
      "end_ms": 333380,
      "text": "看见五星红旗迎风飘扬的那一刻，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00111",
      "start_ms": 334180,
      "end_ms": 336500,
      "text": "夫妻俩红了双眼，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00112",
      "start_ms": 337760,
      "end_ms": 340640,
      "text": "阔别多年历尽磨难，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00113",
      "start_ms": 341300,
      "end_ms": 343920,
      "text": "他们终于踏上了故土。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00114",
      "start_ms": 344580,
      "end_ms": 348660,
      "text": "彼时的钱学森行李箱空空如也。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00115",
      "start_ms": 349220,
      "end_ms": 356110,
      "text": "数十年心血的论文手稿研究资料全被美国赶到，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00116",
      "start_ms": 356190,
      "end_ms": 357435,
      "text": "扣押掠夺，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00117",
      "start_ms": 358050,
      "end_ms": 359485,
      "text": "但他毫无遗憾，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00118",
      "start_ms": 360400,
      "end_ms": 361775,
      "text": "底气十足。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00119",
      "start_ms": 362070,
      "end_ms": 362195,
      "text": "嗯，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00120",
      "start_ms": 362770,
      "end_ms": 364785,
      "text": "他们拿走了我的手稿，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00121",
      "start_ms": 365150,
      "end_ms": 373835,
      "text": "却拿不走我的大脑更拿不走我让同胞挺直腰杆体面生活的初心。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00122",
      "start_ms": 374980,
      "end_ms": 375995,
      "text": "归国之后，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00123",
      "start_ms": 376470,
      "end_ms": 378730,
      "text": "钱学森不负众望，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00124",
      "start_ms": 378830,
      "end_ms": 379910,
      "text": "白手起家，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00125",
      "start_ms": 380330,
      "end_ms": 385505,
      "text": "搭建起新中国第一支火箭导弹研究团队，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00126",
      "start_ms": 386060,
      "end_ms": 389155,
      "text": "撑起了中国航天的半壁江山。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00127",
      "start_ms": 389990,
      "end_ms": 393975,
      "text": "而本该站上世界顶级舞台，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00128",
      "start_ms": 394460,
      "end_ms": 396735,
      "text": "光芒万丈的蒋英，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00129",
      "start_ms": 397410,
      "end_ms": 399685,
      "text": "彻底收敛了所有锋芒。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00130",
      "start_ms": 400430,
      "end_ms": 401935,
      "text": "他褪去光环，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00131",
      "start_ms": 402400,
      "end_ms": 403505,
      "text": "引入幕后，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00132",
      "start_ms": 404280,
      "end_ms": 406000,
      "text": "走进中央音乐学院，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00133",
      "start_ms": 406040,
      "end_ms": 407025,
      "text": "教书育人。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00134",
      "start_ms": 407730,
      "end_ms": 411265,
      "text": "别人问他是否后悔放弃巅峰事业，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00135",
      "start_ms": 411720,
      "end_ms": 413715,
      "text": "他只是淡然一笑，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00136",
      "start_ms": 414260,
      "end_ms": 416045,
      "text": "钱学森为国铸剑，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00137",
      "start_ms": 416760,
      "end_ms": 420200,
      "text": "我便为他守家育人家。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00138",
      "start_ms": 420280,
      "end_ms": 422905,
      "text": "国两全此生无憾。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00139",
      "start_ms": 423260,
      "end_ms": 424340,
      "text": "世人皆知，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00140",
      "start_ms": 424800,
      "end_ms": 426185,
      "text": "钱学森伟大，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00141",
      "start_ms": 426680,
      "end_ms": 427720,
      "text": "却鲜有。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00142",
      "start_ms": 427780,
      "end_ms": 431710,
      "text": "人知是蒋英以温柔之躯，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00143",
      "start_ms": 431910,
      "end_ms": 433335,
      "text": "扛住风雨，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00144",
      "start_ms": 433750,
      "end_ms": 438715,
      "text": "以一己之勇托举起中国航天的未来。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00145",
      "start_ms": 440530,
      "end_ms": 444375,
      "text": "这样的女性值得我们永远铭记，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00146",
      "start_ms": 445140,
      "end_ms": 446175,
      "text": "永远致敬。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00147",
      "start_ms": 446650,
      "end_ms": 448925,
      "text": "你们觉得若无讲阴，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00148",
      "start_ms": 449390,
      "end_ms": 451515,
      "text": "何来两弹一星？"
    },
    {
      "segment_id": "v_8802249238f121f5_s00149",
      "start_ms": 452630,
      "end_ms": 455135,
      "text": "评论区留下一句致敬。"
    },
    {
      "segment_id": "v_8802249238f121f5_s00150",
      "start_ms": 455570,
      "end_ms": 457600,
      "text": "巾帼英雄蒋英，"
    },
    {
      "segment_id": "v_8802249238f121f5_s00151",
      "start_ms": 458650,
      "end_ms": 463075,
      "text": "下期带你解锁更多历史名人背后的故事。"
    }
  ],
