  "duration_s": 50.344828,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "很干净的四句话，受用终生，第一句人再难也不要说话，不算数，人再穷，也千万不要借钱，不还钱没了，咱还可以再正，但是信任没机，你将寸步难行。第二句人可以精，但是千万不能没有底线。人前不耍心机人后，不玩阴谋。第三句人只有行得正，才能够站得稳，人品重于山，良心比金，贵在穷，也别骗朋友，再富也别忘恩人。第四句，人品第一，不昧良心，人品永远大于能力，良心永远贵于黄金。人品好，一切才会都好。良心在福气长，你认同吗？",
  "segments": [
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00001",
      "start_ms": 210,
      "end_ms": 1410,
      "text": "很干净的四句话，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00002",
      "start_ms": 1670,
      "end_ms": 2490,
      "text": "受用终生，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00003",
      "start_ms": 2790,
      "end_ms": 5690,
      "text": "第一句人再难也不要说话，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00004",
      "start_ms": 5690,
      "end_ms": 6330,
      "text": "不算数，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00005",
      "start_ms": 6770,
      "end_ms": 7470,
      "text": "人再穷，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00006",
      "start_ms": 7810,
      "end_ms": 8930,
      "text": "也千万不要借钱，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00007",
      "start_ms": 8930,
      "end_ms": 10510,
      "text": "不还钱没了，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00008",
      "start_ms": 10510,
      "end_ms": 11410,
      "text": "咱还可以再正，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00009",
      "start_ms": 11710,
      "end_ms": 12910,
      "text": "但是信任没机，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00010",
      "start_ms": 13090,
      "end_ms": 14350,
      "text": "你将寸步难行。"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00011",
      "start_ms": 14750,
      "end_ms": 16370,
      "text": "第二句人可以精，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00012",
      "start_ms": 16670,
      "end_ms": 18290,
      "text": "但是千万不能没有底线。"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00013",
      "start_ms": 18810,
      "end_ms": 20690,
      "text": "人前不耍心机人后，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00014",
      "start_ms": 21030,
      "end_ms": 21930,
      "text": "不玩阴谋。"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00015",
      "start_ms": 22370,
      "end_ms": 24390,
      "text": "第三句人只有行得正，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00016",
      "start_ms": 24690,
      "end_ms": 25770,
      "text": "才能够站得稳，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00017",
      "start_ms": 26150,
      "end_ms": 27270,
      "text": "人品重于山，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00018",
      "start_ms": 27670,
      "end_ms": 28950,
      "text": "良心比金，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00019",
      "start_ms": 28950,
      "end_ms": 30300,
      "text": "贵在穷，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00020",
      "start_ms": 30300,
      "end_ms": 31300,
      "text": "也别骗朋友，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00021",
      "start_ms": 31480,
      "end_ms": 33340,
      "text": "再富也别忘恩人。"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00022",
      "start_ms": 33740,
      "end_ms": 34420,
      "text": "第四句，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00023",
      "start_ms": 34760,
      "end_ms": 35660,
      "text": "人品第一，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00024",
      "start_ms": 35860,
      "end_ms": 36740,
      "text": "不昧良心，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00025",
      "start_ms": 37220,
      "end_ms": 38700,
      "text": "人品永远大于能力，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00026",
      "start_ms": 39000,
      "end_ms": 41220,
      "text": "良心永远贵于黄金。"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00027",
      "start_ms": 41720,
      "end_ms": 42360,
      "text": "人品好，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00028",
      "start_ms": 42600,
      "end_ms": 43780,
      "text": "一切才会都好。"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00029",
      "start_ms": 44220,
      "end_ms": 46600,
      "text": "良心在福气长，"
    },
    {
      "segment_id": "v_5f546ec8b5aa8d38_s00030",
      "start_ms": 47160,
      "end_ms": 48185,
      "text": "你认同吗？"
    }
  ],
