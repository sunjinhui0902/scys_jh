{
  "schema_version": "text-light-input-1.0",
  "unit_id": "v_2a38fc92b95504f3_u01",
  "video_id": "v_2a38fc92b95504f3",
  "account": "开卷读书",
  "source_title": "敬一丹老师，一路走好。时代少了一位温柔有力量的记录者，感谢您曾温暖过亿万观众，陪伴几代人走过春夏秋冬。#情感#人生感悟#智慧人生#敬一丹#一路走好",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
  "status": "AI_PENDING",
  "unit_index": 1,
  "unit_count": 1,
  "all_video_unit_ids": [
    "v_2a38fc92b95504f3_u01"
  ],
  "duration_s": 200.177007,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "靳一丹走了，享年七十一岁。今早醒来，突然看到这个新闻，我心里咯噔一下，以为是假消息。明明就在三月还参加了他的读者见面会。他的温柔从容的模样，仿佛就在我的眼前。我最记得他的一句话，感谢这个世界，让我走过人这一生啊，真的太短暂了，说走就走。他的离开仿佛也带走了六零七零八零后几代人的荧幕角记忆，熟悉的时代慢慢退场，我们也开始慢慢变老了。在这里啊，我想和屏幕前的你分享几点人生建议。第一，生命无常，人真的会突然离开。没错，就是那种随时随地都有可能离开的那种，然后彻底的消失在人世界你在人间，所有的一切都不再属于你，包括你的父母和你的孩子。所以啊人活着不必患得患失，也没必要小心翼翼，更不用害怕失去谁。人生本过客，何必谦谦劫。人活着就应该敞亮点或打点珍惜每一天，把每一天都当做最后一天。第二，千万不要去相信，年轻时努力工作，老了再去享受这种鬼话。人老了身体都废了，眼睛都花了，耳朵都聋了，走路都走不动了，你还有什么时间去享受？所以啊千万不要总说着，等我有钱了，等我有时间了。现在当下就是你余生最好最年轻的一天，千万不要等着等着，等到最后什么都没了。第三，人生最忌讳的一个字就是过自过劳者死。过会者天收。黄帝内经中说，劳逸结合，身心健过度，劳累百病生，过度操劳伤身，过度操心伤神。人生有耻，做人有度，福气自来，人生啊。他本来就没有意义，你生来就是来体验的，而并非演绎完美的。你生下来所有的体验，就是你生命全部的意义。第四，不要为往事过不去，因为他已经过气，也不要为现实过不去，因为你还要过下去。既然明天和意外，我们都不知道哪一个会先降临，那么不妨开开心心，活在当下，得之坦然，失之淡然，顺其自然。人生最好的放生，就是放过自己，最好的活法就是活在当下享受。现在保持快乐的秘诀就是无所谓，没必要不至于。第五啊，幸福它从来都不是有，而是无。人们常常把幸福定义为有房有车，有钱，有权，有地位等等。然而真正的幸福其实在于无无忧无虑、无病无灾。很多人啊活了一辈子都不明白，其实有是为了给别人看的，而无才是自己。真正想要的最后，让我们一起祝金一班老师一路走好。感谢他曾经温暖过亿万观众，也陪伴了一代又一代人，走过一个又一个春夏秋冬，也愿屏幕前的你我从此不负时光，珍惜善待每一天。你好，观众朋友，欢迎您视看你嗯嗯嗯嗯。",
  "segments": [
    {
      "segment_id": "v_2a38fc92b95504f3_s00001",
      "start_ms": 110,
      "end_ms": 1070,
      "text": "靳一丹走了，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00002",
      "start_ms": 1370,
      "end_ms": 2490,
      "text": "享年七十一岁。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00003",
      "start_ms": 3030,
      "end_ms": 3810,
      "text": "今早醒来，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00004",
      "start_ms": 4030,
      "end_ms": 5550,
      "text": "突然看到这个新闻，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00005",
      "start_ms": 5770,
      "end_ms": 7110,
      "text": "我心里咯噔一下，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00006",
      "start_ms": 7390,
      "end_ms": 8470,
      "text": "以为是假消息。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00007",
      "start_ms": 8850,
      "end_ms": 11710,
      "text": "明明就在三月还参加了他的读者见面会。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00008",
      "start_ms": 12010,
      "end_ms": 13870,
      "text": "他的温柔从容的模样，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00009",
      "start_ms": 14330,
      "end_ms": 15650,
      "text": "仿佛就在我的眼前。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00010",
      "start_ms": 15970,
      "end_ms": 17450,
      "text": "我最记得他的一句话，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00011",
      "start_ms": 17790,
      "end_ms": 19070,
      "text": "感谢这个世界，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00012",
      "start_ms": 19550,
      "end_ms": 22070,
      "text": "让我走过人这一生啊，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00013",
      "start_ms": 22330,
      "end_ms": 23610,
      "text": "真的太短暂了，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00014",
      "start_ms": 23730,
      "end_ms": 24630,
      "text": "说走就走。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00015",
      "start_ms": 25010,
      "end_ms": 30480,
      "text": "他的离开仿佛也带走了六零七零八零后几代人的荧幕角记忆，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00016",
      "start_ms": 30780,
      "end_ms": 32800,
      "text": "熟悉的时代慢慢退场，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00017",
      "start_ms": 33080,
      "end_ms": 35560,
      "text": "我们也开始慢慢变老了。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00018",
      "start_ms": 35760,
      "end_ms": 36460,
      "text": "在这里啊，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00019",
      "start_ms": 36480,
      "end_ms": 39680,
      "text": "我想和屏幕前的你分享几点人生建议。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00020",
      "start_ms": 39840,
      "end_ms": 40280,
      "text": "第一，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00021",
      "start_ms": 40620,
      "end_ms": 41480,
      "text": "生命无常，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00022",
      "start_ms": 41820,
      "end_ms": 43280,
      "text": "人真的会突然离开。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00023",
      "start_ms": 43480,
      "end_ms": 43880,
      "text": "没错，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00024",
      "start_ms": 44200,
      "end_ms": 47280,
      "text": "就是那种随时随地都有可能离开的那种，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00025",
      "start_ms": 47580,
      "end_ms": 50880,
      "text": "然后彻底的消失在人世界你在人间，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00026",
      "start_ms": 50880,
      "end_ms": 53040,
      "text": "所有的一切都不再属于你，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00027",
      "start_ms": 53200,
      "end_ms": 54940,
      "text": "包括你的父母和你的孩子。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00028",
      "start_ms": 55300,
      "end_ms": 57760,
      "text": "所以啊人活着不必患得患失，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00029",
      "start_ms": 58000,
      "end_ms": 59320,
      "text": "也没必要小心翼翼，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00030",
      "start_ms": 59520,
      "end_ms": 61395,
      "text": "更不用害怕失去谁。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00031",
      "start_ms": 61720,
      "end_ms": 62700,
      "text": "人生本过客，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00032",
      "start_ms": 63080,
      "end_ms": 64540,
      "text": "何必谦谦劫。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00033",
      "start_ms": 64800,
      "end_ms": 68610,
      "text": "人活着就应该敞亮点或打点珍惜每一天，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00034",
      "start_ms": 68750,
      "end_ms": 70965,
      "text": "把每一天都当做最后一天。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00035",
      "start_ms": 71400,
      "end_ms": 71760,
      "text": "第二，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00036",
      "start_ms": 71800,
      "end_ms": 72840,
      "text": "千万不要去相信，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00037",
      "start_ms": 72920,
      "end_ms": 74080,
      "text": "年轻时努力工作，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00038",
      "start_ms": 74300,
      "end_ms": 76160,
      "text": "老了再去享受这种鬼话。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00039",
      "start_ms": 76500,
      "end_ms": 78300,
      "text": "人老了身体都废了，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00040",
      "start_ms": 78420,
      "end_ms": 79500,
      "text": "眼睛都花了，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00041",
      "start_ms": 79520,
      "end_ms": 80515,
      "text": "耳朵都聋了，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00042",
      "start_ms": 80830,
      "end_ms": 82130,
      "text": "走路都走不动了，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00043",
      "start_ms": 82210,
      "end_ms": 83730,
      "text": "你还有什么时间去享受？"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00044",
      "start_ms": 84130,
      "end_ms": 85810,
      "text": "所以啊千万不要总说着，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00045",
      "start_ms": 85890,
      "end_ms": 86810,
      "text": "等我有钱了，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00046",
      "start_ms": 86890,
      "end_ms": 88275,
      "text": "等我有时间了。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00047",
      "start_ms": 88630,
      "end_ms": 93010,
      "text": "现在当下就是你余生最好最年轻的一天，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00048",
      "start_ms": 93330,
      "end_ms": 94490,
      "text": "千万不要等着等着，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00049",
      "start_ms": 94750,
      "end_ms": 96355,
      "text": "等到最后什么都没了。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00050",
      "start_ms": 96770,
      "end_ms": 97190,
      "text": "第三，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00051",
      "start_ms": 97330,
      "end_ms": 101305,
      "text": "人生最忌讳的一个字就是过自过劳者死。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00052",
      "start_ms": 101730,
      "end_ms": 102830,
      "text": "过会者天收。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00053",
      "start_ms": 103030,
      "end_ms": 104050,
      "text": "黄帝内经中说，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00054",
      "start_ms": 104250,
      "end_ms": 105110,
      "text": "劳逸结合，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00055",
      "start_ms": 105470,
      "end_ms": 107010,
      "text": "身心健过度，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00056",
      "start_ms": 107010,
      "end_ms": 108755,
      "text": "劳累百病生，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00057",
      "start_ms": 109120,
      "end_ms": 110280,
      "text": "过度操劳伤身，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00058",
      "start_ms": 110440,
      "end_ms": 112060,
      "text": "过度操心伤神。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00059",
      "start_ms": 112360,
      "end_ms": 113200,
      "text": "人生有耻，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00060",
      "start_ms": 113460,
      "end_ms": 114260,
      "text": "做人有度，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00061",
      "start_ms": 114620,
      "end_ms": 115580,
      "text": "福气自来，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00062",
      "start_ms": 115880,
      "end_ms": 116440,
      "text": "人生啊。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00063",
      "start_ms": 116440,
      "end_ms": 117805,
      "text": "他本来就没有意义，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00064",
      "start_ms": 118030,
      "end_ms": 119550,
      "text": "你生来就是来体验的，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00065",
      "start_ms": 119550,
      "end_ms": 121155,
      "text": "而并非演绎完美的。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00066",
      "start_ms": 121480,
      "end_ms": 122900,
      "text": "你生下来所有的体验，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00067",
      "start_ms": 123060,
      "end_ms": 125195,
      "text": "就是你生命全部的意义。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00068",
      "start_ms": 125510,
      "end_ms": 125910,
      "text": "第四，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00069",
      "start_ms": 126030,
      "end_ms": 127375,
      "text": "不要为往事过不去，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00070",
      "start_ms": 127660,
      "end_ms": 128885,
      "text": "因为他已经过气，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00071",
      "start_ms": 129260,
      "end_ms": 130755,
      "text": "也不要为现实过不去，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00072",
      "start_ms": 130990,
      "end_ms": 132970,
      "text": "因为你还要过下去。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00073",
      "start_ms": 133350,
      "end_ms": 134470,
      "text": "既然明天和意外，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00074",
      "start_ms": 134490,
      "end_ms": 136410,
      "text": "我们都不知道哪一个会先降临，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00075",
      "start_ms": 136630,
      "end_ms": 138390,
      "text": "那么不妨开开心心，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00076",
      "start_ms": 138570,
      "end_ms": 139450,
      "text": "活在当下，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00077",
      "start_ms": 139690,
      "end_ms": 140530,
      "text": "得之坦然，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00078",
      "start_ms": 140850,
      "end_ms": 141815,
      "text": "失之淡然，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00079",
      "start_ms": 142180,
      "end_ms": 143080,
      "text": "顺其自然。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00080",
      "start_ms": 143380,
      "end_ms": 144580,
      "text": "人生最好的放生，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00081",
      "start_ms": 144760,
      "end_ms": 145960,
      "text": "就是放过自己，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00082",
      "start_ms": 146180,
      "end_ms": 149300,
      "text": "最好的活法就是活在当下享受。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00083",
      "start_ms": 149340,
      "end_ms": 152400,
      "text": "现在保持快乐的秘诀就是无所谓，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00084",
      "start_ms": 152560,
      "end_ms": 154000,
      "text": "没必要不至于。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00085",
      "start_ms": 154220,
      "end_ms": 154840,
      "text": "第五啊，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00086",
      "start_ms": 154880,
      "end_ms": 156725,
      "text": "幸福它从来都不是有，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00087",
      "start_ms": 157070,
      "end_ms": 157690,
      "text": "而是无。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00088",
      "start_ms": 157910,
      "end_ms": 160990,
      "text": "人们常常把幸福定义为有房有车，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00089",
      "start_ms": 161130,
      "end_ms": 161705,
      "text": "有钱，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00090",
      "start_ms": 162030,
      "end_ms": 162430,
      "text": "有权，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00091",
      "start_ms": 162670,
      "end_ms": 163715,
      "text": "有地位等等。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00092",
      "start_ms": 163940,
      "end_ms": 169190,
      "text": "然而真正的幸福其实在于无无忧无虑、无病无灾。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00093",
      "start_ms": 169530,
      "end_ms": 171490,
      "text": "很多人啊活了一辈子都不明白，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00094",
      "start_ms": 171650,
      "end_ms": 173930,
      "text": "其实有是为了给别人看的，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00095",
      "start_ms": 174010,
      "end_ms": 175650,
      "text": "而无才是自己。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00096",
      "start_ms": 175890,
      "end_ms": 178100,
      "text": "真正想要的最后，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00097",
      "start_ms": 178280,
      "end_ms": 181610,
      "text": "让我们一起祝金一班老师一路走好。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00098",
      "start_ms": 182150,
      "end_ms": 185250,
      "text": "感谢他曾经温暖过亿万观众，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00099",
      "start_ms": 185510,
      "end_ms": 187384,
      "text": "也陪伴了一代又一代人，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00100",
      "start_ms": 187760,
      "end_ms": 190045,
      "text": "走过一个又一个春夏秋冬，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00101",
      "start_ms": 190560,
      "end_ms": 194200,
      "text": "也愿屏幕前的你我从此不负时光，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00102",
      "start_ms": 194600,
      "end_ms": 196880,
      "text": "珍惜善待每一天。"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00103",
      "start_ms": 197140,
      "end_ms": 197360,
      "text": "你好，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00104",
      "start_ms": 197360,
      "end_ms": 197820,
      "text": "观众朋友，"
    },
    {
      "segment_id": "v_2a38fc92b95504f3_s00105",
      "start_ms": 197820,
      "end_ms": 199690,
      "text": "欢迎您视看你嗯嗯嗯嗯。"
    }
  ],
