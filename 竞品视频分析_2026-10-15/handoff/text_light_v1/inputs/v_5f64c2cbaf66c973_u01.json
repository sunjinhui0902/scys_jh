  ],
  "duration_s": 529.901995,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "百年杨绛历经风雨，活成人间最通透的先生。今天，我们聊一位跨越三个时代活足一百零五岁的女子，她是文坛译者，散门，大家也是无数人心中风骨与温柔并存的杨绛先生。世人总爱摘抄他通透清醒的句子，却很少完整读懂那些治愈无数人的人生智慧。全是他百年岁月一步一步熬出来的答案。一九一一年盛夏，杨绛生于北京，书香世家，本名杨继康，父亲杨殷航，是民国知名法学家。思想开明，从不约束女儿的喜好，只告诉他喜欢什么，便去钻研什么。这份自由宽松的成长环境，嗯，早早在他心底种下独立淡然的底色，年少求学，辗转苏州上海。他读书从不死记硬背。政华女中时期，跳级提前毕业十七岁，同时考上东吴大学金陵女大只因当年清华不招收女生，才战时搁置心中学府梦。二十一岁那年，命运安排了一场一眼。定终身的相遇，杨绛借读燕京大学，顺路去往清华古乐堂，初见钱钟书。彼时旁人传话说，二人各有婚约见面。第一句，钱钟书直白开口，我并未订婚。杨绛也坦然回应自己没有男友，简单两句话，拉开了两人长达六十余年相守的序幕，相恋，订婚成婚。一九三五年，夫妻二人远赴牛津留学，钱钟书一身书卷气，却不通生活琐事，打翻墨水，弄坏器物，是尝试反绛，从无半句埋怨，反倒放下学业之余，学着操持三餐。为做出合口味的中餐，为反复摸索，文火炖肉，笨拙却认真。女儿钱科出生后，一家三口在一国相守，平淡琐碎的日常，成了往后半生最珍贵的念想。归国后，战火连绵，上海沦陷时期杨绛，扛起养家重担，提笔创作话剧称心如意，弄真成假，接连登上舞台，杨绛这个笔名自此流传。白天，他执教教书，夜晚伏案写剧本补贴家用。乱世之中，一支笔撑起一家三口安稳。后来前谁书动笔写围城，杨绛主动包揽全部家务刊，写书稿，斟酌字据，甘愿做他身后安静的支撑。围城问世，轰动文坛。可很少有人知道，这部传世之作，藏着杨绛无数默默付出的时光。事业刚有起色，人生磨难接踵而至。五十多岁那年，时代动荡袭来，杨绛被安排打扫公共厕所，还被剃去半边头发当众受辱，旁人都以为他会崩溃落泪。可他回家取剪刀，干脆剃光，剩于长发，坦然。面对周遭眼光下放武器干校的日子，寒冬住在漏风茅屋，双手冻满裂口。他一边干粗活，一边悄悄揣着字典，抓住零碎时间研读文字。彼时，他正在翻译堂吉诃德，为忠于原著。四十七岁的他从零自学西班牙语，耗费数年，一完大半稿件，却在动乱中全部遗世。他没有就此放弃，多年后取回残破手稿。他狭小简陋的办公室里，从头重艺，前后历时近二十年前，本终于在一九七八年面世。这份译文精过准、温润，兼具中西文字美感，至今仍是国内公认最优版本。西班牙国王特意为他颁发十字勋章，称赞他搭建起两国文学沟通的桥梁。熬过漫长苦难安稳，日子却格外短暂。晚年接连两场生离，先送走相伴半生的女儿。钱巩没过一年，相守六十余载的钱钟书也撒手离去，至亲尽数离开，偌大屋子，只剩他一人，旁人都怕。这位八十八岁老人撑不住。他却平静写下一句中书，逃走了，我也想逃走，可我不能逃得留在世间。打扫现场。所谓打扫现场，是整理丈夫七万多页，散乱手稿，校对分类编撰，耗费数年，整理出钱钟书手稿集，是提笔写下我们仨把一家三口温暖细碎的回忆妥帖。收藏是看淡名利，将毕生稿酬、版税全术捐给清华，设立好读书奖学金，资助家境清贫却勤学的学子名利荣华。他从不贪恋晚年独居，简朴小屋沙发旧了，不肯更换茶几，常年摆放两副碗筷，仿佛爱人从未走远。九十多岁时，他写下，走到人生边上，自问自答生死人性与欲望，文字没有华丽迟藻，句句戳破生活本质。我们熟知的那句世界是自己的，与他人毫无关系，不是消极避世，而是他历经悲欢后悟透的清醒。他见过世态凉薄受过无端委屈，却始终守住心底柔软，不随意评判他人，不纠结，过往遗憾。不盲目追逐，外界认可。他曾说，人除了生死，其余不过擦伤，平视自己，才能看清人生本来模样。读书不是为了发财牟利，而是成为有温度、会思考的人。这些流传全网的短句，从来不是空洞鸡汤，是他在扫厕所的清晨干笑寒夜失去至亲的深夜，慢慢沉淀出的人生答案。世零一六年五月，一百零五岁的杨绛安然离世，世人称她为中国最后一位女先生先生。二字无关性别，是世人对学识、风骨格局最高的境称。他一生兼具三重身份，有才情的创作者，打通中西文化的翻译家。温柔坚韧的妻子，与母亲顺境不骄，逆境不屈，痛失所爱，不沉溺悲泣，坐勇盛名，不贪恋浮化。回望杨绛的百年人生，而们终会明白，真正的优雅，从不是精致外表与顺遂人生，而是无论命运给予风雨还是荣光，始终守住内心从容，不愿不怒，不值岁月会带走亲友，消磨年华，但内心沉淀的通透与温柔，会伴随我们走完这一生。就像杨绛走过的路，一半烟火谋生，一伴清欢，修心清醒，释然，便是最好的活法。如果今天的故事也给了你一份前行的力量。别忘了，点赞、收藏、关注我，后续继续带你走进更多有风骨的文人前辈，品读岁月沉淀下来的人生智慧。",
  "segments": [
    {
      "segment_id": "v_5f64c2cbaf66c973_s00001",
      "start_ms": 90,
      "end_ms": 2550,
      "text": "百年杨绛历经风雨，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00002",
      "start_ms": 2790,
      "end_ms": 5110,
      "text": "活成人间最通透的先生。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00003",
      "start_ms": 5970,
      "end_ms": 6430,
      "text": "今天，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00004",
      "start_ms": 6510,
      "end_ms": 11730,
      "text": "我们聊一位跨越三个时代活足一百零五岁的女子，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00005",
      "start_ms": 12410,
      "end_ms": 13650,
      "text": "她是文坛译者，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00006",
      "start_ms": 14050,
      "end_ms": 14450,
      "text": "散门，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00007",
      "start_ms": 14450,
      "end_ms": 22020,
      "text": "大家也是无数人心中风骨与温柔并存的杨绛先生。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00008",
      "start_ms": 22860,
      "end_ms": 26000,
      "text": "世人总爱摘抄他通透清醒的句子，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00009",
      "start_ms": 26780,
      "end_ms": 33030,
      "text": "却很少完整读懂那些治愈无数人的人生智慧。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00010",
      "start_ms": 33470,
      "end_ms": 37870,
      "text": "全是他百年岁月一步一步熬出来的答案。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00011",
      "start_ms": 38470,
      "end_ms": 39970,
      "text": "一九一一年盛夏，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00012",
      "start_ms": 40370,
      "end_ms": 42130,
      "text": "杨绛生于北京，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00013",
      "start_ms": 42190,
      "end_ms": 43090,
      "text": "书香世家，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00014",
      "start_ms": 43130,
      "end_ms": 44650,
      "text": "本名杨继康，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00015",
      "start_ms": 45610,
      "end_ms": 46730,
      "text": "父亲杨殷航，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00016",
      "start_ms": 47030,
      "end_ms": 49190,
      "text": "是民国知名法学家。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00017",
      "start_ms": 49750,
      "end_ms": 50810,
      "text": "思想开明，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00018",
      "start_ms": 51210,
      "end_ms": 53210,
      "text": "从不约束女儿的喜好，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00019",
      "start_ms": 53590,
      "end_ms": 55650,
      "text": "只告诉他喜欢什么，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00020",
      "start_ms": 55730,
      "end_ms": 57090,
      "text": "便去钻研什么。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00021",
      "start_ms": 58170,
      "end_ms": 60445,
      "text": "这份自由宽松的成长环境，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00022",
      "start_ms": 60640,
      "end_ms": 60850,
      "text": "嗯，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00023",
      "start_ms": 61100,
      "end_ms": 64575,
      "text": "早早在他心底种下独立淡然的底色，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00024",
      "start_ms": 65510,
      "end_ms": 66510,
      "text": "年少求学，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00025",
      "start_ms": 66550,
      "end_ms": 68485,
      "text": "辗转苏州上海。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00026",
      "start_ms": 69230,
      "end_ms": 71575,
      "text": "他读书从不死记硬背。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00027",
      "start_ms": 71970,
      "end_ms": 73250,
      "text": "政华女中时期，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00028",
      "start_ms": 73250,
      "end_ms": 75825,
      "text": "跳级提前毕业十七岁，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00029",
      "start_ms": 76110,
      "end_ms": 82495,
      "text": "同时考上东吴大学金陵女大只因当年清华不招收女生，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00030",
      "start_ms": 82910,
      "end_ms": 86030,
      "text": "才战时搁置心中学府梦。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00031",
      "start_ms": 86170,
      "end_ms": 87305,
      "text": "二十一岁那年，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00032",
      "start_ms": 87750,
      "end_ms": 89900,
      "text": "命运安排了一场一眼。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00033",
      "start_ms": 89940,
      "end_ms": 91455,
      "text": "定终身的相遇，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00034",
      "start_ms": 92360,
      "end_ms": 94675,
      "text": "杨绛借读燕京大学，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00035",
      "start_ms": 95070,
      "end_ms": 97545,
      "text": "顺路去往清华古乐堂，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00036",
      "start_ms": 97850,
      "end_ms": 99105,
      "text": "初见钱钟书。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00037",
      "start_ms": 100040,
      "end_ms": 102110,
      "text": "彼时旁人传话说，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00038",
      "start_ms": 102110,
      "end_ms": 103970,
      "text": "二人各有婚约见面。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00039",
      "start_ms": 103970,
      "end_ms": 104465,
      "text": "第一句，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00040",
      "start_ms": 105250,
      "end_ms": 106615,
      "text": "钱钟书直白开口，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00041",
      "start_ms": 107490,
      "end_ms": 108925,
      "text": "我并未订婚。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00042",
      "start_ms": 109530,
      "end_ms": 112815,
      "text": "杨绛也坦然回应自己没有男友，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00043",
      "start_ms": 113080,
      "end_ms": 114060,
      "text": "简单两句话，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00044",
      "start_ms": 114340,
      "end_ms": 117625,
      "text": "拉开了两人长达六十余年相守的序幕，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00045",
      "start_ms": 118030,
      "end_ms": 118545,
      "text": "相恋，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00046",
      "start_ms": 120210,
      "end_ms": 121570,
      "text": "订婚成婚。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00047",
      "start_ms": 122210,
      "end_ms": 123230,
      "text": "一九三五年，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00048",
      "start_ms": 123270,
      "end_ms": 125990,
      "text": "夫妻二人远赴牛津留学，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00049",
      "start_ms": 126250,
      "end_ms": 128090,
      "text": "钱钟书一身书卷气，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00050",
      "start_ms": 128370,
      "end_ms": 130170,
      "text": "却不通生活琐事，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00051",
      "start_ms": 130710,
      "end_ms": 131550,
      "text": "打翻墨水，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00052",
      "start_ms": 132330,
      "end_ms": 133350,
      "text": "弄坏器物，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00053",
      "start_ms": 133350,
      "end_ms": 135330,
      "text": "是尝试反绛，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00054",
      "start_ms": 135350,
      "end_ms": 136810,
      "text": "从无半句埋怨，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00055",
      "start_ms": 137430,
      "end_ms": 139090,
      "text": "反倒放下学业之余，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00056",
      "start_ms": 139270,
      "end_ms": 140710,
      "text": "学着操持三餐。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00057",
      "start_ms": 141310,
      "end_ms": 143210,
      "text": "为做出合口味的中餐，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00058",
      "start_ms": 143570,
      "end_ms": 144770,
      "text": "为反复摸索，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00059",
      "start_ms": 144870,
      "end_ms": 145850,
      "text": "文火炖肉，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00060",
      "start_ms": 146210,
      "end_ms": 147410,
      "text": "笨拙却认真。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00061",
      "start_ms": 148310,
      "end_ms": 149715,
      "text": "女儿钱科出生后，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00062",
      "start_ms": 150020,
      "end_ms": 151860,
      "text": "一家三口在一国相守，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00063",
      "start_ms": 152260,
      "end_ms": 153960,
      "text": "平淡琐碎的日常，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00064",
      "start_ms": 154360,
      "end_ms": 157140,
      "text": "成了往后半生最珍贵的念想。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00065",
      "start_ms": 157700,
      "end_ms": 158380,
      "text": "归国后，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00066",
      "start_ms": 158580,
      "end_ms": 159580,
      "text": "战火连绵，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00067",
      "start_ms": 160140,
      "end_ms": 162340,
      "text": "上海沦陷时期杨绛，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00068",
      "start_ms": 162520,
      "end_ms": 164140,
      "text": "扛起养家重担，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00069",
      "start_ms": 164540,
      "end_ms": 167240,
      "text": "提笔创作话剧称心如意，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00070",
      "start_ms": 167260,
      "end_ms": 168200,
      "text": "弄真成假，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00071",
      "start_ms": 168240,
      "end_ms": 169400,
      "text": "接连登上舞台，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00072",
      "start_ms": 169980,
      "end_ms": 172260,
      "text": "杨绛这个笔名自此流传。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00073",
      "start_ms": 172740,
      "end_ms": 173280,
      "text": "白天，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00074",
      "start_ms": 173300,
      "end_ms": 174540,
      "text": "他执教教书，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00075",
      "start_ms": 174980,
      "end_ms": 177480,
      "text": "夜晚伏案写剧本补贴家用。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00076",
      "start_ms": 177960,
      "end_ms": 178800,
      "text": "乱世之中，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00077",
      "start_ms": 179080,
      "end_ms": 181745,
      "text": "一支笔撑起一家三口安稳。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00078",
      "start_ms": 182310,
      "end_ms": 184625,
      "text": "后来前谁书动笔写围城，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00079",
      "start_ms": 185070,
      "end_ms": 188170,
      "text": "杨绛主动包揽全部家务刊，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00080",
      "start_ms": 188170,
      "end_ms": 188875,
      "text": "写书稿，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00081",
      "start_ms": 189270,
      "end_ms": 190305,
      "text": "斟酌字据，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00082",
      "start_ms": 190640,
      "end_ms": 192885,
      "text": "甘愿做他身后安静的支撑。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00083",
      "start_ms": 193380,
      "end_ms": 194425,
      "text": "围城问世，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00084",
      "start_ms": 194810,
      "end_ms": 195875,
      "text": "轰动文坛。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00085",
      "start_ms": 196470,
      "end_ms": 197845,
      "text": "可很少有人知道，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00086",
      "start_ms": 198680,
      "end_ms": 200225,
      "text": "这部传世之作，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00087",
      "start_ms": 200710,
      "end_ms": 203550,
      "text": "藏着杨绛无数默默付出的时光。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00088",
      "start_ms": 203750,
      "end_ms": 204935,
      "text": "事业刚有起色，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00089",
      "start_ms": 205260,
      "end_ms": 206955,
      "text": "人生磨难接踵而至。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00090",
      "start_ms": 207780,
      "end_ms": 208785,
      "text": "五十多岁那年，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00091",
      "start_ms": 209130,
      "end_ms": 210515,
      "text": "时代动荡袭来，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00092",
      "start_ms": 210940,
      "end_ms": 213195,
      "text": "杨绛被安排打扫公共厕所，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00093",
      "start_ms": 213510,
      "end_ms": 216115,
      "text": "还被剃去半边头发当众受辱，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00094",
      "start_ms": 216600,
      "end_ms": 218945,
      "text": "旁人都以为他会崩溃落泪。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00095",
      "start_ms": 219330,
      "end_ms": 220610,
      "text": "可他回家取剪刀，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00096",
      "start_ms": 220850,
      "end_ms": 221730,
      "text": "干脆剃光，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00097",
      "start_ms": 221790,
      "end_ms": 222665,
      "text": "剩于长发，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00098",
      "start_ms": 223100,
      "end_ms": 223580,
      "text": "坦然。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00099",
      "start_ms": 223600,
      "end_ms": 227405,
      "text": "面对周遭眼光下放武器干校的日子，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00100",
      "start_ms": 228350,
      "end_ms": 229945,
      "text": "寒冬住在漏风茅屋，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00101",
      "start_ms": 230390,
      "end_ms": 231995,
      "text": "双手冻满裂口。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00102",
      "start_ms": 232360,
      "end_ms": 233500,
      "text": "他一边干粗活，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00103",
      "start_ms": 233970,
      "end_ms": 235565,
      "text": "一边悄悄揣着字典，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00104",
      "start_ms": 235920,
      "end_ms": 238215,
      "text": "抓住零碎时间研读文字。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00105",
      "start_ms": 239080,
      "end_ms": 239645,
      "text": "彼时，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00106",
      "start_ms": 239930,
      "end_ms": 241650,
      "text": "他正在翻译堂吉诃德，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00107",
      "start_ms": 241710,
      "end_ms": 243090,
      "text": "为忠于原著。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00108",
      "start_ms": 243690,
      "end_ms": 247230,
      "text": "四十七岁的他从零自学西班牙语，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00109",
      "start_ms": 247470,
      "end_ms": 248710,
      "text": "耗费数年，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00110",
      "start_ms": 248830,
      "end_ms": 250210,
      "text": "一完大半稿件，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00111",
      "start_ms": 250730,
      "end_ms": 252730,
      "text": "却在动乱中全部遗世。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00112",
      "start_ms": 253290,
      "end_ms": 254810,
      "text": "他没有就此放弃，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00113",
      "start_ms": 255390,
      "end_ms": 257930,
      "text": "多年后取回残破手稿。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00114",
      "start_ms": 258470,
      "end_ms": 260190,
      "text": "他狭小简陋的办公室里，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00115",
      "start_ms": 260190,
      "end_ms": 261110,
      "text": "从头重艺，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00116",
      "start_ms": 261890,
      "end_ms": 264730,
      "text": "前后历时近二十年前，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00117",
      "start_ms": 264750,
      "end_ms": 267390,
      "text": "本终于在一九七八年面世。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00118",
      "start_ms": 268350,
      "end_ms": 270660,
      "text": "这份译文精过准、温润，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00119",
      "start_ms": 271040,
      "end_ms": 272920,
      "text": "兼具中西文字美感，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00120",
      "start_ms": 273340,
      "end_ms": 276820,
      "text": "至今仍是国内公认最优版本。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00121",
      "start_ms": 277460,
      "end_ms": 280160,
      "text": "西班牙国王特意为他颁发十字勋章，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00122",
      "start_ms": 280540,
      "end_ms": 283880,
      "text": "称赞他搭建起两国文学沟通的桥梁。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00123",
      "start_ms": 284020,
      "end_ms": 286440,
      "text": "熬过漫长苦难安稳，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00124",
      "start_ms": 286560,
      "end_ms": 288540,
      "text": "日子却格外短暂。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00125",
      "start_ms": 289080,
      "end_ms": 291600,
      "text": "晚年接连两场生离，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00126",
      "start_ms": 292120,
      "end_ms": 294440,
      "text": "先送走相伴半生的女儿。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00127",
      "start_ms": 294440,
      "end_ms": 296260,
      "text": "钱巩没过一年，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00128",
      "start_ms": 296660,
      "end_ms": 300270,
      "text": "相守六十余载的钱钟书也撒手离去，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00129",
      "start_ms": 300790,
      "end_ms": 302450,
      "text": "至亲尽数离开，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00130",
      "start_ms": 303070,
      "end_ms": 303990,
      "text": "偌大屋子，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00131",
      "start_ms": 304170,
      "end_ms": 305190,
      "text": "只剩他一人，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00132",
      "start_ms": 305650,
      "end_ms": 306550,
      "text": "旁人都怕。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00133",
      "start_ms": 306570,
      "end_ms": 308565,
      "text": "这位八十八岁老人撑不住。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00134",
      "start_ms": 309030,
      "end_ms": 312350,
      "text": "他却平静写下一句中书，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00135",
      "start_ms": 312410,
      "end_ms": 313130,
      "text": "逃走了，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00136",
      "start_ms": 313370,
      "end_ms": 314430,
      "text": "我也想逃走，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00137",
      "start_ms": 314870,
      "end_ms": 317710,
      "text": "可我不能逃得留在世间。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00138",
      "start_ms": 317770,
      "end_ms": 318670,
      "text": "打扫现场。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00139",
      "start_ms": 319530,
      "end_ms": 320950,
      "text": "所谓打扫现场，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00140",
      "start_ms": 321250,
      "end_ms": 323870,
      "text": "是整理丈夫七万多页，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00141",
      "start_ms": 324130,
      "end_ms": 325130,
      "text": "散乱手稿，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00142",
      "start_ms": 325230,
      "end_ms": 329980,
      "text": "校对分类编撰，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00143",
      "start_ms": 330820,
      "end_ms": 331960,
      "text": "耗费数年，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00144",
      "start_ms": 332260,
      "end_ms": 334540,
      "text": "整理出钱钟书手稿集，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00145",
      "start_ms": 335420,
      "end_ms": 342680,
      "text": "是提笔写下我们仨把一家三口温暖细碎的回忆妥帖。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00146",
      "start_ms": 342700,
      "end_ms": 346200,
      "text": "收藏是看淡名利，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00147",
      "start_ms": 346620,
      "end_ms": 350940,
      "text": "将毕生稿酬、版税全术捐给清华，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00148",
      "start_ms": 351480,
      "end_ms": 353440,
      "text": "设立好读书奖学金，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00149",
      "start_ms": 354000,
      "end_ms": 359230,
      "text": "资助家境清贫却勤学的学子名利荣华。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00150",
      "start_ms": 359290,
      "end_ms": 363610,
      "text": "他从不贪恋晚年独居，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00151",
      "start_ms": 363710,
      "end_ms": 366230,
      "text": "简朴小屋沙发旧了，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00152",
      "start_ms": 366290,
      "end_ms": 368310,
      "text": "不肯更换茶几，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00153",
      "start_ms": 368410,
      "end_ms": 370595,
      "text": "常年摆放两副碗筷，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00154",
      "start_ms": 370950,
      "end_ms": 372645,
      "text": "仿佛爱人从未走远。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00155",
      "start_ms": 374130,
      "end_ms": 375190,
      "text": "九十多岁时，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00156",
      "start_ms": 375350,
      "end_ms": 376065,
      "text": "他写下，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00157",
      "start_ms": 376420,
      "end_ms": 377855,
      "text": "走到人生边上，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00158",
      "start_ms": 378520,
      "end_ms": 382315,
      "text": "自问自答生死人性与欲望，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00159",
      "start_ms": 382980,
      "end_ms": 384785,
      "text": "文字没有华丽迟藻，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00160",
      "start_ms": 385410,
      "end_ms": 387345,
      "text": "句句戳破生活本质。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00161",
      "start_ms": 388430,
      "end_ms": 390985,
      "text": "我们熟知的那句世界是自己的，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00162",
      "start_ms": 391500,
      "end_ms": 393695,
      "text": "与他人毫无关系，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00163",
      "start_ms": 394260,
      "end_ms": 395765,
      "text": "不是消极避世，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00164",
      "start_ms": 396240,
      "end_ms": 399085,
      "text": "而是他历经悲欢后悟透的清醒。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00165",
      "start_ms": 399800,
      "end_ms": 403855,
      "text": "他见过世态凉薄受过无端委屈，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00166",
      "start_ms": 404310,
      "end_ms": 406515,
      "text": "却始终守住心底柔软，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00167",
      "start_ms": 407150,
      "end_ms": 408835,
      "text": "不随意评判他人，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00168",
      "start_ms": 409210,
      "end_ms": 409890,
      "text": "不纠结，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00169",
      "start_ms": 409970,
      "end_ms": 410925,
      "text": "过往遗憾。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00170",
      "start_ms": 411320,
      "end_ms": 412360,
      "text": "不盲目追逐，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00171",
      "start_ms": 412360,
      "end_ms": 413245,
      "text": "外界认可。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00172",
      "start_ms": 413830,
      "end_ms": 414565,
      "text": "他曾说，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00173",
      "start_ms": 414980,
      "end_ms": 416440,
      "text": "人除了生死，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00174",
      "start_ms": 416620,
      "end_ms": 418135,
      "text": "其余不过擦伤，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00175",
      "start_ms": 418540,
      "end_ms": 419525,
      "text": "平视自己，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00176",
      "start_ms": 419820,
      "end_ms": 422385,
      "text": "才能看清人生本来模样。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00177",
      "start_ms": 423260,
      "end_ms": 425285,
      "text": "读书不是为了发财牟利，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00178",
      "start_ms": 425570,
      "end_ms": 428655,
      "text": "而是成为有温度、会思考的人。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00179",
      "start_ms": 429770,
      "end_ms": 431850,
      "text": "这些流传全网的短句，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00180",
      "start_ms": 432350,
      "end_ms": 434070,
      "text": "从来不是空洞鸡汤，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00181",
      "start_ms": 434490,
      "end_ms": 440350,
      "text": "是他在扫厕所的清晨干笑寒夜失去至亲的深夜，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00182",
      "start_ms": 440950,
      "end_ms": 443290,
      "text": "慢慢沉淀出的人生答案。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00183",
      "start_ms": 444130,
      "end_ms": 445550,
      "text": "世零一六年五月，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00184",
      "start_ms": 445910,
      "end_ms": 448730,
      "text": "一百零五岁的杨绛安然离世，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00185",
      "start_ms": 449290,
      "end_ms": 453270,
      "text": "世人称她为中国最后一位女先生先生。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00186",
      "start_ms": 453390,
      "end_ms": 455190,
      "text": "二字无关性别，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00187",
      "start_ms": 455270,
      "end_ms": 459840,
      "text": "是世人对学识、风骨格局最高的境称。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00188",
      "start_ms": 460380,
      "end_ms": 462640,
      "text": "他一生兼具三重身份，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00189",
      "start_ms": 463020,
      "end_ms": 464740,
      "text": "有才情的创作者，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00190",
      "start_ms": 464940,
      "end_ms": 467140,
      "text": "打通中西文化的翻译家。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00191",
      "start_ms": 467519,
      "end_ms": 469220,
      "text": "温柔坚韧的妻子，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00192",
      "start_ms": 469220,
      "end_ms": 471380,
      "text": "与母亲顺境不骄，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00193",
      "start_ms": 471820,
      "end_ms": 472760,
      "text": "逆境不屈，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00194",
      "start_ms": 473260,
      "end_ms": 474260,
      "text": "痛失所爱，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00195",
      "start_ms": 474260,
      "end_ms": 475340,
      "text": "不沉溺悲泣，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00196",
      "start_ms": 475639,
      "end_ms": 476700,
      "text": "坐勇盛名，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00197",
      "start_ms": 476720,
      "end_ms": 477780,
      "text": "不贪恋浮化。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00198",
      "start_ms": 478260,
      "end_ms": 480120,
      "text": "回望杨绛的百年人生，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00199",
      "start_ms": 480540,
      "end_ms": 481800,
      "text": "而们终会明白，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00200",
      "start_ms": 482200,
      "end_ms": 483340,
      "text": "真正的优雅，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00201",
      "start_ms": 483720,
      "end_ms": 486340,
      "text": "从不是精致外表与顺遂人生，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00202",
      "start_ms": 486840,
      "end_ms": 490490,
      "text": "而是无论命运给予风雨还是荣光，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00203",
      "start_ms": 490850,
      "end_ms": 493070,
      "text": "始终守住内心从容，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00204",
      "start_ms": 493110,
      "end_ms": 494375,
      "text": "不愿不怒，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00205",
      "start_ms": 494740,
      "end_ms": 497145,
      "text": "不值岁月会带走亲友，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00206",
      "start_ms": 497580,
      "end_ms": 498675,
      "text": "消磨年华，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00207",
      "start_ms": 499060,
      "end_ms": 501645,
      "text": "但内心沉淀的通透与温柔，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00208",
      "start_ms": 502120,
      "end_ms": 504065,
      "text": "会伴随我们走完这一生。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00209",
      "start_ms": 505240,
      "end_ms": 506795,
      "text": "就像杨绛走过的路，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00210",
      "start_ms": 507250,
      "end_ms": 508665,
      "text": "一半烟火谋生，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00211",
      "start_ms": 509030,
      "end_ms": 509970,
      "text": "一伴清欢，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00212",
      "start_ms": 510070,
      "end_ms": 511440,
      "text": "修心清醒，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00213",
      "start_ms": 511580,
      "end_ms": 512025,
      "text": "释然，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00214",
      "start_ms": 512790,
      "end_ms": 514195,
      "text": "便是最好的活法。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00215",
      "start_ms": 515100,
      "end_ms": 518625,
      "text": "如果今天的故事也给了你一份前行的力量。"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00216",
      "start_ms": 519470,
      "end_ms": 519970,
      "text": "别忘了，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00217",
      "start_ms": 519970,
      "end_ms": 522015,
      "text": "点赞、收藏、关注我，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00218",
      "start_ms": 522350,
      "end_ms": 526195,
      "text": "后续继续带你走进更多有风骨的文人前辈，"
    },
    {
      "segment_id": "v_5f64c2cbaf66c973_s00219",
      "start_ms": 526540,
      "end_ms": 529315,
      "text": "品读岁月沉淀下来的人生智慧。"
    }
  ],
