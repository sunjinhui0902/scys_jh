  ],
  "duration_s": 84.937007,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "来这么晚只能吃剩菜了吧，领导饭在哪儿我都能吃，但您这桌不是谁想做就能做的，能赶上已经是我的运气了，这藕是好藕啊，就是心眼太多了。领导藕虽然心眼多，但是您的下酒菜多，鱼是好鱼，可惜就是刺多。领导，您看，鱼虽然刺多，但主心骨只有一根心腹是没有刺的。小李，你这菜点的也太多了，领导菜点的再多，也比不上平时您对我的照顾。多这杯酒，我先敬您打这么多饭，你喂猪呢？领导，我哪敢啊？我还以为您的饭量和肚量是一样的呢，都说宰相肚里能撑船，更何况只是一碗饭呢。哎，你什么意思啊？怎么到我这儿就剩半杯了。领导美满美满，代表幸福美满，这辈子美满，就是一辈子美满啊。你酒量挺好的呀，领导您可抬举我了，我平时真不太能喝。这不今天和您在一起吃饭，高兴啊，这一高兴就多贪了几杯。哈哈哈哈哈哈哈不喝就是看不起我。领导，我不是看不起您，我是看不起病，哈哈哈。关注我，每天学点高情商，说话技巧，让你的路越走越宽。",
  "segments": [
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00001",
      "start_ms": 1980,
      "end_ms": 3760,
      "text": "来这么晚只能吃剩菜了吧，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00002",
      "start_ms": 4120,
      "end_ms": 6100,
      "text": "领导饭在哪儿我都能吃，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00003",
      "start_ms": 6460,
      "end_ms": 8500,
      "text": "但您这桌不是谁想做就能做的，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00004",
      "start_ms": 8580,
      "end_ms": 10280,
      "text": "能赶上已经是我的运气了，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00005",
      "start_ms": 12260,
      "end_ms": 13520,
      "text": "这藕是好藕啊，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00006",
      "start_ms": 13860,
      "end_ms": 15180,
      "text": "就是心眼太多了。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00007",
      "start_ms": 15840,
      "end_ms": 17700,
      "text": "领导藕虽然心眼多，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00008",
      "start_ms": 17780,
      "end_ms": 19020,
      "text": "但是您的下酒菜多，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00009",
      "start_ms": 22120,
      "end_ms": 22980,
      "text": "鱼是好鱼，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00010",
      "start_ms": 23100,
      "end_ms": 24220,
      "text": "可惜就是刺多。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00011",
      "start_ms": 24400,
      "end_ms": 24700,
      "text": "领导，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00012",
      "start_ms": 24700,
      "end_ms": 25060,
      "text": "您看，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00013",
      "start_ms": 25500,
      "end_ms": 26500,
      "text": "鱼虽然刺多，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00014",
      "start_ms": 26660,
      "end_ms": 30455,
      "text": "但主心骨只有一根心腹是没有刺的。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00015",
      "start_ms": 32200,
      "end_ms": 32640,
      "text": "小李，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00016",
      "start_ms": 32920,
      "end_ms": 34600,
      "text": "你这菜点的也太多了，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00017",
      "start_ms": 34880,
      "end_ms": 36520,
      "text": "领导菜点的再多，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00018",
      "start_ms": 36520,
      "end_ms": 38140,
      "text": "也比不上平时您对我的照顾。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00019",
      "start_ms": 38140,
      "end_ms": 39040,
      "text": "多这杯酒，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00020",
      "start_ms": 39040,
      "end_ms": 42860,
      "text": "我先敬您打这么多饭，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00021",
      "start_ms": 42860,
      "end_ms": 43520,
      "text": "你喂猪呢？"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00022",
      "start_ms": 43880,
      "end_ms": 44240,
      "text": "领导，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00023",
      "start_ms": 44240,
      "end_ms": 44960,
      "text": "我哪敢啊？"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00024",
      "start_ms": 45120,
      "end_ms": 47340,
      "text": "我还以为您的饭量和肚量是一样的呢，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00025",
      "start_ms": 47500,
      "end_ms": 48960,
      "text": "都说宰相肚里能撑船，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00026",
      "start_ms": 49080,
      "end_ms": 50460,
      "text": "更何况只是一碗饭呢。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00027",
      "start_ms": 52200,
      "end_ms": 52440,
      "text": "哎，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00028",
      "start_ms": 52620,
      "end_ms": 53580,
      "text": "你什么意思啊？"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00029",
      "start_ms": 53740,
      "end_ms": 55260,
      "text": "怎么到我这儿就剩半杯了。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00030",
      "start_ms": 55400,
      "end_ms": 56620,
      "text": "领导美满美满，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00031",
      "start_ms": 56860,
      "end_ms": 57940,
      "text": "代表幸福美满，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00032",
      "start_ms": 58240,
      "end_ms": 59200,
      "text": "这辈子美满，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00033",
      "start_ms": 59340,
      "end_ms": 61265,
      "text": "就是一辈子美满啊。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00034",
      "start_ms": 63880,
      "end_ms": 65155,
      "text": "你酒量挺好的呀，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00035",
      "start_ms": 65520,
      "end_ms": 66980,
      "text": "领导您可抬举我了，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00036",
      "start_ms": 66980,
      "end_ms": 68245,
      "text": "我平时真不太能喝。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00037",
      "start_ms": 68540,
      "end_ms": 70020,
      "text": "这不今天和您在一起吃饭，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00038",
      "start_ms": 70020,
      "end_ms": 70520,
      "text": "高兴啊，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00039",
      "start_ms": 70540,
      "end_ms": 72055,
      "text": "这一高兴就多贪了几杯。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00040",
      "start_ms": 72430,
      "end_ms": 75585,
      "text": "哈哈哈哈哈哈哈不喝就是看不起我。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00041",
      "start_ms": 75770,
      "end_ms": 76185,
      "text": "领导，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00042",
      "start_ms": 76450,
      "end_ms": 77490,
      "text": "我不是看不起您，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00043",
      "start_ms": 77730,
      "end_ms": 78675,
      "text": "我是看不起病，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00044",
      "start_ms": 79060,
      "end_ms": 79590,
      "text": "哈哈哈。"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00045",
      "start_ms": 80050,
      "end_ms": 80645,
      "text": "关注我，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00046",
      "start_ms": 80980,
      "end_ms": 82220,
      "text": "每天学点高情商，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00047",
      "start_ms": 82220,
      "end_ms": 83025,
      "text": "说话技巧，"
    },
    {
      "segment_id": "v_62c6c0ccea3e81e2_s00048",
      "start_ms": 83320,
      "end_ms": 84795,
      "text": "让你的路越走越宽。"
    }
  ],
