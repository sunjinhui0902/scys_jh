{
  "schema_version": "text-light-input-1.0",
  "unit_id": "v_3891e7924038d9f2_u01",
  "video_id": "v_3891e7924038d9f2",
  "account": "破局书屋",
  "source_title": "每个孩子的成长过程，都应有这套漫画经济学，帮助孩子学会正确花钱、挣钱、管理钱，培养孩子财商思维。#财商思维",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
  "status": "AI_PENDING",
  "unit_index": 1,
  "unit_count": 1,
  "all_video_unit_ids": [
    "v_3891e7924038d9f2_u01"
  ],
  "duration_s": 258.947007,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "假设你的工资是一万，将你的工资乘以零点二，就是你每个月要存下或者投资的金额。第二，用你的工资乘以三，就是你现在需要的备用金。第三，用你的工资乘以零点五，就是你每个月支出的上限，包括吃喝住行，不可以超出这个数。第四，把你的工资乘以三百，再把这个数放一个回报。有百分之四的工具里面，你就可以做到每个月躺平，什么都不用做。每个月依然会有你现在的工资收入实现财务自由。第五，把你的工资乘以十二，再乘五，就是你。如果身体有任何情况不能工作，而你可以支持到自己生活水平的备用金，真正拉开人跟人差距的不只是赚多少钱，而是有没有从小培养正确的财商思维。妈妈，为啥商场一楼全是化妆品、珠宝，吃饭看电影却都在顶楼，因为顶楼风景好吃饭，香一楼太吵了呗，这都讲不清楚。孩子以后怎么学做生意？妈妈我知道是为什么。因为对一楼人流量大，大家都要经过有人会冲动消费。这是经济学启蒙课里提到过的瀑布效应。妈妈商场里面停车为什么比我们小区贵啊？因为商场地段好，所以停车自然贵，只知道地段好。停车费为什么贵？都讲不清楚孩子以后怎么学会控制成本。妈妈同样是矿泉水，为什么高铁上卖这么贵啊？嗯，高铁上就是贵，咱们自己带水喝就好了。连那么基础的经济学原理都讲不清楚孩子以后怎么发现商机。你想想，如果高铁上允许外面的人上来卖水，他还卖这么贵吗？就是因为只有他能卖，你又渴的不行，所以再贵你也得买。这是经济学启蒙课里提到的独家生意。妈妈自助餐随便吃，老板为什么还能赚钱啊？大部分人吃不多，所以老板不会亏。连自助餐厅为什么赚钱都给孩子讲，不清楚孩子以后怎么赚钱？妈妈猪肉便宜了，吃的人应该更多才对啊。为什么说猪肉销量反而下降了？可能大家兜里没钱了吧，穷了就少吃肉呗。也可能跟附近工地开工少了有关工地跟猪肉有什么关系？比如工地食堂，原来每天要买不少肉开工少了，吃饭的人少，采购也可能跟着减。不光是肉，蔬菜米面也可能受影响，一个地方的变化会连着影响别的生意。这我确实没想到妈妈为什么牛奶是方盒子，可乐却是圆瓶子。厂家就是这么设计的，具体原因我也不太清楚。可乐内部有气压圆形瓶身可以均匀分散压力。牛奶没有气压，方形盒子可以省下冷柜的仓储空间，降低商家成本。你们怎么什么都知道，我啥都不懂，这多亏了我。妈妈从小陪我看写给孩子的漫画经济学里面把这些商业模式全化成漫画故事了。一看就懂了。我妈说，一个人如果没有财商思维，长大要吃很多亏。所以我从小就在学。如果你不教导孩子金钱方面的知识，将来进入社会的他就像一张白纸，将人骗了也不自知错。把别人精心设计的陷阱当做自己的运气。推荐。在孩子十岁前，父母陪他读这套写给孩子的漫画经济学这套书，用生动有趣的故事帮助孩子树立正确的金钱观。像我们花的钱是从哪儿来的？教会孩子认识金钱的来源，如何不盲目购物？教会孩子理性消费，不乱花钱，玩具只能选一个怎么办？教会孩子学会取舍，把钱花在真正需要的地方。什么是打折？教会孩子正确看待优惠，不因为便宜就盲目购买记账的日子。教会孩子记录日常开销，养成管理零花钱的习惯，钱越多越好。引导孩子正确看待财富，树立健康的金钱观，让孩子从小明白，钱从哪里来，东西为什么有贵，有便宜，什么该买，什么不该买，慢慢学会合理花钱，管理金钱，培养独立思考的能力。家里有孩子的，真的可以准备一套，每天陪孩子看一点，让孩子从小建立财商思维。",
  "segments": [
    {
      "segment_id": "v_3891e7924038d9f2_s00001",
      "start_ms": 70,
      "end_ms": 1350,
      "text": "假设你的工资是一万，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00002",
      "start_ms": 1590,
      "end_ms": 3210,
      "text": "将你的工资乘以零点二，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00003",
      "start_ms": 3330,
      "end_ms": 5730,
      "text": "就是你每个月要存下或者投资的金额。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00004",
      "start_ms": 5810,
      "end_ms": 6210,
      "text": "第二，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00005",
      "start_ms": 6550,
      "end_ms": 7750,
      "text": "用你的工资乘以三，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00006",
      "start_ms": 7990,
      "end_ms": 9550,
      "text": "就是你现在需要的备用金。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00007",
      "start_ms": 9750,
      "end_ms": 10210,
      "text": "第三，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00008",
      "start_ms": 10490,
      "end_ms": 12070,
      "text": "用你的工资乘以零点五，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00009",
      "start_ms": 12230,
      "end_ms": 14050,
      "text": "就是你每个月支出的上限，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00010",
      "start_ms": 14230,
      "end_ms": 15410,
      "text": "包括吃喝住行，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00011",
      "start_ms": 15510,
      "end_ms": 16670,
      "text": "不可以超出这个数。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00012",
      "start_ms": 16750,
      "end_ms": 17210,
      "text": "第四，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00013",
      "start_ms": 17870,
      "end_ms": 19730,
      "text": "把你的工资乘以三百，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00014",
      "start_ms": 19970,
      "end_ms": 21290,
      "text": "再把这个数放一个回报。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00015",
      "start_ms": 21290,
      "end_ms": 22830,
      "text": "有百分之四的工具里面，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00016",
      "start_ms": 22990,
      "end_ms": 24930,
      "text": "你就可以做到每个月躺平，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00017",
      "start_ms": 25210,
      "end_ms": 26070,
      "text": "什么都不用做。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00018",
      "start_ms": 26270,
      "end_ms": 29935,
      "text": "每个月依然会有你现在的工资收入实现财务自由。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00019",
      "start_ms": 30220,
      "end_ms": 30660,
      "text": "第五，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00020",
      "start_ms": 30880,
      "end_ms": 32320,
      "text": "把你的工资乘以十二，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00021",
      "start_ms": 32360,
      "end_ms": 32980,
      "text": "再乘五，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00022",
      "start_ms": 33280,
      "end_ms": 33720,
      "text": "就是你。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00023",
      "start_ms": 33720,
      "end_ms": 35620,
      "text": "如果身体有任何情况不能工作，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00024",
      "start_ms": 35680,
      "end_ms": 38119,
      "text": "而你可以支持到自己生活水平的备用金，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00025",
      "start_ms": 38260,
      "end_ms": 41300,
      "text": "真正拉开人跟人差距的不只是赚多少钱，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00026",
      "start_ms": 41680,
      "end_ms": 44520,
      "text": "而是有没有从小培养正确的财商思维。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00027",
      "start_ms": 44960,
      "end_ms": 45360,
      "text": "妈妈，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00028",
      "start_ms": 45720,
      "end_ms": 48420,
      "text": "为啥商场一楼全是化妆品、珠宝，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00029",
      "start_ms": 48660,
      "end_ms": 50580,
      "text": "吃饭看电影却都在顶楼，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00030",
      "start_ms": 50920,
      "end_ms": 52540,
      "text": "因为顶楼风景好吃饭，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00031",
      "start_ms": 52540,
      "end_ms": 54200,
      "text": "香一楼太吵了呗，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00032",
      "start_ms": 54880,
      "end_ms": 55900,
      "text": "这都讲不清楚。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00033",
      "start_ms": 55980,
      "end_ms": 57400,
      "text": "孩子以后怎么学做生意？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00034",
      "start_ms": 57880,
      "end_ms": 59560,
      "text": "妈妈我知道是为什么。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00035",
      "start_ms": 59680,
      "end_ms": 61215,
      "text": "因为对一楼人流量大，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00036",
      "start_ms": 61580,
      "end_ms": 64085,
      "text": "大家都要经过有人会冲动消费。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00037",
      "start_ms": 64440,
      "end_ms": 67265,
      "text": "这是经济学启蒙课里提到过的瀑布效应。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00038",
      "start_ms": 68990,
      "end_ms": 72170,
      "text": "妈妈商场里面停车为什么比我们小区贵啊？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00039",
      "start_ms": 72350,
      "end_ms": 73470,
      "text": "因为商场地段好，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00040",
      "start_ms": 73630,
      "end_ms": 74935,
      "text": "所以停车自然贵，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00041",
      "start_ms": 76080,
      "end_ms": 76960,
      "text": "只知道地段好。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00042",
      "start_ms": 77160,
      "end_ms": 78160,
      "text": "停车费为什么贵？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00043",
      "start_ms": 78200,
      "end_ms": 81065,
      "text": "都讲不清楚孩子以后怎么学会控制成本。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00044",
      "start_ms": 83990,
      "end_ms": 85830,
      "text": "妈妈同样是矿泉水，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00045",
      "start_ms": 85910,
      "end_ms": 87885,
      "text": "为什么高铁上卖这么贵啊？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00046",
      "start_ms": 88220,
      "end_ms": 88615,
      "text": "嗯，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00047",
      "start_ms": 88970,
      "end_ms": 90045,
      "text": "高铁上就是贵，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00048",
      "start_ms": 90390,
      "end_ms": 91855,
      "text": "咱们自己带水喝就好了。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00049",
      "start_ms": 92930,
      "end_ms": 97655,
      "text": "连那么基础的经济学原理都讲不清楚孩子以后怎么发现商机。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00050",
      "start_ms": 98060,
      "end_ms": 98640,
      "text": "你想想，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00051",
      "start_ms": 98680,
      "end_ms": 101100,
      "text": "如果高铁上允许外面的人上来卖水，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00052",
      "start_ms": 101220,
      "end_ms": 102340,
      "text": "他还卖这么贵吗？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00053",
      "start_ms": 102540,
      "end_ms": 104000,
      "text": "就是因为只有他能卖，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00054",
      "start_ms": 104160,
      "end_ms": 105080,
      "text": "你又渴的不行，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00055",
      "start_ms": 105320,
      "end_ms": 106700,
      "text": "所以再贵你也得买。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00056",
      "start_ms": 106980,
      "end_ms": 109885,
      "text": "这是经济学启蒙课里提到的独家生意。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00057",
      "start_ms": 110160,
      "end_ms": 112155,
      "text": "妈妈自助餐随便吃，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00058",
      "start_ms": 112490,
      "end_ms": 114335,
      "text": "老板为什么还能赚钱啊？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00059",
      "start_ms": 115090,
      "end_ms": 116355,
      "text": "大部分人吃不多，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00060",
      "start_ms": 116710,
      "end_ms": 117865,
      "text": "所以老板不会亏。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00061",
      "start_ms": 118700,
      "end_ms": 121300,
      "text": "连自助餐厅为什么赚钱都给孩子讲，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00062",
      "start_ms": 121300,
      "end_ms": 123515,
      "text": "不清楚孩子以后怎么赚钱？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00063",
      "start_ms": 124560,
      "end_ms": 126420,
      "text": "妈妈猪肉便宜了，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00064",
      "start_ms": 126420,
      "end_ms": 128180,
      "text": "吃的人应该更多才对啊。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00065",
      "start_ms": 128220,
      "end_ms": 130445,
      "text": "为什么说猪肉销量反而下降了？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00066",
      "start_ms": 131400,
      "end_ms": 133100,
      "text": "可能大家兜里没钱了吧，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00067",
      "start_ms": 133400,
      "end_ms": 134845,
      "text": "穷了就少吃肉呗。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00068",
      "start_ms": 135240,
      "end_ms": 139795,
      "text": "也可能跟附近工地开工少了有关工地跟猪肉有什么关系？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00069",
      "start_ms": 140100,
      "end_ms": 141160,
      "text": "比如工地食堂，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00070",
      "start_ms": 141240,
      "end_ms": 143560,
      "text": "原来每天要买不少肉开工少了，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00071",
      "start_ms": 143560,
      "end_ms": 144360,
      "text": "吃饭的人少，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00072",
      "start_ms": 144640,
      "end_ms": 145895,
      "text": "采购也可能跟着减。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00073",
      "start_ms": 146400,
      "end_ms": 147200,
      "text": "不光是肉，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00074",
      "start_ms": 147440,
      "end_ms": 149445,
      "text": "蔬菜米面也可能受影响，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00075",
      "start_ms": 149770,
      "end_ms": 152685,
      "text": "一个地方的变化会连着影响别的生意。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00076",
      "start_ms": 153230,
      "end_ms": 157985,
      "text": "这我确实没想到妈妈为什么牛奶是方盒子，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00077",
      "start_ms": 158220,
      "end_ms": 159605,
      "text": "可乐却是圆瓶子。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00078",
      "start_ms": 160960,
      "end_ms": 162755,
      "text": "厂家就是这么设计的，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00079",
      "start_ms": 163210,
      "end_ms": 165265,
      "text": "具体原因我也不太清楚。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00080",
      "start_ms": 165730,
      "end_ms": 169635,
      "text": "可乐内部有气压圆形瓶身可以均匀分散压力。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00081",
      "start_ms": 169940,
      "end_ms": 171025,
      "text": "牛奶没有气压，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00082",
      "start_ms": 171400,
      "end_ms": 174320,
      "text": "方形盒子可以省下冷柜的仓储空间，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00083",
      "start_ms": 174460,
      "end_ms": 175435,
      "text": "降低商家成本。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00084",
      "start_ms": 176760,
      "end_ms": 178425,
      "text": "你们怎么什么都知道，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00085",
      "start_ms": 178690,
      "end_ms": 179555,
      "text": "我啥都不懂，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00086",
      "start_ms": 180070,
      "end_ms": 180830,
      "text": "这多亏了我。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00087",
      "start_ms": 180830,
      "end_ms": 187810,
      "text": "妈妈从小陪我看写给孩子的漫画经济学里面把这些商业模式全化成漫画故事了。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00088",
      "start_ms": 187810,
      "end_ms": 188710,
      "text": "一看就懂了。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00089",
      "start_ms": 188870,
      "end_ms": 189490,
      "text": "我妈说，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00090",
      "start_ms": 189750,
      "end_ms": 191650,
      "text": "一个人如果没有财商思维，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00091",
      "start_ms": 191950,
      "end_ms": 193330,
      "text": "长大要吃很多亏。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00092",
      "start_ms": 193850,
      "end_ms": 195610,
      "text": "所以我从小就在学。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00093",
      "start_ms": 195949,
      "end_ms": 198230,
      "text": "如果你不教导孩子金钱方面的知识，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00094",
      "start_ms": 198410,
      "end_ms": 200750,
      "text": "将来进入社会的他就像一张白纸，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00095",
      "start_ms": 200950,
      "end_ms": 202750,
      "text": "将人骗了也不自知错。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00096",
      "start_ms": 202790,
      "end_ms": 205710,
      "text": "把别人精心设计的陷阱当做自己的运气。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00097",
      "start_ms": 206050,
      "end_ms": 206370,
      "text": "推荐。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00098",
      "start_ms": 206370,
      "end_ms": 207510,
      "text": "在孩子十岁前，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00099",
      "start_ms": 207650,
      "end_ms": 211480,
      "text": "父母陪他读这套写给孩子的漫画经济学这套书，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00100",
      "start_ms": 211480,
      "end_ms": 214960,
      "text": "用生动有趣的故事帮助孩子树立正确的金钱观。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00101",
      "start_ms": 215320,
      "end_ms": 217300,
      "text": "像我们花的钱是从哪儿来的？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00102",
      "start_ms": 217460,
      "end_ms": 219280,
      "text": "教会孩子认识金钱的来源，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00103",
      "start_ms": 219720,
      "end_ms": 220960,
      "text": "如何不盲目购物？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00104",
      "start_ms": 221160,
      "end_ms": 222740,
      "text": "教会孩子理性消费，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00105",
      "start_ms": 222880,
      "end_ms": 223640,
      "text": "不乱花钱，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00106",
      "start_ms": 223880,
      "end_ms": 225380,
      "text": "玩具只能选一个怎么办？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00107",
      "start_ms": 225680,
      "end_ms": 227120,
      "text": "教会孩子学会取舍，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00108",
      "start_ms": 227340,
      "end_ms": 229140,
      "text": "把钱花在真正需要的地方。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00109",
      "start_ms": 229400,
      "end_ms": 230220,
      "text": "什么是打折？"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00110",
      "start_ms": 230560,
      "end_ms": 232260,
      "text": "教会孩子正确看待优惠，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00111",
      "start_ms": 232400,
      "end_ms": 235180,
      "text": "不因为便宜就盲目购买记账的日子。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00112",
      "start_ms": 235280,
      "end_ms": 236920,
      "text": "教会孩子记录日常开销，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00113",
      "start_ms": 237140,
      "end_ms": 238780,
      "text": "养成管理零花钱的习惯，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00114",
      "start_ms": 238860,
      "end_ms": 239735,
      "text": "钱越多越好。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00115",
      "start_ms": 240230,
      "end_ms": 241970,
      "text": "引导孩子正确看待财富，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00116",
      "start_ms": 242090,
      "end_ms": 243410,
      "text": "树立健康的金钱观，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00117",
      "start_ms": 243590,
      "end_ms": 244670,
      "text": "让孩子从小明白，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00118",
      "start_ms": 244670,
      "end_ms": 245490,
      "text": "钱从哪里来，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00119",
      "start_ms": 245650,
      "end_ms": 246630,
      "text": "东西为什么有贵，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00120",
      "start_ms": 246630,
      "end_ms": 247230,
      "text": "有便宜，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00121",
      "start_ms": 247390,
      "end_ms": 248070,
      "text": "什么该买，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00122",
      "start_ms": 248130,
      "end_ms": 248910,
      "text": "什么不该买，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00123",
      "start_ms": 248930,
      "end_ms": 250210,
      "text": "慢慢学会合理花钱，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00124",
      "start_ms": 250290,
      "end_ms": 250990,
      "text": "管理金钱，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00125",
      "start_ms": 251230,
      "end_ms": 252730,
      "text": "培养独立思考的能力。"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00126",
      "start_ms": 253030,
      "end_ms": 253950,
      "text": "家里有孩子的，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00127",
      "start_ms": 253950,
      "end_ms": 255050,
      "text": "真的可以准备一套，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00128",
      "start_ms": 255290,
      "end_ms": 256490,
      "text": "每天陪孩子看一点，"
    },
    {
      "segment_id": "v_3891e7924038d9f2_s00129",
      "start_ms": 256630,
      "end_ms": 258735,
      "text": "让孩子从小建立财商思维。"
    }
  ],
