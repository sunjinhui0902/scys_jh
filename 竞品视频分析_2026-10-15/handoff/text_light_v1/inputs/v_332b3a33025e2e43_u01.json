  "source_title": "比悬空寺还不可思议的山西木构：榜首那座高六十七米，扛过几十次地震和两百多发炮弹。#山西古建筑  #古代木结构",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
  "status": "AI_PENDING",
  "unit_index": 1,
  "unit_count": 1,
