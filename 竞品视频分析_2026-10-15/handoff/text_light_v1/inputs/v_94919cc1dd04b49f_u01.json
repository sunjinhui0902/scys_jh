    {
      "segment_id": "v_94919cc1dd04b49f_s00018",
      "start_ms": 43370,
      "end_ms": 44430,
      "text": "就在国庆期间，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00019",
      "start_ms": 44610,
      "end_ms": 47670,
      "text": "纽约的bapup way改名为广东大道。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00020",
      "start_ms": 49990,
