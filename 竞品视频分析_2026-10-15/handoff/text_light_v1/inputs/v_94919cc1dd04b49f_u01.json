    {
      "segment_id": "v_94919cc1dd04b49f_s00026",
      "start_ms": 60420,
      "end_ms": 63895,
      "text": "曼哈顿市中心还有福建人、林则徐的雕像。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00027",
      "start_ms": 64380,
      "end_ms": 65540,
      "text": "在纽约的法拉盛，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00028",
      "start_ms": 65540,
      "end_ms": 66905,
      "text": "你根本不需要讲英文，"
