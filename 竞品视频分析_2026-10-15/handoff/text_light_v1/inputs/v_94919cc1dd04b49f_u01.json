    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00030",
      "start_ms": 69140,
      "end_ms": 70940,
      "text": "纽约总人口八百多万人，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00031",
      "start_ms": 71080,
      "end_ms": 73325,
      "text": "这里的人竟然有九十七种性别，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00032",
      "start_ms": 73710,
      "end_ms": 75630,
      "text": "他一个城市就超过了全世界。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00033",
      "start_ms": 75630,
      "end_ms": 78990,
      "text": "百分之九十国家的GDP站在华尔街，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00034",
      "start_ms": 78990,
      "end_ms": 81015,
      "text": "就像掉进了金钱的深渊里。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00035",
      "start_ms": 81450,
      "end_ms": 83630,
      "text": "全世界最大的纽约证券交易所，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00036",
      "start_ms": 83750,
      "end_ms": 87095,
      "text": "它一天的交易额比很多国家一年的财政收入还要多。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00037",
      "start_ms": 87870,
      "end_ms": 90050,
      "text": "纽交所门口站着一个五位女孩，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00038",
      "start_ms": 90230,
      "end_ms": 93095,
      "text": "象征着男女平等对金钱和权力的挑战。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00039",
      "start_ms": 93830,
      "end_ms": 95200,
      "text": "朱军十年后，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00040",
      "start_ms": 95280,
      "end_ms": 96815,
      "text": "这里会有你的位置吗？"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00041",
      "start_ms": 97390,
      "end_ms": 98070,
      "text": "总有一天，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00042",
      "start_ms": 98130,
      "end_ms": 99955,
      "text": "我一定会闯出一番天地的。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00043",
      "start_ms": 100470,
      "end_ms": 103190,
      "text": "你看这两个大弹是不是被摸得锃亮，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00044",
      "start_ms": 103270,
      "end_ms": 104214,
      "text": "牛气冲天。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00045",
      "start_ms": 104870,
      "end_ms": 106290,
      "text": "附近呢就是纳斯达克，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00046",
      "start_ms": 106310,
      "end_ms": 107555,
      "text": "还有联邦大厅。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00047",
      "start_ms": 108040,
      "end_ms": 111160,
      "text": "一七八九年华盛顿就是在这里阳台上宣誓，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00048",
      "start_ms": 111160,
      "end_ms": 112760,
      "text": "成为美利坚合众国。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00049",
      "start_ms": 112760,
      "end_ms": 116895,
      "text": "第一任总统华尔街边上就是纽约联储的地下金库，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00050",
      "start_ms": 117160,
      "end_ms": 119295,
      "text": "存放着来自全世界的黄金。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00051",
      "start_ms": 119670,
      "end_ms": 120545,
      "text": "更不可思议的是，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00052",
      "start_ms": 120780,
      "end_ms": 122975,
      "text": "这些黄金大多并不是美国自己的，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00053",
      "start_ms": 123240,
      "end_ms": 125680,
      "text": "而是世界各国把黄金送到纽约，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00054",
      "start_ms": 125860,
      "end_ms": 127335,
      "text": "让他来替自己保管。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00055",
      "start_ms": 128120,
      "end_ms": 130490,
      "text": "而且你手上的金镯子的价格，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00056",
      "start_ms": 130490,
      "end_ms": 131855,
      "text": "明天是涨还是跌？"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00057",
      "start_ms": 132280,
      "end_ms": 135175,
      "text": "金价很大程度上由纽约期货市场说了算。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00058",
      "start_ms": 135780,
      "end_ms": 138845,
      "text": "水晶发达国家并不是现在才发达的，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00059",
      "start_ms": 139010,
      "end_ms": 140585,
      "text": "而是他们一直都很发达。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00060",
      "start_ms": 141050,
      "end_ms": 144525,
      "text": "你看到的这些曼哈顿的建筑群已经存在一百多年了，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00061",
      "start_ms": 144910,
      "end_ms": 145870,
      "text": "难怪一百多年前，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00062",
      "start_ms": 145870,
      "end_ms": 148390,
      "text": "李鸿章峰、纽约回来之后就一言不发。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00063",
      "start_ms": 149180,
      "end_ms": 158425,
      "text": "布鲁克林大桥一八八三年建成世界第一座钢铁大桥李鸿章当年也建过这座桥一百二十年前的一九零四年。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00064",
      "start_ms": 158750,
      "end_ms": 160245,
      "text": "纽约的地铁正式开通，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00065",
      "start_ms": 160580,
      "end_ms": 162840,
      "text": "如今他已经老旧脏乱，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00066",
      "start_ms": 162980,
      "end_ms": 165915,
      "text": "但始终让纽约这个庞然大物日夜奔流。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00067",
      "start_ms": 166570,
      "end_ms": 167470,
      "text": "一九三零年，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00068",
      "start_ms": 167470,
      "end_ms": 170775,
      "text": "美国家庭的汽车普及率已经超过了百分之五十，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00069",
      "start_ms": 171130,
      "end_ms": 175110,
      "text": "而当时每四个人里面就已经有一个人拥有汽车周军。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00070",
      "start_ms": 175110,
      "end_ms": 179310,
      "text": "你看世界上最细的牙签楼摩天楼有多极端？"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00071",
      "start_ms": 179330,
      "end_ms": 180810,
      "text": "它只有十九米宽，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00072",
      "start_ms": 180950,
      "end_ms": 182525,
      "text": "却有四百三十五米高，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00073",
      "start_ms": 182880,
      "end_ms": 184040,
      "text": "这么高风一吹，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00074",
      "start_ms": 184300,
      "end_ms": 185885,
      "text": "顶层的人会不会晕船呢？"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00075",
      "start_ms": 186370,
      "end_ms": 186730,
      "text": "纽约，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00076",
      "start_ms": 186730,
      "end_ms": 189405,
      "text": "这是我去过的全世界最复杂的一座城市。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00077",
      "start_ms": 189720,
      "end_ms": 192600,
      "text": "你在地图上能找到的任何国家和地区，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00078",
      "start_ms": 192760,
      "end_ms": 194315,
      "text": "都会有人住在纽约。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00079",
      "start_ms": 194800,
      "end_ms": 196775,
      "text": "你在纽约见到什么都不会奇怪，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00080",
      "start_ms": 197060,
      "end_ms": 198985,
      "text": "因为联合国总部就在这里，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00081",
      "start_ms": 199270,
      "end_ms": 201010,
      "text": "但是纽约又不容易迷路。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00082",
      "start_ms": 201150,
      "end_ms": 202005,
      "text": "路很规整，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00083",
      "start_ms": 202180,
      "end_ms": 205655,
      "text": "横平竖直的横着的叫街竖着的叫大道，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00084",
      "start_ms": 205880,
      "end_ms": 207735,
      "text": "有一条斜着的就是百老汇。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00085",
      "start_ms": 208120,
      "end_ms": 211365,
      "text": "其中第五大道相当于曼哈顿的南北中轴线，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00086",
      "start_ms": 211790,
      "end_ms": 216510,
      "text": "五大道的起点是四百四十三米的帝国大厦建立于一九三一年，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00087",
      "start_ms": 216630,
      "end_ms": 218555,
      "text": "只用了四百一十天就建成。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00088",
      "start_ms": 219000,
      "end_ms": 222175,
      "text": "当时纽约掀起了一场世界第一高楼的疯狂竞赛，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00089",
      "start_ms": 222610,
      "end_ms": 224950,
      "text": "与他竞争的那栋楼在华尔街四十号，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00090",
      "start_ms": 224990,
      "end_ms": 228830,
      "text": "现在叫特朗普大厦第五大道中心就是洛克菲勒中心。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00091",
      "start_ms": 228970,
      "end_ms": 232435,
      "text": "这哥们被评为人类历史上一辈子挣钱最多的一个人。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00092",
      "start_ms": 232720,
      "end_ms": 234710,
      "text": "从一个穷小子逆携程，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00093",
      "start_ms": 234730,
      "end_ms": 237195,
      "text": "全世界三分之二的油田都是他的，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00094",
      "start_ms": 237600,
      "end_ms": 240885,
      "text": "但是他给后代立下的规矩就是千万不要做生意。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00095",
      "start_ms": 241400,
      "end_ms": 243700,
      "text": "第五大道上面还有大都会艺术博物馆，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00096",
      "start_ms": 243740,
      "end_ms": 245415,
      "text": "收藏着大量的中国文物，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00097",
      "start_ms": 245740,
      "end_ms": 248380,
      "text": "尤其是汝窑竟然就随便放在走廊上，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00098",
      "start_ms": 248560,
      "end_ms": 251125,
      "text": "而武大道的尽头就是时代广场，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00099",
      "start_ms": 251380,
      "end_ms": 255015,
      "text": "号称世界十字路口人生小长沙解放路。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00100",
      "start_ms": 255590,
      "end_ms": 258830,
      "text": "时代广场上的屏幕呢是可以花钱直接现场投屏的。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00101",
      "start_ms": 258910,
      "end_ms": 262895,
      "text": "你花小几百美金就可以把自己的照片在上面出现几十秒。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00102",
      "start_ms": 263440,
      "end_ms": 266160,
      "text": "这里最酷的可不是无人驾驶的赛博新车，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00103",
      "start_ms": 266260,
      "end_ms": 268385,
      "text": "而是朴实无华的三墩子。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00104",
      "start_ms": 269010,
      "end_ms": 269730,
      "text": "万万没想到，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00105",
      "start_ms": 269730,
      "end_ms": 271250,
      "text": "美国人学会了第一句中国话，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00106",
      "start_ms": 271250,
      "end_ms": 276300,
      "text": "竟然是请注意倒车刘军，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00107",
      "start_ms": 276420,
      "end_ms": 277675,
      "text": "这是一张十美元。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00108",
      "start_ms": 277960,
      "end_ms": 284495,
      "text": "上面印着的是美国金融之父汉密尔顿、现代、美国的起点就是从这张十美元起价的。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00109",
      "start_ms": 284900,
      "end_ms": 286880,
      "text": "美国刚建国的时候非常穷。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00110",
      "start_ms": 287140,
      "end_ms": 289380,
      "text": "国务卿杰弗逊坚持农业立国，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00111",
      "start_ms": 289460,
      "end_ms": 293145,
      "text": "但是财政部长海密尔顿则主张发展制造业和金融业。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00112",
      "start_ms": 293530,
      "end_ms": 294775,
      "text": "两个人吵了十几年。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00113",
      "start_ms": 295030,
      "end_ms": 297270,
      "text": "也成了美国两党制的雏形。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00114",
      "start_ms": 297510,
      "end_ms": 297930,
      "text": "最后，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00115",
      "start_ms": 298030,
      "end_ms": 299790,
      "text": "国会通过了汉密尔顿的方案。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00116",
      "start_ms": 299950,
      "end_ms": 304750,
      "text": "于是一个崭新的美国就此开始凭借着华尔街的融资和并购，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00117",
      "start_ms": 304850,
      "end_ms": 307030,
      "text": "美国的基建开始飞速发展。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00118",
      "start_ms": 307310,
      "end_ms": 308810,
      "text": "到了一八八零年代，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00119",
      "start_ms": 308870,
      "end_ms": 313790,
      "text": "美国已经诞生了通用电器、可口可乐、杜邦这样的世界级企业。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00120",
      "start_ms": 313990,
      "end_ms": 314570,
      "text": "而今天，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00121",
      "start_ms": 314650,
      "end_ms": 321290,
      "text": "纽约排名前五的企业分别是摩根大通、花旗银行、高盛、摩根、史丹利这样的金融机构，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00122",
      "start_ms": 321290,
      "end_ms": 322770,
      "text": "再加上辉瑞制药，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00123",
      "start_ms": 322770,
      "end_ms": 324270,
      "text": "而你能想象吗？"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00124",
      "start_ms": 324270,
      "end_ms": 328900,
      "text": "纽纽约在十七世纪只是一个靠渔业为生的小据点，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00125",
      "start_ms": 329260,
      "end_ms": 331900,
      "text": "当时被荷兰殖民者称为新阿姆斯克丹，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00126",
      "start_ms": 332060,
      "end_ms": 337100,
      "text": "后来被英国人夺取之后取名为new york.中文应该叫新乡哦，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00127",
      "start_ms": 337100,
      "end_ms": 337340,
      "text": "不，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00128",
      "start_ms": 337380,
      "end_ms": 339920,
      "text": "纽约周军你知道多可怕吗？"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00129",
      "start_ms": 340100,
      "end_ms": 342380,
      "text": "从一八九零年至今一百多年了，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00130",
      "start_ms": 342380,
      "end_ms": 347200,
      "text": "美国始终是全球第一大经济体、全球市值最高的一百家上市公司，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00131",
      "start_ms": 347320,
      "end_ms": 350980,
      "text": "美国占了六十二家纽约、香港、伦敦，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00132",
      "start_ms": 351080,
      "end_ms": 352600,
      "text": "并称为纽伦港，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00133",
      "start_ms": 352660,
      "end_ms": 354515,
      "text": "是全球三大金融中心。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00134",
      "start_ms": 355120,
      "end_ms": 357560,
      "text": "虽然美国依然是经济超级大国，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00135",
      "start_ms": 357600,
      "end_ms": 359215,
      "text": "但是难掩颓势，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00136",
      "start_ms": 359780,
      "end_ms": 362105,
      "text": "大家千万可别把美国想象的特别美好。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00137",
      "start_ms": 362380,
      "end_ms": 364275,
      "text": "不管你是在纽约还是在洛杉矶，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00138",
      "start_ms": 364590,
      "end_ms": 366515,
      "text": "其实市区都是非常脏乱的，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00139",
      "start_ms": 366760,
      "end_ms": 367900,
      "text": "随处可见垃圾，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00140",
      "start_ms": 368020,
      "end_ms": 369505,
      "text": "还总有一股尿骚味儿。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00141",
      "start_ms": 369910,
      "end_ms": 373895,
      "text": "我个人最接受不了的就是美国的小费文化已经完全变质了。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00142",
      "start_ms": 374150,
      "end_ms": 375490,
      "text": "本来应该是自愿给的，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00143",
      "start_ms": 375530,
      "end_ms": 377425,
      "text": "现在普遍给付百分之二十，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00144",
      "start_ms": 377810,
      "end_ms": 379790,
      "text": "墙上到处各种乱涂乱画。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00145",
      "start_ms": 379890,
      "end_ms": 381055,
      "text": "纽约不养闲人，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00146",
      "start_ms": 381850,
      "end_ms": 383030,
      "text": "自由是一种放大镜，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00147",
      "start_ms": 383070,
      "end_ms": 385505,
      "text": "它把人的勇敢、天真和善良会放大，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00148",
      "start_ms": 385750,
      "end_ms": 389815,
      "text": "但也会把人性的懒、蝉、贪渍都加倍放大。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00149",
      "start_ms": 390330,
      "end_ms": 392550,
      "text": "纽约是繁华与先进的代名词，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00150",
      "start_ms": 392630,
      "end_ms": 394905,
      "text": "也是自由与罪恶的综合体。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00151",
      "start_ms": 395540,
      "end_ms": 398185,
      "text": "你看这自由女神像是法国赠送的铜像，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00152",
      "start_ms": 398410,
      "end_ms": 399665,
      "text": "他一开始是金色的，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00153",
      "start_ms": 399870,
      "end_ms": 401985,
      "text": "我们现在看到的绿色是铜锈，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00154",
      "start_ms": 402510,
      "end_ms": 405610,
      "text": "这斑驳的铜锈就像日渐衰落的美国，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00155",
      "start_ms": 405690,
      "end_ms": 407655,
      "text": "已经不再是世界的灯塔。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00156",
      "start_ms": 408010,
      "end_ms": 408390,
      "text": "周军，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00157",
      "start_ms": 408390,
      "end_ms": 409035,
      "text": "你知道吗？"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00158",
      "start_ms": 409360,
      "end_ms": 412345,
      "text": "世界上最长的路就是美国人的下坡路。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00159",
      "start_ms": 412720,
      "end_ms": 413600,
      "text": "从我记事起，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00160",
      "start_ms": 413600,
      "end_ms": 414945,
      "text": "他就一直在走下坡路。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00161",
      "start_ms": 415370,
      "end_ms": 417610,
      "text": "世界上最硬的脚就是美国人的脚，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00162",
      "start_ms": 417750,
      "end_ms": 420185,
      "text": "因为他们总是搬起石头砸自己的脚。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00163",
      "start_ms": 420610,
      "end_ms": 421105,
      "text": "朱军，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00164",
      "start_ms": 421450,
      "end_ms": 423645,
      "text": "你是不是总是听人说美国快要完蛋了，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00165",
      "start_ms": 423920,
      "end_ms": 424800,
      "text": "霸权崩溃，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00166",
      "start_ms": 424820,
      "end_ms": 425685,
      "text": "社会撕裂，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00167",
      "start_ms": 425970,
      "end_ms": 427145,
      "text": "产业空心化等等。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00168",
      "start_ms": 427720,
      "end_ms": 428620,
      "text": "但是事实上，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00169",
      "start_ms": 428820,
      "end_ms": 433025,
      "text": "我发现真的是没有人比美国人更懂得如何收割世界的人才。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00170",
      "start_ms": 433720,
      "end_ms": 434060,
      "text": "你看，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00171",
      "start_ms": 434060,
      "end_ms": 436160,
      "text": "美国当今活跃的这些科技强人，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00172",
      "start_ms": 436200,
      "end_ms": 437455,
      "text": "其实都是进口来的。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00173",
      "start_ms": 437830,
      "end_ms": 444475,
      "text": "马斯克来自非洲、黄仁勋、苏资峰、李菲菲、来自中国、微软和谷歌的CEO都来自印度。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00174",
      "start_ms": 444950,
      "end_ms": 445930,
      "text": "而你能想象吗？"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00175",
      "start_ms": 446010,
      "end_ms": 448170,
      "text": "从一九七八年到二零一五年，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00176",
      "start_ms": 448270,
      "end_ms": 452895,
      "text": "光硅谷一个小地方就吸纳了两万多名中国、清华大学的毕业生，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00177",
      "start_ms": 453250,
      "end_ms": 454510,
      "text": "年轻人去往哪里，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00178",
      "start_ms": 454610,
      "end_ms": 456085,
      "text": "财富就流往哪里。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00179",
      "start_ms": 456420,
      "end_ms": 460115,
      "text": "我们中国也正在为吸纳世界级的人才准备一片沃土，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00180",
      "start_ms": 460420,
      "end_ms": 463800,
      "text": "要让全世界的顶尖人才争着抢着来，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00181",
      "start_ms": 463800,
      "end_ms": 466625,
      "text": "给中国发展良情择木而泣。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00182",
      "start_ms": 467020,
      "end_ms": 467240,
      "text": "当然，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00183",
      "start_ms": 467240,
      "end_ms": 469120,
      "text": "美国也不只是盯着我们中国人，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00184",
      "start_ms": 469120,
      "end_ms": 471145,
      "text": "他吸引的是来自全世界的人才。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00185",
      "start_ms": 471470,
      "end_ms": 473815,
      "text": "我这几天在纽约的哥伦比亚大学上课，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00186",
      "start_ms": 474180,
      "end_ms": 475700,
      "text": "诺贝尔奖得主克教授，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00187",
      "start_ms": 475760,
      "end_ms": 478265,
      "text": "他就是德国人被美国给吸纳进来的。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00188",
      "start_ms": 478890,
      "end_ms": 481790,
      "text": "美国自己公布的二零二五年博士大普查，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00189",
      "start_ms": 482030,
      "end_ms": 484770,
      "text": "中国籍的博士仍然数量位居第一，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00190",
      "start_ms": 484890,
      "end_ms": 487595,
      "text": "近八成毕业的时候打算留在美国。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00191",
      "start_ms": 488100,
      "end_ms": 492075,
      "text": "所以以后的竞争本质上就是中国人和中国人的竞争。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00192",
      "start_ms": 492490,
      "end_ms": 495935,
      "text": "在中国的中国人和他们在美国的中国人之间的镜头，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00193",
      "start_ms": 496310,
      "end_ms": 503790,
      "text": "我身后就是美国常青藤高校哥伦比亚大学在纽约历史最古老的大学始建于一七五四年，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00194",
      "start_ms": 503870,
      "end_ms": 505395,
      "text": "比美国建国还早，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00195",
      "start_ms": 505740,
      "end_ms": 508365,
      "text": "从这里走出了八十八位诺贝尔奖得主。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00196",
      "start_ms": 508780,
      "end_ms": 511765,
      "text": "李政道当年就是在这里拿下诺贝尔物理学奖，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00197",
      "start_ms": 512060,
      "end_ms": 513260,
      "text": "从这里走出了北大。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00198",
      "start_ms": 513280,
      "end_ms": 528025,
      "text": "三位校长胡是蒋梦琳、马英初、南开大学创始人张柏林猴氏制检法发明人、侯德榜原子弹之母、吴建雄大哲学家、冯友兰社会学泰斗、潘光诞、平民教育家、陶行知等等。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00199",
      "start_ms": 528280,
      "end_ms": 530125,
      "text": "中国近代史的半壁江山，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00200",
      "start_ms": 530360,
      "end_ms": 531745,
      "text": "都在纽约读过书。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00201",
      "start_ms": 532090,
      "end_ms": 532490,
      "text": "朱今，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00202",
      "start_ms": 532670,
      "end_ms": 535275,
      "text": "我们要很理性的看待中外的差距。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00203",
      "start_ms": 535610,
      "end_ms": 537310,
      "text": "我发现很多人会嘲笑他们，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00204",
      "start_ms": 537310,
      "end_ms": 538430,
      "text": "国外没有支付宝，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00205",
      "start_ms": 538530,
      "end_ms": 540415,
      "text": "于是就简单的得出个结论，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00206",
      "start_ms": 540630,
      "end_ms": 542435,
      "text": "他们的移动支付太落后了。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00207",
      "start_ms": 542850,
      "end_ms": 543725,
      "text": "但事实上呢，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00208",
      "start_ms": 544010,
      "end_ms": 545285,
      "text": "其实他们用apple pay ir,"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00209",
      "start_ms": 545620,
      "end_ms": 547860,
      "text": "完全不需要二维码碰一下就能支付，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00210",
      "start_ms": 547960,
      "end_ms": 548860,
      "text": "我自己也试过，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00211",
      "start_ms": 548980,
      "end_ms": 550185,
      "text": "其实真的非常方便。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00212",
      "start_ms": 550640,
      "end_ms": 553700,
      "text": "再比如很多人说咱们中国是高铁强国，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00213",
      "start_ms": 553780,
      "end_ms": 555880,
      "text": "但是你看美国连高铁都没有，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00214",
      "start_ms": 555940,
      "end_ms": 557045,
      "text": "是因为他们很穷。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00215",
      "start_ms": 557510,
      "end_ms": 558475,
      "text": "但事实真的吗？"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00216",
      "start_ms": 558850,
      "end_ms": 562765,
      "text": "其实有一个原因是因为他们飞机实在是太多了。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00217",
      "start_ms": 563210,
      "end_ms": 564370,
      "text": "我们中国有机场，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00218",
      "start_ms": 564450,
      "end_ms": 566335,
      "text": "大大小小加起来五百多座，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00219",
      "start_ms": 566630,
      "end_ms": 569785,
      "text": "而美国竟然有一万九千多座机场。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00220",
      "start_ms": 570160,
      "end_ms": 572425,
      "text": "真正的自信可不是把世界看低，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00221",
      "start_ms": 572710,
      "end_ms": 574245,
      "text": "而是把世界看清。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00222",
      "start_ms": 574960,
      "end_ms": 577560,
      "text": "其实我发现美国适合两类人移民到这里，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00223",
      "start_ms": 577560,
      "end_ms": 579615,
      "text": "一种是特别有钱的超级大土豪。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00224",
      "start_ms": 579900,
      "end_ms": 581845,
      "text": "这种在全球各地都是舒适圈，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00225",
      "start_ms": 582120,
      "end_ms": 586095,
      "text": "还有一种就是底层的凭手艺吃饭呢能够挣到辛苦钱，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00226",
      "start_ms": 586570,
      "end_ms": 589525,
      "text": "最怕的就是夹在中间的普通中产阶层。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00227",
      "start_ms": 589970,
      "end_ms": 593515,
      "text": "我见过很多在国内卖掉了北上广深仅有的一套房子，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00228",
      "start_ms": 593830,
      "end_ms": 595605,
      "text": "然后使尽了全身的力气。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00229",
      "start_ms": 595860,
      "end_ms": 597925,
      "text": "为了孩子来这儿接娃的陪读父母。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00230",
      "start_ms": 598270,
      "end_ms": 599710,
      "text": "这类人群是最痛苦的，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00231",
      "start_ms": 599850,
      "end_ms": 604150,
      "text": "因为他们失去了人民币制造的现金流和社会地位非常憋屈的。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00232",
      "start_ms": 604150,
      "end_ms": 605990,
      "text": "在这里做边缘的二等公民，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00233",
      "start_ms": 606230,
      "end_ms": 607130,
      "text": "但是又不甘心，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00234",
      "start_ms": 607230,
      "end_ms": 608450,
      "text": "承认自己选错了。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00235",
      "start_ms": 609190,
      "end_ms": 612470,
      "text": "其实这些年我见过很多海外的华人都非常爱国，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00236",
      "start_ms": 612590,
      "end_ms": 613710,
      "text": "也很关心祖国。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00237",
      "start_ms": 614190,
      "end_ms": 616290,
      "text": "有些人嘴上说已经习惯了纽约，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00238",
      "start_ms": 616430,
      "end_ms": 621190,
      "text": "但手机里的天气预报永远关注的是自己的家乡、北京、成都、武汉等等。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00239",
      "start_ms": 621710,
      "end_ms": 624610,
      "text": "他们特别像从中国出发的蒲公英种子，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00240",
      "start_ms": 624810,
      "end_ms": 626290,
      "text": "一阵时代的风吹过，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00241",
      "start_ms": 626370,
      "end_ms": 630260,
      "text": "他们就散落到了世界各地求学谋生成家，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00242",
      "start_ms": 630620,
      "end_ms": 631460,
      "text": "一次远行，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00243",
      "start_ms": 631660,
      "end_ms": 632780,
      "text": "最后变成了一生。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00244",
      "start_ms": 633280,
      "end_ms": 634460,
      "text": "在外面过得好的，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00245",
      "start_ms": 634560,
      "end_ms": 635840,
      "text": "我们真心为你高兴，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00246",
      "start_ms": 636199,
      "end_ms": 637180,
      "text": "过得不容易的。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00247",
      "start_ms": 637180,
      "end_ms": 639360,
      "text": "也希望你知道千里万里之外，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00248",
      "start_ms": 639460,
      "end_ms": 640800,
      "text": "还有人牵挂着你。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00249",
      "start_ms": 641040,
      "end_ms": 643840,
      "text": "爱故乡从来不意味着必须生活在故乡，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00250",
      "start_ms": 644159,
      "end_ms": 645580,
      "text": "只需要风吹到哪里，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00251",
      "start_ms": 645740,
      "end_ms": 646660,
      "text": "你就在哪里。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00252",
      "start_ms": 646860,
      "end_ms": 648400,
      "text": "好好生长朱君，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00253",
      "start_ms": 648680,
      "end_ms": 650620,
      "text": "欢迎来到纽约为你，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00254",
      "start_ms": 650680,
      "end_ms": 651860,
      "text": "他已等候多时。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00255",
      "start_ms": 652460,
      "end_ms": 653180,
      "text": "四百年前，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00256",
      "start_ms": 653180,
      "end_ms": 656000,
      "text": "当第一批远航者的帆船驶入哈德逊河时，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00257",
      "start_ms": 656160,
      "end_ms": 659065,
      "text": "这座城市的传奇便悄然开篇。"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00258",
      "start_ms": 659530,
      "end_ms": 660250,
      "text": "时至今日，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00259",
      "start_ms": 660470,
      "end_ms": 662665,
      "text": "纽约依旧在创造传奇，"
    },
    {
      "segment_id": "v_94919cc1dd04b49f_s00260",
      "start_ms": 663000,
      "end_ms": 666505,
      "text": "而每一个奔赴纽约的人本身就是传奇。"
    }
  ],
