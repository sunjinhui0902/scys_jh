  ],
  "duration_s": 152.785011,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "来这么晚只能吃剩菜了吧，领导饭在哪儿我都能吃，但您这桌不是谁想做就能做的，能赶上已经是我的运气了，谁学一声狗叫，我就给一千。祝领导，家庭旺，事业旺以后日子旺，上家旺，一共四生四千块。好，小林，说实话，我不太喜欢你那我更该谢谢您了。你谢什么？您不喜欢我，可该给的机会照样给，工作上也没少支持，没拿个人好感为难我，这份格局就够我福气了。年轻就是好啊，年轻就是还不够沉稳，还要向您多学习，我们才能变得更优秀。你这么能干，我这位置看来要让给你了，那我得先恭喜您，你坐我的位置，恭喜我什么？您高升了，才轮得到我们往前挪。我真有那一天也得是您先走到更高的地方，这杯先敬您步步高升。好，这藕是好藕啊，就是心眼儿太多了。领导藕虽然心眼多，但也是您的下酒菜啊。哈哈哈哈哎呀，你点那么多菜，该不会是想把我吃穷吧，帮领导您把穷给吃了，那您就只剩负了。哈哈哈哈哈哈小林啊，你一开口就让人喜欢，你是怎么做到的？多亏了我父母，从小就让我看这本把话说的恰到好处，才学会这些处事思路。假如你不爱说话，不爱争辩，也不爱出门，甚至恐惧社交推荐你读完这本把话说的恰到好处，让你轻松摆平各种社交场合，你每天就看两页，每一个场景慢慢练，你就会变成一个会说话、懂交际的人。在这本书里有一句话，我特别欣赏，他，写的是面对别人夸你优秀时，你可以回，那是不优秀点，怎么能和你做朋友呢？当有人说你真聪明，你就回近朱者赤，和你在一起啊，熏都熏出来了当领导跟你说辛苦了，你就会领导，这都是我应该做的，强将手下无弱兵，我怎么能给您丢脸呢？当我看到这段的时候，这个真是让我欲解心开啊。每一句都很有意思，就是手把手教我们在不同的场景之下应该怎么说。书籍的内容和我现在展示的是一模一样的，你就放心的拿回去看，就是一句一句的教你，让你轻松摆平各种社交场合，但凡学会三分，你都能把人际关系拿捏的死死的，这本书真的可以帮助到大家。",
  "segments": [
    {
      "segment_id": "v_c3a892a3cf5094cc_s00001",
      "start_ms": 290,
      "end_ms": 2790,
      "text": "来这么晚只能吃剩菜了吧，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00002",
      "start_ms": 3410,
      "end_ms": 5410,
      "text": "领导饭在哪儿我都能吃，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00003",
      "start_ms": 5650,
      "end_ms": 7790,
      "text": "但您这桌不是谁想做就能做的，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00004",
      "start_ms": 7930,
      "end_ms": 9570,
      "text": "能赶上已经是我的运气了，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00005",
      "start_ms": 12410,
      "end_ms": 13650,
      "text": "谁学一声狗叫，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00006",
      "start_ms": 14370,
      "end_ms": 15355,
      "text": "我就给一千。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00007",
      "start_ms": 19940,
      "end_ms": 20480,
      "text": "祝领导，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00008",
      "start_ms": 20480,
      "end_ms": 21040,
      "text": "家庭旺，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00009",
      "start_ms": 21080,
      "end_ms": 22540,
      "text": "事业旺以后日子旺，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00010",
      "start_ms": 22540,
      "end_ms": 23080,
      "text": "上家旺，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00011",
      "start_ms": 23240,
      "end_ms": 24520,
      "text": "一共四生四千块。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00012",
      "start_ms": 26580,
      "end_ms": 26820,
      "text": "好，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00013",
      "start_ms": 27140,
      "end_ms": 27580,
      "text": "小林，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00014",
      "start_ms": 27980,
      "end_ms": 28600,
      "text": "说实话，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00015",
      "start_ms": 28740,
      "end_ms": 31220,
      "text": "我不太喜欢你那我更该谢谢您了。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00016",
      "start_ms": 31540,
      "end_ms": 32300,
      "text": "你谢什么？"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00017",
      "start_ms": 32560,
      "end_ms": 33460,
      "text": "您不喜欢我，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00018",
      "start_ms": 33660,
      "end_ms": 35000,
      "text": "可该给的机会照样给，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00019",
      "start_ms": 35120,
      "end_ms": 36360,
      "text": "工作上也没少支持，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00020",
      "start_ms": 36660,
      "end_ms": 37980,
      "text": "没拿个人好感为难我，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00021",
      "start_ms": 38100,
      "end_ms": 39660,
      "text": "这份格局就够我福气了。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00022",
      "start_ms": 40280,
      "end_ms": 41400,
      "text": "年轻就是好啊，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00023",
      "start_ms": 41640,
      "end_ms": 43000,
      "text": "年轻就是还不够沉稳，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00024",
      "start_ms": 43420,
      "end_ms": 44560,
      "text": "还要向您多学习，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00025",
      "start_ms": 44900,
      "end_ms": 46120,
      "text": "我们才能变得更优秀。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00026",
      "start_ms": 46600,
      "end_ms": 47440,
      "text": "你这么能干，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00027",
      "start_ms": 47720,
      "end_ms": 49535,
      "text": "我这位置看来要让给你了，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00028",
      "start_ms": 49790,
      "end_ms": 50930,
      "text": "那我得先恭喜您，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00029",
      "start_ms": 51130,
      "end_ms": 52190,
      "text": "你坐我的位置，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00030",
      "start_ms": 52390,
      "end_ms": 53190,
      "text": "恭喜我什么？"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00031",
      "start_ms": 53230,
      "end_ms": 54030,
      "text": "您高升了，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00032",
      "start_ms": 54070,
      "end_ms": 55330,
      "text": "才轮得到我们往前挪。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00033",
      "start_ms": 55670,
      "end_ms": 58550,
      "text": "我真有那一天也得是您先走到更高的地方，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00034",
      "start_ms": 58730,
      "end_ms": 60555,
      "text": "这杯先敬您步步高升。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00035",
      "start_ms": 61020,
      "end_ms": 61425,
      "text": "好，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00036",
      "start_ms": 61830,
      "end_ms": 63245,
      "text": "这藕是好藕啊，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00037",
      "start_ms": 64080,
      "end_ms": 65715,
      "text": "就是心眼儿太多了。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00038",
      "start_ms": 66930,
      "end_ms": 69280,
      "text": "领导藕虽然心眼多，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00039",
      "start_ms": 69480,
      "end_ms": 70855,
      "text": "但也是您的下酒菜啊。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00040",
      "start_ms": 71160,
      "end_ms": 72775,
      "text": "哈哈哈哈哎呀，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00041",
      "start_ms": 73070,
      "end_ms": 74295,
      "text": "你点那么多菜，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00042",
      "start_ms": 74750,
      "end_ms": 76510,
      "text": "该不会是想把我吃穷吧，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00043",
      "start_ms": 76650,
      "end_ms": 78505,
      "text": "帮领导您把穷给吃了，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00044",
      "start_ms": 78730,
      "end_ms": 79935,
      "text": "那您就只剩负了。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00045",
      "start_ms": 81010,
      "end_ms": 84245,
      "text": "哈哈哈哈哈哈小林啊，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00046",
      "start_ms": 84990,
      "end_ms": 86795,
      "text": "你一开口就让人喜欢，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00047",
      "start_ms": 87310,
      "end_ms": 88485,
      "text": "你是怎么做到的？"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00048",
      "start_ms": 88730,
      "end_ms": 89590,
      "text": "多亏了我父母，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00049",
      "start_ms": 89610,
      "end_ms": 92230,
      "text": "从小就让我看这本把话说的恰到好处，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00050",
      "start_ms": 92390,
      "end_ms": 93775,
      "text": "才学会这些处事思路。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00051",
      "start_ms": 94090,
      "end_ms": 95090,
      "text": "假如你不爱说话，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00052",
      "start_ms": 95170,
      "end_ms": 95850,
      "text": "不爱争辩，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00053",
      "start_ms": 95870,
      "end_ms": 96630,
      "text": "也不爱出门，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00054",
      "start_ms": 96770,
      "end_ms": 100245,
      "text": "甚至恐惧社交推荐你读完这本把话说的恰到好处，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00055",
      "start_ms": 100560,
      "end_ms": 102480,
      "text": "让你轻松摆平各种社交场合，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00056",
      "start_ms": 102700,
      "end_ms": 103895,
      "text": "你每天就看两页，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00057",
      "start_ms": 104200,
      "end_ms": 105425,
      "text": "每一个场景慢慢练，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00058",
      "start_ms": 105710,
      "end_ms": 108025,
      "text": "你就会变成一个会说话、懂交际的人。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00059",
      "start_ms": 108390,
      "end_ms": 109630,
      "text": "在这本书里有一句话，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00060",
      "start_ms": 109630,
      "end_ms": 110625,
      "text": "我特别欣赏，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00061",
      "start_ms": 110930,
      "end_ms": 111010,
      "text": "他，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00062",
      "start_ms": 111010,
      "end_ms": 113110,
      "text": "写的是面对别人夸你优秀时，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00063",
      "start_ms": 113250,
      "end_ms": 113870,
      "text": "你可以回，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00064",
      "start_ms": 114150,
      "end_ms": 115130,
      "text": "那是不优秀点，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00065",
      "start_ms": 115250,
      "end_ms": 116605,
      "text": "怎么能和你做朋友呢？"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00066",
      "start_ms": 116830,
      "end_ms": 118170,
      "text": "当有人说你真聪明，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00067",
      "start_ms": 118310,
      "end_ms": 119805,
      "text": "你就回近朱者赤，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00068",
      "start_ms": 120080,
      "end_ms": 120880,
      "text": "和你在一起啊，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00069",
      "start_ms": 120880,
      "end_ms": 123685,
      "text": "熏都熏出来了当领导跟你说辛苦了，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00070",
      "start_ms": 124040,
      "end_ms": 125160,
      "text": "你就会领导，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00071",
      "start_ms": 125160,
      "end_ms": 126395,
      "text": "这都是我应该做的，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00072",
      "start_ms": 126690,
      "end_ms": 128050,
      "text": "强将手下无弱兵，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00073",
      "start_ms": 128190,
      "end_ms": 129595,
      "text": "我怎么能给您丢脸呢？"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00074",
      "start_ms": 129970,
      "end_ms": 131370,
      "text": "当我看到这段的时候，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00075",
      "start_ms": 131370,
      "end_ms": 133275,
      "text": "这个真是让我欲解心开啊。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00076",
      "start_ms": 133750,
      "end_ms": 135065,
      "text": "每一句都很有意思，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00077",
      "start_ms": 135340,
      "end_ms": 138460,
      "text": "就是手把手教我们在不同的场景之下应该怎么说。"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00078",
      "start_ms": 138800,
      "end_ms": 141555,
      "text": "书籍的内容和我现在展示的是一模一样的，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00079",
      "start_ms": 141790,
      "end_ms": 143110,
      "text": "你就放心的拿回去看，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00080",
      "start_ms": 143330,
      "end_ms": 144710,
      "text": "就是一句一句的教你，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00081",
      "start_ms": 144810,
      "end_ms": 146970,
      "text": "让你轻松摆平各种社交场合，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00082",
      "start_ms": 147170,
      "end_ms": 148230,
      "text": "但凡学会三分，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00083",
      "start_ms": 148370,
      "end_ms": 150665,
      "text": "你都能把人际关系拿捏的死死的，"
    },
    {
      "segment_id": "v_c3a892a3cf5094cc_s00084",
      "start_ms": 150910,
      "end_ms": 152645,
      "text": "这本书真的可以帮助到大家。"
    }
  ],
