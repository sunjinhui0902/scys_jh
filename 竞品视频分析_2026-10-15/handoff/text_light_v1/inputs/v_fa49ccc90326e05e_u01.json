  "duration_s": 54.766667,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "最好的活法就是彻底悠闲享受那种绝望的孤独，享受那种谁都不在乎的自在，不在意别人的眼光和评价，也不介意命运把你拖进什么样的处境里，顺其自然，随遇而安，自得其乐，一辈子不后悔。你只需要记住，过劳者死过惠者添生，累了就睡，饿了就吃没苦，就别自找苦吃。吃苦耐劳不等于人格，高尚吃喝玩乐也不等于虚度光阴。人生啊就像是一滴雨，生于天亡于地。最终我们都是时间的过客。人这一辈子啊，其实就是用来体验的，而不是用来证明给谁看的。你活着的每时每刻，就是以人生的全部意义。",
  "segments": [
    {
      "segment_id": "v_fa49ccc90326e05e_s00001",
      "start_ms": 130,
      "end_ms": 4590,
      "text": "最好的活法就是彻底悠闲享受那种绝望的孤独，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00002",
      "start_ms": 4970,
      "end_ms": 7350,
      "text": "享受那种谁都不在乎的自在，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00003",
      "start_ms": 7950,
      "end_ms": 9730,
      "text": "不在意别人的眼光和评价，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00004",
      "start_ms": 9990,
      "end_ms": 13330,
      "text": "也不介意命运把你拖进什么样的处境里，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00005",
      "start_ms": 13670,
      "end_ms": 14510,
      "text": "顺其自然，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00006",
      "start_ms": 14790,
      "end_ms": 15590,
      "text": "随遇而安，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00007",
      "start_ms": 15930,
      "end_ms": 16790,
      "text": "自得其乐，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00008",
      "start_ms": 17010,
      "end_ms": 18230,
      "text": "一辈子不后悔。"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00009",
      "start_ms": 19070,
      "end_ms": 20030,
      "text": "你只需要记住，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00010",
      "start_ms": 20230,
      "end_ms": 22530,
      "text": "过劳者死过惠者添生，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00011",
      "start_ms": 23030,
      "end_ms": 23730,
      "text": "累了就睡，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00012",
      "start_ms": 24050,
      "end_ms": 25770,
      "text": "饿了就吃没苦，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00013",
      "start_ms": 25930,
      "end_ms": 27090,
      "text": "就别自找苦吃。"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00014",
      "start_ms": 27450,
      "end_ms": 29210,
      "text": "吃苦耐劳不等于人格，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00015",
      "start_ms": 29210,
      "end_ms": 32980,
      "text": "高尚吃喝玩乐也不等于虚度光阴。"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00016",
      "start_ms": 33760,
      "end_ms": 35620,
      "text": "人生啊就像是一滴雨，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00017",
      "start_ms": 35840,
      "end_ms": 37700,
      "text": "生于天亡于地。"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00018",
      "start_ms": 37980,
      "end_ms": 40340,
      "text": "最终我们都是时间的过客。"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00019",
      "start_ms": 41180,
      "end_ms": 42240,
      "text": "人这一辈子啊，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00020",
      "start_ms": 42340,
      "end_ms": 43860,
      "text": "其实就是用来体验的，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00021",
      "start_ms": 43980,
      "end_ms": 45940,
      "text": "而不是用来证明给谁看的。"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00022",
      "start_ms": 46220,
      "end_ms": 47800,
      "text": "你活着的每时每刻，"
    },
    {
      "segment_id": "v_fa49ccc90326e05e_s00023",
      "start_ms": 48100,
      "end_ms": 51245,
      "text": "就是以人生的全部意义。"
    }
  ],
