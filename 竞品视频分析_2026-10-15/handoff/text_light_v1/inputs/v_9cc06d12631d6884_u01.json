  ],
  "duration_s": 314.458333,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "诺奖公布的前几天，全世界赌桌上赔率排第一的是个中国女人。可你要是随便上街拦个人问，认不认识残雪。十个人里，九个得摇头，一个让外国人排队翻译排队研究排队读的中国作家。咱自己人愣是没几个人听说过她他到底是谁，他凭什么。今天这段的，咱就好好讲讲这个人，把中国文学写进了世界，却差点被自己人忘了的名字。你要是猜他是书香门第，名校出身，那可真就想差了他血本名邓小华。一九五三年五月三十号生在湖南长沙，一爹邓君鸿，当年是新湖南报，就是今天湖南日报的前身的社长兼总编辑娘也是报社的有真文化，后来还写了本永州旧事，兄弟姐妹八个，住在大院里，家里书多的能铺一地。按理说这样人家的孩子路都是铺好的，可命运的巴掌来的。比谁都快。一九五七年，父亲被错划成右派，一夜之间，家道中落，四岁的残雪被送到外婆跟前。这个外婆是个湘西南的老太太，一身楚地的老习俗，半夜起来手里拿根木棒，在天井里赶鬼，谁家孩子不舒服，他拿唾沫给人抹一抹，闲着没事儿就编些世上没有的故事，哄孩子，小残雪就蹲在旁边看，有时候还跟着搭把手，这些事儿他记了一辈子。后来一字不落，全写进了书里，可天不饶人，残雪。七岁那年，外婆终究还是没能熬过那几年的饥荒，岁月撒手人寰哪，这是他这辈子最狠的一道疤。一个七八岁的孩子连着尝够了，什么叫天塌了？一九六六年，残学小学刚毕业书就念到头了，那一年往后，他再也没进过学校的门，可他不认命，没学上，他就自己学。翻旧书，啃西方那些大师的作品，读哲学，一个小学文凭的姑娘，硬是靠着自学，把别人念一辈子，大学才能碰的东西，全都吃进了肚子。一个小学文凭的姑娘能干啥？十七岁进街道工厂洗工，装配工车工一样一样干过来，手上一道道茧子，后来被挑去当赤脚医生。在长沙郊区给人扎针灸，背着篓子上山采草药，再往后还去代课教英语。一个小学毕业的人站上讲台教英语，你细品品这个，今天谁敢信？可那个年月就是这样，有一双手就得顶上去，日子是苦，可这个人从来没低过头。一九七八年，她嫁了个刚从乡下回城的知青木匠出身。一九八零年，两口子一咬牙，从厂里出来，开了间裁缝铺，他手巧手艺好样子，新一干就是五年，生意越做越红火，白天给人量体裁衣，到了晚上收拾停当，他心里那团火越烧越旺，就这么一个在泥里滚了小半辈子的女人，您可能觉得这辈子也就这样了，可谁也没想到，真正要命的转折恰恰就出在这间裁缝铺上。三十岁那年，他干了一件让所有人都觉得他疯了的事。在一台缝纫机上，他开始写小说，一个裁缝写的还是那种谁都看不懂的怪东西。他写的是啥？他凭什么能从一个裁缝一路写进世界文坛，让外国人抢着翻译下集？咱接着讲这个裁缝铺里走出来的中国作家，想听下集的，先把关注点上觉得这故事扎心的点个赞，留个言说说，你身边有没有这样被埋没，还有上进心的人转发给家里爱看书的长辈，让他们也认识认识这位了不起的中国作家。咱们评论区见。",
  "segments": [
    {
      "segment_id": "v_9cc06d12631d6884_s00001",
      "start_ms": 150,
      "end_ms": 1910,
      "text": "诺奖公布的前几天，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00002",
      "start_ms": 2210,
      "end_ms": 6630,
      "text": "全世界赌桌上赔率排第一的是个中国女人。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00003",
      "start_ms": 7450,
      "end_ms": 10350,
      "text": "可你要是随便上街拦个人问，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00004",
      "start_ms": 10450,
      "end_ms": 11670,
      "text": "认不认识残雪。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00005",
      "start_ms": 12070,
      "end_ms": 12850,
      "text": "十个人里，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00006",
      "start_ms": 12850,
      "end_ms": 13770,
      "text": "九个得摇头，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00007",
      "start_ms": 14490,
      "end_ms": 19270,
      "text": "一个让外国人排队翻译排队研究排队读的中国作家。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00008",
      "start_ms": 19830,
      "end_ms": 24310,
      "text": "咱自己人愣是没几个人听说过她他到底是谁，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00009",
      "start_ms": 24550,
      "end_ms": 25510,
      "text": "他凭什么。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00010",
      "start_ms": 27010,
      "end_ms": 28130,
      "text": "今天这段的，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00011",
      "start_ms": 28610,
      "end_ms": 30000,
      "text": "咱就好好讲讲这个人，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00012",
      "start_ms": 30120,
      "end_ms": 32500,
      "text": "把中国文学写进了世界，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00013",
      "start_ms": 32880,
      "end_ms": 36040,
      "text": "却差点被自己人忘了的名字。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00014",
      "start_ms": 36180,
      "end_ms": 38240,
      "text": "你要是猜他是书香门第，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00015",
      "start_ms": 38680,
      "end_ms": 39800,
      "text": "名校出身，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00016",
      "start_ms": 40120,
      "end_ms": 45020,
      "text": "那可真就想差了他血本名邓小华。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00017",
      "start_ms": 45480,
      "end_ms": 49560,
      "text": "一九五三年五月三十号生在湖南长沙，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00018",
      "start_ms": 50280,
      "end_ms": 51960,
      "text": "一爹邓君鸿，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00019",
      "start_ms": 52580,
      "end_ms": 53980,
      "text": "当年是新湖南报，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00020",
      "start_ms": 54280,
      "end_ms": 61265,
      "text": "就是今天湖南日报的前身的社长兼总编辑娘也是报社的有真文化，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00021",
      "start_ms": 61790,
      "end_ms": 63705,
      "text": "后来还写了本永州旧事，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00022",
      "start_ms": 64180,
      "end_ms": 65455,
      "text": "兄弟姐妹八个，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00023",
      "start_ms": 65840,
      "end_ms": 66905,
      "text": "住在大院里，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00024",
      "start_ms": 67130,
      "end_ms": 69065,
      "text": "家里书多的能铺一地。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00025",
      "start_ms": 69640,
      "end_ms": 73565,
      "text": "按理说这样人家的孩子路都是铺好的，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00026",
      "start_ms": 74360,
      "end_ms": 76000,
      "text": "可命运的巴掌来的。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00027",
      "start_ms": 76000,
      "end_ms": 76845,
      "text": "比谁都快。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00028",
      "start_ms": 77820,
      "end_ms": 78885,
      "text": "一九五七年，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00029",
      "start_ms": 79260,
      "end_ms": 81445,
      "text": "父亲被错划成右派，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00030",
      "start_ms": 82010,
      "end_ms": 82775,
      "text": "一夜之间，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00031",
      "start_ms": 83260,
      "end_ms": 84225,
      "text": "家道中落，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00032",
      "start_ms": 84930,
      "end_ms": 88145,
      "text": "四岁的残雪被送到外婆跟前。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00033",
      "start_ms": 88730,
      "end_ms": 91895,
      "text": "这个外婆是个湘西南的老太太，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00034",
      "start_ms": 92270,
      "end_ms": 94315,
      "text": "一身楚地的老习俗，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00035",
      "start_ms": 94890,
      "end_ms": 97090,
      "text": "半夜起来手里拿根木棒，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00036",
      "start_ms": 97430,
      "end_ms": 98895,
      "text": "在天井里赶鬼，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00037",
      "start_ms": 99370,
      "end_ms": 100775,
      "text": "谁家孩子不舒服，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00038",
      "start_ms": 101070,
      "end_ms": 102805,
      "text": "他拿唾沫给人抹一抹，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00039",
      "start_ms": 103190,
      "end_ms": 107125,
      "text": "闲着没事儿就编些世上没有的故事，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00040",
      "start_ms": 107430,
      "end_ms": 108225,
      "text": "哄孩子，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00041",
      "start_ms": 108990,
      "end_ms": 110990,
      "text": "小残雪就蹲在旁边看，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00042",
      "start_ms": 111090,
      "end_ms": 112655,
      "text": "有时候还跟着搭把手，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00043",
      "start_ms": 113470,
      "end_ms": 116185,
      "text": "这些事儿他记了一辈子。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00044",
      "start_ms": 116970,
      "end_ms": 119250,
      "text": "后来一字不落，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00045",
      "start_ms": 119270,
      "end_ms": 120525,
      "text": "全写进了书里，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00046",
      "start_ms": 121450,
      "end_ms": 122635,
      "text": "可天不饶人，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00047",
      "start_ms": 123760,
      "end_ms": 124260,
      "text": "残雪。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00048",
      "start_ms": 124360,
      "end_ms": 125265,
      "text": "七岁那年，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00049",
      "start_ms": 126090,
      "end_ms": 130860,
      "text": "外婆终究还是没能熬过那几年的饥荒，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00050",
      "start_ms": 130900,
      "end_ms": 133445,
      "text": "岁月撒手人寰哪，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00051",
      "start_ms": 134380,
      "end_ms": 137425,
      "text": "这是他这辈子最狠的一道疤。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00052",
      "start_ms": 138440,
      "end_ms": 141580,
      "text": "一个七八岁的孩子连着尝够了，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00053",
      "start_ms": 141580,
      "end_ms": 142915,
      "text": "什么叫天塌了？"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00054",
      "start_ms": 144650,
      "end_ms": 145595,
      "text": "一九六六年，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00055",
      "start_ms": 146160,
      "end_ms": 150245,
      "text": "残学小学刚毕业书就念到头了，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00056",
      "start_ms": 150730,
      "end_ms": 151795,
      "text": "那一年往后，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00057",
      "start_ms": 152190,
      "end_ms": 153815,
      "text": "他再也没进过学校的门，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00058",
      "start_ms": 154060,
      "end_ms": 154875,
      "text": "可他不认命，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00059",
      "start_ms": 155270,
      "end_ms": 156050,
      "text": "没学上，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00060",
      "start_ms": 156130,
      "end_ms": 157115,
      "text": "他就自己学。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00061",
      "start_ms": 157530,
      "end_ms": 158445,
      "text": "翻旧书，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00062",
      "start_ms": 158850,
      "end_ms": 160785,
      "text": "啃西方那些大师的作品，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00063",
      "start_ms": 161680,
      "end_ms": 162375,
      "text": "读哲学，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00064",
      "start_ms": 162870,
      "end_ms": 164815,
      "text": "一个小学文凭的姑娘，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00065",
      "start_ms": 165140,
      "end_ms": 166460,
      "text": "硬是靠着自学，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00066",
      "start_ms": 166800,
      "end_ms": 168240,
      "text": "把别人念一辈子，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00067",
      "start_ms": 168240,
      "end_ms": 169695,
      "text": "大学才能碰的东西，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00068",
      "start_ms": 170210,
      "end_ms": 171435,
      "text": "全都吃进了肚子。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00069",
      "start_ms": 171980,
      "end_ms": 174575,
      "text": "一个小学文凭的姑娘能干啥？"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00070",
      "start_ms": 175120,
      "end_ms": 178240,
      "text": "十七岁进街道工厂洗工，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00071",
      "start_ms": 178520,
      "end_ms": 182035,
      "text": "装配工车工一样一样干过来，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00072",
      "start_ms": 182480,
      "end_ms": 184095,
      "text": "手上一道道茧子，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00073",
      "start_ms": 184850,
      "end_ms": 186885,
      "text": "后来被挑去当赤脚医生。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00074",
      "start_ms": 187240,
      "end_ms": 189720,
      "text": "在长沙郊区给人扎针灸，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00075",
      "start_ms": 189740,
      "end_ms": 191805,
      "text": "背着篓子上山采草药，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00076",
      "start_ms": 192640,
      "end_ms": 195745,
      "text": "再往后还去代课教英语。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00077",
      "start_ms": 196210,
      "end_ms": 199595,
      "text": "一个小学毕业的人站上讲台教英语，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00078",
      "start_ms": 200220,
      "end_ms": 202370,
      "text": "你细品品这个，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00079",
      "start_ms": 202370,
      "end_ms": 203325,
      "text": "今天谁敢信？"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00080",
      "start_ms": 204390,
      "end_ms": 205845,
      "text": "可那个年月就是这样，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00081",
      "start_ms": 206310,
      "end_ms": 209465,
      "text": "有一双手就得顶上去，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00082",
      "start_ms": 210400,
      "end_ms": 211195,
      "text": "日子是苦，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00083",
      "start_ms": 212040,
      "end_ms": 215435,
      "text": "可这个人从来没低过头。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00084",
      "start_ms": 216540,
      "end_ms": 217620,
      "text": "一九七八年，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00085",
      "start_ms": 217940,
      "end_ms": 222955,
      "text": "她嫁了个刚从乡下回城的知青木匠出身。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00086",
      "start_ms": 225070,
      "end_ms": 226105,
      "text": "一九八零年，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00087",
      "start_ms": 226580,
      "end_ms": 227795,
      "text": "两口子一咬牙，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00088",
      "start_ms": 228090,
      "end_ms": 229030,
      "text": "从厂里出来，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00089",
      "start_ms": 229030,
      "end_ms": 230255,
      "text": "开了间裁缝铺，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00090",
      "start_ms": 231200,
      "end_ms": 233670,
      "text": "他手巧手艺好样子，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00091",
      "start_ms": 233670,
      "end_ms": 236315,
      "text": "新一干就是五年，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00092",
      "start_ms": 237200,
      "end_ms": 238995,
      "text": "生意越做越红火，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00093",
      "start_ms": 239760,
      "end_ms": 241605,
      "text": "白天给人量体裁衣，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00094",
      "start_ms": 241960,
      "end_ms": 244155,
      "text": "到了晚上收拾停当，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00095",
      "start_ms": 244890,
      "end_ms": 247595,
      "text": "他心里那团火越烧越旺，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00096",
      "start_ms": 248010,
      "end_ms": 251255,
      "text": "就这么一个在泥里滚了小半辈子的女人，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00097",
      "start_ms": 251560,
      "end_ms": 255265,
      "text": "您可能觉得这辈子也就这样了，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00098",
      "start_ms": 256370,
      "end_ms": 257675,
      "text": "可谁也没想到，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00099",
      "start_ms": 259020,
      "end_ms": 264045,
      "text": "真正要命的转折恰恰就出在这间裁缝铺上。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00100",
      "start_ms": 264670,
      "end_ms": 265835,
      "text": "三十岁那年，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00101",
      "start_ms": 266290,
      "end_ms": 269710,
      "text": "他干了一件让所有人都觉得他疯了的事。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00102",
      "start_ms": 269790,
      "end_ms": 271210,
      "text": "在一台缝纫机上，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00103",
      "start_ms": 271370,
      "end_ms": 272855,
      "text": "他开始写小说，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00104",
      "start_ms": 273360,
      "end_ms": 277465,
      "text": "一个裁缝写的还是那种谁都看不懂的怪东西。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00105",
      "start_ms": 277900,
      "end_ms": 278820,
      "text": "他写的是啥？"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00106",
      "start_ms": 279180,
      "end_ms": 284145,
      "text": "他凭什么能从一个裁缝一路写进世界文坛，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00107",
      "start_ms": 284510,
      "end_ms": 287850,
      "text": "让外国人抢着翻译下集？"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00108",
      "start_ms": 288090,
      "end_ms": 291475,
      "text": "咱接着讲这个裁缝铺里走出来的中国作家，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00109",
      "start_ms": 292470,
      "end_ms": 293690,
      "text": "想听下集的，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00110",
      "start_ms": 293810,
      "end_ms": 298415,
      "text": "先把关注点上觉得这故事扎心的点个赞，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00111",
      "start_ms": 299390,
      "end_ms": 301350,
      "text": "留个言说说，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00112",
      "start_ms": 301350,
      "end_ms": 304100,
      "text": "你身边有没有这样被埋没，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00113",
      "start_ms": 304240,
      "end_ms": 308770,
      "text": "还有上进心的人转发给家里爱看书的长辈，"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00114",
      "start_ms": 308850,
      "end_ms": 312395,
      "text": "让他们也认识认识这位了不起的中国作家。"
    },
    {
      "segment_id": "v_9cc06d12631d6884_s00115",
      "start_ms": 313090,
      "end_ms": 314365,
      "text": "咱们评论区见。"
    }
  ],
