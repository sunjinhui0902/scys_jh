      "start_ms": 153290,
      "end_ms": 158165,
      "text": "当时清华大学物理系是神仙打架的地方。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00049",
      "start_ms": 158600,
      "end_ms": 161715,
      "text": "叶启、孙吴有训等大师坐镇，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00050",
      "start_ms": 162090,
      "end_ms": 163825,
      "text": "录取率不足百分之五，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00051",
      "start_ms": 164340,
      "end_ms": 166400,
      "text": "可何则惠不仅考上了，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00052",
      "start_ms": 166440,
      "end_ms": 169235,
      "text": "还成了当年的女状元。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00053",
      "start_ms": 170450,
      "end_ms": 171745,
      "text": "可入学第一天，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00054",
      "start_ms": 172050,
      "end_ms": 173795,
      "text": "他就遭遇了性别偏见。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00055",
      "start_ms": 174820,
      "end_ms": 180355,
      "text": "系主任叶启孙直接劝他转兮物理太烧脑，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00056",
      "start_ms": 181250,
      "end_ms": 183155,
      "text": "女生根本学不出来，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00057",
      "start_ms": 183570,
      "end_ms": 185465,
      "text": "毕业也是浪费时间。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00058",
      "start_ms": 186450,
      "end_ms": 188625,
      "text": "这话要是放在别人身上，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00059",
      "start_ms": 188930,
      "end_ms": 190825,
      "text": "可能早就打了退堂鼓。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00060",
      "start_ms": 191250,
      "end_ms": 196945,
      "text": "可何则会偏不他找到叶启孙立夏军令状，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00061",
      "start_ms": 198810,
      "end_ms": 200235,
      "text": "您给我四年时间，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00062",
      "start_ms": 200900,
      "end_ms": 202160,
      "text": "我要是考不了，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00063",
      "start_ms": 202160,
      "end_ms": 202615,
      "text": "第一，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00064",
      "start_ms": 202990,
      "end_ms": 203995,
      "text": "自愿转系。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00065",
      "start_ms": 204760,
      "end_ms": 205795,
      "text": "接下来的日子，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00066",
      "start_ms": 206140,
      "end_ms": 208835,
      "text": "他把宿舍当成了第二个实验室。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00067",
      "start_ms": 209050,
      "end_ms": 210375,
      "text": "冬天没有暖气，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00068",
      "start_ms": 210780,
      "end_ms": 212905,
      "text": "他就裹着棉袄演算公式。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00069",
      "start_ms": 213380,
      "end_ms": 215055,
      "text": "夏天蚊虫叮咬，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00070",
      "start_ms": 215720,
      "end_ms": 217800,
      "text": "他就在桌上放盆肥皂水，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00071",
      "start_ms": 217900,
      "end_ms": 220620,
      "text": "继续看书前三强。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00072",
      "start_ms": 220640,
      "end_ms": 221415,
      "text": "后来回忆，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00073",
      "start_ms": 221970,
      "end_ms": 223485,
      "text": "每次去图书馆，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00074",
      "start_ms": 224050,
      "end_ms": 225995,
      "text": "总能看到何则惠的座位，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00075",
      "start_ms": 226430,
      "end_ms": 229085,
      "text": "他的笔记本记得比教科书还详细。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00076",
      "start_ms": 229860,
      "end_ms": 230545,
      "text": "四年后，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00077",
      "start_ms": 230820,
      "end_ms": 232895,
      "text": "合资会果然兑现了承诺，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00078",
      "start_ms": 233440,
      "end_ms": 235885,
      "text": "以全班第一的成绩毕业，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00079",
      "start_ms": 236290,
      "end_ms": 239215,
      "text": "把第二名的前三强都甩在了身后。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00080",
      "start_ms": 239940,
      "end_ms": 240740,
      "text": "可毕业后，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00081",
      "start_ms": 241060,
      "end_ms": 242460,
      "text": "新的难题又来了。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00082",
      "start_ms": 242860,
      "end_ms": 244860,
      "text": "南京军工署来招生，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00083",
      "start_ms": 245160,
      "end_ms": 246780,
      "text": "看中了全班男生，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00084",
      "start_ms": 246880,
      "end_ms": 249520,
      "text": "唯独把他这个第一名拒之门外。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00085",
      "start_ms": 249720,
      "end_ms": 250960,
      "text": "我们这里不要女的，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00086",
      "start_ms": 251320,
      "end_ms": 252940,
      "text": "你还是回家嫁人吧。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00087",
      "start_ms": 253960,
      "end_ms": 254600,
      "text": "那一刻，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00088",
      "start_ms": 254900,
      "end_ms": 259220,
      "text": "何则惠第一次感受到了性别歧视的沉重。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00089",
      "start_ms": 259880,
      "end_ms": 261080,
      "text": "但她没有抱怨，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00090",
      "start_ms": 261400,
      "end_ms": 263340,
      "text": "而是立刻做了一个决定，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00091",
      "start_ms": 263760,
      "end_ms": 267300,
      "text": "去国外学最顶尖的军工技术。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00092",
      "start_ms": 267880,
      "end_ms": 273310,
      "text": "他瞄准了德国柏林高等工业大学的实验弹道学专业。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00093",
      "start_ms": 273910,
      "end_ms": 277270,
      "text": "这个专业是军工领域的天花板，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00094",
      "start_ms": 277750,
      "end_ms": 278870,
      "text": "百年以来，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00095",
      "start_ms": 279110,
      "end_ms": 281090,
      "text": "从没收过外国学生，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00096",
      "start_ms": 281450,
      "end_ms": 284890,
      "text": "更别提女性第一次登门系主任。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00097",
      "start_ms": 284890,
      "end_ms": 286410,
      "text": "克兰茨就把他拒了，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00098",
      "start_ms": 286650,
      "end_ms": 289950,
      "text": "这不是女孩子该学的东西太危险了，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00099",
      "start_ms": 290390,
      "end_ms": 295630,
      "text": "何泽会没有放弃她每天都去教授办公室外等候，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00100",
      "start_ms": 296290,
      "end_ms": 298535,
      "text": "终于在第五天等到了机会。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00101",
      "start_ms": 299120,
      "end_ms": 303280,
      "text": "他拿出报纸上中国百姓遭日军屠杀的照片，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00102",
      "start_ms": 303660,
      "end_ms": 304840,
      "text": "红着眼眶问，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00103",
      "start_ms": 305740,
      "end_ms": 306220,
      "text": "教授，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00104",
      "start_ms": 307120,
      "end_ms": 308840,
      "text": "您曾在中国工作过，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00105",
      "start_ms": 309080,
      "end_ms": 310460,
      "text": "见过这样的苦难，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00106",
      "start_ms": 311020,
      "end_ms": 312860,
      "text": "如果您的国家被侵略，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00107",
      "start_ms": 313080,
      "end_ms": 315600,
      "text": "您会让自己的女儿放弃抵抗吗？"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00108",
      "start_ms": 316420,
      "end_ms": 318720,
      "text": "我学技术不是为了名利，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00109",
      "start_ms": 318820,
      "end_ms": 319980,
      "text": "是为了救国。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00110",
      "start_ms": 321240,
      "end_ms": 323380,
      "text": "克兰兹教授被深深打动，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00111",
      "start_ms": 323780,
      "end_ms": 327940,
      "text": "破例录取了他在德国的几年里，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00112",
      "start_ms": 328280,
      "end_ms": 330770,
      "text": "何则会成了最拼命的学生。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00113",
      "start_ms": 331730,
      "end_ms": 333050,
      "text": "别人练瞄准，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00114",
      "start_ms": 333110,
      "end_ms": 335750,
      "text": "练到手臂发酸就休息，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00115",
      "start_ms": 336390,
      "end_ms": 338190,
      "text": "他却坚持到握不住枪。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00116",
      "start_ms": 338670,
      "end_ms": 341070,
      "text": "别人觉得实验数据差不多就行，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00117",
      "start_ms": 341550,
      "end_ms": 343750,
      "text": "他却反复校验几十次。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00118",
      "start_ms": 344410,
      "end_ms": 345550,
      "text": "一九三九年，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00119",
      "start_ms": 345910,
      "end_ms": 347050,
      "text": "他的毕业论文，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00120",
      "start_ms": 347170,
      "end_ms": 350210,
      "text": "一种新的测量子弹、飞行速度方法，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00121",
      "start_ms": 350610,
      "end_ms": 352670,
      "text": "震惊了整个军工界。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00122",
      "start_ms": 353410,
      "end_ms": 356330,
      "text": "连德国军方都想聘请他，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00123",
      "start_ms": 356790,
      "end_ms": 359785,
      "text": "可他却一口拒绝我的技术，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00124",
      "start_ms": 360140,
      "end_ms": 361745,
      "text": "只为中国服务。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00125",
      "start_ms": 362520,
      "end_ms": 363415,
      "text": "就在这时，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00126",
      "start_ms": 363830,
      "end_ms": 367645,
      "text": "远在法国的前三强向他递来了求婚信。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00127",
      "start_ms": 368400,
      "end_ms": 372235,
      "text": "这位在侵华时就默默关注他的男生，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00128",
      "start_ms": 372990,
      "end_ms": 377195,
      "text": "此时已是居里实验室的核心研究员。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00129",
      "start_ms": 377870,
      "end_ms": 380165,
      "text": "他的求婚信只有二十五个字，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00130",
      "start_ms": 380510,
      "end_ms": 381985,
      "text": "却字字真诚，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00131",
      "start_ms": 382830,
      "end_ms": 383230,
      "text": "何则，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00132",
      "start_ms": 383230,
      "end_ms": 384805,
      "text": "会的回复更干脆，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00133",
      "start_ms": 385240,
      "end_ms": 387555,
      "text": "等我们见面后一同回国。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00134",
      "start_ms": 388380,
      "end_ms": 389325,
      "text": "一九四六年，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00135",
      "start_ms": 389740,
      "end_ms": 391115,
      "text": "两人在巴黎结婚，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00136",
      "start_ms": 391680,
      "end_ms": 394335,
      "text": "证婚人正是居里夫人的女儿。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00137",
      "start_ms": 394590,
      "end_ms": 397185,
      "text": "伊雷娜伊丽娜笑着说，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00138",
      "start_ms": 398150,
      "end_ms": 400530,
      "text": "你们俩都是核物理的天才，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00139",
      "start_ms": 400750,
      "end_ms": 402665,
      "text": "一定会创造奇迹。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00140",
      "start_ms": 403630,
      "end_ms": 404665,
      "text": "婚后的日子，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00141",
      "start_ms": 405110,
      "end_ms": 407305,
      "text": "他们把实验室当成了家。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00142",
      "start_ms": 408480,
      "end_ms": 410205,
      "text": "为了研究游河裂变，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00143",
      "start_ms": 410740,
      "end_ms": 413445,
      "text": "他们经常连续几天不睡觉，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00144",
      "start_ms": 414300,
      "end_ms": 417545,
      "text": "用显微镜一张一张检视底片。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00145",
      "start_ms": 418190,
      "end_ms": 424285,
      "text": "要知道油盒儿四分裂的概率比中彩票还低。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00146",
      "start_ms": 425280,
      "end_ms": 428545,
      "text": "很多科学家研究了一辈子都没发现，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00147",
      "start_ms": 429240,
      "end_ms": 435685,
      "text": "可何则会凭着鸡蛋里挑骨头的细致，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00148",
      "start_ms": 436230,
      "end_ms": 441545,
      "text": "硬是在成千上万张底片中找到了那个关键的痕迹。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00149",
      "start_ms": 442420,
      "end_ms": 443425,
      "text": "一九四七年，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00150",
      "start_ms": 443870,
      "end_ms": 445890,
      "text": "他们的研究成果发表后，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00151",
      "start_ms": 446050,
      "end_ms": 447665,
      "text": "西方科学界惊呼，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00152",
      "start_ms": 448480,
      "end_ms": 452055,
      "text": "中国的居里夫妇打开了核物理的新窗口。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00153",
      "start_ms": 452660,
      "end_ms": 455235,
      "text": "诺贝尔奖的邀请很快来了，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00154",
      "start_ms": 456210,
      "end_ms": 459665,
      "text": "可当得知需要加入外国国籍时，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00155",
      "start_ms": 460260,
      "end_ms": 460640,
      "text": "何则，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00156",
      "start_ms": 460640,
      "end_ms": 462495,
      "text": "惠想都没想就拒绝了。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00157",
      "start_ms": 463520,
      "end_ms": 464725,
      "text": "一九四八年，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00158",
      "start_ms": 465230,
      "end_ms": 470445,
      "text": "他和前三强抱着半岁的女儿踏上了回国的轮船。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00159",
      "start_ms": 471440,
      "end_ms": 472275,
      "text": "有人问他，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00160",
      "start_ms": 474220,
      "end_ms": 475675,
      "text": "国外条件那么好，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00161",
      "start_ms": 476210,
      "end_ms": 477805,
      "text": "你为什么非要回去？"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00162",
      "start_ms": 478830,
      "end_ms": 479510,
      "text": "他回答，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00163",
      "start_ms": 480790,
      "end_ms": 482250,
      "text": "科学没有国界，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00164",
      "start_ms": 482550,
      "end_ms": 484350,
      "text": "但科学家有祖国，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00165",
      "start_ms": 485450,
      "end_ms": 489310,
      "text": "可回国后的困境还是超出了他的想象。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00166",
      "start_ms": 490330,
      "end_ms": 491410,
      "text": "当时的中国，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00167",
      "start_ms": 491870,
      "end_ms": 494810,
      "text": "连一台像样的实验仪器都没有，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00168",
      "start_ms": 495710,
      "end_ms": 496190,
      "text": "何则，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00169",
      "start_ms": 496190,
      "end_ms": 497210,
      "text": "会没有抱怨，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00170",
      "start_ms": 497810,
      "end_ms": 500570,
      "text": "而是带着钱三强骑着自行车，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00171",
      "start_ms": 500990,
      "end_ms": 503490,
      "text": "跑遍了北京的旧货市场。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00172",
      "start_ms": 504070,
      "end_ms": 508165,
      "text": "旧五金、废电子馆生锈的零件。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00173",
      "start_ms": 508700,
      "end_ms": 510040,
      "text": "别人眼里的破烂，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00174",
      "start_ms": 510220,
      "end_ms": 511580,
      "text": "在他看来都是宝贝。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00175",
      "start_ms": 512400,
      "end_ms": 514080,
      "text": "他亲手画图纸，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00176",
      "start_ms": 514920,
      "end_ms": 515640,
      "text": "前三强，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00177",
      "start_ms": 515740,
      "end_ms": 516640,
      "text": "动手加工，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00178",
      "start_ms": 517080,
      "end_ms": 523720,
      "text": "硬是把这些破烂改成了实验设备，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00179",
      "start_ms": 524800,
      "end_ms": 526120,
      "text": "没有核乳胶。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00180",
      "start_ms": 526860,
      "end_ms": 528980,
      "text": "他就在暗室里守着红灯，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00181",
      "start_ms": 529340,
      "end_ms": 530660,
      "text": "握着玻璃脚棍，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00182",
      "start_ms": 530740,
      "end_ms": 532140,
      "text": "听节拍机搅拌，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00183",
      "start_ms": 532300,
      "end_ms": 534460,
      "text": "一练就是十几个小时，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00184",
      "start_ms": 535240,
      "end_ms": 536760,
      "text": "胳膊酸的抬不起来，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00185",
      "start_ms": 536760,
      "end_ms": 537580,
      "text": "也不休息。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00186",
      "start_ms": 538400,
      "end_ms": 539655,
      "text": "一、一九五九年，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00187",
      "start_ms": 540000,
      "end_ms": 541855,
      "text": "苏联撤走所有专家，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00188",
      "start_ms": 542280,
      "end_ms": 543725,
      "text": "带走了全部资料。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00189",
      "start_ms": 544640,
      "end_ms": 545380,
      "text": "还断言，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00190",
      "start_ms": 545460,
      "end_ms": 547925,
      "text": "中国二十年搞不出原子弹，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00191",
      "start_ms": 548480,
      "end_ms": 550725,
      "text": "何则会临危受命，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00192",
      "start_ms": 551210,
      "end_ms": 554535,
      "text": "负责暴风实验的数据采集。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00193",
      "start_ms": 555260,
      "end_ms": 557705,
      "text": "当时的实验室漏风漏雨，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00194",
      "start_ms": 558110,
      "end_ms": 561175,
      "text": "冬天温度低到零下十几度。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00195",
      "start_ms": 561820,
      "end_ms": 564745,
      "text": "他带着团队吃住在实验室，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00196",
      "start_ms": 565390,
      "end_ms": 566825,
      "text": "饿了啃口干粮，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00197",
      "start_ms": 567080,
      "end_ms": 567555,
      "text": "困难，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00198",
      "start_ms": 567880,
      "end_ms": 569335,
      "text": "趴在桌上眯一会儿。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00199",
      "start_ms": 569800,
      "end_ms": 571035,
      "text": "短短几个月，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00200",
      "start_ms": 571320,
      "end_ms": 573520,
      "text": "他们采集了十万组数据，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00201",
      "start_ms": 573600,
      "end_ms": 574725,
      "text": "没有一个差错。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00202",
      "start_ms": 575450,
      "end_ms": 577115,
      "text": "有人问他怎么做到的？"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00203",
      "start_ms": 577490,
      "end_ms": 578275,
      "text": "他笑着说，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00204",
      "start_ms": 578640,
      "end_ms": 579525,
      "text": "只要认真，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00205",
      "start_ms": 579890,
      "end_ms": 581185,
      "text": "就没有做不成的事。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00206",
      "start_ms": 582080,
      "end_ms": 583175,
      "text": "一九六四年，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00207",
      "start_ms": 583580,
      "end_ms": 586055,
      "text": "第一颗原子弹爆炸成功，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00208",
      "start_ms": 586530,
      "end_ms": 589895,
      "text": "一九六七年清淡紧随其后。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00209",
      "start_ms": 590340,
      "end_ms": 593290,
      "text": "中国用二年八个月的时间，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00210",
      "start_ms": 593510,
      "end_ms": 597275,
      "text": "实现了从原子弹到清淡的突破，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00211",
      "start_ms": 597760,
      "end_ms": 599555,
      "text": "创造了世界奇迹。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00212",
      "start_ms": 600150,
      "end_ms": 601250,
      "text": "而这背后，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00213",
      "start_ms": 601770,
      "end_ms": 609670,
      "text": "何泽会研发的点火中子源和破解的数据漏洞起到了关键作用。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00214",
      "start_ms": 610010,
      "end_ms": 611590,
      "text": "可他却从不鞠功，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00215",
      "start_ms": 612130,
      "end_ms": 612790,
      "text": "总是说，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00216",
      "start_ms": 613130,
      "end_ms": 615430,
      "text": "这是大家一起努力的结果，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00217",
      "start_ms": 615510,
      "end_ms": 617330,
      "text": "我只是做了该做的事。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00218",
      "start_ms": 618590,
      "end_ms": 619910,
      "text": "功成名就后，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00219",
      "start_ms": 620090,
      "end_ms": 623450,
      "text": "何则会依旧保持着质朴的生活。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00220",
      "start_ms": 624330,
      "end_ms": 626790,
      "text": "他把祖宅往师园捐给了国家。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00221",
      "start_ms": 627390,
      "end_ms": 629430,
      "text": "有人说这原子之上意，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00222",
      "start_ms": 630180,
      "end_ms": 631480,
      "text": "他却淡淡一笑，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00223",
      "start_ms": 632420,
      "end_ms": 633820,
      "text": "国家需要就好。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00224",
      "start_ms": 634740,
      "end_ms": 641340,
      "text": "他穿的衣服补丁罗补丁用的公文包是缝补过的，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00225",
      "start_ms": 641340,
      "end_ms": 642020,
      "text": "旧书包，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00226",
      "start_ms": 642940,
      "end_ms": 646700,
      "text": "连鞋子都是打了三层补丁的解放鞋。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00227",
      "start_ms": 647280,
      "end_ms": 648420,
      "text": "一九七八年，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00228",
      "start_ms": 648480,
      "end_ms": 650820,
      "text": "在菜市场被小贩呵斥时，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00229",
      "start_ms": 651240,
      "end_ms": 652260,
      "text": "他没有生气，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00230",
      "start_ms": 652740,
      "end_ms": 655480,
      "text": "只是笑着放下冬笋好好，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00231",
      "start_ms": 655940,
      "end_ms": 656620,
      "text": "我不碰。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00232",
      "start_ms": 656780,
      "end_ms": 658780,
      "text": "直到有人说出他的身份，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00233",
      "start_ms": 659120,
      "end_ms": 661215,
      "text": "小贩才吓了骂的连连道歉。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00234",
      "start_ms": 662270,
      "end_ms": 663575,
      "text": "后来有人问他，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00235",
      "start_ms": 664130,
      "end_ms": 666285,
      "text": "您为国家做了这么多贡献，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00236",
      "start_ms": 666780,
      "end_ms": 668495,
      "text": "为什么过得这么简朴？"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00237",
      "start_ms": 669450,
      "end_ms": 670065,
      "text": "他回答，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00238",
      "start_ms": 670560,
      "end_ms": 671735,
      "text": "居里夫人说过，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00239",
      "start_ms": 672110,
      "end_ms": 675025,
      "text": "科学研究需要的是艰苦奋斗，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00240",
      "start_ms": 675470,
      "end_ms": 676975,
      "text": "不是铺张浪费。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00241",
      "start_ms": 677600,
      "end_ms": 680565,
      "text": "我的钱要用来做更有用的事。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00242",
      "start_ms": 681350,
      "end_ms": 683320,
      "text": "他口中更有用的，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00243",
      "start_ms": 683320,
      "end_ms": 688085,
      "text": "是就是资助贫困学生和购买科研书籍。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00244",
      "start_ms": 688600,
      "end_ms": 692865,
      "text": "直到九十二岁摔伤前，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00245",
      "start_ms": 693220,
      "end_ms": 697020,
      "text": "他每天都准时去研究所上班。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00246",
      "start_ms": 697040,
      "end_ms": 698145,
      "text": "八、十六岁时，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00247",
      "start_ms": 698440,
      "end_ms": 701195,
      "text": "还在领导建立中子物理研究室，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00248",
      "start_ms": 701880,
      "end_ms": 702960,
      "text": "二零一一年，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00249",
      "start_ms": 703260,
      "end_ms": 705340,
      "text": "合泽会与世长辞，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00250",
      "start_ms": 705840,
      "end_ms": 707745,
      "text": "享年九十七岁。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00251",
      "start_ms": 708660,
      "end_ms": 709880,
      "text": "二零一七年，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00252",
      "start_ms": 710160,
      "end_ms": 716385,
      "text": "中国首颗空间x射线望远镜被命名为慧眼，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00253",
      "start_ms": 716910,
      "end_ms": 721025,
      "text": "以此纪念这位一生追寻真理的科学家。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00254",
      "start_ms": 721560,
      "end_ms": 724915,
      "text": "他用一生诠释了真正的富有，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00255",
      "start_ms": 725490,
      "end_ms": 726795,
      "text": "不是家财万贯，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00256",
      "start_ms": 727240,
      "end_ms": 729115,
      "text": "而是精神的充盈。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00257",
      "start_ms": 729620,
      "end_ms": 732975,
      "text": "真正的高贵不是地位显赫，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00258",
      "start_ms": 733620,
      "end_ms": 736005,
      "text": "而是为国为民的担当。"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00259",
      "start_ms": 736780,
      "end_ms": 737625,
      "text": "看到这里，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00260",
      "start_ms": 737940,
      "end_ms": 740540,
      "text": "如果你也被这样的何泽会打动，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00261",
      "start_ms": 740620,
      "end_ms": 742735,
      "text": "别忘了点赞、收藏、关注我，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00262",
      "start_ms": 743250,
      "end_ms": 746395,
      "text": "带你拆解更多被掩盖的历史人物，"
    },
    {
      "segment_id": "v_067c1c1d8aa6c49d_s00263",
      "start_ms": 747250,
      "end_ms": 751495,
      "text": "读懂他们藏在名气背后的真实人生。"
    }
  ],
