  "unit_index": 1,
  "unit_count": 1,
  "all_video_unit_ids": [
    "v_8a0ef669cfb1a547_u01"
  ],
  "duration_s": 472.583333,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "上集说到，朱可臻，用十年时间建起了中国自己的气象网络。一九三零年元旦发布了第一张全国天气预报。抗战爆发后，他抱着二十七箱仪器，一路撤退，炸弹在几百米外爆炸。他蹲在地上，祭数据头都不抬。可你知道吗？可在同一年，一九三六年，他还接了一个更烫手的山渝浙江大学校长。那时候的浙大经费紧缺，人心涣散，校长换了一茬又一茬，没人真心干事。朱可臻上任，先跑经费再定下两个字。当校训求是，他说只问是非，不计利害，大学不在大楼，在大师王淦昌、马一福这些名家都被他请了过来。他还留下了那句著名的哲大两问，你们到浙大来做什么，将来要做什么样的人？没安稳几年。抗战烽火就烧到了江南。为了保住读书的火种，朱可贞带着全校师生西迁两千六百多公里，路走了两年多，跨了四个省庙里上课，石板当桌，再苦再难，没停过一天课。这一路上，他的次子染病走了没过多久，妻子也操劳过度撒手人寰。短短几个月，丧子丧妻，他把眼泪往肚子里咽，转过身，依旧站在队伍最前面，带着浙大往前走。学生们后来回忆说，那段日子，竹校长的背好像更弯了，但脚步却从来没停过。就是在这样的逃难路上，王淦昌研究出了中微子探测方法，科研的火种从来没灭过他当了十三年。浙大校长把一所普通地方学校扮成了能跟顶尖学府比肩的强校，培养出了李政道。陈开甲，一个个国之栋梁。李政道后来拿了诺贝尔奖，程开甲成了两弹一星元勋。一九四九年，有人三次登门请他去台湾，他次次都回绝了，他要留在这片土地上，跟师生在一起，跟新中国在一起。新中国成立后，逐可臻已经年过花甲，可他依旧没歇着。他带着学生走遍全中国考察自然资源，从东北临海到青藏高原，从新疆戈壁到海南，榆林，哪里艰苦往哪里去，六十几岁的人了，跟着年轻人一起爬山。汤和水住帐篷，他随身带的还是那只温度计。每到一处，第一件事就是测气温记数据，学生们偷偷说，竹老的笔记本摞起来比镯子还高，上面的字迹工工整整数十年如一日。从一九三六年到一九七四年，整整三十八年，他每天早上起床，第一件事就是看云看风，看气温，然后记下来。今天几点刮风刮的什么风，几朵云什么形状，燕子什么时候飞来，桃花什么时候开，全在里面。你可能觉得这不就是个老头写天气日记吗？不是的这四百多万字的日记，后来成了中国近现代最完整的气候变化原始档案。科学家研究中国几十年的气候规律，物候变迁离不开这份记录。有研究人员说，逐可珍的日记就是中国半个世纪的天气底稿，他一个人用一支笔干了一个气象局几百人。该干的事更让人敬佩的是，到了晚年，他一头扎进了古籍里，从二十四史到几千部方制，他一点点梳理，硬是从浩如烟海的史料中找出了中国五千多年气候变迁的规律。一九七二年那篇中国近五千年来气候变迁的初步研究发表，震惊了全世界。从古代王朝兴衰，到今天，咱们治沙调水搞西部，建设很多决策的底气。都来自他当年的研究。一九七四年二月六日深夜，八十四岁的朱可臻躺在病床上，手指已经没有力气，握笔了却还在长子的搀扶下，颤抖着写完最后一行字，他喃喃自语哦，原来今天这么冷啊，这是他最后一次问天。第二天他走了，他这一辈子只做了一件事，让中国人知道自己头顶上的天到底是什么性格。有人问什么叫爱国？我想就是像朱可臻这样把一只温度计装进口袋，然后用了整整三十八年，把这件事做到底。他没有请史，没有绯闻，没有戏剧性的八卦，就是一个闷头干活，一辈子看云际风的老头。可我觉得这才是最了不起的地方。轰轰烈烈的人生很多人会过，但你见过几个人能把一件枯燥的事做三十八年，一天不断见过几个人在生命最后一天还在认真完成自己一辈子的功课，像朱可珍这样的人还有很多，他们干着惊天动地的事，做着隐姓埋名的人，不求名，不求利，就想让后世子孙能挺直腰杆做人。如果你想知道更多他们的故事，推荐你看看国之脊两这本书。书里记录了几十位为新中国立下汗马功劳的科学家和建设者。有我们熟悉的名字，也有像朱可珍这样被时光淡忘，却同样不该被遗忘的人。每一个名字背后都是一段拿命拼出来的传奇。读完你会明白，今天的安稳日子不是天上掉下来的，是有人用一辈子替我们扛下来的。点下方链接，把这本书带回家，自己读，也给孩子读，让我们的下一代知道谁才是真正该追的星。他用一只温度计量了三十八年，中国的天，一个倔老头做了一辈子该做的事。点赞是给他的掌声。转发是让更多人知道收藏是怕忘了今天的安稳从哪来关注我，咱们一起把该记住的人一个一个讲完。",
  "segments": [
    {
      "segment_id": "v_8a0ef669cfb1a547_s00001",
      "start_ms": 130,
      "end_ms": 930,
      "text": "上集说到，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00002",
      "start_ms": 1210,
      "end_ms": 1890,
      "text": "朱可臻，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00003",
      "start_ms": 2130,
      "end_ms": 5610,
      "text": "用十年时间建起了中国自己的气象网络。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00004",
      "start_ms": 5990,
      "end_ms": 10630,
      "text": "一九三零年元旦发布了第一张全国天气预报。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00005",
      "start_ms": 12030,
      "end_ms": 13150,
      "text": "抗战爆发后，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00006",
      "start_ms": 13670,
      "end_ms": 15650,
      "text": "他抱着二十七箱仪器，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00007",
      "start_ms": 15810,
      "end_ms": 16610,
      "text": "一路撤退，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00008",
      "start_ms": 17410,
      "end_ms": 20090,
      "text": "炸弹在几百米外爆炸。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00009",
      "start_ms": 20830,
      "end_ms": 22230,
      "text": "他蹲在地上，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00010",
      "start_ms": 22270,
      "end_ms": 24570,
      "text": "祭数据头都不抬。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00011",
      "start_ms": 25770,
      "end_ms": 26670,
      "text": "可你知道吗？"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00012",
      "start_ms": 28050,
      "end_ms": 29545,
      "text": "可在同一年，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00013",
      "start_ms": 31540,
      "end_ms": 32840,
      "text": "一九三六年，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00014",
      "start_ms": 33260,
      "end_ms": 37640,
      "text": "他还接了一个更烫手的山渝浙江大学校长。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00015",
      "start_ms": 38580,
      "end_ms": 41700,
      "text": "那时候的浙大经费紧缺，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00016",
      "start_ms": 42060,
      "end_ms": 43140,
      "text": "人心涣散，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00017",
      "start_ms": 43920,
      "end_ms": 46180,
      "text": "校长换了一茬又一茬，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00018",
      "start_ms": 46320,
      "end_ms": 47680,
      "text": "没人真心干事。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00019",
      "start_ms": 48680,
      "end_ms": 49720,
      "text": "朱可臻上任，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00020",
      "start_ms": 50140,
      "end_ms": 53000,
      "text": "先跑经费再定下两个字。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00021",
      "start_ms": 53120,
      "end_ms": 54800,
      "text": "当校训求是，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00022",
      "start_ms": 55640,
      "end_ms": 57980,
      "text": "他说只问是非，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00023",
      "start_ms": 58200,
      "end_ms": 59505,
      "text": "不计利害，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00024",
      "start_ms": 60080,
      "end_ms": 61220,
      "text": "大学不在大楼，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00025",
      "start_ms": 61440,
      "end_ms": 66825,
      "text": "在大师王淦昌、马一福这些名家都被他请了过来。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00026",
      "start_ms": 67560,
      "end_ms": 70315,
      "text": "他还留下了那句著名的哲大两问，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00027",
      "start_ms": 70870,
      "end_ms": 72375,
      "text": "你们到浙大来做什么，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00028",
      "start_ms": 72630,
      "end_ms": 73925,
      "text": "将来要做什么样的人？"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00029",
      "start_ms": 74650,
      "end_ms": 76030,
      "text": "没安稳几年。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00030",
      "start_ms": 76350,
      "end_ms": 78865,
      "text": "抗战烽火就烧到了江南。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00031",
      "start_ms": 80180,
      "end_ms": 82000,
      "text": "为了保住读书的火种，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00032",
      "start_ms": 82020,
      "end_ms": 86990,
      "text": "朱可贞带着全校师生西迁两千六百多公里，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00033",
      "start_ms": 86990,
      "end_ms": 88640,
      "text": "路走了两年多，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00034",
      "start_ms": 88920,
      "end_ms": 91250,
      "text": "跨了四个省庙里上课，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00035",
      "start_ms": 91630,
      "end_ms": 92550,
      "text": "石板当桌，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00036",
      "start_ms": 92930,
      "end_ms": 93995,
      "text": "再苦再难，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00037",
      "start_ms": 94350,
      "end_ms": 95775,
      "text": "没停过一天课。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00038",
      "start_ms": 96420,
      "end_ms": 97245,
      "text": "这一路上，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00039",
      "start_ms": 97630,
      "end_ms": 100730,
      "text": "他的次子染病走了没过多久，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00040",
      "start_ms": 101070,
      "end_ms": 104085,
      "text": "妻子也操劳过度撒手人寰。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00041",
      "start_ms": 104830,
      "end_ms": 105950,
      "text": "短短几个月，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00042",
      "start_ms": 106190,
      "end_ms": 107855,
      "text": "丧子丧妻，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00043",
      "start_ms": 108460,
      "end_ms": 110835,
      "text": "他把眼泪往肚子里咽，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00044",
      "start_ms": 112480,
      "end_ms": 113245,
      "text": "转过身，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00045",
      "start_ms": 113750,
      "end_ms": 115655,
      "text": "依旧站在队伍最前面，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00046",
      "start_ms": 116000,
      "end_ms": 117455,
      "text": "带着浙大往前走。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00047",
      "start_ms": 118340,
      "end_ms": 119720,
      "text": "学生们后来回忆说，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00048",
      "start_ms": 120120,
      "end_ms": 121020,
      "text": "那段日子，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00049",
      "start_ms": 121060,
      "end_ms": 123215,
      "text": "竹校长的背好像更弯了，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00050",
      "start_ms": 123870,
      "end_ms": 125955,
      "text": "但脚步却从来没停过。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00051",
      "start_ms": 126890,
      "end_ms": 128910,
      "text": "就是在这样的逃难路上，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00052",
      "start_ms": 129230,
      "end_ms": 132675,
      "text": "王淦昌研究出了中微子探测方法，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00053",
      "start_ms": 133190,
      "end_ms": 137280,
      "text": "科研的火种从来没灭过他当了十三年。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00054",
      "start_ms": 137380,
      "end_ms": 145255,
      "text": "浙大校长把一所普通地方学校扮成了能跟顶尖学府比肩的强校，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00055",
      "start_ms": 145710,
      "end_ms": 147065,
      "text": "培养出了李政道。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00056",
      "start_ms": 147860,
      "end_ms": 148580,
      "text": "陈开甲，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00057",
      "start_ms": 148600,
      "end_ms": 150225,
      "text": "一个个国之栋梁。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00058",
      "start_ms": 150740,
      "end_ms": 152595,
      "text": "李政道后来拿了诺贝尔奖，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00059",
      "start_ms": 153360,
      "end_ms": 155975,
      "text": "程开甲成了两弹一星元勋。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00060",
      "start_ms": 157000,
      "end_ms": 158105,
      "text": "一九四九年，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00061",
      "start_ms": 158620,
      "end_ms": 160960,
      "text": "有人三次登门请他去台湾，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00062",
      "start_ms": 161000,
      "end_ms": 162285,
      "text": "他次次都回绝了，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00063",
      "start_ms": 163180,
      "end_ms": 164600,
      "text": "他要留在这片土地上，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00064",
      "start_ms": 164860,
      "end_ms": 166135,
      "text": "跟师生在一起，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00065",
      "start_ms": 166420,
      "end_ms": 167805,
      "text": "跟新中国在一起。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00066",
      "start_ms": 168510,
      "end_ms": 169770,
      "text": "新中国成立后，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00067",
      "start_ms": 170070,
      "end_ms": 172545,
      "text": "逐可臻已经年过花甲，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00068",
      "start_ms": 172950,
      "end_ms": 174145,
      "text": "可他依旧没歇着。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00069",
      "start_ms": 174720,
      "end_ms": 178595,
      "text": "他带着学生走遍全中国考察自然资源，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00070",
      "start_ms": 179180,
      "end_ms": 182275,
      "text": "从东北临海到青藏高原，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00071",
      "start_ms": 182680,
      "end_ms": 184820,
      "text": "从新疆戈壁到海南，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00072",
      "start_ms": 185080,
      "end_ms": 185635,
      "text": "榆林，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00073",
      "start_ms": 185930,
      "end_ms": 187425,
      "text": "哪里艰苦往哪里去，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00074",
      "start_ms": 188190,
      "end_ms": 189525,
      "text": "六十几岁的人了，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00075",
      "start_ms": 189980,
      "end_ms": 192125,
      "text": "跟着年轻人一起爬山。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00076",
      "start_ms": 192520,
      "end_ms": 194345,
      "text": "汤和水住帐篷，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00077",
      "start_ms": 195270,
      "end_ms": 197810,
      "text": "他随身带的还是那只温度计。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00078",
      "start_ms": 197870,
      "end_ms": 198750,
      "text": "每到一处，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00079",
      "start_ms": 198970,
      "end_ms": 202195,
      "text": "第一件事就是测气温记数据，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00080",
      "start_ms": 202690,
      "end_ms": 203955,
      "text": "学生们偷偷说，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00081",
      "start_ms": 204370,
      "end_ms": 207230,
      "text": "竹老的笔记本摞起来比镯子还高，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00082",
      "start_ms": 207670,
      "end_ms": 212495,
      "text": "上面的字迹工工整整数十年如一日。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00083",
      "start_ms": 213130,
      "end_ms": 215515,
      "text": "从一九三六年到一九七四年，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00084",
      "start_ms": 215990,
      "end_ms": 217495,
      "text": "整整三十八年，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00085",
      "start_ms": 218270,
      "end_ms": 219955,
      "text": "他每天早上起床，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00086",
      "start_ms": 220310,
      "end_ms": 224055,
      "text": "第一件事就是看云看风，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00087",
      "start_ms": 224490,
      "end_ms": 225465,
      "text": "看气温，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00088",
      "start_ms": 226010,
      "end_ms": 227195,
      "text": "然后记下来。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00089",
      "start_ms": 228720,
      "end_ms": 231670,
      "text": "今天几点刮风刮的什么风，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00090",
      "start_ms": 232090,
      "end_ms": 233635,
      "text": "几朵云什么形状，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00091",
      "start_ms": 234120,
      "end_ms": 235560,
      "text": "燕子什么时候飞来，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00092",
      "start_ms": 235600,
      "end_ms": 236800,
      "text": "桃花什么时候开，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00093",
      "start_ms": 237080,
      "end_ms": 237885,
      "text": "全在里面。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00094",
      "start_ms": 238370,
      "end_ms": 241715,
      "text": "你可能觉得这不就是个老头写天气日记吗？"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00095",
      "start_ms": 242010,
      "end_ms": 245185,
      "text": "不是的这四百多万字的日记，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00096",
      "start_ms": 245530,
      "end_ms": 251825,
      "text": "后来成了中国近现代最完整的气候变化原始档案。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00097",
      "start_ms": 252330,
      "end_ms": 255805,
      "text": "科学家研究中国几十年的气候规律，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00098",
      "start_ms": 256120,
      "end_ms": 258865,
      "text": "物候变迁离不开这份记录。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00099",
      "start_ms": 259360,
      "end_ms": 260635,
      "text": "有研究人员说，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00100",
      "start_ms": 261040,
      "end_ms": 265435,
      "text": "逐可珍的日记就是中国半个世纪的天气底稿，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00101",
      "start_ms": 265880,
      "end_ms": 270270,
      "text": "他一个人用一支笔干了一个气象局几百人。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00102",
      "start_ms": 270310,
      "end_ms": 272775,
      "text": "该干的事更让人敬佩的是，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00103",
      "start_ms": 273120,
      "end_ms": 273920,
      "text": "到了晚年，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00104",
      "start_ms": 274260,
      "end_ms": 276365,
      "text": "他一头扎进了古籍里，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00105",
      "start_ms": 277150,
      "end_ms": 279965,
      "text": "从二十四史到几千部方制，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00106",
      "start_ms": 280350,
      "end_ms": 281705,
      "text": "他一点点梳理，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00107",
      "start_ms": 282490,
      "end_ms": 289625,
      "text": "硬是从浩如烟海的史料中找出了中国五千多年气候变迁的规律。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00108",
      "start_ms": 290570,
      "end_ms": 295855,
      "text": "一九七二年那篇中国近五千年来气候变迁的初步研究发表，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00109",
      "start_ms": 296310,
      "end_ms": 297485,
      "text": "震惊了全世界。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00110",
      "start_ms": 298310,
      "end_ms": 300030,
      "text": "从古代王朝兴衰，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00111",
      "start_ms": 300170,
      "end_ms": 300850,
      "text": "到今天，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00112",
      "start_ms": 300890,
      "end_ms": 303350,
      "text": "咱们治沙调水搞西部，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00113",
      "start_ms": 303350,
      "end_ms": 305685,
      "text": "建设很多决策的底气。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00114",
      "start_ms": 306150,
      "end_ms": 307790,
      "text": "都来自他当年的研究。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00115",
      "start_ms": 307970,
      "end_ms": 310430,
      "text": "一九七四年二月六日深夜，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00116",
      "start_ms": 310750,
      "end_ms": 314009,
      "text": "八十四岁的朱可臻躺在病床上，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00117",
      "start_ms": 314550,
      "end_ms": 316130,
      "text": "手指已经没有力气，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00118",
      "start_ms": 316130,
      "end_ms": 319270,
      "text": "握笔了却还在长子的搀扶下，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00119",
      "start_ms": 319750,
      "end_ms": 322330,
      "text": "颤抖着写完最后一行字，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00120",
      "start_ms": 322810,
      "end_ms": 324430,
      "text": "他喃喃自语哦，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00121",
      "start_ms": 324790,
      "end_ms": 326390,
      "text": "原来今天这么冷啊，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00122",
      "start_ms": 327330,
      "end_ms": 329150,
      "text": "这是他最后一次问天。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00123",
      "start_ms": 330230,
      "end_ms": 332450,
      "text": "第二天他走了，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00124",
      "start_ms": 333430,
      "end_ms": 337140,
      "text": "他这一辈子只做了一件事，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00125",
      "start_ms": 338280,
      "end_ms": 343500,
      "text": "让中国人知道自己头顶上的天到底是什么性格。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00126",
      "start_ms": 344720,
      "end_ms": 346600,
      "text": "有人问什么叫爱国？"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00127",
      "start_ms": 346880,
      "end_ms": 351520,
      "text": "我想就是像朱可臻这样把一只温度计装进口袋，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00128",
      "start_ms": 351820,
      "end_ms": 354260,
      "text": "然后用了整整三十八年，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00129",
      "start_ms": 354560,
      "end_ms": 356000,
      "text": "把这件事做到底。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00130",
      "start_ms": 356600,
      "end_ms": 357860,
      "text": "他没有请史，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00131",
      "start_ms": 358200,
      "end_ms": 359120,
      "text": "没有绯闻，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00132",
      "start_ms": 359480,
      "end_ms": 361080,
      "text": "没有戏剧性的八卦，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00133",
      "start_ms": 361580,
      "end_ms": 363600,
      "text": "就是一个闷头干活，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00134",
      "start_ms": 363800,
      "end_ms": 365725,
      "text": "一辈子看云际风的老头。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00135",
      "start_ms": 366300,
      "end_ms": 369305,
      "text": "可我觉得这才是最了不起的地方。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00136",
      "start_ms": 369830,
      "end_ms": 372355,
      "text": "轰轰烈烈的人生很多人会过，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00137",
      "start_ms": 372770,
      "end_ms": 376350,
      "text": "但你见过几个人能把一件枯燥的事做三十八年，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00138",
      "start_ms": 376350,
      "end_ms": 383810,
      "text": "一天不断见过几个人在生命最后一天还在认真完成自己一辈子的功课，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00139",
      "start_ms": 384030,
      "end_ms": 386645,
      "text": "像朱可珍这样的人还有很多，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00140",
      "start_ms": 387190,
      "end_ms": 389515,
      "text": "他们干着惊天动地的事，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00141",
      "start_ms": 389880,
      "end_ms": 391805,
      "text": "做着隐姓埋名的人，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00142",
      "start_ms": 392420,
      "end_ms": 393140,
      "text": "不求名，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00143",
      "start_ms": 393160,
      "end_ms": 393935,
      "text": "不求利，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00144",
      "start_ms": 394250,
      "end_ms": 398675,
      "text": "就想让后世子孙能挺直腰杆做人。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00145",
      "start_ms": 399480,
      "end_ms": 401955,
      "text": "如果你想知道更多他们的故事，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00146",
      "start_ms": 402530,
      "end_ms": 404975,
      "text": "推荐你看看国之脊两这本书。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00147",
      "start_ms": 405840,
      "end_ms": 411995,
      "text": "书里记录了几十位为新中国立下汗马功劳的科学家和建设者。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00148",
      "start_ms": 412560,
      "end_ms": 414175,
      "text": "有我们熟悉的名字，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00149",
      "start_ms": 414600,
      "end_ms": 417785,
      "text": "也有像朱可珍这样被时光淡忘，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00150",
      "start_ms": 418180,
      "end_ms": 420315,
      "text": "却同样不该被遗忘的人。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00151",
      "start_ms": 420990,
      "end_ms": 425725,
      "text": "每一个名字背后都是一段拿命拼出来的传奇。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00152",
      "start_ms": 426130,
      "end_ms": 427215,
      "text": "读完你会明白，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00153",
      "start_ms": 428260,
      "end_ms": 431785,
      "text": "今天的安稳日子不是天上掉下来的，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00154",
      "start_ms": 432270,
      "end_ms": 435625,
      "text": "是有人用一辈子替我们扛下来的。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00155",
      "start_ms": 437530,
      "end_ms": 438775,
      "text": "点下方链接，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00156",
      "start_ms": 439230,
      "end_ms": 441075,
      "text": "把这本书带回家，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00157",
      "start_ms": 441400,
      "end_ms": 442060,
      "text": "自己读，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00158",
      "start_ms": 442460,
      "end_ms": 443575,
      "text": "也给孩子读，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00159",
      "start_ms": 444110,
      "end_ms": 448845,
      "text": "让我们的下一代知道谁才是真正该追的星。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00160",
      "start_ms": 449570,
      "end_ms": 452450,
      "text": "他用一只温度计量了三十八年，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00161",
      "start_ms": 452450,
      "end_ms": 453195,
      "text": "中国的天，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00162",
      "start_ms": 453880,
      "end_ms": 457535,
      "text": "一个倔老头做了一辈子该做的事。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00163",
      "start_ms": 458610,
      "end_ms": 460795,
      "text": "点赞是给他的掌声。"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00164",
      "start_ms": 461150,
      "end_ms": 468725,
      "text": "转发是让更多人知道收藏是怕忘了今天的安稳从哪来关注我，"
    },
    {
      "segment_id": "v_8a0ef669cfb1a547_s00165",
      "start_ms": 468960,
      "end_ms": 472475,
      "text": "咱们一起把该记住的人一个一个讲完。"
    }
  ],
  "previous_context": [],
  "following_context": [],
