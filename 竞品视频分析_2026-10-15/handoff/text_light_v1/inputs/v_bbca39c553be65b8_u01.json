  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "人一定要和见得了自己好的人在一起，和有情有义的人在一起，和彼此尊重的人在一起，和心疼你的人在一起，和喜欢的人在一起，是大补和快乐的人在一起，是养生和善良的人在一起，是养寿。和优雅的人在一起，是养德。因为人这一辈子啊，相处靠的一定不是技巧，而是真诚、善良和彼此的仰望。他们不会在你低谷时转生，更不会在你高光时失衡。你看，这份双向的真诚，才是人这一生最值得奔赴的关系。",
  "segments": [
    {
      "segment_id": "v_bbca39c553be65b8_s00001",
      "start_ms": 190,
      "end_ms": 2610,
      "text": "人一定要和见得了自己好的人在一起，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00002",
      "start_ms": 2850,
      "end_ms": 4710,
      "text": "和有情有义的人在一起，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00003",
      "start_ms": 5190,
      "end_ms": 6930,
      "text": "和彼此尊重的人在一起，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00004",
      "start_ms": 7210,
      "end_ms": 8950,
      "text": "和心疼你的人在一起，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00005",
      "start_ms": 9710,
      "end_ms": 11050,
      "text": "和喜欢的人在一起，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00006",
      "start_ms": 11150,
      "end_ms": 13510,
      "text": "是大补和快乐的人在一起，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00007",
      "start_ms": 13630,
      "end_ms": 16070,
      "text": "是养生和善良的人在一起，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00008",
      "start_ms": 16070,
      "end_ms": 16670,
      "text": "是养寿。"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00009",
      "start_ms": 17030,
      "end_ms": 18530,
      "text": "和优雅的人在一起，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00010",
      "start_ms": 18930,
      "end_ms": 19670,
      "text": "是养德。"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00011",
      "start_ms": 20610,
      "end_ms": 21870,
      "text": "因为人这一辈子啊，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00012",
      "start_ms": 21870,
      "end_ms": 23970,
      "text": "相处靠的一定不是技巧，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00013",
      "start_ms": 24250,
      "end_ms": 27390,
      "text": "而是真诚、善良和彼此的仰望。"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00014",
      "start_ms": 28110,
      "end_ms": 29815,
      "text": "他们不会在你低谷时转生，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00015",
      "start_ms": 30220,
      "end_ms": 32000,
      "text": "更不会在你高光时失衡。"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00016",
      "start_ms": 32280,
      "end_ms": 32660,
      "text": "你看，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00017",
      "start_ms": 32880,
      "end_ms": 34080,
      "text": "这份双向的真诚，"
    },
    {
      "segment_id": "v_bbca39c553be65b8_s00018",
      "start_ms": 34380,
      "end_ms": 37625,
      "text": "才是人这一生最值得奔赴的关系。"
    }
  ],
