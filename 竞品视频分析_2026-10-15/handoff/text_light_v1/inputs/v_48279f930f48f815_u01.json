    {
      "segment_id": "v_48279f930f48f815_s00007",
      "start_ms": 14450,
      "end_ms": 15510,
      "text": "是妈妈的身体，"
    },
    {
      "segment_id": "v_48279f930f48f815_s00008",
      "start_ms": 15990,
      "end_ms": 18690,
      "text": "喝过最贵的水是妈妈的乳汁。"
    },
    {
      "segment_id": "v_48279f930f48f815_s00009",
      "start_ms": 19310,
      "end_ms": 22710,
      "text": "因为过最温暖的港湾是妈妈的怀抱。"
    },
    {
      "segment_id": "v_48279f930f48f815_s00010",
      "start_ms": 23370,
      "end_ms": 25850,
      "text": "其实啊也并不是说爸爸天生绝情，"
    },
    {
      "segment_id": "v_48279f930f48f815_s00011",
      "start_ms": 25850,
      "end_ms": 26650,
      "text": "不爱孩子，"
    },
    {
      "segment_id": "v_48279f930f48f815_s00012",
      "start_ms": 27210,
      "end_ms": 28030,
      "text": "只是他的爱，"
    },
    {
      "segment_id": "v_48279f930f48f815_s00013",
      "start_ms": 28230,
      "end_ms": 32120,
      "text": "更多的需要妈妈在中间搭建桥才能够落到实处。"
