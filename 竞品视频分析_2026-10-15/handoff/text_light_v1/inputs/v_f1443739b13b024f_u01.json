  "source_title": "钱三强 原子弹爆炸那天，他被下放到农村\n#钱三强#国之脊梁#读书感悟 #文字共鸣\n#情感共鸣 #历史名人 #励志",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
