  "duration_s": 50.4,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "发信息要经得起被截图，说话要经得起被录音，翻脸要经得起翻旧账，借钱要经得起不还，聚会要经得起被偷拍，站队，要经得起被清算，绝交要经得起被出卖，背后吐槽要经得起当面对峙。记住了，永远不要和任何人说太多的话。人聊天是为了获取信息，不是倾诉交底，更不是掏心掏肺课制自己的表达欲平静、温和微笑就行，不自卑，也不炫耀，守住嘴，就守住了自己的能量场。事以密成言，以懈怠少言为贵，言多必失，你的嘴，就是你最好的风水。不知道。",
  "segments": [
    {
      "segment_id": "v_f692e799abad97b4_s00001",
      "start_ms": 250,
      "end_ms": 2310,
      "text": "发信息要经得起被截图，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00002",
      "start_ms": 2790,
      "end_ms": 4590,
      "text": "说话要经得起被录音，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00003",
      "start_ms": 5010,
      "end_ms": 6690,
      "text": "翻脸要经得起翻旧账，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00004",
      "start_ms": 6990,
      "end_ms": 9010,
      "text": "借钱要经得起不还，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00005",
      "start_ms": 9670,
      "end_ms": 11530,
      "text": "聚会要经得起被偷拍，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00006",
      "start_ms": 11850,
      "end_ms": 12370,
      "text": "站队，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00007",
      "start_ms": 12590,
      "end_ms": 14290,
      "text": "要经得起被清算，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00008",
      "start_ms": 14810,
      "end_ms": 16430,
      "text": "绝交要经得起被出卖，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00009",
      "start_ms": 16790,
      "end_ms": 19970,
      "text": "背后吐槽要经得起当面对峙。"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00010",
      "start_ms": 20650,
      "end_ms": 21290,
      "text": "记住了，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00011",
      "start_ms": 21310,
      "end_ms": 23790,
      "text": "永远不要和任何人说太多的话。"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00012",
      "start_ms": 24030,
      "end_ms": 25710,
      "text": "人聊天是为了获取信息，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00013",
      "start_ms": 25950,
      "end_ms": 27150,
      "text": "不是倾诉交底，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00014",
      "start_ms": 27510,
      "end_ms": 33080,
      "text": "更不是掏心掏肺课制自己的表达欲平静、温和微笑就行，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00015",
      "start_ms": 33240,
      "end_ms": 33840,
      "text": "不自卑，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00016",
      "start_ms": 34100,
      "end_ms": 34980,
      "text": "也不炫耀，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00017",
      "start_ms": 35300,
      "end_ms": 35920,
      "text": "守住嘴，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00018",
      "start_ms": 36160,
      "end_ms": 37660,
      "text": "就守住了自己的能量场。"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00019",
      "start_ms": 37720,
      "end_ms": 39320,
      "text": "事以密成言，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00020",
      "start_ms": 39700,
      "end_ms": 41580,
      "text": "以懈怠少言为贵，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00021",
      "start_ms": 41580,
      "end_ms": 42980,
      "text": "言多必失，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00022",
      "start_ms": 43020,
      "end_ms": 43920,
      "text": "你的嘴，"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00023",
      "start_ms": 43920,
      "end_ms": 46620,
      "text": "就是你最好的风水。"
    },
    {
      "segment_id": "v_f692e799abad97b4_s00024",
      "start_ms": 46620,
      "end_ms": 48060,
      "text": "不知道。"
    }
  ],
