  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "朋友，人世间，所有的缘分里，最难得的是，没有血缘关系，却依旧愿意疼你爱你，善待你的人。亲情是生来就有的羁绊，可这份无关血脉的真心，是命运额外的馈赠，不沾亲情的纽带，却依旧愿意向你释放善意，全心付出。这份难得的相遇，使得我们珍惜一辈子。一字。",
  "segments": [
    {
      "segment_id": "v_d31709868d45e41a_s00001",
      "start_ms": 130,
      "end_ms": 530,
      "text": "朋友，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00002",
      "start_ms": 890,
      "end_ms": 1450,
      "text": "人世间，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00003",
      "start_ms": 1450,
      "end_ms": 2610,
      "text": "所有的缘分里，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00004",
      "start_ms": 2710,
      "end_ms": 4310,
      "text": "最难得的是，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00005",
      "start_ms": 4310,
      "end_ms": 5370,
      "text": "没有血缘关系，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00006",
      "start_ms": 5690,
      "end_ms": 7870,
      "text": "却依旧愿意疼你爱你，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00007",
      "start_ms": 8370,
      "end_ms": 9490,
      "text": "善待你的人。"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00008",
      "start_ms": 10450,
      "end_ms": 12250,
      "text": "亲情是生来就有的羁绊，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00009",
      "start_ms": 12750,
      "end_ms": 14450,
      "text": "可这份无关血脉的真心，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00010",
      "start_ms": 14970,
      "end_ms": 17210,
      "text": "是命运额外的馈赠，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00011",
      "start_ms": 18090,
      "end_ms": 19430,
      "text": "不沾亲情的纽带，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00012",
      "start_ms": 19930,
      "end_ms": 22410,
      "text": "却依旧愿意向你释放善意，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00013",
      "start_ms": 22930,
      "end_ms": 23970,
      "text": "全心付出。"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00014",
      "start_ms": 25250,
      "end_ms": 26730,
      "text": "这份难得的相遇，"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00015",
      "start_ms": 27410,
      "end_ms": 30000,
      "text": "使得我们珍惜一辈子。"
    },
    {
      "segment_id": "v_d31709868d45e41a_s00016",
      "start_ms": 30040,
      "end_ms": 30455,
      "text": "一字。"
    }
  ],
