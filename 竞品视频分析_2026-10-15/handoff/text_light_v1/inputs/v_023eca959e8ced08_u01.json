      "start_ms": 58780,
      "end_ms": 61965,
      "text": "你就进入了地球上汇聚全市的顶级中枢，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00027",
      "start_ms": 62330,
      "end_ms": 64165,
      "text": "左手白宫、右手华尔街，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00028",
      "start_ms": 64520,
      "end_ms": 66680,
      "text": "这就是你在哈佛大学每天要走的门，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00029",
      "start_ms": 66840,
      "end_ms": 67545,
      "text": "智慧门，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00030",
      "start_ms": 67820,
      "end_ms": 70180,
      "text": "你看哈佛门口挂着一个猪头，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00031",
      "start_ms": 70480,
      "end_ms": 71060,
      "text": "啥意思？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00032",
      "start_ms": 71160,
      "end_ms": 72505,
      "text": "猪来了都会有智慧吗？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00033",
      "start_ms": 73020,
      "end_ms": 75100,
      "text": "哈佛光图书馆就有七十多座，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00034",
      "start_ms": 75100,
      "end_ms": 76695,
      "text": "有十二个本科宿舍楼，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00035",
      "start_ms": 76980,
      "end_ms": 78515,
      "text": "每一栋楼都有自己的徽章。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00036",
      "start_ms": 78810,
      "end_ms": 83740,
      "text": "这里培养的是美国东部最老牌最老钱的一群人从这里走出去的你，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00037",
      "start_ms": 83820,
      "end_ms": 85675,
      "text": "手里拿的不仅仅是一张文凭，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00038",
      "start_ms": 85930,
      "end_ms": 87885,
      "text": "而是一柄执掌时代的权杖。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00039",
      "start_ms": 88340,
      "end_ms": 89835,
      "text": "哈佛校训只有一个词，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00040",
      "start_ms": 90240,
      "end_ms": 90740,
      "text": "真理，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00041",
      "start_ms": 91350,
      "end_ms": 91950,
      "text": "你知道吗？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00042",
      "start_ms": 91950,
      "end_ms": 92710,
      "text": "在一年以前，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00043",
      "start_ms": 92730,
      "end_ms": 95845,
      "text": "哈佛曾经被强制要求停止接收国际留学生，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00044",
      "start_ms": 96050,
      "end_ms": 97590,
      "text": "并且要求他们全部转学。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00045",
      "start_ms": 97730,
      "end_ms": 98095,
      "text": "但是，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00046",
      "start_ms": 98400,
      "end_ms": 99900,
      "text": "哈佛打响了不自由，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00047",
      "start_ms": 99900,
      "end_ms": 101055,
      "text": "勿宁死的第一枪，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00048",
      "start_ms": 101370,
      "end_ms": 103695,
      "text": "郑重拒绝当局一系列非法要求。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00049",
      "start_ms": 104010,
      "end_ms": 104650,
      "text": "结果当天，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00050",
      "start_ms": 104770,
      "end_ms": 106655,
      "text": "哈佛的拨款就被全部冻结，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00051",
      "start_ms": 107230,
      "end_ms": 109030,
      "text": "大量校友自愿捐款，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00052",
      "start_ms": 109130,
      "end_ms": 110875,
      "text": "教授自愿降低薪资，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00053",
      "start_ms": 111140,
      "end_ms": 114115,
      "text": "只为捍卫每一个年轻人平等接受教育的权利。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00054",
      "start_ms": 114640,
      "end_ms": 116235,
      "text": "究竟何谓大学？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00055",
      "start_ms": 116580,
      "end_ms": 117395,
      "text": "人类先锋？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00056",
      "start_ms": 117910,
      "end_ms": 118710,
      "text": "从去年开始，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00057",
      "start_ms": 118710,
      "end_ms": 122255,
      "text": "哈佛大学就在官网上放出了超过一百五十门顶级课程，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00058",
      "start_ms": 122540,
      "end_ms": 124645,
      "text": "全部零门槛全球开放。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00059",
      "start_ms": 125360,
      "end_ms": 126920,
      "text": "这是哈佛著名的铜像，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00060",
      "start_ms": 127040,
      "end_ms": 128280,
      "text": "他叫约翰哈佛，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00061",
      "start_ms": 128360,
      "end_ms": 129515,
      "text": "一个屠夫的儿子，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00062",
      "start_ms": 129770,
      "end_ms": 132465,
      "text": "一个在伦敦酒馆里擦桌子长大的孤儿，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00063",
      "start_ms": 132790,
      "end_ms": 134645,
      "text": "甚至没来得及活到三十二岁。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00064",
      "start_ms": 134950,
      "end_ms": 138370,
      "text": "他在临终前将财产和藏书捐赠给了一座新学校。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00065",
      "start_ms": 138510,
      "end_ms": 140025,
      "text": "这就是后来的哈佛大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00066",
      "start_ms": 140430,
      "end_ms": 142595,
      "text": "它同向左脚已经被摸得锃亮，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00067",
      "start_ms": 142900,
      "end_ms": 147240,
      "text": "因为全世界各地的人们相信看到他就能感受到知识，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00068",
      "start_ms": 147370,
      "end_ms": 148515,
      "text": "可以改变命运。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00069",
      "start_ms": 149120,
      "end_ms": 149535,
      "text": "第二，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00070",
      "start_ms": 149670,
      "end_ms": 152695,
      "text": "哥伦比亚大学录取中国学生最多的成效。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00071",
      "start_ms": 152970,
      "end_ms": 162040,
      "text": "二零二五年一共录取了中国学生六千三百七十二人我这几天在各大上课发现这里中文要比英文还要亲切朱晶。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00072",
      "start_ms": 162340,
      "end_ms": 164420,
      "text": "今天你的母校是哥伦比亚大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00073",
      "start_ms": 164440,
      "end_ms": 167105,
      "text": "你就登上了全球话语权的绝对高地。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00074",
      "start_ms": 167450,
      "end_ms": 168730,
      "text": "左手普利策右手，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00075",
      "start_ms": 168730,
      "end_ms": 170440,
      "text": "联合国窗外是华尔街，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00076",
      "start_ms": 170460,
      "end_ms": 171535,
      "text": "手里是柏拉图。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00077",
      "start_ms": 171940,
      "end_ms": 174225,
      "text": "你的校友有一百零位获得了诺奖，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00078",
      "start_ms": 174480,
      "end_ms": 175445,
      "text": "下一个就是你。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00079",
      "start_ms": 175760,
      "end_ms": 178380,
      "text": "它是北美第一个实现原子核裂变的地方，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00080",
      "start_ms": 178440,
      "end_ms": 180245,
      "text": "是曼哈顿计划的诞生地。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00081",
      "start_ms": 180520,
      "end_ms": 182940,
      "text": "而全球新闻界最高奖项普利策奖，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00082",
      "start_ms": 182940,
      "end_ms": 184424,
      "text": "每一年都在各大颁发，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00083",
      "start_ms": 184810,
      "end_ms": 186945,
      "text": "这里培养了二十九位奥斯卡得主。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00084",
      "start_ms": 187250,
      "end_ms": 189530,
      "text": "你的学长学姐们一边造原子弹，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00085",
      "start_ms": 189530,
      "end_ms": 190525,
      "text": "一边拿奥斯卡，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00086",
      "start_ms": 190930,
      "end_ms": 191630,
      "text": "而你知道吗？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00087",
      "start_ms": 191630,
      "end_ms": 194725,
      "text": "中国近代史的半壁江山都在各大读过书。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00088",
      "start_ms": 195040,
      "end_ms": 204870,
      "text": "三位北大校长胡适、蒋梦琳、马云初、南开大学创始人张柏霖、侯氏质检法、发明人、侯德榜、原子弹之母、吴建雄等等。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00089",
      "start_ms": 204910,
      "end_ms": 206165,
      "text": "群星闪耀时，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00090",
      "start_ms": 206740,
      "end_ms": 210115,
      "text": "你看哥大的这尊铜像里藏着一只猫头鹰，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00091",
      "start_ms": 210370,
      "end_ms": 212655,
      "text": "据说谁先找到他就是最聪明的人，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00092",
      "start_ms": 212930,
      "end_ms": 214355,
      "text": "你看到那只猫头鹰了吗？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00093",
      "start_ms": 214720,
      "end_ms": 216820,
      "text": "今天在各大厅弗兰克教授讲课，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00094",
      "start_ms": 217080,
      "end_ms": 219895,
      "text": "没想到这么朴素的老爷子也是诺贝尔奖得主，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00095",
      "start_ms": 220260,
      "end_ms": 222055,
      "text": "很羡慕在这里上学的同学们，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00096",
      "start_ms": 222460,
      "end_ms": 224715,
      "text": "环境才是人生最大的奢侈品。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00097",
      "start_ms": 225360,
      "end_ms": 225780,
      "text": "第三，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00098",
      "start_ms": 225840,
      "end_ms": 227650,
      "text": "宾夕法尼亚大学诞生，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00099",
      "start_ms": 227670,
      "end_ms": 232255,
      "text": "亿万富翁最多的学校从这里走出了巴菲特、马斯克、特朗普。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00100",
      "start_ms": 232730,
      "end_ms": 234055,
      "text": "也许你没有来过冰大，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00101",
      "start_ms": 234210,
      "end_ms": 236730,
      "text": "但是你一定见过一百美元上的美国国父，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00102",
      "start_ms": 236850,
      "end_ms": 239015,
      "text": "他就是宾夕法尼亚大学的创办人。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00103",
      "start_ms": 239240,
      "end_ms": 242415,
      "text": "富兰克林冰大绝对是美国最务实的大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00104",
      "start_ms": 242670,
      "end_ms": 246035,
      "text": "当其他的学校还沉浸在古典学和神学的世界里。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00105",
      "start_ms": 246290,
      "end_ms": 250735,
      "text": "滨大创立了全美第一所医学院全球最著名的沃顿商学院。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00106",
      "start_ms": 251100,
      "end_ms": 252580,
      "text": "一九四六年历史上，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00107",
      "start_ms": 252580,
      "end_ms": 254945,
      "text": "第一台通用电子计算机在这里诞生，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00108",
      "start_ms": 255180,
      "end_ms": 257205,
      "text": "从此开启了人类信息时代。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00109",
      "start_ms": 257430,
      "end_ms": 258470,
      "text": "川普逢人就说，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00110",
      "start_ms": 258610,
      "end_ms": 260050,
      "text": "我是一个非常聪明的人，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00111",
      "start_ms": 260050,
      "end_ms": 261825,
      "text": "因为我念的是沃顿商学院。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00112",
      "start_ms": 262150,
      "end_ms": 263985,
      "text": "这里是全球CEO的摇篮。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00113",
      "start_ms": 264270,
      "end_ms": 267275,
      "text": "雅诗兰黛家族的四位继承人都是冰大校友，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00114",
      "start_ms": 267550,
      "end_ms": 269315,
      "text": "这里更是行业规则的定义者，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00115",
      "start_ms": 269680,
      "end_ms": 272295,
      "text": "现代金融市场、营销管理资讯等等，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00116",
      "start_ms": 272580,
      "end_ms": 275495,
      "text": "一切你能想象的金融名词都来源于此。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00117",
      "start_ms": 275800,
      "end_ms": 277100,
      "text": "当你从兵大毕业，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00118",
      "start_ms": 277160,
      "end_ms": 279905,
      "text": "你将享受赢者通吃的巅峰人生。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00119",
      "start_ms": 280460,
      "end_ms": 282985,
      "text": "我在滨大的博物馆里看到了很多中国文物，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00120",
      "start_ms": 283280,
      "end_ms": 286380,
      "text": "唐太宗昭陵六郡竟然有三分之一不在中国。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00121",
      "start_ms": 286540,
      "end_ms": 289400,
      "text": "而在宾夕法尼亚大学并大两年之前，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00122",
      "start_ms": 289400,
      "end_ms": 292845,
      "text": "给一位中国女学生补发了一张迟到了一百年的学位证书。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00123",
      "start_ms": 293080,
      "end_ms": 294365,
      "text": "他就是灵魂。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00124",
      "start_ms": 294730,
      "end_ms": 301310,
      "text": "从兵大走出了中国第一代建筑学者、梁思成林徽因杨廷宝、童俊、范文照等等。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00125",
      "start_ms": 301710,
      "end_ms": 303170,
      "text": "如今每一年都有几百位，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00126",
      "start_ms": 303170,
      "end_ms": 304830,
      "text": "中国留学生在兵大读书，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00127",
      "start_ms": 305110,
      "end_ms": 306390,
      "text": "一口流利普通话，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00128",
      "start_ms": 306490,
      "end_ms": 307890,
      "text": "家住宾夕法尼亚。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00129",
      "start_ms": 308110,
      "end_ms": 311170,
      "text": "但是朱军你知道为什么广东人不要轻易报考？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00130",
      "start_ms": 311310,
      "end_ms": 312010,
      "text": "兵大嘛。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00131",
      "start_ms": 312230,
      "end_ms": 312730,
      "text": "第四，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00132",
      "start_ms": 312750,
      "end_ms": 316010,
      "text": "普林斯顿大学美国人眼里公认最好的大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00133",
      "start_ms": 316070,
      "end_ms": 316790,
      "text": "没有之一。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00134",
      "start_ms": 317070,
      "end_ms": 320030,
      "text": "二零二六年全球只诞生了四位菲尔斯奖得主。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00135",
      "start_ms": 320030,
      "end_ms": 323990,
      "text": "其中三个都是他的校友最赚钱的商学院法学院医学院，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00136",
      "start_ms": 323990,
      "end_ms": 326360,
      "text": "他居院一个都没有两百多年来，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00137",
      "start_ms": 326360,
      "end_ms": 327240,
      "text": "只干一件事，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00138",
      "start_ms": 327280,
      "end_ms": 328500,
      "text": "死磕基础学科，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00139",
      "start_ms": 328980,
      "end_ms": 331140,
      "text": "只有八百人的数学系到底有多猛？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00140",
      "start_ms": 331500,
      "end_ms": 333940,
      "text": "纳什均衡博弈论的开山之作，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00141",
      "start_ms": 334180,
      "end_ms": 337900,
      "text": "费马大定理数学界最难砍的骨头在这里被证明，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00142",
      "start_ms": 338300,
      "end_ms": 340000,
      "text": "一个只有八千多人的大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00143",
      "start_ms": 340140,
      "end_ms": 343400,
      "text": "却产出了足以匹敌一个国家的顶级人才密度。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00144",
      "start_ms": 343840,
      "end_ms": 346460,
      "text": "贝尔斯奖历史上一共六十八位得主，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00145",
      "start_ms": 346520,
      "end_ms": 349640,
      "text": "有四十九位都来自普林斯顿、爱因斯坦。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00146",
      "start_ms": 349640,
      "end_ms": 351720,
      "text": "生命最后二十二年没有住在纽约，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00147",
      "start_ms": 351840,
      "end_ms": 353840,
      "text": "而是躲进了这个没有人打扰的小镇。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00148",
      "start_ms": 353840,
      "end_ms": 354965,
      "text": "普林金斯顿，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00149",
      "start_ms": 355590,
      "end_ms": 358855,
      "text": "这里很清高的坚守了近三百年的基因主义传统，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00150",
      "start_ms": 359240,
      "end_ms": 361985,
      "text": "窄窄的校门指向天资最高的学生开放。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00151",
      "start_ms": 362340,
      "end_ms": 363500,
      "text": "可你一旦进入校园，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00152",
      "start_ms": 363560,
      "end_ms": 366035,
      "text": "你接受的就是全世界最优质的教育。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00153",
      "start_ms": 366240,
      "end_ms": 366600,
      "text": "在这里，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00154",
      "start_ms": 366600,
      "end_ms": 369155,
      "text": "所有的学生都拿同一个学位、文学士，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00155",
      "start_ms": 369510,
      "end_ms": 370725,
      "text": "不管你想当工程师，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00156",
      "start_ms": 370900,
      "end_ms": 371735,
      "text": "还是当诗人，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00157",
      "start_ms": 372080,
      "end_ms": 377140,
      "text": "所有学生都必须完成涵盖人文、社科、自然科学等等领域的三十五门核心课程。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00158",
      "start_ms": 377280,
      "end_ms": 378540,
      "text": "学物理的也得啃完，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00159",
      "start_ms": 378540,
      "end_ms": 380720,
      "text": "莎士比亚搞文学的也得刷完。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00160",
      "start_ms": 380720,
      "end_ms": 381345,
      "text": "微积分，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00161",
      "start_ms": 381680,
      "end_ms": 383180,
      "text": "普林斯顿要的不是专才，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00162",
      "start_ms": 383260,
      "end_ms": 384205,
      "text": "而是通才。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00163",
      "start_ms": 384650,
      "end_ms": 387175,
      "text": "当你从普林斯顿毕业同学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00164",
      "start_ms": 387350,
      "end_ms": 390085,
      "text": "你的人生失败率将无限趋近于零。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00165",
      "start_ms": 390680,
      "end_ms": 391140,
      "text": "第五，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00166",
      "start_ms": 391220,
      "end_ms": 394055,
      "text": "康奈尔大学世界上最美的大学之一，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00167",
      "start_ms": 394320,
      "end_ms": 395600,
      "text": "占地三千英亩，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00168",
      "start_ms": 395700,
      "end_ms": 398820,
      "text": "相当于三个故宫建立在峡谷之间，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00169",
      "start_ms": 398900,
      "end_ms": 400245,
      "text": "吸取天地灵气，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00170",
      "start_ms": 400600,
      "end_ms": 402600,
      "text": "大河旷野碧波荡漾，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00171",
      "start_ms": 402660,
      "end_ms": 404115,
      "text": "就像在仙境里读书。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00172",
      "start_ms": 404490,
      "end_ms": 407045,
      "text": "康奈尔是第一所男女同校的常春藤，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00173",
      "start_ms": 407290,
      "end_ms": 409185,
      "text": "一八七零年开始招收女生，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00174",
      "start_ms": 409440,
      "end_ms": 411615,
      "text": "也是猥琐公私合营的藤效。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00175",
      "start_ms": 411970,
      "end_ms": 414435,
      "text": "这里的专业更是野到你超乎想象。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00176",
      "start_ms": 414790,
      "end_ms": 417565,
      "text": "酒店管理全球第一自带教学的酒店。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00177",
      "start_ms": 417850,
      "end_ms": 419865,
      "text": "而兽医学院全球前三，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00178",
      "start_ms": 420270,
      "end_ms": 422765,
      "text": "全世界第一头克隆牛艾米诞生在这里，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00179",
      "start_ms": 423010,
      "end_ms": 426405,
      "text": "这里还是中国的国宝大熊猫在海外的健康监测站。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00180",
      "start_ms": 426860,
      "end_ms": 430655,
      "text": "当你在康奈尔你的同学可能在研究火星探测器机械臂，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00181",
      "start_ms": 430860,
      "end_ms": 432935,
      "text": "也可能在隔壁养转基因奶牛，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00182",
      "start_ms": 433270,
      "end_ms": 434905,
      "text": "从宇宙物理到动物科学。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00183",
      "start_ms": 435180,
      "end_ms": 437265,
      "text": "从量子计算到葡萄栽培，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00184",
      "start_ms": 437520,
      "end_ms": 438680,
      "text": "这里只有你想不到，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00185",
      "start_ms": 438680,
      "end_ms": 440045,
      "text": "没有你学不到的专业。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00186",
      "start_ms": 440280,
      "end_ms": 441515,
      "text": "就像康奈尔的校训。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00187",
      "start_ms": 441840,
      "end_ms": 442715,
      "text": "有教无类，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00188",
      "start_ms": 443410,
      "end_ms": 450125,
      "text": "康奈尔还是全世界唯一拥有四位女性诺奖校友的大学著名作家赛珍珠就是这里的校友，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00189",
      "start_ms": 450450,
      "end_ms": 453125,
      "text": "而康奈尔的中国校友名单更是长的吓人。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00190",
      "start_ms": 453350,
      "end_ms": 457070,
      "text": "胡适、赵圆润毛以生梁思成林徽因冰心。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00191",
      "start_ms": 457230,
      "end_ms": 460555,
      "text": "徐志摩在一百多年前的一九一五年，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00192",
      "start_ms": 460790,
      "end_ms": 463615,
      "text": "中国留学生在康奈尔成立了中国科学社，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00193",
      "start_ms": 463880,
      "end_ms": 465745,
      "text": "就是后来的中国科学院。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00194",
      "start_ms": 466050,
      "end_ms": 467810,
      "text": "但是朱军出身名校，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00195",
      "start_ms": 467830,
      "end_ms": 469535,
      "text": "从来保证不了一个人的道德。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00196",
      "start_ms": 469890,
      "end_ms": 475230,
      "text": "很难想象最近在康奈尔大学会发生七个男人对一个女生进行长达七小时的侵害。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00197",
      "start_ms": 475390,
      "end_ms": 478210,
      "text": "向世界撕开的顶级名校的阴暗一角，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00198",
      "start_ms": 478250,
      "end_ms": 480470,
      "text": "也让人看清常春藤的光环，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00199",
      "start_ms": 480630,
      "end_ms": 482450,
      "text": "并掩盖不住人性恶。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00200",
      "start_ms": 482830,
      "end_ms": 483290,
      "text": "第六，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00201",
      "start_ms": 483410,
      "end_ms": 486015,
      "text": "耶鲁大学创办于一七零一年，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00202",
      "start_ms": 486190,
      "end_ms": 487395,
      "text": "中国康熙年间，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00203",
      "start_ms": 487680,
      "end_ms": 491500,
      "text": "这里诞生了六十五位诺奖得主和五十枚奥运会金牌，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00204",
      "start_ms": 491600,
      "end_ms": 493365,
      "text": "以及五位美国总统，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00205",
      "start_ms": 493640,
      "end_ms": 498045,
      "text": "尤其是连续四季老布什、克林顿、小布什全是耶鲁毕业生，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00206",
      "start_ms": 498410,
      "end_ms": 500095,
      "text": "耶鲁最牛的就是法学院。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00207",
      "start_ms": 500380,
      "end_ms": 501940,
      "text": "自从有法学院排名以来，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00208",
      "start_ms": 501960,
      "end_ms": 503180,
      "text": "常年世界第一，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00209",
      "start_ms": 503240,
      "end_ms": 504355,
      "text": "从未跌到第二。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00210",
      "start_ms": 504710,
      "end_ms": 507385,
      "text": "克林顿和希拉里就是在耶鲁法学院认识的，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00211",
      "start_ms": 507720,
      "end_ms": 508340,
      "text": "你知道吗？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00212",
      "start_ms": 508440,
      "end_ms": 510880,
      "text": "美国有一个比中情局还要神秘的组织，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00213",
      "start_ms": 510960,
      "end_ms": 516115,
      "text": "据说就在耶鲁骷髅会每年只在大三学生里挑选十五个人入会，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00214",
      "start_ms": 516430,
      "end_ms": 518785,
      "text": "新人要在泥浆里摔跤被殴打。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00215",
      "start_ms": 518970,
      "end_ms": 520565,
      "text": "经历长时间的心理训练，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00216",
      "start_ms": 520840,
      "end_ms": 521775,
      "text": "目的只有一个，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00217",
      "start_ms": 522030,
      "end_ms": 524250,
      "text": "让成员互相知道彼此的隐私，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00218",
      "start_ms": 524410,
      "end_ms": 525725,
      "text": "一辈子绑定在一起。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00219",
      "start_ms": 526210,
      "end_ms": 528230,
      "text": "这个社团走出了三位美国总统，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00220",
      "start_ms": 528350,
      "end_ms": 530365,
      "text": "布什家族三代都是会员。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00221",
      "start_ms": 530610,
      "end_ms": 531310,
      "text": "而你知道吗？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00222",
      "start_ms": 531390,
      "end_ms": 534785,
      "text": "我们中国历史上第一位留学生就毕业于耶鲁大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00223",
      "start_ms": 535040,
      "end_ms": 536695,
      "text": "他叫容红广东人，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00224",
      "start_ms": 537120,
      "end_ms": 540805,
      "text": "一八五四年成为了在美国大学里第一个拿到学位的中国人。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00225",
      "start_ms": 541120,
      "end_ms": 542220,
      "text": "他毕业之后回国，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00226",
      "start_ms": 542420,
      "end_ms": 544060,
      "text": "说服了曾国藩和李鸿章，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00227",
      "start_ms": 544280,
      "end_ms": 548365,
      "text": "把一百二十个平均只有十二岁的中国孩子送去美国留学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00228",
      "start_ms": 548750,
      "end_ms": 552225,
      "text": "后来成长为民国总理、清华校长等等大人物。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00229",
      "start_ms": 552630,
      "end_ms": 554290,
      "text": "这群被遗忘的留美幼童，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00230",
      "start_ms": 554530,
      "end_ms": 559560,
      "text": "改变了中国历史第七达特茅斯学院存在感最低的成效。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00231",
      "start_ms": 559740,
      "end_ms": 561735,
      "text": "隐形王者幕后大佬，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00232",
      "start_ms": 562170,
      "end_ms": 566005,
      "text": "学校坐落在新罕布什尔州的一百多平方公里的森林之中，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00233",
      "start_ms": 566230,
      "end_ms": 567475,
      "text": "位置相当偏僻，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00234",
      "start_ms": 567690,
      "end_ms": 570615,
      "text": "而且QS排名连前两百都排不上，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00235",
      "start_ms": 570960,
      "end_ms": 571895,
      "text": "但是你敢相信吗？"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00236",
      "start_ms": 572190,
      "end_ms": 573850,
      "text": "美国收入前十的家庭，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00237",
      "start_ms": 573850,
      "end_ms": 575305,
      "text": "争着要把孩子送到这里。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00238",
      "start_ms": 575720,
      "end_ms": 578720,
      "text": "达特茅斯是常春藤里唯一坚持小而精的学校。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00239",
      "start_ms": 578900,
      "end_ms": 582755,
      "text": "每个班平均十六人教授能够叫出每个学生的名字。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00240",
      "start_ms": 583810,
      "end_ms": 586695,
      "text": "有些学校拼命想让自己听起来像一个大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00241",
      "start_ms": 586980,
      "end_ms": 589700,
      "text": "但是达特茅斯已经强到两百多年了，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00242",
      "start_ms": 589700,
      "end_ms": 591425,
      "text": "懒得把学院改成大学。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00243",
      "start_ms": 591890,
      "end_ms": 592590,
      "text": "一八一九年，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00244",
      "start_ms": 592590,
      "end_ms": 595185,
      "text": "州政府想把名字改成达特茅斯大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00245",
      "start_ms": 595520,
      "end_ms": 596980,
      "text": "但是学校坚决不同意，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00246",
      "start_ms": 597060,
      "end_ms": 598380,
      "text": "一路告到最高法院，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00247",
      "start_ms": 598420,
      "end_ms": 599155,
      "text": "最终赢了，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00248",
      "start_ms": 599640,
      "end_ms": 601200,
      "text": "谁也别想改我的名字，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00249",
      "start_ms": 601220,
      "end_ms": 602285,
      "text": "哪怕你是州长。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00250",
      "start_ms": 602670,
      "end_ms": 603750,
      "text": "因为在达特茅斯，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00251",
      "start_ms": 603970,
      "end_ms": 605190,
      "text": "小而精的学院，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00252",
      "start_ms": 605290,
      "end_ms": 606270,
      "text": "可不是降级，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00253",
      "start_ms": 606390,
      "end_ms": 607290,
      "text": "是一种勋章。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00254",
      "start_ms": 607550,
      "end_ms": 608010,
      "text": "第八，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00255",
      "start_ms": 608110,
      "end_ms": 610950,
      "text": "布朗大学最适合摩羯座的大学。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00256",
      "start_ms": 610950,
      "end_ms": 612310,
      "text": "因为这里自由的可怕，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00257",
      "start_ms": 612750,
      "end_ms": 614350,
      "text": "美国最顶级的一批大学里，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00258",
      "start_ms": 614350,
      "end_ms": 615970,
      "text": "他是最敢把你的人生，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00259",
      "start_ms": 615990,
      "end_ms": 616930,
      "text": "你自己负责。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00260",
      "start_ms": 616970,
      "end_ms": 618110,
      "text": "贯彻到底的学校，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00261",
      "start_ms": 618310,
      "end_ms": 620030,
      "text": "全靠学生的自驱力。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00262",
      "start_ms": 620270,
      "end_ms": 621170,
      "text": "在布朗大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00263",
      "start_ms": 621170,
      "end_ms": 622550,
      "text": "没有任何一门必修课，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00264",
      "start_ms": 622690,
      "end_ms": 625030,
      "text": "学生想上什么课就上什么课，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00265",
      "start_ms": 625130,
      "end_ms": 626430,
      "text": "没有通识教育要求，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00266",
      "start_ms": 626590,
      "end_ms": 627990,
      "text": "没有核心课程限制，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00267",
      "start_ms": 628230,
      "end_ms": 630030,
      "text": "两千多门课随你选。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00268",
      "start_ms": 630930,
      "end_ms": 632275,
      "text": "所以江湖上有一句话，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00269",
      "start_ms": 632620,
      "end_ms": 634180,
      "text": "世上奇葩千千万，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00270",
      "start_ms": 634200,
      "end_ms": 635440,
      "text": "布朗大学占一半。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00271",
      "start_ms": 635600,
      "end_ms": 637300,
      "text": "因为这里的课程太自由了，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00272",
      "start_ms": 637300,
      "end_ms": 638620,
      "text": "什么奇怪的专业都有。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00273",
      "start_ms": 639320,
      "end_ms": 640140,
      "text": "布朗最牛的，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00274",
      "start_ms": 640140,
      "end_ms": 641840,
      "text": "不是我们给你最好的教育，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00275",
      "start_ms": 641920,
      "end_ms": 644660,
      "text": "而是我们把教育的方向盘交给你自己。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00276",
      "start_ms": 644960,
      "end_ms": 646940,
      "text": "在这样快乐自由的氛围之下，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00277",
      "start_ms": 646940,
      "end_ms": 650520,
      "text": "布朗诞生了十一位诺奖得主二十四位普利茨奖得主。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00278",
      "start_ms": 650780,
      "end_ms": 653040,
      "text": "在一八五八年布朗有一位毕业生，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00279",
      "start_ms": 653140,
      "end_ms": 654880,
      "text": "后来他成为美国国务卿，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00280",
      "start_ms": 655080,
      "end_ms": 658360,
      "text": "他直接推动了美国退还部分超额的庚子赔款。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00281",
      "start_ms": 658640,
      "end_ms": 659500,
      "text": "有了这笔钱，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00282",
      "start_ms": 659680,
      "end_ms": 662105,
      "text": "后来才创建了中国的清华大学，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00283",
      "start_ms": 662460,
      "end_ms": 665895,
      "text": "而今天布朗居然还藏着十六万册的中文图书，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00284",
      "start_ms": 666130,
      "end_ms": 668600,
      "text": "尤其是明清古籍朱君，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00285",
      "start_ms": 668860,
      "end_ms": 670260,
      "text": "这就是常春藤。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00286",
      "start_ms": 670740,
      "end_ms": 673485,
      "text": "上个世纪美国东海岸这八所老牌的名校，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00287",
      "start_ms": 673750,
      "end_ms": 676425,
      "text": "其实一开始只是一个橄榄球的体育联盟，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00288",
      "start_ms": 676630,
      "end_ms": 678355,
      "text": "后来才成了所谓的藤效。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00289",
      "start_ms": 678920,
      "end_ms": 680460,
      "text": "当你坐在教室的那一瞬间，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00290",
      "start_ms": 680460,
      "end_ms": 681115,
      "text": "会感叹，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00291",
      "start_ms": 681450,
      "end_ms": 683845,
      "text": "原来曾经拼命努力走过的路，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00292",
      "start_ms": 684100,
      "end_ms": 686035,
      "text": "真的能带你走向更大的世界。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00293",
      "start_ms": 686440,
      "end_ms": 688560,
      "text": "一个人最好的学历不是清华北大，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00294",
      "start_ms": 688580,
      "end_ms": 689340,
      "text": "也不是哈佛。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00295",
      "start_ms": 689340,
      "end_ms": 692000,
      "text": "耶鲁是当你走过足够大的世界之后，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00296",
      "start_ms": 692160,
      "end_ms": 694135,
      "text": "依然对知识保持敬畏，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00297",
      "start_ms": 694320,
      "end_ms": 695725,
      "text": "对未来保持好奇，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00298",
      "start_ms": 696000,
      "end_ms": 697495,
      "text": "对理想保持热爱。"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00299",
      "start_ms": 697930,
      "end_ms": 699690,
      "text": "山的那边不是名校，"
    },
    {
      "segment_id": "v_023eca959e8ced08_s00300",
      "start_ms": 699970,
      "end_ms": 701535,
      "text": "是一个更辽阔的自己。"
    }
  ],
