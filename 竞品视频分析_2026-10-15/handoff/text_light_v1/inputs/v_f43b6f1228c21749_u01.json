  "video_id": "v_f43b6f1228c21749",
  "account": "破局书屋",
  "source_title": "培养孩子正确的财商思维，会存钱、会花钱、学赚钱，是一生的礼物。#育儿经验分享#财商启蒙#培养孩子的消费观",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
  "status": "AI_PENDING",
  "unit_index": 1,
  "unit_count": 1,
  "all_video_unit_ids": [
    "v_f43b6f1228c21749_u01"
  ],
  "duration_s": 213.25,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "妈妈为啥商场一楼全是化妆品、珠宝，吃饭、看电影却都在顶楼，因为顶楼风景好，吃饭香一楼太吵了呗，这都讲不清楚孩子以后怎么学做生意。妈妈，我知道是为什么？因为一楼人流量大，大家都要经过有人会冲动消费，这是经济学启蒙课里提到过的瀑布效应。妈妈商场里面停车为什么比我们小区贵呀？因为商场地段好，所以停车自然贵，只知道地段好停车费。为什么贵都讲不清楚孩子以后怎么学会控制成本。妈妈，同样是矿泉水，为什么高铁上卖这么贵啊？嗯，高铁上就是贵，咱们自己带水喝就好了。连那么基础的经济学原理都讲不清楚孩子以后怎么发现商机。你想想，如果高铁上允许外面的人上来卖水，他还卖这么贵吗？就是因为只有他能卖，你又渴的不行，所以再贵你也得买。这是经济学启蒙课里提到的独家生意。妈妈自助餐随便吃，老板为什么还能赚钱啊？大部分人吃不多，所以老板不会亏。连自助餐厅为什么赚钱都给孩子讲，不清楚孩子以后怎么赚钱？妈妈猪肉便宜了，吃的人应该更多才对啊。为什么说猪肉销量反而下降了？可能大家兜里没钱了吧，穷了就少吃肉呗。也可能跟附近工地开工少了有关工地跟猪肉有什么关系？比如工地食堂，原来每天要买不少肉开工，少了，吃饭的人少，采购也可能跟着减。不光是肉，蔬菜米面也可能受影响。一个地方的变化会连着影响别的生意。这我确实没想到妈妈为什么牛奶是方盒子，可乐却是圆瓶子。厂家就是这么设计的，具体原因我也不太清楚。可乐内部有气压，圆形瓶身可以均匀分散压力。牛奶没有气压，方形盒子可以省下冷柜的仓储空间，降低商家成本。你们怎么什么都知道，我啥都不懂，这多亏了我。妈妈从小陪我看写给孩子的漫画经济学里面把这些商业模式全化成漫画故事了。一看就懂了。我妈说，一个人如果没有财商思维，长大要吃很多亏，所以我从小就在学。如果你不教导孩子金钱方面的知识，将来进入社会的他就像一张白纸，被人骗了也不自知错。把别人精心设计的陷阱当做自己的运气推荐。在孩子十岁前，父母陪他读这套写给孩子的漫画经济学这套书，用生动有趣的故事帮助孩子树立正确的金钱观。像我们花的钱是从哪儿来的？教会孩子认识金钱的来源，如何不盲目购物？教会孩子理性消费不乱花钱，玩具只能选一个怎么办？教会孩子学会取舍，把钱花在真正需要的地方。什么是打折？教会孩子正确看待优惠，不因为便宜就盲目购买记账的日子。教会孩子记录日常开销，养成管理零花钱的习惯。钱越多越好吗？引导孩子正确看待财富，树立健康的金钱观。让孩子从小明白，钱从哪里来，东西为什么有贵，有便宜，什么该买，什么不该买，慢慢学会合理花钱，管理金钱，培养独立思考的能力。家里有孩子的，真的可以准备一套，每天陪孩子看一点，让孩子从小建立财商思维。",
  "segments": [
    {
      "segment_id": "v_f43b6f1228c21749_s00001",
      "start_ms": 280,
      "end_ms": 2980,
      "text": "妈妈为啥商场一楼全是化妆品、珠宝，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00002",
      "start_ms": 3340,
      "end_ms": 4960,
      "text": "吃饭、看电影却都在顶楼，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00003",
      "start_ms": 5640,
      "end_ms": 6860,
      "text": "因为顶楼风景好，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00004",
      "start_ms": 7060,
      "end_ms": 9020,
      "text": "吃饭香一楼太吵了呗，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00005",
      "start_ms": 9820,
      "end_ms": 12180,
      "text": "这都讲不清楚孩子以后怎么学做生意。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00006",
      "start_ms": 12500,
      "end_ms": 12900,
      "text": "妈妈，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00007",
      "start_ms": 12900,
      "end_ms": 13920,
      "text": "我知道是为什么？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00008",
      "start_ms": 14020,
      "end_ms": 15420,
      "text": "因为一楼人流量大，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00009",
      "start_ms": 15720,
      "end_ms": 18280,
      "text": "大家都要经过有人会冲动消费，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00010",
      "start_ms": 18700,
      "end_ms": 21965,
      "text": "这是经济学启蒙课里提到过的瀑布效应。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00011",
      "start_ms": 24400,
      "end_ms": 27500,
      "text": "妈妈商场里面停车为什么比我们小区贵呀？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00012",
      "start_ms": 28000,
      "end_ms": 29300,
      "text": "因为商场地段好，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00013",
      "start_ms": 29380,
      "end_ms": 30560,
      "text": "所以停车自然贵，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00014",
      "start_ms": 31320,
      "end_ms": 33000,
      "text": "只知道地段好停车费。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00015",
      "start_ms": 33000,
      "end_ms": 36125,
      "text": "为什么贵都讲不清楚孩子以后怎么学会控制成本。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00016",
      "start_ms": 39320,
      "end_ms": 39760,
      "text": "妈妈，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00017",
      "start_ms": 39940,
      "end_ms": 41000,
      "text": "同样是矿泉水，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00018",
      "start_ms": 41280,
      "end_ms": 42920,
      "text": "为什么高铁上卖这么贵啊？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00019",
      "start_ms": 43580,
      "end_ms": 43820,
      "text": "嗯，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00020",
      "start_ms": 43980,
      "end_ms": 45020,
      "text": "高铁上就是贵，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00021",
      "start_ms": 45240,
      "end_ms": 46860,
      "text": "咱们自己带水喝就好了。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00022",
      "start_ms": 47520,
      "end_ms": 51940,
      "text": "连那么基础的经济学原理都讲不清楚孩子以后怎么发现商机。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00023",
      "start_ms": 52120,
      "end_ms": 52660,
      "text": "你想想，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00024",
      "start_ms": 52960,
      "end_ms": 55179,
      "text": "如果高铁上允许外面的人上来卖水，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00025",
      "start_ms": 55300,
      "end_ms": 56300,
      "text": "他还卖这么贵吗？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00026",
      "start_ms": 56840,
      "end_ms": 58160,
      "text": "就是因为只有他能卖，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00027",
      "start_ms": 58300,
      "end_ms": 59180,
      "text": "你又渴的不行，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00028",
      "start_ms": 59480,
      "end_ms": 60735,
      "text": "所以再贵你也得买。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00029",
      "start_ms": 61110,
      "end_ms": 63665,
      "text": "这是经济学启蒙课里提到的独家生意。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00030",
      "start_ms": 64350,
      "end_ms": 66190,
      "text": "妈妈自助餐随便吃，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00031",
      "start_ms": 66550,
      "end_ms": 68335,
      "text": "老板为什么还能赚钱啊？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00032",
      "start_ms": 68910,
      "end_ms": 70070,
      "text": "大部分人吃不多，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00033",
      "start_ms": 70270,
      "end_ms": 71555,
      "text": "所以老板不会亏。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00034",
      "start_ms": 72300,
      "end_ms": 74660,
      "text": "连自助餐厅为什么赚钱都给孩子讲，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00035",
      "start_ms": 74660,
      "end_ms": 76645,
      "text": "不清楚孩子以后怎么赚钱？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00036",
      "start_ms": 79760,
      "end_ms": 81360,
      "text": "妈妈猪肉便宜了，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00037",
      "start_ms": 81380,
      "end_ms": 83145,
      "text": "吃的人应该更多才对啊。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00038",
      "start_ms": 83410,
      "end_ms": 85545,
      "text": "为什么说猪肉销量反而下降了？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00039",
      "start_ms": 86080,
      "end_ms": 87620,
      "text": "可能大家兜里没钱了吧，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00040",
      "start_ms": 87820,
      "end_ms": 89125,
      "text": "穷了就少吃肉呗。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00041",
      "start_ms": 89550,
      "end_ms": 94025,
      "text": "也可能跟附近工地开工少了有关工地跟猪肉有什么关系？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00042",
      "start_ms": 94380,
      "end_ms": 95580,
      "text": "比如工地食堂，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00043",
      "start_ms": 95620,
      "end_ms": 97710,
      "text": "原来每天要买不少肉开工，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00044",
      "start_ms": 97710,
      "end_ms": 98170,
      "text": "少了，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00045",
      "start_ms": 98250,
      "end_ms": 99050,
      "text": "吃饭的人少，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00046",
      "start_ms": 99330,
      "end_ms": 100715,
      "text": "采购也可能跟着减。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00047",
      "start_ms": 101270,
      "end_ms": 102025,
      "text": "不光是肉，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00048",
      "start_ms": 102420,
      "end_ms": 104135,
      "text": "蔬菜米面也可能受影响。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00049",
      "start_ms": 104510,
      "end_ms": 106875,
      "text": "一个地方的变化会连着影响别的生意。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00050",
      "start_ms": 107780,
      "end_ms": 112205,
      "text": "这我确实没想到妈妈为什么牛奶是方盒子，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00051",
      "start_ms": 112550,
      "end_ms": 114175,
      "text": "可乐却是圆瓶子。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00052",
      "start_ms": 116080,
      "end_ms": 117675,
      "text": "厂家就是这么设计的，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00053",
      "start_ms": 117980,
      "end_ms": 119965,
      "text": "具体原因我也不太清楚。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00054",
      "start_ms": 120350,
      "end_ms": 121570,
      "text": "可乐内部有气压，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00055",
      "start_ms": 121850,
      "end_ms": 124135,
      "text": "圆形瓶身可以均匀分散压力。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00056",
      "start_ms": 124450,
      "end_ms": 125510,
      "text": "牛奶没有气压，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00057",
      "start_ms": 125770,
      "end_ms": 128745,
      "text": "方形盒子可以省下冷柜的仓储空间，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00058",
      "start_ms": 129060,
      "end_ms": 130085,
      "text": "降低商家成本。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00059",
      "start_ms": 130620,
      "end_ms": 132040,
      "text": "你们怎么什么都知道，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00060",
      "start_ms": 132340,
      "end_ms": 133365,
      "text": "我啥都不懂，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00061",
      "start_ms": 134770,
      "end_ms": 135550,
      "text": "这多亏了我。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00062",
      "start_ms": 135550,
      "end_ms": 142335,
      "text": "妈妈从小陪我看写给孩子的漫画经济学里面把这些商业模式全化成漫画故事了。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00063",
      "start_ms": 142570,
      "end_ms": 143445,
      "text": "一看就懂了。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00064",
      "start_ms": 143720,
      "end_ms": 144315,
      "text": "我妈说，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00065",
      "start_ms": 144630,
      "end_ms": 146250,
      "text": "一个人如果没有财商思维，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00066",
      "start_ms": 146550,
      "end_ms": 147845,
      "text": "长大要吃很多亏，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00067",
      "start_ms": 148320,
      "end_ms": 149685,
      "text": "所以我从小就在学。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00068",
      "start_ms": 150240,
      "end_ms": 152525,
      "text": "如果你不教导孩子金钱方面的知识，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00069",
      "start_ms": 152890,
      "end_ms": 155090,
      "text": "将来进入社会的他就像一张白纸，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00070",
      "start_ms": 155210,
      "end_ms": 157070,
      "text": "被人骗了也不自知错。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00071",
      "start_ms": 157070,
      "end_ms": 160720,
      "text": "把别人精心设计的陷阱当做自己的运气推荐。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00072",
      "start_ms": 160720,
      "end_ms": 161720,
      "text": "在孩子十岁前，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00073",
      "start_ms": 161920,
      "end_ms": 165740,
      "text": "父母陪他读这套写给孩子的漫画经济学这套书，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00074",
      "start_ms": 165740,
      "end_ms": 169380,
      "text": "用生动有趣的故事帮助孩子树立正确的金钱观。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00075",
      "start_ms": 169720,
      "end_ms": 171645,
      "text": "像我们花的钱是从哪儿来的？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00076",
      "start_ms": 171880,
      "end_ms": 173745,
      "text": "教会孩子认识金钱的来源，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00077",
      "start_ms": 174210,
      "end_ms": 175350,
      "text": "如何不盲目购物？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00078",
      "start_ms": 175570,
      "end_ms": 178034,
      "text": "教会孩子理性消费不乱花钱，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00079",
      "start_ms": 178250,
      "end_ms": 179670,
      "text": "玩具只能选一个怎么办？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00080",
      "start_ms": 179850,
      "end_ms": 181225,
      "text": "教会孩子学会取舍，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00081",
      "start_ms": 181470,
      "end_ms": 183245,
      "text": "把钱花在真正需要的地方。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00082",
      "start_ms": 183530,
      "end_ms": 184385,
      "text": "什么是打折？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00083",
      "start_ms": 184710,
      "end_ms": 186350,
      "text": "教会孩子正确看待优惠，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00084",
      "start_ms": 186370,
      "end_ms": 189275,
      "text": "不因为便宜就盲目购买记账的日子。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00085",
      "start_ms": 189510,
      "end_ms": 191110,
      "text": "教会孩子记录日常开销，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00086",
      "start_ms": 191350,
      "end_ms": 193010,
      "text": "养成管理零花钱的习惯。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00087",
      "start_ms": 193210,
      "end_ms": 194310,
      "text": "钱越多越好吗？"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00088",
      "start_ms": 194530,
      "end_ms": 196210,
      "text": "引导孩子正确看待财富，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00089",
      "start_ms": 196230,
      "end_ms": 197645,
      "text": "树立健康的金钱观。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00090",
      "start_ms": 198010,
      "end_ms": 198990,
      "text": "让孩子从小明白，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00091",
      "start_ms": 198990,
      "end_ms": 199890,
      "text": "钱从哪里来，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00092",
      "start_ms": 199930,
      "end_ms": 200750,
      "text": "东西为什么有贵，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00093",
      "start_ms": 200750,
      "end_ms": 201405,
      "text": "有便宜，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00094",
      "start_ms": 201640,
      "end_ms": 202280,
      "text": "什么该买，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00095",
      "start_ms": 202420,
      "end_ms": 203220,
      "text": "什么不该买，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00096",
      "start_ms": 203240,
      "end_ms": 204500,
      "text": "慢慢学会合理花钱，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00097",
      "start_ms": 204620,
      "end_ms": 205395,
      "text": "管理金钱，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00098",
      "start_ms": 205640,
      "end_ms": 207145,
      "text": "培养独立思考的能力。"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00099",
      "start_ms": 207440,
      "end_ms": 208360,
      "text": "家里有孩子的，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00100",
      "start_ms": 208360,
      "end_ms": 209520,
      "text": "真的可以准备一套，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00101",
      "start_ms": 209620,
      "end_ms": 210965,
      "text": "每天陪孩子看一点，"
    },
    {
      "segment_id": "v_f43b6f1228c21749_s00102",
      "start_ms": 211170,
      "end_ms": 213065,
      "text": "让孩子从小建立财商思维。"
    }
  ],
