  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "今天是九月九日，星期三又是一年九月九。今天是毛泽东同志逝世五十周年纪念日，请停留三秒为他献朵花。我们缅怀伟大领袖毛主席，是他带领人民浴血奋战，冲破苦难，建立新中国，换来我们今天幸福安宁的生活。饮水思源，不忘来路，踏实过好的当下的每一天。他是中国历史上第一个喊出人民万岁的领袖，他把自己的一生献给党和人民，留下了永志后人的崇高精神风范，对毛泽东同志的最好纪念，就是把他开创的事业继续推向前进。今天，缅怀一代伟人毛泽东，正所谓唯有牺牲多壮志感，交日月换新天伟人精神永济心间。愿五辈砥砺前行，家国长安加油。请在评论区打上嗯缅怀伟人毛泽东。",
  "segments": [
    {
      "segment_id": "v_fd77d44acd3e3105_s00001",
      "start_ms": 130,
      "end_ms": 1350,
      "text": "今天是九月九日，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00002",
      "start_ms": 1370,
      "end_ms": 3390,
      "text": "星期三又是一年九月九。"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00003",
      "start_ms": 4070,
      "end_ms": 7770,
      "text": "今天是毛泽东同志逝世五十周年纪念日，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00004",
      "start_ms": 8570,
      "end_ms": 11410,
      "text": "请停留三秒为他献朵花。"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00005",
      "start_ms": 12610,
      "end_ms": 14890,
      "text": "我们缅怀伟大领袖毛主席，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00006",
      "start_ms": 15330,
      "end_ms": 18310,
      "text": "是他带领人民浴血奋战，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00007",
      "start_ms": 18550,
      "end_ms": 19570,
      "text": "冲破苦难，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00008",
      "start_ms": 19890,
      "end_ms": 21130,
      "text": "建立新中国，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00009",
      "start_ms": 21810,
      "end_ms": 25490,
      "text": "换来我们今天幸福安宁的生活。"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00010",
      "start_ms": 25990,
      "end_ms": 27170,
      "text": "饮水思源，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00011",
      "start_ms": 27650,
      "end_ms": 28610,
      "text": "不忘来路，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00012",
      "start_ms": 28970,
      "end_ms": 31660,
      "text": "踏实过好的当下的每一天。"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00013",
      "start_ms": 32340,
      "end_ms": 36640,
      "text": "他是中国历史上第一个喊出人民万岁的领袖，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00014",
      "start_ms": 37260,
      "end_ms": 40520,
      "text": "他把自己的一生献给党和人民，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00015",
      "start_ms": 40640,
      "end_ms": 43940,
      "text": "留下了永志后人的崇高精神风范，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00016",
      "start_ms": 44720,
      "end_ms": 46980,
      "text": "对毛泽东同志的最好纪念，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00017",
      "start_ms": 47080,
      "end_ms": 50940,
      "text": "就是把他开创的事业继续推向前进。"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00018",
      "start_ms": 52020,
      "end_ms": 52480,
      "text": "今天，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00019",
      "start_ms": 52820,
      "end_ms": 55300,
      "text": "缅怀一代伟人毛泽东，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00020",
      "start_ms": 55880,
      "end_ms": 59020,
      "text": "正所谓唯有牺牲多壮志感，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00021",
      "start_ms": 59020,
      "end_ms": 63565,
      "text": "交日月换新天伟人精神永济心间。"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00022",
      "start_ms": 63870,
      "end_ms": 65715,
      "text": "愿五辈砥砺前行，"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00023",
      "start_ms": 66070,
      "end_ms": 68980,
      "text": "家国长安加油。"
    },
    {
      "segment_id": "v_fd77d44acd3e3105_s00024",
      "start_ms": 69660,
      "end_ms": 74325,
      "text": "请在评论区打上嗯缅怀伟人毛泽东。"
    }
  ],
