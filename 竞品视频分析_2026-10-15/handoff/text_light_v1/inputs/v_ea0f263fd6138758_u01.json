  "account": "林睿读书&书在橱窗",
  "source_title": "三千年前的“天文档案”、碎成二十多块又拼回的国宝、千年不锈的越王勾践剑、改写音乐史的曾侯乙编钟……中国古代十大镇国之宝，件件震撼 #镇国之宝 #中国国宝 #国宝档案 #文物 #博物馆#历史冷知识",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
  "status": "AI_PENDING",
  "unit_index": 1,
  "unit_count": 1,
  "all_video_unit_ids": [
    "v_ea0f263fd6138758_u01"
  ],
  "duration_s": 410.529002,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "你知道中国古代那些号称镇国的顶级国宝，真正排第一的到底是哪一件吗？有人说是后母戊鼎八百多公斤，世界最重青铜器。有人说是清明上河图，八百多个人物，中华第一神品。可这两样虽然珍贵，却都不是最逆天的那一件。有这么一个宝贝，它身上刻着三千年前的天文档案，到现在科学家还没完全看懂。还有一件他被人偷运出境，碎成了二十多块，又一块一块拼了回来。今天咱们就来盘点盘点中国古代十大镇国之宝。老规矩开讲之前，劳烦您顺手扣个一点颗红心，让我看看都是谁在听。第十名，流经午马鲜杯纹银壶。这件宝贝藏在陕西历史博物馆高十八点五厘米，银质表面鎏金壶身上刻着一匹马，嘴里叼着一只酒杯，前腿斜撑后腿蹲起，马尾上摆，像是在跳舞，这匹马可不是随便画的。唐朝的时候，唐玄宗每年过生日，都要在兴庆宫的秦政楼前举行盛大宴会宴会的高潮是什么？一百匹训练过的骏马，穿着锦绣衣服，披着金银饰品。随着音乐起舞，跳到最后领头的马会叼起一只酒杯，送到皇帝面前。助皇帝万寿无疆。安史之乱以后，这些午马散落民间，被不知道的人当成普通马使唤。有一天，军中宴乐音乐一响，一匹午马条件反射的跳起舞来养马的士兵以为马疯了，活活把他打死。一段盛世记忆就这么断了。这件银壶是那段记忆唯一留下的第九名。中山靖王刘胜的金吕御衣这件宝贝藏在河北博物院，它长一点八八米，用两千四百九十八片玉片一千一百克金丝编缀而成。制作这么一件御医有多难？玉片要按人体比例一点一点打磨，厚薄要均匀，视角要钻孔，金丝要拉的粗细一致，才能穿过玉片孔洞。专家推测，一名熟练的御工要耗费十余年才能完成一件。而且刘胜的御医有个特别的地方，肚子那里预留了一个啤酒肚的空间。考古队出土的时候，旁边还发现了大量的酒气，这位中山靖王生前是真能喝两千多年前的人，用玉片和金丝把一个人的体型、习惯甚至嗜好全都封存了下来。第八名，相金兽首玛瑙杯这件宝贝藏在陕西历史博物馆，他用一块罕见的红色蚕丝玛瑙雕成兽首行，双脚为杯柄，嘴部镶着金帽。这是至今所见唐代唯一一件俏色玉雕。什么叫俏色？就是工匠顺着玛瑙天然的纹理和颜色，把深色的地方雕成兽眼，浅色的地方雕成兽脚，红色最浓的地方雕成受嘴。这不是后天染色，是石头自己长出来的颜色。一千两百多年前，一个唐代工匠拿到这块，玛瑙端详了很久，然后一刀一刀把石头里的那头兽放了出来第七名。越王勾践践这把剑，藏在湖北省博物馆，一九六五年出土于湖北江陵望山一号。楚牧出土的时候，一个工人伸手去拿手指，刚碰到剑刃，立刻被划了一道口子，鲜血直流。两千多年了，这把剑还跟刚磨出来的一样，剑身上刻着八个鸟篆字。越王纠遣制作用，剑纠浅就是勾践。为什么千年不锈科学家研究了好多年，一是铜锡合金配比近乎完美，含蓄量百分之十八到二十，杂质极低。二是墓视深埋地下棺裹密封几乎隔绝了空气。三世出土的时候，剑身上还套着七木剑鞘，天时地利人和，缺一不可。这把剑是春秋霸主留给后人的一把钥匙。打开了两千多年的时光。第六名，曾侯乙编钟这套编钟藏在湖北省博物馆，一九七八年出土于湖北随州六十五件青铜编钟总重量两千五百多公斤。最绝的是，它的音域跨五个半八度十二个，半音齐全，比现代钢琴只少一个八度，中体上刻着三千七百多字的霍金铭文标明了每一件中的发音。属于什么律？跟其他诸侯国的律怎么对应？这套编钟出土之前，学术界一直认为十二律是从西方传入中国的。他一出土这个论断被彻底推翻，两千四百多年前的中国人已经把音乐玩到了这个高度。从第十到第六，银湖封存了盛世的境。嗯嗯，御医封存了一个人的身体，玛瑙杯放出了石头里的兽勾践剑，打开了两千年的时光，编钟改写了世界音乐史。可这舞剑还不是最正果的，接下来第五到第一一件比一件震撼，有一件身上刻着武王伐纣的准确日期。有一件八千多公斤，是全世界最重的青铜器，还有一件被称作中国文化遗产的标志，他们是哪几件？凭什么排前面下集马上更新，您先点个关注点开头像别走丢。",
  "segments": [
    {
      "segment_id": "v_ea0f263fd6138758_s00001",
      "start_ms": 170,
      "end_ms": 4350,
      "text": "你知道中国古代那些号称镇国的顶级国宝，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00002",
      "start_ms": 4710,
      "end_ms": 7510,
      "text": "真正排第一的到底是哪一件吗？"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00003",
      "start_ms": 8270,
      "end_ms": 11710,
      "text": "有人说是后母戊鼎八百多公斤，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00004",
      "start_ms": 12630,
      "end_ms": 14470,
      "text": "世界最重青铜器。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00005",
      "start_ms": 14950,
      "end_ms": 16850,
      "text": "有人说是清明上河图，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00006",
      "start_ms": 17430,
      "end_ms": 18530,
      "text": "八百多个人物，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00007",
      "start_ms": 19330,
      "end_ms": 20750,
      "text": "中华第一神品。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00008",
      "start_ms": 21570,
      "end_ms": 23310,
      "text": "可这两样虽然珍贵，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00009",
      "start_ms": 24030,
      "end_ms": 26730,
      "text": "却都不是最逆天的那一件。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00010",
      "start_ms": 26990,
      "end_ms": 28110,
      "text": "有这么一个宝贝，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00011",
      "start_ms": 28590,
      "end_ms": 32260,
      "text": "它身上刻着三千年前的天文档案，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00012",
      "start_ms": 33040,
      "end_ms": 35560,
      "text": "到现在科学家还没完全看懂。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00013",
      "start_ms": 36100,
      "end_ms": 38420,
      "text": "还有一件他被人偷运出境，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00014",
      "start_ms": 38840,
      "end_ms": 40160,
      "text": "碎成了二十多块，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00015",
      "start_ms": 40500,
      "end_ms": 42020,
      "text": "又一块一块拼了回来。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00016",
      "start_ms": 42840,
      "end_ms": 46860,
      "text": "今天咱们就来盘点盘点中国古代十大镇国之宝。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00017",
      "start_ms": 47060,
      "end_ms": 49080,
      "text": "老规矩开讲之前，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00018",
      "start_ms": 49300,
      "end_ms": 52420,
      "text": "劳烦您顺手扣个一点颗红心，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00019",
      "start_ms": 53020,
      "end_ms": 55240,
      "text": "让我看看都是谁在听。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00020",
      "start_ms": 55980,
      "end_ms": 56620,
      "text": "第十名，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00021",
      "start_ms": 57320,
      "end_ms": 59520,
      "text": "流经午马鲜杯纹银壶。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00022",
      "start_ms": 60560,
      "end_ms": 65510,
      "text": "这件宝贝藏在陕西历史博物馆高十八点五厘米，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00023",
      "start_ms": 65570,
      "end_ms": 70005,
      "text": "银质表面鎏金壶身上刻着一匹马，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00024",
      "start_ms": 70470,
      "end_ms": 72235,
      "text": "嘴里叼着一只酒杯，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00025",
      "start_ms": 72620,
      "end_ms": 74695,
      "text": "前腿斜撑后腿蹲起，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00026",
      "start_ms": 75060,
      "end_ms": 75875,
      "text": "马尾上摆，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00027",
      "start_ms": 76130,
      "end_ms": 76925,
      "text": "像是在跳舞，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00028",
      "start_ms": 77410,
      "end_ms": 79255,
      "text": "这匹马可不是随便画的。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00029",
      "start_ms": 79780,
      "end_ms": 80765,
      "text": "唐朝的时候，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00030",
      "start_ms": 81000,
      "end_ms": 82515,
      "text": "唐玄宗每年过生日，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00031",
      "start_ms": 82840,
      "end_ms": 88305,
      "text": "都要在兴庆宫的秦政楼前举行盛大宴会宴会的高潮是什么？"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00032",
      "start_ms": 88770,
      "end_ms": 90945,
      "text": "一百匹训练过的骏马，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00033",
      "start_ms": 91290,
      "end_ms": 92655,
      "text": "穿着锦绣衣服，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00034",
      "start_ms": 92990,
      "end_ms": 94345,
      "text": "披着金银饰品。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00035",
      "start_ms": 94710,
      "end_ms": 95955,
      "text": "随着音乐起舞，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00036",
      "start_ms": 96360,
      "end_ms": 100225,
      "text": "跳到最后领头的马会叼起一只酒杯，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00037",
      "start_ms": 100810,
      "end_ms": 102235,
      "text": "送到皇帝面前。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00038",
      "start_ms": 102560,
      "end_ms": 104575,
      "text": "助皇帝万寿无疆。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00039",
      "start_ms": 105040,
      "end_ms": 106225,
      "text": "安史之乱以后，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00040",
      "start_ms": 106590,
      "end_ms": 108485,
      "text": "这些午马散落民间，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00041",
      "start_ms": 108750,
      "end_ms": 111500,
      "text": "被不知道的人当成普通马使唤。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00042",
      "start_ms": 111620,
      "end_ms": 112120,
      "text": "有一天，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00043",
      "start_ms": 112120,
      "end_ms": 114395,
      "text": "军中宴乐音乐一响，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00044",
      "start_ms": 114870,
      "end_ms": 120395,
      "text": "一匹午马条件反射的跳起舞来养马的士兵以为马疯了，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00045",
      "start_ms": 120700,
      "end_ms": 121675,
      "text": "活活把他打死。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00046",
      "start_ms": 122210,
      "end_ms": 124845,
      "text": "一段盛世记忆就这么断了。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00047",
      "start_ms": 125510,
      "end_ms": 131235,
      "text": "这件银壶是那段记忆唯一留下的第九名。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00048",
      "start_ms": 131830,
      "end_ms": 137925,
      "text": "中山靖王刘胜的金吕御衣这件宝贝藏在河北博物院，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00049",
      "start_ms": 138300,
      "end_ms": 140075,
      "text": "它长一点八八米，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00050",
      "start_ms": 140540,
      "end_ms": 147475,
      "text": "用两千四百九十八片玉片一千一百克金丝编缀而成。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00051",
      "start_ms": 148110,
      "end_ms": 150705,
      "text": "制作这么一件御医有多难？"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00052",
      "start_ms": 150890,
      "end_ms": 154125,
      "text": "玉片要按人体比例一点一点打磨，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00053",
      "start_ms": 154550,
      "end_ms": 156065,
      "text": "厚薄要均匀，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00054",
      "start_ms": 156470,
      "end_ms": 157925,
      "text": "视角要钻孔，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00055",
      "start_ms": 158500,
      "end_ms": 160975,
      "text": "金丝要拉的粗细一致，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00056",
      "start_ms": 161290,
      "end_ms": 163095,
      "text": "才能穿过玉片孔洞。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00057",
      "start_ms": 163960,
      "end_ms": 164875,
      "text": "专家推测，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00058",
      "start_ms": 165170,
      "end_ms": 169885,
      "text": "一名熟练的御工要耗费十余年才能完成一件。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00059",
      "start_ms": 170840,
      "end_ms": 173475,
      "text": "而且刘胜的御医有个特别的地方，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00060",
      "start_ms": 174000,
      "end_ms": 176895,
      "text": "肚子那里预留了一个啤酒肚的空间。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00061",
      "start_ms": 177860,
      "end_ms": 179355,
      "text": "考古队出土的时候，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00062",
      "start_ms": 179800,
      "end_ms": 182105,
      "text": "旁边还发现了大量的酒气，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00063",
      "start_ms": 182810,
      "end_ms": 188205,
      "text": "这位中山靖王生前是真能喝两千多年前的人，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00064",
      "start_ms": 188550,
      "end_ms": 195535,
      "text": "用玉片和金丝把一个人的体型、习惯甚至嗜好全都封存了下来。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00065",
      "start_ms": 196690,
      "end_ms": 197295,
      "text": "第八名，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00066",
      "start_ms": 198180,
      "end_ms": 203735,
      "text": "相金兽首玛瑙杯这件宝贝藏在陕西历史博物馆，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00067",
      "start_ms": 204490,
      "end_ms": 209235,
      "text": "他用一块罕见的红色蚕丝玛瑙雕成兽首行，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00068",
      "start_ms": 209660,
      "end_ms": 210835,
      "text": "双脚为杯柄，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00069",
      "start_ms": 211310,
      "end_ms": 212615,
      "text": "嘴部镶着金帽。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00070",
      "start_ms": 213010,
      "end_ms": 217475,
      "text": "这是至今所见唐代唯一一件俏色玉雕。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00071",
      "start_ms": 218290,
      "end_ms": 219335,
      "text": "什么叫俏色？"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00072",
      "start_ms": 219740,
      "end_ms": 223885,
      "text": "就是工匠顺着玛瑙天然的纹理和颜色，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00073",
      "start_ms": 224500,
      "end_ms": 226795,
      "text": "把深色的地方雕成兽眼，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00074",
      "start_ms": 227300,
      "end_ms": 229095,
      "text": "浅色的地方雕成兽脚，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00075",
      "start_ms": 229510,
      "end_ms": 232085,
      "text": "红色最浓的地方雕成受嘴。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00076",
      "start_ms": 232330,
      "end_ms": 233650,
      "text": "这不是后天染色，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00077",
      "start_ms": 234150,
      "end_ms": 236465,
      "text": "是石头自己长出来的颜色。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00078",
      "start_ms": 237310,
      "end_ms": 238615,
      "text": "一千两百多年前，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00079",
      "start_ms": 239060,
      "end_ms": 241320,
      "text": "一个唐代工匠拿到这块，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00080",
      "start_ms": 241320,
      "end_ms": 243145,
      "text": "玛瑙端详了很久，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00081",
      "start_ms": 243560,
      "end_ms": 249575,
      "text": "然后一刀一刀把石头里的那头兽放了出来第七名。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00082",
      "start_ms": 249970,
      "end_ms": 252235,
      "text": "越王勾践践这把剑，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00083",
      "start_ms": 252550,
      "end_ms": 254115,
      "text": "藏在湖北省博物馆，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00084",
      "start_ms": 254850,
      "end_ms": 257890,
      "text": "一九六五年出土于湖北江陵望山一号。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00085",
      "start_ms": 257930,
      "end_ms": 259930,
      "text": "楚牧出土的时候，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00086",
      "start_ms": 260090,
      "end_ms": 262500,
      "text": "一个工人伸手去拿手指，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00087",
      "start_ms": 262500,
      "end_ms": 263465,
      "text": "刚碰到剑刃，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00088",
      "start_ms": 263820,
      "end_ms": 265755,
      "text": "立刻被划了一道口子，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00089",
      "start_ms": 266100,
      "end_ms": 266825,
      "text": "鲜血直流。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00090",
      "start_ms": 267080,
      "end_ms": 268265,
      "text": "两千多年了，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00091",
      "start_ms": 268730,
      "end_ms": 270905,
      "text": "这把剑还跟刚磨出来的一样，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00092",
      "start_ms": 271670,
      "end_ms": 273835,
      "text": "剑身上刻着八个鸟篆字。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00093",
      "start_ms": 274600,
      "end_ms": 276910,
      "text": "越王纠遣制作用，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00094",
      "start_ms": 276910,
      "end_ms": 278665,
      "text": "剑纠浅就是勾践。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00095",
      "start_ms": 279590,
      "end_ms": 283505,
      "text": "为什么千年不锈科学家研究了好多年，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00096",
      "start_ms": 283960,
      "end_ms": 286645,
      "text": "一是铜锡合金配比近乎完美，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00097",
      "start_ms": 287150,
      "end_ms": 289595,
      "text": "含蓄量百分之十八到二十，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00098",
      "start_ms": 290110,
      "end_ms": 291085,
      "text": "杂质极低。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00099",
      "start_ms": 291800,
      "end_ms": 296725,
      "text": "二是墓视深埋地下棺裹密封几乎隔绝了空气。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00100",
      "start_ms": 297510,
      "end_ms": 298905,
      "text": "三世出土的时候，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00101",
      "start_ms": 299340,
      "end_ms": 301705,
      "text": "剑身上还套着七木剑鞘，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00102",
      "start_ms": 302200,
      "end_ms": 303560,
      "text": "天时地利人和，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00103",
      "start_ms": 303920,
      "end_ms": 304740,
      "text": "缺一不可。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00104",
      "start_ms": 304880,
      "end_ms": 309085,
      "text": "这把剑是春秋霸主留给后人的一把钥匙。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00105",
      "start_ms": 309680,
      "end_ms": 311520,
      "text": "打开了两千多年的时光。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00106",
      "start_ms": 312360,
      "end_ms": 313020,
      "text": "第六名，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00107",
      "start_ms": 313400,
      "end_ms": 318520,
      "text": "曾侯乙编钟这套编钟藏在湖北省博物馆，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00108",
      "start_ms": 319080,
      "end_ms": 327440,
      "text": "一九七八年出土于湖北随州六十五件青铜编钟总重量两千五百多公斤。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00109",
      "start_ms": 328180,
      "end_ms": 329300,
      "text": "最绝的是，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00110",
      "start_ms": 329300,
      "end_ms": 332140,
      "text": "它的音域跨五个半八度十二个，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00111",
      "start_ms": 332140,
      "end_ms": 332940,
      "text": "半音齐全，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00112",
      "start_ms": 333480,
      "end_ms": 335640,
      "text": "比现代钢琴只少一个八度，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00113",
      "start_ms": 336420,
      "end_ms": 343390,
      "text": "中体上刻着三千七百多字的霍金铭文标明了每一件中的发音。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00114",
      "start_ms": 343630,
      "end_ms": 344530,
      "text": "属于什么律？"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00115",
      "start_ms": 344570,
      "end_ms": 347410,
      "text": "跟其他诸侯国的律怎么对应？"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00116",
      "start_ms": 348430,
      "end_ms": 349930,
      "text": "这套编钟出土之前，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00117",
      "start_ms": 350290,
      "end_ms": 354290,
      "text": "学术界一直认为十二律是从西方传入中国的。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00118",
      "start_ms": 355010,
      "end_ms": 359210,
      "text": "他一出土这个论断被彻底推翻，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00119",
      "start_ms": 359630,
      "end_ms": 365010,
      "text": "两千四百多年前的中国人已经把音乐玩到了这个高度。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00120",
      "start_ms": 365690,
      "end_ms": 366990,
      "text": "从第十到第六，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00121",
      "start_ms": 367270,
      "end_ms": 369400,
      "text": "银湖封存了盛世的境。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00122",
      "start_ms": 369440,
      "end_ms": 369705,
      "text": "嗯嗯，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00123",
      "start_ms": 370240,
      "end_ms": 372565,
      "text": "御医封存了一个人的身体，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00124",
      "start_ms": 373150,
      "end_ms": 377215,
      "text": "玛瑙杯放出了石头里的兽勾践剑，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00125",
      "start_ms": 377510,
      "end_ms": 379385,
      "text": "打开了两千年的时光，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00126",
      "start_ms": 380200,
      "end_ms": 382555,
      "text": "编钟改写了世界音乐史。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00127",
      "start_ms": 382800,
      "end_ms": 385080,
      "text": "可这舞剑还不是最正果的，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00128",
      "start_ms": 385100,
      "end_ms": 388910,
      "text": "接下来第五到第一一件比一件震撼，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00129",
      "start_ms": 388970,
      "end_ms": 392530,
      "text": "有一件身上刻着武王伐纣的准确日期。"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00130",
      "start_ms": 392730,
      "end_ms": 394395,
      "text": "有一件八千多公斤，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00131",
      "start_ms": 394850,
      "end_ms": 397010,
      "text": "是全世界最重的青铜器，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00132",
      "start_ms": 397130,
      "end_ms": 401225,
      "text": "还有一件被称作中国文化遗产的标志，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00133",
      "start_ms": 401630,
      "end_ms": 402805,
      "text": "他们是哪几件？"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00134",
      "start_ms": 403240,
      "end_ms": 406205,
      "text": "凭什么排前面下集马上更新，"
    },
    {
      "segment_id": "v_ea0f263fd6138758_s00135",
      "start_ms": 406710,
      "end_ms": 410385,
      "text": "您先点个关注点开头像别走丢。"
    }
  ],
