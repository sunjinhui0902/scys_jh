  "duration_s": 69.24,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "哎，你什么意思啊，怎么到我这儿就剩半杯了。领导美满，美满，代表幸福美满，这一辈子美满就是一辈子美满啊。哎，我这肚子喝茶都能胖，领导，您那不叫胖，那叫宰相肚里能撑船，装的全是大事儿。小李，今天让你破费了。领导，您说这些您能来，就是我的荣幸，以后还有很多地方要向您请教。这鸭子是好鸭子，就是嘴硬，嘴硬，才守得住秘密来就来带什么礼物啊，都不是外人。领导，您都说了，不是外人，我一直都把您当长辈看，哪有晚辈看长辈空手来的道理啊。小李，最近表现不错啊，我的这个位置马上就该你坐了，我得提前敬你一杯。听这意思。领导是要高升了呀，我得提前敬领导一杯哈哈哈关注我，每天学点高情商，说话技巧，让你的路越走越宽。",
  "segments": [
    {
      "segment_id": "v_6a205508c9a02558_s00001",
      "start_ms": 110,
      "end_ms": 350,
      "text": "哎，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00002",
      "start_ms": 470,
      "end_ms": 1350,
      "text": "你什么意思啊，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00003",
      "start_ms": 1530,
      "end_ms": 3090,
      "text": "怎么到我这儿就剩半杯了。"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00004",
      "start_ms": 3430,
      "end_ms": 4410,
      "text": "领导美满，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00005",
      "start_ms": 4410,
      "end_ms": 4810,
      "text": "美满，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00006",
      "start_ms": 4990,
      "end_ms": 6050,
      "text": "代表幸福美满，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00007",
      "start_ms": 6350,
      "end_ms": 9535,
      "text": "这一辈子美满就是一辈子美满啊。"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00008",
      "start_ms": 12220,
      "end_ms": 12460,
      "text": "哎，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00009",
      "start_ms": 12840,
      "end_ms": 14500,
      "text": "我这肚子喝茶都能胖，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00010",
      "start_ms": 15420,
      "end_ms": 15880,
      "text": "领导，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00011",
      "start_ms": 16020,
      "end_ms": 16840,
      "text": "您那不叫胖，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00012",
      "start_ms": 17180,
      "end_ms": 18560,
      "text": "那叫宰相肚里能撑船，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00013",
      "start_ms": 18660,
      "end_ms": 19700,
      "text": "装的全是大事儿。"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00014",
      "start_ms": 22140,
      "end_ms": 22580,
      "text": "小李，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00015",
      "start_ms": 23260,
      "end_ms": 24500,
      "text": "今天让你破费了。"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00016",
      "start_ms": 24640,
      "end_ms": 25040,
      "text": "领导，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00017",
      "start_ms": 25200,
      "end_ms": 26760,
      "text": "您说这些您能来，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00018",
      "start_ms": 26780,
      "end_ms": 27660,
      "text": "就是我的荣幸，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00019",
      "start_ms": 27940,
      "end_ms": 29800,
      "text": "以后还有很多地方要向您请教。"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00020",
      "start_ms": 32640,
      "end_ms": 34060,
      "text": "这鸭子是好鸭子，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00021",
      "start_ms": 34920,
      "end_ms": 35680,
      "text": "就是嘴硬，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00022",
      "start_ms": 36200,
      "end_ms": 36640,
      "text": "嘴硬，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00023",
      "start_ms": 36760,
      "end_ms": 42410,
      "text": "才守得住秘密来就来带什么礼物啊，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00024",
      "start_ms": 42550,
      "end_ms": 43430,
      "text": "都不是外人。"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00025",
      "start_ms": 44290,
      "end_ms": 44750,
      "text": "领导，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00026",
      "start_ms": 44930,
      "end_ms": 45530,
      "text": "您都说了，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00027",
      "start_ms": 45530,
      "end_ms": 46190,
      "text": "不是外人，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00028",
      "start_ms": 46330,
      "end_ms": 47850,
      "text": "我一直都把您当长辈看，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00029",
      "start_ms": 48170,
      "end_ms": 50310,
      "text": "哪有晚辈看长辈空手来的道理啊。"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00030",
      "start_ms": 52230,
      "end_ms": 52670,
      "text": "小李，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00031",
      "start_ms": 52670,
      "end_ms": 53830,
      "text": "最近表现不错啊，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00032",
      "start_ms": 54190,
      "end_ms": 56050,
      "text": "我的这个位置马上就该你坐了，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00033",
      "start_ms": 56270,
      "end_ms": 57590,
      "text": "我得提前敬你一杯。"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00034",
      "start_ms": 58270,
      "end_ms": 59030,
      "text": "听这意思。"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00035",
      "start_ms": 59230,
      "end_ms": 60590,
      "text": "领导是要高升了呀，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00036",
      "start_ms": 60610,
      "end_ms": 64925,
      "text": "我得提前敬领导一杯哈哈哈关注我，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00037",
      "start_ms": 65220,
      "end_ms": 66500,
      "text": "每天学点高情商，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00038",
      "start_ms": 66500,
      "end_ms": 67280,
      "text": "说话技巧，"
    },
    {
      "segment_id": "v_6a205508c9a02558_s00039",
      "start_ms": 67460,
      "end_ms": 69025,
      "text": "让你的路越走越宽。"
    }
  ],
