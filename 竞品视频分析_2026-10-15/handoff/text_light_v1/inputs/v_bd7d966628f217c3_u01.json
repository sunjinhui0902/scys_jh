  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "人一定要多出去走走，其实啊去哪并不重要，关键是不能长时间的待在同一个地方。你看人和木在一起是一个修字人和山在一起，是一个仙字最好的休息啊，不是长时间待在同一个地方，而是多出去走走，呼吸天地，清气，感受万物有灵。山川草木阳光雨露能沐浴生心。黄帝内经中说，久坐伤肉，酒卧伤气，跳出眼前的方寸之地，去见不一样的风景，不一样的人舒展自己被困住的情绪，在路上慢慢治愈自己。",
  "segments": [
    {
      "segment_id": "v_bd7d966628f217c3_s00001",
      "start_ms": 700,
      "end_ms": 2040,
      "text": "人一定要多出去走走，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00002",
      "start_ms": 2220,
      "end_ms": 4140,
      "text": "其实啊去哪并不重要，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00003",
      "start_ms": 4520,
      "end_ms": 7620,
      "text": "关键是不能长时间的待在同一个地方。"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00004",
      "start_ms": 8320,
      "end_ms": 13000,
      "text": "你看人和木在一起是一个修字人和山在一起，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00005",
      "start_ms": 13440,
      "end_ms": 16220,
      "text": "是一个仙字最好的休息啊，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00006",
      "start_ms": 16240,
      "end_ms": 18140,
      "text": "不是长时间待在同一个地方，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00007",
      "start_ms": 18380,
      "end_ms": 19640,
      "text": "而是多出去走走，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00008",
      "start_ms": 19920,
      "end_ms": 20840,
      "text": "呼吸天地，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00009",
      "start_ms": 20900,
      "end_ms": 21320,
      "text": "清气，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00010",
      "start_ms": 21600,
      "end_ms": 23100,
      "text": "感受万物有灵。"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00011",
      "start_ms": 23800,
      "end_ms": 27180,
      "text": "山川草木阳光雨露能沐浴生心。"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00012",
      "start_ms": 27740,
      "end_ms": 28800,
      "text": "黄帝内经中说，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00013",
      "start_ms": 29080,
      "end_ms": 29965,
      "text": "久坐伤肉，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00014",
      "start_ms": 30550,
      "end_ms": 31570,
      "text": "酒卧伤气，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00015",
      "start_ms": 32170,
      "end_ms": 33770,
      "text": "跳出眼前的方寸之地，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00016",
      "start_ms": 34110,
      "end_ms": 35390,
      "text": "去见不一样的风景，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00017",
      "start_ms": 35530,
      "end_ms": 38650,
      "text": "不一样的人舒展自己被困住的情绪，"
    },
    {
      "segment_id": "v_bd7d966628f217c3_s00018",
      "start_ms": 39010,
      "end_ms": 41945,
      "text": "在路上慢慢治愈自己。"
    }
  ],
