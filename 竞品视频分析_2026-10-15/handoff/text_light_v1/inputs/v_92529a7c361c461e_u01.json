  "account": "锦绣千秋录",
  "source_title": "没有帝王封禅、不进五岳，凭一溪山水和八百年书院，坐上十大文化名山的头把交椅。\n#文化名山 #大美中国",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
