  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "何其有幸生于华夏，安于盛世，见证百年。我们生在红旗下，长在春风里，人民有信仰，国家有力量，民族有希望，目光所至皆华夏。五星红旗皆信仰生于盛世，当不负盛世，愿以无辈之青春，捍卫着盛世之中华，祝愿祖国母亲，繁荣昌，昌盛、国泰民安。嗯。",
  "segments": [
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00001",
      "start_ms": 410,
      "end_ms": 2550,
      "text": "何其有幸生于华夏，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00002",
      "start_ms": 2890,
      "end_ms": 3810,
      "text": "安于盛世，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00003",
      "start_ms": 4330,
      "end_ms": 5370,
      "text": "见证百年。"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00004",
      "start_ms": 6170,
      "end_ms": 7530,
      "text": "我们生在红旗下，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00005",
      "start_ms": 7970,
      "end_ms": 9070,
      "text": "长在春风里，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00006",
      "start_ms": 9590,
      "end_ms": 10630,
      "text": "人民有信仰，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00007",
      "start_ms": 10910,
      "end_ms": 12070,
      "text": "国家有力量，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00008",
      "start_ms": 12510,
      "end_ms": 13750,
      "text": "民族有希望，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00009",
      "start_ms": 14290,
      "end_ms": 16190,
      "text": "目光所至皆华夏。"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00010",
      "start_ms": 16750,
      "end_ms": 20630,
      "text": "五星红旗皆信仰生于盛世，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00011",
      "start_ms": 20910,
      "end_ms": 22130,
      "text": "当不负盛世，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00012",
      "start_ms": 22790,
      "end_ms": 24270,
      "text": "愿以无辈之青春，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00013",
      "start_ms": 24750,
      "end_ms": 27090,
      "text": "捍卫着盛世之中华，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00014",
      "start_ms": 27870,
      "end_ms": 29010,
      "text": "祝愿祖国母亲，"
    },
    {
      "segment_id": "v_1b6ba4fc13a7b7d4_s00015",
      "start_ms": 29430,
      "end_ms": 29935,
      "text": "繁荣昌，"
