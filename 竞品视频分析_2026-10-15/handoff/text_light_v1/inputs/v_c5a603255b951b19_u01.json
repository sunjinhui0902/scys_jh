  ],
  "duration_s": 352.517241,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "七十四岁的他倒在东京讲台上，生命最后一刻还在讲课。家人们。一九八五年六月十二日，日本东京大学一场数学演讲刚刚结束，掌声雷动。七十四岁的华罗庚结过鲜花正要致谢，突然身子往后一仰，倒在了讲台上，这一倒就再也没动起来。家人们，他倒下的地方是讲台，他留给这个世界，最后的画面是站在讲台上讲课的样子。可你知道吗？这个让全世界数学家竖起大拇指的人，六十年前是个连高中都没考上的笨孩子，老师嫌他字写的潦草，同学叫他呆子爹妈死了心，让他回家站柜台卖棉花。谁能想到那个趴在柜台上就着油灯算题的瘸腿小伙计。最后成了让清华大学破规矩，让剑桥大学抢着请的中国数学之父，你频频这反差，一个被全世界说不行的人，最后让全世界都服了气。更让人心酸的是，他一辈子只有一条好腿。十九岁那年，一场伤寒差点要了他的命，家里人连棺材都给他备好了，命是保住了左腿却废了，走路一瘸一拐，再也站不直。可就是这么一条残腿。晚年的时候，他跑遍了全国二十多个省工厂车间，他去田间地头，他也去修铁路的工人，听他讲建大桥的工人，听他讲连麦烧饼，炸油条的小贩都听过他讲课。有人劝他话痨，你是世界级大师，干这些是不是大材小用啊？他说，数学不落地，就是纸上谈兵。工人兄弟多产一吨钢工人兄兄多打一担粮比什么都强。家人们，他这辈子本来有三次机会，过得舒舒服服。第一次在剑桥全世界数学家挤破头的地方，他两年写出二十篇论文，整个欧洲都震动。剑桥想流淌，说他前途不可限量。可一九三八年抗战爆发，他收拾行李回国了，有人不理解，他说，我的根在中国，第二次在美国。一九四六年，他应邀去美国讲学，美国给他终身教授待遇，年薪高的惊人研究条件，全世界最好各一般人肯定就留下了。可他待了四年。一九五零年，新中国百废待兴，一穷二白。他写下八个字，良缘虽好，非久居之乡，归去来兮，带着全家登上了回国的轮船。第三次在晚年功成名就，本可以躺在功劳簿上享清福，他却拖着那条残腿，一头扎进工厂。有人说他傻放着轻浮，不想。他说，人有两个肩膀，一个肩膀把科学送到人民群众中去，另一个肩膀给年轻人当梯子，让他们踩着往上爬。一九八五年，七十四岁的他应邀去日本演讲，有人劝他年纪大了，身体又不好，就别去了，他说能讲一天就多讲一天。六月十二日，他倒在了讲台。上家人们，你想想，一个穷小子被叫了半辈子呆子，靠一盏油灯爬到了世界之巅，一个残疾人瘸着一条腿，把数学送进了千家万户。一个功成名就的老人，放着美国的高薪，不要望着轻浮不响，把最后的一口气都留在了讲课的讲台上。华罗庚这一辈子从烂泥里站起来，爬到世界之巅，又弯下腰，把学问送还给最普通的人。他这一生就信一句话，聪明在于勤奋，天才在于积累他用自己的实际行动，把这句话活成了真的真理。名言，一个人的出身可以穷腿可以残疾，可人的志气，谁也夺不走。国家可以穷家底可以薄，可一个人的脊梁，谁也压不弯。华罗庚就是中国科学界的脊梁，觉得话痨了不起的评论区大国之脊梁四个字。三部曲到这儿就讲完了，把三部曲从头看完的家人点个赞，收藏起来，随时翻出来讲，给孩子听、转发出去，让更多的人认识华罗庚，传承华罗庚精神，做中国的脊梁。关注我，每天带你了解一位名人背后的励志故事。",
  "segments": [
    {
      "segment_id": "v_c5a603255b951b19_s00001",
      "start_ms": 130,
      "end_ms": 3390,
      "text": "七十四岁的他倒在东京讲台上，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00002",
      "start_ms": 4170,
      "end_ms": 7410,
      "text": "生命最后一刻还在讲课。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00003",
      "start_ms": 8470,
      "end_ms": 9090,
      "text": "家人们。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00004",
      "start_ms": 9390,
      "end_ms": 11530,
      "text": "一九八五年六月十二日，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00005",
      "start_ms": 12110,
      "end_ms": 16430,
      "text": "日本东京大学一场数学演讲刚刚结束，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00006",
      "start_ms": 16990,
      "end_ms": 18170,
      "text": "掌声雷动。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00007",
      "start_ms": 19190,
      "end_ms": 23310,
      "text": "七十四岁的华罗庚结过鲜花正要致谢，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00008",
      "start_ms": 23630,
      "end_ms": 25290,
      "text": "突然身子往后一仰，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00009",
      "start_ms": 25650,
      "end_ms": 26970,
      "text": "倒在了讲台上，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00010",
      "start_ms": 27870,
      "end_ms": 30540,
      "text": "这一倒就再也没动起来。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00011",
      "start_ms": 32000,
      "end_ms": 32620,
      "text": "家人们，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00012",
      "start_ms": 33020,
      "end_ms": 35200,
      "text": "他倒下的地方是讲台，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00013",
      "start_ms": 35560,
      "end_ms": 36680,
      "text": "他留给这个世界，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00014",
      "start_ms": 36680,
      "end_ms": 40400,
      "text": "最后的画面是站在讲台上讲课的样子。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00015",
      "start_ms": 41240,
      "end_ms": 42200,
      "text": "可你知道吗？"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00016",
      "start_ms": 42560,
      "end_ms": 45840,
      "text": "这个让全世界数学家竖起大拇指的人，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00017",
      "start_ms": 46360,
      "end_ms": 51120,
      "text": "六十年前是个连高中都没考上的笨孩子，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00018",
      "start_ms": 51460,
      "end_ms": 53500,
      "text": "老师嫌他字写的潦草，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00019",
      "start_ms": 54080,
      "end_ms": 57160,
      "text": "同学叫他呆子爹妈死了心，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00020",
      "start_ms": 57480,
      "end_ms": 59855,
      "text": "让他回家站柜台卖棉花。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00021",
      "start_ms": 60560,
      "end_ms": 66365,
      "text": "谁能想到那个趴在柜台上就着油灯算题的瘸腿小伙计。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00022",
      "start_ms": 67030,
      "end_ms": 70275,
      "text": "最后成了让清华大学破规矩，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00023",
      "start_ms": 70750,
      "end_ms": 74750,
      "text": "让剑桥大学抢着请的中国数学之父，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00024",
      "start_ms": 74890,
      "end_ms": 76475,
      "text": "你频频这反差，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00025",
      "start_ms": 77010,
      "end_ms": 79115,
      "text": "一个被全世界说不行的人，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00026",
      "start_ms": 79740,
      "end_ms": 81425,
      "text": "最后让全世界都服了气。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00027",
      "start_ms": 82340,
      "end_ms": 83795,
      "text": "更让人心酸的是，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00028",
      "start_ms": 84070,
      "end_ms": 86435,
      "text": "他一辈子只有一条好腿。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00029",
      "start_ms": 87710,
      "end_ms": 88625,
      "text": "十九岁那年，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00030",
      "start_ms": 89150,
      "end_ms": 91345,
      "text": "一场伤寒差点要了他的命，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00031",
      "start_ms": 91890,
      "end_ms": 94645,
      "text": "家里人连棺材都给他备好了，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00032",
      "start_ms": 95210,
      "end_ms": 97975,
      "text": "命是保住了左腿却废了，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00033",
      "start_ms": 98430,
      "end_ms": 99870,
      "text": "走路一瘸一拐，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00034",
      "start_ms": 100130,
      "end_ms": 101175,
      "text": "再也站不直。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00035",
      "start_ms": 101850,
      "end_ms": 103495,
      "text": "可就是这么一条残腿。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00036",
      "start_ms": 104020,
      "end_ms": 105095,
      "text": "晚年的时候，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00037",
      "start_ms": 105440,
      "end_ms": 109090,
      "text": "他跑遍了全国二十多个省工厂车间，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00038",
      "start_ms": 109090,
      "end_ms": 110830,
      "text": "他去田间地头，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00039",
      "start_ms": 110830,
      "end_ms": 112550,
      "text": "他也去修铁路的工人，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00040",
      "start_ms": 112550,
      "end_ms": 114930,
      "text": "听他讲建大桥的工人，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00041",
      "start_ms": 114930,
      "end_ms": 117125,
      "text": "听他讲连麦烧饼，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00042",
      "start_ms": 117860,
      "end_ms": 121240,
      "text": "炸油条的小贩都听过他讲课。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00043",
      "start_ms": 122100,
      "end_ms": 124540,
      "text": "有人劝他话痨，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00044",
      "start_ms": 125300,
      "end_ms": 126880,
      "text": "你是世界级大师，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00045",
      "start_ms": 127360,
      "end_ms": 129620,
      "text": "干这些是不是大材小用啊？"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00046",
      "start_ms": 130440,
      "end_ms": 130940,
      "text": "他说，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00047",
      "start_ms": 131820,
      "end_ms": 132920,
      "text": "数学不落地，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00048",
      "start_ms": 133020,
      "end_ms": 134300,
      "text": "就是纸上谈兵。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00049",
      "start_ms": 135160,
      "end_ms": 142080,
      "text": "工人兄弟多产一吨钢工人兄兄多打一担粮比什么都强。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00050",
      "start_ms": 142580,
      "end_ms": 143200,
      "text": "家人们，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00051",
      "start_ms": 143440,
      "end_ms": 146500,
      "text": "他这辈子本来有三次机会，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00052",
      "start_ms": 146800,
      "end_ms": 147940,
      "text": "过得舒舒服服。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00053",
      "start_ms": 148300,
      "end_ms": 153770,
      "text": "第一次在剑桥全世界数学家挤破头的地方，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00054",
      "start_ms": 153830,
      "end_ms": 155630,
      "text": "他两年写出二十篇论文，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00055",
      "start_ms": 156410,
      "end_ms": 157950,
      "text": "整个欧洲都震动。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00056",
      "start_ms": 159090,
      "end_ms": 160290,
      "text": "剑桥想流淌，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00057",
      "start_ms": 160570,
      "end_ms": 162210,
      "text": "说他前途不可限量。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00058",
      "start_ms": 162570,
      "end_ms": 164830,
      "text": "可一九三八年抗战爆发，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00059",
      "start_ms": 165670,
      "end_ms": 168730,
      "text": "他收拾行李回国了，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00060",
      "start_ms": 169150,
      "end_ms": 170050,
      "text": "有人不理解，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00061",
      "start_ms": 170170,
      "end_ms": 170590,
      "text": "他说，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00062",
      "start_ms": 170850,
      "end_ms": 172370,
      "text": "我的根在中国，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00063",
      "start_ms": 173170,
      "end_ms": 174650,
      "text": "第二次在美国。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00064",
      "start_ms": 175610,
      "end_ms": 176690,
      "text": "一九四六年，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00065",
      "start_ms": 176890,
      "end_ms": 179325,
      "text": "他应邀去美国讲学，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00066",
      "start_ms": 179900,
      "end_ms": 181825,
      "text": "美国给他终身教授待遇，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00067",
      "start_ms": 182260,
      "end_ms": 185170,
      "text": "年薪高的惊人研究条件，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00068",
      "start_ms": 185270,
      "end_ms": 189475,
      "text": "全世界最好各一般人肯定就留下了。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00069",
      "start_ms": 190460,
      "end_ms": 191715,
      "text": "可他待了四年。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00070",
      "start_ms": 192170,
      "end_ms": 193305,
      "text": "一九五零年，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00071",
      "start_ms": 193540,
      "end_ms": 194980,
      "text": "新中国百废待兴，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00072",
      "start_ms": 195180,
      "end_ms": 196005,
      "text": "一穷二白。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00073",
      "start_ms": 196810,
      "end_ms": 197870,
      "text": "他写下八个字，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00074",
      "start_ms": 197970,
      "end_ms": 199075,
      "text": "良缘虽好，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00075",
      "start_ms": 199380,
      "end_ms": 200625,
      "text": "非久居之乡，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00076",
      "start_ms": 201200,
      "end_ms": 202105,
      "text": "归去来兮，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00077",
      "start_ms": 202500,
      "end_ms": 205355,
      "text": "带着全家登上了回国的轮船。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00078",
      "start_ms": 207360,
      "end_ms": 210805,
      "text": "第三次在晚年功成名就，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00079",
      "start_ms": 211230,
      "end_ms": 213605,
      "text": "本可以躺在功劳簿上享清福，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00080",
      "start_ms": 214140,
      "end_ms": 215845,
      "text": "他却拖着那条残腿，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00081",
      "start_ms": 216190,
      "end_ms": 217565,
      "text": "一头扎进工厂。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00082",
      "start_ms": 218100,
      "end_ms": 220210,
      "text": "有人说他傻放着轻浮，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00083",
      "start_ms": 220210,
      "end_ms": 220625,
      "text": "不想。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00084",
      "start_ms": 221040,
      "end_ms": 221480,
      "text": "他说，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00085",
      "start_ms": 222000,
      "end_ms": 223345,
      "text": "人有两个肩膀，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00086",
      "start_ms": 223940,
      "end_ms": 228675,
      "text": "一个肩膀把科学送到人民群众中去，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00087",
      "start_ms": 229580,
      "end_ms": 233135,
      "text": "另一个肩膀给年轻人当梯子，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00088",
      "start_ms": 233530,
      "end_ms": 235190,
      "text": "让他们踩着往上爬。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00089",
      "start_ms": 235490,
      "end_ms": 236665,
      "text": "一九八五年，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00090",
      "start_ms": 237050,
      "end_ms": 240285,
      "text": "七十四岁的他应邀去日本演讲，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00091",
      "start_ms": 241310,
      "end_ms": 243250,
      "text": "有人劝他年纪大了，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00092",
      "start_ms": 243250,
      "end_ms": 244175,
      "text": "身体又不好，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00093",
      "start_ms": 244480,
      "end_ms": 245205,
      "text": "就别去了，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00094",
      "start_ms": 246200,
      "end_ms": 249395,
      "text": "他说能讲一天就多讲一天。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00095",
      "start_ms": 249960,
      "end_ms": 250965,
      "text": "六月十二日，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00096",
      "start_ms": 251370,
      "end_ms": 252570,
      "text": "他倒在了讲台。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00097",
      "start_ms": 252570,
      "end_ms": 253905,
      "text": "上家人们，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00098",
      "start_ms": 254340,
      "end_ms": 254975,
      "text": "你想想，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00099",
      "start_ms": 255370,
      "end_ms": 258535,
      "text": "一个穷小子被叫了半辈子呆子，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00100",
      "start_ms": 259020,
      "end_ms": 261555,
      "text": "靠一盏油灯爬到了世界之巅，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00101",
      "start_ms": 262090,
      "end_ms": 264655,
      "text": "一个残疾人瘸着一条腿，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00102",
      "start_ms": 264970,
      "end_ms": 267135,
      "text": "把数学送进了千家万户。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00103",
      "start_ms": 267830,
      "end_ms": 269545,
      "text": "一个功成名就的老人，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00104",
      "start_ms": 269840,
      "end_ms": 271160,
      "text": "放着美国的高薪，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00105",
      "start_ms": 271160,
      "end_ms": 273095,
      "text": "不要望着轻浮不响，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00106",
      "start_ms": 274020,
      "end_ms": 278825,
      "text": "把最后的一口气都留在了讲课的讲台上。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00107",
      "start_ms": 280020,
      "end_ms": 283485,
      "text": "华罗庚这一辈子从烂泥里站起来，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00108",
      "start_ms": 284440,
      "end_ms": 285675,
      "text": "爬到世界之巅，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00109",
      "start_ms": 287550,
      "end_ms": 288435,
      "text": "又弯下腰，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00110",
      "start_ms": 289030,
      "end_ms": 291095,
      "text": "把学问送还给最普通的人。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00111",
      "start_ms": 291860,
      "end_ms": 293565,
      "text": "他这一生就信一句话，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00112",
      "start_ms": 294280,
      "end_ms": 295915,
      "text": "聪明在于勤奋，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00113",
      "start_ms": 296440,
      "end_ms": 301235,
      "text": "天才在于积累他用自己的实际行动，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00114",
      "start_ms": 301840,
      "end_ms": 303820,
      "text": "把这句话活成了真的真理。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00115",
      "start_ms": 303880,
      "end_ms": 304295,
      "text": "名言，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00116",
      "start_ms": 304890,
      "end_ms": 308205,
      "text": "一个人的出身可以穷腿可以残疾，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00117",
      "start_ms": 308490,
      "end_ms": 309445,
      "text": "可人的志气，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00118",
      "start_ms": 309780,
      "end_ms": 310785,
      "text": "谁也夺不走。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00119",
      "start_ms": 311040,
      "end_ms": 313205,
      "text": "国家可以穷家底可以薄，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00120",
      "start_ms": 313780,
      "end_ms": 315020,
      "text": "可一个人的脊梁，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00121",
      "start_ms": 315260,
      "end_ms": 316465,
      "text": "谁也压不弯。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00122",
      "start_ms": 317140,
      "end_ms": 320135,
      "text": "华罗庚就是中国科学界的脊梁，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00123",
      "start_ms": 320510,
      "end_ms": 324625,
      "text": "觉得话痨了不起的评论区大国之脊梁四个字。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00124",
      "start_ms": 325260,
      "end_ms": 328465,
      "text": "三部曲到这儿就讲完了，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00125",
      "start_ms": 329410,
      "end_ms": 332795,
      "text": "把三部曲从头看完的家人点个赞，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00126",
      "start_ms": 333110,
      "end_ms": 333990,
      "text": "收藏起来，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00127",
      "start_ms": 334170,
      "end_ms": 335750,
      "text": "随时翻出来讲，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00128",
      "start_ms": 335750,
      "end_ms": 338565,
      "text": "给孩子听、转发出去，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00129",
      "start_ms": 339580,
      "end_ms": 341905,
      "text": "让更多的人认识华罗庚，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00130",
      "start_ms": 342470,
      "end_ms": 344285,
      "text": "传承华罗庚精神，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00131",
      "start_ms": 344730,
      "end_ms": 346065,
      "text": "做中国的脊梁。"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00132",
      "start_ms": 346830,
      "end_ms": 347415,
      "text": "关注我，"
    },
    {
      "segment_id": "v_c5a603255b951b19_s00133",
      "start_ms": 347900,
      "end_ms": 352395,
      "text": "每天带你了解一位名人背后的励志故事。"
    }
  ],
