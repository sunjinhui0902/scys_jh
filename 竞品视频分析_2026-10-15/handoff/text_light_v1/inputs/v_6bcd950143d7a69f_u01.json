  "core_text": "今年中秋的广告语是一年，一中秋，一家一平安，灯火应万家。愿诸邪必退，家人健康平安。愿你心中梦圆，左右逢源。生活一年顺一年，顺风顺水又顺意，顺风顺水皆平安。",
  "segments": [
    {
      "segment_id": "v_6bcd950143d7a69f_s00001",
      "start_ms": 150,
      "end_ms": 2430,
      "text": "今年中秋的广告语是一年，"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00002",
      "start_ms": 2450,
      "end_ms": 3090,
      "text": "一中秋，"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00003",
      "start_ms": 3450,
      "end_ms": 4930,
      "text": "一家一平安，"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00004",
      "start_ms": 5530,
      "end_ms": 6670,
      "text": "灯火应万家。"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00005",
      "start_ms": 6950,
      "end_ms": 8109,
      "text": "愿诸邪必退，"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00006",
      "start_ms": 8410,
      "end_ms": 9830,
      "text": "家人健康平安。"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00007",
      "start_ms": 10490,
      "end_ms": 11690,
      "text": "愿你心中梦圆，"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00008",
      "start_ms": 11930,
      "end_ms": 12830,
      "text": "左右逢源。"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00009",
      "start_ms": 13310,
      "end_ms": 15390,
      "text": "生活一年顺一年，"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00010",
      "start_ms": 15890,
      "end_ms": 17610,
      "text": "顺风顺水又顺意，"
    },
    {
      "segment_id": "v_6bcd950143d7a69f_s00011",
      "start_ms": 18070,
      "end_ms": 20905,
      "text": "顺风顺水皆平安。"
    }
