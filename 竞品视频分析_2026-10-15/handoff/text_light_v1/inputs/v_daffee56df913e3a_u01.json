  "duration_s": 37.823855,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "人为什么要经常出去玩？因为长时间呆在家里，会灵气尽失，身心疲惫。黄帝内经中说，久坐伤肉，久卧伤气，越是在房间里面呆久了，越是虚弱。你看人和梦在一起是修字人和山在一起，便是仙字最好的休息啊。不是躺在床上，也不是窝在沙发里，而是到大自然中到山里面来，呼吸天地清气，感受万物有灵。山川草木，阳光雨露，能沐浴身心走出去，运气才会好。走运，走运就是这么来的。",
  "segments": [
    {
      "segment_id": "v_daffee56df913e3a_s00001",
      "start_ms": 280,
      "end_ms": 1680,
      "text": "人为什么要经常出去玩？"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00002",
      "start_ms": 1920,
      "end_ms": 3300,
      "text": "因为长时间呆在家里，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00003",
      "start_ms": 3360,
      "end_ms": 4380,
      "text": "会灵气尽失，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00004",
      "start_ms": 4640,
      "end_ms": 5700,
      "text": "身心疲惫。"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00005",
      "start_ms": 6100,
      "end_ms": 7080,
      "text": "黄帝内经中说，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00006",
      "start_ms": 7300,
      "end_ms": 8260,
      "text": "久坐伤肉，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00007",
      "start_ms": 8500,
      "end_ms": 9520,
      "text": "久卧伤气，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00008",
      "start_ms": 10020,
      "end_ms": 11560,
      "text": "越是在房间里面呆久了，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00009",
      "start_ms": 11620,
      "end_ms": 12580,
      "text": "越是虚弱。"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00010",
      "start_ms": 12900,
      "end_ms": 16940,
      "text": "你看人和梦在一起是修字人和山在一起，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00011",
      "start_ms": 17240,
      "end_ms": 19820,
      "text": "便是仙字最好的休息啊。"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00012",
      "start_ms": 19860,
      "end_ms": 20900,
      "text": "不是躺在床上，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00013",
      "start_ms": 21040,
      "end_ms": 22320,
      "text": "也不是窝在沙发里，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00014",
      "start_ms": 22620,
      "end_ms": 24960,
      "text": "而是到大自然中到山里面来，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00015",
      "start_ms": 25160,
      "end_ms": 26520,
      "text": "呼吸天地清气，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00016",
      "start_ms": 26780,
      "end_ms": 28260,
      "text": "感受万物有灵。"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00017",
      "start_ms": 28840,
      "end_ms": 29815,
      "text": "山川草木，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00018",
      "start_ms": 30090,
      "end_ms": 30850,
      "text": "阳光雨露，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00019",
      "start_ms": 31010,
      "end_ms": 32990,
      "text": "能沐浴身心走出去，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00020",
      "start_ms": 33250,
      "end_ms": 34230,
      "text": "运气才会好。"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00021",
      "start_ms": 34570,
      "end_ms": 34970,
      "text": "走运，"
    },
    {
      "segment_id": "v_daffee56df913e3a_s00022",
      "start_ms": 34970,
      "end_ms": 37145,
      "text": "走运就是这么来的。"
    }
  ],
