  ],
  "duration_s": 107.320998,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "小姑娘，你人踏实能干，我儿子还单身，要不你来当我儿媳妇？领导，您太抬举我了，能跟着您学习，已经是我的幸运。您儿子这么优秀，工作上我一定好好干，不给您丢脸。身上喷这么香，下班是需要约会吗？领导卖香水的说，喷这款香水会遇到贵人，我看你最近是越来越精神了啊，那是因为沾了领导，您的顾事，光跟着您干事，气色都不敢差。年轻就是好啊，年轻就是还不够沉稳，还要向您多学习，我们才能变得更优秀。小李啊，我看你穿衣品味不错嘛，思想上领导的高度我望尘莫及，只能在衣品上找些自我安慰了。小李，你这菜点的也太多了，领导菜点的再多，也比不上平时您对我的照顾多这杯酒。我先敬您啊，这藕是好藕啊，就是心眼儿太多了。领导藕虽然心眼多，但也是您的下酒菜呀。哈哈，这鸭子是好鸭子，就是嘴硬，嘴硬，才守得住秘密。哈哈哈，你酒量挺好的呀。领导，您可抬举我了，我平时真不太能喝。这不今天和您在一起吃饭，高兴啊，这一高兴就多贪了。几杯不喝就是看不起我。领导，我不是看不起您，我是看不起病。嗯，哈哈，关注我，每天学点儿高情商，说话技巧，让你的路越走越宽。",
  "segments": [
    {
      "segment_id": "v_9d1072a5cda6796c_s00001",
      "start_ms": 110,
      "end_ms": 710,
      "text": "小姑娘，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00002",
      "start_ms": 1030,
      "end_ms": 2190,
      "text": "你人踏实能干，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00003",
      "start_ms": 2430,
      "end_ms": 3510,
      "text": "我儿子还单身，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00004",
      "start_ms": 3790,
      "end_ms": 5250,
      "text": "要不你来当我儿媳妇？"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00005",
      "start_ms": 6230,
      "end_ms": 6690,
      "text": "领导，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00006",
      "start_ms": 6810,
      "end_ms": 7930,
      "text": "您太抬举我了，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00007",
      "start_ms": 8170,
      "end_ms": 9190,
      "text": "能跟着您学习，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00008",
      "start_ms": 9330,
      "end_ms": 10390,
      "text": "已经是我的幸运。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00009",
      "start_ms": 10590,
      "end_ms": 11650,
      "text": "您儿子这么优秀，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00010",
      "start_ms": 12070,
      "end_ms": 13550,
      "text": "工作上我一定好好干，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00011",
      "start_ms": 13630,
      "end_ms": 14450,
      "text": "不给您丢脸。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00012",
      "start_ms": 15910,
      "end_ms": 16970,
      "text": "身上喷这么香，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00013",
      "start_ms": 17130,
      "end_ms": 18350,
      "text": "下班是需要约会吗？"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00014",
      "start_ms": 19190,
      "end_ms": 21090,
      "text": "领导卖香水的说，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00015",
      "start_ms": 21090,
      "end_ms": 22710,
      "text": "喷这款香水会遇到贵人，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00016",
      "start_ms": 25590,
      "end_ms": 27410,
      "text": "我看你最近是越来越精神了啊，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00017",
      "start_ms": 27410,
      "end_ms": 29550,
      "text": "那是因为沾了领导，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00018",
      "start_ms": 29550,
      "end_ms": 30000,
      "text": "您的顾事，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00019",
      "start_ms": 30060,
      "end_ms": 31220,
      "text": "光跟着您干事，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00020",
      "start_ms": 31360,
      "end_ms": 32885,
      "text": "气色都不敢差。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00021",
      "start_ms": 35280,
      "end_ms": 36480,
      "text": "年轻就是好啊，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00022",
      "start_ms": 38100,
      "end_ms": 39660,
      "text": "年轻就是还不够沉稳，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00023",
      "start_ms": 40020,
      "end_ms": 41280,
      "text": "还要向您多学习，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00024",
      "start_ms": 41640,
      "end_ms": 42820,
      "text": "我们才能变得更优秀。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00025",
      "start_ms": 44080,
      "end_ms": 44800,
      "text": "小李啊，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00026",
      "start_ms": 45220,
      "end_ms": 46960,
      "text": "我看你穿衣品味不错嘛，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00027",
      "start_ms": 48060,
      "end_ms": 50300,
      "text": "思想上领导的高度我望尘莫及，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00028",
      "start_ms": 50580,
      "end_ms": 52340,
      "text": "只能在衣品上找些自我安慰了。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00029",
      "start_ms": 53780,
      "end_ms": 54260,
      "text": "小李，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00030",
      "start_ms": 54600,
      "end_ms": 56340,
      "text": "你这菜点的也太多了，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00031",
      "start_ms": 56740,
      "end_ms": 58320,
      "text": "领导菜点的再多，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00032",
      "start_ms": 58340,
      "end_ms": 60900,
      "text": "也比不上平时您对我的照顾多这杯酒。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00033",
      "start_ms": 60900,
      "end_ms": 62700,
      "text": "我先敬您啊，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00034",
      "start_ms": 63880,
      "end_ms": 65335,
      "text": "这藕是好藕啊，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00035",
      "start_ms": 65860,
      "end_ms": 67135,
      "text": "就是心眼儿太多了。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00036",
      "start_ms": 67840,
      "end_ms": 69480,
      "text": "领导藕虽然心眼多，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00037",
      "start_ms": 69480,
      "end_ms": 70725,
      "text": "但也是您的下酒菜呀。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00038",
      "start_ms": 71710,
      "end_ms": 72290,
      "text": "哈哈，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00039",
      "start_ms": 73530,
      "end_ms": 75135,
      "text": "这鸭子是好鸭子，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00040",
      "start_ms": 75540,
      "end_ms": 76365,
      "text": "就是嘴硬，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00041",
      "start_ms": 77360,
      "end_ms": 77740,
      "text": "嘴硬，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00042",
      "start_ms": 77740,
      "end_ms": 78835,
      "text": "才守得住秘密。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00043",
      "start_ms": 79210,
      "end_ms": 79790,
      "text": "哈哈哈，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00044",
      "start_ms": 81370,
      "end_ms": 82725,
      "text": "你酒量挺好的呀。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00045",
      "start_ms": 82980,
      "end_ms": 83360,
      "text": "领导，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00046",
      "start_ms": 83380,
      "end_ms": 84340,
      "text": "您可抬举我了，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00047",
      "start_ms": 84340,
      "end_ms": 85515,
      "text": "我平时真不太能喝。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00048",
      "start_ms": 85790,
      "end_ms": 87130,
      "text": "这不今天和您在一起吃饭，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00049",
      "start_ms": 87130,
      "end_ms": 87705,
      "text": "高兴啊，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00050",
      "start_ms": 87920,
      "end_ms": 88860,
      "text": "这一高兴就多贪了。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00051",
      "start_ms": 88860,
      "end_ms": 93335,
      "text": "几杯不喝就是看不起我。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00052",
      "start_ms": 93780,
      "end_ms": 94285,
      "text": "领导，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00053",
      "start_ms": 94890,
      "end_ms": 96065,
      "text": "我不是看不起您，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00054",
      "start_ms": 96790,
      "end_ms": 97755,
      "text": "我是看不起病。"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00055",
      "start_ms": 99660,
      "end_ms": 99860,
      "text": "嗯，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00056",
      "start_ms": 99860,
      "end_ms": 100220,
      "text": "哈哈，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00057",
      "start_ms": 101480,
      "end_ms": 102135,
      "text": "关注我，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00058",
      "start_ms": 102410,
      "end_ms": 103950,
      "text": "每天学点儿高情商，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00059",
      "start_ms": 103990,
      "end_ms": 104855,
      "text": "说话技巧，"
    },
    {
      "segment_id": "v_9d1072a5cda6796c_s00060",
      "start_ms": 105260,
      "end_ms": 107105,
      "text": "让你的路越走越宽。"
    }
  ],
