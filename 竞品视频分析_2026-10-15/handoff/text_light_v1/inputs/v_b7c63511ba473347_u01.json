  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "你一定要告诉孩子，最硬的后台是手里的存款，最铁的关系是自身的能力最大的。靠山是健康的身体最稳的依靠，是强大的人品，最长久的好运是端正的人品。终有一天，你会发现，人生没有永恒的靠山，能托住你一生的，从来只有你自己。",
  "segments": [
    {
      "segment_id": "v_b7c63511ba473347_s00001",
      "start_ms": 290,
      "end_ms": 1910,
      "text": "你一定要告诉孩子，"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00002",
      "start_ms": 1910,
      "end_ms": 4950,
      "text": "最硬的后台是手里的存款，"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00003",
      "start_ms": 4950,
      "end_ms": 8290,
      "text": "最铁的关系是自身的能力最大的。"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00004",
      "start_ms": 8290,
      "end_ms": 11910,
      "text": "靠山是健康的身体最稳的依靠，"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00005",
      "start_ms": 12490,
      "end_ms": 13810,
      "text": "是强大的人品，"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00006",
      "start_ms": 14350,
      "end_ms": 16990,
      "text": "最长久的好运是端正的人品。"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00007",
      "start_ms": 17470,
      "end_ms": 18230,
      "text": "终有一天，"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00008",
      "start_ms": 18530,
      "end_ms": 19310,
      "text": "你会发现，"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00009",
      "start_ms": 19970,
      "end_ms": 21630,
      "text": "人生没有永恒的靠山，"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00010",
      "start_ms": 22090,
      "end_ms": 23430,
      "text": "能托住你一生的，"
    },
    {
      "segment_id": "v_b7c63511ba473347_s00011",
      "start_ms": 24010,
      "end_ms": 27715,
      "text": "从来只有你自己。"
    }
  ],
