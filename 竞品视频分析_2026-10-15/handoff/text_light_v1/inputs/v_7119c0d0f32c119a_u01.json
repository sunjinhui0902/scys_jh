  ],
  "duration_s": 153.040998,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "谁学一声狗叫，我就给他一千块，祝领导家庭旺，事业旺以后日子旺，上家旺，一共四生四千块，这鸭子是好鸭子，就是嘴硬，嘴硬，才守得住秘密，你酒量挺好的呀。领导，您可抬举我了，我平时真不太能喝，这不今天和您在一起吃饭，高兴啊，这一高兴就多贪了几杯。小李，最近表现不错啊，我的这个位置马上就该你坐了，我得提前敬你一杯。听这意思，领导是要高升了呀，我得提前敬领导一杯。小王，今天让你破费了。领导，您说这些您能来，就是我的荣幸，以后还有很多地方要向您请教。这偶是好偶啊，就是心眼儿太多了。领导藕虽然心眼多，但也是您的下酒菜啊。哈哈哈哈，你这菜点的也太多了，领导菜点的再多，也比不上平时您对我的照顾。多这杯酒，我先敬您啊啊，你一开口就让人喜欢你，你是怎么做到的？因为我一直在看这本把话说的恰到好处，这个世界上谁都不会拒绝，那些会说话、会来事儿的人。假如你不爱说话，不爱争辩，甚至恐惧社交，推荐你读完这本把话说的恰到好处，让你轻松摆平各种社交场合，每天看两页，每一个场景慢慢练，你就会变成一个会说话、懂交际的人。在这本书里有一句话，我特别欣赏，他，写的是面对别人夸你优秀时，你可以回，那是不优秀点儿，怎么能和你做朋友呢？当有人说你真聪明，你就回近朱者赤，和你在一起啊，熏都熏出来了当领导跟你说辛苦了，你就回领导，这都是我应该做的。强将手下无弱兵，我怎么能给您丢脸呢？当我看到这段的时候，真是让我欲解心开啊。每一句都很有意思，就是手把手教我们在不同场景之下应该怎么说。书籍的内容和我现在展示的是一模一样的，你就放心的拿回去看，就是一句一句的教你，让你轻松摆平各种社交场合，但凡学会三分，你就能把人际关系拿捏的死死的。这本书真的可以帮助到大家。",
  "segments": [
    {
      "segment_id": "v_7119c0d0f32c119a_s00001",
      "start_ms": 340,
      "end_ms": 1560,
      "text": "谁学一声狗叫，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00002",
      "start_ms": 2220,
      "end_ms": 3615,
      "text": "我就给他一千块，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00003",
      "start_ms": 7310,
      "end_ms": 8430,
      "text": "祝领导家庭旺，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00004",
      "start_ms": 8530,
      "end_ms": 9870,
      "text": "事业旺以后日子旺，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00005",
      "start_ms": 9870,
      "end_ms": 10410,
      "text": "上家旺，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00006",
      "start_ms": 10450,
      "end_ms": 11670,
      "text": "一共四生四千块，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00007",
      "start_ms": 14390,
      "end_ms": 15970,
      "text": "这鸭子是好鸭子，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00008",
      "start_ms": 16890,
      "end_ms": 17710,
      "text": "就是嘴硬，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00009",
      "start_ms": 18570,
      "end_ms": 19090,
      "text": "嘴硬，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00010",
      "start_ms": 19090,
      "end_ms": 20050,
      "text": "才守得住秘密，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00011",
      "start_ms": 23330,
      "end_ms": 24590,
      "text": "你酒量挺好的呀。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00012",
      "start_ms": 25030,
      "end_ms": 25430,
      "text": "领导，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00013",
      "start_ms": 25510,
      "end_ms": 26470,
      "text": "您可抬举我了，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00014",
      "start_ms": 26470,
      "end_ms": 27710,
      "text": "我平时真不太能喝，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00015",
      "start_ms": 28070,
      "end_ms": 29450,
      "text": "这不今天和您在一起吃饭，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00016",
      "start_ms": 29450,
      "end_ms": 29970,
      "text": "高兴啊，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00017",
      "start_ms": 30190,
      "end_ms": 32035,
      "text": "这一高兴就多贪了几杯。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00018",
      "start_ms": 34440,
      "end_ms": 34880,
      "text": "小李，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00019",
      "start_ms": 34880,
      "end_ms": 35960,
      "text": "最近表现不错啊，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00020",
      "start_ms": 36260,
      "end_ms": 38220,
      "text": "我的这个位置马上就该你坐了，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00021",
      "start_ms": 38440,
      "end_ms": 39640,
      "text": "我得提前敬你一杯。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00022",
      "start_ms": 40160,
      "end_ms": 40900,
      "text": "听这意思，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00023",
      "start_ms": 41040,
      "end_ms": 42220,
      "text": "领导是要高升了呀，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00024",
      "start_ms": 42380,
      "end_ms": 43680,
      "text": "我得提前敬领导一杯。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00025",
      "start_ms": 46360,
      "end_ms": 46820,
      "text": "小王，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00026",
      "start_ms": 47380,
      "end_ms": 48860,
      "text": "今天让你破费了。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00027",
      "start_ms": 49120,
      "end_ms": 49520,
      "text": "领导，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00028",
      "start_ms": 49680,
      "end_ms": 51120,
      "text": "您说这些您能来，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00029",
      "start_ms": 51140,
      "end_ms": 51900,
      "text": "就是我的荣幸，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00030",
      "start_ms": 52240,
      "end_ms": 54925,
      "text": "以后还有很多地方要向您请教。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00031",
      "start_ms": 57610,
      "end_ms": 58950,
      "text": "这偶是好偶啊，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00032",
      "start_ms": 59350,
      "end_ms": 60675,
      "text": "就是心眼儿太多了。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00033",
      "start_ms": 61250,
      "end_ms": 63270,
      "text": "领导藕虽然心眼多，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00034",
      "start_ms": 63570,
      "end_ms": 64815,
      "text": "但也是您的下酒菜啊。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00035",
      "start_ms": 65360,
      "end_ms": 66120,
      "text": "哈哈哈哈，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00036",
      "start_ms": 68580,
      "end_ms": 70245,
      "text": "你这菜点的也太多了，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00037",
      "start_ms": 70890,
      "end_ms": 73010,
      "text": "领导菜点的再多，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00038",
      "start_ms": 73130,
      "end_ms": 74470,
      "text": "也比不上平时您对我的照顾。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00039",
      "start_ms": 74470,
      "end_ms": 75270,
      "text": "多这杯酒，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00040",
      "start_ms": 75270,
      "end_ms": 77420,
      "text": "我先敬您啊啊，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00041",
      "start_ms": 78600,
      "end_ms": 80260,
      "text": "你一开口就让人喜欢你，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00042",
      "start_ms": 80340,
      "end_ms": 81405,
      "text": "你是怎么做到的？"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00043",
      "start_ms": 81590,
      "end_ms": 84185,
      "text": "因为我一直在看这本把话说的恰到好处，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00044",
      "start_ms": 84460,
      "end_ms": 86120,
      "text": "这个世界上谁都不会拒绝，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00045",
      "start_ms": 86140,
      "end_ms": 87840,
      "text": "那些会说话、会来事儿的人。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00046",
      "start_ms": 87900,
      "end_ms": 88860,
      "text": "假如你不爱说话，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00047",
      "start_ms": 88940,
      "end_ms": 89640,
      "text": "不爱争辩，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00048",
      "start_ms": 89720,
      "end_ms": 90720,
      "text": "甚至恐惧社交，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00049",
      "start_ms": 90940,
      "end_ms": 93340,
      "text": "推荐你读完这本把话说的恰到好处，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00050",
      "start_ms": 93520,
      "end_ms": 95440,
      "text": "让你轻松摆平各种社交场合，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00051",
      "start_ms": 95680,
      "end_ms": 96520,
      "text": "每天看两页，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00052",
      "start_ms": 96600,
      "end_ms": 97760,
      "text": "每一个场景慢慢练，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00053",
      "start_ms": 97860,
      "end_ms": 100754,
      "text": "你就会变成一个会说话、懂交际的人。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00054",
      "start_ms": 101210,
      "end_ms": 102770,
      "text": "在这本书里有一句话，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00055",
      "start_ms": 102770,
      "end_ms": 103795,
      "text": "我特别欣赏，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00056",
      "start_ms": 104170,
      "end_ms": 104290,
      "text": "他，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00057",
      "start_ms": 104290,
      "end_ms": 106805,
      "text": "写的是面对别人夸你优秀时，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00058",
      "start_ms": 107070,
      "end_ms": 107725,
      "text": "你可以回，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00059",
      "start_ms": 108100,
      "end_ms": 109300,
      "text": "那是不优秀点儿，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00060",
      "start_ms": 109360,
      "end_ms": 110605,
      "text": "怎么能和你做朋友呢？"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00061",
      "start_ms": 111410,
      "end_ms": 112970,
      "text": "当有人说你真聪明，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00062",
      "start_ms": 113130,
      "end_ms": 114955,
      "text": "你就回近朱者赤，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00063",
      "start_ms": 115360,
      "end_ms": 116320,
      "text": "和你在一起啊，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00064",
      "start_ms": 116460,
      "end_ms": 119890,
      "text": "熏都熏出来了当领导跟你说辛苦了，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00065",
      "start_ms": 119950,
      "end_ms": 121070,
      "text": "你就回领导，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00066",
      "start_ms": 121150,
      "end_ms": 122395,
      "text": "这都是我应该做的。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00067",
      "start_ms": 122690,
      "end_ms": 124110,
      "text": "强将手下无弱兵，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00068",
      "start_ms": 124310,
      "end_ms": 125865,
      "text": "我怎么能给您丢脸呢？"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00069",
      "start_ms": 126170,
      "end_ms": 127550,
      "text": "当我看到这段的时候，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00070",
      "start_ms": 127730,
      "end_ms": 129725,
      "text": "真是让我欲解心开啊。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00071",
      "start_ms": 130340,
      "end_ms": 131595,
      "text": "每一句都很有意思，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00072",
      "start_ms": 132040,
      "end_ms": 135700,
      "text": "就是手把手教我们在不同场景之下应该怎么说。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00073",
      "start_ms": 136060,
      "end_ms": 139105,
      "text": "书籍的内容和我现在展示的是一模一样的，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00074",
      "start_ms": 139400,
      "end_ms": 140755,
      "text": "你就放心的拿回去看，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00075",
      "start_ms": 141300,
      "end_ms": 142845,
      "text": "就是一句一句的教你，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00076",
      "start_ms": 143440,
      "end_ms": 145785,
      "text": "让你轻松摆平各种社交场合，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00077",
      "start_ms": 146220,
      "end_ms": 147425,
      "text": "但凡学会三分，"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00078",
      "start_ms": 147840,
      "end_ms": 150275,
      "text": "你就能把人际关系拿捏的死死的。"
    },
    {
      "segment_id": "v_7119c0d0f32c119a_s00079",
      "start_ms": 150760,
      "end_ms": 152865,
      "text": "这本书真的可以帮助到大家。"
    }
  ],
