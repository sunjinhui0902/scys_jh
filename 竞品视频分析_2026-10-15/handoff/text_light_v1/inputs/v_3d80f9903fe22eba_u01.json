  "core_text": "被误传了，千年的俗语，你读对了几句，男戴观音女戴佛。错是男戴官印女，戴福穷养儿子富养女儿。错是穷养儿至富养女德嫁鸡随鸡嫁狗随狗。错是嫁妻随起，嫁走随走，先成家后立业。错是育良人，先成家，遇贵人先立业，嫁小非君子，无毒不丈夫。错是量小非，君子，无度，不丈夫，人不为己天诛地灭。错是人不修为天地不容，连云都。",
  "segments": [
    {
      "segment_id": "v_3d80f9903fe22eba_s00001",
      "start_ms": 250,
      "end_ms": 850,
      "text": "被误传了，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00002",
      "start_ms": 850,
      "end_ms": 1710,
      "text": "千年的俗语，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00003",
      "start_ms": 1890,
      "end_ms": 2910,
      "text": "你读对了几句，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00004",
      "start_ms": 3310,
      "end_ms": 5130,
      "text": "男戴观音女戴佛。"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00005",
      "start_ms": 5590,
      "end_ms": 7930,
      "text": "错是男戴官印女，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00006",
      "start_ms": 7950,
      "end_ms": 11050,
      "text": "戴福穷养儿子富养女儿。"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00007",
      "start_ms": 11370,
      "end_ms": 16910,
      "text": "错是穷养儿至富养女德嫁鸡随鸡嫁狗随狗。"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00008",
      "start_ms": 17230,
      "end_ms": 19010,
      "text": "错是嫁妻随起，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00009",
      "start_ms": 19450,
      "end_ms": 20570,
      "text": "嫁走随走，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00010",
      "start_ms": 21010,
      "end_ms": 22710,
      "text": "先成家后立业。"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00011",
      "start_ms": 23170,
      "end_ms": 24690,
      "text": "错是育良人，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00012",
      "start_ms": 24990,
      "end_ms": 25770,
      "text": "先成家，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00013",
      "start_ms": 26110,
      "end_ms": 28170,
      "text": "遇贵人先立业，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00014",
      "start_ms": 28890,
      "end_ms": 29905,
      "text": "嫁小非君子，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00015",
      "start_ms": 30340,
      "end_ms": 31420,
      "text": "无毒不丈夫。"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00016",
      "start_ms": 31860,
      "end_ms": 33400,
      "text": "错是量小非，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00017",
      "start_ms": 33400,
      "end_ms": 33860,
      "text": "君子，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00018",
      "start_ms": 34200,
      "end_ms": 34700,
      "text": "无度，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00019",
      "start_ms": 35180,
      "end_ms": 36020,
      "text": "不丈夫，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00020",
      "start_ms": 36500,
      "end_ms": 38400,
      "text": "人不为己天诛地灭。"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00021",
      "start_ms": 38740,
      "end_ms": 42340,
      "text": "错是人不修为天地不容，"
    },
    {
      "segment_id": "v_3d80f9903fe22eba_s00022",
      "start_ms": 43240,
      "end_ms": 44315,
      "text": "连云都。"
    }
  ],
