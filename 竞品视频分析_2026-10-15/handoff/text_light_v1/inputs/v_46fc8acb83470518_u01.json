{
  "schema_version": "text-light-input-1.0",
  "unit_id": "v_46fc8acb83470518_u01",
  "video_id": "v_46fc8acb83470518",
  "account": "赵健的读书日记",
  "source_title": "诸君,你相信吗，拼命的时代已经过去了，现在是保命的时代，很多事你不做就是嬴，不贪吃不熬夜不生气，彻底远离消耗你的人和事，就是在吃这个时代的红利。我们将在9月7日迎来一年中最舒服的一天，白露节气。白露白露，藏而不露，草木收起繁盛，庄稼收起锋芒，白昼也一点点收短，人活到一定年纪也该如此。#白露节气 #秋天 #治愈 #养生",
  "title_is_metadata_not_transcript": true,
  "input_mode": "text_only",
  "status": "AI_PENDING",
  "unit_index": 1,
  "unit_count": 1,
  "all_video_unit_ids": [
    "v_46fc8acb83470518_u01"
  ],
  "duration_s": 156.780998,
  "text_source": "FunASR转录，未全量逐字听核；时间为模型估计",
  "core_text": "朱君，你相信吗？拼命的时代已经过去了，现在是保命的时代，很多事儿你不做就是赢，不贪吃，不熬夜，不生气，彻底远离消耗你的人和事儿。健康的活下去，就是在吃这个时代的红利。我们将在九月七号迎来一年中最舒服。一天白白露节气，白露白露藏而不白，白鹭之天天开始做一件事儿，收草木，收起繁盛庄稼，收锋芒，白昼也一点点收短人活到一定年纪也该如此。少解释，少炫耀，少证明，尤其身弱之人，更不能说出自己的计划不提家业，不透露实际的收入。不说未成之事，受过的苦，不要反复对别人讲讲多了，可能会再经历一遍，往往好事不成坏事，一说就成别为了获得共鸣，讲起过往没完没了，仔细想想，你哪次滔滔不绝后，带来的不是欢悔恨。诸君在这两天你会明白何谓露从今夜白？白露之后，昼夜温差明显，从此天凉好个秋。真正好的关系都有一点秋天的感觉，不喧哗、不灼热，却有恰到好处的温度，清凉，清醒清净。白露秋分夜一夜凉一夜。白露时节，很多农作物正在经历丰收前的沉默。我们可以尝试向天地自然学习。半隐半藏。其实，除了赚钱和日常生活以外，人不需要太多的社交和喧闹，旅行也解决不了生活的苦，我们需要的是安静，你相信吗？如果你想多活几年，不是靠吃什么补品，也不是玩命的去健身。就一招很简单，离人群远一点，人最好的状态就是销声匿迹。每一个把自己藏起来的人都在打一场硬仗，这就是秋收冬藏，收敛锋芒，蕴藏能量。周君，你看白露节气，真正的秋天已经来了。凉风乍起，倦鸟归林，山河沉寂，万物蛰伏。当你开始变得沉默，不再有向别人解释的欲望，不再渴望寻求别人的理解、说话，直击问题的本质和要害，做事也杀伐果断，不拖泥带水，逐渐明白了言多必失的危害，那么恭喜你，你已经开始脱胎换骨了。在繁华中自律，在落魄中自愈。我喜欢白鹭秀而不媚，清而不寒，金风玉露一相逢，便胜却人间无数。",
  "segments": [
    {
      "segment_id": "v_46fc8acb83470518_s00001",
      "start_ms": 400,
      "end_ms": 800,
      "text": "朱君，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00002",
      "start_ms": 1080,
      "end_ms": 1880,
      "text": "你相信吗？"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00003",
      "start_ms": 2160,
      "end_ms": 3840,
      "text": "拼命的时代已经过去了，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00004",
      "start_ms": 3980,
      "end_ms": 5880,
      "text": "现在是保命的时代，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00005",
      "start_ms": 6180,
      "end_ms": 8100,
      "text": "很多事儿你不做就是赢，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00006",
      "start_ms": 8380,
      "end_ms": 9000,
      "text": "不贪吃，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00007",
      "start_ms": 9100,
      "end_ms": 9720,
      "text": "不熬夜，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00008",
      "start_ms": 9720,
      "end_ms": 10320,
      "text": "不生气，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00009",
      "start_ms": 10480,
      "end_ms": 12940,
      "text": "彻底远离消耗你的人和事儿。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00010",
      "start_ms": 12960,
      "end_ms": 14160,
      "text": "健康的活下去，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00011",
      "start_ms": 14160,
      "end_ms": 16320,
      "text": "就是在吃这个时代的红利。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00012",
      "start_ms": 16320,
      "end_ms": 19160,
      "text": "我们将在九月七号迎来一年中最舒服。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00013",
      "start_ms": 19160,
      "end_ms": 21060,
      "text": "一天白白露节气，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00014",
      "start_ms": 21660,
      "end_ms": 23880,
      "text": "白露白露藏而不白，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00015",
      "start_ms": 24180,
      "end_ms": 26640,
      "text": "白鹭之天天开始做一件事儿，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00016",
      "start_ms": 26940,
      "end_ms": 28080,
      "text": "收草木，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00017",
      "start_ms": 28220,
      "end_ms": 29760,
      "text": "收起繁盛庄稼，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00018",
      "start_ms": 29820,
      "end_ms": 30730,
      "text": "收锋芒，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00019",
      "start_ms": 31030,
      "end_ms": 35290,
      "text": "白昼也一点点收短人活到一定年纪也该如此。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00020",
      "start_ms": 35590,
      "end_ms": 36310,
      "text": "少解释，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00021",
      "start_ms": 36670,
      "end_ms": 37450,
      "text": "少炫耀，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00022",
      "start_ms": 37670,
      "end_ms": 38410,
      "text": "少证明，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00023",
      "start_ms": 38830,
      "end_ms": 39850,
      "text": "尤其身弱之人，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00024",
      "start_ms": 39850,
      "end_ms": 42530,
      "text": "更不能说出自己的计划不提家业，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00025",
      "start_ms": 42690,
      "end_ms": 44150,
      "text": "不透露实际的收入。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00026",
      "start_ms": 44270,
      "end_ms": 45650,
      "text": "不说未成之事，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00027",
      "start_ms": 46050,
      "end_ms": 46830,
      "text": "受过的苦，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00028",
      "start_ms": 46830,
      "end_ms": 49330,
      "text": "不要反复对别人讲讲多了，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00029",
      "start_ms": 49330,
      "end_ms": 50570,
      "text": "可能会再经历一遍，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00030",
      "start_ms": 50850,
      "end_ms": 52550,
      "text": "往往好事不成坏事，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00031",
      "start_ms": 52550,
      "end_ms": 54670,
      "text": "一说就成别为了获得共鸣，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00032",
      "start_ms": 54850,
      "end_ms": 56470,
      "text": "讲起过往没完没了，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00033",
      "start_ms": 56950,
      "end_ms": 57730,
      "text": "仔细想想，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00034",
      "start_ms": 57910,
      "end_ms": 59370,
      "text": "你哪次滔滔不绝后，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00035",
      "start_ms": 59370,
      "end_ms": 60585,
      "text": "带来的不是欢悔恨。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00036",
      "start_ms": 60860,
      "end_ms": 64705,
      "text": "诸君在这两天你会明白何谓露从今夜白？"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00037",
      "start_ms": 65110,
      "end_ms": 65810,
      "text": "白露之后，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00038",
      "start_ms": 65950,
      "end_ms": 67325,
      "text": "昼夜温差明显，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00039",
      "start_ms": 67620,
      "end_ms": 69515,
      "text": "从此天凉好个秋。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00040",
      "start_ms": 69960,
      "end_ms": 72875,
      "text": "真正好的关系都有一点秋天的感觉，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00041",
      "start_ms": 73260,
      "end_ms": 74715,
      "text": "不喧哗、不灼热，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00042",
      "start_ms": 75000,
      "end_ms": 76805,
      "text": "却有恰到好处的温度，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00043",
      "start_ms": 77190,
      "end_ms": 77715,
      "text": "清凉，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00044",
      "start_ms": 78040,
      "end_ms": 79375,
      "text": "清醒清净。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00045",
      "start_ms": 79990,
      "end_ms": 82785,
      "text": "白露秋分夜一夜凉一夜。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00046",
      "start_ms": 83130,
      "end_ms": 83890,
      "text": "白露时节，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00047",
      "start_ms": 83910,
      "end_ms": 86645,
      "text": "很多农作物正在经历丰收前的沉默。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00048",
      "start_ms": 86940,
      "end_ms": 89135,
      "text": "我们可以尝试向天地自然学习。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00049",
      "start_ms": 89440,
      "end_ms": 90645,
      "text": "半隐半藏。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00050",
      "start_ms": 91140,
      "end_ms": 91500,
      "text": "其实，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00051",
      "start_ms": 91500,
      "end_ms": 93185,
      "text": "除了赚钱和日常生活以外，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00052",
      "start_ms": 93450,
      "end_ms": 95685,
      "text": "人不需要太多的社交和喧闹，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00053",
      "start_ms": 96020,
      "end_ms": 98035,
      "text": "旅行也解决不了生活的苦，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00054",
      "start_ms": 98280,
      "end_ms": 99705,
      "text": "我们需要的是安静，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00055",
      "start_ms": 100040,
      "end_ms": 100735,
      "text": "你相信吗？"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00056",
      "start_ms": 101090,
      "end_ms": 102490,
      "text": "如果你想多活几年，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00057",
      "start_ms": 102490,
      "end_ms": 103895,
      "text": "不是靠吃什么补品，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00058",
      "start_ms": 104100,
      "end_ms": 105560,
      "text": "也不是玩命的去健身。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00059",
      "start_ms": 105760,
      "end_ms": 107040,
      "text": "就一招很简单，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00060",
      "start_ms": 107360,
      "end_ms": 108695,
      "text": "离人群远一点，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00061",
      "start_ms": 109060,
      "end_ms": 111005,
      "text": "人最好的状态就是销声匿迹。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00062",
      "start_ms": 111470,
      "end_ms": 114405,
      "text": "每一个把自己藏起来的人都在打一场硬仗，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00063",
      "start_ms": 114670,
      "end_ms": 116480,
      "text": "这就是秋收冬藏，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00064",
      "start_ms": 116900,
      "end_ms": 117840,
      "text": "收敛锋芒，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00065",
      "start_ms": 118020,
      "end_ms": 118985,
      "text": "蕴藏能量。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00066",
      "start_ms": 119400,
      "end_ms": 119700,
      "text": "周君，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00067",
      "start_ms": 119700,
      "end_ms": 121220,
      "text": "你看白露节气，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00068",
      "start_ms": 121240,
      "end_ms": 123035,
      "text": "真正的秋天已经来了。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00069",
      "start_ms": 123410,
      "end_ms": 124390,
      "text": "凉风乍起，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00070",
      "start_ms": 124570,
      "end_ms": 125630,
      "text": "倦鸟归林，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00071",
      "start_ms": 125830,
      "end_ms": 126870,
      "text": "山河沉寂，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00072",
      "start_ms": 127090,
      "end_ms": 128135,
      "text": "万物蛰伏。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00073",
      "start_ms": 128670,
      "end_ms": 130055,
      "text": "当你开始变得沉默，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00074",
      "start_ms": 130340,
      "end_ms": 131995,
      "text": "不再有向别人解释的欲望，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00075",
      "start_ms": 132280,
      "end_ms": 134940,
      "text": "不再渴望寻求别人的理解、说话，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00076",
      "start_ms": 134960,
      "end_ms": 136780,
      "text": "直击问题的本质和要害，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00077",
      "start_ms": 136920,
      "end_ms": 138420,
      "text": "做事也杀伐果断，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00078",
      "start_ms": 138420,
      "end_ms": 139315,
      "text": "不拖泥带水，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00079",
      "start_ms": 139690,
      "end_ms": 141810,
      "text": "逐渐明白了言多必失的危害，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00080",
      "start_ms": 142010,
      "end_ms": 142805,
      "text": "那么恭喜你，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00081",
      "start_ms": 143030,
      "end_ms": 145065,
      "text": "你已经开始脱胎换骨了。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00082",
      "start_ms": 145450,
      "end_ms": 146790,
      "text": "在繁华中自律，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00083",
      "start_ms": 146870,
      "end_ms": 148365,
      "text": "在落魄中自愈。"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00084",
      "start_ms": 148960,
      "end_ms": 151080,
      "text": "我喜欢白鹭秀而不媚，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00085",
      "start_ms": 151300,
      "end_ms": 152325,
      "text": "清而不寒，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00086",
      "start_ms": 152700,
      "end_ms": 154140,
      "text": "金风玉露一相逢，"
    },
    {
      "segment_id": "v_46fc8acb83470518_s00087",
      "start_ms": 154140,
      "end_ms": 156435,
      "text": "便胜却人间无数。"
    }
  ],
  "previous_context": [],
  "following_context": [],
