{
  "video_id": "v_b28fd366f358fb78",
  "duration_s": 327.633991,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\history_city_2026-10-19\\transcripts\\v_b28fd366f358fb78.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\history_city_2026-10-19\\segments\\v_b28fd366f358fb78.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 170,
      "end_ms": 5370,
      "text": "上一集咱们盘点了十大适合带孙辈长见识的历史名城。",
      "token_start": 0,
      "token_end_exclusive": 23,
      "segment_id": "s000001"
    },
    {
      "start_ms": 6010,
      "end_ms": 7050,
      "text": "平遥排第十，",
      "token_start": 23,
      "token_end_exclusive": 28,
      "segment_id": "s000002"
    },
    {
      "start_ms": 7550,
      "end_ms": 8770,
      "text": "杭州排第六。",
      "token_start": 28,
      "token_end_exclusive": 33,
      "segment_id": "s000003"
    },
    {
      "start_ms": 9550,
      "end_ms": 13330,
      "text": "有朋友在评论区问前五名到底是哪里？",
      "token_start": 33,
      "token_end_exclusive": 49,
      "segment_id": "s000004"
    },
    {
      "start_ms": 13630,
      "end_ms": 15290,
      "text": "今天咱们就接着往下说，",
      "token_start": 49,
      "token_end_exclusive": 59,
      "segment_id": "s000005"
    },
    {
      "start_ms": 15650,
      "end_ms": 17330,
      "text": "西安是十三朝古都，",
      "token_start": 59,
      "token_end_exclusive": 67,
      "segment_id": "s000006"
    },
    {
      "start_ms": 17730,
      "end_ms": 19310,
      "text": "秦始皇建都咸阳。",
      "token_start": 67,
      "token_end_exclusive": 74,
      "segment_id": "s000007"
    },
    {
      "start_ms": 19370,
      "end_ms": 20430,
      "text": "就在西安边上，",
      "token_start": 74,
      "token_end_exclusive": 80,
      "segment_id": "s000008"
    },
    {
      "start_ms": 20710,
      "end_ms": 22290,
      "text": "您带孩子去西安，",
      "token_start": 80,
      "token_end_exclusive": 87,
      "segment_id": "s000009"
    },
    {
      "start_ms": 22750,
      "end_ms": 24390,
      "text": "必须去兵马俑，",
      "token_start": 87,
      "token_end_exclusive": 93,
      "segment_id": "s000010"
    },
    {
      "start_ms": 24750,
      "end_ms": 28430,
      "text": "站在兵马俑坑前那一排一排的头俑，",
      "token_start": 93,
      "token_end_exclusive": 108,
      "segment_id": "s000011"
    },
    {
      "start_ms": 28470,
      "end_ms": 30600,
      "text": "每一个脸都是不一样。",
      "token_start": 108,
      "token_end_exclusive": 117,
      "segment_id": "s000012"
    },
    {
      "start_ms": 30900,
      "end_ms": 32020,
      "text": "您跟孩子讲，",
      "token_start": 117,
      "token_end_exclusive": 122,
      "segment_id": "s000013"
    },
    {
      "start_ms": 32500,
      "end_ms": 35980,
      "text": "这是两千多年前秦始皇的陪葬品。",
      "token_start": 122,
      "token_end_exclusive": 136,
      "segment_id": "s000014"
    },
    {
      "start_ms": 36680,
      "end_ms": 38300,
      "text": "当时为了修这些俑，",
      "token_start": 136,
      "token_end_exclusive": 144,
      "segment_id": "s000015"
    },
    {
      "start_ms": 38920,
      "end_ms": 40820,
      "text": "动用了几十万工匠，",
      "token_start": 144,
      "token_end_exclusive": 152,
      "segment_id": "s000016"
    },
    {
      "start_ms": 41160,
      "end_ms": 44340,
      "text": "孩子看着那密密麻麻的陶俑，",
      "token_start": 152,
      "token_end_exclusive": 164,
      "segment_id": "s000017"
    },
    {
      "start_ms": 45000,
      "end_ms": 47100,
      "text": "就能明白什么叫大宫城。",
      "token_start": 164,
      "token_end_exclusive": 174,
      "segment_id": "s000018"
    },
    {
      "start_ms": 47400,
      "end_ms": 48580,
      "text": "西安还有城墙，",
      "token_start": 174,
      "token_end_exclusive": 180,
      "segment_id": "s000019"
    },
    {
      "start_ms": 49180,
      "end_ms": 51760,
      "text": "古朝修的保存的特别完整。",
      "token_start": 180,
      "token_end_exclusive": 191,
      "segment_id": "s000020"
    },
    {
      "start_ms": 52000,
      "end_ms": 57040,
      "text": "您带孩子在城墙上骑自行车绕城墙一圈跟他讲，",
      "token_start": 191,
      "token_end_exclusive": 211,
      "segment_id": "s000021"
    },
    {
      "start_ms": 57040,
      "end_ms": 59860,
      "text": "古代的城就是这样守着的城墙，",
      "token_start": 211,
      "token_end_exclusive": 224,
      "segment_id": "s000022"
    },
    {
      "start_ms": 60070,
      "end_ms": 62110,
      "text": "张一为外面的人进不来。",
      "token_start": 224,
      "token_end_exclusive": 234,
      "segment_id": "s000023"
    },
    {
      "start_ms": 62430,
      "end_ms": 63675,
      "text": "西安为什么排第二？",
      "token_start": 234,
      "token_end_exclusive": 242,
      "segment_id": "s000024"
    },
    {
      "start_ms": 64140,
      "end_ms": 65685,
      "text": "因为它的分量够重，",
      "token_start": 242,
      "token_end_exclusive": 250,
      "segment_id": "s000025"
    },
    {
      "start_ms": 66510,
      "end_ms": 70220,
      "text": "秦汉、隋唐都在这儿建都历史课本里，",
      "token_start": 250,
      "token_end_exclusive": 265,
      "segment_id": "s000026"
    },
    {
      "start_ms": 70220,
      "end_ms": 72380,
      "text": "一半的内容都跟西安有关。",
      "token_start": 265,
      "token_end_exclusive": 276,
      "segment_id": "s000027"
    },
    {
      "start_ms": 72640,
      "end_ms": 76775,
      "text": "可西安比成都少一样东西烟火气。",
      "token_start": 276,
      "token_end_exclusive": 290,
      "segment_id": "s000028"
    },
    {
      "start_ms": 77330,
      "end_ms": 79625,
      "text": "西安太像一座博物馆了，",
      "token_start": 290,
      "token_end_exclusive": 300,
      "segment_id": "s000029"
    },
    {
      "start_ms": 80180,
      "end_ms": 82700,
      "text": "成都更像一座活着的城。",
      "token_start": 300,
      "token_end_exclusive": 310,
      "segment_id": "s000030"
    },
    {
      "start_ms": 83040,
      "end_ms": 83755,
      "text": "说到这儿，",
      "token_start": 310,
      "token_end_exclusive": 314,
      "segment_id": "s000031"
    },
    {
      "start_ms": 84010,
      "end_ms": 90345,
      "text": "我发现经常有朋友在评论区留言说想带孙子孙女出去看看，",
      "token_start": 314,
      "token_end_exclusive": 339,
      "segment_id": "s000032"
    },
    {
      "start_ms": 90850,
      "end_ms": 92825,
      "text": "可不知道去哪座城好，",
      "token_start": 339,
      "token_end_exclusive": 348,
      "segment_id": "s000033"
    },
    {
      "start_ms": 93330,
      "end_ms": 96125,
      "text": "也不知道到了那儿该怎么跟孩子讲。",
      "token_start": 348,
      "token_end_exclusive": 363,
      "segment_id": "s000034"
    },
    {
      "start_ms": 96490,
      "end_ms": 99795,
      "text": "还有些朋友说自己对历史也不是很懂，",
      "token_start": 363,
      "token_end_exclusive": 379,
      "segment_id": "s000035"
    },
    {
      "start_ms": 100470,
      "end_ms": 102430,
      "text": "怕讲错了误导孩子。",
      "token_start": 379,
      "token_end_exclusive": 387,
      "segment_id": "s000036"
    },
    {
      "start_ms": 102730,
      "end_ms": 105475,
      "text": "其实这些担心我特别理解，",
      "token_start": 387,
      "token_end_exclusive": 398,
      "segment_id": "s000037"
    },
    {
      "start_ms": 105800,
      "end_ms": 108525,
      "text": "咱们带孩子出去不光是玩儿，",
      "token_start": 398,
      "token_end_exclusive": 410,
      "segment_id": "s000038"
    },
    {
      "start_ms": 108800,
      "end_ms": 110605,
      "text": "还得让孩子学到点东西，",
      "token_start": 410,
      "token_end_exclusive": 420,
      "segment_id": "s000039"
    },
    {
      "start_ms": 111160,
      "end_ms": 113240,
      "text": "可到了那儿该讲什么，",
      "token_start": 420,
      "token_end_exclusive": 429,
      "segment_id": "s000040"
    },
    {
      "start_ms": 113460,
      "end_ms": 114640,
      "text": "怎么讲的有趣，",
      "token_start": 429,
      "token_end_exclusive": 435,
      "segment_id": "s000041"
    },
    {
      "start_ms": 114980,
      "end_ms": 116355,
      "text": "这确实是个问题。",
      "token_start": 435,
      "token_end_exclusive": 442,
      "segment_id": "s000042"
    },
    {
      "start_ms": 116710,
      "end_ms": 119410,
      "text": "前段时间我看到一本书叫大美，",
      "token_start": 442,
      "token_end_exclusive": 455,
      "segment_id": "s000043"
    },
    {
      "start_ms": 119410,
      "end_ms": 121935,
      "text": "中国一生要去的一百零一个地方。",
      "token_start": 455,
      "token_end_exclusive": 469,
      "segment_id": "s000044"
    },
    {
      "start_ms": 122210,
      "end_ms": 127535,
      "text": "这本书里头不光整理了全国一百零一个最值得去的地方，",
      "token_start": 469,
      "token_end_exclusive": 493,
      "segment_id": "s000045"
    },
    {
      "start_ms": 128080,
      "end_ms": 132840,
      "text": "还专门标注了每个地方适合给孩子讲什么故事。",
      "token_start": 493,
      "token_end_exclusive": 513,
      "segment_id": "s000046"
    },
    {
      "start_ms": 133100,
      "end_ms": 134260,
      "text": "就拿成都来说，",
      "token_start": 513,
      "token_end_exclusive": 519,
      "segment_id": "s000047"
    },
    {
      "start_ms": 134580,
      "end_ms": 136950,
      "text": "书里头专门写了金沙遗址，",
      "token_start": 519,
      "token_end_exclusive": 530,
      "segment_id": "s000048"
    },
    {
      "start_ms": 136950,
      "end_ms": 137565,
      "text": "该怎么讲，",
      "token_start": 530,
      "token_end_exclusive": 534,
      "segment_id": "s000049"
    },
    {
      "start_ms": 138150,
      "end_ms": 139465,
      "text": "武侯祠该怎么讲，",
      "token_start": 534,
      "token_end_exclusive": 541,
      "segment_id": "s000050"
    },
    {
      "start_ms": 139780,
      "end_ms": 141215,
      "text": "杜甫草堂该怎么讲？",
      "token_start": 541,
      "token_end_exclusive": 549,
      "segment_id": "s000051"
    },
    {
      "start_ms": 141580,
      "end_ms": 144865,
      "text": "每个地方都配了历史背景、人物故事，",
      "token_start": 549,
      "token_end_exclusive": 564,
      "segment_id": "s000052"
    },
    {
      "start_ms": 145630,
      "end_ms": 148225,
      "text": "还有适合孩子理解的讲法。",
      "token_start": 564,
      "token_end_exclusive": 575,
      "segment_id": "s000053"
    },
    {
      "start_ms": 148620,
      "end_ms": 151435,
      "text": "您去之前翻一翻到了那儿照着讲，",
      "token_start": 575,
      "token_end_exclusive": 589,
      "segment_id": "s000054"
    },
    {
      "start_ms": 151770,
      "end_ms": 152690,
      "text": "孩子听得懂，",
      "token_start": 589,
      "token_end_exclusive": 594,
      "segment_id": "s000055"
    },
    {
      "start_ms": 152810,
      "end_ms": 153665,
      "text": "也记得住。",
      "token_start": 594,
      "token_end_exclusive": 598,
      "segment_id": "s000056"
    },
    {
      "start_ms": 153970,
      "end_ms": 158105,
      "text": "向西安兵马俑、洛阳龙门石窟、北京故宫，",
      "token_start": 598,
      "token_end_exclusive": 614,
      "segment_id": "s000057"
    },
    {
      "start_ms": 158480,
      "end_ms": 160215,
      "text": "书里都有详细的讲解，",
      "token_start": 614,
      "token_end_exclusive": 623,
      "segment_id": "s000058"
    },
    {
      "start_ms": 160590,
      "end_ms": 162885,
      "text": "您不用担心自己讲不清楚，",
      "token_start": 623,
      "token_end_exclusive": 634,
      "segment_id": "s000059"
    },
    {
      "start_ms": 163440,
      "end_ms": 165255,
      "text": "书里都给您准备好了。",
      "token_start": 634,
      "token_end_exclusive": 643,
      "segment_id": "s000060"
    },
    {
      "start_ms": 165590,
      "end_ms": 167605,
      "text": "这本书不光讲历史名城，",
      "token_start": 643,
      "token_end_exclusive": 653,
      "segment_id": "s000061"
    },
    {
      "start_ms": 168000,
      "end_ms": 169835,
      "text": "还讲了很多自然风光。",
      "token_start": 653,
      "token_end_exclusive": 662,
      "segment_id": "s000062"
    },
    {
      "start_ms": 170550,
      "end_ms": 171585,
      "text": "古镇古村，",
      "token_start": 662,
      "token_end_exclusive": 666,
      "segment_id": "s000063"
    },
    {
      "start_ms": 172270,
      "end_ms": 173870,
      "text": "您要是想带孩子看山，",
      "token_start": 666,
      "token_end_exclusive": 675,
      "segment_id": "s000064"
    },
    {
      "start_ms": 173870,
      "end_ms": 177585,
      "text": "看水书里也有推荐一百零一个地方，",
      "token_start": 675,
      "token_end_exclusive": 690,
      "segment_id": "s000065"
    },
    {
      "start_ms": 178190,
      "end_ms": 184035,
      "text": "总有适合您和孩子一起去的书里头还配了不少实景照片和手绘地图，",
      "token_start": 690,
      "token_end_exclusive": 719,
      "segment_id": "s000066"
    },
    {
      "start_ms": 184570,
      "end_ms": 186325,
      "text": "孩子翻着看就有兴趣。",
      "token_start": 719,
      "token_end_exclusive": 728,
      "segment_id": "s000067"
    },
    {
      "start_ms": 186640,
      "end_ms": 188320,
      "text": "您跟孩子一起翻这本书，",
      "token_start": 728,
      "token_end_exclusive": 738,
      "segment_id": "s000068"
    },
    {
      "start_ms": 188700,
      "end_ms": 190645,
      "text": "一起规划下一站去哪儿？",
      "token_start": 738,
      "token_end_exclusive": 748,
      "segment_id": "s000069"
    },
    {
      "start_ms": 190910,
      "end_ms": 193330,
      "text": "这本身就是一件有意义的事。",
      "token_start": 748,
      "token_end_exclusive": 760,
      "segment_id": "s000070"
    },
    {
      "start_ms": 193650,
      "end_ms": 194715,
      "text": "这本书不贵，",
      "token_start": 760,
      "token_end_exclusive": 765,
      "segment_id": "s000071"
    },
    {
      "start_ms": 194980,
      "end_ms": 197625,
      "text": "也就是咱们平时给孩子买个玩具的钱，",
      "token_start": 765,
      "token_end_exclusive": 781,
      "segment_id": "s000072"
    },
    {
      "start_ms": 197940,
      "end_ms": 199115,
      "text": "您把它放在家里。",
      "token_start": 781,
      "token_end_exclusive": 788,
      "segment_id": "s000073"
    },
    {
      "start_ms": 199370,
      "end_ms": 200945,
      "text": "孩子没事的时候翻一翻，",
      "token_start": 788,
      "token_end_exclusive": 798,
      "segment_id": "s000074"
    },
    {
      "start_ms": 201260,
      "end_ms": 203085,
      "text": "看看这些地方的照片，",
      "token_start": 798,
      "token_end_exclusive": 807,
      "segment_id": "s000075"
    },
    {
      "start_ms": 203460,
      "end_ms": 205480,
      "text": "听您讲讲这些地方的故事，",
      "token_start": 807,
      "token_end_exclusive": 818,
      "segment_id": "s000076"
    },
    {
      "start_ms": 205760,
      "end_ms": 207985,
      "text": "比天天抱着手机强多了。",
      "token_start": 818,
      "token_end_exclusive": 828,
      "segment_id": "s000077"
    },
    {
      "start_ms": 208390,
      "end_ms": 209870,
      "text": "您现在打开视频，",
      "token_start": 828,
      "token_end_exclusive": 835,
      "segment_id": "s000078"
    },
    {
      "start_ms": 209930,
      "end_ms": 211385,
      "text": "左下角的小黄车，",
      "token_start": 835,
      "token_end_exclusive": 842,
      "segment_id": "s000079"
    },
    {
      "start_ms": 211860,
      "end_ms": 216895,
      "text": "就能看到这本大美中国一生要去的一百零一个地方。",
      "token_start": 842,
      "token_end_exclusive": 864,
      "segment_id": "s000080"
    },
    {
      "start_ms": 217320,
      "end_ms": 218600,
      "text": "出版社那边支持，",
      "token_start": 864,
      "token_end_exclusive": 871,
      "segment_id": "s000081"
    },
    {
      "start_ms": 218800,
      "end_ms": 220075,
      "text": "先用后付。",
      "token_start": 871,
      "token_end_exclusive": 875,
      "segment_id": "s000082"
    },
    {
      "start_ms": 220790,
      "end_ms": 222545,
      "text": "您收到书翻一翻，",
      "token_start": 875,
      "token_end_exclusive": 882,
      "segment_id": "s000083"
    },
    {
      "start_ms": 222920,
      "end_ms": 224525,
      "text": "觉得有用就留下，",
      "token_start": 882,
      "token_end_exclusive": 889,
      "segment_id": "s000084"
    },
    {
      "start_ms": 224970,
      "end_ms": 225850,
      "text": "觉得不合适。",
      "token_start": 889,
      "token_end_exclusive": 894,
      "segment_id": "s000085"
    },
    {
      "start_ms": 225890,
      "end_ms": 227125,
      "text": "七天内直接退，",
      "token_start": 894,
      "token_end_exclusive": 900,
      "segment_id": "s000086"
    },
    {
      "start_ms": 227470,
      "end_ms": 228945,
      "text": "不用跟任何人解释。",
      "token_start": 900,
      "token_end_exclusive": 908,
      "segment_id": "s000087"
    },
    {
      "start_ms": 229220,
      "end_ms": 229565,
      "text": "好了，",
      "token_start": 908,
      "token_end_exclusive": 910,
      "segment_id": "s000088"
    },
    {
      "start_ms": 229930,
      "end_ms": 231410,
      "text": "咱们再回到刚才的话题。",
      "token_start": 910,
      "token_end_exclusive": 920,
      "segment_id": "s000089"
    },
    {
      "start_ms": 231710,
      "end_ms": 241225,
      "text": "这十座城、平遥、延安、开封、苏州、杭州、北京、洛阳、南京、西安、成都，",
      "token_start": 920,
      "token_end_exclusive": 944,
      "segment_id": "s000090"
    },
    {
      "start_ms": 241760,
      "end_ms": 243725,
      "text": "每一座都有他的故事，",
      "token_start": 944,
      "token_end_exclusive": 953,
      "segment_id": "s000091"
    },
    {
      "start_ms": 244340,
      "end_ms": 246580,
      "text": "每一座都能教孩子点什么。",
      "token_start": 953,
      "token_end_exclusive": 964,
      "segment_id": "s000092"
    },
    {
      "start_ms": 246900,
      "end_ms": 250430,
      "text": "平遥教孩子明清商业延安，",
      "token_start": 964,
      "token_end_exclusive": 975,
      "segment_id": "s000093"
    },
    {
      "start_ms": 250450,
      "end_ms": 252015,
      "text": "教孩子革命历史，",
      "token_start": 975,
      "token_end_exclusive": 982,
      "segment_id": "s000094"
    },
    {
      "start_ms": 252530,
      "end_ms": 255550,
      "text": "开封教孩子宋朝繁华苏州，",
      "token_start": 982,
      "token_end_exclusive": 993,
      "segment_id": "s000095"
    },
    {
      "start_ms": 255550,
      "end_ms": 257205,
      "text": "教孩子园林审美。",
      "token_start": 993,
      "token_end_exclusive": 1000,
      "segment_id": "s000096"
    },
    {
      "start_ms": 257540,
      "end_ms": 262035,
      "text": "杭州教孩子诗词传说北京教孩子皇权文化，",
      "token_start": 1000,
      "token_end_exclusive": 1018,
      "segment_id": "s000097"
    },
    {
      "start_ms": 262420,
      "end_ms": 262840,
      "text": "洛阳，",
      "token_start": 1018,
      "token_end_exclusive": 1020,
      "segment_id": "s000098"
    },
    {
      "start_ms": 262840,
      "end_ms": 264455,
      "text": "教孩子佛教艺术。",
      "token_start": 1020,
      "token_end_exclusive": 1027,
      "segment_id": "s000099"
    },
    {
      "start_ms": 264880,
      "end_ms": 267195,
      "text": "南京教孩子六朝兴衰，",
      "token_start": 1027,
      "token_end_exclusive": 1036,
      "segment_id": "s000100"
    },
    {
      "start_ms": 267930,
      "end_ms": 270250,
      "text": "西安教孩子秦汉雄风。",
      "token_start": 1036,
      "token_end_exclusive": 1045,
      "segment_id": "s000101"
    },
    {
      "start_ms": 270630,
      "end_ms": 273085,
      "text": "成都教孩子古属文明。",
      "token_start": 1045,
      "token_end_exclusive": 1054,
      "segment_id": "s000102"
    },
    {
      "start_ms": 273500,
      "end_ms": 275245,
      "text": "您带孩子去这些城，",
      "token_start": 1054,
      "token_end_exclusive": 1062,
      "segment_id": "s000103"
    },
    {
      "start_ms": 275870,
      "end_ms": 277025,
      "text": "不光是旅游，",
      "token_start": 1062,
      "token_end_exclusive": 1067,
      "segment_id": "s000104"
    },
    {
      "start_ms": 277610,
      "end_ms": 280490,
      "text": "更是给他上一堂活生生的历史课。",
      "token_start": 1067,
      "token_end_exclusive": 1081,
      "segment_id": "s000105"
    },
    {
      "start_ms": 280910,
      "end_ms": 282150,
      "text": "孩子回来以后，",
      "token_start": 1081,
      "token_end_exclusive": 1087,
      "segment_id": "s000106"
    },
    {
      "start_ms": 282170,
      "end_ms": 283135,
      "text": "翻开课本，",
      "token_start": 1087,
      "token_end_exclusive": 1091,
      "segment_id": "s000107"
    },
    {
      "start_ms": 283760,
      "end_ms": 285555,
      "text": "那些字就不再是字，",
      "token_start": 1091,
      "token_end_exclusive": 1099,
      "segment_id": "s000108"
    },
    {
      "start_ms": 286030,
      "end_ms": 288055,
      "text": "而是他去过的地方，",
      "token_start": 1099,
      "token_end_exclusive": 1107,
      "segment_id": "s000109"
    },
    {
      "start_ms": 288550,
      "end_ms": 289795,
      "text": "见过的风景。",
      "token_start": 1107,
      "token_end_exclusive": 1112,
      "segment_id": "s000110"
    },
    {
      "start_ms": 290360,
      "end_ms": 291420,
      "text": "听过的故事，",
      "token_start": 1112,
      "token_end_exclusive": 1117,
      "segment_id": "s000111"
    },
    {
      "start_ms": 291760,
      "end_ms": 293055,
      "text": "趁着孩子还小，",
      "token_start": 1117,
      "token_end_exclusive": 1123,
      "segment_id": "s000112"
    },
    {
      "start_ms": 293940,
      "end_ms": 295980,
      "text": "趁着他还愿意跟您出去，",
      "token_start": 1123,
      "token_end_exclusive": 1133,
      "segment_id": "s000113"
    },
    {
      "start_ms": 296080,
      "end_ms": 297425,
      "text": "多带他走走看看。",
      "token_start": 1133,
      "token_end_exclusive": 1140,
      "segment_id": "s000114"
    },
    {
      "start_ms": 297700,
      "end_ms": 299105,
      "text": "等孩子长大了，",
      "token_start": 1140,
      "token_end_exclusive": 1146,
      "segment_id": "s000115"
    },
    {
      "start_ms": 299380,
      "end_ms": 301905,
      "text": "这些经历就是他一辈子的财富。",
      "token_start": 1146,
      "token_end_exclusive": 1159,
      "segment_id": "s000116"
    },
    {
      "start_ms": 302180,
      "end_ms": 303225,
      "text": "这十座城，",
      "token_start": 1159,
      "token_end_exclusive": 1163,
      "segment_id": "s000117"
    },
    {
      "start_ms": 303640,
      "end_ms": 305385,
      "text": "您带孙辈去过几座，",
      "token_start": 1163,
      "token_end_exclusive": 1171,
      "segment_id": "s000118"
    },
    {
      "start_ms": 305880,
      "end_ms": 308355,
      "text": "最想带孩子去的是哪一座？",
      "token_start": 1171,
      "token_end_exclusive": 1182,
      "segment_id": "s000119"
    },
    {
      "start_ms": 308840,
      "end_ms": 309300,
      "text": "孩子？",
      "token_start": 1182,
      "token_end_exclusive": 1184,
      "segment_id": "s000120"
    },
    {
      "start_ms": 309300,
      "end_ms": 311400,
      "text": "去了以后印象最深的是什么？",
      "token_start": 1184,
      "token_end_exclusive": 1196,
      "segment_id": "s000121"
    },
    {
      "start_ms": 311600,
      "end_ms": 312815,
      "text": "评论区告诉我，",
      "token_start": 1196,
      "token_end_exclusive": 1202,
      "segment_id": "s000122"
    },
    {
      "start_ms": 313070,
      "end_ms": 313825,
      "text": "点个关注，",
      "token_start": 1202,
      "token_end_exclusive": 1206,
      "segment_id": "s000123"
    },
    {
      "start_ms": 314330,
      "end_ms": 317205,
      "text": "转发给您身边也在带孙辈的老朋友，",
      "token_start": 1206,
      "token_end_exclusive": 1221,
      "segment_id": "s000124"
    },
    {
      "start_ms": 317730,
      "end_ms": 318865,
      "text": "趁着孩子还小，",
      "token_start": 1221,
      "token_end_exclusive": 1227,
      "segment_id": "s000125"
    },
    {
      "start_ms": 319360,
      "end_ms": 322020,
      "text": "一起带他们去看看这些历史名城。",
      "token_start": 1227,
      "token_end_exclusive": 1241,
      "segment_id": "s000126"
    },
    {
      "start_ms": 322440,
      "end_ms": 327405,
      "text": "咱们下期接着盘点中国还有哪些地方值得带孩子去。",
      "token_start": 1241,
      "token_end_exclusive": 1263,
      "segment_id": "s000127"
    }
  ],
