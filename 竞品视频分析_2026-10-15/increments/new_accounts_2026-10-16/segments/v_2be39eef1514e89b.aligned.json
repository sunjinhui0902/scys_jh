{
  "video_id": "v_2be39eef1514e89b",
  "duration_s": 749.077007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_2be39eef1514e89b.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_2be39eef1514e89b.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 430,
      "text": "上集，",
      "token_start": 0,
      "token_end_exclusive": 2
    },
    {
      "start_ms": 430,
      "end_ms": 9210,
      "text": "咱们聊了雕漆盘严丝徒、玉龙炉、珐琅炉青铜尊这集直接揭开谜底，",
      "token_start": 2,
      "token_end_exclusive": 29
    },
    {
      "start_ms": 9690,
      "end_ms": 12550,
      "text": "看看前五名到底绝到什么程度。",
      "token_start": 29,
      "token_end_exclusive": 42
    },
    {
      "start_ms": 13810,
      "end_ms": 15730,
      "text": "老规矩开讲之前，",
      "token_start": 42,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 15910,
      "end_ms": 18310,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 49,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 18610,
      "end_ms": 20110,
      "text": "让我看看都是谁。",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 20110,
      "end_ms": 22190,
      "text": "在听第五名，",
      "token_start": 66,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 23070,
      "end_ms": 24890,
      "text": "彩漆描金楼阁式，",
      "token_start": 71,
      "token_end_exclusive": 78
    },
    {
      "start_ms": 24970,
      "end_ms": 25550,
      "text": "自开门，",
      "token_start": 78,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 25590,
      "end_ms": 26030,
      "text": "群仙，",
      "token_start": 81,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 26130,
      "end_ms": 27290,
      "text": "祝寿玉制。",
      "token_start": 83,
      "token_end_exclusive": 87
    },
    {
      "start_ms": 27290,
      "end_ms": 29750,
      "text": "钟您见过一座钟，",
      "token_start": 87,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 30380,
      "end_ms": 34960,
      "text": "每到整点楼阁大门会自己打开，",
      "token_start": 94,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 35380,
      "end_ms": 39620,
      "text": "里面走出一对小人敲钟的敲钟，",
      "token_start": 107,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 41020,
      "end_ms": 42440,
      "text": "奏乐的奏乐嘛。",
      "token_start": 120,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 42480,
      "end_ms": 46319,
      "text": "故宫里就有这么一座高一百八十五厘米，",
      "token_start": 126,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 46500,
      "end_ms": 47400,
      "text": "将近两米，",
      "token_start": 143,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 47720,
      "end_ms": 49680,
      "text": "里面藏了七套机械系统，",
      "token_start": 147,
      "token_end_exclusive": 157
    },
    {
      "start_ms": 50040,
      "end_ms": 53860,
      "text": "分别控制走时报时开门打乐，",
      "token_start": 157,
      "token_end_exclusive": 169
    },
    {
      "start_ms": 54140,
      "end_ms": 55060,
      "text": "小人走动，",
      "token_start": 169,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 55500,
      "end_ms": 57700,
      "text": "水法流动船只航行。",
      "token_start": 173,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 58360,
      "end_ms": 61485,
      "text": "每到整点楼哥的门自动打开，",
      "token_start": 181,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 61870,
      "end_ms": 63470,
      "text": "小人缓缓走动，",
      "token_start": 193,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 63770,
      "end_ms": 68795,
      "text": "乐声响起水法转动小船仿佛在水面航行。",
      "token_start": 199,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 69320,
      "end_ms": 72735,
      "text": "就连国外瑞士钟表专家看过都感叹，",
      "token_start": 216,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 73170,
      "end_ms": 75085,
      "text": "就算放到西洋钟表里，",
      "token_start": 231,
      "token_end_exclusive": 240
    },
    {
      "start_ms": 75620,
      "end_ms": 78005,
      "text": "这也是工艺极为复杂的珍品。",
      "token_start": 240,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 78840,
      "end_ms": 82520,
      "text": "这座钟从乾隆八年十二月接旨设计，",
      "token_start": 252,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 82520,
      "end_ms": 84825,
      "text": "到乾隆十四年正月完工，",
      "token_start": 267,
      "token_end_exclusive": 277
    },
    {
      "start_ms": 85210,
      "end_ms": 85950,
      "text": "历时五年。",
      "token_start": 277,
      "token_end_exclusive": 281
    },
    {
      "start_ms": 85950,
      "end_ms": 87230,
      "text": "多可。",
      "token_start": 281,
      "token_end_exclusive": 283
    },
    {
      "start_ms": 87230,
      "end_ms": 89685,
      "text": "您知道修复这座钟的人是谁吗？",
      "token_start": 283,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 90440,
      "end_ms": 93995,
      "text": "叫王金在故宫修了四十多年钟表。",
      "token_start": 296,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 94390,
      "end_ms": 94625,
      "text": "嗯，",
      "token_start": 310,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 94950,
      "end_ms": 97130,
      "text": "他第一次见到这座钟的时候，",
      "token_start": 311,
      "token_end_exclusive": 323
    },
    {
      "start_ms": 97430,
      "end_ms": 98935,
      "text": "器物残破不堪，",
      "token_start": 323,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 99460,
      "end_ms": 101245,
      "text": "上千个零件散落一地，",
      "token_start": 329,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 101690,
      "end_ms": 102875,
      "text": "没有原厂图纸，",
      "token_start": 338,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 103090,
      "end_ms": 104405,
      "text": "没有现成配件，",
      "token_start": 344,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 104900,
      "end_ms": 106935,
      "text": "坏一件就得亲手重做。",
      "token_start": 350,
      "token_end_exclusive": 359
    },
    {
      "start_ms": 107480,
      "end_ms": 108995,
      "text": "他打磨一个齿轮，",
      "token_start": 359,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 109400,
      "end_ms": 112425,
      "text": "光用锉刀锉就花了整整一个星期，",
      "token_start": 366,
      "token_end_exclusive": 380
    },
    {
      "start_ms": 112960,
      "end_ms": 114575,
      "text": "一点点校准尺距，",
      "token_start": 380,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 114900,
      "end_ms": 117825,
      "text": "让新零件和元件严丝合缝。",
      "token_start": 387,
      "token_end_exclusive": 398
    },
    {
      "start_ms": 118610,
      "end_ms": 119470,
      "text": "全部修好。",
      "token_start": 398,
      "token_end_exclusive": 402
    },
    {
      "start_ms": 119470,
      "end_ms": 120010,
      "text": "那一刻，",
      "token_start": 402,
      "token_end_exclusive": 405
    },
    {
      "start_ms": 120110,
      "end_ms": 121010,
      "text": "音乐响起，",
      "token_start": 405,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 121230,
      "end_ms": 122550,
      "text": "大门缓缓打开，",
      "token_start": 409,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 122910,
      "end_ms": 123790,
      "text": "小人迈步，",
      "token_start": 415,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 124050,
      "end_ms": 125105,
      "text": "水法流转。",
      "token_start": 419,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 125650,
      "end_ms": 126455,
      "text": "王晶说，",
      "token_start": 423,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 126820,
      "end_ms": 127360,
      "text": "那一刻，",
      "token_start": 426,
      "token_end_exclusive": 429
    },
    {
      "start_ms": 127580,
      "end_ms": 129425,
      "text": "心里的欢喜难以形容，",
      "token_start": 429,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 130180,
      "end_ms": 132235,
      "text": "这座钟两百多年了，",
      "token_start": 438,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 132440,
      "end_ms": 134705,
      "text": "上了发条依旧可以运转。",
      "token_start": 446,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 135230,
      "end_ms": 136950,
      "text": "靠着后人一双巧手，",
      "token_start": 456,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 137410,
      "end_ms": 140645,
      "text": "让两百多年前的机械再次活了过来。",
      "token_start": 464,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 141690,
      "end_ms": 144880,
      "text": "第四名青遇大禹治水图，",
      "token_start": 479,
      "token_end_exclusive": 489
    },
    {
      "start_ms": 144880,
      "end_ms": 147215,
      "text": "山子这件东西，",
      "token_start": 489,
      "token_end_exclusive": 495
    },
    {
      "start_ms": 149670,
      "end_ms": 152755,
      "text": "您第一眼看到他的时候会愣住，",
      "token_start": 495,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 153800,
      "end_ms": 157110,
      "text": "这东西人也能做出来。",
      "token_start": 508,
      "token_end_exclusive": 517
    },
    {
      "start_ms": 157190,
      "end_ms": 162310,
      "text": "高两米二四重约五千三百公斤，",
      "token_start": 517,
      "token_end_exclusive": 530
    },
    {
      "start_ms": 162330,
      "end_ms": 165025,
      "text": "是中国现存体量极大的玉雕。",
      "token_start": 530,
      "token_end_exclusive": 542
    },
    {
      "start_ms": 166030,
      "end_ms": 172250,
      "text": "这么大一块玉料采自新疆和田的弥勒塔山开采出来之后，",
      "token_start": 542,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 172430,
      "end_ms": 173730,
      "text": "先要运到北京，",
      "token_start": 566,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 173970,
      "end_ms": 176975,
      "text": "再从北京转运到扬州雕刻。",
      "token_start": 572,
      "token_end_exclusive": 583
    },
    {
      "start_ms": 177390,
      "end_ms": 180525,
      "text": "您想想几千公里的路途，",
      "token_start": 583,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 181220,
      "end_ms": 182560,
      "text": "那时候没有火车，",
      "token_start": 593,
      "token_end_exclusive": 600
    },
    {
      "start_ms": 182840,
      "end_ms": 183855,
      "text": "没有汽车，",
      "token_start": 600,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 184300,
      "end_ms": 185905,
      "text": "全靠人拉马坨，",
      "token_start": 604,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 186660,
      "end_ms": 190605,
      "text": "光是运送这块玉石路上就耗费好几年。",
      "token_start": 610,
      "token_end_exclusive": 626
    },
    {
      "start_ms": 191840,
      "end_ms": 194835,
      "text": "到了扬州顶尖御宫正式开工，",
      "token_start": 626,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 195380,
      "end_ms": 197605,
      "text": "数百名工匠耗时六年，",
      "token_start": 638,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 198490,
      "end_ms": 200485,
      "text": "足足十五万个工作日，",
      "token_start": 647,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 201260,
      "end_ms": 205435,
      "text": "才把一块冰冷巨石雕琢成一座会讲故事的山，",
      "token_start": 656,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 206160,
      "end_ms": 208905,
      "text": "雕刻的是大禹治水的故事，",
      "token_start": 675,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 209730,
      "end_ms": 211590,
      "text": "山峦、激流人物，",
      "token_start": 686,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 211850,
      "end_ms": 213850,
      "text": "树木层层叠叠，",
      "token_start": 692,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 213890,
      "end_ms": 214855,
      "text": "深浅错落。",
      "token_start": 698,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 215590,
      "end_ms": 216715,
      "text": "您站在他面前，",
      "token_start": 702,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 217620,
      "end_ms": 219525,
      "text": "不会觉得眼前只是一块玉，",
      "token_start": 708,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 219970,
      "end_ms": 222535,
      "text": "仿佛真的站在一座大山跟前。",
      "token_start": 719,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 223490,
      "end_ms": 226310,
      "text": "从深山采玉到雕琢，",
      "token_start": 731,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 226330,
      "end_ms": 226865,
      "text": "完工，",
      "token_start": 739,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 227590,
      "end_ms": 229235,
      "text": "前后整整十年，",
      "token_start": 741,
      "token_end_exclusive": 747
    },
    {
      "start_ms": 230090,
      "end_ms": 230610,
      "text": "十年，",
      "token_start": 747,
      "token_end_exclusive": 749
    },
    {
      "start_ms": 230710,
      "end_ms": 236215,
      "text": "光阴数千人的心血全都倾注在这一块玉石上。",
      "token_start": 749,
      "token_end_exclusive": 768
    },
    {
      "start_ms": 236630,
      "end_ms": 237695,
      "text": "完工之后，",
      "token_start": 768,
      "token_end_exclusive": 772
    },
    {
      "start_ms": 238050,
      "end_ms": 241030,
      "text": "乾隆十分看重亲笔题诗，",
      "token_start": 772,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 241530,
      "end_ms": 247630,
      "text": "让人刻在玉山背面第三名金欧永固杯。",
      "token_start": 782,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 248530,
      "end_ms": 253010,
      "text": "您知道乾隆皇帝每年大年初一早上起来做的第一件事是什么吗？",
      "token_start": 798,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 253970,
      "end_ms": 258870,
      "text": "用这只杯子喝一杯酒举行开笔仪式。",
      "token_start": 825,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 259530,
      "end_ms": 262330,
      "text": "这只杯子叫金欧永固纯金，",
      "token_start": 840,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 262430,
      "end_ms": 265330,
      "text": "打造杯身上镶嵌珍珠。",
      "token_start": 851,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 265590,
      "end_ms": 269800,
      "text": "红宝石蓝宝石碧玺一共三十六颗。",
      "token_start": 860,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 270720,
      "end_ms": 273800,
      "text": "刻杯子两侧是龙形双耳底部，",
      "token_start": 874,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 273820,
      "end_ms": 277919,
      "text": "三条腿做成象首造型龙头嵌珍珠，",
      "token_start": 886,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 278340,
      "end_ms": 279480,
      "text": "象首的额头，",
      "token_start": 900,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 279740,
      "end_ms": 281880,
      "text": "眼睛也都嵌满宝石，",
      "token_start": 905,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 282740,
      "end_ms": 285100,
      "text": "花纹之间还用了点翠工艺，",
      "token_start": 913,
      "token_end_exclusive": 924
    },
    {
      "start_ms": 285120,
      "end_ms": 287800,
      "text": "把翠鸟羽毛贴在黄金之上，",
      "token_start": 924,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 288100,
      "end_ms": 289660,
      "text": "蓝的鲜亮夺目。",
      "token_start": 935,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 290460,
      "end_ms": 292460,
      "text": "乾隆对这只杯子极为重视，",
      "token_start": 941,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 293060,
      "end_ms": 295845,
      "text": "从内务府挑选最好的黄金。",
      "token_start": 952,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 296570,
      "end_ms": 300350,
      "text": "珍珠宝石反复敲定图样，",
      "token_start": 963,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 300790,
      "end_ms": 301210,
      "text": "制作，",
      "token_start": 973,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 301210,
      "end_ms": 302630,
      "text": "图中一改再改，",
      "token_start": 975,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 303290,
      "end_ms": 304610,
      "text": "直到满意为止。",
      "token_start": 981,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 305450,
      "end_ms": 310650,
      "text": "清代一共制作了四支金欧永固碑故宫，",
      "token_start": 987,
      "token_end_exclusive": 1003
    },
    {
      "start_ms": 310650,
      "end_ms": 313530,
      "text": "现存这一只一直留在紫禁城，",
      "token_start": 1003,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 313810,
      "end_ms": 319930,
      "text": "还有一只收藏在台北故宫博物院另外一只铜鎏金款，",
      "token_start": 1015,
      "token_end_exclusive": 1037
    },
    {
      "start_ms": 320110,
      "end_ms": 321170,
      "text": "一只纯金款。",
      "token_start": 1037,
      "token_end_exclusive": 1042
    },
    {
      "start_ms": 321630,
      "end_ms": 324830,
      "text": "一千八百六十年圆明园遭劫掠时，",
      "token_start": 1042,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 324870,
      "end_ms": 326300,
      "text": "被英法联军带走，",
      "token_start": 1056,
      "token_end_exclusive": 1063
    },
    {
      "start_ms": 326540,
      "end_ms": 327620,
      "text": "几经辗转，",
      "token_start": 1063,
      "token_end_exclusive": 1067
    },
    {
      "start_ms": 327860,
      "end_ms": 333120,
      "text": "如今藏在英国伦敦华莱士收藏馆一只小小的杯子，",
      "token_start": 1067,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 333300,
      "end_ms": 335140,
      "text": "乾隆反复修改打磨，",
      "token_start": 1088,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 335560,
      "end_ms": 337420,
      "text": "他哪里只是在做杯子。",
      "token_start": 1096,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 338400,
      "end_ms": 340540,
      "text": "这金鸥永固四个字，",
      "token_start": 1105,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 340880,
      "end_ms": 348020,
      "text": "寓意着江山永固第二名琅琊红釉穿戴之口瓶。",
      "token_start": 1113,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 348880,
      "end_ms": 351960,
      "text": "这件东西您第一眼望过去，",
      "token_start": 1132,
      "token_end_exclusive": 1143
    },
    {
      "start_ms": 352200,
      "end_ms": 354520,
      "text": "会以为瓶身敷了一层红宝石，",
      "token_start": 1143,
      "token_end_exclusive": 1155
    },
    {
      "start_ms": 354520,
      "end_ms": 355560,
      "text": "研磨的粉墨，",
      "token_start": 1155,
      "token_end_exclusive": 1160
    },
    {
      "start_ms": 355860,
      "end_ms": 356825,
      "text": "红的发亮，",
      "token_start": 1160,
      "token_end_exclusive": 1164
    },
    {
      "start_ms": 357370,
      "end_ms": 358225,
      "text": "红的通透，",
      "token_start": 1164,
      "token_end_exclusive": 1168
    },
    {
      "start_ms": 358530,
      "end_ms": 360155,
      "text": "像刚刚凝固的牛血。",
      "token_start": 1168,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 361000,
      "end_ms": 362620,
      "text": "这种红釉叫琅窑，",
      "token_start": 1176,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 362620,
      "end_ms": 368485,
      "text": "红是康熙年间江西巡抚郎亭即主持景德镇御窑厂时，",
      "token_start": 1183,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 368990,
      "end_ms": 370655,
      "text": "窑工们烧制出来。",
      "token_start": 1205,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 371630,
      "end_ms": 373515,
      "text": "郎瑶红有一句口诀，",
      "token_start": 1212,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 374250,
      "end_ms": 376170,
      "text": "脱口垂足狼不留，",
      "token_start": 1220,
      "token_end_exclusive": 1227
    },
    {
      "start_ms": 376370,
      "end_ms": 377105,
      "text": "什么意思？",
      "token_start": 1227,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 377450,
      "end_ms": 381045,
      "text": "哥又料高温下会往下流淌，",
      "token_start": 1231,
      "token_end_exclusive": 1242
    },
    {
      "start_ms": 381340,
      "end_ms": 381580,
      "text": "口，",
      "token_start": 1242,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 381600,
      "end_ms": 382900,
      "text": "沿处又流走，",
      "token_start": 1243,
      "token_end_exclusive": 1248
    },
    {
      "start_ms": 383180,
      "end_ms": 384620,
      "text": "露出白色胎体，",
      "token_start": 1248,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 384880,
      "end_ms": 388445,
      "text": "叫脱口瓶底的釉堆积变厚，",
      "token_start": 1254,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 388870,
      "end_ms": 389770,
      "text": "颜色更深，",
      "token_start": 1265,
      "token_end_exclusive": 1269
    },
    {
      "start_ms": 390030,
      "end_ms": 391015,
      "text": "叫垂足。",
      "token_start": 1269,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 391680,
      "end_ms": 394700,
      "text": "工匠特意在砥足做出二层台，",
      "token_start": 1272,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 395100,
      "end_ms": 396565,
      "text": "拦住流淌的釉，",
      "token_start": 1284,
      "token_end_exclusive": 1290
    },
    {
      "start_ms": 396950,
      "end_ms": 398545,
      "text": "不让他漫到圈组底部。",
      "token_start": 1290,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 399300,
      "end_ms": 400645,
      "text": "这就是狼不留。",
      "token_start": 1299,
      "token_end_exclusive": 1305
    },
    {
      "start_ms": 401480,
      "end_ms": 403420,
      "text": "您知道琅窑红有多难烧吗？",
      "token_start": 1305,
      "token_end_exclusive": 1316
    },
    {
      "start_ms": 403440,
      "end_ms": 406675,
      "text": "窑内温度差一点点发色就完全不对，",
      "token_start": 1316,
      "token_end_exclusive": 1331
    },
    {
      "start_ms": 407430,
      "end_ms": 409350,
      "text": "烧石窑能成功，",
      "token_start": 1331,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 409350,
      "end_ms": 410745,
      "text": "一窑就算运气。",
      "token_start": 1337,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 411470,
      "end_ms": 412555,
      "text": "民间老话讲，",
      "token_start": 1343,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 413010,
      "end_ms": 414695,
      "text": "要想穷烧狼红，",
      "token_start": 1348,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 415030,
      "end_ms": 418690,
      "text": "很多窑姑烧一辈子能出几件合格，",
      "token_start": 1354,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 418690,
      "end_ms": 420670,
      "text": "琅窑红就已经是万幸。",
      "token_start": 1368,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 421530,
      "end_ms": 424010,
      "text": "这件瓶子历经两百多年，",
      "token_start": 1377,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 424270,
      "end_ms": 425810,
      "text": "红色依旧鲜亮，",
      "token_start": 1387,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 426090,
      "end_ms": 426590,
      "text": "光彩，",
      "token_start": 1393,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 426590,
      "end_ms": 426950,
      "text": "不减，",
      "token_start": 1395,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 427930,
      "end_ms": 431090,
      "text": "第一名黄公望富春山居图。",
      "token_start": 1397,
      "token_end_exclusive": 1408
    },
    {
      "start_ms": 431570,
      "end_ms": 432710,
      "text": "您知道有一幅画，",
      "token_start": 1408,
      "token_end_exclusive": 1415
    },
    {
      "start_ms": 433350,
      "end_ms": 436610,
      "text": "画家耗尽半生心血才画成吗？",
      "token_start": 1415,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 437430,
      "end_ms": 443330,
      "text": "元代画家黄公望五十岁左右才潜心学画七十九岁，",
      "token_start": 1427,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 443350,
      "end_ms": 446700,
      "text": "那年动笔绘制富春山居图，",
      "token_start": 1448,
      "token_end_exclusive": 1459
    },
    {
      "start_ms": 447480,
      "end_ms": 448680,
      "text": "前后画了四年。",
      "token_start": 1459,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 449280,
      "end_ms": 452580,
      "text": "画完他还提字阅三四载，",
      "token_start": 1465,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 452640,
      "end_ms": 453580,
      "text": "未得完备。",
      "token_start": 1475,
      "token_end_exclusive": 1479
    },
    {
      "start_ms": 454340,
      "end_ms": 456520,
      "text": "意思是画了三四年，",
      "token_start": 1479,
      "token_end_exclusive": 1487
    },
    {
      "start_ms": 456820,
      "end_ms": 459040,
      "text": "依旧觉得没有完全画到位。",
      "token_start": 1487,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 459520,
      "end_ms": 461720,
      "text": "这幅画画的是富春江两岸，",
      "token_start": 1498,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 461740,
      "end_ms": 463940,
      "text": "山水山不算巍峨，",
      "token_start": 1509,
      "token_end_exclusive": 1516
    },
    {
      "start_ms": 464000,
      "end_ms": 465080,
      "text": "水不算汹涌，",
      "token_start": 1516,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 465640,
      "end_ms": 467180,
      "text": "可您静心盯着看，",
      "token_start": 1521,
      "token_end_exclusive": 1528
    },
    {
      "start_ms": 467580,
      "end_ms": 469080,
      "text": "会感觉山势在动，",
      "token_start": 1528,
      "token_end_exclusive": 1535
    },
    {
      "start_ms": 469540,
      "end_ms": 472500,
      "text": "水似在流云气悠悠飘荡。",
      "token_start": 1535,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 472960,
      "end_ms": 476550,
      "text": "黄公望用笔极淡淡到几几乎，",
      "token_start": 1545,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 476610,
      "end_ms": 477490,
      "text": "若有若无，",
      "token_start": 1557,
      "token_end_exclusive": 1561
    },
    {
      "start_ms": 478170,
      "end_ms": 482470,
      "text": "但每一笔都落在恰到好处的位置。",
      "token_start": 1561,
      "token_end_exclusive": 1575
    },
    {
      "start_ms": 482610,
      "end_ms": 484249,
      "text": "明代董其昌看过之后，",
      "token_start": 1575,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 484249,
      "end_ms": 485150,
      "text": "盛赞这幅画，",
      "token_start": 1584,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 485630,
      "end_ms": 487130,
      "text": "称他应接不暇，",
      "token_start": 1589,
      "token_end_exclusive": 1595
    },
    {
      "start_ms": 487410,
      "end_ms": 488450,
      "text": "是意林飞仙。",
      "token_start": 1595,
      "token_end_exclusive": 1600
    },
    {
      "start_ms": 489230,
      "end_ms": 491850,
      "text": "可您知道这幅画后来的坎坷命运吗？",
      "token_start": 1600,
      "token_end_exclusive": 1615
    },
    {
      "start_ms": 492470,
      "end_ms": 493350,
      "text": "明朝末年，",
      "token_start": 1615,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 493670,
      "end_ms": 496710,
      "text": "收藏家吴鸿玉对这幅画爱到极致，",
      "token_start": 1619,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 497090,
      "end_ms": 498970,
      "text": "临死前打算把画烧掉，",
      "token_start": 1633,
      "token_end_exclusive": 1642
    },
    {
      "start_ms": 499830,
      "end_ms": 500890,
      "text": "给自己殉葬。",
      "token_start": 1642,
      "token_end_exclusive": 1647
    },
    {
      "start_ms": 501610,
      "end_ms": 504910,
      "text": "他的侄子急忙从烈火中将画抢救出来，",
      "token_start": 1647,
      "token_end_exclusive": 1663
    },
    {
      "start_ms": 505570,
      "end_ms": 506320,
      "text": "可画就卷，",
      "token_start": 1663,
      "token_end_exclusive": 1667
    },
    {
      "start_ms": 506320,
      "end_ms": 511460,
      "text": "已经烧成两段短的一段叫圣山图收藏。",
      "token_start": 1667,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 511460,
      "end_ms": 514800,
      "text": "在浙江博物馆长的一段叫吴用，",
      "token_start": 1683,
      "token_end_exclusive": 1696
    },
    {
      "start_ms": 514900,
      "end_ms": 517560,
      "text": "诗卷藏在台北故宫博物院，",
      "token_start": 1696,
      "token_end_exclusive": 1707
    },
    {
      "start_ms": 517660,
      "end_ms": 518220,
      "text": "一幅画，",
      "token_start": 1707,
      "token_end_exclusive": 1710
    },
    {
      "start_ms": 518540,
      "end_ms": 519840,
      "text": "生生断成两半，",
      "token_start": 1710,
      "token_end_exclusive": 1716
    },
    {
      "start_ms": 520200,
      "end_ms": 521320,
      "text": "一半在浙江，",
      "token_start": 1716,
      "token_end_exclusive": 1721
    },
    {
      "start_ms": 521560,
      "end_ms": 522640,
      "text": "一半在台北。",
      "token_start": 1721,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 523300,
      "end_ms": 525400,
      "text": "可当您欣赏这两段画卷，",
      "token_start": 1726,
      "token_end_exclusive": 1736
    },
    {
      "start_ms": 525780,
      "end_ms": 527980,
      "text": "山水气韵依旧相连，",
      "token_start": 1736,
      "token_end_exclusive": 1744
    },
    {
      "start_ms": 528700,
      "end_ms": 530600,
      "text": "山接着水水映着，",
      "token_start": 1744,
      "token_end_exclusive": 1751
    },
    {
      "start_ms": 530600,
      "end_ms": 533360,
      "text": "山仿佛从来不曾被大火分开。",
      "token_start": 1751,
      "token_end_exclusive": 1763
    },
    {
      "start_ms": 533760,
      "end_ms": 535100,
      "text": "从第五到第一名，",
      "token_start": 1763,
      "token_end_exclusive": 1770
    },
    {
      "start_ms": 535620,
      "end_ms": 538230,
      "text": "玉制中内置七套机械系统，",
      "token_start": 1770,
      "token_end_exclusive": 1781
    },
    {
      "start_ms": 538350,
      "end_ms": 540510,
      "text": "两百多年后依旧可以运转。",
      "token_start": 1781,
      "token_end_exclusive": 1792
    },
    {
      "start_ms": 541350,
      "end_ms": 543690,
      "text": "大禹治水玉山十年，",
      "token_start": 1792,
      "token_end_exclusive": 1800
    },
    {
      "start_ms": 543750,
      "end_ms": 548050,
      "text": "雕琢一块五千多公斤的巨石金欧永固碑。",
      "token_start": 1800,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 548470,
      "end_ms": 549790,
      "text": "乾隆反复修改，",
      "token_start": 1817,
      "token_end_exclusive": 1823
    },
    {
      "start_ms": 550110,
      "end_ms": 551750,
      "text": "镶嵌三十六颗珍宝，",
      "token_start": 1823,
      "token_end_exclusive": 1831
    },
    {
      "start_ms": 552530,
      "end_ms": 553850,
      "text": "琅窑红石窑，",
      "token_start": 1831,
      "token_end_exclusive": 1836
    },
    {
      "start_ms": 554270,
      "end_ms": 555290,
      "text": "南城亦窑，",
      "token_start": 1836,
      "token_end_exclusive": 1840
    },
    {
      "start_ms": 555450,
      "end_ms": 556430,
      "text": "烧至极险，",
      "token_start": 1840,
      "token_end_exclusive": 1844
    },
    {
      "start_ms": 556850,
      "end_ms": 559410,
      "text": "富春山居途黄公望，",
      "token_start": 1844,
      "token_end_exclusive": 1852
    },
    {
      "start_ms": 559450,
      "end_ms": 560310,
      "text": "晚年落笔，",
      "token_start": 1852,
      "token_end_exclusive": 1856
    },
    {
      "start_ms": 560530,
      "end_ms": 561450,
      "text": "烧至极险，",
      "token_start": 1856,
      "token_end_exclusive": 1860
    },
    {
      "start_ms": 561830,
      "end_ms": 563850,
      "text": "山水气韵不曾断绝。",
      "token_start": 1860,
      "token_end_exclusive": 1868
    },
    {
      "start_ms": 564350,
      "end_ms": 565470,
      "text": "这十件国宝，",
      "token_start": 1868,
      "token_end_exclusive": 1873
    },
    {
      "start_ms": 565730,
      "end_ms": 567700,
      "text": "有的刷上百层大旗，",
      "token_start": 1873,
      "token_end_exclusive": 1881
    },
    {
      "start_ms": 568060,
      "end_ms": 569980,
      "text": "有的剪断数万根丝线，",
      "token_start": 1881,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 570480,
      "end_ms": 572020,
      "text": "有的耗费十年打磨，",
      "token_start": 1890,
      "token_end_exclusive": 1898
    },
    {
      "start_ms": 572300,
      "end_ms": 573480,
      "text": "有的一摇摇，",
      "token_start": 1898,
      "token_end_exclusive": 1903
    },
    {
      "start_ms": 573480,
      "end_ms": 574340,
      "text": "反复试烧。",
      "token_start": 1903,
      "token_end_exclusive": 1907
    },
    {
      "start_ms": 574900,
      "end_ms": 576380,
      "text": "但他们有一个共同点，",
      "token_start": 1907,
      "token_end_exclusive": 1916
    },
    {
      "start_ms": 576660,
      "end_ms": 577600,
      "text": "全是中国人。",
      "token_start": 1916,
      "token_end_exclusive": 1921
    },
    {
      "start_ms": 577600,
      "end_ms": 578400,
      "text": "凭着一双手，",
      "token_start": 1921,
      "token_end_exclusive": 1926
    },
    {
      "start_ms": 578760,
      "end_ms": 582780,
      "text": "一刀一刀一针一线一层一层亲手做出来。",
      "token_start": 1926,
      "token_end_exclusive": 1943
    },
    {
      "start_ms": 583240,
      "end_ms": 585220,
      "text": "当年那些匠人制作的时候，",
      "token_start": 1943,
      "token_end_exclusive": 1954
    },
    {
      "start_ms": 585340,
      "end_ms": 588040,
      "text": "未必想着要做出惊世绝品，",
      "token_start": 1954,
      "token_end_exclusive": 1965
    },
    {
      "start_ms": 588760,
      "end_ms": 589920,
      "text": "心里只想着一件事，",
      "token_start": 1965,
      "token_end_exclusive": 1973
    },
    {
      "start_ms": 589920,
      "end_ms": 592420,
      "text": "这活儿要做到足够好。",
      "token_start": 1973,
      "token_end_exclusive": 1982
    },
    {
      "start_ms": 593180,
      "end_ms": 595695,
      "text": "您知道这些宝贝如今在哪儿吗？",
      "token_start": 1982,
      "token_end_exclusive": 1995
    },
    {
      "start_ms": 596230,
      "end_ms": 600225,
      "text": "雕漆盘在漆器馆严词图在直绣馆。",
      "token_start": 1995,
      "token_end_exclusive": 2009
    },
    {
      "start_ms": 601040,
      "end_ms": 602980,
      "text": "玉制钟在钟表馆，",
      "token_start": 2009,
      "token_end_exclusive": 2016
    },
    {
      "start_ms": 603520,
      "end_ms": 604540,
      "text": "大禹治水，",
      "token_start": 2016,
      "token_end_exclusive": 2020
    },
    {
      "start_ms": 604560,
      "end_ms": 606160,
      "text": "玉山在珍宝馆，",
      "token_start": 2020,
      "token_end_exclusive": 2026
    },
    {
      "start_ms": 606700,
      "end_ms": 608140,
      "text": "可您就算去到故宫，",
      "token_start": 2026,
      "token_end_exclusive": 2034
    },
    {
      "start_ms": 608320,
      "end_ms": 610580,
      "text": "也未必能一次性全部看到。",
      "token_start": 2034,
      "token_end_exclusive": 2045
    },
    {
      "start_ms": 611320,
      "end_ms": 613160,
      "text": "有的常年不对外展出，",
      "token_start": 2045,
      "token_end_exclusive": 2054
    },
    {
      "start_ms": 613560,
      "end_ms": 614480,
      "text": "就算展出。",
      "token_start": 2054,
      "token_end_exclusive": 2058
    },
    {
      "start_ms": 614740,
      "end_ms": 616100,
      "text": "隔着厚厚的玻璃，",
      "token_start": 2058,
      "token_end_exclusive": 2065
    },
    {
      "start_ms": 616500,
      "end_ms": 618300,
      "text": "匆匆看几眼就过去了。",
      "token_start": 2065,
      "token_end_exclusive": 2074
    },
    {
      "start_ms": 618520,
      "end_ms": 621540,
      "text": "您还记得那只金杯嵌了多少宝石吗？",
      "token_start": 2074,
      "token_end_exclusive": 2089
    },
    {
      "start_ms": 622240,
      "end_ms": 626200,
      "text": "那座古钟里面有几套机械安思，",
      "token_start": 2089,
      "token_end_exclusive": 2102
    },
    {
      "start_ms": 626300,
      "end_ms": 628780,
      "text": "凭什么一寸真丝一寸金？",
      "token_start": 2102,
      "token_end_exclusive": 2112
    },
    {
      "start_ms": 628960,
      "end_ms": 629620,
      "text": "前一阵子，",
      "token_start": 2112,
      "token_end_exclusive": 2116
    },
    {
      "start_ms": 629620,
      "end_ms": 631270,
      "text": "我翻到一本故宫日历，",
      "token_start": 2116,
      "token_end_exclusive": 2125
    },
    {
      "start_ms": 631830,
      "end_ms": 635810,
      "text": "他从故宫一百八十六万件文物里挑选精品，",
      "token_start": 2125,
      "token_end_exclusive": 2143
    },
    {
      "start_ms": 636030,
      "end_ms": 638630,
      "text": "一天一件展现在眼前。",
      "token_start": 2143,
      "token_end_exclusive": 2152
    },
    {
      "start_ms": 639430,
      "end_ms": 641310,
      "text": "二零二七年是羊年，",
      "token_start": 2152,
      "token_end_exclusive": 2160
    },
    {
      "start_ms": 641750,
      "end_ms": 646530,
      "text": "这本生肖日历收录九十件洋主题文物，",
      "token_start": 2160,
      "token_end_exclusive": 2176
    },
    {
      "start_ms": 646889,
      "end_ms": 652810,
      "text": "还有七十五件皇帝触寻文物、两百八十多件江南盛景文物。",
      "token_start": 2176,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 653790,
      "end_ms": 655670,
      "text": "咱们今天聊的这十件宝贝，",
      "token_start": 2200,
      "token_end_exclusive": 2211
    },
    {
      "start_ms": 656070,
      "end_ms": 658670,
      "text": "书里一件一件讲的清清楚楚，",
      "token_start": 2211,
      "token_end_exclusive": 2223
    },
    {
      "start_ms": 659070,
      "end_ms": 662245,
      "text": "您随手翻一页就能遇见一件国宝。",
      "token_start": 2223,
      "token_end_exclusive": 2237
    },
    {
      "start_ms": 662930,
      "end_ms": 664990,
      "text": "您要是计划去故宫出门前，",
      "token_start": 2237,
      "token_end_exclusive": 2248
    },
    {
      "start_ms": 664990,
      "end_ms": 665590,
      "text": "先翻一翻，",
      "token_start": 2248,
      "token_end_exclusive": 2252
    },
    {
      "start_ms": 665590,
      "end_ms": 667755,
      "text": "这本日历到了展厅，",
      "token_start": 2252,
      "token_end_exclusive": 2260
    },
    {
      "start_ms": 668130,
      "end_ms": 670745,
      "text": "您看的就不再是冷冰冰的石头、木桶，",
      "token_start": 2260,
      "token_end_exclusive": 2275
    },
    {
      "start_ms": 671220,
      "end_ms": 672745,
      "text": "而是老祖宗的智慧，",
      "token_start": 2275,
      "token_end_exclusive": 2283
    },
    {
      "start_ms": 673090,
      "end_ms": 676755,
      "text": "暂时没法去故宫的在家翻书看图，",
      "token_start": 2283,
      "token_end_exclusive": 2297
    },
    {
      "start_ms": 677270,
      "end_ms": 680410,
      "text": "也算足不出户一睹国宝风采。",
      "token_start": 2297,
      "token_end_exclusive": 2309
    },
    {
      "start_ms": 680670,
      "end_ms": 681745,
      "text": "放在茶几上，",
      "token_start": 2309,
      "token_end_exclusive": 2314
    },
    {
      "start_ms": 682210,
      "end_ms": 683310,
      "text": "孙子孙女来了，",
      "token_start": 2314,
      "token_end_exclusive": 2320
    },
    {
      "start_ms": 683310,
      "end_ms": 684355,
      "text": "随手翻两页，",
      "token_start": 2320,
      "token_end_exclusive": 2325
    },
    {
      "start_ms": 684930,
      "end_ms": 686250,
      "text": "既能长见识，",
      "token_start": 2325,
      "token_end_exclusive": 2330
    },
    {
      "start_ms": 686350,
      "end_ms": 687825,
      "text": "写作文都能用上。",
      "token_start": 2330,
      "token_end_exclusive": 2337
    },
    {
      "start_ms": 688240,
      "end_ms": 690005,
      "text": "老两口晚上一起翻一翻，",
      "token_start": 2337,
      "token_end_exclusive": 2347
    },
    {
      "start_ms": 690460,
      "end_ms": 693385,
      "text": "聊聊历史商量明年去哪游玩，",
      "token_start": 2347,
      "token_end_exclusive": 2359
    },
    {
      "start_ms": 693850,
      "end_ms": 696485,
      "text": "比一直刷手机有意思的多。",
      "token_start": 2359,
      "token_end_exclusive": 2370
    },
    {
      "start_ms": 697690,
      "end_ms": 700075,
      "text": "一个家最珍贵的不是房子，",
      "token_start": 2370,
      "token_end_exclusive": 2381
    },
    {
      "start_ms": 700450,
      "end_ms": 701310,
      "text": "不是存款，",
      "token_start": 2381,
      "token_end_exclusive": 2385
    },
    {
      "start_ms": 701470,
      "end_ms": 702375,
      "text": "而是家底。",
      "token_start": 2385,
      "token_end_exclusive": 2389
    },
    {
      "start_ms": 703210,
      "end_ms": 704275,
      "text": "家底是什么？",
      "token_start": 2389,
      "token_end_exclusive": 2394
    },
    {
      "start_ms": 704900,
      "end_ms": 707715,
      "text": "就是清楚咱们这个民族从哪里来？",
      "token_start": 2394,
      "token_end_exclusive": 2408
    },
    {
      "start_ms": 708490,
      "end_ms": 712165,
      "text": "知道先辈曾经创下何等了不起的手艺，",
      "token_start": 2408,
      "token_end_exclusive": 2424
    },
    {
      "start_ms": 712660,
      "end_ms": 716130,
      "text": "这本书收录的就是咱们中国人的家底，",
      "token_start": 2424,
      "token_end_exclusive": 2440
    },
    {
      "start_ms": 716250,
      "end_ms": 718650,
      "text": "把他留下来下一代。",
      "token_start": 2440,
      "token_end_exclusive": 2448
    },
    {
      "start_ms": 718650,
      "end_ms": 722375,
      "text": "翻开更明白自己身为中国人的根脉在哪里。",
      "token_start": 2448,
      "token_end_exclusive": 2466
    },
    {
      "start_ms": 723590,
      "end_ms": 727405,
      "text": "感兴趣的朋友下方小黄车点进去看一看，",
      "token_start": 2466,
      "token_end_exclusive": 2483
    },
    {
      "start_ms": 728220,
      "end_ms": 729565,
      "text": "暂时走不出去，",
      "token_start": 2483,
      "token_end_exclusive": 2489
    },
    {
      "start_ms": 730380,
      "end_ms": 732005,
      "text": "咱就把故宫搬进家里。",
      "token_start": 2489,
      "token_end_exclusive": 2498
    },
    {
      "start_ms": 733040,
      "end_ms": 734125,
      "text": "最后问您一句，",
      "token_start": 2498,
      "token_end_exclusive": 2504
    },
    {
      "start_ms": 735310,
      "end_ms": 740055,
      "text": "这十件东西您听说过几件最想去看哪一件？",
      "token_start": 2504,
      "token_end_exclusive": 2522
    },
    {
      "start_ms": 740290,
      "end_ms": 741255,
      "text": "评论区告诉我，",
      "token_start": 2522,
      "token_end_exclusive": 2528
    },
    {
      "start_ms": 741500,
      "end_ms": 743020,
      "text": "觉得这期长见识了，",
      "token_start": 2528,
      "token_end_exclusive": 2536
    },
    {
      "start_ms": 743060,
      "end_ms": 743775,
      "text": "点个赞，",
      "token_start": 2536,
      "token_end_exclusive": 2539
    },
    {
      "start_ms": 744040,
      "end_ms": 744680,
      "text": "点个收藏，",
      "token_start": 2539,
      "token_end_exclusive": 2543
    },
    {
      "start_ms": 745000,
      "end_ms": 746460,
      "text": "想看更多故宫的故事，",
      "token_start": 2543,
      "token_end_exclusive": 2552
    },
    {
      "start_ms": 746460,
      "end_ms": 747285,
      "text": "点个关注，",
      "token_start": 2552,
      "token_end_exclusive": 2556
    },
    {
      "start_ms": 747650,
      "end_ms": 749015,
      "text": "咱们下回接着聊。",
      "token_start": 2556,
      "token_end_exclusive": 2563
    }
  ],
