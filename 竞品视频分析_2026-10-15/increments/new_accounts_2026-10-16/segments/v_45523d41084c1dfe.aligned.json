{
  "video_id": "v_45523d41084c1dfe",
  "duration_s": 554.005986,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_45523d41084c1dfe.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_45523d41084c1dfe.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 3690,
      "text": "您知道故宫里有一件东西是人做出来，",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 4570,
      "end_ms": 6450,
      "text": "但看着像老天爷做的吗？",
      "token_start": 16,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 7230,
      "end_ms": 9450,
      "text": "不是那些天然形成的玉石，",
      "token_start": 26,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 10170,
      "end_ms": 12570,
      "text": "也不是那些长了几百年的古树，",
      "token_start": 37,
      "token_end_exclusive": 50
    },
    {
      "start_ms": 12990,
      "end_ms": 19230,
      "text": "是人用一双手一刀一刀一针一线一层一层做出来的东西。",
      "token_start": 50,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 19790,
      "end_ms": 22950,
      "text": "可您第一眼看到它的时候会愣住，",
      "token_start": 74,
      "token_end_exclusive": 88
    },
    {
      "start_ms": 23690,
      "end_ms": 26730,
      "text": "这东西人也能做出来。",
      "token_start": 88,
      "token_end_exclusive": 97
    },
    {
      "start_ms": 26990,
      "end_ms": 30540,
      "text": "今天咱们就来盘点故宫里十件人做的做出来，",
      "token_start": 97,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 31300,
      "end_ms": 33400,
      "text": "但看着像老天爷做的宝贝，",
      "token_start": 116,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 33900,
      "end_ms": 38119,
      "text": "每一件都代表了老祖宗手艺的极高水平，",
      "token_start": 127,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 38280,
      "end_ms": 41600,
      "text": "每一件后人想仿很难仿到位。",
      "token_start": 144,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 42260,
      "end_ms": 43920,
      "text": "老规矩开讲之前，",
      "token_start": 156,
      "token_end_exclusive": 163
    },
    {
      "start_ms": 43920,
      "end_ms": 45960,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 163,
      "token_end_exclusive": 173
    },
    {
      "start_ms": 46540,
      "end_ms": 48020,
      "text": "让我看看都是谁。",
      "token_start": 173,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 48020,
      "end_ms": 54760,
      "text": "在盘第十名章程造款雕漆云纹盘这件东西，",
      "token_start": 180,
      "token_end_exclusive": 198
    },
    {
      "start_ms": 55640,
      "end_ms": 59405,
      "text": "您第一眼看到他的时候会愣住，",
      "token_start": 198,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 60020,
      "end_ms": 66725,
      "text": "这东西人也能做出来黑的发亮匀文圆润，",
      "token_start": 211,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 67140,
      "end_ms": 68565,
      "text": "摸上去跟玉一样，",
      "token_start": 228,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 69670,
      "end_ms": 71055,
      "text": "可它其实是木头做，",
      "token_start": 235,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 71330,
      "end_ms": 71485,
      "text": "嗯，",
      "token_start": 243,
      "token_end_exclusive": 244
    },
    {
      "start_ms": 71710,
      "end_ms": 73550,
      "text": "外面刷了一层又一层的漆。",
      "token_start": 244,
      "token_end_exclusive": 255
    },
    {
      "start_ms": 74110,
      "end_ms": 76450,
      "text": "元代有一个叫张程的七七大使，",
      "token_start": 255,
      "token_end_exclusive": 268
    },
    {
      "start_ms": 76470,
      "end_ms": 77645,
      "text": "做涕洪出名。",
      "token_start": 268,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 78660,
      "end_ms": 79505,
      "text": "什么叫涕红？",
      "token_start": 273,
      "token_end_exclusive": 278
    },
    {
      "start_ms": 80340,
      "end_ms": 81940,
      "text": "就是在器物上刷红，",
      "token_start": 278,
      "token_end_exclusive": 286
    },
    {
      "start_ms": 81980,
      "end_ms": 84265,
      "text": "漆刷到足够厚，",
      "token_start": 286,
      "token_end_exclusive": 292
    },
    {
      "start_ms": 85040,
      "end_ms": 88065,
      "text": "再用刀一刀一刀把花纹剃出来，",
      "token_start": 292,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 89190,
      "end_ms": 90465,
      "text": "您知道刷多少层吗？",
      "token_start": 305,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 91680,
      "end_ms": 92955,
      "text": "少则八九十层，",
      "token_start": 313,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 93340,
      "end_ms": 94695,
      "text": "多则一二百层，",
      "token_start": 319,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 95150,
      "end_ms": 98235,
      "text": "每一层都要等前一层干透了才能刷下一层。",
      "token_start": 325,
      "token_end_exclusive": 343
    },
    {
      "start_ms": 98990,
      "end_ms": 99990,
      "text": "刷完一百层，",
      "token_start": 343,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 100330,
      "end_ms": 101775,
      "text": "少说也要几个月，",
      "token_start": 348,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 102580,
      "end_ms": 104165,
      "text": "张程不光会剃红，",
      "token_start": 355,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 104600,
      "end_ms": 106155,
      "text": "替西也是高手，",
      "token_start": 362,
      "token_end_exclusive": 368
    },
    {
      "start_ms": 106540,
      "end_ms": 108235,
      "text": "气息比提红更难，",
      "token_start": 368,
      "token_end_exclusive": 375
    },
    {
      "start_ms": 109120,
      "end_ms": 111980,
      "text": "要用两种颜色的漆交替着，",
      "token_start": 375,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 111980,
      "end_ms": 114125,
      "text": "刷刷到足够厚，",
      "token_start": 386,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 114820,
      "end_ms": 117765,
      "text": "再用刀剔出云门这件盘子，",
      "token_start": 392,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 118430,
      "end_ms": 123050,
      "text": "刀口断面上露出了四道朱红色的漆线。",
      "token_start": 403,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 123950,
      "end_ms": 126110,
      "text": "古籍里叫乌间朱线，",
      "token_start": 419,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 126850,
      "end_ms": 128970,
      "text": "黑色的漆里夹着红色的线，",
      "token_start": 427,
      "token_end_exclusive": 438
    },
    {
      "start_ms": 129630,
      "end_ms": 130650,
      "text": "像一条红线，",
      "token_start": 438,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 130770,
      "end_ms": 131610,
      "text": "藏在墨里，",
      "token_start": 443,
      "token_end_exclusive": 447
    },
    {
      "start_ms": 131970,
      "end_ms": 133770,
      "text": "张成做了一辈子漆漆。",
      "token_start": 447,
      "token_end_exclusive": 456
    },
    {
      "start_ms": 134430,
      "end_ms": 137590,
      "text": "这件盘子是他的传世代表作，",
      "token_start": 456,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 138290,
      "end_ms": 141130,
      "text": "到现在专家尝试复刻。",
      "token_start": 468,
      "token_end_exclusive": 477
    },
    {
      "start_ms": 141830,
      "end_ms": 143510,
      "text": "雕出来的漆不是太软，",
      "token_start": 477,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 143550,
      "end_ms": 144230,
      "text": "就是太脆，",
      "token_start": 486,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 144990,
      "end_ms": 146930,
      "text": "雕出来的云纹不是太深，",
      "token_start": 490,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 147030,
      "end_ms": 147710,
      "text": "就是太浅，",
      "token_start": 500,
      "token_end_exclusive": 504
    },
    {
      "start_ms": 148210,
      "end_ms": 151800,
      "text": "后人想仿仿不了第九名。",
      "token_start": 504,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 152160,
      "end_ms": 153760,
      "text": "沈子幡深思，",
      "token_start": 514,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 153760,
      "end_ms": 154380,
      "text": "梅雀图，",
      "token_start": 519,
      "token_end_exclusive": 522
    },
    {
      "start_ms": 155220,
      "end_ms": 157080,
      "text": "您知道什么叫万丝吗？",
      "token_start": 522,
      "token_end_exclusive": 531
    },
    {
      "start_ms": 157080,
      "end_ms": 158860,
      "text": "就是通经断尾经线，",
      "token_start": 531,
      "token_end_exclusive": 539
    },
    {
      "start_ms": 158960,
      "end_ms": 161740,
      "text": "从头到尾是连贯的尾线，",
      "token_start": 539,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 161740,
      "end_ms": 165840,
      "text": "是一段一段断开的织一朵花织朵花，",
      "token_start": 549,
      "token_end_exclusive": 564
    },
    {
      "start_ms": 165900,
      "end_ms": 171420,
      "text": "用一种颜色的纬线织完了就剪断换另一种颜色，",
      "token_start": 564,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 171420,
      "end_ms": 173140,
      "text": "在织一根尾线，",
      "token_start": 584,
      "token_end_exclusive": 590
    },
    {
      "start_ms": 173160,
      "end_ms": 174260,
      "text": "只织一个颜色，",
      "token_start": 590,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 174800,
      "end_ms": 177480,
      "text": "一幅画下来要剪几万根线。",
      "token_start": 596,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 178280,
      "end_ms": 180330,
      "text": "南宋有个叫沈子幡的的人，",
      "token_start": 607,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 180990,
      "end_ms": 183490,
      "text": "用这种手艺织了一幅梅雀图。",
      "token_start": 618,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 184250,
      "end_ms": 186250,
      "text": "一只喜鹊站在梅枝上，",
      "token_start": 630,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 186670,
      "end_ms": 188870,
      "text": "喜鹊的眼睛灵动鲜活，",
      "token_start": 639,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 189370,
      "end_ms": 190310,
      "text": "换一个角度，",
      "token_start": 648,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 190710,
      "end_ms": 192950,
      "text": "眼睛仿佛会发光。",
      "token_start": 653,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 193170,
      "end_ms": 194130,
      "text": "您凑近看，",
      "token_start": 660,
      "token_end_exclusive": 664
    },
    {
      "start_ms": 194470,
      "end_ms": 197910,
      "text": "画面上的每一根丝线密度到了经线，",
      "token_start": 664,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 197970,
      "end_ms": 199390,
      "text": "二十根一厘米，",
      "token_start": 679,
      "token_end_exclusive": 685
    },
    {
      "start_ms": 199570,
      "end_ms": 202870,
      "text": "尾线四十四到四十六根一厘米，",
      "token_start": 685,
      "token_end_exclusive": 698
    },
    {
      "start_ms": 203130,
      "end_ms": 203885,
      "text": "什么概念？",
      "token_start": 698,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 206070,
      "end_ms": 208830,
      "text": "一厘米里头排了四十几根线，",
      "token_start": 702,
      "token_end_exclusive": 714
    },
    {
      "start_ms": 209010,
      "end_ms": 210150,
      "text": "比头发丝还密。",
      "token_start": 714,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 210470,
      "end_ms": 211110,
      "text": "古人说，",
      "token_start": 720,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 211150,
      "end_ms": 212910,
      "text": "一寸嫩丝一寸金，",
      "token_start": 723,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 213570,
      "end_ms": 216490,
      "text": "不是夸张一件恩丝作品。",
      "token_start": 730,
      "token_end_exclusive": 740
    },
    {
      "start_ms": 217250,
      "end_ms": 219610,
      "text": "匠人一做就是常年累月，",
      "token_start": 740,
      "token_end_exclusive": 750
    },
    {
      "start_ms": 220390,
      "end_ms": 222350,
      "text": "要是做一件恩丝衣物，",
      "token_start": 750,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 222810,
      "end_ms": 224570,
      "text": "常常要花整整一年。",
      "token_start": 759,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 225270,
      "end_ms": 229230,
      "text": "沈子帆一生完成了数十件选丝艺术品，",
      "token_start": 767,
      "token_end_exclusive": 783
    },
    {
      "start_ms": 229590,
      "end_ms": 231090,
      "text": "但标有他名字，",
      "token_start": 783,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 231510,
      "end_ms": 235230,
      "text": "但明确注入的传世作品只有五件。",
      "token_start": 789,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 235350,
      "end_ms": 237440,
      "text": "这件梅雀图就是其中之一。",
      "token_start": 803,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 238120,
      "end_ms": 241175,
      "text": "一幅蓝瓷画作要耗费数年功夫。",
      "token_start": 814,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 241900,
      "end_ms": 243300,
      "text": "等吃完人都好，",
      "token_start": 827,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 243300,
      "end_ms": 245175,
      "text": "老第八名，",
      "token_start": 833,
      "token_end_exclusive": 837
    },
    {
      "start_ms": 246290,
      "end_ms": 247965,
      "text": "青玉、云龙文儒，",
      "token_start": 837,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 248840,
      "end_ms": 250565,
      "text": "这是一件宋代的玉器。",
      "token_start": 843,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 251000,
      "end_ms": 253015,
      "text": "您知道宋代玉器有多绝吗？",
      "token_start": 852,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 253730,
      "end_ms": 257075,
      "text": "宋人雕玉不追求个头大，",
      "token_start": 863,
      "token_end_exclusive": 873
    },
    {
      "start_ms": 257690,
      "end_ms": 258665,
      "text": "追求巧，",
      "token_start": 873,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 259390,
      "end_ms": 262485,
      "text": "这件炉子高不到八厘米，",
      "token_start": 876,
      "token_end_exclusive": 886
    },
    {
      "start_ms": 263130,
      "end_ms": 264905,
      "text": "口径不到十三厘米，",
      "token_start": 886,
      "token_end_exclusive": 894
    },
    {
      "start_ms": 265580,
      "end_ms": 268820,
      "text": "一只手就能握住卢身上雕了。",
      "token_start": 894,
      "token_end_exclusive": 906
    },
    {
      "start_ms": 268820,
      "end_ms": 271635,
      "text": "一条龙龙在云里翻腾，",
      "token_start": 906,
      "token_end_exclusive": 915
    },
    {
      "start_ms": 272100,
      "end_ms": 274560,
      "text": "您拿放大镜看龙的鳞片，",
      "token_start": 915,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 274800,
      "end_ms": 275680,
      "text": "一片一片，",
      "token_start": 925,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 275780,
      "end_ms": 277425,
      "text": "每一片形态都不一样。",
      "token_start": 929,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 278260,
      "end_ms": 279105,
      "text": "龙的爪子，",
      "token_start": 938,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 279930,
      "end_ms": 280710,
      "text": "五个指头，",
      "token_start": 942,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 280930,
      "end_ms": 282130,
      "text": "每一个指头都刻出，",
      "token_start": 946,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 282130,
      "end_ms": 285025,
      "text": "指甲云纹一根一根，",
      "token_start": 954,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 285880,
      "end_ms": 286920,
      "text": "粗细深浅，",
      "token_start": 962,
      "token_end_exclusive": 966
    },
    {
      "start_ms": 286920,
      "end_ms": 287835,
      "text": "全有变化，",
      "token_start": 966,
      "token_end_exclusive": 970
    },
    {
      "start_ms": 289010,
      "end_ms": 291275,
      "text": "宋人雕玉不用机器，",
      "token_start": 970,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 291720,
      "end_ms": 296385,
      "text": "全靠砣具一点一点慢慢磨一件这么小的器物。",
      "token_start": 978,
      "token_end_exclusive": 997
    },
    {
      "start_ms": 297150,
      "end_ms": 298470,
      "text": "工匠要磨几个月，",
      "token_start": 997,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 298650,
      "end_ms": 299970,
      "text": "甚至整整一年，",
      "token_start": 1004,
      "token_end_exclusive": 1010
    },
    {
      "start_ms": 300790,
      "end_ms": 304170,
      "text": "您想想一块原石拿在手里，",
      "token_start": 1010,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 304330,
      "end_ms": 308710,
      "text": "日复一日细细打磨细到龙的鳞片都清晰分明，",
      "token_start": 1021,
      "token_end_exclusive": 1040
    },
    {
      "start_ms": 309190,
      "end_ms": 312650,
      "text": "人的手能做到这个份上实在惊人。",
      "token_start": 1040,
      "token_end_exclusive": 1054
    },
    {
      "start_ms": 314050,
      "end_ms": 314750,
      "text": "第七名，",
      "token_start": 1054,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 314830,
      "end_ms": 315690,
      "text": "掐死珐郎，",
      "token_start": 1057,
      "token_end_exclusive": 1061
    },
    {
      "start_ms": 315690,
      "end_ms": 320490,
      "text": "缠之连纹象耳龙珐琅这门手艺做代，",
      "token_start": 1061,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 320790,
      "end_ms": 322110,
      "text": "从阿拉伯传入，",
      "token_start": 1076,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 322890,
      "end_ms": 324450,
      "text": "可中国人学过来之后，",
      "token_start": 1082,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 325210,
      "end_ms": 331420,
      "text": "做的比猿头还要精上这件炉子用的是掐丝珐琅工艺。",
      "token_start": 1091,
      "token_end_exclusive": 1113
    },
    {
      "start_ms": 331720,
      "end_ms": 332740,
      "text": "什么叫掐丝？",
      "token_start": 1113,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 333240,
      "end_ms": 336620,
      "text": "就是用细铜丝在铜胎上掐出花纹，",
      "token_start": 1118,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 337100,
      "end_ms": 339260,
      "text": "掐好之后填上珐琅釉料，",
      "token_start": 1132,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 339600,
      "end_ms": 341060,
      "text": "再放进窑里烧制，",
      "token_start": 1142,
      "token_end_exclusive": 1149
    },
    {
      "start_ms": 341400,
      "end_ms": 344220,
      "text": "烧一遍不够要反复烧好几遍，",
      "token_start": 1149,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 344640,
      "end_ms": 347400,
      "text": "每烧一遍釉料就会收缩。",
      "token_start": 1161,
      "token_end_exclusive": 1171
    },
    {
      "start_ms": 348060,
      "end_ms": 349360,
      "text": "凹下去就要补釉，",
      "token_start": 1171,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 349660,
      "end_ms": 351220,
      "text": "填了再烧来回，",
      "token_start": 1178,
      "token_end_exclusive": 1184
    },
    {
      "start_ms": 351300,
      "end_ms": 351760,
      "text": "反复，",
      "token_start": 1184,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 351800,
      "end_ms": 355060,
      "text": "直到釉面和铜丝齐平为止。",
      "token_start": 1186,
      "token_end_exclusive": 1197
    },
    {
      "start_ms": 355760,
      "end_ms": 363495,
      "text": "您想想铜丝有多细一根铜丝比头发丝粗不了多少，",
      "token_start": 1197,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 364190,
      "end_ms": 367775,
      "text": "要在上面掐除蝉枝连门一朵花，",
      "token_start": 1218,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 368570,
      "end_ms": 374105,
      "text": "一片叶子一根藤蔓全靠铜丝弯折成型。",
      "token_start": 1231,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 374790,
      "end_ms": 375630,
      "text": "烧完之后，",
      "token_start": 1247,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 375890,
      "end_ms": 378255,
      "text": "铜丝和珐琅融为一体，",
      "token_start": 1251,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 379010,
      "end_ms": 380230,
      "text": "摸上去平整，",
      "token_start": 1260,
      "token_end_exclusive": 1265
    },
    {
      "start_ms": 380290,
      "end_ms": 380985,
      "text": "顺滑，",
      "token_start": 1265,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 381550,
      "end_ms": 382290,
      "text": "可细看，",
      "token_start": 1267,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 382350,
      "end_ms": 385485,
      "text": "每一根铜丝纹路都清清楚楚。",
      "token_start": 1270,
      "token_end_exclusive": 1282
    },
    {
      "start_ms": 386060,
      "end_ms": 388680,
      "text": "这种工艺后人仿了几百年，",
      "token_start": 1282,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 389060,
      "end_ms": 390215,
      "text": "总是差一口气。",
      "token_start": 1293,
      "token_end_exclusive": 1299
    },
    {
      "start_ms": 391220,
      "end_ms": 391845,
      "text": "第六名，",
      "token_start": 1299,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 392160,
      "end_ms": 393325,
      "text": "雅婿芳尊，",
      "token_start": 1302,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 394020,
      "end_ms": 396820,
      "text": "这是一件商代晚期的青铜器，",
      "token_start": 1306,
      "token_end_exclusive": 1318
    },
    {
      "start_ms": 396940,
      "end_ms": 398565,
      "text": "三千多年前的东西。",
      "token_start": 1318,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 398910,
      "end_ms": 400265,
      "text": "高四十五厘米，",
      "token_start": 1326,
      "token_end_exclusive": 1332
    },
    {
      "start_ms": 400480,
      "end_ms": 401555,
      "text": "重二十一公斤。",
      "token_start": 1332,
      "token_end_exclusive": 1338
    },
    {
      "start_ms": 402450,
      "end_ms": 405875,
      "text": "您知道商代人是怎么铸造青铜器的吗？",
      "token_start": 1338,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 406700,
      "end_ms": 408035,
      "text": "用的是分柱法。",
      "token_start": 1354,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 409160,
      "end_ms": 410205,
      "text": "什么叫分柱？",
      "token_start": 1360,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 410740,
      "end_ms": 413515,
      "text": "就是先单独筑好各个零件，",
      "token_start": 1365,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 413870,
      "end_ms": 415485,
      "text": "再把零件拼装在一起。",
      "token_start": 1376,
      "token_end_exclusive": 1385
    },
    {
      "start_ms": 416330,
      "end_ms": 419770,
      "text": "这件方尊的肩上四角各有一个相，",
      "token_start": 1385,
      "token_end_exclusive": 1399
    },
    {
      "start_ms": 419770,
      "end_ms": 423205,
      "text": "手相手和弃身是分开铸造，",
      "token_start": 1399,
      "token_end_exclusive": 1410
    },
    {
      "start_ms": 424030,
      "end_ms": 424870,
      "text": "筑好之后，",
      "token_start": 1410,
      "token_end_exclusive": 1414
    },
    {
      "start_ms": 425090,
      "end_ms": 427525,
      "text": "用榫卯结构套接上去，",
      "token_start": 1414,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 428010,
      "end_ms": 430445,
      "text": "能拆下来也能装回去。",
      "token_start": 1423,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 430960,
      "end_ms": 436120,
      "text": "三千多年前的工匠已经掌握了分段铸造榫卯拼接的技术。",
      "token_start": 1432,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 436200,
      "end_ms": 439415,
      "text": "您想想一个相手单独筑好，",
      "token_start": 1456,
      "token_end_exclusive": 1467
    },
    {
      "start_ms": 439760,
      "end_ms": 442535,
      "text": "再套到气身上严丝合缝，",
      "token_start": 1467,
      "token_end_exclusive": 1477
    },
    {
      "start_ms": 443030,
      "end_ms": 444565,
      "text": "拆下来还能装回去，",
      "token_start": 1477,
      "token_end_exclusive": 1485
    },
    {
      "start_ms": 445370,
      "end_ms": 446945,
      "text": "这不是简单浇筑。",
      "token_start": 1485,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 447400,
      "end_ms": 450420,
      "text": "这是古代的精密制造商代工匠，",
      "token_start": 1492,
      "token_end_exclusive": 1505
    },
    {
      "start_ms": 450480,
      "end_ms": 451460,
      "text": "没有精密机床，",
      "token_start": 1505,
      "token_end_exclusive": 1511
    },
    {
      "start_ms": 451520,
      "end_ms": 452575,
      "text": "没有现代工具，",
      "token_start": 1511,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 452950,
      "end_ms": 454435,
      "text": "全凭经验和手感。",
      "token_start": 1517,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 455370,
      "end_ms": 457730,
      "text": "这件方尊历经三千多年，",
      "token_start": 1524,
      "token_end_exclusive": 1534
    },
    {
      "start_ms": 457970,
      "end_ms": 459395,
      "text": "棱角依旧分明，",
      "token_start": 1534,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 459680,
      "end_ms": 460975,
      "text": "纹饰清晰完整，",
      "token_start": 1540,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 461750,
      "end_ms": 462730,
      "text": "后人想复刻，",
      "token_start": 1546,
      "token_end_exclusive": 1551
    },
    {
      "start_ms": 462730,
      "end_ms": 463195,
      "text": "很难。",
      "token_start": 1551,
      "token_end_exclusive": 1553
    },
    {
      "start_ms": 463650,
      "end_ms": 465285,
      "text": "当年那种无线代工具，",
      "token_start": 1553,
      "token_end_exclusive": 1562
    },
    {
      "start_ms": 465650,
      "end_ms": 467370,
      "text": "纯靠双手拿捏的极致，",
      "token_start": 1562,
      "token_end_exclusive": 1571
    },
    {
      "start_ms": 467370,
      "end_ms": 469390,
      "text": "手工水准很难再现。",
      "token_start": 1571,
      "token_end_exclusive": 1579
    },
    {
      "start_ms": 469530,
      "end_ms": 471175,
      "text": "从第十到第六名，",
      "token_start": 1579,
      "token_end_exclusive": 1586
    },
    {
      "start_ms": 471560,
      "end_ms": 473585,
      "text": "这五件东西都够绝。",
      "token_start": 1586,
      "token_end_exclusive": 1594
    },
    {
      "start_ms": 474080,
      "end_ms": 477065,
      "text": "章程的雕漆刷了上百层漆，",
      "token_start": 1594,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 477550,
      "end_ms": 478915,
      "text": "一刀一刀剃出来。",
      "token_start": 1605,
      "token_end_exclusive": 1612
    },
    {
      "start_ms": 479750,
      "end_ms": 483965,
      "text": "沈子藩的燕丝一根尾线只织一个颜色，",
      "token_start": 1612,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 484400,
      "end_ms": 486025,
      "text": "剪断几万根丝线。",
      "token_start": 1628,
      "token_end_exclusive": 1635
    },
    {
      "start_ms": 486450,
      "end_ms": 490935,
      "text": "宋代青玉云龙文奴掌心大小磨上好几个月，",
      "token_start": 1635,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 491740,
      "end_ms": 493485,
      "text": "元代掐死珐琅弩，",
      "token_start": 1653,
      "token_end_exclusive": 1660
    },
    {
      "start_ms": 493830,
      "end_ms": 501995,
      "text": "同丝细如发丝商代亚序方尊三千年前就实现了分铸榫卯工艺。",
      "token_start": 1660,
      "token_end_exclusive": 1686
    },
    {
      "start_ms": 502420,
      "end_ms": 503935,
      "text": "可他们还不是最绝的。",
      "token_start": 1686,
      "token_end_exclusive": 1695
    },
    {
      "start_ms": 504440,
      "end_ms": 505835,
      "text": "接下来第五到第一名，",
      "token_start": 1695,
      "token_end_exclusive": 1704
    },
    {
      "start_ms": 506370,
      "end_ms": 507490,
      "text": "水准还要震撼。",
      "token_start": 1704,
      "token_end_exclusive": 1710
    },
    {
      "start_ms": 507610,
      "end_ms": 508675,
      "text": "有一件东西，",
      "token_start": 1710,
      "token_end_exclusive": 1715
    },
    {
      "start_ms": 508970,
      "end_ms": 512105,
      "text": "工匠花五年时间造出一座能动的钟。",
      "token_start": 1715,
      "token_end_exclusive": 1730
    },
    {
      "start_ms": 512680,
      "end_ms": 514430,
      "text": "有一件几千个人，",
      "token_start": 1730,
      "token_end_exclusive": 1737
    },
    {
      "start_ms": 514430,
      "end_ms": 515375,
      "text": "耗时十年，",
      "token_start": 1737,
      "token_end_exclusive": 1741
    },
    {
      "start_ms": 515930,
      "end_ms": 518095,
      "text": "打磨出一座巨型玉山。",
      "token_start": 1741,
      "token_end_exclusive": 1750
    },
    {
      "start_ms": 518670,
      "end_ms": 522085,
      "text": "有一件乾隆亲自敲定图样，",
      "token_start": 1750,
      "token_end_exclusive": 1761
    },
    {
      "start_ms": 522470,
      "end_ms": 524155,
      "text": "全城督造的酒杯。",
      "token_start": 1761,
      "token_end_exclusive": 1768
    },
    {
      "start_ms": 524810,
      "end_ms": 527800,
      "text": "有一件窑工烧石窑，",
      "token_start": 1768,
      "token_end_exclusive": 1776
    },
    {
      "start_ms": 528040,
      "end_ms": 528880,
      "text": "能成一窑，",
      "token_start": 1776,
      "token_end_exclusive": 1780
    },
    {
      "start_ms": 528880,
      "end_ms": 529975,
      "text": "就算撞大运。",
      "token_start": 1780,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 530740,
      "end_ms": 532690,
      "text": "还有一件画家，",
      "token_start": 1785,
      "token_end_exclusive": 1791
    },
    {
      "start_ms": 532690,
      "end_ms": 535090,
      "text": "一笔一画一墨一色，",
      "token_start": 1791,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 535370,
      "end_ms": 535850,
      "text": "耗尽，",
      "token_start": 1799,
      "token_end_exclusive": 1801
    },
    {
      "start_ms": 535970,
      "end_ms": 538075,
      "text": "心血汇成的千古名画。",
      "token_start": 1801,
      "token_end_exclusive": 1810
    },
    {
      "start_ms": 538590,
      "end_ms": 540195,
      "text": "这几件到底是什么？",
      "token_start": 1810,
      "token_end_exclusive": 1818
    },
    {
      "start_ms": 540550,
      "end_ms": 541875,
      "text": "到底有多震撼？",
      "token_start": 1818,
      "token_end_exclusive": 1824
    },
    {
      "start_ms": 542520,
      "end_ms": 544720,
      "text": "下一集已经同步更新，",
      "token_start": 1824,
      "token_end_exclusive": 1833
    },
    {
      "start_ms": 545040,
      "end_ms": 546620,
      "text": "直接点开我的头像，",
      "token_start": 1833,
      "token_end_exclusive": 1841
    },
    {
      "start_ms": 546800,
      "end_ms": 547520,
      "text": "进入主页，",
      "token_start": 1841,
      "token_end_exclusive": 1845
    },
    {
      "start_ms": 547520,
      "end_ms": 550195,
      "text": "第一条视频就是下一集点个关注，",
      "token_start": 1845,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 550550,
      "end_ms": 553970,
      "text": "咱们好好看看中国工匠到底造出了什么。",
      "token_start": 1859,
      "token_end_exclusive": 1876
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
