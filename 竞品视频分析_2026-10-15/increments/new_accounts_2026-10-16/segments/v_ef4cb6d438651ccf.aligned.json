{
  "video_id": "v_ef4cb6d438651ccf",
  "duration_s": 480.468005,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_ef4cb6d438651ccf.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_ef4cb6d438651ccf.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 2730,
      "text": "您知道故宫里皇帝每天用的是什么吗？",
      "token_start": 0,
      "token_end_exclusive": 16
    },
    {
      "start_ms": 2950,
      "end_ms": 5490,
      "text": "有人说是今晚金光闪闪，",
      "token_start": 16,
      "token_end_exclusive": 26
    },
    {
      "start_ms": 5670,
      "end_ms": 6630,
      "text": "吃饭用的。",
      "token_start": 26,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 6930,
      "end_ms": 8050,
      "text": "有人说是龙椅，",
      "token_start": 30,
      "token_end_exclusive": 36
    },
    {
      "start_ms": 8410,
      "end_ms": 9230,
      "text": "九条金，",
      "token_start": 36,
      "token_end_exclusive": 39
    },
    {
      "start_ms": 9250,
      "end_ms": 14770,
      "text": "龙盘着坐上去享威风错了皇帝吃饭不用，",
      "token_start": 39,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 14810,
      "end_ms": 17570,
      "text": "今晚今晚倒热快烫嘴。",
      "token_start": 56,
      "token_end_exclusive": 65
    },
    {
      "start_ms": 18010,
      "end_ms": 20690,
      "text": "真正用的是成化斗彩鸡缸杯。",
      "token_start": 65,
      "token_end_exclusive": 77
    },
    {
      "start_ms": 21050,
      "end_ms": 23490,
      "text": "二零一四年拍卖拍出二点八亿，",
      "token_start": 77,
      "token_end_exclusive": 90
    },
    {
      "start_ms": 24050,
      "end_ms": 25950,
      "text": "皇帝也不天天坐龙椅，",
      "token_start": 90,
      "token_end_exclusive": 99
    },
    {
      "start_ms": 26330,
      "end_ms": 27990,
      "text": "龙椅是上朝用的。",
      "token_start": 99,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 28730,
      "end_ms": 31780,
      "text": "真正每天离不开开的是乾隆的夺宝阁，",
      "token_start": 106,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 32720,
      "end_ms": 35020,
      "text": "藏了一百零八件小玩意儿，",
      "token_start": 122,
      "token_end_exclusive": 133
    },
    {
      "start_ms": 35800,
      "end_ms": 36820,
      "text": "每天摆弄。",
      "token_start": 133,
      "token_end_exclusive": 137
    },
    {
      "start_ms": 36980,
      "end_ms": 41060,
      "text": "今天咱们就来盘点故宫里十件皇帝每天都用，",
      "token_start": 137,
      "token_end_exclusive": 156
    },
    {
      "start_ms": 41460,
      "end_ms": 44040,
      "text": "但您从没注意过的日常器物，",
      "token_start": 156,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 44760,
      "end_ms": 47700,
      "text": "每一件都藏着皇帝的真性情。",
      "token_start": 168,
      "token_end_exclusive": 180
    },
    {
      "start_ms": 48420,
      "end_ms": 52600,
      "text": "每一件比今晚隆椅更能看出皇帝是个什么人。",
      "token_start": 180,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 53020,
      "end_ms": 53800,
      "text": "第十名，",
      "token_start": 199,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 55040,
      "end_ms": 56800,
      "text": "盛化斗彩鸡缸杯，",
      "token_start": 202,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 57620,
      "end_ms": 58960,
      "text": "这是一只小酒杯，",
      "token_start": 209,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 59560,
      "end_ms": 61035,
      "text": "高不到八厘米，",
      "token_start": 216,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 61750,
      "end_ms": 63245,
      "text": "口径八厘米多。",
      "token_start": 222,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 64070,
      "end_ms": 70330,
      "text": "您一只手就能握住明朝成化年间烧的杯，",
      "token_start": 228,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 70330,
      "end_ms": 72675,
      "text": "身上画着公鸡母鸡带小鸡，",
      "token_start": 245,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 73200,
      "end_ms": 76940,
      "text": "六只小鸡跟在鸡妈妈后面画的活灵活现。",
      "token_start": 256,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 77120,
      "end_ms": 79105,
      "text": "您知道这只杯子有多绝吗？",
      "token_start": 273,
      "token_end_exclusive": 284
    },
    {
      "start_ms": 80110,
      "end_ms": 85265,
      "text": "斗彩工艺先用青花勾线烧一遍，",
      "token_start": 284,
      "token_end_exclusive": 297
    },
    {
      "start_ms": 86020,
      "end_ms": 89095,
      "text": "在田采釉又烧一遍，",
      "token_start": 297,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 89500,
      "end_ms": 92645,
      "text": "两次烧制温度差一点，",
      "token_start": 305,
      "token_end_exclusive": 314
    },
    {
      "start_ms": 94240,
      "end_ms": 95325,
      "text": "颜色就不对，",
      "token_start": 314,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 95760,
      "end_ms": 96980,
      "text": "石窑能成一窑，",
      "token_start": 319,
      "token_end_exclusive": 325
    },
    {
      "start_ms": 96980,
      "end_ms": 97975,
      "text": "就算撞大运。",
      "token_start": 325,
      "token_end_exclusive": 330
    },
    {
      "start_ms": 98540,
      "end_ms": 100120,
      "text": "成化皇帝喜欢喝酒，",
      "token_start": 330,
      "token_end_exclusive": 338
    },
    {
      "start_ms": 100460,
      "end_ms": 102505,
      "text": "每次喝酒就用这只杯子，",
      "token_start": 338,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 102760,
      "end_ms": 104710,
      "text": "杯子小一口一杯，",
      "token_start": 348,
      "token_end_exclusive": 355
    },
    {
      "start_ms": 105050,
      "end_ms": 106645,
      "text": "喝的慢不容易醉。",
      "token_start": 355,
      "token_end_exclusive": 362
    },
    {
      "start_ms": 107530,
      "end_ms": 109535,
      "text": "传说成化皇帝有一次喝多了，",
      "token_start": 362,
      "token_end_exclusive": 374
    },
    {
      "start_ms": 109950,
      "end_ms": 111645,
      "text": "摔碎了一只鸡缸杯，",
      "token_start": 374,
      "token_end_exclusive": 382
    },
    {
      "start_ms": 112320,
      "end_ms": 113645,
      "text": "第二天酒醒了，",
      "token_start": 382,
      "token_end_exclusive": 388
    },
    {
      "start_ms": 114270,
      "end_ms": 115250,
      "text": "心疼的不行，",
      "token_start": 388,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 115550,
      "end_ms": 116855,
      "text": "让人重烧，",
      "token_start": 393,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 117550,
      "end_ms": 119590,
      "text": "可怎么都烧不出那个味儿了。",
      "token_start": 397,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 119590,
      "end_ms": 120575,
      "text": "二零一四年，",
      "token_start": 409,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 120990,
      "end_ms": 123965,
      "text": "一只鸡缸杯在香港苏富比拍卖，",
      "token_start": 414,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 124630,
      "end_ms": 126805,
      "text": "拍出二点八亿港币。",
      "token_start": 427,
      "token_end_exclusive": 435
    },
    {
      "start_ms": 127550,
      "end_ms": 131765,
      "text": "一只巴掌大的酒杯能买北京三环的一套房，",
      "token_start": 435,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 132520,
      "end_ms": 134685,
      "text": "您说这是杯子还是传家宝？",
      "token_start": 453,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 135280,
      "end_ms": 135895,
      "text": "聊到这儿，",
      "token_start": 464,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 136850,
      "end_ms": 138675,
      "text": "先在评论区打出四个字，",
      "token_start": 468,
      "token_end_exclusive": 478
    },
    {
      "start_ms": 139210,
      "end_ms": 142585,
      "text": "皇家日常打完我接着往下讲。",
      "token_start": 478,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 143600,
      "end_ms": 147975,
      "text": "这时件里头有一件皇帝天天戴在身上，",
      "token_start": 490,
      "token_end_exclusive": 506
    },
    {
      "start_ms": 149080,
      "end_ms": 150225,
      "text": "丢了就睡不着觉。",
      "token_start": 506,
      "token_end_exclusive": 513
    },
    {
      "start_ms": 150640,
      "end_ms": 151455,
      "text": "第九名，",
      "token_start": 513,
      "token_end_exclusive": 516
    },
    {
      "start_ms": 151850,
      "end_ms": 153655,
      "text": "雍正的奏折猪皮，",
      "token_start": 516,
      "token_end_exclusive": 523
    },
    {
      "start_ms": 154610,
      "end_ms": 157045,
      "text": "您知道雍正皇帝每天干什么吗？",
      "token_start": 523,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 158330,
      "end_ms": 162575,
      "text": "批奏者早上起来披到晚上一天能批几十份，",
      "token_start": 536,
      "token_end_exclusive": 554
    },
    {
      "start_ms": 163240,
      "end_ms": 164485,
      "text": "一年批几千份，",
      "token_start": 554,
      "token_end_exclusive": 560
    },
    {
      "start_ms": 165380,
      "end_ms": 166355,
      "text": "批了十几年。",
      "token_start": 560,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 167310,
      "end_ms": 169115,
      "text": "雍正的猪皮特别有意思，",
      "token_start": 565,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 169960,
      "end_ms": 171805,
      "text": "不像康熙那么正经八百，",
      "token_start": 575,
      "token_end_exclusive": 585
    },
    {
      "start_ms": 172650,
      "end_ms": 174155,
      "text": "他p的跟聊天一样，",
      "token_start": 585,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 174610,
      "end_ms": 175825,
      "text": "大臣说臣病了，",
      "token_start": 593,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 176560,
      "end_ms": 178515,
      "text": "雍正批你要保重身体啊。",
      "token_start": 599,
      "token_end_exclusive": 609
    },
    {
      "start_ms": 179330,
      "end_ms": 181025,
      "text": "大臣说今年收成不好。",
      "token_start": 609,
      "token_end_exclusive": 618
    },
    {
      "start_ms": 181650,
      "end_ms": 183095,
      "text": "雍正批朕知道了，",
      "token_start": 618,
      "token_end_exclusive": 625
    },
    {
      "start_ms": 183800,
      "end_ms": 185665,
      "text": "已经派人去赈灾了。",
      "token_start": 625,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 186710,
      "end_ms": 188730,
      "text": "最有名的一句是朕就是这样。",
      "token_start": 633,
      "token_end_exclusive": 645
    },
    {
      "start_ms": 188730,
      "end_ms": 190810,
      "text": "汉字大臣说他脾气大，",
      "token_start": 645,
      "token_end_exclusive": 654
    },
    {
      "start_ms": 190910,
      "end_ms": 191835,
      "text": "他也不生气，",
      "token_start": 654,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 192390,
      "end_ms": 193150,
      "text": "直接批。",
      "token_start": 659,
      "token_end_exclusive": 662
    },
    {
      "start_ms": 193150,
      "end_ms": 193790,
      "text": "正就是这样。",
      "token_start": 662,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 193790,
      "end_ms": 195395,
      "text": "汉字就是这样秉性，",
      "token_start": 667,
      "token_end_exclusive": 675
    },
    {
      "start_ms": 195800,
      "end_ms": 199415,
      "text": "就是这样皇帝雍正一辈子批了几万份奏折。",
      "token_start": 675,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 199830,
      "end_ms": 201115,
      "text": "每一份都是亲笔，",
      "token_start": 693,
      "token_end_exclusive": 700
    },
    {
      "start_ms": 201730,
      "end_ms": 206195,
      "text": "从来不让太监代兵传说雍正睡觉都放心不下，",
      "token_start": 700,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 206690,
      "end_ms": 207470,
      "text": "半夜醒了，",
      "token_start": 719,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 207470,
      "end_ms": 208290,
      "text": "还要爬起来，",
      "token_start": 723,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 208290,
      "end_ms": 209835,
      "text": "披几份才能睡。",
      "token_start": 728,
      "token_end_exclusive": 734
    },
    {
      "start_ms": 210760,
      "end_ms": 215790,
      "text": "一个皇帝把批奏折当成每天必须干的活儿。",
      "token_start": 734,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 216710,
      "end_ms": 219095,
      "text": "您说这是行政还是工作狂？",
      "token_start": 752,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 220740,
      "end_ms": 221515,
      "text": "第八名，",
      "token_start": 763,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 222860,
      "end_ms": 224065,
      "text": "康熙的眼镜，",
      "token_start": 766,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 224600,
      "end_ms": 226575,
      "text": "您知道康熙皇帝戴眼镜吗？",
      "token_start": 771,
      "token_end_exclusive": 782
    },
    {
      "start_ms": 226970,
      "end_ms": 231515,
      "text": "康熙晚年眼睛花了看不清奏折上的小字，",
      "token_start": 782,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 232230,
      "end_ms": 234790,
      "text": "传教士进贡了一副西洋眼镜。",
      "token_start": 799,
      "token_end_exclusive": 811
    },
    {
      "start_ms": 234830,
      "end_ms": 235970,
      "text": "康熙戴上一试，",
      "token_start": 811,
      "token_end_exclusive": 817
    },
    {
      "start_ms": 236210,
      "end_ms": 237165,
      "text": "能看清了，",
      "token_start": 817,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 237510,
      "end_ms": 238385,
      "text": "高兴的不得了。",
      "token_start": 821,
      "token_end_exclusive": 827
    },
    {
      "start_ms": 239120,
      "end_ms": 241520,
      "text": "这副眼镜是玻璃镜片配铜框，",
      "token_start": 827,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 241740,
      "end_ms": 243175,
      "text": "两个镜腿能折叠，",
      "token_start": 839,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 243630,
      "end_ms": 245475,
      "text": "跟现在的眼镜差不多。",
      "token_start": 846,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 246140,
      "end_ms": 249100,
      "text": "康熙每天批奏折都带着他不戴，",
      "token_start": 855,
      "token_end_exclusive": 868
    },
    {
      "start_ms": 249240,
      "end_ms": 252030,
      "text": "就看不清传说。",
      "token_start": 868,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 252050,
      "end_ms": 254755,
      "text": "康熙有一次把眼镜落在御花园了，",
      "token_start": 874,
      "token_end_exclusive": 888
    },
    {
      "start_ms": 255550,
      "end_ms": 257375,
      "text": "太监找了半天才找到。",
      "token_start": 888,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 258070,
      "end_ms": 258855,
      "text": "康熙说，",
      "token_start": 897,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 259730,
      "end_ms": 261645,
      "text": "这玩意儿比玉玺都重要，",
      "token_start": 900,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 262940,
      "end_ms": 263840,
      "text": "玉玺丢了，",
      "token_start": 910,
      "token_end_exclusive": 914
    },
    {
      "start_ms": 263840,
      "end_ms": 264935,
      "text": "朕还是皇帝，",
      "token_start": 914,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 265310,
      "end_ms": 266190,
      "text": "眼镜丢了，",
      "token_start": 919,
      "token_end_exclusive": 923
    },
    {
      "start_ms": 266190,
      "end_ms": 267195,
      "text": "朕就是瞎子，",
      "token_start": 923,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 267540,
      "end_ms": 268520,
      "text": "一副眼镜，",
      "token_start": 928,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 268780,
      "end_ms": 271335,
      "text": "让皇帝批了十几年奏折，",
      "token_start": 932,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 271880,
      "end_ms": 274080,
      "text": "您说这是眼镜还是办公工具？",
      "token_start": 942,
      "token_end_exclusive": 954
    },
    {
      "start_ms": 274120,
      "end_ms": 276255,
      "text": "第七名无佛，",
      "token_start": 954,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 276580,
      "end_ms": 278005,
      "text": "乾隆的夺宝阁，",
      "token_start": 959,
      "token_end_exclusive": 965
    },
    {
      "start_ms": 278990,
      "end_ms": 281395,
      "text": "这是一个小柜子十几层，",
      "token_start": 965,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 281860,
      "end_ms": 283635,
      "text": "每一层都有小格子，",
      "token_start": 975,
      "token_end_exclusive": 983
    },
    {
      "start_ms": 284130,
      "end_ms": 286515,
      "text": "每个格子里放一件小玩意儿，",
      "token_start": 983,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 287440,
      "end_ms": 295425,
      "text": "玉的、瓷的、铜的一共一百零八件。",
      "token_start": 995,
      "token_end_exclusive": 1008
    },
    {
      "start_ms": 296360,
      "end_ms": 299295,
      "text": "乾隆每天吃完饭就拿出来摆弄。",
      "token_start": 1008,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 300150,
      "end_ms": 301730,
      "text": "今天看看这个玉佩，",
      "token_start": 1021,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 302090,
      "end_ms": 304010,
      "text": "明天摸摸那个小瓷瓶，",
      "token_start": 1029,
      "token_end_exclusive": 1038
    },
    {
      "start_ms": 304410,
      "end_ms": 306050,
      "text": "一摆弄就是大半天。",
      "token_start": 1038,
      "token_end_exclusive": 1046
    },
    {
      "start_ms": 307450,
      "end_ms": 310050,
      "text": "乾隆喜欢收藏一辈子，",
      "token_start": 1046,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 310050,
      "end_ms": 311430,
      "text": "收了几万件文物，",
      "token_start": 1055,
      "token_end_exclusive": 1062
    },
    {
      "start_ms": 311770,
      "end_ms": 315870,
      "text": "可他最宝贝的就是这一百零八件放在多宝阁里，",
      "token_start": 1062,
      "token_end_exclusive": 1082
    },
    {
      "start_ms": 316230,
      "end_ms": 317550,
      "text": "走到哪儿带到哪。",
      "token_start": 1082,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 317650,
      "end_ms": 321710,
      "text": "传说乾隆去世前把多宝阁传给了嘉庆，",
      "token_start": 1089,
      "token_end_exclusive": 1105
    },
    {
      "start_ms": 322270,
      "end_ms": 323630,
      "text": "嘉庆打开一看，",
      "token_start": 1105,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 324130,
      "end_ms": 327590,
      "text": "每一件上面都有乾隆亲笔题的诗，",
      "token_start": 1111,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 327990,
      "end_ms": 329625,
      "text": "一共一百零八首诗，",
      "token_start": 1125,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 330160,
      "end_ms": 333780,
      "text": "写满了他这一辈子的喜怒哀乐，",
      "token_start": 1133,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 334400,
      "end_ms": 337440,
      "text": "一个柜子藏着一个皇帝的一生。",
      "token_start": 1146,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 338140,
      "end_ms": 340300,
      "text": "您说这是收藏还是日记？",
      "token_start": 1159,
      "token_end_exclusive": 1169
    },
    {
      "start_ms": 341120,
      "end_ms": 341800,
      "text": "第六名，",
      "token_start": 1169,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 342700,
      "end_ms": 347000,
      "text": "慈禧的指甲套慈禧太后有个癖好，",
      "token_start": 1172,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 347760,
      "end_ms": 351980,
      "text": "刘长指甲最长的能有十几厘米，",
      "token_start": 1186,
      "token_end_exclusive": 1199
    },
    {
      "start_ms": 352400,
      "end_ms": 353880,
      "text": "指甲长了容易套，",
      "token_start": 1199,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 354500,
      "end_ms": 358680,
      "text": "她就让人做了十个指甲套纯金打的，",
      "token_start": 1206,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 358720,
      "end_ms": 360635,
      "text": "上面镶着珍珠珠宝石。",
      "token_start": 1221,
      "token_end_exclusive": 1230
    },
    {
      "start_ms": 361410,
      "end_ms": 362490,
      "text": "每天早上起来，",
      "token_start": 1230,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 362810,
      "end_ms": 364610,
      "text": "太监帮他一个一个套上去，",
      "token_start": 1236,
      "token_end_exclusive": 1247
    },
    {
      "start_ms": 364890,
      "end_ms": 367565,
      "text": "金光闪闪的像十根金手指。",
      "token_start": 1247,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 368080,
      "end_ms": 372685,
      "text": "慈禧带着指甲套吃饭、写字批奏折，",
      "token_start": 1258,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 374070,
      "end_ms": 374995,
      "text": "什么都不耽误。",
      "token_start": 1272,
      "token_end_exclusive": 1278
    },
    {
      "start_ms": 376010,
      "end_ms": 376490,
      "text": "传说。",
      "token_start": 1278,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 376530,
      "end_ms": 380310,
      "text": "慈禧有一次指甲套掉了一个宫里，",
      "token_start": 1280,
      "token_end_exclusive": 1294
    },
    {
      "start_ms": 380350,
      "end_ms": 384640,
      "text": "上上下下找了三天才找到找到的太监，",
      "token_start": 1294,
      "token_end_exclusive": 1310
    },
    {
      "start_ms": 384660,
      "end_ms": 386095,
      "text": "赏了一百两银子，",
      "token_start": 1310,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 386560,
      "end_ms": 390915,
      "text": "一套指甲套比有些人一辈子挣的钱都多。",
      "token_start": 1317,
      "token_end_exclusive": 1334
    },
    {
      "start_ms": 391530,
      "end_ms": 393795,
      "text": "您说这是首饰还是身份？",
      "token_start": 1334,
      "token_end_exclusive": 1344
    },
    {
      "start_ms": 394480,
      "end_ms": 395855,
      "text": "从第十到第六名，",
      "token_start": 1344,
      "token_end_exclusive": 1351
    },
    {
      "start_ms": 396820,
      "end_ms": 402545,
      "text": "这五件东西都够特别成化鸡缸杯一只小酒杯拍出二点八亿。",
      "token_start": 1351,
      "token_end_exclusive": 1376
    },
    {
      "start_ms": 402960,
      "end_ms": 405795,
      "text": "雍正批奏折p的跟聊天一样，",
      "token_start": 1376,
      "token_end_exclusive": 1388
    },
    {
      "start_ms": 406100,
      "end_ms": 407305,
      "text": "一年批几千份。",
      "token_start": 1388,
      "token_end_exclusive": 1394
    },
    {
      "start_ms": 408060,
      "end_ms": 410365,
      "text": "康熙戴眼镜待了十几年，",
      "token_start": 1394,
      "token_end_exclusive": 1404
    },
    {
      "start_ms": 410610,
      "end_ms": 412115,
      "text": "丢了比丢玉玺还急。",
      "token_start": 1404,
      "token_end_exclusive": 1412
    },
    {
      "start_ms": 412630,
      "end_ms": 416745,
      "text": "乾隆的多宝阁藏了一百零八件小玩意儿，",
      "token_start": 1412,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 417510,
      "end_ms": 419485,
      "text": "每一件都提了诗，",
      "token_start": 1429,
      "token_end_exclusive": 1436
    },
    {
      "start_ms": 420250,
      "end_ms": 426155,
      "text": "慈禧的指甲套纯金镶珠吊一个赏一百两银子，",
      "token_start": 1436,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 426940,
      "end_ms": 428765,
      "text": "可他们还不是最特别的。",
      "token_start": 1455,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 429230,
      "end_ms": 434605,
      "text": "接下来第五道第一名更能看出皇帝的真性情。",
      "token_start": 1465,
      "token_end_exclusive": 1484
    },
    {
      "start_ms": 435630,
      "end_ms": 436745,
      "text": "有一件东西，",
      "token_start": 1484,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 437020,
      "end_ms": 440185,
      "text": "皇帝每天带在身上丢了就睡不着觉。",
      "token_start": 1489,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 441070,
      "end_ms": 442920,
      "text": "有一件康熙一支笔，",
      "token_start": 1504,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 442920,
      "end_ms": 443895,
      "text": "用了几十年，",
      "token_start": 1512,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 444650,
      "end_ms": 446285,
      "text": "笔杆都磨出包浆了。",
      "token_start": 1517,
      "token_end_exclusive": 1525
    },
    {
      "start_ms": 447040,
      "end_ms": 449300,
      "text": "有一件皇帝，",
      "token_start": 1525,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 449300,
      "end_ms": 451000,
      "text": "每天睡觉前都要闻一闻，",
      "token_start": 1530,
      "token_end_exclusive": 1540
    },
    {
      "start_ms": 451000,
      "end_ms": 451775,
      "text": "才能入睡。",
      "token_start": 1540,
      "token_end_exclusive": 1544
    },
    {
      "start_ms": 452250,
      "end_ms": 453660,
      "text": "有一件乾隆，",
      "token_start": 1544,
      "token_end_exclusive": 1549
    },
    {
      "start_ms": 453680,
      "end_ms": 456175,
      "text": "每天吃饭前都要看一眼才动筷子。",
      "token_start": 1549,
      "token_end_exclusive": 1563
    },
    {
      "start_ms": 456560,
      "end_ms": 460020,
      "text": "还有一件皇帝临死前抱着不撒手，",
      "token_start": 1563,
      "token_end_exclusive": 1577
    },
    {
      "start_ms": 460460,
      "end_ms": 461555,
      "text": "带进了棺材。",
      "token_start": 1577,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 461930,
      "end_ms": 463405,
      "text": "这几件到底是什么？",
      "token_start": 1582,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 463790,
      "end_ms": 464975,
      "text": "到底有多特别？",
      "token_start": 1590,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 465460,
      "end_ms": 467705,
      "text": "下一集已经同步更新，",
      "token_start": 1596,
      "token_end_exclusive": 1605
    },
    {
      "start_ms": 468540,
      "end_ms": 470000,
      "text": "直接点开我的头像，",
      "token_start": 1605,
      "token_end_exclusive": 1613
    },
    {
      "start_ms": 470040,
      "end_ms": 470815,
      "text": "进入主页。",
      "token_start": 1613,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 471720,
      "end_ms": 475710,
      "text": "第一条视频就是下一集点个关注，",
      "token_start": 1617,
      "token_end_exclusive": 1631
    },
    {
      "start_ms": 475730,
      "end_ms": 480385,
      "text": "咱们好好看看皇帝每天用的东西到底藏着什么秘密。",
      "token_start": 1631,
      "token_end_exclusive": 1653
    }
  ],
