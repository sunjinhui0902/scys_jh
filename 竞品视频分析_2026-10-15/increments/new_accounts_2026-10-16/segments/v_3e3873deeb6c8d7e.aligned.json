{
  "video_id": "v_3e3873deeb6c8d7e",
  "duration_s": 317.069002,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_3e3873deeb6c8d7e.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_3e3873deeb6c8d7e.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 4150,
      "text": "你知道中国有哪些地方水美到你怀疑自己的眼睛吗？",
      "token_start": 0,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4890,
      "end_ms": 8270,
      "text": "有人说是九寨沟水蓝的不真实。",
      "token_start": 22,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 8750,
      "end_ms": 10010,
      "text": "有人说是西湖，",
      "token_start": 35,
      "token_end_exclusive": 41
    },
    {
      "start_ms": 10270,
      "end_ms": 12090,
      "text": "淡妆浓抹总相宜，",
      "token_start": 41,
      "token_end_exclusive": 48
    },
    {
      "start_ms": 12410,
      "end_ms": 15890,
      "text": "错真正最绝的那片水不在四川，",
      "token_start": 48,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 15890,
      "end_ms": 16710,
      "text": "也不在浙江。",
      "token_start": 61,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 16710,
      "end_ms": 20230,
      "text": "它在沙漠里一片湖水被沙山包围，",
      "token_start": 66,
      "token_end_exclusive": 80
    },
    {
      "start_ms": 20230,
      "end_ms": 21310,
      "text": "千年不干。",
      "token_start": 80,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 21310,
      "end_ms": 25730,
      "text": "今天咱们就来盘点中国十五大水做的仙境，",
      "token_start": 84,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 25730,
      "end_ms": 29250,
      "text": "每一处都美到让你想立刻收拾行李。",
      "token_start": 102,
      "token_end_exclusive": 117
    },
    {
      "start_ms": 29250,
      "end_ms": 31620,
      "text": "这么觉得有意思的朋友，",
      "token_start": 117,
      "token_end_exclusive": 127
    },
    {
      "start_ms": 31620,
      "end_ms": 32620,
      "text": "可以先收藏，",
      "token_start": 127,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 33200,
      "end_ms": 35620,
      "text": "免得刷着刷着找不到第十五名。",
      "token_start": 132,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 35800,
      "end_ms": 36700,
      "text": "杭州西湖，",
      "token_start": 145,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 37480,
      "end_ms": 39200,
      "text": "你见过雨天的西湖吗？",
      "token_start": 149,
      "token_end_exclusive": 158
    },
    {
      "start_ms": 39760,
      "end_ms": 41120,
      "text": "不是那种毛毛雨，",
      "token_start": 158,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 41260,
      "end_ms": 44700,
      "text": "是那种细细密密斜斜织下来的江南雨。",
      "token_start": 165,
      "token_end_exclusive": 181
    },
    {
      "start_ms": 45440,
      "end_ms": 46740,
      "text": "你站在断桥上，",
      "token_start": 181,
      "token_end_exclusive": 187
    },
    {
      "start_ms": 47080,
      "end_ms": 49560,
      "text": "湖面上浮起一层薄薄的水汽，",
      "token_start": 187,
      "token_end_exclusive": 199
    },
    {
      "start_ms": 50060,
      "end_ms": 52080,
      "text": "远处的孤山薄撇塔，",
      "token_start": 199,
      "token_end_exclusive": 207
    },
    {
      "start_ms": 52320,
      "end_ms": 53920,
      "text": "只剩一个淡淡的轮廓，",
      "token_start": 207,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 54420,
      "end_ms": 56380,
      "text": "像谁用毛笔沾了淡墨，",
      "token_start": 216,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 56820,
      "end_ms": 59020,
      "text": "在宣纸上轻轻扫了一下，",
      "token_start": 225,
      "token_end_exclusive": 235
    },
    {
      "start_ms": 59680,
      "end_ms": 61185,
      "text": "雨点便落在湖面上，",
      "token_start": 235,
      "token_end_exclusive": 243
    },
    {
      "start_ms": 61610,
      "end_ms": 62990,
      "text": "密密麻麻的小圈，",
      "token_start": 243,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 63070,
      "end_ms": 64355,
      "text": "一个接一个的荡开。",
      "token_start": 250,
      "token_end_exclusive": 258
    },
    {
      "start_ms": 64750,
      "end_ms": 66005,
      "text": "你听得见雨声，",
      "token_start": 258,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 66450,
      "end_ms": 67725,
      "text": "但看不见雨丝。",
      "token_start": 264,
      "token_end_exclusive": 270
    },
    {
      "start_ms": 68430,
      "end_ms": 69030,
      "text": "苏轼说，",
      "token_start": 270,
      "token_end_exclusive": 273
    },
    {
      "start_ms": 69050,
      "end_ms": 70610,
      "text": "水光潋滟晴方好，",
      "token_start": 273,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 70710,
      "end_ms": 72265,
      "text": "山色空蒙雨亦奇，",
      "token_start": 280,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 72650,
      "end_ms": 75210,
      "text": "可他没告诉我晴天的西湖，",
      "token_start": 287,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 75210,
      "end_ms": 76335,
      "text": "你看到的是人头，",
      "token_start": 298,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 76830,
      "end_ms": 77730,
      "text": "雨天的西湖，",
      "token_start": 305,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 77730,
      "end_ms": 79155,
      "text": "你看到的才是江南。",
      "token_start": 310,
      "token_end_exclusive": 318
    },
    {
      "start_ms": 80020,
      "end_ms": 81480,
      "text": "你站在雨里伞，",
      "token_start": 318,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 81480,
      "end_ms": 82485,
      "text": "盐上滴着水，",
      "token_start": 324,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 82860,
      "end_ms": 84280,
      "text": "脚底的石板路，",
      "token_start": 329,
      "token_end_exclusive": 335
    },
    {
      "start_ms": 84540,
      "end_ms": 86035,
      "text": "湿漉漉的反着光。",
      "token_start": 335,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 86610,
      "end_ms": 87070,
      "text": "那一刻，",
      "token_start": 342,
      "token_end_exclusive": 345
    },
    {
      "start_ms": 87070,
      "end_ms": 94955,
      "text": "你会觉得西湖等这场雨等了一千年第十四名，",
      "token_start": 345,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 96870,
      "end_ms": 104625,
      "text": "浙江千岛湖千岛湖在浙江崇安湖中有一千零七十八个岛屿。",
      "token_start": 364,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 105240,
      "end_ms": 106560,
      "text": "你坐船出去，",
      "token_start": 389,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 106920,
      "end_ms": 108435,
      "text": "水是碧绿的，",
      "token_start": 394,
      "token_end_exclusive": 399
    },
    {
      "start_ms": 109000,
      "end_ms": 109420,
      "text": "绿的，",
      "token_start": 399,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 109420,
      "end_ms": 111180,
      "text": "像一块温润的玉，",
      "token_start": 401,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 111280,
      "end_ms": 116835,
      "text": "船桨划过去水面像被切开的绸缎一样缓缓合拢。",
      "token_start": 408,
      "token_end_exclusive": 428
    },
    {
      "start_ms": 117630,
      "end_ms": 126220,
      "text": "但千岛湖最让人心里一颤的是水底下一九五九年新安江水库蓄水两座千年，",
      "token_start": 428,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 126220,
      "end_ms": 129005,
      "text": "古城狮城和鹤城沉入了水底。",
      "token_start": 460,
      "token_end_exclusive": 472
    },
    {
      "start_ms": 129640,
      "end_ms": 132410,
      "text": "你在湖面上看到的是一座座岛岛，",
      "token_start": 472,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 132410,
      "end_ms": 136930,
      "text": "下面是完整的明清街道牌坊民居。",
      "token_start": 486,
      "token_end_exclusive": 500
    },
    {
      "start_ms": 137210,
      "end_ms": 139780,
      "text": "水草在屋檐上飘鱼，",
      "token_start": 500,
      "token_end_exclusive": 508
    },
    {
      "start_ms": 139780,
      "end_ms": 142390,
      "text": "在窗棂间游晴天的时候，",
      "token_start": 508,
      "token_end_exclusive": 518
    },
    {
      "start_ms": 142390,
      "end_ms": 144275,
      "text": "湖水能见度超过七米。",
      "token_start": 518,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 144590,
      "end_ms": 145615,
      "text": "你低头看水，",
      "token_start": 527,
      "token_end_exclusive": 532
    },
    {
      "start_ms": 146010,
      "end_ms": 149550,
      "text": "隐隐约约能看见一个沉在水底的旧世界，",
      "token_start": 532,
      "token_end_exclusive": 549
    },
    {
      "start_ms": 149630,
      "end_ms": 150565,
      "text": "第十三名。",
      "token_start": 549,
      "token_end_exclusive": 553
    },
    {
      "start_ms": 150950,
      "end_ms": 152525,
      "text": "湖南洞庭湖，",
      "token_start": 553,
      "token_end_exclusive": 558
    },
    {
      "start_ms": 153040,
      "end_ms": 154260,
      "text": "你站在岳阳楼上，",
      "token_start": 558,
      "token_end_exclusive": 565
    },
    {
      "start_ms": 154480,
      "end_ms": 156255,
      "text": "眼前是八百里洞庭。",
      "token_start": 565,
      "token_end_exclusive": 573
    },
    {
      "start_ms": 156810,
      "end_ms": 157630,
      "text": "秋天的时候，",
      "token_start": 573,
      "token_end_exclusive": 578
    },
    {
      "start_ms": 157630,
      "end_ms": 158635,
      "text": "湖水退去，",
      "token_start": 578,
      "token_end_exclusive": 582
    },
    {
      "start_ms": 159110,
      "end_ms": 161265,
      "text": "露出大片大片的芦苇荡，",
      "token_start": 582,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 161640,
      "end_ms": 162485,
      "text": "如花开了，",
      "token_start": 592,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 162870,
      "end_ms": 163535,
      "text": "风一吹，",
      "token_start": 596,
      "token_end_exclusive": 599
    },
    {
      "start_ms": 164140,
      "end_ms": 166045,
      "text": "白色的花絮漫天飞舞，",
      "token_start": 599,
      "token_end_exclusive": 608
    },
    {
      "start_ms": 166420,
      "end_ms": 168785,
      "text": "像下了一场不会融化的雪。",
      "token_start": 608,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 169530,
      "end_ms": 172455,
      "text": "远处的君山岛在薄雾里若隐若现。",
      "token_start": 619,
      "token_end_exclusive": 633
    },
    {
      "start_ms": 173190,
      "end_ms": 173770,
      "text": "湖面上，",
      "token_start": 633,
      "token_end_exclusive": 636
    },
    {
      "start_ms": 173770,
      "end_ms": 178575,
      "text": "渔船点点船上的灯火在暮色里一盏一盏亮起来。",
      "token_start": 636,
      "token_end_exclusive": 656
    },
    {
      "start_ms": 178890,
      "end_ms": 182605,
      "text": "范仲淹就是在这里写下了先天下之忧而忧，",
      "token_start": 656,
      "token_end_exclusive": 674
    },
    {
      "start_ms": 183240,
      "end_ms": 185020,
      "text": "后天下之乐而乐。",
      "token_start": 674,
      "token_end_exclusive": 681
    },
    {
      "start_ms": 185200,
      "end_ms": 186225,
      "text": "你扶着栏杆，",
      "token_start": 681,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 186590,
      "end_ms": 187795,
      "text": "胡风灌满衣袖，",
      "token_start": 686,
      "token_end_exclusive": 692
    },
    {
      "start_ms": 188230,
      "end_ms": 190885,
      "text": "你会觉得这片水看过太多兴亡，",
      "token_start": 692,
      "token_end_exclusive": 705
    },
    {
      "start_ms": 191150,
      "end_ms": 192065,
      "text": "所以他不说话。",
      "token_start": 705,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 192980,
      "end_ms": 193720,
      "text": "第十二名，",
      "token_start": 711,
      "token_end_exclusive": 715
    },
    {
      "start_ms": 193960,
      "end_ms": 194820,
      "text": "广西桂林，",
      "token_start": 715,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 194820,
      "end_ms": 197005,
      "text": "漓江天还没亮。",
      "token_start": 719,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 197460,
      "end_ms": 198615,
      "text": "你坐在竹筏上，",
      "token_start": 725,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 199060,
      "end_ms": 201495,
      "text": "江面上飘着一层白色的薄雾，",
      "token_start": 731,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 201950,
      "end_ms": 204545,
      "text": "像有人把整条浆泡在了牛奶里，",
      "token_start": 743,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 205030,
      "end_ms": 207775,
      "text": "两岸的喀斯特山峰从雾里探出头来，",
      "token_start": 756,
      "token_end_exclusive": 771
    },
    {
      "start_ms": 208120,
      "end_ms": 209200,
      "text": "一座接一座，",
      "token_start": 771,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 209420,
      "end_ms": 210415,
      "text": "有的像比价，",
      "token_start": 776,
      "token_end_exclusive": 781
    },
    {
      "start_ms": 210840,
      "end_ms": 211845,
      "text": "有的像骆驼，",
      "token_start": 781,
      "token_end_exclusive": 786
    },
    {
      "start_ms": 212110,
      "end_ms": 214030,
      "text": "有的像老人惩罚人。",
      "token_start": 786,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 214030,
      "end_ms": 214945,
      "text": "一杆子下去，",
      "token_start": 794,
      "token_end_exclusive": 799
    },
    {
      "start_ms": 215550,
      "end_ms": 218930,
      "text": "竹竿入水的声音清脆的像敲了一下瓷器。",
      "token_start": 799,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 219110,
      "end_ms": 221095,
      "text": "水面上荡开一圈涟漪，",
      "token_start": 816,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 222000,
      "end_ms": 225215,
      "text": "你把手伸进江里水是凉的，",
      "token_start": 825,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 225480,
      "end_ms": 226185,
      "text": "滑滑的，",
      "token_start": 836,
      "token_end_exclusive": 839
    },
    {
      "start_ms": 226610,
      "end_ms": 229425,
      "text": "像在摸一块被溪水冲了几千年的石头。",
      "token_start": 839,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 230220,
      "end_ms": 232075,
      "text": "漓江的美不是壮阔，",
      "token_start": 855,
      "token_end_exclusive": 863
    },
    {
      "start_ms": 232480,
      "end_ms": 233235,
      "text": "是安静，",
      "token_start": 863,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 233720,
      "end_ms": 235755,
      "text": "安静到你不敢大声说话，",
      "token_start": 866,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 236090,
      "end_ms": 238765,
      "text": "怕吵醒什么第十一名。",
      "token_start": 876,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 239730,
      "end_ms": 241095,
      "text": "云南大理洱海，",
      "token_start": 885,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 241770,
      "end_ms": 244505,
      "text": "你见过洱海的蓝调石刻吗？",
      "token_start": 891,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 245320,
      "end_ms": 247185,
      "text": "天色将暗未暗，",
      "token_start": 902,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 248000,
      "end_ms": 250825,
      "text": "天边还剩一抹淡淡的蓝，",
      "token_start": 908,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 251300,
      "end_ms": 254815,
      "text": "苍山的轮廓变成一道深色的剪影。",
      "token_start": 918,
      "token_end_exclusive": 932
    },
    {
      "start_ms": 255730,
      "end_ms": 258875,
      "text": "湖面上忽然亮起点点渔灯，",
      "token_start": 932,
      "token_end_exclusive": 943
    },
    {
      "start_ms": 259380,
      "end_ms": 262120,
      "text": "暖黄色的光落在水面上，",
      "token_start": 943,
      "token_end_exclusive": 953
    },
    {
      "start_ms": 262160,
      "end_ms": 264295,
      "text": "拉出一道一道细长的光柱。",
      "token_start": 953,
      "token_end_exclusive": 964
    },
    {
      "start_ms": 264780,
      "end_ms": 266845,
      "text": "随着水波轻轻摇晃，",
      "token_start": 964,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 267360,
      "end_ms": 273635,
      "text": "蓝的天光、暖的雨、火暗的山野三种颜色在水面上交织。",
      "token_start": 972,
      "token_end_exclusive": 994
    },
    {
      "start_ms": 274540,
      "end_ms": 275965,
      "text": "你站在洱海边，",
      "token_start": 994,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 276480,
      "end_ms": 278625,
      "text": "风从苍山那边吹过来，",
      "token_start": 1000,
      "token_end_exclusive": 1009
    },
    {
      "start_ms": 279060,
      "end_ms": 281175,
      "text": "带着松脂和湖水的气息，",
      "token_start": 1009,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 281570,
      "end_ms": 283370,
      "text": "你会分不清哪边是天，",
      "token_start": 1019,
      "token_end_exclusive": 1028
    },
    {
      "start_ms": 283510,
      "end_ms": 284370,
      "text": "哪边是水，",
      "token_start": 1028,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 284570,
      "end_ms": 285605,
      "text": "哪边是梦。",
      "token_start": 1032,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 286440,
      "end_ms": 290310,
      "text": "接下来第十到第六名有一个湖，",
      "token_start": 1036,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 290710,
      "end_ms": 293480,
      "text": "每年只每二十天有一个湖，",
      "token_start": 1049,
      "token_end_exclusive": 1060
    },
    {
      "start_ms": 293640,
      "end_ms": 295260,
      "text": "全年只有大约五十天，",
      "token_start": 1060,
      "token_end_exclusive": 1069
    },
    {
      "start_ms": 295260,
      "end_ms": 296235,
      "text": "能看到阵容，",
      "token_start": 1069,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 296920,
      "end_ms": 300480,
      "text": "还有一个湖的湖水会在夏天自己变红。",
      "token_start": 1074,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 300640,
      "end_ms": 304455,
      "text": "这五个里面有一个你走进去手机完全没信号，",
      "token_start": 1090,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 304740,
      "end_ms": 306100,
      "text": "得跟世界断联。",
      "token_start": 1109,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 306100,
      "end_ms": 309395,
      "text": "三、天下一集已经同步更新，",
      "token_start": 1115,
      "token_end_exclusive": 1126
    },
    {
      "start_ms": 309760,
      "end_ms": 311440,
      "text": "现在直接点开我的头像，",
      "token_start": 1126,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 311520,
      "end_ms": 312285,
      "text": "进入主页，",
      "token_start": 1136,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 312680,
      "end_ms": 314555,
      "text": "第一条视频就是下一集，",
      "token_start": 1140,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 315080,
      "end_ms": 316955,
      "text": "感兴趣的朋友可以关注后续。",
      "token_start": 1150,
      "token_end_exclusive": 1162
    }
