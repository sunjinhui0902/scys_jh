{
  "video_id": "v_7c8bdf178c13ccee",
  "duration_s": 314.607007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_7c8bdf178c13ccee.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_7c8bdf178c13ccee.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 270,
      "end_ms": 1190,
      "text": "你敢相信吗？",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1670,
      "end_ms": 3870,
      "text": "钱老晚年做过一件非常奇怪的事情，",
      "token_start": 5,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4290,
      "end_ms": 6330,
      "text": "直到他先逝后才被解密公开。",
      "token_start": 20,
      "token_end_exclusive": 32
    },
    {
      "start_ms": 6550,
      "end_ms": 8670,
      "text": "原来他不仅研究导弹火箭，",
      "token_start": 32,
      "token_end_exclusive": 43
    },
    {
      "start_ms": 8890,
      "end_ms": 12070,
      "text": "还悄悄的干了一件让整个科学界都闭嘴的事儿。",
      "token_start": 43,
      "token_end_exclusive": 63
    },
    {
      "start_ms": 12290,
      "end_ms": 16070,
      "text": "他用现代科学去打碎华夏丹道千年不传的秘密，",
      "token_start": 63,
      "token_end_exclusive": 83
    },
    {
      "start_ms": 16450,
      "end_ms": 18310,
      "text": "而帮他执行这项秘密任务的人，",
      "token_start": 83,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 18330,
      "end_ms": 19250,
      "text": "就叫胡福琛。",
      "token_start": 96,
      "token_end_exclusive": 101
    },
    {
      "start_ms": 19710,
      "end_ms": 22070,
      "text": "一位南开大学化学系毕业的学者。",
      "token_start": 101,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 22610,
      "end_ms": 23490,
      "text": "一九八零年，",
      "token_start": 115,
      "token_end_exclusive": 120
    },
    {
      "start_ms": 23810,
      "end_ms": 26250,
      "text": "胡福琛在中山大学发表了一篇论文。",
      "token_start": 120,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 26690,
      "end_ms": 28710,
      "text": "他用化学方程式和物理逻辑，",
      "token_start": 135,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 28890,
      "end_ms": 32680,
      "text": "把号称天书的周易参铜器拆解的体无完肤。",
      "token_start": 147,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 32920,
      "end_ms": 34840,
      "text": "当时全中国没几个人能看懂。",
      "token_start": 165,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 35100,
      "end_ms": 36460,
      "text": "但钱学森看懂了，",
      "token_start": 177,
      "token_end_exclusive": 184
    },
    {
      "start_ms": 36920,
      "end_ms": 38380,
      "text": "钱老读完拍案叫绝，",
      "token_start": 184,
      "token_end_exclusive": 192
    },
    {
      "start_ms": 38600,
      "end_ms": 40280,
      "text": "当即亲笔写了一封信。",
      "token_start": 192,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 40560,
      "end_ms": 41120,
      "text": "信中说，",
      "token_start": 201,
      "token_end_exclusive": 204
    },
    {
      "start_ms": 41520,
      "end_ms": 43880,
      "text": "你的化学物理加哲学背景，",
      "token_start": 204,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 43980,
      "end_ms": 45320,
      "text": "举国只有你一人，",
      "token_start": 215,
      "token_end_exclusive": 222
    },
    {
      "start_ms": 45340,
      "end_ms": 46380,
      "text": "你必须停下来，",
      "token_start": 222,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 46420,
      "end_ms": 49800,
      "text": "一切由我安排去系统研究单道和内丹学，",
      "token_start": 228,
      "token_end_exclusive": 245
    },
    {
      "start_ms": 50100,
      "end_ms": 51000,
      "text": "这不是迷信。",
      "token_start": 245,
      "token_end_exclusive": 250
    },
    {
      "start_ms": 51220,
      "end_ms": 54040,
      "text": "这是中华民族最珍贵的生命科学遗产。",
      "token_start": 250,
      "token_end_exclusive": 266
    },
    {
      "start_ms": 54220,
      "end_ms": 54760,
      "text": "那一年，",
      "token_start": 266,
      "token_end_exclusive": 269
    },
    {
      "start_ms": 55020,
      "end_ms": 56320,
      "text": "胡福琛三十五岁。",
      "token_start": 269,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 56860,
      "end_ms": 57760,
      "text": "他看完信以后，",
      "token_start": 276,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 57880,
      "end_ms": 59675,
      "text": "将所有研究报告撕了，",
      "token_start": 282,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 60020,
      "end_ms": 62235,
      "text": "连同报告被撕毁的还有他的前途。",
      "token_start": 291,
      "token_end_exclusive": 305
    },
    {
      "start_ms": 62650,
      "end_ms": 63825,
      "text": "他接下了这封密令，",
      "token_start": 305,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 64110,
      "end_ms": 66605,
      "text": "从此开始了一场长达二十六年的潜伏。",
      "token_start": 313,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 67230,
      "end_ms": 68510,
      "text": "他走遍名山大川，",
      "token_start": 329,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 68790,
      "end_ms": 70085,
      "text": "深入康藏秘境，",
      "token_start": 336,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 70390,
      "end_ms": 71550,
      "text": "出入禅秘丛林，",
      "token_start": 342,
      "token_end_exclusive": 348
    },
    {
      "start_ms": 71730,
      "end_ms": 74290,
      "text": "反高道寻觅点验证单绝。",
      "token_start": 348,
      "token_end_exclusive": 358
    },
    {
      "start_ms": 74570,
      "end_ms": 75530,
      "text": "他吃过闭门羹，",
      "token_start": 358,
      "token_end_exclusive": 364
    },
    {
      "start_ms": 75750,
      "end_ms": 77155,
      "text": "被江湖术士威胁过，",
      "token_start": 364,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 77390,
      "end_ms": 78925,
      "text": "被贾丹诗诽谤过，",
      "token_start": 372,
      "token_end_exclusive": 379
    },
    {
      "start_ms": 79160,
      "end_ms": 80215,
      "text": "家人也受牵连。",
      "token_start": 379,
      "token_end_exclusive": 385
    },
    {
      "start_ms": 80600,
      "end_ms": 82295,
      "text": "他钻深山住破庙，",
      "token_start": 385,
      "token_end_exclusive": 392
    },
    {
      "start_ms": 82630,
      "end_ms": 84780,
      "text": "与饮者同吃同住用命。",
      "token_start": 392,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 85000,
      "end_ms": 86260,
      "text": "换一句真口诀，",
      "token_start": 401,
      "token_end_exclusive": 407
    },
    {
      "start_ms": 86500,
      "end_ms": 88040,
      "text": "他校刊千卷到藏，",
      "token_start": 407,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 88160,
      "end_ms": 89515,
      "text": "收集民间残卷，",
      "token_start": 414,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 89880,
      "end_ms": 93280,
      "text": "把断裂千年的单道脉络一根一根接回去，",
      "token_start": 420,
      "token_end_exclusive": 437
    },
    {
      "start_ms": 93420,
      "end_ms": 94460,
      "text": "一边科学拆解，",
      "token_start": 437,
      "token_end_exclusive": 443
    },
    {
      "start_ms": 94500,
      "end_ms": 95715,
      "text": "一边亲身实证，",
      "token_start": 443,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 96050,
      "end_ms": 98390,
      "text": "最终将三家四派全部摸清。",
      "token_start": 449,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 98650,
      "end_ms": 99830,
      "text": "江湖上有人骂他，",
      "token_start": 460,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 99830,
      "end_ms": 100510,
      "text": "一介书生，",
      "token_start": 467,
      "token_end_exclusive": 471
    },
    {
      "start_ms": 100610,
      "end_ms": 101375,
      "text": "断人饭碗，",
      "token_start": 471,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 102010,
      "end_ms": 104680,
      "text": "他一度动摇想放弃钱学森。",
      "token_start": 475,
      "token_end_exclusive": 486
    },
    {
      "start_ms": 104680,
      "end_ms": 104920,
      "text": "再次，",
      "token_start": 486,
      "token_end_exclusive": 488
    },
    {
      "start_ms": 104920,
      "end_ms": 105615,
      "text": "来信说，",
      "token_start": 488,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 106030,
      "end_ms": 107710,
      "text": "我五十岁赶接导弹任务，",
      "token_start": 491,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 107810,
      "end_ms": 108945,
      "text": "生死置之度外，",
      "token_start": 501,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 109170,
      "end_ms": 110330,
      "text": "你现在也五十岁。",
      "token_start": 507,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 110490,
      "end_ms": 111545,
      "text": "该有这份担当，",
      "token_start": 514,
      "token_end_exclusive": 520
    },
    {
      "start_ms": 111850,
      "end_ms": 113505,
      "text": "为民族把真相留下来，",
      "token_start": 520,
      "token_end_exclusive": 529
    },
    {
      "start_ms": 113760,
      "end_ms": 115000,
      "text": "别让后人走弯路。",
      "token_start": 529,
      "token_end_exclusive": 536
    },
    {
      "start_ms": 115160,
      "end_ms": 116055,
      "text": "二零零六年，",
      "token_start": 536,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 116360,
      "end_ms": 119005,
      "text": "胡福琛完成了这项国家文化科考任务。",
      "token_start": 541,
      "token_end_exclusive": 557
    },
    {
      "start_ms": 119470,
      "end_ms": 123195,
      "text": "他第一次把单道从江湖迷信拉进学术殿堂。",
      "token_start": 557,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 123560,
      "end_ms": 127120,
      "text": "第一次把内丹体系完整化、科学化、系统化。",
      "token_start": 575,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 127340,
      "end_ms": 131105,
      "text": "第一次把千年秘传写成普通人能读懂的文字。",
      "token_start": 592,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 131320,
      "end_ms": 137390,
      "text": "他主编的中华道教大词典成为道学界的四库全书单道法诀十二讲首发，",
      "token_start": 611,
      "token_end_exclusive": 641
    },
    {
      "start_ms": 137590,
      "end_ms": 139315,
      "text": "被誉为现代丹晶。",
      "token_start": 641,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 139760,
      "end_ms": 143545,
      "text": "他把四十四封钱学森亲笔信全部捐给了钱学森图书馆，",
      "token_start": 648,
      "token_end_exclusive": 671
    },
    {
      "start_ms": 144080,
      "end_ms": 147060,
      "text": "这是两代大师守护中华文明的铁证。",
      "token_start": 671,
      "token_end_exclusive": 686
    },
    {
      "start_ms": 147260,
      "end_ms": 148265,
      "text": "但胡福琛说，",
      "token_start": 686,
      "token_end_exclusive": 691
    },
    {
      "start_ms": 148760,
      "end_ms": 150435,
      "text": "这些都不是给普通人看的，",
      "token_start": 691,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 151080,
      "end_ms": 155960,
      "text": "普通人读不懂古文被劣质白话片爱好者被江湖神棍收割，",
      "token_start": 702,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 156200,
      "end_ms": 157165,
      "text": "越修越偏，",
      "token_start": 726,
      "token_end_exclusive": 730
    },
    {
      "start_ms": 157720,
      "end_ms": 159520,
      "text": "真正的单绝藏在深山，",
      "token_start": 730,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 159760,
      "end_ms": 160605,
      "text": "濒临失传。",
      "token_start": 739,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 161180,
      "end_ms": 163495,
      "text": "他研究一辈子不是为了当大师，",
      "token_start": 743,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 163890,
      "end_ms": 168450,
      "text": "是为给后人留一条不走弯路、不被骗、不迷信的入门正路。",
      "token_start": 756,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 168690,
      "end_ms": 170045,
      "text": "我给你讲一个真实的事儿，",
      "token_start": 779,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 170290,
      "end_ms": 174090,
      "text": "北京某高校的一位博士生搞了六年材料科学实验做不出来，",
      "token_start": 790,
      "token_end_exclusive": 815
    },
    {
      "start_ms": 174270,
      "end_ms": 175515,
      "text": "导师催同门卷，",
      "token_start": 815,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 175950,
      "end_ms": 177090,
      "text": "整个人焦虑到失眠。",
      "token_start": 821,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 177230,
      "end_ms": 179745,
      "text": "偶然在图书馆看到这本道学入门，",
      "token_start": 829,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 180140,
      "end_ms": 181345,
      "text": "本来只是随手翻翻，",
      "token_start": 843,
      "token_end_exclusive": 851
    },
    {
      "start_ms": 181660,
      "end_ms": 183585,
      "text": "结果读到单道非秘术，",
      "token_start": 851,
      "token_end_exclusive": 860
    },
    {
      "start_ms": 183870,
      "end_ms": 185590,
      "text": "乃身心同条之法。",
      "token_start": 860,
      "token_end_exclusive": 867
    },
    {
      "start_ms": 185590,
      "end_ms": 186050,
      "text": "那一夜，",
      "token_start": 867,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 186270,
      "end_ms": 187070,
      "text": "他愣住了，",
      "token_start": 870,
      "token_end_exclusive": 874
    },
    {
      "start_ms": 187170,
      "end_ms": 187470,
      "text": "他说，",
      "token_start": 874,
      "token_end_exclusive": 876
    },
    {
      "start_ms": 187470,
      "end_ms": 187810,
      "text": "那一刻，",
      "token_start": 876,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 187810,
      "end_ms": 188550,
      "text": "忽然明白，",
      "token_start": 879,
      "token_end_exclusive": 883
    },
    {
      "start_ms": 188850,
      "end_ms": 190175,
      "text": "自己不是不够努力，",
      "token_start": 883,
      "token_end_exclusive": 891
    },
    {
      "start_ms": 190440,
      "end_ms": 191525,
      "text": "而是节奏乱了。",
      "token_start": 891,
      "token_end_exclusive": 897
    },
    {
      "start_ms": 191870,
      "end_ms": 192390,
      "text": "书里讲，",
      "token_start": 897,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 192510,
      "end_ms": 194875,
      "text": "数学为静养生为用，",
      "token_start": 900,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 195240,
      "end_ms": 198475,
      "text": "把十二时辰对应脏腑契机拆的清清楚楚。",
      "token_start": 908,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 198810,
      "end_ms": 200350,
      "text": "他照着书里的导引方法，",
      "token_start": 925,
      "token_end_exclusive": 935
    },
    {
      "start_ms": 200350,
      "end_ms": 203240,
      "text": "试了三分钟叩齿燕睛、舌底生津，",
      "token_start": 935,
      "token_end_exclusive": 948
    },
    {
      "start_ms": 203500,
      "end_ms": 204335,
      "text": "耳根微热，",
      "token_start": 948,
      "token_end_exclusive": 952
    },
    {
      "start_ms": 204810,
      "end_ms": 206870,
      "text": "那种久违的清醒感回来了。",
      "token_start": 952,
      "token_end_exclusive": 963
    },
    {
      "start_ms": 206870,
      "end_ms": 208335,
      "text": "他把书借回去读完了，",
      "token_start": 963,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 208740,
      "end_ms": 209600,
      "text": "后来跟朋友说，",
      "token_start": 972,
      "token_end_exclusive": 978
    },
    {
      "start_ms": 209880,
      "end_ms": 211560,
      "text": "这本书没教他炼丹修仙，",
      "token_start": 978,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 211820,
      "end_ms": 214460,
      "text": "但教他重新认识了自己的身体和节奏。",
      "token_start": 988,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 214640,
      "end_ms": 216685,
      "text": "像这样的读者不是一个两个。",
      "token_start": 1004,
      "token_end_exclusive": 1016
    },
    {
      "start_ms": 217260,
      "end_ms": 218035,
      "text": "有读者说，",
      "token_start": 1016,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 218390,
      "end_ms": 219245,
      "text": "翻开这本书，",
      "token_start": 1020,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 219570,
      "end_ms": 220310,
      "text": "没有玄虚，",
      "token_start": 1025,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 220310,
      "end_ms": 221075,
      "text": "术语堆砌，",
      "token_start": 1029,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 221480,
      "end_ms": 222785,
      "text": "像一位沉稳的老友。",
      "token_start": 1033,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 223040,
      "end_ms": 224935,
      "text": "在你翻页时悄然点一句，",
      "token_start": 1041,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 225400,
      "end_ms": 226780,
      "text": "这里慢一点看。",
      "token_start": 1051,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 226800,
      "end_ms": 227325,
      "text": "于是，",
      "token_start": 1057,
      "token_end_exclusive": 1059
    },
    {
      "start_ms": 227870,
      "end_ms": 231570,
      "text": "胡福琛把四十年治学二十六年潜伏一生，",
      "token_start": 1059,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 231610,
      "end_ms": 232135,
      "text": "实政，",
      "token_start": 1076,
      "token_end_exclusive": 1078
    },
    {
      "start_ms": 232530,
      "end_ms": 237230,
      "text": "全部押进了一本最通俗、最严谨、最正统、最安全的书。",
      "token_start": 1078,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 237370,
      "end_ms": 239445,
      "text": "书名就叫道学入门，",
      "token_start": 1099,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 239840,
      "end_ms": 240460,
      "text": "没有迷信，",
      "token_start": 1107,
      "token_end_exclusive": 1111
    },
    {
      "start_ms": 240720,
      "end_ms": 241525,
      "text": "没有玄虚，",
      "token_start": 1111,
      "token_end_exclusive": 1115
    },
    {
      "start_ms": 241920,
      "end_ms": 247830,
      "text": "只有一位顶级学者把道学根源、单道脉络、内丹逻辑、历史误区，",
      "token_start": 1115,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 248030,
      "end_ms": 250090,
      "text": "用大白话讲的明明白白。",
      "token_start": 1140,
      "token_end_exclusive": 1150
    },
    {
      "start_ms": 250250,
      "end_ms": 252495,
      "text": "这个领域有他学术地位的，",
      "token_start": 1150,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 252710,
      "end_ms": 253805,
      "text": "没他江湖实证，",
      "token_start": 1161,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 254120,
      "end_ms": 255400,
      "text": "有他江湖实证的，",
      "token_start": 1167,
      "token_end_exclusive": 1174
    },
    {
      "start_ms": 255460,
      "end_ms": 256645,
      "text": "没他科学严谨，",
      "token_start": 1174,
      "token_end_exclusive": 1180
    },
    {
      "start_ms": 256990,
      "end_ms": 258195,
      "text": "有他科学严谨的，",
      "token_start": 1180,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 258420,
      "end_ms": 259580,
      "text": "没他正统道统。",
      "token_start": 1187,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 259640,
      "end_ms": 261160,
      "text": "如果你厌倦了江湖骗术，",
      "token_start": 1193,
      "token_end_exclusive": 1203
    },
    {
      "start_ms": 261240,
      "end_ms": 262545,
      "text": "不想被伪学收割，",
      "token_start": 1203,
      "token_end_exclusive": 1210
    },
    {
      "start_ms": 262850,
      "end_ms": 264595,
      "text": "想踏踏实实亲近道学，",
      "token_start": 1210,
      "token_end_exclusive": 1219
    },
    {
      "start_ms": 264950,
      "end_ms": 268390,
      "text": "那这本书值得放在枕边相伴一生链接在下方，",
      "token_start": 1219,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 268670,
      "end_ms": 272005,
      "text": "钱学森和胡富琛花了二十六年为你开了一条路，",
      "token_start": 1238,
      "token_end_exclusive": 1258
    },
    {
      "start_ms": 272370,
      "end_ms": 274610,
      "text": "你只需要翻开第一页就能走上去。",
      "token_start": 1258,
      "token_end_exclusive": 1272
    },
    {
      "start_ms": 274690,
      "end_ms": 277445,
      "text": "如果你只是想先看看道学到底是怎么回事儿，",
      "token_start": 1272,
      "token_end_exclusive": 1291
    },
    {
      "start_ms": 277800,
      "end_ms": 280740,
      "text": "单本道学入门足够你入门一本，",
      "token_start": 1291,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 280740,
      "end_ms": 283600,
      "text": "翻完道学根源单道脉络内，",
      "token_start": 1304,
      "token_end_exclusive": 1315
    },
    {
      "start_ms": 283600,
      "end_ms": 285080,
      "text": "单逻辑全在里头，",
      "token_start": 1315,
      "token_end_exclusive": 1322
    },
    {
      "start_ms": 285140,
      "end_ms": 286035,
      "text": "不走弯路。",
      "token_start": 1322,
      "token_end_exclusive": 1326
    },
    {
      "start_ms": 286600,
      "end_ms": 288225,
      "text": "但如果你想真正沉下来，",
      "token_start": 1326,
      "token_end_exclusive": 1336
    },
    {
      "start_ms": 288460,
      "end_ms": 290745,
      "text": "把道穴的骨架和血肉都摸透，",
      "token_start": 1336,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 291130,
      "end_ms": 295030,
      "text": "可以看看搭配胡福琛先生单道法诀十二讲的组合套装。",
      "token_start": 1348,
      "token_end_exclusive": 1371
    },
    {
      "start_ms": 295510,
      "end_ms": 298425,
      "text": "那套书是钱老生前最后审阅的稿子，",
      "token_start": 1371,
      "token_end_exclusive": 1386
    },
    {
      "start_ms": 298830,
      "end_ms": 302435,
      "text": "是胡福琛用命换来的三家四派完整脉络，",
      "token_start": 1386,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 303160,
      "end_ms": 305320,
      "text": "两本对着读入门有门路，",
      "token_start": 1403,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 305600,
      "end_ms": 306735,
      "text": "深入有根基，",
      "token_start": 1413,
      "token_end_exclusive": 1418
    },
    {
      "start_ms": 307140,
      "end_ms": 308465,
      "text": "给自己选一条踏实路，",
      "token_start": 1418,
      "token_end_exclusive": 1427
    },
    {
      "start_ms": 308770,
      "end_ms": 310270,
      "text": "也给家里人留一本不走。",
      "token_start": 1427,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 310270,
      "end_ms": 311170,
      "text": "偏的正经书，",
      "token_start": 1437,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 311370,
      "end_ms": 312135,
      "text": "我是小海龟，",
      "token_start": 1442,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 312720,
      "end_ms": 314475,
      "text": "欢迎持续关注我们下本书见。",
      "token_start": 1447,
      "token_end_exclusive": 1459
    }
  ],
