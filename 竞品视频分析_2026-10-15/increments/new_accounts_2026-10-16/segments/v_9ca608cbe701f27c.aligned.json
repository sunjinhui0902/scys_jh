{
  "video_id": "v_9ca608cbe701f27c",
  "duration_s": 785.740998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_9ca608cbe701f27c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_9ca608cbe701f27c.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 3810,
      "text": "上一集咱们讲了我国十个医生必去一次的地方。",
      "token_start": 0,
      "token_end_exclusive": 20
    },
    {
      "start_ms": 4210,
      "end_ms": 10630,
      "text": "从第十个一路讲到了第六个有人在评论区说壶口瀑布那个震动，",
      "token_start": 20,
      "token_end_exclusive": 47
    },
    {
      "start_ms": 10650,
      "end_ms": 12130,
      "text": "隔着屏幕都能感觉到。",
      "token_start": 47,
      "token_end_exclusive": 56
    },
    {
      "start_ms": 12550,
      "end_ms": 13510,
      "text": "可我跟您说，",
      "token_start": 56,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 13770,
      "end_ms": 16250,
      "text": "壶口排第六前五名，",
      "token_start": 61,
      "token_end_exclusive": 69
    },
    {
      "start_ms": 16290,
      "end_ms": 18770,
      "text": "一个比一个压不住榜首，",
      "token_start": 69,
      "token_end_exclusive": 79
    },
    {
      "start_ms": 18770,
      "end_ms": 21530,
      "text": "那个地方全世界都知道他的名字，",
      "token_start": 79,
      "token_end_exclusive": 93
    },
    {
      "start_ms": 22010,
      "end_ms": 25950,
      "text": "可百分之九十九的中国人去的都不是最该去的那一段，",
      "token_start": 93,
      "token_end_exclusive": 116
    },
    {
      "start_ms": 26490,
      "end_ms": 27350,
      "text": "还是咱们的。",
      "token_start": 116,
      "token_end_exclusive": 121
    },
    {
      "start_ms": 27350,
      "end_ms": 27990,
      "text": "老规矩，",
      "token_start": 121,
      "token_end_exclusive": 124
    },
    {
      "start_ms": 28830,
      "end_ms": 30000,
      "text": "开讲前老返口，",
      "token_start": 124,
      "token_end_exclusive": 130
    },
    {
      "start_ms": 30060,
      "end_ms": 32740,
      "text": "各位老友顺手点亮红心评论区，",
      "token_start": 130,
      "token_end_exclusive": 143
    },
    {
      "start_ms": 32740,
      "end_ms": 35980,
      "text": "打个来了让我看看今天又有多少知音来捧场。",
      "token_start": 143,
      "token_end_exclusive": 162
    },
    {
      "start_ms": 36980,
      "end_ms": 37700,
      "text": "第五名，",
      "token_start": 162,
      "token_end_exclusive": 165
    },
    {
      "start_ms": 38480,
      "end_ms": 44300,
      "text": "泸沽湖、云南和四川交界的地方有一个湖叫泸沽湖，",
      "token_start": 165,
      "token_end_exclusive": 186
    },
    {
      "start_ms": 45000,
      "end_ms": 47100,
      "text": "海拔两千六百多米。",
      "token_start": 186,
      "token_end_exclusive": 194
    },
    {
      "start_ms": 47400,
      "end_ms": 49020,
      "text": "这个湖面积不算大，",
      "token_start": 194,
      "token_end_exclusive": 202
    },
    {
      "start_ms": 49640,
      "end_ms": 50940,
      "text": "五十多平方公里，",
      "token_start": 202,
      "token_end_exclusive": 209
    },
    {
      "start_ms": 51180,
      "end_ms": 53800,
      "text": "可它有一个别的湖比不了的东西，",
      "token_start": 209,
      "token_end_exclusive": 223
    },
    {
      "start_ms": 53800,
      "end_ms": 54580,
      "text": "水的颜色，",
      "token_start": 223,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 55480,
      "end_ms": 60615,
      "text": "泸沽湖的水能见度最高能到十二米十二米是什么概念呢？",
      "token_start": 227,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 61000,
      "end_ms": 63360,
      "text": "就是您站在船上往水里看，",
      "token_start": 251,
      "token_end_exclusive": 262
    },
    {
      "start_ms": 63580,
      "end_ms": 69675,
      "text": "能直接看到十二米深的湖底、石头、水草、鱼看得清清楚楚，",
      "token_start": 262,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 70100,
      "end_ms": 72425,
      "text": "湖水的颜色也不是固定的。",
      "token_start": 285,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 73190,
      "end_ms": 76090,
      "text": "早上是深蓝的中午，",
      "token_start": 296,
      "token_end_exclusive": 304
    },
    {
      "start_ms": 76190,
      "end_ms": 78545,
      "text": "阳光直射变成翡翠绿。",
      "token_start": 304,
      "token_end_exclusive": 313
    },
    {
      "start_ms": 79350,
      "end_ms": 80670,
      "text": "傍晚太阳低了，",
      "token_start": 313,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 80670,
      "end_ms": 82315,
      "text": "又变成一种灰蓝色，",
      "token_start": 319,
      "token_end_exclusive": 327
    },
    {
      "start_ms": 82880,
      "end_ms": 86615,
      "text": "一天之内三种颜色每种都干净的不像话。",
      "token_start": 327,
      "token_end_exclusive": 344
    },
    {
      "start_ms": 87300,
      "end_ms": 89335,
      "text": "泸沽湖边住着摩梭人，",
      "token_start": 344,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 90150,
      "end_ms": 91615,
      "text": "摩梭人有一个传统，",
      "token_start": 353,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 92220,
      "end_ms": 97555,
      "text": "到了天亮之前最安静的时候会划着诛曹船到湖中间去，",
      "token_start": 361,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 97910,
      "end_ms": 98575,
      "text": "船不大，",
      "token_start": 384,
      "token_end_exclusive": 387
    },
    {
      "start_ms": 99130,
      "end_ms": 100785,
      "text": "一个人刚好坐进去。",
      "token_start": 387,
      "token_end_exclusive": 395
    },
    {
      "start_ms": 101180,
      "end_ms": 102355,
      "text": "湖面上没有风，",
      "token_start": 395,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 102940,
      "end_ms": 105240,
      "text": "水面平的像一块镜子，",
      "token_start": 401,
      "token_end_exclusive": 410
    },
    {
      "start_ms": 105300,
      "end_ms": 107355,
      "text": "船划过去留下一道纹路，",
      "token_start": 410,
      "token_end_exclusive": 420
    },
    {
      "start_ms": 107730,
      "end_ms": 108550,
      "text": "慢慢散开，",
      "token_start": 420,
      "token_end_exclusive": 424
    },
    {
      "start_ms": 108970,
      "end_ms": 112090,
      "text": "然后又平了摩梭人管。",
      "token_start": 424,
      "token_end_exclusive": 433
    },
    {
      "start_ms": 112150,
      "end_ms": 115160,
      "text": "泸沽湖叫母亲湖传说，",
      "token_start": 433,
      "token_end_exclusive": 442
    },
    {
      "start_ms": 115260,
      "end_ms": 116860,
      "text": "湖底住着一位女神，",
      "token_start": 442,
      "token_end_exclusive": 450
    },
    {
      "start_ms": 117360,
      "end_ms": 120675,
      "text": "守着这片水传说归传说。",
      "token_start": 450,
      "token_end_exclusive": 460
    },
    {
      "start_ms": 121130,
      "end_ms": 126115,
      "text": "可这个湖确实安静到让人觉得水底真有什么东西在看着你。",
      "token_start": 460,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 126940,
      "end_ms": 131595,
      "text": "一个湖水干净到能看见十二米深的湖底，",
      "token_start": 485,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 132370,
      "end_ms": 134010,
      "text": "住了几百年的人，",
      "token_start": 502,
      "token_end_exclusive": 509
    },
    {
      "start_ms": 134010,
      "end_ms": 134910,
      "text": "管他叫母亲。",
      "token_start": 509,
      "token_end_exclusive": 514
    },
    {
      "start_ms": 135450,
      "end_ms": 147030,
      "text": "第四名布达拉宫西藏拉萨布达拉宫修在红山上面，",
      "token_start": 514,
      "token_end_exclusive": 535
    },
    {
      "start_ms": 147070,
      "end_ms": 148725,
      "text": "海拔三千七百多米，",
      "token_start": 535,
      "token_end_exclusive": 543
    },
    {
      "start_ms": 149470,
      "end_ms": 151855,
      "text": "到今天已经一千三百多年了。",
      "token_start": 543,
      "token_end_exclusive": 555
    },
    {
      "start_ms": 152400,
      "end_ms": 155175,
      "text": "布达拉宫主体高一百一十七米，",
      "token_start": 555,
      "token_end_exclusive": 568
    },
    {
      "start_ms": 155980,
      "end_ms": 157700,
      "text": "从山脚到宫殿顶，",
      "token_start": 568,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 157740,
      "end_ms": 158815,
      "text": "一共十三层，",
      "token_start": 575,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 159800,
      "end_ms": 161975,
      "text": "这个高度放在今天不算什么。",
      "token_start": 580,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 162370,
      "end_ms": 163225,
      "text": "可您想想，",
      "token_start": 592,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 163750,
      "end_ms": 165845,
      "text": "这是一千三百多年前修的，",
      "token_start": 596,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 166190,
      "end_ms": 166890,
      "text": "没有钢筋，",
      "token_start": 607,
      "token_end_exclusive": 611
    },
    {
      "start_ms": 166890,
      "end_ms": 167470,
      "text": "没有水泥，",
      "token_start": 611,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 167470,
      "end_ms": 168205,
      "text": "没有吊车，",
      "token_start": 615,
      "token_end_exclusive": 619
    },
    {
      "start_ms": 168720,
      "end_ms": 172305,
      "text": "一块一块石头从山脚背上去垒起来。",
      "token_start": 619,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 173390,
      "end_ms": 176245,
      "text": "宫殿的墙体最后的地方有五米，",
      "token_start": 634,
      "token_end_exclusive": 647
    },
    {
      "start_ms": 176750,
      "end_ms": 178745,
      "text": "底部的石墙里面灌着铁汁，",
      "token_start": 647,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 179570,
      "end_ms": 181190,
      "text": "所以站了一千三百多年。",
      "token_start": 658,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 181190,
      "end_ms": 183190,
      "text": "到今天地震都没把它荒塌。",
      "token_start": 668,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 183330,
      "end_ms": 187035,
      "text": "布达拉宫里面有大大小小一千多间房，",
      "token_start": 679,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 187490,
      "end_ms": 191225,
      "text": "供奉着几百尊佛像和大量的经文典籍。",
      "token_start": 695,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 191700,
      "end_ms": 193840,
      "text": "可最让人震撼的不是佛像，",
      "token_start": 711,
      "token_end_exclusive": 722
    },
    {
      "start_ms": 193840,
      "end_ms": 194595,
      "text": "不是经文，",
      "token_start": 722,
      "token_end_exclusive": 726
    },
    {
      "start_ms": 195010,
      "end_ms": 197270,
      "text": "是走进去之后的那种感觉。",
      "token_start": 726,
      "token_end_exclusive": 737
    },
    {
      "start_ms": 197310,
      "end_ms": 199435,
      "text": "酥油灯的光是暗黄色，",
      "token_start": 737,
      "token_end_exclusive": 746
    },
    {
      "start_ms": 199980,
      "end_ms": 203745,
      "text": "空气里有一股酥油和藏香混在一起的味道。",
      "token_start": 746,
      "token_end_exclusive": 764
    },
    {
      "start_ms": 204330,
      "end_ms": 213285,
      "text": "脚底下的地板被刻长头的人用身体蹭了几百年光滑的反光转经筒在走廊里一排一排的立着，",
      "token_start": 764,
      "token_end_exclusive": 803
    },
    {
      "start_ms": 213920,
      "end_ms": 215540,
      "text": "有人一个一个的转过去，",
      "token_start": 803,
      "token_end_exclusive": 813
    },
    {
      "start_ms": 215560,
      "end_ms": 217775,
      "text": "嘴里念着什么表情很平，",
      "token_start": 813,
      "token_end_exclusive": 823
    },
    {
      "start_ms": 218410,
      "end_ms": 219930,
      "text": "您不需要信什么，",
      "token_start": 823,
      "token_end_exclusive": 830
    },
    {
      "start_ms": 220090,
      "end_ms": 221490,
      "text": "可走在里面的时候，",
      "token_start": 830,
      "token_end_exclusive": 838
    },
    {
      "start_ms": 221490,
      "end_ms": 223155,
      "text": "脚步会自己慢下来，",
      "token_start": 838,
      "token_end_exclusive": 846
    },
    {
      "start_ms": 223470,
      "end_ms": 225435,
      "text": "说话声音会自己小下去。",
      "token_start": 846,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 226070,
      "end_ms": 228965,
      "text": "一千三百多年的地方有这个本事，",
      "token_start": 856,
      "token_end_exclusive": 870
    },
    {
      "start_ms": 229420,
      "end_ms": 230685,
      "text": "不用跟你讲道理，",
      "token_start": 870,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 230970,
      "end_ms": 232145,
      "text": "他就让你安静了。",
      "token_start": 877,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 232760,
      "end_ms": 235235,
      "text": "修在三千七百米的山顶上，",
      "token_start": 884,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 235570,
      "end_ms": 237385,
      "text": "一千三百多年没他过，",
      "token_start": 895,
      "token_end_exclusive": 904
    },
    {
      "start_ms": 237930,
      "end_ms": 240255,
      "text": "里面的苏油灯不知道续了多少代了，",
      "token_start": 904,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 240640,
      "end_ms": 242295,
      "text": "到今天还亮着。",
      "token_start": 919,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 242770,
      "end_ms": 243465,
      "text": "第三名，",
      "token_start": 925,
      "token_end_exclusive": 928
    },
    {
      "start_ms": 245070,
      "end_ms": 246195,
      "text": "敦煌莫高窟，",
      "token_start": 928,
      "token_end_exclusive": 933
    },
    {
      "start_ms": 247490,
      "end_ms": 253740,
      "text": "甘肃敦煌莫高窟这个地方排第三，",
      "token_start": 933,
      "token_end_exclusive": 947
    },
    {
      "start_ms": 253740,
      "end_ms": 255760,
      "text": "不是因为它好看好看的地方，",
      "token_start": 947,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 255780,
      "end_ms": 258360,
      "text": "前面讲了好几个莫高窟排第三，",
      "token_start": 959,
      "token_end_exclusive": 972
    },
    {
      "start_ms": 258360,
      "end_ms": 259975,
      "text": "是因为它正在消失。",
      "token_start": 972,
      "token_end_exclusive": 980
    },
    {
      "start_ms": 260530,
      "end_ms": 265495,
      "text": "莫高窟开凿于公元三百六十六年到今天将近一千七百年，",
      "token_start": 980,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 265980,
      "end_ms": 269125,
      "text": "一千七百年里前前后后开了七百多个洞，",
      "token_start": 1004,
      "token_end_exclusive": 1021
    },
    {
      "start_ms": 269620,
      "end_ms": 272555,
      "text": "保存到今天的有四百九十二个，",
      "token_start": 1021,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 273250,
      "end_ms": 278155,
      "text": "里面有四万五千多平方米的壁画和两千多尊彩塑。",
      "token_start": 1034,
      "token_end_exclusive": 1055
    },
    {
      "start_ms": 279080,
      "end_ms": 282205,
      "text": "四万五千平方米的壁画是什么概念呢？",
      "token_start": 1055,
      "token_end_exclusive": 1071
    },
    {
      "start_ms": 282700,
      "end_ms": 285560,
      "text": "如果把这些壁画一幅一幅排成一排，",
      "token_start": 1071,
      "token_end_exclusive": 1086
    },
    {
      "start_ms": 285920,
      "end_ms": 288265,
      "text": "能排将近二十五公里长。",
      "token_start": 1086,
      "token_end_exclusive": 1096
    },
    {
      "start_ms": 288910,
      "end_ms": 289795,
      "text": "可问题是，",
      "token_start": 1096,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 290400,
      "end_ms": 292520,
      "text": "这些壁画在消失，",
      "token_start": 1100,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 292800,
      "end_ms": 294795,
      "text": "敦煌的气候是干燥的，",
      "token_start": 1107,
      "token_end_exclusive": 1116
    },
    {
      "start_ms": 295480,
      "end_ms": 296215,
      "text": "风沙大。",
      "token_start": 1116,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 296750,
      "end_ms": 297910,
      "text": "昼夜温差大，",
      "token_start": 1119,
      "token_end_exclusive": 1124
    },
    {
      "start_ms": 298710,
      "end_ms": 300250,
      "text": "壁画画在泥壁上，",
      "token_start": 1124,
      "token_end_exclusive": 1131
    },
    {
      "start_ms": 300750,
      "end_ms": 305530,
      "text": "颜料是矿物质的一千多年下来氧化干裂，",
      "token_start": 1131,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 305650,
      "end_ms": 306650,
      "text": "其甲脱落，",
      "token_start": 1148,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 307190,
      "end_ms": 308510,
      "text": "每一天都在变，",
      "token_start": 1152,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 308970,
      "end_ms": 310510,
      "text": "加上游客进去之后，",
      "token_start": 1158,
      "token_end_exclusive": 1166
    },
    {
      "start_ms": 310510,
      "end_ms": 312210,
      "text": "呼出的二氧化碳和水汽，",
      "token_start": 1166,
      "token_end_exclusive": 1176
    },
    {
      "start_ms": 312530,
      "end_ms": 314430,
      "text": "改变洞窟内的微环境，",
      "token_start": 1176,
      "token_end_exclusive": 1185
    },
    {
      "start_ms": 315290,
      "end_ms": 317010,
      "text": "壁画的退化在加速。",
      "token_start": 1185,
      "token_end_exclusive": 1193
    },
    {
      "start_ms": 317970,
      "end_ms": 322390,
      "text": "加在莫高窟每天限流六千人进去之前，",
      "token_start": 1193,
      "token_end_exclusive": 1209
    },
    {
      "start_ms": 322490,
      "end_ms": 324250,
      "text": "要先看两部数字电影，",
      "token_start": 1209,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 324270,
      "end_ms": 325030,
      "text": "了解背景，",
      "token_start": 1218,
      "token_end_exclusive": 1222
    },
    {
      "start_ms": 325450,
      "end_ms": 328760,
      "text": "然后由讲解员带着进洞窟，",
      "token_start": 1222,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 329220,
      "end_ms": 331700,
      "text": "每个窟停留时间有限制，",
      "token_start": 1233,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 331720,
      "end_ms": 333800,
      "text": "不是景区故意为难，",
      "token_start": 1243,
      "token_end_exclusive": 1251
    },
    {
      "start_ms": 333800,
      "end_ms": 335700,
      "text": "人是真的扛不住了。",
      "token_start": 1251,
      "token_end_exclusive": 1259
    },
    {
      "start_ms": 336640,
      "end_ms": 339240,
      "text": "有些洞窟已经永久关闭了，",
      "token_start": 1259,
      "token_end_exclusive": 1270
    },
    {
      "start_ms": 339960,
      "end_ms": 343060,
      "text": "里面的壁画只能看数字化的复制品。",
      "token_start": 1270,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 343980,
      "end_ms": 348160,
      "text": "您今天去看到的莫高窟和十年前去看到的已经不一样了，",
      "token_start": 1285,
      "token_end_exclusive": 1309
    },
    {
      "start_ms": 348500,
      "end_ms": 351440,
      "text": "十年后去看到的还会再变，",
      "token_start": 1309,
      "token_end_exclusive": 1320
    },
    {
      "start_ms": 352120,
      "end_ms": 355340,
      "text": "这是一个每一天都在少一点的地方。",
      "token_start": 1320,
      "token_end_exclusive": 1335
    },
    {
      "start_ms": 356060,
      "end_ms": 358730,
      "text": "所以说莫高窟不是想去就去的地方，",
      "token_start": 1335,
      "token_end_exclusive": 1350
    },
    {
      "start_ms": 358970,
      "end_ms": 361105,
      "text": "是再不去就晚了的地方。",
      "token_start": 1350,
      "token_end_exclusive": 1360
    },
    {
      "start_ms": 361690,
      "end_ms": 365470,
      "text": "一千七百年的壁画正在一天一天的消失。",
      "token_start": 1360,
      "token_end_exclusive": 1377
    },
    {
      "start_ms": 365650,
      "end_ms": 366450,
      "text": "等到某一天，",
      "token_start": 1377,
      "token_end_exclusive": 1382
    },
    {
      "start_ms": 366450,
      "end_ms": 367995,
      "text": "那些颜色彻底褪完了，",
      "token_start": 1382,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 368250,
      "end_ms": 369255,
      "text": "谁都看不到了。",
      "token_start": 1391,
      "token_end_exclusive": 1397
    },
    {
      "start_ms": 370080,
      "end_ms": 374285,
      "text": "第二名故宫北京故宫，",
      "token_start": 1397,
      "token_end_exclusive": 1406
    },
    {
      "start_ms": 375150,
      "end_ms": 376845,
      "text": "您可能觉得故宫谁没去过，",
      "token_start": 1406,
      "token_end_exclusive": 1417
    },
    {
      "start_ms": 377780,
      "end_ms": 378220,
      "text": "排什么，",
      "token_start": 1417,
      "token_end_exclusive": 1420
    },
    {
      "start_ms": 378220,
      "end_ms": 379920,
      "text": "一生必去故宫，",
      "token_start": 1420,
      "token_end_exclusive": 1426
    },
    {
      "start_ms": 379960,
      "end_ms": 381055,
      "text": "确实谁都去过。",
      "token_start": 1426,
      "token_end_exclusive": 1432
    },
    {
      "start_ms": 381900,
      "end_ms": 383820,
      "text": "可大部分人去故宫的方式，",
      "token_start": 1432,
      "token_end_exclusive": 1443
    },
    {
      "start_ms": 383820,
      "end_ms": 385060,
      "text": "是从午门进去，",
      "token_start": 1443,
      "token_end_exclusive": 1449
    },
    {
      "start_ms": 385480,
      "end_ms": 387315,
      "text": "沿着中轴线走，",
      "token_start": 1449,
      "token_end_exclusive": 1455
    },
    {
      "start_ms": 388170,
      "end_ms": 392885,
      "text": "太和殿看看乾清宫看看御花园看看，",
      "token_start": 1455,
      "token_end_exclusive": 1470
    },
    {
      "start_ms": 393860,
      "end_ms": 396015,
      "text": "然后从神武门出来，",
      "token_start": 1470,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 396600,
      "end_ms": 397560,
      "text": "一路走下来，",
      "token_start": 1478,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 397560,
      "end_ms": 398560,
      "text": "拍了一堆照片，",
      "token_start": 1483,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 398740,
      "end_ms": 400345,
      "text": "回去也说不清看了什么。",
      "token_start": 1489,
      "token_end_exclusive": 1499
    },
    {
      "start_ms": 400860,
      "end_ms": 403660,
      "text": "这种走法只走了故宫的十分之一。",
      "token_start": 1499,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 403760,
      "end_ms": 406595,
      "text": "故宫一共有九千多间房，",
      "token_start": 1513,
      "token_end_exclusive": 1523
    },
    {
      "start_ms": 407310,
      "end_ms": 410955,
      "text": "开放面积占总面积的百分之八十左右。",
      "token_start": 1523,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 411840,
      "end_ms": 415405,
      "text": "中轴线上的三大殿只是最显眼的部分。",
      "token_start": 1539,
      "token_end_exclusive": 1555
    },
    {
      "start_ms": 416220,
      "end_ms": 418700,
      "text": "真正有意思的东西全在两边。",
      "token_start": 1555,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 418700,
      "end_ms": 425010,
      "text": "西六沽东六宫、慈宁宫花园、文华殿、武英殿、珍宝馆，",
      "token_start": 1567,
      "token_end_exclusive": 1587
    },
    {
      "start_ms": 425190,
      "end_ms": 425995,
      "text": "钟表馆。",
      "token_start": 1587,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 426870,
      "end_ms": 430565,
      "text": "光是钟表馆里面的清代钟表就够看一个小时的，",
      "token_start": 1590,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 430830,
      "end_ms": 432905,
      "text": "有一座中高将近六米，",
      "token_start": 1610,
      "token_end_exclusive": 1619
    },
    {
      "start_ms": 433390,
      "end_ms": 435115,
      "text": "上面有一千多个零件，",
      "token_start": 1619,
      "token_end_exclusive": 1628
    },
    {
      "start_ms": 436020,
      "end_ms": 437265,
      "text": "到今天还能走。",
      "token_start": 1628,
      "token_end_exclusive": 1634
    },
    {
      "start_ms": 438220,
      "end_ms": 439700,
      "text": "故宫最好看的时候，",
      "token_start": 1634,
      "token_end_exclusive": 1642
    },
    {
      "start_ms": 439740,
      "end_ms": 441780,
      "text": "不是白天游客挤着的时候，",
      "token_start": 1642,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 441780,
      "end_ms": 442955,
      "text": "是下雪的时候，",
      "token_start": 1653,
      "token_end_exclusive": 1659
    },
    {
      "start_ms": 444270,
      "end_ms": 445225,
      "text": "北京一下雪。",
      "token_start": 1659,
      "token_end_exclusive": 1664
    },
    {
      "start_ms": 445610,
      "end_ms": 448295,
      "text": "故宫的红墙黄瓦上面盖一层白雪，",
      "token_start": 1664,
      "token_end_exclusive": 1678
    },
    {
      "start_ms": 449140,
      "end_ms": 449680,
      "text": "太和殿，",
      "token_start": 1678,
      "token_end_exclusive": 1681
    },
    {
      "start_ms": 449680,
      "end_ms": 451505,
      "text": "前面的广场白茫茫一片，",
      "token_start": 1681,
      "token_end_exclusive": 1691
    },
    {
      "start_ms": 452340,
      "end_ms": 453935,
      "text": "铜缸上面顶着血帽子，",
      "token_start": 1691,
      "token_end_exclusive": 1700
    },
    {
      "start_ms": 454760,
      "end_ms": 457090,
      "text": "角楼倒映在护城河里。",
      "token_start": 1700,
      "token_end_exclusive": 1709
    },
    {
      "start_ms": 457090,
      "end_ms": 458795,
      "text": "六百年的宫殿配上雪，",
      "token_start": 1709,
      "token_end_exclusive": 1718
    },
    {
      "start_ms": 459370,
      "end_ms": 461125,
      "text": "那个画面是老天爷给的，",
      "token_start": 1718,
      "token_end_exclusive": 1728
    },
    {
      "start_ms": 461370,
      "end_ms": 462455,
      "text": "谁也复制不了。",
      "token_start": 1728,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 463430,
      "end_ms": 465965,
      "text": "六百年的宫殿九千多间房，",
      "token_start": 1734,
      "token_end_exclusive": 1745
    },
    {
      "start_ms": 466680,
      "end_ms": 469720,
      "text": "您上次去走了几件第一名。",
      "token_start": 1745,
      "token_end_exclusive": 1756
    },
    {
      "start_ms": 469720,
      "end_ms": 470495,
      "text": "先别急，",
      "token_start": 1756,
      "token_end_exclusive": 1759
    },
    {
      "start_ms": 471290,
      "end_ms": 475465,
      "text": "在接之前跟您聊几句评论区有不少朋友说，",
      "token_start": 1759,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 475880,
      "end_ms": 477240,
      "text": "这些地方一直想去，",
      "token_start": 1777,
      "token_end_exclusive": 1785
    },
    {
      "start_ms": 477240,
      "end_ms": 478760,
      "text": "可总也下不了决心，",
      "token_start": 1785,
      "token_end_exclusive": 1793
    },
    {
      "start_ms": 478840,
      "end_ms": 479965,
      "text": "要么觉得太远，",
      "token_start": 1793,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 480760,
      "end_ms": 481620,
      "text": "要么怕去了，",
      "token_start": 1799,
      "token_end_exclusive": 1804
    },
    {
      "start_ms": 481620,
      "end_ms": 482625,
      "text": "不知道看什么。",
      "token_start": 1804,
      "token_end_exclusive": 1810
    },
    {
      "start_ms": 483570,
      "end_ms": 487540,
      "text": "确实很多地方不是到了就能看明白的。",
      "token_start": 1810,
      "token_end_exclusive": 1826
    },
    {
      "start_ms": 487540,
      "end_ms": 489180,
      "text": "莫高窟的壁画不看背景，",
      "token_start": 1826,
      "token_end_exclusive": 1836
    },
    {
      "start_ms": 489180,
      "end_ms": 491420,
      "text": "根本看不懂布达拉宫的历史，",
      "token_start": 1836,
      "token_end_exclusive": 1848
    },
    {
      "start_ms": 491420,
      "end_ms": 491880,
      "text": "不了解，",
      "token_start": 1848,
      "token_end_exclusive": 1851
    },
    {
      "start_ms": 491880,
      "end_ms": 493385,
      "text": "就只能看个热闹。",
      "token_start": 1851,
      "token_end_exclusive": 1858
    },
    {
      "start_ms": 494340,
      "end_ms": 496000,
      "text": "故宫不提前做功课，",
      "token_start": 1858,
      "token_end_exclusive": 1866
    },
    {
      "start_ms": 496000,
      "end_ms": 498355,
      "text": "就只能在中轴线上挤着走。",
      "token_start": 1866,
      "token_end_exclusive": 1877
    },
    {
      "start_ms": 499300,
      "end_ms": 501480,
      "text": "后来有朋友给我推荐了一本书，",
      "token_start": 1877,
      "token_end_exclusive": 1890
    },
    {
      "start_ms": 501540,
      "end_ms": 502865,
      "text": "叫大美中国，",
      "token_start": 1890,
      "token_end_exclusive": 1895
    },
    {
      "start_ms": 503410,
      "end_ms": 509345,
      "text": "说是里面把这些地方的历史背景、文化细节和值得看的重点全整理好了，",
      "token_start": 1895,
      "token_end_exclusive": 1925
    },
    {
      "start_ms": 510160,
      "end_ms": 511180,
      "text": "还有实拍的图，",
      "token_start": 1925,
      "token_end_exclusive": 1931
    },
    {
      "start_ms": 511420,
      "end_ms": 512280,
      "text": "我翻了一下，",
      "token_start": 1931,
      "token_end_exclusive": 1936
    },
    {
      "start_ms": 512280,
      "end_ms": 513415,
      "text": "确实挺实在的，",
      "token_start": 1936,
      "token_end_exclusive": 1942
    },
    {
      "start_ms": 514150,
      "end_ms": 517255,
      "text": "不是网上那种东拼西凑的攻略，",
      "token_start": 1942,
      "token_end_exclusive": 1955
    },
    {
      "start_ms": 518090,
      "end_ms": 521005,
      "text": "是一个地方一个地方认真写的。",
      "token_start": 1955,
      "token_end_exclusive": 1968
    },
    {
      "start_ms": 521970,
      "end_ms": 523505,
      "text": "出发之前翻一遍，",
      "token_start": 1968,
      "token_end_exclusive": 1975
    },
    {
      "start_ms": 524490,
      "end_ms": 526325,
      "text": "到了那儿知道看什么，",
      "token_start": 1975,
      "token_end_exclusive": 1984
    },
    {
      "start_ms": 526700,
      "end_ms": 528285,
      "text": "看完了回来再翻一遍，",
      "token_start": 1984,
      "token_end_exclusive": 1993
    },
    {
      "start_ms": 528600,
      "end_ms": 530295,
      "text": "感受完全不一样。",
      "token_start": 1993,
      "token_end_exclusive": 2000
    },
    {
      "start_ms": 531170,
      "end_ms": 533890,
      "text": "想要的朋友点左下角头像进橱窗，",
      "token_start": 2000,
      "token_end_exclusive": 2014
    },
    {
      "start_ms": 534290,
      "end_ms": 538180,
      "text": "认准大美中国这本书去一趟莫高窟，",
      "token_start": 2014,
      "token_end_exclusive": 2029
    },
    {
      "start_ms": 538180,
      "end_ms": 539380,
      "text": "光门票加住宿，",
      "token_start": 2029,
      "token_end_exclusive": 2035
    },
    {
      "start_ms": 539380,
      "end_ms": 541830,
      "text": "就得好几百花几十块钱。",
      "token_start": 2035,
      "token_end_exclusive": 2045
    },
    {
      "start_ms": 541850,
      "end_ms": 542530,
      "text": "先搞明白，",
      "token_start": 2045,
      "token_end_exclusive": 2049
    },
    {
      "start_ms": 542530,
      "end_ms": 545825,
      "text": "看什么怎么都划算。",
      "token_start": 2049,
      "token_end_exclusive": 2057
    },
    {
      "start_ms": 547230,
      "end_ms": 549630,
      "text": "好书先说到这儿，",
      "token_start": 2057,
      "token_end_exclusive": 2064
    },
    {
      "start_ms": 549630,
      "end_ms": 555035,
      "text": "咱们收回来接最后一个第一名长城。",
      "token_start": 2064,
      "token_end_exclusive": 2079
    },
    {
      "start_ms": 556150,
      "end_ms": 557665,
      "text": "可能有人一听就笑了，",
      "token_start": 2079,
      "token_end_exclusive": 2088
    },
    {
      "start_ms": 559080,
      "end_ms": 560275,
      "text": "长城八达岭，",
      "token_start": 2088,
      "token_end_exclusive": 2093
    },
    {
      "start_ms": 561350,
      "end_ms": 563285,
      "text": "那不就是人挤人拍照吗？",
      "token_start": 2093,
      "token_end_exclusive": 2103
    },
    {
      "start_ms": 564970,
      "end_ms": 566525,
      "text": "如果您去的是八达岭，",
      "token_start": 2103,
      "token_end_exclusive": 2112
    },
    {
      "start_ms": 566980,
      "end_ms": 568300,
      "text": "确实是八达岭，",
      "token_start": 2112,
      "token_end_exclusive": 2118
    },
    {
      "start_ms": 568300,
      "end_ms": 569145,
      "text": "是修缮过，",
      "token_start": 2118,
      "token_end_exclusive": 2122
    },
    {
      "start_ms": 569530,
      "end_ms": 570470,
      "text": "路面平整，",
      "token_start": 2122,
      "token_end_exclusive": 2126
    },
    {
      "start_ms": 570590,
      "end_ms": 571655,
      "text": "两边有栏杆，",
      "token_start": 2126,
      "token_end_exclusive": 2131
    },
    {
      "start_ms": 572060,
      "end_ms": 572880,
      "text": "游客多的时候，",
      "token_start": 2131,
      "token_end_exclusive": 2137
    },
    {
      "start_ms": 572880,
      "end_ms": 573985,
      "text": "台阶上全是人，",
      "token_start": 2137,
      "token_end_exclusive": 2143
    },
    {
      "start_ms": 574360,
      "end_ms": 575420,
      "text": "前面的人不走，",
      "token_start": 2143,
      "token_end_exclusive": 2149
    },
    {
      "start_ms": 575420,
      "end_ms": 576205,
      "text": "你也走不了。",
      "token_start": 2149,
      "token_end_exclusive": 2154
    },
    {
      "start_ms": 576540,
      "end_ms": 578405,
      "text": "那个地方看的是到此一游，",
      "token_start": 2154,
      "token_end_exclusive": 2165
    },
    {
      "start_ms": 578930,
      "end_ms": 580115,
      "text": "不是长城。",
      "token_start": 2165,
      "token_end_exclusive": 2169
    },
    {
      "start_ms": 581240,
      "end_ms": 590535,
      "text": "真正值得去的长城不在八达岭在建寇建寇长城在北京怀柔区没有修缮过，",
      "token_start": 2169,
      "token_end_exclusive": 2200
    },
    {
      "start_ms": 590910,
      "end_ms": 593355,
      "text": "保持着明朝修建时的原样。",
      "token_start": 2200,
      "token_end_exclusive": 2211
    },
    {
      "start_ms": 594240,
      "end_ms": 597530,
      "text": "城砖上的建痕还在墙体，",
      "token_start": 2211,
      "token_end_exclusive": 2221
    },
    {
      "start_ms": 597550,
      "end_ms": 598995,
      "text": "有的地方塌了半边，",
      "token_start": 2221,
      "token_end_exclusive": 2229
    },
    {
      "start_ms": 599440,
      "end_ms": 602780,
      "text": "有的地方长满了荒草和灌木台阶，",
      "token_start": 2229,
      "token_end_exclusive": 2243
    },
    {
      "start_ms": 602880,
      "end_ms": 603785,
      "text": "高矮不一。",
      "token_start": 2243,
      "token_end_exclusive": 2247
    },
    {
      "start_ms": 604250,
      "end_ms": 609850,
      "text": "有几段抖到要手脚并用才能爬上去走在上面。",
      "token_start": 2247,
      "token_end_exclusive": 2266
    },
    {
      "start_ms": 609870,
      "end_ms": 611650,
      "text": "脚底下的城砖是松的，",
      "token_start": 2266,
      "token_end_exclusive": 2275
    },
    {
      "start_ms": 612029,
      "end_ms": 615050,
      "text": "踩上去咯吱咯吱响箭扣。",
      "token_start": 2275,
      "token_end_exclusive": 2285
    },
    {
      "start_ms": 615070,
      "end_ms": 619070,
      "text": "最出名的一段叫莺飞荡仰往墙，",
      "token_start": 2285,
      "token_end_exclusive": 2298
    },
    {
      "start_ms": 619210,
      "end_ms": 623430,
      "text": "沿着山脊走到一个接近垂直的悬崖边上，",
      "token_start": 2298,
      "token_end_exclusive": 2315
    },
    {
      "start_ms": 624130,
      "end_ms": 626910,
      "text": "城墙一路向下陡降。",
      "token_start": 2315,
      "token_end_exclusive": 2323
    },
    {
      "start_ms": 627090,
      "end_ms": 627650,
      "text": "往上看，",
      "token_start": 2323,
      "token_end_exclusive": 2326
    },
    {
      "start_ms": 627650,
      "end_ms": 629770,
      "text": "长城像一条灰色的龙脊，",
      "token_start": 2326,
      "token_end_exclusive": 2336
    },
    {
      "start_ms": 629790,
      "end_ms": 631390,
      "text": "顺着山势往天上爬。",
      "token_start": 2336,
      "token_end_exclusive": 2344
    },
    {
      "start_ms": 632050,
      "end_ms": 632770,
      "text": "往下看，",
      "token_start": 2344,
      "token_end_exclusive": 2347
    },
    {
      "start_ms": 632870,
      "end_ms": 634360,
      "text": "脚底下就是悬崖呀，",
      "token_start": 2347,
      "token_end_exclusive": 2355
    },
    {
      "start_ms": 634800,
      "end_ms": 636620,
      "text": "山谷里面什么声音都没有。",
      "token_start": 2355,
      "token_end_exclusive": 2366
    },
    {
      "start_ms": 636960,
      "end_ms": 640040,
      "text": "您站在箭扣长城上面往两边看，",
      "token_start": 2366,
      "token_end_exclusive": 2379
    },
    {
      "start_ms": 640520,
      "end_ms": 642660,
      "text": "没有游客没有小贩，",
      "token_start": 2379,
      "token_end_exclusive": 2387
    },
    {
      "start_ms": 642900,
      "end_ms": 643800,
      "text": "没有缆车，",
      "token_start": 2387,
      "token_end_exclusive": 2391
    },
    {
      "start_ms": 644180,
      "end_ms": 645000,
      "text": "什么都没有，",
      "token_start": 2391,
      "token_end_exclusive": 2396
    },
    {
      "start_ms": 645780,
      "end_ms": 649600,
      "text": "不是城墙山天六百多年前的砖，",
      "token_start": 2396,
      "token_end_exclusive": 2409
    },
    {
      "start_ms": 650040,
      "end_ms": 651520,
      "text": "六百多年前的城墙，",
      "token_start": 2409,
      "token_end_exclusive": 2417
    },
    {
      "start_ms": 651880,
      "end_ms": 653560,
      "text": "六百多年前的台阶，",
      "token_start": 2417,
      "token_end_exclusive": 2425
    },
    {
      "start_ms": 654180,
      "end_ms": 658100,
      "text": "连砖缝里长出来的草都像是长了很久了。",
      "token_start": 2425,
      "token_end_exclusive": 2442
    },
    {
      "start_ms": 659080,
      "end_ms": 660380,
      "text": "这才是长城，",
      "token_start": 2442,
      "token_end_exclusive": 2447
    },
    {
      "start_ms": 661580,
      "end_ms": 662540,
      "text": "不是景区。",
      "token_start": 2447,
      "token_end_exclusive": 2451
    },
    {
      "start_ms": 662540,
      "end_ms": 665510,
      "text": "那个长城是六百多年前修来打仗的。",
      "token_start": 2451,
      "token_end_exclusive": 2466
    },
    {
      "start_ms": 665510,
      "end_ms": 668500,
      "text": "那个长城站在上面的感觉，",
      "token_start": 2466,
      "token_end_exclusive": 2477
    },
    {
      "start_ms": 668500,
      "end_ms": 669895,
      "text": "不是我来旅游了，",
      "token_start": 2477,
      "token_end_exclusive": 2484
    },
    {
      "start_ms": 670310,
      "end_ms": 672325,
      "text": "是我站在六百年前了。",
      "token_start": 2484,
      "token_end_exclusive": 2493
    },
    {
      "start_ms": 672990,
      "end_ms": 675010,
      "text": "那种安静不是没有声音的，",
      "token_start": 2493,
      "token_end_exclusive": 2504
    },
    {
      "start_ms": 675010,
      "end_ms": 677535,
      "text": "安静是时间停了的安静，",
      "token_start": 2504,
      "token_end_exclusive": 2514
    },
    {
      "start_ms": 677990,
      "end_ms": 686325,
      "text": "全世界都知道长城的名字可真正踩过六百年前那些砖的人没几个先在评论区打出四个字，",
      "token_start": 2514,
      "token_end_exclusive": 2552
    },
    {
      "start_ms": 686730,
      "end_ms": 691845,
      "text": "一生必去打完回来听最后一段十个地方讲完。",
      "token_start": 2552,
      "token_end_exclusive": 2571
    },
    {
      "start_ms": 692810,
      "end_ms": 693995,
      "text": "您回头想想，",
      "token_start": 2571,
      "token_end_exclusive": 2576
    },
    {
      "start_ms": 695000,
      "end_ms": 696320,
      "text": "一个城市里的湖，",
      "token_start": 2576,
      "token_end_exclusive": 2583
    },
    {
      "start_ms": 696500,
      "end_ms": 698260,
      "text": "安安静静好看了。",
      "token_start": 2583,
      "token_end_exclusive": 2590
    },
    {
      "start_ms": 698260,
      "end_ms": 702180,
      "text": "九百多年一条江两岸几百座山被课本写成了，",
      "token_start": 2590,
      "token_end_exclusive": 2609
    },
    {
      "start_ms": 702180,
      "end_ms": 702680,
      "text": "一句话，",
      "token_start": 2609,
      "token_end_exclusive": 2612
    },
    {
      "start_ms": 702740,
      "end_ms": 703755,
      "text": "传了几十年。",
      "token_start": 2612,
      "token_end_exclusive": 2617
    },
    {
      "start_ms": 704260,
      "end_ms": 707765,
      "text": "四百多年前的松树还从石头缝里伸着手，",
      "token_start": 2617,
      "token_end_exclusive": 2634
    },
    {
      "start_ms": 708670,
      "end_ms": 716680,
      "text": "十万平方公里的草原空到脑子里一个念头都存不住黄河收成几十米的口子砸下去，",
      "token_start": 2634,
      "token_end_exclusive": 2669
    },
    {
      "start_ms": 716720,
      "end_ms": 717885,
      "text": "脚底都在抖，",
      "token_start": 2669,
      "token_end_exclusive": 2674
    },
    {
      "start_ms": 718420,
      "end_ms": 722395,
      "text": "一个湖的水干净到能看见十二米深的湖底。",
      "token_start": 2674,
      "token_end_exclusive": 2692
    },
    {
      "start_ms": 723010,
      "end_ms": 727465,
      "text": "一座宫殿蹲在三千七百米的山上蹲了一千三百年。",
      "token_start": 2692,
      "token_end_exclusive": 2713
    },
    {
      "start_ms": 728260,
      "end_ms": 731935,
      "text": "一千七百年的壁画正在一天一天的消失。",
      "token_start": 2713,
      "token_end_exclusive": 2730
    },
    {
      "start_ms": 732620,
      "end_ms": 734360,
      "text": "六百年的宫殿下了雪，",
      "token_start": 2730,
      "token_end_exclusive": 2739
    },
    {
      "start_ms": 734360,
      "end_ms": 735940,
      "text": "谁也复制不了那个画面。",
      "token_start": 2739,
      "token_end_exclusive": 2749
    },
    {
      "start_ms": 736020,
      "end_ms": 738080,
      "text": "六百年前修来打仗的城墙，",
      "token_start": 2749,
      "token_end_exclusive": 2760
    },
    {
      "start_ms": 738120,
      "end_ms": 739440,
      "text": "今天还站在山脊上，",
      "token_start": 2760,
      "token_end_exclusive": 2768
    },
    {
      "start_ms": 739440,
      "end_ms": 742915,
      "text": "没有人修他这十个地方加一块儿。",
      "token_start": 2768,
      "token_end_exclusive": 2782
    },
    {
      "start_ms": 743580,
      "end_ms": 745525,
      "text": "您说最值得去的是什么？",
      "token_start": 2782,
      "token_end_exclusive": 2792
    },
    {
      "start_ms": 746360,
      "end_ms": 748915,
      "text": "我觉得不是哪个地方最好看、最有名，",
      "token_start": 2792,
      "token_end_exclusive": 2807
    },
    {
      "start_ms": 749490,
      "end_ms": 751785,
      "text": "而是这些地方都不等人。",
      "token_start": 2807,
      "token_end_exclusive": 2817
    },
    {
      "start_ms": 752140,
      "end_ms": 753360,
      "text": "壁画在褪色，",
      "token_start": 2817,
      "token_end_exclusive": 2822
    },
    {
      "start_ms": 753660,
      "end_ms": 756130,
      "text": "城砖在风化苏油灯，",
      "token_start": 2822,
      "token_end_exclusive": 2830
    },
    {
      "start_ms": 756210,
      "end_ms": 758560,
      "text": "不知道还能续几代云海，",
      "token_start": 2830,
      "token_end_exclusive": 2840
    },
    {
      "start_ms": 758560,
      "end_ms": 762000,
      "text": "不知道明天早上还有没有这些东西，",
      "token_start": 2840,
      "token_end_exclusive": 2855
    },
    {
      "start_ms": 762020,
      "end_ms": 762400,
      "text": "不会，",
      "token_start": 2855,
      "token_end_exclusive": 2857
    },
    {
      "start_ms": 762420,
      "end_ms": 764935,
      "text": "因为您还没去就停在那等着，",
      "token_start": 2857,
      "token_end_exclusive": 2869
    },
    {
      "start_ms": 765320,
      "end_ms": 766495,
      "text": "趁还走得动，",
      "token_start": 2869,
      "token_end_exclusive": 2874
    },
    {
      "start_ms": 767190,
      "end_ms": 769110,
      "text": "趁想去的时候腿脚还利索，",
      "token_start": 2874,
      "token_end_exclusive": 2885
    },
    {
      "start_ms": 769130,
      "end_ms": 770165,
      "text": "别光收藏了，",
      "token_start": 2885,
      "token_end_exclusive": 2890
    },
    {
      "start_ms": 771210,
      "end_ms": 776550,
      "text": "想出发之前先把这些地方看明白的那本大美中国的链接，",
      "token_start": 2890,
      "token_end_exclusive": 2914
    },
    {
      "start_ms": 776550,
      "end_ms": 777995,
      "text": "我放在左下角了，",
      "token_start": 2914,
      "token_end_exclusive": 2921
    },
    {
      "start_ms": 778740,
      "end_ms": 779720,
      "text": "觉得有意思的话，",
      "token_start": 2921,
      "token_end_exclusive": 2928
    },
    {
      "start_ms": 779720,
      "end_ms": 781000,
      "text": "帮忙点个赞同时，",
      "token_start": 2928,
      "token_end_exclusive": 2935
    },
    {
      "start_ms": 781000,
      "end_ms": 781620,
      "text": "转发给你，",
      "token_start": 2935,
      "token_end_exclusive": 2939
    },
    {
      "start_ms": 781620,
      "end_ms": 783635,
      "text": "想一起去看看风景的那个人。",
      "token_start": 2939,
      "token_end_exclusive": 2951
    },
    {
      "start_ms": 784220,
      "end_ms": 785685,
      "text": "咱们下一期接着聊。",
      "token_start": 2951,
      "token_end_exclusive": 2959
    }
  ],
  "checks": {
    "text_reconstructed_exactly": true,
    "token_count_equal": true,
