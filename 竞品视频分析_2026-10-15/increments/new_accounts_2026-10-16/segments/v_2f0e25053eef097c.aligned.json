{
  "video_id": "v_2f0e25053eef097c",
  "duration_s": 446.310998,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_2f0e25053eef097c.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_2f0e25053eef097c.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 500,
      "end_ms": 1380,
      "text": "你敢相信吗？",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1960,
      "end_ms": 6820,
      "text": "全世界最会赚钱的潮汕人最厉害的本事不是长大后才学的，",
      "token_start": 5,
      "token_end_exclusive": 30
    },
    {
      "start_ms": 7040,
      "end_ms": 9560,
      "text": "而是从小孩子时候就种进脑子里的。",
      "token_start": 30,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 9580,
      "end_ms": 12560,
      "text": "很多人以为潮汕人天生会做生意错了，",
      "token_start": 45,
      "token_end_exclusive": 61
    },
    {
      "start_ms": 12960,
      "end_ms": 14900,
      "text": "他们只是从小听从小看，",
      "token_start": 61,
      "token_end_exclusive": 71
    },
    {
      "start_ms": 15080,
      "end_ms": 17880,
      "text": "从小练别人家孩子背唐诗潮汕，",
      "token_start": 71,
      "token_end_exclusive": 84
    },
    {
      "start_ms": 17880,
      "end_ms": 20160,
      "text": "孩子在茶盘边听大人谈生意。",
      "token_start": 84,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 20600,
      "end_ms": 21840,
      "text": "别人家孩子刷奥数，",
      "token_start": 96,
      "token_end_exclusive": 104
    },
    {
      "start_ms": 22120,
      "end_ms": 22500,
      "text": "潮汕，",
      "token_start": 104,
      "token_end_exclusive": 106
    },
    {
      "start_ms": 22500,
      "end_ms": 23860,
      "text": "孩子在铺头里学算账。",
      "token_start": 106,
      "token_end_exclusive": 115
    },
    {
      "start_ms": 23960,
      "end_ms": 25780,
      "text": "别人家孩子伸手要零花钱，",
      "token_start": 115,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 26200,
      "end_ms": 27640,
      "text": "潮汕孩子已经在想，",
      "token_start": 126,
      "token_end_exclusive": 134
    },
    {
      "start_ms": 27780,
      "end_ms": 29100,
      "text": "这包辣条怎么转手？",
      "token_start": 134,
      "token_end_exclusive": 142
    },
    {
      "start_ms": 29100,
      "end_ms": 31910,
      "text": "卖出去这套东西过去不外传，",
      "token_start": 142,
      "token_end_exclusive": 154
    },
    {
      "start_ms": 32390,
      "end_ms": 34430,
      "text": "现在有人把它写成了一本书，",
      "token_start": 154,
      "token_end_exclusive": 166
    },
    {
      "start_ms": 34730,
      "end_ms": 36230,
      "text": "叫潮汕思维。",
      "token_start": 166,
      "token_end_exclusive": 171
    },
    {
      "start_ms": 36330,
      "end_ms": 38570,
      "text": "但我今天要把话说透这本书，",
      "token_start": 171,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 38950,
      "end_ms": 40290,
      "text": "最该读的不是老板，",
      "token_start": 183,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 40470,
      "end_ms": 41430,
      "text": "不是创业者，",
      "token_start": 191,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 41650,
      "end_ms": 42630,
      "text": "不是成年人，",
      "token_start": 196,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 42930,
      "end_ms": 44010,
      "text": "而是小孩子。",
      "token_start": 201,
      "token_end_exclusive": 206
    },
    {
      "start_ms": 44330,
      "end_ms": 45330,
      "text": "对你没听错，",
      "token_start": 206,
      "token_end_exclusive": 211
    },
    {
      "start_ms": 45370,
      "end_ms": 46290,
      "text": "就是小孩子。",
      "token_start": 211,
      "token_end_exclusive": 216
    },
    {
      "start_ms": 46530,
      "end_ms": 48850,
      "text": "如果你家里有三岁到十五岁的孩子，",
      "token_start": 216,
      "token_end_exclusive": 231
    },
    {
      "start_ms": 48990,
      "end_ms": 50650,
      "text": "尤其六到十二岁的小学生，",
      "token_start": 231,
      "token_end_exclusive": 242
    },
    {
      "start_ms": 51010,
      "end_ms": 53150,
      "text": "你一定要让他从小接触这套思维。",
      "token_start": 242,
      "token_end_exclusive": 256
    },
    {
      "start_ms": 53630,
      "end_ms": 55010,
      "text": "因为学校教知识，",
      "token_start": 256,
      "token_end_exclusive": 263
    },
    {
      "start_ms": 55290,
      "end_ms": 56090,
      "text": "不教赚钱，",
      "token_start": 263,
      "token_end_exclusive": 267
    },
    {
      "start_ms": 56650,
      "end_ms": 58850,
      "text": "老师教考试不教生存。",
      "token_start": 267,
      "token_end_exclusive": 276
    },
    {
      "start_ms": 59570,
      "end_ms": 62280,
      "text": "你社会这所大学迟早会考他，",
      "token_start": 276,
      "token_end_exclusive": 288
    },
    {
      "start_ms": 62380,
      "end_ms": 63320,
      "text": "等到他大学毕业，",
      "token_start": 288,
      "token_end_exclusive": 295
    },
    {
      "start_ms": 63320,
      "end_ms": 65065,
      "text": "才学财商已经晚了，",
      "token_start": 295,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 65650,
      "end_ms": 66790,
      "text": "等到他被社会毒打，",
      "token_start": 303,
      "token_end_exclusive": 311
    },
    {
      "start_ms": 66870,
      "end_ms": 67850,
      "text": "才懂人情世故，",
      "token_start": 311,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 68010,
      "end_ms": 68905,
      "text": "代价太大，",
      "token_start": 317,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 69190,
      "end_ms": 70435,
      "text": "潮汕人为什么厉害？",
      "token_start": 321,
      "token_end_exclusive": 329
    },
    {
      "start_ms": 70910,
      "end_ms": 72815,
      "text": "因为他们把财商教育提前了，",
      "token_start": 329,
      "token_end_exclusive": 341
    },
    {
      "start_ms": 73320,
      "end_ms": 74375,
      "text": "提前到饭桌上，",
      "token_start": 341,
      "token_end_exclusive": 347
    },
    {
      "start_ms": 74670,
      "end_ms": 75630,
      "text": "提前到茶盘边，",
      "token_start": 347,
      "token_end_exclusive": 353
    },
    {
      "start_ms": 75910,
      "end_ms": 77685,
      "text": "提前到小孩子的眼睛里。",
      "token_start": 353,
      "token_end_exclusive": 363
    },
    {
      "start_ms": 78010,
      "end_ms": 80495,
      "text": "一个潮汕小孩儿可能还没认全字儿，",
      "token_start": 363,
      "token_end_exclusive": 378
    },
    {
      "start_ms": 80670,
      "end_ms": 82075,
      "text": "就知道钱不能乱花，",
      "token_start": 378,
      "token_end_exclusive": 386
    },
    {
      "start_ms": 82450,
      "end_ms": 83750,
      "text": "要知道钱从哪里来，",
      "token_start": 386,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 84150,
      "end_ms": 85655,
      "text": "要算钱到哪里去。",
      "token_start": 394,
      "token_end_exclusive": 401
    },
    {
      "start_ms": 86040,
      "end_ms": 88340,
      "text": "一个潮汕小孩可能还在读小学，",
      "token_start": 401,
      "token_end_exclusive": 414
    },
    {
      "start_ms": 88580,
      "end_ms": 90605,
      "text": "就被大人带着去市场看行情，",
      "token_start": 414,
      "token_end_exclusive": 426
    },
    {
      "start_ms": 90940,
      "end_ms": 91980,
      "text": "去店铺看人流，",
      "token_start": 426,
      "token_end_exclusive": 432
    },
    {
      "start_ms": 92300,
      "end_ms": 93675,
      "text": "去和陌生人打招呼。",
      "token_start": 432,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 94190,
      "end_ms": 100795,
      "text": "一个潮汕小孩可能十几岁就敢在暑假摆摊进货、算账、找零招呼客人。",
      "token_start": 440,
      "token_end_exclusive": 468
    },
    {
      "start_ms": 101690,
      "end_ms": 103465,
      "text": "这不是穷人的孩子早当家，",
      "token_start": 468,
      "token_end_exclusive": 479
    },
    {
      "start_ms": 103860,
      "end_ms": 107070,
      "text": "这是潮汕人的孩子早开窍潮汕思维。",
      "token_start": 479,
      "token_end_exclusive": 494
    },
    {
      "start_ms": 107070,
      "end_ms": 111500,
      "text": "这本书第一次把这套从小开窍的方法用小孩子也能听懂的。",
      "token_start": 494,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 111500,
      "end_ms": 112865,
      "text": "大白话写了出来，",
      "token_start": 519,
      "token_end_exclusive": 526
    },
    {
      "start_ms": 113070,
      "end_ms": 114295,
      "text": "他没有玄乎的理论，",
      "token_start": 526,
      "token_end_exclusive": 534
    },
    {
      "start_ms": 114620,
      "end_ms": 115705,
      "text": "没有吓人的术语，",
      "token_start": 534,
      "token_end_exclusive": 541
    },
    {
      "start_ms": 116040,
      "end_ms": 117605,
      "text": "没有只给大人看的成功学。",
      "token_start": 541,
      "token_end_exclusive": 552
    },
    {
      "start_ms": 117960,
      "end_ms": 122215,
      "text": "他讲的是怎么让孩子明白钱不是天上掉下来的，",
      "token_start": 552,
      "token_end_exclusive": 572
    },
    {
      "start_ms": 122610,
      "end_ms": 125985,
      "text": "怎么让孩子知道便宜货和好生意区别在哪儿？",
      "token_start": 572,
      "token_end_exclusive": 591
    },
    {
      "start_ms": 126420,
      "end_ms": 128675,
      "text": "怎么让孩子学会先做人再做事？",
      "token_start": 591,
      "token_end_exclusive": 604
    },
    {
      "start_ms": 129040,
      "end_ms": 130895,
      "text": "怎么让孩子遇到困难不哭鼻子，",
      "token_start": 604,
      "token_end_exclusive": 617
    },
    {
      "start_ms": 131110,
      "end_ms": 132045,
      "text": "而是想办法。",
      "token_start": 617,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 132480,
      "end_ms": 134580,
      "text": "怎么让孩子从小有老板思维，",
      "token_start": 622,
      "token_end_exclusive": 634
    },
    {
      "start_ms": 134660,
      "end_ms": 136415,
      "text": "而不是一辈子打工思维？",
      "token_start": 634,
      "token_end_exclusive": 644
    },
    {
      "start_ms": 137090,
      "end_ms": 138005,
      "text": "书里有一句话，",
      "token_start": 644,
      "token_end_exclusive": 650
    },
    {
      "start_ms": 138380,
      "end_ms": 140450,
      "text": "特别适合给孩子看工字，",
      "token_start": 650,
      "token_end_exclusive": 660
    },
    {
      "start_ms": 140550,
      "end_ms": 141335,
      "text": "不出头，",
      "token_start": 660,
      "token_end_exclusive": 663
    },
    {
      "start_ms": 141830,
      "end_ms": 142630,
      "text": "打工不是错，",
      "token_start": 663,
      "token_end_exclusive": 668
    },
    {
      "start_ms": 142890,
      "end_ms": 146090,
      "text": "但只会打工一辈子被人拿捏潮汕人，",
      "token_start": 668,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 146090,
      "end_ms": 148145,
      "text": "宁可睡地板也要当老板，",
      "token_start": 683,
      "token_end_exclusive": 693
    },
    {
      "start_ms": 148820,
      "end_ms": 150085,
      "text": "不是因为他们爱吃苦，",
      "token_start": 693,
      "token_end_exclusive": 702
    },
    {
      "start_ms": 150610,
      "end_ms": 154120,
      "text": "而是他们从小就知道命运要握在自己手里。",
      "token_start": 702,
      "token_end_exclusive": 720
    },
    {
      "start_ms": 154200,
      "end_ms": 155025,
      "text": "还有一句话，",
      "token_start": 720,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 155360,
      "end_ms": 156975,
      "text": "父母一定要替孩子记住，",
      "token_start": 725,
      "token_end_exclusive": 735
    },
    {
      "start_ms": 157440,
      "end_ms": 158180,
      "text": "算盘要打，",
      "token_start": 735,
      "token_end_exclusive": 739
    },
    {
      "start_ms": 158180,
      "end_ms": 160200,
      "text": "穿人情要留香，",
      "token_start": 739,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 160400,
      "end_ms": 161380,
      "text": "孩子成绩再好，",
      "token_start": 745,
      "token_end_exclusive": 751
    },
    {
      "start_ms": 161620,
      "end_ms": 162500,
      "text": "如果不会做人，",
      "token_start": 751,
      "token_end_exclusive": 757
    },
    {
      "start_ms": 162760,
      "end_ms": 163605,
      "text": "不会合作，",
      "token_start": 757,
      "token_end_exclusive": 761
    },
    {
      "start_ms": 163900,
      "end_ms": 164760,
      "text": "不会交朋友，",
      "token_start": 761,
      "token_end_exclusive": 766
    },
    {
      "start_ms": 165000,
      "end_ms": 166515,
      "text": "长大照样吃大亏。",
      "token_start": 766,
      "token_end_exclusive": 773
    },
    {
      "start_ms": 166810,
      "end_ms": 167710,
      "text": "潮汕人谈生意，",
      "token_start": 773,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 167710,
      "end_ms": 170320,
      "text": "为什么爱喝茶那杯茶不是茶，",
      "token_start": 779,
      "token_end_exclusive": 791
    },
    {
      "start_ms": 170560,
      "end_ms": 171260,
      "text": "是人情，",
      "token_start": 791,
      "token_end_exclusive": 794
    },
    {
      "start_ms": 171440,
      "end_ms": 172135,
      "text": "是分寸，",
      "token_start": 794,
      "token_end_exclusive": 797
    },
    {
      "start_ms": 172480,
      "end_ms": 173700,
      "text": "是给别人留余地，",
      "token_start": 797,
      "token_end_exclusive": 804
    },
    {
      "start_ms": 173860,
      "end_ms": 175180,
      "text": "也是给自己留后路。",
      "token_start": 804,
      "token_end_exclusive": 812
    },
    {
      "start_ms": 175560,
      "end_ms": 177225,
      "text": "小孩子从小懂这些，",
      "token_start": 812,
      "token_end_exclusive": 820
    },
    {
      "start_ms": 177560,
      "end_ms": 179185,
      "text": "长大少走十年弯路，",
      "token_start": 820,
      "token_end_exclusive": 828
    },
    {
      "start_ms": 179840,
      "end_ms": 182260,
      "text": "你知道潮汕人为什么能富过三代吗？",
      "token_start": 828,
      "token_end_exclusive": 843
    },
    {
      "start_ms": 182620,
      "end_ms": 184540,
      "text": "因为他们不教孩子一夜暴富，",
      "token_start": 843,
      "token_end_exclusive": 855
    },
    {
      "start_ms": 184920,
      "end_ms": 187300,
      "text": "只教孩子铜钱出苦坑，",
      "token_start": 855,
      "token_end_exclusive": 864
    },
    {
      "start_ms": 187660,
      "end_ms": 188780,
      "text": "富贵在凶冕，",
      "token_start": 864,
      "token_end_exclusive": 869
    },
    {
      "start_ms": 188860,
      "end_ms": 190640,
      "text": "让孩子知道钱难赚，",
      "token_start": 869,
      "token_end_exclusive": 877
    },
    {
      "start_ms": 190880,
      "end_ms": 193340,
      "text": "才懂得珍惜生意有起落，",
      "token_start": 877,
      "token_end_exclusive": 887
    },
    {
      "start_ms": 193700,
      "end_ms": 194660,
      "text": "才学会扛试。",
      "token_start": 887,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 194820,
      "end_ms": 196440,
      "text": "从小听过这些话的孩子，",
      "token_start": 892,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 196760,
      "end_ms": 198060,
      "text": "骨子里就多一根筋，",
      "token_start": 902,
      "token_end_exclusive": 910
    },
    {
      "start_ms": 198460,
      "end_ms": 199080,
      "text": "不怕慢，",
      "token_start": 910,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 199480,
      "end_ms": 200100,
      "text": "就怕战，",
      "token_start": 913,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 200480,
      "end_ms": 201060,
      "text": "不怕穷，",
      "token_start": 916,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 201360,
      "end_ms": 203040,
      "text": "就怕懒不怕输，",
      "token_start": 919,
      "token_end_exclusive": 925
    },
    {
      "start_ms": 203260,
      "end_ms": 204100,
      "text": "就怕不敢试。",
      "token_start": 925,
      "token_end_exclusive": 930
    },
    {
      "start_ms": 204580,
      "end_ms": 209020,
      "text": "这本书最厉害的地方是他把潮汕人五百年验证过的实战方法，",
      "token_start": 930,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 209200,
      "end_ms": 210150,
      "text": "一天条一条，",
      "token_start": 956,
      "token_end_exclusive": 961
    },
    {
      "start_ms": 210150,
      "end_ms": 212630,
      "text": "拆开变成小孩子也能用的东西。",
      "token_start": 961,
      "token_end_exclusive": 974
    },
    {
      "start_ms": 213050,
      "end_ms": 215390,
      "text": "比如怎么让孩子学会记账，",
      "token_start": 974,
      "token_end_exclusive": 985
    },
    {
      "start_ms": 215650,
      "end_ms": 217010,
      "text": "不是逼他写流水账，",
      "token_start": 985,
      "token_end_exclusive": 993
    },
    {
      "start_ms": 217310,
      "end_ms": 219330,
      "text": "而是让他管一周家庭买菜，",
      "token_start": 993,
      "token_end_exclusive": 1004
    },
    {
      "start_ms": 219330,
      "end_ms": 221190,
      "text": "钱超支了自己想办法。",
      "token_start": 1004,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 221510,
      "end_ms": 221970,
      "text": "比如，",
      "token_start": 1013,
      "token_end_exclusive": 1015
    },
    {
      "start_ms": 222470,
      "end_ms": 223950,
      "text": "怎么让孩子学会谈判，",
      "token_start": 1015,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 224610,
      "end_ms": 225670,
      "text": "而是教他吵架，",
      "token_start": 1024,
      "token_end_exclusive": 1030
    },
    {
      "start_ms": 226030,
      "end_ms": 227590,
      "text": "而是让他去市场问价，",
      "token_start": 1030,
      "token_end_exclusive": 1039
    },
    {
      "start_ms": 227770,
      "end_ms": 229090,
      "text": "比价砍价。",
      "token_start": 1039,
      "token_end_exclusive": 1043
    },
    {
      "start_ms": 229710,
      "end_ms": 230170,
      "text": "比如，",
      "token_start": 1043,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 230590,
      "end_ms": 232430,
      "text": "怎么让孩子学会发现商机，",
      "token_start": 1045,
      "token_end_exclusive": 1056
    },
    {
      "start_ms": 233270,
      "end_ms": 234710,
      "text": "不是让他天天刷手机，",
      "token_start": 1056,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 235190,
      "end_ms": 238750,
      "text": "而是带他观察学校门口为什么这家店排队，",
      "token_start": 1065,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 238750,
      "end_ms": 240265,
      "text": "那家有点没人。",
      "token_start": 1083,
      "token_end_exclusive": 1089
    },
    {
      "start_ms": 240540,
      "end_ms": 240955,
      "text": "比如，",
      "token_start": 1089,
      "token_end_exclusive": 1091
    },
    {
      "start_ms": 241360,
      "end_ms": 242985,
      "text": "怎么让孩子学会承担风险，",
      "token_start": 1091,
      "token_end_exclusive": 1102
    },
    {
      "start_ms": 243630,
      "end_ms": 245225,
      "text": "不是给他一大笔钱乱花，",
      "token_start": 1102,
      "token_end_exclusive": 1112
    },
    {
      "start_ms": 245540,
      "end_ms": 246895,
      "text": "而是给他五十块本钱，",
      "token_start": 1112,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 247230,
      "end_ms": 249795,
      "text": "让他自己决定进什么货卖什么价，",
      "token_start": 1121,
      "token_end_exclusive": 1135
    },
    {
      "start_ms": 250020,
      "end_ms": 250725,
      "text": "亏了怎么办？",
      "token_start": 1135,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 251180,
      "end_ms": 253025,
      "text": "这些方法书里都有，",
      "token_start": 1140,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 253420,
      "end_ms": 254120,
      "text": "不是空话，",
      "token_start": 1148,
      "token_end_exclusive": 1152
    },
    {
      "start_ms": 254320,
      "end_ms": 255380,
      "text": "是能直接用的。",
      "token_start": 1152,
      "token_end_exclusive": 1158
    },
    {
      "start_ms": 255440,
      "end_ms": 257440,
      "text": "如果你家孩子现在只会伸手要钱，",
      "token_start": 1158,
      "token_end_exclusive": 1172
    },
    {
      "start_ms": 257820,
      "end_ms": 258860,
      "text": "不知道钱怎么来，",
      "token_start": 1172,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 259240,
      "end_ms": 260535,
      "text": "你一定要给他读。",
      "token_start": 1179,
      "token_end_exclusive": 1186
    },
    {
      "start_ms": 261020,
      "end_ms": 262460,
      "text": "如果你家孩子成绩很好，",
      "token_start": 1186,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 262700,
      "end_ms": 264215,
      "text": "但一遇到陌生人就躲，",
      "token_start": 1196,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 264760,
      "end_ms": 265885,
      "text": "你一定要给他读。",
      "token_start": 1205,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 266410,
      "end_ms": 268135,
      "text": "如果你家孩子被保护的太好，",
      "token_start": 1212,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 268480,
      "end_ms": 270380,
      "text": "一点委屈都受不了你，",
      "token_start": 1224,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 270380,
      "end_ms": 271125,
      "text": "一定要给他。",
      "token_start": 1233,
      "token_end_exclusive": 1238
    },
    {
      "start_ms": 272100,
      "end_ms": 273885,
      "text": "如果你家孩子整天抱着手机，",
      "token_start": 1238,
      "token_end_exclusive": 1250
    },
    {
      "start_ms": 274240,
      "end_ms": 275925,
      "text": "不知道现实世界怎么运转，",
      "token_start": 1250,
      "token_end_exclusive": 1261
    },
    {
      "start_ms": 276300,
      "end_ms": 277375,
      "text": "你一定要给他读。",
      "token_start": 1261,
      "token_end_exclusive": 1268
    },
    {
      "start_ms": 278190,
      "end_ms": 279850,
      "text": "如果你不想让孩子长大以后，",
      "token_start": 1268,
      "token_end_exclusive": 1280
    },
    {
      "start_ms": 280050,
      "end_ms": 281630,
      "text": "只会刷题考试，",
      "token_start": 1280,
      "token_end_exclusive": 1286
    },
    {
      "start_ms": 281830,
      "end_ms": 283945,
      "text": "投简历被老板挑来挑去，",
      "token_start": 1286,
      "token_end_exclusive": 1296
    },
    {
      "start_ms": 284350,
      "end_ms": 285465,
      "text": "你更要给他读。",
      "token_start": 1296,
      "token_end_exclusive": 1302
    },
    {
      "start_ms": 286190,
      "end_ms": 287725,
      "text": "为什么一定要是小孩子？",
      "token_start": 1302,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 288520,
      "end_ms": 290415,
      "text": "因为成年人的思维已经定型，",
      "token_start": 1312,
      "token_end_exclusive": 1324
    },
    {
      "start_ms": 290790,
      "end_ms": 291845,
      "text": "改起来像拔牙。",
      "token_start": 1324,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 292340,
      "end_ms": 294365,
      "text": "小孩子的脑子像一张白纸，",
      "token_start": 1330,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 294790,
      "end_ms": 296065,
      "text": "画什么就是什么。",
      "token_start": 1341,
      "token_end_exclusive": 1348
    },
    {
      "start_ms": 296430,
      "end_ms": 298110,
      "text": "你从小给他种下打工思维，",
      "token_start": 1348,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 298310,
      "end_ms": 299735,
      "text": "他长大就只会等工资。",
      "token_start": 1359,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 300410,
      "end_ms": 302230,
      "text": "你从小给他种下老板思维，",
      "token_start": 1368,
      "token_end_exclusive": 1379
    },
    {
      "start_ms": 302450,
      "end_ms": 304150,
      "text": "他长大就敢看机会，",
      "token_start": 1379,
      "token_end_exclusive": 1387
    },
    {
      "start_ms": 304330,
      "end_ms": 305230,
      "text": "敢算成本，",
      "token_start": 1387,
      "token_end_exclusive": 1391
    },
    {
      "start_ms": 305370,
      "end_ms": 306310,
      "text": "敢找人合作，",
      "token_start": 1391,
      "token_end_exclusive": 1396
    },
    {
      "start_ms": 306510,
      "end_ms": 307510,
      "text": "敢为自己负责。",
      "token_start": 1396,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 307910,
      "end_ms": 310250,
      "text": "潮汕思维不是让孩子变成小财迷，",
      "token_start": 1402,
      "token_end_exclusive": 1416
    },
    {
      "start_ms": 310570,
      "end_ms": 311990,
      "text": "他是让孩子从小明白，",
      "token_start": 1416,
      "token_end_exclusive": 1425
    },
    {
      "start_ms": 312290,
      "end_ms": 313190,
      "text": "钱是工具，",
      "token_start": 1425,
      "token_end_exclusive": 1429
    },
    {
      "start_ms": 313470,
      "end_ms": 314270,
      "text": "不是目的，",
      "token_start": 1429,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 314670,
      "end_ms": 315690,
      "text": "生意是游戏，",
      "token_start": 1433,
      "token_end_exclusive": 1438
    },
    {
      "start_ms": 315970,
      "end_ms": 316770,
      "text": "也是修行。",
      "token_start": 1438,
      "token_end_exclusive": 1442
    },
    {
      "start_ms": 317290,
      "end_ms": 318390,
      "text": "做人要厚道，",
      "token_start": 1442,
      "token_end_exclusive": 1447
    },
    {
      "start_ms": 318570,
      "end_ms": 319650,
      "text": "做事要精明，",
      "token_start": 1447,
      "token_end_exclusive": 1452
    },
    {
      "start_ms": 319770,
      "end_ms": 321750,
      "text": "他给孩子的不只是赚钱的方法，",
      "token_start": 1452,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 322070,
      "end_ms": 323290,
      "text": "更是一套看世界，",
      "token_start": 1465,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 323450,
      "end_ms": 324130,
      "text": "看人性，",
      "token_start": 1472,
      "token_end_exclusive": 1475
    },
    {
      "start_ms": 324390,
      "end_ms": 325930,
      "text": "看自己的底层思维。",
      "token_start": 1475,
      "token_end_exclusive": 1483
    },
    {
      "start_ms": 326250,
      "end_ms": 327790,
      "text": "但我要说一句更狠的话，",
      "token_start": 1483,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 328610,
      "end_ms": 331820,
      "text": "光给孩子读一本潮汕思维还不够，",
      "token_start": 1493,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 332660,
      "end_ms": 334040,
      "text": "因为小孩子学思维，",
      "token_start": 1507,
      "token_end_exclusive": 1515
    },
    {
      "start_ms": 334340,
      "end_ms": 335540,
      "text": "父母要学破局，",
      "token_start": 1515,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 336200,
      "end_ms": 337280,
      "text": "孩子负责开窍，",
      "token_start": 1521,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 337760,
      "end_ms": 338940,
      "text": "父母负责铺路，",
      "token_start": 1527,
      "token_end_exclusive": 1533
    },
    {
      "start_ms": 339540,
      "end_ms": 340560,
      "text": "孩子学怎么想？",
      "token_start": 1533,
      "token_end_exclusive": 1539
    },
    {
      "start_ms": 341260,
      "end_ms": 342360,
      "text": "父母学怎么做？",
      "token_start": 1539,
      "token_end_exclusive": 1545
    },
    {
      "start_ms": 342400,
      "end_ms": 347260,
      "text": "所以我强烈建议你把潮汕思维和时局控局破局一起带回家，",
      "token_start": 1545,
      "token_end_exclusive": 1570
    },
    {
      "start_ms": 347500,
      "end_ms": 349960,
      "text": "组成一套亲子财商共读套装。",
      "token_start": 1570,
      "token_end_exclusive": 1582
    },
    {
      "start_ms": 351060,
      "end_ms": 352760,
      "text": "潮汕思维给孩子打底，",
      "token_start": 1582,
      "token_end_exclusive": 1591
    },
    {
      "start_ms": 353260,
      "end_ms": 356960,
      "text": "从小建立正确的金钱观生意观、人情观。",
      "token_start": 1591,
      "token_end_exclusive": 1607
    },
    {
      "start_ms": 358200,
      "end_ms": 361165,
      "text": "时局控局破局给父母升级，",
      "token_start": 1607,
      "token_end_exclusive": 1618
    },
    {
      "start_ms": 361810,
      "end_ms": 365495,
      "text": "教你在复杂环境里看局控局破局，",
      "token_start": 1618,
      "token_end_exclusive": 1632
    },
    {
      "start_ms": 365830,
      "end_ms": 367635,
      "text": "给孩子撑起更大的空间。",
      "token_start": 1632,
      "token_end_exclusive": 1642
    },
    {
      "start_ms": 368070,
      "end_ms": 369230,
      "text": "孩子读潮汕思维，",
      "token_start": 1642,
      "token_end_exclusive": 1649
    },
    {
      "start_ms": 369570,
      "end_ms": 370775,
      "text": "知道以后怎么走。",
      "token_start": 1649,
      "token_end_exclusive": 1656
    },
    {
      "start_ms": 371200,
      "end_ms": 373580,
      "text": "父母读十局控局破局，",
      "token_start": 1656,
      "token_end_exclusive": 1665
    },
    {
      "start_ms": 373940,
      "end_ms": 376565,
      "text": "直到现在怎么带两本一起读？",
      "token_start": 1665,
      "token_end_exclusive": 1677
    },
    {
      "start_ms": 376970,
      "end_ms": 378185,
      "text": "孩子少走弯路，",
      "token_start": 1677,
      "token_end_exclusive": 1683
    },
    {
      "start_ms": 378570,
      "end_ms": 379585,
      "text": "父母少踩坑，",
      "token_start": 1683,
      "token_end_exclusive": 1688
    },
    {
      "start_ms": 380100,
      "end_ms": 380735,
      "text": "一套书，",
      "token_start": 1688,
      "token_end_exclusive": 1691
    },
    {
      "start_ms": 381070,
      "end_ms": 383065,
      "text": "两代人一起开窍。",
      "token_start": 1691,
      "token_end_exclusive": 1698
    },
    {
      "start_ms": 384180,
      "end_ms": 385295,
      "text": "这本书适合谁？",
      "token_start": 1698,
      "token_end_exclusive": 1704
    },
    {
      "start_ms": 386150,
      "end_ms": 387310,
      "text": "适合三到十五岁？",
      "token_start": 1704,
      "token_end_exclusive": 1711
    },
    {
      "start_ms": 387310,
      "end_ms": 391985,
      "text": "孩子的父母适合幼儿园大班、小学生、初中生，",
      "token_start": 1711,
      "token_end_exclusive": 1729
    },
    {
      "start_ms": 392410,
      "end_ms": 394555,
      "text": "适合想给孩子做财商启蒙的家庭，",
      "token_start": 1729,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 394920,
      "end_ms": 398225,
      "text": "适合不想让孩子长大后被社会毒打才醒悟的父母。",
      "token_start": 1743,
      "token_end_exclusive": 1764
    },
    {
      "start_ms": 398570,
      "end_ms": 400555,
      "text": "哪怕孩子现在只认识几百个字，",
      "token_start": 1764,
      "token_end_exclusive": 1777
    },
    {
      "start_ms": 401030,
      "end_ms": 401995,
      "text": "你读给他听，",
      "token_start": 1777,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 402310,
      "end_ms": 403205,
      "text": "他也能听懂。",
      "token_start": 1782,
      "token_end_exclusive": 1787
    },
    {
      "start_ms": 403900,
      "end_ms": 405325,
      "text": "哪怕你自己不懂生意，",
      "token_start": 1787,
      "token_end_exclusive": 1796
    },
    {
      "start_ms": 405580,
      "end_ms": 407140,
      "text": "你照着书里的方法陪他练，",
      "token_start": 1796,
      "token_end_exclusive": 1807
    },
    {
      "start_ms": 407460,
      "end_ms": 409005,
      "text": "他也能一点点开窍。",
      "token_start": 1807,
      "token_end_exclusive": 1815
    },
    {
      "start_ms": 410180,
      "end_ms": 411245,
      "text": "链接就在下方，",
      "token_start": 1815,
      "token_end_exclusive": 1821
    },
    {
      "start_ms": 412010,
      "end_ms": 413525,
      "text": "别等孩子长大才后悔。",
      "token_start": 1821,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 414010,
      "end_ms": 415575,
      "text": "别等社会替你教育他，",
      "token_start": 1830,
      "token_end_exclusive": 1839
    },
    {
      "start_ms": 416030,
      "end_ms": 417085,
      "text": "你给孩子留钱，",
      "token_start": 1839,
      "token_end_exclusive": 1845
    },
    {
      "start_ms": 417510,
      "end_ms": 419130,
      "text": "不如给孩子留一颗会赚钱。",
      "token_start": 1845,
      "token_end_exclusive": 1856
    },
    {
      "start_ms": 419350,
      "end_ms": 419970,
      "text": "会做人，",
      "token_start": 1856,
      "token_end_exclusive": 1859
    },
    {
      "start_ms": 420170,
      "end_ms": 422735,
      "text": "会破局的脑子钱会花完，",
      "token_start": 1859,
      "token_end_exclusive": 1869
    },
    {
      "start_ms": 423210,
      "end_ms": 425475,
      "text": "房子会救车子会贬值，",
      "token_start": 1869,
      "token_end_exclusive": 1878
    },
    {
      "start_ms": 426300,
      "end_ms": 428675,
      "text": "但从小装进脑子里的潮汕思维，",
      "token_start": 1878,
