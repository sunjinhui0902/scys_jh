{
  "video_id": "v_9914a4b5d84ec970",
  "duration_s": 321.572993,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_9914a4b5d84ec970.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_9914a4b5d84ec970.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 310,
      "end_ms": 1830,
      "text": "为什么夺回目光的主权，",
      "token_start": 0,
      "token_end_exclusive": 10
    },
    {
      "start_ms": 1890,
      "end_ms": 4110,
      "text": "是挣脱他人地狱的唯一出路？",
      "token_start": 10,
      "token_end_exclusive": 22
    },
    {
      "start_ms": 4130,
      "end_ms": 6930,
      "text": "萨特在禁闭中提出了一个令人窒息的洞见，",
      "token_start": 22,
      "token_end_exclusive": 40
    },
    {
      "start_ms": 7330,
      "end_ms": 10690,
      "text": "我们终其一生都在他人的凝视中被悄然改写，",
      "token_start": 40,
      "token_end_exclusive": 59
    },
    {
      "start_ms": 10930,
      "end_ms": 12190,
      "text": "却对此浑然不觉。",
      "token_start": 59,
      "token_end_exclusive": 66
    },
    {
      "start_ms": 12510,
      "end_ms": 13210,
      "text": "萨特指出，",
      "token_start": 66,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 13450,
      "end_ms": 17690,
      "text": "在与他人的共存状态下人总是不可避免的陷入客体化的牢笼。",
      "token_start": 70,
      "token_end_exclusive": 96
    },
    {
      "start_ms": 18050,
      "end_ms": 20630,
      "text": "我们顺从于他人目光所铺设的轨道。",
      "token_start": 96,
      "token_end_exclusive": 111
    },
    {
      "start_ms": 20850,
      "end_ms": 22970,
      "text": "按照别人眼中的我去表演，",
      "token_start": 111,
      "token_end_exclusive": 122
    },
    {
      "start_ms": 23090,
      "end_ms": 23790,
      "text": "去讨好，",
      "token_start": 122,
      "token_end_exclusive": 125
    },
    {
      "start_ms": 23970,
      "end_ms": 25650,
      "text": "去维持一个体面的面具，",
      "token_start": 125,
      "token_end_exclusive": 135
    },
    {
      "start_ms": 25730,
      "end_ms": 27210,
      "text": "以为自己在自由的生活。",
      "token_start": 135,
      "token_end_exclusive": 145
    },
    {
      "start_ms": 27530,
      "end_ms": 28230,
      "text": "但实际上，",
      "token_start": 145,
      "token_end_exclusive": 149
    },
    {
      "start_ms": 28290,
      "end_ms": 31180,
      "text": "我们只是把自己活成了一个被他人评价体系，",
      "token_start": 149,
      "token_end_exclusive": 168
    },
    {
      "start_ms": 31360,
      "end_ms": 33160,
      "text": "精密操控的提现木偶。",
      "token_start": 168,
      "token_end_exclusive": 177
    },
    {
      "start_ms": 33480,
      "end_ms": 35500,
      "text": "我们用大家都是这么看的，",
      "token_start": 177,
      "token_end_exclusive": 188
    },
    {
      "start_ms": 35500,
      "end_ms": 36460,
      "text": "来麻痹自己，",
      "token_start": 188,
      "token_end_exclusive": 193
    },
    {
      "start_ms": 36820,
      "end_ms": 40100,
      "text": "把独一无二的主体性稀释成了一场毫无风险，",
      "token_start": 193,
      "token_end_exclusive": 212
    },
    {
      "start_ms": 40320,
      "end_ms": 43160,
      "text": "却也毫无灵魂的他人目光的傀儡室，",
      "token_start": 212,
      "token_end_exclusive": 227
    },
    {
      "start_ms": 43940,
      "end_ms": 47220,
      "text": "而让人彻底陷入这种客体化泥潭的根本原因，",
      "token_start": 227,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 47820,
      "end_ms": 51240,
      "text": "正是我们对他人凝视的系统性、屈服与迎合。",
      "token_start": 246,
      "token_end_exclusive": 264
    },
    {
      "start_ms": 51640,
      "end_ms": 53380,
      "text": "在萨特的独墓剧禁闭中，",
      "token_start": 264,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 53640,
      "end_ms": 56260,
      "text": "三个鬼魂被关进一间没有镜子的密室，",
      "token_start": 274,
      "token_end_exclusive": 290
    },
    {
      "start_ms": 56720,
      "end_ms": 58060,
      "text": "他们本应各自安息，",
      "token_start": 290,
      "token_end_exclusive": 298
    },
    {
      "start_ms": 58340,
      "end_ms": 61695,
      "text": "却在地狱中上演了一场永无终点的相互折磨。",
      "token_start": 298,
      "token_end_exclusive": 317
    },
    {
      "start_ms": 62000,
      "end_ms": 64560,
      "text": "加尔森竭力想让他人相信自己是英雄，",
      "token_start": 317,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 64780,
      "end_ms": 66935,
      "text": "实际上是个临阵脱逃的胆小鬼。",
      "token_start": 333,
      "token_end_exclusive": 346
    },
    {
      "start_ms": 67360,
      "end_ms": 69820,
      "text": "伊内斯试图用锐利的目光刺穿一切，",
      "token_start": 346,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 69820,
      "end_ms": 71260,
      "text": "伪装艾斯，",
      "token_start": 361,
      "token_end_exclusive": 365
    },
    {
      "start_ms": 71260,
      "end_ms": 74625,
      "text": "戴尔则不断用色情引诱来填补空洞的自我。",
      "token_start": 365,
      "token_end_exclusive": 383
    },
    {
      "start_ms": 74960,
      "end_ms": 76005,
      "text": "他们彼此追问，",
      "token_start": 383,
      "token_end_exclusive": 389
    },
    {
      "start_ms": 76240,
      "end_ms": 76920,
      "text": "彼此审判，",
      "token_start": 389,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 77120,
      "end_ms": 77895,
      "text": "彼此定罪。",
      "token_start": 393,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 78460,
      "end_ms": 81715,
      "text": "每个人都把对方当做确认自我存在的唯一镜子，",
      "token_start": 397,
      "token_end_exclusive": 417
    },
    {
      "start_ms": 82210,
      "end_ms": 85475,
      "text": "却在对方的注视中一步步失去了最后的自由。",
      "token_start": 417,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 85810,
      "end_ms": 88305,
      "text": "萨特揭穿了这种人际关系的防御机制，",
      "token_start": 436,
      "token_end_exclusive": 452
    },
    {
      "start_ms": 88940,
      "end_ms": 91420,
      "text": "他人的目光被我们悄悄降格为一面，",
      "token_start": 452,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 91420,
      "end_ms": 93115,
      "text": "可以随意操控的镜子。",
      "token_start": 467,
      "token_end_exclusive": 476
    },
    {
      "start_ms": 93490,
      "end_ms": 94865,
      "text": "我只要表演的足够好，",
      "token_start": 476,
      "token_end_exclusive": 485
    },
    {
      "start_ms": 95190,
      "end_ms": 96295,
      "text": "别人就会认可我，",
      "token_start": 485,
      "token_end_exclusive": 492
    },
    {
      "start_ms": 96540,
      "end_ms": 98420,
      "text": "我只要把对方贬低自己，",
      "token_start": 492,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 98420,
      "end_ms": 99325,
      "text": "就显得高贵。",
      "token_start": 502,
      "token_end_exclusive": 507
    },
    {
      "start_ms": 99680,
      "end_ms": 103020,
      "text": "正是这种他人之眼可以被驯服的虚妄幻觉，",
      "token_start": 507,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 103300,
      "end_ms": 105935,
      "text": "让人陷入了不可逆的自我异化之中。",
      "token_start": 525,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 106460,
      "end_ms": 109655,
      "text": "因为你潜意识里觉得他人的目光是可以被操纵的，",
      "token_start": 540,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 110180,
      "end_ms": 113095,
      "text": "所以你敢于在阿谀奉承中出卖真实的感受，",
      "token_start": 561,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 113600,
      "end_ms": 116160,
      "text": "敢于在社交表演中耗尽生命的真诚。",
      "token_start": 579,
      "token_end_exclusive": 594
    },
    {
      "start_ms": 116500,
      "end_ms": 119685,
      "text": "敢于把别人会怎么看我奉为最高法庭，",
      "token_start": 594,
      "token_end_exclusive": 610
    },
    {
      "start_ms": 120210,
      "end_ms": 122705,
      "text": "而将自己真正的欲望无限期关押。",
      "token_start": 610,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 123050,
      "end_ms": 125335,
      "text": "恰特在存在与虚无中进一步指出，",
      "token_start": 624,
      "token_end_exclusive": 638
    },
    {
      "start_ms": 125930,
      "end_ms": 128565,
      "text": "他人的注视具有一种根本性的暴力。",
      "token_start": 638,
      "token_end_exclusive": 653
    },
    {
      "start_ms": 128910,
      "end_ms": 130065,
      "text": "当他人看我时，",
      "token_start": 653,
      "token_end_exclusive": 659
    },
    {
      "start_ms": 130690,
      "end_ms": 135005,
      "text": "我从一个自由的主体瞬间被凝固为一个被审视的客体。",
      "token_start": 659,
      "token_end_exclusive": 682
    },
    {
      "start_ms": 135440,
      "end_ms": 136885,
      "text": "我的可能性被剥夺，",
      "token_start": 682,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 137210,
      "end_ms": 140080,
      "text": "我成为他人意识中的一个物我。",
      "token_start": 690,
      "token_end_exclusive": 703
    },
    {
      "start_ms": 140080,
      "end_ms": 141520,
      "text": "原本是自维的存在，",
      "token_start": 703,
      "token_end_exclusive": 711
    },
    {
      "start_ms": 141720,
      "end_ms": 143000,
      "text": "是不断超越自身，",
      "token_start": 711,
      "token_end_exclusive": 718
    },
    {
      "start_ms": 143180,
      "end_ms": 144505,
      "text": "创造自身的存在。",
      "token_start": 718,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 144820,
      "end_ms": 145925,
      "text": "但在他人的注视下，",
      "token_start": 725,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 146170,
      "end_ms": 148265,
      "text": "我被降格为自在的存在，",
      "token_start": 733,
      "token_end_exclusive": 743
    },
    {
      "start_ms": 148620,
      "end_ms": 151565,
      "text": "一个将死的被定义了的存在物。",
      "token_start": 743,
      "token_end_exclusive": 756
    },
    {
      "start_ms": 151980,
      "end_ms": 154295,
      "text": "这正是他人及地狱的深层含义，",
      "token_start": 756,
      "token_end_exclusive": 769
    },
    {
      "start_ms": 154610,
      "end_ms": 156505,
      "text": "并非他人本身是邪恶的，",
      "token_start": 769,
      "token_end_exclusive": 779
    },
    {
      "start_ms": 156900,
      "end_ms": 158520,
      "text": "而是他人对我的客体化。",
      "token_start": 779,
      "token_end_exclusive": 789
    },
    {
      "start_ms": 158740,
      "end_ms": 161480,
      "text": "将我困在了一个我无法选择的身份之中。",
      "token_start": 789,
      "token_end_exclusive": 806
    },
    {
      "start_ms": 161600,
      "end_ms": 165115,
      "text": "萨特鲜明的表达了他者是冲突的根源的思想。",
      "token_start": 806,
      "token_end_exclusive": 825
    },
    {
      "start_ms": 165580,
      "end_ms": 167435,
      "text": "因为自我和他人都是主体，",
      "token_start": 825,
      "token_end_exclusive": 836
    },
    {
      "start_ms": 167730,
      "end_ms": 169610,
      "text": "都渴望成为凝视的发出者，",
      "token_start": 836,
      "token_end_exclusive": 847
    },
    {
      "start_ms": 169610,
      "end_ms": 170585,
      "text": "而非承受者。",
      "token_start": 847,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 171280,
      "end_ms": 174560,
      "text": "双方通过凝视来实现把别人当成意识的对象，",
      "token_start": 852,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 174700,
      "end_ms": 176905,
      "text": "甚至把别人虚化为一个存在物。",
      "token_start": 871,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 177310,
      "end_ms": 178530,
      "text": "这种主体性的争夺，",
      "token_start": 884,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 178710,
      "end_ms": 183230,
      "text": "使人与人的关系在本质上成为一种无休止的相互对象化循环。",
      "token_start": 892,
      "token_end_exclusive": 918
    },
    {
      "start_ms": 183430,
      "end_ms": 183830,
      "text": "然而，",
      "token_start": 918,
      "token_end_exclusive": 920
    },
    {
      "start_ms": 184010,
      "end_ms": 186295,
      "text": "萨特并非一个绝望的悲观主义者，",
      "token_start": 920,
      "token_end_exclusive": 934
    },
    {
      "start_ms": 186630,
      "end_ms": 187410,
      "text": "他同时指出，",
      "token_start": 934,
      "token_end_exclusive": 939
    },
    {
      "start_ms": 187690,
      "end_ms": 190510,
      "text": "他人是我与自我之间不可互缺的中介。",
      "token_start": 939,
      "token_end_exclusive": 955
    },
    {
      "start_ms": 190590,
      "end_ms": 191590,
      "text": "没有他人的目光，",
      "token_start": 955,
      "token_end_exclusive": 962
    },
    {
      "start_ms": 191710,
      "end_ms": 193490,
      "text": "我甚至无法认识自己是谁。",
      "token_start": 962,
      "token_end_exclusive": 973
    },
    {
      "start_ms": 193870,
      "end_ms": 195110,
      "text": "我通过他人的眼睛，",
      "token_start": 973,
      "token_end_exclusive": 981
    },
    {
      "start_ms": 195210,
      "end_ms": 196350,
      "text": "看到自己的面貌，",
      "token_start": 981,
      "token_end_exclusive": 988
    },
    {
      "start_ms": 196530,
      "end_ms": 197590,
      "text": "通过他人的评价，",
      "token_start": 988,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 197590,
      "end_ms": 198655,
      "text": "理解自己的价值，",
      "token_start": 995,
      "token_end_exclusive": 1002
    },
    {
      "start_ms": 199170,
      "end_ms": 201400,
      "text": "这意味着他人既是我的地域，",
      "token_start": 1002,
      "token_end_exclusive": 1014
    },
    {
      "start_ms": 201540,
      "end_ms": 203425,
      "text": "也是我自我认知的条件。",
      "token_start": 1014,
      "token_end_exclusive": 1024
    },
    {
      "start_ms": 203850,
      "end_ms": 205735,
      "text": "问题的关键不在于消灭他人，",
      "token_start": 1024,
      "token_end_exclusive": 1036
    },
    {
      "start_ms": 206000,
      "end_ms": 208455,
      "text": "而在于我如何面对他人的凝视，",
      "token_start": 1036,
      "token_end_exclusive": 1049
    },
    {
      "start_ms": 208760,
      "end_ms": 211375,
      "text": "还是坚决夺回自己作为主体的目光。",
      "token_start": 1049,
      "token_end_exclusive": 1064
    },
    {
      "start_ms": 212000,
      "end_ms": 212700,
      "text": "萨特所说，",
      "token_start": 1064,
      "token_end_exclusive": 1068
    },
    {
      "start_ms": 212960,
      "end_ms": 213940,
      "text": "他人就是地狱，",
      "token_start": 1068,
      "token_end_exclusive": 1074
    },
    {
      "start_ms": 214240,
      "end_ms": 215840,
      "text": "并非指人与人的关系，",
      "token_start": 1074,
      "token_end_exclusive": 1083
    },
    {
      "start_ms": 215840,
      "end_ms": 216865,
      "text": "总是敌对的，",
      "token_start": 1083,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 217480,
      "end_ms": 219955,
      "text": "他人是对一个人自由的限制或否定。",
      "token_start": 1088,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 220250,
      "end_ms": 220815,
      "text": "但同时，",
      "token_start": 1103,
      "token_end_exclusive": 1106
    },
    {
      "start_ms": 221200,
      "end_ms": 223240,
      "text": "他人对一个人的自由既是限制，",
      "token_start": 1106,
      "token_end_exclusive": 1119
    },
    {
      "start_ms": 223240,
      "end_ms": 223995,
      "text": "又是条件，",
      "token_start": 1119,
      "token_end_exclusive": 1123
    },
    {
      "start_ms": 224470,
      "end_ms": 225250,
      "text": "既是否定，",
      "token_start": 1123,
      "token_end_exclusive": 1127
    },
    {
      "start_ms": 225290,
      "end_ms": 228125,
      "text": "又是否定之否定及更高层次的肯定。",
      "token_start": 1127,
      "token_end_exclusive": 1142
    },
    {
      "start_ms": 228510,
      "end_ms": 230190,
      "text": "如果我们居于他人的注视，",
      "token_start": 1142,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 230410,
      "end_ms": 231905,
      "text": "过于注重别人的评论，",
      "token_start": 1153,
      "token_end_exclusive": 1162
    },
    {
      "start_ms": 232190,
      "end_ms": 233785,
      "text": "那就会成为别人的受害者。",
      "token_start": 1162,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 234090,
      "end_ms": 235085,
      "text": "他人就是地狱。",
      "token_start": 1173,
      "token_end_exclusive": 1179
    },
    {
      "start_ms": 235680,
      "end_ms": 238155,
      "text": "但如果我们能够打碎他人注视的威胁，",
      "token_start": 1179,
      "token_end_exclusive": 1195
    },
    {
      "start_ms": 238420,
      "end_ms": 240720,
      "text": "去争取自身的解放他人，",
      "token_start": 1195,
      "token_end_exclusive": 1205
    },
    {
      "start_ms": 240720,
      "end_ms": 243445,
      "text": "就仅仅是一个我可以自由选择的处境。",
      "token_start": 1205,
      "token_end_exclusive": 1221
    },
    {
      "start_ms": 243980,
      "end_ms": 244720,
      "text": "挣脱他人。",
      "token_start": 1221,
      "token_end_exclusive": 1225
    },
    {
      "start_ms": 244720,
      "end_ms": 247515,
      "text": "地狱从来不是对他人的逃避或憎恨，",
      "token_start": 1225,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 247820,
      "end_ms": 250295,
      "text": "而是对客体化命运最激烈的反抗。",
      "token_start": 1240,
      "token_end_exclusive": 1254
    },
    {
      "start_ms": 251130,
      "end_ms": 253205,
      "text": "当别人怎么看的焦虑悬于头顶，",
      "token_start": 1254,
      "token_end_exclusive": 1267
    },
    {
      "start_ms": 253520,
      "end_ms": 256820,
      "text": "所有外界强加给你的标签、虚荣的胜负欲，",
      "token_start": 1267,
      "token_end_exclusive": 1284
    },
    {
      "start_ms": 256980,
      "end_ms": 258600,
      "text": "以及对被否定的恐惧，",
      "token_start": 1284,
      "token_end_exclusive": 1293
    },
    {
      "start_ms": 258740,
      "end_ms": 261215,
      "text": "都会在瞬间被剥落的一干二净。",
      "token_start": 1293,
      "token_end_exclusive": 1306
    },
    {
      "start_ms": 261600,
      "end_ms": 264080,
      "text": "你不再有余力去迎合所有人的期待，",
      "token_start": 1306,
      "token_end_exclusive": 1321
    },
    {
      "start_ms": 264280,
      "end_ms": 268205,
      "text": "不再有时间去为他人评价中的一丝波动而辗转反侧。",
      "token_start": 1321,
      "token_end_exclusive": 1343
    },
    {
      "start_ms": 268800,
      "end_ms": 270415,
      "text": "他人的凝视是不可避免的，",
      "token_start": 1343,
      "token_end_exclusive": 1354
    },
    {
      "start_ms": 270630,
      "end_ms": 273845,
      "text": "但这并不意味着我必须成为一个被凝视的囚徒，",
      "token_start": 1354,
      "token_end_exclusive": 1374
    },
    {
      "start_ms": 274250,
      "end_ms": 277470,
      "text": "关键在于我是否能够在被凝视的同时，",
      "token_start": 1374,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 277890,
      "end_ms": 280205,
      "text": "始终保持自己凝视他人的能力。",
      "token_start": 1390,
      "token_end_exclusive": 1403
    },
    {
      "start_ms": 280700,
      "end_ms": 284185,
      "text": "我是否能够拒绝成为他人眼中的那个固定的物，",
      "token_start": 1403,
      "token_end_exclusive": 1423
    },
    {
      "start_ms": 284680,
      "end_ms": 288055,
      "text": "始终坚持自己作为自为的存在的无限可能。",
      "token_start": 1423,
      "token_end_exclusive": 1441
    },
    {
      "start_ms": 288600,
      "end_ms": 292545,
      "text": "他人及地狱的本质是对自身主体性的遗忘与放弃。",
      "token_start": 1441,
      "token_end_exclusive": 1462
    },
    {
      "start_ms": 293250,
      "end_ms": 294305,
      "text": "而本真的活着，",
      "token_start": 1462,
      "token_end_exclusive": 1468
    },
    {
      "start_ms": 294480,
      "end_ms": 296360,
      "text": "是带着我即自由的清醒，",
      "token_start": 1468,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 296640,
      "end_ms": 298595,
      "text": "夺回你对自身目光的主权，",
      "token_start": 1478,
      "token_end_exclusive": 1489
    },
    {
      "start_ms": 299090,
      "end_ms": 301535,
      "text": "不要等到被他人的评判彻底淹没，",
      "token_start": 1489,
      "token_end_exclusive": 1503
    },
    {
      "start_ms": 301820,
      "end_ms": 302800,
      "text": "才去懊悔自己。",
      "token_start": 1503,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 302800,
      "end_ms": 304355,
      "text": "从未真正做过自己，",
      "token_start": 1509,
      "token_end_exclusive": 1517
    },
    {
      "start_ms": 305000,
      "end_ms": 305755,
      "text": "从此刻起，",
      "token_start": 1517,
      "token_end_exclusive": 1521
    },
    {
      "start_ms": 306120,
      "end_ms": 308125,
      "text": "直面那些无处不在的注释。",
      "token_start": 1521,
      "token_end_exclusive": 1532
    },
    {
      "start_ms": 308820,
      "end_ms": 310395,
      "text": "当你不再畏惧他人的目光，",
      "token_start": 1532,
      "token_end_exclusive": 1543
    },
    {
      "start_ms": 310660,
      "end_ms": 313095,
      "text": "你才算真正挣脱了客体化的枷锁。",
      "token_start": 1543,
      "token_end_exclusive": 1557
    },
    {
      "start_ms": 313600,
      "end_ms": 314740,
      "text": "在众目睽睽之下，",
      "token_start": 1557,
      "token_end_exclusive": 1564
    },
    {
      "start_ms": 314880,
      "end_ms": 318235,
      "text": "活出属于你自己的绝对清醒与自由。",
      "token_start": 1564,
      "token_end_exclusive": 1579
    },
    {
      "start_ms": 318690,
      "end_ms": 319390,
      "text": "我是小海龟，",
      "token_start": 1579,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 319530,
      "end_ms": 320790,
      "text": "欢迎持续关注我们，",
      "token_start": 1584,
      "token_end_exclusive": 1592
    },
    {
      "start_ms": 320790,
      "end_ms": 321455,
      "text": "下本书见。",
      "token_start": 1592,
      "token_end_exclusive": 1596
    }
  ],
