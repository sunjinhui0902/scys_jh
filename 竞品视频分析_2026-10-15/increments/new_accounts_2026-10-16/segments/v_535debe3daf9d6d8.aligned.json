{
  "video_id": "v_535debe3daf9d6d8",
  "duration_s": 557.14,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_535debe3daf9d6d8.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_535debe3daf9d6d8.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 70,
      "end_ms": 2870,
      "text": "您知道故宫里最震撼人的是什么吗？",
      "token_start": 0,
      "token_end_exclusive": 15
    },
    {
      "start_ms": 2910,
      "end_ms": 6210,
      "text": "有人说是清明上河图五米多长，",
      "token_start": 15,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 6210,
      "end_ms": 7830,
      "text": "画了八百多个人。",
      "token_start": 28,
      "token_end_exclusive": 35
    },
    {
      "start_ms": 7830,
      "end_ms": 9770,
      "text": "有人说是翠玉白菜雕的，",
      "token_start": 35,
      "token_end_exclusive": 45
    },
    {
      "start_ms": 9770,
      "end_ms": 11350,
      "text": "跟真白菜一样，",
      "token_start": 45,
      "token_end_exclusive": 51
    },
    {
      "start_ms": 11490,
      "end_ms": 13250,
      "text": "虫子都能骗过去。",
      "token_start": 51,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 13290,
      "end_ms": 14030,
      "text": "错了，",
      "token_start": 58,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 14070,
      "end_ms": 16550,
      "text": "清明上河图只是画的细。",
      "token_start": 60,
      "token_end_exclusive": 70
    },
    {
      "start_ms": 16610,
      "end_ms": 19550,
      "text": "翠玉白菜不过是块巧雕的玉，",
      "token_start": 70,
      "token_end_exclusive": 82
    },
    {
      "start_ms": 20110,
      "end_ms": 22970,
      "text": "真正震撼的是那些人做出来，",
      "token_start": 82,
      "token_end_exclusive": 94
    },
    {
      "start_ms": 23510,
      "end_ms": 26090,
      "text": "但看着像老天爷做的东西，",
      "token_start": 94,
      "token_end_exclusive": 105
    },
    {
      "start_ms": 26090,
      "end_ms": 28310,
      "text": "一层漆刷上百遍，",
      "token_start": 105,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 28310,
      "end_ms": 32260,
      "text": "但完要去要几个月一幅画织三年，",
      "token_start": 112,
      "token_end_exclusive": 126
    },
    {
      "start_ms": 33220,
      "end_ms": 34600,
      "text": "织完人都老了。",
      "token_start": 126,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 34680,
      "end_ms": 38180,
      "text": "三千年前的青铜器拆了还能装回去。",
      "token_start": 132,
      "token_end_exclusive": 147
    },
    {
      "start_ms": 38780,
      "end_ms": 42080,
      "text": "今天咱们就来盘点故宫里十件人做出来，",
      "token_start": 147,
      "token_end_exclusive": 164
    },
    {
      "start_ms": 42560,
      "end_ms": 44640,
      "text": "但看着像老天爷做的宝贝，",
      "token_start": 164,
      "token_end_exclusive": 175
    },
    {
      "start_ms": 45240,
      "end_ms": 48780,
      "text": "每一件都代表了老祖宗手艺的天花板，",
      "token_start": 175,
      "token_end_exclusive": 191
    },
    {
      "start_ms": 49200,
      "end_ms": 53320,
      "text": "每一件后人想仿很难仿到位。",
      "token_start": 191,
      "token_end_exclusive": 203
    },
    {
      "start_ms": 54300,
      "end_ms": 59315,
      "text": "每十名章程造款雕漆云纹盘。",
      "token_start": 203,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 60240,
      "end_ms": 63195,
      "text": "元代有一个叫张程的七七大师，",
      "token_start": 215,
      "token_end_exclusive": 228
    },
    {
      "start_ms": 63940,
      "end_ms": 65525,
      "text": "做涕宏出名。",
      "token_start": 228,
      "token_end_exclusive": 233
    },
    {
      "start_ms": 66990,
      "end_ms": 67935,
      "text": "什么叫涕红？",
      "token_start": 233,
      "token_end_exclusive": 238
    },
    {
      "start_ms": 68400,
      "end_ms": 69700,
      "text": "就是在木头上刷红，",
      "token_start": 238,
      "token_end_exclusive": 246
    },
    {
      "start_ms": 69700,
      "end_ms": 71715,
      "text": "漆刷到足够厚，",
      "token_start": 246,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 72510,
      "end_ms": 75350,
      "text": "再用刀一刀一刀把花纹踢出来，",
      "token_start": 252,
      "token_end_exclusive": 265
    },
    {
      "start_ms": 75410,
      "end_ms": 77005,
      "text": "您知道要刷多少层吗？",
      "token_start": 265,
      "token_end_exclusive": 274
    },
    {
      "start_ms": 77690,
      "end_ms": 79110,
      "text": "少则八九十层，",
      "token_start": 274,
      "token_end_exclusive": 280
    },
    {
      "start_ms": 79330,
      "end_ms": 80385,
      "text": "多则上百层，",
      "token_start": 280,
      "token_end_exclusive": 285
    },
    {
      "start_ms": 80830,
      "end_ms": 82370,
      "text": "每一层都要等前一层，",
      "token_start": 285,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 82370,
      "end_ms": 84215,
      "text": "干透了才能刷下一层。",
      "token_start": 294,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 84980,
      "end_ms": 88025,
      "text": "刷完一百层少说也要几个月。",
      "token_start": 303,
      "token_end_exclusive": 315
    },
    {
      "start_ms": 88530,
      "end_ms": 91185,
      "text": "章程有一件传世的剃息盘，",
      "token_start": 315,
      "token_end_exclusive": 326
    },
    {
      "start_ms": 91990,
      "end_ms": 95945,
      "text": "刀口断面上露出了四道朱红色的漆限，",
      "token_start": 326,
      "token_end_exclusive": 342
    },
    {
      "start_ms": 96810,
      "end_ms": 98745,
      "text": "古籍里叫无间诛县，",
      "token_start": 342,
      "token_end_exclusive": 350
    },
    {
      "start_ms": 99390,
      "end_ms": 101755,
      "text": "黑色的漆里夹着红色的线，",
      "token_start": 350,
      "token_end_exclusive": 361
    },
    {
      "start_ms": 102430,
      "end_ms": 104645,
      "text": "像墨里藏了一条红丝带。",
      "token_start": 361,
      "token_end_exclusive": 371
    },
    {
      "start_ms": 105240,
      "end_ms": 107685,
      "text": "传说张成晚年眼睛不太好使了，",
      "token_start": 371,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 108050,
      "end_ms": 110405,
      "text": "徒弟问他怎么还能标的这么准。",
      "token_start": 384,
      "token_end_exclusive": 397
    },
    {
      "start_ms": 111330,
      "end_ms": 112410,
      "text": "他摸着盘子说，",
      "token_start": 397,
      "token_end_exclusive": 403
    },
    {
      "start_ms": 112510,
      "end_ms": 113625,
      "text": "手比眼睛准，",
      "token_start": 403,
      "token_end_exclusive": 408
    },
    {
      "start_ms": 114610,
      "end_ms": 116070,
      "text": "这辈子摸过几万，",
      "token_start": 408,
      "token_end_exclusive": 415
    },
    {
      "start_ms": 116070,
      "end_ms": 117210,
      "text": "刀闭着眼，",
      "token_start": 415,
      "token_end_exclusive": 419
    },
    {
      "start_ms": 117210,
      "end_ms": 118675,
      "text": "都知道该往哪儿走。",
      "token_start": 419,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 119210,
      "end_ms": 122140,
      "text": "刀一件盘子刷上百层，",
      "token_start": 427,
      "token_end_exclusive": 436
    },
    {
      "start_ms": 122140,
      "end_ms": 123715,
      "text": "漆雕上千刀，",
      "token_start": 436,
      "token_end_exclusive": 441
    },
    {
      "start_ms": 124050,
      "end_ms": 125385,
      "text": "您说这手艺绝不绝。",
      "token_start": 441,
      "token_end_exclusive": 449
    },
    {
      "start_ms": 127220,
      "end_ms": 128055,
      "text": "聊到这儿，",
      "token_start": 449,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 128430,
      "end_ms": 130455,
      "text": "先在评论区打出四个字，",
      "token_start": 453,
      "token_end_exclusive": 463
    },
    {
      "start_ms": 130850,
      "end_ms": 132065,
      "text": "巧夺天工，",
      "token_start": 463,
      "token_end_exclusive": 467
    },
    {
      "start_ms": 132470,
      "end_ms": 133895,
      "text": "打完我接着往下讲。",
      "token_start": 467,
      "token_end_exclusive": 475
    },
    {
      "start_ms": 134380,
      "end_ms": 138465,
      "text": "这十件里头有一件到今天都仿不出来，",
      "token_start": 475,
      "token_end_exclusive": 491
    },
    {
      "start_ms": 139910,
      "end_ms": 143395,
      "text": "第九名沈子藩万丝眉雀图，",
      "token_start": 491,
      "token_end_exclusive": 502
    },
    {
      "start_ms": 143860,
      "end_ms": 145605,
      "text": "您知道什么叫文思吗？",
      "token_start": 502,
      "token_end_exclusive": 511
    },
    {
      "start_ms": 146390,
      "end_ms": 148490,
      "text": "就是通经断尾经线，",
      "token_start": 511,
      "token_end_exclusive": 519
    },
    {
      "start_ms": 148610,
      "end_ms": 150555,
      "text": "从头到尾是连贯的。",
      "token_start": 519,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 150850,
      "end_ms": 153985,
      "text": "纬线是一段一段断开织一朵花。",
      "token_start": 527,
      "token_end_exclusive": 540
    },
    {
      "start_ms": 154870,
      "end_ms": 161080,
      "text": "这朵花用一种颜色的纬线织完了就剪断换另一种颜色，",
      "token_start": 540,
      "token_end_exclusive": 563
    },
    {
      "start_ms": 161080,
      "end_ms": 164915,
      "text": "在之一根纬线只织一个颜色，",
      "token_start": 563,
      "token_end_exclusive": 575
    },
    {
      "start_ms": 165700,
      "end_ms": 168335,
      "text": "衣服画下来要剪几万根线。",
      "token_start": 575,
      "token_end_exclusive": 586
    },
    {
      "start_ms": 168850,
      "end_ms": 170595,
      "text": "南宋有个叫沈子藩的人，",
      "token_start": 586,
      "token_end_exclusive": 596
    },
    {
      "start_ms": 171040,
      "end_ms": 173375,
      "text": "用人丝织的一幅梅雀图，",
      "token_start": 596,
      "token_end_exclusive": 606
    },
    {
      "start_ms": 173830,
      "end_ms": 175875,
      "text": "一只喜鹊站在梅枝上，",
      "token_start": 606,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 176230,
      "end_ms": 178405,
      "text": "喜鹊的眼睛灵动鲜活，",
      "token_start": 615,
      "token_end_exclusive": 624
    },
    {
      "start_ms": 178790,
      "end_ms": 179615,
      "text": "换个角度，",
      "token_start": 624,
      "token_end_exclusive": 628
    },
    {
      "start_ms": 179930,
      "end_ms": 181310,
      "text": "眼睛仿佛会发光。",
      "token_start": 628,
      "token_end_exclusive": 635
    },
    {
      "start_ms": 181870,
      "end_ms": 183050,
      "text": "您凑近看，",
      "token_start": 635,
      "token_end_exclusive": 639
    },
    {
      "start_ms": 183730,
      "end_ms": 188670,
      "text": "画面上每根丝线的密度经线二十来根一厘米，",
      "token_start": 639,
      "token_end_exclusive": 658
    },
    {
      "start_ms": 189150,
      "end_ms": 191970,
      "text": "尾线四十几根一厘米，",
      "token_start": 658,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 192890,
      "end_ms": 194250,
      "text": "比头发丝还密。",
      "token_start": 667,
      "token_end_exclusive": 673
    },
    {
      "start_ms": 194350,
      "end_ms": 195030,
      "text": "古人说，",
      "token_start": 673,
      "token_end_exclusive": 676
    },
    {
      "start_ms": 195050,
      "end_ms": 196890,
      "text": "一寸烟丝一寸金，",
      "token_start": 676,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 197130,
      "end_ms": 198090,
      "text": "不是夸张。",
      "token_start": 683,
      "token_end_exclusive": 687
    },
    {
      "start_ms": 198830,
      "end_ms": 203190,
      "text": "沈子帆织这幅梅雀图据说用了整整三年，",
      "token_start": 687,
      "token_end_exclusive": 704
    },
    {
      "start_ms": 204050,
      "end_ms": 204930,
      "text": "织完那天，",
      "token_start": 704,
      "token_end_exclusive": 708
    },
    {
      "start_ms": 205150,
      "end_ms": 206050,
      "text": "他五十多岁，",
      "token_start": 708,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 206630,
      "end_ms": 208390,
      "text": "眼睛几乎看不清了。",
      "token_start": 713,
      "token_end_exclusive": 721
    },
    {
      "start_ms": 208890,
      "end_ms": 210180,
      "text": "织弟问他值不值值，",
      "token_start": 721,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 210520,
      "end_ms": 210960,
      "text": "他说，",
      "token_start": 729,
      "token_end_exclusive": 731
    },
    {
      "start_ms": 211300,
      "end_ms": 215260,
      "text": "一根线织一个颜色剪断几万根线，",
      "token_start": 731,
      "token_end_exclusive": 745
    },
    {
      "start_ms": 215980,
      "end_ms": 217660,
      "text": "这辈子就做这一件事，",
      "token_start": 745,
      "token_end_exclusive": 754
    },
    {
      "start_ms": 218460,
      "end_ms": 221420,
      "text": "做到眼睛瞎了也值。",
      "token_start": 754,
      "token_end_exclusive": 762
    },
    {
      "start_ms": 221760,
      "end_ms": 222980,
      "text": "一幅单丝画，",
      "token_start": 762,
      "token_end_exclusive": 767
    },
    {
      "start_ms": 223880,
      "end_ms": 226200,
      "text": "耗尽一个人的眼睛和青春，",
      "token_start": 767,
      "token_end_exclusive": 778
    },
    {
      "start_ms": 226820,
      "end_ms": 228780,
      "text": "您说这是手艺还是命？",
      "token_start": 778,
      "token_end_exclusive": 787
    },
    {
      "start_ms": 230220,
      "end_ms": 230940,
      "text": "第八名？",
      "token_start": 787,
      "token_end_exclusive": 790
    },
    {
      "start_ms": 232720,
      "end_ms": 234640,
      "text": "宋代青玉云龙纹奴，",
      "token_start": 790,
      "token_end_exclusive": 798
    },
    {
      "start_ms": 235800,
      "end_ms": 238000,
      "text": "您知道宋代玉器有多绝吗？",
      "token_start": 798,
      "token_end_exclusive": 809
    },
    {
      "start_ms": 238060,
      "end_ms": 240490,
      "text": "宋人雕玉不追求个头大，",
      "token_start": 809,
      "token_end_exclusive": 819
    },
    {
      "start_ms": 240650,
      "end_ms": 241310,
      "text": "追求巧，",
      "token_start": 819,
      "token_end_exclusive": 822
    },
    {
      "start_ms": 242090,
      "end_ms": 244730,
      "text": "这件炉子高不到八厘米，",
      "token_start": 822,
      "token_end_exclusive": 832
    },
    {
      "start_ms": 244890,
      "end_ms": 246530,
      "text": "口径不到十三厘米，",
      "token_start": 832,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 246790,
      "end_ms": 248990,
      "text": "一只手就能握住炉，",
      "token_start": 840,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 249050,
      "end_ms": 250070,
      "text": "身上雕了。",
      "token_start": 848,
      "token_end_exclusive": 852
    },
    {
      "start_ms": 250070,
      "end_ms": 252630,
      "text": "一条龙龙在云里翻腾，",
      "token_start": 852,
      "token_end_exclusive": 861
    },
    {
      "start_ms": 253050,
      "end_ms": 255430,
      "text": "您拿放大镜看龙的鳞片，",
      "token_start": 861,
      "token_end_exclusive": 871
    },
    {
      "start_ms": 255630,
      "end_ms": 256450,
      "text": "一片一片，",
      "token_start": 871,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 256810,
      "end_ms": 258490,
      "text": "每一片形态都不一样。",
      "token_start": 875,
      "token_end_exclusive": 884
    },
    {
      "start_ms": 258770,
      "end_ms": 260230,
      "text": "龙的爪子五个指头，",
      "token_start": 884,
      "token_end_exclusive": 892
    },
    {
      "start_ms": 260610,
      "end_ms": 261910,
      "text": "每个指头都刻出了，",
      "token_start": 892,
      "token_end_exclusive": 900
    },
    {
      "start_ms": 261910,
      "end_ms": 264590,
      "text": "指甲云纹一根一根，",
      "token_start": 900,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 265530,
      "end_ms": 267470,
      "text": "粗细深浅全有变化，",
      "token_start": 908,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 268430,
      "end_ms": 270620,
      "text": "宋人雕玉不用，",
      "token_start": 916,
      "token_end_exclusive": 922
    },
    {
      "start_ms": 270660,
      "end_ms": 279280,
      "text": "机器全靠砣具一点一点慢慢磨一件这么小的器物工匠要磨几个月，",
      "token_start": 922,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 279520,
      "end_ms": 280780,
      "text": "甚至整整一年，",
      "token_start": 950,
      "token_end_exclusive": 956
    },
    {
      "start_ms": 281700,
      "end_ms": 283940,
      "text": "传说有个玉匠磨了一辈子，",
      "token_start": 956,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 283940,
      "end_ms": 286580,
      "text": "玉磨到老了手都变形了。",
      "token_start": 967,
      "token_end_exclusive": 977
    },
    {
      "start_ms": 287260,
      "end_ms": 289140,
      "text": "徒弟问他为什么不歇歇，",
      "token_start": 977,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 289840,
      "end_ms": 292380,
      "text": "他说欲认人，",
      "token_start": 987,
      "token_end_exclusive": 992
    },
    {
      "start_ms": 292980,
      "end_ms": 293700,
      "text": "你停了，",
      "token_start": 992,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 294360,
      "end_ms": 295765,
      "text": "他就不认你了。",
      "token_start": 995,
      "token_end_exclusive": 1001
    },
    {
      "start_ms": 296450,
      "end_ms": 297470,
      "text": "一块原石，",
      "token_start": 1001,
      "token_end_exclusive": 1005
    },
    {
      "start_ms": 297930,
      "end_ms": 302210,
      "text": "日复一日细细打磨磨到龙鳞片片，",
      "token_start": 1005,
      "token_end_exclusive": 1019
    },
    {
      "start_ms": 302250,
      "end_ms": 305030,
      "text": "分明您说这耐心哪来的？",
      "token_start": 1019,
      "token_end_exclusive": 1029
    },
    {
      "start_ms": 306130,
      "end_ms": 306890,
      "text": "第七名，",
      "token_start": 1029,
      "token_end_exclusive": 1032
    },
    {
      "start_ms": 307990,
      "end_ms": 311510,
      "text": "掐丝珐琅缠织连门向耳炉珐琅。",
      "token_start": 1032,
      "token_end_exclusive": 1045
    },
    {
      "start_ms": 311510,
      "end_ms": 314690,
      "text": "这门手艺元代从阿拉伯传入，",
      "token_start": 1045,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 314990,
      "end_ms": 316430,
      "text": "可中国人学过来之后，",
      "token_start": 1057,
      "token_end_exclusive": 1066
    },
    {
      "start_ms": 316710,
      "end_ms": 318530,
      "text": "做的比圆头还要精湛。",
      "token_start": 1066,
      "token_end_exclusive": 1075
    },
    {
      "start_ms": 318650,
      "end_ms": 322070,
      "text": "这件炉子用的是掐丝珐琅工艺。",
      "token_start": 1075,
      "token_end_exclusive": 1088
    },
    {
      "start_ms": 322790,
      "end_ms": 323750,
      "text": "什么叫掐丝？",
      "token_start": 1088,
      "token_end_exclusive": 1093
    },
    {
      "start_ms": 324130,
      "end_ms": 326960,
      "text": "就是用细铜丝在铜胎上掐出出花纹，",
      "token_start": 1093,
      "token_end_exclusive": 1108
    },
    {
      "start_ms": 327700,
      "end_ms": 330020,
      "text": "掐好之后填上珐琅釉料，",
      "token_start": 1108,
      "token_end_exclusive": 1118
    },
    {
      "start_ms": 330860,
      "end_ms": 332860,
      "text": "再放进窑里烧烧，",
      "token_start": 1118,
      "token_end_exclusive": 1125
    },
    {
      "start_ms": 332960,
      "end_ms": 335260,
      "text": "一遍不够要反复烧七八遍，",
      "token_start": 1125,
      "token_end_exclusive": 1136
    },
    {
      "start_ms": 335500,
      "end_ms": 337780,
      "text": "每烧一遍釉料就会收缩，",
      "token_start": 1136,
      "token_end_exclusive": 1146
    },
    {
      "start_ms": 337920,
      "end_ms": 339160,
      "text": "熬下去就要补用，",
      "token_start": 1146,
      "token_end_exclusive": 1153
    },
    {
      "start_ms": 339880,
      "end_ms": 341520,
      "text": "要了再烧来回，",
      "token_start": 1153,
      "token_end_exclusive": 1159
    },
    {
      "start_ms": 341520,
      "end_ms": 342020,
      "text": "反复，",
      "token_start": 1159,
      "token_end_exclusive": 1161
    },
    {
      "start_ms": 342260,
      "end_ms": 344480,
      "text": "直到釉面和铜丝齐平。",
      "token_start": 1161,
      "token_end_exclusive": 1170
    },
    {
      "start_ms": 344940,
      "end_ms": 345620,
      "text": "您想想，",
      "token_start": 1170,
      "token_end_exclusive": 1173
    },
    {
      "start_ms": 345980,
      "end_ms": 347240,
      "text": "铜丝有多细，",
      "token_start": 1173,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 348060,
      "end_ms": 350160,
      "text": "比头发丝粗不了多少，",
      "token_start": 1178,
      "token_end_exclusive": 1187
    },
    {
      "start_ms": 351080,
      "end_ms": 354540,
      "text": "要在上面掐出蝉枝莲纹一朵花，",
      "token_start": 1187,
      "token_end_exclusive": 1200
    },
    {
      "start_ms": 354580,
      "end_ms": 355740,
      "text": "一片叶子一根，",
      "token_start": 1200,
      "token_end_exclusive": 1206
    },
    {
      "start_ms": 355740,
      "end_ms": 358955,
      "text": "藤蔓全靠铜丝弯折成型。",
      "token_start": 1206,
      "token_end_exclusive": 1216
    },
    {
      "start_ms": 359710,
      "end_ms": 360805,
      "text": "烧完之后，",
      "token_start": 1216,
      "token_end_exclusive": 1220
    },
    {
      "start_ms": 361170,
      "end_ms": 363405,
      "text": "铜丝和珐琅融为一体，",
      "token_start": 1220,
      "token_end_exclusive": 1229
    },
    {
      "start_ms": 363920,
      "end_ms": 366035,
      "text": "摸上去平整顺滑。",
      "token_start": 1229,
      "token_end_exclusive": 1236
    },
    {
      "start_ms": 366460,
      "end_ms": 366610,
      "text": "嗯，",
      "token_start": 1236,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 366650,
      "end_ms": 367330,
      "text": "可细看，",
      "token_start": 1237,
      "token_end_exclusive": 1240
    },
    {
      "start_ms": 367410,
      "end_ms": 370145,
      "text": "每一根铜丝纹路都清清楚楚，",
      "token_start": 1240,
      "token_end_exclusive": 1252
    },
    {
      "start_ms": 370610,
      "end_ms": 374570,
      "text": "一根细如发丝的铜丝掐出一朵花。",
      "token_start": 1252,
      "token_end_exclusive": 1266
    },
    {
      "start_ms": 374870,
      "end_ms": 376895,
      "text": "您说这是人手还是神手？",
      "token_start": 1266,
      "token_end_exclusive": 1276
    },
    {
      "start_ms": 378030,
      "end_ms": 378635,
      "text": "第六名，",
      "token_start": 1276,
      "token_end_exclusive": 1279
    },
    {
      "start_ms": 379600,
      "end_ms": 381055,
      "text": "商代亚丑方尊，",
      "token_start": 1279,
      "token_end_exclusive": 1285
    },
    {
      "start_ms": 381820,
      "end_ms": 384635,
      "text": "这是一件商代晚期的青铜器，",
      "token_start": 1285,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 385470,
      "end_ms": 389175,
      "text": "三千多年前的东西高四十多厘米，",
      "token_start": 1297,
      "token_end_exclusive": 1311
    },
    {
      "start_ms": 389560,
      "end_ms": 391020,
      "text": "重二十来公斤。",
      "token_start": 1311,
      "token_end_exclusive": 1317
    },
    {
      "start_ms": 391300,
      "end_ms": 394705,
      "text": "您知道商代人是怎么铸造青铜器的吗？",
      "token_start": 1317,
      "token_end_exclusive": 1333
    },
    {
      "start_ms": 395060,
      "end_ms": 396455,
      "text": "用的是分柱法，",
      "token_start": 1333,
      "token_end_exclusive": 1339
    },
    {
      "start_ms": 397250,
      "end_ms": 398510,
      "text": "什么叫分铸就？",
      "token_start": 1339,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 398510,
      "end_ms": 400775,
      "text": "是先单独筑好各个零件，",
      "token_start": 1345,
      "token_end_exclusive": 1355
    },
    {
      "start_ms": 401330,
      "end_ms": 403175,
      "text": "再把零件拼装在一起。",
      "token_start": 1355,
      "token_end_exclusive": 1364
    },
    {
      "start_ms": 404010,
      "end_ms": 412245,
      "text": "这件方尊的肩上四脚各有一个相手相手和器身是分开铸造，",
      "token_start": 1364,
      "token_end_exclusive": 1389
    },
    {
      "start_ms": 413190,
      "end_ms": 414090,
      "text": "筑好之后，",
      "token_start": 1389,
      "token_end_exclusive": 1393
    },
    {
      "start_ms": 414330,
      "end_ms": 416925,
      "text": "用榫卯结构套接上去，",
      "token_start": 1393,
      "token_end_exclusive": 1402
    },
    {
      "start_ms": 417550,
      "end_ms": 420375,
      "text": "能拆下来也能装回去。",
      "token_start": 1402,
      "token_end_exclusive": 1411
    },
    {
      "start_ms": 421290,
      "end_ms": 428355,
      "text": "三千多年前的工匠已经掌握了分段铸造榫卯拼接的技术。",
      "token_start": 1411,
      "token_end_exclusive": 1435
    },
    {
      "start_ms": 429040,
      "end_ms": 433215,
      "text": "您想想一个相手单独住好，",
      "token_start": 1435,
      "token_end_exclusive": 1446
    },
    {
      "start_ms": 434370,
      "end_ms": 437060,
      "text": "再套到其身上严丝合缝，",
      "token_start": 1446,
      "token_end_exclusive": 1456
    },
    {
      "start_ms": 437360,
      "end_ms": 438965,
      "text": "拆了还能装回去。",
      "token_start": 1456,
      "token_end_exclusive": 1463
    },
    {
      "start_ms": 439380,
      "end_ms": 442560,
      "text": "传说商代铸铜第一次浇筑失败，",
      "token_start": 1463,
      "token_end_exclusive": 1476
    },
    {
      "start_ms": 442580,
      "end_ms": 444585,
      "text": "工头就跳进桶水里训迹，",
      "token_start": 1476,
      "token_end_exclusive": 1486
    },
    {
      "start_ms": 445060,
      "end_ms": 446460,
      "text": "说是要用命来换。",
      "token_start": 1486,
      "token_end_exclusive": 1493
    },
    {
      "start_ms": 446540,
      "end_ms": 449595,
      "text": "这一如同这件方尊，",
      "token_start": 1493,
      "token_end_exclusive": 1501
    },
    {
      "start_ms": 449960,
      "end_ms": 451335,
      "text": "历经三千多年，",
      "token_start": 1501,
      "token_end_exclusive": 1507
    },
    {
      "start_ms": 451770,
      "end_ms": 453675,
      "text": "棱角依旧分明，",
      "token_start": 1507,
      "token_end_exclusive": 1513
    },
    {
      "start_ms": 454370,
      "end_ms": 456035,
      "text": "纹饰清晰完整。",
      "token_start": 1513,
      "token_end_exclusive": 1519
    },
    {
      "start_ms": 456920,
      "end_ms": 458620,
      "text": "三千年前没有机床，",
      "token_start": 1519,
      "token_end_exclusive": 1527
    },
    {
      "start_ms": 458640,
      "end_ms": 459405,
      "text": "没有图纸，",
      "token_start": 1527,
      "token_end_exclusive": 1531
    },
    {
      "start_ms": 459800,
      "end_ms": 461105,
      "text": "全凭手感拿捏。",
      "token_start": 1531,
      "token_end_exclusive": 1537
    },
    {
      "start_ms": 461560,
      "end_ms": 463405,
      "text": "您说这是技术还是神技？",
      "token_start": 1537,
      "token_end_exclusive": 1547
    },
    {
      "start_ms": 464230,
      "end_ms": 465830,
      "text": "从第十到第六名，",
      "token_start": 1547,
      "token_end_exclusive": 1554
    },
    {
      "start_ms": 466110,
      "end_ms": 467945,
      "text": "这五件东西都够绝。",
      "token_start": 1554,
      "token_end_exclusive": 1562
    },
    {
      "start_ms": 468900,
      "end_ms": 472155,
      "text": "章程的雕漆刷了上百层，",
      "token_start": 1562,
      "token_end_exclusive": 1572
    },
    {
      "start_ms": 472490,
      "end_ms": 474155,
      "text": "一刀一刀剔出云门。",
      "token_start": 1572,
      "token_end_exclusive": 1580
    },
    {
      "start_ms": 474580,
      "end_ms": 477275,
      "text": "沈子藩的严丝织了三年，",
      "token_start": 1580,
      "token_end_exclusive": 1590
    },
    {
      "start_ms": 478070,
      "end_ms": 479355,
      "text": "治完眼睛都瞎了。",
      "token_start": 1590,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 480220,
      "end_ms": 484345,
      "text": "宋代青玉炉掌心大小磨上一年，",
      "token_start": 1597,
      "token_end_exclusive": 1610
    },
    {
      "start_ms": 484840,
      "end_ms": 486505,
      "text": "元代掐死珐琅奴，",
      "token_start": 1610,
      "token_end_exclusive": 1617
    },
    {
      "start_ms": 487020,
      "end_ms": 488620,
      "text": "铜丝细如发丝，",
      "token_start": 1617,
      "token_end_exclusive": 1623
    },
    {
      "start_ms": 488860,
      "end_ms": 492295,
      "text": "烧七八遍才成商代方尊。",
      "token_start": 1623,
      "token_end_exclusive": 1633
    },
    {
      "start_ms": 492660,
      "end_ms": 494855,
      "text": "三千年前就能拆了装回去，",
      "token_start": 1633,
      "token_end_exclusive": 1644
    },
    {
      "start_ms": 495720,
      "end_ms": 497365,
      "text": "可他们还不是最绝的。",
      "token_start": 1644,
      "token_end_exclusive": 1653
    },
    {
      "start_ms": 497860,
      "end_ms": 501505,
      "text": "接下来第五道第一名水准还要震撼。",
      "token_start": 1653,
      "token_end_exclusive": 1668
    },
    {
      "start_ms": 502530,
      "end_ms": 503525,
      "text": "有一件东西，",
      "token_start": 1668,
      "token_end_exclusive": 1673
    },
    {
      "start_ms": 504360,
      "end_ms": 507845,
      "text": "工匠花五年时间造出一座能动的钟。",
      "token_start": 1673,
      "token_end_exclusive": 1688
    },
    {
      "start_ms": 508600,
      "end_ms": 511145,
      "text": "有一件几千个人，",
      "token_start": 1688,
      "token_end_exclusive": 1695
    },
    {
      "start_ms": 511460,
      "end_ms": 512575,
      "text": "耗时十年，",
      "token_start": 1695,
      "token_end_exclusive": 1699
    },
    {
      "start_ms": 513330,
      "end_ms": 515705,
      "text": "打磨出一座巨型玉山。",
      "token_start": 1699,
      "token_end_exclusive": 1708
    },
    {
      "start_ms": 516240,
      "end_ms": 521290,
      "text": "有一件乾隆亲自敲定涂样，",
      "token_start": 1708,
      "token_end_exclusive": 1719
    },
    {
      "start_ms": 521350,
      "end_ms": 522985,
      "text": "全城都造的酒杯。",
      "token_start": 1719,
      "token_end_exclusive": 1726
    },
    {
      "start_ms": 523790,
      "end_ms": 527670,
      "text": "有一件窑工烧石窑，",
      "token_start": 1726,
      "token_end_exclusive": 1734
    },
    {
      "start_ms": 527830,
      "end_ms": 528730,
      "text": "能成一窑，",
      "token_start": 1734,
      "token_end_exclusive": 1738
    },
    {
      "start_ms": 528730,
      "end_ms": 529730,
      "text": "就算撞大运，",
      "token_start": 1738,
      "token_end_exclusive": 1743
    },
    {
      "start_ms": 529830,
      "end_ms": 531380,
      "text": "还有一件画家，",
      "token_start": 1743,
      "token_end_exclusive": 1749
    },
    {
      "start_ms": 531420,
      "end_ms": 533100,
      "text": "一笔一画一墨一色，",
      "token_start": 1749,
      "token_end_exclusive": 1757
    },
    {
      "start_ms": 533400,
      "end_ms": 533860,
      "text": "耗尽，",
      "token_start": 1757,
      "token_end_exclusive": 1759
    },
    {
      "start_ms": 533980,
      "end_ms": 536145,
      "text": "心血汇成的千古名画。",
      "token_start": 1759,
      "token_end_exclusive": 1768
    },
    {
      "start_ms": 536890,
      "end_ms": 538510,
      "text": "这几件到底是什么？",
      "token_start": 1768,
      "token_end_exclusive": 1776
    },
    {
      "start_ms": 538810,
      "end_ms": 540315,
      "text": "到底有多震撼？",
      "token_start": 1776,
      "token_end_exclusive": 1782
    },
    {
      "start_ms": 541180,
      "end_ms": 543865,
      "text": "下一集已经同步更新，",
      "token_start": 1782,
      "token_end_exclusive": 1791
    },
    {
      "start_ms": 544390,
      "end_ms": 545830,
      "text": "直接点开我的头像，",
      "token_start": 1791,
      "token_end_exclusive": 1799
    },
    {
      "start_ms": 545830,
      "end_ms": 546605,
      "text": "进入主页。",
      "token_start": 1799,
      "token_end_exclusive": 1803
    },
    {
      "start_ms": 546970,
      "end_ms": 549555,
      "text": "第一条视频就是下一集点个关注，",
      "token_start": 1803,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 549850,
      "end_ms": 555315,
      "text": "咱们好好看看老祖宗把一辈子的手艺压在一件东西上，",
      "token_start": 1817,
      "token_end_exclusive": 1840
    },
    {
      "start_ms": 555770,
      "end_ms": 557035,
      "text": "到底能做出什么？",
      "token_start": 1840,
      "token_end_exclusive": 1847
    }
  ],
