{
  "video_id": "v_38056006fbf46638",
  "duration_s": 344.236009,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_38056006fbf46638.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_38056006fbf46638.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 590,
      "end_ms": 1490,
      "text": "你敢相信吗？",
      "token_start": 0,
      "token_end_exclusive": 5
    },
    {
      "start_ms": 1830,
      "end_ms": 5430,
      "text": "全世界最会赚钱的这群人居然来自同一个地方。",
      "token_start": 5,
      "token_end_exclusive": 25
    },
    {
      "start_ms": 5610,
      "end_ms": 6150,
      "text": "潮汕，",
      "token_start": 25,
      "token_end_exclusive": 27
    },
    {
      "start_ms": 6530,
      "end_ms": 8370,
      "text": "他们被称作东方犹太人。",
      "token_start": 27,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 8570,
      "end_ms": 10750,
      "text": "全球五千万海外华人华侨中，",
      "token_start": 37,
      "token_end_exclusive": 49
    },
    {
      "start_ms": 10890,
      "end_ms": 12550,
      "text": "潮汕人占了约一千万。",
      "token_start": 49,
      "token_end_exclusive": 58
    },
    {
      "start_ms": 12710,
      "end_ms": 13450,
      "text": "泰国首富，",
      "token_start": 58,
      "token_end_exclusive": 62
    },
    {
      "start_ms": 13550,
      "end_ms": 14410,
      "text": "新加坡首富，",
      "token_start": 62,
      "token_end_exclusive": 67
    },
    {
      "start_ms": 14450,
      "end_ms": 19010,
      "text": "加拿大华人首富、欧洲华人首富、澳洲华人首富全是潮汕人。",
      "token_start": 67,
      "token_end_exclusive": 91
    },
    {
      "start_ms": 19690,
      "end_ms": 22310,
      "text": "他们从一个人多地少的穷地方走出来，",
      "token_start": 91,
      "token_end_exclusive": 107
    },
    {
      "start_ms": 22530,
      "end_ms": 25110,
      "text": "却把生意做到了全世界的每一个角落。",
      "token_start": 107,
      "token_end_exclusive": 123
    },
    {
      "start_ms": 25390,
      "end_ms": 26490,
      "text": "有潮水的地方，",
      "token_start": 123,
      "token_end_exclusive": 129
    },
    {
      "start_ms": 26490,
      "end_ms": 28710,
      "text": "就有潮汕人有钱赚的地方，",
      "token_start": 129,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 28730,
      "end_ms": 29330,
      "text": "就有潮商。",
      "token_start": 140,
      "token_end_exclusive": 144
    },
    {
      "start_ms": 29330,
      "end_ms": 31540,
      "text": "经过五百多年的商业洗礼，",
      "token_start": 144,
      "token_end_exclusive": 155
    },
    {
      "start_ms": 31800,
      "end_ms": 35260,
      "text": "潮商已经成为中国势力最大、影响最深远。",
      "token_start": 155,
      "token_end_exclusive": 172
    },
    {
      "start_ms": 35520,
      "end_ms": 37240,
      "text": "唯一没有断代的大商帮。",
      "token_start": 172,
      "token_end_exclusive": 182
    },
    {
      "start_ms": 37280,
      "end_ms": 38780,
      "text": "从李嘉诚到零百兴，",
      "token_start": 182,
      "token_end_exclusive": 190
    },
    {
      "start_ms": 39140,
      "end_ms": 46560,
      "text": "从传统的米业纸业到今天的AI大模型激光雷达潮汕人始终站在商业浪潮的最前沿。",
      "token_start": 190,
      "token_end_exclusive": 225
    },
    {
      "start_ms": 46640,
      "end_ms": 47280,
      "text": "夸张点说，",
      "token_start": 225,
      "token_end_exclusive": 229
    },
    {
      "start_ms": 47580,
      "end_ms": 51820,
      "text": "目前国内站在新技术浪尖上的创始人一半都来自潮汕。",
      "token_start": 229,
      "token_end_exclusive": 252
    },
    {
      "start_ms": 52380,
      "end_ms": 53320,
      "text": "但问题来了，",
      "token_start": 252,
      "token_end_exclusive": 257
    },
    {
      "start_ms": 53800,
      "end_ms": 59280,
      "text": "他们凭什么有人说是地理环境逼出来的潮汕地区人多地少。",
      "token_start": 257,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 59280,
      "end_ms": 60590,
      "text": "众必养不活，",
      "token_start": 282,
      "token_end_exclusive": 287
    },
    {
      "start_ms": 60590,
      "end_ms": 62535,
      "text": "一家人只能出海谋生。",
      "token_start": 287,
      "token_end_exclusive": 296
    },
    {
      "start_ms": 62960,
      "end_ms": 64020,
      "text": "有人说是运气好，",
      "token_start": 296,
      "token_end_exclusive": 303
    },
    {
      "start_ms": 64200,
      "end_ms": 65260,
      "text": "赶上了时代风口，",
      "token_start": 303,
      "token_end_exclusive": 310
    },
    {
      "start_ms": 65300,
      "end_ms": 66960,
      "text": "还有人说是抱团取暖，",
      "token_start": 310,
      "token_end_exclusive": 319
    },
    {
      "start_ms": 67180,
      "end_ms": 68275,
      "text": "老乡带老乡，",
      "token_start": 319,
      "token_end_exclusive": 324
    },
    {
      "start_ms": 68750,
      "end_ms": 69505,
      "text": "这些都对，",
      "token_start": 324,
      "token_end_exclusive": 328
    },
    {
      "start_ms": 69830,
      "end_ms": 70390,
      "text": "但都没收到。",
      "token_start": 328,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 70390,
      "end_ms": 70995,
      "text": "根子上，",
      "token_start": 333,
      "token_end_exclusive": 336
    },
    {
      "start_ms": 71460,
      "end_ms": 74595,
      "text": "真正让潮汕人纵横商界五百年不败的秘密，",
      "token_start": 336,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 74980,
      "end_ms": 77000,
      "text": "藏在一套独特的思维方式里。",
      "token_start": 354,
      "token_end_exclusive": 366
    },
    {
      "start_ms": 77120,
      "end_ms": 82060,
      "text": "这套思维方式让一个身上只有几十块钱的潮汕人敢直接去做老板，",
      "token_start": 366,
      "token_end_exclusive": 394
    },
    {
      "start_ms": 82140,
      "end_ms": 84760,
      "text": "让一个远渡重洋、语言不通的年轻人，",
      "token_start": 394,
      "token_end_exclusive": 409
    },
    {
      "start_ms": 84980,
      "end_ms": 87380,
      "text": "几年后就能在异国他乡站稳脚跟，",
      "token_start": 409,
      "token_end_exclusive": 423
    },
    {
      "start_ms": 87500,
      "end_ms": 91705,
      "text": "让一个看似不起眼的小生意一步步滚成跨国商业帝国。",
      "token_start": 423,
      "token_end_exclusive": 446
    },
    {
      "start_ms": 92410,
      "end_ms": 96475,
      "text": "这套思维过去只靠父传子师带徒口口相传，",
      "token_start": 446,
      "token_end_exclusive": 464
    },
    {
      "start_ms": 96850,
      "end_ms": 98350,
      "text": "外人根本摸不到门道。",
      "token_start": 464,
      "token_end_exclusive": 473
    },
    {
      "start_ms": 98430,
      "end_ms": 101425,
      "text": "但现在有人把他第一次完整的写了出来，",
      "token_start": 473,
      "token_end_exclusive": 490
    },
    {
      "start_ms": 101690,
      "end_ms": 103435,
      "text": "这本书叫潮汕思维。",
      "token_start": 490,
      "token_end_exclusive": 498
    },
    {
      "start_ms": 104060,
      "end_ms": 109435,
      "text": "他把潮汕人五百年积累的经商智慧、处事、哲学、人脉法则、财富认知，",
      "token_start": 498,
      "token_end_exclusive": 525
    },
    {
      "start_ms": 109840,
      "end_ms": 111860,
      "text": "第一次用普通人能读懂的语言，",
      "token_start": 525,
      "token_end_exclusive": 538
    },
    {
      "start_ms": 112100,
      "end_ms": 113605,
      "text": "系统化的讲清楚了。",
      "token_start": 538,
      "token_end_exclusive": 546
    },
    {
      "start_ms": 113950,
      "end_ms": 117245,
      "text": "你知道潮汕人为什么宁可睡地板也要当老板吗？",
      "token_start": 546,
      "token_end_exclusive": 566
    },
    {
      "start_ms": 117810,
      "end_ms": 118965,
      "text": "因为在他们骨子里，",
      "token_start": 566,
      "token_end_exclusive": 574
    },
    {
      "start_ms": 119250,
      "end_ms": 120295,
      "text": "工字不出头，",
      "token_start": 574,
      "token_end_exclusive": 579
    },
    {
      "start_ms": 120680,
      "end_ms": 122125,
      "text": "打工永远只是手段，",
      "token_start": 579,
      "token_end_exclusive": 587
    },
    {
      "start_ms": 122470,
      "end_ms": 123735,
      "text": "创业才是归宿。",
      "token_start": 587,
      "token_end_exclusive": 593
    },
    {
      "start_ms": 123990,
      "end_ms": 125135,
      "text": "潮汕人不喜欢打工，",
      "token_start": 593,
      "token_end_exclusive": 601
    },
    {
      "start_ms": 125550,
      "end_ms": 126490,
      "text": "有了小小本钱，",
      "token_start": 601,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 126610,
      "end_ms": 128065,
      "text": "就开始想自己做老板，",
      "token_start": 607,
      "token_end_exclusive": 616
    },
    {
      "start_ms": 128560,
      "end_ms": 129405,
      "text": "这不是冲动，",
      "token_start": 616,
      "token_end_exclusive": 621
    },
    {
      "start_ms": 129740,
      "end_ms": 131455,
      "text": "而是一种深入骨髓的认知，",
      "token_start": 621,
      "token_end_exclusive": 632
    },
    {
      "start_ms": 132270,
      "end_ms": 133650,
      "text": "只有自己掌控生意，",
      "token_start": 632,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 133910,
      "end_ms": 135435,
      "text": "才能真正掌控命运。",
      "token_start": 640,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 135970,
      "end_ms": 137230,
      "text": "你知道潮汕人谈生意，",
      "token_start": 648,
      "token_end_exclusive": 657
    },
    {
      "start_ms": 137230,
      "end_ms": 138765,
      "text": "为什么总是在喝茶吗？",
      "token_start": 657,
      "token_end_exclusive": 666
    },
    {
      "start_ms": 139230,
      "end_ms": 142230,
      "text": "那杯功夫茶里藏着潮汕人最核心的人脉，",
      "token_start": 666,
      "token_end_exclusive": 683
    },
    {
      "start_ms": 142230,
      "end_ms": 144020,
      "text": "哲学算盘要打穿，",
      "token_start": 683,
      "token_end_exclusive": 690
    },
    {
      "start_ms": 144340,
      "end_ms": 145805,
      "text": "人情要留香。",
      "token_start": 690,
      "token_end_exclusive": 695
    },
    {
      "start_ms": 146310,
      "end_ms": 149385,
      "text": "潮汕人做生意从来不是冷冰冰的讨价还价，",
      "token_start": 695,
      "token_end_exclusive": 713
    },
    {
      "start_ms": 149750,
      "end_ms": 150930,
      "text": "而是先交朋友，",
      "token_start": 713,
      "token_end_exclusive": 719
    },
    {
      "start_ms": 150990,
      "end_ms": 151775,
      "text": "再谈买卖，",
      "token_start": 719,
      "token_end_exclusive": 723
    },
    {
      "start_ms": 152260,
      "end_ms": 152700,
      "text": "嘴甜，",
      "token_start": 723,
      "token_end_exclusive": 725
    },
    {
      "start_ms": 152700,
      "end_ms": 153415,
      "text": "三分利，",
      "token_start": 725,
      "token_end_exclusive": 728
    },
    {
      "start_ms": 153790,
      "end_ms": 155115,
      "text": "赚钱赚人气。",
      "token_start": 728,
      "token_end_exclusive": 733
    },
    {
      "start_ms": 155510,
      "end_ms": 157365,
      "text": "他们懂得赢得人心，",
      "token_start": 733,
      "token_end_exclusive": 741
    },
    {
      "start_ms": 157650,
      "end_ms": 159415,
      "text": "你赚到钱更值钱。",
      "token_start": 741,
      "token_end_exclusive": 748
    },
    {
      "start_ms": 160070,
      "end_ms": 162445,
      "text": "你知道潮汕人为什么能富过三代吗？",
      "token_start": 748,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 162760,
      "end_ms": 164640,
      "text": "因为他们信奉的不是一夜暴富，",
      "token_start": 763,
      "token_end_exclusive": 776
    },
    {
      "start_ms": 164940,
      "end_ms": 167380,
      "text": "而是铜钱出苦坑富贵。",
      "token_start": 776,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 167380,
      "end_ms": 168040,
      "text": "在凶年，",
      "token_start": 785,
      "token_end_exclusive": 788
    },
    {
      "start_ms": 168100,
      "end_ms": 169395,
      "text": "从底层历练开始，",
      "token_start": 788,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 169730,
      "end_ms": 170630,
      "text": "先做打工仔，",
      "token_start": 795,
      "token_end_exclusive": 800
    },
    {
      "start_ms": 170770,
      "end_ms": 171725,
      "text": "后当大老板，",
      "token_start": 800,
      "token_end_exclusive": 805
    },
    {
      "start_ms": 172150,
      "end_ms": 172710,
      "text": "靠打工，",
      "token_start": 805,
      "token_end_exclusive": 808
    },
    {
      "start_ms": 172810,
      "end_ms": 173745,
      "text": "积累创业资本。",
      "token_start": 808,
      "token_end_exclusive": 814
    },
    {
      "start_ms": 174040,
      "end_ms": 175225,
      "text": "他们不相信运气，",
      "token_start": 814,
      "token_end_exclusive": 821
    },
    {
      "start_ms": 175590,
      "end_ms": 177555,
      "text": "只相信爱拼才会赢。",
      "token_start": 821,
      "token_end_exclusive": 829
    },
    {
      "start_ms": 177900,
      "end_ms": 181055,
      "text": "这本书最厉害的地方在于它不是空洞的理论，",
      "token_start": 829,
      "token_end_exclusive": 848
    },
    {
      "start_ms": 181450,
      "end_ms": 184515,
      "text": "而是把潮汕人五百年来验证过的实战方法，",
      "token_start": 848,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 184800,
      "end_ms": 186465,
      "text": "一条一条拆解给你看。",
      "token_start": 866,
      "token_end_exclusive": 875
    },
    {
      "start_ms": 186950,
      "end_ms": 188830,
      "text": "从选品定位到客源开拓，",
      "token_start": 875,
      "token_end_exclusive": 885
    },
    {
      "start_ms": 189110,
      "end_ms": 191125,
      "text": "从谈判成交到成本管控，",
      "token_start": 885,
      "token_end_exclusive": 895
    },
    {
      "start_ms": 191510,
      "end_ms": 193375,
      "text": "从引流获客到快速变现。",
      "token_start": 895,
      "token_end_exclusive": 905
    },
    {
      "start_ms": 193730,
      "end_ms": 195190,
      "text": "从同行竞争到风险，",
      "token_start": 905,
      "token_end_exclusive": 913
    },
    {
      "start_ms": 195190,
      "end_ms": 198520,
      "text": "规避潮汕人做生意遇到的每一个环节，",
      "token_start": 913,
      "token_end_exclusive": 929
    },
    {
      "start_ms": 198820,
      "end_ms": 201295,
      "text": "书里都有具体可操作的方法。",
      "token_start": 929,
      "token_end_exclusive": 941
    },
    {
      "start_ms": 201810,
      "end_ms": 202630,
      "text": "更难得的是，",
      "token_start": 941,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 202790,
      "end_ms": 205185,
      "text": "他把潮汕人的软实力也讲透了，",
      "token_start": 946,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 205500,
      "end_ms": 209255,
      "text": "比如潮汕、老辈人常说的样样能无样精，",
      "token_start": 959,
      "token_end_exclusive": 975
    },
    {
      "start_ms": 209760,
      "end_ms": 211975,
      "text": "那些看似门门懂、样样通的人，",
      "token_start": 975,
      "token_end_exclusive": 987
    },
    {
      "start_ms": 212230,
      "end_ms": 214825,
      "text": "往往因为浅尝辄止而难成大器。",
      "token_start": 987,
      "token_end_exclusive": 1000
    },
    {
      "start_ms": 215220,
      "end_ms": 216360,
      "text": "真正的立身之本，",
      "token_start": 1000,
      "token_end_exclusive": 1007
    },
    {
      "start_ms": 216500,
      "end_ms": 218445,
      "text": "在于深挖一口井的深度。",
      "token_start": 1007,
      "token_end_exclusive": 1017
    },
    {
      "start_ms": 218940,
      "end_ms": 219505,
      "text": "再比如，",
      "token_start": 1017,
      "token_end_exclusive": 1020
    },
    {
      "start_ms": 219840,
      "end_ms": 220780,
      "text": "宁可跑断腿，",
      "token_start": 1020,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 220920,
      "end_ms": 222780,
      "text": "不把商机推潮汕人，",
      "token_start": 1025,
      "token_end_exclusive": 1033
    },
    {
      "start_ms": 222780,
      "end_ms": 225865,
      "text": "对商机的敏感和执着已经刻进了骨子里。",
      "token_start": 1033,
      "token_end_exclusive": 1050
    },
    {
      "start_ms": 226250,
      "end_ms": 228690,
      "text": "这本书的独特价值在于它的稀缺性。",
      "token_start": 1050,
      "token_end_exclusive": 1065
    },
    {
      "start_ms": 228850,
      "end_ms": 230705,
      "text": "市面上讲潮汕人的书不少，",
      "token_start": 1065,
      "token_end_exclusive": 1076
    },
    {
      "start_ms": 231230,
      "end_ms": 232550,
      "text": "但要么是学术研究，",
      "token_start": 1076,
      "token_end_exclusive": 1084
    },
    {
      "start_ms": 232690,
      "end_ms": 233725,
      "text": "离普通人太远，",
      "token_start": 1084,
      "token_end_exclusive": 1090
    },
    {
      "start_ms": 234130,
      "end_ms": 235470,
      "text": "要么是零散的故事集，",
      "token_start": 1090,
      "token_end_exclusive": 1099
    },
    {
      "start_ms": 235670,
      "end_ms": 236410,
      "text": "读完热闹，",
      "token_start": 1099,
      "token_end_exclusive": 1103
    },
    {
      "start_ms": 236430,
      "end_ms": 237405,
      "text": "但学不到东西。",
      "token_start": 1103,
      "token_end_exclusive": 1109
    },
    {
      "start_ms": 237730,
      "end_ms": 242305,
      "text": "而这本书第一次把潮汕思维从江湖经验拉进了系统认知，",
      "token_start": 1109,
      "token_end_exclusive": 1133
    },
    {
      "start_ms": 243010,
      "end_ms": 244245,
      "text": "有他学术深度的，",
      "token_start": 1133,
      "token_end_exclusive": 1140
    },
    {
      "start_ms": 244510,
      "end_ms": 245965,
      "text": "没有他实战接地气，",
      "token_start": 1140,
      "token_end_exclusive": 1148
    },
    {
      "start_ms": 246490,
      "end_ms": 247855,
      "text": "有他实战接地气的，",
      "token_start": 1148,
      "token_end_exclusive": 1156
    },
    {
      "start_ms": 248060,
      "end_ms": 249195,
      "text": "没有它系统完整。",
      "token_start": 1156,
      "token_end_exclusive": 1163
    },
    {
      "start_ms": 249420,
      "end_ms": 250060,
      "text": "他告诉你，",
      "token_start": 1163,
      "token_end_exclusive": 1167
    },
    {
      "start_ms": 250220,
      "end_ms": 252300,
      "text": "潮汕人的成功不是靠投机，",
      "token_start": 1167,
      "token_end_exclusive": 1178
    },
    {
      "start_ms": 252540,
      "end_ms": 253535,
      "text": "不是靠运气，",
      "token_start": 1178,
      "token_end_exclusive": 1183
    },
    {
      "start_ms": 253810,
      "end_ms": 257170,
      "text": "而是靠一套可以学习、可以复制的底层思维。",
      "token_start": 1183,
      "token_end_exclusive": 1201
    },
    {
      "start_ms": 257310,
      "end_ms": 258855,
      "text": "普通人为什么赚不到钱？",
      "token_start": 1201,
      "token_end_exclusive": 1211
    },
    {
      "start_ms": 259280,
      "end_ms": 260225,
      "text": "不是不够努力，",
      "token_start": 1211,
      "token_end_exclusive": 1217
    },
    {
      "start_ms": 260530,
      "end_ms": 261885,
      "text": "而是思维没打开，",
      "token_start": 1217,
      "token_end_exclusive": 1224
    },
    {
      "start_ms": 262420,
      "end_ms": 263700,
      "text": "被打工思维困住，",
      "token_start": 1224,
      "token_end_exclusive": 1231
    },
    {
      "start_ms": 263860,
      "end_ms": 265065,
      "text": "被舒适区困住，",
      "token_start": 1231,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 265380,
      "end_ms": 266675,
      "text": "被怕失败困住。",
      "token_start": 1237,
      "token_end_exclusive": 1243
    },
    {
      "start_ms": 267130,
      "end_ms": 270135,
      "text": "而潮汕思维恰恰是打破这些枷锁的钥匙。",
      "token_start": 1243,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 270890,
      "end_ms": 272730,
      "text": "如果你厌倦了那些空洞的鸡汤，",
      "token_start": 1260,
      "token_end_exclusive": 1273
    },
    {
      "start_ms": 273050,
      "end_ms": 274895,
      "text": "不想再被伪成功学收割，",
      "token_start": 1273,
      "token_end_exclusive": 1283
    },
    {
      "start_ms": 275240,
      "end_ms": 278485,
      "text": "想踏踏实实学一套真正管用的赚钱思维，",
      "token_start": 1283,
      "token_end_exclusive": 1300
    },
    {
      "start_ms": 278930,
      "end_ms": 281425,
      "text": "这本书值得放在枕边反复读。",
      "token_start": 1300,
      "token_end_exclusive": 1312
    },
    {
      "start_ms": 281850,
      "end_ms": 284545,
      "text": "但如果你真的想彻底改变自己的商业认知，",
      "token_start": 1312,
      "token_end_exclusive": 1330
    },
    {
      "start_ms": 284950,
      "end_ms": 286710,
      "text": "光读一本潮汕思维还不够。",
      "token_start": 1330,
      "token_end_exclusive": 1341
    },
    {
      "start_ms": 287030,
      "end_ms": 290230,
      "text": "我强烈建议你把潮汕思维和时局控局破局，",
      "token_start": 1341,
      "token_end_exclusive": 1359
    },
    {
      "start_ms": 290250,
      "end_ms": 291170,
      "text": "搭配着一起读。",
      "token_start": 1359,
      "token_end_exclusive": 1365
    },
    {
      "start_ms": 291510,
      "end_ms": 297385,
      "text": "这套组合是目前市面上把认知升级和实战落地结合的最扎实的两本书。",
      "token_start": 1365,
      "token_end_exclusive": 1395
    },
    {
      "start_ms": 298070,
      "end_ms": 300865,
      "text": "潮汕思维解决的是想什么的问题，",
      "token_start": 1395,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 301220,
      "end_ms": 303595,
      "text": "帮你建立一套正确的商业底层认知，",
      "token_start": 1409,
      "token_end_exclusive": 1424
    },
    {
      "start_ms": 304010,
      "end_ms": 306375,
      "text": "让你看生意的眼光彻底不一样。",
      "token_start": 1424,
      "token_end_exclusive": 1437
    },
    {
      "start_ms": 307280,
      "end_ms": 310575,
      "text": "时局控局破局解决的是怎么做的问题，",
      "token_start": 1437,
      "token_end_exclusive": 1453
    },
    {
      "start_ms": 311120,
      "end_ms": 314985,
      "text": "教你在复杂的商业环境中识别局势、掌控节奏，",
      "token_start": 1453,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 315230,
      "end_ms": 316980,
      "text": "打破困局两本，",
      "token_start": 1472,
      "token_end_exclusive": 1478
    },
    {
      "start_ms": 316980,
      "end_ms": 317755,
      "text": "配合着读，",
      "token_start": 1478,
      "token_end_exclusive": 1482
    },
    {
      "start_ms": 318080,
      "end_ms": 319640,
      "text": "一套打通你的商业思维，",
      "token_start": 1482,
      "token_end_exclusive": 1492
    },
    {
      "start_ms": 319940,
      "end_ms": 320960,
      "text": "一套教你落地，",
      "token_start": 1492,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 320960,
      "end_ms": 322535,
      "text": "执行效果翻倍。",
      "token_start": 1498,
      "token_end_exclusive": 1504
    },
    {
      "start_ms": 323220,
      "end_ms": 324420,
      "text": "这两本书合在一起，",
      "token_start": 1504,
      "token_end_exclusive": 1512
    },
    {
      "start_ms": 324640,
      "end_ms": 326745,
      "text": "就是一套完整的赚钱方法论。",
      "token_start": 1512,
      "token_end_exclusive": 1524
    },
    {
      "start_ms": 327160,
      "end_ms": 328320,
      "text": "从思维到行动，",
      "token_start": 1524,
      "token_end_exclusive": 1530
    },
    {
      "start_ms": 328380,
      "end_ms": 329535,
      "text": "从认知到实战，",
      "token_start": 1530,
      "token_end_exclusive": 1536
    },
    {
      "start_ms": 329810,
      "end_ms": 331255,
      "text": "从想到到做到，",
      "token_start": 1536,
      "token_end_exclusive": 1542
    },
    {
      "start_ms": 331560,
      "end_ms": 336235,
      "text": "帮你真正把潮汕人五百年理解的商业智慧变成自己的东西。",
      "token_start": 1542,
      "token_end_exclusive": 1567
    },
    {
      "start_ms": 337090,
      "end_ms": 338315,
      "text": "链接就在下方，",
      "token_start": 1567,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 338720,
      "end_ms": 339565,
      "text": "翻开第一页，",
      "token_start": 1573,
      "token_end_exclusive": 1578
    },
    {
      "start_ms": 339800,
      "end_ms": 340785,
      "text": "你就能走上去。",
      "token_start": 1578,
      "token_end_exclusive": 1584
    },
    {
      "start_ms": 341230,
      "end_ms": 341990,
      "text": "我是小海龟，",
      "token_start": 1584,
      "token_end_exclusive": 1589
    },
    {
      "start_ms": 342150,
      "end_ms": 343510,
      "text": "欢迎持续关注我们，",
      "token_start": 1589,
      "token_end_exclusive": 1597
    },
    {
      "start_ms": 343510,
      "end_ms": 344145,
      "text": "下本书见。",
      "token_start": 1597,
      "token_end_exclusive": 1601
    }
  ],
