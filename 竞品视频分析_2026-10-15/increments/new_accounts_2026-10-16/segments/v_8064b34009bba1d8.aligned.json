{
  "video_id": "v_8064b34009bba1d8",
  "duration_s": 647.977007,
  "source_transcript": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\transcripts\\v_8064b34009bba1d8.txt",
  "source_raw_segments": "D:\\fuye\\竞品视频分析_2026-10-15\\increments\\new_accounts_2026-10-16\\segments\\v_8064b34009bba1d8.json",
  "alignment_method": "Transcription tokens sequentially paired with FunASR raw_timestamp; split on punctuation. Millisecond times are model estimates.",
  "tokenization": "Chinese characters / ASCII alphanumeric runs",
  "segments": [
    {
      "start_ms": 50,
      "end_ms": 6230,
      "text": "您知道中国从古至今流传故事里最富神秘感的一座山是哪一座吗？",
      "token_start": 0,
      "token_end_exclusive": 28
    },
    {
      "start_ms": 7070,
      "end_ms": 9750,
      "text": "有人说是武当山相传，",
      "token_start": 28,
      "token_end_exclusive": 37
    },
    {
      "start_ms": 9810,
      "end_ms": 11550,
      "text": "张三丰曾在那儿悟道。",
      "token_start": 37,
      "token_end_exclusive": 46
    },
    {
      "start_ms": 12150,
      "end_ms": 15750,
      "text": "有人说是长白山火山孕育出天池，",
      "token_start": 46,
      "token_end_exclusive": 60
    },
    {
      "start_ms": 15750,
      "end_ms": 20110,
      "text": "清代曾对这里长期封山两百多年，",
      "token_start": 60,
      "token_end_exclusive": 74
    },
    {
      "start_ms": 20110,
      "end_ms": 21470,
      "text": "禁止不同人进山。",
      "token_start": 74,
      "token_end_exclusive": 81
    },
    {
      "start_ms": 21470,
      "end_ms": 26630,
      "text": "但要说民间传说里最神秘的这两座都排不到榜首，",
      "token_start": 81,
      "token_end_exclusive": 102
    },
    {
      "start_ms": 26630,
      "end_ms": 28890,
      "text": "长白山甚至进不了前五。",
      "token_start": 102,
      "token_end_exclusive": 112
    },
    {
      "start_ms": 28890,
      "end_ms": 34160,
      "text": "这是在古籍记载里排在榜首的这座山山海经中，",
      "token_start": 112,
      "token_end_exclusive": 132
    },
    {
      "start_ms": 34160,
      "end_ms": 35680,
      "text": "称它为天地的夏都。",
      "token_start": 132,
      "token_end_exclusive": 140
    },
    {
      "start_ms": 36520,
      "end_ms": 40580,
      "text": "自古流传着有人进山之后再也没能出来的传说，",
      "token_start": 140,
      "token_end_exclusive": 160
    },
    {
      "start_ms": 41060,
      "end_ms": 42680,
      "text": "还有人拍下照片。",
      "token_start": 160,
      "token_end_exclusive": 167
    },
    {
      "start_ms": 43120,
      "end_ms": 45960,
      "text": "照片里的景象引发很多讨论，",
      "token_start": 167,
      "token_end_exclusive": 179
    },
    {
      "start_ms": 46440,
      "end_ms": 47340,
      "text": "直到今天，",
      "token_start": 179,
      "token_end_exclusive": 183
    },
    {
      "start_ms": 47580,
      "end_ms": 50100,
      "text": "它还有部分区域划定为保护区，",
      "token_start": 183,
      "token_end_exclusive": 196
    },
    {
      "start_ms": 50400,
      "end_ms": 51360,
      "text": "不对外开放，",
      "token_start": 196,
      "token_end_exclusive": 201
    },
    {
      "start_ms": 51640,
      "end_ms": 53440,
      "text": "普通人不能随意进入，",
      "token_start": 201,
      "token_end_exclusive": 210
    },
    {
      "start_ms": 53680,
      "end_ms": 54580,
      "text": "它是哪一座？",
      "token_start": 210,
      "token_end_exclusive": 215
    },
    {
      "start_ms": 55380,
      "end_ms": 60930,
      "text": "今天咱们就来盘点在中国大地流传千年传说多里的十座，",
      "token_start": 215,
      "token_end_exclusive": 239
    },
    {
      "start_ms": 61230,
      "end_ms": 64195,
      "text": "富有神秘色彩的山脉分两级。",
      "token_start": 239,
      "token_end_exclusive": 251
    },
    {
      "start_ms": 65120,
      "end_ms": 70110,
      "text": "这一集咱们先说第十名到第六名老规矩开讲之前，",
      "token_start": 251,
      "token_end_exclusive": 272
    },
    {
      "start_ms": 70110,
      "end_ms": 72545,
      "text": "劳烦您扣个一点个红心，",
      "token_start": 272,
      "token_end_exclusive": 282
    },
    {
      "start_ms": 72860,
      "end_ms": 74245,
      "text": "让我看看都是谁在听。",
      "token_start": 282,
      "token_end_exclusive": 291
    },
    {
      "start_ms": 75220,
      "end_ms": 75905,
      "text": "第十名，",
      "token_start": 291,
      "token_end_exclusive": 294
    },
    {
      "start_ms": 76220,
      "end_ms": 78855,
      "text": "终南山在陕西西安，",
      "token_start": 294,
      "token_end_exclusive": 302
    },
    {
      "start_ms": 79780,
      "end_ms": 82460,
      "text": "这座山离西安城只有一小时车程，",
      "token_start": 302,
      "token_end_exclusive": 316
    },
    {
      "start_ms": 82760,
      "end_ms": 84340,
      "text": "深山之中嗯，",
      "token_start": 316,
      "token_end_exclusive": 321
    },
    {
      "start_ms": 84470,
      "end_ms": 86765,
      "text": "一直流传着隐士修行的故事。",
      "token_start": 321,
      "token_end_exclusive": 333
    },
    {
      "start_ms": 87480,
      "end_ms": 92685,
      "text": "据多家纪实媒体多年走访钟南山的报不完全统计，",
      "token_start": 333,
      "token_end_exclusive": 354
    },
    {
      "start_ms": 93400,
      "end_ms": 97765,
      "text": "长期在山中定居隐休的人大约有四五百人。",
      "token_start": 354,
      "token_end_exclusive": 372
    },
    {
      "start_ms": 98170,
      "end_ms": 100585,
      "text": "短期进山体验修行生活的人，",
      "token_start": 372,
      "token_end_exclusive": 384
    },
    {
      "start_ms": 101220,
      "end_ms": 103120,
      "text": "高峰期能达到数千年，",
      "token_start": 384,
      "token_end_exclusive": 393
    },
    {
      "start_ms": 103240,
      "end_ms": 105385,
      "text": "里面有僧人、道士，",
      "token_start": 393,
      "token_end_exclusive": 400
    },
    {
      "start_ms": 105700,
      "end_ms": 108315,
      "text": "也有大学教授放下生意的商人，",
      "token_start": 400,
      "token_end_exclusive": 413
    },
    {
      "start_ms": 109060,
      "end_ms": 110920,
      "text": "他们搭建简易茅棚，",
      "token_start": 413,
      "token_end_exclusive": 421
    },
    {
      "start_ms": 111200,
      "end_ms": 112000,
      "text": "自给自足，",
      "token_start": 421,
      "token_end_exclusive": 425
    },
    {
      "start_ms": 112240,
      "end_ms": 112660,
      "text": "种菜，",
      "token_start": 425,
      "token_end_exclusive": 427
    },
    {
      "start_ms": 112660,
      "end_ms": 115645,
      "text": "生活一住就是几年甚至十几年。",
      "token_start": 427,
      "token_end_exclusive": 440
    },
    {
      "start_ms": 115990,
      "end_ms": 118515,
      "text": "冬天山里气温低到零下十几度，",
      "token_start": 440,
      "token_end_exclusive": 453
    },
    {
      "start_ms": 119010,
      "end_ms": 121655,
      "text": "就靠着棉被柴火过多，",
      "token_start": 453,
      "token_end_exclusive": 462
    },
    {
      "start_ms": 122420,
      "end_ms": 124660,
      "text": "钟南山隐居的传统由来已久。",
      "token_start": 462,
      "token_end_exclusive": 474
    },
    {
      "start_ms": 124980,
      "end_ms": 127970,
      "text": "相传西周的姜子牙出山，",
      "token_start": 474,
      "token_end_exclusive": 484
    },
    {
      "start_ms": 127990,
      "end_ms": 131805,
      "text": "辅佐武王伐纣之前就在终南山一带隐居。",
      "token_start": 484,
      "token_end_exclusive": 501
    },
    {
      "start_ms": 132390,
      "end_ms": 133030,
      "text": "还有传说，",
      "token_start": 501,
      "token_end_exclusive": 505
    },
    {
      "start_ms": 133030,
      "end_ms": 135315,
      "text": "老子骑青牛途经函谷关，",
      "token_start": 505,
      "token_end_exclusive": 515
    },
    {
      "start_ms": 135810,
      "end_ms": 138370,
      "text": "曾在钟南山附近写下道德经，",
      "token_start": 515,
      "token_end_exclusive": 527
    },
    {
      "start_ms": 138510,
      "end_ms": 143385,
      "text": "从远古传说里的先贤到如今进山修行的不同人。",
      "token_start": 527,
      "token_end_exclusive": 547
    },
    {
      "start_ms": 144010,
      "end_ms": 144895,
      "text": "三千年间，",
      "token_start": 547,
      "token_end_exclusive": 551
    },
    {
      "start_ms": 145250,
      "end_ms": 147055,
      "text": "不断有人走进这座大山。",
      "token_start": 551,
      "token_end_exclusive": 561
    },
    {
      "start_ms": 148000,
      "end_ms": 149785,
      "text": "为什么大家向往终南山？",
      "token_start": 561,
      "token_end_exclusive": 571
    },
    {
      "start_ms": 150810,
      "end_ms": 151855,
      "text": "自古有说法，",
      "token_start": 571,
      "token_end_exclusive": 576
    },
    {
      "start_ms": 152260,
      "end_ms": 153245,
      "text": "天下修道，",
      "token_start": 576,
      "token_end_exclusive": 580
    },
    {
      "start_ms": 153580,
      "end_ms": 154605,
      "text": "终南为冠。",
      "token_start": 580,
      "token_end_exclusive": 584
    },
    {
      "start_ms": 155330,
      "end_ms": 156545,
      "text": "可咱们不妨想一想，",
      "token_start": 584,
      "token_end_exclusive": 592
    },
    {
      "start_ms": 157030,
      "end_ms": 160210,
      "text": "一个大学教授放着城市安稳的生活，",
      "token_start": 592,
      "token_end_exclusive": 607
    },
    {
      "start_ms": 160550,
      "end_ms": 162170,
      "text": "跑到山里搭建茅棚，",
      "token_start": 607,
      "token_end_exclusive": 615
    },
    {
      "start_ms": 162430,
      "end_ms": 163435,
      "text": "他追求的是什么？",
      "token_start": 615,
      "token_end_exclusive": 622
    },
    {
      "start_ms": 164480,
      "end_ms": 165965,
      "text": "每一位山中隐居者，",
      "token_start": 622,
      "token_end_exclusive": 630
    },
    {
      "start_ms": 166430,
      "end_ms": 167905,
      "text": "答案也各不相同。",
      "token_start": 630,
      "token_end_exclusive": 637
    },
    {
      "start_ms": 169300,
      "end_ms": 170085,
      "text": "第九名，",
      "token_start": 637,
      "token_end_exclusive": 640
    },
    {
      "start_ms": 171180,
      "end_ms": 174575,
      "text": "武当山在湖北十堰，",
      "token_start": 640,
      "token_end_exclusive": 648
    },
    {
      "start_ms": 177740,
      "end_ms": 181865,
      "text": "武当山最让人惊叹的要数金殿里长明的油灯。",
      "token_start": 648,
      "token_end_exclusive": 667
    },
    {
      "start_ms": 182160,
      "end_ms": 184935,
      "text": "武当山金殿整体为铜柱构建，",
      "token_start": 667,
      "token_end_exclusive": 679
    },
    {
      "start_ms": 185660,
      "end_ms": 190185,
      "text": "当年在北京铸造完成之后再运到武当山顶组装。",
      "token_start": 679,
      "token_end_exclusive": 699
    },
    {
      "start_ms": 191180,
      "end_ms": 192575,
      "text": "在明代永乐年间，",
      "token_start": 699,
      "token_end_exclusive": 706
    },
    {
      "start_ms": 193050,
      "end_ms": 196200,
      "text": "没有现代启动设备几十吨。",
      "token_start": 706,
      "token_end_exclusive": 717
    },
    {
      "start_ms": 196200,
      "end_ms": 200110,
      "text": "重的铜构件是如何运上千米？",
      "token_start": 717,
      "token_end_exclusive": 729
    },
    {
      "start_ms": 200110,
      "end_ms": 207185,
      "text": "高山又在悬崖边组装完成的相关工程的详细施工记录，",
      "token_start": 729,
      "token_end_exclusive": 752
    },
    {
      "start_ms": 207830,
      "end_ms": 209530,
      "text": "并没有完整保存。",
      "token_start": 752,
      "token_end_exclusive": 759
    },
    {
      "start_ms": 209630,
      "end_ms": 210405,
      "text": "流传下来，",
      "token_start": 759,
      "token_end_exclusive": 763
    },
    {
      "start_ms": 210940,
      "end_ms": 214100,
      "text": "武当山古石名叫太和山民间传说，",
      "token_start": 763,
      "token_end_exclusive": 777
    },
    {
      "start_ms": 214280,
      "end_ms": 215760,
      "text": "道教里的真武大帝，",
      "token_start": 777,
      "token_end_exclusive": 785
    },
    {
      "start_ms": 215840,
      "end_ms": 217180,
      "text": "在此得道飞升取，",
      "token_start": 785,
      "token_end_exclusive": 792
    },
    {
      "start_ms": 217180,
      "end_ms": 217820,
      "text": "非真武，",
      "token_start": 792,
      "token_end_exclusive": 795
    },
    {
      "start_ms": 217820,
      "end_ms": 219045,
      "text": "不足以当知之意，",
      "token_start": 795,
      "token_end_exclusive": 802
    },
    {
      "start_ms": 219780,
      "end_ms": 221345,
      "text": "后来改名为武当山。",
      "token_start": 802,
      "token_end_exclusive": 810
    },
    {
      "start_ms": 222070,
      "end_ms": 223375,
      "text": "明朝永乐年间，",
      "token_start": 810,
      "token_end_exclusive": 816
    },
    {
      "start_ms": 223890,
      "end_ms": 228280,
      "text": "朱棣调集三十万军民上山修建宫馆攻城，",
      "token_start": 816,
      "token_end_exclusive": 833
    },
    {
      "start_ms": 228280,
      "end_ms": 230045,
      "text": "前后持续十二年，",
      "token_start": 833,
      "token_end_exclusive": 840
    },
    {
      "start_ms": 230390,
      "end_ms": 234065,
      "text": "动用如此巨大人力为一座山修建道观，",
      "token_start": 840,
      "token_end_exclusive": 856
    },
    {
      "start_ms": 234430,
      "end_ms": 236245,
      "text": "在国内历史上十分少见。",
      "token_start": 856,
      "token_end_exclusive": 866
    },
    {
      "start_ms": 236830,
      "end_ms": 239405,
      "text": "相传张三丰曾在此开创武当派，",
      "token_start": 866,
      "token_end_exclusive": 879
    },
    {
      "start_ms": 239890,
      "end_ms": 242610,
      "text": "直到今天清晨登上武当山，",
      "token_start": 879,
      "token_end_exclusive": 890
    },
    {
      "start_ms": 243130,
      "end_ms": 245790,
      "text": "还能听见道士早课的诵经声，",
      "token_start": 890,
      "token_end_exclusive": 902
    },
    {
      "start_ms": 246570,
      "end_ms": 248290,
      "text": "钟声漫过山谷，",
      "token_start": 902,
      "token_end_exclusive": 908
    },
    {
      "start_ms": 248970,
      "end_ms": 251530,
      "text": "整座山都安静下来。",
      "token_start": 908,
      "token_end_exclusive": 916
    },
    {
      "start_ms": 252870,
      "end_ms": 253570,
      "text": "第八名。",
      "token_start": 916,
      "token_end_exclusive": 919
    },
    {
      "start_ms": 253610,
      "end_ms": 259550,
      "text": "峨眉山在四川峨眉山有一处著名的自然奇观。",
      "token_start": 919,
      "token_end_exclusive": 938
    },
    {
      "start_ms": 260270,
      "end_ms": 261230,
      "text": "金顶之上，",
      "token_start": 938,
      "token_end_exclusive": 942
    },
    {
      "start_ms": 261530,
      "end_ms": 262490,
      "text": "每到晴天，",
      "token_start": 942,
      "token_end_exclusive": 946
    },
    {
      "start_ms": 262530,
      "end_ms": 263790,
      "text": "午后阳光，",
      "token_start": 946,
      "token_end_exclusive": 950
    },
    {
      "start_ms": 263870,
      "end_ms": 265830,
      "text": "从人身后方照射过来。",
      "token_start": 950,
      "token_end_exclusive": 959
    },
    {
      "start_ms": 266210,
      "end_ms": 268230,
      "text": "站在崖边向下望去，",
      "token_start": 959,
      "token_end_exclusive": 967
    },
    {
      "start_ms": 268670,
      "end_ms": 271600,
      "text": "云层间会浮现一圈巨大的彩色光环。",
      "token_start": 967,
      "token_end_exclusive": 982
    },
    {
      "start_ms": 272000,
      "end_ms": 275440,
      "text": "光环中间会出现自己的影子人，",
      "token_start": 982,
      "token_end_exclusive": 995
    },
    {
      "start_ms": 275460,
      "end_ms": 276720,
      "text": "抬手影子，",
      "token_start": 995,
      "token_end_exclusive": 999
    },
    {
      "start_ms": 276720,
      "end_ms": 279920,
      "text": "跟着抬手人一动影子也跟着移动。",
      "token_start": 999,
      "token_end_exclusive": 1013
    },
    {
      "start_ms": 280360,
      "end_ms": 282440,
      "text": "当地人把这个景象叫做佛光，",
      "token_start": 1013,
      "token_end_exclusive": 1025
    },
    {
      "start_ms": 282920,
      "end_ms": 284720,
      "text": "古人不了解光学原理，",
      "token_start": 1025,
      "token_end_exclusive": 1034
    },
    {
      "start_ms": 284920,
      "end_ms": 286580,
      "text": "以为是菩萨显灵，",
      "token_start": 1034,
      "token_end_exclusive": 1041
    },
    {
      "start_ms": 287040,
      "end_ms": 288900,
      "text": "现代科学已经解释清楚，",
      "token_start": 1041,
      "token_end_exclusive": 1051
    },
    {
      "start_ms": 288920,
      "end_ms": 289860,
      "text": "这就是峨眉宝。",
      "token_start": 1051,
      "token_end_exclusive": 1057
    },
    {
      "start_ms": 289860,
      "end_ms": 293520,
      "text": "光是阳光穿过云雾里的小水滴，",
      "token_start": 1057,
      "token_end_exclusive": 1070
    },
    {
      "start_ms": 293940,
      "end_ms": 297460,
      "text": "经过反射衍射形成的自然光学现象，",
      "token_start": 1070,
      "token_end_exclusive": 1085
    },
    {
      "start_ms": 298300,
      "end_ms": 300260,
      "text": "就算明白了背后原理，",
      "token_start": 1085,
      "token_end_exclusive": 1094
    },
    {
      "start_ms": 300370,
      "end_ms": 301825,
      "text": "亲身站在崖边，",
      "token_start": 1094,
      "token_end_exclusive": 1100
    },
    {
      "start_ms": 302330,
      "end_ms": 303490,
      "text": "看见自己的身影，",
      "token_start": 1100,
      "token_end_exclusive": 1107
    },
    {
      "start_ms": 303490,
      "end_ms": 305175,
      "text": "被彩虹光环环绕，",
      "token_start": 1107,
      "token_end_exclusive": 1114
    },
    {
      "start_ms": 305550,
      "end_ms": 306785,
      "text": "依旧会觉得震撼。",
      "token_start": 1114,
      "token_end_exclusive": 1121
    },
    {
      "start_ms": 307610,
      "end_ms": 310050,
      "text": "还有万年寺内的普贤铜像，",
      "token_start": 1121,
      "token_end_exclusive": 1132
    },
    {
      "start_ms": 310850,
      "end_ms": 314670,
      "text": "重六十二吨铸造于一千多年前。",
      "token_start": 1132,
      "token_end_exclusive": 1145
    },
    {
      "start_ms": 315690,
      "end_ms": 318130,
      "text": "在没有大型起重工具的古代，",
      "token_start": 1145,
      "token_end_exclusive": 1157
    },
    {
      "start_ms": 318550,
      "end_ms": 326510,
      "text": "这么重的铜像是如何运上山完成铸造安放的这件事的详细运输、安装记录。",
      "token_start": 1157,
      "token_end_exclusive": 1188
    },
    {
      "start_ms": 327650,
      "end_ms": 329390,
      "text": "同样没有完整留存。",
      "token_start": 1188,
      "token_end_exclusive": 1196
    },
    {
      "start_ms": 330150,
      "end_ms": 331710,
      "text": "站在铜像下方，",
      "token_start": 1196,
      "token_end_exclusive": 1202
    },
    {
      "start_ms": 331810,
      "end_ms": 334770,
      "text": "抬头仰望千年前的古人，",
      "token_start": 1202,
      "token_end_exclusive": 1212
    },
    {
      "start_ms": 335070,
      "end_ms": 336390,
      "text": "依靠原始工具，",
      "token_start": 1212,
      "token_end_exclusive": 1218
    },
    {
      "start_ms": 336850,
      "end_ms": 341740,
      "text": "将数十吨的青铜送上高山安放殿中，",
      "token_start": 1218,
      "token_end_exclusive": 1233
    },
    {
      "start_ms": 342260,
      "end_ms": 343120,
      "text": "历经千年，",
      "token_start": 1233,
      "token_end_exclusive": 1237
    },
    {
      "start_ms": 343420,
      "end_ms": 346520,
      "text": "依旧完好矗立第七名。",
      "token_start": 1237,
      "token_end_exclusive": 1246
    },
    {
      "start_ms": 347320,
      "end_ms": 351500,
      "text": "梅里雪山在云南和西藏交界地带，",
      "token_start": 1246,
      "token_end_exclusive": 1260
    },
    {
      "start_ms": 352180,
      "end_ms": 361200,
      "text": "它是国内唯一由地方人大决议永久禁止攀登的雪山主峰喀瓦格勃，",
      "token_start": 1260,
      "token_end_exclusive": 1288
    },
    {
      "start_ms": 361200,
      "end_ms": 363160,
      "text": "海拔六千七百四十米，",
      "token_start": 1288,
      "token_end_exclusive": 1297
    },
    {
      "start_ms": 363780,
      "end_ms": 365360,
      "text": "比珠穆朗玛峰低。",
      "token_start": 1297,
      "token_end_exclusive": 1304
    },
    {
      "start_ms": 365680,
      "end_ms": 370190,
      "text": "两千多米珠峰已有数千人成功登顶。",
      "token_start": 1304,
      "token_end_exclusive": 1319
    },
    {
      "start_ms": 370190,
      "end_ms": 375350,
      "text": "而卡瓦格伯至今没有人类成功登顶的记录，",
      "token_start": 1319,
      "token_end_exclusive": 1337
    },
    {
      "start_ms": 375530,
      "end_ms": 377305,
      "text": "不是没有人尝试嗯。",
      "token_start": 1337,
      "token_end_exclusive": 1345
    },
    {
      "start_ms": 377690,
      "end_ms": 379095,
      "text": "一九九一年一月，",
      "token_start": 1345,
      "token_end_exclusive": 1352
    },
    {
      "start_ms": 379760,
      "end_ms": 383315,
      "text": "中日联合登山队向卡瓦格伯发起攀登。",
      "token_start": 1352,
      "token_end_exclusive": 1368
    },
    {
      "start_ms": 383910,
      "end_ms": 384670,
      "text": "出发之前，",
      "token_start": 1368,
      "token_end_exclusive": 1372
    },
    {
      "start_ms": 385090,
      "end_ms": 387990,
      "text": "当地藏族群众跪在雪地诵经，",
      "token_start": 1372,
      "token_end_exclusive": 1384
    },
    {
      "start_ms": 388290,
      "end_ms": 389945,
      "text": "祈求山神护佑，",
      "token_start": 1384,
      "token_end_exclusive": 1390
    },
    {
      "start_ms": 390470,
      "end_ms": 395705,
      "text": "不希望登山者登顶登山队依旧继续向上攀登。",
      "token_start": 1390,
      "token_end_exclusive": 1409
    },
    {
      "start_ms": 396560,
      "end_ms": 397245,
      "text": "一月四日，",
      "token_start": 1409,
      "token_end_exclusive": 1413
    },
    {
      "start_ms": 397800,
      "end_ms": 402935,
      "text": "十七名队员在三号营地遭遇特大雪崩全部遇难，",
      "token_start": 1413,
      "token_end_exclusive": 1433
    },
    {
      "start_ms": 403790,
      "end_ms": 407315,
      "text": "这也是人类登山史上重大山难之一。",
      "token_start": 1433,
      "token_end_exclusive": 1448
    },
    {
      "start_ms": 407800,
      "end_ms": 410260,
      "text": "搜救队伍持续寻找数月。",
      "token_start": 1448,
      "token_end_exclusive": 1458
    },
    {
      "start_ms": 410340,
      "end_ms": 411435,
      "text": "没有找到遇难者。",
      "token_start": 1458,
      "token_end_exclusive": 1465
    },
    {
      "start_ms": 412710,
      "end_ms": 413995,
      "text": "直到一九九八年，",
      "token_start": 1465,
      "token_end_exclusive": 1472
    },
    {
      "start_ms": 414300,
      "end_ms": 416105,
      "text": "距离山难七年之后，",
      "token_start": 1472,
      "token_end_exclusive": 1480
    },
    {
      "start_ms": 416500,
      "end_ms": 419840,
      "text": "明永村村民在冰川上发现了遇难者的遗骸。",
      "token_start": 1480,
      "token_end_exclusive": 1498
    },
    {
      "start_ms": 419840,
      "end_ms": 423095,
      "text": "与遗物后续多年持续搜寻，",
      "token_start": 1498,
      "token_end_exclusive": 1509
    },
    {
      "start_ms": 423620,
      "end_ms": 426945,
      "text": "目前已经找到十六位遇难者遗体。",
      "token_start": 1509,
      "token_end_exclusive": 1523
    },
    {
      "start_ms": 427720,
      "end_ms": 431025,
      "text": "最后一位遇难者遗骸至今仍未发现，",
      "token_start": 1523,
      "token_end_exclusive": 1538
    },
    {
      "start_ms": 431830,
      "end_ms": 433345,
      "text": "这次重大山南之后，",
      "token_start": 1538,
      "token_end_exclusive": 1546
    },
    {
      "start_ms": 433610,
      "end_ms": 437065,
      "text": "二零零一年云南德清县人大通过决议，",
      "token_start": 1546,
      "token_end_exclusive": 1562
    },
    {
      "start_ms": 437510,
      "end_ms": 440075,
      "text": "永久禁止攀登卡瓦格波峰。",
      "token_start": 1562,
      "token_end_exclusive": 1573
    },
    {
      "start_ms": 440650,
      "end_ms": 442265,
      "text": "在当地藏族文化里，",
      "token_start": 1573,
      "token_end_exclusive": 1581
    },
    {
      "start_ms": 442640,
      "end_ms": 446040,
      "text": "卡瓦格博是藏传佛教四大神山之一，",
      "token_start": 1581,
      "token_end_exclusive": 1596
    },
    {
      "start_ms": 446040,
      "end_ms": 447520,
      "text": "山顶是神山居所，",
      "token_start": 1596,
      "token_end_exclusive": 1603
    },
    {
      "start_ms": 447620,
      "end_ms": 448815,
      "text": "凡人不可登临。",
      "token_start": 1603,
      "token_end_exclusive": 1609
    },
    {
      "start_ms": 449200,
      "end_ms": 451095,
      "text": "我们尊重当地民族的信仰。",
      "token_start": 1609,
      "token_end_exclusive": 1620
    },
    {
      "start_ms": 451620,
      "end_ms": 452040,
      "text": "同时，",
      "token_start": 1620,
      "token_end_exclusive": 1622
    },
    {
      "start_ms": 452040,
      "end_ms": 455125,
      "text": "这场惨烈的山难也提醒着所有人，",
      "token_start": 1622,
      "token_end_exclusive": 1636
    },
    {
      "start_ms": 455610,
      "end_ms": 456910,
      "text": "面对巍峨雪山，",
      "token_start": 1636,
      "token_end_exclusive": 1642
    },
    {
      "start_ms": 457110,
      "end_ms": 458605,
      "text": "应当心怀敬畏。",
      "token_start": 1642,
      "token_end_exclusive": 1648
    },
    {
      "start_ms": 459220,
      "end_ms": 459840,
      "text": "第六名。",
      "token_start": 1648,
      "token_end_exclusive": 1651
    },
    {
      "start_ms": 460100,
      "end_ms": 466785,
      "text": "神农架在湖北西部神农架的野人传说从战国时期流传至今，",
      "token_start": 1651,
      "token_end_exclusive": 1676
    },
    {
      "start_ms": 467710,
      "end_ms": 478815,
      "text": "屈原、九歌、山鬼很多后人解读认为诗中山鬼的原型和当地流传的人形异兽传说有关。",
      "token_start": 1676,
      "token_end_exclusive": 1711
    },
    {
      "start_ms": 480080,
      "end_ms": 486405,
      "text": "明代李时珍编写本草纲目书中也记录过神农架一带关于人形动物的传闻。",
      "token_start": 1711,
      "token_end_exclusive": 1742
    },
    {
      "start_ms": 487320,
      "end_ms": 488980,
      "text": "从一九七四年开始，",
      "token_start": 1742,
      "token_end_exclusive": 1750
    },
    {
      "start_ms": 489300,
      "end_ms": 493420,
      "text": "神农架地区陆续出现目击者的口述记录。",
      "token_start": 1750,
      "token_end_exclusive": 1767
    },
    {
      "start_ms": 494260,
      "end_ms": 495260,
      "text": "一九七六年，",
      "token_start": 1767,
      "token_end_exclusive": 1772
    },
    {
      "start_ms": 495620,
      "end_ms": 503400,
      "text": "神农驾林区五位干部和一名司机夜间行车在路上偶遇一个红棕色长矛的人形生物，",
      "token_start": 1772,
      "token_end_exclusive": 1807
    },
    {
      "start_ms": 504100,
      "end_ms": 505260,
      "text": "站在道路中间，",
      "token_start": 1807,
      "token_end_exclusive": 1813
    },
    {
      "start_ms": 506080,
      "end_ms": 507120,
      "text": "众人受惊，",
      "token_start": 1813,
      "token_end_exclusive": 1817
    },
    {
      "start_ms": 507820,
      "end_ms": 509340,
      "text": "迅速驾车离开。",
      "token_start": 1817,
      "token_end_exclusive": 1823
    },
    {
      "start_ms": 509920,
      "end_ms": 510520,
      "text": "这件事。",
      "token_start": 1823,
      "token_end_exclusive": 1826
    },
    {
      "start_ms": 510620,
      "end_ms": 511420,
      "text": "上报之后，",
      "token_start": 1826,
      "token_end_exclusive": 1830
    },
    {
      "start_ms": 511680,
      "end_ms": 515500,
      "text": "一千九百七十四至一九八一年间，",
      "token_start": 1830,
      "token_end_exclusive": 1844
    },
    {
      "start_ms": 515800,
      "end_ms": 521510,
      "text": "中国科学院组组织了三次大规模野外科考一百多人的专家队伍，",
      "token_start": 1844,
      "token_end_exclusive": 1871
    },
    {
      "start_ms": 521810,
      "end_ms": 526950,
      "text": "踏查一千五百平方公里林区发现大量疑似大型动物脚印，",
      "token_start": 1871,
      "token_end_exclusive": 1895
    },
    {
      "start_ms": 527630,
      "end_ms": 529830,
      "text": "最长脚印足有四十八厘米，",
      "token_start": 1895,
      "token_end_exclusive": 1906
    },
    {
      "start_ms": 530410,
      "end_ms": 532990,
      "text": "还收集到毛发粪便样本。",
      "token_start": 1906,
      "token_end_exclusive": 1916
    },
    {
      "start_ms": 533189,
      "end_ms": 535090,
      "text": "后续样本鉴定显示，",
      "token_start": 1916,
      "token_end_exclusive": 1924
    },
    {
      "start_ms": 535670,
      "end_ms": 539070,
      "text": "收集到的毛发大多属于雄猴子等。",
      "token_start": 1924,
      "token_end_exclusive": 1938
    },
    {
      "start_ms": 539070,
      "end_ms": 543530,
      "text": "已知野生动物部分样本存在人为伪造情况，",
      "token_start": 1938,
      "token_end_exclusive": 1956
    },
    {
      "start_ms": 544910,
      "end_ms": 548700,
      "text": "三次科考没有找到野人存在的实体标本。",
      "token_start": 1956,
      "token_end_exclusive": 1973
    },
    {
      "start_ms": 549460,
      "end_ms": 550440,
      "text": "一九九九年，",
      "token_start": 1973,
      "token_end_exclusive": 1978
    },
    {
      "start_ms": 550660,
      "end_ms": 553380,
      "text": "中国野生动物保护协会的研讨会上，",
      "token_start": 1978,
      "token_end_exclusive": 1993
    },
    {
      "start_ms": 553820,
      "end_ms": 555400,
      "text": "专家形成共识，",
      "token_start": 1993,
      "token_end_exclusive": 1999
    },
    {
      "start_ms": 555540,
      "end_ms": 558820,
      "text": "没有证据证明神农架存在野人这一物种。",
      "token_start": 1999,
      "token_end_exclusive": 2016
    },
    {
      "start_ms": 559580,
      "end_ms": 562760,
      "text": "虽然科学界没有找到野人存在的实证，",
      "token_start": 2016,
      "token_end_exclusive": 2032
    },
    {
      "start_ms": 563520,
      "end_ms": 565400,
      "text": "但当年目击者的口述，",
      "token_start": 2032,
      "token_end_exclusive": 2041
    },
    {
      "start_ms": 566120,
      "end_ms": 569120,
      "text": "那些巨大脚印一直被大家讨论。",
      "token_start": 2041,
      "token_end_exclusive": 2054
    },
    {
      "start_ms": 569520,
      "end_ms": 572100,
      "text": "神农架身处广袤原始森林，",
      "token_start": 2054,
      "token_end_exclusive": 2065
    },
    {
      "start_ms": 572260,
      "end_ms": 575160,
      "text": "还有很多未知的动植物等待探索。",
      "token_start": 2065,
      "token_end_exclusive": 2079
    },
    {
      "start_ms": 576080,
      "end_ms": 578050,
      "text": "第十到第六名就讲到这里，",
      "token_start": 2079,
      "token_end_exclusive": 2090
    },
    {
      "start_ms": 578330,
      "end_ms": 580630,
      "text": "钟南山的饮食故事代代相传，",
      "token_start": 2090,
      "token_end_exclusive": 2102
    },
    {
      "start_ms": 580990,
      "end_ms": 583330,
      "text": "武当山金殿古灯静静伫立，",
      "token_start": 2102,
      "token_end_exclusive": 2113
    },
    {
      "start_ms": 583810,
      "end_ms": 586910,
      "text": "峨眉山的佛光依旧等待有缘人，",
      "token_start": 2113,
      "token_end_exclusive": 2126
    },
    {
      "start_ms": 586950,
      "end_ms": 590870,
      "text": "遇见梅里雪山依旧禁止攀登。",
      "token_start": 2126,
      "token_end_exclusive": 2138
    },
    {
      "start_ms": 590890,
      "end_ms": 593250,
      "text": "神农架野人传说流传至今。",
      "token_start": 2138,
      "token_end_exclusive": 2149
    },
    {
      "start_ms": 593730,
      "end_ms": 596030,
      "text": "可这几座还不是传说里，",
      "token_start": 2149,
      "token_end_exclusive": 2159
    },
    {
      "start_ms": 596030,
      "end_ms": 596850,
      "text": "最神秘的，",
      "token_start": 2159,
      "token_end_exclusive": 2163
    },
    {
      "start_ms": 597110,
      "end_ms": 598350,
      "text": "剩下这五座山。",
      "token_start": 2163,
      "token_end_exclusive": 2169
    },
    {
      "start_ms": 598390,
      "end_ms": 601870,
      "text": "其中一座有帝王耗费数十年，",
      "token_start": 2169,
      "token_end_exclusive": 2181
    },
    {
      "start_ms": 602210,
      "end_ms": 603190,
      "text": "营建陵寝，",
      "token_start": 2181,
      "token_end_exclusive": 2185
    },
    {
      "start_ms": 603650,
      "end_ms": 605530,
      "text": "处于文物保护等考量，",
      "token_start": 2185,
      "token_end_exclusive": 2194
    },
    {
      "start_ms": 605990,
      "end_ms": 608235,
      "text": "目前暂不具备发掘条件。",
      "token_start": 2194,
      "token_end_exclusive": 2204
    },
    {
      "start_ms": 609090,
      "end_ms": 611390,
      "text": "还有一座两千多年前，",
      "token_start": 2204,
      "token_end_exclusive": 2213
    },
    {
      "start_ms": 611450,
      "end_ms": 612635,
      "text": "古籍就有记载，",
      "token_start": 2213,
      "token_end_exclusive": 2219
    },
    {
      "start_ms": 613120,
      "end_ms": 616995,
      "text": "但他确切的地理位置至今仍有学术争议，",
